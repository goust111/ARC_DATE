{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/278e5215.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import bbox, components_mask, crop_bbox, get_bg, paste\nimport random\nfrom itertools import product\n\n\ndef _unique_largest_non_bg_color(g: np.ndarray, bg: int) -> int:\n    counts = Counter(map(int, g.flatten()))\n    non_bg_counts = [(color, count) for color, count in counts.items() if color != int(bg)]\n    assert non_bg_counts\n\n    largest_count = max(count for _color, count in non_bg_counts)\n    candidates = [color for color, count in non_bg_counts if count == largest_count]\n    assert len(candidates) == 1\n    return int(candidates[0])\n\n\ndef _mask_bbox(g: np.ndarray, mask_color: int) -> tuple[int, int, int, int]:\n    mask = g == int(mask_color)\n    comps = components_mask(mask, connectivity=4)\n    assert len(comps) == 1\n\n    b = bbox(mask)\n    assert b is not None\n    return b\n\n\ndef _palette(g: np.ndarray, bg: int, mask_color: int, width: int) -> tuple[np.ndarray, int]:\n    palette_mask = (g != int(bg)) & (g != int(mask_color))\n    b = bbox(palette_mask)\n    assert b is not None\n\n    palette = crop_bbox(g, b)\n    assert palette.shape == (3, int(width))\n    assert bool(np.all(palette != int(bg)))\n    assert bool(np.all(palette != int(mask_color)))\n    assert bool(np.array_equal(palette[0], palette[1]))\n    assert len(set(map(int, palette[2]))) == 1\n\n    column_colors = palette[0].copy()\n    hole_color = int(palette[2, 0])\n    return column_colors, hole_color\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the large mask crop column-by-column using the separate three-row palette strip.\n\n    Input structure:\n    - The background is the most common color.\n    - One large monochrome foreground object is the mask; its bbox is the output region and may contain background holes.\n    - The remaining foreground is a 3-row palette rectangle with the same width as the mask bbox: two identical color rows and one uniform row.\n\n    Rule:\n    - Crop to the mask object's bbox.\n    - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n    - Replace background holes inside the crop with the palette's uniform third-row color.\n\n    Key insight:\n    The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    mask_color = _unique_largest_non_bg_color(g, bg)\n\n    b = _mask_bbox(g, mask_color)\n    mask_crop = crop_bbox(g == int(mask_color), b)\n    height, width = map(int, mask_crop.shape)\n\n    column_colors, hole_color = _palette(g, bg, mask_color, width)\n    out = np.tile(column_colors, (height, 1))\n    out[~mask_crop] = hole_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, colors, and object bounds.\nBACKGROUND_COLOR, MASK_COLOR = 0, 5\nCOLOR_MIN, COLOR_MAX = 1, 9\nGRID_SIDE_MIN, GRID_SIDE_MAX = 10, 18\nMASK_SIDE_MIN, MASK_SIDE_MAX = 5, 10\nPALETTE_HEIGHT = 3\nGAP_MIN, GAP_MAX = 1, 3\n\n# Palette run construction.\nRUN_COUNT_OPTIONS = (4, 5)\nRUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3\nCOLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5\nUNUSED_COLOR_BIAS = 0.7\n\n# Mask density and retry budget.\nMASK_DENSITY_MIN, MASK_DENSITY_MAX = 0.60, 0.71\nGENERATION_ATTEMPTS = 300\n\n\ndef _valid_run_lengths(width: int, n_runs: int) -> list[tuple[int, ...]]:\n    length_range = range(RUN_LENGTH_MIN, RUN_LENGTH_MAX + 1)\n    return [\n        tuple(int(x) for x in lengths)\n        for lengths in product(length_range, repeat=int(n_runs))\n        if sum(lengths) == int(width)\n    ]\n\n\ndef _run_colors(colors: list[int], n_runs: int) -> list[int]:\n    seq: list[int] = []\n    unused = set(colors)\n    for i in range(int(n_runs)):\n        slots_left = int(n_runs) - i\n        choices = [c for c in colors if not seq or c != seq[-1]]\n        if len(unused) >= slots_left:\n            choices = [c for c in choices if c in unused]\n        elif unused and random.random() < UNUSED_COLOR_BIAS:\n            preferred = [c for c in choices if c in unused]\n            if preferred:\n                choices = preferred\n        color = random.choice(choices)\n        seq.append(int(color))\n        unused.discard(int(color))\n    return seq\n\n\ndef _palette_row(width: int, colors: list[int]) -> np.ndarray:\n    valid_counts = [\n        n_runs for n_runs in RUN_COUNT_OPTIONS if _valid_run_lengths(int(width), n_runs)\n    ]\n    n_runs = random.choice(valid_counts)\n    valid_lengths = _valid_run_lengths(int(width), n_runs)\n    lengths = random.choice(valid_lengths)\n    n_distinct = random.randint(\n        COLUMN_COLOR_DISTINCT_MIN, min(COLUMN_COLOR_DISTINCT_MAX, n_runs)\n    )\n    chosen = random.sample(colors, n_distinct)\n    seq = _run_colors(chosen, n_runs)\n    return np.repeat(seq, lengths).astype(int)\n\n\ndef _neighbors4(r: int, c: int, h: int, w: int):\n    if r > 0:\n        yield r - 1, c\n    if r + 1 < h:\n        yield r + 1, c\n    if c > 0:\n        yield r, c - 1\n    if c + 1 < w:\n        yield r, c + 1\n\n\ndef _connected_mask(height: int, width: int, target_area: int) -> np.ndarray | None:\n    \"\"\"Grow a connected mask with full row/column span to the target area.\"\"\"\n    mask = np.zeros((int(height), int(width)), dtype=bool)\n    steps = [\"D\"] * (int(height) - 1) + [\"R\"] * (int(width) - 1)\n    random.shuffle(steps)\n\n    r = c = 0\n    mask[r, c] = True\n    for step in steps:\n        if step == \"D\":\n            r += 1\n        else:\n            c += 1\n        mask[r, c] = True\n\n    if int(mask.sum()) > int(target_area):\n        return None\n\n    frontier: set[tuple[int, int]] = set()\n\n    def add_frontier(rr: int, cc: int) -> None:\n        for nr, nc in _neighbors4(rr, cc, int(height), int(width)):\n            if not mask[nr, nc]:\n                frontier.add((int(nr), int(nc)))\n\n    for rr, cc in np.argwhere(mask):\n        add_frontier(int(rr), int(cc))\n\n    while int(mask.sum()) < int(target_area):\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        rr, cc = cell\n        mask[rr, cc] = True\n        add_frontier(rr, cc)\n\n    return mask\n\n\ndef _grid_choices(mask_h: int, mask_w: int, gap: int) -> list[tuple[int, int]]:\n    \"\"\"Grid sizes where the mask remains the unique largest non-bg object.\"\"\"\n    max_mask = int(np.floor(MASK_DENSITY_MAX * int(mask_h) * int(mask_w)))\n    min_h = max(GRID_SIDE_MIN, int(mask_h) + PALETTE_HEIGHT + int(gap))\n    min_w = max(GRID_SIDE_MIN, int(mask_w))\n    choices: list[tuple[int, int]] = []\n    for h in range(min_h, GRID_SIDE_MAX + 1):\n        for w in range(min_w, GRID_SIDE_MAX + 1):\n            if h * w - max_mask - PALETTE_HEIGHT * int(mask_w) > max_mask:\n                choices.append((h, w))\n    return choices\n\n\ndef _sample_dimensions() -> tuple[int, int, int, int, int] | None:\n    \"\"\"Sample mask size, layout gap, and compatible grid size.\"\"\"\n    mask_h = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)\n    mask_w = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)\n    gap = random.randint(GAP_MIN, GAP_MAX)\n    grid_choices = _grid_choices(mask_h, mask_w, gap)\n    if not grid_choices:\n        return None\n    grid_h, grid_w = random.choice(grid_choices)\n    return mask_h, mask_w, gap, grid_h, grid_w\n\n\ndef _sample_palette(mask_w: int) -> tuple[np.ndarray, int]:\n    \"\"\"Choose hole color and the same-width column palette row.\"\"\"\n    available = [c for c in range(COLOR_MIN, COLOR_MAX + 1) if c != MASK_COLOR]\n    hole_color = random.choice(available)\n    column_pool = [c for c in available if c != hole_color]\n    column_colors = _palette_row(mask_w, column_pool)\n    return column_colors, int(hole_color)\n\n\ndef _compose_grid(grid_h, grid_w, gap, mask, column_colors, hole_color) -> np.ndarray:\n    \"\"\"Paste mask and palette into disjoint row bands of a blank grid.\"\"\"\n    mask_h, mask_w = map(int, mask.shape)\n    hole_row = np.full(int(mask_w), int(hole_color), dtype=int)\n    palette = np.vstack([column_colors, column_colors, hole_row])\n    mask_sprite = np.where(mask, MASK_COLOR, BACKGROUND_COLOR)\n    grid = np.zeros((int(grid_h), int(grid_w)), dtype=int)\n    block_h = int(mask_h) + PALETTE_HEIGHT + int(gap)\n    top = random.randint(0, int(grid_h) - block_h)\n    palette_above = random.choice([True, False])\n    if palette_above:\n        palette_r = top\n        mask_r = top + PALETTE_HEIGHT + int(gap)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/5a719d11.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\nimport random\nfrom arc_utils import paste\n\n\ndef _bands(indices: np.ndarray) -> list[tuple[int, int]]:\n    assert indices.size > 0, \"expected at least one non-separator row/column\"\n    vals = [int(x) for x in indices]\n    bands: list[tuple[int, int]] = []\n    start = prev = vals[0]\n    for x in vals[1:]:\n        if x == prev + 1:\n            prev = x\n        else:\n            bands.append((start, prev))\n            start = prev = x\n    bands.append((start, prev))\n    return bands\n\n\ndef _separator_color(g: np.ndarray) -> int:\n    candidates = []\n    for color in np.unique(g):\n        has_full_row = bool(np.any(np.all(g == int(color), axis=1)))\n        has_full_col = bool(np.any(np.all(g == int(color), axis=0)))\n        if has_full_row and has_full_col:\n            candidates.append(int(color))\n    assert len(candidates) == 1, f\"expected unique row/column separator color, got {candidates}\"\n    return candidates[0]\n\n\ndef _base_and_motif_mask(panel: np.ndarray) -> tuple[int, np.ndarray]:\n    colors, counts = np.unique(panel, return_counts=True)\n    assert len(colors) == 2, f\"expected a two-color panel, got {colors.tolist()}\"\n    max_count = int(counts.max())\n    assert int(np.sum(counts == max_count)) == 1, \"panel base color must be structurally unique\"\n    base = int(colors[int(np.argmax(counts))])\n    return base, panel != base\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Within each horizontal pair of two-color panels, swap the motif masks and recolor each pasted mask with the source panel's base color.\n\n    Input structure:\n    - A separator color forms full blank rows and at least one full blank column.\n    - The non-separator area is split into row bands, each containing exactly two same-shaped rectangular panels.\n    - Each panel has a dominant base color and one minority motif color.\n\n    Rule:\n    - For every row band, clear each panel to its own base color.\n    - Paste the right panel's motif mask into the left panel using the right base color.\n    - Paste the left panel's motif mask into the right panel using the left base color.\n\n    Key insight:\n    - The motif colors themselves are distractors; only each motif's shape mask and the two panel base colors are exchanged.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"grid must be 2D\"\n\n    sep = _separator_color(g)\n    row_bands = _bands(np.where(~np.all(g == sep, axis=1))[0])\n    col_bands = _bands(np.where(~np.all(g == sep, axis=0))[0])\n    assert len(col_bands) == 2, f\"expected exactly two panel columns, got {len(col_bands)}\"\n\n    out = g.copy()\n    (lc0, lc1), (rc0, rc1) = col_bands\n    for r0, r1 in row_bands:\n        left = g[r0 : r1 + 1, lc0 : lc1 + 1]\n        right = g[r0 : r1 + 1, rc0 : rc1 + 1]\n        assert left.shape == right.shape, \"paired panels must have the same shape\"\n\n        left_base, left_motif = _base_and_motif_mask(left)\n        right_base, right_motif = _base_and_motif_mask(right)\n\n        new_left = np.full(left.shape, left_base, dtype=int)\n        new_right = np.full(right.shape, right_base, dtype=int)\n        new_left[right_motif] = right_base\n        new_right[left_motif] = left_base\n\n        out[r0 : r1 + 1, lc0 : lc1 + 1] = new_left\n        out[r0 : r1 + 1, rc0 : rc1 + 1] = new_right\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and separator geometry.\nNUM_BANDS_MIN, NUM_BANDS_MAX = 2, 4\nPANEL_H_MIN, PANEL_H_MAX = 6, 8\nPANEL_W_MIN, PANEL_W_MAX = 7, 8\nSEPARATOR_H = 2\nSEPARATOR_W_MIN, SEPARATOR_W_MAX = 1, 2\nMAX_GRID_SIZE = 30\n\n# Motif size and component growth.\nMOTIF_MARGIN = 1\nMOTIF_FILL_MIN, MOTIF_FILL_MAX = 0.10, 0.30\nMAX_MOTIF_COMPONENTS = 4\nCOMPONENT_WEIGHTS = (0.68, 0.16, 0.10, 0.06)\nPART_MIN_SIZE, PART_WEIGHT_OFFSET = 2, 0.2\n\n# Color sampling and retry limits.\nPALETTE = tuple(range(1, 10))\nSAME_BASE_PROB = 0.25\nGENERATION_RETRIES = 300\n\n\ndef _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:\n    out = []\n    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n        rr, cc = r + dr, c + dc\n        if MOTIF_MARGIN <= rr < h - MOTIF_MARGIN and MOTIF_MARGIN <= cc < w - MOTIF_MARGIN:\n            out.append((rr, cc))\n    return out\n\n\ndef _partition(total: int, parts: int) -> list[int]:\n    mins = [PART_MIN_SIZE] * parts if total >= PART_MIN_SIZE * parts else [1] * parts\n    remaining = total - sum(mins)\n    weights = [random.random() + PART_WEIGHT_OFFSET for _ in range(parts)]\n    sizes = mins[:]\n    for _ in range(remaining):\n        i = random.choices(range(parts), weights=weights, k=1)[0]\n        sizes[i] += 1\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _touches_other(label: np.ndarray, r: int, c: int, own: int) -> bool:\n    h, w = label.shape\n    for rr, cc in _neighbors4(r, c, h, w):\n        v = int(label[rr, cc])\n        if v not in (0, own):\n            return True\n    return False\n\n\ndef _grow_mask(h: int, w: int, target: int, n_comp: int) -> np.ndarray | None:\n    label = np.zeros((h, w), dtype=int)\n    cells = [(r, c) for r in range(MOTIF_MARGIN, h - MOTIF_MARGIN) for c in range(MOTIF_MARGIN, w - MOTIF_MARGIN)]\n    random.shuffle(cells)\n\n    seeds: list[tuple[int, int]] = []\n    for r, c in cells:\n        if all(abs(r - sr) + abs(c - sc) > 1 for sr, sc in seeds):\n            seeds.append((r, c))\n            if len(seeds) == n_comp:\n                break\n    if len(seeds) != n_comp:\n        return None\n\n    sizes = _partition(target, n_comp)\n    comps: list[set[tuple[int, int]]] = []\n    for i, (r, c) in enumerate(seeds, start=1):\n        label[r, c] = i\n        comps.append({(r, c)})\n\n    for i, size in enumerate(sizes, start=1):\n        while len(comps[i - 1]) < size:\n            frontier = set()\n            for rr, cc in comps[i - 1]:\n                frontier.update(_neighbors4(rr, cc, h, w))\n            choices = [\n                cell\n                for cell in frontier\n                if label[cell] == 0 and not _touches_other(label, cell[0], cell[1], i)\n            ]\n            if not choices:\n                return None\n            nr, nc = random.choice(choices)\n            label[nr, nc] = i\n            comps[i - 1].add((nr, nc))\n\n    return label > 0\n\n\ndef _random_motif_mask(h: int, w: int) -> np.ndarray | None:\n    area = h * w\n    lo = max(1, int(np.ceil(MOTIF_FILL_MIN * area)))\n    hi = min((h - 2 * MOTIF_MARGIN) * (w - 2 * MOTIF_MARGIN), int(np.floor(MOTIF_FILL_MAX * area)))\n    if lo > hi:\n        return None\n    target = random.randint(lo, hi)\n\n    max_comp = min(MAX_MOTIF_COMPONENTS, target)\n    n_comp = random.choices(range(1, max_comp + 1), weights=COMPONENT_WEIGHTS[:max_comp], k=1)[0]\n    return _grow_mask(h, w, target, n_comp)\n\n\ndef _pair_colors() -> tuple[int, int, int, int]:\n    colors = list(PALETTE)\n    if random.random() < SAME_BASE_PROB:\n        base = random.choice(colors)\n        left_motif, right_motif = random.sample([c for c in colors if c != base], 2)\n        return base, base, left_motif, right_motif\n    left_base, right_base, left_motif, right_motif = random.sample(colors, 4)\n    return left_base, right_base, left_motif, right_motif\n\n\ndef _choose_layout() -> tuple[int, int, int, int, int]:\n    num_bands = random.randint(NUM_BANDS_MIN, NUM_BANDS_MAX)\n    panel_h = random.choice([h for h in range(PANEL_H_MIN, PANEL_H_MAX + 1) if num_bands * h + SEPARATOR_H * (num_bands - 1) <= MAX_GRID_SIZE])\n    panel_w = random.randint(PANEL_W_MIN, PANEL_W_MAX)\n    sep_w = random.randint(SEPARATOR_W_MIN, SEPARATOR_W_MAX)\n    return num_bands, panel_h, panel_w, SEPARATOR_H, sep_w\n\n\ndef _make_pair_panels(panel_h: int, panel_w: int) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray] | None:\n    \"\"\"Build the input and output panels for one paired row band.\"\"\"\n    left_base, right_base, left_motif_color, right_motif_color = _pair_colors()\n    left_mask = _random_motif_mask(panel_h, panel_w)\n    right_mask = _random_motif_mask(panel_h, panel_w)\n    if left_mask is None or right_mask is None:\n        return None\n\n    in_left = np.full((panel_h, panel_w), left_base, dtype=int)\n    in_right = np.full((panel_h, panel_w), right_base, dtype=int)\n    out_left = np.full((panel_h, panel_w), left_base, dtype=int)\n    out_right = np.full((panel_h, panel_w), right_base, dtype=int)\n    in_left[left_mask] = left_motif_color\n    in_right[right_mask] = right_motif_color\n    out_left[right_mask] = right_base\n    out_right[left_mask] = left_base\n    return in_left, in_right, out_left, out_right\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    num_bands, panel_h, panel_w, sep_h, sep_w = _choose_layout()\n    height = num_bands * panel_h + (num_bands - 1) * sep_h\n    width = 2 * panel_w + sep_w\n    inp = np.zeros((height, width), dtype=int)\n    out = np.zeros((height, width), dtype=int)\n    right_c0 = panel_w + sep_w\n\n    for band in range(num_bands):\n        r0 = band * (panel_h + sep_h)\n        panels = _make_pair_panels(panel_h, panel_w)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg as _bg_color\nfrom arc_utils import colors_present, get_bg, paste\n\ndef _bbox(pts):\n    return bbox_coords(pts if isinstance(pts, np.ndarray) else np.asarray(list(pts), dtype=int))\ndef _cc4(mask):\n    return components_mask(mask, connectivity=4)\ndef _most_common(arr):\n    vals, counts = np.unique(np.asarray(arr), return_counts=True)\n    return int(vals[counts.argmax()])\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fit a grey bar into a grey frame by aligning projections with colored columns, then stack colors above.\n\n    Input structure:\n    - bg, a grey structural color forming two components: a large rectangular frame (slot) and a smaller bar with upward projections.\n    - Colored pixels inside the slot mark target columns.\n\n    Rule:\n    - Move the bar upward into the slot so its bottom edge sits one cell above the slot's interior bottom.\n    - Shift it horizontally so the bar's upward projections align column-wise with the colored pixels in the slot.\n    - Stack the colored pixels immediately above the bar projections in each column.\n\n    Key insight: The bar's projections act as keys that must align with the colored-column \"locks\" in the slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    # Background: most frequent. \"Grey\" structural color: most frequent non-bg.\n    bg = _bg_color(g)\n    other = g[g != bg]\n    if other.size == 0:\n        return g.copy()\n    grey = _most_common(other)\n\n    def comps_of_color(color: int):\n        comps = [(len(pts), _bbox(pts), pts) for pts in _cc4(g == color)]\n        comps.sort(key=lambda t: (-t[0], t[1]))\n        return comps\n\n    grey_comps = comps_of_color(grey)\n    if len(grey_comps) < 2:\n        return g.copy()\n\n    # Slot is the largest grey component (the right-side frame); bar is the next largest.\n    (_, slot_bbox, _), (_, bar_bbox, bar_pts) = grey_comps[0], grey_comps[1]\n    sr0, sc0, sr1, sc1 = slot_bbox\n\n    # Base output: keep only the slot bbox content, clear all colored pixels inside it.\n    out = np.full_like(g, bg)\n    out[sr0 : sr1 + 1, sc0 : sc1 + 1] = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region = out[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region[(slot_region != bg) & (slot_region != grey)] = bg\n\n    # Compute bar translation: bottom of bar sits 1 cell above slot interior bottom.\n    bar_base_row = max(r for r, _ in bar_pts)\n    slot_interior_bottom = sr1 - 1\n    target_base_row = slot_interior_bottom - 1\n    dy = target_base_row - bar_base_row\n\n    # Determine bar projection columns (columns with any bar pixel above the base row).\n    col_min_row = {}\n    for r, c in bar_pts:\n        col_min_row[c] = min(col_min_row.get(c, r), r)\n    src_proj_cols = sorted([c for c, rmin in col_min_row.items() if rmin < bar_base_row])\n\n    # Determine destination columns from colored pixels in the original slot.\n    dst_cols_set = set()\n    for r, c in np.argwhere((g != bg) & (g != grey)):\n        r = int(r)\n        c = int(c)\n        if sr0 <= r <= sr1 and sc0 <= c <= sc1:\n            dst_cols_set.add(c)\n    dst_cols = sorted(dst_cols_set)\n\n    # Compute a robust horizontal shift aligning projection columns to colored columns.\n    dx = None\n    if src_proj_cols and len(src_proj_cols) == len(dst_cols):\n        deltas = [d - s for s, d in zip(src_proj_cols, dst_cols)]\n        if len(set(deltas)) == 1:\n            dx = deltas[0]\n    if dx is None:\n        # Brute pick dx that maximizes overlap of shifted projection cols with dst cols.\n        best = (-1, 0)\n        dst_set = set(dst_cols)\n        for cand_dx in range(-w, w + 1):\n            score = sum((c + cand_dx) in dst_set for c in src_proj_cols)\n            if score > best[0]:\n                best = (score, cand_dx)\n        dx = best[1]\n\n    # Paste bar into the slot (overwrite with grey).\n    placed = []\n    for r, c in bar_pts:\n        rr = r + dy\n        cc = c + dx\n        if sr0 <= rr <= sr1 and sc0 <= cc <= sc1:\n            out[rr, cc] = grey\n            placed.append((rr, cc))\n\n    # Move colored pixels: for each affected column, stack them immediately above the top of the bar in that column.\n    # Use colors from the original grid (inside slot bbox), ordered top->bottom.\n    placed_by_col = {}\n    for rr, cc in placed:\n        placed_by_col.setdefault(cc, []).append(rr)\n\n    interior_top = sr0 + 1\n    interior_bottom = sr1 - 1\n\n    for col in dst_cols:\n        if col not in placed_by_col:\n            continue\n        bar_top = min(placed_by_col[col])\n        desired_bottom = bar_top - 1\n        if desired_bottom < interior_top:\n            continue\n\n        # Extract original colored pixels in this column (ignore bg/grey).\n        rows = [r for r in range(sr0, sr1 + 1) if g[r, col] != bg and g[r, col] != grey]\n        if not rows:\n            continue\n        colors = [int(g[r, col]) for r in rows]  # top->bottom order by construction\n\n        max_len = desired_bottom - interior_top + 1\n        if max_len <= 0:\n            continue\n        if len(colors) > max_len:\n            colors = colors[-max_len:]\n\n        start_row = desired_bottom - len(colors) + 1\n        start_row = max(start_row, interior_top)\n\n        # Paint (overwrite) within the interior only.\n        for i, colv in enumerate(colors):\n            rr = start_row + i\n            if interior_top <= rr <= interior_bottom:\n                out[rr, col] = colv\n\n    return out\n\n# --------------- generator (attempt 3 (Codex)) ---------------\n\n# --- Palette ---\nBG = 0\nGREY = 5\nPALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)  # colors != bg and != grey\n\n# --- Canvas geometry (fixed per spec) ---\nH, W = 8, 20\n\n# --- Frame (right-hand slot) ---\nFRAME_R0, FRAME_C0 = 0, 9            # top-left of frame patch\nFRAME_H, FRAME_W = 8, 11             # frame patch dimensions\nLEFT_WALL_OPEN_ROWS = (4, 5)         # rows where the left wall of the frame is open\n\n# --- Slot columns inside the frame ---\nSLOT_COLS = [11, 13, 15, 17]         # absolute col indices\nSLOT_LENS = [3, 4, 4, 3]             # per-col length counted from row 1\nSLOT_TOP_ROW = 1                     # topmost interior row of slot columns\n\n# --- Bar geometry ---\nBAR_INPUT_C0 = 1                     # left column of bar in the input (pre-translation)\nBAR_OUTPUT_C0 = 11                   # left column of bar in the expected output (post-translation)\nBAR_R0 = 2                           # top row where bar patch is pasted\nBAR_H, BAR_W = 4, 7                  # bar patch dimensions (4 rows tall, base at local row 3)\nBAR_LOCAL_PROJ_COLS = [0, 2, 4, 6]   # bar projection columns within the patch\nBAR_BASE_ABS_ROW = BAR_R0 + BAR_H - 1  # row 5, absolute row of bar base after paste\n\n# --- Sampling parameters ---\nHEIGHT0_RANGE = (2, 5)               # rng.integers(low, high) -> {2,3,4} for first proj\nHEIGHT_REST_RANGE = (1, 5)           # rng.integers(low, high) -> {1,2,3,4} for other projs\nMAX_ATTEMPTS = 300\n\n\ndef _frame_patch() -> np.ndarray:\n    \"\"\"Grey frame with top/bottom/right walls closed and a 2-cell gap in the left wall.\"\"\"\n    patch = np.zeros((FRAME_H, FRAME_W), dtype=int)\n    patch[[0, -1], :] = GREY                       # top and bottom rows\n    patch[:, -1] = GREY                            # right wall\n    patch[:, 0] = GREY                             # left wall (solid...)\n    patch[list(LEFT_WALL_OPEN_ROWS), 0] = BG       # ...with the opening carved out\n    return patch\n\n\ndef _bar_patch(heights: list[int]) -> np.ndarray:\n    \"\"\"Horizontal bar base with 4 upward grey projections at local cols {0,2,4,6}.\"\"\"\n    patch = np.zeros((BAR_H, BAR_W), dtype=int)\n    patch[-1, :] = GREY                            # full base row\n    for local_c, height in zip(BAR_LOCAL_PROJ_COLS, heights):\n        patch[BAR_H - height : BAR_H, local_c] = GREY\n    return patch\n\n\ndef _paint_slot_column(grid: np.ndarray, col: int, length: int, color: int,\n                       count: int, height: int | None) -> None:\n    \"\"\"Paint one slot column.\n\n    Input mode (height=None): top (length-count) cells grey caps, bottom `count` cells the color.\n    Output mode (height given): grey cap then up to (5-height) visible colored cells flush to top.\n    \"\"\"\n    cap = length - count\n    grid[SLOT_TOP_ROW : SLOT_TOP_ROW + cap, col] = GREY\n    if height is None:\n        grid[SLOT_TOP_ROW + cap : SLOT_TOP_ROW + length, col] = color\n        return\n    visible = min(count, BAR_BASE_ABS_ROW - height)  # = min(count, 5 - height)\n    if visible > 0:\n        row_end = BAR_BASE_ABS_ROW - height          # inclusive last colored row\n        grid[row_end - visible + 1 : row_end + 1, col] = color\n\n\ndef _build_grid(heights: list[int], colors: list[int], colored_counts: list[int],\n                bar_c0: int, output_mode: bool) -> np.ndarray:\n    grid = np.zeros((H, W), dtype=int)\n    paste(grid, _frame_patch(), FRAME_R0, FRAME_C0)\n    paste(grid, _bar_patch(heights), BAR_R0, bar_c0)\n    for col, length, color, count, height in zip(SLOT_COLS, SLOT_LENS, colors, colored_counts, heights):\n        _paint_slot_column(grid, col, length, color, count, height if output_mode else None)\n    return grid\n\n\ndef _sample_params(rng: np.random.Generator) -> tuple[list[int], list[int], list[int]]:\n    colors = [int(v) for v in rng.choice(PALETTE, size=len(SLOT_COLS), replace=False)]\n    colored_counts = [int(rng.integers(1, L + 1)) for L in SLOT_LENS]\n    heights = [int(rng.integers(*HEIGHT0_RANGE))]\n    heights.extend(int(rng.integers(*HEIGHT_REST_RANGE)) for _ in range(len(SLOT_COLS) - 1))\n    return heights, colors, colored_counts\n\n\ndef _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:\n    heights, colors, colored_counts = _sample_params(rng)\n    grid = _build_grid(heights, colors, colored_counts, BAR_INPUT_C0, output_mode=False)\n    expected = _build_grid(heights, colors, colored_counts, BAR_OUTPUT_C0, output_mode=True)\n\n    if get_bg(grid) != BG:\n        return None\n    if sorted(colors_present(grid, exclude=[BG, GREY])) != sorted(colors):\n        return None\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt(rng)\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"generate_input failed after {MAX_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/3ad05f52.py\"","aggregated_output":"from collections import Counter, deque\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, draw_line, find_components, get_bg, paste\nimport random\n\n\ndef _distances_from(sources: np.ndarray, passable: np.ndarray) -> np.ndarray:\n    h, w = passable.shape\n    dist = np.full((h, w), -1, dtype=int)\n    q: deque[tuple[int, int]] = deque()\n    for r, c in sources:\n        rr = int(r)\n        cc = int(c)\n        assert passable[rr, cc]\n        dist[rr, cc] = 0\n        q.append((rr, cc))\n\n    while q:\n        r, c = q.popleft()\n        nd = int(dist[r, c]) + 1\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nr = r + dr\n            nc = c + dc\n            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and dist[nr, nc] < 0:\n                dist[nr, nc] = nd\n                q.append((nr, nc))\n    return dist\n\n\ndef _framed_square_rooms(g: np.ndarray, wall: int, sizes: set[int]) -> list[tuple[int, int, int]]:\n    h, w = g.shape\n    rooms: list[tuple[int, int, int]] = []\n    for n in sorted(sizes):\n        assert n > 1\n        for r in range(h - n + 1):\n            for c in range(w - n + 1):\n                if np.any(g[r : r + n, c : c + n] == wall):\n                    continue\n\n                side_wall_counts: list[int] = []\n                if r > 0:\n                    side_wall_counts.append(int(np.count_nonzero(g[r - 1, c : c + n] == wall)))\n                if r + n < h:\n                    side_wall_counts.append(int(np.count_nonzero(g[r + n, c : c + n] == wall)))\n                if c > 0:\n                    side_wall_counts.append(int(np.count_nonzero(g[r : r + n, c - 1] == wall)))\n                if c + n < w:\n                    side_wall_counts.append(int(np.count_nonzero(g[r : r + n, c + n] == wall)))\n\n                if len(side_wall_counts) >= 3 and all(count >= n - 1 for count in side_wall_counts):\n                    rooms.append((r, c, n))\n    return rooms\n\n\ndef _component_bboxes(mask: np.ndarray) -> list[tuple[int, int, int, int, int]]:\n    h, w = mask.shape\n    seen = np.zeros_like(mask, dtype=bool)\n    components: list[tuple[int, int, int, int, int]] = []\n    for r in range(h):\n        for c in range(w):\n            if not mask[r, c] or seen[r, c]:\n                continue\n            q: deque[tuple[int, int]] = deque([(r, c)])\n            seen[r, c] = True\n            r0 = r1 = r\n            c0 = c1 = c\n            area = 0\n            while q:\n                rr, cc = q.popleft()\n                area += 1\n                r0 = min(r0, rr)\n                c0 = min(c0, cc)\n                r1 = max(r1, rr)\n                c1 = max(c1, cc)\n                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                    nr = rr + dr\n                    nc = cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n                        seen[nr, nc] = True\n                        q.append((nr, nc))\n            components.append((r0, c0, r1, c1, area))\n    return components\n\n\ndef _overlap_len(a0: int, a1: int, b0: int, b1: int) -> int:\n    return max(0, min(a1, b1) - max(a0, b0) + 1)\n\n\ndef _middle_fill_bounded_by_side_rooms(\n    bbox: tuple[int, int, int, int],\n    rooms: list[tuple[int, int, int]],\n) -> bool:\n    r0, c0, r1, c1 = bbox\n    left: list[tuple[int, int]] = []\n    right: list[tuple[int, int]] = []\n    above: list[tuple[int, int]] = []\n    below: list[tuple[int, int]] = []\n\n    for r, c, n in rooms:\n        rr1 = r + n - 1\n        cc1 = c + n - 1\n        row_overlap = _overlap_len(r0, r1, r, rr1)\n        col_overlap = _overlap_len(c0, c1, c, cc1)\n        if row_overlap > 0 and 1 <= c0 - cc1 <= 2:\n            left.append((r, rr1))\n        if row_overlap > 0 and 1 <= c - c1 <= 2:\n            right.append((r, rr1))\n        if col_overlap > 0 and 1 <= r0 - rr1 <= 2:\n            above.append((c, cc1))\n        if col_overlap > 0 and 1 <= r - r1 <= 2:\n            below.append((c, cc1))\n\n    def spans_contain(intervals_a: list[tuple[int, int]], intervals_b: list[tuple[int, int]], lo: int, hi: int) -> bool:\n        if not intervals_a or not intervals_b:\n            return False\n        a0 = min(start for start, _end in intervals_a)\n        a1 = max(end for _start, end in intervals_a)\n        b0 = min(start for start, _end in intervals_b)\n        b1 = max(end for _start, end in intervals_b)\n        return lo >= a0 and hi <= a1 and lo >= b0 and hi <= b1\n\n    return spans_contain(left, right, r0, r1) or spans_contain(above, below, c0, c1)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Paint the maze corridor and framed rooms lying on shortest paths between the two colored endpoint components.\n\n    Input structure\n    - The grid has a dominant background, one wall color forming thin orthogonal frames, and one endpoint/fill color.\n    - The endpoint/fill color forms exactly two 4-connected solid rectangular components; their larger side lengths define the framed room sizes.\n\n    Rule\n    - Treat wall pixels as blocked and every other pixel as passable.\n    - Find every passable pixel that lies on a shortest 4-connected path between the two endpoint components.\n    - Also fill any framed square room of an endpoint-derived size that intersects that shortest-path mask.\n\n    Key insight\n    - Shortest paths identify the route through open connector corridors, while the wall-bordered square rooms need to be expanded from the route centerline to their full interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    counts = Counter(map(int, g.flat))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 2\n    assert counts[bg] > max(counts[color] for color in non_bg)\n    non_bg_counts = {color: int(np.count_nonzero(g == color)) for color in non_bg}\n    wall_count = max(non_bg_counts.values())\n    wall_candidates = [color for color, count in non_bg_counts.items() if count == wall_count]\n    assert len(wall_candidates) == 1\n    wall = wall_candidates[0]\n    paint_candidates = [color for color in non_bg if color != wall]\n    assert len(paint_candidates) == 1\n    paint = paint_candidates[0]\n    assert non_bg_counts[wall] > non_bg_counts[paint]\n\n    endpoints = find_components(g, bg=bg, colors=[paint], connectivity=4)\n    assert len(endpoints) == 2\n    endpoint_coords = [component[\"coords\"] for component in endpoints]\n\n    room_sizes: set[int] = set()\n    for coords in endpoint_coords:\n        r0, c0, r1, c1 = bbox_coords(coords)\n        bh = r1 - r0 + 1\n        bw = c1 - c0 + 1\n        assert coords.shape[0] == bh * bw\n        room_sizes.add(max(bh, bw))\n\n    passable = g != wall\n    dist0 = _distances_from(endpoint_coords[0], passable)\n    dist1 = _distances_from(endpoint_coords[1], passable)\n    endpoint_distances = [int(dist0[r, c]) for r, c in endpoint_coords[1]]\n    reachable_distances = [d for d in endpoint_distances if d >= 0]\n    assert len(reachable_distances) == len(endpoint_distances)\n    shortest = min(reachable_distances)\n\n    route = (dist0 >= 0) & (dist1 >= 0) & (dist0 + dist1 == shortest)\n    assert np.any(route)\n\n    fill = route.copy()\n    rooms = _framed_square_rooms(g, wall, room_sizes)\n    assert rooms\n    for r, c, n in rooms:\n        if np.any(route[r : r + n, c : c + n]):\n            fill[r : r + n, c : c + n] = True\n\n    room_mask = np.zeros_like(fill, dtype=bool)\n    for r, c, n in rooms:\n        room_mask[r : r + n, c : c + n] = True\n    open_fill = fill & (g == bg) & ~room_mask\n    for r0, c0, r1, c1, area in _component_bboxes(open_fill):\n        if r1 > r0 and c1 > c0 and area >= 20:\n            assert _middle_fill_bounded_by_side_rooms(\n                (r0, c0, r1, c1),\n                rooms,\n            ), \"middle fill must stay within the facing room-frame spans\"\n\n    H, W = g.shape\n    for r, c, n in rooms:\n        has_doorway = False\n        if r > 0:\n            has_doorway = has_doorway or np.any(g[r - 1, c : c + n] != wall)\n        if r + n < H:\n            has_doorway = has_doorway or np.any(g[r + n, c : c + n] != wall)\n        if c > 0:\n            has_doorway = has_doorway or np.any(g[r : r + n, c - 1] != wall)\n        if c + n < W:\n            has_doorway = has_doorway or np.any(g[r : r + n, c + n] != wall)\n        if has_doorway:\n            assert np.any(fill[r : r + n, c : c + n]), \"rooms with doorways must be on the shortest path\"\n\n    out = g.copy()\n    out[fill & (g == bg)] = paint\n    return out\n\n# --------------- generator (attempt 2 refined middle-fill) ---------------\n\nBG = 0\nWALL = 8\nPAINT_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]\n\n# Canvas bounds used by the observed evaluation examples.\nROW_MIN = 22\nROW_MAX = 29\nCOL_MIN = 24\nCOL_MAX = 28\n\n# Room-grid geometry and room-count filters.\nROOM_SIZE_RANGE = range(3, 6)\nROOM_GRID_RANGE = range(1, 8)\nBLOCK_ROOM_MIN = 3\nBLOCK_ROOM_MAX = 14\nTOTAL_ROOM_MIN = 7\nTOTAL_ROOM_MAX = 22\nGAP_RANGE = range(3, 8)\nORIENTATIONS = (\"vertical\", \"horizontal\")\n\n# Coarse layout and final route validation thresholds.\nLAYOUT_DISTANCE_MIN = 36\nLAYOUT_DISTANCE_FLOORS = [36, 42, 48, 54, 60]\nSHORTEST_DISTANCE_MIN = 36\nSHORTEST_DISTANCE_MAX = 72\nTURN_MIN = 8\nTURN_MAX = 21\nON_ROUTE_ROOM_MIN = 6\nON_ROUTE_ROOM_MAX = 14\nOFF_ROUTE_ROOM_MIN = 1\nOFF_ROUTE_ROOM_MAX = 8\n\n# Connector sampling: offset connectors create the observed middle fill region.\nOFFSET_CONNECTOR_PROB = 0.60\nCONNECTOR_CHOICE_TRIES = 300\nCONNECTOR_DELTA_MAX = 12\nCONNECTOR_DELTA_MIN_CAP = 5\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/25c199f5.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg\nimport random\n\n\ndef _separator_columns(g: np.ndarray, bg: int) -> list[int]:\n    H, W = g.shape\n    candidates: list[list[int]] = []\n    for color in colors_present(g, exclude={bg}):\n        mask = g == int(color)\n        full_cols = [c for c in range(W) if bool(np.all(mask[:, c]))]\n        if len(full_cols) != 2:\n            continue\n        if int(mask.sum()) != int(H * len(full_cols)):\n            continue\n        s0, s1 = full_cols\n        if s0 > 0 and s1 > s0 + 1 and s1 < W - 1:\n            panel_w = s0\n            if s1 - s0 - 1 == panel_w and W - s1 - 1 == panel_w:\n                candidates.append(full_cols)\n\n    assert len(candidates) == 1\n    return candidates[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack the non-background rows from three separated panels into one panel, scanning panels right-to-left.\n\n    Input structure:\n    - A rectangular grid contains three equal-size panels separated by two full-height divider columns.\n    - The background is the dominant color; divider pixels use a color that appears only in the divider columns.\n\n    Rule:\n    - Read panels from right to left, and within each panel read rows from top to bottom.\n    - Keep each row that contains any non-background pixel, discarding all-background rows.\n    - Place the kept rows at the bottom of a single panel-shaped output, padding above with background rows.\n\n    Key insight:\n    - The task is row packing: the divider columns mark independent panels, and only the occupied rows are moved.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    s0, s1 = _separator_columns(g, bg)\n    panel_w = int(s0)\n    assert H == panel_w\n\n    panels = [\n        g[:, :s0],\n        g[:, s0 + 1 : s1],\n        g[:, s1 + 1 :],\n    ]\n    rows: list[np.ndarray] = []\n    for panel in reversed(panels):\n        assert panel.shape == (H, panel_w)\n        for r in range(H):\n            row = panel[r, :]\n            if bool(np.any(row != bg)):\n                rows.append(row.copy())\n\n    assert 0 < len(rows) <= H\n    for i in range(len(rows) - 1):\n        cols_a = set(int(c) for c in range(panel_w) if int(rows[i][c]) != bg)\n        cols_b = set(int(c) for c in range(panel_w) if int(rows[i + 1][c]) != bg)\n        assert cols_a & cols_b, \"consecutive non-bg rows must share at least one column\"\n    out = np.full((H, panel_w), bg, dtype=int)\n    out[H - len(rows) :, :] = np.asarray(rows, dtype=int)\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and fixed palette observed in the task.\nPANEL_SIZE_RANGE = (4, 6)\nBG_COLOR, SEPARATOR_COLOR = 7, 6\nCONTENT_COLORS = (1, 5)\n# Packed output rows and per-panel block heights.\nPACKED_ROW_RANGE = (3, 5)\nGROUP_ROW_RANGE = (1, 3)\n# Row intervals and hollow 3-row block variants.\nROW_WIDTH_RANGE = (1, 5)\nHOLLOW_HEIGHT = 3\nHOLLOW_WIDTH_RANGE = (3, 5)\nHOLLOW_PROBABILITY = 0.35\n# Rejection-sampling retry limit.\nGENERATION_RETRIES = 300\n\n\ndef _partition_rows(total: int) -> tuple[int, int, int]:\n    min_rows, max_rows = GROUP_ROW_RANGE\n    choices = [\n        (right, middle, left)\n        for right in range(min_rows, max_rows + 1)\n        for middle in range(min_rows, max_rows + 1)\n        for left in range(min_rows, max_rows + 1)\n        if right + middle + left == total\n    ]\n    return random.choice(choices)\n\n\ndef _interval(width: int, must_include: int | None = None) -> tuple[int, int]:\n    min_len, max_config_len = ROW_WIDTH_RANGE\n    max_len = min(max_config_len, width)\n    length = random.randint(min_len, max_len)\n    if must_include is None:\n        start = random.randint(0, width - length)\n    else:\n        lo = max(0, must_include - length + 1)\n        hi = min(must_include, width - length)\n        start = random.randint(lo, hi)\n    return start, start + length - 1\n\n\ndef _solid_block(height: int, width: int, bg: int, color: int) -> np.ndarray:\n    block = np.full((height, width), bg, dtype=int)\n    left, right = _interval(width)\n    block[0, left : right + 1] = color\n    for r in range(1, height):\n        overlap_col = random.randint(left, right)\n        left, right = _interval(width, overlap_col)\n        block[r, left : right + 1] = color\n    return block\n\n\ndef _hollow_block(width: int, bg: int, color: int) -> np.ndarray:\n    block = np.full((HOLLOW_HEIGHT, width), bg, dtype=int)\n    min_width, max_width = HOLLOW_WIDTH_RANGE\n    shape_w = random.randint(min_width, min(max_width, width))\n    left = random.randint(0, width - shape_w)\n    right = left + shape_w - 1\n    block[0, left : right + 1] = color\n    block[1, left] = color\n    block[1, right] = color\n    block[2, left : right + 1] = color\n    return block\n\n\ndef _connected_block(height: int, width: int, bg: int, color: int) -> np.ndarray:\n    if height == HOLLOW_HEIGHT and width >= HOLLOW_WIDTH_RANGE[0] and random.random() < HOLLOW_PROBABILITY:\n        return _hollow_block(width, bg, color)\n    return _solid_block(height, width, bg, color)\n\n\ndef _place_block(block: np.ndarray, panel_size: int, bg: int) -> np.ndarray:\n    panel = np.full((panel_size, panel_size), bg, dtype=int)\n    offset = random.randint(0, panel_size - block.shape[0])\n    panel[offset : offset + block.shape[0], :] = block\n    return panel\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(*PANEL_SIZE_RANGE)\n    bg = BG_COLOR\n    sep = SEPARATOR_COLOR\n    A, B = random.sample(CONTENT_COLORS, 2)\n\n    K = random.randint(PACKED_ROW_RANGE[0], min(PACKED_ROW_RANGE[1], H))\n    right_n, middle_n, left_n = _partition_rows(K)\n\n    right_block = _connected_block(right_n, H, bg, A)\n    middle_block = _connected_block(middle_n, H, bg, B)\n    left_block = _connected_block(left_n, H, bg, A)\n\n    stacked_rows = np.vstack([right_block, middle_block, left_block])\n    out = np.full((H, H), bg, dtype=int)\n    out[H - K :, :] = stacked_rows\n\n    panels = tuple(_place_block(block, H, bg) for block in (left_block, middle_block, right_block))\n    sep_col = np.full((H, 1), sep, dtype=int)\n    inp = np.hstack([panels[0], sep_col, panels[1], sep_col, panels[2]])\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except AssertionError:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 25c199f5 input\")\n","exit_code":0,"status":"completed"}}
