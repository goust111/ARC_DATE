{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/7e576d6e.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import components_mask, get_bg\nimport random\n\n\ndef _color_counts(g: np.ndarray) -> dict[int, int]:\n    vals, counts = np.unique(g, return_counts=True)\n    return {int(v): int(n) for v, n in zip(vals, counts)}\n\n\ndef _roles(g: np.ndarray) -> tuple[int, int, int, int]:\n    bg = get_bg(g)\n    counts = _color_counts(g)\n    colors = [c for c in counts if c != bg]\n    assert len(colors) == 3, \"expected wall, door, and marker colors\"\n\n    marker_colors = [c for c in colors if counts[c] == 2]\n    assert len(marker_colors) == 1, \"expected exactly two marker pixels\"\n    path_color = marker_colors[0]\n\n    remaining = [c for c in colors if c != path_color]\n    areas = {c: counts[c] for c in remaining}\n    door_area = min(areas.values())\n    wall_area = max(areas.values())\n    door_colors = [c for c in remaining if counts[c] == door_area]\n    wall_colors = [c for c in remaining if counts[c] == wall_area]\n    assert len(door_colors) == 1 and len(wall_colors) == 1\n    assert door_area < wall_area, \"door color must be the smaller non-marker object set\"\n    return int(bg), int(path_color), int(door_colors[0]), int(wall_colors[0])\n\n\ndef _door_centers(g: np.ndarray, door_color: int) -> tuple[str, list[tuple[int, int]]]:\n    comps = components_mask(g == int(door_color), connectivity=4)\n    assert comps, \"expected door segments\"\n\n    orientations: list[str] = []\n    centers: list[tuple[int, int]] = []\n    for coords in comps:\n        assert coords.shape[0] == 3, \"each door segment is three pixels long\"\n        r0, c0 = coords.min(axis=0)\n        r1, c1 = coords.max(axis=0)\n        height = int(r1 - r0 + 1)\n        width = int(c1 - c0 + 1)\n        if height == 3 and width == 1:\n            orientations.append(\"vertical\")\n            centers.append((int(r0 + 1), int(c0)))\n        elif height == 1 and width == 3:\n            orientations.append(\"horizontal\")\n            centers.append((int(r0), int(c0 + 1)))\n        else:\n            raise AssertionError(\"door segments must be straight length-3 bars\")\n\n    assert len(set(orientations)) == 1, \"all doors must share an orientation\"\n    return orientations[0], centers\n\n\ndef _paint_segment(\n    out: np.ndarray,\n    start: tuple[int, int],\n    end: tuple[int, int],\n    color: int,\n    allowed: set[int],\n) -> None:\n    r0, c0 = map(int, start)\n    r1, c1 = map(int, end)\n    assert r0 == r1 or c0 == c1, \"path segments must be orthogonal\"\n    height, width = out.shape\n    assert 0 <= r0 < height and 0 <= r1 < height\n    assert 0 <= c0 < width and 0 <= c1 < width\n\n    if r0 == r1:\n        for c in range(min(c0, c1), max(c0, c1) + 1):\n            assert int(out[r0, c]) in allowed, \"path may only cover bg, doors, or markers\"\n            out[r0, c] = int(color)\n    else:\n        for r in range(min(r0, r1), max(r0, r1) + 1):\n            assert int(out[r, c0]) in allowed, \"path may only cover bg, doors, or markers\"\n            out[r, c0] = int(color)\n\n\ndef _markers(g: np.ndarray, path_color: int) -> list[tuple[int, int]]:\n    coords = np.argwhere(g == int(path_color))\n    assert coords.shape[0] == 2, \"expected two marker pixels\"\n    return [tuple(map(int, coord)) for coord in coords]\n\n\ndef _solve_vertical_walls(\n    g: np.ndarray,\n    centers: list[tuple[int, int]],\n    markers: list[tuple[int, int]],\n    bg: int,\n    path_color: int,\n    door_color: int,\n    wall_color: int,\n) -> np.ndarray:\n    out = g.copy()\n    centers = sorted(centers, key=lambda p: p[1])\n    wall_cols = sorted(set(map(int, np.argwhere(g == int(wall_color))[:, 1])))\n    assert len(wall_cols) == len(centers), \"each vertical wall must have one door\"\n    assert [c for _r, c in centers] == wall_cols\n    for _r, c in centers:\n        assert np.all(np.isin(g[:, c], [wall_color, door_color]))\n\n    start, end = sorted(markers, key=lambda p: p[1])\n    assert start[1] < centers[0][1] and end[1] > centers[-1][1]\n\n    allowed = {int(bg), int(path_color), int(door_color)}\n    cur = start\n    for door_r, door_c in centers:\n        approach = (cur[0], door_c - 1)\n        _paint_segment(out, cur, approach, path_color, allowed)\n        _paint_segment(out, approach, (door_r, door_c - 1), path_color, allowed)\n        _paint_segment(out, (door_r, door_c - 1), (door_r, door_c), path_color, allowed)\n        cur = (door_r, door_c)\n\n    _paint_segment(out, cur, (cur[0], end[1]), path_color, allowed)\n    _paint_segment(out, (cur[0], end[1]), end, path_color, allowed)\n    return out\n\n\ndef _solve_horizontal_walls(\n    g: np.ndarray,\n    centers: list[tuple[int, int]],\n    markers: list[tuple[int, int]],\n    bg: int,\n    path_color: int,\n    door_color: int,\n    wall_color: int,\n) -> np.ndarray:\n    out = g.copy()\n    centers = sorted(centers, key=lambda p: p[0])\n    wall_rows = sorted(set(map(int, np.argwhere(g == int(wall_color))[:, 0])))\n    assert len(wall_rows) == len(centers), \"each horizontal wall must have one door\"\n    assert [r for r, _c in centers] == wall_rows\n    for r, _c in centers:\n        assert np.all(np.isin(g[r, :], [wall_color, door_color]))\n\n    start, end = sorted(markers, key=lambda p: p[0])\n    assert start[0] < centers[0][0] and end[0] > centers[-1][0]\n\n    allowed = {int(bg), int(path_color), int(door_color)}\n    cur = start\n    for door_r, door_c in centers:\n        approach = (door_r - 1, cur[1])\n        _paint_segment(out, cur, approach, path_color, allowed)\n        _paint_segment(out, approach, (door_r - 1, door_c), path_color, allowed)\n        _paint_segment(out, (door_r - 1, door_c), (door_r, door_c), path_color, allowed)\n        cur = (door_r, door_c)\n\n    _paint_segment(out, cur, (end[0], cur[1]), path_color, allowed)\n    _paint_segment(out, (end[0], cur[1]), end, path_color, allowed)\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Draw the marker-colored route through the centers of all doors in the parallel wall maze.\n\n    Input structure:\n    - The grid has a background, parallel full-span walls, one three-pixel door\n      segment in each wall, and two marker pixels sharing a color.\n    - Walls are either all vertical or all horizontal, and the markers are on\n      opposite outer sides of the wall set.\n\n    Rule:\n    - Keep the scene unchanged except for the route.\n    - Visit the door centers in wall order from the upper/left marker side to\n      the lower/right marker side.\n    - In each corridor, draw an orthogonal path to the cell just before the next\n      wall, move along that wall to the door center, cross the center, and\n      continue to the next corridor; after the last door, connect to the other\n      marker.\n\n    Key insight:\n    - The three-pixel door segments mark the only crossing points through a set\n      of parallel walls, so the output is the corridor path threaded through\n      those centers.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg, path_color, door_color, wall_color = _roles(g)\n    orientation, centers = _door_centers(g, door_color)\n    markers = _markers(g, path_color)\n\n    if orientation == \"vertical\":\n        return _solve_vertical_walls(g, centers, markers, bg, path_color, door_color, wall_color)\n    assert orientation == \"horizontal\"\n    return _solve_horizontal_walls(g, centers, markers, bg, path_color, door_color, wall_color)\n\n# --------------- generator (att1) ---------------\n\n# Canvas and color role sampling.\nGRID_H = 30\nGRID_W = 30\nCOLOR_POOL = range(10)\nN_ROLE_COLORS = 4\n\n# Parallel wall and door geometry.\nORIENTATIONS = (\"vertical\", \"horizontal\")\nWALL_COUNT_RANGE = (3, 4)\nWALL_POS_LO = 4\nWALL_POS_HI_MARGIN = 5\nWALL_MIN_GAP = 2\nDOOR_CENTER_LO = 3\nDOOR_CENTER_HI_MARGIN = 4\n\n# Marker placement and retry budget.\nMARKER_EDGE_RANGE = (1, 3)\nMARKER_FREE_LO = 1\nMARKER_FREE_HI_MARGIN = 2\nGEN_RETRIES = 300\n\n\ndef _place_positions(n: int, lo: int, hi: int, min_gap: int, rng: random.Random) -> list[int] | None:\n    \"\"\"Place n positions in [lo..hi] with pairwise gap >= min_gap between consecutive sorted positions.\"\"\"\n    needed = n + (n - 1) * min_gap\n    span = hi - lo + 1\n    if span < needed:\n        return None\n    compressed_span = span - (n - 1) * min_gap\n    picks = sorted(rng.sample(range(compressed_span), n))\n    return [lo + picks[i] + i * min_gap for i in range(n)]\n\n\ndef _sample_wall_layout(orientation: str, n_walls: int, rng: random.Random):\n    \"\"\"Return wall positions and per-wall door centers for the chosen orientation.\"\"\"\n    wall_axis, door_axis = (GRID_W, GRID_H) if orientation == \"vertical\" else (GRID_H, GRID_W)\n    walls = _place_positions(\n        n_walls,\n        lo=WALL_POS_LO,\n        hi=wall_axis - WALL_POS_HI_MARGIN,\n        min_gap=WALL_MIN_GAP,\n        rng=rng,\n    )\n    if walls is None:\n        return None\n    doors = [rng.randint(DOOR_CENTER_LO, door_axis - DOOR_CENTER_HI_MARGIN) for _ in range(n_walls)]\n    return walls, doors\n\n\ndef _sample_markers(orientation: str, rng: random.Random) -> tuple[tuple[int, int], tuple[int, int]]:\n    \"\"\"Sample start/end markers on opposite outer corridors.\"\"\"\n    edge_lo, edge_hi = MARKER_EDGE_RANGE\n    if orientation == \"vertical\":\n        start_col = rng.randint(edge_lo, edge_hi)\n        start_row = rng.randint(MARKER_FREE_LO, GRID_H - MARKER_FREE_HI_MARGIN)\n        end_col = rng.randint(GRID_W - edge_hi - 1, GRID_W - edge_lo - 1)\n        end_row = rng.randint(MARKER_FREE_LO, GRID_H - MARKER_FREE_HI_MARGIN)\n    else:\n        start_row = rng.randint(edge_lo, edge_hi)\n        start_col = rng.randint(MARKER_FREE_LO, GRID_W - MARKER_FREE_HI_MARGIN)\n        end_row = rng.randint(GRID_H - edge_hi - 1, GRID_H - edge_lo - 1)\n        end_col = rng.randint(MARKER_FREE_LO, GRID_W - MARKER_FREE_HI_MARGIN)\n    return (start_row, start_col), (end_row, end_col)\n\n\ndef _render_grid(\n    orientation, bg, wall_color, door_color, marker_color, walls, doors, start, end\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import get_bg\nimport random\n\n\ndef _solid_separator_cross(g: np.ndarray, bg: int) -> tuple[int, int]:\n    height, width = g.shape\n    solid_rows = [r for r in range(height) if np.all(g[r, :] == bg)]\n    solid_cols = [c for c in range(width) if np.all(g[:, c] == bg)]\n    assert len(solid_rows) == 1, \"expected exactly one solid background separator row\"\n    assert len(solid_cols) == 1, \"expected exactly one solid background separator column\"\n    return solid_rows[0], solid_cols[0]\n\n\ndef _quadrants(cross_row: int, cross_col: int, height: int, width: int) -> list[tuple[slice, slice]]:\n    top_h = cross_row\n    bottom_h = height - cross_row - 1\n    left_w = cross_col\n    right_w = width - cross_col - 1\n    assert top_h > 0 and left_w > 0, \"separator must leave nonempty corner regions\"\n    assert top_h == bottom_h, \"separator row must split equal-height regions\"\n    assert left_w == right_w, \"separator column must split equal-width regions\"\n\n    return [\n        (slice(0, cross_row), slice(0, cross_col)),\n        (slice(0, cross_row), slice(cross_col + 1, width)),\n        (slice(cross_row + 1, height), slice(0, cross_col)),\n        (slice(cross_row + 1, height), slice(cross_col + 1, width)),\n    ]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the one blank in each corner region so all four regions have the same color multiset.\n\n    Input structure:\n    - The dominant background color forms one solid separator row and one solid\n      separator column.\n    - The separator cross splits the grid into four equal rectangular corner regions.\n    - Each corner region contains exactly one background-colored blank pixel.\n\n    Rule:\n    - Count the non-background colors in each corner region.\n    - The completed region multiset is defined by the maximum observed count of\n      each color across the four regions.\n    - Replace each region's blank pixel with the single color needed to match that\n      completed multiset.\n\n    Key insight:\n    - The separator color inside a corner region is a missing value marker; comparing\n      the four regions reveals the shared multiset without using numeric color order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    color_counts = Counter(map(int, g.reshape(-1)))\n    assert all(\n        color == bg or count < color_counts[bg] for color, count in color_counts.items()\n    ), \"background color must be uniquely dominant\"\n\n    cross_row, cross_col = _solid_separator_cross(g, bg)\n    regions = _quadrants(cross_row, cross_col, height, width)\n    region_shape = g[regions[0]].shape\n    region_area = int(np.prod(region_shape))\n\n    counts_by_region: list[Counter[int]] = []\n    blank_positions: list[tuple[int, int]] = []\n    for row_slice, col_slice in regions:\n        region = g[row_slice, col_slice]\n        assert region.shape == region_shape, \"all corner regions must have the same shape\"\n        blanks = np.argwhere(region == bg)\n        assert len(blanks) == 1, \"each corner region must have exactly one blank\"\n\n        counts_by_region.append(Counter(map(int, region[region != bg].reshape(-1))))\n        local_r, local_c = map(int, blanks[0])\n        blank_positions.append((row_slice.start + local_r, col_slice.start + local_c))\n\n    target_counts: Counter[int] = Counter()\n    for counts in counts_by_region:\n        for color, count in counts.items():\n            target_counts[color] = max(target_counts[color], count)\n    assert sum(target_counts.values()) == region_area, \"completed region multiset must be unique\"\n\n    out = g.copy()\n    for counts, (row, col) in zip(counts_by_region, blank_positions):\n        missing = target_counts - counts\n        assert len(missing) == 1, \"each blank must have exactly one matching fill color\"\n        fill_color, fill_count = next(iter(missing.items()))\n        assert fill_count == 1, \"each corner region must need one pixel of the fill color\"\n        out[row, col] = fill_color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n# Canvas/palette bounds.\nGRID_HALF_MIN = 2\nGRID_HALF_MAX = 6\nCOLOR_COUNT = 10\nMIN_TARGET_COLORS = 3\nMAX_NON_BG_COLORS = COLOR_COUNT - 1\n# Layout probabilities and constraints.\nPREFERRED_GRID_HALF = (2, 2)\nPREFERRED_GRID_PROB = 0.65\nQUADRANT_COUNT = 4\nSEPARATOR_WIDTH = 1\nBG_DOMINANCE_MARGIN = 1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _gen_bounded_composition(total: int, parts: int, max_each: int) -> list[int] | None:\n    if parts <= 0 or total < parts or total > parts * max_each:\n        return None\n\n    counts = []\n    remaining = total\n    for i in range(parts):\n        slots_left = parts - i - 1\n        lo = max(1, remaining - slots_left * max_each)\n        hi = min(max_each, remaining - slots_left)\n        counts.append(random.randint(lo, hi))\n        remaining -= counts[-1]\n\n    random.shuffle(counts)\n    return counts\n\n\ndef _gen_grid_options() -> list[tuple[int, int, list[int], int]]:\n    options = []\n    for k in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n        for m in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n            area = k * m\n            bg_count = 2 * k + 2 * m + SEPARATOR_WIDTH + QUADRANT_COUNT\n            max_target_count = (bg_count - BG_DOMINANCE_MARGIN) // QUADRANT_COUNT\n            max_colors = min(MAX_NON_BG_COLORS, area)\n            valid_counts = [\n                c\n                for c in range(MIN_TARGET_COLORS, max_colors + 1)\n                if area <= c * max_target_count\n            ]\n            if valid_counts:\n                options.append((k, m, valid_counts, max_target_count))\n    return options\n\n\ndef _gen_pick_grid_option() -> tuple[int, int, list[int], int]:\n    options = _gen_grid_options()\n    if random.random() < PREFERRED_GRID_PROB:\n        preferred_k, preferred_m = PREFERRED_GRID_HALF\n        for option in options:\n            if option[0] == preferred_k and option[1] == preferred_m:\n                return option\n    return random.choice(options)\n\n\ndef _gen_quadrant_offsets(k: int, m: int) -> list[tuple[int, int]]:\n    sep = SEPARATOR_WIDTH\n    return [(0, 0), (0, m + sep), (k + sep, 0), (k + sep, m + sep)]\n\n\ndef _gen_missing_colors(non_bg_colors: list[int]) -> list[int]:\n    missing_colors = [random.choice(non_bg_colors) for _ in range(QUADRANT_COUNT)]\n    if len(set(missing_colors)) == 1:\n        alternatives = [c for c in non_bg_colors if c != missing_colors[0]]\n        missing_colors[-1] = random.choice(alternatives)\n    return missing_colors\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = random.randrange(COLOR_COUNT)\n    k, m, valid_color_counts, max_target_count = _gen_pick_grid_option()\n    area = k * m\n\n    color_count = random.choice(valid_color_counts)\n    non_bg_colors = random.sample([c for c in range(COLOR_COUNT) if c != bg], color_count)\n    target_counts = _gen_bounded_composition(area, color_count, max_target_count)\n    if target_counts is None:\n        return None\n\n    target_values = []\n    for color, count in zip(non_bg_colors, target_counts):\n        target_values.extend([color] * count)\n\n    missing_colors = _gen_missing_colors(non_bg_colors)\n    out = np.full((2 * k + SEPARATOR_WIDTH, 2 * m + SEPARATOR_WIDTH), bg, dtype=int)\n    inp = out.copy()\n\n    for (r0, c0), missing_color in zip(_gen_quadrant_offsets(k, m), missing_colors):\n        values = target_values[:]\n        random.shuffle(values)\n        quadrant_out = np.array(values, dtype=int).reshape(k, m)\n\n        candidates = np.argwhere(quadrant_out == missing_color)\n        blank_r, blank_c = map(int, candidates[random.randrange(len(candidates))])\n        quadrant_in = quadrant_out.copy()\n        quadrant_in[blank_r, blank_c] = bg\n\n        out[r0 : r0 + k, c0 : c0 + m] = quadrant_out\n        inp[r0 : r0 + k, c0 : c0 + m] = quadrant_in\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid e3fe1151 input\")\n","exit_code":0,"status":"completed"}}
