{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/2b83f449.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom arc_utils import get_bg, label_mask\nimport itertools\nfrom arc_utils import paste\nfrom collections import defaultdict\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Simulate tokens falling through a pipe network after gates rotate open.\n\n    Input structure:\n    - Wall (0), bg (pipe fill), gate (horizontal 1×3 bars), token (small edge pixels).\n\n    Rule:\n    - Rotate each gate into a vertical blocker; gate cells become bg.\n    - Tokens drop downward through bg, choosing the extreme column for their side (left→min, right→max).\n    - Tokens settle at true pipe ends (adjacent to wall/boundary), packing inward.\n\n    Key insight: Tokens select drop columns by entry side and land at wall-bounded endpoints, ignoring blocker-bounded ones.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    colors = set(map(int, g.flatten()))\n\n    # --- infer gate color: any color forming 4-ccs of size 3 with bbox 1x3 (horizontal) ---\n    gate = None\n    for col in sorted(colors):\n        if int(col) == 0:\n            continue\n        lab, n = label_mask(g == int(col), connectivity=4)\n        found = False\n        for k in range(1, int(n) + 1):\n            pts = np.argwhere(lab == int(k))\n            if int(pts.shape[0]) != 3:\n                continue\n            r0, c0 = pts.min(axis=0)\n            r1, c1 = pts.max(axis=0)\n            if int(r1 - r0 + 1) == 1 and int(c1 - c0 + 1) == 3:\n                found = True\n                break\n        if found:\n            gate = int(col)\n            break\n    assert not (gate is None)\n\n    # --- token/bg inference ---\n    cnt_all = Counter(map(int, g.flatten()))\n    cand_token = [c for c in colors if int(c) not in (0, int(gate))]\n    assert not (not cand_token)\n    token = int(min(cand_token, key=lambda c: (int(cnt_all[int(c)]), int(c))))\n    cand_bg = [c for c in colors if int(c) not in (0, int(gate), int(token))]\n    assert cand_bg\n    bg = int(max(cand_bg, key=lambda c: (int(cnt_all[int(c)]), -int(c))))\n\n    # --- opened gate color (vertical post) ---\n    open_col = 6 if int(gate) == 7 and 6 not in colors else int(gate - 1) if int(gate) > 0 else 6\n\n    # --- rotate gates (gates open into bg, center becomes vertical open_col) ---\n    out = g.copy()\n    lab, n = label_mask(out == int(gate), connectivity=4)\n    for k in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(k))\n        if int(pts.shape[0]) != 3:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        if int(r1 - r0 + 1) != 1 or int(c1 - c0 + 1) != 3:\n            continue\n        r = int(r0)\n        c0 = int(c0)\n        center_c = int(c0 + 1)\n        out[int(r), int(c0) : int(c0) + 3] = int(bg)\n        for rr in (int(r - 1), int(r), int(r + 1)):\n            if 0 <= int(rr) < H:\n                out[int(rr), int(center_c)] = int(open_col)\n\n    # helpers\n    def segments_in_row(r: int) -> list[tuple[int, int]]:\n        segs: list[tuple[int, int]] = []\n        c = 0\n        while c < W:\n            if int(out[r, c]) != int(bg):\n                c += 1; continue\n            c0 = c\n            while c + 1 < W and int(out[r, c + 1]) == int(bg):\n                c += 1\n            segs.append((c0, c)); c += 1\n        return segs\n\n    def find_seg(segs: list[tuple[int, int]], c: int) -> tuple[int, int] | None:\n        for a, b in segs:\n            if a <= c <= b: return (a, b)\n        return None\n\n    def seg_exit(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single exit column, or None. Assert if >1 exit.\"\"\"\n        a, b = seg\n        if r + 2 >= H: return None\n        drops = [c for c in range(a, b + 1)\n                 if int(out[r + 1, c]) == int(bg) and int(out[r + 2, c]) == int(bg)]\n        assert len(drops) <= 1, f\"segment ({a},{b}) at row {r} has {len(drops)} exits: {drops}\"\n        return drops[0] if drops else None\n\n    def entry_from_above(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single entry column from the wall above, or None. Assert if >1.\"\"\"\n        a, b = seg\n        if r < 2: return None\n        entries = [c for c in range(a, b + 1)\n                   if int(out[r - 1, c]) == int(bg) and int(out[r - 2, c]) == int(bg)]\n        assert len(entries) <= 1, f\"segment ({a},{b}) at row {r} has {len(entries)} entries from above: {entries}\"\n        return entries[0] if entries else None\n\n    # Remove tokens; simulate; re-place.\n    token_pts = [(int(r), int(c)) for r, c in np.argwhere(out == int(token))]\n    out[out == int(token)] = int(bg)\n\n    # Phase 1: each token drops through single exits until stuck.\n    finals: list[tuple[int, int]] = []  # (row, col) of final position\n    for r, c in token_pts:\n        cur_r, cur_c = r, c\n        if int(out[cur_r, cur_c]) != int(bg):\n            finals.append((cur_r, cur_c)); continue\n        while True:\n            seg = find_seg(segments_in_row(cur_r), cur_c)\n            if seg is None: break\n            ex = seg_exit(cur_r, seg)\n            if ex is None: break\n            cur_r += 2; cur_c = ex\n            if cur_r >= H: break\n        finals.append((cur_r, cur_c))\n\n    # Phase 2: pack tokens at opposite end from entry.\n    buckets: dict[tuple[int, tuple[int, int], int], int] = defaultdict(int)\n    for r, c in finals:\n        segs = segments_in_row(r)\n        seg = find_seg(segs, c)\n        if seg is None: continue\n        a, b = seg\n        entry = entry_from_above(r, seg)\n        if entry is not None:\n            # Pack to opposite end from entry\n            pack_end = b if (entry - a) <= (b - entry) else a\n        else:\n            # No entry from above: token at starting position (grid edge), stay put\n            pack_end = a if c <= a else b\n        buckets[(r, seg, pack_end)] += 1\n\n    for (r, (a, b), pack_end), k in buckets.items():\n        if pack_end == a:\n            for i in range(k):\n                if a + i <= b: out[r, a + i] = int(token)\n        else:\n            for i in range(k):\n                if b - i >= a: out[r, b - i] = int(token)\n\n    return out\n\n# --------------- generator (Codex, output-first with spine) ---------------\n\nWALL = 0\nTOKEN = 3\nOPEN = 6\nGATE = 7\nBG = 8\n\n\ndef _build_opened_grid(gates: list[list[int]], holes: list[list[int]], width: int) -> np.ndarray:\n    n_walls = len(gates)\n    height = 2 * n_walls + 1\n    grid = np.full((height, width), WALL, dtype=int)\n\n    for pipe_idx in range(n_walls + 1):\n        r = 2 * pipe_idx\n        grid[r, :] = BG\n        for c in holes[pipe_idx]:\n            grid[r, c] = WALL\n\n    for wall_idx, centers in enumerate(gates):\n        r = 2 * wall_idx + 1\n        for c in centers:\n            grid[r, c - 1] = BG\n            grid[r, c] = OPEN\n            grid[r, c + 1] = BG\n            grid[r - 1, c] = OPEN\n            grid[r + 1, c] = OPEN\n\n    return grid\n\n\ndef _build_input(gates: list[list[int]], holes: list[list[int]], width: int) -> np.ndarray:\n    n_walls = len(gates)\n    height = 2 * n_walls + 1\n    grid = np.full((height, width), WALL, dtype=int)\n    gate_patch = np.full((1, 3), GATE, dtype=int)\n\n    for pipe_idx in range(n_walls + 1):\n        r = 2 * pipe_idx\n        grid[r, :] = BG\n        for c in holes[pipe_idx]:\n            grid[r, c] = WALL\n\n    for wall_idx, centers in enumerate(gates):\n        r = 2 * wall_idx + 1\n        for c in centers:\n            paste(grid, gate_patch, r, c - 1)\n\n    for pipe_idx in range(n_walls):\n        r = 2 * pipe_idx\n        grid[r, 0] = TOKEN\n        grid[r, width - 1] = TOKEN\n\n    return grid\n\n\ndef _segments_in_row(grid: np.ndarray, r: int) -> list[tuple[int, int]]:\n    width = grid.shape[1]\n    segments: list[tuple[int, int]] = []\n    c = 0\n    while c < width:\n        if grid[r, c] != BG:\n            c += 1\n            continue\n        start = c\n        while c + 1 < width and grid[r, c + 1] == BG:\n            c += 1\n        segments.append((start, c))\n        c += 1\n    return segments\n\n\ndef _find_segment(grid: np.ndarray, r: int, c: int) -> tuple[int, int] | None:\n    for seg in _segments_in_row(grid, r):\n        if seg[0] <= c <= seg[1]:\n            return seg\n    return None\n\n\ndef _exits_below(grid: np.ndarray, r: int, seg: tuple[int, int]) -> list[int]:\n    height = grid.shape[0]\n    if r + 2 >= height:\n        return []\n    a, b = seg\n    return [c for c in range(a, b + 1) if grid[r + 1, c] == BG and grid[r + 2, c] == BG]\n\n\ndef _entries_above(grid: np.ndarray, r: int, seg: tuple[int, int]) -> list[int]:\n    if r < 2:\n        return []\n    a, b = seg\n    return [c for c in range(a, b + 1) if grid[r - 1, c] == BG and grid[r - 2, c] == BG]\n\n\ndef _find_issues(grid: np.ndarray) -> list[tuple[int, tuple[int, int], list[int], list[int]]]:\n    height = grid.shape[0]\n    issues: list[tuple[int, tuple[int, int], list[int], list[int]]] = []\n    for r in range(0, height, 2):\n        for seg in _segments_in_row(grid, r):\n            above = _entries_above(grid, r, seg)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/e729b7be.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/e729b7be.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the scene by adding the point-reflected copy of the colored object across the central marker.\n\n    Input structure\n    - The grid has odd dimensions, a dominant background, and a center-row marker color appearing only at the left edge, center, and right edge.\n    - A single divider color fills the center column except for the center marker.\n    - All remaining foreground pixels form the object to copy, entirely on the left side of the divider.\n    Rule\n    - Keep the input unchanged.\n    - For every object pixel, paint the pixel rotated 180 degrees around the center marker with the same color.\n    Key insight\n    - The center marker is the rotation center; the yellow-looking divider is not mirrored, it only separates the source from the empty target side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h % 2 == 1 and w % 2 == 1\n\n    cr, cc = h // 2, w // 2\n    bg = int(get_bg(g))\n\n    marker_color = int(g[cr, cc])\n    assert marker_color != bg\n    marker_mask = g == marker_color\n    expected_markers = np.zeros(g.shape, dtype=bool)\n    expected_markers[cr, 0] = True\n    expected_markers[cr, cc] = True\n    expected_markers[cr, w - 1] = True\n    assert np.array_equal(marker_mask, expected_markers)\n\n    center_col = g[:, cc]\n    divider_colors = {int(color) for color in np.unique(center_col) if int(color) != marker_color}\n    assert len(divider_colors) == 1\n    divider_color = next(iter(divider_colors))\n    assert divider_color != bg\n    expected_divider = np.zeros(g.shape, dtype=bool)\n    expected_divider[:, cc] = True\n    expected_divider[cr, cc] = False\n    assert np.array_equal(g == divider_color, expected_divider)\n\n    source_mask = (g != bg) & (g != marker_color) & (g != divider_color)\n    source_coords = np.argwhere(source_mask)\n    assert source_coords.size > 0\n    assert np.all(source_coords[:, 1] < cc)\n\n    out = g.copy()\n    for r, c in source_coords:\n        rr = 2 * cr - int(r)\n        rc = 2 * cc - int(c)\n        assert 0 <= rr < h and 0 <= rc < w\n        assert out[rr, rc] == bg\n        out[rr, rc] = g[r, c]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Colors and canvas bounds.\nBG_COLOR, DIVIDER_COLOR, MARKER_COLOR = 7, 4, 8\nGRID_SIZES, MIN_EMPTY_BORDER_ROWS = (15, 17, 19), 1\n\n# Convex source shape bounds.\nSOURCE_SPAN_RANGE = (10, 15)\nSOURCE_MAX_WIDTH_RANGE = (5, 7)\nSOURCE_EDGE_WIDTH_RANGE = (1, 3)\nWIDTH_STEP_CAP, SOURCE_PIXEL_RANGE = 2, (35, 83)\n\n# Color palette, band orders, and retry budget.\nSOURCE_COLORS = (0, 1, 2, 3, 5, 6, 9)\nSOURCE_COLOR_COUNT_RANGE, GEN_ATTEMPTS = (3, 7), 300\nCOLORING_KEYS = (\n    lambda item: (item[2], item[3], item[1]),\n    lambda item: (item[3], item[2], item[1]),\n    lambda item: (item[2] + item[3], item[2], item[1]),\n    lambda item: (item[2] - item[3], item[2], item[1]),\n)\n\n\ndef _gen_bounded_steps(total, slots, cap):\n    steps = []\n    remaining = total\n    for i in range(slots):\n        left = slots - i - 1\n        lo = max(0, remaining - cap * left)\n        hi = min(cap, remaining)\n        step = random.randint(lo, hi)\n        steps.append(step)\n        remaining -= step\n    return steps\n\n\ndef _gen_width_profile(span, max_width):\n    edge_width_hi = min(SOURCE_EDGE_WIDTH_RANGE[1], max_width)\n    start_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n    end_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n    min_up = (max_width - start_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n    min_down = (max_width - end_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n    if min_up + min_down + 1 > span:\n        return None\n\n    peak_start = random.randint(min_up, span - 1 - min_down)\n    peak_end = random.randint(peak_start, span - 1 - min_down)\n\n    widths = [start_width]\n    for step in _gen_bounded_steps(max_width - start_width, peak_start, WIDTH_STEP_CAP):\n        widths.append(widths[-1] + step)\n\n    widths.extend([max_width] * (peak_end - peak_start))\n\n    current = max_width\n    for step in _gen_bounded_steps(max_width - end_width, span - 1 - peak_end, WIDTH_STEP_CAP):\n        current -= step\n        widths.append(current)\n\n    area = sum(widths)\n    if not SOURCE_PIXEL_RANGE[0] <= area <= SOURCE_PIXEL_RANGE[1]:\n        return None\n    return widths\n\n\ndef _choose_source_extent(n, cr):\n    valid_spans = [s for s in range(SOURCE_SPAN_RANGE[0], SOURCE_SPAN_RANGE[1] + 1) if s <= n - 2 * MIN_EMPTY_BORDER_ROWS]\n    span = random.choice(valid_spans)\n    r0_min = max(MIN_EMPTY_BORDER_ROWS, cr - span + 1)\n    r0_max = min(cr, n - MIN_EMPTY_BORDER_ROWS - span)\n    r0 = random.randint(r0_min, r0_max)\n    return span, r0, cr - r0\n\n\ndef _paint_source_cells(out, r0, widths, outer, cc):\n    interior = []\n    source = []\n    for i, width in enumerate(widths):\n        r = r0 + i\n        c0 = cc - width\n        for j in range(width):\n            c = c0 + j\n            source.append((r, c))\n            if j == 0:\n                out[r, c] = outer\n            else:\n                interior.append((r, c, i, j))\n    return source, interior\n\n\ndef _gen_color_source(out, r0, widths, colors, cc):\n    outer = colors[0]\n    inner = colors[1:]\n    source, interior = _paint_source_cells(out, r0, widths, outer, cc)\n    if len(interior) < len(inner):\n        return None\n\n    key = COLORING_KEYS[random.randrange(len(COLORING_KEYS))]\n    interior.sort(key=key)\n    band_count = len(inner)\n    for rank, (r, c, _, _) in enumerate(interior):\n        out[r, c] = inner[min(band_count - 1, rank * band_count // len(interior))]\n\n    return source\n\n\ndef _reflect_source(out, source, cr, cc):\n    reflected = []\n    for r, c in source:\n        rr = 2 * cr - r\n        rc = 2 * cc - c\n        if out[rr, rc] != BG_COLOR:\n            return None\n        out[rr, rc] = out[r, c]\n        reflected.append((rr, rc))\n    return reflected\n\n\ndef _gen_attempt():\n    n = random.choice(GRID_SIZES)\n    cr = cc = n // 2\n    out = np.full((n, n), BG_COLOR, dtype=int)\n    out[:, cc] = DIVIDER_COLOR\n    out[cr, [0, cc, n - 1]] = MARKER_COLOR\n\n    span, r0, center_i = _choose_source_extent(n, cr)\n    max_width = random.randint(*SOURCE_MAX_WIDTH_RANGE)\n    widths = _gen_width_profile(span, max_width)\n    if widths is None:\n        return None\n    if widths[center_i] >= cc:\n        return None\n\n    color_count = random.randint(*SOURCE_COLOR_COUNT_RANGE)\n    colors = random.sample(SOURCE_COLORS, color_count)\n    source = _gen_color_source(out, r0, widths, colors, cc)\n    if source is None:\n        return None\n\n    reflected = _reflect_source(out, source, cr, cc)\n    if reflected is None:\n        return None\n\n    inp = out.copy()\n    for r, c in reflected:\n        inp[r, c] = BG_COLOR\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input():\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid e729b7be input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/11dc524f.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/11dc524f.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste\nimport itertools\nimport random\n\n\ndef _intervals_overlap(a0: int, a1: int, b0: int, b1: int) -> bool:\n    return max(int(a0), int(b0)) <= min(int(a1), int(b1))\n\n\ndef _is_solid_2x2(comp: dict, g: np.ndarray) -> bool:\n    r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n    return (\n        int(comp[\"area\"]) == 4\n        and int(r1 - r0 + 1) == 2\n        and int(c1 - c0 + 1) == 2\n        and bool((g[r0 : r1 + 1, c0 : c1 + 1] == int(comp[\"color\"])).all())\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide the non-square sprite to the square anchor and replace the anchor with the sprite's mirror image.\n\n    Input structure:\n    - The background is the most common color.\n    - There is one 8-connected non-background sprite that is not a solid 2x2 square.\n    - There is one solid 2x2 square anchor in another non-background color.\n\n    Rule:\n    - Move the sprite straight toward the anchor along their unique cardinal separation until it touches the anchor's near edge.\n    - Reflect the moved sprite across that near edge and draw the reflected copy in the anchor color.\n    - Clear the original locations; the output keeps only the moved sprite and reflected anchor-color copy.\n\n    Key insight:\n    - The 2x2 square marks the mirror line: its side facing the sprite becomes the contact edge for a two-color reflected pair.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = map(int, g.shape)\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert len(comps) == 2\n\n    anchors = [comp for comp in comps if _is_solid_2x2(comp, g)]\n    assert len(anchors) == 1\n    anchor = anchors[0]\n\n    sprites = [comp for comp in comps if comp is not anchor]\n    assert len(sprites) == 1\n    sprite = sprites[0]\n    assert int(sprite[\"color\"]) != int(anchor[\"color\"])\n\n    sr0, sc0, sr1, sc1 = map(int, sprite[\"bbox\"])\n    ar0, ac0, ar1, ac1 = map(int, anchor[\"bbox\"])\n\n    candidates: list[tuple[str, int, int]] = []\n    if sc1 < ac0 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"left\", 0, ac0 - sc1 - 1))\n    if sc0 > ac1 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"right\", 0, ac1 + 1 - sc0))\n    if sr1 < ar0 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"above\", ar0 - sr1 - 1, 0))\n    if sr0 > ar1 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"below\", ar1 + 1 - sr0, 0))\n    assert len(candidates) == 1\n\n    side, dr, dc = candidates[0]\n    moved: list[tuple[int, int]] = []\n    mirrored: list[tuple[int, int]] = []\n    for r, c in sprite[\"coords\"]:\n        rr = int(r) + int(dr)\n        cc = int(c) + int(dc)\n        moved.append((rr, cc))\n        if side == \"left\":\n            mirrored.append((rr, 2 * ac0 - 1 - cc))\n        elif side == \"right\":\n            mirrored.append((rr, 2 * ac1 + 1 - cc))\n        elif side == \"above\":\n            mirrored.append((2 * ar0 - 1 - rr, cc))\n        else:\n            mirrored.append((2 * ar1 + 1 - rr, cc))\n\n    assert all(0 <= r < H and 0 <= c < W for r, c in moved)\n    assert all(0 <= r < H and 0 <= c < W for r, c in mirrored)\n    assert not (set(moved) & set(mirrored))\n\n    out = np.full_like(g, bg)\n    for r, c in moved:\n        out[r, c] = int(sprite[\"color\"])\n    for r, c in mirrored:\n        out[r, c] = int(anchor[\"color\"])\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import is_contiguous\n\n# ── Config ──────────────────────────────────────────────────────────────\nGRID_MIN, GRID_MAX = 10, 20        # canvas size range (rows and cols)\nSPRITE_AREA = 4                     # number of filled cells per sprite\nSPRITE_BBOX_SHAPES = [(2, 3), (3, 2), (3, 3)]  # allowed sprite bbox dims\nGAP_MIN, GAP_MAX = 2, 4            # empty-cell gap between sprite and anchor\nANCHOR_SIZE = 2                     # anchor is always a 2x2 solid square\nNUM_COLORS = 10                     # ARC color palette size\nSIDES = [\"left\", \"right\", \"above\", \"below\"]\nRETRY_LIMIT = 300                   # max attempts before raising\n\n\ndef _has_full_bbox(mask: np.ndarray) -> bool:\n    \"\"\"True if mask has at least one filled cell on each edge of its bounding box.\"\"\"\n    return (mask[0].any() and mask[-1].any() and\n            mask[:, 0].any() and mask[:, -1].any())\n\n\ndef _sprite_masks(axis: str) -> list[np.ndarray]:\n    \"\"\"Enumerate all valid 4-cell sprite masks for a given mirror axis.\n\n    A valid mask is 8-connected, spans its full bbox, and is NOT symmetric\n    along the given axis (lr or ud).\n    \"\"\"\n    flip = np.fliplr if axis == \"lr\" else np.flipud\n    out = []\n    for h, w in SPRITE_BBOX_SHAPES:\n        for cells in itertools.combinations(range(h * w), SPRITE_AREA):\n            mask = np.zeros((h, w), dtype=bool)\n            for cell in cells:\n                mask[cell // w, cell % w] = True\n            if not _has_full_bbox(mask):\n                continue\n            if not is_contiguous(mask, connectivity=8):\n                continue\n            if np.array_equal(mask, flip(mask)):\n                continue\n            out.append(mask)\n    return out\n\n\n_MASKS = {\"lr\": _sprite_masks(\"lr\"), \"ud\": _sprite_masks(\"ud\")}\n\n\ndef _paint_mask(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int,\n                color: int, bg: int) -> None:\n    \"\"\"Stamp a boolean mask onto grid at (r0, c0) using the given color.\"\"\"\n    patch = np.full(mask.shape, bg, dtype=int)\n    patch[mask] = color\n    paste(grid, patch, r0, c0, transparent=bg)\n\n\ndef _rand_pair_origin(H: int, W: int, h: int, w: int, side: str,\n                      gap: int) -> tuple[int, int] | None:\n    \"\"\"Pick a random origin for the touching sprite+mirror pair.\n\n    Returns (row, col) of the output pair's top-left corner, or None if the\n    pair cannot fit on the grid with enough room for the input-side gap.\n    \"\"\"\n    if side in {\"left\", \"right\"}:\n        r_lo, r_hi = 0, H - h\n        total_w = 2 * w + (gap if side == \"right\" else 0)\n        c_lo = gap if side == \"left\" else 0\n        c_hi = W - total_w if side == \"right\" else W - 2 * w\n    else:\n        c_lo, c_hi = 0, W - w\n        total_h = 2 * h + (gap if side == \"below\" else 0)\n        r_lo = gap if side == \"above\" else 0\n        r_hi = H - total_h if side == \"below\" else H - 2 * h\n    if r_lo > r_hi or c_lo > c_hi:\n        return None\n    return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)\n\n\ndef _layout_for_side(side: str, pr: int, pc: int, h: int, w: int,\n                     gap: int, sprite: np.ndarray):\n    \"\"\"Compute output and input placement params for a given side.\n\n    Returns (sprite_r, sprite_c, mirror_r, mirror_c, flipped_sprite,\n             anchor_r, anchor_c, input_r, input_c).\n    \"\"\"\n    flip = np.fliplr if side in {\"left\", \"right\"} else np.flipud\n    flipped = flip(sprite)\n\n    if side == \"left\":\n        sr, sc = pr, pc                     # sprite at pair origin\n        mr, mc = sr, sc + w                  # mirror right of sprite\n        anchor_r = random.randint(sr, sr + h - ANCHOR_SIZE)\n        anchor_c = sc + w\n        input_r, input_c = sr, sc - gap\n    elif side == \"right\":\n        sr, sc = pr, pc + w                  # sprite right half\n        mr, mc = pr, pc                      # mirror left half\n        anchor_r = random.randint(sr, sr + h - ANCHOR_SIZE)\n        anchor_c = sc - ANCHOR_SIZE\n        input_r, input_c = sr, sc + gap\n    elif side == \"above\":\n        sr, sc = pr, pc                      # sprite at top\n        mr, mc = sr + h, sc                  # mirror below\n        anchor_r = sr + h\n        anchor_c = random.randint(sc, sc + w - ANCHOR_SIZE)\n        input_r, input_c = sr - gap, sc\n    else:  # below\n        sr, sc = pr + h, pc                  # sprite at bottom\n        mr, mc = pr, pc                      # mirror above\n        anchor_r = sr - ANCHOR_SIZE\n        anchor_c = random.randint(sc, sc + w - ANCHOR_SIZE)\n        input_r, input_c = sr + gap, sc\n\n    return sr, sc, mr, mc, flipped, anchor_r, anchor_c, input_r, input_c\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Try to build one valid (input, output) pair; return input or None.\"\"\"\n    H = random.randint(GRID_MIN, GRID_MAX)\n    W = random.randint(GRID_MIN, GRID_MAX)\n    bg = random.randrange(NUM_COLORS)\n    sprite_color, anchor_color = random.sample(\n        [c for c in range(NUM_COLORS) if c != bg], 2)\n\n    side = random.choice(SIDES)\n    axis = \"lr\" if side in {\"left\", \"right\"} else \"ud\"\n    sprite = random.choice(_MASKS[axis]).copy()\n    h, w = map(int, sprite.shape)\n    gap = random.randint(GAP_MIN, GAP_MAX)\n\n    origin = _rand_pair_origin(H, W, h, w, side, gap)\n    if origin is None:\n        return None\n    pr, pc = origin\n\n    (sr, sc, mr, mc, flipped,\n     anchor_r, anchor_c, input_r, input_c) = _layout_for_side(\n        side, pr, pc, h, w, gap, sprite)\n\n    # Build expected output\n    out = np.full((H, W), bg, dtype=int)\n    _paint_mask(out, sprite, sr, sc, sprite_color, bg)\n    _paint_mask(out, flipped, mr, mc, anchor_color, bg)\n\n    # Build input\n    inp = np.full((H, W), bg, dtype=int)\n    _paint_mask(inp, sprite, input_r, input_c, sprite_color, bg)\n    paste(inp, np.full((ANCHOR_SIZE, ANCHOR_SIZE), anchor_color, dtype=int),\n          anchor_r, anchor_c)\n\n    # Oracle validation\n    comps = find_components(inp, bg=bg, connectivity=8, monochromatic=True)\n    if len(comps) != 2:\n        return None\n    try:\n        solved = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(solved, out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
