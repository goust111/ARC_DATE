{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/f18ec8cc.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\nimport itertools\nimport random\n\n\nBlock = tuple[int, int, int]  # c0, c1_exclusive, dominant color\n\n\ndef _unique_mode(values: np.ndarray) -> int:\n    counts = Counter(map(int, values.reshape(-1)))\n    ranked = counts.most_common()\n    assert ranked, \"expected a nonempty sequence\"\n    assert len(ranked) == 1 or ranked[0][1] > ranked[1][1], \"expected a unique dominant color\"\n    return int(ranked[0][0])\n\n\ndef _vertical_blocks(g: np.ndarray) -> list[Block]:\n    height, width = map(int, g.shape)\n    assert height > 0 and width > 0, \"expected a nonempty grid\"\n\n    column_colors = [_unique_mode(g[:, c]) for c in range(width)]\n    blocks: list[Block] = []\n    start = 0\n    current = column_colors[0]\n    for col, color in enumerate(column_colors[1:], start=1):\n        if color != current:\n            blocks.append((start, col, current))\n            start = col\n            current = color\n    blocks.append((start, width, current))\n\n    assert len(blocks) >= 3, \"expected at least three vertical color blocks\"\n    base_colors = [color for _, _, color in blocks]\n    assert len(set(base_colors)) == len(base_colors), \"block colors must be unique\"\n    return blocks\n\n\ndef _common_marker_rows(g: np.ndarray, blocks: list[Block]) -> list[tuple[int, int]]:\n    base_colors = {color for _, _, color in blocks}\n    rows: list[tuple[int, int]] = []\n    for r in range(g.shape[0]):\n        shared = base_colors.copy()\n        for c0, c1, _ in blocks:\n            shared &= set(map(int, g[r, c0:c1]))\n        if shared:\n            assert len(shared) == 1, \"expected each marker row to name one block color\"\n            rows.append((r, shared.pop()))\n    return rows\n\n\ndef _block_order(g: np.ndarray, blocks: list[Block]) -> list[int]:\n    block_count = len(blocks)\n    base_colors = [color for _, _, color in blocks]\n    marker_rows = _common_marker_rows(g, blocks)\n\n    if len(marker_rows) == block_count:\n        assert len({color for _, color in marker_rows}) == block_count, \"marker rows must name unique blocks\"\n        row_numbers = [row for row, _ in marker_rows]\n        marker_colors = [color for _, color in sorted(marker_rows)]\n        if max(row_numbers) - min(row_numbers) + 1 == block_count and marker_colors == list(reversed(base_colors)):\n            return list(reversed(range(block_count)))\n    else:\n        assert len(marker_rows) in (0, 1), \"incomplete marker rows should be absent or unique\"\n\n    return list(range(1, block_count)) + [0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reorder the vertical color-major blocks while preserving every block's internal pixels.\n\n    Input structure\n    The grid is divided into vertical blocks, each with a unique dominant color.\n    Small marker pixels from other block colors may appear inside the blocks.\n\n    Rule\n    If adjacent shared-color marker rows read exactly as the current block order\n    from right to left, reverse the blocks. Otherwise move the leftmost block to\n    the far right and shift the remaining blocks left.\n\n    Key insight\n    The transformation acts on whole vertical blocks, so marker pixels move with\n    their source block instead of being recolored or independently rearranged.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    blocks = _vertical_blocks(g)\n    order = _block_order(g, blocks)\n    assert sorted(order) == list(range(len(blocks))), \"block order must be a permutation\"\n\n    return np.concatenate([g[:, blocks[i][0] : blocks[i][1]] for i in order], axis=1)\n\n# --------------- generator (o5x) ---------------\n# Canvas, block, and color bounds.\nGEN_HEIGHT_RANGE = (7, 9)\nGEN_TOTAL_WIDTH_RANGE = (10, 15)\nGEN_BLOCK_COUNT_CHOICES = [3, 4]\nGEN_BLOCK_WIDTH_RANGE = (3, 7)\nGEN_COLOR_POOL = range(1, 10)\n\n# Marker-layout probabilities and row-sharing limits.\nGEN_REVERSE_PROB = 0.35\nGEN_ALIGNED_LEFT_SHIFT_PROB = 0.7\nGEN_NONCONSECUTIVE_LEFT_SHIFT_PROB = 0.5\nGEN_COMMON_COLOR_COUNT_RANGE = (0, 1)\n\n# Rejection-sampling retry limit.\nGEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_bounds(widths):\n    starts = [0, *itertools.accumulate(widths[:-1])]\n    return [(c0, c0 + width) for c0, width in zip(starts, widths)]\n\n\ndef _gen_expected(grid, widths, order):\n    bounds = _gen_bounds(widths)\n    return np.concatenate([grid[:, bounds[i][0] : bounds[i][1]] for i in order], axis=1)\n\n\ndef _gen_pick_widths(block_count):\n    min_width, max_width = GEN_BLOCK_WIDTH_RANGE\n    total = random.randint(\n        max(GEN_TOTAL_WIDTH_RANGE[0], min_width * block_count),\n        min(GEN_TOTAL_WIDTH_RANGE[1], max_width * block_count),\n    )\n    options = [\n        widths\n        for widths in itertools.product(range(min_width, max_width + 1), repeat=block_count)\n        if sum(widths) == total\n    ]\n    return list(random.choice(options))\n\n\ndef _gen_marker_col(c0, c1):\n    return random.randint(c0 + 1, c1 - 2)\n\n\ndef _gen_place_aligned(grid, widths, colors, color_rows):\n    bounds = _gen_bounds(widths)\n    for block_i, (c0, c1) in enumerate(bounds):\n        base = colors[block_i]\n        for color in colors:\n            if color != base:\n                grid[color_rows[color], _gen_marker_col(c0, c1)] = color\n\n\ndef _gen_nonconsecutive_rows(height, block_count):\n    options = [\n        rows\n        for rows in itertools.combinations(range(height), block_count)\n        if rows[-1] - rows[0] + 1 != block_count\n    ]\n    return list(random.choice(options))\n\n\ndef _gen_place_unaligned_left_shift(grid, widths, colors):\n    height = grid.shape[0]\n    bounds = _gen_bounds(widths)\n    common_colors = random.sample(colors, random.randint(*GEN_COMMON_COLOR_COUNT_RANGE))\n    row_by_common = {color: random.randrange(height) for color in common_colors}\n\n    assignments = []\n    for block_i, _ in enumerate(bounds):\n        base = colors[block_i]\n        used = set()\n        by_color = {}\n        for color in common_colors:\n            if color != base:\n                row = row_by_common[color]\n                used.add(row)\n                by_color[color] = row\n        foreign = [color for color in colors if color != base and color not in common_colors]\n        rows = random.sample([r for r in range(height) if r not in used], len(foreign))\n        for color, row in zip(foreign, rows):\n            by_color[color] = row\n        assignments.append(by_color)\n\n    for color in colors:\n        if color in common_colors:\n            continue\n        block_ids = [i for i, base in enumerate(colors) if base != color]\n        if len({assignments[i][color] for i in block_ids}) == 1:\n            block_i = random.choice(block_ids)\n            used = set(assignments[block_i].values())\n            old_row = assignments[block_i][color]\n            choices = [r for r in range(height) if r not in used and r != old_row]\n            assignments[block_i][color] = random.choice(choices)\n\n    for block_i, (c0, c1) in enumerate(bounds):\n        for color, row in assignments[block_i].items():\n            grid[row, _gen_marker_col(c0, c1)] = color\n\n\ndef _gen_base_grid():\n    height = random.randint(*GEN_HEIGHT_RANGE)\n    block_count = random.choice(GEN_BLOCK_COUNT_CHOICES)\n    colors = random.sample(GEN_COLOR_POOL, block_count)\n    widths = _gen_pick_widths(block_count)\n    grid = np.zeros((height, sum(widths)), dtype=int)\n    for color, (c0, c1) in zip(colors, _gen_bounds(widths)):\n        grid[:, c0:c1] = color\n    return grid, widths, colors\n\n\ndef _gen_place_reverse_markers(grid, widths, colors):\n    block_count = len(colors)\n    start = random.randint(0, grid.shape[0] - block_count)\n    rows = list(range(start, start + block_count))\n    color_rows = {color: row for color, row in zip(reversed(colors), rows)}\n    _gen_place_aligned(grid, widths, colors, color_rows)\n    return list(reversed(range(block_count)))\n\n\ndef _gen_place_left_shift_markers(grid, widths, colors):\n    if random.random() < GEN_ALIGNED_LEFT_SHIFT_PROB:\n        block_count = len(colors)\n        if random.random() < GEN_NONCONSECUTIVE_LEFT_SHIFT_PROB:\n            rows = _gen_nonconsecutive_rows(grid.shape[0], block_count)\n            ordered_colors = random.sample(colors, block_count)\n        else:\n            start = random.randint(0, grid.shape[0] - block_count)\n            rows = list(range(start, start + block_count))\n            ordered_colors = list(reversed(colors))\n            swap_i = random.randrange(block_count - 1)\n            ordered_colors[swap_i : swap_i + 2] = reversed(ordered_colors[swap_i : swap_i + 2])\n        color_rows = {color: row for color, row in zip(ordered_colors, rows)}\n        _gen_place_aligned(grid, widths, colors, color_rows)\n    else:\n        _gen_place_unaligned_left_shift(grid, widths, colors)\n    return list(range(1, len(colors))) + [0]\n\n\ndef _gen_place_markers(grid, widths, colors):\n    if random.random() < GEN_REVERSE_PROB:\n        return _gen_place_reverse_markers(grid, widths, colors)\n    return _gen_place_left_shift_markers(grid, widths, colors)\n\n\ndef _gen_attempt():\n    grid, widths, colors = _gen_base_grid()\n    order = _gen_place_markers(grid, widths, colors)\n    expected = _gen_expected(grid, widths, order)\n    return grid if np.array_equal(main(grid), expected) else None\n\n\ndef generate_input():\n    for _ in range(GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid f18ec8cc input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/ba1aa698.py\"","aggregated_output":"import math\nfrom collections import Counter\nfrom fractions import Fraction, Fraction as _gen_Fraction\n\nimport numpy as np\n\nfrom arc_utils import bbox, is_contiguous, paste\nimport itertools as _gen_itertools\nimport math as _gen_math\nimport random as _gen_random\n\n\ndef _unique_most_common(values) -> int:\n    counts = Counter(map(int, values))\n    ranked = counts.most_common()\n    assert ranked and (len(ranked) == 1 or ranked[0][1] > ranked[1][1])\n    return int(ranked[0][0])\n\n\ndef _round_half_up(value: Fraction) -> int:\n    return math.floor(value + Fraction(1, 2))\n\n\ndef _extract_sprite(panel: np.ndarray, fill: int) -> tuple[np.ndarray, np.ndarray, int, int]:\n    interior_mask = panel[1:-1, 1:-1] != fill\n    box = bbox(interior_mask)\n    assert box is not None\n    r0, local_c0, r1, local_c1 = box\n    r0 += 1\n    r1 += 1\n    local_c0 += 1\n    local_c1 += 1\n\n    sprite = panel[r0 : r1 + 1, local_c0 : local_c1 + 1].copy()\n    sprite_mask = sprite != fill\n    assert np.count_nonzero(sprite_mask) == np.count_nonzero(interior_mask)\n    return sprite, sprite_mask, int(r0), int(local_c0)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Extrapolate the moving sprite from a horizontal sequence of shared-border frames into the next standalone frame.\n\n    Input structure\n    - The grid is a row of equal-width framed panels sharing their vertical border columns.\n    - Each panel has the same fill color and one identical interior sprite at the same local columns.\n    - The sprite's top row changes by a constant amount from panel to panel.\n\n    Rule\n    - Build one output panel with the same height, frame color, fill color, and sprite.\n    - Continue the sprite's diagonal motion one more panel to the right.\n    - Because the output is a standalone panel, advance by the full panel width, not the shared-border spacing.\n\n    Key insight\n    - The panels are consecutive frames of motion; the output is the next frame after the sequence.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    frame = int(g[0, 0])\n    assert h >= 3 and w >= 3\n    assert np.all(g[0, :] == frame)\n    assert np.all(g[-1, :] == frame)\n\n    separators = [c for c in range(w) if np.all(g[:, c] == frame)]\n    assert len(separators) >= 3\n    assert separators[0] == 0 and separators[-1] == w - 1\n    strides = [b - a for a, b in zip(separators, separators[1:])]\n    assert len(set(strides)) == 1\n    stride = strides[0]\n    panel_w = stride + 1\n\n    interior_values = []\n    for c0, c1 in zip(separators, separators[1:]):\n        interior_values.extend(g[1:-1, c0 + 1 : c1].ravel())\n    fill = _unique_most_common(interior_values)\n\n    panels = []\n    for c0, c1 in zip(separators, separators[1:]):\n        panel = g[:, c0 : c1 + 1]\n        assert panel.shape == (h, panel_w)\n        assert np.all(panel[0, :] == frame)\n        assert np.all(panel[-1, :] == frame)\n        assert np.all(panel[:, 0] == frame)\n        assert np.all(panel[:, -1] == frame)\n        panels.append(panel)\n\n    template_sprite, template_mask, first_top, template_left = _extract_sprite(panels[0], fill)\n    top_rows = [first_top]\n    for panel in panels[1:]:\n        sprite, sprite_mask, top, local_c0 = _extract_sprite(panel, fill)\n        assert local_c0 == template_left\n        assert sprite_mask.shape == template_mask.shape\n        assert np.array_equal(sprite_mask, template_mask)\n        assert np.array_equal(sprite[sprite_mask], template_sprite[template_mask])\n        top_rows.append(top)\n\n    deltas = [b - a for a, b in zip(top_rows, top_rows[1:])]\n    assert len(deltas) >= 1 and len(set(deltas)) == 1\n    next_top = _round_half_up(\n        Fraction(top_rows[-1], 1) + Fraction(deltas[0] * panel_w, stride)\n    )\n\n    sprite_h, sprite_w = template_sprite.shape\n    assert 1 <= next_top and next_top + sprite_h <= h - 1\n    assert 1 <= template_left and template_left + sprite_w <= panel_w - 1\n\n    out = np.full((h, panel_w), fill, dtype=int)\n    out[0, :] = frame\n    out[-1, :] = frame\n    out[:, 0] = frame\n    out[:, -1] = frame\n\n    target = out[next_top : next_top + sprite_h, template_left : template_left + sprite_w]\n    target[template_mask] = template_sprite[template_mask]\n    return out\n\n# --------------- generator (att2) ---------------\n_GEN_HEIGHT, _GEN_LOCAL_LEFT = 16, 2\n_GEN_INTERIOR_WIDTHS, _GEN_PANEL_COUNTS = (4, 5), (3, 4)\n_GEN_COLORS = tuple(range(10))\n_GEN_SPRITE_USES_FRAME_PROB = 0.3\n_GEN_SPRITE_HEIGHTS, _GEN_SPRITE_WIDTHS = (1, 2), (2, 3)\n_GEN_MIN_SPRITE_PIXELS, _GEN_MAX_SPRITE_PIXELS = 2, 5\n_GEN_DELTAS = (-3, -2, -1, 1, 2, 3)\n_GEN_MAX_ATTEMPTS = 300\n_GEN_MASK_CACHE = {}\n\ndef _gen_round_half_up(value):\n    return _gen_math.floor(value + _gen_Fraction(1, 2))\n\ndef _gen_contiguous_masks(sprite_h, sprite_w):\n    key = (sprite_h, sprite_w)\n    if key in _GEN_MASK_CACHE:\n        return _GEN_MASK_CACHE[key]\n    cells = [(r, c) for r in range(sprite_h) for c in range(sprite_w)]\n    masks_by_count = {}\n    max_pixels = min(_GEN_MAX_SPRITE_PIXELS, sprite_h * sprite_w)\n    for pixel_count in range(_GEN_MIN_SPRITE_PIXELS, max_pixels + 1):\n        masks = []\n        for combo in _gen_itertools.combinations(cells, pixel_count):\n            rows = {r for r, _ in combo}\n            cols = {c for _, c in combo}\n            if len(rows) != sprite_h or len(cols) != sprite_w:\n                continue\n            mask = np.zeros((sprite_h, sprite_w), dtype=bool)\n            for r, c in combo:\n                mask[r, c] = True\n            if is_contiguous(mask.astype(int), background=0, connectivity=4):\n                masks.append(mask)\n        if masks:\n            masks_by_count[pixel_count] = masks\n    _GEN_MASK_CACHE[key] = masks_by_count\n    return masks_by_count\n\ndef _gen_sprite(fill, sprite_color):\n    sprite_h = _gen_random.choice(_GEN_SPRITE_HEIGHTS)\n    sprite_w = _gen_random.choice(_GEN_SPRITE_WIDTHS)\n    masks_by_count = _gen_contiguous_masks(sprite_h, sprite_w)\n\n    pixel_count = _gen_random.choice(sorted(masks_by_count))\n    mask = _gen_random.choice(masks_by_count[pixel_count])\n    sprite = np.full((sprite_h, sprite_w), fill, dtype=int)\n    sprite[mask] = sprite_color\n    return sprite, mask\n\ndef _gen_make_panel(height, panel_w, frame, fill, sprite, top_row, local_left):\n    panel = np.full((height, panel_w), fill, dtype=int)\n    panel[0, :] = frame\n    panel[-1, :] = frame\n    panel[:, 0] = frame\n    panel[:, -1] = frame\n    paste(panel, sprite, top_row, local_left, transparent=fill)\n    return panel\n\ndef _gen_choose_palette():\n    frame, fill = _gen_random.sample(_GEN_COLORS, 2)\n    if _gen_random.random() < _GEN_SPRITE_USES_FRAME_PROB:\n        sprite_color = frame\n    else:\n        sprite_color = _gen_random.choice(\n            [color for color in _GEN_COLORS if color not in (frame, fill)]\n        )\n    return frame, fill, sprite_color\n\ndef _gen_motion_choices(sprite_h, panel_w, num_panels):\n    max_top = _GEN_HEIGHT - 1 - sprite_h\n    stride = panel_w - 1\n    choices = []\n    for delta in _GEN_DELTAS:\n        for start in range(1, max_top + 1):\n            top_rows = [start + i * delta for i in range(num_panels)]\n            if not all(1 <= top <= max_top for top in top_rows):\n                continue\n            next_top = _gen_round_half_up(\n                _gen_Fraction(top_rows[-1], 1)\n                + _gen_Fraction(delta * panel_w, stride)\n            )\n            if 1 <= next_top <= max_top:\n                choices.append((delta, start, next_top))\n    return choices\n\ndef _gen_make_input(num_panels, stride, frame, fill, sprite, start_top, delta):\n    width = num_panels * stride + 1\n    inp = np.full((_GEN_HEIGHT, width), fill, dtype=int)\n    inp[0, :] = frame\n    inp[-1, :] = frame\n    for panel_i in range(num_panels + 1):\n        inp[:, panel_i * stride] = frame\n    for panel_i in range(num_panels):\n        top = start_top + panel_i * delta\n        paste(inp, sprite, top, panel_i * stride + _GEN_LOCAL_LEFT, transparent=fill)\n    return inp\n\ndef _gen_attempt():\n    interior_w = _gen_random.choice(_GEN_INTERIOR_WIDTHS)\n    num_panels = _gen_random.choice(_GEN_PANEL_COUNTS)\n    panel_w = interior_w + 2\n    stride = panel_w - 1\n    frame, fill, sprite_color = _gen_choose_palette()\n\n    sprite, _ = _gen_sprite(fill, sprite_color)\n    sprite_h, sprite_w = sprite.shape\n    if _GEN_LOCAL_LEFT + sprite_w > panel_w - 1:\n        return None\n\n    choices = _gen_motion_choices(sprite_h, panel_w, num_panels)\n    if not choices:\n        return None\n    delta, start_top, next_top = _gen_random.choice(choices)\n\n    expected = _gen_make_panel(\n        _GEN_HEIGHT, panel_w, frame, fill, sprite, next_top, _GEN_LOCAL_LEFT\n    )\n    inp = _gen_make_input(num_panels, stride, frame, fill, sprite, start_top, delta)\n    if np.array_equal(main(inp), expected):\n        return inp\n    return None\n\ndef generate_input():\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid ba1aa698 input\")\n","exit_code":0,"status":"completed"}}
