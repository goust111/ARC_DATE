{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/7e576d6e.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import components_mask, get_bg\nimport random\n\n\ndef _color_counts(g: np.ndarray) -> dict[int, int]:\n    vals, counts = np.unique(g, return_counts=True)\n    return {int(v): int(n) for v, n in zip(vals, counts)}\n\n\ndef _roles(g: np.ndarray) -> tuple[int, int, int, int]:\n    bg = get_bg(g)\n    counts = _color_counts(g)\n    colors = [c for c in counts if c != bg]\n    assert len(colors) == 3, \"expected wall, door, and marker colors\"\n\n    marker_colors = [c for c in colors if counts[c] == 2]\n    assert len(marker_colors) == 1, \"expected exactly two marker pixels\"\n    path_color = marker_colors[0]\n\n    remaining = [c for c in colors if c != path_color]\n    areas = {c: counts[c] for c in remaining}\n    door_area = min(areas.values())\n    wall_area = max(areas.values())\n    door_colors = [c for c in remaining if counts[c] == door_area]\n    wall_colors = [c for c in remaining if counts[c] == wall_area]\n    assert len(door_colors) == 1 and len(wall_colors) == 1\n    assert door_area < wall_area, \"door color must be the smaller non-marker object set\"\n    return int(bg), int(path_color), int(door_colors[0]), int(wall_colors[0])\n\n\ndef _door_centers(g: np.ndarray, door_color: int) -> tuple[str, list[tuple[int, int]]]:\n    comps = components_mask(g == int(door_color), connectivity=4)\n    assert comps, \"expected door segments\"\n\n    orientations: list[str] = []\n    centers: list[tuple[int, int]] = []\n    for coords in comps:\n        assert coords.shape[0] == 3, \"each door segment is three pixels long\"\n        r0, c0 = coords.min(axis=0)\n        r1, c1 = coords.max(axis=0)\n        height = int(r1 - r0 + 1)\n        width = int(c1 - c0 + 1)\n        if height == 3 and width == 1:\n            orientations.append(\"vertical\")\n            centers.append((int(r0 + 1), int(c0)))\n        elif height == 1 and width == 3:\n            orientations.append(\"horizontal\")\n            centers.append((int(r0), int(c0 + 1)))\n        else:\n            raise AssertionError(\"door segments must be straight length-3 bars\")\n\n    assert len(set(orientations)) == 1, \"all doors must share an orientation\"\n    return orientations[0], centers\n\n\ndef _paint_segment(\n    out: np.ndarray,\n    start: tuple[int, int],\n    end: tuple[int, int],\n    color: int,\n    allowed: set[int],\n) -> None:\n    r0, c0 = map(int, start)\n    r1, c1 = map(int, end)\n    assert r0 == r1 or c0 == c1, \"path segments must be orthogonal\"\n    height, width = out.shape\n    assert 0 <= r0 < height and 0 <= r1 < height\n    assert 0 <= c0 < width and 0 <= c1 < width\n\n    if r0 == r1:\n        for c in range(min(c0, c1), max(c0, c1) + 1):\n            assert int(out[r0, c]) in allowed, \"path may only cover bg, doors, or markers\"\n            out[r0, c] = int(color)\n    else:\n        for r in range(min(r0, r1), max(r0, r1) + 1):\n            assert int(out[r, c0]) in allowed, \"path may only cover bg, doors, or markers\"\n            out[r, c0] = int(color)\n\n\ndef _markers(g: np.ndarray, path_color: int) -> list[tuple[int, int]]:\n    coords = np.argwhere(g == int(path_color))\n    assert coords.shape[0] == 2, \"expected two marker pixels\"\n    return [tuple(map(int, coord)) for coord in coords]\n\n\ndef _solve_vertical_walls(\n    g: np.ndarray,\n    centers: list[tuple[int, int]],\n    markers: list[tuple[int, int]],\n    bg: int,\n    path_color: int,\n    door_color: int,\n    wall_color: int,\n) -> np.ndarray:\n    out = g.copy()\n    centers = sorted(centers, key=lambda p: p[1])\n    wall_cols = sorted(set(map(int, np.argwhere(g == int(wall_color))[:, 1])))\n    assert len(wall_cols) == len(centers), \"each vertical wall must have one door\"\n    assert [c for _r, c in centers] == wall_cols\n    for _r, c in centers:\n        assert np.all(np.isin(g[:, c], [wall_color, door_color]))\n\n    start, end = sorted(markers, key=lambda p: p[1])\n    assert start[1] < centers[0][1] and end[1] > centers[-1][1]\n\n    allowed = {int(bg), int(path_color), int(door_color)}\n    cur = start\n    for door_r, door_c in centers:\n        approach = (cur[0], door_c - 1)\n        _paint_segment(out, cur, approach, path_color, allowed)\n        _paint_segment(out, approach, (door_r, door_c - 1), path_color, allowed)\n        _paint_segment(out, (door_r, door_c - 1), (door_r, door_c), path_color, allowed)\n        cur = (door_r, door_c)\n\n    _paint_segment(out, cur, (cur[0], end[1]), path_color, allowed)\n    _paint_segment(out, (cur[0], end[1]), end, path_color, allowed)\n    return out\n\n\ndef _solve_horizontal_walls(\n    g: np.ndarray,\n    centers: list[tuple[int, int]],\n    markers: list[tuple[int, int]],\n    bg: int,\n    path_color: int,\n    door_color: int,\n    wall_color: int,\n) -> np.ndarray:\n    out = g.copy()\n    centers = sorted(centers, key=lambda p: p[0])\n    wall_rows = sorted(set(map(int, np.argwhere(g == int(wall_color))[:, 0])))\n    assert len(wall_rows) == len(centers), \"each horizontal wall must have one door\"\n    assert [r for r, _c in centers] == wall_rows\n    for r, _c in centers:\n        assert np.all(np.isin(g[r, :], [wall_color, door_color]))\n\n    start, end = sorted(markers, key=lambda p: p[0])\n    assert start[0] < centers[0][0] and end[0] > centers[-1][0]\n\n    allowed = {int(bg), int(path_color), int(door_color)}\n    cur = start\n    for door_r, door_c in centers:\n        approach = (door_r - 1, cur[1])\n        _paint_segment(out, cur, approach, path_color, allowed)\n        _paint_segment(out, approach, (door_r - 1, door_c), path_color, allowed)\n        _paint_segment(out, (door_r - 1, door_c), (door_r, door_c), path_color, allowed)\n        cur = (door_r, door_c)\n\n    _paint_segment(out, cur, (end[0], cur[1]), path_color, allowed)\n    _paint_segment(out, (end[0], cur[1]), end, path_color, allowed)\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Draw the marker-colored route through the centers of all doors in the parallel wall maze.\n\n    Input structure:\n    - The grid has a background, parallel full-span walls, one three-pixel door\n      segment in each wall, and two marker pixels sharing a color.\n    - Walls are either all vertical or all horizontal, and the markers are on\n      opposite outer sides of the wall set.\n\n    Rule:\n    - Keep the scene unchanged except for the route.\n    - Visit the door centers in wall order from the upper/left marker side to\n      the lower/right marker side.\n    - In each corridor, draw an orthogonal path to the cell just before the next\n      wall, move along that wall to the door center, cross the center, and\n      continue to the next corridor; after the last door, connect to the other\n      marker.\n\n    Key insight:\n    - The three-pixel door segments mark the only crossing points through a set\n      of parallel walls, so the output is the corridor path threaded through\n      those centers.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg, path_color, door_color, wall_color = _roles(g)\n    orientation, centers = _door_centers(g, door_color)\n    markers = _markers(g, path_color)\n\n    if orientation == \"vertical\":\n        return _solve_vertical_walls(g, centers, markers, bg, path_color, door_color, wall_color)\n    assert orientation == \"horizontal\"\n    return _solve_horizontal_walls(g, centers, markers, bg, path_color, door_color, wall_color)\n\n# --------------- generator (att1) ---------------\n\n# Canvas and color role sampling.\nGRID_H = 30\nGRID_W = 30\nCOLOR_POOL = range(10)\nN_ROLE_COLORS = 4\n\n# Parallel wall and door geometry.\nORIENTATIONS = (\"vertical\", \"horizontal\")\nWALL_COUNT_RANGE = (3, 4)\nWALL_POS_LO = 4\nWALL_POS_HI_MARGIN = 5\nWALL_MIN_GAP = 2\nDOOR_CENTER_LO = 3\nDOOR_CENTER_HI_MARGIN = 4\n\n# Marker placement and retry budget.\nMARKER_EDGE_RANGE = (1, 3)\nMARKER_FREE_LO = 1\nMARKER_FREE_HI_MARGIN = 2\nGEN_RETRIES = 300\n\n\ndef _place_positions(n: int, lo: int, hi: int, min_gap: int, rng: random.Random) -> list[int] | None:\n    \"\"\"Place n positions in [lo..hi] with pairwise gap >= min_gap between consecutive sorted positions.\"\"\"\n    needed = n + (n - 1) * min_gap\n    span = hi - lo + 1\n    if span < needed:\n        return None\n    compressed_span = span - (n - 1) * min_gap\n    picks = sorted(rng.sample(range(compressed_span), n))\n    return [lo + picks[i] + i * min_gap for i in range(n)]\n\n\ndef _sample_wall_layout(orientation: str, n_walls: int, rng: random.Random):\n    \"\"\"Return wall positions and per-wall door centers for the chosen orientation.\"\"\"\n    wall_axis, door_axis = (GRID_W, GRID_H) if orientation == \"vertical\" else (GRID_H, GRID_W)\n    walls = _place_positions(\n        n_walls,\n        lo=WALL_POS_LO,\n        hi=wall_axis - WALL_POS_HI_MARGIN,\n        min_gap=WALL_MIN_GAP,\n        rng=rng,\n    )\n    if walls is None:\n        return None\n    doors = [rng.randint(DOOR_CENTER_LO, door_axis - DOOR_CENTER_HI_MARGIN) for _ in range(n_walls)]\n    return walls, doors\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, components_mask, find_components, get_bg\nimport random\n\n\ndef _unique_largest_count_color(g: np.ndarray, colors: list[int]) -> int:\n    counts = [(int(np.sum(g == color)), int(color)) for color in colors]\n    max_count = max(count for count, _color in counts)\n    winners = [color for count, color in counts if count == max_count]\n    assert len(winners) == 1, \"expected one most numerous non-background obstacle color\"\n    return winners[0]\n\n\ndef _marker_bbox(g: np.ndarray, marker_colors: list[int]) -> tuple[int, int, int, int]:\n    mask = np.isin(g, marker_colors)\n    candidates: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(mask, connectivity=8):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        if r0 == 0:\n            candidates.append((r0, c0, r1, c1))\n\n    assert len(candidates) == 1, \"expected one top-edge marker component\"\n    return candidates[0]\n\n\ndef _runs(values: list[int]) -> list[tuple[int, int]]:\n    if not values:\n        return []\n\n    runs: list[tuple[int, int]] = []\n    start = prev = values[0]\n    for value in values[1:]:\n        if value == prev + 1:\n            prev = value\n            continue\n        runs.append((start, prev))\n        start = prev = value\n    runs.append((start, prev))\n    return runs\n\n\ndef _can_slide_right(base: np.ndarray, obstacle: int, bg: int, cols: list[int], marker_bottom_r: int, height: int) -> bool:\n    H, W = base.shape\n    assert cols\n    if cols[-1] + 1 >= W:\n        return False\n\n    for floor_r in range(marker_bottom_r + 1, H):\n        target_rows = np.arange(floor_r - height + 1, floor_r + 1)\n        if int(target_rows[0]) < 0:\n            continue\n\n        shifted_cols = [c + 1 for c in cols]\n        target_is_clear = all(np.all(base[target_rows, c] == bg) for c in shifted_cols)\n        if not target_is_clear:\n            continue\n\n        for c in cols:\n            if int(base[floor_r, c]) != obstacle:\n                continue\n            has_horizontal_neighbor = (\n                (c > 0 and int(base[floor_r, c - 1]) == obstacle)\n                or (c + 1 < W and int(base[floor_r, c + 1]) == obstacle)\n            )\n            if has_horizontal_neighbor:\n                return True\n\n    return False\n\n\ndef _clear_bottom_edge_gap(base: np.ndarray, out: np.ndarray, obstacle: int, bg: int, c: int, width: int) -> None:\n    H, W = base.shape\n    if int(base[H - 1, c]) != obstacle:\n        return\n\n    c1 = c\n    while c1 < W and int(base[H - 1, c1]) == obstacle:\n        c1 += 1\n\n    if c1 - c >= width:\n        out[H - 1, c + 1 : c + width] = bg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\n    Input structure\n    - The background is the dominant color.\n    - The most numerous non-background color forms stationary grey obstacle pixels.\n    - The other two colors form a single 3x3 top-edge marker whose top two rows\n      are maroon and whose bottom row contains maroon or blue control pixels.\n\n    Rule\n    - Erase the top marker.\n    - Treat each marker column as a vertical drop retaining its three colors.\n    - A column whose bottom control pixel is blue stops immediately above the\n      first grey pixel below that column, or bottom-aligns if none exists.\n    - Contiguous maroon-ended columns pass through obstacles and bottom-align;\n      if such a run has a clear down-right slide from a grey ledge, shift the\n      run one column right before bottom-aligning.\n    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n      the rest of the marker-width gap in that bottom bar.\n\n    Key insight\n    - The bottom row of the top marker is a control strip: blue cells mean\n      \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H = g.shape[0]\n    bg = int(get_bg(g))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 3, \"expected obstacle color plus two marker colors\"\n    obstacle = _unique_largest_count_color(g, non_bg)\n    marker_colors = [color for color in non_bg if color != obstacle]\n    assert len(marker_colors) == 2, \"expected exactly two marker colors\"\n\n    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)\n    marker = g[r0 : r1 + 1, c0 : c1 + 1]\n    marker_h, marker_w = marker.shape\n    assert (marker_h, marker_w) == (3, 3), \"expected a 3x3 marker\"\n    assert np.all(np.isin(marker, marker_colors)), \"marker bbox must contain only marker colors\"\n\n    pass_color = int(marker[0, 0])\n    assert np.all(marker[:2, :] == pass_color), \"top two marker rows must be the pass-through color\"\n    stop_colors = [color for color in marker_colors if color != pass_color]\n    assert len(stop_colors) == 1, \"expected one stop color\"\n    stop_color = stop_colors[0]\n\n    out = g.copy()\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    base = out.copy()\n\n    pass_columns: list[int] = []\n    for j in range(marker_w):\n        c = c0 + j\n        stack = marker[:, j]\n        bottom_control = int(stack[-1])\n\n        if bottom_control == stop_color:\n            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n            if len(obstacles_below):\n                floor_r = int(r1 + 1 + obstacles_below[0])\n                top_r = floor_r - marker_h\n            else:\n                top_r = H - marker_h\n            assert top_r >= 0, \"stopped column must fit above its obstacle\"\n            out[top_r : top_r + marker_h, c] = stack\n        else:\n            assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n            pass_columns.append(j)\n\n    for start_j, end_j in _runs(pass_columns):\n        source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n        top_r = H - marker_h\n\n        for j in range(start_j, end_j + 1):\n            c = c0 + j + shift\n            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n            out[top_r : top_r + marker_h, c] = marker[:, j]\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\nGRID_SIZE_RANGE = (14, 16)\nMARKER_SIZE = 3\nSTOP_COUNT_RANGE = (1, 3)\nOBSTACLE_COMPONENT_RANGE = (7, 9)\nOBSTACLE_PIXEL_RANGE = (20, 31)\nCOMPONENT_SIZE_RANGE = (1, 11)\nMIN_STOP_OBSTACLE_ROW = 6\nDROP_ZONE_HEIGHT = 3\nCOMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300\n\n\ndef _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:\n    grid = np.full((H, W), GEN_BG, dtype=int)\n    c0 = random.randint(0, W - MARKER_SIZE)\n    num_stops = random.randint(*STOP_COUNT_RANGE)\n    positions = list(range(MARKER_SIZE))\n    random.shuffle(positions)\n    stop_positions = sorted(positions[:num_stops])\n    marker = np.full((MARKER_SIZE, MARKER_SIZE), GEN_PASS, dtype=int)\n    for j in stop_positions:\n        marker[MARKER_SIZE - 1, j] = GEN_STOP\n    grid[0:MARKER_SIZE, c0:c0 + MARKER_SIZE] = marker\n    obstacle_pixels: set[tuple[int, int]] = set()\n    for j in stop_positions:\n        col = c0 + j\n        first_obs_row = random.randint(MIN_STOP_OBSTACLE_ROW, H - 1)\n        grid[first_obs_row, col] = GEN_OBSTACLE\n        obstacle_pixels.add((first_obs_row, col))\n    return grid, c0, stop_positions, obstacle_pixels\n\n\ndef _forbidden_cells(H: int, c0: int, stop_positions: list[int], obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]]:\n    forbidden = {(r, c) for r in range(MARKER_SIZE) for c in range(c0, c0 + MARKER_SIZE)}\n    for j in stop_positions:\n        col = c0 + j\n        for r in range(MARKER_SIZE, H):\n            if (r, col) not in obstacle_pixels:\n                continue\n            for dr in range(1, DROP_ZONE_HEIGHT + 1):\n                if r - dr >= 0:\n                    forbidden.add((r - dr, col))\n            break\n    return forbidden\n\n\ndef _sample_component_sizes(total_pixels: int, component_count: int) -> list[int] | None:\n    component_sizes = []\n    left = total_pixels\n    min_size, max_size = COMPONENT_SIZE_RANGE\n    for i in range(component_count):\n        remaining = component_count - i - 1\n        if remaining == 0:\n            size = left\n        else:\n            lo = max(min_size, left - max_size * remaining)\n            hi = min(max_size, left - min_size * remaining)\n            if lo > hi:\n                return None\n            size = random.randint(lo, hi)\n        left -= size\n        if size < min_size or size > max_size:\n            return None\n        component_sizes.append(size)\n    random.shuffle(component_sizes)\n    return component_sizes\n\n\ndef _grow_component(grid: np.ndarray, comp_size: int, forbidden: set[tuple[int, int]],\n                    obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]] | None:\n    H, W = grid.shape\n    sr, sc = random.randint(0, H - 1), random.randint(0, W - 1)\n    if (sr, sc) in forbidden or (sr, sc) in obstacle_pixels or grid[sr, sc] != GEN_BG:\n","exit_code":0,"status":"completed"}}
