trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n73: \n74:     # Feasible top-left placements: NxN window fully inside trav.\n75:     h2 = int(H - n + 1)\n76:     w2 = int(W - n + 1)\n77:     assert not (h2 <= 0 or w2 <= 0)\n78:     assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n79: \n80:     feasible = np.zeros((h2, w2), dtype=bool)\n81:     for r in range(h2):\n82:         for c in range(w2):\n83:             if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n84:                 feasible[int(r), int(c)] = True\n85:     assert not (not bool(feasible[int(sr), int(sc)]))\n86: \n87:     # BFS on placement grid.\n---\n469: \n470: \n471: def generate_input():\n472:     for _ in range(300):\n473:         result = _gen_attempt()\n474:         if result is not None:\n475:             return result\n476:     raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n477: \n478: \n---\nFILE /home/lixinyu/snap/new/ARC_code/eval/0934a4d8.py\n72: \n73: \n74: def main(grid: np.ndarray) -> np.ndarray:\n75:     \"\"\"\n76:     Reveal the rectangular patch hidden by the solid marker using the grid's reflection symmetries.\n77: \n78:     Input structure:\n79:     - A square colored pattern with one solid rectangular marker color occluding a patch.\n80:     - The visible pattern has horizontal and vertical reflection symmetry on a large lower/right strip.\n81:     - The top and left outer strips also expose transpose counterparts for cells not recoverable by those reflections.\n82: \n83:     Rule:\n84:     - Find the unique color whose full extent is a solid rectangle; this rectangle is the output region.\n85:     - Infer the reflected strip start as the smallest row/column offset whose lower/right strips are mirror-consistent, ignoring marker pixels.\n86:     - For each marker pixel, copy the unique non-marker value in its horizontal/vertical reflection orbit; if that orbit is entirely hidden in the outer strip, use the transposed top/left-strip counterpart.\n87: \n88:     Key insight:\n89:     The marker is not part of the pattern; it covers a missing rectangle whose cells are still determined by the visible mirror or transpose copies elsewhere in the grid.\n90:     \"\"\"\n91:     g = np.asarray(grid, dtype=int)\n92:     marker, (r0, c0, r1, c1) = _solid_rectangle_marker(g)\n93:     lo = _find_reflected_strip_start(g, marker)\n94: \n95:     h = int(r1 - r0 + 1)\n96:     w = int(c1 - c0 + 1)\n97:     out = np.empty((h, w), dtype=int)\n98: \n99:     for rr in range(h):\n100:         for cc in range(w):\n101:             r = int(r0 + rr)\n102:             c = int(c0 + cc)\n103:             values = _reflection_orbit_values(g, r, c, lo, marker)\n104:             if values:\n105:                 assert len(values) == 1\n106:                 out[rr, cc] = values.pop()\n107:             else:\n108:                 assert r < lo or c < lo\n109:                 assert 0 <= c < g.shape[0] and 0 <= r < g.shape[1]\n110:                 value = int(g[c, r])\n111:                 assert value != marker\n112:                 out[rr, cc] = value\n113: \n114:     return out\n115: \n116: # --------------- generator (o5x) ---------------\n117: \n118: # --- CFG: canvas & structure ---\n119: _N = 30                  # grid side length (always square)\n120: _LO = 2                  # outer border width (rows/cols 0..lo-1 are \"free\" border)\n121: _HI = _N - 1             # max row/col index\n122: \n123: # --- CFG: colors ---\n124: _PALETTE = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)  # 8 non-marker colors\n125: _MARKER = 8              # marker fill color\n126: \n127: # --- CFG: marker rectangle size ---\n128: _MARKER_DIM_LO = 3       # min marker side length\n129: _MARKER_DIM_HI = 9       # max marker side length (inclusive)\n130: _MARKER_AREA_LO = 16     # min marker area\n131: _MARKER_AREA_HI = 36     # max marker area\n132: \n133: # --- CFG: generation retries ---\n134: _MAX_RETRIES = 300\n135: \n136: _RNG = np.random.default_rng()\n137: _SIZE_PAIRS = [\n138:     (h, w)\n139:     for h in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)\n140:     for w in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)\n141:     if _MARKER_AREA_LO <= h * w <= _MARKER_AREA_HI\n142: ]\n143: _PLACEMENT_CACHE: dict[tuple[int, int], list[tuple[int, int, list[tuple[int, int]]]]] = {}\n144: \n145: \n146: def _orbit(r: int, c: int) -> set[tuple[int, int]]:\n147:     \"\"\"Return the LR+UD reflection orbit of (r, c) within the [_LO.._HI] axes.\"\"\"\n148:     rows = {r}\n149:     cols = {c}\n150:     if _LO <= r <= _HI:\n151:         rows.add(_LO + _HI - r)\n152:     if _LO <= c <= _HI:\n153:         cols.add(_LO + _HI - c)\n---\n273: \n274: \n275: def generate_input() -> np.ndarray:\n276:     for _ in range(_MAX_RETRIES):\n277:         grid = _gen_attempt()\n278:         if grid is not None:\n279:             return grid\n280:     raise RuntimeError(\"failed to generate a valid 0934a4d8 input\")\n---\nFILE /home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py\n226: \n227: \n228: def main(grid: np.ndarray) -> np.ndarray:\n229:     \"\"\"\n230:     Swing an irregular line segment around a nearby obstacle sprite, preserving its pixel count.\n231: \n232:     Input structure:\n233:     - bg, bar color (straight lines perpendicular to the grid edge, one end on the border), segment color (irregular stroke attached to bar's inner endpoint), obstacle color (sprite near the bar terminal).\n234: \n235:     Rule:\n236:     - Each bar is perpendicular to the edge it touches; its inner (terminal) endpoint has an attached irregular segment.\n237:     - The segment detaches and re-routes: it travels from the terminal toward the nearest obstacle, hugs the obstacle's boundary, then exits at a 45° diagonal.\n238:     - Total painted pixels equal the original segment length.\n239: \n240:     Key insight: The segment behaves like a rope swung around the obstacle — attach at the nearest point, trace the skin, exit