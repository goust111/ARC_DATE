mp_pts, seg_color, new_pts)\n284:     for bar_col, bar_comp, terminal in sorted(list(bar_candidates()), key=lambda x: (-len(x[1]), x[0], x[2])):\n285:         # Segment neighbor candidates at terminal.\n286:         neigh = []\n287:         for nr, nc in neighbors4(terminal[0], terminal[1]):\n288:             if 0 <= nr < h and 0 <= nc < w:\n289:                 v = int(g[nr, nc])\n290:                 if v != bg and v != bar_col:\n291:                     neigh.append((v, (nr, nc)))\n292:         assert neigh, f\"bar terminal {terminal} must have a non-bg/non-bar neighbor\"\n293: \n294:         # Choose a segment that behaves like a 1-cell-thick stroke attached at an endpoint.\n295:         best_seg = None  # (L, comp_size, seg_col, seg_start, seg_comp)\n296:         for cand_col, cand_start in neigh:\n297:             for comp in _components(g, cand_col, conn8=True):\n298:                 if cand_start in comp:\n299:                     if len(comp) < 2:\n300:                         break\n301:                     deg = _segment_degrees(comp)\n302:                     if deg.get(cand_start, 0) != 1:\n303:                         break\n304:                     path = _segment_main_path(comp, cand_start)\n305:                     L = len(path)\n306:                     key = (L, len(comp), cand_col, cand_start[0], cand_start[1])\n307:                     if best_seg is None or key > best_seg[0]:\n---\n761: \n762: \n763: def generate_input() -> np.ndarray:\n764:     for _ in range(MAX_RETRIES):\n765:         grid = _gen_attempt()\n766:         if grid is not None:\n767:             return grid\n768:     raise RuntimeError(f\"failed to generate a valid input after {MAX_RETRIES} attempts\")\n---\n","exit_code":0,"status":"completed"}}
