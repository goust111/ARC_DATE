{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg as _bg_color, neighbors8\nimport random\nfrom arc_utils import random_free_location, is_contiguous\n\n\ndef _rotate_cells(cells: list[tuple[int, int, int]], k: int) -> list[tuple[int, int, int]]:\n    pts = [(r, c, col) for r, c, col in cells]\n    for _ in range(k % 4):\n        pts = [(c, -r, col) for r, c, col in pts]  # 90° clockwise around origin\n    min_r = min(r for r, _, _ in pts)\n    min_c = min(c for _, c, _ in pts)\n    pts = [(r - min_r, c - min_c, col) for r, c, col in pts]\n    pts.sort()\n    return pts\n\n\ndef _variants(cells: list[tuple[int, int, int]]) -> list[list[tuple[int, int, int]]]:\n    seen: set[tuple[tuple[int, int, int], ...]] = set()\n    outs: list[list[tuple[int, int, int]]] = []\n    for k in range(4):\n        rot = _rotate_cells(cells, k)\n        key = tuple(rot)\n        if key not in seen:\n            seen.add(key)\n            outs.append(rot)\n    return outs\n\n\ndef _find_marker_color(g: np.ndarray, bg: int) -> int | None:\n    colors = [c for c in sorted(set(map(int, g.ravel()))) if c != bg]\n    counts = {c: int(np.sum(g == c)) for c in colors}\n    singletons = [c for c in colors if counts[c] == 1]\n    if singletons:\n        # Prefer a singleton that is 8-neigh adjacent to some other non-bg pixel.\n        for c in singletons:\n            r, col = map(int, np.argwhere(g == c)[0])\n            for nr, nc in neighbors8(r, col):\n                if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] != bg:\n                    return c\n        assert False, \"no adjacent singleton found — input must have adjacent singleton marker\"\n\n\ndef _extract_pieces(g: np.ndarray) -> tuple[list[dict], int]:\n    bg = _bg_color(g)\n    colors = [c for c in sorted(set(map(int, g.ravel()))) if c != bg]\n    if not colors:\n        return [], bg\n\n    marker_color = _find_marker_color(g, bg)\n    marker_pos = None\n    if marker_color is not None and int(np.sum(g == marker_color)) == 1:\n        marker_pos = tuple(map(int, np.argwhere(g == marker_color)[0]))\n\n    # Anchor color is the color 8-neigh adjacent to the marker.\n    anchor_color = None\n    if marker_pos is not None:\n        mr, mc = marker_pos\n        neigh = set()\n        for nr, nc in neighbors8(mr, mc):\n            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1]:\n                v = int(g[nr, nc])\n                if v != bg and v != marker_color:\n                    neigh.add(v)\n        if len(neigh) == 1:\n            anchor_color = next(iter(neigh))\n\n    pieces: list[dict] = []\n    used = set()\n\n    if anchor_color is not None and marker_pos is not None:\n        # Anchor is a multi-color piece: anchor_color pixels plus the marker pixel.\n        coords = []\n        for r, c in np.argwhere(g == anchor_color):\n            coords.append((int(r), int(c), int(anchor_color)))\n        mr, mc = marker_pos\n        coords.append((mr, mc, int(marker_color)))\n        # Normalize to local coordinates.\n        min_r = min(r for r, _, _ in coords)\n        min_c = min(c for _, c, _ in coords)\n        coords = [(r - min_r, c - min_c, col) for r, c, col in coords]\n        pieces.append(\n            {\n                \"name\": \"anchor\",\n                \"cells\": coords,\n                \"marker_color\": int(marker_color),\n            }\n        )\n        used.add(anchor_color)\n        used.add(marker_color)\n\n    for col in colors:\n        if col in used:\n            continue\n        coords = [(int(r), int(c), int(col)) for r, c in np.argwhere(g == col)]\n        min_r = min(r for r, _, _ in coords)\n        min_c = min(c for _, c, _ in coords)\n        coords = [(r - min_r, c - min_c, col) for r, c, col in coords]\n        pieces.append({\"name\": f\"c{col}\", \"cells\": coords})\n\n    return pieces, bg\n\n\ndef _dims(area: int) -> list[tuple[int, int]]:\n    pairs = []\n    for h in range(1, int(area**0.5) + 1):\n        if area % h == 0:\n            w = area // h\n            pairs.append((h, w))\n            if h != w:\n                pairs.append((w, h))\n    # Prefer close-to-square, then smaller height.\n    pairs.sort(key=lambda t: (abs(t[0] - t[1]), t[0], t[1]))\n    return pairs\n\n\ndef _placeable(board: np.ndarray, placement: list[tuple[int, int, int]]) -> bool:\n    for r, c, _ in placement:\n        if board[r, c] != -1:\n            return False\n    return True\n\n\ndef _apply(board: np.ndarray, placement: list[tuple[int, int, int]], val: int | None = None) -> None:\n    if val is None:\n        for r, c, col in placement:\n            board[r, c] = col\n    else:\n        for r, c, _ in placement:\n            board[r, c] = val\n\n\ndef _all_placements_for_variant(\n    variant: list[tuple[int, int, int]], H: int, W: int\n) -> list[list[tuple[int, int, int]]]:\n    max_r = max(r for r, _, _ in variant)\n    max_c = max(c for _, c, _ in variant)\n    ph, pw = max_r + 1, max_c + 1\n    outs: list[list[tuple[int, int, int]]] = []\n    for tr in range(H - ph + 1):\n        for tc in range(W - pw + 1):\n            outs.append([(r + tr, c + tc, col) for r, c, col in variant])\n    return outs\n\n\ndef _solve_packing(pieces: list[dict], H: int, W: int) -> np.ndarray | None:\n    board = np.full((H, W), -1, dtype=int)\n\n    # Build variants + placements per piece.\n    piece_vars: list[list[list[tuple[int, int, int]]]] = []\n    for p in pieces:\n        piece_vars.append(_variants(p[\"cells\"]))\n\n    # Place anchor first if present: marker must end up at (0,0).\n    remaining = list(range(len(pieces)))\n    anchor_idx = next((i for i, p in enumerate(pieces) if p[\"name\"] == \"anchor\"), None)\n    if anchor_idx is not None:\n        remaining.remove(anchor_idx)\n        marker_col = pieces[anchor_idx][\"marker_color\"]\n        anchor_solutions = []\n        for var in piece_vars[anchor_idx]:\n            marker_pts = [(r, c) for r, c, col in var if col == marker_col]\n            if len(marker_pts) != 1:\n                continue\n            mr, mc = marker_pts[0]\n            tr, tc = -mr, -mc\n            placed = [(r + tr, c + tc, col) for r, c, col in var]\n            if all(0 <= r < H and 0 <= c < W for r, c, _ in placed):\n                anchor_solutions.append(placed)\n        if not anchor_solutions:\n            return None\n        # Try each feasible anchor orientation (usually 1).\n        for anchor_place in anchor_solutions:\n            if not _placeable(board, anchor_place):\n                continue\n            _apply(board, anchor_place)\n\n            # Backtracking for remaining pieces.\n            def backtrack(rem: list[int]) -> bool:\n                if not rem:\n                    return True\n\n                # Choose piece with fewest fits under current board.\n                best_pi = None\n                best_options = None\n                best_count = None\n                for pi in rem:\n                    opts = []\n                    for var in piece_vars[pi]:\n                        for placement in _all_placements_for_variant(var, H, W):\n                            if _placeable(board, placement):\n                                opts.append(placement)\n                    cnt = len(opts)\n                    if cnt == 0:\n                        return False\n                    if best_count is None or cnt < best_count:\n                        best_count = cnt\n                        best_pi = pi\n                        best_options = opts\n                        if best_count == 1:\n                            break\n\n                assert best_pi is not None and best_options is not None\n                next_rem = [x for x in rem if x != best_pi]\n                for placement in best_options:\n                    _apply(board, placement)\n                    if backtrack(next_rem):\n                        return True\n                    _apply(board, placement, -1)\n                return False\n\n            if backtrack(remaining):\n                return board\n            _apply(board, anchor_place, -1)\n        return None\n\n    # No anchor: just pack all pieces.\n    def backtrack(rem: list[int]) -> bool:\n        if not rem:\n            return True\n        best_pi = None\n        best_options = None\n        best_count = None\n        for pi in rem:\n            opts = []\n            for var in piece_vars[pi]:\n                for placement in _all_placements_for_variant(var, H, W):\n                    if _placeable(board, placement):\n                        opts.append(placement)\n            cnt = len(opts)\n            if cnt == 0:\n                return False\n            if best_count is None or cnt < best_count:\n                best_count = cnt\n                best_pi = pi\n                best_options = opts\n        assert best_pi is not None and best_options is not None\n        next_rem = [x for x in rem if x != best_pi]\n        for placement in best_options:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/291dc1e1.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_coords, components_mask, crop_bbox, get_bg, paste, random_free_location\nfrom arc_utils import paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reorder and stack rectangles by proximity to two colored edge lines.\n\n    Input structure:\n    - bg = most common color.\n    - Two edge lines (h + v) meet at a corner marked by a unique color.\n    - \"Blue\" line is color 1 if present, else the longer line; other is \"red.\"\n    - Solid rectangles in the interior.\n\n    Rule:\n    - Sort rectangles by (distance to blue edge, distance to red edge).\n    - If the blue edge is vertical, rotate each rectangle 90° CCW.\n    - Stack top-to-bottom, centered horizontally.\n\n    Key insight: Edge-line colors encode a coordinate system; proximity to each axis determines stacking order and rotation.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # --- locate the marked corner ---\n    corners = [(0, 0), (0, int(W - 1)), (int(H - 1), 0), (int(H - 1), int(W - 1))]\n    corner = None\n    for r, c in corners:\n        if int(g[r, c]) == int(bg):\n            continue\n        nbr = []\n        if r == 0:\n            nbr.append(int(g[r + 1, c]))\n        if r == H - 1:\n            nbr.append(int(g[r - 1, c]))\n        if c == 0:\n            nbr.append(int(g[r, c + 1]))\n        if c == W - 1:\n            nbr.append(int(g[r, c - 1]))\n        if nbr and all(int(n) != int(g[r, c]) for n in nbr):\n            corner = (int(r), int(c))\n            break\n    assert corner is not None\n\n    cr, cc = map(int, corner)\n    marker = int(g[cr, cc])\n\n    # --- line colors adjacent to the corner ---\n    hstep = 1 if cc == 0 else -1\n    vstep = 1 if cr == 0 else -1\n    hcol = int(g[cr, cc + hstep])\n    vcol = int(g[cr + vstep, cc])\n\n    # Choose \"blue\" line color.\n    if hcol == 1 or vcol == 1:\n        blue_col = 1\n        red_col = int(vcol if hcol == 1 else hcol)\n    else:\n        # Fallback: longer line is blue.\n        hlen = 0\n        c = int(cc + hstep)\n        while 0 <= c < W and int(g[cr, c]) == int(hcol):\n            hlen += 1\n            c += int(hstep)\n        vlen = 0\n        r = int(cr + vstep)\n        while 0 <= r < H and int(g[r, cc]) == int(vcol):\n            vlen += 1\n            r += int(vstep)\n        if vlen >= hlen:\n            blue_col = int(vcol)\n            red_col = int(hcol)\n        else:\n            blue_col = int(hcol)\n            red_col = int(vcol)\n\n    blue_orient = \"h\" if int(hcol) == int(blue_col) else \"v\"\n    red_orient = \"h\" if int(hcol) == int(red_col) else \"v\"\n\n    # --- mask out the two edge lines (entire corner row + col) ---\n    line_mask = np.zeros((H, W), dtype=bool)\n    line_mask[cr, :] = True\n    line_mask[:, cc] = True\n\n    # --- extract solid rectangles (no bg inside bbox) ---\n    mask = (g != int(bg)) & (~line_mask) & (g != int(marker))\n    rects = []\n    for coords in components_mask(mask, connectivity=4):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if bool((sub == int(bg)).any()):\n            continue\n        rects.append({\"box\": tuple(map(int, b)), \"arr\": sub.copy()})\n\n    assert not (not rects)\n\n    def dist_to_edge(rect: dict, orient: str, edge_idx: int) -> int:\n        r0, c0, r1, c1 = map(int, rect[\"box\"])\n        if orient == \"v\":\n            col = int(edge_idx)\n            if int(c0) > col:\n                return int(c0 - col - 1)\n            if int(c1) < col:\n                return int(col - c1 - 1)\n            return 0\n        row = int(edge_idx)\n        if int(r0) > row:\n            return int(r0 - row - 1)\n        if int(r1) < row:\n            return int(row - r1 - 1)\n        return 0\n\n    blue_edge_idx = int(cc if blue_orient == \"v\" else cr)\n    red_edge_idx = int(cc if red_orient == \"v\" else cr)\n\n    def along_from_corner(rect: dict, orient: str) -> int:\n        r0, c0, r1, c1 = map(int, rect[\"box\"])\n        if orient == \"v\":\n            return int(r0 if cr == 0 else -r1)\n        return int(c0 if cc == 0 else -c1)\n\n    for rct in rects:\n        rct[\"db\"] = int(dist_to_edge(rct, blue_orient, blue_edge_idx))\n        rct[\"dr\"] = int(dist_to_edge(rct, red_orient, red_edge_idx))\n\n    rects.sort(\n        key=lambda r: (\n            int(r[\"db\"]),\n            int(r[\"dr\"]),\n            along_from_corner(r, blue_orient),\n            along_from_corner(r, red_orient),\n        )\n    )\n\n    # Rotate all rectangles if blue edge is vertical.\n    seq = []\n    for rct in rects:\n        a = rct[\"arr\"]\n        if blue_orient == \"v\":\n            a = np.rot90(a, k=1)  # CCW\n        seq.append(a)\n\n    outW = int(max(int(a.shape[1]) for a in seq))\n    outH = int(sum(int(a.shape[0]) for a in seq))\n    out = np.full((outH, outW), int(bg), dtype=int)\n\n    out_r = 0\n    for a in seq:\n        h, w = map(int, a.shape)\n        out_c = int((outW - w) // 2)\n        paste(out, a, int(out_r), int(out_c))\n        out_r += int(h)\n\n    return out\n\n# --------------- generator (attempt 3, Codex) ---------------\n\nBG = 8\nBLUE = 1\nRED = 2\nMARKER = 0\nDOMINANT_COLORS = np.array([3, 4, 5, 6, 7, 9], dtype=int)\nMINORITY_COLORS = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)\n\n\ndef _transform(grid: np.ndarray, blue_orient: str, corner: str) -> np.ndarray:\n    if blue_orient == \"h\":\n        if corner == \"tl\":\n            return grid\n        if corner == \"tr\":\n            return np.fliplr(grid)\n        if corner == \"bl\":\n            return np.flipud(grid)\n        return np.rot90(grid, 2)\n\n    base = np.rot90(grid, 1)\n    if corner == \"bl\":\n        return base\n    if corner == \"tl\":\n        return np.flipud(base)\n    if corner == \"tr\":\n        return np.rot90(grid, 3)\n    return np.flipud(np.rot90(grid, 3))\n\n\ndef _distribute_band_widths(count: int, used_target: int) -> list[int]:\n    extra_units = (used_target - (4 * count - 2)) // 2\n    order = np.random.permutation(count)\n    units = np.zeros(count, dtype=int)\n    remaining = int(extra_units)\n    for i, idx in enumerate(order):\n        slots_left = count - i - 1\n        lo = max(0, remaining - 3 * slots_left)\n        hi = min(3, remaining)\n        take = int(np.random.randint(lo, hi + 1))\n        units[int(idx)] = take\n        remaining -= take\n    return [2 + 2 * int(u) for u in units]\n\n\ndef _sprinkle_minorities(patch: np.ndarray, dominant: int) -> np.ndarray:\n    area = int(patch.size)\n    if area < 8 or np.random.rand() < 0.6:\n        return patch\n\n    max_minor = min(3, area // 4)\n    if max_minor < 2:\n        return patch\n\n    n_minor = int(np.random.randint(2, max_minor + 1))\n    n_colors = int(np.random.randint(1, min(2, n_minor) + 1))\n    minority_choices = [int(c) for c in MINORITY_COLORS if int(c) != dominant]\n    colors = np.random.choice(minority_choices, size=n_colors, replace=False)\n    cells = np.random.choice(area, size=n_minor, replace=False)\n    flat = patch.reshape(-1)\n    for idx, cell in enumerate(cells):\n        flat[int(cell)] = int(colors[idx % n_colors])\n    return patch\n\n\ndef _build_canonical() -> np.ndarray:\n    long_dim = int(np.random.randint(9, 29))\n    options = []\n    for trailing in (1, 2):\n        max_used = long_dim - 2 - trailing\n        if max_used < 6 or max_used % 2:\n            continue\n        max_count = min(5, (max_used + 2) // 4)\n        pairs = []\n        for a in range(2, max_count + 1):\n            for b in range(2, max_count + 1):\n                if a + b > 9:\n                    continue\n                eligible = []\n                if max_used <= 10 * a - 2:\n                    eligible.append(0)\n                if max_used <= 10 * b - 2:\n                    eligible.append(1)\n                if eligible:\n                    pairs.append((a, b, eligible))\n        if pairs:\n            options.append((max_used, pairs))\n\n    max_used, pairs = options[int(np.random.randint(len(options)))]\n    n0, n1, eligible = pairs[int(np.random.randint(len(pairs)))]\n    max_band = int(np.random.choice(eligible))\n    max0 = min(max_used, 10 * n0 - 2)\n    max1 = min(max_used, 10 * n1 - 2)\n    used0 = int(max_used if max_band == 0 else np.random.choice(np.arange(4 * n0 - 2, max0 + 1, 2)))\n    used1 = int(max_used if max_band == 1 else np.random.choice(np.arange(4 * n1 - 2, max1 + 1, 2)))\n    band0 = _distribute_band_widths(n0, used0)\n    band1 = _distribute_band_widths(n1, used1)\n\n    grid = np.full((8, long_dim), BG, dtype=int)\n    grid[0, :] = BLUE\n    grid[:, 0] = RED\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, neighbors4\n\n\ndef _legend_directions(g: np.ndarray, bg: int) -> dict[int, tuple[int, int]]:\n    \"\"\"\n    Detect legend blocks on the border.\n\n    A legend is a border-touching non-background component whose most common color is the legend\n    background `C` (and also the region border color it controls). The legend contains at least\n    two additional colors: a \"center\" color (more frequent) and an \"indicator\" color (less frequent).\n\n    The movement direction for regions with border color `C` is:\n      sign(centroid(indicator) - centroid(center))\n    \"\"\"\n    h, w = g.shape\n    non_bg = g != bg\n    best: dict[int, tuple[int, tuple[int, int]]] = {}\n    for pts in components_mask(non_bg, connectivity=4):\n        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue\n        # Legends are filled rectangles on the border.\n        r0, c0, r1, c1 = bbox_coords(pts)\n        area = (r1 - r0 + 1) * (c1 - c0 + 1)\n        if area != len(pts):\n            continue\n\n        counts: dict[int, int] = {}\n        for r, c in pts:\n            v = int(g[r, c])\n            counts[v] = counts.get(v, 0) + 1\n        if len(counts) != 3:\n            continue\n\n        bg_col = max(counts, key=counts.get)\n        others = [(cnt, col) for col, cnt in counts.items() if col != bg_col]\n        if len(others) < 2:\n            continue\n        others.sort()  # ascending by count\n        if others[0][0] == others[1][0]:\n            # Tie: choose center as the color closer to the rectangle center.\n            rc = np.array([(r0 + r1) / 2.0, (c0 + c1) / 2.0])\n            cols = [others[0][1], others[1][1]]\n            cents = []\n            for col in cols:\n                pts_col = np.array([(r, c) for r, c in pts if int(g[r, c]) == col], dtype=float)\n                cents.append((np.sum((pts_col.mean(axis=0) - rc) ** 2), col))\n            cents.sort()\n            center_col = cents[0][1]\n            indicator_col = cents[1][1]\n        else:\n            indicator_col = others[0][1]\n            center_col = others[-1][1]\n\n        center = [(r, c) for r, c in pts if int(g[r, c]) == center_col]\n        indic = [(r, c) for r, c in pts if int(g[r, c]) == indicator_col]\n        if not center or not indic:\n            continue\n\n        cc = np.mean(np.array(center, dtype=float), axis=0)\n        ci = np.mean(np.array(indic, dtype=float), axis=0)\n        vr, vc = (ci - cc).tolist()\n        dr = 0 if abs(vr) < 1e-6 else (1 if vr > 0 else -1)\n        dc = 0 if abs(vc) < 1e-6 else (1 if vc > 0 else -1)\n        if dr == 0 and dc == 0:\n            continue\n\n        prev = best.get(bg_col)\n        if prev is None or len(pts) > prev[0]:\n            best[bg_col] = (len(pts), (dr, dc))\n\n    return {k: v for k, (_, v) in best.items()}\n\n\ndef _slide_points(region_set: set[tuple[int, int]], points: list[tuple[int, int]], dr: int, dc: int) -> list[tuple[int, int]]:\n    if not points:\n        return []\n    # Process from the far end (closest to destination boundary) inward.\n    points_sorted = sorted(points, key=lambda p: (dr * p[0] + dc * p[1], p[0], p[1]), reverse=True)\n    occupied = set()\n    out_pts = []\n    for r0, c0 in points_sorted:\n        r, c = r0, c0\n        while True:\n            nr, nc = r + dr, c + dc\n            if (nr, nc) not in region_set:\n                break\n            # For diagonal steps, disallow \"corner cutting\": both orthogonal intermediates must be inside the region.\n            if dr != 0 and dc != 0:\n                if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n                    break\n            if (nr, nc) in occupied:\n                break\n            r, c = nr, nc\n        occupied.add((r, c))\n        out_pts.append((r, c))\n    return out_pts\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n","exit_code":0,"status":"completed"}}
