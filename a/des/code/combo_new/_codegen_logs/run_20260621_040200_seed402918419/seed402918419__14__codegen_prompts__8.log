{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/825aa9e9.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the moving-color objects downward until they rest above a one-row cushion before the obstacle or bottom edge.\n\n    Input structure:\n    - The grid has exactly three colors: empty background, a stationary obstacle/floor color, and a moving object color.\n    - The obstacle color is the unique non-background role that touches the bottom edge.\n    - Moving pixels start outside the obstacle cells, outside the row directly above each obstacle pixel, and outside the bottom row.\n\n    Rule:\n    - Keep the background and obstacle pixels fixed.\n    - Treat obstacle pixels, cells directly above obstacle pixels, and the bottom row as blocked.\n    - Repeatedly move every 4-connected moving-color object one row down when its translated shape does not hit blocked cells or another moving object.\n\n    Key insight: The visible floor has an invisible one-row cushion above it, so the objects fall under gravity but stop with one empty row before the floor or the grid bottom.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg, obstacle, moving = _infer_roles(g)\n    _assert_obstacle_profile(g, obstacle)\n    blocked = _blocked_mask(g, obstacle)\n    assert not np.any(blocked & (g == moving)), \"moving pixels must start in free cells\"\n\n    out = g.copy()\n    while True:\n        moves = _movable_components(out, bg, moving, blocked)\n        if not moves:\n            break\n        for coords, _ in moves:\n            out[coords[:, 0], coords[:, 1]] = bg\n        for _, shifted in moves:\n            out[shifted[:, 0], shifted[:, 1]] = moving\n\n    _assert_output_separated(out, obstacle, moving)\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nGRID_H_RANGE = (4, 10)\nGRID_W_RANGE = (7, 20)\n\n# Obstacle profile constraints.\nOBSTACLE_COVERAGE_RANGE = (0.08, 0.52)\nPOCKET_COUNT_RANGE = (1, 5)\nDISTINCT_HEIGHT_COUNT_RANGE = (2, 4)\nOBSTACLE_COMPONENT_RANGE = (1, 3)\nBOTTOM_BAND_ROWS = 3\nBOTTOM_COLS_MIN_MULTIPLIER = 3\nCOLUMN_AVG_MAX_NUM = 13\nCOLUMN_AVG_MAX_DEN = 4\nBOTTOM3_MIN_NUM = 3\nBOTTOM3_MIN_DEN = 5\n\n# Bottom-heavy profile sampling.\nPROFILE_RETRIES = 120\nBOTTOM_HEAVY_WEIGHT = 5\nLOW_COLUMN_EXTRA_PROB = 0.35\nLOW_COLUMN_HEIGHT2_PROB = 0.25\nTALL_RUN_COUNT_MAX = 3\nTALL_RUN_WIDTH2_MIN_W = 10\nTALL_RUN_WIDTH2_PROB = 0.25\nMEDIUM_RUN_PROB = 0.45\nMEDIUM_RUN_WIDTH_MAX = 4\nSHORT_OBSTACLE_MAX_H = 4\nMEDIUM_RUN_HEIGHT_MIN = 2\n\n# Sparse post profile sampling.\nWIDTH_PLACEMENT_RETRIES = 80\nSPARSE_POST_MIN_BOTTOM_FRAC = 3\nSPARSE_POST_MAX_BOTTOM_FRAC = 0.45\nSPARSE_POST_RUN_COUNT_MAX = 3\nSPARSE_POST_HEIGHT1_PROB = 0.8\n\n# Moving object sampling and validation.\nPALETTE_SIZE = 10\nOBJECT_COUNT_RANGE = (1, 3)\nOBJECT_AREA_RANGE = (1, 21)\nOBJECT_BBOX_MAX_H = 6\nOBJECT_BBOX_MAX_W = 7\nMIN_LIFT_ROWS = 1\nMAX_LIFT_ROWS = 4\n\n# Whole-input retry budget.\nGENERATE_RETRIES = 300\n\n\ndef _spread_extra(widths, extra):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/2b83f449.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Simulate tokens falling through a pipe network after gates rotate open.\n\n    Input structure:\n    - Wall (0), bg (pipe fill), gate (horizontal 1×3 bars), token (small edge pixels).\n\n    Rule:\n    - Rotate each gate into a vertical blocker; gate cells become bg.\n    - Tokens drop downward through bg, choosing the extreme column for their side (left→min, right→max).\n    - Tokens settle at true pipe ends (adjacent to wall/boundary), packing inward.\n\n    Key insight: Tokens select drop columns by entry side and land at wall-bounded endpoints, ignoring blocker-bounded ones.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    colors = set(map(int, g.flatten()))\n\n    # --- infer gate color: any color forming 4-ccs of size 3 with bbox 1x3 (horizontal) ---\n    gate = None\n    for col in sorted(colors):\n        if int(col) == 0:\n            continue\n        lab, n = label_mask(g == int(col), connectivity=4)\n        found = False\n        for k in range(1, int(n) + 1):\n            pts = np.argwhere(lab == int(k))\n            if int(pts.shape[0]) != 3:\n                continue\n            r0, c0 = pts.min(axis=0)\n            r1, c1 = pts.max(axis=0)\n            if int(r1 - r0 + 1) == 1 and int(c1 - c0 + 1) == 3:\n                found = True\n                break\n        if found:\n            gate = int(col)\n            break\n    assert not (gate is None)\n\n    # --- token/bg inference ---\n    cnt_all = Counter(map(int, g.flatten()))\n    cand_token = [c for c in colors if int(c) not in (0, int(gate))]\n    assert not (not cand_token)\n    token = int(min(cand_token, key=lambda c: (int(cnt_all[int(c)]), int(c))))\n    cand_bg = [c for c in colors if int(c) not in (0, int(gate), int(token))]\n    assert cand_bg\n    bg = int(max(cand_bg, key=lambda c: (int(cnt_all[int(c)]), -int(c))))\n\n    # --- opened gate color (vertical post) ---\n    open_col = 6 if int(gate) == 7 and 6 not in colors else int(gate - 1) if int(gate) > 0 else 6\n\n    # --- rotate gates (gates open into bg, center becomes vertical open_col) ---\n    out = g.copy()\n    lab, n = label_mask(out == int(gate), connectivity=4)\n    for k in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(k))\n        if int(pts.shape[0]) != 3:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        if int(r1 - r0 + 1) != 1 or int(c1 - c0 + 1) != 3:\n            continue\n        r = int(r0)\n        c0 = int(c0)\n        center_c = int(c0 + 1)\n        out[int(r), int(c0) : int(c0) + 3] = int(bg)\n        for rr in (int(r - 1), int(r), int(r + 1)):\n            if 0 <= int(rr) < H:\n                out[int(rr), int(center_c)] = int(open_col)\n\n    # helpers\n    def segments_in_row(r: int) -> list[tuple[int, int]]:\n        segs: list[tuple[int, int]] = []\n        c = 0\n        while c < W:\n            if int(out[r, c]) != int(bg):\n                c += 1; continue\n            c0 = c\n            while c + 1 < W and int(out[r, c + 1]) == int(bg):\n                c += 1\n            segs.append((c0, c)); c += 1\n        return segs\n\n    def find_seg(segs: list[tuple[int, int]], c: int) -> tuple[int, int] | None:\n        for a, b in segs:\n            if a <= c <= b: return (a, b)\n        return None\n\n    def seg_exit(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single exit column, or None. Assert if >1 exit.\"\"\"\n        a, b = seg\n        if r + 2 >= H: return None\n        drops = [c for c in range(a, b + 1)\n                 if int(out[r + 1, c]) == int(bg) and int(out[r + 2, c]) == int(bg)]\n        assert len(drops) <= 1, f\"segment ({a},{b}) at row {r} has {len(drops)} exits: {drops}\"\n        return drops[0] if drops else None\n\n    def entry_from_above(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single entry column from the wall above, or None. Assert if >1.\"\"\"\n        a, b = seg\n        if r < 2: return None\n        entries = [c for c in range(a, b + 1)\n                   if int(out[r - 1, c]) == int(bg) and int(out[r - 2, c]) == int(bg)]\n        assert len(entries) <= 1, f\"segment ({a},{b}) at row {r} has {len(entries)} entries from above: {entries}\"\n        return entries[0] if entries else None\n\n    # Remove tokens; simulate; re-place.\n    token_pts = [(int(r), int(c)) for r, c in np.argwhere(out == int(token))]\n    out[out == int(token)] = int(bg)\n\n    # Phase 1: each token drops through single exits until stuck.\n    finals: list[tuple[int, int]] = []  # (row, col) of final position\n    for r, c in token_pts:\n        cur_r, cur_c = r, c\n        if int(out[cur_r, cur_c]) != int(bg):\n            finals.append((cur_r, cur_c)); continue\n        while True:\n            seg = find_seg(segments_in_row(cur_r), cur_c)\n            if seg is None: break\n            ex = seg_exit(cur_r, seg)\n            if ex is None: break\n            cur_r += 2; cur_c = ex\n            if cur_r >= H: break\n        finals.append((cur_r, cur_c))\n\n    # Phase 2: pack tokens at opposite end from entry.\n    buckets: dict[tuple[int, tuple[int, int], int], int] = defaultdict(int)\n    for r, c in finals:\n        segs = segments_in_row(r)\n        seg = find_seg(segs, c)\n        if seg is None: continue\n        a, b = seg\n        entry = entry_from_above(r, seg)\n        if entry is not None:\n            # Pack to opposite end from entry\n            pack_end = b if (entry - a) <= (b - entry) else a\n        else:\n            # No entry from above: token at starting position (grid edge), stay put\n            pack_end = a if c <= a else b\n        buckets[(r, seg, pack_end)] += 1\n\n    for (r, (a, b), pack_end), k in buckets.items():\n        if pack_end == a:\n            for i in range(k):\n                if a + i <= b: out[r, a + i] = int(token)\n        else:\n            for i in range(k):\n                if b - i >= a: out[r, b - i] = int(token)\n\n    return out\n\n# --------------- generator (Codex, output-first with spine) ---------------\n\nWALL = 0\nTOKEN = 3\nOPEN = 6\nGATE = 7\nBG = 8\n\n\ndef _build_opened_grid(gates: list[list[int]], holes: list[list[int]], width: int) -> np.ndarray:\n","exit_code":0,"status":"completed"}}
