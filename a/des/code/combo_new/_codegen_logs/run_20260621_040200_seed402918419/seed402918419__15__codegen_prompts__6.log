{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/eval/800d221b.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor a path-network by adjacent seed regions.\n\n    Input structure:\n    - bg = most common color.\n    - Path color P forms a thin orthogonal network with a solid square hub (NxN).\n    - Seed colors appear in colored regions (non-bg, non-P) adjacent to path branches.\n\n    Rule:\n    - Infer P as the non-bg color whose largest component is most network-like.\n    - Find the largest solid k×k all-P square (the hub); exclude it from recoloring.\n    - Recolor each path branch to the seed-region color it touches most.\n    - Recolor the hub center pixel to the seed whose branches touch the hub most.\n\n    Key insight: The hub stays uncolored; branches inherit color from adjacent seed regions by adjacency count.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    colors = sorted({int(x) for x in np.unique(g)} - {int(bg)})\n    assert not (not colors)\n\n    def comp_deg_score(mask: np.ndarray) -> float:\n        comps = components_mask(mask, connectivity=4)\n        if not comps:\n            return -1e9\n        best_pts = max(comps, key=lambda coords: int(coords.shape[0]))\n        best_sz = int(best_pts.shape[0])\n\n        m = np.zeros(mask.shape, dtype=bool)\n        m[best_pts[:, 0], best_pts[:, 1]] = True\n\n        deg2 = 0\n        deg4 = 0\n        for r, c in best_pts:\n            r = int(r)\n            c = int(c)\n            d = 0\n            if r > 0 and bool(m[r - 1, c]):\n                d += 1\n            if r + 1 < H and bool(m[r + 1, c]):\n                d += 1\n            if c > 0 and bool(m[r, c - 1]):\n                d += 1\n            if c + 1 < W and bool(m[r, c + 1]):\n                d += 1\n            if d == 2:\n                deg2 += 1\n            elif d == 4:\n                deg4 += 1\n        frac2 = deg2 / max(1, best_sz)\n        frac4 = deg4 / max(1, best_sz)\n        return float((frac2 - frac4) * best_sz)\n\n    P = int(max(colors, key=lambda c: comp_deg_score(g == int(c))))\n\n    # --- hub: largest solid k×k all-P square anywhere ---\n    mP = g == int(P)\n    ps = mP.astype(int).cumsum(axis=0).cumsum(axis=1)\n\n    def rect_sum(r0: int, c0: int, r1: int, c1: int) -> int:\n        s = int(ps[int(r1), int(c1)])\n        if r0 > 0:\n            s -= int(ps[int(r0 - 1), int(c1)])\n        if c0 > 0:\n            s -= int(ps[int(r1), int(c0 - 1)])\n        if r0 > 0 and c0 > 0:\n            s += int(ps[int(r0 - 1), int(c0 - 1)])\n        return int(s)\n\n    best = None  # (k, r0, c0)\n    max_k = int(min(H, W))\n    for k in range(2, max_k + 1):\n        found = None\n        for r0 in range(0, int(H - k + 1)):\n            r1 = int(r0 + k - 1)\n            for c0 in range(0, int(W - k + 1)):\n                c1 = int(c0 + k - 1)\n                if rect_sum(int(r0), int(c0), int(r1), int(c1)) == int(k * k):\n                    found = (int(k), int(r0), int(c0))\n        if found is not None:\n            best = found\n\n    assert not (best is None)\n\n    k, r0, c0 = map(int, best)\n    r1, c1 = int(r0 + k - 1), int(c0 + k - 1)\n    hub = np.zeros((H, W), dtype=bool)\n    hub[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = True\n\n    # --- seed regions (non-bg, non-P) ---\n    seed_mask = (g != int(bg)) & (g != int(P))\n    seed_lab, seed_n = label_mask(seed_mask, connectivity=4)\n    seed_major: dict[int, int] = {}\n    all_seed_vals: list[int] = []\n    for sid in range(1, int(seed_n) + 1):\n        pts = np.argwhere(seed_lab == int(sid))\n        rn, rx = int(pts[:, 0].min()), int(pts[:, 0].max())\n        cn, cx = int(pts[:, 1].min()), int(pts[:, 1].max())\n        if rn > 0:\n            assert all(int(g[rn - 1, c]) == int(P) for c in range(cn, cx + 1)), \"seed missing top P border\"\n        if rx < H - 1:\n            assert all(int(g[rx + 1, c]) == int(P) for c in range(cn, cx + 1)), \"seed missing bot P border\"\n        if cn > 0:\n            assert all(int(g[r, cn - 1]) == int(P) for r in range(rn, rx + 1)), \"seed missing left P border\"\n        if cx < W - 1:\n            assert all(int(g[r, cx + 1]) == int(P) for r in range(rn, rx + 1)), \"seed missing right P border\"\n        vals = [int(g[int(r), int(c)]) for r, c in pts]\n        maj = int(Counter(vals).most_common(1)[0][0])\n        seed_major[int(sid)] = int(maj)\n        all_seed_vals.extend(vals)\n\n    out = g.copy()\n\n    # --- recolor each path branch by the seed region it touches most ---\n    branch_mask = (g == int(P)) & (~hub)\n    branch_lab, branch_n = label_mask(branch_mask, connectivity=4)\n\n    pmask = g == int(P)\n    ppad = np.pad(pmask, 1)\n    p_deg = ppad[2:, 1:-1].astype(int) + ppad[:-2, 1:-1] + ppad[1:-1, 2:] + ppad[1:-1, :-2]\n    spad = np.pad(seed_lab > 0, 1)\n    adj_seed = spad[2:, 1:-1] | spad[:-2, 1:-1] | spad[1:-1, 2:] | spad[1:-1, :-2]\n    assert not np.any((p_deg > 2) & pmask & ~hub & ~adj_seed), \"path has T-junction\"\n\n    for bid in range(1, int(branch_n) + 1):\n        pts = np.argwhere(branch_lab == int(bid))\n        touches = Counter()\n        for r, c in pts:\n            r = int(r)\n            c = int(c)\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr, cc = int(r + dr), int(c + dc)\n                if 0 <= rr < H and 0 <= cc < W:\n                    sid = int(seed_lab[rr, cc])\n                    if sid != 0:\n                        touches[int(sid)] += 1\n        if not touches:\n            continue\n        sid = int(touches.most_common(1)[0][0])\n        col = int(seed_major[int(sid)])\n        for r, c in pts:\n            out[int(r), int(c)] = int(col)\n\n    # --- hub center pixel recolor ---\n    touch_cols = Counter()\n    if int(branch_n) > 0:\n        for r in range(H):\n            for c in range(W):\n                if not bool(hub[int(r), int(c)]):\n                    continue\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    rr, cc = int(r + dr), int(c + dc)\n                    if 0 <= rr < H and 0 <= cc < W:\n                        if int(branch_lab[rr, cc]) != 0:\n                            touch_cols[int(out[rr, cc])] += 1\n\n    cr = int(r0 + k // 2)\n    cc = int(c0 + k // 2)\n\n    assert touch_cols, 'hub must be touched by at least one recolored branch'\n    assert all_seed_vals, 'grid must contain seed regions'\n    center_col = int(touch_cols.most_common(1)[0][0])\n    out[int(cr), int(cc)] = int(center_col)\n\n    return out\n\n# --------------- generator (attempt_1) ---------------\n\nimport random\n\n# ── Tunable generation parameters ──────────────────────────────────────────\n# Canvas / grid\nGRID_SIZE_BASE = 10          # base grid dimension before seed-count scaling\nGRID_SIZE_PER_SEED = 3       # extra min-dimension per seed beyond 3\nGRID_SIZE_MIN = 12           # absolute minimum grid dimension\nGRID_SIZE_MAX = 30           # maximum grid dimension\n\n# Hub\nHUB_SIZE = 3                 # hub is HUB_SIZE x HUB_SIZE solid square\n\n# Seed regions\nSEED_COUNT_CHOICES = [3, 4, 5]\nSEED_INTERIOR_MIN = 2        # min interior width/height\nSEED_INTERIOR_MAX = 4        # max interior width/height\nMINORITY_FRAC_LO = 0.06      # min minority color fraction in seed interior\nMINORITY_FRAC_HI = 0.40      # max minority color fraction in seed interior\nSEED_PLACEMENT_RETRIES = 400 # max attempts to place all seeds\nSEED_ZONE_GAP = 1            # min separation between seed border zones\n\n# Path carving\nMAX_BENDS = 6                # max L-bends per path\nSEGMENT_LEN_MIN = 1          # min segment length before a bend\nSEGMENT_LEN_MAX = 6          # max segment length before a bend\nMAX_PATHS_PER_SEED = 3       # cap on paths connecting one seed to hub\nPATH_FIRST_ROUND_RETRIES = 60   # retries for first mandatory path per seed\nPATH_EXTRA_ROUND_RETRIES = 30   # retries per extra path attempt\nPATH_DIR_RETRIES = 3         # attempts per initial direction in carve\n\n# Top-level generation\nGEN_OUTER_RETRIES = 300      # max _gen_attempt calls in generate_input\n\n_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n# ── Path carving ───────────────────────────────────────────────────────────\n\ndef _try_carve_path(canvas, P, start, dest_border_cells, max_bends=MAX_BENDS):\n    \"\"\"Carve a single 1-pixel-wide orthogonal path from hub `start` toward `dest_border_cells`.\n\n    Works on a \"work canvas\" where 0 = free, P = path/hub, other = seed.\n    Returns list of placed (r, c) cells, or None on failure.\n    Mutates `canvas` in-place (cleans up on failure).\n    \"\"\"\n    H, W = canvas.shape\n    dest_set = set(dest_border_cells)\n\n    def _check_neighbors(r, c, prev, allow_dest):\n        \"\"\"Check all 4-neighbors for T-junction violations.\n\n        Returns True if placing a path cell at (r,c) is safe.\n        Cell must be in-bounds and free (canvas == 0).\n        \"\"\"\n        if not (0 <= r < H and 0 <= c < W) or canvas[r, c] != 0:\n            return False\n        for dr, dc in _DIRS:\n            nr, nc = r + dr, c + dc\n            if not (0 <= nr < H and 0 <= nc < W):\n                continue\n            if (nr, nc) == prev or (nr, nc) == start:\n                continue\n            v = canvas[nr, nc]\n            if v == P:\n                if allow_dest and (nr, nc) in dest_set:\n                    continue\n                return False\n            if v != 0:\n                return False\n        return True\n\n    # Initial directions: those leading from hub perimeter into a free cell\n    sr, sc = start\n    init_dirs = []\n    for dr, dc in _DIRS:\n        nr, nc = sr + dr, sc + dc\n        if 0 <= nr < H and 0 <= nc < W and canvas[nr, nc] == 0:\n            init_dirs.append((dr, dc))\n    if not init_dirs:\n        return None\n    random.shuffle(init_dirs)\n\n    n_bends = random.randint(0, max_bends)\n\n    def _attempt(initial_dir):\n        path = []\n        cur = start\n        cur_dir = initial_dir\n        for seg_i in range(n_bends + 1):\n            is_last = (seg_i == n_bends)\n            max_steps = max(H, W) if is_last else random.randint(SEGMENT_LEN_MIN, SEGMENT_LEN_MAX)\n            blocked = False\n            for _ in range(max_steps):\n                nr, nc = cur[0] + cur_dir[0], cur[1] + cur_dir[1]\n                # Check if this is a valid landing cell (adjacent to dest first -- fast reject)\n                if (any((nr + dr, nc + dc) in dest_set for dr, dc in _DIRS)\n                        and _check_neighbors(nr, nc, cur, allow_dest=True)):\n                    canvas[nr, nc] = P\n                    path.append((nr, nc))\n                    return path\n                if _check_neighbors(nr, nc, cur, allow_dest=False):\n                    canvas[nr, nc] = P\n                    path.append((nr, nc))\n                    cur = (nr, nc)\n                else:\n                    blocked = True\n                    break\n            if blocked or is_last:\n                # Failed: blocked mid-segment or didn't reach dest on last segment\n                for r, c in path:\n                    canvas[r, c] = 0\n                return None\n            # Bend perpendicular for next segment\n            perps = [(-cur_dir[1], cur_dir[0]), (cur_dir[1], -cur_dir[0])]\n            random.shuffle(perps)\n            cur_dir = perps[0]\n        for r, c in path:\n            canvas[r, c] = 0\n        return None\n\n    for d in init_dirs:\n        for _ in range(PATH_DIR_RETRIES):\n            res = _attempt(d)\n            if res is not None:\n                return res\n    return None\n\n\n# ── Seed placement ─────────────────────────────────────────────────────────\n\ndef _compute_seed_zone(edge, ir0, ic0, ir1, ic1, H, W):\n    \"\"\"Compute the border zone bbox (including P frame) for a seed on `edge`.\"\"\"\n    if edge == 'top':\n        return (ir0, max(0, ic0 - 1), ir1 + 1, min(W - 1, ic1 + 1))\n    elif edge == 'bottom':\n        return (max(0, ir0 - 1), max(0, ic0 - 1), ir1, min(W - 1, ic1 + 1))\n    elif edge == 'left':\n        return (max(0, ir0 - 1), ic0, min(H - 1, ir1 + 1), ic1 + 1)\n    else:  # right\n        return (max(0, ir0 - 1), max(0, ic0 - 1), min(H - 1, ir1 + 1), ic1)\n\n\ndef _place_seed_border(work, P, ir0, ic0, ir1, ic1, H, W):\n    \"\"\"Place P border around seed interior on non-grid-edge sides.\n\n    Returns (border_cells, landing_cells).\n    Landing cells are non-corner border cells adjacent to the interior -- valid\n    path attachment points.\n    \"\"\"\n    border_cells = []\n    landing_cells = []\n    # Side borders (landing-eligible)\n    for cond, cells in [\n        (ir0 > 0,     [(ir0 - 1, c) for c in range(ic0, ic1 + 1)]),\n        (ir1 < H - 1, [(ir1 + 1, c) for c in range(ic0, ic1 + 1)]),\n        (ic0 > 0,     [(r, ic0 - 1) for r in range(ir0, ir1 + 1)]),\n        (ic1 < W - 1, [(r, ic1 + 1) for r in range(ir0, ir1 + 1)]),\n    ]:\n        if cond:\n            for r, c in cells:\n                work[r, c] = P\n                border_cells.append((r, c))\n                landing_cells.append((r, c))\n    # Corner pieces (NOT landing-eligible)\n    for cond, rc in [\n        (ir0 > 0 and ic0 > 0,         (ir0 - 1, ic0 - 1)),\n        (ir0 > 0 and ic1 < W - 1,     (ir0 - 1, ic1 + 1)),\n        (ir1 < H - 1 and ic0 > 0,     (ir1 + 1, ic0 - 1)),\n        (ir1 < H - 1 and ic1 < W - 1, (ir1 + 1, ic1 + 1)),\n    ]:\n        if cond:\n            work[rc[0], rc[1]] = P\n            border_cells.append(rc)\n    return border_cells, landing_cells\n\n\ndef _zones_overlap(zone, others, gap):\n    \"\"\"Check if `zone` overlaps or is within `gap` of any zone in `others`.\"\"\"\n    r0, c0, r1, c1 = zone\n    for or0, oc0, or1, oc1 in others:\n        if r0 - gap <= or1 and or0 - gap <= r1 and c0 - gap <= oc1 and oc0 - gap <= c1:\n            return True\n    return False\n\n\ndef _pick_seed_interior(edge, H, W):\n    \"\"\"Pick random interior bbox (ir0, ic0, ir1, ic1) for a seed touching `edge`.\"\"\"\n    ih = random.randint(SEED_INTERIOR_MIN, SEED_INTERIOR_MAX)\n    iw = random.randint(SEED_INTERIOR_MIN, SEED_INTERIOR_MAX)\n    if edge == 'top':\n        ir0, ic0 = 0, random.randint(0, W - iw)\n    elif edge == 'bottom':\n        ir0, ic0 = H - ih, random.randint(0, W - iw)\n    elif edge == 'left':\n        ir0, ic0 = random.randint(0, H - ih), 0\n    else:  # right\n        ir0, ic0 = random.randint(0, H - ih), W - iw\n    return ir0, ic0, ir0 + ih - 1, ic0 + iw - 1\n\n\ndef _fill_seed_interior(work, seed_id_grid, ir0, ic0, ir1, ic1, majority, minority, sid):\n    \"\"\"Fill seed interior cells with majority/minority mix.\"\"\"\n    interior_cells = [(r, c) for r in range(ir0, ir1 + 1) for c in range(ic0, ic1 + 1)]\n    n_int = len(interior_cells)\n    min_minor = max(1, int(n_int * MINORITY_FRAC_LO))\n    max_minor = max(min_minor, int(n_int * MINORITY_FRAC_HI))\n    n_minor = random.randint(min_minor, max_minor)\n    # Ensure majority strictly larger\n    if n_minor >= n_int - n_minor:\n        n_minor = max(1, (n_int - 1) // 2)\n    random.shuffle(interior_cells)\n    for r, c in interior_cells[:n_minor]:\n        work[r, c] = minority\n        seed_id_grid[r, c] = sid\n    for r, c in interior_cells[n_minor:]:\n        work[r, c] = majority\n        seed_id_grid[r, c] = sid\n\n\n# ── Path orchestration ─────────────────────────────────────────────────────\n\ndef _carve_all_paths(work, P, hub_perimeter, seeds):\n    \"\"\"Carve paths from hub perimeter to each seed. Returns True on success.\"\"\"\n    used_hub_starts = set()\n    paths_per_seed = {i: 0 for i in range(len(seeds))}\n\n    # Round 1: one mandatory path per seed\n    seed_order = list(range(len(seeds)))\n    random.shuffle(seed_order)\n    for si in seed_order:\n        ok = False\n        for _ in range(PATH_FIRST_ROUND_RETRIES):\n            avail = [s for s in hub_perimeter if s not in used_hub_starts]\n            if not avail:\n                break\n            start = random.choice(avail)\n            path = _try_carve_path(work, P, start, seeds[si]['landing_cells'])\n            if path is not None:\n                used_hub_starts.add(start)\n                paths_per_seed[si] += 1\n                ok = True\n                break\n        if not ok:\n            return False\n\n    # Extra rounds: add more paths per seed (up to MAX_PATHS_PER_SEED)\n    extra_target = sum(random.randint(0, 2) for _ in seeds)\n    for _ in range(extra_target * 2):\n        if len(used_hub_starts) >= len(hub_perimeter):\n            break\n        candidates = [si for si in range(len(seeds)) if paths_per_seed[si] < MAX_PATHS_PER_SEED]\n        if not candidates:\n            break\n        si = random.choice(candidates)\n        for _ in range(PATH_EXTRA_ROUND_RETRIES):\n            avail = [s for s in hub_perimeter if s not in used_hub_starts]\n            if not avail:\n                break\n            start = random.choice(avail)\n            path = _try_carve_path(work, P, start, seeds[si]['landing_cells'])\n            if path is not None:\n                used_hub_starts.add(start)\n                paths_per_seed[si] += 1\n                break\n    return True\n\n\n# ── Main generation attempt ────────────────────────────────────────────────\n\ndef _gen_attempt():\n    n_seeds_target = random.choice(SEED_COUNT_CHOICES)\n    size_lo = max(GRID_SIZE_MIN, GRID_SIZE_BASE + GRID_SIZE_PER_SEED * (n_seeds_target - 3))\n    H = random.randint(size_lo, GRID_SIZE_MAX)\n    W = random.randint(size_lo, GRID_SIZE_MAX)\n    bg, P, A, B = random.sample(list(range(10)), 4)\n\n    g = np.full((H, W), bg, dtype=int)\n\n    # Place hub near center (middle third)\n    hr0 = random.randint(max(2, H // 3 - 1), min(H - 5, 2 * H // 3 - 2))\n    hc0 = random.randint(max(2, W // 3 - 1), min(W - 5, 2 * W // 3 - 2))\n    g[hr0:hr0 + HUB_SIZE, hc0:hc0 + HUB_SIZE] = P\n\n    # Hub perimeter = all cells on the border of the HUB_SIZE x HUB_SIZE square\n    hub_perimeter = [(r, c) for r in range(hr0, hr0 + HUB_SIZE)\n                     for c in range(hc0, hc0 + HUB_SIZE)\n                     if r in (hr0, hr0 + HUB_SIZE - 1) or c in (hc0, hc0 + HUB_SIZE - 1)]\n\n    # Working canvas: 0 = free bg, P = path/hub, other = seed color\n    work = np.where(g == bg, 0, g).astype(int)\n    seed_id_grid = np.zeros((H, W), dtype=int)\n    seeds = []\n    used_zones = []\n    edges = ['top', 'bottom', 'left', 'right']\n\n    def _overlaps_hub(zone):\n        r0, c0, r1, c1 = zone\n        return not (r1 < hr0 - 1 or r0 > hr0 + HUB_SIZE or c1 < hc0 - 1 or c0 > hc0 + HUB_SIZE)\n\n    # ── Place seeds ──\n    for _ in range(SEED_PLACEMENT_RETRIES):\n        if len(seeds) >= n_seeds_target:\n            break\n        edge = random.choice(edges)\n        ir0, ic0, ir1, ic1 = _pick_seed_interior(edge, H, W)\n        border_zone = _compute_seed_zone(edge, ir0, ic0, ir1, ic1, H, W)\n\n        if _overlaps_hub(border_zone):\n            continue\n        if _zones_overlap(border_zone, used_zones, gap=SEED_ZONE_GAP):\n            continue\n\n        majority = random.choice([A, B])\n        minority = B if majority == A else A\n        sid = len(seeds) + 1\n        _fill_seed_interior(work, seed_id_grid, ir0, ic0, ir1, ic1, majority, minority, sid)\n        border_cells, landing_cells = _place_seed_border(work, P, ir0, ic0, ir1, ic1, H, W)\n\n        used_zones.append(border_zone)\n        seeds.append({\n            'id': sid, 'majority': majority, 'minority': minority,\n            'border_cells': border_cells, 'landing_cells': landing_cells,\n            'bbox': (ir0, ic0, ir1, ic1), 'border_zone': border_zone,\n        })\n\n    if len(seeds) < 3:\n        return None\n\n    # ── Carve paths ──\n    if not _carve_all_paths(work, P, hub_perimeter, seeds):\n        return None\n\n    # ── Finalize ──\n    inp = np.where(work == 0, bg, work).astype(int)\n    counts = Counter(int(x) for x in inp.flatten())\n    if counts.most_common(1)[0][0] != bg:\n        return None\n\n    try:\n        main(inp)\n    except Exception:\n        return None\n    return inp\n\n\ndef generate_input():\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n\n\ndef _bfs_placement(feasible, sr, sc):\n    h2, w2 = feasible.shape\n    dist = -np.ones((h2, w2), dtype=int)\n    dist[sr, sc] = 0\n    q = deque([(sr, sc)])\n    while q:\n        r, c = q.popleft()\n        for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:\n                dist[rr, cc] = dist[r, c] + 1\n                q.append((rr, cc))\n    return dist\n\n\ndef _hamiltonian_walk(rows, cols, start, end):\n    total = rows * cols\n    best_path = None\n    best_len = 0\n    for _attempt in range(80):\n        visited = {start}\n        path = [start]\n        cur = start\n        while True:\n            if cur == end and len(path) >= total * 0.7:\n                if len(path) > best_len:\n                    best_path = list(path)\n                    best_len = len(path)\n                break\n            neighbors = []\n            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                nr, nc = cur[0] + dr, cur[1] + dc\n                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:\n                    neighbors.append((nr, nc))\n            if not neighbors:\n                break\n            valid = []\n            for nb in neighbors:\n                if nb == end:\n                    valid.append(nb)\n                    continue\n                test_visited = visited | {nb}\n                seen = {end}\n                q = deque([end])\n                while q:\n                    cr, cc = q.popleft()\n                    for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                        nr2, nc2 = cr + dr2, cc + dc2\n                        if (0 <= nr2 < rows and 0 <= nc2 < cols and\n                                (nr2, nc2) not in test_visited and (nr2, nc2) not in seen):\n                            seen.add((nr2, nc2))\n                            q.append((nr2, nc2))\n                for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                    ar, ac = nb[0] + dr2, nb[1] + dc2\n                    if (0 <= ar < rows and 0 <= ac < cols and\n                            (ar, ac) not in test_visited and (ar, ac) in seen):\n                        valid.append(nb)\n                        break\n            if not valid:\n                break\n            random.shuffle(valid)\n            nxt = valid[0]\n            visited.add(nxt)\n            path.append(nxt)\n            cur = nxt\n        if best_path and best_len >= total * 0.85:\n            break\n    return best_path\n\n\ndef _render_channel(grid, path, n, offsets_r, offsets_c):\n    pixel_pos = []\n    for cr, cc in path:\n        pr, pc = offsets_r[cr], offsets_c[cc]\n        pixel_pos.append((pr, pc))\n        grid[pr:pr + n, pc:pc + n] = _RIVER\n    for i in range(len(path) - 1):\n        pr1, pc1 = pixel_pos[i]\n        pr2, pc2 = pixel_pos[i + 1]\n        if pr1 == pr2:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n            grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER\n        else:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n            grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER\n    return pixel_pos\n\n\ndef _add_chokepoint(grid, pixel_pos_i, pixel_pos_j, n, direction):\n    H, W = grid.shape\n    pr1, pc1 = pixel_pos_i\n    pr2, pc2 = pixel_pos_j\n    narrow_w = random.randint(1, n - 1)\n    remove = n - narrow_w\n    side = random.randint(0, 1)\n\n    if direction == 'h':\n        c_lo = min(pc1, pc2) + n\n        c_hi = max(pc1, pc2)\n        if c_hi <= c_lo:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        c_mid = (c_lo + c_hi) // 2\n        c_start = max(c_lo, c_mid - total_len // 2)\n        for step in range(total_len):\n            c = c_start + step\n            if c < 0 or c >= W:\n                continue\n            if step < remove:\n                depth = step + 1\n            elif step >= total_len - remove:\n                depth = total_len - step\n            else:\n                depth = remove\n            for k in range(depth):\n                rr = pr1 + k if side == 0 else pr1 + n - 1 - k\n                if 0 <= rr < H and 0 <= c < W:\n                    grid[rr, c] = _BG\n    else:\n        r_lo = min(pr1, pr2) + n\n        r_hi = max(pr1, pr2)\n        if r_hi <= r_lo:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        r_mid = (r_lo + r_hi) // 2\n        r_start = max(r_lo, r_mid - total_len // 2)\n        for step in range(total_len):\n            r = r_start + step\n            if r < 0 or r >= H:\n                continue\n            if step < remove:\n                depth = step + 1\n            elif step >= total_len - remove:\n                depth = total_len - step\n            else:\n                depth = remove\n            for k in range(depth):\n                cc = pc1 + k if side == 0 else pc1 + n - 1 - k\n                if 0 <= r < H and 0 <= cc < W:\n                    grid[r, cc] = _BG\n\n\ndef _river_connected(grid):\n    mask = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)\n    if not mask.any():\n        return False\n    labeled, num = scipy_label(mask.astype(int))\n    return num == 1\n\n\ndef _compute_offsets(G, n, num_coarse):\n    if num_coarse == 1:\n        return [1]\n    first = 1\n    last = G - n - 1\n    if last < first:\n        return None\n    step = (last - first) / (num_coarse - 1)\n    return [int(round(first + i * step)) for i in range(num_coarse)]\n\n\ndef _gen_attempt():\n    reached = random.random() < 0.5\n    n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])\n\n    min_size = max(10, 5 * n)\n    if min_size > 20:\n        return None\n    G = random.randint(min_size, 20)\n    H = W = G\n\n    min_spacing = n + 1\n    max_coarse = max(3, (G - 2) // min_spacing)\n    coarse_dim = random.randint(3, min(6, max_coarse))\n    coarse_rows = coarse_cols = coarse_dim\n\n    offsets_r = _compute_offsets(G, n, coarse_rows)\n    offsets_c = _compute_offsets(G, n, coarse_cols)\n    if offsets_r is None or offsets_c is None:\n        return None\n    for i in range(len(offsets_r) - 1):\n        if offsets_r[i + 1] - offsets_r[i] < n:\n            return None\n    for i in range(len(offsets_c) - 1):\n        if offsets_c[i + 1] - offsets_c[i] < n:\n            return None\n\n    edge_cells = set()\n    for c in range(coarse_cols):\n        edge_cells.add((0, c))\n        edge_cells.add((coarse_rows - 1, c))\n    for r in range(1, coarse_rows - 1):\n        edge_cells.add((r, 0))\n        edge_cells.add((r, coarse_cols - 1))\n    edge_cells = list(edge_cells)\n    random.shuffle(edge_cells)\n    start_coarse = edge_cells[0]\n    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))\n    end_coarse = far[0] if far[0] != start_coarse else far[1]\n\n    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)\n    if walk is None or len(walk) < 4:\n        return None\n    if len(set(cr for cr, _ in walk)) < coarse_rows or len(set(cc for _, cc in walk)) < coarse_cols:\n        return None\n\n    grid = np.full((H, W), _BG, dtype=int)\n    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)\n\n    mask = (grid != _BG)\n    if np.any(mask, axis=1).sum() / H < 0.70 or np.any(mask, axis=0).sum() / W < 0.70:\n        return None\n\n    mover_r, mover_c = pixel_pos[0]\n    dest_r, dest_c = pixel_pos[-1]\n\n    # Extend dest to touch grid edge\n    def _extend_to_edge(pr, pc):\n        candidates = []\n        for direction in ['top', 'bottom', 'left', 'right']:\n            if direction == 'top':\n                dist = pr\n                if dist == 0:\n                    candidates.append((0, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n) if c < W):\n                    candidates.append((0, pc, dist))\n            elif direction == 'bottom':\n                dist = H - (pr + n)\n                if dist == 0:\n                    candidates.append((pr, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n) if c < W):\n                    candidates.append((H - n, pc, dist))\n            elif direction == 'left':\n                dist = pc\n                if dist == 0:\n                    candidates.append((pr, 0, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc) if r < H):\n                    candidates.append((pr, 0, dist))\n            elif direction == 'right':\n                dist = W - (pc + n)\n                if dist == 0:\n                    candidates.append((pr, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W) if r < H):\n                    candidates.append((pr, W - n, dist))\n        if not candidates:\n            return None\n        candidates.sort(key=lambda x: x[2])\n        return candidates[0][:2]\n\n    result = _extend_to_edge(dest_r, dest_c)\n    if result is None:\n        return None\n    new_dest_r, new_dest_c = result\n    if new_dest_r != dest_r:\n        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n\n        grid[r_lo:r_hi, dest_c:dest_c + n] = _RIVER\n    if new_dest_c != dest_c:\n        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n\n        grid[dest_r:dest_r + n, c_lo:c_hi] = _RIVER\n    dest_r, dest_c = new_dest_r, new_dest_c\n    if not (dest_r == 0 or dest_r + n == H or dest_c == 0 or dest_c + n == W):\n        return None\n\n    # Mover: near edge but not touching\n    touching = (mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W)\n    if touching:\n        if mover_r == 0:\n            grid[0, mover_c:mover_c + n] = _RIVER; mover_r = 1\n        elif mover_r + n == H:\n            grid[H - 1, mover_c:mover_c + n] = _RIVER; mover_r = H - n - 1\n        elif mover_c == 0:\n            grid[mover_r:mover_r + n, 0] = _RIVER; mover_c = 1\n        elif mover_c + n == W:\n            grid[mover_r:mover_r + n, W - 1] = _RIVER; mover_c = W - n - 1\n    if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:\n        return None\n    if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:\n        return None\n\n    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\n    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _RIVER\n\n    # Chokepoints for stuck case\n    if not reached and n >= 2:\n        num_choke = random.randint(1, min(3, len(walk) - 2))\n        min_seg = max(1, len(walk) // 4)\n        available = list(range(min_seg, len(walk) - 1))\n        random.shuffle(available)\n        for seg_idx in available[:num_choke]:\n            pr1, pc1 = pixel_pos[seg_idx]\n            pr2, pc2 = pixel_pos[min(seg_idx + 1, len(pixel_pos) - 1)]\n            direction = 'h' if pr1 == pr2 else 'v'\n            _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)\n        if not _river_connected(grid):\n            return None\n\n    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _MOVER\n    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _DEST\n\n    trav = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)\n    h2, w2 = H - n + 1, W - n + 1\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if trav[r:r + n, c:c + n].all():\n                feasible[r, c] = True\n    if not feasible[mover_r, mover_c]:\n        return None\n\n    dist = _bfs_placement(feasible, mover_r, mover_c)\n    dest_ok = (0 <= dest_r < h2 and 0 <= dest_c < w2 and\n               feasible[dest_r, dest_c] and dist[dest_r, dest_c] >= 0)\n    if reached and not dest_ok:\n        return None\n    if not reached and dest_ok:\n        return None\n\n    if dest_ok:\n        tr, tc = dest_r, dest_c\n    else:\n        best_d = -1\n        tr, tc = mover_r, mover_c\n        for r in range(h2):\n            for c in range(w2):\n                if dist[r, c] > best_d:\n                    best_d = dist[r, c]\n                    tr, tc = r, c\n\n    output = grid.copy()\n    output[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\n    output[tr:tr + n, tc:tc + n] = _MOVER\n\n    if not np.array_equal(main(grid), output):\n        return None\n    return grid\n\n\ndef generate_input():\n","exit_code":0,"status":"completed"}}
