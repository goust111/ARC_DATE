{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/train/753ea09b.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the small background compartments bounded by the long contour color.\n\n    Input structure:\n    - The grid has one dominant background color and two foreground colors.\n    - The more frequent foreground color forms long 8-connected contour fragments.\n    - The other foreground color is a fixed distractor/obstacle color that partitions\n      the background but is never recolored.\n\n    Rule:\n    - Split the background into 4-connected regions using all foreground pixels as\n      barriers.\n    - Keep the two largest background regions as the outside of the contour drawing.\n    - Recolor every other background region that touches a long contour component\n      to the contour color; leave all foreground pixels unchanged.\n\n    Key insight:\n    The apparent area fill is exactly a component-level fill of bounded background\n    compartments, not a row-wise interpolation between individual contour pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    foreground = colors_present(g, exclude={bg})\n    assert len(foreground) == 2, \"expected exactly two foreground colors\"\n\n    fill_color = _unique_largest_color(g, foreground)\n    fill_lab, _n_fill = label_mask(g == fill_color, connectivity=8)\n    long_ids = _long_component_ids(fill_lab, _n_fill)\n\n    bg_lab, n_bg = label_mask(g == bg, connectivity=4)\n    exterior_ids = _two_exterior_bg_ids(bg_lab, n_bg)\n\n    out = g.copy()\n    for comp_id in range(1, n_bg + 1):\n        if comp_id in exterior_ids:\n            continue\n        coords = np.argwhere(bg_lab == comp_id)\n        if _touches_long_contour(coords, fill_lab, long_ids):\n            out[bg_lab == comp_id] = fill_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\nH, W = 30, 30\nGRID_SHAPE = (H, W)\nARC_COLOR_COUNT = 10\n\n# Long contour path layout.\nPATH_COUNT_OPTIONS = (2, 3)\nPATH_STEP_OPTIONS = (-1, 0, 1)\nPATH_GAP_MIN, PATH_GAP_MAX = 2, 5\nPATH_LEFT_MIN_COL, PATH_RIGHT_MARGIN = 2, 3\nPATH_START_MIN_COL = 3\nPATH_START_RIGHT_MARGIN = 4\nPATH_FAR_END_MIN_CHOICES, PATH_FAR_END_PROB, PATH_FAR_END_DELTA = 8, 0.7, 5\nPATH_SCORING_CANDIDATES = 5\nPATH_MIN_MOVES = 12\n\n# Contour distractors and extra contour pixels.\nOUTSIDE_MARGIN = 2\nOUTSIDE_SIDE_OPTIONS = (-1, 1)\nSHORT_FRAGMENT_COUNT_MIN, SHORT_FRAGMENT_COUNT_MAX = 3, 5\nSHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX = 1, 4\nSHORT_FRAGMENT_ATTEMPTS = 200\nSHORT_FRAGMENT_PATH_PADDING = 3\nCONTOUR_PIXELS_MIN, CONTOUR_PIXELS_MAX = 81, 108\n\n# Obstacle bars and scattered clusters.\nBAR_SEGMENT_MAX = 11\nSINGLE_CHANNEL_BARS_MIN, SINGLE_CHANNEL_BARS_MAX = 5, 11\nMULTI_CHANNEL_TOTAL_BARS_MIN, MULTI_CHANNEL_TOTAL_BARS_MAX = 4, 10\nMULTI_CHANNEL_INITIAL_BARS = 2\nMULTI_CHANNEL_MAX_BARS = 5\nBAR_WIDTH_MIN, BAR_WIDTH_MAX = 1, 5\nOBSTACLE_PIXELS_MIN, OBSTACLE_PIXELS_MAX = 36, 63\nOBSTACLE_EXTRA_PIXELS_MIN = 8\nOBSTACLE_OUTSIDE_QUOTA_MIN, OBSTACLE_OUTSIDE_QUOTA_MAX = 8, 16\nOBSTACLE_CLUSTER_SIZE_MIN, OBSTACLE_CLUSTER_SIZE_MAX = 1, 5\nOBSTACLE_ATTEMPTS = 300\nOBSTACLE_ZONE_OPTIONS = (\"outside\", \"inside\", \"any\")\n\n# Component validation.\nBG_REGIONS_MIN, BG_REGIONS_MAX = 8, 14\nEXTERIOR_REGION_COUNT = 2\nINTERIOR_REGIONS_MIN, INTERIOR_REGIONS_MAX = 6, 12\nINTERIOR_REGION_AREA_MAX = 57\nLONG_COMPONENT_MIN_SPAN = H // 3\nLONG_COMPONENT_COUNT_OPTIONS = (2, 3)\n\n# Retry limits and local neighborhoods.\nGENERATION_ATTEMPTS = 300\nNEIGHBOR_DELTAS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nNEIGHBOR_DELTAS_8 = NEIGHBOR_DELTAS_4 + ((-1, -1), (-1, 1), (1, -1), (1, 1))\n\n\ndef _color_choices() -> tuple[int, int, int]:\n    colors = list(range(ARC_COLOR_COUNT))\n    random.shuffle(colors)\n    return int(colors[0]), int(colors[1]), int(colors[2])\n\n\ndef _path_columns(path_count: int) -> list[list[int]] | None:\n    gaps = [random.randint(PATH_GAP_MIN, PATH_GAP_MAX) for _ in range(path_count - 1)]\n    total_width = sum(gap + 1 for gap in gaps)\n    start_hi = W - PATH_START_RIGHT_MARGIN - total_width\n    if start_hi < PATH_START_MIN_COL:\n        return None\n\n    start = random.randint(PATH_START_MIN_COL, start_hi)\n    end_choices = list(range(PATH_START_MIN_COL, start_hi + 1))\n    if len(end_choices) > PATH_FAR_END_MIN_CHOICES and random.random() < PATH_FAR_END_PROB:\n        far = [c for c in end_choices if abs(c - start) >= PATH_FAR_END_DELTA]\n        if far:\n            end_choices = far\n    end = random.choice(end_choices)\n\n    cols = [start]\n    for gap in gaps:\n        cols.append(cols[-1] + gap + 1)\n    targets = [c + (end - start) for c in cols]\n\n    paths = [[int(c)] for c in cols]\n    for r in range(1, H):\n        valid: list[list[int]] = []\n        for steps in itertools.product(PATH_STEP_OPTIONS, repeat=path_count):\n            nxt = [cols[i] + steps[i] for i in range(path_count)]\n            if nxt[0] < PATH_LEFT_MIN_COL or nxt[-1] > W - PATH_RIGHT_MARGIN:\n                continue\n            if all(PATH_GAP_MIN <= nxt[i + 1] - nxt[i] - 1 <= PATH_GAP_MAX for i in range(path_count - 1)):\n                valid.append(nxt)\n        if not valid:\n            return None\n        ideal = [paths[i][0] + (targets[i] - paths[i][0]) * r / (H - 1) for i in range(path_count)]\n        scored = sorted(\n            valid,\n            key=lambda nxt: sum(abs(nxt[i] - ideal[i]) for i in range(path_count)) + random.random(),\n        )\n        cols = random.choice(scored[: max(1, min(PATH_SCORING_CANDIDATES, len(scored)))])\n        for i, c in enumerate(cols):\n            paths[i].append(int(c))\n\n    moves = sum(paths[i][r] != paths[i][r - 1] for i in range(path_count) for r in range(1, H))\n    if moves < PATH_MIN_MOVES:\n        return None\n    return paths\n\n\ndef _outside_enclosure(paths: list[list[int]], r: int, c: int, margin: int = OUTSIDE_MARGIN) -> bool:\n    return c <= paths[0][r] - margin or c >= paths[-1][r] + margin\n\n\ndef _inside_channel(paths: list[list[int]], r: int, c: int) -> bool:\n    return any(paths[i][r] < c < paths[i + 1][r] for i in range(len(paths) - 1))\n\n\ndef _touches_mask(mask: np.ndarray, coords: list[tuple[int, int]], connectivity: int) -> bool:\n    seen = set(coords)\n    deltas = NEIGHBOR_DELTAS_8 if connectivity == 8 else NEIGHBOR_DELTAS_4\n    for r, c in coords:\n        for dr, dc in deltas:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in seen and mask[rr, cc]:\n                return True\n    return False\n\n\ndef _place_short_fragments(\n    grid: np.ndarray, contour_mask: np.ndarray, paths: list[list[int]], contour: int, count: int\n) -> bool:\n    for _ in range(count):\n        size = random.randint(SHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX)\n        placed = False\n        for _attempt in range(SHORT_FRAGMENT_ATTEMPTS):\n            r = random.randrange(H)\n            side = random.choice(OUTSIDE_SIDE_OPTIONS)\n            if side < 0:\n                hi = paths[0][r] - SHORT_FRAGMENT_PATH_PADDING - size + 1\n                if hi < 0:\n                    continue\n                c0 = random.randint(0, hi)\n            else:\n                lo = paths[-1][r] + SHORT_FRAGMENT_PATH_PADDING\n                if lo + size > W:\n                    continue\n                c0 = random.randint(lo, W - size)\n            coords = [(r, c0 + i) for i in range(size)]\n            if any(grid[rr, cc] != grid[0, 0] for rr, cc in coords):\n                continue\n            if _touches_mask(contour_mask, coords, 8):\n                continue\n            patch = np.full((1, size), contour, dtype=int)\n            paste(grid, patch, r, c0)\n            for rr, cc in coords:\n                contour_mask[rr, cc] = True\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n\n\ndef _add_contour_extras(grid: np.ndarray, long_mask: np.ndarray, paths: list[list[int]], contour: int, needed: int) -> bool:\n    if needed < 0:\n        return False\n    candidates: list[tuple[int, int]] = []\n    for side, path_i in [(-1, 0), (1, len(paths) - 1)]:\n        for r, c in enumerate(paths[path_i]):\n            cc = c + side\n            if 0 <= cc < W and grid[r, cc] == grid[0, 0]:\n                candidates.append((r, cc))\n    if needed > len(candidates):\n        return False\n    random.shuffle(candidates)\n    for r, c in candidates[:needed]:\n        grid[r, c] = contour\n        long_mask[r, c] = True\n    return True\n\n\ndef _segments_for_bars(n_bars: int, max_segment: int = BAR_SEGMENT_MAX) -> list[int] | None:\n    segments = [1] * (n_bars + 1)\n    remaining = H - n_bars - len(segments)\n    if remaining < 0:\n        return None\n    while remaining:\n        choices = [i for i, value in enumerate(segments) if value < max_segment]\n        if not choices:\n            return None\n        i = random.choice(choices)\n        add = random.randint(1, min(max_segment - segments[i], remaining))\n        segments[i] += add\n        remaining -= add\n    random.shuffle(segments)\n    return segments\n\n\ndef _bar_rows(n_bars: int) -> list[int] | None:\n    segments = _segments_for_bars(n_bars)\n    if segments is None:\n        return None\n    rows: list[int] = []\n    r = segments[0]\n    for i in range(n_bars):\n        rows.append(r)\n        r += 1 + segments[i + 1]\n    return rows\n\n\ndef _add_obstacle_bars(grid: np.ndarray, paths: list[list[int]], obstacle: int) -> bool:\n    channel_count = len(paths) - 1\n    if channel_count == 1:\n        bars_per_channel = [random.randint(SINGLE_CHANNEL_BARS_MIN, SINGLE_CHANNEL_BARS_MAX)]\n    else:\n        total = random.randint(MULTI_CHANNEL_TOTAL_BARS_MIN, MULTI_CHANNEL_TOTAL_BARS_MAX)\n        bars_per_channel = [MULTI_CHANNEL_INITIAL_BARS, MULTI_CHANNEL_INITIAL_BARS]\n        for _ in range(total - MULTI_CHANNEL_TOTAL_BARS_MIN):\n            choices = [i for i, value in enumerate(bars_per_channel) if value < MULTI_CHANNEL_MAX_BARS]\n            if not choices:\n                break\n            bars_per_channel[random.choice(choices)] += 1\n\n    for channel_i, n_bars in enumerate(bars_per_channel):\n        rows = _bar_rows(n_bars)\n        if rows is None:\n            return False\n        for r in rows:\n            c0 = paths[channel_i][r] + 1\n            c1 = paths[channel_i + 1][r]\n            if c1 - c0 < BAR_WIDTH_MIN or c1 - c0 > BAR_WIDTH_MAX:\n                return False\n            if np.any(grid[r, c0:c1] != grid[0, 0]):\n                return False\n            grid[r, c0:c1] = obstacle\n    return True\n\n\ndef _random_cluster(seed: tuple[int, int], size: int) -> list[tuple[int, int]]:\n    coords = [seed]\n    while len(coords) < size:\n        r, c = random.choice(coords)\n        dr, dc = random.choice(NEIGHBOR_DELTAS_4)\n        rr, cc = r + dr, c + dc\n        if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in coords:\n            coords.append((rr, cc))\n    return coords\n\n\ndef _can_place_obstacle(\n    grid: np.ndarray, obstacle_mask: np.ndarray, contour_mask: np.ndarray, coords: list[tuple[int, int]],\n    bg: int, paths: list[list[int]], zone: str\n) -> bool:\n    if zone == \"outside\" and not all(_outside_enclosure(paths, r, c, OUTSIDE_MARGIN) for r, c in coords):\n        return False\n    if zone == \"inside\" and not all(_inside_channel(paths, r, c) for r, c in coords):\n        return False\n    if any(grid[r, c] != bg for r, c in coords):\n        return False\n    if _touches_mask(obstacle_mask, coords, 4):\n        return False\n    if _touches_mask(contour_mask, coords, 4):\n        return False\n    return True\n\n\ndef _scatter_obstacles(\n    grid: np.ndarray, obstacle_mask: np.ndarray, contour_mask: np.ndarray, paths: list[list[int]], bg: int, obstacle: int\n) -> bool:\n    bar_pixels = int(obstacle_mask.sum())\n    low = max(OBSTACLE_PIXELS_MIN, bar_pixels + OBSTACLE_EXTRA_PIXELS_MIN)\n    if low > OBSTACLE_PIXELS_MAX:\n        return False\n    target = random.randint(low, OBSTACLE_PIXELS_MAX)\n    outside_quota = min(target - bar_pixels, random.randint(OBSTACLE_OUTSIDE_QUOTA_MIN, OBSTACLE_OUTSIDE_QUOTA_MAX))\n\n    while int(obstacle_mask.sum()) < target:\n        remaining = target - int(obstacle_mask.sum())\n        zone = \"outside\" if outside_quota > 0 else random.choice(OBSTACLE_ZONE_OPTIONS)\n        quota_limit = outside_quota if outside_quota > 0 else OBSTACLE_CLUSTER_SIZE_MAX\n        size = random.randint(OBSTACLE_CLUSTER_SIZE_MIN, min(OBSTACLE_CLUSTER_SIZE_MAX, remaining, quota_limit))\n        placed = False\n        for _attempt in range(OBSTACLE_ATTEMPTS):\n            seed = (random.randrange(H), random.randrange(W))\n            coords = _random_cluster(seed, size)\n            if _can_place_obstacle(grid, obstacle_mask, contour_mask, coords, bg, paths, zone):\n                for r, c in coords:\n                    grid[r, c] = obstacle\n                    obstacle_mask[r, c] = True\n                if zone == \"outside\":\n                    outside_quota -= size\n                placed = True\n                break\n        if not placed:\n            return False\n    return True\n\n\ndef _gen_long_component_ids(fill_lab: np.ndarray, n: int) -> set[int]:\n    ids: set[int] = set()\n    for comp_id in range(1, n + 1):\n        coords = np.argwhere(fill_lab == comp_id)\n        if coords.size == 0:\n            continue\n        if int(coords[:, 0].max()) - int(coords[:, 0].min()) + 1 >= LONG_COMPONENT_MIN_SPAN:\n            ids.add(int(comp_id))\n    return ids\n\n\ndef _fillable_mask(grid: np.ndarray, bg: int, contour: int) -> tuple[np.ndarray, int, set[int], int] | None:\n    fill_lab, n_fill = label_mask(grid == contour, connectivity=8)\n    long_ids = _gen_long_component_ids(fill_lab, n_fill)\n    if len(long_ids) not in LONG_COMPONENT_COUNT_OPTIONS:\n        return None\n\n    bg_lab, n_bg = label_mask(grid == bg, connectivity=4)\n    if n_bg < BG_REGIONS_MIN or n_bg > BG_REGIONS_MAX:\n        return None\n    sizes = {comp_id: int((bg_lab == comp_id).sum()) for comp_id in range(1, n_bg + 1)}\n    ranked = sorted(sizes, key=sizes.get, reverse=True)\n    if len(ranked) < 3 or sizes[ranked[1]] <= sizes[ranked[2]]:\n        return None\n    exterior = {int(ranked[0]), int(ranked[1])}\n    interior_count = n_bg - EXTERIOR_REGION_COUNT\n    if not INTERIOR_REGIONS_MIN <= interior_count <= INTERIOR_REGIONS_MAX:\n        return None\n    if any(sizes[comp_id] > INTERIOR_REGION_AREA_MAX for comp_id in range(1, n_bg + 1) if comp_id not in exterior):\n        return None\n\n    fillable = np.zeros_like(grid, dtype=bool)\n    for comp_id in range(1, n_bg + 1):\n        if comp_id in exterior:\n            continue\n        coords = np.argwhere(bg_lab == comp_id)\n        touches = False\n        for r, c in coords:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(fill_lab[rr, cc]) in long_ids:\n                    touches = True\n                    break\n            if touches:\n                break\n        if not touches:\n            return None\n        fillable[bg_lab == comp_id] = True\n    return fillable, n_bg, exterior, len(long_ids)\n\n\ndef _validate(inp: np.ndarray, out: np.ndarray, paths: list[list[int]], bg: int, contour: int, obstacle: int, n_bg: int, long_count: int) -> bool:\n    if not np.array_equal(main(inp), out):\n        return False\n    values = set(int(v) for v in np.unique(inp))\n    if values != {bg, contour, obstacle}:\n        return False\n    contour_count = int((inp == contour).sum())\n    obstacle_count = int((inp == obstacle).sum())\n    if not (CONTOUR_PIXELS_MIN <= contour_count <= CONTOUR_PIXELS_MAX and OBSTACLE_PIXELS_MIN <= obstacle_count <= OBSTACLE_PIXELS_MAX):\n        return False\n    if contour_count <= obstacle_count:\n        return False\n    interior_count = n_bg - EXTERIOR_REGION_COUNT\n    if not (BG_REGIONS_MIN <= n_bg <= BG_REGIONS_MAX and INTERIOR_REGIONS_MIN <= interior_count <= INTERIOR_REGIONS_MAX and long_count in LONG_COMPONENT_COUNT_OPTIONS):\n        return False\n\n    contour_lab, n_contour = label_mask(inp == contour, connectivity=8)\n    short = 0\n    for comp_id in range(1, n_contour + 1):\n        coords = np.argwhere(contour_lab == comp_id)\n        span = int(coords[:, 0].max()) - int(coords[:, 0].min()) + 1\n        area = int(coords.shape[0])\n        if span >= LONG_COMPONENT_MIN_SPAN:\n            continue\n        short += 1\n        if area < SHORT_FRAGMENT_SIZE_MIN or area > SHORT_FRAGMENT_SIZE_MAX:\n            return False\n    if not SHORT_FRAGMENT_COUNT_MIN <= short <= SHORT_FRAGMENT_COUNT_MAX:\n        return False\n\n    obs_lab, n_obs = label_mask(inp == obstacle, connectivity=4)\n    if n_obs == 0:\n        return False\n    if any(int((obs_lab == comp_id).sum()) > OBSTACLE_CLUSTER_SIZE_MAX for comp_id in range(1, n_obs + 1)):\n        return False\n    inside_obs = any(inp[r, c] == obstacle and _inside_channel(paths, r, c) for r in range(H) for c in range(W))\n    outside_obs = any(\n        inp[r, c] == obstacle and _outside_enclosure(paths, r, c, OUTSIDE_MARGIN) for r in range(H) for c in range(W)\n    )\n    return bool(inside_obs and outside_obs)\n\n\ndef _draw_long_contours(bg: int, contour: int, paths: list[list[int]]) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Render the primary path columns and return the grid plus long-contour mask.\"\"\"\n    grid = np.full(GRID_SHAPE, bg, dtype=int)\n    long_mask = np.zeros(GRID_SHAPE, dtype=bool)\n    for path in paths:\n        for r, c in enumerate(path):\n            grid[r, c] = contour\n            long_mask[r, c] = True\n    return grid, long_mask\n\n\ndef _finish_contours(grid: np.ndarray, long_mask: np.ndarray, paths: list[list[int]], contour: int) -> bool:\n    \"\"\"Add short distractors, then pad long contours to the sampled pixel target.\"\"\"\n    contour_mask = grid == contour\n    frag_count = random.randint(SHORT_FRAGMENT_COUNT_MIN, SHORT_FRAGMENT_COUNT_MAX)\n    if not _place_short_fragments(grid, contour_mask, paths, contour, frag_count):\n        return False\n\n    current_contour = int((grid == contour).sum())\n    if current_contour > CONTOUR_PIXELS_MAX:\n        return False\n    target_contour = random.randint(max(CONTOUR_PIXELS_MIN, current_contour), CONTOUR_PIXELS_MAX)\n    return _add_contour_extras(grid, long_mask, paths, contour, target_contour - current_contour)\n\n\ndef _place_obstacles(\n    grid: np.ndarray, contour_mask: np.ndarray, paths: list[list[int]], bg: int, obstacle: int\n) -> bool:\n    \"\"\"Place channel bars first, then scatter isolated obstacle clusters.\"\"\"\n    obstacle_mask = np.zeros(GRID_SHAPE, dtype=bool)\n    if not _add_obstacle_bars(grid, paths, obstacle):\n        return False\n    obstacle_mask = grid == obstacle\n    return _scatter_obstacles(grid, obstacle_mask, contour_mask, paths, bg, obstacle)\n\n\ndef _make_input_output(grid: np.ndarray, bg: int, contour: int) -> tuple[np.ndarray, np.ndarray, int, int] | None:\n    \"\"\"Build the output-first pair and carry validation metadata.\"\"\"\n    fill_info = _fillable_mask(grid, bg, contour)\n    if fill_info is None:\n        return None\n    fillable, n_bg, _exterior, long_count = fill_info\n    out = grid.copy()\n    out[fillable] = contour\n    inp = out.copy()\n    inp[fillable] = bg\n    return inp, out, n_bg, long_count\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg, contour, obstacle = _color_choices()\n    path_count = random.choice(PATH_COUNT_OPTIONS)\n    paths = _path_columns(path_count)\n    if paths is None:\n        return None\n\n    grid, long_mask = _draw_long_contours(bg, contour, paths)\n    if not _finish_contours(grid, long_mask, paths, contour):\n        return None\n\n    contour_mask = grid == contour\n    if not _place_obstacles(grid, contour_mask, paths, bg, obstacle):\n        return None\n\n    pair = _make_input_output(grid, bg, contour)\n    if pair is None:\n        return None\n    inp, out, n_bg, long_count = pair\n\n    if not _validate(inp, out, paths, bg, contour, obstacle, n_bg, long_count):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\ndef _in_bounds(h, w, r, c):\n    return 0 <= r < h and 0 <= c < w\n\n\n# ---------------------------------------------------------------------------\n# Frame geometry\n# ---------------------------------------------------------------------------\n\ndef _frame_ring_coords(r0, c0, ch, cw):\n    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n\n    Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).\n    Ring = bbox boundary minus 4 corners.\n    \"\"\"\n    H, W = ch + 2, cw + 2\n    ring = []\n    for dr in range(H):\n        for dc in range(W):\n            on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)\n            corner = (dr in (0, H - 1)) and (dc in (0, W - 1))\n            if on_bdr and not corner:\n                ring.append((r0 + dr, c0 + dc))\n    cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]\n    return ring, cavity\n\n\ndef _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n\n    Returns True if: ring and cavity cells are empty, no cavity cell is\n    8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and\n    at least one ring cell is 8-adjacent to a line_col pixel.\n    \"\"\"\n    # Ring and cavity cells must all be empty\n    for rr, cc in ring:\n        if canvas[rr, cc] != -1:\n            return False\n    for rr, cc in cavity:\n        if canvas[rr, cc] != -1:\n            return False\n\n    # No cavity cell may be 8-adjacent to any line_col pixel\n    for cr, cc in cavity:\n        for nr, nc in neighbors8(cr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return False\n\n    # Ring must not be 8-adjacent to any non-bg, non-line_col pixel\n    ring_set = set(ring)\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:\n                continue\n            v = canvas[nr, nc]\n            if v != -1 and v != line_col:\n                return False\n\n    # At least one ring cell must be 8-adjacent to a line_col pixel\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return True\n    return False\n\n\n# ---------------------------------------------------------------------------\n# Line growth\n# ---------------------------------------------------------------------------\n\ndef _grow_line(grid, start, line_col, target_len, rng):\n    \"\"\"Grow a meandering 8-connected 1px-wide path of line_col from start.\"\"\"\n    h, w = grid.shape\n    path = [start]\n    dr_bias = 1 if start[0] < h // 2 else -1\n    dc_bias = 1 if start[1] < w // 2 else -1\n    cur = start\n    path_set = {start}\n    while len(path) < target_len:\n        # Build weighted direction list: diagonals preferred, bias-aligned boosted\n        dirs = []\n        for ddr, ddc in DIAG_DIRS:\n            aligned = (ddr == dr_bias or ddc == dc_bias)\n            w_d = DIAG_WEIGHT_ALIGNED if aligned else DIAG_WEIGHT_OTHER\n            dirs.extend([(ddr, ddc)] * w_d)\n        for ddr, ddc in ORTHO_DIRS:\n            aligned = (ddr == dr_bias and ddc == 0) or (ddc == dc_bias and ddr == 0)\n            w_d = ORTHO_WEIGHT_ALIGNED if aligned else ORTHO_WEIGHT_OTHER\n            dirs.extend([(ddr, ddc)] * w_d)\n        rng.shuffle(dirs)\n        placed = False\n        for ddr, ddc in dirs:\n            nr, nc = cur[0] + ddr, cur[1] + ddc\n            if not _in_bounds(h, w, nr, nc) or grid[nr, nc] != -1:\n                continue\n            # Keep path thin: reject if 8-adjacent to existing path (except cur)\n            if any((nnr, nnc) != cur and (nnr, nnc) in path_set\n                   for nnr, nnc in neighbors8(nr, nc)):\n                continue\n            # Strongly avoid grid border\n            if (nr == 0 or nc == 0 or nr == h - 1 or nc == w - 1) and rng.random() < BORDER_AVOIDANCE_PROB:\n                continue\n            cur = (nr, nc)\n            path.append(cur)\n            path_set.add(cur)\n            grid[nr, nc] = line_col\n            placed = True\n            break\n        if not placed:\n            if rng.random() < BIAS_FLIP_PROB:\n                dr_bias *= -1\n            if rng.random() < BIAS_FLIP_PROB:\n                dc_bias *= -1\n            break\n    return path\n\n\n# ---------------------------------------------------------------------------\n# Frame attachment\n# ---------------------------------------------------------------------------\n\ndef _halo_offsets(fh, fw):\n    \"\"\"Compute offsets around a frame bbox that lie outside it (the halo).\"\"\"\n    return [(dr, dc) for dr in range(-1, fh + 1) for dc in range(-1, fw + 1)\n            if not (0 <= dr < fh and 0 <= dc < fw)]\n\n\ndef _try_attach_frame(canvas, line_path, line_col, frame_col, rng, max_tries=FRAME_ATTACH_TRIES):\n    \"\"\"Try to place a frame loop 8-adjacent to some line pixel.\n\n    canvas is modified in place; returns (ring, cavity) or None on failure.\n    \"\"\"\n    h, w = canvas.shape\n    pad = FRAME_PLACEMENT_PAD\n    for _ in range(max_tries):\n        ch = rng.choice(CAVITY_SIZE_WEIGHTS)\n        cw = rng.choice(CAVITY_SIZE_WEIGHTS)\n        lp = rng.choice(line_path)\n        fh, fw = ch + 2, cw + 2\n        offsets = _halo_offsets(fh, fw)\n        rng.shuffle(offsets)\n        for dr, dc in offsets:\n            r0 = lp[0] - dr\n            c0 = lp[1] - dc\n            if r0 < pad or c0 < pad or r0 + fh > h - pad or c0 + fw > w - pad:\n                continue\n            ring, cavity = _frame_ring_coords(r0, c0, ch, cw)\n            if not _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n                continue\n            for rr, cc in ring:\n                canvas[rr, cc] = frame_col\n            return ring, cavity\n    return None\n\n\ndef _try_attach_distractor_frame(canvas, frame_col, rng, max_tries=DISTRACTOR_FRAME_TRIES):\n    \"\"\"Place a loop in empty space, not touching any non-bg pixel.\"\"\"\n    h, w = canvas.shape\n    for _ in range(max_tries):\n        ch = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\n        cw = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\n        fh, fw = ch + 2, cw + 2\n        r0 = rng.randint(1, h - fh - 1)\n        c0 = rng.randint(1, w - fw - 1)\n        # Check the full bbox + 1-cell margin is empty\n        ok = True\n        for rr in range(r0 - 1, r0 + fh + 1):\n            for cc in range(c0 - 1, c0 + fw + 1):\n                if _in_bounds(h, w, rr, cc) and canvas[rr, cc] != -1:\n                    ok = False\n                    break\n            if not ok:\n                break\n        if not ok:\n            continue\n        ring, _ = _frame_ring_coords(r0, c0, ch, cw)\n        for rr, cc in ring:\n            canvas[rr, cc] = frame_col\n        return True\n    return None\n\n\ndef _try_place_distractor_network(canvas, line_col, frame_colors_pool, rng):\n    \"\"\"Place a disconnected line+frame distractor (no seed).\"\"\"\n    h, w = canvas.shape\n    for _ in range(DISTRACTOR_NETWORK_TRIES):\n        r = rng.randint(2, h - 3)\n        c = rng.randint(2, w - 3)\n        if any(canvas[r + dr, c + dc] != -1 for dr in range(-1, 2) for dc in range(-1, 2)):\n            continue\n        canvas[r, c] = line_col\n        target_len = rng.randint(*DISTRACTOR_LINE_LEN)\n        path = _grow_line(canvas, (r, c), line_col, target_len, rng)\n        if len(path) < 3:\n            for pr, pc in path:\n                canvas[pr, pc] = -1\n            continue\n        attached = 0\n        for _ in range(rng.randint(*DISTRACTOR_NETWORK_FRAMES)):\n            fc = rng.choice(frame_colors_pool)\n            if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\n                attached += 1\n        if attached > 0:\n            return True\n        for pr, pc in path:\n            canvas[pr, pc] = -1\n    return False\n\n\n# ---------------------------------------------------------------------------\n# Main generator\n# ---------------------------------------------------------------------------\n\ndef _corner_config(corner_kind, h, w, rng):\n    \"\"\"Return (seed_rc, first_line_rc) for corner_kind in {TL,TR,BL,BR}.\"\"\"\n    if corner_kind == 'TL':\n        seed = (0, 0)\n        first = rng.choice([(0, 1), (1, 0)])\n    elif corner_kind == 'TR':\n        seed = (0, w - 1)\n        first = rng.choice([(0, w - 2), (1, w - 1)])\n    elif corner_kind == 'BL':\n        seed = (h - 1, 0)\n        first = rng.choice([(h - 1, 1), (h - 2, 0)])\n    elif corner_kind == 'BR':\n        seed = (h - 1, w - 1)\n        first = rng.choice([(h - 1, w - 2), (h - 2, w - 1)])\n    else:\n        raise ValueError(corner_kind)\n    return seed, first\n\n\ndef _distribute_loop_budget(num_seeds, num_attached_target, rng):\n    \"\"\"Distribute attached-loop budget across seeds, guaranteeing >= 1 each.\"\"\"\n    seed_order = list(range(num_seeds))\n    rng.shuffle(seed_order)\n    per_seed = [0] * num_seeds\n    remaining = num_attached_target\n    # Guarantee at least 1 per seed\n    while remaining > 0 and any(per_seed[i] == 0 for i in range(num_seeds)):\n        for i in seed_order:\n            if per_seed[i] == 0 and remaining > 0:\n                per_seed[i] += 1\n                remaining -= 1\n    # Distribute remainder randomly\n    while remaining > 0:\n        per_seed[rng.choice(seed_order)] += 1\n        remaining -= 1\n    return per_seed\n\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    h = rng.randint(*GRID_H_RANGE)\n    w = rng.randint(*GRID_W_RANGE)\n    bg = rng.choice(BG_COLORS)\n    palette = [c for c in range(10) if c != bg]\n    rng.shuffle(palette)\n\n    num_seeds = rng.choice(SEED_COUNT_WEIGHTS)\n    if num_seeds * 2 > len(palette):\n        return None\n\n    canvas = -np.ones((h, w), dtype=int)\n\n    seed_colors = [palette.pop() for _ in range(num_seeds)]\n    line_colors = [palette.pop() for _ in range(num_seeds)]\n\n    all_corners = ['TL', 'TR', 'BL', 'BR']\n    rng.shuffle(all_corners)\n    corners_used = all_corners[:num_seeds]\n\n    num_frame_cols = rng.randint(1, min(FRAME_COLORS_MAX, len(palette)))\n    frame_colors_pool = [palette.pop() for _ in range(num_frame_cols)]\n\n    # Grow seed lines\n    lines_info = []\n    for i in range(num_seeds):\n        seed_rc, first_rc = _corner_config(corners_used[i], h, w, rng)\n        if canvas[seed_rc] != -1 or canvas[first_rc] != -1:\n            return None\n        canvas[seed_rc] = seed_colors[i]\n        canvas[first_rc] = line_colors[i]\n        target_len = rng.randint(LINE_LEN_RANGE[0], min(LINE_LEN_RANGE[1], h + w))\n        path = _grow_line(canvas, first_rc, line_colors[i], target_len, rng)\n        if len(path) < MIN_LINE_LEN:\n            return None\n        lines_info.append((seed_colors[i], seed_rc, line_colors[i], path))\n\n    # Decide loop counts and distribute across seeds\n    total_loops_target = rng.randint(num_seeds, TOTAL_LOOPS_MAX)\n    num_distractors_target = rng.randint(0, max(0, total_loops_target - num_seeds))\n    num_attached_target = total_loops_target - num_distractors_target\n    per_seed = _distribute_loop_budget(num_seeds, num_attached_target, rng)\n\n    # Attach frames to each seed's line\n    for i, (_, _, line_col, path) in enumerate(lines_info):\n        attached = 0\n        for _ in range(per_seed[i]):\n            fc = rng.choice(frame_colors_pool)\n            if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\n                attached += 1\n        if attached == 0:\n            return None\n\n    # Place distractors\n    if rng.random() < DISTRACTOR_NETWORK_PROB:\n        _try_place_distractor_network(canvas, rng.choice(line_colors), frame_colors_pool, rng)\n    else:\n        for _ in range(rng.randint(0, DISTRACTOR_SOLO_MAX)):\n            _try_attach_distractor_frame(canvas, rng.choice(frame_colors_pool), rng)\n\n    # Finalize grid\n    grid = np.where(canvas == -1, bg, canvas).astype(int)\n\n    # Validate bg is most common color\n    vals, cnts = np.unique(grid, return_counts=True)\n    if int(vals[np.argmax(cnts)]) != bg:\n        return None\n\n    # Validate each seed color appears exactly once\n    for seed_col, _, _, _ in lines_info:\n        if int((grid == seed_col).sum()) != 1:\n            return None\n\n    # Oracle check: solver must change at least one cell\n    try:\n        out = main(grid)\n    except Exception:\n        return None\n    if np.array_equal(out, grid):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/eval/9385bd28.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill rectangles between diagonal marker pairs using a color legend.\n\n    Input structure:\n    - bg grid with a vertical legend at the bottom-left: each row is a (marker_color, fill_color) pair.\n    - Scattered L-shaped corner markers of each marker color define opposite corners of axis-aligned rectangles.\n    - Some markers are solid 2×2 blocks instead of corner pairs.\n\n    Rule:\n    - Read legend bottom-to-top; for each entry find all pixels of that marker color.\n    - Determine which two bbox corners carry L-shaped anchors — the *other* diagonal defines the fill region.\n    - Fill the diamond (all shortest-path cells between those two corners) with the legend's fill color.\n    - Solid 2×2 marker blocks are simply recolored to the fill color.\n    - Later legend entries are protected from earlier fills.\n\n    Key insight: The L-shaped anchors sit on the marker diagonal; the fill goes on the opposite diagonal of the bounding box.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    bg = get_bg(g)\n    legend_c, entries = _find_legend(g, bg)\n    assert entries, \"legend must contain at least one (marker, fill) entry\"\n\n    legend_mask = np.zeros_like(g, dtype=bool)\n    for r, _, _ in entries:\n        if 0 <= r < h and 0 <= legend_c < w:\n            legend_mask[r, legend_c] = True\n        if 0 <= r < h and 0 <= legend_c + 1 < w:\n            legend_mask[r, legend_c + 1] = True\n\n    out = g.copy()\n\n    marker_order = [m for _, m, _ in entries]\n    marker_set = set(marker_order)\n\n    # Process legend entries bottom -> top; earlier entries must not destroy later marker pixels.\n    for i, (_, marker, fill) in enumerate(entries):\n        eff_fill = int(fill)\n        marker_pts = set(map(tuple, np.argwhere((g == marker) & (~legend_mask))))\n        if len(marker_pts) < 2:\n            continue\n\n        rs = [r for r, _ in marker_pts]\n        cs = [c for _, c in marker_pts]\n        rmin, rmax = min(rs), max(rs)\n        cmin, cmax = min(cs), max(cs)\n\n        # Protect legend cells and all marker pixels for entries that appear later (higher) in the legend.\n        future_markers = set(marker_order[i + 1 :])\n        protect = legend_mask.copy()\n        for fm in future_markers:\n            protect |= (g == fm) & (~legend_mask)\n\n        # Also protect current marker pixels in the common case (so markers remain visible),\n        # except when they form a solid 2x2 block (treated as a filled marker that gets recolored).\n        if rmax - rmin == 1 and cmax - cmin == 1 and len(marker_pts) == 4:\n            # Solid 2x2 marker: recolor these pixels directly.\n            block = np.zeros_like(g, dtype=bool)\n            for r, c in marker_pts:\n                block[r, c] = True\n            out[block & (~protect)] = eff_fill\n            continue\n        else:\n            protect |= (g == marker) & (~legend_mask)\n\n        if rmin == rmax or cmin == cmax:\n            continue\n\n        tl = (rmin, cmin)\n        tr = (rmin, cmax)\n        bl = (rmax, cmin)\n        br = (rmax, cmax)\n\n        tl_anchor = _l_anchor_present(marker_pts, tl[0], tl[1], (0, 1), (1, 0))\n        tr_anchor = _l_anchor_present(marker_pts, tr[0], tr[1], (0, -1), (1, 0))\n        bl_anchor = _l_anchor_present(marker_pts, bl[0], bl[1], (0, 1), (-1, 0))\n        br_anchor = _l_anchor_present(marker_pts, br[0], br[1], (0, -1), (-1, 0))\n\n        score_tlbr = int(tl_anchor) + int(br_anchor)\n        score_trbl = int(tr_anchor) + int(bl_anchor)\n        assert score_tlbr != 0 or score_trbl != 0, \"at least one diagonal must have an L-anchor\"\n        assert score_tlbr != score_trbl, \"diagonal scores must not tie (tie-break path is unreachable)\"\n        if score_tlbr > score_trbl:\n            a, b = tr, bl\n        else:\n            a, b = tl, br\n\n        diamond = _diamond_mask(h, w, rmin, rmax, cmin, cmax, a, b)\n        out[diamond & (~protect)] = eff_fill\n\n    return out\n\n# --------------- generator (C1) ---------------\n\n# ── CFG: canvas & grid ──────────────────────────────────────────────\nGRID_H_RANGE = (10, 19)          # grid height bounds\nGRID_W_RANGE = (10, 19)          # grid width bounds\n\n# ── CFG: legend ─────────────────────────────────────────────────────\nLEGEND_COL_RANGE = (0, 2)        # legend left column (marker at c, fill at c+1)\nLEGEND_ENTRY_RANGE = (2, 5)      # number of legend entries\n\n# ── CFG: marker types ──────────────────────────────────────────────\nNOOP_PROB = 0.3                  # prob of one noop entry (marker with no pixels)\nBLOCK_PROB = 0.25                # prob of one 2x2 block entry\n\n# ── CFG: L-pair bbox shape ──────────────────────────────────────────\nBBOX_H_MAX = 19                  # max bbox height\nBBOX_W_MAX = 12                  # max bbox width\nBBOX_SHAPE_WEIGHTS = [0.75, 0.15, 0.10]  # [both>=3, h=2/w>=4, h>=4/w=2]\nTLBR_PROB = 0.8                  # prob of TL-BR diagonal (vs TR-BL)\n\n# ── CFG: distractor ────────────────────────────────────────────────\nDISTRACTOR_PROB = 0.25           # prob of adding a non-legend L-pair\n\n# ── CFG: retry budgets ─────────────────────────────────────────────\nBLOCK_RETRIES = 100              # placement attempts for a 2x2 block\nLPAIR_RETRIES = 150              # placement attempts for an L-pair\nDISTRACTOR_RETRIES = 60          # placement attempts for distractor\nGEN_RETRIES = 300                # outer generate_input retry budget\n\n_L_OFFSETS = {\n    \"TL\": [(0, 0), (0, 1), (1, 0)],\n    \"TR\": [(0, 0), (0, -1), (1, 0)],\n    \"BL\": [(0, 0), (0, 1), (-1, 0)],\n    \"BR\": [(0, 0), (0, -1), (-1, 0)],\n}\n\n\ndef _l_pair_cells(rmin: int, cmin: int, rmax: int, cmax: int, diag: str) -> list[tuple[int, int]]:\n    \"\"\"Return the 6 cells for an L-pair at opposite bbox corners. diag in {'TLBR','TRBL'}.\"\"\"\n    if diag == \"TLBR\":\n        anchors = [(\"TL\", rmin, cmin), (\"BR\", rmax, cmax)]\n    else:\n        anchors = [(\"TR\", rmin, cmax), (\"BL\", rmax, cmin)]\n    cells: list[tuple[int, int]] = []\n    for name, r, c in anchors:\n        for dr, dc in _L_OFFSETS[name]:\n            cells.append((r + dr, c + dc))\n    return cells\n\n\ndef _l_pair_valid_bbox(h: int, w: int) -> bool:\n    \"\"\"True if (h, w) avoids an L-anchor score tie.\n\n    Fails for (2,2), (2,3), (3,2). Safe: h>=3 and w>=3, or h==2 and w>=4, or h>=4 and w==2.\n    \"\"\"\n    if h < 2 or w < 2:\n        return False\n    if h == 2 and w <= 3:\n        return False\n    if w == 2 and h <= 3:\n        return False\n    return True\n\n\ndef _pick_bbox_size(H: int, W: int) -> tuple[int, int] | None:\n    \"\"\"Pick a random valid L-pair bbox size that fits in (H, W).\"\"\"\n    shape_choice = random.choices(\n        [\"both_ge3\", \"h2_w_ge4\", \"h_ge4_w2\"],\n        weights=BBOX_SHAPE_WEIGHTS,\n    )[0]\n    if shape_choice == \"both_ge3\":\n        bh = random.randint(3, min(BBOX_H_MAX, H))\n        bw = random.randint(3, min(BBOX_W_MAX, W))\n    elif shape_choice == \"h2_w_ge4\":\n        bh = 2\n        w_hi = min(BBOX_W_MAX, W)\n        if w_hi < 4:\n            return None\n        bw = random.randint(4, w_hi)\n    else:\n        h_hi = min(BBOX_H_MAX, H)\n        if h_hi < 4:\n            return None\n        bh = random.randint(4, h_hi)\n        bw = 2\n    if bh > H or bw > W or not _l_pair_valid_bbox(bh, bw):\n        return None\n    return bh, bw\n\n\ndef _try_place_l_pair(H: int, W: int, color: int, retries: int,\n                      can_place, do_place) -> bool:\n    \"\"\"Try to place an L-pair of `color` on the grid within `retries` attempts.\n\n    Returns True on success, False if all attempts failed.\n    \"\"\"\n    for _ in range(retries):\n        size = _pick_bbox_size(H, W)\n        if size is None:\n            continue\n        bh, bw = size\n        rmin = random.randint(0, H - bh)\n        cmin = random.randint(0, W - bw)\n        diag = \"TLBR\" if random.random() < TLBR_PROB else \"TRBL\"\n        cells = _l_pair_cells(rmin, cmin, rmin + bh - 1, cmin + bw - 1, diag)\n        if can_place(cells):\n            do_place(cells, color)\n            return True\n    return False\n\n\ndef _build_legend(H, W, bg):\n    \"\"\"Create legend entries and the corresponding grid/mask arrays.\n\n    Returns (grid, legend_rows, legend_mask, legend_c, legend_bot) or None on failure.\n    \"\"\"\n    legend_c = random.randint(*LEGEND_COL_RANGE)\n    legend_bot = random.choice([H - 1, H - 2])\n    n_entries = random.randint(*LEGEND_ENTRY_RANGE)\n    if legend_bot - n_entries + 1 < 0:\n        return None\n\n    pool = [c for c in range(10) if c != bg]\n    if len(pool) < n_entries:\n        return None\n    marker_colors = random.sample(pool, n_entries)\n\n    grid = np.full((H, W), bg, dtype=int)\n    legend_rows: list[tuple[int, int, int]] = []\n    legend_mask = np.zeros((H, W), dtype=bool)\n    for i in range(n_entries):\n        r = legend_bot - i\n        m = marker_colors[i]\n        fill = random.randint(0, 9)\n        legend_rows.append((r, m, fill))\n        grid[r, legend_c] = m\n        legend_mask[r, legend_c] = True\n        if legend_c + 1 < W:\n            grid[r, legend_c + 1] = fill\n            legend_mask[r, legend_c + 1] = True\n\n    return grid, legend_rows, legend_mask, legend_c, legend_bot, marker_colors\n\n\ndef _build_forbidden(H, W, legend_c, legend_bot, legend_rows):\n    \"\"\"Build the forbidden-placement mask that protects legend scan integrity.\n\n    Forbids non-bg placement in rows below legend_bot and in columns <= legend_c\n    above the legend (except legend marker cells themselves).\n    \"\"\"\n    forbidden = np.zeros((H, W), dtype=bool)\n    if legend_bot + 1 < H:\n        forbidden[legend_bot + 1:, :] = True\n    forbidden[:legend_bot + 1, :legend_c + 1] = True\n    for r, _, _ in legend_rows:\n        forbidden[r, legend_c] = False\n    return forbidden\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(*GRID_H_RANGE)\n    W = random.randint(*GRID_W_RANGE)\n    bg = random.randint(0, 9)\n\n    legend_result = _build_legend(H, W, bg)\n    if legend_result is None:\n        return None\n    grid, legend_rows, legend_mask, legend_c, legend_bot, marker_colors = legend_result\n\n    forbidden = _build_forbidden(H, W, legend_c, legend_bot, legend_rows)\n    occupied = legend_mask.copy()\n\n    # Assign a marker type per legend entry.\n    n_entries = len(legend_rows)\n    types = [\"L\"] * n_entries\n    idx_pool = list(range(n_entries))\n    random.shuffle(idx_pool)\n    if random.random() < NOOP_PROB and len(idx_pool) > 1:\n        types[idx_pool.pop()] = \"noop\"\n    if random.random() < BLOCK_PROB and idx_pool:\n        types[idx_pool.pop()] = \"block\"\n\n    def can_place(cells):\n        for r, c in cells:\n            if not (0 <= r < H and 0 <= c < W):\n                return False\n            if occupied[r, c] or forbidden[r, c]:\n                return False\n        return True\n\n    def do_place(cells, color):\n        for r, c in cells:\n            grid[r, c] = color\n            occupied[r, c] = True\n\n    # Place markers for each legend entry.\n    for i, (_, m, _) in enumerate(legend_rows):\n        t = types[i]\n        if t == \"noop\":\n            continue\n        if t == \"block\":\n            placed = False\n            for _ in range(BLOCK_RETRIES):\n                r0 = random.randint(0, H - 2)\n                c0 = random.randint(0, W - 2)\n                cells = [(r0, c0), (r0, c0 + 1), (r0 + 1, c0), (r0 + 1, c0 + 1)]\n                if can_place(cells):\n                    do_place(cells, m)\n                    placed = True\n                    break\n            if not placed:\n                return None\n        else:\n            if not _try_place_l_pair(H, W, m, LPAIR_RETRIES, can_place, do_place):\n                return None\n\n    # Optional distractor L-pair in a non-legend color.\n    if random.random() < DISTRACTOR_PROB:\n        avail = [c for c in range(10) if c != bg and c not in marker_colors]\n        if avail:\n            _try_place_l_pair(H, W, random.choice(avail),\n                              DISTRACTOR_RETRIES, can_place, do_place)\n\n    # Ensure bg remains the most common color (so get_bg picks it).\n    counts = Counter(grid.flatten().tolist())\n    if counts.most_common(1)[0][0] != bg:\n        return None\n\n    # Oracle check: solver must run without errors.\n    try:\n        _ = main(grid)\n    except Exception:\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
