{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, components_mask, find_components, get_bg\nimport random\n\n\ndef _unique_largest_count_color(g: np.ndarray, colors: list[int]) -> int:\n    counts = [(int(np.sum(g == color)), int(color)) for color in colors]\n    max_count = max(count for count, _color in counts)\n    winners = [color for count, color in counts if count == max_count]\n    assert len(winners) == 1, \"expected one most numerous non-background obstacle color\"\n    return winners[0]\n\n\ndef _marker_bbox(g: np.ndarray, marker_colors: list[int]) -> tuple[int, int, int, int]:\n    mask = np.isin(g, marker_colors)\n    candidates: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(mask, connectivity=8):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        if r0 == 0:\n            candidates.append((r0, c0, r1, c1))\n\n    assert len(candidates) == 1, \"expected one top-edge marker component\"\n    return candidates[0]\n\n\ndef _runs(values: list[int]) -> list[tuple[int, int]]:\n    if not values:\n        return []\n\n    runs: list[tuple[int, int]] = []\n    start = prev = values[0]\n    for value in values[1:]:\n        if value == prev + 1:\n            prev = value\n            continue\n        runs.append((start, prev))\n        start = prev = value\n    runs.append((start, prev))\n    return runs\n\n\ndef _can_slide_right(base: np.ndarray, obstacle: int, bg: int, cols: list[int], marker_bottom_r: int, height: int) -> bool:\n    H, W = base.shape\n    assert cols\n    if cols[-1] + 1 >= W:\n        return False\n\n    for floor_r in range(marker_bottom_r + 1, H):\n        target_rows = np.arange(floor_r - height + 1, floor_r + 1)\n        if int(target_rows[0]) < 0:\n            continue\n\n        shifted_cols = [c + 1 for c in cols]\n        target_is_clear = all(np.all(base[target_rows, c] == bg) for c in shifted_cols)\n        if not target_is_clear:\n            continue\n\n        for c in cols:\n            if int(base[floor_r, c]) != obstacle:\n                continue\n            has_horizontal_neighbor = (\n                (c > 0 and int(base[floor_r, c - 1]) == obstacle)\n                or (c + 1 < W and int(base[floor_r, c + 1]) == obstacle)\n            )\n            if has_horizontal_neighbor:\n                return True\n\n    return False\n\n\ndef _clear_bottom_edge_gap(base: np.ndarray, out: np.ndarray, obstacle: int, bg: int, c: int, width: int) -> None:\n    H, W = base.shape\n    if int(base[H - 1, c]) != obstacle:\n        return\n\n    c1 = c\n    while c1 < W and int(base[H - 1, c1]) == obstacle:\n        c1 += 1\n\n    if c1 - c >= width:\n        out[H - 1, c + 1 : c + width] = bg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\n    Input structure\n    - The background is the dominant color.\n    - The most numerous non-background color forms stationary grey obstacle pixels.\n    - The other two colors form a single 3x3 top-edge marker whose top two rows\n      are maroon and whose bottom row contains maroon or blue control pixels.\n\n    Rule\n    - Erase the top marker.\n    - Treat each marker column as a vertical drop retaining its three colors.\n    - A column whose bottom control pixel is blue stops immediately above the\n      first grey pixel below that column, or bottom-aligns if none exists.\n    - Contiguous maroon-ended columns pass through obstacles and bottom-align;\n      if such a run has a clear down-right slide from a grey ledge, shift the\n      run one column right before bottom-aligning.\n    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n      the rest of the marker-width gap in that bottom bar.\n\n    Key insight\n    - The bottom row of the top marker is a control strip: blue cells mean\n      \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H = g.shape[0]\n    bg = int(get_bg(g))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 3, \"expected obstacle color plus two marker colors\"\n    obstacle = _unique_largest_count_color(g, non_bg)\n    marker_colors = [color for color in non_bg if color != obstacle]\n    assert len(marker_colors) == 2, \"expected exactly two marker colors\"\n\n    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)\n    marker = g[r0 : r1 + 1, c0 : c1 + 1]\n    marker_h, marker_w = marker.shape\n    assert (marker_h, marker_w) == (3, 3), \"expected a 3x3 marker\"\n    assert np.all(np.isin(marker, marker_colors)), \"marker bbox must contain only marker colors\"\n\n    pass_color = int(marker[0, 0])\n    assert np.all(marker[:2, :] == pass_color), \"top two marker rows must be the pass-through color\"\n    stop_colors = [color for color in marker_colors if color != pass_color]\n    assert len(stop_colors) == 1, \"expected one stop color\"\n    stop_color = stop_colors[0]\n\n    out = g.copy()\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    base = out.copy()\n\n    pass_columns: list[int] = []\n    for j in range(marker_w):\n        c = c0 + j\n        stack = marker[:, j]\n        bottom_control = int(stack[-1])\n\n        if bottom_control == stop_color:\n            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n            if len(obstacles_below):\n                floor_r = int(r1 + 1 + obstacles_below[0])\n                top_r = floor_r - marker_h\n            else:\n                top_r = H - marker_h\n            assert top_r >= 0, \"stopped column must fit above its obstacle\"\n            out[top_r : top_r + marker_h, c] = stack\n        else:\n            assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n            pass_columns.append(j)\n\n    for start_j, end_j in _runs(pass_columns):\n        source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n        top_r = H - marker_h\n\n        for j in range(start_j, end_j + 1):\n            c = c0 + j + shift\n            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n            out[top_r : top_r + marker_h, c] = marker[:, j]\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\nGRID_SIZE_RANGE = (14, 16)\nMARKER_SIZE = 3\nSTOP_COUNT_RANGE = (1, 3)\nOBSTACLE_COMPONENT_RANGE = (7, 9)\nOBSTACLE_PIXEL_RANGE = (20, 31)\nCOMPONENT_SIZE_RANGE = (1, 11)\nMIN_STOP_OBSTACLE_ROW = 6\nDROP_ZONE_HEIGHT = 3\nCOMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300\n\n\ndef _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:\n    grid = np.full((H, W), GEN_BG, dtype=int)\n    c0 = random.randint(0, W - MARKER_SIZE)\n    num_stops = random.randint(*STOP_COUNT_RANGE)\n    positions = list(range(MARKER_SIZE))\n    random.shuffle(positions)\n    stop_positions = sorted(positions[:num_stops])\n    marker = np.full((MARKER_SIZE, MARKER_SIZE), GEN_PASS, dtype=int)\n    for j in stop_positions:\n        marker[MARKER_SIZE - 1, j] = GEN_STOP\n    grid[0:MARKER_SIZE, c0:c0 + MARKER_SIZE] = marker\n    obstacle_pixels: set[tuple[int, int]] = set()\n    for j in stop_positions:\n        col = c0 + j\n        first_obs_row = random.randint(MIN_STOP_OBSTACLE_ROW, H - 1)\n        grid[first_obs_row, col] = GEN_OBSTACLE\n        obstacle_pixels.add((first_obs_row, col))\n    return grid, c0, stop_positions, obstacle_pixels\n\n\ndef _forbidden_cells(H: int, c0: int, stop_positions: list[int], obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]]:\n    forbidden = {(r, c) for r in range(MARKER_SIZE) for c in range(c0, c0 + MARKER_SIZE)}\n    for j in stop_positions:\n        col = c0 + j\n        for r in range(MARKER_SIZE, H):\n            if (r, col) not in obstacle_pixels:\n                continue\n            for dr in range(1, DROP_ZONE_HEIGHT + 1):\n                if r - dr >= 0:\n                    forbidden.add((r - dr, col))\n            break\n    return forbidden\n\n\ndef _sample_component_sizes(total_pixels: int, component_count: int) -> list[int] | None:\n    component_sizes = []\n    left = total_pixels\n    min_size, max_size = COMPONENT_SIZE_RANGE\n    for i in range(component_count):\n        remaining = component_count - i - 1\n        if remaining == 0:\n            size = left\n        else:\n            lo = max(min_size, left - max_size * remaining)\n            hi = min(max_size, left - min_size * remaining)\n            if lo > hi:\n                return None\n            size = random.randint(lo, hi)\n        left -= size\n        if size < min_size or size > max_size:\n            return None\n        component_sizes.append(size)\n    random.shuffle(component_sizes)\n    return component_sizes\n\n\ndef _grow_component(grid: np.ndarray, comp_size: int, forbidden: set[tuple[int, int]],\n                    obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]] | None:\n    H, W = grid.shape\n    sr, sc = random.randint(0, H - 1), random.randint(0, W - 1)\n    if (sr, sc) in forbidden or (sr, sc) in obstacle_pixels or grid[sr, sc] != GEN_BG:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import Color, components_mask, get_bg\n\n\nPALETTE_ORDER = (Color.GREY, Color.RED, Color.TEAL, Color.MAROON, Color.PINK)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Convert scattered foreground objects into bottom-aligned count bars in a fixed five-color order.\n\n    Input structure\n    The grid has a dominant background color and foreground objects in the task\n    palette: grey, red, teal, maroon, and pink. Objects are monochromatic\n    8-connected components; some palette colors may be absent.\n\n    Rule\n    For each palette color in order grey, red, teal, maroon, pink, count its\n    8-connected objects. Create a background grid with five columns and height\n    equal to the largest count, then fill each column upward from the bottom\n    with its palette color for that count.\n\n    Key insight\n    The output does not preserve object shapes or positions; it is a histogram\n    of per-color 8-connected object counts, using the learned palette order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    palette_set = set(PALETTE_ORDER)\n    assert bg not in palette_set, \"background must not be a histogram color\"\n    assert set(map(int, g.ravel())) <= palette_set | {bg}\n\n    object_counts = [len(components_mask(g == color, connectivity=8)) for color in PALETTE_ORDER]\n    max_count = max(object_counts)\n    assert max_count > 0, \"expected at least one foreground object\"\n\n    out = np.full((max_count, len(PALETTE_ORDER)), bg, dtype=int)\n    for c, (color, count) in enumerate(zip(PALETTE_ORDER, object_counts)):\n        if count:\n            out[-count:, c] = color\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and palette.\nGRID_SHAPE = (10, 10)\nBACKGROUND_COLOR = Color.ORANGE\nN_COLORS = len(PALETTE_ORDER)\n\n# Histogram count sampling.\nNONZERO_COLOR_RANGE = (3, 6)\nMAX_COUNT_RANGE = (2, 7)\nTOTAL_OBJECT_RANGE = (4, 12)\n\n# Blob shape sampling.\nN_BLOB_SHAPES = 6\nLINE_LENGTH_RANGE = (2, 5)\nSMALL_DIM_RANGE = (2, 4)\nGROWN_BLOB_MIN_SIZE = 3\nPLUS_SHAPE_SIZE = 3\n\n# Placement and retry limits.\nSAME_COLOR_MIN_CHEBYSHEV = 2\nBLOB_PLACE_TRIES = 100\nGENERATION_TRIES = 300\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Generate one candidate grid, returning None when placement or validation fails.\"\"\"\n    rng = np.random.default_rng()\n    counts = _sample_counts(rng)\n    if counts is None:\n        return None\n\n    grid = np.full(GRID_SHAPE, BACKGROUND_COLOR, dtype=int)\n    if not _place_all_blobs(grid, counts, rng):\n        return None\n    if not _counts_match_grid(grid, counts):\n        return None\n    if not _solver_matches_expected(grid, counts):\n        return None\n    return grid\n\n\ndef _sample_counts(rng) -> list[int] | None:\n    \"\"\"Sample per-color component counts matching the output histogram contract.\"\"\"\n    n_nonzero = int(rng.integers(*NONZERO_COLOR_RANGE))\n    max_count = int(rng.integers(*MAX_COUNT_RANGE))\n\n    counts = [0] * N_COLORS\n    nonzero_indices = list(rng.choice(N_COLORS, size=n_nonzero, replace=False))\n    max_idx = rng.choice(nonzero_indices)\n    counts[max_idx] = max_count\n\n    remaining_budget = TOTAL_OBJECT_RANGE[1] - max_count\n    for idx in [i for i in nonzero_indices if i != max_idx]:\n        upper = min(max_count, remaining_budget)\n        if upper < 1:\n            counts[idx] = 1\n            remaining_budget -= 1\n        else:\n            counts[idx] = int(rng.integers(1, upper + 1))\n            remaining_budget -= counts[idx]\n\n    total = sum(counts)\n    if total < TOTAL_OBJECT_RANGE[0] or total > TOTAL_OBJECT_RANGE[1]:\n        return None\n    return counts\n\n\ndef _place_all_blobs(grid: np.ndarray, counts: list[int], rng) -> bool:\n    \"\"\"Place each color's requested number of same-color-separated blobs.\"\"\"\n    for color_idx, count in enumerate(counts):\n        if count == 0:\n            continue\n        if not _place_color_blobs(grid, PALETTE_ORDER[color_idx], count, rng):\n            return False\n    return True\n\n\ndef _place_color_blobs(grid: np.ndarray, color: int, count: int, rng) -> bool:\n    placed_blobs = []\n    for _ in range(count):\n        coords = _choose_placeable_blob(grid, placed_blobs, rng)\n        if coords is None:\n            return False\n        _paint_coords(grid, coords, color)\n        placed_blobs.append(coords)\n    return True\n\n\ndef _choose_placeable_blob(grid: np.ndarray, placed_blobs: list[set], rng) -> set | None:\n    for _ in range(BLOB_PLACE_TRIES):\n        blob = _random_blob(rng)\n        bh, bw = blob.shape\n        r0 = int(rng.integers(0, GRID_SHAPE[0] - bh + 1))\n        c0 = int(rng.integers(0, GRID_SHAPE[1] - bw + 1))\n        coords = _offset_blob_coords(blob, r0, c0)\n        if _coords_are_free(grid, coords) and _chebyshev_ok(coords, placed_blobs):\n            return coords\n    return None\n\n\ndef _offset_blob_coords(blob: np.ndarray, r0: int, c0: int) -> set:\n    offsets = np.argwhere(blob)\n    return set(map(tuple, offsets + np.array([r0, c0])))\n\n\ndef _coords_are_free(grid: np.ndarray, coords: set) -> bool:\n    return all(grid[r, c] == BACKGROUND_COLOR for r, c in coords)\n\n\ndef _paint_coords(grid: np.ndarray, coords: set, color: int) -> None:\n    rr, cc = np.array(list(coords)).T\n    grid[rr, cc] = color\n\n\ndef _counts_match_grid(grid: np.ndarray, counts: list[int]) -> bool:\n    \"\"\"Recompute 8-connected components to reject accidental same-color merges.\"\"\"\n    for color, expected_count in zip(PALETTE_ORDER, counts):\n        mask = grid == color\n        if expected_count == 0:\n            if mask.any():\n                return False\n        elif len(components_mask(mask, connectivity=8)) != expected_count:\n            return False\n    return True\n\n\ndef _solver_matches_expected(grid: np.ndarray, counts: list[int]) -> bool:\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return np.array_equal(out, _expected_output(counts))\n\n\ndef _expected_output(counts: list[int]) -> np.ndarray:\n    out = np.full((max(counts), N_COLORS), BACKGROUND_COLOR, dtype=int)\n    for c_idx, (color, count) in enumerate(zip(PALETTE_ORDER, counts)):\n        if count:\n            out[-count:, c_idx] = color\n    return out\n\n\ndef _random_blob(rng) -> np.ndarray:\n    \"\"\"Generate a random small 8-connected blob mask.\"\"\"\n    shape_type = rng.integers(0, N_BLOB_SHAPES)\n\n    if shape_type == 0:\n        return np.array([[True]])\n    elif shape_type == 1:\n        length = int(rng.integers(*LINE_LENGTH_RANGE))\n        return np.ones((1, length), dtype=bool)\n    elif shape_type == 2:\n        length = int(rng.integers(*LINE_LENGTH_RANGE))\n        return np.ones((length, 1), dtype=bool)\n    elif shape_type == 3:\n        return _random_grown_blob(rng)\n    elif shape_type == 4:\n        return _plus_blob()\n    else:\n        h = int(rng.integers(*SMALL_DIM_RANGE))\n        w = int(rng.integers(*SMALL_DIM_RANGE))\n        return np.ones((h, w), dtype=bool)\n\n\ndef _random_grown_blob(rng) -> np.ndarray:\n    \"\"\"Grow a small mask by repeatedly adding an 8-neighbor of existing pixels.\"\"\"\n    h = int(rng.integers(*SMALL_DIM_RANGE))\n    w = int(rng.integers(*SMALL_DIM_RANGE))\n    mask = np.zeros((h, w), dtype=bool)\n    mask[0, 0] = True\n    pixels = [(0, 0)]\n    target_size = int(rng.integers(GROWN_BLOB_MIN_SIZE, h * w + 1))\n    for _ in range(target_size - 1):\n        candidates = _growth_candidates(mask, pixels)\n        if not candidates:\n            break\n        pick = list(candidates)[int(rng.integers(0, len(candidates)))]\n        mask[pick[0], pick[1]] = True\n        pixels.append(pick)\n    return mask\n\n\ndef _growth_candidates(mask: np.ndarray, pixels: list[tuple[int, int]]) -> set:\n    h, w = mask.shape\n    candidates = set()\n    for r, c in pixels:\n        for dr in range(-1, 2):\n            for dc in range(-1, 2):\n                if dr == 0 and dc == 0:\n                    continue\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:\n                    candidates.add((nr, nc))\n    return candidates\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/17829a00.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/17829a00.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste\nimport random\n\n\ndef _is_full_width_border(comp: dict, h: int, w: int) -> bool:\n    r0, c0, r1, c1 = comp[\"bbox\"]\n    return (\n        int(comp[\"area\"]) == int(w)\n        and int(r0) == int(r1)\n        and int(c0) == 0\n        and int(c1) == int(w - 1)\n        and int(r0) in {0, int(h - 1)}\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each colored object vertically until it touches the matching top or bottom border bar.\n\n    Input structure:\n    - The background is the dominant color.\n    - The top row is a full-width bar in one foreground color and the bottom row is a full-width bar in another.\n    - All other foreground pixels are 8-connected monochrome objects whose color matches one of those bars.\n\n    Rule:\n    - Top-bar-colored objects move upward so their bbox top is row 1.\n    - Bottom-bar-colored objects move downward so their bbox bottom is the row above the bottom bar.\n    - A downward-moving one-column segment whose landing overlaps its source becomes the continuous vertical segment swept between them.\n\n    Key insight:\n    The horizontal bars are destination anchors: color determines which border an object slides toward, while columns and object shape are otherwise preserved.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h >= 3 and w >= 1\n\n    bg = int(get_bg(g))\n    top_color = int(g[0, 0])\n    bottom_color = int(g[h - 1, 0])\n\n    assert top_color != bg\n    assert bottom_color != bg\n    assert top_color != bottom_color\n    assert bool(np.all(g[0, :] == top_color))\n    assert bool(np.all(g[h - 1, :] == bottom_color))\n    assert set(map(int, np.unique(g))) == {bg, top_color, bottom_color}\n\n    for c in range(w):\n        top_rows = [r for r in range(1, h - 1) if int(g[r, c]) == top_color]\n        bot_rows = [r for r in range(1, h - 1) if int(g[r, c]) == bottom_color]\n        if top_rows and bot_rows:\n            assert max(top_rows) < min(bot_rows), \"top-color objects must be above bottom-color objects in every column\"\n\n    out = np.full_like(g, bg)\n    out[0, :] = top_color\n    out[h - 1, :] = bottom_color\n\n    for color, target_side in ((top_color, \"top\"), (bottom_color, \"bottom\")):\n        components = find_components(\n            g,\n            bg=bg,\n            connectivity=8,\n            monochromatic=True,\n            colors=[color],\n            return_format=\"dict\",\n        )\n        for comp in components:\n            if _is_full_width_border(comp, h, w):\n                continue\n\n            coords = np.asarray(comp[\"coords\"], dtype=int)\n            r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n            assert 0 < r0 <= r1 < h - 1\n\n            if target_side == \"top\":\n                dr = 1 - r0\n                assert dr <= 0\n                paint = coords + np.array([dr, 0], dtype=int)\n            else:\n                dr = (h - 2) - r1\n                assert dr >= 0\n                paint = coords + np.array([dr, 0], dtype=int)\n                if dr > 0 and r0 + dr <= r1:\n                    assert c0 == c1\n                    rows = np.arange(r0, r1 + dr + 1, dtype=int)\n                    paint = np.column_stack([rows, np.full(rows.shape, c0, dtype=int)])\n\n            assert bool(np.all((0 <= paint[:, 0]) & (paint[:, 0] < h)))\n            assert bool(np.all((0 <= paint[:, 1]) & (paint[:, 1] < w)))\n            assert bool(np.all(out[paint[:, 0], paint[:, 1]] == bg))\n            out[paint[:, 0], paint[:, 1]] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom scipy.ndimage import binary_dilation\n\n# -- Grid constants --\nBG = 7\nH = 16\nW = 16\n\n# -- Sprite geometry --\nSPRITE_AREA_MIN = 1\nSPRITE_AREA_MAX = 6\nSPRITE_H_MAX = 4       # bbox height upper bound (exclusive in range)\nSPRITE_W_MAX = 5       # bbox width upper bound (exclusive in range)\nSPRITE_DENSITY_MIN = 0.33  # min fill ratio inside bbox\n\n# -- Object counts per side --\nOBJ_COUNT_MIN = 3      # per color\nOBJ_COUNT_MAX = 5      # per color (inclusive)\nOBJ_TOTAL_MAX = 9      # top_count + bottom_count\n\n# -- Swept segment (single-column overlap case) --\nSWEPT_PROB = 0.15       # probability of including one swept-segment object\nSWEPT_H_MIN = 2        # min input height for swept column\nSWEPT_H_MAX = 4        # max input height (inclusive)\nSWEPT_TOTAL_MAX = 5    # input_h + offset ceiling\n\n# -- Input derivation --\nSLIDE_OFFSET_MAX = 10  # exclusive upper bound for slide offsets (range(1, N))\n\n# -- Retry budgets --\nPLACE_RETRIES = 60     # sprite placement attempts per object\nGEN_RETRIES = 300      # outer generation attempts\n\n\ndef _corner_path(h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Generate a diagonal path from one corner of an (h,w) bbox to the opposite.\"\"\"\n    if h == 1 and w == 1:\n        return {(0, 0)}\n    r0 = random.choice([0, h - 1])\n    c0 = random.choice([0, w - 1])\n    r1 = h - 1 - r0\n    c1 = w - 1 - c0\n    steps = max(h, w)\n    cells: set[tuple[int, int]] = set()\n    for k in range(steps):\n        t = 0.0 if steps == 1 else k / (steps - 1)\n        cells.add((int(round(r0 + (r1 - r0) * t)),\n                    int(round(c0 + (c1 - c0) * t))))\n    return cells\n\n\ndef _random_sprite(color: int) -> np.ndarray:\n    \"\"\"Create a small random 8-connected sprite with the given color on BG.\"\"\"\n    area = random.randint(SPRITE_AREA_MIN, SPRITE_AREA_MAX)\n    choices = [\n        (sh, sw)\n        for sh in range(1, SPRITE_H_MAX + 1)\n        for sw in range(1, SPRITE_W_MAX + 1)\n        if max(sh, sw) <= area <= sh * sw\n        and area / (sh * sw) >= SPRITE_DENSITY_MIN\n    ]\n    sh, sw = random.choice(choices)\n    cells = _corner_path(sh, sw)\n    while len(cells) < area:\n        frontier = []\n        for r, c in cells:\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    if dr == 0 and dc == 0:\n                        continue\n                    rr, cc = r + dr, c + dc\n                    if 0 <= rr < sh and 0 <= cc < sw and (rr, cc) not in cells:\n                        frontier.append((rr, cc))\n        cells.add(random.choice(frontier))\n\n    sprite = np.full((sh, sw), BG, dtype=int)\n    rs, cs = zip(*cells)\n    sprite[rs, cs] = color\n    return sprite\n\n\ndef _coords_from_patch(patch: np.ndarray, r0: int, c0: int) -> np.ndarray:\n    \"\"\"Return (N,2) absolute coords of non-BG pixels in patch placed at (r0,c0).\"\"\"\n    return np.argwhere(patch != BG) + np.array([r0, c0], dtype=int)\n\n\ndef _is_bar(comp: dict) -> bool:\n    \"\"\"True if a component dict represents a full-width border bar.\"\"\"\n    r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n    return (\n        int(comp[\"area\"]) == W\n        and r0 == r1\n        and c0 == 0\n        and c1 == W - 1\n        and r0 in {0, H - 1}\n    )\n\n\ndef _object_count(grid: np.ndarray, color: int) -> int:\n    \"\"\"Count non-bar objects of the given color.\"\"\"\n    comps = find_components(\n        grid, bg=BG, connectivity=8, monochromatic=True,\n        colors=[color], return_format=\"dict\",\n    )\n    return sum(1 for comp in comps if not _is_bar(comp))\n\n\n_STRUCT8 = np.ones((3, 3), dtype=bool)\n\n\ndef _touches_same(mask: np.ndarray, coords: np.ndarray) -> bool:\n    \"\"\"Check if any coord is 8-adjacent to an existing same-color pixel.\"\"\"\n    probe = np.zeros((H, W), dtype=bool)\n    probe[coords[:, 0], coords[:, 1]] = True\n    dilated = binary_dilation(probe, structure=_STRUCT8)\n    dilated[coords[:, 0], coords[:, 1]] = False  # exclude the coords themselves\n    return bool((dilated & mask).any())\n\n\ndef _place_output_object(out: np.ndarray, color: int, side: str) -> dict | None:\n    \"\"\"Try to place a random sprite on the output grid touching the bar on `side`.\"\"\"\n    for _ in range(PLACE_RETRIES):\n        patch = _random_sprite(color)\n        ph, pw = map(int, patch.shape)\n        r0 = 1 if side == \"top\" else H - 1 - ph\n        cols = list(range(0, W - pw + 1))\n        random.shuffle(cols)\n        for c0 in cols:\n            coords = _coords_from_patch(patch, r0, c0)\n            if bool(np.all(out[coords[:, 0], coords[:, 1]] == BG)):\n                paste(out, patch, r0, c0, transparent=BG)\n                return {\n                    \"color\": color, \"side\": side, \"coords\": coords,\n                    \"height\": ph, \"width\": pw, \"special\": False,\n                }\n    return None\n\n\ndef _place_swept_output_object(out: np.ndarray, color: int) -> dict | None:\n    \"\"\"Try to place a single-column swept-segment bottom object.\"\"\"\n","exit_code":0,"status":"completed"}}
