{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/d968ffd4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Extend each of two aligned rectangular marker objects toward the other, filling half of the gap across the full perpendicular span.\n\n    Input structure\n    - A dominant background contains exactly two solid, same-sized monochromatic rectangles.\n    - The rectangles share either the same row span or the same column span, with a background gap between their facing edges.\n\n    Rule\n    - If the rectangles are side-by-side, color the left half of the inter-object gap across every row with the left object's color, and the right half with the right object's color.\n    - If one rectangle is above the other, color the upper half of the gap across every column with the upper object's color, and the lower half with the lower object's color.\n    - When the gap length is odd, leave the center row/column as background.\n\n    Key insight\n    - The marker objects are endpoints of an axial corridor; their own size identifies the facing edge, while the filled corridor spans the whole grid perpendicular to that axis.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(comps) == 2\n    assert all(_is_solid_rect(g, comp) for comp in comps)\n\n    a, b = comps\n    ar0, ac0, ar1, ac1 = a[\"bbox\"]\n    br0, bc0, br1, bc1 = b[\"bbox\"]\n    assert (ar1 - ar0, ac1 - ac0) == (br1 - br0, bc1 - bc0)\n\n    same_rows = (ar0, ar1) == (br0, br1)\n    same_cols = (ac0, ac1) == (bc0, bc1)\n    assert same_rows != same_cols\n\n    out = g.copy()\n    if same_rows:\n        left, right = sorted(comps, key=lambda comp: comp[\"bbox\"][1])\n        _lr0, _lc0, _lr1, lc1 = left[\"bbox\"]\n        _rr0, rc0, _rr1, _rc1 = right[\"bbox\"]\n        gap = rc0 - lc1 - 1\n        assert gap >= 1\n        span = gap // 2\n        out[:, lc1 + 1 : lc1 + 1 + span] = left[\"color\"]\n        out[:, rc0 - span : rc0] = right[\"color\"]\n    else:\n        top, bottom = sorted(comps, key=lambda comp: comp[\"bbox\"][0])\n        _tr0, _tc0, tr1, _tc1 = top[\"bbox\"]\n        br0, _bc0, _br1, _bc1 = bottom[\"bbox\"]\n        gap = br0 - tr1 - 1\n        assert gap >= 1\n        span = gap // 2\n        out[tr1 + 1 : tr1 + 1 + span, :] = top[\"color\"]\n        out[br0 - span : br0, :] = bottom[\"color\"]\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Layout ranges and bounds.\nALIGNMENTS = (\"H\", \"V\")\nRECT_PERP_BOUNDS = (1, 4)\nRECT_AXIAL_VALUES = range(1, 3)\nGAP_VALUES = range(6, 17)\nAXIAL_BOUNDS = (14, 22)\nMARGIN = 1\nPALETTE = tuple(range(10))\nMAX_GENERATION_ATTEMPTS = 300\nVALID_AXIAL_GAP_PAIRS = tuple(\n    (rect_axial, gap)\n    for rect_axial in RECT_AXIAL_VALUES\n    for gap in GAP_VALUES\n    if AXIAL_BOUNDS[0] <= 2 * rect_axial + gap + 2 * MARGIN <= AXIAL_BOUNDS[1]\n)\n\n\ndef _choose_layout() -> tuple[str, int, int, int]:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/320afe60.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide each foreground object horizontally to the edge indicated by whether its shape has an open notch.\n\n    Input structure:\n    - Yellow is the background and there is one blue foreground color.\n    - The foreground is split into separated 4-connected objects.\n    - Each object keeps its row span and shape in the output.\n\n    Rule:\n    - If an object's bbox border contains a background gap flanked by object pixels along that same border, slide it to the right edge and recolor it green.\n    - Otherwise slide the object to the left edge and recolor it red.\n    - Start from a blank background canvas; no moved objects overlap.\n\n    Key insight:\n    - The target side is encoded by the object's shape, not by its original position: open notches go right, while closed or solid shapes go left.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1, \"expected exactly one foreground color\"\n    fg = int(fg_colors[0])\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg])\n    assert components, \"expected at least one foreground object\"\n\n    out = np.full_like(g, bg)\n    W = g.shape[1]\n    for component in components:\n        bbox = tuple(map(int, component[\"bbox\"]))\n        r0, _c0, r1, _c1 = bbox\n        mask = _component_mask(component[\"coords\"], bbox)\n        h, w = mask.shape\n\n        has_open_notch = _has_flanked_boundary_gap(mask)\n        dst_c = W - w if has_open_notch else 0\n        color = GREEN if has_open_notch else RED\n        assert 0 <= dst_c and dst_c + w <= W, \"moved object must fit within the grid\"\n\n        dst = out[r0 : r1 + 1, dst_c : dst_c + w]\n        assert dst.shape == (h, w), \"destination slice must match object bbox\"\n        assert np.all(dst[mask] == bg), \"moved objects must not overlap\"\n        dst[mask] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and colors.\nBG, BLUE, RED, GREEN = Color.YELLOW, Color.BLUE, Color.RED, Color.GREEN\nGRID_H, GRID_W_MIN, GRID_W_MAX = 22, 19, 26\n\n# Object counts, dimensions, and row separation.\nOBJECT_COUNT_MIN, OBJECT_COUNT_MAX, NOTCH_OBJECT_COUNT = 3, 5, 2\nOBJECT_H_MIN, OBJECT_H_MAX, OBJECT_W_MIN, OBJECT_W_MAX = 2, 6, 2, 9\nMIN_ROW_GAP = 1\n\n# Shape density and carving probabilities.\nMIN_FILL_RATIO, CLOSED_LARGE_AREA_MIN = 0.64, 12\nNOTCH_INTERIOR_CARVE_PROB, EXTRA_CARVE_PROB = 0.45, 0.20\nCLOSED_CARVE_PROB_SMALL, CLOSED_CARVE_PROB_LARGE = 0.45, 0.88\n\n# Placement and retry limits.\nINTERIOR_COL_PAD, MAX_FOREGROUND_FRACTION = 1, 0.5\nGENERATION_RETRIES = 300\n\n\ndef _has_flanked_boundary_gap(mask: np.ndarray) -> bool:\n","exit_code":0,"status":"completed"}}
