{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools, numpy as np\nfrom collections import defaultdict\n\ndef connected(mask):\n    coords=np.argwhere(mask)\n    if len(coords)==0:return False\n    seen={tuple(coords[0])}\n    stack=[tuple(coords[0])]\n    H,W=mask.shape\n    while stack:\n        r,c=stack.pop()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            rr,cc=r+dr,c+dc\n            if 0<=rr<H and 0<=cc<W and mask[rr,cc] and (rr,cc) not in seen:\n                seen.add((rr,cc)); stack.append((rr,cc))\n    return len(seen)==mask.sum()\n\ndef tight(mask):\n    rows=np.any(mask,axis=1); cols=np.any(mask,axis=0)\n    return rows[0] and rows[-1] and cols[0] and cols[-1]\n\ndef rows(mask):\n    return [r for r in range(mask.shape[0]) if mask[r].any()]\n\ndef cols(mask):\n    return [c for c in range(mask.shape[1]) if mask[:,c].any()]\n\ndef has_adj(xs):\n    s=set(xs)\n    return any(x+1 in s for x in s)\n\nmasks=[]\nseen=set()\nfor h in range(1,4):\n  for w in range(1,4):\n    for k in range(2,min(5,h*w)+1):\n      for cells in itertools.combinations(range(h*w),k):\n        m=np.zeros((h,w),dtype=bool)\n        for x in cells:m[x//w,x%w]=1\n        if not tight(m) or not connected(m):\n          continue\n        key=(m.shape,m.tobytes())\n        if key in seen: continue\n        seen.add(key)\n        masks.append(m)\nprint('masks',len(masks))\nres=defaultdict(int)\nexamples=defaultdict(list)\nfor m in masks:\n    same=(np.array_equal(m,m),)\n    hm=np.fliplr(m)\n    vm=np.flipud(m)\n    asym = not np.array_equal(m,hm) and not np.array_equal(m,vm)\n    if asym:\n      for ori in ['H','V']:\n        res[('same',ori)] +=1\n        if len(examples[('same',ori)])<3: examples[('same',ori)].append(m)\n    if not np.array_equal(m,hm) and not np.array_equal(hm,vm):\n      if has_adj(rows(m)):\n        res[('hmirror','H')]+=1\n        if len(examples[('hmirror','H')])<3: examples[('hmirror','H')].append(m)\n      if has_adj(cols(m)) and has_adj(cols(hm)) and set(cols(m)) & set(cols(hm)):\n        res[('hmirror','V')]+=1\n        if len(examples[('hmirror','V')])<3: examples[('hmirror','V')].append(m)\n    if not np.array_equal(m,vm) and not np.array_equal(vm,hm):\n      if set(rows(m)) & set(rows(vm)):\n        res[('vmirror','H')]+=1\n        if len(examples[('vmirror','H')])<3: examples[('vmirror','H')].append(m)\n      if set(cols(m)) & set(cols(vm)):\n        res[('vmirror','V')]+=1\n        if len(examples[('vmirror','V')])<3: examples[('vmirror','V')].append(m)\nprint(res)\nfor k,arrs in examples.items():\n    print('\\\\n',k)\n    for a in arrs:\n        print(a.astype(int), '\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
