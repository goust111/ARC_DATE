xamples[('hmirror','H')].append(m)\n      if has_adj(cols(m)) and has_adj(cols(hm)) and set(cols(m)) & set(cols(hm)):\n        res[('hmirror','V')]+=1\n        if len(examples[('hmirror','V')])<3: examples[('hmirror','V')].append(m)\n    if not np.array_equal(m,vm) and not np.array_equal(vm,hm):\n      if set(rows(m)) & set(rows(vm)):\n        res[('vmirror','H')]+=1\n        if len(examples[('vmirror','H')])<3: examples[('vmirror','H')].append(m)\n      if set(cols(m)) & set(cols(vm)):\n        res[('vmirror','V')]+=1\n        if len(examples[('vmirror','V')])<3: examples[('vmirror','V')].append(m)\nprint(res)\nfor k,arrs in examples.items():\n    print('\\\\n',k)\n    for a in arrs:\n        print(a.astype(int), '\\\\n')\nPY\"","aggregated_output":"masks 62\ndefaultdict(<class 'int'>, {('same', 'H'): 44, ('same', 'V'): 44, ('hmirror', 'H'): 42, ('hmirror', 'V'): 42, ('vmirror', 'H'): 42, ('vmirror', 'V'): 42})\n\n ('same', 'H')\n[[1 1]\n [1 0]] \n\n[[1 1]\n [0 1]] \n\n[[1 0]\n [1 1]] \n\n\n ('same', 'V')\n[[1 1]\n [1 0]] \n\n[[1 1]\n [0 1]] \n\n[[1 0]\n [1 1]] \n\n\n ('hmirror', 'H')\n[[1 1]\n [1 0]] \n\n[[1 1]\n [0 1]] \n\n[[1 0]\n [1 1]] \n\n\n ('hmirror', 'V')\n[[1 1]\n [1 0]] \n\n[[1 1]\n [0 1]] \n\n[[1 0]\n [1 1]] \n\n\n ('vmirror', 'H')\n[[1 1]\n [1 0]] \n\n[[1 1]\n [0 1]] \n\n[[1 0]\n [1 1]] \n\n\n ('vmirror', 'V')\n[[1 1]\n [1 0]] \n\n[[1 1]\n [0 1]] \n\n[[1 0]\n [1 1]] \n\n","exit_code":0,"status":"completed"}}
