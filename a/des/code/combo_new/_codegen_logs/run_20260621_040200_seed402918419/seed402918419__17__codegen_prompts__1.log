{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"先读参考题里 `main()` 和 `generate_input()` 的实现方式，重点看对象识别、随机摆放约束和防退化处理；然后我会按同样的工程风格把新题代码写到指定路径并跑自检。"}}
{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n    Path('/home/lixinyu/snap/new/ARC_code/eval/271d71e2.py'),\n    Path('/home/lixinyu/snap/new/ARC_code/eval/8f215267.py'),\n]\nfor path in files:\n    text = path.read_text().splitlines()\n    print(f'===== {path} =====')\n    starts = []\n    for i, line in enumerate(text):\n        if line.startswith('def main(') or line.startswith('def generate_input('):\n            starts.append(i)\n    starts.append(len(text))\n    for a, b in zip(starts, starts[1:]):\n        for line in text[a:b]:\n            print(line)\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n    Path('/home/lixinyu/snap/new/ARC_code/eval/271d71e2.py'),\n    Path('/home/lixinyu/snap/new/ARC_code/eval/8f215267.py'),\n]\nfor path in files:\n    text = path.read_text().splitlines()\n    print(f'===== {path} =====')\n    starts = []\n    for i, line in enumerate(text):\n        if line.startswith('def main(') or line.startswith('def generate_input('):\n            starts.append(i)\n    starts.append(len(text))\n    for a, b in zip(starts, starts[1:]):\n        for line in text[a:b]:\n            print(line)\n        print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/271d71e2.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move bordered containers toward same-colored destination markers, charging gray cells to orange.\n\n    Input structure:\n    - bg = 6 (magenta). Black-bordered (0) rectangles with gray (5) / orange (7) interiors.\n    - A head sprite (9) sits adjacent to one container edge; a matching destination sprite lies along the movement axis.\n\n    Rule:\n    - Each container translates toward its destination along the head-to-dest axis.\n    - Steps = min(head-to-dest distance, number of gray interior cells).\n    - Gray cells become orange from the head-facing side inward, one per step.\n\n    Key insight: Gray cell count caps movement — a container stops short if it runs out of gray cells to charge.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    BORDER = 0\n    GREY = 5\n    FILL = 7\n    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    # True background is dominant non-border color (border can dominate in some cases).\n    cnt = Counter(map(int, g.flatten()))\n    bg = int(max((c for c in cnt.keys() if int(c) != int(BORDER)), key=lambda c: int(cnt[int(c)])))\n\n    def rect_border_coords(r0: int, c0: int, r1: int, c1: int):\n        for c in range(c0, c1 + 1):\n            yield (r0, c)\n            yield (r1, c)\n        for r in range(r0 + 1, r1):\n            yield (r, c0)\n            yield (r, c1)\n\n    # --- detect containers as rectangles enclosing GREY/FILL with BORDER frame ---\n    containers = []\n    for pts in components_mask((g == GREY) | (g == FILL), connectivity=4):\n        if pts.size == 0:\n            continue\n        ir0, ic0, ir1, ic1 = bbox_coords(pts)\n        r0, c0, r1, c1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)\n        if r0 < 0 or c0 < 0 or r1 >= H or c1 >= W:\n            continue\n        if any(int(g[r, c]) != BORDER for r, c in rect_border_coords(r0, c0, r1, c1)):\n            continue\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        if inner.size == 0 or not bool(np.isin(inner, [GREY, FILL]).all()):\n            continue\n        containers.append({\"box\": (r0, c0, r1, c1)})\n\n    assert not (not containers)\n\n    # head + destination are in some non-bg, non-border color (not GREY/FILL)\n    out = g.copy()\n\n    all_head_colors = [c for c in colors_present(g, exclude={bg, BORDER, GREY, FILL})]\n\n    # Precompute components for each head color.\n    comp_by_color: dict[int, list[dict]] = defaultdict(list)\n    for col in all_head_colors:\n        labc, nc = label(g == int(col), structure=STRUCT4)\n        for k in range(1, int(nc) + 1):\n            coords = np.argwhere(labc == int(k))\n            if coords.size == 0:\n                continue\n            r0, c0, r1, c1 = bbox_coords(coords)\n            pts = {(int(r), int(c)) for r, c in coords}\n            shape = {(int(r - r0), int(c - c0)) for r, c in pts}\n            comp_by_color[int(col)].append({\"pts\": pts, \"shape\": shape, \"tl\": (int(r0), int(c0))})\n\n    def pick_head_for_container(box_):\n        r0, c0, r1, c1 = box_\n        head_seeds = []\n        for r, c in rect_border_coords(r0, c0, r1, c1):\n            for dr, dc in DIR4:\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < H and 0 <= cc < W:\n                    val = int(g[rr, cc])\n                    if val not in (int(bg), int(BORDER), int(GREY), int(FILL)):\n                        head_seeds.append((rr, cc, val))\n        if not head_seeds:\n            return None\n\n        hc = int(Counter(val for _r, _c, val in head_seeds).most_common(1)[0][0])\n        seed_pts = {(r, c) for r, c, val in head_seeds if int(val) == int(hc)}\n        cands = comp_by_color.get(hc, [])\n        comp0 = None\n        for comp in cands:\n            if comp[\"pts\"] & seed_pts:\n                comp0 = comp\n                break\n        if comp0 is None:\n            return None\n\n        # Split head vs destination even if same-color pixels touch:\n        # head pixels are those with minimal manhattan distance to this container border.\n        border_pts = list(rect_border_coords(r0, c0, r1, c1))\n        best_d = None\n        dist = {}\n        for pr, pc in comp0[\"pts\"]:\n            d = min(abs(int(pr - br)) + abs(int(pc - bc)) for br, bc in border_pts)\n            dist[(int(pr), int(pc))] = int(d)\n            if best_d is None or d < best_d:\n                best_d = int(d)\n        if best_d is None:\n            return None\n        head_pts = {p for p, d in dist.items() if int(d) == int(best_d)}\n\n        # direction from head bbox relative to container box\n        coords = np.array(list(head_pts), dtype=int)\n        hr0, hc0, hr1, hc1 = bbox_coords(coords)\n        if hc1 < c0:\n            direction = (0, -1)\n        elif hc0 > c1:\n            direction = (0, 1)\n        elif hr1 < r0:\n            direction = (-1, 0)\n        elif hr0 > r1:\n            direction = (1, 0)\n        else:\n            direction = (0, 0)\n\n        # normalized head shape + top-left\n        r00, c00 = int(hr0), int(hc0)\n        head_shape = {(int(r - r00), int(c - c00)) for r, c in head_pts}\n        return {\n            \"color\": hc,\n            \"head_pts\": head_pts,\n            \"head_shape\": head_shape,\n            \"head_tl\": (r00, c00),\n            \"comp_pts\": set(comp0[\"pts\"]),\n            \"dir\": direction,\n        }\n\n    for cont in containers:\n        box_ = cont[\"box\"]\n        r0, c0, r1, c1 = box_\n\n        head_info = pick_head_for_container(box_)\n        if head_info is None:\n            continue\n        hc = int(head_info[\"color\"])\n        head_pts = set(head_info[\"head_pts\"])\n        head_shape = head_info[\"head_shape\"]\n        head_tl = head_info[\"head_tl\"]\n        comp_pts = set(head_info[\"comp_pts\"])\n        direction = head_info[\"dir\"]\n        if direction == (0, 0):\n            continue\n\n        # destination candidates\n        dests = []\n        for d in comp_by_color.get(hc, []):\n            if d[\"shape\"] != head_shape:\n                continue\n            if d[\"pts\"] == comp_pts:\n                continue\n            dests.append(d)\n\n        # add split-from-same-component destinations (when dest touches head by color)\n        rem = comp_pts - head_pts\n        if rem:\n            mask_rem = np.zeros((H, W), dtype=bool)\n            for rr, cc in rem:\n                mask_rem[int(rr), int(cc)] = True\n            labr, nr = label(mask_rem, structure=STRUCT4)\n            for k in range(1, int(nr) + 1):\n                pts = {(int(r), int(c)) for r, c in np.argwhere(labr == int(k))}\n                if not pts:\n                    continue\n                # reject if adjacent to BORDER\n                adj = False\n                for r, c in pts:\n                    for dr, dc in DIR4:\n                        rr, cc = int(r + dr), int(c + dc)\n                        if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(BORDER):\n                            adj = True\n                            break\n                    if adj:\n                        break\n                if adj:\n                    continue\n                rs = [r for r, _c in pts]\n                cs = [c for _r, c in pts]\n                r00, c00 = int(min(rs)), int(min(cs))\n                shp = {(int(r - r00), int(c - c00)) for r, c in pts}\n                if shp != head_shape:\n                    continue\n                dests.append({\"pts\": pts, \"shape\": shp, \"tl\": (r00, c00)})\n\n        if not dests:\n            continue\n\n        best = None\n        best_dest = None\n        for d in dests:\n            tr0 = int(d[\"tl\"][0] - head_tl[0])\n            tc0 = int(d[\"tl\"][1] - head_tl[1])\n            if direction[0] != 0 and tc0 != 0:\n                continue\n            if direction[1] != 0 and tr0 != 0:\n                continue\n            if direction[0] == 1 and tr0 <= 0:\n                continue\n            if direction[0] == -1 and tr0 >= 0:\n                continue\n            if direction[1] == 1 and tc0 <= 0:\n                continue\n            if direction[1] == -1 and tc0 >= 0:\n                continue\n            dist = abs(tr0) + abs(tc0)\n            if best is None or dist < best:\n                best = dist\n                best_dest = d\n        if best_dest is None:\n            continue\n\n        # translation to overlap head onto destination, capped by number of GREY cells\n        tr0 = int(best_dest[\"tl\"][0] - head_tl[0])\n        tc0 = int(best_dest[\"tl\"][1] - head_tl[1])\n        steps = abs(tr0) + abs(tc0)\n\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        grey_coords = [\n            (int(r0 + 1 + rr), int(c0 + 1 + cc))\n            for rr in range(inner.shape[0])\n            for cc in range(inner.shape[1])\n            if int(inner[rr, cc]) == GREY\n        ]\n        steps = min(int(steps), int(len(grey_coords)))\n\n        dr, dc = direction\n        tr = int(dr * steps)\n        tc = int(dc * steps)\n\n        # choose which greys to fill in order from head side inward\n        if direction == (0, 1):\n            order = sorted(grey_coords, key=lambda p: (-p[1], p[0]))\n        elif direction == (0, -1):\n            order = sorted(grey_coords, key=lambda p: (p[1], -p[0]))\n        elif direction == (1, 0):\n            order = sorted(grey_coords, key=lambda p: (-p[0], -p[1]))\n        else:  # (-1,0)\n            order = sorted(grey_coords, key=lambda p: (p[0], p[1]))\n        to_fill = set(order[:steps])\n\n        # erase original container rect and original head pixels (destination stays)\n        out[r0 : r1 + 1, c0 : c1 + 1] = int(bg)\n        for r, c in head_pts:\n            if int(out[int(r), int(c)]) == int(hc):\n                out[int(r), int(c)] = int(bg)\n\n        # stamp moved container rectangle (using paste for the bulk placement)\n        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        if to_fill:\n            for rr, cc in to_fill:\n                pr = int(rr - r0)\n                pc = int(cc - c0)\n                if 0 <= pr < patch.shape[0] and 0 <= pc < patch.shape[1] and int(patch[pr, pc]) == GREY:\n                    patch[pr, pc] = int(FILL)\n        paste(out, patch, int(r0 + tr), int(c0 + tc), clip=True)\n\n        # stamp moved head pixels\n        for r, c in head_pts:\n            rrr = int(r + tr)\n            ccc = int(c + tc)\n            if 0 <= rrr < H and 0 <= ccc < W:\n                out[rrr, ccc] = int(hc)\n\n    return out\n\n# --------------- generator (attempt 2, Claude) ---------------\n\nBG = 6\nBORDER = 0\nGREY = 5\nORANGE = 7\nHEAD_COLOR = 9\n\n# Direction mapping: head_side -> (dr, dc) movement direction\n# head on top -> container moves up; head on bottom -> moves down, etc.\nSIDE_TO_DIR = {0: (-1, 0), 1: (1, 0), 2: (0, -1), 3: (0, 1)}\n\n\ndef _interior_fill_order(inner_h: int, inner_w: int, head_side: int) -> list[tuple[int, int]]:\n    \"\"\"Return interior cell coords (local to inner rect) in fill order from head-facing side inward.\n    Matches the solver's grey sort keys exactly.\"\"\"\n    cells = [(r, c) for r in range(inner_h) for c in range(inner_w)]\n    if head_side == 3:    # right, direction (0,1): key (-col, row)\n        cells.sort(key=lambda p: (-p[1], p[0]))\n    elif head_side == 2:  # left, direction (0,-1): key (col, -row)\n        cells.sort(key=lambda p: (p[1], -p[0]))\n    elif head_side == 1:  # bottom, direction (1,0): key (-row, -col)\n        cells.sort(key=lambda p: (-p[0], -p[1]))\n    else:                 # top, direction (-1,0): key (row, col)\n        cells.sort(key=lambda p: (p[0], p[1]))\n    return cells\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n_containers = random.randint(2, 4)\n    n_decoys = random.choice([0, 0, 1])  # 0 or 1, slight bias toward 0\n    n_movers = n_containers - n_decoys\n    if n_movers < 1:\n        n_movers = 1\n        n_decoys = n_containers - 1\n\n    # Build container specs\n    specs = []\n    for i in range(n_containers):\n        is_decoy = (i >= n_movers)\n        inner_h = random.randint(1, 8)\n        inner_w = random.randint(1, 5)\n        inner_area = inner_h * inner_w\n        head_side = random.randint(0, 3)\n        outer_h = inner_h + 2\n        outer_w = inner_w + 2\n\n        if is_decoy:\n            initial_orange = inner_area\n            grey = 0\n            gap = random.randint(0, 6)\n            steps = 0\n        else:\n            grey = random.randint(1, inner_area)\n            initial_orange = inner_area - grey\n            gap = random.randint(0, 10)\n            h2d = gap + 1\n            steps = min(grey, h2d)\n\n        # Head length = container edge length along head direction\n        if head_side in (0, 1):\n            head_len = outer_w\n        else:\n            head_len = outer_h\n\n        specs.append({\n            'inner_h': inner_h, 'inner_w': inner_w,\n            'outer_h': outer_h, 'outer_w': outer_w,\n            'head_side': head_side, 'gap': gap, 'steps': steps,\n            'initial_orange': initial_orange, 'grey': grey,\n            'head_len': head_len, 'is_decoy': is_decoy,\n        })\n\n    # Compute assembly bounding boxes (in input position)\n    # Assembly = dest_line + gap + head_line + container\n    assemblies = []\n    for s in specs:\n        oh, ow = s['outer_h'], s['outer_w']\n        hs = s['head_side']\n        gap = s['gap']\n\n        if hs == 0:  # top: dest above head above container\n            total_h = 1 + gap + 1 + oh  # dest + gap + head + container\n            total_w = ow\n            cont_r = gap + 2  # container top row within assembly\n            cont_c = 0\n        elif hs == 1:  # bottom: container above head above dest\n            total_h = oh + 1 + gap + 1\n            total_w = ow\n            cont_r = 0\n            cont_c = 0\n        elif hs == 2:  # left: dest left of head left of container\n            total_h = oh\n            total_w = 1 + gap + 1 + ow\n            cont_r = 0\n            cont_c = gap + 2\n        else:  # right: container left of head left of dest\n            total_h = oh\n            total_w = ow + 1 + gap + 1\n            cont_r = 0\n            cont_c = 0\n\n        assemblies.append({**s, 'total_h': total_h, 'total_w': total_w,\n                           'cont_r': cont_r, 'cont_c': cont_c})\n\n    # Determine grid size\n    total_area = sum(a['total_h'] * a['total_w'] for a in assemblies)\n    min_side = max(8, int(total_area ** 0.5) + 2)\n    max_side = min(26, min_side + 8)\n    max_asm_h = max(a['total_h'] for a in assemblies)\n    max_asm_w = max(a['total_w'] for a in assemblies)\n\n    lo_h = max(8, max_asm_h + 2)\n    hi_h = max(lo_h, min(26, max_side + 4))\n    lo_w = max(8, max_asm_w + 2)\n    hi_w = max(lo_w, min(26, max_side + 4))\n\n    if lo_h > 26 or lo_w > 26:\n        return None\n\n    grid_h = random.randint(lo_h, min(26, hi_h))\n    grid_w = random.randint(lo_w, min(26, hi_w))\n\n    # Place assemblies with 1-cell bg gap between them\n    occupied = np.zeros((grid_h, grid_w), dtype=bool)\n    placements = []\n\n    for a in assemblies:\n        th, tw = a['total_h'], a['total_w']\n        if th > grid_h or tw > grid_w:\n            return None\n        placed = False\n        for _ in range(300):\n            r0 = random.randint(0, grid_h - th)\n            c0 = random.randint(0, grid_w - tw)\n            cr0 = max(0, r0 - 1)\n            cc0 = max(0, c0 - 1)\n            cr1 = min(grid_h, r0 + th + 1)\n            cc1 = min(grid_w, c0 + tw + 1)\n            if not occupied[cr0:cr1, cc0:cc1].any():\n                occupied[r0:r0+th, c0:c0+tw] = True\n                placements.append((r0, c0))\n                placed = True\n                break\n        if not placed:\n            return None\n\n    # Build input grid\n    grid = np.full((grid_h, grid_w), BG, dtype=int)\n\n    for a, (pr, pc) in zip(assemblies, placements):\n        oh, ow = a['outer_h'], a['outer_w']\n        hs = a['head_side']\n        gap = a['gap']\n        steps = a['steps']\n        inner_h, inner_w = a['inner_h'], a['inner_w']\n        initial_orange = a['initial_orange']\n\n        # Container top-left in grid coords\n        cr = pr + a['cont_r']\n        cc = pc + a['cont_c']\n\n        # Draw container border\n        grid[cr, cc:cc+ow] = BORDER\n        grid[cr+oh-1, cc:cc+ow] = BORDER\n        grid[cr:cr+oh, cc] = BORDER\n        grid[cr:cr+oh, cc+ow-1] = BORDER\n\n        # Fill interior\n        fill_order = _interior_fill_order(inner_h, inner_w, hs)\n        interior = np.full((inner_h, inner_w), GREY, dtype=int)\n        for idx_cell in range(initial_orange):\n            r, c = fill_order[idx_cell]\n            interior[r, c] = ORANGE\n        grid[cr+1:cr+1+inner_h, cc+1:cc+1+inner_w] = interior\n\n        # Draw head line\n        if hs == 0:\n            grid[cr-1, cc:cc+ow] = HEAD_COLOR\n        elif hs == 1:\n            grid[cr+oh, cc:cc+ow] = HEAD_COLOR\n        elif hs == 2:\n            grid[cr:cr+oh, cc-1] = HEAD_COLOR\n        else:\n            grid[cr:cr+oh, cc+ow] = HEAD_COLOR\n\n        # Draw dest line\n        if hs == 0:\n            grid[cr-2-gap, cc:cc+ow] = HEAD_COLOR\n        elif hs == 1:\n            grid[cr+oh+1+gap, cc:cc+ow] = HEAD_COLOR\n        elif hs == 2:\n            grid[cr:cr+oh, cc-2-gap] = HEAD_COLOR\n        else:\n            grid[cr:cr+oh, cc+ow+1+gap] = HEAD_COLOR\n\n    # Validate with solver\n    try:\n        output = main(grid)\n    except Exception:\n        return None\n\n    # Build expected output manually and compare\n    expected = grid.copy()\n    for a, (pr, pc) in zip(assemblies, placements):\n        oh, ow = a['outer_h'], a['outer_w']\n        hs = a['head_side']\n        steps = a['steps']\n        inner_h, inner_w = a['inner_h'], a['inner_w']\n        initial_orange = a['initial_orange']\n        dr, dc = SIDE_TO_DIR[hs]\n\n        cr = pr + a['cont_r']\n        cc = pc + a['cont_c']\n\n        if steps == 0:\n            continue\n\n        # Erase original container + head\n        expected[cr:cr+oh, cc:cc+ow] = BG\n        if hs == 0:\n            expected[cr-1, cc:cc+ow] = BG\n        elif hs == 1:\n            expected[cr+oh, cc:cc+ow] = BG\n        elif hs == 2:\n            expected[cr:cr+oh, cc-1] = BG\n        else:\n            expected[cr:cr+oh, cc+ow] = BG\n\n        # New position\n        nr = cr + dr * steps\n        nc = cc + dc * steps\n\n        # Build moved container patch with converted cells\n        fill_order = _interior_fill_order(inner_h, inner_w, hs)\n        interior = np.full((inner_h, inner_w), GREY, dtype=int)\n        for idx_cell in range(initial_orange + steps):\n            r, c = fill_order[idx_cell]\n            interior[r, c] = ORANGE\n        patch = np.full((oh, ow), BORDER, dtype=int)\n        patch[1:-1, 1:-1] = interior\n        expected[nr:nr+oh, nc:nc+ow] = patch\n\n        # Move head\n        if hs == 0:\n            expected[nr-1, nc:nc+ow] = HEAD_COLOR\n        elif hs == 1:\n            expected[nr+oh, nc:nc+ow] = HEAD_COLOR\n        elif hs == 2:\n            expected[nr:nr+oh, nc-1] = HEAD_COLOR\n        else:\n            expected[nr:nr+oh, nc+ow] = HEAD_COLOR\n\n    if not np.array_equal(output, expected):\n        return None\n\n    return grid\n\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid after 300 attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/8f215267.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count same-color patterns per frame and represent the tally as dots inside.\n\n    Input structure:\n    - bg = most common color.\n    - Hollow rectangular frames in various colors.\n    - Small monochrome pattern sprites scattered outside frames.\n\n    Rule:\n    - Remove all small patterns from the grid.\n    - For each frame of color C, count how many patterns share color C.\n    - Draw that many dots along the frame's center row, spaced by 2, starting from the right.\n\n    Key insight: Frames act as tally displays — scattered same-color patterns are \"absorbed\" and their count is shown as interior dots.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    out = g.copy()\n    bg = int(get_bg(g))\n\n    regions = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n\n    frames: list[dict] = []\n    patterns: list[dict] = []\n    for comp in regions:\n        b = comp[\"bbox\"]\n        h = bbox_h(b)\n        w = bbox_w(b)\n        area = int(comp[\"area\"])\n        is_frame = (h >= 5) and (w >= 5) and (area < (h * w * 0.7))\n        if is_frame:\n            frames.append(comp)\n        else:\n            patterns.append(comp)\n\n    # Remove patterns from output.\n    for p in patterns:\n        for r, c in p[\"coords\"]:\n            out[int(r), int(c)] = bg\n\n    # For each frame, count matching patterns and draw dots.\n    for f in frames:\n        col = int(f[\"color\"])\n        num_patterns = sum(1 for p in patterns if int(p[\"color\"]) == col)\n        if num_patterns <= 0:\n            continue\n\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        r_mid = (r0 + r1) // 2\n        for i in range(int(num_patterns)):\n            cc = int(c1 - 2 - 2 * i)\n            if cc > int(c0):\n                out[int(r_mid), int(cc)] = col\n\n    return out\n\n# --------------- generator (codex-att2) ---------------\n\n# --- layout geometry ---\nFRAME_H = 5                    # frame height (rows)\nFRAME_W = 11                   # frame width (cols)\nFRAME_R0 = 1                   # top-left row of first frame\nFRAME_C0 = 1                   # top-left col of all frames\nFRAME_GAP = 2                  # bg rows between consecutive frames\nGRID_W = 23                    # fixed grid width\nRIGHT_C0 = 13                  # first column of the right (sprite) region\nRIGHT_W = 9                    # width of the right region\n\n# --- structural counts ---\nN_FRAMES_RANGE = (3, 5)        # [lo, hi) for number of frames\nN_DISTRACTORS_RANGE = (1, 3)   # [lo, hi) for distractor sprite count\nTOTAL_PATTERNS_RANGE = (5, 11) # [lo, hi) for total sprite count\nMAX_DOTS_PER_FRAME = 4         # max dot tally inside one frame\nBOTTOM_PAD_RANGE = (0, 7)      # [lo, hi) extra bg rows when n_frames==3\n\n# --- sprite shape ---\nSPRITE_AREA_RANGE = (2, 9)     # [lo, hi) connected-cell count per sprite\nSPRITE_MAX_H = 4               # max bbox height for sprite\nSPRITE_MAX_W = 3               # max bbox width for sprite\nSPRITE_PADDING = 1             # gap between placed sprites\n\n# --- retry budget ---\nMAX_ATTEMPTS = 300\n\n\ndef _frame_patch(color: int, bg: int, n_dots: int) -> np.ndarray:\n    \"\"\"Build a FRAME_H x FRAME_W hollow rectangle with n_dots on the center row.\"\"\"\n    patch = np.full((FRAME_H, FRAME_W), bg, dtype=int)\n    patch[0, :] = color\n    patch[-1, :] = color\n    patch[:, 0] = color\n    patch[:, -1] = color\n    mid_r = FRAME_H // 2\n    dot_cols = [FRAME_W - 3 - 2 * i for i in range(n_dots)]\n    patch[mid_r, dot_cols] = color\n    return patch\n\n\ndef _sample_counts(rng: np.random.Generator, n_frames: int, total_match: int) -> list[int]:\n    \"\"\"Distribute total_match sprites across n_frames, each capped at MAX_DOTS_PER_FRAME.\"\"\"\n    counts = [0] * n_frames\n    order = rng.permutation(n_frames)\n    remaining = total_match\n    for pos, idx in enumerate(order):\n        frames_left = n_frames - pos - 1\n        lo = max(0, remaining - MAX_DOTS_PER_FRAME * frames_left)\n        hi = min(MAX_DOTS_PER_FRAME, remaining)\n        val = int(rng.integers(lo, hi + 1))\n        counts[int(idx)] = val\n        remaining -= val\n    return counts\n\n\ndef _grow_sprite(rng: np.random.Generator, h: int, w: int, area: int) -> list[tuple[int, int]]:\n    \"\"\"Grow a connected polyomino of the given area inside an h x w bounding box.\"\"\"\n    seed = (int(rng.integers(0, h)), int(rng.integers(0, w)))\n    cells = {seed}\n    while len(cells) < area:\n        frontier = []\n        for r, c in cells:\n            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                nb = (r + dr, c + dc)\n                if 0 <= nb[0] < h and 0 <= nb[1] < w and nb not in cells:\n                    frontier.append(nb)\n        cells.add(frontier[int(rng.integers(0, len(frontier)))])\n    return list(cells)\n\n\ndef _make_sprite(rng: np.random.Generator, color: int, bg: int) -> np.ndarray:\n    \"\"\"Generate a small random connected sprite, tight-cropped to its bounding box.\"\"\"\n    area = int(rng.integers(*SPRITE_AREA_RANGE))\n    dims = [(h, w) for h in range(1, SPRITE_MAX_H + 1)\n            for w in range(1, SPRITE_MAX_W + 1) if h * w >= area]\n    h, w = dims[int(rng.integers(0, len(dims)))]\n    cells = _grow_sprite(rng, h, w, area)\n    rs, cs = zip(*cells)\n    r_min, c_min = min(rs), min(cs)\n    patch = np.full((max(rs) - r_min + 1, max(cs) - c_min + 1), bg, dtype=int)\n    for r, c in cells:\n        patch[r - r_min, c - c_min] = color\n    return patch\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    # --- choose structure ---\n    n_frames = int(rng.integers(*N_FRAMES_RANGE))\n    n_distractors = int(rng.integers(*N_DISTRACTORS_RANGE))\n    total_patterns = int(rng.integers(*TOTAL_PATTERNS_RANGE))\n    total_match = total_patterns - n_distractors\n\n    palette = rng.choice(np.arange(10), size=1 + n_frames + n_distractors, replace=False)\n    bg = int(palette[0])\n    frame_colors = [int(x) for x in palette[1 : 1 + n_frames]]\n    distractor_colors = [int(x) for x in palette[1 + n_frames :]]\n\n    counts = _sample_counts(rng, n_frames, total_match)\n    bottom_pad = int(rng.integers(*BOTTOM_PAD_RANGE)) if n_frames == 3 else 0\n    height = FRAME_R0 + n_frames * FRAME_H + (n_frames - 1) * FRAME_GAP + bottom_pad\n\n    # --- build output (frames with dots) ---\n    out = np.full((height, GRID_W), bg, dtype=int)\n    frame_rows: list[int] = []\n    for i, (color, count) in enumerate(zip(frame_colors, counts)):\n        r0 = FRAME_R0 + i * (FRAME_H + FRAME_GAP)\n        frame_rows.append(r0)\n        paste(out, _frame_patch(color, bg, count), r0, FRAME_C0)\n\n    # --- derive input (dots removed, sprites placed right) ---\n    inp = out.copy()\n    for r0, count in zip(frame_rows, counts):\n        mid_r = r0 + FRAME_H // 2\n        dot_cols = [FRAME_C0 + FRAME_W - 3 - 2 * i for i in range(count)]\n        inp[mid_r, dot_cols] = bg\n\n    right_canvas = np.full((height, RIGHT_W), bg, dtype=int)\n    pattern_colors = [c for c, n in zip(frame_colors, counts) for _ in range(n)]\n    pattern_colors.extend(distractor_colors)\n    rng.shuffle(pattern_colors)\n\n    try:\n        for color in pattern_colors:\n            sprite = _make_sprite(rng, color, bg)\n            r0, c0 = random_free_location(\n                right_canvas, sprite, transparent=bg,\n                padding=SPRITE_PADDING, padding_connectivity=8,\n            )\n            paste(right_canvas, sprite, r0, c0, transparent=bg)\n    except ValueError:\n        return None\n\n    paste(inp, right_canvas, 0, RIGHT_C0, transparent=bg)\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"failed to generate a valid input after {MAX_ATTEMPTS} attempts\")\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n    Path('/home/lixinyu/snap/new/ARC_code/train/3d588dc9.py'),\n    Path('/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py'),\n]\nfor path in files:\n    text = path.read_text().splitlines()\n    print(f'===== {path} =====')\n    starts = []\n    for i, line in enumerate(text):\n        if line.startswith('def main(') or line.startswith('def generate_input('):\n            starts.append(i)\n    starts.append(len(text))\n    for a, b in zip(starts, starts[1:]):\n        for line in text[a:b]:\n            print(line)\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n    Path('/home/lixinyu/snap/new/ARC_code/train/3d588dc9.py'),\n    Path('/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py'),\n]\nfor path in files:\n    text = path.read_text().splitlines()\n    print(f'===== {path} =====')\n    starts = []\n    for i, line in enumerate(text):\n        if line.startswith('def main(') or line.startswith('def generate_input('):\n            starts.append(i)\n    starts.append(len(text))\n    for a, b in zip(starts, starts[1:]):\n        for line in text[a:b]:\n            print(line)\n        print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/train/3d588dc9.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace the active black cutout's tail with background and mark the cutout side facing a colored source region.\n\n    Input structure:\n    - The dominant color is background, with black rectangle-plus-tail cutouts, one gray source region, and colored distractors.\n    - Non-gray colored regions and single pixels are distractors/blockers, even when they are multi-pixel staircase shapes.\n\n    Rule:\n    - Find each black cutout whose largest solid rectangle leaves exactly a two-pixel tail.\n    - The active gray source region is visible only by horizontal rays through background from a cutout's left or right side.\n    - Select the unique cutout side with the most same-source visible rows, erase that cutout's tail to background, and recolor the full selected vertical side pink (6).\n\n    Key insight:\n    - The colored regions do not move; their horizontal line-of-sight identifies which rectangular cutout is being opened and which side receives the pink mark.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    _distractor_source_components(bg, comps)\n    sources = _source_components(bg, comps)\n\n    source_ids: dict[tuple[int, int], int] = {}\n    for source_id, source in enumerate(sources):\n        for r, c in source[\"coords\"]:\n            source_ids[(int(r), int(c))] = int(source_id)\n\n    candidates: list[tuple[int, tuple[int, int, int, int, list[tuple[int, int]]], str]] = []\n    for comp in comps:\n        if int(comp[\"color\"]) != CUTOUT_COLOR:\n            continue\n        core_tail = _core_and_tail(g, comp)\n        if core_tail is None:\n            continue\n\n        r0, c0, r1, c1, _tail = core_tail\n        side_hits: list[tuple[int, str]] = []\n        for side, side_col, dc in ((\"left\", c0, -1), (\"right\", c1, 1)):\n            hits = _visible_source_ids(g, bg, source_ids, range(r0, r1 + 1), side_col, dc)\n            if hits:\n                assert len(set(hits)) == 1, \"one side must see at most one source region\"\n                side_hits.append((len(hits), side))\n\n        if side_hits:\n            max_hits = max(hit_count for hit_count, _side in side_hits)\n            winning_sides = [side for hit_count, side in side_hits if hit_count == max_hits]\n            assert len(winning_sides) == 1, \"active cutout side must be unique\"\n            candidates.append((max_hits, core_tail, winning_sides[0]))\n\n    assert candidates, \"one black cutout must be horizontally visible from a source\"\n    max_hits = max(hit_count for hit_count, _core_tail, _side in candidates)\n    winners = [candidate for candidate in candidates if candidate[0] == max_hits]\n    assert len(winners) == 1, \"active cutout must be unique\"\n\n    _hit_count, core_tail, side = winners[0]\n    r0, c0, r1, c1, tail = core_tail\n\n    out = g.copy()\n    for r, c in tail:\n        out[r, c] = bg\n\n    mark_col = c0 if side == \"left\" else c1\n    out[r0 : r1 + 1, mark_col] = MARK_COLOR\n    return out\n\n# --------------- generator (refactored att1, Claude) ---------------\n\n# Grid and colors.\nBG = 7\nBLACK = 0\nGRID_SIZE = 16\nGRID_SHAPE = (GRID_SIZE, GRID_SIZE)\nSOURCE_COLOR = 5\nDISTRACTOR_COLORS = [1, 2, 3, 4, 8, 9]\nAVAILABLE_COLORS = [SOURCE_COLOR] + DISTRACTOR_COLORS\n\n# Staircase geometry and edge placement.\nSTAIR_HEIGHT_RANGE = (3, 5)\nSTAIR_MAX_WIDTH = 8\nSTAIR_WIDTH_EXTRA = 4\nEDGE_SIDES = (\"left\", \"right\")\nLEFT_CORNERS = (\"tl\", \"bl\")\nRIGHT_CORNERS = (\"tr\", \"br\")\n\n# Cutout geometry and line-of-sight requirements.\nCORE_SHAPES = ((3, 4), (4, 3))\nTAIL_DIRECTIONS = (\"top\", \"bottom\", \"left\", \"right\")\nFOUR_CELL_MIDDLE_OFFSETS = [1, 2]\nMIN_SOURCE_HITS = 2\nLOS_GAP = 1\nOBJECT_PADDING = 1\n\n# Retry counts and optional-object rates.\nSECOND_CUTOUT_RETRIES = 50\nDISTRACTOR_STAIR_RETRIES = 50\nSINGLE_PIXEL_RETRIES = 30\nEXTRA_BLACK_RETRIES = 20\nGENERATE_RETRIES = 300\nSINGLE_PIXEL_COUNT_RANGE = (1, 2)\nEXTRA_BLACK_PROB = 0.3\n\n\ndef _random_stair_width(height: int) -> int:\n    return random.randint(height, min(STAIR_MAX_WIDTH, height + STAIR_WIDTH_EXTRA))\n\n\ndef _edge_col(side: str, width: int) -> int:\n    return 0 if side == \"left\" else GRID_SIZE - width\n\n\ndef _corner_choices(side: str) -> tuple[str, str]:\n    return LEFT_CORNERS if side == \"left\" else RIGHT_CORNERS\n\n\ndef _make_staircase(height: int, width: int, corner: str, color: int) -> np.ndarray:\n    arr = np.full((height, width), BG, dtype=int)\n    for i in range(height):\n        length = width - i\n        row = i if corner in (\"tl\", \"tr\") else height - 1 - i\n        if corner in (\"tl\", \"bl\"):\n            arr[row, :length] = color\n        else:\n            arr[row, width - length :] = color\n    return arr\n\n\ndef _paste_non_bg_patch(grid: np.ndarray, patch: np.ndarray, row: int, col: int) -> None:\n    mask = patch != BG\n    region = grid[row : row + patch.shape[0], col : col + patch.shape[1]]\n    region[mask] = patch[mask]\n\n\ndef _can_paste_non_bg_patch(grid: np.ndarray, patch: np.ndarray, row: int, col: int) -> bool:\n    mask = patch != BG\n    region = grid[row : row + patch.shape[0], col : col + patch.shape[1]]\n    return not bool(np.any(region[mask] != BG))\n\n\ndef _paint_cells(grid: np.ndarray, cells: list[tuple[int, int]], color: int) -> None:\n    for r, c in cells:\n        grid[r, c] = color\n\n\ndef _cells_in_bounds(cells: list[tuple[int, int]]) -> bool:\n    return all(0 <= r < GRID_SIZE and 0 <= c < GRID_SIZE for r, c in cells)\n\n\ndef _cells_are_bg(grid: np.ndarray, cells: list[tuple[int, int]]) -> bool:\n    return all(int(grid[r, c]) == BG for r, c in cells)\n\n\ndef _place_source_staircase(grid: np.ndarray) -> tuple[str, int, int, int, int]:\n    \"\"\"Place the gray staircase and return side, height, width, row, and column.\"\"\"\n    height = random.randint(*STAIR_HEIGHT_RANGE)\n    width = _random_stair_width(height)\n    side = random.choice(EDGE_SIDES)\n    row = random.randint(0, GRID_SIZE - 1 - height)\n    corner = random.choice(_corner_choices(side))\n    col = _edge_col(side, width)\n    patch = _make_staircase(height, width, corner, SOURCE_COLOR)\n    grid[row : row + height, col : col + width] = patch\n    return side, height, width, row, col\n\n\ndef _count_ray_hits(grid: np.ndarray, rows: range, start_col: int, step: int) -> int:\n    hits = 0\n    for r in rows:\n        c = start_col\n        while 0 <= c < GRID_SIZE:\n            value = int(grid[r, c])\n            if value == BG:\n                c += step\n                continue\n            if value == SOURCE_COLOR:\n                hits += 1\n            break\n    return hits\n\n\ndef _count_cutout_side_hits(\n    grid: np.ndarray,\n    row: int,\n    col: int,\n    height: int,\n    width: int,\n    side: str,\n) -> int:\n    if side == \"left\":\n        return _count_ray_hits(grid, range(row, row + height), col - 1, -1)\n    return _count_ray_hits(grid, range(row, row + height), col + width, 1)\n\n\ndef _middle_coord(start: int, size: int) -> int:\n    if size == 3:\n        return start + 1\n    if size == 4:\n        return start + random.choice(FOUR_CELL_MIDDLE_OFFSETS)\n    return start + size // 2\n\n\ndef _tail_cells(row: int, col: int, height: int, width: int, direction: str) -> list[tuple[int, int]]:\n    mid_row = _middle_coord(row, height)\n    mid_col = _middle_coord(col, width)\n    if direction == \"top\":\n        return [(row - 1, mid_col), (row - 2, mid_col)]\n    if direction == \"bottom\":\n        return [(row + height, mid_col), (row + height + 1, mid_col)]\n    if direction == \"left\":\n        return [(mid_row, col - 1), (mid_row, col - 2)]\n    return [(mid_row, col + width), (mid_row, col + width + 1)]\n\n\ndef _choose_tail_cells(\n    grid: np.ndarray,\n    row: int,\n    col: int,\n    height: int,\n    width: int,\n    blocked_side: str | None = None,\n) -> list[tuple[int, int]] | None:\n    directions = list(TAIL_DIRECTIONS)\n    random.shuffle(directions)\n    for direction in directions:\n        cells = _tail_cells(row, col, height, width, direction)\n        valid = _cells_in_bounds(cells) and _cells_are_bg(grid, cells)\n        if direction == blocked_side:\n            continue\n        if valid:\n            return cells\n    return None\n\n\ndef _place_winning_cutout(\n    grid: np.ndarray,\n    stair_side: str,\n    stair_height: int,\n    stair_width: int,\n    stair_row: int,\n    stair_col: int,\n) -> int | None:\n    \"\"\"Place the source-facing cutout and return its line-of-sight hit count.\"\"\"\n    core_h, core_w = random.choice(CORE_SHAPES)\n    r_lo = max(0, stair_row + MIN_SOURCE_HITS - core_h)\n    r_hi = min(GRID_SIZE - core_h, stair_row + stair_height - MIN_SOURCE_HITS)\n    if r_lo > r_hi:\n        return None\n\n    core_r = random.randint(r_lo, r_hi)\n    if stair_side == \"left\":\n        min_col = stair_width + LOS_GAP\n        max_col = GRID_SIZE - core_w\n        if min_col > max_col:\n            return None\n        core_c = random.randint(min_col, max_col)\n    else:\n        max_col = stair_col - core_w - LOS_GAP\n        if max_col < 0:\n            return None\n        core_c = random.randint(0, max_col)\n\n    winning_hits = _count_cutout_side_hits(grid, core_r, core_c, core_h, core_w, stair_side)\n    if winning_hits < MIN_SOURCE_HITS:\n        return None\n\n    grid[core_r : core_r + core_h, core_c : core_c + core_w] = BLACK\n    tail = _choose_tail_cells(grid, core_r, core_c, core_h, core_w, blocked_side=stair_side)\n    if tail is None:\n        return None\n    _paint_cells(grid, tail, BLACK)\n    return winning_hits\n\n\ndef _rect_is_bg(grid: np.ndarray, row: int, col: int, height: int, width: int) -> bool:\n    return bool(np.all(grid[row : row + height, col : col + width] == BG))\n\n\ndef _padded_rect_is_bg(grid: np.ndarray, row: int, col: int, height: int, width: int) -> bool:\n    r0 = max(0, row - OBJECT_PADDING)\n    r1 = min(GRID_SIZE, row + height + OBJECT_PADDING)\n    c0 = max(0, col - OBJECT_PADDING)\n    c1 = min(GRID_SIZE, col + width + OBJECT_PADDING)\n    return bool(np.all(grid[r0:r1, c0:c1] == BG))\n\n\ndef _place_losing_cutout(grid: np.ndarray, winning_hits: int) -> bool:\n    \"\"\"Place the second cutout where both horizontal sides score below the winner.\"\"\"\n    core_h, core_w = random.choice(CORE_SHAPES)\n    for _ in range(SECOND_CUTOUT_RETRIES):\n        row = random.randint(0, GRID_SIZE - core_h)\n        col = random.randint(0, GRID_SIZE - core_w)\n        if not _rect_is_bg(grid, row, col, core_h, core_w):\n            continue\n        if not _padded_rect_is_bg(grid, row, col, core_h, core_w):\n            continue\n\n        left_hits = _count_cutout_side_hits(grid, row, col, core_h, core_w, \"left\")\n        right_hits = _count_cutout_side_hits(grid, row, col, core_h, core_w, \"right\")\n        if max(left_hits, right_hits) >= winning_hits:\n            continue\n\n        grid[row : row + core_h, col : col + core_w] = BLACK\n        tail = _choose_tail_cells(grid, row, col, core_h, core_w)\n        if tail is not None:\n            _paint_cells(grid, tail, BLACK)\n            return True\n        grid[row : row + core_h, col : col + core_w] = BG\n    return False\n\n\ndef _place_distractor_staircase(grid: np.ndarray, colors_used: list[int]) -> bool:\n    \"\"\"Place the single non-gray staircase distractor.\"\"\"\n    color = random.choice(DISTRACTOR_COLORS)\n    colors_used.append(color)\n    for _ in range(DISTRACTOR_STAIR_RETRIES):\n        height = random.randint(*STAIR_HEIGHT_RANGE)\n        width = _random_stair_width(height)\n        side = random.choice(EDGE_SIDES)\n        row = random.randint(0, GRID_SIZE - 1 - height)\n        corner = random.choice(_corner_choices(side))\n        col = _edge_col(side, width)\n        patch = _make_staircase(height, width, corner, color)\n        if not _can_paste_non_bg_patch(grid, patch, row, col):\n            continue\n        _paste_non_bg_patch(grid, patch, row, col)\n        return True\n    return False\n\n\ndef _scatter_single_pixels(grid: np.ndarray, colors_used: list[int]) -> None:\n    count = random.randint(*SINGLE_PIXEL_COUNT_RANGE)\n    for _ in range(count):\n        remaining = [color for color in AVAILABLE_COLORS if color not in colors_used]\n        if not remaining:\n            break\n        color = random.choice(remaining)\n        colors_used.append(color)\n        for _ in range(SINGLE_PIXEL_RETRIES):\n            row = random.randint(0, GRID_SIZE - 1)\n            col = random.randint(0, GRID_SIZE - 1)\n            if int(grid[row, col]) == BG:\n                grid[row, col] = color\n                break\n\n\ndef _maybe_place_extra_black(grid: np.ndarray) -> None:\n    if random.random() >= EXTRA_BLACK_PROB:\n        return\n    for _ in range(EXTRA_BLACK_RETRIES):\n        row = random.randint(0, GRID_SIZE - 1)\n        col = random.randint(0, GRID_SIZE - 1)\n        if int(grid[row, col]) == BG:\n            grid[row, col] = BLACK\n            break\n\n\ndef _oracle_checked_grid(grid: np.ndarray) -> np.ndarray | None:\n    try:\n        out = main(grid)\n    except (AssertionError, Exception):\n        return None\n    if np.array_equal(grid, out):\n        return None\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    grid = np.full(GRID_SHAPE, BG, dtype=int)\n    colors_used = [SOURCE_COLOR]\n\n    stair_side, stair_height, stair_width, stair_row, stair_col = _place_source_staircase(grid)\n    winning_hits = _place_winning_cutout(\n        grid,\n        stair_side,\n        stair_height,\n        stair_width,\n        stair_row,\n        stair_col,\n    )\n    if winning_hits is None:\n        return None\n    if not _place_losing_cutout(grid, winning_hits):\n        return None\n    if not _place_distractor_staircase(grid, colors_used):\n        return None\n\n    _scatter_single_pixels(grid, colors_used)\n    _maybe_place_extra_black(grid)\n    return _oracle_checked_grid(grid)\n\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATE_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATE_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, table, frame, and slot dimensions.\nCANVAS_MIN, CANVAS_MAX = 13, 19\nTABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\nROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\nAXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n\n# Object and palette sampling limits.\nN_COLORS, MAX_OBJECT_COLORS = 10, 6\nMAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\nOBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n\n# Rejection sampling cap.\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_axis_options(n_slots, slot_min, slot_max):\n    options = []\n\n    def rec_slots(i, cur):\n        if i == n_slots:\n            rec_seps(0, [], cur)\n            return\n        for size in range(slot_min, slot_max + 1):\n            rec_slots(i + 1, cur + [size])\n\n    def rec_seps(i, cur, slots):\n        if i == n_slots - 1:\n            for before in AXIS_OUTER_OPTIONS:\n                for after in AXIS_OUTER_OPTIONS:\n                    for pad_before in AXIS_PADDING_OPTIONS:\n                        for pad_after in AXIS_PADDING_OPTIONS:\n                            total = (\n                                before\n                                + after\n                                + pad_before\n                                + pad_after\n                                + sum(slots)\n                                + sum(cur)\n                            )\n                            if 13 <= total <= 19:\n                                options.append(\n                                    (\n                                        tuple(slots),\n                                        tuple(cur),\n                                        before,\n                                        after,\n                                        pad_before,\n                                        pad_after,\n                                        total,\n                                )\n                            )\n            return\n        for sep in AXIS_SEPARATOR_OPTIONS:\n            rec_seps(i + 1, cur + [sep], slots)\n\n    rec_slots(0, [])\n    return options\n\n\ndef _gen_positions(axis):\n    sizes, seps, outer_before, _outer_after, pad_before, _pad_after, _total = axis\n    starts = []\n    pos = outer_before + pad_before\n    for i, size in enumerate(sizes):\n        starts.append(pos)\n        pos += size\n        if i < len(seps):\n            pos += seps[i]\n    return starts\n\n\ndef _gen_choose_axis(n_slots, slot_min, slot_max, other_axis=None, max_object_loss=0):\n    options = _gen_axis_options(n_slots, slot_min, slot_max)\n    if other_axis is None:\n        return random.choice(options)\n\n    good = []\n    for axis in options:\n        row_axis = axis if slot_max == ROW_SLOT_SIZE_RANGE[1] else other_axis\n        col_axis = axis if slot_max == COL_SLOT_SIZE_RANGE[1] else other_axis\n        height = row_axis[-1]\n        width = col_axis[-1]\n        frame_height = height - row_axis[2] - row_axis[3]\n        frame_width = width - col_axis[2] - col_axis[3]\n        slot_area = sum(row_axis[0]) * sum(col_axis[0])\n        outer_bg = height * width - frame_height * frame_width\n        bg_room = outer_bg + slot_area - max_object_loss\n        frame_area = frame_height * frame_width - slot_area\n        if bg_room > frame_area:\n            good.append(axis)\n    return random.choice(good or options)\n\n\ndef _gen_assign_colors(shape, bg, frame):\n    n_slots = shape[0] * shape[1]\n    filled_count = random.randint(1, n_slots - 1)\n    filled = random.sample(range(n_slots), filled_count)\n    colors = [c for c in range(N_COLORS) if c not in (bg, frame)]\n    n_colors = random.randint(1, min(MAX_OBJECT_COLORS, filled_count, len(colors)))\n    palette = random.sample(colors, n_colors)\n    assignments = palette[:]\n    assignments.extend(random.choice(palette) for _ in range(filled_count - n_colors))\n    random.shuffle(assignments)\n\n    out = np.full(shape, bg, dtype=int)\n    for idx, color in zip(filled, assignments):\n        out[idx // shape[1], idx % shape[1]] = color\n    return out, filled_count\n\n\ndef _gen_object_shape(slot_h, slot_w):\n    by_area = {}\n    for obj_h in range(1, min(MAX_OBJECT_HEIGHT, slot_h - 2 * OBJECT_MARGIN) + 1):\n        for obj_w in range(1, min(MAX_OBJECT_WIDTH, slot_w - 2 * OBJECT_MARGIN) + 1):\n            by_area.setdefault(obj_h * obj_w, []).append((obj_h, obj_w))\n    area = random.choice(list(by_area))\n    return random.choice(by_area[area])\n\n\ndef _gen_choose_layout(rows, cols, filled_count):\n    row_axis = _gen_choose_axis(rows, *ROW_SLOT_SIZE_RANGE)\n    loss = MAX_OBJECT_AREA * filled_count\n    col_axis = _gen_choose_axis(cols, *COL_SLOT_SIZE_RANGE, row_axis, max_object_loss=loss)\n    return row_axis, col_axis, _gen_positions(row_axis), _gen_positions(col_axis)\n\n\ndef _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts):\n    height = row_axis[-1]\n    width = col_axis[-1]\n    grid = np.full((height, width), bg, dtype=int)\n    rt, rb = row_axis[2], row_axis[3]\n    cl, cr = col_axis[2], col_axis[3]\n    grid[rt : height - rb, cl : width - cr] = frame\n\n    for r, slot_h in zip(row_starts, row_axis[0]):\n        for c, slot_w in zip(col_starts, col_axis[0]):\n            grid[r : r + slot_h, c : c + slot_w] = bg\n    return grid\n\n\ndef _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts):\n    for out_r, slot_r in enumerate(row_starts):\n        slot_h = row_axis[0][out_r]\n        for out_c, slot_c in enumerate(col_starts):\n            color = int(out[out_r, out_c])\n            if color == bg:\n                continue\n            slot_w = col_axis[0][out_c]\n            obj_h, obj_w = _gen_object_shape(slot_h, slot_w)\n            obj_r = random.randint(slot_r + OBJECT_MARGIN, slot_r + slot_h - obj_h - OBJECT_MARGIN)\n            obj_c = random.randint(slot_c + OBJECT_MARGIN, slot_c + slot_w - obj_w - OBJECT_MARGIN)\n            grid[obj_r : obj_r + obj_h, obj_c : obj_c + obj_w] = color\n\n\ndef _gen_is_valid(grid, out, bg, frame):\n    counts = np.bincount(grid.ravel(), minlength=N_COLORS)\n    if int(np.argmax(counts)) != bg:\n        return False\n    if counts[frame] <= max(counts[c] for c in range(N_COLORS) if c not in (bg, frame)):\n        return False\n    try:\n        actual = main(grid)\n    except Exception:\n        return False\n    return bool(np.array_equal(actual, out))\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rows = random.randint(*TABLE_ROWS_RANGE)\n    cols = random.randint(*TABLE_COLS_RANGE)\n    bg, frame = random.sample(range(N_COLORS), 2)\n\n    out, filled_count = _gen_assign_colors((rows, cols), bg, frame)\n    row_axis, col_axis, row_starts, col_starts = _gen_choose_layout(rows, cols, filled_count)\n    grid = _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts)\n    _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts)\n\n    if _gen_is_valid(grid, out, bg, frame):\n        return grid\n    return None\n\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid ac6f9922 input\")\n\n","exit_code":0,"status":"completed"}}
