{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n'/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py',\n'/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py',\n'/home/lixinyu/snap/new/ARC_code/train/278e5215.py',\n'/home/lixinyu/snap/new/ARC_code/eval/b5ca7ac4.py',\n'/home/lixinyu/snap/new/ARC_code/train/9841fdad.py',\n'/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n'/home/lixinyu/snap/new/ARC_code/train/df9fd884.py',\n]\nfor path in files:\n    text = Path(path).read_text()\n    print(f'FILE: {path}')\n    for name in ('def main(', 'def generate_input('):\n        idx = text.find(name)\n        if idx == -1:\n            continue\n        end = text.find('\\\\ndef ', idx + 1)\n        if end == -1:\n            end = len(text)\n        print(text[idx:end])\n        print('\\\\n---')\n    print('===END===')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n'/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py',\n'/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py',\n'/home/lixinyu/snap/new/ARC_code/train/278e5215.py',\n'/home/lixinyu/snap/new/ARC_code/eval/b5ca7ac4.py',\n'/home/lixinyu/snap/new/ARC_code/train/9841fdad.py',\n'/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n'/home/lixinyu/snap/new/ARC_code/train/df9fd884.py',\n]\nfor path in files:\n    text = Path(path).read_text()\n    print(f'FILE: {path}')\n    for name in ('def main(', 'def generate_input('):\n        idx = text.find(name)\n        if idx == -1:\n            continue\n        end = text.find('\\\\ndef ', idx + 1)\n        if end == -1:\n            end = len(text)\n        print(text[idx:end])\n        print('\\\\n---')\n    print('===END===')\nPY\"","aggregated_output":"FILE: /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\n\n---\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\n\n---\n===END===\nFILE: /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n\n\n\n---\ndef generate_input():\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n\n\n\n\n---\n===END===\nFILE: /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n\n---\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exhausted attempts\")\n\n\n---\n===END===\nFILE: /home/lixinyu/snap/new/ARC_code/train/278e5215.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the large mask crop column-by-column using the separate three-row palette strip.\n\n    Input structure:\n    - The background is the most common color.\n    - One large monochrome foreground object is the mask; its bbox is the output region and may contain background holes.\n    - The remaining foreground is a 3-row palette rectangle with the same width as the mask bbox: two identical color rows and one uniform row.\n\n    Rule:\n    - Crop to the mask object's bbox.\n    - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n    - Replace background holes inside the crop with the palette's uniform third-row color.\n\n    Key insight:\n    The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    mask_color = _unique_largest_non_bg_color(g, bg)\n\n    b = _mask_bbox(g, mask_color)\n    mask_crop = crop_bbox(g == int(mask_color), b)\n    height, width = map(int, mask_crop.shape)\n\n    column_colors, hole_color = _palette(g, bg, mask_color, width)\n    out = np.tile(column_colors, (height, 1))\n    out[~mask_crop] = hole_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, colors, and object bounds.\nBACKGROUND_COLOR, MASK_COLOR = 0, 5\nCOLOR_MIN, COLOR_MAX = 1, 9\nGRID_SIDE_MIN, GRID_SIDE_MAX = 10, 18\nMASK_SIDE_MIN, MASK_SIDE_MAX = 5, 10\nPALETTE_HEIGHT = 3\nGAP_MIN, GAP_MAX = 1, 3\n\n# Palette run construction.\nRUN_COUNT_OPTIONS = (4, 5)\nRUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3\nCOLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5\nUNUSED_COLOR_BIAS = 0.7\n\n# Mask density and retry budget.\nMASK_DENSITY_MIN, MASK_DENSITY_MAX = 0.60, 0.71\nGENERATION_ATTEMPTS = 300\n\n\n\n---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n\n---\n===END===\nFILE: /home/lixinyu/snap/new/ARC_code/eval/b5ca7ac4.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move bordered 5×5 squares to their designated grid edges by border color.\n\n    Input structure:\n    - bg = most common color.\n    - Azure (8) and red (2) bordered 5×5 squares with colored interiors, scattered across the grid.\n\n    Rule:\n    - Azure squares → left edge (col 0); red squares → right edge (col W−5).\n    - Each square keeps its original row.\n    - Process azure left-to-right, red right-to-left (nearest-to-edge first).\n    - If a square's rows overlap an already-placed edge square, place it one square-width inward instead.\n\n    Key insight: Near-edge-first ordering plus row-overlap determines which square sits at the edge vs. the second column.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    out = np.full_like(g, bg)\n\n    SQUARE_SIZE = 5\n    def overlaps(a0: int, a1: int, b0: int, b1: int) -> bool:\n        return not (int(a1) < int(b0) or int(b1) < int(a0))\n\n    # Detect bordered squares by scanning 5x5 windows. This is robust even if frame-color pixels\n    # are connected between squares in the input.\n    squares = []\n    for r0 in range(H - SQUARE_SIZE + 1):\n        for c0 in range(W - SQUARE_SIZE + 1):\n            patch = crop_bbox(g, (int(r0), int(c0), int(r0 + SQUARE_SIZE - 1), int(c0 + SQUARE_SIZE - 1)))\n\n            border = np.concatenate([patch[0, :], patch[-1, :], patch[1:-1, 0], patch[1:-1, -1]])\n            if int(border.min()) != int(border.max()):\n                continue\n            frame_col = int(border[0])\n            if frame_col not in {2, 8}:\n                continue\n\n            inner = patch[1:-1, 1:-1]\n            if not bool((inner != int(frame_col)).any()):\n                continue\n\n            squares.append({\"frame\": int(frame_col), \"r0\": int(r0), \"c0\": int(c0), \"patch\": patch})\n\n    # Azure squares: sort by original column ascending (leftmost first).\n    azure_squares = sorted([s for s in squares if int(s[\"frame\"]) == 8], key=lambda s: int(s[\"c0\"]))\n    placed_at_default: list[tuple[int, int]] = []\n    for s in azure_squares:\n        r0 = int(s[\"r0\"])\n        r1 = int(r0 + SQUARE_SIZE - 1)\n        has_overlap = any(overlaps(r0, r1, pr0, pr1) for pr0, pr1 in placed_at_default)\n        dest_c = int(SQUARE_SIZE) if has_overlap else 0\n        paste(out, s[\"patch\"], r0, dest_c, transparent=bg)\n        if dest_c == 0:\n            placed_at_default.append((r0, r1))\n\n    # Red squares: sort by original column descending (rightmost first).\n    red_squares = sorted([s for s in squares if int(s[\"frame\"]) == 2], key=lambda s: -int(s[\"c0\"]))\n    placed_at_default = []\n    for s in red_squares:\n        r0 = int(s[\"r0\"])\n        r1 = int(r0 + SQUARE_SIZE - 1)\n        has_overlap = any(overlaps(r0, r1, pr0, pr1) for pr0, pr1 in placed_at_default)\n        dest_c = int(W - 2 * SQUARE_SIZE) if has_overlap else int(W - SQUARE_SIZE)\n        paste(out, s[\"patch\"], r0, dest_c, transparent=bg)\n        if dest_c == int(W - SQUARE_SIZE):\n            placed_at_default.append((r0, r1))\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# --- Configuration ---\nGRID_H, GRID_W = 22, 22          # canvas dimensions\nSQ = 5                            # square side length (frame + 3x3 interior)\nAZURE, RED = 8, 2                 # frame colors\nN_AZURE_RANGE = (3, 4)            # azure square count range\nN_RED_RANGE = (3, 5)              # red square count range\nMAX_INWARD = 2                    # max inward squares per side\nINPUT_COL_RETRIES = 50            # retries for input column assignment per side\nGEN_RETRIES = 500                 # outer generate_input retry limit\n\n\n\n---\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n\n\n---\n===END===\nFILE: /home/lixinyu/snap/new/ARC_code/train/9841fdad.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Expand the colored runs from the left reference panel into the blank right panel.\n\n    Input structure:\n    - A uniform rectangular frame surrounds the grid.\n    - One full-height divider of the frame color splits a left reference panel\n      from a blank right panel.\n    - Both panels have one background margin column on each side of their active\n      columns; the left active columns contain two-column endpoint slots, possibly\n      connected by same-color horizontal runs.\n\n    Rule:\n    - Keep the original grid and paint only in the right panel's active columns.\n    - A source run exactly matching the left endpoint slot is copied to the left\n      two columns of the right active span.\n    - A source run exactly matching the right endpoint slot is copied to the right\n      two columns of the right active span.\n    - A source run connecting the endpoint slots is stretched across the entire\n      right active span.\n\n    Key insight:\n    The left panel is a compressed legend for the right panel: endpoint markers\n    stay two pixels wide, while connectors between endpoints expand to fill the\n    distance between them.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    H, W = g.shape\n    assert H >= 3 and W >= 7, \"grid too small for framed two-panel structure\"\n\n    frame = int(g[0, 0])\n    assert np.all(g[0, :] == frame) and np.all(g[-1, :] == frame), \"bad horizontal frame\"\n    assert np.all(g[:, 0] == frame) and np.all(g[:, -1] == frame), \"bad vertical frame\"\n\n    divider = _single_divider_column(g, frame)\n    assert divider >= 5 and W - divider >= 6, \"panels must contain margins and active slots\"\n\n    left_panel = g[1 : H - 1, 1:divider]\n    left_bg = get_bg(left_panel)\n    assert np.all(left_panel[:, 0] == left_bg), \"left panel must have a left margin\"\n    assert np.all(left_panel[:, -1] == left_bg), \"left panel must have a right margin\"\n\n    mini_start = 2\n    mini_end = divider - 2\n    assert mini_end - mini_start + 1 >= 4, \"left active region must contain two endpoint slots\"\n    left_slot = (mini_start, mini_start + 1)\n    right_slot = (mini_end - 1, mini_end)\n\n    target_start = divider + 2\n    target_end = W - 3\n    assert target_end - target_start + 1 >= 4, \"right active region must contain endpoint slots\"\n    right_bg = int(g[1, divider + 1])\n    right_panel = g[1 : H - 1, divider + 1 : W - 1]\n    assert np.all(right_panel == right_bg), \"right panel must be blank before expansion\"\n\n    out = g.copy()\n    painted_any = False\n    for r in range(1, H - 1):\n        c = mini_start\n        while c <= mini_end:\n            color = int(g[r, c])\n            if color == left_bg:\n                c += 1\n                continue\n\n            c0 = c\n            while c <= mini_end and int(g[r, c]) == color:\n                c += 1\n            c1 = c - 1\n\n            in_left_slot = (c0, c1) == left_slot\n            in_right_slot = (c0, c1) == right_slot\n            if in_left_slot:\n                d0, d1 = target_start, target_start + 1\n            elif in_right_slot:\n                d0, d1 = target_end - 1, target_end\n            else:\n                assert c0 == left_slot[0] and c1 >= right_slot[0], \"run must connect endpoint slots\"\n                d0, d1 = target_start, target_end\n\n            assert np.all(out[r, d0 : d1 + 1] == right_bg), \"expanded runs must not collide\"\n            out[r, d0 : d1 + 1] = color\n            painted_any = True\n\n    assert painted_any, \"expected at least one colored source run\"\n    return out\n\n# --------------- generator (att2) ---------------\n# Color and retry controls.\nLEFT_BG = 1\nCOLOR_IDS = tuple(range(10))\nFRAME_COLORS = (0, 2, 3, 4, 5, 6, 7, 8, 9)\nMAX_RUN_COLORS = 4\nGENERATION_RETRIES = 300\n\n# Canvas, group, and row layout bounds.\nLEFT_ACTIVE_WIDTHS = range(4, 7)\nRIGHT_ACTIVE_WIDTHS = range(11, 14)\nTOTAL_HEIGHTS = (11, 15)\nRIGHT_TO_LEFT_MIN_RATIO = 2\nFIXED_WIDTH_CELLS = 7\nNON_GROUP_ROWS = 4\nGROUP_COUNTS = (3, 5)\nGROUP_HEIGHT_BOUNDS = (1, 2)\nGAP_BOUNDS = (1, 2)\nFIRST_ACTIVE_ROW = 2\n\n# Run pattern geometry.\nRUN_WIDTH = 2\nLEFT_ACTIVE_START = 2\nRIGHT_TARGET_OFFSET = 2\nBASE_PATTERNS = (\"LEFT\", \"RIGHT\", \"FULL\")\nDOUBLE_PATTERN = \"LEFT_RIGHT\"\n\n\n---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 9841fdad input\")\n\n\n---\n===END===\nFILE: /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\n\n---\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\n\n\n---\n===END===\nFILE: /home/lixinyu/snap/new/ARC_code/train/df9fd884.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Move the colored object from the lower bracket lane to the upper bracket lane and drop it to the bottom edge.\n\n    Input structure\n    - The background is the dominant color.\n    - One frame color forms exactly two 4-connected bracket objects: a top-edge bracket open downward and a bottom-edge bracket open upward.\n    - One other 4-connected foreground object sits in the lower bracket's interior column span.\n\n    Rule\n    - Remove the movable object from its original cells.\n    - Keep its shape and color unchanged.\n    - Paste it with its bbox columns aligned to the top bracket's interior columns and with its bbox bottom aligned to the grid bottom.\n\n    Key insight\n    - The lower bracket identifies the object's source lane; the upper bracket provides the target lane, and the final vertical placement is bottom-aligned.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height, width = g.shape\n    bg = get_bg(g)\n\n    components_by_color = {}\n    bracket_candidates = []\n    for color in colors_present(g, exclude={bg}):\n        components = find_components(\n            g,\n            bg=bg,\n            colors=[color],\n            connectivity=4,\n            monochromatic=True,\n        )\n        components_by_color[color] = components\n        top = [component for component in components if _is_top_bracket(component)]\n        bottom = [\n            component for component in components\n            if _is_bottom_bracket(component, height)\n        ]\n        if len(components) == 2 and len(top) == 1 and len(bottom) == 1:\n            bracket_candidates.append((color, top[0], bottom[0]))\n\n    assert len(bracket_candidates) == 1\n    frame_color, top_bracket, bottom_bracket = bracket_candidates[0]\n\n    movers = [\n        component\n        for color, components in components_by_color.items()\n        if color != frame_color\n        for component in components\n    ]\n    assert len(movers) == 1\n    mover = movers[0]\n\n    _, mc0, _, mc1 = mover[\"bbox\"]\n    _br0, bc0, _br1, bc1 = bottom_bracket[\"bbox\"]\n    _tr0, tc0, _tr1, tc1 = top_bracket[\"bbox\"]\n    assert (mc0, mc1) == (bc0 + 1, bc1 - 1)\n    assert bbox_w(mover[\"bbox\"]) == tc1 - tc0 - 1\n\n    patch = crop_bbox(g, mover[\"bbox\"])\n    dest_r = height - patch.shape[0]\n    dest_c = tc0 + 1\n    assert dest_r >= 0\n    assert dest_c >= 0 and dest_c + patch.shape[1] <= width\n\n    out = g.copy()\n    mover_coords = mover[\"coords\"]\n    out[mover_coords[:, 0], mover_coords[:, 1]] = bg\n\n    colored_patch = patch != bg\n    target = out[dest_r:dest_r + patch.shape[0], dest_c:dest_c + patch.shape[1]]\n    assert np.all(target[colored_patch] == bg)\n\n    paste(out, patch, dest_r, dest_c, transparent=bg)\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed task colors.\nBG_COLOR, BRACKET_COLOR = 7, 4\nMOVER_COLORS = [0, 1, 2, 3, 5, 6, 8, 9]\n# Canvas, bracket, and mover-size bounds.\nGRID_SIZE_RANGE = (8, 9)\nBRACKET_WIDTH_RANGE = (3, 4)\nMOVER_HEIGHT_RANGE = (1, 3)\nMOVER_MAX_CELLS = 4\nMOVER_MIN_DENSITY_NUM = 2\nMOVER_MIN_DENSITY_DEN = 3\n# Layout choices and retry budget.\nTOP_LEFT_OPTIONS = [True, False]\nMAX_GENERATION_ATTEMPTS = 300\n\n\n---\ndef generate_input():\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate df9fd884 input\")\n\n\n---\n===END===\n","exit_code":0,"status":"completed"}}
