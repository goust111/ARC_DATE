{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/9841fdad.py',\n'/home/lixinyu/snap/new/ARC_code/eval/a395ee82.py',\n'/home/lixinyu/snap/new/ARC_code/eval/247ef758.py',\n'/home/lixinyu/snap/new/ARC_code/train/902510d5.py',\n'/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py',\n'/home/lixinyu/snap/new/ARC_code/eval/0934a4d8.py',\n'/home/lixinyu/snap/new/ARC_code/train/652646ff.py',\n'/home/lixinyu/snap/new/ARC_code/eval/271d71e2.py',\n]\nfor path in files:\n    print(f'===== {path} =====')\n    text = Path(path).read_text()\n    for name in ['def main(', 'def generate_input(']:\n        idx = text.find(name)\n        if idx == -1:\n            continue\n        start = text.rfind('\\\\n', 0, idx)\n        end = text.find('\\\\ndef ', idx + 1)\n        if end == -1:\n            end = len(text)\n        print(text[idx:end].rstrip())\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/9841fdad.py',\n'/home/lixinyu/snap/new/ARC_code/eval/a395ee82.py',\n'/home/lixinyu/snap/new/ARC_code/eval/247ef758.py',\n'/home/lixinyu/snap/new/ARC_code/train/902510d5.py',\n'/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py',\n'/home/lixinyu/snap/new/ARC_code/eval/0934a4d8.py',\n'/home/lixinyu/snap/new/ARC_code/train/652646ff.py',\n'/home/lixinyu/snap/new/ARC_code/eval/271d71e2.py',\n]\nfor path in files:\n    print(f'===== {path} =====')\n    text = Path(path).read_text()\n    for name in ['def main(', 'def generate_input(']:\n        idx = text.find(name)\n        if idx == -1:\n            continue\n        start = text.rfind('\\\\n', 0, idx)\n        end = text.find('\\\\ndef ', idx + 1)\n        if end == -1:\n            end = len(text)\n        print(text[idx:end].rstrip())\n        print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/train/9841fdad.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Expand the colored runs from the left reference panel into the blank right panel.\n\n    Input structure:\n    - A uniform rectangular frame surrounds the grid.\n    - One full-height divider of the frame color splits a left reference panel\n      from a blank right panel.\n    - Both panels have one background margin column on each side of their active\n      columns; the left active columns contain two-column endpoint slots, possibly\n      connected by same-color horizontal runs.\n\n    Rule:\n    - Keep the original grid and paint only in the right panel's active columns.\n    - A source run exactly matching the left endpoint slot is copied to the left\n      two columns of the right active span.\n    - A source run exactly matching the right endpoint slot is copied to the right\n      two columns of the right active span.\n    - A source run connecting the endpoint slots is stretched across the entire\n      right active span.\n\n    Key insight:\n    The left panel is a compressed legend for the right panel: endpoint markers\n    stay two pixels wide, while connectors between endpoints expand to fill the\n    distance between them.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    H, W = g.shape\n    assert H >= 3 and W >= 7, \"grid too small for framed two-panel structure\"\n\n    frame = int(g[0, 0])\n    assert np.all(g[0, :] == frame) and np.all(g[-1, :] == frame), \"bad horizontal frame\"\n    assert np.all(g[:, 0] == frame) and np.all(g[:, -1] == frame), \"bad vertical frame\"\n\n    divider = _single_divider_column(g, frame)\n    assert divider >= 5 and W - divider >= 6, \"panels must contain margins and active slots\"\n\n    left_panel = g[1 : H - 1, 1:divider]\n    left_bg = get_bg(left_panel)\n    assert np.all(left_panel[:, 0] == left_bg), \"left panel must have a left margin\"\n    assert np.all(left_panel[:, -1] == left_bg), \"left panel must have a right margin\"\n\n    mini_start = 2\n    mini_end = divider - 2\n    assert mini_end - mini_start + 1 >= 4, \"left active region must contain two endpoint slots\"\n    left_slot = (mini_start, mini_start + 1)\n    right_slot = (mini_end - 1, mini_end)\n\n    target_start = divider + 2\n    target_end = W - 3\n    assert target_end - target_start + 1 >= 4, \"right active region must contain endpoint slots\"\n    right_bg = int(g[1, divider + 1])\n    right_panel = g[1 : H - 1, divider + 1 : W - 1]\n    assert np.all(right_panel == right_bg), \"right panel must be blank before expansion\"\n\n    out = g.copy()\n    painted_any = False\n    for r in range(1, H - 1):\n        c = mini_start\n        while c <= mini_end:\n            color = int(g[r, c])\n            if color == left_bg:\n                c += 1\n                continue\n\n            c0 = c\n            while c <= mini_end and int(g[r, c]) == color:\n                c += 1\n            c1 = c - 1\n\n            in_left_slot = (c0, c1) == left_slot\n            in_right_slot = (c0, c1) == right_slot\n            if in_left_slot:\n                d0, d1 = target_start, target_start + 1\n            elif in_right_slot:\n                d0, d1 = target_end - 1, target_end\n            else:\n                assert c0 == left_slot[0] and c1 >= right_slot[0], \"run must connect endpoint slots\"\n                d0, d1 = target_start, target_end\n\n            assert np.all(out[r, d0 : d1 + 1] == right_bg), \"expanded runs must not collide\"\n            out[r, d0 : d1 + 1] = color\n            painted_any = True\n\n    assert painted_any, \"expected at least one colored source run\"\n    return out\n\n# --------------- generator (att2) ---------------\n# Color and retry controls.\nLEFT_BG = 1\nCOLOR_IDS = tuple(range(10))\nFRAME_COLORS = (0, 2, 3, 4, 5, 6, 7, 8, 9)\nMAX_RUN_COLORS = 4\nGENERATION_RETRIES = 300\n\n# Canvas, group, and row layout bounds.\nLEFT_ACTIVE_WIDTHS = range(4, 7)\nRIGHT_ACTIVE_WIDTHS = range(11, 14)\nTOTAL_HEIGHTS = (11, 15)\nRIGHT_TO_LEFT_MIN_RATIO = 2\nFIXED_WIDTH_CELLS = 7\nNON_GROUP_ROWS = 4\nGROUP_COUNTS = (3, 5)\nGROUP_HEIGHT_BOUNDS = (1, 2)\nGAP_BOUNDS = (1, 2)\nFIRST_ACTIVE_ROW = 2\n\n# Run pattern geometry.\nRUN_WIDTH = 2\nLEFT_ACTIVE_START = 2\nRIGHT_TARGET_OFFSET = 2\nBASE_PATTERNS = (\"LEFT\", \"RIGHT\", \"FULL\")\nDOUBLE_PATTERN = \"LEFT_RIGHT\"\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 9841fdad input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/a395ee82.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp translated copies of a monochrome template guided by a singleton pixel layout.\n\n    Input structure:\n    - bg = background. A large monochrome shape (template, color T).\n    - Singleton pixels elsewhere: exactly one is color T (layout origin); the rest share color O (overlap color).\n    - Singletons sit on a uniform-spacing lattice.\n\n    Rule:\n    - Convert each singleton's offset from the origin into coarse lattice units.\n    - Place a template copy at each offset, scaled by template height/width.\n    - The origin's copy is painted O instead of T.\n    - Any pixel covered by two or more copies is also recolored to O.\n\n    Key insight: The single T-colored singleton identifies both the origin position and the \"self\" copy, which is uniquely recolored.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n\n    template = max(comps, key=lambda d: int(d[\"area\"]))\n    templ_coords = template[\"coords\"]\n    templ_col = int(g[int(templ_coords[0, 0]), int(templ_coords[0, 1])])\n    r0, c0, r1, c1 = map(int, template[\"bbox\"])\n    h = int(bbox_h((r0, c0, r1, c1)))\n    w = int(bbox_w((r0, c0, r1, c1)))\n\n    templ_rel = [(int(r) - int(r0), int(c) - int(c0)) for r, c in templ_coords]\n\n    # Singleton layout points (excluding the template component).\n    singletons: list[tuple[int, int, int]] = []\n    for comp in comps:\n        if comp is template:\n            continue\n        if int(comp[\"area\"]) != 1:\n            continue\n        rr, cc = map(int, comp[\"coords\"][0])\n        singletons.append((int(rr), int(cc), int(g[int(rr), int(cc)])))\n\n    origin = [(r, c) for (r, c, col) in singletons if int(col) == int(templ_col)]\n    assert not (len(origin) != 1)\n    orr, orc = origin[0]\n\n    other_cols = [int(col) for (_r, _c, col) in singletons if int(col) != int(templ_col)]\n    assert not (not other_cols)\n    overlap_col = int(Counter(other_cols).most_common(1)[0][0])\n\n    deltas = [(int(r - orr), int(c - orc), int(col)) for (r, c, col) in singletons]\n    gcd_vals = [abs(int(x)) for dr, dc, _ in deltas for x in (dr, dc) if int(x) != 0]\n    assert gcd_vals\n    gunit = int(math.gcd(*gcd_vals))\n    gunit = max(1, int(gunit))\n    deltas = [(int(dr // gunit), int(dc // gunit), int(col)) for dr, dc, col in deltas]\n\n    total = np.zeros((H, W), dtype=int)\n    center = np.zeros((H, W), dtype=int)  # coverage count from the origin singleton\n\n    for dr, dc, col in deltas:\n        off_r = int(dr * h)\n        off_c = int(dc * w)\n        is_origin = int(col) == int(templ_col)\n        for rr, cc in templ_rel:\n            R = int(r0 + off_r + rr)\n            C = int(c0 + off_c + cc)\n            if 0 <= R < H and 0 <= C < W:\n                total[R, C] += 1\n                if is_origin:\n                    center[R, C] += 1\n\n    out = np.full((H, W), int(bg), dtype=int)\n    out[total > 0] = int(templ_col)\n    out[(total == 1) & (center > 0)] = int(overlap_col)\n    out[total >= 2] = int(overlap_col)\n    return out\n\n# --------------- generator (a1) ---------------\n\n# ── Tunable configuration ──────────────────────────────────────────\nGRID_SIZE = 22\nTEMPLATE_H_CHOICES = [3, 4]       # template bbox height options\nTEMPLATE_W = 3                    # template bbox width (fixed)\nTEMPLATE_AREA_RANGE = (6, 10)     # absolute cell-count bounds\nTEMPLATE_FILL_RANGE = (0.65, 0.85)  # fill-ratio bounds within bbox\nSINGLETON_COUNT_RANGE = (5, 6)    # number of lattice singletons\nLATTICE_EXTENT_RANGE = (3, 4)     # rows/cols of lattice polyomino\nGUNIT = 2                         # singleton spacing in pixels\n\n# Retry budgets\nSPANNING_RETRIES = 40             # attempts per spanning polyomino\nTEMPLATE_RETRIES = 60             # attempts to build a valid template\nSINGLETON_RETRIES = 50            # attempts to place singleton cluster\nGENERATE_RETRIES = 300            # outer retry loop\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATE_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate input after %d attempts\" % GENERATE_RETRIES)\n\n===== /home/lixinyu/snap/new/ARC_code/eval/247ef758.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move colored sprites from the left strip into a framed area at marker-defined targets.\n\n    Input structure:\n    - bg background; rectangular frame on right with colored markers on its edges; sprites in a narrow left strip separated by a constant-color divider column.\n\n    Rule:\n    - For each color, target rows/cols are where both opposite frame edges share that color. Targets are the Cartesian product.\n    - Erase each sprite from the left and stamp it centered at every target. Higher sprites cover lower ones.\n\n    Key insight: One sprite replicates to a grid of row × column marker intersections.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # --- frame interior: largest bg component not touching boundary ---\n    inner_bbox = largest_enclosed_component_bbox(g == int(bg), connectivity=4)\n    assert not (inner_bbox is None)\n    ir0, ic0, ir1, ic1 = map(int, inner_bbox)\n    fr0, fc0, fr1, fc1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)\n\n    # --- divider columns (fixed) on the left side ---\n    divider_mask = np.zeros((H, W), dtype=bool)\n    for c in range(0, max(0, int(fc0))):\n        colv = g[:, int(c)]\n        non = colv[colv != int(bg)]\n        if int(len(non)) >= int(H - 1) and len(set(map(int, non))) == 1:\n            divider_mask[:, int(c)] = True\n\n    left_cols = (np.arange(W)[None, :] < int(fc0))\n\n    # --- sprites: per-color 8-connected components in left area (excluding divider) ---\n    sprites = []\n    for col in sorted(set(map(int, g.flatten())) - {int(bg)}):\n        mask = (g == int(col)) & left_cols & (~divider_mask)\n        if not bool(mask.any()):\n            continue\n        slab, sn = label_mask(mask, connectivity=8)\n        for sid in range(1, int(sn) + 1):\n            pts = np.argwhere(slab == int(sid))\n            r0, c0 = pts.min(axis=0)\n            r1, c1 = pts.max(axis=0)\n            r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n            m = slab[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(sid)\n            sprites.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"r1\": int(r1), \"c1\": int(c1), \"mask\": m})\n\n    move_colors = {int(s[\"color\"]) for s in sprites}\n\n    # --- marker-derived targets (restricted to colors that actually appear as sprites) ---\n    row_marks: dict[int, list[int]] = defaultdict(list)\n    col_marks: dict[int, list[int]] = defaultdict(list)\n    for r in range(int(ir0), int(ir1) + 1):\n        cl = int(g[int(r), int(fc0)])\n        cr = int(g[int(r), int(fc1)])\n        if cl == cr and cl != int(bg) and cl in move_colors:\n            row_marks[int(cl)].append(int(r))\n    for c in range(int(ic0), int(ic1) + 1):\n        ct = int(g[int(fr0), int(c)])\n        cb = int(g[int(fr1), int(c)])\n        if ct == cb and ct != int(bg) and ct in move_colors:\n            col_marks[int(ct)].append(int(c))\n\n    targets: dict[int, list[tuple[int, int]]] = {}\n    for col in set(row_marks.keys()) & set(col_marks.keys()):\n        pts = {(int(r), int(c)) for r in row_marks[int(col)] for c in col_marks[int(col)]}\n        targets[int(col)] = sorted(pts)\n\n    out = g.copy()\n    movers = [s for s in sprites if int(s[\"color\"]) in targets]\n\n    # Erase originals of moved sprites.\n    for s in movers:\n        r0, c0 = int(s[\"r0\"]), int(s[\"c0\"])\n        for rr, cc in np.argwhere(s[\"mask\"]):\n            out[int(r0) + int(rr), int(c0) + int(cc)] = int(bg)\n\n    # Bottom-to-top ordering: lower sprites first, upper sprites last (covering).\n    movers.sort(key=lambda s: (-((int(s[\"r0\"]) + int(s[\"r1\"])) / 2.0), int(s[\"c0\"])))\n\n    for s in movers:\n        col = int(s[\"color\"])\n        cr = (int(s[\"r0\"]) + int(s[\"r1\"])) // 2\n        cc = (int(s[\"c0\"]) + int(s[\"c1\"])) // 2\n        pix = [(int(s[\"r0\"]) + int(rr), int(s[\"c0\"]) + int(cc2)) for rr, cc2 in np.argwhere(s[\"mask\"])]\n\n        for tr, tc in targets[int(col)]:\n            dr = int(tr - cr)\n            dc = int(tc - cc)\n            for r, c in pix:\n                rr = int(r + dr)\n                cc3 = int(c + dc)\n                if int(ir0) <= rr <= int(ir1) and int(ic0) <= cc3 <= int(ic1):\n                    out[rr, cc3] = int(col)\n\n    return out\n\n\n# ---------------------------------------------------------------------------\n# generate_input\n# ---------------------------------------------------------------------------\nimport random\n\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/902510d5.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Keep the largest 8-connected motif and replace the corner/control pixels with a solid corner triangle.\n\n    Input structure\n    - The background is the dominant color.\n    - Exactly one grid corner contains a foreground control pixel; it gives the\n      corner from which the triangle is painted.\n    - There is one unique largest 8-connected monochrome foreground object, the\n      motif that remains in the output; all other foreground pixels are controls.\n    - Every foreground component outside that motif is a singleton control pixel.\n    - The fill color is the unique control color that appears in at least two\n      non-corner control pixels.\n\n    Rule\n    - Start from a blank background canvas and redraw only the largest motif.\n    - Count the non-corner control pixels; that count is the triangle side.\n    - Paint the fill color on the right-triangle region where those two distances\n      from the marked corner's edges sum to less than the side length.\n\n    Key insight\n    - The scattered singleton controls are counted into a compact triangular\n      stack at the marked corner; only the largest motif is not part of the count.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    corners = {\n        \"TL\": (0, 0),\n        \"TR\": (0, W - 1),\n        \"BL\": (H - 1, 0),\n        \"BR\": (H - 1, W - 1),\n    }\n    marked_corners = [\n        (name, rc) for name, rc in corners.items() if int(g[rc]) != int(bg)\n    ]\n    assert len(marked_corners) == 1, \"expected exactly one foreground corner marker\"\n    corner, (corner_r, corner_c) = marked_corners[0]\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert comps, \"expected at least one foreground component\"\n    max_area = max(int(comp[\"area\"]) for comp in comps)\n    motif_candidates = [comp for comp in comps if int(comp[\"area\"]) == max_area]\n    assert len(motif_candidates) == 1, \"expected a unique largest motif\"\n    motif = motif_candidates[0]\n    motif_color = int(motif[\"color\"])\n    motif_coords = {tuple(map(int, coord)) for coord in motif[\"coords\"]}\n    motif_direction = _diagonal_direction(motif_coords)\n    assert motif_direction is not None, \"motif must be square and diagonal-symmetric\"\n    assert motif_direction == corner, \"corner marker must match motif diagonal direction\"\n\n    control_coords = [\n        (int(r), int(c))\n        for r, c in np.argwhere(g != bg)\n        if (int(r), int(c)) not in motif_coords\n    ]\n    assert (corner_r, corner_c) in control_coords, \"corner marker must be a control pixel\"\n    assert len(control_coords) > 1, \"expected non-corner control pixels\"\n\n    control_components = [comp for comp in comps if comp is not motif]\n    assert all(int(comp[\"area\"]) == 1 for comp in control_components), \"controls must be singleton components\"\n\n    control_counts = Counter(\n        int(g[r, c])\n        for r, c in control_coords\n        if (int(r), int(c)) != (corner_r, corner_c)\n    )\n    fill_candidates = [\n        int(color) for color, count in control_counts.items() if int(count) >= 2\n    ]\n    assert len(fill_candidates) == 1, \"expected one repeated non-corner fill color\"\n    fill_color = fill_candidates[0]\n    side = len(control_coords) - 1\n\n    out = np.full_like(g, bg)\n    for r, c in motif_coords:\n        out[r, c] = motif_color\n    _paint_corner_triangle(out, corner, int(side), fill_color)\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_ATTEMPTS = 300\n\n# Canvas and triangle bounds.\n_GEN_ROW_BOUNDS = (6, 15)\n_GEN_COL_BOUNDS = (9, 14)\n_GEN_TRIANGLE_SIDE_BOUNDS = (2, 5)\n\n# Color and control-pixel sampling.\n_GEN_COLORS = tuple(range(1, 10))\n_GEN_MARKER_AVOID_FILL_PROB = 0.8\n_GEN_FILL_COUNT_BOUNDS = (2, 3)\n\n# Sparse square motifs observed in the task examples.\n_GEN_MOTIF_TEMPLATES = [\n    (\"..#.\", \".#..\", \"#.#.\", \"...#\"),\n    (\".#...\", \"..#..\", \"..##.\", \".#..#\", \"#....\"),\n    (\n        \"...###...\",\n        \"..#......\",\n        \".##......\",\n        \"#..#.....\",\n        \"#...#....\",\n        \"#....#...\",\n        \"......#..\",\n        \".......#.\",\n        \"........#\",\n    ),\n    (\"#...\", \".#.#\", \"..#.\", \".#..\"),\n    (\"...#\", \"#.#.\", \"##..\", \".##.\"),\n]\n\ndef generate_input():\n    for _ in range(_GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 902510d5 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n\n    Input structure:\n    - The grid has a dominant background color.\n    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n\n    Rule:\n    - Keep the input pixels unchanged.\n    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n\n    Key insight:\n    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    out = g.copy()\n    h, w = g.shape\n\n    markers: dict[int, int] = {}\n    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n            continue\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n        source = int(sub[0, 0])\n        halo = int(sub[0, 1])\n        assert source != halo, \"legend source and halo colors must differ\"\n        assert source not in markers, \"each source color must have exactly one legend marker\"\n\n        markers[source] = halo\n        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n\n    assert markers, \"expected at least one left-edge legend marker\"\n\n    for source, halo in markers.items():\n        objects = []\n        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n            if cells <= marker_source_cells[source]:\n                continue\n            objects.append(comp)\n        assert objects, \"each legend source color must label at least one non-marker object\"\n\n        for obj in objects:\n            r0, c0, r1, c1 = obj[\"bbox\"]\n            pr0 = max(0, int(r0) - 1)\n            pc0 = max(0, int(c0) - 1)\n            pr1 = min(h - 1, int(r1) + 1)\n            pc1 = min(w - 1, int(c1) + 1)\n\n            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n            coords = obj[\"coords\"]\n            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n            enclosed = object_interior(patch, background=bg)\n            fill_mask = (patch == bg) & ~enclosed\n\n            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n            target[fill_mask] = halo\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and color palette.\nBACKGROUND = 0\nGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\nAVAILABLE_COLORS = tuple(range(1, 10))\n\n# Legend layout.\nLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\nLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n\n# Sprite geometry and acceptance.\nSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\nSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\nSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\nSPRITE_RETRIES = 300\n\n# Object counts and placement.\nINSTANCE_MIN, INSTANCE_MAX = 1, 3\nOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\nEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\nPLACEMENT_RETRIES = 200\n\n# Whole-sample retry budget.\nGENERATION_RETRIES = 300\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/0934a4d8.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reveal the rectangular patch hidden by the solid marker using the grid's reflection symmetries.\n\n    Input structure:\n    - A square colored pattern with one solid rectangular marker color occluding a patch.\n    - The visible pattern has horizontal and vertical reflection symmetry on a large lower/right strip.\n    - The top and left outer strips also expose transpose counterparts for cells not recoverable by those reflections.\n\n    Rule:\n    - Find the unique color whose full extent is a solid rectangle; this rectangle is the output region.\n    - Infer the reflected strip start as the smallest row/column offset whose lower/right strips are mirror-consistent, ignoring marker pixels.\n    - For each marker pixel, copy the unique non-marker value in its horizontal/vertical reflection orbit; if that orbit is entirely hidden in the outer strip, use the transposed top/left-strip counterpart.\n\n    Key insight:\n    The marker is not part of the pattern; it covers a missing rectangle whose cells are still determined by the visible mirror or transpose copies elsewhere in the grid.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    marker, (r0, c0, r1, c1) = _solid_rectangle_marker(g)\n    lo = _find_reflected_strip_start(g, marker)\n\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    out = np.empty((h, w), dtype=int)\n\n    for rr in range(h):\n        for cc in range(w):\n            r = int(r0 + rr)\n            c = int(c0 + cc)\n            values = _reflection_orbit_values(g, r, c, lo, marker)\n            if values:\n                assert len(values) == 1\n                out[rr, cc] = values.pop()\n            else:\n                assert r < lo or c < lo\n                assert 0 <= c < g.shape[0] and 0 <= r < g.shape[1]\n                value = int(g[c, r])\n                assert value != marker\n                out[rr, cc] = value\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- CFG: canvas & structure ---\n_N = 30                  # grid side length (always square)\n_LO = 2                  # outer border width (rows/cols 0..lo-1 are \"free\" border)\n_HI = _N - 1             # max row/col index\n\n# --- CFG: colors ---\n_PALETTE = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)  # 8 non-marker colors\n_MARKER = 8              # marker fill color\n\n# --- CFG: marker rectangle size ---\n_MARKER_DIM_LO = 3       # min marker side length\n_MARKER_DIM_HI = 9       # max marker side length (inclusive)\n_MARKER_AREA_LO = 16     # min marker area\n_MARKER_AREA_HI = 36     # max marker area\n\n# --- CFG: generation retries ---\n_MAX_RETRIES = 300\n\n_RNG = np.random.default_rng()\n_SIZE_PAIRS = [\n    (h, w)\n    for h in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)\n    for w in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)\n    if _MARKER_AREA_LO <= h * w <= _MARKER_AREA_HI\n]\n_PLACEMENT_CACHE: dict[tuple[int, int], list[tuple[int, int, list[tuple[int, int]]]]] = {}\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 0934a4d8 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/652646ff.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recover each partially hidden 6x6 ring sprite and stack complete copies from top layer to bottom layer.\n\n    Input structure:\n    - The dominant color is the background.\n    - Several non-background colors are visible fragments of the same 12-pixel\n      outline ring in a 6x6 box; small off-template marker pixels are noise.\n    - Ring fragments overlap, so upper rings replace some expected pixels of\n      lower rings, and a ring may also be clipped by the input boundary.\n\n    Rule:\n    - Identify every substantial color whose pixels all lie on one translated\n      copy of the ring template.\n    - For each missing in-bounds template pixel, the color currently occupying\n      that pixel is above the hidden ring.\n    - Topologically sort these occlusion relations from top to bottom, then draw\n      one complete 6x6 ring for each color in that order on a background canvas.\n\n    Key insight:\n    - The output is not a crop of the scene; it is the layer stack of complete\n      ring sprites reconstructed from their visible fragments.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fragments = _find_ring_fragments(g, bg)\n    order = _layer_order(g, fragments)\n\n    out = np.full((_RING_SIZE * len(order), _RING_SIZE), bg, dtype=int)\n    for i, color in enumerate(order):\n        base_r = i * _RING_SIZE\n        for dr, dc in _RING:\n            out[base_r + dr, dc] = color\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Ring template shared by rendering, validation, and output stacking.\n_GEN_RING: tuple[tuple[int, int], ...] = (\n    (0, 2),\n    (0, 3),\n    (1, 1),\n    (1, 4),\n    (2, 0),\n    (2, 5),\n    (3, 0),\n    (3, 5),\n    (4, 1),\n    (4, 4),\n    (5, 2),\n    (5, 3),\n)\n_GEN_RING_SIZE = 6\n\n# Scene size and structural counts.\n_GEN_GRID_SIZE_RANGE = (10, 20)\n_GEN_RING_COUNT_RANGE = (2, 4)\n_GEN_VISIBLE_PIXELS_RANGE = (8, 11)\n_GEN_COLORS = tuple(range(10))\n\n# Noise colors are isolated marker pixels on background cells.\n_GEN_NOISE_COLOR_COUNT_RANGE = (1, 2)\n_GEN_NOISE_PIXELS_PER_COLOR_RANGE = (2, 5)\n_GEN_NOISE_CLEARANCE = 1\n\n# Retry budget for rejection sampling a solver-consistent input.\n_GEN_MAX_ATTEMPTS = 300\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 652646ff input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/271d71e2.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move bordered containers toward same-colored destination markers, charging gray cells to orange.\n\n    Input structure:\n    - bg = 6 (magenta). Black-bordered (0) rectangles with gray (5) / orange (7) interiors.\n    - A head sprite (9) sits adjacent to one container edge; a matching destination sprite lies along the movement axis.\n\n    Rule:\n    - Each container translates toward its destination along the head-to-dest axis.\n    - Steps = min(head-to-dest distance, number of gray interior cells).\n    - Gray cells become orange from the head-facing side inward, one per step.\n\n    Key insight: Gray cell count caps movement — a container stops short if it runs out of gray cells to charge.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    BORDER = 0\n    GREY = 5\n    FILL = 7\n    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    # True background is dominant non-border color (border can dominate in some cases).\n    cnt = Counter(map(int, g.flatten()))\n    bg = int(max((c for c in cnt.keys() if int(c) != int(BORDER)), key=lambda c: int(cnt[int(c)])))\n\n    def rect_border_coords(r0: int, c0: int, r1: int, c1: int):\n        for c in range(c0, c1 + 1):\n            yield (r0, c)\n            yield (r1, c)\n        for r in range(r0 + 1, r1):\n            yield (r, c0)\n            yield (r, c1)\n\n    # --- detect containers as rectangles enclosing GREY/FILL with BORDER frame ---\n    containers = []\n    for pts in components_mask((g == GREY) | (g == FILL), connectivity=4):\n        if pts.size == 0:\n            continue\n        ir0, ic0, ir1, ic1 = bbox_coords(pts)\n        r0, c0, r1, c1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)\n        if r0 < 0 or c0 < 0 or r1 >= H or c1 >= W:\n            continue\n        if any(int(g[r, c]) != BORDER for r, c in rect_border_coords(r0, c0, r1, c1)):\n            continue\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        if inner.size == 0 or not bool(np.isin(inner, [GREY, FILL]).all()):\n            continue\n        containers.append({\"box\": (r0, c0, r1, c1)})\n\n    assert not (not containers)\n\n    # head + destination are in some non-bg, non-border color (not GREY/FILL)\n    out = g.copy()\n\n    all_head_colors = [c for c in colors_present(g, exclude={bg, BORDER, GREY, FILL})]\n\n    # Precompute components for each head color.\n    comp_by_color: dict[int, list[dict]] = defaultdict(list)\n    for col in all_head_colors:\n        labc, nc = label(g == int(col), structure=STRUCT4)\n        for k in range(1, int(nc) + 1):\n            coords = np.argwhere(labc == int(k))\n            if coords.size == 0:\n                continue\n            r0, c0, r1, c1 = bbox_coords(coords)\n            pts = {(int(r), int(c)) for r, c in coords}\n            shape = {(int(r - r0), int(c - c0)) for r, c in pts}\n            comp_by_color[int(col)].append({\"pts\": pts, \"shape\": shape, \"tl\": (int(r0), int(c0))})\n\n    def pick_head_for_container(box_):\n        r0, c0, r1, c1 = box_\n        head_seeds = []\n        for r, c in rect_border_coords(r0, c0, r1, c1):\n            for dr, dc in DIR4:\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < H and 0 <= cc < W:\n                    val = int(g[rr, cc])\n                    if val not in (int(bg), int(BORDER), int(GREY), int(FILL)):\n                        head_seeds.append((rr, cc, val))\n        if not head_seeds:\n            return None\n\n        hc = int(Counter(val for _r, _c, val in head_seeds).most_common(1)[0][0])\n        seed_pts = {(r, c) for r, c, val in head_seeds if int(val) == int(hc)}\n        cands = comp_by_color.get(hc, [])\n        comp0 = None\n        for comp in cands:\n            if comp[\"pts\"] & seed_pts:\n                comp0 = comp\n                break\n        if comp0 is None:\n            return None\n\n        # Split head vs destination even if same-color pixels touch:\n        # head pixels are those with minimal manhattan distance to this container border.\n        border_pts = list(rect_border_coords(r0, c0, r1, c1))\n        best_d = None\n        dist = {}\n        for pr, pc in comp0[\"pts\"]:\n            d = min(abs(int(pr - br)) + abs(int(pc - bc)) for br, bc in border_pts)\n            dist[(int(pr), int(pc))] = int(d)\n            if best_d is None or d < best_d:\n                best_d = int(d)\n        if best_d is None:\n            return None\n        head_pts = {p for p, d in dist.items() if int(d) == int(best_d)}\n\n        # direction from head bbox relative to container box\n        coords = np.array(list(head_pts), dtype=int)\n        hr0, hc0, hr1, hc1 = bbox_coords(coords)\n        if hc1 < c0:\n            direction = (0, -1)\n        elif hc0 > c1:\n            direction = (0, 1)\n        elif hr1 < r0:\n            direction = (-1, 0)\n        elif hr0 > r1:\n            direction = (1, 0)\n        else:\n            direction = (0, 0)\n\n        # normalized head shape + top-left\n        r00, c00 = int(hr0), int(hc0)\n        head_shape = {(int(r - r00), int(c - c00)) for r, c in head_pts}\n        return {\n            \"color\": hc,\n            \"head_pts\": head_pts,\n            \"head_shape\": head_shape,\n            \"head_tl\": (r00, c00),\n            \"comp_pts\": set(comp0[\"pts\"]),\n            \"dir\": direction,\n        }\n\n    for cont in containers:\n        box_ = cont[\"box\"]\n        r0, c0, r1, c1 = box_\n\n        head_info = pick_head_for_container(box_)\n        if head_info is None:\n            continue\n        hc = int(head_info[\"color\"])\n        head_pts = set(head_info[\"head_pts\"])\n        head_shape = head_info[\"head_shape\"]\n        head_tl = head_info[\"head_tl\"]\n        comp_pts = set(head_info[\"comp_pts\"])\n        direction = head_info[\"dir\"]\n        if direction == (0, 0):\n            continue\n\n        # destination candidates\n        dests = []\n        for d in comp_by_color.get(hc, []):\n            if d[\"shape\"] != head_shape:\n                continue\n            if d[\"pts\"] == comp_pts:\n                continue\n            dests.append(d)\n\n        # add split-from-same-component destinations (when dest touches head by color)\n        rem = comp_pts - head_pts\n        if rem:\n            mask_rem = np.zeros((H, W), dtype=bool)\n            for rr, cc in rem:\n                mask_rem[int(rr), int(cc)] = True\n            labr, nr = label(mask_rem, structure=STRUCT4)\n            for k in range(1, int(nr) + 1):\n                pts = {(int(r), int(c)) for r, c in np.argwhere(labr == int(k))}\n                if not pts:\n                    continue\n                # reject if adjacent to BORDER\n                adj = False\n                for r, c in pts:\n                    for dr, dc in DIR4:\n                        rr, cc = int(r + dr), int(c + dc)\n                        if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(BORDER):\n                            adj = True\n                            break\n                    if adj:\n                        break\n                if adj:\n                    continue\n                rs = [r for r, _c in pts]\n                cs = [c for _r, c in pts]\n                r00, c00 = int(min(rs)), int(min(cs))\n                shp = {(int(r - r00), int(c - c00)) for r, c in pts}\n                if shp != head_shape:\n                    continue\n                dests.append({\"pts\": pts, \"shape\": shp, \"tl\": (r00, c00)})\n\n        if not dests:\n            continue\n\n        best = None\n        best_dest = None\n        for d in dests:\n            tr0 = int(d[\"tl\"][0] - head_tl[0])\n            tc0 = int(d[\"tl\"][1] - head_tl[1])\n            if direction[0] != 0 and tc0 != 0:\n                continue\n            if direction[1] != 0 and tr0 != 0:\n                continue\n            if direction[0] == 1 and tr0 <= 0:\n                continue\n            if direction[0] == -1 and tr0 >= 0:\n                continue\n            if direction[1] == 1 and tc0 <= 0:\n                continue\n            if direction[1] == -1 and tc0 >= 0:\n                continue\n            dist = abs(tr0) + abs(tc0)\n            if best is None or dist < best:\n                best = dist\n                best_dest = d\n        if best_dest is None:\n            continue\n\n        # translation to overlap head onto destination, capped by number of GREY cells\n        tr0 = int(best_dest[\"tl\"][0] - head_tl[0])\n        tc0 = int(best_dest[\"tl\"][1] - head_tl[1])\n        steps = abs(tr0) + abs(tc0)\n\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        grey_coords = [\n            (int(r0 + 1 + rr), int(c0 + 1 + cc))\n            for rr in range(inner.shape[0])\n            for cc in range(inner.shape[1])\n            if int(inner[rr, cc]) == GREY\n        ]\n        steps = min(int(steps), int(len(grey_coords)))\n\n        dr, dc = direction\n        tr = int(dr * steps)\n        tc = int(dc * steps)\n\n        # choose which greys to fill in order from head side inward\n        if direction == (0, 1):\n            order = sorted(grey_coords, key=lambda p: (-p[1], p[0]))\n        elif direction == (0, -1):\n            order = sorted(grey_coords, key=lambda p: (p[1], -p[0]))\n        elif direction == (1, 0):\n            order = sorted(grey_coords, key=lambda p: (-p[0], -p[1]))\n        else:  # (-1,0)\n            order = sorted(grey_coords, key=lambda p: (p[0], p[1]))\n        to_fill = set(order[:steps])\n\n        # erase original container rect and original head pixels (destination stays)\n        out[r0 : r1 + 1, c0 : c1 + 1] = int(bg)\n        for r, c in head_pts:\n            if int(out[int(r), int(c)]) == int(hc):\n                out[int(r), int(c)] = int(bg)\n\n        # stamp moved container rectangle (using paste for the bulk placement)\n        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        if to_fill:\n            for rr, cc in to_fill:\n                pr = int(rr - r0)\n                pc = int(cc - c0)\n                if 0 <= pr < patch.shape[0] and 0 <= pc < patch.shape[1] and int(patch[pr, pc]) == GREY:\n                    patch[pr, pc] = int(FILL)\n        paste(out, patch, int(r0 + tr), int(c0 + tc), clip=True)\n\n        # stamp moved head pixels\n        for r, c in head_pts:\n            rrr = int(r + tr)\n            ccc = int(c + tc)\n            if 0 <= rrr < H and 0 <= ccc < W:\n                out[rrr, ccc] = int(hc)\n\n    return out\n\n# --------------- generator (attempt 2, Claude) ---------------\n\nBG = 6\nBORDER = 0\nGREY = 5\nORANGE = 7\nHEAD_COLOR = 9\n\n# Direction mapping: head_side -> (dr, dc) movement direction\n# head on top -> container moves up; head on bottom -> moves down, etc.\nSIDE_TO_DIR = {0: (-1, 0), 1: (1, 0), 2: (0, -1), 3: (0, 1)}\n\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid after 300 attempts\")\n\n","exit_code":0,"status":"completed"}}
