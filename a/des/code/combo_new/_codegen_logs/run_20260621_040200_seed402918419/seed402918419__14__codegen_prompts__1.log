{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox, components_mask, paste, random_free_location\nimport random\n\n\ndef _split_panels(g: np.ndarray) -> tuple[list[np.ndarray], set[int]]:\n    h, w = g.shape\n    candidates: list[tuple[list[np.ndarray], set[int]]] = []\n\n    for horizontal in (False, True):\n        dim = w if horizontal else h\n        for n in range(3, dim + 1):\n            if dim % n:\n                continue\n            ph, pw = (h, w // n) if horizontal else (h // n, w)\n            if ph < 2 or pw < 2:\n                continue\n            if horizontal:\n                panels = [g[:, i * pw : (i + 1) * pw] for i in range(n)]\n            else:\n                panels = [g[i * ph : (i + 1) * ph, :] for i in range(n)]\n\n            template = panels[-1]\n            template_colors = set(map(int, template.ravel()))\n            diff_colors: set[int] = set()\n            diff_counts = []\n            for panel in panels[:-1]:\n                diff = panel != template\n                diff_counts.append(int(diff.sum()))\n                diff_colors.update(map(int, panel[diff].ravel()))\n\n            if not diff_colors or not all(diff_counts):\n                continue\n            if diff_colors & template_colors:\n                continue\n            occurrences = {\n                color: sum(bool(np.any(panel == color)) for panel in panels[:-1])\n                for color in diff_colors\n            }\n            if not all(count >= 2 for count in occurrences.values()):\n                continue\n            candidates.append((panels, diff_colors))\n\n    assert len(candidates) == 1\n    return candidates[0]\n\n\ndef _intervals(line: np.ndarray) -> list[tuple[int, int]]:\n    out: list[tuple[int, int]] = []\n    i = 0\n    while i < len(line):\n        if not line[i]:\n            i += 1\n            continue\n        j = i\n        while j + 1 < len(line) and line[j + 1]:\n            j += 1\n        out.append((i, j))\n        i = j + 1\n    return out\n\n\ndef _shift_intervals(\n    intervals: list[tuple[int, int]], step: int, length: int\n) -> list[tuple[int, int]]:\n    shifted = []\n    for start, end in intervals:\n        new_start = start + step\n        new_end = end + step\n        assert 0 <= new_start <= new_end < length\n        shifted.append((new_start, new_end))\n    return shifted\n\n\ndef _is_prefix(shorter: list[tuple[int, int]], longer: list[tuple[int, int]]) -> bool:\n    return len(shorter) <= len(longer) and all(a == b for a, b in zip(shorter, longer))\n\n\ndef _required_bbox(mask: np.ndarray) -> tuple[int, int, int, int]:\n    b = bbox(mask)\n    assert b is not None\n    return b\n\n\ndef _motion_axis(a: np.ndarray, b: np.ndarray) -> tuple[int, int]:\n    ar0, ac0, ar1, ac1 = _required_bbox(a)\n    br0, bc0, br1, bc1 = _required_bbox(b)\n    row_motion = abs(br0 - ar0) + abs(br1 - ar1)\n    col_motion = abs(bc0 - ac0) + abs(bc1 - ac1)\n    assert row_motion != col_motion\n\n    if row_motion > col_motion:\n        deltas = [br0 - ar0, br1 - ar1]\n        axis = 0\n    else:\n        deltas = [bc0 - ac0, bc1 - ac1]\n        axis = 1\n    nonzero = [delta for delta in deltas if delta]\n    assert nonzero and all((delta > 0) == (nonzero[0] > 0) for delta in nonzero)\n    direction = 1 if nonzero[0] > 0 else -1\n    return axis, direction\n\n\ndef _draw_intervals(mask: np.ndarray, axis: int, line: int, intervals: list[tuple[int, int]]) -> None:\n    for start, end in intervals:\n        if axis == 0:\n            mask[start : end + 1, line] = True\n        else:\n            mask[line, start : end + 1] = True\n\n\ndef _extrapolate_mask(a: np.ndarray, b: np.ndarray) -> np.ndarray:\n    assert a.any() and b.any()\n    assert not np.array_equal(a, b)\n\n    axis, direction = _motion_axis(a, b)\n    added = b & ~a\n    assert added.any()\n    added_coords = np.argwhere(added)\n    extent = int(added_coords[:, axis].max() - added_coords[:, axis].min() + 1)\n    global_step = direction * extent\n\n    out = np.zeros_like(b, dtype=bool)\n    line_count = b.shape[1 - axis]\n    length = b.shape[axis]\n    for line in range(line_count):\n        if axis == 0:\n            a_intervals = _intervals(a[:, line])\n            b_intervals = _intervals(b[:, line])\n        else:\n            a_intervals = _intervals(a[line, :])\n            b_intervals = _intervals(b[line, :])\n\n        if not a_intervals and not b_intervals:\n            next_intervals: list[tuple[int, int]] = []\n        elif a_intervals and len(a_intervals) == len(b_intervals):\n            next_intervals = []\n            for (a0, a1), (b0, b1) in zip(a_intervals, b_intervals):\n                new_start = b0 + (b0 - a0)\n                new_end = b1 + (b1 - a1)\n                assert 0 <= new_start <= new_end < length\n                next_intervals.append((new_start, new_end))\n        elif a_intervals and _is_prefix(a_intervals, b_intervals):\n            extra_count = len(b_intervals) - len(a_intervals)\n            assert 0 < extra_count <= len(a_intervals)\n            previous = a_intervals[-extra_count:]\n            extra = b_intervals[-extra_count:]\n            steps = {\n                end_new - end_old\n                for old, new in zip(previous, extra)\n                for end_old, end_new in zip(old, new)\n            }\n            assert len(steps) == 1\n            step = steps.pop()\n            assert step\n            next_intervals = list(b_intervals) + _shift_intervals(extra, step, length)\n        elif not a_intervals and b_intervals:\n            next_intervals = list(b_intervals) + _shift_intervals(\n                b_intervals, global_step, length\n            )\n        else:\n            raise AssertionError\n\n        _draw_intervals(out, axis, line, next_intervals)\n\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Predict the next panel in a framed sequence by continuing each scheduled colored interval.\n\n    Input structure\n    - The grid is made from three or more equal panels in one row or one column.\n    - The final input panel is the static target template; every earlier panel differs from it only by dynamic colors absent from the template.\n    - Each dynamic color appears in a regular temporal schedule across the earlier panels.\n\n    Rule\n    - Keep the final template panel as the output canvas.\n    - For every dynamic color whose schedule reaches the next panel, compare its last two appearances.\n    - Extrapolate each one-dimensional interval along the color's changing row or column axis and paint that predicted mask.\n\n    Key insight\n    - The task is not asking for the last visible panel, but for the next frame after the blank/template slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    panels, diff_colors = _split_panels(g)\n    template = panels[-1]\n    prior = panels[:-1]\n    next_time = len(prior)\n\n    predictions: list[tuple[int, np.ndarray]] = []\n    for color in diff_colors:\n        times = [i for i, panel in enumerate(prior) if np.any(panel == color)]\n        assert len(times) >= 2\n        gaps = [b - a for a, b in zip(times, times[1:])]\n        assert len(set(gaps)) == 1\n        period = gaps[0]\n        if next_time - times[-1] != period:\n            continue\n\n        previous = prior[times[-2]] == color\n        current = prior[times[-1]] == color\n        predictions.append((color, _extrapolate_mask(previous, current)))\n\n    assert predictions\n    occupied = np.zeros_like(template, dtype=bool)\n    for _color, mask in predictions:\n        assert not np.any(occupied & mask)\n        occupied |= mask\n\n    out = template.copy()\n    for color, mask in predictions:\n        out[mask] = color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, orientation, and color sampling.\nPANEL_SIZE_MIN, PANEL_SIZE_MAX = 5, 11\nPANEL_COUNT_CHOICES, ORIENTATION_CHOICES = (3, 5), (False, True)\nCOLOR_POOL, TOTAL_COLOR_CHOICES, MOTION_AXIS_CHOICES = range(10), (4, 5), (0, 1)\n\n# Template decoration density and symmetry.\nTEMPLATE_MIN_DECO_CELLS = 4\nTEMPLATE_DECO_MIN_RATIO, TEMPLATE_DECO_MAX_RATIO = 0.10, 0.30\n\n# Blob motif and growth bounds.\nBLOB_GROWTH_MIN, BLOB_GROWTH_MAX = 1, 4\nBLOB_MAX_INITIAL_CELLS, BLOB_MAX_COMPONENTS = 7, 2\nBLOB_MAX_LINE_COUNT, BLOB_MAX_WIDTH = 3, 3\nBLOB_DIRECTIONS = (-1, 1)\n\n# Dynamic-color schedules.\nSHORT_PRIOR_COUNT, MAX_DYNAMIC_COLORS = 2, 3\nSCHEDULE_ALWAYS_2 = {\"period\": 1, \"times\": [0, 1], \"scheduled\": True}\nSCHEDULE_ALWAYS_4 = {\"period\": 1, \"times\": [0, 1, 2, 3], \"scheduled\": True}\nSCHEDULE_EVEN_4 = {\"period\": 2, \"times\": [0, 2], \"scheduled\": True}\nSCHEDULE_FIRST3_4 = {\"period\": 1, \"times\": [0, 1, 2], \"scheduled\": False}\nSCHEDULE_ODD_4 = {\"period\": 2, \"times\": [1, 3], \"scheduled\": False}\nSCHEDULE_SECOND_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4)\nSCHEDULE_THIRD_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4, SCHEDULE_FIRST3_4, SCHEDULE_ODD_4)\n\n# Placement and retry limits.\nMASK_TRANSPARENT, PLACEMENT_BORDER = 0, 1\nGENERATION_RETRIES = 300\n\ndef _sym_orbits(h: int, w: int) -> list[list[tuple[int, int]]]:\n    seen: set[tuple[int, int]] = set()\n    orbits: list[list[tuple[int, int]]] = []\n    for r in range(h):\n        for c in range(w):\n            if r not in (0, h - 1) and c not in (0, w - 1):\n                continue\n            if (r, c) in seen:\n                continue\n            orbit = sorted({(r, c), (r, w - 1 - c), (h - 1 - r, c), (h - 1 - r, w - 1 - c)})\n            seen.update(orbit)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/e734a0e8.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\nimport random\nfrom arc_utils import paste\n\n\ndef _unique_mode(values: np.ndarray) -> int:\n    counts = Counter(map(int, values.reshape(-1)))\n    ranked = counts.most_common()\n    assert ranked, \"expected a nonempty set of values\"\n    assert len(ranked) == 1 or ranked[0][1] > ranked[1][1], \"expected a unique dominant color\"\n    return int(ranked[0][0])\n\n\ndef _separator_lines(g: np.ndarray) -> tuple[int, list[int], list[int]]:\n    height, width = map(int, g.shape)\n    candidates = []\n    for color in np.unique(g):\n        color = int(color)\n        rows = [r for r in range(height) if np.all(g[r, :] == color)]\n        cols = [c for c in range(width) if np.all(g[:, c] == color)]\n        if rows and cols:\n            candidates.append((color, rows, cols))\n    assert len(candidates) == 1, \"expected one color to form full separator rows and columns\"\n    return candidates[0]\n\n\ndef _spans(length: int, separators: list[int]) -> list[tuple[int, int]]:\n    spans = []\n    start = 0\n    for sep in separators:\n        assert start < sep, \"separator lines must leave nonempty regions\"\n        spans.append((start, sep - 1))\n        start = sep + 1\n    assert start < length, \"separator lines must leave a final nonempty region\"\n    spans.append((start, length - 1))\n    return spans\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Copy the unique colored sprite tile into every tiled cell marked by an internal separator-colored pixel.\n\n    Input structure\n    - Full same-color separator rows and columns partition the grid into equal rectangular tiles.\n    - One tile contains the only non-background, non-separator colored sprite.\n    - Target tiles are otherwise background-colored but contain at least one internal pixel of the separator color.\n\n    Rule\n    - Keep the separator lines and the source sprite tile unchanged.\n    - Replace each marked target tile with an exact copy of the source tile.\n    - Unmarked background-only tiles remain unchanged.\n\n    Key insight\n    - The internal separator-colored pixels are placement markers; the single colored tile is the template to stamp into those marked cells.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.size > 0, \"expected a nonempty 2D grid\"\n\n    separator, sep_rows, sep_cols = _separator_lines(g)\n    row_spans = _spans(g.shape[0], sep_rows)\n    col_spans = _spans(g.shape[1], sep_cols)\n\n    tile_heights = {r1 - r0 + 1 for r0, r1 in row_spans}\n    tile_widths = {c1 - c0 + 1 for c0, c1 in col_spans}\n    assert len(tile_heights) == 1 and len(tile_widths) == 1, \"expected equal-sized tile rows and columns\"\n    tile_h = tile_heights.pop()\n    tile_w = tile_widths.pop()\n\n    bg = _unique_mode(g[g != separator])\n    assert bg != separator, \"background and separator colors must differ\"\n    sprite_colors = [int(color) for color in np.unique(g) if int(color) not in {bg, separator}]\n    assert len(sprite_colors) == 1, \"expected one sprite color\"\n    sprite_color = sprite_colors[0]\n\n    source_tiles = []\n    marked_origins = []\n    for r0, r1 in row_spans:\n        for c0, c1 in col_spans:\n            tile = g[r0 : r1 + 1, c0 : c1 + 1]\n            assert tile.shape == (tile_h, tile_w)\n            has_sprite = np.any(tile == sprite_color)\n            has_marker = np.any(tile == separator)\n            if has_sprite:\n                assert not has_marker, \"source tile should contain only sprite and background\"\n                assert set(map(int, np.unique(tile))).issubset({bg, sprite_color})\n                source_tiles.append(tile.copy())\n            elif has_marker:\n                assert set(map(int, np.unique(tile))).issubset({bg, separator})\n                marked_origins.append((r0, c0))\n            else:\n                assert np.all(tile == bg), \"unmarked non-source tiles should be plain background\"\n\n    assert len(source_tiles) == 1, \"expected exactly one source sprite tile\"\n    source_tile = source_tiles[0]\n\n    out = g.copy()\n    for r0, c0 in marked_origins:\n        out[r0 : r0 + tile_h, c0 : c0 + tile_w] = source_tile\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette: separator, background, and sprite are distinct.\nCOLOR_POOL = range(10)\nPALETTE_SIZE = 3\n# Tile grid dimensions and odd square tile sizes.\nTILE_ROWS_RANGE = (3, 4)\nTILE_COLS_RANGE = (3, 4)\nTILE_SIZE_CHOICES = [3, 5]\nSEPARATOR_WIDTH = 1\n# Sprite density and 4-connected component count by tile size.\nSPRITE_PIXEL_RANGES = {3: (3, 4), 5: (8, 11)}\nSPRITE_COMPONENT_CAPS = {3: 3, 5: 5}\nNEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nORIENTATION_COUNT = 4\nFLIP_PROBABILITY = 0.5\n# Marker tiles and retry budget.\nMARKER_COUNT_RANGE = (3, 5)\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_neighbors4(r: int, c: int, size: int):\n    for dr, dc in NEIGHBOR_OFFSETS_4:\n        rr, cc = r + dr, c + dc\n        if 0 <= rr < size and 0 <= cc < size:\n            yield rr, cc\n\n\ndef _gen_partition(total: int, parts: int) -> list[int]:\n    sizes = [1] * parts\n    for _ in range(total - parts):\n        sizes[random.randrange(parts)] += 1\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _gen_separate_from_other(labels: np.ndarray, r: int, c: int, label: int) -> bool:\n    size = int(labels.shape[0])\n    for rr, cc in _gen_neighbors4(r, c, size):\n        if labels[rr, cc] not in (0, label):\n            return False\n    return True\n\n\ndef _gen_sprite_tile(size: int, bg: int, sprite_color: int) -> np.ndarray | None:\n    pixel_count = random.randint(*SPRITE_PIXEL_RANGES[size])\n    component_count = random.randint(1, min(SPRITE_COMPONENT_CAPS[size], pixel_count))\n    labels = np.zeros((size, size), dtype=int)\n    for label, component_size in enumerate(_gen_partition(pixel_count, component_count), start=1):\n        seed_candidates = [\n            (r, c)\n            for r in range(size)\n            for c in range(size)\n            if labels[r, c] == 0 and _gen_separate_from_other(labels, r, c, label)\n        ]\n        if not seed_candidates:\n            return None\n\n        seed = random.choice(seed_candidates)\n        labels[seed] = label\n        cells = [seed]\n        while len(cells) < component_size:\n            growth = []\n            for r, c in cells:\n                for rr, cc in _gen_neighbors4(r, c, size):\n                    if labels[rr, cc] == 0 and _gen_separate_from_other(labels, rr, cc, label):\n                        growth.append((rr, cc))\n            if not growth:\n                return None\n            cell = random.choice(growth)\n            labels[cell] = label\n            cells.append(cell)\n\n    tile = np.full((size, size), bg, dtype=int)\n    tile[labels > 0] = sprite_color\n    tile = np.rot90(tile, random.randrange(ORIENTATION_COUNT))\n    if random.random() < FLIP_PROBABILITY:\n        tile = np.fliplr(tile)\n    if random.random() < FLIP_PROBABILITY:\n        tile = np.flipud(tile)\n    return tile.copy()\n\n\ndef _gen_tile_origin(tile_r: int, tile_c: int, tile_size: int) -> tuple[int, int]:\n    return tile_r * (tile_size + SEPARATOR_WIDTH), tile_c * (tile_size + SEPARATOR_WIDTH)\n\n\ndef _gen_base_grid(tile_rows: int, tile_cols: int, tile_size: int, bg: int, separator: int) -> np.ndarray:\n    height = tile_rows * tile_size + (tile_rows - 1) * SEPARATOR_WIDTH\n    width = tile_cols * tile_size + (tile_cols - 1) * SEPARATOR_WIDTH\n    grid = np.full((height, width), bg, dtype=int)\n    grid[tile_size :: tile_size + SEPARATOR_WIDTH, :] = separator\n    grid[:, tile_size :: tile_size + SEPARATOR_WIDTH] = separator\n    return grid\n\n\ndef _gen_paste_tile(grid: np.ndarray, pos: tuple[int, int], tile: np.ndarray, tile_size: int) -> None:\n    r0, c0 = _gen_tile_origin(pos[0], pos[1], tile_size)\n    paste(grid, tile, r0, c0)\n\n\ndef _gen_render_pair(tile_rows, tile_cols, tile_size, separator, bg, sprite_tile, source_pos, marked_positions):\n    expected = _gen_base_grid(tile_rows, tile_cols, tile_size, bg, separator)\n    for pos in [source_pos, *marked_positions]:\n        _gen_paste_tile(expected, pos, sprite_tile, tile_size)\n\n    inp = expected.copy()\n    marker_tile = np.full((tile_size, tile_size), bg, dtype=int)\n    marker_tile[tile_size // 2, tile_size // 2] = separator\n    for pos in marked_positions:\n        _gen_paste_tile(inp, pos, marker_tile, tile_size)\n    return inp, expected\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    separator, bg, sprite_color = random.sample(COLOR_POOL, PALETTE_SIZE)\n    tile_rows, tile_cols, tile_size = (\n        random.randint(*TILE_ROWS_RANGE),\n        random.randint(*TILE_COLS_RANGE),\n        random.choice(TILE_SIZE_CHOICES),\n    )\n\n    sprite_tile = _gen_sprite_tile(tile_size, bg, sprite_color)\n    if sprite_tile is None:\n        return None\n\n    tile_positions = [(r, c) for r in range(tile_rows) for c in range(tile_cols)]\n    source_pos = random.choice(tile_positions)\n    marker_count = random.randint(*MARKER_COUNT_RANGE)\n    marked_positions = random.sample([pos for pos in tile_positions if pos != source_pos], marker_count)\n    inp, expected = _gen_render_pair(\n        tile_rows, tile_cols, tile_size, separator, bg, sprite_tile, source_pos, marked_positions\n    )\n    try:\n        actual = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid e734a0e8 input\")\n","exit_code":0,"status":"completed"}}
