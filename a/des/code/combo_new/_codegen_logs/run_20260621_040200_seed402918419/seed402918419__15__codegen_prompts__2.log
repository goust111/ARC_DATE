{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\n\ndef conn(mask):\n    h=len(mask); w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]]\n    if not pts: return False\n    q=deque([pts[0]]); seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            rr,cc=r+dr,c+dc\n            if 0<=rr<h and 0<=cc<w and mask[rr][cc] and (rr,cc) not in seen:\n                seen.add((rr,cc)); q.append((rr,cc))\n    return len(seen)==len(pts)\n\ndef touches_all(mask):\n    h=len(mask); w=len(mask[0])\n    top=any(mask[0][c] for c in range(w))\n    bot=any(mask[h-1][c] for c in range(w))\n    left=any(mask[r][0] for r in range(h))\n    right=any(mask[r][w-1] for r in range(h))\n    return top and bot and left and right\n\ndef rand_path(a,b,h,w):\n    r,c=a\n    rr,cc=b\n    cells=[(r,c)]\n    while (r,c)\"'!=(rr,cc):\n        opts=[]\n        if r<rr: opts.append((r+1,c))\n        if r>rr: opts.append((r-1,c))\n        if c<cc: opts.append((r,c+1))\n        if c>cc: opts.append((r,c-1))\n        r,c=random.choice(opts)\n        cells.append((r,c))\n    return cells\n\ndef sample(h,w,tries=5000):\n    for _ in range(tries):\n        anchors=[(0, random.randrange(w)), (h-1, random.randrange(w)), (random.randrange(h),0), (random.randrange(h), w-1)]\n        order=list(range(4)); random.shuffle(order)\n        aset={anchors[order[0]]}\n        cur=anchors[order[0]]\n        for idx in order[1:]:\n            p=rand_path(cur, anchors[idx], h,w)\n            aset.update(p)\n            cur=anchors[idx]\n        # grow randomly to around half\n        target=random.randint(max(len(aset), (h*w)//3), min(h*w-1, (2*h*w)//3))\n        frontier=[p for p in aset]\n        while len(aset)<target:\n            nbrs=[]\n            for r,c in list(aset):\n                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                    rr,cc=r+dr,c+dc\n                    if 0<=rr<h and 0<=cc<w and (rr,cc) not in aset:\n                        nbrs.append((rr,cc))\n            if not nbrs: break\n            aset.add(random.choice(nbrs))\n        A=[[False]*w for _ in range(h)]\n        for r,c in aset: A[r][c]=True\n        B=[[not A[r][c] for c in range(w)] for r in range(h)]\n        if conn(A) and conn(B) and touches_all(A) and touches_all(B):\n            return A\n    return None\n\nfor h in range(2,8):\n  for w in range(2,8):\n    ok=0\n    for _ in range(50):\n      if sample(h,w,tries=200): ok+=1\n    if ok:\n      print((h,w), ok)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
