{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom itertools import product\nfrom collections import deque\n\ndef conn(cells,h,w):\n    cells=set(cells)\n    if not cells: return False\n    q=deque([next(iter(cells))]); seen={q[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            rr,cc=r+dr,c+dc\n            if (rr,cc) in cells and (rr,cc) not in seen:\n                seen.add((rr,cc)); q.append((rr,cc))\n    return len(seen)==len(cells)\n\ndef touches(cells,h,w):\n    return any(r==0 for r,c in cells) and any(r==h-1 for r,c in cells) and any(c==0 for r,c in cells) and any(c==w-1 for r,c in cells)\n\nfor h,w in [(2,2),(2,3),(2,4),(3,3),(3,4),(4,4)]:\n    cells=[(r,c) for r in range(h) for c in range(w)]\n    found=[]\n    for bits in range(1,1<<(h*w)):\n        A={cells[i] for i in range(h*w) if bits>>i & 1}\n        B=set(cells)-A\n        if conn(A,h,w) and conn(B,h,w) and touches(A,h,w) and touches(B,h,w):\n            found.append(A)\n            break\n    print((h,w), bool(found))\n    if found:\n        A=found[0]\n        for r in range(h):\n            print(''.join('A' if (r,c) in A else 'B' for c in range(w)))\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
