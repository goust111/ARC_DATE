{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport z3\n\ndef find(h,w):\n    s=z3.Solver()\n    A=[[z3.Bool(f'a_{r}_{c}') for c in range(w)] for r in range(h)]\n    Ar=[[z3.Int(f'ar_{r}_{c}') for c in range(w)] for r in range(h)]\n    Br=[[z3.Int(f'br_{r}_{c}') for c in range(w)] for r in range(h)]\n    Aroot=[[z3.Bool(f'aroot_{r}_{c}') for c in range(w)] for r in range(h)]\n    Broot=[[z3.Bool(f'broot_{r}_{c}') for c in range(w)] for r in range(h)]\n    cells=[(r,c) for r in range(h) for c in range(w)]\n    # nontrivial partition\n    s.add(z3.PbGe([(A[r][c],1) for r,c in cells],1))\n    s.add(z3.PbLe([(A[r][c],1) for r,c in cells],h*w-1))\n    # touch all sides for A and B\n    for conds in [A, [[z3.Not(A[r][c]) for c in range(w)] for r in range(h)]]:\n        s.add(z3.Or([conds[0][c] for c in range(w)]))\n        s.add(z3.Or([conds[h-1][c] for c in range(w)]))\n        s.add(z3.Or([conds[r][0] for r in range(h)]))\n        s.add(z3.Or([conds[r][w-1] for r in range(h)]))\n    # one root in each set\n    s.add(z3.PbEq([(Aroot[r][c],1) for r,c in cells],1))\n    s.add(z3.PbEq([(Broot[r][c],1) for r,c in cells],1))\n    for r,c in cells:\n        s.add(z3.Implies(Aroot[r][c], A[r][c]))\n        s.add(z3.Implies(Broot[r][c], z3.Not(A[r][c])))\n        s.add(z3.Implies(A[r][c], z3.And(Ar[r][c] >= 0, Ar[r][c] < h*w)))\n        s.add(z3.Implies(z3.Not(A[r][c]), Ar[r][c] == -1))\n        s.add(z3.Implies(z3.Not(A[r][c]), z3.And(Br[r][c] >= 0, Br[r][c] < h*w)))\n        s.add(z3.Implies(A[r][c], Br[r][c] == -1))\n        s.add(z3.Implies(Aroot[r][c], Ar[r][c] == 0))\n        s.add(z3.Implies(Broot[r][c], Br[r][c] == 0))\n        an=[]; bn=[]\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            rr,cc=r+dr,c+dc\n            if 0<=rr<h and 0<=cc<w:\n                an.append((rr,cc))\n                bn.append((rr,cc))\n        s.add(z3.Implies(z3.And(A[r][c], z3.Not(Aroot[r][c])), z3.Or([z3.And(A[rr][cc], Ar[rr][cc] == Ar[r][c]-1) for rr,cc in an])))\n        s.add(z3.Implies(z3.And(z3.Not(A[r][c]), z3.Not(Broot[r][c])), z3.Or([z3.And(z3.Not(A[rr][cc]), Br[rr][cc] == Br[r][c]-1) for rr,cc in bn])))\n    if s.check()\"'!=z3.sat:\n        return None\n    m=s.model()\n    return ['\"''.join('A' if m.evaluate(A[r][c]) else 'B' for c in range(w)) for r in range(h)]\n\nfor dims in [(3,5),(4,5),(5,5),(5,6),(6,6),(6,7)]:\n    sol=find(*dims)\n    print(dims, bool(sol))\n    if sol:\n        print('\\\\n'.join(sol))\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport z3\n\ndef find(h,w,ms=2000):\n    s=z3.Solver(); s.set(timeout=ms)\n    A=[[z3.Bool(f'a_{r}_{c}') for c in range(w)] for r in range(h)]\n    rank=[[z3.Int(f'r_{r}_{c}') for c in range(w)] for r in range(h)]\n    brank=[[z3.Int(f'b_{r}_{c}') for c in range(w)] for r in range(h)]\n    cells=[(r,c) for r in range(h) for c in range(w)]\n    # Fix roots to reduce symmetry\n    s.add(A[0][0])\n    s.add(z3.Not(A[h-1][w-1]))\n    for conds in [A, [[z3.Not(A[r][c]) for c in range(w)] for r in range(h)]]:\n        s.add(z3.Or([conds[0][c] for c in range(w)]))\n        s.add(z3.Or([conds[h-1][c] for c in range(w)]))\n        s.add(z3.Or([conds[r][0] for r in range(h)]))\n        s.add(z3.Or([conds[r][w-1] for r in range(h)]))\n    for r,c in cells:\n        s.add(z3.Implies(A[r][c], z3.And(rank[r][c]>=0, rank[r][c]<h*w)))\n        s.add(z3.Implies(z3.Not(A[r][c]), rank[r][c]==-1))\n        s.add(z3.Implies(z3.Not(A[r][c]), z3.And(brank[r][c]>=0, brank[r][c]<h*w)))\n        s.add(z3.Implies(A[r][c], brank[r][c]==-1))\n    s.add(rank[0][0]==0)\n    s.add(brank[h-1][w-1]==0)\n    for r,c in cells:\n        neigh=[(rr,cc) for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)) if 0<=(rr:=r+dr)<h and 0<=(cc:=c+dc)<w]\n        if (r,c)\"'!=(0,0):\n            s.add(z3.Implies(A[r][c], z3.Or([z3.And(A[rr][cc], rank[rr][cc]==rank[r][c]-1) for rr,cc in neigh])))\n        if (r,c)!=(h-1,w-1):\n            s.add(z3.Implies(z3.Not(A[r][c]), z3.Or([z3.And(z3.Not(A[rr][cc]), brank[rr][cc]==brank[r][c]-1) for rr,cc in neigh])))\n    res=s.check()\n    print('\"'status',res)\n    if res\"'!=z3.sat: return None\n    m=s.model()\n    return ['\"''.join('A' if z3.is_true(m.evaluate(A[r][c])) else 'B' for c in range(w)) for r in range(h)]\n\nfor dims in [(3,5),(4,5),(5,5)]:\n    print('dims',dims)\n    sol=find(*dims)\n    if sol: print('\\\\n'.join(sol))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
