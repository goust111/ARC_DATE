{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nfrom collections import deque\n\ndef comps(mask):\n    h,w=mask.shape\n    seen=np.zeros_like(mask,bool)\n    out=[]\n    for r in range(h):\n        for c in range(w):\n            if not mask[r,c] or seen[r,c]:\n                continue\n            q=deque([(r,c)]); seen[r,c]=True; cur=[]\n            while q:\n                x,y=q.popleft(); cur.append((x,y))\n                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\n                    nx,ny=x+dx,y+dy\n                    if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:\n                        seen[nx,ny]=True; q.append((nx,ny))\n            out.append(cur)\n    return out\n\ndef rect(h,w):\n    m=np.zeros((h,w),bool)\n    m[0,:]=m[-1,:]=m[:,0]=m[:,-1]=True\n    segs=[[(0,c) for c in range(w)],[(h-1,c) for c in range(w)],[(r,0) for r in range(h)],[(r,w-1) for r in range(h)]]\n    corners=[(0,0),(0,w-1),(h-1,0),(h-1,w-1)]\n    return m,segs,corners\n\ndef notch(h,w,cut_row,depth):\n    inner=w-1-depth\n    m=np.zeros((h,w),bool)\n    m[0,:]=True\n    m[:,0]=True\n    m[:cut_row+1,-1]=True\n    m[cut_row,inner:]=True\n    m[cut_row:,inner]=True\n    m[-1,:inner+1]=True\n    segs=[[(0,c) for c in range(w)],[(r,w-1) for r in range(cut_row+1)],[(cut_row,c) for c in range(inner,w)],[(r,inner) for r in range(cut_row,h)],[(h-1,c) for c in range(inner+1)],[(r,0) for r in range(h)]]\n    corners=[(0,0),(0,w-1),(cut_row,w-1),(cut_row,inner),(h-1,inner),(h-1,0)]\n    return m,segs,corners\n\ndef hint_cands(mask):\n    h,w=mask.shape\n    out=[]\n    for r in range(h):\n        for c in range(w):\n            if mask[r,c]:\n                continue\n            ok=True\n            for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\n                nx,ny=r+dx,c+dy\n                if 0<=nx<h and 0<=ny<w and mask[nx,ny]:\n                    ok=False\n                    break\n            if ok:\n                out.append((r,c))\n    return out\n\nfor name, maker in [('rect', lambda: rect(5,5)), ('notch', lambda: notch(6,6,2,2))]:\n    m,segs,corners=maker()\n    print(name, 'full comps', len(comps(m)), 'hints', len(hint_cands(m)))\n    for seg in segs:\n        p=m.copy()\n        for r,c in seg: p[r,c]=False\n        print(' side', len(seg), 'comps', len(comps(p)), 'count', p.sum(), 'hints', len(hint_cands(p)))\n    for cell in corners:\n        p=m.copy(); p[cell]=False\n        print(' corner', cell, 'comps', len(comps(p)), 'count', p.sum(), 'hints', len(hint_cands(p)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
