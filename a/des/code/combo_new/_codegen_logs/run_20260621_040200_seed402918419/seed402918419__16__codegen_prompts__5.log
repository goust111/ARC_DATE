{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/136b0064.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/def generate_input(/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/eval/136b0064.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/136b0064.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/def generate_input(/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/eval/136b0064.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Draw a polyline by decoding 3x3 glyph instructions read across a divided grid.\n\n    Input structure:\n    - Left of a full-height vertical divider: 3x3 colored glyphs on bg.\n    - Right of divider: a single gray (5) start pixel.\n\n    Rule:\n    - Remove the divider; shift the gray start into the left canvas.\n    - Read glyphs in column-major order (left→right, top→bottom).\n    - Each glyph's shape (pixel area) encodes a segment: area 4 → down 2, area 5 → right 3, area 6 → left 4, area 7 → left 2.\n    - Append segments sequentially, stepping down one cell between each.\n\n    Key insight: Glyph pixel count (area) uniquely determines both segment length and direction — the shape itself is the instruction.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # Divider is a full-height constant non-bg column.\n    div_c, div_color = find_full_height_constant_col(g, bg=bg)\n    assert div_c is not None\n\n    out = np.zeros((H, int(div_c)), dtype=int)\n\n    # Move gray start from right side into left canvas (remove divider col too).\n    gray = np.argwhere(g == 5)\n    if gray.size == 0:\n        return out\n    r_cur, c_cur = map(int, gray[0])\n    c_cur = int(c_cur - (int(div_c) + 1))\n    if not (0 <= c_cur < int(div_c)):\n        return out\n    out[int(r_cur), int(c_cur)] = 5\n\n    # Collect 3x3 glyph components on the left.\n    left = g[:, : int(div_c)]\n    ignore = {int(bg), 5}\n    if div_color is not None:\n        ignore.add(int(div_color))\n\n    glyphs: list[dict[str, int]] = []\n    for comp in find_components(left, bg=bg, connectivity=8, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        if col in ignore:\n            continue\n        b = comp[\"bbox\"]\n        if bbox_h(b) == 3 and bbox_w(b) == 3:\n            r0, c0, _r1, _c1 = map(int, b)\n            glyphs.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"area\": int(comp[\"area\"])})\n\n    glyphs.sort(key=lambda d: (int(d[\"c0\"]), int(d[\"r0\"])))\n\n    area_to_len = {4: 2, 5: 3, 6: 4, 7: 2}\n    area_to_dir = {5: 1, 6: -1, 7: -1}  # diamond right; cross/U left\n\n    for glyph in glyphs:\n        color = int(glyph[\"color\"])\n        area = int(glyph[\"area\"])\n        seg_len = int(area_to_len.get(area, 2))\n\n        r_cur = int(r_cur + 1)\n        assert r_cur < H, f\"segment exits bottom: r_cur={r_cur}, H={H}\"\n        out[r_cur, int(c_cur)] = color\n\n        if area == 4:  # vertical (down)\n            end_r = r_cur + (seg_len - 1)\n            assert end_r < H, f\"vertical segment exits bottom: end_r={end_r}, H={H}\"\n            for _ in range(seg_len - 1):\n                r_cur = int(r_cur + 1)\n                out[r_cur, int(c_cur)] = color\n        else:  # horizontal\n            dir_h = int(area_to_dir.get(area, 1))\n            end_c = int(c_cur) + dir_h * (seg_len - 1)\n            assert 0 <= end_c < int(div_c), (\n                f\"horizontal segment exits canvas: c_cur={c_cur}, dir={dir_h}, \"\n                f\"seg_len={seg_len}, div_c={div_c}\"\n            )\n            for _ in range(seg_len - 1):\n                c_cur = int(c_cur + dir_h)\n                out[r_cur, c_cur] = color\n\n    return out\n\n# --------------- generator (attempt 1 (Claude)) ---------------\n\n# --- canvas geometry ---\nN_MIN, N_MAX = 2, 5            # number of tile rows; H = 4*N - 1, num_glyphs = 2*N\nGRID_W = 15                    # full input width\nDIVIDER_COL = 7                # divider position (col), full-height\nDIVIDER_COLOR = 4              # divider fill color\nLEFT_W = 7                     # left canvas width (cols 0..6)\nTILE_COLS = (0, 4)             # 3x3 tile c0 positions on the left\nTILE_ROW_STRIDE = 4            # row spacing between successive tile slots\nGRAY = 5                       # start-pixel color\nGRAY_START_ROW = 0             # gray start always sits at row 0 [observed]\n\n# --- shape grammar (area -> 3x3 template, color, and (dr, dc) walk delta) ---\n# Walk delta = total (row, col) displacement caused by one glyph instruction:\n#   step down 1 then segment of (len, dir). E.g. area 4 (vertical len 2) => (+2, 0).\n_TEMPLATES = {\n    4: np.array([[1, 0, 1], [0, 1, 0], [0, 1, 0]], dtype=int),  # plus    -> down 2,  color 6\n    5: np.array([[1, 1, 0], [1, 0, 1], [0, 1, 0]], dtype=int),  # diamond -> right 3, color 1\n    6: np.array([[1, 1, 1], [0, 1, 0], [1, 0, 1]], dtype=int),  # cross   -> left 4,  color 3\n    7: np.array([[1, 0, 1], [1, 0, 1], [1, 1, 1]], dtype=int),  # U       -> left 2,  color 2\n}\n_AREA_TO_COLOR = {4: 6, 5: 1, 6: 3, 7: 2}\n_AREA_DELTA = {4: (2, 0), 5: (1, 2), 6: (1, -3), 7: (1, -1)}\n_AREAS = (4, 5, 6, 7)\n\n# --- generation constraints ---\nMIN_DIRECTION_CHANGES = 2      # min vertical<->horizontal flips across the walk\nMAX_ATTEMPTS = 300             # outer retry budget\n\n\n\n---GEN---\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        try:\n            inp = _gen_attempt()\n            if inp is None:\n                continue\n            out = main(inp)  # oracle check\n            if out.shape != (inp.shape[0], LEFT_W):\n                continue\n            return inp\n        except Exception:\n            continue\n    raise RuntimeError(f\"generate_input: failed after {MAX_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/def generate_input(/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/def generate_input(/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n\n---GEN---\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exhausted attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/7666fa5d.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/def generate_input(/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/eval/7666fa5d.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/7666fa5d.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/def generate_input(/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/eval/7666fa5d.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the parallelogram-shaped region between parallel anti-diagonal line segments with red.\n\n    Input structure:\n    - bg = most common color.\n    - One non-bg color forms short diagonal segments, each lying on a single anti-diagonal (r+c = const).\n    - Segments come in parallel pairs bounding a region to be filled.\n\n    Rule:\n    - For each main-diagonal axis (r−c = const), collect anti-diagonal segments whose span covers that axis.\n    - Sort those segments by their anti-diagonal index (r+c).\n    - Fill all bg cells lying strictly between consecutive segment pairs along that axis with red (color 2).\n\n    Key insight: The two diagonal directions decouple — segments sit on anti-diagonals, and filling sweeps along main diagonals between them, forming parallelogram regions.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    bg = _bg_color(g)\n    non_bg = [c for c in sorted(set(map(int, g.ravel()))) if c != bg]\n    assert non_bg, \"grid must contain at least one non-background color\"\n\n    # This task uses one diagonal-line color and fills with 2.\n    line = max(non_bg, key=lambda c: int(np.sum(g == c)))\n    fill = 2\n\n    comps = _cc8(g == line)\n\n    # Each diagonal segment is on a constant anti-diagonal sum k=r+c,\n    # and spans a continuous range of main-diagonal indices b=r-c.\n    segs: list[tuple[int, int, int]] = []\n    for pts in comps:\n        ks = {r + c for r, c in pts}\n        if len(ks) != 1:\n            continue\n        k = int(next(iter(ks)))\n        bs = [r - c for r, c in pts]\n        segs.append((k, int(min(bs)), int(max(bs))))\n\n    out = g.copy()\n\n    # Scan each main diagonal b=r-c. For every b, find the active diagonal segments\n    # (those whose b-range covers b), sort them by k=r+c, then fill between adjacent\n    # segments for cells on this b with k strictly between.\n    for b in range(-(w - 1), h):\n        active = [s for s in segs if s[1] <= b <= s[2]]\n        if len(active) < 2:\n            continue\n        active.sort(key=lambda t: t[0])\n        ks = [t[0] for t in active]\n\n        r_min = max(0, b)\n        r_max = min(h - 1, (w - 1) + b)\n        for k_left, k_right in zip(ks, ks[1:]):\n            for r in range(r_min, r_max + 1):\n                c = r - b\n                k = r + c\n                if k_left < k < k_right and out[r, c] == bg:\n                    out[r, c] = fill\n\n    return out\n\n# --------------- generator (Claude attempt 1) ---------------\n\n\"\"\"Generator for ARC-AGI-2 task 7666fa5d (parallelogram fill between anti-diagonal segments).\"\"\"\n\n# -- Grid & color constants --\nH = W = 16\nBG = 8\nFILL = 2\nLINE_COLORS = [1, 3, 4, 5, 6, 7, 9]  # not 2 (fill), not 8 (bg)\n\n# -- Anti-diagonal (k = r+c) layout --\nK_LO, K_HI = 4, 26                    # allowed k range\nGAP_VALUES = (4, 6, 8)                 # even gaps between consecutive k-values\nGAP_TARGET_SPANS = (14, 16)            # valid total k-span for 4-k layouts\nNUM_KS_CHOICES = [4, 5]                # number of anti-diagonals to use\nNUM_KS_WEIGHTS = [1, 1]                # sampling weights for num_ks\n\n# -- Segment geometry --\nSEG_LEN_MIN, SEG_LEN_MAX = 2, 9       # segment length in cells\nOVERLAP_MIN_B = 2                      # min b-overlap between consecutive segments\n\n# -- Segment splitting --\nSPLIT_PROB = 0.4                       # probability of splitting one segment\nSPLIT_MIN_LEN = 4                      # min segment length (cells) to be splittable\nSPLIT_B_GAP = 4                        # min b-gap to break 8-connectivity\nSPLIT_PIECE2_LEN_MIN = 2              # second piece length range\nSPLIT_PIECE2_LEN_MAX = 6\n\n# -- Retry budgets --\nSEG_RETRY = 40                         # retries per segment placement\nSPLIT_RETRY = 10                       # retries for segment splitting\nGEN_RETRY = 300                        # outer generate_input retries\n\n# -- Validation --\nMIN_FILL_CELLS = 3                     # min fill cells in output\n\n\n\n---GEN---\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY):\n        res = _gen_attempt()\n        if res is not None:\n            return res\n    raise RuntimeError(\"Failed to generate input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/17829a00.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/def generate_input(/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/train/17829a00.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/17829a00.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/def generate_input(/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/train/17829a00.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each colored object vertically until it touches the matching top or bottom border bar.\n\n    Input structure:\n    - The background is the dominant color.\n    - The top row is a full-width bar in one foreground color and the bottom row is a full-width bar in another.\n    - All other foreground pixels are 8-connected monochrome objects whose color matches one of those bars.\n\n    Rule:\n    - Top-bar-colored objects move upward so their bbox top is row 1.\n    - Bottom-bar-colored objects move downward so their bbox bottom is the row above the bottom bar.\n    - A downward-moving one-column segment whose landing overlaps its source becomes the continuous vertical segment swept between them.\n\n    Key insight:\n    The horizontal bars are destination anchors: color determines which border an object slides toward, while columns and object shape are otherwise preserved.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h >= 3 and w >= 1\n\n    bg = int(get_bg(g))\n    top_color = int(g[0, 0])\n    bottom_color = int(g[h - 1, 0])\n\n    assert top_color != bg\n    assert bottom_color != bg\n    assert top_color != bottom_color\n    assert bool(np.all(g[0, :] == top_color))\n    assert bool(np.all(g[h - 1, :] == bottom_color))\n    assert set(map(int, np.unique(g))) == {bg, top_color, bottom_color}\n\n    for c in range(w):\n        top_rows = [r for r in range(1, h - 1) if int(g[r, c]) == top_color]\n        bot_rows = [r for r in range(1, h - 1) if int(g[r, c]) == bottom_color]\n        if top_rows and bot_rows:\n            assert max(top_rows) < min(bot_rows), \"top-color objects must be above bottom-color objects in every column\"\n\n    out = np.full_like(g, bg)\n    out[0, :] = top_color\n    out[h - 1, :] = bottom_color\n\n    for color, target_side in ((top_color, \"top\"), (bottom_color, \"bottom\")):\n        components = find_components(\n            g,\n            bg=bg,\n            connectivity=8,\n            monochromatic=True,\n            colors=[color],\n            return_format=\"dict\",\n        )\n        for comp in components:\n            if _is_full_width_border(comp, h, w):\n                continue\n\n            coords = np.asarray(comp[\"coords\"], dtype=int)\n            r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n            assert 0 < r0 <= r1 < h - 1\n\n            if target_side == \"top\":\n                dr = 1 - r0\n                assert dr <= 0\n                paint = coords + np.array([dr, 0], dtype=int)\n            else:\n                dr = (h - 2) - r1\n                assert dr >= 0\n                paint = coords + np.array([dr, 0], dtype=int)\n                if dr > 0 and r0 + dr <= r1:\n                    assert c0 == c1\n                    rows = np.arange(r0, r1 + dr + 1, dtype=int)\n                    paint = np.column_stack([rows, np.full(rows.shape, c0, dtype=int)])\n\n            assert bool(np.all((0 <= paint[:, 0]) & (paint[:, 0] < h)))\n            assert bool(np.all((0 <= paint[:, 1]) & (paint[:, 1] < w)))\n            assert bool(np.all(out[paint[:, 0], paint[:, 1]] == bg))\n            out[paint[:, 0], paint[:, 1]] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom scipy.ndimage import binary_dilation\n\n# -- Grid constants --\nBG = 7\nH = 16\nW = 16\n\n# -- Sprite geometry --\nSPRITE_AREA_MIN = 1\nSPRITE_AREA_MAX = 6\nSPRITE_H_MAX = 4       # bbox height upper bound (exclusive in range)\nSPRITE_W_MAX = 5       # bbox width upper bound (exclusive in range)\nSPRITE_DENSITY_MIN = 0.33  # min fill ratio inside bbox\n\n# -- Object counts per side --\nOBJ_COUNT_MIN = 3      # per color\nOBJ_COUNT_MAX = 5      # per color (inclusive)\nOBJ_TOTAL_MAX = 9      # top_count + bottom_count\n\n# -- Swept segment (single-column overlap case) --\nSWEPT_PROB = 0.15       # probability of including one swept-segment object\nSWEPT_H_MIN = 2        # min input height for swept column\nSWEPT_H_MAX = 4        # max input height (inclusive)\nSWEPT_TOTAL_MAX = 5    # input_h + offset ceiling\n\n# -- Input derivation --\nSLIDE_OFFSET_MAX = 10  # exclusive upper bound for slide offsets (range(1, N))\n\n# -- Retry budgets --\nPLACE_RETRIES = 60     # sprite placement attempts per object\nGEN_RETRIES = 300      # outer generation attempts\n\n\n\n---GEN---\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 17829a00 input\")\n","exit_code":0,"status":"completed"}}
