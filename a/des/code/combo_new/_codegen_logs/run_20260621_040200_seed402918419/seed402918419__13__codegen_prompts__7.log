{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nimport numpy as np\nBG=0\nORTH=((1,0),(-1,0),(0,1),(0,-1))\nDIAG=((1,1),(1,-1),(-1,1),(-1,-1))\n\ndef sim(h=12,w=12,os=[(3,3)],ds=[(8,8)],legend=[(0,0),(0,1)],oc=2,dc=3,bc=4):\n    g=np.zeros((h,w),int)\n    for r,c in os:g[r,c]=oc\n    for r,c in ds:g[r,c]=dc\n    g[legend[0]]=oc\n    g[legend[1]]=bc\n    frozen=set(legend)\n    stats={'same':0,'occ':0}\n    while True:\n        opos=[tuple(x) for x in np.argwhere(g==oc) if tuple(x) not in frozen]\n        dpos=[tuple(x) for x in np.argwhere(g==dc)]\n        ocm=set()\n        dcm=set()\n        for r,c in opos:\n            for dr,dc2 in ORTH:\n                nr,nc=r+dr,c+dc2\n                if 0<=nr<h and 0<=nc<w and (nr,nc) not in frozen:\n                    v=g[nr,nc]\n                    if v\"'!=oc and v!=bc:\n                        ocm.add((nr,nc))\n        for r,c in dpos:\n            for dr,dc2 in DIAG:\n                nr,nc=r+dr,c+dc2\n                if 0<=nr<h and 0<=nc<w and (nr,nc) not in frozen:\n                    v=g[nr,nc]\n                    if v!=dc and v!=bc:\n                        dcm.add((nr,nc))\n        if not ocm and not dcm: break\n        upd={}\n        both=ocm&dcm\n        for cell in both:\n            if g[cell]==BG: stats['\"'same']+=1\n            else: stats['occ']+=1\n            upd[cell]=bc\n        for cell in ocm-both:\n            v=g[cell]\n            if v==BG: upd[cell]=oc\n            elif v==dc: upd[cell]=bc; stats['occ']+=1\n        for cell in dcm-both:\n            v=g[cell]\n            if v==BG: upd[cell]=dc\n            elif v==oc: upd[cell]=bc; stats['occ']+=1\n        if not upd: break\n        for cell,val in upd.items(): g[cell]=val\n    return g,stats\n\n# hand samples\nfor os,ds in [([(3,3)],[(8,8)]), ([(5,3)],[(5,7)]), ([(2,8)],[(8,2)]), ([(5,5)],[(6,8)])]:\n    g,s=sim(os=os,ds=ds)\n    print(os,ds,s,'black',int((g==0).sum()))\n    print(g)\n    print()\n\n# random stats\nrng=random.Random(0)\ncounts={'same':0,'occ':0,'both':0,'blackleft':0}\nfor _ in range(200):\n    h=w=12\n    g=np.zeros((h,w),int)\n    oc,dc,bc=2,3,4\n    g[0,0]=oc; g[0,1]=bc\n    pos=[]\n    while len(pos)<4:\n        r=rng.randrange(2,h-2)\n        c=rng.randrange(2,w-2)\n        if all(max(abs(r-r0),abs(c-c0))>=2 for r0,c0 in pos):\n            pos.append((r,c))\n    os=pos[:2]; ds=pos[2:]\n    out,s=sim(h,w,os,ds,[(0,0),(0,1)],oc,dc,bc)\n    if s['same']>0: counts['same']+=1\n    if s['occ']>0: counts['occ']+=1\n    if s['same']>0 and s['occ']>0: counts['both']+=1\n    if (out==0).sum()>0: counts['blackleft']+=1\nprint(counts)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
