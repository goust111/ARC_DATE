{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"for f in /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py /home/lixinyu/snap/new/ARC_code/train/8a6d367c.py /home/lixinyu/snap/new/ARC_code/eval/21897d95.py /home/lixinyu/snap/new/ARC_code/eval/a25697e4.py; do printf 'FILE %s\\\\n' \\\"\"'$f\"; awk '\"'BEGIN{m=0;g=0} /\"'^def main'\"\\\\(/{m=1} m{print} m && /\"'^def generate_input'\"\\\\(/{m=0} /\"'^def generate_input'\"\\\\(/{g=1} g{print} g && /\"'^if __name__ == .__main__.:/{g=0}'\"' \\\"\"'$f\"; printf '\"'\\\\n'; done\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"for f in /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py /home/lixinyu/snap/new/ARC_code/train/8a6d367c.py /home/lixinyu/snap/new/ARC_code/eval/21897d95.py /home/lixinyu/snap/new/ARC_code/eval/a25697e4.py; do printf 'FILE %s\\\\n' \\\"\"'$f\"; awk '\"'BEGIN{m=0;g=0} /\"'^def main'\"\\\\(/{m=1} m{print} m && /\"'^def generate_input'\"\\\\(/{m=0} /\"'^def generate_input'\"\\\\(/{g=1} g{print} g && /\"'^if __name__ == .__main__.:/{g=0}'\"' \\\"\"'$f\"; printf '\"'\\\\n'; done\"","aggregated_output":"FILE /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n    h, w = canvas_mask.shape\n    sr, sc = seed\n    if not canvas_mask[sr, sc]:\n        return None\n    blob = {(sr, sc)}\n    frontier = []\n    def push_neighbors(r, c):\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:\n                frontier.append((nr, nc))\n    push_neighbors(sr, sc)\n    while len(blob) < target_size and frontier:\n        idx = rng.randrange(len(frontier))\n        r, c = frontier.pop(idx)\n        if (r, c) in blob or not canvas_mask[r, c]:\n            continue\n        blob.add((r, c))\n        push_neighbors(r, c)\n    if len(blob) < target_size:\n        return None\n    return blob\n\n\ndef _blob_wall_cells(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n    wall = set()\n    for r, c in blob:\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in blob:\n                wall.add((nr, nc))\n    return wall\n\n\ndef _fill_holes(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Return blob with interior holes absorbed.\n\n    Barrier = blob union its wall ring. Any non-barrier cell unreachable from the grid\n    border through non-barrier cells is trapped and gets absorbed into the blob.\n    \"\"\"\n    walls = _blob_wall_cells(blob, h, w)\n    barrier = np.zeros((h, w), dtype=bool)\n    for r, c in blob:\n        barrier[r, c] = True\n    for r, c in walls:\n        barrier[r, c] = True\n\n    # Flood-fill from border through non-barrier cells.\n    reachable = np.zeros((h, w), dtype=bool)\n    stack = []\n    for r in range(h):\n        for c in (0, w - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    for c in range(w):\n        for r in (0, h - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    while stack:\n        r, c = stack.pop()\n        if reachable[r, c] or barrier[r, c]:\n            continue\n        reachable[r, c] = True\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and not reachable[nr, nc] and not barrier[nr, nc]:\n                stack.append((nr, nc))\n\n    trapped = (~reachable) & (~barrier)\n    if not trapped.any():\n        return blob\n    filled = set(blob)\n    for r, c in np.argwhere(trapped):\n        filled.add((int(r), int(c)))\n    return filled\n\n\n# ── Slide helpers ─────────────────────────────────────────────────\n\ndef _slide_step_valid(region_set: set, r: int, c: int, dr: int, dc: int) -> bool:\n    nr, nc = r + dr, c + dc\n    if (nr, nc) not in region_set:\n        return False\n    if dr != 0 and dc != 0:\n        if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n            return False\n    return True\n\n\ndef _forward_slide(region_set: set, start: tuple[int, int], dr: int, dc: int,\n                   blocked: set) -> tuple[int, int]:\n    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n    r, c = start\n    while True:\n        if not _slide_step_valid(region_set, r, c, dr, dc):\n            break\n        nr, nc = r + dr, c + dc\n        if (nr, nc) in blocked:\n            break\n        r, c = nr, nc\n    return (r, c)\n\n\n# ── Generator phases ─────────────────────────────────────────────\n\ndef _place_legends(rng: random.Random, grid: np.ndarray,\n                   ) -> tuple[np.ndarray, list[tuple[int, tuple[int,int]]]]:\n    \"\"\"Place 1-2 legend patches at grid corners.\n\n    Returns (legend_occupied mask, list of (wall_color, direction) pairs).\n    \"\"\"\n    h, w = grid.shape\n    n_legends = rng.choice([1, 2])\n    corners = rng.sample(CORNERS, n_legends)\n    wall_colors = rng.sample(WALL_COLOR_CHOICES, n_legends)\n\n    legend_occupied = np.zeros((h, w), dtype=bool)\n    legends = []\n\n    for corner, wc in zip(corners, wall_colors):\n        if rng.random() < CARDINAL_PROB:\n            dr, dc = rng.choice(CARDINAL_DIRS)\n            patch = _legend_5x5(wc, dr, dc)\n        else:\n            dr, dc = rng.choice(DIAGONAL_DIRS)\n            patch = _legend_6x7(wc, dr, dc)\n        ph, pw = patch.shape\n        r0, c0 = _corner_origin(corner, h, w, ph, pw)\n        paste(grid, patch, r0, c0)\n        # Reserve legend cells + buffer.\n        r_lo, r_hi = max(0, r0 - LEGEND_BUFFER), min(h, r0 + ph + LEGEND_BUFFER)\n        c_lo, c_hi = max(0, c0 - LEGEND_BUFFER), min(w, c0 + pw + LEGEND_BUFFER)\n        legend_occupied[r_lo:r_hi, c_lo:c_hi] = True\n        legends.append((wc, (dr, dc)))\n\n    return legend_occupied, legends\n\n\ndef _grow_regions(rng: random.Random, legends: list[tuple[int, tuple[int,int]]],\n                  legend_occupied: np.ndarray,\n                  ) -> list[dict] | None:\n    \"\"\"Grow irregular closed regions, one per assigned wall color.\n\n    Returns list of region dicts or None on failure.\n    \"\"\"\n    h, w = legend_occupied.shape\n    color_dir = {wc: d for wc, d in legends}\n    all_colors = [wc for wc, _ in legends]\n\n    # Assign 1-3 regions per wall color, cap total.\n    region_colors = []\n    for c in all_colors:\n        region_colors.extend([c] * rng.randint(*REGIONS_PER_COLOR))\n    if len(region_colors) > MAX_TOTAL_REGIONS:\n        region_colors = rng.sample(region_colors, MAX_TOTAL_REGIONS)\n    rng.shuffle(region_colors)\n\n    size_min, size_max = REGION_SIZE_BOUNDS[len(region_colors)]\n    occupied = legend_occupied.copy()\n    regions = []\n\n    for rc in region_colors:\n        dr, dc = color_dir[rc]\n        target_size = rng.randint(size_min, size_max)\n\n        # Build canvas: interior cells (not border) that are unoccupied.\n        canvas = np.ones((h, w), dtype=bool)\n        canvas[0, :] = False; canvas[-1, :] = False\n        canvas[:, 0] = False; canvas[:, -1] = False\n        canvas &= ~occupied\n        if not canvas.any():\n            continue\n\n        blob = _try_grow_valid_blob(rng, canvas, occupied, target_size, h, w)\n        if blob is None:\n            continue\n\n        walls = _blob_wall_cells(blob, h, w)\n        regions.append({'color': rc, 'dir': (dr, dc), 'interior': blob, 'walls': walls})\n\n        # Reserve blob + walls + 1-cell buffer around walls.\n        reserve = blob | walls\n        extra = set()\n        for r, c in walls:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in reserve:\n                    extra.add((nr, nc))\n        for r, c in reserve | extra:\n            occupied[r, c] = True\n\n    if not regions:\n        return None\n    # Every legend color must have at least one region.\n    if {reg['color'] for reg in regions} != set(all_colors):\n        return None\n    return regions\n\n\ndef _try_grow_valid_blob(rng: random.Random, canvas: np.ndarray,\n                         occupied: np.ndarray, target_size: int,\n                         h: int, w: int) -> set[tuple[int,int]] | None:\n    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n    for _ in range(BLOB_GROW_RETRIES):\n        free = np.argwhere(canvas)\n        if len(free) == 0:\n            break\n        sr, sc = free[rng.randrange(len(free))]\n        cand = _grow_blob(canvas, (int(sr), int(sc)), target_size, rng)\n        if cand is None:\n            continue\n        # Fill interior holes until stable.\n        while True:\n            filled = _fill_holes(cand, h, w)\n            if filled == cand:\n                break\n            cand = filled\n        # Absorbed cells must stay within canvas.\n        if any(not canvas[r, c] for r, c in cand):\n            continue\n        walls = _blob_wall_cells(cand, h, w)\n        # Walls must not overlap occupied cells or the grid border.\n        if any(occupied[wr, wc] or wr in (0, h - 1) or wc in (0, w - 1)\n               for wr, wc in walls):\n            continue\n        return cand\n    return None\n\n\ndef _validate_topology(grid: np.ndarray, regions: list[dict]) -> bool:\n    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n    h, w = grid.shape\n    labeled, n_comp = label_mask(grid == 0, connectivity=4)\n    bounded = []\n    for comp_id in range(1, n_comp + 1):\n        coords = np.argwhere(labeled == comp_id)\n        if any(r in (0, h - 1) or c in (0, w - 1) for r, c in coords):\n            continue\n        bounded.append({(int(r), int(c)) for r, c in coords})\n    region_sets = [reg['interior'] for reg in regions]\n    if len(bounded) != len(region_sets):\n        return False\n    return all(comp in region_sets for comp in bounded)\n\n\ndef _place_yellows(rng: random.Random, regions: list[dict],\n                   grid: np.ndarray) -> bool:\n    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n\n    Modifies grid in-place by painting yellow(4) at input positions.\n    Returns True on success.\n    \"\"\"\n    for reg in regions:\n        blob = reg['interior']\n        dr, dc = reg['dir']\n        n_yellows = rng.choice(YELLOWS_PER_REGION)\n\n        # Cells sorted by projection onto slide direction (farthest first).\n        cells_sorted = sorted(blob, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n        far_key = dr * cells_sorted[0][0] + dc * cells_sorted[0][1]\n        tier1 = [p for p in cells_sorted if dr * p[0] + dc * p[1] == far_key]\n\n        # Pick output positions: first at the farthest tier, second one step behind or at tier1.\n        first = tier1[rng.randrange(len(tier1))]\n        output_positions = [first]\n\n        if n_yellows == 2:\n            pr, pc = first[0] - dr, first[1] - dc\n            cands = ([(pr, pc)] if (pr, pc) in blob else []) + [p for p in tier1 if p != first]\n            if cands:\n                second = cands[rng.randrange(len(cands))]\n                if second != first:\n                    output_positions.append(second)\n\n        # Reverse-slide: process in solver order (far-to-near).\n        out_sorted = sorted(output_positions, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n        already_stopped = set()\n        yellows_input = []\n\n        for out_pos in out_sorted:\n            candidate = _find_reverse_slide(blob, out_pos, dr, dc, already_stopped,\n                                            yellows_input, rng)\n            if candidate is None:\n                return False\n            yellows_input.append(candidate)\n            already_stopped.add(out_pos)\n\n        for r, c in yellows_input:\n            grid[r, c] = 4\n    return True\n\n\ndef _find_reverse_slide(blob: set, out_pos: tuple[int,int], dr: int, dc: int,\n                        already_stopped: set, existing_inputs: list,\n                        rng: random.Random) -> tuple[int,int] | None:\n    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n    target_steps = rng.randint(1, MAX_SLIDE_STEPS)\n    for steps in range(target_steps, 0, -1):\n        r, c = out_pos\n        path_ok = True\n        for _ in range(steps):\n            pr, pc = r - dr, c - dc\n            if (pr, pc) not in blob or (pr, pc) in already_stopped or (pr, pc) in existing_inputs:\n                path_ok = False\n                break\n            if dr != 0 and dc != 0:\n                if (pr + dr, pc) not in blob or (pr, pc + dc) not in blob:\n                    path_ok = False\n                    break\n            r, c = pr, pc\n        if not path_ok:\n            continue\n        if _forward_slide(blob, (r, c), dr, dc, already_stopped) == out_pos:\n            return (r, c)\n    return None\n\n\ndef _oracle_check(input_grid: np.ndarray, regions: list[dict]) -> bool:\n    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n    h, w = input_grid.shape\n    try:\n        solver_out = main(input_grid)\n    except Exception:\n        return False\n    # Non-yellow, non-bg cells must be identical.\n    struct_mask = (input_grid != 4) & (input_grid != 0)\n    if not np.array_equal(solver_out[struct_mask], input_grid[struct_mask]):\n        return False\n    # Yellow count must be preserved.\n    if (solver_out == 4).sum() != (input_grid == 4).sum():\n        return False\n    # All output yellows must lie inside known region interiors.\n    regions_mask = np.zeros((h, w), dtype=bool)\n    for reg in regions:\n        for r, c in reg['interior']:\n            regions_mask[r, c] = True\n    return bool(np.all(regions_mask[solver_out == 4]))\n\n\n# ── Main generator ────────────────────────────────────────────────\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    h, w = GRID_H, GRID_W\n    grid = np.zeros((h, w), dtype=int)\n\n    legend_occupied, legends = _place_legends(rng, grid)\n    regions = _grow_regions(rng, legends, legend_occupied)\n    if regions is None:\n        return None\n\n    # Paint walls.\n    for reg in regions:\n        for r, c in reg['walls']:\n            grid[r, c] = reg['color']\n\n    if not _validate_topology(grid, regions):\n        return None\n\n    input_grid = grid.copy()\n    if not _place_yellows(rng, regions, input_grid):\n        return None\n    if not _oracle_check(input_grid, regions):\n        return None\n    return input_grid\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\n\nFILE /home/lixinyu/snap/new/ARC_code/train/8a6d367c.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the framed area by expanding the unique upper template that contains the existing seed pixels.\n\n    Input structure:\n    - A teal background contains small colored template masks above a larger rectangular frame.\n    - The frame encloses one fill color arranged as a partial block-scaled copy of one template.\n    - The frame interior dimensions are an integer square scale of the matching template bbox.\n\n    Rule:\n    - Crop to the rectangular frame.\n    - Identify the unique upper template whose block-scaled mask covers every existing fill pixel inside the frame.\n    - Reset the frame interior to background and paint the whole scaled mask with the fill color.\n\n    Key insight:\n    The lower colored pixels are seed cells that reveal which upper template should be completed inside the frame.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    frame_color, (r0, c0, r1, c1) = _find_frame(g, bg)\n\n    out = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n    interior = out[1:-1, 1:-1]\n    fill_colors = set(map(int, np.unique(interior))) - {bg, frame_color}\n    assert len(fill_colors) == 1, \"frame interior must contain exactly one fill color\"\n    fill_color = fill_colors.pop()\n\n    seed = interior == fill_color\n    assert np.any(seed), \"frame must contain seed pixels\"\n    ih, iw = seed.shape\n\n    matches: list[np.ndarray] = []\n    for template in _templates_above_frame(g, bg, r0):\n        th, tw = template.shape\n        if ih % th != 0 or iw % tw != 0:\n            continue\n        scale_h = ih // th\n        scale_w = iw // tw\n        if scale_h != scale_w:\n            continue\n\n        scaled = np.kron(template, np.ones((scale_h, scale_w), dtype=bool))\n        if np.all(~seed | scaled):\n            matches.append(scaled)\n\n    assert len(matches) == 1, \"seed pixels must select exactly one scaled template\"\n    completed = matches[0]\n    assert completed.shape == interior.shape\n\n    interior[:, :] = bg\n    interior[completed] = fill_color\n    return out\n\n# --------------- generator (att2) ---------------\n\nGEN_BG = 8\nGEN_GRID_SHAPE = (27, 21)\nGEN_TEMPLATE_SHAPES = [(3, 3), (3, 4), (4, 3)]\nGEN_TEMPLATE_COUNT_RANGE = (2, 6)\nGEN_TEMPLATE_ROW = 1\nGEN_TEMPLATE_LEFT_MIN = 1\nGEN_TEMPLATE_GAP = 1\nGEN_MAX_TEMPLATE_SPAN = 19\nGEN_DENSITY_MIN_NUM = 1\nGEN_DENSITY_MIN_DEN = 2\nGEN_DENSITY_MAX_NUM = 5\nGEN_DENSITY_MAX_DEN = 6\nGEN_SCALE_RANGE = (2, 5)\nGEN_SEED_COUNTS = (2, 3)\nGEN_SEED_FRACTION_RANGE = (0.20, 0.60)\nGEN_FRAME_ROW_GAP = 2\nGEN_FRAME_LEFT_MIN = 1\nGEN_ATTEMPTS = 300\nGEN_PALETTE = [0, 1, 2, 3, 4, 5, 6, 7, 9]\n\ndef _gen_has_full_bbox(mask: np.ndarray) -> bool:\n    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())\n\n\ndef _gen_valid_masks(th: int, tw: int) -> list[np.ndarray]:\n    n = int(th * tw)\n    lo = (GEN_DENSITY_MIN_NUM * n + GEN_DENSITY_MIN_DEN - 1) // GEN_DENSITY_MIN_DEN\n    hi = (GEN_DENSITY_MAX_NUM * n) // GEN_DENSITY_MAX_DEN\n    masks: list[np.ndarray] = []\n    for bits in range(1 << n):\n        count = int(bits.bit_count())\n        if count < lo or count > hi:\n            continue\n        flat = np.array([(bits >> k) & 1 for k in range(n)], dtype=bool)\n        mask = flat.reshape(th, tw)\n        if _gen_has_full_bbox(mask):\n            masks.append(mask)\n    return masks\n\n\ndef _gen_colored_patch(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\n    patch = np.full(mask.shape, bg, dtype=int)\n    patch[mask] = int(color)\n    return patch\n\n\ndef _gen_draw_frame(shape: tuple[int, int], bg: int, frame_color: int) -> np.ndarray:\n    patch = np.full(shape, bg, dtype=int)\n    patch[0, :] = frame_color\n    patch[-1, :] = frame_color\n    patch[:, 0] = frame_color\n    patch[:, -1] = frame_color\n    return patch\n\n\ndef _gen_frame_patch(\n    target_mask: np.ndarray,\n    seed_cells: np.ndarray,\n    scale: int,\n    bg: int,\n    frame_color: int,\n    fill_color: int,\n) -> tuple[np.ndarray, np.ndarray]:\n    th, tw = map(int, target_mask.shape)\n    scaled = np.kron(target_mask, np.ones((scale, scale), dtype=bool))\n    out = _gen_draw_frame((th * scale + 2, tw * scale + 2), bg, frame_color)\n    out[1:-1, 1:-1][scaled] = fill_color\n\n    frame = _gen_draw_frame(out.shape, bg, frame_color)\n    for r, c in seed_cells:\n        rr = int(r) * scale\n        cc = int(c) * scale\n        frame[1 + rr : 1 + rr + scale, 1 + cc : 1 + cc + scale] = fill_color\n    return frame, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n    bg = GEN_BG\n    count = int(rng.integers(*GEN_TEMPLATE_COUNT_RANGE))\n    shape_choices = [\n        shape for shape in GEN_TEMPLATE_SHAPES if count * shape[1] + count - 1 <= GEN_MAX_TEMPLATE_SPAN\n    ]\n    th, tw = shape_choices[int(rng.integers(0, len(shape_choices)))]\n    scale = int(rng.integers(*GEN_SCALE_RANGE))\n\n    valid_masks = _gen_valid_masks(th, tw)\n    if len(valid_masks) < count:\n        return None\n\n    target = valid_masks[int(rng.integers(0, len(valid_masks)))]\n    true_cells = np.argwhere(target)\n    target_area = int(len(true_cells))\n    min_seed_frac, max_seed_frac = GEN_SEED_FRACTION_RANGE\n    seed_counts = [k for k in GEN_SEED_COUNTS if min_seed_frac <= k / target_area <= max_seed_frac]\n    if not seed_counts:\n        return None\n    seed_count = int(seed_counts[int(rng.integers(0, len(seed_counts)))])\n    seed_idx = rng.choice(target_area, size=seed_count, replace=False)\n    seed_cells = true_cells[seed_idx]\n\n    covers_seed = np.array([bool(mask[seed_cells[:, 0], seed_cells[:, 1]].all()) for mask in valid_masks])\n    distractor_pool = [mask for mask, covers in zip(valid_masks, covers_seed) if not covers]\n    if len(distractor_pool) < count - 1:\n        return None\n    distractor_idx = rng.choice(len(distractor_pool), size=count - 1, replace=False)\n    distractors = [distractor_pool[int(i)] for i in distractor_idx]\n\n    masks = distractors + [target]\n    rng.shuffle(masks)\n\n    colors = list(GEN_PALETTE)\n    rng.shuffle(colors)\n    frame_color = int(colors[0])\n    fill_color = int(colors[1])\n    template_colors = [int(c) for c in colors[2 : 2 + count]]\n\n    frame, expected = _gen_frame_patch(target, seed_cells, scale, bg, frame_color, fill_color)\n    grid_h, grid_w = GEN_GRID_SHAPE\n    grid = np.full(GEN_GRID_SHAPE, bg, dtype=int)\n\n    total_template_w = count * tw + count - 1\n    template_c0 = int(rng.integers(GEN_TEMPLATE_LEFT_MIN, grid_w - total_template_w))\n    c = template_c0\n    for mask, color in zip(masks, template_colors):\n        paste(grid, _gen_colored_patch(mask, color, bg), GEN_TEMPLATE_ROW, c, transparent=bg)\n        c += tw + GEN_TEMPLATE_GAP\n\n    fh, fw = map(int, frame.shape)\n    min_r0 = th + GEN_FRAME_ROW_GAP\n    max_r0 = grid_h - fh\n    if min_r0 > max_r0:\n        return None\n    frame_r0 = int(rng.integers(min_r0, max_r0 + 1))\n    frame_c0 = int(rng.integers(GEN_FRAME_LEFT_MIN, grid_w - fw))\n    paste(grid, frame, frame_r0, frame_c0)\n\n    try:\n        if not np.array_equal(main(grid), expected):\n            return None\n    except Exception:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 8a6d367c input\")\n\nFILE /home/lixinyu/snap/new/ARC_code/eval/21897d95.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.\n\n    Input structure:\n    - The grid is a mosaic of monochrome regions.\n    - Color 1 forms T-shaped control markers on region boundaries.\n    - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.\n    - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.\n\n    Rule:\n    - For a color-1 T marker, the single stem points at the destination region to repaint.\n    - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.\n    - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.\n    - All marker cells are filled with the final color of the source-side region.\n    - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.\n\n    Key insight:\n    - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = _solve_unrotated(g)\n    l9 = _find_l9_orientation(g)\n    if l9 == 'top_right':\n        return np.rot90(out, 1)\n    if l9 == 'top_left':\n        return np.rot90(out, 3)\n    return out\n\n# --------------- generator (l9rot) ---------------\n\n# ── Tunable constants ──────────────────────────────────────────────────\n# Canvas / region sizing\nGRID_SIZE_MAX = 30                          # max rows or cols\nMIN_REGION_CELLS = 6                        # per-spec minimum\nREGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)\nREGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts\nREGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS\n\n# Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)\nMARKER_MIN = 4\nMARKER_MAX = 8\nNORMAL_MAX = 6\nCOLORED_MAX = 2\n\n# Color pool (all ARC colors except 1, which is reserved for T-marker cells)\nCOLOR_POOL = [c for c in range(10) if c != 1]\n\n# L9 rotation marker\nL9_PROBABILITY = 0.5                        # chance of placing a rotation marker\nL9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation\n    'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],\n    'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],\n}\n\n# Generation retry budget\nSEED_ATTEMPTS = 200                         # tries to place n distinct region seeds\nGEN_RETRIES = 300                           # outer generate_input retry budget\n\n_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n# ── Small geometry helpers ─────────────────────────────────────────────\n\ndef _get_bar(stem):\n    \"\"\"Return the two bar directions perpendicular to *stem*.\"\"\"\n    if stem[0] == 0:\n        return [(-1, 0), (1, 0)]\n    return [(0, -1), (0, 1)]\n\n\ndef _t_cells(center, stem):\n    \"\"\"Return the 4 cells of a T marker: center + stem tip + 2 bar cells.\"\"\"\n    r, c = center\n    bar = _get_bar(stem)\n    return {(r, c), (r + stem[0], c + stem[1]),\n            (r + bar[0][0], c + bar[0][1]), (r + bar[1][0], c + bar[1][1])}\n\n\ndef _t_branch_cells(center, stem):\n    \"\"\"Return the 3 branch cells (stem tip + 2 bar), excluding the center.\"\"\"\n    r, c = center\n    bar = _get_bar(stem)\n    return {(r + stem[0], c + stem[1]),\n            (r + bar[0][0], c + bar[0][1]),\n            (r + bar[1][0], c + bar[1][1])}\n\n\ndef _t_neighborhood(center, stem):\n    \"\"\"Return cells adjacent to any T cell but not part of the T itself.\"\"\"\n    cells = _t_cells(center, stem)\n    neighborhood = set()\n    for r, c in cells:\n        for dr, dc in _DIRS:\n            nb = (r + dr, c + dc)\n            if nb not in cells:\n                neighborhood.add(nb)\n    return neighborhood\n\n\n# ── Region partitioning ────────────────────────────────────────────────\n\ndef _grow_regions(H: int, W: int, n_regions: int) -> np.ndarray | None:\n    \"\"\"Grow n_regions from random seeds via randomized BFS; returns region-id array or None.\"\"\"\n    region = np.full((H, W), -1, dtype=int)\n    seeds = set()\n    for _ in range(SEED_ATTEMPTS):\n        if len(seeds) >= n_regions:\n            break\n        seeds.add((random.randint(1, H - 2), random.randint(1, W - 2)))\n    if len(seeds) < n_regions:\n        return None\n\n    frontier = []\n    for i, (r, c) in enumerate(list(seeds)):\n        region[r, c] = i\n        for dr, dc in _DIRS:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:\n                frontier.append((nr, nc, i))\n    random.shuffle(frontier)\n\n    while frontier:\n        idx = random.randint(0, len(frontier) - 1)\n        r, c, rid = frontier[idx]\n        frontier[idx] = frontier[-1]\n        frontier.pop()\n        if region[r, c] != -1:\n            continue\n        region[r, c] = rid\n        for dr, dc in _DIRS:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:\n                frontier.append((nr, nc, rid))\n\n    # Validate: each region must be 4-connected and have enough cells\n    for rid in range(n_regions):\n        mask = region == rid\n        if mask.sum() < MIN_REGION_CELLS:\n            return None\n        _, n = label_mask(mask, connectivity=4)\n        if n != 1:\n            return None\n    return region\n\n\n# ── Adjacency discovery ───────────────────────────────────────────────\n\ndef _find_adjacent_pairs(region: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Return all directed (src, dst) pairs between adjacent regions.\"\"\"\n    H, W = region.shape\n    # Detect boundaries via horizontal and vertical neighbor differences\n    undirected = set()\n    for r in range(H):\n        for c in range(W):\n            for dr, dc in _DIRS:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < H and 0 <= nc < W:\n                    a, b = int(region[r, c]), int(region[nr, nc])\n                    if a != b:\n                        undirected.add((min(a, b), max(a, b)))\n    directed = []\n    for a, b in undirected:\n        directed.append((a, b))\n        directed.append((b, a))\n    return directed\n\n\n# ── Marker count selection ─────────────────────────────────────────────\n\ndef _choose_marker_counts(n_regions: int) -> tuple[int, int, int] | None:\n    \"\"\"Return (n_markers, n_normal, n_colored) or None if infeasible.\"\"\"\n    max_possible = min(MARKER_MAX, n_regions)\n    if max_possible < MARKER_MIN:\n        return None\n    n_markers = random.randint(MARKER_MIN, max_possible)\n    n_colored = random.randint(0, min(COLORED_MAX, n_markers - 2))\n    n_normal = n_markers - n_colored\n    if n_normal > NORMAL_MAX:\n        n_colored = n_markers - NORMAL_MAX\n        n_normal = NORMAL_MAX\n        if n_colored > COLORED_MAX:\n            n_markers = NORMAL_MAX + COLORED_MAX\n            n_colored = COLORED_MAX\n            n_normal = NORMAL_MAX\n    return n_markers, n_normal, n_colored\n\n\n# ── Marker placement search ───────────────────────────────────────────\n\ndef _find_valid_placements(region, src, dst, occupied_cells, occupied_neighbors, H, W):\n    \"\"\"Find all valid (center, stem) for placing a T marker from src toward dst.\"\"\"\n    candidates = []\n    for r in range(1, H - 1):\n        for c in range(1, W - 1):\n            for stem in _DIRS:\n                bar = _get_bar(stem)\n                cells = _t_cells((r, c), stem)\n                if not all(0 <= cr < H and 0 <= cc < W for cr, cc in cells):\n                    continue\n                if cells & occupied_cells:\n                    continue\n                if _t_neighborhood((r, c), stem) & occupied_cells:\n                    continue\n                if cells & occupied_neighbors:\n                    continue\n                # Diagonal cells (stem + each bar dir) must lie in source region\n                if not all(\n                    0 <= r + stem[0] + bd[0] < H and\n                    0 <= c + stem[1] + bd[1] < W and\n                    region[r + stem[0] + bd[0], c + stem[1] + bd[1]] == src\n                    for bd in bar\n                ):\n                    continue\n                # Walk along stem from step=2 until we hit dst or leave bounds\n                step = 2\n                found = False\n                while True:\n                    nr, nc = r + stem[0] * step, c + stem[1] * step\n                    if not (0 <= nr < H and 0 <= nc < W):\n                        break\n                    if (nr, nc) in occupied_cells or (nr, nc) in cells:\n                        step += 1\n                        continue\n                    found = int(region[nr, nc]) == dst\n                    break\n                if found:\n                    candidates.append(((r, c), stem))\n    return candidates\n\n\ndef _register_marker(kind, center, stem, occupied_cells, occupied_neighbors):\n    \"\"\"Update occupied_cells and occupied_neighbors after placing a marker.\"\"\"\n    cells = _t_cells(center, stem)\n    if kind == 'normal':\n        occupied_cells |= cells\n        occupied_neighbors |= (_t_neighborhood(center, stem) - cells)\n    else:\n        branch = _t_branch_cells(center, stem)\n        occupied_cells |= branch\n        occupied_cells.add(center)\n        # Each branch cell must remain a singleton: buffer all non-marker neighbors\n        for br, bc in branch:\n            for dr, dc in _DIRS:\n                nb = (br + dr, bc + dc)\n                if nb != center and nb not in branch:\n                    occupied_neighbors.add(nb)\n        for dr, dc in _DIRS:\n            nb = (center[0] + dr, center[1] + dc)\n            if nb not in branch:\n                occupied_neighbors.add(nb)\n\n\n# ── Grid construction ─────────────────────────────────────────────────\n\ndef _build_color_map(region: np.ndarray, colors: list[int]) -> np.ndarray:\n    \"\"\"Map region ids to colors via vectorized lookup.\"\"\"\n    lut = np.array(colors, dtype=int)\n    return lut[region]\n\n\ndef _stamp_markers_input(grid, placed_markers):\n    \"\"\"Write T-marker cells onto the input grid.\"\"\"\n    for kind, center, stem, _src, _dst, tc in placed_markers:\n        if kind == 'normal':\n            for cr, cc in _t_cells(center, stem):\n                grid[cr, cc] = 1\n        else:\n            grid[center[0], center[1]] = tc\n            for cr, cc in _t_branch_cells(center, stem):\n                grid[cr, cc] = 1\n\n\ndef _stamp_markers_output(grid, placed_markers, out_colors):\n    \"\"\"Fill marker cells in the output grid with the source region's final color.\"\"\"\n    for kind, center, stem, src, _dst, _tc in placed_markers:\n        color = out_colors[src]\n        for cr, cc in _t_cells(center, stem):\n            grid[cr, cc] = color\n\n\n# ── L9 rotation marker ────────────────────────────────────────────────\n\ndef _try_place_l9(region, placed_markers, occupied_neighbors, input_grid, output_grid, out_colors):\n    \"\"\"Attempt to place a 5-cell L9 marker; return orientation string or None.\"\"\"\n    if random.random() >= L9_PROBABILITY:\n        return None\n    orient = random.choice(list(L9_OFFSETS))\n    offsets = L9_OFFSETS[orient]\n    H, W = region.shape\n\n    all_marker_cells = set()\n    for kind, center, stem, *_ in placed_markers:\n        all_marker_cells |= _t_cells(center, stem)\n\n    candidates = []\n    for r in range(H):\n        for c in range(W):\n            cells = [(r + dr, c + dc) for dr, dc in offsets]\n            if not all(0 <= cr < H and 0 <= cc < W for cr, cc in cells):\n                continue\n            rid = int(region[r, c])\n            if not all(int(region[cr, cc]) == rid for cr, cc in cells):\n                continue\n            if any((cr, cc) in all_marker_cells for cr, cc in cells):\n                continue\n            if any((cr, cc) in occupied_neighbors for cr, cc in cells):\n                continue\n            candidates.append((r, c, rid))\n\n    if not candidates:\n        return None\n    lr, lc, rid = random.choice(candidates)\n    for dr, dc in offsets:\n        input_grid[lr + dr, lc + dc] = 9\n        output_grid[lr + dr, lc + dc] = out_colors[rid]\n    return orient\n\n\n# ── Main generation attempt ───────────────────────────────────────────\n\ndef _gen_attempt() -> np.ndarray | None:\n    n_regions = random.choices(REGION_COUNTS, weights=REGION_WEIGHTS)[0]\n    min_size = max(9, int(n_regions * REGION_SIZE_FACTOR))\n    H = random.randint(min_size, GRID_SIZE_MAX)\n    W = random.randint(min_size, GRID_SIZE_MAX)\n\n    region = _grow_regions(H, W, n_regions)\n    if region is None:\n        return None\n\n    directed_pairs = _find_adjacent_pairs(region)\n\n    counts = _choose_marker_counts(n_regions)\n    if counts is None:\n        return None\n    n_markers, n_normal, n_colored = counts\n\n    # Select src->dst pairs with unique destinations\n    random.shuffle(directed_pairs)\n    dest_used = set()\n    marker_pairs = []\n    for src, dst in directed_pairs:\n        if dst not in dest_used:\n            marker_pairs.append((src, dst))\n            dest_used.add(dst)\n            if len(marker_pairs) >= n_markers:\n                break\n    if len(marker_pairs) < n_markers:\n        n_markers = len(marker_pairs)\n        if n_markers < MARKER_MIN:\n            return None\n        n_colored = min(n_colored, n_markers - 1)\n        n_normal = n_markers - n_colored\n    random.shuffle(marker_pairs)\n\n    # Assign input colors\n    pool = list(COLOR_POOL)\n    random.shuffle(pool)\n    if n_regions > len(pool):\n        return None\n    input_colors = pool[:n_regions]\n\n    # Compute output colors from recoloring rules\n    out_colors = list(input_colors)\n    normal_pairs = marker_pairs[:n_normal]\n    colored_pairs = marker_pairs[n_normal:]\n\n    colored_targets = []\n    for _src, dst in colored_pairs:\n        cands = [c for c in pool if c != input_colors[dst]]\n        if not cands:\n            return None\n        colored_targets.append(random.choice(cands))\n\n    for src, dst in normal_pairs:\n        out_colors[dst] = input_colors[src]\n    for (src, dst), tc in zip(colored_pairs, colored_targets):\n        out_colors[dst] = tc\n\n    # Build marker definitions and place them\n    all_defs = [('normal', s, d, None) for s, d in normal_pairs] + \\\n               [('colored', s, d, tc) for (s, d), tc in zip(colored_pairs, colored_targets)]\n    random.shuffle(all_defs)\n\n    occupied_cells: set[tuple[int, int]] = set()\n    occupied_neighbors: set[tuple[int, int]] = set()\n    placed_markers = []\n    for kind, src, dst, tc in all_defs:\n        cands = _find_valid_placements(region, src, dst, occupied_cells, occupied_neighbors, H, W)\n        if not cands:\n            return None\n        center, stem = random.choice(cands)\n        _register_marker(kind, center, stem, occupied_cells, occupied_neighbors)\n        placed_markers.append((kind, center, stem, src, dst, tc))\n\n    # Build grids via vectorized lookup\n    input_grid = _build_color_map(region, input_colors)\n    output_grid = _build_color_map(region, out_colors)\n\n    _stamp_markers_input(input_grid, placed_markers)\n    _stamp_markers_output(output_grid, placed_markers, out_colors)\n\n    # Optional L9 rotation marker\n    l9_orient = _try_place_l9(region, placed_markers, occupied_neighbors,\n                              input_grid, output_grid, out_colors)\n    if l9_orient == 'top_right':\n        output_grid = np.rot90(output_grid, 1)\n    elif l9_orient == 'top_left':\n        output_grid = np.rot90(output_grid, 3)\n\n    try:\n        result = main(input_grid)\n    except Exception:\n        return None\n    return input_grid if np.array_equal(result, output_grid) else None\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n\nFILE /home/lixinyu/snap/new/ARC_code/eval/a25697e4.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Dock movable tools into border-anchored frames by filling cavities.\n\n    Input structure:\n    - bg = most common color.\n    - Border-touching components cluster into anchor frames with interior bg cavities.\n    - Non-border 2-color components are movable tools.\n\n    Rule:\n    - Match each tool to a frame whose cavity size equals one of its color-region counts.\n    - Rotate/flip the tool so one color fills the cavity exactly; the other stays outside.\n    - If the docking orientation uses a reflection, swap the tool's two colors.\n\n    Key insight: Cavity size determines tool–frame pairing; reflection triggers color swap.\n    \"\"\"\n    inp = grid\n    g = inp.copy()\n    bg = get_bg(g)\n    H, W = g.shape\n\n    def bbox_gap(a, b) -> int:\n        (ar0, ac0, ar1, ac1) = a\n        (br0, bc0, br1, bc1) = b\n        def gap1(x0, x1, y0, y1):\n            if y1 < x0:\n                return int(x0 - y1)\n            if x1 < y0:\n                return int(y0 - x1)\n            return 0\n        return gap1(ar0, ar1, br0, br1) + gap1(ac0, ac1, bc0, bc1)\n\n    fg = g != int(bg)\n    lab, n = label(fg, structure=STRUCT4)\n    fixed_mask = np.zeros((H, W), dtype=bool)\n    fixed_components = []\n    for cid in range(1, n + 1):\n        pts = np.argwhere(lab == cid)\n        pts_list = [(int(r), int(c)) for r, c in pts]\n        touches = any(r == 0 or r == H - 1 or c == 0 or c == W - 1 for r, c in pts_list)\n        if not touches:\n            continue\n        fixed_components.append({\"pts\": pts_list, \"bbox\": (int(pts[:,0].min()), int(pts[:,1].min()), int(pts[:,0].max()), int(pts[:,1].max()))})\n        for r, c in pts_list:\n            fixed_mask[r, c] = True\n\n    assert not (not fixed_components)\n\n    # Cluster fixed components into anchor frames.\n    parent = list(range(len(fixed_components)))\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(a, b):\n        ra, rb = find(a), find(b)\n        if ra != rb:\n            parent[rb] = ra\n\n    for i in range(len(fixed_components)):\n        for j in range(i + 1, len(fixed_components)):\n            if bbox_gap(fixed_components[i][\"bbox\"], fixed_components[j][\"bbox\"]) <= 2:\n                union(i, j)\n\n    groups: dict[int, list[int]] = {}\n    for i in range(len(fixed_components)):\n        groups.setdefault(find(i), []).append(i)\n\n    anchor_groups = []\n    for idxs in groups.values():\n        pts = [p for i in idxs for p in fixed_components[i][\"pts\"]]\n        rs = [r for r, _c in pts]\n        cs = [c for _r, c in pts]\n        bbox = (min(rs), min(cs), max(rs), max(cs))\n        mask = np.zeros((H, W), dtype=bool)\n        for r, c in pts:\n            mask[r, c] = True\n        sock = np.zeros((H, W), dtype=bool)\n        for r in range(bbox[0], bbox[2] + 1):\n            for c in range(bbox[1], bbox[3] + 1):\n                if int(g[r, c]) != int(bg):\n                    continue\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    rr, cc = r + dr, c + dc\n                    if 0 <= rr < H and 0 <= cc < W and mask[rr, cc]:\n                        sock[r, c] = True\n                        break\n\n        # Cavity = largest bg component inside bbox that is adjacent to the anchor pixels.\n        cavity = np.zeros((H, W), dtype=bool)\n        sub_bg = (g[bbox[0] : bbox[2] + 1, bbox[1] : bbox[3] + 1] == int(bg))\n        sub_lab, sub_n = label(sub_bg, structure=STRUCT4)\n        best_c = None  # (area, cid)\n        for cid in range(1, sub_n + 1):\n            ptsc = np.argwhere(sub_lab == cid)\n            area = int(len(ptsc))\n            # check adjacency to anchor within bbox\n            adj = False\n            for rr, cc in ptsc:\n                r = int(bbox[0] + rr)\n                c = int(bbox[1] + cc)\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    r2, c2 = r + dr, c + dc\n                    if bbox[0] <= r2 <= bbox[2] and bbox[1] <= c2 <= bbox[3] and mask[r2, c2]:\n                        adj = True\n                        break\n                if adj:\n                    break\n            if not adj:\n                continue\n            cand = (area, -cid)\n            if best_c is None or cand > best_c:\n                best_c = cand\n                best_id = cid\n        if best_c is not None:\n            ptsc = np.argwhere(sub_lab == best_id)\n            for rr, cc in ptsc:\n                cavity[int(bbox[0] + rr), int(bbox[1] + cc)] = True\n        cav_bbox = None\n        if cavity.any():\n            ptsc2 = np.argwhere(cavity)\n            r0c, c0c = ptsc2.min(axis=0)\n            r1c, c1c = ptsc2.max(axis=0)\n            cav_bbox = (int(r0c), int(c0c), int(r1c), int(c1c))\n\n        # swap rule for this anchor group: look for a color that appears in >=2 fixed sub-components\n        # (within the group) with different sizes and larger-above-smaller.\n        swap_needed = False\n        for col in sorted({int(x) for x in np.unique(g[mask])} - {int(bg)}):\n            sub = (g == int(col)) & mask\n            labc, nc = label(sub, structure=STRUCT4)\n            if nc < 2:\n                continue\n            comps = []\n            for cid in range(1, nc + 1):\n                ptsc = np.argwhere(labc == cid)\n                comps.append((int(len(ptsc)), float(ptsc[:, 0].mean()), float(ptsc[:, 1].mean())))\n            comps.sort(reverse=True)\n            (s0, r0, _c0), (s1, r1, _c1) = comps[0], comps[1]\n            # Swap only when the larger component is vertically above the smaller one.\n            if s0 != s1 and r0 < r1:\n                swap_needed = True\n                break\n\n        # Dominant open direction: which side has the most bg neighbors.\n        dir_list = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # U,D,L,R\n        dir_counts = [0, 0, 0, 0]\n        for r, c in pts:\n            for di, (dr, dc) in enumerate(dir_list):\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(bg):\n                    dir_counts[di] += 1\n        open_dir = dir_list[int(np.argmax(dir_counts))]\n        _labg, _ng = label(mask, structure=STRUCT4)\n        single_piece = int(_ng) == 1\n        cavity_size = int(cavity.sum())\n\n        anchor_groups.append(\n            {\n                \"mask\": mask,\n                \"bbox\": bbox,\n                \"socket_mask\": sock,\n                \"cavity_mask\": cavity,\n                \"cavity_bbox\": cav_bbox,\n                \"open_dir\": open_dir,\n                \"swap_needed\": swap_needed,\n                \"single_piece\": single_piece,\n                \"cavity_size\": cavity_size,\n                \"size\": int(mask.sum()),\n            }\n        )\n    anchor_groups.sort(key=lambda d: -d[\"size\"])\n\n    # Movable multi-color components are the remaining foreground pixels.\n    mov_mask = fg & (~fixed_mask)\n    mov_lab, mov_n = label(mov_mask, structure=STRUCT4)\n    mov_comps = []\n    for cid in range(1, mov_n + 1):\n        pts = np.argwhere(mov_lab == cid)\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        m = mov_lab[r0 : r1 + 1, c0 : c1 + 1] == cid\n        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        patch[~m] = 0\n        mov_comps.append({\"bbox\": (int(r0), int(c0), int(r1), int(c1)), \"mask\": m, \"patch\": patch, \"size\": int(len(pts))})\n    mov_comps.sort(key=lambda d: -d[\"size\"])\n\n    def choose_group(bbox) -> int:\n        best_i = 0\n        best_d = None\n        for i, grp in enumerate(anchor_groups):\n            d = bbox_gap(bbox, grp[\"bbox\"])\n            if best_d is None or d < best_d:\n                best_d = d\n                best_i = i\n        return int(best_i)\n\n    def gen_variants(patch: np.ndarray, mask: np.ndarray):\n        \"\"\"All unique dihedral variants, with a reflection flag.\"\"\"\n        base: list[tuple[np.ndarray, np.ndarray, bool]] = []\n        for k in range(4):\n            p = np.rot90(patch, k)\n            m = np.rot90(mask, k)\n            base.append((p, m, False))\n            base.append((np.fliplr(p), np.fliplr(m), True))\n        uniq: list[tuple[np.ndarray, np.ndarray, bool]] = []\n        seen = set()\n        for p, m, is_flip in base:\n            key = (m.tobytes(), p[m].tobytes())\n            if key in seen:\n                continue\n            seen.add(key)\n            uniq.append((p, m, is_flip))\n        return uniq\n\n    out = np.full_like(g, int(bg))\n    out[fixed_mask] = g[fixed_mask]\n    placed_global = fixed_mask.copy()\n    placed_groups = [grp[\"mask\"].copy() for grp in anchor_groups]\n\n    group_for_comp: list[int]\n    # Match condition (key): a tool can dock into a frame only if one of its two color-regions has\n    # pixel-count equal to the frame's cavity size. Use this to assign tools to frames (one-to-one\n    # when counts match), falling back to distance only if no such match exists.\n    comp_color_counts: list[dict[int, int]] = []\n    for comp in mov_comps:\n        vals = [int(x) for x in comp[\"patch\"][comp[\"mask\"]].flatten() if int(x) != 0]\n        comp_color_counts.append(dict(Counter(vals)))\n\n    def compatible(ci: int, gi: int) -> bool:\n        cav_sz = int(anchor_groups[gi][\"cavity_size\"])\n        return any(int(v) == cav_sz for v in comp_color_counts[ci].values())\n\n    if len(mov_comps) == len(anchor_groups) and len(anchor_groups) > 1:\n        import itertools\n\n        best_perm = None\n        best_score = None\n        for perm in itertools.permutations(range(len(anchor_groups))):\n            ok = True\n            hits = 0\n            dist_sum = 0\n            for ci, gi in enumerate(perm):\n                if not compatible(ci, gi):\n                    ok = False\n                    break\n                hits += 1\n                dist_sum += bbox_gap(mov_comps[ci][\"bbox\"], anchor_groups[gi][\"bbox\"])\n            if not ok:\n                continue\n            score = (int(hits), -int(dist_sum))\n            if best_score is None or score > best_score:\n                best_score = score\n                best_perm = perm\n        assert best_perm is not None, 'must find a compatible tool-to-frame permutation'\n        group_for_comp = [int(x) for x in best_perm]\n    else:\n        group_for_comp = []\n        for ci, comp in enumerate(mov_comps):\n            best_g = None\n            best_d = None\n            for gi, grp in enumerate(anchor_groups):\n                if not compatible(ci, gi):\n                    continue\n                d = bbox_gap(comp[\"bbox\"], grp[\"bbox\"])\n                if best_d is None or d < best_d:\n                    best_d = d\n                    best_g = gi\n            group_for_comp.append(int(best_g) if best_g is not None else int(choose_group(comp[\"bbox\"])))\n\n    for comp, gi in zip(mov_comps, group_for_comp):\n        grp = anchor_groups[gi]\n        placed_grp = placed_groups[gi]\n        sock = grp[\"socket_mask\"]\n        cav = grp[\"cavity_mask\"]\n        cav_bbox = grp[\"cavity_bbox\"]\n        odr, odc = grp[\"open_dir\"]\n        # Swap rule (more principled): swap the two tool colors iff the *docking transform* uses a\n        # reflection (flip). We'll detect this from the winning variant. (Ignore equal-area 2-color\n        # tools: swapping is ambiguous and not needed.)\n        comp_vals = [int(x) for x in comp[\"patch\"][comp[\"mask\"]].flatten() if int(x) != 0]\n        comp_counts = Counter(comp_vals)\n\n        best_state = None\n        # Score prioritizes *filling the cavity* with exactly one tool color region.\n        # (plug_full, plug_hits, -nonplug_in_cavity, -plug_outside, cavity_hits, adj, outside, socket_hits, -dist, -r0, -c0)\n        best_score = None\n        cav_sz = int(grp[\"cavity_size\"])\n        for p, m, is_flip in gen_variants(comp[\"patch\"], comp[\"mask\"]):\n            h, w = m.shape\n            coords = np.argwhere(m)\n            cols_here = sorted({int(x) for x in p[m].flatten() if int(x) != 0})\n            plug_colors = [int(col) for col in cols_here if int(((p == int(col)) & m).sum()) == cav_sz]\n            assert plug_colors\n            for r0 in range(0, H - h + 1):\n                for c0 in range(0, W - w + 1):\n                    ok = True\n                    for rr, cc in coords:\n                        r = int(r0 + rr)\n                        c = int(c0 + cc)\n                        if placed_global[r, c]:\n                            ok = False\n                            break\n                    if not ok:\n                        continue\n                    adj = 0\n                    for rr, cc in coords:\n                        r = int(r0 + rr)\n                        c = int(c0 + cc)\n                        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                            r2, c2 = r + dr, c + dc\n                            if 0 <= r2 < H and 0 <= c2 < W and placed_grp[r2, c2]:\n                                adj += 1\n                    if adj == 0:\n                        continue\n                    socket_hits = 0\n                    cavity_hits = 0\n                    outside = 0\n                    # Best plug-match for this placement among candidate plug colors.\n                    plug_best = None  # (plug_full, plug_hits, -nonplug_in_cavity, -plug_outside)\n                    for rr, cc in coords:\n                        r = int(r0 + rr)\n                        c = int(c0 + cc)\n                        if sock[r, c]:\n                            socket_hits += 1\n                        if cav[r, c]:\n                            cavity_hits += 1\n                        # Count pixels placed outside the anchor bbox in the dominant open direction.\n                        br0, bc0, br1, bc1 = grp[\"bbox\"]\n                        if odc == -1 and c < bc0:\n                            outside += 1\n                        elif odc == 1 and c > bc1:\n                            outside += 1\n                        elif odr == -1 and r < br0:\n                            outside += 1\n                        elif odr == 1 and r > br1:\n                            outside += 1\n\n                    for plug_col in plug_colors:\n                        if plug_col is None:\n                            plug_score = (0, 0, 0, 0)\n                        else:\n                            plug_hits = 0\n                            plug_outside = 0\n                            nonplug_in_cav = 0\n                            for rr, cc in coords:\n                                r = int(r0 + rr)\n                                c = int(c0 + cc)\n                                in_cav = bool(cav[r, c])\n                                col = int(p[rr, cc])\n                                if col == int(plug_col):\n                                    if in_cav:\n                                        plug_hits += 1\n                                    else:\n                                        plug_outside += 1\n                                else:\n                                    if in_cav:\n                                        nonplug_in_cav += 1\n                            plug_full = int(plug_hits == cav_sz and plug_outside == 0 and nonplug_in_cav == 0)\n                            plug_score = (int(plug_full), int(plug_hits), -int(nonplug_in_cav), -int(plug_outside))\n                        if plug_best is None or plug_score > plug_best:\n                            plug_best = plug_score\n                    dist = bbox_gap(grp[\"bbox\"], (int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1)))\n                    score = tuple(plug_best) + (\n                        int(cavity_hits),\n                        int(adj),\n                        int(outside),\n                        int(socket_hits),\n                        -int(dist),\n                        -int(r0),\n                        -int(c0),\n                    )\n                    if best_score is None or score > best_score:\n                        best_score = score\n                        best_state = (p, m, int(r0), int(c0), bool(is_flip))\n\n        assert best_state is not None, 'must find a valid placement for every movable tool'\n        p, m, r0, c0, is_flip = best_state\n        if is_flip and len(comp_counts) == 2 and len(set(comp_counts.values())) == 2:\n            a, b = sorted(comp_counts.keys())\n            q = p.copy()\n            q[(p == a) & m] = b\n            q[(p == b) & m] = a\n            p = q\n        for rr, cc in np.argwhere(m):\n            r = int(r0 + rr)\n            c = int(c0 + cc)\n            out[r, c] = int(p[rr, cc])\n            placed_global[r, c] = True\n            placed_grp[r, c] = True\n\n    return out\n\n# --------------- generator (O4) ---------------\n\nfrom arc_utils import bbox as _bbox\n\n# ── CFG: canvas ──\nGRID_H_RANGE = (18, 30)          # output grid height\nGRID_W_RANGE = (25, 30)          # output grid width\nNUM_PAIRS_CHOICES = [1, 2]       # how many frame-tool pairs\n\n# ── CFG: frame geometry ──\nFRAME_W_RANGE = (4, 8)           # frame width (exclusive upper)\nNOTCH_N_RANGE = (1, 4)           # notch cell count (exclusive upper)\nTOP_H_RANGE = (1, 4)             # top bar height (exclusive upper)\nBOT_H_RANGE = (2, 4)             # bottom bar height (exclusive upper)\nPLUG_AREA_BOUNDS = (5, 8)        # valid plug area = fw + notch_n\n\n# ── CFG: tool sizing ──\nHANDLE_AREA_RANGE = (4, 10)      # handle pixel count (exclusive upper)\nTOOL_TOTAL_BOUNDS = (10, 15)     # plug + handle total pixels\nHANDLE_SPRITE_DIM = (2, 5)      # handle sprite bbox side (exclusive upper)\n\n# ── CFG: placement ──\nUNION_BBOX_GAP_MIN = 2           # min gap between pair union bboxes\nFRAME_BBOX_GAP_MIN = 3           # min gap between frame bboxes\nTOOL_BORDER = 1                  # border margin for free tool placement\nTOOL_PADDING = 3                 # padding around existing content\nTOOL_PADDING_CONN = 4            # connectivity for padding check\n\n# ── CFG: retry limits ──\nPAIR_SPEC_RETRIES = 300          # retries for picking compatible pair specs\nHANDLE_SPRITE_RETRIES = 30       # retries for generating a valid handle sprite\nGEN_ATTEMPT_RETRIES = 300        # outer retries in generate_input()\n\n\ndef _bbox_gap(a, b) -> int:\n    \"\"\"Manhattan gap between two axis-aligned bboxes (r0,c0,r1,c1).\"\"\"\n    (ar0, ac0, ar1, ac1) = a\n    (br0, bc0, br1, bc1) = b\n\n    def _gap1(x0, x1, y0, y1):\n        if y1 < x0:\n            return x0 - y1\n        if x1 < y0:\n            return y0 - x1\n        return 0\n\n    return _gap1(ar0, ar1, br0, br1) + _gap1(ac0, ac1, bc0, bc1)\n\n\ndef _transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:\n    \"\"\"Apply rot90(k) then optional horizontal flip.\"\"\"\n    out = np.rot90(arr, k)\n    if flip:\n        out = np.fliplr(out)\n    return out\n\n\ndef _orient_left_to_side(arr: np.ndarray, side: str) -> np.ndarray:\n    \"\"\"Rotate/flip an array built for the left border to target the given side.\"\"\"\n    if side == \"left\":\n        return arr.copy()\n    if side == \"right\":\n        return np.fliplr(arr)\n    if side == \"top\":\n        return np.rot90(arr, 3)\n    if side == \"bottom\":\n        return np.rot90(arr, 1)\n    raise ValueError(side)\n\n\ndef _swap_colors(patch: np.ndarray, a: int, b: int) -> np.ndarray:\n    \"\"\"Swap two colors in a patch, returning a new array.\"\"\"\n    out = patch.copy()\n    ma, mb = out == a, out == b\n    out[ma] = b\n    out[mb] = a\n    return out\n\n\ndef _notch_offsets(notch_n: int, fw: int, bot_h: int) -> list[tuple[int, int]]:\n    \"\"\"Return (row, col) offsets within the bottom bar to carve out a staircase notch.\"\"\"\n    if notch_n == 1:\n        return [(0, fw - 1)]\n    if notch_n == 2:\n        return [(0, fw - 2), (0, fw - 1)]\n    if notch_n == 3:\n        if bot_h >= 2:\n            return [(0, fw - 2), (0, fw - 1), (1, fw - 1)]\n        return [(0, fw - 3), (0, fw - 2), (0, fw - 1)]\n    raise ValueError(notch_n)\n\n\ndef _make_handle_sprite(handle_area: int, bg: int, handle_color: int) -> np.ndarray | None:\n    \"\"\"Generate a random 4-connected handle sprite with exactly handle_area pixels.\"\"\"\n    lo, hi = HANDLE_SPRITE_DIM\n    dims = [(h, w) for h in range(lo, hi) for w in range(lo, hi)\n            if handle_area <= h * w <= handle_area * 2]\n    if not dims:\n        return None\n    for _ in range(HANDLE_SPRITE_RETRIES):\n        h, w = random.choice(dims)\n        sprite = random_sprite(\n            h, w, density=handle_area / (h * w),\n            color_palette=[handle_color], connectivity=4, background=bg,\n        )\n        if int(np.sum(sprite != bg)) == handle_area:\n            return sprite\n    return None\n\n\ndef _build_left_pair(\n    *, bg: int, frame_color: int, plug_color: int, handle_color: int,\n    fw: int, top_h: int, bot_h: int, notch_n: int, handle_area: int,\n) -> tuple[np.ndarray, np.ndarray] | None:\n    \"\"\"Build a frame + docked tool pair oriented for the left border.\n\n    Returns (frame_array, tool_array) on the same canvas, or None on failure.\n    \"\"\"\n    fh = top_h + 1 + bot_h\n    frame = np.full((fh, fw), bg, dtype=int)\n    frame[:top_h, :] = frame_color\n    frame[top_h + 1:, :] = frame_color\n    for dr, dc in _notch_offsets(notch_n, fw, bot_h):\n        frame[top_h + 1 + dr, dc] = bg\n\n    cavity = frame == bg\n    attach_rows = {r for r in range(fh) if cavity[r, fw - 1]}\n\n    handle_sprite = _make_handle_sprite(handle_area, bg, handle_color)\n    if handle_sprite is None:\n        return None\n\n    hs_h, hs_w = handle_sprite.shape\n    sprite_left_rows = {r for r in range(hs_h) if handle_sprite[r, 0] != bg}\n\n    valid_offsets = [\n        voff for voff in range(fh)\n        if any((voff + sr) in attach_rows for sr in sprite_left_rows)\n    ]\n    if not valid_offsets:\n        return None\n\n    voff = random.choice(valid_offsets)\n    total_h = max(fh, voff + hs_h)\n    total_w = fw + hs_w\n\n    frame_full = np.full((total_h, total_w), bg, dtype=int)\n    frame_full[:fh, :fw] = frame\n\n    tool = np.full((total_h, total_w), bg, dtype=int)\n    tool[:fh, :fw][cavity] = plug_color\n    handle_mask = handle_sprite != bg\n    tool[voff:voff + hs_h, fw:fw + hs_w][handle_mask] = handle_color\n\n    return frame_full, tool\n\n\ndef _build_param_options() -> list[tuple[int, int, int, int]]:\n    \"\"\"Enumerate all valid (fw, top_h, bot_h, notch_n) combinations.\"\"\"\n    fw_lo, fw_hi = FRAME_W_RANGE\n    nn_lo, nn_hi = NOTCH_N_RANGE\n    th_lo, th_hi = TOP_H_RANGE\n    bh_lo, bh_hi = BOT_H_RANGE\n    pa_lo, pa_hi = PLUG_AREA_BOUNDS\n    return [\n        (fw, top_h, bot_h, notch_n)\n        for fw in range(fw_lo, fw_hi)\n        for notch_n in range(nn_lo, nn_hi)\n        if pa_lo <= fw + notch_n <= pa_hi\n        for top_h in range(th_lo, th_hi)\n        for bot_h in range(bh_lo, bh_hi)\n    ]\n\n\nPARAM_OPTIONS = _build_param_options()\n\n\ndef _pick_pair_specs(num_pairs: int) -> list[dict]:\n    \"\"\"Pick frame geometry specs for each pair, ensuring distinct plug areas.\"\"\"\n    ha_lo, ha_hi = HANDLE_AREA_RANGE\n    tt_lo, tt_hi = TOOL_TOTAL_BOUNDS\n    specs: list[dict] = []\n    for _ in range(PAIR_SPEC_RETRIES):\n        specs.clear()\n        used_plug_areas: set[int] = set()\n        for _ in range(num_pairs):\n            candidates = [x for x in PARAM_OPTIONS if x[0] + x[3] not in used_plug_areas]\n            if not candidates:\n                specs = []\n                break\n            fw, top_h, bot_h, notch_n = random.choice(candidates)\n            plug_area = fw + notch_n\n            specs.append({\"fw\": fw, \"top_h\": top_h, \"bot_h\": bot_h,\n                          \"notch_n\": notch_n, \"plug_area\": plug_area})\n            used_plug_areas.add(plug_area)\n        if len(specs) != num_pairs:\n            continue\n        all_plug_areas = {s[\"plug_area\"] for s in specs}\n        ok = True\n        for spec in specs:\n            pa = spec[\"plug_area\"]\n            handle_choices = [\n                h for h in range(ha_lo, ha_hi)\n                if tt_lo <= pa + h <= tt_hi and h != pa and h not in all_plug_areas\n            ]\n            if not handle_choices:\n                ok = False\n                break\n            spec[\"handle_area\"] = random.choice(handle_choices)\n        if ok:\n            return [dict(s) for s in specs]\n    return []\n\n\ndef _candidate_origins(side: str, ph: int, pw: int, H: int, W: int) -> list[tuple[int, int]]:\n    \"\"\"Return shuffled candidate (r0, c0) origins for placing a patch on the given border side.\"\"\"\n    if side == \"left\":\n        origins = [(r0, 0) for r0 in range(H - ph + 1)]\n    elif side == \"right\":\n        origins = [(r0, W - pw) for r0 in range(H - ph + 1)]\n    elif side == \"top\":\n        origins = [(0, c0) for c0 in range(W - pw + 1)]\n    elif side == \"bottom\":\n        origins = [(H - ph, c0) for c0 in range(W - pw + 1)]\n    else:\n        raise ValueError(side)\n    random.shuffle(origins)\n    return origins\n\n\ndef _variant_choices(patch: np.ndarray) -> list[tuple[np.ndarray, bool]]:\n    \"\"\"Return shuffled list of unique D4 variants of patch, each with its flip flag.\"\"\"\n    seen = set()\n    out: list[tuple[np.ndarray, bool]] = []\n    mask = patch != 0\n    for k in range(4):\n        for flip in (False, True):\n            q = _transform(patch, k, flip)\n            m = _transform(mask.astype(np.uint8), k, flip).astype(bool)\n            key = (m.tobytes(), q[m].tobytes())\n            if key in seen:\n                continue\n            seen.add(key)\n            out.append((q, flip))\n    random.shuffle(out)\n    return out\n\n\ndef _place_docked_pair(\n    i: int, spec: dict, colors: list[int], side: str, bg: int,\n    H: int, W: int, output: np.ndarray, input_grid: np.ndarray,\n    union_bboxes: list, frame_bboxes: list,\n) -> dict | None:\n    \"\"\"Build one frame-tool pair, dock it onto the output, and record frame on input_grid.\n\n    Returns tool info dict for later undocking, or None on failure.\n    \"\"\"\n    frame_color = colors[3 * i]\n    plug_color = colors[3 * i + 1]\n    handle_color = colors[3 * i + 2]\n\n    result = _build_left_pair(\n        bg=bg, frame_color=frame_color, plug_color=plug_color,\n        handle_color=handle_color, fw=spec[\"fw\"], top_h=spec[\"top_h\"],\n        bot_h=spec[\"bot_h\"], notch_n=spec[\"notch_n\"],\n        handle_area=spec[\"handle_area\"],\n    )\n    if result is None:\n        return None\n    frame_left, tool_left = result\n\n    # Combine frame + tool into a single docked scene\n    scene_left = np.where(tool_left != bg, tool_left, frame_left)\n\n    frame_scene = _orient_left_to_side(frame_left, side)\n    tool = _orient_left_to_side(tool_left, side)\n    scene = _orient_left_to_side(scene_left, side)\n    ph, pw = scene.shape\n    fr0, fc0, fr1, fc1 = _bbox(frame_scene != bg)\n\n    origin = None\n    for r0, c0 in _candidate_origins(side, ph, pw, H, W):\n        union_bbox = (r0, c0, r0 + ph - 1, c0 + pw - 1)\n        frame_bbox = (r0 + fr0, c0 + fc0, r0 + fr1, c0 + fc1)\n        if side in (\"left\", \"right\") and (frame_bbox[0] == 0 or frame_bbox[2] == H - 1):\n            continue\n        if side in (\"top\", \"bottom\") and (frame_bbox[1] == 0 or frame_bbox[3] == W - 1):\n            continue\n        if any(_bbox_gap(union_bbox, prev) <= UNION_BBOX_GAP_MIN - 1 for prev in union_bboxes):\n            continue\n        if any(_bbox_gap(frame_bbox, prev) <= FRAME_BBOX_GAP_MIN - 1 for prev in frame_bboxes):\n            continue\n        if np.any((output[r0:r0 + ph, c0:c0 + pw] != bg) & (scene != bg)):\n            continue\n        origin = (r0, c0)\n        break\n    if origin is None:\n        return None\n\n    r0, c0 = origin\n    paste(output, scene, r0, c0, transparent=bg)\n    paste(input_grid, frame_scene, r0, c0, transparent=bg)\n\n    union_bboxes.append((r0, c0, r0 + ph - 1, c0 + pw - 1))\n    frame_bboxes.append((r0 + fr0, c0 + fc0, r0 + fr1, c0 + fc1))\n    return {\n        \"tool\": tool, \"plug_color\": plug_color, \"handle_color\": handle_color,\n        \"plug_area\": spec[\"plug_area\"], \"handle_area\": spec[\"handle_area\"],\n    }\n\n\ndef _undock_tool(info: dict, bg: int, input_grid: np.ndarray,\n                 placement_canvas: np.ndarray) -> bool:\n    \"\"\"Pick a random D4 variant of the tool and place it at a free location on the grid.\n\n    Returns True on success, False if no placement found.\n    \"\"\"\n    for patch, is_flip in _variant_choices(info[\"tool\"]):\n        if is_flip and info[\"plug_area\"] != info[\"handle_area\"]:\n            patch = _swap_colors(patch, info[\"plug_color\"], info[\"handle_color\"])\n        try:\n            r0, c0 = random_free_location(\n                placement_canvas, patch, transparent=bg,\n                border=TOOL_BORDER, padding=TOOL_PADDING,\n                padding_connectivity=TOOL_PADDING_CONN,\n            )\n        except ValueError:\n            continue\n        paste(input_grid, patch, r0, c0, transparent=bg)\n        paste(placement_canvas, patch, r0, c0, transparent=bg)\n        return True\n    return False\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n    H = random.randint(*GRID_H_RANGE)\n    W = random.randint(*GRID_W_RANGE)\n    bg = random.choice(list(range(10)))\n    num_pairs = random.choice(NUM_PAIRS_CHOICES)\n\n    pair_specs = _pick_pair_specs(num_pairs)\n    if len(pair_specs) != num_pairs:\n        return None\n\n    colors = [c for c in range(1, 10) if c != bg]\n    random.shuffle(colors)\n    need = 1 + (3 * num_pairs)\n    if len(colors) < need:\n        return None\n\n    sides = random.sample([\"left\", \"right\", \"top\", \"bottom\"], k=num_pairs)\n    output = np.full((H, W), bg, dtype=int)\n    input_grid = np.full((H, W), bg, dtype=int)\n    union_bboxes: list[tuple[int, int, int, int]] = []\n    frame_bboxes: list[tuple[int, int, int, int]] = []\n    placed_tools: list[dict] = []\n\n    for i, spec in enumerate(pair_specs):\n        info = _place_docked_pair(\n            i, spec, colors, sides[i], bg, H, W,\n            output, input_grid, union_bboxes, frame_bboxes,\n        )\n        if info is None:\n            return None\n        placed_tools.append(info)\n\n    placement_canvas = output.copy()\n    for info in placed_tools:\n        if not _undock_tool(info, bg, input_grid, placement_canvas):\n            return None\n\n    if np.array_equal(main(input_grid), output):\n        return input_grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPT_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input after %d attempts\" % GEN_ATTEMPT_RETRIES)\n\n","exit_code":0,"status":"completed"}}
