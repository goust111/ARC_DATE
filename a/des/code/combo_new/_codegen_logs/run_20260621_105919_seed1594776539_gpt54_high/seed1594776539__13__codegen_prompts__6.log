{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '260,620p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"        for col, cnt in adj_counts.items():\n            if col not in mapping:\n                continue\n            if cnt > best:\n                best = cnt\n                border = col\n        if border is None:\n            continue\n\n        fill = int(mapping[border])\n        for r, c in pts:\n            out[r, c] = fill\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\ndef _get_enclosed_holes(sprite):\n    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n    h, w = sprite.shape\n    return [pts for pts in components_mask(~sprite, connectivity=4)\n            if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n\n\ndef _make_diamond():\n    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n    s = np.zeros((3, 3), dtype=bool)\n    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n    return s\n\n\ndef _make_hollow_sprite(h, w, rng):\n    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n    sprite = np.ones((h, w), dtype=bool)\n    if h >= 3 and w >= 3:\n        sprite[1:-1, 1:-1] = False\n    # Optionally add internal horizontal wall\n    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n        br = rng.randint(2, h - 2)\n        n = rng.randint(1, w - 2)\n        s = rng.randint(1, w - 1 - n + 1)\n        sprite[br, s:s + n] = True\n    # Optionally add internal vertical wall\n    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n        bc = rng.randint(2, w - 2)\n        n = rng.randint(1, h - 2)\n        s = rng.randint(1, h - 1 - n + 1)\n        sprite[s:s + n, bc] = True\n    # Optionally remove border cells for irregularity\n    if rng.random() < _P_BORDER_REMOVAL:\n        bcells = [(r, c) for r in range(h) for c in range(w)\n                  if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n        rng.shuffle(bcells)\n        for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n            test = sprite.copy()\n            test[cr, cc] = False\n            if _get_enclosed_holes(test):\n                sprite = test\n    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n        return None\n    return sprite\n\n\ndef _choose_colors(rng, N, num_filled):\n    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n    all_c = list(range(1, 10))\n    rng.shuffle(all_c)\n    border_keys = all_c[:N]\n    rng.shuffle(all_c)\n    fill_values = all_c[:N]\n    dist_cands = [c for c in range(1, 10) if c not in border_keys]\n    distractor_color = rng.choice(dist_cands)\n    mapping = dict(zip(border_keys, fill_values))\n    filled_keys = rng.sample(border_keys, num_filled)\n    return border_keys, fill_values, distractor_color, mapping, filled_keys\n\n\ndef _build_palette(side, border_keys, fill_values):\n    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n    N = len(border_keys)\n    if side in ('top', 'bottom'):\n        pal = np.zeros((2, N), dtype=int)\n        outer, inner = (0, 1) if side == 'top' else (1, 0)\n        pal[outer] = border_keys\n        pal[inner] = fill_values\n    else:\n        pal = np.zeros((N, 2), dtype=int)\n        outer, inner = (0, 1) if side == 'left' else (1, 0)\n        pal[:, outer] = border_keys\n        pal[:, inner] = fill_values\n    return pal\n\n\ndef _place_palette(grid, occ, pal, side, rng):\n    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n    H, W = grid.shape\n    pal_h, pal_w = pal.shape\n    if side == 'top':\n        pr0, pc0 = 0, rng.randint(0, W - pal_w)\n    elif side == 'bottom':\n        pr0, pc0 = H - pal_h, rng.randint(0, W - pal_w)\n    elif side == 'left':\n        pr0, pc0 = rng.randint(0, H - pal_h), 0\n    else:\n        pr0, pc0 = rng.randint(0, H - pal_h), W - pal_w\n    grid[pr0:pr0 + pal_h, pc0:pc0 + pal_w] = pal\n    occ[max(0, pr0 - 1):min(H, pr0 + pal_h + 1),\n        max(0, pc0 - 1):min(W, pc0 + pal_w + 1)] = True\n\n\ndef _find_valid_positions(H, W, occ, mask, holes):\n    \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n    sh, sw = mask.shape\n    positions = []\n    for r0 in range(H - sh + 1):\n        for c0 in range(W - sw + 1):\n            if occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n                   max(0, c0 - 1):min(W, c0 + sw + 1)].any():\n                continue\n            if any(r0 + hr == 0 or c0 + hc == 0 or r0 + hr == H - 1 or c0 + hc == W - 1\n                   for hpts in holes for hr, hc in hpts):\n                continue\n            positions.append((r0, c0))\n    return positions\n\n\ndef _paint_sprite(grid, r0, c0, mask, color, fill, holes):\n    \"\"\"Render a sprite onto the grid: border cells in color, hole cells in fill (if given).\"\"\"\n    grid[r0:r0 + mask.shape[0], c0:c0 + mask.shape[1]][mask] = color\n    if fill is not None:\n        for hpts in holes:\n            for hr, hc in hpts:\n                grid[r0 + hr, c0 + hc] = fill\n\n\ndef _gen_attempt():\n    rng = random.Random()\n    bg = 0\n\n    # Grid size and palette side\n    H = rng.randint(_GRID_H_MIN, _GRID_H_MAX)\n    W = rng.randint(_GRID_W_MIN, _GRID_W_MAX)\n    side = rng.choice(['top', 'bottom', 'left', 'right'])\n    if H <= _SMALL_H_THRESHOLD and side in ('top', 'bottom') and rng.random() < _SMALL_H_PALETTE_FLIP:\n        side = rng.choice(['left', 'right'])\n\n    max_N = H if side in ('left', 'right') else W\n    N = rng.randint(_PALETTE_N_MIN, min(_PALETTE_N_MAX, max_N))\n\n    # Sprite dimension bounds\n    max_sh = min(_SPRITE_H_MAX, H)\n    max_sw = min(_SPRITE_W_MAX, W)\n    if H <= _TINY_H_THRESHOLD:\n        max_sh = 3\n\n    # Sprite counts\n    num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, N))\n    total_sprites = num_filled + 1\n\n    # Generate sprite shapes\n    shapes = []\n    for _ in range(total_sprites):\n        sh = rng.randint(3, max_sh)\n        sw = rng.randint(3, max_sw)\n        if sh + sw > _SPRITE_DIM_SUM_CAP:\n            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)\n        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:\n            mask = _make_diamond()\n        else:\n            mask = _make_hollow_sprite(sh, sw, rng)\n        if mask is None:\n            return None\n        shapes.append(mask)\n\n    # Colors and palette\n    border_keys, fill_values, distractor_color, mapping, filled_keys = \\\n        _choose_colors(rng, N, num_filled)\n    pal = _build_palette(side, border_keys, fill_values)\n\n    grid = np.full((H, W), bg, dtype=int)\n    occ = np.zeros((H, W), dtype=bool)\n    _place_palette(grid, occ, pal, side, rng)\n\n    # Assign colors to sprites: filled sprites use palette keys, last one is distractor\n    infos = []\n    for i, mask in enumerate(shapes):\n        if i < num_filled:\n            c, f = filled_keys[i], mapping[filled_keys[i]]\n        else:\n            c, f = distractor_color, None\n        infos.append((mask, c, f))\n\n    # Place sprites\n    placed = []\n    for mask, color, fill in infos:\n        holes = _get_enclosed_holes(mask)\n        positions = _find_valid_positions(H, W, occ, mask, holes)\n        if not positions:\n            return None\n        r0, c0 = rng.choice(positions)\n        _paint_sprite(grid, r0, c0, mask, color, fill, holes)\n        placed.append((r0, c0, mask, fill))\n        sh, sw = mask.shape\n        occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n            max(0, c0 - 1):min(W, c0 + sw + 1)] = True\n\n    # Derive input from output by clearing filled holes\n    output = grid.copy()\n    inp = grid.copy()\n    for r0, c0, mask, fill in placed:\n        if fill is not None:\n            for hpts in _get_enclosed_holes(mask):\n                for hr, hc in hpts:\n                    inp[r0 + hr, c0 + hc] = bg\n\n    # Validate bg is dominant on border\n    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    if int(vals[cnts.argmax()]) != bg:\n        return None\n\n    # Oracle check\n    try:\n        if np.array_equal(main(inp), output):\n            return inp\n    except Exception:\n        pass\n    return None\n\n\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom arc_utils import get_bg, in_bounds, neighbors4, label_mask\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect framed squares via colored bridges following a control-pixel sequence.\n\n    Input structure:\n    - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.\n    - Control row below squares: colored pixels read left-to-right encode visitation order.\n\n    Rule:\n    - Start at the square matching first control color c0.\n    - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.\n    - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.\n\n    Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # border color = most common non-bg color\n    cnt = Counter(map(int, g.flatten()))\n    border = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            border = int(col)\n            break\n    assert not (border is None)\n\n    # detect framed squares as connected components of the border color\n    lab, n = label_mask(g == int(border), connectivity=4)\n    frames: list[dict] = []\n    for cid in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(cid))\n        if int(pts.shape[0]) < 8:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        if h < 3 or w < 3:\n            continue\n\n        t = None\n        inner_col = None\n        for tt in range(1, int(min(h, w) // 2) + 1):\n            inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]\n            if inner.size == 0:\n                continue\n            if bool((inner == int(border)).any()):\n                continue\n            u = set(map(int, inner.flatten()))\n            if len(u) != 1:\n                continue\n\n            ok = True\n            if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not ok:\n                continue\n\n            t = int(tt)\n            inner_col = int(next(iter(u)))\n            break\n\n        if t is None or inner_col is None:\n            continue\n\n        frames.append(\n            {\n                \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n                \"t\": int(t),\n                \"inner\": int(inner_col),\n                \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            }\n        )\n\n    assert not (not frames)\n\n    by: dict[int, list[dict]] = defaultdict(list)\n    for f in frames:\n        by[int(f[\"inner\"])].append(f)\n\n    max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n\n    # control row = bottom-most row below the squares with >=2 non-bg pixels\n    ctrl_r = None\n    for r in range(int(H - 1), int(max_frame_r), -1):\n        if int((g[int(r)] != int(bg)).sum()) >= 2:\n            ctrl_r = int(r)\n            break\n    assert not (ctrl_r is None)\n\n    ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n    assert not (len(ctrl) < 2)\n\n    def center(f: dict) -> tuple[int, int]:\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        return int((r0 + r1) // 2), int((c0 + c1) // 2)\n\n    def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n        a = f1[\"inner_bbox\"]\n        b = f2[\"inner_bbox\"]\n        same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n        same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))\n        return same_row, same_col\n\n    # choose start frame\n    start_color = int(ctrl[0])\n    assert not (start_color not in by)\n    start_cands = by[start_color]\n    if len(start_cands) == 1:\n        cur = start_cands[0]\n    else:\n        nxt_color = int(ctrl[1])\n        nxt_cands = by.get(nxt_color, [])\n        best = None\n        bestf = None\n        for f in start_cands:\n            for g2 in (nxt_cands if nxt_cands else [f]):\n                sr, sc = aligned(f, g2)\n                al = 1 if (sr or sc) else 0\n                (r1_, c1_) = center(f)\n                (r2_, c2_) = center(g2)\n                d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n                cand = (int(al), -int(d))\n                if best is None or cand > best:\n                    best = cand\n                    bestf = f\n        cur = bestf\n\n    out = g.copy()\n\n    def draw_bridge(fa: dict, fb: dict, color: int) -> None:\n        (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n        (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n        ia = fa[\"inner_bbox\"]\n        sr, sc = aligned(fa, fb)\n        if sr:\n            rr0, rr1 = int(ia[0]), int(ia[2])\n            if int(c1a) < int(c0b):\n                cc0, cc1 = int(c1a + 1), int(c0b - 1)\n            else:\n                cc0, cc1 = int(c1b + 1), int(c0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n            return\n        if sc:\n            cc0, cc1 = int(ia[1]), int(ia[3])\n            if int(r1a) < int(r0b):\n                rr0, rr1 = int(r1a + 1), int(r0b - 1)\n            else:\n                rr0, rr1 = int(r1b + 1), int(r0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n\n    for i in range(int(len(ctrl)) - 1):\n        a = int(ctrl[i])\n        b = int(ctrl[i + 1])\n        assert int(cur[\"inner\"]) == int(a)\n        assert b in by, f\"control color {b} has no matching frame\"\n        cands = by[b]\n        best = None\n        bestf = None\n        for f in cands:\n            sr, sc = aligned(cur, f)\n            al = 1 if (sr or sc) else 0\n            (r1_, c1_) = center(cur)\n            (r2_, c2_) = center(f)\n            d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n            cand = (int(al), -int(d))\n            if best is None or cand > best:\n                best = cand\n                bestf = f\n        nxt = bestf\n        draw_bridge(cur, nxt, int(a))\n        cur = nxt\n\n    return out\n\n\ndef _most_common_nonbg(g: np.ndarray, bg: int) -> int | None:\n    cnt = Counter(map(int, g.flatten()))\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            return int(col)\n    return None\n\ndef _draw_frame(g: np.ndarray, *, r0: int, c0: int, outer: int, t: int, border: int, inner_col: int) -> None:\n    g[int(r0) : int(r0 + outer), int(c0) : int(c0 + outer)] = int(border)\n    g[int(r0 + t) : int(r0 + outer - t), int(c0 + t) : int(c0 + outer - t)] = int(inner_col)\n\ndef _bridge_cells(fa: dict, fb: dict) -> set[tuple[int, int]]:\n    (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n    (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n    ia = fa[\"inner_bbox\"]\n    ib = fb[\"inner_bbox\"]\n    # same-row band\n    if int(ia[0]) == int(ib[0]) and int(ia[2]) == int(ib[2]):\n        rr0, rr1 = int(ia[0]), int(ia[2])\n        if int(c1a) < int(c0b):\n            cc0, cc1 = int(c1a + 1), int(c0b - 1)\n        else:\n            cc0, cc1 = int(c1b + 1), int(c0a - 1)\n        assert int(cc0) <= int(cc1), \"horizontal bridge gap must be non-empty\"\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"agent_message","text":"参考题里有几个明显的共性：`main()` 都先做严格对象识别和断言，`generate_input()` 则普遍采用“先构造期望输出，再反推输入，再用 `main()` 回验”的策略，并通过重试避免退化样例。下面我补读剩下几个没展开到的 `main()`/`generate_input()` 片段，然后直接落代码。"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '261,760p' /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '261,760p' /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble and place enlarged sprites on a canvas using legend-panel instructions.\n\n    Input structure:\n    - Color-6 separators divide the grid into a left legend column and a main canvas.\n    - Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.\n\n    Rule:\n    - Tile the unit sprite into each active cell of the frame to build an enlarged composite.\n    - Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).\n    - Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.\n\n    Key insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    assert w >= 2, \"grid width must be >= 2\"\n\n    # Output canvas is the region between the left separator run and (optionally) a\n    # right-side separator run near the far edge (right legend panel).\n    left_sep, right_sep = _split_canvas(g)\n    left_sep_c1 = left_sep[1]\n    canvas_c0 = left_sep_c1 + 1\n    canvas_c1 = right_sep[0] if right_sep is not None else w\n    main = g[:, canvas_c0:canvas_c1].copy()\n\n    # Paint one constructed sprite per marker panel that lies outside the output canvas.\n    marker_squares = _all_marker_panel_squares(g)\n    assert marker_squares, \"no marker panel found\"\n\n    # Anchor alignment (ignore internal full-height/full-width 6 separators inside main).\n    eff_h, eff_w = main.shape\n    full6_cols = [c for c in range(eff_w) if np.all(main[:, c] == 6)]\n    if full6_cols:\n        eff_w = min(full6_cols)\n    full6_rows = [r for r in range(eff_h) if np.all(main[r, :] == 6)]\n    if full6_rows:\n        eff_h = min(full6_rows)\n\n    out = main.copy()\n    composite_written = np.zeros(out.shape, dtype=bool)\n\n    for marker_r0, marker_c0 in marker_squares:\n        # Ignore marker panels inside the output canvas; only legends should drive drawing.\n        if canvas_c0 <= marker_c0 < canvas_c1:\n            continue\n\n        if marker_c0 + 5 > w:\n            continue\n        panel = g[:, marker_c0 : marker_c0 + 5]\n\n        unit = _extract_unit_sprite(panel)\n        if unit is None:\n            continue\n        unit_sprite, unit_bb = unit\n\n        frame_bb = _extract_frame_bbox(panel, unit_bb, marker_r0)\n        if frame_bb is None:\n            continue\n        fr0, fc0, fr1, fc1 = frame_bb\n        frame = panel[fr0 : fr1 + 1, fc0 : fc1 + 1]\n        frame_mask0 = (frame != 0) & (frame != 6)\n        _, n8 = _scipy_label(frame_mask0, structure=np.ones((3, 3)))\n        assert n8 == 1, f\"frame must be 8-connected, got {n8} components\"\n\n        # Rotate layout according to clockhand.\n        dir_k = _rotation_from_clockhand(g, marker_r0, marker_c0)  # up=0, right=1, down=2, left=3\n        frame_mask = np.rot90(frame_mask0, (-dir_k) % 4)\n\n        # Build composite by tiling the unit sprite into active frame cells.\n        m_unit = (unit_sprite != 0) & (unit_sprite != 6)\n        uh, uw = unit_sprite.shape\n        fh, fw = frame_mask.shape\n        comp = np.zeros((fh * uh, fw * uw), dtype=int)\n        for i in range(fh):\n            for j in range(fw):\n                if not frame_mask[i, j]:\n                    continue\n                rr0 = i * uh\n                cc0 = j * uw\n                comp[rr0 : rr0 + uh, cc0 : cc0 + uw][m_unit] = unit_sprite[m_unit]\n\n        pos = _position_indices_from_border_square(g, marker_r0, marker_c0)\n        if pos is None:\n            continue\n        pr, pc = pos\n\n        top = _anchor_to_top_left(pr, eff_h, comp.shape[0])\n        left = _anchor_to_top_left(pc, eff_w, comp.shape[1])\n\n        ch, cw = comp.shape\n        for r in range(ch):\n            rr = top + r\n            assert 0 <= rr < out.shape[0], \"sprite row out of canvas bounds\"\n            for c in range(cw):\n                cc = left + c\n                assert 0 <= cc < out.shape[1], \"sprite col out of canvas bounds\"\n                if out[rr, cc] == 6:\n                    continue\n                val = int(comp[r, c])\n                if val != 0 and val != 6:\n                    assert not composite_written[rr, cc], \"composites must not overlap\"\n                    composite_written[rr, cc] = True\n                    out[rr, cc] = val\n    return out\n\n# --------------- generator (refine_8conn_fill_overlap) ---------------\n\n# ── CFG: tunable generation parameters ──────────────────────────────\nGRID_H_RANGE = (20, 30)         # output grid height\nGRID_W = 30                     # output grid width (fixed)\nLEGEND_COUNT_WEIGHTS = [1, 4]   # weights for [1-legend, 2-legend]\nUNIT_SIZE_RANGE = (2, 5)        # NxN unit sprite side length\nMIN_CANVAS_W = 8                # reject if canvas narrower than this\nFRAME_H_RANGE = (4, 9)          # frame mask height (before rotation)\nFRAME_W_RANGE = (3, 6)          # frame mask width  (before rotation)\nFRAME_DENSITY = 0.5             # density for random_sprite frame generation\nBAND_WIDTH_MIN = 4              # minimum band width for canvas background\nMARKER_PANEL_HEIGHT = 8         # marker square (5) + rotation patch (3)\nUSABLE_COLORS = [1, 2, 3, 4, 5, 7, 8, 9]  # all colors except 0 (bg) and 6 (separator)\nROTATION_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up/right/down/left clock-hand offsets\nGEN_RETRIES = 300               # max attempts in generate_input\n\n\ndef _allocate_colors(num_legends):\n    \"\"\"Pick unit colors (2 per legend), 2 background colors, and 1 frame color per legend.\"\"\"\n    pool = list(USABLE_COLORS)\n    random.shuffle(pool)\n\n    unit_color_sets = []\n    used_unit = set()\n    for _ in range(num_legends):\n        if len(pool) < 2:\n            return None\n        c1, c2 = pool.pop(), pool.pop()\n        unit_color_sets.append((c1, c2))\n        used_unit.update([c1, c2])\n\n    bg_cands = [c for c in pool if c not in used_unit]\n    if len(bg_cands) < 2:\n        return None\n    random.shuffle(bg_cands)\n    bg_colors = (bg_cands[0], bg_cands[1])\n\n    frame_colors = []\n    all_set = set(USABLE_COLORS)\n    for uc in unit_color_sets:\n        candidates = list(all_set - set(uc))\n        frame_colors.append(random.choice(candidates))\n\n    return unit_color_sets, bg_colors, frame_colors\n\n\ndef _color_swap(sprite, c1, c2):\n    \"\"\"Return a copy of sprite with the two colors swapped.\"\"\"\n    sa, sb = sorted([c1, c2])\n    out = sprite.copy()\n    out[sprite == sa] = sb\n    out[sprite == sb] = sa\n    return out\n\n\ndef _design_legend(leg, unit_colors, frame_color, marker_r0, grid_h, canvas_w):\n    \"\"\"Fill in sprite, frame, and rotation for one legend dict. Returns False on failure.\"\"\"\n    N = leg[\"N\"]\n    uc1, uc2 = unit_colors\n\n    # Unit sprite: NxN, fully filled, exactly 2 colors\n    sprite = np.full((N, N), uc1, dtype=int)\n    num_c2 = random.randint(1, N * N - 1)\n    for p in random.sample(range(N * N), num_c2):\n        sprite[p // N, p % N] = uc2\n\n    legend_sprite = _color_swap(sprite, uc1, uc2)\n\n    avail = marker_r0 - (N + 1)\n    # Enumerate valid (frame_H, frame_W, rot_k) combos\n    combos = []\n    for fH in range(*FRAME_H_RANGE):\n        if avail < fH + 1:\n            continue\n        for fW in range(*FRAME_W_RANGE):\n            for rk in range(4):\n                rh, rw = (fH, fW) if rk % 2 == 0 else (fW, fH)\n                if rh * N <= grid_h and rw * N <= canvas_w:\n                    combos.append((fH, fW, rk))\n    if not combos:\n        return False\n    frame_H, frame_W, rot_k = random.choice(combos)\n\n    frame_mask = random_sprite(\n        frame_H, frame_W, density=FRAME_DENSITY, connectivity=8,\n        color_palette=[1], symmetry=\"not_symmetric\"\n    ) != 0\n    rot_frame = np.rot90(frame_mask, (-rot_k) % 4)\n\n    leg.update(sprite=sprite, legend_sprite=legend_sprite, frame_mask=frame_mask,\n               frame_H=frame_H, frame_W=frame_W, frame_color=frame_color,\n               rot_k=rot_k, rotated_frame=rot_frame)\n    return True\n\n\ndef _comp_size(leg):\n    \"\"\"Return (height, width) of the composite after rotation.\"\"\"\n    rf = leg[\"rotated_frame\"]\n    N = leg[\"N\"]\n    return rf.shape[0] * N, rf.shape[1] * N\n\n\ndef _assign_anchors(legends, grid_h, canvas_w):\n    \"\"\"Assign anchor positions to legends, avoiding overlap for 2-legend case. Returns False on failure.\"\"\"\n    if len(legends) == 1:\n        pr, pc = random.randint(0, 2), random.randint(0, 2)\n        ch, cw = _comp_size(legends[0])\n        legends[0].update(pr=pr, pc=pc,\n                          comp_top=_anchor_to_top_left(pr, grid_h, ch),\n                          comp_left=_anchor_to_top_left(pc, canvas_w, cw))\n        return True\n\n    a, b = legends[0], legends[1]\n    a_ch, a_cw = _comp_size(a)\n    b_ch, b_cw = _comp_size(b)\n    valid_pairs = []\n    for apr in range(3):\n        for apc in range(3):\n            at = _anchor_to_top_left(apr, grid_h, a_ch)\n            al = _anchor_to_top_left(apc, canvas_w, a_cw)\n            if at < 0 or al < 0 or at + a_ch > grid_h or al + a_cw > canvas_w:\n                continue\n            for bpr in range(3):\n                for bpc in range(3):\n                    bt = _anchor_to_top_left(bpr, grid_h, b_ch)\n                    bl = _anchor_to_top_left(bpc, canvas_w, b_cw)\n                    if bt < 0 or bl < 0 or bt + b_ch > grid_h or bl + b_cw > canvas_w:\n                        continue\n                    # Reject overlapping bounding boxes\n                    if at < bt + b_ch and bt < at + a_ch and al < bl + b_cw and bl < al + a_cw:\n                        continue\n                    valid_pairs.append((apr, apc, at, al, bpr, bpc, bt, bl))\n    if not valid_pairs:\n        return False\n    apr, apc, at, al, bpr, bpc, bt, bl = random.choice(valid_pairs)\n    a.update(pr=apr, pc=apc, comp_top=at, comp_left=al)\n    b.update(pr=bpr, pc=bpc, comp_top=bt, comp_left=bl)\n    return True\n\n\ndef _build_banded_canvas(grid_h, canvas_w, bg1, bg2):\n    \"\"\"Build a canvas with alternating horizontal or vertical color bands.\"\"\"\n    canvas = np.zeros((grid_h, canvas_w), dtype=int)\n    band_dir = random.choice([\"h\", \"v\"])\n    dim = grid_h if band_dir == \"h\" else canvas_w\n    bw = random.randint(BAND_WIDTH_MIN, max(BAND_WIDTH_MIN, dim // 2))\n    band_indices = np.arange(dim) // bw % 2\n    colors = np.array([bg1, bg2])\n    if band_dir == \"h\":\n        canvas[:] = colors[band_indices][:, None]\n    else:\n        canvas[:] = colors[band_indices][None, :]\n    return canvas\n\n\ndef _overlay_composites(canvas, legends):\n    \"\"\"Stamp each legend's tiled composite onto the canvas (non-{0,6} pixels overwrite).\"\"\"\n    output = canvas.copy()\n    for leg in legends:\n        sp, rf = leg[\"sprite\"], leg[\"rotated_frame\"]\n        N = leg[\"N\"]\n        t, l = leg[\"comp_top\"], leg[\"comp_left\"]\n        fh, fw = rf.shape\n\n        # Build full composite by tiling the unit sprite into active frame cells\n        comp = np.zeros((fh * N, fw * N), dtype=int)\n        sprite_mask = (sp != 0) & (sp != 6)\n        for i in range(fh):\n            for j in range(fw):\n                if rf[i, j]:\n                    r0, c0 = i * N, j * N\n                    comp[r0:r0 + N, c0:c0 + N][sprite_mask] = sp[sprite_mask]\n\n        # Overwrite canvas where composite has content and canvas isn't color 6\n        region = output[t:t + fh * N, l:l + fw * N]\n        write_mask = (comp != 0) & (region != 6)\n        region[write_mask] = comp[write_mask]\n    return output\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    grid_h = random.randint(*GRID_H_RANGE)\n    num_legends = random.choices([1, 2], weights=LEGEND_COUNT_WEIGHTS)[0]\n\n    # Per legend: pick N, compute legend_w\n    legends = []\n    for _ in range(num_legends):\n        N = random.randint(*UNIT_SIZE_RANGE)\n        legends.append({\"N\": N, \"legend_w\": N + 2})\n\n    # Layout widths\n    left_lw = legends[0][\"legend_w\"]\n    left_total = left_lw + 1  # legend + 1 separator col\n    right_total = (1 + legends[1][\"legend_w\"]) if num_legends == 2 else 0\n    canvas_w = GRID_W - left_total - right_total\n    if canvas_w < MIN_CANVAS_W:\n        return None\n\n    # Color allocation\n    colors = _allocate_colors(num_legends)\n    if colors is None:\n        return None\n    unit_color_sets, (bg1, bg2), frame_colors = colors\n\n    marker_r0 = grid_h - MARKER_PANEL_HEIGHT\n\n    # Design each legend panel\n    for li in range(num_legends):\n        if not _design_legend(legends[li], unit_color_sets[li], frame_colors[li],\n                              marker_r0, grid_h, canvas_w):\n            return None\n\n    # Assign anchor positions\n    if not _assign_anchors(legends, grid_h, canvas_w):\n        return None\n\n    # Build canvas and overlay composites\n    canvas = _build_banded_canvas(grid_h, canvas_w, bg1, bg2)\n    output = _overlay_composites(canvas, legends)\n\n    # Assemble input grid\n    grid = np.zeros((grid_h, GRID_W), dtype=int)\n    canvas_c0 = left_total\n    grid[:, canvas_c0:canvas_c0 + canvas_w] = canvas\n\n    _place_legend(grid, legends[0], col_start=0, sep_col=left_lw,\n                  marker_r0=marker_r0, is_right=False)\n    if num_legends == 2:\n        r_sep = canvas_c0 + canvas_w\n        _place_legend(grid, legends[1], col_start=r_sep + 1, sep_col=r_sep,\n                      marker_r0=marker_r0, is_right=True)\n\n    # Validate via solver\n    try:\n        if np.array_equal(main(grid), output):\n            return grid\n    except Exception:\n        pass\n    return None\n\n\ndef _place_legend(grid, leg, col_start, sep_col, marker_r0, is_right):\n    \"\"\"Draw one legend panel (separator, marker square, rotation patch, sprite, frame).\"\"\"\n    N = leg[\"N\"]\n    grid[:, sep_col] = 6\n\n    # Marker square column: sprite at col_start+1 must fit within the 5-wide panel\n    mc0 = (col_start + max(0, N - 4)) if not is_right else (sep_col + max(0, N - 3))\n\n    # 5x5 border-6 marker square\n    grid[marker_r0:marker_r0 + 5, mc0:mc0 + 5] = 0\n    grid[marker_r0, mc0:mc0 + 5] = 6\n    grid[marker_r0 + 4, mc0:mc0 + 5] = 6\n    grid[marker_r0:marker_r0 + 5, mc0] = 6\n    grid[marker_r0:marker_r0 + 5, mc0 + 4] = 6\n    grid[marker_r0 + 1 + leg[\"pr\"], mc0 + 1 + leg[\"pc\"]] = 4\n\n    # Rotation patch: 3x5 block with 6-borders on cols 0,4 and 3x3 clock-hand inside\n    rr0 = marker_r0 + 5\n    grid[rr0:rr0 + 3, mc0:mc0 + 5] = 0\n    grid[rr0:rr0 + 3, mc0] = 6\n    grid[rr0:rr0 + 3, mc0 + 4] = 6\n    cx_r, cx_c = rr0 + 1, mc0 + 2\n    dr, dc = ROTATION_DIRS[leg[\"rot_k\"]]\n    grid[cx_r, cx_c] = 7\n    grid[cx_r + dr, cx_c + dc] = 7\n\n    # Unit sprite at row 1\n    sp_col = col_start + 1 - mc0\n    grid[1:1 + N, mc0 + sp_col:mc0 + sp_col + N] = leg[\"legend_sprite\"]\n\n    # Frame mask between unit sprite bottom and marker top\n    fH, fW = leg[\"frame_H\"], leg[\"frame_W\"]\n    avail = marker_r0 - (N + 1)\n    gap = random.randint(1, max(1, avail - fH))\n    fr_start = N + 1 + gap\n    f_col = random.randint(0, max(0, 4 - fW))\n    frame_region = grid[fr_start:fr_start + fH, mc0 + f_col:mc0 + f_col + fW]\n    frame_region[leg[\"frame_mask\"]] = leg[\"frame_color\"]\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
