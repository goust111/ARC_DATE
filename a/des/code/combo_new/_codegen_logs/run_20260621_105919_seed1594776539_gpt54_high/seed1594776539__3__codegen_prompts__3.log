{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/3bd292e8.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import defaultdict, deque\n\nimport numpy as np\n\nfrom arc_utils import Color, get_bg, label_mask, neighbors4\nimport itertools\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor wall-separated background regions alternately, starting with grey in the lower-left region.\n\n    Input structure\n    - The grid has one dominant background color and one foreground wall color.\n    - The wall pixels form one or more 4-connected one-cell-thick segments.\n    - Each wall segment separates exactly two 4-connected background regions.\n    Rule\n    - Keep all wall pixels unchanged.\n    - Label the 4-connected background regions and connect two labels when they\n      touch opposite sides of the same wall segment.\n    - Color the region containing the lower-left corner grey, then flip between\n      grey and green across every wall adjacency.\n    Key insight\n    - The red walls define a bipartite map of regions; the lower-left background\n      region fixes which side of the alternating coloring is grey.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    H, W = g.shape\n\n    colors = set(map(int, g.flat))\n    assert len(colors) == 2, \"expected exactly one background color and one wall color\"\n    bg = get_bg(g)\n    wall_colors = colors - {int(bg)}\n    assert len(wall_colors) == 1\n    wall = int(next(iter(wall_colors)))\n\n    bg_lab, n_regions = label_mask(g == int(bg), connectivity=4)\n    assert n_regions >= 2, \"walls must split the background into multiple regions\"\n    start_region = int(bg_lab[H - 1, 0])\n    assert start_region > 0, \"lower-left corner must belong to a background region\"\n\n    wall_lab, n_walls = label_mask(g == wall, connectivity=4)\n    assert n_walls >= 1\n\n    graph: dict[int, set[int]] = defaultdict(set)\n    for wall_id in range(1, n_walls + 1):\n        adjacent_regions: set[int] = set()\n        for r, c in np.argwhere(wall_lab == wall_id):\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W:\n                    region_id = int(bg_lab[rr, cc])\n                    if region_id > 0:\n                        adjacent_regions.add(region_id)\n\n        assert len(adjacent_regions) == 2, \"each wall segment must separate exactly two regions\"\n        a, b = tuple(adjacent_regions)\n        graph[a].add(b)\n        graph[b].add(a)\n\n    parity = {start_region: 0}\n    queue = deque([start_region])\n    while queue:\n        region = queue.popleft()\n        for neighbor in graph[region]:\n            neighbor_parity = 1 - parity[region]\n            if neighbor in parity:\n                assert parity[neighbor] == neighbor_parity, \"region graph must be bipartite\"\n            else:\n                parity[neighbor] = neighbor_parity\n                queue.append(neighbor)\n\n    assert set(parity) == set(range(1, n_regions + 1)), \"all background regions must be wall-connected\"\n\n    out = g.copy()\n    for region_id, region_parity in parity.items():\n        out[bg_lab == region_id] = Color.GREY if region_parity == 0 else Color.GREEN\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Grid, colors, and retry policy.\nGRID_SIZES = (7, 8, 9)\nGRID_SIZES_FOR_THREE_WALLS = (8, 9)\nWALL_COUNT_RANGE = (1, 3)\nMAX_GENERATION_ATTEMPTS = 300\nBACKGROUND_COLOR = Color.ORANGE\nWALL_COLOR = Color.RED\n\n# Wall geometry constraints.\nWALL_LENGTH_RANGE = (4, 13)\nWALL_TURN_RANGE = (1, 5)\nENDPOINT_SPACING = 2\nMAX_STAIR_PARTS = 3\nMIN_FIRST_STAIR_COL = 1\n\n# Left-right corridor layout.\nLR_LAYOUT_MAX_WALLS = 2\nLR_LAYOUT_PROBABILITY = 0.55\nLR_TURN_OPTIONS = (2, 4)\nLR_CORRIDOR_MAX_SPAN = 3\nLR_CORRIDOR_GAP = 2\n\n# Canonical grids are randomly mapped through one of eight dihedral transforms.\nTRANSFORM_OPS = 8\n\n\ndef _contains(bounds: tuple[int, int], value: int) -> bool:\n    lo, hi = bounds\n    return lo <= int(value) <= hi\n\n\ndef _paint_wall_path(grid: np.ndarray, cells: list[tuple[int, int]]) -> bool:\n    for r, c in cells:\n        if grid[r, c] != BACKGROUND_COLOR:\n            return False\n        grid[r, c] = WALL_COLOR\n    return True\n\n\ndef _split_positive(total: int, parts: int) -> list[int]:\n    if parts == 1:\n        return [int(total)]\n    cuts = sorted(random.sample(range(1, int(total)), int(parts) - 1))\n    return [b - a for a, b in zip([0] + cuts, cuts + [int(total)])]\n\n\ndef _spaced_combos(values: list[int], n: int) -> list[tuple[int, ...]]:\n    return [\n        combo\n        for combo in itertools.combinations(values, n)\n        if all(combo[i + 1] - combo[i] >= ENDPOINT_SPACING for i in range(len(combo) - 1))\n    ]\n\n\ndef _choose_endpoints(H: int, W: int, n_walls: int) -> tuple[tuple[int, ...], tuple[int, ...]] | None:\n    rows = _spaced_combos(list(range(1, H - 1)), n_walls)\n    cols = _spaced_combos(list(range(1, W - 1)), n_walls)\n    valid: list[tuple[tuple[int, ...], tuple[int, ...]]] = []\n    for start_rows in rows:\n        for cols_asc in cols:\n            end_cols = tuple(reversed(cols_asc))\n            lengths = [c + (H - 1 - r) + 1 for r, c in zip(start_rows, end_cols)]\n            if all(_contains(WALL_LENGTH_RANGE, length) for length in lengths):\n                valid.append((start_rows, end_cols))\n    return random.choice(valid) if valid else None\n\n\ndef _stair_path_lb(H: int, W: int, start_r: int, end_c: int, min_first_col: int) -> list[tuple[int, int]] | None:\n    down = H - 1 - int(start_r)\n    right = int(end_c)\n    max_parts = min(MAX_STAIR_PARTS, down, right)\n    feasible = [k for k in range(1, max_parts + 1) if right >= int(min_first_col) + k - 1]\n    if not feasible:\n        return None\n    weights = [k * k for k in feasible]\n    k = random.choices(feasible, weights=weights, k=1)[0]\n\n    if k == 1:\n        horiz = [right]\n    else:\n        first = random.randint(int(min_first_col), right - (k - 1))\n        horiz = [first] + _split_positive(right - first, k - 1)\n    vert = _split_positive(down, k)\n\n    r, c = int(start_r), 0\n    cells = [(r, c)]\n    for h_run, v_run in zip(horiz, vert):\n        for _ in range(h_run):\n            c += 1\n            cells.append((r, c))\n        for _ in range(v_run):\n            r += 1\n            cells.append((r, c))\n\n    if (r, c) != (H - 1, int(end_c)):\n        return None\n    return cells\n\n\ndef _build_lower_left_grid(H: int, W: int, n_walls: int) -> np.ndarray | None:\n    endpoints = _choose_endpoints(H, W, n_walls)\n    if endpoints is None:\n        return None\n    start_rows, end_cols = endpoints\n\n    grid = np.full((H, W), BACKGROUND_COLOR, dtype=int)\n    for i, (start_r, end_c) in enumerate(zip(start_rows, end_cols)):\n        min_first_col = end_cols[i + 1] + ENDPOINT_SPACING if i + 1 < n_walls else MIN_FIRST_STAIR_COL\n        cells = _stair_path_lb(H, W, start_r, end_c, min_first_col)\n        if cells is None or not _paint_wall_path(grid, cells):\n            return None\n    return grid\n\n\ndef _choose_lr_corridors(H: int, n_walls: int) -> tuple[tuple[int, int], ...] | None:\n    intervals = []\n    for lo in range(1, H - 2):\n        for hi in range(lo + 1, min(H - 2, lo + LR_CORRIDOR_MAX_SPAN) + 1):\n            intervals.append((lo, hi))\n    valid: list[tuple[tuple[int, int], ...]] = []\n    for combo in itertools.combinations(intervals, n_walls):\n        if all(combo[i][1] + LR_CORRIDOR_GAP <= combo[i + 1][0] for i in range(n_walls - 1)):\n            valid.append(combo)\n    return random.choice(valid) if valid else None\n\n\ndef _lr_path(W: int, lo: int, hi: int) -> list[tuple[int, int]] | None:\n    short_turn, long_turn = LR_TURN_OPTIONS\n    turn_goal = random.choice(LR_TURN_OPTIONS)\n    if turn_goal == long_turn and W - 1 < long_turn:\n        turn_goal = short_turn\n\n    if turn_goal == short_turn:\n        h1 = random.randint(1, W - 2)\n        horiz = [h1, W - 1 - h1]\n        r0, r1 = random.sample(range(lo, hi + 1), 2)\n        rows = [r0, r1]\n    else:\n        if hi - lo >= 2:\n            if random.random() < 0.5:\n                rows = [lo, random.randint(lo + 1, hi - 1), hi]\n            else:\n                rows = [hi, random.randint(lo + 1, hi - 1), lo]\n            middle_min = 1\n        else:\n            rows = [lo, hi, lo] if random.random() < 0.5 else [hi, lo, hi]\n            middle_min = 2\n        if W - 1 < middle_min + 2:\n            return None\n        h2 = random.randint(middle_min, W - 3)\n        h1 = random.randint(1, W - 1 - h2 - 1)\n        horiz = [h1, h2, W - 1 - h1 - h2]\n\n    r, c = int(rows[0]), 0\n    cells = [(r, c)]\n    for i, h_run in enumerate(horiz):\n        for _ in range(h_run):\n            c += 1\n            cells.append((r, c))\n        if i < len(rows) - 1:\n            target = int(rows[i + 1])\n            step = 1 if target > r else -1\n            while r != target:\n                r += step\n                cells.append((r, c))\n\n    if c != W - 1:\n        return None\n    if not _contains(WALL_LENGTH_RANGE, len(cells)):\n        return None\n    return cells\n\n\ndef _build_lr_grid(H: int, W: int, n_walls: int) -> np.ndarray | None:\n    corridors = _choose_lr_corridors(H, n_walls)\n    if corridors is None:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py\"","aggregated_output":"import numpy as np\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Shear the rectangular input down-left onto a black canvas.\n\n    Input structure\n    A rectangular grid of colored pixels with no internal empty region to infer.\n\n    Rule\n    Create a black output with the same height and width W + H - 1, then copy\n    each input row r unchanged starting at column H - 1 - r.\n\n    Key insight\n    The colors and row contents are preserved; only the row offsets change so\n    the left edge forms a descending diagonal.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    out = np.zeros((h, w + h - 1), dtype=int)\n    for r in range(h):\n        start = h - 1 - r\n        out[r, start : start + w] = g[r]\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and palette bounds.\nMIN_HEIGHT, MAX_HEIGHT = 2, 10\nMIN_WIDTH, MAX_WIDTH = 1, 9\nMIN_COLOR_COUNT, MAX_COLOR_COUNT = 4, 5\nMAX_CELLS, MAX_OUTPUT_WIDTH = 36, 30\nPALETTE_VALUES = range(1, 10)\n\n# Fill pattern controls.\nFILL_MODES = (\"noise\", \"row_runs\", \"column_bands\", \"diagonal_bands\")\nMAX_ROW_RUN_CUTS = 3\nCOLUMN_NOISE_PROB = 0.5\nMIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND = 1, 3\nDIAGONAL_FLIP_PROB = 0.5\n\n# Generation safety.\nGENERATION_RETRIES = 300\n\n\ndef _ensure_palette_coverage(arr, palette):\n    positions = random.sample(range(arr.size), len(palette))\n    rows, cols = np.divmod(positions, arr.shape[1])\n    arr[rows, cols] = palette\n\n\ndef _fill_grid(h, w, palette):\n    k = len(palette)\n    mode = random.choice(FILL_MODES)\n    arr = np.zeros((h, w), dtype=int)\n\n    if mode == \"noise\":\n        arr[:] = np.random.choice(palette, size=(h, w))\n    elif mode == \"row_runs\":\n        for r in range(h):\n            cuts = sorted(random.sample(range(1, w), random.randint(0, min(w - 1, MAX_ROW_RUN_CUTS)))) if w > 1 else []\n            starts = [0] + cuts\n            ends = cuts + [w]\n            last = None\n            for c0, c1 in zip(starts, ends):\n                choices = [c for c in palette if c != last] or list(palette)\n                last = random.choice(choices)\n                arr[r, c0:c1] = last\n    elif mode == \"column_bands\":\n        for c in range(w):\n            arr[:, c] = random.choice(palette)\n        if random.random() < COLUMN_NOISE_PROB:\n            for r in range(h):\n                arr[r, random.randrange(w)] = random.choice(palette)\n    else:\n        band = random.randint(MIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND)\n        phase = random.randrange(k)\n        rows, cols = np.indices((h, w))\n        arr[:] = np.asarray(palette)[((rows + cols) // band + phase) % k]\n        if random.random() < DIAGONAL_FLIP_PROB:\n            arr = np.fliplr(arr)\n\n    _ensure_palette_coverage(arr, palette)\n    return arr\n\n\ndef _gen_attempt():\n    k = random.randint(MIN_COLOR_COUNT, MAX_COLOR_COUNT)\n    h = random.randint(MIN_HEIGHT, MAX_HEIGHT)\n    widths = [\n        w\n        for w in range(MIN_WIDTH, MAX_WIDTH + 1)\n        if h * w >= k and h * w <= MAX_CELLS and w + h - 1 <= MAX_OUTPUT_WIDTH\n    ]\n    if not widths:\n        return None\n    w = random.choice(widths)\n    palette = random.sample(PALETTE_VALUES, k)\n    return _fill_grid(h, w, palette)\n\n\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/fc4aaf52.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/fc4aaf52.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg\nimport random\n\n\ndef _swapped_values(values: np.ndarray, color_a: int, color_b: int) -> np.ndarray:\n    out = values.copy()\n    out[values == int(color_a)] = int(color_b)\n    out[values == int(color_b)] = int(color_a)\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Split the two-color object horizontally, swap its colors, and slide the upper half to the right.\n\n    Input structure:\n    - The grid has one background color and exactly two foreground colors.\n    - All foreground pixels form one 4-connected object with an even-height bbox.\n    - The object has foreground pixels on both rows adjacent to its horizontal midpoint.\n\n    Rule:\n    - Split the object into upper and lower halves at the midpoint of its bbox.\n    - Swap the two foreground colors in both halves.\n    - Keep the lower half in place and shift the upper half right until its lower-left\n      boundary pixel is diagonally adjacent to the lower half's upper-right boundary pixel.\n\n    Key insight:\n    - The object is not copied or reflected; it is broken at the horizontal waist,\n      recolored by exchanging the two visible object colors, then rejoined diagonally.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected exactly two foreground colors\"\n    color_a, color_b = colors\n\n    objects = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert len(objects) == 1, \"expected one connected foreground object\"\n    r0, _c0, r1, _c1 = objects[0][\"bbox\"]\n    height = int(r1 - r0 + 1)\n    assert height % 2 == 0, \"object bbox height must split evenly\"\n\n    split_row = int(r0 + height // 2)\n    row_ids = np.arange(g.shape[0])[:, None]\n    fg = g != int(bg)\n    upper = fg & (row_ids < split_row)\n    lower = fg & (row_ids >= split_row)\n    assert np.any(upper), \"expected a nonempty upper half\"\n    assert np.any(lower), \"expected a nonempty lower half\"\n    assert int(upper.sum()) == int(lower.sum()), \"expected equal upper and lower areas\"\n\n    upper_boundary_cols = np.flatnonzero(upper[split_row - 1])\n    lower_boundary_cols = np.flatnonzero(lower[split_row])\n    assert upper_boundary_cols.size > 0, \"upper half must touch the split boundary\"\n    assert lower_boundary_cols.size > 0, \"lower half must touch the split boundary\"\n\n    shift = int(lower_boundary_cols.max() + 1 - upper_boundary_cols.min())\n    assert shift > 0, \"upper half must shift right\"\n\n    upper_rows, upper_cols = np.where(upper)\n    lower_rows, lower_cols = np.where(lower)\n    shifted_upper_cols = upper_cols + shift\n    assert int(shifted_upper_cols.max()) < g.shape[1], \"shifted upper half must fit in the grid\"\n\n    out = np.full_like(g, int(bg))\n    out[lower_rows, lower_cols] = _swapped_values(g[lower_rows, lower_cols], color_a, color_b)\n    out[upper_rows, shifted_upper_cols] = _swapped_values(g[upper_rows, upper_cols], color_a, color_b)\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import paste as _gen_paste\n# Canvas and palette.\nGEN_BG, GEN_GRID_SIZE = 8, 16\nGEN_COLOR_POOL = [c for c in range(10) if c != GEN_BG]\n\n# Symmetric object shape.\nGEN_HALF_HEIGHTS, GEN_MAX_WIDTHS = [3, 4], [5, 7]\nGEN_MIN_ROW_WIDTH, GEN_WIDTH_STEP = 1, 2\nGEN_ROW_SWAP_PROB, GEN_ROW_SWAP_HEIGHT = 0.25, 4\nGEN_ROW_SWAP_INDICES = (1, 2)\n\n# Placement and validation.\nGEN_MARGIN, GEN_RETRIES = 1, 300\n\n\ndef _gen_fc4aaf52_swap(arr: np.ndarray, color_a: int, color_b: int) -> np.ndarray:\n    out = arr.copy()\n    out[arr == color_a] = color_b\n    out[arr == color_b] = color_a\n    return out\n\n\ndef _gen_fc4aaf52_upper(half_h: int, border_color: int, fill_color: int) -> np.ndarray:\n    max_w = random.choice(GEN_MAX_WIDTHS)\n    widths = [max_w]\n    for _ in range(half_h - 1):\n        prev_w = widths[-1]\n        widths.append(random.choice([max(GEN_MIN_ROW_WIDTH, prev_w - GEN_WIDTH_STEP), prev_w]))\n    widths = list(reversed(widths))\n    if random.random() < GEN_ROW_SWAP_PROB and half_h == GEN_ROW_SWAP_HEIGHT:\n        i, j = GEN_ROW_SWAP_INDICES\n        widths[i], widths[j] = widths[j], widths[i]\n\n    bottom_lefts = [0]\n    bottom_widths = list(reversed(widths))\n    for i, width in enumerate(bottom_widths[1:], start=1):\n        prev_l = bottom_lefts[-1]\n        prev_r = prev_l + bottom_widths[i - 1] - 1\n        choices = [left for left in range(max_w - width + 1) if max(left, prev_l) <= min(left + width - 1, prev_r)]\n        bottom_lefts.append(random.choice(choices))\n    lefts = list(reversed(bottom_lefts))\n\n    upper = np.full((half_h, max_w), GEN_BG, dtype=int)\n    for r, (left, width) in enumerate(zip(lefts, widths)):\n        right = left + width\n        upper[r, left:right] = fill_color\n        upper[r, left] = border_color\n        upper[r, right - 1] = border_color\n    return upper\n\n\ndef _gen_fc4aaf52_placement(obj_h: int, obj_w: int, shift: int) -> tuple[int, int] | None:\n    max_row = GEN_GRID_SIZE - GEN_MARGIN - obj_h\n    max_col = GEN_GRID_SIZE - GEN_MARGIN - obj_w - shift\n    return None if max_col < 0 else (random.randint(GEN_MARGIN, max_row), random.randint(GEN_MARGIN, max_col))\n\n\ndef _gen_fc4aaf52_render(upper, lower, row, col, shift, border_color, fill_color, *, swapped):\n    out = np.full((GEN_GRID_SIZE, GEN_GRID_SIZE), GEN_BG, dtype=int)\n    upper_col = col\n    if swapped:\n        upper = _gen_fc4aaf52_swap(upper, border_color, fill_color)\n        lower = _gen_fc4aaf52_swap(lower, border_color, fill_color)\n        upper_col += shift\n    _gen_paste(out, upper, row, upper_col, transparent=GEN_BG)\n    _gen_paste(out, lower, row + upper.shape[0], col, transparent=GEN_BG)\n    return out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    border_color, fill_color = random.sample(GEN_COLOR_POOL, 2)\n    half_h = random.choice(GEN_HALF_HEIGHTS)\n    upper_in = _gen_fc4aaf52_upper(half_h, border_color, fill_color)\n    lower_in = np.flipud(upper_in)\n\n    obj_h, obj_w = half_h * 2, upper_in.shape[1]\n    shift = int(np.count_nonzero(upper_in[-1] != GEN_BG))\n    placement = _gen_fc4aaf52_placement(obj_h, obj_w, shift)\n    if placement is None:\n        return None\n    obj_row, obj_col = placement\n\n    expected = _gen_fc4aaf52_render(upper_in, lower_in, obj_row, obj_col, shift, border_color, fill_color, swapped=True)\n    inp = _gen_fc4aaf52_render(upper_in, lower_in, obj_row, obj_col, shift, border_color, fill_color, swapped=False)\n\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid fc4aaf52 input\")\n","exit_code":0,"status":"completed"}}
