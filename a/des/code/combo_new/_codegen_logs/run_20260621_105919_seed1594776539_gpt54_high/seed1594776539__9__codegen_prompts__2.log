{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom collections import Counter, deque\n\nfrom arc_utils import components_mask, get_bg, is_contiguous, neighbors4, neighbors8, random_free_location\nimport random\n\n\ndef _flood(start: tuple[int, int], passable, h: int, w: int) -> set[tuple[int, int]]:\n    q = deque([start])\n    vis = {start}\n    while q:\n        r, c = q.popleft()\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in vis and passable(nr, nc):\n                vis.add((nr, nc))\n                q.append((nr, nc))\n    return vis\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Paint an inner border around the region reachable from a corner marker pixel.\n\n    Input structure:\n    - bg = most common color; wall color (blue) forms barriers dividing the grid.\n    - A unique single pixel (magenta) sits on one corner — the start marker.\n    - Some wall-colored pixels are structural (border-touching, enclosing regions); others are decorations.\n\n    Rule:\n    - Flood-fill from the marker corner to find all reachable bg cells, blocked by structural walls.\n    - Erase wall-colored decorations hidden behind structural walls (not reachable from marker side).\n    - Paint orange (color 7) on every reachable bg cell adjacent to a wall or grid edge — forming a 1-cell inner border.\n\n    Key insight: Only border-connected wall components act as real barriers; interior wall fragments are decorations to be removed.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Marker pixel is a unique (count==1) non-bg pixel on a corner.\n    counts = Counter(int(v) for v in g.ravel())\n    corners = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]\n    marker = None\n    for r, c in corners:\n        v = int(g[r, c])\n        if v != bg and counts.get(v, 0) == 1:\n            marker = (r, c, v)\n            break\n    assert marker is not None, \"no unique single-pixel corner marker found\"\n\n    mr, mc, marker_col = marker\n\n    # Wall color: most frequent non-bg, non-marker color.\n    other_cols = [c for c in counts.keys() if c not in (bg, marker_col)]\n    assert other_cols, \"no non-bg non-marker colors found; cannot determine wall color\"\n    wall_col = max(other_cols, key=lambda c: counts[c])\n\n    # First reach: treat all wall pixels as obstacles.\n    reach0 = _flood(\n        (mr, mc),\n        lambda r, c: int(g[r, c]) in (bg, marker_col),\n        h,\n        w,\n    )\n\n    # Structural walls are wall-color components that touch the border AND are adjacent to reach0.\n    walls: set[tuple[int, int]] = set()\n    for comp_arr in components_mask(g == wall_col, connectivity=4):\n        comp = [(int(r), int(c)) for r, c in comp_arr]\n        touches_border = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp)\n        if not touches_border:\n            continue\n        adjacent_to_reach0 = any(any((nr, nc) in reach0 for nr, nc in neighbors4(r, c)) for r, c in comp)\n        if adjacent_to_reach0:\n            walls |= set(comp)\n\n    # Second reach: allow passing through non-wall wall-color pixels (decorations) so they don't create borders.\n    reach = _flood(\n        (mr, mc),\n        lambda r, c: int(g[r, c]) in (bg, marker_col) or (int(g[r, c]) == wall_col and (r, c) not in walls),\n        h,\n        w,\n    )\n\n    # Remove wall-colored decorations that are not reachable (they lie behind structural walls).\n    for r in range(h):\n        for c in range(w):\n            if int(out[r, c]) == wall_col and (r, c) not in walls and (r, c) not in reach:\n                out[r, c] = bg\n\n    fill_col = 7\n    # Paint a 1-cell-thick inner border of the reachable region (on background cells only).\n    for r, c in reach:\n        if int(out[r, c]) != bg:\n            continue\n        if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n            out[r, c] = fill_col\n            continue\n        if any((nr, nc) in walls for nr, nc in neighbors8(r, c)):\n            out[r, c] = fill_col\n            continue\n        if any((nr, nc) not in reach for nr, nc in neighbors4(r, c)):\n            out[r, c] = fill_col\n\n    return out\n\n# --------------- generator (merged (attempts 1+2 hybrid)) ---------------\n\n# ---- Palette (task colors) ----\nBG = 8\nWALL = 1\nMARKER = 6\nFILL = 7\n\n# ---- Canvas size ----\nGRID_H_RANGE = (10, 20)\nGRID_W_RANGE = (10, 20)\n\n# ---- Structural walls ----\nNUM_STRUCTS_RANGE = (1, 4)\nSTRUCT_SHAPE_RETRIES = 8             # per-shape placement retries\nRECT_MAX_DIM_DIV = 3                 # rect max side ~ dim // 3\nTRI_MAX_SIZE = 6                     # diamond/triangle cap on size\nTRI_MIN_DIM_DIV = 3                  # diamond/top-tri need dim // 3\n\n# ---- Reachable region gate ----\nREACH_RATIO_RANGE = (0.38, 0.87)\n\n# ---- Decorations ----\nNUM_DECOR_RANGE = (0, 3)\nDECOR_AREA_RANGE = (1, 4)            # max pixel-extent of a single decor patch\nDECOR_BORDER = 1                     # stay >= N cells from grid edge\nDECOR_PADDING = 1                    # 8-conn separation from other occupancy\n\n# ---- Outer retry budget ----\nGEN_ATTEMPTS = 300\n\n\n# =============================================================================\n# Shape factories (each returns list[(r,c)] or None for a 4-contiguous shape\n# that touches at least one grid edge).\n# =============================================================================\n\ndef _shape_vertical_line(h, w, rng):\n    c = rng.randint(2, w - 2)\n    mode = rng.choice(['top', 'bottom', 'full'])\n    if mode == 'full':\n        r0, r1 = 0, h - 1\n    elif mode == 'top':\n        r0, r1 = 0, rng.randint(max(1, h // 3), h - 2)\n    else:\n        r0, r1 = rng.randint(1, h - max(2, h // 3)), h - 1\n    return [(r, c) for r in range(r0, r1 + 1)]\n\n\ndef _shape_horizontal_line(h, w, rng):\n    r = rng.randint(1, h - 2)\n    if rng.choice(['left', 'right']) == 'left':\n        c0, c1 = 0, rng.randint(max(1, w // 3), w - 2)\n    else:\n        c0, c1 = rng.randint(1, w - max(2, w // 3)), w - 1\n    return [(r, c) for c in range(c0, c1 + 1)]\n\n\ndef _shape_rectangle(h, w, rng):\n    rh = rng.randint(2, max(2, h // RECT_MAX_DIM_DIV))\n    rw = rng.randint(2, max(2, w // RECT_MAX_DIM_DIV))\n    anchor = rng.choice(['top', 'right', 'tr', 'top_mid', 'right_mid', 'bottom_right'])\n    if anchor == 'top':\n        r0, c0 = 0, rng.randint(1, max(1, w - rw - 1))\n    elif anchor == 'right':\n        r0, c0 = rng.randint(1, max(1, h - rh - 1)), w - rw\n    elif anchor == 'tr':\n        r0, c0 = 0, w - rw\n    elif anchor == 'top_mid':\n        r0, c0 = 0, rng.randint(2, max(2, w - rw - 2))\n    elif anchor == 'right_mid':\n        r0, c0 = rng.randint(2, max(2, h - rh - 2)), w - rw\n    else:\n        r0, c0 = h - rh, w - rw\n    return [(r, c) for r in range(r0, r0 + rh) for c in range(c0, c0 + rw)]\n\n\ndef _shape_left_diamond(h, w, rng):\n    \"\"\"Isoceles diamond attached to left edge.\"\"\"\n    max_size = min(TRI_MAX_SIZE, h // TRI_MIN_DIM_DIV, w // TRI_MIN_DIM_DIV)\n    if max_size < 3:\n        return None\n    size = rng.randint(3, max_size)\n    r_center = rng.randint(size, h - size - 1)\n    top = r_center - (size - 1)\n    cells = []\n    for i in range(size):\n        cells.extend((top + i, c) for c in range(i + 1))\n    for i in range(size - 1):\n        cells.extend((top + size + i, c) for c in range(size - 1 - i))\n    return cells\n\n\ndef _shape_top_triangle(h, w, rng):\n    \"\"\"Right triangle on top edge, widest at top.\"\"\"\n    max_size = min(TRI_MAX_SIZE, h // TRI_MIN_DIM_DIV, w // TRI_MIN_DIM_DIV)\n    if max_size < 2:\n        return None\n    size = rng.randint(2, max_size)\n    c_start = rng.randint(1, max(1, w - 2 * size))\n    cells = []\n    for i in range(size):\n        cells.extend((i, c) for c in range(c_start, c_start + size - i))\n    return cells\n\n\ndef _shape_right_triangle(h, w, rng):\n    \"\"\"Right triangle on right edge, widest at bottom.\"\"\"\n    max_size = min(TRI_MAX_SIZE, h // 2, w // 2)\n    if max_size < 2:\n        return None\n    size = rng.randint(2, max_size)\n    r_start = rng.randint(0, max(0, h - size - 1))\n    cells = []\n    for i in range(size):\n        length = i + 1\n        cells.extend((r_start + i, c) for c in range(w - length, w))\n    return cells\n\n\nSHAPE_FACTORIES = [\n    _shape_vertical_line,\n    _shape_horizontal_line,\n    _shape_rectangle,\n    _shape_left_diamond,\n    _shape_top_triangle,\n    _shape_right_triangle,\n]\n\n\n# =============================================================================\n# Primitives\n# =============================================================================\n\ndef _flood_mask(start, blocked, h, w):\n    \"\"\"BFS from `start` on the ~blocked bool grid; return reach as (h,w) bool array.\"\"\"\n    reach = np.zeros((h, w), dtype=bool)\n    reach[start] = True\n    q = deque([start])\n    while q:\n        r, c = q.popleft()\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and not reach[nr, nc] and not blocked[nr, nc]:\n                reach[nr, nc] = True\n                q.append((nr, nc))\n    return reach\n\n\ndef _touches_border(mask):\n    return mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any()\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/b1986d4b.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/b1986d4b.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _square_objects(g: np.ndarray, bg: int) -> list[dict]:\n    objects = []\n    for obj in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        if h == w and h >= 2 and int(obj[\"area\"]) == h * w:\n            objects.append({\"side\": int(h), \"color\": int(obj[\"color\"]), \"bbox\": obj[\"bbox\"]})\n    return objects\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Render the filled-square object counts as compact nested stacks ordered by count rank.\n\n    Input structure\n    A large noisy grid has a dominant background, scattered non-square noise, and\n    filled monochrome square objects. Each square side length has exactly one\n    object color, and side lengths form consecutive sizes.\n\n    Rule\n    Ignore non-square components. If the lowest square in the scene is of the\n    smallest side length, treat that one smallest square as a distractor and do\n    not count it. For count rank k from left to right, create one block from all\n    square sizes with at least k remaining objects; draw larger squares first and\n    smaller squares over their upper-left corner, then append one background\n    separator column.\n\n    Key insight\n    The output is a count histogram of square side lengths, but each histogram\n    slot is rendered as nested upper-left square masks using the side colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    objects = _square_objects(g, bg)\n    assert objects, \"expected filled square objects\"\n\n    sides = sorted({obj[\"side\"] for obj in objects})\n    assert sides == list(range(sides[0], sides[-1] + 1)), \"expected consecutive square side lengths\"\n\n    by_side = {side: [obj for obj in objects if obj[\"side\"] == side] for side in sides}\n    colors = {}\n    for side, side_objects in by_side.items():\n        side_colors = {obj[\"color\"] for obj in side_objects}\n        assert len(side_colors) == 1, \"each side length should have one color\"\n        colors[side] = side_colors.pop()\n\n    smallest = sides[0]\n    lowest_row = max(obj[\"bbox\"][2] for obj in objects)\n    lowest_smallest = [obj for obj in by_side[smallest] if obj[\"bbox\"][2] == lowest_row]\n    if lowest_smallest:\n        assert len(lowest_smallest) == 1, \"expected at most one lowest smallest distractor\"\n        drop_bbox = lowest_smallest[0][\"bbox\"]\n        by_side[smallest] = [obj for obj in by_side[smallest] if obj[\"bbox\"] != drop_bbox]\n\n    counts = {side: len(side_objects) for side, side_objects in by_side.items()}\n    assert all(count > 0 for count in counts.values()), \"each square size should remain represented\"\n\n    out_h = sides[-1] + 1\n    groups = []\n    for rank in range(max(counts.values())):\n        present_sides = [side for side in sides if counts[side] > rank]\n        assert present_sides, \"rank should contain at least one square size\"\n\n        group_w = max(present_sides)\n        group = np.full((out_h, group_w), bg, dtype=int)\n        for side in sorted(present_sides, reverse=True):\n            group[:side, :side] = colors[side]\n        groups.append(group)\n\n    out_w = sum(group.shape[1] + 1 for group in groups)\n    out = np.full((out_h, out_w), bg, dtype=int)\n    c = 0\n    for group in groups:\n        w = group.shape[1]\n        out[:, c : c + w] = group\n        c += w + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nSIDES = [2, 3, 4]\nALL_COLORS = list(range(10))\n\n# Canvas and object bounds.\nGRID_SIZE_RANGE = (25, 28)\nCOUNT_RANGE = (2, 6)\nSQUARE_GAP = 1\n\n# Noise and distractor controls.\nDISTRACTOR_PROB = 0.5\nNOISE_COUNT_RANGE = (40, 70)\n\n# Retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _choose_palette() -> tuple[int, dict[int, int], int]:\n    \"\"\"Choose one background, three square colors, and one noise color.\"\"\"\n    bg = random.choice(ALL_COLORS)\n    non_bg = [c for c in ALL_COLORS if c != bg]\n    random.shuffle(non_bg)\n    square_colors = {side: non_bg[i] for i, side in enumerate(SIDES)}\n    return bg, square_colors, non_bg[len(SIDES)]\n\n\ndef _make_square_queue(\n    counts: dict[int, int], square_colors: dict[int, int], has_distractor: bool\n) -> tuple[list[tuple[int, int]], tuple[int, int] | None]:\n    \"\"\"Return regular squares plus the separately placed distractor candidate.\"\"\"\n    squares = [(side, square_colors[side]) for side in SIDES for _ in range(counts[side])]\n    if has_distractor:\n        squares.append((SIDES[0], square_colors[SIDES[0]]))\n\n    random.shuffle(squares)\n    if not has_distractor:\n        return squares, None\n    return squares[:-1], squares[-1]\n\n\ndef _free_positions(occupied: np.ndarray, side: int, min_r: int = 0) -> list[tuple[int, int]]:\n    \"\"\"List top-left positions whose padded square footprint is unoccupied.\"\"\"\n    H, W = occupied.shape\n    valid = []\n    for r in range(min_r, H - side + 1):\n        for c in range(0, W - side + 1):\n            r0 = max(0, r - SQUARE_GAP)\n            r1 = min(H, r + side + SQUARE_GAP)\n            c0 = max(0, c - SQUARE_GAP)\n            c1 = min(W, c + side + SQUARE_GAP)\n            if not occupied[r0:r1, c0:c1].any():\n                valid.append((r, c))\n    return valid\n\n\ndef _mark_occupied(occupied: np.ndarray, r: int, c: int, side: int) -> None:\n    H, W = occupied.shape\n    r0 = max(0, r - SQUARE_GAP)\n    r1 = min(H, r + side + SQUARE_GAP)\n    c0 = max(0, c - SQUARE_GAP)\n    c1 = min(W, c + side + SQUARE_GAP)\n    occupied[r0:r1, c0:c1] = True\n\n\ndef _place_square(\n    grid: np.ndarray,\n    occupied: np.ndarray,\n    placed: list[tuple[int, int, int, int]],\n    side: int,\n    color: int,\n    positions: list[tuple[int, int]] | None = None,\n) -> bool:\n    \"\"\"Place one square at a random valid position and update grid state.\"\"\"\n    valid = _free_positions(occupied, side) if positions is None else positions\n    if not valid:\n        return False\n    r, c = random.choice(valid)\n    grid[r:r + side, c:c + side] = color\n    _mark_occupied(occupied, r, c, side)\n    placed.append((r, c, side, color))\n    return True\n\n\ndef _place_squares(\n    grid: np.ndarray,\n    occupied: np.ndarray,\n    regular_squares: list[tuple[int, int]],\n    distractor_sq: tuple[int, int] | None,\n) -> list[tuple[int, int, int, int]] | None:\n    \"\"\"Place all squares, requiring any distractor to sit below the others.\"\"\"\n    placed = []\n\n    random.shuffle(regular_squares)\n    for side, color in regular_squares:\n        if not _place_square(grid, occupied, placed, side, color):\n            return None\n\n    if distractor_sq is None:\n        return placed\n\n    d_side, d_color = distractor_sq\n    current_max_bottom = max(r + side - 1 for r, _, side, _ in placed) if placed else -1\n    min_r = max(0, current_max_bottom - d_side + 2)\n    valid = [\n        (r, c)\n        for r, c in _free_positions(occupied, d_side, min_r=min_r)\n        if r + d_side - 1 > current_max_bottom\n    ]\n    if not _place_square(grid, occupied, placed, d_side, d_color, valid):\n        return None\n    return placed\n\n\ndef _add_noise(grid: np.ndarray, bg: int, noise_color: int) -> bool:\n    \"\"\"Scatter noise onto background cells only.\"\"\"\n    free_cells = list(zip(*np.where(grid == bg)))\n    num_noise = random.randint(*NOISE_COUNT_RANGE)\n    if len(free_cells) < num_noise:\n        return False\n    random.shuffle(free_cells)\n    for r, c in free_cells[:num_noise]:\n        grid[r, c] = noise_color\n    return True\n\n\ndef _would_trigger_unintended_distractor(placed: list[tuple[int, int, int, int]]) -> bool:\n    \"\"\"Detect no-distractor samples where the solver would drop a small square.\"\"\"\n    lowest_row = max(r + side - 1 for r, _, side, _ in placed)\n    return any(side == SIDES[0] and r + side - 1 == lowest_row for r, _, side, _ in placed)\n\n\ndef _render_expected_output(\n    bg: int, counts: dict[int, int], square_colors: dict[int, int]\n) -> np.ndarray:\n    \"\"\"Render the count-derived oracle output used to validate samples.\"\"\"\n    out_h = SIDES[-1] + 1\n    groups = []\n    for rank in range(max(counts.values())):\n        present_sides = [side for side in SIDES if counts[side] > rank]\n        group = np.full((out_h, max(present_sides)), bg, dtype=int)\n        for side in sorted(present_sides, reverse=True):\n            group[:side, :side] = square_colors[side]\n        groups.append(group)\n\n    out_w = sum(group.shape[1] + 1 for group in groups)\n    out = np.full((out_h, out_w), bg, dtype=int)\n    c = 0\n    for group in groups:\n        w = group.shape[1]\n        out[:, c:c + w] = group\n        c += w + 1\n    return out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg, square_colors, noise_color = _choose_palette()\n    counts = {side: random.randint(*COUNT_RANGE) for side in SIDES}\n    has_distractor = random.random() < DISTRACTOR_PROB\n    regular_squares, distractor_sq = _make_square_queue(counts, square_colors, has_distractor)\n\n    H = random.randint(*GRID_SIZE_RANGE)\n    W = random.randint(*GRID_SIZE_RANGE)\n    grid = np.full((H, W), bg, dtype=int)\n    occupied = np.zeros((H, W), dtype=bool)\n\n    placed = _place_squares(grid, occupied, regular_squares, distractor_sq)\n    if placed is None or not _add_noise(grid, bg, noise_color):\n        return None\n\n    if not has_distractor and _would_trigger_unintended_distractor(placed):\n        return None\n\n","exit_code":0,"status":"completed"}}
