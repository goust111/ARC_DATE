{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport random\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed1594776539/8/8.py')\nmod = SourceFileLoader('new_arc_task_dbg2', str(p)).load_module()\n\nfor seed in range(1000):\n    random.seed(seed)\n    rows, cols = random.choice(((2, 2), (2, 3), (3, 2)))\n    cell_h = random.randint(4, 5)\n    cell_w = random.randint(4, 5)\n    frame_h = rows * cell_h + rows + 1\n    frame_w = cols * cell_w + cols + 1\n    min_h = max(frame_h + 8, 22)\n    min_w = max(frame_w + 8, 22)\n    if min_h > 30 or min_w > 30:\n        continue\n    grid_h = random.randint(min_h, 30)\n    grid_w = random.randint(min_w, 30)\n    top = random.randint(2, grid_h - frame_h - 2)\n    left = random.randint(2, grid_w - frame_w - 2)\n    grid = np.full((grid_h, grid_w), mod.BG, dtype=int)\n    vertical_features = {}\n    horizontal_features = {}\n    for slot_r in range(rows):\n        for slot_c in range(cols - 1):\n            vertical_features[(slot_r, slot_c)] = (\n                random.choice(list(range(1, cell_h - 1))),\n                random.choice((-1, 1)),\n            )\n    for slot_r in range(rows - 1):\n        for slot_c in range(cols):\n            horizontal_features[(slot_r, slot_c)] = (\n                random.choice(list(range(1, cell_w - 1))),\n                random.choice((-1, 1)),\n            )\n    fr0, fc0, fr1, fc1 = mod._draw_frame(grid, top, left, rows, cols, cell_h, cell_w, vertical_features, horizontal_features)\n    slots = mod._extract_slots(grid, mod.BG, mod.FRAME)\n    if len({slot['shape'] for slot in slots}) \"'!= len(slots):\n        continue\n    pieces = []\n    colors = random.sample(mod.PALETTE, len(slots))\n    for slot, color in zip(slots, colors):\n        patch = mod._shape_to_patch(slot['\"'shape'], int(color))\n        pieces.append({'color': int(color), 'patch': patch, 'coords': slot['coords'], 'area': int(np.count_nonzero(patch)), 'shape': slot['shape']})\n    occupied = grid \"'!= mod.BG\n    forbidden = np.zeros_like(occupied, dtype=bool)\n    forbidden[fr0:fr1+1, fc0:fc1+1] = True\n    ok = True\n    for piece in sorted(pieces, key=lambda item: (-item['\"'area'], item['color'])):\n        placed = False\n        ph, pw = piece['patch'].shape\n        for _ in range(800):\n            top0 = random.randint(1, grid_h - ph - 1)\n            left0 = random.randint(1, grid_w - pw - 1)\n            if not mod._can_place_patch(occupied, forbidden, piece['patch'], top0, left0):\n                continue\n            cells = np.argwhere(piece['patch'] \"'!= mod.BG)\n            for rr, cc in cells:\n                grid[top0 + int(rr), left0 + int(cc)] = int(piece['\"'color'])\n                occupied[top0 + int(rr), left0 + int(cc)] = True\n            placed = True\n            break\n        if not placed:\n            ok = False\n            break\n    if not ok:\n        continue\n    comps = mod._mono_components(grid, {mod.BG, mod.FRAME})\n    if len(comps) \"'!= len(slots):\n        print('\"'seed', seed, 'rows cols', rows, cols, 'cell', cell_h, cell_w, 'slots', len(slots), 'comps', len(comps))\n        print('slot areas', [len(s['shape']) for s in slots])\n        print('comp sizes', [len(c['coords']) for c in comps], 'colors', [c['color'] for c in comps])\n        for idx, piece in enumerate(pieces):\n            patch = piece['patch']\n            comps_in_patch = mod._mono_components(patch, {mod.BG})\n            print('piece', idx, 'color', piece['color'], 'patch shape', patch.shape, 'cells', np.argwhere(patch \"'!= mod.BG).tolist(), '\"'patch comps', len(comps_in_patch))\n        print(grid)\n        break\nelse:\n    print('no failure found')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
