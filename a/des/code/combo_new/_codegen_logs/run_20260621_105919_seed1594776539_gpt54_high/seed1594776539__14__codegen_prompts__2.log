0°) so its contact edge has exactly N-2 contiguous cells aligned with the hub side, and the rotated sprite is mirror-symmetric along the contact-edge axis (UD for left/right, LR for top/bottom).\n  17:     - Translate it to adjoin that hub side. \n  18:     - Clear everything else to bg; output is hub + attached sprites only.\n  19: \n  20:     Key insight: Each edge color uniquely pairs a sprite to a side; symmetry along the contact-edge axis disambiguates the correct rotation.\n  21:     \"\"\"\n  22:     g = np.array(grid, dtype=int)\n  23:     H, W = g.shape\n  24:     bg = int(get_bg(g))\n  25: \n  26:     def _find_hub():\n  27:         best = None  # (score, (r,c,n), (top,bot,left,right))\n  28:         for n in range(3, 7):\n  29:             for r in range(0, int(H - n + 1)):\n  30:                 for c in range(0, int(W - n + 1)):\n  31:                     # corners must be bg\n  32:                     if (\n  33:                         int(g[int(r), int(c)]) != int(bg)\n  34:                         or int(g[int(r), int(c + n - 1)]) != int(bg)\n  35:                         or int(g[int(r + n - 1), int(c)]) != int(bg)\n  36:                         or int(g[int(r + n - 1), int(c + n - 1)]) != int(bg)\n  37:                     ):\n  38:                         continue\n  39:                     inner = g[int(r + 1) : int(r + n - 1), int(c + 1) : int(c + n - 1)]\n  40:                     if not bool((inner == int(bg)).all()):\n  41:                         continue\n  42: \n  43:                     top = g[int(r), int(c + 1) : int(c + n - 1)]\n  44:                     bot = g[int(r + n - 1), int(c + 1) : int(c + n - 1)]\n  45:                     left = g[int(r + 1) : int(r + n - 1), int(c)]\n  46:                     right = g[int(r + 1) : int(r + n - 1), int(c + n - 1)]\n  47: \n  48:                     if bool((top == int(bg)).any()) or bool((bot == int(bg)).any()) or bool((left == int(bg)).any()) or bool((right == int(bg)).any()):\n  49:                         continue\n  50:                     if (\n  51:                         len(set(map(int, top))) != 1\n  52:                         or len(set(map(int, bot))) != 1\n  53:                         or len(set(map(int, left))) != 1\n  54:                         or len(set(map(int, right))) != 1\n  55:                     ):\n  56:                         continue\n  57: \n  58:                     cr = float(r + (n - 1) / 2)\n  59:                     cc = float(c + (n - 1) / 2)\n  60:                     score = abs(float(cr - (H - 1) / 2)) + abs(float(cc - (W - 1) / 2))\n  61:                     cand = (\n  62:                         float(score),\n  63:                         (int(r), int(c), int(n)),\n  64:                         (int(top[0]), int(bot[0]), int(left[0]), int(right[0])),\n  65:                     )\n  66:                     if best is None or float(cand[0]) < float(best[0]):\n  67:                         best = cand\n  68:         return best\n  69: \n  70:     hub = _find_hub()\n  71:     assert not (hub is None)\n  72: \n  73:     _score, (r, c, n), (top_col, bot_col, left_col, right_col) = hub\n  74:     hub_mask = np.zeros((H, W), dtype=bool)\n  75:     hub_mask[int(r) : int(r + n), int(c) : int(c + n)] = True\n  76: \n  77:     out = np.full_like(g, int(bg))\n  78:     out[int(r) : int(r + n), int(c) : int(c + n)] = g[int(r) : int(r + n), int(c) : int(c + n)]\n  79: \n  80:     target = int(n - 2)  # length of the hub edge segment (excluding corners)\n  81: \n  82:     def _crop_to_mask(arr: np.ndarray, mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:\n  83:         pts = np.argwhere(mask)\n  84:         r0, c0, r1, c1 = bbox_coords(pts)\n  85:         return arr[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1], mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]\n  86: \n  87:     def _edge_segment(mask: np.ndarray, side: str):\n  88:         pts = np.argwhere(mask)\n  89:         if pts.size == 0:\n  90:             return None\n  91:         if side == \"top\":\n  92:             rr = int(pts[:, 0].min())\n  93:             cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n  94:             return (\"h\", int(rr), cols)\n  95:         if side == \"bot\":\n  96:             rr = int(pts[:, 0].max())\n  97:             cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n  98:             return (\"h\", int(rr), cols)\n  99:         if side == \"left\":\n 100:             cc = int(pts[:, 1].min())\n 101:             rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n 102:             return (\"v\", int(cc), rows)\n 103:         if side == \"right\":\n 104:             cc = int(pts[:, 1].max())\n 105:             rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n 106:             return (\"v\", int(cc), rows)\n 107:         return None\n 108: \n 109:     def _is_contig(seq: list[int]) -> bool:\n 110:         return bool(seq) and all(int(seq[i]) + 1 == int(seq[i + 1]) for i in range(len(seq) - 1))\n 111: \n 112:     # desired attachment geometry: adjacent (touching) the hub side segment\n 113:     segs = {\n 114:         \"top\": (int(top_col), (\"bot\", int(r - 1), list(range(int(c + 1), int(c + n - 1))))),\n 115:         \"bot\": (int(bot_col), (\"top\", int(r + n), list(range(int(c + 1), int(c + n - 1))))),\n 116:         \"left\": (int(left_col), (\"right\", int(c - 1), list(range(int(r + 1), int(r + n - 1))))),\n 117:         \"right\": (int(right_col), (\"left\", int(c + n), list(range(int(r + 1), int(r + n - 1))))),\n 118:     }\n 119: \n 120:     for _side, (col, (need_edge, fixed, span)) in segs.items():\n 121:         col = int(col)\n 122:         m = (g == int(col)) & (~hub_mask)\n 123:         if not bool(m.any()):\n 124:             continue\n 125: \n--- generate_input ---\n 535: def generate_input() -> np.ndarray:\n 536:     for _ in range(300):\n 537:         result = _gen_attempt()\n 538:         if result is not None:\n 539:             return result\n 540:     raise RuntimeError(\"generate_input: failed after 300 attempts\")\n\n===== 465b7d93.py =====\n--- main ---\n  96: def main(grid: np.ndarray) -> np.ndarray:\n  97:     \"\"\"\n  98:     Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.\n  99: \n 100:     Input structure:\n 101:     - The background is the dominant color.\n 102:     - There are exactly two foreground colors: one forms a complete rectangular\n 103:       one-pixel-thick frame, and the other forms one 4-connected sprite outside it.\n 104:     - The frame interior is initially background.\n 105: \n 106:     Rule:\n 107:     - Clear the original sprite from its outside location.\n 108:     - Map the sprite bbox to the frame interior bbox, sending bbox extremes to\n 109:       interior extremes.\n 110:     - Draw straight horizontal or vertical segments between mapped positions of\n 111:       adjacent sprite pixels, then fill any enclosed background region inside\n 112:       those drawn segments.\n 113: \n 114:     Key insight:\n 115:     The outside sprite is a miniature line/fill diagram for the frame interior,\n 116:     not a bitmap to scale by block replication.\n 117:     \"\"\"\n 118:     g = np.asarray(grid, dtype=int)\n 119:     bg = get_bg(g)\n 120:     colors = colors_present(g, exclude={bg})\n 121:     assert len(colors) == 2, \"expected one frame color and one sprite color\"\n 122: \n 123:     frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []\n 124:     for color in colors:\n 125:         frame_bbox = _rect_frame_bbox(g == int(color))\n 126:         if frame_bbox is not None:\n 127:             frame_candidates.append((int(color), frame_bbox))\n 128:     assert len(frame_candidates) == 1, \"expected a unique rectangular frame\"\n 129: \n 130:     frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]\n 131:     sprite_color = next(color for color in colors if color != frame_color)\n 132:     sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)\n 133:     assert len(sprite_components) == 1, \"expected a single 4-connected sprite\"\n 134:     frame_region = np.zeros_like(g, dtype=bool)\n 135:     frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True\n 136:     assert not np.any((g == sprite_color) & frame_region), \"sprite must start outside the frame\"\n 137: \n 138:     sr0, sc0, sr1, sc1 = sprite_components[0][\"bbox\"]\n 139:     sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color\n 140: \n 141:     ir0, ic0 = fr0 + 1, fc0 + 1\n 142:     ir1, ic1 = fr1 - 1, fc1 - 1\n 143:     assert ir0 <= ir1 and ic0 <= ic1, \"frame must have an interior\"\n 144:     interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]\n 145:     assert np.all(interior == bg), \"frame interior must start empty\"\n 146: \n 147:     stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))\n 148:     out = g.copy()\n 149:     out[g == sprite_color] = bg\n 150:     out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color\n 151:     return out\n 152: \n 153: # --------------- generator (att2, o5x) ---------------\n 154: \n 155: # Canvas and observed fixed colors.\n 156: _GRID_SHAPE = (10, 10)\n 157: _COLOR_COUNT = 10\n 158: _BG = 7\n 159: _FRAME_COLOR = 6\n 160: \n 161: # Frame size bounds and retry budget.\n 162: _FRAME_SIZE_MIN = 3\n 163: _FRAME_SIZE_MAX = 8\n 164: _SINGLE_PIXEL_FRAME_SIZE = 3\n 165: _MAX_GENERATION_ATTEMPTS = 300\n 166: \n 167: # Sprite color pool and source masks.\n 168: _SPRITE_COLORS = tuple(c for c in range(_COLOR_COUNT) if c not in {_BG, _FRAME_COLOR})\n 169: _SPRITE_SINGLE = np.ones((1, 1), dtype=bool)\n 170: _SPRITE_PATTERNS_2X2 = [\n 171:     np.array([[1, 1], [1, 0]], dtype=bool),\n 172:     np.array([[1, 1], [0, 1]], dtype=bool),\n 173:     np.array([[1, 0], [1, 1]], dtype=bool),\n 174:     np.array([[0, 1], [1, 1]], dtype=bool),\n 175:     np.array([[1, 1], [1, 1]], dtype=bool),\n 176: ]\n 177: \n--- generate_input ---\n 260: d