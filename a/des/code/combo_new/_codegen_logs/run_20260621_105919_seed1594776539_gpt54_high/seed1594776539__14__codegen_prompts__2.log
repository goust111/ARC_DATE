sert not (not comps)\n  27:     frame_comp = max(comps, key=lambda d: int(d[\"area\"]))\n  28:     fr0, fc0, fr1, fc1 = map(int, frame_comp[\"bbox\"])\n  29: \n  30:     # The frame is monochrome; use its dominant color as output background.\n  31:     frame_cols = [int(g[int(r), int(c)]) for r, c in frame_comp[\"coords\"]]\n  32:     bgc = int(Counter(frame_cols).most_common(1)[0][0])\n  33: \n  34:     # --- layout = bg holes inside the frame bbox, tight-cropped ---\n  35:     sub = crop_bbox(g, (fr0, fc0, fr1, fc1))\n  36:     hole = sub == int(bg)\n  37:     hole_box = bbox(hole)\n  38:     assert hole_box is not None, \"frame must enclose at least one bg hole\"\n  39:     lr0, lc0, lr1, lc1 = map(int, hole_box)\n  40:     layout = hole[lr0 : lr1 + 1, lc0 : lc1 + 1]\n  41: \n  42:     # --- slot components in the layout ---\n  43:     slots = []\n  44:     for coords in components_mask(layout, connectivity=4):\n  45:         rr0, cc0, rr1, cc1 = bbox_coords(coords)\n  46:         rr0, cc0, rr1, cc1 = map(int, (rr0, cc0, rr1, cc1))\n  47:         h = int(rr1 - rr0 + 1)\n  48:         w = int(cc1 - cc0 + 1)\n  49:         sm = np.zeros((h, w), dtype=bool)\n  50:         sm[coords[:, 0] - rr0, coords[:, 1] - cc0] = True\n  51:         slots.append({\"area\": int(sm.sum()), \"r0\": int(rr0), \"c0\": int(cc0), \"mask\": sm})\n  52:     slots.sort(key=lambda s: (-int(s[\"area\"]), int(s[\"r0\"]), int(s[\"c0\"])))\n  53: \n  54:     assert slots, \"frame must contain at least one slot\"\n  55: \n  56:     # --- pieces = non-singleton foreground components excluding the frame component ---\n  57:     pieces = []\n  58:     for comp in comps:\n  59:         if comp is frame_comp:\n  60:             continue\n  61:         coords = comp[\"coords\"]\n  62:         if coords.size == 0 or int(coords.shape[0]) <= 1:\n  63:             continue\n  64:         pr0, pc0, pr1, pc1 = map(int, comp[\"bbox\"])\n  65:         patch = crop_bbox(g, (pr0, pc0, pr1, pc1))\n  66:         ph, pw = map(int, patch.shape)\n  67:         pm = np.zeros((ph, pw), dtype=bool)\n  68:         pm[coords[:, 0] - pr0, coords[:, 1] - pc0] = True\n  69:         pieces.append({\"area\": int(pm.sum()), \"mask\": pm, \"patch\": patch})\n  70: \n  71:     assert pieces, \"at least one non-frame piece must exist\"\n  72: \n  73:     # --- infer k from the smallest solid square piece ---\n  74:     k = None\n  75:     for p in pieces:\n  76:         h, w = map(int, p[\"mask\"].shape)\n  77:         if h == w and int(p[\"mask\"].sum()) == int(h * w):\n  78:             k = int(h) if k is None else min(int(k), int(h))\n  79:     k = int(k or 1)\n  80: \n  81:     def downsample_blocks(mask: np.ndarray) -> np.ndarray | None:\n  82:         hh, ww = mask.shape\n  83:         if hh % k != 0 or ww % k != 0:\n  84:             return None\n  85:         out_h, out_w = int(hh // k), int(ww // k)\n  86:         out = np.zeros((out_h, out_w), dtype=bool)\n  87:         for r in range(out_h):\n  88:             for c in range(out_w):\n  89:                 block = mask[int(r * k) : int((r + 1) * k), int(c * k) : int((c + 1) * k)]\n  90:                 if bool(block.all()):\n  91:                     out[r, c] = True\n  92:                 elif bool(block.any()):\n  93:                     return None\n  94:         return out\n  95: \n  96:     def dihedral_variants(\n  97:         patch: np.ndarray, mask: np.ndarray\n  98:     ) -> list[tuple[np.ndarray, np.ndarray]]:\n  99:         base = []\n 100:         for kk in range(4):\n 101:             p = np.rot90(patch, int(kk))\n 102:             m = np.rot90(mask, int(kk))\n 103:             base.append((p, m))\n 104:             base.append((np.fliplr(p), np.fliplr(m)))\n 105:         uniq = []\n 106:         seen = set()\n 107:         for p, m in base:\n 108:             key = m.tobytes()\n 109:             if key in seen:\n 110:                 continue\n 111:             seen.add(key)\n 112:             uniq.append((p, m))\n 113:         return uniq\n 114: \n 115:     # Precompute all usable (piece,variant) candidates with their block masks.\n 116:     candidates = []\n 117:     for pi, p in enumerate(pieces):\n 118:         for vp, vm in dihedral_variants(p[\"patch\"], p[\"mask\"]):\n 119:             um = downsample_blocks(vm)\n 120:             if um is None:\n 121:                 continue\n 122:             candidates.append({\"pi\": int(pi), \"area\": int(p[\"area\"]), \"um\": um, \"vp\": vp, \"vm\": vm})\n 123: \n 124:     used_piece: set[int] = set()\n 125:     placements: list[tuple[dict, dict]] = []\n--- generate_input ---\n 492: def generate_input() -> np.ndarray:\n 493:     for _ in range(GENERATE_MAX_RETRIES):\n 494:         res = _gen_attempt()\n 495:         if res is not None:\n 496:             return res\n 497:     raise RuntimeError(\"generate_input: failed to generate after %d attempts\" % GENERATE_MAX_RETRIES)\n\n===== e3721c99.py =====\n--- main ---\n  68: def main(grid: np.ndarray) -> np.ndarray:\n  69:     \"\"\"\n  70:     Recolor grey shapes by matching their hole count to a color legend.\n  71: \n  72:     Input structure:\n  73:     - bg = most common color; grey (5) sprites scattered across the grid.\n  74:     - Colored legend shapes (non-bg, non-grey, at least 2×2, not touching the outer border) near grid edge,\n  75:       each with a distinct number of enclosed holes.\n  76: \n  77:     Rule:\n  78:     - Each colored legend shape defines a mapping: hole count → color.\n  79:     - For every grey sprite, count its holes (enclosed bg regions not touching the sprite's bounding-box border).\n  80:     - Recolor the grey sprite to the matching legend color; erase grey distractors with unlisted hole counts.\n  81: \n  82:     Key insight: Shape identity is encoded by topology (number of holes), not geometry or size.\n  83:     \"\"\"\n  84:     g = np.asarray(grid, dtype=int)\n  85:     bg = get_bg(g)\n  86:     grey = 5\n  87: \n  88:     legend = _legend_mapping(g, bg, grey)\n  89:     assert legend, \"legend mapping must be non-empty: grid must contain colored legend shapes\"\n  90: \n  91:     out = g.copy()\n  92:     for pts in components_mask(g == grey, connectivity=4):\n  93:         r0, c0, r1, c1 = bbox_coords(pts)\n  94:         sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n  95:         for r, c in pts:\n  96:             sub[r - r0, c - c0] = True\n  97:         hc = _hole_count(sub)\n  98:         newc = int(legend[hc]) if hc in legend else bg\n  99:         for r, c in pts:\n 100:             out[r, c] = newc\n 101: \n 102:     return out\n 103: \n 104: # --------------- generator (holes-first organic blob) ---------------\n 105: \n 106: from arc_utils import label_mask\n 107: from scipy.ndimage import binary_dilation, generate_binary_structure\n 108: \n 109: # -- palette & grid --\n 110: BG = 0\n 111: DIV = 1\n 112: GREY = 5\n 113: GRID_SIZE = 30\n 114: LEGEND_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\n 115: \n 116: # -- legend panel --\n 117: LEGEND_COUNT_RANGE = (2, 4)         # number of legend entries\n 118: MAX_HOLE_COUNT = 6                  # hole values drawn from range(MAX_HOLE_COUNT)\n 119: PANEL_SIZE_RANGE = (5, 8)           # panel thickness (cross-axis)\n 120: FULL_LAYOUT_MAX_SPAN = 28          # max legend line span for full-row/col layouts\n 121: L_LAYOUT_MAX_SPAN = 24            # max legend line span for L-shaped layouts\n 122: L_LAYOUT_EXTRA_PADDING = 3        # max random padding along the L arm\n 123: \n 124: # -- sprites --\n 125: TOTAL_SPRITES_RANGE = (8, 11)       # total sprites (matches + distractors)\n 126: MAX_DISTRACTORS = 7                 # max distractor sprites\n 127: MAX_EXTRA_PER_LEGEND = 2            # max extra match sprites per legend entry\n 128: SPRITE_RETRIES = 30                 # retries per sprite generation attempt\n 129: SPRITE_AREA_0 = (5, 25)              # (min, max) area for 0-hole sprites\n 130: SPRITE_AREA_LOW_MIN = 8              # min area for 1-2 hole sprites (max = 25+10*h)\n 131: # 3+ hole sprites: min = 10+2*h, max = 20+4*h\n 132: CANVAS_SCALE = 1.2                  # sqrt(area) multiplier for canvas size\n 133: CANVAS_MIN = 5                      # minimum canvas dimension\n 134: CANVAS_PAD = 2                      # padding added to scaled sqrt for canvas\n 135: HOLE_SEED_RADIUS_FACTOR = 0.45      # radius = factor * sqrt(area)\n 136: HOLE_SEED_MIN_RADIUS = 2\n 137: HOLE_SEED_MIN_SEP = 2               # minimum Chebyshev distance between hole seeds\n 138: HOLE_SEED_MARGIN = 2                # margin from canvas edge for hole seeds\n 139: SEAL_ITERS = 5                      # max iterations for sealing forbidden cells\n 140: SPRITE_MAX_H = 12                   # max sprite bbox height\n 141: SPRITE_MAX_W = 18                   # max sprite bbox width\n 142: SPRITE_MAX_ASPECT = 2.5             # max aspect ratio (max_dim / min_dim)\n 143: \n 144: # -- generation --\n 145: GEN_RETRIES = 300                   # outer retries for generate_input()\n 146: \n 147: # 8-connectivity structuring element for dilation\n 148: _STRUCT8 = generate_binary_structure(2, 2)\n 149: \n 150: \n 151: # ---------- legend helpers ----------\n 152: \n--- generate_input ---\n 600: def generate_input() -> np.ndarray:\n 601:     for _ in range(GEN_RETRIES):\n 602:         try:\n 603:             grid = _gen_attempt()\n 604:         except Exception:\n 605:             grid = None\n 606:         if grid is not None:\n 607:             return grid\n 608:     raise RuntimeError(\"failed to generate e3721c99 input\")\n\n","exit_code":0,"status":"completed"}}
