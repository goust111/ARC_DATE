nel that lies outside the output canvas.\n 289:     marker_squares = _all_marker_panel_squares(g)\n 290:     assert marker_squares, \"no marker panel found\"\n 291: \n 292:     # Anchor alignment (ignore internal full-height/full-width 6 separators inside main).\n 293:     eff_h, eff_w = main.shape\n 294:     full6_cols = [c for c in range(eff_w) if np.all(main[:, c] == 6)]\n 295:     if full6_cols:\n 296:         eff_w = min(full6_cols)\n 297:     full6_rows = [r for r in range(eff_h) if np.all(main[r, :] == 6)]\n 298:     if full6_rows:\n 299:         eff_h = min(full6_rows)\n 300: \n 301:     out = main.copy()\n 302:     composite_written = np.zeros(out.shape, dtype=bool)\n 303: \n 304:     for marker_r0, marker_c0 in marker_squares:\n 305:         # Ignore marker panels inside the output canvas; only legends should drive drawing.\n 306:         if canvas_c0 <= marker_c0 < canvas_c1:\n 307:             continue\n 308: \n 309:         if marker_c0 + 5 > w:\n 310:             continue\n 311:         panel = g[:, marker_c0 : marker_c0 + 5]\n 312: \n 313:         unit = _extract_unit_sprite(panel)\n 314:         if unit is None:\n 315:             continue\n 316:         unit_sprite, unit_bb = unit\n 317: \n 318:         frame_bb = _extract_frame_bbox(panel, unit_bb, marker_r0)\n 319:         if frame_bb is None:\n 320:             continue\n 321:         fr0, fc0, fr1, fc1 = frame_bb\n 322:         frame = panel[fr0 : fr1 + 1, fc0 : fc1 + 1]\n 323:         frame_mask0 = (frame != 0) & (frame != 6)\n 324:         _, n8 = _scipy_label(frame_mask0, structure=np.ones((3, 3)))\n 325:         assert n8 == 1, f\"frame must be 8-connected, got {n8} components\"\n 326: \n 327:         # Rotate layout according to clockhand.\n 328:         dir_k = _rotation_from_clockhand(g, marker_r0, marker_c0)  # up=0, right=1, down=2, left=3\n 329:         frame_mask = np.rot90(frame_mask0, (-dir_k) % 4)\n 330: \n 331:         # Build composite by tiling the unit sprite into active frame 