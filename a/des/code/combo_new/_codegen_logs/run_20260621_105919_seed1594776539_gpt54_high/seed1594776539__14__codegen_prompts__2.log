\n 128: # Palette constants.\n 129: BG = 0\n 130: CONNECTOR_BLUE = 1\n 131: FRAME_RED = 2\n 132: INTERIOR_COLORS = [3, 4, 5, 6, 7, 8, 9]\n 133: \n 134: # Canvas and frame bounds.\n 135: FRAME_COUNT_RANGE = (3, 5)\n 136: FRAME_SIZE_CHOICES = [5, 7]\n 137: SMALL_FRAME_GRID_H_RANGE = (20, 27)\n 138: SMALL_FRAME_GRID_W_RANGE = (21, 27)\n 139: LARGE_FRAME_GRID_H_RANGE = (22, 27)\n 140: LARGE_FRAME_GRID_W_RANGE = (23, 27)\n 141: FRAME_GAP = 1\n 142: \n 143: # Interior mask density.\n 144: MIN_INTERIOR_FILL = 0.30\n 145: MAX_INTERIOR_FILL = 0.56\n 146: MIN_INTERIOR_CELLS = 3\n 147: \n 148: # Angular placement.\n 149: ANGLE_PERTURB_RANGE = (-0.3, 0.3)\n 150: MIN_RADIUS_PAD = 1\n 151: MAX_RADIUS_PAD = 1\n 152: ANGLE_EPS = 1e-6\n 153: \n 154: # Connector constraints and retry budgets.\n 155: MAX_TWO_TURN_TRIES = 20\n 156: CONNECTOR_LENGTH_RANGE = (2, 24)\n 157: GENERATION_ATTEMPTS = 300\n 158: \n 159: NEIGHBORS_8 = [\n 160:     (dr, dc)\n 161:     for dr in range(-1, 2)\n 162:     for dc in range(-1, 2)\n 163:     if not (dr == 0 and dc == 0)\n 164: ]\n 165: \n 166: \n--- generate_input ---\n 522: def generate_input():\n 523:     for _ in range(GENERATION_ATTEMPTS):\n 524:         result = _gen_attempt()\n 525:         if result is not None:\n 526:             return result\n 527:     raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n\n===== 2b83f449.py =====\n--- main ---\n   9: def main(grid: np.ndarray) -> np.ndarray:\n  10:     \"\"\"\n  11:     Simulate tokens falling through a pipe network after gates rotate open.\n  12: \n  13:     Input structure:\n  14:     - Wall (0), bg (pipe fill), gate (horizontal 1×3 bars), token (small edge pixels).\n  15: \n  16:     Rule:\n  17:     - Rotate each gate into a vertical blocker; gate cells become bg.\n  18:     - Tokens drop downward through bg, choosing the extreme column for their side (left→min, right→max).\n  19:     - Tokens settle at true pipe ends (adjacent to wall/boundary), packing inward.\n  20: \n  21:     Key insight: Tokens select drop columns by entry side and land at wall-bounded endpoints, ignoring blocker-bounded ones.\n  22:     \"\"\"\n  23:     g = np.array(grid, dtype=int)\n  24:     H, W = g.shape\n  25:     colors = set(map(int, g.flatten()))\n  26: \n  27:     # --- infer gate color: any color forming 4-ccs of size 3 with bbox 1x3 (horizontal) ---\n  28:     gate = None\n  29:     for col in sorted(colors):\n  30:         if int(col) == 0:\n  31:             continue\n  32:         lab, n = label_mask(g == int(col), connectivity=4)\n  33:         found = False\n  34:         for k in range(1, int(n) + 1):\n  35:             pts = np.argwhere(lab == int(k))\n  36:             if int(pts.shape[0]) != 3:\n  37:                 continue\n  38:             r0, c0 = pts.min(axis=0)\n  39:             r1, c1 = pts.max(axis=0)\n  40:             if int(r1 - r0 + 1) == 1 and int(c1 - c0 + 1) == 3:\n  41:                 found = True\n  42:                 break\n  43:         if found:\n  44:             gate = int(col)\n  45:             break\n  46:     assert not (gate is None)\n  47: \n  48:     # --- token/bg inference ---\n  49:     cnt_all = Counter(map(int, g.flatten()))\n  50:     cand_token = [c for c in colors if int(c) not in (0, int(gate))]\n  51:     assert not (not cand_token)\n  52:     token = int(min(cand_token, key=lambda c: (int(cnt_all[int(c)]), int(c))))\n  53:     cand_bg = [c for c in colors if int(c) not in (0, int(gate), int(token))]\n  54:     assert cand_bg\n  55:     bg = int(max(cand_bg, key=lambda c: (int(cnt_all[int(c)]), -int(c))))\n  56: \n  57:     # --- opened gate color (vertical post) ---\n  58:     open_col = 6 if int(gate) == 7 and 6 not in colors else int(gate - 1) if int(gate) > 0 else 6\n  59: \n  60:     # --- rotate gates (gates open into bg, center becomes vertical open_col) ---\n  61:     out = g.copy()\n  62:     lab, n = label_mask(out == int(gate), connectivity=4)\n  63:     for k in range(1, int(n) + 1):\n  64:         pts = np.argwhere(lab == int(k))\n  65:         if int(pts.shape[0]) != 3:\n  66:             continue\n  67:         r0, c0 = pts.min(axis=0)\n  68:         r1, c1 = pts.max(axis=0)\n  69:         if int(r1 - r0 + 1) != 1 or int(c1 - c0 + 1) != 3:\n  70:             continue\n  71:         r = int(r0)\n  72:         c0 = int(c0)\n  73:         center_c = int(c0 + 1)\n  74:         out[int(r), int(c0) : int(c0) + 3] = int(bg)\n  75:         for rr in (int(r - 1), int(r), int(r + 1)):\n  76:             if 0 <= int(rr) < H:\n  77:                 out[int(rr), int(center_c)] = int(open_col)\n  78: \n  79:     # helpers\n  80:     def segments_in_row(r: int) -> list[tuple[int, int]]:\n  81:         segs: list[tuple[int, int]] = []\n  82:         c = 0\n  83:         while c < W:\n  84:             if int(out[r, c]) != int(bg):\n  85:                 c += 1; continue\n  86:             c0 = c\n  87:             while c + 1 < W and int(out[r, c + 1]) == int(bg):\n  88:                 c += 1\n  89:             segs.append((c0, c)); c += 1\n  90:         return segs\n  91: \n  92:     def find_seg(segs: list[tuple[int, int]], c: int) -> tuple[int, int] | None:\n  93:         for a, b in segs:\n  94:             if a <= c <= b: return (a, b)\n  95:         return None\n  96: \n  97:     def seg_exit(r: int, seg: tuple[int, int]) -> int | None:\n  98:         \"\"\"Return the single exit column, or None. Assert if >1 exit.\"\"\"\n  99:         a, b = seg\n 100:         if r + 2 >= H: return None\n 101:         drops = [c for c in range(a, b + 1)\n 102:                  if int(out[r + 1, c]) == int(bg) and int(out[r + 2, c]) == int(bg)]\n 103:         assert len(drops) <= 1, f\"segment ({a},{b}) at row {r} has {len(drops)} exits: {drops}\"\n 104:         return drops[0] if drops else None\n 105: \n 106:     def entry_from_above(r: int, seg: tuple[int, int]) -> int | None:\n 107:         \"\"\"Return the single entry column from the wall