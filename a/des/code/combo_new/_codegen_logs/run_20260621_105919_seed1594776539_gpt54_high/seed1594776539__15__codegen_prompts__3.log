{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nfrom collections import Counter\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed1594776539/15/3.py')\nmod = SourceFileLoader('new_arc_task_stats', str(p)).load_module()\n\ndef count_loops(grid):\n    g = np.asarray(grid)\n    seen = np.zeros_like(g, dtype=bool)\n    h, w = g.shape\n    total = 0\n    for r in range(h):\n        for c in range(w):\n            if g[r, c] == 0 or seen[r, c]:\n                continue\n            total += 1\n            color = int(g[r, c])\n            stack = [(r, c)]\n            seen[r, c] = True\n            while stack:\n                rr, cc = stack.pop()\n                for nr, nc in ((rr-1, cc), (rr+1, cc), (rr, cc-1), (rr, cc+1)):\n                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:\n                        seen[nr, nc] = True\n                        stack.append((nr, nc))\n    return total\n\ncounts = Counter(count_loops(mod.generate_input()) for _ in range(60))\nprint(dict(sorted(counts.items())))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
