.py:7:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py:20:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py:427:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/230f2e48.py:18:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/230f2e48.py:19:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/230f2e48.py:38:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/230f2e48.py:165:    \"\"\"Return fixed-arm and fold steps, or None for a centered hinge.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/230f2e48.py:286:    \"\"\"Sample non-touching rods and their fold envelopes for one grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/230f2e48.py:327:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/d93c6891.py:83:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/d93c6891.py:84:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d93c6891.py:101:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d93c6891.py:178:    \"\"\"Try to place an orange rect flush against the given edge. Returns (or0,oc0,or1,oc1) or None.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d93c6891.py:302:    \"\"\"Sample gray bars and return oracle metadata for expected output.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d93c6891.py:397:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:7:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:8:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:21:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:133:        \"\"\"Recolor a blob to red when first hit by a ray; enqueue it to emit its ports.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:156:        \"\"\"Extend a ray from each port pixel until boundary or blob hit.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:232:    \"\"\"Build a boolean diamond/octagon mask for the given (h, w) shape.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:242:    \"\"\"Coordinate perpendicular to direction d (column for vertical, row for horizontal).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:247:    \"\"\"Coordinate along direction d (row for vertical, column for horizontal).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:252:    \"\"\"Sort coordinates by their perpendicular value relative to direction d.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:257:    \"\"\"Return sorted mask-local coordinates on the edge facing direction d.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:266:    \"\"\"Build a blob specification dict for a given shape and port direction, or None if invalid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:299:    \"\"\"Generate all valid blob specs, optionally filtered by port direction, in shuffled order.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:307:    \"\"\"Dilate a boolean mask by 1 pixel in all 8 directions.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:319:    \"\"\"Translate local offsets to global coordinates.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:331:    \"\"\"Trace ray lanes from starts to entries; return cell list or None on failure.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:351:    \"\"\"Trace ray lanes from starts to grid boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:366:    \"\"\"Paint cells red in the output grid and mark them in the ray mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:378:    \"\"\"Find all valid placements for a blob spec along the ray's travel axis.\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:382:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:440:    \"\"\"Find a random valid placement for the next blob in the cascade chain.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py:472:    \"\"\"Paste a blob's patch onto the input grid and