{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/21897d95.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/a2d730bd.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg, paste, random_free_location\nimport random\n\n\nCoord = tuple[int, int]\n\n\ndef _claim(g: np.ndarray, claims: dict[Coord, int], coord: Coord, color: int, bg: int) -> None:\n    h, w = g.shape\n    r, c = coord\n    assert 0 <= r < h and 0 <= c < w, (coord, g.shape)\n    assert int(g[r, c]) in (bg, color), (coord, int(g[r, c]), bg, color)\n    previous = claims.get(coord)\n    assert previous is None or previous == color, (coord, previous, color)\n    claims[coord] = color\n\n\ndef _claim_range(\n    g: np.ndarray,\n    claims: dict[Coord, int],\n    start: Coord,\n    end: Coord,\n    step: Coord,\n    skip: Coord,\n    color: int,\n    bg: int,\n) -> None:\n    r, c = start\n    er, ec = end\n    dr, dc = step\n    while True:\n        if (r, c) != skip:\n            _claim(g, claims, (r, c), color, bg)\n        if (r, c) == (er, ec):\n            break\n        r += dr\n        c += dc\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extend each solid foreground rectangle toward its same-color isolated pixels with capped one-cell paths, clearing each original marker pixel.\n\n    Input structure\n    - The background is the dominant color.\n    - Each foreground color has exactly one solid rectangular object and one or more isolated same-color marker pixels.\n    - Every marker is horizontally or vertically aligned with the rectangle bbox and lies outside it.\n    Rule\n    - For each marker, draw a one-cell-wide straight path from the adjacent side of the rectangle through one cell beyond the marker.\n    - Add a three-pixel perpendicular cap at the rectangle end and around the marker endpoint.\n    - Recolor the original marker pixel to background.\n    Key insight\n    - The isolated pixels are not copied; they mark the hollow endpoints of capped protrusions grown from their matching rectangle.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert components\n\n    by_color: dict[int, list[dict]] = {}\n    for comp in components:\n        by_color.setdefault(int(comp[\"color\"]), []).append(comp)\n\n    claims: dict[Coord, int] = {}\n    clears: set[Coord] = set()\n\n    for color, comps in by_color.items():\n        rectangles = [comp for comp in comps if int(comp[\"area\"]) > 1]\n        markers = [comp for comp in comps if int(comp[\"area\"]) == 1]\n        assert len(rectangles) == 1, (color, [(comp[\"area\"], comp[\"bbox\"]) for comp in comps])\n        assert markers and len(rectangles) + len(markers) == len(comps)\n\n        rect = rectangles[0]\n        r0, c0, r1, c1 = map(int, rect[\"bbox\"])\n        rect_h = r1 - r0 + 1\n        rect_w = c1 - c0 + 1\n        assert int(rect[\"area\"]) == rect_h * rect_w\n        assert min(rect_h, rect_w) >= 2\n\n        for marker in markers:\n            mr, mc = map(int, marker[\"coords\"][0])\n            horizontal = r0 <= mr <= r1 and (mc < c0 or mc > c1)\n            vertical = c0 <= mc <= c1 and (mr < r0 or mr > r1)\n            assert horizontal ^ vertical, (color, (mr, mc), rect[\"bbox\"])\n\n            if horizontal:\n                dc = -1 if mc < c0 else 1\n                side_c = c0 - 1 if dc < 0 else c1 + 1\n                for rr in (mr - 1, mr, mr + 1):\n                    _claim(g, claims, (rr, side_c), color, bg)\n                for rr in (mr - 1, mr + 1):\n                    _claim(g, claims, (rr, mc), color, bg)\n                _claim_range(\n                    g,\n                    claims,\n                    (mr, side_c),\n                    (mr, mc + dc),\n                    (0, dc),\n                    (mr, mc),\n                    color,\n                    bg,\n                )\n            else:\n                dr = -1 if mr < r0 else 1\n                side_r = r0 - 1 if dr < 0 else r1 + 1\n                for cc in (mc - 1, mc, mc + 1):\n                    _claim(g, claims, (side_r, cc), color, bg)\n                for cc in (mc - 1, mc + 1):\n                    _claim(g, claims, (mr, cc), color, bg)\n                _claim_range(\n                    g,\n                    claims,\n                    (side_r, mc),\n                    (mr + dr, mc),\n                    (dr, 0),\n                    (mr, mc),\n                    color,\n                    bg,\n                )\n\n            clears.add((mr, mc))\n\n    assert not (set(claims) & clears)\n\n    out = g.copy()\n    for (r, c), color in claims.items():\n        out[r, c] = color\n    for r, c in clears:\n        out[r, c] = bg\n    return out\n\n# --------------- generator (att2) ---------------\n\nGRID_ROWS = (13, 30)\nGRID_COLS = (16, 30)\nPALETTE = tuple(range(10))\nFOREGROUND_COLOR_COUNT = (1, 3)\nRECT_SIZE = (2, 11)\nMARKER_COUNT = (1, 3)\nMARKER_DISTANCE = (3, 10)\nSAME_SIDE_MARKER_GAP = 3\nSIDES = (\"top\", \"bottom\", \"left\", \"right\")\nPATCH_ATTEMPTS = 80\nPLACEMENT_ATTEMPTS = 30\nGENERATE_ATTEMPTS = 300\n\ndef _gen_marker_cells(rect_h: int, rect_w: int, side: str, offset: int, dist: int):\n    cells: set[tuple[int, int]] = set()\n    if side == \"top\":\n        marker = (-dist, offset)\n        for cc in range(offset - 1, offset + 2):\n            cells.add((-1, cc))\n        for rr in range(-1, -dist - 2, -1):\n            if rr != marker[0]:\n                cells.add((rr, offset))\n        cells.add((marker[0], offset - 1))\n        cells.add((marker[0], offset + 1))\n    elif side == \"bottom\":\n        marker = (rect_h - 1 + dist, offset)\n        for cc in range(offset - 1, offset + 2):\n            cells.add((rect_h, cc))\n        for rr in range(rect_h, marker[0] + 2):\n            if rr != marker[0]:\n                cells.add((rr, offset))\n        cells.add((marker[0], offset - 1))\n        cells.add((marker[0], offset + 1))\n    elif side == \"left\":\n        marker = (offset, -dist)\n        for rr in range(offset - 1, offset + 2):\n            cells.add((rr, -1))\n        for cc in range(-1, -dist - 2, -1):\n            if cc != marker[1]:\n                cells.add((offset, cc))\n        cells.add((offset - 1, marker[1]))\n        cells.add((offset + 1, marker[1]))\n    else:\n        marker = (offset, rect_w - 1 + dist)\n        for rr in range(offset - 1, offset + 2):\n            cells.add((rr, rect_w))\n        for cc in range(rect_w, marker[1] + 2):\n            if cc != marker[1]:\n                cells.add((offset, cc))\n        cells.add((offset - 1, marker[1]))\n        cells.add((offset + 1, marker[1]))\n    return marker, cells\n\n\ndef _updated_margins(\n    margins: tuple[int, int, int, int],\n    side: str,\n    dist: int,\n) -> tuple[int, int, int, int]:\n    top_extra, bottom_extra, left_extra, right_extra = margins\n    if side == \"top\":\n        top_extra = max(top_extra, dist + 1)\n    elif side == \"bottom\":\n        bottom_extra = max(bottom_extra, dist + 1)\n    elif side == \"left\":\n        left_extra = max(left_extra, dist + 1)\n    else:\n        right_extra = max(right_extra, dist + 1)\n    return top_extra, bottom_extra, left_extra, right_extra\n\n\ndef _gen_marker_options(grid_h, grid_w, rect_h, rect_w, side_offsets, margins, markers, protrusions):\n    options = []\n    for side in SIDES:\n        offsets = range(1, rect_w - 1) if side in (\"top\", \"bottom\") else range(1, rect_h - 1)\n        for offset in offsets:\n            if any(abs(offset - old) < SAME_SIDE_MARKER_GAP for old in side_offsets[side]):\n                continue\n            for dist in range(MARKER_DISTANCE[0], MARKER_DISTANCE[1] + 1):\n                next_margins = _updated_margins(margins, side, dist)\n                ntop, nbottom, nleft, nright = next_margins\n                if ntop + rect_h + nbottom > grid_h:\n                    continue\n                if nleft + rect_w + nright > grid_w:\n                    continue\n                marker, cells = _gen_marker_cells(rect_h, rect_w, side, offset, dist)\n                if marker in protrusions:\n                    continue\n                if any(cell in markers for cell in cells):\n                    continue\n                if protrusions & cells:\n                    continue\n                options.append((side, offset, dist, marker, cells, next_margins))\n    return options\n\n\ndef _gen_make_patch(grid_h: int, grid_w: int, color: int, bg: int):\n    for _ in range(PATCH_ATTEMPTS):\n        rect_h = random.randint(RECT_SIZE[0], min(RECT_SIZE[1], grid_h))\n        rect_w = random.randint(RECT_SIZE[0], min(RECT_SIZE[1], grid_w))\n        if rect_h == 2 and rect_w == 2:\n            continue\n\n        marker_n = random.randint(MARKER_COUNT[0], MARKER_COUNT[1])\n        side_offsets: dict[str, list[int]] = {side: [] for side in SIDES}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/21897d95.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter, deque\nimport numpy as np\n\nfrom arc_utils import label_mask\nimport random\n\n\nDIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))\nUP = (-1, 0)\nDOWN = (1, 0)\nRIGHT = (0, 1)\n\n\nclass _DSU:\n    def __init__(self, n: int):\n        self.parent = list(range(int(n)))\n\n    def find(self, x: int) -> int:\n        x = int(x)\n        while self.parent[x] != x:\n            self.parent[x] = self.parent[self.parent[x]]\n            x = self.parent[x]\n        return int(x)\n\n    def union(self, a: int, b: int) -> None:\n        ra = self.find(a)\n        rb = self.find(b)\n        if ra != rb:\n            self.parent[rb] = ra\n\n\ndef _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:\n    return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])\n\n\ndef _opp(d: tuple[int, int]) -> tuple[int, int]:\n    return (-int(d[0]), -int(d[1]))\n\n\ndef _stem_from_branches(branches: list[tuple[int, int]]) -> tuple[int, int]:\n    assert len(branches) == 3\n    branch_set = set(branches)\n    for d in branches:\n        if _opp(d) not in branch_set:\n            return d\n    raise AssertionError(\"T marker has no single stem\")\n\n\ndef _parse_tetromino(cells: set[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int], list[tuple[int, int]]] | None:\n    if len(cells) != 4:\n        return None\n    for r, c in cells:\n        branches = [(dr, dc) for dr, dc in DIRS if (r + dr, c + dc) in cells]\n        if len(branches) != 3:\n            continue\n        stem = _stem_from_branches(branches)\n        expected = {(r, c), (r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)}\n        expected.remove((r - stem[0], c - stem[1]))\n        if cells == expected:\n            bar = [d for d in branches if d != stem]\n            assert len(bar) == 2 and bar[0] == _opp(bar[1])\n            return (int(r), int(c)), stem, bar\n    return None\n\n\ndef _label_base_components(g: np.ndarray, control: np.ndarray) -> tuple[np.ndarray, list[int], list[int]]:\n    comp_id = np.full(g.shape, -1, dtype=int)\n    comp_colors: list[int] = []\n    comp_areas: list[int] = []\n    cid = 0\n    for col in sorted(set(map(int, g.ravel())) - {1}):\n        labels, n_labels = label_mask((g == col) & (~control), connectivity=4)\n        for k in range(1, int(n_labels) + 1):\n            coords = np.argwhere(labels == k)\n            if coords.size == 0:\n                continue\n            for rr, cc in coords:\n                comp_id[int(rr), int(cc)] = cid\n            comp_colors.append(int(col))\n            comp_areas.append(int(len(coords)))\n            cid += 1\n    return comp_id, comp_colors, comp_areas\n\n\ndef _solve_unrotated(g: np.ndarray) -> np.ndarray:\n    labels_1, n_1 = label_mask(g == 1, connectivity=4)\n    one_components = {\n        k: {tuple(map(int, xy)) for xy in np.argwhere(labels_1 == k)}\n        for k in range(1, int(n_1) + 1)\n    }\n    one_sizes = {k: len(cells) for k, cells in one_components.items()}\n\n    markers: list[dict] = []\n    used_ones: set[tuple[int, int]] = set()\n    control = np.zeros(g.shape, dtype=bool)\n\n    for cells in one_components.values():\n        parsed = _parse_tetromino(cells)\n        if parsed is None:\n            continue\n        center, stem, bar = parsed\n        markers.append({\"kind\": \"normal\", \"center\": center, \"stem\": stem, \"bar\": bar, \"cells\": cells})\n        used_ones |= cells\n        for r, c in cells:\n            control[r, c] = True\n\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n            if int(g[r, c]) == 1:\n                continue\n            branches: list[tuple[int, int]] = []\n            cells: list[tuple[int, int]] = []\n            ok = True\n            for d in DIRS:\n                rr, cc = r + d[0], c + d[1]\n                if not _in_bounds(g.shape, rr, cc) or int(g[rr, cc]) != 1:\n                    continue\n                label = int(labels_1[rr, cc])\n                if one_sizes[label] == 1 and (rr, cc) not in used_ones:\n                    branches.append(d)\n                    cells.append((rr, cc))\n                else:\n                    ok = False\n            if ok and len(branches) == 3:\n                stem = _stem_from_branches(branches)\n                bar = [d for d in branches if d != stem]\n                assert len(bar) == 2 and bar[0] == _opp(bar[1])\n                marker_cells = set(cells) | {(int(r), int(c))}\n                markers.append(\n                    {\n                        \"kind\": \"colored\",\n                        \"center\": (int(r), int(c)),\n                        \"stem\": stem,\n                        \"bar\": bar,\n                        \"cells\": marker_cells,\n                        \"target_color\": int(g[r, c]),\n                    }\n                )\n                used_ones |= set(cells)\n                for rr, cc in marker_cells:\n                    control[rr, cc] = True\n\n    all_one_cells = {tuple(map(int, xy)) for xy in np.argwhere(g == 1)}\n    assert all_one_cells == used_ones, \"all color-1 pixels must belong to a T control marker\"\n\n    for col in sorted(set(map(int, g.ravel())) - {1}):\n        labels, n_labels = label_mask((g == col) & (~control), connectivity=4)\n        for k in range(1, int(n_labels) + 1):\n            coords = np.argwhere(labels == k)\n            if len(coords) > 5:\n                continue\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            if len(coords) == (int(r1) - int(r0) + 1) * (int(c1) - int(c0) + 1):\n                continue\n            cells = {tuple(map(int, xy)) for xy in coords}\n            markers.append({\"kind\": \"small\", \"cells\": cells})\n            for rr, cc in cells:\n                control[rr, cc] = True\n\n    comp_id, comp_colors, comp_areas = _label_base_components(g, control)\n    assert comp_colors, \"at least one base region is required\"\n    dsu = _DSU(len(comp_colors))\n\n    def first_component_from(center: tuple[int, int], direction: tuple[int, int], start: int) -> int | None:\n        r, c = center\n        step = int(start)\n        while True:\n            rr = r + direction[0] * step\n            cc = c + direction[1] * step\n            if not _in_bounds(g.shape, rr, cc):\n                return None\n            if comp_id[rr, cc] >= 0:\n                return int(comp_id[rr, cc])\n            step += 1\n\n    def adjacent_component_counts(cells: set[tuple[int, int]]) -> Counter:\n        counts: Counter = Counter()\n        for r, c in cells:\n            for dr, dc in DIRS:\n                rr, cc = r + dr, c + dc\n                if _in_bounds(g.shape, rr, cc) and comp_id[rr, cc] >= 0:\n                    counts[int(comp_id[rr, cc])] += 1\n        return counts\n\n    for marker in markers:\n        if marker[\"kind\"] in {\"normal\", \"colored\"}:\n            center = marker[\"center\"]\n            stem = marker[\"stem\"]\n            dest = first_component_from(center, stem, start=2)\n            assert dest is not None, \"T marker must point at a destination region\"\n\n            source_parts: list[int] = []\n            for bar_dir in marker[\"bar\"]:\n                rr = center[0] + stem[0] + bar_dir[0]\n                cc = center[1] + stem[1] + bar_dir[1]\n                assert _in_bounds(g.shape, rr, cc) and comp_id[rr, cc] >= 0\n                source_parts.append(int(comp_id[rr, cc]))\n            source = source_parts[0]\n            for part in source_parts[1:]:\n                assert comp_colors[part] == comp_colors[source], \"T source diagonals must share a color\"\n                dsu.union(source, part)\n\n            for comp in adjacent_component_counts(marker[\"cells\"]):\n                if comp_colors[comp] == comp_colors[source]:\n                    dsu.union(source, comp)\n            marker[\"dest_comp\"] = dest\n            marker[\"source_comp\"] = source\n        else:\n            counts = adjacent_component_counts(marker[\"cells\"])\n            assert counts, \"small marker must touch its owner region\"\n            owner = max(counts, key=lambda c: (counts[c], comp_areas[c]))\n            for comp in counts:\n                if comp_colors[comp] == comp_colors[owner]:\n                    dsu.union(owner, comp)\n            marker[\"source_comp\"] = owner\n\n    root_color: dict[int, int] = {}\n    for i, col in enumerate(comp_colors):\n        root = dsu.find(i)\n        root_color.setdefault(root, int(col))\n        assert root_color[root] == int(col), \"merged region colors must match\"\n\n    final_color = dict(root_color)\n    for marker in markers:\n        if marker[\"kind\"] not in {\"normal\", \"colored\"}:\n            marker[\"source\"] = dsu.find(marker[\"source_comp\"])\n            continue\n        dest = dsu.find(marker[\"dest_comp\"])\n        source = dsu.find(marker[\"source_comp\"])\n        marker[\"source\"] = source\n        replacement = int(marker[\"target_color\"]) if marker[\"kind\"] == \"colored\" else int(root_color[source])\n        assert final_color[dest] in {root_color[dest], replacement}, \"conflicting T controls for one region\"\n        final_color[dest] = replacement\n\n    out = np.full(g.shape, -1, dtype=int)\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n","exit_code":0,"status":"completed"}}
