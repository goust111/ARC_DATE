{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport itertools\nimport random\n\n\nMARKER_COLOR = 1\nBODY_COLOR = 2\n\n\ndef _vertical_bars(g: np.ndarray, bg: int) -> list[dict]:\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    bars = []\n    baseline = None\n    for comp in comps:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert c0 == c1\n        coords = comp[\"coords\"]\n        height = r1 - r0 + 1\n        assert comp[\"area\"] == height\n        assert {(int(r), int(c)) for r, c in coords} == {(r, c0) for r in range(r0, r1 + 1)}\n        if baseline is None:\n            baseline = r1\n        else:\n            assert r1 == baseline\n        bars.append(\n            {\n                \"color\": int(comp[\"color\"]),\n                \"col\": int(c0),\n                \"bottom\": int(r1),\n                \"height\": int(height),\n                \"coords\": coords,\n            }\n        )\n\n    assert bars\n    return sorted(bars, key=lambda b: b[\"col\"])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n    Input structure\n    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n    Rule\n    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n    - Red bars that are not reached from a blue marker remain unchanged.\n    Key insight\n    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g))) - {bg}\n    assert colors <= {MARKER_COLOR, BODY_COLOR}\n    assert MARKER_COLOR in colors\n\n    bars = _vertical_bars(g, bg)\n    by_col = {bar[\"col\"]: bar for bar in bars}\n    assert len(by_col) == len(bars)\n\n    baselines = {bar[\"bottom\"] for bar in bars}\n    assert len(baselines) == 1\n    baseline = baselines.pop()\n    out = g.copy()\n    for bar in bars:\n        if bar[\"color\"] != MARKER_COLOR:\n            continue\n\n        group = [bar]\n        current = bar\n        while True:\n            next_col = current[\"col\"] + current[\"height\"]\n            next_bar = by_col.get(next_col)\n            if next_bar is None:\n                break\n            if next_bar[\"color\"] != BODY_COLOR:\n                break\n            group.append(next_bar)\n            current = next_bar\n\n        for item in group:\n            rows = item[\"coords\"][:, 0]\n            cols = item[\"coords\"][:, 1]\n            out[rows, cols] = bg\n\n        for item in group:\n            col = item[\"col\"]\n            height = item[\"height\"]\n            assert col + height <= g.shape[1]\n            out[baseline, col : col + height] = item[\"color\"]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nMIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n\n# Bar and chain structure.\nMIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\nMIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\nMIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n\n# Layout padding and retry budget.\nGAP_VALUES = (1, 2, 3)\nMAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n\n\ndef _chain_red_distributions(n_blue, n_red):\n    \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n    return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n\n\ndef _bounded_tuples(values, n, max_sum):\n    \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n    return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n\n\ndef _sample_groups():\n    \"\"\"Sample row count and bar groups before physical layout.\"\"\"\n    rows = random.randint(MIN_ROWS, MAX_ROWS)\n    max_height = min(MAX_BAR_HEIGHT, rows)\n    n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)\n    max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)\n    red_total = random.randint(MIN_RED_BARS, max_red)\n    min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)\n    max_unchained = min(MAX_UNCHAINED_RED, red_total)\n    n_unchained = random.randint(min_unchained, max_unchained)\n\n    distributions = _chain_red_distributions(n_blue, red_total - n_unchained)\n    if not distributions:\n        return None\n\n    groups = [\n        {\"kind\": \"chain\", \"colors\": [MARKER_COLOR] + [BODY_COLOR] * n_red}\n        for n_red in random.choice(distributions)\n    ]\n    groups.extend({\"kind\": \"unchained\", \"colors\": [BODY_COLOR]} for _ in range(n_unchained))\n    random.shuffle(groups)\n    if groups[0][\"kind\"] == \"unchained\":\n        for i, group in enumerate(groups):\n            if group[\"kind\"] == \"chain\":\n                groups[0], groups[i] = groups[i], groups[0]\n                break\n    return rows, max_height, groups\n\n\ndef _sample_layout(max_height, groups):\n    \"\"\"Sample gaps, heights, margins, and positioned bar columns.\"\"\"\n    n_bars = sum(len(group[\"colors\"]) for group in groups)\n    right_margin = random.randint(0, MAX_RIGHT_MARGIN)\n\n    gap_count = len(groups) - 1\n    if gap_count:\n        max_gap_sum = MAX_WIDTH - right_margin - MIN_BAR_HEIGHT * n_bars\n        gap_options = _bounded_tuples(GAP_VALUES, gap_count, max_gap_sum)\n        if not gap_options:\n            return None\n        gaps = list(random.choice(gap_options))\n    else:\n        gaps = []\n\n    height_options = _bounded_tuples(\n        tuple(range(MIN_BAR_HEIGHT, max_height + 1)),\n        n_bars,\n        MAX_WIDTH - right_margin - sum(gaps),\n    )\n    if not height_options:\n        return None\n    heights = list(random.choice(height_options))\n\n    idx = 0\n    for group in groups:\n        count = len(group[\"colors\"])\n        group[\"heights\"] = heights[idx : idx + count]\n        idx += count\n\n    span = sum(heights) + sum(gaps)\n    min_left = max(0, MIN_WIDTH - right_margin - span)\n    max_left = MAX_WIDTH - right_margin - span\n    if min_left > max_left:\n        return None\n    if min_left <= min(MAX_RANDOM_LEFT_MARGIN, max_left):\n        left_margin = random.randint(min_left, min(MAX_RANDOM_LEFT_MARGIN, max_left))\n    else:\n        left_margin = min_left\n\n    width = left_margin + span + right_margin\n    if not (MIN_WIDTH <= width <= MAX_WIDTH):\n        return None\n\n    bars = []\n    col = left_margin\n    gap_i = 0\n    for group_i, group in enumerate(groups):\n        chained = group[\"kind\"] == \"chain\"\n        for color, height in zip(group[\"colors\"], group[\"heights\"]):\n            bars.append(\n                {\n                    \"color\": color,\n                    \"height\": height,\n                    \"col\": col,\n                    \"chained\": chained,\n                }\n            )\n            col += height\n        if group_i + 1 < len(groups):\n            col += gaps[gap_i]\n            gap_i += 1\n\n    if col + right_margin != width:\n        return None\n    return bars, width\n\n\ndef _render_pair(rows, width, bars):\n    \"\"\"Render the sampled input grid and its expected transformed output.\"\"\"\n    baseline = rows - 1\n    inp = np.zeros((rows, width), dtype=int)\n    out = np.zeros_like(inp)\n    for bar in bars:\n        color, height, col = bar[\"color\"], bar[\"height\"], bar[\"col\"]\n        vertical = slice(baseline - height + 1, baseline + 1)\n        inp[vertical, col] = color\n        if bar[\"chained\"]:\n            out[baseline, col : col + height] = color\n        else:\n            out[vertical, col] = color\n    return inp, out\n\n\ndef _passes_oracle(inp, expected):\n    \"\"\"Return whether the solver accepts and matches the rendered output.\"\"\"\n    try:\n        actual = main(inp)\n    except Exception:\n        return False\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/db7260a4.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg, paste\n\n\ndef _closed_u_containers(g: np.ndarray, wall_color: int, bg: int) -> list[tuple[int, int, int, int]]:\n    h, w = g.shape\n    containers = []\n\n    for bottom in range(1, h):\n        for left in range(w - 2):\n            if int(g[bottom, left]) != wall_color:\n                continue\n            for right in range(left + 2, w):\n                if int(g[bottom, right]) != wall_color:\n                    continue\n                if not np.all(g[bottom, left : right + 1] == wall_color):\n                    continue\n\n                top = bottom\n                while top > 0 and int(g[top - 1, left]) == wall_color and int(g[top - 1, right]) == wall_color:\n                    top -= 1\n                if top == bottom:\n                    continue\n\n                interior = g[top:bottom, left + 1 : right]\n                if interior.size == 0 or not np.all(interior == bg):\n                    continue\n                containers.append((top, bottom, left, right))\n\n    return containers\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the singleton marker into the matching red U-shaped container, or make a bottom-row puddle if no closed container is hit.\n\n    Input structure\n    - The grid has a dominant background, one singleton marker pixel on the top row,\n      and one other foreground color forming vertical bars and bottom segments.\n    - A closed container is a U shape: two vertical side bars with a continuous\n      bottom segment between them and an empty rectangular interior above the bottom.\n\n    Rule\n    - Remove the top marker from its original cell.\n    - If exactly one closed U-shaped container has the marker column within its\n      horizontal footprint, fill that container's empty interior with the marker color.\n    - If no closed container is under the marker column, fill the whole bottom row\n      with the marker color.\n\n    Key insight\n    - The marker does not identify a color by value; it identifies a vertical drop\n      column, and only a structurally closed U shape can catch and contain the fill.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    foreground_colors = colors_present(g, exclude={bg})\n    assert len(foreground_colors) == 2, \"expected marker and wall colors\"\n\n    singleton_colors = [color for color in foreground_colors if int(np.count_nonzero(g == color)) == 1]\n    assert len(singleton_colors) == 1, \"expected exactly one singleton marker color\"\n    marker_color = singleton_colors[0]\n\n    wall_colors = [color for color in foreground_colors if color != marker_color]\n    assert len(wall_colors) == 1\n    wall_color = wall_colors[0]\n\n    marker_coords = np.argwhere(g == marker_color)\n    assert marker_coords.shape == (1, 2)\n    marker_r, marker_c = map(int, marker_coords[0])\n    assert marker_r == 0, \"marker must sit on the top row\"\n\n    containers = [\n        container\n        for container in _closed_u_containers(g, wall_color, bg)\n        if container[0] > marker_r and container[2] <= marker_c <= container[3]\n    ]\n    assert len(containers) <= 1, \"marker column must select at most one closed container\"\n\n    out = g.copy()\n    out[marker_r, marker_c] = bg\n    if containers:\n        top, bottom, left, right = containers[0]\n        out[top:bottom, left + 1 : right] = marker_color\n    else:\n        assert np.all(out[-1, :] == bg), \"missed marker should fall to an empty bottom row\"\n        out[-1, :] = marker_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed ARC colors and canvas.\n_GEN_BG = 0\n_GEN_MARKER = 1\n_GEN_WALL = 2\n_GEN_H = 10\n_GEN_W = 10\n\n# Vertical layout bounds; row 9 stays empty in generated inputs.\n_GEN_MARKER_ROW = 0\n_GEN_MIN_WALL_ROW = 2\n_GEN_LAST_WALL_ROW = 8\n\n# Closed container interior size ranges, with exclusive upper bounds.\n_GEN_INTERIOR_H_RANGE = (2, 4)\n_GEN_INTERIOR_W_RANGE = (1, 6)\n\n# Broken distractor patch size ranges, with exclusive upper bounds.\n_GEN_DISTRACTOR_H_RANGE = (2, 4)\n_GEN_DISTRACTOR_W_RANGE = (4, 7)\n\n# Scenario mix and distractor count ranges, with exclusive upper bounds.\n_GEN_FILL_CONTAINER_PROB = 0.67\n_GEN_MISSED_HAS_U_PROB = 0.55\n_GEN_DISTRACTORS_WITH_U_RANGE = (0, 2)\n_GEN_DISTRACTORS_WITHOUT_U_RANGE = (1, 4)\n\n# Rejection-sampling retry budget.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_u_patch(interior_h: int, interior_w: int) -> np.ndarray:\n    patch = np.full((interior_h + 1, interior_w + 2), _GEN_BG, dtype=int)\n    patch[:, 0] = _GEN_WALL\n    patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    return patch\n\n\ndef _gen_sample_u() -> tuple[int, int, int, int, int, int]:\n    interior_h = int(np.random.randint(*_GEN_INTERIOR_H_RANGE))\n    interior_w = int(np.random.randint(*_GEN_INTERIOR_W_RANGE))\n    top = int(np.random.randint(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - interior_h + 1))\n    bottom = top + interior_h\n    left = int(np.random.randint(0, _GEN_W - interior_w - 1))\n    right = left + interior_w + 1\n    return top, bottom, left, right, interior_h, interior_w\n\n\ndef _gen_broken_u_patch(height: int, width: int, *, gap: int | None = None, missing_side: str | None = None) -> np.ndarray:\n    patch = np.full((height, width), _GEN_BG, dtype=int)\n    if missing_side != \"left\":\n        patch[:, 0] = _GEN_WALL\n    if missing_side != \"right\":\n        patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    if gap is not None:\n        patch[-1, gap] = _GEN_BG\n    return patch\n\n\ndef _gen_distractor_patches() -> list[np.ndarray]:\n    patches: list[np.ndarray] = []\n\n    for h in range(*_GEN_DISTRACTOR_H_RANGE):\n        for w in range(*_GEN_DISTRACTOR_W_RANGE):\n            gap = int(np.random.randint(1, w - 1))\n            patches.append(_gen_broken_u_patch(h, w, gap=gap))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"left\"))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"right\"))\n\n    return patches\n\n\ndef _gen_valid_positions(grid: np.ndarray, patch: np.ndarray) -> list[tuple[int, int]]:\n    ph, pw = patch.shape\n    local = np.argwhere(patch == _GEN_WALL)\n    local_set = {(int(r), int(c)) for r, c in local}\n    touch_local = {\n        (r + dr, c + dc)\n        for r, c in local_set\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1))\n        if (r + dr, c + dc) not in local_set\n    }\n    positions: list[tuple[int, int]] = []\n\n    for r0 in range(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - ph + 2):\n        for c0 in range(0, _GEN_W - pw + 1):\n            if np.any(grid[r0 + local[:, 0], c0 + local[:, 1]] != _GEN_BG):\n                continue\n            touches = any(\n                0 <= r0 + r < _GEN_H\n                and 0 <= c0 + c < _GEN_W\n                and grid[r0 + r, c0 + c] == _GEN_WALL\n                for r, c in touch_local\n            )\n            if not touches:\n                positions.append((r0, c0))\n\n    return positions\n\n\ndef _gen_place_distractors(grid: np.ndarray, count: int) -> bool:\n    patches = _gen_distractor_patches()\n    for _ in range(count):\n        placed = False\n        for idx in np.random.permutation(len(patches)):\n            patch = patches[int(idx)]\n            positions = _gen_valid_positions(grid, patch)\n            if not positions:\n                continue\n            r0, c0 = positions[int(np.random.randint(0, len(positions)))]\n            paste(grid, patch, r0, c0, transparent=_GEN_BG)\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n\n\n_GenUBox = tuple[int, int, int, int]\n\n\ndef _gen_design_expected() -> tuple[np.ndarray, bool, _GenUBox | None, int, int]:\n    \"\"\"Build the expected output and return metadata needed to derive the input.\"\"\"\n    expected = np.full((_GEN_H, _GEN_W), _GEN_BG, dtype=int)\n    fill_container = bool(np.random.random() < _GEN_FILL_CONTAINER_PROB)\n    has_u = fill_container or bool(np.random.random() < _GEN_MISSED_HAS_U_PROB)\n    u_box = None\n\n    if has_u:\n        top, bottom, left, right, interior_h, interior_w = _gen_sample_u()\n        paste(expected, _gen_u_patch(interior_h, interior_w), top, left, transparent=_GEN_BG)\n        u_box = (top, bottom, left, right)\n        if fill_container:\n            marker_c = int(np.random.randint(left + 1, right))\n            expected[top:bottom, left + 1 : right] = _GEN_MARKER\n        else:\n            outside = [c for c in range(_GEN_W) if not (left <= c <= right)]\n            marker_c = int(outside[int(np.random.randint(0, len(outside)))])\n            expected[-1, :] = _GEN_MARKER\n        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITH_U_RANGE))\n    else:\n        marker_c = int(np.random.randint(0, _GEN_W))\n        expected[-1, :] = _GEN_MARKER\n        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITHOUT_U_RANGE))\n","exit_code":0,"status":"completed"}}
