{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, components_mask, get_bg\nimport random\n\n\nAxis = tuple[int, str, int]\n\n\ndef _find_reflection_axis(g: np.ndarray, bg: int) -> Axis:\n    h, w = g.shape\n    candidates: list[Axis] = []\n\n    for color in colors_present(g, exclude={bg}):\n        mask = g == color\n        count = int(mask.sum())\n\n        if count == w:\n            for r in np.flatnonzero(mask.all(axis=1)):\n                candidates.append((int(color), \"row\", int(r)))\n\n        if count == h:\n            for c in np.flatnonzero(mask.all(axis=0)):\n                candidates.append((int(color), \"col\", int(c)))\n\n        if h == w and count == h:\n            main_diag = np.eye(h, dtype=bool)\n            anti_diag = np.fliplr(main_diag)\n            if np.all(mask[main_diag]):\n                candidates.append((int(color), \"main_diag\", 0))\n            if np.all(mask[anti_diag]):\n                candidates.append((int(color), \"anti_diag\", 0))\n\n    assert len(candidates) == 1, \"expected exactly one full straight reflection axis\"\n    return candidates[0]\n\n\ndef _reflect(axis: Axis, shape: tuple[int, int], r: int, c: int) -> tuple[int, int]:\n    _axis_color, kind, index = axis\n    h, w = shape\n\n    if kind == \"row\":\n        return 2 * index - r, c\n    if kind == \"col\":\n        return r, 2 * index - c\n    if kind == \"main_diag\":\n        assert h == w, \"diagonal reflection axis requires a square grid\"\n        return c, r\n    if kind == \"anti_diag\":\n        assert h == w, \"diagonal reflection axis requires a square grid\"\n        return h - 1 - c, w - 1 - r\n\n    raise AssertionError(f\"unknown axis kind: {kind}\")\n\n\ndef _smallest_non_axis_color(g: np.ndarray, bg: int, axis_color: int) -> int:\n    areas = {\n        int(color): int(np.count_nonzero(g == color))\n        for color in colors_present(g, exclude={bg, axis_color})\n    }\n    assert len(areas) >= 2, \"expected at least two non-axis foreground colors\"\n\n    min_area = min(areas.values())\n    colors = [color for color, area in areas.items() if area == min_area]\n    assert len(colors) == 1, \"smallest non-axis foreground color must be unique\"\n    return colors[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Mirror the smallest non-axis foreground color across the full straight axis.\n\n    Input structure\n    - The background is the dominant color.\n    - One foreground color forms exactly one full row, column, main diagonal, or anti-diagonal reflection axis.\n    - The remaining foreground colors include a unique least-populated color to copy.\n\n    Rule\n    - Preserve the input grid.\n    - Select every pixel of the unique smallest non-axis foreground color.\n    - Reflect those pixels across the full straight axis and paint the reflected positions with the same color.\n\n    Key insight\n    - The axis color marks the mirror line, while the color population chooses which set of objects is duplicated.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.size > 0, \"expected a non-empty 2D grid\"\n\n    bg = get_bg(g)\n    axis = _find_reflection_axis(g, bg)\n    axis_color = axis[0]\n    mirror_color = _smallest_non_axis_color(g, bg, axis_color)\n\n    out = g.copy()\n    h, w = g.shape\n    for r_raw, c_raw in np.argwhere(g == mirror_color):\n        r = int(r_raw)\n        c = int(c_raw)\n        rr, cc = _reflect(axis, g.shape, r, c)\n        assert 0 <= rr < h and 0 <= cc < w, \"reflected pixel must stay inside the grid\"\n        assert int(out[rr, cc]) in {bg, mirror_color}, \"reflection cannot overwrite another foreground object\"\n        out[rr, cc] = mirror_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n# Canvas and axis options.\n_GEN_GRID_SIZE_RANGE = (9, 17)\n_GEN_ODD_GRID_SIZES = [9, 11, 13, 15, 17]\n_GEN_AXIS_KINDS = [\"row\", \"col\", \"main_diag\", \"anti_diag\"]\n_GEN_CENTER_AXIS_KINDS = {\"row\", \"col\"}\n_GEN_SIDE_COUNT = 2\n# Foreground component size and count bounds.\n_GEN_COMPONENT_COUNT_RANGE = range(1, 4)\n_GEN_MIRROR_TOTAL_RANGE = (4, 12)\n_GEN_MIRROR_COMPONENT_SIZE_RANGE = (2, 7)\n_GEN_NONMIRROR_TOTAL_RANGE = (5, 17)\n_GEN_NONMIRROR_COMPONENT_SIZE_RANGE = (3, 9)\n_GEN_MIN_NONMIRROR_RATIO = (5, 4)\n_GEN_MAX_NONMIRROR_MULTIPLIER = 2\n# Search and geometry primitives.\n_GEN_RETRY_LIMIT = 300\n_GEN_COLORS = list(range(10))\n_GEN_DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\ndef _gen_draw_axis(grid: np.ndarray, axis_kind: str, color: int) -> None:\n    n = grid.shape[0]\n    if axis_kind == \"row\":\n        grid[n // 2, :] = color\n    elif axis_kind == \"col\":\n        grid[:, n // 2] = color\n    elif axis_kind == \"main_diag\":\n        np.fill_diagonal(grid, color)\n    else:\n        np.fill_diagonal(np.fliplr(grid), color)\n\n\ndef _gen_side_mask(n: int, axis_kind: str, side: int) -> np.ndarray:\n    rr, cc = np.indices((n, n))\n    if axis_kind == \"row\":\n        return rr < n // 2 if side == 0 else rr > n // 2\n    if axis_kind == \"col\":\n        return cc < n // 2 if side == 0 else cc > n // 2\n    if axis_kind == \"main_diag\":\n        return cc > rr if side == 0 else cc < rr\n    return rr + cc < n - 1 if side == 0 else rr + cc > n - 1\n\n\ndef _gen_reflect(axis_kind: str, n: int, r: int, c: int) -> tuple[int, int]:\n    if axis_kind == \"row\":\n        return n - 1 - r, c\n    if axis_kind == \"col\":\n        return r, n - 1 - c\n    if axis_kind == \"main_diag\":\n        return c, r\n    return n - 1 - c, n - 1 - r\n\n\ndef _gen_feasible_counts(total: int, lo: int, hi: int) -> list[int]:\n    return [count for count in _GEN_COMPONENT_COUNT_RANGE if count * lo <= total <= count * hi]\n\n\ndef _gen_partition(total: int, count: int, lo: int, hi: int) -> list[int]:\n    sizes = []\n    remaining = total\n    for idx in range(count):\n        left = count - idx - 1\n        cur_lo = max(lo, remaining - left * hi)\n        cur_hi = min(hi, remaining - left * lo)\n        size = random.randint(cur_lo, cur_hi)\n        sizes.append(size)\n        remaining -= size\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _gen_pick_component_sizes() -> tuple[list[int], list[int]]:\n    mirror_total = random.randint(*_GEN_MIRROR_TOTAL_RANGE)\n    ratio_num, ratio_den = _GEN_MIN_NONMIRROR_RATIO\n    nonmirror_lo = max(\n        _GEN_NONMIRROR_TOTAL_RANGE[0],\n        (ratio_num * mirror_total + ratio_den - 1) // ratio_den,\n    )\n    nonmirror_hi = min(_GEN_NONMIRROR_TOTAL_RANGE[1], _GEN_MAX_NONMIRROR_MULTIPLIER * mirror_total)\n    nonmirror_total = random.randint(nonmirror_lo, nonmirror_hi)\n\n    mirror_count = random.choice(_gen_feasible_counts(mirror_total, *_GEN_MIRROR_COMPONENT_SIZE_RANGE))\n    nonmirror_count = random.choice(_gen_feasible_counts(nonmirror_total, *_GEN_NONMIRROR_COMPONENT_SIZE_RANGE))\n    mirror_sizes = _gen_partition(mirror_total, mirror_count, *_GEN_MIRROR_COMPONENT_SIZE_RANGE)\n    nonmirror_sizes = _gen_partition(nonmirror_total, nonmirror_count, *_GEN_NONMIRROR_COMPONENT_SIZE_RANGE)\n    return mirror_sizes, nonmirror_sizes\n\n\ndef _gen_mark_neighbors(blocked: np.ndarray, coords: np.ndarray) -> None:\n    n = blocked.shape[0]\n    for r_raw, c_raw in coords:\n        r = int(r_raw)\n        c = int(c_raw)\n        blocked[r, c] = True\n        for dr, dc in _GEN_DIRS4:\n            rr = r + dr\n            cc = c + dc\n            if 0 <= rr < n and 0 <= cc < n:\n                blocked[rr, cc] = True\n\n\ndef _gen_grow_component(\n    side_mask: np.ndarray, occupied: np.ndarray, same_color_blocked: np.ndarray, size: int\n) -> np.ndarray | None:\n    available = side_mask & ~occupied & ~same_color_blocked\n    choices = [coords for coords in components_mask(available, connectivity=4) if len(coords) >= size]\n    if not choices:\n        return None\n\n    region = random.choice(choices)\n    seed = tuple(int(x) for x in region[random.randrange(len(region))])\n    selected = {seed}\n    frontier: set[tuple[int, int]] = set()\n    n = available.shape[0]\n\n    def add_frontier(r: int, c: int) -> None:\n        for dr, dc in _GEN_DIRS4:\n            rr = r + dr\n            cc = c + dc\n            if 0 <= rr < n and 0 <= cc < n and available[rr, cc] and (rr, cc) not in selected:\n                frontier.add((rr, cc))\n\n    add_frontier(*seed)\n    while len(selected) < size:\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        selected.add(cell)\n        add_frontier(*cell)\n\n    return np.array(list(selected), dtype=int)\n\n\ndef _gen_place_components(\n    grid: np.ndarray,\n    side_mask: np.ndarray,\n    occupied: np.ndarray,\n    color: int,\n    sizes: list[int],\n) -> list[tuple[int, int]] | None:\n    same_color_blocked = np.zeros_like(occupied, dtype=bool)\n    placed: list[tuple[int, int]] = []\n    for size in sizes:\n        coords = _gen_grow_component(side_mask, occupied, same_color_blocked, size)\n        if coords is None:\n            return None\n        grid[coords[:, 0], coords[:, 1]] = color\n        occupied[coords[:, 0], coords[:, 1]] = True\n        _gen_mark_neighbors(same_color_blocked, coords)\n        placed.extend((int(r), int(c)) for r, c in coords)\n    return placed\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/9b30e358.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import get_bg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Repeat the bottom foreground motif upward until it fills the whole grid.\n\n    Input structure\n    - The background is the dominant color.\n    - The only foreground pixels occupy a contiguous block of rows at the bottom.\n    - That bottom block is the complete vertical motif, including its background cells.\n\n    Rule\n    - Copy the bottom motif rows repeatedly upward across the full grid.\n    - Preserve horizontal alignment and vertical phase: the original first motif row remains at its input row.\n    - The output shape is unchanged.\n\n    Key insight\n    The blank rows above the bottom foreground block are missing repetitions of the same row motif, not empty space.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    row_has_fg = np.any(g != bg, axis=1)\n    assert np.any(row_has_fg), \"expected a bottom foreground motif\"\n    top = int(np.flatnonzero(row_has_fg)[0])\n    assert top > 0, \"expected background rows above the motif\"\n    assert np.all(row_has_fg[top:]), \"motif rows must be contiguous through the bottom\"\n\n    motif = g[top:].copy()\n    motif_h = int(motif.shape[0])\n\n    out = np.empty_like(g)\n    for r in range(g.shape[0]):\n        out[r] = motif[(int(r) - top) % motif_h]\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and motif size bounds.\nHEIGHT_RANGE = (8, 14)\nWIDTH_RANGE = (5, 9)\nMOTIF_H_RANGE = (3, 6)\n# Foreground support and density limits.\nBBOX_W_RANGE = (3, 5)\nFG_DENSITY_RANGE = (0.30, 0.50)\n# Generation retry limit.\nMAX_ATTEMPTS = 300\n\ndef _sample_dims(rng) -> tuple[int, int, int, int] | None:\n    \"\"\"Return height, width, blank rows, and motif height.\"\"\"\n    motif_h = int(rng.integers(MOTIF_H_RANGE[0], MOTIF_H_RANGE[1] + 1))\n    min_h = max(HEIGHT_RANGE[0], motif_h * 2)\n    if min_h > HEIGHT_RANGE[1]:\n        return None\n    height = int(rng.integers(min_h, HEIGHT_RANGE[1] + 1))\n    width = int(rng.integers(WIDTH_RANGE[0], WIDTH_RANGE[1] + 1))\n    return height, width, height - motif_h, motif_h\n\ndef _sample_fg_cells(rng, motif_h: int, width: int, bbox_w: int) -> set[tuple[int, int]] | None:\n    \"\"\"Choose bbox-local cells while forcing every row and both bbox edges.\"\"\"\n    min_fg = max(motif_h, int(np.ceil(FG_DENSITY_RANGE[0] * motif_h * width)))\n    max_fg = min(motif_h * bbox_w, int(np.floor(FG_DENSITY_RANGE[1] * motif_h * width)))\n    if max_fg < min_fg:\n        return None\n    target_fg = int(rng.integers(min_fg, max_fg + 1))\n    selected = {(int(rng.integers(0, motif_h)), 0), (int(rng.integers(0, motif_h)), bbox_w - 1)}\n    for r in range(motif_h):\n        if not any(rr == r for rr, _ in selected):\n            selected.add((r, int(rng.integers(0, bbox_w))))\n    if len(selected) > target_fg:\n        return None\n    remaining = [\n        (r, c)\n        for r in range(motif_h)\n        for c in range(bbox_w)\n        if (r, c) not in selected\n    ]\n    need = target_fg - len(selected)\n    if need:\n        for i in rng.choice(len(remaining), size=need, replace=False):\n            selected.add(remaining[int(i)])\n    return selected\n\ndef _paint_motif(rng, motif_h: int, width: int, c0: int, selected: set[tuple[int, int]], bg: int, fg_colors: list[int]) -> np.ndarray:\n    \"\"\"Render selected bbox-local cells into a full-width motif.\"\"\"\n    motif = np.full((motif_h, width), bg, dtype=int)\n    coords = list(selected)\n    coords = [coords[int(i)] for i in rng.permutation(len(coords))]\n    for i, (r, c) in enumerate(coords):\n        if i == 0:\n            color = fg_colors[0]\n        elif i == 1:\n            color = fg_colors[1]\n        else:\n            color = int(rng.choice(fg_colors))\n        motif[r, c0 + c] = color\n    return motif\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n    dims = _sample_dims(rng)\n    if dims is None:\n        return None\n    height, width, blank_rows, motif_h = dims\n    colors = rng.choice(np.arange(10), size=3, replace=False)\n    bg = int(colors[0])\n    fg_colors = [int(colors[1]), int(colors[2])]\n    bbox_w = int(rng.integers(BBOX_W_RANGE[0], min(BBOX_W_RANGE[1], width) + 1))\n    c0 = int(rng.integers(0, width - bbox_w + 1))\n    selected = _sample_fg_cells(rng, motif_h, width, bbox_w)\n    if selected is None:\n        return None\n    motif = _paint_motif(rng, motif_h, width, c0, selected, bg, fg_colors)\n    expected = motif[(np.arange(height) - blank_rows) % motif_h]\n    inp = expected.copy()\n    inp[:blank_rows] = bg\n    if np.array_equal(main(inp), expected):\n        return inp\n    return None\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 9b30e358 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/11dc524f.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/11dc524f.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste\nimport itertools\nimport random\n\n\ndef _intervals_overlap(a0: int, a1: int, b0: int, b1: int) -> bool:\n    return max(int(a0), int(b0)) <= min(int(a1), int(b1))\n\n\ndef _is_solid_2x2(comp: dict, g: np.ndarray) -> bool:\n    r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n    return (\n        int(comp[\"area\"]) == 4\n        and int(r1 - r0 + 1) == 2\n        and int(c1 - c0 + 1) == 2\n        and bool((g[r0 : r1 + 1, c0 : c1 + 1] == int(comp[\"color\"])).all())\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide the non-square sprite to the square anchor and replace the anchor with the sprite's mirror image.\n\n    Input structure:\n    - The background is the most common color.\n    - There is one 8-connected non-background sprite that is not a solid 2x2 square.\n    - There is one solid 2x2 square anchor in another non-background color.\n\n    Rule:\n    - Move the sprite straight toward the anchor along their unique cardinal separation until it touches the anchor's near edge.\n    - Reflect the moved sprite across that near edge and draw the reflected copy in the anchor color.\n    - Clear the original locations; the output keeps only the moved sprite and reflected anchor-color copy.\n\n    Key insight:\n    - The 2x2 square marks the mirror line: its side facing the sprite becomes the contact edge for a two-color reflected pair.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = map(int, g.shape)\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert len(comps) == 2\n\n    anchors = [comp for comp in comps if _is_solid_2x2(comp, g)]\n    assert len(anchors) == 1\n    anchor = anchors[0]\n\n    sprites = [comp for comp in comps if comp is not anchor]\n    assert len(sprites) == 1\n    sprite = sprites[0]\n    assert int(sprite[\"color\"]) != int(anchor[\"color\"])\n\n    sr0, sc0, sr1, sc1 = map(int, sprite[\"bbox\"])\n    ar0, ac0, ar1, ac1 = map(int, anchor[\"bbox\"])\n\n    candidates: list[tuple[str, int, int]] = []\n    if sc1 < ac0 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"left\", 0, ac0 - sc1 - 1))\n    if sc0 > ac1 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"right\", 0, ac1 + 1 - sc0))\n    if sr1 < ar0 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"above\", ar0 - sr1 - 1, 0))\n    if sr0 > ar1 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"below\", ar1 + 1 - sr0, 0))\n    assert len(candidates) == 1\n\n    side, dr, dc = candidates[0]\n    moved: list[tuple[int, int]] = []\n    mirrored: list[tuple[int, int]] = []\n    for r, c in sprite[\"coords\"]:\n        rr = int(r) + int(dr)\n        cc = int(c) + int(dc)\n        moved.append((rr, cc))\n        if side == \"left\":\n            mirrored.append((rr, 2 * ac0 - 1 - cc))\n        elif side == \"right\":\n            mirrored.append((rr, 2 * ac1 + 1 - cc))\n        elif side == \"above\":\n            mirrored.append((2 * ar0 - 1 - rr, cc))\n        else:\n            mirrored.append((2 * ar1 + 1 - rr, cc))\n\n    assert all(0 <= r < H and 0 <= c < W for r, c in moved)\n    assert all(0 <= r < H and 0 <= c < W for r, c in mirrored)\n    assert not (set(moved) & set(mirrored))\n\n    out = np.full_like(g, bg)\n    for r, c in moved:\n        out[r, c] = int(sprite[\"color\"])\n    for r, c in mirrored:\n        out[r, c] = int(anchor[\"color\"])\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import is_contiguous\n\n# ── Config ──────────────────────────────────────────────────────────────\nGRID_MIN, GRID_MAX = 10, 20        # canvas size range (rows and cols)\nSPRITE_AREA = 4                     # number of filled cells per sprite\nSPRITE_BBOX_SHAPES = [(2, 3), (3, 2), (3, 3)]  # allowed sprite bbox dims\nGAP_MIN, GAP_MAX = 2, 4            # empty-cell gap between sprite and anchor\nANCHOR_SIZE = 2                     # anchor is always a 2x2 solid square\nNUM_COLORS = 10                     # ARC color palette size\nSIDES = [\"left\", \"right\", \"above\", \"below\"]\nRETRY_LIMIT = 300                   # max attempts before raising\n\n\ndef _has_full_bbox(mask: np.ndarray) -> bool:\n    \"\"\"True if mask has at least one filled cell on each edge of its bounding box.\"\"\"\n    return (mask[0].any() and mask[-1].any() and\n            mask[:, 0].any() and mask[:, -1].any())\n\n\ndef _sprite_masks(axis: str) -> list[np.ndarray]:\n    \"\"\"Enumerate all valid 4-cell sprite masks for a given mirror axis.\n\n    A valid mask is 8-connected, spans its full bbox, and is NOT symmetric\n    along the given axis (lr or ud).\n    \"\"\"\n    flip = np.fliplr if axis == \"lr\" else np.flipud\n    out = []\n    for h, w in SPRITE_BBOX_SHAPES:\n        for cells in itertools.combinations(range(h * w), SPRITE_AREA):\n            mask = np.zeros((h, w), dtype=bool)\n            for cell in cells:\n                mask[cell // w, cell % w] = True\n            if not _has_full_bbox(mask):\n                continue\n            if not is_contiguous(mask, connectivity=8):\n                continue\n            if np.array_equal(mask, flip(mask)):\n                continue\n            out.append(mask)\n    return out\n\n\n_MASKS = {\"lr\": _sprite_masks(\"lr\"), \"ud\": _sprite_masks(\"ud\")}\n\n\ndef _paint_mask(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int,\n                color: int, bg: int) -> None:\n    \"\"\"Stamp a boolean mask onto grid at (r0, c0) using the given color.\"\"\"\n    patch = np.full(mask.shape, bg, dtype=int)\n    patch[mask] = color\n    paste(grid, patch, r0, c0, transparent=bg)\n\n\ndef _rand_pair_origin(H: int, W: int, h: int, w: int, side: str,\n                      gap: int) -> tuple[int, int] | None:\n    \"\"\"Pick a random origin for the touching sprite+mirror pair.\n\n    Returns (row, col) of the output pair's top-left corner, or None if the\n    pair cannot fit on the grid with enough room for the input-side gap.\n    \"\"\"\n    if side in {\"left\", \"right\"}:\n        r_lo, r_hi = 0, H - h\n        total_w = 2 * w + (gap if side == \"right\" else 0)\n        c_lo = gap if side == \"left\" else 0\n        c_hi = W - total_w if side == \"right\" else W - 2 * w\n    else:\n        c_lo, c_hi = 0, W - w\n        total_h = 2 * h + (gap if side == \"below\" else 0)\n        r_lo = gap if side == \"above\" else 0\n        r_hi = H - total_h if side == \"below\" else H - 2 * h\n    if r_lo > r_hi or c_lo > c_hi:\n        return None\n    return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)\n\n\ndef _layout_for_side(side: str, pr: int, pc: int, h: int, w: int,\n                     gap: int, sprite: np.ndarray):\n    \"\"\"Compute output and input placement params for a given side.\n\n    Returns (sprite_r, sprite_c, mirror_r, mirror_c, flipped_sprite,\n             anchor_r, anchor_c, input_r, input_c).\n    \"\"\"\n    flip = np.fliplr if side in {\"left\", \"right\"} else np.flipud\n    flipped = flip(sprite)\n\n    if side == \"left\":\n        sr, sc = pr, pc                     # sprite at pair origin\n        mr, mc = sr, sc + w                  # mirror right of sprite\n        anchor_r = random.randint(sr, sr + h - ANCHOR_SIZE)\n        anchor_c = sc + w\n        input_r, input_c = sr, sc - gap\n    elif side == \"right\":\n        sr, sc = pr, pc + w                  # sprite right half\n        mr, mc = pr, pc                      # mirror left half\n        anchor_r = random.randint(sr, sr + h - ANCHOR_SIZE)\n        anchor_c = sc - ANCHOR_SIZE\n        input_r, input_c = sr, sc + gap\n    elif side == \"above\":\n        sr, sc = pr, pc                      # sprite at top\n        mr, mc = sr + h, sc                  # mirror below\n        anchor_r = sr + h\n        anchor_c = random.randint(sc, sc + w - ANCHOR_SIZE)\n        input_r, input_c = sr - gap, sc\n    else:  # below\n        sr, sc = pr + h, pc                  # sprite at bottom\n        mr, mc = pr, pc                      # mirror above\n        anchor_r = sr - ANCHOR_SIZE\n        anchor_c = random.randint(sc, sc + w - ANCHOR_SIZE)\n        input_r, input_c = sr + gap, sc\n\n    return sr, sc, mr, mc, flipped, anchor_r, anchor_c, input_r, input_c\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Try to build one valid (input, output) pair; return input or None.\"\"\"\n    H = random.randint(GRID_MIN, GRID_MAX)\n    W = random.randint(GRID_MIN, GRID_MAX)\n    bg = random.randrange(NUM_COLORS)\n    sprite_color, anchor_color = random.sample(\n        [c for c in range(NUM_COLORS) if c != bg], 2)\n\n    side = random.choice(SIDES)\n    axis = \"lr\" if side in {\"left\", \"right\"} else \"ud\"\n    sprite = random.choice(_MASKS[axis]).copy()\n    h, w = map(int, sprite.shape)\n    gap = random.randint(GAP_MIN, GAP_MAX)\n\n    origin = _rand_pair_origin(H, W, h, w, side, gap)\n    if origin is None:\n        return None\n    pr, pc = origin\n\n    (sr, sc, mr, mc, flipped,\n     anchor_r, anchor_c, input_r, input_c) = _layout_for_side(\n        side, pr, pc, h, w, gap, sprite)\n\n    # Build expected output\n    out = np.full((H, W), bg, dtype=int)\n    _paint_mask(out, sprite, sr, sc, sprite_color, bg)\n    _paint_mask(out, flipped, mr, mc, anchor_color, bg)\n\n    # Build input\n    inp = np.full((H, W), bg, dtype=int)\n    _paint_mask(inp, sprite, input_r, input_c, sprite_color, bg)\n    paste(inp, np.full((ANCHOR_SIZE, ANCHOR_SIZE), anchor_color, dtype=int),\n          anchor_r, anchor_c)\n\n    # Oracle validation\n    comps = find_components(inp, bg=bg, connectivity=8, monochromatic=True)\n    if len(comps) != 2:\n        return None\n    try:\n        solved = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(solved, out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
