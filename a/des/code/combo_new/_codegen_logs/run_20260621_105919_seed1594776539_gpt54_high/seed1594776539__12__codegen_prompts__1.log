{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools, numpy as np\n\ndef comps(mask):\n    h,w=mask.shape\n    pts=np.argwhere(mask)\n    if len(pts)==0:\n        return False\n    seen=set([tuple(pts[0])])\n    stack=[tuple(pts[0])]\n    cells=set(map(tuple,pts))\n    while stack:\n        r,c=stack.pop()\n        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n            p=(r+dr,c+dc)\n            if p in cells and p not in seen:\n                seen.add(p); stack.append(p)\n    return len(seen)==len(cells)\n\ndef crop(mask):\n    pts=np.argwhere(mask)\n    r0,c0=pts.min(0); r1,c1=pts.max(0)\n    return mask[r0:r1+1,c0:c1+1]\n\ndef key(mask):\n    vars=[np.rot90(mask,k) for k in range(4)]\n    return min((tuple(v.shape), v.tobytes()) for v in vars)\n\nexisting=[]\nfor rows in [3,4]:\n  for cols in [3,4]:\n    for bits in itertools.product([0,1], repeat=rows*cols):\n      arr=np.array(bits,dtype=bool).reshape(rows,cols)\n      if arr.sum() < 4 or arr.sum() > 7: continue\n      if not comps(arr): continue\n      arr=crop(arr)\n      if 1 in arr.shape: continue\n      vars={(tuple(np.rot90(arr,k).shape), np.rot90(arr,k).tobytes()) for k in range(4)}\n      if len(vars)\"'!=4: continue\n      k=key(arr)\n      if k in existing: continue\n      existing.append(k)\n      print(arr.astype(int))\n      print('\"'shape',arr.shape,'area',arr.sum())\n      print()\n      if len(existing)>=20:\n        raise SystemExit\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
