ted"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/e9fc42f2.py\"","aggregated_output":"from collections import defaultdict, deque\n\nimport numpy as np\n\nfrom arc_utils import crop_bbox, find_components, get_bg, paste, random_free_location\nimport math\nimport random\n\n\ndef _connector_dir(sprite: np.ndarray, r: int, c: int) -> tuple[int, int]:\n    h, w = sprite.shape\n    dirs: list[tuple[int, int]] = []\n    if r == 0:\n        dirs.append((-1, 0))\n    if r == h - 1:\n        dirs.append((1, 0))\n    if c == 0:\n        dirs.append((0, -1))\n    if c == w - 1:\n        dirs.append((0, 1))\n    assert len(dirs) == 1\n    return dirs[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Assemble the foreground objects by docking equal-colored boundary markers edge-to-edge.\n\n    Input structure\n    The grid has a dominant background color and several 4-connected multicolor foreground\n    objects.  One foreground color is the body color; the less frequent foreground colors are\n    boundary connector markers, and each marker color appears once as a free end or twice as a\n    matched docking pair.\n\n    Rule\n    Crop each foreground object to its bounding box and translate the objects so that the two\n    occurrences of every paired connector color touch on their exposed boundary sides.  Preserve\n    each object's orientation and colors, then return the tight crop around the assembled\n    foreground on the original background color.\n\n    Key insight\n    The colored marker pixels are ports: matching colors specify which objects must touch, and\n    the marker's side of its object determines the direction of the translation.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    fg = g[g != bg]\n    assert fg.size > 0\n    values, counts = np.unique(fg, return_counts=True)\n    max_count = int(counts.max())\n    body_candidates = [int(v) for v, n in zip(values, counts) if int(n) == max_count]\n    assert len(body_candidates) == 1\n    body = body_candidates[0]\n    marker_colors = {int(v) for v in values if int(v) != body}\n    assert marker_colors\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert len(components) >= 2\n\n    sprites: list[np.ndarray] = []\n    marker_occurrences: dict[int, list[tuple[int, tuple[int, int], tuple[int, int]]]] = defaultdict(list)\n    for idx, comp in enumerate(components):\n        sprite = crop_bbox(g, comp[\"bbox\"])\n        sprites.append(sprite)\n        marker_locs = np.argwhere(np.isin(sprite, list(marker_colors)))\n        assert marker_locs.size > 0\n        for rr, cc in marker_locs:\n            r, c = int(rr), int(cc)\n            direction = _connector_dir(sprite, r, c)\n            marker_occurrences[int(sprite[r, c])].append((idx, (r, c), direction))\n\n    adjacency: list[list[tuple[int, tuple[int, int]]]] = [[] for _ in sprites]\n    paired_markers = 0\n    for occurrences in marker_occurrences.values():\n        assert len(occurrences) in (1, 2)\n        if len(occurrences) == 1:\n            continue\n        (a_idx, a_pos, a_dir), (b_idx, b_pos, b_dir) = occurrences\n        assert a_idx != b_idx\n        assert b_dir == (-a_dir[0], -a_dir[1])\n        delta = (a_pos[0] + a_dir[0] - b_pos[0], a_pos[1] + a_dir[1] - b_pos[1])\n        adjacency[a_idx].append((b_idx, delta))\n        adjacency[b_idx].append((a_idx, (-delta[0], -delta[1])))\n        paired_markers += 1\n    assert paired_markers == len(sprites) - 1\n\n    placements: dict[int, tuple[int, int]] = {0: (0, 0)}\n    queue = deque([0])\n    while queue:\n        idx = queue.popleft()\n        base_r, base_c = placements[idx]\n        for nbr, (dr, dc) in adjacency[idx]:\n            pos = (base_r + dr, base_c + dc)\n            if nbr in placements:\n                assert placements[nbr] == pos\n            else:\n                placements[nbr] = pos\n                queue.append(nbr)\n    assert len(placements) == len(sprites)\n\n    placed_fg: list[tuple[int, int]] = []\n    for idx, sprite in enumerate(sprites):\n        base_r, base_c = placements[idx]\n        for rr, cc in np.argwhere(sprite != bg):\n            placed_fg.append((base_r + int(rr), base_c + int(cc)))\n\n    r0 = min(r for r, _ in placed_fg)\n    c0 = min(c for _, c in placed_fg)\n    r1 = max(r for r, _ in placed_fg)\n    c1 = max(c for _, c in placed_fg)\n    out = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)\n\n    for idx, sprite in enumerate(sprites):\n        base_r, base_c = placements[idx]\n        rr, cc = base_r - r0, base_c - c0\n        mask = sprite != bg\n        target = out[rr : rr + sprite.shape[0], cc : cc + sprite.shape[1]]\n        assert target.shape == sprite.shape\n        assert not np.any((target != bg) & mask)\n        paste(out, sprite, rr, cc, transparent=bg)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette and marker vocabulary.\n_GEN_BG, _GEN_BODY = 2, 1\n_GEN_MARKERS = [3, 4, 8]\n\n# Port sides and their assembly directions.\n_GEN_SIDES = (\"T\", \"B\", \"L\", \"R\")\n_GEN_DIRS = {\"T\": (-1, 0), \"B\": (1, 0), \"L\": (0, -1), \"R\": (0, 1)}\n_GEN_OPPOSITE = {\"T\": \"B\", \"B\": \"T\", \"L\": \"R\", \"R\": \"L\"}\n\n# Canvas and scattering constraints.\n_GEN_CANVAS_SHAPE = (13, 13)\n_GEN_MAX_OUTPUT_SPAN = 13\n_GEN_SCATTER_PADDING, _GEN_PADDING_CONNECTIVITY = 2, 8\n_GEN_SHADOW_BG = 0\n\n# Sprite count, size, and special-case height controls.\n_GEN_SPRITE_COUNT_CHOICES = [2, 3, 4]\n_GEN_MIN_SPRITES, _GEN_MID_SPRITES, _GEN_MAX_SPRITES = 2, 3, 4\n_GEN_HEIGHT_RANGE, _GEN_COMPACT_HEIGHT_RANGE, _GEN_WIDTH_RANGE = (3, 8), (3, 6), (3, 6)\n_GEN_FOUR_SPRITE_HEIGHT_CHOICES = [3, 4, 5, 5, 6]\n_GEN_THREE_SPRITE_COMPACT_PROB = 0.7\n\n# Sprite fill and port-count constraints.\n_GEN_INTERIOR_MARGIN = 1\n_GEN_MIN_DENSITY, _GEN_MAX_DENSITY = 0.36, 0.89\n_GEN_MAX_PORTS_PER_SPRITE = 3\n\n# Generation retry budget.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_neighbors4(r, c, h, w):\n    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n        rr, cc = r + dr, c + dc\n        if 0 <= rr < h and 0 <= cc < w:\n            yield rr, cc\n\n\ndef _gen_boundary_coord(side, h, w):\n    low = _GEN_INTERIOR_MARGIN\n    if side == \"T\":\n        return 0, random.randint(low, w - 1 - low)\n    if side == \"B\":\n        return h - 1, random.randint(low, w - 1 - low)\n    if side == \"L\":\n        return random.randint(low, h - 1 - low), 0\n    return random.randint(low, h - 1 - low), w - 1\n\n\ndef _gen_inner_neighbor(side, r, c):\n    dr, dc = _GEN_DIRS[side]\n    return r - dr, c - dc\n\n\ndef _gen_add_path(cells, start, end):\n    r, c = start\n    er, ec = end\n    cells.add((r, c))\n    axes = [0, 1]\n    random.shuffle(axes)\n    for axis in axes:\n        while (axis == 0 and r != er) or (axis == 1 and c != ec):\n            if axis == 0:\n                r += 1 if er > r else -1\n            else:\n                c += 1 if ec > c else -1\n            cells.add((r, c))\n\n\ndef _gen_seed_sprite_cells(h, w, ports):\n    port_locs = {}\n    cells = set()\n    port_sides = {side for _, side in ports}\n\n    for color, side in ports:\n        r, c = _gen_boundary_coord(side, h, w)\n        port_locs[color] = (r, c)\n        cells.add((r, c))\n        cells.add(_gen_inner_neighbor(side, r, c))\n\n    for side in _GEN_SIDES:\n        if side in port_sides:\n            continue\n        r, c = _gen_boundary_coord(side, h, w)\n        cells.add((r, c))\n\n    return cells, port_locs\n\n\ndef _gen_connect_sprite_cells(cells, h, w):\n    low = _GEN_INTERIOR_MARGIN\n    center = (random.randint(low, h - 1 - low), random.randint(low, w - 1 - low))\n    cells.add(center)\n    for cell in list(cells):\n        _gen_add_path(cells, cell, center)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' /home/lixinyu/snap/new/ARC_code/train/902510d5.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _corner_distances(shape: tuple[int, int], corner: str, r: int, c: int) -> tuple[int, int]:\n    H, W = shape\n    if corner == \"TL\":\n        return int(r), int(c)\n    if corner == \"TR\":\n        return int(r), int(W - 1 - c)\n    if corner == \"BL\":\n        return int(H - 1 - r), int(c)\n    assert corner == \"BR\"\n    return int(H - 1 - r), int(W - 1 - c)\n\n\ndef _paint_corner_triangle(out: np.ndarray, corner: str, side: int, color: int) -> None:\n    H, W = out.shape\n    assert side > 0, \"triangle side length must be positive\"\n    for r in range(H):\n        for c in range(W):\n            a, b = _corner_distances((H, W), corner, r, c)\n            if a + b < side:\n                out[r, c] = int(color)\n\n\ndef _diagonal_direction(coords: set[tuple[int, int]]) -> str | None:\n    r0 = min(r for r, _ in coords)\n    r1 = max(r for r, _ in coords)\n    c0 = min(c for _, c in coords)\n    c1 = max(c for _, c in coords)\n    height = r1 - r0 + 1\n    width = c1 - c0 + 1\n    if height != width:\n        return None\n    n = height\n    local = {(r - r0, c - c0) for r, c in coords}\n    main_ok = all((c, r) in local for r, c in local)\n    anti_ok = all((n - 1 - c, n - 1 - r) in local for r, c in local)\n    if main_ok:\n        if (0, 0) in local and (n - 1, n - 1) not in local:\n            return \"TL\"\n        if (n - 1, n - 1) in local and (0, 0) not in local:\n            return \"BR\"\n    if anti_ok:\n        if (0, n - 1) in local and (n - 1, 0) not in local:\n            return \"TR\"\n        if (n - 1, 0) in local and (0, n - 1) not in local:\n            return \"BL\"\n    return None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Keep the largest 8-connected motif and replace the corner/control pixels with a solid corner triangle.\n\n    Input structure\n    - The background is the dominant color.\n    - Exactly one grid corner contains a foreground control pixel; it gives the\n      corner from which the triangle is painted.\n    - There is one unique largest 8-connected monochrome foreground object, the\n      motif that remains in the output; all other foreground pixels are controls.\n    - Every foreground component outside that motif is a singleton control pixel.\n    - The fill color is the unique control color that appears in at least two\n      non-corner control pixels.\n\n    Rule\n    - Start from a blank background canvas and redraw only the largest motif.\n    - Count the non-corner control pixels; that count is the triangle side.\n    - Paint the fill color on the right-triangle region where those two distances\n      from the marked corner's edges sum to less than the side length.\n\n    Key insight\n    - The scattered singleton controls are counted into a compact triangular\n      stack at the marked corner; only the largest motif is not part of the count.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    corners = {\n        \"TL\": (0, 0),\n        \"TR\": (0, W - 1),\n        \"BL\": (H - 1, 0),\n        \"BR\": (H - 1, W - 1),\n    }\n    marked_corners = [\n        (name, rc) for name, rc in corners.items() if int(g[rc]) != int(bg)\n    ]\n    assert len(marked_corners) == 1, \"expected exactly one foreground corner marker\"\n    corner, (corner_r, corner_c) = marked_corners[0]\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert comps, \"expected at least one foreground component\"\n    max_area = max(int(comp[\"area\"]) for comp in comps)\n    motif_candidates = [comp for comp in comps if int(comp[\"area\"]) == max_area]\n    assert len(motif_candidates) == 1, \"expected a unique largest motif\"\n    motif = motif_candidates[0]\n    motif_color = int(motif[\"color\"])\n    motif_coords = {tuple(map(int, coord)) for coord in motif[\"coords\"]}\n    motif_direction = _diagonal_direction(motif_coords)\n    assert motif_direction is not None, \"motif must be square and diagonal-symmetric\"\n    assert motif_direction == corner, \"corner marker must match motif diagonal direction\"\n\n    control_coords = [\n        (int(r), int(c))\n        for r, c in np.argwhere(g != bg)\n        if (int(r), int(c)) not in motif_coords\n    ]\n    assert (corner_r, corner_c) in control_coords, \"corner marker must be a control pixel\"\n    assert len(control_coords) > 1, \"expected non-corner control pixels\"\n\n    control_components = [comp for comp in comps if comp is not motif]\n    assert all(int(comp[\"area\"]) == 1 for comp in control_components), \"controls must be singleton components\"\n\n    control_counts = Counter(\n        int(g[r, c])\n        for r, c in control_coords\n        if (int(r), int(c)) != (corner_r, corner_c)\n    )\n    fill_candidates = [\n        int(color) for color, count in control_counts.items() if int(count) >= 2\n    ]\n    assert len(fill_candidates) == 1, \"expected one repeated non-corner fill color\"\n    fill_color = fill_candidates[0]\n    side = len(control_coords) - 1\n\n    out = np.full_like(g, bg)\n    for r, c in motif_coords:\n        out[r, c] = motif_color\n    _paint_corner_triangle(out, corner, int(side), fill_color)\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_ATTEMPTS = 300\n\n# Canvas and triangle bounds.\n_GEN_ROW_BOUNDS = (6, 15)\n_GEN_COL_BOUNDS = (9, 14)\n_GEN_TRIANGLE_SIDE_BOUNDS = (2, 5)\n\n# Color and control-pixel sampling.\n_GEN_COLORS = tuple(range(1, 10))\n_GEN_MARKER_AVOID_FILL_PROB = 0.8\n_GEN_FILL_COUNT_BOUNDS = (2, 3)\n\n# Sparse square motifs observed in the task examples.\n_GEN_MOTIF_TEMPLATES = [\n    (\"..#.\", \".#..\", \"#.#.\", \"...#\"),\n    (\".#...\", \"..#..\", \"..##.\", \".#..#\", \"#....\"),\n    (\n        \"...###...\",\n        \"..#......\",\n        \".##......\",\n        \"#..#.....\",\n        \"#...#....\",\n        \"#....#...\",\n        \"......#..\",\n        \".......#.\",\n        \"........#\",\n    ),\n    (\"#...\", \".#.#\", \"..#.\", \".#..\"),\n    (\"...#\", \"#.#.\", \"##..\", \".##.\"),\n]\n\n\ndef _gen_triangle_mask(shape, corner, side):\n    H, W = shape\n    rr, cc = np.indices((H, W))\n    if corner == \"TL\":\n        return rr + cc < side\n    if corner == \"TR\":\n        return rr + (W - 1 - cc) < side\n    if corner == \"BL\":\n        return (H - 1 - rr) + cc < side\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/6350f1f4.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, colors_present, components_mask\nimport math\nimport random\n\n\nERASED = Color.GREY\nSEPARATOR = Color.BLACK\n\n\ndef _is_separator_line(line: np.ndarray) -> bool:\n    return set(map(int, line)).issubset({SEPARATOR, ERASED})\n\n\ndef _regular_intervals(separators: list[int], length: int) -> list[tuple[int, int]]:\n    assert separators, \"expected at least one separator line\"\n    bounds = [-1, *separators, int(length)]\n    intervals = [(bounds[i] + 1, bounds[i + 1]) for i in range(len(bounds) - 1)]\n    sizes = [end - start for start, end in intervals]\n    assert min(sizes) > 0, \"separators must leave non-empty blocks\"\n    assert len(set(sizes)) == 1, \"all encoded blocks must have the same size\"\n    return intervals\n\n\ndef _find_sprite(\n    g: np.ndarray,\n    row_intervals: list[tuple[int, int]],\n    col_intervals: list[tuple[int, int]],\n    payload_colors: list[int],\n) -> np.ndarray:\n    payload = set(payload_colors)\n    sprites = []\n\n    for r0, r1 in row_intervals:\n        for c0, c1 in col_intervals:\n            block = g[r0:r1, c0:c1]\n            block_colors = set(colors_present(block, exclude={ERASED}))\n            assert SEPARATOR not in block_colors, \"block interiors cannot contain separator color\"\n            if ERASED not in set(map(int, block.flat)) and block_colors == payload:\n                sprites.append(block.copy())\n\n    assert sprites, \"expected at least one fully visible sprite block\"\n    sprite = sprites[0]\n    for candidate in sprites:\n        assert np.array_equal(candidate, sprite), \"fully visible sprite blocks must match\"\n    return sprite\n\n\ndef _foreground_and_blank(sprite: np.ndarray, payload_colors: list[int]) -> tuple[int, int]:\n    counts = {color: int(np.count_nonzero(sprite == color)) for color in payload_colors}\n    assert counts[payload_colors[0]] != counts[payload_colors[1]], \"sprite colors must have a majority/minority split\"\n    foreground = max(payload_colors, key=lambda color: counts[color])\n    blank_colors = [color for color in payload_colors if color != foreground]\n    assert len(blank_colors) == 1\n    return int(foreground), int(blank_colors[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Decode a block-grid image by swapping each sprite-coded cell with a solid cell and each blank cell with the sprite.\n\n    Input structure\n    The grid is partitioned by black separator rows and columns into equal-size\n    square blocks. Each block is either a copy of one two-color sprite or a\n    uniform blank block of the sprite's minority color; grey pixels are erased\n    cells that act as wildcards.\n\n    Rule\n    Infer the repeated sprite from fully visible mixed-color blocks. Replace a\n    block matching that sprite, ignoring grey erasures, with a solid block of\n    the sprite's majority color. Replace a uniform blank block with the sprite.\n    Separator rows and columns, including grey erasures on them, become black.\n\n    Key insight\n    The small sprite is a block-level code for one macro-cell state, and the\n    uniform minority-color block is the other state; the output renders the\n    opposite code in each macro-cell while cleaning erased pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n\n    row_separators = [r for r in range(H) if _is_separator_line(g[r, :])]\n    col_separators = [c for c in range(W) if _is_separator_line(g[:, c])]\n    row_intervals = _regular_intervals(row_separators, H)\n    col_intervals = _regular_intervals(col_separators, W)\n    block_heights = {r1 - r0 for r0, r1 in row_intervals}\n    block_widths = {c1 - c0 for c0, c1 in col_intervals}\n    assert block_heights == block_widths, \"encoded blocks must be square\"\n\n    payload_colors = colors_present(g, exclude={SEPARATOR, ERASED})\n    assert len(payload_colors) == 2, \"expected exactly two non-separator payload colors\"\n    sprite = _find_sprite(g, row_intervals, col_intervals, payload_colors)\n    foreground, blank = _foreground_and_blank(sprite, payload_colors)\n\n    out = np.zeros_like(g)\n    for r0, r1 in row_intervals:\n        for c0, c1 in col_intervals:\n            block = g[r0:r1, c0:c1]\n            known = block != ERASED\n            assert known.any(), \"each block must expose at least one non-grey cell\"\n            matches_sprite = bool(np.all(block[known] == sprite[known]))\n            matches_blank = bool(np.all(block[known] == blank))\n            assert matches_sprite != matches_blank, \"each block must unambiguously match the sprite or blank state\"\n            out[r0:r1, c0:c1] = foreground if matches_sprite else sprite\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette bounds.\nGRID_COUNT_RANGE, BLOCK_SIZE_RANGE = (2, 4), (2, 4)\nPAYLOAD_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\nPAYLOAD_COLOR_COUNT = 2\nGEN_SEPARATOR_COLOR, GEN_ERASED_COLOR = int(SEPARATOR), int(ERASED)\n\n# Sprite composition constraints.\nSPRITE_FG_MIN_RATIO, SPRITE_FG_MAX_RATIO = (2, 3), (3, 4)\nSPRITE_ATTEMPTS, TINY_BLOCK_SIZE = 80, 2\n\n# Macro-cell state constraints.\nMIN_BLANK_BLOCKS, MAX_BLANK_BLOCK_DENOMINATOR = 1, 2\n\n# Grey overlay constraints.\nGREY_MIN_FRACTION, GREY_MAX_FRACTION = 0.05, 0.25\nGREY_TWO_COMPONENT_PROBABILITY, GREY_TWO_COMPONENT_ATTEMPTS = 0.5, 30\nGREY_CONNECTIVITY, GENERATION_ATTEMPTS = 4, 300\n\nNEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _separator_indices(n: int, block_size: int) -> set[int]:\n    return {(i + 1) * block_size + i for i in range(n - 1)}\n\n\ndef _block_origin(br: int, bc: int, block_size: int) -> tuple[int, int]:\n    return br * (block_size + 1), bc * (block_size + 1)\n\n\ndef _has_symmetry(mask: np.ndarray) -> bool:\n    return (\n        np.array_equal(mask, np.fliplr(mask))\n        or np.array_equal(mask, np.flipud(mask))\n        or np.array_equal(mask, np.rot90(mask, 2))\n    )\n\n\ndef _make_sprite(block_size: int, foreground: int, blank: int) -> np.ndarray | None:\n    area = block_size * block_size\n    min_num, min_den = SPRITE_FG_MIN_RATIO\n    max_num, max_den = SPRITE_FG_MAX_RATIO\n    fg_min = math.ceil(area * min_num / min_den)\n    fg_max = math.floor(area * max_num / max_den)\n    if fg_min > fg_max:\n        fg_min = fg_max = round(area * min_num / min_den)\n    fg_count = random.randint(fg_min, fg_max)\n    blank_count = area - fg_count\n\n    for _ in range(SPRITE_ATTEMPTS):\n        mask = np.ones((block_size, block_size), dtype=bool)\n        if block_size == TINY_BLOCK_SIZE:\n            blanks = [random.randrange(area)]\n        else:\n            cols = list(range(block_size))\n            random.shuffle(cols)\n            blanks = [r * block_size + cols[r] for r in range(block_size)]\n            extra = blank_count - block_size\n            if extra > 0:\n                pool = [i for i in range(area) if i not in blanks]\n                blanks.extend(random.sample(pool, extra))\n\n        for idx in blanks:\n            mask[idx // block_size, idx % block_size] = False\n\n        if block_size > TINY_BLOCK_SIZE:\n            row_mixed = all(0 < np.count_nonzero(mask[r]) < block_size for r in range(block_size))\n            col_mixed = all(0 < np.count_nonzero(mask[:, c]) < block_size for c in range(block_size))\n            if not row_mixed or not col_mixed:\n                continue\n        if _has_symmetry(mask):\n            continue\n\n        sprite = np.where(mask, foreground, blank).astype(int)\n        return sprite\n    return None\n\n\ndef _neighbors4(r: int, c: int, height: int, width: int):\n    for dr, dc in NEIGHBOR_OFFSETS_4:\n        nr, nc = r + dr, c + dc\n        if 0 <= nr < height and 0 <= nc < width:\n            yield nr, nc\n\n\ndef _grow_blob(allowed: np.ndarray, size: int) -> set[tuple[int, int]] | None:\n    comps = [\n        [tuple(map(int, rc)) for rc in coords]\n        for coords in components_mask(allowed, connectivity=GREY_CONNECTIVITY)\n        if len(coords) >= size\n    ]\n    if not comps:\n        return None\n\n    comp = random.choice(comps)\n    comp_set = set(comp)\n    seed = random.choice(comp)\n    blob = {seed}\n    frontier = {nb for nb in _neighbors4(*seed, *allowed.shape) if nb in comp_set}\n\n    while len(blob) < size:\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        blob.add(cell)\n        for nb in _neighbors4(*cell, *allowed.shape):\n            if nb in comp_set and nb not in blob:\n                frontier.add(nb)\n","exit_code":0,"status":"completed"}}
