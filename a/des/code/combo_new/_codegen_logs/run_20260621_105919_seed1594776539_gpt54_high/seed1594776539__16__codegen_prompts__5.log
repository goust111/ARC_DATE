get_bg(g)\n  93:     order = _legend_order(g, bg)\n  94:     signatures = {color: _shape_signature(_main_object_mask(g, bg, color)) for color in order}\n  95: \n  96:     n = len(order)\n  97:     out = np.full((3 * n + 2, 3 * n + 2), int(bg), dtype=int)\n  98: \n  99:     for i, color in enumerate(order):\n 100:         band = 3 + 3 * i\n 101:         out[0:2, band : band + 2] = int(color)\n 102:         out[band : band + 2, 0:2] = int(color)\n 103: \n 104:     for i, row_color in enumerate(order):\n 105:         for j, col_color in enumerate(order):\n 106:             if i == j:\n 107:                 continue\n 108:             cell_color = Color.RED if signatures[row_color] == signatures[col_color] else Color.GREY\n 109:             r = 3 + 3 * i\n 110:             c = 3 + 3 * j\n 111:             out[r : r + 2, c : c + 2] = int(cell_color)\n 112: \n 113:     return out\n 114: \n 115: # --------------- generator (att2) ---------------\n 116: \n 117: # Canvas and object bounds.\n 118: GEN_OBJECT_COUNT_RANGE, GEN_GRID_ROW_RANGE, GEN_GRID_COL_RANGE = (4, 7), (20, 25), (20, 23)\n 119: GEN_OBJECT_AREA_RANGE, GEN_OBJECT_BBOX_RANGE, GEN_OBJECT_MAX_EXTRA_CELLS = (5, 13), (2, 7), 4\n 120: # Shape-class sampling.\n 121: GEN_CLASS_OPTIONS, GEN_MAX_CLASS_SIZE, GEN_UNIQUE_MASK_RETRIES = (2, 3), 3, 80\n 122: GEN_DIHEDRAL_FLIP_PROB = 0.5\n 123: # Output table layout and colors.\n 124: GEN_OBJECT_COLORS, GEN_TABLE_BLOCK, GEN_TABLE_STEP = [1, 3, 4, 6, 7, 8, 9], 2, 3\n 125: GEN_SAME_SHAPE_COLOR, GEN_DIFFERENT_SHAPE_COLOR = int(Color.RED), int(Color.GREY)\n 126: # Input placement and retry limits.\n 127: GEN_RESERVED_RIGHT_COLS, GEN_ATTEMPTS = 2, 300\n 128: GEN_PLACEMENT_BORDER, GEN_PLACEMENT_PADDING, GEN_PLACEMENT_CONNECTIVITY = 1, 2, 4\n 129: GEN_NEIGHBORS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n 130: \n 131: \n 132: def _gen_tight_mask(mask: np.ndarray) -> np.ndarray:\n 133:     coords = np.argwhere(mask)\n 134:     r0, c0, r1, c1 = bbox_coords(coords)\n 135:     return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)\n 136: \n 137: \n 138: def _gen_mask_key(mask: np.ndarray) -> tuple[str, ...]:\n 139:     return tuple(\"\".join(\"1\" if cell else \"0\" for cell in row) for row in mask)\n 140: \n 141: \n 142: def _gen_shape_signature(mask: np.ndarray) -> tuple[str, ...]:\n 143:     base = _gen_tight_mask(mask)\n 144:     variants = []\n 145:     for k in range(4):\n 146:         rotated = np.rot90(base, k)\n 147:         variants.append(_gen_mask_key(_gen_tight_mask(rotated)))\n 148:         variants.append(_gen_mask_key(_gen_tight_mask(np.fliplr(rotated))))\n 149:     return min(variants)\n 150: \n 151: \n 152: def _has_hole(mask: np.ndarray) -> bool:\n 153:     bg = ~mask.astype(bool)\n 154:     if not bool(bg.any()):\n 155:         return False\n 156: \n 157:     H, W = bg.shape\n 158:     seen = np.zeros_like(bg, dtype=bool)\n 159:     stack: list[tuple[int, int]] = []\n 160:     for r in range(H):\n 161:         for c in (0, W - 1):\n 162:             if bg[r, c] and not seen[r, c]:\n 163:                 seen[r, c] = True\n 164:                 stack.append((r, c))\n 165:     for c in range(W):\n 166:         for r in (0, H - 1):\n 167:             if bg[r, c] and not seen[r, c]:\n 168:                 seen[r, c] = True\n 169:                 stack.append((r, c))\n 170: \n 171:     while stack:\n 172:         r, c = stack.pop()\n 173:         for dr, dc in GEN_NEIGHBORS_4:\n 174:             nr, nc = r + dr, c + dc\n 175:             if 0 <= nr < H and 0 <= nc < W and bg[nr, nc] and not seen[nr, nc]:\n 176:                 seen[nr, nc] = True\n 177:                 stack.append((nr, nc))\n 178:     return bool((bg & ~seen).any())\n 179: \n 180: \n 181: def _random_corner_path(h: int, w: int) -> np.ndarray:\n 182:     starts = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]\n 183:     sr, sc = random.choice(starts)\n 184:     er, ec = h - 1 - sr, w - 1 - sc\n 185:     moves = [(1 if er > sr else -1, 0)] * (h - 1)\n 186:     moves += [(0, 1 if ec > sc else -1)] * (w - 1)\n 187:     random.shuffle(moves)\n 188: \n 189:     mask = np.zeros((h, w), dtype=bool)\n 190:     r, c = sr, sc\n 191:     mask[r, c] = True\n 192:     for dr, dc in moves:\n 193:         r += dr\n 194:         c += dc\n 195:         mask[r, c] = True\n 196:     return mask\n 197: \n 198: \n 199: def _growth_candidates(mask: np.ndarray) -> list[tuple[int, int]]:\n 200:     h, w = mask.shape\n 201:     choices = []\n 202:     for r in range(h):\n 203:         for c in range(w):\n 204:             if mask[r, c]:\n 205:                 continue\n 206:             touches = sum(\n 207:                 0 <= r + dr < h and 0 <= c + dc < w and mask[r + dr, c + dc]\n 208:                 for dr, dc in GEN_NEIGHBORS_4\n 209:             )\n 210:             if touches != 1:\n 211:                 continue\n 212:             trial = mask.copy()\n\n--- 356: def generate_input() -> np.ndarray:\n 356: def generate_input() -> np.ndarray:\n 357:     for _ in range(GEN_ATTEMPTS):\n 358:         grid = _gen_attempt()\n 359:         if grid is not None:\n 360:             return grid\n 361:     raise RuntimeError(\"failed to generate a valid 6165ea8f input\")\n\n","exit_code":0,"status":"completed"}}
