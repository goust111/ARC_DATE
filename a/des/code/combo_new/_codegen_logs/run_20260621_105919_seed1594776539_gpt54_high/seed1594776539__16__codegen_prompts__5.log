109:         eff_fill = int(fill)\n 110:         marker_pts = set(map(tuple, np.argwhere((g == marker) & (~legend_mask))))\n 111:         if len(marker_pts) < 2:\n 112:             continue\n 113: \n 114:         rs = [r for r, _ in marker_pts]\n 115:         cs = [c for _, c in marker_pts]\n 116:         rmin, rmax = min(rs), max(rs)\n 117:         cmin, cmax = min(cs), max(cs)\n 118: \n 119:         # Protect legend cells and all marker pixels for entries that appear later (higher) in the legend.\n 120:         future_markers = set(marker_order[i + 1 :])\n 121:         protect = legend_mask.copy()\n 122:         for fm in future_markers:\n 123:             protect |= (g == fm) & (~legend_mask)\n 124: \n 125:         # Also protect current marker pixels in the common case (so markers remain visible),\n 126:         # except when they form a solid 2x2 block (treated as a filled marker that gets recolored).\n 127:         if rmax - rmin == 1 and cmax - cmin == 1 and len(marker_pts) == 4:\n 128:             # Solid 2x2 marker: recolor these pixels directly.\n 129:             block = np.zeros_like(g, dtype=bool)\n 130:             for r, c in marker_pts:\n 131:                 block[r, c] = True\n 132:             out[block & (~protect)] = eff_fill\n 133:             continue\n 134:         else:\n 135:             protect |= (g == marker) & (~legend_mask)\n 136: \n 137:         if rmin == rmax or cmin == cmax:\n 138:             continue\n 139: \n 140:         tl = (rmin, cmin)\n 141:         tr = (rmin, cmax)\n 142:         bl = (rmax, cmin)\n 143:         br = (rmax, cmax)\n 144: \n 145:         tl_anchor = _l_anchor_present(marker_pts, tl[0], tl[1], (0, 1), (1, 0))\n 146:         tr_anchor = _l_anchor_present(marker_pts, tr[0], tr[1], (0, -1), (1, 0))\n 147:         bl_anchor = _l_anchor_present(marker_pts, bl[0], bl[1], (0, 1), (-1, 0))\n 148:         br_anchor = _l_anchor_present(marker_pts, br[0], br[1], (0, -1), (-1, 0))\n 149: \n 150:         score_tlbr = int