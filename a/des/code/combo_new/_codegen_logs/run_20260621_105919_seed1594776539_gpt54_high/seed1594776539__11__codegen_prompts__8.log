{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/58490d8a.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_coords, components_mask, crop_bbox, get_bg, label_mask, paste, random_free_location\nimport random\nfrom functools import lru_cache\nfrom itertools import combinations\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count colored objects and record tallies inside a legend box.\n\n    Input structure:\n    - A black rectangular legend box with key-color pixels in its leftmost non-black column.\n    - Outside the box, distinct objects of each key color are scattered across the grid.\n\n    Rule:\n    - For each key color, count separate same-colored objects outside the legend box.\n    - Output the legend box repainted: each key row gets one dot per object, spaced every other cell rightward from the key pixel.\n\n    Key insight: The legend is both the color index and the output canvas — object counts become dot sequences on the matching row.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    _bg = int(get_bg(g))\n\n    black = 0\n\n    # STEP 1) Find the legend bbox: largest black CC whose bbox contains some non-black pixels.\n    best = None  # (area, bbox)\n    for coords in components_mask(g == int(black), connectivity=8):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if (sub != int(black)).any():\n            area = int(coords.shape[0])\n            cand = (area, tuple(map(int, b)))\n            if best is None or cand[0] > best[0]:\n                best = cand\n\n    assert not (best is None)\n\n    r0, c0, r1, c1 = map(int, best[1])\n    box = crop_bbox(g, (r0, c0, r1, c1))\n    bh, bw = map(int, box.shape)\n\n    # STEP 2) Inside the legend bbox, find the key column:\n    # leftmost column with any non-black pixels (the \"key pixels\").\n    key_col = None\n    for cc in range(bw):\n        if (box[:, int(cc)] != int(black)).any():\n            key_col = int(cc)\n            break\n    if key_col is None:\n        return np.zeros_like(box)\n\n    keys = [(int(rr), int(box[int(rr), int(key_col)])) for rr in range(bh) if int(box[int(rr), int(key_col)]) != int(black)]\n    keys.sort(key=lambda t: int(t[0]))\n\n    outside = np.ones((H, W), dtype=bool)\n    outside[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = False\n    out = np.zeros((bh, bw), dtype=int)\n\n    # STEP 3/4) Count CCs of each key color outside the legend, then draw 1 dot per CC.\n    for rr, col in keys:\n        mask = (g == int(col)) & outside\n        _labc, nc = label_mask(mask, connectivity=8)\n        for i in range(int(nc)):\n            cc = int(key_col + 2 * i)\n            if 0 <= cc < bw:\n                out[int(rr), int(cc)] = int(col)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette and legend color choices.\nCOLOR_POOL = tuple(range(1, 10))\nBLACK = 0\nDISTRACTOR_PROB = 0.5\n\n# Key rows and tally dimensions.\nKEY_COUNT_RANGE = (2, 4)\nTARGET_COUNT_RANGE = (1, 5)\nKEY_ROW_FIRST = 1\nKEY_ROW_STEP = 2\nKEY_COLUMN = 1\nTALLY_COL_STEP = 2\nLEGEND_HEIGHT_TAIL = 1\nLEGEND_WIDTH_TAIL = 1\nLEGEND_SLACK_RANGE = (0, 3)\n\n# Canvas size and legend placement bounds.\nGRID_HEIGHT_RANGE = (20, 25)\nGRID_WIDTH_RANGE = (20, 25)\nLEGEND_EDGE_MARGIN = 2\n\n# Sprite shape and placement constraints.\nSPRITE_AREA_RANGE = (4, 7)\nSPRITE_BBOXES = ((2, 2), (2, 3), (3, 2), (3, 3))\nSPRITE_CONNECTIVITY = 8\nSPRITE_PADDING = 1\nSPRITE_PADDING_CONNECTIVITY = 8\n\n# Retry budget for rejection sampling.\nGENERATION_ATTEMPTS = 300\n\n\ndef _randint(bounds: tuple[int, int]) -> int:\n    \"\"\"Return an inclusive randint from a configured (low, high) pair.\"\"\"\n    return random.randint(bounds[0], bounds[1])\n\n\n@lru_cache(maxsize=None)\ndef _valid_masks(h: int, w: int, area: int) -> tuple[np.ndarray, ...]:\n    \"\"\"Return connected masks that span all four sides of the sprite bbox.\"\"\"\n    masks = []\n    for cells in combinations(range(h * w), area):\n        mask = np.zeros((h, w), dtype=bool)\n        for cell in cells:\n            mask[cell // w, cell % w] = True\n        spans_edges = mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()\n        if not spans_edges:\n            continue\n        _, n = label_mask(mask, connectivity=SPRITE_CONNECTIVITY)\n        if n == 1:\n            masks.append(mask)\n    return tuple(masks)\n\n\ndef _make_sprite(color: int, bg: int) -> np.ndarray:\n    \"\"\"Sample one connected same-color sprite drawn on the background color.\"\"\"\n    area = _randint(SPRITE_AREA_RANGE)\n    dims = []\n    for h, w in SPRITE_BBOXES:\n        if h * w >= area and _valid_masks(h, w, area):\n            dims.append((h, w))\n    h, w = random.choice(dims)\n    mask = random.choice(_valid_masks(h, w, area))\n    sprite = np.full((h, w), int(bg), dtype=int)\n    sprite[mask] = int(color)\n    return sprite\n\n\ndef _sample_palette() -> tuple[int, list[int], int | None]:\n    \"\"\"Choose background, key colors, and optional distractor color.\"\"\"\n    colors = list(COLOR_POOL)\n    bg = random.choice(colors)\n\n    k = _randint(KEY_COUNT_RANGE)\n    remaining = [c for c in colors if c != bg]\n    key_colors = random.sample(remaining, k)\n    remaining = [c for c in remaining if c not in key_colors]\n    distractor_color = random.choice(remaining) if remaining and random.random() < DISTRACTOR_PROB else None\n    return bg, key_colors, distractor_color\n\n\ndef _sample_counts(k: int) -> list[int]:\n    \"\"\"Sample the target outside-component count for each key color.\"\"\"\n    return [_randint(TARGET_COUNT_RANGE) for _ in range(k)]\n\n\ndef _legend_shape(k: int, max_count: int) -> tuple[int, int]:\n    \"\"\"Return legend height and width for the key count and largest tally.\"\"\"\n    bh = KEY_ROW_STEP * k + LEGEND_HEIGHT_TAIL\n    bw = TALLY_COL_STEP * max_count + LEGEND_WIDTH_TAIL + _randint(LEGEND_SLACK_RANGE)\n    return bh, bw\n\n\ndef _key_row(i: int) -> int:\n    \"\"\"Map a zero-based key index to its row inside the legend/output box.\"\"\"\n    return KEY_ROW_FIRST + KEY_ROW_STEP * i\n\n\ndef _build_expected(key_colors: list[int], counts: list[int]) -> np.ndarray:\n    \"\"\"Render the black output tally canvas implied by key colors and counts.\"\"\"\n    max_count = max(counts)\n    bh, bw = _legend_shape(len(key_colors), max_count)\n\n    expected = np.full((bh, bw), BLACK, dtype=int)\n    for i, (color, count) in enumerate(zip(key_colors, counts)):\n        rr = _key_row(i)\n        for j in range(count):\n            expected[rr, KEY_COLUMN + TALLY_COL_STEP * j] = int(color)\n    return expected\n\n\ndef _build_legend(shape: tuple[int, int], key_colors: list[int]) -> np.ndarray:\n    \"\"\"Return a black legend patch with only the key-column pixels filled.\"\"\"\n    legend = np.full(shape, BLACK, dtype=int)\n    for i, color in enumerate(key_colors):\n        legend[_key_row(i), KEY_COLUMN] = int(color)\n    return legend\n\n\ndef _new_grid_with_legend(bg: int, legend: np.ndarray) -> np.ndarray | None:\n    \"\"\"Sample a grid and paste the legend away from all canvas edges.\"\"\"\n    bh, bw = map(int, legend.shape)\n    H = _randint(GRID_HEIGHT_RANGE)\n    W = _randint(GRID_WIDTH_RANGE)\n    min_h = bh + 2 * LEGEND_EDGE_MARGIN\n    min_w = bw + 2 * LEGEND_EDGE_MARGIN\n    if H < min_h or W < min_w:\n        return None\n\n    grid = np.full((H, W), int(bg), dtype=int)\n    r0 = random.randint(LEGEND_EDGE_MARGIN, H - bh - LEGEND_EDGE_MARGIN)\n    c0 = random.randint(LEGEND_EDGE_MARGIN, W - bw - LEGEND_EDGE_MARGIN)\n    paste(grid, legend, r0, c0)\n    return grid\n\n\ndef _build_sprite_queue(\n    key_colors: list[int],\n    counts: list[int],\n    distractor_color: int | None,\n    bg: int,\n) -> list[np.ndarray]:\n    \"\"\"Create canonical key sprites, optional distractor sprite, and shuffle them.\"\"\"\n    sprites = []\n    for color, count in zip(key_colors, counts):\n        sprite = _make_sprite(color, bg)\n        for _ in range(count):\n            sprites.append(sprite.copy())\n    if distractor_color is not None:\n        sprites.append(_make_sprite(distractor_color, bg))\n    random.shuffle(sprites)\n    return sprites\n\n\ndef _place_sprites(grid: np.ndarray, sprites: list[np.ndarray], bg: int) -> None:\n    \"\"\"Paste sprites into random non-touching free locations in queue order.\"\"\"\n    for sprite in sprites:\n        sr, sc = random_free_location(\n            grid,\n            sprite,\n            transparent=bg,\n            padding=SPRITE_PADDING,\n            padding_connectivity=SPRITE_PADDING_CONNECTIVITY,\n        )\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/9385bd28.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg\nimport random\nfrom collections import Counter\n\n\ndef _find_legend(g: np.ndarray, bg: int) -> tuple[int, list[tuple[int, int, int]]]:\n    \"\"\"\n    Legend is a vertical stack of pairs at bottom-left.\n    Each legend row: (marker_color at col c, fill_color at col c+1).\n    Returns (legend_col, entries) where entries are ordered bottom->top as (row, marker, fill).\n    \"\"\"\n    h, w = g.shape\n    start_r = None\n    start_c = None\n    for r in range(h - 1, -1, -1):\n        nz = np.flatnonzero(g[r, :] != bg)\n        if nz.size:\n            start_r = r\n            start_c = int(nz[0])\n            break\n    assert start_r is not None and start_c is not None and start_c < w - 1, \\\n        \"legend must exist at bottom-left with at least 2 columns\"\n\n    entries: list[tuple[int, int, int]] = []\n    c = start_c\n    for r in range(start_r, -1, -1):\n        nz = np.flatnonzero(g[r, :] != bg)\n        if nz.size == 0 or int(nz[0]) != c or int(g[r, c]) == bg:\n            break\n        marker = int(g[r, c])\n        fill = int(g[r, c + 1]) if c + 1 < w else bg\n        entries.append((r, marker, fill))\n    return c, entries\n\n\ndef _l_anchor_present(pts: set[tuple[int, int]], r: int, c: int, arm1: tuple[int, int], arm2: tuple[int, int]) -> bool:\n    \"\"\"\n    Marker corners are L-shapes:\n      TL: (r,c), (r,c+1), (r+1,c)\n      TR: (r,c), (r,c-1), (r+1,c)\n      BL: (r,c), (r,c+1), (r-1,c)\n      BR: (r,c), (r,c-1), (r-1,c)\n\n    This is more robust than checking only corner membership, especially when the bbox is 2-wide/2-tall\n    where L arms can overlap other bbox corners.\n    \"\"\"\n    (dr1, dc1) = arm1\n    (dr2, dc2) = arm2\n    return (r, c) in pts and (r + dr1, c + dc1) in pts and (r + dr2, c + dc2) in pts\n\n\ndef _diamond_mask(h: int, w: int, r0: int, r1: int, c0: int, c1: int, a: tuple[int, int], b: tuple[int, int]) -> np.ndarray:\n    \"\"\"\n    Mask for all cells inside [r0..r1]x[c0..c1] that lie on some shortest 4-neigh path between corners a and b:\n      dist(a,p) + dist(p,b) == dist(a,b)\n    \"\"\"\n    ar, ac = a\n    br, bc = b\n    dab = abs(ar - br) + abs(ac - bc)\n    m = np.zeros((h, w), dtype=bool)\n    for r in range(r0, r1 + 1):\n        for c in range(c0, c1 + 1):\n            if abs(r - ar) + abs(c - ac) + abs(r - br) + abs(c - bc) == dab:\n                m[r, c] = True\n    return m\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill rectangles between diagonal marker pairs using a color legend.\n\n    Input structure:\n    - bg grid with a vertical legend at the bottom-left: each row is a (marker_color, fill_color) pair.\n    - Scattered L-shaped corner markers of each marker color define opposite corners of axis-aligned rectangles.\n    - Some markers are solid 2×2 blocks instead of corner pairs.\n\n    Rule:\n    - Read legend bottom-to-top; for each entry find all pixels of that marker color.\n    - Determine which two bbox corners carry L-shaped anchors — the *other* diagonal defines the fill region.\n    - Fill the diamond (all shortest-path cells between those two corners) with the legend's fill color.\n    - Solid 2×2 marker blocks are simply recolored to the fill color.\n    - Later legend entries are protected from earlier fills.\n\n    Key insight: The L-shaped anchors sit on the marker diagonal; the fill goes on the opposite diagonal of the bounding box.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    bg = get_bg(g)\n    legend_c, entries = _find_legend(g, bg)\n    assert entries, \"legend must contain at least one (marker, fill) entry\"\n\n    legend_mask = np.zeros_like(g, dtype=bool)\n    for r, _, _ in entries:\n        if 0 <= r < h and 0 <= legend_c < w:\n            legend_mask[r, legend_c] = True\n        if 0 <= r < h and 0 <= legend_c + 1 < w:\n            legend_mask[r, legend_c + 1] = True\n\n    out = g.copy()\n\n    marker_order = [m for _, m, _ in entries]\n    marker_set = set(marker_order)\n\n    # Process legend entries bottom -> top; earlier entries must not destroy later marker pixels.\n    for i, (_, marker, fill) in enumerate(entries):\n        eff_fill = int(fill)\n        marker_pts = set(map(tuple, np.argwhere((g == marker) & (~legend_mask))))\n        if len(marker_pts) < 2:\n            continue\n\n        rs = [r for r, _ in marker_pts]\n        cs = [c for _, c in marker_pts]\n        rmin, rmax = min(rs), max(rs)\n        cmin, cmax = min(cs), max(cs)\n\n        # Protect legend cells and all marker pixels for entries that appear later (higher) in the legend.\n        future_markers = set(marker_order[i + 1 :])\n        protect = legend_mask.copy()\n        for fm in future_markers:\n            protect |= (g == fm) & (~legend_mask)\n\n        # Also protect current marker pixels in the common case (so markers remain visible),\n        # except when they form a solid 2x2 block (treated as a filled marker that gets recolored).\n        if rmax - rmin == 1 and cmax - cmin == 1 and len(marker_pts) == 4:\n            # Solid 2x2 marker: recolor these pixels directly.\n            block = np.zeros_like(g, dtype=bool)\n            for r, c in marker_pts:\n                block[r, c] = True\n            out[block & (~protect)] = eff_fill\n            continue\n        else:\n            protect |= (g == marker) & (~legend_mask)\n\n        if rmin == rmax or cmin == cmax:\n            continue\n\n        tl = (rmin, cmin)\n        tr = (rmin, cmax)\n        bl = (rmax, cmin)\n        br = (rmax, cmax)\n\n        tl_anchor = _l_anchor_present(marker_pts, tl[0], tl[1], (0, 1), (1, 0))\n        tr_anchor = _l_anchor_present(marker_pts, tr[0], tr[1], (0, -1), (1, 0))\n        bl_anchor = _l_anchor_present(marker_pts, bl[0], bl[1], (0, 1), (-1, 0))\n        br_anchor = _l_anchor_present(marker_pts, br[0], br[1], (0, -1), (-1, 0))\n\n        score_tlbr = int(tl_anchor) + int(br_anchor)\n        score_trbl = int(tr_anchor) + int(bl_anchor)\n        assert score_tlbr != 0 or score_trbl != 0, \"at least one diagonal must have an L-anchor\"\n        assert score_tlbr != score_trbl, \"diagonal scores must not tie (tie-break path is unreachable)\"\n        if score_tlbr > score_trbl:\n            a, b = tr, bl\n        else:\n            a, b = tl, br\n\n        diamond = _diamond_mask(h, w, rmin, rmax, cmin, cmax, a, b)\n        out[diamond & (~protect)] = eff_fill\n\n    return out\n\n# --------------- generator (C1) ---------------\n\n# ── CFG: canvas & grid ──────────────────────────────────────────────\nGRID_H_RANGE = (10, 19)          # grid height bounds\nGRID_W_RANGE = (10, 19)          # grid width bounds\n\n# ── CFG: legend ─────────────────────────────────────────────────────\nLEGEND_COL_RANGE = (0, 2)        # legend left column (marker at c, fill at c+1)\nLEGEND_ENTRY_RANGE = (2, 5)      # number of legend entries\n\n# ── CFG: marker types ──────────────────────────────────────────────\nNOOP_PROB = 0.3                  # prob of one noop entry (marker with no pixels)\nBLOCK_PROB = 0.25                # prob of one 2x2 block entry\n\n# ── CFG: L-pair bbox shape ──────────────────────────────────────────\nBBOX_H_MAX = 19                  # max bbox height\nBBOX_W_MAX = 12                  # max bbox width\nBBOX_SHAPE_WEIGHTS = [0.75, 0.15, 0.10]  # [both>=3, h=2/w>=4, h>=4/w=2]\nTLBR_PROB = 0.8                  # prob of TL-BR diagonal (vs TR-BL)\n\n# ── CFG: distractor ────────────────────────────────────────────────\nDISTRACTOR_PROB = 0.25           # prob of adding a non-legend L-pair\n\n# ── CFG: retry budgets ─────────────────────────────────────────────\nBLOCK_RETRIES = 100              # placement attempts for a 2x2 block\nLPAIR_RETRIES = 150              # placement attempts for an L-pair\nDISTRACTOR_RETRIES = 60          # placement attempts for distractor\nGEN_RETRIES = 300                # outer generate_input retry budget\n\n_L_OFFSETS = {\n    \"TL\": [(0, 0), (0, 1), (1, 0)],\n    \"TR\": [(0, 0), (0, -1), (1, 0)],\n    \"BL\": [(0, 0), (0, 1), (-1, 0)],\n    \"BR\": [(0, 0), (0, -1), (-1, 0)],\n}\n\n\ndef _l_pair_cells(rmin: int, cmin: int, rmax: int, cmax: int, diag: str) -> list[tuple[int, int]]:\n    \"\"\"Return the 6 cells for an L-pair at opposite bbox corners. diag in {'TLBR','TRBL'}.\"\"\"\n    if diag == \"TLBR\":\n        anchors = [(\"TL\", rmin, cmin), (\"BR\", rmax, cmax)]\n    else:\n        anchors = [(\"TR\", rmin, cmax), (\"BL\", rmax, cmin)]\n    cells: list[tuple[int, int]] = []\n    for name, r, c in anchors:\n        for dr, dc in _L_OFFSETS[name]:\n            cells.append((r + dr, c + dc))\n    return cells\n\n\ndef _l_pair_valid_bbox(h: int, w: int) -> bool:\n    \"\"\"True if (h, w) avoids an L-anchor score tie.\n\n    Fails for (2,2), (2,3), (3,2). Safe: h>=3 and w>=3, or h==2 and w>=4, or h>=4 and w==2.\n    \"\"\"\n    if h < 2 or w < 2:\n        return False\n    if h == 2 and w <= 3:\n        return False\n    if w == 2 and h <= 3:\n        return False\n    return True\n\n\ndef _pick_bbox_size(H: int, W: int) -> tuple[int, int] | None:\n    \"\"\"Pick a random valid L-pair bbox size that fits in (H, W).\"\"\"\n    shape_choice = random.choices(\n        [\"both_ge3\", \"h2_w_ge4\", \"h_ge4_w2\"],\n        weights=BBOX_SHAPE_WEIGHTS,\n    )[0]\n    if shape_choice == \"both_ge3\":\n        bh = random.randint(3, min(BBOX_H_MAX, H))\n        bw = random.randint(3, min(BBOX_W_MAX, W))\n    elif shape_choice == \"h2_w_ge4\":\n        bh = 2\n        w_hi = min(BBOX_W_MAX, W)\n        if w_hi < 4:\n            return None\n        bw = random.randint(4, w_hi)\n    else:\n        h_hi = min(BBOX_H_MAX, H)\n        if h_hi < 4:\n            return None\n        bh = random.randint(4, h_hi)\n        bw = 2\n    if bh > H or bw > W or not _l_pair_valid_bbox(bh, bw):\n        return None\n    return bh, bw\n\n\ndef _try_place_l_pair(H: int, W: int, color: int, retries: int,\n                      can_place, do_place) -> bool:\n    \"\"\"Try to place an L-pair of `color` on the grid within `retries` attempts.\n\n    Returns True on success, False if all attempts failed.\n    \"\"\"\n    for _ in range(retries):\n","exit_code":0,"status":"completed"}}
