{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/57edb29d.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import crop_bbox, find_components\nimport random\n\n\ndef _unique_most_common(values: np.ndarray) -> int:\n    counts = Counter(map(int, values.reshape(-1)))\n    max_count = max(counts.values())\n    winners = [color for color, count in counts.items() if count == max_count]\n    assert len(winners) == 1, \"expected a unique dominant color\"\n    return int(winners[0])\n\n\ndef _boundary_bg(g: np.ndarray) -> int:\n    boundary = np.concatenate((g[0, :], g[-1, :], g[:, 0], g[:, -1]))\n    return _unique_most_common(boundary)\n\n\ndef _runs(cols: np.ndarray) -> list[tuple[int, int]]:\n    assert cols.size > 0, \"expected a nonempty marker row\"\n    spans = []\n    start = end = int(cols[0])\n    for col in map(int, cols[1:]):\n        if col == end + 1:\n            end = col\n        else:\n            spans.append((start, end))\n            start = end = col\n    spans.append((start, end))\n    return spans\n\n\ndef _map_row(row: int, src_h: int, dst_h: int) -> int:\n    top = int(row)\n    bottom = int(src_h - 1 - row)\n    assert top != bottom, \"marker row must be closer to one horizontal edge\"\n    mapped = top if top < bottom else int(dst_h - 1 - bottom)\n    assert 0 <= mapped < dst_h, \"mapped marker row must fit in target rectangle\"\n    return int(mapped)\n\n\ndef _map_col_run(c0: int, c1: int, src_w: int, dst_w: int) -> tuple[int, int]:\n    mid2 = int(src_w - 1)\n    if c0 == c1:\n        left = int(c0)\n        right = int(src_w - 1 - c0)\n        assert left != right, \"single marker pixel must be closer to one vertical edge\"\n        mapped = left if left < right else int(dst_w - 1 - right)\n        assert 0 <= mapped < dst_w, \"mapped marker column must fit in target rectangle\"\n        return int(mapped), int(mapped)\n\n    if 2 * int(c1) <= mid2:\n        start, end = int(c0), int(c1)\n    elif 2 * int(c0) >= mid2:\n        start = int(dst_w - 1 - (src_w - 1 - c0))\n        end = int(dst_w - 1 - (src_w - 1 - c1))\n    else:\n        start = int(c0)\n        end = int(dst_w - 1 - (src_w - 1 - c1))\n\n    assert 0 <= start <= end < dst_w, \"mapped marker run must fit in target rectangle\"\n    return int(start), int(end)\n\n\ndef _adapt_marker_mask(src: np.ndarray, marker_color: int, dst_shape: tuple[int, int]) -> np.ndarray:\n    src_h, src_w = map(int, src.shape)\n    dst_h, dst_w = map(int, dst_shape)\n    src_mask = src == int(marker_color)\n    assert bool(src_mask.any()), \"source rectangle must contain marker pixels\"\n\n    out = np.zeros((dst_h, dst_w), dtype=bool)\n    for row in map(int, np.flatnonzero(src_mask.any(axis=1))):\n        dst_row = _map_row(row, src_h, dst_h)\n        for c0, c1 in _runs(np.flatnonzero(src_mask[row, :])):\n            dst_c0, dst_c1 = _map_col_run(c0, c1, src_w, dst_w)\n            out[dst_row, dst_c0 : dst_c1 + 1] = True\n    return out\n\n\ndef _row_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n    return max(int(a[0]), int(b[0])) <= min(int(a[2]), int(b[2]))\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extract the single plain rectangle and redraw it with the aligned rectangles' border-relative marker pattern.\n\n    Input structure:\n    - The boundary color is the background/separator.\n    - Foreground objects are dense rectangular regions; exactly one rectangle has only its base color.\n    - Other rectangles contain their base color plus marker pixels.\n\n    Rule:\n    - Crop the only plain rectangle; this crop is the output canvas.\n    - Use marked rectangles whose row span overlaps the plain rectangle's row span.\n    - Transfer their marker pixels by preserving each marker run's distance from the nearest rectangle edges.\n\n    Key insight:\n    - The marked rectangles are examples of an edge-relative pattern, so the missing plain rectangle receives the same pattern resized to its own dimensions.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    bg = _boundary_bg(g)\n\n    objects = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False):\n        bbox = tuple(map(int, comp[\"bbox\"]))\n        sub = crop_bbox(g, bbox)\n        assert np.all(sub != bg), \"foreground rectangles must be dense\"\n\n        base_color = _unique_most_common(sub)\n        marker_colors = set(map(int, sub.reshape(-1))) - {int(base_color)}\n        objects.append(\n            {\n                \"bbox\": bbox,\n                \"sub\": sub,\n                \"base_color\": int(base_color),\n                \"marker_colors\": marker_colors,\n            }\n        )\n\n    plain = [obj for obj in objects if not obj[\"marker_colors\"]]\n    assert len(plain) == 1, \"expected exactly one plain rectangle\"\n    target = plain[0]\n    tr0, tc0, tr1, tc1 = target[\"bbox\"]\n    target_shape = (int(tr1 - tr0 + 1), int(tc1 - tc0 + 1))\n\n    sources = [\n        obj\n        for obj in objects\n        if obj[\"marker_colors\"] and _row_overlap(obj[\"bbox\"], target[\"bbox\"])\n    ]\n    assert sources, \"expected at least one marked rectangle aligned with the plain rectangle\"\n\n    marker_colors = set()\n    for source in sources:\n        marker_colors.update(source[\"marker_colors\"])\n    assert len(marker_colors) == 1, \"aligned marked rectangles must share one marker color\"\n    marker_color = int(next(iter(marker_colors)))\n\n    masks = []\n    for source in sources:\n        assert source[\"marker_colors\"] == {marker_color}, \"source must contain only the shared marker color\"\n        masks.append(_adapt_marker_mask(source[\"sub\"], marker_color, target_shape))\n\n    pattern = masks[0]\n    for mask in masks[1:]:\n        assert np.array_equal(mask, pattern), \"aligned marked rectangles must encode the same pattern\"\n\n    out = np.full(target_shape, int(target[\"base_color\"]), dtype=int)\n    out[pattern] = marker_color\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and separator colors.\nBG = 4\nNON_BG = [c for c in range(10) if c != BG]\nGRID_H_RANGE = (20, 28)\nGRID_W_RANGE = (20, 28)\nBORDER_GAP = 1\nBAND_GAP = 1\n# Rectangle counts and dimensions.\nRECT_COUNT_RANGE = (3, 6)\nOVERLAP_MARKED_COUNT = 2\nRECT_H_RANGE = (5, 20)\nRECT_W_RANGE = (5, 12)\nPLAIN_EXTRA_ROW_ROOM = 2\n# Marker pattern sampling.\nMARKER_PAIR_COUNT_RANGE = (1, 3)\nMARKER_EDGE_PAIRS = [(1, 1), (1, 2), (2, 1), (2, 2)]\n# Retry budget.\nGENERATION_ATTEMPTS = 300\n\n\ndef _stamp_pattern(rect: np.ndarray, marker: int, pairs: list[tuple[int, int]]):\n    h, w = rect.shape\n    for nr, nc in pairs:\n        for r in (nr, h - 1 - nr):\n            for c in (nc, w - 1 - nc):\n                rect[r, c] = marker\n\n\ndef _pick_dim(near_vals: list[int], lo: int, hi: int) -> int:\n    min_dim = max(lo, max(2 * nv + 2 for nv in near_vals))\n    cands = [d for d in range(min_dim, hi + 1) if all(d >= 2 * nv + 2 and d != 2 * nv + 1 for nv in near_vals)]\n    return random.choice(cands) if cands else -1\n\n\ndef _choose_marker_pattern():\n    n_pairs = random.randint(*MARKER_PAIR_COUNT_RANGE)\n    pairs = sorted(random.sample(MARKER_EDGE_PAIRS, min(n_pairs, len(MARKER_EDGE_PAIRS))))\n    near_rows = [p[0] for p in pairs]\n    near_cols = [p[1] for p in pairs]\n    return pairs, near_rows, near_cols\n\n\ndef _choose_palette(n_rects: int):\n    needed = n_rects + 1  # base colors + marker\n    if needed > len(NON_BG):\n        return None\n    chosen = random.sample(NON_BG, needed)\n    plain_base, marker_color = chosen[0], chosen[-1]\n    marked_bases = chosen[1:-1]\n    return plain_base, marker_color, marked_bases\n\n\ndef _make_marked_rect(h: int, w: int, base: int, marker: int, pairs: list[tuple[int, int]]) -> np.ndarray:\n    rect = np.full((h, w), base, dtype=int)\n    _stamp_pattern(rect, marker, pairs)\n    return rect\n\n\ndef _choose_plain_shape(near_rows: list[int], near_cols: list[int], avail_h: int, avail_w: int):\n    hp = _pick_dim(near_rows, RECT_H_RANGE[0], min(RECT_H_RANGE[1], avail_h - PLAIN_EXTRA_ROW_ROOM))\n    wp = _pick_dim(near_cols, RECT_W_RANGE[0], min(RECT_W_RANGE[1], avail_w))\n    if hp < 0 or wp < 0:\n        return None\n    return hp, wp\n\n\ndef _has_overlap_width_budget(avail_w: int, plain_w: int) -> bool:\n    remaining_w = avail_w - plain_w - OVERLAP_MARKED_COUNT * BAND_GAP\n    max_overlap_w = remaining_w // OVERLAP_MARKED_COUNT\n    if max_overlap_w >= RECT_W_RANGE[0]:\n        return True\n    return remaining_w >= RECT_W_RANGE[0]\n\n\ndef _build_overlap_rects(avail_h, avail_w, plain_w, near_rows, near_cols, marked_bases, marker_color, pairs):\n    if not _has_overlap_width_budget(avail_w, plain_w):\n        return None\n\n    min_w, max_w = RECT_W_RANGE\n    min_h, max_h = RECT_H_RANGE\n    overlap_rects = []\n    remaining_w = avail_w - plain_w - OVERLAP_MARKED_COUNT * BAND_GAP\n    for i in range(OVERLAP_MARKED_COUNT):\n        if i == 0:\n            max_w_i = min(remaining_w - min_w, max_w)\n        else:\n            max_w_i = min(remaining_w, max_w)\n        wm = _pick_dim(near_cols, min_w, max(min_w, max_w_i))\n        if wm < 0:\n            return None\n        remaining_w -= wm\n        if remaining_w < 0:\n            return None\n        hm = _pick_dim(near_rows, min_h, min(max_h, avail_h))\n        if hm < 0:\n            return None\n        overlap_rects.append(_make_marked_rect(hm, wm, marked_bases[i], marker_color, pairs))\n    return overlap_rects\n\n\ndef _build_non_overlap_rects(n_marked, overlap_band_h, avail_h, avail_w, near_rows, near_cols, marked_bases, marker_color, pairs):\n    min_h, max_h = RECT_H_RANGE\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/e8686506.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location\nimport random\n\n\ndef _piece_sig(pts: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:\n    r0, c0, r1, c1 = bbox_coords(pts)\n    coords = tuple(sorted((int(r) - r0, int(c) - c0) for r, c in pts))\n    return (r1 - r0 + 1), (c1 - c0 + 1), coords\n\n\ndef _factors(n: int) -> list[tuple[int, int]]:\n    out = []\n    for w in range(1, n + 1):\n        if n % w == 0:\n            h = n // w\n            out.append((h, w))\n    return out\n\n\ndef _build_requirements(\n    H: int,\n    W: int,\n    comps_by_color: dict[int, list[list[tuple[int, int]]]],\n) -> np.ndarray:\n    \"\"\"\n    Build per-cell required color constraints (req[r,c] == -1 means unconstrained).\n\n    Heuristics supported by training examples:\n      - If there is a color with exactly 4 singleton components, those are the four corners.\n      - If there are full horizontal bars of length W-2 in the input, use them as the top/bottom edges\n        between the corners (ordered by their vertical position in the input).\n      - If there is a color with exactly two full vertical line components (width=1) in the input,\n        place them on the left/right edges centered vertically.\n    \"\"\"\n    req = np.full((H, W), -1, dtype=int)\n\n    # 4 singleton components -> corners\n    corner_colors = [\n        col\n        for col, comps in comps_by_color.items()\n        if len(comps) == 4 and all(len(p) == 1 for p in comps)\n    ]\n    assert len(corner_colors) <= 1, \"corner singleton color must be unique when present\"\n    corner_color = corner_colors[0] if corner_colors else None\n    if corner_color is not None:\n        req[0, 0] = corner_color\n        req[0, W - 1] = corner_color\n        req[H - 1, 0] = corner_color\n        req[H - 1, W - 1] = corner_color\n\n    # Horizontal bar(s) of length W-2 (filled, height 1)\n    bar_colors: list[tuple[int, int]] = []  # (min_input_row, color)\n    if W >= 3 and corner_color is not None:\n        for col, comps in comps_by_color.items():\n            for pts in comps:\n                r0, c0, r1, c1 = bbox_coords(pts)\n                hh, ww = r1 - r0 + 1, c1 - c0 + 1\n                if hh == 1 and ww == (W - 2) and len(pts) == ww:\n                    bar_colors.append((r0, col))\n                    break\n        if bar_colors:\n            assert len(bar_colors) <= 2, \"horizontal edge bar colors must be top/bottom only\"\n            bar_colors.sort()\n            top_col = bar_colors[0][1]\n            bot_col = bar_colors[-1][1]\n            req[0, 1 : W - 1] = top_col\n            req[H - 1, 1 : W - 1] = bot_col\n\n    # Two full vertical line components -> left/right edges, centered vertically\n    vertical_line_candidates = []\n    for col, comps in comps_by_color.items():\n        if len(comps) != 2:\n            continue\n        sigs = [_piece_sig(pts) for pts in comps]\n        (h0, w0, coords0), (h1, w1, coords1) = sigs[0], sigs[1]\n        if w0 == 1 and w1 == 1 and h0 == h1 and coords0 == coords1 and h0 > 1:\n            vertical_line_candidates.append((col, h0))\n    assert len(vertical_line_candidates) <= 1, \"paired vertical edge-line color must be unique when present\"\n    if vertical_line_candidates:\n        col, L = vertical_line_candidates[0]\n        top = (H - L) // 2\n        assert 0 <= top and top + L <= H, \"paired vertical edge lines must fit in the output height\"\n        req[top : top + L, 0] = col\n        req[top : top + L, W - 1] = col\n\n    return req\n\n\ndef _assemble(\n    types: list[dict],\n    H: int,\n    W: int,\n    req: np.ndarray,\n    disallow_touch: set[int] | None = None,\n) -> np.ndarray:\n    board = np.full((H, W), -1, dtype=int)\n    counts = [int(t[\"cnt\"]) for t in types]\n\n    def mirror_ok(r: int, c: int, col: int) -> bool:\n        mc = W - 1 - c\n        v = board[r, mc]\n        return (v == -1) or (v == col)\n\n    def can_place(ti: int, r0: int, c0: int) -> bool:\n        t = types[ti]\n        col = int(t[\"col\"])\n        is_singleton = len(t[\"coords\"]) == 1\n        for dr, dc in t[\"coords\"]:\n            r, c = r0 + dr, c0 + dc\n            if board[r, c] != -1:\n                return False\n            if req[r, c] != -1 and int(req[r, c]) != col:\n                return False\n            if not mirror_ok(r, c, col):\n                return False\n            if is_singleton and not (r == 0 or r == H - 1 or c == 0 or c == W - 1):\n                return False\n            if disallow_touch and col in disallow_touch:\n                for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):\n                    if 0 <= rr < H and 0 <= cc < W and board[rr, cc] == col:\n                        return False\n        return True\n\n    def place(ti: int, r0: int, c0: int) -> list[tuple[int, int]]:\n        t = types[ti]\n        col = int(t[\"col\"])\n        changed = []\n        for dr, dc in t[\"coords\"]:\n            r, c = r0 + dr, c0 + dc\n            board[r, c] = col\n            changed.append((r, c))\n        return changed\n\n    def unplace(changed: list[tuple[int, int]]) -> None:\n        for r, c in changed:\n            board[r, c] = -1\n\n    def placements_for(ti: int) -> list[tuple[int, int]]:\n        t = types[ti]\n        return [(r0, c0)\n                for r0 in range(H - int(t[\"h\"]) + 1)\n                for c0 in range(W - int(t[\"w\"]) + 1)\n                if can_place(ti, r0, c0)]\n\n    # Pure constraint propagation: each step, every type must be forced (1 position)\n    # or batch-forced (positions == cnt). No backtracking. Asserts if stuck.\n    changed = True\n    while changed:\n        changed = False\n        for ti in range(len(types)):\n            if counts[ti] <= 0:\n                continue\n            places = placements_for(ti)\n            assert len(places) > 0, \"assembly dead end: a piece has no valid placement\"\n            if len(places) == 1:\n                counts[ti] -= 1\n                place(ti, places[0][0], places[0][1])\n                changed = True\n            elif len(places) == counts[ti]:\n                for r0, c0 in places:\n                    counts[ti] -= 1\n                    place(ti, r0, c0)\n                changed = True\n    assert all(c == 0 for c in counts), \"assembly not purely propagation-solvable\"\n    assert np.array_equal(board, board[:, ::-1]), \"assembled board must be LR-symmetric\"\n    return board\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble scattered colored fragments into a left-right symmetric rectangle, jigsaw-style.\n\n    Input structure:\n    - bg = most common color; remaining colors form small sprite fragments.\n    - Optional roles: 4 singleton pixels of one color mark corners; horizontal bars mark top/bottom edges; paired vertical lines mark left/right edges.\n\n    Rule:\n    - Collect all non-bg connected components as jigsaw pieces.\n    - Determine output rectangle dimensions from total piece area.\n    - Pack pieces into the rectangle so it is exactly mirror-symmetric (left-right) and same-color pieces never 4-touch.\n\n    Key insight: Left-right symmetry plus the no-same-color-touching constraint make the assembly unique; corner/edge markers anchor it when present.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    # Extract pieces (connected components per color)\n    comps_by_color: dict[int, list[list[tuple[int, int]]]] = {}\n    pieces = []\n    color_piece_count: dict[int, int] = {}\n\n    for col in sorted(set(map(int, np.unique(g)))):\n        if col == bg:\n            continue\n        comps = components_mask(g == col, connectivity=4)\n        comps_by_color[col] = comps\n        color_piece_count[col] = len(comps)\n        for pts in comps:\n            _, _, coords = _piece_sig(pts)\n            pieces.append((col, coords))\n\n    # Group identical pieces into types\n    from collections import Counter\n\n    ctr = Counter(pieces)\n    types = []\n    for (col, coords), cnt in sorted(ctr.items(), key=lambda kv: (-len(kv[0][1]), kv[0][0], kv[0][1])):\n        arr = np.array(coords, dtype=int)\n        h = int(arr[:, 0].max() + 1)\n        w = int(arr[:, 1].max() + 1)\n        types.append({\"col\": int(col), \"coords\": coords, \"h\": h, \"w\": w, \"cnt\": int(cnt)})\n\n    total_area = sum(int(t[\"cnt\"]) * len(t[\"coords\"]) for t in types)\n    assert total_area > 0, \"total_area must be positive: grid must contain non-background pieces\"\n\n    # Disallow 4-neigh touching between different pieces of same color (preserve component counts)\n    # Eval inputs use the unique closest-to-square portrait factor pair as the output shape.\n    dims = [(h, w) for (h, w) in _factors(total_area) if h >= w]\n    assert dims, \"at least one portrait factor pair must exist for the total piece area\"\n    best_gap = min(abs(h - w) for h, w in dims)\n    best_dims = [(h, w) for h, w in dims if abs(h - w) == best_gap]\n    assert len(best_dims) == 1, \"closest-to-square portrait output shape must be unique\"\n    H, W = best_dims[0]\n\n    # Frame constraint: under 8-connectivity, 1-2 pieces must exist whose union bbox\n    # equals the output rectangle (H x W). Their relative positions are fixed in output.\n    comps8_all = []\n    for col in sorted(set(map(int, np.unique(g))) - {bg}):\n        for pts in components_mask(g == col, connectivity=8):\n            comps8_all.append((int(col), pts))\n    def _is_lr_symmetric(parts, h, w):\n        \"\"\"Check if the union of frame parts forms an LR-symmetric bitmap.\"\"\"\n        all_pts = np.concatenate([p for _, p in parts])\n        r0, c0 = int(all_pts[:, 0].min()), int(all_pts[:, 1].min())\n        bmp = np.zeros((h, w), dtype=bool)\n        for _, pts in parts:\n            for r, c in pts:\n                bmp[int(r) - r0, int(c) - c0] = True\n        return np.array_equal(bmp, bmp[:, ::-1])\n\n    frame_parts: list[tuple[int, np.ndarray]] = []\n    for i, (c1, p1) in enumerate(comps8_all):\n        r0, c0, r1, c1b = bbox_coords(p1)\n        if r1 - r0 + 1 == H and c1b - c0 + 1 == W:\n            if _is_lr_symmetric([(c1, p1)], H, W):\n                frame_parts = [(c1, p1)]\n                break\n        for j in range(i + 1, len(comps8_all)):\n            c2, p2 = comps8_all[j]\n            union = np.concatenate([p1, p2])\n            ur0, uc0, ur1, uc1 = bbox_coords(union)\n            if ur1 - ur0 + 1 == H and uc1 - uc0 + 1 == W:\n                if _is_lr_symmetric([(c1, p1), (c2, p2)], H, W):\n                    frame_parts = [(c1, p1), (c2, p2)]\n                    break\n        if frame_parts:\n            break\n    assert frame_parts, \"input must contain 1-2 LR-symmetric pieces (8-conn) whose union bbox equals output dims\"\n","exit_code":0,"status":"completed"}}
