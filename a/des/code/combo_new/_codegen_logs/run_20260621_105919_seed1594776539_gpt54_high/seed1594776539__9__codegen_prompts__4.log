{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/6165ea8f.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords, colors_present, find_components, get_bg, paste, random_free_location\nimport random\n\n\ndef _tight_mask(mask: np.ndarray) -> np.ndarray:\n    coords = np.argwhere(mask)\n    assert coords.size, \"expected a nonempty mask\"\n    r0, c0, r1, c1 = bbox_coords(coords)\n    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)\n\n\ndef _mask_key(mask: np.ndarray) -> tuple[str, ...]:\n    return tuple(\"\".join(\"1\" if cell else \"0\" for cell in row) for row in mask)\n\n\ndef _shape_signature(mask: np.ndarray) -> tuple[str, ...]:\n    base = _tight_mask(mask)\n    variants = []\n    for k in range(4):\n        rotated = np.rot90(base, k)\n        variants.append(_mask_key(_tight_mask(rotated)))\n        variants.append(_mask_key(_tight_mask(np.fliplr(rotated))))\n    return min(variants)\n\n\ndef _legend_order(g: np.ndarray, bg: int) -> list[int]:\n    labels: list[tuple[int, int]] = []\n    W = g.shape[1]\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, min_area=1):\n        if int(comp[\"area\"]) != 1:\n            continue\n        r, c = map(int, comp[\"coords\"][0])\n        if c == W - 1:\n            labels.append((r, int(comp[\"color\"])))\n\n    labels.sort()\n    assert labels, \"expected a right-edge color legend\"\n    assert [r for r, _color in labels] == list(range(len(labels))), \"legend must start at the top edge\"\n\n    order = [color for _r, color in labels]\n    assert len(order) == len(set(order)), \"legend colors must be unique\"\n    assert set(order) == set(colors_present(g, exclude={bg})), \"legend must list every foreground color\"\n    return order\n\n\ndef _main_object_mask(g: np.ndarray, bg: int, color: int) -> np.ndarray:\n    comps = find_components(\n        g,\n        bg=bg,\n        connectivity=4,\n        monochromatic=True,\n        colors=[color],\n        min_area=1,\n    )\n    main = [comp for comp in comps if int(comp[\"area\"]) > 1]\n    label = [\n        comp\n        for comp in comps\n        if int(comp[\"area\"]) == 1 and int(comp[\"coords\"][0][1]) == g.shape[1] - 1\n    ]\n    assert len(main) == 1, \"expected exactly one main object for each legend color\"\n    assert len(label) == 1, \"expected exactly one right-edge singleton label for each legend color\"\n    assert len(comps) == 2, \"each legend color should appear only as one object and one label\"\n\n    r0, c0, r1, c1 = main[0][\"bbox\"]\n    return g[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(color)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Build a color-labeled shape-equivalence table from the objects listed on the right edge.\n\n    Input structure:\n    - The background contains one main 4-connected object for each foreground color.\n    - The rightmost column has one singleton pixel of each foreground color, listed top-to-bottom.\n    - Those singleton pixels define the row and column order of the output table.\n\n    Rule:\n    - Normalize each main object to its tight mask and compare masks up to rotation or reflection.\n    - Draw 2x2 color labels across the top and down the left, separated by one background row/column.\n    - For each off-diagonal table cell, paint a 2x2 red block when the two labeled objects have the same shape under rotation/reflection, otherwise paint a 2x2 grey block.\n    - Leave diagonal cells and all separators as background.\n\n    Key insight:\n    - Object positions and original orientations are distractors; the relation is dihedral shape equivalence, while the right-edge legend fixes the table order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    order = _legend_order(g, bg)\n    signatures = {color: _shape_signature(_main_object_mask(g, bg, color)) for color in order}\n\n    n = len(order)\n    out = np.full((3 * n + 2, 3 * n + 2), int(bg), dtype=int)\n\n    for i, color in enumerate(order):\n        band = 3 + 3 * i\n        out[0:2, band : band + 2] = int(color)\n        out[band : band + 2, 0:2] = int(color)\n\n    for i, row_color in enumerate(order):\n        for j, col_color in enumerate(order):\n            if i == j:\n                continue\n            cell_color = Color.RED if signatures[row_color] == signatures[col_color] else Color.GREY\n            r = 3 + 3 * i\n            c = 3 + 3 * j\n            out[r : r + 2, c : c + 2] = int(cell_color)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and object bounds.\nGEN_OBJECT_COUNT_RANGE, GEN_GRID_ROW_RANGE, GEN_GRID_COL_RANGE = (4, 7), (20, 25), (20, 23)\nGEN_OBJECT_AREA_RANGE, GEN_OBJECT_BBOX_RANGE, GEN_OBJECT_MAX_EXTRA_CELLS = (5, 13), (2, 7), 4\n# Shape-class sampling.\nGEN_CLASS_OPTIONS, GEN_MAX_CLASS_SIZE, GEN_UNIQUE_MASK_RETRIES = (2, 3), 3, 80\nGEN_DIHEDRAL_FLIP_PROB = 0.5\n# Output table layout and colors.\nGEN_OBJECT_COLORS, GEN_TABLE_BLOCK, GEN_TABLE_STEP = [1, 3, 4, 6, 7, 8, 9], 2, 3\nGEN_SAME_SHAPE_COLOR, GEN_DIFFERENT_SHAPE_COLOR = int(Color.RED), int(Color.GREY)\n# Input placement and retry limits.\nGEN_RESERVED_RIGHT_COLS, GEN_ATTEMPTS = 2, 300\nGEN_PLACEMENT_BORDER, GEN_PLACEMENT_PADDING, GEN_PLACEMENT_CONNECTIVITY = 1, 2, 4\nGEN_NEIGHBORS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _gen_tight_mask(mask: np.ndarray) -> np.ndarray:\n    coords = np.argwhere(mask)\n    r0, c0, r1, c1 = bbox_coords(coords)\n    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)\n\n\ndef _gen_mask_key(mask: np.ndarray) -> tuple[str, ...]:\n    return tuple(\"\".join(\"1\" if cell else \"0\" for cell in row) for row in mask)\n\n\ndef _gen_shape_signature(mask: np.ndarray) -> tuple[str, ...]:\n    base = _gen_tight_mask(mask)\n    variants = []\n    for k in range(4):\n        rotated = np.rot90(base, k)\n        variants.append(_gen_mask_key(_gen_tight_mask(rotated)))\n        variants.append(_gen_mask_key(_gen_tight_mask(np.fliplr(rotated))))\n    return min(variants)\n\n\ndef _has_hole(mask: np.ndarray) -> bool:\n    bg = ~mask.astype(bool)\n    if not bool(bg.any()):\n        return False\n\n    H, W = bg.shape\n    seen = np.zeros_like(bg, dtype=bool)\n    stack: list[tuple[int, int]] = []\n    for r in range(H):\n        for c in (0, W - 1):\n            if bg[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                stack.append((r, c))\n    for c in range(W):\n        for r in (0, H - 1):\n            if bg[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                stack.append((r, c))\n\n    while stack:\n        r, c = stack.pop()\n        for dr, dc in GEN_NEIGHBORS_4:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and bg[nr, nc] and not seen[nr, nc]:\n                seen[nr, nc] = True\n                stack.append((nr, nc))\n    return bool((bg & ~seen).any())\n\n\ndef _random_corner_path(h: int, w: int) -> np.ndarray:\n    starts = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]\n    sr, sc = random.choice(starts)\n    er, ec = h - 1 - sr, w - 1 - sc\n    moves = [(1 if er > sr else -1, 0)] * (h - 1)\n    moves += [(0, 1 if ec > sc else -1)] * (w - 1)\n    random.shuffle(moves)\n\n    mask = np.zeros((h, w), dtype=bool)\n    r, c = sr, sc\n    mask[r, c] = True\n    for dr, dc in moves:\n        r += dr\n        c += dc\n        mask[r, c] = True\n    return mask\n\n\ndef _growth_candidates(mask: np.ndarray) -> list[tuple[int, int]]:\n    h, w = mask.shape\n    choices = []\n    for r in range(h):\n        for c in range(w):\n            if mask[r, c]:\n                continue\n            touches = sum(\n                0 <= r + dr < h and 0 <= c + dc < w and mask[r + dr, c + dc]\n                for dr, dc in GEN_NEIGHBORS_4\n            )\n            if touches != 1:\n                continue\n            trial = mask.copy()\n            trial[r, c] = True\n            if not _has_hole(trial):\n                choices.append((r, c))\n    return choices\n\n\ndef _random_mask() -> np.ndarray | None:\n    area = random.randint(*GEN_OBJECT_AREA_RANGE)\n    pairs = [\n        (h, w)\n        for h in range(GEN_OBJECT_BBOX_RANGE[0], GEN_OBJECT_BBOX_RANGE[1] + 1)\n        for w in range(GEN_OBJECT_BBOX_RANGE[0], GEN_OBJECT_BBOX_RANGE[1] + 1)\n        if h + w - 1 <= area <= h * w\n        and area - (h + w - 1) <= GEN_OBJECT_MAX_EXTRA_CELLS\n    ]\n    h, w = random.choice(pairs)\n    mask = _random_corner_path(h, w)\n\n    while int(mask.sum()) < area:\n        choices = _growth_candidates(mask)\n        if not choices:\n            return None\n        r, c = random.choice(choices)\n        mask[r, c] = True\n    return mask\n\n\ndef _class_sizes(n: int) -> list[int]:\n    k = random.choice([k for k in GEN_CLASS_OPTIONS if k <= n <= GEN_MAX_CLASS_SIZE * k])\n    sizes = [1] * k\n    for _ in range(n - k):\n        open_slots = [i for i, size in enumerate(sizes) if size < GEN_MAX_CLASS_SIZE]\n        sizes[random.choice(open_slots)] += 1\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _unique_canonical_masks(class_count: int) -> list[np.ndarray] | None:\n    canonical_masks: list[np.ndarray] = []\n    signatures: set[tuple[str, ...]] = set()\n    for _ in range(class_count):\n        for _ in range(GEN_UNIQUE_MASK_RETRIES):\n            mask = _random_mask()\n            if mask is None:\n                continue\n            sig = _gen_shape_signature(mask)\n            if sig in signatures:\n                continue\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):\n        b = int(b)\n        f = int(f)\n        if b == bg:\n            continue\n        mapping[b] = f\n\n    return mapping, pal_mask\n\n\ndef _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:\n    \"\"\"\n    Find background regions (excluding the palette area) that do NOT touch the grid boundary,\n    and fill each region based on the most common adjacent border color (mapped via palette).\n    \"\"\"\n    h, w = out.shape\n    bg_mask = (out == bg) & (~pal_mask)\n    comps = components_mask(bg_mask, connectivity=4)\n    for pts in comps:\n        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n        if touches_boundary:\n            continue\n\n        adj_counts: dict[int, int] = {}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < h and 0 <= cc < w:\n                    if pal_mask[rr, cc]:\n                        continue\n                    v = int(out[rr, cc])\n                    if v == bg:\n                        continue\n                    adj_counts[v] = adj_counts.get(v, 0) + 1\n        if not adj_counts:\n            continue\n\n        # Prefer an adjacent color that exists in the mapping; pick the most frequent border.\n        border = None\n        best = -1\n        for col, cnt in adj_counts.items():\n","exit_code":0,"status":"completed"}}
