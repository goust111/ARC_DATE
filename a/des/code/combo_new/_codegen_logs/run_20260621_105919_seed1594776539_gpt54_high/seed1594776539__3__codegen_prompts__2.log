{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '282,760p' /home/lixinyu/snap/new/ARC_code/eval/21897d95.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.\n\n    Input structure:\n    - The grid is a mosaic of monochrome regions.\n    - Color 1 forms T-shaped control markers on region boundaries.\n    - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.\n    - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.\n\n    Rule:\n    - For a color-1 T marker, the single stem points at the destination region to repaint.\n    - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.\n    - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.\n    - All marker cells are filled with the final color of the source-side region.\n    - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.\n\n    Key insight:\n    - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = _solve_unrotated(g)\n    l9 = _find_l9_orientation(g)\n    if l9 == 'top_right':\n        return np.rot90(out, 1)\n    if l9 == 'top_left':\n        return np.rot90(out, 3)\n    return out\n\n# --------------- generator (l9rot) ---------------\n\n# ── Tunable constants ──────────────────────────────────────────────────\n# Canvas / region sizing\nGRID_SIZE_MAX = 30                          # max rows or cols\nMIN_REGION_CELLS = 6                        # per-spec minimum\nREGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)\nREGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts\nREGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS\n\n# Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)\nMARKER_MIN = 4\nMARKER_MAX = 8\nNORMAL_MAX = 6\nCOLORED_MAX = 2\n\n# Color pool (all ARC colors except 1, which is reserved for T-marker cells)\nCOLOR_POOL = [c for c in range(10) if c != 1]\n\n# L9 rotation marker\nL9_PROBABILITY = 0.5                        # chance of placing a rotation marker\nL9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation\n    'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],\n    'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],\n}\n\n# Generation retry budget\nSEED_ATTEMPTS = 200                         # tries to place n distinct region seeds\nGEN_RETRIES = 300                           # outer generate_input retry budget\n\n_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n# ── Small geometry helpers ─────────────────────────────────────────────\n\ndef _get_bar(stem):\n    \"\"\"Return the two bar directions perpendicular to *stem*.\"\"\"\n    if stem[0] == 0:\n        return [(-1, 0), (1, 0)]\n    return [(0, -1), (0, 1)]\n\n\ndef _t_cells(center, stem):\n    \"\"\"Return the 4 cells of a T marker: center + stem tip + 2 bar cells.\"\"\"\n    r, c = center\n    bar = _get_bar(stem)\n    return {(r, c), (r + stem[0], c + stem[1]),\n            (r + bar[0][0], c + bar[0][1]), (r + bar[1][0], c + bar[1][1])}\n\n\ndef _t_branch_cells(center, stem):\n    \"\"\"Return the 3 branch cells (stem tip + 2 bar), excluding the center.\"\"\"\n    r, c = center\n    bar = _get_bar(stem)\n    return {(r + stem[0], c + stem[1]),\n            (r + bar[0][0], c + bar[0][1]),\n            (r + bar[1][0], c + bar[1][1])}\n\n\ndef _t_neighborhood(center, stem):\n    \"\"\"Return cells adjacent to any T cell but not part of the T itself.\"\"\"\n    cells = _t_cells(center, stem)\n    neighborhood = set()\n    for r, c in cells:\n        for dr, dc in _DIRS:\n            nb = (r + dr, c + dc)\n            if nb not in cells:\n                neighborhood.add(nb)\n    return neighborhood\n\n\n# ── Region partitioning ────────────────────────────────────────────────\n\ndef _grow_regions(H: int, W: int, n_regions: int) -> np.ndarray | None:\n    \"\"\"Grow n_regions from random seeds via randomized BFS; returns region-id array or None.\"\"\"\n    region = np.full((H, W), -1, dtype=int)\n    seeds = set()\n    for _ in range(SEED_ATTEMPTS):\n        if len(seeds) >= n_regions:\n            break\n        seeds.add((random.randint(1, H - 2), random.randint(1, W - 2)))\n    if len(seeds) < n_regions:\n        return None\n\n    frontier = []\n    for i, (r, c) in enumerate(list(seeds)):\n        region[r, c] = i\n        for dr, dc in _DIRS:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:\n                frontier.append((nr, nc, i))\n    random.shuffle(frontier)\n\n    while frontier:\n        idx = random.randint(0, len(frontier) - 1)\n        r, c, rid = frontier[idx]\n        frontier[idx] = frontier[-1]\n        frontier.pop()\n        if region[r, c] != -1:\n            continue\n        region[r, c] = rid\n        for dr, dc in _DIRS:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:\n                frontier.append((nr, nc, rid))\n\n    # Validate: each region must be 4-connected and have enough cells\n    for rid in range(n_regions):\n        mask = region == rid\n        if mask.sum() < MIN_REGION_CELLS:\n            return None\n        _, n = label_mask(mask, connectivity=4)\n        if n != 1:\n            return None\n    return region\n\n\n# ── Adjacency discovery ───────────────────────────────────────────────\n\ndef _find_adjacent_pairs(region: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Return all directed (src, dst) pairs between adjacent regions.\"\"\"\n    H, W = region.shape\n    # Detect boundaries via horizontal and vertical neighbor differences\n    undirected = set()\n    for r in range(H):\n        for c in range(W):\n            for dr, dc in _DIRS:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < H and 0 <= nc < W:\n                    a, b = int(region[r, c]), int(region[nr, nc])\n                    if a != b:\n                        undirected.add((min(a, b), max(a, b)))\n    directed = []\n    for a, b in undirected:\n        directed.append((a, b))\n        directed.append((b, a))\n    return directed\n\n\n# ── Marker count selection ─────────────────────────────────────────────\n\ndef _choose_marker_counts(n_regions: int) -> tuple[int, int, int] | None:\n    \"\"\"Return (n_markers, n_normal, n_colored) or None if infeasible.\"\"\"\n    max_possible = min(MARKER_MAX, n_regions)\n    if max_possible < MARKER_MIN:\n        return None\n    n_markers = random.randint(MARKER_MIN, max_possible)\n    n_colored = random.randint(0, min(COLORED_MAX, n_markers - 2))\n    n_normal = n_markers - n_colored\n    if n_normal > NORMAL_MAX:\n        n_colored = n_markers - NORMAL_MAX\n        n_normal = NORMAL_MAX\n        if n_colored > COLORED_MAX:\n            n_markers = NORMAL_MAX + COLORED_MAX\n            n_colored = COLORED_MAX\n            n_normal = NORMAL_MAX\n    return n_markers, n_normal, n_colored\n\n\n# ── Marker placement search ───────────────────────────────────────────\n\ndef _find_valid_placements(region, src, dst, occupied_cells, occupied_neighbors, H, W):\n    \"\"\"Find all valid (center, stem) for placing a T marker from src toward dst.\"\"\"\n    candidates = []\n    for r in range(1, H - 1):\n        for c in range(1, W - 1):\n            for stem in _DIRS:\n                bar = _get_bar(stem)\n                cells = _t_cells((r, c), stem)\n                if not all(0 <= cr < H and 0 <= cc < W for cr, cc in cells):\n                    continue\n                if cells & occupied_cells:\n                    continue\n                if _t_neighborhood((r, c), stem) & occupied_cells:\n                    continue\n                if cells & occupied_neighbors:\n                    continue\n                # Diagonal cells (stem + each bar dir) must lie in source region\n                if not all(\n                    0 <= r + stem[0] + bd[0] < H and\n                    0 <= c + stem[1] + bd[1] < W and\n                    region[r + stem[0] + bd[0], c + stem[1] + bd[1]] == src\n                    for bd in bar\n                ):\n                    continue\n                # Walk along stem from step=2 until we hit dst or leave bounds\n                step = 2\n                found = False\n                while True:\n                    nr, nc = r + stem[0] * step, c + stem[1] * step\n                    if not (0 <= nr < H and 0 <= nc < W):\n                        break\n                    if (nr, nc) in occupied_cells or (nr, nc) in cells:\n                        step += 1\n                        continue\n                    found = int(region[nr, nc]) == dst\n                    break\n                if found:\n                    candidates.append(((r, c), stem))\n    return candidates\n\n\ndef _register_marker(kind, center, stem, occupied_cells, occupied_neighbors):\n    \"\"\"Update occupied_cells and occupied_neighbors after placing a marker.\"\"\"\n    cells = _t_cells(center, stem)\n    if kind == 'normal':\n        occupied_cells |= cells\n        occupied_neighbors |= (_t_neighborhood(center, stem) - cells)\n    else:\n        branch = _t_branch_cells(center, stem)\n        occupied_cells |= branch\n        occupied_cells.add(center)\n        # Each branch cell must remain a singleton: buffer all non-marker neighbors\n        for br, bc in branch:\n            for dr, dc in _DIRS:\n                nb = (br + dr, bc + dc)\n                if nb != center and nb not in branch:\n                    occupied_neighbors.add(nb)\n        for dr, dc in _DIRS:\n            nb = (center[0] + dr, center[1] + dc)\n            if nb not in branch:\n                occupied_neighbors.add(nb)\n\n\n# ── Grid construction ─────────────────────────────────────────────────\n\ndef _build_color_map(region: np.ndarray, colors: list[int]) -> np.ndarray:\n    \"\"\"Map region ids to colors via vectorized lookup.\"\"\"\n    lut = np.array(colors, dtype=int)\n    return lut[region]\n\n\ndef _stamp_markers_input(grid, placed_markers):\n    \"\"\"Write T-marker cells onto the input grid.\"\"\"\n    for kind, center, stem, _src, _dst, tc in placed_markers:\n        if kind == 'normal':\n            for cr, cc in _t_cells(center, stem):\n                grid[cr, cc] = 1\n        else:\n            grid[center[0], center[1]] = tc\n            for cr, cc in _t_branch_cells(center, stem):\n                grid[cr, cc] = 1\n\n\ndef _stamp_markers_output(grid, placed_markers, out_colors):\n    \"\"\"Fill marker cells in the output grid with the source region's final color.\"\"\"\n    for kind, center, stem, src, _dst, _tc in placed_markers:\n        color = out_colors[src]\n        for cr, cc in _t_cells(center, stem):\n            grid[cr, cc] = color\n\n\n# ── L9 rotation marker ────────────────────────────────────────────────\n\ndef _try_place_l9(region, placed_markers, occupied_neighbors, input_grid, output_grid, out_colors):\n    \"\"\"Attempt to place a 5-cell L9 marker; return orientation string or None.\"\"\"\n    if random.random() >= L9_PROBABILITY:\n        return None\n    orient = random.choice(list(L9_OFFSETS))\n    offsets = L9_OFFSETS[orient]\n    H, W = region.shape\n\n    all_marker_cells = set()\n    for kind, center, stem, *_ in placed_markers:\n        all_marker_cells |= _t_cells(center, stem)\n\n    candidates = []\n    for r in range(H):\n        for c in range(W):\n            cells = [(r + dr, c + dc) for dr, dc in offsets]\n            if not all(0 <= cr < H and 0 <= cc < W for cr, cc in cells):\n                continue\n            rid = int(region[r, c])\n            if not all(int(region[cr, cc]) == rid for cr, cc in cells):\n                continue\n            if any((cr, cc) in all_marker_cells for cr, cc in cells):\n                continue\n            if any((cr, cc) in occupied_neighbors for cr, cc in cells):\n                continue\n            candidates.append((r, c, rid))\n\n    if not candidates:\n        return None\n    lr, lc, rid = random.choice(candidates)\n    for dr, dc in offsets:\n        input_grid[lr + dr, lc + dc] = 9\n        output_grid[lr + dr, lc + dc] = out_colors[rid]\n    return orient\n\n\n# ── Main generation attempt ───────────────────────────────────────────\n\ndef _gen_attempt() -> np.ndarray | None:\n    n_regions = random.choices(REGION_COUNTS, weights=REGION_WEIGHTS)[0]\n    min_size = max(9, int(n_regions * REGION_SIZE_FACTOR))\n    H = random.randint(min_size, GRID_SIZE_MAX)\n    W = random.randint(min_size, GRID_SIZE_MAX)\n\n    region = _grow_regions(H, W, n_regions)\n    if region is None:\n        return None\n\n    directed_pairs = _find_adjacent_pairs(region)\n\n    counts = _choose_marker_counts(n_regions)\n    if counts is None:\n        return None\n    n_markers, n_normal, n_colored = counts\n\n    # Select src->dst pairs with unique destinations\n    random.shuffle(directed_pairs)\n    dest_used = set()\n    marker_pairs = []\n    for src, dst in directed_pairs:\n        if dst not in dest_used:\n            marker_pairs.append((src, dst))\n            dest_used.add(dst)\n            if len(marker_pairs) >= n_markers:\n                break\n    if len(marker_pairs) < n_markers:\n        n_markers = len(marker_pairs)\n        if n_markers < MARKER_MIN:\n            return None\n        n_colored = min(n_colored, n_markers - 1)\n        n_normal = n_markers - n_colored\n    random.shuffle(marker_pairs)\n\n    # Assign input colors\n    pool = list(COLOR_POOL)\n    random.shuffle(pool)\n    if n_regions > len(pool):\n        return None\n    input_colors = pool[:n_regions]\n\n    # Compute output colors from recoloring rules\n    out_colors = list(input_colors)\n    normal_pairs = marker_pairs[:n_normal]\n    colored_pairs = marker_pairs[n_normal:]\n\n    colored_targets = []\n    for _src, dst in colored_pairs:\n        cands = [c for c in pool if c != input_colors[dst]]\n        if not cands:\n            return None\n        colored_targets.append(random.choice(cands))\n\n    for src, dst in normal_pairs:\n        out_colors[dst] = input_colors[src]\n    for (src, dst), tc in zip(colored_pairs, colored_targets):\n        out_colors[dst] = tc\n\n    # Build marker definitions and place them\n    all_defs = [('normal', s, d, None) for s, d in normal_pairs] + \\\n               [('colored', s, d, tc) for (s, d), tc in zip(colored_pairs, colored_targets)]\n    random.shuffle(all_defs)\n\n    occupied_cells: set[tuple[int, int]] = set()\n    occupied_neighbors: set[tuple[int, int]] = set()\n    placed_markers = []\n    for kind, src, dst, tc in all_defs:\n        cands = _find_valid_placements(region, src, dst, occupied_cells, occupied_neighbors, H, W)\n        if not cands:\n            return None\n        center, stem = random.choice(cands)\n        _register_marker(kind, center, stem, occupied_cells, occupied_neighbors)\n        placed_markers.append((kind, center, stem, src, dst, tc))\n\n    # Build grids via vectorized lookup\n    input_grid = _build_color_map(region, input_colors)\n    output_grid = _build_color_map(region, out_colors)\n\n    _stamp_markers_input(input_grid, placed_markers)\n    _stamp_markers_output(output_grid, placed_markers, out_colors)\n\n    # Optional L9 rotation marker\n    l9_orient = _try_place_l9(region, placed_markers, occupied_neighbors,\n                              input_grid, output_grid, out_colors)\n    if l9_orient == 'top_right':\n        output_grid = np.rot90(output_grid, 1)\n    elif l9_orient == 'top_left':\n        output_grid = np.rot90(output_grid, 3)\n\n    try:\n        result = main(input_grid)\n    except Exception:\n        return None\n    return input_grid if np.array_equal(result, output_grid) else None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,560p' /home/lixinyu/snap/new/ARC_code/eval/898e7135.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import bbox, bbox_coords, components_mask, crop_bbox, find_components, get_bg, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Inflate a frame's hole-layout and fill each hole with its matching piece.\n\n    Input structure:\n    - bg = most common color. Largest component is a monochrome frame enclosing bg holes.\n    - Outside pieces composed of k×k blocks; k = side of smallest solid square piece.\n\n    Rule:\n    - Extract connected hole regions inside the frame as slots.\n    - Match each piece to a slot by comparing block-level shapes under rotation/flip.\n    - Output the layout scaled by k, with pieces placed in slots; frame color as background.\n\n    Key insight: Pieces are k×k-block-scaled versions of holes; downsampling reveals shape matches under all 8 orientations.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    # --- find the largest connected component of foreground (multicolor) ---\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n    frame_comp = max(comps, key=lambda d: int(d[\"area\"]))\n    fr0, fc0, fr1, fc1 = map(int, frame_comp[\"bbox\"])\n\n    # The frame is monochrome; use its dominant color as output background.\n    frame_cols = [int(g[int(r), int(c)]) for r, c in frame_comp[\"coords\"]]\n    bgc = int(Counter(frame_cols).most_common(1)[0][0])\n\n    # --- layout = bg holes inside the frame bbox, tight-cropped ---\n    sub = crop_bbox(g, (fr0, fc0, fr1, fc1))\n    hole = sub == int(bg)\n    hole_box = bbox(hole)\n    assert hole_box is not None, \"frame must enclose at least one bg hole\"\n    lr0, lc0, lr1, lc1 = map(int, hole_box)\n    layout = hole[lr0 : lr1 + 1, lc0 : lc1 + 1]\n\n    # --- slot components in the layout ---\n    slots = []\n    for coords in components_mask(layout, connectivity=4):\n        rr0, cc0, rr1, cc1 = bbox_coords(coords)\n        rr0, cc0, rr1, cc1 = map(int, (rr0, cc0, rr1, cc1))\n        h = int(rr1 - rr0 + 1)\n        w = int(cc1 - cc0 + 1)\n        sm = np.zeros((h, w), dtype=bool)\n        sm[coords[:, 0] - rr0, coords[:, 1] - cc0] = True\n        slots.append({\"area\": int(sm.sum()), \"r0\": int(rr0), \"c0\": int(cc0), \"mask\": sm})\n    slots.sort(key=lambda s: (-int(s[\"area\"]), int(s[\"r0\"]), int(s[\"c0\"])))\n\n    assert slots, \"frame must contain at least one slot\"\n\n    # --- pieces = non-singleton foreground components excluding the frame component ---\n    pieces = []\n    for comp in comps:\n        if comp is frame_comp:\n            continue\n        coords = comp[\"coords\"]\n        if coords.size == 0 or int(coords.shape[0]) <= 1:\n            continue\n        pr0, pc0, pr1, pc1 = map(int, comp[\"bbox\"])\n        patch = crop_bbox(g, (pr0, pc0, pr1, pc1))\n        ph, pw = map(int, patch.shape)\n        pm = np.zeros((ph, pw), dtype=bool)\n        pm[coords[:, 0] - pr0, coords[:, 1] - pc0] = True\n        pieces.append({\"area\": int(pm.sum()), \"mask\": pm, \"patch\": patch})\n\n    assert pieces, \"at least one non-frame piece must exist\"\n\n    # --- infer k from the smallest solid square piece ---\n    k = None\n    for p in pieces:\n        h, w = map(int, p[\"mask\"].shape)\n        if h == w and int(p[\"mask\"].sum()) == int(h * w):\n            k = int(h) if k is None else min(int(k), int(h))\n    k = int(k or 1)\n\n    def downsample_blocks(mask: np.ndarray) -> np.ndarray | None:\n        hh, ww = mask.shape\n        if hh % k != 0 or ww % k != 0:\n            return None\n        out_h, out_w = int(hh // k), int(ww // k)\n        out = np.zeros((out_h, out_w), dtype=bool)\n        for r in range(out_h):\n            for c in range(out_w):\n                block = mask[int(r * k) : int((r + 1) * k), int(c * k) : int((c + 1) * k)]\n                if bool(block.all()):\n                    out[r, c] = True\n                elif bool(block.any()):\n                    return None\n        return out\n\n    def dihedral_variants(\n        patch: np.ndarray, mask: np.ndarray\n    ) -> list[tuple[np.ndarray, np.ndarray]]:\n        base = []\n        for kk in range(4):\n            p = np.rot90(patch, int(kk))\n            m = np.rot90(mask, int(kk))\n            base.append((p, m))\n            base.append((np.fliplr(p), np.fliplr(m)))\n        uniq = []\n        seen = set()\n        for p, m in base:\n            key = m.tobytes()\n            if key in seen:\n                continue\n            seen.add(key)\n            uniq.append((p, m))\n        return uniq\n\n    # Precompute all usable (piece,variant) candidates with their block masks.\n    candidates = []\n    for pi, p in enumerate(pieces):\n        for vp, vm in dihedral_variants(p[\"patch\"], p[\"mask\"]):\n            um = downsample_blocks(vm)\n            if um is None:\n                continue\n            candidates.append({\"pi\": int(pi), \"area\": int(p[\"area\"]), \"um\": um, \"vp\": vp, \"vm\": vm})\n\n    used_piece: set[int] = set()\n    placements: list[tuple[dict, dict]] = []\n    for s in slots:\n        need_area = int(s[\"area\"]) * int(k) * int(k)\n        found = None\n        for cand in candidates:\n            if int(cand[\"pi\"]) in used_piece:\n                continue\n            if int(cand[\"area\"]) != int(need_area):\n                continue\n            if cand[\"um\"].shape != s[\"mask\"].shape:\n                continue\n            if np.array_equal(cand[\"um\"], s[\"mask\"]):\n                found = cand\n                break\n        assert found is not None, \"every slot must match a piece\"\n        used_piece.add(int(found[\"pi\"]))\n        placements.append((s, found))\n\n    outH = (int(layout.shape[0]) + 2) * int(k)\n    outW = (int(layout.shape[1]) + 2) * int(k)\n    out = np.full((outH, outW), int(bgc), dtype=int)\n\n    for s, cand in placements:\n        top = (int(s[\"r0\"]) + 1) * int(k)\n        left = (int(s[\"c0\"]) + 1) * int(k)\n        paste(out, cand[\"vp\"], int(top), int(left), mask=cand[\"vm\"], overwrite=True)\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for ARC-AGI-2 task 898e7135.\n\nOutput-first strategy:\n  1. Build a hole/wall layout of 4-conn slots (8-separated, includes unit slots).\n  2. For each slot, pick a distinct color + dihedral transform; upscale slot mask\n     by k to get the piece sprite (solid k*k blocks).\n  3. Assemble the frame (layout + 1-cell border of frame_color).\n  4. Scatter pieces outside the frame on a bg=0 canvas, plus single-pixel\n     distractor noise in a fresh color.\n\nThe generator validates main(input) == expected_output before returning.\n\"\"\"\n\nimport random\nimport numpy as np\n\nfrom arc_utils import paste, random_free_location\n\n# --- tunables ----------------------------------------------------------------\n\nK_CHOICES = [2, 3]                  # block scale factor\nLAYOUT_H_RANGE = (4, 12)           # inner layout rows\nLAYOUT_W_RANGE = (4, 8)            # inner layout cols\nN_SLOTS_RANGE = (3, 6)             # total slot count (incl. unit)\nN_UNITS_MAX = 2                    # max unit-slot count per example\nNON_UNIT_SIZE_CHOICES = [2, 3, 4, 5, 6, 7]  # area of non-unit slots\n\nHOLE_DENSITY_RANGE = (0.20, 0.50)  # valid hole fraction of layout area\nUNIT_SLOT_RETRIES = 20             # attempts per unit slot placement\nNON_UNIT_SLOT_RETRIES = 30         # attempts per non-unit slot placement\nGROW_SEED_TRIES = 8                # random seed cells tried per _grow_slot call\n\nCANVAS_DIM_RANGE = (15, 30)        # min/max for canvas height and width\nAREA_BUFFER_MULT = 4               # multiplier on piece area for canvas sizing\nAREA_BUFFER_CONST = 50             # additive constant for canvas area budget\n\nDISTRACTOR_RANGE = (8, 13)         # singleton distractor pixel count\nDISTRACTOR_RETRY_MULT = 10         # retry multiplier for distractor placement\nMIN_DISTRACTORS = 8                # minimum placed distractors to accept\n\nGENERATE_MAX_RETRIES = 300         # outer retry limit in generate_input\n\n\n# --- layout generation -------------------------------------------------------\n\ndef _canonical_shape_key(mask: np.ndarray) -> bytes:\n    \"\"\"Canonical bytes representation under D4 for a bool mask (tight-cropped).\"\"\"\n    variants = []\n    for kk in range(4):\n        r = np.rot90(mask, kk)\n        variants.append(r.tobytes() + bytes([r.shape[0], r.shape[1]]))\n        fr = np.fliplr(r)\n        variants.append(fr.tobytes() + bytes([fr.shape[0], fr.shape[1]]))\n    return min(variants)\n\n\ndef _grow_slot(forbidden: np.ndarray, target_size: int) -> np.ndarray | None:\n    \"\"\"Grow a 4-conn slot of given size starting from a random free cell.\n    `forbidden` marks cells that must not be used. Returns coords array or None.\n    \"\"\"\n    H, W = forbidden.shape\n    free_cells = np.argwhere(~forbidden)\n    if free_cells.size == 0:\n        return None\n    random.shuffle(free_cells)\n    for start in free_cells[:GROW_SEED_TRIES]:\n        r0, c0 = int(start[0]), int(start[1])\n        chosen = {(r0, c0)}\n        frontier = {(r0 - 1, c0), (r0 + 1, c0), (r0, c0 - 1), (r0, c0 + 1)}\n        while len(chosen) < target_size and frontier:\n            cands = [p for p in frontier if 0 <= p[0] < H and 0 <= p[1] < W\n                     and not forbidden[p[0], p[1]] and p not in chosen]\n            if not cands:\n                break\n            nr, nc = random.choice(cands)\n            chosen.add((nr, nc))\n            frontier.discard((nr, nc))\n            frontier.update({(nr - 1, nc), (nr + 1, nc), (nr, nc - 1), (nr, nc + 1)})\n        if len(chosen) == target_size:\n            return np.array(sorted(chosen))\n    return None\n\n\ndef _dilate8(mask: np.ndarray) -> np.ndarray:\n    \"\"\"Dilate a bool mask by 1 cell (8-connectivity).\"\"\"\n    out = mask.copy()\n    out[:-1, :] |= mask[1:, :]\n    out[1:, :] |= mask[:-1, :]\n    out[:, :-1] |= mask[:, 1:]\n    out[:, 1:] |= mask[:, :-1]\n    out[:-1, :-1] |= mask[1:, 1:]\n    out[1:, 1:] |= mask[:-1, :-1]\n    out[:-1, 1:] |= mask[1:, :-1]\n    out[1:, :-1] |= mask[:-1, 1:]\n    return out\n\n\ndef _forbid_coords(forbidden: np.ndarray, coords: np.ndarray) -> None:\n    \"\"\"Mark coords and their 8-neighbors as forbidden (in-place).\"\"\"\n    cell_mask = np.zeros_like(forbidden)\n    cell_mask[coords[:, 0], coords[:, 1]] = True\n    forbidden |= _dilate8(cell_mask)\n\n\ndef _gen_layout(h: int, w: int, n_slots: int, n_units: int) -> list[dict] | None:\n    \"\"\"Generate a layout grid with n_slots 4-connected slots (including n_units unit slots).\n    Returns list of {coords, area, mask, shape_key} or None on failure.\n    Unit slots appear first in the returned list.\n    \"\"\"\n    forbidden = np.zeros((h, w), dtype=bool)\n    slots: list[dict] = []\n    used_shape_keys: set[bytes] = set()\n\n    # Place unit slots first (trivially small, easy to fit)\n    for _ in range(n_units):\n        for _ in range(UNIT_SLOT_RETRIES):\n            coords = _grow_slot(forbidden, 1)\n            if coords is not None:\n                slots.append({\"coords\": coords, \"area\": 1})\n                _forbid_coords(forbidden, coords)\n                break\n        else:\n            return None\n\n    # Place non-unit slots with distinct D4 shapes\n    for _ in range(n_slots - n_units):\n        size = random.choice(NON_UNIT_SIZE_CHOICES)\n        for _ in range(NON_UNIT_SLOT_RETRIES):\n            coords = _grow_slot(forbidden, size)\n            if coords is None:\n                continue\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            sm = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)\n            sm[coords[:, 0] - r0, coords[:, 1] - c0] = True\n            key = _canonical_shape_key(sm)\n            if key in used_shape_keys:\n                continue\n            used_shape_keys.add(key)\n            slots.append({\"coords\": coords, \"area\": size, \"mask\": sm, \"shape_key\": key})\n            _forbid_coords(forbidden, coords)\n            break\n        else:\n            return None\n\n    # Validate hole density\n    density = sum(s[\"area\"] for s in slots) / (h * w)\n    lo, hi = HOLE_DENSITY_RANGE\n    if not (lo <= density <= hi):\n        return None\n\n    return slots\n\n\n# --- piece construction ------------------------------------------------------\n\ndef _make_piece(slot: dict, color: int, k: int, apply_dihedral: bool) -> dict:\n    \"\"\"Build output and input patches for one slot.\n    For unit slots (area=1), the piece is a solid k*k square with no dihedral\n    transform needed. For non-unit slots, a random dihedral is applied to the\n    input-side patch.\n    \"\"\"\n    if slot[\"area\"] == 1:\n        patch = np.full((k, k), color, dtype=int)\n        mask = np.ones((k, k), dtype=bool)\n        return {\"color\": color, \"slot\": slot,\n                \"out_patch\": patch, \"out_mask\": mask,\n                \"in_patch\": patch, \"in_mask\": mask}\n\n    out_mask = np.kron(slot[\"mask\"], np.ones((k, k), dtype=bool))\n    out_patch = np.where(out_mask, color, 0).astype(int)\n\n    if apply_dihedral:\n        rot = random.randint(0, 3)\n        in_mask = np.rot90(out_mask, rot)\n        in_patch = np.rot90(out_patch, rot)\n        if random.random() < 0.5:\n            in_mask = np.fliplr(in_mask)\n            in_patch = np.fliplr(in_patch)\n    else:\n        in_mask, in_patch = out_mask, out_patch\n\n    return {\"color\": color, \"slot\": slot,\n            \"out_patch\": out_patch, \"out_mask\": out_mask,\n            \"in_patch\": in_patch, \"in_mask\": in_mask}\n\n\n# --- output assembly ---------------------------------------------------------\n\ndef _build_expected_output(pieces: list[dict], layout_h: int, layout_w: int,\n                           k: int, frame_color: int) -> np.ndarray:\n    \"\"\"Assemble the expected output grid: frame_color background with pieces placed.\"\"\"\n    out = np.full(((layout_h + 2) * k, (layout_w + 2) * k), frame_color, dtype=int)\n    for p in pieces:\n        coords = p[\"slot\"][\"coords\"]\n        top = (int(coords[:, 0].min()) + 1) * k\n        left = (int(coords[:, 1].min()) + 1) * k\n        paste(out, p[\"out_patch\"], top, left, mask=p[\"out_mask\"], overwrite=True)\n    return out\n\n\n# --- input canvas assembly ---------------------------------------------------\n\ndef _build_input_canvas(pieces: list[dict], layout_mask: np.ndarray,\n                        layout_h: int, layout_w: int, k: int,\n                        frame_color: int, distractor_color: int) -> np.ndarray | None:\n    \"\"\"Build the input grid: frame + scattered pieces + distractor noise.\n    Returns canvas or None if placement fails.\n    \"\"\"\n    frame_h, frame_w = layout_h + 2, layout_w + 2\n    total_piece_area = sum(int(p[\"in_mask\"].sum()) for p in pieces)\n    needed_cells = frame_h * frame_w + AREA_BUFFER_MULT * total_piece_area + AREA_BUFFER_CONST\n\n    # Canvas dimensions: start random within spec range, grow if area insufficient\n    min_h = max(CANVAS_DIM_RANGE[0], frame_h + 2)\n    min_w = max(CANVAS_DIM_RANGE[0], frame_w + 2)\n    canvas_h = random.randint(min_h, CANVAS_DIM_RANGE[1])\n    canvas_w = random.randint(min_w, CANVAS_DIM_RANGE[1])\n    while canvas_h * canvas_w < needed_cells and (canvas_h < CANVAS_DIM_RANGE[1] or canvas_w < CANVAS_DIM_RANGE[1]):\n        if canvas_h <= canvas_w and canvas_h < CANVAS_DIM_RANGE[1]:\n            canvas_h += 1\n        elif canvas_w < CANVAS_DIM_RANGE[1]:\n            canvas_w += 1\n        else:\n            break\n    if canvas_h * canvas_w < needed_cells:\n        return None\n\n    canvas = np.zeros((canvas_h, canvas_w), dtype=int)\n\n    # Build and place the frame (1-cell border of frame_color around the layout)\n    frame_img = np.full((frame_h, frame_w), frame_color, dtype=int)\n    frame_img[1:-1, 1:-1] = np.where(layout_mask, 0, frame_color)\n    fr_max, fc_max = canvas_h - frame_h - 1, canvas_w - frame_w - 1\n    if fr_max < 1 or fc_max < 1:\n        return None\n    paste(canvas, frame_img, random.randint(1, fr_max), random.randint(1, fc_max))\n\n    # Place pieces outside the frame, largest-first for better packing\n    for p in sorted(pieces, key=lambda p: -int(p[\"in_mask\"].sum())):\n        try:\n            pr, pc = random_free_location(\n                canvas, p[\"in_patch\"],\n                transparent=0, border=0, padding=1, padding_connectivity=8,\n            )\n        except ValueError:\n            return None\n        paste(canvas, p[\"in_patch\"], pr, pc, mask=p[\"in_mask\"], overwrite=True)\n\n    # Scatter distractor singletons (isolated single pixels in a dedicated color)\n    n_distractors = random.randint(*DISTRACTOR_RANGE)\n    placed = 0\n    for _ in range(n_distractors * DISTRACTOR_RETRY_MULT):\n        if placed >= n_distractors:\n            break\n        rr, cc = random.randint(0, canvas_h - 1), random.randint(0, canvas_w - 1)\n        if canvas[rr, cc] != 0:\n            continue\n        r_lo, r_hi = max(0, rr - 1), min(canvas_h, rr + 2)\n        c_lo, c_hi = max(0, cc - 1), min(canvas_w, cc + 2)\n        if np.any(canvas[r_lo:r_hi, c_lo:c_hi] != 0):\n            continue\n        canvas[rr, cc] = distractor_color\n        placed += 1\n    if placed < MIN_DISTRACTORS:\n        return None\n\n    # bg=0 must remain the most common color for solver's get_bg\n    vals, counts = np.unique(canvas, return_counts=True)\n    if int(vals[np.argmax(counts)]) != 0:\n        return None\n\n    return canvas\n\n\n# --- main generator attempt --------------------------------------------------\n\ndef _gen_attempt() -> np.ndarray | None:\n    k = random.choice(K_CHOICES)\n    layout_h = random.randint(*LAYOUT_H_RANGE)\n    layout_w = random.randint(*LAYOUT_W_RANGE)\n    n_slots = random.randint(*N_SLOTS_RANGE)\n    n_units = random.randint(1, min(N_UNITS_MAX, n_slots - 1))\n\n    # Allocate colors: frame, distractor, then per-piece\n    palette = list(range(1, 10))\n    random.shuffle(palette)\n    frame_color = palette.pop()\n    distractor_color = palette.pop()\n    needed_piece_colors = (n_slots - n_units) + 1  # +1 shared unit color\n    if len(palette) < needed_piece_colors:\n        return None\n    non_unit_colors = palette[:n_slots - n_units]\n    unit_color = palette[n_slots - n_units]\n\n    # Build layout\n    slots = _gen_layout(layout_h, layout_w, n_slots, n_units)\n    if slots is None:\n        return None\n    unit_slots = slots[:n_units]\n    non_unit_slots = slots[n_units:]\n\n    # Validate that holes touch all 4 borders (so solver's tight-crop matches our layout)\n    layout_mask = np.zeros((layout_h, layout_w), dtype=bool)\n    for s in slots:\n        layout_mask[s[\"coords\"][:, 0], s[\"coords\"][:, 1]] = True\n    if not (layout_mask[0].any() and layout_mask[-1].any()\n            and layout_mask[:, 0].any() and layout_mask[:, -1].any()):\n        return None\n\n    # Build pieces\n    pieces = [_make_piece(s, non_unit_colors[i], k, apply_dihedral=True)\n              for i, s in enumerate(non_unit_slots)]\n    pieces += [_make_piece(s, unit_color, k, apply_dihedral=False)\n               for s in unit_slots]\n\n    # Build expected output\n    expected_out = _build_expected_output(pieces, layout_h, layout_w, k, frame_color)\n\n    # Build input canvas\n    canvas = _build_input_canvas(pieces, layout_mask, layout_h, layout_w, k,\n                                 frame_color, distractor_color)\n    if canvas is None:\n        return None\n\n    # Oracle check\n    try:\n        produced = main(canvas)\n    except Exception:\n        return None\n    if not np.array_equal(produced, expected_out):\n        return None\n\n    return canvas\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATE_MAX_RETRIES):\n        res = _gen_attempt()\n        if res is not None:\n            return res\n    raise RuntimeError(\"generate_input: failed to generate after %d attempts\" % GENERATE_MAX_RETRIES)\n","exit_code":0,"status":"completed"}}
