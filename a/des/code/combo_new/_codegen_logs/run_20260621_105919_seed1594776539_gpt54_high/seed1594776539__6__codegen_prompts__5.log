{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"for f in /home/lixinyu/snap/new/ARC_code/train/470c91de.py /home/lixinyu/snap/new/ARC_code/train/a2d730bd.py /home/lixinyu/snap/new/ARC_code/train/985ae207.py /home/lixinyu/snap/new/ARC_code/eval/4a21e3da.py /home/lixinyu/snap/new/ARC_code/train/58c02a16.py /home/lixinyu/snap/new/ARC_code/train/7e576d6e.py; do printf 'FILE %s\\\\n' \\\"\"'$f\"; sed -n '\"'/\"'^def main(/,/''^def /p'\"' \\\"\"'$f\" | sed '\"'\"'$d'\"'; printf '\\\\n'; done\"","aggregated_output":"FILE /home/lixinyu/snap/new/ARC_code/train/470c91de.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each teal-cornered filled rectangle one cell diagonally toward its teal corner.\n\n    Input structure:\n    - Dominant background surrounds several filled rectangular colored objects.\n    - Each object has exactly one teal control pixel replacing one corner cell of\n      its rectangle.\n\n    Rule:\n    - Treat the teal pixel as the missing corner of its colored rectangle.\n    - Erase each original rectangle footprint, including the teal pixel.\n    - Repaint the completed rectangle shifted one cell diagonally in the direction\n      of that teal corner.\n\n    Key insight:\n    - The control pixel's corner position gives both the missing cell to restore\n      and the diagonal motion vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    moves = _rectangle_moves(g, bg)\n\n    out = g.copy()\n    for r0, c0, r1, c1, _color, _dr, _dc in moves:\n        out[r0 : r1 + 1, c0 : c1 + 1] = bg\n\n    occupied = np.zeros_like(g, dtype=bool)\n    for r0, c0, r1, c1, color, dr, dc in moves:\n        tr0, tr1 = r0 + dr, r1 + dr\n        tc0, tc1 = c0 + dc, c1 + dc\n        assert not occupied[tr0 : tr1 + 1, tc0 : tc1 + 1].any(), \"shifted rectangles must not overlap\"\n        assert np.all(out[tr0 : tr1 + 1, tc0 : tc1 + 1] == bg), \"target region must be background\"\n        out[tr0 : tr1 + 1, tc0 : tc1 + 1] = color\n        occupied[tr0 : tr1 + 1, tc0 : tc1 + 1] = True\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Colors and palette.\n_BG = Color.ORANGE\n_TEAL = Color.TEAL\n_RECT_COLORS = [c for c in Color.ALL_COLORS if c not in {_BG, _TEAL}]\n# Canvas/object sampling.\n_GRID_SIZES = [10, 11]\n_RECT_COUNT_RANGE = (2, 4)\n_RECT_SIZE_RANGE = range(2, 6)\n_OCCUPANCY_PCT_RANGE = (30, 36)\n_PCT_DENOMINATOR = 100\n_DIMS = [(h, w, h * w) for h in _RECT_SIZE_RANGE for w in _RECT_SIZE_RANGE]\n# Shift directions encode the teal-corner motion.\n_SHIFT_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\n# Placement and retry limits.\n_OUTPUT_GAP = 1\n_PLACEMENT_NODE_BUDGET = 8000\n_MAX_GENERATION_ATTEMPTS = 300\n\n_BBox = tuple[int, int, int, int]\n\n\n\nFILE /home/lixinyu/snap/new/ARC_code/train/a2d730bd.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extend each solid foreground rectangle toward its same-color isolated pixels with capped one-cell paths, clearing each original marker pixel.\n\n    Input structure\n    - The background is the dominant color.\n    - Each foreground color has exactly one solid rectangular object and one or more isolated same-color marker pixels.\n    - Every marker is horizontally or vertically aligned with the rectangle bbox and lies outside it.\n    Rule\n    - For each marker, draw a one-cell-wide straight path from the adjacent side of the rectangle through one cell beyond the marker.\n    - Add a three-pixel perpendicular cap at the rectangle end and around the marker endpoint.\n    - Recolor the original marker pixel to background.\n    Key insight\n    - The isolated pixels are not copied; they mark the hollow endpoints of capped protrusions grown from their matching rectangle.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert components\n\n    by_color: dict[int, list[dict]] = {}\n    for comp in components:\n        by_color.setdefault(int(comp[\"color\"]), []).append(comp)\n\n    claims: dict[Coord, int] = {}\n    clears: set[Coord] = set()\n\n    for color, comps in by_color.items():\n        rectangles = [comp for comp in comps if int(comp[\"area\"]) > 1]\n        markers = [comp for comp in comps if int(comp[\"area\"]) == 1]\n        assert len(rectangles) == 1, (color, [(comp[\"area\"], comp[\"bbox\"]) for comp in comps])\n        assert markers and len(rectangles) + len(markers) == len(comps)\n\n        rect = rectangles[0]\n        r0, c0, r1, c1 = map(int, rect[\"bbox\"])\n        rect_h = r1 - r0 + 1\n        rect_w = c1 - c0 + 1\n        assert int(rect[\"area\"]) == rect_h * rect_w\n        assert min(rect_h, rect_w) >= 2\n\n        for marker in markers:\n            mr, mc = map(int, marker[\"coords\"][0])\n            horizontal = r0 <= mr <= r1 and (mc < c0 or mc > c1)\n            vertical = c0 <= mc <= c1 and (mr < r0 or mr > r1)\n            assert horizontal ^ vertical, (color, (mr, mc), rect[\"bbox\"])\n\n            if horizontal:\n                dc = -1 if mc < c0 else 1\n                side_c = c0 - 1 if dc < 0 else c1 + 1\n                for rr in (mr - 1, mr, mr + 1):\n                    _claim(g, claims, (rr, side_c), color, bg)\n                for rr in (mr - 1, mr + 1):\n                    _claim(g, claims, (rr, mc), color, bg)\n                _claim_range(\n                    g,\n                    claims,\n                    (mr, side_c),\n                    (mr, mc + dc),\n                    (0, dc),\n                    (mr, mc),\n                    color,\n                    bg,\n                )\n            else:\n                dr = -1 if mr < r0 else 1\n                side_r = r0 - 1 if dr < 0 else r1 + 1\n                for cc in (mc - 1, mc, mc + 1):\n                    _claim(g, claims, (side_r, cc), color, bg)\n                for cc in (mc - 1, mc + 1):\n                    _claim(g, claims, (mr, cc), color, bg)\n                _claim_range(\n                    g,\n                    claims,\n                    (side_r, mc),\n                    (mr + dr, mc),\n                    (dr, 0),\n                    (mr, mc),\n                    color,\n                    bg,\n                )\n\n            clears.add((mr, mc))\n\n    assert not (set(claims) & clears)\n\n    out = g.copy()\n    for (r, c), color in claims.items():\n        out[r, c] = color\n    for r, c in clears:\n        out[r, c] = bg\n    return out\n\n# --------------- generator (att2) ---------------\n\nGRID_ROWS = (13, 30)\nGRID_COLS = (16, 30)\nPALETTE = tuple(range(10))\nFOREGROUND_COLOR_COUNT = (1, 3)\nRECT_SIZE = (2, 11)\nMARKER_COUNT = (1, 3)\nMARKER_DISTANCE = (3, 10)\nSAME_SIDE_MARKER_GAP = 3\nSIDES = (\"top\", \"bottom\", \"left\", \"right\")\nPATCH_ATTEMPTS = 80\nPLACEMENT_ATTEMPTS = 30\nGENERATE_ATTEMPTS = 300\n\n\nFILE /home/lixinyu/snap/new/ARC_code/train/985ae207.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repeat each 3x3 control-center sprite toward the matching solid rectangle until a copy first overlaps that rectangle.\n\n    Input structure\n    - The background is the dominant color.\n    - Each sprite is a 3x3 foreground object whose eight border pixels have one color and whose center has a different control color.\n    - For every control color, there is exactly one separate solid rectangular object of that color.\n\n    Rule\n    - Match each sprite to the unique solid rectangle whose color equals the sprite center.\n    - Copy the whole 3x3 sprite in the cardinal direction of that rectangle, stepping by three cells each time.\n    - Stop after pasting the first copy whose 3x3 bbox overlaps the rectangle; copied pixels overwrite the rectangle there.\n\n    Key insight\n    The center pixel is not the paint color: it is a destination key, while the entire 3x3 sprite is the motif tiled along the straight path.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h >= 3 and w >= 3\n\n    bg = int(get_bg(g))\n    sprites = _find_sprites(g, bg)\n    assert sprites, \"expected at least one 3x3 control-center sprite\"\n\n    out = g.copy()\n    for sprite_bbox, patch, center in sprites:\n        targets = _solid_rectangles(g, bg, center)\n        assert len(targets) == 1, \"each control color must have one solid rectangular target\"\n        target_bbox = targets[0][\"bbox\"]\n        assert not _intersects(sprite_bbox, target_bbox), \"sprite and target must start separate\"\n\n        dr, dc = _direction_to_target(sprite_bbox, target_bbox)\n        r, c = sprite_bbox[0], sprite_bbox[1]\n\n        while True:\n            current_bbox = (r, c, r + 2, c + 2)\n            assert 0 <= r and r + 3 <= h and 0 <= c and c + 3 <= w\n            paste(out, patch, r, c)\n\n            if _intersects(current_bbox, target_bbox):\n                break\n\n            r += dr * 3\n            c += dc * 3\n\n    return out\n\n# --------------- generator (att1) ---------------\n# Canvas and colors.\nBG_COLOR, COLOR_COUNT = 8, 10\nGRID_MIN_SIZE, GRID_MAX_SIZE = 20, 25\n\n# Rectangles.\nRECT_COUNT_MIN, RECT_COUNT_MAX = 2, 4\nRECT_SIDE_MIN, RECT_SIDE_MAX = 2, 14\nRECT_MARGIN, RECT_SPACING_PAD = 1, 5\nRECT_PLACEMENT_ATTEMPTS = 50\n\n# Sprites and paths.\nSPRITE_SIZE, SPRITE_TOTAL_MAX = 3, 5\nSPRITE_GAPS = [1, 4, 7, 10]\nDIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n\n# Retry limits.\nGENERATION_ATTEMPTS = 300\n\n\n\nFILE /home/lixinyu/snap/new/ARC_code/eval/4a21e3da.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Cut a sprite along border-control rays and slide pieces to grid corners.\n\n    Input structure:\n    - bg, fg (main object, ~centered), ctrl (1-2 pixels on grid edges).\n\n    Rule:\n    - Draw rays inward from each ctrl pixel along its row/col, painting only bg cells up to the farthest fg pixel (intermittent).\n    - Rays partition the grid; fg on the cut line stays in place.\n    - Cut pieces in regions touching a control edge slide to that corner; others vanish.\n\n    Key insight: Only regions sharing a border edge with a control pixel keep their piece; the ray skips fg cells.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    nonbg = colors_present(g, exclude={bg})\n\n    # Control color is the only non-bg color present on the border.\n    border_cols = set(map(int, g[0, :])) | set(map(int, g[-1, :])) | set(map(int, g[:, 0])) | set(map(int, g[:, -1]))\n    border_cols.discard(int(bg))\n    assert not (not border_cols)\n    ctrl = int(sorted(border_cols)[0])\n    fg = int(next(c for c in nonbg if int(c) != int(ctrl)))\n\n    ctrl_pts = [(int(r), int(c)) for r, c in np.argwhere(g == int(ctrl))]\n\n    # Split lines (at most one vertical and one horizontal in these tasks).\n    E: set[str] = set()\n    c_split: int | None = None\n    r_split: int | None = None\n    for r, c in ctrl_pts:\n        if int(r) == 0:\n            E.add(\"top\")\n            c_split = int(c)\n        elif int(r) == int(H - 1):\n            E.add(\"bottom\")\n            c_split = int(c)\n        elif int(c) == 0:\n            E.add(\"left\")\n            r_split = int(r)\n        elif int(c) == int(W - 1):\n            E.add(\"right\")\n            r_split = int(r)\n\n    out = np.full((H, W), int(bg), dtype=int)\n\n    # --- Stage 1: draw rays on background cells only (but keep the control pixel itself). ---\n    for r, c in ctrl_pts:\n        if int(r) == 0:\n            rows = [int(rr) for rr in np.argwhere(g[:, int(c)] == int(fg)).flatten()]\n            if rows:\n                stop = int(max(rows))\n                for rr in range(0, int(stop) + 1):\n                    if int(g[int(rr), int(c)]) == int(bg):\n                        out[int(rr), int(c)] = int(ctrl)\n        elif int(r) == int(H - 1):\n            rows = [int(rr) for rr in np.argwhere(g[:, int(c)] == int(fg)).flatten()]\n            if rows:\n                stop = int(min(rows))\n                for rr in range(int(H - 1), int(stop) - 1, -1):\n                    if int(g[int(rr), int(c)]) == int(bg):\n                        out[int(rr), int(c)] = int(ctrl)\n        elif int(c) == 0:\n            cols = [int(cc) for cc in np.argwhere(g[int(r), :] == int(fg)).flatten()]\n            if cols:\n                stop = int(max(cols))\n                for cc in range(0, int(stop) + 1):\n                    if int(g[int(r), int(cc)]) == int(bg):\n                        out[int(r), int(cc)] = int(ctrl)\n        elif int(c) == int(W - 1):\n            cols = [int(cc) for cc in np.argwhere(g[int(r), :] == int(fg)).flatten()]\n            if cols:\n                stop = int(min(cols))\n                for cc in range(int(W - 1), int(stop) - 1, -1):\n                    if int(g[int(r), int(cc)]) == int(bg):\n                        out[int(r), int(cc)] = int(ctrl)\n\n    for r, c in ctrl_pts:\n        out[int(r), int(c)] = int(ctrl)\n\n    # Foreground pixels on split line(s) remain in place.\n    for r, c in np.argwhere(g == int(fg)):\n        r = int(r)\n        c = int(c)\n        if (c_split is not None and int(c) == int(c_split)) or (r_split is not None and int(r) == int(r_split)):\n            out[int(r), int(c)] = int(fg)\n\n    # --- Stage 2: move cut parts from each rectangular region to its target corner. ---\n    regions: dict[tuple[str, str], list[tuple[int, int]]] = {}\n    for r, c in np.argwhere(g == int(fg)):\n        r = int(r)\n        c = int(c)\n        if (c_split is not None and int(c) == int(c_split)) or (r_split is not None and int(r) == int(r_split)):\n            continue\n        hs = \"A\"\n        vs = \"A\"\n        if r_split is not None:\n            hs = \"T\" if int(r) < int(r_split) else \"B\"\n        if c_split is not None:\n            vs = \"L\" if int(c) < int(c_split) else \"R\"\n        regions.setdefault((hs, vs), []).append((int(r), int(c)))\n\n    def touches_edges(hs: str, vs: str) -> set[str]:\n        te: set[str] = set()\n        if hs in (\"T\", \"A\"):\n            te.add(\"top\")\n        if hs in (\"B\", \"A\"):\n            te.add(\"bottom\")\n        if vs in (\"L\", \"A\"):\n            te.add(\"left\")\n        if vs in (\"R\", \"A\"):\n            te.add(\"right\")\n        return te\n\n    def pick_dest(hs: str, vs: str) -> tuple[str, str]:\n        if r_split is not None:\n            dh = hs\n        else:\n            if (\"top\" in E) and (\"bottom\" not in E):\n                dh = \"T\"\n            elif (\"bottom\" in E) and (\"top\" not in E):\n                dh = \"B\"\n            else:\n                dh = \"T\"\n        if c_split is not None:\n            dv = vs\n        else:\n            if (\"left\" in E) and (\"right\" not in E):\n                dv = \"L\"\n            elif (\"right\" in E) and (\"left\" not in E):\n                dv = \"R\"\n            else:\n                dv = \"L\"\n        return str(dh), str(dv)\n\n    for (hs, vs), pts in regions.items():\n        if not (touches_edges(hs, vs) & E):\n            continue\n\n        dh, dv = pick_dest(hs, vs)\n        rs = [r for r, _ in pts]\n        cs = [c for _, c in pts]\n        rmin, rmax = int(min(rs)), int(max(rs))\n        cmin, cmax = int(min(cs)), int(max(cs))\n        dr = int(0 - rmin) if dh == \"T\" else int((H - 1) - rmax)\n        dc = int(0 - cmin) if dv == \"L\" else int((W - 1) - cmax)\n\n        for r, c in pts:\n            rr = int(r + dr)\n            cc = int(c + dc)\n            if 0 <= rr < H and 0 <= cc < W:\n                out[int(rr), int(cc)] = int(fg)\n\n    return out\n\n# --------------- generator (Claude#1) ---------------\n\n\nFILE /home/lixinyu/snap/new/ARC_code/train/58c02a16.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Expand the top-left seed mask into a recursive colored pattern and tile it across the full grid.\n\n    Input structure\n    - The background is the dominant color.\n    - All foreground lies in a top-left rectangle whose last row and last column are a solid secondary color.\n    - Removing that secondary-color row and column leaves a seed region containing background plus one primary color.\n\n    Rule\n    - Use the primary-color pixels in the seed as a binary mask.\n    - Replace each primary seed cell with a copy of the seed mask in the primary color, and each background seed cell\n      with a copy of the seed mask in the secondary color.\n    - Repeat and crop that expanded tile to the original grid shape.\n\n    Key insight\n    The solid L-shaped secondary-color border is a legend, not output content; it supplies the color used when the\n    seed's background cells are expanded.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    fg_bbox = bbox(g != bg)\n    assert fg_bbox is not None, \"expected a top-left foreground legend\"\n    r0, c0, r1, c1 = fg_bbox\n    assert r0 == 0 and c0 == 0, \"foreground legend must be anchored at the top-left corner\"\n\n    legend_box = g[: r1 + 1, : c1 + 1]\n    seed_h = legend_box.shape[0] - 1\n    seed_w = legend_box.shape[1] - 1\n    assert seed_h >= 1 and seed_w >= 1, \"legend must contain a non-empty seed plus border\"\n\n    secondary_border = np.concatenate((legend_box[:seed_h, seed_w], legend_box[seed_h, :]))\n    secondary_colors = np.unique(secondary_border)\n    assert secondary_colors.size == 1, \"expected one solid secondary-color border\"\n    secondary = int(secondary_colors[0])\n    assert secondary != bg, \"secondary border must be foreground\"\n\n    seed = legend_box[:seed_h, :seed_w]\n    primary_colors = np.unique(seed[seed != bg])\n    assert primary_colors.size == 1, \"seed must contain exactly one primary foreground color\"\n    primary = int(primary_colors[0])\n    assert primary != secondary, \"primary and secondary colors must be distinct\"\n    assert np.all((seed == bg) | (seed == primary)), \"seed may contain only background and primary colors\"\n    assert np.any(seed == bg), \"seed must include background cells that expand to the secondary color\"\n\n    seed_mask = seed == primary\n    H, W = g.shape\n    rows = np.arange(H)[:, None]\n    cols = np.arange(W)[None, :]\n\n    inner_mask = seed_mask[rows % seed_h, cols % seed_w]\n    meta_mask = seed_mask[(rows // seed_h) % seed_h, (cols // seed_w) % seed_w]\n\n    out = np.full(g.shape, bg, dtype=int)\n    out[inner_mask & meta_mask] = primary\n    out[inner_mask & ~meta_mask] = secondary\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color palette.\nBACKGROUND_COLOR, PALETTE_COLORS = 7, tuple(range(10))\n# Seed geometry.\nSEED_SIZES = (2, 3)\nSEED_DENSITY_MIN, SEED_DENSITY_MAX = 0.33, 0.67\n# Canvas layout.\nTILE_MULTIPLIERS, GRID_MIN, GRID_MAX = range(3, 6), 7, 16\nREMAINDERS_BY_SQUARENESS = {False: (0,), True: (0, 1)}\n# Retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\nFILE /home/lixinyu/snap/new/ARC_code/train/7e576d6e.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Draw the marker-colored route through the centers of all doors in the parallel wall maze.\n\n    Input structure:\n    - The grid has a background, parallel full-span walls, one three-pixel door\n      segment in each wall, and two marker pixels sharing a color.\n    - Walls are either all vertical or all horizontal, and the markers are on\n      opposite outer sides of the wall set.\n\n    Rule:\n    - Keep the scene unchanged except for the route.\n    - Visit the door centers in wall order from the upper/left marker side to\n      the lower/right marker side.\n    - In each corridor, draw an orthogonal path to the cell just before the next\n      wall, move along that wall to the door center, cross the center, and\n      continue to the next corridor; after the last door, connect to the other\n      marker.\n\n    Key insight:\n    - The three-pixel door segments mark the only crossing points through a set\n      of parallel walls, so the output is the corridor path threaded through\n      those centers.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg, path_color, door_color, wall_color = _roles(g)\n    orientation, centers = _door_centers(g, door_color)\n    markers = _markers(g, path_color)\n\n    if orientation == \"vertical\":\n        return _solve_vertical_walls(g, centers, markers, bg, path_color, door_color, wall_color)\n    assert orientation == \"horizontal\"\n    return _solve_horizontal_walls(g, centers, markers, bg, path_color, door_color, wall_color)\n\n# --------------- generator (att1) ---------------\n\n# Canvas and color role sampling.\nGRID_H = 30\nGRID_W = 30\nCOLOR_POOL = range(10)\nN_ROLE_COLORS = 4\n\n# Parallel wall and door geometry.\nORIENTATIONS = (\"vertical\", \"horizontal\")\nWALL_COUNT_RANGE = (3, 4)\nWALL_POS_LO = 4\nWALL_POS_HI_MARGIN = 5\nWALL_MIN_GAP = 2\nDOOR_CENTER_LO = 3\nDOOR_CENTER_HI_MARGIN = 4\n\n# Marker placement and retry budget.\nMARKER_EDGE_RANGE = (1, 3)\nMARKER_FREE_LO = 1\nMARKER_FREE_HI_MARGIN = 2\nGEN_RETRIES = 300\n\n\n\n","exit_code":0,"status":"completed"}}
