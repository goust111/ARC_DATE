{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '101,240p;604,760p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\nsed -n '10,180p' /home/lixinyu/snap/new/ARC_code/train/e048c9ed.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Add a quantity-color label in the top marker column for each horizontal bar.\n\n    Input structure\n    - The grid has a black background and one non-background marker pixel in the top row.\n    - Below the marker row, every non-empty source row contains one solid monochrome horizontal bar to the left of the marker column.\n    - Source rows are staggered every other row.\n\n    Rule\n    - Copy the input grid.\n    - For each source bar, read its quantity as the bar length.\n    - Paint the quantity color in the marker column on the same row as the bar:\n      2->1, 3->4, 4->9, 5->6.\n\n    Key insight\n    - The grey marker supplies the result column, while each bar supplies a small quantity with a fixed color code.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    assert bg == 0, \"expected black background for square-digit labels\"\n\n    marker_cols = np.flatnonzero(g[0] != bg)\n    assert len(marker_cols) == 1, \"expected exactly one top-row marker\"\n    marker_c = int(marker_cols[0])\n    assert g[0, marker_c] == Color.GREY, \"top-row marker must be grey\"\n\n    source_rows = [r for r in range(1, g.shape[0]) if np.any(g[r] != bg)]\n    assert source_rows, \"expected at least one source bar\"\n    first_source_row = source_rows[0]\n\n    out = g.copy()\n    for bar_order, r in enumerate(source_rows):\n        assert (r - first_source_row) % 2 == 0, \"source bars must follow the staggered row spacing\"\n        cols = np.flatnonzero(g[r] != bg)\n        c0, c1 = int(cols[0]), int(cols[-1])\n        expected_cols = np.arange(c0, c1 + 1)\n        assert np.array_equal(cols, expected_cols), \"source row must contain one contiguous bar\"\n        assert np.unique(g[r, c0 : c1 + 1]).size == 1, \"source bar must be monochrome\"\n        assert c1 < marker_c, \"source bar must lie to the left of the marker column\"\n        assert g[r, marker_c] == bg, \"marker-column output cell must be empty\"\n\n        bar_length = c1 - c0 + 1\n        assert 2 <= bar_length <= 5, \"bar length quantity must be 2-5\"\n        assert bar_length in _QUANTITY_TO_COLOR, \"quantity must be one of 2, 3, 4, or 5\"\n        out[r, marker_c] = _QUANTITY_TO_COLOR[bar_length]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Row/bar structure.\nBAR_COUNT_RANGE, FIRST_ROWS_SINGLE, FIRST_ROWS_MULTI = (1, 4), (2,), (1, 2)\nROW_STRIDE, BAR_LENGTHS, START_COL_RANGE = 2, (2, 3, 4, 5), (0, 2)\n# Marker/canvas placement.\nMARKER_COL_RANGE, MARKER_WEIGHTS = (2, 9), (8, 1)\nWIDTH_EXTRA_RANGE, MAX_WIDTH = (1, 8), 12\n# Colors and retry budget.\nCOLOR_RANGE, MARKER_COLOR, BG_COLOR = (1, 9), Color.GREY, 0\nMAX_ATTEMPTS = 300\n\ndef _gen_attempt() -> np.ndarray | None:\n    num_bars = random.randint(*BAR_COUNT_RANGE)\n    first_rows = FIRST_ROWS_SINGLE if num_bars == 1 else FIRST_ROWS_MULTI\n    first_src_row = random.choice(first_rows)\n    height = ROW_STRIDE * (first_src_row + num_bars - 1)\n\n    bar_lengths = random.sample(BAR_LENGTHS, k=num_bars)\n    start_cols = [random.randint(*START_COL_RANGE) for _ in range(num_bars)]\n    max_bar_end = max(c + length - 1 for c, length in zip(start_cols, bar_lengths))\n\n    marker_min = max(MARKER_COL_RANGE[0], max_bar_end + 1)\n    if marker_min > MARKER_COL_RANGE[1]:\n        return None\n    marker_choices = list(range(marker_min, MARKER_COL_RANGE[1] + 1))\n    marker_weights = [MARKER_WEIGHTS[0]] + [MARKER_WEIGHTS[1]] * (len(marker_choices) - 1)\n    marker_col = random.choices(marker_choices, weights=marker_weights, k=1)[0]\n    width = random.randint(marker_col + WIDTH_EXTRA_RANGE[0], min(MAX_WIDTH, marker_col + WIDTH_EXTRA_RANGE[1]))\n\n    grid = np.zeros((height, width), dtype=int)\n    grid[0, marker_col] = MARKER_COLOR\n\n    for i, (start_col, bar_length) in enumerate(zip(start_cols, bar_lengths)):\n        row = first_src_row + ROW_STRIDE * i\n        grid[row, start_col : start_col + bar_length] = random.randint(*COLOR_RANGE)\n\n    try:\n        main(grid)\n    except AssertionError:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
