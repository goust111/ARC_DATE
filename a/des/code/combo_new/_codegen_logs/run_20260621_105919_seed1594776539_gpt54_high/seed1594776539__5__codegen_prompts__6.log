{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '7,170p;582,760p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\nsed -n '274,430p;544,760p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 581f7754 input\")\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\ndef _get_enclosed_holes(sprite):\n    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n    h, w = sprite.shape\n    return [pts for pts in components_mask(~sprite, connectivity=4)\n            if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n\n\ndef _make_diamond():\n    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n    s = np.zeros((3, 3), dtype=bool)\n    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n    return s\n\n\ndef _make_hollow_sprite(h, w, rng):\n    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n    sprite = np.ones((h, w), dtype=bool)\n    if h >= 3 and w >= 3:\n        sprite[1:-1, 1:-1] = False\n    # Optionally add internal horizontal wall\n    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n        br = rng.randint(2, h - 2)\n        n = rng.randint(1, w - 2)\n        s = rng.randint(1, w - 1 - n + 1)\n        sprite[br, s:s + n] = True\n    # Optionally add internal vertical wall\n    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n        bc = rng.randint(2, w - 2)\n        n = rng.randint(1, h - 2)\n        s = rng.randint(1, h - 1 - n + 1)\n        sprite[s:s + n, bc] = True\n    # Optionally remove border cells for irregularity\n    if rng.random() < _P_BORDER_REMOVAL:\n        bcells = [(r, c) for r in range(h) for c in range(w)\n                  if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n        rng.shuffle(bcells)\n        for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n            test = sprite.copy()\n            test[cr, cc] = False\n            if _get_enclosed_holes(test):\n                sprite = test\n    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n        return None\n    return sprite\n\n\ndef _choose_colors(rng, N, num_filled):\n    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n    all_c = list(range(1, 10))\n    rng.shuffle(all_c)\n    border_keys = all_c[:N]\n    rng.shuffle(all_c)\n    fill_values = all_c[:N]\n    dist_cands = [c for c in range(1, 10) if c not in border_keys]\n    distractor_color = rng.choice(dist_cands)\n    mapping = dict(zip(border_keys, fill_values))\n    filled_keys = rng.sample(border_keys, num_filled)\n    return border_keys, fill_values, distractor_color, mapping, filled_keys\n\n\ndef _build_palette(side, border_keys, fill_values):\n    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n    N = len(border_keys)\n    if side in ('top', 'bottom'):\n        pal = np.zeros((2, N), dtype=int)\n        outer, inner = (0, 1) if side == 'top' else (1, 0)\n        pal[outer] = border_keys\n        pal[inner] = fill_values\n    else:\n        pal = np.zeros((N, 2), dtype=int)\n        outer, inner = (0, 1) if side == 'left' else (1, 0)\n        pal[:, outer] = border_keys\n        pal[:, inner] = fill_values\n    return pal\n\n\ndef _place_palette(grid, occ, pal, side, rng):\n    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n    H, W = grid.shape\n    pal_h, pal_w = pal.shape\n    if side == 'top':\n        pr0, pc0 = 0, rng.randint(0, W - pal_w)\n    elif side == 'bottom':\n        pr0, pc0 = H - pal_h, rng.randint(0, W - pal_w)\n    elif side == 'left':\n        pr0, pc0 = rng.randint(0, H - pal_h), 0\n    else:\n        pr0, pc0 = rng.randint(0, H - pal_h), W - pal_w\n    grid[pr0:pr0 + pal_h, pc0:pc0 + pal_w] = pal\n    occ[max(0, pr0 - 1):min(H, pr0 + pal_h + 1),\n        max(0, pc0 - 1):min(W, pc0 + pal_w + 1)] = True\n\n\ndef _find_valid_positions(H, W, occ, mask, holes):\n    \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n    sh, sw = mask.shape\n    positions = []\n    for r0 in range(H - sh + 1):\n        for c0 in range(W - sw + 1):\n            if occ[max(0, r0 - 1):min(H, r0 + sh + 1),\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '6,140p;303,520p' /home/lixinyu/snap/new/ARC_code/eval/b5ca7ac4.py\nsed -n '105,240p;275,430p' /home/lixinyu/snap/new/ARC_code/train/afe3afe9.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '6,140p;303,520p' /home/lixinyu/snap/new/ARC_code/eval/b5ca7ac4.py\nsed -n '105,240p;275,430p' /home/lixinyu/snap/new/ARC_code/train/afe3afe9.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move bordered 5×5 squares to their designated grid edges by border color.\n\n    Input structure:\n    - bg = most common color.\n    - Azure (8) and red (2) bordered 5×5 squares with colored interiors, scattered across the grid.\n\n    Rule:\n    - Azure squares → left edge (col 0); red squares → right edge (col W−5).\n    - Each square keeps its original row.\n    - Process azure left-to-right, red right-to-left (nearest-to-edge first).\n    - If a square's rows overlap an already-placed edge square, place it one square-width inward instead.\n\n    Key insight: Near-edge-first ordering plus row-overlap determines which square sits at the edge vs. the second column.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    out = np.full_like(g, bg)\n\n    SQUARE_SIZE = 5\n    def overlaps(a0: int, a1: int, b0: int, b1: int) -> bool:\n        return not (int(a1) < int(b0) or int(b1) < int(a0))\n\n    # Detect bordered squares by scanning 5x5 windows. This is robust even if frame-color pixels\n    # are connected between squares in the input.\n    squares = []\n    for r0 in range(H - SQUARE_SIZE + 1):\n        for c0 in range(W - SQUARE_SIZE + 1):\n            patch = crop_bbox(g, (int(r0), int(c0), int(r0 + SQUARE_SIZE - 1), int(c0 + SQUARE_SIZE - 1)))\n\n            border = np.concatenate([patch[0, :], patch[-1, :], patch[1:-1, 0], patch[1:-1, -1]])\n            if int(border.min()) != int(border.max()):\n                continue\n            frame_col = int(border[0])\n            if frame_col not in {2, 8}:\n                continue\n\n            inner = patch[1:-1, 1:-1]\n            if not bool((inner != int(frame_col)).any()):\n                continue\n\n            squares.append({\"frame\": int(frame_col), \"r0\": int(r0), \"c0\": int(c0), \"patch\": patch})\n\n    # Azure squares: sort by original column ascending (leftmost first).\n    azure_squares = sorted([s for s in squares if int(s[\"frame\"]) == 8], key=lambda s: int(s[\"c0\"]))\n    placed_at_default: list[tuple[int, int]] = []\n    for s in azure_squares:\n        r0 = int(s[\"r0\"])\n        r1 = int(r0 + SQUARE_SIZE - 1)\n        has_overlap = any(overlaps(r0, r1, pr0, pr1) for pr0, pr1 in placed_at_default)\n        dest_c = int(SQUARE_SIZE) if has_overlap else 0\n        paste(out, s[\"patch\"], r0, dest_c, transparent=bg)\n        if dest_c == 0:\n            placed_at_default.append((r0, r1))\n\n    # Red squares: sort by original column descending (rightmost first).\n    red_squares = sorted([s for s in squares if int(s[\"frame\"]) == 2], key=lambda s: -int(s[\"c0\"]))\n    placed_at_default = []\n    for s in red_squares:\n        r0 = int(s[\"r0\"])\n        r1 = int(r0 + SQUARE_SIZE - 1)\n        has_overlap = any(overlaps(r0, r1, pr0, pr1) for pr0, pr1 in placed_at_default)\n        dest_c = int(W - 2 * SQUARE_SIZE) if has_overlap else int(W - SQUARE_SIZE)\n        paste(out, s[\"patch\"], r0, dest_c, transparent=bg)\n        if dest_c == int(W - SQUARE_SIZE):\n            placed_at_default.append((r0, r1))\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# --- Configuration ---\nGRID_H, GRID_W = 22, 22          # canvas dimensions\nSQ = 5                            # square side length (frame + 3x3 interior)\nAZURE, RED = 8, 2                 # frame colors\nN_AZURE_RANGE = (3, 4)            # azure square count range\nN_RED_RANGE = (3, 5)              # red square count range\nMAX_INWARD = 2                    # max inward squares per side\nINPUT_COL_RETRIES = 50            # retries for input column assignment per side\nGEN_RETRIES = 500                 # outer generate_input retry limit\n\n\ndef _make_patch(frame_color: int, inner_color: int) -> np.ndarray:\n    \"\"\"Create a SQxSQ bordered patch with uniform interior.\"\"\"\n    p = np.full((SQ, SQ), frame_color, dtype=int)\n    p[1:-1, 1:-1] = inner_color\n    return p\n\n\ndef _rows_overlap(r_a: int, r_b: int) -> bool:\n    \"\"\"Check whether two SQ-tall row spans overlap.\"\"\"\n    return abs(r_a - r_b) < SQ\n\n\ndef _rects_overlap(r1, c1, r2, c2) -> bool:\n    \"\"\"Check whether two SQxSQ rectangles overlap.\"\"\"\n    return abs(r1 - r2) < SQ and abs(c1 - c2) < SQ\n\n\ndef _any_pairwise_overlap(positions: list[tuple]) -> bool:\n    \"\"\"Return True if any two (r, c, ...) entries overlap as SQxSQ rects.\"\"\"\n    for i in range(len(positions)):\n        for j in range(i + 1, len(positions)):\n            if _rects_overlap(positions[i][0], positions[i][1],\n                              positions[j][0], positions[j][1]):\n                return True\n    return False\n\n\ndef _assign_output_rows(n: int) -> tuple[list[int], list[int]] | None:\n    \"\"\"Pick edge and inward row positions for *n* squares on one side.\n\n    Returns (edge_rows, inward_rows) or None on failure.\n    Edge squares have non-overlapping row spans. Each inward square must\n    row-overlap at least one edge square.\n    \"\"\"\n    max_inward = min(MAX_INWARD, n - 1)\n    n_inward = random.randint(1, max_inward)\n    n_edge = n - n_inward\n\n    all_rows = list(range(GRID_H - SQ + 1))\n    random.shuffle(all_rows)\n    edge_rows: list[int] = []\n    for r in all_rows:\n        if all(not _rows_overlap(r, er) for er in edge_rows):\n            edge_rows.append(r)\n            if len(edge_rows) == n_edge:\n                break\n    if len(edge_rows) < n_edge:\n        return None\n\n    random.shuffle(all_rows)\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Convert each hollow 3x3 symbol to one pixel and slide the pixels clockwise from the marked edge.\n\n    Input structure\n    - The grid has a background, one full-edge marker line, and monochrome hollow 3x3 foreground symbols.\n    - The symbols lie on a coarse row/column lattice; fully empty lattice rows or columns are absent from the output.\n\n    Rule\n    - Replace each hollow 3x3 symbol with one pixel of its color in the corresponding coarse-grid cell.\n    - The marker edge gives the compaction direction by clockwise border travel: top -> right, right -> down, bottom -> left, left -> up.\n    - Preserve the order of non-background pixels while sliding them as far as possible in that direction.\n\n    Key insight\n    - The large picture is a scaled symbolic grid, and the blue edge marker acts as a gravity direction rather than as output content.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    symbolic, side, bg = _symbolic_grid(g)\n    return _compact(symbolic, side, bg)\n\n# --------------- generator (att2) ---------------\n\n# Canvas and colors.\nGEN_BG = 0\nGEN_GRID_SHAPE = (30, 30)\nGEN_MARKER_COLOR = 1\nGEN_DOMINANT_COLOR = 8\nGEN_ACCENT_COLORS = [2, 3, 4, 5, 6, 7, 9]\n\n# Symbolic lattice layout.\nGEN_SIDES = [\"top\", \"right\", \"bottom\", \"left\"]\nGEN_SYMBOLIC_HW = (7, 6)\nGEN_SYMBOLIC_VW = (6, 7)\nGEN_DOMINANT_COUNT_RANGE = (13, 17)\nGEN_ACCENT_COUNT_RANGE = (6, 8)\nGEN_SPLIT_INDEX = 3\n\n# Physical lattice coordinates.\nGEN_GAP_SIX_POSITIONS = [1, 5, 9, 17, 21, 25]\nGEN_SEVEN_FROM_MARKER = [2, 6, 10, 14, 18, 22, 26]\nGEN_SEVEN_FROM_OTHER = [1, 5, 9, 13, 17, 21, 25]\nGEN_SYMBOL_PATCH_SIZE = 3\n\n# Generation retries.\nGEN_MAX_ATTEMPTS = 300\n\ndef _gen_compact(symbolic, side, bg):\n    out = np.full_like(symbolic, bg)\n\n    if side == \"top\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, symbolic.shape[1] - len(values) :] = values\n    elif side == \"right\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[symbolic.shape[0] - len(values) :, c] = values\n    elif side == \"bottom\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, : len(values)] = values\n    elif side == \"left\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[: len(values), c] = values\n    else:\n        raise AssertionError(side)\n\n    return out\n\n\ndef _gen_covering_cells(rows, cols, count):\n    rows = list(rows)\n    cols = list(cols)\n    cells = set()\n\n    shuffled_rows = rows[:]\n    random.shuffle(shuffled_rows)\n    for r in shuffled_rows:\n        cells.add((r, random.choice(cols)))\n\n    for c in cols:\n        if all(cc != c for _rr, cc in cells):\n            cells.add((random.choice(rows), c))\n\n    remaining = [(r, c) for r in rows for c in cols if (r, c) not in cells]\n    random.shuffle(remaining)\n    cells.update(remaining[: count - len(cells)])\n    return cells\n\n\ndef _gen_fill(symbolic, rows, cols, count, color):\n    for r, c in _gen_covering_cells(rows, cols, count):\n        symbolic[r, c] = color\n\n\ndef _gen_symbolic(side, bg):\n    color_a, color_b = random.sample(GEN_ACCENT_COLORS, 2)\n\n    if side in (\"top\", \"bottom\"):\n        symbolic = np.full(GEN_SYMBOLIC_HW, bg, dtype=int)\n        dominant_cols = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1]) if side == \"top\" else range(0, GEN_SPLIT_INDEX)\n        accent_cols = range(0, GEN_SPLIT_INDEX) if side == \"top\" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1])\n        _gen_fill(symbolic, range(GEN_SYMBOLIC_HW[0]), dominant_cols, random.randint(*GEN_DOMINANT_COUNT_RANGE), GEN_DOMINANT_COL