{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/train/833966f4.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swap the upper two-pixel segment and the lower two-pixel segment around the fixed center pixel.\n\n    Input structure:\n    - The grid is a 5x1 vertical column of individual colored pixels.\n    - The middle pixel is a separator between two same-size two-pixel segments.\n\n    Rule:\n    - Keep the middle pixel in place.\n    - Reverse the order of the two pixels above the middle.\n    - Reverse the order of the two pixels below the middle.\n\n    Key insight:\n    - The transformation is local vertical order reversal on each side of the center, not a color-specific rule.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.shape == (5, 1), \"expected a 5x1 vertical column\"\n\n    out = g.copy()\n    out[0, 0], out[1, 0] = g[1, 0], g[0, 0]\n    out[3, 0], out[4, 0] = g[4, 0], g[3, 0]\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Fixed 5x1 column and color vocabulary.\nGRID_SHAPE = (5, 1)\nCOLOR_DOMAIN = range(10)\nCOLORS_PER_GRID = GRID_SHAPE[0]\n\n# Oracle/retry controls.\nOUTPUT_ROW_ORDER = (1, 0, 2, 4, 3)\nMAX_ATTEMPTS = 300\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        inp = np.array(random.sample(COLOR_DOMAIN, COLORS_PER_GRID), dtype=int).reshape(GRID_SHAPE)\n        if np.array_equal(main(inp), inp[OUTPUT_ROW_ORDER, :]):\n            return inp\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import Color, components_mask, get_bg\n\n\nPALETTE_ORDER = (Color.GREY, Color.RED, Color.TEAL, Color.MAROON, Color.PINK)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Convert scattered foreground objects into bottom-aligned count bars in a fixed five-color order.\n\n    Input structure\n    The grid has a dominant background color and foreground objects in the task\n    palette: grey, red, teal, maroon, and pink. Objects are monochromatic\n    8-connected components; some palette colors may be absent.\n\n    Rule\n    For each palette color in order grey, red, teal, maroon, pink, count its\n    8-connected objects. Create a background grid with five columns and height\n    equal to the largest count, then fill each column upward from the bottom\n    with its palette color for that count.\n\n    Key insight\n    The output does not preserve object shapes or positions; it is a histogram\n    of per-color 8-connected object counts, using the learned palette order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    palette_set = set(PALETTE_ORDER)\n    assert bg not in palette_set, \"background must not be a histogram color\"\n    assert set(map(int, g.ravel())) <= palette_set | {bg}\n\n    object_counts = [len(components_mask(g == color, connectivity=8)) for color in PALETTE_ORDER]\n    max_count = max(object_counts)\n    assert max_count > 0, \"expected at least one foreground object\"\n\n    out = np.full((max_count, len(PALETTE_ORDER)), bg, dtype=int)\n    for c, (color, count) in enumerate(zip(PALETTE_ORDER, object_counts)):\n        if count:\n            out[-count:, c] = color\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and palette.\nGRID_SHAPE = (10, 10)\nBACKGROUND_COLOR = Color.ORANGE\nN_COLORS = len(PALETTE_ORDER)\n\n# Histogram count sampling.\nNONZERO_COLOR_RANGE = (3, 6)\nMAX_COUNT_RANGE = (2, 7)\nTOTAL_OBJECT_RANGE = (4, 12)\n\n# Blob shape sampling.\nN_BLOB_SHAPES = 6\nLINE_LENGTH_RANGE = (2, 5)\nSMALL_DIM_RANGE = (2, 4)\nGROWN_BLOB_MIN_SIZE = 3\nPLUS_SHAPE_SIZE = 3\n\n# Placement and retry limits.\nSAME_COLOR_MIN_CHEBYSHEV = 2\nBLOB_PLACE_TRIES = 100\nGENERATION_TRIES = 300\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Generate one candidate grid, returning None when placement or validation fails.\"\"\"\n    rng = np.random.default_rng()\n    counts = _sample_counts(rng)\n    if counts is None:\n        return None\n\n    grid = np.full(GRID_SHAPE, BACKGROUND_COLOR, dtype=int)\n    if not _place_all_blobs(grid, counts, rng):\n        return None\n    if not _counts_match_grid(grid, counts):\n        return None\n    if not _solver_matches_expected(grid, counts):\n        return None\n    return grid\n\n\ndef _sample_counts(rng) -> list[int] | None:\n    \"\"\"Sample per-color component counts matching the output histogram contract.\"\"\"\n    n_nonzero = int(rng.integers(*NONZERO_COLOR_RANGE))\n    max_count = int(rng.integers(*MAX_COUNT_RANGE))\n\n    counts = [0] * N_COLORS\n    nonzero_indices = list(rng.choice(N_COLORS, size=n_nonzero, replace=False))\n    max_idx = rng.choice(nonzero_indices)\n    counts[max_idx] = max_count\n\n    remaining_budget = TOTAL_OBJECT_RANGE[1] - max_count\n    for idx in [i for i in nonzero_indices if i != max_idx]:\n        upper = min(max_count, remaining_budget)\n        if upper < 1:\n            counts[idx] = 1\n            remaining_budget -= 1\n        else:\n            counts[idx] = int(rng.integers(1, upper + 1))\n            remaining_budget -= counts[idx]\n\n    total = sum(counts)\n    if total < TOTAL_OBJECT_RANGE[0] or total > TOTAL_OBJECT_RANGE[1]:\n        return None\n    return counts\n\n\ndef _place_all_blobs(grid: np.ndarray, counts: list[int], rng) -> bool:\n    \"\"\"Place each color's requested number of same-color-separated blobs.\"\"\"\n    for color_idx, count in enumerate(counts):\n        if count == 0:\n            continue\n        if not _place_color_blobs(grid, PALETTE_ORDER[color_idx], count, rng):\n            return False\n    return True\n\n\ndef _place_color_blobs(grid: np.ndarray, color: int, count: int, rng) -> bool:\n    placed_blobs = []\n    for _ in range(count):\n        coords = _choose_placeable_blob(grid, placed_blobs, rng)\n        if coords is None:\n            return False\n        _paint_coords(grid, coords, color)\n        placed_blobs.append(coords)\n    return True\n\n\ndef _choose_placeable_blob(grid: np.ndarray, placed_blobs: list[set], rng) -> set | None:\n    for _ in range(BLOB_PLACE_TRIES):\n        blob = _random_blob(rng)\n        bh, bw = blob.shape\n        r0 = int(rng.integers(0, GRID_SHAPE[0] - bh + 1))\n        c0 = int(rng.integers(0, GRID_SHAPE[1] - bw + 1))\n        coords = _offset_blob_coords(blob, r0, c0)\n        if _coords_are_free(grid, coords) and _chebyshev_ok(coords, placed_blobs):\n            return coords\n    return None\n\n\ndef _offset_blob_coords(blob: np.ndarray, r0: int, c0: int) -> set:\n    offsets = np.argwhere(blob)\n    return set(map(tuple, offsets + np.array([r0, c0])))\n\n\ndef _coords_are_free(grid: np.ndarray, coords: set) -> bool:\n    return all(grid[r, c] == BACKGROUND_COLOR for r, c in coords)\n\n\ndef _paint_coords(grid: np.ndarray, coords: set, color: int) -> None:\n    rr, cc = np.array(list(coords)).T\n    grid[rr, cc] = color\n\n\ndef _counts_match_grid(grid: np.ndarray, counts: list[int]) -> bool:\n    \"\"\"Recompute 8-connected components to reject accidental same-color merges.\"\"\"\n    for color, expected_count in zip(PALETTE_ORDER, counts):\n        mask = grid == color\n        if expected_count == 0:\n            if mask.any():\n                return False\n        elif len(components_mask(mask, connectivity=8)) != expected_count:\n            return False\n    return True\n\n\ndef _solver_matches_expected(grid: np.ndarray, counts: list[int]) -> bool:\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return np.array_equal(out, _expected_output(counts))\n\n\ndef _expected_output(counts: list[int]) -> np.ndarray:\n    out = np.full((max(counts), N_COLORS), BACKGROUND_COLOR, dtype=int)\n    for c_idx, (color, count) in enumerate(zip(PALETTE_ORDER, counts)):\n        if count:\n            out[-count:, c_idx] = color\n    return out\n\n\ndef _random_blob(rng) -> np.ndarray:\n    \"\"\"Generate a random small 8-connected blob mask.\"\"\"\n    shape_type = rng.integers(0, N_BLOB_SHAPES)\n\n    if shape_type == 0:\n        return np.array([[True]])\n    elif shape_type == 1:\n        length = int(rng.integers(*LINE_LENGTH_RANGE))\n        return np.ones((1, length), dtype=bool)\n    elif shape_type == 2:\n        length = int(rng.integers(*LINE_LENGTH_RANGE))\n        return np.ones((length, 1), dtype=bool)\n    elif shape_type == 3:\n        return _random_grown_blob(rng)\n    elif shape_type == 4:\n        return _plus_blob()\n    else:\n        h = int(rng.integers(*SMALL_DIM_RANGE))\n        w = int(rng.integers(*SMALL_DIM_RANGE))\n        return np.ones((h, w), dtype=bool)\n\n\ndef _random_grown_blob(rng) -> np.ndarray:\n    \"\"\"Grow a small mask by repeatedly adding an 8-neighbor of existing pixels.\"\"\"\n    h = int(rng.integers(*SMALL_DIM_RANGE))\n    w = int(rng.integers(*SMALL_DIM_RANGE))\n    mask = np.zeros((h, w), dtype=bool)\n    mask[0, 0] = True\n    pixels = [(0, 0)]\n    target_size = int(rng.integers(GROWN_BLOB_MIN_SIZE, h * w + 1))\n    for _ in range(target_size - 1):\n        candidates = _growth_candidates(mask, pixels)\n        if not candidates:\n            break\n        pick = list(candidates)[int(rng.integers(0, len(candidates)))]\n        mask[pick[0], pick[1]] = True\n        pixels.append(pick)\n    return mask\n\n\ndef _growth_candidates(mask: np.ndarray, pixels: list[tuple[int, int]]) -> set:\n    h, w = mask.shape\n    candidates = set()\n    for r, c in pixels:\n        for dr in range(-1, 2):\n            for dc in range(-1, 2):\n                if dr == 0 and dc == 0:\n                    continue\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:\n                    candidates.add((nr, nc))\n    return candidates\n\n\ndef _plus_blob() -> np.ndarray:\n    mask = np.zeros((PLUS_SHAPE_SIZE, PLUS_SHAPE_SIZE), dtype=bool)\n    center = PLUS_SHAPE_SIZE // 2\n    mask[center, :] = True\n    mask[:, center] = True\n    return mask\n\n\ndef _chebyshev_ok(new_coords: set, existing_blobs: list) -> bool:\n    for blob in existing_blobs:\n        for r1, c1 in new_coords:\n            for r2, c2 in blob:\n                if max(abs(r1 - r2), abs(c1 - c2)) < SAME_COLOR_MIN_CHEBYSHEV:\n                    return False\n    return True\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_TRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_TRIES} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,360p' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,360p' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, components_mask, find_components, get_bg\nimport random\n\n\ndef _unique_largest_count_color(g: np.ndarray, colors: list[int]) -> int:\n    counts = [(int(np.sum(g == color)), int(color)) for color in colors]\n    max_count = max(count for count, _color in counts)\n    winners = [color for count, color in counts if count == max_count]\n    assert len(winners) == 1, \"expected one most numerous non-background obstacle color\"\n    return winners[0]\n\n\ndef _marker_bbox(g: np.ndarray, marker_colors: list[int]) -> tuple[int, int, int, int]:\n    mask = np.isin(g, marker_colors)\n    candidates: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(mask, connectivity=8):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        if r0 == 0:\n            candidates.append((r0, c0, r1, c1))\n\n    assert len(candidates) == 1, \"expected one top-edge marker component\"\n    return candidates[0]\n\n\ndef _runs(values: list[int]) -> list[tuple[int, int]]:\n    if not values:\n        return []\n\n    runs: list[tuple[int, int]] = []\n    start = prev = values[0]\n    for value in values[1:]:\n        if value == prev + 1:\n            prev = value\n            continue\n        runs.append((start, prev))\n        start = prev = value\n    runs.append((start, prev))\n    return runs\n\n\ndef _can_slide_right(base: np.ndarray, obstacle: int, bg: int, cols: list[int], marker_bottom_r: int, height: int) -> bool:\n    H, W = base.shape\n    assert cols\n    if cols[-1] + 1 >= W:\n        return False\n\n    for floor_r in range(marker_bottom_r + 1, H):\n        target_rows = np.arange(floor_r - height + 1, floor_r + 1)\n        if int(target_rows[0]) < 0:\n            continue\n\n        shifted_cols = [c + 1 for c in cols]\n        target_is_clear = all(np.all(base[target_rows, c] == bg) for c in shifted_cols)\n        if not target_is_clear:\n            continue\n\n        for c in cols:\n            if int(base[floor_r, c]) != obstacle:\n                continue\n            has_horizontal_neighbor = (\n                (c > 0 and int(base[floor_r, c - 1]) == obstacle)\n                or (c + 1 < W and int(base[floor_r, c + 1]) == obstacle)\n            )\n            if has_horizontal_neighbor:\n                return True\n\n    return False\n\n\ndef _clear_bottom_edge_gap(base: np.ndarray, out: np.ndarray, obstacle: int, bg: int, c: int, width: int) -> None:\n    H, W = base.shape\n    if int(base[H - 1, c]) != obstacle:\n        return\n\n    c1 = c\n    while c1 < W and int(base[H - 1, c1]) == obstacle:\n        c1 += 1\n\n    if c1 - c >= width:\n        out[H - 1, c + 1 : c + width] = bg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\n    Input structure\n    - The background is the dominant color.\n    - The most numerous non-background color forms stationary grey obstacle pixels.\n    - The other two colors form a single 3x3 top-edge marker whose top two rows\n      are maroon and whose bottom row contains maroon or blue control pixels.\n\n    Rule\n    - Erase the top marker.\n    - Treat each marker column as a vertical drop retaining its three colors.\n    - A column whose bottom control pixel is blue stops immediately above the\n      first grey pixel below that column, or bottom-aligns if none exists.\n    - Contiguous maroon-ended columns pass through obstacles and bottom-align;\n      if such a run has a clear down-right slide from a grey ledge, shift the\n      run one column right before bottom-aligning.\n    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n      the rest of the marker-width gap in that bottom bar.\n\n    Key insight\n    - The bottom row of the top marker is a control strip: blue cells mean\n      \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H = g.shape[0]\n    bg = int(get_bg(g))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 3, \"expected obstacle color plus two marker colors\"\n    obstacle = _unique_largest_count_color(g, non_bg)\n    marker_colors = [color for color in non_bg if color != obstacle]\n    assert len(marker_colors) == 2, \"expected exactly two marker colors\"\n\n    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)\n    marker = g[r0 : r1 + 1, c0 : c1 + 1]\n    marker_h, marker_w = marker.shape\n    assert (marker_h, marker_w) == (3, 3), \"expected a 3x3 marker\"\n    assert np.all(np.isin(marker, marker_colors)), \"marker bbox must contain only marker colors\"\n\n    pass_color = int(marker[0, 0])\n    assert np.all(marker[:2, :] == pass_color), \"top two marker rows must be the pass-through color\"\n    stop_colors = [color for color in marker_colors if color != pass_color]\n    assert len(stop_colors) == 1, \"expected one stop color\"\n    stop_color = stop_colors[0]\n\n    out = g.copy()\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    base = out.copy()\n\n    pass_columns: list[int] = []\n    for j in range(marker_w):\n        c = c0 + j\n        stack = marker[:, j]\n        bottom_control = int(stack[-1])\n\n        if bottom_control == stop_color:\n            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n            if len(obstacles_below):\n                floor_r = int(r1 + 1 + obstacles_below[0])\n                top_r = floor_r - marker_h\n            else:\n                top_r = H - marker_h\n            assert top_r >= 0, \"stopped column must fit above its obstacle\"\n            out[top_r : top_r + marker_h, c] = stack\n        else:\n            assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n            pass_columns.append(j)\n\n    for start_j, end_j in _runs(pass_columns):\n        source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n        top_r = H - marker_h\n\n        for j in range(start_j, end_j + 1):\n            c = c0 + j + shift\n            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n            out[top_r : top_r + marker_h, c] = marker[:, j]\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\nGRID_SIZE_RANGE = (14, 16)\nMARKER_SIZE = 3\nSTOP_COUNT_RANGE = (1, 3)\nOBSTACLE_COMPONENT_RANGE = (7, 9)\nOBSTACLE_PIXEL_RANGE = (20, 31)\nCOMPONENT_SIZE_RANGE = (1, 11)\nMIN_STOP_OBSTACLE_ROW = 6\nDROP_ZONE_HEIGHT = 3\nCOMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300\n\n\ndef _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:\n    grid = np.full((H, W), GEN_BG, dtype=int)\n    c0 = random.randint(0, W - MARKER_SIZE)\n    num_stops = random.randint(*STOP_COUNT_RANGE)\n    positions = list(range(MARKER_SIZE))\n    random.shuffle(positions)\n    stop_positions = sorted(positions[:num_stops])\n    marker = np.full((MARKER_SIZE, MARKER_SIZE), GEN_PASS, dtype=int)\n    for j in stop_positions:\n        marker[MARKER_SIZE - 1, j] = GEN_STOP\n    grid[0:MARKER_SIZE, c0:c0 + MARKER_SIZE] = marker\n    obstacle_pixels: set[tuple[int, int]] = set()\n    for j in stop_positions:\n        col = c0 + j\n        first_obs_row = random.randint(MIN_STOP_OBSTACLE_ROW, H - 1)\n        grid[first_obs_row, col] = GEN_OBSTACLE\n        obstacle_pixels.add((first_obs_row, col))\n    return grid, c0, stop_positions, obstacle_pixels\n\n\ndef _forbidden_cells(H: int, c0: int, stop_positions: list[int], obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]]:\n    forbidden = {(r, c) for r in range(MARKER_SIZE) for c in range(c0, c0 + MARKER_SIZE)}\n    for j in stop_positions:\n        col = c0 + j\n        for r in range(MARKER_SIZE, H):\n            if (r, col) not in obstacle_pixels:\n                continue\n            for dr in range(1, DROP_ZONE_HEIGHT + 1):\n                if r - dr >= 0:\n                    forbidden.add((r - dr, col))\n            break\n    return forbidden\n\n\ndef _sample_component_sizes(total_pixels: int, component_count: int) -> list[int] | None:\n    component_sizes = []\n    left = total_pixels\n    min_size, max_size = COMPONENT_SIZE_RANGE\n    for i in range(component_count):\n        remaining = component_count - i - 1\n        if remaining == 0:\n            size = left\n        else:\n            lo = max(min_size, left - max_size * remaining)\n            hi = min(max_size, left - min_size * remaining)\n            if lo > hi:\n                return None\n            size = random.randint(lo, hi)\n        left -= size\n        if size < min_size or size > max_size:\n            return None\n        component_sizes.append(size)\n    random.shuffle(component_sizes)\n    return component_sizes\n\n\ndef _grow_component(grid: np.ndarray, comp_size: int, forbidden: set[tuple[int, int]],\n                    obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]] | None:\n    H, W = grid.shape\n    sr, sc = random.randint(0, H - 1), random.randint(0, W - 1)\n    if (sr, sc) in forbidden or (sr, sc) in obstacle_pixels or grid[sr, sc] != GEN_BG:\n        return None\n\n    comp = {(sr, sc)}\n    frontier = [(sr, sc)]\n    while len(comp) < comp_size and frontier:\n        random.shuffle(frontier)\n        expanded = False\n        for fr, fc in frontier:\n            nbrs = [(fr - 1, fc), (fr + 1, fc), (fr, fc - 1), (fr, fc + 1)]\n            random.shuffle(nbrs)\n            for nr, nc in nbrs:\n                if (0 <= nr < H and 0 <= nc < W\n                        and (nr, nc) not in forbidden\n                        and (nr, nc) not in obstacle_pixels\n                        and (nr, nc) not in comp\n                        and grid[nr, nc] == GEN_BG):\n                    comp.add((nr, nc))\n                    frontier.append((nr, nc))\n                    expanded = True\n                    break\n            if expanded:\n                break\n        if not expanded:\n            break\n    return comp if len(comp) == comp_size else None\n\n\ndef _place_obstacle_components(grid: np.ndarray, component_sizes: list[int], forbidden: set[tuple[int, int]],\n                               obstacle_pixels: set[tuple[int, int]]) -> bool:\n    for comp_size in component_sizes:\n        placed = False\n        for _ in range(COMPONENT_PLACEMENT_ATTEMPTS):\n            comp = _grow_component(grid, comp_size, forbidden, obstacle_pixels)\n            if comp is None:\n                continue\n            if any((pr + dr, pc + dc) in obstacle_pixels\n                   for pr, pc in comp for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]):\n                continue\n            for pr, pc in comp:\n                grid[pr, pc] = GEN_OBSTACLE\n                obstacle_pixels.add((pr, pc))\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n\n\ndef _scatter_obstacles(grid: np.ndarray, c0: int, stop_positions: list[int],\n                       obstacle_pixels: set[tuple[int, int]]) -> bool:\n    H, _W = grid.shape\n    num_target_components = random.randint(*OBSTACLE_COMPONENT_RANGE)\n    total_target_pixels = random.randint(*OBSTACLE_PIXEL_RANGE)\n    remaining_pixels = max(0, total_target_pixels - len(obstacle_pixels))\n    remaining_components = max(1, num_target_components - len(stop_positions))\n    if remaining_pixels <= 0 or remaining_components <= 0:\n        return True\n\n    component_sizes = _sample_component_sizes(remaining_pixels, remaining_components)\n    if component_sizes is None:\n        return False\n    forbidden = _forbidden_cells(H, c0, stop_positions, obstacle_pixels)\n    return _place_obstacle_components(grid, component_sizes, forbidden, obstacle_pixels)\n\n\ndef _has_clear_stop_drop_zones(grid: np.ndarray, c0: int, stop_positions: list[int]) -> bool:\n    H, _W = grid.shape\n    for j in stop_positions:\n        col = c0 + j\n        first_obs = next((r for r in range(MARKER_SIZE, H) if grid[r, col] == GEN_OBSTACLE), None)\n        if first_obs is None:\n            return False\n        for dr in range(1, DROP_ZONE_HEIGHT + 1):\n            if first_obs - dr < 0 or grid[first_obs - dr, col] != GEN_BG:\n                return False\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(*GRID_SIZE_RANGE)\n    W = random.randint(*GRID_SIZE_RANGE)\n    grid, c0, stop_positions, obstacle_pixels = _init_scene(H, W)\n\n    if not _scatter_obstacles(grid, c0, stop_positions, obstacle_pixels):\n        return None\n    if not _has_clear_stop_drop_zones(grid, c0, stop_positions):\n        return None\n    obs_comps = [c for c in find_components(grid, bg=GEN_BG, connectivity=4, monochromatic=True)\n                 if c['color'] == GEN_OBSTACLE]\n    if not (OBSTACLE_COMPONENT_RANGE[0] <= len(obs_comps) <= OBSTACLE_COMPONENT_RANGE[1]):\n        return None\n\n    # Run solver to verify no assertion failures\n    try:\n        main(grid)\n    except Exception:\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
