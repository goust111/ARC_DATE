{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, components_mask, get_bg\nimport random\n\n\nAxis = tuple[int, str, int]\n\n\ndef _find_reflection_axis(g: np.ndarray, bg: int) -> Axis:\n    h, w = g.shape\n    candidates: list[Axis] = []\n\n    for color in colors_present(g, exclude={bg}):\n        mask = g == color\n        count = int(mask.sum())\n\n        if count == w:\n            for r in np.flatnonzero(mask.all(axis=1)):\n                candidates.append((int(color), \"row\", int(r)))\n\n        if count == h:\n            for c in np.flatnonzero(mask.all(axis=0)):\n                candidates.append((int(color), \"col\", int(c)))\n\n        if h == w and count == h:\n            main_diag = np.eye(h, dtype=bool)\n            anti_diag = np.fliplr(main_diag)\n            if np.all(mask[main_diag]):\n                candidates.append((int(color), \"main_diag\", 0))\n            if np.all(mask[anti_diag]):\n                candidates.append((int(color), \"anti_diag\", 0))\n\n    assert len(candidates) == 1, \"expected exactly one full straight reflection axis\"\n    return candidates[0]\n\n\ndef _reflect(axis: Axis, shape: tuple[int, int], r: int, c: int) -> tuple[int, int]:\n    _axis_color, kind, index = axis\n    h, w = shape\n\n    if kind == \"row\":\n        return 2 * index - r, c\n    if kind == \"col\":\n        return r, 2 * index - c\n    if kind == \"main_diag\":\n        assert h == w, \"diagonal reflection axis requires a square grid\"\n        return c, r\n    if kind == \"anti_diag\":\n        assert h == w, \"diagonal reflection axis requires a square grid\"\n        return h - 1 - c, w - 1 - r\n\n    raise AssertionError(f\"unknown axis kind: {kind}\")\n\n\ndef _smallest_non_axis_color(g: np.ndarray, bg: int, axis_color: int) -> int:\n    areas = {\n        int(color): int(np.count_nonzero(g == color))\n        for color in colors_present(g, exclude={bg, axis_color})\n    }\n    assert len(areas) >= 2, \"expected at least two non-axis foreground colors\"\n\n    min_area = min(areas.values())\n    colors = [color for color, area in areas.items() if area == min_area]\n    assert len(colors) == 1, \"smallest non-axis foreground color must be unique\"\n    return colors[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Mirror the smallest non-axis foreground color across the full straight axis.\n\n    Input structure\n    - The background is the dominant color.\n    - One foreground color forms exactly one full row, column, main diagonal, or anti-diagonal reflection axis.\n    - The remaining foreground colors include a unique least-populated color to copy.\n\n    Rule\n    - Preserve the input grid.\n    - Select every pixel of the unique smallest non-axis foreground color.\n    - Reflect those pixels across the full straight axis and paint the reflected positions with the same color.\n\n    Key insight\n    - The axis color marks the mirror line, while the color population chooses which set of objects is duplicated.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.size > 0, \"expected a non-empty 2D grid\"\n\n    bg = get_bg(g)\n    axis = _find_reflection_axis(g, bg)\n    axis_color = axis[0]\n    mirror_color = _smallest_non_axis_color(g, bg, axis_color)\n\n    out = g.copy()\n    h, w = g.shape\n    for r_raw, c_raw in np.argwhere(g == mirror_color):\n        r = int(r_raw)\n        c = int(c_raw)\n        rr, cc = _reflect(axis, g.shape, r, c)\n        assert 0 <= rr < h and 0 <= cc < w, \"reflected pixel must stay inside the grid\"\n        assert int(out[rr, cc]) in {bg, mirror_color}, \"reflection cannot overwrite another foreground object\"\n        out[rr, cc] = mirror_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n# Canvas and axis options.\n_GEN_GRID_SIZE_RANGE = (9, 17)\n_GEN_ODD_GRID_SIZES = [9, 11, 13, 15, 17]\n_GEN_AXIS_KINDS = [\"row\", \"col\", \"main_diag\", \"anti_diag\"]\n_GEN_CENTER_AXIS_KINDS = {\"row\", \"col\"}\n_GEN_SIDE_COUNT = 2\n# Foreground component size and count bounds.\n_GEN_COMPONENT_COUNT_RANGE = range(1, 4)\n_GEN_MIRROR_TOTAL_RANGE = (4, 12)\n_GEN_MIRROR_COMPONENT_SIZE_RANGE = (2, 7)\n_GEN_NONMIRROR_TOTAL_RANGE = (5, 17)\n_GEN_NONMIRROR_COMPONENT_SIZE_RANGE = (3, 9)\n_GEN_MIN_NONMIRROR_RATIO = (5, 4)\n_GEN_MAX_NONMIRROR_MULTIPLIER = 2\n# Search and geometry primitives.\n_GEN_RETRY_LIMIT = 300\n_GEN_COLORS = list(range(10))\n_GEN_DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\ndef _gen_draw_axis(grid: np.ndarray, axis_kind: str, color: int) -> None:\n    n = grid.shape[0]\n    if axis_kind == \"row\":\n        grid[n // 2, :] = color\n    elif axis_kind == \"col\":\n        grid[:, n // 2] = color\n    elif axis_kind == \"main_diag\":\n        np.fill_diagonal(grid, color)\n    else:\n        np.fill_diagonal(np.fliplr(grid), color)\n\n\ndef _gen_side_mask(n: int, axis_kind: str, side: int) -> np.ndarray:\n    rr, cc = np.indices((n, n))\n    if axis_kind == \"row\":\n        return rr < n // 2 if side == 0 else rr > n // 2\n    if axis_kind == \"col\":\n        return cc < n // 2 if side == 0 else cc > n // 2\n    if axis_kind == \"main_diag\":\n        return cc > rr if side == 0 else cc < rr\n    return rr + cc < n - 1 if side == 0 else rr + cc > n - 1\n\n\ndef _gen_reflect(axis_kind: str, n: int, r: int, c: int) -> tuple[int, int]:\n    if axis_kind == \"row\":\n        return n - 1 - r, c\n    if axis_kind == \"col\":\n        return r, n - 1 - c\n    if axis_kind == \"main_diag\":\n        return c, r\n    return n - 1 - c, n - 1 - r\n\n\ndef _gen_feasible_counts(total: int, lo: int, hi: int) -> list[int]:\n    return [count for count in _GEN_COMPONENT_COUNT_RANGE if count * lo <= total <= count * hi]\n\n\ndef _gen_partition(total: int, count: int, lo: int, hi: int) -> list[int]:\n    sizes = []\n    remaining = total\n    for idx in range(count):\n        left = count - idx - 1\n        cur_lo = max(lo, remaining - left * hi)\n        cur_hi = min(hi, remaining - left * lo)\n        size = random.randint(cur_lo, cur_hi)\n        sizes.append(size)\n        remaining -= size\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _gen_pick_component_sizes() -> tuple[list[int], list[int]]:\n    mirror_total = random.randint(*_GEN_MIRROR_TOTAL_RANGE)\n    ratio_num, ratio_den = _GEN_MIN_NONMIRROR_RATIO\n    nonmirror_lo = max(\n        _GEN_NONMIRROR_TOTAL_RANGE[0],\n        (ratio_num * mirror_total + ratio_den - 1) // ratio_den,\n    )\n    nonmirror_hi = min(_GEN_NONMIRROR_TOTAL_RANGE[1], _GEN_MAX_NONMIRROR_MULTIPLIER * mirror_total)\n    nonmirror_total = random.randint(nonmirror_lo, nonmirror_hi)\n\n    mirror_count = random.choice(_gen_feasible_counts(mirror_total, *_GEN_MIRROR_COMPONENT_SIZE_RANGE))\n    nonmirror_count = random.choice(_gen_feasible_counts(nonmirror_total, *_GEN_NONMIRROR_COMPONENT_SIZE_RANGE))\n    mirror_sizes = _gen_partition(mirror_total, mirror_count, *_GEN_MIRROR_COMPONENT_SIZE_RANGE)\n    nonmirror_sizes = _gen_partition(nonmirror_total, nonmirror_count, *_GEN_NONMIRROR_COMPONENT_SIZE_RANGE)\n    return mirror_sizes, nonmirror_sizes\n\n\ndef _gen_mark_neighbors(blocked: np.ndarray, coords: np.ndarray) -> None:\n    n = blocked.shape[0]\n    for r_raw, c_raw in coords:\n        r = int(r_raw)\n        c = int(c_raw)\n        blocked[r, c] = True\n        for dr, dc in _GEN_DIRS4:\n            rr = r + dr\n            cc = c + dc\n            if 0 <= rr < n and 0 <= cc < n:\n                blocked[rr, cc] = True\n\n\ndef _gen_grow_component(\n    side_mask: np.ndarray, occupied: np.ndarray, same_color_blocked: np.ndarray, size: int\n) -> np.ndarray | None:\n    available = side_mask & ~occupied & ~same_color_blocked\n    choices = [coords for coords in components_mask(available, connectivity=4) if len(coords) >= size]\n    if not choices:\n        return None\n\n    region = random.choice(choices)\n    seed = tuple(int(x) for x in region[random.randrange(len(region))])\n    selected = {seed}\n    frontier: set[tuple[int, int]] = set()\n    n = available.shape[0]\n\n    def add_frontier(r: int, c: int) -> None:\n        for dr, dc in _GEN_DIRS4:\n            rr = r + dr\n            cc = c + dc\n            if 0 <= rr < n and 0 <= cc < n and available[rr, cc] and (rr, cc) not in selected:\n                frontier.add((rr, cc))\n\n    add_frontier(*seed)\n    while len(selected) < size:\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        selected.add(cell)\n        add_frontier(*cell)\n\n    return np.array(list(selected), dtype=int)\n\n\ndef _gen_place_components(\n    grid: np.ndarray,\n    side_mask: np.ndarray,\n    occupied: np.ndarray,\n    color: int,\n    sizes: list[int],\n) -> list[tuple[int, int]] | None:\n    same_color_blocked = np.zeros_like(occupied, dtype=bool)\n    placed: list[tuple[int, int]] = []\n    for size in sizes:\n        coords = _gen_grow_component(side_mask, occupied, same_color_blocked, size)\n        if coords is None:\n            return None\n        grid[coords[:, 0], coords[:, 1]] = color\n        occupied[coords[:, 0], coords[:, 1]] = True\n        _gen_mark_neighbors(same_color_blocked, coords)\n        placed.extend((int(r), int(c)) for r, c in coords)\n    return placed\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/b74ca5d1.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import defaultdict\nfrom typing import NamedTuple\nfrom numpy.random import default_rng\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg\n\n\nclass Sprite(NamedTuple):\n    body: int\n    marker: int\n    top: int\n    left: int\n    marker_rc: tuple[int, int]\n    mask: np.ndarray\n    body_mask: np.ndarray\n\n\ndef _corners(h: int, w: int) -> list[tuple[int, int]]:\n    return [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]\n\n\ndef _corner_labels(g: np.ndarray, bg: int) -> tuple[set[int], dict[int, tuple[int, int]]]:\n    labels: set[int] = set()\n    label_corner: dict[int, tuple[int, int]] = {}\n    h, w = g.shape\n    for r, c in _corners(h, w):\n        color = int(g[r, c])\n        if color == bg:\n            continue\n        assert color not in label_corner, \"each marker color must appear in exactly one corner\"\n        labels.add(color)\n        label_corner[color] = (r, c)\n    assert labels, \"expected at least one corner marker\"\n    return labels, label_corner\n\n\ndef _find_sprites(g: np.ndarray, bg: int, labels: set[int]) -> list[Sprite]:\n    h, w = g.shape\n    sprites: list[Sprite] = []\n    body_colors = set(colors_present(g, exclude={bg})) - labels\n    assert body_colors, \"expected non-corner body colors\"\n\n    for body in sorted(body_colors):\n        body_pts = np.argwhere(g == body)\n        assert body_pts.size, \"body color must be present\"\n        r0, c0 = body_pts.min(axis=0)\n        r1, c1 = body_pts.max(axis=0)\n        assert r1 - r0 < 5 and c1 - c0 < 5, \"each body color must fit in one 5x5 window\"\n\n        candidates: list[Sprite] = []\n        top_min = max(0, int(r1) - 4)\n        top_max = min(int(r0), h - 5)\n        left_min = max(0, int(c1) - 4)\n        left_max = min(int(c0), w - 5)\n        for top in range(top_min, top_max + 1):\n            for left in range(left_min, left_max + 1):\n                window = g[top : top + 5, left : left + 5]\n                other_colors = set(colors_present(window, exclude={bg, body}))\n                if len(other_colors) != 1:\n                    continue\n                marker = other_colors.pop()\n                if marker not in labels:\n                    continue\n                if int(np.count_nonzero(window == marker)) != 1:\n                    continue\n                if int(np.count_nonzero(window == body)) != len(body_pts):\n                    continue\n\n                marker_pos = np.argwhere(window == marker)\n                assert len(marker_pos) == 1\n                mr, mc = map(int, marker_pos[0])\n                candidates.append(\n                    Sprite(\n                        body=int(body),\n                        marker=int(marker),\n                        top=int(top),\n                        left=int(left),\n                        marker_rc=(mr, mc),\n                        mask=window != bg,\n                        body_mask=window == body,\n                    )\n                )\n\n        assert len(candidates) == 1, \"each body color must define a unique marked 5x5 sprite\"\n        sprites.append(candidates[0])\n\n    return sprites\n\n\ndef _owner_sets(group: list[Sprite]) -> list[list[set[int]]]:\n    owners = [[set() for _c in range(5)] for _r in range(5)]\n    for i, sprite in enumerate(group):\n        for r, c in np.argwhere(sprite.mask):\n            owners[int(r)][int(c)].add(i)\n    return owners\n\n\ndef _run_reaches_target_edge(\n    owners: list[list[set[int]]], owner: int, r: int, c: int, *, top_corner: bool\n) -> bool:\n    if top_corner:\n        rr = r\n        while rr >= 0 and owner in owners[rr][c]:\n            rr -= 1\n        return rr == -1\n\n    rr = r\n    while rr < 5 and owner in owners[rr][c]:\n        rr += 1\n    return rr == 5\n\n\ndef _corner_composite_mask(group: list[Sprite], *, top_corner: bool) -> np.ndarray:\n    owners = _owner_sets(group)\n    keep = np.array([[bool(owners[r][c]) for c in range(5)] for r in range(5)], dtype=bool)\n\n    # A one-sprite vertical tail hidden behind horizontal neighbors from other sprites\n    # is not part of the visible composite unless that run reaches the target edge.\n    if top_corner:\n        rows = range(1, 4)\n        away_step = 1\n        toward = lambda r: r - 1\n        in_bounds = lambda r: r < 5\n    else:\n        rows = range(3, 0, -1)\n        away_step = -1\n        toward = lambda r: r + 1\n        in_bounds = lambda r: r >= 0\n\n    for r in rows:\n        for c in range(1, 4):\n            if not keep[r, c] or len(owners[r][c]) != 1:\n                continue\n            owner = next(iter(owners[r][c]))\n            if _run_reaches_target_edge(owners, owner, r, c, top_corner=top_corner):\n                continue\n            if owner not in owners[toward(r)][c]:\n                continue\n            if not owners[r][c - 1] or not owners[r][c + 1]:\n                continue\n            if owner in owners[r][c - 1] or owner in owners[r][c + 1]:\n                continue\n\n            rr = r\n            while in_bounds(rr) and keep[rr, c] and owners[rr][c] == {owner}:\n                keep[rr, c] = False\n                rr += away_step\n\n    return keep\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swap each 5x5 sprite with its corner marker color and stamp same-marker composite masks into the matching corner.\n\n    Input structure:\n    - A 30x30 grid has one dominant background color.\n    - Non-background corner pixels are marker labels.\n    - Every other foreground color is the body of one 5x5 sprite containing exactly one pixel of a corner marker color.\n\n    Rule:\n    - For each sprite, recolor body pixels to the sprite marker color and recolor the marker pixel back to its body color.\n    - If a marker lies on the side facing its matching corner and another same-marker sprite has a body pixel at that same local cell, use that visible body color for the marker pixel.\n    - For each corner marker, overlay the masks of all sprites with that marker color into the corner 5x5 block and paint the visible composite with the marker color.\n\n    Key insight:\n    The corner pixels are labels that group 5x5 sprites by their embedded marker color; each labeled corner shows the grouped sprite silhouette.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = int(get_bg(g))\n    labels, label_corner = _corner_labels(g, bg)\n    sprites = _find_sprites(g, bg, labels)\n\n    by_marker: dict[int, list[Sprite]] = defaultdict(list)\n    for sprite in sprites:\n        by_marker[sprite.marker].append(sprite)\n\n    out = g.copy()\n    for sprite in sprites:\n        window = g[sprite.top : sprite.top + 5, sprite.left : sprite.left + 5]\n        patch = out[sprite.top : sprite.top + 5, sprite.left : sprite.left + 5]\n        patch[window == sprite.body] = sprite.marker\n\n        mr, mc = sprite.marker_rc\n        replacement = sprite.body\n        _corner_r, corner_c = label_corner[sprite.marker]\n        side_col = 0 if corner_c == 0 else 4\n        if mc == side_col:\n            overlaps = [\n                other.body\n                for other in by_marker[sprite.marker]\n                if other is not sprite and bool(other.body_mask[mr, mc])\n            ]\n            if overlaps:\n                assert len(overlaps) == 1, \"side marker overlap must identify one visible body color\"\n                replacement = overlaps[0]\n        patch[mr, mc] = replacement\n\n    for r, c in _corners(h, w):\n        label = int(g[r, c])\n        if label == bg:\n            continue\n        group = by_marker[label]\n        assert group, \"each corner marker must have at least one matching sprite\"\n        mask = _corner_composite_mask(group, top_corner=(r == 0))\n        rows = slice(0, 5) if r == 0 else slice(h - 5, h)\n        cols = slice(0, 5) if c == 0 else slice(w - 5, w)\n        patch = out[rows, cols]\n        patch[mask] = label\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and sprite geometry.\nGRID_H = 30\nGRID_W = 30\nSPRITE_SIZE = 5\nPLACEMENT_GAP = 1\n\n# Marker and sprite counts.\nNUM_CORNERS_OPTIONS = (2, 3)\nNUM_SPRITES_OPTIONS = (4, 5)\nMIN_GROUP_SPRITES = 1\nMAX_GROUP_SPRITES = 3\n\n# Sprite mask sampling: foreground includes the one marker pixel.\nMIN_BODY_PIXELS = 4\nMAX_BODY_PIXELS = 15\nMIN_FOREGROUND_PIXELS = MIN_BODY_PIXELS + 1\nMAX_FOREGROUND_PIXELS_EXCLUSIVE = MAX_BODY_PIXELS + 2\n\n# Retry budgets.\nDISTRIBUTION_ATTEMPTS = 100\nSPRITE_MASK_ATTEMPTS = 200\nGENERATE_ATTEMPTS = 300\n\nARC_COLORS = list(range(10))\nCORNER_POSITIONS = (\n    (0, 0),\n    (0, GRID_W - 1),\n    (GRID_H - 1, 0),\n    (GRID_H - 1, GRID_W - 1),\n)\nSPRITE_CELLS = [(r, c) for r in range(SPRITE_SIZE) for c in range(SPRITE_SIZE)]\n\n\ndef _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:\n    \"\"\"Generate a single valid input grid for the b74ca5d1 task.\"\"\"\n    all_colors = ARC_COLORS.copy()\n    rng.shuffle(all_colors)\n    bg = all_colors[0]\n\n    num_corners = rng.choice(NUM_CORNERS_OPTIONS)\n    chosen_corner_indices = rng.choice(4, size=num_corners, replace=False)\n","exit_code":0,"status":"completed"}}
