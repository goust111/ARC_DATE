{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/f0f8a26d.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/f0f8a26d.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate every foreground bar 90 degrees around its own center on the same canvas.\n\n    Input structure\n    The background is the dominant color, and all foreground pixels share one color.\n    Each 4-connected foreground object is a solid one-cell-thick horizontal or vertical\n    bar with odd length, with single-pixel bars allowed.\n\n    Rule\n    Clear the canvas to the background, then redraw every bar with its midpoint, length,\n    and color preserved while swapping horizontal and vertical orientation.\n\n    Key insight\n    The bars are independent objects: their centers and lengths identify the output\n    placement, so no matching, ordering, or global symmetry is needed.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n\n    out = np.full_like(g, bg)\n    h, w = g.shape\n    components = find_components(\n        g,\n        bg=bg,\n        connectivity=4,\n        monochromatic=True,\n        colors=fg_colors,\n    )\n    assert components\n\n    for comp in components:\n        color = int(comp[\"color\"])\n        for r, c in _rotated_bar_coords(comp[\"coords\"]):\n            assert 0 <= r < h and 0 <= c < w\n            assert out[r, c] == bg\n            out[r, c] = color\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# Palette and canvas options.\nBG_COLOR = 7\nFG_COLORS = tuple(c for c in range(10) if c != BG_COLOR)\nGRID_SIDES = (9, 11, 13)\n\n# Bar counts and weighted odd-length sampling.\nMIN_BARS, EXTRA_LENGTH_CANDIDATES = 5, 5\nMAX_BARS_BY_SIDE = {9: 6, 11: 8, 13: 10}\nLENGTH_WEIGHT_BY_SIZE = {1: 8, 3: 56, 5: 26, 7: 6, 9: 3}\nDEFAULT_LENGTH_WEIGHT = 1\nORIENTATIONS = (\"H\", \"V\")\n\n# Retry and placement search limits.\nOUTER_ATTEMPTS, INNER_ATTEMPTS = 10, 50\nCENTER_TRIAL_LIMIT = 80\n\ndef _sample_lengths(N, K):\n    possible_lengths = list(range(1, N + 1, 2))\n    weights = [LENGTH_WEIGHT_BY_SIZE.get(l, DEFAULT_LENGTH_WEIGHT) for l in possible_lengths]\n    lengths = random.choices(possible_lengths, weights=weights, k=K + EXTRA_LENGTH_CANDIDATES)\n    lengths.sort(reverse=True)\n    return lengths\n\ndef _bar_pixels(cr, cc, length, orient):\n    half = length // 2\n    if orient == \"H\":\n        return {(cr, cc + d) for d in range(-half, half + 1)}\n    return {(cr + d, cc) for d in range(-half, half + 1)}\n\ndef _place_one_bar(N, length, occupied):\n    \"\"\"Return input pixels for one placed bar, mutating occupied on success.\"\"\"\n    half = length // 2\n    lo, hi = half, N - 1 - half\n    if lo > hi:\n        return None\n    orient = random.choice(ORIENTATIONS)\n    out_orient = \"V\" if orient == \"H\" else \"H\"\n    candidates = [(r, c) for r in range(lo, hi + 1) for c in range(lo, hi + 1)]\n    random.shuffle(candidates)\n\n    for cr, cc in candidates[:CENTER_TRIAL_LIMIT]:\n        inp_pixels = _bar_pixels(cr, cc, length, orient)\n        out_pixels = _bar_pixels(cr, cc, length, out_orient)\n        footprint = inp_pixels | out_pixels\n        if footprint & occupied:\n            continue\n        occupied |= footprint\n        return inp_pixels\n    return None\n\ndef _place_bars(N, K):\n    occupied = set()\n    bars_input = []\n    for length in _sample_lengths(N, K):\n        if len(bars_input) >= K:\n            break\n        inp_pixels = _place_one_bar(N, length, occupied)\n        if inp_pixels is not None:\n            bars_input.append(inp_pixels)\n    return bars_input if len(bars_input) >= K else None\n\ndef _gen_attempt(N: int, K: int) -> np.ndarray | None:\n    fg = random.choice(FG_COLORS)\n    bars_input = _place_bars(N, K)\n    if bars_input is None:\n        return None\n\n    grid = np.full((N, N), BG_COLOR, dtype=int)\n    for bar_pixels in bars_input:\n        for r, c in bar_pixels:\n            grid[r, c] = fg\n\n    try:\n        main(grid)\n    except Exception:\n        return None\n    return grid\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect framed squares via colored bridges following a control-pixel sequence.\n\n    Input structure:\n    - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.\n    - Control row below squares: colored pixels read left-to-right encode visitation order.\n\n    Rule:\n    - Start at the square matching first control color c0.\n    - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.\n    - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.\n\n    Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # border color = most common non-bg color\n    cnt = Counter(map(int, g.flatten()))\n    border = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            border = int(col)\n            break\n    assert not (border is None)\n\n    # detect framed squares as connected components of the border color\n    lab, n = label_mask(g == int(border), connectivity=4)\n    frames: list[dict] = []\n    for cid in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(cid))\n        if int(pts.shape[0]) < 8:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        if h < 3 or w < 3:\n            continue\n\n        t = None\n        inner_col = None\n        for tt in range(1, int(min(h, w) // 2) + 1):\n            inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]\n            if inner.size == 0:\n                continue\n            if bool((inner == int(border)).any()):\n                continue\n            u = set(map(int, inner.flatten()))\n            if len(u) != 1:\n                continue\n\n            ok = True\n            if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not ok:\n                continue\n\n            t = int(tt)\n            inner_col = int(next(iter(u)))\n            break\n\n        if t is None or inner_col is None:\n            continue\n\n        frames.append(\n            {\n                \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n                \"t\": int(t),\n                \"inner\": int(inner_col),\n                \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            }\n        )\n\n    assert not (not frames)\n\n    by: dict[int, list[dict]] = defaultdict(list)\n    for f in frames:\n        by[int(f[\"inner\"])].append(f)\n\n    max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n\n    # control row = bottom-most row below the squares with >=2 non-bg pixels\n    ctrl_r = None\n    for r in range(int(H - 1), int(max_frame_r), -1):\n        if int((g[int(r)] != int(bg)).sum()) >= 2:\n            ctrl_r = int(r)\n            break\n    assert not (ctrl_r is None)\n\n    ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n    assert not (len(ctrl) < 2)\n\n    def center(f: dict) -> tuple[int, int]:\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        return int((r0 + r1) // 2), int((c0 + c1) // 2)\n\n    def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n        a = f1[\"inner_bbox\"]\n        b = f2[\"inner_bbox\"]\n        same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n        same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))\n        return same_row, same_col\n\n    # choose start frame\n    start_color = int(ctrl[0])\n    assert not (start_color not in by)\n    start_cands = by[start_color]\n    if len(start_cands) == 1:\n        cur = start_cands[0]\n    else:\n        nxt_color = int(ctrl[1])\n        nxt_cands = by.get(nxt_color, [])\n        best = None\n        bestf = None\n        for f in start_cands:\n            for g2 in (nxt_cands if nxt_cands else [f]):\n                sr, sc = aligned(f, g2)\n                al = 1 if (sr or sc) else 0\n                (r1_, c1_) = center(f)\n                (r2_, c2_) = center(g2)\n                d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n                cand = (int(al), -int(d))\n                if best is None or cand > best:\n                    best = cand\n                    bestf = f\n        cur = bestf\n\n    out = g.copy()\n\n    def draw_bridge(fa: dict, fb: dict, color: int) -> None:\n        (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n        (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n        ia = fa[\"inner_bbox\"]\n        sr, sc = aligned(fa, fb)\n        if sr:\n            rr0, rr1 = int(ia[0]), int(ia[2])\n            if int(c1a) < int(c0b):\n                cc0, cc1 = int(c1a + 1), int(c0b - 1)\n            else:\n                cc0, cc1 = int(c1b + 1), int(c0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n            return\n        if sc:\n            cc0, cc1 = int(ia[1]), int(ia[3])\n            if int(r1a) < int(r0b):\n                rr0, rr1 = int(r1a + 1), int(r0b - 1)\n            else:\n                rr0, rr1 = int(r1b + 1), int(r0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n\n    for i in range(int(len(ctrl)) - 1):\n        a = int(ctrl[i])\n        b = int(ctrl[i + 1])\n        assert int(cur[\"inner\"]) == int(a)\n        assert b in by, f\"control color {b} has no matching frame\"\n        cands = by[b]\n        best = None\n        bestf = None\n        for f in cands:\n            sr, sc = aligned(cur, f)\n            al = 1 if (sr or sc) else 0\n            (r1_, c1_) = center(cur)\n            (r2_, c2_) = center(f)\n            d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n            cand = (int(al), -int(d))\n            if best is None or cand > best:\n                best = cand\n                bestf = f\n        nxt = bestf\n        draw_bridge(cur, nxt, int(a))\n        cur = nxt\n\n    return out\n\n\ndef _most_common_nonbg(g: np.ndarray, bg: int) -> int | None:\n    cnt = Counter(map(int, g.flatten()))\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            return int(col)\n    return None\n\ndef _draw_frame(g: np.ndarray, *, r0: int, c0: int, outer: int, t: int, border: int, inner_col: int) -> None:\n    g[int(r0) : int(r0 + outer), int(c0) : int(c0 + outer)] = int(border)\n    g[int(r0 + t) : int(r0 + outer - t), int(c0 + t) : int(c0 + outer - t)] = int(inner_col)\n\ndef _bridge_cells(fa: dict, fb: dict) -> set[tuple[int, int]]:\n    (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n    (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n    ia = fa[\"inner_bbox\"]\n    ib = fb[\"inner_bbox\"]\n    # same-row band\n    if int(ia[0]) == int(ib[0]) and int(ia[2]) == int(ib[2]):\n        rr0, rr1 = int(ia[0]), int(ia[2])\n        if int(c1a) < int(c0b):\n            cc0, cc1 = int(c1a + 1), int(c0b - 1)\n        else:\n            cc0, cc1 = int(c1b + 1), int(c0a - 1)\n        assert int(cc0) <= int(cc1), \"horizontal bridge gap must be non-empty\"\n        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n    # same-col band\n    if int(ia[1]) == int(ib[1]) and int(ia[3]) == int(ib[3]):\n        cc0, cc1 = int(ia[1]), int(ia[3])\n        if int(r1a) < int(r0b):\n            rr0, rr1 = int(r1a + 1), int(r0b - 1)\n        else:\n            rr0, rr1 = int(r1b + 1), int(r0a - 1)\n        assert int(rr0) <= int(rr1), \"vertical bridge gap must be non-empty\"\n        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n    return set()\n\n_DIGITS = [int(i) for i in range(10)]\n\ndef _gen_attempt() -> np.ndarray | None:\n    # --- colors ---\n    bg = int(np.random.choice(np.array(_DIGITS, dtype=int)))\n    border = int(np.random.choice(np.array([d for d in _DIGITS if int(d) != int(bg)], dtype=int)))\n    inner_palette = [int(d) for d in _DIGITS if int(d) not in (int(bg), int(border))]\n    if len(inner_palette) < 3:\n        return None\n\n    # --- geometry ---\n    t = int(np.random.choice(np.array([1, 1, 2], dtype=int)))\n    inner = int(np.random.randint(1, 4))  # 1..3\n    outer = int(inner + 2 * t)\n    if not (3 <= int(outer) <= 7):\n        return None\n\n    # lattice dims and number of squares (all on the path)\n    R = int(np.random.randint(2, 6))\n    C = int(np.random.randint(2, 6))\n    max_frames = int(R * C)\n    if max_frames < 4:\n        return None\n    n_frames = int(np.random.randint(4, int(min(12, max_frames)) + 1))\n\n    # sample a self-avoiding path of length n_frames starting at (0,0)\n    path: list[tuple[int, int]] | None = None\n    for _path_try in range(400):\n        p = [(0, 0)]\n        vis = {(0, 0)}\n        ok = True\n        for _ in range(int(n_frames) - 1):\n            cur = p[-1]\n            r, c = map(int, cur)\n            opts = [\n                (int(rr), int(cc))\n                for rr, cc in neighbors4(int(r), int(c))\n                if in_bounds((int(R), int(C)), int(rr), int(cc)) and (int(rr), int(cc)) not in vis\n            ]\n            if not opts:\n                ok = False\n                break\n            nxt = opts[int(np.random.randint(0, len(opts)))]\n            p.append((int(nxt[0]), int(nxt[1])))\n            vis.add((int(nxt[0]), int(nxt[1])))\n        if not ok:\n            continue\n        # Prefer scenes that span multiple rows/cols (matches eval's \"lattice\" feel).\n        if len({r for r, _c in p}) < 2 or len({c for _r, c in p}) < 2:\n            continue\n        path = p\n        break\n    if path is None:\n        return None\n\n    # sample uneven row/col gaps (eval-like) but keep at least 1 bg cell separation\n    row_gap = [int(np.random.randint(1, 6)) for _ in range(int(R) - 1)]\n    col_gap = [int(np.random.randint(1, 6)) for _ in range(int(C) - 1)]\n    top_margin = int(np.random.randint(1, 4))\n    left_margin = int(np.random.randint(1, 4))\n\n    r0s = [int(top_margin)]\n    for k in range(int(R) - 1):\n        r0s.append(int(r0s[-1] + outer + row_gap[int(k)]))\n    c0s = [int(left_margin)]\n    for k in range(int(C) - 1):\n        c0s.append(int(c0s[-1] + outer + col_gap[int(k)]))\n\n    # frame dicts (only for visited path cells)\n    slot_to_frame: dict[tuple[int, int], dict] = {}\n    frames: list[dict] = []\n    for rr, cc in path:\n        r0 = int(r0s[int(rr)])\n        c0 = int(c0s[int(cc)])\n        r1 = int(r0 + outer - 1)\n        c1 = int(c0 + outer - 1)\n        f = {\n            \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n            \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            \"slot\": (int(rr), int(cc)),\n        }\n        frames.append(f)\n        slot_to_frame[(int(rr), int(cc))] = f\n\n    max_r1 = max(int(f[\"bbox\"][2]) for f in frames)\n    max_c1 = max(int(f[\"bbox\"][3]) for f in frames)\n\n    ctrl_gap = int(np.random.randint(2, 6))\n    ctrl_r = int(max_r1 + ctrl_gap)\n    bottom_margin = 1  # eval-like: exactly one bg row below control row\n    right_margin = int(np.random.randint(1, 5))\n    H = int(ctrl_r + 1 + bottom_margin)\n    W = int(max_c1 + 1 + right_margin)\n\n    if not (7 <= int(H) <= 30 and 7 <= int(W) <= 30):\n        return None\n\n    # Assign inner colors with row/col uniqueness (in lattice coords).\n    # Force the start (top-left) inner color to be unique globally so main() starts correctly.\n    used_in_row: dict[int, set[int]] = defaultdict(set)\n    used_in_col: dict[int, set[int]] = defaultdict(set)\n\n    start_color = int(np.random.choice(np.array(inner_palette, dtype=int)))\n    colors_by_slot: dict[tuple[int, int], int] = {(0, 0): int(start_color)}\n    used_in_row[0].add(int(start_color))\n    used_in_col[0].add(int(start_color))\n\n    for rr, cc in path[1:]:\n        rr = int(rr)\n        cc = int(cc)\n        forbid = set(used_in_row[int(rr)]) | set(used_in_col[int(cc)]) | {int(start_color)}\n        choices = [int(x) for x in inner_palette if int(x) not in forbid]\n        if not choices:\n            return None\n        col = int(np.random.choice(np.array(choices, dtype=int)))\n        colors_by_slot[(int(rr), int(cc))] = int(col)\n        used_in_row[int(rr)].add(int(col))\n        used_in_col[int(cc)].add(int(col))\n\n    if len(colors_by_slot) != len(path):\n        return None\n\n    # Build virtual output: frames + bridges + control row.\n    out = np.full((int(H), int(W)), int(bg), dtype=int)\n    for f in frames:\n        rr, cc = map(int, f[\"slot\"])\n        r0, c0, _r1, _c1 = map(int, f[\"bbox\"])\n        _draw_frame(out, r0=int(r0), c0=int(c0), outer=int(outer), t=int(t), border=int(border), inner_col=int(colors_by_slot[(rr, cc)]))\n\n    # Bridges follow the 1-touch path.\n    bridge_cells_all: set[tuple[int, int]] = set()\n    ok = True\n    for a_slot, b_slot in zip(path, path[1:]):\n        fa = slot_to_frame[(int(a_slot[0]), int(a_slot[1]))]\n        fb = slot_to_frame[(int(b_slot[0]), int(b_slot[1]))]\n        cells = _bridge_cells(fa, fb)\n        if not cells:\n            ok = False\n            break\n        if cells & bridge_cells_all:\n            ok = False\n            break\n        for r, c in cells:\n            if not (0 <= int(r) < int(H) and 0 <= int(c) < int(W)):\n                ok = False\n                break\n            if int(out[int(r), int(c)]) != int(bg):\n                ok = False\n                break\n        if not ok:\n            break\n        paint = int(colors_by_slot[(int(a_slot[0]), int(a_slot[1]))])\n        for r, c in cells:\n            out[int(r), int(c)] = int(paint)\n        bridge_cells_all |= set(cells)\n\n    if not ok:\n        return None\n\n    # Control row encodes full visitation order. In eval, control pixels are at fixed columns:\n    # 1,3,5,... (gap=2), with bg everywhere else.\n    ctrl_colors = [int(colors_by_slot[(int(r), int(c))]) for r, c in path]\n    if len(ctrl_colors) < 2:\n        return None\n    ctrl_cols = [int(1 + 2 * i) for i in range(int(len(ctrl_colors)))]\n    if int(ctrl_cols[-1]) >= int(W):\n        return None\n    for col, cc in zip(ctrl_colors, ctrl_cols):\n        out[int(ctrl_r), int(cc)] = int(col)\n\n    # Invert to input by erasing bridges.\n    inp = out.copy()\n    for r, c in bridge_cells_all:\n        inp[int(r), int(c)] = int(bg)\n\n    # Ensure bg/border are inferred the way main() expects.\n    if int(get_bg(inp)) != int(bg):\n        return None\n    if int(_most_common_nonbg(inp, int(bg)) or -1) != int(border):\n        return None\n\n    # Validate: running main() on input recreates the virtual output exactly.\n    try:\n        pred = main(inp)\n    except Exception:\n        return None\n    if pred.shape != out.shape:\n        return None\n    if not bool(np.array_equal(pred, out)):\n        return None\n\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
