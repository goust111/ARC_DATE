ode.py:30:#    whose left panel is a clean square table frame.\n/home/lixinyu/snap/new/ceshi/code_combo/d8e07eb2/15/code.py:34:#    disjoint; the output panels also remain disjoint.\n/home/lixinyu/snap/new/ceshi/code_combo/d8e07eb2/15/code.py:38:#    table leaves the center strip and reappears as a clean left panel, while the\n/home/lixinyu/snap/new/ceshi/code_combo/d8e07eb2/15/code.py:95:    left_panel_w = cell_size * len(col_starts) + 2\n/home/lixinyu/snap/new/ceshi/code_combo/d8e07eb2/15/code.py:96:    right_panel_w = cell_size + verdict_w\n/home/lixinyu/snap/new/ceshi/code_combo/d8e07eb2/15/code.py:98:    assert left_panel_w + 1 + right_panel_w == w, \"output panel widths do not fit canvas\"\n/home/lixinyu/snap/new/ceshi/code_combo/d8e07eb2/15/code.py:108:        \"left_panel_w\": left_panel_w,\n/home/lixinyu/snap/new/ceshi/code_combo/d8e07eb2/15/code.py:109:        \"out_sep\": left_panel_w,\n/home/lixinyu/snap/new/ceshi/code_combo/d8e07eb2/15/code.py:111:        \"out_query_c0\": left_panel_w + 1,\n/home/lixinyu/snap/new/ceshi/code_combo/d8e07eb2/15/code.py:112:        \"out_verdict_c0\": left_panel_w + 1 + cell_size,\n/home/lixinyu/snap/new/ceshi/code_combo/d8e07eb2/15/code.py:164:    the answer as two horizontal panels.\n/home/lixinyu/snap/new/ceshi/code_combo/d8e07eb2/15/code.py:180:    - Present the result as a left table panel and a right query+verdict panel,\n/home/lixinyu/snap/new/ceshi/code_combo/d8e07eb2/15/code.py:241:# -- Output panel geometry --\n/home/lixinyu/snap/new/ceshi/code_combo/abc82100/26/code.py:65:#    - A human can read each rule from a visible input/output analogy panel, then\n/home/lixinyu/snap/new/ceshi/code_combo/abc82100/26/code.py:69:#      cell of the source sprite, which is visually recoverable from the left panel.\n/home/lixinyu/snap/new/ceshi/code_combo/a25697e4/11/code.py:12:#      separate panels with divider rows.\n/home/lixinyu/snap/new/ceshi/code_combo/a25697e4/11/code.py:25:#      separate panels remain easy to read.\n/h