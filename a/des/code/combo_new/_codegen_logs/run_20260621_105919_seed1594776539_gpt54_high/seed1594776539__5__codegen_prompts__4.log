r def main( at line 35 --\n  35: def main(grid: np.ndarray) -> np.ndarray:\n  36:     \"\"\"\n  37:     Fill the one blank in each corner region so all four regions have the same color multiset.\n  38: \n  39:     Input structure:\n  40:     - The dominant background color forms one solid separator row and one solid\n  41:       separator column.\n  42:     - The separator cross splits the grid into four equal rectangular corner regions.\n  43:     - Each corner region contains exactly one background-colored blank pixel.\n  44: \n  45:     Rule:\n  46:     - Count the non-background colors in each corner region.\n  47:     - The completed region multiset is defined by the maximum observed count of\n  48:       each color across the four regions.\n  49:     - Replace each region's blank pixel with the single color needed to match that\n  50:       completed multiset.\n  51: \n  52:     Key insight:\n  53:     - The separator color inside a corner region is a missing value marker; comparing\n  54:       the four regions reveals the shared multiset without using numeric color order.\n  55:     \"\"\"\n  56:     g = np.asarray(grid, dtype=int)\n  57:     assert g.ndim == 2, \"expected a 2D grid\"\n  58:     height, width = map(int, g.shape)\n  59: \n  60:     bg = get_bg(g)\n  61:     color_counts = Counter(map(int, g.reshape(-1)))\n  62:     assert all(\n  63:         color == bg or count < color_counts[bg] for color, count in color_counts.items()\n  64:     ), \"background color must be uniquely dominant\"\n  65: \n  66:     cross_row, cross_col = _solid_separator_cross(g, bg)\n  67:     regions = _quadrants(cross_row, cross_col, height, width)\n  68:     region_shape = g[regions[0]].shape\n  69:     region_area = int(np.prod(region_shape))\n  70: \n  71:     counts_by_region: list[Counter[int]] = []\n  72:     blank_positions: list[tuple[int, int]] = []\n  73:     for row_slice, col_slice in regions:\n  74:         region = g[row_slice, col_slice]\n  75:         assert region.shape == region_shape, \"all corner regions must have the same shape\"\n  76:         blanks = np.argwhere(region == bg)\n  77:         assert len(blanks) == 1, \"each corner region must have exactly one blank\"\n  78: \n  79:         counts_by_region.append(Counter(map(int, region[region != bg].reshape(-1))))\n  80:         local_r, local_c = map(int, blanks[0])\n  81:         blank_positions.append((row_slice.start + local_r, col_slice.start + local_c))\n  82: \n  83:     target_counts: Counter[int] = Counter()\n  84:     for counts in counts_by_region:\n  85:         for color, count in counts.items():\n  86:             target_counts[color] = max(target_counts[color], count)\n  87:     assert sum(target_counts.values()) == region_area, \"completed region multiset must be unique\"\n  88: \n  89:     out = g.copy()\n  90:     for counts, (row, col) in zip(counts_by_region, blank_positions):\n  91:         missing = target_counts - counts\n  92:         assert len(missing) == 1, \"each blank must have exactly one matching fill color\"\n  93:         fill_color, fill_count = next(iter(missing.items()))\n  94:         assert fill_count == 1, \"each corner region must need one pixel of the fill color\"\n  95:         out[row, col] = fill_color\n  96: \n  97:     return out\n  98: \n  99: # --------------- generator (o5x) ---------------\n 100: # Canvas/palette bounds.\n 101: GRID_HALF_MIN = 2\n 102: GRID_HALF_MAX = 6\n 103: COLOR_COUNT = 10\n 104: MIN_TARGET_COLORS = 3\n 105: MAX_NON_BG_COLORS = COLOR_COUNT - 1\n 106: # Layout probabilities and constraints.\n 107: PREFERRED_GRID_HALF = (2, 2)\n 108: PREFERRED_GRID_PROB = 0.65\n 109: QUADRANT_COUNT = 4\n 110: SEPARATOR_WIDTH = 1\n 111: BG_DOMINANCE_MARGIN = 1\n 112: # Retry limit.\n 113: MAX_GENERATION_ATTEMPTS = 300\n 114: \n 115: def _gen_bounded_composition(total: int, parts: int, max_each: int) -> list[int] | None:\n 116:     if parts <= 0 or total < parts or total > parts * max_each:\n 117:         return None\n 118: \n 119:     counts = []\n 120:     remaining = total\n 121:     for i in range(parts):\n 122:         slots_left = parts - i - 1\n 123:         lo = max(1, remaining - slots_left * max_each)\n 124:         hi = min(max_each, remaining - slots_left)\n 125:         counts.append(random.randint(lo, hi))\n 126:         remaining -= counts[-1]\n 127: \n 128:     random.shuffle(counts)\n 129:     return counts\n 130: \n 131: \n 132: def _gen_grid_options() -> list[tuple[int, int, list[int], int]]:\n 133:     options = []\n 134:     for k in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n 135:         for m in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n 136:             area = k * m\n 137:             bg_count = 2 * k + 2 * m + SEPARATOR_WIDTH + QUADRANT_COUNT\n 138:             max_target_count = (bg_count - BG_DOMINANCE_MARGIN) // QUADRANT_COUNT\n 139:             max_colors = min(MAX_NON_BG_COLORS, area)\n 140:             valid_counts = [\n 141:                 c\n 142:                 for c in range(MIN_TARGET_COLORS, max_colors + 1)\n 143:                 if area <= c * max_target_count\n 144:             ]\n 145:             if valid_counts:\n 146:                 options.append((k, m, valid_counts, max_target_count))\n 147:     return options\n 148: \n 149: \n 150: def _gen_pick_grid_option() -> tuple[int, int, list[int], int]:\n 151:     options = _gen_grid_options()\n 152:     if random.random() < PREFERRED_GRID_PROB:\n 153:         preferred_k, preferred_m = PREFERRED_GRID_HALF\n 154:         for option in options:\n 155:             if option[0] == preferred_k and option[1] == preferred_m:\n 156:                 return option\n 157:     return random.choice(options)\n 158: \n 159: \n 160: def _gen_quadrant_offsets(k: int, m: int) -> list[tuple[int, int]]:\n 161:     sep = SEPARATOR_WIDTH\n 162:     return [(0, 0), (0, m + sep), (k + sep, 0), (k + sep, m + sep)]\n 163: \n 164: \n 165: def _gen_missing_colors(non_bg_colors: list[int]) -> list[int]:\n 166: