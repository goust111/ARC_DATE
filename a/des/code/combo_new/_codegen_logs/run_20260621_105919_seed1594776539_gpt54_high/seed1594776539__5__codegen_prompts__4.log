een-fill the query band and the bottom verdict band.\n  43:     - Otherwise leave the query band unchanged and fill the bottom verdict band red.\n  44: \n  45:     Key insight: The bottom color is not a count; it is the yes/no answer to\n  46:     whether the queried glyphs align as a full row or column in the table.\n  47:     \"\"\"\n  48:     g = np.asarray(grid, dtype=int)\n  49:     h, w = g.shape\n  50:     bg = get_bg(g)\n  51:     cell_size = 5\n  52: \n  53:     sep_rows = _constant_non_bg_rows(g, bg)\n  54:     assert len(sep_rows) >= 2, \"expected two full-width separator rows\"\n  55:     top_sep = sep_rows[0]\n  56:     bottom_sep = sep_rows[-1]\n  57: \n  58:     table_region = g[top_sep + 1 : bottom_sep, :]\n  59:     table_fg = np.argwhere(table_region != bg)\n  60:     assert table_fg.size, \"reference table must contain glyphs\"\n  61: \n  62:     first_glyph_r = top_sep + 1 + int(table_fg[:, 0].min())\n  63:     first_glyph_c = int(table_fg[:, 1].min())\n  64:     row0 = first_glyph_r - 1\n  65:     col0 = first_glyph_c - 1\n  66: \n  67:     row_starts = list(range(row0, bottom_sep, cell_size))\n  68:     row_starts = [r for r in row_starts if r + cell_size <= bottom_sep]\n  69:     col_starts = list(range(col0, w, cell_size))\n  70:     col_starts = [c for c in col_starts if c + cell_size <= w]\n  71:     assert row_starts and col_starts, \"could not infer table cell grid\"\n  72: \n  73:     query_sigs = [\n  74:         sig\n  75:         for c in col_starts\n  76:         if (sig := _cell_signature(g, 0, c, cell_size, bg)) is not None\n  77:     ]\n  78:     query_set = set(query_sigs)\n  79:     assert len(query_sigs) == len(query_set), \"query glyphs should be distinct\"\n  80: \n  81:     out = g.copy()\n  82:     selected: list[tuple[int, int]] = []\n  83:     for ri, r in enumerate(row_starts):\n  84:         for ci, c in enumerate(col_starts):\n  85:             if _cell_signature(g, r, c, cell_size, bg) not in query_set:\n  86:                 continue\n  87:             selected.append((int(ri), int(ci)))\n  88:             cell = out[r : r + cell_size, c : c + cell_size]\n  89:             cell[cell == bg] = 3\n  90: \n  91:     complete_query = len(query_sigs) == len(col_starts)\n  92:     same_row = len({r for r, _c in selected}) == 1\n  93:     same_col = len({c for _r, c in selected}) == 1\n  94:     success = complete_query and len(selected) == len(query_sigs) and (same_row or same_col)\n  95: \n  96:     if success:\n  97:         query_band = out[:top_sep, :]\n  98:         query_band[query_band == bg] = 3\n  99:         out[bottom_sep + 1 :, :] = 3\n 100:     else:\n 101:         out[bottom_sep + 1 :, :] = 2\n 102: \n 103:     return out\n 104: \n 105: # --------------- generator (o5x) ---------------\n 106: \n 107: # -- Grid layout --\n 108: GRID_H, GRID_W = 30, 22       # fixed canvas size\n 109: TOP_SEP_ROW = 5                # query-band separator row\n 110: BOTTOM_SEP_ROW = 27            # table-bottom separator row\n 111: QUERY_BAND_H = 5               # height of query band (rows 0..4)\n 112: VERDICT_ROW = 28               # verdict band starts here\n 113: \n 114: # -- Colors --\n 115: BG = 8                         # teal background\n 116: GREEN = 3                      # success / match highlight\n 117: RED = 2                        # fail verdict\n 118: SEP = 6                        # separator row color\n 119: GLYPH_COLORS = (0, 1, 2, 4, 5, 6, 7, 9)  # 8 available glyph colors\n 120: \n 121: # -- Table geometry --\n 122: TABLE_DIM = 4                  # 4x4 grid of cells\n 123: CELL = 5                       # each cell is 5x5\n 124: ROWS = (7, 12, 17, 22)        # row offsets for 4 table rows\n 125: COLS = (1, 6, 11, 16)         # col offsets for 4 table columns\n 126: \n 127: # -- Glyph shape --\n 128: FILL_MIN, FILL_MAX = 5, 9     # filled-pixel range per 3x3 glyph\n 129: SHAPE_BASE_COUNTS = {5: 2, 6: 2, 7: 2, 8: 2, 9: 1}  # min shapes per fill-count\n 130: MAX_SHAPES_PE