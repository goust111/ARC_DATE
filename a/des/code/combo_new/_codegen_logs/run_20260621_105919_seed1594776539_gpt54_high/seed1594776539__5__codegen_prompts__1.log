{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/bc93ec48.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox, find_components, get_bg, paste\nimport random\n\n\nCorner = str\n\n_NEXT_CORNER: dict[Corner, Corner] = {\n    \"TL\": \"TR\",\n    \"TR\": \"BR\",\n    \"BR\": \"BL\",\n    \"BL\": \"TL\",\n}\n\n\ndef _bbox_corner(bbox: tuple[int, int, int, int], height: int, width: int) -> Corner | None:\n    r0, c0, r1, c1 = bbox\n    corners = []\n    if r0 == 0 and c0 == 0:\n        corners.append(\"TL\")\n    if r0 == 0 and c1 == width - 1:\n        corners.append(\"TR\")\n    if r1 == height - 1 and c1 == width - 1:\n        corners.append(\"BR\")\n    if r1 == height - 1 and c0 == 0:\n        corners.append(\"BL\")\n\n    assert len(corners) <= 1, \"expected each corner object to touch at most one corner\"\n    return corners[0] if corners else None\n\n\ndef _corner_anchor(corner: Corner, height: int, width: int, obj_h: int, obj_w: int) -> tuple[int, int]:\n    if corner == \"TL\":\n        return 0, 0\n    if corner == \"TR\":\n        return 0, width - obj_w\n    if corner == \"BR\":\n        return height - obj_h, width - obj_w\n    if corner == \"BL\":\n        return height - obj_h, 0\n    raise AssertionError(f\"unknown corner: {corner}\")\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Copy each foreground object anchored in a true grid corner clockwise into the next corner.\n\n    Input structure\n    - The dominant color is the background.\n    - Foreground objects are monochromatic 4-connected components.\n    - Relevant objects are exactly those whose bounding box touches two adjacent borders at one grid corner.\n\n    Rule\n    - Start from the input unchanged.\n    - For each corner object, copy its pixel mask and color to the next corner clockwise: top-left to top-right, top-right to bottom-right, bottom-right to bottom-left, and bottom-left to top-left.\n    - Preserve each object's orientation by aligning its bounding box to the destination corner; stamps may overwrite existing pixels at the destination, but source pixels are not cleared.\n\n    Key insight\n    - Interior and side-only objects are distractors; only components actually anchored to a corner participate in the clockwise perimeter copy.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n    bg = get_bg(g)\n\n    by_corner: dict[Corner, dict] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        corner = _bbox_corner(comp[\"bbox\"], height, width)\n        if corner is None:\n            continue\n        assert corner not in by_corner, \"expected at most one source object per corner\"\n        by_corner[corner] = comp\n\n    assert by_corner, \"expected at least one corner-anchored object\"\n\n    out = g.copy()\n    planned: dict[tuple[int, int], int] = {}\n    for src_corner, comp in by_corner.items():\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        obj_h = int(r1 - r0 + 1)\n        obj_w = int(c1 - c0 + 1)\n        dst_corner = _NEXT_CORNER[src_corner]\n        dst_r0, dst_c0 = _corner_anchor(dst_corner, height, width, obj_h, obj_w)\n        color = int(comp[\"color\"])\n\n        for r_raw, c_raw in comp[\"coords\"]:\n            r = int(dst_r0 + int(r_raw) - r0)\n            c = int(dst_c0 + int(c_raw) - c0)\n            assert 0 <= r < height and 0 <= c < width, \"corner stamp must remain in bounds\"\n            assert (r, c) not in planned, \"expected non-overlapping corner stamps\"\n            planned[(r, c)] = color\n\n    for (r, c), color in planned.items():\n        out[r, c] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_BG = 7\n_GEN_MIN_SIZE, _GEN_MAX_SIZE = 8, 16\n_GEN_CORNERS = (\"TL\", \"TR\", \"BR\", \"BL\")\n_GEN_NEXT = {\"TL\": \"TR\", \"TR\": \"BR\", \"BR\": \"BL\", \"BL\": \"TL\"}\n_GEN_COLORS = (1, 2, 3, 4, 5, 6, 8, 9)\n\n_GEN_CORNER_COUNT_MIN, _GEN_CORNER_COUNT_MAX = 3, 4\n_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX = 1, 4\n_GEN_CORNER_MIN_PIXELS, _GEN_CORNER_MAX_PIXELS = 2, 12\n_GEN_CORNER_MIN_DENSITY = 0.62\n_GEN_SMALL_FULL_AREA_MAX, _GEN_SMALL_FULL_PROB = 12, 0.45\n_GEN_CORNER_DIMS = tuple(\n    (h, w)\n    for h in range(_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX + 1)\n    for w in range(_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX + 1)\n    if not (h == 1 and w == 1)\n)\n\n_GEN_BLOB_PIXELS_MIN, _GEN_BLOB_PIXELS_MAX = 1, 5\n_GEN_BLOB_H_MIN, _GEN_BLOB_H_MAX = 1, 5\n_GEN_BLOB_W_MIN, _GEN_BLOB_W_MAX = 1, 4\n_GEN_DISTRACTOR_BASE_COUNT = 4\n_GEN_DISTRACTOR_SIZE_SPAN = 8\n_GEN_DISTRACTOR_EXTRA_MAX, _GEN_DISTRACTOR_MIN_GAP = 10, 6\n\n_GEN_RETRY_LIMIT = 300\n_GEN_NEIGHBORS_4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\n\ndef _gen_anchor(corner: str, n: int, h: int, w: int) -> tuple[int, int]:\n    if corner == \"TL\":\n        return 0, 0\n    if corner == \"TR\":\n        return 0, n - w\n    if corner == \"BR\":\n        return n - h, n - w\n    if corner == \"BL\":\n        return n - h, 0\n    raise AssertionError(corner)\n\n\ndef _gen_source_local_corner(corner: str, h: int, w: int) -> tuple[int, int]:\n    r = 0 if corner in (\"TL\", \"TR\") else h - 1\n    c = 0 if corner in (\"TL\", \"BL\") else w - 1\n    return r, c\n\n\ndef _gen_step_range(a: int, b: int) -> range:\n    step = 1 if b >= a else -1\n    return range(a, b + step, step)\n\n\ndef _gen_frontier(mask: np.ndarray) -> set[tuple[int, int]]:\n    h, w = mask.shape\n    frontier: set[tuple[int, int]] = set()\n    for r, c in np.argwhere(mask):\n        for dr, dc in _GEN_NEIGHBORS_4:\n            nr, nc = int(r) + dr, int(c) + dc\n            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:\n                frontier.add((nr, nc))\n    return frontier\n\n\ndef _gen_grow_mask(mask: np.ndarray, target: int) -> bool:\n    while int(mask.sum()) < target:\n        frontier = _gen_frontier(mask)\n        if not frontier:\n            return False\n        r, c = random.choice(tuple(frontier))\n        mask[r, c] = True\n    return True\n\n\ndef _gen_connected_corner_mask(corner: str, h: int, w: int) -> np.ndarray | None:\n    sr, sc = _gen_source_local_corner(corner, h, w)\n    er, ec = h - 1 - sr, w - 1 - sc\n    mask = np.zeros((h, w), dtype=bool)\n\n    if random.random() < 0.5:\n        for r in _gen_step_range(sr, er):\n            mask[r, sc] = True\n        for c in _gen_step_range(sc, ec):\n            mask[er, c] = True\n    else:\n        for c in _gen_step_range(sc, ec):\n            mask[sr, c] = True\n        for r in _gen_step_range(sr, er):\n            mask[r, ec] = True\n\n    area = h * w\n    min_pixels = max(\n        _GEN_CORNER_MIN_PIXELS,\n        int(np.ceil(area * _GEN_CORNER_MIN_DENSITY)),\n        int(mask.sum()),\n    )\n    max_pixels = min(_GEN_CORNER_MAX_PIXELS, area)\n    if min_pixels > max_pixels:\n        return None\n\n    if area <= _GEN_SMALL_FULL_AREA_MAX and random.random() < _GEN_SMALL_FULL_PROB:\n        target = area\n    else:\n        target = random.randint(min_pixels, max_pixels)\n\n    return mask if _gen_grow_mask(mask, target) else None\n\n\ndef _gen_colored_patch(mask: np.ndarray, color: int) -> np.ndarray:\n    patch = np.full(mask.shape, _GEN_BG, dtype=int)\n    patch[mask] = color\n    return patch\n\n\ndef _gen_stamp_cells(\n    corner: str, mask: np.ndarray, color: int, n: int\n) -> dict[tuple[int, int], int]:\n    h, w = mask.shape\n    r0, c0 = _gen_anchor(_GEN_NEXT[corner], n, h, w)\n    cells = {}\n    for rr, cc in np.argwhere(mask):\n        cells[(r0 + int(rr), c0 + int(cc))] = color\n    return cells\n\n\ndef _gen_touches_true_corner(r0: int, c0: int, h: int, w: int, n: int) -> bool:\n    top = r0 == 0\n    bottom = r0 + h - 1 == n - 1\n    left = c0 == 0\n    right = c0 + w - 1 == n - 1\n    return (top and left) or (top and right) or (bottom and right) or (bottom and left)\n\n\ndef _gen_blob_patch(color: int) -> np.ndarray:\n    pixels = random.randint(_GEN_BLOB_PIXELS_MIN, _GEN_BLOB_PIXELS_MAX)\n    dims = [\n        (h, w)\n        for h in range(_GEN_BLOB_H_MIN, _GEN_BLOB_H_MAX + 1)\n        for w in range(_GEN_BLOB_W_MIN, _GEN_BLOB_W_MAX + 1)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/8a6d367c.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, find_components, get_bg, paste\n\n\ndef _find_frame(g: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:\n    candidates: list[tuple[int, int, tuple[int, int, int, int]]] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        color = int(comp[\"color\"])\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        if h < 3 or w < 3:\n            continue\n\n        border = np.zeros((h, w), dtype=bool)\n        border[0, :] = True\n        border[-1, :] = True\n        border[:, 0] = True\n        border[:, -1] = True\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        if int(comp[\"area\"]) == int(border.sum()) and np.array_equal(sub == color, border):\n            candidates.append((int(comp[\"area\"]), color, (r0, c0, r1, c1)))\n\n    assert candidates, \"expected one rectangular frame\"\n    max_area = max(area for area, _color, _bbox in candidates)\n    largest = [candidate for candidate in candidates if candidate[0] == max_area]\n    assert len(largest) == 1, \"rectangular frame must be structurally unique\"\n    _area, color, frame_bbox = largest[0]\n    return color, frame_bbox\n\n\ndef _templates_above_frame(g: np.ndarray, bg: int, frame_r0: int) -> list[np.ndarray]:\n    top = g[:frame_r0]\n    templates: list[np.ndarray] = []\n    for color in np.unique(top):\n        color = int(color)\n        if color == bg:\n            continue\n        coords = np.argwhere(top == color)\n        r0, c0, r1, c1 = bbox_coords(coords)\n        templates.append(top[r0 : r1 + 1, c0 : c1 + 1] == color)\n\n    assert templates, \"expected upper template masks\"\n    return templates\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the framed area by expanding the unique upper template that contains the existing seed pixels.\n\n    Input structure:\n    - A teal background contains small colored template masks above a larger rectangular frame.\n    - The frame encloses one fill color arranged as a partial block-scaled copy of one template.\n    - The frame interior dimensions are an integer square scale of the matching template bbox.\n\n    Rule:\n    - Crop to the rectangular frame.\n    - Identify the unique upper template whose block-scaled mask covers every existing fill pixel inside the frame.\n    - Reset the frame interior to background and paint the whole scaled mask with the fill color.\n\n    Key insight:\n    The lower colored pixels are seed cells that reveal which upper template should be completed inside the frame.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    frame_color, (r0, c0, r1, c1) = _find_frame(g, bg)\n\n    out = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n    interior = out[1:-1, 1:-1]\n    fill_colors = set(map(int, np.unique(interior))) - {bg, frame_color}\n    assert len(fill_colors) == 1, \"frame interior must contain exactly one fill color\"\n    fill_color = fill_colors.pop()\n\n    seed = interior == fill_color\n    assert np.any(seed), \"frame must contain seed pixels\"\n    ih, iw = seed.shape\n\n    matches: list[np.ndarray] = []\n    for template in _templates_above_frame(g, bg, r0):\n        th, tw = template.shape\n        if ih % th != 0 or iw % tw != 0:\n            continue\n        scale_h = ih // th\n        scale_w = iw // tw\n        if scale_h != scale_w:\n            continue\n\n        scaled = np.kron(template, np.ones((scale_h, scale_w), dtype=bool))\n        if np.all(~seed | scaled):\n            matches.append(scaled)\n\n    assert len(matches) == 1, \"seed pixels must select exactly one scaled template\"\n    completed = matches[0]\n    assert completed.shape == interior.shape\n\n    interior[:, :] = bg\n    interior[completed] = fill_color\n    return out\n\n# --------------- generator (att2) ---------------\n\nGEN_BG = 8\nGEN_GRID_SHAPE = (27, 21)\nGEN_TEMPLATE_SHAPES = [(3, 3), (3, 4), (4, 3)]\nGEN_TEMPLATE_COUNT_RANGE = (2, 6)\nGEN_TEMPLATE_ROW = 1\nGEN_TEMPLATE_LEFT_MIN = 1\nGEN_TEMPLATE_GAP = 1\nGEN_MAX_TEMPLATE_SPAN = 19\nGEN_DENSITY_MIN_NUM = 1\nGEN_DENSITY_MIN_DEN = 2\nGEN_DENSITY_MAX_NUM = 5\nGEN_DENSITY_MAX_DEN = 6\nGEN_SCALE_RANGE = (2, 5)\nGEN_SEED_COUNTS = (2, 3)\nGEN_SEED_FRACTION_RANGE = (0.20, 0.60)\nGEN_FRAME_ROW_GAP = 2\nGEN_FRAME_LEFT_MIN = 1\nGEN_ATTEMPTS = 300\nGEN_PALETTE = [0, 1, 2, 3, 4, 5, 6, 7, 9]\n\ndef _gen_has_full_bbox(mask: np.ndarray) -> bool:\n    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())\n\n\ndef _gen_valid_masks(th: int, tw: int) -> list[np.ndarray]:\n    n = int(th * tw)\n    lo = (GEN_DENSITY_MIN_NUM * n + GEN_DENSITY_MIN_DEN - 1) // GEN_DENSITY_MIN_DEN\n    hi = (GEN_DENSITY_MAX_NUM * n) // GEN_DENSITY_MAX_DEN\n    masks: list[np.ndarray] = []\n    for bits in range(1 << n):\n        count = int(bits.bit_count())\n        if count < lo or count > hi:\n            continue\n        flat = np.array([(bits >> k) & 1 for k in range(n)], dtype=bool)\n        mask = flat.reshape(th, tw)\n        if _gen_has_full_bbox(mask):\n            masks.append(mask)\n    return masks\n\n\ndef _gen_colored_patch(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\n    patch = np.full(mask.shape, bg, dtype=int)\n    patch[mask] = int(color)\n    return patch\n\n\ndef _gen_draw_frame(shape: tuple[int, int], bg: int, frame_color: int) -> np.ndarray:\n    patch = np.full(shape, bg, dtype=int)\n    patch[0, :] = frame_color\n    patch[-1, :] = frame_color\n    patch[:, 0] = frame_color\n    patch[:, -1] = frame_color\n    return patch\n\n\ndef _gen_frame_patch(\n    target_mask: np.ndarray,\n    seed_cells: np.ndarray,\n    scale: int,\n    bg: int,\n    frame_color: int,\n    fill_color: int,\n) -> tuple[np.ndarray, np.ndarray]:\n    th, tw = map(int, target_mask.shape)\n    scaled = np.kron(target_mask, np.ones((scale, scale), dtype=bool))\n    out = _gen_draw_frame((th * scale + 2, tw * scale + 2), bg, frame_color)\n    out[1:-1, 1:-1][scaled] = fill_color\n\n    frame = _gen_draw_frame(out.shape, bg, frame_color)\n    for r, c in seed_cells:\n        rr = int(r) * scale\n        cc = int(c) * scale\n        frame[1 + rr : 1 + rr + scale, 1 + cc : 1 + cc + scale] = fill_color\n    return frame, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n    bg = GEN_BG\n    count = int(rng.integers(*GEN_TEMPLATE_COUNT_RANGE))\n    shape_choices = [\n        shape for shape in GEN_TEMPLATE_SHAPES if count * shape[1] + count - 1 <= GEN_MAX_TEMPLATE_SPAN\n    ]\n    th, tw = shape_choices[int(rng.integers(0, len(shape_choices)))]\n    scale = int(rng.integers(*GEN_SCALE_RANGE))\n\n    valid_masks = _gen_valid_masks(th, tw)\n    if len(valid_masks) < count:\n        return None\n\n    target = valid_masks[int(rng.integers(0, len(valid_masks)))]\n    true_cells = np.argwhere(target)\n    target_area = int(len(true_cells))\n    min_seed_frac, max_seed_frac = GEN_SEED_FRACTION_RANGE\n    seed_counts = [k for k in GEN_SEED_COUNTS if min_seed_frac <= k / target_area <= max_seed_frac]\n    if not seed_counts:\n        return None\n    seed_count = int(seed_counts[int(rng.integers(0, len(seed_counts)))])\n    seed_idx = rng.choice(target_area, size=seed_count, replace=False)\n    seed_cells = true_cells[seed_idx]\n\n    covers_seed = np.array([bool(mask[seed_cells[:, 0], seed_cells[:, 1]].all()) for mask in valid_masks])\n    distractor_pool = [mask for mask, covers in zip(valid_masks, covers_seed) if not covers]\n    if len(distractor_pool) < count - 1:\n        return None\n    distractor_idx = rng.choice(len(distractor_pool), size=count - 1, replace=False)\n    distractors = [distractor_pool[int(i)] for i in distractor_idx]\n\n    masks = distractors + [target]\n    rng.shuffle(masks)\n\n    colors = list(GEN_PALETTE)\n    rng.shuffle(colors)\n    frame_color = int(colors[0])\n    fill_color = int(colors[1])\n    template_colors = [int(c) for c in colors[2 : 2 + count]]\n\n    frame, expected = _gen_frame_patch(target, seed_cells, scale, bg, frame_color, fill_color)\n    grid_h, grid_w = GEN_GRID_SHAPE\n    grid = np.full(GEN_GRID_SHAPE, bg, dtype=int)\n\n    total_template_w = count * tw + count - 1\n    template_c0 = int(rng.integers(GEN_TEMPLATE_LEFT_MIN, grid_w - total_template_w))\n    c = template_c0\n    for mask, color in zip(masks, template_colors):\n        paste(grid, _gen_colored_patch(mask, color, bg), GEN_TEMPLATE_ROW, c, transparent=bg)\n        c += tw + GEN_TEMPLATE_GAP\n\n    fh, fw = map(int, frame.shape)\n    min_r0 = th + GEN_FRAME_ROW_GAP\n    max_r0 = grid_h - fh\n    if min_r0 > max_r0:\n        return None\n    frame_r0 = int(rng.integers(min_r0, max_r0 + 1))\n    frame_c0 = int(rng.integers(GEN_FRAME_LEFT_MIN, grid_w - fw))\n    paste(grid, frame, frame_r0, frame_c0)\n\n    try:\n        if not np.array_equal(main(grid), expected):\n            return None\n    except Exception:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 8a6d367c input\")\n","exit_code":0,"status":"completed"}}
