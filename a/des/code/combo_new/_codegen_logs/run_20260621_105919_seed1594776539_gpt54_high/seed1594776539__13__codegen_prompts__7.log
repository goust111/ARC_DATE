e larger component in this pair is treated as the source.\n                assert ci[\"area\"] != cj[\"area\"], f\"ambiguous equal-area legend pair: {ci['col']} and {cj['col']}\"\n                if ci[\"area\"] > cj[\"area\"]:\n                    src, tgt = ci[\"col\"], cj[\"col\"]\n                else:\n                    src, tgt = cj[\"col\"], ci[\"col\"]\n\n            assert src in placeholder_colors, f\"legend source color {src} is not a placeholder\"\n            assert src not in color_map, f\"duplicate legend mapping for placeholder color {src}\"\n            color_map[src] = int(tgt)\n            legend_ids.add(ci[\"id\"])\n            legend_ids.add(cj[\"id\"])\n    assert set(color_map) == placeholder_colors, (\n        f\"legend mappings {sorted(color_map)} do not match placeholders {sorted(placeholder_colors)}\"\n    )\n\n    # Sprite shapes: for each placeholder color, pick the non-legend component matching placeholder size.\n    sprite_coords: dict[int, tuple[tuple[tuple[int, int], ...], int, int]] = {}\n    for src_col in sorted(placeholder_colors):\n        all_candidates = [c for c \nENDSNIP\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        out = _gen_attempt()\n        if out is not None:\n            return out\n    raise RuntimeError(\"failed to generate valid edb79dae input\")\nENDSNIP\nFILE /home/lixinyu/snap/new/ARC_code/train/2601afb7.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate each vertical bar's color one slot right and its height one slot left.\n\n    Input structure\n    - A dominant background surrounds several monochrome one-cell-wide vertical bars.\n    - Every bar is bottom-aligned and occupies a distinct column.\n    - The ordered bar slots are read from left to right.\n\n    Rule\n    - Keep the grid shape and the bar columns unchanged.\n    - At slot i, use the color from the previous slot cyclically.\n    - At slot i, use the height from the next slot cyclically.\n\n    Key insight\n    - Color and height are independent cyclic attributes of the ordered bar slots:\n      colors rotate right while heights rotate left.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height = g.shape[0]\n    bg = get_bg(g)\n    bars = _extract_bars(g, bg)\n\n    out = np.full_like(g, bg)\n    count = len(bars)\n    for i, bar in enumerate(bars):\n        color = bars[(i - 1) % count][\"color\"]\n        bar_height = bars[(i + 1) % count][\"height\"]\n        assert 1 <= bar_height <= height\n        out[height - bar_height : height, bar[\"col\"]] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n_RNG = np.random.default_rng()\n\n# Canvas/bar bounds.\nBAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE = 3, 6\nBACKGROUND_COLOR, MIN_BAR_HEIGHT = 7, 1\nBAR_COL_OFFSET, BAR_COL_STRIDE = 1, 2\n# Color and transform sampling.\nCOLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nOUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\nENDSNIP\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\nENDSNIP\nFILE /home/lixinyu/snap/new/ARC_code/train/6165ea8f.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Build a color-labeled shape-equivalence table from the objects listed on the right edge.\n\n    Input structure:\n    - The background contains one main 4-connected object for each foreground color.\n    - The rightmost column has one singleton pixel of each foreground color, listed top-to-bottom.\n    - Those singleton pixels define the row and column order of the output table.\n\n    Rule:\n    - Normalize each main object to its tight mask and compare masks up to rotation or reflection.\n    - Draw 2x2 color labels across the top and down the left, separated by one background row/column.\n    - For each off-diagonal table cell, paint a 2x2 red block when the two labeled objects have the same shape under rotation/reflection, otherwise paint a 2x2 grey block.\n    - Leave diagonal cells and all separators as background.\n\n    Key insight:\n    - Object positions and original orientations are distractors; the relation is dihedral shape equivalence, while the right-edge legend fixes the table order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    order = _legend_order(g, bg)\n    signatures = {color: _shape_signature(_main_object_mask(g, bg, color)) for color in order}\n\n    n = len(order)\n    out = np.full((3 * n + 2, 3 * n + 2), int(bg), dtype=int)\n\n    for i, color in enumerate(order):\n        band = 3 + 3 * i\n        out[0:2, band : band + 2] = int(color)\n        out[band : band + 2, 0:2] = int(color)\n\n    for i, row_color in enumerate(order):\n        for j, col_color in enumerate(order):\n            if i == j:\n                continue\n            cell_color = Color.RED if signatures[row_color] == signatures[col_color] else Color.GREY\n            r = 3 + 3 * i\n            c = 3 + 3 * j\n            out[r : r + 2, c : c + 2] = int(cell_color)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and object bounds.\nGEN_OBJECT_COUNT_RANGE, GEN_GRID_ROW_RANGE, GEN_GRID_COL_RANGE = (4, 7), (20, 25), (20, 23)\nGEN_OBJECT_AREA_RANGE, GEN_OBJECT_BBOX_RANGE, GEN_OBJECT_MAX_EXTRA_CELLS = (5, 13), (2, 7), 4\n# Shape-class sampling.\nGEN_CLASS_OPTIONS, GEN_MAX_CLASS_SIZE, GEN_UNIQUE_MASK_RETRIES = (2, 3), 3, 80\nGEN_DIHEDRAL_FLIP_PROB = 0.5\n# Output table layout and colors.\nGEN_OBJECT_COLORS, GEN_TABLE_BLOCK, GEN_TABLE_STEP = [1, 3, 4, 6, 7, 8, 9], 2, 3\nGEN_SAME_SHAPE_COLOR, GEN_DIFFERENT_SHAPE_COLOR = int(Color.RED), int(Color.GREY)\n# Input placement and retry limits.\nGEN_RESERVED_RIGHT_COLS, GEN_ATTEMPTS = 2, 300\nGEN_PLACEMENT_BORDER, GEN_PLACEMENT_PADDING, GEN_PLACEMENT_CONNECTIVITY = 1, 2, 4\nGEN_NEIGHBORS_4 = ((-