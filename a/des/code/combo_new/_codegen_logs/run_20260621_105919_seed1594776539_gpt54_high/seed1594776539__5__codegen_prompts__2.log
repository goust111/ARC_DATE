{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nimport numpy as np\n\nBLACK=0; BLUE=1; RED=2; GREEN=3; YELLOW=4; GREY=5; MAGENTA=6; ORANGE=7; AZURE=8; MAROON=9\nORDER=[RED,BLUE,GREEN,YELLOW,ORANGE,MAGENTA,AZURE,MAROON]\nRANK={c:i for i,c in enumerate(ORDER)}\nPATH_COLORS=ORDER[:]\n\ndef prio(c): return RANK[c]\ndef is_path(v): return v not in (BLACK,GREY)\n\ndef pick_color(rng, avoid=()):\n    choices=[c for c in PATH_COLORS if c not in avoid]\n    if not choices:\n        choices=PATH_COLORS[:]\n    return rng.choice(choices)\n\ndef draw_segment(g,a,b,color):\n    r0,c0=a; r1,c1=b\n    if r0==r1:\n        step=1 if c1>=c0 else -1\n        for c in range(c0, c1+step, step):\n            v=int(g[r0,c])\n            if v==GREY:\n                g[r0,c]=color\n            elif v==BLACK:\n                raise ValueError('black overlap')\n            elif prio(color)<prio(v):\n                g[r0,c]=color\n    elif c0==c1:\n        step=1 if r1>=r0 else -1\n        for r in range(r0, r1+step, step):\n            v=int(g[r,c0])\n            if v==GREY:\n                g[r,c0]=color\n            elif v==BLACK:\n                raise ValueError('black overlap')\n            elif prio(color)<prio(v):\n                g[r,c0]=color\n    else:\n        raise ValueError('diagonal')\n\ndef trace(g):\n    H,W=g.shape\n    out=g.copy()\n    sources=[]\n    for r in range(H):\n        if int(g[r,0])==BLACK and W>1 and is_path(int(g[r,1])):\n            sources.append(((r,0),(r,1),(0,1),int(g[r,1])))\n    for c in range(W):\n        if int(g[0,c])==BLACK and H>1 and is_path(int(g[1,c])):\n            sources.append(((0,c),(1,c),(1,0),int(g[1,c])))\n    for src, pos, d, src_color in sources:\n        r,c=pos\n        seen=set()\n        while True:\n            state=(r,c,d)\n            if state in seen:\n                raise RuntimeError(('loop', src, state))\n            seen.add(state)\n            perp=[(-1,0),(1,0)] if d[0]==0 else [(0,-1),(0,1)]\n            turns=[]\n            for nd in perp:\n                rr=r+nd[0]; cc=c+nd[1]\n                if 0<=rr<H and 0<=cc<W and is_path(int(g[rr,cc])):\n                    turns.append(nd)\n            if turns:\n                if len(turns)==1:\n                    d=turns[0]\n                else:\n                    d=min(turns, key=lambda nd:(prio(int(g[r+nd[0], c+nd[1]])), nd))\n                r+=d[0]; c+=d[1]\n                continue\n            nr=r+d[0]; nc=c+d[1]\n            if 0<=nr<H and 0<=nc<W and is_path(int(g[nr,nc])):\n                r,c=nr,nc\n                continue\n            if 0<=nr<H and 0<=nc<W and int(g[nr,nc])==GREY and (nr==H-1 or nc==W-1):\n                out[nr,nc]=src_color\n                break\n            raise RuntimeError(('deadend', src, (r,c), d, (nr,nc), int(g[nr,nc]) if 0<=nr<H and 0<=nc<W else None))\n    return out\n\ndef gen_left(seed=None):\n    rng=random.Random(seed)\n    count=rng.choice([1,2])\n    band_h=11\n    min_h = count*band_h + (count-1)\n    H = rng.randint(min_h, min(30, min_h+4))\n    W = rng.randint(18, 29)\n    g=np.full((H,W), GREY, int)\n    free = H - min_h\n    gaps=[0]*(count+1)\n    for _ in range(free):\n        gaps[rng.randrange(count+1)] += 1\n    band_starts=[]\n    r=gaps[0]\n    for i in range(count):\n        band_starts.append(r)\n        r += band_h\n        if i < count-1:\n            r += 1 + gaps[i+1]\n    for base in band_starts:\n        rows=[base+x for x in [1,3,5,7,9]]\n        s=rows[2]\n        max_c1=min(8, W-10)\n        if max_c1 < 4:\n            raise RuntimeError('width too small')\n        c1=rng.randint(4, max_c1)\n        second = W>=22 and rng.random()<0.65\n        c2=rng.randint(c1+4, min(c1+8, W-6)) if second else None\n\n        src_color=pick_color(rng)\n        g[s,0]=BLACK\n        draw_segment(g,(s,1),(s,c1),src_color)\n\n        first_double=rng.random()<0.55\n        current_color=src_color\n        if first_double:\n            up_color=pick_color(rng, {current_color})\n            down_color=pick_color(rng, {current_color, up_color})\n            draw_segment(g,(rows[1],c1),(s,c1),up_color)\n            draw_segment(g,(s,c1),(rows[3],c1),down_color)\n            chosen_up = prio(up_color) < prio(down_color)\n            r1 = rows[1] if chosen_up else rows[3]\n            decoy_row = rows[3] if chosen_up else rows[1]\n            decoy_h = pick_color(rng, {up_color, down_color})\n            draw_segment(g,(decoy_row,c1),(decoy_row,W-2),decoy_h)\n        else:\n            chosen_up = rng.random()<0.5\n            r1 = rows[1] if chosen_up else rows[3]\n            v_color = pick_color(rng, {current_color})\n            draw_segment(g,(min(s,r1),c1),(max(s,r1),c1),v_color)\n\n        if second:\n            h1 = pick_color(rng)\n            draw_segment(g,(r1,c1),(r1,c2),h1)\n            if r1 == rows[1]:\n                a,b = rows[0], rows[2]\n            else:\n                a,b = rows[2], rows[4]\n            second_double = rng.random()<0.55\n            if second_double:\n                a_color = pick_color(rng, {h1})\n                b_color = pick_color(rng, {h1, a_color})\n                draw_segment(g,(min(r1,a),c2),(max(r1,a),c2),a_color)\n                draw_segment(g,(min(r1,b),c2),(max(r1,b),c2),b_color)\n                choose_a = prio(a_color) < prio(b_color)\n                r2 = a if choose_a else b\n                decoy_row = b if choose_a else a\n                decoy_h = pick_color(rng, {a_color, b_color})\n                draw_segment(g,(decoy_row,c2),(decoy_row,W-2),decoy_h)\n            else:\n                r2 = a if rng.random()<0.5 else b\n                v2 = pick_color(rng, {h1})\n                draw_segment(g,(min(r1,r2),c2),(max(r1,r2),c2),v2)\n            h2 = pick_color(rng)\n            draw_segment(g,(r2,c2),(r2,W-2),h2)\n        else:\n            h_end = pick_color(rng)\n            draw_segment(g,(r1,c1),(r1,W-2),h_end)\n    return g\n\nfor i in range(200):\n    g=gen_left(i)\n    if random.random()<0.5:\n        g=g.T.copy()\n    out=trace(g)\n    assert max(g.shape) <= 30\nprint('ok 200')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
