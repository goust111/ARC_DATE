{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/84ba50d3.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _divider_row(g: np.ndarray, bg: int) -> tuple[int, int]:\n    rows: list[tuple[int, int]] = []\n    for r in range(g.shape[0]):\n        row_colors = set(map(int, g[r]))\n        if len(row_colors) == 1:\n            color = next(iter(row_colors))\n            if int(color) != int(bg):\n                rows.append((int(r), int(color)))\n    assert len(rows) == 1, \"expected exactly one solid non-background divider row\"\n    return rows[0]\n\n\ndef _unique_widest_row(coords: np.ndarray) -> int:\n    row_counts: list[tuple[int, int]] = []\n    for r in sorted(set(map(int, coords[:, 0]))):\n        row_cols = np.sort(coords[coords[:, 0] == r, 1])\n        assert np.array_equal(row_cols, np.arange(int(row_cols[0]), int(row_cols[-1]) + 1))\n        row_counts.append((int(row_cols.size), int(r)))\n\n    max_count = max(count for count, _r in row_counts)\n    widest = [r for count, r in row_counts if count == max_count]\n    assert max_count > 1, \"multi-column sprites must have a horizontal span\"\n    assert len(widest) == 1, \"expected a unique widest horizontal row\"\n    return int(widest[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the blue sprites downward relative to the red divider, with vertical sprites passing through to the bottom.\n\n    Input structure:\n    - The background is the dominant color.\n    - One non-background color forms a single full-width horizontal divider row.\n    - The other non-background color forms 4-connected sprites above the divider.\n\n    Rule:\n    - Clear the original sprite pixels.\n    - A one-column sprite falls to the bottom of its column and deletes the divider\n      pixel it crossed.\n    - Any wider sprite falls until its unique widest horizontal row is immediately\n      above the divider row; if the moved sprite overlaps the divider, it covers it.\n\n    Key insight:\n    The red row is not a generic floor: only one-column sprites pass through to the\n    bottom, while wider sprites are registered by their widest horizontal segment.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n    line_r, line_color = _divider_row(g, bg)\n\n    non_bg_colors = set(map(int, g.ravel())) - {bg}\n    sprite_colors = non_bg_colors - {line_color}\n    assert len(sprite_colors) == 1, \"expected exactly one sprite color\"\n    sprite_color = next(iter(sprite_colors))\n\n    sprites = find_components(\n        g,\n        bg=bg,\n        colors=[sprite_color],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert sprites, \"expected at least one sprite\"\n\n    out = g.copy()\n    out[g == sprite_color] = bg\n    occupied = np.zeros((H, W), dtype=bool)\n\n    for sprite in sprites:\n        coords = sprite[\"coords\"]\n        _r0, c0, r1, c1 = map(int, sprite[\"bbox\"])\n        assert r1 < line_r, \"all sprites must begin above the divider\"\n\n        if c0 == c1:\n            shift = H - 1 - r1\n            assert shift >= 0\n            assert int(out[line_r, c0]) == line_color\n            out[line_r, c0] = bg\n        else:\n            widest_r = _unique_widest_row(coords)\n            shift = line_r - 1 - widest_r\n            assert shift >= 0\n\n        moved = coords.copy()\n        moved[:, 0] += shift\n        assert np.all((0 <= moved[:, 0]) & (moved[:, 0] < H))\n        assert np.all((0 <= moved[:, 1]) & (moved[:, 1] < W))\n\n        for rr, cc in moved:\n            r = int(rr)\n            c = int(cc)\n            assert not occupied[r, c], \"moved sprites must not overlap\"\n            occupied[r, c] = True\n            out[r, c] = sprite_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, palette, and divider bounds.\nMIN_GRID_SIZE, LARGE_GRID_MIN, MAX_GRID_SIZE = 7, 14, 18\nLARGE_GRID_PROB, PALETTE_SIZE, DIVIDER_MARGIN = 0.35, 10, 3\nADJACENT_ROW_OFFSET = 1\n\n# Sprite counts, spacing, and retry limits.\nMIN_SPRITE_COUNT, MAX_SPRITE_COUNT = 1, 5\nMAX_SINGLE_SPRITES, MAX_MULTI_SPRITES = 2, 3\nGAP_COLUMNS, INPUT_GAP_TO_DIVIDER = 1, 1\nGENERATION_RETRIES = 300\n\n# Sprite geometry.\nMIN_SPRITE_HEIGHT, MAX_SINGLE_HEIGHT, MAX_MULTI_HEIGHT = 1, 7, 5\nSINGLE_WIDTH, MIN_MULTI_WIDTH, MAX_MULTI_WIDTH = 1, 2, 3\nWIDE_MULTI_PROB = 0.5\n\n\ndef _composition(total: int, parts: int) -> list[int]:\n    shares = [0] * parts\n    for _ in range(total):\n        shares[random.randrange(parts)] += 1\n    return shares\n\n\ndef _min_layout_width(n_single: int, n_multi: int) -> int:\n    n = n_single + n_multi\n    return n_single * SINGLE_WIDTH + MIN_MULTI_WIDTH * n_multi + GAP_COLUMNS * max(0, n - 1)\n\n\ndef _count_pairs(width: int) -> list[tuple[int, int]]:\n    pairs: list[tuple[int, int]] = []\n    for n_single in range(MAX_SINGLE_SPRITES + 1):\n        for n_multi in range(MAX_MULTI_SPRITES + 1):\n            n = n_single + n_multi\n            if MIN_SPRITE_COUNT <= n <= MAX_SPRITE_COUNT and _min_layout_width(n_single, n_multi) <= width:\n                pairs.append((n_single, n_multi))\n    return pairs\n\n\ndef _place_intervals(widths: list[int], grid_width: int) -> list[int]:\n    n = len(widths)\n    base = sum(widths) + GAP_COLUMNS * max(0, n - 1)\n    extra = grid_width - base\n    assert extra >= 0\n    gaps = _composition(extra, n + 1)\n\n    starts: list[int] = []\n    c = gaps[0]\n    for i, width in enumerate(widths):\n        starts.append(c)\n        c += width\n        if i < n - 1:\n            c += GAP_COLUMNS + gaps[i + 1]\n    return starts\n\n\ndef _multi_coords(top: int, left: int, height: int, width: int, bar_row: int, spine_col: int) -> np.ndarray:\n    coords = {(top + r, left + spine_col) for r in range(height)}\n    coords.update((top + bar_row, left + c) for c in range(width))\n    return np.array(sorted(coords), dtype=int)\n\n\ndef _build_descriptors(n_single: int, n_multi: int, max_single_h: int, max_multi_h: int, grid_width: int) -> list[dict[str, int | str]]:\n    descriptors: list[dict[str, int | str]] = []\n    for _ in range(n_single):\n        descriptors.append(\n            {\"kind\": \"single\", \"width\": SINGLE_WIDTH, \"height\": random.randint(MIN_SPRITE_HEIGHT, max_single_h)}\n        )\n\n    extra_width = grid_width - _min_layout_width(n_single, n_multi)\n    for _ in range(n_multi):\n        width = MIN_MULTI_WIDTH\n        if extra_width > 0 and random.random() < WIDE_MULTI_PROB:\n            width = MAX_MULTI_WIDTH\n            extra_width -= MAX_MULTI_WIDTH - MIN_MULTI_WIDTH\n        height = random.randint(MIN_SPRITE_HEIGHT, max_multi_h)\n        descriptors.append(\n            {\n                \"kind\": \"multi\",\n                \"width\": width,\n                \"height\": height,\n                \"bar_row\": random.randint(0, height - ADJACENT_ROW_OFFSET),\n                \"spine_col\": random.randrange(width),\n            }\n        )\n\n    random.shuffle(descriptors)\n    return descriptors\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(LARGE_GRID_MIN, MAX_GRID_SIZE) if random.random() < LARGE_GRID_PROB else random.randint(MIN_GRID_SIZE, MAX_GRID_SIZE)\n    W = H\n    bg, divider_color, sprite_color = random.sample(range(PALETTE_SIZE), 3)\n    divider_choices = list(range(DIVIDER_MARGIN, H - DIVIDER_MARGIN))\n    divider_weights = [min(r - ADJACENT_ROW_OFFSET, H - r - ADJACENT_ROW_OFFSET) for r in divider_choices]\n    divider_r = random.choices(divider_choices, weights=divider_weights, k=1)[0]\n\n    pairs = _count_pairs(W)\n    if not pairs:\n        return None\n    n_single, n_multi = random.choice(pairs)\n\n    max_single_h = min(MAX_SINGLE_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER, H - divider_r - ADJACENT_ROW_OFFSET)\n    max_multi_h = min(MAX_MULTI_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER)\n    if (n_single and max_single_h < MIN_SPRITE_HEIGHT) or (n_multi and max_multi_h < MIN_SPRITE_HEIGHT):\n        return None\n\n    descriptors = _build_descriptors(n_single, n_multi, max_single_h, max_multi_h, W)\n    starts = _place_intervals([int(d[\"width\"]) for d in descriptors], W)\n\n    inp = np.full((H, W), bg, dtype=int)\n    out = np.full((H, W), bg, dtype=int)\n    inp[divider_r, :] = divider_color\n    out[divider_r, :] = divider_color\n\n    input_max_bottom = divider_r - INPUT_GAP_TO_DIVIDER - ADJACENT_ROW_OFFSET\n    for desc, left in zip(descriptors, starts):\n        height = int(desc[\"height\"])\n        width = int(desc[\"width\"])\n        if desc[\"kind\"] == \"single\":\n            col = left\n            out[divider_r, col] = bg\n            out[H - height : H, col] = sprite_color\n\n            input_bottom = random.randint(height - ADJACENT_ROW_OFFSET, input_max_bottom)\n            inp[input_bottom - height + ADJACENT_ROW_OFFSET : input_bottom + ADJACENT_ROW_OFFSET, col] = sprite_color\n            continue\n\n        bar_row = int(desc[\"bar_row\"])\n        spine_col = int(desc[\"spine_col\"])\n        landed_top = divider_r - ADJACENT_ROW_OFFSET - bar_row\n        landed = _multi_coords(landed_top, left, height, width, bar_row, spine_col)\n        if np.any((landed[:, 0] < 0) | (landed[:, 0] >= H)):\n            return None\n        out[landed[:, 0], landed[:, 1]] = sprite_color\n\n        landed_bottom = int(landed[:, 0].max())\n        min_shift = landed_bottom - input_max_bottom\n        max_shift = landed_top\n        if min_shift > max_shift:\n            return None\n        shift = random.randint(min_shift, max_shift)\n        original = landed.copy()\n        original[:, 0] -= shift\n        if np.any((original[:, 0] < 0) | (original[:, 0] > input_max_bottom)):\n            return None\n        inp[original[:, 0], original[:, 1]] = sprite_color\n\n    bg_count = int(np.count_nonzero(inp == bg))\n    if bg_count <= int(np.count_nonzero(inp == divider_color)):\n        return None\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/c6141b15.py\"","aggregated_output":"from itertools import combinations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, draw_line, find_components, get_bg, random_sprite\nimport random\n\n\nCoord = tuple[int, int]\n\n\ndef _sgn(x: int) -> int:\n    return (x > 0) - (x < 0)\n\n\ndef _straight_line_cells(a: Coord, b: Coord) -> set[Coord] | None:\n    r0, c0 = a\n    r1, c1 = b\n    dr = r1 - r0\n    dc = c1 - c0\n    if not (dr == 0 or dc == 0 or abs(dr) == abs(dc)):\n        return None\n    sr = _sgn(dr)\n    sc = _sgn(dc)\n    return {(r0 + i * sr, c0 + i * sc) for i in range(max(abs(dr), abs(dc)) + 1)}\n\n\ndef _segment_endpoints(coords: np.ndarray) -> tuple[Coord, Coord] | None:\n    cells = {tuple(map(int, rc)) for rc in coords}\n    if len(cells) < 2:\n        return None\n\n    endpoints: list[Coord] = []\n    for r, c in cells:\n        degree = sum(\n            (r + dr, c + dc) in cells\n            for dr in (-1, 0, 1)\n            for dc in (-1, 0, 1)\n            if (dr, dc) != (0, 0)\n        )\n        if degree == 1:\n            endpoints.append((r, c))\n        elif degree != 2:\n            return None\n\n    if len(endpoints) != 2:\n        return None\n    line = _straight_line_cells(endpoints[0], endpoints[1])\n    if line != cells:\n        return None\n    return endpoints[0], endpoints[1]\n\n\ndef _normalized_shape(coords: np.ndarray) -> frozenset[Coord]:\n    r0, c0, _r1, _c1 = bbox_coords(coords)\n    return frozenset((int(r - r0), int(c - c0)) for r, c in coords)\n\n\ndef _center_anchor(coords: np.ndarray) -> Coord | None:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    if (r0 + r1) % 2 or (c0 + c1) % 2:\n        return None\n    anchor = ((r0 + r1) // 2, (c0 + c1) // 2)\n    if anchor not in {tuple(map(int, rc)) for rc in coords}:\n        return None\n    return anchor\n\n\ndef _are_repeated_centered_sprites(components: list[np.ndarray]) -> bool:\n    if len(components) < 2:\n        return False\n    shapes = {_normalized_shape(coords) for coords in components}\n    return len(shapes) == 1 and all(_center_anchor(coords) is not None for coords in components)\n\n\ndef _non_collinear_three(points: list[Coord]) -> bool:\n    if len(points) != 3:\n        return True\n    (r0, c0), (r1, c1), (r2, c2) = points\n    return (r1 - r0) * (c2 - c0) != (r2 - r0) * (c1 - c0)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swap a connector segment with repeated marker sprites by connecting the marker anchors and stamping the sprite at the segment endpoints.\n\n    Input structure\n    The grid has one background color and exactly two foreground colors. One foreground color forms a single straight 8-connected segment. The other foreground color forms two or more identical centered sprites.\n\n    Rule\n    Build a background canvas of the same size. Draw straight connector-color segments between every pair of original sprite anchors. Then stamp the marker sprite, using its centered anchor, onto the two endpoints of the original connector segment.\n\n    Key insight\n    The original segment endpoints are the destinations for the repeated sprite, while the original sprite centers become the vertices of the new connector-color complete graph.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2\n\n    components_by_color = {\n        color: [\n            component[\"coords\"]\n            for component in find_components(g, bg=bg, colors=[color], connectivity=8)\n        ]\n        for color in colors\n    }\n\n    connector_colors = [\n        color\n        for color, components in components_by_color.items()\n        if len(components) == 1 and _segment_endpoints(components[0]) is not None\n    ]\n    sprite_colors = [\n        color\n        for color, components in components_by_color.items()\n        if _are_repeated_centered_sprites(components)\n    ]\n    assert len(connector_colors) == 1\n    assert len(sprite_colors) == 1\n\n    connector_color = connector_colors[0]\n    sprite_color = sprite_colors[0]\n    assert connector_color != sprite_color\n\n    endpoint_pair = _segment_endpoints(components_by_color[connector_color][0])\n    assert endpoint_pair is not None\n\n    sprite_components = components_by_color[sprite_color]\n    anchors: list[Coord] = []\n    for coords in sprite_components:\n        anchor = _center_anchor(coords)\n        assert anchor is not None\n        anchors.append(anchor)\n    assert _non_collinear_three(anchors), \"three repeated sprites must form a non-collinear triangle\"\n\n    reference_anchor = _center_anchor(sprite_components[0])\n    assert reference_anchor is not None\n    sprite_offsets = [\n        (int(r - reference_anchor[0]), int(c - reference_anchor[1]))\n        for r, c in sprite_components[0]\n    ]\n\n    out = np.full_like(g, bg)\n    for a, b in combinations(anchors, 2):\n        assert _straight_line_cells(a, b) is not None\n        draw_line(out, a[0], a[1], end_r=b[0], end_c=b[1], color=connector_color)\n\n    height, width = out.shape\n    for endpoint_r, endpoint_c in endpoint_pair:\n        for dr, dc in sprite_offsets:\n            r = endpoint_r + dr\n            c = endpoint_c + dc\n            assert 0 <= r < height and 0 <= c < width\n            out[r, c] = sprite_color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and colors.\nGRID_SIZE_MIN = 11\nGRID_SIZE_MAX = 16\nBACKGROUND_COLOR = 7\nFOREGROUND_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n\n# Symmetric sprite shape.\nSPRITE_HEIGHT_CHOICES = [1, 3, 3, 5, 5]\nSPRITE_WIDTH_CHOICES = [1, 3, 3, 5]\nSPRITE_DIM_SWAP_PROB = 0.5\nSPRITE_QUADRANT_FILL_PROB = 0.5\nSPRITE_BUILD_RETRIES = 50\n\n# Anchor layout.\nTHREE_SPRITE_PROB = 0.85\nANCHOR_LAYOUT_RETRIES = 100\nANCHOR_DIRECTIONS = ['h', 'v', 'd1', 'd2']\nTWO_ANCHOR_DIST_MIN = 3\nTWO_ANCHOR_DIST_MAX = 8\nTRIANGLE_DELTA_MIN = 3\nTRIANGLE_DELTA_MAX = 7\nTRIANGLE_ROTATIONS = [0, 1, 2, 3]\n\n# Connector segment.\nSEGMENT_RETRIES = 100\nSEGMENT_LENGTH_MIN = 6\nSEGMENT_LENGTH_MAX = 10\n\n# Overall retry budget.\nGENERATE_RETRIES = 300\n\n\ndef _gen2_symmetric_sprite(color):\n    \"\"\"Generate one connected LR+UD symmetric sprite with a filled center.\"\"\"\n    h = random.choice(SPRITE_HEIGHT_CHOICES)\n    w = random.choice(SPRITE_WIDTH_CHOICES)\n    if random.random() < SPRITE_DIM_SWAP_PROB:\n        h, w = w, h\n\n    if h == 1 and w == 1:\n        return np.array([[color]])\n\n    half_h = h // 2 + 1\n    half_w = w // 2 + 1\n    sprite = np.zeros((h, w), dtype=int)\n    cr, cc = h // 2, w // 2\n    sprite[cr, cc] = color\n\n    for r in range(half_h):\n        for c in range(half_w):\n            if random.random() < SPRITE_QUADRANT_FILL_PROB:\n                sprite[r, c] = color\n                sprite[r, w - 1 - c] = color\n                sprite[h - 1 - r, c] = color\n                sprite[h - 1 - r, w - 1 - c] = color\n\n    sprite[cr, cc] = color\n\n    from arc_utils import is_contiguous\n    mask = (sprite != 0)\n    if not mask.any():\n        sprite[cr, cc] = color\n        mask = (sprite != 0)\n    if not is_contiguous(mask, background=0, connectivity=8):\n        return None\n\n    if not np.any(sprite[0, :]) or not np.any(sprite[-1, :]):\n        return None\n    if not np.any(sprite[:, 0]) or not np.any(sprite[:, -1]):\n        return None\n\n    return sprite\n\n\ndef _gen_sprite_offsets(sprite):\n    h, w = sprite.shape\n    cr, cc = h // 2, w // 2\n    offsets = []\n    for r in range(h):\n        for c in range(w):\n            if sprite[r, c] != 0:\n                offsets.append((r - cr, c - cc))\n    return offsets\n\n\ndef _gen_sprite_cells_at(offsets, anchor_r, anchor_c):\n    return {(anchor_r + dr, anchor_c + dc) for dr, dc in offsets}\n\n\ndef _fits_in_grid(offsets, anchor_r, anchor_c, h, w):\n    for dr, dc in offsets:\n        r, c = anchor_r + dr, anchor_c + dc\n        if not (0 <= r < h and 0 <= c < w):\n            return False\n    return True\n\n\ndef _choose_sprite(sprite_color):\n    for _ in range(SPRITE_BUILD_RETRIES):\n        sprite = _gen2_symmetric_sprite(sprite_color)\n","exit_code":0,"status":"completed"}}
