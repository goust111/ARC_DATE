{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/1478ab18.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import Color, get_bg\nimport random\n\n\ndef _outline_from_missing_corner(\n    r0: int, c0: int, r1: int, c1: int, missing_corner: tuple[int, int]\n) -> set[tuple[int, int]]:\n    n = r1 - r0\n    outline: set[tuple[int, int]] = set()\n\n    if missing_corner == (r0, c0):\n        outline.update((r0, c) for c in range(c0, c1 + 1))\n        outline.update((r, c0) for r in range(r0, r1 + 1))\n        outline.update((r0 + i, c1 - i) for i in range(n + 1))\n    elif missing_corner == (r0, c1):\n        outline.update((r0, c) for c in range(c0, c1 + 1))\n        outline.update((r, c1) for r in range(r0, r1 + 1))\n        outline.update((r0 + i, c0 + i) for i in range(n + 1))\n    elif missing_corner == (r1, c0):\n        outline.update((r, c0) for r in range(r0, r1 + 1))\n        outline.update((r1, c) for c in range(c0, c1 + 1))\n        outline.update((r0 + i, c0 + i) for i in range(n + 1))\n    else:\n        assert missing_corner == (r1, c1)\n        outline.update((r, c1) for r in range(r0, r1 + 1))\n        outline.update((r1, c) for c in range(c0, c1 + 1))\n        outline.update((r0 + i, c1 - i) for i in range(n + 1))\n\n    return outline\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Paint the teal outline of the right triangle determined by the missing corner of the grey-marker square.\n\n    Input structure\n    The grid is an orange background with exactly four foreground marker pixels of one color. The markers have a square bounding box: three markers are bbox corners, and the fourth marker is inside that square.\n    Rule\n    Find the one corner of the marker bounding square that has no marker. That missing corner is the right-angle vertex of a right isosceles triangle; paint its two axis-aligned legs and the opposite diagonal in teal, leaving existing marker pixels unchanged.\n    Key insight\n    The present corner marker opposite the missing corner is a decoy; the three triangle vertices are the missing corner and the two marker corners adjacent to it.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    marker_colors = [int(c) for c in np.unique(g) if int(c) != bg]\n    assert len(marker_colors) == 1\n    marker = marker_colors[0]\n    assert marker != Color.TEAL and bg != Color.TEAL\n\n    marker_coords = np.argwhere(g == marker)\n    assert marker_coords.shape == (4, 2)\n    r0, c0 = marker_coords.min(axis=0)\n    r1, c1 = marker_coords.max(axis=0)\n    r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n    assert r1 - r0 == c1 - c0\n\n    corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}\n    marker_set = {tuple(map(int, coord)) for coord in marker_coords}\n    missing_corners = corners - marker_set\n    assert len(missing_corners) == 1\n    assert len(marker_set & corners) == 3\n\n    out = g.copy()\n    outline = _outline_from_missing_corner(r0, c0, r1, c1, missing_corners.pop())\n    for r, c in outline:\n        if out[r, c] == bg:\n            out[r, c] = Color.TEAL\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# --- CFG ---\nGRID_SIZE_MIN, GRID_SIZE_MAX = 7, 12  # square grid side range\nSIDE_MIN = 3                          # minimum marker-bbox side length\nMAX_RETRIES = 300                     # generate_input retry budget\n_NON_TEAL = [c for c in range(10) if c != Color.TEAL]\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Build a single candidate input grid, or None on layout conflict.\"\"\"\n    H = W = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n\n    # Pick bg and marker colors (neither may be teal)\n    bg = random.choice(_NON_TEAL)\n    marker_color = random.choice([c for c in _NON_TEAL if c != bg])\n\n    # Square bbox: side length S in [SIDE_MIN, H-1], placed randomly\n    S = random.randint(SIDE_MIN, H - 1)\n    r0 = random.randint(0, H - 1 - S)\n    c0 = random.randint(0, W - 1 - S)\n    r1, c1 = r0 + S, c0 + S\n\n    # Choose which bbox corner to omit; the 4th marker sits 1 diagonal\n    # step inward from the missing corner toward the opposite corner\n    corners = [(r0, c0), (r0, c1), (r1, c0), (r1, c1)]\n    idx = random.randint(0, 3)\n    missing = corners[idx]\n    opposite = corners[3 - idx]\n    dr = 1 if opposite[0] > missing[0] else -1\n    dc = 1 if opposite[1] > missing[1] else -1\n    inner = (missing[0] + dr, missing[1] + dc)\n\n    # Place markers\n    grid = np.full((H, W), bg, dtype=int)\n    for r, c in corners:\n        if (r, c) != missing:\n            grid[r, c] = marker_color\n    grid[inner] = marker_color\n\n    # Guard: exactly 4 foreground pixels (collision would reduce count)\n    if np.count_nonzero(grid != bg) != 4:\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is None:\n            continue\n        try:\n            out = main(grid)\n            if not np.array_equal(out, grid):\n                return grid\n        except Exception:\n            continue\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import find_components, get_bg, neighbors4, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n                frontier.append((rr, cc))\n    return frontier\n\n\ndef _grow_body(area):\n    choices = [\n        (h, w)\n        for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n        for w in _inclusive_range(_BODY_WIDTH_RANGE)\n        if h * w >= area\n    ]\n    h, w = random.choice(choices)\n    cells = set(random.choice(_GROW_BODY_SEEDS))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, h, w)\n        if not frontier:\n            return _grow_body(area)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n\n\ndef _symmetric_body(area):\n    choices = []\n    for height in _inclusive_range(_BODY_HEIGHT_RANGE):\n        extra = area - height\n        if extra >= 2 and extra % 2 == 0 and extra // 2 <= height:\n            choices.append((height, extra // 2))\n    if not choices:\n        return _grow_body(area)\n\n    height, pair_count = random.choice(choices)\n    cells = {(r, 1) for r in range(height)}\n    rows = list(range(height))\n    random.shuffle(rows)\n    for r in rows[:pair_count]:\n        cells.add((r, 0))\n        cells.add((r, 2))\n\n    if height >= _SYMMETRIC_TRANSPOSE_MIN_HEIGHT and random.random() < _SYMMETRIC_TRANSPOSE_PROB:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom collections import Counter, deque\n\nfrom arc_utils import components_mask, get_bg, is_contiguous, neighbors4, neighbors8, random_free_location\nimport random\n\n\ndef _flood(start: tuple[int, int], passable, h: int, w: int) -> set[tuple[int, int]]:\n    q = deque([start])\n    vis = {start}\n    while q:\n        r, c = q.popleft()\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in vis and passable(nr, nc):\n                vis.add((nr, nc))\n                q.append((nr, nc))\n    return vis\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Paint an inner border around the region reachable from a corner marker pixel.\n\n    Input structure:\n    - bg = most common color; wall color (blue) forms barriers dividing the grid.\n    - A unique single pixel (magenta) sits on one corner — the start marker.\n    - Some wall-colored pixels are structural (border-touching, enclosing regions); others are decorations.\n\n    Rule:\n    - Flood-fill from the marker corner to find all reachable bg cells, blocked by structural walls.\n    - Erase wall-colored decorations hidden behind structural walls (not reachable from marker side).\n    - Paint orange (color 7) on every reachable bg cell adjacent to a wall or grid edge — forming a 1-cell inner border.\n\n    Key insight: Only border-connected wall components act as real barriers; interior wall fragments are decorations to be removed.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Marker pixel is a unique (count==1) non-bg pixel on a corner.\n    counts = Counter(int(v) for v in g.ravel())\n    corners = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]\n    marker = None\n    for r, c in corners:\n        v = int(g[r, c])\n        if v != bg and counts.get(v, 0) == 1:\n            marker = (r, c, v)\n            break\n    assert marker is not None, \"no unique single-pixel corner marker found\"\n\n    mr, mc, marker_col = marker\n\n    # Wall color: most frequent non-bg, non-marker color.\n    other_cols = [c for c in counts.keys() if c not in (bg, marker_col)]\n    assert other_cols, \"no non-bg non-marker colors found; cannot determine wall color\"\n    wall_col = max(other_cols, key=lambda c: counts[c])\n\n    # First reach: treat all wall pixels as obstacles.\n    reach0 = _flood(\n        (mr, mc),\n        lambda r, c: int(g[r, c]) in (bg, marker_col),\n        h,\n        w,\n    )\n\n    # Structural walls are wall-color components that touch the border AND are adjacent to reach0.\n    walls: set[tuple[int, int]] = set()\n    for comp_arr in components_mask(g == wall_col, connectivity=4):\n        comp = [(int(r), int(c)) for r, c in comp_arr]\n        touches_border = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp)\n        if not touches_border:\n            continue\n        adjacent_to_reach0 = any(any((nr, nc) in reach0 for nr, nc in neighbors4(r, c)) for r, c in comp)\n        if adjacent_to_reach0:\n            walls |= set(comp)\n\n    # Second reach: allow passing through non-wall wall-color pixels (decorations) so they don't create borders.\n    reach = _flood(\n        (mr, mc),\n        lambda r, c: int(g[r, c]) in (bg, marker_col) or (int(g[r, c]) == wall_col and (r, c) not in walls),\n        h,\n        w,\n    )\n\n    # Remove wall-colored decorations that are not reachable (they lie behind structural walls).\n    for r in range(h):\n        for c in range(w):\n            if int(out[r, c]) == wall_col and (r, c) not in walls and (r, c) not in reach:\n                out[r, c] = bg\n\n    fill_col = 7\n    # Paint a 1-cell-thick inner border of the reachable region (on background cells only).\n    for r, c in reach:\n        if int(out[r, c]) != bg:\n            continue\n        if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n            out[r, c] = fill_col\n            continue\n        if any((nr, nc) in walls for nr, nc in neighbors8(r, c)):\n            out[r, c] = fill_col\n            continue\n        if any((nr, nc) not in reach for nr, nc in neighbors4(r, c)):\n            out[r, c] = fill_col\n\n    return out\n\n# --------------- generator (merged (attempts 1+2 hybrid)) ---------------\n\n# ---- Palette (task colors) ----\nBG = 8\nWALL = 1\nMARKER = 6\nFILL = 7\n\n# ---- Canvas size ----\nGRID_H_RANGE = (10, 20)\nGRID_W_RANGE = (10, 20)\n\n# ---- Structural walls ----\nNUM_STRUCTS_RANGE = (1, 4)\nSTRUCT_SHAPE_RETRIES = 8             # per-shape placement retries\nRECT_MAX_DIM_DIV = 3                 # rect max side ~ dim // 3\nTRI_MAX_SIZE = 6                     # diamond/triangle cap on size\nTRI_MIN_DIM_DIV = 3                  # diamond/top-tri need dim // 3\n\n# ---- Reachable region gate ----\nREACH_RATIO_RANGE = (0.38, 0.87)\n\n# ---- Decorations ----\nNUM_DECOR_RANGE = (0, 3)\nDECOR_AREA_RANGE = (1, 4)            # max pixel-extent of a single decor patch\nDECOR_BORDER = 1                     # stay >= N cells from grid edge\nDECOR_PADDING = 1                    # 8-conn separation from other occupancy\n\n# ---- Outer retry budget ----\nGEN_ATTEMPTS = 300\n\n\n# =============================================================================\n# Shape factories (each returns list[(r,c)] or None for a 4-contiguous shape\n# that touches at least one grid edge).\n# =============================================================================\n\ndef _shape_vertical_line(h, w, rng):\n    c = rng.randint(2, w - 2)\n    mode = rng.choice(['top', 'bottom', 'full'])\n    if mode == 'full':\n        r0, r1 = 0, h - 1\n    elif mode == 'top':\n        r0, r1 = 0, rng.randint(max(1, h // 3), h - 2)\n    else:\n        r0, r1 = rng.randint(1, h - max(2, h // 3)), h - 1\n    return [(r, c) for r in range(r0, r1 + 1)]\n\n\ndef _shape_horizontal_line(h, w, rng):\n    r = rng.randint(1, h - 2)\n    if rng.choice(['left', 'right']) == 'left':\n        c0, c1 = 0, rng.randint(max(1, w // 3), w - 2)\n    else:\n        c0, c1 = rng.randint(1, w - max(2, w // 3)), w - 1\n    return [(r, c) for c in range(c0, c1 + 1)]\n\n\ndef _shape_rectangle(h, w, rng):\n    rh = rng.randint(2, max(2, h // RECT_MAX_DIM_DIV))\n    rw = rng.randint(2, max(2, w // RECT_MAX_DIM_DIV))\n    anchor = rng.choice(['top', 'right', 'tr', 'top_mid', 'right_mid', 'bottom_right'])\n    if anchor == 'top':\n        r0, c0 = 0, rng.randint(1, max(1, w - rw - 1))\n    elif anchor == 'right':\n        r0, c0 = rng.randint(1, max(1, h - rh - 1)), w - rw\n    elif anchor == 'tr':\n        r0, c0 = 0, w - rw\n    elif anchor == 'top_mid':\n        r0, c0 = 0, rng.randint(2, max(2, w - rw - 2))\n    elif anchor == 'right_mid':\n        r0, c0 = rng.randint(2, max(2, h - rh - 2)), w - rw\n    else:\n        r0, c0 = h - rh, w - rw\n    return [(r, c) for r in range(r0, r0 + rh) for c in range(c0, c0 + rw)]\n\n\ndef _shape_left_diamond(h, w, rng):\n    \"\"\"Isoceles diamond attached to left edge.\"\"\"\n    max_size = min(TRI_MAX_SIZE, h // TRI_MIN_DIM_DIV, w // TRI_MIN_DIM_DIV)\n    if max_size < 3:\n        return None\n    size = rng.randint(3, max_size)\n    r_center = rng.randint(size, h - size - 1)\n    top = r_center - (size - 1)\n    cells = []\n    for i in range(size):\n        cells.extend((top + i, c) for c in range(i + 1))\n    for i in range(size - 1):\n        cells.extend((top + size + i, c) for c in range(size - 1 - i))\n    return cells\n\n\ndef _shape_top_triangle(h, w, rng):\n    \"\"\"Right triangle on top edge, widest at top.\"\"\"\n    max_size = min(TRI_MAX_SIZE, h // TRI_MIN_DIM_DIV, w // TRI_MIN_DIM_DIV)\n    if max_size < 2:\n        return None\n    size = rng.randint(2, max_size)\n    c_start = rng.randint(1, max(1, w - 2 * size))\n    cells = []\n    for i in range(size):\n        cells.extend((i, c) for c in range(c_start, c_start + size - i))\n    return cells\n\n\ndef _shape_right_triangle(h, w, rng):\n    \"\"\"Right triangle on right edge, widest at bottom.\"\"\"\n    max_size = min(TRI_MAX_SIZE, h // 2, w // 2)\n    if max_size < 2:\n        return None\n    size = rng.randint(2, max_size)\n    r_start = rng.randint(0, max(0, h - size - 1))\n    cells = []\n    for i in range(size):\n        length = i + 1\n        cells.extend((r_start + i, c) for c in range(w - length, w))\n    return cells\n\n\nSHAPE_FACTORIES = [\n    _shape_vertical_line,\n    _shape_horizontal_line,\n    _shape_rectangle,\n    _shape_left_diamond,\n    _shape_top_triangle,\n    _shape_right_triangle,\n]\n\n\n# =============================================================================\n# Primitives\n# =============================================================================\n\ndef _flood_mask(start, blocked, h, w):\n    \"\"\"BFS from `start` on the ~blocked bool grid; return reach as (h,w) bool array.\"\"\"\n    reach = np.zeros((h, w), dtype=bool)\n    reach[start] = True\n    q = deque([start])\n    while q:\n        r, c = q.popleft()\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and not reach[nr, nc] and not blocked[nr, nc]:\n                reach[nr, nc] = True\n                q.append((nr, nc))\n    return reach\n\n\ndef _touches_border(mask):\n    return mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any()\n\n","exit_code":0,"status":"completed"}}
