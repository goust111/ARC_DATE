{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/22806e14.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Mark the center of each odd-sized solid square with the plus marker color, erasing the marker only when it is outside the marked-center field.\n\n    Input structure:\n    - The dominant color is background.\n    - Exactly two foreground colors are present: one unique 3x3 plus marker and one color forming separated solid square objects.\n\n    Rule:\n    - For every non-marker 4-connected object, assert it is a solid square.\n    - If the square side length is odd, recolor its center pixel to the plus marker color; even-sided squares stay unchanged.\n    - Preserve the plus marker when its center lies inside the bounding box of the odd-square centers; otherwise erase it to background.\n\n    Key insight:\n    - Odd-sided solid squares have a single visible center pixel, and the plus supplies the color used to identify those centers.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n\n    markers = [comp for comp in comps if _is_plus_marker(comp)]\n    assert len(markers) == 1, \"grid must contain exactly one 5-pixel plus marker\"\n    marker = markers[0]\n    marker_color = int(marker[\"color\"])\n\n    fg_colors = set(map(int, g.flatten())) - {bg}\n    assert marker_color in fg_colors\n    object_colors = fg_colors - {marker_color}\n    assert len(object_colors) == 1, \"all solid square objects must share one non-marker color\"\n    object_color = object_colors.pop()\n\n    out = g.copy()\n    odd_centers: list[tuple[int, int]] = []\n\n    for comp in comps:\n        if comp is marker:\n            continue\n        assert int(comp[\"color\"]) == object_color, \"unexpected foreground object color\"\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        assert h == w, \"foreground objects must be square\"\n        assert int(comp[\"area\"]) == h * w, \"foreground square objects must be solid\"\n        if h % 2 == 1:\n            rr = int(r0 + h // 2)\n            cc = int(c0 + w // 2)\n            assert int(g[rr, cc]) == object_color\n            odd_centers.append((rr, cc))\n            out[rr, cc] = marker_color\n\n    assert odd_centers, \"at least one odd-sided square must be present\"\n    marker_r0, marker_c0, _marker_r1, _marker_c1 = marker[\"bbox\"]\n    marker_center = (int(marker_r0 + 1), int(marker_c0 + 1))\n    rows = [r for r, _c in odd_centers]\n    cols = [c for _r, c in odd_centers]\n    marker_is_in_center_field = (\n        min(rows) <= marker_center[0] <= max(rows)\n        and min(cols) <= marker_center[1] <= max(cols)\n    )\n\n    if not marker_is_in_center_field:\n        for r, c in marker[\"coords\"]:\n            out[int(r), int(c)] = bg\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# Canvas, palette, and retries.\nGRID_H, GRID_W, BACKGROUND_COLOR, MAX_GENERATION_ATTEMPTS, COLOR_RANGE = 16, 16, 7, 300, range(10)\n\n# Square counts and side lengths.\nODD_COUNT_RANGE, EVEN_COUNT_RANGE, TOTAL_SQUARE_RANGE = (2, 8), (1, 4), (5, 11)\nODD_SIDE_CHOICES, EVEN_SIDE_CHOICES = (1, 3, 5, 7), (2, 4, 6)\n\n# Component separation and plus-marker geometry.\nPLACEMENT_PADDING, PLACEMENT_CONNECTIVITY = 1, 8\nPLUS_SIZE, PLUS_CENTER_OFFSET = 3, 1\nPLUS_CELLS = ((0, 1), (1, 0), (1, 1), (1, 2), (2, 1))\n\n# Marker preservation branch weights.\nMARKER_PRESERVED_CHOICES = [True, False]\n\n\ndef _sample_square_sides():\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Look up query glyphs in a reference table and mark whether they form a line.\n\n    Input structure:\n    - Teal background with two full-width pink separator rows.\n    - Above the first separator is a query row of 5x5 glyph cells.\n    - Between separators is a reference table of the same 5x5 cells; a glyph is\n      identified by both its color and its 3x3 shape.\n\n    Rule:\n    - Green-fill the background inside every table cell whose glyph exactly\n      appears in the query row.\n    - If the matched table cells form one complete row or one complete column,\n      also green-fill the query band and the bottom verdict band.\n    - Otherwise leave the query band unchanged and fill the bottom verdict band red.\n\n    Key insight: The bottom color is not a count; it is the yes/no answer to\n    whether the queried glyphs align as a full row or column in the table.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n    cell_size = 5\n\n    sep_rows = _constant_non_bg_rows(g, bg)\n    assert len(sep_rows) >= 2, \"expected two full-width separator rows\"\n    top_sep = sep_rows[0]\n    bottom_sep = sep_rows[-1]\n\n    table_region = g[top_sep + 1 : bottom_sep, :]\n    table_fg = np.argwhere(table_region != bg)\n    assert table_fg.size, \"reference table must contain glyphs\"\n\n    first_glyph_r = top_sep + 1 + int(table_fg[:, 0].min())\n    first_glyph_c = int(table_fg[:, 1].min())\n    row0 = first_glyph_r - 1\n    col0 = first_glyph_c - 1\n\n    row_starts = list(range(row0, bottom_sep, cell_size))\n    row_starts = [r for r in row_starts if r + cell_size <= bottom_sep]\n    col_starts = list(range(col0, w, cell_size))\n    col_starts = [c for c in col_starts if c + cell_size <= w]\n    assert row_starts and col_starts, \"could not infer table cell grid\"\n\n    query_sigs = [\n        sig\n        for c in col_starts\n        if (sig := _cell_signature(g, 0, c, cell_size, bg)) is not None\n    ]\n    query_set = set(query_sigs)\n    assert len(query_sigs) == len(query_set), \"query glyphs should be distinct\"\n\n    out = g.copy()\n    selected: list[tuple[int, int]] = []\n    for ri, r in enumerate(row_starts):\n        for ci, c in enumerate(col_starts):\n            if _cell_signature(g, r, c, cell_size, bg) not in query_set:\n                continue\n            selected.append((int(ri), int(ci)))\n            cell = out[r : r + cell_size, c : c + cell_size]\n            cell[cell == bg] = 3\n\n    complete_query = len(query_sigs) == len(col_starts)\n    same_row = len({r for r, _c in selected}) == 1\n    same_col = len({c for _r, c in selected}) == 1\n    success = complete_query and len(selected) == len(query_sigs) and (same_row or same_col)\n\n    if success:\n        query_band = out[:top_sep, :]\n        query_band[query_band == bg] = 3\n        out[bottom_sep + 1 :, :] = 3\n    else:\n        out[bottom_sep + 1 :, :] = 2\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# -- Grid layout --\nGRID_H, GRID_W = 30, 22       # fixed canvas size\nTOP_SEP_ROW = 5                # query-band separator row\nBOTTOM_SEP_ROW = 27            # table-bottom separator row\nQUERY_BAND_H = 5               # height of query band (rows 0..4)\nVERDICT_ROW = 28               # verdict band starts here\n\n# -- Colors --\nBG = 8                         # teal background\nGREEN = 3                      # success / match highlight\nRED = 2                        # fail verdict\nSEP = 6                        # separator row color\nGLYPH_COLORS = (0, 1, 2, 4, 5, 6, 7, 9)  # 8 available glyph colors\n\n# -- Table geometry --\nTABLE_DIM = 4                  # 4x4 grid of cells\nCELL = 5                       # each cell is 5x5\nROWS = (7, 12, 17, 22)        # row offsets for 4 table rows\nCOLS = (1, 6, 11, 16)         # col offsets for 4 table columns\n\n# -- Glyph shape --\nFILL_MIN, FILL_MAX = 5, 9     # filled-pixel range per 3x3 glyph\nSHAPE_BASE_COUNTS = {5: 2, 6: 2, 7: 2, 8: 2, 9: 1}  # min shapes per fill-count\nMAX_SHAPES_PER_FILL = 5       # cap during random top-up\n\n# -- Color distribution --\nCOLOR_MIN, COLOR_MAX = 1, 3   # each color used 1-3 times across 16 cells\n\n# -- Outcome probabilities --\nP_SUCCESS = 0.4               # chance of success outcome\nP_QUERY_3 = 0.35              # chance of 3-query fail (vs 4-query fail)\nFAIL_MODES = (\"rect\", \"bent_row\", \"bent_col\", \"scatter_rows\", \"scatter_cols\")\n\n# -- Generation --\nMAX_RETRIES = 300\n\n\ndef _has_full_bbox(mask: int) -> bool:\n","exit_code":0,"status":"completed"}}
