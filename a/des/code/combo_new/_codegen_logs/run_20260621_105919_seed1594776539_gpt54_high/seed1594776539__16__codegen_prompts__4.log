pend((nr,nc))\n        out.append(pts)\n    return out\n\n\ndef unique_rot_count(mask):\n    seen=set()\n    for k in range(4):\n        m=tight(np.rot90(mask,k))\n        seen.add((m.shape,m.tobytes()))\n    return len(seen)\n\n\ndef centroid_score(mask):\n    pts=np.argwhere(mask)\n    return (float(pts[:,0].mean()), float(pts[:,1].mean()))\n\n\ndef canonicalize(mask):\n    base=tight(mask)\n    cands=[]\n    for k in range(4):\n        m=tight(np.rot90(base,k))\n        h,w=m.shape\n        cent=centroid_score(m)\n        cands.append(((0 if w>=h else 1, cent[0], cent[1], m.shape, m.tobytes()), m))\n    cands.sort(key=lambda x: x[0])\n    return cands[0][1]\n\n\ndef find_indicator(g,bg):\n    h,w=g.shape\n    corners=[(0,0),(0,max(0,w-2)),(max(0,h-2),0),(max(0,h-2),max(0,w-2))]\n    cand=[]\n    for r0,c0 in corners:\n        for r in range(r0,min(h,r0+2)):\n            for c in range(c0,min(w,c0+2)):\n                if g[r,c]==bg:\n                    continue\n                isolated=True\n                for rr in range(max(0,r-1), min(h,r+2)):\n                    for cc in range(max(0,c-1), min(w,c+2)):\n                        if (rr,cc)\"'!=(r,c) and g[rr,cc]!=bg:\n                            isolated=False\n                if isolated:\n                    cand.append((r,c,int(g[r,c])))\n    return cand\n\n\ndef solve(grid):\n    g=np.asarray(grid,dtype=int)\n    bg=get_bg(g)\n    inds=find_indicator(g,bg)\n    assert len(inds)==1, inds\n    ir,ic,out_color=inds[0]\n    fg=(g!=bg).copy()\n    fg[ir,ic]=False\n    b=bbox(fg)\n    assert b is not None\n    comp=g[b[0]:b[2]+1,b[1]:b[3]+1]\n    assert comp.shape[0]==comp.shape[1], comp.shape\n    colors=[int(c) for c in np.unique(comp) if c!=bg]\n    vis={c:(comp==c) for c in colors}\n    canons={}\n    for ks in itertools.product(range(4), repeat=len(colors)):\n        support=np.zeros(comp.shape,dtype=bool)\n        for c,k in zip(colors,ks):\n            support |= np.rot90(vis[c], -k)\n        fulls={c:np.rot90(support, k) for c,k in zip(colors,ks)}\n        for order in itertools.permutations(colors):\n            visible={}\n            covered=np.zeros(comp.shape,dtype=bool)\n            for c in reversed(order):\n                # iterate top -> bottom? if order is bottom->top, reverse gives top..bottom? actually visible of c = fulls[c] & ~covered_above; if iterate top->bottom, covered accum top seen so far.\n                pass\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
