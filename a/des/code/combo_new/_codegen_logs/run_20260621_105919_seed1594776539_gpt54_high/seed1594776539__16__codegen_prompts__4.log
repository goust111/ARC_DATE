{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools, random\nfrom collections import Counter\nimport numpy as np\n\n\ndef get_bg(g):\n    vals, counts = np.unique(g, return_counts=True)\n    return int(vals[np.argmax(counts)])\n\n\ndef bbox(mask):\n    pts = np.argwhere(mask)\n    if len(pts)==0:\n        return None\n    r0,c0 = pts.min(axis=0)\n    r1,c1 = pts.max(axis=0)\n    return int(r0),int(c0),int(r1),int(c1)\n\n\ndef crop(arr, b):\n    r0,c0,r1,c1 = b\n    return arr[r0:r1+1, c0:c1+1]\n\n\ndef tight(mask):\n    b = bbox(mask)\n    return crop(mask, b) if b else mask[:0,:0]\n\n\ndef neighbors4(r,c,h,w):\n    if r>0: yield r-1,c\n    if r+1<h: yield r+1,c\n    if c>0: yield r,c-1\n    if c+1<w: yield r,c+1\n\n\ndef connected_mask(h,w,target):\n    mask=np.zeros((h,w),dtype=bool)\n    steps=['D']*(h-1)+['R']*(w-1)\n    random.shuffle(steps)\n    r=c=0\n    mask[r,c]=True\n    for s in steps:\n        if s=='D': r+=1\n        else: c+=1\n        mask[r,c]=True\n    if mask.sum()>target: return None\n    frontier=set()\n    def add(rr,cc):\n        for nr,nc in neighbors4(rr,cc,h,w):\n            if not mask[nr,nc]: frontier.add((nr,nc))\n    for rr,cc in np.argwhere(mask): add(int(rr),int(cc))\n    while mask.sum()<target:\n        if not frontier: return None\n        rr,cc = random.choice(tuple(frontier))\n        frontier.remove((rr,cc))\n        mask[rr,cc]=True\n        add(rr,cc)\n    return mask\n\n\ndef unique_rotations(mask):\n    seen=[]\n    out=[]\n    for k in range(4):\n        m=tight(np.rot90(mask,k))\n        key=(m.shape,m.tobytes())\n        if key not in seen:\n            seen.append(key)\n            out.append(m)\n    return out\n\n\ndef centroid_score(mask):\n    pts=np.argwhere(mask)\n    return (float(pts[:,0].mean()), float(pts[:,1].mean()))\n\n\ndef canonicalize(mask):\n    base=tight(mask)\n    cands=[]\n    for k in range(4):\n        m=tight(np.rot90(base,k))\n        h,w=m.shape\n        cent=centroid_score(m)\n        cands.append(((0 if w>=h else 1, cent[0], cent[1], m.shape, tuple(m.ravel().tolist())), m))\n    cands.sort(key=lambda x: x[0])\n    return cands[0][1]\n\n\ndef find_indicator(g,bg):\n    h,w=g.shape\n    corners=[(0,0),(0,w-2),(h-2,0),(h-2,w-2)]\n    cand=[]\n    for r0,c0 in corners:\n        for r in range(max(0,r0), min(h,r0+2)):\n            for c in range(max(0,c0), min(w,c0+2)):\n                if g[r,c]==bg: continue\n                # singleton component heuristic\n                touch=False\n                for rr in range(max(0,r-1), min(h,r+2)):\n                    for cc in range(max(0,c-1), min(w,c+2)):\n                        if (rr,cc)\"'!=(r,c) and g[rr,cc]!=bg:\n                            touch=True\n                if not touch:\n                    cand.append((r,c,int(g[r,c])))\n    return cand\n\n\ndef solve(grid):\n    g=np.asarray(grid,dtype=int)\n    bg=get_bg(g)\n    inds=find_indicator(g,bg)\n    if len(inds)!=1:\n        raise AssertionError(('\"'indicator',inds))\n    ir,ic,ocol=inds[0]\n    mask=(g\"'!=bg).copy()\n    mask[ir,ic]=False\n    b=bbox(mask)\n    if b is None: raise AssertionError('\"'no composite')\n    r0,c0,r1,c1=b\n    comp=g[r0:r1+1,c0:c1+1].copy()\n    assert comp.shape[0]==comp.shape[1], comp.shape\n    colors=[int(c) for c in np.unique(comp) if c\"'!=bg]\n    vis={c:(comp==c) for c in colors}\n    cands=[]\n    for ks in itertools.product(range(4), repeat=len(colors)):\n        full_support=np.zeros(comp.shape,dtype=bool)\n        for c,k in zip(colors,ks):\n            full_support |= np.rot90(vis[c], -k)\n        fulls={c:np.rot90(full_support,k) for c,k in zip(colors,ks)}\n        for order in itertools.permutations(colors):\n            above=np.zeros(comp.shape,dtype=bool)\n            ok=True\n            for c in reversed(order):\n                # easier compute top-down? let'\"'s do from topmost downward? Actually order bottom->top.\n                pass\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
