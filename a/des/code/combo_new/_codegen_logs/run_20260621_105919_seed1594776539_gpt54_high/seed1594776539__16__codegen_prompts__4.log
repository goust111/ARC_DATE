{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '8,720p' /home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill holes in a target object with colors from a source object's subsprites, then tight-crop.\n\n    Input structure:\n    - bg = background. Two similar 8-connected objects share an outline color.\n    - Source has colored subsprites in cavities; target has empty cavities.\n\n    Rule:\n    - Find the two 8-connected objects.\n    - Target = object with more hole area. Align subsprites to holes (rotation/flip if needed).\n    - Fill each hole with its matched subsprite color; tight-crop.\n\n    Key insight: Hole centers in the target are matched to source subsprite centers under the best rotation/flip transform.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    def _components(mask: np.ndarray) -> list[dict]:\n        lab, n = label_mask(mask, connectivity=8)\n        comps = []\n        for cid in range(1, int(n) + 1):\n            pts = np.argwhere(lab == int(cid))\n            if pts.size == 0:\n                continue\n            r0, c0 = pts.min(axis=0)\n            r1, c1 = pts.max(axis=0)\n            comps.append(\n                {\n                    \"cid\": int(cid),\n                    \"pts\": pts,\n                    \"size\": int(len(pts)),\n                    \"cent\": (float(pts[:, 0].mean()), float(pts[:, 1].mean())),\n                    \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n                }\n            )\n        comps.sort(key=lambda d: int(d[\"size\"]), reverse=True)\n        return comps\n\n    def _extract_two_objects():\n        comps = _components(g != int(bg))\n        if len(comps) < 2:\n            return [comps]\n        return [[comps[0]], [comps[1]]]\n\n    def _bbox_of(group: list[dict]) -> tuple[int, int, int, int]:\n        r0 = min(int(d[\"bbox\"][0]) for d in group)\n        c0 = min(int(d[\"bbox\"][1]) for d in group)\n        r1 = max(int(d[\"bbox\"][2]) for d in group)\n        c1 = max(int(d[\"bbox\"][3]) for d in group)\n        return int(r0), int(c0), int(r1), int(c1)\n\n    def _extract_group_subgrid(group: list[dict]) -> np.ndarray:\n        r0, c0, r1, c1 = _bbox_of(group)\n        sub = np.full((int(r1 - r0 + 1), int(c1 - c0 + 1)), int(bg), dtype=int)\n        for d in group:\n            for rr, cc in d[\"pts\"]:\n                sub[int(rr) - int(r0), int(cc) - int(c0)] = int(g[int(rr), int(cc)])\n        return sub\n\n    def _enclosed_bg_components(sub: np.ndarray) -> list[dict]:\n        m = sub == int(bg)\n        lab, n = label_mask(m, connectivity=4)\n        Hs, Ws = sub.shape\n        holes = []\n        for cid in range(1, int(n) + 1):\n            pts = np.argwhere(lab == int(cid))\n            if pts.size == 0:\n                continue\n            r0, c0 = pts.min(axis=0)\n            r1, c1 = pts.max(axis=0)\n            if bool(r0 == 0 or c0 == 0 or r1 == int(Hs - 1) or c1 == int(Ws - 1)):\n                continue\n            cent = (int(round(float(pts[:, 0].mean()))), int(round(float(pts[:, 1].mean()))))\n            holes.append({\"pts\": pts, \"cent\": cent, \"size\": int(len(pts))})\n        return holes\n\n    def _outline_col(sub: np.ndarray) -> int:\n        cnt = Counter(map(int, sub.flatten()))\n        opts = [(c, n) for c, n in cnt.items() if int(c) != int(bg)]\n        return int(max(opts, key=lambda t: t[1])[0]) if opts else int(bg)\n\n    def _colored_components(sub: np.ndarray) -> list[dict]:\n        outc = _outline_col(sub)\n        m = (sub != int(bg)) & (sub != int(outc))\n        lab, n = label_mask(m, connectivity=4)\n        subs = []\n        for cid in range(1, int(n) + 1):\n            pts = np.argwhere(lab == int(cid))\n            if pts.size == 0:\n                continue\n            col = Counter(map(int, sub[lab == int(cid)].flatten())).most_common(1)[0][0]\n            cent = (int(round(float(pts[:, 0].mean()))), int(round(float(pts[:, 1].mean()))))\n            subs.append({\"cent\": cent, \"color\": int(col)})\n        return subs\n\n    def _rank_keys(pts: list[tuple[int, int]]):\n        rows = sorted(set(int(r) for r, _c in pts))\n        cols = sorted(set(int(c) for _r, c in pts))\n        rrank = {r: i for i, r in enumerate(rows)}\n        crank = {c: i for i, c in enumerate(cols)}\n        keys = [(int(rrank[r]), int(crank[c])) for r, c in pts]\n        return keys, rrank, crank\n\n    def _transform_point(p: tuple[int, int], H0: int, W0: int, k: int, flip: bool) -> tuple[int, int]:\n        r, c = int(p[0]), int(p[1])\n        if int(k) == 0:\n            rr, cc = int(r), int(c)\n            H2, W2 = int(H0), int(W0)\n        elif int(k) == 1:\n            rr, cc = int(W0 - 1 - c), int(r)\n            H2, W2 = int(W0), int(H0)\n        elif int(k) == 2:\n            rr, cc = int(H0 - 1 - r), int(W0 - 1 - c)\n            H2, W2 = int(H0), int(W0)\n        else:\n            rr, cc = int(c), int(H0 - 1 - r)\n            H2, W2 = int(W0), int(H0)\n        if bool(flip):\n            cc = int(W2 - 1 - cc)\n        return int(rr), int(cc)\n\n    groups = _extract_two_objects()\n    assert not (len(groups) < 2)\n    objs = [_extract_group_subgrid(grp) for grp in groups]\n\n    holes_list = [_enclosed_bg_components(o) for o in objs]\n    hole_area = [sum(int(h[\"size\"]) for h in hh) for hh in holes_list]\n    dest_i = int(np.argmax(hole_area))\n    src_i = int(1 - dest_i)\n    dest = objs[dest_i].copy()\n    src = objs[src_i].copy()\n\n    dest_holes = _enclosed_bg_components(dest)\n    src_subs = _colored_components(src)\n    if not dest_holes or not src_subs:\n        m = dest != int(bg)\n        pts = np.argwhere(m)\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        return dest[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]\n\n    dest_pts = [h[\"cent\"] for h in dest_holes]\n    dest_keys, d_rr, d_cc = _rank_keys(dest_pts)\n\n    best = None\n    for k in range(4):\n        for flip in [False, True]:\n            tpts = [_transform_point(s[\"cent\"], int(src.shape[0]), int(src.shape[1]), int(k), bool(flip)) for s in src_subs]\n            tkeys, _s_rr, _s_cc = _rank_keys(tpts)\n            if sorted(tkeys) == sorted(dest_keys):\n                best = (int(k), bool(flip))\n                break\n        if best is not None:\n            break\n    if best is None:\n        best = (0, False)\n    k, flip = best\n\n    # Build ordered lists and pair them deterministically.\n    dest_list = []\n    for h in dest_holes:\n        key = (int(d_rr[int(h[\"cent\"][0])]), int(d_cc[int(h[\"cent\"][1])]))\n        dest_list.append((key, h[\"cent\"], h))\n    dest_list.sort(key=lambda t: (t[0][0], t[0][1], t[1][0], t[1][1]))\n\n    tpts_all = [_transform_point(s[\"cent\"], int(src.shape[0]), int(src.shape[1]), int(k), bool(flip)) for s in src_subs]\n    _keys, s_rr, s_cc = _rank_keys(tpts_all)\n\n    src_list = []\n    for s in src_subs:\n        tp = _transform_point(s[\"cent\"], int(src.shape[0]), int(src.shape[1]), int(k), bool(flip))\n        key = (int(s_rr[int(tp[0])]), int(s_cc[int(tp[1])]))\n        src_list.append((key, tp, int(s[\"color\"])))\n    src_list.sort(key=lambda t: (t[0][0], t[0][1], t[1][0], t[1][1]))\n\n    for (_k1, _p1, col), (_k2, _p2, h) in zip(src_list, dest_list):\n        for rr, cc in h[\"pts\"]:\n            dest[int(rr), int(cc)] = int(col)\n\n    # Tight crop to non-background.\n    m = dest != int(bg)\n    pts = np.argwhere(m)\n    r0, c0 = pts.min(axis=0)\n    r1, c1 = pts.max(axis=0)\n    return dest[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]\n\n# --------------- generator (Claude#1+refactor) ---------------\n\nCANVAS_SIZE_RANGE = (22, 30)           # canvas H/W range\nOBJECT_H_RANGE = (7, 17)               # src/dst object height bounds\nOBJECT_W_RANGE = (7, 13)               # src/dst object width bounds\n\n# Cavity structure\nCAVITY_COUNT_RANGE = (4, 9)            # number of cavities per object\nFILL_COLOR_COUNT_RANGE = (3, 7)        # number of distinct fill colors\n\n# Layout row patterns (weighted choices)\nROW_HEIGHT_CHOICES = [1, 2, 2, 3, 3, 3]           # per-row cavity height\nLAYOUT_K_CHOICES_FULL = [1, 2, 2, 3, 3]           # k=1 centered, k=2 pair, k=3 L+C+R\nLAYOUT_K_CHOICES_SMALL = [1, 2, 2]                # when remaining budget <= 2\nROW_GAP_CHOICES = [1, 1, 2]                       # empty rows between cavity rows\n\n# Cavity slot widths per layout type\nCENTERED_SLOT_WIDTHS = [3, 3, 5, 5, 7]            # k=1 (odd widths only)\nPAIR_SLOT_WIDTHS = [2, 2, 3, 3, 4]                # k=2 per-slot width\nSIDE_SLOT_WIDTHS = [2, 2, 3]                      # k=3 side slot width\nMID_SLOT_WIDTHS = [1, 3]                          # k=3 center slot width (odd)\nPAIR_AXIS_GAP_CHOICES = [1, 1, 3]                 # k=2 empty cols at axis (forced odd)\nTRIO_MID_SIDE_GAP = 1                             # k=3 empty cols between center and side\n\n# Shape mutation\nNONRECT_PROBABILITY = 0.8              # P(cavity is non-rectangular, else solid rect)\nMAX_MUTATE_ATTEMPTS = 40               # iterations per shape mutation\n\n# Color assignment\nCOLOR_MISMATCH_RATE = 0.10             # P(cavity breaks mirror-pair color sharing)\n\n# Placement\nPLACEMENT_BORDER = 1                   # min distance from canvas border\nPLACEMENT_PADDING = 2                  # min gap between src and dst objects\n\n# Generation retry\nMAX_GEN_ATTEMPTS = 300                 # outer retry loop for generate_input()\nMAX_LAYOUT_R_BUDGET = 24               # layout design vertical budget (before crop)\n\n\n# =============================================================================\n# Shape primitives\n# =============================================================================\n\ndef _random_rect_shape(h: int, w: int) -> np.ndarray:\n    \"\"\"Solid rectangle h x w of booleans.\"\"\"\n    return np.ones((h, w), dtype=bool)\n\n\ndef _mutate_shape(mask: np.ndarray, *, n_remove_max: int, symmetric: bool = False) -> np.ndarray:\n    \"\"\"Remove boundary cells from a rect mask while preserving 4-connectivity.\n    Keeps the original (h, w) bbox; removed cells become False but array shape is unchanged.\n    If symmetric=True, mirror-pair removals so the mask stays LR-symmetric.\n    \"\"\"\n    m = mask.copy()\n    H, W = m.shape\n    n_remove = random.randint(1, max(1, n_remove_max))\n    tried = 0\n    removed = 0\n    while removed < n_remove and tried < MAX_MUTATE_ATTEMPTS:\n        tried += 1\n        # Find boundary cells (cells with <=2 in-mask 4-neighbors).\n        cand = []\n        for r in range(H):\n            for c in range(W):\n                if not m[r, c]:\n                    continue\n                nb = 0\n                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < H and 0 <= nc < W and m[nr, nc]:\n                        nb += 1\n                if nb <= 2:\n                    cand.append((r, c))\n        if not cand:\n            break\n        r, c = random.choice(cand)\n        to_remove = [(r, c)]\n        if symmetric:\n            mc = W - 1 - c\n            if (r, mc) != (r, c):\n                to_remove.append((r, mc))\n        m2 = m.copy()\n        for rr, cc in to_remove:\n            m2[rr, cc] = False\n        if not m2.any():\n            continue\n        _, n_components = label_mask(m2, connectivity=4)\n        if int(n_components) == 1:\n            m = m2\n            removed += len(to_remove)\n    if not m.any():\n        return mask.copy()\n    return m\n\n\ndef _gen_shape(h: int, w: int, *, nonrect: bool, symmetric: bool = False) -> np.ndarray:\n    \"\"\"Build a cavity shape. If symmetric=True, the result is LR-symmetric.\"\"\"\n    m = _random_rect_shape(h, w)\n    if nonrect and h * w >= 3:\n        # Remove up to half the area; symmetric mutations consume cells in pairs.\n        limit = max(1, (h * w) // 2)\n        m = _mutate_shape(m, n_remove_max=limit, symmetric=symmetric)\n    return m\n\n\ndef _mirror_shape(m: np.ndarray) -> np.ndarray:\n    return m[:, ::-1].copy()\n\n\ndef _gen_dst_src_pair(h: int, w: int, *, symmetric: bool) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Independently mutate two cavity shapes (dst + src) sharing the same (h, w) bbox.\n    This drives src subsprites and dst holes to have visibly different shapes, as required\n    by the spec (the task matches by centroid rank, not shape).\n    \"\"\"\n    nonrect = random.random() < NONRECT_PROBABILITY\n    return (_gen_shape(h, w, nonrect=nonrect, symmetric=symmetric),\n            _gen_shape(h, w, nonrect=nonrect, symmetric=symmetric))\n\n\n# =============================================================================\n# Layout design — LR-symmetric cavity arrangements\n# =============================================================================\n#\n# Slot dict fields:\n#   r0          : top row in layout coordinate space\n#   col_offset  : leftmost column relative to the LR symmetry axis\n#   shape_dst   : boolean mask for dst's version of this cavity\n#   shape_src   : boolean mask for src's version (independently mutated)\n#   pair_id     : mirror-pair identifier — slots sharing a pair_id are LR mirrors\n#                 (used to give them matching fill colors by default)\n# =============================================================================\n\ndef _add_centered_slot(slots: list[dict], cur_r: int, pair_id: int, row_h: int) -> None:\n    \"\"\"k=1: single cavity centered on the LR axis (odd width, LR-symmetric shape).\"\"\"\n    w = random.choice(CENTERED_SLOT_WIDTHS)\n    dst, src = _gen_dst_src_pair(row_h, w, symmetric=True)\n    slots.append({\n        'r0': cur_r, 'col_offset': -(w // 2),\n        'shape_dst': dst, 'shape_src': src, 'pair_id': pair_id,\n    })\n\n\ndef _add_mirror_pair_slots(slots: list[dict], cur_r: int, pair_id: int, row_h: int) -> None:\n    \"\"\"k=2: left + right mirror pair with an odd empty-column gap at the axis.\"\"\"\n    w = random.choice(PAIR_SLOT_WIDTHS)\n    dst_L, src_L = _gen_dst_src_pair(row_h, w, symmetric=False)\n    dst_R = _mirror_shape(dst_L)\n    src_R = _mirror_shape(src_L)\n    axis_gap = random.choice(PAIR_AXIS_GAP_CHOICES)\n    if axis_gap % 2 == 0:\n        axis_gap += 1  # force odd so axis lies on a single column\n    half = axis_gap // 2\n    slots.append({\n        'r0': cur_r, 'col_offset': -(half + w),\n        'shape_dst': dst_L, 'shape_src': src_L, 'pair_id': pair_id,\n    })\n    slots.append({\n        'r0': cur_r, 'col_offset': half + 1,\n        'shape_dst': dst_R, 'shape_src': src_R, 'pair_id': pair_id,\n    })\n\n\ndef _add_trio_slots(slots: list[dict], cur_r: int, pair_id: int, row_h: int) -> None:\n    \"\"\"k=3: L + centered + R. Center slot has odd width and uses its own pair_id.\"\"\"\n    w_side = random.choice(SIDE_SLOT_WIDTHS)\n    w_mid = random.choice(MID_SLOT_WIDTHS)\n    dst_L, src_L = _gen_dst_src_pair(row_h, w_side, symmetric=False)\n    dst_R = _mirror_shape(dst_L)\n    src_R = _mirror_shape(src_L)\n    dst_M, src_M = _gen_dst_src_pair(row_h, w_mid, symmetric=True)\n    mid_half = w_mid // 2\n    slots.append({\n        'r0': cur_r, 'col_offset': -(mid_half + w_side + TRIO_MID_SIDE_GAP),\n        'shape_dst': dst_L, 'shape_src': src_L, 'pair_id': pair_id,\n    })\n    slots.append({\n        'r0': cur_r, 'col_offset': -mid_half,\n        'shape_dst': dst_M, 'shape_src': src_M, 'pair_id': pair_id + 1,\n    })\n    slots.append({\n        'r0': cur_r, 'col_offset': mid_half + TRIO_MID_SIDE_GAP + 1,\n        'shape_dst': dst_R, 'shape_src': src_R, 'pair_id': pair_id,\n    })\n\n\ndef _pick_layout_k(budget: int) -> int:\n    \"\"\"Pick the layout pattern for the current row, given remaining cavity budget.\"\"\"\n    if budget == 1:\n        return 1\n    if budget == 2:\n        return random.choice(LAYOUT_K_CHOICES_SMALL)\n    return random.choice(LAYOUT_K_CHOICES_FULL)\n\n\ndef _design_layout(n_target: int) -> list[dict]:\n    \"\"\"Return an LR-symmetric list of cavity slots with a total count near n_target.\"\"\"\n    slots: list[dict] = []\n    cur_r = 0\n    pair_id = 0\n    budget = n_target\n    while len(slots) < n_target and cur_r < MAX_LAYOUT_R_BUDGET and budget > 0:\n        row_h = random.choice(ROW_HEIGHT_CHOICES)\n        k = _pick_layout_k(budget)\n        if k == 1:\n            _add_centered_slot(slots, cur_r, pair_id, row_h)\n            pair_id += 1\n            budget -= 1\n        elif k == 2:\n            _add_mirror_pair_slots(slots, cur_r, pair_id, row_h)\n            pair_id += 1\n            budget -= 2\n        else:\n            _add_trio_slots(slots, cur_r, pair_id, row_h)\n            pair_id += 2  # trio uses 2 pair_ids (outer pair + center)\n            budget -= 3\n        cur_r += row_h + random.choice(ROW_GAP_CHOICES)\n    return slots\n\n\n# =============================================================================\n# Rendering — turn a layout + shapes + colors into an object patch\n# =============================================================================\n\ndef _render_object(\n    layout: list[dict], shapes: list[np.ndarray], colors: list[int],\n    bg: int, outline_col: int, *, filled: bool,\n) -> tuple[np.ndarray | None, np.ndarray | None]:\n    \"\"\"Render an object (src or dst) onto a tight canvas.\n\n    Returns (cropped, filled_cropped):\n      - cropped        : the object, with cavities painted bg if filled=False else fill-colored\n      - filled_cropped : same object, ALWAYS with cavities fill-colored (used as the\n                         expected main() output for dst)\n\n    Returns (None, None) if there are no fill cells.\n    \"\"\"\n    # Compute layout bbox across all cavity cells.\n    placed_slots = []\n    for slot_idx, (slot, sh) in enumerate(zip(layout, shapes)):\n        rr, cc = np.where(sh)\n        if len(rr) == 0:\n            continue\n        placed_slots.append((slot_idx, slot['r0'] + rr, slot['col_offset'] + cc))\n    if not placed_slots:\n        return None, None\n\n    all_rows = np.concatenate([p[1] for p in placed_slots])\n    all_cols = np.concatenate([p[2] for p in placed_slots])\n    r_min, r_max = int(all_rows.min()), int(all_rows.max())\n    c_min, c_max = int(all_cols.min()), int(all_cols.max())\n\n    pad = 2\n    H = (r_max - r_min + 1) + 2 * pad\n    W = (c_max - c_min + 1) + 2 * pad\n\n    canvas = np.full((H, W), bg, dtype=int)\n    fill_mask = np.zeros((H, W), dtype=bool)\n    for slot_idx, rows, cols in placed_slots:\n        rr = rows - r_min + pad\n        cc = cols - c_min + pad\n        canvas[rr, cc] = colors[slot_idx]\n        fill_mask[rr, cc] = True\n\n    # Vectorized 4-neighbor outline = cells adjacent to any fill cell but not fill themselves.\n    outline_mask = np.zeros_like(fill_mask)\n    outline_mask[1:, :]  |= fill_mask[:-1, :]\n    outline_mask[:-1, :] |= fill_mask[1:, :]\n    outline_mask[:, 1:]  |= fill_mask[:, :-1]\n    outline_mask[:, :-1] |= fill_mask[:, 1:]\n    outline_mask &= ~fill_mask\n    canvas[outline_mask] = outline_col\n\n    filled_grid = canvas.copy()\n    if not filled:\n        canvas[fill_mask] = bg\n\n    b = bbox(canvas != bg)\n    if b is None:\n        return None, None\n    cropped = crop_bbox(canvas, b)\n    r0b, c0b, r1b, c1b = b\n    filled_cropped = filled_grid[r0b:r1b + 1, c0b:c1b + 1]\n    return cropped, filled_cropped\n\n\n# =============================================================================\n# Validation helpers\n# =============================================================================\n\ndef _count_4conn_cavities(filled_grid: np.ndarray, bg: int, outline_col: int) -> int:\n    \"\"\"Count 4-connected non-bg non-outline components (i.e. filled cavities).\"\"\"\n    mask = (filled_grid != bg) & (filled_grid != outline_col)\n    _, n = label_mask(mask, connectivity=4)\n    return int(n)\n\n\ndef _count_enclosed_bg_holes(empty_grid: np.ndarray, bg: int) -> int:\n    \"\"\"Count 4-connected bg components fully enclosed by non-bg cells (not touching border).\"\"\"\n    mask = (empty_grid == bg)\n    lab, n = label_mask(mask, connectivity=4)\n    H, W = empty_grid.shape\n    count = 0\n    for cid in range(1, int(n) + 1):\n        pts = np.argwhere(lab == cid)\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        if r0 > 0 and c0 > 0 and r1 < H - 1 and c1 < W - 1:\n            count += 1\n    return count\n\n\ndef _is_8connected(grid: np.ndarray, bg: int) -> bool:\n    mask = grid != bg\n    if not mask.any():\n        return False\n    _, n = label_mask(mask, connectivity=8)\n    return int(n) == 1\n\n\ndef _size_in_spec(grid: np.ndarray) -> bool:\n    h, w = grid.shape\n    return (OBJECT_H_RANGE[0] <= h <= OBJECT_H_RANGE[1]\n            and OBJECT_W_RANGE[0] <= w <= OBJECT_W_RANGE[1])\n\n\n# =============================================================================\n# Color assignment\n# =============================================================================\n\ndef _assign_pair_colors(layout: list[dict], fill_pool: list[int]) -> list[int]:\n    \"\"\"Return one color per slot. Mirror-pair slots (same pair_id) share a color by\n    default, with COLOR_MISMATCH_RATE fraction of cavities randomly broken to differ.\n    \"\"\"\n    unique_pair_ids: list[int] = []\n    for slot in layout:\n        if slot['pair_id'] not in unique_pair_ids:\n            unique_pair_ids.append(slot['pair_id'])\n    n_pairs = len(unique_pair_ids)\n    n_colors = len(fill_pool)\n\n    # Ensure all pool colors are used when n_pairs >= n_colors; otherwise\n    # use a subset of pool colors (one per pair).\n    if n_pairs >= n_colors:\n        pair_colors = list(fill_pool) + [random.choice(fill_pool)\n                                         for _ in range(n_pairs - n_colors)]\n    else:\n        pair_colors = list(fill_pool)[:n_pairs]\n    random.shuffle(pair_colors)\n\n    pair_color_map = dict(zip(unique_pair_ids, pair_colors))\n    colors = [pair_color_map[slot['pair_id']] for slot in layout]\n\n    # Occasional mismatch: break LR color symmetry in a fraction of cavities.\n    for i in range(len(colors)):\n        if random.random() < COLOR_MISMATCH_RATE:\n            colors[i] = random.choice(fill_pool)\n    return colors\n\n\n# =============================================================================\n# Generation pipeline\n# =============================================================================\n\ndef _pick_bg_and_palette() -> tuple[int, list[int]]:\n    \"\"\"Return (bg_color, shuffled_non_bg_palette).\"\"\"\n    bg = random.randint(0, 9)\n    palette = [c for c in range(10) if c != bg]\n    random.shuffle(palette)\n    return bg, palette\n\n\ndef _build_object_pair(\n    layout: list[dict], colors: list[int], bg: int, outline_col: int,\n) -> tuple[np.ndarray, np.ndarray, np.ndarray] | None:\n    \"\"\"Render src (filled) + dst (empty) from the layout and validate both.\n    Returns (src_cropped, dst_cropped, expected_output) or None on failure.\n    \"\"\"\n    n_cavities = len(layout)\n    dst_shapes = [slot['shape_dst'] for slot in layout]\n    src_shapes = [slot['shape_src'] for slot in layout]\n\n    dst_cropped, dst_filled = _render_object(\n        layout, dst_shapes, colors, bg, outline_col, filled=False,\n    )\n    if dst_cropped is None:\n        return None\n    if not _is_8connected(dst_cropped, bg):\n        return None\n    if _count_enclosed_bg_holes(dst_cropped, bg) != n_cavities:\n        return None\n    if not _size_in_spec(dst_cropped):\n        return None\n\n    src_cropped, _ = _render_object(\n        layout, src_shapes, colors, bg, outline_col, filled=True,\n    )\n    if src_cropped is None:\n        return None\n    if not _is_8connected(src_cropped, bg):\n        return None\n    if _count_4conn_cavities(src_cropped, bg, outline_col) != n_cavities:\n        return None\n    if not _size_in_spec(src_cropped):\n        return None\n\n    # Expected output = dst with holes filled by matched colors, tight-cropped.\n    return src_cropped, dst_cropped, dst_filled\n\n\ndef _place_on_canvas(\n    src: np.ndarray, dst: np.ndarray, bg: int,\n) -> np.ndarray | None:\n    \"\"\"Place src and dst on a random-size canvas with a mandatory gap between them.\"\"\"\n    canvas_h = random.randint(*CANVAS_SIZE_RANGE)\n    canvas_w = random.randint(*CANVAS_SIZE_RANGE)\n    canvas = np.full((canvas_h, canvas_w), bg, dtype=int)\n    try:\n        r, c = random_free_location(canvas, src, transparent=bg,\n                                    border=PLACEMENT_BORDER, padding=PLACEMENT_PADDING)\n    except ValueError:\n        return None\n    paste(canvas, src, r, c, transparent=bg)\n    try:\n        r, c = random_free_location(canvas, dst, transparent=bg,\n                                    border=PLACEMENT_BORDER, padding=PLACEMENT_PADDING)\n    except ValueError:\n        return None\n    paste(canvas, dst, r, c, transparent=bg)\n    return canvas\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg, palette = _pick_bg_and_palette()\n    outline_col = palette[0]\n\n    layout = _design_layout(random.randint(*CAVITY_COUNT_RANGE))\n    if len(layout) < CAVITY_COUNT_RANGE[0]:\n        return None\n    n_cavities = len(layout)\n\n    fc_lo, fc_hi = FILL_COLOR_COUNT_RANGE\n    max_cols = min(fc_hi, n_cavities, len(palette) - 1)\n    if max_cols < fc_lo:\n        return None\n    n_fill_cols = random.randint(fc_lo, max_cols)\n    fill_pool = palette[1:1 + n_fill_cols]\n    colors = _assign_pair_colors(layout, fill_pool)\n\n    built = _build_object_pair(layout, colors, bg, outline_col)\n    if built is None:\n        return None\n    src, dst, expected = built\n\n    canvas = _place_on_canvas(src, dst, bg)\n    if canvas is None:\n        return None\n\n    # Oracle check against the solver.\n    try:\n        actual = main(canvas)\n    except Exception:\n        return None\n    if not isinstance(actual, np.ndarray):\n        return None\n    if actual.shape != expected.shape or not np.array_equal(actual, expected):\n        return None\n    return canvas\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GEN_ATTEMPTS):\n        try:\n            g = _gen_attempt()\n        except Exception:\n            g = None\n        if g is not None:\n            return g\n    raise RuntimeError(f'generate_input: failed after {MAX_GEN_ATTEMPTS} attempts')\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '208,720p' /home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '208,720p' /home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert a rough nested line drawing into a clean canonical frame-and-dot diagram.\n\n    Input structure:\n    - The grid has one background color and one foreground color.\n    - Foreground 4-connected objects are rough closed frames or small filled blobs.\n    - Frames may contain other frames/blobs; blobs outside a frame remain outside it.\n\n    Rule:\n    - Detect the containment tree of foreground objects using holes of each frame object.\n    - Replace every blob with one foreground pixel.\n    - Replace every frame with a rectangular border padded two cells around its direct children.\n    - Place siblings by their original row/column overlap and order, with one empty cell between canonical objects.\n\n    Key insight: The exact wobbly geometry is irrelevant; only enclosure plus relative sibling positions define the output.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    fg_colors = sorted(set(map(int, g.flatten())) - {bg})\n    assert len(fg_colors) == 1\n    fg = int(fg_colors[0])\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg], return_format=\"dict\")\n    assert comps\n\n    nodes: list[_Node] = []\n    holes: list[list[np.ndarray]] = []\n    for comp in comps:\n        coords = np.asarray(comp[\"coords\"], dtype=int)\n        node = _Node(\n            coords=coords,\n            bbox=tuple(map(int, comp[\"bbox\"])),\n            center=coords.mean(axis=0),\n        )\n        node_holes = _component_holes(g.shape, coords)\n        node.is_frame = bool(node_holes)\n        nodes.append(node)\n        holes.append(node_holes)\n\n    assert any(node.is_frame for node in nodes)\n    for node_i, node in enumerate(nodes):\n        containers = []\n        for frame_i, frame in enumerate(nodes):\n            if node_i == frame_i or not frame.is_frame:\n                continue\n            if any(np.all(hole[tuple(node.coords.T)]) for hole in holes[frame_i]):\n                containers.append(frame)\n        if containers:\n            node.parent = min(containers, key=lambda item: int(item.coords.shape[0]))\n            node.parent.children.append(node)\n\n    roots = [node for node in nodes if node.parent is None]\n    mask = _layout_root(roots)\n    out = np.full(mask.shape, bg, dtype=int)\n    out[mask] = fg\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# ── CFG: tunable generation parameters ──────────────────────────────────────\n# Grid / canvas bounds\nGRID_MIN = 16              # minimum grid dimension (rows or cols)\nGRID_MAX = 25              # maximum grid dimension\nMAX_EXTRA_PAD = 12         # max total padding beyond drawing extent\nMAX_PAD_PER_SIDE = 6       # max padding on one side\n\n# Frame geometry\nFRAME_H_RANGE = (7, 20)    # allowed frame bbox height\nFRAME_W_RANGE = (7, 24)    # allowed frame bbox width\nFRAME_CORNER_MAX = 5       # max corner wobble displacement\nFRAME_MIN_EDGE = 2         # min straight-edge length between corners\nFRAME_TURN_RATIO = (0.34, 0.43)  # acceptable turn-ratio range for wobbly loops\nFRAME_RETRIES = 60         # retries per frame-mask generation\n\n# Blob geometry\nBLOB_SIZE_RANGE = (4, 11)  # blob pixel count range\nBLOB_BBOX_RANGE = (2, 5)   # blob bbox dimension range (exclusive upper)\n\n# Layout / arrangement\nARRANGE_GAP_COMPACT = (2, 3)   # inter-sibling gap range (compact mode)\nARRANGE_GAP_NORMAL = (2, 5)    # inter-sibling gap range (normal mode)\nARRANGE_EXTRA_SPAN = (0, 4)    # extra span added to cross-axis in arrangement\nFRAME_MARGIN_RANGE = (3, 5)    # margin around children inside a frame\nCOMPACT_MARGIN = 3             # fixed margin in compact mode\n\n# Outside blob placement\nOUTSIDE_GAP_RANGE = (2, 5)    # gap between frame and outside blob\n\n# Tree structure probabilities\nDEPTH1_PROB = 0.35             # probability of depth-1 (blobs-only) tree\nOUTSIDE_BLOB_PROB = 0.35       # probability of having an outside blob\nDEPTH1_INSIDE_RANGE = (1, 3)   # blobs inside single frame (depth-1)\nDEPTH2_INNER_BLOBS = (1, 2)    # blobs inside inner frame (depth-2)\nDEPTH2_OUTER_BLOBS = (0, 2)    # sibling blobs beside inner frame (depth-2)\nMAX_TOTAL_CHILDREN = 4         # max children before suppressing outside blob\n\n# Step-mix alternation bias\nSTEP_MIX_ALT_PROB = 0.7       # probability of alternating direction in corner wobble\n\n# Generation retry budget\nGEN_RETRIES = 300              # max attempts in generate_input()\n# ────────────────────────────────────────────────────────────────────────────\n\n\nclass _Obj:\n    def __init__(self, kind, children=None, outside_side=None):\n        self.kind = kind\n        self.children = list(children or [])\n        self.mask = None\n        self.rel = (0, 0)\n        self.pos = (0, 0)\n        self.outside_side = outside_side\n\n\ndef _loop_ok(mask):\n    \"\"\"Check that mask is a single 4-connected simple closed curve with exactly one hole.\"\"\"\n    _, n = label_mask(mask, connectivity=4)\n    if n != 1:\n        return False\n    # Vectorized degree check: each True pixel must have exactly 2 True 4-neighbors\n    deg = np.zeros_like(mask, dtype=int)\n    deg[1:, :] += mask[:-1, :]\n    deg[:-1, :] += mask[1:, :]\n    deg[:, 1:] += mask[:, :-1]\n    deg[:, :-1] += mask[:, 1:]\n    if not np.all(deg[mask] == 2):\n        return False\n    inv_lab, inv_n = label_mask(~mask, connectivity=4)\n    boundary = set(inv_lab[0, :]) | set(inv_lab[-1, :]) | set(inv_lab[:, 0]) | set(inv_lab[:, -1])\n    return sum(1 for k in range(1, inv_n + 1) if k not in boundary) == 1\n\n\ndef _step_mix(n_a, step_a, n_b, step_b):\n    \"\"\"Interleave n_a copies of step_a with n_b copies of step_b, biased toward alternation.\"\"\"\n    out = []\n    last = None\n    while n_a or n_b:\n        if n_a and n_b:\n            if last is not None and random.random() < STEP_MIX_ALT_PROB:\n                pick = \"b\" if last == \"a\" else \"a\"\n            else:\n                pick = \"a\" if random.random() < n_a / (n_a + n_b) else \"b\"\n        elif n_a:\n            pick = \"a\"\n        else:\n            pick = \"b\"\n        if pick == \"a\":\n            out.append(step_a)\n            n_a -= 1\n        else:\n            out.append(step_b)\n            n_b -= 1\n        last = pick\n    return out\n\n\ndef _add_line(path, end):\n    \"\"\"Extend path with a straight line from its last point to end.\"\"\"\n    r, c = path[-1]\n    er, ec = end\n    dr = 0 if er == r else (1 if er > r else -1)\n    dc = 0 if ec == c else (1 if ec > c else -1)\n    while (r, c) != (er, ec):\n        r += dr\n        c += dc\n        path.append((r, c))\n\n\ndef _add_steps(path, steps):\n    \"\"\"Extend path by applying a sequence of (dr, dc) deltas.\"\"\"\n    r, c = path[-1]\n    for dr, dc in steps:\n        r += dr\n        c += dc\n        path.append((r, c))\n\n\ndef _turn_ratio(path):\n    \"\"\"Fraction of direction changes along a cyclic path.\"\"\"\n    dirs = []\n    cyc = path + [path[0]]\n    for (r0, c0), (r1, c1) in zip(cyc, cyc[1:]):\n        dirs.append((r1 - r0, c1 - c0))\n    turns = sum(1 for a, b in zip(dirs, dirs[1:] + [dirs[0]]) if a != b)\n    return turns / len(path)\n\n\ndef _frame_mask(h, w):\n    \"\"\"Generate a wobbly simple closed curve mask of size (h, w).\"\"\"\n    max_dx = min(FRAME_CORNER_MAX, max(1, (w - 5) // 2))\n    max_dy = min(FRAME_CORNER_MAX, max(1, (h - 5) // 2))\n    lo, hi = FRAME_TURN_RATIO\n    for _ in range(FRAME_RETRIES):\n        tl_dx = random.randint(1, max_dx)\n        tr_dx = random.randint(1, max_dx)\n        br_dx = random.randint(1, max_dx)\n        bl_dx = random.randint(1, max_dx)\n        tl_dy = random.randint(1, max_dy)\n        tr_dy = random.randint(1, max_dy)\n        br_dy = random.randint(1, max_dy)\n        bl_dy = random.randint(1, max_dy)\n\n        p0 = (0, tl_dx)\n        p1 = (0, w - 1 - tr_dx)\n        p2 = (tr_dy, w - 1)\n        p3 = (h - 1 - br_dy, w - 1)\n        p4 = (h - 1, w - 1 - br_dx)\n        p5 = (h - 1, bl_dx)\n        p6 = (h - 1 - bl_dy, 0)\n        p7 = (tl_dy, 0)\n        if not (p1[1] - p0[1] >= FRAME_MIN_EDGE and p3[0] - p2[0] >= FRAME_MIN_EDGE\n                and p4[1] - p5[1] >= FRAME_MIN_EDGE and p6[0] - p7[0] >= FRAME_MIN_EDGE):\n            continue\n\n        path = [p0]\n        _add_line(path, p1)\n        _add_steps(path, _step_mix(tr_dy, (1, 0), tr_dx, (0, 1)))\n        _add_line(path, p3)\n        _add_steps(path, _step_mix(br_dy, (1, 0), br_dx, (0, -1)))\n        _add_line(path, p5)\n        _add_steps(path, _step_mix(bl_dy, (-1, 0), bl_dx, (0, -1)))\n        _add_line(path, p7)\n        _add_steps(path, _step_mix(tl_dy, (-1, 0), tl_dx, (0, 1)))\n        if path[-1] == path[0]:\n            path.pop()\n\n        coords = np.array(path, dtype=int)\n        mask = np.zeros((h, w), dtype=bool)\n        mask[coords[:, 0], coords[:, 1]] = True\n        ratio = _turn_ratio(path)\n        if lo <= ratio <= hi and _loop_ok(mask):\n            return mask\n    return None\n\n\ndef _blob_mask():\n    \"\"\"Generate a small filled blob mask (size 4-11, bbox 2x2 to 4x4).\"\"\"\n    size = random.randint(*BLOB_SIZE_RANGE)\n    feasible = [\n        (h, w)\n        for h in range(*BLOB_BBOX_RANGE)\n        for w in range(*BLOB_BBOX_RANGE)\n        if h * w >= size and h + w - 1 <= size\n    ]\n    h, w = random.choice(feasible)\n    rr = random.randrange(h)\n    cc = random.randrange(w)\n    cells = {(r, cc) for r in range(h)} | {(rr, c) for c in range(w)}\n    while len(cells) < size:\n        frontier = []\n        for r, c in cells:\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                p = (r + dr, c + dc)\n                if 0 <= p[0] < h and 0 <= p[1] < w and p not in cells:\n                    frontier.append(p)\n        cells.add(random.choice(frontier))\n    mask = np.zeros((h, w), dtype=bool)\n    pts = np.array(list(cells), dtype=int)\n    mask[pts[:, 0], pts[:, 1]] = True\n    return mask\n\n\ndef _arrange(children, compact=False):\n    \"\"\"Arrange children in a random layout (vertical, horizontal, or diagonal).\"\"\"\n    random.shuffle(children)\n    dims = [child.mask.shape for child in children]\n    k = len(children)\n    if k == 1:\n        return {children[0]: (0, 0)}, dims[0][0], dims[0][1]\n\n    mode = random.choice((\"vertical\", \"horizontal\", \"diagonal\"))\n    gap_lo, gap_hi = ARRANGE_GAP_COMPACT if compact else ARRANGE_GAP_NORMAL\n    gaps = [random.randint(gap_lo, gap_hi) for _ in range(k - 1)]\n    placements = {}\n\n    if mode == \"vertical\":\n        group_h = sum(h for h, _ in dims) + sum(gaps)\n        group_w = max(w for _, w in dims) + random.randint(*ARRANGE_EXTRA_SPAN)\n        r = 0\n        for child, (h, w), gap in zip(children, dims, gaps + [0]):\n            placements[child] = (r, random.randint(0, group_w - w))\n            r += h + gap\n        return placements, group_h, group_w\n\n    if mode == \"horizontal\":\n        group_h = max(h for h, _ in dims) + random.randint(*ARRANGE_EXTRA_SPAN)\n        group_w = sum(w for _, w in dims) + sum(gaps)\n        c = 0\n        for child, (h, w), gap in zip(children, dims, gaps + [0]):\n            placements[child] = (random.randint(0, group_h - h), c)\n            c += w + gap\n        return placements, group_h, group_w\n\n    # diagonal\n    group_h = sum(h for h, _ in dims) + sum(gaps)\n    group_w = sum(w for _, w in dims) + sum(gaps)\n    r = c = 0\n    for child, (h, w), gap in zip(children, dims, gaps + [0]):\n        placements[child] = (r, c)\n        r += h + gap\n        c += w + gap\n    return placements, group_h, group_w\n\n\ndef _prepare(node, compact=False):\n    \"\"\"Recursively build masks and place children within frames.\"\"\"\n    if node.kind == \"blob\":\n        node.mask = _blob_mask()\n        return True\n\n    for child in node.children:\n        if not _prepare(child, compact=child.kind == \"frame\"):\n            return False\n\n    has_frame_child = any(child.kind == \"frame\" for child in node.children)\n    tight = compact or has_frame_child\n    placements, group_h, group_w = _arrange(node.children, compact=tight)\n    margin = COMPACT_MARGIN if tight else random.randint(*FRAME_MARGIN_RANGE)\n    min_h = max(FRAME_H_RANGE[0], group_h + 2 * margin)\n    min_w = max(FRAME_W_RANGE[0], group_w + 2 * margin)\n    if min_h > FRAME_H_RANGE[1] or min_w > FRAME_W_RANGE[1]:\n        return False\n    h_hi = min(FRAME_H_RANGE[1], min_h + 2) if compact else FRAME_H_RANGE[1]\n    w_hi = min(FRAME_W_RANGE[1], min_w + 3) if compact else FRAME_W_RANGE[1]\n    h = random.randint(min_h, h_hi)\n    w = random.randint(min_w, w_hi)\n    top = margin + random.randint(0, h - 2 * margin - group_h)\n    left = margin + random.randint(0, w - 2 * margin - group_w)\n    for child, (r, c) in placements.items():\n        child.rel = (top + r, left + c)\n    node.mask = _frame_mask(h, w)\n    return node.mask is not None\n\n\ndef _walk(node, base=(0, 0)):\n    \"\"\"Flatten tree into list, computing absolute positions.\"\"\"\n    br, bc = base\n    rr, cc = node.rel\n    node.pos = (br + rr, bc + cc)\n    out = [node]\n    for child in node.children:\n        out.extend(_walk(child, node.pos))\n    return out\n\n\ndef _place_outside(root, outside):\n    \"\"\"Position an outside blob adjacent to the root frame.\"\"\"\n    assert root.mask is not None and outside.mask is not None\n    h, w = root.mask.shape\n    bh, bw = outside.mask.shape\n    gap = random.randint(*OUTSIDE_GAP_RANGE)\n    side = outside.outside_side\n    if side == \"right\":\n        outside.rel = (random.randint(1, h - bh - 1), w + gap)\n    elif side == \"left\":\n        outside.rel = (random.randint(1, h - bh - 1), -gap - bw)\n    elif side == \"bottom\":\n        outside.rel = (h + gap, random.randint(1, w - bw - 1))\n    else:\n        outside.rel = (-gap - bh, random.randint(1, w - bw - 1))\n\n\ndef _node_from_obj(obj):\n    \"\"\"Convert a generator _Obj (with absolute pos) to a solver _Node.\"\"\"\n    assert obj.mask is not None\n    r0, c0 = obj.pos\n    coords = np.argwhere(obj.mask) + np.array([r0, c0])\n    lo = coords.min(axis=0)\n    hi = coords.max(axis=0)\n    node = _Node(\n        coords=coords.astype(int),\n        bbox=(int(lo[0]), int(lo[1]), int(hi[0]), int(hi[1])),\n        center=coords.mean(axis=0),\n    )\n    node.is_frame = obj.kind == \"frame\"\n    return node\n\n\ndef _expected_output(root, outside, bg, fg):\n    \"\"\"Compute expected solver output for the generated tree.\"\"\"\n    def add(obj):\n        node = _node_from_obj(obj)\n        for child in obj.children:\n            child_node = add(child)\n            child_node.parent = node\n            node.children.append(child_node)\n        return node\n\n    roots = [add(root)]\n    if outside is not None:\n        roots.append(add(outside))\n    mask = _layout_root(roots)\n    out = np.full(mask.shape, bg, dtype=int)\n    out[mask] = fg\n    return out\n\n\ndef _make_tree():\n    \"\"\"Build a random containment tree (1-2 frames, 1-4 blobs, optional outside blob).\"\"\"\n    root = _Obj(\"frame\")\n    outside = None\n    sides = (\"left\", \"right\", \"top\", \"bottom\")\n    if random.random() < DEPTH1_PROB:\n        n_inside = random.randint(*DEPTH1_INSIDE_RANGE)\n        root.children = [_Obj(\"blob\") for _ in range(n_inside)]\n        if n_inside < MAX_TOTAL_CHILDREN and random.random() < OUTSIDE_BLOB_PROB:\n            outside = _Obj(\"blob\", outside_side=random.choice(sides))\n    else:\n        inner = _Obj(\"frame\")\n        inner.children = [_Obj(\"blob\") for _ in range(random.randint(*DEPTH2_INNER_BLOBS))]\n        outer_blobs = [_Obj(\"blob\") for _ in range(random.randint(*DEPTH2_OUTER_BLOBS))]\n        root.children = [inner] + outer_blobs\n        if len(inner.children) + len(outer_blobs) < MAX_TOTAL_CHILDREN and random.random() < OUTSIDE_BLOB_PROB:\n            outside = _Obj(\"blob\", outside_side=random.choice(sides))\n    return root, outside\n\n\ndef _draw(objects, bg, fg):\n    \"\"\"Render all objects onto a padded grid. Returns None if size constraints fail.\"\"\"\n    min_r = min(obj.pos[0] for obj in objects)\n    min_c = min(obj.pos[1] for obj in objects)\n    max_r = max(obj.pos[0] + obj.mask.shape[0] for obj in objects)\n    max_c = max(obj.pos[1] + obj.mask.shape[1] for obj in objects)\n    draw_h = max_r - min_r\n    draw_w = max_c - min_c\n    if draw_h > GRID_MAX or draw_w > GRID_MAX:\n        return None\n\n    extra_h_min = max(0, GRID_MIN - draw_h)\n    extra_w_min = max(0, GRID_MIN - draw_w)\n    extra_h_max = min(MAX_EXTRA_PAD, GRID_MAX - draw_h)\n    extra_w_max = min(MAX_EXTRA_PAD, GRID_MAX - draw_w)\n    if extra_h_min > extra_h_max or extra_w_min > extra_w_max:\n        return None\n    extra_h = random.randint(extra_h_min, extra_h_max)\n    extra_w = random.randint(extra_w_min, extra_w_max)\n    top_pad = random.randint(max(0, extra_h - MAX_PAD_PER_SIDE), min(MAX_PAD_PER_SIDE, extra_h))\n    left_pad = random.randint(max(0, extra_w - MAX_PAD_PER_SIDE), min(MAX_PAD_PER_SIDE, extra_w))\n    shift_r = top_pad - min_r\n    shift_c = left_pad - min_c\n\n    grid = np.full((draw_h + extra_h, draw_w + extra_w), bg, dtype=int)\n    for obj in objects:\n        assert obj.mask is not None\n        r = obj.pos[0] + shift_r\n        c = obj.pos[1] + shift_c\n        obj.pos = (r, c)\n        patch = np.full(obj.mask.shape, bg, dtype=int)\n        patch[obj.mask] = fg\n        paste(grid, patch, r, c, transparent=bg)\n    if np.count_nonzero(grid == bg) <= np.count_nonzero(grid == fg):\n        return None\n    return grid\n\n\ndef _gen_attempt():\n    \"\"\"Single generation attempt: build tree, render input, verify against solver.\"\"\"\n    bg, fg = random.sample(range(10), 2)\n    root, outside = _make_tree()\n    if not _prepare(root):\n        return None\n    if outside is not None:\n        if not _prepare(outside):\n            return None\n        _place_outside(root, outside)\n\n    objects = _walk(root)\n    if outside is not None:\n        outside.pos = outside.rel\n        objects.append(outside)\n\n    grid = _draw(objects, bg, fg)\n    if grid is None:\n        return None\n    expected = _expected_output(root, outside, bg, fg)\n    try:\n        got = main(grid)\n    except Exception:\n        return None\n    if not np.array_equal(got, expected):\n        return None\n    return grid\n\n\ndef generate_input():\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 2d0172a1 input\")\n","exit_code":0,"status":"completed"}}
