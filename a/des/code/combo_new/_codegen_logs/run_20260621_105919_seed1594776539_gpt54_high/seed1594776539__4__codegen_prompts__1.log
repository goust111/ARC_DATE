{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py',\n'/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py',\n'/home/lixinyu/snap/new/ARC_code/eval/21897d95.py',\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n]\nfor path in files:\n    print(f'===== {path} =====')\n    text = Path(path).read_text()\n    lines = text.splitlines()\n    for name in ('main', 'generate_input'):\n        start = next(i for i,l in enumerate(lines) if l.startswith(f'def {name}('))\n        end = len(lines)\n        for j in range(start+1, len(lines)):\n            if lines[j].startswith('def ') and not lines[j].startswith(f'def {name}('):\n                end = j\n                break\n        block = lines[start:end]\n        print('\\\\n'.join(block[:120]))\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py',\n'/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py',\n'/home/lixinyu/snap/new/ARC_code/eval/21897d95.py',\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n]\nfor path in files:\n    print(f'===== {path} =====')\n    text = Path(path).read_text()\n    lines = text.splitlines()\n    for name in ('main', 'generate_input'):\n        start = next(i for i,l in enumerate(lines) if l.startswith(f'def {name}('))\n        end = len(lines)\n        for j in range(start+1, len(lines)):\n            if lines[j].startswith('def ') and not lines[j].startswith(f'def {name}('):\n                end = j\n                break\n        block = lines[start:end]\n        print('\\\\n'.join(block[:120]))\n        print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/a25697e4.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Dock movable tools into border-anchored frames by filling cavities.\n\n    Input structure:\n    - bg = most common color.\n    - Border-touching components cluster into anchor frames with interior bg cavities.\n    - Non-border 2-color components are movable tools.\n\n    Rule:\n    - Match each tool to a frame whose cavity size equals one of its color-region counts.\n    - Rotate/flip the tool so one color fills the cavity exactly; the other stays outside.\n    - If the docking orientation uses a reflection, swap the tool's two colors.\n\n    Key insight: Cavity size determines tool–frame pairing; reflection triggers color swap.\n    \"\"\"\n    inp = grid\n    g = inp.copy()\n    bg = get_bg(g)\n    H, W = g.shape\n\n    def bbox_gap(a, b) -> int:\n        (ar0, ac0, ar1, ac1) = a\n        (br0, bc0, br1, bc1) = b\n        def gap1(x0, x1, y0, y1):\n            if y1 < x0:\n                return int(x0 - y1)\n            if x1 < y0:\n                return int(y0 - x1)\n            return 0\n        return gap1(ar0, ar1, br0, br1) + gap1(ac0, ac1, bc0, bc1)\n\n    fg = g != int(bg)\n    lab, n = label(fg, structure=STRUCT4)\n    fixed_mask = np.zeros((H, W), dtype=bool)\n    fixed_components = []\n    for cid in range(1, n + 1):\n        pts = np.argwhere(lab == cid)\n        pts_list = [(int(r), int(c)) for r, c in pts]\n        touches = any(r == 0 or r == H - 1 or c == 0 or c == W - 1 for r, c in pts_list)\n        if not touches:\n            continue\n        fixed_components.append({\"pts\": pts_list, \"bbox\": (int(pts[:,0].min()), int(pts[:,1].min()), int(pts[:,0].max()), int(pts[:,1].max()))})\n        for r, c in pts_list:\n            fixed_mask[r, c] = True\n\n    assert not (not fixed_components)\n\n    # Cluster fixed components into anchor frames.\n    parent = list(range(len(fixed_components)))\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(a, b):\n        ra, rb = find(a), find(b)\n        if ra != rb:\n            parent[rb] = ra\n\n    for i in range(len(fixed_components)):\n        for j in range(i + 1, len(fixed_components)):\n            if bbox_gap(fixed_components[i][\"bbox\"], fixed_components[j][\"bbox\"]) <= 2:\n                union(i, j)\n\n    groups: dict[int, list[int]] = {}\n    for i in range(len(fixed_components)):\n        groups.setdefault(find(i), []).append(i)\n\n    anchor_groups = []\n    for idxs in groups.values():\n        pts = [p for i in idxs for p in fixed_components[i][\"pts\"]]\n        rs = [r for r, _c in pts]\n        cs = [c for _r, c in pts]\n        bbox = (min(rs), min(cs), max(rs), max(cs))\n        mask = np.zeros((H, W), dtype=bool)\n        for r, c in pts:\n            mask[r, c] = True\n        sock = np.zeros((H, W), dtype=bool)\n        for r in range(bbox[0], bbox[2] + 1):\n            for c in range(bbox[1], bbox[3] + 1):\n                if int(g[r, c]) != int(bg):\n                    continue\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    rr, cc = r + dr, c + dc\n                    if 0 <= rr < H and 0 <= cc < W and mask[rr, cc]:\n                        sock[r, c] = True\n                        break\n\n        # Cavity = largest bg component inside bbox that is adjacent to the anchor pixels.\n        cavity = np.zeros((H, W), dtype=bool)\n        sub_bg = (g[bbox[0] : bbox[2] + 1, bbox[1] : bbox[3] + 1] == int(bg))\n        sub_lab, sub_n = label(sub_bg, structure=STRUCT4)\n        best_c = None  # (area, cid)\n        for cid in range(1, sub_n + 1):\n            ptsc = np.argwhere(sub_lab == cid)\n            area = int(len(ptsc))\n            # check adjacency to anchor within bbox\n            adj = False\n            for rr, cc in ptsc:\n                r = int(bbox[0] + rr)\n                c = int(bbox[1] + cc)\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    r2, c2 = r + dr, c + dc\n                    if bbox[0] <= r2 <= bbox[2] and bbox[1] <= c2 <= bbox[3] and mask[r2, c2]:\n                        adj = True\n                        break\n                if adj:\n                    break\n            if not adj:\n                continue\n            cand = (area, -cid)\n            if best_c is None or cand > best_c:\n                best_c = cand\n                best_id = cid\n        if best_c is not None:\n            ptsc = np.argwhere(sub_lab == best_id)\n            for rr, cc in ptsc:\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPT_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input after %d attempts\" % GEN_ATTEMPT_RETRIES)\n\n===== /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exhausted attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/21897d95.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.\n\n    Input structure:\n    - The grid is a mosaic of monochrome regions.\n    - Color 1 forms T-shaped control markers on region boundaries.\n    - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.\n    - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.\n\n    Rule:\n    - For a color-1 T marker, the single stem points at the destination region to repaint.\n    - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.\n    - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.\n    - All marker cells are filled with the final color of the source-side region.\n    - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.\n\n    Key insight:\n    - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = _solve_unrotated(g)\n    l9 = _find_l9_orientation(g)\n    if l9 == 'top_right':\n        return np.rot90(out, 1)\n    if l9 == 'top_left':\n        return np.rot90(out, 3)\n    return out\n\n# --------------- generator (l9rot) ---------------\n\n# ── Tunable constants ──────────────────────────────────────────────────\n# Canvas / region sizing\nGRID_SIZE_MAX = 30                          # max rows or cols\nMIN_REGION_CELLS = 6                        # per-spec minimum\nREGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)\nREGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts\nREGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS\n\n# Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)\nMARKER_MIN = 4\nMARKER_MAX = 8\nNORMAL_MAX = 6\nCOLORED_MAX = 2\n\n# Color pool (all ARC colors except 1, which is reserved for T-marker cells)\nCOLOR_POOL = [c for c in range(10) if c != 1]\n\n# L9 rotation marker\nL9_PROBABILITY = 0.5                        # chance of placing a rotation marker\nL9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation\n    'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],\n    'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],\n}\n\n# Generation retry budget\nSEED_ATTEMPTS = 200                         # tries to place n distinct region seeds\nGEN_RETRIES = 300                           # outer generate_input retry budget\n\n_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n# ── Small geometry helpers ─────────────────────────────────────────────\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\n\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/898e7135.py',\n'/home/lixinyu/snap/new/ARC_code/train/ad173014.py',\n'/home/lixinyu/snap/new/ARC_code/train/278e5215.py',\n'/home/lixinyu/snap/new/ARC_code/train/99caaf76.py',\n]\nfor path in files:\n    print(f'===== {path} =====')\n    text = Path(path).read_text()\n    lines = text.splitlines()\n    for name in ('main', 'generate_input'):\n        start = next(i for i,l in enumerate(lines) if l.startswith(f'def {name}('))\n        end = len(lines)\n        for j in range(start+1, len(lines)):\n            if lines[j].startswith('def ') and not lines[j].startswith(f'def {name}('):\n                end = j\n                break\n        block = lines[start:end]\n        print('\\\\n'.join(block[:120]))\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/898e7135.py',\n'/home/lixinyu/snap/new/ARC_code/train/ad173014.py',\n'/home/lixinyu/snap/new/ARC_code/train/278e5215.py',\n'/home/lixinyu/snap/new/ARC_code/train/99caaf76.py',\n]\nfor path in files:\n    print(f'===== {path} =====')\n    text = Path(path).read_text()\n    lines = text.splitlines()\n    for name in ('main', 'generate_input'):\n        start = next(i for i,l in enumerate(lines) if l.startswith(f'def {name}('))\n        end = len(lines)\n        for j in range(start+1, len(lines)):\n            if lines[j].startswith('def ') and not lines[j].startswith(f'def {name}('):\n                end = j\n                break\n        block = lines[start:end]\n        print('\\\\n'.join(block[:120]))\n        print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/898e7135.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Inflate a frame's hole-layout and fill each hole with its matching piece.\n\n    Input structure:\n    - bg = most common color. Largest component is a monochrome frame enclosing bg holes.\n    - Outside pieces composed of k×k blocks; k = side of smallest solid square piece.\n\n    Rule:\n    - Extract connected hole regions inside the frame as slots.\n    - Match each piece to a slot by comparing block-level shapes under rotation/flip.\n    - Output the layout scaled by k, with pieces placed in slots; frame color as background.\n\n    Key insight: Pieces are k×k-block-scaled versions of holes; downsampling reveals shape matches under all 8 orientations.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    # --- find the largest connected component of foreground (multicolor) ---\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n    frame_comp = max(comps, key=lambda d: int(d[\"area\"]))\n    fr0, fc0, fr1, fc1 = map(int, frame_comp[\"bbox\"])\n\n    # The frame is monochrome; use its dominant color as output background.\n    frame_cols = [int(g[int(r), int(c)]) for r, c in frame_comp[\"coords\"]]\n    bgc = int(Counter(frame_cols).most_common(1)[0][0])\n\n    # --- layout = bg holes inside the frame bbox, tight-cropped ---\n    sub = crop_bbox(g, (fr0, fc0, fr1, fc1))\n    hole = sub == int(bg)\n    hole_box = bbox(hole)\n    assert hole_box is not None, \"frame must enclose at least one bg hole\"\n    lr0, lc0, lr1, lc1 = map(int, hole_box)\n    layout = hole[lr0 : lr1 + 1, lc0 : lc1 + 1]\n\n    # --- slot components in the layout ---\n    slots = []\n    for coords in components_mask(layout, connectivity=4):\n        rr0, cc0, rr1, cc1 = bbox_coords(coords)\n        rr0, cc0, rr1, cc1 = map(int, (rr0, cc0, rr1, cc1))\n        h = int(rr1 - rr0 + 1)\n        w = int(cc1 - cc0 + 1)\n        sm = np.zeros((h, w), dtype=bool)\n        sm[coords[:, 0] - rr0, coords[:, 1] - cc0] = True\n        slots.append({\"area\": int(sm.sum()), \"r0\": int(rr0), \"c0\": int(cc0), \"mask\": sm})\n    slots.sort(key=lambda s: (-int(s[\"area\"]), int(s[\"r0\"]), int(s[\"c0\"])))\n\n    assert slots, \"frame must contain at least one slot\"\n\n    # --- pieces = non-singleton foreground components excluding the frame component ---\n    pieces = []\n    for comp in comps:\n        if comp is frame_comp:\n            continue\n        coords = comp[\"coords\"]\n        if coords.size == 0 or int(coords.shape[0]) <= 1:\n            continue\n        pr0, pc0, pr1, pc1 = map(int, comp[\"bbox\"])\n        patch = crop_bbox(g, (pr0, pc0, pr1, pc1))\n        ph, pw = map(int, patch.shape)\n        pm = np.zeros((ph, pw), dtype=bool)\n        pm[coords[:, 0] - pr0, coords[:, 1] - pc0] = True\n        pieces.append({\"area\": int(pm.sum()), \"mask\": pm, \"patch\": patch})\n\n    assert pieces, \"at least one non-frame piece must exist\"\n\n    # --- infer k from the smallest solid square piece ---\n    k = None\n    for p in pieces:\n        h, w = map(int, p[\"mask\"].shape)\n        if h == w and int(p[\"mask\"].sum()) == int(h * w):\n            k = int(h) if k is None else min(int(k), int(h))\n    k = int(k or 1)\n\n    def downsample_blocks(mask: np.ndarray) -> np.ndarray | None:\n        hh, ww = mask.shape\n        if hh % k != 0 or ww % k != 0:\n            return None\n        out_h, out_w = int(hh // k), int(ww // k)\n        out = np.zeros((out_h, out_w), dtype=bool)\n        for r in range(out_h):\n            for c in range(out_w):\n                block = mask[int(r * k) : int((r + 1) * k), int(c * k) : int((c + 1) * k)]\n                if bool(block.all()):\n                    out[r, c] = True\n                elif bool(block.any()):\n                    return None\n        return out\n\n    def dihedral_variants(\n        patch: np.ndarray, mask: np.ndarray\n    ) -> list[tuple[np.ndarray, np.ndarray]]:\n        base = []\n        for kk in range(4):\n            p = np.rot90(patch, int(kk))\n            m = np.rot90(mask, int(kk))\n            base.append((p, m))\n            base.append((np.fliplr(p), np.fliplr(m)))\n        uniq = []\n        seen = set()\n        for p, m in base:\n            key = m.tobytes()\n            if key in seen:\n                continue\n            seen.add(key)\n            uniq.append((p, m))\n        return uniq\n\n    # Precompute all usable (piece,variant) candidates with their block masks.\n    candidates = []\n    for pi, p in enumerate(pieces):\n        for vp, vm in dihedral_variants(p[\"patch\"], p[\"mask\"]):\n            um = downsample_blocks(vm)\n            if um is None:\n                continue\n            candidates.append({\"pi\": int(pi), \"area\": int(p[\"area\"]), \"um\": um, \"vp\": vp, \"vm\": vm})\n\n    used_piece: set[int] = set()\n    placements: list[tuple[dict, dict]] = []\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATE_MAX_RETRIES):\n        res = _gen_attempt()\n        if res is not None:\n            return res\n    raise RuntimeError(\"generate_input: failed to generate after %d attempts\" % GENERATE_MAX_RETRIES)\n\n===== /home/lixinyu/snap/new/ARC_code/train/ad173014.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor each framed interior mask with the color from the next red frame clockwise around the blue connector cycle.\n\n    Input structure\n    - The grid contains hollow red square frames connected pairwise by blue line components.\n    - The blue components connect the frames into one cycle, with every frame touching exactly two blue components.\n    - Each frame interior contains background plus exactly one non-background color mask.\n\n    Rule\n    - Sort the red frames clockwise by their centers around the cycle.\n    - Keep each frame's interior mask shape in place, but recolor it with the interior color from the next clockwise frame.\n    - Leave the red frames, blue connectors, background, and interior background holes unchanged.\n\n    Key insight\n    - The colored masks do not move; the blue cycle gives the order in which their colors rotate.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    frames, red_components = _extract_frames(g, bg)\n    edges = _blue_cycle_edges(g, red_components)\n    order = _clockwise_order(frames, edges)\n\n    out = g.copy()\n    for k, frame_id in enumerate(order):\n        next_id = order[(k + 1) % len(order)]\n        r0, c0, r1, c1 = frames[frame_id][\"bbox\"]\n        interior = out[r0 + 1 : r1, c0 + 1 : c1]\n        interior[frames[frame_id][\"mask\"]] = frames[next_id][\"color\"]\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Palette constants.\nBG = 0\nCONNECTOR_BLUE = 1\nFRAME_RED = 2\nINTERIOR_COLORS = [3, 4, 5, 6, 7, 8, 9]\n\n# Canvas and frame bounds.\nFRAME_COUNT_RANGE = (3, 5)\nFRAME_SIZE_CHOICES = [5, 7]\nSMALL_FRAME_GRID_H_RANGE = (20, 27)\nSMALL_FRAME_GRID_W_RANGE = (21, 27)\nLARGE_FRAME_GRID_H_RANGE = (22, 27)\nLARGE_FRAME_GRID_W_RANGE = (23, 27)\nFRAME_GAP = 1\n\n# Interior mask density.\nMIN_INTERIOR_FILL = 0.30\nMAX_INTERIOR_FILL = 0.56\nMIN_INTERIOR_CELLS = 3\n\n# Angular placement.\nANGLE_PERTURB_RANGE = (-0.3, 0.3)\nMIN_RADIUS_PAD = 1\nMAX_RADIUS_PAD = 1\nANGLE_EPS = 1e-6\n\n# Connector constraints and retry budgets.\nMAX_TWO_TURN_TRIES = 20\nCONNECTOR_LENGTH_RANGE = (2, 24)\nGENERATION_ATTEMPTS = 300\n\nNEIGHBORS_8 = [\n    (dr, dc)\n    for dr in range(-1, 2)\n    for dc in range(-1, 2)\n    if not (dr == 0 and dc == 0)\n]\n\n\n\ndef generate_input():\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/278e5215.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the large mask crop column-by-column using the separate three-row palette strip.\n\n    Input structure:\n    - The background is the most common color.\n    - One large monochrome foreground object is the mask; its bbox is the output region and may contain background holes.\n    - The remaining foreground is a 3-row palette rectangle with the same width as the mask bbox: two identical color rows and one uniform row.\n\n    Rule:\n    - Crop to the mask object's bbox.\n    - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n    - Replace background holes inside the crop with the palette's uniform third-row color.\n\n    Key insight:\n    The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    mask_color = _unique_largest_non_bg_color(g, bg)\n\n    b = _mask_bbox(g, mask_color)\n    mask_crop = crop_bbox(g == int(mask_color), b)\n    height, width = map(int, mask_crop.shape)\n\n    column_colors, hole_color = _palette(g, bg, mask_color, width)\n    out = np.tile(column_colors, (height, 1))\n    out[~mask_crop] = hole_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, colors, and object bounds.\nBACKGROUND_COLOR, MASK_COLOR = 0, 5\nCOLOR_MIN, COLOR_MAX = 1, 9\nGRID_SIDE_MIN, GRID_SIDE_MAX = 10, 18\nMASK_SIDE_MIN, MASK_SIDE_MAX = 5, 10\nPALETTE_HEIGHT = 3\nGAP_MIN, GAP_MAX = 1, 3\n\n# Palette run construction.\nRUN_COUNT_OPTIONS = (4, 5)\nRUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3\nCOLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5\nUNUSED_COLOR_BIAS = 0.7\n\n# Mask density and retry budget.\nMASK_DENSITY_MIN, MASK_DENSITY_MAX = 0.60, 0.71\nGENERATION_ATTEMPTS = 300\n\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/99caaf76.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each marked cross object away from its marker to the grid edge while rotating the colored cross 180 degrees.\n\n    Input structure:\n    - The background is the dominant color.\n    - Each 8-connected foreground object has nine pixels: a 4-pixel marker-color\n      sprite attached to a 5-pixel non-marker colored cross.\n    - Each object bbox is either 3x6 or 6x3, so the marker sprite is on exactly\n      one side of the cross.\n\n    Rule:\n    - Move the whole object straight away from its marker side until the object\n      bbox touches the corresponding grid edge.\n    - Keep the marker sprite unchanged within the object.\n    - Rotate the 3x3 colored cross block by 180 degrees before placing it.\n\n    Key insight:\n    The marker sprite is a directional tail; the cross is the leading payload,\n    and only that payload turns around during the slide to the edge.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = get_bg(g)\n    marker = _marker_color(g, bg)\n\n    out = np.full_like(g, int(bg))\n    objects = find_components(g, bg=bg, connectivity=8, monochromatic=False)\n    assert objects, \"expected at least one composite object\"\n\n    for obj in objects:\n        assert int(obj[\"area\"]) == 9, \"each composite should contain 9 foreground pixels\"\n        r0, c0, _r1, _c1 = obj[\"bbox\"]\n        patch = crop_bbox(g, obj[\"bbox\"])\n        h, w = patch.shape\n        moved = patch.copy()\n\n        if (h, w) == (3, 6):\n            left = patch[:, :3]\n            right = patch[:, 3:]\n            left_kind = _block_kind(left, bg, marker)\n            right_kind = _block_kind(right, bg, marker)\n            assert {left_kind, right_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n\n            if left_kind == \"marker\":\n                moved[:, 3:] = np.rot90(right, 2)\n                target_r, target_c = int(r0), W - w\n            else:\n                moved[:, :3] = np.rot90(left, 2)\n                target_r, target_c = int(r0), 0\n\n        elif (h, w) == (6, 3):\n            top = patch[:3, :]\n            bottom = patch[3:, :]\n            top_kind = _block_kind(top, bg, marker)\n            bottom_kind = _block_kind(bottom, bg, marker)\n            assert {top_kind, bottom_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n\n            if top_kind == \"marker\":\n                moved[3:, :] = np.rot90(bottom, 2)\n                target_r, target_c = H - h, int(c0)\n            else:\n                moved[:3, :] = np.rot90(top, 2)\n                target_r, target_c = 0, int(c0)\n\n        else:\n            raise AssertionError(\"each composite bbox should be 3x6 or 6x3\")\n\n        _paste_checked(out, moved, target_r, target_c, bg)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Colors.\n_GEN_BG = 8\n_GEN_MARKER = 1\n_GEN_CENTER = 4\n_GEN_ARM_COLORS = [0, 2, 3, 5, 6, 7, 9]\n\n# Object layout.\n_GEN_SIDES = [\"left\", \"right\", \"top\", \"bottom\"]\n_GEN_MARKER_COORDS = {\n    \"left\": [(0, 0), (1, 1), (1, 2), (2, 0)],\n    \"right\": [(0, 2), (1, 0), (1, 1), (2, 2)],\n    \"top\": [(0, 0), (0, 2), (1, 1), (2, 1)],\n    \"bottom\": [(0, 1), (1, 1), (2, 0), (2, 2)],\n}\n_GEN_ARM_POSITIONS = [(0, 1), (1, 0), (1, 2), (2, 1)]\n\n# Canvas and placement bounds.\n_GEN_OBJECT_COUNT_RANGE = (1, 4)\n_GEN_MAX_SIDE = 18\n_GEN_MIN_SIDE_BY_OBJECT_COUNT = {1: 8, 2: 8, 3: 10, 4: 12}\n_GEN_PADDING = 1\n_GEN_EDGE_GAP = 2\n_GEN_HORIZONTAL_SIZE = (3, 6)\n_GEN_VERTICAL_SIZE = (6, 3)\n\n# Retry limits.\n_GEN_MAX_ATTEMPTS = 300\n\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 99caaf76 input\")\n\n","exit_code":0,"status":"completed"}}
