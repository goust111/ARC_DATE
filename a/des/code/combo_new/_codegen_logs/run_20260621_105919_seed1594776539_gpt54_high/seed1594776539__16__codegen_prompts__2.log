{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/d93c6891.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords, bbox_h, bbox_w, find_components, neighbors4\nimport random\n\n\ndef _orientation(\n    coords: np.ndarray,\n    contacts: list[tuple[int, int, int, int]],\n) -> str:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    assert h == 1 or w == 1, \"expected each gray source to be a one-cell-thick bar\"\n\n    if h == 1 and w > 1:\n        return \"horizontal\"\n    if w == 1 and h > 1:\n        return \"vertical\"\n\n    implied: set[str] = set()\n    for tr, tc, sr, sc in contacts:\n        if tr == sr:\n            implied.add(\"horizontal\")\n        elif tc == sc:\n            implied.add(\"vertical\")\n        else:\n            raise AssertionError(\"gray source must touch orange by a 4-neighbor side\")\n    assert len(implied) == 1, \"singleton gray source has ambiguous orientation\"\n    return implied.pop()\n\n\ndef _fill_rows(\n    out: np.ndarray,\n    r0: int,\n    c0: int,\n    r1: int,\n    c1: int,\n    count: int,\n    contact_rows: set[int],\n) -> None:\n    width = int(c1 - c0 + 1)\n    height = int(r1 - r0 + 1)\n    assert count % width == 0, \"gray count must make complete orange rows\"\n    stripe_count = int(count // width)\n    assert 0 < stripe_count <= height, \"row fill must fit inside the orange rectangle\"\n\n    assert contact_rows in ({r0}, {r1}), \"horizontal bars must touch exactly one extreme row\"\n    if contact_rows == {r0}:\n        rows = list(range(r0, r0 + stripe_count))\n    else:\n        rows = list(range(r1 - stripe_count + 1, r1 + 1))\n\n    out[rows, c0 : c1 + 1] = Color.GRAY\n\n\ndef _fill_cols(\n    out: np.ndarray,\n    r0: int,\n    c0: int,\n    r1: int,\n    c1: int,\n    count: int,\n    contact_cols: set[int],\n) -> None:\n    width = int(c1 - c0 + 1)\n    height = int(r1 - r0 + 1)\n    assert count % height == 0, \"gray count must make complete orange columns\"\n    stripe_count = int(count // height)\n    assert 0 < stripe_count <= width, \"column fill must fit inside the orange rectangle\"\n\n    assert contact_cols in ({c0}, {c1}), \"vertical bars must touch exactly one extreme column\"\n    if contact_cols == {c0}:\n        cols = list(range(c0, c0 + stripe_count))\n    else:\n        cols = list(range(c1 - stripe_count + 1, c1 + 1))\n\n    out[r0 : r1 + 1, cols] = Color.GRAY\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each gray bar into its adjacent orange rectangle as full stripes from the contacted edge.\n\n    Input structure\n    - The scene uses black outside space, yellow fill, gray one-cell-thick bars, and solid orange rectangles.\n    - Each gray bar 4-touches exactly one orange rectangle; some orange rectangles have no touching gray bar.\n    - Gray bars touching the same orange rectangle all have the same orientation.\n\n    Rule\n    - Recolor every original gray cell to yellow.\n    - For each orange rectangle touched by gray bars, count the gray cells assigned to that rectangle.\n    - Horizontal gray bars repaint that many cells as complete orange rows starting from the contacted top or bottom row.\n    - Vertical gray bars repaint that many cells as complete orange columns starting from the contacted left or right column.\n    - Orange rectangles with no touching gray bar remain unchanged.\n\n    Key insight\n    - The gray pixels are not copied by shape; their count is transferred into the neighboring orange rectangle as edge-aligned row or column stripes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.YELLOW, Color.GRAY, Color.ORANGE}\n\n    orange = find_components(g, bg=Color.YELLOW, colors=[Color.ORANGE], connectivity=4)\n    gray = find_components(g, bg=Color.YELLOW, colors=[Color.GRAY], connectivity=4)\n    assert orange and gray, \"expected orange rectangles and gray source bars\"\n\n    orange_index: dict[tuple[int, int], int] = {}\n    orange_bboxes: list[tuple[int, int, int, int]] = []\n    for i, obj in enumerate(orange):\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        assert obj[\"area\"] == bbox_h(obj[\"bbox\"]) * bbox_w(obj[\"bbox\"])\n        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == Color.ORANGE)\n        orange_bboxes.append((int(r0), int(c0), int(r1), int(c1)))\n        for r, c in obj[\"coords\"]:\n            orange_index[(int(r), int(c))] = i\n\n    source_by_target: dict[int, list[tuple[dict, list[tuple[int, int, int, int]]]]] = {}\n    for src in gray:\n        touched: dict[int, list[tuple[int, int, int, int]]] = {}\n        for sr_raw, sc_raw in src[\"coords\"]:\n            sr = int(sr_raw)\n            sc = int(sc_raw)\n            for tr, tc in neighbors4(sr, sc):\n                target_i = orange_index.get((int(tr), int(tc)))\n                if target_i is not None:\n                    touched.setdefault(target_i, []).append((int(tr), int(tc), sr, sc))\n\n        assert len(touched) == 1, \"each gray bar must touch exactly one orange rectangle\"\n        target_i = next(iter(touched))\n        source_by_target.setdefault(target_i, []).append((src, touched[target_i]))\n\n    out = g.copy()\n    out[g == Color.GRAY] = Color.YELLOW\n\n    for target_i, sources in source_by_target.items():\n        r0, c0, r1, c1 = orange_bboxes[target_i]\n        orientations = {_orientation(src[\"coords\"], contacts) for src, contacts in sources}\n        assert len(orientations) == 1, \"all gray bars for one orange rectangle must share orientation\"\n        count = sum(int(src[\"area\"]) for src, _contacts in sources)\n        contacts = [contact for _src, src_contacts in sources for contact in src_contacts]\n\n        if orientations == {\"horizontal\"}:\n            contact_rows = {tr for tr, _tc, _sr, _sc in contacts}\n            assert contact_rows <= {r0, r1}\n            _fill_rows(out, r0, c0, r1, c1, count, contact_rows)\n        else:\n            assert orientations == {\"vertical\"}\n            contact_cols = {tc for _tr, tc, _sr, _sc in contacts}\n            assert contact_cols <= {c0, c1}\n            _fill_cols(out, r0, c0, r1, c1, count, contact_cols)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGRID_H_RANGE, GRID_W_RANGE = (10, 18), (14, 18)\nCONTENT_H_RANGE, CONTENT_W_RANGE = (6, 13), (12, 15)\nBORDER_RANGE = (0, 4)\n\nEDGES, HORIZONTAL_EDGES = (\"top\", \"bottom\", \"left\", \"right\"), (\"top\", \"bottom\")\nORANGE_COUNT_CHOICES, ORANGE_COUNT_WEIGHTS = [1, 2, 3, 4], [1, 2, 3, 4]\nORANGE_H_RANGE, ORANGE_W_RANGE = (1, 5), (2, 6)\nORANGE_AREA_RANGE = (4, 12)\nORANGE_PLACE_RETRIES = 80\n\nMAX_UNTOUCHED_ORANGES = 1\nBARS_PER_ORANGE_RANGE, TOTAL_BARS_RANGE = (1, 2), (2, 6)\nBAR_LENGTH_RANGE = (1, 7)\nBAR_COUNT_RETRIES = 50\n\nGENERATE_RETRIES = 300\n\n\ndef _place_orange(edge, cr0, cc0, cr1, cc1, occupied):\n    \"\"\"Try to place an orange rect flush against the given edge. Returns (or0,oc0,or1,oc1) or None.\"\"\"\n    for _ in range(ORANGE_PLACE_RETRIES):\n        oh = random.randint(*ORANGE_H_RANGE)\n        ow = random.randint(*ORANGE_W_RANGE)\n        if not (ORANGE_AREA_RANGE[0] <= oh * ow <= ORANGE_AREA_RANGE[1]):\n            continue\n        if edge in HORIZONTAL_EDGES:\n            or0 = cr0 if edge == 'top' else cr1 - oh + 1\n            or1 = or0 + oh - 1\n            lo, hi = cc0 + 1, cc1 - ow  # avoid touching perpendicular edges\n        else:\n            oc0 = cc0 if edge == 'left' else cc1 - ow + 1\n            oc1 = oc0 + ow - 1\n            lo, hi = cr0 + 1, cr1 - oh  # avoid touching perpendicular edges\n        if hi < lo:\n            continue\n        v = random.randint(lo, hi)\n        if edge in HORIZONTAL_EDGES:\n            oc0, oc1 = v, v + ow - 1\n        else:\n            or0, or1 = v, v + oh - 1\n        if or0 < cr0 or or1 > cr1 or oc0 < cc0 or oc1 > cc1:\n            continue\n        if occupied[or0:or1+1, oc0:oc1+1].any():\n            continue\n        return (or0, oc0, or1, oc1)\n    return None\n\n\ndef _make_canvas() -> tuple[np.ndarray, tuple[int, int, int, int]] | None:\n    content_h = random.randint(*CONTENT_H_RANGE)\n    content_w = random.randint(*CONTENT_W_RANGE)\n    border_top = random.randint(*BORDER_RANGE)\n    border_bottom = random.randint(*BORDER_RANGE)\n    border_left = random.randint(*BORDER_RANGE)\n    border_right = random.randint(*BORDER_RANGE)\n    grid_h = content_h + border_top + border_bottom\n    grid_w = content_w + border_left + border_right\n    if not (GRID_H_RANGE[0] <= grid_h <= GRID_H_RANGE[1] and GRID_W_RANGE[0] <= grid_w <= GRID_W_RANGE[1]):\n        return None\n\n    grid = np.full((grid_h, grid_w), Color.BLACK, dtype=int)\n    cr0, cc0 = border_top, border_left\n    cr1, cc1 = cr0 + content_h - 1, cc0 + content_w - 1\n    grid[cr0:cr1+1, cc0:cc1+1] = Color.YELLOW\n    return grid, (cr0, cc0, cr1, cc1)\n\n\ndef _place_oranges(content_box, occupied) -> list[tuple[str, int, int, int, int]] | None:\n    cr0, cc0, cr1, cc1 = content_box\n    num_orange = random.choices(ORANGE_COUNT_CHOICES, weights=ORANGE_COUNT_WEIGHTS)[0]\n    edges = random.sample(EDGES, num_orange)\n    orange_rects = []\n    for edge in edges:\n        result = _place_orange(edge, cr0, cc0, cr1, cc1, occupied)\n        if result is None:\n            return None\n        or0, oc0, or1, oc1 = result\n        occupied[or0:or1+1, oc0:oc1+1] = True\n        orange_rects.append((edge, or0, oc0, or1, oc1))\n    return orange_rects\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/dce56571.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import colors_present, get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Straighten the single foreground mask into a centered horizontal segment of the same color and length.\n\n    Input structure:\n    - The grid has one dominant background color.\n    - All non-background pixels share one foreground color.\n    - The number of foreground pixels fits in one centered row of the grid.\n\n    Rule:\n    - Erase the original foreground mask.\n    - Count its pixels, keep its color, and paint that many pixels as a horizontal segment.\n    - Place the segment on the middle row with equal background margin on the left and right.\n\n    Key insight:\n    - The original foreground shape is irrelevant except for its color and area; the output is the area normalized into the grid's central horizontal line.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1, \"expected exactly one foreground color\"\n\n    color = fg_colors[0]\n    count = int(np.count_nonzero(g == color))\n    assert 0 < count <= width, \"foreground pixels must fit in one row\"\n    assert height % 2 == 1, \"expected a unique middle row\"\n    assert (width - count) % 2 == 0, \"foreground segment must center with equal side margins\"\n\n    out = np.full(g.shape, bg, dtype=int)\n    row = height // 2\n    start = (width - count) // 2\n    out[row, start : start + count] = color\n    return out\n\n# --------------- generator (o5x) ---------------\n# Canvas, palette, and foreground-count controls.\nHEIGHT_MIN, HEIGHT_MAX, HEIGHT_STEP = 5, 11, 2\nWIDTH_MIN, WIDTH_MAX = 10, 28\nBACKGROUND_COLOR = 8\nFOREGROUND_COLORS = tuple(c for c in range(10) if c != BACKGROUND_COLOR)\nCOUNT_MIN, COUNT_MAX = 6, 15\n# Sparse bbox shape, blob growth, and retry controls.\nBBOX_SPAN_MIN, BBOX_SPAN_MAX = 3, 8\nBBOX_FILL_MIN, BBOX_FILL_MAX = 0.29, 0.67\nCOVER_PATTERN_COUNT = 3\nADJACENT_GROW_PROB = 0.85\nGENERATION_ATTEMPTS = 300\n\n\ndef _gen_covering_cells(box_h, box_w):\n    cells = set()\n    mode = random.randrange(COVER_PATTERN_COUNT)\n\n    if mode == 0:\n        length = max(box_h, box_w)\n        flip_r = random.choice([False, True])\n        flip_c = random.choice([False, True])\n        for i in range(length):\n            r = round(i * (box_h - 1) / (length - 1))\n            c = round(i * (box_w - 1) / (length - 1))\n            if flip_r:\n                r = box_h - 1 - r\n            if flip_c:\n                c = box_w - 1 - c\n            cells.add((r, c))\n    elif box_h >= box_w:\n        cols = list(range(box_w)) + [random.randrange(box_w) for _ in range(box_h - box_w)]\n        random.shuffle(cols)\n        cells.update((r, cols[r]) for r in range(box_h))\n    else:\n        rows = list(range(box_h)) + [random.randrange(box_h) for _ in range(box_w - box_h)]\n        random.shuffle(rows)\n        cells.update((rows[c], c) for c in range(box_w))\n\n    return cells\n\n\ndef _gen_adjacent_empty(cells, all_cells):\n    out = []\n    for r, c in all_cells:\n        if (r, c) in cells:\n            continue\n        for rr, cc in cells:\n            if max(abs(r - rr), abs(c - cc)) == 1:\n                out.append((r, c))\n                break\n    return out\n\n\ndef _gen_blob_cells(box_h, box_w, count):\n    cells = _gen_covering_cells(box_h, box_w)\n    all_cells = [(r, c) for r in range(box_h) for c in range(box_w)]\n\n    while len(cells) < count:\n        empty = [p for p in all_cells if p not in cells]\n        frontier = _gen_adjacent_empty(cells, all_cells)\n        pool = frontier if frontier and random.random() < ADJACENT_GROW_PROB else empty\n        cells.add(random.choice(pool))\n\n    return cells\n\n\ndef _gen_bbox_shape(height, width, count):\n    max_h = min(BBOX_SPAN_MAX, height)\n    max_w = min(BBOX_SPAN_MAX, width)\n    shapes = []\n    for box_h in range(BBOX_SPAN_MIN, max_h + 1):\n        for box_w in range(BBOX_SPAN_MIN, max_w + 1):\n            area = box_h * box_w\n            fill = count / area\n            if max(box_h, box_w) < count and BBOX_FILL_MIN <= fill <= BBOX_FILL_MAX:\n                shapes.append((box_h, box_w))\n    if not shapes:\n        for box_h in range(BBOX_SPAN_MIN, max_h + 1):\n            for box_w in range(BBOX_SPAN_MIN, max_w + 1):\n                if max(box_h, box_w) < count and box_h * box_w > count:\n                    shapes.append((box_h, box_w))\n    return random.choice(shapes)\n\n\ndef _draw_centered_segment(height, width, count, bg, color):\n    grid = np.full((height, width), bg, dtype=int)\n    row = height // 2\n    start = (width - count) // 2\n    grid[row, start : start + count] = color\n    return grid\n\n\ndef _draw_scattered_blob(height, width, count, bg, color):\n    grid = np.full((height, width), bg, dtype=int)\n    box_h, box_w = _gen_bbox_shape(height, width, count)\n    r0 = random.randint(0, height - box_h)\n    c0 = random.randint(0, width - box_w)\n    for rr, cc in _gen_blob_cells(box_h, box_w, count):\n        grid[r0 + rr, c0 + cc] = color\n    return grid\n\n\ndef _gen_attempt():\n    height = random.randrange(HEIGHT_MIN, HEIGHT_MAX + 1, HEIGHT_STEP)\n    width = random.randint(WIDTH_MIN, WIDTH_MAX)\n    count_max = min(COUNT_MAX, width)\n    counts = [n for n in range(COUNT_MIN, count_max + 1) if (width - n) % 2 == 0]\n    if not counts:\n        return None\n\n    count = random.choice(counts)\n    bg = BACKGROUND_COLOR\n    color = random.choice(FOREGROUND_COLORS)\n\n    output = _draw_centered_segment(height, width, count, bg, color)\n    inp = _draw_scattered_blob(height, width, count, bg, color)\n    if np.array_equal(main(inp), output):\n        return inp\n    return None\n\n\ndef generate_input():\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid dce56571 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/753ea09b.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg, label_mask, neighbors4, paste\nimport itertools\nimport random\n\n\ndef _unique_largest_color(g: np.ndarray, colors: list[int]) -> int:\n    counts = Counter(int(v) for v in g.ravel())\n    ranked = sorted(colors, key=lambda color: counts[int(color)], reverse=True)\n    assert len(ranked) >= 2, \"expected at least two candidate colors\"\n    assert counts[ranked[0]] > counts[ranked[1]], \"foreground majority must be unique\"\n    return int(ranked[0])\n\n\ndef _long_component_ids(lab: np.ndarray, n: int) -> set[int]:\n    h = int(lab.shape[0])\n    min_row_span = max(1, h // 3)\n    ids: set[int] = set()\n    for comp_id in range(1, n + 1):\n        coords = np.argwhere(lab == comp_id)\n        assert coords.size > 0, \"component labels must be nonempty\"\n        r0 = int(coords[:, 0].min())\n        r1 = int(coords[:, 0].max())\n        if r1 - r0 + 1 >= min_row_span:\n            ids.add(int(comp_id))\n    assert len(ids) >= 2, \"expected at least two long contour components\"\n    return ids\n\n\ndef _two_exterior_bg_ids(bg_lab: np.ndarray, n_bg: int) -> set[int]:\n    assert n_bg >= 3, \"expected interior and exterior background regions\"\n    sizes = {comp_id: int((bg_lab == comp_id).sum()) for comp_id in range(1, n_bg + 1)}\n    size_values = sorted(sizes.values(), reverse=True)\n    assert size_values[1] > size_values[2], \"two exterior regions must be separated by size\"\n    cutoff = size_values[1]\n    exterior = {comp_id for comp_id, size in sizes.items() if size >= cutoff}\n    assert len(exterior) == 2, \"expected exactly two exterior background regions\"\n    return exterior\n\n\ndef _touches_long_contour(\n    coords: np.ndarray,\n    fill_lab: np.ndarray,\n    long_ids: set[int],\n) -> bool:\n    for r, c in coords:\n        for rr, cc in neighbors4(int(r), int(c)):\n            if 0 <= rr < fill_lab.shape[0] and 0 <= cc < fill_lab.shape[1]:\n                if int(fill_lab[rr, cc]) in long_ids:\n                    return True\n    return False\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the small background compartments bounded by the long contour color.\n\n    Input structure:\n    - The grid has one dominant background color and two foreground colors.\n    - The more frequent foreground color forms long 8-connected contour fragments.\n    - The other foreground color is a fixed distractor/obstacle color that partitions\n      the background but is never recolored.\n\n    Rule:\n    - Split the background into 4-connected regions using all foreground pixels as\n      barriers.\n    - Keep the two largest background regions as the outside of the contour drawing.\n    - Recolor every other background region that touches a long contour component\n      to the contour color; leave all foreground pixels unchanged.\n\n    Key insight:\n    The apparent area fill is exactly a component-level fill of bounded background\n    compartments, not a row-wise interpolation between individual contour pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    foreground = colors_present(g, exclude={bg})\n    assert len(foreground) == 2, \"expected exactly two foreground colors\"\n\n    fill_color = _unique_largest_color(g, foreground)\n    fill_lab, _n_fill = label_mask(g == fill_color, connectivity=8)\n    long_ids = _long_component_ids(fill_lab, _n_fill)\n\n    bg_lab, n_bg = label_mask(g == bg, connectivity=4)\n    exterior_ids = _two_exterior_bg_ids(bg_lab, n_bg)\n\n    out = g.copy()\n    for comp_id in range(1, n_bg + 1):\n        if comp_id in exterior_ids:\n            continue\n        coords = np.argwhere(bg_lab == comp_id)\n        if _touches_long_contour(coords, fill_lab, long_ids):\n            out[bg_lab == comp_id] = fill_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\nH, W = 30, 30\nGRID_SHAPE = (H, W)\nARC_COLOR_COUNT = 10\n\n# Long contour path layout.\nPATH_COUNT_OPTIONS = (2, 3)\nPATH_STEP_OPTIONS = (-1, 0, 1)\nPATH_GAP_MIN, PATH_GAP_MAX = 2, 5\nPATH_LEFT_MIN_COL, PATH_RIGHT_MARGIN = 2, 3\nPATH_START_MIN_COL = 3\nPATH_START_RIGHT_MARGIN = 4\nPATH_FAR_END_MIN_CHOICES, PATH_FAR_END_PROB, PATH_FAR_END_DELTA = 8, 0.7, 5\nPATH_SCORING_CANDIDATES = 5\nPATH_MIN_MOVES = 12\n\n# Contour distractors and extra contour pixels.\nOUTSIDE_MARGIN = 2\nOUTSIDE_SIDE_OPTIONS = (-1, 1)\nSHORT_FRAGMENT_COUNT_MIN, SHORT_FRAGMENT_COUNT_MAX = 3, 5\nSHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX = 1, 4\nSHORT_FRAGMENT_ATTEMPTS = 200\nSHORT_FRAGMENT_PATH_PADDING = 3\nCONTOUR_PIXELS_MIN, CONTOUR_PIXELS_MAX = 81, 108\n\n# Obstacle bars and scattered clusters.\nBAR_SEGMENT_MAX = 11\nSINGLE_CHANNEL_BARS_MIN, SINGLE_CHANNEL_BARS_MAX = 5, 11\nMULTI_CHANNEL_TOTAL_BARS_MIN, MULTI_CHANNEL_TOTAL_BARS_MAX = 4, 10\nMULTI_CHANNEL_INITIAL_BARS = 2\nMULTI_CHANNEL_MAX_BARS = 5\nBAR_WIDTH_MIN, BAR_WIDTH_MAX = 1, 5\nOBSTACLE_PIXELS_MIN, OBSTACLE_PIXELS_MAX = 36, 63\nOBSTACLE_EXTRA_PIXELS_MIN = 8\nOBSTACLE_OUTSIDE_QUOTA_MIN, OBSTACLE_OUTSIDE_QUOTA_MAX = 8, 16\nOBSTACLE_CLUSTER_SIZE_MIN, OBSTACLE_CLUSTER_SIZE_MAX = 1, 5\nOBSTACLE_ATTEMPTS = 300\nOBSTACLE_ZONE_OPTIONS = (\"outside\", \"inside\", \"any\")\n\n# Component validation.\nBG_REGIONS_MIN, BG_REGIONS_MAX = 8, 14\nEXTERIOR_REGION_COUNT = 2\nINTERIOR_REGIONS_MIN, INTERIOR_REGIONS_MAX = 6, 12\nINTERIOR_REGION_AREA_MAX = 57\nLONG_COMPONENT_MIN_SPAN = H // 3\nLONG_COMPONENT_COUNT_OPTIONS = (2, 3)\n\n# Retry limits and local neighborhoods.\nGENERATION_ATTEMPTS = 300\nNEIGHBOR_DELTAS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nNEIGHBOR_DELTAS_8 = NEIGHBOR_DELTAS_4 + ((-1, -1), (-1, 1), (1, -1), (1, 1))\n\n\ndef _color_choices() -> tuple[int, int, int]:\n    colors = list(range(ARC_COLOR_COUNT))\n    random.shuffle(colors)\n    return int(colors[0]), int(colors[1]), int(colors[2])\n\n\ndef _path_columns(path_count: int) -> list[list[int]] | None:\n    gaps = [random.randint(PATH_GAP_MIN, PATH_GAP_MAX) for _ in range(path_count - 1)]\n    total_width = sum(gap + 1 for gap in gaps)\n    start_hi = W - PATH_START_RIGHT_MARGIN - total_width\n    if start_hi < PATH_START_MIN_COL:\n        return None\n\n    start = random.randint(PATH_START_MIN_COL, start_hi)\n    end_choices = list(range(PATH_START_MIN_COL, start_hi + 1))\n    if len(end_choices) > PATH_FAR_END_MIN_CHOICES and random.random() < PATH_FAR_END_PROB:\n        far = [c for c in end_choices if abs(c - start) >= PATH_FAR_END_DELTA]\n        if far:\n            end_choices = far\n    end = random.choice(end_choices)\n\n    cols = [start]\n    for gap in gaps:\n        cols.append(cols[-1] + gap + 1)\n    targets = [c + (end - start) for c in cols]\n\n    paths = [[int(c)] for c in cols]\n    for r in range(1, H):\n        valid: list[list[int]] = []\n        for steps in itertools.product(PATH_STEP_OPTIONS, repeat=path_count):\n            nxt = [cols[i] + steps[i] for i in range(path_count)]\n            if nxt[0] < PATH_LEFT_MIN_COL or nxt[-1] > W - PATH_RIGHT_MARGIN:\n                continue\n            if all(PATH_GAP_MIN <= nxt[i + 1] - nxt[i] - 1 <= PATH_GAP_MAX for i in range(path_count - 1)):\n                valid.append(nxt)\n        if not valid:\n            return None\n        ideal = [paths[i][0] + (targets[i] - paths[i][0]) * r / (H - 1) for i in range(path_count)]\n        scored = sorted(\n            valid,\n            key=lambda nxt: sum(abs(nxt[i] - ideal[i]) for i in range(path_count)) + random.random(),\n        )\n        cols = random.choice(scored[: max(1, min(PATH_SCORING_CANDIDATES, len(scored)))])\n        for i, c in enumerate(cols):\n            paths[i].append(int(c))\n\n    moves = sum(paths[i][r] != paths[i][r - 1] for i in range(path_count) for r in range(1, H))\n    if moves < PATH_MIN_MOVES:\n        return None\n    return paths\n\n\ndef _outside_enclosure(paths: list[list[int]], r: int, c: int, margin: int = OUTSIDE_MARGIN) -> bool:\n    return c <= paths[0][r] - margin or c >= paths[-1][r] + margin\n\n\ndef _inside_channel(paths: list[list[int]], r: int, c: int) -> bool:\n    return any(paths[i][r] < c < paths[i + 1][r] for i in range(len(paths) - 1))\n\n\ndef _touches_mask(mask: np.ndarray, coords: list[tuple[int, int]], connectivity: int) -> bool:\n    seen = set(coords)\n    deltas = NEIGHBOR_DELTAS_8 if connectivity == 8 else NEIGHBOR_DELTAS_4\n    for r, c in coords:\n        for dr, dc in deltas:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in seen and mask[rr, cc]:\n                return True\n    return False\n\n\ndef _place_short_fragments(\n    grid: np.ndarray, contour_mask: np.ndarray, paths: list[list[int]], contour: int, count: int\n) -> bool:\n    for _ in range(count):\n        size = random.randint(SHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX)\n        placed = False\n        for _attempt in range(SHORT_FRAGMENT_ATTEMPTS):\n            r = random.randrange(H)\n            side = random.choice(OUTSIDE_SIDE_OPTIONS)\n            if side < 0:\n                hi = paths[0][r] - SHORT_FRAGMENT_PATH_PADDING - size + 1\n                if hi < 0:\n                    continue\n","exit_code":0,"status":"completed"}}
