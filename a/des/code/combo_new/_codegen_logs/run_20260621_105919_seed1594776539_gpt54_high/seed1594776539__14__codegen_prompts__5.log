{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/5b37cb25.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, in_bounds, paste, random_free_location\nimport random\nfrom itertools import product\n\n\n_CROSS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))\n_DIRECTIONS = {\n    \"top\": (-1, 0),\n    \"bottom\": (1, 0),\n    \"left\": (0, -1),\n    \"right\": (0, 1),\n}\n\n\ndef _uniform_side(side: np.ndarray) -> int:\n    vals = np.unique(side)\n    assert len(vals) == 1, \"expected each frame side to be one solid color\"\n    return int(vals[0])\n\n\ndef _interior_colors(interior: np.ndarray) -> tuple[int, int]:\n    vals, counts = np.unique(interior, return_counts=True)\n    max_count = counts.max()\n    assert int(np.sum(counts == max_count)) == 1, \"expected a unique dominant interior background\"\n    bg = int(vals[int(np.argmax(counts))])\n    obj_colors = [int(v) for v in vals if int(v) != bg]\n    assert len(obj_colors) == 1, \"expected one interior foreground object color\"\n    return bg, obj_colors[0]\n\n\ndef _direction_for_notch(g: np.ndarray, r: int, c: int, obj: int) -> list[str]:\n    dirs = []\n    shape = g.shape\n    for name, (dr, dc) in _DIRECTIONS.items():\n        pr, pc = -dc, dr\n        support = (\n            (r - 2 * dr, c - 2 * dc),\n            (r - dr + pr, c - dc + pc),\n            (r - dr - pr, c - dc - pc),\n            (r + 2 * pr, c + 2 * pc),\n            (r - 2 * pr, c - 2 * pc),\n        )\n        open_side = (\n            (r + 2 * dr, c + 2 * dc),\n            (r + dr + pr, c + dc + pc),\n            (r + dr - pr, c + dc - pc),\n        )\n        if not all(in_bounds(shape, rr, cc) and int(g[rr, cc]) == obj for rr, cc in support):\n            continue\n        if not all((not in_bounds(shape, rr, cc)) or int(g[rr, cc]) != obj for rr, cc in open_side):\n            continue\n        dirs.append(name)\n    return dirs\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Fill each plus-shaped background notch with the color of the frame side it opens toward.\n\n    Input structure\n    - A one-cell-thick rectangular frame has four solid-colored sides and neutral corner pixels.\n    - The frame interior contains a dominant background color and one foreground object color.\n    - Some object boundaries contain five-pixel plus-shaped background notches.\n\n    Rule\n    - Find every background plus whose opposite side is supported by foreground object pixels and whose open side faces one frame side.\n    - Recolor the five pixels of that plus with the color of the facing frame side.\n    - Leave all other pixels unchanged.\n\n    Key insight\n    The frame side colors are direction labels for the open notches in the foreground object.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    h, w = g.shape\n    assert h >= 5 and w >= 5, \"expected room for a frame and plus notches\"\n\n    side_color = {\n        \"top\": _uniform_side(g[0, 1:-1]),\n        \"bottom\": _uniform_side(g[-1, 1:-1]),\n        \"left\": _uniform_side(g[1:-1, 0]),\n        \"right\": _uniform_side(g[1:-1, -1]),\n    }\n    bg, obj = _interior_colors(g[1:-1, 1:-1])\n\n    out = g.copy()\n    painted: set[tuple[int, int]] = set()\n    notch_count = 0\n    for r in range(1, h - 1):\n        for c in range(1, w - 1):\n            cross = tuple((r + dr, c + dc) for dr, dc in _CROSS)\n            if not all(int(g[rr, cc]) == bg for rr, cc in cross):\n                continue\n\n            dirs = _direction_for_notch(g, r, c, obj)\n            assert len(dirs) <= 1, \"expected each plus notch to open in at most one direction\"\n            if not dirs:\n                continue\n\n            notch_count += 1\n            color = side_color[dirs[0]]\n            for cell in cross:\n                assert cell not in painted, \"expected non-overlapping plus notches\"\n                painted.add(cell)\n                out[cell] = color\n\n    assert notch_count > 0, \"expected at least one plus notch\"\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\n_GEN_GRID_SIZE, _GEN_CORNER_COLOR = 30, 0\n_GEN_COLOR_POOL, _GEN_PALETTE_SIZE = range(1, 10), 6\n\n# Object size and total filled-area budget.\n_OBJECT_COUNT_MIN, _OBJECT_COUNT_MAX = 3, 4\n_OBJECT_DIM_MIN, _OBJECT_DIM_MAX = 5, 20\n_OBJECT_AREA_MIN, _OBJECT_AREA_MAX = 30, 180\n_TOTAL_OBJECT_AREA_MAX, _MIN_REMAINING_OBJECT_AREA = 360, 30\n\n# Placement gap against frame and other objects.\n_PLACEMENT_BORDER, _PLACEMENT_PADDING, _PLACEMENT_PADDING_CONNECTIVITY = 2, 2, 8\n\n# Notch geometry and counts.\n_GEN_CROSS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))\n_GEN_DIRECTIONS = {\n    \"top\": (-1, 0),\n    \"bottom\": (1, 0),\n    \"left\": (0, -1),\n    \"right\": (0, 1),\n}\n_EDGES = tuple(_GEN_DIRECTIONS)\n_NOTCH_EDGE_MARGIN, _MAX_TOTAL_NOTCHES = 2, 8\n_NOTCHES_PER_OBJECT = (1, 2, 3)\n\n# Rejection-sampling retry cap.\n_GEN_RETRY_LIMIT = 300\n_DIM_PAIRS = [(h, w) for h in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1)\n              for w in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1) if _OBJECT_AREA_MIN <= h * w <= _OBJECT_AREA_MAX]\n\n\ndef _notch_cells(r, c, direction):\n    dr, dc = _GEN_DIRECTIONS[direction]\n    pr, pc = -dc, dr\n    cross = tuple((r + rr, c + cc) for rr, cc in _GEN_CROSS)\n    support = (\n        (r - 2 * dr, c - 2 * dc),\n        (r - dr + pr, c - dc + pc),\n        (r - dr - pr, c - dc - pc),\n        (r + 2 * pr, c + 2 * pc),\n        (r - 2 * pr, c - 2 * pc),\n    )\n    open_side = (\n        (r + 2 * dr, c + 2 * dc),\n        (r + dr + pr, c + dc + pc),\n        (r + dr - pr, c + dc - pc),\n    )\n    return {\"direction\": direction, \"cross\": cross, \"support\": support, \"open_side\": open_side}\n\n\ndef _candidate_notches(r0, c0, h, w, edge):\n    if edge in (\"top\", \"bottom\"):\n        row = r0 if edge == \"top\" else r0 + h - 1\n        centers = [(row, c) for c in range(c0 + _NOTCH_EDGE_MARGIN, c0 + w - _NOTCH_EDGE_MARGIN)]\n    else:\n        col = c0 if edge == \"left\" else c0 + w - 1\n        centers = [(r, col) for r in range(r0 + _NOTCH_EDGE_MARGIN, r0 + h - _NOTCH_EDGE_MARGIN)]\n    return [_notch_cells(r, c, edge) for r, c in centers]\n\n\ndef _choose_notches(r0, c0, h, w, count):\n    edges = random.sample(_EDGES, count)\n    random.shuffle(edges)\n    choices = {edge: _candidate_notches(r0, c0, h, w, edge) for edge in edges}\n\n    def search(i, chosen, carved, protected):\n        if i == len(edges):\n            return chosen\n        options = choices[edges[i]][:]\n        random.shuffle(options)\n        for notch in options:\n            cross = set(notch[\"cross\"])\n            support = set(notch[\"support\"])\n            if cross & carved or cross & protected or support & carved:\n                continue\n            result = search(i + 1, chosen + [notch], carved | cross, protected | support)\n            if result is not None:\n                return result\n        return None\n\n    return search(0, [], set(), set())\n\n\ndef _notch_counts(n_objects):\n    total = random.randint(n_objects, min(_MAX_TOTAL_NOTCHES, max(_NOTCHES_PER_OBJECT) * n_objects))\n    plans = [p for p in product(_NOTCHES_PER_OBJECT, repeat=n_objects) if sum(p) == total]\n    plan = list(random.choice(plans))\n    random.shuffle(plan)\n    return plan\n\n\ndef _place_rectangles(out, obj, n_objects, counts):\n    \"\"\"Place object rectangles and return (r,c,h,w,notch_count) records, or None.\"\"\"\n    placement = np.zeros((_GEN_GRID_SIZE, _GEN_GRID_SIZE), dtype=int)\n    rects = []\n    total_area = 0\n    for i in range(n_objects):\n        remaining = n_objects - i - 1\n        area_cap = _TOTAL_OBJECT_AREA_MAX - _MIN_REMAINING_OBJECT_AREA * remaining\n        valid = [p for p in _DIM_PAIRS if total_area + p[0] * p[1] <= area_cap]\n        if not valid:\n            return None\n        h, w = random.choice(valid)\n        patch = np.ones((h, w), dtype=int)\n        try:\n            r, c = random_free_location(\n                placement, patch, transparent=0, border=_PLACEMENT_BORDER, padding=_PLACEMENT_PADDING,\n                padding_connectivity=_PLACEMENT_PADDING_CONNECTIVITY,\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/34cfa167.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg\nimport random\n\n\ndef _is_solid_rect(g: np.ndarray, comp: dict) -> bool:\n    r0, c0, r1, c1 = comp[\"bbox\"]\n    area = int((r1 - r0 + 1) * (c1 - c0 + 1))\n    return int(comp[\"area\"]) == area and bool(np.all(g[r0 : r1 + 1, c0 : c1 + 1] == int(comp[\"color\"])))\n\n\ndef _find_structure(g: np.ndarray, bg: int) -> tuple[dict, dict, list[dict], list[dict]]:\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n    rects = [comp for comp in comps if _is_solid_rect(g, comp)]\n\n    candidates: list[tuple[dict, dict, list[dict], list[dict]]] = []\n    for color in {int(comp[\"color\"]) for comp in rects}:\n        same_color = [comp for comp in rects if int(comp[\"color\"]) == color]\n        for i, a in enumerate(same_color):\n            for b in same_color[i + 1 :]:\n                if bbox_h(a[\"bbox\"]) != bbox_h(b[\"bbox\"]) or bbox_w(a[\"bbox\"]) != bbox_w(b[\"bbox\"]):\n                    continue\n\n                ar0, ac0, _ar1, _ac1 = a[\"bbox\"]\n                br0, bc0, _br1, _bc1 = b[\"bbox\"]\n                if ar0 < br0 and ac0 < bc0:\n                    source, dest = a, b\n                elif br0 < ar0 and bc0 < ac0:\n                    source, dest = b, a\n                else:\n                    continue\n\n                sr0, sc0, sr1, sc1 = source[\"bbox\"]\n                dr0, dc0, _dr1, _dc1 = dest[\"bbox\"]\n                right = [\n                    comp\n                    for comp in rects\n                    if int(comp[\"color\"]) != color\n                    and comp[\"bbox\"][0] == sr0\n                    and comp[\"bbox\"][2] == sr1\n                    and comp[\"bbox\"][1] == comp[\"bbox\"][3]\n                    and sc1 < comp[\"bbox\"][1] < dc0\n                ]\n                below = [\n                    comp\n                    for comp in rects\n                    if int(comp[\"color\"]) != color\n                    and comp[\"bbox\"][1] == sc0\n                    and comp[\"bbox\"][3] == sc1\n                    and comp[\"bbox\"][0] == comp[\"bbox\"][2]\n                    and sr1 < comp[\"bbox\"][0] < dr0\n                ]\n\n                right_with_offsets = sorted(\n                    ((int(comp[\"bbox\"][1] - sc1), comp) for comp in right),\n                    key=lambda item: item[0],\n                )\n                below_with_offsets = sorted(\n                    ((int(comp[\"bbox\"][0] - sr1), comp) for comp in below),\n                    key=lambda item: item[0],\n                )\n                if len(right_with_offsets) == 2 and len(below_with_offsets) == 2:\n                    right_offsets = [offset for offset, _comp in right_with_offsets]\n                    below_offsets = [offset for offset, _comp in below_with_offsets]\n                    if right_offsets == below_offsets and right_offsets[0] == 1:\n                        candidates.append(\n                            (\n                                source,\n                                dest,\n                                [comp for _offset, comp in right_with_offsets],\n                                [comp for _offset, comp in below_with_offsets],\n                            )\n                        )\n\n    assert len(candidates) == 1, \"expected one anchor pair with matching right and below controls\"\n    return candidates[0]\n\n\ndef _paint(out: np.ndarray, bg: int, r: int, c: int, color: int) -> None:\n    assert int(out[r, c]) in {int(bg), int(color)}, \"paint target must be empty or already matching\"\n    out[r, c] = int(color)\n\n\ndef _paint_rect(out: np.ndarray, bg: int, r0: int, c0: int, r1: int, c1: int, color: int) -> None:\n    for r in range(int(r0), int(r1) + 1):\n        for c in range(int(c0), int(c1) + 1):\n            _paint(out, bg, r, c, color)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.\n\n    Input structure:\n    - The background is the dominant color.\n    - Two same-color solid rectangular anchors of the same size sit on opposite\n      diagonal corners, with the first anchor above-left of the second.\n    - The upper-left anchor has two one-cell-thick vertical control bars to its\n      right and two one-cell-thick horizontal control bars below it.\n\n    Rule:\n    - Copy the anchor rectangle into the two missing corners of the implied\n      larger rectangle.\n    - Repeat the right-side control bars horizontally between the left and right\n      anchors, using their spacing as the period, and draw the outer top and\n      bottom borders in the first right-control color.\n    - Repeat the below-side control bars vertically between the top and bottom\n      anchors, using the same period, and draw the outer left and right borders\n      in the first below-control color.\n\n    Key insight: The small control bars are the first two ticks of two periodic\n    frame patterns; the diagonal anchor supplies the opposite corner and the\n    missing two anchor copies.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    source, dest, right_controls, below_controls = _find_structure(g, bg)\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    dr0, dc0, dr1, dc1 = dest[\"bbox\"]\n    anchor_color = int(source[\"color\"])\n    assert int(dest[\"color\"]) == anchor_color, \"anchor colors must match\"\n    assert bbox_h(source[\"bbox\"]) == bbox_h(dest[\"bbox\"]), \"anchor heights must match\"\n    assert bbox_w(source[\"bbox\"]) == bbox_w(dest[\"bbox\"]), \"anchor widths must match\"\n    assert sr0 > 0 and sc0 > 0, \"upper-left anchor must have space for outer frame\"\n    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \"lower-right anchor must have space for outer frame\"\n\n    right_offsets = [int(comp[\"bbox\"][1] - sc1) for comp in right_controls]\n    below_offsets = [int(comp[\"bbox\"][0] - sr1) for comp in below_controls]\n    assert right_offsets == below_offsets and right_offsets[0] == 1, \"control offsets must match from the anchor edge\"\n    step = int(right_offsets[1] - right_offsets[0])\n    assert step > 0, \"control bars must be separated\"\n    period = 2 * step\n    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, \"right frame must close next to the destination anchor\"\n    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, \"below frame must close next to the destination anchor\"\n\n    right_colors = [int(comp[\"color\"]) for comp in right_controls]\n    below_colors = [int(comp[\"color\"]) for comp in below_controls]\n    out = g.copy()\n\n    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)\n    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)\n\n    first_c = int(sc1 + right_offsets[0])\n    last_c = int(dc0 - 1)\n    for c in range(first_c, last_c + 1):\n        offset = int(c - sc1)\n        if (offset - right_offsets[0]) % period == 0:\n            color = right_colors[0]\n        elif (offset - right_offsets[1]) % period == 0:\n            color = right_colors[1]\n        else:\n            continue\n        _paint_rect(out, bg, sr0, c, sr1, c, color)\n        _paint_rect(out, bg, dr0, c, dr1, c, color)\n\n    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])\n    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])\n\n    first_r = int(sr1 + below_offsets[0])\n    last_r = int(dr0 - 1)\n    left_c = int(sc0 - 1)\n    right_c = int(dc1 + 1)\n    for r in range(first_r, last_r + 1):\n        _paint(out, bg, r, left_c, below_colors[0])\n        _paint(out, bg, r, right_c, below_colors[0])\n\n        offset = int(r - sr1)\n        if (offset - below_offsets[0]) % period == 0:\n            _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])\n            _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])\n        elif (offset - below_offsets[1]) % period == 0:\n            _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])\n            _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color sampling.\nCOLOR_COUNT, NON_BG_COLOR_COUNT = 10, 4\n\n# Anchor/repetition geometry.\nANCHOR_SIZE_RANGE = (1, 5)\nREPEAT_COUNT_RANGE = (2, 5)\nCONTROL_OFFSETS = (1, 3)\nFRAME_PERIOD, DEST_ANCHOR_GAP, STRUCTURE_FIXED_PAD = 4, 2, 3\n\n# Canvas/margins.\nCANVAS_MIN_SIZE, CANVAS_MAX_SIZE = 16, 30\nMARGIN_CHOICES = range(4)\nMIN_TOTAL_MARGIN, SOURCE_OUTER_MARGIN = 1, 1\n\n# Retry.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_paint_rect(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int) -> None:\n    grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)\n\n\ndef _choose_margins(struct_len: int) -> tuple[int, int]:\n    pairs = [\n        (before, after)\n        for before in MARGIN_CHOICES\n        for after in MARGIN_CHOICES\n        if MIN_TOTAL_MARGIN <= before + after\n        and CANVAS_MIN_SIZE <= struct_len + before + after <= CANVAS_MAX_SIZE\n    ]\n    return pairs[int(np.random.randint(len(pairs)))]\n\n\ndef _build_output(\n    rows: int,\n    cols: int,\n    bg: int,\n    anchor_color: int,\n","exit_code":0,"status":"completed"}}
