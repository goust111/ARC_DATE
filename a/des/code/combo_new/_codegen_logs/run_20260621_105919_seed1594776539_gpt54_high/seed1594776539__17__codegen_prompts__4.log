bars) == 1, f\"expected one next-longer target bar, got {[bar['bbox'] for bar in target_bars]}\"\n    target = target_bars[0]\n    tr0, tc0, tr1, _tc1 = target[\"bbox\"]\n    target_half = target_h // 2\n\n    out = g.copy()\n    out[g == marker_color] = bar_color\n    if marked_end == \"top\":\n        out[tr0 : tr0 + target_half, tc0] = marker_color\n    else:\n        out[tr1 - target_half + 1 : tr1 + 1, tc0] = marker_color\n\n    return out\n\n--- generate_input (205-210) ---\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 48634b99 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/800d221b.py =====\n--- main (6-173) ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor a path-network by adjacent seed regions.\n\n    Input structure:\n    - bg = most common color.\n    - Path color P forms a thin orthogonal network with a solid square hub (NxN).\n    - Seed colors appear in colored regions (non-bg, non-P) adjacent to path branches.\n\n    Rule:\n    - Infer P as the non-bg color whose largest component is most network-like.\n    - Find the largest solid k×k all-P square (the hub); exclude it from recoloring.\n    - Recolor each path branch to the seed-region color it touches most.\n    - Recolor the hub center pixel to the seed whose branches touch the hub most.\n\n    Key insight: The hub stays uncolored; branches inherit color from adjacent seed regions by adjacency count.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    colors = sorted({int(x) for x in np.unique(g)} - {int(bg)})\n    assert not (not colors)\n\n    def comp_deg_score(mask: np.ndarray) -> float:\n        comps = components_mask(mask, connectivity=4)\n        if not comps:\n            return -1e9\n        best_pts = max(comps, key=lambda coords: int(coords.shape[0]))\n        best_sz = int(best_pts.shape[0])\n\n        m = np.zeros(mask.shape, dtype=bool)\n        m[best_pts[:, 0], best_pts[:, 1]] = True\n\n        deg2 = 0\n        deg4 = 0\n        for r, c in best_pts:\n            r = int(r)\n            c = int(c)\n            d = 0\n            if r > 0 and bool(m[r - 1, c]):\n                d += 1\n            if r + 1 < H and bool(m[r + 1, c]):\n                d += 1\n            if c > 0 and bool(m[r, c - 1]):\n                d += 1\n            if c + 1 < W and bool(m[r, c + 1]):\n                d += 1\n            if d == 2:\n                deg2 += 1\n            elif d == 4:\n                deg4 += 1\n        frac2 = deg2 / max(1, best_sz)\n        frac4 = deg4 / max(1, best_sz)\n        return float((frac2 - frac4) * best_sz)\n\n    P = int(max(colors, key=lambda c: comp_deg_score(g == int(c))))\n\n    # --- hub: largest solid k×k all-P square anywhere ---\n    mP = g == int(P)\n    ps = mP.astype(int).cumsum(axis=0).cumsum(axis=1)\n\n    def rect_sum(r0: int, c0: int, r1: int, c1: int) -> int:\n        s = int(ps[int(r1), int(c1)])\n        if r0 > 0:\n            s -= int(ps[int(r0 - 1), int(c1)])\n        if c0 > 0:\n            s -= int(ps[int(r1), int(c0 - 1)])\n        if r0 > 0 and c0 > 0:\n            s += int(ps[int(r0 - 1), int(c0 - 1)])\n        return int(s)\n\n    best = None  # (k, r0, c0)\n    max_k = int(min(H, W))\n    for k in range(2, max_k + 1):\n        found = None\n        for r0 in range(0, int(H - k + 1)):\n            r1 = int(r0 + k - 1)\n            for c0 in range(0, int(W - k + 1)):\n                c1 = int(c0 + k - 1)\n                if rect_sum(int(r0), int(c0), int(r1), int(c1)) == int(k * k):\n                    found = (int(k), int(r0), int(c0))\n        if found is not None:\n            best = found\n\n    assert not (best is None)\n\n    k, r0, c0 = map(int, best)\n    r1, c1 = int(r0 + k - 1), int(c0 + k - 1)\n    hub = np.zeros((H, W), dtype=bool)\n    hub[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = True\n\n    # --- seed regions (non-bg, non-P) ---\n    seed_mask = (g != int(bg)) & (g != int(P))\n    seed_lab, seed_n = label_mask(seed_mask, connectivity=4)\n    seed_major: dict[int, int] = {}\n    all_seed_vals: list[int] = []\n    for sid in range(1, int(seed_n) + 1):\n        pts = np.argwhere(seed_lab == int(sid))\n        rn, rx = int(pts[:, 0].min()), int(pts[:, 0].max())\n        cn, cx = int(pts[:, 1].min()), int(pts[:, 1].max())\n        if rn > 0:\n            assert all(int(g[rn - 1, c]) == int(P) for c in range(cn, cx + 1)), \"seed missing top P border\"\n        if rx < H - 1:\n            assert all(int(g[rx + 1, c]) == int(P) for c in range(cn, cx + 1)), \"seed missing bot P border\"\n        if cn > 0:\n            assert all(int(g[r, cn - 1]) == int(P) for r in range(rn, rx + 1)), \"seed missing left P border\"\n        if cx < W - 1:\n            assert all(int(g[r, cx + 1]) == int(P) for r in range(rn, rx + 1)), \"seed missing right P border\"\n        vals = [int(g[int(r), int(c)]) for r, c in pts]\n        maj = int(Counter(vals).most_common(1)[0][0])\n        seed_major[int(sid)] = int(maj)\n        all_seed_vals.extend(vals)\n\n    out = g.copy()\n\n    # --- recolor each path branch by the seed region it touches most ---\n    branch_mask = (g == int(P)) & (~hub)\n    branch_lab, branch_n = label_mask(branch_mask, connectivity=4)\n\n    pmask = g == int(P)\n    ppad = np.pad(pmask, 1)\n    p_deg = ppad[2:, 1:-1].astype(int) + ppad[:-2, 1:-1] + ppad[1:-1, 2:] + ppad[1:-1, :-2]\n    spad = np.pad(seed_lab > 0, 1)\n    adj_seed = spad[2:, 1:-1] | spad[:-2, 1:-1] | spad[1:-1, 2:] | spad[1:-1, :-2]\n    assert not np.any((p_deg > 2) & pmask & ~hub & ~adj_seed), \"path has T-junction\"\n\n    for bid in range(1, int(branch_n) + 1):\n        pts = np.argwhere(branch_lab == int(bid))\n        touches = Counter()\n        for r, c in pts:\n            r = int(r)\n            c = int(c)\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr, cc = int(r + dr), int(c + dc)\n                if 0 <= rr < H and 0 <= cc < W:\n                    sid = int(seed_lab[rr, cc])\n                    if sid != 0:\n                        touches[int(sid)] += 1\n        if not touches:\n            continue\n        sid = int(touches.most_common(1)[0][0])\n        col = int(seed_major[int(sid)])\n        for r, c in pts:\n            out[int(r), int(c)] = int(col)\n\n    # --- hub center pixel recolor ---\n    touch_cols = Counter()\n    if int(branch_n) > 0:\n        for r in range(H):\n            for c in range(W):\n                if not bool(hub[int(r), int(c)]):\n                    continue\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    rr, cc = int(r + dr), int(c + dc)\n                    if 0 <= rr < H and 0 <= cc < W:\n                        if int(branch_lab[rr, cc]) != 0:\n                            touch_cols[int(out[rr, cc])] += 1\n\n    cr = int(r0 + k // 2)\n    cc = int(c0 + k // 2)\n\n    assert touch_cols, 'hub must be touched by at least one recolored branch'\n    assert all_seed_vals, 'grid must contain seed regions'\n    center_col = int(touch_cols.most_common(1)[0][0])\n    out[int(cr), int(cc)] = int(center_col)\n\n    return out\n\n--- generate_input (522-530) ---\ndef generate_input():\n    for _ in range(GEN_OUTER_RETRIES):\n        try:\n            r = _gen_attempt()\n        except Exception:\n            r = None\n        if r is not None:\n            return r\n    raise RuntimeError(\"generate_input failed after %d attempts\" % GEN_OUTER_RETRIES)\n\n===== /home/lixinyu/snap/new/ARC_code/train/3ad05f52.py =====\n--- main (127-219) ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Paint the maze corridor and framed rooms lying on shortest paths between the two colored endpoint components.\n\n    Input structure\n    - The grid has a dominant background, one wall color forming thin orthogonal frames, and one endpoint/fill color.\n    - The endpoint/fill color forms exactly two 4-connected solid rectangular components; their larger side lengths define the framed room sizes.\n\n    Rule\n    - Treat wall pixels as blocked and every other pixel as passable.\n    - Find every passable pixel that lies on a shortest 4-connected path between the two endpoint components.\n    - Also fill any framed square room of an endpoint-derived size that intersects that shortest-path mask.\n\n    Key insight\n    - Shortest paths identify the route through open connector corridors, while the wall-bordered square rooms need to be expanded from the route centerline to their full interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    counts = Counter(map(int, g.flat))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 2\n    assert counts[bg] > max(counts[color] for color in non_bg)\n    non_bg_counts = {color: int(np.count_nonzero(g == color)) for color in non_bg}\n    wall_count = max(non_bg_counts.values())\n    wall_candidates = [color for color, count in non_bg_counts.items() if count == wall_count]\n    assert len(wall_candidates) == 1\n    wall = wall_candidates[0]\n    paint_candidates = [color for color in non_bg if color != wall]\n    assert len(paint_candidates) == 1\n    paint = paint_candidates[0]\n    assert non_bg_counts[wall] > non_bg_counts[paint]\n\n    endpoints = find_components(g, bg=bg, colors=[paint], connectivity=4)\n    assert len(endpoints) == 2\n    endpoint_coords = [component[\"coords\"] for component in endpoints]\n\n    room_sizes: set[int] = set()\n    for coords in endpoint_coords:\n        r0, c0, r1, c1 = bbox_coords(coords)\n        bh = r1 - r0 + 1\n        bw = c1 - c0 + 1\n        assert coords.shape[0] == bh * bw\n        room_sizes.add(max(bh, bw))\n\n    passable = g != wall\n    dist0 = _distances_from(endpoint_coords[0], passable)\n    dist1 = _distances_from(endpoint_coords[1], passable)\n    endpoint_distances = [int(dist0[r, c]) for r, c in endpoint_coords[1]]\n    reachable_distances = [d for d in endpoint_distances if d >= 0]\n    assert len(reachable_distances) == len(endpoint_distances)\n    shortest = min(reachable_distances)\n\n    route = (dist0 >= 0) & (dist1 >= 0) & (dist0 + dist1 == shortest)\n    assert np.any(route)\n\n    fill = route.copy()\n    rooms = _framed_square_rooms(g, wall, room_sizes)\n    assert rooms\n    for r, c, n in rooms:\n        if np.any(route[r : r + n, c : c + n]):\n            fill[r : r + n, c : c + n] = True\n\n    room_mask = np.zeros_like(fill, dtype=bool)\n    for r, c, n in rooms:\n        room_mask[r : r + n, c : c + n] = True\n    open_fill = fill & (g == bg) & ~room_mask\n    for r0, c0, r1, c1, area in _component_bboxes(open_fill):\n        if r1 > r0 and c1 > c0 and area >= 20:\n            assert _middle_fill_bounded_by_side_rooms(\n                (r0, c0, r1, c1),\n                rooms,\n            ), \"middle fill must stay within the facing room-frame spans\"\n\n    H, W = g.shape\n    for r, c, n in rooms:\n        has_doorway = False\n        if r > 0:\n            has_doorway = has_doorway or np.any(g[r - 1, c : c + n] != wall)\n        if r + n < H:\n            has_doorway = has_doorway or np.any(g[r + n, c : c + n] != wall)\n        if c > 0:\n            has_doorway = has_doorway or np.any(g[r : r + n, c - 1] != wall)\n        if c + n < W:\n            has_doorway = has_doorway or np.any(g[r : r + n, c + n] != wall)\n        if has_doorway:\n            assert np.any(fill[r : r + n, c : c + n]), \"rooms with doorways must be on the shortest path\"\n\n    out = g.copy()\n    out[fill & (g == bg)] = paint\n    return out\n\n--- generate_input (719-724) ---\ndef generate_input():\n    for _ in range(GENERATE_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 3ad05f52 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/fc4aaf52.py =====\n--- main (16-74) ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Split the two-color object horizontally, swap its colors, and slide the upper half to the right.\n\n    Input structure:\n    - The grid has one background color and exactly two foreground colors.\n    - All foreground pixels form one 4-connected object with an even-height bbox.\n    - The object has foreground pixels on both rows adjacent to its horizontal midpoint.\n\n    Rule:\n    - Split the object into upper and lower halves at the midpoint of its bbox.\n    - Swap the two foreground colors in both halves.\n    - Keep the lower half in place and shift the upper half right until its lower-left\n      boundary pixel is diagonally adjacent to the lower half's upper-right boundary pixel.\n\n    Key insight:\n    - The object is not copied or reflected; it is broken at the horizontal waist,\n      recolored by exchanging the two visible object colors, then rejoined diagonally.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected exactly two foreground colors\"\n    color_a, color_b = colors\n\n    objects = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert len(objects) == 1, \"expected one connected foreground object\"\n    r0, _c0, r1, _c1 = objects[0][\"bbox\"]\n    height = int(r1 - r0 + 1)\n    assert height % 2 == 0, \"object bbox height must split evenly\"\n\n    split_row = int(r0 + height // 2)\n    row_ids = np.arange(g.shape[0])[:, None]\n    fg = g != int(bg)\n    upper = fg & (row_ids < split_row)\n    lower = fg & (row_ids >= split_row)\n    assert np.any(upper), \"expected a nonempty upper half\"\n    assert np.any(lower), \"expected a nonempty lower half\"\n    assert int(upper.sum()) == int(lower.sum()), \"expected equal upper and lower areas\"\n\n    upper_boundary_cols = np.flatnonzero(upper[split_row - 1])\n    lower_boundary_cols = np.flatnonzero(lower[split_row])\n    assert upper_boundary_cols.size > 0, \"upper half must touch the split boundary\"\n    assert lower_boundary_cols.size > 0, \"lower half must touch the split boundary\"\n\n    shift = int(lower_boundary_cols.max() + 1 - upper_boundary_cols.min())\n    assert shift > 0, \"upper half must shift right\"\n\n    upper_rows, upper_cols = np.where(upper)\n    lower_rows, lower_cols = np.where(lower)\n    shifted_upper_cols = upper_cols + shift\n    assert int(shifted_upper_cols.max()) < g.shape[1], \"shifted upper half must fit in the grid\"\n\n    out = np.full_like(g, int(bg))\n    out[lower_rows, lower_cols] = _swapped_values(g[lower_rows, lower_cols], color_a, color_b)\n    out[upper_rows, shifted_upper_cols] = _swapped_values(g[upper_rows, upper_cols], color_a, color_b)\n    return out\n\n--- generate_input (168-173) ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid fc4aaf52 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/f8f52ecc.py =====\n--- main (106-161) ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect same-colored foreground components with one-cell-wide orthogonal paths around teal wall segments.\n\n    Input structure\n    - The dominant color is the background.\n    - Teal cells are fixed wall segments and are never source connectors.\n    - Other foreground colors appear as one or more 4-connected components; colors with a single component stay unchanged.\n\n    Rule\n    - For each non-background, non-teal color, read its 4-connected components in row-major order.\n    - Connect each consecutive pair by the shortest clear L-shaped path between the two components.\n    - Clear paths may pass only through background or the same color, and they preserve the previous travel axis when both bends are possible.\n\n    Key insight\n    - The output is not a global recolor: each color traces a routed chain through its own components while teal cells and other colors act as blockers.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    wall = Color.TEAL\n    assert np.any(g == wall), \"expected teal wall cells\"\n\n    out = g.copy()\n    connected_color_count = 0\n    for color in _source_colors(g, bg, wall):\n        comps = [\n            comp[\"coords\"]\n            for comp in find_components(\n                g,\n                bg=bg,\n                connectivity=4,\n                monochromatic=True,\n                colors=[color],\n            )\n        ]\n        comps.sort(key=lambda coords: tuple(map(int, coords.min(axis=0))))\n        if len(comps) < 2:\n            continue\n        if len(comps) == 2 and len(comps[0]) == 1 and len(comps[1]) == 1:\n            a = tuple(map(int, comps[0][0]))\n            b = tuple(map(int, comps[1][0]))\n            if a[0] != b[0] and a[1] != b[1]:\n                h_clear = _clear(_path_cells(a, b, \"h\"), g, bg, color)\n                v_clear = _clear(_path_cells(a, b, \"v\"), g, bg, color)\n                assert not (h_clear and v_clear), \"two diagonal singleton components need a blocking obstacle\"\n\n        connected_color_count += 1\n        previous_axis: str | None = None\n        for comp_a, comp_b in zip(comps, comps[1:]):\n            path, previous_axis = _connector_path(comp_a, comp_b, out, bg, color, previous_axis)\n            for r, c in path:\n                assert int(out[r, c]) in (bg, color), \"connector collision with another color\"\n                out[r, c] = color\n\n    assert connected_color_count > 0, \"expected at least one color with multiple components\"\n    return out\n\n--- generate_input (599-605) ---\ndef generate_input() -> np.ndarray:\n    \"\"\"Generate a valid input grid for task f8f52ecc.\"\"\"\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n\n","exit_code":0,"status":"completed"}}
