{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/0934a4d8.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reveal the rectangular patch hidden by the solid marker using the grid's reflection symmetries.\n\n    Input structure:\n    - A square colored pattern with one solid rectangular marker color occluding a patch.\n    - The visible pattern has horizontal and vertical reflection symmetry on a large lower/right strip.\n    - The top and left outer strips also expose transpose counterparts for cells not recoverable by those reflections.\n\n    Rule:\n    - Find the unique color whose full extent is a solid rectangle; this rectangle is the output region.\n    - Infer the reflected strip start as the smallest row/column offset whose lower/right strips are mirror-consistent, ignoring marker pixels.\n    - For each marker pixel, copy the unique non-marker value in its horizontal/vertical reflection orbit; if that orbit is entirely hidden in the outer strip, use the transposed top/left-strip counterpart.\n\n    Key insight:\n    The marker is not part of the pattern; it covers a missing rectangle whose cells are still determined by the visible mirror or transpose copies elsewhere in the grid.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    marker, (r0, c0, r1, c1) = _solid_rectangle_marker(g)\n    lo = _find_reflected_strip_start(g, marker)\n\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    out = np.empty((h, w), dtype=int)\n\n    for rr in range(h):\n        for cc in range(w):\n            r = int(r0 + rr)\n            c = int(c0 + cc)\n            values = _reflection_orbit_values(g, r, c, lo, marker)\n            if values:\n                assert len(values) == 1\n                out[rr, cc] = values.pop()\n            else:\n                assert r < lo or c < lo\n                assert 0 <= c < g.shape[0] and 0 <= r < g.shape[1]\n                value = int(g[c, r])\n                assert value != marker\n                out[rr, cc] = value\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- CFG: canvas & structure ---\n_N = 30                  # grid side length (always square)\n_LO = 2                  # outer border width (rows/cols 0..lo-1 are \"free\" border)\n_HI = _N - 1             # max row/col index\n\n# --- CFG: colors ---\n_PALETTE = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)  # 8 non-marker colors\n_MARKER = 8              # marker fill color\n\n# --- CFG: marker rectangle size ---\n_MARKER_DIM_LO = 3       # min marker side length\n_MARKER_DIM_HI = 9       # max marker side length (inclusive)\n_MARKER_AREA_LO = 16     # min marker area\n_MARKER_AREA_HI = 36     # max marker area\n\n# --- CFG: generation retries ---\n_MAX_RETRIES = 300\n\n_RNG = np.random.default_rng()\n_SIZE_PAIRS = [\n    (h, w)\n    for h in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)\n    for w in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)\n    if _MARKER_AREA_LO <= h * w <= _MARKER_AREA_HI\n]\n_PLACEMENT_CACHE: dict[tuple[int, int], list[tuple[int, int, list[tuple[int, int]]]]] = {}\n\n\ndef _orbit(r: int, c: int) -> set[tuple[int, int]]:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/8a6d367c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the framed area by expanding the unique upper template that contains the existing seed pixels.\n\n    Input structure:\n    - A teal background contains small colored template masks above a larger rectangular frame.\n    - The frame encloses one fill color arranged as a partial block-scaled copy of one template.\n    - The frame interior dimensions are an integer square scale of the matching template bbox.\n\n    Rule:\n    - Crop to the rectangular frame.\n    - Identify the unique upper template whose block-scaled mask covers every existing fill pixel inside the frame.\n    - Reset the frame interior to background and paint the whole scaled mask with the fill color.\n\n    Key insight:\n    The lower colored pixels are seed cells that reveal which upper template should be completed inside the frame.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    frame_color, (r0, c0, r1, c1) = _find_frame(g, bg)\n\n    out = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n    interior = out[1:-1, 1:-1]\n    fill_colors = set(map(int, np.unique(interior))) - {bg, frame_color}\n    assert len(fill_colors) == 1, \"frame interior must contain exactly one fill color\"\n    fill_color = fill_colors.pop()\n\n    seed = interior == fill_color\n    assert np.any(seed), \"frame must contain seed pixels\"\n    ih, iw = seed.shape\n\n    matches: list[np.ndarray] = []\n    for template in _templates_above_frame(g, bg, r0):\n        th, tw = template.shape\n        if ih % th != 0 or iw % tw != 0:\n            continue\n        scale_h = ih // th\n        scale_w = iw // tw\n        if scale_h != scale_w:\n            continue\n\n        scaled = np.kron(template, np.ones((scale_h, scale_w), dtype=bool))\n        if np.all(~seed | scaled):\n            matches.append(scaled)\n\n    assert len(matches) == 1, \"seed pixels must select exactly one scaled template\"\n    completed = matches[0]\n    assert completed.shape == interior.shape\n\n    interior[:, :] = bg\n    interior[completed] = fill_color\n    return out\n\n# --------------- generator (att2) ---------------\n\nGEN_BG = 8\nGEN_GRID_SHAPE = (27, 21)\nGEN_TEMPLATE_SHAPES = [(3, 3), (3, 4), (4, 3)]\nGEN_TEMPLATE_COUNT_RANGE = (2, 6)\nGEN_TEMPLATE_ROW = 1\nGEN_TEMPLATE_LEFT_MIN = 1\nGEN_TEMPLATE_GAP = 1\nGEN_MAX_TEMPLATE_SPAN = 19\nGEN_DENSITY_MIN_NUM = 1\nGEN_DENSITY_MIN_DEN = 2\nGEN_DENSITY_MAX_NUM = 5\nGEN_DENSITY_MAX_DEN = 6\nGEN_SCALE_RANGE = (2, 5)\nGEN_SEED_COUNTS = (2, 3)\nGEN_SEED_FRACTION_RANGE = (0.20, 0.60)\nGEN_FRAME_ROW_GAP = 2\nGEN_FRAME_LEFT_MIN = 1\nGEN_ATTEMPTS = 300\nGEN_PALETTE = [0, 1, 2, 3, 4, 5, 6, 7, 9]\n\ndef _gen_has_full_bbox(mask: np.ndarray) -> bool:\n","exit_code":0,"status":"completed"}}
