{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/d93c6891.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords, bbox_h, bbox_w, find_components, neighbors4\nimport random\n\n\ndef _orientation(\n    coords: np.ndarray,\n    contacts: list[tuple[int, int, int, int]],\n) -> str:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    assert h == 1 or w == 1, \"expected each gray source to be a one-cell-thick bar\"\n\n    if h == 1 and w > 1:\n        return \"horizontal\"\n    if w == 1 and h > 1:\n        return \"vertical\"\n\n    implied: set[str] = set()\n    for tr, tc, sr, sc in contacts:\n        if tr == sr:\n            implied.add(\"horizontal\")\n        elif tc == sc:\n            implied.add(\"vertical\")\n        else:\n            raise AssertionError(\"gray source must touch orange by a 4-neighbor side\")\n    assert len(implied) == 1, \"singleton gray source has ambiguous orientation\"\n    return implied.pop()\n\n\ndef _fill_rows(\n    out: np.ndarray,\n    r0: int,\n    c0: int,\n    r1: int,\n    c1: int,\n    count: int,\n    contact_rows: set[int],\n) -> None:\n    width = int(c1 - c0 + 1)\n    height = int(r1 - r0 + 1)\n    assert count % width == 0, \"gray count must make complete orange rows\"\n    stripe_count = int(count // width)\n    assert 0 < stripe_count <= height, \"row fill must fit inside the orange rectangle\"\n\n    assert contact_rows in ({r0}, {r1}), \"horizontal bars must touch exactly one extreme row\"\n    if contact_rows == {r0}:\n        rows = list(range(r0, r0 + stripe_count))\n    else:\n        rows = list(range(r1 - stripe_count + 1, r1 + 1))\n\n    out[rows, c0 : c1 + 1] = Color.GRAY\n\n\ndef _fill_cols(\n    out: np.ndarray,\n    r0: int,\n    c0: int,\n    r1: int,\n    c1: int,\n    count: int,\n    contact_cols: set[int],\n) -> None:\n    width = int(c1 - c0 + 1)\n    height = int(r1 - r0 + 1)\n    assert count % height == 0, \"gray count must make complete orange columns\"\n    stripe_count = int(count // height)\n    assert 0 < stripe_count <= width, \"column fill must fit inside the orange rectangle\"\n\n    assert contact_cols in ({c0}, {c1}), \"vertical bars must touch exactly one extreme column\"\n    if contact_cols == {c0}:\n        cols = list(range(c0, c0 + stripe_count))\n    else:\n        cols = list(range(c1 - stripe_count + 1, c1 + 1))\n\n    out[r0 : r1 + 1, cols] = Color.GRAY\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each gray bar into its adjacent orange rectangle as full stripes from the contacted edge.\n\n    Input structure\n    - The scene uses black outside space, yellow fill, gray one-cell-thick bars, and solid orange rectangles.\n    - Each gray bar 4-touches exactly one orange rectangle; some orange rectangles have no touching gray bar.\n    - Gray bars touching the same orange rectangle all have the same orientation.\n\n    Rule\n    - Recolor every original gray cell to yellow.\n    - For each orange rectangle touched by gray bars, count the gray cells assigned to that rectangle.\n    - Horizontal gray bars repaint that many cells as complete orange rows starting from the contacted top or bottom row.\n    - Vertical gray bars repaint that many cells as complete orange columns starting from the contacted left or right column.\n    - Orange rectangles with no touching gray bar remain unchanged.\n\n    Key insight\n    - The gray pixels are not copied by shape; their count is transferred into the neighboring orange rectangle as edge-aligned row or column stripes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.YELLOW, Color.GRAY, Color.ORANGE}\n\n    orange = find_components(g, bg=Color.YELLOW, colors=[Color.ORANGE], connectivity=4)\n    gray = find_components(g, bg=Color.YELLOW, colors=[Color.GRAY], connectivity=4)\n    assert orange and gray, \"expected orange rectangles and gray source bars\"\n\n    orange_index: dict[tuple[int, int], int] = {}\n    orange_bboxes: list[tuple[int, int, int, int]] = []\n    for i, obj in enumerate(orange):\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        assert obj[\"area\"] == bbox_h(obj[\"bbox\"]) * bbox_w(obj[\"bbox\"])\n        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == Color.ORANGE)\n        orange_bboxes.append((int(r0), int(c0), int(r1), int(c1)))\n        for r, c in obj[\"coords\"]:\n            orange_index[(int(r), int(c))] = i\n\n    source_by_target: dict[int, list[tuple[dict, list[tuple[int, int, int, int]]]]] = {}\n    for src in gray:\n        touched: dict[int, list[tuple[int, int, int, int]]] = {}\n        for sr_raw, sc_raw in src[\"coords\"]:\n            sr = int(sr_raw)\n            sc = int(sc_raw)\n            for tr, tc in neighbors4(sr, sc):\n                target_i = orange_index.get((int(tr), int(tc)))\n                if target_i is not None:\n                    touched.setdefault(target_i, []).append((int(tr), int(tc), sr, sc))\n\n        assert len(touched) == 1, \"each gray bar must touch exactly one orange rectangle\"\n        target_i = next(iter(touched))\n        source_by_target.setdefault(target_i, []).append((src, touched[target_i]))\n\n    out = g.copy()\n    out[g == Color.GRAY] = Color.YELLOW\n\n    for target_i, sources in source_by_target.items():\n        r0, c0, r1, c1 = orange_bboxes[target_i]\n        orientations = {_orientation(src[\"coords\"], contacts) for src, contacts in sources}\n        assert len(orientations) == 1, \"all gray bars for one orange rectangle must share orientation\"\n        count = sum(int(src[\"area\"]) for src, _contacts in sources)\n        contacts = [contact for _src, src_contacts in sources for contact in src_contacts]\n\n        if orientations == {\"horizontal\"}:\n            contact_rows = {tr for tr, _tc, _sr, _sc in contacts}\n            assert contact_rows <= {r0, r1}\n            _fill_rows(out, r0, c0, r1, c1, count, contact_rows)\n        else:\n            assert orientations == {\"vertical\"}\n            contact_cols = {tc for _tr, tc, _sr, _sc in contacts}\n            assert contact_cols <= {c0, c1}\n            _fill_cols(out, r0, c0, r1, c1, count, contact_cols)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGRID_H_RANGE, GRID_W_RANGE = (10, 18), (14, 18)\nCONTENT_H_RANGE, CONTENT_W_RANGE = (6, 13), (12, 15)\nBORDER_RANGE = (0, 4)\n\nEDGES, HORIZONTAL_EDGES = (\"top\", \"bottom\", \"left\", \"right\"), (\"top\", \"bottom\")\nORANGE_COUNT_CHOICES, ORANGE_COUNT_WEIGHTS = [1, 2, 3, 4], [1, 2, 3, 4]\nORANGE_H_RANGE, ORANGE_W_RANGE = (1, 5), (2, 6)\nORANGE_AREA_RANGE = (4, 12)\nORANGE_PLACE_RETRIES = 80\n\nMAX_UNTOUCHED_ORANGES = 1\nBARS_PER_ORANGE_RANGE, TOTAL_BARS_RANGE = (1, 2), (2, 6)\nBAR_LENGTH_RANGE = (1, 7)\nBAR_COUNT_RETRIES = 50\n\nGENERATE_RETRIES = 300\n\n\ndef _place_orange(edge, cr0, cc0, cr1, cc1, occupied):\n    \"\"\"Try to place an orange rect flush against the given edge. Returns (or0,oc0,or1,oc1) or None.\"\"\"\n    for _ in range(ORANGE_PLACE_RETRIES):\n        oh = random.randint(*ORANGE_H_RANGE)\n        ow = random.randint(*ORANGE_W_RANGE)\n        if not (ORANGE_AREA_RANGE[0] <= oh * ow <= ORANGE_AREA_RANGE[1]):\n            continue\n        if edge in HORIZONTAL_EDGES:\n            or0 = cr0 if edge == 'top' else cr1 - oh + 1\n            or1 = or0 + oh - 1\n            lo, hi = cc0 + 1, cc1 - ow  # avoid touching perpendicular edges\n        else:\n            oc0 = cc0 if edge == 'left' else cc1 - ow + 1\n            oc1 = oc0 + ow - 1\n            lo, hi = cr0 + 1, cr1 - oh  # avoid touching perpendicular edges\n        if hi < lo:\n            continue\n        v = random.randint(lo, hi)\n        if edge in HORIZONTAL_EDGES:\n            oc0, oc1 = v, v + ow - 1\n        else:\n            or0, or1 = v, v + oh - 1\n        if or0 < cr0 or or1 > cr1 or oc0 < cc0 or oc1 > cc1:\n            continue\n        if occupied[or0:or1+1, oc0:oc1+1].any():\n            continue\n        return (or0, oc0, or1, oc1)\n    return None\n\n\ndef _make_canvas() -> tuple[np.ndarray, tuple[int, int, int, int]] | None:\n    content_h = random.randint(*CONTENT_H_RANGE)\n    content_w = random.randint(*CONTENT_W_RANGE)\n    border_top = random.randint(*BORDER_RANGE)\n    border_bottom = random.randint(*BORDER_RANGE)\n    border_left = random.randint(*BORDER_RANGE)\n    border_right = random.randint(*BORDER_RANGE)\n    grid_h = content_h + border_top + border_bottom\n    grid_w = content_w + border_left + border_right\n    if not (GRID_H_RANGE[0] <= grid_h <= GRID_H_RANGE[1] and GRID_W_RANGE[0] <= grid_w <= GRID_W_RANGE[1]):\n        return None\n\n    grid = np.full((grid_h, grid_w), Color.BLACK, dtype=int)\n    cr0, cc0 = border_top, border_left\n    cr1, cc1 = cr0 + content_h - 1, cc0 + content_w - 1\n    grid[cr0:cr1+1, cc0:cc1+1] = Color.YELLOW\n    return grid, (cr0, cc0, cr1, cc1)\n\n\ndef _place_oranges(content_box, occupied) -> list[tuple[str, int, int, int, int]] | None:\n    cr0, cc0, cr1, cc1 = content_box\n    num_orange = random.choices(ORANGE_COUNT_CHOICES, weights=ORANGE_COUNT_WEIGHTS)[0]\n    edges = random.sample(EDGES, num_orange)\n    orange_rects = []\n    for edge in edges:\n        result = _place_orange(edge, cr0, cc0, cr1, cc1, occupied)\n        if result is None:\n            return None\n        or0, oc0, or1, oc1 = result\n        occupied[or0:or1+1, oc0:oc1+1] = True\n        orange_rects.append((edge, or0, oc0, or1, oc1))\n    return orange_rects\n\n\ndef _choose_touched_oranges(num_orange):\n    max_untouched = min(MAX_UNTOUCHED_ORANGES, num_orange - 1)\n    num_untouched = random.randint(0, max_untouched) if num_orange > 1 else 0\n    indices = list(range(num_orange))\n    random.shuffle(indices)\n    untouched_set = set(indices[:num_untouched])\n    return [i for i in range(num_orange) if i not in untouched_set]\n\n\ndef _choose_bars_per_orange(touched_list):\n    for _ in range(BAR_COUNT_RETRIES):\n        bpo = [random.randint(*BARS_PER_ORANGE_RANGE) for _ in touched_list]\n        if TOTAL_BARS_RANGE[0] <= sum(bpo) <= TOTAL_BARS_RANGE[1]:\n            return bpo\n    return None\n\n\ndef _split_bar_lengths(total_gray, n_bars):\n    min_len, max_len = BAR_LENGTH_RANGE\n    if n_bars == 2 and total_gray >= 2:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/f1bcbc2c.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/f1bcbc2c.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\nfrom scipy.ndimage import binary_dilation\n\nimport random\n\nfrom arc_utils import (\n    Color,\n    STRUCT8,\n    colors_present,\n    components_mask,\n    get_bg,\n    in_bounds,\n    label_mask,\n    neighbors4,\n)\n\n\ndef _path_color(g: np.ndarray, bg: int) -> int:\n    candidates = []\n    for color in colors_present(g, exclude={bg}):\n        comps = components_mask(g == color, connectivity=4)\n        if len(comps) == 2:\n            candidates.append(int(color))\n\n    assert len(candidates) == 1, \"expected exactly one color forming two path components\"\n    return candidates[0]\n\n\ndef _adjacent_path_labels(labels: np.ndarray, r: int, c: int) -> set[int]:\n    adjacent = set()\n    for rr, cc in neighbors4(r, c):\n        if in_bounds(labels.shape, rr, cc) and labels[rr, cc] > 0:\n            adjacent.add(int(labels[rr, cc]))\n    return adjacent\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Paint the top-connected middle channel between two orange path components teal.\n\n    Input structure\n    - The background is black.\n    - One foreground color forms exactly two 4-connected one-pixel-wide path components.\n    - Optional non-background control pixels may sit in the channel between the two paths.\n\n    Rule\n    - Dilate each path component by one cell in the 8-neighborhood and intersect the two dilations; this gives the one-cell-wide middle channel.\n    - A control pixel in that channel is a blocker only when its 4-neighbors touch fewer than both path components; otherwise it is part of the channel and is repainted.\n    - After removing blockers, paint the channel component connected to the top edge teal and keep all other pixels unchanged.\n\n    Key insight\n    - The desired pixels are not found by region filling; they are the geometric overlap of the two paths' one-cell halos, with weakly attached control pixels splitting the channel.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    bg = get_bg(g)\n    assert bg == Color.BLACK, \"expected black background\"\n\n    path_color = _path_color(g, bg)\n    path_labels, n_paths = label_mask(g == path_color, connectivity=4)\n    assert n_paths == 2, \"expected two path components\"\n\n    channel = g != path_color\n    for label_id in range(1, n_paths + 1):\n        channel &= binary_dilation(path_labels == label_id, structure=STRUCT8)\n    assert np.any(channel), \"expected a middle channel between the paths\"\n\n    blocked = []\n    for r_raw, c_raw in np.argwhere(channel & (g != bg)):\n        r = int(r_raw)\n        c = int(c_raw)\n        adjacent = _adjacent_path_labels(path_labels, r, c)\n        assert adjacent, \"control pixel in channel must touch a path component\"\n        if len(adjacent) < n_paths:\n            blocked.append((r, c))\n        else:\n            assert len(adjacent) == n_paths, \"channel control pixel cannot touch extra path labels\"\n\n    passable = channel.copy()\n    for r, c in blocked:\n        passable[r, c] = False\n\n    channel_labels, n_channels = label_mask(passable, connectivity=4)\n    assert n_channels >= 1, \"expected at least one passable channel component\"\n    top_components = [\n        label_id for label_id in range(1, n_channels + 1) if np.any(channel_labels[0, :] == label_id)\n    ]\n    assert len(top_components) == 1, \"expected exactly one channel component connected to the top edge\"\n\n    paint = channel_labels == top_components[0]\n    assert np.any(paint), \"expected cells to paint\"\n    out = g.copy()\n    out[paint] = Color.TEAL\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and channel bounds.\nGEN_GRID_SHAPE = (10, 10)\nGEN_TOP_ROW = 0\nGEN_BOTTOM_ROW = 9\nGEN_LEFT_COL = 0\nGEN_RIGHT_COL = 9\nGEN_MIN_CHANNEL_COL = 1\nGEN_MAX_CHANNEL_COL = 8\n\n# Segment and turn sampling.\nGEN_MIN_TURNS = 2\nGEN_MAX_TURNS = 4\nGEN_VERTICAL_MIN = 2\nGEN_VERTICAL_MAX = 7\nGEN_VERTICAL_TOTAL_MIN = 6\nGEN_VERTICAL_TOTAL_MAX = 9\nGEN_FULL_HEIGHT_TOTAL = 9\nGEN_FULL_HEIGHT_PROB = 0.8\nGEN_HORIZONTAL_MIN = 2\nGEN_HORIZONTAL_MAX = 4\nGEN_HORIZONTAL_BUDGET = 7\n\n# Optional blocker placement.\nGEN_BLOCKER_PROB = 0.6\nGEN_BLOCKING_BLOCKER_PROB = 0.55\n\n# Retry budget for rejected geometry.\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_walk_segment(path, dr, dc, steps):\n    r, c = path[-1]\n    for _ in range(steps):\n        r += dr\n        c += dc\n        path.append((r, c))\n\n\ndef _gen_directions(hdir, turns):\n    directions = [(1, 0)]\n    for i in range(turns):\n        directions.append((0, hdir) if i % 2 == 0 else (1, 0))\n    return directions\n\n\ndef _gen_partition_total(total, count, minimum, maximum):\n    \"\"\"Randomly split total into count bounded positive steps.\"\"\"\n    steps = []\n    remaining = total\n    for i in range(count - 1):\n        rest = count - i - 1\n        hi = min(maximum, remaining - minimum * rest)\n        lo = max(minimum, remaining - maximum * rest)\n        val = random.randint(lo, hi)\n        steps.append(val)\n        remaining -= val\n    steps.append(remaining)\n    return steps\n\n\ndef _gen_vertical_steps(directions):\n    v_count = sum(1 for d in directions if d == (1, 0))\n    if directions[-1] == (1, 0) and random.random() < GEN_FULL_HEIGHT_PROB:\n        total = GEN_FULL_HEIGHT_TOTAL\n    else:\n        total = random.randint(GEN_VERTICAL_TOTAL_MIN, GEN_VERTICAL_TOTAL_MAX)\n    return _gen_partition_total(total, v_count, GEN_VERTICAL_MIN, GEN_VERTICAL_MAX)\n\n\ndef _gen_horizontal_steps(h_count):\n    steps = []\n    remaining = GEN_HORIZONTAL_BUDGET\n    for i in range(h_count):\n        hi = min(GEN_HORIZONTAL_MAX, remaining - GEN_HORIZONTAL_MIN * (h_count - i - 1))\n        step = random.randint(GEN_HORIZONTAL_MIN, hi)\n        steps.append(step)\n        remaining -= step\n    return steps\n\n\ndef _gen_start_col(hdir, h_steps):\n    total_h = sum(h_steps)\n    if hdir == 1:\n        return random.randint(GEN_MIN_CHANNEL_COL, GEN_MAX_CHANNEL_COL - total_h)\n    return random.randint(GEN_MIN_CHANNEL_COL + total_h, GEN_MAX_CHANNEL_COL)\n\n\ndef _gen_channel_path():\n    hdir = random.choice([-1, 1])\n    turns = random.randint(GEN_MIN_TURNS, GEN_MAX_TURNS)\n    directions = _gen_directions(hdir, turns)\n    v_steps = _gen_vertical_steps(directions)\n    h_steps = _gen_horizontal_steps(sum(1 for d in directions if d[0] == 0))\n    start_c = _gen_start_col(hdir, h_steps)\n\n    path = [(GEN_TOP_ROW, start_c)]\n    vi = 0\n    hi = 0\n    for dr, dc in directions:\n        if dr:\n            steps = v_steps[vi]\n            vi += 1\n        else:\n            steps = h_steps[hi]\n            hi += 1\n        _gen_walk_segment(path, dr, dc, steps)\n\n    if any(\n        r < GEN_TOP_ROW or r > GEN_BOTTOM_ROW or c < GEN_MIN_CHANNEL_COL or c > GEN_MAX_CHANNEL_COL\n        for r, c in path\n    ):\n        return None\n    return path\n\n\ndef _gen_left_normal(dr, dc):\n    return -dc, dr\n\n\ndef _gen_wall_sets(path):\n    left = set()\n    right = set()\n    channel = set(path)\n    for i, (r, c) in enumerate(path):\n        dirs = []\n        if i > 0:\n            pr, pc = path[i - 1]\n            dirs.append((r - pr, c - pc))\n        if i + 1 < len(path):\n            nr, nc = path[i + 1]\n            dirs.append((nr - r, nc - c))\n        for dr, dc in dirs:\n            lr, lc = _gen_left_normal(dr, dc)\n            if (r + lr, c + lc) not in channel:\n                left.add((r + lr, c + lc))\n            if (r - lr, c - lc) not in channel:\n                right.add((r - lr, c - lc))\n        if len(dirs) == 2 and dirs[0] != dirs[1]:\n            for side in (1, -1):\n                offsets = []\n                for dr, dc in dirs:\n                    lr, lc = _gen_left_normal(dr, dc)\n                    offsets.append((side * lr, side * lc))\n                direct = [(r + dr, c + dc) for dr, dc in offsets]\n                if all(cell not in channel for cell in direct):\n                    er = r + offsets[0][0] + offsets[1][0]\n                    ec = c + offsets[0][1] + offsets[1][1]\n                    if side == 1:\n                        left.add((er, ec))\n                    else:\n                        right.add((er, ec))\n    return left, right\n\n\ndef _gen_mask_from_cells(cells):\n    mask = np.zeros(GEN_GRID_SHAPE, dtype=bool)\n    cells = list(cells)\n    if cells:\n        rows, cols = zip(*cells)\n        mask[rows, cols] = True\n    return mask\n","exit_code":0,"status":"completed"}}
