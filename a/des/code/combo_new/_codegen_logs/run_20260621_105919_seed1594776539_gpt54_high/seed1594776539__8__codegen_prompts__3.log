{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/b1986d4b.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Render the filled-square object counts as compact nested stacks ordered by count rank.\n\n    Input structure\n    A large noisy grid has a dominant background, scattered non-square noise, and\n    filled monochrome square objects. Each square side length has exactly one\n    object color, and side lengths form consecutive sizes.\n\n    Rule\n    Ignore non-square components. If the lowest square in the scene is of the\n    smallest side length, treat that one smallest square as a distractor and do\n    not count it. For count rank k from left to right, create one block from all\n    square sizes with at least k remaining objects; draw larger squares first and\n    smaller squares over their upper-left corner, then append one background\n    separator column.\n\n    Key insight\n    The output is a count histogram of square side lengths, but each histogram\n    slot is rendered as nested upper-left square masks using the side colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    objects = _square_objects(g, bg)\n    assert objects, \"expected filled square objects\"\n\n    sides = sorted({obj[\"side\"] for obj in objects})\n    assert sides == list(range(sides[0], sides[-1] + 1)), \"expected consecutive square side lengths\"\n\n    by_side = {side: [obj for obj in objects if obj[\"side\"] == side] for side in sides}\n    colors = {}\n    for side, side_objects in by_side.items():\n        side_colors = {obj[\"color\"] for obj in side_objects}\n        assert len(side_colors) == 1, \"each side length should have one color\"\n        colors[side] = side_colors.pop()\n\n    smallest = sides[0]\n    lowest_row = max(obj[\"bbox\"][2] for obj in objects)\n    lowest_smallest = [obj for obj in by_side[smallest] if obj[\"bbox\"][2] == lowest_row]\n    if lowest_smallest:\n        assert len(lowest_smallest) == 1, \"expected at most one lowest smallest distractor\"\n        drop_bbox = lowest_smallest[0][\"bbox\"]\n        by_side[smallest] = [obj for obj in by_side[smallest] if obj[\"bbox\"] != drop_bbox]\n\n    counts = {side: len(side_objects) for side, side_objects in by_side.items()}\n    assert all(count > 0 for count in counts.values()), \"each square size should remain represented\"\n\n    out_h = sides[-1] + 1\n    groups = []\n    for rank in range(max(counts.values())):\n        present_sides = [side for side in sides if counts[side] > rank]\n        assert present_sides, \"rank should contain at least one square size\"\n\n        group_w = max(present_sides)\n        group = np.full((out_h, group_w), bg, dtype=int)\n        for side in sorted(present_sides, reverse=True):\n            group[:side, :side] = colors[side]\n        groups.append(group)\n\n    out_w = sum(group.shape[1] + 1 for group in groups)\n    out = np.full((out_h, out_w), bg, dtype=int)\n    c = 0\n    for group in groups:\n        w = group.shape[1]\n        out[:, c : c + w] = group\n        c += w + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nSIDES = [2, 3, 4]\nALL_COLORS = list(range(10))\n\n# Canvas and object bounds.\nGRID_SIZE_RANGE = (25, 28)\nCOUNT_RANGE = (2, 6)\nSQUARE_GAP = 1\n\n# Noise and distractor controls.\nDISTRACTOR_PROB = 0.5\nNOISE_COUNT_RANGE = (40, 70)\n\n# Retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _choose_palette() -> tuple[int, dict[int, int], int]:\n    \"\"\"Choose one background, three square colors, and one noise color.\"\"\"\n    bg = random.choice(ALL_COLORS)\n    non_bg = [c for c in ALL_COLORS if c != bg]\n    random.shuffle(non_bg)\n    square_colors = {side: non_bg[i] for i, side in enumerate(SIDES)}\n    return bg, square_colors, non_bg[len(SIDES)]\n\n\ndef _make_square_queue(\n    counts: dict[int, int], square_colors: dict[int, int], has_distractor: bool\n) -> tuple[list[tuple[int, int]], tuple[int, int] | None]:\n    \"\"\"Return regular squares plus the separately placed distractor candidate.\"\"\"\n    squares = [(side, square_colors[side]) for side in SIDES for _ in range(counts[side])]\n    if has_distractor:\n        squares.append((SIDES[0], square_colors[SIDES[0]]))\n\n    random.shuffle(squares)\n    if not has_distractor:\n        return squares, None\n    return squares[:-1], squares[-1]\n\n\ndef _free_positions(occupied: np.ndarray, side: int, min_r: int = 0) -> list[tuple[int, int]]:\n    \"\"\"List top-left positions whose padded square footprint is unoccupied.\"\"\"\n    H, W = occupied.shape\n    valid = []\n    for r in range(min_r, H - side + 1):\n        for c in range(0, W - side + 1):\n            r0 = max(0, r - SQUARE_GAP)\n            r1 = min(H, r + side + SQUARE_GAP)\n            c0 = max(0, c - SQUARE_GAP)\n            c1 = min(W, c + side + SQUARE_GAP)\n            if not occupied[r0:r1, c0:c1].any():\n                valid.append((r, c))\n    return valid\n\n\ndef _mark_occupied(occupied: np.ndarray, r: int, c: int, side: int) -> None:\n    H, W = occupied.shape\n    r0 = max(0, r - SQUARE_GAP)\n    r1 = min(H, r + side + SQUARE_GAP)\n    c0 = max(0, c - SQUARE_GAP)\n    c1 = min(W, c + side + SQUARE_GAP)\n    occupied[r0:r1, c0:c1] = True\n\n\ndef _place_square(\n    grid: np.ndarray,\n    occupied: np.ndarray,\n    placed: list[tuple[int, int, int, int]],\n    side: int,\n    color: int,\n    positions: list[tuple[int, int]] | None = None,\n) -> bool:\n    \"\"\"Place one square at a random valid position and update grid state.\"\"\"\n    valid = _free_positions(occupied, side) if positions is None else positions\n    if not valid:\n        return False\n    r, c = random.choice(valid)\n    grid[r:r + side, c:c + side] = color\n    _mark_occupied(occupied, r, c, side)\n    placed.append((r, c, side, color))\n    return True\n\n\ndef _place_squares(\n    grid: np.ndarray,\n    occupied: np.ndarray,\n    regular_squares: list[tuple[int, int]],\n    distractor_sq: tuple[int, int] | None,\n) -> list[tuple[int, int, int, int]] | None:\n    \"\"\"Place all squares, requiring any distractor to sit below the others.\"\"\"\n    placed = []\n\n    random.shuffle(regular_squares)\n    for side, color in regular_squares:\n        if not _place_square(grid, occupied, placed, side, color):\n            return None\n\n    if distractor_sq is None:\n        return placed\n\n    d_side, d_color = distractor_sq\n    current_max_bottom = max(r + side - 1 for r, _, side, _ in placed) if placed else -1\n    min_r = max(0, current_max_bottom - d_side + 2)\n    valid = [\n        (r, c)\n        for r, c in _free_positions(occupied, d_side, min_r=min_r)\n        if r + d_side - 1 > current_max_bottom\n    ]\n    if not _place_square(grid, occupied, placed, d_side, d_color, valid):\n        return None\n    return placed\n\n\ndef _add_noise(grid: np.ndarray, bg: int, noise_color: int) -> bool:\n    \"\"\"Scatter noise onto background cells only.\"\"\"\n    free_cells = list(zip(*np.where(grid == bg)))\n    num_noise = random.randint(*NOISE_COUNT_RANGE)\n    if len(free_cells) < num_noise:\n        return False\n    random.shuffle(free_cells)\n    for r, c in free_cells[:num_noise]:\n        grid[r, c] = noise_color\n    return True\n\n\ndef _would_trigger_unintended_distractor(placed: list[tuple[int, int, int, int]]) -> bool:\n    \"\"\"Detect no-distractor samples where the solver would drop a small square.\"\"\"\n    lowest_row = max(r + side - 1 for r, _, side, _ in placed)\n    return any(side == SIDES[0] and r + side - 1 == lowest_row for r, _, side, _ in placed)\n\n\ndef _render_expected_output(\n    bg: int, counts: dict[int, int], square_colors: dict[int, int]\n) -> np.ndarray:\n    \"\"\"Render the count-derived oracle output used to validate samples.\"\"\"\n    out_h = SIDES[-1] + 1\n    groups = []\n    for rank in range(max(counts.values())):\n        present_sides = [side for side in SIDES if counts[side] > rank]\n        group = np.full((out_h, max(present_sides)), bg, dtype=int)\n        for side in sorted(present_sides, reverse=True):\n            group[:side, :side] = square_colors[side]\n        groups.append(group)\n\n    out_w = sum(group.shape[1] + 1 for group in groups)\n    out = np.full((out_h, out_w), bg, dtype=int)\n    c = 0\n    for group in groups:\n        w = group.shape[1]\n        out[:, c:c + w] = group\n        c += w + 1\n    return out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg, square_colors, noise_color = _choose_palette()\n    counts = {side: random.randint(*COUNT_RANGE) for side in SIDES}\n    has_distractor = random.random() < DISTRACTOR_PROB\n    regular_squares, distractor_sq = _make_square_queue(counts, square_colors, has_distractor)\n\n    H = random.randint(*GRID_SIZE_RANGE)\n    W = random.randint(*GRID_SIZE_RANGE)\n    grid = np.full((H, W), bg, dtype=int)\n    occupied = np.zeros((H, W), dtype=bool)\n\n    placed = _place_squares(grid, occupied, regular_squares, distractor_sq)\n    if placed is None or not _add_noise(grid, bg, noise_color):\n        return None\n\n    if not has_distractor and _would_trigger_unintended_distractor(placed):\n        return None\n\n    expected_out = _render_expected_output(bg, counts, square_colors)\n\n    try:\n        actual_out = main(grid)\n    except Exception:\n        return None\n\n    if not np.array_equal(actual_out, expected_out):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/22208ba4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the repeated boundary color's rectangles one block inward while leaving singleton boundary rectangles in place.\n\n    Input structure:\n    - The background is the most common color.\n    - Foreground objects are solid monochrome rectangles touching a grid corner.\n    - Exactly one foreground color appears as multiple separate 4-connected objects; other colors appear once.\n\n    Rule:\n    - Clear the multiple objects of the repeated color from their original positions.\n    - For each cleared rectangle, translate it away from the row and column border it touches by exactly its height and width.\n    - Keep singleton-color objects unchanged; overlapping translated rectangles of the same color merge.\n\n    Key insight:\n    - Multiplicity selects the moving color, and each boundary rectangle's touched edges determine its inward diagonal translation.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    by_color: dict[int, list[dict]] = defaultdict(list)\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        by_color[int(comp[\"color\"])].append(comp)\n\n    moving_colors = [color for color, comps in by_color.items() if len(comps) > 1]\n    assert len(moving_colors) == 1\n    moving_color = int(moving_colors[0])\n    moving_objects = by_color[moving_color]\n\n    out = g.copy()\n    for comp in moving_objects:\n        coords = comp[\"coords\"]\n        out[coords[:, 0], coords[:, 1]] = bg\n\n    for comp in moving_objects:\n        coords = comp[\"coords\"]\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        height = int(r1 - r0 + 1)\n        width = int(c1 - c0 + 1)\n        assert int(comp[\"area\"]) == height * width\n\n        touches_top = r0 == 0\n        touches_bottom = r1 == H - 1\n        touches_left = c0 == 0\n        touches_right = c1 == W - 1\n        assert touches_top != touches_bottom\n        assert touches_left != touches_right\n\n        dr = height if touches_top else -height\n        dc = width if touches_left else -width\n        shifted = coords + np.array([dr, dc], dtype=int)\n        assert bool(\n            np.all(\n                (0 <= shifted[:, 0])\n                & (shifted[:, 0] < H)\n                & (0 <= shifted[:, 1])\n                & (shifted[:, 1] < W)\n            )\n        )\n\n        target = out[shifted[:, 0], shifted[:, 1]]\n        assert bool(np.all((target == bg) | (target == moving_color)))\n        out[shifted[:, 0], shifted[:, 1]] = moving_color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Corner and movement model.\nCORNERS = (\"TL\", \"TR\", \"BL\", \"BR\")\nDIAGONAL_PAIRS = ({\"TL\", \"BR\"}, {\"TR\", \"BL\"})\nINWARD_STEP_FACTOR = 2\nCOMPACT_CANVAS_FACTOR = 3\n\n# Canvas, object count, and retry bounds.\nGRID_ROW_BOUNDS = (7, 22)\nGRID_COL_BOUNDS = (7, 30)\nSQUARE_SIZE_BOUNDS = (1, 4)\nMOVING_COUNT_BOUNDS = (2, 4)\nGENERATION_RETRIES = 300\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\ndef _corner_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:\n    row = 0 if corner[0] == \"T\" else H - s\n    col = 0 if corner[1] == \"L\" else W - s\n    return row, col\n\n\ndef _shifted_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:\n    row = s if corner[0] == \"T\" else H - INWARD_STEP_FACTOR * s\n    col = s if corner[1] == \"L\" else W - INWARD_STEP_FACTOR * s\n    return row, col\n\n\ndef _valid_sizes(s: int, moving_count: int) -> list[tuple[int, int]]:\n    sizes = []\n    min_h = max(GRID_ROW_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)\n    min_w = max(GRID_COL_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)\n    for H in range(min_h, GRID_ROW_BOUNDS[1] + 1):\n        for W in range(min_w, GRID_COL_BOUNDS[1] + 1):\n            bg_area = H * W - len(CORNERS) * s * s\n            if bg_area <= moving_count * s * s:\n                continue\n            compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s\n            if moving_count == MOVING_COUNT_BOUNDS[1] - 1 and compact:\n                continue\n            sizes.append((H, W))\n    return sizes\n\n\ndef _pick_moving_corners(H: int, W: int, s: int, moving_count: int) -> set[str]:\n    if moving_count == len(CORNERS):\n        return set(CORNERS)\n    compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s\n    if moving_count == MOVING_COUNT_BOUNDS[0] and compact:\n        return set(random.choice(DIAGONAL_PAIRS))\n    return set(random.sample(CORNERS, moving_count))\n\n\ndef _overlaps(a: tuple[int, int], b: tuple[int, int], s: int) -> bool:\n    ar, ac = a\n    br, bc = b\n    return ar < br + s and br < ar + s and ac < bc + s and bc < ac + s\n\n\ndef _sample_layout():\n    \"\"\"Return a collision-free layout tuple, or None when the sampled size cannot work.\"\"\"\n    s = random.randint(*SQUARE_SIZE_BOUNDS)\n    moving_count = random.randint(*MOVING_COUNT_BOUNDS)\n    sizes = _valid_sizes(s, moving_count)\n    if not sizes:\n        return None\n    H, W = random.choice(sizes)\n\n    moving = _pick_moving_corners(H, W, s, moving_count)\n    singletons = [corner for corner in CORNERS if corner not in moving]\n\n    shifted = {corner: _shifted_pos(corner, H, W, s) for corner in moving}\n    singleton_pos = {corner: _corner_pos(corner, H, W, s) for corner in singletons}\n    for moved_pos in shifted.values():\n        for kept_pos in singleton_pos.values():\n            if _overlaps(moved_pos, kept_pos, s):\n                return None\n    return H, W, s, moving, singletons, shifted, singleton_pos\n\n\ndef _sample_colors(singleton_count: int) -> tuple[int, int, list[int]]:\n    colors = list(COLOR_VALUES)\n    bg = random.choice(colors)\n    colors.remove(bg)\n    moving_color = random.choice(colors)\n    colors.remove(moving_color)\n    singleton_colors = random.sample(colors, singleton_count)\n    return bg, moving_color, singleton_colors\n\n\ndef _render_pair(H, W, s, bg, moving_color, moving, singletons, shifted, singleton_pos, singleton_colors):\n    \"\"\"Render the matching input/output grids for an accepted layout and palette.\"\"\"\n    rect = np.full((s, s), moving_color, dtype=int)\n    out = np.full((H, W), bg, dtype=int)\n    for corner in moving:\n        paste(out, rect, *shifted[corner])\n    for corner, color in zip(singletons, singleton_colors):\n        patch = np.full((s, s), color, dtype=int)\n        paste(out, patch, *singleton_pos[corner])\n\n    inp = out.copy()\n    for corner in moving:\n        r, c = shifted[corner]\n        inp[r : r + s, c : c + s] = bg\n    for corner in moving:\n        paste(inp, rect, *_corner_pos(corner, H, W, s))\n    return inp, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    layout = _sample_layout()\n    if layout is None:\n        return None\n    H, W, s, moving, singletons, shifted, singleton_pos = layout\n    bg, moving_color, singleton_colors = _sample_colors(len(singletons))\n    inp, out = _render_pair(H, W, s, bg, moving_color, moving, singletons, shifted, singleton_pos, singleton_colors)\n    try:\n        return inp if np.array_equal(main(inp), out) else None\n    except AssertionError:\n        return None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
