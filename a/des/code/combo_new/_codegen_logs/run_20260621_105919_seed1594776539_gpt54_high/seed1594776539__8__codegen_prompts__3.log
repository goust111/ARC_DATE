{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Convert scattered foreground objects into bottom-aligned count bars in a fixed five-color order.\n\n    Input structure\n    The grid has a dominant background color and foreground objects in the task\n    palette: grey, red, teal, maroon, and pink. Objects are monochromatic\n    8-connected components; some palette colors may be absent.\n\n    Rule\n    For each palette color in order grey, red, teal, maroon, pink, count its\n    8-connected objects. Create a background grid with five columns and height\n    equal to the largest count, then fill each column upward from the bottom\n    with its palette color for that count.\n\n    Key insight\n    The output does not preserve object shapes or positions; it is a histogram\n    of per-color 8-connected object counts, using the learned palette order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    palette_set = set(PALETTE_ORDER)\n    assert bg not in palette_set, \"background must not be a histogram color\"\n    assert set(map(int, g.ravel())) <= palette_set | {bg}\n\n    object_counts = [len(components_mask(g == color, connectivity=8)) for color in PALETTE_ORDER]\n    max_count = max(object_counts)\n    assert max_count > 0, \"expected at least one foreground object\"\n\n    out = np.full((max_count, len(PALETTE_ORDER)), bg, dtype=int)\n    for c, (color, count) in enumerate(zip(PALETTE_ORDER, object_counts)):\n        if count:\n            out[-count:, c] = color\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and palette.\nGRID_SHAPE = (10, 10)\nBACKGROUND_COLOR = Color.ORANGE\nN_COLORS = len(PALETTE_ORDER)\n\n# Histogram count sampling.\nNONZERO_COLOR_RANGE = (3, 6)\nMAX_COUNT_RANGE = (2, 7)\nTOTAL_OBJECT_RANGE = (4, 12)\n\n# Blob shape sampling.\nN_BLOB_SHAPES = 6\nLINE_LENGTH_RANGE = (2, 5)\nSMALL_DIM_RANGE = (2, 4)\nGROWN_BLOB_MIN_SIZE = 3\nPLUS_SHAPE_SIZE = 3\n\n# Placement and retry limits.\nSAME_COLOR_MIN_CHEBYSHEV = 2\nBLOB_PLACE_TRIES = 100\nGENERATION_TRIES = 300\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Generate one candidate grid, returning None when placement or validation fails.\"\"\"\n    rng = np.random.default_rng()\n    counts = _sample_counts(rng)\n    if counts is None:\n        return None\n\n    grid = np.full(GRID_SHAPE, BACKGROUND_COLOR, dtype=int)\n    if not _place_all_blobs(grid, counts, rng):\n        return None\n    if not _counts_match_grid(grid, counts):\n        return None\n    if not _solver_matches_expected(grid, counts):\n        return None\n    return grid\n\n\ndef _sample_counts(rng) -> list[int] | None:\n    \"\"\"Sample per-color component counts matching the output histogram contract.\"\"\"\n    n_nonzero = int(rng.integers(*NONZERO_COLOR_RANGE))\n    max_count = int(rng.integers(*MAX_COUNT_RANGE))\n\n    counts = [0] * N_COLORS\n    nonzero_indices = list(rng.choice(N_COLORS, size=n_nonzero, replace=False))\n    max_idx = rng.choice(nonzero_indices)\n    counts[max_idx] = max_count\n\n    remaining_budget = TOTAL_OBJECT_RANGE[1] - max_count\n    for idx in [i for i in nonzero_indices if i != max_idx]:\n        upper = min(max_count, remaining_budget)\n        if upper < 1:\n            counts[idx] = 1\n            remaining_budget -= 1\n        else:\n            counts[idx] = int(rng.integers(1, upper + 1))\n            remaining_budget -= counts[idx]\n\n    total = sum(counts)\n    if total < TOTAL_OBJECT_RANGE[0] or total > TOTAL_OBJECT_RANGE[1]:\n        return None\n    return counts\n\n\ndef _place_all_blobs(grid: np.ndarray, counts: list[int], rng) -> bool:\n    \"\"\"Place each color's requested number of same-color-separated blobs.\"\"\"\n    for color_idx, count in enumerate(counts):\n        if count == 0:\n            continue\n        if not _place_color_blobs(grid, PALETTE_ORDER[color_idx], count, rng):\n            return False\n    return True\n\n\ndef _place_color_blobs(grid: np.ndarray, color: int, count: int, rng) -> bool:\n    placed_blobs = []\n    for _ in range(count):\n        coords = _choose_placeable_blob(grid, placed_blobs, rng)\n        if coords is None:\n            return False\n        _paint_coords(grid, coords, color)\n        placed_blobs.append(coords)\n    return True\n\n\ndef _choose_placeable_blob(grid: np.ndarray, placed_blobs: list[set], rng) -> set | None:\n    for _ in range(BLOB_PLACE_TRIES):\n        blob = _random_blob(rng)\n        bh, bw = blob.shape\n        r0 = int(rng.integers(0, GRID_SHAPE[0] - bh + 1))\n        c0 = int(rng.integers(0, GRID_SHAPE[1] - bw + 1))\n        coords = _offset_blob_coords(blob, r0, c0)\n        if _coords_are_free(grid, coords) and _chebyshev_ok(coords, placed_blobs):\n            return coords\n    return None\n\n\ndef _offset_blob_coords(blob: np.ndarray, r0: int, c0: int) -> set:\n    offsets = np.argwhere(blob)\n    return set(map(tuple, offsets + np.array([r0, c0])))\n\n\ndef _coords_are_free(grid: np.ndarray, coords: set) -> bool:\n    return all(grid[r, c] == BACKGROUND_COLOR for r, c in coords)\n\n\ndef _paint_coords(grid: np.ndarray, coords: set, color: int) -> None:\n    rr, cc = np.array(list(coords)).T\n    grid[rr, cc] = color\n\n\ndef _counts_match_grid(grid: np.ndarray, counts: list[int]) -> bool:\n    \"\"\"Recompute 8-connected components to reject accidental same-color merges.\"\"\"\n    for color, expected_count in zip(PALETTE_ORDER, counts):\n        mask = grid == color\n        if expected_count == 0:\n            if mask.any():\n                return False\n        elif len(components_mask(mask, connectivity=8)) != expected_count:\n            return False\n    return True\n\n\ndef _solver_matches_expected(grid: np.ndarray, counts: list[int]) -> bool:\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return np.array_equal(out, _expected_output(counts))\n\n\ndef _expected_output(counts: list[int]) -> np.ndarray:\n    out = np.full((max(counts), N_COLORS), BACKGROUND_COLOR, dtype=int)\n    for c_idx, (color, count) in enumerate(zip(PALETTE_ORDER, counts)):\n        if count:\n            out[-count:, c_idx] = color\n    return out\n\n\ndef _random_blob(rng) -> np.ndarray:\n    \"\"\"Generate a random small 8-connected blob mask.\"\"\"\n    shape_type = rng.integers(0, N_BLOB_SHAPES)\n\n    if shape_type == 0:\n        return np.array([[True]])\n    elif shape_type == 1:\n        length = int(rng.integers(*LINE_LENGTH_RANGE))\n        return np.ones((1, length), dtype=bool)\n    elif shape_type == 2:\n        length = int(rng.integers(*LINE_LENGTH_RANGE))\n        return np.ones((length, 1), dtype=bool)\n    elif shape_type == 3:\n        return _random_grown_blob(rng)\n    elif shape_type == 4:\n        return _plus_blob()\n    else:\n        h = int(rng.integers(*SMALL_DIM_RANGE))\n        w = int(rng.integers(*SMALL_DIM_RANGE))\n        return np.ones((h, w), dtype=bool)\n\n\ndef _random_grown_blob(rng) -> np.ndarray:\n    \"\"\"Grow a small mask by repeatedly adding an 8-neighbor of existing pixels.\"\"\"\n    h = int(rng.integers(*SMALL_DIM_RANGE))\n    w = int(rng.integers(*SMALL_DIM_RANGE))\n    mask = np.zeros((h, w), dtype=bool)\n    mask[0, 0] = True\n    pixels = [(0, 0)]\n    target_size = int(rng.integers(GROWN_BLOB_MIN_SIZE, h * w + 1))\n    for _ in range(target_size - 1):\n        candidates = _growth_candidates(mask, pixels)\n        if not candidates:\n            break\n        pick = list(candidates)[int(rng.integers(0, len(candidates)))]\n        mask[pick[0], pick[1]] = True\n        pixels.append(pick)\n    return mask\n\n\ndef _growth_candidates(mask: np.ndarray, pixels: list[tuple[int, int]]) -> set:\n    h, w = mask.shape\n    candidates = set()\n    for r, c in pixels:\n        for dr in range(-1, 2):\n            for dc in range(-1, 2):\n                if dr == 0 and dc == 0:\n                    continue\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:\n                    candidates.add((nr, nc))\n    return candidates\n\n\ndef _plus_blob() -> np.ndarray:\n    mask = np.zeros((PLUS_SHAPE_SIZE, PLUS_SHAPE_SIZE), dtype=bool)\n    center = PLUS_SHAPE_SIZE // 2\n    mask[center, :] = True\n    mask[:, center] = True\n    return mask\n\n\ndef _chebyshev_ok(new_coords: set, existing_blobs: list) -> bool:\n    for blob in existing_blobs:\n        for r1, c1 in new_coords:\n            for r2, c2 in blob:\n                if max(abs(r1 - r2), abs(c1 - c2)) < SAME_COLOR_MIN_CHEBYSHEV:\n                    return False\n    return True\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/5a719d11.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Within each horizontal pair of two-color panels, swap the motif masks and recolor each pasted mask with the source panel's base color.\n\n    Input structure:\n    - A separator color forms full blank rows and at least one full blank column.\n    - The non-separator area is split into row bands, each containing exactly two same-shaped rectangular panels.\n    - Each panel has a dominant base color and one minority motif color.\n\n    Rule:\n    - For every row band, clear each panel to its own base color.\n    - Paste the right panel's motif mask into the left panel using the right base color.\n    - Paste the left panel's motif mask into the right panel using the left base color.\n\n    Key insight:\n    - The motif colors themselves are distractors; only each motif's shape mask and the two panel base colors are exchanged.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"grid must be 2D\"\n\n    sep = _separator_color(g)\n    row_bands = _bands(np.where(~np.all(g == sep, axis=1))[0])\n    col_bands = _bands(np.where(~np.all(g == sep, axis=0))[0])\n    assert len(col_bands) == 2, f\"expected exactly two panel columns, got {len(col_bands)}\"\n\n    out = g.copy()\n    (lc0, lc1), (rc0, rc1) = col_bands\n    for r0, r1 in row_bands:\n        left = g[r0 : r1 + 1, lc0 : lc1 + 1]\n        right = g[r0 : r1 + 1, rc0 : rc1 + 1]\n        assert left.shape == right.shape, \"paired panels must have the same shape\"\n\n        left_base, left_motif = _base_and_motif_mask(left)\n        right_base, right_motif = _base_and_motif_mask(right)\n\n        new_left = np.full(left.shape, left_base, dtype=int)\n        new_right = np.full(right.shape, right_base, dtype=int)\n        new_left[right_motif] = right_base\n        new_right[left_motif] = left_base\n\n        out[r0 : r1 + 1, lc0 : lc1 + 1] = new_left\n        out[r0 : r1 + 1, rc0 : rc1 + 1] = new_right\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and separator geometry.\nNUM_BANDS_MIN, NUM_BANDS_MAX = 2, 4\nPANEL_H_MIN, PANEL_H_MAX = 6, 8\nPANEL_W_MIN, PANEL_W_MAX = 7, 8\nSEPARATOR_H = 2\nSEPARATOR_W_MIN, SEPARATOR_W_MAX = 1, 2\nMAX_GRID_SIZE = 30\n\n# Motif size and component growth.\nMOTIF_MARGIN = 1\nMOTIF_FILL_MIN, MOTIF_FILL_MAX = 0.10, 0.30\nMAX_MOTIF_COMPONENTS = 4\nCOMPONENT_WEIGHTS = (0.68, 0.16, 0.10, 0.06)\nPART_MIN_SIZE, PART_WEIGHT_OFFSET = 2, 0.2\n\n# Color sampling and retry limits.\nPALETTE = tuple(range(1, 10))\nSAME_BASE_PROB = 0.25\nGENERATION_RETRIES = 300\n\n\ndef _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:\n    out = []\n    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n        rr, cc = r + dr, c + dc\n        if MOTIF_MARGIN <= rr < h - MOTIF_MARGIN and MOTIF_MARGIN <= cc < w - MOTIF_MARGIN:\n            out.append((rr, cc))\n    return out\n\n\ndef _partition(total: int, parts: int) -> list[int]:\n    mins = [PART_MIN_SIZE] * parts if total >= PART_MIN_SIZE * parts else [1] * parts\n    remaining = total - sum(mins)\n    weights = [random.random() + PART_WEIGHT_OFFSET for _ in range(parts)]\n    sizes = mins[:]\n    for _ in range(remaining):\n        i = random.choices(range(parts), weights=weights, k=1)[0]\n        sizes[i] += 1\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _touches_other(label: np.ndarray, r: int, c: int, own: int) -> bool:\n    h, w = label.shape\n    for rr, cc in _neighbors4(r, c, h, w):\n        v = int(label[rr, cc])\n        if v not in (0, own):\n            return True\n    return False\n\n\ndef _grow_mask(h: int, w: int, target: int, n_comp: int) -> np.ndarray | None:\n    label = np.zeros((h, w), dtype=int)\n    cells = [(r, c) for r in range(MOTIF_MARGIN, h - MOTIF_MARGIN) for c in range(MOTIF_MARGIN, w - MOTIF_MARGIN)]\n    random.shuffle(cells)\n\n    seeds: list[tuple[int, int]] = []\n    for r, c in cells:\n        if all(abs(r - sr) + abs(c - sc) > 1 for sr, sc in seeds):\n            seeds.append((r, c))\n            if len(seeds) == n_comp:\n                break\n    if len(seeds) != n_comp:\n        return None\n\n    sizes = _partition(target, n_comp)\n    comps: list[set[tuple[int, int]]] = []\n    for i, (r, c) in enumerate(seeds, start=1):\n        label[r, c] = i\n        comps.append({(r, c)})\n\n    for i, size in enumerate(sizes, start=1):\n        while len(comps[i - 1]) < size:\n            frontier = set()\n            for rr, cc in comps[i - 1]:\n                frontier.update(_neighbors4(rr, cc, h, w))\n            choices = [\n                cell\n                for cell in frontier\n                if label[cell] == 0 and not _touches_other(label, cell[0], cell[1], i)\n            ]\n            if not choices:\n                return None\n            nr, nc = random.choice(choices)\n            label[nr, nc] = i\n            comps[i - 1].add((nr, nc))\n\n    return label > 0\n\n\ndef _random_motif_mask(h: int, w: int) -> np.ndarray | None:\n    area = h * w\n    lo = max(1, int(np.ceil(MOTIF_FILL_MIN * area)))\n    hi = min((h - 2 * MOTIF_MARGIN) * (w - 2 * MOTIF_MARGIN), int(np.floor(MOTIF_FILL_MAX * area)))\n    if lo > hi:\n        return None\n    target = random.randint(lo, hi)\n\n    max_comp = min(MAX_MOTIF_COMPONENTS, target)\n    n_comp = random.choices(range(1, max_comp + 1), weights=COMPONENT_WEIGHTS[:max_comp], k=1)[0]\n    return _grow_mask(h, w, target, n_comp)\n\n\ndef _pair_colors() -> tuple[int, int, int, int]:\n    colors = list(PALETTE)\n    if random.random() < SAME_BASE_PROB:\n        base = random.choice(colors)\n        left_motif, right_motif = random.sample([c for c in colors if c != base], 2)\n        return base, base, left_motif, right_motif\n    left_base, right_base, left_motif, right_motif = random.sample(colors, 4)\n    return left_base, right_base, left_motif, right_motif\n\n\ndef _choose_layout() -> tuple[int, int, int, int, int]:\n    num_bands = random.randint(NUM_BANDS_MIN, NUM_BANDS_MAX)\n    panel_h = random.choice([h for h in range(PANEL_H_MIN, PANEL_H_MAX + 1) if num_bands * h + SEPARATOR_H * (num_bands - 1) <= MAX_GRID_SIZE])\n    panel_w = random.randint(PANEL_W_MIN, PANEL_W_MAX)\n    sep_w = random.randint(SEPARATOR_W_MIN, SEPARATOR_W_MAX)\n    return num_bands, panel_h, panel_w, SEPARATOR_H, sep_w\n\n\ndef _make_pair_panels(panel_h: int, panel_w: int) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray] | None:\n    \"\"\"Build the input and output panels for one paired row band.\"\"\"\n    left_base, right_base, left_motif_color, right_motif_color = _pair_colors()\n    left_mask = _random_motif_mask(panel_h, panel_w)\n    right_mask = _random_motif_mask(panel_h, panel_w)\n    if left_mask is None or right_mask is None:\n        return None\n\n    in_left = np.full((panel_h, panel_w), left_base, dtype=int)\n    in_right = np.full((panel_h, panel_w), right_base, dtype=int)\n    out_left = np.full((panel_h, panel_w), left_base, dtype=int)\n    out_right = np.full((panel_h, panel_w), right_base, dtype=int)\n    in_left[left_mask] = left_motif_color\n    in_right[right_mask] = right_motif_color\n    out_left[right_mask] = right_base\n    out_right[left_mask] = left_base\n    return in_left, in_right, out_left, out_right\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    num_bands, panel_h, panel_w, sep_h, sep_w = _choose_layout()\n    height = num_bands * panel_h + (num_bands - 1) * sep_h\n    width = 2 * panel_w + sep_w\n    inp = np.zeros((height, width), dtype=int)\n    out = np.zeros((height, width), dtype=int)\n    right_c0 = panel_w + sep_w\n\n    for band in range(num_bands):\n        r0 = band * (panel_h + sep_h)\n        panels = _make_pair_panels(panel_h, panel_w)\n        if panels is None:\n            return None\n        in_left, in_right, out_left, out_right = panels\n\n        paste(inp, in_left, r0, 0)\n        paste(inp, in_right, r0, right_c0)\n        paste(out, out_left, r0, 0)\n        paste(out, out_right, r0, right_c0)\n\n    if not np.array_equal(main(inp), out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
