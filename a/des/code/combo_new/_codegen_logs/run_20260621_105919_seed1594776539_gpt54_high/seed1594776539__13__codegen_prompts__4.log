{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py /home/lixinyu/snap/new/ARC_code/train/db7260a4.py /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py /home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py /home/lixinyu/snap/new/ARC_code/train/689c358e.py; do echo \"FILE $f\"; sed -n '\"'/\"'^def main(/,/''^def /p'\"' \\\"\"'$f\" | sed '\"'\"'$d'\"'; echo; done\"","aggregated_output":"FILE /home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Paint an inner border around the region reachable from a corner marker pixel.\n\n    Input structure:\n    - bg = most common color; wall color (blue) forms barriers dividing the grid.\n    - A unique single pixel (magenta) sits on one corner — the start marker.\n    - Some wall-colored pixels are structural (border-touching, enclosing regions); others are decorations.\n\n    Rule:\n    - Flood-fill from the marker corner to find all reachable bg cells, blocked by structural walls.\n    - Erase wall-colored decorations hidden behind structural walls (not reachable from marker side).\n    - Paint orange (color 7) on every reachable bg cell adjacent to a wall or grid edge — forming a 1-cell inner border.\n\n    Key insight: Only border-connected wall components act as real barriers; interior wall fragments are decorations to be removed.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Marker pixel is a unique (count==1) non-bg pixel on a corner.\n    counts = Counter(int(v) for v in g.ravel())\n    corners = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]\n    marker = None\n    for r, c in corners:\n        v = int(g[r, c])\n        if v != bg and counts.get(v, 0) == 1:\n            marker = (r, c, v)\n            break\n    assert marker is not None, \"no unique single-pixel corner marker found\"\n\n    mr, mc, marker_col = marker\n\n    # Wall color: most frequent non-bg, non-marker color.\n    other_cols = [c for c in counts.keys() if c not in (bg, marker_col)]\n    assert other_cols, \"no non-bg non-marker colors found; cannot determine wall color\"\n    wall_col = max(other_cols, key=lambda c: counts[c])\n\n    # First reach: treat all wall pixels as obstacles.\n    reach0 = _flood(\n        (mr, mc),\n        lambda r, c: int(g[r, c]) in (bg, marker_col),\n        h,\n        w,\n    )\n\n    # Structural walls are wall-color components that touch the border AND are adjacent to reach0.\n    walls: set[tuple[int, int]] = set()\n    for comp_arr in components_mask(g == wall_col, connectivity=4):\n        comp = [(int(r), int(c)) for r, c in comp_arr]\n        touches_border = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp)\n        if not touches_border:\n            continue\n        adjacent_to_reach0 = any(any((nr, nc) in reach0 for nr, nc in neighbors4(r, c)) for r, c in comp)\n        if adjacent_to_reach0:\n            walls |= set(comp)\n\n    # Second reach: allow passing through non-wall wall-color pixels (decorations) so they don't create borders.\n    reach = _flood(\n        (mr, mc),\n        lambda r, c: int(g[r, c]) in (bg, marker_col) or (int(g[r, c]) == wall_col and (r, c) not in walls),\n        h,\n        w,\n    )\n\n    # Remove wall-colored decorations that are not reachable (they lie behind structural walls).\n    for r in range(h):\n        for c in range(w):\n            if int(out[r, c]) == wall_col and (r, c) not in walls and (r, c) not in reach:\n                out[r, c] = bg\n\n    fill_col = 7\n    # Paint a 1-cell-thick inner border of the reachable region (on background cells only).\n    for r, c in reach:\n        if int(out[r, c]) != bg:\n            continue\n        if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n            out[r, c] = fill_col\n            continue\n        if any((nr, nc) in walls for nr, nc in neighbors8(r, c)):\n            out[r, c] = fill_col\n            continue\n        if any((nr, nc) not in reach for nr, nc in neighbors4(r, c)):\n            out[r, c] = fill_col\n\n    return out\n\n# --------------- generator (merged (attempts 1+2 hybrid)) ---------------\n\n# ---- Palette (task colors) ----\nBG = 8\nWALL = 1\nMARKER = 6\nFILL = 7\n\n# ---- Canvas size ----\nGRID_H_RANGE = (10, 20)\nGRID_W_RANGE = (10, 20)\n\n# ---- Structural walls ----\nNUM_STRUCTS_RANGE = (1, 4)\nSTRUCT_SHAPE_RETRIES = 8             # per-shape placement retries\nRECT_MAX_DIM_DIV = 3                 # rect max side ~ dim // 3\nTRI_MAX_SIZE = 6                     # diamond/triangle cap on size\nTRI_MIN_DIM_DIV = 3                  # diamond/top-tri need dim // 3\n\n# ---- Reachable region gate ----\nREACH_RATIO_RANGE = (0.38, 0.87)\n\n# ---- Decorations ----\nNUM_DECOR_RANGE = (0, 3)\nDECOR_AREA_RANGE = (1, 4)            # max pixel-extent of a single decor patch\nDECOR_BORDER = 1                     # stay >= N cells from grid edge\nDECOR_PADDING = 1                    # 8-conn separation from other occupancy\n\n# ---- Outer retry budget ----\nGEN_ATTEMPTS = 300\n\n\n# =============================================================================\n# Shape factories (each returns list[(r,c)] or None for a 4-contiguous shape\n# that touches at least one grid edge).\n# =============================================================================\n\n\nFILE /home/lixinyu/snap/new/ARC_code/train/db7260a4.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the singleton marker into the matching red U-shaped container, or make a bottom-row puddle if no closed container is hit.\n\n    Input structure\n    - The grid has a dominant background, one singleton marker pixel on the top row,\n      and one other foreground color forming vertical bars and bottom segments.\n    - A closed container is a U shape: two vertical side bars with a continuous\n      bottom segment between them and an empty rectangular interior above the bottom.\n\n    Rule\n    - Remove the top marker from its original cell.\n    - If exactly one closed U-shaped container has the marker column within its\n      horizontal footprint, fill that container's empty interior with the marker color.\n    - If no closed container is under the marker column, fill the whole bottom row\n      with the marker color.\n\n    Key insight\n    - The marker does not identify a color by value; it identifies a vertical drop\n      column, and only a structurally closed U shape can catch and contain the fill.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    foreground_colors = colors_present(g, exclude={bg})\n    assert len(foreground_colors) == 2, \"expected marker and wall colors\"\n\n    singleton_colors = [color for color in foreground_colors if int(np.count_nonzero(g == color)) == 1]\n    assert len(singleton_colors) == 1, \"expected exactly one singleton marker color\"\n    marker_color = singleton_colors[0]\n\n    wall_colors = [color for color in foreground_colors if color != marker_color]\n    assert len(wall_colors) == 1\n    wall_color = wall_colors[0]\n\n    marker_coords = np.argwhere(g == marker_color)\n    assert marker_coords.shape == (1, 2)\n    marker_r, marker_c = map(int, marker_coords[0])\n    assert marker_r == 0, \"marker must sit on the top row\"\n\n    containers = [\n        container\n        for container in _closed_u_containers(g, wall_color, bg)\n        if container[0] > marker_r and container[2] <= marker_c <= container[3]\n    ]\n    assert len(containers) <= 1, \"marker column must select at most one closed container\"\n\n    out = g.copy()\n    out[marker_r, marker_c] = bg\n    if containers:\n        top, bottom, left, right = containers[0]\n        out[top:bottom, left + 1 : right] = marker_color\n    else:\n        assert np.all(out[-1, :] == bg), \"missed marker should fall to an empty bottom row\"\n        out[-1, :] = marker_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed ARC colors and canvas.\n_GEN_BG = 0\n_GEN_MARKER = 1\n_GEN_WALL = 2\n_GEN_H = 10\n_GEN_W = 10\n\n# Vertical layout bounds; row 9 stays empty in generated inputs.\n_GEN_MARKER_ROW = 0\n_GEN_MIN_WALL_ROW = 2\n_GEN_LAST_WALL_ROW = 8\n\n# Closed container interior size ranges, with exclusive upper bounds.\n_GEN_INTERIOR_H_RANGE = (2, 4)\n_GEN_INTERIOR_W_RANGE = (1, 6)\n\n# Broken distractor patch size ranges, with exclusive upper bounds.\n_GEN_DISTRACTOR_H_RANGE = (2, 4)\n_GEN_DISTRACTOR_W_RANGE = (4, 7)\n\n# Scenario mix and distractor count ranges, with exclusive upper bounds.\n_GEN_FILL_CONTAINER_PROB = 0.67\n_GEN_MISSED_HAS_U_PROB = 0.55\n_GEN_DISTRACTORS_WITH_U_RANGE = (0, 2)\n_GEN_DISTRACTORS_WITHOUT_U_RANGE = (1, 4)\n\n# Rejection-sampling retry budget.\n_GEN_MAX_ATTEMPTS = 300\n\n\n\nFILE /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\n\nFILE /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n\n    Input structure:\n    - The grid has a dominant background color.\n    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n\n    Rule:\n    - Keep the input pixels unchanged.\n    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n\n    Key insight:\n    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    out = g.copy()\n    h, w = g.shape\n\n    markers: dict[int, int] = {}\n    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n            continue\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n        source = int(sub[0, 0])\n        halo = int(sub[0, 1])\n        assert source != halo, \"legend source and halo colors must differ\"\n        assert source not in markers, \"each source color must have exactly one legend marker\"\n\n        markers[source] = halo\n        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n\n    assert markers, \"expected at least one left-edge legend marker\"\n\n    for source, halo in markers.items():\n        objects = []\n        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n            if cells <= marker_source_cells[source]:\n                continue\n            objects.append(comp)\n        assert objects, \"each legend source color must label at least one non-marker object\"\n\n        for obj in objects:\n            r0, c0, r1, c1 = obj[\"bbox\"]\n            pr0 = max(0, int(r0) - 1)\n            pc0 = max(0, int(c0) - 1)\n            pr1 = min(h - 1, int(r1) + 1)\n            pc1 = min(w - 1, int(c1) + 1)\n\n            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n            coords = obj[\"coords\"]\n            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n            enclosed = object_interior(patch, background=bg)\n            fill_mask = (patch == bg) & ~enclosed\n\n            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n            target[fill_mask] = halo\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and color palette.\nBACKGROUND = 0\nGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\nAVAILABLE_COLORS = tuple(range(1, 10))\n\n# Legend layout.\nLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\nLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n\n# Sprite geometry and acceptance.\nSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\nSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\nSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\nSPRITE_RETRIES = 300\n\n# Object counts and placement.\nINSTANCE_MIN, INSTANCE_MAX = 1, 3\nOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\nEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\nPLACEMENT_RETRIES = 200\n\n# Whole-sample retry budget.\nGENERATION_RETRIES = 300\n\n\n\nFILE /home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fit a grey bar into a grey frame by aligning projections with colored columns, then stack colors above.\n\n    Input structure:\n    - bg, a grey structural color forming two components: a large rectangular frame (slot) and a smaller bar with upward projections.\n    - Colored pixels inside the slot mark target columns.\n\n    Rule:\n    - Move the bar upward into the slot so its bottom edge sits one cell above the slot's interior bottom.\n    - Shift it horizontally so the bar's upward projections align column-wise with the colored pixels in the slot.\n    - Stack the colored pixels immediately above the bar projections in each column.\n\n    Key insight: The bar's projections act as keys that must align with the colored-column \"locks\" in the slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    # Background: most frequent. \"Grey\" structural color: most frequent non-bg.\n    bg = _bg_color(g)\n    other = g[g != bg]\n    if other.size == 0:\n        return g.copy()\n    grey = _most_common(other)\n\n    def comps_of_color(color: int):\n        comps = [(len(pts), _bbox(pts), pts) for pts in _cc4(g == color)]\n        comps.sort(key=lambda t: (-t[0], t[1]))\n        return comps\n\n    grey_comps = comps_of_color(grey)\n    if len(grey_comps) < 2:\n        return g.copy()\n\n    # Slot is the largest grey component (the right-side frame); bar is the next largest.\n    (_, slot_bbox, _), (_, bar_bbox, bar_pts) = grey_comps[0], grey_comps[1]\n    sr0, sc0, sr1, sc1 = slot_bbox\n\n    # Base output: keep only the slot bbox content, clear all colored pixels inside it.\n    out = np.full_like(g, bg)\n    out[sr0 : sr1 + 1, sc0 : sc1 + 1] = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region = out[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region[(slot_region != bg) & (slot_region != grey)] = bg\n\n    # Compute bar translation: bottom of bar sits 1 cell above slot interior bottom.\n    bar_base_row = max(r for r, _ in bar_pts)\n    slot_interior_bottom = sr1 - 1\n    target_base_row = slot_interior_bottom - 1\n    dy = target_base_row - bar_base_row\n\n    # Determine bar projection columns (columns with any bar pixel above the base row).\n    col_min_row = {}\n    for r, c in bar_pts:\n        col_min_row[c] = min(col_min_row.get(c, r), r)\n    src_proj_cols = sorted([c for c, rmin in col_min_row.items() if rmin < bar_base_row])\n\n    # Determine destination columns from colored pixels in the original slot.\n    dst_cols_set = set()\n    for r, c in np.argwhere((g != bg) & (g != grey)):\n        r = int(r)\n        c = int(c)\n        if sr0 <= r <= sr1 and sc0 <= c <= sc1:\n            dst_cols_set.add(c)\n    dst_cols = sorted(dst_cols_set)\n\n    # Compute a robust horizontal shift aligning projection columns to colored columns.\n    dx = None\n    if src_proj_cols and len(src_proj_cols) == len(dst_cols):\n        deltas = [d - s for s, d in zip(src_proj_cols, dst_cols)]\n        if len(set(deltas)) == 1:\n            dx = deltas[0]\n    if dx is None:\n        # Brute pick dx that maximizes overlap of shifted projection cols with dst cols.\n        best = (-1, 0)\n        dst_set = set(dst_cols)\n        for cand_dx in range(-w, w + 1):\n            score = sum((c + cand_dx) in dst_set for c in src_proj_cols)\n            if score > best[0]:\n                best = (score, cand_dx)\n        dx = best[1]\n\n    # Paste bar into the slot (overwrite with grey).\n    placed = []\n    for r, c in bar_pts:\n        rr = r + dy\n        cc = c + dx\n        if sr0 <= rr <= sr1 and sc0 <= cc <= sc1:\n            out[rr, cc] = grey\n            placed.append((rr, cc))\n\n    # Move colored pixels: for each affected column, stack them immediately above the top of the bar in that column.\n    # Use colors from the original grid (inside slot bbox), ordered top->bottom.\n    placed_by_col = {}\n    for rr, cc in placed:\n        placed_by_col.setdefault(cc, []).append(rr)\n\n    interior_top = sr0 + 1\n    interior_bottom = sr1 - 1\n\n    for col in dst_cols:\n        if col not in placed_by_col:\n            continue\n        bar_top = min(placed_by_col[col])\n        desired_bottom = bar_top - 1\n        if desired_bottom < interior_top:\n            continue\n\n        # Extract original colored pixels in this column (ignore bg/grey).\n        rows = [r for r in range(sr0, sr1 + 1) if g[r, col] != bg and g[r, col] != grey]\n        if not rows:\n            continue\n        colors = [int(g[r, col]) for r in rows]  # top->bottom order by construction\n\n        max_len = desired_bottom - interior_top + 1\n        if max_len <= 0:\n            continue\n        if len(colors) > max_len:\n            colors = colors[-max_len:]\n\n        start_row = desired_bottom - len(colors) + 1\n        start_row = max(start_row, interior_top)\n\n        # Paint (overwrite) within the interior only.\n        for i, colv in enumerate(colors):\n            rr = start_row + i\n            if interior_top <= rr <= interior_bottom:\n                out[rr, col] = colv\n\n    return out\n\n# --------------- generator (attempt 3 (Codex)) ---------------\n\n# --- Palette ---\nBG = 0\nGREY = 5\nPALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)  # colors != bg and != grey\n\n# --- Canvas geometry (fixed per spec) ---\nH, W = 8, 20\n\n# --- Frame (right-hand slot) ---\nFRAME_R0, FRAME_C0 = 0, 9            # top-left of frame patch\nFRAME_H, FRAME_W = 8, 11             # frame patch dimensions\nLEFT_WALL_OPEN_ROWS = (4, 5)         # rows where the left wall of the frame is open\n\n# --- Slot columns inside the frame ---\nSLOT_COLS = [11, 13, 15, 17]         # absolute col indices\nSLOT_LENS = [3, 4, 4, 3]             # per-col length counted from row 1\nSLOT_TOP_ROW = 1                     # topmost interior row of slot columns\n\n# --- Bar geometry ---\nBAR_INPUT_C0 = 1                     # left column of bar in the input (pre-translation)\nBAR_OUTPUT_C0 = 11                   # left column of bar in the expected output (post-translation)\nBAR_R0 = 2                           # top row where bar patch is pasted\nBAR_H, BAR_W = 4, 7                  # bar patch dimensions (4 rows tall, base at local row 3)\nBAR_LOCAL_PROJ_COLS = [0, 2, 4, 6]  