{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/b25e450b.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords, components_mask\nimport random\n\nBBox = tuple[int, int, int, int]\n\n\ndef _edge_side(bbox: BBox, shape: tuple[int, int]) -> str:\n    r0, c0, r1, c1 = bbox\n    h, w = shape\n    sides = []\n    if r0 == 0:\n        sides.append(\"top\")\n    if r1 == h - 1:\n        sides.append(\"bottom\")\n    if c0 == 0:\n        sides.append(\"left\")\n    if c1 == w - 1:\n        sides.append(\"right\")\n    assert len(sides) == 1, \"each black rectangle must touch exactly one grid edge\"\n    return sides[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide each black border rectangle to the opposite border, recoloring its swept stripe orange and leaving the rectangle black at the far edge.\n\n    Input structure\n    - The grid contains black rectangular 4-connected masks, each touching exactly one outer border.\n    - Grey cells form incidental pattern content; orange is the trail color used when a black mask slides.\n\n    Rule\n    - Treat all black rectangles as moving simultaneously.\n    - A rectangle touching the top or bottom edge moves vertically to the opposite edge in the same columns.\n    - A rectangle touching the left or right edge moves horizontally to the opposite edge in the same rows.\n    - Recolor the complete swept row or column stripe to orange, then stamp every destination rectangle in black.\n\n    Key insight\n    - Edge contact gives the slide direction; the output is the set of opposite-edge black rectangles plus their orange trails.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    moving = Color.BLACK\n    trail = Color.ORANGE\n    assert np.any(g == moving), \"expected at least one black rectangle\"\n    assert np.any(g == trail), \"expected orange trail color to be present\"\n\n    out = g.copy()\n    targets: list[BBox] = []\n    for coords in components_mask(g == moving, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        rect_h = r1 - r0 + 1\n        rect_w = c1 - c0 + 1\n        assert int(coords.shape[0]) == rect_h * rect_w, \"black mask must be a solid rectangle\"\n\n        side = _edge_side((r0, c0, r1, c1), g.shape)\n        if side == \"top\":\n            out[:, c0 : c1 + 1] = trail\n            targets.append((h - rect_h, c0, h - 1, c1))\n        elif side == \"bottom\":\n            out[:, c0 : c1 + 1] = trail\n            targets.append((0, c0, rect_h - 1, c1))\n        elif side == \"left\":\n            out[r0 : r1 + 1, :] = trail\n            targets.append((r0, w - rect_w, r1, w - 1))\n        else:\n            assert side == \"right\"\n            out[r0 : r1 + 1, :] = trail\n            targets.append((r0, 0, r1, rect_w - 1))\n\n    for r0, c0, r1, c1 in targets:\n        out[r0 : r1 + 1, c0 : c1 + 1] = moving\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and palette.\nMIN_H, MAX_H = 6, 18\nMIN_W, MAX_W = 8, 14\nBG_GREY, BG_ORANGE = 5, 7\nGREY_FRAC_MIN, GREY_FRAC_MAX = 0.2, 0.6\n\n# Rectangle and band constraints.\nMIN_RECTS, MAX_RECTS = 1, 8\nMIN_BAND_SIZE, MAX_BAND_SIZE = 1, 6\nBAND_GAP = 1\nMIN_RECT_AREA, MAX_RECT_AREA = 2, 18\nMAX_RECT_SIDE = 6\nSOURCE_EDGE_OFFSET = 1\n\n# Retry limits.\nTARGET_COUNT_ATTEMPTS = 300\nANY_COUNT_ATTEMPTS = 100\n\n\ndef _partition_bands(\n    total: int, n: int, min_size: int, max_size: int, min_gap: int = 0\n) -> list[tuple[int, int]] | None:\n    \"\"\"Place n non-overlapping inclusive bands inside [0, total - 1].\"\"\"\n    if n == 0:\n        return []\n\n    needed = n * min_size + (n - 1) * min_gap\n    if needed > total:\n        return None\n\n    effective_max = min(max_size, total - (n - 1) * (min_size + min_gap))\n    if effective_max < min_size:\n        return None\n\n    widths = [random.randint(min_size, effective_max) for _ in range(n)]\n    total_used = sum(widths) + (n - 1) * min_gap\n    if total_used > total:\n        excess = total_used - total\n        indices = list(range(n))\n        random.shuffle(indices)\n        for i in indices:\n            shrink = min(widths[i] - min_size, excess)\n            widths[i] -= shrink\n            excess -= shrink\n            if excess == 0:\n                break\n        if excess > 0:\n            return None\n\n    remaining = total - sum(widths) - (n - 1) * min_gap\n    extra_gaps = [0] * (n + 1)\n    for _ in range(remaining):\n        extra_gaps[random.randint(0, n)] += 1\n\n    bands = []\n    pos = 0\n    for i in range(n):\n        pos += extra_gaps[i]\n        if i > 0:\n            pos += min_gap\n        bands.append((pos, pos + widths[i] - 1))\n        pos += widths[i]\n    return bands\n\n\ndef _choose_orientation_counts(n_rects: int) -> tuple[int, int] | None:\n    max_vert = min(n_rects, (MAX_W - SOURCE_EDGE_OFFSET) // 2)\n    max_horiz = min(n_rects, (MAX_H - SOURCE_EDGE_OFFSET) // 2)\n    feasible = [(v, n_rects - v) for v in range(n_rects + 1)\n                if v <= max_vert and (n_rects - v) <= max_horiz]\n    if not feasible:\n        return None\n    return random.choice(feasible)\n\n\ndef _choose_canvas(n_vert: int, n_horiz: int) -> tuple[int, int] | None:\n    min_h = max(MIN_H, 2 * n_horiz + 1) if n_horiz > 0 else MIN_H\n    min_w = max(MIN_W, 2 * n_vert + 1) if n_vert > 0 else MIN_W\n    if min_h > MAX_H or min_w > MAX_W:\n        return None\n    return random.randint(min_h, MAX_H), random.randint(min_w, MAX_W)\n\n\ndef _interior_bands(total: int, n: int) -> list[tuple[int, int]] | None:\n    raw = _partition_bands(total - 2, n, MIN_BAND_SIZE, MAX_BAND_SIZE, BAND_GAP)\n    if raw is None:\n        return None\n    return [(a + SOURCE_EDGE_OFFSET, b + SOURCE_EDGE_OFFSET) for a, b in raw]\n\n\ndef _rect_span_for_band(band_size: int, travel: int) -> int | None:\n    max_len = min(MAX_RECT_SIDE, travel // 2 - 1, MAX_RECT_AREA // band_size)\n    min_len = max(MIN_BAND_SIZE, -(-MIN_RECT_AREA // band_size))\n    if min_len > max_len:\n        return None\n    return random.randint(min_len, max_len)\n\n\ndef _build_rects(H: int, W: int, n_vert: int, n_horiz: int) -> list[tuple[int, int, int, int, str]] | None:\n    \"\"\"Return destination rectangles plus their original source edge.\"\"\"\n    vert_edges = [random.choice([\"top\", \"bottom\"]) for _ in range(n_vert)]\n    horiz_edges = [random.choice([\"left\", \"right\"]) for _ in range(n_horiz)]\n\n    col_bands = _interior_bands(W, n_vert)\n    if col_bands is None:\n        return None\n    row_bands = _interior_bands(H, n_horiz)\n    if row_bands is None:\n        return None\n\n    rects = []\n    for i, (c0, c1) in enumerate(col_bands):\n        rect_w = c1 - c0 + 1\n        rect_h = _rect_span_for_band(rect_w, H)\n        if rect_h is None:\n            return None\n        se = vert_edges[i]\n        if se == \"top\":\n            dr0, dr1 = H - rect_h, H - 1\n        else:\n            dr0, dr1 = 0, rect_h - 1\n        rects.append((dr0, c0, dr1, c1, se))\n\n    for i, (r0, r1) in enumerate(row_bands):\n        rect_h = r1 - r0 + 1\n        rect_w = _rect_span_for_band(rect_h, W)\n        if rect_w is None:\n            return None\n        se = horiz_edges[i]\n        if se == \"left\":\n            dc0, dc1 = W - rect_w, W - 1\n        else:\n            dc0, dc1 = 0, rect_w - 1\n        rects.append((r0, dc0, r1, dc1, se))\n\n    return rects\n\n\ndef _random_background(shape: tuple[int, int], grey_frac: float) -> np.ndarray:\n    return np.where(np.random.random(shape) < grey_frac, BG_GREY, BG_ORANGE).astype(int)\n\n\ndef _render_output(H: int, W: int, rects: list[tuple[int, int, int, int, str]], grey_frac: float) -> np.ndarray:\n    output = _random_background((H, W), grey_frac)\n\n    for (dr0, dc0, dr1, dc1, se) in rects:\n        if se in (\"top\", \"bottom\"):\n            output[:, dc0:dc1 + 1] = BG_ORANGE\n        else:\n            output[dr0:dr1 + 1, :] = BG_ORANGE\n\n    for (dr0, dc0, dr1, dc1, _) in rects:\n        output[dr0:dr1 + 1, dc0:dc1 + 1] = 0\n    return output\n\n\ndef _invert_output_to_input(\n    output: np.ndarray, rects: list[tuple[int, int, int, int, str]], grey_frac: float\n) -> np.ndarray:\n    H, W = output.shape\n    inp = output.copy()\n\n    for (dr0, dc0, dr1, dc1, se) in rects:\n        if se in (\"top\", \"bottom\"):\n            inp[:, dc0:dc1 + 1] = _random_background((H, dc1 - dc0 + 1), grey_frac)\n        else:\n            inp[dr0:dr1 + 1, :] = _random_background((dr1 - dr0 + 1, W), grey_frac)\n\n    for (dr0, dc0, dr1, dc1, se) in rects:\n        rh, rw = dr1 - dr0 + 1, dc1 - dc0 + 1\n        if se == \"top\":\n            inp[0:rh, dc0:dc1 + 1] = 0\n        elif se == \"bottom\":\n            inp[H - rh:H, dc0:dc1 + 1] = 0\n        elif se == \"left\":\n            inp[dr0:dr1 + 1, 0:rw] = 0\n        else:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/36a08778.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, deque\nimport numpy as np\nfrom arc_utils import STRUCT8, components_mask\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Simulate water falling from top-edge sources, pooling on shelves, and cascading off edges.\n\n    Input structure:\n    - bg = most common color; water = rarest non-bg; shelf = other non-bg.\n    - Sources: water clusters touching top row. Shelves: horizontal segments.\n\n    Rule:\n    - Water falls down from sources, painting bg cells as water.\n    - On hitting a shelf, it spreads across the shelf span plus one cell past each end.\n    - From those overflow positions, water resumes falling independently.\n\n    Key insight: Each shelf splits a stream into two at its edges, creating a branching waterfall tree.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    cnt = Counter(map(int, g.flatten()))\n    bg = int(cnt.most_common(1)[0][0])\n    non = [int(c) for c in cnt.keys() if int(c) != int(bg)]\n    assert not (not non)\n    water = int(min(non, key=lambda c: (int(cnt[int(c)]), int(c))))\n    other = [int(c) for c in non if int(c) != int(water)]\n    assert not (not other)\n    shelf = int(other[0])\n\n    out = g.copy()\n\n    # sources: 8-connected components of water that touch the top edge; start from their bottommost row\n    sources: list[tuple[int, int]] = []\n    for coords in components_mask(g == int(water), connectivity=8):\n        if coords.size == 0:\n            continue\n        if not bool((coords[:, 0] == 0).any()):\n            continue\n        rmax = int(coords[:, 0].max())\n        cols = sorted({int(c) for r, c in coords if int(r) == int(rmax)})\n        for c in cols:\n            sources.append((int(rmax), int(c)))\n\n    # shelf segments (from original grid g)\n    shelf_segs: list[list[tuple[int, int]]] = [[] for _ in range(H)]\n    for r in range(H):\n        c = 0\n        while c < W:\n            if int(g[int(r), int(c)]) != int(shelf):\n                c += 1\n                continue\n            c0 = int(c)\n            while c + 1 < W and int(g[int(r), int(c + 1)]) == int(shelf):\n                c += 1\n            shelf_segs[int(r)].append((int(c0), int(c)))\n            c += 1\n\n    def find_shelf_seg(r: int, c: int) -> tuple[int, int] | None:\n        for a, b in shelf_segs[int(r)]:\n            if int(a) <= int(c) <= int(b):\n                return (int(a), int(b))\n        return None\n\n    def spread_limits(row: int, start_col: int, min_col: int, max_col: int) -> tuple[int, int]:\n        \"\"\"\n        Expand horizontally only through contiguous bg cells on the current row.\n\n        This prevents water from \"jumping\" over blockers that sit on the spread row.\n        \"\"\"\n        left = int(start_col)\n        while left - 1 >= int(min_col) and int(g[int(row), int(left - 1)]) == int(bg):\n            left -= 1\n\n        right = int(start_col)\n        while right + 1 <= int(max_col) and int(g[int(row), int(right + 1)]) == int(bg):\n            right += 1\n\n        return (int(left), int(right))\n\n    seen: set[tuple[int, int]] = set()\n    q = deque((int(r), int(c)) for r, c in sources)\n\n    while q:\n        r, c = q.popleft()\n        if (int(r), int(c)) in seen:\n            continue\n        seen.add((int(r), int(c)))\n\n        rr, cc = int(r), int(c)\n        out[rr, cc] = int(water)\n\n        while True:\n            nr = int(rr + 1)\n            if nr >= H:\n                break\n            below = int(g[int(nr), int(cc)])\n\n            if below == int(shelf):\n                seg = find_shelf_seg(nr, cc)\n                if seg is None:\n                    break\n                a, b = seg\n                left_bound = int(max(0, int(a - 1)))\n                right_bound = int(min(int(W - 1), int(b + 1)))\n                left, right = spread_limits(rr, cc, left_bound, right_bound)\n                for x in range(left, right + 1):\n                    if int(g[int(rr), int(x)]) == int(bg):\n                        out[int(rr), int(x)] = int(water)\n                for nc in {left, right}:\n                    if int(nc) != int(cc):\n                        q.append((int(rr), int(nc)))\n                break\n\n            rr = nr\n            out[int(rr), int(cc)] = int(water)\n\n    return out\n\n# --------------- generator (cascade tree top-down construction) ---------------\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input for the waterfall cascade task.\"\"\"\n    BG, WATER, SHELF = 7, 6, 2\n\n    H = random.randint(8, 30)\n    W = random.randint(5, 30)\n\n    num_sources = random.choice([1, 2]) if W >= 14 else 1\n    if num_sources == 2:\n        src1 = random.randint(0, W - 8)\n        src2 = random.randint(src1 + 7, W - 1)\n        source_cols = [src1, src2]\n    else:\n        source_cols = [random.randint(0, W - 1)]\n\n    # Track cells reserved for shelf\n    shelf_cells: set[tuple[int, int]] = set()\n    # Cells that must remain bg (overflow positions, fall paths, source positions)\n    reserved_bg: set[tuple[int, int]] = set()\n\n    # Reserve source positions\n    for sc in source_cols:\n        reserved_bg.add((0, sc))\n        reserved_bg.add((1, sc))\n\n    all_shelves: list[tuple[int, int, int]] = []  # (row, a, b)\n\n    def try_add_shelf(r: int, a: int, b: int, is_cascade: bool = False) -> bool:\n        \"\"\"Try to add a shelf segment. Check no conflict with existing shelves or reserved bg cells.\"\"\"\n        cells = [(r, c) for c in range(a, b + 1)]\n        for cell in cells:\n            if cell in shelf_cells or cell in reserved_bg:\n                return False\n        for cell in cells:\n            shelf_cells.add(cell)\n        all_shelves.append((r, a, b))\n        return True\n\n    def reserve_overflow_and_fall(spread_row: int, left: int, right: int, incoming_col: int):\n        \"\"\"Reserve overflow positions and their fall paths as must-be-bg.\"\"\"\n        for nc in {left, right}:\n            if nc != incoming_col:\n                # The overflow position itself must be bg\n                reserved_bg.add((spread_row, nc))\n                # Fall path below must be bg until next shelf or grid bottom\n                # We'll just reserve the overflow position for now;\n                # fall path conflicts are handled by checking during shelf placement\n\n    max_depth = random.randint(2, 5)\n    if H < max_depth * 2 + 3:\n        max_depth = max(2, (H - 3) // 2)\n\n    # Build cascade tree top-down\n    # Each stream: (current_row, col, depth)\n    streams: list[tuple[int, int, int]] = [(1, sc, 0) for sc in source_cols]\n    cascade_shelves: list[tuple[int, int, int]] = []\n    processed = set()\n\n    while streams:\n        next_streams = []\n        random.shuffle(streams)\n        for (row, col, depth) in streams:\n            if (row, col) in processed:\n                continue\n            processed.add((row, col))\n\n            if depth >= max_depth or row + 2 >= H:\n                continue\n\n            min_shelf_row = row + 2\n            max_shelf_row = min(H - 1, row + 8)\n            if min_shelf_row > max_shelf_row:\n                continue\n\n            # Try a few times to place a shelf\n            placed = False\n            for _try in range(10):\n                shelf_row = random.randint(min_shelf_row, max_shelf_row)\n                spread_row = shelf_row - 1\n                if spread_row <= row:\n                    continue\n\n                # Check fall path from (row+1, col) to (shelf_row-1, col) is clear\n                blocked = False\n                for r_check in range(row + 1, shelf_row):\n                    if (r_check, col) in shelf_cells:\n                        blocked = True\n                        break\n                if blocked:\n                    continue\n\n                # Generate shelf segment containing col\n                shelf_len = random.randint(2, min(8, W))\n                max_start = col\n                min_start = max(0, col - shelf_len + 1)\n                if min_start > max_start:\n                    continue\n                a = random.randint(min_start, max_start)\n                b = min(a + shelf_len - 1, W - 1)\n\n                # Check shelf cells don't conflict\n                conflict = False\n                for c in range(a, b + 1):\n                    if (shelf_row, c) in shelf_cells or (shelf_row, c) in reserved_bg:\n                        conflict = True\n                        break\n                if conflict:\n                    continue\n\n                # Compute overflow positions\n                left = max(0, a - 1)\n                right = min(W - 1, b + 1)\n\n                # Check overflow positions on spread row are not shelf\n                overflow_ok = True\n                for nc in {left, right}:\n                    if nc != col:\n                        if (spread_row, nc) in shelf_cells:\n                            overflow_ok = False\n                            break\n                if not overflow_ok:\n                    continue\n\n                # Add the shelf\n                if not try_add_shelf(shelf_row, a, b, is_cascade=True):\n                    continue\n\n                cascade_shelves.append((shelf_row, a, b))\n\n                # Reserve overflow positions and fall path cells as bg\n                reserve_overflow_and_fall(spread_row, left, right, col)\n\n                # Reserve the fall path from current position to shelf\n                for r_res in range(row + 1, shelf_row):\n                    reserved_bg.add((r_res, col))\n\n                # Add new streams from overflow\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, components_mask, find_components, get_bg\nimport random\n\n\ndef _unique_largest_count_color(g: np.ndarray, colors: list[int]) -> int:\n    counts = [(int(np.sum(g == color)), int(color)) for color in colors]\n    max_count = max(count for count, _color in counts)\n    winners = [color for count, color in counts if count == max_count]\n    assert len(winners) == 1, \"expected one most numerous non-background obstacle color\"\n    return winners[0]\n\n\ndef _marker_bbox(g: np.ndarray, marker_colors: list[int]) -> tuple[int, int, int, int]:\n    mask = np.isin(g, marker_colors)\n    candidates: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(mask, connectivity=8):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        if r0 == 0:\n            candidates.append((r0, c0, r1, c1))\n\n    assert len(candidates) == 1, \"expected one top-edge marker component\"\n    return candidates[0]\n\n\ndef _runs(values: list[int]) -> list[tuple[int, int]]:\n    if not values:\n        return []\n\n    runs: list[tuple[int, int]] = []\n    start = prev = values[0]\n    for value in values[1:]:\n        if value == prev + 1:\n            prev = value\n            continue\n        runs.append((start, prev))\n        start = prev = value\n    runs.append((start, prev))\n    return runs\n\n\ndef _can_slide_right(base: np.ndarray, obstacle: int, bg: int, cols: list[int], marker_bottom_r: int, height: int) -> bool:\n    H, W = base.shape\n    assert cols\n    if cols[-1] + 1 >= W:\n        return False\n\n    for floor_r in range(marker_bottom_r + 1, H):\n        target_rows = np.arange(floor_r - height + 1, floor_r + 1)\n        if int(target_rows[0]) < 0:\n            continue\n\n        shifted_cols = [c + 1 for c in cols]\n        target_is_clear = all(np.all(base[target_rows, c] == bg) for c in shifted_cols)\n        if not target_is_clear:\n            continue\n\n        for c in cols:\n            if int(base[floor_r, c]) != obstacle:\n                continue\n            has_horizontal_neighbor = (\n                (c > 0 and int(base[floor_r, c - 1]) == obstacle)\n                or (c + 1 < W and int(base[floor_r, c + 1]) == obstacle)\n            )\n            if has_horizontal_neighbor:\n                return True\n\n    return False\n\n\ndef _clear_bottom_edge_gap(base: np.ndarray, out: np.ndarray, obstacle: int, bg: int, c: int, width: int) -> None:\n    H, W = base.shape\n    if int(base[H - 1, c]) != obstacle:\n        return\n\n    c1 = c\n    while c1 < W and int(base[H - 1, c1]) == obstacle:\n        c1 += 1\n\n    if c1 - c >= width:\n        out[H - 1, c + 1 : c + width] = bg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\n    Input structure\n    - The background is the dominant color.\n    - The most numerous non-background color forms stationary grey obstacle pixels.\n    - The other two colors form a single 3x3 top-edge marker whose top two rows\n      are maroon and whose bottom row contains maroon or blue control pixels.\n\n    Rule\n    - Erase the top marker.\n    - Treat each marker column as a vertical drop retaining its three colors.\n    - A column whose bottom control pixel is blue stops immediately above the\n      first grey pixel below that column, or bottom-aligns if none exists.\n    - Contiguous maroon-ended columns pass through obstacles and bottom-align;\n      if such a run has a clear down-right slide from a grey ledge, shift the\n      run one column right before bottom-aligning.\n    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n      the rest of the marker-width gap in that bottom bar.\n\n    Key insight\n    - The bottom row of the top marker is a control strip: blue cells mean\n      \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H = g.shape[0]\n    bg = int(get_bg(g))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 3, \"expected obstacle color plus two marker colors\"\n    obstacle = _unique_largest_count_color(g, non_bg)\n    marker_colors = [color for color in non_bg if color != obstacle]\n    assert len(marker_colors) == 2, \"expected exactly two marker colors\"\n\n    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)\n    marker = g[r0 : r1 + 1, c0 : c1 + 1]\n    marker_h, marker_w = marker.shape\n    assert (marker_h, marker_w) == (3, 3), \"expected a 3x3 marker\"\n    assert np.all(np.isin(marker, marker_colors)), \"marker bbox must contain only marker colors\"\n\n    pass_color = int(marker[0, 0])\n    assert np.all(marker[:2, :] == pass_color), \"top two marker rows must be the pass-through color\"\n    stop_colors = [color for color in marker_colors if color != pass_color]\n    assert len(stop_colors) == 1, \"expected one stop color\"\n    stop_color = stop_colors[0]\n\n    out = g.copy()\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    base = out.copy()\n\n    pass_columns: list[int] = []\n    for j in range(marker_w):\n        c = c0 + j\n        stack = marker[:, j]\n        bottom_control = int(stack[-1])\n\n        if bottom_control == stop_color:\n            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n            if len(obstacles_below):\n                floor_r = int(r1 + 1 + obstacles_below[0])\n                top_r = floor_r - marker_h\n            else:\n                top_r = H - marker_h\n            assert top_r >= 0, \"stopped column must fit above its obstacle\"\n            out[top_r : top_r + marker_h, c] = stack\n        else:\n            assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n            pass_columns.append(j)\n\n    for start_j, end_j in _runs(pass_columns):\n        source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n        top_r = H - marker_h\n\n        for j in range(start_j, end_j + 1):\n            c = c0 + j + shift\n            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n            out[top_r : top_r + marker_h, c] = marker[:, j]\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\nGRID_SIZE_RANGE = (14, 16)\nMARKER_SIZE = 3\nSTOP_COUNT_RANGE = (1, 3)\nOBSTACLE_COMPONENT_RANGE = (7, 9)\nOBSTACLE_PIXEL_RANGE = (20, 31)\nCOMPONENT_SIZE_RANGE = (1, 11)\nMIN_STOP_OBSTACLE_ROW = 6\nDROP_ZONE_HEIGHT = 3\nCOMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300\n\n\ndef _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:\n    grid = np.full((H, W), GEN_BG, dtype=int)\n    c0 = random.randint(0, W - MARKER_SIZE)\n    num_stops = random.randint(*STOP_COUNT_RANGE)\n    positions = list(range(MARKER_SIZE))\n    random.shuffle(positions)\n    stop_positions = sorted(positions[:num_stops])\n    marker = np.full((MARKER_SIZE, MARKER_SIZE), GEN_PASS, dtype=int)\n    for j in stop_positions:\n        marker[MARKER_SIZE - 1, j] = GEN_STOP\n    grid[0:MARKER_SIZE, c0:c0 + MARKER_SIZE] = marker\n    obstacle_pixels: set[tuple[int, int]] = set()\n    for j in stop_positions:\n        col = c0 + j\n        first_obs_row = random.randint(MIN_STOP_OBSTACLE_ROW, H - 1)\n        grid[first_obs_row, col] = GEN_OBSTACLE\n        obstacle_pixels.add((first_obs_row, col))\n    return grid, c0, stop_positions, obstacle_pixels\n\n\ndef _forbidden_cells(H: int, c0: int, stop_positions: list[int], obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]]:\n    forbidden = {(r, c) for r in range(MARKER_SIZE) for c in range(c0, c0 + MARKER_SIZE)}\n    for j in stop_positions:\n        col = c0 + j\n        for r in range(MARKER_SIZE, H):\n            if (r, col) not in obstacle_pixels:\n                continue\n            for dr in range(1, DROP_ZONE_HEIGHT + 1):\n                if r - dr >= 0:\n                    forbidden.add((r - dr, col))\n            break\n    return forbidden\n\n\ndef _sample_component_sizes(total_pixels: int, component_count: int) -> list[int] | None:\n    component_sizes = []\n    left = total_pixels\n    min_size, max_size = COMPONENT_SIZE_RANGE\n    for i in range(component_count):\n        remaining = component_count - i - 1\n        if remaining == 0:\n            size = left\n        else:\n            lo = max(min_size, left - max_size * remaining)\n            hi = min(max_size, left - min_size * remaining)\n            if lo > hi:\n                return None\n            size = random.randint(lo, hi)\n        left -= size\n        if size < min_size or size > max_size:\n            return None\n        component_sizes.append(size)\n    random.shuffle(component_sizes)\n    return component_sizes\n\n\ndef _grow_component(grid: np.ndarray, comp_size: int, forbidden: set[tuple[int, int]],\n                    obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]] | None:\n    H, W = grid.shape\n    sr, sc = random.randint(0, H - 1), random.randint(0, W - 1)\n    if (sr, sc) in forbidden or (sr, sc) in obstacle_pixels or grid[sr, sc] != GEN_BG:\n        return None\n\n    comp = {(sr, sc)}\n    frontier = [(sr, sc)]\n    while len(comp) < comp_size and frontier:\n        random.shuffle(frontier)\n        expanded = False\n        for fr, fc in frontier:\n            nbrs = [(fr - 1, fc), (fr + 1, fc), (fr, fc - 1), (fr, fc + 1)]\n            random.shuffle(nbrs)\n            for nr, nc in nbrs:\n                if (0 <= nr < H and 0 <= nc < W\n                        and (nr, nc) not in forbidden\n                        and (nr, nc) not in obstacle_pixels\n                        and (nr, nc) not in comp\n                        and grid[nr, nc] == GEN_BG):\n                    comp.add((nr, nc))\n                    frontier.append((nr, nc))\n                    expanded = True\n                    break\n","exit_code":0,"status":"completed"}}
