{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools\nimport numpy as np\n\ndef connected(mask):\n    pts=np.argwhere(mask)\n    if len(pts)==0: return False\n    seen={tuple(pts[0])}\n    stack=[tuple(pts[0])]\n    h,w=mask.shape\n    while stack:\n        r,c=stack.pop()\n        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:\n                seen.add((nr,nc)); stack.append((nr,nc))\n    return len(seen)==int(mask.sum())\n\ndef fullbbox(mask):\n    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()\n\nfound=0\nfor bits in range(1,1<<16):\n    mask=np.array([(bits>>i)&1 for i in range(16)],dtype=bool).reshape(4,4)\n    other=~mask\n    if not (connected(mask) and connected(other) and fullbbox(mask) and fullbbox(other)):\n        continue\n    print(mask.astype(int))\n    print('---')\n    found+=1\n    if found==10:\n        break\nprint('found',found)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
