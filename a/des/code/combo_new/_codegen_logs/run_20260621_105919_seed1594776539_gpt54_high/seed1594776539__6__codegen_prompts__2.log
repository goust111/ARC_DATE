{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, random, math, time, sys\nsizes=[(7,7),(8,8),(7,8),(8,9)]\n\ndef comps(mask):\n    h,w=mask.shape\n    seen=np.zeros((h,w),dtype=bool)\n    cnt=0\n    for r in range(h):\n        for c in range(w):\n            if seen[r,c] or not mask[r,c]:\n                continue\n            cnt+=1\n            stack=[(r,c)]\n            seen[r,c]=True\n            while stack:\n                rr,cc=stack.pop()\n                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                    nr,nc=rr+dr,cc+dc\n                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:\n                        seen[nr,nc]=True\n                        stack.append((nr,nc))\n    return cnt\n\ndef side_miss(mask):\n    return int(not mask[0].any())+int(not mask[-1].any())+int(not mask[:,0].any())+int(not mask[:,-1].any())\n\ndef score(mask):\n    other=~mask\n    s=100*side_miss(mask)+100*side_miss(other)+20*(comps(mask)-1)+20*(comps(other)-1)\n    # avoid trivial near-monochrome states\n    s += max(0, 5-int(mask.sum())) + max(0, 5-int(other.sum()))\n    return s\n\nstart_all=time.time()\nfor h,w in sizes:\n    best=10**9; bestm=None\n    print('size',h,w, flush=True)\n    for restart in range(100):\n        m=np.random.rand(h,w)<0.5\n        cur=score(m)\n        T=8.0\n        for it in range(50000):\n            r=random.randrange(h); c=random.randrange(w)\n            cand=m.copy(); cand[r,c]=~cand[r,c]\n            ns=score(cand)\n            if ns <= cur or random.random() < math.exp((cur-ns)/max(T,1e-9)):\n                m,cur=cand,ns\n            if cur < best:\n                best=cur; bestm=m.copy()\n                print(' best',best,'restart',restart,'it',it, flush=True)\n                for row in bestm.astype(int):\n                    print(''.join(map(str,row)), flush=True)\n                print(flush=True)\n                if best==0:\n                    raise SystemExit\n            T*=0.9999\n            if time.time()-start_all > 60:\n                print('timeout', flush=True)\n                raise SystemExit\n    print('done',best, flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
