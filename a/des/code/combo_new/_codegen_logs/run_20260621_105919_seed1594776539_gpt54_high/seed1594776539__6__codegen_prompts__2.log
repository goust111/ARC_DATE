{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\n\ndef cycle(h,w):\n    assert w % 2 == 0\n    path=[]\n    path.extend((r,0) for r in range(h))\n    for c in range(1,w,2):\n        path.extend((r,c) for r in range(h-1,0,-1))\n        if c+1 < w:\n            path.extend((r,c+1) for r in range(1,h))\n    path.extend((0,c) for c in range(w-1,0,-1))\n    assert len(path)==h*w and len(set(path))==h*w\n    return path\n\ndef touches(mask):\n    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()\nfor h,w in [(4,4),(4,6),(5,6),(6,6)]:\n    cyc=cycle(h,w)\n    n=len(cyc)\n    found=False\n    for start in range(n):\n        for L in range(2,n-1):\n            mask=np.zeros((h,w),dtype=bool)\n            for k in range(L):\n                r,c=cyc[(start+k)%n]\n                mask[r,c]=True\n            other=~mask\n            if touches(mask) and touches(other):\n                print('found',h,w,'start',start,'L',L)\n                print(mask.astype(int))\n                found=True\n                raise SystemExit\n    print('none',h,w)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
