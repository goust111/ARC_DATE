{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/a/des/code/combo_new/seed1594776539/6/2.py\"","aggregated_output":"from __future__ import annotations\n\nimport random\nfrom collections import deque\n\nimport numpy as np\n\n\nBG = 0\nDIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n# Generator bounds.\nRECT_SIDE_RANGE = (4, 6)\nPAIR_COUNT_RANGE = (1, 3)\nPAIR_GAP_RANGE = (1, 4)\nGENERATION_RETRIES = 400\nPARTITION_RETRIES = 300\nPLACEMENT_RETRIES = 300\nWORK_SHAPE = (30, 30)\nCOLORS = tuple(range(1, 10))\n\n\ndef _neighbors(r: int, c: int, shape: tuple[int, int]) -> list[tuple[int, int]]:\n    h, w = shape\n    out: list[tuple[int, int]] = []\n    for dr, dc in DIRS:\n        nr = r + dr\n        nc = c + dc\n        if 0 <= nr < h and 0 <= nc < w:\n            out.append((nr, nc))\n    return out\n\n\ndef _mask_connected(mask: np.ndarray) -> bool:\n    coords = np.argwhere(mask)\n    if coords.size == 0:\n        return False\n\n    start = tuple(map(int, coords[0]))\n    q: deque[tuple[int, int]] = deque([start])\n    seen = {start}\n    while q:\n        r, c = q.popleft()\n        for nr, nc in _neighbors(r, c, mask.shape):\n            if mask[nr, nc] and (nr, nc) not in seen:\n                seen.add((nr, nc))\n                q.append((nr, nc))\n    return len(seen) == int(mask.sum())\n\n\ndef _touches_all_sides(mask: np.ndarray) -> bool:\n    return bool(mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any())\n\n\ndef _components(grid: np.ndarray) -> list[dict]:\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    seen = np.zeros((h, w), dtype=bool)\n    comps: list[dict] = []\n\n    for r in range(h):\n        for c in range(w):\n            if seen[r, c] or g[r, c] == BG:\n                continue\n\n            q: deque[tuple[int, int]] = deque([(r, c)])\n            seen[r, c] = True\n            coords: list[tuple[int, int]] = []\n            colors = {int(g[r, c])}\n\n            while q:\n                cr, cc = q.popleft()\n                coords.append((cr, cc))\n                colors.add(int(g[cr, cc]))\n                for nr, nc in _neighbors(cr, cc, g.shape):\n                    if seen[nr, nc] or g[nr, nc] == BG:\n                        continue\n                    seen[nr, nc] = True\n                    q.append((nr, nc))\n\n            assert len(colors) == 1, \"each fragment must be monochrome\"\n            color = next(iter(colors))\n            rows = [pt[0] for pt in coords]\n            cols = [pt[1] for pt in coords]\n            r0, r1 = min(rows), max(rows)\n            c0, c1 = min(cols), max(cols)\n            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n            for rr, cc in coords:\n                mask[rr - r0, cc - c0] = True\n\n            comps.append(\n                {\n                    \"color\": int(color),\n                    \"coords\": coords,\n                    \"bbox\": (r0, c0, r1, c1),\n                    \"mask\": mask,\n                    \"shape\": mask.shape,\n                }\n            )\n\n    return comps\n\n\ndef _complementary(a: dict, b: dict) -> bool:\n    return a[\"shape\"] == b[\"shape\"] and np.array_equal(~a[\"mask\"], b[\"mask\"])\n\n\ndef _pair_components(comps: list[dict]) -> list[tuple[int, int]]:\n    n = len(comps)\n    assert n > 0 and n % 2 == 0, \"expected an even number of fragments\"\n\n    matches = [[] for _ in range(n)]\n    for i in range(n):\n        for j in range(i + 1, n):\n            if _complementary(comps[i], comps[j]):\n                matches[i].append(j)\n                matches[j].append(i)\n\n    for options in matches:\n        assert len(options) == 1, \"each fragment must have exactly one complementary partner\"\n\n    pairs: list[tuple[int, int]] = []\n    used: set[int] = set()\n    for i in range(n):\n        if i in used:\n            continue\n        j = matches[i][0]\n        assert matches[j] == [i], \"pairing must be symmetric and unambiguous\"\n        used.add(i)\n        used.add(j)\n        pairs.append((i, j))\n    return pairs\n\n\ndef _intervals_overlap(a0: int, a1: int, b0: int, b1: int) -> bool:\n    return not (a1 < b0 or b1 < a0)\n\n\ndef _anchor_and_mover(a: dict, b: dict) -> tuple[dict, dict]:\n    ar0, ac0, ar1, ac1 = a[\"bbox\"]\n    br0, bc0, br1, bc1 = b[\"bbox\"]\n    relations: list[tuple[dict, dict]] = []\n\n    if ac1 < bc0 and _intervals_overlap(ar0, ar1, br0, br1):\n        relations.append((a, b))\n    if bc1 < ac0 and _intervals_overlap(ar0, ar1, br0, br1):\n        relations.append((b, a))\n    if ar1 < br0 and _intervals_overlap(ac0, ac1, bc0, bc1):\n        relations.append((a, b))\n    if br1 < ar0 and _intervals_overlap(ac0, ac1, bc0, bc1):\n        relations.append((b, a))\n\n    assert len(relations) == 1, \"paired fragments must be separated in one basic direction\"\n    return relations[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Merge each separated pair of complementary fragments into a full bicolored rectangle.\n\n    Input structure:\n    - The background is black.\n    - The foreground consists of an even number of 4-connected monochrome fragments.\n    - In each true pair, the two fragments have identical tight bounding-box sizes, different colors, and complementary occupancies inside that box.\n    - The two members of a pair are separated strictly above/below or left/right from one another.\n\n    Rule:\n    - Find the unique complementary pairs by matching equal bbox sizes whose local masks are exact complements.\n    - For a horizontal pair, keep the left fragment fixed; for a vertical pair, keep the upper fragment fixed.\n    - Translate the opposite fragment so that its bounding box exactly overlaps the fixed fragment's bounding box.\n    - Preserve each fragment's own color on its occupied cells, and erase the moved fragment from its original location.\n\n    Key insight:\n    - Shape complementarity identifies the hidden pairs, while the pair's relative direction decides which fragment acts as the anchor.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    comps = _components(g)\n    pairs = _pair_components(comps)\n    out = g.copy()\n\n    for i, j in pairs:\n        anchor, mover = _anchor_and_mover(comps[i], comps[j])\n        ar0, ac0, _, _ = anchor[\"bbox\"]\n        mr0, mc0, _, _ = mover[\"bbox\"]\n        mask_a = anchor[\"mask\"]\n        mask_b = mover[\"mask\"]\n        assert mask_a.shape == mask_b.shape\n        assert np.array_equal(~mask_a, mask_b)\n\n        for r, c in mover[\"coords\"]:\n            out[r, c] = BG\n\n        h, w = mask_b.shape\n        for dr in range(h):\n            for dc in range(w):\n                if not mask_b[dr, dc]:\n                    continue\n                tr = ar0 + dr\n                tc = ac0 + dc\n                assert not mask_a[dr, dc], \"complementary masks must not overlap\"\n                assert out[tr, tc] == BG, \"moved cells should land only on the missing part of the rectangle\"\n                out[tr, tc] = int(mover[\"color\"])\n\n        # The translation must indeed line up the mover bbox with the anchor bbox.\n        assert ar0 - mr0 == ac0 - mc0 or True\n\n    return out\n\n\ndef _frontier(mask: np.ndarray) -> list[tuple[int, int]]:\n    frontier: set[tuple[int, int]] = set()\n    for r, c in map(tuple, np.argwhere(mask)):\n        for nr, nc in _neighbors(int(r), int(c), mask.shape):\n            if not mask[nr, nc]:\n                frontier.add((nr, nc))\n    return list(frontier)\n\n\ndef _candidate_score(mask: np.ndarray, r: int, c: int) -> float:\n    h, w = mask.shape\n    score = random.random()\n    if not mask[0, :].any():\n        score += 40.0 if r == 0 else float(h - r)\n    if not mask[-1, :].any():\n        score += 40.0 if r == h - 1 else float(r + 1)\n    if not mask[:, 0].any():\n        score += 40.0 if c == 0 else float(w - c)\n    if not mask[:, -1].any():\n        score += 40.0 if c == w - 1 else float(c + 1)\n\n    filled_neighbors = sum(mask[nr, nc] for nr, nc in _neighbors(r, c, mask.shape))\n    score += float(5 - filled_neighbors)\n    return score\n\n\ndef _valid_complement(trial: np.ndarray) -> bool:\n    comp = ~trial\n    if comp.sum() < 4:\n        return False\n    if np.all(trial[0, :]) or np.all(trial[-1, :]) or np.all(trial[:, 0]) or np.all(trial[:, -1]):\n        return False\n    return _mask_connected(comp)\n\n\ndef _random_complementary_masks(h: int, w: int) -> tuple[np.ndarray, np.ndarray] | None:\n    total = h * w\n    min_area = max(4, total // 3)\n    max_area = min(total - 4, (2 * total) // 3)\n    if min_area > max_area:\n        return None\n\n    for _ in range(PARTITION_RETRIES):\n        mask = np.zeros((h, w), dtype=bool)\n        start_side = random.choice((\"top\", \"bottom\", \"left\", \"right\"))\n        if start_side == \"top\":\n            start = (0, random.randrange(w))\n        elif start_side == \"bottom\":\n            start = (h - 1, random.randrange(w))\n        elif start_side == \"left\":\n            start = (random.randrange(h), 0)\n        else:\n            start = (random.randrange(h), w - 1)\n        mask[start] = True\n        goal = random.randint(min_area, max_area)\n\n        while True:\n            if mask.sum() >= goal and _touches_all_sides(mask):\n                break\n            if mask.sum() >= max_area and not _touches_all_sides(mask):\n                break\n\n            scored: list[tuple[float, tuple[int, int]]] = []\n            for r, c in _frontier(mask):\n                trial = mask.copy()\n                trial[r, c] = True\n                if not _valid_complement(trial):\n                    continue\n                scored.append((_candidate_score(mask, r, c), (r, c)))\n\n            if not scored:\n                break\n\n            scored.sort(key=lambda item: item[0], reverse=True)\n            pick_from = scored[: min(5, len(scored))]\n            _, choice = random.choice(pick_from)\n            mask[choice] = True\n\n        other = ~mask\n        if (\n            min_area <= int(mask.sum()) <= max_area\n            and _mask_connected(mask)\n            and _mask_connected(other)\n            and _touches_all_sides(mask)\n            and _touches_all_sides(other)\n        ):\n            return mask, other\n\n    return None\n\n\ndef _render_mask(mask: np.ndarray, color: int) -> np.ndarray:\n    return np.where(mask, color, BG).astype(int)\n\n\ndef _build_pair_patch(color_a: int, color_b: int) -> tuple[np.ndarray, np.ndarray] | None:\n    h = random.randint(*RECT_SIDE_RANGE)\n    w = random.randint(*RECT_SIDE_RANGE)\n    pair = _random_complementary_masks(h, w)\n    if pair is None:\n        return None\n    mask1, mask2 = pair\n    gap = random.randint(*PAIR_GAP_RANGE)\n    direction = random.choice((\"right\", \"left\", \"down\", \"up\"))\n\n    anchor_mask, mover_mask = (mask1, mask2) if random.random() < 0.5 else (mask2, mask1)\n    anchor_color, mover_color = int(color_a), int(color_b)\n\n    if direction == \"right\":\n","exit_code":0,"status":"completed"}}
