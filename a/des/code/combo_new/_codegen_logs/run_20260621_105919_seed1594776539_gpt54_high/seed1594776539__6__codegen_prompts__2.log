{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, random\nfrom collections import deque\nDIRS=[(-1,0),(1,0),(0,-1),(0,1)]\n\ndef neighbors(r,c,shape):\n    h,w=shape\n    for dr,dc in DIRS:\n        nr,nc=r+dr,c+dc\n        if 0<=nr<h and 0<=nc<w:\n            yield nr,nc\n\ndef connected(mask):\n    pts=np.argwhere(mask)\n    if len(pts)==0: return False\n    start=tuple(map(int,pts[0]))\n    q=deque([start]); seen={start}\n    while q:\n        r,c=q.popleft()\n        for nr,nc in neighbors(r,c,mask.shape):\n            if mask[nr,nc] and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==int(mask.sum())\n\ndef touches(mask):\n    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()\n\ndef frontier(mask):\n    out=set()\n    for r,c in map(tuple,np.argwhere(mask)):\n        for nr,nc in neighbors(int(r),int(c),mask.shape):\n            if not mask[nr,nc]: out.add((nr,nc))\n    return list(out)\n\ndef score(mask,r,c):\n    h,w=mask.shape\n    s=random.random()\n    if not mask[0].any(): s += 40 if r==0 else h-r\n    if not mask[-1].any(): s += 40 if r==h-1 else r+1\n    if not mask[:,0].any(): s += 40 if c==0 else w-c\n    if not mask[:,-1].any(): s += 40 if c==w-1 else c+1\n    filled=sum(mask[nr,nc] for nr,nc in neighbors(r,c,mask.shape))\n    s += 5-filled\n    return s\n\ndef valid_comp(trial):\n    comp=~trial\n    if comp.sum()<4: return False\n    if np.all(trial[0]) or np.all(trial[-1]) or np.all(trial[:,0]) or np.all(trial[:,-1]): return False\n    return connected(comp)\n\ndef find(h,w,tries=5000):\n    total=h*w\n    min_area=max(4,total//3)\n    max_area=min(total-4,(2*total)//3)\n    for _ in range(tries):\n        mask=np.zeros((h,w),dtype=bool)\n        side=random.choice(['top','bottom','left','right'])\n        if side=='top': start=(0,random.randrange(w))\n        elif side=='bottom': start=(h-1,random.randrange(w))\n        elif side=='left': start=(random.randrange(h),0)\n        else: start=(random.randrange(h),w-1)\n        mask[start]=True\n        goal=random.randint(min_area,max_area)\n        while True:\n            if mask.sum() >= goal and touches(mask):\n                break\n            if mask.sum() >= max_area and not touches(mask):\n                break\n            scored=[]\n            for r,c in frontier(mask):\n                trial=mask.copy(); trial[r,c]=True\n                if not valid_comp(trial):\n                    continue\n                scored.append((score(mask,r,c),(r,c)))\n            if not scored:\n                break\n            scored.sort(reverse=True)\n            _,choice=random.choice(scored[:min(5,len(scored))])\n            mask[choice]=True\n        other=~mask\n        if min_area <= int(mask.sum()) <= max_area and connected(mask) and connected(other) and touches(mask) and touches(other):\n            return mask\n    return None\n\nfor h,w in [(4,4),(4,5),(5,5),(5,6),(6,6)]:\n    mask=find(h,w,tries=2000)\n    print('size',h,w,'found',mask is not None)\n    if mask is not None:\n        print(mask.astype(int))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
