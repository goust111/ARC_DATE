{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, random, math, time\n\ndef comps(mask):\n    h,w=mask.shape\n    seen=np.zeros((h,w),dtype=bool)\n    cnt=0\n    for r in range(h):\n        for c in range(w):\n            if seen[r,c] or not mask[r,c]:\n                continue\n            cnt+=1\n            stack=[(r,c)]\n            seen[r,c]=True\n            while stack:\n                rr,cc=stack.pop()\n                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                    nr,nc=rr+dr,cc+dc\n                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:\n                        seen[nr,nc]=True; stack.append((nr,nc))\n    return cnt\n\ndef miss(mask):\n    return int(not mask[0].any())+int(not mask[-1].any())+int(not mask[:,0].any())+int(not mask[:,-1].any())\n\ndef score(mask):\n    other=~mask\n    s=10*(comps(mask)-1)+10*(comps(other)-1)+5*miss(mask)+5*miss(other)\n    if mask.sum()==0 or other.sum()==0: s+=100\n    return s\n\nfor h,w in [(5,5),(5,6),(6,6),(6,7)]:\n    best=None\n    bestm=None\n    for restart in range(50):\n        m=np.random.rand(h,w)<0.5\n        t=5.0\n        cur=score(m)\n        for it in range(20000):\n            r=random.randrange(h); c=random.randrange(w)\n            m[r,c]=~m[r,c]\n            ns=score(m)\n            if ns <= cur or random.random() < math.exp((cur-ns)/max(t,1e-6)):\n                cur=ns\n            else:\n                m[r,c]=~m[r,c]\n            t*=0.9997\n            if cur==0:\n                print('found',h,w,'restart',restart,'iter',it)\n                print(m.astype(int))\n                raise SystemExit\n            if best is None or cur<best:\n                best=cur; bestm=m.copy()\n        # print interim\n    print('no exact',h,w,'best',best)\n    print(bestm.astype(int))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
