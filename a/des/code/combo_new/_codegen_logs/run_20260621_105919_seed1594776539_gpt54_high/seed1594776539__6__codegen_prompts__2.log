{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, random, math, time, sys\nh=w=8\n\ndef comps(mask):\n    h,w=mask.shape\n    seen=np.zeros((h,w),dtype=bool)\n    cnt=0\n    for r in range(h):\n        for c in range(w):\n            if seen[r,c] or not mask[r,c]: continue\n            cnt+=1\n            stack=[(r,c)]\n            seen[r,c]=True\n            while stack:\n                rr,cc=stack.pop()\n                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                    nr,nc=rr+dr,cc+dc\n                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:\n                        seen[nr,nc]=True\n                        stack.append((nr,nc))\n    return cnt\n\ndef side_miss(mask):\n    return int(not mask[0].any())+int(not mask[-1].any())+int(not mask[:,0].any())+int(not mask[:,-1].any())\n\ndef score(mask):\n    other=~mask\n    return 100*side_miss(mask)+100*side_miss(other)+20*(comps(mask)-1)+20*(comps(other)-1)\n\nbest=10**9; bestm=None\nstart=time.time()\nfor restart in range(300):\n    m=np.random.rand(h,w)<0.5\n    cur=score(m)\n    T=10.0\n    for it in range(100000):\n        r=random.randrange(h); c=random.randrange(w)\n        cand=m.copy(); cand[r,c]=~cand[r,c]\n        ns=score(cand)\n        if ns <= cur or random.random() < math.exp((cur-ns)/max(T,1e-9)):\n            m,cur=cand,ns\n        if cur < best:\n            best=cur; bestm=m.copy()\n            print('best',best,'restart',restart,'it',it, flush=True)\n            for row in bestm.astype(int): print(''.join(map(str,row)), flush=True)\n            print(flush=True)\n            if best==0:\n                raise SystemExit\n        T*=0.99995\n        if time.time()-start > 60:\n            print('timeout', flush=True)\n            for row in bestm.astype(int): print(''.join(map(str,row)), flush=True)\n            raise SystemExit\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools, numpy as np\n\ndef conn(mask):\n    pts=np.argwhere(mask)\n    if len(pts)==0: return False\n    seen={tuple(pts[0])}; stack=[tuple(pts[0])]\n    h,w=mask.shape\n    while stack:\n        r,c=stack.pop()\n        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:\n                seen.add((nr,nc)); stack.append((nr,nc))\n    return len(seen)==int(mask.sum())\n\ndef fullbbox(mask):\n    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()\nfor h,w in [(5,5),(5,6),(6,6),(6,7),(7,7)]:\n    found=False\n    for ks in itertools.product(range(h+1), repeat=w):\n        mask=np.zeros((h,w),dtype=bool)\n        for c,k in enumerate(ks):\n            mask[:k,c]=True\n        other=~mask\n        if conn(mask) and conn(other) and fullbbox(mask) and fullbbox(other):\n            print('found',h,w,ks)\n            print(mask.astype(int))\n            found=True\n            raise SystemExit\n    print('none',h,w)\nPY\"","aggregated_output":"none 5 5\nnone 5 6\nnone 6 6\nnone 6 7\nnone 7 7\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, random, math, time\n\ndef comps(mask):\n    h,w=mask.shape\n    seen=np.zeros((h,w),dtype=bool)\n    cnt=0\n    for r in range(h):\n        for c in range(w):\n            if seen[r,c] or not mask[r,c]: continue\n            cnt+=1\n            stack=[(r,c)]; seen[r,c]=True\n            while stack:\n                rr,cc=stack.pop()\n                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                    nr,nc=rr+dr,cc+dc\n                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:\n                        seen[nr,nc]=True; stack.append((nr,nc))\n    return cnt\n\ndef full(mask):\n    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()\n\ndef score(mask):\n    other=~mask\n    return 100*(0 if full(mask) else 1)+100*(0 if full(other) else 1)+20*(comps(mask)-1)+20*(comps(other)-1)\n\nfor h,w in [(6,6),(6,7),(7,7),(7,8)]:\n    best=10**9; bestA=None\n    start=time.time()\n    for restart in range(100):\n        A=np.random.rand(h,w) < 0.5\n        cur=A.copy(); cur_s=score(cur); T=5.0\n        for it in range(10000):\n            r=random.randrange(h); c=random.randrange(w)\n            cand=cur.copy(); cand[r,c]=~cand[r,c]\n            ns=score(cand)\n            if ns <= cur_s or random.random() < math.exp((cur_s-ns)/max(T,1e-9)):\n                cur,cur_s=cand,ns\n            if cur_s < best:\n                best,bestA=cur_s,cur.copy()\n                print('size',h,w,'best',best,'restart',restart,'it',it)\n                for row in bestA.astype(int): print(''.join(map(str,row)))\n                print()\n                if best==0:\n                    raise SystemExit\n            T*=0.9997\n    print('done size',h,w,'best',best,'time',time.time()-start)\nPY\"","aggregated_output":"size 6 6 best 260 restart 0 it 0\n111111\n111110\n011001\n111100\n110111\n001010\n\ns