{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom z3 import *\n\ndef solve(h,w,max_solutions=5):\n    N=h*w\n    x=[[Bool(f'x_{r}_{c}') for c in range(w)] for r in range(h)]\n    rootA=[[Bool(f'ra_{r}_{c}') for c in range(w)] for r in range(h)]\n    rootB=[[Bool(f'rb_{r}_{c}') for c in range(w)] for r in range(h)]\n    rankA=[[Int(f'a_{r}_{c}') for c in range(w)] for r in range(h)]\n    rankB=[[Int(f'b_{r}_{c}') for c in range(w)] for r in range(h)]\n    s=Solver()\n    dirs=[(-1,0),(1,0),(0,-1),(0,1)]\n    cells=[(r,c) for r in range(h) for c in range(w)]\n\n    s.add(Sum([If(x[r][c],1,0) for r,c in cells]) >= 2)\n    s.add(Sum([If(x[r][c],1,0) for r,c in cells]) <= N-2)\n\n    for arr, val in [(rootA, True), (rootB, False)]:\n        s.add(PbEq([(arr[r][c],1) for r,c in cells],1))\n        for r,c in cells:\n            s.add(Implies(arr[r][c], x[r][c] == val))\n\n    for r,c in cells:\n        s.add(If(x[r][c], And(rankA[r][c] >= 1, rankA[r][c] <= N), rankA[r][c] == 0))\n        s.add(If(Not(x[r][c]), And(rankB[r][c] >= 1, rankB[r][c] <= N), rankB[r][c] == 0))\n        s.add(Implies(rootA[r][c], rankA[r][c] == 1))\n        s.add(Implies(rootB[r][c], rankB[r][c] == 1))\n\n        na=[]\n        nb=[]\n        for dr,dc in dirs:\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w:\n                na.append(And(x[nr][nc], rankA[nr][nc] < rankA[r][c]))\n                nb.append(And(Not(x[nr][nc]), rankB[nr][nc] < rankB[r][c]))\n        s.add(Implies(And(x[r][c], Not(rootA[r][c])), Or(*na)))\n        s.add(Implies(And(Not(x[r][c]), Not(rootB[r][c])), Or(*nb)))\n\n    for row in [0,h-1]:\n        s.add(Or(*[x[row][c] for c in range(w)]))\n        s.add(Or(*[Not(x[row][c]) for c in range(w)]))\n    for col in [0,w-1]:\n        s.add(Or(*[x[r][col] for r in range(h)]))\n        s.add(Or(*[Not(x[r][col]) for r in range(h)]))\n\n    sols=[]\n    while len(sols) < max_solutions and s.check()==sat:\n        m=s.model()\n        grid=[[1 if is_true(m.evaluate(x[r][c])) else 0 for c in range(w)] for r in range(h)]\n        sols.append(grid)\n        block=[]\n        for r,c in cells:\n            lit=x[r][c]\n            block.append(lit if not is_true(m.evaluate(lit)) else Not(lit))\n        s.add(Or(*block))\n    return sols\n\nfor h,w in [(4,4),(5,5),(5,6),(6,6),(6,7)]:\n    sols=solve(h,w,3)\n    print('size',h,w,'count',len(sols))\n    for g in sols[:2]:\n        for row in g:\n            print(''.join(map(str,row)))\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
