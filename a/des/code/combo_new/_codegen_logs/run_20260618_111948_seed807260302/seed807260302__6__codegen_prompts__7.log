{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\n\ndef erode(mask):\n    p=np.pad(mask,1,constant_values=False)\n    out=np.ones_like(mask,dtype=bool)\n    for dr in range(3):\n        for dc in range(3):\n            out &= p[dr:dr+mask.shape[0], dc:dc+mask.shape[1]]\n    return out\n\ndef dilate_once(mask):\n    h,w=mask.shape\n    out=np.zeros((h+2,w+2),bool)\n    for r,c in np.argwhere(mask):\n        out[r:r+3,c:c+3]=True\n    return out\n\ndef dilate(mask,r):\n    out=mask.copy()\n    for _ in range(r): out=dilate_once(out)\n    return out\n\ndef comps(mask):\n    pts=np.argwhere(mask); seen=set(); n=0\n    s=set(map(tuple,pts.tolist()))\n    for p in list(s):\n        if p in seen: continue\n        n+=1; stack=[p]; seen.add(p)\n        while stack:\n            rr,cc=stack.pop()\n            for nb in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):\n                if nb in s and nb not in seen:\n                    seen.add(nb); stack.append(nb)\n    return n\n\nfor h,w in [(7,7),(9,9),(11,13)]:\n  core=np.zeros((h,w),bool); core[0,:]=core[-1,:]=core[:,0]=core[:,-1]=1\n  for r in [1,2]:\n    d=dilate(core,r)\n    cur=d.copy(); steps=0\n    while True:\n      nxt=erode(cur)\n      print('hwr',h,w,r,'step',steps,'shape',cur.shape,'sum',cur.sum(),'nxtsum',nxt.sum(),'ncomps', comps(nxt) if nxt.any() else 0)\n      if not nxt.any() or comps(nxt)>1: break\n      cur=nxt; steps+=1\n    # crop cur\n    coords=np.argwhere(cur); r0,c0=coords.min(0); r1,c1=coords.max(0)\n    crop=cur[r0:r1+1,c0:c1+1]\n    print('stop crop shape', crop.shape, 'sum', crop.sum(), 'equals original?', crop.shape==core.shape and np.array_equal(crop,core))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
