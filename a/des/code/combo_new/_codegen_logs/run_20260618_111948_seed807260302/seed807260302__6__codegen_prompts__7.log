{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\n\ndef draw_path(mask, pts):\n for (r0,c0),(r1,c1) in zip(pts, pts[1:]):\n  if r0==r1:\n   for c in range(min(c0,c1),max(c0,c1)+1): mask[r0,c]=1\n  elif c0==c1:\n   for r in range(min(r0,r1),max(r0,r1)+1): mask[r,c0]=1\n  else: raise ValueError\n\ndef chamfer(h,w,k):\n pts=[]\n # trace with Manhattan stair chamfers, k >=1\n pts.append((0,k)); pts.append((0,w-k-1))\n for i in range(k):\n  pts.append((i,w-k+i)); pts.append((i+1,w-k+i))\n pts.append((h-k-1,w-1))\n for i in range(k):\n  pts.append((h-k+i,w-1-i)); pts.append((h-k+i,w-2-i))\n pts.append((h-1,k))\n for i in range(k):\n  pts.append((h-1-i,k-1-i)); pts.append((h-2-i,k-1-i))\n pts.append((k,0))\n for i in range(k):\n  pts.append((k-1-i,i)); pts.append((k-1-i,i+1))\n pts.append((0,k))\n mask=np.zeros((h,w),bool); draw_path(mask,pts); return mask\n\ndef erode(mask):\n p=np.pad(mask,1,constant_values=False); out=np.ones_like(mask,bool)\n for dr in range(3):\n  for dc in range(3): out &= p[dr:dr+mask.shape[0],dc:dc+mask.shape[1]]\n return out\n\ndef dilate_once(mask):\n h,w=mask.shape; out=np.zeros((h+2,w+2),bool)\n for r,c in np.argwhere(mask): out[r:r+3,c:c+3]=1\n return out\n\ndef dilate(mask,r):\n out=mask.copy()\n for _ in range(r): out=dilate_once(out)\n return out\n\ndef compn(mask):\n s=set(map(tuple,np.argwhere(mask).tolist())); seen=set(); n=0\n for p in list(s):\n  if p in seen: continue\n  n+=1; st=[p]; seen.add(p)\n  while st:\n   rr,cc=st.pop()\n   for nb in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):\n    if nb in s and nb not in seen: seen.add(nb); st.append(nb)\n return n\nfor h,w,k in [(9,11,1),(11,13,2),(13,13,2)]:\n core=chamfer(h,w,k)\n print('core',h,w,k,'comp',compn(core),'sum',core.sum())\n for r in [1,2]:\n  cur=dilate(core,r); steps=0\n  while True:\n   nxt=erode(cur)\n   if not nxt.any() or compn(nxt)>1: break\n   cur=nxt; steps+=1\n  coords=np.argwhere(cur); r0,c0=coords.min(0); r1,c1=coords.max(0); crop=cur[r0:r1+1,c0:c1+1]\n  print(' r',r,'stop steps',steps,'shape',crop.shape,'sum',crop.sum(),'same',crop.shape==core.shape and np.array_equal(crop,core),'next comp',compn(erode(cur)) if erode(cur).any() else 0)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
