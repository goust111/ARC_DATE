{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py | sed -n '1,220p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py | sed -n '1,220p'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Predict the next panel in a framed sequence by continuing each scheduled colored interval.\n\n    Input structure\n    - The grid is made from three or more equal panels in one row or one column.\n    - The final input panel is the static target template; every earlier panel differs from it only by dynamic colors absent from the template.\n    - Each dynamic color appears in a regular temporal schedule across the earlier panels.\n\n    Rule\n    - Keep the final template panel as the output canvas.\n    - For every dynamic color whose schedule reaches the next panel, compare its last two appearances.\n    - Extrapolate each one-dimensional interval along the color's changing row or column axis and paint that predicted mask.\n\n    Key insight\n    - The task is not asking for the last visible panel, but for the next frame after the blank/template slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    panels, diff_colors = _split_panels(g)\n    template = panels[-1]\n    prior = panels[:-1]\n    next_time = len(prior)\n\n    predictions: list[tuple[int, np.ndarray]] = []\n    for color in diff_colors:\n        times = [i for i, panel in enumerate(prior) if np.any(panel == color)]\n        assert len(times) >= 2\n        gaps = [b - a for a, b in zip(times, times[1:])]\n        assert len(set(gaps)) == 1\n        period = gaps[0]\n        if next_time - times[-1] != period:\n            continue\n\n        previous = prior[times[-2]] == color\n        current = prior[times[-1]] == color\n        predictions.append((color, _extrapolate_mask(previous, current)))\n\n    assert predictions\n    occupied = np.zeros_like(template, dtype=bool)\n    for _color, mask in predictions:\n        assert not np.any(occupied & mask)\n        occupied |= mask\n\n    out = template.copy()\n    for color, mask in predictions:\n        out[mask] = color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, orientation, and color sampling.\nPANEL_SIZE_MIN, PANEL_SIZE_MAX = 5, 11\nPANEL_COUNT_CHOICES, ORIENTATION_CHOICES = (3, 5), (False, True)\nCOLOR_POOL, TOTAL_COLOR_CHOICES, MOTION_AXIS_CHOICES = range(10), (4, 5), (0, 1)\n\n# Template decoration density and symmetry.\nTEMPLATE_MIN_DECO_CELLS = 4\nTEMPLATE_DECO_MIN_RATIO, TEMPLATE_DECO_MAX_RATIO = 0.10, 0.30\n\n# Blob motif and growth bounds.\nBLOB_GROWTH_MIN, BLOB_GROWTH_MAX = 1, 4\nBLOB_MAX_INITIAL_CELLS, BLOB_MAX_COMPONENTS = 7, 2\nBLOB_MAX_LINE_COUNT, BLOB_MAX_WIDTH = 3, 3\nBLOB_DIRECTIONS = (-1, 1)\n\n# Dynamic-color schedules.\nSHORT_PRIOR_COUNT, MAX_DYNAMIC_COLORS = 2, 3\nSCHEDULE_ALWAYS_2 = {\"period\": 1, \"times\": [0, 1], \"scheduled\": True}\nSCHEDULE_ALWAYS_4 = {\"period\": 1, \"times\": [0, 1, 2, 3], \"scheduled\": True}\nSCHEDULE_EVEN_4 = {\"period\": 2, \"times\": [0, 2], \"scheduled\": True}\nSCHEDULE_FIRST3_4 = {\"period\": 1, \"times\": [0, 1, 2], \"scheduled\": False}\nSCHEDULE_ODD_4 = {\"period\": 2, \"times\": [1, 3], \"scheduled\": False}\nSCHEDULE_SECOND_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4)\nSCHEDULE_THIRD_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4, SCHEDULE_FIRST3_4, SCHEDULE_ODD_4)\n\n# Placement and retry limits.\nMASK_TRANSPARENT, PLACEMENT_BORDER = 0, 1\nGENERATION_RETRIES = 300\n\ndef _sym_orbits(h: int, w: int) -> list[list[tuple[int, int]]]:\n    seen: set[tuple[int, int]] = set()\n    orbits: list[list[tuple[int, int]]] = []\n    for r in range(h):\n        for c in range(w):\n            if r not in (0, h - 1) and c not in (0, w - 1):\n                continue\n            if (r, c) in seen:\n                continue\n            orbit = sorted({(r, c), (r, w - 1 - c), (h - 1 - r, c), (h - 1 - r, w - 1 - c)})\n            seen.update(orbit)\n            orbits.append(orbit)\n    return orbits\n\n\ndef _make_template(h: int, w: int, bg: int, deco: int) -> np.ndarray:\n    out = np.full((h, w), bg, dtype=int)\n    area = h * w\n    min_deco = max(TEMPLATE_MIN_DECO_CELLS, int(np.ceil(area * TEMPLATE_DECO_MIN_RATIO)))\n    max_deco = max(min_deco, int(np.floor(area * TEMPLATE_DECO_MAX_RATIO)))\n    target = random.randint(min_deco, max_deco)\n    orbits = _sym_orbits(h, w)\n    random.shuffle(orbits)\n    count = 0\n    for orbit in orbits:\n        if count >= target:\n            break\n        if count + len(orbit) > max_deco and count >= min_deco:\n            continue\n        for r, c in orbit:\n            out[r, c] = deco\n        count += len(orbit)\n    return out\n\n\ndef _base_patterns(axis_len: int, line_len: int, max_back: int) -> list[tuple[int, list[list[tuple[int, int]]]]]:\n    patterns: list[tuple[int, list[list[tuple[int, int]]]]] = []\n    for growth in range(BLOB_GROWTH_MIN, BLOB_GROWTH_MAX + 1):\n        extra = max_back * growth\n        max_initial_width = axis_len - extra\n        if max_initial_width < 1:\n            continue\n\n        for lines in range(1, min(BLOB_MAX_LINE_COUNT, line_len) + 1):\n            for width in range(1, min(BLOB_MAX_WIDTH, max_initial_width, BLOB_MAX_INITIAL_CELLS // lines) + 1):\n                patterns.append((growth, [[(0, width - 1)] for _ in range(lines)]))\n\n        if line_len >= 2 and max_initial_width >= 2:\n            for lines in range(2, min(BLOB_MAX_LINE_COUNT + 1, line_len) + 1):\n                width = min(2, max_initial_width)\n                if lines * width <= BLOB_MAX_INITIAL_CELLS and width + 1 + extra <= axis_len:\n                    patterns.append((growth, [[(i % 2, i % 2 + width - 1)] for i in range(lines)]))\n\n        if line_len >= 3 and max_initial_width >= 3:\n            tee = [[(1, 1)], [(0, 2)], [(1, 1)]]\n            if 3 + extra <= axis_len:\n                patterns.append((growth, tee))\n\n        if line_len >= 2:\n            gap = extra + 1\n            if gap + 2 + extra <= axis_len:\n                for lines in range(2, min(BLOB_MAX_LINE_COUNT, line_len) + 1):\n                    split = [[(0, 0), (gap + 1, gap + 1)] for _ in range(lines)]\n                    if 2 * lines <= BLOB_MAX_INITIAL_CELLS:\n                        patterns.append((growth, split))\n    return patterns\n\n\ndef _draw_local(\n    intervals0: list[list[tuple[int, int]]],\n    growth: int,\n    max_back: int,\n    back: int,\n    direction: int,\n    axis: int,\n) -> np.ndarray:\n    grown = max_back - back\n    width = max(end for row in intervals0 for _start, end in row) + max_back * growth + 1\n    local = np.zeros((len(intervals0), width), dtype=bool)\n    for r, row in enumerate(intervals0):\n        for start, end in row:\n            local[r, start : end + grown * growth + 1] = True\n    if direction < 0:\n        local = np.fliplr(local)\n    if axis == 0:\n        local = local.T\n    return local\n\n\ndef _make_blob(axis_len: int, line_len: int, axis: int, max_back: int) -> tuple[int, dict[int, np.ndarray]] | None:\n    patterns = _base_patterns(axis_len, line_len, max_back)\n    if not patterns:\n        return None\n    by_growth: dict[int, list[list[list[tuple[int, int]]]]] = {}\n    for growth, intervals0 in patterns:\n        by_growth.setdefault(growth, []).append(intervals0)\n    growth = random.choice(sorted(by_growth))\n    intervals0 = random.choice(by_growth[growth])\n    direction = random.choice(BLOB_DIRECTIONS)\n    masks = {\n        back: _draw_local(intervals0, growth, max_back, back, direction, axis)\n        for back in range(max_back + 1)\n    }\n    largest = masks[0]\n    if largest.shape[0] > (line_len if axis == 1 else axis_len):\n        return None\n    if largest.shape[1] > (axis_len if axis == 1 else line_len):\n        return None\n    if len(components_mask(masks[max_back], connectivity=4)) > BLOB_MAX_COMPONENTS:\n        return None\n    return growth, masks\n\n\ndef _schedules(n_prior: int, n_colors: int) -> list[dict]:\n    if n_prior == SHORT_PRIOR_COUNT:\n        return [SCHEDULE_ALWAYS_2 for _ in range(n_colors)]\n\n    schedules = [SCHEDULE_ALWAYS_4, random.choice(SCHEDULE_SECOND_CHOICES)]\n    if n_colors == MAX_DYNAMIC_COLORS:\n        schedules.append(random.choice(SCHEDULE_THIRD_CHOICES))\n    return schedules\n\n\ndef _place_masks(\n    occupied: np.ndarray,\n    local_masks: dict[int, np.ndarray],\n) -> dict[int, np.ndarray] | None:\n    largest = local_masks[0]\n    patch = np.where(largest, 1, MASK_TRANSPARENT)\n    try:\n        r0, c0 = random_free_location(\n            occupied, patch, transparent=MASK_TRANSPARENT, border=PLACEMENT_BORDER\n        )\n    except ValueError:\n        return None\n    paste(occupied, patch, r0, c0, transparent=MASK_TRANSPARENT)\n\n    out: dict[int, np.ndarray] = {}\n    for back, local in local_masks.items():\n        full = np.zeros_like(occupied, dtype=bool)\n        full[r0 : r0 + local.shape[0], c0 : c0 + local.shape[1]] = local\n        out[back] = full\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py | sed -n '1,220p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py | sed -n '1,220p'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n    h, w = canvas_mask.shape\n    sr, sc = seed\n    if not canvas_mask[sr, sc]:\n        return None\n    blob = {(sr, sc)}\n    frontier = []\n    def push_neighbors(r, c):\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:\n                frontier.append((nr, nc))\n    push_neighbors(sr, sc)\n    while len(blob) < target_size and frontier:\n        idx = rng.randrange(len(frontier))\n        r, c = frontier.pop(idx)\n        if (r, c) in blob or not canvas_mask[r, c]:\n            continue\n        blob.add((r, c))\n        push_neighbors(r, c)\n    if len(blob) < target_size:\n        return None\n    return blob\n\n\ndef _blob_wall_cells(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n    wall = set()\n    for r, c in blob:\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in blob:\n                wall.add((nr, nc))\n    return wall\n\n\ndef _fill_holes(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Return blob with interior holes absorbed.\n\n    Barrier = blob union its wall ring. Any non-barrier cell unreachable from the grid\n    border through non-barrier cells is trapped and gets absorbed into the blob.\n    \"\"\"\n    walls = _blob_wall_cells(blob, h, w)\n    barrier = np.zeros((h, w), dtype=bool)\n    for r, c in blob:\n        barrier[r, c] = True\n    for r, c in walls:\n        barrier[r, c] = True\n\n    # Flood-fill from border through non-barrier cells.\n    reachable = np.zeros((h, w), dtype=bool)\n    stack = []\n    for r in range(h):\n        for c in (0, w - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    for c in range(w):\n        for r in (0, h - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    while stack:\n        r, c = stack.pop()\n        if reachable[r, c] or barrier[r, c]:\n            continue\n        reachable[r, c] = True\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and not reachable[nr, nc] and not barrier[nr, nc]:\n                stack.append((nr, nc))\n\n    trapped = (~reachable) & (~barrier)\n    if not trapped.any():\n        return blob\n    filled = set(blob)\n    for r, c in np.argwhere(trapped):\n        filled.add((int(r), int(c)))\n    return filled\n\n\n# ── Slide helpers ─────────────────────────────────────────────────\n\ndef _slide_step_valid(region_set: set, r: int, c: int, dr: int, dc: int) -> bool:\n    nr, nc = r + dr, c + dc\n    if (nr, nc) not in region_set:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py | sed -n '1,220p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py | sed -n '1,220p'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n\n    Input structure:\n    - Black background with several axis-aligned colored line drawings.\n    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n\n    Rule:\n    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n    - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n    - The color with no enclosed region is the noise/pad color.\n    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n\n    Key insight:\n    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg == 0\n\n    counts: list[tuple[int, int, np.ndarray]] = []\n    for color in colors_present(g, exclude={bg}):\n        rooms = _room_count_for_color(g, int(color))\n        walls = _walls_for_color(g, int(color))\n        counts.append((int(color), int(rooms), walls))\n\n    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n    assert drawings\n    assert len(pad_colors) == 1\n\n    pad = int(pad_colors[0])\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n        group = [item for item in drawings if item[1] == rooms]\n        ordered.extend(_cover_order(g, group))\n\n    width = max(rooms for _color, rooms, _walls in ordered)\n\n    out = np.full((len(ordered), width), pad, dtype=int)\n    for r, (color, rooms, _walls) in enumerate(ordered):\n        out[r, :rooms] = int(color)\n    return out\n\n# --------------- generator (claude-opus-4-6) ---------------\n\n# ---- CFG: Tunable generation parameters ----\n_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n    5: (25, 30, 25, 30, 16, 18),\n    4: (22, 30, 22, 30, 18, 22),\n    3: (20, 30, 20, 30, 22, 25),\n}\n_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n_OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n_GEN_RETRIES = 300                   # outer retry limit\n\n\ndef _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n    \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n    if n * min_gap > max_total:\n        return None\n    gaps = [min_gap] * n\n    remaining = max_total - sum(gaps)\n    for i in range(n):\n        extra = min(max_gap - gaps[i], remaining)\n        if extra > 0:\n            add = random.randint(0, extra)\n            gaps[i] += add\n            remaining -= add\n    random.shuffle(gaps)\n    return gaps\n\n\ndef _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n    \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n    if target_rooms == 1:\n        gap_h = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_h - 2))\n        gap_w = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_w - 2))\n        h, w = gap_h + 2, gap_w + 2\n        walls = np.zeros((h, w), dtype=bool)\n        walls[0, :] = True\n        walls[h - 1, :] = True\n        walls[:, 0] = True\n        walls[:, w - 1] = True\n        return walls\n\n    # For target_rooms >= 2: grid of cells, then selectively merge\n    possible_configs = []\n    for nv in range(2, 6):\n        for nh in range(2, 5):\n            cells = (nv - 1) * (nh - 1)\n            if target_rooms <= cells <= target_rooms + 4:\n                possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        for nv in range(2, 7):\n            for nh in range(2, 6):\n                cells = (nv - 1) * (nh - 1)\n                if cells >= target_rooms:\n                    possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        return None\n\n    n_vcols, n_hrows, total_cells = random.choice(possible_configs)\n    n_row_gaps = n_hrows - 1\n    n_col_gaps = n_vcols - 1\n    min_gap, max_gap = _CELL_GAP_RANGE\n\n    if min_gap * n_row_gaps > max_h - 1 or min_gap * n_col_gaps > max_w - 1:\n        return None\n\n    row_gaps = _random_gaps(n_row_gaps, min_gap, max_gap, max_h - 1)\n    col_gaps = _random_gaps(n_col_gaps, min_gap, max_gap, max_w - 1)\n    if row_gaps is None or col_gaps is None:\n        return None\n\n    # Compute line positions from cumulative gaps\n    vcol_positions = [0]\n    for gap in col_gaps:\n        vcol_positions.append(vcol_positions[-1] + gap)\n    hrow_positions = [0]\n    for gap in row_gaps:\n        hrow_positions.append(hrow_positions[-1] + gap)\n\n    frame_h = hrow_positions[-1] + 1\n    frame_w = vcol_positions[-1] + 1\n    walls = np.zeros((frame_h, frame_w), dtype=bool)\n    for r in hrow_positions:\n        walls[r, :] = True\n    for c in vcol_positions:\n        walls[:, c] = True\n\n    cells_to_merge = total_cells - target_rooms\n    if cells_to_merge == 0:\n        return walls\n\n    # Union-find to merge adjacent cells by removing internal wall segments\n    parent = list(range(total_cells))\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(x, y):\n        px, py = find(x), find(y)\n        if px == py:\n            return False\n        parent[px] = py\n        return True\n\n    def cell_id(cr, cc):\n        return cr * (n_vcols - 1) + cc\n\n    # Enumerate internal wall segments (between adjacent cells)\n    internal_segments = []\n    for hi in range(1, n_hrows - 1):\n        r = hrow_positions[hi]\n        for ci in range(n_vcols - 1):\n            c0, c1 = vcol_positions[ci], vcol_positions[ci + 1]\n            internal_segments.append(('h', r, c0, c1, cell_id(hi - 1, ci), cell_id(hi, ci)))\n    for ci in range(1, n_vcols - 1):\n        c = vcol_positions[ci]\n        for hi in range(n_hrows - 1):\n            r0, r1 = hrow_positions[hi], hrow_positions[hi + 1]\n            internal_segments.append(('v', c, r0, r1, cell_id(hi, ci - 1), cell_id(hi, ci)))\n\n    random.shuffle(internal_segments)\n    merged = 0\n    for seg in internal_segments:\n        if merged >= cells_to_merge:\n            break\n        if seg[0] == 'h':\n            _, r, c0, c1, ca, cb = seg\n            if find(ca) != find(cb):\n                union(ca, cb)\n                walls[r, c0 + 1:c1] = False\n                merged += 1\n        else:\n            _, c, r0, r1, ca, cb = seg\n            if find(ca) != find(cb):\n                union(ca, cb)\n                walls[r0 + 1:r1, c] = False\n                merged += 1\n\n    if merged < cells_to_merge:\n        return None\n    if _count_enclosed_regions(walls) != target_rooms:\n        return None\n    return walls\n\n\ndef _force_overlap(positions, i, j, frames, grid_h, grid_w):\n    \"\"\"Try to reposition frame j so it overlaps frame i. Modifies positions in place.\"\"\"\n    fi_h, fi_w = frames[i][2].shape\n    fj_h, fj_w = frames[j][2].shape\n    ri, ci = positions[i]\n    r0_min = max(0, ri - fj_h + 2)\n    r0_max = min(grid_h - fj_h, ri + fi_h - 2)\n    c0_min = max(0, ci - fj_w + 2)\n    c0_max = min(grid_w - fj_w, ci + fi_w - 2)\n    if r0_min > r0_max or c0_min > c0_max:\n        return\n    for _ in range(_OVERLAP_RETRY):\n        rj = random.randint(r0_min, r0_max)\n        cj = random.randint(c0_min, c0_max)\n        # Verify bbox overlap\n        if (max(ri, rj) <= min(ri + fi_h - 1, rj + fj_h - 1) and\n                max(ci, cj) <= min(ci + fi_w - 1, cj + fj_w - 1)):\n            positions[j] = (rj, cj)\n            return\n\n","exit_code":0,"status":"completed"}}
