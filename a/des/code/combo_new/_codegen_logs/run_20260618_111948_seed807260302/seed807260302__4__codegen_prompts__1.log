{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/aa62e3f4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace the outlined object with the outside contour of that outline in the marker color.\n\n    Input structure:\n    - A dominant background surrounds one 8-connected foreground outline.\n    - The outline is the unique largest foreground color.\n    - One or more smaller interior colors are inside the outline; the marker color\n      is the unique smallest non-outline color.\n\n    Rule:\n    - Erase all original foreground pixels to background.\n    - Paint every background pixel that is 4-adjacent to the outline with the\n      marker color.\n    - Keep the grid shape unchanged.\n\n    Key insight: The colored interior marker supplies the paint color, while the\n    largest outline supplies only the contour whose outside edge is traced.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    counts = Counter(map(int, g.flatten()))\n    foreground_colors = [color for color in counts if color != bg]\n    assert len(foreground_colors) >= 2, \"expected an outline color and a marker color\"\n\n    frame_count = max(counts[color] for color in foreground_colors)\n    frame_color = _unique_color_with_count(counts, foreground_colors, frame_count)\n    assert len(components_mask(g == frame_color, connectivity=8)) == 1, \"outline must be 8-connected\"\n\n    marker_candidates = [color for color in foreground_colors if color != frame_color]\n    marker_count = min(counts[color] for color in marker_candidates)\n    marker_color = _unique_color_with_count(counts, marker_candidates, marker_count)\n\n    out = np.full_like(g, bg)\n    contour: set[tuple[int, int]] = set()\n    for r, c in np.argwhere(g == frame_color):\n        for nr, nc in neighbors4(int(r), int(c)):\n            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] == bg:\n                contour.add((int(nr), int(nc)))\n    assert contour, \"expected outline to touch background contour cells\"\n\n    for r, c in contour:\n        out[r, c] = marker_color\n    return out\n\n# --------------- generator (att2) ---------------\n\nGRID_MIN, GRID_MAX = 5, 16\nN_COLORS = 10\n\nSHAPE_MIN_HEIGHT, SHAPE_MAX_HEIGHT = 5, 7\nSHAPE_MIN_WIDTH, SHAPE_MAX_WIDTH = 3, 5\nSTART_WIDTH_MIN, START_WIDTH_MAX = 1, 2\nMAX_LOCAL_WIDTH = 5\n\nMARKER_MIN_CELLS, MARKER_MAX_CELLS = 1, 3\n\nGEN_ATTEMPTS = 300\n\nEDGE_TOUCH_TOP_BOTTOM = \"TB\"\nCORNER_EDGE_PAIRS = [\"TL\", \"TR\", \"BL\", \"BR\"]\nZERO_DELTA_SHIFTS = [-1, 0, 0, 0, 1]\n\n\ndef _gen_grow_parts(total, n):\n    n_twos = total - n\n    parts = [2] * n_twos + [1] * (n - n_twos)\n    random.shuffle(parts)\n    return parts\n\ndef _gen_drop_parts(total, n):\n    if n == 0:\n        return []\n    n_twos = random.randint(max(0, total - n), min(total // 2, n))\n    n_ones = total - 2 * n_twos\n    parts = [2] * n_twos + [1] * n_ones + [0] * (n - n_twos - n_ones)\n    random.shuffle(parts)\n    return parts\n\ndef _gen_widths(height, max_width):\n    start = random.randint(START_WIDTH_MIN, START_WIDTH_MAX)\n    diff = max_width - start\n    grow_steps = random.randint((diff + 1) // 2, min(diff, height - 1))\n    widths = [start]\n    for inc in _gen_grow_parts(diff, grow_steps):\n        widths.append(widths[-1] + inc)\n\n    remaining = height - len(widths)\n    min_end = max(1, max_width - 2 * remaining)\n    end_width = random.randint(min_end, max_width)\n    for dec in _gen_drop_parts(max_width - end_width, remaining):\n        widths.append(widths[-1] - dec)\n    return widths\n\ndef _gen_intervals(widths):\n    left, right = 0, widths[0] - 1\n    intervals = [(left, right)]\n    for prev_width, width in zip(widths, widths[1:]):\n        delta = width - prev_width\n        if delta == 2:\n            left -= 1\n            right += 1\n        elif delta == 1:\n            if random.choice([False, True]):\n                left -= 1\n            else:\n                right += 1\n        elif delta == 0:\n            shift = random.choice(ZERO_DELTA_SHIFTS) if width >= 2 else 0\n            left += shift\n            right += shift\n        elif delta == -1:\n            if random.choice([False, True]):\n                left += 1\n            else:\n                right -= 1\n        elif delta == -2:\n            left += 1\n            right -= 1\n        intervals.append((left, right))\n\n    min_left = min(l for l, _ in intervals)\n    intervals = [(l - min_left, r - min_left) for l, r in intervals]\n    if max(r for _, r in intervals) + 1 > MAX_LOCAL_WIDTH:\n        return None\n    return intervals\n\ndef _gen_local_mask(intervals):\n    height = len(intervals)\n    width = max(r for _, r in intervals) + 1\n    mask = np.zeros((height, width), dtype=bool)\n    for r, (c0, c1) in enumerate(intervals):\n        mask[r, c0 : c1 + 1] = True\n    return mask\n\ndef _gen_place_shape(grid_shape, local_mask, edge_pair):\n    rows, cols = grid_shape\n    height, width = local_mask.shape\n    if edge_pair == EDGE_TOUCH_TOP_BOTTOM:\n        if height != rows or width > cols - 2:\n            return None\n        return 0, random.randint(1, cols - width - 1)\n    if height >= rows or width >= cols:\n        return None\n    if edge_pair == \"TL\":\n        return 0, 0\n    if edge_pair == \"TR\":\n        return 0, cols - width\n    if edge_pair == \"BL\":\n        return rows - height, 0\n    return rows - height, cols - width\n\ndef _gen_full_mask(rows, cols, local_mask, r0, c0):\n    mask = np.zeros((rows, cols), dtype=bool)\n    height, width = local_mask.shape\n    mask[r0 : r0 + height, c0 : c0 + width] = local_mask\n    return mask\n\ndef _gen_layers(mask):\n    remaining = mask.copy()\n    layers = []\n    rows, cols = mask.shape\n    while np.any(remaining):\n        layer = np.zeros_like(mask)\n        for r, c in np.argwhere(remaining):\n            for nr, nc in neighbors4(int(r), int(c)):\n                if nr < 0 or nr >= rows or nc < 0 or nc >= cols or not remaining[nr, nc]:\n                    layer[r, c] = True\n                    break\n        layers.append(layer)\n        remaining[layer] = False\n    return layers\n\ndef _gen_contour(outline, shape):\n    rows, cols = shape.shape\n    contour = np.zeros_like(shape)\n    for r, c in np.argwhere(outline):\n        for nr, nc in neighbors4(int(r), int(c)):\n            if 0 <= nr < rows and 0 <= nc < cols and not shape[nr, nc]:\n                contour[nr, nc] = True\n    return contour\n\ndef _choose_canvas_and_shape_profile():\n    rows = random.randint(GRID_MIN, GRID_MAX)\n    cols = random.randint(GRID_MIN, GRID_MAX)\n    bg = random.randrange(N_COLORS)\n\n    edge_options = []\n    if rows <= SHAPE_MAX_HEIGHT:\n        edge_options.append(EDGE_TOUCH_TOP_BOTTOM)\n    if rows >= SHAPE_MIN_HEIGHT + 1:\n        edge_options.extend(CORNER_EDGE_PAIRS)\n    if not edge_options:\n        return None\n\n    edge_pair = random.choice(edge_options)\n    height = rows if edge_pair == EDGE_TOUCH_TOP_BOTTOM else random.randint(\n        SHAPE_MIN_HEIGHT, min(SHAPE_MAX_HEIGHT, rows - 1)\n    )\n    max_width_limit = cols - 2 if edge_pair == EDGE_TOUCH_TOP_BOTTOM else cols - 1\n    if max_width_limit < SHAPE_MIN_WIDTH:\n        return None\n    max_width = random.randint(SHAPE_MIN_WIDTH, min(SHAPE_MAX_WIDTH, max_width_limit))\n\n    intervals = _gen_intervals(_gen_widths(height, max_width))\n    if intervals is None:\n        return None\n    return rows, cols, bg, edge_pair, intervals\n\ndef _build_shape(rows, cols, edge_pair, intervals):\n    local_mask = _gen_local_mask(intervals)\n    placement = _gen_place_shape((rows, cols), local_mask, edge_pair)\n    if placement is None:\n        return None\n\n    shape = _gen_full_mask(rows, cols, local_mask, *placement)\n    shape_area = int(np.sum(shape))\n    if rows * cols - shape_area <= shape_area:\n        return None\n    return shape\n\ndef _split_valid_layers(shape):\n    layers = _gen_layers(shape)\n    if len(layers) < 2:\n        return None\n\n    outline = layers[0]\n    marker = layers[-1]\n    fill = shape & ~outline & ~marker\n\n    outline_count = int(np.sum(outline))\n    marker_count = int(np.sum(marker))\n    fill_count = int(np.sum(fill))\n    if marker_count < MARKER_MIN_CELLS or marker_count > MARKER_MAX_CELLS:\n        return None\n    if len(components_mask(outline, connectivity=8)) != 1:\n        return None\n    if fill_count and not (marker_count < fill_count < outline_count):\n        return None\n    return outline, fill, marker, fill_count\n\ndef _render_input(rows, cols, bg, masks, colors):\n    outline, fill, marker = masks\n    outline_color, fill_color, marker_color = colors\n    inp = np.full((rows, cols), bg, dtype=int)\n    inp[outline] = outline_color\n    if fill_color is not None:\n        inp[fill] = fill_color\n    inp[marker] = marker_color\n    return inp\n\ndef _gen_attempt():\n    profile = _choose_canvas_and_shape_profile()\n    if profile is None:\n        return None\n    rows, cols, bg, edge_pair, intervals = profile\n\n    shape = _build_shape(rows, cols, edge_pair, intervals)\n    if shape is None:\n        return None\n\n    layer_parts = _split_valid_layers(shape)\n    if layer_parts is None:\n        return None\n    outline, fill, marker, fill_count = layer_parts\n\n    contour = _gen_contour(outline, shape)\n    if not np.any(contour):\n        return None\n\n    colors = [c for c in range(N_COLORS) if c != bg]\n    random.shuffle(colors)\n    outline_color, marker_color = colors[:2]\n    fill_color = colors[2] if fill_count else None\n    inp = _render_input(rows, cols, bg, (outline, fill, marker), (outline_color, fill_color, marker_color))\n\n    expected = np.full((rows, cols), bg, dtype=int)\n    expected[contour] = marker_color\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\ndef generate_input():\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/6cbe9eb8.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/6cbe9eb8.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rebuild the foreground rectangles as a largest-to-smallest lower-left nesting.\n\n    Input structure\n    - A periodic wallpaper background is overlaid by foreground colors that each form a rectangular frame or solid rectangle.\n    - The largest foreground rectangle is the output frame; smaller foreground rectangles are the objects to nest inside it.\n    - A frame may be partially hidden by a smaller rectangle, but its visible pixels still determine its bbox.\n\n    Rule\n    - Ignore the wallpaper and crop the result to the largest foreground rectangle's bbox size.\n    - Sort foreground rectangles by bbox area from largest to smallest.\n    - Reconstruct each frame or solid rectangle, placing every next smaller rectangle in the lower-left of the current rectangle's usable region.\n\n    Key insight\n    - The scattered background colors are not objects; the meaningful order is the unique descending rectangle size chain, and each step nests into the previous rectangle's lower-left interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    items = _foreground_rectangles(g)\n    outer = items[0]\n    out = np.zeros((int(outer[\"height\"]), int(outer[\"width\"])), dtype=int)\n\n    region = _paint_item(out, outer, 0, 0)\n    for item in items[1:]:\n        rr, cc, rh, rw = region\n        h = int(item[\"height\"])\n        w = int(item[\"width\"])\n        assert h <= rh and w <= rw, \"nested rectangle must fit in parent usable region\"\n        r = rr + rh - h\n        c = cc\n        region = _paint_item(out, item, r, c)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n_RNG = np.random.default_rng()\n\n# Colors and sentinels.\nCOLOR_VALUES, FOREGROUND_COLORS = tuple(range(10)), tuple(range(1, 10))\nTRANSPARENT = -1\n# Rectangle chain counts.\nITEM_COUNT_RANGE, THREE_ITEM_FRAME_OPTIONS = (3, 4), (1, 2)\nFOUR_ITEM_FRAME_COUNT = 2\n# Solid rectangle dimensions.\nINNER_SOLID_HEIGHT_RANGE, INNER_SOLID_WIDTH_RANGE = (2, 3), (2, 3)\nSECOND_SOLID_MAX_HEIGHT, SECOND_SOLID_MAX_WIDTH = 9, 9\n# Frame growth and bounds.\nFRAME_MIN_GROWTH, INNER_FRAME_MAX_GROWTH = 2, 5\nINNER_FRAME_MAX_HEIGHT, INNER_FRAME_MAX_WIDTH = 13, 11\nOUTER_FRAME_MIN_HEIGHT, OUTER_FRAME_MIN_WIDTH = 8, 8\nOUTER_FRAME_MAX_HEIGHT, OUTER_FRAME_MAX_WIDTH = 15, 13\n# Wallpaper canvas bounds and margin around the outer rectangle.\nCANVAS_HEIGHT_RANGE, CANVAS_WIDTH_RANGE = (13, 19), (22, 27)\nCANVAS_BORDER_MARGIN = 1\n# Wallpaper tile/color sampling.\nWALLPAPER_COLOR_COUNT_RANGE = (2, 4)\nZERO_WALLPAPER_ROLL_RANGE = (0, 4)\nZERO_WALLPAPER_THRESHOLD = 3\nTILE_SIZE_2 = 2\nTILE_SIZE_OPTIONS, TILE3_SIGN_OPTIONS = (2, 3), (1, 2)\n# Visibility/oracle retry limits.\nVISIBLE_OUTER_MIN_COMPONENT, MAX_VISIBLE_OUTER_COMPONENTS = 3, 4\nGENERATION_RETRY_LIMIT = 300\n\n\ndef _randint(lo: int, hi: int) -> int:\n    return int(_RNG.integers(int(lo), int(hi) + 1))\n\n\ndef _choice(seq):\n    return seq[_randint(0, len(seq) - 1)]\n\n\ndef _sample(seq, k: int) -> list[int]:\n    idx = _RNG.choice(len(seq), size=int(k), replace=False)\n    return [int(seq[int(i)]) for i in idx]\n\n\ndef _shuffled(seq) -> list[int]:\n    vals = list(seq)\n    _RNG.shuffle(vals)\n    return [int(v) for v in vals]\n\n\ndef _choose_dims(\n    h_min: int,\n    h_max: int,\n    w_min: int,\n    w_max: int,\n    used_areas: set[int],\n    *,\n    min_area: int = 0,\n) -> tuple[int, int] | None:\n    pairs = [\n        (h, w)\n        for h in range(int(h_min), int(h_max) + 1)\n        for w in range(int(w_min), int(w_max) + 1)\n        if h * w > int(min_area) and h * w not in used_areas\n    ]\n    return _choice(pairs) if pairs else None\n\n\ndef _build_items() -> list[dict]:\n    \"\"\"Build a largest-to-smallest rectangle chain with unique bbox areas.\"\"\"\n    n_items = _randint(*ITEM_COUNT_RANGE)\n    if n_items == ITEM_COUNT_RANGE[1]:\n        n_frames = FOUR_ITEM_FRAME_COUNT\n    else:\n        n_frames = _choice(THREE_ITEM_FRAME_OPTIONS)\n    n_solids = n_items - n_frames\n\n    colors = _sample(FOREGROUND_COLORS, n_items)\n    chain = []\n    used_areas: set[int] = set()\n\n    h = _randint(*INNER_SOLID_HEIGHT_RANGE)\n    w = _randint(*INNER_SOLID_WIDTH_RANGE)\n    chain.append({\"kind\": \"solid\", \"height\": h, \"width\": w})\n    used_areas.add(h * w)\n\n    if n_solids == 2:\n        dims = _choose_dims(h, SECOND_SOLID_MAX_HEIGHT, w, SECOND_SOLID_MAX_WIDTH, used_areas, min_area=h * w)\n        if dims is None:\n            return []\n        h, w = dims\n        chain.append({\"kind\": \"solid\", \"height\": h, \"width\": w})\n        used_areas.add(h * w)\n\n    if n_frames == 2:\n        dims = _choose_dims(\n            h + FRAME_MIN_GROWTH,\n            min(INNER_FRAME_MAX_HEIGHT, h + INNER_FRAME_MAX_GROWTH),\n            w + FRAME_MIN_GROWTH,\n            min(INNER_FRAME_MAX_WIDTH, w + INNER_FRAME_MAX_GROWTH),\n            used_areas,\n        )\n        if dims is None:\n            return []\n        h, w = dims\n        chain.append({\"kind\": \"frame\", \"height\": h, \"width\": w})\n        used_areas.add(h * w)\n\n    dims = _choose_dims(\n        max(OUTER_FRAME_MIN_HEIGHT, h + FRAME_MIN_GROWTH),\n        OUTER_FRAME_MAX_HEIGHT,\n        max(OUTER_FRAME_MIN_WIDTH, w + FRAME_MIN_GROWTH),\n        OUTER_FRAME_MAX_WIDTH,\n        used_areas,\n    )\n    if dims is None:\n        return []\n    h, w = dims\n    chain.append({\"kind\": \"frame\", \"height\": h, \"width\": w})\n\n    items = list(reversed(chain))\n    for item, color in zip(items, colors):\n        item[\"color\"] = int(color)\n        item[\"area\"] = int(item[\"height\"] * item[\"width\"])\n    return items\n\n\ndef _item_size(item: dict) -> tuple[int, int]:\n    return int(item[\"height\"]), int(item[\"width\"])\n\n\ndef _paint_item_view(view: np.ndarray, item: dict) -> None:\n    color = int(item[\"color\"])\n    if item[\"kind\"] == \"solid\":\n        view[:, :] = color\n    else:\n        view[0, :] = color\n        view[-1, :] = color\n        view[:, 0] = color\n        view[:, -1] = color\n\n\ndef _gen_paint_item(out: np.ndarray, item: dict, r: int, c: int) -> tuple[int, int, int, int]:\n    h, w = _item_size(item)\n    _paint_item_view(out[r : r + h, c : c + w], item)\n    if item[\"kind\"] == \"solid\":\n        return r, c, h, w\n\n    return r + 1, c + 1, h - 2, w - 2\n\n\ndef _render_output(items: list[dict]) -> np.ndarray:\n    outer = items[0]\n    out = np.zeros((int(outer[\"height\"]), int(outer[\"width\"])), dtype=int)\n    region = _gen_paint_item(out, outer, 0, 0)\n    for item in items[1:]:\n        rr, cc, rh, rw = region\n        h = int(item[\"height\"])\n        w = int(item[\"width\"])\n        region = _gen_paint_item(out, item, rr + rh - h, cc)\n    return out\n\n\ndef _rect_patch(item: dict) -> np.ndarray:\n    h, w = _item_size(item)\n    patch = np.full((h, w), TRANSPARENT, dtype=int)\n    _paint_item_view(patch, item)\n    return patch\n\n\ndef _tile2(colors: list[int]) -> np.ndarray:\n    colors = _shuffled(colors)\n    if len(colors) == 2:\n        a, b = colors\n        return np.array([[a, b], [b, a]], dtype=int)\n    if len(colors) == 3:\n        a, b, c = colors\n        if _randint(0, 1):\n            return np.array([[a, b], [c, a]], dtype=int)\n        return np.array([[b, a], [a, c]], dtype=int)\n    return np.array(colors, dtype=int).reshape(2, 2)\n\n\ndef _tile3(colors: list[int]) -> np.ndarray:\n    colors = _shuffled(colors)\n    sign = _choice(TILE3_SIGN_OPTIONS)\n    tile = np.array(\n        [[colors[(r + sign * c) % 3] for c in range(3)] for r in range(3)],\n        dtype=int,\n    )\n    if len(colors) == 4:\n        tile[_randint(0, TILE_SIZE_2), _randint(0, TILE_SIZE_2)] = colors[3]\n    return tile\n\n\ndef _wallpaper(rows: int, cols: int, fg_colors: set[int]) -> np.ndarray:\n    available = [c for c in COLOR_VALUES if c not in fg_colors]\n    k = _randint(*WALLPAPER_COLOR_COUNT_RANGE)\n    if 0 in available and _randint(*ZERO_WALLPAPER_ROLL_RANGE) < ZERO_WALLPAPER_THRESHOLD:\n        colors = [0] + _sample([c for c in available if c != 0], k - 1)\n    else:\n        colors = _sample(available, k)\n\n    tile_size = TILE_SIZE_2 if k == WALLPAPER_COLOR_COUNT_RANGE[0] else _choice(TILE_SIZE_OPTIONS)\n    tile = _tile2(colors) if tile_size == TILE_SIZE_2 else _tile3(colors)\n    reps = (rows // tile.shape[0] + 1, cols // tile.shape[1] + 1)\n    return np.tile(tile, reps)[:rows, :cols].copy()\n\n\ndef _placed_mask(mask: np.ndarray, rows: int, cols: int, r: int, c: int) -> np.ndarray:\n    out = np.zeros((rows, cols), dtype=bool)\n    h, w = mask.shape\n    out[r : r + h, c : c + w] = mask\n    return out\n\n\ndef _outer_survives(outer_mask: np.ndarray, item_mask: np.ndarray, r: int, c: int, box: tuple[int, int, int, int]) -> bool:\n    visible = outer_mask.copy()\n    h, w = item_mask.shape\n    visible[r : r + h, c : c + w] &= ~item_mask\n    r0, c0, rh, rw = box\n    if not visible[r0, c0 : c0 + rw].any():\n        return False\n    if not visible[r0 + rh - 1, c0 : c0 + rw].any():\n        return False\n    if not visible[r0 : r0 + rh, c0].any():\n        return False\n    if not visible[r0 : r0 + rh, c0 + rw - 1].any():\n        return False\n    sizes = [int(comp.shape[0]) for comp in components_mask(visible, connectivity=4)]\n    return bool(sizes) and max(sizes) > VISIBLE_OUTER_MIN_COMPONENT and len(sizes) <= MAX_VISIBLE_OUTER_COMPONENTS\n\n\ndef _overlap_positions(mask: np.ndarray, outer_mask: np.ndarray, box: tuple[int, int, int, int]) -> list[tuple[int, int]]:\n    rows, cols = outer_mask.shape\n    h, w = mask.shape\n    positions = []\n    for r in range(rows - h + 1):\n        for c in range(cols - w + 1):\n            if not np.any(outer_mask[r : r + h, c : c + w] & mask):\n                continue\n            if _outer_survives(outer_mask, mask, r, c, box):\n                positions.append((r, c))\n    return positions\n\n\ndef _free_positions(mask: np.ndarray, occupied: np.ndarray) -> list[tuple[int, int]]:\n    rows, cols = occupied.shape\n    h, w = mask.shape\n    positions = []\n    for r in range(rows - h + 1):\n        for c in range(cols - w + 1):\n            if not np.any(occupied[r : r + h, c : c + w] & mask):\n                positions.append((r, c))\n    return positions\n\n\ndef _build_canvas(items: list[dict]) -> np.ndarray:\n    \"\"\"Create a wallpaper canvas large enough to leave a border around the outer frame.\"\"\"\n    outer_h, outer_w = _item_size(items[0])\n    rows = _randint(max(CANVAS_HEIGHT_RANGE[0], outer_h + 2 * CANVAS_BORDER_MARGIN), CANVAS_HEIGHT_RANGE[1])\n    cols = _randint(max(CANVAS_WIDTH_RANGE[0], outer_w + 2 * CANVAS_BORDER_MARGIN), CANVAS_WIDTH_RANGE[1])\n    fg_colors = {int(item[\"color\"]) for item in items}\n    return _wallpaper(rows, cols, fg_colors)\n\n\ndef _choose_placements(items: list[dict], masks: list[np.ndarray], rows: int, cols: int) -> list[tuple[int, int, int]] | None:\n    \"\"\"Scatter rectangles, forcing one valid overlap with the outer frame and keeping the rest disjoint.\"\"\"\n    outer_h, outer_w = _item_size(items[0])\n    outer_r = _randint(CANVAS_BORDER_MARGIN, rows - outer_h - CANVAS_BORDER_MARGIN)\n    outer_c = _randint(CANVAS_BORDER_MARGIN, cols - outer_w - CANVAS_BORDER_MARGIN)\n    outer_mask = _placed_mask(masks[0], rows, cols, outer_r, outer_c)\n    occupied = outer_mask.copy()\n    placements = [(0, outer_r, outer_c)]\n\n    overlap_i = _choice(list(range(1, len(items))))\n    choices = _overlap_positions(masks[overlap_i], outer_mask, (outer_r, outer_c, outer_h, outer_w))\n    if not choices:\n        return None\n    r, c = _choice(choices)\n    placements.append((overlap_i, r, c))\n    occupied |= _placed_mask(masks[overlap_i], rows, cols, r, c)\n\n    remaining = [i for i in range(1, len(items)) if i != overlap_i]\n    remaining.sort(key=lambda i: int(items[i][\"area\"]), reverse=True)\n    for i in remaining:\n        choices = _free_positions(masks[i], occupied)\n        if not choices:\n            return None\n        r, c = _choice(choices)\n        placements.append((i, r, c))\n        occupied |= _placed_mask(masks[i], rows, cols, r, c)\n\n    return placements\n\n\ndef _passes_oracle(grid: np.ndarray, expected: np.ndarray) -> bool:\n    try:\n        actual = main(grid)\n    except Exception:\n        return False\n    return bool(np.array_equal(actual, expected))\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    items = _build_items()\n    if not items:\n        return None\n\n    expected = _render_output(items)\n    grid = _build_canvas(items)\n    patches = [_rect_patch(item) for item in items]\n    masks = [patch != TRANSPARENT for patch in patches]\n    placements = _choose_placements(items, masks, *grid.shape)\n    if placements is None:\n        return None\n    for i, r, c in placements:\n        paste(grid, patches[i], r, c, transparent=TRANSPARENT)\n    if not _passes_oracle(grid, expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
