code/train/98c475bf.py:61:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/98c475bf.py:62:    \"\"\"Erase the complete interior glyph and expand each endpoint marker pair into its color's full glyph.\n/home/lixinyu/snap/new/ARC_code/train/98c475bf.py:76:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/98c475bf.py:223:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:41:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:42:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:56:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:184:    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:188:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:202:    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:207:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:245:    \"\"\"Grow a meandering 8-connected 1px-wide path of line_col from start.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:296:    \"\"\"Compute offsets around a frame bbox that lie outside it (the halo).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:302:    \"\"\"Try to place a frame loop 8-adjacent to some line pixel.\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:305:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:330:    \"\"\"Place a loop in empty space, not touching any non-bg pixel.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:357:    \"\"\"Place a disconnected line+frame distractor (no seed).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:388:    \"\"\"Return (seed_rc, first_line_rc) for corner_kind in {TL,TR,BL,BR}.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:407:    \"\"\"Distribute attached-loop budget across seeds, guaranteeing >= 1 each.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:508:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:7:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:8:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:22:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:216:    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:367:    \"\"\"Return True if any patch cell has a non-bg 8-neighbor on canvas.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:394:    \"\"\"Return True when a cell and its in-bounds 8-neighborhood are bg.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:509:    \"\"\"Choose grid size/background and return matching output/input canvases.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:519:    \"\"\"Place distinct isolated border anchors into both canvases.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:535:    \"\"\"Expand anchor colors to the sprite count, allowing repeated markers.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:545:    \"\"\"Build sprites in their solved locations and return their align metadata.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:564:    \"\"\"Move solved sprites onto the input canvas along the inverse axis.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:576:    \"\"\"Apply generator invariants and the solver oracle check.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:582:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:8:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:9:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:21:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:110:    \"\"\"Return an inclusive randint from a configured (low, high) pair.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:116:    \"\"\"Return connected masks that span all four sides of the sprite bbox.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:132:    \"\"\"Sample one connected same-color sprite drawn on the background color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:146:    \"\"\"Choose background, key colors, and optional distractor color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:159:    \"\"\"Sample the target outside-component count for each key color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:164:    \"\"\"Return legend height and width for the key count and largest tally.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:171:    \"\"\"Map a zero-based key index to its row inside the legend/output box.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:176:    \"\"\"Render the black output tally canvas implied by key colors and counts.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:189:    \"\"\"Return a black legend patch with only the key-column pixels filled.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:197:    \"\"\"Sample a grid and paste the legend away from all canvas edges.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:219:    \"\"\"Create canonical key sprites, optional distractor sprite, and shuffle them.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:232:    \"\"\"Paste sprites into random non-touching free locations in queue order.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:245:    \"\"\"Run one output-first generation attempt and reject solver mismatches.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:265:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:7:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:16:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:101:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:102:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:115:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:169:\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:205:    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:214:    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:228:    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:240:    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:265:    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:275:    \"\"\"Return blob with interior holes absorbed.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:279:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:330:    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:346:    \"\"\"Place 1-2 legend patches at grid corners.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:349:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:380:    \"\"\"Grow irregular closed regions, one per assigned wall color.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:383:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:440:    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:468:    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:485:    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:489:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:533:    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:556:    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:604:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:8:    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:15:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:22:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:27:        \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:31:        \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:195:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:197:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:232:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:235:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:274:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:275:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:288:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:332:    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:339:    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:346:    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:378:    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:392:    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:408:    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:425:    \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:441:    \"\"\"Render a sprite onto the grid: border cells in color, hole cells in fill (if given).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:544:def generate_input():\n","exit_code":0,"status":"completed"}}
