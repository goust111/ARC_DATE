{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,560p' /home/lixinyu/snap/new/ARC_code/train/3bd292e8.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import defaultdict, deque\n\nimport numpy as np\n\nfrom arc_utils import Color, get_bg, label_mask, neighbors4\nimport itertools\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor wall-separated background regions alternately, starting with grey in the lower-left region.\n\n    Input structure\n    - The grid has one dominant background color and one foreground wall color.\n    - The wall pixels form one or more 4-connected one-cell-thick segments.\n    - Each wall segment separates exactly two 4-connected background regions.\n    Rule\n    - Keep all wall pixels unchanged.\n    - Label the 4-connected background regions and connect two labels when they\n      touch opposite sides of the same wall segment.\n    - Color the region containing the lower-left corner grey, then flip between\n      grey and green across every wall adjacency.\n    Key insight\n    - The red walls define a bipartite map of regions; the lower-left background\n      region fixes which side of the alternating coloring is grey.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    H, W = g.shape\n\n    colors = set(map(int, g.flat))\n    assert len(colors) == 2, \"expected exactly one background color and one wall color\"\n    bg = get_bg(g)\n    wall_colors = colors - {int(bg)}\n    assert len(wall_colors) == 1\n    wall = int(next(iter(wall_colors)))\n\n    bg_lab, n_regions = label_mask(g == int(bg), connectivity=4)\n    assert n_regions >= 2, \"walls must split the background into multiple regions\"\n    start_region = int(bg_lab[H - 1, 0])\n    assert start_region > 0, \"lower-left corner must belong to a background region\"\n\n    wall_lab, n_walls = label_mask(g == wall, connectivity=4)\n    assert n_walls >= 1\n\n    graph: dict[int, set[int]] = defaultdict(set)\n    for wall_id in range(1, n_walls + 1):\n        adjacent_regions: set[int] = set()\n        for r, c in np.argwhere(wall_lab == wall_id):\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W:\n                    region_id = int(bg_lab[rr, cc])\n                    if region_id > 0:\n                        adjacent_regions.add(region_id)\n\n        assert len(adjacent_regions) == 2, \"each wall segment must separate exactly two regions\"\n        a, b = tuple(adjacent_regions)\n        graph[a].add(b)\n        graph[b].add(a)\n\n    parity = {start_region: 0}\n    queue = deque([start_region])\n    while queue:\n        region = queue.popleft()\n        for neighbor in graph[region]:\n            neighbor_parity = 1 - parity[region]\n            if neighbor in parity:\n                assert parity[neighbor] == neighbor_parity, \"region graph must be bipartite\"\n            else:\n                parity[neighbor] = neighbor_parity\n                queue.append(neighbor)\n\n    assert set(parity) == set(range(1, n_regions + 1)), \"all background regions must be wall-connected\"\n\n    out = g.copy()\n    for region_id, region_parity in parity.items():\n        out[bg_lab == region_id] = Color.GREY if region_parity == 0 else Color.GREEN\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Grid, colors, and retry policy.\nGRID_SIZES = (7, 8, 9)\nGRID_SIZES_FOR_THREE_WALLS = (8, 9)\nWALL_COUNT_RANGE = (1, 3)\nMAX_GENERATION_ATTEMPTS = 300\nBACKGROUND_COLOR = Color.ORANGE\nWALL_COLOR = Color.RED\n\n# Wall geometry constraints.\nWALL_LENGTH_RANGE = (4, 13)\nWALL_TURN_RANGE = (1, 5)\nENDPOINT_SPACING = 2\nMAX_STAIR_PARTS = 3\nMIN_FIRST_STAIR_COL = 1\n\n# Left-right corridor layout.\nLR_LAYOUT_MAX_WALLS = 2\nLR_LAYOUT_PROBABILITY = 0.55\nLR_TURN_OPTIONS = (2, 4)\nLR_CORRIDOR_MAX_SPAN = 3\nLR_CORRIDOR_GAP = 2\n\n# Canonical grids are randomly mapped through one of eight dihedral transforms.\nTRANSFORM_OPS = 8\n\n\ndef _contains(bounds: tuple[int, int], value: int) -> bool:\n    lo, hi = bounds\n    return lo <= int(value) <= hi\n\n\ndef _paint_wall_path(grid: np.ndarray, cells: list[tuple[int, int]]) -> bool:\n    for r, c in cells:\n        if grid[r, c] != BACKGROUND_COLOR:\n            return False\n        grid[r, c] = WALL_COLOR\n    return True\n\n\ndef _split_positive(total: int, parts: int) -> list[int]:\n    if parts == 1:\n        return [int(total)]\n    cuts = sorted(random.sample(range(1, int(total)), int(parts) - 1))\n    return [b - a for a, b in zip([0] + cuts, cuts + [int(total)])]\n\n\ndef _spaced_combos(values: list[int], n: int) -> list[tuple[int, ...]]:\n    return [\n        combo\n        for combo in itertools.combinations(values, n)\n        if all(combo[i + 1] - combo[i] >= ENDPOINT_SPACING for i in range(len(combo) - 1))\n    ]\n\n\ndef _choose_endpoints(H: int, W: int, n_walls: int) -> tuple[tuple[int, ...], tuple[int, ...]] | None:\n    rows = _spaced_combos(list(range(1, H - 1)), n_walls)\n    cols = _spaced_combos(list(range(1, W - 1)), n_walls)\n    valid: list[tuple[tuple[int, ...], tuple[int, ...]]] = []\n    for start_rows in rows:\n        for cols_asc in cols:\n            end_cols = tuple(reversed(cols_asc))\n            lengths = [c + (H - 1 - r) + 1 for r, c in zip(start_rows, end_cols)]\n            if all(_contains(WALL_LENGTH_RANGE, length) for length in lengths):\n                valid.append((start_rows, end_cols))\n    return random.choice(valid) if valid else None\n\n\ndef _stair_path_lb(H: int, W: int, start_r: int, end_c: int, min_first_col: int) -> list[tuple[int, int]] | None:\n    down = H - 1 - int(start_r)\n    right = int(end_c)\n    max_parts = min(MAX_STAIR_PARTS, down, right)\n    feasible = [k for k in range(1, max_parts + 1) if right >= int(min_first_col) + k - 1]\n    if not feasible:\n        return None\n    weights = [k * k for k in feasible]\n    k = random.choices(feasible, weights=weights, k=1)[0]\n\n    if k == 1:\n        horiz = [right]\n    else:\n        first = random.randint(int(min_first_col), right - (k - 1))\n        horiz = [first] + _split_positive(right - first, k - 1)\n    vert = _split_positive(down, k)\n\n    r, c = int(start_r), 0\n    cells = [(r, c)]\n    for h_run, v_run in zip(horiz, vert):\n        for _ in range(h_run):\n            c += 1\n            cells.append((r, c))\n        for _ in range(v_run):\n            r += 1\n            cells.append((r, c))\n\n    if (r, c) != (H - 1, int(end_c)):\n        return None\n    return cells\n\n\ndef _build_lower_left_grid(H: int, W: int, n_walls: int) -> np.ndarray | None:\n    endpoints = _choose_endpoints(H, W, n_walls)\n    if endpoints is None:\n        return None\n    start_rows, end_cols = endpoints\n\n    grid = np.full((H, W), BACKGROUND_COLOR, dtype=int)\n    for i, (start_r, end_c) in enumerate(zip(start_rows, end_cols)):\n        min_first_col = end_cols[i + 1] + ENDPOINT_SPACING if i + 1 < n_walls else MIN_FIRST_STAIR_COL\n        cells = _stair_path_lb(H, W, start_r, end_c, min_first_col)\n        if cells is None or not _paint_wall_path(grid, cells):\n            return None\n    return grid\n\n\ndef _choose_lr_corridors(H: int, n_walls: int) -> tuple[tuple[int, int], ...] | None:\n    intervals = []\n    for lo in range(1, H - 2):\n        for hi in range(lo + 1, min(H - 2, lo + LR_CORRIDOR_MAX_SPAN) + 1):\n            intervals.append((lo, hi))\n    valid: list[tuple[tuple[int, int], ...]] = []\n    for combo in itertools.combinations(intervals, n_walls):\n        if all(combo[i][1] + LR_CORRIDOR_GAP <= combo[i + 1][0] for i in range(n_walls - 1)):\n            valid.append(combo)\n    return random.choice(valid) if valid else None\n\n\ndef _lr_path(W: int, lo: int, hi: int) -> list[tuple[int, int]] | None:\n    short_turn, long_turn = LR_TURN_OPTIONS\n    turn_goal = random.choice(LR_TURN_OPTIONS)\n    if turn_goal == long_turn and W - 1 < long_turn:\n        turn_goal = short_turn\n\n    if turn_goal == short_turn:\n        h1 = random.randint(1, W - 2)\n        horiz = [h1, W - 1 - h1]\n        r0, r1 = random.sample(range(lo, hi + 1), 2)\n        rows = [r0, r1]\n    else:\n        if hi - lo >= 2:\n            if random.random() < 0.5:\n                rows = [lo, random.randint(lo + 1, hi - 1), hi]\n            else:\n                rows = [hi, random.randint(lo + 1, hi - 1), lo]\n            middle_min = 1\n        else:\n            rows = [lo, hi, lo] if random.random() < 0.5 else [hi, lo, hi]\n            middle_min = 2\n        if W - 1 < middle_min + 2:\n            return None\n        h2 = random.randint(middle_min, W - 3)\n        h1 = random.randint(1, W - 1 - h2 - 1)\n        horiz = [h1, h2, W - 1 - h1 - h2]\n\n    r, c = int(rows[0]), 0\n    cells = [(r, c)]\n    for i, h_run in enumerate(horiz):\n        for _ in range(h_run):\n            c += 1\n            cells.append((r, c))\n        if i < len(rows) - 1:\n            target = int(rows[i + 1])\n            step = 1 if target > r else -1\n            while r != target:\n                r += step\n                cells.append((r, c))\n\n    if c != W - 1:\n        return None\n    if not _contains(WALL_LENGTH_RANGE, len(cells)):\n        return None\n    return cells\n\n\ndef _build_lr_grid(H: int, W: int, n_walls: int) -> np.ndarray | None:\n    corridors = _choose_lr_corridors(H, n_walls)\n    if corridors is None:\n        return None\n    grid = np.full((H, W), BACKGROUND_COLOR, dtype=int)\n    for lo, hi in corridors:\n        cells = _lr_path(W, lo, hi)\n        if cells is None or not _paint_wall_path(grid, cells):\n            return None\n    return grid\n\n\ndef _transform(grid: np.ndarray) -> np.ndarray:\n    op = random.randrange(TRANSFORM_OPS)\n    if op == 0:\n        out = grid\n    elif op == 1:\n        out = np.rot90(grid, 1)\n    elif op == 2:\n        out = np.rot90(grid, 2)\n    elif op == 3:\n        out = np.rot90(grid, 3)\n    elif op == 4:\n        out = np.fliplr(grid)\n    elif op == 5:\n        out = np.flipud(grid)\n    elif op == 6:\n        out = grid.T\n    else:\n        out = np.fliplr(grid).T\n    return np.ascontiguousarray(out)\n\n\ndef _ordered_path(coords: np.ndarray) -> list[tuple[int, int]] | None:\n    cells = {tuple(map(int, rc)) for rc in coords}\n    nbrs: dict[tuple[int, int], list[tuple[int, int]]] = {}\n    for r, c in cells:\n        here = [(rr, cc) for rr, cc in neighbors4(r, c) if (rr, cc) in cells]\n        if len(here) > 2:\n            return None\n        nbrs[(r, c)] = here\n\n    endpoints = [cell for cell, here in nbrs.items() if len(here) == 1]\n    if len(cells) == 1 or len(endpoints) != 2:\n        return None\n\n    path = [endpoints[0]]\n    prev: tuple[int, int] | None = None\n    cur = endpoints[0]\n    while cur != endpoints[1]:\n        nxts = [cell for cell in nbrs[cur] if cell != prev]\n        if not nxts:\n            return None\n        prev, cur = cur, nxts[0]\n        path.append(cur)\n        if len(path) > len(cells):\n            return None\n    return path if len(path) == len(cells) else None\n\n\ndef _turn_count(path: list[tuple[int, int]]) -> int:\n    dirs = []\n    for (r0, c0), (r1, c1) in zip(path, path[1:]):\n        dirs.append((int(np.sign(r1 - r0)), int(np.sign(c1 - c0))))\n    return sum(a != b for a, b in zip(dirs, dirs[1:]))\n\n\ndef _validate_wall_paths(wall_lab: np.ndarray, n_walls: int, H: int, W: int) -> bool:\n    for wall_id in range(1, n_walls + 1):\n        coords = np.argwhere(wall_lab == wall_id)\n        if not _contains(WALL_LENGTH_RANGE, len(coords)):\n            return False\n        path = _ordered_path(coords)\n        if path is None:\n            return False\n        endpoints = [path[0], path[-1]]\n        if not all(r in (0, H - 1) or c in (0, W - 1) for r, c in endpoints):\n            return False\n        turns = _turn_count(path)\n        if not _contains(WALL_TURN_RANGE, turns):\n            return False\n    return True\n\n\ndef _build_region_graph(wall_lab, bg_lab, n_walls: int, n_regions: int, H: int, W: int):\n    \"\"\"Connect background-region labels separated by each wall component.\"\"\"\n    graph: dict[int, set[int]] = defaultdict(set)\n    edges: set[tuple[int, int]] = set()\n    for wall_id in range(1, n_walls + 1):\n        adjacent: set[int] = set()\n        for r, c in np.argwhere(wall_lab == wall_id):\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W:\n                    region_id = int(bg_lab[rr, cc])\n                    if region_id > 0:\n                        adjacent.add(region_id)\n        if len(adjacent) != 2:\n            return None\n        a, b = sorted(adjacent)\n        graph[a].add(b)\n        graph[b].add(a)\n        edges.add((a, b))\n\n    if len(edges) != n_walls:\n        return None\n    if set(graph) != set(range(1, n_regions + 1)):\n        return None\n    if any(len(graph[k]) > 2 for k in graph):\n        return None\n    return graph\n\n\ndef _region_parity(graph: dict[int, set[int]], start_region: int, n_regions: int) -> dict[int, int] | None:\n    parity = {start_region: 0}\n    queue = deque([start_region])\n    while queue:\n        region = queue.popleft()\n        for neighbor in graph[region]:\n            want = 1 - parity[region]\n            if neighbor in parity:\n                if parity[neighbor] != want:\n                    return None\n            else:\n                parity[neighbor] = want\n                queue.append(neighbor)\n    if set(parity) != set(range(1, n_regions + 1)):\n        return None\n    return parity\n\n\ndef _check_and_color(grid: np.ndarray, expected_walls: int) -> np.ndarray | None:\n    \"\"\"Validate task constraints and return the solver-expected output grid.\"\"\"\n    H, W = grid.shape\n    if int(grid[H - 1, 0]) != BACKGROUND_COLOR:\n        return None\n\n    wall_mask = grid == WALL_COLOR\n    wall_lab, n_walls = label_mask(wall_mask, connectivity=4)\n    if n_walls != int(expected_walls):\n        return None\n    _, n_walls8 = label_mask(wall_mask, connectivity=8)\n    if n_walls8 != n_walls:\n        return None\n\n    if not _validate_wall_paths(wall_lab, n_walls, H, W):\n        return None\n\n    bg_lab, n_regions = label_mask(grid == BACKGROUND_COLOR, connectivity=4)\n    if n_regions != n_walls + 1:\n        return None\n    start_region = int(bg_lab[H - 1, 0])\n    if start_region <= 0:\n        return None\n\n    graph = _build_region_graph(wall_lab, bg_lab, n_walls, n_regions, H, W)\n    if graph is None:\n        return None\n    parity = _region_parity(graph, start_region, n_regions)\n    if parity is None:\n        return None\n\n    out = grid.copy()\n    for region_id, p in parity.items():\n        out[bg_lab == region_id] = Color.GREY if p == 0 else Color.GREEN\n    return out\n\n\ndef _build_canonical_grid(H: int, W: int, n_walls: int) -> np.ndarray | None:\n    if n_walls <= LR_LAYOUT_MAX_WALLS and random.random() < LR_LAYOUT_PROBABILITY:\n        return _build_lr_grid(H, W, n_walls)\n    return _build_lower_left_grid(H, W, n_walls)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n_walls = random.randint(*WALL_COUNT_RANGE)\n    sizes = GRID_SIZES if n_walls < WALL_COUNT_RANGE[1] else GRID_SIZES_FOR_THREE_WALLS\n    H = random.choice(sizes)\n    W = H\n    grid = _build_canonical_grid(H, W, n_walls)\n    if grid is None:\n        return None\n    grid = _transform(grid)\n    expected = _check_and_color(grid, n_walls)\n    if expected is None:\n        return None\n    try:\n        solved = main(grid)\n    except Exception:\n        return None\n    if not np.array_equal(solved, expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 3bd292e8 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"这些参考题普遍采用“先构造 expected，再用 `main()` 回验”的生成器模式。我会沿用这种防退化方式：随机生成矩形和指示物后，用同一个求解器校验样例有效性。"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '30,560p' /home/lixinyu/snap/new/ARC_code/eval/edb79dae.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '30,560p' /home/lixinyu/snap/new/ARC_code/eval/edb79dae.py\"","aggregated_output":"            if np.all(sub[~border] == col):\n                continue\n            candidates.append((col, (r0, c0, r1, c1)))\n    assert len(candidates) == 1, f\"expected exactly one rectangular frame component, found {len(candidates)}\"\n    frame_col, bbox = candidates[0]\n    return int(frame_col), bbox\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp recolored sprites into a framed region using placeholder positions and a color legend.\n\n    Input structure:\n    - bg background, a rectangular single-color frame, colored placeholder cells inside the frame.\n    - Outside the frame: sprite shapes (one per placeholder color) and a small legend mapping each placeholder color to an output color.\n\n    Rule:\n    - Find the frame and its interior placeholders.\n    - For each placeholder color, locate the matching-color sprite outside the frame.\n    - Stamp each sprite at the placeholder's position inside the frame.\n    - Recolor every stamped sprite to the output color defined by the legend.\n\n    Key insight: The legend pairs (overlapping two-color glyphs outside the frame) dictate the final recoloring — placeholder color selects the shape, legend maps it to the output color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    frame_col, (fr0, fc0, fr1, fc1) = _find_frame(g, bg)\n\n    crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1]\n    H, W = crop.shape\n    assert H >= 3 and W >= 3, f\"frame too small for interior: {(H, W)}\"\n\n    # Placeholder components inside the frame interior.\n    inner_mask = np.zeros((H, W), dtype=bool)\n    inner_mask[1:-1, 1:-1] = True\n    placeholder_colors = set(map(int, np.unique(crop[inner_mask]))) - {bg, frame_col}\n    assert placeholder_colors, \"no placeholder colors found inside frame\"\n\n    placeholders: list[tuple[int, tuple[int, int, int, int]]] = []\n    for col in sorted(placeholder_colors):\n        for pts in components_mask((crop == col) & inner_mask, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            placeholders.append((col, (r0, c0, r1, c1)))\n    # Eval inputs use one placement bbox size per placeholder color.\n    phw: dict[int, tuple[int, int]] = {}\n    for col in placeholder_colors:\n        dims = [(b[2] - b[0] + 1, b[3] - b[1] + 1) for c, b in placeholders if c == col]\n        assert dims, f\"no placeholder component found for color {col}\"\n        unique_dims = sorted(set(dims))\n        assert len(unique_dims) == 1, f\"ambiguous placeholder sizes for color {col}: {unique_dims}\"\n        phw[col] = unique_dims[0]\n\n    # Extract outside-frame components for sprite shapes and for legend color mapping.\n    outside = np.ones(g.shape, dtype=bool)\n    outside[fr0 : fr1 + 1, fc0 : fc1 + 1] = False\n\n    # Collect all outside components (with ids) for later pairing.\n    comps = []\n    colors = [int(c) for c in np.unique(g) if int(c) not in (bg, frame_col)]\n    cid = 0\n    for col in colors:\n        for pts in components_mask((g == col) & outside, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            pts_tuples = [(int(r), int(c)) for r, c in pts]\n            comps.append(\n                {\n                    \"id\": cid,\n                    \"col\": int(col),\n                    \"pts\": pts_tuples,\n                    \"bbox\": (r0, c0, r1, c1),\n                    \"area\": len(pts_tuples),\n                }\n            )\n            cid += 1\n\n    def _bbox_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n        ar0, ac0, ar1, ac1 = a\n        br0, bc0, br1, bc1 = b\n        return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)\n\n    # Legend mapping: detect small two-color glyph regions where two components overlap in bbox\n    # and the union bbox contains only those two colors (no background).\n    color_map: dict[int, int] = {}\n    legend_ids: set[int] = set()\n\n    for i in range(len(comps)):\n        for j in range(i + 1, len(comps)):\n            ci = comps[i]\n            cj = comps[j]\n            if ci[\"col\"] == cj[\"col\"]:\n                continue\n            if not _bbox_overlap(ci[\"bbox\"], cj[\"bbox\"]):\n                continue\n            r0 = min(ci[\"bbox\"][0], cj[\"bbox\"][0])\n            c0 = min(ci[\"bbox\"][1], cj[\"bbox\"][1])\n            r1 = max(ci[\"bbox\"][2], cj[\"bbox\"][2])\n            c1 = max(ci[\"bbox\"][3], cj[\"bbox\"][3])\n            # restrict to compact legend-like regions\n            if (r1 - r0 + 1) > 8 or (c1 - c0 + 1) > 8:\n                continue\n            sub = g[r0 : r1 + 1, c0 : c1 + 1]\n            sub_colors = set(map(int, np.unique(sub))) - {frame_col}\n            if bg in sub_colors:\n                continue\n            if len(sub_colors) != 2:\n                continue\n            cset = set(sub_colors)\n            if ci[\"col\"] not in cset or cj[\"col\"] not in cset:\n                continue\n\n            # Decide source->target.\n            # If exactly one color is used as a placeholder inside the frame, that one is source.\n            if (ci[\"col\"] in placeholder_colors) ^ (cj[\"col\"] in placeholder_colors):\n                src = ci[\"col\"] if ci[\"col\"] in placeholder_colors else cj[\"col\"]\n                tgt = cj[\"col\"] if src == ci[\"col\"] else ci[\"col\"]\n            else:\n                # Otherwise: the larger component in this pair is treated as the source.\n                assert ci[\"area\"] != cj[\"area\"], f\"ambiguous equal-area legend pair: {ci['col']} and {cj['col']}\"\n                if ci[\"area\"] > cj[\"area\"]:\n                    src, tgt = ci[\"col\"], cj[\"col\"]\n                else:\n                    src, tgt = cj[\"col\"], ci[\"col\"]\n\n            assert src in placeholder_colors, f\"legend source color {src} is not a placeholder\"\n            assert src not in color_map, f\"duplicate legend mapping for placeholder color {src}\"\n            color_map[src] = int(tgt)\n            legend_ids.add(ci[\"id\"])\n            legend_ids.add(cj[\"id\"])\n    assert set(color_map) == placeholder_colors, (\n        f\"legend mappings {sorted(color_map)} do not match placeholders {sorted(placeholder_colors)}\"\n    )\n\n    # Sprite shapes: for each placeholder color, pick the non-legend component matching placeholder size.\n    sprite_coords: dict[int, tuple[tuple[tuple[int, int], ...], int, int]] = {}\n    for src_col in sorted(placeholder_colors):\n        all_candidates = [c for c in comps if c[\"col\"] == src_col and c[\"id\"] not in legend_ids]\n        assert all_candidates, f\"no non-legend sprite found for color {src_col}\"\n        want_h, want_w = phw[src_col]\n        sized = [\n            c\n            for c in all_candidates\n            if (c[\"bbox\"][2] - c[\"bbox\"][0] + 1) == want_h and (c[\"bbox\"][3] - c[\"bbox\"][1] + 1) == want_w\n        ]\n        assert len(sized) == 1, f\"expected one size-matched sprite for color {src_col}, found {len(sized)}\"\n        base = sized[0]\n        sr0, sc0, sr1, sc1 = base[\"bbox\"]\n\n        # Some sprites can be split into multiple 4-connected components of the same color.\n        # Merge any additional (non-legend) components fully contained in the chosen sprite bbox.\n        pts_set = set(base[\"pts\"])\n        for c in all_candidates:\n            if c[\"id\"] == base[\"id\"]:\n                continue\n            r0, c0, r1, c1 = c[\"bbox\"]\n            assert sr0 <= r0 and sr1 >= r1 and sc0 <= c0 and sc1 >= c1, (\n                f\"extra sprite component for color {src_col} is outside the base bbox\"\n            )\n            pts_set.update(c[\"pts\"])\n\n        coords = tuple(sorted((r - sr0, c - sc0) for r, c in pts_set))\n        sprite_coords[src_col] = (coords, sr1 - sr0 + 1, sc1 - sc0 + 1)\n\n    # Build output crop: keep frame border, clear interior to bg, then paste recolored sprites.\n    out = crop.copy()\n    out[1:-1, 1:-1] = bg\n\n    for src_col, (pr0, pc0, pr1, pc1) in placeholders:\n        assert src_col in sprite_coords and src_col in color_map, f\"placeholder color {src_col} missing sprite or color mapping\"\n        tgt_col = int(color_map[src_col])\n        coords, sh, sw = sprite_coords[src_col]\n        assert (pr1 - pr0 + 1, pc1 - pc0 + 1) == (sh, sw), (\n            f\"placeholder size does not match sprite for color {src_col}\"\n        )\n        assert pr0 + sh <= H and pc0 + sw <= W, f\"sprite for color {src_col} does not fit at placeholder\"\n        # Align sprite's bbox top-left to placeholder bbox top-left.\n        off_r = pr0\n        off_c = pc0\n        for dr, dc in coords:\n            rr, cc = off_r + dr, off_c + dc\n            out[rr, cc] = tgt_col\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# === CFG: tunables ===\nFRAME_COL = 5                       # frame border color (always gray)\nSPRITE_N_RANGE = (3, 6)             # NxN sprite/placeholder size, exclusive upper\nGRID_ROWS_RANGE = (2, 4)            # placeholder grid row count, exclusive upper\nGRID_COLS_RANGE = (3, 5)            # placeholder grid col count, exclusive upper\nTOTAL_BLOCKS_RANGE = (6, 10)        # total filled slots (inclusive)\nMAX_EMPTY_SLOTS = 2                 # max empty slots in the grid\nNUM_COLORS_RANGE = (2, 5)           # K = number of distinct placeholder colors (inclusive)\nSPRITE_FILL_MIN = 0.5               # min sprite fill ratio\nSPRITE_FILL_MAX = 0.9               # max sprite fill ratio (clamped to n*n-1)\nMIN_FRAME_H = 13                    # minimum frame height\nMIN_FRAME_W = 18                    # minimum frame width\nMAX_FRAME_DIM = 21                  # maximum frame height or width\nFRAME_MARGIN_SLACK = 4              # max extra padding inside frame beyond content\nCANVAS_H_RANGE = (22, 31)           # final grid height range, exclusive upper\nCANVAS_W_RANGE = (23, 31)           # final grid width range, exclusive upper\nFRAME_POS_JITTER_PROB = 0.25        # probability of non-edge frame placement per axis\nPATCH_PADDING = 1                   # min bg gap between placed patches\nGEN_RETRIES = 300                   # outer retry budget\n\n\ndef _legend(src: int, tgt: int) -> np.ndarray:\n    \"\"\"Build a 3x4 legend block mapping src color to tgt color.\"\"\"\n    return np.array(\n        [[src, src, tgt, tgt],\n         [src, src, src, tgt],\n         [src, src, tgt, tgt]], dtype=int)\n\n\ndef _sprite_mask(n: int) -> np.ndarray:\n    \"\"\"Generate a random NxN binary mask with fill ratio in [SPRITE_FILL_MIN, SPRITE_FILL_MAX].\"\"\"\n    lo = max((n * n + 1) // 2, int(np.ceil(SPRITE_FILL_MIN * n * n)))\n    hi = min(int(np.floor(SPRITE_FILL_MAX * n * n)), n * n - 1)\n    target = random.randint(lo, hi)\n\n    # Seed: random walk column + one full row, then random orientation\n    mask = np.zeros((n, n), dtype=bool)\n    c = random.randrange(n)\n    for r in range(n):\n        c = max(0, min(n - 1, c + random.choice([-1, 0, 1])))\n        mask[r, c] = True\n    mask[random.randrange(n), :] = True\n\n    if random.random() < 0.5:\n        mask = mask.T.copy()\n    if random.random() < 0.5:\n        mask = np.flipud(mask)\n    if random.random() < 0.5:\n        mask = np.fliplr(mask)\n\n    # Grow to target fill by adding random frontier cells\n    while int(mask.sum()) < target:\n        dilated = np.zeros_like(mask)\n        dilated[1:, :] |= mask[:-1, :]\n        dilated[:-1, :] |= mask[1:, :]\n        dilated[:, 1:] |= mask[:, :-1]\n        dilated[:, :-1] |= mask[:, 1:]\n        frontier = list(zip(*np.where(dilated & ~mask)))\n        r, c = random.choice(frontier)\n        mask[r, c] = True\n    return mask\n\n\ndef _colored_sprite(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\n    \"\"\"Render a binary mask as a colored sprite on bg.\"\"\"\n    out = np.full(mask.shape, bg, dtype=int)\n    out[mask] = int(color)\n    return out\n\n\ndef _content_extent(n: int, grid_rows: int, grid_cols: int) -> tuple[int, int]:\n    \"\"\"Content area needed for grid_rows x grid_cols of NxN blocks with 1-cell gaps.\"\"\"\n    return (grid_rows * n + grid_rows - 1, grid_cols * n + grid_cols - 1)\n\n\ndef _choose_structure() -> tuple[int, int, int, int, int] | None:\n    \"\"\"Pick (n, rows, cols, empty_count, total) satisfying frame size constraints.\"\"\"\n    total = random.randint(*TOTAL_BLOCKS_RANGE)\n    options = []\n    for n in range(*SPRITE_N_RANGE):\n        for rows in range(*GRID_ROWS_RANGE):\n            for cols in range(*GRID_COLS_RANGE):\n                ch, cw = _content_extent(n, rows, cols)\n                base_fh = ch + 4  # +2 border +2 min margin\n                base_fw = cw + 4\n                slots = rows * cols\n                empty = slots - total\n                if base_fh <= MAX_FRAME_DIM and base_fw <= MAX_FRAME_DIM and 0 <= empty <= MAX_EMPTY_SLOTS:\n                    options.append((n, rows, cols, empty, total))\n    return random.choice(options) if options else None\n\n\ndef _choose_empty_slots(\n    rows: int, cols: int, empty_count: int\n) -> tuple[set[tuple[int, int]], list[tuple[int, int]]]:\n    \"\"\"Choose which grid slots are empty, ensuring every row and column has at least one filled slot.\n\n    Returns (empty_slots, shuffled filled_slots).\n    \"\"\"\n    slots = [(r, c) for r in range(rows) for c in range(cols)]\n    valid = []\n    for combo in itertools.combinations(slots, empty_count):\n        empty = set(combo)\n        filled = [s for s in slots if s not in empty]\n        if len({r for r, _ in filled}) == rows and len({c for _, c in filled}) == cols:\n            valid.append(empty)\n    empty_slots = random.choice(valid)\n    filled_slots = [s for s in slots if s not in empty_slots]\n    random.shuffle(filled_slots)\n    return empty_slots, filled_slots\n\n\ndef _make_bordered_frame(h: int, w: int, bg: int) -> np.ndarray:\n    \"\"\"Create an h x w frame filled with bg and a 1-cell FRAME_COL border.\"\"\"\n    frame = np.full((h, w), bg, dtype=int)\n    frame[0, :] = frame[-1, :] = FRAME_COL\n    frame[:, 0] = frame[:, -1] = FRAME_COL\n    return frame\n\n\ndef _place_patch(\n    grid: np.ndarray, reserve: np.ndarray, patch: np.ndarray, bg: int,\n    *, transparent: bool,\n) -> bool:\n    \"\"\"Find a free location for patch and paste it onto grid/reserve. Returns success.\"\"\"\n    blocker = np.full(patch.shape, FRAME_COL, dtype=int)\n    try:\n        r, c = random_free_location(reserve, blocker, transparent=bg, padding=PATCH_PADDING)\n    except ValueError:\n        return False\n    paste(reserve, blocker, r, c)\n    paste(grid, patch, r, c, transparent=bg if transparent else None)\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    # --- structure ---\n    struct = _choose_structure()\n    if struct is None:\n        return None\n    n, rows, cols, empty_count, _ = struct\n\n    bg = random.choice([c for c in range(10) if c != FRAME_COL])\n    usable = [c for c in range(10) if c not in (bg, FRAME_COL)]\n\n    # --- colors ---\n    k = random.randint(*NUM_COLORS_RANGE)\n    src_cols = random.sample(usable, k)\n    tgt_cols = [random.choice([c for c in usable if c != src]) for src in src_cols]\n    color_to_tgt = dict(zip(src_cols, tgt_cols))\n    masks = {src: _sprite_mask(n) for src in src_cols}\n\n    # --- frame dimensions & margins ---\n    ch, cw = _content_extent(n, rows, cols)\n    min_fh = max(MIN_FRAME_H, ch + 4)\n    min_fw = max(MIN_FRAME_W, cw + 4)\n    frame_h = random.randint(min_fh, min(MAX_FRAME_DIM, max(min_fh, ch + 2 + FRAME_MARGIN_SLACK)))\n    frame_w = random.randint(min_fw, min(MAX_FRAME_DIM, max(min_fw, cw + 2 + FRAME_MARGIN_SLACK)))\n    y_margin = frame_h - 2 - ch\n    x_margin = frame_w - 2 - cw\n    top_margin = random.randint(1, y_margin - 1)\n    left_margin = random.randint(1, x_margin - 1)\n\n    # --- slot assignment ---\n    _, filled_slots = _choose_empty_slots(rows, cols, empty_count)\n    cell_colors = {}\n    for slot, col in zip(filled_slots[:k], src_cols):\n        cell_colors[slot] = col\n    for slot in filled_slots[k:]:\n        cell_colors[slot] = random.choice(src_cols)\n\n    # --- build input & output frames ---\n    input_frame = _make_bordered_frame(frame_h, frame_w, bg)\n    output_frame = _make_bordered_frame(frame_h, frame_w, bg)\n    for (rr, cc), src in cell_colors.items():\n        r0 = 1 + top_margin + rr * (n + 1)\n        c0 = 1 + left_margin + cc * (n + 1)\n        paste(input_frame, np.full((n, n), src, dtype=int), r0, c0)\n        paste(output_frame, _colored_sprite(masks[src], color_to_tgt[src], bg), r0, c0, transparent=bg)\n\n    # --- canvas selection & frame placement ---\n    ext_area = k * (12 + n * n + 10)\n    possible_dims = [\n        (h, w)\n        for h in range(*CANVAS_H_RANGE)\n        for w in range(*CANVAS_W_RANGE)\n        if h >= frame_h and w >= frame_w and h * w - frame_h * frame_w >= ext_area\n    ]\n    if not possible_dims:\n        return None\n    h, w = random.choice(possible_dims)\n    grid = np.full((h, w), bg, dtype=int)\n    reserve = np.full((h, w), bg, dtype=int)\n\n    fr0 = random.choice([0, h - frame_h])\n    fc0 = random.choice([0, w - frame_w])\n    if h - frame_h > 2 and random.random() < FRAME_POS_JITTER_PROB:\n        fr0 = random.randrange(0, h - frame_h + 1)\n    if w - frame_w > 2 and random.random() < FRAME_POS_JITTER_PROB:\n        fc0 = random.randrange(0, w - frame_w + 1)\n    paste(grid, input_frame, fr0, fc0)\n    paste(reserve, np.full((frame_h, frame_w), FRAME_COL, dtype=int), fr0, fc0)\n\n    # --- place external patches (sprites + legends) ---\n    patches: list[tuple[np.ndarray, bool]] = []\n    for src, tgt in zip(src_cols, tgt_cols):\n        patches.append((_colored_sprite(masks[src], src, bg), True))\n        patches.append((_legend(src, tgt), False))\n    random.shuffle(patches)\n    patches.sort(key=lambda item: item[0].size, reverse=True)\n    for patch, transparent in patches:\n        if not _place_patch(grid, reserve, patch, bg, transparent=transparent):\n            return None\n\n    # --- oracle check ---\n    try:\n        if not np.array_equal(main(grid), output_frame):\n            return None\n    except Exception:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        out = _gen_attempt()\n        if out is not None:\n            return out\n    raise RuntimeError(\"failed to generate valid edb79dae input\")\n","exit_code":0,"status":"completed"}}
