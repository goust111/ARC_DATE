{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport random, numpy as np, traceback\np=Path('/home/lixinyu/snap/a/des/code/combo_new/seed807260302/6/3.py')\nmod=SourceFileLoader('m',str(p)).load_module()\n\nfor attempt in range(20):\n    rng=random.Random()\n    h=rng.randint(mod.MIN_SIZE, mod.MAX_SIZE)\n    core_w=rng.randint(mod.MIN_SIZE, mod.MAX_SIZE)\n    input_w=core_w+1\n    row_lo,row_hi=2,h-3\n    col_lo,col_hi=2,core_w-3\n    max_h=min(mod.MAX_SEGMENTS, mod._max_spaced_count(row_lo,row_hi,mod.MIN_POSITION_GAP))\n    max_v=min(mod.MAX_SEGMENTS, mod._max_spaced_count(col_lo,col_hi,mod.MIN_POSITION_GAP))\n    if max_h < mod.MIN_SEGMENTS or max_v < mod.MIN_SEGMENTS:\n        print('small') ; continue\n    colors=rng.sample(mod.COLOR_POOL,3)\n    layer_order=colors[:]; rng.shuffle(layer_order)\n    n_h_colors=rng.choice([1,2])\n    h_colors=rng.sample(colors,n_h_colors)\n    v_colors=[color for color in colors if color not in h_colors]\n    n_h=rng.randint(max(mod.MIN_SEGMENTS,len(h_colors)),max_h)\n    n_v=rng.randint(max(mod.MIN_SEGMENTS,len(v_colors)),max_v)\n    rows=mod._sample_spaced(rng,n_h,row_lo,row_hi,mod.MIN_POSITION_GAP)\n    cols=mod._sample_spaced(rng,n_v,col_lo,col_hi,mod.MIN_POSITION_GAP)\n    if rows is None or cols is None:\n        print('spacing none', h, core_w, n_h,n_v,row_lo,row_hi,col_lo,col_hi); continue\n    h_segment_colors=mod._segment_colors(rng,h_colors,n_h)\n    v_segment_colors=mod._segment_colors(rng,v_colors,n_v)\n    min_row,max_row=min(rows),max(rows)\n    min_col,max_col=min(cols),max(cols)\n    if min_col < 1 or max_col + 1 > core_w - 2 or min_row < 1 or max_row + 1 > h - 1:\n        print('range fail'); continue\n    covers=[[[] for _ in range(core_w)] for _ in range(h)]\n    for r,color in zip(rows,h_segment_colors):\n        c0=rng.randint(0,min_col-1)\n        c1=rng.randint(max_col+1,core_w-2)\n        mod._paint_segment(covers,'h',int(color),int(r),int(c0),int(c1))\n    for c,color in zip(cols,v_segment_colors):\n        r0=rng.randint(0,min_row-1)\n        r1=rng.randint(max_row+1,h-1)\n        mod._paint_segment(covers,'v',int(color),int(c),int(r0),int(r1))\n    inp,expected=mod._render_from_covers(covers,layer_order,input_w)\n    try:\n        actual=mod.main(inp)\n    except Exception as e:\n        print('main exception', type(e).__name__, e)\n        print('shape',inp.shape,'colors',colors,'order',layer_order,'hcols',h_colors,'vcols',v_colors,'rows',rows,'cols',cols,'hseg',h_segment_colors,'vseg',v_segment_colors)\n        print(inp)\n        break\n    if not np.array_equal(actual,expected):\n        print('mismatch')\n        print('shape',inp.shape,'colors',colors,'order',layer_order,'hcols',h_colors,'vcols',v_colors,'rows',rows,'cols',cols,'hseg',h_segment_colors,'vseg',v_segment_colors)\n        print('inp\\\\n',inp)\n        print('actual\\\\n',actual)\n        print('expected\\\\n',expected)\n        break\n    print('ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
