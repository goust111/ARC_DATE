{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import get_bg, paste\nimport random\n\n\ndef _constant_non_bg_rows(g: np.ndarray, bg: int) -> list[int]:\n    return [\n        int(r)\n        for r in range(g.shape[0])\n        if bool(np.all(g[r, :] == g[r, 0])) and int(g[r, 0]) != int(bg)\n    ]\n\n\ndef _cell_signature(g: np.ndarray, r0: int, c0: int, size: int, bg: int) -> tuple[tuple[int, int, int], ...] | None:\n    cell = g[int(r0) : int(r0) + int(size), int(c0) : int(c0) + int(size)]\n    mask = cell != int(bg)\n    if not bool(mask.any()):\n        return None\n    return tuple(\n        (int(r), int(c), int(cell[r, c]))\n        for r, c in zip(*np.where(mask), strict=False)\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Look up query glyphs in a reference table and mark whether they form a line.\n\n    Input structure:\n    - Teal background with two full-width pink separator rows.\n    - Above the first separator is a query row of 5x5 glyph cells.\n    - Between separators is a reference table of the same 5x5 cells; a glyph is\n      identified by both its color and its 3x3 shape.\n\n    Rule:\n    - Green-fill the background inside every table cell whose glyph exactly\n      appears in the query row.\n    - If the matched table cells form one complete row or one complete column,\n      also green-fill the query band and the bottom verdict band.\n    - Otherwise leave the query band unchanged and fill the bottom verdict band red.\n\n    Key insight: The bottom color is not a count; it is the yes/no answer to\n    whether the queried glyphs align as a full row or column in the table.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n    cell_size = 5\n\n    sep_rows = _constant_non_bg_rows(g, bg)\n    assert len(sep_rows) >= 2, \"expected two full-width separator rows\"\n    top_sep = sep_rows[0]\n    bottom_sep = sep_rows[-1]\n\n    table_region = g[top_sep + 1 : bottom_sep, :]\n    table_fg = np.argwhere(table_region != bg)\n    assert table_fg.size, \"reference table must contain glyphs\"\n\n    first_glyph_r = top_sep + 1 + int(table_fg[:, 0].min())\n    first_glyph_c = int(table_fg[:, 1].min())\n    row0 = first_glyph_r - 1\n    col0 = first_glyph_c - 1\n\n    row_starts = list(range(row0, bottom_sep, cell_size))\n    row_starts = [r for r in row_starts if r + cell_size <= bottom_sep]\n    col_starts = list(range(col0, w, cell_size))\n    col_starts = [c for c in col_starts if c + cell_size <= w]\n    assert row_starts and col_starts, \"could not infer table cell grid\"\n\n    query_sigs = [\n        sig\n        for c in col_starts\n        if (sig := _cell_signature(g, 0, c, cell_size, bg)) is not None\n    ]\n    query_set = set(query_sigs)\n    assert len(query_sigs) == len(query_set), \"query glyphs should be distinct\"\n\n    out = g.copy()\n    selected: list[tuple[int, int]] = []\n    for ri, r in enumerate(row_starts):\n        for ci, c in enumerate(col_starts):\n            if _cell_signature(g, r, c, cell_size, bg) not in query_set:\n                continue\n            selected.append((int(ri), int(ci)))\n            cell = out[r : r + cell_size, c : c + cell_size]\n            cell[cell == bg] = 3\n\n    complete_query = len(query_sigs) == len(col_starts)\n    same_row = len({r for r, _c in selected}) == 1\n    same_col = len({c for _r, c in selected}) == 1\n    success = complete_query and len(selected) == len(query_sigs) and (same_row or same_col)\n\n    if success:\n        query_band = out[:top_sep, :]\n        query_band[query_band == bg] = 3\n        out[bottom_sep + 1 :, :] = 3\n    else:\n        out[bottom_sep + 1 :, :] = 2\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# -- Grid layout --\nGRID_H, GRID_W = 30, 22       # fixed canvas size\nTOP_SEP_ROW = 5                # query-band separator row\nBOTTOM_SEP_ROW = 27            # table-bottom separator row\nQUERY_BAND_H = 5               # height of query band (rows 0..4)\nVERDICT_ROW = 28               # verdict band starts here\n\n# -- Colors --\nBG = 8                         # teal background\nGREEN = 3                      # success / match highlight\nRED = 2                        # fail verdict\nSEP = 6                        # separator row color\nGLYPH_COLORS = (0, 1, 2, 4, 5, 6, 7, 9)  # 8 available glyph colors\n\n# -- Table geometry --\nTABLE_DIM = 4                  # 4x4 grid of cells\nCELL = 5                       # each cell is 5x5\nROWS = (7, 12, 17, 22)        # row offsets for 4 table rows\nCOLS = (1, 6, 11, 16)         # col offsets for 4 table columns\n\n# -- Glyph shape --\nFILL_MIN, FILL_MAX = 5, 9     # filled-pixel range per 3x3 glyph\nSHAPE_BASE_COUNTS = {5: 2, 6: 2, 7: 2, 8: 2, 9: 1}  # min shapes per fill-count\nMAX_SHAPES_PER_FILL = 5       # cap during random top-up\n\n# -- Color distribution --\nCOLOR_MIN, COLOR_MAX = 1, 3   # each color used 1-3 times across 16 cells\n\n# -- Outcome probabilities --\nP_SUCCESS = 0.4               # chance of success outcome\nP_QUERY_3 = 0.35              # chance of 3-query fail (vs 4-query fail)\nFAIL_MODES = (\"rect\", \"bent_row\", \"bent_col\", \"scatter_rows\", \"scatter_cols\")\n\n# -- Generation --\nMAX_RETRIES = 300\n\n\ndef _has_full_bbox(mask: int) -> bool:\n    \"\"\"True if the 3x3 bitmask spans all four edges (non-empty top/bottom/left/right rows).\"\"\"\n    bits = [(mask >> i) & 1 for i in range(9)]\n    return (\n        any(bits[0:3])\n        and any(bits[6:9])\n        and any(bits[i] for i in (0, 3, 6))\n        and any(bits[i] for i in (2, 5, 8))\n    )\n\n\nPATTERNS_BY_FILL = {\n    k: tuple(m for m in range(1 << 9) if m.bit_count() == k and _has_full_bbox(m))\n    for k in range(FILL_MIN, FILL_MAX + 1)\n}\n\n\ndef _balanced_color_list() -> list[int]:\n    \"\"\"Assign 16 colors (one per cell) so each of the 8 palette colors appears 1-3 times.\"\"\"\n    counts = {c: COLOR_MIN for c in GLYPH_COLORS}\n    extras = TABLE_DIM * TABLE_DIM - len(GLYPH_COLORS) * COLOR_MIN  # 16 - 8 = 8\n    for _ in range(extras):\n        choices = [c for c in GLYPH_COLORS if counts[c] < COLOR_MAX]\n        counts[random.choice(choices)] += 1\n    colors = [c for c, n in counts.items() for _ in range(n)]\n    random.shuffle(colors)\n    return colors\n\n\ndef _balanced_shape_masks() -> list[int]:\n    \"\"\"Pick 16 distinct 3x3 shape masks with a balanced distribution of fill counts.\"\"\"\n    counts = dict(SHAPE_BASE_COUNTS)\n    extras = TABLE_DIM * TABLE_DIM - sum(counts.values())  # 16 - 9 = 7\n    for _ in range(extras):\n        choices = [k for k in range(FILL_MIN, FILL_MAX) if counts[k] < MAX_SHAPES_PER_FILL]\n        counts[random.choice(choices)] += 1\n\n    masks: list[int] = []\n    for k, n in counts.items():\n        masks.extend(random.sample(PATTERNS_BY_FILL[k], n))\n    random.shuffle(masks)\n    return masks\n\n\ndef _glyph(mask: int, color: int) -> np.ndarray:\n    \"\"\"Render a 3x3 bitmask as a CELL x CELL array with 1-pixel border of BG.\"\"\"\n    cell = np.full((CELL, CELL), BG, dtype=int)\n    bits = np.array([(mask >> i) & 1 for i in range(9)], dtype=bool).reshape(3, 3)\n    cell[1:4, 1:4][bits] = color\n    return cell\n\n\ndef _line_cells() -> list[tuple[int, int]]:\n    \"\"\"Pick a complete row or column of 4 cells (shuffled order).\"\"\"\n    if random.random() < 0.5:\n        r = random.randrange(TABLE_DIM)\n        cells = [(r, c) for c in range(TABLE_DIM)]\n    else:\n        c = random.randrange(TABLE_DIM)\n        cells = [(r, c) for r in range(TABLE_DIM)]\n    random.shuffle(cells)\n    return cells\n\n\ndef _fail_cells(count: int) -> list[tuple[int, int]]:\n    \"\"\"Pick `count` distinct cells that do NOT all share a single row or column.\"\"\"\n    if count == 3:\n        rs = random.sample(range(TABLE_DIM), random.choice((2, 3)))\n        cs = random.sample(range(TABLE_DIM), random.choice((2, 3)))\n        cells = [(rs[0], cs[0]), (rs[1], cs[1])]\n        pool = [(r, c) for r in rs for c in cs if (r, c) not in cells]\n        cells.append(random.choice(pool))\n    else:\n        mode = random.choice(FAIL_MODES)\n        if mode == \"rect\":\n            rs = random.sample(range(TABLE_DIM), 2)\n            cs = random.sample(range(TABLE_DIM), 2)\n            cells = [(r, c) for r in rs for c in cs]\n        elif mode == \"bent_row\":\n            r = random.randrange(TABLE_DIM)\n            dropped_c = random.randrange(TABLE_DIM)\n            new_r = random.choice([rr for rr in range(TABLE_DIM) if rr != r])\n            cells = [(r, c) for c in range(TABLE_DIM) if c != dropped_c] + [(new_r, dropped_c)]\n        elif mode == \"bent_col\":\n            c = random.randrange(TABLE_DIM)\n            dropped_r = random.randrange(TABLE_DIM)\n            new_c = random.choice([cc for cc in range(TABLE_DIM) if cc != c])\n            cells = [(r, c) for r in range(TABLE_DIM) if r != dropped_r] + [(dropped_r, new_c)]\n        elif mode == \"scatter_rows\":\n            base_c = random.randrange(TABLE_DIM)\n            cols = [base_c] * TABLE_DIM\n            for r in random.sample(range(TABLE_DIM), random.choice((1, 2, 3))):\n                cols[r] = random.choice([c for c in range(TABLE_DIM) if c != base_c])\n            cells = [(r, cols[r]) for r in range(TABLE_DIM)]\n        else:\n            base_r = random.randrange(TABLE_DIM)\n            rows = [base_r] * TABLE_DIM\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/da6e95e5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/da6e95e5.py\"","aggregated_output":"from itertools import product\nfrom collections import defaultdict\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste, random_free_location\nimport random\n\n\nQUADS = ((0, 0), (0, 1), (1, 0), (1, 1))\n\n\ndef _record_components(g: np.ndarray, bg: int) -> list[dict]:\n    comps = []\n    for idx, comp in enumerate(\n        find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    ):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        comps.append(\n            {\n                **comp,\n                \"id\": idx,\n                \"h\": r1 - r0 + 1,\n                \"w\": c1 - c0 + 1,\n                \"cr2\": r0 + r1,\n                \"cc2\": c0 + c1,\n            }\n        )\n    return comps\n\n\ndef _bbox(comp: dict) -> tuple[int, int, int, int]:\n    return comp[\"bbox\"]\n\n\ndef _aligned_markers(markers: tuple[dict, dict, dict, dict]) -> bool:\n    bnw, bne, bsw, bse = map(_bbox, markers)\n    return (\n        (bnw[0], bnw[2]) == (bne[0], bne[2])\n        and (bsw[0], bsw[2]) == (bse[0], bse[2])\n        and (bnw[1], bnw[3]) == (bsw[1], bsw[3])\n        and (bne[1], bne[3]) == (bse[1], bse[3])\n        and bnw[2] < bsw[0]\n        and bne[2] < bse[0]\n        and bnw[3] < bne[1]\n        and bsw[3] < bse[1]\n    )\n\n\ndef _is_cluster(center: dict, markers: tuple[dict, dict, dict, dict]) -> bool:\n    nw, ne, sw, _ = markers\n    if not _aligned_markers(markers):\n        return False\n\n    r0, c0, r1, c1 = _bbox(center)\n    outer_r0 = min(_bbox(marker)[0] for marker in markers)\n    outer_c0 = min(_bbox(marker)[1] for marker in markers)\n    outer_r1 = max(_bbox(marker)[2] for marker in markers)\n    outer_c1 = max(_bbox(marker)[3] for marker in markers)\n\n    return (\n        outer_r0 <= r0 <= r1 <= outer_r1\n        and outer_c0 <= c0 <= c1 <= outer_c1\n        and nw[\"cr2\"] < center[\"cr2\"] < sw[\"cr2\"]\n        and nw[\"cc2\"] < center[\"cc2\"] < ne[\"cc2\"]\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Extract the central object from the marker cluster whose markers have the same color.\n\n    Input structure\n    The grid has a dominant background and several clusters; each cluster has four\n    same-color corner marker objects around one central monochromatic object.\n    Rule\n    Find every central object enclosed by four aligned corner markers of one color,\n    then choose the unique one whose object color equals the marker color.\n    Key insight\n    The answer is not the largest or most frequent object; it is the center of the\n    self-colored cluster, cropped to that object's bounding box with background kept.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    comps = _record_components(g, bg)\n\n    targets = {}\n    for center in comps:\n        by_marker_role = defaultdict(lambda: defaultdict(list))\n        for marker in comps:\n            if marker[\"id\"] == center[\"id\"]:\n                continue\n            if marker[\"cr2\"] == center[\"cr2\"] or marker[\"cc2\"] == center[\"cc2\"]:\n                continue\n            quad = (\n                0 if marker[\"cr2\"] < center[\"cr2\"] else 1,\n                0 if marker[\"cc2\"] < center[\"cc2\"] else 1,\n            )\n            key = (marker[\"color\"], marker[\"area\"], marker[\"h\"], marker[\"w\"])\n            by_marker_role[key][quad].append(marker)\n\n        for key, markers_by_quad in by_marker_role.items():\n            if not all(quad in markers_by_quad for quad in QUADS):\n                continue\n            for markers in product(*(markers_by_quad[quad] for quad in QUADS)):\n                if len({marker[\"id\"] for marker in markers}) != 4:\n                    continue\n                if _is_cluster(center, markers) and center[\"color\"] == key[0]:\n                    targets[center[\"id\"]] = center\n\n    assert len(targets) == 1\n    target = next(iter(targets.values()))\n    r0, c0, r1, c1 = _bbox(target)\n    out = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n    assert np.all((out == bg) | (out == target[\"color\"]))\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, palette, and placement.\nGRID_SHAPE = (30, 30)\nCOLOR_COUNT = 10\nPLACEMENT_BORDER = 1\n\n# Cluster structure and shared center bbox ranges.\nMARKER_SIZES = (2, 3)\nCENTER_BOUNDS_BY_MARKER = {\n    2: ((2, 4), (2, 5)),\n    3: ((3, 4), (3, 5)),\n}\nCLUSTER_COUNT_RANGE = (4, 6)\nCENTER_OFFSET = 2\n\n# Center sprite area and retry bounds.\nMIN_CENTER_AREA = 3\nMAX_CENTER_AREA = 14\nGEN_ATTEMPTS = 300\n\n\ndef _gen_l_marker(marker_size: int, color: int, bg: int) -> np.ndarray:\n    marker = np.full((marker_size, marker_size), bg, dtype=int)\n    marker[0, :] = color\n    marker[:, 0] = color\n    return marker\n\n\ndef _gen_center_mask(height: int, width: int, area: int) -> np.ndarray:\n    mask = np.zeros((height, width), dtype=bool)\n    if random.randrange(2):\n        r, c, end_r, end_c = 0, 0, height - 1, width - 1\n    else:\n        r, c, end_r, end_c = 0, width - 1, height - 1, 0\n\n    mask[r, c] = True\n    while (r, c) != (end_r, end_c):\n        if r < end_r:\n            r += 1\n        elif r > end_r:\n            r -= 1\n        if c < end_c:\n            c += 1\n        elif c > end_c:\n            c -= 1\n        mask[r, c] = True\n\n    while int(mask.sum()) < area:\n        candidates = set()\n        for rr, cc in np.argwhere(mask):\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    if dr == 0 and dc == 0:\n                        continue\n                    nr, nc = int(rr) + dr, int(cc) + dc\n                    if 0 <= nr < height and 0 <= nc < width and not mask[nr, nc]:\n                        candidates.add((nr, nc))\n        nr, nc = random.choice(tuple(candidates))\n        mask[nr, nc] = True\n    return mask\n\n\ndef _gen_center_patch(height: int, width: int, color: int, bg: int) -> np.ndarray:\n    min_area = max(MIN_CENTER_AREA, height, width)\n    max_area = min(MAX_CENTER_AREA, height * width - 1)\n    area = random.randint(min_area, max_area)\n    patch = np.full((height, width), bg, dtype=int)\n    patch[_gen_center_mask(height, width, area)] = color\n    return patch\n\n\ndef _gen_cluster_patch(\n    marker_size: int,\n    center_height: int,\n    center_width: int,\n    marker_color: int,\n    center_color: int,\n    bg: int,\n) -> tuple[np.ndarray, np.ndarray]:\n    overlap = marker_size - 2\n    center_r0 = CENTER_OFFSET\n    center_c0 = CENTER_OFFSET\n    bottom_r0 = center_r0 + center_height - overlap\n    right_c0 = center_c0 + center_width - overlap\n    patch = np.full((bottom_r0 + marker_size, right_c0 + marker_size), bg, dtype=int)\n\n    marker = _gen_l_marker(marker_size, marker_color, bg)\n    paste(patch, marker, 0, 0, transparent=bg)\n    paste(patch, np.fliplr(marker), 0, right_c0, transparent=bg)\n    paste(patch, np.flipud(marker), bottom_r0, 0, transparent=bg)\n    paste(patch, np.flipud(np.fliplr(marker)), bottom_r0, right_c0, transparent=bg)\n\n    center = _gen_center_patch(center_height, center_width, center_color, bg)\n    paste(patch, center, center_r0, center_c0, transparent=bg)\n    return patch, center\n\n\ndef _place_cluster_patches(patches: list[np.ndarray], bg: int) -> np.ndarray | None:\n    grid = np.full(GRID_SHAPE, bg, dtype=int)\n    occupied = np.zeros(GRID_SHAPE, dtype=int)\n    n_clusters = len(patches)\n    order = list(range(n_clusters))\n    random.shuffle(order)\n    try:\n        for idx in order:\n            patch = patches[idx]\n            h, w = patch.shape\n            rect = np.ones((h, w), dtype=int)\n            r0, c0 = random_free_location(\n                occupied, rect, transparent=0, border=PLACEMENT_BORDER\n            )\n            occupied[r0 : r0 + h, c0 : c0 + w] = 1\n            paste(grid, patch, r0, c0, transparent=bg)\n    except ValueError:\n        return None\n    return grid\n\n\ndef _solves_to_expected(grid: np.ndarray, expected: np.ndarray) -> bool:\n    try:\n        solved = main(grid)\n    except AssertionError:\n        return False\n    return np.array_equal(solved, expected)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = random.randrange(COLOR_COUNT)\n    marker_size = random.choice(MARKER_SIZES)\n    height_bounds, width_bounds = CENTER_BOUNDS_BY_MARKER[marker_size]\n    center_height = random.randint(height_bounds[0], height_bounds[1])\n    center_width = random.randint(width_bounds[0], width_bounds[1])\n\n    n_clusters = random.randint(CLUSTER_COUNT_RANGE[0], CLUSTER_COUNT_RANGE[1])\n    palette = [color for color in range(COLOR_COUNT) if color != bg]\n    colors = random.sample(palette, n_clusters + 1)\n    marker_colors = colors[:n_clusters]\n    extra_center_color = colors[-1]\n    target_idx = random.randrange(n_clusters)\n    extra_idx = random.choice([idx for idx in range(n_clusters) if idx != target_idx])\n\n    patches = []\n    expected = None\n","exit_code":0,"status":"completed"}}
