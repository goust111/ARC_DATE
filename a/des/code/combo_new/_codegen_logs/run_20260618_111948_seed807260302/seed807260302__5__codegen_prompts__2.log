:108:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/963c33f8.py:342:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:7:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:8:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:22:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:216:    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:367:    \"\"\"Return True if any patch cell has a non-bg 8-neighbor on canvas.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:394:    \"\"\"Return True when a cell and its in-bounds 8-neighborhood are bg.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:509:    \"\"\"Choose grid size/background and return matching output/input canvases.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:519:    \"\"\"Place distinct isolated border anchors into both canvases.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:535:    \"\"\"Expand anchor colors to the sprite count, allowing repeated markers.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:545:    \"\"\"Build sprites in their solved locations and return their align metadata.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:564:    \"\"\"Move solved sprites onto the input canvas along the inverse axis.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:576:    \"\"\"Apply generator invariants and the solver oracle check.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:582:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/5623160b.py:43:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/5623160b.py:44:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/5623160b.py:59:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/5623160b.py:149:    \"\"\"Grow a 4-connected polyomino of given size, normalized to (0, 0).\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/5623160b.py:213:    \"\"\"Place separated maroon components; returns (components, occupied) or None.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/5623160b.py:264:    \"\"\"Return (component index, outward side, contact cells) slots around markers.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/5623160b.py:332:    \"\"\"Try one side slot; mutates occupancy/output only after accepting a candidate.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/5623160b.py:377:    \"\"\"Place edge-output objects and retain their derived input coordinates.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/5623160b.py:457:def generate_input():\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:7:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:16:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:101:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:102:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:115:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:205:    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:214:    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:228:    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:240:    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:265:    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:275:    \"\"\"Return blob with interior holes absorbed.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:279:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:330:    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:346:    \"\"\"Place 1-2 legend patches at grid corners.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:349:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:380:    \"\"\"Grow irregular closed regions, one per assigned wall color.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:383:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:440:    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:468:    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:485:    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:489:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:533:    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:556:    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:604:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py:228:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py:229:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py:241:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py:506:    \"\"\"Return the interior endpoint of a bar placed along *edge*.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py:519:    \"\"\"Map local (fwd, side) coords to global (row, col) for a given edge/pos.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py:529:    \"\"\"Grow a 4-connected sprite from *start*, avoiding *forbidden* cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py:545:    \"\"\"Build an irregular 8-connected stroke going backward (away from border).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py:581:    \"\"\"Build the 3-phase monotone output segment in local coords.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py:593:    \"\"\"Return True if any cell in *coords_a* overlaps or is 4-adjacent to *coords_b*.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py:605:    \"\"\"Generate one bar+segment+obstacle triple in local coordinates (origin at terminal).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py:666:    \"\"\"Compute bounding box of *coords* expanded by PLACEMENT_PAD, clamped to [0, n-1].\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py:680:    \"\"\"Try to place a triple on *edge*, returning global coords or None.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py:706:    \"\"\"Single attempt: build grid with 1-3 triples, validate via oracle.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py:763:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
