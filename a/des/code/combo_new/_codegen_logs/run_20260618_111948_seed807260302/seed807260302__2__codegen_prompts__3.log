{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/1190bc91.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a sparse grid by casting occluding diagonal rays from the longest run and filling the remaining diagonal-connected regions from the short bars.\n\n    Input structure\n    - Black-background grid with one unique longest 4-connected foreground object.\n    - The longest object is a horizontal or vertical multicolor run; all other foreground objects are shorter monochrome bars.\n\n    Rule\n    - On a blank canvas, process the longest run from left to right or top to bottom; each pixel emits four 45-degree rays that stop at the first already-painted pixel.\n    - Each remaining monochrome bar fills every still-blank pixel reachable from it by diagonal steps.\n\n    Key insight\n    - Earlier pixels in the long run occlude later diagonal rays, and those ray barriers partition the background into diagonal-connected regions for the short bars.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert len(comps) >= 2, \"expected a main run plus at least one short bar\"\n\n    max_area = max(int(comp[\"area\"]) for comp in comps)\n    main_candidates = [comp for comp in comps if int(comp[\"area\"]) == max_area]\n    assert len(main_candidates) == 1, \"main run must be the unique largest foreground object\"\n\n    main = main_candidates[0]\n    main_coords = _component_coords(main)\n    assert len({int(g[r, c]) for r, c in main_coords}) >= 2, \"main run must be multicolor\"\n    ordered_main = _ordered_straight_run(main_coords)\n\n    out = np.full_like(g, bg)\n    for r, c in ordered_main:\n        color = int(g[r, c])\n        assert color != bg\n        assert out[r, c] == bg, \"main source pixel unexpectedly already painted\"\n        out[r, c] = color\n        for dr, dc in DIAG_DIRS:\n            nr, nc = r + dr, c + dc\n            while 0 <= nr < H and 0 <= nc < W and out[nr, nc] == bg:\n                out[nr, nc] = color\n                nr += dr\n                nc += dc\n\n    main_set = set(main_coords)\n    base = out.copy()\n    fill_regions: list[tuple[int, set[tuple[int, int]]]] = []\n    for comp in comps:\n        coords = _component_coords(comp)\n        if set(coords) == main_set:\n            continue\n\n        ordered_bar = _ordered_straight_run(coords)\n        colors = {int(g[r, c]) for r, c in ordered_bar}\n        assert len(colors) == 1, \"short bar must be monochrome\"\n        color = next(iter(colors))\n        assert color != bg\n        assert all(base[r, c] == bg for r, c in ordered_bar), \"short bar overlaps main rays\"\n\n        seen = set(ordered_bar)\n        q = deque(ordered_bar)\n        while q:\n            r, c = q.popleft()\n            for dr, dc in DIAG_DIRS:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < H and 0 <= nc < W and base[nr, nc] == bg and (nr, nc) not in seen:\n                    seen.add((nr, nc))\n                    q.append((nr, nc))\n        fill_regions.append((color, seen))\n\n    claimed: set[tuple[int, int]] = set()\n    for color, region in fill_regions:\n        assert claimed.isdisjoint(region), \"short-bar diagonal regions must be disjoint\"\n        claimed.update(region)\n        for r, c in region:\n            out[r, c] = color\n\n    for r, c in np.argwhere(g != bg):\n        assert out[int(r), int(c)] == int(g[int(r), int(c)]), \"input foreground must be preserved\"\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- Configuration ---\nGRID_SIZE_MIN, GRID_SIZE_MAX = 4, 10\nRUN_LENGTH_MIN, RUN_LENGTH_MAX = 3, 7    # main run pixel count\nPOS_MARGIN = 1                            # perpendicular position inset from grid edges\nCOLOR_MIN, COLOR_MAX = 1, 9              # non-background color range (inclusive)\nMAX_RETRIES = 300                         # generate_input() retry budget\n\n_DIAG_DIRS = ((-1, -1), (-1, 1), (1, -1), (1, 1))\n_ORTH_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n# Edge definitions: (name, pair_generator) -- each yields adjacent cell pairs along one edge.\n_EDGE_DEFS = {\n    \"top\":    lambda n: (((0, c), (0, c + 1)) for c in range(n - 1)),\n    \"bottom\": lambda n: (((n - 1, c), (n - 1, c + 1)) for c in range(n - 1)),\n    \"left\":   lambda n: (((r, 0), (r + 1, 0)) for r in range(n - 1)),\n    \"right\":  lambda n: (((r, n - 1), (r + 1, n - 1)) for r in range(n - 1)),\n}\n\n\ndef _diag_flood(ray, seeds):\n    \"\"\"BFS all zero-cells in *ray* diag-reachable from *seeds*. Returns the visited set (includes seeds).\"\"\"\n    n = ray.shape[0]\n    seen = set(seeds)\n    q = deque(seeds)\n    while q:\n        r, c = q.popleft()\n        for dr, dc in _DIAG_DIRS:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < n and 0 <= nc < n and ray[nr, nc] == 0 and (nr, nc) not in seen:\n                seen.add((nr, nc))\n                q.append((nr, nc))\n    return seen\n\n\ndef _cast_main_rays(n, orientation, length, pos, colors):\n    \"\"\"Place the main run and cast 4 diagonal rays from each pixel (with occlusion). Returns (ray_grid, coords) or (None, None).\"\"\"\n    ray = np.zeros((n, n), dtype=int)\n    if orientation == \"H\":\n        coords = [(pos, c) for c in range(n - length, n)]\n    else:\n        coords = [(r, pos) for r in range(n - length, n)]\n\n    for (r, c), color in zip(coords, colors):\n        if ray[r, c] != 0:\n            return None, None\n        ray[r, c] = color\n        for dr, dc in _DIAG_DIRS:\n            nr, nc = r + dr, c + dc\n            while 0 <= nr < n and 0 <= nc < n and ray[nr, nc] == 0:\n                ray[nr, nc] = color\n                nr += dr\n                nc += dc\n    return ray, coords\n\n\ndef _diag_labels(ray):\n    \"\"\"Label each diagonal-connected zero-region in *ray* with a unique integer. Non-zero cells get -1.\"\"\"\n    n = ray.shape[0]\n    labels = np.full_like(ray, -1, dtype=int)\n    next_label = 0\n    for sr, sc in np.argwhere(ray == 0):\n        sr, sc = int(sr), int(sc)\n        if labels[sr, sc] >= 0:\n            continue\n        for cell in _diag_flood(ray, [(sr, sc)]):\n            labels[cell] = next_label\n        next_label += 1\n    return labels\n\n\ndef _touches(cells, blocked):\n    \"\"\"True if any cell in *cells* is orthogonally adjacent to a cell in *blocked*.\"\"\"\n    for r, c in cells:\n        for dr, dc in _ORTH_DIRS:\n            if (r + dr, c + dc) in blocked:\n                return True\n    return False\n\n\ndef _edge_pairs(ray, labels, excluded_edge, blocked):\n    \"\"\"Find valid size-2 bar placements along grid edges (excluding *excluded_edge* and cells adjacent to *blocked*).\"\"\"\n    n = ray.shape[0]\n    pairs = []\n    for edge_name, gen_fn in _EDGE_DEFS.items():\n        if edge_name == excluded_edge:\n            continue\n        for pair in gen_fn(n):\n            if all(ray[p] == 0 for p in pair) and not _touches(pair, blocked):\n                pairs.append((pair, frozenset(int(labels[p]) for p in pair)))\n    return pairs\n\n\ndef _choose_bars(ray, main_coords, orientation):\n    \"\"\"Select 1 or 2 compatible bar placements from grid edges.\"\"\"\n    excluded_edge = \"right\" if orientation == \"H\" else \"bottom\"\n    labels = _diag_labels(ray)\n    candidates = _edge_pairs(ray, labels, excluded_edge, set(main_coords))\n    if not candidates:\n        return None\n\n    compatible_twos = []\n    for i, (pair_a, labels_a) in enumerate(candidates):\n        for pair_b, labels_b in candidates[i + 1:]:\n            if labels_a & labels_b or _touches(pair_b, set(pair_a)):\n                continue\n            compatible_twos.append((pair_a, pair_b))\n\n    if compatible_twos and random.choice((1, 2)) == 2:\n        return list(random.choice(compatible_twos))\n    return [random.choice(candidates)[0]]\n\n\ndef _bar_regions_disjoint(ray, bars):\n    \"\"\"Check that the diagonal flood regions of all bars are mutually disjoint.\"\"\"\n    claimed = set()\n    for pair in bars:\n        region = _diag_flood(ray, list(pair))\n        if claimed & region:\n            return False\n        claimed.update(region)\n    return True\n\n\ndef _build_output(ray, bars, bar_colors):\n    \"\"\"Overlay each bar's diagonal flood region onto the ray grid.\"\"\"\n    out = ray.copy()\n    for pair, color in zip(bars, bar_colors):\n        for r, c in _diag_flood(ray, list(pair)):\n            out[r, c] = color\n    return out\n\n\ndef _gen_attempt():\n    n = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    orientation = random.choice((\"H\", \"V\"))\n    length = random.randint(RUN_LENGTH_MIN, min(n - 1, RUN_LENGTH_MAX))\n    pos = random.randint(POS_MARGIN, n - 1 - POS_MARGIN)\n\n    colors = random.sample(range(COLOR_MIN, COLOR_MAX + 1), length)\n    ray, main_coords = _cast_main_rays(n, orientation, length, pos, colors)\n    if ray is None:\n        return None\n\n    bars = _choose_bars(ray, main_coords, orientation)\n    if not bars or not _bar_regions_disjoint(ray, bars):\n        return None\n\n    remaining = [c for c in range(COLOR_MIN, COLOR_MAX + 1) if c not in colors]\n    bar_colors = random.sample(remaining, len(bars))\n\n    inp = np.zeros((n, n), dtype=int)\n    for (r, c), color in zip(main_coords, colors):\n        inp[r, c] = color\n    for pair, color in zip(bars, bar_colors):\n        for r, c in pair:\n            inp[r, c] = color\n\n    expected = _build_output(ray, bars, bar_colors)\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\n\ndef generate_input():\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the region enclosed by a wall sprite and radiate color outward through its opening.\n\n    Input structure:\n    - bg = most common color. Wall = most frequent non-bg color, forming a partial enclosure (e.g. U-shape).\n    - A fill-color pixel sits inside the enclosed area. Other non-bg pixels may act as obstacles.\n    Rule:\n    - Flood-fill the enclosed area with the fill color, radiating outward through the wall's open end.\n    - Obstacles cast \"shadows\" along the radiate direction, blocking fill behind them.\n\n    Key insight: The wall endpoints define the opening direction; fill radiates outward through it, and obstacles block propagation along that same axis.\n    \"\"\"\n    g = np.array(grid, copy=True)\n    h, w = g.shape\n\n    vals = np.unique(g)\n    bg = get_bg(g)\n\n    non_bg = [int(v) for v in vals if int(v) != bg]\n    assert non_bg, \"expected at least one non-background color\"\n\n    # Wall: most frequent non-background color.\n    wall = max(non_bg, key=lambda c: int((g == c).sum()))\n\n    wall_mask = g == wall\n\n    # Wall connected components (8-neigh).\n    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]\n    assert comps, \"expected at least one wall connected component\"\n\n    def sgn(x: int) -> int:\n        return (x > 0) - (x < 0)\n\n    other_colors = [c for c in non_bg if c != wall]\n    assert other_colors, \"expected at least one non-wall color (fill color)\"\n\n    # Pick fill color as the non-wall color closest (Manhattan distance) to the wall pixels.\n    wall_points = [p for comp in comps for p in comp]\n\n    def min_dist_to_wall(color: int) -> tuple[int, int]:\n        pts = list(zip(*np.where(g == color)))\n        pts = [(int(r), int(c)) for r, c in pts]\n        best_d = 10**9\n        for r, c in pts:\n            for wr, wc in wall_points:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0, len(pts)\n        return best_d, len(pts)\n\n    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))\n\n    fill_pos = list(zip(*np.where(g == fill)))\n    fill_pos = [(int(r), int(c)) for r, c in fill_pos]\n    if not fill_pos:\n        return g\n\n    # Choose the closest wall component to the fill seed (ties: larger component).\n    def comp_min_dist(comp: set[tuple[int, int]]) -> int:\n        best_d = 10**9\n        for r, c in fill_pos:\n            for wr, wc in comp:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0\n        return best_d\n\n    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))\n\n    comp_mask = np.zeros_like(wall_mask, dtype=bool)\n    for r, c in wall_comp:\n        comp_mask[r, c] = True\n\n    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:\n        out = []\n        for rr, cc in neighbors8(r, c):\n            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:\n                out.append((rr, cc))\n        return out\n\n    endpoints: list[tuple[int, int]] = []\n    for r, c in wall_comp:\n        if len(comp_neighbors(r, c)) == 1:\n            endpoints.append((r, c))\n\n    assert endpoints, \"expected wall component to have endpoints (degree-1 pixels)\"\n\n    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:\n        n1 = comp_neighbors(*ep)[0]\n        d1 = (sgn(n1[0] - ep[0]), sgn(n1[1] - ep[1]))  # inward\n        d_use = d1\n        is_12 = False\n        n2s = [p for p in comp_neighbors(*n1) if p != ep]\n        if n2s:\n            n2 = n2s[0]\n            d2 = (sgn(n2[0] - n1[0]), sgn(n2[1] - n1[1]))\n            if (d1[0] == 0) ^ (d1[1] == 0):\n                if d2[0] != 0 and d2[1] != 0:\n                    d_use = d2\n                    is_12 = True\n        return (-d_use[0], -d_use[1]), is_12\n\n    out_info = [outward_dir(ep) for ep in endpoints]\n    out_dirs = [d for d, _ in out_info]\n    tip_12 = [f for _, f in out_info]\n\n    dr_sum = sum(d[0] for d in out_dirs)\n    dc_sum = sum(d[1] for d in out_dirs)\n    rad = (sgn(dr_sum), sgn(dc_sum))\n\n    barrier = comp_mask.copy()\n\n    def add_ray(start: tuple[int, int], d: tuple[int, int], skip: int = 0) -> None:\n        rr, cc = start\n        for _ in range(skip):\n            rr += d[0]\n            cc += d[1]\n        while True:\n            rr += d[0]\n            cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:\n        rr, cc = start\n        step = 0\n        while True:\n            step += 1\n            if step % 2 == 1:\n                rr += d[0]; cc += d[1]\n            else:\n                if rad[0] != 0:\n                    rr += d[0]\n                else:\n                    cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):\n        if is_12:\n            add_ray_12(ep, d)\n        else:\n            add_ray(ep, d, skip=0)\n\n    passable = (~barrier) & ((g == bg) | (g == fill))\n    q = fill_pos[:]\n    seen = np.zeros_like(passable, dtype=bool)\n    for r, c in q:\n        if passable[r, c]:\n            seen[r, c] = True\n    while q:\n        r, c = q.pop()\n        for rr, cc in neighbors4(r, c):\n            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:\n                seen[rr, cc] = True\n                q.append((rr, cc))\n\n    filled_mask = (seen & (g == bg))\n\n    out = g.copy()\n    out[filled_mask] = fill\n\n    # Shadow behind obstacles (non-bg, non-fill, non-wall) along radiate direction.\n    obstacles = (g != bg) & (g != fill) & (g != wall)\n\n    def shadow_process(coords: list[tuple[int, int]]) -> None:\n        started = False\n        blocked = False\n        for r, c in coords:\n            if filled_mask[r, c]:\n                started = True\n            if started and obstacles[r, c]:\n                blocked = True\n                continue\n            if blocked and filled_mask[r, c]:\n                out[r, c] = bg\n                filled_mask[r, c] = False\n\n    if rad != (0, 0):\n        dr, dc = rad\n        if dr != 0 and dc == 0:\n            for c in range(w):\n                rows = range(h) if dr > 0 else range(h - 1, -1, -1)\n                shadow_process([(r, c) for r in rows])\n        elif dc != 0 and dr == 0:\n            for r in range(h):\n                cols = range(w) if dc > 0 else range(w - 1, -1, -1)\n                shadow_process([(r, c) for c in cols])\n        else:\n            # Diagonal scanlines\n            if dr == dc:\n                # r - c = const\n                for k in range(-(w - 1), h):\n                    coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]\n                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n                    shadow_process(coords)\n            else:\n                # r + c = const\n                for k in range(h + w - 1):\n                    coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]\n                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n                    shadow_process(coords)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom scipy.ndimage import distance_transform_cdt\n\n# -- Configuration constants --------------------------------------------------\n# Canvas size bounds\nGRID_H_VERT = (11, 18)       # height range when radiate_dir is vertical\nGRID_H_HORIZ = (8, 18)       # height range when radiate_dir is horizontal\nGRID_W = (15, 19)             # width range (all directions)\n\n# Wall geometry\nWALL_PIXELS_MIN = 17          # minimum wall pixel count\nWALL_PIXELS_MAX = 25          # maximum wall pixel count\nDEPTH_VERT = (5, 10)          # arm depth range for vertical radiate\nDEPTH_HORIZ = (6, 8)          # arm depth range for horizontal radiate\nGAP_VERT = (6, 7)             # endpoint gap for vertical radiate\nGAP_HORIZ = (5, 7)            # endpoint gap for horizontal radiate\nTIP_12_PROB = 0.5             # probability of 1:2 arm-angle mode (when eligible)\n\n# Placement margins\nOPEN_END_MARGIN = 3           # min cells from open end to radiate grid edge\n\n# Fill seed\nSEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]  # weighted choices for blob size\nSEED_DEPTH_LOOKBACK = 3       # seed must be within this many rows of closed end\n\n# Obstacles\nMAX_OBSTACLES = 5             # maximum obstacle pixel count\nOBSTACLE_IN_FILL_PROB = 0.65  # probability of forcing at least one obstacle in fill zone\nOBSTACLE_MIN_SEP = 2          # Chebyshev distance between obstacles (> this value)\n\n# Validation\nMIN_NEW_FILL = 20             # minimum newly-filled pixels for a valid output\nPALETTE_SIZE = (3, 5)         # number of distinct colors (bg + wall + fill + obstacle(s))\nGEN_RETRIES = 300             # max attempts in generate_input\n\n\ndef _degree1_pixels(points):\n    \"\"\"Return degree-1 pixels (exactly one 8-neighbor in the set).\"\"\"\n    pts = set(points)\n    return [(r, c) for r, c in pts\n            if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1]\n\n\ndef _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):\n    \"\"\"Build one zigzag arm from (0, start_v) toward (depth, target_v).\"\"\"\n    sign = 1 if target_v > start_v else -1\n    n_side_steps = abs(target_v - start_v)\n    chosen_rows = []\n    if n_side_steps:\n        if tip_12:\n            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]\n            extra_steps = 0\n        else:\n            chosen_rows = [1]\n            if n_side_steps > 1:\n                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)\n            chosen_rows.sort()\n\n    first_row = chosen_rows[0] if chosen_rows else 1\n    extra_rows = [r for r in chosen_rows if r != first_row]\n    random.shuffle(extra_rows)\n    orthogonal_rows = set(extra_rows[:extra_steps])\n\n    pts = [(0, start_v)]\n    u, v = 0, start_v\n    for row in range(1, depth + 1):\n        u += 1\n        if row in orthogonal_rows:\n            pts.append((u, v))\n            v += sign\n        elif row in chosen_rows:\n            v += sign\n        pts.append((u, v))\n    return pts\n\n\ndef _build_local_wall(rad, h, w):\n    \"\"\"Construct wall shape in local (u, v) coordinates. Returns (pts, depth, gap) or None.\"\"\"\n    if rad[0]:\n        max_depth = min(DEPTH_VERT[1], h - 6)\n        if max_depth < DEPTH_VERT[0]:\n            return None\n        depth = random.randint(DEPTH_VERT[0], max_depth)\n        gap = random.randint(*GAP_VERT)\n    else:\n        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))\n        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))\n\n    if gap == 5:\n        left_bottom, right_bottom = 2, 3\n    elif gap == 6:\n        left_bottom, right_bottom = 2, 4\n    else:\n        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])\n\n    bridge_extra = max(0, right_bottom - left_bottom - 1)\n    base_count = 2 * (depth + 1) + bridge_extra\n    max_extra_l = max(0, left_bottom - 1)\n    max_extra_r = max(0, gap - right_bottom - 1)\n    min_extra = max(0, WALL_PIXELS_MIN - base_count)\n    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)\n    if min_extra > max_extra:\n        return None\n\n    extra = random.randint(min_extra, max_extra)\n    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))\n    extra_r = extra - extra_l\n\n    max_n_side = max(left_bottom, gap - right_bottom)\n    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB\n    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)\n    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)\n    pts = set(left) | set(right)\n    for v in range(left_bottom, right_bottom + 1):\n        pts.add((depth, v))\n\n    # Pad wall to minimum size by adding 8-connected pixels that preserve 2 endpoints\n    while len(pts) < WALL_PIXELS_MIN:\n        candidates = [\n            (u, v) for u in range(max(0, depth - 3), depth + 1)\n            for v in range(gap + 1) if (u, v) not in pts\n            and sum((uu, vv) in pts\n                    for uu in range(u - 1, u + 2)\n                    for vv in range(v - 1, v + 2)\n                    if (uu, vv) != (u, v)) >= 2\n        ]\n        random.shuffle(candidates)\n        added = False\n        for p in candidates:\n            trial = pts | {p}\n            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:\n                pts = trial\n                added = True\n                break\n        if not added:\n            return None\n\n    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:\n        return None\n    return pts, depth, gap\n\n\ndef _map_local(u, v, rad, anchor):\n    \"\"\"Map local (u, v) to grid (r, c) given radiate direction and anchor.\"\"\"\n    r0, c0 = anchor\n    if rad == (-1, 0):\n        return r0 + u, c0 + v\n    if rad == (1, 0):\n        return r0 - u, c0 + v\n    if rad == (0, -1):\n        return r0 + v, c0 + u\n    return r0 + v, c0 - u\n\n\ndef _place_anchor(rad, h, w, depth, gap):\n    \"\"\"Choose anchor so the wall fits within margins.\"\"\"\n    if rad == (-1, 0):\n        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)\n    if rad == (1, 0):\n        return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)\n    if rad == (0, -1):\n        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)\n    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)\n\n\ndef _local_interior(wall, depth, gap):\n    \"\"\"Return bg cells strictly between the two wall arms in local coords.\"\"\"\n    by_row = {}\n    for u, v in wall:\n        by_row.setdefault(u, []).append(v)\n    interior = []\n    for u in range(1, depth):\n        if u not in by_row or len(by_row[u]) < 2:\n            continue\n        lo, hi = min(by_row[u]), max(by_row[u])\n        for v in range(lo + 1, hi):\n            if (u, v) not in wall:\n                interior.append((u, v))\n    return interior\n\n\ndef _grow_seed_blob(seed, interior_set):\n    \"\"\"Grow a small 4-connected blob from seed within interior cells.\"\"\"\n    blob = {seed}\n    target_size = random.choice(SEED_SIZE_WEIGHTS)\n    frontier = [seed]\n    while len(blob) < target_size and frontier:\n        p = frontier.pop(random.randrange(len(frontier)))\n        u, v = p\n        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):\n            if q in interior_set and q not in blob:\n                blob.add(q)\n                frontier.append(q)\n                if len(blob) >= target_size:\n                    break\n    return blob\n\n\ndef _obstacle_fits(pos, placed):\n    \"\"\"Check that pos is at least Chebyshev OBSTACLE_MIN_SEP from all placed obstacles.\"\"\"\n    r, c = pos\n    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)\n\n\ndef _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone):\n    \"\"\"Find bg cells far enough from wall for obstacle placement, using distance transform.\"\"\"\n    wall_mask = grid == wall_color\n    # distance_transform_cdt with chessboard metric gives Chebyshev distance to wall\n    dist = distance_transform_cdt(~wall_mask, metric='taxicab')\n    far_from_wall = dist > 1\n    eligible = (grid == bg) & far_from_wall\n    all_coords = list(zip(*np.where(eligible)))\n    fill_coords = [p for p in all_coords if nominal_fill_zone[p[0], p[1]]]\n    random.shuffle(all_coords)\n    random.shuffle(fill_coords)\n    return [(int(r), int(c)) for r, c in all_coords], [(int(r), int(c)) for r, c in fill_coords]\n\n\ndef _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid):\n    \"\"\"Place up to n_obstacles on the grid, preferring some in the fill zone.\"\"\"\n    placed = []\n    n_fill = random.randint(0, min(n_obstacles, len(fill_candidates)))\n    if fill_candidates and random.random() < OBSTACLE_IN_FILL_PROB:\n        n_fill = max(1, n_fill)\n    for p in fill_candidates:\n        if len(placed) >= n_fill:\n            break\n        if _obstacle_fits(p, placed):\n            placed.append(p)\n    placed_set = set(placed)\n    for p in candidates:\n        if len(placed) >= n_obstacles:\n            break\n        if p not in placed_set and _obstacle_fits(p, placed):\n            placed.append(p)\n            placed_set.add(p)\n    for i, (r, c) in enumerate(placed):\n        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]\n\n\ndef _touches_border(mask):\n    \"\"\"Check if any True cell in mask lies on the grid border.\"\"\"\n    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())\n\n\ndef _gen_attempt():\n    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])\n    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)\n    w = random.randint(*GRID_W)\n\n    built = _build_local_wall(rad, h, w)\n    if built is None:\n        return None\n    local_wall, depth, gap = built\n    anchor = _place_anchor(rad, h, w, depth, gap)\n\n    # Choose palette\n    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))\n    bg, wall_color, fill_color = palette[:3]\n    obstacle_colors = palette[3:]\n\n    # Render wall onto grid\n    grid = np.full((h, w), bg, dtype=int)\n    for u, v in local_wall:\n        r, c = _map_local(u, v, rad, anchor)\n        grid[r, c] = wall_color\n\n    # Place fill seed near the closed end\n    interior = _local_interior(local_wall, depth, gap)\n    wall_set = set(local_wall)\n    adjacent = [\n        p for p in interior\n        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])\n    ]\n    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]\n    if not seed_pool:\n        return None\n\n    blob = _grow_seed_blob(random.choice(seed_pool), set(interior))\n    for u, v in blob:\n        r, c = _map_local(u, v, rad, anchor)\n        if grid[r, c] != bg:\n            return None\n        grid[r, c] = fill_color\n\n    # Run solver to find nominal fill zone (used for obstacle placement)\n    try:\n        nominal_out = main(grid)\n    except Exception:\n        return None\n    nominal_fill_zone = (nominal_out == fill_color) & (grid == bg)\n\n    # Place obstacles\n    n_obstacles = random.randint(0, MAX_OBSTACLES)\n    if n_obstacles and not obstacle_colors:\n        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]\n        obstacle_colors = random.sample(available, random.randint(1, 2))\n    if n_obstacles:\n        candidates, fill_candidates = _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone)\n        _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid)\n\n    # Validate: solver must produce enough fill that reaches a border\n    try:\n        out = main(grid)\n    except Exception:\n        return None\n    new_fill = (out == fill_color) & (grid == bg)\n    if int(new_fill.sum()) < MIN_NEW_FILL or not _touches_border(new_fill):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, table, frame, and slot dimensions.\nCANVAS_MIN, CANVAS_MAX = 13, 19\nTABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\nROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\nAXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n\n# Object and palette sampling limits.\nN_COLORS, MAX_OBJECT_COLORS = 10, 6\nMAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\nOBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n\n# Rejection sampling cap.\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_axis_options(n_slots, slot_min, slot_max):\n    options = []\n\n    def rec_slots(i, cur):\n        if i == n_slots:\n            rec_seps(0, [], cur)\n            return\n        for size in range(slot_min, slot_max + 1):\n            rec_slots(i + 1, cur + [size])\n\n    def rec_seps(i, cur, slots):\n        if i == n_slots - 1:\n            for before in AXIS_OUTER_OPTIONS:\n                for after in AXIS_OUTER_OPTIONS:\n                    for pad_before in AXIS_PADDING_OPTIONS:\n                        for pad_after in AXIS_PADDING_OPTIONS:\n                            total = (\n                                before\n                                + after\n                                + pad_before\n                                + pad_after\n                                + sum(slots)\n                                + sum(cur)\n                            )\n                            if 13 <= total <= 19:\n                                options.append(\n                                    (\n                                        tuple(slots),\n                                        tuple(cur),\n                                        before,\n                                        after,\n                                        pad_before,\n                                        pad_after,\n                                        total,\n                                )\n                            )\n            return\n        for sep in AXIS_SEPARATOR_OPTIONS:\n            rec_seps(i + 1, cur + [sep], slots)\n\n    rec_slots(0, [])\n    return options\n\n\ndef _gen_positions(axis):\n    sizes, seps, outer_before, _outer_after, pad_before, _pad_after, _total = axis\n    starts = []\n    pos = outer_before + pad_before\n    for i, size in enumerate(sizes):\n        starts.append(pos)\n        pos += size\n        if i < len(seps):\n            pos += seps[i]\n    return starts\n\n\ndef _gen_choose_axis(n_slots, slot_min, slot_max, other_axis=None, max_object_loss=0):\n    options = _gen_axis_options(n_slots, slot_min, slot_max)\n    if other_axis is None:\n        return random.choice(options)\n\n    good = []\n    for axis in options:\n        row_axis = axis if slot_max == ROW_SLOT_SIZE_RANGE[1] else other_axis\n        col_axis = axis if slot_max == COL_SLOT_SIZE_RANGE[1] else other_axis\n        height = row_axis[-1]\n        width = col_axis[-1]\n        frame_height = height - row_axis[2] - row_axis[3]\n        frame_width = width - col_axis[2] - col_axis[3]\n        slot_area = sum(row_axis[0]) * sum(col_axis[0])\n        outer_bg = height * width - frame_height * frame_width\n        bg_room = outer_bg + slot_area - max_object_loss\n        frame_area = frame_height * frame_width - slot_area\n        if bg_room > frame_area:\n            good.append(axis)\n    return random.choice(good or options)\n\n\ndef _gen_assign_colors(shape, bg, frame):\n    n_slots = shape[0] * shape[1]\n    filled_count = random.randint(1, n_slots - 1)\n    filled = random.sample(range(n_slots), filled_count)\n    colors = [c for c in range(N_COLORS) if c not in (bg, frame)]\n    n_colors = random.randint(1, min(MAX_OBJECT_COLORS, filled_count, len(colors)))\n    palette = random.sample(colors, n_colors)\n    assignments = palette[:]\n    assignments.extend(random.choice(palette) for _ in range(filled_count - n_colors))\n    random.shuffle(assignments)\n\n    out = np.full(shape, bg, dtype=int)\n    for idx, color in zip(filled, assignments):\n        out[idx // shape[1], idx % shape[1]] = color\n    return out, filled_count\n\n\ndef _gen_object_shape(slot_h, slot_w):\n    by_area = {}\n    for obj_h in range(1, min(MAX_OBJECT_HEIGHT, slot_h - 2 * OBJECT_MARGIN) + 1):\n        for obj_w in range(1, min(MAX_OBJECT_WIDTH, slot_w - 2 * OBJECT_MARGIN) + 1):\n            by_area.setdefault(obj_h * obj_w, []).append((obj_h, obj_w))\n    area = random.choice(list(by_area))\n    return random.choice(by_area[area])\n\n\ndef _gen_choose_layout(rows, cols, filled_count):\n    row_axis = _gen_choose_axis(rows, *ROW_SLOT_SIZE_RANGE)\n    loss = MAX_OBJECT_AREA * filled_count\n    col_axis = _gen_choose_axis(cols, *COL_SLOT_SIZE_RANGE, row_axis, max_object_loss=loss)\n    return row_axis, col_axis, _gen_positions(row_axis), _gen_positions(col_axis)\n\n\ndef _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts):\n    height = row_axis[-1]\n    width = col_axis[-1]\n    grid = np.full((height, width), bg, dtype=int)\n    rt, rb = row_axis[2], row_axis[3]\n    cl, cr = col_axis[2], col_axis[3]\n    grid[rt : height - rb, cl : width - cr] = frame\n\n    for r, slot_h in zip(row_starts, row_axis[0]):\n        for c, slot_w in zip(col_starts, col_axis[0]):\n            grid[r : r + slot_h, c : c + slot_w] = bg\n    return grid\n\n\ndef _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts):\n    for out_r, slot_r in enumerate(row_starts):\n        slot_h = row_axis[0][out_r]\n        for out_c, slot_c in enumerate(col_starts):\n            color = int(out[out_r, out_c])\n            if color == bg:\n                continue\n            slot_w = col_axis[0][out_c]\n            obj_h, obj_w = _gen_object_shape(slot_h, slot_w)\n            obj_r = random.randint(slot_r + OBJECT_MARGIN, slot_r + slot_h - obj_h - OBJECT_MARGIN)\n            obj_c = random.randint(slot_c + OBJECT_MARGIN, slot_c + slot_w - obj_w - OBJECT_MARGIN)\n            grid[obj_r : obj_r + obj_h, obj_c : obj_c + obj_w] = color\n\n\ndef _gen_is_valid(grid, out, bg, frame):\n    counts = np.bincount(grid.ravel(), minlength=N_COLORS)\n    if int(np.argmax(counts)) != bg:\n        return False\n    if counts[frame] <= max(counts[c] for c in range(N_COLORS) if c not in (bg, frame)):\n        return False\n    try:\n        actual = main(grid)\n    except Exception:\n        return False\n    return bool(np.array_equal(actual, out))\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rows = random.randint(*TABLE_ROWS_RANGE)\n    cols = random.randint(*TABLE_COLS_RANGE)\n    bg, frame = random.sample(range(N_COLORS), 2)\n\n    out, filled_count = _gen_assign_colors((rows, cols), bg, frame)\n    row_axis, col_axis, row_starts, col_starts = _gen_choose_layout(rows, cols, filled_count)\n    grid = _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts)\n    _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts)\n\n    if _gen_is_valid(grid, out, bg, frame):\n        return grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
