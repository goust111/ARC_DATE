{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '18,86p' /home/lixinyu/snap/new/ARC_code/train/458e3a53.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extract the compact table of solid cells hidden inside a separator lattice.\n\n    Input structure\n    - The grid has full-width and full-height bars of one separator color, dividing it into rectangular cells.\n    - Most cells contain a repeating multicolor pattern, while a contiguous rectangle of cells is solid monochrome.\n\n    Rule\n    - Split the input into lattice cells using the full separator rows and columns.\n    - Keep the cells whose full interior is one color, crop to their occupied rectangle, and output those colors.\n\n    Key insight\n    - The periodic pattern is noise; only completely solid lattice cells encode the reduced output grid.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    row_colors = {int(g[r, 0]) for r in range(h) if np.all(g[r, :] == g[r, 0])}\n    col_colors = {int(g[0, c]) for c in range(w) if np.all(g[:, c] == g[0, c])}\n    sep_colors = row_colors & col_colors\n    assert len(sep_colors) == 1, \"there must be exactly one row/column separator color\"\n    sep = next(iter(sep_colors))\n    assert row_colors == {sep}, \"all full rows must be separator rows\"\n    assert col_colors == {sep}, \"all full columns must be separator columns\"\n\n    sep_rows = [r for r in range(h) if np.all(g[r, :] == sep)]\n    sep_cols = [c for c in range(w) if np.all(g[:, c] == sep)]\n    assert sep_rows and sep_cols, \"separator lattice must have rows and columns\"\n\n    row_bands = _bands(h, sep_rows)\n    col_bands = _bands(w, sep_cols)\n\n    solid_cells = {}\n    for ri, (r0, r1) in enumerate(row_bands):\n        for ci, (c0, c1) in enumerate(col_bands):\n            cell = g[r0 : r1 + 1, c0 : c1 + 1]\n            if np.all(cell == cell[0, 0]):\n                solid_cells[(ri, ci)] = int(cell[0, 0])\n    assert solid_cells, \"must contain at least one solid lattice cell\"\n\n    solid_rows = [ri for ri, _ in solid_cells]\n    solid_cols = [ci for _, ci in solid_cells]\n    r0, r1 = min(solid_rows), max(solid_rows)\n    c0, c1 = min(solid_cols), max(solid_cols)\n\n    out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)\n    for ri in range(r0, r1 + 1):\n        for ci in range(c0, c1 + 1):\n            assert (ri, ci) in solid_cells, \"solid lattice cells must form a rectangle\"\n            out[ri - r0, ci - c0] = solid_cells[(ri, ci)]\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Lattice dimensions: valid (L, cell_size) pairs produce 27-30 square grids.\nVALID_LC = [(4, 6), (5, 5), (6, 4)]\nCOLOR_COUNT = 10\nSEPARATOR_WIDTH = 1\n# Solid rectangle: output block size in lattice coordinates.\nSOLID_SIZE_RANGE = (2, 3)\n# Pattern cells: diagonal variants are multicolor and solver-visible as non-solid.\nPATTERN_TILE_MIN_COLORS = 5\nPATTERN_CELL_MIN_COLORS = 2\nDIAGONAL_ID_BITS = 4\n# Retry budget: regenerate on rare validation failures.\nMAX_GENERATION_ATTEMPTS = 300\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '258,332p' /home/lixinyu/snap/new/ARC_code/eval/f560132c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble scattered jigsaw pieces into a rectangle, recoloring each by a legend sprite's color map.\n\n    Input structure:\n    - bg = most common color.\n    - Several monochrome non-bg sprites (the \"pieces\"), scattered across the grid.\n    - One sprite is the legend: it contains a multi-color k×k patch (typically 2×2) encoding output colors.\n\n    Rule:\n    - Tile all pieces (rotations/reflections allowed) into a tight rectangle with no gaps.\n    - The legend's k×k color patch defines a spatial color map over the rectangle.\n    - Each piece is recolored to the legend-map color corresponding to its position in the assembled rectangle.\n\n    Key insight: The legend piece doubles as both a jigsaw piece and a color key — its internal k×k palette assigns colors by spatial quadrant.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    comps = components_mask(g != bg, connectivity=4)\n    assert comps, 'grid must contain at least one non-background component'\n\n    # Identify legend component (most distinct colors) and infer k from number of pieces.\n    k = int(round(len(comps) ** 0.5))\n    assert k * k == len(comps), 'piece count must be a perfect square to determine k'\n\n    comp_colors = []\n    for pts in comps:\n        cols = set(int(g[r, c]) for r, c in pts if int(g[r, c]) != bg)\n        comp_colors.append(cols)\n\n    max_distinct = max(len(cols) for cols in comp_colors)\n    legend_candidates = [i for i, cols in enumerate(comp_colors) if len(cols) == max_distinct]\n    assert len(legend_candidates) == 1, 'legend component must be uniquely identified by distinct colors'\n    legend_idx = legend_candidates[0]\n    legend_map = _extract_legend_map(g, comps[legend_idx], k)\n\n    # Build piece masks (coords in bbox space), including filled holes.\n    pieces: list[dict] = []\n    for pts in comps:\n        filled_abs, _ = _fill_holes_in_component(g, pts, bg)\n        r0, c0, _, _ = bbox_coords(np.asarray(list(filled_abs)))\n        rel = tuple((r - r0, c - c0) for r, c in filled_abs)\n        rel_norm, _, _ = _normalize_coords(rel)\n        oris = _dihedral_orientations(rel_norm)\n        pieces.append({\"oris\": oris, \"area\": len(filled_abs)})\n\n    return _assemble_exact_cover(pieces, legend_idx, legend_map, k)\n\n# --------------- generator (o5x) ---------------\n\n# === CFG ===\nSIDE_CHOICES = [8, 10, 12]                     # output square side lengths\nK = 2                                          # k*k quadrant grid (2*2 = 4 pieces)\nNUM_PIECES = K * K                             # total jigsaw pieces\nNUM_COLORS = 8                                 # 4 body + 4 palette, all distinct non-bg\nAREA_FRAC_LO = 0.08                           # min piece area as fraction of total\nAREA_FRAC_HI = 0.43                           # max piece area as fraction of total\nAREA_ABS_LO = 11                              # absolute min piece area (cells)\nAREA_ABS_HI = 62                              # absolute max piece area (cells)\nLEGEND_THRESHOLD = {8: 4, 10: 5, 12: 9}       # min extent threshold per side for legend L-shape\nLEGEND_CORE_SIZE = 4                           # legend always has a 4x4 filled corner block\nLEGEND_ARM_RANGE = range(1, 4)                 # arm width/height options for L-shape construction\nPARTITION_GROWTH_EXP = 1.45                    # exponent penalizing large regions during partition\nPARTITION_FRONTIER_EXP = 0.2                   # exponent boosting regions with wide frontiers\nPARTITION_SEED_JITTER = 0.2                    # random jitter when selecting seed cells\nINPUT_SIZE_LO = 20                             # min input grid side\nINPUT_SIZE_HI = 26                             # max input grid side\nDENSITY_LO = 0.15                              # min non-bg density target\nDENSITY_HI = 0.25                              # max non-bg density target\nSCATTER_BORDER = 1                             # border margin when placing pieces\nSCATTER_PADDING = 1                            # gap between piece bounding boxes\nGEN_RETRIES = 300                              # max attempts in generate_input()\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '163,190p' /home/lixinyu/snap/new/ARC_code/train/458e3a53.py\"","aggregated_output":"def _gen_attempt() -> np.ndarray | None:\n    lattice, csize = random.choice(VALID_LC)\n    sep = random.randrange(COLOR_COUNT)\n    colors = [c for c in range(COLOR_COUNT) if c != sep]\n    block, out = _sample_solid_block(lattice, colors)\n    tiles = _pattern_tiles(csize, lattice, sep)\n    if not tiles:\n        return None\n    grid = _render_grid(lattice, csize, sep, block, out, tiles)\n    if not _valid_generated_grid(grid, lattice, csize, sep, block):\n        return None\n    try:\n        if not np.array_equal(main(grid), out):\n            return None\n    except AssertionError:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 458e3a53 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '500,552p' /home/lixinyu/snap/new/ARC_code/eval/f560132c.py\"","aggregated_output":"def _gen_attempt():\n    \"\"\"Single generation attempt: build tiling, validate, scatter pieces.\"\"\"\n    side = random.choice(SIDE_CHOICES)\n    min_area, max_area = _area_bounds(side)\n    legend = _make_legend_mask(side, min_area, max_area)\n    labels = _partition_rest(~legend)\n    if labels is None:\n        return None\n\n    masks = [legend] + [labels == i for i in range(3)]\n    areas = [int(m.sum()) for m in masks]\n    if any(a < min_area or a > max_area for a in areas):\n        return None\n    if any(len(components_mask(m, connectivity=4)) != 1 or _has_hole(m) for m in masks):\n        return None\n    if not _forces_unique_square(masks, side):\n        return None\n\n    # Compute centroid quadrant for each piece; all 4 must be distinct.\n    qcells = []\n    for mask in masks:\n        pts = np.argwhere(mask)\n        qcells.append((min(1, int(pts[:, 0].mean() * K / side)), min(1, int(pts[:, 1].mean() * K / side))))\n    if len(set(qcells)) != NUM_PIECES:\n        return None\n\n    colors = random.sample(range(1, 10), NUM_COLORS)\n    body_colors = colors[:NUM_PIECES]\n    palette_colors = colors[NUM_PIECES:]\n    random.shuffle(palette_colors)\n    legend_map = np.array(palette_colors, dtype=int).reshape(K, K)\n\n    expected = np.zeros((side, side), dtype=int)\n    for pi, mask in enumerate(masks):\n        rr, cc = qcells[pi]\n        expected[mask] = legend_map[rr, cc]\n\n    grid = _scatter_pieces(masks, body_colors, legend_map, side)\n    if grid is None:\n        return None\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid\n\n\ndef generate_input():\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError('failed to generate f560132c input')\n","exit_code":0,"status":"completed"}}
