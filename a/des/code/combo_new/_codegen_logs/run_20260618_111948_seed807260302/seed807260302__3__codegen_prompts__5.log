{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport random, numpy as np\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed807260302/3/5.py')\nmod = SourceFileLoader('m', str(p)).load_module()\ncounts={k:0 for k in ['shape_mask','place_shapes','place_patterns','oracle','success']}\nfor i in range(1000):\n    rng=random.Random()\n    sub_h=rng.randint(9,12); sub_w=rng.randint(9,12)\n    height=2*sub_h+1; width=2*sub_w+1\n    grid=np.full((height,width), mod.BLACK, dtype=int)\n    grid[sub_h,:]=mod.AZURE; grid[:,sub_w]=mod.AZURE\n    if min(sub_h,sub_w)>=11:\n        shape_count=rng.randint(3,5)\n    elif min(sub_h,sub_w)==10:\n        shape_count=rng.choice([3,4])\n    else:\n        shape_count=3\n    colors=rng.sample(list(mod.COLOR_POOL), shape_count+3)\n    shape_colors=colors[:shape_count]; pattern_colors=colors[shape_count:]\n    hole_counts=[0,1,2]+[rng.randrange(3) for _ in range(shape_count-3)]\n    rng.shuffle(hole_counts)\n    specs=[]; bad=False\n    for color, holes in zip(shape_colors,hole_counts):\n        mask=mod._shape_mask(rng, holes)\n        if mask is None:\n            counts['shape_mask']+=1; bad=True; break\n        specs.append({'color': int(color), 'holes': int(holes), 'mask': mask})\n    if bad: continue\n    placed=mod._place_shapes(grid, sub_h, sub_w, specs, rng)\n    if placed is None:\n        counts['place_shapes']+=1; continue\n    if not mod._place_patterns(grid, sub_h, sub_w, sub_w, pattern_colors, rng):\n        counts['place_patterns']+=1; continue\n    expected=mod._expected_output(grid, placed, pattern_colors, sub_h, sub_w)\n    try:\n        got=mod.main(grid)\n    except Exception as e:\n        counts['oracle']+=1\n        if counts['oracle'] <= 3:\n            print('exception', type(e), e, 'shape_count', shape_count, 'sub', sub_h, sub_w, 'holes', hole_counts)\n        continue\n    if not np.array_equal(got, expected):\n        counts['oracle']+=1\n        if counts['oracle'] <= 3:\n            print('mismatch', 'shape_count', shape_count, 'sub', sub_h, sub_w, 'holes', hole_counts, 'pat', pattern_colors)\n            print(grid)\n            print('expected\\\\n', expected)\n            print('got\\\\n', got)\n        continue\n    counts['success']+=1\nprint(counts)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
