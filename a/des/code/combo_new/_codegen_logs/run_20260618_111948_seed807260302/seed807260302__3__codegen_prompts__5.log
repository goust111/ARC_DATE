{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '8,120p' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py && sed -n '291,476p' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\ndef _gen_attempt():\n    reached = random.random() < 0.5\n    n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])\n\n    min_size = max(10, 5 * n)\n    if min_size > 20:\n        return None\n    G = random.randint(min_size, 20)\n    H = W = G\n\n    min_spacing = n + 1\n    max_coarse = max(3, (G - 2) // min_spacing)\n    coarse_dim = random.randint(3, min(6, max_coarse))\n    coarse_rows = coarse_cols = coarse_dim\n\n    offsets_r = _compute_offsets(G, n, coarse_rows)\n    offsets_c = _compute_offsets(G, n, coarse_cols)\n    if offsets_r is None or offsets_c is None:\n        return None\n    for i in range(len(offsets_r) - 1):\n        if offsets_r[i + 1] - offsets_r[i] < n:\n            return None\n    for i in range(len(offsets_c) - 1):\n        if offsets_c[i + 1] - offsets_c[i] < n:\n            return None\n\n    edge_cells = set()\n    for c in range(coarse_cols):\n        edge_cells.add((0, c))\n        edge_cells.add((coarse_rows - 1, c))\n    for r in range(1, coarse_rows - 1):\n        edge_cells.add((r, 0))\n        edge_cells.add((r, coarse_cols - 1))\n    edge_cells = list(edge_cells)\n    random.shuffle(edge_cells)\n    start_coarse = edge_cells[0]\n    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))\n    end_coarse = far[0] if far[0] != start_coarse else far[1]\n\n    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)\n    if walk is None or len(walk) < 4:\n        return None\n    if len(set(cr for cr, _ in walk)) < coarse_rows or len(set(cc for _, cc in walk)) < coarse_cols:\n        return None\n\n    grid = np.full((H, W), _BG, dtype=int)\n    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)\n\n    mask = (grid != _BG)\n    if np.any(mask, axis=1).sum() / H < 0.70 or np.any(mask, axis=0).sum() / W < 0.70:\n        return None\n\n    mover_r, mover_c = pixel_pos[0]\n    dest_r, dest_c = pixel_pos[-1]\n\n    # Extend dest to touch grid edge\n    def _extend_to_edge(pr, pc):\n        candidates = []\n        for direction in ['top', 'bottom', 'left', 'right']:\n            if direction == 'top':\n                dist = pr\n                if dist == 0:\n                    candidates.append((0, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n) if c < W):\n                    candidates.append((0, pc, dist))\n            elif direction == 'bottom':\n                dist = H - (pr + n)\n                if dist == 0:\n                    candidates.append((pr, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n) if c < W):\n                    candidates.append((H - n, pc, dist))\n            elif direction == 'left':\n                dist = pc\n                if dist == 0:\n                    candidates.append((pr, 0, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc) if r < H):\n                    candidates.append((pr, 0, dist))\n            elif direction == 'right':\n                dist = W - (pc + n)\n                if dist == 0:\n                    candidates.append((pr, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W) if r < H):\n                    candidates.append((pr, W - n, dist))\n        if not candidates:\n            return None\n        candidates.sort(key=lambda x: x[2])\n        return candidates[0][:2]\n\n    result = _extend_to_edge(dest_r, dest_c)\n    if result is None:\n        return None\n    new_dest_r, new_dest_c = result\n    if new_dest_r != dest_r:\n        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n\n        grid[r_lo:r_hi, dest_c:dest_c + n] = _RIVER\n    if new_dest_c != dest_c:\n        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n\n        grid[dest_r:dest_r + n, c_lo:c_hi] = _RIVER\n    dest_r, dest_c = new_dest_r, new_dest_c\n    if not (dest_r == 0 or dest_r + n == H or dest_c == 0 or dest_c + n == W):\n        return None\n\n    # Mover: near edge but not touching\n    touching = (mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W)\n    if touching:\n        if mover_r == 0:\n            grid[0, mover_c:mover_c + n] = _RIVER; mover_r = 1\n        elif mover_r + n == H:\n            grid[H - 1, mover_c:mover_c + n] = _RIVER; mover_r = H - n - 1\n        elif mover_c == 0:\n            grid[mover_r:mover_r + n, 0] = _RIVER; mover_c = 1\n        elif mover_c + n == W:\n            grid[mover_r:mover_r + n, W - 1] = _RIVER; mover_c = W - n - 1\n    if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:\n        return None\n    if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:\n        return None\n\n    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\n    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _RIVER\n\n    # Chokepoints for stuck case\n    if not reached and n >= 2:\n        num_choke = random.randint(1, min(3, len(walk) - 2))\n        min_seg = max(1, len(walk) // 4)\n        available = list(range(min_seg, len(walk) - 1))\n        random.shuffle(available)\n        for seg_idx in available[:num_choke]:\n            pr1, pc1 = pixel_pos[seg_idx]\n            pr2, pc2 = pixel_pos[min(seg_idx + 1, len(pixel_pos) - 1)]\n            direction = 'h' if pr1 == pr2 else 'v'\n            _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)\n        if not _river_connected(grid):\n            return None\n\n    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _MOVER\n    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _DEST\n\n    trav = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)\n    h2, w2 = H - n + 1, W - n + 1\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if trav[r:r + n, c:c + n].all():\n                feasible[r, c] = True\n    if not feasible[mover_r, mover_c]:\n        return None\n\n    dist = _bfs_placement(feasible, mover_r, mover_c)\n    dest_ok = (0 <= dest_r < h2 and 0 <= dest_c < w2 and\n               feasible[dest_r, dest_c] and dist[dest_r, dest_c] >= 0)\n    if reached and not dest_ok:\n        return None\n    if not reached and dest_ok:\n        return None\n\n    if dest_ok:\n        tr, tc = dest_r, dest_c\n    else:\n        best_d = -1\n        tr, tc = mover_r, mover_c\n        for r in range(h2):\n            for c in range(w2):\n                if dist[r, c] > best_d:\n                    best_d = dist[r, c]\n                    tr, tc = r, c\n\n    output = grid.copy()\n    output[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\n    output[tr:tr + n, tc:tc + n] = _MOVER\n\n    if not np.array_equal(main(grid), output):\n        return None\n    return grid\n\n\ndef generate_input():\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '5,120p' /home/lixinyu/snap/new/ARC_code/eval/16b78196.py && sed -n '378,700p' /home/lixinyu/snap/new/ARC_code/eval/16b78196.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '5,120p' /home/lixinyu/snap/new/ARC_code/eval/16b78196.py && sed -n '378,700p' /home/lixinyu/snap/new/ARC_code/eval/16b78196.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble colored sprites into a central bar's notches, chaining successive pieces along fixed-width strips.\n\n    Input structure:\n    - bg = most common color. Largest monochrome component is a solid \"bar\" with boundary notches (bg holes opening to its bbox edge).\n    - Several smaller colored sprites scattered around the bar.\n\n    Rule:\n    - Each bar notch is filled by a root piece whose shape exactly covers the hole.\n    - The root defines a strip (column-span or row-span) for its chain.\n    - Successive pieces fill the bg cells inside the previous piece's bbox, locked to the same strip width.\n    - Multiple chains grow independently from different bar notches.\n\n    Key insight: The root piece's extent perpendicular to the chain direction locks the strip width for all subsequent pieces in that chain.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    bg = get_bg(g)\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n    comps.sort(key=lambda d: -d[\"area\"])\n    assert comps\n\n    bar = comps[0]\n    pieces_raw = comps[1:]\n\n    out = np.full((H, W), int(bg), dtype=int)\n    bar_r0, bar_c0, bar_r1, bar_c1 = map(int, bar[\"bbox\"])\n    bar_h, bar_w = bar_r1 - bar_r0 + 1, bar_c1 - bar_c0 + 1\n    bar_color = int(bar[\"color\"])\n    bar_occ = set((int(r), int(c)) for r, c in bar[\"coords\"])\n    bar_mask = np.zeros((bar_h, bar_w), dtype=bool)\n    for r, c in bar_occ:\n        bar_mask[r - bar_r0, c - bar_c0] = True\n    for r, c in bar_occ:\n        out[r, c] = bar_color\n\n    def shape_from_coords(coords: np.ndarray, bbox):\n        r0, c0, r1, c1 = map(int, bbox)\n        h, w = r1 - r0 + 1, c1 - c0 + 1\n        rel = [(int(r - r0), int(c - c0)) for r, c in coords]\n        rel_set = set(rel)\n        return {\"rel\": rel, \"rel_set\": rel_set, \"h\": h, \"w\": w}\n\n    pieces = []\n    for p in pieces_raw:\n        # For this puzzle, pieces are used in their original orientation (no rotation / flip).\n        r0, c0 = map(int, p[\"bbox\"][:2])\n        pieces.append({\"color\": int(p[\"color\"]), \"shape\": shape_from_coords(p[\"coords\"], p[\"bbox\"]), \"orig\": (r0, c0)})\n\n    def bar_notches(bar_mask, bar_r0, bar_c0):\n        empty = ~bar_mask\n        h, w = map(int, empty.shape)\n        notches = []\n        for pts in components_mask(empty, connectivity=4):\n            r = pts[:, 0]\n            c = pts[:, 1]\n            top = int((r == 0).sum())\n            bottom = int((r == h - 1).sum())\n            left = int((c == 0).sum())\n            right = int((c == w - 1).sum())\n\n            # Keep only holes that open to the bar bbox boundary.\n            if top + bottom + left + right == 0:\n                continue\n\n            hole_gl = set((bar_r0 + int(rr), bar_c0 + int(cc)) for rr, cc in pts)\n\n            # Axis is determined by which bbox side has the widest mouth.\n            side, mouth_n = max(\n                [(name, cnt) for name, cnt in [(\"top\", top), (\"bottom\", bottom), (\"left\", left), (\"right\", right)] if cnt > 0],\n                key=lambda x: x[1],\n            )\n            axis = \"cols\" if side in (\"top\", \"bottom\") else \"rows\"\n            notches.append({\"axis\": axis, \"hole\": hole_gl, \"mouth_n\": mouth_n})\n        return notches\n\n    notches = bar_notches(bar_mask, bar_r0, bar_c0)\n\n    def pixels(v, top, left):\n        return set((top + lr, left + lc) for lr, lc in v[\"rel\"])\n\n    def placement_pts(v, top, left, occ, must_cover=None, strip=None):\n        if top < 0 or left < 0 or top + v[\"h\"] > H or left + v[\"w\"] > W:\n            return None\n        if strip is not None:\n            axis, A, B = strip\n            if axis == \"cols\":\n                if left != A or v[\"w\"] != B - A + 1:\n                    return None\n            else:\n                if top != A or v[\"h\"] != B - A + 1:\n                    return None\n        pts = pixels(v, top, left)\n        if pts & occ:\n            return None\n        if must_cover is not None and not (must_cover <= pts):\n            return None\n        return pts\n\n    def aligned_positions(axis, A, cover, v):\n        if axis == \"cols\":\n            left = A\n            tops = set()\n            for rN, cN in cover:\n                for lr, lc in v[\"rel\"]:\n                    if cN == left + lc:\n                        tops.add(rN - lr)\n            for top in tops:\n                yield top, left\n        else:\n            top = A\n            lefts = set()\ndef _gen_attempt():\n    \"\"\"Build one (input, output) pair; returns (input, output) or None.\"\"\"\n    import random as _random\n    rng = _random.Random()\n    H, W = 30, 30\n    bg = 0\n\n    # ---- bar ----------------------------------------------------------\n    orientation = rng.choice([\"horizontal\", \"vertical\"])\n    bar_color = rng.randint(1, 9)\n    thickness = rng.randint(5, 7)\n\n    if orientation == \"horizontal\":\n        center = int(rng.uniform(0.35, 0.53) * H)\n        bar_r0 = max(0, center - thickness // 2)\n        bar_r1 = bar_r0 + thickness - 1\n        if bar_r1 >= H:\n            bar_r1 = H - 1; bar_r0 = bar_r1 - thickness + 1\n        bar_c0, bar_c1 = 0, W - 1\n        space_before, space_after = bar_r0, H - 1 - bar_r1\n    else:\n        center = int(rng.uniform(0.35, 0.53) * W)\n        bar_c0 = max(0, center - thickness // 2)\n        bar_c1 = bar_c0 + thickness - 1\n        if bar_c1 >= W:\n            bar_c1 = W - 1; bar_c0 = bar_c1 - thickness + 1\n        bar_r0, bar_r1 = 0, H - 1\n        space_before, space_after = bar_c0, W - 1 - bar_c1\n\n    bar_h, bar_w = bar_r1 - bar_r0 + 1, bar_c1 - bar_c0 + 1\n    bar_cells = set((r, c) for r in range(bar_r0, bar_r1 + 1)\n                    for c in range(bar_c0, bar_c1 + 1))\n\n    # ---- plan chains --------------------------------------------------\n    num_chains = rng.randint(1, 2)\n    chain_lens = [3] if num_chains == 1 else [rng.randint(2, 3) for _ in range(2)]\n    if num_chains == 2:\n        while not (3 <= sum(chain_lens) <= 6):\n            chain_lens = [rng.randint(2, 3) for _ in range(2)]\n\n    avail_colors = [c for c in range(1, 10) if c != bar_color]\n    rng.shuffle(avail_colors)\n    color_idx = 0\n\n    all_chain_pieces = []\n    notch_holes: list[set] = []\n    occ_set = set(bar_cells)\n\n    for chain_idx in range(num_chains):\n        chain_len = chain_lens[chain_idx]\n        strip_width = rng.randint(4, 5)\n\n        # pick side with enough room\n        if orientation == \"horizontal\":\n            sides = [\"top\", \"bottom\"]; rng.shuffle(sides)\n            side = next((s for s in sides\n                         if (space_before if s == \"top\" else space_after) >= chain_len * 2 + 3), None)\n            if side is None:\n                return None\n            sc0 = rng.randint(1, W - strip_width - 1); sc1 = sc0 + strip_width - 1\n            sA, sB = sc0, sc1\n        else:\n            sides = [\"left\", \"right\"]; rng.shuffle(sides)\n            side = next((s for s in sides\n                         if (space_before if s == \"left\" else space_after) >= chain_len * 2 + 3), None)\n            if side is None:\n                return None\n            sr0 = rng.randint(1, H - strip_width - 1); sr1 = sr0 + strip_width - 1\n            sA, sB = sr0, sr1\n\n        # ---- notch (hole carved in bar) ----\n        notch_depth = rng.randint(1, 2)\n        notch_area = rng.randint(1, min(4, notch_depth * strip_width))\n\n        if orientation == \"horizontal\":\n            nr0 = bar_r0 if side == \"top\" else bar_r1 - notch_depth + 1\n            nr1 = bar_r0 + notch_depth - 1 if side == \"top\" else bar_r1\n            n_avail = {(r, c) for r in range(nr0, nr1 + 1)\n                       for c in range(sc0, sc1 + 1) if (r, c) in bar_cells}\n        else:\n            nc0 = bar_c0 if side == \"left\" else bar_c1 - notch_depth + 1\n            nc1 = bar_c0 + notch_depth - 1 if side == \"left\" else bar_c1\n            n_avail = {(r, c) for r in range(sA, sB + 1)\n                       for c in range(nc0, nc1 + 1) if (r, c) in bar_cells}\n\n        # keep away from existing notch holes\n        all_holes = set().union(*notch_holes) if notch_holes else set()\n        n_avail -= all_holes | {(r + dr, c + dc)\n                                for r, c in all_holes for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]}\n        if len(n_avail) < notch_area:\n            return None\n\n        notch = _grow_connected(rng, n_avail, notch_area, {rng.choice(list(n_avail))})\n        if notch is None:\n            return None\n        bar_cells -= notch\n        notch_holes.append(notch)\n\n        # ---- chain pieces ----\n        chain_pieces = []\n        for piece_idx in range(chain_len):\n            if color_idx >= len(avail_colors):\n                return None\n            piece_color = avail_colors[color_idx]; color_idx += 1\n            piece_area = rng.randint(8, 13)\n            chain_dim = rng.randint(2, 3)\n\n            if piece_idx == 0:\n                # ROOT: fill notch + extend outside bar\n                if orientation == \"horizontal\":\n                    if side == \"top\":\n                        pr0, pr1 = max(0, bar_r0 - chain_dim), max(r for r, _ in notch)\n                    else:\n                        pr0, pr1 = min(r for r, _ in notch), min(H - 1, bar_r1 + chain_dim)\n                    pc0, pc1 = sc0, sc1\n                else:\n                    if side == \"left\":\n                        pc0, pc1 = max(0, bar_c0 - chain_dim), max(c for _, c in notch)\n                    else:\n                        pc0, pc1 = min(c for _, c in notch), min(W - 1, bar_c1 + chain_dim)\n                    pr0, pr1 = sA, sB\n\n                bbox_area = (pr1 - pr0 + 1) * (pc1 - pc0 + 1)\n                target = max(max(8, int(bbox_area * 0.54)),\n                             min(piece_area, int(bbox_area * 0.80)))\n                if target > bbox_area or target < 8:\n                    return None\n\n                avail = {(r, c) for r in range(pr0, pr1 + 1) for c in range(pc0, pc1 + 1)\n                         if (r, c) in notch or (r, c) not in occ_set}\n                root = _grow_connected(rng, avail, target, notch,\n                                       must_span_axis=\"cols\" if orientation == \"horizontal\" else \"rows\",\n                                       span_range=(sA, sB), retries=5)\n                if root is None:\n                    return None\n                if not any(not (bar_r0 <= r <= bar_r1 and bar_c0 <= c <= bar_c1) for r, c in root):\n                    return None\n                piece_cells = root\n            else:\n                # CONTINUATION: fill cavity in prev bbox + extend further from bar\n                prev_coords = chain_pieces[-1][\"coords\"]\n                prs = [r for r, _ in prev_coords]; pcs = [c for _, c in prev_coords]\n                prev_r0, prev_r1 = min(prs), max(prs)\n                prev_c0, prev_c1 = min(pcs), max(pcs)\n\n                if orientation == \"horizontal\":\n                    cavity = {(r, c) for r in range(prev_r0, prev_r1 + 1)\n                              for c in range(sc0, sc1 + 1)\n                              if (r, c) not in occ_set and (r, c) not in prev_coords}\n                else:\n                    cavity = {(r, c) for r in range(sA, sB + 1)\n                              for c in range(prev_c0, prev_c1 + 1)\n                              if (r, c) not in occ_set and (r, c) not in prev_coords}\n                if not cavity:\n                    return None\n\n                if orientation == \"horizontal\":\n                    es = (max(0, prev_r0 - chain_dim), prev_r0 - 1) if side == \"top\" \\\n                        else (prev_r1 + 1, min(H - 1, prev_r1 + chain_dim))\n                    ext = {(r, c) for r in range(es[0], es[1] + 1)\n                           for c in range(sc0, sc1 + 1)\n                           if (r, c) not in occ_set} if es[0] <= es[1] else set()\n                else:\n                    es = (max(0, prev_c0 - chain_dim), prev_c0 - 1) if side == \"left\" \\\n                        else (prev_c1 + 1, min(W - 1, prev_c1 + chain_dim))\n                    ext = {(r, c) for r in range(sA, sB + 1)\n                           for c in range(es[0], es[1] + 1)\n                           if (r, c) not in occ_set} if es[0] <= es[1] else set()\n\n                all_avail = cavity | ext\n                target = min(13, max(len(cavity), min(piece_area, len(all_avail))))\n                if len(cavity) > 13 or target < 8:\n                    return None\n\n                # Tail piece must leave zero cavity in its bbox within strip\n                is_tail = (piece_idx == chain_len - 1)\n                if is_tail:\n                    target = min(13, len(all_avail))\n\n                piece_cells = _grow_connected(rng, all_avail, target, cavity,\n                                              must_span_axis=\"cols\" if orientation == \"horizontal\" else \"rows\",\n                                              span_range=(sA, sB), retries=5)\n                if piece_cells is None or not cavity.issubset(piece_cells):\n                    return None\n\n                if is_tail:\n                    prs2 = [r for r, _ in piece_cells]; pcs2 = [c for _, c in piece_cells]\n                    t_r0, t_r1 = min(prs2), max(prs2)\n                    t_c0, t_c1 = min(pcs2), max(pcs2)\n                    if orientation == \"horizontal\":\n                        remaining = {(r, c) for r in range(t_r0, t_r1 + 1) for c in range(sc0, sc1 + 1)\n                                     if (r, c) not in occ_set and (r, c) not in piece_cells}\n                    else:\n                        remaining = {(r, c) for r in range(sA, sB + 1) for c in range(t_c0, t_c1 + 1)\n                                     if (r, c) not in occ_set and (r, c) not in piece_cells}\n                    if remaining:\n                        return None\n\n            if not (8 <= len(piece_cells) <= 13):\n                return None\n            chain_pieces.append({\"color\": piece_color, \"coords\": piece_cells})\n            occ_set |= piece_cells\n\n        if len(chain_pieces) < chain_len:\n            return None\n        all_chain_pieces.extend(chain_pieces)\n\n    if not (3 <= len(all_chain_pieces) <= 6):\n        return None\n\n    # ---- decoy notches (4-7) ------------------------------------------\n    num_decoys = rng.randint(4, 7)\n    decoys = 0\n    for _ in range(500):\n        if decoys >= num_decoys:\n            break\n        depth = rng.randint(1, 2)\n        area = rng.randint(1, min(6, depth * 5))\n        if orientation == \"horizontal\":\n            ds = rng.choice([\"top\", \"bottom\"])\n            dr0 = bar_r0 if ds == \"top\" else bar_r1 - depth + 1\n            dr1 = bar_r0 + depth - 1 if ds == \"top\" else bar_r1\n            dc0 = rng.randint(bar_c0, bar_c1)\n            dc1 = min(bar_c1, dc0 + rng.randint(0, 4))\n        else:\n            ds = rng.choice([\"left\", \"right\"])\n            dc0 = bar_c0 if ds == \"left\" else bar_c1 - depth + 1\n            dc1 = bar_c0 + depth - 1 if ds == \"left\" else bar_c1\n            dr0 = rng.randint(bar_r0, bar_r1)\n            dr1 = min(bar_r1, dr0 + rng.randint(0, 4))\n\n        d_avail = {(r, c) for r in range(dr0, dr1 + 1) for c in range(dc0, dc1 + 1)\n                   if (r, c) in bar_cells}\n        all_h = set().union(*notch_holes) if notch_holes else set()\n        d_avail -= all_h | {(r + dr, c + dc) for r, c in all_h for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]}\n        if len(d_avail) < 1:\n            continue\n        area = min(area, len(d_avail))\n        dn = _grow_connected(rng, d_avail, area, {rng.choice(list(d_avail))})\n        if dn is None:\n            continue\n        if not _connected(bar_cells - dn):\n            continue\n        bar_cells -= dn\n        notch_holes.append(dn)\n        decoys += 1\n    if decoys < 4:\n        return None\n\n    # verify no internal holes in bar bbox\n    bar_mask = np.zeros((bar_h, bar_w), dtype=bool)\n    for r, c in bar_cells:\n        bar_mask[r - bar_r0, c - bar_c0] = True\n    for pts in components_mask(~bar_mask, connectivity=4):\n        rr, cc = pts[:, 0], pts[:, 1]\n        if not ((rr == 0).any() or (rr == bar_h - 1).any()\n                or (cc == 0).any() or (cc == bar_w - 1).any()):\n            return None\n\n    # ---- assemble output ----------------------------------------------\n    output = np.full((H, W), bg, dtype=int)\n    for r, c in bar_cells:\n        output[r, c] = bar_color\n    for p in all_chain_pieces:\n        for r, c in p[\"coords\"]:\n            output[r, c] = p[\"color\"]\n\n    # ---- scatter pieces for input -------------------------------------\n    input_grid = np.full((H, W), bg, dtype=int)\n    for r, c in bar_cells:\n        input_grid[r, c] = bar_color\n\n    placed_occ = set(bar_cells)\n    pieces_order = list(all_chain_pieces)\n    rng.shuffle(pieces_order)\n\n    for p in pieces_order:\n        coords = p[\"coords\"]; color = p[\"color\"]\n        rs = [r for r, _ in coords]; cs = [c for _, c in coords]\n        p_r0, p_c0 = min(rs), min(cs)\n        rel = [(r - p_r0, c - p_c0) for r, c in coords]\n        p_h, p_w = max(rs) - p_r0 + 1, max(cs) - p_c0 + 1\n\n        placed = False\n        for _ in range(500):\n            gap = rng.randint(2, 7)\n            if orientation == \"horizontal\":\n                top = (bar_r0 - gap - p_h) if rng.random() < 0.5 else (bar_r1 + gap + 1)\n                left = rng.randint(0, max(0, W - p_w))\n            else:\n                left = (bar_c0 - gap - p_w) if rng.random() < 0.5 else (bar_c1 + gap + 1)\n                top = rng.randint(0, max(0, H - p_h))\n            if top < 0 or top + p_h > H or left < 0 or left + p_w > W:\n                continue\n            pts = {(top + dr, left + dc) for dr, dc in rel}\n            if pts & placed_occ:\n                continue\n            if any((r + dr, c + dc) in placed_occ\n                   for r, c in pts for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]):\n                continue\n            for r, c in pts:\n                input_grid[r, c] = color\n            placed_occ |= pts\n            placed = True\n            break\n        if not placed:\n            return None\n\n    return input_grid, output\n\n\ndef generate_input():\n    \"\"\"Generate a valid input grid for task 16b78196 (max 300 retries).\"\"\"\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is None:\n            continue\n        inp, out = result\n        if np.array_equal(main(inp), out):\n            return inp\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n","exit_code":0,"status":"completed"}}
