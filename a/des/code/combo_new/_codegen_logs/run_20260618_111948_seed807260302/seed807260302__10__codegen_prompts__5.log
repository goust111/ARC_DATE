{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,80p' /home/lixinyu/snap/a/des/code/combo_new/seed807260302/10/2.py\"","aggregated_output":"from __future__ import annotations\n\nimport random\n\nimport numpy as np\n\n\nBLACK = 0\nGREY = 5\nCOLORS = [1, 2, 3, 4, 6, 7, 8, 9]\nDIRECTIONS = (\"top\", \"right\", \"bottom\", \"left\")\nMAX_GENERATION_ATTEMPTS = 400\n\n\ndef _components(mask: np.ndarray) -> list[np.ndarray]:\n    \"\"\"Return 4-connected components as N x 2 coordinate arrays.\"\"\"\n    h, w = mask.shape\n    seen = np.zeros((h, w), dtype=bool)\n    comps: list[np.ndarray] = []\n    for sr in range(h):\n        for sc in range(w):\n            if seen[sr, sc] or not bool(mask[sr, sc]):\n                continue\n            seen[sr, sc] = True\n            stack = [(sr, sc)]\n            coords = []\n            while stack:\n                r, c = stack.pop()\n                coords.append((r, c))\n                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                    rr, cc = r + dr, c + dc\n                    if 0 <= rr < h and 0 <= cc < w and not seen[rr, cc] and bool(mask[rr, cc]):\n                        seen[rr, cc] = True\n                        stack.append((rr, cc))\n            comps.append(np.array(coords, dtype=int))\n    return comps\n\n\ndef _perimeter_cells(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:\n    cells: list[tuple[int, int]] = []\n    for c in range(c0, c1 + 1):\n        cells.append((r0, c))\n        cells.append((r1, c))\n    for r in range(r0 + 1, r1):\n        cells.append((r, c0))\n        cells.append((r, c1))\n    return cells\n\n\ndef _door_side(door: tuple[int, int], bbox: tuple[int, int, int, int]) -> str:\n    r, c = door\n    r0, c0, r1, c1 = bbox\n    if r == r0:\n        return \"top\"\n    if c == c1:\n        return \"right\"\n    if r == r1:\n        return \"bottom\"\n    if c == c0:\n        return \"left\"\n    raise AssertionError(\"door must lie on the room perimeter\")\n\n\ndef _find_rooms(g: np.ndarray) -> list[dict]:\n    rooms: list[dict] = []\n    for coords in _components(g == GREY):\n        r0, c0 = coords.min(axis=0)\n        r1, c1 = coords.max(axis=0)\n        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n        height = r1 - r0 + 1\n        width = c1 - c0 + 1\n        assert height >= 6 and width >= 6\n\n        perimeter = _perimeter_cells(r0, c0, r1, c1)\n        assert int(coords.shape[0]) == len(perimeter) - 1\n        for r, c in coords:\n            assert int(r) in (r0, r1) or int(c) in (c0, c1)\n\n        missing = [(r, c) for r, c in perimeter if int(g[r, c]) != GREY]\n        assert len(missing) == 1\n","exit_code":0,"status":"completed"}}
