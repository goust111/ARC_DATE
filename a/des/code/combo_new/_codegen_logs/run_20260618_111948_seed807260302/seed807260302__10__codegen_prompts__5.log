{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,80p' /home/lixinyu/snap/a/des/code/combo_new/seed807260302/10/4.py\"","aggregated_output":"from __future__ import annotations\n\nimport random\n\nimport numpy as np\n\n\nBG = 0\nGREY = 5\nSEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)\nMIN_WALL_RUN = 5\nMAX_GENERATION_ATTEMPTS = 300\nCHANNEL_PLACEMENT_ATTEMPTS = 80\n\n\ndef _most_common(values: np.ndarray) -> int:\n    vals, counts = np.unique(values.astype(int), return_counts=True)\n    return int(vals[int(np.argmax(counts))])\n\n\ndef _background_color(g: np.ndarray) -> int:\n    if np.any(g == BG):\n        return BG\n    return _most_common(g)\n\n\ndef _wall_color(g: np.ndarray, bg: int) -> int:\n    non_bg = g[g != bg]\n    assert non_bg.size > 0, \"expected grey channel walls\"\n    if np.any(non_bg == GREY):\n        return GREY\n    return _most_common(non_bg)\n\n\ndef _runs_1d(mask: np.ndarray, min_len: int = MIN_WALL_RUN) -> list[tuple[int, int]]:\n    runs: list[tuple[int, int]] = []\n    i = 0\n    n = int(mask.size)\n    while i < n:\n        if not bool(mask[i]):\n            i += 1\n            continue\n        start = i\n        while i < n and bool(mask[i]):\n            i += 1\n        end = i - 1\n        if end - start + 1 >= min_len:\n            runs.append((int(start), int(end)))\n    return runs\n\n\ndef _horizontal_wall_runs(g: np.ndarray, wall: int) -> dict[int, list[tuple[int, int]]]:\n    by_row: dict[int, list[tuple[int, int]]] = {}\n    for r in range(g.shape[0]):\n        runs = _runs_1d(g[r, :] == wall)\n        if runs:\n            by_row[int(r)] = runs\n    return by_row\n\n\ndef _vertical_wall_runs(g: np.ndarray, wall: int) -> dict[int, list[tuple[int, int]]]:\n    by_col: dict[int, list[tuple[int, int]]] = {}\n    for c in range(g.shape[1]):\n        runs = _runs_1d(g[:, c] == wall)\n        if runs:\n            by_col[int(c)] = runs\n    return by_col\n\n\ndef _channel_seeds(g: np.ndarray, bg: int, wall: int, r0: int, r1: int, c0: int, c1: int) -> list[tuple[int, int, int]]:\n    region = g[r0 : r1 + 1, c0 : c1 + 1]\n    if np.any(region == wall):\n        return []\n    coords = np.argwhere((region != bg) & (region != wall))\n    seeds = [(int(r0 + r), int(c0 + c), int(region[r, c])) for r, c in coords]\n    if len(seeds) != 2:\n        return []\n    if seeds[0][2] == seeds[1][2]:\n        return []\n    return seeds\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,80p' /home/lixinyu/snap/a/des/code/combo_new/seed807260302/10/1.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import deque\nimport random\n\nimport numpy as np\n\n\ndef _most_common_color(grid: np.ndarray) -> int:\n    values, counts = np.unique(grid, return_counts=True)\n    return int(values[int(np.argmax(counts))])\n\n\ndef _components(mask: np.ndarray) -> list[np.ndarray]:\n    height, width = mask.shape\n    seen = np.zeros_like(mask, dtype=bool)\n    comps: list[np.ndarray] = []\n\n    for r in range(height):\n        for c in range(width):\n            if not mask[r, c] or seen[r, c]:\n                continue\n            q: deque[tuple[int, int]] = deque([(r, c)])\n            seen[r, c] = True\n            cells: list[tuple[int, int]] = []\n            while q:\n                cr, cc = q.popleft()\n                cells.append((cr, cc))\n                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):\n                    if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and not seen[nr, nc]:\n                        seen[nr, nc] = True\n                        q.append((nr, nc))\n            comps.append(np.array(cells, dtype=int))\n    return comps\n\n\ndef _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:\n    return (\n        int(coords[:, 0].min()),\n        int(coords[:, 1].min()),\n        int(coords[:, 0].max()),\n        int(coords[:, 1].max()),\n    )\n\n\ndef _rect_frame_bbox(coords: np.ndarray) -> tuple[int, int, int, int] | None:\n    r0, c0, r1, c1 = _bbox(coords)\n    height = r1 - r0 + 1\n    width = c1 - c0 + 1\n    if height < 3 or width < 3:\n        return None\n\n    expected = set()\n    for r in range(r0, r1 + 1):\n        expected.add((r, c0))\n        expected.add((r, c1))\n    for c in range(c0, c1 + 1):\n        expected.add((r0, c))\n        expected.add((r1, c))\n\n    if set(map(tuple, coords.tolist())) != expected:\n        return None\n    return r0, c0, r1, c1\n\n\ndef _region_for_fragment(\n    coords: np.ndarray,\n    regions: list[dict[str, int]],\n) -> dict[str, int]:\n    matches = []\n    for region in regions:\n        if np.all(\n            (region[\"r0\"] < coords[:, 0])\n            & (coords[:, 0] < region[\"r1\"])\n            & (region[\"c0\"] < coords[:, 1])\n            & (coords[:, 1] < region[\"c1\"])\n        ):\n            matches.append(region)\n    assert len(matches) == 1, \"each fragment must lie inside exactly one frame\"\n    return matches[0]\n","exit_code":0,"status":"completed"}}
