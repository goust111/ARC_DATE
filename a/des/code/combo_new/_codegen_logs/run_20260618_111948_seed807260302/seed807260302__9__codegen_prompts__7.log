{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/9b5080bb.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor the small defect bars on each shared-color object with the opposite panel color.\n\n    Input structure\n    - The grid contains two large panel colors and one shared object color.\n    - Each shared-color object is a mostly solid rectangle inside exactly one panel.\n    Rule\n    - Find the near-solid rectangular core of each object.\n    - Missing core pixels and one-cell protrusions define two-pixel bars perpendicular to the nearest core edge.\n    - Recolor those bars with the other panel color; leave all other pixels unchanged.\n    Key insight\n    - The colors to add are not tied to numeric ids: each object's surrounding panel identifies the opposite panel color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = g.copy()\n\n    object_color, components, panel_colors = _object_components(g)\n    for coords in components:\n        neighbors = _neighbor_colors(g, coords, object_color)\n        assert len(neighbors) == 1\n        panel_color = next(iter(neighbors))\n        target_colors = panel_colors - {panel_color}\n        assert len(target_colors) == 1\n        target_color = next(iter(target_colors))\n\n        rect = _core_rect(coords)\n        for r, c in _defect_bar_cells(coords, rect):\n            assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1]\n            assert int(g[r, c]) in {object_color, panel_color}\n            out[r, c] = target_color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Palette and canvas bounds.\nCOLOR_IDS = list(range(10))\nGRID_SIZE_MIN = 20\nGRID_SIZE_MAX = 27\n\n# Panel layout bounds and options.\nMIN_PANEL_DIM = 9\nMIN_VISIBLE_BORDERS = 2\nBORDER_CHOICES = (0, 1)\nOFFSET_MIN = 2\nOFFSET_MAX = 6\nHORIZONTAL_LAYOUT = 0\nVERTICAL_LAYOUT = 1\nHORIZONTAL_OFFSETS = (\"left\", \"right\", \"none\")\nVERTICAL_OFFSETS = (\"top\", \"bottom\", \"none\")\n\n# Object geometry and placement constraints.\nOBJECTS_PER_PANEL = (1, 2)\nCORE_H_MIN = 3\nCORE_H_MAX = 7\nCORE_W_MIN = 3\nCORE_W_MAX = 9\nDEFECT_COUNT_MIN = 1\nDEFECT_COUNT_MAX = 3\nDEFECT_SIDES = (\"top\", \"bottom\", \"left\", \"right\")\nDEFECT_TYPES = (\"missing\", \"protrusion\")\nPANEL_MARGIN = 1\nOBJECT_GAP = 2\nMAX_PLACE_TRIES = 30\n\n# Generation retry budget.\nMAX_GENERATE_ATTEMPTS = 300\n\n\ndef _choose_palette() -> tuple[int, int, int, int]:\n    colors = COLOR_IDS[:]\n    random.shuffle(colors)\n    return tuple(colors[:4])\n\n\ndef _choose_borders() -> tuple[int, int, int, int]:\n    borders = [random.choice(BORDER_CHOICES) for _ in range(4)]\n    while sum(borders) < MIN_VISIBLE_BORDERS:\n        borders[random.randint(0, 3)] = 1\n    return tuple(borders)\n\n\ndef _build_horizontal_panels(\n    grid: np.ndarray,\n    panel_a_color: int,\n    panel_b_color: int,\n) -> list[tuple[int, int, int, int, int]] | None:\n    \"\"\"Create two panels sharing a horizontal border; returns panel records.\"\"\"\n    H, W = grid.shape\n    split_r = random.randint(MIN_PANEL_DIM, H - MIN_PANEL_DIM - 1)\n    border_top, border_bot, border_left, border_right = _choose_borders()\n\n    pa_height = split_r - border_top\n    pb_height = H - border_bot - split_r\n    if pa_height < MIN_PANEL_DIM or pb_height < MIN_PANEL_DIM:\n        return None\n\n    offset_side = random.choice(HORIZONTAL_OFFSETS)\n    if offset_side == \"none\":\n        pa_c0, pa_c1 = border_left, W - 1 - border_right\n        pb_c0, pb_c1 = border_left, W - 1 - border_right\n    elif offset_side == \"left\":\n        offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_c0 = border_left\n            pa_c1 = W - 1 - border_right\n            pb_c0 = border_left + offset_cols\n            pb_c1 = W - 1 - border_right\n        else:\n            pa_c0 = border_left + offset_cols\n            pa_c1 = W - 1 - border_right\n            pb_c0 = border_left\n            pb_c1 = W - 1 - border_right\n    else:\n        offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_c0 = border_left\n            pa_c1 = W - 1 - border_right - offset_cols\n            pb_c0 = border_left\n            pb_c1 = W - 1 - border_right\n        else:\n            pa_c0 = border_left\n            pa_c1 = W - 1 - border_right\n            pb_c0 = border_left\n            pb_c1 = W - 1 - border_right - offset_cols\n\n    if pa_c1 - pa_c0 + 1 < MIN_PANEL_DIM or pb_c1 - pb_c0 + 1 < MIN_PANEL_DIM:\n        return None\n    if min(pa_c1, pb_c1) < max(pa_c0, pb_c0):\n        return None\n\n    pa_r0, pa_r1 = border_top, split_r - 1\n    pb_r0, pb_r1 = split_r, H - 1 - border_bot\n    grid[pa_r0:pa_r1 + 1, pa_c0:pa_c1 + 1] = panel_a_color\n    grid[pb_r0:pb_r1 + 1, pb_c0:pb_c1 + 1] = panel_b_color\n    return [\n        (panel_a_color, pa_r0, pa_r1, pa_c0, pa_c1),\n        (panel_b_color, pb_r0, pb_r1, pb_c0, pb_c1),\n    ]\n\n\ndef _build_vertical_panels(\n    grid: np.ndarray,\n    panel_a_color: int,\n    panel_b_color: int,\n) -> list[tuple[int, int, int, int, int]] | None:\n    \"\"\"Create two panels sharing a vertical border; returns panel records.\"\"\"\n    H, W = grid.shape\n    split_c = random.randint(MIN_PANEL_DIM, W - MIN_PANEL_DIM - 1)\n    border_top, border_bot, border_left, border_right = _choose_borders()\n\n    pa_width = split_c - border_left\n    pb_width = W - border_right - split_c\n    if pa_width < MIN_PANEL_DIM or pb_width < MIN_PANEL_DIM:\n        return None\n\n    offset_side = random.choice(VERTICAL_OFFSETS)\n    if offset_side == \"none\":\n        pa_r0, pa_r1 = border_top, H - 1 - border_bot\n        pb_r0, pb_r1 = border_top, H - 1 - border_bot\n    elif offset_side == \"top\":\n        offset_rows = random.randint(OFFSET_MIN, min(OFFSET_MAX, H - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_r0, pa_r1 = border_top, H - 1 - border_bot\n            pb_r0, pb_r1 = border_top + offset_rows, H - 1 - border_bot\n        else:\n            pa_r0, pa_r1 = border_top + offset_rows, H - 1 - border_bot\n            pb_r0, pb_r1 = border_top, H - 1 - border_bot\n    else:\n        offset_rows = random.randint(OFFSET_MIN, min(OFFSET_MAX, H - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_r0, pa_r1 = border_top, H - 1 - border_bot - offset_rows\n            pb_r0, pb_r1 = border_top, H - 1 - border_bot\n        else:\n            pa_r0, pa_r1 = border_top, H - 1 - border_bot\n            pb_r0, pb_r1 = border_top, H - 1 - border_bot - offset_rows\n\n    pa_c0, pa_c1 = border_left, split_c - 1\n    pb_c0, pb_c1 = split_c, W - 1 - border_right\n    if pa_r1 - pa_r0 + 1 < MIN_PANEL_DIM or pb_r1 - pb_r0 + 1 < MIN_PANEL_DIM:\n        return None\n    if min(pa_r1, pb_r1) < max(pa_r0, pb_r0):\n        return None\n\n    grid[pa_r0:pa_r1 + 1, pa_c0:pa_c1 + 1] = panel_a_color\n    grid[pb_r0:pb_r1 + 1, pb_c0:pb_c1 + 1] = panel_b_color\n    return [\n        (panel_a_color, pa_r0, pa_r1, pa_c0, pa_c1),\n        (panel_b_color, pb_r0, pb_r1, pb_c0, pb_c1),\n    ]\n\n\ndef _make_panel_grid(\n    panel_a_color: int,\n    panel_b_color: int,\n    bg_color: int,\n) -> tuple[np.ndarray, list[tuple[int, int, int, int, int]]] | None:\n    \"\"\"Sample the canvas and panel layout.\"\"\"\n    H = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    W = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    grid = np.full((H, W), bg_color, dtype=int)\n\n    orientation = random.randint(HORIZONTAL_LAYOUT, VERTICAL_LAYOUT)\n    if orientation == HORIZONTAL_LAYOUT:\n        panels = _build_horizontal_panels(grid, panel_a_color, panel_b_color)\n    else:\n        panels = _build_vertical_panels(grid, panel_a_color, panel_b_color)\n    if panels is None:\n        return None\n    return grid, panels\n\n\ndef _object_overlaps(full_bbox: tuple[int, int, int, int], placed_bboxes: list[tuple[int, int, int, int]]) -> bool:\n    full_r0, full_r1, full_c0, full_c1 = full_bbox\n    for br0, br1, bc0, bc1 in placed_bboxes:\n        if (\n            full_r0 - OBJECT_GAP <= br1\n            and full_r1 + OBJECT_GAP >= br0\n            and full_c0 - OBJECT_GAP <= bc1\n            and full_c1 + OBJECT_GAP >= bc0\n        ):\n            return True\n    return False\n\n\ndef _place_core(\n    panel_bbox: tuple[int, int, int, int],\n    core_h: int,\n    core_w: int,\n    sides: list[str],\n    placed_bboxes: list[tuple[int, int, int, int]],\n) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int]] | None:\n    \"\"\"Find a non-overlapping core bbox and its full bbox including bars.\"\"\"\n    pr0, pr1, pc0, pc1 = panel_bbox\n    extra_top = 1 if \"top\" in sides else 0\n    extra_bot = 1 if \"bottom\" in sides else 0\n    extra_left = 1 if \"left\" in sides else 0\n    extra_right = 1 if \"right\" in sides else 0\n\n    place_r0 = pr0 + PANEL_MARGIN + extra_top\n    place_r1 = pr1 - PANEL_MARGIN - extra_bot - core_h + 1\n    place_c0 = pc0 + PANEL_MARGIN + extra_left\n    place_c1 = pc1 - PANEL_MARGIN - extra_right - core_w + 1\n    if place_r1 < place_r0 or place_c1 < place_c0:\n        return None\n\n    for _ in range(MAX_PLACE_TRIES):\n        cr0 = random.randint(place_r0, place_r1)\n        cc0 = random.randint(place_c0, place_c1)\n        cr1 = cr0 + core_h - 1\n        cc1 = cc0 + core_w - 1\n        full_bbox = (cr0 - extra_top, cr1 + extra_bot, cc0 - extra_left, cc1 + extra_right)\n        if not _object_overlaps(full_bbox, placed_bboxes):\n            return (cr0, cr1, cc0, cc1), full_bbox\n    return None\n\n\ndef _apply_defect(\n    input_grid: np.ndarray,\n    output_grid: np.ndarray,\n    core_bbox: tuple[int, int, int, int],\n    side: str,\n    defect_type: str,\n    panel_color: int,\n    obj_color: int,\n    other_panel_color: int,\n) -> bool:\n    \"\"\"Apply one sampled input defect and its two-cell output bar.\"\"\"\n    cr0, cr1, cc0, cc1 = core_bbox\n    if side == \"top\":\n        if defect_type == \"missing\":\n            valid_cols = list(range(cc0 + 1, cc1))\n            if not valid_cols:\n                return False\n            dc = random.choice(valid_cols)\n            dr = cr0\n            input_grid[dr, dc] = panel_color\n            output_grid[dr - 1, dc] = other_panel_color\n            output_grid[dr, dc] = other_panel_color\n        else:\n            dc = random.randint(cc0, cc1)\n            dr = cr0 - 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr + 1, dc] = other_panel_color\n    elif side == \"bottom\":\n        if defect_type == \"missing\":\n            valid_cols = list(range(cc0 + 1, cc1))\n            if not valid_cols:\n                return False\n            dc = random.choice(valid_cols)\n            dr = cr1\n            input_grid[dr, dc] = panel_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr + 1, dc] = other_panel_color\n        else:\n            dc = random.randint(cc0, cc1)\n            dr = cr1 + 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr - 1, dc] = other_panel_color\n    elif side == \"left\":\n        if defect_type == \"missing\":\n            valid_rows = list(range(cr0 + 1, cr1))\n            if not valid_rows:\n                return False\n            dr = random.choice(valid_rows)\n            dc = cc0\n            input_grid[dr, dc] = panel_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc - 1] = other_panel_color\n        else:\n            dr = random.randint(cr0, cr1)\n            dc = cc0 - 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc + 1] = other_panel_color\n    else:\n        if defect_type == \"missing\":\n            valid_rows = list(range(cr0 + 1, cr1))\n            if not valid_rows:\n                return False\n            dr = random.choice(valid_rows)\n            dc = cc1\n            input_grid[dr, dc] = panel_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc + 1] = other_panel_color\n        else:\n            dr = random.randint(cr0, cr1)\n            dc = cc1 + 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc - 1] = other_panel_color\n    return True\n\n\ndef _place_panel_objects(\n    input_grid: np.ndarray,\n    output_grid: np.ndarray,\n    panel: tuple[int, int, int, int, int],\n    n_objs: int,\n    obj_color: int,\n    other_panel_color: int,\n) -> bool:\n    \"\"\"Place all objects for one panel into input and output grids.\"\"\"\n    panel_color, pr0, pr1, pc0, pc1 = panel\n    avail_r0 = pr0 + PANEL_MARGIN\n    avail_r1 = pr1 - PANEL_MARGIN\n    avail_c0 = pc0 + PANEL_MARGIN\n    avail_c1 = pc1 - PANEL_MARGIN\n    placed_bboxes = []\n\n    for _ in range(n_objs):\n        core_h = random.randint(CORE_H_MIN, min(CORE_H_MAX, avail_r1 - avail_r0 - 2))\n        core_w = random.randint(CORE_W_MIN, min(CORE_W_MAX, avail_c1 - avail_c0 - 2))\n        if core_h < CORE_H_MIN or core_w < CORE_W_MIN:\n            return False\n\n        n_defects = random.randint(DEFECT_COUNT_MIN, DEFECT_COUNT_MAX)\n        sides = random.sample(DEFECT_SIDES, n_defects)\n        defect_types = [random.choice(DEFECT_TYPES) for _ in range(n_defects)]\n\n        placed = _place_core((pr0, pr1, pc0, pc1), core_h, core_w, sides, placed_bboxes)\n        if placed is None:\n            return False\n        core_bbox, full_bbox = placed\n        placed_bboxes.append(full_bbox)\n\n        cr0, cr1, cc0, cc1 = core_bbox\n        output_grid[cr0:cr1 + 1, cc0:cc1 + 1] = obj_color\n        input_grid[cr0:cr1 + 1, cc0:cc1 + 1] = obj_color\n\n        for side, defect_type in zip(sides, defect_types):\n            if not _apply_defect(\n                input_grid,\n                output_grid,\n                core_bbox,\n                side,\n                defect_type,\n                panel_color,\n                obj_color,\n                other_panel_color,\n            ):\n                return False\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    obj_color, panel_a_color, panel_b_color, bg_color = _choose_palette()\n    layout = _make_panel_grid(panel_a_color, panel_b_color, bg_color)\n    if layout is None:\n        return None\n    grid, panels = layout\n\n    n_obj_a = random.choice(OBJECTS_PER_PANEL)\n    n_obj_b = random.choice(OBJECTS_PER_PANEL)\n    if not 2 <= n_obj_a + n_obj_b <= 4:\n        return None\n\n    output_grid = grid.copy()\n    input_grid = grid.copy()\n    object_counts = (n_obj_a, n_obj_b)\n    other_colors = (panel_b_color, panel_a_color)\n\n    for panel, n_objs, other_panel_color in zip(panels, object_counts, other_colors):\n        if not _place_panel_objects(\n            input_grid,\n            output_grid,\n            panel,\n            n_objs,\n            obj_color,\n            other_panel_color,\n        ):\n            return None\n\n    # Verify: run solver on input and check it produces the output\n    try:\n        result = main(input_grid)\n        if np.array_equal(result, output_grid):\n            return input_grid\n    except (AssertionError, IndexError, ValueError):\n        pass\n\n    return None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\ndef _get_enclosed_holes(sprite):\n    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n    h, w = sprite.shape\n    return [pts for pts in components_mask(~sprite, connectivity=4)\n            if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n\n\ndef _make_diamond():\n    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n    s = np.zeros((3, 3), dtype=bool)\n    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n    return s\n\n\ndef _make_hollow_sprite(h, w, rng):\n    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n    sprite = np.ones((h, w), dtype=bool)\n    if h >= 3 and w >= 3:\n        sprite[1:-1, 1:-1] = False\n    # Optionally add internal horizontal wall\n    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n        br = rng.randint(2, h - 2)\n        n = rng.randint(1, w - 2)\n        s = rng.randint(1, w - 1 - n + 1)\n        sprite[br, s:s + n] = True\n    # Optionally add internal vertical wall\n    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n        bc = rng.randint(2, w - 2)\n        n = rng.randint(1, h - 2)\n        s = rng.randint(1, h - 1 - n + 1)\n        sprite[s:s + n, bc] = True\n    # Optionally remove border cells for irregularity\n    if rng.random() < _P_BORDER_REMOVAL:\n        bcells = [(r, c) for r in range(h) for c in range(w)\n                  if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n        rng.shuffle(bcells)\n        for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n            test = sprite.copy()\n            test[cr, cc] = False\n            if _get_enclosed_holes(test):\n                sprite = test\n    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n        return None\n    return sprite\n\n\ndef _choose_colors(rng, N, num_filled):\n    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n    all_c = list(range(1, 10))\n    rng.shuffle(all_c)\n    border_keys = all_c[:N]\n    rng.shuffle(all_c)\n    fill_values = all_c[:N]\n    dist_cands = [c for c in range(1, 10) if c not in border_keys]\n    distractor_color = rng.choice(dist_cands)\n    mapping = dict(zip(border_keys, fill_values))\n    filled_keys = rng.sample(border_keys, num_filled)\n    return border_keys, fill_values, distractor_color, mapping, filled_keys\n\n\ndef _build_palette(side, border_keys, fill_values):\n    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n    N = len(border_keys)\n    if side in ('top', 'bottom'):\n        pal = np.zeros((2, N), dtype=int)\n        outer, inner = (0, 1) if side == 'top' else (1, 0)\n        pal[outer] = border_keys\n        pal[inner] = fill_values\n    else:\n        pal = np.zeros((N, 2), dtype=int)\n        outer, inner = (0, 1) if side == 'left' else (1, 0)\n        pal[:, outer] = border_keys\n        pal[:, inner] = fill_values\n    return pal\n\n\ndef _place_palette(grid, occ, pal, side, rng):\n    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n    H, W = grid.shape\n    pal_h, pal_w = pal.shape\n    if side == 'top':\n        pr0, pc0 = 0, rng.randint(0, W - pal_w)\n    elif side == 'bottom':\n        pr0, pc0 = H - pal_h, rng.randint(0, W - pal_w)\n    elif side == 'left':\n        pr0, pc0 = rng.randint(0, H - pal_h), 0\n    else:\n        pr0, pc0 = rng.randint(0, H - pal_h), W - pal_w\n    grid[pr0:pr0 + pal_h, pc0:pc0 + pal_w] = pal\n    occ[max(0, pr0 - 1):min(H, pr0 + pal_h + 1),\n        max(0, pc0 - 1):min(W, pc0 + pal_w + 1)] = True\n\n\ndef _find_valid_positions(H, W, occ, mask, holes):\n    \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n    sh, sw = mask.shape\n    positions = []\n    for r0 in range(H - sh + 1):\n        for c0 in range(W - sw + 1):\n            if occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n                   max(0, c0 - 1):min(W, c0 + sw + 1)].any():\n                continue\n            if any(r0 + hr == 0 or c0 + hc == 0 or r0 + hr == H - 1 or c0 + hc == W - 1\n                   for hpts in holes for hr, hc in hpts):\n                continue\n            positions.append((r0, c0))\n    return positions\n\n\ndef _paint_sprite(grid, r0, c0, mask, color, fill, holes):\n    \"\"\"Render a sprite onto the grid: border cells in color, hole cells in fill (if given).\"\"\"\n    grid[r0:r0 + mask.shape[0], c0:c0 + mask.shape[1]][mask] = color\n    if fill is not None:\n        for hpts in holes:\n            for hr, hc in hpts:\n                grid[r0 + hr, c0 + hc] = fill\n\n\ndef _gen_attempt():\n    rng = random.Random()\n    bg = 0\n\n    # Grid size and palette side\n    H = rng.randint(_GRID_H_MIN, _GRID_H_MAX)\n    W = rng.randint(_GRID_W_MIN, _GRID_W_MAX)\n    side = rng.choice(['top', 'bottom', 'left', 'right'])\n    if H <= _SMALL_H_THRESHOLD and side in ('top', 'bottom') and rng.random() < _SMALL_H_PALETTE_FLIP:\n        side = rng.choice(['left', 'right'])\n\n    max_N = H if side in ('left', 'right') else W\n    N = rng.randint(_PALETTE_N_MIN, min(_PALETTE_N_MAX, max_N))\n\n    # Sprite dimension bounds\n    max_sh = min(_SPRITE_H_MAX, H)\n    max_sw = min(_SPRITE_W_MAX, W)\n    if H <= _TINY_H_THRESHOLD:\n        max_sh = 3\n\n    # Sprite counts\n    num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, N))\n    total_sprites = num_filled + 1\n\n    # Generate sprite shapes\n    shapes = []\n    for _ in range(total_sprites):\n        sh = rng.randint(3, max_sh)\n        sw = rng.randint(3, max_sw)\n        if sh + sw > _SPRITE_DIM_SUM_CAP:\n            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)\n        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:\n            mask = _make_diamond()\n        else:\n            mask = _make_hollow_sprite(sh, sw, rng)\n        if mask is None:\n            return None\n        shapes.append(mask)\n\n    # Colors and palette\n    border_keys, fill_values, distractor_color, mapping, filled_keys = \\\n        _choose_colors(rng, N, num_filled)\n    pal = _build_palette(side, border_keys, fill_values)\n\n    grid = np.full((H, W), bg, dtype=int)\n    occ = np.zeros((H, W), dtype=bool)\n    _place_palette(grid, occ, pal, side, rng)\n\n    # Assign colors to sprites: filled sprites use palette keys, last one is distractor\n    infos = []\n    for i, mask in enumerate(shapes):\n        if i < num_filled:\n            c, f = filled_keys[i], mapping[filled_keys[i]]\n        else:\n            c, f = distractor_color, None\n        infos.append((mask, c, f))\n\n    # Place sprites\n    placed = []\n    for mask, color, fill in infos:\n        holes = _get_enclosed_holes(mask)\n        positions = _find_valid_positions(H, W, occ, mask, holes)\n        if not positions:\n            return None\n        r0, c0 = rng.choice(positions)\n        _paint_sprite(grid, r0, c0, mask, color, fill, holes)\n        placed.append((r0, c0, mask, fill))\n        sh, sw = mask.shape\n        occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n            max(0, c0 - 1):min(W, c0 + sw + 1)] = True\n\n    # Derive input from output by clearing filled holes\n    output = grid.copy()\n    inp = grid.copy()\n    for r0, c0, mask, fill in placed:\n        if fill is not None:\n            for hpts in _get_enclosed_holes(mask):\n                for hr, hc in hpts:\n                    inp[r0 + hr, c0 + hc] = bg\n\n    # Validate bg is dominant on border\n    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    if int(vals[cnts.argmax()]) != bg:\n        return None\n\n    # Oracle check\n    try:\n        if np.array_equal(main(inp), output):\n            return inp\n    except Exception:\n        pass\n    return None\n\n\ndef generate_input():\n","exit_code":0,"status":"completed"}}
