ge.\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:277:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:278:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:279:    - bg = most common color. Several hollow sprites with distinct border colors.\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:280:    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:281:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:282:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:283:    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:284:    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:285:    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:286:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:287:    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:288:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:289:    g = np.asarray(grid, dtype=int)\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:290:    bg = _bg_boundary(g)\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:291:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:292:    mapping, pal_mask = _palette_mapping(g, bg)\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:293:    assert mapping, \"main: palette mapping must be non-empty\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:294:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:295:    out = g.copy()\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:296:    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:297:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:298:    return out\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:299:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:300:# --------------- generator (c) ---------------\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:301:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:302:# -- Configuration constants --------------------------------------------------\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:303:# Grid dimensions\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:304:_GRID_H_MIN, _GRID_H_MAX = 4, 13\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:305:_GRID_W_MIN, _GRID_W_MAX = 10, 15\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:306:_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:307:_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:308:_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:309:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:310:# Palette\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:311:_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:312:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:313:# Sprite geometry\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:314:_SPRITE_H_MAX = 7\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:315:_SPRITE_W_MAX = 6\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:316:_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:317:_SPRITE_CELL_MAX = 16\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:318:_FILLED_SPRITE_MAX = 3\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:319:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:320:# Sprite mutation probabilities\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:321:_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:322:_P_VERT_WALL = 0.3            # add vertical internal wall\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:323:_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:324:_P_DIAMOND = 0.2              # use diamond shape for 3x3\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:325:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:326:# Generation\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:327:_MAX_RETRIES = 300\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:328:# -- End configuration --------------------------------------------------------\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:329:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:330:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:331:def _get_enclosed_holes(sprite):\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:544:def generate_input():\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:545:    for _ in range(_MAX_RETRIES):\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:546:        r = _gen_attempt()\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:547:        if r is not None:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:548:            return r\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:549:    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:261:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:262:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:263:    Assemble and place enlarged sprites on a canvas using legend-panel instructions.\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:264:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:265:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:266:    - Color-6 separators divide the grid into a left legend column and a main canvas.\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:267:    - Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:268:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:269:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:270:    - Tile the unit sprite into each active cell of the frame to build an enlarged composite.\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:271:    - Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:272:    - Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:273:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:274:    Key insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:275:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:276:    g = np.asarray(grid, dtype=int)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:277:    h, w = g.shape\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:278:    assert w >= 2, \"grid width must be >= 2\"\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:279:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:280:    # Output canvas is the region between the left separator run and (optionally) a\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:281:    # right-side separator run near the far edge (right legend panel).\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:282:    left_sep, right_sep = _split_canvas(g)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:283:    left_sep_c1 = left_sep[1]\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:284:    canvas_c0 = left_sep_c1 + 1\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:285:    canvas_c1 = right_sep[0] if right_sep is not None else w\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:286:    main = g[:, canvas_c0:canvas_c1].copy()\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:287:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:288:    # Paint one constructed sprite per marker panel that lies outside the output canvas.\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:289:    marker_squares = _all_marker_panel_squares(g)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:290:    assert marker_squares, \"no marker panel found\"\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:291:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:292:    # Anchor alignment (ignore internal full-height/full-width 6 separators inside main).\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:293:    eff_h, eff_w = main.shape\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:294:    full6_cols = [c for c in range(eff_w) if np.all(main[:, c] == 6)]\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:295:    if full6_cols:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:296:        eff_w = min(full6_cols)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:297:    full6_rows = [r for r in range(eff_h) if np.all(main[r, :] == 6)]\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:298:    if full6_rows:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:299:        eff_h = min(full6_rows)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:300:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:301:    out = main.copy()\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:302:    composite_written = np.zeros(out.shape, dtype=bool)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:303:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:304:    for marker_r0, marker_c0 in marker_squares:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:305:        # Ignore marker panels inside the output canvas; only legends should drive drawing.\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:306:        if canvas_c0 <= marker_c0 < canvas_c1:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:307:            continue\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:308:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:309:        if marker_c0 + 5 > w:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:310:            continue\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:311:        panel = g[:, marker_c0 : marker_c0 + 5]\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:312:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:313:        unit = _extract_unit_sprite(panel)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:314:        if unit is None:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:315:            continue\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:316:        unit_sprite, unit_bb = unit\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:317:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:318:        frame_bb = _extract_frame_bbox(panel, unit_bb, marker_r0)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:319:        if frame_bb is None:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:320:            continue\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:321:        fr0, fc0, fr1, fc1 = frame_bb\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:322:        frame = panel[fr0 : fr1 + 1, fc0 : fc1 + 1]\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:323:        frame_mask0 = (frame != 0) & (frame != 6)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:324:        _, n8 = _scipy_label(frame_mask0, structure=np.ones((3, 3)))\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:325:        assert n8 == 1, f\"frame must be 8-connected, got {n8} components\"\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:326:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:327:        # Rotate layout according to clockhand.\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:328:        dir_k = _rotation_from_clockhand(g, marker_r0, marker_c0)  # up=0, right=1, down=2, left=3\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:329:        frame_mask = np.rot90(frame_mask0, (-dir_k) % 4)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:330:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:331:        # Build composite by tiling the unit sprite into active frame cells.\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:332:        m_unit = (unit_sprite != 0) & (unit_sprite != 6)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:333:        uh, uw = unit_sprite.shape\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:334:        fh, fw = frame_mask.shape\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:335:        comp = np.zeros((fh * uh, fw * uw), dtype=int)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:336:        for i in range(fh):\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:337:            for j in range(fw):\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:338:                if not frame_mask[i, j]:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:339:                    continue\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:340:                rr0 = i * uh\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:341:                cc0 = j * uw\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:342:                comp[rr0 : rr0 + uh, cc0 : cc0 + uw][m_unit] = unit_sprite[m_unit]\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:343:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:344:        pos = _position_indices_from_border_square(g, marker_r0, marker_c0)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:345:        if pos is None:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:346:            continue\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:347:        pr, pc = pos\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:348:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:349:        top = _anchor_to_top_left(pr, eff_h, comp.shape[0])\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:350:        left = _anchor_to_top_left(pc, eff_w, comp.shape[1])\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:351:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:352:        ch, cw = comp.shape\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:353:        for r in range(ch):\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:354:            rr = top + r\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:355:            assert 0 <= rr < out.shape[0], \"sprite row out of canvas bounds\"\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:356:            for c in range(cw):\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:357:                cc = left + c\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:358:                assert 0 <= cc < out.shape[1], \"sprite col out of canvas bounds\"\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:359:                if out[rr, cc] == 6:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:360:                    continue\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:361:                val = int(comp[r, c])\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:362:                if val != 0 and val != 6:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:363:                    assert not composite_written[rr, cc], \"composites must not overlap\"\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:364:                    composite_written[rr, cc] = True\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:365:                    out[rr, cc] = val\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:366:    return out\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:367:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:368:# --------------- generator (refine_8conn_fill_overlap) ---------------\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:369:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:370:# ── CFG: tunable generation parameters ──────────────────────────────\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:371:GRID_H_RANGE = (20, 30)         # output grid height\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:372:GRID_W = 30                     # output grid width (fixed)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:373:LEGEND_COUNT_WEIGHTS = [1, 4]   # weights for [1-legend, 2-legend]\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:374:UNIT_SIZE_RANGE = (2, 5)        # NxN unit sprite side length\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:375:MIN_CANVAS_W = 8                # reject if canvas narrower than this\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:376:FRAME_H_RANGE = (4, 9)          # frame mask height (before rotation)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:377:FRAME_W_RANGE = (3, 6)          # frame mask width  (before rotation)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:378:FRAME_DENSITY = 0.5             # density for random_sprite frame generation\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:379:BAND_WIDTH_MIN = 4              # minimum band width for canvas background\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:380:MARKER_PANEL_HEIGHT = 8         # marker square (5) + rotation patch (3)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:381:USABLE_COLORS = [1, 2, 3, 4, 5, 7, 8, 9]  # all colors except 0 (bg) and 6 (separator)\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:382:ROTATION_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up/right/down/left clock-hand offsets\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:383:GEN_RETRIES = 300               # max attempts in generate_input\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:384:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:385:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:386:def _allocate_colors(num_legends):\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:650:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:651:    for _ in range(GEN_RETRIES):\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:652:        result = _gen_attempt()\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:653:        if result is not None:\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:654:            return result\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:655:    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:34:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:35:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:36:    Move colored sprites from the left strip into a framed area at marker-defined targets.\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:37:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:38:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:39:    - bg background; rectangular frame on right with colored markers on its edges; sprites in a narrow left strip separated by a constant-color divider column.\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:40:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:41:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:42:    - For each color, target rows/cols are where both opposite frame edges share that color. Targets are the Cartesian product.\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:43:    - Erase each sprite from the left and stamp it centered at every target. Higher sprites cover lower ones.\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:44:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:45:    Key insight: One sprite replicates to a grid of row × column marker intersections.\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:46:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:47:    g = np.array(grid, dtype=int)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:48:    H, W = g.shape\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:49:    bg = int(get_bg(g))\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:50:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:51:    # --- frame interior: largest bg component not touching boundary ---\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:52:    inner_bbox = largest_enclosed_component_bbox(g == int(bg), connectivity=4)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:53:    assert not (inner_bbox is None)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:54:    ir0, ic0, ir1, ic1 = map(int, inner_bbox)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:55:    fr0, fc0, fr1, fc1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:56:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:57:    # --- divider columns (fixed) on the left side ---\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:58:    divider_mask = np.zeros((H, W), dtype=bool)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:59:    for c in range(0, max(0, int(fc0))):\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:60:        colv = g[:, int(c)]\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:61:        non = colv[colv != int(bg)]\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:62:        if int(len(non)) >= int(H - 1) and len(set(map(int, non))) == 1:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:63:            divider_mask[:, int(c)] = True\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:64:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:65:    left_cols = (np.arange(W)[None, :] < int(fc0))\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:66:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:67:    # --- sprites: per-color 8-connected components in left area (excluding divider) ---\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:68:    sprites = []\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:69:    for col in sorted(set(map(int, g.flatten())) - {int(bg)}):\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:70:        mask = (g == int(col)) & left_cols & (~divider_mask)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:71:        if not bool(mask.any()):\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:72:            continue\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:73:        slab, sn = label_mask(mask, connectivity=8)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:74:        for sid in range(1, int(sn) + 1):\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:75:            pts = np.argwhere(slab == int(sid))\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:76:            r0, c0 = pts.min(axis=0)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:77:            r1, c1 = pts.max(axis=0)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:78:            r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:79:            m = slab[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(sid)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:80:            sprites.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"r1\": int(r1), \"c1\": int(c1), \"mask\": m})\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:81:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:82:    move_colors = {int(s[\"color\"]) for s in sprites}\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:83:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:84:    # --- marker-derived targets (restricted to colors that actually appear as sprites) ---\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:85:    row_marks: dict[int, list[int]] = defaultdict(list)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:86:    col_marks: dict[int, list[int]] = defaultdict(list)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:87:    for r in range(int(ir0), int(ir1) + 1):\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:88:        cl = int(g[int(r), int(fc0)])\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:89:        cr = int(g[int(r), int(fc1)])\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:90:        if cl == cr and cl != int(bg) and cl in move_colors:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:91:            row_marks[int(cl)].append(int(r))\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:92:    for c in range(int(ic0), int(ic1) + 1):\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:93:        ct = int(g[int(fr0), int(c)])\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:94:        cb = int(g[int(fr1), int(c)])\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:95:        if ct == cb and ct != int(bg) and ct in move_colors:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:96:            col_marks[int(ct)].append(int(c))\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:97:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:98:    targets: dict[int, list[tuple[int, int]]] = {}\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:99:    for col in set(row_marks.keys()) & set(col_marks.keys()):\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:100:        pts = {(int(r), int(c)) for r in row_marks[int(col)] for c in col_marks[int(col)]}\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:101:        targets[int(col)] = sorted(pts)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:102:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:103:    out = g.copy()\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:104:    movers = [s for s in sprites if int(s[\"color\"]) in targets]\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:105:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:106:    # Erase originals of moved sprites.\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:107:    for s in movers:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:108:        r0, c0 = int(s[\"r0\"]), int(s[\"c0\"])\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:109:        for rr, cc in np.argwhere(s[\"mask\"]):\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:110:            out[int(r0) + int(rr), int(c0) + int(cc)] = int(bg)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:111:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:112:    # Bottom-to-top ordering: lower sprites first, upper sprites last (covering).\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:113:    movers.sort(key=lambda s: (-((int(s[\"r0\"]) + int(s[\"r1\"])) / 2.0), int(s[\"c0\"])))\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:114:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:115:    for s in movers:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:116:        col = int(s[\"color\"])\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:117:        cr = (int(s[\"r0\"]) + int(s[\"r1\"])) // 2\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:118:        cc = (int(s[\"c0\"]) + int(s[\"c1\"])) // 2\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:119:        pix = [(int(s[\"r0\"]) + int(rr), int(s[\"c0\"]) + int(cc2)) for rr, cc2 in np.argwhere(s[\"mask\"])]\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:120:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:121:        for tr, tc in targets[int(col)]:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:122:            dr = int(tr - cr)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:123:            dc = int(tc - cc)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:124:            for r, c in pix:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:125:                rr = int(r + dr)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:126:                cc3 = int(c + dc)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:127:                if int(ir0) <= rr <= int(ir1) and int(ic0) <= cc3 <= int(ic1):\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:128:                    out[rr, cc3] = int(col)\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:129:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:130:    return out\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:131:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:132:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:133:# ---------------------------------------------------------------------------\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:134:# generate_input\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:135:# ---------------------------------------------------------------------------\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:136:import random\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:137:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:138:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:139:def _pick_spaced(candidates: list[int], n: int, min_spacing: int) -> list[int] | None:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:306:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:307:    for _ in range(300):\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:308:        result = _gen_attempt()\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:309:        if result is not None:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:310:            return result\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:311:    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:282:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:283:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:284:    Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:285:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:286:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:287:    - The grid is a mosaic of monochrome regions.\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:288:    - Color 1 forms T-shaped control markers on region boundaries.\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:289:    - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:290:    - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:291:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:292:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:293:    - For a color-1 T marker, the single stem points at the destination region to repaint.\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:294:    - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:295:    - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:296:    - All marker cells are filled with the final color of the source-side region.\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:297:    - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:298:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:299:    Key insight:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:300:    - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:301:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:302:    g = np.asarray(grid, dtype=int)\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:303:    out = _solve_unrotated(g)\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:304:    l9 = _find_l9_orientation(g)\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:305:    if l9 == 'top_right':\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:306:        return np.rot90(out, 1)\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:307:    if l9 == 'top_left':\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:308:        return np.rot90(out, 3)\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:309:    return out\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:310:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:311:# --------------- generator (l9rot) ---------------\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:312:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:313:# ── Tunable constants ──────────────────────────────────────────────────\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:314:# Canvas / region sizing\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:315:GRID_SIZE_MAX = 30                          # max rows or cols\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:316:MIN_REGION_CELLS = 6                        # per-spec minimum\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:317:REGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:318:REGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:319:REGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:320:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:321:# Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:322:MARKER_MIN = 4\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:323:MARKER_MAX = 8\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:324:NORMAL_MAX = 6\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:325:COLORED_MAX = 2\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:326:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:327:# Color pool (all ARC colors except 1, which is reserved for T-marker cells)\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:328:COLOR_POOL = [c for c in range(10) if c != 1]\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:329:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:330:# L9 rotation marker\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:331:L9_PROBABILITY = 0.5                        # chance of placing a rotation marker\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:332:L9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:333:    'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:334:    'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:335:}\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:336:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:337:# Generation retry budget\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:338:SEED_ATTEMPTS = 200                         # tries to place n distinct region seeds\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:339:GEN_RETRIES = 300                           # outer generate_input retry budget\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:340:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:341:_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:342:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:343:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:344:# ── Small geometry helpers ─────────────────────────────────────────────\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:345:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:346:def _get_bar(stem):\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:700:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:701:    for _ in range(GEN_RETRIES):\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:702:        result = _gen_attempt()\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:703:        if result is not None:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:704:            return result\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:705:    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:14:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:15:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:16:    Expand the colored runs from the left reference panel into the blank right panel.\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:17:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:18:    Input structure:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:19:    - A uniform rectangular frame surrounds the grid.\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:20:    - One full-height divider of the frame color splits a left reference panel\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:21:      from a blank right panel.\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:22:    - Both panels have one background margin column on each side of their active\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:23:      columns; the left active columns contain two-column endpoint slots, possibly\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:24:      connected by same-color horizontal runs.\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:25:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:26:    Rule:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:27:    - Keep the original grid and paint only in the right panel's active columns.\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:28:    - A source run exactly matching the left endpoint slot is copied to the left\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:29:      two columns of the right active span.\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:30:    - A source run exactly matching the right endpoint slot is copied to the right\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:31:      two columns of the right active span.\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:32:    - A source run connecting the endpoint slots is stretched across the entire\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:33:      right active span.\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:34:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:35:    Key insight:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:36:    The left panel is a compressed legend for the right panel: endpoint markers\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:37:    stay two pixels wide, while connectors between endpoints expand to fill the\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:38:    distance between them.\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:39:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:40:    g = np.asarray(grid, dtype=int)\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:41:    assert g.ndim == 2, \"expected a 2D grid\"\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:42:    H, W = g.shape\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:43:    assert H >= 3 and W >= 7, \"grid too small for framed two-panel structure\"\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:44:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:45:    frame = int(g[0, 0])\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:46:    assert np.all(g[0, :] == frame) and np.all(g[-1, :] == frame), \"bad horizontal frame\"\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:47:    assert np.all(g[:, 0] == frame) and np.all(g[:, -1] == frame), \"bad vertical frame\"\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:48:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:49:    divider = _single_divider_column(g, frame)\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:50:    assert divider >= 5 and W - divider >= 6, \"panels must contain margins and active slots\"\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:51:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:52:    left_panel = g[1 : H - 1, 1:divider]\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:53:    left_bg = get_bg(left_panel)\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:54:    assert np.all(left_panel[:, 0] == left_bg), \"left panel must have a left margin\"\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:55:    assert np.all(left_panel[:, -1] == left_bg), \"left panel must have a right margin\"\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:56:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:57:    mini_start = 2\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:58:    mini_end = divider - 2\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:59:    assert mini_end - mini_start + 1 >= 4, \"left active region must contain two endpoint slots\"\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:60:    left_slot = (mini_start, mini_start + 1)\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:61:    right_slot = (mini_end - 1, mini_end)\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:62:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:63:    target_start = divider + 2\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:64:    target_end = W - 3\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:65:    assert target_end - target_start + 1 >= 4, \"right active region must contain endpoint slots\"\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:66:    right_bg = int(g[1, divider + 1])\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:67:    right_panel = g[1 : H - 1, divider + 1 : W - 1]\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:68:    assert np.all(right_panel == right_bg), \"right panel must be blank before expansion\"\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:69:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:70:    out = g.copy()\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:71:    painted_any = False\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:72:    for r in range(1, H - 1):\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:73:        c = mini_start\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:74:        while c <= mini_end:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:75:            color = int(g[r, c])\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:76:            if color == left_bg:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:77:                c += 1\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:78:                continue\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:79:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:80:            c0 = c\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:81:            while c <= mini_end and int(g[r, c]) == color:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:82:                c += 1\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:83:            c1 = c - 1\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:84:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:85:            in_left_slot = (c0, c1) == left_slot\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:86:            in_right_slot = (c0, c1) == right_slot\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:87:            if in_left_slot:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:88:                d0, d1 = target_start, target_start + 1\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:89:            elif in_right_slot:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:90:                d0, d1 = target_end - 1, target_end\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:91:            else:\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:92:                assert c0 == left_slot[0] and c1 >= right_slot[0], \"run must connect endpoint slots\"\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:93:                d0, d1 = target_start, target_end\n/home/lixinyu/snap/new/ARC_code/train/9841fdad.py:94:\n/home/lixinyu/