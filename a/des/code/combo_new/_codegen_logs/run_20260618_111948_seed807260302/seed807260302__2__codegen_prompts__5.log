in/5adee1b2.py:52:        objects = []\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:53:        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:54:            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:55:            if cells <= marker_source_cells[source]:\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:56:                continue\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:57:            objects.append(comp)\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:58:        assert objects, \"each legend source color must label at least one non-marker object\"\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:59:\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:60:        for obj in objects:\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:61:            r0, c0, r1, c1 = obj[\"bbox\"]\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:62:            pr0 = max(0, int(r0) - 1)\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:63:            pc0 = max(0, int(c0) - 1)\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:64:            pr1 = min(h - 1, int(r1) + 1)\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:65:            pc1 = min(w - 1, int(c1) + 1)\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:66:\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:67:            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:68:            coords = obj[\"coords\"]\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:69:            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:70:            enclosed = object_interior(patch, background=bg)\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:71:            fill_mask = (patch == bg) & ~enclosed\n/home/