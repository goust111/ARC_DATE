ue\n    _, n_comp = label_mask(wall_mask, connectivity=4)\n    wall_4conn = (n_comp == 1)\n\n    # --- Build output tile ---\n    out3 = np.full((5, 5), b, dtype=int)\n    for r in range(5):\n        for c in range(5):\n            v1, v2 = int(t1[r, c]), int(t2[r, c])\n            if (r, c) in inside:\n                if v1 != b:\n                    out3[r, c] = v1\n            elif (r, c) in wall:\n                if v1 != b:\n                    out3[r, c] = v1\n                elif wall_4conn and v2 != b:\n","exit_code":0,"status":"completed"}}
