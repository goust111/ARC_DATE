{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '282,390p;700,860p' /home/lixinyu/snap/new/ARC_code/eval/21897d95.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.\n\n    Input structure:\n    - The grid is a mosaic of monochrome regions.\n    - Color 1 forms T-shaped control markers on region boundaries.\n    - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.\n    - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.\n\n    Rule:\n    - For a color-1 T marker, the single stem points at the destination region to repaint.\n    - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.\n    - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.\n    - All marker cells are filled with the final color of the source-side region.\n    - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.\n\n    Key insight:\n    - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = _solve_unrotated(g)\n    l9 = _find_l9_orientation(g)\n    if l9 == 'top_right':\n        return np.rot90(out, 1)\n    if l9 == 'top_left':\n        return np.rot90(out, 3)\n    return out\n\n# --------------- generator (l9rot) ---------------\n\n# ── Tunable constants ──────────────────────────────────────────────────\n# Canvas / region sizing\nGRID_SIZE_MAX = 30                          # max rows or cols\nMIN_REGION_CELLS = 6                        # per-spec minimum\nREGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)\nREGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts\nREGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS\n\n# Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)\nMARKER_MIN = 4\nMARKER_MAX = 8\nNORMAL_MAX = 6\nCOLORED_MAX = 2\n\n# Color pool (all ARC colors except 1, which is reserved for T-marker cells)\nCOLOR_POOL = [c for c in range(10) if c != 1]\n\n# L9 rotation marker\nL9_PROBABILITY = 0.5                        # chance of placing a rotation marker\nL9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation\n    'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],\n    'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],\n}\n\n# Generation retry budget\nSEED_ATTEMPTS = 200                         # tries to place n distinct region seeds\nGEN_RETRIES = 300                           # outer generate_input retry budget\n\n_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n# ── Small geometry helpers ─────────────────────────────────────────────\n\ndef _get_bar(stem):\n    \"\"\"Return the two bar directions perpendicular to *stem*.\"\"\"\n    if stem[0] == 0:\n        return [(-1, 0), (1, 0)]\n    return [(0, -1), (0, 1)]\n\n\ndef _t_cells(center, stem):\n    \"\"\"Return the 4 cells of a T marker: center + stem tip + 2 bar cells.\"\"\"\n    r, c = center\n    bar = _get_bar(stem)\n    return {(r, c), (r + stem[0], c + stem[1]),\n            (r + bar[0][0], c + bar[0][1]), (r + bar[1][0], c + bar[1][1])}\n\n\ndef _t_branch_cells(center, stem):\n    \"\"\"Return the 3 branch cells (stem tip + 2 bar), excluding the center.\"\"\"\n    r, c = center\n    bar = _get_bar(stem)\n    return {(r + stem[0], c + stem[1]),\n            (r + bar[0][0], c + bar[0][1]),\n            (r + bar[1][0], c + bar[1][1])}\n\n\ndef _t_neighborhood(center, stem):\n    \"\"\"Return cells adjacent to any T cell but not part of the T itself.\"\"\"\n    cells = _t_cells(center, stem)\n    neighborhood = set()\n    for r, c in cells:\n        for dr, dc in _DIRS:\n            nb = (r + dr, c + dc)\n            if nb not in cells:\n                neighborhood.add(nb)\n    return neighborhood\n\n\n# ── Region partitioning ────────────────────────────────────────────────\n\ndef _grow_regions(H: int, W: int, n_regions: int) -> np.ndarray | None:\n    \"\"\"Grow n_regions from random seeds via randomized BFS; returns region-id array or None.\"\"\"\n    region = np.full((H, W), -1, dtype=int)\n    seeds = set()\n    for _ in range(SEED_ATTEMPTS):\n        if len(seeds) >= n_regions:\n            break\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,130p;253,430p' /home/lixinyu/snap/new/ARC_code/train/b71a7747.py\"","aggregated_output":"import itertools\n\nimport numpy as np\n\nfrom arc_utils import colors_present\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Extract the hidden two-color image by compacting the rows and columns of its complete mask.\n\n    Input structure\n    The grid contains one pair of colors whose pixels occupy every cell in the\n    cross product of their active rows and active columns; all other colors form\n    the surrounding filler or separators.\n    Rule\n    Find that unique color pair, keep exactly the rows and columns touched by\n    the pair, and return the induced subgrid.\n    Key insight\n    The target image is not chosen by color id; it is the only two-color mask\n    whose occupied pixels form a full rectangular row/column product after\n    deleting unused rows and columns.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    candidates = []\n    for pair in itertools.combinations(colors_present(g), 2):\n        mask = np.isin(g, pair)\n        rows = mask.any(axis=1)\n        cols = mask.any(axis=0)\n        rh = int(rows.sum())\n        cw = int(cols.sum())\n        if 0 < rh < h and 0 < cw < w and int(mask.sum()) == rh * cw:\n            out = g[np.ix_(rows, cols)]\n            if set(map(int, out.ravel())) == set(pair):\n                candidates.append(out)\n\n    assert len(candidates) == 1\n    return candidates[0].copy()\n\n# --------------- generator (att2) ---------------\n# Canvas and block layout bounds.\nN_BLOCK_OPTIONS = (3, 4)\nBLOCK_SIZE_RANGE = range(3, 6)\nSEPARATOR_WIDTH_RANGE = range(1, 4)\nPADDING_MIN = 2\nPADDING_MAX_EXCLUSIVE = 6\nINPUT_SIDE_MIN = 19\nINPUT_SIDE_MAX = 28\n\n# Hidden foreground shape density and pattern mix.\nFG_DENSITY_MIN = 0.14\nFG_DENSITY_MAX = 0.22\nRECT_LOOP_PROB = 0.25\nBRANCH_TRANSPOSE_PROB = 0.5\nMIN_BRANCH_ROW_GAP = 1\n\n# Color and retry settings.\nCOLOR_COUNT_OPTIONS = (4, 5)\nCOLOR_POOL = range(10)\nGENERATION_RETRIES = 300\n\nLAYOUT_CHOICES = [\n    (n_blocks, block_size, sep, pad0, pad1, side)\n    for n_blocks in N_BLOCK_OPTIONS\n    for block_size in BLOCK_SIZE_RANGE\n    for sep in SEPARATOR_WIDTH_RANGE\n    for pad0 in range(max(PADDING_MIN, sep), PADDING_MAX_EXCLUSIVE)\n    for pad1 in range(max(PADDING_MIN, sep), PADDING_MAX_EXCLUSIVE)\n    for side in [n_blocks * block_size + (n_blocks - 1) * sep + pad0 + pad1]\n    if INPUT_SIDE_MIN <= side <= INPUT_SIDE_MAX\n]\n\ndef _gen_density_bounds(size):\n    return int(np.ceil(FG_DENSITY_MIN * size * size)), int(np.floor(FG_DENSITY_MAX * size * size))\n\n\ndef _gen_between(a, b):\n    lo, hi = sorted((a, b))\n    return range(lo, hi + 1)\n\n\ndef _gen_rect_loop_mask(size, block_size):\n    lo, hi = _gen_density_bounds(size)\n    choices = []\n    for r0 in range(block_size):\n        for r1 in range(size - block_size, size):\n            for c0 in range(block_size):\n                for c1 in range(size - block_size, size):\n                    if r1 <= r0 or c1 <= c0:\n                        continue\n                    count = 2 * ((r1 - r0 + 1) + (c1 - c0 + 1)) - 4\n                    if lo <= count <= hi:\n                        choices.append((r0, r1, c0, c1))\n    if not choices:\n        return None\n\n    r0, r1, c0, c1 = random.choice(choices)\n    mask = np.zeros((size, size), dtype=bool)\n    mask[r0, c0 : c1 + 1] = True\n    mask[r1, c0 : c1 + 1] = True\n    mask[r0 : r1 + 1, c0] = True\n    mask[r0 : r1 + 1, c1] = True\n    return mask\n\n\ndef _gen_spaced_branch_rows(r0, r1, main_r):\n    rows = [r for r in range(r0, r1 + 1) if abs(r - main_r) > MIN_BRANCH_ROW_GAP]\n    random.shuffle(rows)\n    picked = []\n    for r in rows:\n        if all(abs(r - old) > MIN_BRANCH_ROW_GAP for old in picked):\n            picked.append(r)\n    return picked\n\n\ndef _gen_branch_mask(size, block_size):\n    left = random.randrange(block_size)\n    right = random.randrange(size - block_size, size)\n    r0 = random.randrange(block_size)\n    r1 = random.randrange(size - block_size, size)\n    trunk_c = random.randrange(left, right + 1)\n    main_r = random.randrange(r0, r1 + 1)\n\n    base = (r1 - r0 + 1) + (right - left)\n    density_min, max_count = _gen_density_bounds(size)\n    min_count = max(density_min, base)\n\n    picked = _gen_spaced_branch_rows(r0, r1, main_r)\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
