{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg\nimport random\n\n\ndef _assert_output_footprints_disjoint(dims: list[tuple[int, int]]) -> None:\n    occupied: set[tuple[int, int]] = set()\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, cc) for r in range(short) for cc in range(c, c + long)}\n        assert not (occupied & cells), \"normalized output rectangles must not overlap\"\n        occupied |= cells\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, cc)\n            for r in range(10 - long, 10)\n            for cc in range(c, c + short)\n        }\n        assert not (occupied & cells), \"normalized output rectangles must not overlap\"\n        occupied |= cells\n        c += short + 1\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.\n\n    Input structure\n    The grid has one background color and one foreground color; the foreground forms\n    separate solid rectangles, ordered from left to right.\n\n    Rule\n    Build a 10-row background canvas whose width is the packed width of the wide\n    versions of the rectangles. For each source rectangle, paint a top-aligned\n    rectangle of shape min(h,w) by max(h,w), with one background column between\n    consecutive rectangles. Then, starting again from the left edge, paint a\n    bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,\n    again separated by one background column.\n\n    Key insight\n    The input rectangles are not copied in their original orientations; each object\n    contributes one horizontal-facing and one vertical-facing normalized rectangle,\n    preserving left-to-right object order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n    fg = fg_colors[0]\n\n    components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n    assert components\n    components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n\n    dims: list[tuple[int, int]] = []\n    for obj in components:\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert obj[\"area\"] == h * w\n        dims.append((h, w))\n\n    out_h = 10\n    out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n    _assert_output_footprints_disjoint(dims)\n    out = np.full((out_h, out_w), bg, dtype=int)\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[:short, c : c + long] = fg\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[out_h - long : out_h, c : c + short] = fg\n        c += short + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\n# Rectangle counts and dimensions.\nRECT_COUNT_MIN = 4\nRECT_COUNT_MAX = 6\nSHORT_SIDE_MIN = 1\nSHORT_SIDE_MAX = 3\nSIDE_SUM_MAX = 10\nLONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN\n\n# Canvas and packing constraints.\nARC_GRID_MAX = 30\nOUTPUT_HEIGHT = 10\nGAP_WIDTH = 1\n\n# Retry policy.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_d749d46f_output_footprints_disjoint(dims):\n    occupied = set()\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, c) for r in range(short) for c in range(col, col + long)}\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += long + GAP_WIDTH\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, c)\n            for r in range(OUTPUT_HEIGHT - long, OUTPUT_HEIGHT)\n            for c in range(col, col + short)\n        }\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += short + GAP_WIDTH\n\n    return True\n\n\ndef _sample_dimensions(n_rects):\n    \"\"\"Sample source rectangle dimensions under the output-width budget.\"\"\"\n    dims = []\n    remaining_budget = ARC_GRID_MAX - GAP_WIDTH * (n_rects - 1)\n\n    for i in range(n_rects):\n        rects_left = n_rects - i\n        min_needed = rects_left - 1\n        max_for_this = min(remaining_budget - min_needed, LONG_SIDE_MAX)\n        if max_for_this < SHORT_SIDE_MIN:\n            return None\n\n        short = random.randint(SHORT_SIDE_MIN, SHORT_SIDE_MAX)\n        max_long = min(SIDE_SUM_MAX - short, max_for_this)\n        if max_long < short:\n            short = SHORT_SIDE_MIN\n            max_long = min(LONG_SIDE_MAX, max_for_this)\n            if max_long < SHORT_SIDE_MIN:\n                return None\n\n        long = random.randint(short, max_long)\n        remaining_budget -= long\n\n        if random.random() < 0.5:\n            h, w = long, short\n        else:\n            h, w = short, long\n        dims.append((h, w))\n\n    return dims\n\n\ndef _input_shape(dims):\n    return max(h for h, _ in dims), sum(w for _, w in dims) + GAP_WIDTH * (len(dims) - 1)\n\n\ndef _background_is_dominant(dims, inp_h, inp_w):\n    fg_pixels = sum(h * w for h, w in dims)\n    total_pixels = inp_h * inp_w\n    bg_pixels = total_pixels - fg_pixels\n    return bg_pixels > fg_pixels\n\n\ndef _build_input_grid(dims, bg, fg, inp_h, inp_w):\n    grid = np.full((inp_h, inp_w), bg, dtype=int)\n    col = 0\n    for h, w in dims:\n        grid[:h, col:col + w] = fg\n        col += w + GAP_WIDTH\n    return grid\n\n\ndef _passes_solver_oracle(grid):\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return out.shape[0] == OUTPUT_HEIGHT\n\n\ndef _gen_attempt():\n    \"\"\"Generate one valid input grid, or None when sampled dimensions fail constraints.\"\"\"\n    bg, fg = random.sample(COLOR_VALUES, 2)\n    n_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)\n    dims = _sample_dimensions(n_rects)\n    if dims is None:\n        return None\n\n    inp_h, inp_w = _input_shape(dims)\n    if inp_w > ARC_GRID_MAX:\n        return None\n    if not _gen_d749d46f_output_footprints_disjoint(dims):\n        return None\n    if inp_h > ARC_GRID_MAX or inp_h < 1:\n        return None\n    if not _background_is_dominant(dims, inp_h, inp_w):\n        return None\n\n    grid = _build_input_grid(dims, bg, fg, inp_h, inp_w)\n    if not _passes_solver_oracle(grid):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' /home/lixinyu/snap/new/ARC_code/train/458e3a53.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' /home/lixinyu/snap/new/ARC_code/train/458e3a53.py\"","aggregated_output":"import numpy as np\nimport random\nfrom arc_utils import paste\n\n\ndef _bands(size: int, separators: list[int]) -> list[tuple[int, int]]:\n    bands = []\n    start = 0\n    for cut in separators:\n        if start < cut:\n            bands.append((start, cut - 1))\n        start = cut + 1\n    if start < size:\n        bands.append((start, size - 1))\n    return bands\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extract the compact table of solid cells hidden inside a separator lattice.\n\n    Input structure\n    - The grid has full-width and full-height bars of one separator color, dividing it into rectangular cells.\n    - Most cells contain a repeating multicolor pattern, while a contiguous rectangle of cells is solid monochrome.\n\n    Rule\n    - Split the input into lattice cells using the full separator rows and columns.\n    - Keep the cells whose full interior is one color, crop to their occupied rectangle, and output those colors.\n\n    Key insight\n    - The periodic pattern is noise; only completely solid lattice cells encode the reduced output grid.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    row_colors = {int(g[r, 0]) for r in range(h) if np.all(g[r, :] == g[r, 0])}\n    col_colors = {int(g[0, c]) for c in range(w) if np.all(g[:, c] == g[0, c])}\n    sep_colors = row_colors & col_colors\n    assert len(sep_colors) == 1, \"there must be exactly one row/column separator color\"\n    sep = next(iter(sep_colors))\n    assert row_colors == {sep}, \"all full rows must be separator rows\"\n    assert col_colors == {sep}, \"all full columns must be separator columns\"\n\n    sep_rows = [r for r in range(h) if np.all(g[r, :] == sep)]\n    sep_cols = [c for c in range(w) if np.all(g[:, c] == sep)]\n    assert sep_rows and sep_cols, \"separator lattice must have rows and columns\"\n\n    row_bands = _bands(h, sep_rows)\n    col_bands = _bands(w, sep_cols)\n\n    solid_cells = {}\n    for ri, (r0, r1) in enumerate(row_bands):\n        for ci, (c0, c1) in enumerate(col_bands):\n            cell = g[r0 : r1 + 1, c0 : c1 + 1]\n            if np.all(cell == cell[0, 0]):\n                solid_cells[(ri, ci)] = int(cell[0, 0])\n    assert solid_cells, \"must contain at least one solid lattice cell\"\n\n    solid_rows = [ri for ri, _ in solid_cells]\n    solid_cols = [ci for _, ci in solid_cells]\n    r0, r1 = min(solid_rows), max(solid_rows)\n    c0, c1 = min(solid_cols), max(solid_cols)\n\n    out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)\n    for ri in range(r0, r1 + 1):\n        for ci in range(c0, c1 + 1):\n            assert (ri, ci) in solid_cells, \"solid lattice cells must form a rectangle\"\n            out[ri - r0, ci - c0] = solid_cells[(ri, ci)]\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Lattice dimensions: valid (L, cell_size) pairs produce 27-30 square grids.\nVALID_LC = [(4, 6), (5, 5), (6, 4)]\nCOLOR_COUNT = 10\nSEPARATOR_WIDTH = 1\n# Solid rectangle: output block size in lattice coordinates.\nSOLID_SIZE_RANGE = (2, 3)\n# Pattern cells: diagonal variants are multicolor and solver-visible as non-solid.\nPATTERN_TILE_MIN_COLORS = 5\nPATTERN_CELL_MIN_COLORS = 2\nDIAGONAL_ID_BITS = 4\n# Retry budget: regenerate on rare validation failures.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _pattern_tiles(csize: int, lattice: int, sep: int) -> dict[int, np.ndarray]:\n    \"\"\"Build one structured tile per lattice diagonal, or {} if validation fails.\"\"\"\n    colors = [c for c in range(COLOR_COUNT) if c != sep]\n    random.shuffle(colors)\n    palette = colors[: random.randint(PATTERN_TILE_MIN_COLORS, len(colors))]\n    palette_arr = np.asarray(palette, dtype=int)\n    k = len(palette)\n\n    rr, cc = np.indices((csize, csize))\n    base = (rr + cc + random.randrange(k)) % k\n    if random.choice([False, True]):\n        base = base.T\n    if random.choice([False, True]):\n        base = np.fliplr(base)\n    if random.choice([False, True]):\n        base = np.flipud(base)\n    tiles = {}\n    for diag in range(2 * lattice - 1):\n        tile_idx = (base + random.randrange(k)) % k\n        tile = palette_arr[tile_idx]\n        # Encode the diagonal id in four cells so variants are guaranteed distinct.\n        for bit in range(DIAGONAL_ID_BITS):\n            tile.flat[bit] = palette[(diag >> bit) & 1]\n        if len(np.unique(tile)) < PATTERN_TILE_MIN_COLORS:\n            return {}\n        tiles[diag] = tile\n    return tiles\n\n\ndef _sample_solid_block(lattice, colors):\n    \"\"\"Return ((row, col, height, width), output colors) for the solid block.\"\"\"\n    solid_h = random.randint(*SOLID_SIZE_RANGE)\n    solid_w = random.randint(*SOLID_SIZE_RANGE)\n    solid_r0 = random.randint(0, lattice - solid_h)\n    solid_c0 = random.randint(0, lattice - solid_w)\n    flat = np.random.choice(colors, size=solid_h * solid_w).astype(int)\n    if len(set(map(int, flat))) == 1:\n        change_at = random.randrange(len(flat))\n        flat[change_at] = random.choice([c for c in colors if c != int(flat[change_at])])\n    return (solid_r0, solid_c0, solid_h, solid_w), flat.reshape((solid_h, solid_w))\n\n\ndef _render_grid(lattice, csize, sep, block, out, tiles):\n    \"\"\"Assemble the separator lattice from solid cells and pattern tiles.\"\"\"\n    n = lattice * csize + (lattice - 1)\n    grid = np.full((n, n), sep, dtype=int)\n    solid_r0, solid_c0, solid_h, solid_w = block\n    stride = csize + SEPARATOR_WIDTH\n    for ri in range(lattice):\n        for ci in range(lattice):\n            r0, c0 = ri * stride, ci * stride\n            if solid_r0 <= ri < solid_r0 + solid_h and solid_c0 <= ci < solid_c0 + solid_w:\n                cell = np.full((csize, csize), int(out[ri - solid_r0, ci - solid_c0]), dtype=int)\n            else:\n                cell = tiles[(ri - ci) % (2 * lattice - 1)]\n            paste(grid, cell, r0, c0)\n    return grid\n\n\ndef _valid_generated_grid(grid, lattice, csize, sep, block):\n    \"\"\"Check separator lines and non-solid cells before the solver oracle.\"\"\"\n    stride = csize + SEPARATOR_WIDTH\n    sep_lines = [csize + i * stride for i in range(lattice - 1)]\n    if not all(np.all(grid[r, :] == sep) and np.all(grid[:, r] == sep) for r in sep_lines):\n        return False\n    solid_r0, solid_c0, solid_h, solid_w = block\n    for ri in range(lattice):\n        for ci in range(lattice):\n            if solid_r0 <= ri < solid_r0 + solid_h and solid_c0 <= ci < solid_c0 + solid_w:\n                continue\n            r0, c0 = ri * stride, ci * stride\n            if len(np.unique(grid[r0 : r0 + csize, c0 : c0 + csize])) < PATTERN_CELL_MIN_COLORS:\n                return False\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    lattice, csize = random.choice(VALID_LC)\n    sep = random.randrange(COLOR_COUNT)\n    colors = [c for c in range(COLOR_COUNT) if c != sep]\n    block, out = _sample_solid_block(lattice, colors)\n    tiles = _pattern_tiles(csize, lattice, sep)\n    if not tiles:\n        return None\n    grid = _render_grid(lattice, csize, sep, block, out, tiles)\n    if not _valid_generated_grid(grid, lattice, csize, sep, block):\n        return None\n    try:\n        if not np.array_equal(main(grid), out):\n            return None\n    except AssertionError:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 458e3a53 input\")\n","exit_code":0,"status":"completed"}}
