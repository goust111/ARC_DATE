{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '280,620p' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\"","aggregated_output":"def _compute_offsets(G, n, num_coarse):\n    if num_coarse == 1:\n        return [1]\n    first = 1\n    last = G - n - 1\n    if last < first:\n        return None\n    step = (last - first) / (num_coarse - 1)\n    return [int(round(first + i * step)) for i in range(num_coarse)]\n\n\ndef _gen_attempt():\n    reached = random.random() < 0.5\n    n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])\n\n    min_size = max(10, 5 * n)\n    if min_size > 20:\n        return None\n    G = random.randint(min_size, 20)\n    H = W = G\n\n    min_spacing = n + 1\n    max_coarse = max(3, (G - 2) // min_spacing)\n    coarse_dim = random.randint(3, min(6, max_coarse))\n    coarse_rows = coarse_cols = coarse_dim\n\n    offsets_r = _compute_offsets(G, n, coarse_rows)\n    offsets_c = _compute_offsets(G, n, coarse_cols)\n    if offsets_r is None or offsets_c is None:\n        return None\n    for i in range(len(offsets_r) - 1):\n        if offsets_r[i + 1] - offsets_r[i] < n:\n            return None\n    for i in range(len(offsets_c) - 1):\n        if offsets_c[i + 1] - offsets_c[i] < n:\n            return None\n\n    edge_cells = set()\n    for c in range(coarse_cols):\n        edge_cells.add((0, c))\n        edge_cells.add((coarse_rows - 1, c))\n    for r in range(1, coarse_rows - 1):\n        edge_cells.add((r, 0))\n        edge_cells.add((r, coarse_cols - 1))\n    edge_cells = list(edge_cells)\n    random.shuffle(edge_cells)\n    start_coarse = edge_cells[0]\n    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))\n    end_coarse = far[0] if far[0] != start_coarse else far[1]\n\n    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)\n    if walk is None or len(walk) < 4:\n        return None\n    if len(set(cr for cr, _ in walk)) < coarse_rows or len(set(cc for _, cc in walk)) < coarse_cols:\n        return None\n\n    grid = np.full((H, W), _BG, dtype=int)\n    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)\n\n    mask = (grid != _BG)\n    if np.any(mask, axis=1).sum() / H < 0.70 or np.any(mask, axis=0).sum() / W < 0.70:\n        return None\n\n    mover_r, mover_c = pixel_pos[0]\n    dest_r, dest_c = pixel_pos[-1]\n\n    # Extend dest to touch grid edge\n    def _extend_to_edge(pr, pc):\n        candidates = []\n        for direction in ['top', 'bottom', 'left', 'right']:\n            if direction == 'top':\n                dist = pr\n                if dist == 0:\n                    candidates.append((0, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n) if c < W):\n                    candidates.append((0, pc, dist))\n            elif direction == 'bottom':\n                dist = H - (pr + n)\n                if dist == 0:\n                    candidates.append((pr, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n) if c < W):\n                    candidates.append((H - n, pc, dist))\n            elif direction == 'left':\n                dist = pc\n                if dist == 0:\n                    candidates.append((pr, 0, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc) if r < H):\n                    candidates.append((pr, 0, dist))\n            elif direction == 'right':\n                dist = W - (pc + n)\n                if dist == 0:\n                    candidates.append((pr, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W) if r < H):\n                    candidates.append((pr, W - n, dist))\n        if not candidates:\n            return None\n        candidates.sort(key=lambda x: x[2])\n        return candidates[0][:2]\n\n    result = _extend_to_edge(dest_r, dest_c)\n    if result is None:\n        return None\n    new_dest_r, new_dest_c = result\n    if new_dest_r != dest_r:\n        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n\n        grid[r_lo:r_hi, dest_c:dest_c + n] = _RIVER\n    if new_dest_c != dest_c:\n        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n\n        grid[dest_r:dest_r + n, c_lo:c_hi] = _RIVER\n    dest_r, dest_c = new_dest_r, new_dest_c\n    if not (dest_r == 0 or dest_r + n == H or dest_c == 0 or dest_c + n == W):\n        return None\n\n    # Mover: near edge but not touching\n    touching = (mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W)\n    if touching:\n        if mover_r == 0:\n            grid[0, mover_c:mover_c + n] = _RIVER; mover_r = 1\n        elif mover_r + n == H:\n            grid[H - 1, mover_c:mover_c + n] = _RIVER; mover_r = H - n - 1\n        elif mover_c == 0:\n            grid[mover_r:mover_r + n, 0] = _RIVER; mover_c = 1\n        elif mover_c + n == W:\n            grid[mover_r:mover_r + n, W - 1] = _RIVER; mover_c = W - n - 1\n    if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:\n        return None\n    if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:\n        return None\n\n    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\n    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _RIVER\n\n    # Chokepoints for stuck case\n    if not reached and n >= 2:\n        num_choke = random.randint(1, min(3, len(walk) - 2))\n        min_seg = max(1, len(walk) // 4)\n        available = list(range(min_seg, len(walk) - 1))\n        random.shuffle(available)\n        for seg_idx in available[:num_choke]:\n            pr1, pc1 = pixel_pos[seg_idx]\n            pr2, pc2 = pixel_pos[min(seg_idx + 1, len(pixel_pos) - 1)]\n            direction = 'h' if pr1 == pr2 else 'v'\n            _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)\n        if not _river_connected(grid):\n            return None\n\n    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _MOVER\n    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _DEST\n\n    trav = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)\n    h2, w2 = H - n + 1, W - n + 1\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if trav[r:r + n, c:c + n].all():\n                feasible[r, c] = True\n    if not feasible[mover_r, mover_c]:\n        return None\n\n    dist = _bfs_placement(feasible, mover_r, mover_c)\n    dest_ok = (0 <= dest_r < h2 and 0 <= dest_c < w2 and\n               feasible[dest_r, dest_c] and dist[dest_r, dest_c] >= 0)\n    if reached and not dest_ok:\n        return None\n    if not reached and dest_ok:\n        return None\n\n    if dest_ok:\n        tr, tc = dest_r, dest_c\n    else:\n        best_d = -1\n        tr, tc = mover_r, mover_c\n        for r in range(h2):\n            for c in range(w2):\n                if dist[r, c] > best_d:\n                    best_d = dist[r, c]\n                    tr, tc = r, c\n\n    output = grid.copy()\n    output[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\n    output[tr:tr + n, tc:tc + n] = _MOVER\n\n    if not np.array_equal(main(grid), output):\n        return None\n    return grid\n\n\ndef generate_input():\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom arc_utils import get_bg, in_bounds, neighbors4, label_mask\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect framed squares via colored bridges following a control-pixel sequence.\n\n    Input structure:\n    - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.\n    - Control row below squares: colored pixels read left-to-right encode visitation order.\n\n    Rule:\n    - Start at the square matching first control color c0.\n    - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.\n    - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.\n\n    Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # border color = most common non-bg color\n    cnt = Counter(map(int, g.flatten()))\n    border = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            border = int(col)\n            break\n    assert not (border is None)\n\n    # detect framed squares as connected components of the border color\n    lab, n = label_mask(g == int(border), connectivity=4)\n    frames: list[dict] = []\n    for cid in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(cid))\n        if int(pts.shape[0]) < 8:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        if h < 3 or w < 3:\n            continue\n\n        t = None\n        inner_col = None\n        for tt in range(1, int(min(h, w) // 2) + 1):\n            inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]\n            if inner.size == 0:\n                continue\n            if bool((inner == int(border)).any()):\n                continue\n            u = set(map(int, inner.flatten()))\n            if len(u) != 1:\n                continue\n\n            ok = True\n            if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not ok:\n                continue\n\n            t = int(tt)\n            inner_col = int(next(iter(u)))\n            break\n\n        if t is None or inner_col is None:\n            continue\n\n        frames.append(\n            {\n                \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n                \"t\": int(t),\n                \"inner\": int(inner_col),\n                \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            }\n        )\n\n    assert not (not frames)\n\n    by: dict[int, list[dict]] = defaultdict(list)\n    for f in frames:\n        by[int(f[\"inner\"])].append(f)\n\n    max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n\n    # control row = bottom-most row below the squares with >=2 non-bg pixels\n    ctrl_r = None\n    for r in range(int(H - 1), int(max_frame_r), -1):\n        if int((g[int(r)] != int(bg)).sum()) >= 2:\n            ctrl_r = int(r)\n            break\n    assert not (ctrl_r is None)\n\n    ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n    assert not (len(ctrl) < 2)\n\n    def center(f: dict) -> tuple[int, int]:\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        return int((r0 + r1) // 2), int((c0 + c1) // 2)\n\n    def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n        a = f1[\"inner_bbox\"]\n        b = f2[\"inner_bbox\"]\n        same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n        same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))\n        return same_row, same_col\n\n    # choose start frame\n    start_color = int(ctrl[0])\n    assert not (start_color not in by)\n    start_cands = by[start_color]\n    if len(start_cands) == 1:\n        cur = start_cands[0]\n    else:\n        nxt_color = int(ctrl[1])\n        nxt_cands = by.get(nxt_color, [])\n        best = None\n        bestf = None\n        for f in start_cands:\n            for g2 in (nxt_cands if nxt_cands else [f]):\n                sr, sc = aligned(f, g2)\n                al = 1 if (sr or sc) else 0\n                (r1_, c1_) = center(f)\n                (r2_, c2_) = center(g2)\n                d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n                cand = (int(al), -int(d))\n                if best is None or cand > best:\n                    best = cand\n                    bestf = f\n        cur = bestf\n\n    out = g.copy()\n\n    def draw_bridge(fa: dict, fb: dict, color: int) -> None:\n        (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n        (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n        ia = fa[\"inner_bbox\"]\n        sr, sc = aligned(fa, fb)\n        if sr:\n            rr0, rr1 = int(ia[0]), int(ia[2])\n            if int(c1a) < int(c0b):\n                cc0, cc1 = int(c1a + 1), int(c0b - 1)\n            else:\n                cc0, cc1 = int(c1b + 1), int(c0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n            return\n        if sc:\n            cc0, cc1 = int(ia[1]), int(ia[3])\n            if int(r1a) < int(r0b):\n                rr0, rr1 = int(r1a + 1), int(r0b - 1)\n            else:\n                rr0, rr1 = int(r1b + 1), int(r0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n\n    for i in range(int(len(ctrl)) - 1):\n        a = int(ctrl[i])\n        b = int(ctrl[i + 1])\n        assert int(cur[\"inner\"]) == int(a)\n        assert b in by, f\"control color {b} has no matching frame\"\n        cands = by[b]\n        best = None\n        bestf = None\n        for f in cands:\n            sr, sc = aligned(cur, f)\n            al = 1 if (sr or sc) else 0\n            (r1_, c1_) = center(cur)\n            (r2_, c2_) = center(f)\n            d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n            cand = (int(al), -int(d))\n            if best is None or cand > best:\n                best = cand\n                bestf = f\n        nxt = bestf\n        draw_bridge(cur, nxt, int(a))\n        cur = nxt\n\n    return out\n\n\ndef _most_common_nonbg(g: np.ndarray, bg: int) -> int | None:\n    cnt = Counter(map(int, g.flatten()))\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            return int(col)\n    return None\n\ndef _draw_frame(g: np.ndarray, *, r0: int, c0: int, outer: int, t: int, border: int, inner_col: int) -> None:\n    g[int(r0) : int(r0 + outer), int(c0) : int(c0 + outer)] = int(border)\n    g[int(r0 + t) : int(r0 + outer - t), int(c0 + t) : int(c0 + outer - t)] = int(inner_col)\n\ndef _bridge_cells(fa: dict, fb: dict) -> set[tuple[int, int]]:\n    (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n    (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n    ia = fa[\"inner_bbox\"]\n    ib = fb[\"inner_bbox\"]\n    # same-row band\n    if int(ia[0]) == int(ib[0]) and int(ia[2]) == int(ib[2]):\n        rr0, rr1 = int(ia[0]), int(ia[2])\n        if int(c1a) < int(c0b):\n            cc0, cc1 = int(c1a + 1), int(c0b - 1)\n        else:\n            cc0, cc1 = int(c1b + 1), int(c0a - 1)\n        assert int(cc0) <= int(cc1), \"horizontal bridge gap must be non-empty\"\n        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n    # same-col band\n    if int(ia[1]) == int(ib[1]) and int(ia[3]) == int(ib[3]):\n        cc0, cc1 = int(ia[1]), int(ia[3])\n        if int(r1a) < int(r0b):\n            rr0, rr1 = int(r1a + 1), int(r0b - 1)\n        else:\n            rr0, rr1 = int(r1b + 1), int(r0a - 1)\n        assert int(rr0) <= int(rr1), \"vertical bridge gap must be non-empty\"\n        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n    return set()\n\n_DIGITS = [int(i) for i in range(10)]\n\ndef _gen_attempt() -> np.ndarray | None:\n    # --- colors ---\n    bg = int(np.random.choice(np.array(_DIGITS, dtype=int)))\n    border = int(np.random.choice(np.array([d for d in _DIGITS if int(d) != int(bg)], dtype=int)))\n    inner_palette = [int(d) for d in _DIGITS if int(d) not in (int(bg), int(border))]\n    if len(inner_palette) < 3:\n        return None\n\n    # --- geometry ---\n    t = int(np.random.choice(np.array([1, 1, 2], dtype=int)))\n    inner = int(np.random.randint(1, 4))  # 1..3\n    outer = int(inner + 2 * t)\n    if not (3 <= int(outer) <= 7):\n        return None\n\n    # lattice dims and number of squares (all on the path)\n    R = int(np.random.randint(2, 6))\n    C = int(np.random.randint(2, 6))\n    max_frames = int(R * C)\n    if max_frames < 4:\n        return None\n    n_frames = int(np.random.randint(4, int(min(12, max_frames)) + 1))\n\n    # sample a self-avoiding path of length n_frames starting at (0,0)\n    path: list[tuple[int, int]] | None = None\n    for _path_try in range(400):\n        p = [(0, 0)]\n        vis = {(0, 0)}\n        ok = True\n        for _ in range(int(n_frames) - 1):\n            cur = p[-1]\n            r, c = map(int, cur)\n            opts = [\n                (int(rr), int(cc))\n                for rr, cc in neighbors4(int(r), int(c))\n                if in_bounds((int(R), int(C)), int(rr), int(cc)) and (int(rr), int(cc)) not in vis\n            ]\n            if not opts:\n                ok = False\n                break\n            nxt = opts[int(np.random.randint(0, len(opts)))]\n            p.append((int(nxt[0]), int(nxt[1])))\n            vis.add((int(nxt[0]), int(nxt[1])))\n        if not ok:\n            continue\n        # Prefer scenes that span multiple rows/cols (matches eval's \"lattice\" feel).\n        if len({r for r, _c in p}) < 2 or len({c for _r, c in p}) < 2:\n            continue\n        path = p\n        break\n    if path is None:\n        return None\n\n    # sample uneven row/col gaps (eval-like) but keep at least 1 bg cell separation\n    row_gap = [int(np.random.randint(1, 6)) for _ in range(int(R) - 1)]\n    col_gap = [int(np.random.randint(1, 6)) for _ in range(int(C) - 1)]\n    top_margin = int(np.random.randint(1, 4))\n    left_margin = int(np.random.randint(1, 4))\n\n    r0s = [int(top_margin)]\n    for k in range(int(R) - 1):\n        r0s.append(int(r0s[-1] + outer + row_gap[int(k)]))\n    c0s = [int(left_margin)]\n    for k in range(int(C) - 1):\n        c0s.append(int(c0s[-1] + outer + col_gap[int(k)]))\n\n    # frame dicts (only for visited path cells)\n    slot_to_frame: dict[tuple[int, int], dict] = {}\n    frames: list[dict] = []\n    for rr, cc in path:\n        r0 = int(r0s[int(rr)])\n        c0 = int(c0s[int(cc)])\n        r1 = int(r0 + outer - 1)\n        c1 = int(c0 + outer - 1)\n        f = {\n            \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n            \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            \"slot\": (int(rr), int(cc)),\n        }\n        frames.append(f)\n        slot_to_frame[(int(rr), int(cc))] = f\n\n    max_r1 = max(int(f[\"bbox\"][2]) for f in frames)\n    max_c1 = max(int(f[\"bbox\"][3]) for f in frames)\n\n    ctrl_gap = int(np.random.randint(2, 6))\n","exit_code":0,"status":"completed"}}
