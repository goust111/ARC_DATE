{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '8,105p;245,310p' /home/lixinyu/snap/new/ARC_code/eval/58490d8a.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count colored objects and record tallies inside a legend box.\n\n    Input structure:\n    - A black rectangular legend box with key-color pixels in its leftmost non-black column.\n    - Outside the box, distinct objects of each key color are scattered across the grid.\n\n    Rule:\n    - For each key color, count separate same-colored objects outside the legend box.\n    - Output the legend box repainted: each key row gets one dot per object, spaced every other cell rightward from the key pixel.\n\n    Key insight: The legend is both the color index and the output canvas — object counts become dot sequences on the matching row.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    _bg = int(get_bg(g))\n\n    black = 0\n\n    # STEP 1) Find the legend bbox: largest black CC whose bbox contains some non-black pixels.\n    best = None  # (area, bbox)\n    for coords in components_mask(g == int(black), connectivity=8):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if (sub != int(black)).any():\n            area = int(coords.shape[0])\n            cand = (area, tuple(map(int, b)))\n            if best is None or cand[0] > best[0]:\n                best = cand\n\n    assert not (best is None)\n\n    r0, c0, r1, c1 = map(int, best[1])\n    box = crop_bbox(g, (r0, c0, r1, c1))\n    bh, bw = map(int, box.shape)\n\n    # STEP 2) Inside the legend bbox, find the key column:\n    # leftmost column with any non-black pixels (the \"key pixels\").\n    key_col = None\n    for cc in range(bw):\n        if (box[:, int(cc)] != int(black)).any():\n            key_col = int(cc)\n            break\n    if key_col is None:\n        return np.zeros_like(box)\n\n    keys = [(int(rr), int(box[int(rr), int(key_col)])) for rr in range(bh) if int(box[int(rr), int(key_col)]) != int(black)]\n    keys.sort(key=lambda t: int(t[0]))\n\n    outside = np.ones((H, W), dtype=bool)\n    outside[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = False\n    out = np.zeros((bh, bw), dtype=int)\n\n    # STEP 3/4) Count CCs of each key color outside the legend, then draw 1 dot per CC.\n    for rr, col in keys:\n        mask = (g == int(col)) & outside\n        _labc, nc = label_mask(mask, connectivity=8)\n        for i in range(int(nc)):\n            cc = int(key_col + 2 * i)\n            if 0 <= cc < bw:\n                out[int(rr), int(cc)] = int(col)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette and legend color choices.\nCOLOR_POOL = tuple(range(1, 10))\nBLACK = 0\nDISTRACTOR_PROB = 0.5\n\n# Key rows and tally dimensions.\nKEY_COUNT_RANGE = (2, 4)\nTARGET_COUNT_RANGE = (1, 5)\nKEY_ROW_FIRST = 1\nKEY_ROW_STEP = 2\nKEY_COLUMN = 1\nTALLY_COL_STEP = 2\nLEGEND_HEIGHT_TAIL = 1\nLEGEND_WIDTH_TAIL = 1\nLEGEND_SLACK_RANGE = (0, 3)\n\n# Canvas size and legend placement bounds.\nGRID_HEIGHT_RANGE = (20, 25)\nGRID_WIDTH_RANGE = (20, 25)\nLEGEND_EDGE_MARGIN = 2\n\n# Sprite shape and placement constraints.\nSPRITE_AREA_RANGE = (4, 7)\nSPRITE_BBOXES = ((2, 2), (2, 3), (3, 2), (3, 3))\nSPRITE_CONNECTIVITY = 8\nSPRITE_PADDING = 1\nSPRITE_PADDING_CONNECTIVITY = 8\n\n# Retry budget for rejection sampling.\n    \"\"\"Run one output-first generation attempt and reject solver mismatches.\"\"\"\n    bg, key_colors, distractor_color = _sample_palette()\n    counts = _sample_counts(len(key_colors))\n    expected = _build_expected(key_colors, counts)\n    legend = _build_legend(expected.shape, key_colors)\n    grid = _new_grid_with_legend(bg, legend)\n    if grid is None:\n        return None\n\n    sprites = _build_sprite_queue(key_colors, counts, distractor_color, bg)\n    try:\n        _place_sprites(grid, sprites, bg)\n    except ValueError:\n        return None\n\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 58490d8a input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '18,100p;274,340p' /home/lixinyu/snap/new/ARC_code/train/b1986d4b.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Render the filled-square object counts as compact nested stacks ordered by count rank.\n\n    Input structure\n    A large noisy grid has a dominant background, scattered non-square noise, and\n    filled monochrome square objects. Each square side length has exactly one\n    object color, and side lengths form consecutive sizes.\n\n    Rule\n    Ignore non-square components. If the lowest square in the scene is of the\n    smallest side length, treat that one smallest square as a distractor and do\n    not count it. For count rank k from left to right, create one block from all\n    square sizes with at least k remaining objects; draw larger squares first and\n    smaller squares over their upper-left corner, then append one background\n    separator column.\n\n    Key insight\n    The output is a count histogram of square side lengths, but each histogram\n    slot is rendered as nested upper-left square masks using the side colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    objects = _square_objects(g, bg)\n    assert objects, \"expected filled square objects\"\n\n    sides = sorted({obj[\"side\"] for obj in objects})\n    assert sides == list(range(sides[0], sides[-1] + 1)), \"expected consecutive square side lengths\"\n\n    by_side = {side: [obj for obj in objects if obj[\"side\"] == side] for side in sides}\n    colors = {}\n    for side, side_objects in by_side.items():\n        side_colors = {obj[\"color\"] for obj in side_objects}\n        assert len(side_colors) == 1, \"each side length should have one color\"\n        colors[side] = side_colors.pop()\n\n    smallest = sides[0]\n    lowest_row = max(obj[\"bbox\"][2] for obj in objects)\n    lowest_smallest = [obj for obj in by_side[smallest] if obj[\"bbox\"][2] == lowest_row]\n    if lowest_smallest:\n        assert len(lowest_smallest) == 1, \"expected at most one lowest smallest distractor\"\n        drop_bbox = lowest_smallest[0][\"bbox\"]\n        by_side[smallest] = [obj for obj in by_side[smallest] if obj[\"bbox\"] != drop_bbox]\n\n    counts = {side: len(side_objects) for side, side_objects in by_side.items()}\n    assert all(count > 0 for count in counts.values()), \"each square size should remain represented\"\n\n    out_h = sides[-1] + 1\n    groups = []\n    for rank in range(max(counts.values())):\n        present_sides = [side for side in sides if counts[side] > rank]\n        assert present_sides, \"rank should contain at least one square size\"\n\n        group_w = max(present_sides)\n        group = np.full((out_h, group_w), bg, dtype=int)\n        for side in sorted(present_sides, reverse=True):\n            group[:side, :side] = colors[side]\n        groups.append(group)\n\n    out_w = sum(group.shape[1] + 1 for group in groups)\n    out = np.full((out_h, out_w), bg, dtype=int)\n    c = 0\n    for group in groups:\n        w = group.shape[1]\n        out[:, c : c + w] = group\n        c += w + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nSIDES = [2, 3, 4]\nALL_COLORS = list(range(10))\n\n# Canvas and object bounds.\nGRID_SIZE_RANGE = (25, 28)\nCOUNT_RANGE = (2, 6)\nSQUARE_GAP = 1\n\n# Noise and distractor controls.\nDISTRACTOR_PROB = 0.5\nNOISE_COUNT_RANGE = (40, 70)\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
