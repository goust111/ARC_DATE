{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '274,548p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\ndef _get_enclosed_holes(sprite):\n    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n    h, w = sprite.shape\n    return [pts for pts in components_mask(~sprite, connectivity=4)\n            if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n\n\ndef _make_diamond():\n    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n    s = np.zeros((3, 3), dtype=bool)\n    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n    return s\n\n\ndef _make_hollow_sprite(h, w, rng):\n    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n    sprite = np.ones((h, w), dtype=bool)\n    if h >= 3 and w >= 3:\n        sprite[1:-1, 1:-1] = False\n    # Optionally add internal horizontal wall\n    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n        br = rng.randint(2, h - 2)\n        n = rng.randint(1, w - 2)\n        s = rng.randint(1, w - 1 - n + 1)\n        sprite[br, s:s + n] = True\n    # Optionally add internal vertical wall\n    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n        bc = rng.randint(2, w - 2)\n        n = rng.randint(1, h - 2)\n        s = rng.randint(1, h - 1 - n + 1)\n        sprite[s:s + n, bc] = True\n    # Optionally remove border cells for irregularity\n    if rng.random() < _P_BORDER_REMOVAL:\n        bcells = [(r, c) for r in range(h) for c in range(w)\n                  if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n        rng.shuffle(bcells)\n        for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n            test = sprite.copy()\n            test[cr, cc] = False\n            if _get_enclosed_holes(test):\n                sprite = test\n    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n        return None\n    return sprite\n\n\ndef _choose_colors(rng, N, num_filled):\n    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n    all_c = list(range(1, 10))\n    rng.shuffle(all_c)\n    border_keys = all_c[:N]\n    rng.shuffle(all_c)\n    fill_values = all_c[:N]\n    dist_cands = [c for c in range(1, 10) if c not in border_keys]\n    distractor_color = rng.choice(dist_cands)\n    mapping = dict(zip(border_keys, fill_values))\n    filled_keys = rng.sample(border_keys, num_filled)\n    return border_keys, fill_values, distractor_color, mapping, filled_keys\n\n\ndef _build_palette(side, border_keys, fill_values):\n    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n    N = len(border_keys)\n    if side in ('top', 'bottom'):\n        pal = np.zeros((2, N), dtype=int)\n        outer, inner = (0, 1) if side == 'top' else (1, 0)\n        pal[outer] = border_keys\n        pal[inner] = fill_values\n    else:\n        pal = np.zeros((N, 2), dtype=int)\n        outer, inner = (0, 1) if side == 'left' else (1, 0)\n        pal[:, outer] = border_keys\n        pal[:, inner] = fill_values\n    return pal\n\n\ndef _place_palette(grid, occ, pal, side, rng):\n    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n    H, W = grid.shape\n    pal_h, pal_w = pal.shape\n    if side == 'top':\n        pr0, pc0 = 0, rng.randint(0, W - pal_w)\n    elif side == 'bottom':\n        pr0, pc0 = H - pal_h, rng.randint(0, W - pal_w)\n    elif side == 'left':\n        pr0, pc0 = rng.randint(0, H - pal_h), 0\n    else:\n        pr0, pc0 = rng.randint(0, H - pal_h), W - pal_w\n    grid[pr0:pr0 + pal_h, pc0:pc0 + pal_w] = pal\n    occ[max(0, pr0 - 1):min(H, pr0 + pal_h + 1),\n        max(0, pc0 - 1):min(W, pc0 + pal_w + 1)] = True\n\n\ndef _find_valid_positions(H, W, occ, mask, holes):\n    \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n    sh, sw = mask.shape\n    positions = []\n    for r0 in range(H - sh + 1):\n        for c0 in range(W - sw + 1):\n            if occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n                   max(0, c0 - 1):min(W, c0 + sw + 1)].any():\n                continue\n            if any(r0 + hr == 0 or c0 + hc == 0 or r0 + hr == H - 1 or c0 + hc == W - 1\n                   for hpts in holes for hr, hc in hpts):\n                continue\n            positions.append((r0, c0))\n    return positions\n\n\ndef _paint_sprite(grid, r0, c0, mask, color, fill, holes):\n    \"\"\"Render a sprite onto the grid: border cells in color, hole cells in fill (if given).\"\"\"\n    grid[r0:r0 + mask.shape[0], c0:c0 + mask.shape[1]][mask] = color\n    if fill is not None:\n        for hpts in holes:\n            for hr, hc in hpts:\n                grid[r0 + hr, c0 + hc] = fill\n\n\ndef _gen_attempt():\n    rng = random.Random()\n    bg = 0\n\n    # Grid size and palette side\n    H = rng.randint(_GRID_H_MIN, _GRID_H_MAX)\n    W = rng.randint(_GRID_W_MIN, _GRID_W_MAX)\n    side = rng.choice(['top', 'bottom', 'left', 'right'])\n    if H <= _SMALL_H_THRESHOLD and side in ('top', 'bottom') and rng.random() < _SMALL_H_PALETTE_FLIP:\n        side = rng.choice(['left', 'right'])\n\n    max_N = H if side in ('left', 'right') else W\n    N = rng.randint(_PALETTE_N_MIN, min(_PALETTE_N_MAX, max_N))\n\n    # Sprite dimension bounds\n    max_sh = min(_SPRITE_H_MAX, H)\n    max_sw = min(_SPRITE_W_MAX, W)\n    if H <= _TINY_H_THRESHOLD:\n        max_sh = 3\n\n    # Sprite counts\n    num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, N))\n    total_sprites = num_filled + 1\n\n    # Generate sprite shapes\n    shapes = []\n    for _ in range(total_sprites):\n        sh = rng.randint(3, max_sh)\n        sw = rng.randint(3, max_sw)\n        if sh + sw > _SPRITE_DIM_SUM_CAP:\n            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)\n        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:\n            mask = _make_diamond()\n        else:\n            mask = _make_hollow_sprite(sh, sw, rng)\n        if mask is None:\n            return None\n        shapes.append(mask)\n\n    # Colors and palette\n    border_keys, fill_values, distractor_color, mapping, filled_keys = \\\n        _choose_colors(rng, N, num_filled)\n    pal = _build_palette(side, border_keys, fill_values)\n\n    grid = np.full((H, W), bg, dtype=int)\n    occ = np.zeros((H, W), dtype=bool)\n    _place_palette(grid, occ, pal, side, rng)\n\n    # Assign colors to sprites: filled sprites use palette keys, last one is distractor\n    infos = []\n    for i, mask in enumerate(shapes):\n        if i < num_filled:\n            c, f = filled_keys[i], mapping[filled_keys[i]]\n        else:\n            c, f = distractor_color, None\n        infos.append((mask, c, f))\n\n    # Place sprites\n    placed = []\n    for mask, color, fill in infos:\n        holes = _get_enclosed_holes(mask)\n        positions = _find_valid_positions(H, W, occ, mask, holes)\n        if not positions:\n            return None\n        r0, c0 = rng.choice(positions)\n        _paint_sprite(grid, r0, c0, mask, color, fill, holes)\n        placed.append((r0, c0, mask, fill))\n        sh, sw = mask.shape\n        occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n            max(0, c0 - 1):min(W, c0 + sw + 1)] = True\n\n    # Derive input from output by clearing filled holes\n    output = grid.copy()\n    inp = grid.copy()\n    for r0, c0, mask, fill in placed:\n        if fill is not None:\n            for hpts in _get_enclosed_holes(mask):\n                for hr, hc in hpts:\n                    inp[r0 + hr, c0 + hc] = bg\n\n    # Validate bg is dominant on border\n    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    if int(vals[cnts.argmax()]) != bg:\n        return None\n\n    # Oracle check\n    try:\n        if np.array_equal(main(inp), output):\n            return inp\n    except Exception:\n        pass\n    return None\n\n\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '35,277p' /home/lixinyu/snap/new/ARC_code/train/84ba50d3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '35,277p' /home/lixinyu/snap/new/ARC_code/train/84ba50d3.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the blue sprites downward relative to the red divider, with vertical sprites passing through to the bottom.\n\n    Input structure:\n    - The background is the dominant color.\n    - One non-background color forms a single full-width horizontal divider row.\n    - The other non-background color forms 4-connected sprites above the divider.\n\n    Rule:\n    - Clear the original sprite pixels.\n    - A one-column sprite falls to the bottom of its column and deletes the divider\n      pixel it crossed.\n    - Any wider sprite falls until its unique widest horizontal row is immediately\n      above the divider row; if the moved sprite overlaps the divider, it covers it.\n\n    Key insight:\n    The red row is not a generic floor: only one-column sprites pass through to the\n    bottom, while wider sprites are registered by their widest horizontal segment.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n    line_r, line_color = _divider_row(g, bg)\n\n    non_bg_colors = set(map(int, g.ravel())) - {bg}\n    sprite_colors = non_bg_colors - {line_color}\n    assert len(sprite_colors) == 1, \"expected exactly one sprite color\"\n    sprite_color = next(iter(sprite_colors))\n\n    sprites = find_components(\n        g,\n        bg=bg,\n        colors=[sprite_color],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert sprites, \"expected at least one sprite\"\n\n    out = g.copy()\n    out[g == sprite_color] = bg\n    occupied = np.zeros((H, W), dtype=bool)\n\n    for sprite in sprites:\n        coords = sprite[\"coords\"]\n        _r0, c0, r1, c1 = map(int, sprite[\"bbox\"])\n        assert r1 < line_r, \"all sprites must begin above the divider\"\n\n        if c0 == c1:\n            shift = H - 1 - r1\n            assert shift >= 0\n            assert int(out[line_r, c0]) == line_color\n            out[line_r, c0] = bg\n        else:\n            widest_r = _unique_widest_row(coords)\n            shift = line_r - 1 - widest_r\n            assert shift >= 0\n\n        moved = coords.copy()\n        moved[:, 0] += shift\n        assert np.all((0 <= moved[:, 0]) & (moved[:, 0] < H))\n        assert np.all((0 <= moved[:, 1]) & (moved[:, 1] < W))\n\n        for rr, cc in moved:\n            r = int(rr)\n            c = int(cc)\n            assert not occupied[r, c], \"moved sprites must not overlap\"\n            occupied[r, c] = True\n            out[r, c] = sprite_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, palette, and divider bounds.\nMIN_GRID_SIZE, LARGE_GRID_MIN, MAX_GRID_SIZE = 7, 14, 18\nLARGE_GRID_PROB, PALETTE_SIZE, DIVIDER_MARGIN = 0.35, 10, 3\nADJACENT_ROW_OFFSET = 1\n\n# Sprite counts, spacing, and retry limits.\nMIN_SPRITE_COUNT, MAX_SPRITE_COUNT = 1, 5\nMAX_SINGLE_SPRITES, MAX_MULTI_SPRITES = 2, 3\nGAP_COLUMNS, INPUT_GAP_TO_DIVIDER = 1, 1\nGENERATION_RETRIES = 300\n\n# Sprite geometry.\nMIN_SPRITE_HEIGHT, MAX_SINGLE_HEIGHT, MAX_MULTI_HEIGHT = 1, 7, 5\nSINGLE_WIDTH, MIN_MULTI_WIDTH, MAX_MULTI_WIDTH = 1, 2, 3\nWIDE_MULTI_PROB = 0.5\n\n\ndef _composition(total: int, parts: int) -> list[int]:\n    shares = [0] * parts\n    for _ in range(total):\n        shares[random.randrange(parts)] += 1\n    return shares\n\n\ndef _min_layout_width(n_single: int, n_multi: int) -> int:\n    n = n_single + n_multi\n    return n_single * SINGLE_WIDTH + MIN_MULTI_WIDTH * n_multi + GAP_COLUMNS * max(0, n - 1)\n\n\ndef _count_pairs(width: int) -> list[tuple[int, int]]:\n    pairs: list[tuple[int, int]] = []\n    for n_single in range(MAX_SINGLE_SPRITES + 1):\n        for n_multi in range(MAX_MULTI_SPRITES + 1):\n            n = n_single + n_multi\n            if MIN_SPRITE_COUNT <= n <= MAX_SPRITE_COUNT and _min_layout_width(n_single, n_multi) <= width:\n                pairs.append((n_single, n_multi))\n    return pairs\n\n\ndef _place_intervals(widths: list[int], grid_width: int) -> list[int]:\n    n = len(widths)\n    base = sum(widths) + GAP_COLUMNS * max(0, n - 1)\n    extra = grid_width - base\n    assert extra >= 0\n    gaps = _composition(extra, n + 1)\n\n    starts: list[int] = []\n    c = gaps[0]\n    for i, width in enumerate(widths):\n        starts.append(c)\n        c += width\n        if i < n - 1:\n            c += GAP_COLUMNS + gaps[i + 1]\n    return starts\n\n\ndef _multi_coords(top: int, left: int, height: int, width: int, bar_row: int, spine_col: int) -> np.ndarray:\n    coords = {(top + r, left + spine_col) for r in range(height)}\n    coords.update((top + bar_row, left + c) for c in range(width))\n    return np.array(sorted(coords), dtype=int)\n\n\ndef _build_descriptors(n_single: int, n_multi: int, max_single_h: int, max_multi_h: int, grid_width: int) -> list[dict[str, int | str]]:\n    descriptors: list[dict[str, int | str]] = []\n    for _ in range(n_single):\n        descriptors.append(\n            {\"kind\": \"single\", \"width\": SINGLE_WIDTH, \"height\": random.randint(MIN_SPRITE_HEIGHT, max_single_h)}\n        )\n\n    extra_width = grid_width - _min_layout_width(n_single, n_multi)\n    for _ in range(n_multi):\n        width = MIN_MULTI_WIDTH\n        if extra_width > 0 and random.random() < WIDE_MULTI_PROB:\n            width = MAX_MULTI_WIDTH\n            extra_width -= MAX_MULTI_WIDTH - MIN_MULTI_WIDTH\n        height = random.randint(MIN_SPRITE_HEIGHT, max_multi_h)\n        descriptors.append(\n            {\n                \"kind\": \"multi\",\n                \"width\": width,\n                \"height\": height,\n                \"bar_row\": random.randint(0, height - ADJACENT_ROW_OFFSET),\n                \"spine_col\": random.randrange(width),\n            }\n        )\n\n    random.shuffle(descriptors)\n    return descriptors\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(LARGE_GRID_MIN, MAX_GRID_SIZE) if random.random() < LARGE_GRID_PROB else random.randint(MIN_GRID_SIZE, MAX_GRID_SIZE)\n    W = H\n    bg, divider_color, sprite_color = random.sample(range(PALETTE_SIZE), 3)\n    divider_choices = list(range(DIVIDER_MARGIN, H - DIVIDER_MARGIN))\n    divider_weights = [min(r - ADJACENT_ROW_OFFSET, H - r - ADJACENT_ROW_OFFSET) for r in divider_choices]\n    divider_r = random.choices(divider_choices, weights=divider_weights, k=1)[0]\n\n    pairs = _count_pairs(W)\n    if not pairs:\n        return None\n    n_single, n_multi = random.choice(pairs)\n\n    max_single_h = min(MAX_SINGLE_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER, H - divider_r - ADJACENT_ROW_OFFSET)\n    max_multi_h = min(MAX_MULTI_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER)\n    if (n_single and max_single_h < MIN_SPRITE_HEIGHT) or (n_multi and max_multi_h < MIN_SPRITE_HEIGHT):\n        return None\n\n    descriptors = _build_descriptors(n_single, n_multi, max_single_h, max_multi_h, W)\n    starts = _place_intervals([int(d[\"width\"]) for d in descriptors], W)\n\n    inp = np.full((H, W), bg, dtype=int)\n    out = np.full((H, W), bg, dtype=int)\n    inp[divider_r, :] = divider_color\n    out[divider_r, :] = divider_color\n\n    input_max_bottom = divider_r - INPUT_GAP_TO_DIVIDER - ADJACENT_ROW_OFFSET\n    for desc, left in zip(descriptors, starts):\n        height = int(desc[\"height\"])\n        width = int(desc[\"width\"])\n        if desc[\"kind\"] == \"single\":\n            col = left\n            out[divider_r, col] = bg\n            out[H - height : H, col] = sprite_color\n\n            input_bottom = random.randint(height - ADJACENT_ROW_OFFSET, input_max_bottom)\n            inp[input_bottom - height + ADJACENT_ROW_OFFSET : input_bottom + ADJACENT_ROW_OFFSET, col] = sprite_color\n            continue\n\n        bar_row = int(desc[\"bar_row\"])\n        spine_col = int(desc[\"spine_col\"])\n        landed_top = divider_r - ADJACENT_ROW_OFFSET - bar_row\n        landed = _multi_coords(landed_top, left, height, width, bar_row, spine_col)\n        if np.any((landed[:, 0] < 0) | (landed[:, 0] >= H)):\n            return None\n        out[landed[:, 0], landed[:, 1]] = sprite_color\n\n        landed_bottom = int(landed[:, 0].max())\n        min_shift = landed_bottom - input_max_bottom\n        max_shift = landed_top\n        if min_shift > max_shift:\n            return None\n        shift = random.randint(min_shift, max_shift)\n        original = landed.copy()\n        original[:, 0] -= shift\n        if np.any((original[:, 0] < 0) | (original[:, 0] > input_max_bottom)):\n            return None\n        inp[original[:, 0], original[:, 1]] = sprite_color\n\n    bg_count = int(np.count_nonzero(inp == bg))\n    if bg_count <= int(np.count_nonzero(inp == divider_color)):\n        return None\n    if bg_count <= int(np.count_nonzero(inp == sprite_color)):\n        return None\n\n    try:\n        actual = main(inp)\n    except AssertionError:\n        return None\n    if not np.array_equal(actual, out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n","exit_code":0,"status":"completed"}}
