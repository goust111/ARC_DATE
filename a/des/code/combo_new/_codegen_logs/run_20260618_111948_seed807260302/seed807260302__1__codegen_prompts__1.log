{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '209,545p' /home/lixinyu/snap/new/ARC_code/eval/2c181942.py\"","aggregated_output":"    \"\"\"\n    Constructively build a sprite mask in the attached orientation for `side`.\n    The mask is bool, 8-connected, has the correct symmetry and contact-edge length,\n    and exactly 1 rotation (out of 4) is a valid attachment for any hub side.\n\n    Strategy: build in canonical \"left-attach\" frame (flipud symmetric, contact on right col),\n    then rotate to the target side.\n    \"\"\"\n    # Build in \"left-attach\" frame: h rows, w cols.\n    # Right column = contact edge with exactly `edge_len` contiguous filled cells.\n    # flipud symmetric (rows mirror top-to-bottom).\n    # h > w ensures not square, breaking 90-degree rotation ambiguity.\n    # Also ensure NOT fliplr symmetric to prevent the complementary side matching.\n    e = edge_len  # = 2 for N=4\n    h = rng.choice([3, 4])  # height: 3 or 4 (must be > e to break symmetry)\n    w = rng.randint(2, 4)   # width: 2-4 (cols including the contact column)\n\n    half_h = (h + 1) // 2  # rows to decide (rest mirrored vertically)\n\n    for _attempt in range(100):\n        grid = np.zeros((h, w), dtype=bool)\n\n        # Contact edge: rightmost column, middle `e` rows filled, rest empty.\n        # For flipud symmetry with h=3 or h=4 and e=2:\n        #   h=3: rows 0,2 empty; row 1 filled -> only 1 contiguous. No good.\n        #   Actually for h=4, e=2: rows 1,2 filled (symmetric pair). Contact = [F,T,T,F]\n        #   For h=3, e=2: rows 0,2 mirrored. If row 0=T, row 2=T, row 1=T -> 3 contig.\n        #                  If row 0=F, row 2=F, row 1=T -> 1 contig. Not enough.\n        #                  Need to allow row0=T,row1=T,row2=T -> 3 != e.\n        # So for h=3, e=2 the rightmost col can't have exactly 2 contiguous cells\n        # with flipud symmetry. Let me think differently.\n\n        # The contact edge doesn't have to span the full height. It's the N-2 contiguous\n        # cells on the attachment side. For \"left-attach\", the solver checks the RIGHT edge\n        # of the cropped sprite: exactly e contiguous filled cells.\n\n        # Build each row from right to left. Rightmost col is the contact column.\n        # For flipud symmetry, row[i] mirrors row[h-1-i].\n        # Decide top half, mirror to bottom.\n\n        for ri in range(half_h):\n            mirror_ri = h - 1 - ri\n            for ci in range(w):\n                if ci == w - 1:\n                    # Contact column: fill rows that form the contiguous e-block\n                    # Place the e-block centered. For h=4,e=2: rows 1,2. For h=3,e=2: impossible with strict flipud.\n                    # Instead: just decide freely and check later\n                    val = rng.random() < 0.5\n                else:\n                    val = rng.random() < 0.5\n                grid[ri, ci] = val\n                grid[mirror_ri, ci] = val\n\n        # Check: rightmost column has exactly e contiguous filled cells\n        right_col = grid[:, -1]\n        # Find contiguous runs\n        runs = []\n        count = 0\n        for v in right_col:\n            if v:\n                count += 1\n            else:\n                if count > 0:\n                    runs.append(count)\n                count = 0\n        if count > 0:\n            runs.append(count)\n        if len(runs) != 1 or runs[0] != e:\n            continue\n\n        # Trim empty rows/cols\n        rows_any = grid.any(axis=1)\n        cols_any = grid.any(axis=0)\n        if not rows_any.any():\n            continue\n        r0, r1 = np.where(rows_any)[0][[0, -1]]\n        c0, c1 = np.where(cols_any)[0][[0, -1]]\n        grid = grid[r0:r1+1, c0:c1+1]\n\n        if grid.shape[0] < 2 or grid.shape[1] < 2:\n            continue\n\n        # Check flipud symmetry\n        if not np.array_equal(grid, np.flipud(grid)):\n            continue\n\n        # Check 8-connectivity\n        labeled, num = _label(grid, structure=np.ones((3, 3), dtype=int))\n        if num != 1:\n            continue\n\n        # Must NOT be fliplr symmetric (to avoid the other side matching)\n        if np.array_equal(grid, np.fliplr(grid)):\n            continue\n\n        # Pixel count 4-12\n        px = int(grid.sum())\n        if px < 4 or px > 12:\n            continue\n\n        # Now verify exactly 1 valid attachment across all 4 rotations x 4 sides.\n        # The solver, for each side, tries rot90 x 0-3 and checks:\n        #   - correct symmetry (fliplr for top/bot, flipud for left/right)\n        #   - contact edge = e contiguous cells on the correct side\n        # We need exactly 1 such (rotation, side) pair across all possibilities.\n        # Actually, the solver matches by color, so each sprite is only tested against\n        # one side. But we need: for ANY side the solver might try, only 1 rotation works.\n        # Since the solver already picks the first valid rotation, we just need that\n        # for the intended side, exactly 1 rotation of the sprite is valid.\n\n        # Check: for the canonical \"left\" side, how many rotations are valid?\n        valid_for_left = 0\n        for k in range(4):\n            rot = np.rot90(grid, k)\n            # Trim\n            ra = rot.any(axis=1)\n            ca = rot.any(axis=0)\n            rr0, rr1 = np.where(ra)[0][[0, -1]]\n            cc0, cc1 = np.where(ca)[0][[0, -1]]\n            cr = rot[rr0:rr1+1, cc0:cc1+1]\n            # Left side needs flipud + right-edge = e contiguous\n            if not np.array_equal(cr, np.flipud(cr)):\n                continue\n            rc = cr[:, -1]\n            runs2 = []\n            cnt2 = 0\n            for v in rc:\n                if v: cnt2 += 1\n                else:\n                    if cnt2 > 0: runs2.append(cnt2)\n                    cnt2 = 0\n            if cnt2 > 0: runs2.append(cnt2)\n            if len(runs2) == 1 and runs2[0] == e:\n                valid_for_left += 1\n\n        if valid_for_left != 1:\n            continue\n\n        # Success! Now rotate to target side.\n        # grid is in \"left-attach\" frame (contact on right, flipud symmetric).\n        # left -> as-is\n        # right -> fliplr (contact moves to left side)\n        # top -> rot90 CW (contact moves to bottom)\n        # bot -> rot90 CCW (contact moves to top)\n        if side == \"left\":\n            mask = grid.copy()\n        elif side == \"right\":\n            mask = np.fliplr(grid)\n        elif side == \"top\":\n            mask = np.rot90(grid, -1)  # CW: right->bottom\n        else:  # bot\n            mask = np.rot90(grid, 1)   # CCW: right->top\n        return mask\n\n    return None\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = random.Random()\n    bg = 8\n    N = 4\n    edge_len = N - 2  # = 2\n\n    H = rng.randint(18, 26)\n    W = rng.randint(20, 26)\n\n    # Choose 4 distinct non-bg colors for hub edges\n    all_colors = [c for c in range(10) if c != bg]\n    rng.shuffle(all_colors)\n    top_col, bot_col, left_col, right_col = all_colors[:4]\n\n    sides = [\"top\", \"bot\", \"left\", \"right\"]\n    side_colors = {\"top\": top_col, \"bot\": bot_col, \"left\": left_col, \"right\": right_col}\n\n    # Choose K sides (2-4) to get sprites\n    K = rng.randint(2, 4)\n    sprite_sides = rng.sample(sides, K)\n\n    # Generate sprite masks for each chosen side\n    sprite_masks = {}\n    for side in sprite_sides:\n        mask = _make_sprite_mask(edge_len, side, rng)\n        if mask is None:\n            return None\n        sprite_masks[side] = mask\n\n    # Compute max sprite extent to ensure enough margin for hub placement\n    max_sprite_h = max(m.shape[0] for m in sprite_masks.values())\n    max_sprite_w = max(m.shape[1] for m in sprite_masks.values())\n    max_extent = max(max_sprite_h, max_sprite_w)\n    margin = max_extent + 2\n\n    # Place hub near center with margin\n    hub_r_min = margin\n    hub_r_max = H - N - margin\n    hub_c_min = margin\n    hub_c_max = W - N - margin\n    if hub_r_min > hub_r_max or hub_c_min > hub_c_max:\n        return None\n\n    hub_r = rng.randint(hub_r_min, hub_r_max)\n    hub_c = rng.randint(hub_c_min, hub_c_max)\n\n    # Build output grid\n    out = np.full((H, W), bg, dtype=int)\n\n    # Place hub\n    # Top edge\n    for ci in range(1, N - 1):\n        out[hub_r, hub_c + ci] = top_col\n    # Bottom edge\n    for ci in range(1, N - 1):\n        out[hub_r + N - 1, hub_c + ci] = bot_col\n    # Left edge\n    for ri in range(1, N - 1):\n        out[hub_r + ri, hub_c] = left_col\n    # Right edge\n    for ri in range(1, N - 1):\n        out[hub_r + ri, hub_c + N - 1] = right_col\n\n    # Attach sprites to hub in output\n    attached_sprites = {}  # side -> (arr, mask, sr, sc) in output coords\n    for side in sprite_sides:\n        mask = sprite_masks[side]\n        sh, sw = mask.shape\n        color = side_colors[side]\n        arr = np.where(mask, color, bg).astype(int)\n\n        # Compute placement so sprite's contact edge is flush with hub side.\n        # The solver's segs dict defines: for each side, the contact position and span.\n        #   top -> sprite's bot row at hub_r-1, cols hub_c+1..hub_c+N-2\n        #   bot -> sprite's top row at hub_r+N, cols hub_c+1..hub_c+N-2\n        #   left -> sprite's right col at hub_c-1, rows hub_r+1..hub_r+N-2\n        #   right -> sprite's left col at hub_c+N, rows hub_r+1..hub_r+N-2\n        if side == \"top\":\n            # Find first filled col on bottom row of sprite\n            filled = np.where(mask[-1])[0]\n            sc = hub_c + 1 - int(filled[0])\n            sr = hub_r - sh  # bottom row of sprite at row hub_r-1\n        elif side == \"bot\":\n            filled = np.where(mask[0])[0]\n            sc = hub_c + 1 - int(filled[0])\n            sr = hub_r + N  # top row of sprite at row hub_r+N\n        elif side == \"left\":\n            filled = np.where(mask[:, -1])[0]\n            sr = hub_r + 1 - int(filled[0])\n            sc = hub_c - sw  # right col of sprite at col hub_c-1\n        else:  # right\n            filled = np.where(mask[:, 0])[0]\n            sr = hub_r + 1 - int(filled[0])\n            sc = hub_c + N  # left col of sprite at col hub_c+N\n\n        # Check bounds\n        if sr < 0 or sc < 0 or sr + sh > H or sc + sw > W:\n            return None\n\n        # Check no overlap with existing content\n        for r in range(sh):\n            for c in range(sw):\n                if mask[r, c] and out[sr + r, sc + c] != bg:\n                    return None\n\n        paste(out, arr, sr, sc, transparent=bg)\n        attached_sprites[side] = (arr, mask, sr, sc)\n\n    # Verify output is correct by running solver later (via oracle check)\n\n    # Build input: hub + scattered sprites in random rotations + optional distractor\n    inp = np.full((H, W), bg, dtype=int)\n    # Place hub on input\n    inp[hub_r:hub_r+N, hub_c:hub_c+N] = out[hub_r:hub_r+N, hub_c:hub_c+N]\n\n    # Canvas for placement tracking\n    canvas = inp.copy()\n\n    for side in sprite_sides:\n        arr, mask, sr, sc = attached_sprites[side]\n        # Apply a random non-identity rotation\n        # But we need to ensure the solver will find the right rotation\n        # The solver uses 8-connectivity labeling and picks the largest component of matching color\n        # Apply a random rotation (1-3 quarter turns, avoiding identity)\n        k = rng.choice([1, 2, 3])\n        rotated_arr = np.rot90(arr, k)\n        rotated_mask = np.rot90(mask, k)\n\n        # Crop to bounding box of the mask\n        rows_any = rotated_mask.any(axis=1)\n        cols_any = rotated_mask.any(axis=0)\n        r0_idx, r1_idx = np.where(rows_any)[0][[0, -1]]\n        c0_idx, c1_idx = np.where(cols_any)[0][[0, -1]]\n        cropped_arr = rotated_arr[r0_idx:r1_idx+1, c0_idx:c1_idx+1]\n        cropped_mask = rotated_mask[r0_idx:r1_idx+1, c0_idx:c1_idx+1]\n        patch = np.where(cropped_mask, cropped_arr, bg).astype(int)\n\n        try:\n            pr, pc = random_free_location(canvas, patch, transparent=bg, padding=2, padding_connectivity=8)\n        except ValueError:\n            return None\n        paste(canvas, patch, pr, pc, transparent=bg)\n        paste(inp, patch, pr, pc, transparent=bg)\n\n    # Optionally add a distractor (0 or 1)\n    if rng.random() < 0.3:\n        used_colors = set(side_colors.values())\n        distractor_colors = [c for c in range(10) if c != bg and c not in used_colors]\n        if distractor_colors:\n            dcol = rng.choice(distractor_colors)\n            # Make a small distractor sprite\n            dist_mask = _make_sprite_mask(edge_len, rng.choice(sides), rng)\n            if dist_mask is not None:\n                dist_arr = np.where(dist_mask, dcol, bg).astype(int)\n                try:\n                    pr, pc = random_free_location(canvas, dist_arr, transparent=bg, padding=2, padding_connectivity=8)\n                    paste(canvas, dist_arr, pr, pc, transparent=bg)\n                    paste(inp, dist_arr, pr, pc, transparent=bg)\n                except ValueError:\n                    pass  # skip distractor if no room\n\n    # Oracle check\n    result = main(inp)\n    if not np.array_equal(result, out):\n        return None\n\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '150,535p' /home/lixinyu/snap/new/ARC_code/train/ad173014.py\"","aggregated_output":"MIN_RADIUS_PAD = 1\nMAX_RADIUS_PAD = 1\nANGLE_EPS = 1e-6\n\n# Connector constraints and retry budgets.\nMAX_TWO_TURN_TRIES = 20\nCONNECTOR_LENGTH_RANGE = (2, 24)\nGENERATION_ATTEMPTS = 300\n\nNEIGHBORS_8 = [\n    (dr, dc)\n    for dr in range(-1, 2)\n    for dc in range(-1, 2)\n    if not (dr == 0 and dc == 0)\n]\n\n\ndef _gen_mask(interior_size, color):\n    \"\"\"Generate an 8-connected mask for frame interior with fill 30-56%.\"\"\"\n    n = interior_size\n    total = n * n\n    min_fill = max(MIN_INTERIOR_CELLS, int(math.ceil(MIN_INTERIOR_FILL * total)))\n    max_fill = int(math.floor(MAX_INTERIOR_FILL * total))\n    target = random.randint(min_fill, max_fill)\n\n    mask = np.zeros((n, n), dtype=int)\n    start = (n // 2, n // 2)\n    mask[start] = color\n    filled = [start]\n    frontier = set()\n    _add_mask_frontier(frontier, mask, start)\n\n    while len(filled) < target and frontier:\n        cell = random.choice(list(frontier))\n        frontier.discard(cell)\n        mask[cell] = color\n        filled.append(cell)\n        _add_mask_frontier(frontier, mask, cell)\n\n    if len(filled) < min_fill:\n        return None\n    return mask\n\n\ndef _add_mask_frontier(frontier, mask, cell):\n    n = mask.shape[0]\n    for dr, dc in NEIGHBORS_8:\n        nr, nc = cell[0] + dr, cell[1] + dc\n        if 0 <= nr < n and 0 <= nc < n and mask[nr, nc] == 0:\n            frontier.add((nr, nc))\n\n\ndef _axis_path(start, end):\n    \"\"\"Return an inclusive straight segment between row- or column-aligned cells.\"\"\"\n    sr, sc = start\n    er, ec = end\n    if sr == er:\n        step = 1 if ec > sc else -1\n        return [(sr, c) for c in range(sc, ec + step, step)]\n    step = 1 if er > sr else -1\n    return [(r, sc) for r in range(sr, er + step, step)]\n\n\ndef _one_turn_path(start, corner, end):\n    return _axis_path(start, corner) + _axis_path(corner, end)[1:]\n\n\ndef _two_turn_vhv_path(start, mid_r, end):\n    _, sc = start\n    _, ec = end\n    corner1 = (mid_r, sc)\n    corner2 = (mid_r, ec)\n    return (\n        _axis_path(start, corner1)\n        + _axis_path(corner1, corner2)[1:]\n        + _axis_path(corner2, end)[1:]\n    )\n\n\ndef _two_turn_hvh_path(start, mid_c, end):\n    sr, _ = start\n    er, _ = end\n    corner1 = (sr, mid_c)\n    corner2 = (er, mid_c)\n    return (\n        _axis_path(start, corner1)\n        + _axis_path(corner1, corner2)[1:]\n        + _axis_path(corner2, end)[1:]\n    )\n\n\ndef _path_is_free(path, occupied):\n    return all(p not in occupied for p in path)\n\n\ndef _find_path(start, end, occupied):\n    \"\"\"Find an L-shaped path (0-2 turns) from start to end avoiding occupied cells.\"\"\"\n    sr, sc = start\n    er, ec = end\n\n    if sr == er or sc == ec:\n        path = _axis_path(start, end)\n        if _path_is_free(path, occupied):\n            return path\n\n    corners = [(sr, ec), (er, sc)]\n    random.shuffle(corners)\n    for corner in corners:\n        path = _one_turn_path(start, corner, end)\n        if _path_is_free(path, occupied):\n            return path\n\n    for _ in range(MAX_TWO_TURN_TRIES):\n        if sr != er and sc != ec:\n            mid_r = random.randint(min(sr, er), max(sr, er))\n            path = _two_turn_vhv_path(start, mid_r, end)\n            if _path_is_free(path, occupied):\n                return path\n\n            mid_c = random.randint(min(sc, ec), max(sc, ec))\n            path = _two_turn_hvh_path(start, mid_c, end)\n            if _path_is_free(path, occupied):\n                return path\n\n    return None\n\n\ndef _pick_attachment(frame_bbox, side, occupied):\n    \"\"\"Pick an attachment point on the given side of a frame border.\n    Returns (border_cell, connector_start) where connector_start is one step outside.\"\"\"\n    r0, c0, r1, c1 = frame_bbox\n    if side == 'top':\n        cols = list(range(c0 + 1, c1))\n        random.shuffle(cols)\n        for c in cols:\n            border = (r0, c)\n            outside = (r0 - 1, c)\n            if outside not in occupied and 0 <= outside[0]:\n                return border, outside\n    elif side == 'bottom':\n        cols = list(range(c0 + 1, c1))\n        random.shuffle(cols)\n        for c in cols:\n            border = (r1, c)\n            outside = (r1 + 1, c)\n            if outside not in occupied:\n                return border, outside\n    elif side == 'left':\n        rows = list(range(r0 + 1, r1))\n        random.shuffle(rows)\n        for r in rows:\n            border = (r, c0)\n            outside = (r, c0 - 1)\n            if outside not in occupied and 0 <= outside[1]:\n                return border, outside\n    elif side == 'right':\n        rows = list(range(r0 + 1, r1))\n        random.shuffle(rows)\n        for r in rows:\n            border = (r, c1)\n            outside = (r, c1 + 1)\n            if outside not in occupied:\n                return border, outside\n    return None, None\n\n\ndef _best_side(frame_bbox, target_r, target_c):\n    \"\"\"Determine which side of a frame is closest to a target point.\"\"\"\n    r0, c0, r1, c1 = frame_bbox\n    cr = (r0 + r1) / 2\n    cc = (c0 + c1) / 2\n    dr = target_r - cr\n    dc = target_c - cc\n\n    if abs(dr) > abs(dc):\n        return 'bottom' if dr > 0 else 'top'\n    else:\n        return 'right' if dc > 0 else 'left'\n\n\ndef _choose_colors(n_frames):\n    avail_colors = INTERIOR_COLORS[:]\n    random.shuffle(avail_colors)\n    return avail_colors[:n_frames]\n\n\ndef _choose_grid_size(frame_size):\n    if frame_size == 7:\n        h_range = LARGE_FRAME_GRID_H_RANGE\n        w_range = LARGE_FRAME_GRID_W_RANGE\n    else:\n        h_range = SMALL_FRAME_GRID_H_RANGE\n        w_range = SMALL_FRAME_GRID_W_RANGE\n    return random.randint(*h_range), random.randint(*w_range)\n\n\ndef _frame_bboxes_overlap(a, b):\n    r0a, c0a, r1a, c1a = a\n    r0b, c0b, r1b, c1b = b\n    return not (\n        r1a + FRAME_GAP < r0b\n        or r1b + FRAME_GAP < r0a\n        or c1a + FRAME_GAP < c0b\n        or c1b + FRAME_GAP < c0a\n    )\n\n\ndef _place_frame_bboxes(n_frames, frame_size, grid_h, grid_w):\n    \"\"\"Place non-overlapping frame boxes in clockwise angular order.\"\"\"\n    center_r = grid_h / 2\n    center_c = grid_w / 2\n\n    base_angles = [2 * math.pi * i / n_frames for i in range(n_frames)]\n    angle_perturb = [random.uniform(*ANGLE_PERTURB_RANGE) for _ in range(n_frames)]\n    angles = [base_angles[i] + angle_perturb[i] for i in range(n_frames)]\n    angles.sort()\n\n    min_radius = frame_size + MIN_RADIUS_PAD\n    max_radius = min(grid_h, grid_w) / 2 - frame_size / 2 - MAX_RADIUS_PAD\n    if max_radius < min_radius:\n        return None\n\n    frame_bboxes = []\n    for angle in angles:\n        radius = random.uniform(min_radius, max_radius)\n        fr = center_r + radius * math.sin(angle) - frame_size / 2\n        fc = center_c + radius * math.cos(angle) - frame_size / 2\n        fr = int(round(fr))\n        fc = int(round(fc))\n        fr = max(0, min(grid_h - frame_size, fr))\n        fc = max(0, min(grid_w - frame_size, fc))\n        frame_bboxes.append((fr, fc, fr + frame_size - 1, fc + frame_size - 1))\n\n    for i in range(n_frames):\n        for j in range(i + 1, n_frames):\n            if _frame_bboxes_overlap(frame_bboxes[i], frame_bboxes[j]):\n                return None\n\n    for r0, c0, r1, c1 in frame_bboxes:\n        if r0 < 0 or c0 < 0 or r1 >= grid_h or c1 >= grid_w:\n            return None\n    return frame_bboxes\n\n\ndef _gen_clockwise_order(frame_bboxes):\n    \"\"\"Return frame indexes sorted by angle around their shared centroid.\"\"\"\n    n_frames = len(frame_bboxes)\n    centers = [((r0 + r1) / 2, (c0 + c1) / 2) for r0, c0, r1, c1 in frame_bboxes]\n    mean_r = sum(c[0] for c in centers) / n_frames\n    mean_c = sum(c[1] for c in centers) / n_frames\n    cw_angles = [math.atan2(c[0] - mean_r, c[1] - mean_c) for c in centers]\n\n    sorted_angles = sorted(enumerate(cw_angles), key=lambda x: x[1])\n    angle_vals = [a for _, a in sorted_angles]\n    for i in range(len(angle_vals) - 1):\n        if abs(angle_vals[i + 1] - angle_vals[i]) < ANGLE_EPS:\n            return None, None\n    return [idx for idx, _ in sorted_angles], centers\n\n\ndef _draw_frame(grid, frame_bbox, occupied):\n    r0, c0, r1, c1 = frame_bbox\n    grid[r0, c0:c1 + 1] = FRAME_RED\n    grid[r1, c0:c1 + 1] = FRAME_RED\n    grid[r0:r1 + 1, c0] = FRAME_RED\n    grid[r0:r1 + 1, c1] = FRAME_RED\n    for c in range(c0, c1 + 1):\n        occupied.add((r0, c))\n        occupied.add((r1, c))\n    for r in range(r0, r1 + 1):\n        occupied.add((r, c0))\n        occupied.add((r, c1))\n\n\ndef _place_mask(grid, frame_bbox, mask, occupied):\n    r0, c0, _, _ = frame_bbox\n    rows, cols = np.nonzero(mask)\n    grid[r0 + 1 + rows, c0 + 1 + cols] = mask[rows, cols]\n    occupied.update((r0 + 1 + int(r), c0 + 1 + int(c)) for r, c in zip(rows, cols))\n\n\ndef _render_frames(grid, frame_bboxes, colors, interior_size):\n    \"\"\"Draw frame borders and colored interior masks; return the occupied cells.\"\"\"\n    masks = []\n    occupied = set()\n    for frame_bbox, color in zip(frame_bboxes, colors):\n        _draw_frame(grid, frame_bbox, occupied)\n        mask = _gen_mask(interior_size, color)\n        if mask is None:\n            return None\n        masks.append(mask)\n        _place_mask(grid, frame_bbox, mask, occupied)\n    return occupied\n\n\ndef _path_in_bounds(path, grid_h, grid_w):\n    return all(0 <= r < grid_h and 0 <= c < grid_w for r, c in path)\n\n\ndef _draw_path(grid, path, occupied):\n    for r, c in path:\n        grid[r, c] = CONNECTOR_BLUE\n        occupied.add((r, c))\n\n\ndef _connect_cycle(grid, frame_bboxes, centers, cw_order, occupied):\n    \"\"\"Connect adjacent clockwise frames with bounded blue paths.\"\"\"\n    grid_h, grid_w = grid.shape\n    n_frames = len(frame_bboxes)\n    for k in range(n_frames):\n        fi = cw_order[k]\n        fj = cw_order[(k + 1) % n_frames]\n\n        ci_r, ci_c = centers[fi]\n        cj_r, cj_c = centers[fj]\n\n        side_i = _best_side(frame_bboxes[fi], cj_r, cj_c)\n        side_j = _best_side(frame_bboxes[fj], ci_r, ci_c)\n\n        border_i, start_i = _pick_attachment(frame_bboxes[fi], side_i, occupied)\n        if border_i is None:\n            return False\n\n        border_j, start_j = _pick_attachment(frame_bboxes[fj], side_j, occupied)\n        if border_j is None:\n            return False\n\n        path = _find_path(start_i, start_j, occupied)\n        if path is None:\n            return False\n\n        min_len, max_len = CONNECTOR_LENGTH_RANGE\n        if len(path) < min_len or len(path) > max_len:\n            return False\n\n        if not _path_in_bounds(path, grid_h, grid_w):\n            return False\n        _draw_path(grid, path, occupied)\n    return True\n\n\ndef _gen_attempt():\n    n_frames = random.randint(*FRAME_COUNT_RANGE)\n    frame_size = random.choice(FRAME_SIZE_CHOICES)\n    interior_size = frame_size - 2\n    colors = _choose_colors(n_frames)\n    grid_h, grid_w = _choose_grid_size(frame_size)\n\n    frame_bboxes = _place_frame_bboxes(n_frames, frame_size, grid_h, grid_w)\n    if frame_bboxes is None:\n        return None\n\n    cw_order, centers = _gen_clockwise_order(frame_bboxes)\n    if cw_order is None:\n        return None\n\n    grid = np.zeros((grid_h, grid_w), dtype=int)\n    occupied = _render_frames(grid, frame_bboxes, colors, interior_size)\n    if occupied is None:\n        return None\n\n    if not _connect_cycle(grid, frame_bboxes, centers, cw_order, occupied):\n        return None\n\n    try:\n        main(grid)\n    except (AssertionError, Exception):\n        return None\n\n    return grid\n\n\ndef generate_input():\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
