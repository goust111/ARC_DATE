{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '6,90p' /home/lixinyu/snap/new/ARC_code/eval/291dc1e1.py && sed -n '225,292p' /home/lixinyu/snap/new/ARC_code/eval/291dc1e1.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reorder and stack rectangles by proximity to two colored edge lines.\n\n    Input structure:\n    - bg = most common color.\n    - Two edge lines (h + v) meet at a corner marked by a unique color.\n    - \"Blue\" line is color 1 if present, else the longer line; other is \"red.\"\n    - Solid rectangles in the interior.\n\n    Rule:\n    - Sort rectangles by (distance to blue edge, distance to red edge).\n    - If the blue edge is vertical, rotate each rectangle 90° CCW.\n    - Stack top-to-bottom, centered horizontally.\n\n    Key insight: Edge-line colors encode a coordinate system; proximity to each axis determines stacking order and rotation.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # --- locate the marked corner ---\n    corners = [(0, 0), (0, int(W - 1)), (int(H - 1), 0), (int(H - 1), int(W - 1))]\n    corner = None\n    for r, c in corners:\n        if int(g[r, c]) == int(bg):\n            continue\n        nbr = []\n        if r == 0:\n            nbr.append(int(g[r + 1, c]))\n        if r == H - 1:\n            nbr.append(int(g[r - 1, c]))\n        if c == 0:\n            nbr.append(int(g[r, c + 1]))\n        if c == W - 1:\n            nbr.append(int(g[r, c - 1]))\n        if nbr and all(int(n) != int(g[r, c]) for n in nbr):\n            corner = (int(r), int(c))\n            break\n    assert corner is not None\n\n    cr, cc = map(int, corner)\n    marker = int(g[cr, cc])\n\n    # --- line colors adjacent to the corner ---\n    hstep = 1 if cc == 0 else -1\n    vstep = 1 if cr == 0 else -1\n    hcol = int(g[cr, cc + hstep])\n    vcol = int(g[cr + vstep, cc])\n\n    # Choose \"blue\" line color.\n    if hcol == 1 or vcol == 1:\n        blue_col = 1\n        red_col = int(vcol if hcol == 1 else hcol)\n    else:\n        # Fallback: longer line is blue.\n        hlen = 0\n        c = int(cc + hstep)\n        while 0 <= c < W and int(g[cr, c]) == int(hcol):\n            hlen += 1\n            c += int(hstep)\n        vlen = 0\n        r = int(cr + vstep)\n        while 0 <= r < H and int(g[r, cc]) == int(vcol):\n            vlen += 1\n            r += int(vstep)\n        if vlen >= hlen:\n            blue_col = int(vcol)\n            red_col = int(hcol)\n        else:\n            blue_col = int(hcol)\n            red_col = int(vcol)\n\n    blue_orient = \"h\" if int(hcol) == int(blue_col) else \"v\"\n    red_orient = \"h\" if int(hcol) == int(red_col) else \"v\"\n\n    # --- mask out the two edge lines (entire corner row + col) ---\n    line_mask = np.zeros((H, W), dtype=bool)\n    line_mask[cr, :] = True\n    line_mask[:, cc] = True\n\n    # --- extract solid rectangles (no bg inside bbox) ---\n    mask = (g != int(bg)) & (~line_mask) & (g != int(marker))\n    rects = []\n    for coords in components_mask(mask, connectivity=4):\ndef _build_canonical() -> np.ndarray:\n    long_dim = int(np.random.randint(9, 29))\n    options = []\n    for trailing in (1, 2):\n        max_used = long_dim - 2 - trailing\n        if max_used < 6 or max_used % 2:\n            continue\n        max_count = min(5, (max_used + 2) // 4)\n        pairs = []\n        for a in range(2, max_count + 1):\n            for b in range(2, max_count + 1):\n                if a + b > 9:\n                    continue\n                eligible = []\n                if max_used <= 10 * a - 2:\n                    eligible.append(0)\n                if max_used <= 10 * b - 2:\n                    eligible.append(1)\n                if eligible:\n                    pairs.append((a, b, eligible))\n        if pairs:\n            options.append((max_used, pairs))\n\n    max_used, pairs = options[int(np.random.randint(len(options)))]\n    n0, n1, eligible = pairs[int(np.random.randint(len(pairs)))]\n    max_band = int(np.random.choice(eligible))\n    max0 = min(max_used, 10 * n0 - 2)\n    max1 = min(max_used, 10 * n1 - 2)\n    used0 = int(max_used if max_band == 0 else np.random.choice(np.arange(4 * n0 - 2, max0 + 1, 2)))\n    used1 = int(max_used if max_band == 1 else np.random.choice(np.arange(4 * n1 - 2, max1 + 1, 2)))\n    band0 = _distribute_band_widths(n0, used0)\n    band1 = _distribute_band_widths(n1, used1)\n\n    grid = np.full((8, long_dim), BG, dtype=int)\n    grid[0, :] = BLUE\n    grid[:, 0] = RED\n    grid[0, 0] = MARKER\n\n    for r0, widths in ((2, band0), (5, band1)):\n        c = 2\n        for w in widths:\n            color = int(np.random.choice(DOMINANT_COLORS))\n            patch = np.full((2, w), color, dtype=int)\n            patch = _sprinkle_minorities(patch, color)\n            paste(grid, patch, r0, c)\n            c += w + 2\n\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    canonical = _build_canonical()\n    blue_orient = str(np.random.choice([\"h\", \"v\"]))\n    corner = str(np.random.choice([\"tl\", \"tr\", \"bl\", \"br\"]))\n    return _transform(canonical, blue_orient, corner)\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate input for 291dc1e1\")\n","exit_code":0,"status":"completed"}}
