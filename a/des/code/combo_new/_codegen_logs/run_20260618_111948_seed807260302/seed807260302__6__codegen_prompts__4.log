{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,90p' /home/lixinyu/snap/new/ARC_code/train/e729b7be.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the scene by adding the point-reflected copy of the colored object across the central marker.\n\n    Input structure\n    - The grid has odd dimensions, a dominant background, and a center-row marker color appearing only at the left edge, center, and right edge.\n    - A single divider color fills the center column except for the center marker.\n    - All remaining foreground pixels form the object to copy, entirely on the left side of the divider.\n    Rule\n    - Keep the input unchanged.\n    - For every object pixel, paint the pixel rotated 180 degrees around the center marker with the same color.\n    Key insight\n    - The center marker is the rotation center; the yellow-looking divider is not mirrored, it only separates the source from the empty target side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h % 2 == 1 and w % 2 == 1\n\n    cr, cc = h // 2, w // 2\n    bg = int(get_bg(g))\n\n    marker_color = int(g[cr, cc])\n    assert marker_color != bg\n    marker_mask = g == marker_color\n    expected_markers = np.zeros(g.shape, dtype=bool)\n    expected_markers[cr, 0] = True\n    expected_markers[cr, cc] = True\n    expected_markers[cr, w - 1] = True\n    assert np.array_equal(marker_mask, expected_markers)\n\n    center_col = g[:, cc]\n    divider_colors = {int(color) for color in np.unique(center_col) if int(color) != marker_color}\n    assert len(divider_colors) == 1\n    divider_color = next(iter(divider_colors))\n    assert divider_color != bg\n    expected_divider = np.zeros(g.shape, dtype=bool)\n    expected_divider[:, cc] = True\n    expected_divider[cr, cc] = False\n    assert np.array_equal(g == divider_color, expected_divider)\n\n    source_mask = (g != bg) & (g != marker_color) & (g != divider_color)\n    source_coords = np.argwhere(source_mask)\n    assert source_coords.size > 0\n    assert np.all(source_coords[:, 1] < cc)\n\n    out = g.copy()\n    for r, c in source_coords:\n        rr = 2 * cr - int(r)\n        rc = 2 * cc - int(c)\n        assert 0 <= rr < h and 0 <= rc < w\n        assert out[rr, rc] == bg\n        out[rr, rc] = g[r, c]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Colors and canvas bounds.\nBG_COLOR, DIVIDER_COLOR, MARKER_COLOR = 7, 4, 8\nGRID_SIZES, MIN_EMPTY_BORDER_ROWS = (15, 17, 19), 1\n\n# Convex source shape bounds.\nSOURCE_SPAN_RANGE = (10, 15)\nSOURCE_MAX_WIDTH_RANGE = (5, 7)\nSOURCE_EDGE_WIDTH_RANGE = (1, 3)\nWIDTH_STEP_CAP, SOURCE_PIXEL_RANGE = 2, (35, 83)\n\n# Color palette, band orders, and retry budget.\nSOURCE_COLORS = (0, 1, 2, 3, 5, 6, 9)\nSOURCE_COLOR_COUNT_RANGE, GEN_ATTEMPTS = (3, 7), 300\nCOLORING_KEYS = (\n    lambda item: (item[2], item[3], item[1]),\n    lambda item: (item[3], item[2], item[1]),\n    lambda item: (item[2] + item[3], item[2], item[1]),\n    lambda item: (item[2] - item[3], item[2], item[1]),\n)\n\n\ndef _gen_bounded_steps(total, slots, cap):\n    steps = []\n    remaining = total\n    for i in range(slots):\n        left = slots - i - 1\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '38,110p' /home/lixinyu/snap/new/ARC_code/train/412b6263.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Infer the background, rotate the whole input 90 degrees counterclockwise, and stack two framed copies vertically.\n\n    Input structure:\n    - Blue is absent from the input.\n    - One rare marker color appears in exactly two pixels.\n    - The background is the unique non-marker color whose removal leaves exactly two 4-connected foreground objects, each with one marker pixel and one body color.\n    - The whole grid, including background and foreground objects, is the sprite to transform.\n\n    Rule:\n    - Rotate the entire input grid 90 degrees counterclockwise.\n    - Create a blue one-pixel frame around two vertical copies of the rotated grid.\n    - Use the input background color for the two endpoints of every horizontal frame/separator row.\n\n    Key insight: The output is not a crop of the foreground objects; it is two copies of the complete rotated input, separated and enclosed by a newly added blue border.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg, objects = _infer_background_and_objects(g)\n    assert bg != Color.BLUE\n    assert Color.BLUE not in set(map(int, g.ravel()))\n\n    copies = len(objects)\n\n    tile = np.rot90(g, 1)\n    tile_h, tile_w = map(int, tile.shape)\n\n    out_h = copies * tile_h + copies + 1\n    out_w = tile_w + 2\n    out = np.full((out_h, out_w), Color.BLUE, dtype=int)\n\n    for i in range(copies):\n        row = i * (tile_h + 1)\n        out[row, 0] = bg\n        out[row, -1] = bg\n        paste(out, tile, row + 1, 1)\n\n    out[-1, 0] = bg\n    out[-1, -1] = bg\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n# CFG: ranges use numpy's high-exclusive convention where applicable.\nCANVAS_SHAPE_RANGES = ((5, 10), (5, 11))\nOBJECT_SHAPE_RANGES = ((2, 5), (2, 5))\nMIN_SEPARATION_GAP = 1\nMAX_OUTPUT_SIZE = 30\nINPUT_COLORS = [0, 2, 3, 4, 5, 6, 7, 8, 9]\nPALETTE_SIZE = 3\nFRAME_COLOR = Color.BLUE\nOUTPUT_TILE_COPIES = 2\nFRAME_THICKNESS = 1\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _edge_cells(h: int, w: int) -> list[tuple[int, int]]:\n    return [\n        (r, c)\n        for r in range(h)\n        for c in range(w)\n        if r in (0, h - 1) or c in (0, w - 1)\n    ]\n\ndef _expected_output(inp: np.ndarray, bg: int) -> np.ndarray:\n    tile = np.rot90(inp, 1)\n    tile_h, tile_w = tile.shape\n    out_h = OUTPUT_TILE_COPIES * tile_h + (OUTPUT_TILE_COPIES + 1) * FRAME_THICKNESS\n    out_w = tile_w + 2 * FRAME_THICKNESS\n    out = np.full((out_h, out_w), FRAME_COLOR, dtype=int)\n    out[0, 0] = out[0, -1] = bg\n    out[tile_h + FRAME_THICKNESS, 0] = out[tile_h + FRAME_THICKNESS, -1] = bg\n    out[-1, 0] = out[-1, -1] = bg\n","exit_code":0,"status":"completed"}}
