{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the one blank in each corner region so all four regions have the same color multiset.\n\n    Input structure:\n    - The dominant background color forms one solid separator row and one solid\n      separator column.\n    - The separator cross splits the grid into four equal rectangular corner regions.\n    - Each corner region contains exactly one background-colored blank pixel.\n\n    Rule:\n    - Count the non-background colors in each corner region.\n    - The completed region multiset is defined by the maximum observed count of\n      each color across the four regions.\n    - Replace each region's blank pixel with the single color needed to match that\n      completed multiset.\n\n    Key insight:\n    - The separator color inside a corner region is a missing value marker; comparing\n      the four regions reveals the shared multiset without using numeric color order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    color_counts = Counter(map(int, g.reshape(-1)))\n    assert all(\n        color == bg or count < color_counts[bg] for color, count in color_counts.items()\n    ), \"background color must be uniquely dominant\"\n\n    cross_row, cross_col = _solid_separator_cross(g, bg)\n    regions = _quadrants(cross_row, cross_col, height, width)\n    region_shape = g[regions[0]].shape\n    region_area = int(np.prod(region_shape))\n\n    counts_by_region: list[Counter[int]] = []\n    blank_positions: list[tuple[int, int]] = []\n    for row_slice, col_slice in regions:\n        region = g[row_slice, col_slice]\n        assert region.shape == region_shape, \"all corner regions must have the same shape\"\n        blanks = np.argwhere(region == bg)\n        assert len(blanks) == 1, \"each corner region must have exactly one blank\"\n\n        counts_by_region.append(Counter(map(int, region[region != bg].reshape(-1))))\n        local_r, local_c = map(int, blanks[0])\n        blank_positions.append((row_slice.start + local_r, col_slice.start + local_c))\n\n    target_counts: Counter[int] = Counter()\n    for counts in counts_by_region:\n        for color, count in counts.items():\n            target_counts[color] = max(target_counts[color], count)\n    assert sum(target_counts.values()) == region_area, \"completed region multiset must be unique\"\n\n    out = g.copy()\n    for counts, (row, col) in zip(counts_by_region, blank_positions):\n        missing = target_counts - counts\n        assert len(missing) == 1, \"each blank must have exactly one matching fill color\"\n        fill_color, fill_count = next(iter(missing.items()))\n        assert fill_count == 1, \"each corner region must need one pixel of the fill color\"\n        out[row, col] = fill_color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n# Canvas/palette bounds.\nGRID_HALF_MIN = 2\nGRID_HALF_MAX = 6\nCOLOR_COUNT = 10\nMIN_TARGET_COLORS = 3\nMAX_NON_BG_COLORS = COLOR_COUNT - 1\n# Layout probabilities and constraints.\nPREFERRED_GRID_HALF = (2, 2)\nPREFERRED_GRID_PROB = 0.65\nQUADRANT_COUNT = 4\nSEPARATOR_WIDTH = 1\nBG_DOMINANCE_MARGIN = 1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py | sed '\"'$d'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/c4d1a9ae.py | sed '\"'$d'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/c4d1a9ae.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill each vertical foreground band's background cells with the color of the next band to its right.\n\n    Input structure\n    - The dominant color is the background.\n    - Each other color occupies a separate vertical band defined by that color's\n      minimum and maximum columns.\n    - Within a band, all cells are either that band's color or background.\n\n    Rule\n    - Order the bands from left to right.\n    - In each band, replace background pixels with the color of the next band in\n      that order, wrapping from the rightmost band back to the leftmost.\n    - Preserve all existing foreground pixels and all background pixels outside\n      the bands.\n\n    Key insight\n    - The column bands form a cyclic palette legend: a band's gaps are completed\n      by borrowing the color from its right-hand neighbor, not by changing the\n      band's existing pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    bands = _foreground_bands(g, bg)\n\n    out = g.copy()\n    for index, (c0, c1, _color) in enumerate(bands):\n        fill_color = bands[(index + 1) % len(bands)][2]\n        band = out[:, c0 : c1 + 1]\n        band[band == bg] = fill_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nGRID_ROWS_RANGE = (8, 12)\nGRID_COLS_RANGE = (7, 10)\n# Band structure and foreground occupancy.\nBAND_COUNT = 3\nBAND_WIDTH_RANGE = (1, 3)\nBAND_DENSITY_RANGE = (0.30, 0.75)\n# Palette and retry budget.\nPALETTE_SIZE = 4\nMAX_GENERATION_ATTEMPTS = 300\n\n\n","exit_code":0,"status":"completed"}}
