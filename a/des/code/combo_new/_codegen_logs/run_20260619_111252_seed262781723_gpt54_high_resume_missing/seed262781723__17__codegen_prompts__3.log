yu/snap/new/ARC_code/train/fe45cba4.py:89:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/fe45cba4.py:128:    \"\"\"Sample row widths and mirror them vertically.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/fe45cba4.py:140:    \"\"\"Return a mask whose true cells fill each row from the right edge.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/fe45cba4.py:247:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/afe3afe9.py:105:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/afe3afe9.py:106:    \"\"\"Convert each hollow 3x3 symbol to one pixel and slide the pixels clockwise from the marked edge.\n/home/lixinyu/snap/new/ARC_code/train/afe3afe9.py:119:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/afe3afe9.py:189:    remaining = [(r, c) for r in rows for c in cols if (r, c) not in cells]\n/home/lixinyu/snap/new/ARC_code/train/afe3afe9.py:190:    random.shuffle(remaining)\n/home/lixinyu/snap/new/ARC_code/train/afe3afe9.py:191:    cells.update(remaining[: count - len(cells)])\n/home/lixinyu/snap/new/ARC_code/train/afe3afe9.py:270:    if not np.array_equal(main(inp), expected):\n/home/lixinyu/snap/new/ARC_code/train/afe3afe9.py:275:def generate_input():\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:8:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:11:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:34:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:35:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:46:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:140:    \"\"\"Pick up to n values from candidates with at least min_spacing between any two.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:156:    \"\"\"Generate a single-color 8-connected sprite cropped to its bounding box.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:306:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:311:    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n/home/lixinyu/snap/new/ARC_code/train/46c35fc7.py:20:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/46c35fc7.py:21:    \"\"\"Rotate the colors around every 3x3 foreground ring, with corners and side-centers cycling in opposite directions.\n/home/lixinyu/snap/new/ARC_code/train/46c35fc7.py:34:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/46c35fc7.py:182:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:156:    remaining = list(range(len(pieces)))\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:247:    if backtrack(remaining):\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:252:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:253:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:266:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:297:    \"\"\"Build 2Nx2N quadrant-ownership grid with tab intrusions.\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:302:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:350:    \"\"\"Extract cells for quadrant *q* in local (0-based) coordinates.\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:353:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:365:    \"\"\"Render cell list into a tight numpy patch (bg=0).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:375:    \"\"\"Sample random tab specs for all four boundaries.\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:378:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:394:    \"\"\"Place patches on a canvas in random order with padding.\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:397:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:459:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:464:    raise RuntimeError('generate_input: exhausted attempts')\n","exit_code":0,"sta