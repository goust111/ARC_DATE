{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/5623160b.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\nMARKER_COLOR = 9\nDIRECTIONS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _outward_direction(g: np.ndarray, coords: np.ndarray) -> tuple[int, int]:\n    H, W = g.shape\n    directions: set[tuple[int, int]] = set()\n    for r, c in coords:\n        rr = int(r)\n        cc = int(c)\n        for dr, dc in DIRECTIONS:\n            nr = rr + dr\n            nc = cc + dc\n            if 0 <= nr < H and 0 <= nc < W and int(g[nr, nc]) == MARKER_COLOR:\n                directions.add((-dr, -dc))\n\n    assert len(directions) == 1, \"each moving object must touch maroon markers on exactly one side\"\n    return directions.pop()\n\n\ndef _steps_to_edge(shape: tuple[int, int], coords: np.ndarray, direction: tuple[int, int]) -> int:\n    H, W = shape\n    dr, dc = direction\n    assert (dr == 0) != (dc == 0), \"movement direction must be cardinal\"\n    if dr < 0:\n        return int(coords[:, 0].min())\n    if dr > 0:\n        return int(H - 1 - coords[:, 0].max())\n    if dc < 0:\n        return int(coords[:, 1].min())\n    assert dc > 0\n    return int(W - 1 - coords[:, 1].max())\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Push every colored object touching maroon markers straight outward until it reaches the grid edge.\n\n    Input structure:\n    - The background is the dominant color.\n    - Maroon pixels are fixed markers.\n    - Every other foreground 4-connected object touches the marker pixels on exactly one cardinal side.\n\n    Rule:\n    - Clear each non-background, non-maroon object from its original position.\n    - Translate it in the direction away from its maroon contact until the object reaches the grid boundary.\n    - Keep the maroon marker pixels unchanged.\n\n    Key insight:\n    - The maroon contact side is a launcher: it determines a unique outward ray for the whole object, and the edge of the grid determines the translation distance.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg != MARKER_COLOR\n    assert bool(np.any(g == MARKER_COLOR))\n\n    marker_components = find_components(\n        g,\n        bg=bg,\n        connectivity=4,\n        monochromatic=True,\n        colors=[MARKER_COLOR],\n        return_format=\"dict\",\n    )\n    assert 1 <= len(marker_components) <= 3, \"maroon markers must form 1-3 moderate components\"\n    assert sum(int(comp[\"area\"]) for comp in marker_components) <= 17, \"maroon marker area must be moderate\"\n    assert all(int(comp[\"area\"]) <= 9 for comp in marker_components), \"each maroon component must be moderate\"\n\n    out = g.copy()\n    placements: list[tuple[int, np.ndarray]] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        color = int(comp[\"color\"])\n        if color == MARKER_COLOR:\n            continue\n\n        coords = comp[\"coords\"].astype(int, copy=False)\n        direction = _outward_direction(g, coords)\n        steps = _steps_to_edge(g.shape, coords, direction)\n        assert steps <= 8, \"push distance must stay within the observed moderate range\"\n        offset = np.array(direction, dtype=int) * steps\n        shifted = coords + offset\n        assert bool(\n            np.all(\n                (0 <= shifted[:, 0])\n                & (shifted[:, 0] < g.shape[0])\n                & (0 <= shifted[:, 1])\n                & (shifted[:, 1] < g.shape[1])\n            )\n        )\n        own = {tuple(coord) for coord in coords.tolist()}\n        for step in range(1, steps + 1):\n            swept = coords + np.array(direction, dtype=int) * step\n            for rr, cc in swept:\n                loc = (int(rr), int(cc))\n                assert loc in own or int(g[loc]) == bg, \"object movement path must be unobstructed\"\n\n        out[coords[:, 0], coords[:, 1]] = bg\n        placements.append((color, shifted))\n\n    assert placements\n    for color, coords in placements:\n        assert bool(np.all(out[coords[:, 0], coords[:, 1]] == bg)), \"moved objects must not collide\"\n        out[coords[:, 0], coords[:, 1]] = color\n\n    return out\n\n# --------------- generator (attempt 1 refined) ---------------\n\n# Generated grid colors.\nBG = 7\nMAROON = 9\nALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8]\nDIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n# Canvas and maroon marker bounds.\nGRID_SIZE_MIN = 9\nGRID_SIZE_MAX = 16\nMAROON_COMPONENT_MIN = 1\nMAROON_COMPONENT_MAX = 3\nMAROON_TOTAL_AREA_MAX = 17\nMAROON_COMPONENT_AREA_MAX = 9\nINTERIOR_PADDING = 1\nMAROON_PLACEMENT_TRIES = 80\n\n# Moving object bounds and push constraints.\nOBJECT_COUNT_MIN = 3\nOBJECT_COUNT_MAX = 7\nOBJECT_SIZE_MIN = 1\nOBJECT_SIZE_MAX = 5\nPUSH_DISTANCE_MAX = 8\nZERO_STEP_PROBABILITY = 0.25\nZERO_STEP_ALLOWANCE = 1\n\n# Retry limits for object placement and whole-grid generation.\nOBJECT_SHAPE_TRIES = 20\nCONTACT_CANDIDATE_LIMIT = 5\nGENERATE_RETRIES = 300\n\n\ndef _grow_polyomino(size, rng):\n    \"\"\"Grow a 4-connected polyomino of given size, normalized to (0, 0).\"\"\"\n    cells = {(0, 0)}\n    frontier = [(0, 0)]\n    while len(cells) < size:\n        r, c = rng.choice(frontier)\n        nbrs = [(r-1, c), (r+1, c), (r, c-1), (r, c+1)]\n        rng.shuffle(nbrs)\n        grown = False\n        for nr, nc in nbrs:\n            if (nr, nc) not in cells:\n                cells.add((nr, nc))\n                frontier.append((nr, nc))\n                grown = True\n                break\n        if not grown:\n            frontier.remove((r, c))\n            if not frontier:\n                break\n\n    min_r = min(r for r, c in cells)\n    min_c = min(c for r, c in cells)\n    return [(r - min_r, c - min_c) for r, c in cells]\n\n\ndef _gen_steps_to_edge(N, coords, direction):\n    arr = np.array(coords, dtype=int)\n    dr, dc = direction\n    if dr == -1:\n        return int(arr[:, 0].min())\n    if dr == 1:\n        return int(N - 1 - arr[:, 0].max())\n    if dc == -1:\n        return int(arr[:, 1].min())\n    return int(N - 1 - arr[:, 1].max())\n\n\ndef _swept_cells(N, coords, direction):\n    dr, dc = direction\n    steps = _gen_steps_to_edge(N, coords, direction)\n    own = set(coords)\n    swept = set()\n    for step in range(1, steps + 1):\n        for r, c in coords:\n            loc = (r + dr * step, c + dc * step)\n            if loc not in own:\n                swept.add(loc)\n    return swept\n\n\ndef _paths_are_clear(inp, objects):\n    N = inp.shape[0]\n    for _, inp_coords, _, direction in objects:\n        for r, c in _swept_cells(N, inp_coords, direction):\n            if inp[r, c] != BG:\n                return False\n    return True\n\n\ndef _paint_cells(grid, coords, color):\n    for r, c in coords:\n        grid[r, c] = color\n\n\ndef _place_maroon_components(rng, grid, num_maroon):\n    \"\"\"Place separated maroon components; returns (components, occupied) or None.\"\"\"\n    N = grid.shape[0]\n    maroon_components = []\n    all_maroon = set()\n    total_maroon = 0\n\n    for idx in range(num_maroon):\n        remaining_components = num_maroon - idx - 1\n        max_size = min(\n            MAROON_COMPONENT_AREA_MAX,\n            MAROON_TOTAL_AREA_MAX - total_maroon - remaining_components,\n        )\n        if max_size < 1:\n            return None\n\n        size = rng.randint(1, max_size)\n        cells = _grow_polyomino(size, rng)\n        h = max(r for r, c in cells) + 1\n        w = max(c for r, c in cells) + 1\n        if h > N - 2 or w > N - 2:\n            return None\n\n        placed = _try_place_maroon_component(rng, grid, cells, all_maroon)\n        if placed is None:\n            return None\n\n        _paint_cells(grid, placed, MAROON)\n        maroon_components.append(placed)\n        all_maroon.update(placed)\n        total_maroon += size\n\n    return maroon_components, all_maroon\n\n\ndef _try_place_maroon_component(rng, grid, cells, all_maroon):\n    N = grid.shape[0]\n    h = max(r for r, c in cells) + 1\n    w = max(c for r, c in cells) + 1\n    for _ in range(MAROON_PLACEMENT_TRIES):\n        r0 = rng.randint(INTERIOR_PADDING, N - INTERIOR_PADDING - h)\n        c0 = rng.randint(INTERIOR_PADDING, N - INTERIOR_PADDING - w)\n        abs_cells = [(r + r0, c + c0) for r, c in cells]\n        if not all(grid[r, c] == BG for r, c in abs_cells):\n            continue\n        if any((r + dr, c + dc) in all_maroon for r, c in abs_cells for dr, dc in DIRS):\n            continue\n        return abs_cells\n    return None\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/1ae2feb7.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg, paste\nfrom arc_utils import get_bg as _bg_color\n\ndef _find_sep_col(g, bg):\n    h, w = g.shape\n    for c in range(w):\n        col = g[:, c]\n        vals = col[col != bg]\n        if vals.size >= h - 1 and (vals == vals[0]).all():\n            return c, int(vals[0])\n    return None, None\n\ndef _iter_runs_1d(row, c_lo, c_hi, bg):\n    c = c_lo\n    while c < c_hi:\n        if row[c] == bg:\n            c += 1\n            continue\n        col = int(row[c])\n        c0 = c\n        while c < c_hi and row[c] == col:\n            c += 1\n        yield c0, c - 1, col\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extend row bars periodically across the opposite side of a separator column.\n\n    Input structure:\n    - bg = background. A near-solid vertical separator divides the grid into two sides.\n    - One side contains horizontal colored bars; the other side is blank target space.\n    - Bars may be stacked by row and may sit at different distances from the separator.\n\n    Rule:\n    - Identify the separator as the column whose non-bg cells are one color.\n    - Treat the denser side as the bar side and collect each contiguous row run.\n    - Process bars from nearest to farthest from the separator; for each bar, paint its\n      color every bar-length cells into the blank side without overwriting earlier paint.\n\n    Key insight: Each bar's length is the period for its extension, and nearer bars claim target cells first.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    bg = _bg_color(g)\n\n    # Find the vertical separator column: a column whose non-bg cells are all the same color.\n    # (May not span full height; some rows can be bg.)\n    sep_col, _sep_color = _find_sep_col(g, bg)\n    if sep_col is None:\n        return g.copy()\n\n    out = g.copy()\n\n    # Decide which side contains the bars (the other side is the painting target).\n    left_mass = int(np.sum(g[:, :sep_col] != bg)) if sep_col > 0 else 0\n    right_mass = int(np.sum(g[:, sep_col + 1 :] != bg)) if sep_col + 1 < w else 0\n    bars_on_left = left_mass >= right_mass\n\n    bars = []\n    for r in range(h):\n        if bars_on_left:\n            for c0, c1, col in _iter_runs_1d(g[r, :], 0, sep_col, bg=bg):\n                length = c1 - c0 + 1\n                dist = (sep_col - 1) - c1  # 0 if bar touches left of separator\n                bars.append((dist, r, c0, c1, length, col))\n        else:\n            for c0, c1, col in _iter_runs_1d(g[r, :], sep_col + 1, w, bg=bg):\n                length = c1 - c0 + 1\n                dist = c0 - (sep_col + 1)  # 0 if bar touches right of separator\n                bars.append((dist, r, c0, c1, length, col))\n\n    # Process bars from closest to separator outward; do not overwrite.\n    bars.sort(key=lambda t: (t[0], t[1], t[2]))\n    for _, r, _c0, _c1, length, col in bars:\n        step = length\n        if step <= 0:\n            continue\n        if bars_on_left:\n            for cc in range(sep_col + 1, w, step):\n                if int(out[r, cc]) == bg:\n                    out[r, cc] = col\n        else:\n            for cc in range(sep_col - 1, -1, -step):\n                if int(out[r, cc]) == bg:\n                    out[r, cc] = col\n\n    return out\n\n# --------------- generator (attempt 3 (Codex)) ---------------\n\n# Canvas size bounds (inclusive ranges).\nH_MIN, H_MAX = 8, 13\nW_MIN, W_MAX = 15, 20\n\n# Bar-side width bounds (clamped so ext_side stays in [EXT_SIDE_MIN, EXT_SIDE_MAX]).\nBAR_SIDE_MIN, BAR_SIDE_MAX = 3, 12\nEXT_SIDE_MIN, EXT_SIDE_MAX = 2, 14\n\n# Palette sizes.\nPALETTE_MIN, PALETTE_MAX = 5, 8\n\n# Active-row counts.\nACTIVE_MIN, ACTIVE_MAX = 2, 5\n\n# Per-row bar structure probabilities.\nP_TWO_BARS = 0.45        # probability a row has 2 adjacent bars instead of 1\nP_SEP_GAP = 0.15         # probability the nearest bar leaves a 1-cell gap to separator\nP_SWAP_COLORS = 0.5      # when 2 bars, probability to swap near/far colors\n\n# Separator gap (a single terminal-row cell omitted from separator column).\nP_SEP_COLUMN_GAP = 0.2\n\n# Retry budget for generation.\nMAX_ATTEMPTS = 300\n\n\ndef _choose_active_rows(rng: np.random.Generator, h: int, count: int) -> list[int]:\n    \"\"\"Pick `count` row indices in [0, h) with pairwise spacing >= 2.\"\"\"\n    base = np.sort(rng.choice(h - count + 1, size=count, replace=False))\n    return list(map(int, base + np.arange(count)))\n\n\ndef _sample_palette(rng: np.random.Generator) -> tuple[int, list[int]]:\n    \"\"\"Pick separator color and a disjoint bar-color palette.\"\"\"\n    sep_color = int(rng.integers(1, 10))\n    bar_pool = [c for c in range(1, 10) if c != sep_color]\n    size = int(rng.integers(PALETTE_MIN, min(PALETTE_MAX, len(bar_pool)) + 1))\n    palette = list(map(int, rng.choice(bar_pool, size=size, replace=False)))\n    return sep_color, palette\n\n\ndef _sample_row_bars(\n    rng: np.random.Generator,\n    palette: list[int],\n    primary: int,\n    bar_side_len: int,\n) -> tuple[list[tuple[int, int]], int]:\n    \"\"\"Return (bars, sep_gap) where bars is a list of (length, color) ordered near->far.\"\"\"\n    sep_gap = 1 if rng.random() < P_SEP_GAP else 0\n    capacity = bar_side_len - sep_gap\n    two_bars = rng.random() < P_TWO_BARS\n\n    if not two_bars:\n        length = int(rng.integers(1, capacity + 1))\n        return [(length, primary)], sep_gap\n\n    near_len = int(rng.integers(1, capacity))\n    far_len = int(rng.integers(1, capacity - near_len + 1))\n    others = [c for c in palette if c != primary]\n    colors = [primary, int(rng.choice(others))]\n    if rng.random() < P_SWAP_COLORS:\n        colors.reverse()\n    return [(near_len, colors[0]), (far_len, colors[1])], sep_gap\n\n\ndef _place_bars(\n    out: np.ndarray,\n    row: int,\n    sep_col: int,\n    bars_on_left: bool,\n    bars: list[tuple[int, int]],\n    sep_gap: int,\n) -> None:\n    \"\"\"Paint bars on the bar side, stacking from nearest-to-separator outward.\"\"\"\n    if bars_on_left:\n        cursor = sep_col - sep_gap\n        for length, color in bars:\n            out[row, cursor - length : cursor] = color\n            cursor -= length\n    else:\n        cursor = sep_col + 1 + sep_gap\n        for length, color in bars:\n            out[row, cursor : cursor + length] = color\n            cursor += length\n\n\ndef _paint_extension(\n    out: np.ndarray,\n    row: int,\n    sep_col: int,\n    bars_on_left: bool,\n    bars: list[tuple[int, int]],\n) -> None:\n    \"\"\"Simulate the periodic extension onto the ext side (nearest-first, no overwrite).\"\"\"\n    w = out.shape[1]\n    for length, color in bars:\n        if bars_on_left:\n            positions = range(sep_col + 1, w, length)\n        else:\n            positions = range(sep_col - 1, -1, -length)\n        for cc in positions:\n            if out[row, cc] == 0:\n                out[row, cc] = color\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    h = int(rng.integers(H_MIN, H_MAX + 1))\n    w = int(rng.integers(W_MIN, W_MAX + 1))\n\n    # bar_side_len constrained so ext_side_len = w - 1 - bar_side_len is in [EXT_SIDE_MIN, EXT_SIDE_MAX].\n    lo = max(BAR_SIDE_MIN, w - 1 - EXT_SIDE_MAX)\n    hi = min(BAR_SIDE_MAX, w - 1 - EXT_SIDE_MIN)\n    if lo > hi:\n        return None\n    bar_side_len = int(rng.integers(lo, hi + 1))\n\n    bars_on_left = bool(rng.integers(0, 2) == 0)\n    sep_col = bar_side_len if bars_on_left else (w - 1 - bar_side_len)\n\n    sep_color, palette = _sample_palette(rng)\n\n    max_active = min(ACTIVE_MAX, (h + 1) // 2)\n    active_count = int(rng.integers(ACTIVE_MIN, max_active + 1))\n    active_rows = _choose_active_rows(rng, h, active_count)\n    inactive_rows = [r for r in range(h) if r not in set(active_rows)]\n\n    out = np.zeros((h, w), dtype=int)\n    out[:, sep_col] = sep_color\n    if inactive_rows and rng.random() < P_SEP_COLUMN_GAP:\n        gap_row = inactive_rows[int(rng.integers(0, len(inactive_rows)))]\n        out[gap_row, sep_col] = 0\n\n    row_primary = list(map(int, rng.permutation(palette)[:active_count]))\n    row_bars_map: dict[int, list[tuple[int, int]]] = {}\n    for idx, row in enumerate(active_rows):\n        bars, sep_gap = _sample_row_bars(rng, palette, row_primary[idx], bar_side_len)\n        row_bars_map[row] = bars\n        _place_bars(out, row, sep_col, bars_on_left, bars, sep_gap)\n\n    for row, bars in row_bars_map.items():\n        _paint_extension(out, row, sep_col, bars_on_left, bars)\n\n    inp = out.copy()\n    if bars_on_left:\n        inp[:, sep_col + 1 :] = 0\n    else:\n        inp[:, :sep_col] = 0\n\n    if get_bg(inp) != 0:\n        return None\n    if sep_color not in colors_present(inp, exclude=[0]):\n        return None\n    if not np.array_equal(main(inp), out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"failed to generate valid input after {MAX_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
