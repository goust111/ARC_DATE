{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py /home/lixinyu/snap/new/ARC_code/eval/898e7135.py /home/lixinyu/snap/new/ARC_code/eval/21897d95.py /home/lixinyu/snap/new/ARC_code/train/99caaf76.py /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py /home/lixinyu/snap/new/ARC_code/eval/aa4ec2a5.py /home/lixinyu/snap/new/ARC_code/train/465b7d93.py /home/lixinyu/snap/new/ARC_code/train/973e499e.py; do echo \"===== $f\"; sed -n '\"'1,260p' \\\"\"'$f\"; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py /home/lixinyu/snap/new/ARC_code/eval/898e7135.py /home/lixinyu/snap/new/ARC_code/eval/21897d95.py /home/lixinyu/snap/new/ARC_code/train/99caaf76.py /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py /home/lixinyu/snap/new/ARC_code/eval/aa4ec2a5.py /home/lixinyu/snap/new/ARC_code/train/465b7d93.py /home/lixinyu/snap/new/ARC_code/train/973e499e.py; do echo \"===== $f\"; sed -n '\"'1,260p' \\\"\"'$f\"; done'","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\nimport numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):\n        b = int(b)\n        f = int(f)\n        if b == bg:\n            continue\n        mapping[b] = f\n\n    return mapping, pal_mask\n\n\ndef _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:\n    \"\"\"\n    Find background regions (excluding the palette area) that do NOT touch the grid boundary,\n    and fill each region based on the most common adjacent border color (mapped via palette).\n    \"\"\"\n    h, w = out.shape\n    bg_mask = (out == bg) & (~pal_mask)\n    comps = components_mask(bg_mask, connectivity=4)\n    for pts in comps:\n        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n        if touches_boundary:\n            continue\n\n        adj_counts: dict[int, int] = {}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < h and 0 <= cc < w:\n                    if pal_mask[rr, cc]:\n                        continue\n                    v = int(out[rr, cc])\n                    if v == bg:\n                        continue\n                    adj_counts[v] = adj_counts.get(v, 0) + 1\n        if not adj_counts:\n            continue\n\n        # Prefer an adjacent color that exists in the mapping; pick the most frequent border.\n        border = None\n        best = -1\n        for col, cnt in adj_counts.items():\n===== /home/lixinyu/snap/new/ARC_code/eval/898e7135.py\nfrom __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import bbox, bbox_coords, components_mask, crop_bbox, find_components, get_bg, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Inflate a frame's hole-layout and fill each hole with its matching piece.\n\n    Input structure:\n    - bg = most common color. Largest component is a monochrome frame enclosing bg holes.\n    - Outside pieces composed of k×k blocks; k = side of smallest solid square piece.\n\n    Rule:\n    - Extract connected hole regions inside the frame as slots.\n    - Match each piece to a slot by comparing block-level shapes under rotation/flip.\n    - Output the layout scaled by k, with pieces placed in slots; frame color as background.\n\n    Key insight: Pieces are k×k-block-scaled versions of holes; downsampling reveals shape matches under all 8 orientations.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    # --- find the largest connected component of foreground (multicolor) ---\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n    frame_comp = max(comps, key=lambda d: int(d[\"area\"]))\n    fr0, fc0, fr1, fc1 = map(int, frame_comp[\"bbox\"])\n\n    # The frame is monochrome; use its dominant color as output background.\n    frame_cols = [int(g[int(r), int(c)]) for r, c in frame_comp[\"coords\"]]\n    bgc = int(Counter(frame_cols).most_common(1)[0][0])\n\n    # --- layout = bg holes inside the frame bbox, tight-cropped ---\n    sub = crop_bbox(g, (fr0, fc0, fr1, fc1))\n    hole = sub == int(bg)\n    hole_box = bbox(hole)\n    assert hole_box is not None, \"frame must enclose at least one bg hole\"\n    lr0, lc0, lr1, lc1 = map(int, hole_box)\n    layout = hole[lr0 : lr1 + 1, lc0 : lc1 + 1]\n\n    # --- slot components in the layout ---\n    slots = []\n    for coords in components_mask(layout, connectivity=4):\n        rr0, cc0, rr1, cc1 = bbox_coords(coords)\n        rr0, cc0, rr1, cc1 = map(int, (rr0, cc0, rr1, cc1))\n        h = int(rr1 - rr0 + 1)\n        w = int(cc1 - cc0 + 1)\n        sm = np.zeros((h, w), dtype=bool)\n        sm[coords[:, 0] - rr0, coords[:, 1] - cc0] = True\n        slots.append({\"area\": int(sm.sum()), \"r0\": int(rr0), \"c0\": int(cc0), \"mask\": sm})\n    slots.sort(key=lambda s: (-int(s[\"area\"]), int(s[\"r0\"]), int(s[\"c0\"])))\n\n    assert slots, \"frame must contain at least one slot\"\n\n    # --- pieces = non-singleton foreground components excluding the frame component ---\n    pieces = []\n    for comp in comps:\n        if comp is frame_comp:\n            continue\n        coords = comp[\"coords\"]\n        if coords.size == 0 or int(coords.shape[0]) <= 1:\n            continue\n        pr0, pc0, pr1, pc1 = map(int, comp[\"bbox\"])\n        patch = crop_bbox(g, (pr0, pc0, pr1, pc1))\n        ph, pw = map(int, patch.shape)\n        pm = np.zeros((ph, pw), dtype=bool)\n        pm[coords[:, 0] - pr0, coords[:, 1] - pc0] = True\n        pieces.append({\"area\": int(pm.sum()), \"mask\": pm, \"patch\": patch})\n\n    assert pieces, \"at least one non-frame piece must exist\"\n\n    # --- infer k from the smallest solid square piece ---\n    k = None\n    for p in pieces:\n        h, w = map(int, p[\"mask\"].shape)\n        if h == w and int(p[\"mask\"].sum()) == int(h * w):\n            k = int(h) if k is None else min(int(k), int(h))\n    k = int(k or 1)\n\n    def downsample_blocks(mask: np.ndarray) -> np.ndarray | None:\n        hh, ww = mask.shape\n        if hh % k != 0 or ww % k != 0:\n            return None\n        out_h, out_w = int(hh // k), int(ww // k)\n        out = np.zeros((out_h, out_w), dtype=bool)\n        for r in range(out_h):\n            for c in range(out_w):\n                block = mask[int(r * k) : int((r + 1) * k), int(c * k) : int((c + 1) * k)]\n                if bool(block.all()):\n                    out[r, c] = True\n                elif bool(block.any()):\n                    return None\n        return out\n\n    def dihedral_variants(\n        patch: np.ndarray, mask: np.ndarray\n    ) -> list[tuple[np.ndarray, np.ndarray]]:\n        base = []\n        for kk in range(4):\n            p = np.rot90(patch, int(kk))\n            m = np.rot90(mask, int(kk))\n            base.append((p, m))\n            base.append((np.fliplr(p), np.fliplr(m)))\n        uniq = []\n        seen = set()\n        for p, m in base:\n            key = m.tobytes()\n            if key in seen:\n                continue\n            seen.add(key)\n            uniq.append((p, m))\n        return uniq\n\n    # Precompute all usable (piece,variant) candidates with their block masks.\n    candidates = []\n    for pi, p in enumerate(pieces):\n        for vp, vm in dihedral_variants(p[\"patch\"], p[\"mask\"]):\n            um = downsample_blocks(vm)\n            if um is None:\n                continue\n            candidates.append({\"pi\": int(pi), \"area\": int(p[\"area\"]), \"um\": um, \"vp\": vp, \"vm\": vm})\n\n    used_piece: set[int] = set()\n    placements: list[tuple[dict, dict]] = []\n    for s in slots:\n        need_area = int(s[\"area\"]) * int(k) * int(k)\n        found = None\n        for cand in candidates:\n            if int(cand[\"pi\"]) in used_piece:\n                continue\n            if int(cand[\"area\"]) != int(need_area):\n                continue\n            if cand[\"um\"].shape != s[\"mask\"].shape:\n                continue\n            if np.array_equal(cand[\"um\"], s[\"mask\"]):\n                found = cand\n                break\n        assert found is not None, \"every slot must match a piece\"\n        used_piece.add(int(found[\"pi\"]))\n        placements.append((s, found))\n\n    outH = (int(layout.shape[0]) + 2) * int(k)\n    outW = (int(layout.shape[1]) + 2) * int(k)\n    out = np.full((outH, outW), int(bgc), dtype=int)\n\n    for s, cand in placements:\n        top = (int(s[\"r0\"]) + 1) * int(k)\n        left = (int(s[\"c0\"]) + 1) * int(k)\n        paste(out, cand[\"vp\"], int(top), int(left), mask=cand[\"vm\"], overwrite=True)\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for ARC-AGI-2 task 898e7135.\n\nOutput-first strategy:\n  1. Build a hole/wall layout of 4-conn slots (8-separated, includes unit slots).\n  2. For each slot, pick a distinct color + dihedral transform; upscale slot mask\n     by k to get the piece sprite (solid k*k blocks).\n  3. Assemble the frame (layout + 1-cell border of frame_color).\n  4. Scatter pieces outside the frame on a bg=0 canvas, plus single-pixel\n     distractor noise in a fresh color.\n\nThe generator validates main(input) == expected_output before returning.\n\"\"\"\n\nimport random\nimport numpy as np\n\nfrom arc_utils import paste, random_free_location\n\n# --- tunables ----------------------------------------------------------------\n\nK_CHOICES = [2, 3]                  # block scale factor\nLAYOUT_H_RANGE = (4, 12)           # inner layout rows\nLAYOUT_W_RANGE = (4, 8)            # inner layout cols\nN_SLOTS_RANGE = (3, 6)             # total slot count (incl. unit)\nN_UNITS_MAX = 2                    # max unit-slot count per example\nNON_UNIT_SIZE_CHOICES = [2, 3, 4, 5, 6, 7]  # area of non-unit slots\n\nHOLE_DENSITY_RANGE = (0.20, 0.50)  # valid hole fraction of layout area\nUNIT_SLOT_RETRIES = 20             # attempts per unit slot placement\nNON_UNIT_SLOT_RETRIES = 30         # attempts per non-unit slot placement\nGROW_SEED_TRIES = 8                # random seed cells tried per _grow_slot call\n\nCANVAS_DIM_RANGE = (15, 30)        # min/max for canvas height and width\nAREA_BUFFER_MULT = 4               # multiplier on piece area for canvas sizing\nAREA_BUFFER_CONST = 50             # additive constant for canvas area budget\n\nDISTRACTOR_RANGE = (8, 13)         # singleton distractor pixel count\nDISTRACTOR_RETRY_MULT = 10         # retry multiplier for distractor placement\nMIN_DISTRACTORS = 8                # minimum placed distractors to accept\n\nGENERATE_MAX_RETRIES = 300         # outer retry limit in generate_input\n\n\n# --- layout generation -------------------------------------------------------\n\ndef _canonical_shape_key(mask: np.ndarray) -> bytes:\n    \"\"\"Canonical bytes representation under D4 for a bool mask (tight-cropped).\"\"\"\n    variants = []\n    for kk in range(4):\n        r = np.rot90(mask, kk)\n        variants.append(r.tobytes() + bytes([r.shape[0], r.shape[1]]))\n        fr = np.fliplr(r)\n        variants.append(fr.tobytes() + bytes([fr.shape[0], fr.shape[1]]))\n    return min(variants)\n\n\ndef _grow_slot(forbidden: np.ndarray, target_size: int) -> np.ndarray | None:\n    \"\"\"Grow a 4-conn slot of given size starting from a random free cell.\n    `forbidden` marks cells that must not be used. Returns coords array or None.\n    \"\"\"\n    H, W = forbidden.shape\n    free_cells = np.argwhere(~forbidden)\n    if free_cells.size == 0:\n        return None\n    random.shuffle(free_cells)\n    for start in free_cells[:GROW_SEED_TRIES]:\n        r0, c0 = int(start[0]), int(start[1])\n        chosen = {(r0, c0)}\n        frontier = {(r0 - 1, c0), (r0 + 1, c0), (r0, c0 - 1), (r0, c0 + 1)}\n        while len(chosen) < target_size and frontier:\n            cands = [p for p in frontier if 0 <= p[0] < H and 0 <= p[1] < W\n                     and not forbidden[p[0], p[1]] and p not in chosen]\n            if not cands:\n                break\n            nr, nc = random.choice(cands)\n            chosen.add((nr, nc))\n            frontier.discard((nr, nc))\n            frontier.update({(nr - 1, nc), (nr + 1, nc), (nr, nc - 1), (nr, nc + 1)})\n        if len(chosen) == target_size:\n            return np.array(sorted(chosen))\n    return None\n\n\ndef _dilate8(mask: np.ndarray) -> np.ndarray:\n    \"\"\"Dilate a bool mask by 1 cell (8-connectivity).\"\"\"\n    out = mask.copy()\n    out[:-1, :] |= mask[1:, :]\n    out[1:, :] |= mask[:-1, :]\n    out[:, :-1] |= mask[:, 1:]\n    out[:, 1:] |= mask[:, :-1]\n    out[:-1, :-1] |= mask[1:, 1:]\n    out[1:, 1:] |= mask[:-1, :-1]\n    out[:-1, 1:] |= mask[1:, :-1]\n    out[1:, :-1] |= mask[:-1, 1:]\n    return out\n\n\ndef _forbid_coords(forbidden: np.ndarray, coords: np.ndarray) -> None:\n    \"\"\"Mark coords and their 8-neighbors as forbidden (in-place).\"\"\"\n    cell_mask = np.zeros_like(forbidden)\n    cell_mask[coords[:, 0], coords[:, 1]] = True\n    forbidden |= _dilate8(cell_mask)\n\n\ndef _gen_layout(h: int, w: int, n_slots: int, n_units: int) -> list[dict] | None:\n===== /home/lixinyu/snap/new/ARC_code/eval/21897d95.py\nfrom __future__ import annotations\n\nfrom collections import Counter, deque\nimport numpy as np\n\nfrom arc_utils import label_mask\nimport random\n\n\nDIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))\nUP = (-1, 0)\nDOWN = (1, 0)\nRIGHT = (0, 1)\n\n\nclass _DSU:\n    def __init__(self, n: int):\n        self.parent = list(range(int(n)))\n\n    def find(self, x: int) -> int:\n        x = int(x)\n        while self.parent[x] != x:\n            self.parent[x] = self.parent[self.parent[x]]\n            x = self.parent[x]\n        return int(x)\n\n    def union(self, a: int, b: int) -> None:\n        ra = self.find(a)\n        rb = self.find(b)\n        if ra != rb:\n            self.parent[rb] = ra\n\n\ndef _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:\n    return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])\n\n\ndef _opp(d: tuple[int, int]) -> tuple[int, int]:\n    return (-int(d[0]), -int(d[1]))\n\n\ndef _stem_from_branches(branches: list[tuple[int, int]]) -> tuple[int, int]:\n    assert len(branches) == 3\n    branch_set = set(branches)\n    for d in branches:\n        if _opp(d) not in branch_set:\n            return d\n    raise AssertionError(\"T marker has no single stem\")\n\n\ndef _parse_tetromino(cells: set[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int], list[tuple[int, int]]] | None:\n    if len(cells) != 4:\n        return None\n    for r, c in cells:\n        branches = [(dr, dc) for dr, dc in DIRS if (r + dr, c + dc) in cells]\n        if len(branches) != 3:\n            continue\n        stem = _stem_from_branches(branches)\n        expected = {(r, c), (r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)}\n        expected.remove((r - stem[0], c - stem[1]))\n        if cells == expected:\n            bar = [d for d in branches if d != stem]\n            assert len(bar) == 2 and bar[0] == _opp(bar[1])\n            return (int(r), int(c)), stem, bar\n    return None\n\n\ndef _label_base_components(g: np.ndarray, control: np.ndarray) -> tuple[np.ndarray, list[int], list[int]]:\n    comp_id = np.full(g.shape, -1, dtype=int)\n    comp_colors: list[int] = []\n    comp_areas: list[int] = []\n    cid = 0\n    for col in sorted(set(map(int, g.ravel())) - {1}):\n        labels, n_labels = label_mask((g == col) & (~control), connectivity=4)\n        for k in range(1, int(n_labels) + 1):\n            coords = np.argwhere(labels == k)\n            if coords.size == 0:\n                continue\n            for rr, cc in coords:\n                comp_id[int(rr), int(cc)] = cid\n            comp_colors.append(int(col))\n            comp_areas.append(int(len(coords)))\n            cid += 1\n    return comp_id, comp_colors, comp_areas\n\n\ndef _solve_unrotated(g: np.ndarray) -> np.ndarray:\n    labels_1, n_1 = label_mask(g == 1, connectivity=4)\n    one_components = {\n        k: {tuple(map(int, xy)) for xy in np.argwhere(labels_1 == k)}\n        for k in range(1, int(n_1) + 1)\n    }\n    one_sizes = {k: len(cells) for k, cells in one_components.items()}\n\n    markers: list[dict] = []\n    used_ones: set[tuple[int, int]] = set()\n    control = np.zeros(g.shape, dtype=bool)\n\n    for cells in one_components.values():\n        parsed = _parse_tetromino(cells)\n        if parsed is None:\n            continue\n        center, stem, bar = parsed\n        markers.append({\"kind\": \"normal\", \"center\": center, \"stem\": stem, \"bar\": bar, \"cells\": cells})\n        used_ones |= cells\n        for r, c in cells:\n            control[r, c] = True\n\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n            if int(g[r, c]) == 1:\n                continue\n            branches: list[tuple[int, int]] = []\n            cells: list[tuple[int, int]] = []\n            ok = True\n            for d in DIRS:\n                rr, cc = r + d[0], c + d[1]\n                if not _in_bounds(g.shape, rr, cc) or int(g[rr, cc]) != 1:\n                    continue\n                label = int(labels_1[rr, cc])\n                if one_sizes[label] == 1 and (rr, cc) not in used_ones:\n                    branches.append(d)\n                    cells.append((rr, cc))\n                else:\n                    ok = False\n            if ok and len(branches) == 3:\n                stem = _stem_from_branches(branches)\n                bar = [d for d in branches if d != stem]\n                assert len(bar) == 2 and bar[0] == _opp(bar[1])\n                marker_cells = set(cells) | {(int(r), int(c))}\n                markers.append(\n                    {\n                        \"kind\": \"colored\",\n                        \"center\": (int(r), int(c)),\n                        \"stem\": stem,\n                        \"bar\": bar,\n                        \"cells\": marker_cells,\n                        \"target_color\": int(g[r, c]),\n                    }\n                )\n                used_ones |= set(cells)\n                for rr, cc in marker_cells:\n                    control[rr, cc] = True\n\n    all_one_cells = {tuple(map(int, xy)) for xy in np.argwhere(g == 1)}\n    assert all_one_cells == used_ones, \"all color-1 pixels must belong to a T control marker\"\n\n    for col in sorted(set(map(int, g.ravel())) - {1}):\n        labels, n_labels = label_mask((g == col) & (~control), connectivity=4)\n        for k in range(1, int(n_labels) + 1):\n            coords = np.argwhere(labels == k)\n            if len(coords) > 5:\n                continue\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            if len(coords) == (int(r1) - int(r0) + 1) * (int(c1) - int(c0) + 1):\n                continue\n            cells = {tuple(map(int, xy)) for xy in coords}\n            markers.append({\"kind\": \"small\", \"cells\": cells})\n            for rr, cc in cells:\n                control[rr, cc] = True\n\n    comp_id, comp_colors, comp_areas = _label_base_components(g, control)\n    assert comp_colors, \"at least one base region is required\"\n    dsu = _DSU(len(comp_colors))\n\n    def first_component_from(center: tuple[int, int], direction: tuple[int, int], start: int) -> int | None:\n        r, c = center\n        step = int(start)\n        while True:\n            rr = r + direction[0] * step\n            cc = c + direction[1] * step\n            if not _in_bounds(g.shape, rr, cc):\n                return None\n            if comp_id[rr, cc] >= 0:\n                return int(comp_id[rr, cc])\n            step += 1\n\n    def adjacent_component_counts(cells: set[tuple[int, int]]) -> Counter:\n        counts: Counter = Counter()\n        for r, c in cells:\n            for dr, dc in DIRS:\n                rr, cc = r + dr, c + dc\n                if _in_bounds(g.shape, rr, cc) and comp_id[rr, cc] >= 0:\n                    counts[int(comp_id[rr, cc])] += 1\n        return counts\n\n    for marker in markers:\n        if marker[\"kind\"] in {\"normal\", \"colored\"}:\n            center = marker[\"center\"]\n            stem = marker[\"stem\"]\n            dest = first_component_from(center, stem, start=2)\n            assert dest is not None, \"T marker must point at a destination region\"\n\n            source_parts: list[int] = []\n            for bar_dir in marker[\"bar\"]:\n                rr = center[0] + stem[0] + bar_dir[0]\n                cc = center[1] + stem[1] + bar_dir[1]\n                assert _in_bounds(g.shape, rr, cc) and comp_id[rr, cc] >= 0\n                source_parts.append(int(comp_id[rr, cc]))\n            source = source_parts[0]\n            for part in source_parts[1:]:\n                assert comp_colors[part] == comp_colors[source], \"T source diagonals must share a color\"\n                dsu.union(source, part)\n\n            for comp in adjacent_component_counts(marker[\"cells\"]):\n                if comp_colors[comp] == comp_colors[source]:\n                    dsu.union(source, comp)\n            marker[\"dest_comp\"] = dest\n            marker[\"source_comp\"] = source\n        else:\n            counts = adjacent_component_counts(marker[\"cells\"])\n            assert counts, \"small marker must touch its owner region\"\n            owner = max(counts, key=lambda c: (counts[c], comp_areas[c]))\n            for comp in counts:\n                if comp_colors[comp] == comp_colors[owner]:\n                    dsu.union(owner, comp)\n            marker[\"source_comp\"] = owner\n\n    root_color: dict[int, int] = {}\n    for i, col in enumerate(comp_colors):\n        root = dsu.find(i)\n        root_color.setdefault(root, int(col))\n        assert root_color[root] == int(col), \"merged region colors must match\"\n\n    final_color = dict(root_color)\n    for marker in markers:\n        if marker[\"kind\"] not in {\"normal\", \"colored\"}:\n            marker[\"source\"] = dsu.find(marker[\"source_comp\"])\n            continue\n        dest = dsu.find(marker[\"dest_comp\"])\n        source = dsu.find(marker[\"source_comp\"])\n        marker[\"source\"] = source\n        replacement = int(marker[\"target_color\"]) if marker[\"kind\"] == \"colored\" else int(root_color[source])\n        assert final_color[dest] in {root_color[dest], replacement}, \"conflicting T controls for one region\"\n        final_color[dest] = replacement\n\n    out = np.full(g.shape, -1, dtype=int)\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n            cid = int(comp_id[r, c])\n            if cid >= 0:\n                out[r, c] = int(final_color[dsu.find(cid)])\n\n    for marker in markers:\n        color = int(final_color[marker[\"source\"]])\n        for r, c in marker[\"cells\"]:\n            out[r, c] = color\n\n    assert bool(np.all(out >= 0)), \"all cells must be assigned\"\n    return out\n\n\ndef _find_l9_orientation(g: np.ndarray) -> str | None:\n    \"\"\"Find a 5-cell L-shaped color-9 marker and return its corner position.\"\"\"\n    mask9 = g == 9\n    if not mask9.any():\n        return None\n    labels, n = label_mask(mask9, connectivity=4)\n    for k in range(1, int(n) + 1):\n===== /home/lixinyu/snap/new/ARC_code/train/99caaf76.py\nfrom __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import crop_bbox, find_components, get_bg, paste\nimport random\n\n\n_CROSS_MASK = np.array(\n    [\n        [False, True, False],\n        [True, True, True],\n        [False, True, False],\n    ],\n    dtype=bool,\n)\n\n\ndef _marker_color(g: np.ndarray, bg: int) -> int:\n    counts = Counter(int(v) for v in g[g != int(bg)])\n    assert counts, \"expected foreground pixels\"\n    max_count = max(counts.values())\n    candidates = [color for color, count in counts.items() if count == max_count]\n    assert len(candidates) == 1, \"expected a unique repeated marker color\"\n    marker = int(candidates[0])\n    assert counts[marker] % 4 == 0, \"marker pixels should form 4-pixel sprites\"\n    return marker\n\n\ndef _block_kind(block: np.ndarray, bg: int, marker: int) -> str:\n    assert block.shape == (3, 3), \"expected 3x3 half-block\"\n    marker_mask = block == int(marker)\n    other_mask = (block != int(bg)) & ~marker_mask\n\n    if int(marker_mask.sum()) == 4 and not bool(other_mask.any()):\n        return \"marker\"\n\n    if not bool(marker_mask.any()) and int(other_mask.sum()) == 5:\n        assert np.array_equal(other_mask, _CROSS_MASK), \"expected a 5-pixel cross\"\n        return \"cross\"\n\n    raise AssertionError(\"expected either a marker block or a colored cross block\")\n\n\ndef _paste_checked(out: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:\n    h, w = patch.shape\n    target = out[int(r0) : int(r0) + h, int(c0) : int(c0) + w]\n    assert target.shape == patch.shape, \"target patch must fit in the grid\"\n    assert not bool(np.any((target != int(bg)) & (patch != int(bg)))), \"moved objects must not overlap\"\n    paste(out, patch, int(r0), int(c0), transparent=int(bg))\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each marked cross object away from its marker to the grid edge while rotating the colored cross 180 degrees.\n\n    Input structure:\n    - The background is the dominant color.\n    - Each 8-connected foreground object has nine pixels: a 4-pixel marker-color\n      sprite attached to a 5-pixel non-marker colored cross.\n    - Each object bbox is either 3x6 or 6x3, so the marker sprite is on exactly\n      one side of the cross.\n\n    Rule:\n    - Move the whole object straight away from its marker side until the object\n      bbox touches the corresponding grid edge.\n    - Keep the marker sprite unchanged within the object.\n    - Rotate the 3x3 colored cross block by 180 degrees before placing it.\n\n    Key insight:\n    The marker sprite is a directional tail; the cross is the leading payload,\n    and only that payload turns around during the slide to the edge.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = get_bg(g)\n    marker = _marker_color(g, bg)\n\n    out = np.full_like(g, int(bg))\n    objects = find_components(g, bg=bg, connectivity=8, monochromatic=False)\n    assert objects, \"expected at least one composite object\"\n\n    for obj in objects:\n        assert int(obj[\"area\"]) == 9, \"each composite should contain 9 foreground pixels\"\n        r0, c0, _r1, _c1 = obj[\"bbox\"]\n        patch = crop_bbox(g, obj[\"bbox\"])\n        h, w = patch.shape\n        moved = patch.copy()\n\n        if (h, w) == (3, 6):\n            left = patch[:, :3]\n            right = patch[:, 3:]\n            left_kind = _block_kind(left, bg, marker)\n            right_kind = _block_kind(right, bg, marker)\n            assert {left_kind, right_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n\n            if left_kind == \"marker\":\n                moved[:, 3:] = np.rot90(right, 2)\n                target_r, target_c = int(r0), W - w\n            else:\n                moved[:, :3] = np.rot90(left, 2)\n                target_r, target_c = int(r0), 0\n\n        elif (h, w) == (6, 3):\n            top = patch[:3, :]\n            bottom = patch[3:, :]\n            top_kind = _block_kind(top, bg, marker)\n            bottom_kind = _block_kind(bottom, bg, marker)\n            assert {top_kind, bottom_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n\n            if top_kind == \"marker\":\n                moved[3:, :] = np.rot90(bottom, 2)\n                target_r, target_c = H - h, int(c0)\n            else:\n                moved[:3, :] = np.rot90(top, 2)\n                target_r, target_c = 0, int(c0)\n\n        else:\n            raise AssertionError(\"each composite bbox should be 3x6 or 6x3\")\n\n        _paste_checked(out, moved, target_r, target_c, bg)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Colors.\n_GEN_BG = 8\n_GEN_MARKER = 1\n_GEN_CENTER = 4\n_GEN_ARM_COLORS = [0, 2, 3, 5, 6, 7, 9]\n\n# Object layout.\n_GEN_SIDES = [\"left\", \"right\", \"top\", \"bottom\"]\n_GEN_MARKER_COORDS = {\n    \"left\": [(0, 0), (1, 1), (1, 2), (2, 0)],\n    \"right\": [(0, 2), (1, 0), (1, 1), (2, 2)],\n    \"top\": [(0, 0), (0, 2), (1, 1), (2, 1)],\n    \"bottom\": [(0, 1), (1, 1), (2, 0), (2, 2)],\n}\n_GEN_ARM_POSITIONS = [(0, 1), (1, 0), (1, 2), (2, 1)]\n\n# Canvas and placement bounds.\n_GEN_OBJECT_COUNT_RANGE = (1, 4)\n_GEN_MAX_SIDE = 18\n_GEN_MIN_SIDE_BY_OBJECT_COUNT = {1: 8, 2: 8, 3: 10, 4: 12}\n_GEN_PADDING = 1\n_GEN_EDGE_GAP = 2\n_GEN_HORIZONTAL_SIZE = (3, 6)\n_GEN_VERTICAL_SIZE = (6, 3)\n\n# Retry limits.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_marker_block(side: str) -> np.ndarray:\n    block = np.full((3, 3), _GEN_BG, dtype=int)\n    for r, c in _GEN_MARKER_COORDS[side]:\n        block[r, c] = _GEN_MARKER\n    return block\n\n\ndef _gen_cross_block() -> np.ndarray:\n    block = np.full((3, 3), _GEN_BG, dtype=int)\n    block[1, 1] = _GEN_CENTER\n    for (r, c), color in zip(_GEN_ARM_POSITIONS, random.sample(_GEN_ARM_COLORS, 4)):\n        block[r, c] = color\n    return block\n\n\ndef _gen_composite(side: str, cross: np.ndarray) -> np.ndarray:\n    marker = _gen_marker_block(side)\n    if side == \"left\":\n        return np.concatenate([marker, cross], axis=1)\n    if side == \"right\":\n        return np.concatenate([cross, marker], axis=1)\n    if side == \"top\":\n        return np.concatenate([marker, cross], axis=0)\n    return np.concatenate([cross, marker], axis=0)\n\n\ndef _gen_input_from_output(side: str, patch: np.ndarray) -> np.ndarray:\n    out = patch.copy()\n    if side == \"left\":\n        out[:, 3:] = np.rot90(out[:, 3:], 2)\n    elif side == \"right\":\n        out[:, :3] = np.rot90(out[:, :3], 2)\n    elif side == \"top\":\n        out[3:, :] = np.rot90(out[3:, :], 2)\n    else:\n        out[:3, :] = np.rot90(out[:3, :], 2)\n    return out\n\n\ndef _gen_can_place(canvas: np.ndarray, patch: np.ndarray, r0: int, c0: int, padding: int) -> bool:\n    h, w = patch.shape\n    H, W = canvas.shape\n    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:\n        return False\n    for dr, dc in np.argwhere(patch != _GEN_BG):\n        r = int(r0 + dr)\n        c = int(c0 + dc)\n        r1 = max(0, r - padding)\n        r2 = min(H, r + padding + 1)\n        c1 = max(0, c - padding)\n        c2 = min(W, c + padding + 1)\n        if np.any(canvas[r1:r2, c1:c2] != _GEN_BG):\n            return False\n    return True\n\n\ndef _gen_output_positions(side: str, H: int, W: int) -> list[tuple[int, int]]:\n    if side == \"left\":\n        return [(r, W - _GEN_HORIZONTAL_SIZE[1]) for r in range(H - _GEN_EDGE_GAP)]\n    if side == \"right\":\n        return [(r, 0) for r in range(H - _GEN_EDGE_GAP)]\n    if side == \"top\":\n        return [(H - _GEN_VERTICAL_SIZE[0], c) for c in range(W - _GEN_EDGE_GAP)]\n    return [(0, c) for c in range(W - _GEN_EDGE_GAP)]\n\n\ndef _gen_input_positions(side: str, H: int, W: int, target_r: int, target_c: int) -> list[tuple[int, int]]:\n    if side == \"left\":\n        return [(target_r, c) for c in range(0, W - _GEN_HORIZONTAL_SIZE[1] - _GEN_PADDING)]\n    if side == \"right\":\n        return [(target_r, c) for c in range(_GEN_EDGE_GAP, W - _GEN_HORIZONTAL_SIZE[1] + _GEN_PADDING)]\n    if side == \"top\":\n        return [(r, target_c) for r in range(0, H - _GEN_VERTICAL_SIZE[0] - _GEN_PADDING)]\n    return [(r, target_c) for r in range(_GEN_EDGE_GAP, H - _GEN_VERTICAL_SIZE[0] + _GEN_PADDING)]\n\n\ndef _gen_canvas_shape(n_obj: int) -> tuple[int, int]:\n    min_side = _GEN_MIN_SIDE_BY_OBJECT_COUNT[int(n_obj)]\n    return random.randint(min_side, _GEN_MAX_SIDE), random.randint(min_side, _GEN_MAX_SIDE)\n\n\ndef _gen_place_output_objects(expected: np.ndarray, n_obj: int) -> list[tuple[str, np.ndarray, int, int]] | None:\n    H, W = expected.shape\n    objects = []\n\n    for _ in range(n_obj):\n        sides = _GEN_SIDES[:]\n        random.shuffle(sides)\n        placed = False\n        for side in sides:\n            cross = _gen_cross_block()\n            patch = _gen_composite(side, cross)\n            positions = _gen_output_positions(side, H, W)\n            random.shuffle(positions)\n            for r0, c0 in positions:\n                if _gen_can_place(expected, patch, r0, c0, padding=_GEN_PADDING):\n                    paste(expected, patch, int(r0), int(c0), transparent=_GEN_BG)\n                    objects.append((side, patch, r0, c0))\n                    placed = True\n                    break\n            if placed:\n                break\n        if not placed:\n===== /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py\nfrom __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox, components_mask, paste, random_free_location\nimport random\n\n\ndef _split_panels(g: np.ndarray) -> tuple[list[np.ndarray], set[int]]:\n    h, w = g.shape\n    candidates: list[tuple[list[np.ndarray], set[int]]] = []\n\n    for horizontal in (False, True):\n        dim = w if horizontal else h\n        for n in range(3, dim + 1):\n            if dim % n:\n                continue\n            ph, pw = (h, w // n) if horizontal else (h // n, w)\n            if ph < 2 or pw < 2:\n                continue\n            if horizontal:\n                panels = [g[:, i * pw : (i + 1) * pw] for i in range(n)]\n            else:\n                panels = [g[i * ph : (i + 1) * ph, :] for i in range(n)]\n\n            template = panels[-1]\n            template_colors = set(map(int, template.ravel()))\n            diff_colors: set[int] = set()\n            diff_counts = []\n            for panel in panels[:-1]:\n                diff = panel != template\n                diff_counts.append(int(diff.sum()))\n                diff_colors.update(map(int, panel[diff].ravel()))\n\n            if not diff_colors or not all(diff_counts):\n                continue\n            if diff_colors & template_colors:\n                continue\n            occurrences = {\n                color: sum(bool(np.any(panel == color)) for panel in panels[:-1])\n                for color in diff_colors\n            }\n            if not all(count >= 2 for count in occurrences.values()):\n                continue\n            candidates.append((panels, diff_colors))\n\n    assert len(candidates) == 1\n    return candidates[0]\n\n\ndef _intervals(line: np.ndarray) -> list[tuple[int, int]]:\n    out: list[tuple[int, int]] = []\n    i = 0\n    while i < len(line):\n        if not line[i]:\n            i += 1\n            continue\n        j = i\n        while j + 1 < len(line) and line[j + 1]:\n            j += 1\n        out.append((i, j))\n        i = j + 1\n    return out\n\n\ndef _shift_intervals(\n    intervals: list[tuple[int, int]], step: int, length: int\n) -> list[tuple[int, int]]:\n    shifted = []\n    for start, end in intervals:\n        new_start = start + step\n        new_end = end + step\n        assert 0 <= new_start <= new_end < length\n        shifted.append((new_start, new_end))\n    return shifted\n\n\ndef _is_prefix(shorter: list[tuple[int, int]], longer: list[tuple[int, int]]) -> bool:\n    return len(shorter) <= len(longer) and all(a == b for a, b in zip(shorter, longer))\n\n\ndef _required_bbox(mask: np.ndarray) -> tuple[int, int, int, int]:\n    b = bbox(mask)\n    assert b is not None\n    return b\n\n\ndef _motion_axis(a: np.ndarray, b: np.ndarray) -> tuple[int, int]:\n    ar0, ac0, ar1, ac1 = _required_bbox(a)\n    br0, bc0, br1, bc1 = _required_bbox(b)\n    row_motion = abs(br0 - ar0) + abs(br1 - ar1)\n    col_motion = abs(bc0 - ac0) + abs(bc1 - ac1)\n    assert row_motion != col_motion\n\n    if row_motion > col_motion:\n        deltas = [br0 - ar0, br1 - ar1]\n        axis = 0\n    else:\n        deltas = [bc0 - ac0, bc1 - ac1]\n        axis = 1\n    nonzero = [delta for delta in deltas if delta]\n    assert nonzero and all((delta > 0) == (nonzero[0] > 0) for delta in nonzero)\n    direction = 1 if nonzero[0] > 0 else -1\n    return axis, direction\n\n\ndef _draw_intervals(mask: np.ndarray, axis: int, line: int, intervals: list[tuple[int, int]]) -> None:\n    for start, end in intervals:\n        if axis == 0:\n            mask[start : end + 1, line] = True\n        else:\n            mask[line, start : end + 1] = True\n\n\ndef _extrapolate_mask(a: np.ndarray, b: np.ndarray) -> np.ndarray:\n    assert a.any() and b.any()\n    assert not np.array_equal(a, b)\n\n    axis, direction = _motion_axis(a, b)\n    added = b & ~a\n    assert added.any()\n    added_coords = np.argwhere(added)\n    extent = int(added_coords[:, axis].max() - added_coords[:, axis].min() + 1)\n    global_step = direction * extent\n\n    out = np.zeros_like(b, dtype=bool)\n    line_count = b.shape[1 - axis]\n    length = b.shape[axis]\n    for line in range(line_count):\n        if axis == 0:\n            a_intervals = _intervals(a[:, line])\n            b_intervals = _intervals(b[:, line])\n        else:\n            a_intervals = _intervals(a[line, :])\n            b_intervals = _intervals(b[line, :])\n\n        if not a_intervals and not b_intervals:\n            next_intervals: list[tuple[int, int]] = []\n        elif a_intervals and len(a_intervals) == len(b_intervals):\n            next_intervals = []\n            for (a0, a1), (b0, b1) in zip(a_intervals, b_intervals):\n                new_start = b0 + (b0 - a0)\n                new_end = b1 + (b1 - a1)\n                assert 0 <= new_start <= new_end < length\n                next_intervals.append((new_start, new_end))\n        elif a_intervals and _is_prefix(a_intervals, b_intervals):\n            extra_count = len(b_intervals) - len(a_intervals)\n            assert 0 < extra_count <= len(a_intervals)\n            previous = a_intervals[-extra_count:]\n            extra = b_intervals[-extra_count:]\n            steps = {\n                end_new - end_old\n                for old, new in zip(previous, extra)\n                for end_old, end_new in zip(old, new)\n            }\n            assert len(steps) == 1\n            step = steps.pop()\n            assert step\n            next_intervals = list(b_intervals) + _shift_intervals(extra, step, length)\n        elif not a_intervals and b_intervals:\n            next_intervals = list(b_intervals) + _shift_intervals(\n                b_intervals, global_step, length\n            )\n        else:\n            raise AssertionError\n\n        _draw_intervals(out, axis, line, next_intervals)\n\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Predict the next panel in a framed sequence by continuing each scheduled colored interval.\n\n    Input structure\n    - The grid is made from three or more equal panels in one row or one column.\n    - The final input panel is the static target template; every earlier panel differs from it only by dynamic colors absent from the template.\n    - Each dynamic color appears in a regular temporal schedule across the earlier panels.\n\n    Rule\n    - Keep the final template panel as the output canvas.\n    - For every dynamic color whose schedule reaches the next panel, compare its last two appearances.\n    - Extrapolate each one-dimensional interval along the color's changing row or column axis and paint that predicted mask.\n\n    Key insight\n    - The task is not asking for the last visible panel, but for the next frame after the blank/template slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    panels, diff_colors = _split_panels(g)\n    template = panels[-1]\n    prior = panels[:-1]\n    next_time = len(prior)\n\n    predictions: list[tuple[int, np.ndarray]] = []\n    for color in diff_colors:\n        times = [i for i, panel in enumerate(prior) if np.any(panel == color)]\n        assert len(times) >= 2\n        gaps = [b - a for a, b in zip(times, times[1:])]\n        assert len(set(gaps)) == 1\n        period = gaps[0]\n        if next_time - times[-1] != period:\n            continue\n\n        previous = prior[times[-2]] == color\n        current = prior[times[-1]] == color\n        predictions.append((color, _extrapolate_mask(previous, current)))\n\n    assert predictions\n    occupied = np.zeros_like(template, dtype=bool)\n    for _color, mask in predictions:\n        assert not np.any(occupied & mask)\n        occupied |= mask\n\n    out = template.copy()\n    for color, mask in predictions:\n        out[mask] = color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, orientation, and color sampling.\nPANEL_SIZE_MIN, PANEL_SIZE_MAX = 5, 11\nPANEL_COUNT_CHOICES, ORIENTATION_CHOICES = (3, 5), (False, True)\nCOLOR_POOL, TOTAL_COLOR_CHOICES, MOTION_AXIS_CHOICES = range(10), (4, 5), (0, 1)\n\n# Template decoration density and symmetry.\nTEMPLATE_MIN_DECO_CELLS = 4\nTEMPLATE_DECO_MIN_RATIO, TEMPLATE_DECO_MAX_RATIO = 0.10, 0.30\n\n# Blob motif and growth bounds.\nBLOB_GROWTH_MIN, BLOB_GROWTH_MAX = 1, 4\nBLOB_MAX_INITIAL_CELLS, BLOB_MAX_COMPONENTS = 7, 2\nBLOB_MAX_LINE_COUNT, BLOB_MAX_WIDTH = 3, 3\nBLOB_DIRECTIONS = (-1, 1)\n\n# Dynamic-color schedules.\nSHORT_PRIOR_COUNT, MAX_DYNAMIC_COLORS = 2, 3\nSCHEDULE_ALWAYS_2 = {\"period\": 1, \"times\": [0, 1], \"scheduled\": True}\nSCHEDULE_ALWAYS_4 = {\"period\": 1, \"times\": [0, 1, 2, 3], \"scheduled\": True}\nSCHEDULE_EVEN_4 = {\"period\": 2, \"times\": [0, 2], \"scheduled\": True}\nSCHEDULE_FIRST3_4 = {\"period\": 1, \"times\": [0, 1, 2], \"scheduled\": False}\nSCHEDULE_ODD_4 = {\"period\": 2, \"times\": [1, 3], \"scheduled\": False}\nSCHEDULE_SECOND_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4)\nSCHEDULE_THIRD_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4, SCHEDULE_FIRST3_4, SCHEDULE_ODD_4)\n\n# Placement and retry limits.\nMASK_TRANSPARENT, PLACEMENT_BORDER = 0, 1\nGENERATION_RETRIES = 300\n\ndef _sym_orbits(h: int, w: int) -> list[list[tuple[int, int]]]:\n    seen: set[tuple[int, int]] = set()\n    orbits: list[list[tuple[int, int]]] = []\n    for r in range(h):\n        for c in range(w):\n            if r not in (0, h - 1) and c not in (0, w - 1):\n                continue\n            if (r, c) in seen:\n                continue\n            orbit = sorted({(r, c), (r, w - 1 - c), (h - 1 - r, c), (h - 1 - r, w - 1 - c)})\n            seen.update(orbit)\n===== /home/lixinyu/snap/new/ARC_code/eval/aa4ec2a5.py\nfrom __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, find_components, get_bg, is_contiguous\nimport random\n\n\ndef _coords_mask(shape: tuple[int, int], coords: np.ndarray) -> np.ndarray:\n    mask = np.zeros(shape, dtype=bool)\n    mask[coords[:, 0], coords[:, 1]] = True\n    return mask\n\n\ndef _interior_holes(mask: np.ndarray, coords: np.ndarray) -> list[np.ndarray]:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    sub = mask[r0 : r1 + 1, c0 : c1 + 1]\n\n    holes: list[np.ndarray] = []\n    for hole in components_mask(~sub, connectivity=4):\n        touches_edge = np.any(\n            (hole[:, 0] == 0)\n            | (hole[:, 1] == 0)\n            | (hole[:, 0] == sub.shape[0] - 1)\n            | (hole[:, 1] == sub.shape[1] - 1)\n        )\n        if not bool(touches_edge):\n            shifted = hole.copy()\n            shifted[:, 0] += int(r0)\n            shifted[:, 1] += int(c0)\n            holes.append(shifted)\n    return holes\n\n\ndef _outline_mask(mask: np.ndarray) -> np.ndarray:\n    h, w = mask.shape\n    outline = np.zeros_like(mask, dtype=bool)\n    rows, cols = np.where(mask)\n    for dr in (-1, 0, 1):\n        for dc in (-1, 0, 1):\n            if dr == 0 and dc == 0:\n                continue\n            rr = rows + dr\n            cc = cols + dc\n            ok = (0 <= rr) & (rr < h) & (0 <= cc) & (cc < w)\n            outline[rr[ok], cc[ok]] = True\n    outline &= ~mask\n    return outline\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Add red outlines around objects, and mark enclosed holes inside hollow objects.\n\n    Input structure:\n    - A mostly uniform background contains one or more 4-connected foreground objects.\n    - Some objects may enclose 4-connected background holes inside their bbox.\n\n    Rule:\n    - For every foreground component, draw a one-cell 8-neighborhood outline in red (2).\n    - If a component has enclosed background holes, recolor the component to teal (8).\n    - Fill those enclosed holes with magenta (6) before drawing the outline.\n\n    Key insight: Holes are treated as part of the object for outlining, while only objects\n    that actually enclose holes get the teal/magenta interior recoloring.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    out = g.copy()\n\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        coords = comp[\"coords\"]\n        mask = _coords_mask(g.shape, coords)\n        holes = _interior_holes(mask, coords)\n\n        solid = mask.copy()\n        if holes:\n            out[mask] = 8\n            for hole in holes:\n                out[hole[:, 0], hole[:, 1]] = 6\n                solid[hole[:, 0], hole[:, 1]] = True\n\n        outline = _outline_mask(solid)\n        out[outline & (out == bg)] = 2\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# ── Configuration ────────────────────────────────────────────────────────────\n# Canvas / grid bounds\nGRID_H_RANGE = (15, 28)\nGRID_W_RANGE = (15, 27)\nBG_COLOR = 4\nFG_COLOR = 1\n\n# Component counts\nCOMP_COUNT_RANGE = (3, 4)          # total components per grid\nHOLLOW_COUNT_RANGE = (1, 2)        # how many are hollow (capped by total - 1)\n\n# Polyomino construction (solid shapes)\nPOLY_NUM_RECTS_RANGE = (2, 3)      # overlapping rectangles per polyomino\nPOLY_RECT_DIM_RANGE = (2, 7)       # h/w range for each rectangle\nPOLY_CANVAS_PAD = 4                # extra canvas margin during construction\nPOLY_PLACEMENT_RETRIES = 50        # retries for overlapping subsequent rects\nPOLY_GEN_RETRIES = 30              # retries to make one valid polyomino\n\n# Small solid shapes\nSMALL_SHAPE_PROB = 0.2             # probability of choosing a small (1-4 cell) solid\nSMALL_SHAPE_SIZE_RANGE = (1, 4)\n\n# Hollow component construction\nHOLE_VALID_AREAS = [2, 3, 4, 6, 8, 9, 12, 16]  # allowed rectangular hole areas\nHOLE_DIM_MAX = 4                   # max dimension of hole rectangle\nHOLLOW_PAD_RANGE = (1, 3)          # padding around hole on each side\nHOLLOW_MAX_NOTCHES = 2             # 0-2 corner notches\nHOLLOW_EXTENSION_PROB = 0.5        # probability of adding an L/T extension\nHOLLOW_EXT_H_RANGE = (1, 4)       # height range for extension\nHOLLOW_EXT_SIDE_W_RANGE = (1, 3)  # width range for left/right extensions\nHOLLOW_HOLE_SEARCH_RETRIES = 200   # retries to find a valid hole position\nHOLLOW_GEN_RETRIES = 50            # retries to build one hollow component\nHOLLOW_MIN_AREA = 10               # minimum foreground cells for hollow component\n\n# Placement\nCHEBYSHEV_MIN = 3                  # minimum Chebyshev distance between any two component cells\nBORDER_MIN = 1                     # minimum clearance from grid edge\nPLACEMENT_RETRIES = 300            # random placement attempts per component\n\n# Top-level generation\nGEN_OUTER_RETRIES = 300            # retries for the whole generation\n\n\n# ── Helpers ──────────────────────────────────────────────────────────────────\n\ndef _crop_mask(mask):\n    \"\"\"Crop a boolean mask to its tight bounding box. Returns None if empty.\"\"\"\n    rows, cols = np.where(mask)\n    if len(rows) == 0:\n        return None\n    return mask[rows.min():rows.max() + 1, cols.min():cols.max() + 1]\n\n\ndef _has_interior_hole(mask):\n    \"\"\"Return True if the boolean mask contains at least one 4-connected interior bg region.\"\"\"\n    h, w = mask.shape\n    for bg_reg in components_mask(~mask, connectivity=4):\n        touches_edge = np.any(\n            (bg_reg[:, 0] == 0) | (bg_reg[:, 1] == 0) |\n            (bg_reg[:, 0] == h - 1) | (bg_reg[:, 1] == w - 1))\n        if not touches_edge:\n            return True\n    return False\n\n\ndef _rect_dims(area):\n    \"\"\"Return (h, w) for a rectangle with given area, randomized among valid factorizations.\"\"\"\n    factors = [(i, area // i) for i in range(1, int(area ** 0.5) + 1)\n               if area % i == 0 and i <= HOLE_DIM_MAX and area // i <= HOLE_DIM_MAX]\n    if not factors:\n        return None\n    h, w = random.choice(factors)\n    if random.random() < 0.5:\n        h, w = w, h\n    return h, w\n\n\ndef _chebyshev_conflict(rows_a, cols_a, pr, pc, pm):\n    \"\"\"Return True if any cell in (rows_a, cols_a) is within CHEBYSHEV_MIN of any cell in pm\n    placed at (pr, pc). Uses a bbox pre-filter for speed.\"\"\"\n    rows_b, cols_b = np.where(pm)\n    rows_b, cols_b = rows_b + pr, cols_b + pc\n    for ra, ca in zip(rows_a, cols_a):\n        if np.min(np.maximum(np.abs(rows_b - ra), np.abs(cols_b - ca))) < CHEBYSHEV_MIN:\n            return True\n    return False\n\n\n# ── Shape generators ─────────────────────────────────────────────────────────\n\ndef _make_polyomino():\n    \"\"\"Generate an irregular polyomino from overlapping axis-aligned rectangles.\n    Returns a boolean mask (tight bounding box), or None on failure.\"\"\"\n    num_rects = random.randint(*POLY_NUM_RECTS_RANGE)\n    rects = [(random.randint(*POLY_RECT_DIM_RANGE), random.randint(*POLY_RECT_DIM_RANGE))\n             for _ in range(num_rects)]\n\n    canvas_h = sum(r[0] for r in rects) + POLY_CANVAS_PAD\n    canvas_w = sum(r[1] for r in rects) + POLY_CANVAS_PAD\n    mask = np.zeros((canvas_h, canvas_w), dtype=bool)\n    r0, c0 = 2, 2\n    mask[r0:r0 + rects[0][0], c0:c0 + rects[0][1]] = True\n\n    for i in range(1, num_rects):\n        rh, rw = rects[i]\n        for _ in range(POLY_PLACEMENT_RETRIES):\n            nr = random.randint(max(0, r0 - rh + 1), r0 + rects[0][0] + 2)\n            nc = random.randint(max(0, c0 - rw + 1), c0 + rects[0][1] + 2)\n            if nr + rh > canvas_h or nc + rw > canvas_w or nr < 0 or nc < 0:\n                continue\n            if mask[nr:nr + rh, nc:nc + rw].any():\n                mask[nr:nr + rh, nc:nc + rw] = True\n                break\n\n    mask = _crop_mask(mask)\n    if mask is None or not is_contiguous(mask.astype(int), background=0, connectivity=4):\n        return None\n    return mask\n\n\ndef _extend_mask(mask, base_h, base_w):\n    \"\"\"Optionally extend mask with a rectangle on one side to create L/T shapes.\n    Returns the (potentially enlarged) mask.\"\"\"\n    if random.random() >= HOLLOW_EXTENSION_PROB:\n        return mask\n\n    side = random.choice(['top', 'bottom', 'left', 'right'])\n    ext_h = random.randint(*HOLLOW_EXT_H_RANGE)\n\n    if side in ('top', 'bottom'):\n        ext_w = min(random.randint(2, max(2, base_w)), base_w)\n        offset = random.randint(0, base_w - ext_w)\n        new_mask = np.zeros((base_h + ext_h, base_w), dtype=bool)\n        if side == 'top':\n            new_mask[ext_h:, :] = mask\n            new_mask[0:ext_h, offset:offset + ext_w] = True\n        else:\n            new_mask[:base_h, :] = mask\n            new_mask[base_h:base_h + ext_h, offset:offset + ext_w] = True\n    else:  # left / right\n        ext_h_actual = min(ext_h, base_h)\n        ext_w_actual = random.randint(*HOLLOW_EXT_SIDE_W_RANGE)\n        offset = random.randint(0, base_h - ext_h_actual)\n        new_mask = np.zeros((base_h, base_w + ext_w_actual), dtype=bool)\n        if side == 'left':\n            new_mask[:, ext_w_actual:] = mask\n            new_mask[offset:offset + ext_h_actual, 0:ext_w_actual] = True\n        else:\n            new_mask[:, :base_w] = mask\n            new_mask[offset:offset + ext_h_actual, base_w:base_w + ext_w_actual] = True\n\n    return new_mask\n\n\ndef _carve_hole(mask, hh, hw):\n    \"\"\"Try to carve a hh x hw rectangular hole in mask's interior.\n    Returns cropped mask with hole, or None on failure.\"\"\"\n    mh, mw = mask.shape\n    for _ in range(HOLLOW_HOLE_SEARCH_RETRIES):\n        hr = random.randint(1, mh - hh - 1)\n        hc = random.randint(1, mw - hw - 1)\n        # All hole cells must be foreground\n        if not mask[hr:hr + hh, hc:hc + hw].all():\n            continue\n        # Border cells must exist on all 4 sides\n        if (not mask[hr - 1, hc:hc + hw].any() or not mask[hr + hh, hc:hc + hw].any() or\n                not mask[hr:hr + hh, hc - 1].any() or not mask[hr:hr + hh, hc + hw].any()):\n            continue\n\n        carved = mask.copy()\n        carved[hr:hr + hh, hc:hc + hw] = False\n===== /home/lixinyu/snap/new/ARC_code/train/465b7d93.py\nfrom __future__ import annotations\n\nfrom collections import deque\n\nimport numpy as np\n\nfrom arc_utils import bbox, colors_present, draw_line, find_components, get_bg, is_contiguous, paste, random_free_location\nimport random\n\n\ndef _rect_frame_bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:\n    b = bbox(mask)\n    if b is None:\n        return None\n    r0, c0, r1, c1 = b\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    if h < 3 or w < 3:\n        return None\n\n    expected = np.zeros_like(mask, dtype=bool)\n    expected[r0 : r1 + 1, c0] = True\n    expected[r0 : r1 + 1, c1] = True\n    expected[r0, c0 : c1 + 1] = True\n    expected[r1, c0 : c1 + 1] = True\n    if not np.array_equal(mask, expected):\n        return None\n    return int(r0), int(c0), int(r1), int(c1)\n\n\ndef _scaled_index(i: int, src_len: int, dst_len: int) -> int:\n    assert src_len >= 1 and dst_len >= 1, \"axis lengths must be positive\"\n    if src_len == 1:\n        assert dst_len == 1, \"a one-pixel motif axis maps to a one-pixel interior axis\"\n        return 0\n    assert dst_len >= 2, \"multi-pixel motif axis needs a multi-pixel interior axis\"\n    return int(round(int(i) * (dst_len - 1) / (src_len - 1)))\n\n\ndef _fill_enclosed(stroke: np.ndarray) -> np.ndarray:\n    h, w = stroke.shape\n    open_space = ~stroke.astype(bool)\n    padded = np.pad(open_space, 1, constant_values=True)\n    seen = np.zeros_like(padded, dtype=bool)\n    q: deque[tuple[int, int]] = deque()\n    ph, pw = padded.shape\n\n    for r in range(ph):\n        for c in (0, pw - 1):\n            if padded[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                q.append((int(r), int(c)))\n    for c in range(pw):\n        for r in (0, ph - 1):\n            if padded[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                q.append((int(r), int(c)))\n\n    while q:\n        r, c = q.popleft()\n        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):\n            if 0 <= nr < ph and 0 <= nc < pw and padded[nr, nc] and not seen[nr, nc]:\n                seen[nr, nc] = True\n                q.append((int(nr), int(nc)))\n\n    holes = open_space & ~seen[1 : h + 1, 1 : w + 1]\n    return stroke.astype(bool) | holes\n\n\ndef _stretch_sprite(sprite: np.ndarray, target_shape: tuple[int, int]) -> np.ndarray:\n    src_h, src_w = sprite.shape\n    dst_h, dst_w = target_shape\n    assert sprite.any(), \"expected a nonempty sprite\"\n\n    stroke = np.zeros((dst_h, dst_w), dtype=int)\n    coords = np.argwhere(sprite)\n    mapped: dict[tuple[int, int], tuple[int, int]] = {}\n    for sr, sc in coords:\n        tr = _scaled_index(int(sr), src_h, dst_h)\n        tc = _scaled_index(int(sc), src_w, dst_w)\n        mapped[(int(sr), int(sc))] = (tr, tc)\n        stroke[tr, tc] = 1\n\n    for sr, sc in coords:\n        sr = int(sr)\n        sc = int(sc)\n        for nr, nc in ((sr + 1, sc), (sr, sc + 1)):\n            if (nr, nc) in mapped:\n                r0, c0 = mapped[(sr, sc)]\n                r1, c1 = mapped[(nr, nc)]\n                draw_line(stroke, r0, c0, end_r=r1, end_c=c1, color=1)\n\n    return _fill_enclosed(stroke.astype(bool))\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.\n\n    Input structure:\n    - The background is the dominant color.\n    - There are exactly two foreground colors: one forms a complete rectangular\n      one-pixel-thick frame, and the other forms one 4-connected sprite outside it.\n    - The frame interior is initially background.\n\n    Rule:\n    - Clear the original sprite from its outside location.\n    - Map the sprite bbox to the frame interior bbox, sending bbox extremes to\n      interior extremes.\n    - Draw straight horizontal or vertical segments between mapped positions of\n      adjacent sprite pixels, then fill any enclosed background region inside\n      those drawn segments.\n\n    Key insight:\n    The outside sprite is a miniature line/fill diagram for the frame interior,\n    not a bitmap to scale by block replication.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected one frame color and one sprite color\"\n\n    frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []\n    for color in colors:\n        frame_bbox = _rect_frame_bbox(g == int(color))\n        if frame_bbox is not None:\n            frame_candidates.append((int(color), frame_bbox))\n    assert len(frame_candidates) == 1, \"expected a unique rectangular frame\"\n\n    frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]\n    sprite_color = next(color for color in colors if color != frame_color)\n    sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)\n    assert len(sprite_components) == 1, \"expected a single 4-connected sprite\"\n    frame_region = np.zeros_like(g, dtype=bool)\n    frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True\n    assert not np.any((g == sprite_color) & frame_region), \"sprite must start outside the frame\"\n\n    sr0, sc0, sr1, sc1 = sprite_components[0][\"bbox\"]\n    sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color\n\n    ir0, ic0 = fr0 + 1, fc0 + 1\n    ir1, ic1 = fr1 - 1, fc1 - 1\n    assert ir0 <= ir1 and ic0 <= ic1, \"frame must have an interior\"\n    interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]\n    assert np.all(interior == bg), \"frame interior must start empty\"\n\n    stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))\n    out = g.copy()\n    out[g == sprite_color] = bg\n    out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and observed fixed colors.\n_GRID_SHAPE = (10, 10)\n_COLOR_COUNT = 10\n_BG = 7\n_FRAME_COLOR = 6\n\n# Frame size bounds and retry budget.\n_FRAME_SIZE_MIN = 3\n_FRAME_SIZE_MAX = 8\n_SINGLE_PIXEL_FRAME_SIZE = 3\n_MAX_GENERATION_ATTEMPTS = 300\n\n# Sprite color pool and source masks.\n_SPRITE_COLORS = tuple(c for c in range(_COLOR_COUNT) if c not in {_BG, _FRAME_COLOR})\n_SPRITE_SINGLE = np.ones((1, 1), dtype=bool)\n_SPRITE_PATTERNS_2X2 = [\n    np.array([[1, 1], [1, 0]], dtype=bool),\n    np.array([[1, 1], [0, 1]], dtype=bool),\n    np.array([[1, 0], [1, 1]], dtype=bool),\n    np.array([[0, 1], [1, 1]], dtype=bool),\n    np.array([[1, 1], [1, 1]], dtype=bool),\n]\n\ndef _outside_locations(\n    frame_bbox: tuple[int, int, int, int], patch_shape: tuple[int, int]\n) -> list[tuple[int, int]]:\n    fr0, fc0, fr1, fc1 = frame_bbox\n    ph, pw = patch_shape\n    locations: list[tuple[int, int]] = []\n    for r in range(_GRID_SHAPE[0] - ph + 1):\n        for c in range(_GRID_SHAPE[1] - pw + 1):\n            pr0, pc0, pr1, pc1 = r, c, r + ph - 1, c + pw - 1\n            separated = pr1 < fr0 or pr0 > fr1 or pc1 < fc0 or pc0 > fc1\n            if separated:\n                locations.append((r, c))\n    return locations\n\ndef _frame_positions(size: int, patch_shape: tuple[int, int]) -> list[tuple[int, int]]:\n    positions: list[tuple[int, int]] = []\n    for r in range(_GRID_SHAPE[0] - size + 1):\n        for c in range(_GRID_SHAPE[1] - size + 1):\n            frame_bbox = (r, c, r + size - 1, c + size - 1)\n            if _outside_locations(frame_bbox, patch_shape):\n                positions.append((r, c))\n    return positions\n\ndef _draw_frame(grid: np.ndarray, r0: int, c0: int, size: int, color: int) -> None:\n    r1, c1 = r0 + size - 1, c0 + size - 1\n    grid[r0 : r1 + 1, c0] = color\n    grid[r0 : r1 + 1, c1] = color\n    grid[r0, c0 : c1 + 1] = color\n    grid[r1, c0 : c1 + 1] = color\n\ndef _sample_sprite(size: int) -> np.ndarray:\n    return _SPRITE_SINGLE.copy() if size == _SINGLE_PIXEL_FRAME_SIZE else random.choice(_SPRITE_PATTERNS_2X2).copy()\n\ndef _sample_case() -> tuple[int, int, np.ndarray]:\n    sprite_color = random.choice(_SPRITE_COLORS)\n    size = random.randint(_FRAME_SIZE_MIN, _FRAME_SIZE_MAX)\n    return sprite_color, size, _sample_sprite(size)\n\ndef _build_candidate_grids(\n    frame_bbox: tuple[int, int, int, int], sprite: np.ndarray, sprite_color: int\n) -> tuple[np.ndarray, np.ndarray] | None:\n    fr0, fc0, fr1, fc1 = frame_bbox\n    stretched = _stretch_sprite(sprite, (fr1 - fr0 - 1, fc1 - fc0 - 1))\n    if not np.any(stretched):\n        return None\n\n    out = np.full(_GRID_SHAPE, _BG, dtype=int)\n    _draw_frame(out, fr0, fc0, fr1 - fr0 + 1, _FRAME_COLOR)\n    out[fr0 + 1 : fr1, fc0 + 1 : fc1][stretched] = sprite_color\n\n    inp = out.copy()\n    inp[fr0 + 1 : fr1, fc0 + 1 : fc1] = _BG\n\n    locations = _outside_locations(frame_bbox, sprite.shape)\n    if not locations:\n        return None\n    sr, sc = random.choice(locations)\n    patch = np.where(sprite, sprite_color, _BG)\n    paste(inp, patch, sr, sc, transparent=_BG)\n    return inp, out\n\ndef _gen_attempt() -> np.ndarray | None:\n    sprite_color, size, sprite = _sample_case()\n\n    frame_positions = _frame_positions(size, sprite.shape)\n    if not frame_positions:\n        return None\n    fr0, fc0 = random.choice(frame_positions)\n    frame_bbox = (fr0, fc0, fr0 + size - 1, fc0 + size - 1)\n\n    candidate = _build_candidate_grids(frame_bbox, sprite, sprite_color)\n    if candidate is None:\n        return None\n    inp, out = candidate\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\ndef generate_input() -> np.ndarray:\n===== /home/lixinyu/snap/new/ARC_code/train/973e499e.py\nfrom __future__ import annotations\n\nimport numpy as np\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Expand each input pixel into a miniature same-color mask of the whole grid.\n\n    Input structure\n    - The input is a non-empty two-dimensional grid of foreground colors.\n    - Black is reserved for the empty/background pixels introduced in the expanded output.\n    - The output has one input-shaped block for each input pixel.\n\n    Rule\n    - For every input pixel with color c, replace that pixel by a block the same shape as the input.\n    - Inside the block, write c exactly where the original input also has color c.\n    - Write black everywhere else in the block.\n\n    Key insight\n    Each pixel selects the global mask of its own color; the result is the blockwise self-mask of the grid.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.size > 0, \"expected a non-empty 2D grid\"\n    assert np.all(g != 0), \"input uses foreground colors; black is output background\"\n\n    h, w = g.shape\n    masks = {int(color): np.where(g == int(color), int(color), 0) for color in np.unique(g)}\n\n    out = np.zeros((h * h, w * w), dtype=int)\n    for r in range(h):\n        for c in range(w):\n            out[r * h : (r + 1) * h, c * w : (c + 1) * w] = masks[int(g[r, c])]\n    return out\n\n# --------------- generator (att2) ---------------\n# Sampling bounds and retry budget.\nGRID_SIZES = (3, 4, 5)\nCOLOR_COUNTS = (2, 3)\nFOREGROUND_COLORS = np.arange(1, 10)\nMIN_CELLS_PER_COLOR = 2\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_expected_output(inp: np.ndarray) -> np.ndarray:\n    h, w = inp.shape\n    masks = {int(color): np.where(inp == int(color), int(color), 0) for color in np.unique(inp)}\n    out = np.zeros((h * h, w * w), dtype=int)\n    for r in range(h):\n        for c in range(w):\n            out[r * h : (r + 1) * h, c * w : (c + 1) * w] = masks[int(inp[r, c])]\n    return out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = int(np.random.choice(GRID_SIZES))\n    k = int(np.random.choice(COLOR_COUNTS))\n    colors = np.random.choice(FOREGROUND_COLORS, size=k, replace=False).astype(int)\n\n    flat = []\n    for color in colors:\n        flat.extend([int(color)] * MIN_CELLS_PER_COLOR)\n    flat.extend(np.random.choice(colors, size=n * n - len(flat)).astype(int).tolist())\n    np.random.shuffle(flat)\n    return np.array(flat, dtype=int).reshape(n, n)\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        inp = _gen_attempt()\n        if inp is None:\n            continue\n        expected = _gen_expected_output(inp)\n        try:\n            actual = main(inp)\n        except Exception:\n            continue\n        if np.array_equal(actual, expected):\n            return inp\n    raise RuntimeError(\"failed to generate a valid 973e499e input\")\n","exit_code":0,"status":"completed"}}
