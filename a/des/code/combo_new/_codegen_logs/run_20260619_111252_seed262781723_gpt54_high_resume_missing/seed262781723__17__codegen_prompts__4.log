olor whose largest component is most network-like.\n  17:     - Find the largest solid k×k all-P square (the hub); exclude it from recoloring.\n  18:     - Recolor each path branch to the seed-region color it touches most.\n  19:     - Recolor the hub center pixel to the seed whose branches touch the hub most.\n  20: \n  21:     Key insight: The hub stays uncolored; branches inherit color from adjacent seed regions by adjacency count.\n  22:     \"\"\"\n  23:     g = np.array(grid, dtype=int)\n  24:     bg = int(get_bg(g))\n  25:     H, W = g.shape\n  26: \n  27:     colors = sorted({int(x) for x in np.unique(g)} - {int(bg)})\n  28:     assert not (not colors)\n  29: \n  30:     def comp_deg_score(mask: np.ndarray) -> float:\n  31:         comps = components_mask(mask, connectivity=4)\n  32:         if not comps:\n  33:             return -1e9\n  34:         best_pts = max(comps, key=lambda coords: int(coords.shape[0]))\n  35:         best_sz = int(best_pts.shape[0])\n  36: \n  37:         m = np.zeros(mask.shape, dtype=bool)\n  38:         m[best_pts[:, 0], best_pts[:, 1]] = True\n  39: \n  40:         deg2 = 0\n  41:         deg4 = 0\n  42:         for r, c in best_pts:\n  43:             r = int(r)\n  44:             c = int(c)\n  45:             d = 0\n  46:             if r > 0 and bool(m[r - 1, c]):\n  47:                 d += 1\n  48:             if r + 1 < H and bool(m[r + 1, c]):\n  49:                 d += 1\n  50:             if c > 0 and bool(m[r, c - 1]):\n  51:                 d += 1\n  52:             if c + 1 < W and bool(m[r, c + 1]):\n  53:                 d += 1\n  54:             if d == 2:\n  55:                 deg2 += 1\n  56:             elif d == 4:\n  57:                 deg4 += 1\n  58:         frac2 = deg2 / max(1, best_sz)\n  59:         frac4 = deg4 / max(1, best_sz)\n  60:         return float((frac2 - frac4) * best_sz)\n  61: \n  62:     P = int(max(colors, key=lambda c: comp_deg_score(g == int(c))))\n  63: \n  64:     # --- hub: largest solid k×k all-P square anywhere ---\n  65:     mP = g == int(P)\n  66:     ps = mP.astype(int).cumsum(axis=0).cumsum(axis=1)\n  67: \n  68:     def rect_sum(r0: int, c0: int, r1: int, c1: int) -> int:\n  69:         s = int(ps[int(r1), int(c1)])\n  70:         if r0 > 0:\n  71:             s -= int(ps[int(r0 - 1), int(c1)])\n  72:         if c0 > 0:\n  73:             s -= int(ps[int(r1), int(c0 - 1)])\n  74:         if r0 > 0 and c0 > 0:\n  75:             s += int(ps[int(r0 - 1), int(c0 - 1)])\n  76:         return int(s)\n  77: \n  78:     best = None  # (k, r0, c0)\n  79:     max_k = int(min(H, W))\n  80:     for k in range(2, max_k + 1):\n  81:         found = None\n  82:         for r0 in range(0, int(H - k + 1)):\n  83:             r1 = int(r0 + k - 1)\n  84:             for c0 in range(0, int(W - k + 1)):\n  85:                 c1 = int(c0 + k - 1)\n  86:                 if rect_sum(int(r0), int(c0), int(r1), int(c1)) == int(k * k):\n  87:                     found = (int(k), int(r0), int(c0))\n  88:         if found is not None:\n  89:             best = found\n  90: \n  91:     assert not (best is None)\n  92: \n  93:     k, r0, c0 = map(int, best)\n  94:     r1, c1 = int(r0 + k - 1), int(c0 + k - 1)\n  95:     hub = np.zeros((H, W), dtype=bool)\n  96:     hub[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = True\n  97: \n  98:     # --- seed regions (non-bg, non-P) ---\n  99:     seed_mask = (g != int(bg)) & (g != int(P))\n 100:     seed_lab, seed_n = label_mask(seed_mask, connectivity=4)\n 101:     seed_major: dict[int, int] = {}\n 102:     all_seed_vals: list[int] = []\n 103:     for sid in range(1, int(seed_n) + 1):\n 104:         pts = np.argwhere(seed_lab == int(sid))\n 105:         rn, rx = int(pts[:, 0].min()), int(pts[:, 0].max())\n 106:         cn, cx = int(pts[:, 1].min()), int(pts[:, 1].max())\n 107:         if rn > 0:\n 108:             assert all(int(g[rn - 1, c]) == int(P) for c in range(cn, cx + 1)), \"seed missing top P border\"\n 109: 