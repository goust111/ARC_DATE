ax(int(block[\"side\"]) for block in blocks)\n 137:     out = np.full((max_side, max_side), bg, dtype=int)\n 138: \n 139:     for block in sorted(blocks, key=lambda item: int(item[\"side\"]), reverse=True):\n 140:         patch = _rotate_to_target(np.asarray(block[\"patch\"], dtype=int), bg, target)\n 141:         side = int(block[\"side\"])\n 142:         top = _center_offset(max_side, side)\n 143:         left = _center_offset(max_side, side)\n 144:         mask = patch != bg\n 145:         window = out[top : top + side, left : left + side]\n 146:         window[mask] = patch[mask]\n 147: \n 148:     return out\n 149: \n 150: \n 151: def _make_block(side: int, body_color: int, marker_color: int, orientation: str) -> np.ndarray:\n 152:     patch = np.full((side, side), body_color, dtype=int)\n 153:     miss_r, miss_c = CORNER_COORDS[orientation]\n 154:     opp_r, opp_c = CORNER_COORDS[OPPOSITE_CORNER[orientation]]\n 155:     patch[miss_r, miss_c] = BG_COLOR\n 156:     patch[opp_r, opp_c] = marker_color\n 157:     return patch\n 158: \n 159: \n 160: def _choose_sizes(rng: random.Random, count: int) -> list[int]:\n 161:     pools = (\n 162:         [2, 4, 6, 8, 10],\n 163:         [3, 5, 7, 9, 11],\n 164:     )\n 165:     pool = list(rng.choice(pools))\n 166:     rng.shuffle(pool)\n 167:     return sorted(pool[:count], reverse=True)\n 168: \n 169: \n 170: def _choose_orientations(rng: random.Random, count: int) -> tuple[str, list[str]]:\n 171:     target = rng.choice(ORIENTATIONS)\n 172:     others = [name for name in ORIENTATIONS if name != target]\n 173:     if count == 5:\n 174:         orientations = [target, target] + others\n 175:     else:\n 176:         orientations = [target, target] + rng.sample(others, 2)\n 177:     rng.shuffle(orientations)\n 178:     return target, orientations\n 179: \n 180: \n 181: def _canvas_shape(rng: random.Random, sizes: list[int]) -> tuple[int, int]:\n 182:     area = sum(side * side for side in sizes)\n 183:     largest = max(sizes)\n 184:     minimum = max(largest + 3, int(math.ceil(math.sqrt(area * 2.0))))\n 185:     height = rng.randint(minimum, 30)\n 186:     width = rng.randint(minimum, 30)\n 187:     return height, width\n 188: \n 189: \n 190: def _try_place(grid: np.ndarray, blocked: np.ndarray, patch: np.ndarray, rng: random.Random) -> bool:\n 191:     h, w = grid.shape\n 192:     side = patch.shape[0]\n 193:     if h - side - 1 < 1 or w - side - 1 < 1:\n 194:         return False\n 195:     for _ in range(PLACE_RETRIES):\n 196:         top = rng.randint(1, h - side - 1)\n 197:         left = rng.randint(1, w - side - 1)\n 198:         if blocked[top : top + side, left : left + side].any():\n 199:             continue\n 200:         mask = patch != BG_COLOR\n 201:         window = grid[top : top + side, left : left + side]\n 202:         window[mask] = patch[mask]\n 203:         blocked[max(0, top - 1) : min(h, top + side + 1), max(0, left - 1) : min(w, left + side + 1)] = True\n 204:         return True\n 205:     return False\n 206: \n 207: \n 208: def _gen_attempt(rng: random.Random) -> np.ndarray | None:\n 209:     block_count = rng.choice((4, 5))\n 210:     _, orientations = _choose_orientations(rng, block_count)\n 211:     sizes = _choose_sizes(rng, block_count)\n 212:     marker_color = rng.choice(MARKER_COLORS)\n 213:     body_palette = [color for color in BODY_COLORS if color != marker_color]\n 214:     body_colors = rng.sample(body_palette, block_count)\n 215: \n 216:     blocks = [\n 217:         _make_block(side, body_color, marker_color, orientation)\n 218:         for side, body_color, orientation in zip(sizes, body_colors, orientations)\n 219:     ]\n 220: \n 221:     height, width = _canvas_shape(rng, sizes)\n 222:     grid = np.full((height, width), BG_COLOR, dtype=int)\n 223:     blocked = np.zeros((height, width), dtype=bool)\n 224: \n 225:     for patch in blocks:\n 226:         if not _try_place(grid, blocked, patch, rng):\n 227:             return None\n 228: 