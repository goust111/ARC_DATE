singleton identifies both the origin position and the \"self\" copy, which is uniquely recolored.\n  24:     \"\"\"\n  25:     g = np.array(grid, dtype=int)\n  26:     bg = int(get_bg(g))\n  27:     H, W = g.shape\n  28: \n  29:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n  30:     assert not (not comps)\n  31: \n  32:     template = max(comps, key=lambda d: int(d[\"area\"]))\n  33:     templ_coords = template[\"coords\"]\n  34:     templ_col = int(g[int(templ_coords[0, 0]), int(templ_coords[0, 1])])\n  35:     r0, c0, r1, c1 = map(int, template[\"bbox\"])\n  36:     h = int(bbox_h((r0, c0, r1, c1)))\n  37:     w = int(bbox_w((r0, c0, r1, c1)))\n  38: \n  39:     templ_rel = [(int(r) - int(r0), int(c) - int(c0)) for r, c in templ_coords]\n  40: \n  41:     # Singleton layout points (excluding the template component).\n  42:     singletons: list[tuple[int, int, int]] = []\n  43:     for comp in comps:\n  44:         if comp is template:\n  45:             continue\n  46:         if int(comp[\"area\"]) != 1:\n  47:             continue\n  48:         rr, cc = map(int, comp[\"coords\"][0])\n  49:         singletons.append((int(rr), int(cc), int(g[int(rr), int(cc)])))\n  50: \n  51:     origin = [(r, c) for (r, c, col) in singletons if int(col) == int(templ_col)]\n  52:     assert not (len(origin) != 1)\n  53:     orr, orc = origin[0]\n  54: \n  55:     other_cols = [int(col) for (_r, _c, col) in singletons if int(col) != int(templ_col)]\n  56:     assert not (not other_cols)\n  57:     overlap_col = int(Counter(other_cols).most_common(1)[0][0])\n  58: \n  59:     deltas = [(int(r - orr), int(c - orc), int(col)) for (r, c, col) in singletons]\n  60:     gcd_vals = [abs(int(x)) for dr, dc, _ in deltas for x in (dr, dc) if int(x) != 0]\n  61:     assert gcd_vals\n  62:     gunit = int(math.gcd(*gcd_vals))\n  63:     gunit = max(1, int(gunit))\n  64:     deltas = [(int(dr // gunit), int(dc // gunit), int(col)) for dr,