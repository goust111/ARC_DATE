_color = stop_colors[0]\n 130: \n 131:     out = g.copy()\n 132:     out[r0 : r1 + 1, c0 : c1 + 1] = bg\n 133:     base = out.copy()\n 134: \n 135:     pass_columns: list[int] = []\n 136:     for j in range(marker_w):\n 137:         c = c0 + j\n 138:         stack = marker[:, j]\n 139:         bottom_control = int(stack[-1])\n 140: \n 141:         if bottom_control == stop_color:\n 142:             obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n 143:             if len(obstacles_below):\n 144:                 floor_r = int(r1 + 1 + obstacles_below[0])\n 145:                 top_r = floor_r - marker_h\n 146:             else:\n 147:                 top_r = H - marker_h\n 148:             assert top_r >= 0, \"stopped column must fit above its obstacle\"\n 149:             out[top_r : top_r + marker_h, c] = stack\n 150:         else:\n 151:             assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n 152:             pass_columns.append(j)\n 153: \n 154:     for start_j, end_j in _runs(pass_columns):\n 155:         source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n 156:         shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n 157:         top_r = H - marker_h\n 158: \n 159:         for j in range(start_j, end_j + 1):\n 160:             c = c0 + j + shift\n 161:             _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n 162:             out[top_r : top_r + marker_h, c] = marker[:, j]\n 163: \n 164:     return out\n 165: \n 166: # --------------- generator (att1) ---------------\n 167: \n 168: GEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\n 169: GRID_SIZE_RANGE = (14, 16)\n 170: MARKER_SIZE = 3\n 171: STOP_COUNT_RANGE = (1, 3)\n 172: OBSTACLE_COMPONENT_RANGE = (7, 9)\n 173: OBSTACLE_PIXEL_RANGE = (20, 31)\n 174: COMPONENT_SIZE_RANGE = (1, 11)\n 175: MIN_STOP_OBSTACLE_ROW = 6\n 176: DROP_ZONE_HEIGHT = 3\n 177: COMPONENT_PLACEMENT_ATTEMPTS, GENERA