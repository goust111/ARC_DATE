a random 4-connected polyomino of *n* cells in a rows x cols grid.\"\"\"\n 108:     start = (random.randint(0, rows - 1), random.randint(0, cols - 1))\n 109:     cells = {start}\n 110:     frontier = []\n 111:     for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n 112:         nr, nc = start[0] + dr, start[1] + dc\n 113:         if 0 <= nr < rows and 0 <= nc < cols:\n 114:             frontier.append((nr, nc))\n 115:     while len(cells) < n and frontier:\n 116:         cell = random.choice(frontier)\n 117:         frontier.remove(cell)\n 118:         if cell in cells:\n 119:             continue\n 120:         cells.add(cell)\n 121:         for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n 122:             nr, nc = cell[0] + dr, cell[1] + dc\n 123:             if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in cells:\n 124:                 frontier.append((nr, nc))\n 125:     return list(cells) if len(cells) == n else None\n 126: \n 127: \n---ENDSNIP---\n 264: \n 265: \n 266: def generate_input() -> np.ndarray:\n 267:     for _ in range(GENERATE_RETRIES):\n 268:         result = _gen_attempt()\n 269:         if result is not None:\n 270:             return result\n 271:     raise RuntimeError(\"Failed to generate input after %d attempts\" % GENERATE_RETRIES)\n---ENDSNIP---\n===FILEEND===\nFILE: /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\n  83: \n  84: \n  85: def main(grid: np.ndarray) -> np.ndarray:\n  86:     \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n  87: \n  88:     Input structure\n  89:     - The background is the dominant color.\n  90:     - The most numerous non-background color forms stationary grey obstacle pixels.\n  91:     - The other two colors form a single 3x3 top-edge marker whose top two rows\n  92:       are maroon and whose bottom row contains maroon or blue control pixels.\n  93: \n  94:     Rule\n  95:     - Erase the to