, 30]\n  91: GRID_W_RANGE = (19, 31)          # W uniform in [19, 30]\n  92: NUM_COLORS = 10                   # palette 0-9\n  93: \n  94: # ── CFG: component shapes ───────────────────────────────────────────\n  95: BBOX_MAX = 5                      # max h or w of a component bbox\n  96: AREA_RANGE = (3, 13)              # component area in [3, 12]\n  97: MIN_FILL_RATIO_X10 = 4            # area * 10 >= 4 * h * w\n  98: IRREGULAR_PROB = 0.85             # prefer non-rectangular bboxes\n  99: \n 100: # ── CFG: layout ─────────────────────────────────────────────────────\n 101: DUP_LAYOUTS = [(2,), (3,), (2, 2)]  # possible duplicate-group structures\n 102: MIN_COL_GAP = 1                   # minimum column gap between components\n 103: MIN_VERTICAL_GAP = 5              # min gap between top-group bottom and bottom-group top\n 104: \n 105: # ── CFG: generation ─────────────────────────────────────────────────\n 106: MAX_RETRIES = 300                 # outer generate_input retry budget\n 107: \n 108: _NEIGHBORS8 = [(-1, -1), (-1, 0), (-1, 1), (0, -1),\n 109:                (0, 1), (1, -1), (1, 0), (1, 1)]\n 110: \n 111: \n 112: def _feasible_dims(area: int) -> list[tuple[int, int]]:\n 113:     \"\"\"Return all (h, w) bboxes where area fits with fill_ratio >= MIN_FILL_RATIO_X10/10.\"\"\"\n 114:     dims = []\n 115:     for h in range(1, BBOX_MAX + 1):\n 116:         for w in range(1, BBOX_MAX + 1):\n 117:             if area > h * w:\n 118:                 continue\n 119:             if area * 10 < MIN_FILL_RATIO_X10 * h * w:\n 120:                 continue\n 121:             if h == 1 and area != w:\n 122:                 continue\n 123:             if w == 1 and area != h:\n 124:                 continue\n 125:             if h > 1 and w > 1 and area < max(h, w):\n 126:                 continue\n 127:             dims.append((h, w))\n 128:     return dims\n 129: \n 130: \n 131: def _line_mask(h: int, w: int) -> np.ndarray:\n 132:     \"\"\"Create a seed mask along a diagonal line spanning the bbox, randomly flipped.\"\"\"\n 133:     mask = np.zeros((h, w), dtype=bool)\n 134:     if h == 1:\n 135:         mask[0, :] = True\n 136:         return mask\n 137:     if w == 1:\n 138:         mask[:, 0] = True\n 139:         return mask\n 140:     steps = max(h, w)\n 141:     for i in range(steps):\n 142:         r = int(round(i * (h - 1) / (steps - 1)))\n 143:         c = int(round(i * (w - 1) / (steps - 1)))\n 144:         mask[r, c] = True\n 145:     if bool(_RNG.integers(0, 2)):\n 146:         mask = np.flipud(mask)\n 147:     if bool(_RNG.integers(0, 2)):\n 148:         mask = np.fliplr(mask)\n 149:     return mask\n 150: \n---ENDSNIP---\n 359: \n 360: \n 361: def generate_input() -> np.ndarray:\n 362:     for _ in range(MAX_RETRIES):\n 363:         grid = _gen_attempt()\n 364:         if grid is not None:\n 365:             return grid\n 366:     raise RuntimeError(\"failed to generate a valid 62593bfd sample\")\n---ENDSNIP---\n===FILEEND===\nFILE: /home/lixinyu/snap/new/ARC_code/train/f0100645.py\n  48: \n  49: \n  50: def main(grid: np.ndarray) -> np.ndarray:\n  51:     \"\"\"\n  52:     Slide each inner colored object horizontally into the same-colored vertical wall until it touches an obstacle.\n  53: \n  54:     Input structure\n  55:     - The background is the dominant color.\n  56:     - The only foreground colors are two non-background colors.\n  57:     - One foreground color fills the left column and the other fills the right column.\n  58:     - Extra 8-connected objects of each wall color appear away from that color's wall.\n  59: \n  60:     Rule\n  61:     - Clear the extra objects from their original positions.\n  62:     - For each wall color, process its 8-connected extra objects from nearest to farthest from the matching wall.\n  63:     - Slide each object horizontally toward its matching wall as far as possible without overlapping the wall or an already settled object of the same color.\n  64:     - Keep the two vertical wall columns fixed.\n  65: \n  66:     Key insight\n  67:     - The side columns act like color-specific gravity walls: same-colored objects compact sideways against their own wall while preserving each object's shape.\n  68:     \"\"\"\n  69:     g = np.asarray(grid, dtype=int)\n  70:     assert g.ndim == 2 and min(g.shape) >= 2, \"expected a non-empty 2D grid with two side columns\"\n  71: \n  72:     bg = get_bg(g)\n  73:     w = g.shape[1]\n  74:     left_color = int(g[0, 0])\n  75:     right_color = int(g[0, w - 1])\n  76: \n  77:     assert left_color != right_color, \"left and right walls must have different colors\"\n  78:     assert bg not in {left_color, right_color}, \"walls must be foreground colors\"\n  79:     assert np.all(g[:, 0] == left_color), \"left wall must fill the full left column\"\n  80:     assert np.all(g[:, w - 1] == right_color), \"right wall must fill the full right column\"\n  81:     assert set(map(int, np.unique(g))) == {int(bg), left_color, right_color}, \"expected exactly background plus two wall colors\"\n  82: \n  83:     out = np.full_like(g, int(bg))\n  84:     out[:, 0] = left_color\n  85:     out[:, w - 1] = right_color\n  86: \n  87:     placements: list[tuple[int, np.ndarray]] = []\n  88:     for color, side_col, direction in ((left_color, 0, -1), (right_color, w - 1, 1)):\n  89:         for coords in _settled_components(g, color, side_col, direction):\n  90:             placements.append((color, coords))\n  91: \n  92:     occupied = (out != bg)\n  93:     for color, coords in placements:\n  94:         assert not np.any(occupied[coords[:, 0], coords[:, 1]]), \"different colors must not settle on the same pixel\"\n  95:         out[coords[:, 0], coords[:, 1]] = color\n  96:         occupied[coords[:, 0], coords[:, 1]] = True\n  97: \n  98:     assert int(np.sum(out == left_color)) == int(np.sum(g == left_color)), \"left color count must be preserved\"\n  99:     assert int(np.sum(out == right_color)) == int(np.sum(g == right_color)), \"right color count must be preserved\"\n 100:     return out\n 101: \n 102: # --------------- generator (o5x) ---------------\n 103: \n 104: # Canvas and palette bounds.\n 105: GRID_HEIGHT_BOUNDS = (9, 10)\n 106: GRID_WIDTH_BOUNDS = (9, 10)\n 107: BACKGROUND_COLOR = 7\n 108: WALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n 109: # Object counts and pixel budgets.\n 110: COMPONENT_COUNT_BOUNDS = (2, 3)\n 111: INNER_FOREGROUND_BOUNDS = (15, 23)\n 112: SPRITE_PIXEL_BOUNDS = (1, 7)\n 113: # Sprite geometry limits.\n 114: SPRITE_HEIGHT_BOUNDS = (1, 5)\n 115: SPRITE_WIDTH_BOUNDS = (1, 3)\n 116: MIN_SPRITE_DENSITY = 0.56\n 117: # Input scatter and retry limits.\n 118: SCATTER_OFFSET_BOUNDS = (1, 5)\n 119: GENERATION_ATTEMPTS = 300\n 120: \n 121: Placement = tuple[int, np.ndarray, int, int, bool]\n 122: \n 123: \n 124: def _gen_bounded_composition(total: int, parts: int, lo: int, hi: int) -> list[int]:\n 125:     values = []\n 126:     remaining = int(total)\n 127:     for i in range(int(parts)):\n 128:         slots = int(parts) - i - 1\n 129:         low = max(int(lo), remaining - int(hi) * slots)\n 130:         high = min(int(hi), remaining - int(lo) * slots)\n 131:         value = random.randint(low, high)\n 132:         values.append(value)\n 133:         remaining -= value\n 134:     random.shuffle(values)\n 135:     return values\n 136: \n 137: \n 138: def _gen_sprite_mask(size: int) -> np.ndarray:\n 139:     size = int(size)\n 140:     dims = [\n 141:         (h, w)\n 142:         for h in range(SPRITE_HEIGHT_BOUNDS[0], SPRITE_HEIGHT_BOUNDS[1] + 1)\n 143:         for w in range(SPRITE_WIDTH_BOUNDS[0], SPRITE_WIDTH_BOUNDS[1] + 1)\n 144:         if max(h, w) <= size <= h * w and size / (h * w) >= MIN_SPRITE_DENSITY\n 145:     ]\n 146:     h, w = random.choice(dims)\n 147: \n 148:     coords: set[tuple[int, int]] = set()\n 149:     length = max(h, w)\n 150:     if length == 1:\n 151:         coords.add((0, 0))\n 152:     else:\n 153:         for i in range(length):\n 154:             r = (i * (h - 1) + (length - 1) // 2) // (length - 1)\n 155:             c = (i * (w - 1) + (length - 1) // 2) // (length - 1)\n 156:             coords.add((int(r), int(c)))\n 157: \n 158:     while len(coords) < size:\n 159:         frontier = []\n 160:         for r, c in coords:\n 161:             for dr in (-1, 0, 1):\n 162:                 for dc in (-1, 0, 1):\n 163:                     if dr == 0 and dc == 0:\n 164:                         continue\n 165:                     nr, nc = r + dr, c + dc\n 166:                     if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in coords:\n 167:                         frontier.append((nr, nc))\n 168:         coords.add(random.choice(frontier))\n 169: \n---ENDSNIP---\n 295: \n 296: \n 297: def generate_input() -> np.ndarray:\n 298:     for _ in range(GENERATION_ATTEMPTS):\n 299:         grid = _gen_attempt()\n 300:         if grid is not None:\n 301:             return grid\n 302:     raise RuntimeError(\"failed to generate a valid f0100645 input\")\n---ENDSNIP---\n===FILEEND===\nFILE: /home/lixinyu/snap/new/ARC_code/train/538b439f.py\n 119: \n 120: \n 121: def main(grid: np.ndarray) -> np.ndarray:\n 122:     \"\"\"\n 123:     Reflect the solid rectangular source objects across the full separator line and color the gap with the separator color.\n 124: \n 125:     Input structure:\n 126:     - A dominant background contains one full-width or full-height one-pixel\n 127:       separator line in a non-background color.\n 128:     - One other foreground color forms solid rectangular objects, all strictly on the same side of that separator.\n 129:     - Remaining non-background pixels are scattered distractors.\n 130: \n 131:     Rule:\n 132:     - Keep the input grid shape and unchanged pixels outside each affected corridor.\n 133:     - Mirror each source object across the separator line.\n 134:     - For every source object, recolor the rectangular strip between the\n 135:       original object and its reflection to the separator color, then paint the\n 136:       reflected object in the source color.\n 137: \n 138:     Key insight:\n 139:     - The full straight line is a mirror axis; the real objects are identified\n 140:       structurally as the only solid rectangles confined to one side, while\n 141:       scattered pixels are noise that may be overwritten inside the corridor.\n 142:     \"\"\"\n 143:     g = np.asarray(grid, dtype=int)\n 144:     bg = get_bg(g)\n 145:     orient, axis, axis_color = _find_separator(g, bg)\n 146:     source_color, components = _find_source(g, bg, orient, axis, axis_color)\n 147: \n 148:     out = g.copy()\n 149:     for component in components:\n 150:         _mirror_and_connect(out, component, orient, axis, axis_color, source_color)\n 151:     return out\n 152: \n 153: # --------------- generator (att2, o5x) ---------------\n 154: \n 155: # Canvas and palette.\n 156: GRID_SIZE_RANGE = (18, 23)\n 157: COLOR_COUNT = 10\n 158: PALETTE_SIZE = 4\n 159: ORIENTATIONS = (\"vertical\", \"horizontal\")\n 160: AXIS_RATIO_RANGE = (0.35, 0.50)\n 161: SIDES = (-1, 1)\n 162: \n 163: # Source rectangles and reflected corridors.\n 164: SOURCE_RECT_COUNT_RANGE = (2, 3)\n 165: RECT_HEIGHT_RANGE = (2, 5)\n 166: RECT_WIDTH_RANGE = (2, 4)\n 167: SOURCE_GAP_TO_AXIS_RANGE = (2, 5)\n 168: MIN_RECT_INTERVAL_GAP = 1\n 169: \n 170: # Distractor scatter.\n 171: DISTRACTOR_DENSITY_RANGE = (0.03, 0.10)\n 172: MAX_DISTRACTOR_CLUSTERS = 4\n 173: DISTRACTOR_CLUSTER_TARGET_DIVISOR = 12\n 174: FORCE_CLUSTER_PROB = 0.70\n 175: DISTRACTOR_CLUSTER_SHAPES = (\n 176:     ((0, 0), (0, 1)),\n 177:     ((0, 0), (1, 0)),\n 178:     ((0, 0), (0, 1), (0, 2)),\n 179:     ((0, 0), (1, 0), (2, 0)),\n 180:     ((0, 0), (1, 0), (0, 1)),\n 181:     ((0, 0), (1, 0), (1, 1)),\n 182:     ((0, 0), (0, 1), (1, 1)),\n 183:     ((1, 0), (0, 1), (1, 1)),\n 184: )\n 185: \n 186: # Retry budget.\n 187: GENERATION_ATTEMPTS = 300\n 188: \n 189: \n 190: def _composition(total: int, parts: int) -> list[int]:\n 191:     if total <= 0:\n 192:         return [0] * parts\n 193:     return list(np.random.multinomial(int(total), [1.0 / parts] * parts))\n 194: \n 195: \n 196: def _pack_intervals(length: int, sizes: list[int], *, min_gap: int) -> list[tuple[int, int]] | None:\n 197:     extra = int(length) - sum(sizes) - int(min_gap) * (len(sizes) - 1)\n 198:     if extra < 0:\n 199:         return None\n 200:     gaps = _composition(extra, len(sizes) + 1)\n 201:     intervals: list[tuple[int, int]] = []\n 202:     pos = gaps[0]\n 203:     for i, size in enumerate(sizes):\n 204:         intervals.append((pos, pos + int(size) - 1))\n 205:         pos += int(size)\n 206:         if i + 1 < len(sizes):\n 207:             pos += int(min_gap) + gaps[i + 1]\n 208:     return intervals\n 209: \n 210: \n 211: def _axis_candidates(length: int) -> list[int]:\n 212:     min_ratio, max_ratio = AXIS_RATIO_RANGE\n 213:     return [\n 214:         i\n 215:         for i in range(1, int(length) - 1)\n 216:         if min_ratio <= min(i, int(length) - 1 - i) / float(length) <= max_ratio\n 217:     ]\n 218: \n 219: \n 220: def _size_gap_pairs(size_range: tuple[int, int], min_space: int) -> list[tuple[int, int]]:\n 221:     return [\n 222:         (size, gap)\n 223:         for size in range(size_range[0], size_range[1] + 1)\n 224:         for gap in range(SOURCE_GAP_TO_AXIS_RANGE[0], SOURCE_GAP_TO_AXIS_RANGE[1] + 1)\n 225:         if size + gap <= min_space\n 226:     ]\n 227: \n 228: \n 229: def _side_span(axis: int, length: int, size: int, gap: int, side: int) -> tuple[int, int] | None:\n 230:     if side < 0:\n 231:         end = int(axis) - int(gap) - 1\n 232:         start = end - int(size) + 1\n 233:     else:\n 234:         start = int(axis) + int(gap) + 1\n 235:         end = start + int(size) - 1\n 236:     if 0 <= start <= end < int(length):\n 237:         return start, end\n 238:     return None\n 239: \n 240: \n---ENDSNIP---\n 471: \n 472: \n 473: def generate_input() -> np.ndarray:\n 474:     for _ in range(GENERATION_ATTEMPTS):\n 475:         grid = _gen_attempt()\n 476:         if grid is not None:\n 477:             return grid\n 478:     raise RuntimeError(\"failed to generate valid input for 538b439f\")\n---ENDSNIP---\n===FILEEND===\nFILE: /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\n  39: \n  40: \n  41: def main(grid: np.ndarray) -> np.ndarray:\n  42:     \"\"\"\n  43:     Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n  44:     Input structure\n  45:     - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n  46:     - Blue bars are markers; red bars are body bars that may be chained after a marker.\n  47:     Rule\n  48:     - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n  49:     - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n  50:     - Red bars that are not reached from a blue marker remain unchanged.\n  51:     Key insight\n  52:     - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n  53:     \"\"\"\n  54:     g = np.asarray(grid, dtype=int)\n  55:     bg = get_bg(g)\n  56:     colors = set(map(int, np.unique(g))) - {bg}\n  57:     assert colors <= {MARKER_COLOR, BODY_COLOR}\n  58:     assert MARKER_COLOR in colors\n  59: \n  60:     bars = _vertical_bars(g, bg)\n  61:     by_col = {bar[\"col\"]: bar for bar in bars}\n  62:     assert len(by_col) == len(bars)\n  63: \n  64:     baselines = {bar[\"bottom\"] for bar in bars}\n  65:     assert len(baselines) == 1\n  66:     baseline = baselines.pop()\n  67:     out = g.copy()\n  68:     for bar in bars:\n  69:         if bar[\"color\"] != MARKER_COLOR:\n  70:             continue\n  71: \n  72:         group = [bar]\n  73:         current = bar\n  74:         while True:\n  75:             next_col = current[\"col\"] + current[\"height\"]\n  76:             next_bar = by_col.get(next_col)\n  77:             if next_bar is None:\n  78:                 break\n  79:             if next_bar[\"color\"] != BODY_COLOR:\n  80:                 break\n  81:             group.append(next_bar)\n  82:             current = next_bar\n  83: \n  84:         for item in group:\n  85:             rows = item[\"coords\"][:, 0]\n  86:             cols = item[\"coords\"][:, 1]\n  87:             out[rows, cols] = bg\n  88: \n  89:         for item in group:\n  90:             col = item[\"col\"]\n  91:             height = item[\"height\"]\n  92:             assert col + height <= g.shape[1]\n  93:             out[baseline, col : col + height] = item[\"color\"]\n  94: \n  95:     return out\n  96: \n  97: # --------------- generator (att2) ---------------\n  98: \n  99: # Canvas bounds.\n 100: MIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n 101: \n 102: # Bar and chain structure.\n 103: MIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\n 104: MIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\n 105: MIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n 106: \n 107: # Layout padding and retry budget.\n 108: GAP_VALUES = (1, 2, 3)\n 109: MAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n 110: \n 111: \n 112: def _chain_red_distributions(n_blue, n_red):\n 113:     \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n 114:     return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n 115: \n 116: \n 117: def _bounded_tuples(values, n, max_sum):\n 118:     \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n 119:     return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n 120: \n 121: \n 122: def _sample_groups():\n 123:     \"\"\"Sample row count and bar groups before physical layout.\"\"\"\n 124:     rows = random.randint(MIN_ROWS, MAX_ROWS)\n 125:     max_height = min(MAX_BAR_HEIGHT, rows)\n 126:     n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)\n 127:     max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)\n 128:     red_total = random.randint(MIN_RED_BARS, max_red)\n 129:     min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)\n 130:     max_unchained = min(MAX_UNCHAINED_RED, red_total)\n 131:     n_unchained = random.randint(min_unchained, max_unchained)\n 132: \n 133:     distributions = _chain_red_distributions(n_blue, red_total - n_unchained)\n 134:     if not distributions:\n 135:         return None\n 136: \n 137:     groups = [\n 138:         {\"kind\": \"chain\", \"colors\": [MARKER_COLOR] + [BODY_COLOR] * n_red}\n 139:         for n_red in random.choice(distributions)\n 140:     ]\n 141:     groups.extend({\"kind\": \"unchained\", \"colors\": [BODY_COLOR]} for _ in range(n_unchained))\n 142:     random.shuffle(groups)\n 143:     if groups[0][\"kind\"] == \"unchained\":\n 144:         for i, group in enumerate(groups):\n 145:             if group[\"kind\"] == \"chain\":\n 146:                 groups[0], groups[i] = groups[i], groups[0]\n 147:                 break\n 148:     return rows, max_height, groups\n 149: \n 150: \n 151: def _sample_layout(max_height, groups):\n 152:     \"\"\"Sample gaps, heights, margins, and positioned bar columns.\"\"\"\n 153:     n_bars = sum(len(group[\"colors\"]) for group in groups)\n 154:     right_margin = random.randint(0, MAX_RIGHT_MARGIN)\n 155: \n 156:     gap_count = len(groups) - 1\n 157:     if gap_count:\n 158:         max_gap_sum = MAX_WIDTH - right_margin - MIN_BAR_HEIGHT * n_bars\n 159:         gap_options = _bounded_tuples(GAP_VALUES, gap_count, max_gap_sum)\n 160:         if not gap_options:\n---ENDSNIP---\n 259: \n 260: \n 261: def generate_input():\n 262:     for _ in range(MAX_GENERATION_ATTEMPTS):\n 263:         grid = _gen_attempt()\n 264:         if grid is not None:\n 265:             return grid\n 266:     raise RuntimeError(\"failed to generate a valid 84551f4c input\")\n---ENDSNIP---\n===FILEEND===\n","exit_code":0,"status":"completed"}}
