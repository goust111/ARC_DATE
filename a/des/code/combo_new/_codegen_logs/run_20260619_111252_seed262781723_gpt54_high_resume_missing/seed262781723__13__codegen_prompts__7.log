home/lixinyu/snap/new/ARC_code/train/538b439f.py:277:    \"\"\"Choose source rectangles and paint their output-side reflections.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/538b439f.py:317:    \"\"\"Sample high-level scene choices before any geometry-specific drawing.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/538b439f.py:473:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/34cfa167.py:93:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/34cfa167.py:94:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/34cfa167.py:117:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/34cfa167.py:336:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/31f7f899.py:6:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/31f7f899.py:7:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/31f7f899.py:21:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/31f7f899.py:155:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/89565ca0.py:119:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/89565ca0.py:120:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/89565ca0.py:136:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/89565ca0.py:185:    \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/89565ca0.py:201:    \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/89565ca0.py:320:    \"\"\"Try to reposition frame j so it overlaps frame i. Modifies positions in place.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/89565ca0.py:341:    \"\"\"Render frame walls onto grid; return grid and set of visible frame pixel coords.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/89565ca0.py:367:    \"\"\"Place noise pixels on non-wall cells and damage some wall cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/89565ca0.py:390:    \"\"\"Single attempt to generate a valid puzzle grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/89565ca0.py:475:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:59:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:60:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:79:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:491:    \"\"\"Render the primary path columns and return the grid plus long-contour mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:502:    \"\"\"Add short distractors, then pad long contours to the sampled pixel target.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:518:    \"\"\"Place channel bars first, then scatter isolated obstacle clusters.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:527:    \"\"\"Build the output-first pair and carry validation metadata.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:564:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:8:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:9:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:21:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:110:    \"\"\"Return an inclusive randint from a configured (low, high) pair.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:116:    \"\"\"Return connected masks that span all four sides of the sprite bbox.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:132:    \"\"\"Sample one connected same-color sprite drawn on the background color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:146:    \"\"\"Choose background, key colors, and optional distractor color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:159:    \"\"\"Sample the target outside-component count for each key color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:164:    \"\"\"Return legend height and width for the key count and largest tally.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:171:    \"\"\"Map a zero-based key index to its row inside the legend/output box.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:176:    \"\"\"Render the black output tally canvas implied by key colors and counts.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:189:    \"\"\"Return a black legend patch with only the key-column pixels filled.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:197:    \"\"\"Sample a grid and paste the legend away from all canvas edges.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:219:    \"\"\"Create canonical key sprites, optional distractor sprite, and shuffle them.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:232:    \"\"\"Paste sprites into random non-touching free locations in queue order.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:245:    \"\"\"Run one output-first generation attempt and reject solver mismatches.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:265:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
