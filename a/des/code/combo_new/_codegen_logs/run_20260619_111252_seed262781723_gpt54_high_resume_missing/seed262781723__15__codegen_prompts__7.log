{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/abbfd121.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, paste, random_free_location\nimport random\n\n\nRect = tuple[int, int, int, int, int, int]  # (area, color, r0, c0, r1, c1)\n\n\ndef _solid_rectangles(g: np.ndarray) -> list[Rect]:\n    rects: list[Rect] = []\n    for color in np.unique(g):\n        for coords in components_mask(g == int(color), connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(coords)\n            h = r1 - r0 + 1\n            w = c1 - c0 + 1\n            area = int(coords.shape[0])\n            if h > 1 and w > 1 and area == h * w:\n                rects.append((area, int(color), r0, c0, r1, c1))\n    return rects\n\n\ndef _period_values(\n    g: np.ndarray, blocked: np.ndarray, row_period: int, col_period: int\n) -> dict[tuple[int, int], int] | None:\n    values: dict[tuple[int, int], int] = {}\n    h, w = g.shape\n    for r in range(h):\n        for c in range(w):\n            if blocked[r, c]:\n                continue\n            key = (r % row_period, c % col_period)\n            value = int(g[r, c])\n            if key in values and values[key] != value:\n                return None\n            values[key] = value\n    return values\n\n\ndef _reconstruct_rect(\n    values: dict[tuple[int, int], int], row_period: int, col_period: int, rect: Rect\n) -> np.ndarray:\n    _, _, r0, c0, r1, c1 = rect\n    out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)\n    for rr, r in enumerate(range(r0, r1 + 1)):\n        for cc, c in enumerate(range(c0, c1 + 1)):\n            key = (r % row_period, c % col_period)\n            assert key in values, \"period residue must be visible outside the rectangles\"\n            out[rr, cc] = values[key]\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recover the repeating background pattern hidden under the largest solid rectangle.\n\n    Input structure:\n    - The grid is covered by a small row/column periodic pattern.\n    - Several non-pattern colors form solid rectangular foreground objects that\n      overwrite the pattern.\n    - The requested output region is the largest of those solid rectangles.\n\n    Rule:\n    - Find every 4-connected monochromatic object whose bounding box is a filled\n      rectangle with both dimensions greater than one.\n    - Treat those rectangles as masks, infer the smallest repeating tile that is\n      consistent with all remaining visible pixels, and repaint the largest\n      rectangle's coordinates with that tile.\n\n    Key insight: The rectangle colors are occluders; the visible pixels outside\n    them are enough to reconstruct the original periodic background underneath.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    rects = _solid_rectangles(g)\n    assert rects, \"expected at least one solid rectangular occluder\"\n\n    max_area = max(area for area, *_ in rects)\n    targets = [rect for rect in rects if rect[0] == max_area]\n    assert len(targets) == 1, \"largest rectangle must be unique\"\n    target = targets[0]\n\n    blocked = np.zeros(g.shape, dtype=bool)\n    for _, _, r0, c0, r1, c1 in rects:\n        blocked[r0 : r1 + 1, c0 : c1 + 1] = True\n\n    h, w = g.shape\n    period_candidates: list[tuple[int, int, dict[tuple[int, int], int]]] = []\n    for row_period in range(1, h + 1):\n        for col_period in range(1, w + 1):\n            values = _period_values(g, blocked, row_period, col_period)\n            if values is not None:\n                period_candidates.append((row_period, col_period, values))\n    assert period_candidates, \"visible pixels must define a periodic pattern\"\n\n    min_period_area = min(rp * cp for rp, cp, _ in period_candidates)\n    outputs = [\n        _reconstruct_rect(values, row_period, col_period, target)\n        for row_period, col_period, values in period_candidates\n        if row_period * col_period == min_period_area\n    ]\n    assert outputs, \"expected at least one minimal period\"\n    first = outputs[0]\n    assert all(np.array_equal(first, out) for out in outputs), \"minimal periods must agree\"\n    return first\n\n# --------------- generator (att2) ---------------\n\n# Tile palette and period choices.\n_GEN_COLOR_RANGE = range(10)\n_GEN_TILE_SIZES = [3, 4]\n_GEN_TILE_COLOR_COUNTS = [3, 4]\n_GEN_STEP_CHOICES = {3: [1, 2], 4: [1, 3]}\n# Canvas dimensions from the observed task family.\n_GEN_HEIGHT_RANGE = (19, 23)\n_GEN_WIDTH_RANGE = (19, 22)\n# Occluder rectangle count, size, and coverage constraints.\n_GEN_RECT_COUNTS = [2, 3]\n_GEN_RECT_SIDE_RANGE = range(3, 13)\n_GEN_AREA_RANGE = (9, 100)\n_GEN_TARGET_AREA_RANGE = (36, 100)\n_GEN_COVERAGE_RANGE = (0.18, 0.33)\n# Rejection sampling budget.\n_GEN_ATTEMPT_LIMIT = 300\n\n_GEN_DIMS_BY_AREA = {\n    h * w: [(hh, ww) for hh in _GEN_RECT_SIDE_RANGE for ww in _GEN_RECT_SIDE_RANGE if hh * ww == h * w]\n    for h in _GEN_RECT_SIDE_RANGE\n    for w in _GEN_RECT_SIDE_RANGE\n}\n\n\ndef _gen_tile() -> np.ndarray:\n    size = random.choice(_GEN_TILE_SIZES)\n    n_colors = random.choice(_GEN_TILE_COLOR_COUNTS) if size == 3 else 4\n    colors = random.sample(_GEN_COLOR_RANGE, n_colors)\n    step_choices = _GEN_STEP_CHOICES[n_colors]\n    row_step = random.choice(step_choices)\n    col_step = random.choice(step_choices)\n    offset = random.randrange(n_colors)\n    tile = np.empty((size, size), dtype=int)\n    for r in range(size):\n        for c in range(size):\n            tile[r, c] = colors[(offset + row_step * r + col_step * c) % n_colors]\n    return tile\n\n\ndef _gen_periodic_grid(tile: np.ndarray, height: int, width: int) -> np.ndarray:\n    rows = np.arange(height)[:, None] % tile.shape[0]\n    cols = np.arange(width)[None, :] % tile.shape[1]\n    return tile[rows, cols].astype(int, copy=True)\n\n\ndef _gen_choose_areas(height: int, width: int, count: int) -> tuple[int, ...] | None:\n    min_total = int(np.ceil(_GEN_COVERAGE_RANGE[0] * height * width))\n    max_total = int(np.floor(_GEN_COVERAGE_RANGE[1] * height * width))\n    area_min, area_max = _GEN_AREA_RANGE\n    target_min, target_max = _GEN_TARGET_AREA_RANGE\n    small_areas = sorted(a for a in _GEN_DIMS_BY_AREA if area_min <= a <= area_max)\n    target_areas = [a for a in small_areas if target_min <= a <= target_max]\n    possible: dict[int, list[tuple[int, ...]]] = {}\n    for total in range(min_total, max_total + 1):\n        tuples: list[tuple[int, ...]] = []\n        for target in target_areas:\n            if count == 2:\n                small = total - target\n                if small in _GEN_DIMS_BY_AREA and area_min <= small < target:\n                    tuples.append((target, small))\n            else:\n                rem = total - target\n                for small1 in small_areas:\n                    small2 = rem - small1\n                    if (\n                        area_min <= small1 < target\n                        and area_min <= small2 < target\n                        and small2 in _GEN_DIMS_BY_AREA\n                    ):\n                        tuples.append((target, small1, small2))\n        if tuples:\n            possible[total] = tuples\n    if not possible:\n        return None\n    total = random.choice(list(possible))\n    return random.choice(possible[total])\n\n\ndef _gen_place_rectangles(shape: tuple[int, int], dims: list[tuple[int, int]]) -> list[tuple[int, int, int, int]] | None:\n    occupied = np.zeros(shape, dtype=int)\n    placed: list[tuple[int, int, int, int]] = []\n    for rect_h, rect_w in dims:\n        patch = np.ones((rect_h, rect_w), dtype=int)\n        try:\n            row, col = random_free_location(occupied, patch, transparent=0)\n        except ValueError:\n            return None\n        paste(occupied, patch, row, col)\n        placed.append((row, col, rect_h, rect_w))\n    return placed\n\n\ndef _gen_all_residues_visible(occupied: np.ndarray, row_period: int, col_period: int) -> bool:\n    seen = np.zeros((row_period, col_period), dtype=bool)\n    for residue_r in range(row_period):\n        for residue_c in range(col_period):\n            seen[residue_r, residue_c] = np.any(\n                occupied[residue_r::row_period, residue_c::col_period] == 0\n            )\n    return bool(seen.all())\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    tile = _gen_tile()\n    height = random.randint(*_GEN_HEIGHT_RANGE)\n    width = random.randint(*_GEN_WIDTH_RANGE)\n    base = _gen_periodic_grid(tile, height, width)\n\n    count = random.choice(_GEN_RECT_COUNTS)\n    areas = _gen_choose_areas(height, width, count)\n    if areas is None:\n        return None\n\n    dims = [random.choice(_GEN_DIMS_BY_AREA[area]) for area in areas]\n    placed = _gen_place_rectangles((height, width), dims)\n    if placed is None:\n        return None\n\n    occupied = np.zeros((height, width), dtype=int)\n    for row, col, rect_h, rect_w in placed:\n        occupied[row : row + rect_h, col : col + rect_w] = 1\n    if not _gen_all_residues_visible(occupied, tile.shape[0], tile.shape[1]):\n        return None\n\n    target_row, target_col, target_h, target_w = placed[0]\n    expected = base[target_row : target_row + target_h, target_col : target_col + target_w].copy()\n    tile_colors = set(map(int, tile.ravel()))\n    occluder_colors = random.sample([c for c in _GEN_COLOR_RANGE if c not in tile_colors], count)\n\n    grid = base.copy()\n    for color, (row, col, rect_h, rect_w) in zip(occluder_colors, placed):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/e734a0e8.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\nimport random\nfrom arc_utils import paste\n\n\ndef _unique_mode(values: np.ndarray) -> int:\n    counts = Counter(map(int, values.reshape(-1)))\n    ranked = counts.most_common()\n    assert ranked, \"expected a nonempty set of values\"\n    assert len(ranked) == 1 or ranked[0][1] > ranked[1][1], \"expected a unique dominant color\"\n    return int(ranked[0][0])\n\n\ndef _separator_lines(g: np.ndarray) -> tuple[int, list[int], list[int]]:\n    height, width = map(int, g.shape)\n    candidates = []\n    for color in np.unique(g):\n        color = int(color)\n        rows = [r for r in range(height) if np.all(g[r, :] == color)]\n        cols = [c for c in range(width) if np.all(g[:, c] == color)]\n        if rows and cols:\n            candidates.append((color, rows, cols))\n    assert len(candidates) == 1, \"expected one color to form full separator rows and columns\"\n    return candidates[0]\n\n\ndef _spans(length: int, separators: list[int]) -> list[tuple[int, int]]:\n    spans = []\n    start = 0\n    for sep in separators:\n        assert start < sep, \"separator lines must leave nonempty regions\"\n        spans.append((start, sep - 1))\n        start = sep + 1\n    assert start < length, \"separator lines must leave a final nonempty region\"\n    spans.append((start, length - 1))\n    return spans\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Copy the unique colored sprite tile into every tiled cell marked by an internal separator-colored pixel.\n\n    Input structure\n    - Full same-color separator rows and columns partition the grid into equal rectangular tiles.\n    - One tile contains the only non-background, non-separator colored sprite.\n    - Target tiles are otherwise background-colored but contain at least one internal pixel of the separator color.\n\n    Rule\n    - Keep the separator lines and the source sprite tile unchanged.\n    - Replace each marked target tile with an exact copy of the source tile.\n    - Unmarked background-only tiles remain unchanged.\n\n    Key insight\n    - The internal separator-colored pixels are placement markers; the single colored tile is the template to stamp into those marked cells.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.size > 0, \"expected a nonempty 2D grid\"\n\n    separator, sep_rows, sep_cols = _separator_lines(g)\n    row_spans = _spans(g.shape[0], sep_rows)\n    col_spans = _spans(g.shape[1], sep_cols)\n\n    tile_heights = {r1 - r0 + 1 for r0, r1 in row_spans}\n    tile_widths = {c1 - c0 + 1 for c0, c1 in col_spans}\n    assert len(tile_heights) == 1 and len(tile_widths) == 1, \"expected equal-sized tile rows and columns\"\n    tile_h = tile_heights.pop()\n    tile_w = tile_widths.pop()\n\n    bg = _unique_mode(g[g != separator])\n    assert bg != separator, \"background and separator colors must differ\"\n    sprite_colors = [int(color) for color in np.unique(g) if int(color) not in {bg, separator}]\n    assert len(sprite_colors) == 1, \"expected one sprite color\"\n    sprite_color = sprite_colors[0]\n\n    source_tiles = []\n    marked_origins = []\n    for r0, r1 in row_spans:\n        for c0, c1 in col_spans:\n            tile = g[r0 : r1 + 1, c0 : c1 + 1]\n            assert tile.shape == (tile_h, tile_w)\n            has_sprite = np.any(tile == sprite_color)\n            has_marker = np.any(tile == separator)\n            if has_sprite:\n                assert not has_marker, \"source tile should contain only sprite and background\"\n                assert set(map(int, np.unique(tile))).issubset({bg, sprite_color})\n                source_tiles.append(tile.copy())\n            elif has_marker:\n                assert set(map(int, np.unique(tile))).issubset({bg, separator})\n                marked_origins.append((r0, c0))\n            else:\n                assert np.all(tile == bg), \"unmarked non-source tiles should be plain background\"\n\n    assert len(source_tiles) == 1, \"expected exactly one source sprite tile\"\n    source_tile = source_tiles[0]\n\n    out = g.copy()\n    for r0, c0 in marked_origins:\n        out[r0 : r0 + tile_h, c0 : c0 + tile_w] = source_tile\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette: separator, background, and sprite are distinct.\nCOLOR_POOL = range(10)\nPALETTE_SIZE = 3\n# Tile grid dimensions and odd square tile sizes.\nTILE_ROWS_RANGE = (3, 4)\nTILE_COLS_RANGE = (3, 4)\nTILE_SIZE_CHOICES = [3, 5]\nSEPARATOR_WIDTH = 1\n# Sprite density and 4-connected component count by tile size.\nSPRITE_PIXEL_RANGES = {3: (3, 4), 5: (8, 11)}\nSPRITE_COMPONENT_CAPS = {3: 3, 5: 5}\nNEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nORIENTATION_COUNT = 4\nFLIP_PROBABILITY = 0.5\n# Marker tiles and retry budget.\nMARKER_COUNT_RANGE = (3, 5)\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_neighbors4(r: int, c: int, size: int):\n    for dr, dc in NEIGHBOR_OFFSETS_4:\n        rr, cc = r + dr, c + dc\n        if 0 <= rr < size and 0 <= cc < size:\n            yield rr, cc\n\n\ndef _gen_partition(total: int, parts: int) -> list[int]:\n    sizes = [1] * parts\n    for _ in range(total - parts):\n        sizes[random.randrange(parts)] += 1\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _gen_separate_from_other(labels: np.ndarray, r: int, c: int, label: int) -> bool:\n    size = int(labels.shape[0])\n    for rr, cc in _gen_neighbors4(r, c, size):\n        if labels[rr, cc] not in (0, label):\n            return False\n    return True\n\n\ndef _gen_sprite_tile(size: int, bg: int, sprite_color: int) -> np.ndarray | None:\n    pixel_count = random.randint(*SPRITE_PIXEL_RANGES[size])\n    component_count = random.randint(1, min(SPRITE_COMPONENT_CAPS[size], pixel_count))\n    labels = np.zeros((size, size), dtype=int)\n    for label, component_size in enumerate(_gen_partition(pixel_count, component_count), start=1):\n        seed_candidates = [\n            (r, c)\n            for r in range(size)\n            for c in range(size)\n            if labels[r, c] == 0 and _gen_separate_from_other(labels, r, c, label)\n        ]\n        if not seed_candidates:\n            return None\n\n        seed = random.choice(seed_candidates)\n        labels[seed] = label\n        cells = [seed]\n        while len(cells) < component_size:\n            growth = []\n            for r, c in cells:\n                for rr, cc in _gen_neighbors4(r, c, size):\n                    if labels[rr, cc] == 0 and _gen_separate_from_other(labels, rr, cc, label):\n                        growth.append((rr, cc))\n            if not growth:\n                return None\n            cell = random.choice(growth)\n            labels[cell] = label\n            cells.append(cell)\n\n    tile = np.full((size, size), bg, dtype=int)\n    tile[labels > 0] = sprite_color\n    tile = np.rot90(tile, random.randrange(ORIENTATION_COUNT))\n    if random.random() < FLIP_PROBABILITY:\n        tile = np.fliplr(tile)\n    if random.random() < FLIP_PROBABILITY:\n        tile = np.flipud(tile)\n    return tile.copy()\n\n\ndef _gen_tile_origin(tile_r: int, tile_c: int, tile_size: int) -> tuple[int, int]:\n    return tile_r * (tile_size + SEPARATOR_WIDTH), tile_c * (tile_size + SEPARATOR_WIDTH)\n\n\ndef _gen_base_grid(tile_rows: int, tile_cols: int, tile_size: int, bg: int, separator: int) -> np.ndarray:\n    height = tile_rows * tile_size + (tile_rows - 1) * SEPARATOR_WIDTH\n    width = tile_cols * tile_size + (tile_cols - 1) * SEPARATOR_WIDTH\n    grid = np.full((height, width), bg, dtype=int)\n    grid[tile_size :: tile_size + SEPARATOR_WIDTH, :] = separator\n    grid[:, tile_size :: tile_size + SEPARATOR_WIDTH] = separator\n    return grid\n\n\ndef _gen_paste_tile(grid: np.ndarray, pos: tuple[int, int], tile: np.ndarray, tile_size: int) -> None:\n    r0, c0 = _gen_tile_origin(pos[0], pos[1], tile_size)\n    paste(grid, tile, r0, c0)\n\n\ndef _gen_render_pair(tile_rows, tile_cols, tile_size, separator, bg, sprite_tile, source_pos, marked_positions):\n    expected = _gen_base_grid(tile_rows, tile_cols, tile_size, bg, separator)\n    for pos in [source_pos, *marked_positions]:\n        _gen_paste_tile(expected, pos, sprite_tile, tile_size)\n\n    inp = expected.copy()\n    marker_tile = np.full((tile_size, tile_size), bg, dtype=int)\n    marker_tile[tile_size // 2, tile_size // 2] = separator\n    for pos in marked_positions:\n        _gen_paste_tile(inp, pos, marker_tile, tile_size)\n    return inp, expected\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    separator, bg, sprite_color = random.sample(COLOR_POOL, PALETTE_SIZE)\n    tile_rows, tile_cols, tile_size = (\n        random.randint(*TILE_ROWS_RANGE),\n        random.randint(*TILE_COLS_RANGE),\n        random.choice(TILE_SIZE_CHOICES),\n    )\n\n    sprite_tile = _gen_sprite_tile(tile_size, bg, sprite_color)\n    if sprite_tile is None:\n        return None\n\n    tile_positions = [(r, c) for r in range(tile_rows) for c in range(tile_cols)]\n    source_pos = random.choice(tile_positions)\n    marker_count = random.randint(*MARKER_COUNT_RANGE)\n    marked_positions = random.sample([pos for pos in tile_positions if pos != source_pos], marker_count)\n    inp, expected = _gen_render_pair(\n        tile_rows, tile_cols, tile_size, separator, bg, sprite_tile, source_pos, marked_positions\n    )\n    try:\n        actual = main(inp)\n    except Exception:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/e729b7be.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the scene by adding the point-reflected copy of the colored object across the central marker.\n\n    Input structure\n    - The grid has odd dimensions, a dominant background, and a center-row marker color appearing only at the left edge, center, and right edge.\n    - A single divider color fills the center column except for the center marker.\n    - All remaining foreground pixels form the object to copy, entirely on the left side of the divider.\n    Rule\n    - Keep the input unchanged.\n    - For every object pixel, paint the pixel rotated 180 degrees around the center marker with the same color.\n    Key insight\n    - The center marker is the rotation center; the yellow-looking divider is not mirrored, it only separates the source from the empty target side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h % 2 == 1 and w % 2 == 1\n\n    cr, cc = h // 2, w // 2\n    bg = int(get_bg(g))\n\n    marker_color = int(g[cr, cc])\n    assert marker_color != bg\n    marker_mask = g == marker_color\n    expected_markers = np.zeros(g.shape, dtype=bool)\n    expected_markers[cr, 0] = True\n    expected_markers[cr, cc] = True\n    expected_markers[cr, w - 1] = True\n    assert np.array_equal(marker_mask, expected_markers)\n\n    center_col = g[:, cc]\n    divider_colors = {int(color) for color in np.unique(center_col) if int(color) != marker_color}\n    assert len(divider_colors) == 1\n    divider_color = next(iter(divider_colors))\n    assert divider_color != bg\n    expected_divider = np.zeros(g.shape, dtype=bool)\n    expected_divider[:, cc] = True\n    expected_divider[cr, cc] = False\n    assert np.array_equal(g == divider_color, expected_divider)\n\n    source_mask = (g != bg) & (g != marker_color) & (g != divider_color)\n    source_coords = np.argwhere(source_mask)\n    assert source_coords.size > 0\n    assert np.all(source_coords[:, 1] < cc)\n\n    out = g.copy()\n    for r, c in source_coords:\n        rr = 2 * cr - int(r)\n        rc = 2 * cc - int(c)\n        assert 0 <= rr < h and 0 <= rc < w\n        assert out[rr, rc] == bg\n        out[rr, rc] = g[r, c]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Colors and canvas bounds.\nBG_COLOR, DIVIDER_COLOR, MARKER_COLOR = 7, 4, 8\nGRID_SIZES, MIN_EMPTY_BORDER_ROWS = (15, 17, 19), 1\n\n# Convex source shape bounds.\nSOURCE_SPAN_RANGE = (10, 15)\nSOURCE_MAX_WIDTH_RANGE = (5, 7)\nSOURCE_EDGE_WIDTH_RANGE = (1, 3)\nWIDTH_STEP_CAP, SOURCE_PIXEL_RANGE = 2, (35, 83)\n\n# Color palette, band orders, and retry budget.\nSOURCE_COLORS = (0, 1, 2, 3, 5, 6, 9)\nSOURCE_COLOR_COUNT_RANGE, GEN_ATTEMPTS = (3, 7), 300\nCOLORING_KEYS = (\n    lambda item: (item[2], item[3], item[1]),\n    lambda item: (item[3], item[2], item[1]),\n    lambda item: (item[2] + item[3], item[2], item[1]),\n    lambda item: (item[2] - item[3], item[2], item[1]),\n)\n\n\ndef _gen_bounded_steps(total, slots, cap):\n    steps = []\n    remaining = total\n    for i in range(slots):\n        left = slots - i - 1\n        lo = max(0, remaining - cap * left)\n        hi = min(cap, remaining)\n        step = random.randint(lo, hi)\n        steps.append(step)\n        remaining -= step\n    return steps\n\n\ndef _gen_width_profile(span, max_width):\n    edge_width_hi = min(SOURCE_EDGE_WIDTH_RANGE[1], max_width)\n    start_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n    end_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n    min_up = (max_width - start_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n    min_down = (max_width - end_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n    if min_up + min_down + 1 > span:\n        return None\n\n    peak_start = random.randint(min_up, span - 1 - min_down)\n    peak_end = random.randint(peak_start, span - 1 - min_down)\n\n    widths = [start_width]\n    for step in _gen_bounded_steps(max_width - start_width, peak_start, WIDTH_STEP_CAP):\n        widths.append(widths[-1] + step)\n\n    widths.extend([max_width] * (peak_end - peak_start))\n\n    current = max_width\n    for step in _gen_bounded_steps(max_width - end_width, span - 1 - peak_end, WIDTH_STEP_CAP):\n        current -= step\n        widths.append(current)\n\n    area = sum(widths)\n    if not SOURCE_PIXEL_RANGE[0] <= area <= SOURCE_PIXEL_RANGE[1]:\n        return None\n    return widths\n\n\ndef _choose_source_extent(n, cr):\n    valid_spans = [s for s in range(SOURCE_SPAN_RANGE[0], SOURCE_SPAN_RANGE[1] + 1) if s <= n - 2 * MIN_EMPTY_BORDER_ROWS]\n    span = random.choice(valid_spans)\n    r0_min = max(MIN_EMPTY_BORDER_ROWS, cr - span + 1)\n    r0_max = min(cr, n - MIN_EMPTY_BORDER_ROWS - span)\n    r0 = random.randint(r0_min, r0_max)\n    return span, r0, cr - r0\n\n\ndef _paint_source_cells(out, r0, widths, outer, cc):\n    interior = []\n    source = []\n    for i, width in enumerate(widths):\n        r = r0 + i\n        c0 = cc - width\n        for j in range(width):\n            c = c0 + j\n            source.append((r, c))\n            if j == 0:\n                out[r, c] = outer\n            else:\n                interior.append((r, c, i, j))\n    return source, interior\n\n\ndef _gen_color_source(out, r0, widths, colors, cc):\n    outer = colors[0]\n    inner = colors[1:]\n    source, interior = _paint_source_cells(out, r0, widths, outer, cc)\n    if len(interior) < len(inner):\n        return None\n\n    key = COLORING_KEYS[random.randrange(len(COLORING_KEYS))]\n    interior.sort(key=key)\n    band_count = len(inner)\n    for rank, (r, c, _, _) in enumerate(interior):\n        out[r, c] = inner[min(band_count - 1, rank * band_count // len(interior))]\n\n    return source\n\n\ndef _reflect_source(out, source, cr, cc):\n    reflected = []\n    for r, c in source:\n        rr = 2 * cr - r\n        rc = 2 * cc - c\n        if out[rr, rc] != BG_COLOR:\n            return None\n        out[rr, rc] = out[r, c]\n        reflected.append((rr, rc))\n    return reflected\n\n\ndef _gen_attempt():\n    n = random.choice(GRID_SIZES)\n    cr = cc = n // 2\n    out = np.full((n, n), BG_COLOR, dtype=int)\n    out[:, cc] = DIVIDER_COLOR\n    out[cr, [0, cc, n - 1]] = MARKER_COLOR\n\n    span, r0, center_i = _choose_source_extent(n, cr)\n    max_width = random.randint(*SOURCE_MAX_WIDTH_RANGE)\n    widths = _gen_width_profile(span, max_width)\n    if widths is None:\n        return None\n    if widths[center_i] >= cc:\n        return None\n\n    color_count = random.randint(*SOURCE_COLOR_COUNT_RANGE)\n    colors = random.sample(SOURCE_COLORS, color_count)\n    source = _gen_color_source(out, r0, widths, colors, cc)\n    if source is None:\n        return None\n\n    reflected = _reflect_source(out, source, cr, cc)\n    if reflected is None:\n        return None\n\n    inp = out.copy()\n    for r, c in reflected:\n        inp[r, c] = BG_COLOR\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input():\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid e729b7be input\")\n","exit_code":0,"status":"completed"}}
