{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\n\nBG=0\nH_RANGE=(18,29)\nW_RANGE=(18,29)\nRECT_COUNT=(3,6)\nMIN_SIDE=5\nMAX_SIDE=16\nPOOL_MIN=5\nPOOL_MAX=8\n\ndef perimeter_cells(b):\n    r0,c0,r1,c1=b\n    cells=[]\n    for c in range(c0,c1+1):\n        cells.append((r0,c))\n    for c in range(c0,c1+1):\n        cells.append((r1,c))\n    for r in range(r0+1,r1):\n        cells.append((r,c0))\n    for r in range(r0+1,r1):\n        cells.append((r,c1))\n    return set(cells)\n\ndef draw(g,b,color):\n    r0,c0,r1,c1=b\n    g[r0,c0:c1+1]=color\n    g[r1,c0:c1+1]=color\n    g[r0:r1+1,c0]=color\n    g[r0:r1+1,c1]=color\n\ndef overlap(a,b):\n    return bool(perimeter_cells(a) & perimeter_cells(b))\n\ndef seg(a,b):\n    def olen(x0,x1,y0,y1):\n        return max(0,min(x1,y1)-max(x0,y0)+1)\n    ar0,ac0,ar1,ac1=a\n    br0,bc0,br1,bc1=b\n    for ra in (ar0,ar1):\n        for rb in (br0,br1):\n            if ra==rb and olen(ac0,ac1,bc0,bc1)>=3:\n                return True\n    for ca in (ac0,ac1):\n        for cb in (bc0,bc1):\n            if ca==cb and olen(ar0,ar1,br0,br1)>=3:\n                return True\n    return False\n\ndef bbox(coords):\n    return tuple(map(int,[coords[:,0].min(),coords[:,1].min(),coords[:,0].max(),coords[:,1].max()]))\n\ndef scene(rects,order,shape,colors):\n    g=np.zeros(shape,dtype=int)\n    for i in order:\n        draw(g,rects[i],colors[i])\n    return g\n\ndef valid(scene_g,rects,colors):\n    hidden=0\n    for rect,color in zip(rects,colors):\n        coords=np.argwhere(scene_g==color)\n        if coords.size==0:\n            return False\n        if bbox(coords)\"'!=rect:\n            return False\n        r0,c0,r1,c1=rect\n        vis={(int(r),int(c)) for r,c in coords}\n        if not any(r==r0 for r,c in vis): return False\n        if not any(r==r1 for r,c in vis): return False\n        if not any(c==c0 for r,c in vis): return False\n        if not any(c==c1 for r,c in vis): return False\n        if len(vis)<len(perimeter_cells(rect)):\n            hidden+=1\n    return hidden>=1\n\ndef attempt(rng):\n    H=int(rng.integers(*H_RANGE))\n    W=int(rng.integers(*W_RANGE))\n    n=int(rng.integers(*RECT_COUNT))\n    force_seg=bool(rng.integers(2))\n    for _ in range(40):\n        rows=sorted(rng.choice(np.arange(1,H-1), size=min(int(rng.integers(POOL_MIN,POOL_MAX+1)), H-2), replace=False).tolist())\n        cols=sorted(rng.choice(np.arange(1,W-1), size=min(int(rng.integers(POOL_MIN,POOL_MAX+1)), W-2), replace=False).tolist())\n        row_pairs=[(rows[i],rows[j]) for i in range(len(rows)) for j in range(i+1,len(rows)) if MIN_SIDE<=rows[j]-rows[i]+1<=MAX_SIDE]\n        col_pairs=[(cols[i],cols[j]) for i in range(len(cols)) for j in range(i+1,len(cols)) if MIN_SIDE<=cols[j]-cols[i]+1<=MAX_SIDE]\n        if row_pairs and col_pairs:\n            break\n    else:\n        return False\n    rects=[]; used=set()\n    for k in range(n):\n        found=None\n        for _ in range(400):\n            rp=row_pairs[int(rng.integers(len(row_pairs)))]\n            cp=col_pairs[int(rng.integers(len(col_pairs)))]\n            rect=(rp[0],cp[0],rp[1],cp[1])\n            if rect in used: continue\n            if k>0 and not any(overlap(rect,other) for other in rects):\n                continue\n            used.add(rect); found=rect; rects.append(rect); break\n        if found is None:\n            return False\n    # connected by construction\n    if force_seg and not any(seg(rects[i],rects[j]) for i in range(n) for j in range(i+1,n)):\n        return False\n    colors=rng.choice(np.arange(1,10), size=n, replace=False).tolist()\n    order=rng.permutation(n).tolist()\n    g=scene(rects,order,(H,W),colors)\n    return valid(g,rects,colors)\n\nrng=np.random.default_rng(0)\nok=0\nfor i in range(200):\n    if attempt(rng): ok+=1\nprint('\"'ok',ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
