al-facing and one vertical-facing normalized rectangle,\n  50:     preserving left-to-right object order.\n  51:     \"\"\"\n  52:     g = np.asarray(grid, dtype=int)\n  53:     bg = get_bg(g)\n  54:     fg_colors = colors_present(g, exclude={bg})\n  55:     assert len(fg_colors) == 1\n  56:     fg = fg_colors[0]\n  57: \n  58:     components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n  59:     assert components\n  60:     components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n  61: \n  62:     dims: list[tuple[int, int]] = []\n  63:     for obj in components:\n  64:         r0, c0, r1, c1 = obj[\"bbox\"]\n  65:         h = r1 - r0 + 1\n  66:         w = c1 - c0 + 1\n  67:         assert obj[\"area\"] == h * w\n  68:         dims.append((h, w))\n  69: \n  70:     out_h = 10\n  71:     out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n  72:     _assert_output_footprints_disjoint(dims)\n  73:     out = np.full((out_h, out_w), bg, dtype=int)\n  74: \n  75:     c = 0\n  76:     for h, w in dims:\n  77:         short, long = min(h, w), max(h, w)\n  78:         assert long <= out_h\n  79:         out[:short, c : c + long] = fg\n  80:         c += long + 1\n  81: \n  82:     c = 0\n  83:     for h, w in dims:\n  84:         short, long = min(h, w), max(h, w)\n  85:         assert long <= out_h\n  86:         out[out_h - long : out_h, c : c + short] = fg\n  87:         c += short + 1\n  88: \n  89:     return out\n  90: \n  91: # --------------- generator (att1) ---------------\n  92: \n  93: # Color palette.\n  94: COLOR_VALUES = tuple(range(10))\n  95: \n  96: # Rectangle counts and dimensions.\n  97: RECT_COUNT_MIN = 4\n  98: RECT_COUNT_MAX = 6\n  99: SHORT_SIDE_MIN = 1\n 100: SHORT_SIDE_MAX = 3\n 101: SIDE_SUM_MAX = 10\n 102: LONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN\n 103: \n 104: # Canvas and packing constraints.\n 105: ARC_GRID_MAX = 30\n 106: OUTPUT_HEIGHT = 10\n 107: GAP_WIDTH = 1\n 108: \n 109: # Retry poli