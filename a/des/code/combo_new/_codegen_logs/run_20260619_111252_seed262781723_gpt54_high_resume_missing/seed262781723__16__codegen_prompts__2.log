\"\n 120:     zone = set()\n 121:     for r, c in pixels:\n 122:         for dr in range(-dist, dist + 1):\n 123:             for dc in range(-dist, dist + 1):\n 124:                 zone.add((r + dr, c + dc))\n 125:     return zone\n 126: \n 127: \n 128: def _build_partition(H: int, W: int) -> np.ndarray:\n 129:     \"\"\"Create an H x W grid partitioned into blue (1) and black (0) regions.\"\"\"\n 130:     grid = np.zeros((H, W), dtype=int)\n 131:     style = random.choice(PARTITION_STYLES)\n 132: \n 133:     if style == 'h_stripes':\n 134:         n_cuts = random.randint(*STRIPE_CUTS_RANGE)\n 135:         cuts = sorted(random.sample(\n 136:             range(CUT_MARGIN, H - CUT_MARGIN), min(n_cuts, H - 2 * CUT_MARGIN)))\n 137:         boundaries = [0] + cuts + [H]\n 138:         first_color = random.randint(0, 1)\n 139:         for i in range(len(boundaries) - 1):\n 140:             grid[boundaries[i]:boundaries[i + 1], :] = (first_color + i) % 2\n 141: \n 142:     elif style == 'rect_inset':\n 143:         bg = random.randint(0, 1)\n 144:         grid[:, :] = bg\n 145:         r0 = random.randint(INSET_MARGIN, H // 3)\n\n 399:     return None\n 400: \n 401: \n 402: def generate_input() -> np.ndarray:\n 403:     for _ in range(MAX_GEN_ATTEMPTS):\n 404:         result = _gen_attempt()\n 405:         if result is not None:\n 406:             return result\n 407:     raise RuntimeError(f\"Failed to generate valid input after {MAX_GEN_ATTEMPTS} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/e3721c99.py =====\n  65:     return mapping\n  66: \n  67: \n  68: def main(grid: np.ndarray) -> np.ndarray:\n  69:     \"\"\"\n  70:     Recolor grey shapes by matching their hole count to a color legend.\n  71: \n  72:     Input structure:\n  73:     - bg = most common color; grey (5) sprites scattered across the grid.\n  74:     - Colored legend shapes (non-bg, non-grey, at least 2×2, not touching the outer border) near grid edge,\n  75:       each with a distinct nu