nd-shaped boolean mask.\"\"\"\n 340:     s = np.zeros((3, 3), dtype=bool)\n 341:     s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n 342:     return s\n 343: \n 344: \n 345: def _make_hollow_sprite(h, w, rng):\n 346:     \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n 347:     sprite = np.ones((h, w), dtype=bool)\n 348:     if h >= 3 and w >= 3:\n 349:         sprite[1:-1, 1:-1] = False\n 350:     # Optionally add internal horizontal wall\n 351:     if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n 352:         br = rng.randint(2, h - 2)\n 353:         n = rng.randint(1, w - 2)\n 354:         s = rng.randint(1, w - 1 - n + 1)\n 355:         sprite[br, s:s + n] = True\n 356:     # Optionally add internal vertical wall\n 357:     if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n 358:         bc = rng.randint(2, w - 2)\n 359:         n = rng.randint(1, h - 2)\n 360:         s = rng.randint(1, h - 1 - n + 1)\n 361:         sprite[s:s + n, bc] = True\n 362:     # Optionally remove border cells for irregularity\n 363:     if rng.random() < _P_BORDER_REMOVAL:\n 364:         bcells = [(r, c) for r in range(h) for c in range(w)\n 365:                   if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n 366:         rng.shuffle(bcells)\n 367:         for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n 368:             test = sprite.copy()\n 369:             test[cr, cc] = False\n 370:             if _get_enclosed_holes(test):\n 371:                 sprite = test\n 372:     if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n 373:         return None\n 374:     return sprite\n 375: \n 376: \n 377: def _choose_colors(rng, N, num_filled):\n 378:     \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n 379:     all_c = list(range(1, 10))\n 380:     rng.shuffle(all_c)\n 381:     border_keys = all_c[:N]\n 382:     rng.shuffle(all_c