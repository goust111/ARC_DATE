 == 0 else 2 * hole_count + 1\n 156: \n 157: \n 158: def _legend_patch(hole_count: int, color: int, arrangement: str) -> np.ndarray:\n 159:     \"\"\"Build a 3xSpan (horizontal) or Spanx3 (vertical) legend patch.\"\"\"\n 160:     span = _legend_span(hole_count)\n 161:     if arrangement == \"horizontal\":\n 162:         patch = np.full((3, span), int(color), dtype=int)\n 163:         if hole_count:\n 164:             patch[1, 1::2] = BG\n 165:     else:\n 166:         patch = np.full((span, 3), int(color), dtype=int)\n 167:         if hole_count:\n 168:             patch[1::2, 1] = BG\n 169:     return patch\n 170: \n 171: \n 172: def _line_span(legends: list[tuple[int, int]]) -> int:\n 173:     \"\"\"Total span of legend patches plus 1-cell gaps between them.\"\"\"\n 174:     return sum(_legend_span(h) for h, _ in legends) + len(legends) - 1\n 175: \n 176: \n 177: def _choose_legends(arrangement: str, max_span: int) -> list[tuple[int, int]]:\n 178:     \"\"\"Pick 2-4 legends with distinct hole counts that fit within max_span.\"\"\"\n 179:     count = random.randint(*LEGEND_COUNT_RANGE)\n 180:     combos = [holes for holes in itertools.combinations(range(MAX_HOLE_COUNT), count)\n 181:               if sum(_legend_span(h) for h in holes) + count - 1 <= max_span]\n 182:     if not combos:\n 183:         return _choose_legends(arrangement, max_span + 2)\n 184:     holes = list(random.choice(combos))\n 185:     random.shuffle(holes)\n 186:     colors = random.sample(LEGEND_COLORS, count)\n 187:     return list(zip(holes, colors))\n 188: \n 189: \n 190: def _place_legend_line(\n 191:     grid: np.ndarray, legends: list[tuple[int, int]], arrangement: str, r: int, c: int\n 192: ) -> None:\n 193:     \"\"\"Paste legend patches sequentially along the arrangement axis.\"\"\"\n 194:     rr, cc = int(r), int(c)\n 195:     for hole_count, color in legends:\n 196:         patch = _legend_patch(hole_count, color, arrangement)\n 197:         paste(grid, patch, rr, cc)\n 198:       