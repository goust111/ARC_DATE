es the compaction direction by clockwise border travel: top -> right, right -> down, bottom -> left, left -> up.\n    - Preserve the order of non-background pixels while sliding them as far as possible in that direction.\n\n    Key insight\n    - The large picture is a scaled symbolic grid, and the blue edge marker acts as a gravity direction rather than as output content.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    symbolic, side, bg = _symbolic_grid(g)\n    return _compact(symbolic, side, bg)\n\n# --------------- generator (att2) ---------------\n\n# Canvas and colors.\nGEN_BG = 0\nGEN_GRID_SHAPE = (30, 30)\nGEN_MARKER_COLOR = 1\nGEN_DOMINANT_COLOR = 8\nGEN_ACCENT_COLORS = [2, 3, 4, 5, 6, 7, 9]\n\n# Symbolic lattice layout.\nGEN_SIDES = [\"top\", \"right\", \"bottom\", \"left\"]\nGEN_SYMBOLIC_HW = (7, 6)\nGEN_SYMBOLIC_VW = (6, 7)\nGEN_DOMINANT_COUNT_RANGE = (13, 17)\nGEN_ACCENT_COUNT_RANGE = (6, 8)\nGEN_SPLIT_INDEX = 3\n\n# Physical lattice coordinates.\nGEN_GAP_SIX_POSITIONS = [1, 5, 9, 17, 21, 25]\nGEN_SEVEN_FROM_MARKER = [2, 6, 10, 14, 18, 22, 26]\nGEN_SEVEN_FROM_OTHER = [1, 5, 9, 13, 17, 21, 25]\nGEN_SYMBOL_PATCH_SIZE = 3\n\n# Generation retries.\nGEN_MAX_ATTEMPTS = 300\n\ndef _gen_compact(symbolic, side, bg):\n    out = np.full_like(symbolic, bg)\n\n    if side == \"top\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, symbolic.shape[1] - len(values) :] = values\n    elif side == \"right\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[symbolic.shape[0] - len(values) :, c] = values\n    elif side == \"bottom\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, : len(values)] = values\n    elif side == \"left\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[: len(values), c] = values\n    else:\n        raise AssertionError(side)\n\n    return out\n\n\ndef _gen_covering_cells(rows, cols, count):\n    rows = list(rows)\n    cols = list(cols)\n    cells = set()\n\n    shuffled_rows = rows[:]\n    random.shuffle(shuffled_rows)\n    for r in shuffled_rows:\n        cells.add((r, random.choice(cols)))\n\n    for c in cols:\n        if all(cc != c for _rr, cc in cells):\n            cells.add((random.choice(rows), c))\n\n    remaining = [(r, c) for r in rows for c in cols if (r, c) not in cells]\n    random.shuffle(remaining)\n    cells.update(remaining[: count - len(cells)])\n    return cells\n\n\ndef _gen_fill(symbolic, rows, cols, count, color):\n    for r, c in _gen_covering_cells(rows, cols, count):\n        symbolic[r, c] = color\n\n\ndef _gen_symbolic(side, bg):\n    color_a, color_b = random.sample(GEN_ACCENT_COLORS, 2)\n\n    if side in (\"top\", \"bottom\"):\n        symbolic = np.full(GEN_SYMBOLIC_HW, bg, dtype=int)\n        dominant_cols = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1]) if side == \"top\" else range(0, GEN_SPLIT_INDEX)\n        accent_cols = range(0, GEN_SPLIT_INDEX) if side == \"top\" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1])\n        _gen_fill(symbolic, range(GEN_SYMBOLIC_HW[0]), dominant_cols, random.randint(*GEN_DOMINANT_COUNT_RANGE), GEN_DOMINANT_COLOR)\n        _gen_fill(symbolic, range(0, GEN_SPLIT_INDEX), accent_cols, random.randint(*GEN_ACCENT_COUNT_RANGE), color_a)\n        _gen_fill(symbolic, range(GEN_SPLIT_INDEX + 1, GEN_SYMBOLIC_HW[0]), accent_cols, random.randint(*GEN_ACCENT_COUNT_RANGE), color_b)\n    else:\n        symbolic = np.full(GEN_SYMBOLIC_VW, bg, dtype=int)\n        dominant_rows = range(0, GEN_SPLIT_INDEX) if side == \"left\" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0])\n        accent_rows = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0]) if side == \"left\" else range(0, GEN_SPLIT_INDEX)\n        _gen_fill(symbolic, dominant_rows, range(GEN_SYMBOLIC_VW[1]), random.randint(*GEN_DOMINANT_COUNT_RANGE), GEN_DOMINANT_COLOR)\n        _gen_fill(symbolic, accent_rows, range(0, GEN_SPLIT_INDEX), random.randint(*GEN_ACCENT_COUNT_RANGE), color_a)\n        _gen_fill(symbolic, accent_rows, range(GEN_SPLIT_INDEX + 1, GEN_SYMBOLIC_VW[1]), random.randint(*GEN_ACCENT_COUNT_RANGE), color_b)\n\n    return symbolic\n\n\ndef _gen_lattice_positions(side):\n    if side == \"top\":\n        return GEN_SEVEN_FROM_MARKER, GEN_GAP_SIX_POSITIONS\n    if side == \"bottom\":\n        return GEN_SEVEN_FROM_OTHER, GEN_GAP_SIX_POSITIONS\n    if side == \"left\":\n        return GEN_GAP_SIX_POSITIONS, GEN_SEVEN_FROM_MARKER\n    return GEN_GAP_SIX_POSITIONS, GEN_SEVEN_FROM_OTHER\n\n\ndef _gen_place_marker(grid, side):\n    if side == \"top\":\n        grid[0, :] = GEN_MARKER_COLOR\n    elif side == \"right\":\n        grid[:, -1] = GEN_MARKER_COLOR\n    elif side == \"bottom\":\n        grid[-1, :] = GEN_MARKER_COLOR\n    else:\n        grid[:, 0] = GEN_MARKER_COLOR\n\n\ndef _gen_hollow_patch(color, bg):\n    patch = np.full((GEN_SYMBOL_PATCH_SIZE, GEN_SYMBOL_PATCH_SIZE), color, dtype=int)\n    patch[GEN_SYMBOL_PATCH_SIZE // 2, GEN_SYMBOL_PATCH_SIZE // 2] = bg\n    return patch\n\n\ndef _gen_expand(symbolic, side, bg):\n    grid = np.full(GEN_GRID_SHAPE, bg, dtype=int)\n    _gen_place_marker(grid, side)\n\n    row_positions, col_positions = _gen_lattice_positions(side)\n    for r in range(symbolic.shape[0]):\n        for c in range(symbolic.shape[1]):\n            color = int(symbolic[r, c])\n            if color == bg:\n                continue\n            paste(grid, _gen_hollow_patch(color, bg), row_positions[r], col_positions[c])\n    return grid\n\n\ndef _gen_attempt():\n    side = random.choice(GEN_SIDES)\n    symbolic = _gen_symbolic(side, GEN_BG)\n    expected = _gen_compact(symbolic, side, GEN_BG)\n    if np.array_equal(symbolic, expected):\n        return None\n\n    inp = _gen_expand(symbolic, side, GEN_BG)\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\n\ndef generate_input():\ndef generate_input():\n    for _ in range(GEN_MAX_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"failed to generate afe3afe9 input\")\nFILE:/home/lixinyu/snap/new/ARC_code/eval/21897d95.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.\n\n    Input structure:\n    - The grid is a mosaic of monochrome regions.\n    - Color 1 forms T-shaped control markers on region boundaries.\n    - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.\n    - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.\n\n    Rule:\n    - For a color-1 T marker, the single stem points at the destination region to repaint.\n    - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.\n    - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.\n    - All marker cells are filled with the final color of the source-side region.\n    - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.\n\n    Key insight:\n    - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = _solve_unrotated(g)\n    l9 = _find_l9_orientation(g)\n    if l9 == 'top_right':\n        return np.rot90(out, 1)\n    if l9 == 'top_left':\n        return np.rot90(out, 3)\n    return out\n\n# --------------- generator (l9rot) ---------------\n\n# ── Tunable constants ──────────────────────────────────────────────────\n# Canvas / region sizing\nGRID_SIZE_MAX = 30                          # max rows or cols\nMIN_REGION_CELLS = 6                        # per-spec minimum\nREGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)\nREGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts\nREGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS\n\n# Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)\nMARKER_MIN = 4\nMARKER_MAX = 8\nNORMAL_MAX = 6\nCOLORED_MAX = 2\n\n# Color pool (all ARC colors except 1, which is reserved for T-marker cells)\nCOLOR_POOL = [c for c in range(10) if c != 1]\n\n# L9 rotation marker\nL9_PROBABILITY = 0.5                        # chance of placing a rotation marker\nL9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation\n    'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],\n    'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],\n}\n\n# Generation retry budget\nSEED_ATTEMPTS = 200                         # tries to place n distinct region seeds\nGEN_RETRIES = 300                           # outer generate_input retry budget\n\n_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n# ── Small geometry helpers ─────────────────────────────────────────────\n\ndef _get_bar(stem):\n    \"\"\"Return the two bar directions perpendicular to *stem*.\"\"\"\n    if stem[0] == 0:\n        return [(-1, 0), (1, 0)]\n    return [(0, -1), (0, 1)]\n\n\ndef _t_cells(center, stem):\n    \"\"\"Return the 4 cells of a T marker: center + stem tip + 2 bar cells.\"\"\"\n    r, c = center\n    bar = _get_bar(stem)\n    return {(r, c), (r + stem[0], c + stem[1]),\n            (r + bar[0][0], c + bar[0][1]), (r + bar[1][0], c + bar[1][1])}\n\n\ndef _t_branch_cells(center, stem):\n    \"\"\"Return the 3 branch cells (stem tip + 2 bar), excluding the center.\"\"\"\n    r, c = center\n    bar = _get_bar(stem)\n    return {(r + stem[0], c + stem[1]),\n            (r + bar[0][0], c + bar[0][1]),\n            (r + bar[1][0], c + bar[1][1])}\n\n\ndef _t_neighborhood(center, stem):\n    \"\"\"Return cells adjacent to any T cell but not part of the T itself.\"\"\"\n    cells = _t_cells(center, stem)\n    neighborhood = set()\n    for r, c in cells:\n        for dr, dc in _DIRS:\n            nb = (r + dr, c + dc)\n            if nb not in cells:\n                neighborhood.add(nb)\n    return neighborhood\n\n\n# ── Region partitioning ────────────────────────────────────────────────\n\ndef _grow_regions(H: int, W: int, n_regions: int) -> np.ndarray | None:\n    \"\"\"Grow n_regions from random seeds via randomized BFS; returns region-id array or None.\"\"\"\n    region = np.full((H, W), -1, dtype=int)\n    seeds = set()\n    for _ in range(SEED_ATTEMPTS):\n        if len(seeds) >= n_regions:\n            break\n        seeds.add((random.randint(1, H - 2), random.randint(1, W - 2)))\n    if len(seeds) < n_regions:\n        return None\n\n    frontier = []\n    for i, (r, c) in enumerate(list(seeds)):\n        region[r, c] = i\n        for dr, dc in _DIRS:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:\n                frontier.append((nr, nc, i))\n    random.shuffle(frontier)\n\n    while frontier:\n        idx = random.randint(0, len(frontier) - 1)\n        r, c, rid = frontier[idx]\n        frontier[idx] = frontier[-1]\n        frontier.pop()\n        if region[r, c] != -1:\n            continue\n        region[r, c] = rid\n        for dr, dc in _DIRS:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:\n                frontier.append((nr, nc, rid))\n\n    # Validate: each region must be 4-connected and have enough cells\n    for rid in range(n_regions):\n        mask = region == rid\n        if mask.sum() < MIN_REGION_CELLS:\n            return None\n        _, n = label_mask(mask, connectivity=4)\n        if n != 1:\n            return None\n    return region\n\n\n# ── Adjacency discovery ───────────────────────────────────────────────\n\ndef _find_adjacent_pairs(region: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Return all directed (src, dst) pairs between adjacent regions.\"\"\"\n    H, W = region.shape\n    # Detect boundaries via horizontal and vertical neighbor differences\n    undirected = set()\n    for r in range(H):\n        for c in range(W):\n            for dr, dc in _DIRS:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < H and 0 <= nc < W:\n                    a, b = int(region[r, c]), int(region[nr, nc])\n                    if a != b:\n                        undirected.add((min(a, b), max(a, b)))\n    directed = []\n    for a, b in undirected:\n        directed.append((a, b))\n        directed.append((b, a))\n    return directed\n\n\n# ── Marker count selection ─────────────────────────────────────────────\n\ndef _choose_marker_counts(n_regions: int) -> tuple[int, int, int] | None:\n    \"\"\"Return (n_markers, n_normal, n_colored) or None if infeasible.\"\"\"\n    max_possible = min(MARKER_MAX, n_regions)\n    if max_possible < MARKER_MIN:\n        return None\n    n_markers = random.randint(MARKER_MIN, max_possible)\n    n_colored = random.randint(0, min(COLORED_MAX, n_markers - 2))\n    n_normal = n_markers - n_colored\n    if n_normal > NORMAL_MAX:\n        n_colored = n_markers - NORMAL_MAX\n        n_normal = NORMAL_MAX\n        if n_colored > COLORED_MAX:\n            n_markers = NORMAL_MAX + COLORED_MAX\n            n_colored = COLORED_MAX\n            n_normal = NORMAL_MAX\n    return n_markers, n_normal, n_colored\n\n\n# ── Marker placement search ───────────────────────────────────────────\n\ndef _find_valid_placements(region, src, dst, occupied_cells, occupied_neighbors, H, W):\n    \"\"\"Find all valid (center, stem) for placing a T marker from src toward dst.\"\"\"\n    candidates = []\n    for r in range(1, H - 1):\n        for c in range(1, W - 1):\n            for stem in _DIRS:\n                bar = _get_bar(stem)\n                cells = _t_cells((r, c), stem)\n                if not all(0 <= cr < H and 0 <= cc < W for cr, cc in cells):\n                    continue\n                if cells & occupied_cells:\n                    continue\n                if _t_neighborhood((r, c), stem) & occupied_cells:\n                    continue\n                if cells & occupied_neighbors:\n                    continue\n                # Diagonal cells (stem + each bar dir) must lie in source region\n                if not all(\n                    0 <= r + stem[0] + bd[0] < H and\n                    0 <= c + stem[1] + bd[1] < W and\n                    region[r + stem[0] + bd[0], c + stem[1] + bd[1]] == src\n                    for bd in bar\n                ):\n                    continue\n                # Walk along stem from step=2 until we hit dst or leave bounds\n                step = 2\n                found = False\n                while True:\n                    nr, nc = r + stem[0] * step, c + stem[1] * step\n                    if not (0 <= nr < H and 0 <= nc < W):\n                        break\n                    if (nr, nc) in occupied_cells or (nr, nc) in cells:\n                        step += 1\n                        continue\n                    found = int(region[nr, nc]) == dst\n                    break\n                if found:\n                    candidates.append(((r, c), stem))\n    return candidates\n\n\ndef _register_marker(kind, center, stem, occupied_cells, occupied_neighbors):\n    \"\"\"Update occupied_cells and occupied_neighbors after placing a marker.\"\"\"\n    cells = _t_cells(center, stem)\n    if kind == 'normal':\n        occupied_cells |= cells\n        occupied_neighbors |= (_t_neighborhood(center, stem) - cells)\n    else:\n        branch = _t_branch_cells(center, stem)\n        occupied_cells |= branch\n        occupied_cells.add(center)\n        # Each branch cell must remain a singleton: buffer all non-marker neighbors\n        for br, bc in branch:\n            for dr, dc in _DIRS:\n                nb = (br + dr, bc + dc)\n                if nb != center and nb not in branch:\n                    occupied_neighbors.add(nb)\n        for dr, dc in _DIRS:\n            nb = (center[0] + dr, center[1] + dc)\n            if nb not in branch:\n                occupied_neighbors.add(nb)\n\n\n# ── Grid construction ─────────────────────────────────────────────────\n\ndef _build_color_map(region: np.ndarray, colors: list[int]) -> np.ndarray:\n    \"\"\"Map region ids to colors via vectorized lookup.\"\"\"\n    lut = np.array(colors, dtype=int)\n    return lut[region]\n\n\ndef _stamp_markers_input(grid, placed_markers):\n    \"\"\"Write T-marker cells onto the input grid.\"\"\"\n    for kind, center, stem, _src, _dst, tc in placed_markers:\n        if kind == 'normal':\n            for cr, cc in _t_cells(center, stem):\n                grid[cr, cc] = 1\n        else:\n            grid[center[0], center[1]] = tc\n            for cr, cc in _t_branch_cells(center, stem):\n                grid[cr, cc] = 1\n\n\ndef _stamp_markers_output(grid, placed_markers, out_colors):\n    \"\"\"Fill marker cells in the output grid with the source region's final color.\"\"\"\n    for kind, center, stem, src, _dst, _tc in placed_markers:\n        color = out_colors[src]\n        for cr, cc in _t_cells(center, stem):\n            grid[cr, cc] = color\n\n\n# ── L9 rotation marker ────────────────────────────────────────────────\n\ndef _try_place_l9(region, placed_markers, occupied_neighbors, input_grid, output_grid, out_colors):\n    \"\"\"Attempt to place a 5-cell L9 marker; return orientation string or None.\"\"\"\n    if random.random() >= L9_PROBABILITY:\n        return None\n    orient = random.choice(list(L9_OFFSETS))\n    offsets = L9_OFFSETS[orient]\n    H, W = region.shape\n\n    all_marker_cells = set()\n    for kind, center, stem, *_ in placed_markers:\n        all_marker_cells |= _t_cells(center, stem)\n\n    candidates = []\n    for r in range(H):\n        for c in range(W):\n            cells = [(r + dr, c + dc) for dr, dc in offsets]\n            if not all(0 <= cr < H and 0 <= cc < W for cr, cc in cells):\n                continue\n            rid = int(region[r, c])\n            if not all(int(region[cr, cc]) == rid for cr, cc in cells):\n                continue\n            if any((cr, cc) in all_marker_cells for cr, cc in cells):\n                continue\n            if any((cr, cc) in occupied_neighbors for cr, cc in cells):\n                continue\n            candidates.append((r, c, rid))\n\n    if not candidates:\n        return None\n    lr, lc, rid = random.choice(candidates)\n    for dr, dc in offsets:\n        input_grid[lr + dr, lc + dc] = 9\n        output_grid[lr + dr, lc + dc] = out_colors[rid]\n    return orient\n\n\n# ── Main generation attempt ───────────────────────────────────────────\n\ndef _gen_attempt() -> np.ndarray | None:\n    n_regions = random.choices(REGION_COUNTS, weights=REGION_WEIGHTS)[0]\n    min_size = max(9, int(n_regions * REGION_SIZE_FACTOR))\n    H = random.randint(min_size, GRID_SIZE_MAX)\n    W = random.randint(min_size, GRID_SIZE_MAX)\n\n    region = _grow_regions(H, W, n_regions)\n    if region is None:\n        return None\n\n    directed_pairs = _find_adjacent_pairs(region)\n\n    counts = _choose_marker_counts(n_regions)\n    if counts is None:\n        return None\n    n_markers, n_normal, n_colored = counts\n\n    # Select src->dst pairs with unique destinations\n    random.shuffle(directed_pairs)\n    dest_used = set()\n    marker_pairs = []\n    for src, dst in directed_pairs:\n        if dst not in dest_used:\n            marker_pairs.append((src, dst))\n            dest_used.add(dst)\n            if len(marker_pairs) >= n_markers:\n                break\n    if len(marker_pairs) < n_markers:\n        n_markers = len(marker_pairs)\n        if n_markers < MARKER_MIN:\n            return None\n        n_colored = min(n_colored, n_markers - 1)\n        n_normal = n_markers - n_colored\n    random.shuffle(marker_pairs)\n\n    # Assign input colors\n    pool = list(COLOR_POOL)\n    random.shuffle(pool)\n    if n_regions > len(pool):\n        return None\n    input_colors = pool[:n_regions]\n\n    # Compute output colors from recoloring rules\n    out_colors = list(input_colors)\n    normal_pairs = marker_pairs[:n_normal]\n    colored_pairs = marker_pairs[n_normal:]\n\n    colored_targets = []\n    for _src, dst in colored_pairs:\n        cands = [c for c in pool if c != input_colors[dst]]\n        if not cands:\n            return None\n        colored_targets.append(random.choice(cands))\n\n    for src, dst in normal_pairs:\n        out_colors[dst] = input_colors[src]\n    for (src, dst), tc in zip(colored_pairs, colored_targets):\n        out_colors[dst] = tc\n\n    # Build marker definitions and place them\n    all_defs = [('normal', s, d, None) for s, d in normal_pairs] + \\\n               [('colored', s, d, tc) for (s, d), tc in zip(colored_pairs, colored_targets)]\n    random.shuffle(all_defs)\n\n    occupied_cells: set[tuple[int, int]] = set()\n    occupied_neighbors: set[tuple[int, int]] = set()\n    placed_markers = []\n    for kind, src, dst, tc in all_defs:\n        cands = _find_valid_placements(region, src, dst, occupied_cells, occupied_neighbors, H, W)\n        if not cands:\n            return None\n        center, stem = random.choice(cands)\n        _register_marker(kind, center, stem, occupied_cells, occupied_neighbors)\n        placed_markers.append((kind, center, stem, src, dst, tc))\n\n    # Build grids via vectorized lookup\n    input_grid = _build_color_map(region, input_colors)\n    output_grid = _build_color_map(region, out_colors)\n\n    _stamp_markers_input(input_grid, placed_markers)\n    _stamp_markers_output(output_grid, placed_markers, out_colors)\n\n    # Optional L9 rotation marker\n    l9_orient = _try_place_l9(region, placed_markers, occupied_neighbors,\n                              input_grid, output_grid, out_colors)\n    if l9_orient == 'top_right':\n        output_grid = np.rot90(output_grid, 1)\n    elif l9_orient == 'top_left':\n        output_grid = np.rot90(output_grid, 3)\n\n    try:\n        result = main(input_grid)\n    except Exception:\n        return None\n    return input_grid if np.array_equal(result, output_grid) else None\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
