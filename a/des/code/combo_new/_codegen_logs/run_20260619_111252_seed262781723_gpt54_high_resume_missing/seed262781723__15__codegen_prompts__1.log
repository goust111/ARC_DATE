                    sprite[r, c] = color\n 118:                     sprite[r, SPRITE_SIZE - 1 - c] = color\n 119:         area = int(np.count_nonzero(sprite))\n 120:         if area != target_area:\n 121:             continue\n 122:         if not is_contiguous(sprite, background=BACKGROUND, connectivity=4):\n 123:             continue\n 124:         if not (np.any(sprite[0] != BACKGROUND) and np.any(sprite[-1] != BACKGROUND) and\n 125:                 np.any(sprite[:, 0] != BACKGROUND) and np.any(sprite[:, -1] != BACKGROUND)):\n 126:             continue\n 127:         padded = np.zeros((SPRITE_SIZE + 2, SPRITE_SIZE + 2), dtype=int)\n 128:         padded[1:-1, 1:-1] = sprite\n 129:         interior = object_interior(padded, background=BACKGROUND)\n 130:         holes = int(np.sum(interior & (padded == BACKGROUND)))\n 131:         if holes > MAX_INTERIOR_HOLES:\n 132:             continue\n 133:         return sprite\n 134:     return None\n 135: \n 136: \n 137: def _boxes_overlap(a, b):\n 138:     return a[0] <= b[2] and a[2] >= b[0] and a[1] <= b[3] and a[3] >= b[1]\n 139: \n 140: \n 141: def _draw_legend(grid, src1, halo1, src2, halo2):\n 142:     lower_top = grid.shape[0] - LEGEND_MARKER_SIZE\n 143:     upper_top = lower_top - LEGEND_VERTICAL_GAP - LEGEND_MARKER_SIZE\n 144:     grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src1\n 145:     grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo1\n 146:     grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src2\n 147:     grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo2\n--- lines 260-265 ---\n 260: def generate_input() -> np.ndarray:\n 261:     for _ in range(GENERATION_RETRIES):\n 262:         result = _gen_attempt()\n 263:         if result is not None:\n 264:             return result\n 265:     raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRIES} attempts\")\n\n================================================================================\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\n--- lines 274-414 ---\n 274: def main(grid: np.ndarray) -> np.ndarray:\n 275:     \"\"\"\n 276:     Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n 277: \n 278:     Input structure:\n 279:     - bg = most common color. Several hollow sprites with distinct border colors.\n 280:     - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n 281: \n 282:     Rule:\n 283:     - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n 284:     - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n 285:     - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n 286: \n 287:     Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n 288:     \"\"\"\n 289:     g = np.asarray(grid, dtype=int)\n 290:     bg = _bg_boundary(g)\n 291: \n 292:     mapping, pal_mask = _palette_mapping(g, bg)\n 293:     assert mapping, \"main: palette mapping must be non-empty\"\n 294: \n 295:     out = g.copy()\n 296:     _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n 297: \n 298:     return out\n 299: \n 300: # --------------- generator (c) ---------------\n 301: \n 302: # -- Configuration constants --------------------------------------------------\n 303: # Grid dimensions\n 304: _GRID_H_MIN, _GRID_H_MAX = 4, 13\n 305: _GRID_W_MIN, _GRID_W_MAX = 10, 15\n 306: _SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n 307: _SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n 308: _TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n 309: \n 310: # Palette\n 311: _PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n 312: \n 313: # Sprite geometry\n 314: _SPRITE_H_MAX = 7\n 315: _SPRITE_W_MAX = 6\n 316: _SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n 317: _SPRITE_CELL_MAX = 16\n 318: _FILLED_SPRITE_MAX = 3\n 319: \n 320: # Sprite mutation probabilities\n 321: _P_HORIZ_WALL = 0.3           # add horizontal internal wall\n 322: _P_VERT_WALL = 0.3            # add vertical internal wall\n 323: _P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n 324: _P_DIAMOND = 0.2              # use diamond shape for 3x3\n 325: \n 326: # Generation\n 327: _MAX_RETRIES = 300\n 328: # -- End configuration --------------------------------------------------------\n 329: \n 330: \n 331: def _get_enclosed_holes(sprite):\n 332:     \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n 333:     h, w = sprite.shape\n 334:     return [pts for pts in components_mask(~sprite, connectivity=4)\n 335:             if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n 336: \n 337: \n 338: def _make_diamond():\n 339:     \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n 340:     s = np.zeros((3, 3), dtype=bool)\n 341:     s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n 342:     return s\n 343: \n 344: \n 345: def _make_hollow_sprite(h, w, rng):\n 346:     \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n 347:     sprite = np.ones((h, w), dtype=bool)\n 348:     if h >= 3 and w >= 3:\n 349:         sprite[1:-1, 1:-1] = False\n 350:     # Optionally add internal horizontal wall\n 351:     if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n 352:         br = rng.randint(2, h - 2)\n 353:         n = rng.randint(1, w - 2)\n 354:         s = rng.randint(1, w - 1 - n + 1)\n 355:         sprite[br, s:s + n] = True\n 356:     # Optionally add internal vertical wall\n 357:     if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n 358:         bc = rng.randint(2, w - 2)\n 359:         n = rng.randint(1, h - 2)\n 360:         s = rng.randint(1, h - 1 - n + 1)\n 361:         sprite[s:s + n, bc] = True\n 362:     # Optionally remove border cells for irregularity\n 363:     if rng.random() < _P_BORDER_REMOVAL:\n 364:         bcells = [(r, c) for r in range(h) for c in range(w)\n 365:                   if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n 366:         rng.shuffle(bcells)\n 367:         for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n 368:             test = sprite.copy()\n 369:             test[cr, cc] = False\n 370:             if _get_enclosed_holes(test):\n 371:                 sprite = test\n 372:     if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n 373:         return None\n 374:     return sprite\n 375: \n 376: \n 377: def _choose_colors(rng, N, num_filled):\n 378:     \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n 379:     all_c = list(range(1, 10))\n 380:     rng.shuffle(all_c)\n 381:     border_keys = all_c[:N]\n 382:     rng.shuffle(all_c)\n 383:     fill_values = all_c[:N]\n 384:     dist_cands = [c for c in range(1, 10) if c not in border_keys]\n 385:     distractor_color = rng.choice(dist_cands)\n 386:     mapping = dict(zip(border_keys, fill_values))\n 387:     filled_keys = rng.sample(border_keys, num_filled)\n 388:     return border_keys, fill_values, distractor_color, mapping, filled_keys\n 389: \n 390: \n 391: def _build_palette(side, border_keys, fill_values):\n 392:     \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n 393:     N = len(border_keys)\n 394:     if side in ('top', 'bottom'):\n 395:         pal = np.zeros((2, N), dtype=int)\n 396:         outer, inner = (0, 1) if side == 'top' else (1, 0)\n 397:         pal[outer] = border_keys\n 398:         pal[inner] = fill_values\n 399:     else:\n 400:         pal = np.zeros((N, 2), dtype=int)\n 401:         outer, inner = (0, 1) if side == 'left' else (1, 0)\n 402:         pal[:, outer] = border_keys\n 403:         pal[:, inner] = fill_values\n 404:     return pal\n 405: \n 406: \n 407: def _place_palette(grid, occ, pal, side, rng):\n 408:     \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n 409:     H, W = grid.shape\n 410:     pal_h, pal_w = pal.shape\n 411:     if side == 'top':\n 412:         pr0, pc0 = 0, rng.randint(0, W - pal_w)\n 413:     elif side == 'bottom':\n 414:         pr0, pc0 = H - pal_h, rng.randint(0, W - pal_w)\n--- lines 544-549 ---\n 544: def generate_input():\n 545:     for _ in range(_MAX_RETRIES):\n 546:         r = _gen_attempt()\n 547:         if r is not None:\n 548:             return r\n 549:     raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\n================================================================================\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py\n--- lines 34-174 ---\n  34: def main(grid: np.ndarray) -> np.ndarray:\n  35:     \"\"\"\n  36:     Move colored sprites from the left strip into a framed area at marker-defined targets.\n  37: \n  38:     Input structure:\n  39:     - bg background; rectangular frame on right with colored markers on its edges; sprites in a narrow left strip separated by a constant-color divider column.\n  40: \n  41:     Rule:\n  42:     - For each color, target rows/cols are where both opposite frame edges share that color. Targets are the Cartesian product.\n  43:     - Erase each sprite from the left and stamp it centered at every target. Higher sprites cover lower ones.\n  44: \n  45:     Key insight: One sprite replicates to a grid of row × column marker intersections.\n  46:     \"\"\"\n  47:     g = np.array(grid, dtype=int)\n  48:     H, W = g.shape\n  49:     bg = int(get_bg(g))\n  50: \n  51:     # --- frame interior: largest bg component not touching boundary ---\n  52:     inner_bbox = largest_enclosed_component_bbox(g == int(bg), connectivity=4)\n  53:     assert not (inner_bbox is None)\n  54:     ir0, ic0, ir1, ic1 = map(int, inner_bbox)\n  55:     fr0, fc0, fr1, fc1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)\n  56: \n  57:     # --- divider columns (fixed) on the left side ---\n  58:     divider_mask = np.zeros((H, W), dtype=bool)\n  59:     for c in range(0, max(0, int(fc0))):\n  60:         colv = g[:, int(c)]\n  61:         non = colv[colv != int(bg)]\n  62:         if int(len(non)) >= int(H - 1) and len(set(map(int, non))) == 1:\n  63:             divider_mask[:, int(c)] = True\n  64: \n  65:     left_cols = (np.arange(W)[None, :] < int(fc0))\n  66: \n  67:     # --- sprites: per-color 8-connected components in left area (excluding divider) ---\n  68:     sprites = []\n  69:     for col in sorted(set(map(int, g.flatten())) - {int(bg)}):\n  70:         mask = (g == int(col)) & left_cols & (~divider_mask)\n  71:         if not bool(mask.any()):\n  72:             continue\n  73:         slab, sn = label_mask(mask, connectivity=8)\n  74:         for sid in range(1, int(sn) + 1):\n  75:             pts = np.argwhere(slab == int(sid))\n  76:             r0, c0 = pts.min(axis=0)\n  77:             r1, c1 = pts.max(axis=0)\n  78:             r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n  79:             m = slab[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(sid)\n  80:             sprites.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"r1\": int(r1), \"c1\": int(c1), \"mask\": m})\n  81: \n  82:     move_colors = {int(s[\"color\"]) for s in sprites}\n  83: \n  84:     # --- marker-derived targets (restricted to colors that actually appear as sprites) ---\n  85:     row_marks: dict[int, list[int]] = defaultdict(list)\n  86:     col_marks: dict[int, list[int]] = defaultdict(list)\n  87:     for r in range(int(ir0), int(ir1) + 1):\n  88:         cl = int(g[int(r), int(fc0)])\n  89:         cr = int(g[int(r), int(fc1)])\n  90:         if cl == cr and cl != int(bg) and cl in move_colors:\n  91:             row_marks[int(cl)].append(int(r))\n  92:     for c in range(int(ic0), int(ic1) + 1):\n  93:         ct = int(g[int(fr0), int(c)])\n  94:         cb = int(g[int(fr1), int(c)])\n  95:         if ct == cb and ct != int(bg) and ct in move_colors:\n  96:             col_marks[int(ct)].append(int(c))\n  97: \n  98:     targets: dict[int, list[tuple[int, int]]] = {}\n  99:     for col in set(row_marks.keys()) & set(col_marks.keys()):\n 100:         pts = {(int(r), int(c)) for r in row_marks[int(col)] for c in col_marks[int(col)]}\n 101:         targets[int(col)] = sorted(pts)\n 102: \n 103:     out = g.copy()\n 104:     movers = [s for s in sprites if int(s[\"color\"]) in targets]\n 105: \n 106:     # Erase originals of moved sprites.\n 107:     for s in movers:\n 108:         r0, c0 = int(s[\"r0\"]), int(s[\"c0\"])\n 109:         for rr, cc in np.argwhere(s[\"mask\"]):\n 110:             out[int(r0) + int(rr), int(c0) + int(cc)] = int(bg)\n 111: \n 112:     # Bottom-to-top ordering: lower sprites first, upper sprites last (covering).\n 113:     movers.sort(key=lambda s: (-((int(s[\"r0\"]) + int(s[\"r1\"])) / 2.0), int(s[\"c0\"])))\n 114: \n 115:     for s in movers:\n 116:         col = int(s[\"color\"])\n 117:         cr = (int(s[\"r0\"]) + int(s[\"r1\"])) // 2\n 118:         cc = (int(s[\"c0\"]) + int(s[\"c1\"])) // 2\n 119:         pix = [(int(s[\"r0\"]) + int(rr), int(s[\"c0\"]) + int(cc2)) for rr, cc2 in np.argwhere(s[\"mask\"])]\n 120: \n 121:         for tr, tc in targets[int(col)]:\n 122:             dr = int(tr - cr)\n 123:             dc = int(tc - cc)\n 124:             for r, c in pix:\n 125:                 rr = int(r + dr)\n 126:                 cc3 = int(c + dc)\n 127:                 if int(ir0) <= rr <= int(ir1) and int(ic0) <= cc3 <= int(ic1):\n 128:                     out[rr, cc3] = int(col)\n 129: \n 130:     return out\n 131: \n 132: \n 133: # ---------------------------------------------------------------------------\n 134: # generate_input\n 135: # ---------------------------------------------------------------------------\n 136: import random\n 137: \n 138: \n 139: def _pick_spaced(candidates: list[int], n: int, min_spacing: int) -> list[int] | None:\n 140:     \"\"\"Pick up to n values from candidates with at least min_spacing between any two.\"\"\"\n 141:     if not candidates:\n 142:         return None\n 143:     if n == 1:\n 144:         return [random.choice(candidates)]\n 145:     random.shuffle(candidates)\n 146:     picked: list[int] = []\n 147:     for v in candidates:\n 148:         if all(abs(v - p) >= min_spacing for p in picked):\n 149:             picked.append(v)\n 150:             if len(picked) == n:\n 151:                 return picked\n 152:     return picked if picked else None\n 153: \n 154: \n 155: def _make_sprite(color: int, max_h: int, max_w: int) -> np.ndarray | None:\n 156:     \"\"\"Generate a single-color 8-connected sprite cropped to its bounding box.\"\"\"\n 157:     sh = min(random.choice([3, 3, 3, 4, 5]), max_h)\n 158:     sw = min(random.choice([3, 3, 3, 4, 5]), max_w)\n 159:     if sh < 1 or sw < 1:\n 160:         return None\n 161:     n_pixels = random.randint(3, min(9, sh * sw))\n 162:     pixels = {(sh // 2, sw // 2)}\n 163:     r, c = sh // 2, sw // 2\n 164:     for _ in range(n_pixels * 30):\n 165:         if len(pixels) >= n_pixels:\n 166:             break\n 167:         dr, dc = random.choice([(0, 1), (0, -1), (1, 0), (-1, 0),\n 168:                                  (1, 1), (1, -1), (-1, 1), (-1, -1)])\n 169:         nr, nc = r + dr, c + dc\n 170:         if 0 <= nr < sh and 0 <= nc < sw:\n 171:             pixels.add((nr, nc))\n 172:             r, c = nr, nc\n 173:     rows = [p[0] for p in pixels]\n 174:     cols = [p[1] for p in pixels]\n--- lines 306-311 ---\n 306: def generate_input() -> np.ndarray:\n 307:     for _ in range(300):\n 308:         result = _gen_attempt()\n 309:         