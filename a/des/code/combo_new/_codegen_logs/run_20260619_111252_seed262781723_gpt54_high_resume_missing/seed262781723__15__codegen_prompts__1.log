{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/a/des/code/combo_new/seed262781723/15/1.py | sed -n '1,260p'\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\t\n     3\tfrom collections import deque\n     4\timport random\n     5\t\n     6\timport numpy as np\n     7\t\n     8\t\n     9\tBG_COLOR = 0\n    10\tFRAME_COLOR = 5\n    11\tTEMPLATE_COLOR = 8\n    12\tCORNER_NAMES = (\"TL\", \"TR\", \"BL\", \"BR\")\n    13\tSEED_COLORS = (1, 2, 3, 4, 6, 7, 9)\n    14\tMAX_GENERATION_ATTEMPTS = 300\n    15\t\n    16\t\n    17\tdef _neighbors4(r: int, c: int):\n    18\t    yield r - 1, c\n    19\t    yield r + 1, c\n    20\t    yield r, c - 1\n    21\t    yield r, c + 1\n    22\t\n    23\t\n    24\tdef _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:\n    25\t    h, w = mask.shape\n    26\t    seen = np.zeros((h, w), dtype=bool)\n    27\t    comps: list[list[tuple[int, int]]] = []\n    28\t    for r in range(h):\n    29\t        for c in range(w):\n    30\t            if not mask[r, c] or seen[r, c]:\n    31\t                continue\n    32\t            q = deque([(r, c)])\n    33\t            seen[r, c] = True\n    34\t            pts: list[tuple[int, int]] = []\n    35\t            while q:\n    36\t                cr, cc = q.popleft()\n    37\t                pts.append((cr, cc))\n    38\t                for nr, nc in _neighbors4(cr, cc):\n    39\t                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n    40\t                        seen[nr, nc] = True\n    41\t                        q.append((nr, nc))\n    42\t            comps.append(pts)\n    43\t    return comps\n    44\t\n    45\t\n    46\tdef _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:\n    47\t    rows = [r for r, _ in points]\n    48\t    cols = [c for _, c in points]\n    49\t    return min(rows), min(cols), max(rows), max(cols)\n    50\t\n    51\t\n    52\tdef _find_frames(grid: np.ndarray) -> list[tuple[int, int, int, int]]:\n    53\t    frames: list[tuple[int, int, int, int]] = []\n    54\t    for pts in _components(grid == FRAME_COLOR):\n    55\t        r0, c0, r1, c1 = _bbox(pts)\n    56\t        if r1 - r0 < 2 or c1 - c0 < 2:\n    57\t            continue\n    58\t        sub = grid[r0 : r1 + 1, c0 : c1 + 1]\n    59\t        border = np.zeros_like(sub, dtype=bool)\n    60\t        border[0, :] = True\n    61\t        border[-1, :] = True\n    62\t        border[:, 0] = True\n    63\t        border[:, -1] = True\n    64\t        if not np.all(sub[border] == FRAME_COLOR):\n    65\t            continue\n    66\t        if np.any(sub[1:-1, 1:-1] == FRAME_COLOR):\n    67\t            continue\n    68\t        if int(np.count_nonzero(sub == FRAME_COLOR)) != int(border.sum()):\n    69\t            continue\n    70\t        frames.append((r0, c0, r1, c1))\n    71\t    return frames\n    72\t\n    73\t\n    74\tdef _extract_templates(grid: np.ndarray) -> dict[str, np.ndarray]:\n    75\t    h, w = grid.shape\n    76\t    quadrants: dict[str, list[tuple[int, int]]] = {name: [] for name in CORNER_NAMES}\n    77\t    for r, c in np.argwhere(grid == TEMPLATE_COLOR):\n    78\t        if r < h / 2 and c < w / 2:\n    79\t            quadrants[\"TL\"].append((int(r), int(c)))\n    80\t        elif r < h / 2 and c >= w / 2:\n    81\t            quadrants[\"TR\"].append((int(r), int(c)))\n    82\t        elif r >= h / 2 and c < w / 2:\n    83\t            quadrants[\"BL\"].append((int(r), int(c)))\n    84\t        else:\n    85\t            quadrants[\"BR\"].append((int(r), int(c)))\n    86\t\n    87\t    templates: dict[str, np.ndarray] = {}\n    88\t    for name, pts in quadrants.items():\n    89\t        assert pts, f\"missing {name} template\"\n    90\t        r0, c0, r1, c1 = _bbox(pts)\n    91\t        templates[name] = grid[r0 : r1 + 1, c0 : c1 + 1] == TEMPLATE_COLOR\n    92\t    return templates\n    93\t\n    94\t\n    95\tdef main(grid: np.ndarray) -> np.ndarray:\n    96\t    \"\"\"\n    97\t    Use each frame's corner seed as both a template selector and a recolor key.\n    98\t\n    99\t    Input structure:\n   100\t    - The background is black.\n   101\t    - Several same-sized gray rectangular frames have one-cell-thick borders and black interiors.\n   102\t    - Each frame interior contains exactly one colored seed pixel in one of the four interior corners.\n   103\t    - Four azure template patterns sit near the four outer grid corners; each template has the same size as a frame interior.\n   104\t\n   105\t    Rule:\n   106\t    - Detect every gray frame and read which interior corner contains its seed pixel.\n   107\t    - Select the azure template from the matching outer corner region: top-left, top-right, bottom-left, or bottom-right.\n   108\t    - Repaint that template inside the frame using the seed color, leaving the template's black cells black.\n   109\t    - Remove the original seed pixel by replacing the whole frame interior with the recolored template.\n   110\t\n   111\t    Key insight:\n   112\t    - The seed pixel carries two independent signals at once: its corner position chooses one of four edge templates, and its color specifies how to recolor the chosen template.\n   113\t    \"\"\"\n   114\t    g = np.asarray(grid, dtype=int)\n   115\t    out = g.copy()\n   116\t    frames = _find_frames(g)\n   117\t    assert frames, \"expected at least one gray frame\"\n   118\t\n   119\t    interior_shapes = {(r1 - r0 - 1, c1 - c0 - 1) for r0, c0, r1, c1 in frames}\n   120\t    assert len(interior_shapes) == 1, \"all frame interiors must share one size\"\n   121\t    inner_h, inner_w = interior_shapes.pop()\n   122\t\n   123\t    templates = _extract_templates(g)\n   124\t    for name in CORNER_NAMES:\n   125\t        assert templates[name].shape == (inner_h, inner_w), f\"{name} template size must match frame interior\"\n   126\t\n   127\t    corner_lookup = {\n   128\t        (0, 0): \"TL\",\n   129\t        (0, inner_w - 1): \"TR\",\n   130\t        (inner_h - 1, 0): \"BL\",\n   131\t        (inner_h - 1, inner_w - 1): \"BR\",\n   132\t    }\n   133\t\n   134\t    for r0, c0, r1, c1 in frames:\n   135\t        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n   136\t        seed_pts = np.argwhere((inner != BG_COLOR) & (inner != FRAME_COLOR) & (inner != TEMPLATE_COLOR))\n   137\t        assert len(seed_pts) == 1, \"each frame interior must contain exactly one seed\"\n   138\t        sr, sc = map(int, seed_pts[0])\n   139\t        assert (sr, sc) in corner_lookup, \"seed must be placed on an interior corner\"\n   140\t        template_name = corner_lookup[(sr, sc)]\n   141\t        seed_color = int(inner[sr, sc])\n   142\t        out[r0 + 1 : r1, c0 + 1 : c1] = np.where(templates[template_name], seed_color, BG_COLOR)\n   143\t\n   144\t    return out\n   145\t\n   146\t\n   147\tdef _manhattan_path(a: tuple[int, int], b: tuple[int, int], rng: random.Random) -> list[tuple[int, int]]:\n   148\t    r, c = a\n   149\t    tr, tc = b\n   150\t    path = [(r, c)]\n   151\t    while (r, c) != (tr, tc):\n   152\t        steps = []\n   153\t        if r < tr:\n   154\t            steps.append((r + 1, c))\n   155\t        elif r > tr:\n   156\t            steps.append((r - 1, c))\n   157\t        if c < tc:\n   158\t            steps.append((r, c + 1))\n   159\t        elif c > tc:\n   160\t            steps.append((r, c - 1))\n   161\t        r, c = rng.choice(steps)\n   162\t        path.append((r, c))\n   163\t    return path\n   164\t\n   165\t\n   166\tdef _random_template_mask(h: int, w: int, rng: random.Random) -> np.ndarray | None:\n   167\t    for _ in range(80):\n   168\t        anchors = [\n   169\t            (0, rng.randrange(w)),\n   170\t            (h - 1, rng.randrange(w)),\n   171\t            (rng.randrange(h), 0),\n   172\t            (rng.randrange(h), w - 1),\n   173\t        ]\n   174\t        order = anchors[:]\n   175\t        rng.shuffle(order)\n   176\t        cells = {order[0]}\n   177\t        for nxt in order[1:]:\n   178\t            cells.update(_manhattan_path(order[0], nxt, rng))\n   179\t            order[0] = nxt\n   180\t        if len(cells) >= h * w:\n   181\t            continue\n   182\t\n   183\t        target = rng.randint(max(4, len(cells)), h * w - 1)\n   184\t        while len(cells) < target:\n   185\t            frontier = []\n   186\t            for r, c in cells:\n   187\t                for nr, nc in _neighbors4(r, c):\n   188\t                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:\n   189\t                        frontier.append((nr, nc))\n   190\t            if not frontier:\n   191\t                break\n   192\t            cells.add(rng.choice(frontier))\n   193\t\n   194\t        rows = {r for r, _ in cells}\n   195\t        cols = {c for _, c in cells}\n   196\t        if rows != set(range(h)) or cols != set(range(w)):\n   197\t            continue\n   198\t\n   199\t        mask = np.zeros((h, w), dtype=bool)\n   200\t        for r, c in cells:\n   201\t            mask[r, c] = True\n   202\t        return mask\n   203\t    return None\n   204\t\n   205\t\n   206\tdef _choose_layout(\n   207\t    inner_h: int, inner_w: int, frame_count: int, rng: random.Random\n   208\t) -> tuple[int, int, int, int, int, int, int, int] | None:\n   209\t    frame_h, frame_w = inner_h + 2, inner_w + 2\n   210\t    candidates = []\n   211\t    for slot_rows, slot_cols in ((2, 2), (2, 3), (3, 2)):\n   212\t        if slot_rows * slot_cols < frame_count:\n   213\t            continue\n   214\t        for vgap in (1, 2):\n   215\t            for hgap in (1, 2):\n   216\t                for top_gap in (1, 2, 3):\n   217\t                    for bottom_gap in (1, 2, 3):\n   218\t                        for left_gap in (1, 2, 3):\n   219\t                            for right_gap in (1, 2, 3):\n   220\t                                height = inner_h + top_gap + slot_rows * frame_h + (slot_rows - 1) * vgap + bottom_gap + inner_h\n   221\t                                width = inner_w + left_gap + slot_cols * frame_w + (slot_cols - 1) * hgap + right_gap + inner_w\n   222\t                                if height <= 30 and width <= 30:\n   223\t                                    candidates.append(\n   224\t                                        (slot_rows, slot_cols, vgap, hgap, top_gap, bottom_gap, left_gap, right_gap)\n   225\t                                    )\n   226\t    if not candidates:\n   227\t        return None\n   228\t    return rng.choice(candidates)\n   229\t\n   230\t\n   231\tdef _frame_seed_offset(name: str, inner_h: int, inner_w: int) -> tuple[int, int]:\n   232\t    if name == \"TL\":\n   233\t        return 0, 0\n   234\t    if name == \"TR\":\n   235\t        return 0, inner_w - 1\n   236\t    if name == \"BL\":\n   237\t        return inner_h - 1, 0\n   238\t    return inner_h - 1, inner_w - 1\n   239\t\n   240\t\n   241\tdef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n   242\t    inner_h = rng.randint(3, 5)\n   243\t    inner_w = rng.randint(3, 4)\n   244\t    frame_count = rng.randint(4, 6)\n   245\t    layout = _choose_layout(inner_h, inner_w, frame_count, rng)\n   246\t    if layout is None:\n   247\t        return None\n   248\t    slot_rows, slot_cols, vgap, hgap, top_gap, bottom_gap, left_gap, right_gap = layout\n   249\t\n   250\t    templates: dict[str, np.ndarray] = {}\n   251\t    seen_masks: set[bytes] = set()\n   252\t    for name in CORNER_NAMES:\n   253\t        mask = _random_template_mask(inner_h, inner_w, rng)\n   254\t        if mask is None:\n   255\t            return None\n   256\t        sig = mask.tobytes()\n   257\t        if sig in seen_masks:\n   258\t            return None\n   259\t        seen_masks.add(sig)\n   260\t        templates[name] = mask\n","exit_code":0,"status":"completed"}}
