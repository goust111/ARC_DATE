{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/e729b7be.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/\"'^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/e729b7be.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the scene by adding the point-reflected copy of the colored object across the central marker.\n\n    Input structure\n    - The grid has odd dimensions, a dominant background, and a center-row marker color appearing only at the left edge, center, and right edge.\n    - A single divider color fills the center column except for the center marker.\n    - All remaining foreground pixels form the object to copy, entirely on the left side of the divider.\n    Rule\n    - Keep the input unchanged.\n    - For every object pixel, paint the pixel rotated 180 degrees around the center marker with the same color.\n    Key insight\n    - The center marker is the rotation center; the yellow-looking divider is not mirrored, it only separates the source from the empty target side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h % 2 == 1 and w % 2 == 1\n\n    cr, cc = h // 2, w // 2\n    bg = int(get_bg(g))\n\n    marker_color = int(g[cr, cc])\n    assert marker_color != bg\n    marker_mask = g == marker_color\n    expected_markers = np.zeros(g.shape, dtype=bool)\n    expected_markers[cr, 0] = True\n    expected_markers[cr, cc] = True\n    expected_markers[cr, w - 1] = True\n    assert np.array_equal(marker_mask, expected_markers)\n\n    center_col = g[:, cc]\n    divider_colors = {int(color) for color in np.unique(center_col) if int(color) != marker_color}\n    assert len(divider_colors) == 1\n    divider_color = next(iter(divider_colors))\n    assert divider_color != bg\n    expected_divider = np.zeros(g.shape, dtype=bool)\n    expected_divider[:, cc] = True\n    expected_divider[cr, cc] = False\n    assert np.array_equal(g == divider_color, expected_divider)\n\n    source_mask = (g != bg) & (g != marker_color) & (g != divider_color)\n    source_coords = np.argwhere(source_mask)\n    assert source_coords.size > 0\n    assert np.all(source_coords[:, 1] < cc)\n\n    out = g.copy()\n    for r, c in source_coords:\n        rr = 2 * cr - int(r)\n        rc = 2 * cc - int(c)\n        assert 0 <= rr < h and 0 <= rc < w\n        assert out[rr, rc] == bg\n        out[rr, rc] = g[r, c]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Colors and canvas bounds.\nBG_COLOR, DIVIDER_COLOR, MARKER_COLOR = 7, 4, 8\nGRID_SIZES, MIN_EMPTY_BORDER_ROWS = (15, 17, 19), 1\n\n# Convex source shape bounds.\nSOURCE_SPAN_RANGE = (10, 15)\nSOURCE_MAX_WIDTH_RANGE = (5, 7)\nSOURCE_EDGE_WIDTH_RANGE = (1, 3)\nWIDTH_STEP_CAP, SOURCE_PIXEL_RANGE = 2, (35, 83)\n\n# Color palette, band orders, and retry budget.\nSOURCE_COLORS = (0, 1, 2, 3, 5, 6, 9)\nSOURCE_COLOR_COUNT_RANGE, GEN_ATTEMPTS = (3, 7), 300\nCOLORING_KEYS = (\n    lambda item: (item[2], item[3], item[1]),\n    lambda item: (item[3], item[2], item[1]),\n    lambda item: (item[2] + item[3], item[2], item[1]),\n    lambda item: (item[2] - item[3], item[2], item[1]),\n)\n\n\n\n---GEN---\ndef generate_input():\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid e729b7be input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/2c181942.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/\"'^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/2c181942.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/2c181942.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/\"'^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/2c181942.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Attach monochrome sprites to the matching sides of a central hollow square.\n\n    Input structure:\n    - bg = background. A hollow NxN square (hub) with bg corners/interior and four differently-colored edges (top, bottom, left, right).\n    - 2-4 monochrome sprites scattered on the grid, each matching one hub edge color.\n\n    Rule:\n    - For each hub edge color, find the matching sprite outside the hub.\n    - Rotate the sprite (0/90/180/270°) so its contact edge has exactly N-2 contiguous cells aligned with the hub side, and the rotated sprite is mirror-symmetric along the contact-edge axis (UD for left/right, LR for top/bottom).\n    - Translate it to adjoin that hub side. \n    - Clear everything else to bg; output is hub + attached sprites only.\n\n    Key insight: Each edge color uniquely pairs a sprite to a side; symmetry along the contact-edge axis disambiguates the correct rotation.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def _find_hub():\n        best = None  # (score, (r,c,n), (top,bot,left,right))\n        for n in range(3, 7):\n            for r in range(0, int(H - n + 1)):\n                for c in range(0, int(W - n + 1)):\n                    # corners must be bg\n                    if (\n                        int(g[int(r), int(c)]) != int(bg)\n                        or int(g[int(r), int(c + n - 1)]) != int(bg)\n                        or int(g[int(r + n - 1), int(c)]) != int(bg)\n                        or int(g[int(r + n - 1), int(c + n - 1)]) != int(bg)\n                    ):\n                        continue\n                    inner = g[int(r + 1) : int(r + n - 1), int(c + 1) : int(c + n - 1)]\n                    if not bool((inner == int(bg)).all()):\n                        continue\n\n                    top = g[int(r), int(c + 1) : int(c + n - 1)]\n                    bot = g[int(r + n - 1), int(c + 1) : int(c + n - 1)]\n                    left = g[int(r + 1) : int(r + n - 1), int(c)]\n                    right = g[int(r + 1) : int(r + n - 1), int(c + n - 1)]\n\n                    if bool((top == int(bg)).any()) or bool((bot == int(bg)).any()) or bool((left == int(bg)).any()) or bool((right == int(bg)).any()):\n                        continue\n                    if (\n                        len(set(map(int, top))) != 1\n                        or len(set(map(int, bot))) != 1\n                        or len(set(map(int, left))) != 1\n                        or len(set(map(int, right))) != 1\n                    ):\n                        continue\n\n                    cr = float(r + (n - 1) / 2)\n                    cc = float(c + (n - 1) / 2)\n                    score = abs(float(cr - (H - 1) / 2)) + abs(float(cc - (W - 1) / 2))\n                    cand = (\n                        float(score),\n                        (int(r), int(c), int(n)),\n                        (int(top[0]), int(bot[0]), int(left[0]), int(right[0])),\n                    )\n                    if best is None or float(cand[0]) < float(best[0]):\n                        best = cand\n        return best\n\n    hub = _find_hub()\n    assert not (hub is None)\n\n    _score, (r, c, n), (top_col, bot_col, left_col, right_col) = hub\n    hub_mask = np.zeros((H, W), dtype=bool)\n    hub_mask[int(r) : int(r + n), int(c) : int(c + n)] = True\n\n    out = np.full_like(g, int(bg))\n    out[int(r) : int(r + n), int(c) : int(c + n)] = g[int(r) : int(r + n), int(c) : int(c + n)]\n\n    target = int(n - 2)  # length of the hub edge segment (excluding corners)\n\n    def _crop_to_mask(arr: np.ndarray, mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:\n        pts = np.argwhere(mask)\n        r0, c0, r1, c1 = bbox_coords(pts)\n        return arr[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1], mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]\n\n    def _edge_segment(mask: np.ndarray, side: str):\n        pts = np.argwhere(mask)\n        if pts.size == 0:\n            return None\n        if side == \"top\":\n            rr = int(pts[:, 0].min())\n            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n            return (\"h\", int(rr), cols)\n        if side == \"bot\":\n            rr = int(pts[:, 0].max())\n            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n            return (\"h\", int(rr), cols)\n        if side == \"left\":\n            cc = int(pts[:, 1].min())\n            rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n            return (\"v\", int(cc), rows)\n        if side == \"right\":\n            cc = int(pts[:, 1].max())\n            rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n            return (\"v\", int(cc), rows)\n        return None\n\n    def _is_contig(seq: list[int]) -> bool:\n        return bool(seq) and all(int(seq[i]) + 1 == int(seq[i + 1]) for i in range(len(seq) - 1))\n\n    # desired attachment geometry: adjacent (touching) the hub side segment\n    segs = {\n        \"top\": (int(top_col), (\"bot\", int(r - 1), list(range(int(c + 1), int(c + n - 1))))),\n        \"bot\": (int(bot_col), (\"top\", int(r + n), list(range(int(c + 1), int(c + n - 1))))),\n        \"left\": (int(left_col), (\"right\", int(c - 1), list(range(int(r + 1), int(r + n - 1))))),\n        \"right\": (int(right_col), (\"left\", int(c + n), list(range(int(r + 1), int(r + n - 1))))),\n    }\n\n    for _side, (col, (need_edge, fixed, span)) in segs.items():\n        col = int(col)\n        m = (g == int(col)) & (~hub_mask)\n        if not bool(m.any()):\n            continue\n\n        # Sprites can be only diagonally connected (e.g. V-shapes), so extract with 8-connectivity.\n        labc, nc = label_mask(m, connectivity=8)\n        best_id = None\n        best_sz = -1\n        for cid in range(1, int(nc) + 1):\n            sz = int((labc == int(cid)).sum())\n            if sz > best_sz:\n                best_sz = sz\n                best_id = int(cid)\n        if best_id is None or best_sz <= 0:\n            continue\n\n        spr_mask = labc == int(best_id)\n        spr_arr = g.copy()\n        spr_arr[~spr_mask] = int(bg)\n        spr_arr, spr_mask = _crop_to_mask(spr_arr, spr_mask)\n\n        found = None  # (a, msk, dr, dc)\n        for krot in range(4):\n            a = np.rot90(spr_arr, int(krot))\n            msk = np.rot90(spr_mask, int(krot))\n            a, msk = _crop_to_mask(a, msk)\n\n            # Attached sprite must be mirror-symmetric along the contact edge axis\n            if need_edge in (\"left\", \"right\"):\n                if not bool(np.array_equal(msk, np.flipud(msk))):\n                    continue\n            else:\n                if not bool(np.array_equal(msk, np.fliplr(msk))):\n                    continue\n\n            seg = _edge_segment(msk, need_edge)\n            if seg is None:\n                continue\n\n            if need_edge in (\"left\", \"right\"):\n                _typ, edge_c, rows = seg\n                if len(rows) != int(target) or not _is_contig(rows):\n                    continue\n                dr = int(span[0] - rows[0])\n                dc = int(fixed - edge_c)\n            else:\n                _typ, edge_r, cols = seg\n                if len(cols) != int(target) or not _is_contig(cols):\n                    continue\n                dr = int(fixed - edge_r)\n                dc = int(span[0] - cols[0])\n\n            placed = {(int(rr + dr), int(cc2 + dc)) for rr, cc2 in np.argwhere(msk)}\n            if any(not (0 <= R < H and 0 <= C < W) for R, C in placed):\n                continue\n\n            # ensure no conflicts with already-drawn hub (or previously placed sprites)\n            ok = True\n            for R, C in placed:\n                val = int(a[int(R - dr), int(C - dc)])\n                if val == int(bg):\n                    continue\n                if int(out[int(R), int(C)]) != int(bg) and int(out[int(R), int(C)]) != val:\n                    ok = False\n                    break\n            if not ok:\n                continue\n\n            found = (a, msk, int(dr), int(dc))\n            break\n\n        if found is None:\n            continue\n\n        a, msk, dr, dc = found\n        paste(out, a, int(dr), int(dc), mask=msk, overwrite=True, clip=True)\n\n    return out\n\n\n# ---------------------------------------------------------------------------\n# Generator\n# ---------------------------------------------------------------------------\n\nfrom scipy.ndimage import label as _label\n\n\n---GEN---\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n","exit_code":0,"status":"completed"}}
