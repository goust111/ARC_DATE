{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\ntext=Path('/home/lixinyu/snap/new/ARC_code/train/a09f6c25.py').read_text()\nfor name in ['_component_mask','_symmetry_color']:\n    i=text.index(f'def {name}(')\n    j=text.find('\\\\ndef ', i+1)\n    if j==-1: j=len(text)\n    print(f'--- {name} ---')\n    print(text[i:j][:4000])\nPY\"","aggregated_output":"--- _component_mask ---\ndef _component_mask(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:\n    r0, c0, r1, c1 = map(int, bbox)\n    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True\n    return mask\n\n\n--- _symmetry_color ---\ndef _symmetry_color(mask: np.ndarray) -> int:\n    horizontal = bool(np.array_equal(mask, mask[::-1, :]))\n    vertical = bool(np.array_equal(mask, mask[:, ::-1]))\n    diagonal = bool(\n        mask.shape[0] == mask.shape[1]\n        and (np.array_equal(mask, mask.T) or np.array_equal(mask, np.fliplr(mask).T))\n    )\n\n    assert sum((horizontal, vertical, diagonal)) == 1, \"object must have one symmetry category\"\n    if horizontal:\n        return 1\n    if vertical:\n        return 3\n    return 6\n\n\n","exit_code":0,"status":"completed"}}
