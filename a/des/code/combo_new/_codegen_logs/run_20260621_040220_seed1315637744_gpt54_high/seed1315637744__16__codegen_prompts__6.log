{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/5961cc34.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import colors_present, components_mask, get_bg, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Build a red ray network by activating blue blobs via directional green ports.\n\n    Input structure:\n    - bg = most common color. Large blue blobs with adjacent green pixels marking port directions.\n    - Start marker: yellow pixel atop a short red segment at grid bottom.\n\n    Rule:\n    - Extend a ray upward from start; on hitting a blue blob, recolor it red.\n    - Activated blobs emit thick rays through green ports until boundary or another blob.\n    - Cascade until no new blobs are reached.\n\n    Key insight: Green pixels encode ray direction and width; the network activates as a chain reaction from one start point.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # --- STEP 1) Detect the start \"port\" (red vertical segment with a non-red cap above) ---\n    start_candidates: list[tuple[int, int, int, list[tuple[int, int]]]] = []\n\n    for col in colors_present(g, exclude={bg}):\n        for coords in components_mask(g == int(col), connectivity=8):\n            if coords.size == 0:\n                continue\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n\n            # thin vertical segment, height>=2, touches bottom\n            if c0 != c1 or (r1 - r0 + 1) < 2:\n                continue\n            if r1 != int(H - 1):\n                continue\n            # solid vertical segment\n            if any(int(g[rr, c0]) != int(col) for rr in range(int(r0), int(r1) + 1)):\n                continue\n            if int(r0) - 1 < 0:\n                continue\n            cap = int(g[int(r0) - 1, int(c0)])\n            if cap == int(bg) or cap == int(col):\n                continue\n\n            start_candidates.append(\n                (\n                    int(col),\n                    int(cap),\n                    int(c0),\n                    [(int(rr), int(c0)) for rr in range(int(r0), int(r1) + 1)],\n                )\n            )\n\n    assert len(start_candidates) == 1\n    red_col, yellow_col, start_col, start_seg = start_candidates[0]\n\n    # --- STEP 2) Identify blob colors ---\n    # Blue = dominant remaining color by pixel count (excluding bg/start colors).\n    counts = Counter(map(int, g.flatten()))\n    other_cols = [(int(cnt), int(col)) for col, cnt in counts.items() if int(col) not in (bg, red_col, yellow_col)]\n    assert other_cols\n    max_count = max(cnt for cnt, _col in other_cols)\n    blue_candidates = [int(col) for cnt, col in other_cols if cnt == max_count]\n    assert len(blue_candidates) == 1\n    blue_col = int(blue_candidates[0])\n\n    # Green = the unique other color that is 4-adjacent to blue.\n    green_candidates: list[int] = []\n    for col in colors_present(g, exclude={bg, red_col, yellow_col, blue_col}):\n        pts = np.argwhere(g == int(col))\n        if pts.size == 0:\n            continue\n        ok = False\n        for r, c in pts:\n            r = int(r)\n            c = int(c)\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + dr)\n                cc = int(c + dc)\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(blue_col):\n                    ok = True\n                    break\n            if ok:\n                break\n        if ok:\n            green_candidates.append(int(col))\n\n    assert len(green_candidates) == 1\n    green_col = int(green_candidates[0])\n\n    out = np.full_like(g, int(bg))\n\n    # --- STEP 3) Extract blue blobs as connected components, and build a pixel->blob map ---\n    blob_id = np.full((H, W), -1, dtype=int)\n    blobs: list[dict] = []\n\n    for coords in components_mask(g == int(blue_col), connectivity=8):\n        pts = [(int(r), int(c)) for r, c in coords]\n        bi = int(len(blobs))\n        for r, c in pts:\n            blob_id[int(r), int(c)] = bi\n        blobs.append({\"pts\": pts, \"ports\": []})\n\n    # --- STEP 4) For each blob, find its ports from adjacent green markers ---\n    for blob in blobs:\n        pts = blob[\"pts\"]\n        seen_dirs: set[tuple[int, int]] = set()\n        for r, c in pts:\n            for ddr, ddc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + ddr)\n                cc = int(c + ddc)\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(green_col):\n                    seen_dirs.add((int(ddr), int(ddc)))\n        for ddr, ddc in seen_dirs:\n            port_pixels = [\n                (int(r), int(c))\n                for (r, c) in pts\n                if 0 <= int(r + ddr) < H and 0 <= int(c + ddc) < W and int(g[int(r + ddr), int(c + ddc)]) == int(green_col)\n            ]\n            assert port_pixels\n            blob[\"ports\"].append({\"dir\": (int(ddr), int(ddc)), \"pixels\": port_pixels})\n\n    activated: set[int] = set()\n    queue: list[int] = []\n\n    def activate_blob_at(r: int, c: int) -> None:\n        \"\"\"Recolor a blob to red when first hit by a ray; enqueue it to emit its ports.\"\"\"\n        bi = int(blob_id[int(r), int(c)])\n        assert bi >= 0\n        if bi in activated:\n            return\n        activated.add(int(bi))\n        queue.append(int(bi))\n        for pr, pc in blobs[bi][\"pts\"]:\n            out[int(pr), int(pc)] = int(red_col)\n\n    # --- STEP 5) Draw the start ray upward (thin) and stop at the first blob hit ---\n    for r, c in start_seg:\n        out[int(r), int(c)] = int(red_col)\n    top_r = min(int(r) for r, _c in start_seg)\n    assert int(top_r) > 0 and int(g[int(top_r) - 1, int(start_col)]) == int(yellow_col)\n    out[int(top_r) - 1, int(start_col)] = int(red_col)\n    for r in range(int(top_r) - 1, -1, -1):\n        out[int(r), int(start_col)] = int(red_col)\n        if int(g[int(r), int(start_col)]) == int(blue_col):\n            activate_blob_at(int(r), int(start_col))\n            break\n\n    def extend_thick(port_pixels: list[tuple[int, int]], d: tuple[int, int]) -> None:\n        \"\"\"Extend a ray from each port pixel until boundary or blob hit.\"\"\"\n        ddr, ddc = map(int, d)\n        for pr, pc in port_pixels:\n            r, c = int(pr), int(pc)\n            while True:\n                r += int(ddr)\n                c += int(ddc)\n                if not (0 <= r < H and 0 <= c < W):\n                    break\n                out[int(r), int(c)] = int(red_col)\n                if int(g[int(r), int(c)]) == int(blue_col):\n                    activate_blob_at(int(r), int(c))\n                    break\n\n    # --- STEP 6) Propagate (BFS): activated blob -> emit rays -> activate more blobs ---\n    while queue:\n        bi = int(queue.pop(0))\n        for port in blobs[bi][\"ports\"]:\n            extend_thick(port[\"pixels\"], port[\"dir\"])\n\n    assert len(blobs) - len(activated) <= 1, \"at most 1 distractor blob\"\n\n    return out\n\n# --------------- generator (a2_cascade) ---------------\n\nfrom arc_utils import paint_coords\n\n# --- Colors ---\nBG = 8\nBLUE = 1\nRED = 2\nGREEN = 3\nYELLOW = 4\n\n# --- Directions ---\nUP = (-1, 0)\nDOWN = (1, 0)\nLEFT = (0, -1)\nRIGHT = (0, 1)\nDIRS = (UP, DOWN, LEFT, RIGHT)\nOPP = {UP: DOWN, DOWN: UP, LEFT: RIGHT, RIGHT: LEFT}\n\n# --- Diamond/octagon shapes (h, w) ---\nSHAPES = ((3, 4), (4, 4), (5, 4), (5, 6), (6, 6), (8, 8))\n_SHAPE_WIDTHS = {\n    (3, 4): (2, 4, 2),\n    (4, 4): (2, 4, 4, 2),\n    (5, 4): (2, 4, 4, 4, 2),\n    (5, 6): (2, 4, 6, 4, 2),\n    (6, 6): (2, 4, 6, 6, 4, 2),\n    (8, 8): (2, 4, 6, 8, 8, 6, 4, 2),\n}\n\n# --- Canvas bounds ---\nH_MIN, H_MAX = 13, 27\nW_MIN, W_MAX = 15, 27\nSTART_COL_PAD = 2        # min distance from start column to grid edge\n\n# --- Start segment ---\nSTART_H_MIN, START_H_MAX = 2, 3  # red segment height (below yellow cap)\n\n# --- Chain / distractor ---\nCHAIN_LEN_WEIGHTS = [1, 3, 3, 3]  # weights for chain_len in [0, 1, 2, 3]\nMAX_BLOB_COUNT = 4                 # chain + distractors combined\nMAX_DISTRACTORS = 1\n\n# --- Placement ---\nMIN_GAP_FIRST = 4   # along-axis gap between start and first blob\nMIN_GAP_CHAIN = 3   # along-axis gap between successive chain blobs\n\n# --- Retry ---\nGEN_RETRIES = 300\n\n\ndef _shape_mask(h: int, w: int) -> np.ndarray:\n    \"\"\"Build a boolean diamond/octagon mask for the given (h, w) shape.\"\"\"\n    widths = _SHAPE_WIDTHS[(h, w)]\n    mask = np.zeros((h, w), dtype=bool)\n    for r, ww in enumerate(widths):\n        c0 = (w - ww) // 2\n        mask[r, c0 : c0 + ww] = True\n    return mask\n\n\ndef _perp_value(rc: tuple[int, int], d: tuple[int, int]) -> int:\n    \"\"\"Coordinate perpendicular to direction d (column for vertical, row for horizontal).\"\"\"\n    return rc[1] if d[0] else rc[0]\n\n\ndef _along_value(rc: tuple[int, int], d: tuple[int, int]) -> int:\n    \"\"\"Coordinate along direction d (row for vertical, column for horizontal).\"\"\"\n    return rc[0] if d[0] else rc[1]\n\n\ndef _sort_on_ray(coords: list[tuple[int, int]], d: tuple[int, int]) -> list[tuple[int, int]]:\n    \"\"\"Sort coordinates by their perpendicular value relative to direction d.\"\"\"\n    return sorted(coords, key=lambda p: _perp_value(p, d))\n\n\ndef _edge_offsets(mask: np.ndarray, d: tuple[int, int]) -> list[tuple[int, int]]:\n    \"\"\"Return sorted mask-local coordinates on the edge facing direction d.\"\"\"\n    pts = np.argwhere(mask)\n    axis = 0 if d in (UP, DOWN) else 1\n    extreme = pts[:, axis].min() if d in (UP, LEFT) else pts[:, axis].max()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/78e78cff.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/78e78cff.py\"","aggregated_output":"from __future__ import annotations\n\nimport random\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg\n\n\ndef _wall_row_interval(wall_cols: np.ndarray, marker_col: int, width: int) -> tuple[int, int]:\n    left = wall_cols[wall_cols < marker_col]\n    right = wall_cols[wall_cols >= marker_col]\n    assert left.size or right.size, \"wall row must constrain the marker column\"\n\n    if left.size and right.size:\n        start = int(left.max()) + 1\n        stop = int(right.min()) - 1\n    elif left.size:\n        start = int(left.max()) + 1\n        stop = int(width) - 1\n    else:\n        start = 0\n        stop = int(right.min()) - 1\n\n    assert 0 <= start <= stop < int(width), \"wall row must leave a nonempty passage\"\n    return start, stop\n\n\ndef _assert_wall_connectivity(g: np.ndarray, wall_color: int, marker_col: int) -> None:\n    wall_coords = {tuple(map(int, coord)) for coord in np.argwhere(g == wall_color)}\n    remaining = set(wall_coords)\n    component_count = 0\n    while remaining:\n        component_count += 1\n        stack = [remaining.pop()]\n        while stack:\n            r, c = stack.pop()\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    if dr == 0 and dc == 0:\n                        continue\n                    neighbor = (r + dr, c + dc)\n                    if neighbor in remaining:\n                        remaining.remove(neighbor)\n                        stack.append(neighbor)\n    assert component_count == 4, \"wall must form four 8-connected arcs around the four openings\"\n\n    rows: dict[int, tuple[list[int], list[int]]] = {}\n    for r in range(g.shape[0]):\n        wall_cols = [int(c) for c in np.flatnonzero(g[r] == wall_color)]\n        if not wall_cols:\n            continue\n        left = [c for c in wall_cols if c < marker_col]\n        right = [c for c in wall_cols if c > marker_col]\n        for side_cols in (left, right):\n            if side_cols:\n                assert side_cols == list(range(min(side_cols), max(side_cols) + 1)), \"wall side blocks must be contiguous\"\n        rows[r] = (left, right)\n\n    for r in sorted(rows):\n        if r - 1 not in rows:\n            continue\n        prev_left, prev_right = rows[r - 1]\n        left, right = rows[r]\n        for prev_side, side in ((prev_left, left), (prev_right, right)):\n            if prev_side and side:\n                assert min(abs(a - b) for a in prev_side for b in side) <= 1, \"adjacent wall rows must remain 8-connected\"\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the row-wise passage indicated by wall pixels with the singleton marker color.\n\n    Input structure:\n    - A dominant background contains one singleton marker pixel and one wall color.\n    - Wall pixels lie on several rows and form left/right limits around the marker column.\n    - Empty rows between the top and bottom wall rows are open horizontal passages.\n\n    Rule:\n    - On a wall row, paint background pixels between the nearest wall strictly\n      left of the marker column and the nearest wall at or right of it; if only\n      one side is present, paint from that wall to the opposite grid edge.\n    - On empty rows between the top and bottom wall rows, paint the whole row.\n    - On empty rows outside the wall-row band, reuse the nearest end wall-row interval.\n    - Preserve wall pixels and the original marker pixel.\n\n    Key insight:\n    - The wall color defines scanline limits relative to the marker column; the\n      marker color fills those implied horizontal spans rather than flood-filling\n      through connected background.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = g.shape\n\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 2, \"expected exactly a marker color and a wall color\"\n\n    marker_colors = [color for color in fg_colors if int(np.count_nonzero(g == color)) == 1]\n    assert len(marker_colors) == 1, \"expected a unique singleton marker color\"\n    marker_color = int(marker_colors[0])\n    wall_colors = [color for color in fg_colors if int(color) != marker_color]\n    assert len(wall_colors) == 1, \"expected one wall color\"\n    wall_color = int(wall_colors[0])\n\n    marker_coords = np.argwhere(g == marker_color)\n    assert marker_coords.shape == (1, 2), \"expected exactly one marker pixel\"\n    marker_row, marker_col = map(int, marker_coords[0])\n    _assert_wall_connectivity(g, wall_color, marker_col)\n\n    row_intervals: dict[int, tuple[int, int]] = {}\n    for r in range(height):\n        wall_cols = np.flatnonzero(g[r] == wall_color)\n        if wall_cols.size:\n            row_intervals[int(r)] = _wall_row_interval(wall_cols, marker_col, width)\n\n    assert row_intervals, \"expected at least one wall row\"\n    top_wall_row = min(row_intervals)\n    bottom_wall_row = max(row_intervals)\n    assert top_wall_row <= marker_row <= bottom_wall_row, \"marker must lie within the wall-row band\"\n\n    out = g.copy()\n    for r in range(height):\n        if r in row_intervals:\n            start, stop = row_intervals[r]\n        elif top_wall_row < r < bottom_wall_row:\n            start, stop = 0, int(width) - 1\n        elif r < top_wall_row:\n            start, stop = row_intervals[top_wall_row]\n        else:\n            start, stop = row_intervals[bottom_wall_row]\n\n        span = out[r, start : stop + 1]\n        span[span == bg] = marker_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\nfrom arc_utils import components_mask\n\n# Canvas and band choices.\nHEIGHT_BAND_EMPTY_OPTIONS = ((11, 5, 1), (11, 6, 1), (11, 6, 2), (12, 6, 1), (12, 6, 2), (12, 7, 1), (12, 7, 2))\nGRID_WIDTH_RANGE = (11, 12)\nBAND_TOP_ROW = 2\n\n# Palette and marker placement.\nCOLOR_IDS = range(10)\nCOLOR_COUNT = 3\nMARKER_COL_RANGE = (3, 8)\n\n# Wall shape and pixel-count controls.\nWALL_PIXEL_RANGE = (8, 14)\nBASE_WALL_OFFSET = 1\nPEAK_WALL_OFFSET_MIN = 2\nSIDE_BLOCK_MAX_LEN = 2\nEXPECTED_WALL_COMPONENTS = 4\nONE_SIDED_ROW_PROB = 0.25\nONE_SIDED_OPTIONS = (\"left\", \"right\")\n\nGENERATION_RETRIES = 300\n\n\ndef _wall_interval(wall_cols: list[int], marker_col: int, width: int) -> tuple[int, int]:\n    left = [c for c in wall_cols if c < marker_col]\n    right = [c for c in wall_cols if c > marker_col]\n    if left and right:\n        return max(left) + 1, min(right) - 1\n    if left:\n        return max(left) + 1, width - 1\n    return 0, min(right) - 1\n\n\ndef _expected_output(grid, bg, marker, intervals, top, bottom):\n    \"\"\"Return the solver output implied by the generated wall intervals.\"\"\"\n    height, width = grid.shape\n    out = grid.copy()\n    for r in range(height):\n        if r in intervals:\n            start, stop = intervals[r]\n        elif top < r < bottom:\n            start, stop = 0, width - 1\n        elif r < top:\n            start, stop = intervals[top]\n        else:\n            start, stop = intervals[bottom]\n        span = out[r, start : stop + 1]\n        span[span == bg] = marker\n    return out\n\n\ndef _center_empty_rows(top: int, band_len: int, empty_count: int) -> set[int]:\n    bottom = top + band_len - 1\n    if empty_count == 1:\n        if band_len % 2:\n            return {(top + bottom) // 2}\n        return {random.choice([(top + bottom) // 2, (top + bottom) // 2 + 1])}\n    if band_len % 2:\n        mid = (top + bottom) // 2\n        return set(random.choice([(mid - 1, mid), (mid, mid + 1)]))\n    mid = (top + bottom) // 2\n    return {mid, mid + 1}\n\n\ndef _peak_offsets(wall_rows: list[int], top: int, bottom: int, maximum: int) -> dict[int, int]:\n    max_depth = max(min(r - top, bottom - r) for r in wall_rows)\n    if max_depth == 0:\n        return {r: BASE_WALL_OFFSET for r in wall_rows}\n    peak = random.randint(PEAK_WALL_OFFSET_MIN, min(maximum, BASE_WALL_OFFSET + max_depth))\n    offsets = {}\n    for r in wall_rows:\n        depth = min(r - top, bottom - r)\n        offsets[r] = BASE_WALL_OFFSET + round((peak - BASE_WALL_OFFSET) * depth / max_depth)\n    return offsets\n\n\ndef _wall_component_count(wall_cols_by_row: dict[int, list[int]]) -> int:\n    max_row = max(wall_cols_by_row)\n    max_col = max(c for cols in wall_cols_by_row.values() for c in cols)\n    mask = np.zeros((max_row + 1, max_col + 1), dtype=bool)\n    for r, cols in wall_cols_by_row.items():\n        mask[r, cols] = True\n    return len(components_mask(mask, connectivity=8))\n\n\ndef _cols_on_side(cols: list[int], marker_col: int, side: str) -> list[int]:\n    if side == \"left\":\n        return [c for c in cols if c < marker_col]\n    return [c for c in cols if c > marker_col]\n\n\ndef _wall_has_intended_connectivity(wall_cols_by_row: dict[int, list[int]], marker_col: int) -> bool:\n    if _wall_component_count(wall_cols_by_row) != EXPECTED_WALL_COMPONENTS:\n        return False\n\n    for r in sorted(wall_cols_by_row):\n        if r - 1 not in wall_cols_by_row:\n            continue\n        prev_cols = wall_cols_by_row[r - 1]\n        cols = wall_cols_by_row[r]\n        for side in ONE_SIDED_OPTIONS:\n            prev_side = _cols_on_side(prev_cols, marker_col, side)\n            curr_side = _cols_on_side(cols, marker_col, side)\n            if prev_side and curr_side and min(abs(a - b) for a in prev_side for b in curr_side) > 1:\n                return False\n    return True\n\n\ndef _sample_scene() -> tuple[int, int, int, int, int, int, int, int, int, list[int]]:\n    height, band_len, empty_count = random.choice(HEIGHT_BAND_EMPTY_OPTIONS)\n    width = random.randint(*GRID_WIDTH_RANGE)\n    top = BAND_TOP_ROW\n    bottom = top + band_len - 1\n\n    bg, wall, marker = random.sample(COLOR_IDS, COLOR_COUNT)\n    marker_col = random.randint(*MARKER_COL_RANGE)\n    marker_row = random.randint(top, bottom)\n\n    empty_rows = _center_empty_rows(top, band_len, empty_count)\n","exit_code":0,"status":"completed"}}
