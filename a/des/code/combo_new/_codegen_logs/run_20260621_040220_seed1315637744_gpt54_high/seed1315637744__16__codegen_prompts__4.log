olor assignment ---\n409:     chosen_colors = random.sample(list(range(1, 10)), frame_count + 1)\n410:     frame_colors = chosen_colors[:frame_count]\n411:     noise_color = chosen_colors[frame_count]\n412: \n413:     # --- Grid/frame size selection ---\n414:     cfg = _GRID_SIZE_BY_FRAMES.get(frame_count, _GRID_SIZE_BY_FRAMES[3])\n415:     h_min, h_max, w_min, w_max, f_max_h, f_max_w = cfg\n416:     grid_h = random.randint(h_min, h_max)\n417:     grid_w = random.randint(w_min, w_max)\n418: \n419:     # --- Build frames ---\n420:     frames = []\n421:     for color, target_rooms in zip(frame_colors, room_counts):\n422:         frame_data = _build_frame(target_rooms, max_h=f_max_h, max_w=f_max_w)\n423:         if frame_data is None:\n424:             return None\n425:         fh, fw = frame_data.shape\n426:         if fh > grid_h - 2 or fw > grid_w - 2:\n427:             return None\n428:         frames.append((color, target_rooms, frame_data))\n429: \n430:     # --- Place frames (largest first, random position) ---\n431:     positions = [None] * frame_count\n432:     for idx in sorted(range(frame_count), key=lambda i: -frames[i][2].size):\n433:         fh, fw = frames[idx][2].shape\n434:         positions[idx] = (random.randint(0, grid_h - fh), random.randint(0, grid_w - fw))\n435: \n436:     # --- Force overlaps for tied pairs ---\n437:     tied_pairs = [(i, j) for i in range(frame_count) for j in range(i + 1, frame_count)\n438:                   if room_counts[i] == room_counts[j]]\n439:     for i, j in tied_pairs:\n440:         _force_overlap(positions, i, j, frames, grid_h, grid_w)\n441: \n442:     # --- Force some non-tied overlaps ---\n443:     non_tied = [(i, j) for i in range(frame_count) for j in range(i + 1, frame_count)\n444:                 if room_counts[i] != room_counts[j]]\n445:     n_extra = random.randint(*_EXTRA_OVERLAP_RANGE)\n446:     if n_extra > 0 and non_tied:\n447:         random.shuffle(non_tied)\n448:         for i, j in non_tied[:min(n_ex