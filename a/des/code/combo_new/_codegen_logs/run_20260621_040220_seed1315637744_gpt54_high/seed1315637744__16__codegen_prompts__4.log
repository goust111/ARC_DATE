Layout probabilities and constraints.\n107: PREFERRED_GRID_HALF = (2, 2)\n108: PREFERRED_GRID_PROB = 0.65\n109: QUADRANT_COUNT = 4\n110: SEPARATOR_WIDTH = 1\n111: BG_DOMINANCE_MARGIN = 1\n112: # Retry limit.\n113: MAX_GENERATION_ATTEMPTS = 300\n114: \n115: def _gen_bounded_composition(total: int, parts: int, max_each: int) -> list[int] | None:\n116:     if parts <= 0 or total < parts or total > parts * max_each:\n117:         return None\n118: \n119:     counts = []\n120:     remaining = total\n121:     for i in range(parts):\n122:         slots_left = parts - i - 1\n123:         lo = max(1, remaining - slots_left * max_each)\n124:         hi = min(max_each, remaining - slots_left)\n125:         counts.append(random.randint(lo, hi))\n126:         remaining -= counts[-1]\n127: \n128:     random.shuffle(counts)\n129:     return counts\n130: \n131: \n132: def _gen_grid_options() -> list[tuple[int, int, list[int], int]]:\n133:     options = []\n134:     for k in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n135:         for m in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n136:             area = k * m\n137:             bg_count = 2 * k + 2 * m + SEPARATOR_WIDTH + QUADRANT_COUNT\n138:             max_target_count = (bg_count - BG_DOMINANCE_MARGIN) // QUADRANT_COUNT\n139:             max_colors = min(MAX_NON_BG_COLORS, area)\n140:             valid_counts = [\n141:                 c\n142:                 for c in range(MIN_TARGET_COLORS, max_colors + 1)\n143:                 if area <= c * max_target_count\n144:             ]\n145:             if valid_counts:\n146:                 options.append((k, m, valid_counts, max_target_count))\n147:     return options\n148: \n149: \n150: def _gen_pick_grid_option() -> tuple[int, int, list[int], int]:\n151:     options = _gen_grid_options()\n152:     if random.random() < PREFERRED_GRID_PROB:\n153:         preferred_k, preferred_m = PREFERRED_GRID_HALF\n154:         for option in options:\n155:             if option[0] == preferred_k and option[1] == preferred_m:\n156:                 return option\n157:     return random.choice(options)\n158: \n159: \n160: def _gen_quadrant_offsets(k: int, m: int) -> list[tuple[int, int]]:\n161:     sep = SEPARATOR_WIDTH\n162:     return [(0, 0), (0, m + sep), (k + sep, 0), (k + sep, m + sep)]\n163: \n164: \n165: def _gen_missing_colors(non_bg_colors: list[int]) -> list[int]:\n166:     missing_colors = [random.choice(non_bg_colors) for _ in range(QUADRANT_COUNT)]\n167:     if len(set(missing_colors)) == 1:\n168:         alternatives = [c for c in non_bg_colors if c != missing_colors[0]]\n169:         missing_colors[-1] = random.choice(alternatives)\n170:     return missing_colors\n171: \n172: \n173: def _gen_attempt() -> np.ndarray | None:\n174:     bg = random.randrange(COLOR_COUNT)\n\n--- starting line 213: def generate_input() -> np.ndarray:\n213: def generate_input() -> np.ndarray:\n214:     for _ in range(MAX_GENERATION_ATTEMPTS):\n215:         grid = _gen_attempt()\n216:         if grid is not None:\n217:             return grid\n218:     raise RuntimeError(\"failed to generate a valid e3fe1151 input\")\n\n","exit_code":0,"status":"completed"}}
