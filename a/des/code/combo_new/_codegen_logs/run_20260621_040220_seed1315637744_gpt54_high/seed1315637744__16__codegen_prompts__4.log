APE[1]\n046: \n047: # Palette: four distinct foreground colors, no background.\n048: COLOR_POOL = np.arange(1, 10)\n049: N_COLORS = 4\n050: \n051: # Counts: largest, second, third are sampled; smallest is residual.\n052: COUNT_RANGES = ((40, 55), (25, 35), (10, 20))\n053: RESIDUAL_COUNT_RANGE = (2, 10)\n054: COUNT_SAMPLE_RETRIES = 100\n055: GENERATION_RETRIES = 300\n056: \n057: \n058: def _sample_ranked_counts(rng: np.random.Generator) -> list[int] | None:\n059:     \"\"\"Return four distinct counts in descending rank ranges, summing to the grid area.\"\"\"\n060:     for _ in range(COUNT_SAMPLE_RETRIES):\n061:         sampled = [int(rng.integers(lo, hi + 1)) for lo, hi in COUNT_RANGES]\n062:         residual = GRID_AREA - sum(sampled)\n063:         lo, hi = RESIDUAL_COUNT_RANGE\n064:         counts = sampled + [residual]\n065:         if lo <= residual <= hi and len(set(counts)) == N_COLORS:\n066:             return counts\n067:     return None\n068: \n069: \n070: def _gen_attempt() -> np.ndarray | None:\n071:     rng = np.random.default_rng()\n072: \n073:     colors = rng.choice(COLOR_POOL, size=N_COLORS, replace=False).tolist()\n074:     counts = _sample_ranked_counts(rng)\n075:     if counts is None:\n076:         return None\n077: \n078:     pixels = np.repeat(colors, counts)\n079:     rng.shuffle(pixels)\n080:     return pixels.astype(int, copy=False).reshape(GRID_SHAPE)\n081: \n082: \n083: def generate_input() -> np.ndarray:\n084:     for _ in range(GENERATION_RETRIES):\n085:         result = _gen_attempt()\n086:         if result is not None:\n087:             try:\n088:                 out = main(result)\n089:             except Exception:\n090:                 continue\n091:             if out is not None:\n092:                 return result\n093:     raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRIES} attempts\")\n\n--- starting line 83: def generate_input() -> np.ndarray:\n083: def generate_input() -> np.ndarray:\n084:     for 