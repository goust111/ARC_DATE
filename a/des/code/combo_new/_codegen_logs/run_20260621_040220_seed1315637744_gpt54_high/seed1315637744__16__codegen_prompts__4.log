ral axis-aligned colored line drawings.\n125:     - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n126:     - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n127: \n128:     Rule:\n129:     - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n130:     - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n131:     - The color with no enclosed region is the noise/pad color.\n132:     - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n133: \n134:     Key insight:\n135:     - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n136:     \"\"\"\n137:     g = np.asarray(grid, dtype=int)\n138:     bg = int(get_bg(g))\n139:     assert bg == 0\n140: \n141:     counts: list[tuple[int, int, np.ndarray]] = []\n142:     for color in colors_present(g, exclude={bg}):\n143:         rooms = _room_count_for_color(g, int(color))\n144:         walls = _walls_for_color(g, int(color))\n145:         counts.append((int(color), int(rooms), walls))\n146: \n147:     drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n148:     pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n149:     assert drawings\n150:     assert len(pad_colors) == 1\n151: \n152:     pad = int(pad_colors[0])\n153:     ordered: list[tuple[int, int, np.ndarray]] = []\n154:     for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n155:         group = [item for item in drawings if item[1] == rooms]\n156:         ordered.extend(_cover_order(g, group))\n157: \n158:     width = max(rooms for _color, rooms, _walls in ordered)\n159: \n160:     out = np.full((len(ordered), width), pad, dtype=int)\n161:     for r, (color, rooms, _walls) in enumerate(ordered):\n162:         out[r, :rooms] = int(color)\n163:     return out\n164: \n165: # --------------- generator (claude-opus-4-6) ---------------\n166: \n167: # ---- CFG: Tunable generation parameters ----\n168: _FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n169: _ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n170: _TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n171: _GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n172:     5: (25, 30, 25, 30, 16, 18),\n173:     4: (22, 30, 22, 30, 18, 22),\n174:     3: (20, 30, 20, 30, 22, 25),\n175: }\n176: _CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n177: _NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n178: _WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n179: _EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n180: _OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n181: _GEN_RETRIES = 300                   # outer retry limit\n182: \n183: \n184: def _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n185:     \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n186:     if n * min_gap > max_total:\n187:         return None\n188:     gaps = [min_gap] * n\n189:     remaining = max_total - sum(gaps)\n190:     for i in range(n):\n191:         extra = min(max_gap - gaps[i], remaining)\n192:         if extra > 0:\n193:             add = random.randint(0, extra)\n194:             gaps[i] += add\n195:             remaining -= add\n196:     random.shuffle(gaps)\n197:     return gaps\n198: \n199: \n200: def _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n201:     \"\"\"Build a boolean wall array with exactly tar