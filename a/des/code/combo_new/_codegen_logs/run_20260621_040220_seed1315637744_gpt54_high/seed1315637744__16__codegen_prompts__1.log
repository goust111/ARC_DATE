{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/898e7135.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Inflate a frame's hole-layout and fill each hole with its matching piece.\n\n    Input structure:\n    - bg = most common color. Largest component is a monochrome frame enclosing bg holes.\n    - Outside pieces composed of k×k blocks; k = side of smallest solid square piece.\n\n    Rule:\n    - Extract connected hole regions inside the frame as slots.\n    - Match each piece to a slot by comparing block-level shapes under rotation/flip.\n    - Output the layout scaled by k, with pieces placed in slots; frame color as background.\n\n    Key insight: Pieces are k×k-block-scaled versions of holes; downsampling reveals shape matches under all 8 orientations.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    # --- find the largest connected component of foreground (multicolor) ---\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n    frame_comp = max(comps, key=lambda d: int(d[\"area\"]))\n    fr0, fc0, fr1, fc1 = map(int, frame_comp[\"bbox\"])\n\n    # The frame is monochrome; use its dominant color as output background.\n    frame_cols = [int(g[int(r), int(c)]) for r, c in frame_comp[\"coords\"]]\n    bgc = int(Counter(frame_cols).most_common(1)[0][0])\n\n    # --- layout = bg holes inside the frame bbox, tight-cropped ---\n    sub = crop_bbox(g, (fr0, fc0, fr1, fc1))\n    hole = sub == int(bg)\n    hole_box = bbox(hole)\n    assert hole_box is not None, \"frame must enclose at least one bg hole\"\n    lr0, lc0, lr1, lc1 = map(int, hole_box)\n    layout = hole[lr0 : lr1 + 1, lc0 : lc1 + 1]\n\n    # --- slot components in the layout ---\n    slots = []\n    for coords in components_mask(layout, connectivity=4):\n        rr0, cc0, rr1, cc1 = bbox_coords(coords)\n        rr0, cc0, rr1, cc1 = map(int, (rr0, cc0, rr1, cc1))\n        h = int(rr1 - rr0 + 1)\n        w = int(cc1 - cc0 + 1)\n        sm = np.zeros((h, w), dtype=bool)\n        sm[coords[:, 0] - rr0, coords[:, 1] - cc0] = True\n        slots.append({\"area\": int(sm.sum()), \"r0\": int(rr0), \"c0\": int(cc0), \"mask\": sm})\n    slots.sort(key=lambda s: (-int(s[\"area\"]), int(s[\"r0\"]), int(s[\"c0\"])))\n\n    assert slots, \"frame must contain at least one slot\"\n\n    # --- pieces = non-singleton foreground components excluding the frame component ---\n    pieces = []\n    for comp in comps:\n        if comp is frame_comp:\n            continue\n        coords = comp[\"coords\"]\n        if coords.size == 0 or int(coords.shape[0]) <= 1:\n            continue\n        pr0, pc0, pr1, pc1 = map(int, comp[\"bbox\"])\n        patch = crop_bbox(g, (pr0, pc0, pr1, pc1))\n        ph, pw = map(int, patch.shape)\n        pm = np.zeros((ph, pw), dtype=bool)\n        pm[coords[:, 0] - pr0, coords[:, 1] - pc0] = True\n        pieces.append({\"area\": int(pm.sum()), \"mask\": pm, \"patch\": patch})\n\n    assert pieces, \"at least one non-frame piece must exist\"\n\n    # --- infer k from the smallest solid square piece ---\n    k = None\n    for p in pieces:\n        h, w = map(int, p[\"mask\"].shape)\n        if h == w and int(p[\"mask\"].sum()) == int(h * w):\n            k = int(h) if k is None else min(int(k), int(h))\n    k = int(k or 1)\n\n    def downsample_blocks(mask: np.ndarray) -> np.ndarray | None:\n        hh, ww = mask.shape\n        if hh % k != 0 or ww % k != 0:\n            return None\n        out_h, out_w = int(hh // k), int(ww // k)\n        out = np.zeros((out_h, out_w), dtype=bool)\n        for r in range(out_h):\n            for c in range(out_w):\n                block = mask[int(r * k) : int((r + 1) * k), int(c * k) : int((c + 1) * k)]\n                if bool(block.all()):\n                    out[r, c] = True\n                elif bool(block.any()):\n                    return None\n        return out\n\n    def dihedral_variants(\n        patch: np.ndarray, mask: np.ndarray\n    ) -> list[tuple[np.ndarray, np.ndarray]]:\n        base = []\n        for kk in range(4):\n            p = np.rot90(patch, int(kk))\n            m = np.rot90(mask, int(kk))\n            base.append((p, m))\n            base.append((np.fliplr(p), np.fliplr(m)))\n        uniq = []\n        seen = set()\n        for p, m in base:\n            key = m.tobytes()\n            if key in seen:\n                continue\n            seen.add(key)\n            uniq.append((p, m))\n        return uniq\n\n    # Precompute all usable (piece,variant) candidates with their block masks.\n    candidates = []\n    for pi, p in enumerate(pieces):\n        for vp, vm in dihedral_variants(p[\"patch\"], p[\"mask\"]):\n            um = downsample_blocks(vm)\n            if um is None:\n                continue\n            candidates.append({\"pi\": int(pi), \"area\": int(p[\"area\"]), \"um\": um, \"vp\": vp, \"vm\": vm})\n\n    used_piece: set[int] = set()\n    placements: list[tuple[dict, dict]] = []\n    for s in slots:\n        need_area = int(s[\"area\"]) * int(k) * int(k)\n        found = None\n        for cand in candidates:\n            if int(cand[\"pi\"]) in used_piece:\n                continue\n            if int(cand[\"area\"]) != int(need_area):\n                continue\n            if cand[\"um\"].shape != s[\"mask\"].shape:\n                continue\n            if np.array_equal(cand[\"um\"], s[\"mask\"]):\n                found = cand\n                break\n        assert found is not None, \"every slot must match a piece\"\n        used_piece.add(int(found[\"pi\"]))\n        placements.append((s, found))\n\n    outH = (int(layout.shape[0]) + 2) * int(k)\n    outW = (int(layout.shape[1]) + 2) * int(k)\n    out = np.full((outH, outW), int(bgc), dtype=int)\n\n    for s, cand in placements:\n        top = (int(s[\"r0\"]) + 1) * int(k)\n        left = (int(s[\"c0\"]) + 1) * int(k)\n        paste(out, cand[\"vp\"], int(top), int(left), mask=cand[\"vm\"], overwrite=True)\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for ARC-AGI-2 task 898e7135.\n\nOutput-first strategy:\n  1. Build a hole/wall layout of 4-conn slots (8-separated, includes unit slots).\n  2. For each slot, pick a distinct color + dihedral transform; upscale slot mask\n     by k to get the piece sprite (solid k*k blocks).\n  3. Assemble the frame (layout + 1-cell border of frame_color).\n  4. Scatter pieces outside the frame on a bg=0 canvas, plus single-pixel\n     distractor noise in a fresh color.\n\nThe generator validates main(input) == expected_output before returning.\n\"\"\"\n\nimport random\nimport numpy as np\n\nfrom arc_utils import paste, random_free_location\n\n# --- tunables ----------------------------------------------------------------\n\nK_CHOICES = [2, 3]                  # block scale factor\nLAYOUT_H_RANGE = (4, 12)           # inner layout rows\nLAYOUT_W_RANGE = (4, 8)            # inner layout cols\nN_SLOTS_RANGE = (3, 6)             # total slot count (incl. unit)\nN_UNITS_MAX = 2                    # max unit-slot count per example\nNON_UNIT_SIZE_CHOICES = [2, 3, 4, 5, 6, 7]  # area of non-unit slots\n\nHOLE_DENSITY_RANGE = (0.20, 0.50)  # valid hole fraction of layout area\nUNIT_SLOT_RETRIES = 20             # attempts per unit slot placement\nNON_UNIT_SLOT_RETRIES = 30         # attempts per non-unit slot placement\nGROW_SEED_TRIES = 8                # random seed cells tried per _grow_slot call\n\nCANVAS_DIM_RANGE = (15, 30)        # min/max for canvas height and width\nAREA_BUFFER_MULT = 4               # multiplier on piece area for canvas sizing\nAREA_BUFFER_CONST = 50             # additive constant for canvas area budget\n\nDISTRACTOR_RANGE = (8, 13)         # singleton distractor pixel count\nDISTRACTOR_RETRY_MULT = 10         # retry multiplier for distractor placement\nMIN_DISTRACTORS = 8                # minimum placed distractors to accept\n\nGENERATE_MAX_RETRIES = 300         # outer retry limit in generate_input\n\n\n# --- layout generation -------------------------------------------------------\n\ndef _canonical_shape_key(mask: np.ndarray) -> bytes:\n    \"\"\"Canonical bytes representation under D4 for a bool mask (tight-cropped).\"\"\"\n    variants = []\n    for kk in range(4):\n        r = np.rot90(mask, kk)\n        variants.append(r.tobytes() + bytes([r.shape[0], r.shape[1]]))\n        fr = np.fliplr(r)\n        variants.append(fr.tobytes() + bytes([fr.shape[0], fr.shape[1]]))\n    return min(variants)\n\n\ndef _grow_slot(forbidden: np.ndarray, target_size: int) -> np.ndarray | None:\n    \"\"\"Grow a 4-conn slot of given size starting from a random free cell.\n    `forbidden` marks cells that must not be used. Returns coords array or None.\n    \"\"\"\n    H, W = forbidden.shape\n    free_cells = np.argwhere(~forbidden)\n    if free_cells.size == 0:\n        return None\n    random.shuffle(free_cells)\n    for start in free_cells[:GROW_SEED_TRIES]:\n        r0, c0 = int(start[0]), int(start[1])\n        chosen = {(r0, c0)}\n        frontier = {(r0 - 1, c0), (r0 + 1, c0), (r0, c0 - 1), (r0, c0 + 1)}\n        while len(chosen) < target_size and frontier:\n            cands = [p for p in frontier if 0 <= p[0] < H and 0 <= p[1] < W\n                     and not forbidden[p[0], p[1]] and p not in chosen]\n            if not cands:\n                break\n            nr, nc = random.choice(cands)\n            chosen.add((nr, nc))\n            frontier.discard((nr, nc))\n            frontier.update({(nr - 1, nc), (nr + 1, nc), (nr, nc - 1), (nr, nc + 1)})\n        if len(chosen) == target_size:\n            return np.array(sorted(chosen))\n    return None\n\n\ndef _dilate8(mask: np.ndarray) -> np.ndarray:\n    \"\"\"Dilate a bool mask by 1 cell (8-connectivity).\"\"\"\n    out = mask.copy()\n    out[:-1, :] |= mask[1:, :]\n    out[1:, :] |= mask[:-1, :]\n    out[:, :-1] |= mask[:, 1:]\n    out[:, 1:] |= mask[:, :-1]\n    out[:-1, :-1] |= mask[1:, 1:]\n    out[1:, 1:] |= mask[:-1, :-1]\n    out[:-1, 1:] |= mask[1:, :-1]\n    out[1:, :-1] |= mask[:-1, 1:]\n    return out\n\n\ndef _forbid_coords(forbidden: np.ndarray, coords: np.ndarray) -> None:\n    \"\"\"Mark coords and their 8-neighbors as forbidden (in-place).\"\"\"\n    cell_mask = np.zeros_like(forbidden)\n    cell_mask[coords[:, 0], coords[:, 1]] = True\n    forbidden |= _dilate8(cell_mask)\n\n\ndef _gen_layout(h: int, w: int, n_slots: int, n_units: int) -> list[dict] | None:\n    \"\"\"Generate a layout grid with n_slots 4-connected slots (including n_units unit slots).\n    Returns list of {coords, area, mask, shape_key} or None on failure.\n    Unit slots appear first in the returned list.\n    \"\"\"\n    forbidden = np.zeros((h, w), dtype=bool)\n    slots: list[dict] = []\n    used_shape_keys: set[bytes] = set()\n\n    # Place unit slots first (trivially small, easy to fit)\n    for _ in range(n_units):\n        for _ in range(UNIT_SLOT_RETRIES):\n            coords = _grow_slot(forbidden, 1)\n            if coords is not None:\n                slots.append({\"coords\": coords, \"area\": 1})\n                _forbid_coords(forbidden, coords)\n                break\n        else:\n            return None\n\n    # Place non-unit slots with distinct D4 shapes\n    for _ in range(n_slots - n_units):\n        size = random.choice(NON_UNIT_SIZE_CHOICES)\n        for _ in range(NON_UNIT_SLOT_RETRIES):\n            coords = _grow_slot(forbidden, size)\n            if coords is None:\n                continue\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            sm = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)\n            sm[coords[:, 0] - r0, coords[:, 1] - c0] = True\n            key = _canonical_shape_key(sm)\n            if key in used_shape_keys:\n                continue\n            used_shape_keys.add(key)\n            slots.append({\"coords\": coords, \"area\": size, \"mask\": sm, \"shape_key\": key})\n            _forbid_coords(forbidden, coords)\n            break\n        else:\n            return None\n\n    # Validate hole density\n    density = sum(s[\"area\"] for s in slots) / (h * w)\n    lo, hi = HOLE_DENSITY_RANGE\n    if not (lo <= density <= hi):\n        return None\n\n    return slots\n\n\n# --- piece construction ------------------------------------------------------\n\ndef _make_piece(slot: dict, color: int, k: int, apply_dihedral: bool) -> dict:\n    \"\"\"Build output and input patches for one slot.\n    For unit slots (area=1), the piece is a solid k*k square with no dihedral\n    transform needed. For non-unit slots, a random dihedral is applied to the\n    input-side patch.\n    \"\"\"\n    if slot[\"area\"] == 1:\n        patch = np.full((k, k), color, dtype=int)\n        mask = np.ones((k, k), dtype=bool)\n        return {\"color\": color, \"slot\": slot,\n                \"out_patch\": patch, \"out_mask\": mask,\n                \"in_patch\": patch, \"in_mask\": mask}\n\n    out_mask = np.kron(slot[\"mask\"], np.ones((k, k), dtype=bool))\n    out_patch = np.where(out_mask, color, 0).astype(int)\n\n    if apply_dihedral:\n        rot = random.randint(0, 3)\n        in_mask = np.rot90(out_mask, rot)\n        in_patch = np.rot90(out_patch, rot)\n        if random.random() < 0.5:\n            in_mask = np.fliplr(in_mask)\n            in_patch = np.fliplr(in_patch)\n    else:\n        in_mask, in_patch = out_mask, out_patch\n\n    return {\"color\": color, \"slot\": slot,\n            \"out_patch\": out_patch, \"out_mask\": out_mask,\n            \"in_patch\": in_patch, \"in_mask\": in_mask}\n\n\n# --- output assembly ---------------------------------------------------------\n\ndef _build_expected_output(pieces: list[dict], layout_h: int, layout_w: int,\n                           k: int, frame_color: int) -> np.ndarray:\n    \"\"\"Assemble the expected output grid: frame_color background with pieces placed.\"\"\"\n    out = np.full(((layout_h + 2) * k, (layout_w + 2) * k), frame_color, dtype=int)\n    for p in pieces:\n        coords = p[\"slot\"][\"coords\"]\n        top = (int(coords[:, 0].min()) + 1) * k\n        left = (int(coords[:, 1].min()) + 1) * k\n        paste(out, p[\"out_patch\"], top, left, mask=p[\"out_mask\"], overwrite=True)\n    return out\n\n\n# --- input canvas assembly ---------------------------------------------------\n\ndef _build_input_canvas(pieces: list[dict], layout_mask: np.ndarray,\n                        layout_h: int, layout_w: int, k: int,\n                        frame_color: int, distractor_color: int) -> np.ndarray | None:\n    \"\"\"Build the input grid: frame + scattered pieces + distractor noise.\n    Returns canvas or None if placement fails.\n    \"\"\"\n    frame_h, frame_w = layout_h + 2, layout_w + 2\n    total_piece_area = sum(int(p[\"in_mask\"].sum()) for p in pieces)\n    needed_cells = frame_h * frame_w + AREA_BUFFER_MULT * total_piece_area + AREA_BUFFER_CONST\n\n    # Canvas dimensions: start random within spec range, grow if area insufficient\n    min_h = max(CANVAS_DIM_RANGE[0], frame_h + 2)\n    min_w = max(CANVAS_DIM_RANGE[0], frame_w + 2)\n    canvas_h = random.randint(min_h, CANVAS_DIM_RANGE[1])\n    canvas_w = random.randint(min_w, CANVAS_DIM_RANGE[1])\n    while canvas_h * canvas_w < needed_cells and (canvas_h < CANVAS_DIM_RANGE[1] or canvas_w < CANVAS_DIM_RANGE[1]):\n        if canvas_h <= canvas_w and canvas_h < CANVAS_DIM_RANGE[1]:\n            canvas_h += 1\n        elif canvas_w < CANVAS_DIM_RANGE[1]:\n            canvas_w += 1\n        else:\n            break\n    if canvas_h * canvas_w < needed_cells:\n        return None\n\n    canvas = np.zeros((canvas_h, canvas_w), dtype=int)\n\n    # Build and place the frame (1-cell border of frame_color around the layout)\n    frame_img = np.full((frame_h, frame_w), frame_color, dtype=int)\n    frame_img[1:-1, 1:-1] = np.where(layout_mask, 0, frame_color)\n    fr_max, fc_max = canvas_h - frame_h - 1, canvas_w - frame_w - 1\n    if fr_max < 1 or fc_max < 1:\n        return None\n    paste(canvas, frame_img, random.randint(1, fr_max), random.randint(1, fc_max))\n\n    # Place pieces outside the frame, largest-first for better packing\n    for p in sorted(pieces, key=lambda p: -int(p[\"in_mask\"].sum())):\n        try:\n            pr, pc = random_free_location(\n                canvas, p[\"in_patch\"],\n                transparent=0, border=0, padding=1, padding_connectivity=8,\n            )\n        except ValueError:\n            return None\n        paste(canvas, p[\"in_patch\"], pr, pc, mask=p[\"in_mask\"], overwrite=True)\n\n    # Scatter distractor singletons (isolated single pixels in a dedicated color)\n    n_distractors = random.randint(*DISTRACTOR_RANGE)\n    placed = 0\n    for _ in range(n_distractors * DISTRACTOR_RETRY_MULT):\n        if placed >= n_distractors:\n            break\n        rr, cc = random.randint(0, canvas_h - 1), random.randint(0, canvas_w - 1)\n        if canvas[rr, cc] != 0:\n            continue\n        r_lo, r_hi = max(0, rr - 1), min(canvas_h, rr + 2)\n        c_lo, c_hi = max(0, cc - 1), min(canvas_w, cc + 2)\n        if np.any(canvas[r_lo:r_hi, c_lo:c_hi] != 0):\n            continue\n        canvas[rr, cc] = distractor_color\n        placed += 1\n    if placed < MIN_DISTRACTORS:\n        return None\n\n    # bg=0 must remain the most common color for solver's get_bg\n    vals, counts = np.unique(canvas, return_counts=True)\n    if int(vals[np.argmax(counts)]) != 0:\n        return None\n\n    return canvas\n\n\n# --- main generator attempt --------------------------------------------------\n\ndef _gen_attempt() -> np.ndarray | None:\n    k = random.choice(K_CHOICES)\n    layout_h = random.randint(*LAYOUT_H_RANGE)\n    layout_w = random.randint(*LAYOUT_W_RANGE)\n    n_slots = random.randint(*N_SLOTS_RANGE)\n    n_units = random.randint(1, min(N_UNITS_MAX, n_slots - 1))\n\n    # Allocate colors: frame, distractor, then per-piece\n    palette = list(range(1, 10))\n    random.shuffle(palette)\n    frame_color = palette.pop()\n    distractor_color = palette.pop()\n    needed_piece_colors = (n_slots - n_units) + 1  # +1 shared unit color\n    if len(palette) < needed_piece_colors:\n        return None\n    non_unit_colors = palette[:n_slots - n_units]\n    unit_color = palette[n_slots - n_units]\n\n    # Build layout\n    slots = _gen_layout(layout_h, layout_w, n_slots, n_units)\n    if slots is None:\n        return None\n    unit_slots = slots[:n_units]\n    non_unit_slots = slots[n_units:]\n\n    # Validate that holes touch all 4 borders (so solver's tight-crop matches our layout)\n    layout_mask = np.zeros((layout_h, layout_w), dtype=bool)\n    for s in slots:\n        layout_mask[s[\"coords\"][:, 0], s[\"coords\"][:, 1]] = True\n    if not (layout_mask[0].any() and layout_mask[-1].any()\n            and layout_mask[:, 0].any() and layout_mask[:, -1].any()):\n        return None\n\n    # Build pieces\n    pieces = [_make_piece(s, non_unit_colors[i], k, apply_dihedral=True)\n              for i, s in enumerate(non_unit_slots)]\n    pieces += [_make_piece(s, unit_color, k, apply_dihedral=False)\n               for s in unit_slots]\n\n    # Build expected output\n    expected_out = _build_expected_output(pieces, layout_h, layout_w, k, frame_color)\n\n    # Build input canvas\n    canvas = _build_input_canvas(pieces, layout_mask, layout_h, layout_w, k,\n                                 frame_color, distractor_color)\n    if canvas is None:\n        return None\n\n    # Oracle check\n    try:\n        produced = main(canvas)\n    except Exception:\n        return None\n    if not np.array_equal(produced, expected_out):\n        return None\n\n    return canvas\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/a25697e4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Dock movable tools into border-anchored frames by filling cavities.\n\n    Input structure:\n    - bg = most common color.\n    - Border-touching components cluster into anchor frames with interior bg cavities.\n    - Non-border 2-color components are movable tools.\n\n    Rule:\n    - Match each tool to a frame whose cavity size equals one of its color-region counts.\n    - Rotate/flip the tool so one color fills the cavity exactly; the other stays outside.\n    - If the docking orientation uses a reflection, swap the tool's two colors.\n\n    Key insight: Cavity size determines tool–frame pairing; reflection triggers color swap.\n    \"\"\"\n    inp = grid\n    g = inp.copy()\n    bg = get_bg(g)\n    H, W = g.shape\n\n    def bbox_gap(a, b) -> int:\n        (ar0, ac0, ar1, ac1) = a\n        (br0, bc0, br1, bc1) = b\n        def gap1(x0, x1, y0, y1):\n            if y1 < x0:\n                return int(x0 - y1)\n            if x1 < y0:\n                return int(y0 - x1)\n            return 0\n        return gap1(ar0, ar1, br0, br1) + gap1(ac0, ac1, bc0, bc1)\n\n    fg = g != int(bg)\n    lab, n = label(fg, structure=STRUCT4)\n    fixed_mask = np.zeros((H, W), dtype=bool)\n    fixed_components = []\n    for cid in range(1, n + 1):\n        pts = np.argwhere(lab == cid)\n        pts_list = [(int(r), int(c)) for r, c in pts]\n        touches = any(r == 0 or r == H - 1 or c == 0 or c == W - 1 for r, c in pts_list)\n        if not touches:\n            continue\n        fixed_components.append({\"pts\": pts_list, \"bbox\": (int(pts[:,0].min()), int(pts[:,1].min()), int(pts[:,0].max()), int(pts[:,1].max()))})\n        for r, c in pts_list:\n            fixed_mask[r, c] = True\n\n    assert not (not fixed_components)\n\n    # Cluster fixed components into anchor frames.\n    parent = list(range(len(fixed_components)))\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(a, b):\n        ra, rb = find(a), find(b)\n        if ra != rb:\n            parent[rb] = ra\n\n    for i in range(len(fixed_components)):\n        for j in range(i + 1, len(fixed_components)):\n            if bbox_gap(fixed_components[i][\"bbox\"], fixed_components[j][\"bbox\"]) <= 2:\n                union(i, j)\n\n    groups: dict[int, list[int]] = {}\n    for i in range(len(fixed_components)):\n        groups.setdefault(find(i), []).append(i)\n\n    anchor_groups = []\n    for idxs in groups.values():\n        pts = [p for i in idxs for p in fixed_components[i][\"pts\"]]\n        rs = [r for r, _c in pts]\n        cs = [c for _r, c in pts]\n        bbox = (min(rs), min(cs), max(rs), max(cs))\n        mask = np.zeros((H, W), dtype=bool)\n        for r, c in pts:\n            mask[r, c] = True\n        sock = np.zeros((H, W), dtype=bool)\n        for r in range(bbox[0], bbox[2] + 1):\n            for c in range(bbox[1], bbox[3] + 1):\n                if int(g[r, c]) != int(bg):\n                    continue\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    rr, cc = r + dr, c + dc\n                    if 0 <= rr < H and 0 <= cc < W and mask[rr, cc]:\n                        sock[r, c] = True\n                        break\n\n        # Cavity = largest bg component inside bbox that is adjacent to the anchor pixels.\n        cavity = np.zeros((H, W), dtype=bool)\n        sub_bg = (g[bbox[0] : bbox[2] + 1, bbox[1] : bbox[3] + 1] == int(bg))\n        sub_lab, sub_n = label(sub_bg, structure=STRUCT4)\n        best_c = None  # (area, cid)\n        for cid in range(1, sub_n + 1):\n            ptsc = np.argwhere(sub_lab == cid)\n            area = int(len(ptsc))\n            # check adjacency to anchor within bbox\n            adj = False\n            for rr, cc in ptsc:\n                r = int(bbox[0] + rr)\n                c = int(bbox[1] + cc)\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    r2, c2 = r + dr, c + dc\n                    if bbox[0] <= r2 <= bbox[2] and bbox[1] <= c2 <= bbox[3] and mask[r2, c2]:\n                        adj = True\n                        break\n                if adj:\n                    break\n            if not adj:\n                continue\n            cand = (area, -cid)\n            if best_c is None or cand > best_c:\n                best_c = cand\n                best_id = cid\n        if best_c is not None:\n            ptsc = np.argwhere(sub_lab == best_id)\n            for rr, cc in ptsc:\n                cavity[int(bbox[0] + rr), int(bbox[1] + cc)] = True\n        cav_bbox = None\n        if cavity.any():\n            ptsc2 = np.argwhere(cavity)\n            r0c, c0c = ptsc2.min(axis=0)\n            r1c, c1c = ptsc2.max(axis=0)\n            cav_bbox = (int(r0c), int(c0c), int(r1c), int(c1c))\n\n        # swap rule for this anchor group: look for a color that appears in >=2 fixed sub-components\n        # (within the group) with different sizes and larger-above-smaller.\n        swap_needed = False\n        for col in sorted({int(x) for x in np.unique(g[mask])} - {int(bg)}):\n            sub = (g == int(col)) & mask\n            labc, nc = label(sub, structure=STRUCT4)\n            if nc < 2:\n                continue\n            comps = []\n            for cid in range(1, nc + 1):\n                ptsc = np.argwhere(labc == cid)\n                comps.append((int(len(ptsc)), float(ptsc[:, 0].mean()), float(ptsc[:, 1].mean())))\n            comps.sort(reverse=True)\n            (s0, r0, _c0), (s1, r1, _c1) = comps[0], comps[1]\n            # Swap only when the larger component is vertically above the smaller one.\n            if s0 != s1 and r0 < r1:\n                swap_needed = True\n                break\n\n        # Dominant open direction: which side has the most bg neighbors.\n        dir_list = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # U,D,L,R\n        dir_counts = [0, 0, 0, 0]\n        for r, c in pts:\n            for di, (dr, dc) in enumerate(dir_list):\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(bg):\n                    dir_counts[di] += 1\n        open_dir = dir_list[int(np.argmax(dir_counts))]\n        _labg, _ng = label(mask, structure=STRUCT4)\n        single_piece = int(_ng) == 1\n        cavity_size = int(cavity.sum())\n\n        anchor_groups.append(\n            {\n                \"mask\": mask,\n                \"bbox\": bbox,\n                \"socket_mask\": sock,\n                \"cavity_mask\": cavity,\n                \"cavity_bbox\": cav_bbox,\n                \"open_dir\": open_dir,\n                \"swap_needed\": swap_needed,\n                \"single_piece\": single_piece,\n                \"cavity_size\": cavity_size,\n                \"size\": int(mask.sum()),\n            }\n        )\n    anchor_groups.sort(key=lambda d: -d[\"size\"])\n\n    # Movable multi-color components are the remaining foreground pixels.\n    mov_mask = fg & (~fixed_mask)\n    mov_lab, mov_n = label(mov_mask, structure=STRUCT4)\n    mov_comps = []\n    for cid in range(1, mov_n + 1):\n        pts = np.argwhere(mov_lab == cid)\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        m = mov_lab[r0 : r1 + 1, c0 : c1 + 1] == cid\n        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        patch[~m] = 0\n        mov_comps.append({\"bbox\": (int(r0), int(c0), int(r1), int(c1)), \"mask\": m, \"patch\": patch, \"size\": int(len(pts))})\n    mov_comps.sort(key=lambda d: -d[\"size\"])\n\n    def choose_group(bbox) -> int:\n        best_i = 0\n        best_d = None\n        for i, grp in enumerate(anchor_groups):\n            d = bbox_gap(bbox, grp[\"bbox\"])\n            if best_d is None or d < best_d:\n                best_d = d\n                best_i = i\n        return int(best_i)\n\n    def gen_variants(patch: np.ndarray, mask: np.ndarray):\n        \"\"\"All unique dihedral variants, with a reflection flag.\"\"\"\n        base: list[tuple[np.ndarray, np.ndarray, bool]] = []\n        for k in range(4):\n            p = np.rot90(patch, k)\n            m = np.rot90(mask, k)\n            base.append((p, m, False))\n            base.append((np.fliplr(p), np.fliplr(m), True))\n        uniq: list[tuple[np.ndarray, np.ndarray, bool]] = []\n        seen = set()\n        for p, m, is_flip in base:\n            key = (m.tobytes(), p[m].tobytes())\n            if key in seen:\n                continue\n            seen.add(key)\n            uniq.append((p, m, is_flip))\n        return uniq\n\n    out = np.full_like(g, int(bg))\n    out[fixed_mask] = g[fixed_mask]\n    placed_global = fixed_mask.copy()\n    placed_groups = [grp[\"mask\"].copy() for grp in anchor_groups]\n\n    group_for_comp: list[int]\n    # Match condition (key): a tool can dock into a frame only if one of its two color-regions has\n    # pixel-count equal to the frame's cavity size. Use this to assign tools to frames (one-to-one\n    # when counts match), falling back to distance only if no such match exists.\n    comp_color_counts: list[dict[int, int]] = []\n    for comp in mov_comps:\n        vals = [int(x) for x in comp[\"patch\"][comp[\"mask\"]].flatten() if int(x) != 0]\n        comp_color_counts.append(dict(Counter(vals)))\n\n    def compatible(ci: int, gi: int) -> bool:\n        cav_sz = int(anchor_groups[gi][\"cavity_size\"])\n        return any(int(v) == cav_sz for v in comp_color_counts[ci].values())\n\n    if len(mov_comps) == len(anchor_groups) and len(anchor_groups) > 1:\n        import itertools\n\n        best_perm = None\n        best_score = None\n        for perm in itertools.permutations(range(len(anchor_groups))):\n            ok = True\n            hits = 0\n            dist_sum = 0\n            for ci, gi in enumerate(perm):\n                if not compatible(ci, gi):\n                    ok = False\n                    break\n                hits += 1\n                dist_sum += bbox_gap(mov_comps[ci][\"bbox\"], anchor_groups[gi][\"bbox\"])\n            if not ok:\n                continue\n            score = (int(hits), -int(dist_sum))\n            if best_score is None or score > best_score:\n                best_score = score\n                best_perm = perm\n        assert best_perm is not None, 'must find a compatible tool-to-frame permutation'\n        group_for_comp = [int(x) for x in best_perm]\n    else:\n        group_for_comp = []\n        for ci, comp in enumerate(mov_comps):\n            best_g = None\n            best_d = None\n            for gi, grp in enumerate(anchor_groups):\n                if not compatible(ci, gi):\n                    continue\n                d = bbox_gap(comp[\"bbox\"], grp[\"bbox\"])\n                if best_d is None or d < best_d:\n                    best_d = d\n                    best_g = gi\n            group_for_comp.append(int(best_g) if best_g is not None else int(choose_group(comp[\"bbox\"])))\n\n    for comp, gi in zip(mov_comps, group_for_comp):\n        grp = anchor_groups[gi]\n        placed_grp = placed_groups[gi]\n        sock = grp[\"socket_mask\"]\n        cav = grp[\"cavity_mask\"]\n        cav_bbox = grp[\"cavity_bbox\"]\n        odr, odc = grp[\"open_dir\"]\n        # Swap rule (more principled): swap the two tool colors iff the *docking transform* uses a\n        # reflection (flip). We'll detect this from the winning variant. (Ignore equal-area 2-color\n        # tools: swapping is ambiguous and not needed.)\n        comp_vals = [int(x) for x in comp[\"patch\"][comp[\"mask\"]].flatten() if int(x) != 0]\n        comp_counts = Counter(comp_vals)\n\n        best_state = None\n        # Score prioritizes *filling the cavity* with exactly one tool color region.\n        # (plug_full, plug_hits, -nonplug_in_cavity, -plug_outside, cavity_hits, adj, outside, socket_hits, -dist, -r0, -c0)\n        best_score = None\n        cav_sz = int(grp[\"cavity_size\"])\n        for p, m, is_flip in gen_variants(comp[\"patch\"], comp[\"mask\"]):\n            h, w = m.shape\n            coords = np.argwhere(m)\n            cols_here = sorted({int(x) for x in p[m].flatten() if int(x) != 0})\n            plug_colors = [int(col) for col in cols_here if int(((p == int(col)) & m).sum()) == cav_sz]\n            assert plug_colors\n            for r0 in range(0, H - h + 1):\n                for c0 in range(0, W - w + 1):\n                    ok = True\n                    for rr, cc in coords:\n                        r = int(r0 + rr)\n                        c = int(c0 + cc)\n                        if placed_global[r, c]:\n                            ok = False\n                            break\n                    if not ok:\n                        continue\n                    adj = 0\n                    for rr, cc in coords:\n                        r = int(r0 + rr)\n                        c = int(c0 + cc)\n                        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                            r2, c2 = r + dr, c + dc\n                            if 0 <= r2 < H and 0 <= c2 < W and placed_grp[r2, c2]:\n                                adj += 1\n                    if adj == 0:\n                        continue\n                    socket_hits = 0\n                    cavity_hits = 0\n                    outside = 0\n                    # Best plug-match for this placement among candidate plug colors.\n                    plug_best = None  # (plug_full, plug_hits, -nonplug_in_cavity, -plug_outside)\n                    for rr, cc in coords:\n                        r = int(r0 + rr)\n                        c = int(c0 + cc)\n                        if sock[r, c]:\n                            socket_hits += 1\n                        if cav[r, c]:\n                            cavity_hits += 1\n                        # Count pixels placed outside the anchor bbox in the dominant open direction.\n                        br0, bc0, br1, bc1 = grp[\"bbox\"]\n                        if odc == -1 and c < bc0:\n                            outside += 1\n                        elif odc == 1 and c > bc1:\n                            outside += 1\n                        elif odr == -1 and r < br0:\n                            outside += 1\n                        elif odr == 1 and r > br1:\n                            outside += 1\n\n                    for plug_col in plug_colors:\n                        if plug_col is None:\n                            plug_score = (0, 0, 0, 0)\n                        else:\n                            plug_hits = 0\n                            plug_outside = 0\n                            nonplug_in_cav = 0\n                            for rr, cc in coords:\n                                r = int(r0 + rr)\n                                c = int(c0 + cc)\n                                in_cav = bool(cav[r, c])\n                                col = int(p[rr, cc])\n                                if col == int(plug_col):\n                                    if in_cav:\n                                        plug_hits += 1\n                                    else:\n                                        plug_outside += 1\n                                else:\n                                    if in_cav:\n                                        nonplug_in_cav += 1\n                            plug_full = int(plug_hits == cav_sz and plug_outside == 0 and nonplug_in_cav == 0)\n                            plug_score = (int(plug_full), int(plug_hits), -int(nonplug_in_cav), -int(plug_outside))\n                        if plug_best is None or plug_score > plug_best:\n                            plug_best = plug_score\n                    dist = bbox_gap(grp[\"bbox\"], (int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1)))\n                    score = tuple(plug_best) + (\n                        int(cavity_hits),\n                        int(adj),\n                        int(outside),\n                        int(socket_hits),\n                        -int(dist),\n                        -int(r0),\n                        -int(c0),\n                    )\n                    if best_score is None or score > best_score:\n                        best_score = score\n                        best_state = (p, m, int(r0), int(c0), bool(is_flip))\n\n        assert best_state is not None, 'must find a valid placement for every movable tool'\n        p, m, r0, c0, is_flip = best_state\n        if is_flip and len(comp_counts) == 2 and len(set(comp_counts.values())) == 2:\n            a, b = sorted(comp_counts.keys())\n            q = p.copy()\n            q[(p == a) & m] = b\n            q[(p == b) & m] = a\n            p = q\n        for rr, cc in np.argwhere(m):\n            r = int(r0 + rr)\n            c = int(c0 + cc)\n            out[r, c] = int(p[rr, cc])\n            placed_global[r, c] = True\n            placed_grp[r, c] = True\n\n    return out\n\n# --------------- generator (O4) ---------------\n\nfrom arc_utils import bbox as _bbox\n\n# ── CFG: canvas ──\nGRID_H_RANGE = (18, 30)          # output grid height\nGRID_W_RANGE = (25, 30)          # output grid width\nNUM_PAIRS_CHOICES = [1, 2]       # how many frame-tool pairs\n\n# ── CFG: frame geometry ──\nFRAME_W_RANGE = (4, 8)           # frame width (exclusive upper)\nNOTCH_N_RANGE = (1, 4)           # notch cell count (exclusive upper)\nTOP_H_RANGE = (1, 4)             # top bar height (exclusive upper)\nBOT_H_RANGE = (2, 4)             # bottom bar height (exclusive upper)\nPLUG_AREA_BOUNDS = (5, 8)        # valid plug area = fw + notch_n\n\n# ── CFG: tool sizing ──\nHANDLE_AREA_RANGE = (4, 10)      # handle pixel count (exclusive upper)\nTOOL_TOTAL_BOUNDS = (10, 15)     # plug + handle total pixels\nHANDLE_SPRITE_DIM = (2, 5)      # handle sprite bbox side (exclusive upper)\n\n# ── CFG: placement ──\nUNION_BBOX_GAP_MIN = 2           # min gap between pair union bboxes\nFRAME_BBOX_GAP_MIN = 3           # min gap between frame bboxes\nTOOL_BORDER = 1                  # border margin for free tool placement\nTOOL_PADDING = 3                 # padding around existing content\nTOOL_PADDING_CONN = 4            # connectivity for padding check\n\n# ── CFG: retry limits ──\nPAIR_SPEC_RETRIES = 300          # retries for picking compatible pair specs\nHANDLE_SPRITE_RETRIES = 30       # retries for generating a valid handle sprite\nGEN_ATTEMPT_RETRIES = 300        # outer retries in generate_input()\n\n\ndef _bbox_gap(a, b) -> int:\n    \"\"\"Manhattan gap between two axis-aligned bboxes (r0,c0,r1,c1).\"\"\"\n    (ar0, ac0, ar1, ac1) = a\n    (br0, bc0, br1, bc1) = b\n\n    def _gap1(x0, x1, y0, y1):\n        if y1 < x0:\n            return x0 - y1\n        if x1 < y0:\n            return y0 - x1\n        return 0\n\n    return _gap1(ar0, ar1, br0, br1) + _gap1(ac0, ac1, bc0, bc1)\n\n\ndef _transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:\n    \"\"\"Apply rot90(k) then optional horizontal flip.\"\"\"\n    out = np.rot90(arr, k)\n    if flip:\n        out = np.fliplr(out)\n    return out\n\n\ndef _orient_left_to_side(arr: np.ndarray, side: str) -> np.ndarray:\n    \"\"\"Rotate/flip an array built for the left border to target the given side.\"\"\"\n    if side == \"left\":\n        return arr.copy()\n    if side == \"right\":\n        return np.fliplr(arr)\n    if side == \"top\":\n        return np.rot90(arr, 3)\n    if side == \"bottom\":\n        return np.rot90(arr, 1)\n    raise ValueError(side)\n\n\ndef _swap_colors(patch: np.ndarray, a: int, b: int) -> np.ndarray:\n    \"\"\"Swap two colors in a patch, returning a new array.\"\"\"\n    out = patch.copy()\n    ma, mb = out == a, out == b\n    out[ma] = b\n    out[mb] = a\n    return out\n\n\ndef _notch_offsets(notch_n: int, fw: int, bot_h: int) -> list[tuple[int, int]]:\n    \"\"\"Return (row, col) offsets within the bottom bar to carve out a staircase notch.\"\"\"\n    if notch_n == 1:\n        return [(0, fw - 1)]\n    if notch_n == 2:\n        return [(0, fw - 2), (0, fw - 1)]\n    if notch_n == 3:\n        if bot_h >= 2:\n            return [(0, fw - 2), (0, fw - 1), (1, fw - 1)]\n        return [(0, fw - 3), (0, fw - 2), (0, fw - 1)]\n    raise ValueError(notch_n)\n\n\ndef _make_handle_sprite(handle_area: int, bg: int, handle_color: int) -> np.ndarray | None:\n    \"\"\"Generate a random 4-connected handle sprite with exactly handle_area pixels.\"\"\"\n    lo, hi = HANDLE_SPRITE_DIM\n    dims = [(h, w) for h in range(lo, hi) for w in range(lo, hi)\n            if handle_area <= h * w <= handle_area * 2]\n    if not dims:\n        return None\n    for _ in range(HANDLE_SPRITE_RETRIES):\n        h, w = random.choice(dims)\n        sprite = random_sprite(\n            h, w, density=handle_area / (h * w),\n            color_palette=[handle_color], connectivity=4, background=bg,\n        )\n        if int(np.sum(sprite != bg)) == handle_area:\n            return sprite\n    return None\n\n\ndef _build_left_pair(\n    *, bg: int, frame_color: int, plug_color: int, handle_color: int,\n    fw: int, top_h: int, bot_h: int, notch_n: int, handle_area: int,\n) -> tuple[np.ndarray, np.ndarray] | None:\n    \"\"\"Build a frame + docked tool pair oriented for the left border.\n\n    Returns (frame_array, tool_array) on the same canvas, or None on failure.\n    \"\"\"\n    fh = top_h + 1 + bot_h\n    frame = np.full((fh, fw), bg, dtype=int)\n    frame[:top_h, :] = frame_color\n    frame[top_h + 1:, :] = frame_color\n    for dr, dc in _notch_offsets(notch_n, fw, bot_h):\n        frame[top_h + 1 + dr, dc] = bg\n\n    cavity = frame == bg\n    attach_rows = {r for r in range(fh) if cavity[r, fw - 1]}\n\n    handle_sprite = _make_handle_sprite(handle_area, bg, handle_color)\n    if handle_sprite is None:\n        return None\n\n    hs_h, hs_w = handle_sprite.shape\n    sprite_left_rows = {r for r in range(hs_h) if handle_sprite[r, 0] != bg}\n\n    valid_offsets = [\n        voff for voff in range(fh)\n        if any((voff + sr) in attach_rows for sr in sprite_left_rows)\n    ]\n    if not valid_offsets:\n        return None\n\n    voff = random.choice(valid_offsets)\n    total_h = max(fh, voff + hs_h)\n    total_w = fw + hs_w\n\n    frame_full = np.full((total_h, total_w), bg, dtype=int)\n    frame_full[:fh, :fw] = frame\n\n    tool = np.full((total_h, total_w), bg, dtype=int)\n    tool[:fh, :fw][cavity] = plug_color\n    handle_mask = handle_sprite != bg\n    tool[voff:voff + hs_h, fw:fw + hs_w][handle_mask] = handle_color\n\n    return frame_full, tool\n\n\ndef _build_param_options() -> list[tuple[int, int, int, int]]:\n    \"\"\"Enumerate all valid (fw, top_h, bot_h, notch_n) combinations.\"\"\"\n    fw_lo, fw_hi = FRAME_W_RANGE\n    nn_lo, nn_hi = NOTCH_N_RANGE\n    th_lo, th_hi = TOP_H_RANGE\n    bh_lo, bh_hi = BOT_H_RANGE\n    pa_lo, pa_hi = PLUG_AREA_BOUNDS\n    return [\n        (fw, top_h, bot_h, notch_n)\n        for fw in range(fw_lo, fw_hi)\n        for notch_n in range(nn_lo, nn_hi)\n        if pa_lo <= fw + notch_n <= pa_hi\n        for top_h in range(th_lo, th_hi)\n        for bot_h in range(bh_lo, bh_hi)\n    ]\n\n\nPARAM_OPTIONS = _build_param_options()\n\n\ndef _pick_pair_specs(num_pairs: int) -> list[dict]:\n    \"\"\"Pick frame geometry specs for each pair, ensuring distinct plug areas.\"\"\"\n    ha_lo, ha_hi = HANDLE_AREA_RANGE\n    tt_lo, tt_hi = TOOL_TOTAL_BOUNDS\n    specs: list[dict] = []\n    for _ in range(PAIR_SPEC_RETRIES):\n        specs.clear()\n        used_plug_areas: set[int] = set()\n        for _ in range(num_pairs):\n            candidates = [x for x in PARAM_OPTIONS if x[0] + x[3] not in used_plug_areas]\n            if not candidates:\n                specs = []\n                break\n            fw, top_h, bot_h, notch_n = random.choice(candidates)\n            plug_area = fw + notch_n\n            specs.append({\"fw\": fw, \"top_h\": top_h, \"bot_h\": bot_h,\n                          \"notch_n\": notch_n, \"plug_area\": plug_area})\n            used_plug_areas.add(plug_area)\n        if len(specs) != num_pairs:\n            continue\n        all_plug_areas = {s[\"plug_area\"] for s in specs}\n        ok = True\n        for spec in specs:\n            pa = spec[\"plug_area\"]\n            handle_choices = [\n                h for h in range(ha_lo, ha_hi)\n                if tt_lo <= pa + h <= tt_hi and h != pa and h not in all_plug_areas\n            ]\n            if not handle_choices:\n                ok = False\n                break\n            spec[\"handle_area\"] = random.choice(handle_choices)\n        if ok:\n            return [dict(s) for s in specs]\n    return []\n\n\ndef _candidate_origins(side: str, ph: int, pw: int, H: int, W: int) -> list[tuple[int, int]]:\n    \"\"\"Return shuffled candidate (r0, c0) origins for placing a patch on the given border side.\"\"\"\n    if side == \"left\":\n        origins = [(r0, 0) for r0 in range(H - ph + 1)]\n    elif side == \"right\":\n        origins = [(r0, W - pw) for r0 in range(H - ph + 1)]\n    elif side == \"top\":\n        origins = [(0, c0) for c0 in range(W - pw + 1)]\n    elif side == \"bottom\":\n        origins = [(H - ph, c0) for c0 in range(W - pw + 1)]\n    else:\n        raise ValueError(side)\n    random.shuffle(origins)\n    return origins\n\n\ndef _variant_choices(patch: np.ndarray) -> list[tuple[np.ndarray, bool]]:\n    \"\"\"Return shuffled list of unique D4 variants of patch, each with its flip flag.\"\"\"\n    seen = set()\n    out: list[tuple[np.ndarray, bool]] = []\n    mask = patch != 0\n    for k in range(4):\n        for flip in (False, True):\n            q = _transform(patch, k, flip)\n            m = _transform(mask.astype(np.uint8), k, flip).astype(bool)\n            key = (m.tobytes(), q[m].tobytes())\n            if key in seen:\n                continue\n            seen.add(key)\n            out.append((q, flip))\n    random.shuffle(out)\n    return out\n\n\ndef _place_docked_pair(\n    i: int, spec: dict, colors: list[int], side: str, bg: int,\n    H: int, W: int, output: np.ndarray, input_grid: np.ndarray,\n    union_bboxes: list, frame_bboxes: list,\n) -> dict | None:\n    \"\"\"Build one frame-tool pair, dock it onto the output, and record frame on input_grid.\n\n    Returns tool info dict for later undocking, or None on failure.\n    \"\"\"\n    frame_color = colors[3 * i]\n    plug_color = colors[3 * i + 1]\n    handle_color = colors[3 * i + 2]\n\n    result = _build_left_pair(\n        bg=bg, frame_color=frame_color, plug_color=plug_color,\n        handle_color=handle_color, fw=spec[\"fw\"], top_h=spec[\"top_h\"],\n        bot_h=spec[\"bot_h\"], notch_n=spec[\"notch_n\"],\n        handle_area=spec[\"handle_area\"],\n    )\n    if result is None:\n        return None\n    frame_left, tool_left = result\n\n    # Combine frame + tool into a single docked scene\n    scene_left = np.where(tool_left != bg, tool_left, frame_left)\n\n    frame_scene = _orient_left_to_side(frame_left, side)\n    tool = _orient_left_to_side(tool_left, side)\n    scene = _orient_left_to_side(scene_left, side)\n    ph, pw = scene.shape\n    fr0, fc0, fr1, fc1 = _bbox(frame_scene != bg)\n\n    origin = None\n    for r0, c0 in _candidate_origins(side, ph, pw, H, W):\n        union_bbox = (r0, c0, r0 + ph - 1, c0 + pw - 1)\n        frame_bbox = (r0 + fr0, c0 + fc0, r0 + fr1, c0 + fc1)\n        if side in (\"left\", \"right\") and (frame_bbox[0] == 0 or frame_bbox[2] == H - 1):\n            continue\n        if side in (\"top\", \"bottom\") and (frame_bbox[1] == 0 or frame_bbox[3] == W - 1):\n            continue\n        if any(_bbox_gap(union_bbox, prev) <= UNION_BBOX_GAP_MIN - 1 for prev in union_bboxes):\n            continue\n        if any(_bbox_gap(frame_bbox, prev) <= FRAME_BBOX_GAP_MIN - 1 for prev in frame_bboxes):\n            continue\n        if np.any((output[r0:r0 + ph, c0:c0 + pw] != bg) & (scene != bg)):\n            continue\n        origin = (r0, c0)\n        break\n    if origin is None:\n        return None\n\n    r0, c0 = origin\n    paste(output, scene, r0, c0, transparent=bg)\n    paste(input_grid, frame_scene, r0, c0, transparent=bg)\n\n    union_bboxes.append((r0, c0, r0 + ph - 1, c0 + pw - 1))\n    frame_bboxes.append((r0 + fr0, c0 + fc0, r0 + fr1, c0 + fc1))\n    return {\n        \"tool\": tool, \"plug_color\": plug_color, \"handle_color\": handle_color,\n        \"plug_area\": spec[\"plug_area\"], \"handle_area\": spec[\"handle_area\"],\n    }\n\n\ndef _undock_tool(info: dict, bg: int, input_grid: np.ndarray,\n                 placement_canvas: np.ndarray) -> bool:\n    \"\"\"Pick a random D4 variant of the tool and place it at a free location on the grid.\n\n    Returns True on success, False if no placement found.\n    \"\"\"\n    for patch, is_flip in _variant_choices(info[\"tool\"]):\n        if is_flip and info[\"plug_area\"] != info[\"handle_area\"]:\n            patch = _swap_colors(patch, info[\"plug_color\"], info[\"handle_color\"])\n        try:\n            r0, c0 = random_free_location(\n                placement_canvas, patch, transparent=bg,\n                border=TOOL_BORDER, padding=TOOL_PADDING,\n                padding_connectivity=TOOL_PADDING_CONN,\n            )\n        except ValueError:\n            continue\n        paste(input_grid, patch, r0, c0, transparent=bg)\n        paste(placement_canvas, patch, r0, c0, transparent=bg)\n        return True\n    return False\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n    H = random.randint(*GRID_H_RANGE)\n    W = random.randint(*GRID_W_RANGE)\n    bg = random.choice(list(range(10)))\n    num_pairs = random.choice(NUM_PAIRS_CHOICES)\n\n    pair_specs = _pick_pair_specs(num_pairs)\n    if len(pair_specs) != num_pairs:\n        return None\n\n    colors = [c for c in range(1, 10) if c != bg]\n    random.shuffle(colors)\n    need = 1 + (3 * num_pairs)\n    if len(colors) < need:\n        return None\n\n    sides = random.sample([\"left\", \"right\", \"top\", \"bottom\"], k=num_pairs)\n    output = np.full((H, W), bg, dtype=int)\n    input_grid = np.full((H, W), bg, dtype=int)\n    union_bboxes: list[tuple[int, int, int, int]] = []\n    frame_bboxes: list[tuple[int, int, int, int]] = []\n    placed_tools: list[dict] = []\n\n    for i, spec in enumerate(pair_specs):\n        info = _place_docked_pair(\n            i, spec, colors, sides[i], bg, H, W,\n            output, input_grid, union_bboxes, frame_bboxes,\n        )\n        if info is None:\n            return None\n        placed_tools.append(info)\n\n    placement_canvas = output.copy()\n    for info in placed_tools:\n        if not _undock_tool(info, bg, input_grid, placement_canvas):\n            return None\n\n    if np.array_equal(main(input_grid), output):\n        return input_grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
