{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\npaths = [\n'/home/lixinyu/snap/new/ARC_code/train/e9fc42f2.py',\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n'/home/lixinyu/snap/new/ARC_code/train/d93c6891.py',\n'/home/lixinyu/snap/new/ARC_code/train/8dab14c2.py',\n'/home/lixinyu/snap/new/ARC_code/train/6cbe9eb8.py',\n'/home/lixinyu/snap/new/ARC_code/train/d968ffd4.py',\n'/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n'/home/lixinyu/snap/new/ARC_code/train/fe45cba4.py',\n]\nfor p in paths:\n    text = Path(p).read_text()\n    print('FILE', p)\n    for name in ['def main(', 'def generate_input(']:\n        i = text.find(name)\n        if i == -1:\n            print('MISSING', name)\n            continue\n        j = text.find('\\\\ndef ', i+1)\n        if j == -1:\n            j = len(text)\n        print(text[i:j].rstrip())\n        print('\\\\n---\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\npaths = [\n'/home/lixinyu/snap/new/ARC_code/train/e9fc42f2.py',\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n'/home/lixinyu/snap/new/ARC_code/train/d93c6891.py',\n'/home/lixinyu/snap/new/ARC_code/train/8dab14c2.py',\n'/home/lixinyu/snap/new/ARC_code/train/6cbe9eb8.py',\n'/home/lixinyu/snap/new/ARC_code/train/d968ffd4.py',\n'/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n'/home/lixinyu/snap/new/ARC_code/train/fe45cba4.py',\n]\nfor p in paths:\n    text = Path(p).read_text()\n    print('FILE', p)\n    for name in ['def main(', 'def generate_input(']:\n        i = text.find(name)\n        if i == -1:\n            print('MISSING', name)\n            continue\n        j = text.find('\\\\ndef ', i+1)\n        if j == -1:\n            j = len(text)\n        print(text[i:j].rstrip())\n        print('\\\\n---\\\\n')\nPY\"","aggregated_output":"FILE /home/lixinyu/snap/new/ARC_code/train/e9fc42f2.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Assemble the foreground objects by docking equal-colored boundary markers edge-to-edge.\n\n    Input structure\n    The grid has a dominant background color and several 4-connected multicolor foreground\n    objects.  One foreground color is the body color; the less frequent foreground colors are\n    boundary connector markers, and each marker color appears once as a free end or twice as a\n    matched docking pair.\n\n    Rule\n    Crop each foreground object to its bounding box and translate the objects so that the two\n    occurrences of every paired connector color touch on their exposed boundary sides.  Preserve\n    each object's orientation and colors, then return the tight crop around the assembled\n    foreground on the original background color.\n\n    Key insight\n    The colored marker pixels are ports: matching colors specify which objects must touch, and\n    the marker's side of its object determines the direction of the translation.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    fg = g[g != bg]\n    assert fg.size > 0\n    values, counts = np.unique(fg, return_counts=True)\n    max_count = int(counts.max())\n    body_candidates = [int(v) for v, n in zip(values, counts) if int(n) == max_count]\n    assert len(body_candidates) == 1\n    body = body_candidates[0]\n    marker_colors = {int(v) for v in values if int(v) != body}\n    assert marker_colors\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert len(components) >= 2\n\n    sprites: list[np.ndarray] = []\n    marker_occurrences: dict[int, list[tuple[int, tuple[int, int], tuple[int, int]]]] = defaultdict(list)\n    for idx, comp in enumerate(components):\n        sprite = crop_bbox(g, comp[\"bbox\"])\n        sprites.append(sprite)\n        marker_locs = np.argwhere(np.isin(sprite, list(marker_colors)))\n        assert marker_locs.size > 0\n        for rr, cc in marker_locs:\n            r, c = int(rr), int(cc)\n            direction = _connector_dir(sprite, r, c)\n            marker_occurrences[int(sprite[r, c])].append((idx, (r, c), direction))\n\n    adjacency: list[list[tuple[int, tuple[int, int]]]] = [[] for _ in sprites]\n    paired_markers = 0\n    for occurrences in marker_occurrences.values():\n        assert len(occurrences) in (1, 2)\n        if len(occurrences) == 1:\n            continue\n        (a_idx, a_pos, a_dir), (b_idx, b_pos, b_dir) = occurrences\n        assert a_idx != b_idx\n        assert b_dir == (-a_dir[0], -a_dir[1])\n        delta = (a_pos[0] + a_dir[0] - b_pos[0], a_pos[1] + a_dir[1] - b_pos[1])\n        adjacency[a_idx].append((b_idx, delta))\n        adjacency[b_idx].append((a_idx, (-delta[0], -delta[1])))\n        paired_markers += 1\n    assert paired_markers == len(sprites) - 1\n\n    placements: dict[int, tuple[int, int]] = {0: (0, 0)}\n    queue = deque([0])\n    while queue:\n        idx = queue.popleft()\n        base_r, base_c = placements[idx]\n        for nbr, (dr, dc) in adjacency[idx]:\n            pos = (base_r + dr, base_c + dc)\n            if nbr in placements:\n                assert placements[nbr] == pos\n            else:\n                placements[nbr] = pos\n                queue.append(nbr)\n    assert len(placements) == len(sprites)\n\n    placed_fg: list[tuple[int, int]] = []\n    for idx, sprite in enumerate(sprites):\n        base_r, base_c = placements[idx]\n        for rr, cc in np.argwhere(sprite != bg):\n            placed_fg.append((base_r + int(rr), base_c + int(cc)))\n\n    r0 = min(r for r, _ in placed_fg)\n    c0 = min(c for _, c in placed_fg)\n    r1 = max(r for r, _ in placed_fg)\n    c1 = max(c for _, c in placed_fg)\n    out = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)\n\n    for idx, sprite in enumerate(sprites):\n        base_r, base_c = placements[idx]\n        rr, cc = base_r - r0, base_c - c0\n        mask = sprite != bg\n        target = out[rr : rr + sprite.shape[0], cc : cc + sprite.shape[1]]\n        assert target.shape == sprite.shape\n        assert not np.any((target != bg) & mask)\n        paste(out, sprite, rr, cc, transparent=bg)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette and marker vocabulary.\n_GEN_BG, _GEN_BODY = 2, 1\n_GEN_MARKERS = [3, 4, 8]\n\n# Port sides and their assembly directions.\n_GEN_SIDES = (\"T\", \"B\", \"L\", \"R\")\n_GEN_DIRS = {\"T\": (-1, 0), \"B\": (1, 0), \"L\": (0, -1), \"R\": (0, 1)}\n_GEN_OPPOSITE = {\"T\": \"B\", \"B\": \"T\", \"L\": \"R\", \"R\": \"L\"}\n\n# Canvas and scattering constraints.\n_GEN_CANVAS_SHAPE = (13, 13)\n_GEN_MAX_OUTPUT_SPAN = 13\n_GEN_SCATTER_PADDING, _GEN_PADDING_CONNECTIVITY = 2, 8\n_GEN_SHADOW_BG = 0\n\n# Sprite count, size, and special-case height controls.\n_GEN_SPRITE_COUNT_CHOICES = [2, 3, 4]\n_GEN_MIN_SPRITES, _GEN_MID_SPRITES, _GEN_MAX_SPRITES = 2, 3, 4\n_GEN_HEIGHT_RANGE, _GEN_COMPACT_HEIGHT_RANGE, _GEN_WIDTH_RANGE = (3, 8), (3, 6), (3, 6)\n_GEN_FOUR_SPRITE_HEIGHT_CHOICES = [3, 4, 5, 5, 6]\n_GEN_THREE_SPRITE_COMPACT_PROB = 0.7\n\n# Sprite fill and port-count constraints.\n_GEN_INTERIOR_MARGIN = 1\n_GEN_MIN_DENSITY, _GEN_MAX_DENSITY = 0.36, 0.89\n_GEN_MAX_PORTS_PER_SPRITE = 3\n\n# Generation retry budget.\n_GEN_MAX_ATTEMPTS = 300\n\n---\n\ndef generate_input():\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid e9fc42f2 input\")\n\n---\n\nFILE /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n---\n\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\n---\n\nFILE /home/lixinyu/snap/new/ARC_code/train/d93c6891.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each gray bar into its adjacent orange rectangle as full stripes from the contacted edge.\n\n    Input structure\n    - The scene uses black outside space, yellow fill, gray one-cell-thick bars, and solid orange rectangles.\n    - Each gray bar 4-touches exactly one orange rectangle; some orange rectangles have no touching gray bar.\n    - Gray bars touching the same orange rectangle all have the same orientation.\n\n    Rule\n    - Recolor every original gray cell to yellow.\n    - For each orange rectangle touched by gray bars, count the gray cells assigned to that rectangle.\n    - Horizontal gray bars repaint that many cells as complete orange rows starting from the contacted top or bottom row.\n    - Vertical gray bars repaint that many cells as complete orange columns starting from the contacted left or right column.\n    - Orange rectangles with no touching gray bar remain unchanged.\n\n    Key insight\n    - The gray pixels are not copied by shape; their count is transferred into the neighboring orange rectangle as edge-aligned row or column stripes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.YELLOW, Color.GRAY, Color.ORANGE}\n\n    orange = find_components(g, bg=Color.YELLOW, colors=[Color.ORANGE], connectivity=4)\n    gray = find_components(g, bg=Color.YELLOW, colors=[Color.GRAY], connectivity=4)\n    assert orange and gray, \"expected orange rectangles and gray source bars\"\n\n    orange_index: dict[tuple[int, int], int] = {}\n    orange_bboxes: list[tuple[int, int, int, int]] = []\n    for i, obj in enumerate(orange):\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        assert obj[\"area\"] == bbox_h(obj[\"bbox\"]) * bbox_w(obj[\"bbox\"])\n        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == Color.ORANGE)\n        orange_bboxes.append((int(r0), int(c0), int(r1), int(c1)))\n        for r, c in obj[\"coords\"]:\n            orange_index[(int(r), int(c))] = i\n\n    source_by_target: dict[int, list[tuple[dict, list[tuple[int, int, int, int]]]]] = {}\n    for src in gray:\n        touched: dict[int, list[tuple[int, int, int, int]]] = {}\n        for sr_raw, sc_raw in src[\"coords\"]:\n            sr = int(sr_raw)\n            sc = int(sc_raw)\n            for tr, tc in neighbors4(sr, sc):\n                target_i = orange_index.get((int(tr), int(tc)))\n                if target_i is not None:\n                    touched.setdefault(target_i, []).append((int(tr), int(tc), sr, sc))\n\n        assert len(touched) == 1, \"each gray bar must touch exactly one orange rectangle\"\n        target_i = next(iter(touched))\n        source_by_target.setdefault(target_i, []).append((src, touched[target_i]))\n\n    out = g.copy()\n    out[g == Color.GRAY] = Color.YELLOW\n\n    for target_i, sources in source_by_target.items():\n        r0, c0, r1, c1 = orange_bboxes[target_i]\n        orientations = {_orientation(src[\"coords\"], contacts) for src, contacts in sources}\n        assert len(orientations) == 1, \"all gray bars for one orange rectangle must share orientation\"\n        count = sum(int(src[\"area\"]) for src, _contacts in sources)\n        contacts = [contact for _src, src_contacts in sources for contact in src_contacts]\n\n        if orientations == {\"horizontal\"}:\n            contact_rows = {tr for tr, _tc, _sr, _sc in contacts}\n            assert contact_rows <= {r0, r1}\n            _fill_rows(out, r0, c0, r1, c1, count, contact_rows)\n        else:\n            assert orientations == {\"vertical\"}\n            contact_cols = {tc for _tr, tc, _sr, _sc in contacts}\n            assert contact_cols <= {c0, c1}\n            _fill_cols(out, r0, c0, r1, c1, count, contact_cols)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGRID_H_RANGE, GRID_W_RANGE = (10, 18), (14, 18)\nCONTENT_H_RANGE, CONTENT_W_RANGE = (6, 13), (12, 15)\nBORDER_RANGE = (0, 4)\n\nEDGES, HORIZONTAL_EDGES = (\"top\", \"bottom\", \"left\", \"right\"), (\"top\", \"bottom\")\nORANGE_COUNT_CHOICES, ORANGE_COUNT_WEIGHTS = [1, 2, 3, 4], [1, 2, 3, 4]\nORANGE_H_RANGE, ORANGE_W_RANGE = (1, 5), (2, 6)\nORANGE_AREA_RANGE = (4, 12)\nORANGE_PLACE_RETRIES = 80\n\nMAX_UNTOUCHED_ORANGES = 1\nBARS_PER_ORANGE_RANGE, TOTAL_BARS_RANGE = (1, 2), (2, 6)\nBAR_LENGTH_RANGE = (1, 7)\nBAR_COUNT_RETRIES = 50\n\nGENERATE_RETRIES = 300\n\n---\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATE_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATE_RETRIES} attempts\")\n\n---\n\nFILE /home/lixinyu/snap/new/ARC_code/train/8dab14c2.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Complete each boundary tab or notch by adding the complementary feature on the opposite side of the foreground object.\n\n    Input structure\n    - The grid has exactly two colors: a dominant background and one foreground object.\n    - The foreground object is a thick rectilinear shape with one-pixel tabs and notches on its boundary.\n\n    Rule\n    - A foreground tab is a one-neighbor boundary pixel; project through its full row or column span and remove the opposite edge pixel to make a matching notch.\n    - A background notch is a one-pixel cut with three foreground 4-neighbors; project across the full row or column span and add a tab just outside the opposite edge.\n    - Notches immediately beside a tab source are not independent sources, because that gap belongs to the tab's local boundary shape.\n\n    Key insight\n    - The changed pixels are not color-specific noise; they are paired jigsaw-like boundary features on opposite sides of the same thick row or column cross-section.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g)\n    assert len(colors) == 2, \"task expects exactly one foreground color and one background\"\n    fg_colors = [color for color in colors if color != bg]\n    assert len(fg_colors) == 1, \"task expects a single foreground color\"\n    fg = fg_colors[0]\n\n    mask = g == fg\n    out = g.copy()\n\n    tabs = _tab_sources(mask)\n    tab_cells = {cell for cell, _direction, _target in tabs}\n    changes = 0\n\n    for _cell, _direction, target in tabs:\n        if out[target] != bg:\n            out[target] = bg\n            changes += 1\n\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n            if bool(mask[r, c]):\n                continue\n\n            fg_dirs: list[tuple[int, int]] = []\n            bg_dirs: list[tuple[int, int]] = []\n            for dr, dc in DIRS4:\n                rr, cc = r + dr, c + dc\n                if in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]):\n                    fg_dirs.append((dr, dc))\n                else:\n                    bg_dirs.append((dr, dc))\n\n            if len(fg_dirs) != 3 or len(bg_dirs) != 1:\n                continue\n\n            outside_dr, outside_dc = bg_dirs[0]\n            dr, dc = -outside_dr, -outside_dc\n            side_a = (r - dc, c + dr)\n            side_b = (r + dc, c - dr)\n            if side_a in tab_cells or side_b in tab_cells:\n                continue\n\n            target = _outside_opposite_edge(mask, r, c, dr, dc)\n            if target is not None and not bool(mask[target]):\n                if out[target] != fg:\n                    out[target] = fg\n                    changes += 1\n\n    assert changes > 0, \"at least one complementary boundary feature must be produced\"\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_BG = 8\n_GEN_FG = 1\n_GEN_DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n# Canvas and placement bounds.\n_GEN_ROWS_RANGE = (13, 16)\n_GEN_COLS_RANGE = (15, 17)\n_GEN_MARGIN = 1\n\n# Clean L-shape arm bounds.\n_GEN_H_THICK_RANGE = (3, 5)\n_GEN_V_WIDTH_RANGE = (3, 6)\n_GEN_V_EXTRA_RANGE = (4, 10)\n_GEN_H_WIDTH_RANGE = (11, 14)\n_GEN_MAX_BODY_HEIGHT = 14\n_GEN_MIN_MODE_GAP = 2\n_GEN_MISSING_CORNERS = (\"TL\", \"TR\", \"BL\", \"BR\")\n\n# Boundary source feature counts.\n_GEN_PAIR_COUNT_RANGE = (1, 3)\n_GEN_MAX_TABS = 4\n\n# Retry limits.\n_GEN_MAX_ATTEMPTS = 300\n\n---\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 8dab14c2 input\")\n\n---\n\nFILE /home/lixinyu/snap/new/ARC_code/train/6cbe9eb8.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rebuild the foreground rectangles as a largest-to-smallest lower-left nesting.\n\n    Input structure\n    - A periodic wallpaper background is overlaid by foreground colors that each form a rectangular frame or solid rectangle.\n    - The largest foreground rectangle is the output frame; smaller foreground rectangles are the objects to nest inside it.\n    - A frame may be partially hidden by a smaller rectangle, but its visible pixels still determine its bbox.\n\n    Rule\n    - Ignore the wallpaper and crop the result to the largest foreground rectangle's bbox size.\n    - Sort foreground rectangles by bbox area from largest to smallest.\n    - Reconstruct each frame or solid rectangle, placing every next smaller rectangle in the lower-left of the current rectangle's usable region.\n\n    Key insight\n    - The scattered background colors are not objects; the meaningful order is the unique descending rectangle size chain, and each step nests into the previous rectangle's lower-left interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    items = _foreground_rectangles(g)\n    outer = items[0]\n    out = np.zeros((int(outer[\"height\"]), int(outer[\"width\"])), dtype=int)\n\n    region = _paint_item(out, outer, 0, 0)\n    for item in items[1:]:\n        rr, cc, rh, rw = region\n        h = int(item[\"height\"])\n        w = int(item[\"width\"])\n        assert h <= rh and w <= rw, \"nested rectangle must fit in parent usable region\"\n        r = rr + rh - h\n        c = cc\n        region = _paint_item(out, item, r, c)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n_RNG = np.random.default_rng()\n\n# Colors and sentinels.\nCOLOR_VALUES, FOREGROUND_COLORS = tuple(range(10)), tuple(range(1, 10))\nTRANSPARENT = -1\n# Rectangle chain counts.\nITEM_COUNT_RANGE, THREE_ITEM_FRAME_OPTIONS = (3, 4), (1, 2)\nFOUR_ITEM_FRAME_COUNT = 2\n# Solid rectangle dimensions.\nINNER_SOLID_HEIGHT_RANGE, INNER_SOLID_WIDTH_RANGE = (2, 3), (2, 3)\nSECOND_SOLID_MAX_HEIGHT, SECOND_SOLID_MAX_WIDTH = 9, 9\n# Frame growth and bounds.\nFRAME_MIN_GROWTH, INNER_FRAME_MAX_GROWTH = 2, 5\nINNER_FRAME_MAX_HEIGHT, INNER_FRAME_MAX_WIDTH = 13, 11\nOUTER_FRAME_MIN_HEIGHT, OUTER_FRAME_MIN_WIDTH = 8, 8\nOUTER_FRAME_MAX_HEIGHT, OUTER_FRAME_MAX_WIDTH = 15, 13\n# Wallpaper canvas bounds and margin around the outer rectangle.\nCANVAS_HEIGHT_RANGE, CANVAS_WIDTH_RANGE = (13, 19), (22, 27)\nCANVAS_BORDER_MARGIN = 1\n# Wallpaper tile/color sampling.\nWALLPAPER_COLOR_COUNT_RANGE = (2, 4)\nZERO_WALLPAPER_ROLL_RANGE = (0, 4)\nZERO_WALLPAPER_THRESHOLD = 3\nTILE_SIZE_2 = 2\nTILE_SIZE_OPTIONS, TILE3_SIGN_OPTIONS = (2, 3), (1, 2)\n# Visibility/oracle retry limits.\nVISIBLE_OUTER_MIN_COMPONENT, MAX_VISIBLE_OUTER_COMPONENTS = 3, 4\nGENERATION_RETRY_LIMIT = 300\n\n---\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid input\")\n\n---\n\nFILE /home/lixinyu/snap/new/ARC_code/train/d968ffd4.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Extend each of two aligned rectangular marker objects toward the other, filling half of the gap across the full perpendicular span.\n\n    Input structure\n    - A dominant background contains exactly two solid, same-sized monochromatic rectangles.\n    - The rectangles share either the same row span or the same column span, with a background gap between their facing edges.\n\n    Rule\n    - If the rectangles are side-by-side, color the left half of the inter-object gap across every row with the left object's color, and the right half with the right object's color.\n    - If one rectangle is above the other, color the upper half of the gap across every column with the upper object's color, and the lower half with the lower object's color.\n    - When the gap length is odd, leave the center row/column as background.\n\n    Key insight\n    - The marker objects are endpoints of an axial corridor; their own size identifies the facing edge, while the filled corridor spans the whole grid perpendicular to that axis.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(comps) == 2\n    assert all(_is_solid_rect(g, comp) for comp in comps)\n\n    a, b = comps\n    ar0, ac0, ar1, ac1 = a[\"bbox\"]\n    br0, bc0, br1, bc1 = b[\"bbox\"]\n    assert (ar1 - ar0, ac1 - ac0) == (br1 - br0, bc1 - bc0)\n\n    same_rows = (ar0, ar1) == (br0, br1)\n    same_cols = (ac0, ac1) == (bc0, bc1)\n    assert same_rows != same_cols\n\n    out = g.copy()\n    if same_rows:\n        left, right = sorted(comps, key=lambda comp: comp[\"bbox\"][1])\n        _lr0, _lc0, _lr1, lc1 = left[\"bbox\"]\n        _rr0, rc0, _rr1, _rc1 = right[\"bbox\"]\n        gap = rc0 - lc1 - 1\n        assert gap >= 1\n        span = gap // 2\n        out[:, lc1 + 1 : lc1 + 1 + span] = left[\"color\"]\n        out[:, rc0 - span : rc0] = right[\"color\"]\n    else:\n        top, bottom = sorted(comps, key=lambda comp: comp[\"bbox\"][0])\n        _tr0, _tc0, tr1, _tc1 = top[\"bbox\"]\n        br0, _bc0, _br1, _bc1 = bottom[\"bbox\"]\n        gap = br0 - tr1 - 1\n        assert gap >= 1\n        span = gap // 2\n        out[tr1 + 1 : tr1 + 1 + span, :] = top[\"color\"]\n        out[br0 - span : br0, :] = bottom[\"color\"]\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Layout ranges and bounds.\nALIGNMENTS = (\"H\", \"V\")\nRECT_PERP_BOUNDS = (1, 4)\nRECT_AXIAL_VALUES = range(1, 3)\nGAP_VALUES = range(6, 17)\nAXIAL_BOUNDS = (14, 22)\nMARGIN = 1\nPALETTE = tuple(range(10))\nMAX_GENERATION_ATTEMPTS = 300\nVALID_AXIAL_GAP_PAIRS = tuple(\n    (rect_axial, gap)\n    for rect_axial in RECT_AXIAL_VALUES\n    for gap in GAP_VALUES\n    if AXIAL_BOUNDS[0] <= 2 * rect_axial + gap + 2 * MARGIN <= AXIAL_BOUNDS[1]\n)\n\n---\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid d968ffd4 input\")\n\n---\n\nFILE /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\n---\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\n\n---\n\nFILE /home/lixinyu/snap/new/ARC_code/train/fe45cba4.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the left-edge fragment into its same-colored anchor fragment to complete a solid rectangle.\n\n    Input structure\n    - The grid has a dominant background color.\n    - Exactly one foreground color is split into two 4-connected objects: one\n      touches the left edge, and the other is an anchor away from the left edge.\n    - The translated left-edge object and the anchor can form one filled rectangle.\n    Rule\n    - Find the unique split color whose left-edge object can be translated onto\n      background cells beside the other same-colored object so their union is a\n      solid axis-aligned rectangle.\n    - Clear the left-edge object's original cells to the background.\n    - Paint that object at the unique completing offset, preserving all other cells.\n    Key insight\n    - The active color is identified by object structure and rectangle completion,\n      not by a fixed color id; the same-colored anchor object stays in place.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    color, source, dr, dc = _completion_candidate(g, bg)\n\n    out = g.copy()\n    for r, c in source:\n        out[r, c] = int(bg)\n    for r, c in source:\n        rr, cc = r + dr, c + dc\n        assert int(out[rr, cc]) == int(bg), \"translated source must land on background cells\"\n        out[rr, cc] = int(color)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and object size bounds.\nGRID_SIZE_RANGE = (8, 16)\nOBJECT_HEIGHT_RANGE = (3, 5)\nRECT_WIDTH_RANGE = (4, 7)\nLEFT_PATCH_CANVAS_PAD = 3\n\n# Layout and shape constraints.\nROW_GAP_MIN = 1\nMIN_ROW_WIDTH = 1\nSOURCE_RIGHT_PAD = 2\nDST_WIDTH_RESERVED_COLS = 1\n\n# Sampling controls.\nPALETTE_COLORS = tuple(range(10))\nNONSPLIT_ABOVE_CHOICES = (True, False)\nMAX_GENERATION_ATTEMPTS = 300\n\n---\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid fe45cba4 input\")\n\n---\n\n","exit_code":0,"status":"completed"}}
