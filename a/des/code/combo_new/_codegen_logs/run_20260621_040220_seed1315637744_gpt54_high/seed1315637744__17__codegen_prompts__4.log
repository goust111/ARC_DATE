{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom collections import defaultdict\nimport numpy as np\nNEI4=[(1,0),(-1,0),(0,1),(0,-1)]\n\ndef norm(cells):\n    rs=[r for r,c in cells]; cs=[c for r,c in cells]\n    r0=min(rs); c0=min(cs)\n    return tuple(sorted((r-r0,c-c0) for r,c in cells))\n\ndef polys(max_area=8):\n    out={1:{((0,0),)}}\n    for n in range(2,max_area+1):\n        cur=set()\n        for shape in out[n-1]:\n            s=set(shape)\n            for r,c in shape:\n                for dr,dc in NEI4:\n                    p=(r+dr,c+dc)\n                    if p in s:\n                        continue\n                    cur.add(norm(s|{p}))\n        out[n]=cur\n    return out\n\ndef mask(shape):\n    rs=[r for r,c in shape]; cs=[c for r,c in shape]\n    h=max(rs)+1; w=max(cs)+1\n    m=np.zeros((h,w), dtype=bool)\n    for r,c in shape:\n        m[r,c]=1\n    return m\n\npools=defaultdict(int)\nfor n,shapes in polys().items():\n    if n<3:\n        continue\n    for sh in shapes:\n        m=mask(sh)\n        h,w=m.shape\n        if min(h,w)<2 or max(h,w)>5:\n            continue\n        lr=np.array_equal(m,np.fliplr(m))\n        ud=np.array_equal(m,np.flipud(m))\n        if lr and not ud:\n            pools['lr']+=1\n        elif ud and not lr:\n            pools['ud']+=1\n        elif lr and ud:\n            pools['both']+=1\nprint(pools)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
