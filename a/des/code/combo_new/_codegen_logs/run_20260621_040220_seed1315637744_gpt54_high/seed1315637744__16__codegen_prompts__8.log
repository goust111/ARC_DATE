{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/9385bd28.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg\nimport random\nfrom collections import Counter\n\n\ndef _find_legend(g: np.ndarray, bg: int) -> tuple[int, list[tuple[int, int, int]]]:\n    \"\"\"\n    Legend is a vertical stack of pairs at bottom-left.\n    Each legend row: (marker_color at col c, fill_color at col c+1).\n    Returns (legend_col, entries) where entries are ordered bottom->top as (row, marker, fill).\n    \"\"\"\n    h, w = g.shape\n    start_r = None\n    start_c = None\n    for r in range(h - 1, -1, -1):\n        nz = np.flatnonzero(g[r, :] != bg)\n        if nz.size:\n            start_r = r\n            start_c = int(nz[0])\n            break\n    assert start_r is not None and start_c is not None and start_c < w - 1, \\\n        \"legend must exist at bottom-left with at least 2 columns\"\n\n    entries: list[tuple[int, int, int]] = []\n    c = start_c\n    for r in range(start_r, -1, -1):\n        nz = np.flatnonzero(g[r, :] != bg)\n        if nz.size == 0 or int(nz[0]) != c or int(g[r, c]) == bg:\n            break\n        marker = int(g[r, c])\n        fill = int(g[r, c + 1]) if c + 1 < w else bg\n        entries.append((r, marker, fill))\n    return c, entries\n\n\ndef _l_anchor_present(pts: set[tuple[int, int]], r: int, c: int, arm1: tuple[int, int], arm2: tuple[int, int]) -> bool:\n    \"\"\"\n    Marker corners are L-shapes:\n      TL: (r,c), (r,c+1), (r+1,c)\n      TR: (r,c), (r,c-1), (r+1,c)\n      BL: (r,c), (r,c+1), (r-1,c)\n      BR: (r,c), (r,c-1), (r-1,c)\n\n    This is more robust than checking only corner membership, especially when the bbox is 2-wide/2-tall\n    where L arms can overlap other bbox corners.\n    \"\"\"\n    (dr1, dc1) = arm1\n    (dr2, dc2) = arm2\n    return (r, c) in pts and (r + dr1, c + dc1) in pts and (r + dr2, c + dc2) in pts\n\n\ndef _diamond_mask(h: int, w: int, r0: int, r1: int, c0: int, c1: int, a: tuple[int, int], b: tuple[int, int]) -> np.ndarray:\n    \"\"\"\n    Mask for all cells inside [r0..r1]x[c0..c1] that lie on some shortest 4-neigh path between corners a and b:\n      dist(a,p) + dist(p,b) == dist(a,b)\n    \"\"\"\n    ar, ac = a\n    br, bc = b\n    dab = abs(ar - br) + abs(ac - bc)\n    m = np.zeros((h, w), dtype=bool)\n    for r in range(r0, r1 + 1):\n        for c in range(c0, c1 + 1):\n            if abs(r - ar) + abs(c - ac) + abs(r - br) + abs(c - bc) == dab:\n                m[r, c] = True\n    return m\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill rectangles between diagonal marker pairs using a color legend.\n\n    Input structure:\n    - bg grid with a vertical legend at the bottom-left: each row is a (marker_color, fill_color) pair.\n    - Scattered L-shaped corner markers of each marker color define opposite corners of axis-aligned rectangles.\n    - Some markers are solid 2×2 blocks instead of corner pairs.\n\n    Rule:\n    - Read legend bottom-to-top; for each entry find all pixels of that marker color.\n    - Determine which two bbox corners carry L-shaped anchors — the *other* diagonal defines the fill region.\n    - Fill the diamond (all shortest-path cells between those two corners) with the legend's fill color.\n    - Solid 2×2 marker blocks are simply recolored to the fill color.\n    - Later legend entries are protected from earlier fills.\n\n    Key insight: The L-shaped anchors sit on the marker diagonal; the fill goes on the opposite diagonal of the bounding box.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    bg = get_bg(g)\n    legend_c, entries = _find_legend(g, bg)\n    assert entries, \"legend must contain at least one (marker, fill) entry\"\n\n    legend_mask = np.zeros_like(g, dtype=bool)\n    for r, _, _ in entries:\n        if 0 <= r < h and 0 <= legend_c < w:\n            legend_mask[r, legend_c] = True\n        if 0 <= r < h and 0 <= legend_c + 1 < w:\n            legend_mask[r, legend_c + 1] = True\n\n    out = g.copy()\n\n    marker_order = [m for _, m, _ in entries]\n    marker_set = set(marker_order)\n\n    # Process legend entries bottom -> top; earlier entries must not destroy later marker pixels.\n    for i, (_, marker, fill) in enumerate(entries):\n        eff_fill = int(fill)\n        marker_pts = set(map(tuple, np.argwhere((g == marker) & (~legend_mask))))\n        if len(marker_pts) < 2:\n            continue\n\n        rs = [r for r, _ in marker_pts]\n        cs = [c for _, c in marker_pts]\n        rmin, rmax = min(rs), max(rs)\n        cmin, cmax = min(cs), max(cs)\n\n        # Protect legend cells and all marker pixels for entries that appear later (higher) in the legend.\n        future_markers = set(marker_order[i + 1 :])\n        protect = legend_mask.copy()\n        for fm in future_markers:\n            protect |= (g == fm) & (~legend_mask)\n\n        # Also protect current marker pixels in the common case (so markers remain visible),\n        # except when they form a solid 2x2 block (treated as a filled marker that gets recolored).\n        if rmax - rmin == 1 and cmax - cmin == 1 and len(marker_pts) == 4:\n            # Solid 2x2 marker: recolor these pixels directly.\n            block = np.zeros_like(g, dtype=bool)\n            for r, c in marker_pts:\n                block[r, c] = True\n            out[block & (~protect)] = eff_fill\n            continue\n        else:\n            protect |= (g == marker) & (~legend_mask)\n\n        if rmin == rmax or cmin == cmax:\n            continue\n\n        tl = (rmin, cmin)\n        tr = (rmin, cmax)\n        bl = (rmax, cmin)\n        br = (rmax, cmax)\n\n        tl_anchor = _l_anchor_present(marker_pts, tl[0], tl[1], (0, 1), (1, 0))\n        tr_anchor = _l_anchor_present(marker_pts, tr[0], tr[1], (0, -1), (1, 0))\n        bl_anchor = _l_anchor_present(marker_pts, bl[0], bl[1], (0, 1), (-1, 0))\n        br_anchor = _l_anchor_present(marker_pts, br[0], br[1], (0, -1), (-1, 0))\n\n        score_tlbr = int(tl_anchor) + int(br_anchor)\n        score_trbl = int(tr_anchor) + int(bl_anchor)\n        assert score_tlbr != 0 or score_trbl != 0, \"at least one diagonal must have an L-anchor\"\n        assert score_tlbr != score_trbl, \"diagonal scores must not tie (tie-break path is unreachable)\"\n        if score_tlbr > score_trbl:\n            a, b = tr, bl\n        else:\n            a, b = tl, br\n\n        diamond = _diamond_mask(h, w, rmin, rmax, cmin, cmax, a, b)\n        out[diamond & (~protect)] = eff_fill\n\n    return out\n\n# --------------- generator (C1) ---------------\n\n# ── CFG: canvas & grid ──────────────────────────────────────────────\nGRID_H_RANGE = (10, 19)          # grid height bounds\nGRID_W_RANGE = (10, 19)          # grid width bounds\n\n# ── CFG: legend ─────────────────────────────────────────────────────\nLEGEND_COL_RANGE = (0, 2)        # legend left column (marker at c, fill at c+1)\nLEGEND_ENTRY_RANGE = (2, 5)      # number of legend entries\n\n# ── CFG: marker types ──────────────────────────────────────────────\nNOOP_PROB = 0.3                  # prob of one noop entry (marker with no pixels)\nBLOCK_PROB = 0.25                # prob of one 2x2 block entry\n\n# ── CFG: L-pair bbox shape ──────────────────────────────────────────\nBBOX_H_MAX = 19                  # max bbox height\nBBOX_W_MAX = 12                  # max bbox width\nBBOX_SHAPE_WEIGHTS = [0.75, 0.15, 0.10]  # [both>=3, h=2/w>=4, h>=4/w=2]\nTLBR_PROB = 0.8                  # prob of TL-BR diagonal (vs TR-BL)\n\n# ── CFG: distractor ────────────────────────────────────────────────\nDISTRACTOR_PROB = 0.25           # prob of adding a non-legend L-pair\n\n# ── CFG: retry budgets ─────────────────────────────────────────────\nBLOCK_RETRIES = 100              # placement attempts for a 2x2 block\nLPAIR_RETRIES = 150              # placement attempts for an L-pair\nDISTRACTOR_RETRIES = 60          # placement attempts for distractor\nGEN_RETRIES = 300                # outer generate_input retry budget\n\n_L_OFFSETS = {\n    \"TL\": [(0, 0), (0, 1), (1, 0)],\n    \"TR\": [(0, 0), (0, -1), (1, 0)],\n    \"BL\": [(0, 0), (0, 1), (-1, 0)],\n    \"BR\": [(0, 0), (0, -1), (-1, 0)],\n}\n\n\ndef _l_pair_cells(rmin: int, cmin: int, rmax: int, cmax: int, diag: str) -> list[tuple[int, int]]:\n    \"\"\"Return the 6 cells for an L-pair at opposite bbox corners. diag in {'TLBR','TRBL'}.\"\"\"\n    if diag == \"TLBR\":\n        anchors = [(\"TL\", rmin, cmin), (\"BR\", rmax, cmax)]\n    else:\n        anchors = [(\"TR\", rmin, cmax), (\"BL\", rmax, cmin)]\n    cells: list[tuple[int, int]] = []\n    for name, r, c in anchors:\n        for dr, dc in _L_OFFSETS[name]:\n            cells.append((r + dr, c + dc))\n    return cells\n\n\ndef _l_pair_valid_bbox(h: int, w: int) -> bool:\n    \"\"\"True if (h, w) avoids an L-anchor score tie.\n\n    Fails for (2,2), (2,3), (3,2). Safe: h>=3 and w>=3, or h==2 and w>=4, or h>=4 and w==2.\n    \"\"\"\n    if h < 2 or w < 2:\n        return False\n    if h == 2 and w <= 3:\n        return False\n    if w == 2 and h <= 3:\n        return False\n    return True\n\n\ndef _pick_bbox_size(H: int, W: int) -> tuple[int, int] | None:\n    \"\"\"Pick a random valid L-pair bbox size that fits in (H, W).\"\"\"\n    shape_choice = random.choices(\n        [\"both_ge3\", \"h2_w_ge4\", \"h_ge4_w2\"],\n        weights=BBOX_SHAPE_WEIGHTS,\n    )[0]\n    if shape_choice == \"both_ge3\":\n        bh = random.randint(3, min(BBOX_H_MAX, H))\n        bw = random.randint(3, min(BBOX_W_MAX, W))\n    elif shape_choice == \"h2_w_ge4\":\n        bh = 2\n        w_hi = min(BBOX_W_MAX, W)\n        if w_hi < 4:\n            return None\n        bw = random.randint(4, w_hi)\n    else:\n        h_hi = min(BBOX_H_MAX, H)\n        if h_hi < 4:\n            return None\n        bh = random.randint(4, h_hi)\n        bw = 2\n    if bh > H or bw > W or not _l_pair_valid_bbox(bh, bw):\n        return None\n    return bh, bw\n\n\ndef _try_place_l_pair(H: int, W: int, color: int, retries: int,\n                      can_place, do_place) -> bool:\n    \"\"\"Try to place an L-pair of `color` on the grid within `retries` attempts.\n\n    Returns True on success, False if all attempts failed.\n    \"\"\"\n    for _ in range(retries):\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/df978a02.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/df978a02.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, is_contiguous\nimport random\n\n\ndef _central_background_cell(g: np.ndarray, bg: int, objects: list[dict]) -> tuple[int, int]:\n    candidates: list[tuple[int, int, int, int]] = []\n    height, width = g.shape\n    for r in range(height):\n        for c in range(width):\n            if int(g[r, c]) != bg:\n                continue\n\n            distances = []\n            for obj in objects:\n                coords = obj[\"coords\"]\n                d = np.abs(coords[:, 0] - r) + np.abs(coords[:, 1] - c)\n                distances.append(int(d.min()))\n            candidates.append((sum(distances), max(distances), r, c))\n\n    assert candidates, \"expected at least one background cell\"\n    candidates.sort()\n    assert len(candidates) == 1 or candidates[0][:2] < candidates[1][:2], \"expected a unique central gap\"\n    return int(candidates[0][2]), int(candidates[0][3])\n\n\ndef _inward_tip(obj: dict, center_r: int, center_c: int) -> tuple[int, int]:\n    coords = obj[\"coords\"]\n    distances = np.abs(coords[:, 0] - center_r) + np.abs(coords[:, 1] - center_c)\n    min_dist = int(distances.min())\n    tips = coords[distances == min_dist]\n    assert len(tips) == 1, \"expected each losing object to have one inward tip\"\n    return int(tips[0, 0]), int(tips[0, 1])\n\n\ndef _outward_cap(obj: dict, center_r: int, center_c: int) -> list[tuple[int, int]]:\n    r0, c0, r1, c1 = obj[\"bbox\"]\n    obj_center_r = (r0 + r1) / 2\n    obj_center_c = (c0 + c1) / 2\n    row_offset = obj_center_r - center_r\n    col_offset = obj_center_c - center_c\n\n    if abs(row_offset) > abs(col_offset):\n        assert row_offset != 0, \"winner must sit away from the center\"\n        r = int(r0 - 1 if row_offset < 0 else r1 + 1)\n        return [(r, center_c - 1), (r, center_c), (r, center_c + 1)]\n\n    assert abs(col_offset) > abs(row_offset), \"winner must have a cardinal outward direction\"\n    c = int(c0 - 1 if col_offset < 0 else c1 + 1)\n    return [(center_r - 1, c), (center_r, c), (center_r + 1, c)]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Let the largest center-pointing object grow outward while every other object loses its inward tip.\n\n    Input structure\n    - The grid has a single dominant background color and four 8-connected monochromatic foreground objects.\n    - The objects surround a central background gap and point toward it from cardinal directions.\n    - Exactly one object has the largest area.\n\n    Rule\n    - Find the central background gap by minimizing aggregate distance to the four objects.\n    - Recolor the nearest-to-center pixel of each non-largest object to background.\n    - Add a three-pixel cap in the largest object's color on the side away from the center, centered on the shared row or column.\n\n    Key insight\n    - The edit is a transfer of prominence around a common center: losers retract at their tips, and the unique largest object extends outward from the center.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    objects = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format=\"dict\")\n    assert len(objects) == 4, \"expected four colored objects around the center\"\n\n    center_r, center_c = _central_background_cell(g, bg, objects)\n\n    areas = [int(obj[\"area\"]) for obj in objects]\n    max_area = max(areas)\n    assert areas.count(max_area) == 1, \"expected a unique largest object\"\n    winner = objects[areas.index(max_area)]\n\n    out = g.copy()\n    for obj in objects:\n        if obj is winner:\n            continue\n        r, c = _inward_tip(obj, center_r, center_c)\n        out[r, c] = bg\n\n    for r, c in _outward_cap(winner, center_r, center_c):\n        assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1], \"outward cap must stay in bounds\"\n        assert int(g[r, c]) == bg, \"outward cap must be painted on background\"\n        out[r, c] = int(winner[\"color\"])\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# Canvas and palette.\nGRID_H, GRID_W = 16, 16\nGEN_BG = 8\nGEN_COLORS = [c for c in range(10) if c != GEN_BG]\n\n# Center, direction, and gap sampling.\nCENTER_MIN, CENTER_MAX = 5, 10\nDIRECTIONS = ['above', 'below', 'left', 'right']\nDIRECTION_STEPS = {'above': (-1, 0), 'below': (1, 0), 'left': (0, -1), 'right': (0, 1)}\nVERTICAL_DIRECTIONS = ('above', 'below')\nTIP_GAP_MIN, TIP_GAP_MAX = 1, 2\n\n# Object area and growth bounds.\nWINNER_AREA_MIN, WINNER_AREA_MAX = 8, 22\nLOSER_AREA_MIN = 3\nOBJECT_AREA_MIN, OBJECT_AREA_MAX = 3, 22\nMAX_GROWTH_LAYERS, MAX_HALF_WIDTH_STEP = 10, 2\n\n# Cap, spacing, and retry limits.\nCAP_OFFSETS = (-1, 0, 1)\nCAP_MARGIN, MIN_OBJECT_DISTANCE = 1, 2\nGEN_RETRY_LIMIT = 300\n\n\ndef _tip_coord(cr: int, cc: int, direction: str, tip_gap: int) -> tuple[int, int]:\n    step_r, step_c = DIRECTION_STEPS[direction]\n    return cr + step_r * tip_gap, cc + step_c * tip_gap\n\n\ndef _perp_coord(direction: str, base_r: int, base_c: int, off: int) -> tuple[int, int]:\n    if direction in VERTICAL_DIRECTIONS:\n        return base_r, base_c + off\n    return base_r + off, base_c\n\n\ndef _build_cardinal_object(cr: int, cc: int, direction: str, tip_gap: int,\n                           target_area: int, rng: random.Random) -> list[tuple[int, int]] | None:\n    tip = _tip_coord(cr, cc, direction, tip_gap)\n    step_r, step_c = DIRECTION_STEPS[direction]\n\n    coords = [tip]\n    remaining = target_area - 1\n    prev_hw = 0\n    layer = 0\n\n    while remaining > 0:\n        layer += 1\n        br = tip[0] + step_r * layer\n        bc = tip[1] + step_c * layer\n\n        min_hw = max(prev_hw, 1) if layer == 1 else max(prev_hw - 1, 0)\n        max_hw = prev_hw + MAX_HALF_WIDTH_STEP\n        feasible_hws = [hw for hw in range(min_hw, max_hw + 1) if 2 * hw + 1 <= remaining]\n        if not feasible_hws:\n            needed_hw = (remaining - 1) // 2\n            if needed_hw >= min_hw and remaining == 2 * needed_hw + 1:\n                feasible_hws = [needed_hw]\n            else:\n                break\n\n        hw = rng.choice(feasible_hws)\n        layer_pixels = [_perp_coord(direction, br, bc, off) for off in range(-hw, hw + 1)]\n        coords.extend(layer_pixels)\n        remaining -= len(layer_pixels)\n        prev_hw = hw\n\n        if layer > MAX_GROWTH_LAYERS:\n            break\n\n    if remaining > 0 and layer >= 1:\n        br = tip[0] + step_r * layer\n        bc = tip[1] + step_c * layer\n        for side in [1, -1]:\n            if remaining <= 0:\n                break\n            ext = prev_hw + 1\n            p = _perp_coord(direction, br, bc, side * ext)\n            coords.append(p)\n            remaining -= 1\n\n    return coords if len(coords) >= OBJECT_AREA_MIN else None\n\n\ndef _cap_coords(direction: str, cr: int, cc: int, obj_coords: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    rows = [r for r, c in obj_coords]\n    cols = [c for r, c in obj_coords]\n    if direction == 'above':\n        return [(min(rows) - 1, cc + d) for d in CAP_OFFSETS]\n    elif direction == 'below':\n        return [(max(rows) + 1, cc + d) for d in CAP_OFFSETS]\n    elif direction == 'left':\n        return [(cr + d, min(cols) - 1) for d in CAP_OFFSETS]\n    else:\n        return [(cr + d, max(cols) + 1) for d in CAP_OFFSETS]\n\n\ndef _min_manhattan(a: list[tuple[int, int]], b: list[tuple[int, int]]) -> int:\n    return min(abs(ra - rb) + abs(ca - cb) for ra, ca in a for rb, cb in b)\n\n\ndef _sample_parameters(rng: random.Random):\n    cr = rng.randint(CENTER_MIN, CENTER_MAX)\n    cc = rng.randint(CENTER_MIN, CENTER_MAX)\n\n    directions = list(DIRECTIONS)\n    rng.shuffle(directions)\n    winner_dir = directions[0]\n    loser_dirs = directions[1:]\n\n    colors = rng.sample(GEN_COLORS, 4)\n    winner_color, loser_colors = colors[0], colors[1:]\n\n    winner_gap = rng.randint(TIP_GAP_MIN, TIP_GAP_MAX)\n    loser_gaps = [rng.randint(TIP_GAP_MIN, TIP_GAP_MAX) for _ in range(3)]\n\n    winner_area = rng.randint(WINNER_AREA_MIN, WINNER_AREA_MAX)\n    loser_areas = [rng.randint(LOSER_AREA_MIN, winner_area - 1) for _ in range(3)]\n\n    return (\n        cr, cc, winner_dir, loser_dirs, winner_color, loser_colors,\n        winner_gap, loser_gaps, winner_area, loser_areas,\n    )\n\n\ndef _build_objects(cr: int, cc: int, winner_dir: str, loser_dirs: list[str], winner_gap: int,\n                   loser_gaps: list[int], winner_area: int, loser_areas: list[int], rng: random.Random):\n    winner_coords = _build_cardinal_object(cr, cc, winner_dir, winner_gap, winner_area, rng)\n    if winner_coords is None:\n        return None, None\n\n    loser_coords_list = []\n    for i in range(3):\n        lc = _build_cardinal_object(cr, cc, loser_dirs[i], loser_gaps[i], loser_areas[i], rng)\n        if lc is None:\n            return None, None\n        loser_coords_list.append(lc)\n    return winner_coords, loser_coords_list\n\n\ndef _areas_are_valid(winner_coords: list[tuple[int, int]], loser_coords_list: list[list[tuple[int, int]]]) -> bool:\n    actual_areas = [len(winner_coords)] + [len(lc) for lc in loser_coords_list]\n    if any(a < OBJECT_AREA_MIN or a > OBJECT_AREA_MAX for a in actual_areas):\n        return False\n    return not any(len(lc) >= len(winner_coords) for lc in loser_coords_list)\n\n\ndef _points_fit_canvas(points: list[tuple[int, int]], cap: list[tuple[int, int]]) -> bool:\n    if not all(0 <= r < GRID_H and 0 <= c < GRID_W for r, c in points):\n        return False\n    return all(CAP_MARGIN <= r < GRID_H - CAP_MARGIN and CAP_MARGIN <= c < GRID_W - CAP_MARGIN for r, c in cap)\n\n\ndef _groups_are_valid(obj_groups: list[list[tuple[int, int]]]) -> bool:\n    for i in range(len(obj_groups)):\n        if len(set(obj_groups[i])) != len(obj_groups[i]):\n            return False\n        temp = np.zeros((GRID_H, GRID_W), dtype=int)\n        rows, cols = zip(*obj_groups[i])\n","exit_code":0,"status":"completed"}}
