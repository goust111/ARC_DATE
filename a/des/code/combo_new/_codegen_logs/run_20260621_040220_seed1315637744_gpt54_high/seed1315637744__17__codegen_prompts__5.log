paste(grid, patch, r, c, transparent=bg)\n    if np.count_nonzero(grid == bg) <= np.count_nonzero(grid == fg):\n        return None\n    return grid\n\n\ndef _gen_attempt():\n    \"\"\"Single generation attempt: build tree, render input, verify against solver.\"\"\"\n    bg, fg = random.sample(range(10), 2)\n    root, outside = _make_tree()\n    if not _prepare(root):\n        return None\n    if outside is not None:\n        if not _prepare(outside):\n            return None\n        _place_outside(root, outside)\n\n    objects = _walk(root)\n    if outside is not None:\n        outside.pos = outside.rel\n        objects.append(outside)\n\n    grid = _draw(objects, bg, fg)\n    if grid is None:\n        return None\n    expected = _expected_output(root, outside, bg, fg)\n    try:\n        got = main(grid)\n    except Exception:\n        return None\n    if not np.array_equal(got, expected):\n        return None\n    return grid\n\n\n\n--- generate_input lines 693-698\ndef generate_input():\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 2d0172a1 input\")\n\nFILE /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\n--- main lines 274-543\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color