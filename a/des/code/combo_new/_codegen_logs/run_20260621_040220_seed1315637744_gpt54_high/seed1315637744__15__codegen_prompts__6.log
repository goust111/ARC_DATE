{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/57edb29d.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extract the single plain rectangle and redraw it with the aligned rectangles' border-relative marker pattern.\n\n    Input structure:\n    - The boundary color is the background/separator.\n    - Foreground objects are dense rectangular regions; exactly one rectangle has only its base color.\n    - Other rectangles contain their base color plus marker pixels.\n\n    Rule:\n    - Crop the only plain rectangle; this crop is the output canvas.\n    - Use marked rectangles whose row span overlaps the plain rectangle's row span.\n    - Transfer their marker pixels by preserving each marker run's distance from the nearest rectangle edges.\n\n    Key insight:\n    - The marked rectangles are examples of an edge-relative pattern, so the missing plain rectangle receives the same pattern resized to its own dimensions.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    bg = _boundary_bg(g)\n\n    objects = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False):\n        bbox = tuple(map(int, comp[\"bbox\"]))\n        sub = crop_bbox(g, bbox)\n        assert np.all(sub != bg), \"foreground rectangles must be dense\"\n\n        base_color = _unique_most_common(sub)\n        marker_colors = set(map(int, sub.reshape(-1))) - {int(base_color)}\n        objects.append(\n            {\n                \"bbox\": bbox,\n                \"sub\": sub,\n                \"base_color\": int(base_color),\n                \"marker_colors\": marker_colors,\n            }\n        )\n\n    plain = [obj for obj in objects if not obj[\"marker_colors\"]]\n    assert len(plain) == 1, \"expected exactly one plain rectangle\"\n    target = plain[0]\n    tr0, tc0, tr1, tc1 = target[\"bbox\"]\n    target_shape = (int(tr1 - tr0 + 1), int(tc1 - tc0 + 1))\n\n    sources = [\n        obj\n        for obj in objects\n        if obj[\"marker_colors\"] and _row_overlap(obj[\"bbox\"], target[\"bbox\"])\n    ]\n    assert sources, \"expected at least one marked rectangle aligned with the plain rectangle\"\n\n    marker_colors = set()\n    for source in sources:\n        marker_colors.update(source[\"marker_colors\"])\n    assert len(marker_colors) == 1, \"aligned marked rectangles must share one marker color\"\n    marker_color = int(next(iter(marker_colors)))\n\n    masks = []\n    for source in sources:\n        assert source[\"marker_colors\"] == {marker_color}, \"source must contain only the shared marker color\"\n        masks.append(_adapt_marker_mask(source[\"sub\"], marker_color, target_shape))\n\n    pattern = masks[0]\n    for mask in masks[1:]:\n        assert np.array_equal(mask, pattern), \"aligned marked rectangles must encode the same pattern\"\n\n    out = np.full(target_shape, int(target[\"base_color\"]), dtype=int)\n    out[pattern] = marker_color\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and separator colors.\nBG = 4\nNON_BG = [c for c in range(10) if c != BG]\nGRID_H_RANGE = (20, 28)\nGRID_W_RANGE = (20, 28)\nBORDER_GAP = 1\nBAND_GAP = 1\n# Rectangle counts and dimensions.\nRECT_COUNT_RANGE = (3, 6)\nOVERLAP_MARKED_COUNT = 2\nRECT_H_RANGE = (5, 20)\nRECT_W_RANGE = (5, 12)\nPLAIN_EXTRA_ROW_ROOM = 2\n# Marker pattern sampling.\nMARKER_PAIR_COUNT_RANGE = (1, 3)\nMARKER_EDGE_PAIRS = [(1, 1), (1, 2), (2, 1), (2, 2)]\n# Retry budget.\nGENERATION_ATTEMPTS = 300\n\n\ndef _stamp_pattern(rect: np.ndarray, marker: int, pairs: list[tuple[int, int]]):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/db118e2a.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Normalize the framed input motif into a 5x5 icon and stamp two copies on a 15x15 canvas.\n\n    Input structure\n    The input is a rounded rectangular frame: the four corners are the background\n    color, and every other outer-border pixel has one frame color. Non-background\n    pixels inside that frame are the motif to preserve.\n\n    Rule\n    Make a 5x5 version of the rounded frame with a 3x3 interior. Crop the input\n    interior motif to its bounding box, center that crop in the 3x3 interior, and\n    paste the resulting 5x5 icon at upper-left positions (2, 2) and (8, 8) in a\n    15x15 background canvas.\n\n    Key insight\n    The variable-size frame is only a carrier; the meaningful object is the\n    compact interior motif, which is normalized to the fixed 3x3 icon interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    assert h >= 3 and w >= 3\n\n    corners = (g[0, 0], g[0, w - 1], g[h - 1, 0], g[h - 1, w - 1])\n    assert len(set(map(int, corners))) == 1\n    bg = int(corners[0])\n\n    border = np.concatenate((g[0, :], g[h - 1, :], g[:, 0], g[:, w - 1]))\n    frame_colors = set(map(int, border)) - {bg}\n    assert len(frame_colors) == 1\n    (frame_color,) = tuple(frame_colors)\n\n    assert np.all(g[0, 1 : w - 1] == frame_color)\n    assert np.all(g[h - 1, 1 : w - 1] == frame_color)\n    assert np.all(g[1 : h - 1, 0] == frame_color)\n    assert np.all(g[1 : h - 1, w - 1] == frame_color)\n\n    icon = np.full((5, 5), bg, dtype=int)\n    icon[0, 1:4] = frame_color\n    icon[4, 1:4] = frame_color\n    icon[1:4, 0] = frame_color\n    icon[1:4, 4] = frame_color\n\n    interior = g[1 : h - 1, 1 : w - 1]\n    motif_box = bbox(interior != bg)\n    assert motif_box is not None\n    r0, c0, r1, c1 = motif_box\n    motif = interior[r0 : r1 + 1, c0 : c1 + 1]\n    mh, mw = motif.shape\n    assert mh <= 3 and mw <= 3\n\n    icon_r = 1 + (3 - mh) // 2\n    icon_c = 1 + (3 - mw) // 2\n    icon[icon_r : icon_r + mh, icon_c : icon_c + mw] = motif\n\n    out = np.full((15, 15), bg, dtype=int)\n    out[2:7, 2:7] = icon\n    out[8:13, 8:13] = icon\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and color constants.\n_GEN_BG = 7\n_GEN_FRAME_COLORS = [1, 2, 3, 4, 5, 6, 8, 9]\n_GEN_PALETTE = [c for c in range(10) if c != _GEN_BG]\n\n# Input/output geometry.\n_GEN_INPUT_H_RANGE = (6, 10)\n_GEN_INPUT_W_RANGE = (5, 10)\n_GEN_ICON_SIZE = 5\n_GEN_ICON_INTERIOR = 3\n_GEN_OUTPUT_SIZE = 15\n_GEN_OUTPUT_POSITIONS = ((2, 2), (8, 8))\n\n# Motif sampling.\n_GEN_MOTIF_DIM_RANGE = (1, 4)\n_GEN_NON_BG_COUNT_RANGE = (1, 8)\n_GEN_COLOR_COUNT_RANGE = (1, 3)\n_GEN_FRAME_COLOR_INJECTION_RATE = 0.35\n\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_min_pixels_for_bbox(mh, mw):\n","exit_code":0,"status":"completed"}}
