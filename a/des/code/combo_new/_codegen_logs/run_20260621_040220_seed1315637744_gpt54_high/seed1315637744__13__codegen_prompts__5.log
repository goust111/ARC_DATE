{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/a395ee82.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp translated copies of a monochrome template guided by a singleton pixel layout.\n\n    Input structure:\n    - bg = background. A large monochrome shape (template, color T).\n    - Singleton pixels elsewhere: exactly one is color T (layout origin); the rest share color O (overlap color).\n    - Singletons sit on a uniform-spacing lattice.\n\n    Rule:\n    - Convert each singleton's offset from the origin into coarse lattice units.\n    - Place a template copy at each offset, scaled by template height/width.\n    - The origin's copy is painted O instead of T.\n    - Any pixel covered by two or more copies is also recolored to O.\n\n    Key insight: The single T-colored singleton identifies both the origin position and the \"self\" copy, which is uniquely recolored.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n\n    template = max(comps, key=lambda d: int(d[\"area\"]))\n    templ_coords = template[\"coords\"]\n    templ_col = int(g[int(templ_coords[0, 0]), int(templ_coords[0, 1])])\n    r0, c0, r1, c1 = map(int, template[\"bbox\"])\n    h = int(bbox_h((r0, c0, r1, c1)))\n    w = int(bbox_w((r0, c0, r1, c1)))\n\n    templ_rel = [(int(r) - int(r0), int(c) - int(c0)) for r, c in templ_coords]\n\n    # Singleton layout points (excluding the template component).\n    singletons: list[tuple[int, int, int]] = []\n    for comp in comps:\n        if comp is template:\n            continue\n        if int(comp[\"area\"]) != 1:\n            continue\n        rr, cc = map(int, comp[\"coords\"][0])\n        singletons.append((int(rr), int(cc), int(g[int(rr), int(cc)])))\n\n    origin = [(r, c) for (r, c, col) in singletons if int(col) == int(templ_col)]\n    assert not (len(origin) != 1)\n    orr, orc = origin[0]\n\n    other_cols = [int(col) for (_r, _c, col) in singletons if int(col) != int(templ_col)]\n    assert not (not other_cols)\n    overlap_col = int(Counter(other_cols).most_common(1)[0][0])\n\n    deltas = [(int(r - orr), int(c - orc), int(col)) for (r, c, col) in singletons]\n    gcd_vals = [abs(int(x)) for dr, dc, _ in deltas for x in (dr, dc) if int(x) != 0]\n    assert gcd_vals\n    gunit = int(math.gcd(*gcd_vals))\n    gunit = max(1, int(gunit))\n    deltas = [(int(dr // gunit), int(dc // gunit), int(col)) for dr, dc, col in deltas]\n\n    total = np.zeros((H, W), dtype=int)\n    center = np.zeros((H, W), dtype=int)  # coverage count from the origin singleton\n\n    for dr, dc, col in deltas:\n        off_r = int(dr * h)\n        off_c = int(dc * w)\n        is_origin = int(col) == int(templ_col)\n        for rr, cc in templ_rel:\n            R = int(r0 + off_r + rr)\n            C = int(c0 + off_c + cc)\n            if 0 <= R < H and 0 <= C < W:\n                total[R, C] += 1\n                if is_origin:\n                    center[R, C] += 1\n\n    out = np.full((H, W), int(bg), dtype=int)\n    out[total > 0] = int(templ_col)\n    out[(total == 1) & (center > 0)] = int(overlap_col)\n    out[total >= 2] = int(overlap_col)\n    return out\n\n# --------------- generator (a1) ---------------\n\n# ── Tunable configuration ──────────────────────────────────────────\nGRID_SIZE = 22\nTEMPLATE_H_CHOICES = [3, 4]       # template bbox height options\nTEMPLATE_W = 3                    # template bbox width (fixed)\nTEMPLATE_AREA_RANGE = (6, 10)     # absolute cell-count bounds\nTEMPLATE_FILL_RANGE = (0.65, 0.85)  # fill-ratio bounds within bbox\nSINGLETON_COUNT_RANGE = (5, 6)    # number of lattice singletons\nLATTICE_EXTENT_RANGE = (3, 4)     # rows/cols of lattice polyomino\nGUNIT = 2                         # singleton spacing in pixels\n\n# Retry budgets\nSPANNING_RETRIES = 40             # attempts per spanning polyomino\nTEMPLATE_RETRIES = 60             # attempts to build a valid template\nSINGLETON_RETRIES = 50            # attempts to place singleton cluster\nGENERATE_RETRIES = 300            # outer retry loop\n\n\ndef _random_polyomino(n: int, rows: int, cols: int) -> list[tuple[int, int]] | None:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect framed squares via colored bridges following a control-pixel sequence.\n\n    Input structure:\n    - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.\n    - Control row below squares: colored pixels read left-to-right encode visitation order.\n\n    Rule:\n    - Start at the square matching first control color c0.\n    - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.\n    - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.\n\n    Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # border color = most common non-bg color\n    cnt = Counter(map(int, g.flatten()))\n    border = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            border = int(col)\n            break\n    assert not (border is None)\n\n    # detect framed squares as connected components of the border color\n    lab, n = label_mask(g == int(border), connectivity=4)\n    frames: list[dict] = []\n    for cid in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(cid))\n        if int(pts.shape[0]) < 8:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        if h < 3 or w < 3:\n            continue\n\n        t = None\n        inner_col = None\n        for tt in range(1, int(min(h, w) // 2) + 1):\n            inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]\n            if inner.size == 0:\n                continue\n            if bool((inner == int(border)).any()):\n                continue\n            u = set(map(int, inner.flatten()))\n            if len(u) != 1:\n                continue\n\n            ok = True\n            if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not ok:\n                continue\n\n            t = int(tt)\n            inner_col = int(next(iter(u)))\n            break\n\n        if t is None or inner_col is None:\n            continue\n\n        frames.append(\n            {\n                \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n                \"t\": int(t),\n                \"inner\": int(inner_col),\n                \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            }\n        )\n\n    assert not (not frames)\n\n    by: dict[int, list[dict]] = defaultdict(list)\n    for f in frames:\n        by[int(f[\"inner\"])].append(f)\n\n    max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n\n    # control row = bottom-most row below the squares with >=2 non-bg pixels\n    ctrl_r = None\n    for r in range(int(H - 1), int(max_frame_r), -1):\n        if int((g[int(r)] != int(bg)).sum()) >= 2:\n            ctrl_r = int(r)\n            break\n    assert not (ctrl_r is None)\n\n    ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n    assert not (len(ctrl) < 2)\n\n    def center(f: dict) -> tuple[int, int]:\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        return int((r0 + r1) // 2), int((c0 + c1) // 2)\n\n    def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n        a = f1[\"inner_bbox\"]\n        b = f2[\"inner_bbox\"]\n        same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n        same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))\n        return same_row, same_col\n\n    # choose start frame\n    start_color = int(ctrl[0])\n    assert not (start_color not in by)\n    start_cands = by[start_color]\n    if len(start_cands) == 1:\n        cur = start_cands[0]\n    else:\n        nxt_color = int(ctrl[1])\n        nxt_cands = by.get(nxt_color, [])\n        best = None\n        bestf = None\n        for f in start_cands:\n            for g2 in (nxt_cands if nxt_cands else [f]):\n                sr, sc = aligned(f, g2)\n                al = 1 if (sr or sc) else 0\n                (r1_, c1_) = center(f)\n                (r2_, c2_) = center(g2)\n                d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n                cand = (int(al), -int(d))\n                if best is None or cand > best:\n                    best = cand\n                    bestf = f\n        cur = bestf\n\n    out = g.copy()\n\n    def draw_bridge(fa: dict, fb: dict, color: int) -> None:\n        (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n        (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n        ia = fa[\"inner_bbox\"]\n        sr, sc = aligned(fa, fb)\n        if sr:\n            rr0, rr1 = int(ia[0]), int(ia[2])\n            if int(c1a) < int(c0b):\n                cc0, cc1 = int(c1a + 1), int(c0b - 1)\n            else:\n                cc0, cc1 = int(c1b + 1), int(c0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n            return\n        if sc:\n            cc0, cc1 = int(ia[1]), int(ia[3])\n            if int(r1a) < int(r0b):\n                rr0, rr1 = int(r1a + 1), int(r0b - 1)\n            else:\n                rr0, rr1 = int(r1b + 1), int(r0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n\n    for i in range(int(len(ctrl)) - 1):\n        a = int(ctrl[i])\n        b = int(ctrl[i + 1])\n        assert int(cur[\"inner\"]) == int(a)\n        assert b in by, f\"control color {b} has no matching frame\"\n        cands = by[b]\n        best = None\n        bestf = None\n        for f in cands:\n            sr, sc = aligned(cur, f)\n            al = 1 if (sr or sc) else 0\n            (r1_, c1_) = center(cur)\n            (r2_, c2_) = center(f)\n            d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n            cand = (int(al), -int(d))\n            if best is None or cand > best:\n                best = cand\n                bestf = f\n        nxt = bestf\n        draw_bridge(cur, nxt, int(a))\n        cur = nxt\n\n    return out\n\n\ndef _most_common_nonbg(g: np.ndarray, bg: int) -> int | None:\n","exit_code":0,"status":"completed"}}
