{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/42f83767.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Expand the lower color grid by replacing each pixel with its matching top stencil.\n\n    Input structure\n    The input has a top legend and a lower dense color grid, separated by blank rows.\n    The legend contains left-to-right 2x2 color swatches and, to their right,\n    the same number of square neutral-color stencil masks.\n\n    Rule\n    Pair the swatches and stencil masks by left-to-right order. For every pixel in\n    the lower color grid, paste the paired stencil mask as one output block,\n    recoloring the mask pixels with that pixel's color and leaving mask holes as bg.\n\n    Key insight\n    The lower grid is not copied directly; it is an index grid whose colors select\n    the stencil shape from the legend, so each input pixel becomes one square block.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    row_runs = _runs(np.any(g != bg, axis=1))\n    assert len(row_runs) == 2\n    (top_r0, top_r1), (pattern_r0, pattern_r1) = row_runs\n    assert top_r0 == 0\n\n    stencil_size = top_r1 - top_r0 + 1\n    top = g[top_r0 : top_r1 + 1, :]\n    lower = g[pattern_r0 : pattern_r1 + 1, :]\n\n    pattern_box = bbox(lower != bg)\n    assert pattern_box is not None\n    pr0, pc0, pr1, pc1 = pattern_box\n    assert pr0 == 0 and pr1 == lower.shape[0] - 1\n    pattern = lower[:, pc0 : pc1 + 1]\n    assert np.all(pattern != bg)\n    pattern_colors = set(map(int, np.unique(pattern)))\n\n    top_colors = set(map(int, np.unique(top))) - {bg}\n    neutral_colors = top_colors - pattern_colors\n    assert len(neutral_colors) == 1\n    neutral = next(iter(neutral_colors))\n\n    swatches = []\n    for comp in find_components(top, bg=bg, colors=pattern_colors):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert comp[\"area\"] == 4\n        assert r1 - r0 + 1 == 2\n        assert c1 - c0 + 1 == 2\n        swatches.append((c0, int(comp[\"color\"])))\n    assert len(swatches) == len(pattern_colors)\n    assert len({c0 for c0, _color in swatches}) == len(swatches)\n\n    swatch_colors = [color for _c0, color in sorted(swatches)]\n    assert set(swatch_colors) == pattern_colors\n\n    stencil_col_runs = _runs(np.any(top == neutral, axis=0))\n    assert len(stencil_col_runs) == len(swatch_colors)\n\n    stencils = {}\n    for color, (c0, c1) in zip(swatch_colors, stencil_col_runs):\n        assert c1 - c0 + 1 == stencil_size\n        mask = top[:, c0 : c1 + 1] == neutral\n        assert mask.shape == (stencil_size, stencil_size)\n        assert np.any(mask)\n        stencils[color] = mask\n\n    h, w = pattern.shape\n    out = np.full((h * stencil_size, w * stencil_size), bg, dtype=int)\n    for r in range(h):\n        for c in range(w):\n            color = int(pattern[r, c])\n            assert color in stencils\n            block = out[\n                r * stencil_size : (r + 1) * stencil_size,\n                c * stencil_size : (c + 1) * stencil_size,\n            ]\n            block[stencils[color]] = color\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and legend geometry.\nBACKGROUND, NEUTRAL_COLOR, INPUT_ROWS = 0, 5, 15\nSWATCH_SIZE, SWATCH_STRIDE, STENCIL_GAP = 2, 3, 1\n\n# Structural size and palette bounds.\nCOLOR_COUNT_RANGE = (2, 4)\nSTENCIL_SIZE_RANGE, PATTERN_SIDE_RANGE = range(3, 7), range(4, 8)\nMAX_OUTPUT_SIDE, AVAILABLE_COLORS = 30, [1, 2, 3, 4, 6, 7, 8, 9]\nVALID_SIZE_PAIRS = [(s, p) for s in STENCIL_SIZE_RANGE for p in PATTERN_SIDE_RANGE if s * p <= MAX_OUTPUT_SIDE]\n\n# Stencil, pattern, and retry sampling.\nSTENCIL_FILL_RANGE = (0.60, 0.89)\nUNIQUE_STENCIL_RETRIES, GENERATION_RETRIES = 80, 300\nGAP_ROWS_RANGE = (1, 3)\nPATTERN_MODES = [\"iid\", \"rows\", \"cols\", \"checker\", \"tile\"]\nTILE_SIDE_RANGE = (2, 3)\n\n\ndef _grow_stencil(size):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/753ea09b.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the small background compartments bounded by the long contour color.\n\n    Input structure:\n    - The grid has one dominant background color and two foreground colors.\n    - The more frequent foreground color forms long 8-connected contour fragments.\n    - The other foreground color is a fixed distractor/obstacle color that partitions\n      the background but is never recolored.\n\n    Rule:\n    - Split the background into 4-connected regions using all foreground pixels as\n      barriers.\n    - Keep the two largest background regions as the outside of the contour drawing.\n    - Recolor every other background region that touches a long contour component\n      to the contour color; leave all foreground pixels unchanged.\n\n    Key insight:\n    The apparent area fill is exactly a component-level fill of bounded background\n    compartments, not a row-wise interpolation between individual contour pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    foreground = colors_present(g, exclude={bg})\n    assert len(foreground) == 2, \"expected exactly two foreground colors\"\n\n    fill_color = _unique_largest_color(g, foreground)\n    fill_lab, _n_fill = label_mask(g == fill_color, connectivity=8)\n    long_ids = _long_component_ids(fill_lab, _n_fill)\n\n    bg_lab, n_bg = label_mask(g == bg, connectivity=4)\n    exterior_ids = _two_exterior_bg_ids(bg_lab, n_bg)\n\n    out = g.copy()\n    for comp_id in range(1, n_bg + 1):\n        if comp_id in exterior_ids:\n            continue\n        coords = np.argwhere(bg_lab == comp_id)\n        if _touches_long_contour(coords, fill_lab, long_ids):\n            out[bg_lab == comp_id] = fill_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\nH, W = 30, 30\nGRID_SHAPE = (H, W)\nARC_COLOR_COUNT = 10\n\n# Long contour path layout.\nPATH_COUNT_OPTIONS = (2, 3)\nPATH_STEP_OPTIONS = (-1, 0, 1)\nPATH_GAP_MIN, PATH_GAP_MAX = 2, 5\nPATH_LEFT_MIN_COL, PATH_RIGHT_MARGIN = 2, 3\nPATH_START_MIN_COL = 3\nPATH_START_RIGHT_MARGIN = 4\nPATH_FAR_END_MIN_CHOICES, PATH_FAR_END_PROB, PATH_FAR_END_DELTA = 8, 0.7, 5\nPATH_SCORING_CANDIDATES = 5\nPATH_MIN_MOVES = 12\n\n# Contour distractors and extra contour pixels.\nOUTSIDE_MARGIN = 2\nOUTSIDE_SIDE_OPTIONS = (-1, 1)\nSHORT_FRAGMENT_COUNT_MIN, SHORT_FRAGMENT_COUNT_MAX = 3, 5\nSHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX = 1, 4\nSHORT_FRAGMENT_ATTEMPTS = 200\nSHORT_FRAGMENT_PATH_PADDING = 3\nCONTOUR_PIXELS_MIN, CONTOUR_PIXELS_MAX = 81, 108\n\n# Obstacle bars and scattered clusters.\nBAR_SEGMENT_MAX = 11\nSINGLE_CHANNEL_BARS_MIN, SINGLE_CHANNEL_BARS_MAX = 5, 11\nMULTI_CHANNEL_TOTAL_BARS_MIN, MULTI_CHANNEL_TOTAL_BARS_MAX = 4, 10\nMULTI_CHANNEL_INITIAL_BARS = 2\nMULTI_CHANNEL_MAX_BARS = 5\nBAR_WIDTH_MIN, BAR_WIDTH_MAX = 1, 5\nOBSTACLE_PIXELS_MIN, OBSTACLE_PIXELS_MAX = 36, 63\nOBSTACLE_EXTRA_PIXELS_MIN = 8\nOBSTACLE_OUTSIDE_QUOTA_MIN, OBSTACLE_OUTSIDE_QUOTA_MAX = 8, 16\nOBSTACLE_CLUSTER_SIZE_MIN, OBSTACLE_CLUSTER_SIZE_MAX = 1, 5\nOBSTACLE_ATTEMPTS = 300\nOBSTACLE_ZONE_OPTIONS = (\"outside\", \"inside\", \"any\")\n\n# Component validation.\nBG_REGIONS_MIN, BG_REGIONS_MAX = 8, 14\nEXTERIOR_REGION_COUNT = 2\nINTERIOR_REGIONS_MIN, INTERIOR_REGIONS_MAX = 6, 12\nINTERIOR_REGION_AREA_MAX = 57\nLONG_COMPONENT_MIN_SPAN = H // 3\nLONG_COMPONENT_COUNT_OPTIONS = (2, 3)\n\n# Retry limits and local neighborhoods.\nGENERATION_ATTEMPTS = 300\nNEIGHBOR_DELTAS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nNEIGHBOR_DELTAS_8 = NEIGHBOR_DELTAS_4 + ((-1, -1), (-1, 1), (1, -1), (1, 1))\n\n\ndef _color_choices() -> tuple[int, int, int]:\n","exit_code":0,"status":"completed"}}
