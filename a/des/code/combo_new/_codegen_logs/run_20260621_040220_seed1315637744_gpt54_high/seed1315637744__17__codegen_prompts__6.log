{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport random\nimport numpy as np\nfrom scipy.ndimage import label as scipy_label\nfrom arc_utils import bbox_h, bbox_w, find_components, in_bounds, neighbors4, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n\n\ndef _bfs_placement(feasible, sr, sc):\n    h2, w2 = feasible.shape\n    dist = -np.ones((h2, w2), dtype=int)\n    dist[sr, sc] = 0\n    q = deque([(sr, sc)])\n    while q:\n        r, c = q.popleft()\n        for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:\n                dist[rr, cc] = dist[r, c] + 1\n                q.append((rr, cc))\n    return dist\n\n\ndef _hamiltonian_walk(rows, cols, start, end):\n    total = rows * cols\n    best_path = None\n    best_len = 0\n    for _attempt in range(80):\n        visited = {start}\n        path = [start]\n        cur = start\n        while True:\n            if cur == end and len(path) >= total * 0.7:\n                if len(path) > best_len:\n                    best_path = list(path)\n                    best_len = len(path)\n                break\n            neighbors = []\n            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                nr, nc = cur[0] + dr, cur[1] + dc\n                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:\n                    neighbors.append((nr, nc))\n            if not neighbors:\n                break\n            valid = []\n            for nb in neighbors:\n                if nb == end:\n                    valid.append(nb)\n                    continue\n                test_visited = visited | {nb}\n                seen = {end}\n                q = deque([end])\n                while q:\n                    cr, cc = q.popleft()\n                    for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                        nr2, nc2 = cr + dr2, cc + dc2\n                        if (0 <= nr2 < rows and 0 <= nc2 < cols and\n                                (nr2, nc2) not in test_visited and (nr2, nc2) not in seen):\n                            seen.add((nr2, nc2))\n                            q.append((nr2, nc2))\n                for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                    ar, ac = nb[0] + dr2, nb[1] + dc2\n                    if (0 <= ar < rows and 0 <= ac < cols and\n                            (ar, ac) not in test_visited and (ar, ac) in seen):\n                        valid.append(nb)\n                        break\n            if not valid:\n                break\n            random.shuffle(valid)\n            nxt = valid[0]\n            visited.add(nxt)\n            path.append(nxt)\n            cur = nxt\n        if best_path and best_len >= total * 0.85:\n            break\n    return best_path\n\n\ndef _render_channel(grid, path, n, offsets_r, offsets_c):\n    pixel_pos = []\n    for cr, cc in path:\n        pr, pc = offsets_r[cr], offsets_c[cc]\n        pixel_pos.append((pr, pc))\n        grid[pr:pr + n, pc:pc + n] = _RIVER\n    for i in range(len(path) - 1):\n        pr1, pc1 = pixel_pos[i]\n        pr2, pc2 = pixel_pos[i + 1]\n        if pr1 == pr2:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n            grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER\n        else:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n            grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER\n    return pixel_pos\n\n\ndef _add_chokepoint(grid, pixel_pos_i, pixel_pos_j, n, direction):\n    H, W = grid.shape\n    pr1, pc1 = pixel_pos_i\n    pr2, pc2 = pixel_pos_j\n    narrow_w = random.randint(1, n - 1)\n    remove = n - narrow_w\n    side = random.randint(0, 1)\n\n    if direction == 'h':\n        c_lo = min(pc1, pc2) + n\n        c_hi = max(pc1, pc2)\n        if c_hi <= c_lo:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        c_mid = (c_lo + c_hi) // 2\n        c_start = max(c_lo, c_mid - total_len // 2)\n        for step in range(total_len):\n            c = c_start + step\n            if c < 0 or c >= W:\n                continue\n            if step < remove:\n                depth = step + 1\n            elif step >= total_len - remove:\n                depth = total_len - step\n            else:\n                depth = remove\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/fc4aaf52.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/fc4aaf52.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg\nimport random\n\n\ndef _swapped_values(values: np.ndarray, color_a: int, color_b: int) -> np.ndarray:\n    out = values.copy()\n    out[values == int(color_a)] = int(color_b)\n    out[values == int(color_b)] = int(color_a)\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Split the two-color object horizontally, swap its colors, and slide the upper half to the right.\n\n    Input structure:\n    - The grid has one background color and exactly two foreground colors.\n    - All foreground pixels form one 4-connected object with an even-height bbox.\n    - The object has foreground pixels on both rows adjacent to its horizontal midpoint.\n\n    Rule:\n    - Split the object into upper and lower halves at the midpoint of its bbox.\n    - Swap the two foreground colors in both halves.\n    - Keep the lower half in place and shift the upper half right until its lower-left\n      boundary pixel is diagonally adjacent to the lower half's upper-right boundary pixel.\n\n    Key insight:\n    - The object is not copied or reflected; it is broken at the horizontal waist,\n      recolored by exchanging the two visible object colors, then rejoined diagonally.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected exactly two foreground colors\"\n    color_a, color_b = colors\n\n    objects = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert len(objects) == 1, \"expected one connected foreground object\"\n    r0, _c0, r1, _c1 = objects[0][\"bbox\"]\n    height = int(r1 - r0 + 1)\n    assert height % 2 == 0, \"object bbox height must split evenly\"\n\n    split_row = int(r0 + height // 2)\n    row_ids = np.arange(g.shape[0])[:, None]\n    fg = g != int(bg)\n    upper = fg & (row_ids < split_row)\n    lower = fg & (row_ids >= split_row)\n    assert np.any(upper), \"expected a nonempty upper half\"\n    assert np.any(lower), \"expected a nonempty lower half\"\n    assert int(upper.sum()) == int(lower.sum()), \"expected equal upper and lower areas\"\n\n    upper_boundary_cols = np.flatnonzero(upper[split_row - 1])\n    lower_boundary_cols = np.flatnonzero(lower[split_row])\n    assert upper_boundary_cols.size > 0, \"upper half must touch the split boundary\"\n    assert lower_boundary_cols.size > 0, \"lower half must touch the split boundary\"\n\n    shift = int(lower_boundary_cols.max() + 1 - upper_boundary_cols.min())\n    assert shift > 0, \"upper half must shift right\"\n\n    upper_rows, upper_cols = np.where(upper)\n    lower_rows, lower_cols = np.where(lower)\n    shifted_upper_cols = upper_cols + shift\n    assert int(shifted_upper_cols.max()) < g.shape[1], \"shifted upper half must fit in the grid\"\n\n    out = np.full_like(g, int(bg))\n    out[lower_rows, lower_cols] = _swapped_values(g[lower_rows, lower_cols], color_a, color_b)\n    out[upper_rows, shifted_upper_cols] = _swapped_values(g[upper_rows, upper_cols], color_a, color_b)\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import paste as _gen_paste\n# Canvas and palette.\nGEN_BG, GEN_GRID_SIZE = 8, 16\nGEN_COLOR_POOL = [c for c in range(10) if c != GEN_BG]\n\n# Symmetric object shape.\nGEN_HALF_HEIGHTS, GEN_MAX_WIDTHS = [3, 4], [5, 7]\nGEN_MIN_ROW_WIDTH, GEN_WIDTH_STEP = 1, 2\nGEN_ROW_SWAP_PROB, GEN_ROW_SWAP_HEIGHT = 0.25, 4\nGEN_ROW_SWAP_INDICES = (1, 2)\n\n# Placement and validation.\nGEN_MARGIN, GEN_RETRIES = 1, 300\n\n\ndef _gen_fc4aaf52_swap(arr: np.ndarray, color_a: int, color_b: int) -> np.ndarray:\n    out = arr.copy()\n    out[arr == color_a] = color_b\n    out[arr == color_b] = color_a\n    return out\n\n\ndef _gen_fc4aaf52_upper(half_h: int, border_color: int, fill_color: int) -> np.ndarray:\n    max_w = random.choice(GEN_MAX_WIDTHS)\n    widths = [max_w]\n    for _ in range(half_h - 1):\n        prev_w = widths[-1]\n        widths.append(random.choice([max(GEN_MIN_ROW_WIDTH, prev_w - GEN_WIDTH_STEP), prev_w]))\n    widths = list(reversed(widths))\n    if random.random() < GEN_ROW_SWAP_PROB and half_h == GEN_ROW_SWAP_HEIGHT:\n        i, j = GEN_ROW_SWAP_INDICES\n        widths[i], widths[j] = widths[j], widths[i]\n\n    bottom_lefts = [0]\n    bottom_widths = list(reversed(widths))\n    for i, width in enumerate(bottom_widths[1:], start=1):\n        prev_l = bottom_lefts[-1]\n        prev_r = prev_l + bottom_widths[i - 1] - 1\n        choices = [left for left in range(max_w - width + 1) if max(left, prev_l) <= min(left + width - 1, prev_r)]\n        bottom_lefts.append(random.choice(choices))\n    lefts = list(reversed(bottom_lefts))\n\n    upper = np.full((half_h, max_w), GEN_BG, dtype=int)\n    for r, (left, width) in enumerate(zip(lefts, widths)):\n        right = left + width\n        upper[r, left:right] = fill_color\n        upper[r, left] = border_color\n        upper[r, right - 1] = border_color\n    return upper\n\n\ndef _gen_fc4aaf52_placement(obj_h: int, obj_w: int, shift: int) -> tuple[int, int] | None:\n    max_row = GEN_GRID_SIZE - GEN_MARGIN - obj_h\n    max_col = GEN_GRID_SIZE - GEN_MARGIN - obj_w - shift\n    return None if max_col < 0 else (random.randint(GEN_MARGIN, max_row), random.randint(GEN_MARGIN, max_col))\n\n\ndef _gen_fc4aaf52_render(upper, lower, row, col, shift, border_color, fill_color, *, swapped):\n    out = np.full((GEN_GRID_SIZE, GEN_GRID_SIZE), GEN_BG, dtype=int)\n    upper_col = col\n    if swapped:\n        upper = _gen_fc4aaf52_swap(upper, border_color, fill_color)\n        lower = _gen_fc4aaf52_swap(lower, border_color, fill_color)\n        upper_col += shift\n    _gen_paste(out, upper, row, upper_col, transparent=GEN_BG)\n    _gen_paste(out, lower, row + upper.shape[0], col, transparent=GEN_BG)\n    return out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    border_color, fill_color = random.sample(GEN_COLOR_POOL, 2)\n    half_h = random.choice(GEN_HALF_HEIGHTS)\n    upper_in = _gen_fc4aaf52_upper(half_h, border_color, fill_color)\n    lower_in = np.flipud(upper_in)\n\n    obj_h, obj_w = half_h * 2, upper_in.shape[1]\n    shift = int(np.count_nonzero(upper_in[-1] != GEN_BG))\n    placement = _gen_fc4aaf52_placement(obj_h, obj_w, shift)\n    if placement is None:\n        return None\n    obj_row, obj_col = placement\n\n    expected = _gen_fc4aaf52_render(upper_in, lower_in, obj_row, obj_col, shift, border_color, fill_color, swapped=True)\n    inp = _gen_fc4aaf52_render(upper_in, lower_in, obj_row, obj_col, shift, border_color, fill_color, swapped=False)\n\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid fc4aaf52 input\")\n","exit_code":0,"status":"completed"}}
