{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/46c35fc7.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg, paste\nimport random\n\n\ndef _rotate_ring(out: np.ndarray, g: np.ndarray, r0: int, c0: int) -> None:\n    patch = g[r0 : r0 + 3, c0 : c0 + 3]\n\n    out[r0 + 0, c0 + 0] = patch[0, 2]\n    out[r0 + 0, c0 + 1] = patch[1, 0]\n    out[r0 + 0, c0 + 2] = patch[2, 2]\n    out[r0 + 1, c0 + 0] = patch[2, 1]\n    out[r0 + 1, c0 + 2] = patch[0, 1]\n    out[r0 + 2, c0 + 0] = patch[0, 0]\n    out[r0 + 2, c0 + 1] = patch[1, 2]\n    out[r0 + 2, c0 + 2] = patch[2, 0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate the colors around every 3x3 foreground ring, with corners and side-centers cycling in opposite directions.\n\n    Input structure\n    - The grid has a dominant background color.\n    - Each 4-connected foreground object is a complete 3x3 ring: eight foreground pixels around a background center.\n\n    Rule\n    - For each ring, move corner colors one step around the four corners.\n    - Move side-center colors one step around the four side centers in the opposite direction.\n    - Leave the background center and all other background pixels unchanged.\n\n    Key insight\n    - Corners and side centers form two separate four-cycles on the same 3x3 ring.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    out = g.copy()\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert components\n\n    for comp in components:\n        bbox = comp[\"bbox\"]\n        r0, c0, r1, c1 = map(int, bbox)\n        assert bbox_h(bbox) == 3\n        assert bbox_w(bbox) == 3\n        assert int(comp[\"area\"]) == 8\n        assert g[r0 + 1, c0 + 1] == bg\n\n        ring_coords = {\n            (r0 + dr, c0 + dc)\n            for dr in range(3)\n            for dc in range(3)\n            if (dr, dc) != (1, 1)\n        }\n        component_coords = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n        assert component_coords == ring_coords\n        assert r1 == r0 + 2\n        assert c1 == c0 + 2\n\n        _rotate_ring(out, g, r0, c0)\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color and canvas bounds.\nBG_COLOR = 7\nCOLOR_IDS = tuple(range(10))\nGRID_SIDE_MIN, GRID_SIDE_MAX = 6, 10\nMIN_BACKGROUND_PCT = 67\n\n# Ring geometry, counts, and placement spacing.\nRING_SIZE, RING_AREA, RING_GAP = 3, 8, 1\nRING_COUNT_MIN, RING_COUNT_MAX = 1, 2\nRING_UNIQUE_MIN, RING_UNIQUE_MAX = 2, RING_AREA\nRING_CELLS = (\n    (0, 0),\n    (0, 1),\n    (0, 2),\n    (1, 0),\n    (1, 2),\n    (2, 0),\n    (2, 1),\n    (2, 2),\n)\n\n# Retry budget for rejection through the solver oracle.\nGENERATION_RETRIES = 300\n\n\ndef _bbox_at(r: int, c: int) -> tuple[int, int, int, int]:\n    return r, c, r + RING_SIZE - 1, c + RING_SIZE - 1\n\n\ndef _separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n    return (\n        a[2] + RING_GAP < b[0]\n        or b[2] + RING_GAP < a[0]\n        or a[3] + RING_GAP < b[1]\n        or b[3] + RING_GAP < a[1]\n    )\n\n\ndef _valid_position_sets(rows: int, cols: int, count: int) -> list[tuple[tuple[int, int], ...]]:\n    positions = [(r, c) for r in range(rows - RING_SIZE + 1) for c in range(cols - RING_SIZE + 1)]\n    if count == 1:\n        return [(pos,) for pos in positions]\n\n    pairs = []\n    for i, first in enumerate(positions):\n        box1 = _bbox_at(*first)\n        for second in positions[i + 1 :]:\n            if _separated(box1, _bbox_at(*second)):\n                pairs.append((first, second))\n    return pairs\n\n\ndef _compatible_sizes(count: int) -> list[tuple[int, int]]:\n    sizes = []\n    for rows in range(GRID_SIDE_MIN, GRID_SIDE_MAX + 1):\n        for cols in range(GRID_SIDE_MIN, GRID_SIDE_MAX + 1):\n            area = rows * cols\n            if (area - RING_AREA * count) * 100 < MIN_BACKGROUND_PCT * area:\n                continue\n            if _valid_position_sets(rows, cols, count):\n                sizes.append((rows, cols))\n    return sizes\n\n\n_SIZES = {count: _compatible_sizes(count) for count in range(RING_COUNT_MIN, RING_COUNT_MAX + 1)}\n_POSITION_SETS = {\n    count: {size: _valid_position_sets(*size, count) for size in _SIZES[count]}\n    for count in _SIZES\n}\n\n\ndef _make_ring(bg: int) -> np.ndarray:\n    ring = np.full((RING_SIZE, RING_SIZE), bg, dtype=int)\n    palette = [color for color in COLOR_IDS if color != bg]\n    unique_count = random.randint(RING_UNIQUE_MIN, RING_UNIQUE_MAX)\n    chosen = random.sample(palette, unique_count)\n    values = chosen + [random.choice(chosen) for _ in range(RING_AREA - unique_count)]\n    random.shuffle(values)\n    for (dr, dc), color in zip(RING_CELLS, values):\n        ring[dr, dc] = color\n    return ring\n\n\ndef _rotated_output(grid: np.ndarray, positions: tuple[tuple[int, int], ...]) -> np.ndarray:\n    out = grid.copy()\n    for r0, c0 in positions:\n        _rotate_ring(out, grid, r0, c0)\n    return out\n\n\ndef _render_grid(rows: int, cols: int, positions: tuple[tuple[int, int], ...], bg: int) -> np.ndarray:\n    grid = np.full((rows, cols), bg, dtype=int)\n    for r0, c0 in positions:\n        paste(grid, _make_ring(bg), r0, c0)\n    return grid\n\n\ndef _oracle_accepts(grid: np.ndarray, positions: tuple[tuple[int, int], ...]) -> bool:\n    expected = _rotated_output(grid, positions)\n    try:\n        actual = main(grid)\n    except AssertionError:\n        return False\n    return np.array_equal(actual, expected)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = BG_COLOR\n    count = random.randint(RING_COUNT_MIN, RING_COUNT_MAX)\n    rows, cols = random.choice(_SIZES[count])\n    positions = random.choice(_POSITION_SETS[count][(rows, cols)])\n    grid = _render_grid(rows, cols, positions, bg)\n    return grid if _oracle_accepts(grid, positions) else None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 46c35fc7 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg as _bg_color, neighbors8\nimport random\nfrom arc_utils import random_free_location, is_contiguous\n\n\ndef _rotate_cells(cells: list[tuple[int, int, int]], k: int) -> list[tuple[int, int, int]]:\n    pts = [(r, c, col) for r, c, col in cells]\n    for _ in range(k % 4):\n        pts = [(c, -r, col) for r, c, col in pts]  # 90° clockwise around origin\n    min_r = min(r for r, _, _ in pts)\n    min_c = min(c for _, c, _ in pts)\n    pts = [(r - min_r, c - min_c, col) for r, c, col in pts]\n    pts.sort()\n    return pts\n\n\ndef _variants(cells: list[tuple[int, int, int]]) -> list[list[tuple[int, int, int]]]:\n    seen: set[tuple[tuple[int, int, int], ...]] = set()\n    outs: list[list[tuple[int, int, int]]] = []\n    for k in range(4):\n        rot = _rotate_cells(cells, k)\n        key = tuple(rot)\n        if key not in seen:\n            seen.add(key)\n            outs.append(rot)\n    return outs\n\n\ndef _find_marker_color(g: np.ndarray, bg: int) -> int | None:\n    colors = [c for c in sorted(set(map(int, g.ravel()))) if c != bg]\n    counts = {c: int(np.sum(g == c)) for c in colors}\n    singletons = [c for c in colors if counts[c] == 1]\n    if singletons:\n        # Prefer a singleton that is 8-neigh adjacent to some other non-bg pixel.\n        for c in singletons:\n            r, col = map(int, np.argwhere(g == c)[0])\n            for nr, nc in neighbors8(r, col):\n                if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] != bg:\n                    return c\n        assert False, \"no adjacent singleton found — input must have adjacent singleton marker\"\n\n\ndef _extract_pieces(g: np.ndarray) -> tuple[list[dict], int]:\n    bg = _bg_color(g)\n    colors = [c for c in sorted(set(map(int, g.ravel()))) if c != bg]\n    if not colors:\n        return [], bg\n\n    marker_color = _find_marker_color(g, bg)\n    marker_pos = None\n    if marker_color is not None and int(np.sum(g == marker_color)) == 1:\n        marker_pos = tuple(map(int, np.argwhere(g == marker_color)[0]))\n\n    # Anchor color is the color 8-neigh adjacent to the marker.\n    anchor_color = None\n    if marker_pos is not None:\n        mr, mc = marker_pos\n        neigh = set()\n        for nr, nc in neighbors8(mr, mc):\n            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1]:\n                v = int(g[nr, nc])\n                if v != bg and v != marker_color:\n                    neigh.add(v)\n        if len(neigh) == 1:\n            anchor_color = next(iter(neigh))\n\n    pieces: list[dict] = []\n    used = set()\n\n    if anchor_color is not None and marker_pos is not None:\n        # Anchor is a multi-color piece: anchor_color pixels plus the marker pixel.\n        coords = []\n        for r, c in np.argwhere(g == anchor_color):\n            coords.append((int(r), int(c), int(anchor_color)))\n        mr, mc = marker_pos\n        coords.append((mr, mc, int(marker_color)))\n        # Normalize to local coordinates.\n        min_r = min(r for r, _, _ in coords)\n        min_c = min(c for _, c, _ in coords)\n        coords = [(r - min_r, c - min_c, col) for r, c, col in coords]\n        pieces.append(\n            {\n                \"name\": \"anchor\",\n                \"cells\": coords,\n                \"marker_color\": int(marker_color),\n            }\n        )\n        used.add(anchor_color)\n        used.add(marker_color)\n\n    for col in colors:\n        if col in used:\n            continue\n        coords = [(int(r), int(c), int(col)) for r, c in np.argwhere(g == col)]\n        min_r = min(r for r, _, _ in coords)\n        min_c = min(c for _, c, _ in coords)\n        coords = [(r - min_r, c - min_c, col) for r, c, col in coords]\n        pieces.append({\"name\": f\"c{col}\", \"cells\": coords})\n\n    return pieces, bg\n\n\ndef _dims(area: int) -> list[tuple[int, int]]:\n    pairs = []\n    for h in range(1, int(area**0.5) + 1):\n        if area % h == 0:\n            w = area // h\n            pairs.append((h, w))\n            if h != w:\n                pairs.append((w, h))\n    # Prefer close-to-square, then smaller height.\n    pairs.sort(key=lambda t: (abs(t[0] - t[1]), t[0], t[1]))\n    return pairs\n\n\ndef _placeable(board: np.ndarray, placement: list[tuple[int, int, int]]) -> bool:\n    for r, c, _ in placement:\n        if board[r, c] != -1:\n            return False\n    return True\n\n\ndef _apply(board: np.ndarray, placement: list[tuple[int, int, int]], val: int | None = None) -> None:\n    if val is None:\n        for r, c, col in placement:\n            board[r, c] = col\n    else:\n        for r, c, _ in placement:\n            board[r, c] = val\n\n\ndef _all_placements_for_variant(\n    variant: list[tuple[int, int, int]], H: int, W: int\n) -> list[list[tuple[int, int, int]]]:\n    max_r = max(r for r, _, _ in variant)\n    max_c = max(c for _, c, _ in variant)\n    ph, pw = max_r + 1, max_c + 1\n    outs: list[list[tuple[int, int, int]]] = []\n    for tr in range(H - ph + 1):\n        for tc in range(W - pw + 1):\n            outs.append([(r + tr, c + tc, col) for r, c, col in variant])\n    return outs\n\n\ndef _solve_packing(pieces: list[dict], H: int, W: int) -> np.ndarray | None:\n    board = np.full((H, W), -1, dtype=int)\n\n    # Build variants + placements per piece.\n    piece_vars: list[list[list[tuple[int, int, int]]]] = []\n    for p in pieces:\n        piece_vars.append(_variants(p[\"cells\"]))\n\n    # Place anchor first if present: marker must end up at (0,0).\n    remaining = list(range(len(pieces)))\n    anchor_idx = next((i for i, p in enumerate(pieces) if p[\"name\"] == \"anchor\"), None)\n    if anchor_idx is not None:\n        remaining.remove(anchor_idx)\n        marker_col = pieces[anchor_idx][\"marker_color\"]\n        anchor_solutions = []\n        for var in piece_vars[anchor_idx]:\n            marker_pts = [(r, c) for r, c, col in var if col == marker_col]\n            if len(marker_pts) != 1:\n                continue\n            mr, mc = marker_pts[0]\n            tr, tc = -mr, -mc\n            placed = [(r + tr, c + tc, col) for r, c, col in var]\n            if all(0 <= r < H and 0 <= c < W for r, c, _ in placed):\n                anchor_solutions.append(placed)\n        if not anchor_solutions:\n            return None\n        # Try each feasible anchor orientation (usually 1).\n        for anchor_place in anchor_solutions:\n            if not _placeable(board, anchor_place):\n                continue\n            _apply(board, anchor_place)\n\n            # Backtracking for remaining pieces.\n            def backtrack(rem: list[int]) -> bool:\n                if not rem:\n                    return True\n\n                # Choose piece with fewest fits under current board.\n                best_pi = None\n                best_options = None\n                best_count = None\n                for pi in rem:\n                    opts = []\n                    for var in piece_vars[pi]:\n                        for placement in _all_placements_for_variant(var, H, W):\n                            if _placeable(board, placement):\n                                opts.append(placement)\n                    cnt = len(opts)\n                    if cnt == 0:\n                        return False\n                    if best_count is None or cnt < best_count:\n                        best_count = cnt\n                        best_pi = pi\n                        best_options = opts\n                        if best_count == 1:\n                            break\n\n                assert best_pi is not None and best_options is not None\n                next_rem = [x for x in rem if x != best_pi]\n                for placement in best_options:\n                    _apply(board, placement)\n                    if backtrack(next_rem):\n                        return True\n                    _apply(board, placement, -1)\n                return False\n\n            if backtrack(remaining):\n                return board\n            _apply(board, anchor_place, -1)\n        return None\n\n    # No anchor: just pack all pieces.\n    def backtrack(rem: list[int]) -> bool:\n        if not rem:\n            return True\n        best_pi = None\n        best_options = None\n        best_count = None\n        for pi in rem:\n            opts = []\n            for var in piece_vars[pi]:\n                for placement in _all_placements_for_variant(var, H, W):\n                    if _placeable(board, placement):\n                        opts.append(placement)\n            cnt = len(opts)\n            if cnt == 0:\n                return False\n            if best_count is None or cnt < best_count:\n                best_count = cnt\n                best_pi = pi\n                best_options = opts\n        assert best_pi is not None and best_options is not None\n        next_rem = [x for x in rem if x != best_pi]\n        for placement in best_options:\n            _apply(board, placement)\n            if backtrack(next_rem):\n                return True\n            _apply(board, placement, -1)\n        return False\n\n    if backtrack(remaining):\n        return board\n    return None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble colored rectangular sprites into a single tiled rectangle, anchored by a marker pixel.\n\n    Input structure:\n    - bg = most common color. Several solid-colored rectangular sprites scattered on the grid.\n    - One sprite has a unique single-pixel marker (different color) at one corner — this is the anchor.\n\n    Rule:\n","exit_code":0,"status":"completed"}}
