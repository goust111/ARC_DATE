{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' /home/lixinyu/snap/new/ARC_code/train/bd283c4a.py\nsed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Pack all pixels into color-frequency runs along bottom-up columns.\n\n    Input structure\n    The input is a rectangular grid whose colors are all foreground material;\n    only the number of pixels of each color matters. In the observed task\n    instances, every present color has a distinct pixel count.\n\n    Rule\n    Count the pixels of each color and order the colors from most frequent to\n    least frequent. Rewrite a same-size grid by placing each color's full count\n    as one contiguous run while scanning columns from left to right and, within\n    each column, from bottom to top.\n\n    Key insight\n    The output preserves the multiset of colors but discards all original\n    positions, turning the grid into a frequency-sorted column packing.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    counts = Counter(map(int, g.ravel()))\n    assert len(set(counts.values())) == len(counts), \"color counts must have a unique rank\"\n\n    colors = sorted(counts, key=lambda color: -counts[color])\n    out = np.empty_like(g)\n    height, width = g.shape\n\n    scan = ((r, c) for c in range(width) for r in range(height - 1, -1, -1))\n    for color in colors:\n        for _ in range(counts[color]):\n            r, c = next(scan)\n            out[r, c] = color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGRID_SHAPE = (10, 10)\nGRID_AREA = GRID_SHAPE[0] * GRID_SHAPE[1]\n\n# Palette: four distinct foreground colors, no background.\nCOLOR_POOL = np.arange(1, 10)\nN_COLORS = 4\n\n# Counts: largest, second, third are sampled; smallest is residual.\nCOUNT_RANGES = ((40, 55), (25, 35), (10, 20))\nRESIDUAL_COUNT_RANGE = (2, 10)\nCOUNT_SAMPLE_RETRIES = 100\nGENERATION_RETRIES = 300\n\n\ndef _sample_ranked_counts(rng: np.random.Generator) -> list[int] | None:\n    \"\"\"Return four distinct counts in descending rank ranges, summing to the grid area.\"\"\"\n    for _ in range(COUNT_SAMPLE_RETRIES):\n        sampled = [int(rng.integers(lo, hi + 1)) for lo, hi in COUNT_RANGES]\n        residual = GRID_AREA - sum(sampled)\n        lo, hi = RESIDUAL_COUNT_RANGE\n        counts = sampled + [residual]\n        if lo <= residual <= hi and len(set(counts)) == N_COLORS:\n            return counts\n    return None\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    colors = rng.choice(COLOR_POOL, size=N_COLORS, replace=False).tolist()\n    counts = _sample_ranked_counts(rng)\n    if counts is None:\n        return None\n\n    pixels = np.repeat(colors, counts)\n    rng.shuffle(pixels)\n    return pixels.astype(int, copy=False).reshape(GRID_SHAPE)\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            try:\n                out = main(result)\n            except Exception:\n                continue\n            if out is not None:\n                return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRIES} attempts\")\nfrom __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom arc_utils import get_bg, in_bounds, neighbors4, label_mask\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect framed squares via colored bridges following a control-pixel sequence.\n\n    Input structure:\n    - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.\n    - Control row below squares: colored pixels read left-to-right encode visitation order.\n\n    Rule:\n    - Start at the square matching first control color c0.\n    - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.\n    - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.\n\n    Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # border color = most common non-bg color\n    cnt = Counter(map(int, g.flatten()))\n    border = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            border = int(col)\n            break\n    assert not (border is None)\n\n    # detect framed squares as connected components of the border color\n    lab, n = label_mask(g == int(border), connectivity=4)\n    frames: list[dict] = []\n    for cid in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(cid))\n        if int(pts.shape[0]) < 8:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        if h < 3 or w < 3:\n            continue\n\n        t = None\n        inner_col = None\n        for tt in range(1, int(min(h, w) // 2) + 1):\n            inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]\n            if inner.size == 0:\n                continue\n            if bool((inner == int(border)).any()):\n                continue\n            u = set(map(int, inner.flatten()))\n            if len(u) != 1:\n                continue\n\n            ok = True\n            if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not ok:\n                continue\n\n            t = int(tt)\n            inner_col = int(next(iter(u)))\n            break\n\n        if t is None or inner_col is None:\n            continue\n\n        frames.append(\n            {\n                \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n                \"t\": int(t),\n                \"inner\": int(inner_col),\n                \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            }\n        )\n\n    assert not (not frames)\n\n    by: dict[int, list[dict]] = defaultdict(list)\n    for f in frames:\n        by[int(f[\"inner\"])].append(f)\n\n    max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n\n    # control row = bottom-most row below the squares with >=2 non-bg pixels\n    ctrl_r = None\n    for r in range(int(H - 1), int(max_frame_r), -1):\n        if int((g[int(r)] != int(bg)).sum()) >= 2:\n            ctrl_r = int(r)\n            break\n    assert not (ctrl_r is None)\n\n    ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n    assert not (len(ctrl) < 2)\n\n    def center(f: dict) -> tuple[int, int]:\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        return int((r0 + r1) // 2), int((c0 + c1) // 2)\n\n    def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n        a = f1[\"inner_bbox\"]\n        b = f2[\"inner_bbox\"]\n        same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n        same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))\n        return same_row, same_col\n\n    # choose start frame\n    start_color = int(ctrl[0])\n    assert not (start_color not in by)\n    start_cands = by[start_color]\n    if len(start_cands) == 1:\n        cur = start_cands[0]\n    else:\n        nxt_color = int(ctrl[1])\n        nxt_cands = by.get(nxt_color, [])\n        best = None\n        bestf = None\n        for f in start_cands:\n            for g2 in (nxt_cands if nxt_cands else [f]):\n                sr, sc = aligned(f, g2)\n                al = 1 if (sr or sc) else 0\n                (r1_, c1_) = center(f)\n                (r2_, c2_) = center(g2)\n                d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n                cand = (int(al), -int(d))\n                if best is None or cand > best:\n                    best = cand\n                    bestf = f\n        cur = bestf\n\n    out = g.copy()\n\n    def draw_bridge(fa: dict, fb: dict, color: int) -> None:\n        (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n        (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n        ia = fa[\"inner_bbox\"]\n        sr, sc = aligned(fa, fb)\n        if sr:\n            rr0, rr1 = int(ia[0]), int(ia[2])\n            if int(c1a) < int(c0b):\n                cc0, cc1 = int(c1a + 1), int(c0b - 1)\n            else:\n                cc0, cc1 = int(c1b + 1), int(c0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n            return\n        if sc:\n            cc0, cc1 = int(ia[1]), int(ia[3])\n            if int(r1a) < int(r0b):\n                rr0, rr1 = int(r1a + 1), int(r0b - 1)\n            else:\n                rr0, rr1 = int(r1b + 1), int(r0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n\n    for i in range(int(len(ctrl)) - 1):\n        a = int(ctrl[i])\n        b = int(ctrl[i + 1])\n        assert int(cur[\"inner\"]) == int(a)\n        assert b in by, f\"control color {b} has no matching frame\"\n        cands = by[b]\n        best = None\n        bestf = None\n        for f in cands:\n            sr, sc = aligned(cur, f)\n            al = 1 if (sr or sc) else 0\n            (r1_, c1_) = center(cur)\n            (r2_, c2_) = center(f)\n            d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n            cand = (int(al), -int(d))\n            if best is None or cand > best:\n                best = cand\n                bestf = f\n        nxt = bestf\n        draw_bridge(cur, nxt, int(a))\n        cur = nxt\n\n    return out\n\n\ndef _most_common_nonbg(g: np.ndarray, bg: int) -> int | None:\n    cnt = Counter(map(int, g.flatten()))\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            return int(col)\n    return None\n\ndef _draw_frame(g: np.ndarray, *, r0: int, c0: int, outer: int, t: int, border: int, inner_col: int) -> None:\n    g[int(r0) : int(r0 + outer), int(c0) : int(c0 + outer)] = int(border)\n    g[int(r0 + t) : int(r0 + outer - t), int(c0 + t) : int(c0 + outer - t)] = int(inner_col)\n\ndef _bridge_cells(fa: dict, fb: dict) -> set[tuple[int, int]]:\n    (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n    (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n    ia = fa[\"inner_bbox\"]\n    ib = fb[\"inner_bbox\"]\n    # same-row band\n    if int(ia[0]) == int(ib[0]) and int(ia[2]) == int(ib[2]):\n        rr0, rr1 = int(ia[0]), int(ia[2])\n        if int(c1a) < int(c0b):\n            cc0, cc1 = int(c1a + 1), int(c0b - 1)\n        else:\n            cc0, cc1 = int(c1b + 1), int(c0a - 1)\n        assert int(cc0) <= int(cc1), \"horizontal bridge gap must be non-empty\"\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,340p' /home/lixinyu/snap/new/ARC_code/eval/58490d8a.py\nsed -n '1,340p' /home/lixinyu/snap/new/ARC_code/eval/7491f3cf.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,340p' /home/lixinyu/snap/new/ARC_code/eval/58490d8a.py\nsed -n '1,340p' /home/lixinyu/snap/new/ARC_code/eval/7491f3cf.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_coords, components_mask, crop_bbox, get_bg, label_mask, paste, random_free_location\nimport random\nfrom functools import lru_cache\nfrom itertools import combinations\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count colored objects and record tallies inside a legend box.\n\n    Input structure:\n    - A black rectangular legend box with key-color pixels in its leftmost non-black column.\n    - Outside the box, distinct objects of each key color are scattered across the grid.\n\n    Rule:\n    - For each key color, count separate same-colored objects outside the legend box.\n    - Output the legend box repainted: each key row gets one dot per object, spaced every other cell rightward from the key pixel.\n\n    Key insight: The legend is both the color index and the output canvas — object counts become dot sequences on the matching row.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    _bg = int(get_bg(g))\n\n    black = 0\n\n    # STEP 1) Find the legend bbox: largest black CC whose bbox contains some non-black pixels.\n    best = None  # (area, bbox)\n    for coords in components_mask(g == int(black), connectivity=8):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if (sub != int(black)).any():\n            area = int(coords.shape[0])\n            cand = (area, tuple(map(int, b)))\n            if best is None or cand[0] > best[0]:\n                best = cand\n\n    assert not (best is None)\n\n    r0, c0, r1, c1 = map(int, best[1])\n    box = crop_bbox(g, (r0, c0, r1, c1))\n    bh, bw = map(int, box.shape)\n\n    # STEP 2) Inside the legend bbox, find the key column:\n    # leftmost column with any non-black pixels (the \"key pixels\").\n    key_col = None\n    for cc in range(bw):\n        if (box[:, int(cc)] != int(black)).any():\n            key_col = int(cc)\n            break\n    if key_col is None:\n        return np.zeros_like(box)\n\n    keys = [(int(rr), int(box[int(rr), int(key_col)])) for rr in range(bh) if int(box[int(rr), int(key_col)]) != int(black)]\n    keys.sort(key=lambda t: int(t[0]))\n\n    outside = np.ones((H, W), dtype=bool)\n    outside[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = False\n    out = np.zeros((bh, bw), dtype=int)\n\n    # STEP 3/4) Count CCs of each key color outside the legend, then draw 1 dot per CC.\n    for rr, col in keys:\n        mask = (g == int(col)) & outside\n        _labc, nc = label_mask(mask, connectivity=8)\n        for i in range(int(nc)):\n            cc = int(key_col + 2 * i)\n            if 0 <= cc < bw:\n                out[int(rr), int(cc)] = int(col)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette and legend color choices.\nCOLOR_POOL = tuple(range(1, 10))\nBLACK = 0\nDISTRACTOR_PROB = 0.5\n\n# Key rows and tally dimensions.\nKEY_COUNT_RANGE = (2, 4)\nTARGET_COUNT_RANGE = (1, 5)\nKEY_ROW_FIRST = 1\nKEY_ROW_STEP = 2\nKEY_COLUMN = 1\nTALLY_COL_STEP = 2\nLEGEND_HEIGHT_TAIL = 1\nLEGEND_WIDTH_TAIL = 1\nLEGEND_SLACK_RANGE = (0, 3)\n\n# Canvas size and legend placement bounds.\nGRID_HEIGHT_RANGE = (20, 25)\nGRID_WIDTH_RANGE = (20, 25)\nLEGEND_EDGE_MARGIN = 2\n\n# Sprite shape and placement constraints.\nSPRITE_AREA_RANGE = (4, 7)\nSPRITE_BBOXES = ((2, 2), (2, 3), (3, 2), (3, 3))\nSPRITE_CONNECTIVITY = 8\nSPRITE_PADDING = 1\nSPRITE_PADDING_CONNECTIVITY = 8\n\n# Retry budget for rejection sampling.\nGENERATION_ATTEMPTS = 300\n\n\ndef _randint(bounds: tuple[int, int]) -> int:\n    \"\"\"Return an inclusive randint from a configured (low, high) pair.\"\"\"\n    return random.randint(bounds[0], bounds[1])\n\n\n@lru_cache(maxsize=None)\ndef _valid_masks(h: int, w: int, area: int) -> tuple[np.ndarray, ...]:\n    \"\"\"Return connected masks that span all four sides of the sprite bbox.\"\"\"\n    masks = []\n    for cells in combinations(range(h * w), area):\n        mask = np.zeros((h, w), dtype=bool)\n        for cell in cells:\n            mask[cell // w, cell % w] = True\n        spans_edges = mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()\n        if not spans_edges:\n            continue\n        _, n = label_mask(mask, connectivity=SPRITE_CONNECTIVITY)\n        if n == 1:\n            masks.append(mask)\n    return tuple(masks)\n\n\ndef _make_sprite(color: int, bg: int) -> np.ndarray:\n    \"\"\"Sample one connected same-color sprite drawn on the background color.\"\"\"\n    area = _randint(SPRITE_AREA_RANGE)\n    dims = []\n    for h, w in SPRITE_BBOXES:\n        if h * w >= area and _valid_masks(h, w, area):\n            dims.append((h, w))\n    h, w = random.choice(dims)\n    mask = random.choice(_valid_masks(h, w, area))\n    sprite = np.full((h, w), int(bg), dtype=int)\n    sprite[mask] = int(color)\n    return sprite\n\n\ndef _sample_palette() -> tuple[int, list[int], int | None]:\n    \"\"\"Choose background, key colors, and optional distractor color.\"\"\"\n    colors = list(COLOR_POOL)\n    bg = random.choice(colors)\n\n    k = _randint(KEY_COUNT_RANGE)\n    remaining = [c for c in colors if c != bg]\n    key_colors = random.sample(remaining, k)\n    remaining = [c for c in remaining if c not in key_colors]\n    distractor_color = random.choice(remaining) if remaining and random.random() < DISTRACTOR_PROB else None\n    return bg, key_colors, distractor_color\n\n\ndef _sample_counts(k: int) -> list[int]:\n    \"\"\"Sample the target outside-component count for each key color.\"\"\"\n    return [_randint(TARGET_COUNT_RANGE) for _ in range(k)]\n\n\ndef _legend_shape(k: int, max_count: int) -> tuple[int, int]:\n    \"\"\"Return legend height and width for the key count and largest tally.\"\"\"\n    bh = KEY_ROW_STEP * k + LEGEND_HEIGHT_TAIL\n    bw = TALLY_COL_STEP * max_count + LEGEND_WIDTH_TAIL + _randint(LEGEND_SLACK_RANGE)\n    return bh, bw\n\n\ndef _key_row(i: int) -> int:\n    \"\"\"Map a zero-based key index to its row inside the legend/output box.\"\"\"\n    return KEY_ROW_FIRST + KEY_ROW_STEP * i\n\n\ndef _build_expected(key_colors: list[int], counts: list[int]) -> np.ndarray:\n    \"\"\"Render the black output tally canvas implied by key colors and counts.\"\"\"\n    max_count = max(counts)\n    bh, bw = _legend_shape(len(key_colors), max_count)\n\n    expected = np.full((bh, bw), BLACK, dtype=int)\n    for i, (color, count) in enumerate(zip(key_colors, counts)):\n        rr = _key_row(i)\n        for j in range(count):\n            expected[rr, KEY_COLUMN + TALLY_COL_STEP * j] = int(color)\n    return expected\n\n\ndef _build_legend(shape: tuple[int, int], key_colors: list[int]) -> np.ndarray:\n    \"\"\"Return a black legend patch with only the key-column pixels filled.\"\"\"\n    legend = np.full(shape, BLACK, dtype=int)\n    for i, color in enumerate(key_colors):\n        legend[_key_row(i), KEY_COLUMN] = int(color)\n    return legend\n\n\ndef _new_grid_with_legend(bg: int, legend: np.ndarray) -> np.ndarray | None:\n    \"\"\"Sample a grid and paste the legend away from all canvas edges.\"\"\"\n    bh, bw = map(int, legend.shape)\n    H = _randint(GRID_HEIGHT_RANGE)\n    W = _randint(GRID_WIDTH_RANGE)\n    min_h = bh + 2 * LEGEND_EDGE_MARGIN\n    min_w = bw + 2 * LEGEND_EDGE_MARGIN\n    if H < min_h or W < min_w:\n        return None\n\n    grid = np.full((H, W), int(bg), dtype=int)\n    r0 = random.randint(LEGEND_EDGE_MARGIN, H - bh - LEGEND_EDGE_MARGIN)\n    c0 = random.randint(LEGEND_EDGE_MARGIN, W - bw - LEGEND_EDGE_MARGIN)\n    paste(grid, legend, r0, c0)\n    return grid\n\n\ndef _build_sprite_queue(\n    key_colors: list[int],\n    counts: list[int],\n    distractor_color: int | None,\n    bg: int,\n) -> list[np.ndarray]:\n    \"\"\"Create canonical key sprites, optional distractor sprite, and shuffle them.\"\"\"\n    sprites = []\n    for color, count in zip(key_colors, counts):\n        sprite = _make_sprite(color, bg)\n        for _ in range(count):\n            sprites.append(sprite.copy())\n    if distractor_color is not None:\n        sprites.append(_make_sprite(distractor_color, bg))\n    random.shuffle(sprites)\n    return sprites\n\n\ndef _place_sprites(grid: np.ndarray, sprites: list[np.ndarray], bg: int) -> None:\n    \"\"\"Paste sprites into random non-touching free locations in queue order.\"\"\"\n    for sprite in sprites:\n        sr, sc = random_free_location(\n            grid,\n            sprite,\n            transparent=bg,\n            padding=SPRITE_PADDING,\n            padding_connectivity=SPRITE_PADDING_CONNECTIVITY,\n        )\n        paste(grid, sprite, sr, sc, transparent=bg)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Run one output-first generation attempt and reject solver mismatches.\"\"\"\n    bg, key_colors, distractor_color = _sample_palette()\n    counts = _sample_counts(len(key_colors))\n    expected = _build_expected(key_colors, counts)\n    legend = _build_legend(expected.shape, key_colors)\n    grid = _new_grid_with_legend(bg, legend)\n    if grid is None:\n        return None\n\n    sprites = _build_sprite_queue(key_colors, counts, distractor_color, bg)\n    try:\n        _place_sprites(grid, sprites, bg)\n    except ValueError:\n        return None\n\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 58490d8a input\")\nfrom __future__ import annotations\nimport random\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import get_bg, flood_fill, neighbors8, in_bounds, label_mask\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Composite two pattern tiles into a fourth panel using flood-fill from an indicator pixel.\n\n    Input structure:\n    - Four 5×5 panels in one row, border-separated.\n    - Panel 0: cue pixels = wall boundary (8-connected, edge-to-edge, through center)\n               + one 8-isolated indicator pixel.\n    - Panels 1–2: source patterns. Panel 3: blank (to fill).\n\n    Rule:\n    - Flood-fill (4-conn) from indicator, blocked by wall → inside region.\n    - Inside → non-bg from panel 1; outside → non-bg from panel 2.\n    - Wall → panel 1 if non-bg; panel 2 fallback when wall is 4-connected.\n\n    Key insight: The cue panel's isolated indicator and wall partition the tile into inside/outside masks that select between the two source panels.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n\n    border = int(g[0, 0])\n    tiles = [g[1:6, 1 + 6 * j : 1 + 6 * j + 5].copy() for j in range(4)]\n    t0, t1, t2, _t3 = tiles\n    b = int(Counter(t1.flatten()).most_common(1)[0][0])\n    assert border != b, \"border color must differ from tile background\"\n\n    t0_bg = int(Counter(t0.flatten()).most_common(1)[0][0])\n    cue_set = {(int(r), int(c)) for r in range(5) for c in range(5) if int(t0[r, c]) != t0_bg}\n    assert cue_set, \"no cue pixels found\"\n\n    # --- Indicator = the unique 8-isolated cue pixel ---\n    indicator = None\n    for r, c in cue_set:\n        if not any((nr, nc) in cue_set for nr, nc in neighbors8(r, c)):\n            assert indicator is None, \"multiple 8-isolated cue pixels\"\n            indicator = (r, c)\n    assert indicator is not None, \"no 8-isolated cue pixel found\"\n\n    # Indicator must sit at a tile corner or edge midpoint\n    valid_pos = {(0,0),(0,4),(4,0),(4,4),(0,2),(2,0),(2,4),(4,2)}\n    assert indicator in valid_pos, f\"indicator {indicator} not at corner/edge-midpoint\"\n\n    wall = cue_set - {indicator}\n\n    # --- Structural assertions (feedback for generate_input agents) ---\n    assert (2, 2) in wall, \"wall must pass through the grid center (2,2)\"\n\n    # Wall must be symmetric about the line from indicator to center (2,2)\n    ir, ic = indicator\n    dr, dc = 2 - ir, 2 - ic\n    if dr == 0:\n        _refl = lambda r, c: (4 - r, c)\n    elif dc == 0:\n        _refl = lambda r, c: (r, 4 - c)\n    elif dr * dc > 0:\n        _refl = lambda r, c: (c, r)\n    else:\n        _refl = lambda r, c: (4 - c, 4 - r)\n    assert wall == {_refl(r, c) for r, c in wall}, \"wall must be symmetric about indicator→center axis\"\n\n    sides_touched = set()\n    for r, c in wall:\n        if r == 0: sides_touched.add(\"top\")\n        if r == 4: sides_touched.add(\"bottom\")\n        if c == 0: sides_touched.add(\"left\")\n        if c == 4: sides_touched.add(\"right\")\n    assert len(sides_touched) >= 2, f\"wall must span edge-to-edge, only touches {sides_touched}\"\n\n    # --- Flood fill inside region ---\n    EMPTY, WALL, INSIDE = 0, 1, 2\n    tmp = np.zeros((5, 5), dtype=int)\n    for r, c in wall:\n        tmp[r, c] = WALL\n    flood_fill(tmp, indicator[0], indicator[1], INSIDE, connectivity=4)\n    inside = {(int(r), int(c)) for r, c in np.argwhere(tmp == INSIDE)}\n\n    outside = {(r, c) for r in range(5) for c in range(5)} - inside - wall\n    assert outside, \"wall must partition the grid — outside region is empty\"\n\n    # Wall 4-connectivity determines boundary blending behavior:\n    # axis-aligned walls (4-connected) allow t2 fallback; diagonal walls don't.\n    wall_mask = np.zeros((5, 5), dtype=bool)\n    for r, c in wall:\n        wall_mask[r, c] = True\n    _, n_comp = label_mask(wall_mask, connectivity=4)\n    wall_4conn = (n_comp == 1)\n\n    # --- Build output tile ---\n    out3 = np.full((5, 5), b, dtype=int)\n    for r in range(5):\n        for c in range(5):\n            v1, v2 = int(t1[r, c]), int(t2[r, c])\n            if (r, c) in inside:\n                if v1 != b:\n                    out3[r, c] = v1\n            elif (r, c) in wall:\n                if v1 != b:\n                    out3[r, c] = v1\n                elif wall_4conn and v2 != b:\n                    out3[r, c] = v2\n            else:\n                if v2 != b:\n                    out3[r, c] = v2\n\n    out = g.copy()\n    out[1:6, 1 + 6 * 3 : 1 + 6 * 3 + 5] = out3\n    return out\n\n# --------------- generator (subagent) ---------------\n\n# ── Tunables ──────────────────────────────────────────────────────────────────\nTILE_SZ = 5                    # each panel is 5x5\nGRID_ROWS, GRID_COLS = 7, 25  # fixed output grid shape\nNUM_COLORS = 10                # ARC color palette size\n\nT1_MIN_PX, T1_MAX_PX = 8, 12  # tile-1 non-bg pixel range\nT2_MIN_PX, T2_MAX_PX = 9, 12  # tile-2 non-bg pixel range\nORBIT_INCLUDE_PROB = 0.55      # per-orbit inclusion probability for pattern sampling\nPATTERN_RETRIES = 200          # max retries per _sample_symmetric_pattern call\nGEN_RETRIES = 300              # max retries in generate_input outer loop\nLBEND_PROB = 0.2               # L-bend wall probability (eval ratio ~4:1 straight:L-bend)\n\n# ── Symmetric pattern orbits (D1+D2 symmetry on 5x5) ─────────────────────────\n_ORBITS = [\n    [(0, 0), (4, 4)],\n    [(0, 4), (4, 0)],\n    [(2, 2)],\n    [(1, 1), (3, 3)],\n    [(1, 3), (3, 1)],\n    [(0, 1), (1, 0), (3, 4), (4, 3)],\n    [(0, 2), (2, 0), (2, 4), (4, 2)],\n    [(0, 3), (3, 0), (1, 4), (4, 1)],\n    [(1, 2), (2, 1), (2, 3), (3, 2)],\n]\n\n\ndef _sample_symmetric_pattern(bg: int, fg: int, rng: random.Random, *,\n                              min_px: int, max_px: int) -> np.ndarray | None:\n    \"\"\"Sample a 5x5 grid symmetric under both diagonals, with fg pixel count in\n    [min_px, max_px].  Randomizes orbit order, includes each greedily within\n    the max budget, retries until min is met.\"\"\"\n    for _ in range(PATTERN_RETRIES):\n        order = list(range(len(_ORBITS)))\n        rng.shuffle(order)\n        p = np.full((TILE_SZ, TILE_SZ), bg, dtype=int)\n        count = 0\n        for i in order:\n            orbit = _ORBITS[i]\n            if count + len(orbit) > max_px:\n                continue\n            if rng.random() < ORBIT_INCLUDE_PROB:\n                for r, c in orbit:\n                    p[r, c] = fg\n                count += len(orbit)\n        if min_px <= count <= max_px:\n            return p\n    return None\n\n\n# ── Precomputed (indicator, wall) configurations ─────────────────────────────\n# 8 straight + 12 L-bend combos, all verified to partition the 5x5 grid.\n_STRAIGHT_CONFIGS = [\n    ((0, 2), frozenset({(2,0),(2,1),(2,2),(2,3),(2,4)})),          # row\n    ((4, 2), frozenset({(2,0),(2,1),(2,2),(2,3),(2,4)})),          # row\n    ((2, 0), frozenset({(0,2),(1,2),(2,2),(3,2),(4,2)})),          # col\n    ((2, 4), frozenset({(0,2),(1,2),(2,2),(3,2),(4,2)})),          # col\n    ((0, 0), frozenset({(0,4),(1,3),(2,2),(3,1),(4,0)})),          # anti-diag\n    ((4, 4), frozenset({(0,4),(1,3),(2,2),(3,1),(4,0)})),          # anti-diag\n    ((0, 4), frozenset({(0,0),(1,1),(2,2),(3,3),(4,4)})),          # diag\n    ((4, 0), frozenset({(0,0),(1,1),(2,2),(3,3),(4,4)})),          # diag\n]\n_LBEND_CONFIGS = [\n    ((0, 0), frozenset({(2,2),(1,2),(0,2),(2,1),(2,0)})),          # U+L\n    ((0, 0), frozenset({(2,2),(3,2),(4,2),(2,3),(2,4)})),          # D+R\n    ((4, 4), frozenset({(2,2),(1,2),(0,2),(2,1),(2,0)})),          # U+L\n    ((4, 4), frozenset({(2,2),(3,2),(4,2),(2,3),(2,4)})),          # D+R\n    ((0, 4), frozenset({(2,2),(1,2),(0,2),(2,3),(2,4)})),          # U+R\n    ((0, 4), frozenset({(2,2),(3,2),(4,2),(2,1),(2,0)})),          # D+L\n    ((4, 0), frozenset({(2,2),(1,2),(0,2),(2,3),(2,4)})),          # U+R\n    ((4, 0), frozenset({(2,2),(3,2),(4,2),(2,1),(2,0)})),          # D+L\n    ((4, 2), frozenset({(2,2),(1,1),(0,0),(1,3),(0,4)})),          # NW+NE\n    ((0, 2), frozenset({(2,2),(3,1),(4,0),(3,3),(4,4)})),          # SW+SE\n    ((2, 4), frozenset({(2,2),(1,1),(0,0),(3,1),(4,0)})),          # NW+SW\n    ((2, 0), frozenset({(2,2),(1,3),(0,4),(3,3),(4,4)})),          # NE+SE\n]\n\n\ndef _flood_inside(wall: frozenset, indicator: tuple[int, int]) -> set[tuple[int, int]]:\n    tmp = np.zeros((TILE_SZ, TILE_SZ), dtype=int)\n    for r, c in wall:\n        tmp[r, c] = 1\n    flood_fill(tmp, indicator[0], indicator[1], 2, connectivity=4)\n    return {(int(r), int(c)) for r, c in np.argwhere(tmp == 2)}\n\n\n# ── Main generation loop ─────────────────────────────────────────────────────\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    # 1. Colors: border != tile_bg; cue/t1/t2 mutually distinct and != tile_bg.\n    palette = list(range(NUM_COLORS))\n    tile_bg = rng.choice(palette)\n    other = [c for c in palette if c != tile_bg]\n    cue_color, t1_color, t2_color = rng.sample(other, 3)\n    border = rng.choice(other)\n\n    # 2. Wall + indicator (4:1 straight:L-bend ratio).\n    pool = _LBEND_CONFIGS if rng.random() < LBEND_PROB else _STRAIGHT_CONFIGS\n    indicator, wall = rng.choice(pool)\n    inside = _flood_inside(wall, indicator)\n\n    # 3. Tile-1 / Tile-2 symmetric patterns.\n    t1 = _sample_symmetric_pattern(tile_bg, t1_color, rng,\n                                   min_px=T1_MIN_PX, max_px=T1_MAX_PX)\n    t2 = _sample_symmetric_pattern(tile_bg, t2_color, rng,\n                                   min_px=T2_MIN_PX, max_px=T2_MAX_PX)\n    if t1 is None or t2 is None:\n        return None\n\n    # 4. Tile-0 (cue tile): bg + wall + indicator drawn in cue_color.\n    t0 = np.full((TILE_SZ, TILE_SZ), tile_bg, dtype=int)\n    for r, c in wall:\n        t0[r, c] = cue_color\n    t0[indicator[0], indicator[1]] = cue_color\n\n    # 5. Composite output tile-3.\n    wall_mask = np.zeros((TILE_SZ, TILE_SZ), dtype=bool)\n    for r, c in wall:\n        wall_mask[r, c] = True\n    _, n_comp = label_mask(wall_mask, connectivity=4)\n    wall_4conn = (n_comp == 1)\n    outside = set((r, c) for r in range(TILE_SZ) for c in range(TILE_SZ)) - inside - wall\n    out3 = np.full((TILE_SZ, TILE_SZ), tile_bg, dtype=int)\n    for r in range(TILE_SZ):\n        for c in range(TILE_SZ):\n            v1, v2 = int(t1[r, c]), int(t2[r, c])\n            if (r, c) in inside:\n                if v1 != tile_bg: out3[r, c] = v1\n            elif (r, c) in wall:\n                if v1 != tile_bg: out3[r, c] = v1\n                elif wall_4conn and v2 != tile_bg: out3[r, c] = v2\n            else:\n                if v2 != tile_bg: out3[r, c] = v2\n\n    # 6. Assemble 7x25 input grid (tile-3 input is blank).\n    t3_in = np.full((TILE_SZ, TILE_SZ), tile_bg, dtype=int)\n    g = np.full((GRID_ROWS, GRID_COLS), border, dtype=int)\n    for j, tile in enumerate([t0, t1, t2, t3_in]):\n        g[1:6, 1 + 6 * j: 1 + 6 * j + 5] = tile\n\n    # 7. Oracle: solver output must match hand-built composite.\n    expected = g.copy()\n    expected[1:6, 1 + 6 * 3: 1 + 6 * 3 + 5] = out3\n    got = main(g)\n    if not np.array_equal(got, expected):\n        return None\n    return g\n\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(f\"generate_input failed after {GEN_RETRIES} attempts\")\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"参考实现的共同点比较明确了：`main()` 会写强约束断言，`generate_input()` 用“先构造再回跑 solver 验证”的拒绝采样。接下来我先检查目标目录和同目录题目的代码风格，然后直接实现这道题。"}}
