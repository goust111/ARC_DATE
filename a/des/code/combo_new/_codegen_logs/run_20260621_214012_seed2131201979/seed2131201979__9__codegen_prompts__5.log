{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '40,340p' /home/lixinyu/snap/new/ARC_code/train/ba1aa698.py\nsed -n '50,360p' /home/lixinyu/snap/new/ARC_code/train/278e5215.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Extrapolate the moving sprite from a horizontal sequence of shared-border frames into the next standalone frame.\n\n    Input structure\n    - The grid is a row of equal-width framed panels sharing their vertical border columns.\n    - Each panel has the same fill color and one identical interior sprite at the same local columns.\n    - The sprite's top row changes by a constant amount from panel to panel.\n\n    Rule\n    - Build one output panel with the same height, frame color, fill color, and sprite.\n    - Continue the sprite's diagonal motion one more panel to the right.\n    - Because the output is a standalone panel, advance by the full panel width, not the shared-border spacing.\n\n    Key insight\n    - The panels are consecutive frames of motion; the output is the next frame after the sequence.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    frame = int(g[0, 0])\n    assert h >= 3 and w >= 3\n    assert np.all(g[0, :] == frame)\n    assert np.all(g[-1, :] == frame)\n\n    separators = [c for c in range(w) if np.all(g[:, c] == frame)]\n    assert len(separators) >= 3\n    assert separators[0] == 0 and separators[-1] == w - 1\n    strides = [b - a for a, b in zip(separators, separators[1:])]\n    assert len(set(strides)) == 1\n    stride = strides[0]\n    panel_w = stride + 1\n\n    interior_values = []\n    for c0, c1 in zip(separators, separators[1:]):\n        interior_values.extend(g[1:-1, c0 + 1 : c1].ravel())\n    fill = _unique_most_common(interior_values)\n\n    panels = []\n    for c0, c1 in zip(separators, separators[1:]):\n        panel = g[:, c0 : c1 + 1]\n        assert panel.shape == (h, panel_w)\n        assert np.all(panel[0, :] == frame)\n        assert np.all(panel[-1, :] == frame)\n        assert np.all(panel[:, 0] == frame)\n        assert np.all(panel[:, -1] == frame)\n        panels.append(panel)\n\n    template_sprite, template_mask, first_top, template_left = _extract_sprite(panels[0], fill)\n    top_rows = [first_top]\n    for panel in panels[1:]:\n        sprite, sprite_mask, top, local_c0 = _extract_sprite(panel, fill)\n        assert local_c0 == template_left\n        assert sprite_mask.shape == template_mask.shape\n        assert np.array_equal(sprite_mask, template_mask)\n        assert np.array_equal(sprite[sprite_mask], template_sprite[template_mask])\n        top_rows.append(top)\n\n    deltas = [b - a for a, b in zip(top_rows, top_rows[1:])]\n    assert len(deltas) >= 1 and len(set(deltas)) == 1\n    next_top = _round_half_up(\n        Fraction(top_rows[-1], 1) + Fraction(deltas[0] * panel_w, stride)\n    )\n\n    sprite_h, sprite_w = template_sprite.shape\n    assert 1 <= next_top and next_top + sprite_h <= h - 1\n    assert 1 <= template_left and template_left + sprite_w <= panel_w - 1\n\n    out = np.full((h, panel_w), fill, dtype=int)\n    out[0, :] = frame\n    out[-1, :] = frame\n    out[:, 0] = frame\n    out[:, -1] = frame\n\n    target = out[next_top : next_top + sprite_h, template_left : template_left + sprite_w]\n    target[template_mask] = template_sprite[template_mask]\n    return out\n\n# --------------- generator (att2) ---------------\n_GEN_HEIGHT, _GEN_LOCAL_LEFT = 16, 2\n_GEN_INTERIOR_WIDTHS, _GEN_PANEL_COUNTS = (4, 5), (3, 4)\n_GEN_COLORS = tuple(range(10))\n_GEN_SPRITE_USES_FRAME_PROB = 0.3\n_GEN_SPRITE_HEIGHTS, _GEN_SPRITE_WIDTHS = (1, 2), (2, 3)\n_GEN_MIN_SPRITE_PIXELS, _GEN_MAX_SPRITE_PIXELS = 2, 5\n_GEN_DELTAS = (-3, -2, -1, 1, 2, 3)\n_GEN_MAX_ATTEMPTS = 300\n_GEN_MASK_CACHE = {}\n\ndef _gen_round_half_up(value):\n    return _gen_math.floor(value + _gen_Fraction(1, 2))\n\ndef _gen_contiguous_masks(sprite_h, sprite_w):\n    key = (sprite_h, sprite_w)\n    if key in _GEN_MASK_CACHE:\n        return _GEN_MASK_CACHE[key]\n    cells = [(r, c) for r in range(sprite_h) for c in range(sprite_w)]\n    masks_by_count = {}\n    max_pixels = min(_GEN_MAX_SPRITE_PIXELS, sprite_h * sprite_w)\n    for pixel_count in range(_GEN_MIN_SPRITE_PIXELS, max_pixels + 1):\n        masks = []\n        for combo in _gen_itertools.combinations(cells, pixel_count):\n            rows = {r for r, _ in combo}\n            cols = {c for _, c in combo}\n            if len(rows) != sprite_h or len(cols) != sprite_w:\n                continue\n            mask = np.zeros((sprite_h, sprite_w), dtype=bool)\n            for r, c in combo:\n                mask[r, c] = True\n            if is_contiguous(mask.astype(int), background=0, connectivity=4):\n                masks.append(mask)\n        if masks:\n            masks_by_count[pixel_count] = masks\n    _GEN_MASK_CACHE[key] = masks_by_count\n    return masks_by_count\n\ndef _gen_sprite(fill, sprite_color):\n    sprite_h = _gen_random.choice(_GEN_SPRITE_HEIGHTS)\n    sprite_w = _gen_random.choice(_GEN_SPRITE_WIDTHS)\n    masks_by_count = _gen_contiguous_masks(sprite_h, sprite_w)\n\n    pixel_count = _gen_random.choice(sorted(masks_by_count))\n    mask = _gen_random.choice(masks_by_count[pixel_count])\n    sprite = np.full((sprite_h, sprite_w), fill, dtype=int)\n    sprite[mask] = sprite_color\n    return sprite, mask\n\ndef _gen_make_panel(height, panel_w, frame, fill, sprite, top_row, local_left):\n    panel = np.full((height, panel_w), fill, dtype=int)\n    panel[0, :] = frame\n    panel[-1, :] = frame\n    panel[:, 0] = frame\n    panel[:, -1] = frame\n    paste(panel, sprite, top_row, local_left, transparent=fill)\n    return panel\n\ndef _gen_choose_palette():\n    frame, fill = _gen_random.sample(_GEN_COLORS, 2)\n    if _gen_random.random() < _GEN_SPRITE_USES_FRAME_PROB:\n        sprite_color = frame\n    else:\n        sprite_color = _gen_random.choice(\n            [color for color in _GEN_COLORS if color not in (frame, fill)]\n        )\n    return frame, fill, sprite_color\n\ndef _gen_motion_choices(sprite_h, panel_w, num_panels):\n    max_top = _GEN_HEIGHT - 1 - sprite_h\n    stride = panel_w - 1\n    choices = []\n    for delta in _GEN_DELTAS:\n        for start in range(1, max_top + 1):\n            top_rows = [start + i * delta for i in range(num_panels)]\n            if not all(1 <= top <= max_top for top in top_rows):\n                continue\n            next_top = _gen_round_half_up(\n                _gen_Fraction(top_rows[-1], 1)\n                + _gen_Fraction(delta * panel_w, stride)\n            )\n            if 1 <= next_top <= max_top:\n                choices.append((delta, start, next_top))\n    return choices\n\ndef _gen_make_input(num_panels, stride, frame, fill, sprite, start_top, delta):\n    width = num_panels * stride + 1\n    inp = np.full((_GEN_HEIGHT, width), fill, dtype=int)\n    inp[0, :] = frame\n    inp[-1, :] = frame\n    for panel_i in range(num_panels + 1):\n        inp[:, panel_i * stride] = frame\n    for panel_i in range(num_panels):\n        top = start_top + panel_i * delta\n        paste(inp, sprite, top, panel_i * stride + _GEN_LOCAL_LEFT, transparent=fill)\n    return inp\n\ndef _gen_attempt():\n    interior_w = _gen_random.choice(_GEN_INTERIOR_WIDTHS)\n    num_panels = _gen_random.choice(_GEN_PANEL_COUNTS)\n    panel_w = interior_w + 2\n    stride = panel_w - 1\n    frame, fill, sprite_color = _gen_choose_palette()\n\n    sprite, _ = _gen_sprite(fill, sprite_color)\n    sprite_h, sprite_w = sprite.shape\n    if _GEN_LOCAL_LEFT + sprite_w > panel_w - 1:\n        return None\n\n    choices = _gen_motion_choices(sprite_h, panel_w, num_panels)\n    if not choices:\n        return None\n    delta, start_top, next_top = _gen_random.choice(choices)\n\n    expected = _gen_make_panel(\n        _GEN_HEIGHT, panel_w, frame, fill, sprite, next_top, _GEN_LOCAL_LEFT\n    )\n    inp = _gen_make_input(num_panels, stride, frame, fill, sprite, start_top, delta)\n    if np.array_equal(main(inp), expected):\n        return inp\n    return None\n\ndef generate_input():\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid ba1aa698 input\")\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the large mask crop column-by-column using the separate three-row palette strip.\n\n    Input structure:\n    - The background is the most common color.\n    - One large monochrome foreground object is the mask; its bbox is the output region and may contain background holes.\n    - The remaining foreground is a 3-row palette rectangle with the same width as the mask bbox: two identical color rows and one uniform row.\n\n    Rule:\n    - Crop to the mask object's bbox.\n    - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n    - Replace background holes inside the crop with the palette's uniform third-row color.\n\n    Key insight:\n    The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    mask_color = _unique_largest_non_bg_color(g, bg)\n\n    b = _mask_bbox(g, mask_color)\n    mask_crop = crop_bbox(g == int(mask_color), b)\n    height, width = map(int, mask_crop.shape)\n\n    column_colors, hole_color = _palette(g, bg, mask_color, width)\n    out = np.tile(column_colors, (height, 1))\n    out[~mask_crop] = hole_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, colors, and object bounds.\nBACKGROUND_COLOR, MASK_COLOR = 0, 5\nCOLOR_MIN, COLOR_MAX = 1, 9\nGRID_SIDE_MIN, GRID_SIDE_MAX = 10, 18\nMASK_SIDE_MIN, MASK_SIDE_MAX = 5, 10\nPALETTE_HEIGHT = 3\nGAP_MIN, GAP_MAX = 1, 3\n\n# Palette run construction.\nRUN_COUNT_OPTIONS = (4, 5)\nRUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3\nCOLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5\nUNUSED_COLOR_BIAS = 0.7\n\n# Mask density and retry budget.\nMASK_DENSITY_MIN, MASK_DENSITY_MAX = 0.60, 0.71\nGENERATION_ATTEMPTS = 300\n\n\ndef _valid_run_lengths(width: int, n_runs: int) -> list[tuple[int, ...]]:\n    length_range = range(RUN_LENGTH_MIN, RUN_LENGTH_MAX + 1)\n    return [\n        tuple(int(x) for x in lengths)\n        for lengths in product(length_range, repeat=int(n_runs))\n        if sum(lengths) == int(width)\n    ]\n\n\ndef _run_colors(colors: list[int], n_runs: int) -> list[int]:\n    seq: list[int] = []\n    unused = set(colors)\n    for i in range(int(n_runs)):\n        slots_left = int(n_runs) - i\n        choices = [c for c in colors if not seq or c != seq[-1]]\n        if len(unused) >= slots_left:\n            choices = [c for c in choices if c in unused]\n        elif unused and random.random() < UNUSED_COLOR_BIAS:\n            preferred = [c for c in choices if c in unused]\n            if preferred:\n                choices = preferred\n        color = random.choice(choices)\n        seq.append(int(color))\n        unused.discard(int(color))\n    return seq\n\n\ndef _palette_row(width: int, colors: list[int]) -> np.ndarray:\n    valid_counts = [\n        n_runs for n_runs in RUN_COUNT_OPTIONS if _valid_run_lengths(int(width), n_runs)\n    ]\n    n_runs = random.choice(valid_counts)\n    valid_lengths = _valid_run_lengths(int(width), n_runs)\n    lengths = random.choice(valid_lengths)\n    n_distinct = random.randint(\n        COLUMN_COLOR_DISTINCT_MIN, min(COLUMN_COLOR_DISTINCT_MAX, n_runs)\n    )\n    chosen = random.sample(colors, n_distinct)\n    seq = _run_colors(chosen, n_runs)\n    return np.repeat(seq, lengths).astype(int)\n\n\ndef _neighbors4(r: int, c: int, h: int, w: int):\n    if r > 0:\n        yield r - 1, c\n    if r + 1 < h:\n        yield r + 1, c\n    if c > 0:\n        yield r, c - 1\n    if c + 1 < w:\n        yield r, c + 1\n\n\ndef _connected_mask(height: int, width: int, target_area: int) -> np.ndarray | None:\n    \"\"\"Grow a connected mask with full row/column span to the target area.\"\"\"\n    mask = np.zeros((int(height), int(width)), dtype=bool)\n    steps = [\"D\"] * (int(height) - 1) + [\"R\"] * (int(width) - 1)\n    random.shuffle(steps)\n\n    r = c = 0\n    mask[r, c] = True\n    for step in steps:\n        if step == \"D\":\n            r += 1\n        else:\n            c += 1\n        mask[r, c] = True\n\n    if int(mask.sum()) > int(target_area):\n        return None\n\n    frontier: set[tuple[int, int]] = set()\n\n    def add_frontier(rr: int, cc: int) -> None:\n        for nr, nc in _neighbors4(rr, cc, int(height), int(width)):\n            if not mask[nr, nc]:\n                frontier.add((int(nr), int(nc)))\n\n    for rr, cc in np.argwhere(mask):\n        add_frontier(int(rr), int(cc))\n\n    while int(mask.sum()) < int(target_area):\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        rr, cc = cell\n        mask[rr, cc] = True\n        add_frontier(rr, cc)\n\n    return mask\n\n\ndef _grid_choices(mask_h: int, mask_w: int, gap: int) -> list[tuple[int, int]]:\n    \"\"\"Grid sizes where the mask remains the unique largest non-bg object.\"\"\"\n    max_mask = int(np.floor(MASK_DENSITY_MAX * int(mask_h) * int(mask_w)))\n    min_h = max(GRID_SIDE_MIN, int(mask_h) + PALETTE_HEIGHT + int(gap))\n    min_w = max(GRID_SIDE_MIN, int(mask_w))\n    choices: list[tuple[int, int]] = []\n    for h in range(min_h, GRID_SIDE_MAX + 1):\n        for w in range(min_w, GRID_SIDE_MAX + 1):\n            if h * w - max_mask - PALETTE_HEIGHT * int(mask_w) > max_mask:\n                choices.append((h, w))\n    return choices\n\n\ndef _sample_dimensions() -> tuple[int, int, int, int, int] | None:\n    \"\"\"Sample mask size, layout gap, and compatible grid size.\"\"\"\n    mask_h = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)\n    mask_w = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)\n    gap = random.randint(GAP_MIN, GAP_MAX)\n    grid_choices = _grid_choices(mask_h, mask_w, gap)\n    if not grid_choices:\n        return None\n    grid_h, grid_w = random.choice(grid_choices)\n    return mask_h, mask_w, gap, grid_h, grid_w\n\n\ndef _sample_palette(mask_w: int) -> tuple[np.ndarray, int]:\n    \"\"\"Choose hole color and the same-width column palette row.\"\"\"\n    available = [c for c in range(COLOR_MIN, COLOR_MAX + 1) if c != MASK_COLOR]\n    hole_color = random.choice(available)\n    column_pool = [c for c in available if c != hole_color]\n    column_colors = _palette_row(mask_w, column_pool)\n    return column_colors, int(hole_color)\n\n\ndef _compose_grid(grid_h, grid_w, gap, mask, column_colors, hole_color) -> np.ndarray:\n    \"\"\"Paste mask and palette into disjoint row bands of a blank grid.\"\"\"\n    mask_h, mask_w = map(int, mask.shape)\n    hole_row = np.full(int(mask_w), int(hole_color), dtype=int)\n    palette = np.vstack([column_colors, column_colors, hole_row])\n    mask_sprite = np.where(mask, MASK_COLOR, BACKGROUND_COLOR)\n    grid = np.zeros((int(grid_h), int(grid_w)), dtype=int)\n    block_h = int(mask_h) + PALETTE_HEIGHT + int(gap)\n    top = random.randint(0, int(grid_h) - block_h)\n    palette_above = random.choice([True, False])\n    if palette_above:\n        palette_r = top\n        mask_r = top + PALETTE_HEIGHT + int(gap)\n    else:\n        mask_r = top\n        palette_r = top + int(mask_h) + int(gap)\n    mask_c = random.randint(0, int(grid_w) - int(mask_w))\n    palette_c = random.randint(0, int(grid_w) - int(mask_w))\n    paste(grid, mask_sprite, mask_r, mask_c, transparent=BACKGROUND_COLOR)\n    paste(grid, palette, palette_r, palette_c, transparent=None)\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    dims = _sample_dimensions()\n    if dims is None:\n        return None\n    mask_h, mask_w, gap, grid_h, grid_w = dims\n\n    column_colors, hole_color = _sample_palette(mask_w)\n    area = int(mask_h) * int(mask_w)\n    min_area = int(np.ceil(MASK_DENSITY_MIN * area))\n    max_area = int(np.floor(MASK_DENSITY_MAX * area))\n    target_area = random.randint(min_area, max_area)\n    mask = _connected_mask(mask_h, mask_w, target_area)\n    if mask is None:\n        return None\n\n    output = np.tile(column_colors, (int(mask_h), 1))\n    output[~mask] = int(hole_color)\n    mask = output != int(hole_color)\n    grid = _compose_grid(grid_h, grid_w, gap, mask, column_colors, hole_color)\n    if np.array_equal(main(grid), output):\n        return grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
