{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport itertools\nimport random\n\n\nMARKER_COLOR = 1\nBODY_COLOR = 2\n\n\ndef _vertical_bars(g: np.ndarray, bg: int) -> list[dict]:\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    bars = []\n    baseline = None\n    for comp in comps:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert c0 == c1\n        coords = comp[\"coords\"]\n        height = r1 - r0 + 1\n        assert comp[\"area\"] == height\n        assert {(int(r), int(c)) for r, c in coords} == {(r, c0) for r in range(r0, r1 + 1)}\n        if baseline is None:\n            baseline = r1\n        else:\n            assert r1 == baseline\n        bars.append(\n            {\n                \"color\": int(comp[\"color\"]),\n                \"col\": int(c0),\n                \"bottom\": int(r1),\n                \"height\": int(height),\n                \"coords\": coords,\n            }\n        )\n\n    assert bars\n    return sorted(bars, key=lambda b: b[\"col\"])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n    Input structure\n    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n    Rule\n    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n    - Red bars that are not reached from a blue marker remain unchanged.\n    Key insight\n    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g))) - {bg}\n    assert colors <= {MARKER_COLOR, BODY_COLOR}\n    assert MARKER_COLOR in colors\n\n    bars = _vertical_bars(g, bg)\n    by_col = {bar[\"col\"]: bar for bar in bars}\n    assert len(by_col) == len(bars)\n\n    baselines = {bar[\"bottom\"] for bar in bars}\n    assert len(baselines) == 1\n    baseline = baselines.pop()\n    out = g.copy()\n    for bar in bars:\n        if bar[\"color\"] != MARKER_COLOR:\n            continue\n\n        group = [bar]\n        current = bar\n        while True:\n            next_col = current[\"col\"] + current[\"height\"]\n            next_bar = by_col.get(next_col)\n            if next_bar is None:\n                break\n            if next_bar[\"color\"] != BODY_COLOR:\n                break\n            group.append(next_bar)\n            current = next_bar\n\n        for item in group:\n            rows = item[\"coords\"][:, 0]\n            cols = item[\"coords\"][:, 1]\n            out[rows, cols] = bg\n\n        for item in group:\n            col = item[\"col\"]\n            height = item[\"height\"]\n            assert col + height <= g.shape[1]\n            out[baseline, col : col + height] = item[\"color\"]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nMIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n\n# Bar and chain structure.\nMIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\nMIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\nMIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n\n# Layout padding and retry budget.\nGAP_VALUES = (1, 2, 3)\nMAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n\n\ndef _chain_red_distributions(n_blue, n_red):\n    \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n    return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n\n\ndef _bounded_tuples(values, n, max_sum):\n    \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n    return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n\n\ndef _sample_groups():\n    \"\"\"Sample row count and bar groups before physical layout.\"\"\"\n    rows = random.randint(MIN_ROWS, MAX_ROWS)\n    max_height = min(MAX_BAR_HEIGHT, rows)\n    n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)\n    max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)\n    red_total = random.randint(MIN_RED_BARS, max_red)\n    min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)\n    max_unchained = min(MAX_UNCHAINED_RED, red_total)\n    n_unchained = random.randint(min_unchained, max_unchained)\n\n    distributions = _chain_red_distributions(n_blue, red_total - n_unchained)\n    if not distributions:\n        return None\n\n    groups = [\n        {\"kind\": \"chain\", \"colors\": [MARKER_COLOR] + [BODY_COLOR] * n_red}\n        for n_red in random.choice(distributions)\n    ]\n    groups.extend({\"kind\": \"unchained\", \"colors\": [BODY_COLOR]} for _ in range(n_unchained))\n    random.shuffle(groups)\n    if groups[0][\"kind\"] == \"unchained\":\n        for i, group in enumerate(groups):\n            if group[\"kind\"] == \"chain\":\n                groups[0], groups[i] = groups[i], groups[0]\n                break\n    return rows, max_height, groups\n\n\ndef _sample_layout(max_height, groups):\n    \"\"\"Sample gaps, heights, margins, and positioned bar columns.\"\"\"\n    n_bars = sum(len(group[\"colors\"]) for group in groups)\n    right_margin = random.randint(0, MAX_RIGHT_MARGIN)\n\n    gap_count = len(groups) - 1\n    if gap_count:\n        max_gap_sum = MAX_WIDTH - right_margin - MIN_BAR_HEIGHT * n_bars\n        gap_options = _bounded_tuples(GAP_VALUES, gap_count, max_gap_sum)\n        if not gap_options:\n            return None\n        gaps = list(random.choice(gap_options))\n    else:\n        gaps = []\n\n    height_options = _bounded_tuples(\n        tuple(range(MIN_BAR_HEIGHT, max_height + 1)),\n        n_bars,\n        MAX_WIDTH - right_margin - sum(gaps),\n    )\n    if not height_options:\n        return None\n    heights = list(random.choice(height_options))\n\n    idx = 0\n    for group in groups:\n        count = len(group[\"colors\"])\n        group[\"heights\"] = heights[idx : idx + count]\n        idx += count\n\n    span = sum(heights) + sum(gaps)\n    min_left = max(0, MIN_WIDTH - right_margin - span)\n    max_left = MAX_WIDTH - right_margin - span\n    if min_left > max_left:\n        return None\n    if min_left <= min(MAX_RANDOM_LEFT_MARGIN, max_left):\n        left_margin = random.randint(min_left, min(MAX_RANDOM_LEFT_MARGIN, max_left))\n    else:\n        left_margin = min_left\n\n    width = left_margin + span + right_margin\n    if not (MIN_WIDTH <= width <= MAX_WIDTH):\n        return None\n\n    bars = []\n    col = left_margin\n    gap_i = 0\n    for group_i, group in enumerate(groups):\n        chained = group[\"kind\"] == \"chain\"\n        for color, height in zip(group[\"colors\"], group[\"heights\"]):\n            bars.append(\n                {\n                    \"color\": color,\n                    \"height\": height,\n                    \"col\": col,\n                    \"chained\": chained,\n                }\n            )\n            col += height\n        if group_i + 1 < len(groups):\n            col += gaps[gap_i]\n            gap_i += 1\n\n    if col + right_margin != width:\n        return None\n    return bars, width\n\n\ndef _render_pair(rows, width, bars):\n    \"\"\"Render the sampled input grid and its expected transformed output.\"\"\"\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/9b30e358.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/9b30e358.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import get_bg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Repeat the bottom foreground motif upward until it fills the whole grid.\n\n    Input structure\n    - The background is the dominant color.\n    - The only foreground pixels occupy a contiguous block of rows at the bottom.\n    - That bottom block is the complete vertical motif, including its background cells.\n\n    Rule\n    - Copy the bottom motif rows repeatedly upward across the full grid.\n    - Preserve horizontal alignment and vertical phase: the original first motif row remains at its input row.\n    - The output shape is unchanged.\n\n    Key insight\n    The blank rows above the bottom foreground block are missing repetitions of the same row motif, not empty space.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    row_has_fg = np.any(g != bg, axis=1)\n    assert np.any(row_has_fg), \"expected a bottom foreground motif\"\n    top = int(np.flatnonzero(row_has_fg)[0])\n    assert top > 0, \"expected background rows above the motif\"\n    assert np.all(row_has_fg[top:]), \"motif rows must be contiguous through the bottom\"\n\n    motif = g[top:].copy()\n    motif_h = int(motif.shape[0])\n\n    out = np.empty_like(g)\n    for r in range(g.shape[0]):\n        out[r] = motif[(int(r) - top) % motif_h]\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and motif size bounds.\nHEIGHT_RANGE = (8, 14)\nWIDTH_RANGE = (5, 9)\nMOTIF_H_RANGE = (3, 6)\n# Foreground support and density limits.\nBBOX_W_RANGE = (3, 5)\nFG_DENSITY_RANGE = (0.30, 0.50)\n# Generation retry limit.\nMAX_ATTEMPTS = 300\n\ndef _sample_dims(rng) -> tuple[int, int, int, int] | None:\n    \"\"\"Return height, width, blank rows, and motif height.\"\"\"\n    motif_h = int(rng.integers(MOTIF_H_RANGE[0], MOTIF_H_RANGE[1] + 1))\n    min_h = max(HEIGHT_RANGE[0], motif_h * 2)\n    if min_h > HEIGHT_RANGE[1]:\n        return None\n    height = int(rng.integers(min_h, HEIGHT_RANGE[1] + 1))\n    width = int(rng.integers(WIDTH_RANGE[0], WIDTH_RANGE[1] + 1))\n    return height, width, height - motif_h, motif_h\n\ndef _sample_fg_cells(rng, motif_h: int, width: int, bbox_w: int) -> set[tuple[int, int]] | None:\n    \"\"\"Choose bbox-local cells while forcing every row and both bbox edges.\"\"\"\n    min_fg = max(motif_h, int(np.ceil(FG_DENSITY_RANGE[0] * motif_h * width)))\n    max_fg = min(motif_h * bbox_w, int(np.floor(FG_DENSITY_RANGE[1] * motif_h * width)))\n    if max_fg < min_fg:\n        return None\n    target_fg = int(rng.integers(min_fg, max_fg + 1))\n    selected = {(int(rng.integers(0, motif_h)), 0), (int(rng.integers(0, motif_h)), bbox_w - 1)}\n    for r in range(motif_h):\n        if not any(rr == r for rr, _ in selected):\n            selected.add((r, int(rng.integers(0, bbox_w))))\n    if len(selected) > target_fg:\n        return None\n    remaining = [\n        (r, c)\n        for r in range(motif_h)\n        for c in range(bbox_w)\n        if (r, c) not in selected\n    ]\n    need = target_fg - len(selected)\n    if need:\n        for i in rng.choice(len(remaining), size=need, replace=False):\n            selected.add(remaining[int(i)])\n    return selected\n\ndef _paint_motif(rng, motif_h: int, width: int, c0: int, selected: set[tuple[int, int]], bg: int, fg_colors: list[int]) -> np.ndarray:\n    \"\"\"Render selected bbox-local cells into a full-width motif.\"\"\"\n    motif = np.full((motif_h, width), bg, dtype=int)\n    coords = list(selected)\n    coords = [coords[int(i)] for i in rng.permutation(len(coords))]\n    for i, (r, c) in enumerate(coords):\n        if i == 0:\n            color = fg_colors[0]\n        elif i == 1:\n            color = fg_colors[1]\n        else:\n            color = int(rng.choice(fg_colors))\n        motif[r, c0 + c] = color\n    return motif\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n    dims = _sample_dims(rng)\n    if dims is None:\n        return None\n    height, width, blank_rows, motif_h = dims\n    colors = rng.choice(np.arange(10), size=3, replace=False)\n    bg = int(colors[0])\n    fg_colors = [int(colors[1]), int(colors[2])]\n    bbox_w = int(rng.integers(BBOX_W_RANGE[0], min(BBOX_W_RANGE[1], width) + 1))\n    c0 = int(rng.integers(0, width - bbox_w + 1))\n    selected = _sample_fg_cells(rng, motif_h, width, bbox_w)\n    if selected is None:\n        return None\n    motif = _paint_motif(rng, motif_h, width, c0, selected, bg, fg_colors)\n    expected = motif[(np.arange(height) - blank_rows) % motif_h]\n    inp = expected.copy()\n    inp[:blank_rows] = bg\n    if np.array_equal(main(inp), expected):\n        return inp\n    return None\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 9b30e358 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/7e2bad24.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/7e2bad24.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, find_components, get_bg, in_bounds\nimport random\n\n\ndef _coord_set(coords: np.ndarray) -> set[tuple[int, int]]:\n    return {tuple(map(int, rc)) for rc in coords}\n\n\ndef _is_contiguous_diagonal(coords: set[tuple[int, int]]) -> bool:\n    if len(coords) < 2:\n        return False\n\n    if len({r - c for r, c in coords}) == 1:\n        rows = sorted(r for r, _c in coords)\n        cols = sorted(c for _r, c in coords)\n    elif len({r + c for r, c in coords}) == 1:\n        rows = sorted(r for r, _c in coords)\n        cols = sorted(c for _r, c in coords)\n    else:\n        return False\n\n    return (\n        rows == list(range(rows[0], rows[-1] + 1))\n        and cols == list(range(cols[0], cols[-1] + 1))\n        and len(coords) == rows[-1] - rows[0] + 1\n    )\n\n\ndef _ray_seed(g: np.ndarray, bg: int) -> tuple[int, set[tuple[int, int]]]:\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    candidates: list[tuple[int, set[tuple[int, int]]]] = []\n    for comp in comps:\n        coords = _coord_set(comp[\"coords\"])\n        if _is_contiguous_diagonal(coords):\n            candidates.append((int(comp[\"color\"]), coords))\n\n    assert len(candidates) == 1, \"expected one diagonal ray seed\"\n    return candidates[0]\n\n\ndef _initial_state(\n    shape: tuple[int, int], coords: set[tuple[int, int]]\n) -> tuple[int, int, int, int]:\n    if len({r - c for r, c in coords}) == 1:\n        first = min(coords)\n        last = max(coords)\n        endpoints = ((first, (-1, -1)), (last, (1, 1)))\n    else:\n        assert len({r + c for r, c in coords}) == 1, \"ray seed must be diagonal\"\n        top = min(coords)\n        bottom = max(coords)\n        endpoints = ((top, (-1, 1)), (bottom, (1, -1)))\n\n    candidates = []\n    for (r, c), (dr, dc) in endpoints:\n        if in_bounds(shape, r + dr, c + dc):\n            candidates.append((r, c, dr, dc))\n\n    assert len(candidates) == 1, \"ray seed must have exactly one in-bounds extension\"\n    return candidates[0]\n\n\ndef _mirror_orientations(g: np.ndarray, bg: int) -> dict[tuple[int, int], str]:\n    orientations: dict[tuple[int, int], str] = {}\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[Color.RED])\n    for comp in comps:\n        coords = _coord_set(comp[\"coords\"])\n        rows = sorted({r for r, _c in coords})\n        cols = sorted({c for _r, c in coords})\n\n        if len(rows) == 1:\n            assert cols == list(range(cols[0], cols[-1] + 1)), \"red mirror must be contiguous\"\n            orientation = \"horizontal\"\n        elif len(cols) == 1:\n            assert rows == list(range(rows[0], rows[-1] + 1)), \"red mirror must be contiguous\"\n            orientation = \"vertical\"\n        else:\n            raise AssertionError(\"red mirror must be a horizontal or vertical segment\")\n\n        for rc in coords:\n            orientations[rc] = orientation\n\n    return orientations\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extend the diagonal blue ray through the grid, reflecting it off red line-segment mirrors.\n\n    Input structure\n    - Black-background grid with one diagonal 8-connected blue ray seed.\n    - Red foreground objects, when present, are straight horizontal or vertical mirror segments.\n    - Other foreground bars are transparent to the ray and may be overwritten where the ray crosses them.\n\n    Rule\n    - Start from the ray seed endpoint whose outward diagonal extension remains inside the grid.\n    - Paint the ray continuously in that diagonal direction until it leaves the grid.\n    - If the next cell is a red mirror, do not paint it; reflect by flipping the row direction on a horizontal mirror or the column direction on a vertical mirror.\n\n    Key insight\n    - The non-red bars are decoys: only red bars reflect the diagonal path, while all other crossed cells become blue.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    ray_color, seed = _ray_seed(g, bg)\n    r, c, dr, dc = _initial_state(g.shape, seed)\n    mirrors = _mirror_orientations(g, bg)\n\n    out = g.copy()\n    seen: set[tuple[int, int, int, int]] = set()\n    while True:\n        state = (r, c, dr, dc)\n        assert state not in seen, \"ray path must not loop\"\n        seen.add(state)\n\n        nr, nc = r + dr, c + dc\n        if not in_bounds(g.shape, nr, nc):\n            break\n\n        if int(g[nr, nc]) == Color.RED:\n            orientation = mirrors.get((nr, nc))\n            assert orientation is not None, \"red cell must belong to a mirror segment\"\n            if orientation == \"horizontal\":\n                dr = -dr\n            else:\n                assert orientation == \"vertical\"\n                dc = -dc\n            continue\n\n        out[nr, nc] = ray_color\n        r, c = nr, nc\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and color layout.\nGRID_HEIGHT = 16\nGRID_WIDTH = 16\nBACKGROUND_COLOR = 0\n\n# Ray and seed sampling ranges.\nREFLECTION_COUNT_RANGE = (0, 4)\nSEED_LENGTH_RANGE = (3, 6)\nTOTAL_PATH_LENGTH_RANGE = (15, 16)\nNEW_CELLS_RANGE = (9, 13)\nDIAGONAL_CHOICES = (-1, 1)\nSTART_EDGES = (\"top\", \"bottom\", \"left\", \"right\")\n\n# Bar structure ranges and orientations.\nBAR_LENGTH_RANGE = (4, 14)\nMIRROR_ORIENTATIONS = [\"horizontal\", \"vertical\"]\nDECOY_COUNT_RANGE = (0, 3)\nDECOY_PLACEMENT_ATTEMPTS = 30\n\n# Rejection sampling budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _inside(r: int, c: int) -> bool:\n    return 0 <= r < GRID_HEIGHT and 0 <= c < GRID_WIDTH\n\n\ndef _random_start_state() -> tuple[int, int, int, int]:\n    \"\"\"Choose a boundary cell with a diagonal direction whose backward extension is OOB.\"\"\"\n    edge = random.choice(START_EDGES)\n    if edge == \"top\":\n        return 0, random.randint(0, GRID_WIDTH - 1), 1, random.choice(DIAGONAL_CHOICES)\n    if edge == \"bottom\":\n        return (\n            GRID_HEIGHT - 1,\n            random.randint(0, GRID_WIDTH - 1),\n            -1,\n            random.choice(DIAGONAL_CHOICES),\n        )\n    if edge == \"left\":\n        return random.randint(0, GRID_HEIGHT - 1), 0, random.choice(DIAGONAL_CHOICES), 1\n    return (\n        random.randint(0, GRID_HEIGHT - 1),\n        GRID_WIDTH - 1,\n        random.choice(DIAGONAL_CHOICES),\n        -1,\n    )\n\n\ndef _build_seed_cells(\n    r0: int,\n    c0: int,\n    dr: int,\n    dc: int,\n    seed_len: int,\n) -> list[tuple[int, int]] | None:\n    cells = []\n    for i in range(seed_len):\n        sr, sc = r0 + i * dr, c0 + i * dc\n        if not _inside(sr, sc):\n            return None\n        cells.append((sr, sc))\n    return cells\n\n\ndef _split_path_segments(new_cells_needed: int, n_reflections: int) -> list[int] | None:\n    \"\"\"Partition painted cells across straight ray segments before each reflection.\"\"\"\n    if n_reflections == 0:\n        return [new_cells_needed]\n    if new_cells_needed < n_reflections + 1:\n        return None\n\n    cuts = sorted(random.sample(range(1, new_cells_needed), n_reflections))\n    segments = []\n    prev = 0\n    for cut in cuts:\n        segments.append(cut - prev)\n        prev = cut\n    segments.append(new_cells_needed - prev)\n    return segments\n","exit_code":0,"status":"completed"}}
