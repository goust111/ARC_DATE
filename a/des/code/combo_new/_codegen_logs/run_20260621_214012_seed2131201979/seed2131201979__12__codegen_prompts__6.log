{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg, is_contiguous, object_interior\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n\n    Input structure:\n    - The grid has a dominant background color.\n    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n\n    Rule:\n    - Keep the input pixels unchanged.\n    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n\n    Key insight:\n    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    out = g.copy()\n    h, w = g.shape\n\n    markers: dict[int, int] = {}\n    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n            continue\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n        source = int(sub[0, 0])\n        halo = int(sub[0, 1])\n        assert source != halo, \"legend source and halo colors must differ\"\n        assert source not in markers, \"each source color must have exactly one legend marker\"\n\n        markers[source] = halo\n        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n\n    assert markers, \"expected at least one left-edge legend marker\"\n\n    for source, halo in markers.items():\n        objects = []\n        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n            if cells <= marker_source_cells[source]:\n                continue\n            objects.append(comp)\n        assert objects, \"each legend source color must label at least one non-marker object\"\n\n        for obj in objects:\n            r0, c0, r1, c1 = obj[\"bbox\"]\n            pr0 = max(0, int(r0) - 1)\n            pc0 = max(0, int(c0) - 1)\n            pr1 = min(h - 1, int(r1) + 1)\n            pc1 = min(w - 1, int(c1) + 1)\n\n            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n            coords = obj[\"coords\"]\n            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n            enclosed = object_interior(patch, background=bg)\n            fill_mask = (patch == bg) & ~enclosed\n\n            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n            target[fill_mask] = halo\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and color palette.\nBACKGROUND = 0\nGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\nAVAILABLE_COLORS = tuple(range(1, 10))\n\n# Legend layout.\nLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\nLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n\n# Sprite geometry and acceptance.\nSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\nSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\nSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\nSPRITE_RETRIES = 300\n\n# Object counts and placement.\nINSTANCE_MIN, INSTANCE_MAX = 1, 3\nOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\nEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\nPLACEMENT_RETRIES = 200\n\n# Whole-sample retry budget.\nGENERATION_RETRIES = 300\n\n\ndef _make_sprite(color):\n    \"\"\"Construct one LR-symmetric 4-connected sprite matching the configured area/hole bounds.\"\"\"\n    target_area = random.randint(SPRITE_AREA_MIN, SPRITE_AREA_MAX)\n    for _ in range(SPRITE_RETRIES):\n        fill_p = target_area / (SPRITE_SIZE * SPRITE_SIZE) + random.uniform(-SPRITE_FILL_JITTER, SPRITE_FILL_JITTER)\n        sprite = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=int)\n        for r in range(SPRITE_SIZE):\n            for c in range(SPRITE_MIRROR_COLS):\n                if random.random() < fill_p:\n                    sprite[r, c] = color\n                    sprite[r, SPRITE_SIZE - 1 - c] = color\n        area = int(np.count_nonzero(sprite))\n        if area != target_area:\n            continue\n        if not is_contiguous(sprite, background=BACKGROUND, connectivity=4):\n            continue\n        if not (np.any(sprite[0] != BACKGROUND) and np.any(sprite[-1] != BACKGROUND) and\n                np.any(sprite[:, 0] != BACKGROUND) and np.any(sprite[:, -1] != BACKGROUND)):\n            continue\n        padded = np.zeros((SPRITE_SIZE + 2, SPRITE_SIZE + 2), dtype=int)\n        padded[1:-1, 1:-1] = sprite\n        interior = object_interior(padded, background=BACKGROUND)\n        holes = int(np.sum(interior & (padded == BACKGROUND)))\n        if holes > MAX_INTERIOR_HOLES:\n            continue\n        return sprite\n    return None\n\n\ndef _boxes_overlap(a, b):\n    return a[0] <= b[2] and a[2] >= b[0] and a[1] <= b[3] and a[3] >= b[1]\n\n\ndef _draw_legend(grid, src1, halo1, src2, halo2):\n    lower_top = grid.shape[0] - LEGEND_MARKER_SIZE\n    upper_top = lower_top - LEGEND_VERTICAL_GAP - LEGEND_MARKER_SIZE\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src1\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo1\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src2\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo2\n    return (upper_top, LEGEND_SOURCE_COL, grid.shape[0] - 1, LEGEND_HALO_COL)\n\n\ndef _visible_window(sprite, size, r0, c0):\n    \"\"\"Return the visible grid bbox and matching sprite slice for a possibly clipped sprite.\"\"\"\n    vr0, vc0 = max(0, r0), max(0, c0)\n    vr1 = min(size - 1, r0 + SPRITE_SIZE - 1)\n    vc1 = min(size - 1, c0 + SPRITE_SIZE - 1)\n    visible = sprite[vr0 - r0:vr1 - r0 + 1, vc0 - c0:vc1 - c0 + 1]\n    return (vr0, vc0, vr1, vc1), visible\n\n\ndef _padded_bbox(visible_box, size):\n    vr0, vc0, vr1, vc1 = visible_box\n    return (max(0, vr0 - HALO_PADDING), max(0, vc0 - HALO_PADDING),\n            min(size - 1, vr1 + HALO_PADDING), min(size - 1, vc1 + HALO_PADDING))\n\n\ndef _place_objects(size, tasks, legend_box):\n    \"\"\"Choose non-overlapping object origins; returns placement tuples or None on retry exhaustion.\"\"\"\n    placed = []\n    placements = []\n    for sprite, sc, hc in tasks:\n        for _ in range(PLACEMENT_RETRIES):\n            if random.random() < EDGE_CLIP_PROB:\n                r0 = random.randint(-EDGE_CLIP_MARGIN, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n            else:\n                r0 = random.randint(0, size - SPRITE_SIZE)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE)\n            visible_box, visible = _visible_window(sprite, size, r0, c0)\n            if np.count_nonzero(visible) == 0:\n                continue\n\n            pbox = _padded_bbox(visible_box, size)\n            if (pbox[1] < OBJECT_MIN_COL or _boxes_overlap(pbox, legend_box) or\n                    any(_boxes_overlap(pbox, eb) for eb in placed)):\n                continue\n\n            placed.append(pbox)\n            placements.append((sprite, sc, hc, r0, c0))\n            break\n        else:\n            return None\n    return placements\n\n\ndef _render_output(grid, placements):\n    \"\"\"Render the paired output and return the generated input with halo-fill cells removed.\"\"\"\n    size = grid.shape[0]\n    output = grid.copy()\n    halo_mask = np.zeros((size, size), dtype=bool)\n\n    for sprite, sc, hc, r0, c0 in placements:\n        visible_box, visible = _visible_window(sprite, size, r0, c0)\n        vr0, vc0, vr1, vc1 = visible_box\n        output_region = output[vr0:vr1 + 1, vc0:vc1 + 1]\n        output_region[visible != BACKGROUND] = sc\n\n        pr0, pc0, pr1, pc1 = _padded_bbox(visible_box, size)\n        patch = np.zeros((pr1 - pr0 + 1, pc1 - pc0 + 1), dtype=int)\n        patch_region = patch[vr0 - pr0:vr1 - pr0 + 1, vc0 - pc0:vc1 - pc0 + 1]\n        patch_region[visible != BACKGROUND] = sc\n\n        enclosed = object_interior(patch, background=BACKGROUND)\n        fill = (patch == BACKGROUND) & ~enclosed\n        output_region = output[pr0:pr1 + 1, pc0:pc1 + 1]\n        output_region[fill] = hc\n        halo_region = halo_mask[pr0:pr1 + 1, pc0:pc1 + 1]\n        halo_region[fill] = True\n\n    inp = output.copy()\n    inp[halo_mask] = BACKGROUND\n    return inp, output\n\n\ndef _matches_oracle(inp, output):\n    try:\n        return np.array_equal(main(inp), output)\n    except Exception:\n        return False\n\n\ndef _gen_attempt():\n    sz = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    colors = list(AVAILABLE_COLORS)\n    random.shuffle(colors)\n    src1, halo1, src2, halo2 = colors[:4]\n\n    sprite1 = _make_sprite(src1)\n    sprite2 = _make_sprite(src2)\n    if sprite1 is None or sprite2 is None:\n        return None\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/84ba50d3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/84ba50d3.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _divider_row(g: np.ndarray, bg: int) -> tuple[int, int]:\n    rows: list[tuple[int, int]] = []\n    for r in range(g.shape[0]):\n        row_colors = set(map(int, g[r]))\n        if len(row_colors) == 1:\n            color = next(iter(row_colors))\n            if int(color) != int(bg):\n                rows.append((int(r), int(color)))\n    assert len(rows) == 1, \"expected exactly one solid non-background divider row\"\n    return rows[0]\n\n\ndef _unique_widest_row(coords: np.ndarray) -> int:\n    row_counts: list[tuple[int, int]] = []\n    for r in sorted(set(map(int, coords[:, 0]))):\n        row_cols = np.sort(coords[coords[:, 0] == r, 1])\n        assert np.array_equal(row_cols, np.arange(int(row_cols[0]), int(row_cols[-1]) + 1))\n        row_counts.append((int(row_cols.size), int(r)))\n\n    max_count = max(count for count, _r in row_counts)\n    widest = [r for count, r in row_counts if count == max_count]\n    assert max_count > 1, \"multi-column sprites must have a horizontal span\"\n    assert len(widest) == 1, \"expected a unique widest horizontal row\"\n    return int(widest[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the blue sprites downward relative to the red divider, with vertical sprites passing through to the bottom.\n\n    Input structure:\n    - The background is the dominant color.\n    - One non-background color forms a single full-width horizontal divider row.\n    - The other non-background color forms 4-connected sprites above the divider.\n\n    Rule:\n    - Clear the original sprite pixels.\n    - A one-column sprite falls to the bottom of its column and deletes the divider\n      pixel it crossed.\n    - Any wider sprite falls until its unique widest horizontal row is immediately\n      above the divider row; if the moved sprite overlaps the divider, it covers it.\n\n    Key insight:\n    The red row is not a generic floor: only one-column sprites pass through to the\n    bottom, while wider sprites are registered by their widest horizontal segment.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n    line_r, line_color = _divider_row(g, bg)\n\n    non_bg_colors = set(map(int, g.ravel())) - {bg}\n    sprite_colors = non_bg_colors - {line_color}\n    assert len(sprite_colors) == 1, \"expected exactly one sprite color\"\n    sprite_color = next(iter(sprite_colors))\n\n    sprites = find_components(\n        g,\n        bg=bg,\n        colors=[sprite_color],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert sprites, \"expected at least one sprite\"\n\n    out = g.copy()\n    out[g == sprite_color] = bg\n    occupied = np.zeros((H, W), dtype=bool)\n\n    for sprite in sprites:\n        coords = sprite[\"coords\"]\n        _r0, c0, r1, c1 = map(int, sprite[\"bbox\"])\n        assert r1 < line_r, \"all sprites must begin above the divider\"\n\n        if c0 == c1:\n            shift = H - 1 - r1\n            assert shift >= 0\n            assert int(out[line_r, c0]) == line_color\n            out[line_r, c0] = bg\n        else:\n            widest_r = _unique_widest_row(coords)\n            shift = line_r - 1 - widest_r\n            assert shift >= 0\n\n        moved = coords.copy()\n        moved[:, 0] += shift\n        assert np.all((0 <= moved[:, 0]) & (moved[:, 0] < H))\n        assert np.all((0 <= moved[:, 1]) & (moved[:, 1] < W))\n\n        for rr, cc in moved:\n            r = int(rr)\n            c = int(cc)\n            assert not occupied[r, c], \"moved sprites must not overlap\"\n            occupied[r, c] = True\n            out[r, c] = sprite_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, palette, and divider bounds.\nMIN_GRID_SIZE, LARGE_GRID_MIN, MAX_GRID_SIZE = 7, 14, 18\nLARGE_GRID_PROB, PALETTE_SIZE, DIVIDER_MARGIN = 0.35, 10, 3\nADJACENT_ROW_OFFSET = 1\n\n# Sprite counts, spacing, and retry limits.\nMIN_SPRITE_COUNT, MAX_SPRITE_COUNT = 1, 5\nMAX_SINGLE_SPRITES, MAX_MULTI_SPRITES = 2, 3\nGAP_COLUMNS, INPUT_GAP_TO_DIVIDER = 1, 1\nGENERATION_RETRIES = 300\n\n# Sprite geometry.\nMIN_SPRITE_HEIGHT, MAX_SINGLE_HEIGHT, MAX_MULTI_HEIGHT = 1, 7, 5\nSINGLE_WIDTH, MIN_MULTI_WIDTH, MAX_MULTI_WIDTH = 1, 2, 3\nWIDE_MULTI_PROB = 0.5\n\n\ndef _composition(total: int, parts: int) -> list[int]:\n    shares = [0] * parts\n    for _ in range(total):\n        shares[random.randrange(parts)] += 1\n    return shares\n\n\ndef _min_layout_width(n_single: int, n_multi: int) -> int:\n    n = n_single + n_multi\n    return n_single * SINGLE_WIDTH + MIN_MULTI_WIDTH * n_multi + GAP_COLUMNS * max(0, n - 1)\n\n\ndef _count_pairs(width: int) -> list[tuple[int, int]]:\n    pairs: list[tuple[int, int]] = []\n    for n_single in range(MAX_SINGLE_SPRITES + 1):\n        for n_multi in range(MAX_MULTI_SPRITES + 1):\n            n = n_single + n_multi\n            if MIN_SPRITE_COUNT <= n <= MAX_SPRITE_COUNT and _min_layout_width(n_single, n_multi) <= width:\n                pairs.append((n_single, n_multi))\n    return pairs\n\n\ndef _place_intervals(widths: list[int], grid_width: int) -> list[int]:\n    n = len(widths)\n    base = sum(widths) + GAP_COLUMNS * max(0, n - 1)\n    extra = grid_width - base\n    assert extra >= 0\n    gaps = _composition(extra, n + 1)\n\n    starts: list[int] = []\n    c = gaps[0]\n    for i, width in enumerate(widths):\n        starts.append(c)\n        c += width\n        if i < n - 1:\n            c += GAP_COLUMNS + gaps[i + 1]\n    return starts\n\n\ndef _multi_coords(top: int, left: int, height: int, width: int, bar_row: int, spine_col: int) -> np.ndarray:\n    coords = {(top + r, left + spine_col) for r in range(height)}\n    coords.update((top + bar_row, left + c) for c in range(width))\n    return np.array(sorted(coords), dtype=int)\n\n\ndef _build_descriptors(n_single: int, n_multi: int, max_single_h: int, max_multi_h: int, grid_width: int) -> list[dict[str, int | str]]:\n    descriptors: list[dict[str, int | str]] = []\n    for _ in range(n_single):\n        descriptors.append(\n            {\"kind\": \"single\", \"width\": SINGLE_WIDTH, \"height\": random.randint(MIN_SPRITE_HEIGHT, max_single_h)}\n        )\n\n    extra_width = grid_width - _min_layout_width(n_single, n_multi)\n    for _ in range(n_multi):\n        width = MIN_MULTI_WIDTH\n        if extra_width > 0 and random.random() < WIDE_MULTI_PROB:\n            width = MAX_MULTI_WIDTH\n            extra_width -= MAX_MULTI_WIDTH - MIN_MULTI_WIDTH\n        height = random.randint(MIN_SPRITE_HEIGHT, max_multi_h)\n        descriptors.append(\n            {\n                \"kind\": \"multi\",\n                \"width\": width,\n                \"height\": height,\n                \"bar_row\": random.randint(0, height - ADJACENT_ROW_OFFSET),\n                \"spine_col\": random.randrange(width),\n            }\n        )\n\n    random.shuffle(descriptors)\n    return descriptors\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(LARGE_GRID_MIN, MAX_GRID_SIZE) if random.random() < LARGE_GRID_PROB else random.randint(MIN_GRID_SIZE, MAX_GRID_SIZE)\n    W = H\n    bg, divider_color, sprite_color = random.sample(range(PALETTE_SIZE), 3)\n    divider_choices = list(range(DIVIDER_MARGIN, H - DIVIDER_MARGIN))\n    divider_weights = [min(r - ADJACENT_ROW_OFFSET, H - r - ADJACENT_ROW_OFFSET) for r in divider_choices]\n    divider_r = random.choices(divider_choices, weights=divider_weights, k=1)[0]\n\n    pairs = _count_pairs(W)\n    if not pairs:\n        return None\n    n_single, n_multi = random.choice(pairs)\n\n    max_single_h = min(MAX_SINGLE_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER, H - divider_r - ADJACENT_ROW_OFFSET)\n    max_multi_h = min(MAX_MULTI_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER)\n    if (n_single and max_single_h < MIN_SPRITE_HEIGHT) or (n_multi and max_multi_h < MIN_SPRITE_HEIGHT):\n        return None\n\n    descriptors = _build_descriptors(n_single, n_multi, max_single_h, max_multi_h, W)\n    starts = _place_intervals([int(d[\"width\"]) for d in descriptors], W)\n\n    inp = np.full((H, W), bg, dtype=int)\n    out = np.full((H, W), bg, dtype=int)\n    inp[divider_r, :] = divider_color\n    out[divider_r, :] = divider_color\n\n    input_max_bottom = divider_r - INPUT_GAP_TO_DIVIDER - ADJACENT_ROW_OFFSET\n    for desc, left in zip(descriptors, starts):\n        height = int(desc[\"height\"])\n        width = int(desc[\"width\"])\n        if desc[\"kind\"] == \"single\":\n            col = left\n            out[divider_r, col] = bg\n            out[H - height : H, col] = sprite_color\n\n            input_bottom = random.randint(height - ADJACENT_ROW_OFFSET, input_max_bottom)\n            inp[input_bottom - height + ADJACENT_ROW_OFFSET : input_bottom + ADJACENT_ROW_OFFSET, col] = sprite_color\n            continue\n\n        bar_row = int(desc[\"bar_row\"])\n        spine_col = int(desc[\"spine_col\"])\n        landed_top = divider_r - ADJACENT_ROW_OFFSET - bar_row\n","exit_code":0,"status":"completed"}}
