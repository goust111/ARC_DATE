{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/221dfab4.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import get_bg, label_mask\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Propagate a repeating striped pattern from a yellow border segment toward the opposite edge, recoloring foreground objects on certain stripes.\n\n    Input structure:\n    - bg = most common color. Foreground blobs of another color scattered in the interior.\n    - A short yellow (4) segment sits on one border edge.\n\n    Rule:\n    - From the yellow segment, march toward the opposite edge in steps of 2 cells, cycling colors Y, Y, G (4, 4, 3). The 1-cell gap between stripes is forced to bg.\n    - Yellow stripes paint only within the segment's span.\n    - Green stripes additionally recolor all non-bg pixels across the entire row/column to green.\n\n    Key insight: Green stripes act as a \"flood\" that recolors existing objects on the full row/column, while yellow stripes are confined to the segment span.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n    out = g.copy()\n\n    Y = 4\n    G = 3\n\n    border = np.zeros((H, W), dtype=bool)\n    border[0, :] = True\n    border[-1, :] = True\n    border[:, 0] = True\n    border[:, -1] = True\n\n    smask = (g == int(Y)) & border\n    if not bool(smask.any()):\n        return out\n\n    lab, n = label_mask(smask, connectivity=4)\n    if int(n) <= 0:\n        return out\n\n    best_id = max(range(1, int(n) + 1), key=lambda cid: int((lab == int(cid)).sum()))\n    pts = np.argwhere(lab == int(best_id))\n\n    rs = pts[:, 0]\n    cs = pts[:, 1]\n    r0, r1 = int(rs.min()), int(rs.max())\n    c0, c1 = int(cs.min()), int(cs.max())\n\n    if r0 == r1:\n        orient = \"h\"\n        start_pos = int(r0)\n        cols = sorted(int(c) for c in cs)\n        span = list(range(int(cols[0]), int(cols[-1]) + 1))\n        dir1 = 1 if start_pos == 0 else -1\n        limit = H\n    elif c0 == c1:\n        orient = \"v\"\n        start_pos = int(c0)\n        rows = sorted(int(r) for r in rs)\n        span = list(range(int(rows[0]), int(rows[-1]) + 1))\n        dir1 = 1 if start_pos == 0 else -1\n        limit = W\n    else:\n        # Unexpected: not a straight edge segment.\n        return out\n\n    cycle = [int(Y), int(Y), int(G)]\n\n    step = 0\n    while True:\n        pos = int(start_pos) + int(dir1) * (2 * int(step))\n        if not (0 <= pos < int(limit)):\n            break\n\n        col = int(cycle[int(step) % 3])\n\n        if orient == \"h\":\n            if col == int(G):\n                out[pos, :] = np.where(out[pos, :] != int(bg), int(G), out[pos, :])\n            for c in span:\n                out[pos, int(c)] = col\n            # Force the 1-cell gap to background within the segment span.\n            gap = int(start_pos) + int(dir1) * (2 * int(step) + 1)\n            if 0 <= gap < H:\n                for c in span:\n                    out[int(gap), int(c)] = int(bg)\n        else:\n            if col == int(G):\n                out[:, pos] = np.where(out[:, pos] != int(bg), int(G), out[:, pos])\n            for r in span:\n                out[int(r), pos] = col\n            gap = int(start_pos) + int(dir1) * (2 * int(step) + 1)\n            if 0 <= gap < W:\n                for r in span:\n                    out[int(r), int(gap)] = int(bg)\n\n        step += 1\n\n    return out\n\n\n# --------------- generator ---------------\nimport random\nfrom arc_utils import random_sprite, random_free_location\n\n\ndef _gen_attempt():\n    rng = random.Random()\n\n    H = rng.randint(25, 30)\n    W = rng.randint(22, 30)\n\n    # Pick bg and fg colors (not yellow=4 or green=3)\n    available = [c for c in range(10) if c not in (3, 4)]\n    bg, fg = rng.sample(available, 2)\n\n    # Pick edge and yellow segment\n    edge = rng.choice(['top', 'bottom', 'left', 'right'])\n    seg_len = rng.randint(3, 8)\n\n    if edge in ('top', 'bottom'):\n        # horizontal segment: columns span, must not touch corners (col 0 or W-1)\n        max_start = W - 1 - seg_len  # last col of span = start + seg_len - 1 <= W-2\n        if max_start < 1:\n            return None\n        seg_start = rng.randint(1, max_start)\n        span = list(range(seg_start, seg_start + seg_len))\n        orient = 'h'\n        edge_row = 0 if edge == 'top' else H - 1\n    else:\n        # vertical segment: rows span, must not touch corners (row 0 or H-1)\n        max_start = H - 1 - seg_len\n        if max_start < 1:\n            return None\n        seg_start = rng.randint(1, max_start)\n        span = list(range(seg_start, seg_start + seg_len))\n        orient = 'v'\n        edge_col = 0 if edge == 'left' else W - 1\n\n    # Start with bg grid\n    grid = np.full((H, W), bg, dtype=int)\n\n    # Place yellow segment on border\n    if orient == 'h':\n        for c in span:\n            grid[edge_row, c] = 4\n    else:\n        for r in span:\n            grid[r, edge_col] = 4\n\n    # Determine which rows/cols are on the trajectory (both stripe and gap positions)\n    # to avoid placing blobs on the edge row/col itself\n    if orient == 'h':\n        forbidden_rows = {edge_row}\n    else:\n        forbidden_cols = {edge_col}\n\n    # Scatter 5-9 amorphous fg blobs in the interior\n    n_blobs = rng.randint(5, 9)\n    canvas = grid.copy()\n\n    for _ in range(n_blobs):\n        # Random blob size: aim for 5-67 pixels, bbox dims 2-15\n        bh = rng.randint(2, 10)\n        bw = rng.randint(2, 10)\n        density = rng.uniform(0.4, 0.85)\n\n        try:\n            sprite = random_sprite(bh, bw, density=density, symmetry=\"not_symmetric\",\n                                   color_palette=[fg], connectivity=4, background=bg)\n        except (AssertionError, RecursionError):\n            continue\n\n        # Trim bg border rows/cols from sprite\n        mask = (sprite != bg)\n        rows_any = np.any(mask, axis=1)\n        cols_any = np.any(mask, axis=0)\n        if not rows_any.any():\n            continue\n        r0, r1 = np.where(rows_any)[0][[0, -1]]\n        c0, c1 = np.where(cols_any)[0][[0, -1]]\n        sprite = sprite[r0:r1+1, c0:c1+1]\n\n        sh, sw = sprite.shape\n        pix = int(np.sum(sprite != bg))\n        if pix < 5 or pix > 67:\n            continue\n\n        # Find placement: border=1 to keep away from grid edges, padding=1 for separation\n        try:\n            pr, pc = random_free_location(canvas, sprite, transparent=bg, border=1, padding=1)\n        except ValueError:\n            continue\n\n        # Check forbidden row/col constraints\n        sprite_mask = (sprite != bg)\n        blob_rows = set(int(pr + dr) for dr in range(sh) if sprite_mask[dr].any())\n        blob_cols = set(int(pc + dc) for dc in range(sw) if sprite_mask[:, dc].any())\n\n        if orient == 'h' and blob_rows & forbidden_rows:\n            continue\n        if orient == 'v' and blob_cols & forbidden_cols:\n            continue\n\n        # Paste blob\n        for dr in range(sh):\n            for dc in range(sw):\n                if sprite[dr, dc] != bg:\n                    canvas[pr + dr, pc + dc] = sprite[dr, dc]\n\n    # Count blobs placed\n    fg_mask = (canvas != bg) & (canvas != 4)\n    lab, n_placed = label_mask(fg_mask, connectivity=4)\n    if n_placed < 5:\n        return None\n\n    # Now canvas is our INPUT grid. Build the expected output via solver.\n    inp = canvas.copy()\n    out = main(inp)\n\n    # Verify bg is most common in input\n    if get_bg(inp) != bg:\n        return None\n\n    # Round-trip check\n    if not np.array_equal(main(inp), out):\n        return None\n\n    return inp#.tolist()\n\n\ndef generate_input():\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/d6e50e54.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/d6e50e54.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import Color, bbox_h, bbox_w, find_components, get_bg, in_bounds\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Move each maroon marker toward the blue rectangle and recolor the rectangle red.\n\n    Input structure\n    A background canvas contains one solid blue rectangular object and several isolated\n    maroon marker pixels. Each marker is horizontally or vertically aligned with the\n    rectangle and lies outside it.\n\n    Rule\n    Start with a background canvas, repaint the blue rectangle red, and move each\n    maroon marker straight toward the rectangle along its row or column. Exactly one\n    marker is strictly closer to the rectangle than all others and enters the\n    rectangle boundary; every other marker lands in the adjacent exterior cell just\n    outside its aligned side.\n\n    Key insight\n    The single entering marker is the unique global nearest marker to the rectangle,\n    not the nearest marker on each of the four sides.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    rectangles = []\n    markers = []\n    for comp in components:\n        h = bbox_h(comp[\"bbox\"])\n        w = bbox_w(comp[\"bbox\"])\n        if comp[\"area\"] == h * w and comp[\"area\"] > 1:\n            rectangles.append(comp)\n        elif comp[\"area\"] == 1:\n            markers.append(comp)\n\n    assert len(rectangles) == 1\n    assert markers\n    rect = rectangles[0]\n    rect_color = int(rect[\"color\"])\n    marker_colors = {int(comp[\"color\"]) for comp in markers}\n    assert marker_colors == {Color.MAROON}\n    marker_color = Color.MAROON\n    assert rect_color == Color.BLUE\n    assert set(map(int, g.flat)) == {bg, rect_color, marker_color}\n\n    r0, c0, r1, c1 = map(int, rect[\"bbox\"])\n    h = bbox_h(rect[\"bbox\"])\n    w = bbox_w(rect[\"bbox\"])\n\n    out = np.full_like(g, bg)\n    out[r0 : r1 + 1, c0 : c1 + 1] = Color.RED\n\n    destinations = []\n    marker_entries: list[tuple[int, tuple[int, int], bool]] = []\n    for comp in markers:\n        r, c = map(int, comp[\"coords\"][0])\n        candidates = []\n        if c0 <= c <= c1 and r < r0:\n            d = r0 - r\n            enters = d < h\n            candidates.append((r0 if enters else r0 - 1, c))\n            marker_entries.append((d, (r, c), enters))\n        if c0 <= c <= c1 and r > r1:\n            d = r - r1\n            enters = d < h\n            candidates.append((r1 if enters else r1 + 1, c))\n            marker_entries.append((d, (r, c), enters))\n        if r0 <= r <= r1 and c < c0:\n            d = c0 - c\n            enters = d < w\n            candidates.append((r, c0 if enters else c0 - 1))\n            marker_entries.append((d, (r, c), enters))\n        if r0 <= r <= r1 and c > c1:\n            d = c - c1\n            enters = d < w\n            candidates.append((r, c1 if enters else c1 + 1))\n            marker_entries.append((d, (r, c), enters))\n\n        assert len(candidates) == 1\n        dr, dc = candidates[0]\n        assert in_bounds(g.shape, dr, dc)\n        assert (dr, dc) not in destinations\n        destinations.append((dr, dc))\n\n    min_dist = min(dist for dist, _pos, _enters in marker_entries)\n    nearest = [pos for dist, pos, _enters in marker_entries if dist == min_dist]\n    entering = [pos for _dist, pos, enters in marker_entries if enters]\n    assert len(nearest) == 1, \"the nearest marker to the rectangle must be unique\"\n    assert len(entering) == 1, \"exactly one marker may enter the rectangle\"\n    assert entering[0] == nearest[0], \"the entering marker must be the global nearest\"\n\n    for r, c in destinations:\n        out[r, c] = marker_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\nGRID_SIZE_MIN, GRID_SIZE_MAX = 8, 16\nRECT_SIDE_MIN, RECT_SIDE_MAX = 3, 5\nGRID_TO_RECT_RATIO_MIN, GRID_TO_RECT_RATIO_MAX = 2, 4\nMARKER_COUNT_MAX = 7\nSIDE_COUNT_MIN, SIDE_COUNT_MAX = 2, 4\nMIN_POSITION_SIDES_WITH_MARGIN, MIN_POSITION_MARGIN = 2, 2\nCLOSE_DIST_MIN, DIST_MAX = 2, 7\nKIND_CLOSE, KIND_FAR = \"close\", \"far\"\nBG_COLOR, RECT_INPUT_COLOR, RECT_OUTPUT_COLOR, MARKER_COLOR = 7, 1, 2, 9\nGEN_RETRIES = 300\nSIDE_TOP, SIDE_BOTTOM, SIDE_LEFT, SIDE_RIGHT = \"top\", \"bottom\", \"left\", \"right\"\nHORIZONTAL_SIDES = (SIDE_TOP, SIDE_BOTTOM)\n\ndef _gen_d6e50e54_margins(n, r0, c0, side):\n    r1 = r0 + side - 1\n    c1 = c0 + side - 1\n    return {\n        SIDE_TOP: r0,\n        SIDE_BOTTOM: n - r1 - 1,\n        SIDE_LEFT: c0,\n        SIDE_RIGHT: n - c1 - 1,\n    }\n\ndef _gen_d6e50e54_count_allocations(total, caps):\n    if not caps:\n        return [()] if total == 0 else []\n\n    out = []\n    rest_min = len(caps) - 1\n    rest_max = sum(caps[1:])\n    for first in range(1, caps[0] + 1):\n        remaining = total - first\n        if rest_min <= remaining <= rest_max:\n            for tail in _gen_d6e50e54_count_allocations(remaining, caps[1:]):\n                out.append((first,) + tail)\n    return out\n\ndef _gen_d6e50e54_gap_lane_sets(values, count):\n    out = []\n\n    def rec(start, chosen):\n        if len(chosen) == count:\n            out.append(tuple(chosen))\n            return\n        for i in range(start, len(values)):\n            if chosen and values[i] == chosen[-1] + 1:\n                continue\n            rec(i + 1, chosen + [values[i]])\n\n    rec(0, [])\n    return out\n\ndef _gen_d6e50e54_lanes(values, count, single_distance):\n    if single_distance:\n        choices = _gen_d6e50e54_gap_lane_sets(list(values), count)\n        if not choices:\n            return None\n        return list(random.choice(choices))\n    return random.sample(list(values), count)\n\ndef _gen_d6e50e54_valid_options(margin, side_len):\n    options = []\n    close_max = min(side_len - 1, margin, DIST_MAX)\n    for dist in range(CLOSE_DIST_MIN, close_max + 1):\n        options.append((KIND_CLOSE, dist))\n    if margin >= side_len:\n        for dist in range(side_len, min(margin, DIST_MAX) + 1):\n            options.append((KIND_FAR, dist))\n    return options\n\n\ndef _gen_d6e50e54_side_cap(margin, side_len):\n    if len({dist for _kind, dist in _gen_d6e50e54_valid_options(margin, side_len)}) <= 1:\n        return (side_len + 1) // 2\n    return side_len\n\n\ndef _gen_d6e50e54_coords(side_name, lane, kind, dist, r0, c0, r1, c1):\n    if side_name == SIDE_TOP:\n        dest = (r0 if kind == KIND_CLOSE else r0 - 1, lane)\n        src = (r0 - dist, lane)\n    elif side_name == SIDE_BOTTOM:\n        dest = (r1 if kind == KIND_CLOSE else r1 + 1, lane)\n        src = (r1 + dist, lane)\n    elif side_name == SIDE_LEFT:\n        dest = (lane, c0 if kind == KIND_CLOSE else c0 - 1)\n        src = (lane, c0 - dist)\n    else:\n        dest = (lane, c1 if kind == KIND_CLOSE else c1 + 1)\n        src = (lane, c1 + dist)\n    return dest, src\n\n\ndef _gen_d6e50e54_assign(slots, margins, side_len, r0, c0, r1, c1):\n    random.shuffle(slots)\n\n    def rec(i, close_index, used_dest, used_src, assigned):\n        if i == len(slots):\n            return assigned\n\n        side_name, lane = slots[i]\n        margin = margins[side_name]\n        required_kind = KIND_CLOSE if i == close_index else KIND_FAR\n        options = [\n            option\n            for option in _gen_d6e50e54_valid_options(margin, side_len)\n            if option[0] == required_kind\n        ]\n        random.shuffle(options)\n\n        for kind, dist in options:\n            dest, src = _gen_d6e50e54_coords(\n                side_name, lane, kind, dist, r0, c0, r1, c1\n            )\n            if dest in used_dest or src in used_src:\n                continue\n            if any(abs(src[0] - old[0]) + abs(src[1] - old[1]) == 1 for old in used_src):\n                continue\n            result = rec(\n                i + 1,\n                close_index,\n                used_dest | {dest},\n                used_src | {src},\n                assigned + [(dest, src)],\n            )\n            if result is not None:\n                return result\n        return None\n\n    close_indices = list(range(len(slots)))\n    random.shuffle(close_indices)\n    for close_index in close_indices:\n        result = rec(0, close_index, set(), set(), [])\n        if result is not None:\n            return result\n    return None\n\n\n","exit_code":0,"status":"completed"}}
