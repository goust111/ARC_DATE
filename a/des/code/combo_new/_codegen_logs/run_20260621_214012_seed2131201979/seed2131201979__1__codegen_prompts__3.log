{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/2b83f449.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom arc_utils import get_bg, label_mask\nimport itertools\nfrom arc_utils import paste\nfrom collections import defaultdict\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Simulate tokens falling through a pipe network after gates rotate open.\n\n    Input structure:\n    - Wall (0), bg (pipe fill), gate (horizontal 1×3 bars), token (small edge pixels).\n\n    Rule:\n    - Rotate each gate into a vertical blocker; gate cells become bg.\n    - Tokens drop downward through bg, choosing the extreme column for their side (left→min, right→max).\n    - Tokens settle at true pipe ends (adjacent to wall/boundary), packing inward.\n\n    Key insight: Tokens select drop columns by entry side and land at wall-bounded endpoints, ignoring blocker-bounded ones.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    colors = set(map(int, g.flatten()))\n\n    # --- infer gate color: any color forming 4-ccs of size 3 with bbox 1x3 (horizontal) ---\n    gate = None\n    for col in sorted(colors):\n        if int(col) == 0:\n            continue\n        lab, n = label_mask(g == int(col), connectivity=4)\n        found = False\n        for k in range(1, int(n) + 1):\n            pts = np.argwhere(lab == int(k))\n            if int(pts.shape[0]) != 3:\n                continue\n            r0, c0 = pts.min(axis=0)\n            r1, c1 = pts.max(axis=0)\n            if int(r1 - r0 + 1) == 1 and int(c1 - c0 + 1) == 3:\n                found = True\n                break\n        if found:\n            gate = int(col)\n            break\n    assert not (gate is None)\n\n    # --- token/bg inference ---\n    cnt_all = Counter(map(int, g.flatten()))\n    cand_token = [c for c in colors if int(c) not in (0, int(gate))]\n    assert not (not cand_token)\n    token = int(min(cand_token, key=lambda c: (int(cnt_all[int(c)]), int(c))))\n    cand_bg = [c for c in colors if int(c) not in (0, int(gate), int(token))]\n    assert cand_bg\n    bg = int(max(cand_bg, key=lambda c: (int(cnt_all[int(c)]), -int(c))))\n\n    # --- opened gate color (vertical post) ---\n    open_col = 6 if int(gate) == 7 and 6 not in colors else int(gate - 1) if int(gate) > 0 else 6\n\n    # --- rotate gates (gates open into bg, center becomes vertical open_col) ---\n    out = g.copy()\n    lab, n = label_mask(out == int(gate), connectivity=4)\n    for k in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(k))\n        if int(pts.shape[0]) != 3:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        if int(r1 - r0 + 1) != 1 or int(c1 - c0 + 1) != 3:\n            continue\n        r = int(r0)\n        c0 = int(c0)\n        center_c = int(c0 + 1)\n        out[int(r), int(c0) : int(c0) + 3] = int(bg)\n        for rr in (int(r - 1), int(r), int(r + 1)):\n            if 0 <= int(rr) < H:\n                out[int(rr), int(center_c)] = int(open_col)\n\n    # helpers\n    def segments_in_row(r: int) -> list[tuple[int, int]]:\n        segs: list[tuple[int, int]] = []\n        c = 0\n        while c < W:\n            if int(out[r, c]) != int(bg):\n                c += 1; continue\n            c0 = c\n            while c + 1 < W and int(out[r, c + 1]) == int(bg):\n                c += 1\n            segs.append((c0, c)); c += 1\n        return segs\n\n    def find_seg(segs: list[tuple[int, int]], c: int) -> tuple[int, int] | None:\n        for a, b in segs:\n            if a <= c <= b: return (a, b)\n        return None\n\n    def seg_exit(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single exit column, or None. Assert if >1 exit.\"\"\"\n        a, b = seg\n        if r + 2 >= H: return None\n        drops = [c for c in range(a, b + 1)\n                 if int(out[r + 1, c]) == int(bg) and int(out[r + 2, c]) == int(bg)]\n        assert len(drops) <= 1, f\"segment ({a},{b}) at row {r} has {len(drops)} exits: {drops}\"\n        return drops[0] if drops else None\n\n    def entry_from_above(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single entry column from the wall above, or None. Assert if >1.\"\"\"\n        a, b = seg\n        if r < 2: return None\n        entries = [c for c in range(a, b + 1)\n                   if int(out[r - 1, c]) == int(bg) and int(out[r - 2, c]) == int(bg)]\n        assert len(entries) <= 1, f\"segment ({a},{b}) at row {r} has {len(entries)} entries from above: {entries}\"\n        return entries[0] if entries else None\n\n    # Remove tokens; simulate; re-place.\n    token_pts = [(int(r), int(c)) for r, c in np.argwhere(out == int(token))]\n    out[out == int(token)] = int(bg)\n\n    # Phase 1: each token drops through single exits until stuck.\n    finals: list[tuple[int, int]] = []  # (row, col) of final position\n    for r, c in token_pts:\n        cur_r, cur_c = r, c\n        if int(out[cur_r, cur_c]) != int(bg):\n            finals.append((cur_r, cur_c)); continue\n        while True:\n            seg = find_seg(segments_in_row(cur_r), cur_c)\n            if seg is None: break\n            ex = seg_exit(cur_r, seg)\n            if ex is None: break\n            cur_r += 2; cur_c = ex\n            if cur_r >= H: break\n        finals.append((cur_r, cur_c))\n\n    # Phase 2: pack tokens at opposite end from entry.\n    buckets: dict[tuple[int, tuple[int, int], int], int] = defaultdict(int)\n    for r, c in finals:\n        segs = segments_in_row(r)\n        seg = find_seg(segs, c)\n        if seg is None: continue\n        a, b = seg\n        entry = entry_from_above(r, seg)\n        if entry is not None:\n            # Pack to opposite end from entry\n            pack_end = b if (entry - a) <= (b - entry) else a\n        else:\n            # No entry from above: token at starting position (grid edge), stay put\n            pack_end = a if c <= a else b\n        buckets[(r, seg, pack_end)] += 1\n\n    for (r, (a, b), pack_end), k in buckets.items():\n        if pack_end == a:\n            for i in range(k):\n                if a + i <= b: out[r, a + i] = int(token)\n        else:\n            for i in range(k):\n                if b - i >= a: out[r, b - i] = int(token)\n\n    return out\n\n# --------------- generator (Codex, output-first with spine) ---------------\n\nWALL = 0\nTOKEN = 3\nOPEN = 6\nGATE = 7\nBG = 8\n\n\ndef _build_opened_grid(gates: list[list[int]], holes: list[list[int]], width: int) -> np.ndarray:\n    n_walls = len(gates)\n    height = 2 * n_walls + 1\n    grid = np.full((height, width), WALL, dtype=int)\n\n    for pipe_idx in range(n_walls + 1):\n        r = 2 * pipe_idx\n        grid[r, :] = BG\n        for c in holes[pipe_idx]:\n            grid[r, c] = WALL\n\n    for wall_idx, centers in enumerate(gates):\n        r = 2 * wall_idx + 1\n        for c in centers:\n            grid[r, c - 1] = BG\n            grid[r, c] = OPEN\n            grid[r, c + 1] = BG\n            grid[r - 1, c] = OPEN\n            grid[r + 1, c] = OPEN\n\n    return grid\n\n\ndef _build_input(gates: list[list[int]], holes: list[list[int]], width: int) -> np.ndarray:\n    n_walls = len(gates)\n    height = 2 * n_walls + 1\n    grid = np.full((height, width), WALL, dtype=int)\n    gate_patch = np.full((1, 3), GATE, dtype=int)\n\n    for pipe_idx in range(n_walls + 1):\n        r = 2 * pipe_idx\n        grid[r, :] = BG\n        for c in holes[pipe_idx]:\n            grid[r, c] = WALL\n\n    for wall_idx, centers in enumerate(gates):\n        r = 2 * wall_idx + 1\n        for c in centers:\n            paste(grid, gate_patch, r, c - 1)\n\n    for pipe_idx in range(n_walls):\n        r = 2 * pipe_idx\n        grid[r, 0] = TOKEN\n        grid[r, width - 1] = TOKEN\n\n    return grid\n\n\ndef _segments_in_row(grid: np.ndarray, r: int) -> list[tuple[int, int]]:\n    width = grid.shape[1]\n    segments: list[tuple[int, int]] = []\n    c = 0\n    while c < width:\n        if grid[r, c] != BG:\n            c += 1\n            continue\n        start = c\n        while c + 1 < width and grid[r, c + 1] == BG:\n            c += 1\n        segments.append((start, c))\n        c += 1\n    return segments\n\n\ndef _find_segment(grid: np.ndarray, r: int, c: int) -> tuple[int, int] | None:\n    for seg in _segments_in_row(grid, r):\n        if seg[0] <= c <= seg[1]:\n            return seg\n    return None\n\n\ndef _exits_below(grid: np.ndarray, r: int, seg: tuple[int, int]) -> list[int]:\n    height = grid.shape[0]\n    if r + 2 >= height:\n        return []\n    a, b = seg\n    return [c for c in range(a, b + 1) if grid[r + 1, c] == BG and grid[r + 2, c] == BG]\n\n\ndef _entries_above(grid: np.ndarray, r: int, seg: tuple[int, int]) -> list[int]:\n    if r < 2:\n        return []\n    a, b = seg\n    return [c for c in range(a, b + 1) if grid[r - 1, c] == BG and grid[r - 2, c] == BG]\n\n\ndef _find_issues(grid: np.ndarray) -> list[tuple[int, tuple[int, int], list[int], list[int]]]:\n    height = grid.shape[0]\n    issues: list[tuple[int, tuple[int, int], list[int], list[int]]] = []\n    for r in range(0, height, 2):\n        for seg in _segments_in_row(grid, r):\n            above = _entries_above(grid, r, seg)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport itertools\nimport random\n\n\nMARKER_COLOR = 1\nBODY_COLOR = 2\n\n\ndef _vertical_bars(g: np.ndarray, bg: int) -> list[dict]:\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    bars = []\n    baseline = None\n    for comp in comps:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert c0 == c1\n        coords = comp[\"coords\"]\n        height = r1 - r0 + 1\n        assert comp[\"area\"] == height\n        assert {(int(r), int(c)) for r, c in coords} == {(r, c0) for r in range(r0, r1 + 1)}\n        if baseline is None:\n            baseline = r1\n        else:\n            assert r1 == baseline\n        bars.append(\n            {\n                \"color\": int(comp[\"color\"]),\n                \"col\": int(c0),\n                \"bottom\": int(r1),\n                \"height\": int(height),\n                \"coords\": coords,\n            }\n        )\n\n    assert bars\n    return sorted(bars, key=lambda b: b[\"col\"])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n    Input structure\n    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n    Rule\n    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n    - Red bars that are not reached from a blue marker remain unchanged.\n    Key insight\n    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g))) - {bg}\n    assert colors <= {MARKER_COLOR, BODY_COLOR}\n    assert MARKER_COLOR in colors\n\n    bars = _vertical_bars(g, bg)\n    by_col = {bar[\"col\"]: bar for bar in bars}\n    assert len(by_col) == len(bars)\n\n    baselines = {bar[\"bottom\"] for bar in bars}\n    assert len(baselines) == 1\n    baseline = baselines.pop()\n    out = g.copy()\n    for bar in bars:\n        if bar[\"color\"] != MARKER_COLOR:\n            continue\n\n        group = [bar]\n        current = bar\n        while True:\n            next_col = current[\"col\"] + current[\"height\"]\n            next_bar = by_col.get(next_col)\n            if next_bar is None:\n                break\n            if next_bar[\"color\"] != BODY_COLOR:\n                break\n            group.append(next_bar)\n            current = next_bar\n\n        for item in group:\n            rows = item[\"coords\"][:, 0]\n            cols = item[\"coords\"][:, 1]\n            out[rows, cols] = bg\n\n        for item in group:\n            col = item[\"col\"]\n            height = item[\"height\"]\n            assert col + height <= g.shape[1]\n            out[baseline, col : col + height] = item[\"color\"]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nMIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n\n# Bar and chain structure.\nMIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\nMIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\nMIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n\n# Layout padding and retry budget.\nGAP_VALUES = (1, 2, 3)\nMAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n\n\ndef _chain_red_distributions(n_blue, n_red):\n    \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n    return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n\n\ndef _bounded_tuples(values, n, max_sum):\n    \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n    return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n\n\ndef _sample_groups():\n    \"\"\"Sample row count and bar groups before physical layout.\"\"\"\n    rows = random.randint(MIN_ROWS, MAX_ROWS)\n    max_height = min(MAX_BAR_HEIGHT, rows)\n    n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)\n    max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)\n    red_total = random.randint(MIN_RED_BARS, max_red)\n    min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)\n    max_unchained = min(MAX_UNCHAINED_RED, red_total)\n    n_unchained = random.randint(min_unchained, max_unchained)\n\n    distributions = _chain_red_distributions(n_blue, red_total - n_unchained)\n    if not distributions:\n        return None\n\n    groups = [\n        {\"kind\": \"chain\", \"colors\": [MARKER_COLOR] + [BODY_COLOR] * n_red}\n        for n_red in random.choice(distributions)\n    ]\n    groups.extend({\"kind\": \"unchained\", \"colors\": [BODY_COLOR]} for _ in range(n_unchained))\n    random.shuffle(groups)\n    if groups[0][\"kind\"] == \"unchained\":\n        for i, group in enumerate(groups):\n            if group[\"kind\"] == \"chain\":\n                groups[0], groups[i] = groups[i], groups[0]\n                break\n    return rows, max_height, groups\n\n\ndef _sample_layout(max_height, groups):\n    \"\"\"Sample gaps, heights, margins, and positioned bar columns.\"\"\"\n    n_bars = sum(len(group[\"colors\"]) for group in groups)\n    right_margin = random.randint(0, MAX_RIGHT_MARGIN)\n\n    gap_count = len(groups) - 1\n    if gap_count:\n        max_gap_sum = MAX_WIDTH - right_margin - MIN_BAR_HEIGHT * n_bars\n        gap_options = _bounded_tuples(GAP_VALUES, gap_count, max_gap_sum)\n        if not gap_options:\n            return None\n        gaps = list(random.choice(gap_options))\n    else:\n        gaps = []\n\n    height_options = _bounded_tuples(\n        tuple(range(MIN_BAR_HEIGHT, max_height + 1)),\n        n_bars,\n        MAX_WIDTH - right_margin - sum(gaps),\n    )\n    if not height_options:\n        return None\n    heights = list(random.choice(height_options))\n\n    idx = 0\n    for group in groups:\n        count = len(group[\"colors\"])\n        group[\"heights\"] = heights[idx : idx + count]\n        idx += count\n\n    span = sum(heights) + sum(gaps)\n    min_left = max(0, MIN_WIDTH - right_margin - span)\n    max_left = MAX_WIDTH - right_margin - span\n    if min_left > max_left:\n        return None\n    if min_left <= min(MAX_RANDOM_LEFT_MARGIN, max_left):\n        left_margin = random.randint(min_left, min(MAX_RANDOM_LEFT_MARGIN, max_left))\n    else:\n        left_margin = min_left\n\n    width = left_margin + span + right_margin\n    if not (MIN_WIDTH <= width <= MAX_WIDTH):\n        return None\n\n    bars = []\n    col = left_margin\n    gap_i = 0\n    for group_i, group in enumerate(groups):\n        chained = group[\"kind\"] == \"chain\"\n        for color, height in zip(group[\"colors\"], group[\"heights\"]):\n            bars.append(\n                {\n                    \"color\": color,\n                    \"height\": height,\n                    \"col\": col,\n                    \"chained\": chained,\n                }\n            )\n            col += height\n        if group_i + 1 < len(groups):\n            col += gaps[gap_i]\n            gap_i += 1\n\n    if col + right_margin != width:\n        return None\n    return bars, width\n\n\ndef _render_pair(rows, width, bars):\n    \"\"\"Render the sampled input grid and its expected transformed output.\"\"\"\n    baseline = rows - 1\n    inp = np.zeros((rows, width), dtype=int)\n    out = np.zeros_like(inp)\n    for bar in bars:\n        color, height, col = bar[\"color\"], bar[\"height\"], bar[\"col\"]\n        vertical = slice(baseline - height + 1, baseline + 1)\n        inp[vertical, col] = color\n        if bar[\"chained\"]:\n            out[baseline, col : col + height] = color\n        else:\n            out[vertical, col] = color\n    return inp, out\n\n\ndef _passes_oracle(inp, expected):\n    \"\"\"Return whether the solver accepts and matches the rendered output.\"\"\"\n    try:\n        actual = main(inp)\n    except Exception:\n        return False\n    return np.array_equal(actual, expected)\n\n\ndef _gen_attempt():\n    sampled = _sample_groups()\n    if sampled is None:\n        return None\n    rows, max_height, groups = sampled\n\n    layout = _sample_layout(max_height, groups)\n    if layout is None:\n        return None\n    bars, width = layout\n\n    inp, expected = _render_pair(rows, width, bars)\n    if not _passes_oracle(inp, expected):\n        return None\n    return inp\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport numpy as np\nfrom scipy.ndimage import label\nfrom arc_utils import get_bg, paste\nimport random\n\ndef apply_transform(arr: np.ndarray, flip_ud: bool = False, rot_k: int = 0) -> np.ndarray:\n    \"\"\"Positional-args helper (kept local; only used by this solver).\"\"\"\n    out = np.flipud(arr) if flip_ud else arr\n    return np.rot90(out, int(rot_k))\n\n\ndef transform_coords(coords, shape, flip_ud: bool = False, rot_k: int = 0):\n    \"\"\"Positional-args helper (kept local; only used by this solver).\"\"\"\n    mask = np.zeros(shape, dtype=bool)\n    for r, c in coords:\n        mask[int(r), int(c)] = True\n    out = apply_transform(mask, flip_ud=flip_ud, rot_k=rot_k)\n    return set(map(tuple, np.argwhere(out)))\n\n\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Dock train sprites onto station groups by matching coupler count, then orient via divider-color markers.\n\n    Input structure:\n    - bg; colored stripes (edge + internal) partition grid into rectangular regions.\n    - Color 8 forms train bodies; color 9 marks both isolated stations and train-attached couplers.\n    - Stripe-colored pixels on trains are orientation markers.\n\n    Rule:\n    - Stations = 8-connected 9-clusters not adjacent to any 8. Trains = components containing 8.\n    - Match train to station group where |couplers| == |station size|.\n    - Rotate/flip train so marker pixels face the same-color boundary stripe of the target region.\n    - Translate so couplers align exactly onto station cells; erase original position.\n\n    Key insight: Coupler count selects the docking target; marker color encodes which boundary stripe to face, fixing the unique orientation.\n    \"\"\"\n    inp = grid\n    grid = inp.copy()\n    H, W = grid.shape\n    bg = get_bg(grid)\n\n    # This puzzle's code is long because it reconstructs several \"structures\"\n    # that are implicit in the grid:\n    # - divider stripes (edge + internal) that partition the canvas into regions\n    # - station groups = 9-clusters not adjacent to any 8\n    # - train sprites = components containing 8 (with attached 9 \"couplers\")\n    # Then, for each train:\n    # - match target region by COUPLER COUNT (|couplers| == |station group|)\n    # - choose orientation by divider-color markers (face region boundary stripes)\n    # - translate so couplers land exactly onto the station group cells\n\n    def find_edge_stripes():\n        # Detect thick constant-color border stripes.\n        stripe = np.zeros((H, W), dtype=bool)\n        colors = set()\n        # Top edge\n        top_h = 0\n        for r in range(H):\n            row = grid[r, :]\n            if (row == row[0]).all() and row[0] != bg:\n                top_h += 1\n            else:\n                break\n        if top_h:\n            stripe[:top_h, :] = True\n            colors.add(int(grid[0, 0]))\n        # Bottom edge\n        bot_h = 0\n        for r in range(H - 1, -1, -1):\n            row = grid[r, :]\n            if (row == row[0]).all() and row[0] != bg:\n                bot_h += 1\n            else:\n                break\n        if bot_h:\n            stripe[H - bot_h :, :] = True\n            colors.add(int(grid[H - 1, 0]))\n        inner_r0, inner_r1 = top_h, H - bot_h\n        # Left edge (in inner rows)\n        left_w = 0\n        for c in range(W):\n            col = grid[inner_r0:inner_r1, c]\n            if col.size == 0:\n                break\n            if (col == col[0]).all() and col[0] != bg:\n                left_w += 1\n            else:\n                break\n        if left_w:\n            stripe[inner_r0:inner_r1, :left_w] = True\n            colors.add(int(grid[inner_r0, 0]))\n        # Right edge\n        right_w = 0\n        for c in range(W - 1, -1, -1):\n            col = grid[inner_r0:inner_r1, c]\n            if col.size == 0:\n                break\n            if (col == col[0]).all() and col[0] != bg:\n                right_w += 1\n            else:\n                break\n        if right_w:\n            stripe[inner_r0:inner_r1, W - right_w :] = True\n            colors.add(int(grid[inner_r0, W - 1]))\n        return stripe, colors, (top_h, bot_h, left_w, right_w)\n\n    def find_internal_stripes(edge_info):\n        # Detect internal constant-color stripes in the inner rectangle.\n        top_h, bot_h, left_w, right_w = edge_info\n        r0, r1, c0, c1 = top_h, H - bot_h, left_w, W - right_w\n        stripe = np.zeros((H, W), dtype=bool)\n        colors = set()\n        # Vertical internal stripes\n        c = c0\n        while c < c1:\n            col = grid[r0:r1, c]\n            if col.size and (col == col[0]).all() and col[0] != bg:\n                color = int(col[0])\n                c2 = c\n                while c2 + 1 < c1:\n                    col2 = grid[r0:r1, c2 + 1]\n                    if col2.size and (col2 == col2[0]).all() and int(col2[0]) == color:\n                        c2 += 1\n                    else:\n                        break\n                stripe[r0:r1, c : c2 + 1] = True\n                colors.add(color)\n                c = c2 + 1\n            else:\n                c += 1\n        # Horizontal internal stripes\n        r = r0\n        while r < r1:\n            row = grid[r, c0:c1]\n            if row.size and (row == row[0]).all() and row[0] != bg:\n                color = int(row[0])\n                r2 = r\n                while r2 + 1 < r1:\n                    row2 = grid[r2 + 1, c0:c1]\n                    if row2.size and (row2 == row2[0]).all() and int(row2[0]) == color:\n                        r2 += 1\n                    else:\n                        break\n                stripe[r : r2 + 1, c0:c1] = True\n                colors.add(color)\n                r = r2 + 1\n            else:\n                r += 1\n        return stripe, colors\n\n    def station_groups():\n        # Stations are 9 pixels with no adjacent 8 in the 8-neighborhood.\n        # Station groups are 8-connected components of those station pixels.\n        # Station 9s have no adjacent 8 in 8-neighborhood\n        sm = np.zeros((H, W), dtype=bool)\n        for r in range(H):\n            for c in range(W):\n                if grid[r, c] != 9:\n                    continue\n                ok = all(grid[r+dr, c+dc] != 8\n                        for dr in (-1, 0, 1) for dc in (-1, 0, 1)\n                        if (dr != 0 or dc != 0) and 0 <= r+dr < H and 0 <= c+dc < W)\n                if ok:\n                    sm[r, c] = True\n        # 8-connected clustering\n        struct = np.ones((3, 3), dtype=int)\n        lab, n = label(sm, structure=struct)\n        groups = []\n        for k in range(1, n + 1):\n            coords = np.argwhere(lab == k)\n            groups.append([(int(r), int(c)) for r, c in coords])\n        return groups\n\n    def regions_from_stripes(stripe_mask):\n        # Regions are connected components of all non-stripe cells.\n        non = ~stripe_mask\n        lab, n = label(non)\n        regs = []\n        for k in range(1, n + 1):\n            coords = np.argwhere(lab == k)\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            if (r1 - r0 + 1) >= 5 and (c1 - c0 + 1) >= 5:\n                regs.append({\"r0\": int(r0), \"r1\": int(r1), \"c0\": int(c0), \"c1\": int(c1)})\n        return regs\n\n    def boundary_dirs_for_region(reg, stripe_colors):\n        # For a region bbox, infer which stripe color borders each side.\n        # Returns map: stripe_color -> direction (0=up,1=right,2=down,3=left)\n        # Map stripe color -> direction (0=up, 1=right, 2=down, 3=left)\n        dirs = {}\n        r0, r1, c0, c1 = reg[\"r0\"], reg[\"r1\"], reg[\"c0\"], reg[\"c1\"]\n        if r0 - 1 >= 0:\n            mc = Counter(grid[r0 - 1, c0:c1 + 1].tolist()).most_common(1)[0][0]\n            if mc in stripe_colors:\n                dirs[int(mc)] = 0\n        if r1 + 1 < H:\n            mc = Counter(grid[r1 + 1, c0:c1 + 1].tolist()).most_common(1)[0][0]\n            if mc in stripe_colors:\n                dirs[int(mc)] = 2\n        if c0 - 1 >= 0:\n            mc = Counter(grid[r0:r1 + 1, c0 - 1].tolist()).most_common(1)[0][0]\n            if mc in stripe_colors:\n                dirs[int(mc)] = 3\n        if c1 + 1 < W:\n            mc = Counter(grid[r0:r1 + 1, c1 + 1].tolist()).most_common(1)[0][0]\n            if mc in stripe_colors:\n                dirs[int(mc)] = 1\n        return dirs\n\n    def xform_coords(coords, shape, flip_ud, rot_k):\n        \"\"\"Transform coords, return (list, new_shape).\"\"\"\n        result = transform_coords(coords, shape, flip_ud, rot_k)\n        new_shape = apply_transform(np.zeros(shape), flip_ud, rot_k).shape\n        return list(result), new_shape\n\n    def choose_best_op(train, divider_dirs):\n        # Pick orientation (flip/rot) that makes divider-color marker pixels\n        # \"face\" the region boundary stripe of the same color.\n        bbox0 = train[\"bbox\"]\n        H0, W0 = bbox0.shape\n        markers_by_color = defaultdict(list)\n        for v, r, c in train[\"marker_pixels\"]:\n            if v in divider_dirs:\n                markers_by_color[v].append((r, c))\n        assert markers_by_color, \"Each train must expose divider-colored markers\"\n        assert train[\"body9\"], \"Each train must carry at least one coupler\"\n        ref_r = sum(r for r, _ in train[\"body9\"]) / len(train[\"body9\"])\n        ref_c = sum(c for _, c in train[\"body9\"]) / len(train[\"body9\"])\n        best, best_score = (False, 0), -1\n        for flip_ud in (False, True):\n            for k in range(4):\n                ref_t = list(transform_coords([(int(round(ref_r)), int(round(ref_c)))], (H0, W0), flip_ud, k))\n                rr_ref, cc_ref = ref_t[0]\n                score = 0\n                for color, pts in markers_by_color.items():\n                    mr, mc = sum(r for r, _ in pts) / len(pts), sum(c for _, c in pts) / len(pts)\n                    m_t = list(transform_coords([(int(round(mr)), int(round(mc)))], (H0, W0), flip_ud, k))\n                    rr_m, cc_m = m_t[0]\n                    dr, dc = rr_m - rr_ref, cc_m - cc_ref\n                    dirc = (0 if dr < 0 else 2) if abs(dr) >= abs(dc) else (3 if dc < 0 else 1)\n                    if dirc == divider_dirs[color]:\n                        score += 1\n                if score > best_score:\n                    best_score, best = score, (flip_ud, k)\n        return best\n\n    # 1) Detect stripes and partition into regions\n    edge_mask, edge_colors, edge_info = find_edge_stripes()\n    internal_mask, internal_colors = find_internal_stripes(edge_info)\n    stripe_mask = edge_mask | internal_mask\n    stripe_colors = edge_colors | internal_colors\n    regions = regions_from_stripes(stripe_mask)\n\n    # 2) Station groups (targets)\n","exit_code":0,"status":"completed"}}
