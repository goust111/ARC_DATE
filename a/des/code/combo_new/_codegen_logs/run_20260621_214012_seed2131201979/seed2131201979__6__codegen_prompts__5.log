{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -c \"sed -n '7,170p' /home/lixinyu/snap/new/ARC_code/eval/5961cc34.py\nsed -n '565,760p' /home/lixinyu/snap/new/ARC_code/eval/5961cc34.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Build a red ray network by activating blue blobs via directional green ports.\n\n    Input structure:\n    - bg = most common color. Large blue blobs with adjacent green pixels marking port directions.\n    - Start marker: yellow pixel atop a short red segment at grid bottom.\n\n    Rule:\n    - Extend a ray upward from start; on hitting a blue blob, recolor it red.\n    - Activated blobs emit thick rays through green ports until boundary or another blob.\n    - Cascade until no new blobs are reached.\n\n    Key insight: Green pixels encode ray direction and width; the network activates as a chain reaction from one start point.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # --- STEP 1) Detect the start \"port\" (red vertical segment with a non-red cap above) ---\n    start_candidates: list[tuple[int, int, int, list[tuple[int, int]]]] = []\n\n    for col in colors_present(g, exclude={bg}):\n        for coords in components_mask(g == int(col), connectivity=8):\n            if coords.size == 0:\n                continue\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n\n            # thin vertical segment, height>=2, touches bottom\n            if c0 != c1 or (r1 - r0 + 1) < 2:\n                continue\n            if r1 != int(H - 1):\n                continue\n            # solid vertical segment\n            if any(int(g[rr, c0]) != int(col) for rr in range(int(r0), int(r1) + 1)):\n                continue\n            if int(r0) - 1 < 0:\n                continue\n            cap = int(g[int(r0) - 1, int(c0)])\n            if cap == int(bg) or cap == int(col):\n                continue\n\n            start_candidates.append(\n                (\n                    int(col),\n                    int(cap),\n                    int(c0),\n                    [(int(rr), int(c0)) for rr in range(int(r0), int(r1) + 1)],\n                )\n            )\n\n    assert len(start_candidates) == 1\n    red_col, yellow_col, start_col, start_seg = start_candidates[0]\n\n    # --- STEP 2) Identify blob colors ---\n    # Blue = dominant remaining color by pixel count (excluding bg/start colors).\n    counts = Counter(map(int, g.flatten()))\n    other_cols = [(int(cnt), int(col)) for col, cnt in counts.items() if int(col) not in (bg, red_col, yellow_col)]\n    assert other_cols\n    max_count = max(cnt for cnt, _col in other_cols)\n    blue_candidates = [int(col) for cnt, col in other_cols if cnt == max_count]\n    assert len(blue_candidates) == 1\n    blue_col = int(blue_candidates[0])\n\n    # Green = the unique other color that is 4-adjacent to blue.\n    green_candidates: list[int] = []\n    for col in colors_present(g, exclude={bg, red_col, yellow_col, blue_col}):\n        pts = np.argwhere(g == int(col))\n        if pts.size == 0:\n            continue\n        ok = False\n        for r, c in pts:\n            r = int(r)\n            c = int(c)\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + dr)\n                cc = int(c + dc)\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(blue_col):\n                    ok = True\n                    break\n            if ok:\n                break\n        if ok:\n            green_candidates.append(int(col))\n\n    assert len(green_candidates) == 1\n    green_col = int(green_candidates[0])\n\n    out = np.full_like(g, int(bg))\n\n    # --- STEP 3) Extract blue blobs as connected components, and build a pixel->blob map ---\n    blob_id = np.full((H, W), -1, dtype=int)\n    blobs: list[dict] = []\n\n    for coords in components_mask(g == int(blue_col), connectivity=8):\n        pts = [(int(r), int(c)) for r, c in coords]\n        bi = int(len(blobs))\n        for r, c in pts:\n            blob_id[int(r), int(c)] = bi\n        blobs.append({\"pts\": pts, \"ports\": []})\n\n    # --- STEP 4) For each blob, find its ports from adjacent green markers ---\n    for blob in blobs:\n        pts = blob[\"pts\"]\n        seen_dirs: set[tuple[int, int]] = set()\n        for r, c in pts:\n            for ddr, ddc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + ddr)\n                cc = int(c + ddc)\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(green_col):\n                    seen_dirs.add((int(ddr), int(ddc)))\n        for ddr, ddc in seen_dirs:\n            port_pixels = [\n                (int(r), int(c))\n                for (r, c) in pts\n                if 0 <= int(r + ddr) < H and 0 <= int(c + ddc) < W and int(g[int(r + ddr), int(c + ddc)]) == int(green_col)\n            ]\n            assert port_pixels\n            blob[\"ports\"].append({\"dir\": (int(ddr), int(ddc)), \"pixels\": port_pixels})\n\n    activated: set[int] = set()\n    queue: list[int] = []\n\n    def activate_blob_at(r: int, c: int) -> None:\n        \"\"\"Recolor a blob to red when first hit by a ray; enqueue it to emit its ports.\"\"\"\n        bi = int(blob_id[int(r), int(c)])\n        assert bi >= 0\n        if bi in activated:\n            return\n        activated.add(int(bi))\n        queue.append(int(bi))\n        for pr, pc in blobs[bi][\"pts\"]:\n            out[int(pr), int(pc)] = int(red_col)\n\n    # --- STEP 5) Draw the start ray upward (thin) and stop at the first blob hit ---\n    for r, c in start_seg:\n        out[int(r), int(c)] = int(red_col)\n    top_r = min(int(r) for r, _c in start_seg)\n    assert int(top_r) > 0 and int(g[int(top_r) - 1, int(start_col)]) == int(yellow_col)\n    out[int(top_r) - 1, int(start_col)] = int(red_col)\n    for r in range(int(top_r) - 1, -1, -1):\n        out[int(r), int(start_col)] = int(red_col)\n        if int(g[int(r), int(start_col)]) == int(blue_col):\n            activate_blob_at(int(r), int(start_col))\n            break\n\n    def extend_thick(port_pixels: list[tuple[int, int]], d: tuple[int, int]) -> None:\n        \"\"\"Extend a ray from each port pixel until boundary or blob hit.\"\"\"\n        ddr, ddc = map(int, d)\n        for pr, pc in port_pixels:\n            r, c = int(pr), int(pc)\n            while True:\n                r += int(ddr)\n                c += int(ddc)\n                if not (0 <= r < H and 0 <= c < W):\n                    break\n                out[int(r), int(c)] = int(red_col)\n                if int(g[int(r), int(c)]) == int(blue_col):\n                    activate_blob_at(int(r), int(c))\n                    break\n\n    # --- STEP 6) Propagate (BFS): activated blob -> emit rays -> activate more blobs ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 5961cc34 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c \"sed -n '59,190p' /home/lixinyu/snap/new/ARC_code/train/753ea09b.py\nsed -n '564,760p' /home/lixinyu/snap/new/ARC_code/train/753ea09b.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the small background compartments bounded by the long contour color.\n\n    Input structure:\n    - The grid has one dominant background color and two foreground colors.\n    - The more frequent foreground color forms long 8-connected contour fragments.\n    - The other foreground color is a fixed distractor/obstacle color that partitions\n      the background but is never recolored.\n\n    Rule:\n    - Split the background into 4-connected regions using all foreground pixels as\n      barriers.\n    - Keep the two largest background regions as the outside of the contour drawing.\n    - Recolor every other background region that touches a long contour component\n      to the contour color; leave all foreground pixels unchanged.\n\n    Key insight:\n    The apparent area fill is exactly a component-level fill of bounded background\n    compartments, not a row-wise interpolation between individual contour pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    foreground = colors_present(g, exclude={bg})\n    assert len(foreground) == 2, \"expected exactly two foreground colors\"\n\n    fill_color = _unique_largest_color(g, foreground)\n    fill_lab, _n_fill = label_mask(g == fill_color, connectivity=8)\n    long_ids = _long_component_ids(fill_lab, _n_fill)\n\n    bg_lab, n_bg = label_mask(g == bg, connectivity=4)\n    exterior_ids = _two_exterior_bg_ids(bg_lab, n_bg)\n\n    out = g.copy()\n    for comp_id in range(1, n_bg + 1):\n        if comp_id in exterior_ids:\n            continue\n        coords = np.argwhere(bg_lab == comp_id)\n        if _touches_long_contour(coords, fill_lab, long_ids):\n            out[bg_lab == comp_id] = fill_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\nH, W = 30, 30\nGRID_SHAPE = (H, W)\nARC_COLOR_COUNT = 10\n\n# Long contour path layout.\nPATH_COUNT_OPTIONS = (2, 3)\nPATH_STEP_OPTIONS = (-1, 0, 1)\nPATH_GAP_MIN, PATH_GAP_MAX = 2, 5\nPATH_LEFT_MIN_COL, PATH_RIGHT_MARGIN = 2, 3\nPATH_START_MIN_COL = 3\nPATH_START_RIGHT_MARGIN = 4\nPATH_FAR_END_MIN_CHOICES, PATH_FAR_END_PROB, PATH_FAR_END_DELTA = 8, 0.7, 5\nPATH_SCORING_CANDIDATES = 5\nPATH_MIN_MOVES = 12\n\n# Contour distractors and extra contour pixels.\nOUTSIDE_MARGIN = 2\nOUTSIDE_SIDE_OPTIONS = (-1, 1)\nSHORT_FRAGMENT_COUNT_MIN, SHORT_FRAGMENT_COUNT_MAX = 3, 5\nSHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX = 1, 4\nSHORT_FRAGMENT_ATTEMPTS = 200\nSHORT_FRAGMENT_PATH_PADDING = 3\nCONTOUR_PIXELS_MIN, CONTOUR_PIXELS_MAX = 81, 108\n\n# Obstacle bars and scattered clusters.\nBAR_SEGMENT_MAX = 11\nSINGLE_CHANNEL_BARS_MIN, SINGLE_CHANNEL_BARS_MAX = 5, 11\nMULTI_CHANNEL_TOTAL_BARS_MIN, MULTI_CHANNEL_TOTAL_BARS_MAX = 4, 10\nMULTI_CHANNEL_INITIAL_BARS = 2\nMULTI_CHANNEL_MAX_BARS = 5\nBAR_WIDTH_MIN, BAR_WIDTH_MAX = 1, 5\nOBSTACLE_PIXELS_MIN, OBSTACLE_PIXELS_MAX = 36, 63\nOBSTACLE_EXTRA_PIXELS_MIN = 8\nOBSTACLE_OUTSIDE_QUOTA_MIN, OBSTACLE_OUTSIDE_QUOTA_MAX = 8, 16\nOBSTACLE_CLUSTER_SIZE_MIN, OBSTACLE_CLUSTER_SIZE_MAX = 1, 5\nOBSTACLE_ATTEMPTS = 300\nOBSTACLE_ZONE_OPTIONS = (\"outside\", \"inside\", \"any\")\n\n# Component validation.\nBG_REGIONS_MIN, BG_REGIONS_MAX = 8, 14\nEXTERIOR_REGION_COUNT = 2\nINTERIOR_REGIONS_MIN, INTERIOR_REGIONS_MAX = 6, 12\nINTERIOR_REGION_AREA_MAX = 57\nLONG_COMPONENT_MIN_SPAN = H // 3\nLONG_COMPONENT_COUNT_OPTIONS = (2, 3)\n\n# Retry limits and local neighborhoods.\nGENERATION_ATTEMPTS = 300\nNEIGHBOR_DELTAS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nNEIGHBOR_DELTAS_8 = NEIGHBOR_DELTAS_4 + ((-1, -1), (-1, 1), (1, -1), (1, 1))\n\n\ndef _color_choices() -> tuple[int, int, int]:\n    colors = list(range(ARC_COLOR_COUNT))\n    random.shuffle(colors)\n    return int(colors[0]), int(colors[1]), int(colors[2])\n\n\ndef _path_columns(path_count: int) -> list[list[int]] | None:\n    gaps = [random.randint(PATH_GAP_MIN, PATH_GAP_MAX) for _ in range(path_count - 1)]\n    total_width = sum(gap + 1 for gap in gaps)\n    start_hi = W - PATH_START_RIGHT_MARGIN - total_width\n    if start_hi < PATH_START_MIN_COL:\n        return None\n\n    start = random.randint(PATH_START_MIN_COL, start_hi)\n    end_choices = list(range(PATH_START_MIN_COL, start_hi + 1))\n    if len(end_choices) > PATH_FAR_END_MIN_CHOICES and random.random() < PATH_FAR_END_PROB:\n        far = [c for c in end_choices if abs(c - start) >= PATH_FAR_END_DELTA]\n        if far:\n            end_choices = far\n    end = random.choice(end_choices)\n\n    cols = [start]\n    for gap in gaps:\n        cols.append(cols[-1] + gap + 1)\n    targets = [c + (end - start) for c in cols]\n\n    paths = [[int(c)] for c in cols]\n    for r in range(1, H):\n        valid: list[list[int]] = []\n        for steps in itertools.product(PATH_STEP_OPTIONS, repeat=path_count):\n            nxt = [cols[i] + steps[i] for i in range(path_count)]\n            if nxt[0] < PATH_LEFT_MIN_COL or nxt[-1] > W - PATH_RIGHT_MARGIN:\n                continue\n            if all(PATH_GAP_MIN <= nxt[i + 1] - nxt[i] - 1 <= PATH_GAP_MAX for i in range(path_count - 1)):\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 753ea09b input\")\n","exit_code":0,"status":"completed"}}
