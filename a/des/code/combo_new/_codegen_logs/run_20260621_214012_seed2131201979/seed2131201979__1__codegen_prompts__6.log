 arrows:\\n/home/lixinyu/snap/a/des/code/combo_new/seed807260302/5/5.py:219:        for r, c in arrow.cells:\\n/home/lixinyu/snap/a/des/code/combo_new/seed807260302/5/5.py:221:        block_bbox, color = _source_block(g, arrow)\\n/home/lixinyu/snap/a/des/code/combo_new/seed807260302/5/5.py:222:        boxes = _copy_bboxes(arrow, block_bbox)\\n/home/lixinyu/snap/a/des/code/combo_new/seed807260302/5/5.py:234:def _arrow_cells(direction: str, tail: tuple[int, int], length: int) -> tuple[set[tuple[int, int]], tuple[int, int]]:\\n/home/lixinyu/snap/a/des/code/combo_new/seed807260302/5/5.py:263:    arrow_cells, front = _arrow_cells(direction, tail, length)\\n/home/lixinyu/snap/a/des/code/combo_new/seed807260302/5/5.py:275:    arrow = Arrow(direction, {\\\"R\\\": (0, 1), \\\"L\\\": (0, -1), \\\"D\\\": (1, 0), \\\"U\\\": (-1, 0)}[direction],\\n/home/lixinyu/snap/a/des/code/combo_new/seed807260302/5/5.py:276:                  length, tail, front, frozenset(arrow_cells))\\n/home/lixinyu/snap/a/des/code/combo_new/seed807260302/5/5.py:277:    copies = _copy_bboxes(arrow, block)\\n/home/lixinyu/snap/a/des/code/combo_new/seed807260302/5/5.py:278:    return {\\\"arrow\\\": arrow_cells, \\\"block\\\": block, \\\"copies\\\": copies}\\n/home/lixinyu/snap/a/des/code/combo_new/seed807260302/5/5.py:333:            input_cells = set(layout[\\\"arrow\\\"]) | block_cells\\n/home/lixinyu/snap/a/des/code/combo_new/seed807260302/5/5.py:342:            for r, c in layout[\\\"arrow\\\"]:\\n/home/lixinyu/snap/a/des/code/combo_new/seed807260302/11/6.py:15:# T-shaped 5-cell arrows, expressed relative to the tip pixel.\\n/home/lixinyu/snap/a/des/code/combo_new/seed807260302/11/6.py:142:def _parse_arrows(grid: np.ndarray) -> list[dict[str, object]]:\\n/home/lixinyu/snap/a/des/code/combo_new/seed807260302/11/6.py:143:    arrows: list[dict[str, object]] = []\\n/home/lixinyu/snap/a/des/code/combo_new/seed807260302/11/6.py:155:        arrows.append(\\n/home/lixinyu/snap/a/des/code/combo_new/seed807260302