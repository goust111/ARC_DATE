ssert len(candidates) == 1\n26:     return candidates[0]\n27: \n28: \n29: def main(grid: np.ndarray) -> np.ndarray:\n30:     \"\"\"\n31:     Pack the non-background rows from three separated panels into one panel, scanning panels right-to-left.\n32: \n33:     Input structure:\n34:     - A rectangular grid contains three equal-size panels separated by two full-height divider columns.\n35:     - The background is the dominant color; divider pixels use a color that appears only in the divider columns.\n36: \n37:     Rule:\n38:     - Read panels from right to left, and within each panel read rows from top to bottom.\n39:     - Keep each row that contains any non-background pixel, discarding all-background rows.\n40:     - Place the kept rows at the bottom of a single panel-shaped output, padding above with background rows.\n41: \n42:     Key insight:\n43:     - The task is row packing: the divider columns mark independent panels, and only the occupied rows are moved.\n44:     \"\"\"\n45:     g = np.asarray(grid, dtype=int)\n46:     H, W = g.shape\n47:     bg = int(get_bg(g))\n48: \n49:     s0, s1 = _separator_columns(g, bg)\n50:     panel_w = int(s0)\n51:     assert H == panel_w\n52: \n53:     panels = [\n54:         g[:, :s0],\n55:         g[:, s0 + 1 : s1],\n56:         g[:, s1 + 1 :],\n57:     ]\n58:     rows: list[np.ndarray] = []\n59:     for panel in reversed(panels):\n60:         assert panel.shape == (H, panel_w)\n61:         for r in range(H):\n62:             row = panel[r, :]\n63:             if bool(np.any(row != bg)):\n64:                 rows.append(row.copy())\n65: \n66:     assert 0 < len(rows) <= H\n67:     for i in range(len(rows) - 1):\n68:         cols_a = set(int(c) for c in range(panel_w) if int(rows[i][c]) != bg)\n69:         cols_b = set(int(c) for c in range(panel_w) if int(rows[i + 1][c]) != bg)\n70:         assert cols_a & cols_b, \"consecutive non-bg rows must share at least one column\"\n71:     out = np.full((H, panel_w), bg, dtype=int)\n72:     out[H - len(rows) :, :] = np.asarray(rows, dtype=int)\n73:     return out\n74: \n75: # --------------- generator (o5x) ---------------\n76: \n77: # Canvas and fixed palette observed in the task.\n78: PANEL_SIZE_RANGE = (4, 6)\n79: BG_COLOR, SEPARATOR_COLOR = 7, 6\n80: CONTENT_COLORS = (1, 5)\n81: # Packed output rows and per-panel block heights.\n82: PACKED_ROW_RANGE = (3, 5)\n83: GROUP_ROW_RANGE = (1, 3)\n84: # Row intervals and hollow 3-row block variants.\n85: ROW_WIDTH_RANGE = (1, 5)\n86: HOLLOW_HEIGHT = 3\n87: HOLLOW_WIDTH_RANGE = (3, 5)\n88: HOLLOW_PROBABILITY = 0.35\n89: # Rejection-sampling retry limit.\n90: GENERATION_RETRIES = 300\n91: \n92: \n93: def _partition_rows(total: int) -> tuple[int, int, int]:\n94:     min_rows, max_rows = GROUP_ROW_RANGE\n95:     choices = [\n96:         (right, middle, left)\n97:         for right in range(min_rows, max_rows + 1)\n98:         for middle in range(min_rows, max_rows + 1)\n99:         for left in range(min_rows, max_rows + 1)\n100:         if right + middle + left == total\n101:     ]\n102:     return random.choice(choices)\n103: \n104: \n105: def _interval(width: int, must_include: int | None = None) -> tuple[int, int]:\n106:     min_len, max_config_len = ROW_WIDTH_RANGE\n107:     max_len = min(max_config_len, width)\n108:     length = random.randint(min_len, max_len)\n109:     if must_include is None:\n176:     try:\n177:         if np.array_equal(main(inp), out):\n178:             return inp\n179:     except AssertionError:\n180:         return None\n181:     return None\n182: \n183: \n184: def generate_input() -> np.ndarray:\n185:     for _ in range(GENERATION_RETRIES):\n186:         grid = _gen_attempt()\n187:         if grid is not None:\n188:             return grid\n189:     raise RuntimeError(\"failed to generate a valid 25c199f5 input\")\n","exit_code":0,"status":"completed"}}
