: r1 + 1, c1] = AZURE\n    seq_row = r0 + seq_row_offset\n    grid[seq_row, c0 + 1 : c1] = np.array(sequence, dtype=int)\n    return r0, c0, r1, c1\n\n\ndef _rel_dir(in_dir: int, rel: str) -> int:\n    return (in_dir + REL_TO_DELTA[rel]) % 4\n\n","exit_code":0,"status":"completed"}}
