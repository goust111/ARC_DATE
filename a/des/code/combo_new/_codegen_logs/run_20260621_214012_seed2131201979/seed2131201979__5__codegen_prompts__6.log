{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/8f215267.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg\nfrom arc_utils import paste, random_free_location\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count same-color patterns per frame and represent the tally as dots inside.\n\n    Input structure:\n    - bg = most common color.\n    - Hollow rectangular frames in various colors.\n    - Small monochrome pattern sprites scattered outside frames.\n\n    Rule:\n    - Remove all small patterns from the grid.\n    - For each frame of color C, count how many patterns share color C.\n    - Draw that many dots along the frame's center row, spaced by 2, starting from the right.\n\n    Key insight: Frames act as tally displays — scattered same-color patterns are \"absorbed\" and their count is shown as interior dots.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    out = g.copy()\n    bg = int(get_bg(g))\n\n    regions = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n\n    frames: list[dict] = []\n    patterns: list[dict] = []\n    for comp in regions:\n        b = comp[\"bbox\"]\n        h = bbox_h(b)\n        w = bbox_w(b)\n        area = int(comp[\"area\"])\n        is_frame = (h >= 5) and (w >= 5) and (area < (h * w * 0.7))\n        if is_frame:\n            frames.append(comp)\n        else:\n            patterns.append(comp)\n\n    # Remove patterns from output.\n    for p in patterns:\n        for r, c in p[\"coords\"]:\n            out[int(r), int(c)] = bg\n\n    # For each frame, count matching patterns and draw dots.\n    for f in frames:\n        col = int(f[\"color\"])\n        num_patterns = sum(1 for p in patterns if int(p[\"color\"]) == col)\n        if num_patterns <= 0:\n            continue\n\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        r_mid = (r0 + r1) // 2\n        for i in range(int(num_patterns)):\n            cc = int(c1 - 2 - 2 * i)\n            if cc > int(c0):\n                out[int(r_mid), int(cc)] = col\n\n    return out\n\n# --------------- generator (codex-att2) ---------------\n\n# --- layout geometry ---\nFRAME_H = 5                    # frame height (rows)\nFRAME_W = 11                   # frame width (cols)\nFRAME_R0 = 1                   # top-left row of first frame\nFRAME_C0 = 1                   # top-left col of all frames\nFRAME_GAP = 2                  # bg rows between consecutive frames\nGRID_W = 23                    # fixed grid width\nRIGHT_C0 = 13                  # first column of the right (sprite) region\nRIGHT_W = 9                    # width of the right region\n\n# --- structural counts ---\nN_FRAMES_RANGE = (3, 5)        # [lo, hi) for number of frames\nN_DISTRACTORS_RANGE = (1, 3)   # [lo, hi) for distractor sprite count\nTOTAL_PATTERNS_RANGE = (5, 11) # [lo, hi) for total sprite count\nMAX_DOTS_PER_FRAME = 4         # max dot tally inside one frame\nBOTTOM_PAD_RANGE = (0, 7)      # [lo, hi) extra bg rows when n_frames==3\n\n# --- sprite shape ---\nSPRITE_AREA_RANGE = (2, 9)     # [lo, hi) connected-cell count per sprite\nSPRITE_MAX_H = 4               # max bbox height for sprite\nSPRITE_MAX_W = 3               # max bbox width for sprite\nSPRITE_PADDING = 1             # gap between placed sprites\n\n# --- retry budget ---\nMAX_ATTEMPTS = 300\n\n\ndef _frame_patch(color: int, bg: int, n_dots: int) -> np.ndarray:\n    \"\"\"Build a FRAME_H x FRAME_W hollow rectangle with n_dots on the center row.\"\"\"\n    patch = np.full((FRAME_H, FRAME_W), bg, dtype=int)\n    patch[0, :] = color\n    patch[-1, :] = color\n    patch[:, 0] = color\n    patch[:, -1] = color\n    mid_r = FRAME_H // 2\n    dot_cols = [FRAME_W - 3 - 2 * i for i in range(n_dots)]\n    patch[mid_r, dot_cols] = color\n    return patch\n\n\ndef _sample_counts(rng: np.random.Generator, n_frames: int, total_match: int) -> list[int]:\n    \"\"\"Distribute total_match sprites across n_frames, each capped at MAX_DOTS_PER_FRAME.\"\"\"\n    counts = [0] * n_frames\n    order = rng.permutation(n_frames)\n    remaining = total_match\n    for pos, idx in enumerate(order):\n        frames_left = n_frames - pos - 1\n        lo = max(0, remaining - MAX_DOTS_PER_FRAME * frames_left)\n        hi = min(MAX_DOTS_PER_FRAME, remaining)\n        val = int(rng.integers(lo, hi + 1))\n        counts[int(idx)] = val\n        remaining -= val\n    return counts\n\n\ndef _grow_sprite(rng: np.random.Generator, h: int, w: int, area: int) -> list[tuple[int, int]]:\n    \"\"\"Grow a connected polyomino of the given area inside an h x w bounding box.\"\"\"\n    seed = (int(rng.integers(0, h)), int(rng.integers(0, w)))\n    cells = {seed}\n    while len(cells) < area:\n        frontier = []\n        for r, c in cells:\n            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                nb = (r + dr, c + dc)\n                if 0 <= nb[0] < h and 0 <= nb[1] < w and nb not in cells:\n                    frontier.append(nb)\n        cells.add(frontier[int(rng.integers(0, len(frontier)))])\n    return list(cells)\n\n\ndef _make_sprite(rng: np.random.Generator, color: int, bg: int) -> np.ndarray:\n    \"\"\"Generate a small random connected sprite, tight-cropped to its bounding box.\"\"\"\n    area = int(rng.integers(*SPRITE_AREA_RANGE))\n    dims = [(h, w) for h in range(1, SPRITE_MAX_H + 1)\n            for w in range(1, SPRITE_MAX_W + 1) if h * w >= area]\n    h, w = dims[int(rng.integers(0, len(dims)))]\n    cells = _grow_sprite(rng, h, w, area)\n    rs, cs = zip(*cells)\n    r_min, c_min = min(rs), min(cs)\n    patch = np.full((max(rs) - r_min + 1, max(cs) - c_min + 1), bg, dtype=int)\n    for r, c in cells:\n        patch[r - r_min, c - c_min] = color\n    return patch\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    # --- choose structure ---\n    n_frames = int(rng.integers(*N_FRAMES_RANGE))\n    n_distractors = int(rng.integers(*N_DISTRACTORS_RANGE))\n    total_patterns = int(rng.integers(*TOTAL_PATTERNS_RANGE))\n    total_match = total_patterns - n_distractors\n\n    palette = rng.choice(np.arange(10), size=1 + n_frames + n_distractors, replace=False)\n    bg = int(palette[0])\n    frame_colors = [int(x) for x in palette[1 : 1 + n_frames]]\n    distractor_colors = [int(x) for x in palette[1 + n_frames :]]\n\n    counts = _sample_counts(rng, n_frames, total_match)\n    bottom_pad = int(rng.integers(*BOTTOM_PAD_RANGE)) if n_frames == 3 else 0\n    height = FRAME_R0 + n_frames * FRAME_H + (n_frames - 1) * FRAME_GAP + bottom_pad\n\n    # --- build output (frames with dots) ---\n    out = np.full((height, GRID_W), bg, dtype=int)\n    frame_rows: list[int] = []\n    for i, (color, count) in enumerate(zip(frame_colors, counts)):\n        r0 = FRAME_R0 + i * (FRAME_H + FRAME_GAP)\n        frame_rows.append(r0)\n        paste(out, _frame_patch(color, bg, count), r0, FRAME_C0)\n\n    # --- derive input (dots removed, sprites placed right) ---\n    inp = out.copy()\n    for r0, count in zip(frame_rows, counts):\n        mid_r = r0 + FRAME_H // 2\n        dot_cols = [FRAME_C0 + FRAME_W - 3 - 2 * i for i in range(count)]\n        inp[mid_r, dot_cols] = bg\n\n    right_canvas = np.full((height, RIGHT_W), bg, dtype=int)\n    pattern_colors = [c for c, n in zip(frame_colors, counts) for _ in range(n)]\n    pattern_colors.extend(distractor_colors)\n    rng.shuffle(pattern_colors)\n\n    try:\n        for color in pattern_colors:\n            sprite = _make_sprite(rng, color, bg)\n            r0, c0 = random_free_location(\n                right_canvas, sprite, transparent=bg,\n                padding=SPRITE_PADDING, padding_connectivity=8,\n            )\n            paste(right_canvas, sprite, r0, c0, transparent=bg)\n    except ValueError:\n        return None\n\n    paste(inp, right_canvas, 0, RIGHT_C0, transparent=bg)\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"failed to generate a valid input after {MAX_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/46c35fc7.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg, paste\nimport random\n\n\ndef _rotate_ring(out: np.ndarray, g: np.ndarray, r0: int, c0: int) -> None:\n    patch = g[r0 : r0 + 3, c0 : c0 + 3]\n\n    out[r0 + 0, c0 + 0] = patch[0, 2]\n    out[r0 + 0, c0 + 1] = patch[1, 0]\n    out[r0 + 0, c0 + 2] = patch[2, 2]\n    out[r0 + 1, c0 + 0] = patch[2, 1]\n    out[r0 + 1, c0 + 2] = patch[0, 1]\n    out[r0 + 2, c0 + 0] = patch[0, 0]\n    out[r0 + 2, c0 + 1] = patch[1, 2]\n    out[r0 + 2, c0 + 2] = patch[2, 0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate the colors around every 3x3 foreground ring, with corners and side-centers cycling in opposite directions.\n\n    Input structure\n    - The grid has a dominant background color.\n    - Each 4-connected foreground object is a complete 3x3 ring: eight foreground pixels around a background center.\n\n    Rule\n    - For each ring, move corner colors one step around the four corners.\n    - Move side-center colors one step around the four side centers in the opposite direction.\n    - Leave the background center and all other background pixels unchanged.\n\n    Key insight\n    - Corners and side centers form two separate four-cycles on the same 3x3 ring.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    out = g.copy()\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert components\n\n    for comp in components:\n        bbox = comp[\"bbox\"]\n        r0, c0, r1, c1 = map(int, bbox)\n        assert bbox_h(bbox) == 3\n        assert bbox_w(bbox) == 3\n        assert int(comp[\"area\"]) == 8\n        assert g[r0 + 1, c0 + 1] == bg\n\n        ring_coords = {\n            (r0 + dr, c0 + dc)\n            for dr in range(3)\n            for dc in range(3)\n            if (dr, dc) != (1, 1)\n        }\n        component_coords = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n        assert component_coords == ring_coords\n        assert r1 == r0 + 2\n        assert c1 == c0 + 2\n\n        _rotate_ring(out, g, r0, c0)\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color and canvas bounds.\nBG_COLOR = 7\nCOLOR_IDS = tuple(range(10))\nGRID_SIDE_MIN, GRID_SIDE_MAX = 6, 10\nMIN_BACKGROUND_PCT = 67\n\n# Ring geometry, counts, and placement spacing.\nRING_SIZE, RING_AREA, RING_GAP = 3, 8, 1\nRING_COUNT_MIN, RING_COUNT_MAX = 1, 2\nRING_UNIQUE_MIN, RING_UNIQUE_MAX = 2, RING_AREA\nRING_CELLS = (\n    (0, 0),\n    (0, 1),\n    (0, 2),\n    (1, 0),\n    (1, 2),\n    (2, 0),\n    (2, 1),\n    (2, 2),\n)\n\n# Retry budget for rejection through the solver oracle.\nGENERATION_RETRIES = 300\n\n\ndef _bbox_at(r: int, c: int) -> tuple[int, int, int, int]:\n    return r, c, r + RING_SIZE - 1, c + RING_SIZE - 1\n\n\ndef _separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n    return (\n        a[2] + RING_GAP < b[0]\n        or b[2] + RING_GAP < a[0]\n        or a[3] + RING_GAP < b[1]\n        or b[3] + RING_GAP < a[1]\n    )\n\n\ndef _valid_position_sets(rows: int, cols: int, count: int) -> list[tuple[tuple[int, int], ...]]:\n    positions = [(r, c) for r in range(rows - RING_SIZE + 1) for c in range(cols - RING_SIZE + 1)]\n    if count == 1:\n        return [(pos,) for pos in positions]\n\n    pairs = []\n    for i, first in enumerate(positions):\n        box1 = _bbox_at(*first)\n        for second in positions[i + 1 :]:\n            if _separated(box1, _bbox_at(*second)):\n                pairs.append((first, second))\n    return pairs\n\n\ndef _compatible_sizes(count: int) -> list[tuple[int, int]]:\n    sizes = []\n    for rows in range(GRID_SIDE_MIN, GRID_SIDE_MAX + 1):\n        for cols in range(GRID_SIDE_MIN, GRID_SIDE_MAX + 1):\n            area = rows * cols\n            if (area - RING_AREA * count) * 100 < MIN_BACKGROUND_PCT * area:\n                continue\n            if _valid_position_sets(rows, cols, count):\n                sizes.append((rows, cols))\n    return sizes\n\n\n_SIZES = {count: _compatible_sizes(count) for count in range(RING_COUNT_MIN, RING_COUNT_MAX + 1)}\n_POSITION_SETS = {\n    count: {size: _valid_position_sets(*size, count) for size in _SIZES[count]}\n    for count in _SIZES\n}\n\n\ndef _make_ring(bg: int) -> np.ndarray:\n    ring = np.full((RING_SIZE, RING_SIZE), bg, dtype=int)\n    palette = [color for color in COLOR_IDS if color != bg]\n    unique_count = random.randint(RING_UNIQUE_MIN, RING_UNIQUE_MAX)\n    chosen = random.sample(palette, unique_count)\n    values = chosen + [random.choice(chosen) for _ in range(RING_AREA - unique_count)]\n    random.shuffle(values)\n    for (dr, dc), color in zip(RING_CELLS, values):\n        ring[dr, dc] = color\n    return ring\n\n\ndef _rotated_output(grid: np.ndarray, positions: tuple[tuple[int, int], ...]) -> np.ndarray:\n    out = grid.copy()\n    for r0, c0 in positions:\n        _rotate_ring(out, grid, r0, c0)\n    return out\n\n\ndef _render_grid(rows: int, cols: int, positions: tuple[tuple[int, int], ...], bg: int) -> np.ndarray:\n    grid = np.full((rows, cols), bg, dtype=int)\n    for r0, c0 in positions:\n        paste(grid, _make_ring(bg), r0, c0)\n    return grid\n\n\ndef _oracle_accepts(grid: np.ndarray, positions: tuple[tuple[int, int], ...]) -> bool:\n    expected = _rotated_output(grid, positions)\n    try:\n        actual = main(grid)\n    except AssertionError:\n        return False\n    return np.array_equal(actual, expected)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = BG_COLOR\n    count = random.randint(RING_COUNT_MIN, RING_COUNT_MAX)\n    rows, cols = random.choice(_SIZES[count])\n    positions = random.choice(_POSITION_SETS[count][(rows, cols)])\n    grid = _render_grid(rows, cols, positions, bg)\n    return grid if _oracle_accepts(grid, positions) else None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 46c35fc7 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/305b1341.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, get_bg\nimport random\n\n\ndef _legend_pairs(g: np.ndarray, bg: int) -> list[tuple[int, int]]:\n    pairs: list[tuple[int, int]] = []\n    for r in range(g.shape[0]):\n        left = int(g[r, 0])\n        right = int(g[r, 1])\n        if left == bg or right == bg:\n            break\n        pairs.append((left, right))\n    assert pairs, \"expected a non-empty two-column legend at the upper left\"\n    return pairs\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Expand each sparse color object into a filled rectangular region using its legend-paired fill color.\n\n    Input structure\n    A background-color grid has a two-column legend in columns 0 and 1, starting at row 0: each row gives\n    a source color in the left column and that source color's fill color in the right column.  Outside the\n    legend, the foreground pixels are sparse dot objects whose colors are exactly the legend source colors.\n\n    Rule\n    Clear the legend.  For each source color, take the bbox of all of its non-legend dots, expand that bbox\n    by one pixel in every direction, and fill background cells inside the expanded rectangle with the paired\n    legend fill color while preserving every original non-legend dot.\n\n    Key insight\n    The legend order is also the layer order: earlier legend rows are in front, so fill rectangles are painted\n    from the last legend row back to the first and higher-priority fills overwrite lower-priority fills.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n    assert W >= 2, \"expected room for a two-column legend\"\n\n    pairs = _legend_pairs(g, bg)\n    source_colors = {source for source, _fill in pairs}\n    assert len(source_colors) == len(pairs), \"legend source colors must be unique\"\n\n    legend_mask = np.zeros(g.shape, dtype=bool)\n    legend_mask[: len(pairs), :2] = True\n    dot_mask = (g != bg) & ~legend_mask\n    assert dot_mask.any(), \"expected source dots outside the legend\"\n    assert set(map(int, g[dot_mask])).issubset(source_colors), \"outside dots must use legend source colors\"\n\n    dots_by_color: dict[int, np.ndarray] = {}\n    all_dots = np.zeros(g.shape, dtype=bool)\n    for source, _fill in pairs:\n        coords = np.argwhere(dot_mask & (g == source))\n        assert coords.size, \"each legend source color must appear outside the legend\"\n        dots_by_color[source] = coords\n        all_dots[coords[:, 0], coords[:, 1]] = True\n\n    out = np.full_like(g, bg)\n    for source, fill in reversed(pairs):\n        r0, c0, r1, c1 = bbox_coords(dots_by_color[source])\n        r0 = max(0, r0 - 1)\n        c0 = max(0, c0 - 1)\n        r1 = min(H - 1, r1 + 1)\n        c1 = min(W - 1, c1 + 1)\n\n        region = out[r0 : r1 + 1, c0 : c1 + 1]\n        background_inside_region = ~all_dots[r0 : r1 + 1, c0 : c1 + 1]\n        region[background_inside_region] = fill\n\n    out[all_dots] = g[all_dots]\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and legend geometry.\nGRID_HEIGHT, GRID_WIDTH = 20, 20\nBACKGROUND_COLOR = 0\nLEGEND_COLS = 2\nDOT_STRIDE, BBOX_PAD, NON_OVERLAP_GAP = 2, 1, 1\n\n# Legend palette sampling.\nCOLORS = tuple(range(1, 10))\nPAIR_COUNT_CHOICES = (2, 3)\nROTATED_SOURCE_FILL_PROB = 0.45\n\n# Dot-grid shape sampling.\nDOT_ROWS_MIN, DOT_ROWS_MAX = 2, 8\nDOT_COLS_MIN, DOT_COLS_MAX = 2, 5\n\n# Layout search.\nTHREE_PAIR_FORCED_OVERLAP_STEPS = (1, 2)\nMODE_OVERLAP, MODE_OVERLAP_ANY, MODE_SEPARATE, MODE_ANY = \"overlap\", \"overlap_any\", \"separate\", \"any\"\nPOST_FORCED_LAYOUT_MODES = (MODE_SEPARATE, MODE_OVERLAP_ANY, MODE_ANY)\nPOST_FORCED_LAYOUT_WEIGHTS = (3, 3, 1)\n\n# Generation retry budget.\nGENERATION_RETRIES = 300\n\n\ndef _origin_bbox(origin: tuple[int, int], dot_rows: int, dot_cols: int) -> tuple[int, int, int, int]:\n    r, c = origin\n    return (\n        r - BBOX_PAD,\n        c - BBOX_PAD,\n        r + DOT_STRIDE * (dot_rows - 1) + BBOX_PAD,\n        c + DOT_STRIDE * (dot_cols - 1) + BBOX_PAD,\n    )\n\n\ndef _hits_legend(box: tuple[int, int, int, int], n_pairs: int) -> bool:\n    r0, c0, r1, c1 = box\n    return r0 <= n_pairs - 1 and r1 >= 0 and c0 <= LEGEND_COLS - 1 and c1 >= 0\n\n\ndef _legal_origins(n_pairs: int, dot_rows: int, dot_cols: int) -> list[tuple[int, int]]:\n    origins: list[tuple[int, int]] = []\n    max_r = GRID_HEIGHT - 1 - BBOX_PAD - DOT_STRIDE * (dot_rows - 1)\n    max_c = GRID_WIDTH - 1 - BBOX_PAD - DOT_STRIDE * (dot_cols - 1)\n    for r in range(BBOX_PAD, max_r + 1):\n        for c in range(BBOX_PAD, max_c + 1):\n            box = _origin_bbox((r, c), dot_rows, dot_cols)\n            if not _hits_legend(box, n_pairs):\n                origins.append((r, c))\n    return origins\n\n\ndef _dot_coords(origin: tuple[int, int], dot_rows: int, dot_cols: int) -> np.ndarray:\n    rows = origin[0] + DOT_STRIDE * np.arange(dot_rows)\n    cols = origin[1] + DOT_STRIDE * np.arange(dot_cols)\n    rr, cc = np.meshgrid(rows, cols, indexing=\"ij\")\n    return np.stack([rr.ravel(), cc.ravel()], axis=1).astype(int)\n\n\ndef _expanded_bbox(coords: np.ndarray) -> tuple[int, int, int, int]:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    return (\n        max(0, r0 - BBOX_PAD),\n        max(0, c0 - BBOX_PAD),\n        min(GRID_HEIGHT - 1, r1 + BBOX_PAD),\n        min(GRID_WIDTH - 1, c1 + BBOX_PAD),\n    )\n\n\ndef _inside_box(coords: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:\n    r0, c0, r1, c1 = box\n    return (coords[:, 0] >= r0) & (coords[:, 0] <= r1) & (coords[:, 1] >= c0) & (coords[:, 1] <= c1)\n\n\ndef _separated_by_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n    return (\n        a[2] + NON_OVERLAP_GAP < b[0]\n        or b[2] + NON_OVERLAP_GAP < a[0]\n        or a[3] + NON_OVERLAP_GAP < b[1]\n        or b[3] + NON_OVERLAP_GAP < a[1]\n    )\n\n\ndef _intersection_bounds(\n    a: tuple[int, int, int, int], b: tuple[int, int, int, int]\n) -> tuple[int, int, int, int] | None:\n    r0, c0 = max(a[0], b[0]), max(a[1], b[1])\n    r1, c1 = min(a[2], b[2]), min(a[3], b[3])\n    if r0 > r1 or c0 > c1:\n        return None\n    return r0, c0, r1, c1\n\n\ndef _intersection_has_background(\n    a: tuple[int, int, int, int], b: tuple[int, int, int, int], dot_mask: np.ndarray\n) -> bool:\n    bounds = _intersection_bounds(a, b)\n    if bounds is None:\n        return False\n    r0, c0, r1, c1 = bounds\n    return bool((~dot_mask[r0 : r1 + 1, c0 : c1 + 1]).any())\n\n\ndef _remove_dots_covered_by_higher_priority(\n    coords: np.ndarray, higher_boxes: list[tuple[int, int, int, int]]\n) -> np.ndarray:\n    keep = np.ones(len(coords), dtype=bool)\n    for box in higher_boxes:\n        keep &= ~_inside_box(coords, box)\n    return coords[keep]\n\n\ndef _scene_data(\n    sizes: list[tuple[int, int]], origins: list[tuple[int, int]]\n) -> tuple[list[np.ndarray], list[tuple[int, int, int, int]], np.ndarray] | None:\n    remaining: list[np.ndarray] = []\n    boxes: list[tuple[int, int, int, int]] = []\n    dot_mask = np.zeros((GRID_HEIGHT, GRID_WIDTH), dtype=bool)\n\n    for (dot_rows, dot_cols), origin in zip(sizes, origins):\n        coords = _remove_dots_covered_by_higher_priority(_dot_coords(origin, dot_rows, dot_cols), boxes)\n        if coords.size == 0:\n            return None\n        if len(set(map(int, coords[:, 0]))) != dot_rows or len(set(map(int, coords[:, 1]))) != dot_cols:\n            return None\n        if dot_mask[coords[:, 0], coords[:, 1]].any():\n            return None\n        dot_mask[coords[:, 0], coords[:, 1]] = True\n        remaining.append(coords)\n        boxes.append(_expanded_bbox(coords))\n\n    return remaining, boxes, dot_mask\n\n\ndef _render_output(\n    pairs: list[tuple[int, int]], remaining: list[np.ndarray], boxes: list[tuple[int, int, int, int]], dot_mask: np.ndarray\n) -> np.ndarray:\n    out = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)\n    for idx in range(len(pairs) - 1, -1, -1):\n        _source, fill = pairs[idx]\n        r0, c0, r1, c1 = boxes[idx]\n        region = out[r0 : r1 + 1, c0 : c1 + 1]\n        region[~dot_mask[r0 : r1 + 1, c0 : c1 + 1]] = fill\n    for (source, _fill), coords in zip(pairs, remaining):\n        out[coords[:, 0], coords[:, 1]] = source\n    return out\n\n\ndef _build_input(pairs: list[tuple[int, int]], remaining: list[np.ndarray]) -> np.ndarray:\n    grid = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)\n    grid[: len(pairs), :LEGEND_COLS] = np.asarray(pairs, dtype=int)\n    for (source, _fill), coords in zip(pairs, remaining):\n        grid[coords[:, 0], coords[:, 1]] = source\n    return grid\n\n\ndef _visible_overlap(\n    pairs: list[tuple[int, int]], boxes: list[tuple[int, int, int, int]], dot_mask: np.ndarray, out: np.ndarray\n) -> bool:\n    for hi in range(len(pairs)):\n        for lo in range(hi + 1, len(pairs)):\n            bounds = _intersection_bounds(boxes[hi], boxes[lo])\n            if bounds is None:\n","exit_code":0,"status":"completed"}}
