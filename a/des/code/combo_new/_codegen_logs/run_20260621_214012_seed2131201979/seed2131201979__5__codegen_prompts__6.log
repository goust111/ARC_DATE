{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/edb79dae.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location\nimport random\nimport itertools\n\n\ndef _find_frame(g: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:\n    \"\"\"\n    Find a rectangular border component:\n      - all bbox-border cells are this color,\n      - bbox-interior is not entirely this color.\n    Return (frame_color, (r0,c0,r1,c1)).\n    \"\"\"\n    candidates = []\n    colors = [int(c) for c in np.unique(g) if int(c) != bg]\n    for col in colors:\n        for pts in components_mask(g == col, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            if r1 - r0 < 2 or c1 - c0 < 2:\n                continue\n            sub = g[r0 : r1 + 1, c0 : c1 + 1]\n            border = np.zeros(sub.shape, dtype=bool)\n            border[0, :] = True\n            border[-1, :] = True\n            border[:, 0] = True\n            border[:, -1] = True\n            if not np.all(sub[border] == col):\n                continue\n            if np.all(sub[~border] == col):\n                continue\n            candidates.append((col, (r0, c0, r1, c1)))\n    assert len(candidates) == 1, f\"expected exactly one rectangular frame component, found {len(candidates)}\"\n    frame_col, bbox = candidates[0]\n    return int(frame_col), bbox\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp recolored sprites into a framed region using placeholder positions and a color legend.\n\n    Input structure:\n    - bg background, a rectangular single-color frame, colored placeholder cells inside the frame.\n    - Outside the frame: sprite shapes (one per placeholder color) and a small legend mapping each placeholder color to an output color.\n\n    Rule:\n    - Find the frame and its interior placeholders.\n    - For each placeholder color, locate the matching-color sprite outside the frame.\n    - Stamp each sprite at the placeholder's position inside the frame.\n    - Recolor every stamped sprite to the output color defined by the legend.\n\n    Key insight: The legend pairs (overlapping two-color glyphs outside the frame) dictate the final recoloring — placeholder color selects the shape, legend maps it to the output color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    frame_col, (fr0, fc0, fr1, fc1) = _find_frame(g, bg)\n\n    crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1]\n    H, W = crop.shape\n    assert H >= 3 and W >= 3, f\"frame too small for interior: {(H, W)}\"\n\n    # Placeholder components inside the frame interior.\n    inner_mask = np.zeros((H, W), dtype=bool)\n    inner_mask[1:-1, 1:-1] = True\n    placeholder_colors = set(map(int, np.unique(crop[inner_mask]))) - {bg, frame_col}\n    assert placeholder_colors, \"no placeholder colors found inside frame\"\n\n    placeholders: list[tuple[int, tuple[int, int, int, int]]] = []\n    for col in sorted(placeholder_colors):\n        for pts in components_mask((crop == col) & inner_mask, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            placeholders.append((col, (r0, c0, r1, c1)))\n    # Eval inputs use one placement bbox size per placeholder color.\n    phw: dict[int, tuple[int, int]] = {}\n    for col in placeholder_colors:\n        dims = [(b[2] - b[0] + 1, b[3] - b[1] + 1) for c, b in placeholders if c == col]\n        assert dims, f\"no placeholder component found for color {col}\"\n        unique_dims = sorted(set(dims))\n        assert len(unique_dims) == 1, f\"ambiguous placeholder sizes for color {col}: {unique_dims}\"\n        phw[col] = unique_dims[0]\n\n    # Extract outside-frame components for sprite shapes and for legend color mapping.\n    outside = np.ones(g.shape, dtype=bool)\n    outside[fr0 : fr1 + 1, fc0 : fc1 + 1] = False\n\n    # Collect all outside components (with ids) for later pairing.\n    comps = []\n    colors = [int(c) for c in np.unique(g) if int(c) not in (bg, frame_col)]\n    cid = 0\n    for col in colors:\n        for pts in components_mask((g == col) & outside, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            pts_tuples = [(int(r), int(c)) for r, c in pts]\n            comps.append(\n                {\n                    \"id\": cid,\n                    \"col\": int(col),\n                    \"pts\": pts_tuples,\n                    \"bbox\": (r0, c0, r1, c1),\n                    \"area\": len(pts_tuples),\n                }\n            )\n            cid += 1\n\n    def _bbox_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n        ar0, ac0, ar1, ac1 = a\n        br0, bc0, br1, bc1 = b\n        return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)\n\n    # Legend mapping: detect small two-color glyph regions where two components overlap in bbox\n    # and the union bbox contains only those two colors (no background).\n    color_map: dict[int, int] = {}\n    legend_ids: set[int] = set()\n\n    for i in range(len(comps)):\n        for j in range(i + 1, len(comps)):\n            ci = comps[i]\n            cj = comps[j]\n            if ci[\"col\"] == cj[\"col\"]:\n                continue\n            if not _bbox_overlap(ci[\"bbox\"], cj[\"bbox\"]):\n                continue\n            r0 = min(ci[\"bbox\"][0], cj[\"bbox\"][0])\n            c0 = min(ci[\"bbox\"][1], cj[\"bbox\"][1])\n            r1 = max(ci[\"bbox\"][2], cj[\"bbox\"][2])\n            c1 = max(ci[\"bbox\"][3], cj[\"bbox\"][3])\n            # restrict to compact legend-like regions\n            if (r1 - r0 + 1) > 8 or (c1 - c0 + 1) > 8:\n                continue\n            sub = g[r0 : r1 + 1, c0 : c1 + 1]\n            sub_colors = set(map(int, np.unique(sub))) - {frame_col}\n            if bg in sub_colors:\n                continue\n            if len(sub_colors) != 2:\n                continue\n            cset = set(sub_colors)\n            if ci[\"col\"] not in cset or cj[\"col\"] not in cset:\n                continue\n\n            # Decide source->target.\n            # If exactly one color is used as a placeholder inside the frame, that one is source.\n            if (ci[\"col\"] in placeholder_colors) ^ (cj[\"col\"] in placeholder_colors):\n                src = ci[\"col\"] if ci[\"col\"] in placeholder_colors else cj[\"col\"]\n                tgt = cj[\"col\"] if src == ci[\"col\"] else ci[\"col\"]\n            else:\n                # Otherwise: the larger component in this pair is treated as the source.\n                assert ci[\"area\"] != cj[\"area\"], f\"ambiguous equal-area legend pair: {ci['col']} and {cj['col']}\"\n                if ci[\"area\"] > cj[\"area\"]:\n                    src, tgt = ci[\"col\"], cj[\"col\"]\n                else:\n                    src, tgt = cj[\"col\"], ci[\"col\"]\n\n            assert src in placeholder_colors, f\"legend source color {src} is not a placeholder\"\n            assert src not in color_map, f\"duplicate legend mapping for placeholder color {src}\"\n            color_map[src] = int(tgt)\n            legend_ids.add(ci[\"id\"])\n            legend_ids.add(cj[\"id\"])\n    assert set(color_map) == placeholder_colors, (\n        f\"legend mappings {sorted(color_map)} do not match placeholders {sorted(placeholder_colors)}\"\n    )\n\n    # Sprite shapes: for each placeholder color, pick the non-legend component matching placeholder size.\n    sprite_coords: dict[int, tuple[tuple[tuple[int, int], ...], int, int]] = {}\n    for src_col in sorted(placeholder_colors):\n        all_candidates = [c for c in comps if c[\"col\"] == src_col and c[\"id\"] not in legend_ids]\n        assert all_candidates, f\"no non-legend sprite found for color {src_col}\"\n        want_h, want_w = phw[src_col]\n        sized = [\n            c\n            for c in all_candidates\n            if (c[\"bbox\"][2] - c[\"bbox\"][0] + 1) == want_h and (c[\"bbox\"][3] - c[\"bbox\"][1] + 1) == want_w\n        ]\n        assert len(sized) == 1, f\"expected one size-matched sprite for color {src_col}, found {len(sized)}\"\n        base = sized[0]\n        sr0, sc0, sr1, sc1 = base[\"bbox\"]\n\n        # Some sprites can be split into multiple 4-connected components of the same color.\n        # Merge any additional (non-legend) components fully contained in the chosen sprite bbox.\n        pts_set = set(base[\"pts\"])\n        for c in all_candidates:\n            if c[\"id\"] == base[\"id\"]:\n                continue\n            r0, c0, r1, c1 = c[\"bbox\"]\n            assert sr0 <= r0 and sr1 >= r1 and sc0 <= c0 and sc1 >= c1, (\n                f\"extra sprite component for color {src_col} is outside the base bbox\"\n            )\n            pts_set.update(c[\"pts\"])\n\n        coords = tuple(sorted((r - sr0, c - sc0) for r, c in pts_set))\n        sprite_coords[src_col] = (coords, sr1 - sr0 + 1, sc1 - sc0 + 1)\n\n    # Build output crop: keep frame border, clear interior to bg, then paste recolored sprites.\n    out = crop.copy()\n    out[1:-1, 1:-1] = bg\n\n    for src_col, (pr0, pc0, pr1, pc1) in placeholders:\n        assert src_col in sprite_coords and src_col in color_map, f\"placeholder color {src_col} missing sprite or color mapping\"\n        tgt_col = int(color_map[src_col])\n        coords, sh, sw = sprite_coords[src_col]\n        assert (pr1 - pr0 + 1, pc1 - pc0 + 1) == (sh, sw), (\n            f\"placeholder size does not match sprite for color {src_col}\"\n        )\n        assert pr0 + sh <= H and pc0 + sw <= W, f\"sprite for color {src_col} does not fit at placeholder\"\n        # Align sprite's bbox top-left to placeholder bbox top-left.\n        off_r = pr0\n        off_c = pc0\n        for dr, dc in coords:\n            rr, cc = off_r + dr, off_c + dc\n            out[rr, cc] = tgt_col\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# === CFG: tunables ===\nFRAME_COL = 5                       # frame border color (always gray)\nSPRITE_N_RANGE = (3, 6)             # NxN sprite/placeholder size, exclusive upper\nGRID_ROWS_RANGE = (2, 4)            # placeholder grid row count, exclusive upper\nGRID_COLS_RANGE = (3, 5)            # placeholder grid col count, exclusive upper\nTOTAL_BLOCKS_RANGE = (6, 10)        # total filled slots (inclusive)\nMAX_EMPTY_SLOTS = 2                 # max empty slots in the grid\nNUM_COLORS_RANGE = (2, 5)           # K = number of distinct placeholder colors (inclusive)\nSPRITE_FILL_MIN = 0.5               # min sprite fill ratio\nSPRITE_FILL_MAX = 0.9               # max sprite fill ratio (clamped to n*n-1)\nMIN_FRAME_H = 13                    # minimum frame height\nMIN_FRAME_W = 18                    # minimum frame width\nMAX_FRAME_DIM = 21                  # maximum frame height or width\nFRAME_MARGIN_SLACK = 4              # max extra padding inside frame beyond content\nCANVAS_H_RANGE = (22, 31)           # final grid height range, exclusive upper\nCANVAS_W_RANGE = (23, 31)           # final grid width range, exclusive upper\nFRAME_POS_JITTER_PROB = 0.25        # probability of non-edge frame placement per axis\nPATCH_PADDING = 1                   # min bg gap between placed patches\nGEN_RETRIES = 300                   # outer retry budget\n\n\ndef _legend(src: int, tgt: int) -> np.ndarray:\n    \"\"\"Build a 3x4 legend block mapping src color to tgt color.\"\"\"\n    return np.array(\n        [[src, src, tgt, tgt],\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, neighbors4\n\n\ndef _legend_directions(g: np.ndarray, bg: int) -> dict[int, tuple[int, int]]:\n    \"\"\"\n    Detect legend blocks on the border.\n\n    A legend is a border-touching non-background component whose most common color is the legend\n    background `C` (and also the region border color it controls). The legend contains at least\n    two additional colors: a \"center\" color (more frequent) and an \"indicator\" color (less frequent).\n\n    The movement direction for regions with border color `C` is:\n      sign(centroid(indicator) - centroid(center))\n    \"\"\"\n    h, w = g.shape\n    non_bg = g != bg\n    best: dict[int, tuple[int, tuple[int, int]]] = {}\n    for pts in components_mask(non_bg, connectivity=4):\n        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue\n        # Legends are filled rectangles on the border.\n        r0, c0, r1, c1 = bbox_coords(pts)\n        area = (r1 - r0 + 1) * (c1 - c0 + 1)\n        if area != len(pts):\n            continue\n\n        counts: dict[int, int] = {}\n        for r, c in pts:\n            v = int(g[r, c])\n            counts[v] = counts.get(v, 0) + 1\n        if len(counts) != 3:\n            continue\n\n        bg_col = max(counts, key=counts.get)\n        others = [(cnt, col) for col, cnt in counts.items() if col != bg_col]\n        if len(others) < 2:\n            continue\n        others.sort()  # ascending by count\n        if others[0][0] == others[1][0]:\n            # Tie: choose center as the color closer to the rectangle center.\n            rc = np.array([(r0 + r1) / 2.0, (c0 + c1) / 2.0])\n            cols = [others[0][1], others[1][1]]\n            cents = []\n            for col in cols:\n                pts_col = np.array([(r, c) for r, c in pts if int(g[r, c]) == col], dtype=float)\n                cents.append((np.sum((pts_col.mean(axis=0) - rc) ** 2), col))\n            cents.sort()\n            center_col = cents[0][1]\n            indicator_col = cents[1][1]\n        else:\n            indicator_col = others[0][1]\n            center_col = others[-1][1]\n\n        center = [(r, c) for r, c in pts if int(g[r, c]) == center_col]\n        indic = [(r, c) for r, c in pts if int(g[r, c]) == indicator_col]\n        if not center or not indic:\n            continue\n\n        cc = np.mean(np.array(center, dtype=float), axis=0)\n        ci = np.mean(np.array(indic, dtype=float), axis=0)\n        vr, vc = (ci - cc).tolist()\n        dr = 0 if abs(vr) < 1e-6 else (1 if vr > 0 else -1)\n        dc = 0 if abs(vc) < 1e-6 else (1 if vc > 0 else -1)\n        if dr == 0 and dc == 0:\n            continue\n\n        prev = best.get(bg_col)\n        if prev is None or len(pts) > prev[0]:\n            best[bg_col] = (len(pts), (dr, dc))\n\n    return {k: v for k, (_, v) in best.items()}\n\n\ndef _slide_points(region_set: set[tuple[int, int]], points: list[tuple[int, int]], dr: int, dc: int) -> list[tuple[int, int]]:\n    if not points:\n        return []\n    # Process from the far end (closest to destination boundary) inward.\n    points_sorted = sorted(points, key=lambda p: (dr * p[0] + dc * p[1], p[0], p[1]), reverse=True)\n    occupied = set()\n    out_pts = []\n    for r0, c0 in points_sorted:\n        r, c = r0, c0\n        while True:\n            nr, nc = r + dr, c + dc\n            if (nr, nc) not in region_set:\n                break\n            # For diagonal steps, disallow \"corner cutting\": both orthogonal intermediates must be inside the region.\n            if dr != 0 and dc != 0:\n                if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n                    break\n            if (nr, nc) in occupied:\n                break\n            r, c = nr, nc\n        occupied.add((r, c))\n        out_pts.append((r, c))\n    return out_pts\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n","exit_code":0,"status":"completed"}}
