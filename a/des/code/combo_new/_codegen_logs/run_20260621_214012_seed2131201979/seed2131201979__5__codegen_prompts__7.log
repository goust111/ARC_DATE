{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/train/d93c6891.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords, bbox_h, bbox_w, find_components, neighbors4\nimport random\n\n\ndef _orientation(\n    coords: np.ndarray,\n    contacts: list[tuple[int, int, int, int]],\n) -> str:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    assert h == 1 or w == 1, \"expected each gray source to be a one-cell-thick bar\"\n\n    if h == 1 and w > 1:\n        return \"horizontal\"\n    if w == 1 and h > 1:\n        return \"vertical\"\n\n    implied: set[str] = set()\n    for tr, tc, sr, sc in contacts:\n        if tr == sr:\n            implied.add(\"horizontal\")\n        elif tc == sc:\n            implied.add(\"vertical\")\n        else:\n            raise AssertionError(\"gray source must touch orange by a 4-neighbor side\")\n    assert len(implied) == 1, \"singleton gray source has ambiguous orientation\"\n    return implied.pop()\n\n\ndef _fill_rows(\n    out: np.ndarray,\n    r0: int,\n    c0: int,\n    r1: int,\n    c1: int,\n    count: int,\n    contact_rows: set[int],\n) -> None:\n    width = int(c1 - c0 + 1)\n    height = int(r1 - r0 + 1)\n    assert count % width == 0, \"gray count must make complete orange rows\"\n    stripe_count = int(count // width)\n    assert 0 < stripe_count <= height, \"row fill must fit inside the orange rectangle\"\n\n    assert contact_rows in ({r0}, {r1}), \"horizontal bars must touch exactly one extreme row\"\n    if contact_rows == {r0}:\n        rows = list(range(r0, r0 + stripe_count))\n    else:\n        rows = list(range(r1 - stripe_count + 1, r1 + 1))\n\n    out[rows, c0 : c1 + 1] = Color.GRAY\n\n\ndef _fill_cols(\n    out: np.ndarray,\n    r0: int,\n    c0: int,\n    r1: int,\n    c1: int,\n    count: int,\n    contact_cols: set[int],\n) -> None:\n    width = int(c1 - c0 + 1)\n    height = int(r1 - r0 + 1)\n    assert count % height == 0, \"gray count must make complete orange columns\"\n    stripe_count = int(count // height)\n    assert 0 < stripe_count <= width, \"column fill must fit inside the orange rectangle\"\n\n    assert contact_cols in ({c0}, {c1}), \"vertical bars must touch exactly one extreme column\"\n    if contact_cols == {c0}:\n        cols = list(range(c0, c0 + stripe_count))\n    else:\n        cols = list(range(c1 - stripe_count + 1, c1 + 1))\n\n    out[r0 : r1 + 1, cols] = Color.GRAY\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each gray bar into its adjacent orange rectangle as full stripes from the contacted edge.\n\n    Input structure\n    - The scene uses black outside space, yellow fill, gray one-cell-thick bars, and solid orange rectangles.\n    - Each gray bar 4-touches exactly one orange rectangle; some orange rectangles have no touching gray bar.\n    - Gray bars touching the same orange rectangle all have the same orientation.\n\n    Rule\n    - Recolor every original gray cell to yellow.\n    - For each orange rectangle touched by gray bars, count the gray cells assigned to that rectangle.\n    - Horizontal gray bars repaint that many cells as complete orange rows starting from the contacted top or bottom row.\n    - Vertical gray bars repaint that many cells as complete orange columns starting from the contacted left or right column.\n    - Orange rectangles with no touching gray bar remain unchanged.\n\n    Key insight\n    - The gray pixels are not copied by shape; their count is transferred into the neighboring orange rectangle as edge-aligned row or column stripes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.YELLOW, Color.GRAY, Color.ORANGE}\n\n    orange = find_components(g, bg=Color.YELLOW, colors=[Color.ORANGE], connectivity=4)\n    gray = find_components(g, bg=Color.YELLOW, colors=[Color.GRAY], connectivity=4)\n    assert orange and gray, \"expected orange rectangles and gray source bars\"\n\n    orange_index: dict[tuple[int, int], int] = {}\n    orange_bboxes: list[tuple[int, int, int, int]] = []\n    for i, obj in enumerate(orange):\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        assert obj[\"area\"] == bbox_h(obj[\"bbox\"]) * bbox_w(obj[\"bbox\"])\n        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == Color.ORANGE)\n        orange_bboxes.append((int(r0), int(c0), int(r1), int(c1)))\n        for r, c in obj[\"coords\"]:\n            orange_index[(int(r), int(c))] = i\n\n    source_by_target: dict[int, list[tuple[dict, list[tuple[int, int, int, int]]]]] = {}\n    for src in gray:\n        touched: dict[int, list[tuple[int, int, int, int]]] = {}\n        for sr_raw, sc_raw in src[\"coords\"]:\n            sr = int(sr_raw)\n            sc = int(sc_raw)\n            for tr, tc in neighbors4(sr, sc):\n                target_i = orange_index.get((int(tr), int(tc)))\n                if target_i is not None:\n                    touched.setdefault(target_i, []).append((int(tr), int(tc), sr, sc))\n\n        assert len(touched) == 1, \"each gray bar must touch exactly one orange rectangle\"\n        target_i = next(iter(touched))\n        source_by_target.setdefault(target_i, []).append((src, touched[target_i]))\n\n    out = g.copy()\n    out[g == Color.GRAY] = Color.YELLOW\n\n    for target_i, sources in source_by_target.items():\n        r0, c0, r1, c1 = orange_bboxes[target_i]\n        orientations = {_orientation(src[\"coords\"], contacts) for src, contacts in sources}\n        assert len(orientations) == 1, \"all gray bars for one orange rectangle must share orientation\"\n        count = sum(int(src[\"area\"]) for src, _contacts in sources)\n        contacts = [contact for _src, src_contacts in sources for contact in src_contacts]\n\n        if orientations == {\"horizontal\"}:\n            contact_rows = {tr for tr, _tc, _sr, _sc in contacts}\n            assert contact_rows <= {r0, r1}\n            _fill_rows(out, r0, c0, r1, c1, count, contact_rows)\n        else:\n            assert orientations == {\"vertical\"}\n            contact_cols = {tc for _tr, tc, _sr, _sc in contacts}\n            assert contact_cols <= {c0, c1}\n            _fill_cols(out, r0, c0, r1, c1, count, contact_cols)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGRID_H_RANGE, GRID_W_RANGE = (10, 18), (14, 18)\nCONTENT_H_RANGE, CONTENT_W_RANGE = (6, 13), (12, 15)\nBORDER_RANGE = (0, 4)\n\nEDGES, HORIZONTAL_EDGES = (\"top\", \"bottom\", \"left\", \"right\"), (\"top\", \"bottom\")\nORANGE_COUNT_CHOICES, ORANGE_COUNT_WEIGHTS = [1, 2, 3, 4], [1, 2, 3, 4]\nORANGE_H_RANGE, ORANGE_W_RANGE = (1, 5), (2, 6)\nORANGE_AREA_RANGE = (4, 12)\nORANGE_PLACE_RETRIES = 80\n\nMAX_UNTOUCHED_ORANGES = 1\nBARS_PER_ORANGE_RANGE, TOTAL_BARS_RANGE = (1, 2), (2, 6)\nBAR_LENGTH_RANGE = (1, 7)\nBAR_COUNT_RETRIES = 50\n\nGENERATE_RETRIES = 300\n\n\ndef _place_orange(edge, cr0, cc0, cr1, cc1, occupied):\n    \"\"\"Try to place an orange rect flush against the given edge. Returns (or0,oc0,or1,oc1) or None.\"\"\"\n    for _ in range(ORANGE_PLACE_RETRIES):\n        oh = random.randint(*ORANGE_H_RANGE)\n        ow = random.randint(*ORANGE_W_RANGE)\n        if not (ORANGE_AREA_RANGE[0] <= oh * ow <= ORANGE_AREA_RANGE[1]):\n            continue\n        if edge in HORIZONTAL_EDGES:\n            or0 = cr0 if edge == 'top' else cr1 - oh + 1\n            or1 = or0 + oh - 1\n            lo, hi = cc0 + 1, cc1 - ow  # avoid touching perpendicular edges\n        else:\n            oc0 = cc0 if edge == 'left' else cc1 - ow + 1\n            oc1 = oc0 + ow - 1\n            lo, hi = cr0 + 1, cr1 - oh  # avoid touching perpendicular edges\n        if hi < lo:\n            continue\n        v = random.randint(lo, hi)\n        if edge in HORIZONTAL_EDGES:\n            oc0, oc1 = v, v + ow - 1\n        else:\n            or0, or1 = v, v + oh - 1\n        if or0 < cr0 or or1 > cr1 or oc0 < cc0 or oc1 > cc1:\n            continue\n        if occupied[or0:or1+1, oc0:oc1+1].any():\n            continue\n        return (or0, oc0, or1, oc1)\n    return None\n\n\ndef _make_canvas() -> tuple[np.ndarray, tuple[int, int, int, int]] | None:\n    content_h = random.randint(*CONTENT_H_RANGE)\n    content_w = random.randint(*CONTENT_W_RANGE)\n    border_top = random.randint(*BORDER_RANGE)\n    border_bottom = random.randint(*BORDER_RANGE)\n    border_left = random.randint(*BORDER_RANGE)\n    border_right = random.randint(*BORDER_RANGE)\n    grid_h = content_h + border_top + border_bottom\n    grid_w = content_w + border_left + border_right\n    if not (GRID_H_RANGE[0] <= grid_h <= GRID_H_RANGE[1] and GRID_W_RANGE[0] <= grid_w <= GRID_W_RANGE[1]):\n        return None\n\n    grid = np.full((grid_h, grid_w), Color.BLACK, dtype=int)\n    cr0, cc0 = border_top, border_left\n    cr1, cc1 = cr0 + content_h - 1, cc0 + content_w - 1\n    grid[cr0:cr1+1, cc0:cc1+1] = Color.YELLOW\n    return grid, (cr0, cc0, cr1, cc1)\n\n\ndef _place_oranges(content_box, occupied) -> list[tuple[str, int, int, int, int]] | None:\n    cr0, cc0, cr1, cc1 = content_box\n    num_orange = random.choices(ORANGE_COUNT_CHOICES, weights=ORANGE_COUNT_WEIGHTS)[0]\n    edges = random.sample(EDGES, num_orange)\n    orange_rects = []\n    for edge in edges:\n        result = _place_orange(edge, cr0, cc0, cr1, cc1, occupied)\n        if result is None:\n            return None\n        or0, oc0, or1, oc1 = result\n        occupied[or0:or1+1, oc0:oc1+1] = True\n        orange_rects.append((edge, or0, oc0, or1, oc1))\n    return orange_rects\n\n\ndef _choose_touched_oranges(num_orange):\n    max_untouched = min(MAX_UNTOUCHED_ORANGES, num_orange - 1)\n    num_untouched = random.randint(0, max_untouched) if num_orange > 1 else 0\n    indices = list(range(num_orange))\n    random.shuffle(indices)\n    untouched_set = set(indices[:num_untouched])\n    return [i for i in range(num_orange) if i not in untouched_set]\n\n\ndef _choose_bars_per_orange(touched_list):\n    for _ in range(BAR_COUNT_RETRIES):\n        bpo = [random.randint(*BARS_PER_ORANGE_RANGE) for _ in touched_list]\n        if TOTAL_BARS_RANGE[0] <= sum(bpo) <= TOTAL_BARS_RANGE[1]:\n            return bpo\n    return None\n\n\ndef _split_bar_lengths(total_gray, n_bars):\n    min_len, max_len = BAR_LENGTH_RANGE\n    if n_bars == 2 and total_gray >= 2:\n        lo_b1 = max(min_len, total_gray - max_len)\n        hi_b1 = min(total_gray - min_len, max_len)\n        if lo_b1 > hi_b1:\n            return None\n        b1 = random.randint(lo_b1, hi_b1)\n        return [b1, total_gray - b1]\n    if total_gray > max_len:\n        return None\n    return [total_gray]\n\n\ndef _place_bars(axis, fixed, span0, span1, lo_bound, hi_bound, bar_lengths, occupied):\n    placed_bars = []\n    for bl in bar_lengths:\n        sides = []\n        if span0 - lo_bound >= bl:\n            sides.append(0)\n        if hi_bound - span1 >= bl:\n            sides.append(1)\n        random.shuffle(sides)\n        placed = False\n        for s in sides:\n            b0 = (span0 - bl) if s == 0 else (span1 + 1)\n            b1 = b0 + bl - 1\n            cells = occupied[fixed, b0:b1+1] if axis == 'h' else occupied[b0:b1+1, fixed]\n            if b0 < lo_bound or b1 > hi_bound or cells.any():\n                continue\n            if axis == 'h':\n                occupied[fixed, b0:b1+1] = True\n                placed_bars.append(('h', fixed, b0, b1))\n            else:\n                occupied[b0:b1+1, fixed] = True\n                placed_bars.append(('v', b0, b1, fixed))\n            placed = True\n            break\n        if not placed:\n            return None\n    return placed_bars\n\n\ndef _plan_bars(orange_rects, touched_list, bpo, content_box, occupied):\n    \"\"\"Sample gray bars and return oracle metadata for expected output.\"\"\"\n    cr0, cc0, cr1, cc1 = content_box\n    bars_info = []\n    for idx, oi in enumerate(touched_list):\n        edge, or0, oc0, or1, oc1 = orange_rects[oi]\n        oh, ow = or1 - or0 + 1, oc1 - oc0 + 1\n        n_bars = bpo[idx]\n\n        if edge in HORIZONTAL_EDGES:\n            max_stripes, divisor = oh, ow\n        else:\n            max_stripes, divisor = ow, oh\n\n        stripe_count = random.randint(1, max_stripes)\n        total_gray = stripe_count * divisor\n        bar_lengths = _split_bar_lengths(total_gray, n_bars)\n        if bar_lengths is None:\n            return None\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/train/5b37cb25.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/train/5b37cb25.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, in_bounds, paste, random_free_location\nimport random\nfrom itertools import product\n\n\n_CROSS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))\n_DIRECTIONS = {\n    \"top\": (-1, 0),\n    \"bottom\": (1, 0),\n    \"left\": (0, -1),\n    \"right\": (0, 1),\n}\n\n\ndef _uniform_side(side: np.ndarray) -> int:\n    vals = np.unique(side)\n    assert len(vals) == 1, \"expected each frame side to be one solid color\"\n    return int(vals[0])\n\n\ndef _interior_colors(interior: np.ndarray) -> tuple[int, int]:\n    vals, counts = np.unique(interior, return_counts=True)\n    max_count = counts.max()\n    assert int(np.sum(counts == max_count)) == 1, \"expected a unique dominant interior background\"\n    bg = int(vals[int(np.argmax(counts))])\n    obj_colors = [int(v) for v in vals if int(v) != bg]\n    assert len(obj_colors) == 1, \"expected one interior foreground object color\"\n    return bg, obj_colors[0]\n\n\ndef _direction_for_notch(g: np.ndarray, r: int, c: int, obj: int) -> list[str]:\n    dirs = []\n    shape = g.shape\n    for name, (dr, dc) in _DIRECTIONS.items():\n        pr, pc = -dc, dr\n        support = (\n            (r - 2 * dr, c - 2 * dc),\n            (r - dr + pr, c - dc + pc),\n            (r - dr - pr, c - dc - pc),\n            (r + 2 * pr, c + 2 * pc),\n            (r - 2 * pr, c - 2 * pc),\n        )\n        open_side = (\n            (r + 2 * dr, c + 2 * dc),\n            (r + dr + pr, c + dc + pc),\n            (r + dr - pr, c + dc - pc),\n        )\n        if not all(in_bounds(shape, rr, cc) and int(g[rr, cc]) == obj for rr, cc in support):\n            continue\n        if not all((not in_bounds(shape, rr, cc)) or int(g[rr, cc]) != obj for rr, cc in open_side):\n            continue\n        dirs.append(name)\n    return dirs\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Fill each plus-shaped background notch with the color of the frame side it opens toward.\n\n    Input structure\n    - A one-cell-thick rectangular frame has four solid-colored sides and neutral corner pixels.\n    - The frame interior contains a dominant background color and one foreground object color.\n    - Some object boundaries contain five-pixel plus-shaped background notches.\n\n    Rule\n    - Find every background plus whose opposite side is supported by foreground object pixels and whose open side faces one frame side.\n    - Recolor the five pixels of that plus with the color of the facing frame side.\n    - Leave all other pixels unchanged.\n\n    Key insight\n    The frame side colors are direction labels for the open notches in the foreground object.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    h, w = g.shape\n    assert h >= 5 and w >= 5, \"expected room for a frame and plus notches\"\n\n    side_color = {\n        \"top\": _uniform_side(g[0, 1:-1]),\n        \"bottom\": _uniform_side(g[-1, 1:-1]),\n        \"left\": _uniform_side(g[1:-1, 0]),\n        \"right\": _uniform_side(g[1:-1, -1]),\n    }\n    bg, obj = _interior_colors(g[1:-1, 1:-1])\n\n    out = g.copy()\n    painted: set[tuple[int, int]] = set()\n    notch_count = 0\n    for r in range(1, h - 1):\n        for c in range(1, w - 1):\n            cross = tuple((r + dr, c + dc) for dr, dc in _CROSS)\n            if not all(int(g[rr, cc]) == bg for rr, cc in cross):\n                continue\n\n            dirs = _direction_for_notch(g, r, c, obj)\n            assert len(dirs) <= 1, \"expected each plus notch to open in at most one direction\"\n            if not dirs:\n                continue\n\n            notch_count += 1\n            color = side_color[dirs[0]]\n            for cell in cross:\n                assert cell not in painted, \"expected non-overlapping plus notches\"\n                painted.add(cell)\n                out[cell] = color\n\n    assert notch_count > 0, \"expected at least one plus notch\"\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\n_GEN_GRID_SIZE, _GEN_CORNER_COLOR = 30, 0\n_GEN_COLOR_POOL, _GEN_PALETTE_SIZE = range(1, 10), 6\n\n# Object size and total filled-area budget.\n_OBJECT_COUNT_MIN, _OBJECT_COUNT_MAX = 3, 4\n_OBJECT_DIM_MIN, _OBJECT_DIM_MAX = 5, 20\n_OBJECT_AREA_MIN, _OBJECT_AREA_MAX = 30, 180\n_TOTAL_OBJECT_AREA_MAX, _MIN_REMAINING_OBJECT_AREA = 360, 30\n\n# Placement gap against frame and other objects.\n_PLACEMENT_BORDER, _PLACEMENT_PADDING, _PLACEMENT_PADDING_CONNECTIVITY = 2, 2, 8\n\n# Notch geometry and counts.\n_GEN_CROSS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))\n_GEN_DIRECTIONS = {\n    \"top\": (-1, 0),\n    \"bottom\": (1, 0),\n    \"left\": (0, -1),\n    \"right\": (0, 1),\n}\n_EDGES = tuple(_GEN_DIRECTIONS)\n_NOTCH_EDGE_MARGIN, _MAX_TOTAL_NOTCHES = 2, 8\n_NOTCHES_PER_OBJECT = (1, 2, 3)\n\n# Rejection-sampling retry cap.\n_GEN_RETRY_LIMIT = 300\n_DIM_PAIRS = [(h, w) for h in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1)\n              for w in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1) if _OBJECT_AREA_MIN <= h * w <= _OBJECT_AREA_MAX]\n\n\ndef _notch_cells(r, c, direction):\n    dr, dc = _GEN_DIRECTIONS[direction]\n    pr, pc = -dc, dr\n    cross = tuple((r + rr, c + cc) for rr, cc in _GEN_CROSS)\n    support = (\n        (r - 2 * dr, c - 2 * dc),\n        (r - dr + pr, c - dc + pc),\n        (r - dr - pr, c - dc - pc),\n        (r + 2 * pr, c + 2 * pc),\n        (r - 2 * pr, c - 2 * pc),\n    )\n    open_side = (\n        (r + 2 * dr, c + 2 * dc),\n        (r + dr + pr, c + dc + pc),\n        (r + dr - pr, c + dc - pc),\n    )\n    return {\"direction\": direction, \"cross\": cross, \"support\": support, \"open_side\": open_side}\n\n\ndef _candidate_notches(r0, c0, h, w, edge):\n    if edge in (\"top\", \"bottom\"):\n        row = r0 if edge == \"top\" else r0 + h - 1\n        centers = [(row, c) for c in range(c0 + _NOTCH_EDGE_MARGIN, c0 + w - _NOTCH_EDGE_MARGIN)]\n    else:\n        col = c0 if edge == \"left\" else c0 + w - 1\n        centers = [(r, col) for r in range(r0 + _NOTCH_EDGE_MARGIN, r0 + h - _NOTCH_EDGE_MARGIN)]\n    return [_notch_cells(r, c, edge) for r, c in centers]\n\n\ndef _choose_notches(r0, c0, h, w, count):\n    edges = random.sample(_EDGES, count)\n    random.shuffle(edges)\n    choices = {edge: _candidate_notches(r0, c0, h, w, edge) for edge in edges}\n\n    def search(i, chosen, carved, protected):\n        if i == len(edges):\n            return chosen\n        options = choices[edges[i]][:]\n        random.shuffle(options)\n        for notch in options:\n            cross = set(notch[\"cross\"])\n            support = set(notch[\"support\"])\n            if cross & carved or cross & protected or support & carved:\n                continue\n            result = search(i + 1, chosen + [notch], carved | cross, protected | support)\n            if result is not None:\n                return result\n        return None\n\n    return search(0, [], set(), set())\n\n\ndef _notch_counts(n_objects):\n    total = random.randint(n_objects, min(_MAX_TOTAL_NOTCHES, max(_NOTCHES_PER_OBJECT) * n_objects))\n    plans = [p for p in product(_NOTCHES_PER_OBJECT, repeat=n_objects) if sum(p) == total]\n    plan = list(random.choice(plans))\n    random.shuffle(plan)\n    return plan\n\n\ndef _place_rectangles(out, obj, n_objects, counts):\n    \"\"\"Place object rectangles and return (r,c,h,w,notch_count) records, or None.\"\"\"\n    placement = np.zeros((_GEN_GRID_SIZE, _GEN_GRID_SIZE), dtype=int)\n    rects = []\n    total_area = 0\n    for i in range(n_objects):\n        remaining = n_objects - i - 1\n        area_cap = _TOTAL_OBJECT_AREA_MAX - _MIN_REMAINING_OBJECT_AREA * remaining\n        valid = [p for p in _DIM_PAIRS if total_area + p[0] * p[1] <= area_cap]\n        if not valid:\n            return None\n        h, w = random.choice(valid)\n        patch = np.ones((h, w), dtype=int)\n        try:\n            r, c = random_free_location(\n                placement, patch, transparent=0, border=_PLACEMENT_BORDER, padding=_PLACEMENT_PADDING,\n                padding_connectivity=_PLACEMENT_PADDING_CONNECTIVITY,\n            )\n        except ValueError:\n            return None\n        paste(placement, patch, r, c, transparent=0)\n        paste(out, np.full((h, w), obj, dtype=int), r, c)\n        rects.append((r, c, h, w, counts[i]))\n        total_area += h * w\n    return rects\n\n\ndef _apply_notches(out, notches, side_color, bg):\n    \"\"\"Paint output notches and return the matching carved input grid.\"\"\"\n    for notch in notches:\n        color = side_color[notch[\"direction\"]]\n        for rr, cc in notch[\"cross\"]:\n            out[rr, cc] = color\n\n    inp = out.copy()\n    for notch in notches:\n        for rr, cc in notch[\"cross\"]:\n            inp[rr, cc] = bg\n    return inp\n\n\ndef _passes_oracle(inp, out, n_objects, bg, obj):\n    \"\"\"Require the intended components and exact agreement with main().\"\"\"\n    comps = find_components(inp[1:-1, 1:-1], bg=bg, connectivity=4, monochromatic=True)\n    if len(comps) != n_objects or any(comp[\"color\"] != obj for comp in comps):\n        return False\n    try:\n        return np.array_equal(main(inp), out)\n    except Exception:\n        return False\n\n\ndef _gen_attempt():\n    top, bottom, left, right, bg, obj = random.sample(_GEN_COLOR_POOL, _GEN_PALETTE_SIZE)\n    side_color = {\"top\": top, \"bottom\": bottom, \"left\": left, \"right\": right}\n\n    out = np.full((_GEN_GRID_SIZE, _GEN_GRID_SIZE), bg, dtype=int)\n    out[0, 1:-1] = top\n    out[-1, 1:-1] = bottom\n    out[1:-1, 0] = left\n    out[1:-1, -1] = right\n    out[0, 0] = out[0, -1] = out[-1, 0] = out[-1, -1] = _GEN_CORNER_COLOR\n\n    n_objects = random.randint(_OBJECT_COUNT_MIN, _OBJECT_COUNT_MAX)\n    counts = _notch_counts(n_objects)\n    rects = _place_rectangles(out, obj, n_objects, counts)\n    if rects is None:\n        return None\n\n    notches = []\n    for r, c, h, w, count in rects:\n        chosen = _choose_notches(r, c, h, w, count)\n        if chosen is None:\n            return None\n        notches.extend(chosen)\n\n    inp = _apply_notches(out, notches, side_color, bg)\n    if not _passes_oracle(inp, out, n_objects, bg, obj):\n        return None\n    return inp\n\n\ndef generate_input():\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 5b37cb25 input\")\n","exit_code":0,"status":"completed"}}
