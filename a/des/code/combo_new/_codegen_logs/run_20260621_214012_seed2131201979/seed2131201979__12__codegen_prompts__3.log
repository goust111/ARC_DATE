L_FLIP_PROB = 0.5\n  45: \n  46: # Generation safety.\n  47: GENERATION_RETRIES = 300\n  48: \n  49: \n  50: def _ensure_palette_coverage(arr, palette):\n\n 106: def generate_input():\n 107:     for _ in range(GENERATION_RETRIES):\n 108:         grid = _gen_attempt()\n 109:         if grid is not None:\n 110:             return grid\n 111:     raise RuntimeError(\"failed to generate valid input\")\n\n\nFILE: /home/lixinyu/snap/new/ARC_code/train/aa62e3f4.py\n  17: def main(grid: np.ndarray) -> np.ndarray:\n  18:     \"\"\"\n  19:     Replace the outlined object with the outside contour of that outline in the marker color.\n  20: \n  21:     Input structure:\n  22:     - A dominant background surrounds one 8-connected foreground outline.\n  23:     - The outline is the unique largest foreground color.\n  24:     - One or more smaller interior colors are inside the outline; the marker color\n  25:       is the unique smallest non-outline color.\n  26: \n  27:     Rule:\n  28:     - Erase all original foreground pixels to background.\n  29:     - Paint every background pixel that is 4-adjacent to the outline with the\n  30:       marker color.\n  31:     - Keep the grid shape unchanged.\n  32: \n  33:     Key insight: The colored interior marker supplies the paint color, while the\n  34:     largest outline supplies only the contour whose outside edge is traced.\n  35:     \"\"\"\n  36:     g = np.asarray(grid, dtype=int)\n  37:     bg = int(get_bg(g))\n  38: \n  39:     counts = Counter(map(int, g.flatten()))\n  40:     foreground_colors = [color for color in counts if color != bg]\n  41:     assert len(foreground_colors) >= 2, \"expected an outline color and a marker color\"\n  42: \n  43:     frame_count = max(counts[color] for color in foreground_colors)\n  44:     frame_color = _unique_color_with_count(counts, foreground_colors, frame_count)\n  45:     assert len(components_mask(g == frame_color, connectivity=8)) == 1, \"outline must be 8-connected\"\n  46: \n  47