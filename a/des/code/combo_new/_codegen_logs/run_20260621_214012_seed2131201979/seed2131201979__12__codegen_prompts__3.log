:         group = [bar]\n  73:         current = bar\n  74:         while True:\n  75:             next_col = current[\"col\"] + current[\"height\"]\n  76:             next_bar = by_col.get(next_col)\n  77:             if next_bar is None:\n  78:                 break\n  79:             if next_bar[\"color\"] != BODY_COLOR:\n  80:                 break\n  81:             group.append(next_bar)\n  82:             current = next_bar\n  83: \n  84:         for item in group:\n  85:             rows = item[\"coords\"][:, 0]\n  86:             cols = item[\"coords\"][:, 1]\n  87:             out[rows, cols] = bg\n  88: \n  89:         for item in group:\n  90:             col = item[\"col\"]\n  91:             height = item[\"height\"]\n  92:             assert col + height <= g.shape[1]\n  93:             out[baseline, col : col + height] = item[\"color\"]\n  94: \n  95:     return out\n  96: \n  97: # --------------- generator (att2) ---------------\n  98: \n  99: # Canvas bounds.\n 100: MIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n 101: \n 102: # Bar and chain structure.\n 103: MIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\n 104: MIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\n 105: MIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n 106: \n 107: # Layout padding and retry budget.\n 108: GAP_VALUES = (1, 2, 3)\n 109: MAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n 110: \n 111: \n 112: def _chain_red_distributions(n_blue, n_red):\n\n 261: def generate_input():\n 262:     for _ in range(MAX_GENERATION_ATTEMPTS):\n 263:         grid = _gen_attempt()\n 264:         if grid is not None:\n 265:             return grid\n 266:     raise RuntimeError(\"failed to generate a valid 84551f4c input\")\n\n\nFILE: /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\n   7: def main(grid: np.ndarray) -> np.ndarray:\n   8:     \"\"\"\n   9:     Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n  10: \n  11:     Input structure:\n  12:     - The grid has a dominant background color.\n  13:     - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n  14:     - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n  15: \n  16:     Rule:\n  17:     - Keep the input pixels unchanged.\n  18:     - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n  19:     - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n  20: \n  21:     Key insight:\n  22:     - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n  23:     \"\"\"\n  24:     g = np.asarray(grid, dtype=int)\n  25:     bg = int(get_bg(g))\n  26:     out = g.copy()\n  27:     h, w = g.shape\n  28: \n  29:     markers: dict[int, int] = {}\n  30:     marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n  31:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n  32:         r0, c0, r1, c1 = comp[\"bbox\"]\n  33:         height = int(r1 - r0 + 1)\n  34:         if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n  35:             continue\n  36: \n  37:         sub = g[r0 : r1 + 1, c0 : c1 + 1]\n  38:         assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n  39:         assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n  40:         assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n  41:         source = int(sub[0, 0])\n  42:         halo = int(sub[0, 1])\n  43:         assert source != halo, \"legend source and halo colors must differ\"\n  44:         assert source not in markers, \"each source color must have exactly one legend marker\"\n  45: \n  46:         markers[source] = halo\n  47:         marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n  48: \n  49:     assert markers, \"expected at least one left-edge legend marker\"\n  50: \n  51:     for source, halo in markers.items():\n  52:         objects = []\n  53:         for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n  54:             cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n  55:             if cells <= marker_source_cells[source]:\n  56:                 continue\n  57:             objects.append(comp)\n  58:         assert objects, \"each legend source color must label at least one non-marker object\"\n  59: \n  60:         for obj in objects:\n  61:             r0, c0, r1, c1 = obj[\"bbox\"]\n  62:             pr0 = max(0, int(r0) - 1)\n  63:             pc0 = max(0, int(c0) - 1)\n  64:             pr1 = min(h - 1, int(r1) + 1)\n  65:             pc1 = min(w - 1, int(c1) + 1)\n  66: \n  67:             patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n  68:             coords = obj[\"coords\"]\n  69:             patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n  70:             enclosed = object_interior(patch, background=bg)\n  71:             fill_mask = (patch == bg) & ~enclosed\n  72: \n  73:             input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n  74:             target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n  75:             assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n  76:             assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n  77:             target[fill_mask] = halo\n  78: \n  79:     return out\n  80: \n  81: # --------------- generator (att1, Claude) ---------------\n  82: \n  83: # Canvas and color palette.\n  84: BACKGROUND = 0\n  85: GRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\n  86: AVAILABLE_COLORS = tuple(range(1, 10))\n  87: \n  88: # Legend layout.\n  89: LEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\n  90: LEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n  91: \n  92: # Sprite geometry and acceptance.\n  93: SPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\n  94: SPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\n  95: SPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\n  96: SPRITE_RETRIES = 300\n  97: \n  98: # Object counts and placement.\n  99: INSTANCE_MIN, INSTANCE_MAX = 1, 3\n 100: OBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\n 101: EDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\n 102: PLACEMENT_RETRIES = 200\n 103: \n 104: # Whole-sample retry budget.\n 105: GENERATION_RETRIES = 300\n 106: \n 107: \n 108: def _make_sprite(color):\n\n 260: def generate_input() -> np.ndarray:\n 261:     for _ in range(GENERATION_RETRIES):\n 262:         result = _gen_attempt()\n 263:         if result is not None:\n 264:             return result\n 265:     raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRIES} attempts\")\n\n\nFILE: /home/lixinyu/snap/new/ARC_code/train/db7260a4.py\n  36: def main(grid: np.ndarray) -> np.ndarray:\n  37:     \"\"\"\n  38:     Drop the singleton marker into the matching red U-shaped container, or make a bottom-row puddle if no closed container is hit.\n  39: \n  40:     Input structure\n  41:     - The grid has a dominant background, one singleton marker pixel on the top row,\n  42:       and one other foreground color forming vertical bars and bottom segments.\n  43:     - A closed container is a U shape: two vertical side bars with a continuous\n  44:       bottom segment between them and an empty rectangular interior above the bottom.\n  45: \n  46:     Rule\n  47:     - Remove the top marker from its original cell.\n  48:     - If exactly one closed U-shaped container has the marker column within its\n  49:       horizontal footprint, fill that container's empty interior with the marker color.\n  50:     - If no closed container is under the marker column, fill the whole bottom row\n  51:       with the marker color.\n  52: \n  53:     Key insight\n  54:     - The marker does not identify a color by value; it identifies a vertical drop\n  55:       column, and only a structurally closed U shape can catch and contain the fill.\n  56:     \"\"\"\n  57:     g = np.asarray(grid, dtype=int)\n  58:     assert g.ndim == 2\n  59: \n  60:     bg = get_bg(g)\n  61:     foreground_colors = colors_present(g, exclude={bg})\n  62:     assert len(foreground_colors) == 2, \"expected marker and wall colors\"\n  63: \n  64:     singleton_colors = [color for color in foreground_colors if int(np.count_nonzero(g == color)) == 1]\n  65:     assert len(singleton_colors) == 1, \"expected exactly one singleton marker color\"\n  66:     marker_color = singleton_colors[0]\n  67: \n  68:     wall_colors = [color for color in foreground_colors if color != marker_color]\n  69:     assert len(wall_colors) == 1\n  70:     wall_color = wall_colors[0]\n  71: \n  72:     marker_coords = np.argwhere(g == marker_color)\n  73:     assert marker_coords.shape == (1, 2)\n  74:     marker_r, marker_c = map(int, marker_coords[0])\n  75:     assert marker_r == 0, \"marker must sit on the top row\"\n  76: \n  77:     containers = [\n  78:         container\n  79:         for container in _closed_u_containers(g, wall_color, bg)\n  80:         if container[0] > marker_r and container[2] <= marker_c <= container[3]\n  81:     ]\n  82:     assert len(containers) <= 1, \"marker column must select at most one closed container\"\n  83: \n  84:     out = g.copy()\n  85:     out[marker_r, marker_c] = bg\n  86:     if containers:\n  87:         top, bottom, left, right = containers[0]\n  88:         out[top:bottom, left + 1 : right] = marker_color\n  89:     else:\n  90:         assert np.all(out[-1,