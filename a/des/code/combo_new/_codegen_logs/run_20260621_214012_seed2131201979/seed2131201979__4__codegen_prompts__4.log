{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/221dfab4.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import get_bg, label_mask\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Propagate a repeating striped pattern from a yellow border segment toward the opposite edge, recoloring foreground objects on certain stripes.\n\n    Input structure:\n    - bg = most common color. Foreground blobs of another color scattered in the interior.\n    - A short yellow (4) segment sits on one border edge.\n\n    Rule:\n    - From the yellow segment, march toward the opposite edge in steps of 2 cells, cycling colors Y, Y, G (4, 4, 3). The 1-cell gap between stripes is forced to bg.\n    - Yellow stripes paint only within the segment's span.\n    - Green stripes additionally recolor all non-bg pixels across the entire row/column to green.\n\n    Key insight: Green stripes act as a \"flood\" that recolors existing objects on the full row/column, while yellow stripes are confined to the segment span.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n    out = g.copy()\n\n    Y = 4\n    G = 3\n\n    border = np.zeros((H, W), dtype=bool)\n    border[0, :] = True\n    border[-1, :] = True\n    border[:, 0] = True\n    border[:, -1] = True\n\n    smask = (g == int(Y)) & border\n    if not bool(smask.any()):\n        return out\n\n    lab, n = label_mask(smask, connectivity=4)\n    if int(n) <= 0:\n        return out\n\n    best_id = max(range(1, int(n) + 1), key=lambda cid: int((lab == int(cid)).sum()))\n    pts = np.argwhere(lab == int(best_id))\n\n    rs = pts[:, 0]\n    cs = pts[:, 1]\n    r0, r1 = int(rs.min()), int(rs.max())\n    c0, c1 = int(cs.min()), int(cs.max())\n\n    if r0 == r1:\n        orient = \"h\"\n        start_pos = int(r0)\n        cols = sorted(int(c) for c in cs)\n        span = list(range(int(cols[0]), int(cols[-1]) + 1))\n        dir1 = 1 if start_pos == 0 else -1\n        limit = H\n    elif c0 == c1:\n        orient = \"v\"\n        start_pos = int(c0)\n        rows = sorted(int(r) for r in rs)\n        span = list(range(int(rows[0]), int(rows[-1]) + 1))\n        dir1 = 1 if start_pos == 0 else -1\n        limit = W\n    else:\n        # Unexpected: not a straight edge segment.\n        return out\n\n    cycle = [int(Y), int(Y), int(G)]\n\n    step = 0\n    while True:\n        pos = int(start_pos) + int(dir1) * (2 * int(step))\n        if not (0 <= pos < int(limit)):\n            break\n\n        col = int(cycle[int(step) % 3])\n\n        if orient == \"h\":\n            if col == int(G):\n                out[pos, :] = np.where(out[pos, :] != int(bg), int(G), out[pos, :])\n            for c in span:\n                out[pos, int(c)] = col\n            # Force the 1-cell gap to background within the segment span.\n            gap = int(start_pos) + int(dir1) * (2 * int(step) + 1)\n            if 0 <= gap < H:\n                for c in span:\n                    out[int(gap), int(c)] = int(bg)\n        else:\n            if col == int(G):\n                out[:, pos] = np.where(out[:, pos] != int(bg), int(G), out[:, pos])\n            for r in span:\n                out[int(r), pos] = col\n            gap = int(start_pos) + int(dir1) * (2 * int(step) + 1)\n            if 0 <= gap < W:\n                for r in span:\n                    out[int(r), int(gap)] = int(bg)\n\n        step += 1\n\n    return out\n\n\n# --------------- generator ---------------\nimport random\nfrom arc_utils import random_sprite, random_free_location\n\n\ndef _gen_attempt():\n    rng = random.Random()\n\n    H = rng.randint(25, 30)\n    W = rng.randint(22, 30)\n\n    # Pick bg and fg colors (not yellow=4 or green=3)\n    available = [c for c in range(10) if c not in (3, 4)]\n    bg, fg = rng.sample(available, 2)\n\n    # Pick edge and yellow segment\n    edge = rng.choice(['top', 'bottom', 'left', 'right'])\n    seg_len = rng.randint(3, 8)\n\n    if edge in ('top', 'bottom'):\n        # horizontal segment: columns span, must not touch corners (col 0 or W-1)\n        max_start = W - 1 - seg_len  # last col of span = start + seg_len - 1 <= W-2\n        if max_start < 1:\n            return None\n        seg_start = rng.randint(1, max_start)\n        span = list(range(seg_start, seg_start + seg_len))\n        orient = 'h'\n        edge_row = 0 if edge == 'top' else H - 1\n    else:\n        # vertical segment: rows span, must not touch corners (row 0 or H-1)\n        max_start = H - 1 - seg_len\n        if max_start < 1:\n            return None\n        seg_start = rng.randint(1, max_start)\n        span = list(range(seg_start, seg_start + seg_len))\n        orient = 'v'\n        edge_col = 0 if edge == 'left' else W - 1\n\n    # Start with bg grid\n    grid = np.full((H, W), bg, dtype=int)\n\n    # Place yellow segment on border\n    if orient == 'h':\n        for c in span:\n            grid[edge_row, c] = 4\n    else:\n        for r in span:\n            grid[r, edge_col] = 4\n\n    # Determine which rows/cols are on the trajectory (both stripe and gap positions)\n    # to avoid placing blobs on the edge row/col itself\n    if orient == 'h':\n        forbidden_rows = {edge_row}\n    else:\n        forbidden_cols = {edge_col}\n\n    # Scatter 5-9 amorphous fg blobs in the interior\n    n_blobs = rng.randint(5, 9)\n    canvas = grid.copy()\n\n    for _ in range(n_blobs):\n        # Random blob size: aim for 5-67 pixels, bbox dims 2-15\n        bh = rng.randint(2, 10)\n        bw = rng.randint(2, 10)\n        density = rng.uniform(0.4, 0.85)\n\n        try:\n            sprite = random_sprite(bh, bw, density=density, symmetry=\"not_symmetric\",\n                                   color_palette=[fg], connectivity=4, background=bg)\n        except (AssertionError, RecursionError):\n            continue\n\n        # Trim bg border rows/cols from sprite\n        mask = (sprite != bg)\n        rows_any = np.any(mask, axis=1)\n        cols_any = np.any(mask, axis=0)\n        if not rows_any.any():\n            continue\n        r0, r1 = np.where(rows_any)[0][[0, -1]]\n        c0, c1 = np.where(cols_any)[0][[0, -1]]\n        sprite = sprite[r0:r1+1, c0:c1+1]\n\n        sh, sw = sprite.shape\n        pix = int(np.sum(sprite != bg))\n        if pix < 5 or pix > 67:\n            continue\n\n        # Find placement: border=1 to keep away from grid edges, padding=1 for separation\n        try:\n            pr, pc = random_free_location(canvas, sprite, transparent=bg, border=1, padding=1)\n        except ValueError:\n            continue\n\n        # Check forbidden row/col constraints\n        sprite_mask = (sprite != bg)\n        blob_rows = set(int(pr + dr) for dr in range(sh) if sprite_mask[dr].any())\n        blob_cols = set(int(pc + dc) for dc in range(sw) if sprite_mask[:, dc].any())\n\n        if orient == 'h' and blob_rows & forbidden_rows:\n            continue\n        if orient == 'v' and blob_cols & forbidden_cols:\n            continue\n\n        # Paste blob\n        for dr in range(sh):\n            for dc in range(sw):\n                if sprite[dr, dc] != bg:\n                    canvas[pr + dr, pc + dc] = sprite[dr, dc]\n\n    # Count blobs placed\n    fg_mask = (canvas != bg) & (canvas != 4)\n    lab, n_placed = label_mask(fg_mask, connectivity=4)\n    if n_placed < 5:\n        return None\n\n    # Now canvas is our INPUT grid. Build the expected output via solver.\n    inp = canvas.copy()\n    out = main(inp)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):\n        b = int(b)\n        f = int(f)\n        if b == bg:\n            continue\n        mapping[b] = f\n\n    return mapping, pal_mask\n\n\ndef _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:\n    \"\"\"\n    Find background regions (excluding the palette area) that do NOT touch the grid boundary,\n    and fill each region based on the most common adjacent border color (mapped via palette).\n    \"\"\"\n    h, w = out.shape\n    bg_mask = (out == bg) & (~pal_mask)\n    comps = components_mask(bg_mask, connectivity=4)\n    for pts in comps:\n        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/465b7d93.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/465b7d93.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import deque\n\nimport numpy as np\n\nfrom arc_utils import bbox, colors_present, draw_line, find_components, get_bg, is_contiguous, paste, random_free_location\nimport random\n\n\ndef _rect_frame_bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:\n    b = bbox(mask)\n    if b is None:\n        return None\n    r0, c0, r1, c1 = b\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    if h < 3 or w < 3:\n        return None\n\n    expected = np.zeros_like(mask, dtype=bool)\n    expected[r0 : r1 + 1, c0] = True\n    expected[r0 : r1 + 1, c1] = True\n    expected[r0, c0 : c1 + 1] = True\n    expected[r1, c0 : c1 + 1] = True\n    if not np.array_equal(mask, expected):\n        return None\n    return int(r0), int(c0), int(r1), int(c1)\n\n\ndef _scaled_index(i: int, src_len: int, dst_len: int) -> int:\n    assert src_len >= 1 and dst_len >= 1, \"axis lengths must be positive\"\n    if src_len == 1:\n        assert dst_len == 1, \"a one-pixel motif axis maps to a one-pixel interior axis\"\n        return 0\n    assert dst_len >= 2, \"multi-pixel motif axis needs a multi-pixel interior axis\"\n    return int(round(int(i) * (dst_len - 1) / (src_len - 1)))\n\n\ndef _fill_enclosed(stroke: np.ndarray) -> np.ndarray:\n    h, w = stroke.shape\n    open_space = ~stroke.astype(bool)\n    padded = np.pad(open_space, 1, constant_values=True)\n    seen = np.zeros_like(padded, dtype=bool)\n    q: deque[tuple[int, int]] = deque()\n    ph, pw = padded.shape\n\n    for r in range(ph):\n        for c in (0, pw - 1):\n            if padded[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                q.append((int(r), int(c)))\n    for c in range(pw):\n        for r in (0, ph - 1):\n            if padded[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                q.append((int(r), int(c)))\n\n    while q:\n        r, c = q.popleft()\n        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):\n            if 0 <= nr < ph and 0 <= nc < pw and padded[nr, nc] and not seen[nr, nc]:\n                seen[nr, nc] = True\n                q.append((int(nr), int(nc)))\n\n    holes = open_space & ~seen[1 : h + 1, 1 : w + 1]\n    return stroke.astype(bool) | holes\n\n\ndef _stretch_sprite(sprite: np.ndarray, target_shape: tuple[int, int]) -> np.ndarray:\n    src_h, src_w = sprite.shape\n    dst_h, dst_w = target_shape\n    assert sprite.any(), \"expected a nonempty sprite\"\n\n    stroke = np.zeros((dst_h, dst_w), dtype=int)\n    coords = np.argwhere(sprite)\n    mapped: dict[tuple[int, int], tuple[int, int]] = {}\n    for sr, sc in coords:\n        tr = _scaled_index(int(sr), src_h, dst_h)\n        tc = _scaled_index(int(sc), src_w, dst_w)\n        mapped[(int(sr), int(sc))] = (tr, tc)\n        stroke[tr, tc] = 1\n\n    for sr, sc in coords:\n        sr = int(sr)\n        sc = int(sc)\n        for nr, nc in ((sr + 1, sc), (sr, sc + 1)):\n            if (nr, nc) in mapped:\n                r0, c0 = mapped[(sr, sc)]\n                r1, c1 = mapped[(nr, nc)]\n                draw_line(stroke, r0, c0, end_r=r1, end_c=c1, color=1)\n\n    return _fill_enclosed(stroke.astype(bool))\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.\n\n    Input structure:\n    - The background is the dominant color.\n    - There are exactly two foreground colors: one forms a complete rectangular\n      one-pixel-thick frame, and the other forms one 4-connected sprite outside it.\n    - The frame interior is initially background.\n\n    Rule:\n    - Clear the original sprite from its outside location.\n    - Map the sprite bbox to the frame interior bbox, sending bbox extremes to\n      interior extremes.\n    - Draw straight horizontal or vertical segments between mapped positions of\n      adjacent sprite pixels, then fill any enclosed background region inside\n      those drawn segments.\n\n    Key insight:\n    The outside sprite is a miniature line/fill diagram for the frame interior,\n    not a bitmap to scale by block replication.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected one frame color and one sprite color\"\n\n    frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []\n    for color in colors:\n        frame_bbox = _rect_frame_bbox(g == int(color))\n        if frame_bbox is not None:\n            frame_candidates.append((int(color), frame_bbox))\n    assert len(frame_candidates) == 1, \"expected a unique rectangular frame\"\n\n    frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]\n    sprite_color = next(color for color in colors if color != frame_color)\n    sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)\n    assert len(sprite_components) == 1, \"expected a single 4-connected sprite\"\n    frame_region = np.zeros_like(g, dtype=bool)\n    frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True\n    assert not np.any((g == sprite_color) & frame_region), \"sprite must start outside the frame\"\n\n    sr0, sc0, sr1, sc1 = sprite_components[0][\"bbox\"]\n    sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color\n\n    ir0, ic0 = fr0 + 1, fc0 + 1\n    ir1, ic1 = fr1 - 1, fc1 - 1\n    assert ir0 <= ir1 and ic0 <= ic1, \"frame must have an interior\"\n    interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]\n    assert np.all(interior == bg), \"frame interior must start empty\"\n\n    stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))\n    out = g.copy()\n    out[g == sprite_color] = bg\n    out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and observed fixed colors.\n_GRID_SHAPE = (10, 10)\n_COLOR_COUNT = 10\n_BG = 7\n_FRAME_COLOR = 6\n\n# Frame size bounds and retry budget.\n_FRAME_SIZE_MIN = 3\n_FRAME_SIZE_MAX = 8\n_SINGLE_PIXEL_FRAME_SIZE = 3\n_MAX_GENERATION_ATTEMPTS = 300\n\n# Sprite color pool and source masks.\n_SPRITE_COLORS = tuple(c for c in range(_COLOR_COUNT) if c not in {_BG, _FRAME_COLOR})\n_SPRITE_SINGLE = np.ones((1, 1), dtype=bool)\n_SPRITE_PATTERNS_2X2 = [\n    np.array([[1, 1], [1, 0]], dtype=bool),\n    np.array([[1, 1], [0, 1]], dtype=bool),\n    np.array([[1, 0], [1, 1]], dtype=bool),\n    np.array([[0, 1], [1, 1]], dtype=bool),\n    np.array([[1, 1], [1, 1]], dtype=bool),\n]\n\ndef _outside_locations(\n    frame_bbox: tuple[int, int, int, int], patch_shape: tuple[int, int]\n) -> list[tuple[int, int]]:\n    fr0, fc0, fr1, fc1 = frame_bbox\n    ph, pw = patch_shape\n    locations: list[tuple[int, int]] = []\n    for r in range(_GRID_SHAPE[0] - ph + 1):\n        for c in range(_GRID_SHAPE[1] - pw + 1):\n            pr0, pc0, pr1, pc1 = r, c, r + ph - 1, c + pw - 1\n            separated = pr1 < fr0 or pr0 > fr1 or pc1 < fc0 or pc0 > fc1\n            if separated:\n                locations.append((r, c))\n    return locations\n\ndef _frame_positions(size: int, patch_shape: tuple[int, int]) -> list[tuple[int, int]]:\n    positions: list[tuple[int, int]] = []\n    for r in range(_GRID_SHAPE[0] - size + 1):\n        for c in range(_GRID_SHAPE[1] - size + 1):\n            frame_bbox = (r, c, r + size - 1, c + size - 1)\n            if _outside_locations(frame_bbox, patch_shape):\n                positions.append((r, c))\n    return positions\n\ndef _draw_frame(grid: np.ndarray, r0: int, c0: int, size: int, color: int) -> None:\n    r1, c1 = r0 + size - 1, c0 + size - 1\n    grid[r0 : r1 + 1, c0] = color\n    grid[r0 : r1 + 1, c1] = color\n    grid[r0, c0 : c1 + 1] = color\n    grid[r1, c0 : c1 + 1] = color\n\ndef _sample_sprite(size: int) -> np.ndarray:\n    return _SPRITE_SINGLE.copy() if size == _SINGLE_PIXEL_FRAME_SIZE else random.choice(_SPRITE_PATTERNS_2X2).copy()\n\ndef _sample_case() -> tuple[int, int, np.ndarray]:\n    sprite_color = random.choice(_SPRITE_COLORS)\n    size = random.randint(_FRAME_SIZE_MIN, _FRAME_SIZE_MAX)\n    return sprite_color, size, _sample_sprite(size)\n\ndef _build_candidate_grids(\n    frame_bbox: tuple[int, int, int, int], sprite: np.ndarray, sprite_color: int\n) -> tuple[np.ndarray, np.ndarray] | None:\n    fr0, fc0, fr1, fc1 = frame_bbox\n    stretched = _stretch_sprite(sprite, (fr1 - fr0 - 1, fc1 - fc0 - 1))\n    if not np.any(stretched):\n        return None\n\n    out = np.full(_GRID_SHAPE, _BG, dtype=int)\n    _draw_frame(out, fr0, fc0, fr1 - fr0 + 1, _FRAME_COLOR)\n    out[fr0 + 1 : fr1, fc0 + 1 : fc1][stretched] = sprite_color\n\n    inp = out.copy()\n    inp[fr0 + 1 : fr1, fc0 + 1 : fc1] = _BG\n\n    locations = _outside_locations(frame_bbox, sprite.shape)\n    if not locations:\n        return None\n    sr, sc = random.choice(locations)\n    patch = np.where(sprite, sprite_color, _BG)\n    paste(inp, patch, sr, sc, transparent=_BG)\n    return inp, out\n\ndef _gen_attempt() -> np.ndarray | None:\n    sprite_color, size, sprite = _sample_case()\n","exit_code":0,"status":"completed"}}
