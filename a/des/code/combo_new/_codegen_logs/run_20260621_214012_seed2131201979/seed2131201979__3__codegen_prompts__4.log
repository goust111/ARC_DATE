{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/135a2760.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repair noisy periodic patterns inside frame-delimited grid regions.\n\n    Input structure:\n    - Frame color (most common) forms full rows/cols, dividing the grid into rectangular regions.\n    - bg (second most common) fills empty space; each region contains a small colored tile repeated periodically with a few corrupted pixels.\n\n    Rule:\n    - For each region, find the bounding box of non-bg content.\n    - Infer the smallest repeating tile that explains the pattern (majority vote per residue position), requiring it repeat at least 2x per axis.\n    - Replace the region with the clean tiled version.\n\n    Key insight: Tile dimensions are unknown and must be inferred; prefer the smallest tile with genuine repetition over one that memorizes the entire region.\n    \"\"\"\n    g = np.array(grid, dtype=int).copy()\n    H, W = g.shape\n\n    cnt = Counter(map(int, g.flatten()))\n    frame = int(cnt.most_common(1)[0][0])\n    bg = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(frame):\n            bg = int(col)\n            break\n    assert not (bg is None)\n\n    fr = [int(r) for r in range(H) if bool((g[int(r), :] == int(frame)).all())]\n    fc = [int(c) for c in range(W) if bool((g[:, int(c)] == int(frame)).all())]\n    fr = sorted(set(fr))\n    fc = sorted(set(fc))\n\n    assert fr\n    assert fc\n\n    if fr[0] != 0:\n        fr = [-1] + fr\n    if fr[-1] != (H - 1):\n        fr = fr + [H]\n    else:\n        fr = fr + [H]\n\n    if fc[0] != 0:\n        fc = [-1] + fc\n    if fc[-1] != (W - 1):\n        fc = fc + [W]\n    else:\n        fc = fc + [W]\n\n    def reconstruct(core: np.ndarray, maxp: int = 12) -> np.ndarray:\n        h, w = core.shape\n        best_all = None  # ((mism, area), B)\n        best_ok = None\n\n        for ph in range(1, min(int(maxp), int(h)) + 1):\n            for pw in range(1, min(int(maxp), int(w)) + 1):\n                tile = np.zeros((int(ph), int(pw)), dtype=int)\n                for i in range(int(ph)):\n                    for j in range(int(pw)):\n                        vals = core[int(i) :: int(ph), int(j) :: int(pw)].flatten()\n                        tile[int(i), int(j)] = int(Counter(map(int, vals)).most_common(1)[0][0])\n\n                B = np.tile(tile, ((h + ph - 1) // ph, (w + pw - 1) // pw))[:h, :w]\n                mism = int(np.sum(B != core))\n                area = int(ph * pw)\n                key = (mism, area)\n\n                if best_all is None or key < best_all[0]:\n                    best_all = (key, B)\n\n                # Require some repetition (avoid memorizing the entire core).\n                ok = True\n                if int(ph) == int(h) and int(pw) == int(w):\n                    ok = False\n                if int(ph) < int(h) and (int(h) // int(ph)) < 2:\n                    ok = False\n                if int(pw) < int(w) and (int(w) // int(pw)) < 2:\n                    ok = False\n                if ok and (best_ok is None or key < best_ok[0]):\n                    best_ok = (key, B)\n\n        return (best_ok or best_all)[1]\n\n    out = g.copy()\n    for i in range(len(fr) - 1):\n        r0, r1 = int(fr[i]), int(fr[i + 1])\n        if int(r1 - r0) <= 1:\n            continue\n        rr0, rr1 = int(r0 + 1), int(r1 - 1)\n\n        for j in range(len(fc) - 1):\n            c0, c1 = int(fc[j]), int(fc[j + 1])\n            if int(c1 - c0) <= 1:\n                continue\n            cc0, cc1 = int(c0 + 1), int(c1 - 1)\n\n            A = g[rr0 : rr1 + 1, cc0 : cc1 + 1]\n            m = A != int(bg)\n            if not bool(m.any()):\n                continue\n\n            rs = np.where(m.any(axis=1))[0]\n            cs = np.where(m.any(axis=0))[0]\n            rmin, rmax = int(rs.min()), int(rs.max())\n            cmin, cmax = int(cs.min()), int(cs.max())\n\n            core = A[rmin : rmax + 1, cmin : cmax + 1]\n            rec = reconstruct(core)\n\n            A2 = A.copy()\n            A2[rmin : rmax + 1, cmin : cmax + 1] = rec\n            out[rr0 : rr1 + 1, cc0 : cc1 + 1] = A2\n\n    return out\n\n\ndef generate_input() -> np.ndarray:\n    bg = 0\n    frame = 5\n\n    # Region grid (2x2 or 3x2) with 1px frame separators.\n    n_r = int(np.random.randint(2, 4))\n    n_c = int(np.random.randint(2, 3))\n\n    r_sizes = [int(np.random.randint(6, 11)) for _ in range(n_r)]\n    c_sizes = [int(np.random.randint(6, 11)) for _ in range(n_c)]\n\n    H = int(sum(r_sizes) + (n_r + 1))\n    W = int(sum(c_sizes) + (n_c + 1))\n\n    g = np.full((H, W), int(frame), dtype=int)\n\n    # Fill each region with bg and optionally a repeating tile with noise.\n    any_pattern = False\n    r0 = 1\n    for i, rh in enumerate(r_sizes):\n        c0 = 1\n        for j, cw in enumerate(c_sizes):\n            region = np.full((int(rh), int(cw)), int(bg), dtype=int)\n\n            if bool(np.random.rand() < 0.85) or not any_pattern:\n                any_pattern = True\n                ph = int(np.random.randint(1, min(4, rh) + 1))\n                pw = int(np.random.randint(1, min(4, cw) + 1))\n\n                pal = [int(c) for c in np.random.choice(range(1, 10), size=int(np.random.randint(2, 5)), replace=False)]\n                pal = [c for c in pal if int(c) != int(frame)]\n                if not pal:\n                    pal = [2, 3]\n\n                tile = np.full((ph, pw), int(bg), dtype=int)\n                # Ensure at least one non-bg in the tile.\n                tile[int(np.random.randint(0, ph)), int(np.random.randint(0, pw))] = int(pal[0])\n                # Add a few more colored cells.\n                k = int(np.random.randint(0, ph * pw))\n                idx = np.random.choice(ph * pw, size=int(k), replace=False)\n                for t in idx:\n                    tile.flat[int(t)] = int(pal[int(np.random.randint(0, len(pal)))])\n\n                tiled = np.tile(tile, ((rh + ph - 1) // ph, (cw + pw - 1) // pw))[:rh, :cw]\n                region[:, :] = tiled\n\n                # Add small noise (flip a few cells) so reconstruction does real work.\n                n_noise = int(np.random.randint(0, max(1, (rh * cw) // 20)))\n                for _ in range(n_noise):\n                    rr = int(np.random.randint(0, rh))\n                    cc = int(np.random.randint(0, cw))\n                    if int(region[rr, cc]) != int(bg):\n                        region[rr, cc] = int(pal[int(np.random.randint(0, len(pal)))])\n\n            g[int(r0) : int(r0 + rh), int(c0) : int(c0 + cw)] = region\n            c0 += int(cw) + 1\n        r0 += int(rh) + 1\n\n    return g\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/5b37cb25.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, in_bounds, paste, random_free_location\nimport random\nfrom itertools import product\n\n\n_CROSS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))\n_DIRECTIONS = {\n    \"top\": (-1, 0),\n    \"bottom\": (1, 0),\n    \"left\": (0, -1),\n    \"right\": (0, 1),\n}\n\n\ndef _uniform_side(side: np.ndarray) -> int:\n    vals = np.unique(side)\n    assert len(vals) == 1, \"expected each frame side to be one solid color\"\n    return int(vals[0])\n\n\ndef _interior_colors(interior: np.ndarray) -> tuple[int, int]:\n    vals, counts = np.unique(interior, return_counts=True)\n    max_count = counts.max()\n    assert int(np.sum(counts == max_count)) == 1, \"expected a unique dominant interior background\"\n    bg = int(vals[int(np.argmax(counts))])\n    obj_colors = [int(v) for v in vals if int(v) != bg]\n    assert len(obj_colors) == 1, \"expected one interior foreground object color\"\n    return bg, obj_colors[0]\n\n\ndef _direction_for_notch(g: np.ndarray, r: int, c: int, obj: int) -> list[str]:\n    dirs = []\n    shape = g.shape\n    for name, (dr, dc) in _DIRECTIONS.items():\n        pr, pc = -dc, dr\n        support = (\n            (r - 2 * dr, c - 2 * dc),\n            (r - dr + pr, c - dc + pc),\n            (r - dr - pr, c - dc - pc),\n            (r + 2 * pr, c + 2 * pc),\n            (r - 2 * pr, c - 2 * pc),\n        )\n        open_side = (\n            (r + 2 * dr, c + 2 * dc),\n            (r + dr + pr, c + dc + pc),\n            (r + dr - pr, c + dc - pc),\n        )\n        if not all(in_bounds(shape, rr, cc) and int(g[rr, cc]) == obj for rr, cc in support):\n            continue\n        if not all((not in_bounds(shape, rr, cc)) or int(g[rr, cc]) != obj for rr, cc in open_side):\n            continue\n        dirs.append(name)\n    return dirs\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Fill each plus-shaped background notch with the color of the frame side it opens toward.\n\n    Input structure\n    - A one-cell-thick rectangular frame has four solid-colored sides and neutral corner pixels.\n    - The frame interior contains a dominant background color and one foreground object color.\n    - Some object boundaries contain five-pixel plus-shaped background notches.\n\n    Rule\n    - Find every background plus whose opposite side is supported by foreground object pixels and whose open side faces one frame side.\n    - Recolor the five pixels of that plus with the color of the facing frame side.\n    - Leave all other pixels unchanged.\n\n    Key insight\n    The frame side colors are direction labels for the open notches in the foreground object.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    h, w = g.shape\n    assert h >= 5 and w >= 5, \"expected room for a frame and plus notches\"\n\n    side_color = {\n        \"top\": _uniform_side(g[0, 1:-1]),\n        \"bottom\": _uniform_side(g[-1, 1:-1]),\n        \"left\": _uniform_side(g[1:-1, 0]),\n        \"right\": _uniform_side(g[1:-1, -1]),\n    }\n    bg, obj = _interior_colors(g[1:-1, 1:-1])\n\n    out = g.copy()\n    painted: set[tuple[int, int]] = set()\n    notch_count = 0\n    for r in range(1, h - 1):\n        for c in range(1, w - 1):\n            cross = tuple((r + dr, c + dc) for dr, dc in _CROSS)\n            if not all(int(g[rr, cc]) == bg for rr, cc in cross):\n                continue\n\n            dirs = _direction_for_notch(g, r, c, obj)\n            assert len(dirs) <= 1, \"expected each plus notch to open in at most one direction\"\n            if not dirs:\n                continue\n\n            notch_count += 1\n            color = side_color[dirs[0]]\n            for cell in cross:\n                assert cell not in painted, \"expected non-overlapping plus notches\"\n                painted.add(cell)\n                out[cell] = color\n\n    assert notch_count > 0, \"expected at least one plus notch\"\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\n_GEN_GRID_SIZE, _GEN_CORNER_COLOR = 30, 0\n_GEN_COLOR_POOL, _GEN_PALETTE_SIZE = range(1, 10), 6\n\n# Object size and total filled-area budget.\n_OBJECT_COUNT_MIN, _OBJECT_COUNT_MAX = 3, 4\n_OBJECT_DIM_MIN, _OBJECT_DIM_MAX = 5, 20\n_OBJECT_AREA_MIN, _OBJECT_AREA_MAX = 30, 180\n_TOTAL_OBJECT_AREA_MAX, _MIN_REMAINING_OBJECT_AREA = 360, 30\n\n# Placement gap against frame and other objects.\n_PLACEMENT_BORDER, _PLACEMENT_PADDING, _PLACEMENT_PADDING_CONNECTIVITY = 2, 2, 8\n\n# Notch geometry and counts.\n_GEN_CROSS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))\n_GEN_DIRECTIONS = {\n    \"top\": (-1, 0),\n    \"bottom\": (1, 0),\n    \"left\": (0, -1),\n    \"right\": (0, 1),\n}\n_EDGES = tuple(_GEN_DIRECTIONS)\n_NOTCH_EDGE_MARGIN, _MAX_TOTAL_NOTCHES = 2, 8\n_NOTCHES_PER_OBJECT = (1, 2, 3)\n\n# Rejection-sampling retry cap.\n_GEN_RETRY_LIMIT = 300\n_DIM_PAIRS = [(h, w) for h in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1)\n              for w in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1) if _OBJECT_AREA_MIN <= h * w <= _OBJECT_AREA_MAX]\n\n\ndef _notch_cells(r, c, direction):\n    dr, dc = _GEN_DIRECTIONS[direction]\n    pr, pc = -dc, dr\n    cross = tuple((r + rr, c + cc) for rr, cc in _GEN_CROSS)\n    support = (\n        (r - 2 * dr, c - 2 * dc),\n        (r - dr + pr, c - dc + pc),\n        (r - dr - pr, c - dc - pc),\n        (r + 2 * pr, c + 2 * pc),\n        (r - 2 * pr, c - 2 * pc),\n    )\n    open_side = (\n        (r + 2 * dr, c + 2 * dc),\n        (r + dr + pr, c + dc + pc),\n        (r + dr - pr, c + dc - pc),\n    )\n    return {\"direction\": direction, \"cross\": cross, \"support\": support, \"open_side\": open_side}\n\n\ndef _candidate_notches(r0, c0, h, w, edge):\n    if edge in (\"top\", \"bottom\"):\n        row = r0 if edge == \"top\" else r0 + h - 1\n        centers = [(row, c) for c in range(c0 + _NOTCH_EDGE_MARGIN, c0 + w - _NOTCH_EDGE_MARGIN)]\n    else:\n        col = c0 if edge == \"left\" else c0 + w - 1\n        centers = [(r, col) for r in range(r0 + _NOTCH_EDGE_MARGIN, r0 + h - _NOTCH_EDGE_MARGIN)]\n    return [_notch_cells(r, c, edge) for r, c in centers]\n\n\ndef _choose_notches(r0, c0, h, w, count):\n    edges = random.sample(_EDGES, count)\n    random.shuffle(edges)\n    choices = {edge: _candidate_notches(r0, c0, h, w, edge) for edge in edges}\n\n    def search(i, chosen, carved, protected):\n        if i == len(edges):\n            return chosen\n        options = choices[edges[i]][:]\n        random.shuffle(options)\n        for notch in options:\n            cross = set(notch[\"cross\"])\n            support = set(notch[\"support\"])\n            if cross & carved or cross & protected or support & carved:\n                continue\n            result = search(i + 1, chosen + [notch], carved | cross, protected | support)\n            if result is not None:\n                return result\n        return None\n\n    return search(0, [], set(), set())\n\n\ndef _notch_counts(n_objects):\n    total = random.randint(n_objects, min(_MAX_TOTAL_NOTCHES, max(_NOTCHES_PER_OBJECT) * n_objects))\n    plans = [p for p in product(_NOTCHES_PER_OBJECT, repeat=n_objects) if sum(p) == total]\n    plan = list(random.choice(plans))\n    random.shuffle(plan)\n    return plan\n\n\ndef _place_rectangles(out, obj, n_objects, counts):\n    \"\"\"Place object rectangles and return (r,c,h,w,notch_count) records, or None.\"\"\"\n    placement = np.zeros((_GEN_GRID_SIZE, _GEN_GRID_SIZE), dtype=int)\n    rects = []\n    total_area = 0\n    for i in range(n_objects):\n        remaining = n_objects - i - 1\n        area_cap = _TOTAL_OBJECT_AREA_MAX - _MIN_REMAINING_OBJECT_AREA * remaining\n        valid = [p for p in _DIM_PAIRS if total_area + p[0] * p[1] <= area_cap]\n        if not valid:\n            return None\n        h, w = random.choice(valid)\n        patch = np.ones((h, w), dtype=int)\n        try:\n            r, c = random_free_location(\n                placement, patch, transparent=0, border=_PLACEMENT_BORDER, padding=_PLACEMENT_PADDING,\n                padding_connectivity=_PLACEMENT_PADDING_CONNECTIVITY,\n            )\n        except ValueError:\n            return None\n        paste(placement, patch, r, c, transparent=0)\n        paste(out, np.full((h, w), obj, dtype=int), r, c)\n        rects.append((r, c, h, w, counts[i]))\n        total_area += h * w\n    return rects\n\n\ndef _apply_notches(out, notches, side_color, bg):\n    \"\"\"Paint output notches and return the matching carved input grid.\"\"\"\n    for notch in notches:\n        color = side_color[notch[\"direction\"]]\n        for rr, cc in notch[\"cross\"]:\n            out[rr, cc] = color\n\n    inp = out.copy()\n    for notch in notches:\n        for rr, cc in notch[\"cross\"]:\n            inp[rr, cc] = bg\n    return inp\n\n\ndef _passes_oracle(inp, out, n_objects, bg, obj):\n    \"\"\"Require the intended components and exact agreement with main().\"\"\"\n    comps = find_components(inp[1:-1, 1:-1], bg=bg, connectivity=4, monochromatic=True)\n    if len(comps) != n_objects or any(comp[\"color\"] != obj for comp in comps):\n        return False\n    try:\n        return np.array_equal(main(inp), out)\n    except Exception:\n        return False\n\n\ndef _gen_attempt():\n    top, bottom, left, right, bg, obj = random.sample(_GEN_COLOR_POOL, _GEN_PALETTE_SIZE)\n    side_color = {\"top\": top, \"bottom\": bottom, \"left\": left, \"right\": right}\n\n    out = np.full((_GEN_GRID_SIZE, _GEN_GRID_SIZE), bg, dtype=int)\n","exit_code":0,"status":"completed"}}
