stride = strides[0]\n  69:     panel_w = stride + 1\n  70: \n  71:     interior_values = []\n  72:     for c0, c1 in zip(separators, separators[1:]):\n  73:         interior_values.extend(g[1:-1, c0 + 1 : c1].ravel())\n  74:     fill = _unique_most_common(interior_values)\n  75: \n  76:     panels = []\n  77:     for c0, c1 in zip(separators, separators[1:]):\n  78:         panel = g[:, c0 : c1 + 1]\n  79:         assert panel.shape == (h, panel_w)\n  80:         assert np.all(panel[0, :] == frame)\n  81:         assert np.all(panel[-1, :] == frame)\n  82:         assert np.all(panel[:, 0] == frame)\n  83:         assert np.all(panel[:, -1] == frame)\n  84:         panels.append(panel)\n  85: \n  86:     template_sprite, template_mask, first_top, template_left = _extract_sprite(panels[0], fill)\n  87:     top_rows = [first_top]\n  88:     for panel in panels[1:]:\n  89:         sprite, sprite_mask, top, local_c0 = _extract_sprite(panel, fill)\n  90:         assert local_c0 == template_left\n  91:         assert sprite_mask.shape == template_mask.shape\n  92:         assert np.array_equal(sprite_mask, template_mask)\n  93:         assert np.array_equal(sprite[sprite_mask], template_sprite[template_mask])\n  94:         top_rows.append(top)\n  95: \n  96:     deltas = [b - a for a, b in zip(top_rows, top_rows[1:])]\n  97:     assert len(deltas) >= 1 and len(set(deltas)) == 1\n  98:     next_top = _round_half_up(\n  99:         Fraction(top_rows[-1], 1) + Fraction(deltas[0] * panel_w, stride)\n 100:     )\n 101: \n 102:     sprite_h, sprite_w = template_sprite.shape\n 103:     assert 1 <= next_top and next_top + sprite_h <= h - 1\n 104:     assert 1 <= template_left and template_left + sprite_w <= panel_w - 1\n 105: \n 106:     out = np.full((h, panel_w), fill, dtype=int)\n 107:     out[0, :] = frame\n 108:     out[-1, :] = frame\n 109:     out[:, 0] = frame\n 110:     out[:, -1] = frame\n 111: \n 112:     target = out[next_top : next_top + sprite_h, template_left : template_left + sprite_w]\n 113:     target[template_mask] = template_sprite[template_mask]\n 114:     return out\n 115: \n 116: # --------------- generator (att2) ---------------\n 117: _GEN_HEIGHT, _GEN_LOCAL_LEFT = 16, 2\n 118: _GEN_INTERIOR_WIDTHS, _GEN_PANEL_COUNTS = (4, 5), (3, 4)\n 119: _GEN_COLORS = tuple(range(10))\n 120: _GEN_SPRITE_USES_FRAME_PROB = 0.3\n 121: _GEN_SPRITE_HEIGHTS, _GEN_SPRITE_WIDTHS = (1, 2), (2, 3)\n 122: _GEN_MIN_SPRITE_PIXELS, _GEN_MAX_SPRITE_PIXELS = 2, 5\n 123: _GEN_DELTAS = (-3, -2, -1, 1, 2, 3)\n 124: _GEN_MAX_ATTEMPTS = 300\n 125: _GEN_MASK_CACHE = {}\n 126: \n-- generate_input @ line 238\n 238: def generate_input():\n 239:     for _ in range(_GEN_MAX_ATTEMPTS):\n 240:         inp = _gen_attempt()\n 241:         if inp is not None:\n 242:             return inp\n 243:     raise RuntimeError(\"failed to generate valid ba1aa698 input\")\nEND_FILE\nFILE: /home/lixinyu/snap/new/ARC_code/train/17829a00.py\n-- main @ line 20\n  20: def main(grid: np.ndarray) -> np.ndarray:\n  21:     \"\"\"\n  22:     Move each colored object vertically until it touches the matching top or bottom border bar.\n  23: \n  24:     Input structure:\n  25:     - The background is the dominant color.\n  26:     - The top row is a full-width bar in one foreground color and the bottom row is a full-width bar in another.\n  27:     - All other foreground pixels are 8-connected monochrome objects whose color matches one of those bars.\n  28: \n  29:     Rule:\n  30:     - Top-bar-colored objects move upward so their bbox top is row 1.\n  31:     - Bottom-bar-colored objects move downward so their bbox bottom is the row above the bottom bar.\n  32:     - A downward-moving one-column segment whose landing overlaps its source becomes the continuous vertical segment swept between them.\n  33: \n  34:     Key insight:\n  35:     The horizontal bars are destination anchors: color determines which border an object slides toward, while columns and object shape are otherwise