           dr = (h - 2) - r1\n  86:                 assert dr >= 0\n  87:                 paint = coords + np.array([dr, 0], dtype=int)\n  88:                 if dr > 0 and r0 + dr <= r1:\n  89:                     assert c0 == c1\n  90:                     rows = np.arange(r0, r1 + dr + 1, dtype=int)\n  91:                     paint = np.column_stack([rows, np.full(rows.shape, c0, dtype=int)])\n  92: \n  93:             assert bool(np.all((0 <= paint[:, 0]) & (paint[:, 0] < h)))\n  94:             assert bool(np.all((0 <= paint[:, 1]) & (paint[:, 1] < w)))\n  95:             assert bool(np.all(out[paint[:, 0], paint[:, 1]] == bg))\n  96:             out[paint[:, 0], paint[:, 1]] = color\n  97: \n  98:     return out\n  99: \n 100: # --------------- generator (o5x) ---------------\n 101: \n 102: from scipy.ndimage import binary_dilation\n 103: \n 104: # -- Grid constants --\n 105: BG = 7\n 106: H = 16\n 107: W = 16\n 108: \n 109: # -- Sprite geometry --\n 110: SPRITE_AREA_MIN = 1\n 111: SPRITE_AREA_MAX = 6\n 112: SPRITE_H_MAX = 4       # bbox height upper bound (exclusive in range)\n 113: SPRITE_W_MAX = 5       # bbox width upper bound (exclusive in range)\n 114: SPRITE_DENSITY_MIN = 0.33  # min fill ratio inside bbox\n 115: \n 116: # -- Object counts per side --\n 117: OBJ_COUNT_MIN = 3      # per color\n 118: OBJ_COUNT_MAX = 5      # per color (inclusive)\n 119: OBJ_TOTAL_MAX = 9      # top_count + bottom_count\n 120: \n 121: # -- Swept segment (single-column overlap case) --\n 122: SWEPT_PROB = 0.15       # probability of including one swept-segment object\n 123: SWEPT_H_MIN = 2        # min input height for swept column\n 124: SWEPT_H_MAX = 4        # max input height (inclusive)\n 125: SWEPT_TOTAL_MAX = 5    # input_h + offset ceiling\n 126: \n 127: # -- Input derivation --\n 128: SLIDE_OFFSET_MAX = 10  # exclusive upper bound for slide offsets (range(1, N))\n 129: \n 130: # -- Retry budgets --\n 131: PLACE_RETRIES = 60     # sprite placement attempts per objec