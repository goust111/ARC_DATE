eturn (or0, oc0, or1, oc1)\n204:     return None\n205: \n206: \n207: def _make_canvas() -> tuple[np.ndarray, tuple[int, int, int, int]] | None:\n208:     content_h = random.randint(*CONTENT_H_RANGE)\n209:     content_w = random.randint(*CONTENT_W_RANGE)\n210:     border_top = random.randint(*BORDER_RANGE)\n211:     border_bottom = random.randint(*BORDER_RANGE)\n212:     border_left = random.randint(*BORDER_RANGE)\n213:     border_right = random.randint(*BORDER_RANGE)\n214:     grid_h = content_h + border_top + border_bottom\n215:     grid_w = content_w + border_left + border_right\n216:     if not (GRID_H_RANGE[0] <= grid_h <= GRID_H_RANGE[1] and GRID_W_RANGE[0] <= grid_w <= GRID_W_RANGE[1]):\n217:         return None\n218: \n219:     grid = np.full((grid_h, grid_w), Color.BLACK, dtype=int)\n220:     cr0, cc0 = border_top, border_left\n221:     cr1, cc1 = cr0 + content_h - 1, cc0 + content_w - 1\n222:     grid[cr0:cr1+1, cc0:cc1+1] = Color.YELLOW\n223:     return grid, (cr0, cc0, cr1, cc1)\n224: \n225: \n226: def _place_oranges(content_box, occupied) -> list[tuple[str, int, int, int, int]] | None:\n227:     cr0, cc0, cr1, cc1 = content_box\n228:     num_orange = random.choices(ORANGE_COUNT_CHOICES, weights=ORANGE_COUNT_WEIGHTS)[0]\n229:     edges = random.sample(EDGES, num_orange)\n230:     orange_rects = []\n231:     for edge in edges:\n232:         result = _place_orange(edge, cr0, cc0, cr1, cc1, occupied)\n233:         if result is None:\n234:             return None\n235:         or0, oc0, or1, oc1 = result\n236:         occupied[or0:or1+1, oc0:oc1+1] = True\n237:         orange_rects.append((edge, or0, oc0, or1, oc1))\n238:     return orange_rects\n239: \n240: \n241: def _choose_touched_oranges(num_orange):\n242:     max_untouched = min(MAX_UNTOUCHED_ORANGES, num_orange - 1)\n243:     num_untouched = random.randint(0, max_untouched) if num_orange > 1 else 0\n244:     indices = list(range(num_orange))\n245:     random.shuffle(indices)\n246:     untouched_set = set(indices[:num_untouched])\n247:     return [i for i in range(num_orange) if i not in untouched_set]\n248: \n249: \n250: def _choose_bars_per_orange(touched_list):\n251:     for _ in range(BAR_COUNT_RETRIES):\n252:         bpo = [random.randint(*BARS_PER_ORANGE_RANGE) for _ in touched_list]\n253:         if TOTAL_BARS_RANGE[0] <= sum(bpo) <= TOTAL_BARS_RANGE[1]:\n254:             return bpo\n255:     return None\n256: \n257: \n258: def _split_bar_lengths(total_gray, n_bars):\n259:     min_len, max_len = BAR_LENGTH_RANGE\n260:     if n_bars == 2 and total_gray >= 2:\n261:         lo_b1 = max(min_len, total_gray - max_len)\n262:         hi_b1 = min(total_gray - min_len, max_len)\n263:         if lo_b1 > hi_b1:\n264:             return None\n265:         b1 = random.randint(lo_b1, hi_b1)\n266:         return [b1, total_gray - b1]\n267:     if total_gray > max_len:\n268:         return None\n269:     return [total_gray]\n270: \n271: \n272: def _place_bars(axis, fixed, span0, span1, lo_bound, hi_bound, bar_lengths, occupied):\n273:     placed_bars = []\n274:     for bl in bar_lengths:\n275:         sides = []\n276:         if span0 - lo_bound >= bl:\n277:             sides.append(0)\n278:         if hi_bound - span1 >= bl:\n279:             sides.append(1)\n280:         random.shuffle(sides)\n281:         placed = False\n282:         for s in sides:\n283:             b0 = (span0 - bl) if s == 0 else (span1 + 1)\n284:             b1 = b0 + bl - 1\n285:             cells = occupied[fixed, b0:b1+1] if axis == 'h' else occupied[b0:b1+1, fixed]\n286:             if b0 < lo_bound or b1 > hi_bound or cells.any():\n287:                 continue\n288:             if axis == 'h':\n289:                 occupied[fixed, b0:b1+1] = True\n290:                 placed_bars.append(('h', fixed, b0, b1))\n291:             else:\n292:                 occupied[b0:b1+1, fixed] = True\n293:                 placed_bars.append(('v', b0, b1, fixed))\n294:             placed = True\n295:          