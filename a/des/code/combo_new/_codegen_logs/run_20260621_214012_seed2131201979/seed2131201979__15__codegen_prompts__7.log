+ LEGEND_BUFFER)\n371:         legend_occupied[r_lo:r_hi, c_lo:c_hi] = True\n372:         legends.append((wc, (dr, dc)))\n373: \n374:     return legend_occupied, legends\n375: \n376: \n377: def _grow_regions(rng: random.Random, legends: list[tuple[int, tuple[int,int]]],\n378:                   legend_occupied: np.ndarray,\n379:                   ) -> list[dict] | None:\n380:     \"\"\"Grow irregular closed regions, one per assigned wall color.\n381: \n382:     Returns list of region dicts or None on failure.\n383:     \"\"\"\n384:     h, w = legend_occupied.shape\n385:     color_dir = {wc: d for wc, d in legends}\n386:     all_colors = [wc for wc, _ in legends]\n387: \n388:     # Assign 1-3 regions per wall color, cap total.\n389:     region_colors = []\n390:     for c in all_colors:\n391:         region_colors.extend([c] * rng.randint(*REGIONS_PER_COLOR))\n392:     if len(region_colors) > MAX_TOTAL_REGIONS:\n393:         region_colors = rng.sample(region_colors, MAX_TOTAL_REGIONS)\n394:     rng.shuffle(region_colors)\n395: \n396:     size_min, size_max = REGION_SIZE_BOUNDS[len(region_colors)]\n397:     occupied = legend_occupied.copy()\n398:     regions = []\n399: \n400:     for rc in region_colors:\n401:         dr, dc = color_dir[rc]\n402:         target_size = rng.randint(size_min, size_max)\n403: \n404:         # Build canvas: interior cells (not border) that are unoccupied.\n405:         canvas = np.ones((h, w), dtype=bool)\n406:         canvas[0, :] = False; canvas[-1, :] = False\n407:         canvas[:, 0] = False; canvas[:, -1] = False\n408:         canvas &= ~occupied\n409:         if not canvas.any():\n410:             continue\n411: \n412:         blob = _try_grow_valid_blob(rng, canvas, occupied, target_size, h, w)\n413:         if blob is None:\n414:             continue\n415: \n416:         walls = _blob_wall_cells(blob, h, w)\n417:         regions.append({'color': rc, 'dir': (dr, dc), 'interior': blob, 'walls': walls})\n418: \n419:         # Reserve b