e):\n116:             tr, tc = target\n117:             assert g[tr, tc] == square[4]\n118:             paint.add(target)\n119: \n120:     for r, c in remove_sources:\n121:         out[r, c] = bg\n122:     for r, c in paint:\n123:         out[r, c] = Color.MAROON\n124: \n125:     return out\n126: \n127: # --------------- generator (o5x) ---------------\n128: \n129: from arc_utils import paste\n130: \n131: \n132: # Colors.\n133: _GEN_BG = 8\n134: _GEN_GREY = 5\n135: _GEN_PINK = 6\n136: _GEN_MAROON = 9\n137: \n138: # Canvas and square geometry.\n139: _GEN_CANVAS_MIN = 9\n140: _GEN_CANVAS_MAX = 15\n141: _GEN_CANVAS_MAX_DELTA = 2\n142: _GEN_SQUARE_SIZE = 3\n143: _GEN_SQUARE_LAST = _GEN_SQUARE_SIZE - 1\n144: _GEN_SQUARE_GAP = 1\n145: \n146: # Square count bounds.\n147: _GEN_TOTAL_SQUARE_MIN = 1\n148: _GEN_TOTAL_SQUARE_MAX = 7\n149: _GEN_GREY_SQUARE_MAX = 3\n150: _GEN_PINK_SQUARE_MAX = 4\n151: \n152: # Marker side and count bounds.\n153: _GEN_SIDES = (\"left\", \"right\", \"above\", \"below\")\n154: _GEN_MARKER_SIDE_MIN = 1\n155: _GEN_MARKER_SIDE_MAX = 3\n156: _GEN_MARKER_PER_SIDE_MAX = 3\n157: _GEN_MARKER_TOTAL_MAX = 5\n158: \n159: # Rejection sampling budget.\n160: _GEN_MAX_ATTEMPTS = 300\n161: _GEN_SQUARE_PATCHES = {color: np.full((_GEN_SQUARE_SIZE, _GEN_SQUARE_SIZE), color, dtype=int) for color in (_GEN_GREY, _GEN_PINK)}\n162: \n163: _GenSquare = tuple[int, int, int]\n164: _GenMarker = tuple[int, int, str]\n165: \n166: \n167: def _gen_square_gap_ok(r0: int, c0: int, squares: list[_GenSquare]) -> bool:\n168:     last = _GEN_SQUARE_LAST\n169:     gap = _GEN_SQUARE_GAP\n170:     r1, c1 = r0 + last, c0 + last\n171:     for sr0, sc0, _color in squares:\n172:         sr1, sc1 = sr0 + last, sc0 + last\n173:         if not (\n174:             r1 < sr0 - gap\n175:             or sr1 < r0 - gap\n176:             or c1 < sc0 - gap\n177:             or sc1 < c0 - gap\n178:         ):\n179:             return False\n180:     return True\n181: \n182: \n183: def _gen_place_square(grid: np.ndarray, r0: int, c0: int, color: int) -> None:\n184:     paste(grid, _GEN_SQUARE_PATCHES[int(color)], r0, c0)\n185: \n186: \n187: def _gen_side_for_cell(r: int, c: int, square: _GenSquare) -> str | None:\n188:     r0, c0, _color = square\n189:     r1, c1 = r0 + _GEN_SQUARE_LAST, c0 + _GEN_SQUARE_LAST\n190:     if r0 <= r <= r1:\n191:         if c == c0 - 1:\n192:             return \"left\"\n193:         if c == c1 + 1:\n194:             return \"right\"\n195:     if c0 <= c <= c1:\n196:         if r == r0 - 1:\n197:             return \"above\"\n198:         if r == r1 + 1:\n199:             return \"below\"\n200:     return None\n201: \n202: \n203: def _gen_inside_square(r: int, c: int, square: _GenSquare) -> bool:\n204:     r0, c0, _color = square\n205:     r1, c1 = r0 + _GEN_SQUARE_LAST, c0 + _GEN_SQUARE_LAST\n206:     return r0 <= r <= r1 and c0 <= c <= c1\n207: \n208: \n209: def _gen_valid_marker_slot(r: int, c: int, squares: list[_GenSquare]) -> bool:\n210:     if any(_gen_inside_square(r, c, square) for square in squares):\n211:         return False\n212:     hits = sum(\n213:         _gen_side_for_cell(r, c, square) is not None for square in squares\n214:     )\n215:     return hits == 1\n216: \n217: \n218: def _gen_side_slots(H: int, W: int, square: _GenSquare, squares: list[_GenSquare]) -> dict[str, list[tuple[int, int]]]:\n219:     r0, c0, _color = square\n220:     edge = _GEN_SQUARE_SIZE\n221:     raw = {\n222:         \"left\": [(r, c0 - 1) for r in range(r0, r0 + edge)] if c0 > 0 else [],\n223:         \"right\": [(r, c0 + edge) for r in range(r0, r0 + edge)] if c0 + edge < W else [],\n224:         \"above\": [(r0 - 1, c) for c in range(c0, c0 + edge)] if r0 > 0 else [],\n225:         \"below\": [(r0 + edge, c) for c in range(c0, c0 + edge)] if r0 + edge < H else [],\n226:     }\n227:     return {\n228:         side: [\n229:             (r, c)\n230:             for r, c in slots\n231:             if _gen_valid_marker_slot(r, c, squares)\n232:         ]\n233:         for side, slots in raw.items()\n234:     }\n235: \n236: \n237: def _gen_split_marker_total(total: int, caps: list[int]) -> list[int] | None:\n238:     counts: list[int] = []\n239:     remaining = int(total)\n240:     for i, cap in enumerate(caps):\n241:         rest = caps[i + 1 :]\n242:         lo = max(1, remaining - sum(rest))\n243:         hi = min(int(cap), remaining - len(rest))\n--- lines 404-433 ---\n404:     return np.array_equal(solved, expected)\n405: \n406: \n407: def _gen_attempt() -> np.ndarray | None:\n408:     H, W = _gen_choose_canvas_shape()\n409:     colors = _gen_choose_square_colors()\n410: \n411:     squares = _gen_place_squares(H, W, colors)\n412:     if squares is None:\n413:         return None\n414: \n415:     markers_by_square = _gen_choose_all_markers(H, W, squares)\n416:     if markers_by_square is None:\n417:         return None\n418: \n419:     out = _gen_render_output(H, W, squares, markers_by_square)\n420:     inp = _gen_build_input(out, squares, markers_by_square)\n421:     if not _gen_background_dominates(inp):\n422:         return None\n423:     if not _gen_oracle_accepts(inp, out):\n424:         return None\n425:     return inp\n426: \n427: \n428: def generate_input() -> np.ndarray:\n429:     for _ in range(_GEN_MAX_ATTEMPTS):\n430:         grid = _gen_attempt()\n431:         if grid is not None:\n432:             return grid\n433:     raise RuntimeError(\"failed to generate valid e39e9282 input\")\n","exit_code":0,"status":"completed"}}
