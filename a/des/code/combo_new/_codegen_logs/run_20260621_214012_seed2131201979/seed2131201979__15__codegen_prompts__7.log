{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport ast\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/9b5080bb.py',\n'/home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py',\n'/home/lixinyu/snap/new/ARC_code/eval/b10624e5.py',\n'/home/lixinyu/snap/new/ARC_code/train/6165ea8f.py',\n]\nfor path in files:\n    print('='*80)\n    print(path)\n    text = Path(path).read_text()\n    lines = text.splitlines()\n    tree = ast.parse(text)\n    for node in tree.body:\n        if isinstance(node, ast.FunctionDef) and node.name in ('main', 'generate_input'):\n            print('-'*40)\n            print(node.name)\n            seg = '\\\\n'.join(lines[node.lineno-1:node.end_lineno])\n            print(seg)\nPY\"","aggregated_output":"================================================================================\n/home/lixinyu/snap/new/ARC_code/train/9b5080bb.py\n----------------------------------------\nmain\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor the small defect bars on each shared-color object with the opposite panel color.\n\n    Input structure\n    - The grid contains two large panel colors and one shared object color.\n    - Each shared-color object is a mostly solid rectangle inside exactly one panel.\n    Rule\n    - Find the near-solid rectangular core of each object.\n    - Missing core pixels and one-cell protrusions define two-pixel bars perpendicular to the nearest core edge.\n    - Recolor those bars with the other panel color; leave all other pixels unchanged.\n    Key insight\n    - The colors to add are not tied to numeric ids: each object's surrounding panel identifies the opposite panel color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = g.copy()\n\n    object_color, components, panel_colors = _object_components(g)\n    for coords in components:\n        neighbors = _neighbor_colors(g, coords, object_color)\n        assert len(neighbors) == 1\n        panel_color = next(iter(neighbors))\n        target_colors = panel_colors - {panel_color}\n        assert len(target_colors) == 1\n        target_color = next(iter(target_colors))\n\n        rect = _core_rect(coords)\n        for r, c in _defect_bar_cells(coords, rect):\n            assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1]\n            assert int(g[r, c]) in {object_color, panel_color}\n            out[r, c] = target_color\n\n    return out\n----------------------------------------\ngenerate_input\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATE_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATE_ATTEMPTS} attempts\")\n================================================================================\n/home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py\n----------------------------------------\nmain\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Shear the rectangular input down-left onto a black canvas.\n\n    Input structure\n    A rectangular grid of colored pixels with no internal empty region to infer.\n\n    Rule\n    Create a black output with the same height and width W + H - 1, then copy\n    each input row r unchanged starting at column H - 1 - r.\n\n    Key insight\n    The colors and row contents are preserved; only the row offsets change so\n    the left edge forms a descending diagonal.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    out = np.zeros((h, w + h - 1), dtype=int)\n    for r in range(h):\n        start = h - 1 - r\n        out[r, start : start + w] = g[r]\n    return out\n----------------------------------------\ngenerate_input\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n================================================================================\n/home/lixinyu/snap/new/ARC_code/eval/b10624e5.py\n----------------------------------------\nmain\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replicate a motif across quadrants with scaling and reflection keyed to red anchor blocks.\n\n    Input structure:\n    - Grid divided into four quadrants by a full-row and full-column divider of a single non-bg color.\n    - Each quadrant contains a red (2) square anchor block of varying size.\n    - The top-left quadrant also has a colored motif attached to its red anchor.\n\n    Rule:\n    - Use the top-left quadrant's motif as the source pattern.\n    - For each other quadrant, scale the motif by the ratio of that quadrant's red block size to the source red block size.\n    - Reflect horizontally for right-side quadrants, vertically for bottom quadrants (both for bottom-right).\n    - Align the scaled/reflected motif so its red region overlaps the target anchor, then stamp non-bg pixels.\n\n    Key insight: Red block size encodes the scale factor; quadrant position encodes the reflection axes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    out = g.copy()\n\n    bg = get_bg(g)\n    mid_r, mid_c = _find_dividers(g, bg)\n\n    # Find red anchor blocks (color 2) in each quadrant.\n    red = components_mask(g == 2, connectivity=4)\n    assert red, \"grid must contain red (color 2) anchor blocks\"\n\n    # Quadrant key: (top/bottom, left/right)\n    anchors: dict[tuple[int, int], tuple[int, int, int]] = {}\n    # value: (r0,c0,size)\n    for pts in red:\n        r0, c0, r1, c1 = bbox_coords(pts)\n        rr = (r0 + r1) // 2\n        cc = (c0 + c1) // 2\n        qb = 0 if rr < mid_r else 1\n        qr = 0 if cc < mid_c else 1\n        size = max(r1 - r0 + 1, c1 - c0 + 1)\n        key = (qb, qr)\n        assert key not in anchors, \"each quadrant must contain exactly one red anchor block\"\n        anchors[key] = (int(r0), int(c0), int(size))\n\n    assert (0, 0) in anchors, \"top-left quadrant must contain a red anchor block\"\n    sr0, sc0, sL = anchors[(0, 0)]\n    assert sL > 0, \"top-left red anchor must have positive size\"\n\n    # Build a source patch around the TL motif: take the non-bg connected component (4-neigh)\n    # in the TL quadrant that contains the TL red anchor.\n    tl = g[0:mid_r, 0:mid_c]\n    comps = components_mask(tl != bg, connectivity=4)\n    patch_bb = None\n    for pts in comps:\n        # component contains any red pixel?\n        if any(tl[r, c] == 2 for r, c in pts):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            patch_bb = (int(r0), int(c0), int(r1), int(c1))\n            break\n    assert patch_bb is not None, \"top-left quadrant must contain a non-bg component with a red pixel\"\n\n    pr0, pc0, pr1, pc1 = patch_bb\n    patch = tl[pr0 : pr1 + 1, pc0 : pc1 + 1].copy()\n\n    def resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:\n        src_h, src_w = img.shape\n        if new_h <= 0 or new_w <= 0:\n            return img.copy()\n        rr = (np.floor(np.arange(new_h) * src_h / new_h)).astype(int)\n        cc = (np.floor(np.arange(new_w) * src_w / new_w)).astype(int)\n        rr = np.clip(rr, 0, src_h - 1)\n        cc = np.clip(cc, 0, src_w - 1)\n        return img[rr[:, None], cc[None, :]]\n\n    # For each quadrant anchor, paste a scaled/reflected version of the patch.\n    for (qb, qr), (tr0, tc0, tL) in anchors.items():\n        if (qb, qr) == (0, 0):\n            continue\n        patch_t = patch\n        if qr == 1:\n            patch_t = np.fliplr(patch_t)\n        if qb == 1:\n            patch_t = np.flipud(patch_t)\n\n        ratio = float(tL) / float(sL)\n        new_h = int(round(patch_t.shape[0] * ratio))\n        new_w = int(round(patch_t.shape[1] * ratio))\n        new_h = max(1, new_h)\n        new_w = max(1, new_w)\n        patch_s = resize_nn(patch_t, new_h, new_w)\n        roundtrip = resize_nn(patch_s, patch_t.shape[0], patch_t.shape[1])\n        assert np.array_equal(roundtrip, patch_t), \"scaling must preserve all motif information\"\n\n        # Align scaled red bbox in patch_s to the target red bbox.\n        rr_red, cc_red = np.where(patch_s == 2)\n        assert rr_red.size > 0, \"scaled source patch must contain red anchor pixels\"\n        ar0, ac0 = int(rr_red.min()), int(cc_red.min())\n        place_r0 = tr0 - ar0\n        place_c0 = tc0 - ac0\n\n        rr_p, cc_p = np.where(patch_s != bg)\n        for rr0, cc0 in zip(rr_p.tolist(), cc_p.tolist(), strict=False):\n            val = int(patch_s[rr0, cc0])\n            rr_t = place_r0 + rr0\n            cc_t = place_c0 + cc0\n            if not (0 <= rr_t < h and 0 <= cc_t < w):\n                continue\n            if rr_t == mid_r or cc_t == mid_c:\n                continue\n            if out[rr_t, cc_t] == 2:\n                continue\n            out[rr_t, cc_t] = val\n\n    return out\n----------------------------------------\ngenerate_input\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid b10624e5 input\")\n================================================================================\n/home/lixinyu/snap/new/ARC_code/train/6165ea8f.py\n----------------------------------------\nmain\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Build a color-labeled shape-equivalence table from the objects listed on the right edge.\n\n    Input structure:\n    - The background contains one main 4-connected object for each foreground color.\n    - The rightmost column has one singleton pixel of each foreground color, listed top-to-bottom.\n    - Those singleton pixels define the row and column order of the output table.\n\n    Rule:\n    - Normalize each main object to its tight mask and compare masks up to rotation or reflection.\n    - Draw 2x2 color labels across the top and down the left, separated by one background row/column.\n    - For each off-diagonal table cell, paint a 2x2 red block when the two labeled objects have the same shape under rotation/reflection, otherwise paint a 2x2 grey block.\n    - Leave diagonal cells and all separators as background.\n\n    Key insight:\n    - Object positions and original orientations are distractors; the relation is dihedral shape equivalence, while the right-edge legend fixes the table order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    order = _legend_order(g, bg)\n    signatures = {color: _shape_signature(_main_object_mask(g, bg, color)) for color in order}\n\n    n = len(order)\n    out = np.full((3 * n + 2, 3 * n + 2), int(bg), dtype=int)\n\n    for i, color in enumerate(order):\n        band = 3 + 3 * i\n        out[0:2, band : band + 2] = int(color)\n        out[band : band + 2, 0:2] = int(color)\n\n    for i, row_color in enumerate(order):\n        for j, col_color in enumerate(order):\n            if i == j:\n                continue\n            cell_color = Color.RED if signatures[row_color] == signatures[col_color] else Color.GREY\n            r = 3 + 3 * i\n            c = 3 + 3 * j\n            out[r : r + 2, c : c + 2] = int(cell_color)\n\n    return out\n----------------------------------------\ngenerate_input\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 6165ea8f input\")\n","exit_code":0,"status":"completed"}}
