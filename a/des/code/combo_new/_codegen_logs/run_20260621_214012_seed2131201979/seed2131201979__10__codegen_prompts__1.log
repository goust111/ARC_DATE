{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble and place enlarged sprites on a canvas using legend-panel instructions.\n\n    Input structure:\n    - Color-6 separators divide the grid into a left legend column and a main canvas.\n    - Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.\n\n    Rule:\n    - Tile the unit sprite into each active cell of the frame to build an enlarged composite.\n    - Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).\n    - Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.\n\n    Key insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    assert w >= 2, \"grid width must be >= 2\"\n\n    # Output canvas is the region between the left separator run and (optionally) a\n    # right-side separator run near the far edge (right legend panel).\n    left_sep, right_sep = _split_canvas(g)\n    left_sep_c1 = left_sep[1]\n    canvas_c0 = left_sep_c1 + 1\n    canvas_c1 = right_sep[0] if right_sep is not None else w\n    main = g[:, canvas_c0:canvas_c1].copy()\n\n    # Paint one constructed sprite per marker panel that lies outside the output canvas.\n    marker_squares = _all_marker_panel_squares(g)\n    assert marker_squares, \"no marker panel found\"\n\n    # Anchor alignment (ignore internal full-height/full-width 6 separators inside main).\n    eff_h, eff_w = main.shape\n    full6_cols = [c for c in range(eff_w) if np.all(main[:, c] == 6)]\n    if full6_cols:\n        eff_w = min(full6_cols)\n    full6_rows = [r for r in range(eff_h) if np.all(main[r, :] == 6)]\n    if full6_rows:\n        eff_h = min(full6_rows)\n\n    out = main.copy()\n    composite_written = np.zeros(out.shape, dtype=bool)\n\n    for marker_r0, marker_c0 in marker_squares:\n        # Ignore marker panels inside the output canvas; only legends should drive drawing.\n        if canvas_c0 <= marker_c0 < canvas_c1:\n            continue\n\n        if marker_c0 + 5 > w:\n            continue\n        panel = g[:, marker_c0 : marker_c0 + 5]\n\n        unit = _extract_unit_sprite(panel)\n        if unit is None:\n            continue\n        unit_sprite, unit_bb = unit\n\n        frame_bb = _extract_frame_bbox(panel, unit_bb, marker_r0)\n        if frame_bb is None:\n            continue\n        fr0, fc0, fr1, fc1 = frame_bb\n        frame = panel[fr0 : fr1 + 1, fc0 : fc1 + 1]\n        frame_mask0 = (frame != 0) & (frame != 6)\n        _, n8 = _scipy_label(frame_mask0, structure=np.ones((3, 3)))\n        assert n8 == 1, f\"frame must be 8-connected, got {n8} components\"\n\n        # Rotate layout according to clockhand.\n        dir_k = _rotation_from_clockhand(g, marker_r0, marker_c0)  # up=0, right=1, down=2, left=3\n        frame_mask = np.rot90(frame_mask0, (-dir_k) % 4)\n\n        # Build composite by tiling the unit sprite into active frame cells.\n        m_unit = (unit_sprite != 0) & (unit_sprite != 6)\n        uh, uw = unit_sprite.shape\n        fh, fw = frame_mask.shape\n        comp = np.zeros((fh * uh, fw * uw), dtype=int)\n        for i in range(fh):\n            for j in range(fw):\n                if not frame_mask[i, j]:\n                    continue\n                rr0 = i * uh\n                cc0 = j * uw\n                comp[rr0 : rr0 + uh, cc0 : cc0 + uw][m_unit] = unit_sprite[m_unit]\n\n        pos = _position_indices_from_border_square(g, marker_r0, marker_c0)\n        if pos is None:\n            continue\n        pr, pc = pos\n\n        top = _anchor_to_top_left(pr, eff_h, comp.shape[0])\n        left = _anchor_to_top_left(pc, eff_w, comp.shape[1])\n\n        ch, cw = comp.shape\n        for r in range(ch):\n            rr = top + r\n            assert 0 <= rr < out.shape[0], \"sprite row out of canvas bounds\"\n            for c in range(cw):\n                cc = left + c\n                assert 0 <= cc < out.shape[1], \"sprite col out of canvas bounds\"\n                if out[rr, cc] == 6:\n                    continue\n                val = int(comp[r, c])\n                if val != 0 and val != 6:\n                    assert not composite_written[rr, cc], \"composites must not overlap\"\n                    composite_written[rr, cc] = True\n                    out[rr, cc] = val\n    return out\n\n# --------------- generator (refine_8conn_fill_overlap) ---------------\n\n# ── CFG: tunable generation parameters ──────────────────────────────\nGRID_H_RANGE = (20, 30)         # output grid height\nGRID_W = 30                     # output grid width (fixed)\nLEGEND_COUNT_WEIGHTS = [1, 4]   # weights for [1-legend, 2-legend]\nUNIT_SIZE_RANGE = (2, 5)        # NxN unit sprite side length\nMIN_CANVAS_W = 8                # reject if canvas narrower than this\nFRAME_H_RANGE = (4, 9)          # frame mask height (before rotation)\nFRAME_W_RANGE = (3, 6)          # frame mask width  (before rotation)\nFRAME_DENSITY = 0.5             # density for random_sprite frame generation\nBAND_WIDTH_MIN = 4              # minimum band width for canvas background\nMARKER_PANEL_HEIGHT = 8         # marker square (5) + rotation patch (3)\nUSABLE_COLORS = [1, 2, 3, 4, 5, 7, 8, 9]  # all colors except 0 (bg) and 6 (separator)\nROTATION_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up/right/down/left clock-hand offsets\nGEN_RETRIES = 300               # max attempts in generate_input\n\n\ndef _allocate_colors(num_legends):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py\"","aggregated_output":"def generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\ndef _in_bounds(h, w, r, c):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/a251c730.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp source sprites into a destination frame via color-matched singleton markers.\n\n    Input structure:\n    - Two bordered rectangles: source (multi-cell sprites) and destination (singleton markers).\n    - Each sprite has an anchor pixel — its least-frequent color. Markers share these colors.\n\n    Rule:\n    - Match each destination marker to the source sprite with the same anchor color.\n    - Translate the sprite so its anchor overlaps the marker position.\n    - Output is the destination rectangle, interior cleared before stamping.\n\n    Key insight: The rarest color per sprite doubles as a template key and positioning anchor.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # --- find all uniform-border rectangles (brute force, small grid) ---\n    def interior_bg(rect: tuple[int, int, int, int]) -> int:\n        r0, c0, r1, c1 = map(int, rect)\n        inner = g[int(r0) + 1 : int(r1), int(c0) + 1 : int(c1)]\n        return int(Counter(map(int, inner.flatten())).most_common(1)[0][0])\n\n    def rect_components(rect: tuple[int, int, int, int]) -> tuple[int, list[dict]]:\n        r0, c0, r1, c1 = map(int, rect)\n        inner = g[int(r0) + 1 : int(r1), int(c0) + 1 : int(c1)]\n        ibg = int(Counter(map(int, inner.flatten())).most_common(1)[0][0])\n        comps = []\n\n        for coords in components_mask(inner != int(ibg), connectivity=4):\n            if coords.size == 0:\n                continue\n            rr0, cc0, rr1, cc1 = bbox_coords(coords)\n            mask = np.zeros((int(rr1 - rr0 + 1), int(cc1 - cc0 + 1)), dtype=bool)\n            mask[coords[:, 0] - int(rr0), coords[:, 1] - int(cc0)] = True\n            patch = inner[int(rr0) : int(rr1) + 1, int(cc0) : int(cc1) + 1].copy()\n            patch[~mask] = 0\n\n            vals = [int(inner[int(r), int(c)]) for r, c in coords]\n            cols = Counter(vals)\n            comps.append(\n                {\n                    \"size\": int(coords.shape[0]),\n                    \"colors\": dict(cols),\n                    \"bbox\": (int(rr0), int(cc0), int(rr1), int(cc1)),\n                    \"mask\": mask,\n                    \"patch\": patch,\n                }\n            )\n\n        comps.sort(key=lambda d: -int(d[\"size\"]))\n        return int(ibg), comps\n\n    rects: list[tuple[int, tuple[int, int, int, int], int, int]] = []\n    min_h = 6\n    min_w = 6\n    for r0 in range(int(H)):\n        for c0 in range(int(W)):\n            bc = int(g[int(r0), int(c0)])\n            for r1 in range(int(r0 + min_h - 1), int(H)):\n                for c1 in range(int(c0 + min_w - 1), int(W)):\n                    # corners\n                    if int(g[int(r0), int(c1)]) != int(bc) or int(g[int(r1), int(c0)]) != int(bc) or int(\n                        g[int(r1), int(c1)]\n                    ) != int(bc):\n                        continue\n                    # border uniformity\n                    if not bool((g[int(r0), int(c0) : int(c1) + 1] == int(bc)).all()):\n                        continue\n                    if not bool((g[int(r1), int(c0) : int(c1) + 1] == int(bc)).all()):\n                        continue\n                    if not bool((g[int(r0) : int(r1) + 1, int(c0)] == int(bc)).all()):\n                        continue\n                    if not bool((g[int(r0) : int(r1) + 1, int(c1)] == int(bc)).all()):\n                        continue\n                    # interior bg must differ from border\n                    ibg = interior_bg((int(r0), int(c0), int(r1), int(c1)))\n                    if int(ibg) == int(bc):\n                        continue\n                    area = int((int(r1) - int(r0) + 1) * (int(c1) - int(c0) + 1))\n                    rects.append((int(area), (int(r0), int(c0), int(r1), int(c1)), int(bc), int(ibg)))\n\n    assert not (not rects)\n\n    rects.sort(reverse=True, key=lambda x: int(x[0]))\n    rects = rects[:6]\n\n    src = None\n    dst = None\n    for _area, rect, bc, _ibg in rects:\n        ibg2, comps = rect_components(rect)\n        max_sz = max([int(c[\"size\"]) for c in comps], default=0)\n        if max_sz > 1 and src is None:\n            src = (rect, bc, ibg2, comps)\n        if max_sz == 1 and len(comps) > 0 and dst is None:\n            dst = (rect, bc, ibg2, comps)\n\n    assert src is not None and dst is not None, 'must find both source (multi-cell) and destination (singleton) rectangles'\n\n    (sr, sc, sr1, sc1), _src_bc, src_bg, src_comps = src\n    (dr, dc, dr1, dc1), dst_bc, dst_bg, _dst_comps = dst\n\n    # --- build templates keyed by anchor color ---\n    templates: dict[int, tuple[np.ndarray, np.ndarray, tuple[int, int]]] = {}\n    for comp in src_comps:\n        cols = {k: int(v) for k, v in comp[\"colors\"].items() if int(k) != 0}\n        if not cols:\n            continue\n        anchor_col = int(min(cols.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n        patch = comp[\"patch\"]\n        mask = comp[\"mask\"]\n        anchors = np.argwhere((patch == int(anchor_col)) & mask)\n        if anchors.size == 0:\n            continue\n        ar, ac = map(int, anchors[0])\n        if int(anchor_col) not in templates or int(mask.sum()) > int(templates[int(anchor_col)][1].sum()):\n            templates[int(anchor_col)] = (patch.copy(), mask.copy(), (int(ar), int(ac)))\n\n    # --- create destination canvas and stamp ---\n    out_h = int(dr1 - dr + 1)\n    out_w = int(dc1 - dc + 1)\n    out = np.full((out_h, out_w), int(dst_bg), dtype=int)\n    out[0, :] = int(dst_bc)\n    out[-1, :] = int(dst_bc)\n    out[:, 0] = int(dst_bc)\n    out[:, -1] = int(dst_bc)\n\n    # Destination markers are singleton pixels (color != dst_bg) in the interior.\n    inner = g[int(dr) + 1 : int(dr1), int(dc) + 1 : int(dc1)]\n    for rr, cc in np.argwhere(inner != int(dst_bg)):\n        mr = int(dr + 1 + int(rr))\n        mc = int(dc + 1 + int(cc))\n        mcol = int(g[mr, mc])\n        if int(mcol) not in templates:\n            continue\n        patch, mask, (ar, ac) = templates[int(mcol)]\n        top = int((mr - dr) - int(ar))\n        left = int((mc - dc) - int(ac))\n        paste(out, patch, int(top), int(left), mask=mask, overwrite=True, clip=True)\n\n    return out\n\n# --------------- generator (O2) ---------------\n\n# === CFG: Canvas & layout ===\nGRID_SIZE = 30                     # fixed 30x30 canvas\nWALLPAPER_COLORS = (4, 5)         # number of wallpaper stripe colors (chosen per n_types)\nTOTAL_COLORS_TARGET = (7, 8, 9)   # total distinct color count targets\nGAP_RANGE = (1, 4)                # gap between rectangles during dimension selection\n\n# === CFG: Rectangle size bounds ===\nSRC_H_RANGE = (9, 19)             # source rect height (outer, inclusive)\nSRC_W_RANGE = (8, 18)             # source rect width (outer, inclusive)\nDST_H_RANGE = (9, 19)             # dest rect height (outer, inclusive)\nDST_W_RANGE = (8, 20)             # dest rect width (outer, inclusive)\nDST_W_SIDE_MAX = 20               # dest width cap for side-by-side layout\n\n# === CFG: Sprite & placement ===\nSPRITE_TYPE_CHOICES = (1, 2)      # number of distinct sprite types\nMARKER_COUNT_RANGE = (2, 3)       # markers in dest rect\nSOURCE_SPRITE_RANGE = (2, 4)      # total sprites in source rect\nMARKER_PLACE_RETRIES = 25         # retries per marker for non-overlapping placement\nSOURCE_SPRITE_PADDING = 1         # min gap between source sprites and edges\n\n# === CFG: Generation retries ===\nMAX_GEN_ATTEMPTS = 300            # outer retry limit\n\nSPRITE_SHAPES = [\n    ((\"AB.\", \"BBB\"), (0, 0)),\n    ((\"ABB\", \"BBB\"), (0, 0)),\n    ((\".A.\", \"BBB\", \".B.\"), (0, 1)),\n    ((\"AB.\", \"BBB\", \".BB\"), (0, 0)),\n    ((\"ABB\", \"BBB\", \"..B\"), (0, 0)),\n    ((\".AB\", \"BBB\", \"BB.\"), (0, 1)),\n    ((\"B.B\", \"BBB\", \".A.\"), (2, 1)),\n    ((\".B.\", \"BAB\", \".B.\"), (1, 1)),\n    ((\"BBB\", \"BAB\"), (1, 1)),\n    ((\"AB.\", \"BBB\", \".B.\"), (0, 0)),\n    ((\"BAB\", \"BBB\"), (0, 1)),\n]\n\n\ndef _render_sprite(shape_rows: tuple[str, ...], body: int, anchor: int, bg: int) -> np.ndarray:\n","exit_code":0,"status":"completed"}}
