{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed2131201979/8/4.py')\nmod = SourceFileLoader('new_arc_task_dbg2', str(p)).load_module()\nrng = np.random.default_rng()\n\nfor trial in range(5000):\n    h = int(rng.integers(4, 8))\n    w = int(rng.integers(4, 8))\n    part = mod._label_partition(h, w, rng)\n    if part is None:\n        continue\n    labels, pieces = part\n    marker_side = mod.SIDES[int(rng.integers(0, 4))]\n    if marker_side == 'top':\n        marker_cell = (-1, int(rng.integers(1, w + 1)))\n    elif marker_side == 'bottom':\n        marker_cell = (h + 2, int(rng.integers(1, w + 1)))\n    elif marker_side == 'left':\n        marker_cell = (int(rng.integers(1, h + 1)), -1)\n    else:\n        marker_cell = (int(rng.integers(1, h + 1)), w + 2)\n\n    frame_cells = []\n    for rr in range(h + 2):\n        for cc in range(w + 2):\n            if rr in (0, h + 1) or cc in (0, w + 1):\n                frame_cells.append((rr, cc))\n    input_cells = [(r, c, mod.GREY) for r, c in frame_cells]\n    input_cells.append((marker_cell[0], marker_cell[1], 1))\n    for side, comp in pieces:\n        shift = {'top': h + 1, 'bottom': h + 1, 'left': w + 1, 'right': w + 1}[side] + int(rng.integers(0, 3))\n        for r0, c0 in comp:\n            r = int(r0) + 1\n            c = int(c0) + 1\n            if side == 'top':\n                input_cells.append((r - shift, c, 1))\n            elif side == 'bottom':\n                input_cells.append((r + shift, c, 1))\n            elif side == 'left':\n                input_cells.append((r, c - shift, 1))\n            else:\n                input_cells.append((r, c + shift, 1))\n    min_r = min(r for r, _c, _v in input_cells)\n    max_r = max(r for r, _c, _v in input_cells)\n    min_c = min(c for _r, c, _v in input_cells)\n    max_c = max(c for _r, c, _v in input_cells)\n    off_r = 1 - min_r\n    off_c = 1 - min_c\n    inp = np.zeros((max_r - min_r + 3, max_c - min_c + 3), dtype=int)\n    bad = False\n    for r,c,v in input_cells:\n        rr = r + off_r\n        cc = c + off_c\n        if inp[rr,cc] \"'!= 0:\n            bad = True\n            break\n        inp[rr,cc] = v\n    if bad:\n        continue\n    bg = 0\n    objs = mod._objects(inp, bg)\n    frames = [obj for obj in objs if mod._is_frame(inp, obj)]\n    non_frames = [obj for obj in objs if not mod._is_frame(inp, obj)]\n    try:\n        color, pos = mod._adjacent_marker(frames[0], non_frames)\n    except AssertionError:\n        print('\"'trial', trial, 'h w', h, w, 'marker_side', marker_side, 'marker_cell', marker_cell)\n        print('shape', inp.shape)\n        print(inp)\n        print('non_frames')\n        for obj in non_frames:\n            print('color', obj['color'], 'area', obj['area'], 'bbox', obj['bbox'], 'coords', obj['coords'].tolist())\n        print('frame bbox', frames[0]['bbox'])\n        break\nelse:\n    print('no failure')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
