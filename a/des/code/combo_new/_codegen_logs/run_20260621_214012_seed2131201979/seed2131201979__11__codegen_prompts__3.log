{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/fc4aaf52.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Split the two-color object horizontally, swap its colors, and slide the upper half to the right.\n\n    Input structure:\n    - The grid has one background color and exactly two foreground colors.\n    - All foreground pixels form one 4-connected object with an even-height bbox.\n    - The object has foreground pixels on both rows adjacent to its horizontal midpoint.\n\n    Rule:\n    - Split the object into upper and lower halves at the midpoint of its bbox.\n    - Swap the two foreground colors in both halves.\n    - Keep the lower half in place and shift the upper half right until its lower-left\n      boundary pixel is diagonally adjacent to the lower half's upper-right boundary pixel.\n\n    Key insight:\n    - The object is not copied or reflected; it is broken at the horizontal waist,\n      recolored by exchanging the two visible object colors, then rejoined diagonally.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected exactly two foreground colors\"\n    color_a, color_b = colors\n\n    objects = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert len(objects) == 1, \"expected one connected foreground object\"\n    r0, _c0, r1, _c1 = objects[0][\"bbox\"]\n    height = int(r1 - r0 + 1)\n    assert height % 2 == 0, \"object bbox height must split evenly\"\n\n    split_row = int(r0 + height // 2)\n    row_ids = np.arange(g.shape[0])[:, None]\n    fg = g != int(bg)\n    upper = fg & (row_ids < split_row)\n    lower = fg & (row_ids >= split_row)\n    assert np.any(upper), \"expected a nonempty upper half\"\n    assert np.any(lower), \"expected a nonempty lower half\"\n    assert int(upper.sum()) == int(lower.sum()), \"expected equal upper and lower areas\"\n\n    upper_boundary_cols = np.flatnonzero(upper[split_row - 1])\n    lower_boundary_cols = np.flatnonzero(lower[split_row])\n    assert upper_boundary_cols.size > 0, \"upper half must touch the split boundary\"\n    assert lower_boundary_cols.size > 0, \"lower half must touch the split boundary\"\n\n    shift = int(lower_boundary_cols.max() + 1 - upper_boundary_cols.min())\n    assert shift > 0, \"upper half must shift right\"\n\n    upper_rows, upper_cols = np.where(upper)\n    lower_rows, lower_cols = np.where(lower)\n    shifted_upper_cols = upper_cols + shift\n    assert int(shifted_upper_cols.max()) < g.shape[1], \"shifted upper half must fit in the grid\"\n\n    out = np.full_like(g, int(bg))\n    out[lower_rows, lower_cols] = _swapped_values(g[lower_rows, lower_cols], color_a, color_b)\n    out[upper_rows, shifted_upper_cols] = _swapped_values(g[upper_rows, upper_cols], color_a, color_b)\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import paste as _gen_paste\n# Canvas and palette.\nGEN_BG, GEN_GRID_SIZE = 8, 16\nGEN_COLOR_POOL = [c for c in range(10) if c != GEN_BG]\n\n# Symmetric object shape.\nGEN_HALF_HEIGHTS, GEN_MAX_WIDTHS = [3, 4], [5, 7]\nGEN_MIN_ROW_WIDTH, GEN_WIDTH_STEP = 1, 2\nGEN_ROW_SWAP_PROB, GEN_ROW_SWAP_HEIGHT = 0.25, 4\nGEN_ROW_SWAP_INDICES = (1, 2)\n\n# Placement and validation.\nGEN_MARGIN, GEN_RETRIES = 1, 300\n\n\ndef _gen_fc4aaf52_swap(arr: np.ndarray, color_a: int, color_b: int) -> np.ndarray:\n    out = arr.copy()\n    out[arr == color_a] = color_b\n    out[arr == color_b] = color_a\n    return out\n\n\ndef _gen_fc4aaf52_upper(half_h: int, border_color: int, fill_color: int) -> np.ndarray:\n    max_w = random.choice(GEN_MAX_WIDTHS)\n    widths = [max_w]\n    for _ in range(half_h - 1):\n        prev_w = widths[-1]\n        widths.append(random.choice([max(GEN_MIN_ROW_WIDTH, prev_w - GEN_WIDTH_STEP), prev_w]))\n    widths = list(reversed(widths))\n    if random.random() < GEN_ROW_SWAP_PROB and half_h == GEN_ROW_SWAP_HEIGHT:\n        i, j = GEN_ROW_SWAP_INDICES\n        widths[i], widths[j] = widths[j], widths[i]\n\n    bottom_lefts = [0]\n    bottom_widths = list(reversed(widths))\n    for i, width in enumerate(bottom_widths[1:], start=1):\n        prev_l = bottom_lefts[-1]\n        prev_r = prev_l + bottom_widths[i - 1] - 1\n        choices = [left for left in range(max_w - width + 1) if max(left, prev_l) <= min(left + width - 1, prev_r)]\n        bottom_lefts.append(random.choice(choices))\n    lefts = list(reversed(bottom_lefts))\n\n    upper = np.full((half_h, max_w), GEN_BG, dtype=int)\n    for r, (left, width) in enumerate(zip(lefts, widths)):\n        right = left + width\n        upper[r, left:right] = fill_color\n        upper[r, left] = border_color\n        upper[r, right - 1] = border_color\n    return upper\n\n\ndef _gen_fc4aaf52_placement(obj_h: int, obj_w: int, shift: int) -> tuple[int, int] | None:\n    max_row = GEN_GRID_SIZE - GEN_MARGIN - obj_h\n    max_col = GEN_GRID_SIZE - GEN_MARGIN - obj_w - shift\n    return None if max_col < 0 else (random.randint(GEN_MARGIN, max_row), random.randint(GEN_MARGIN, max_col))\n\n\ndef _gen_fc4aaf52_render(upper, lower, row, col, shift, border_color, fill_color, *, swapped):\n    out = np.full((GEN_GRID_SIZE, GEN_GRID_SIZE), GEN_BG, dtype=int)\n    upper_col = col\n    if swapped:\n        upper = _gen_fc4aaf52_swap(upper, border_color, fill_color)\n        lower = _gen_fc4aaf52_swap(lower, border_color, fill_color)\n        upper_col += shift\n    _gen_paste(out, upper, row, upper_col, transparent=GEN_BG)\n    _gen_paste(out, lower, row + upper.shape[0], col, transparent=GEN_BG)\n    return out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    border_color, fill_color = random.sample(GEN_COLOR_POOL, 2)\n    half_h = random.choice(GEN_HALF_HEIGHTS)\n    upper_in = _gen_fc4aaf52_upper(half_h, border_color, fill_color)\n    lower_in = np.flipud(upper_in)\n\n    obj_h, obj_w = half_h * 2, upper_in.shape[1]\n    shift = int(np.count_nonzero(upper_in[-1] != GEN_BG))\n    placement = _gen_fc4aaf52_placement(obj_h, obj_w, shift)\n    if placement is None:\n        return None\n    obj_row, obj_col = placement\n\n    expected = _gen_fc4aaf52_render(upper_in, lower_in, obj_row, obj_col, shift, border_color, fill_color, swapped=True)\n    inp = _gen_fc4aaf52_render(upper_in, lower_in, obj_row, obj_col, shift, border_color, fill_color, swapped=False)\n\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/11dc524f.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/11dc524f.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide the non-square sprite to the square anchor and replace the anchor with the sprite's mirror image.\n\n    Input structure:\n    - The background is the most common color.\n    - There is one 8-connected non-background sprite that is not a solid 2x2 square.\n    - There is one solid 2x2 square anchor in another non-background color.\n\n    Rule:\n    - Move the sprite straight toward the anchor along their unique cardinal separation until it touches the anchor's near edge.\n    - Reflect the moved sprite across that near edge and draw the reflected copy in the anchor color.\n    - Clear the original locations; the output keeps only the moved sprite and reflected anchor-color copy.\n\n    Key insight:\n    - The 2x2 square marks the mirror line: its side facing the sprite becomes the contact edge for a two-color reflected pair.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = map(int, g.shape)\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert len(comps) == 2\n\n    anchors = [comp for comp in comps if _is_solid_2x2(comp, g)]\n    assert len(anchors) == 1\n    anchor = anchors[0]\n\n    sprites = [comp for comp in comps if comp is not anchor]\n    assert len(sprites) == 1\n    sprite = sprites[0]\n    assert int(sprite[\"color\"]) != int(anchor[\"color\"])\n\n    sr0, sc0, sr1, sc1 = map(int, sprite[\"bbox\"])\n    ar0, ac0, ar1, ac1 = map(int, anchor[\"bbox\"])\n\n    candidates: list[tuple[str, int, int]] = []\n    if sc1 < ac0 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"left\", 0, ac0 - sc1 - 1))\n    if sc0 > ac1 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"right\", 0, ac1 + 1 - sc0))\n    if sr1 < ar0 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"above\", ar0 - sr1 - 1, 0))\n    if sr0 > ar1 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"below\", ar1 + 1 - sr0, 0))\n    assert len(candidates) == 1\n\n    side, dr, dc = candidates[0]\n    moved: list[tuple[int, int]] = []\n    mirrored: list[tuple[int, int]] = []\n    for r, c in sprite[\"coords\"]:\n        rr = int(r) + int(dr)\n        cc = int(c) + int(dc)\n        moved.append((rr, cc))\n        if side == \"left\":\n            mirrored.append((rr, 2 * ac0 - 1 - cc))\n        elif side == \"right\":\n            mirrored.append((rr, 2 * ac1 + 1 - cc))\n        elif side == \"above\":\n            mirrored.append((2 * ar0 - 1 - rr, cc))\n        else:\n            mirrored.append((2 * ar1 + 1 - rr, cc))\n\n    assert all(0 <= r < H and 0 <= c < W for r, c in moved)\n    assert all(0 <= r < H and 0 <= c < W for r, c in mirrored)\n    assert not (set(moved) & set(mirrored))\n\n    out = np.full_like(g, bg)\n    for r, c in moved:\n        out[r, c] = int(sprite[\"color\"])\n    for r, c in mirrored:\n        out[r, c] = int(anchor[\"color\"])\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import is_contiguous\n\n# ── Config ──────────────────────────────────────────────────────────────\nGRID_MIN, GRID_MAX = 10, 20        # canvas size range (rows and cols)\nSPRITE_AREA = 4                     # number of filled cells per sprite\nSPRITE_BBOX_SHAPES = [(2, 3), (3, 2), (3, 3)]  # allowed sprite bbox dims\nGAP_MIN, GAP_MAX = 2, 4            # empty-cell gap between sprite and anchor\nANCHOR_SIZE = 2                     # anchor is always a 2x2 solid square\nNUM_COLORS = 10                     # ARC color palette size\nSIDES = [\"left\", \"right\", \"above\", \"below\"]\nRETRY_LIMIT = 300                   # max attempts before raising\n\n\ndef _has_full_bbox(mask: np.ndarray) -> bool:\n    \"\"\"True if mask has at least one filled cell on each edge of its bounding box.\"\"\"\n    return (mask[0].any() and mask[-1].any() and\n            mask[:, 0].any() and mask[:, -1].any())\n\n\ndef _sprite_masks(axis: str) -> list[np.ndarray]:\n    \"\"\"Enumerate all valid 4-cell sprite masks for a given mirror axis.\n\n    A valid mask is 8-connected, spans its full bbox, and is NOT symmetric\n    along the given axis (lr or ud).\n    \"\"\"\n    flip = np.fliplr if axis == \"lr\" else np.flipud\n    out = []\n    for h, w in SPRITE_BBOX_SHAPES:\n        for cells in itertools.combinations(range(h * w), SPRITE_AREA):\n            mask = np.zeros((h, w), dtype=bool)\n            for cell in cells:\n                mask[cell // w, cell % w] = True\n            if not _has_full_bbox(mask):\n                continue\n            if not is_contiguous(mask, connectivity=8):\n                continue\n            if np.array_equal(mask, flip(mask)):\n                continue\n            out.append(mask)\n    return out\n\n\n_MASKS = {\"lr\": _sprite_masks(\"lr\"), \"ud\": _sprite_masks(\"ud\")}\n\n\ndef _paint_mask(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int,\n                color: int, bg: int) -> None:\n    \"\"\"Stamp a boolean mask onto grid at (r0, c0) using the given color.\"\"\"\n    patch = np.full(mask.shape, bg, dtype=int)\n    patch[mask] = color\n    paste(grid, patch, r0, c0, transparent=bg)\n\n\ndef _rand_pair_origin(H: int, W: int, h: int, w: int, side: str,\n                      gap: int) -> tuple[int, int] | None:\n    \"\"\"Pick a random origin for the touching sprite+mirror pair.\n\n    Returns (row, col) of the output pair's top-left corner, or None if the\n    pair cannot fit on the grid with enough room for the input-side gap.\n    \"\"\"\n    if side in {\"left\", \"right\"}:\n        r_lo, r_hi = 0, H - h\n        total_w = 2 * w + (gap if side == \"right\" else 0)\n        c_lo = gap if side == \"left\" else 0\n        c_hi = W - total_w if side == \"right\" else W - 2 * w\n    else:\n        c_lo, c_hi = 0, W - w\n        total_h = 2 * h + (gap if side == \"below\" else 0)\n        r_lo = gap if side == \"above\" else 0\n        r_hi = H - total_h if side == \"below\" else H - 2 * h\n    if r_lo > r_hi or c_lo > c_hi:\n        return None\n    return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)\n\n\ndef _layout_for_side(side: str, pr: int, pc: int, h: int, w: int,\n                     gap: int, sprite: np.ndarray):\n    \"\"\"Compute output and input placement params for a given side.\n\n    Returns (sprite_r, sprite_c, mirror_r, mirror_c, flipped_sprite,\n             anchor_r, anchor_c, input_r, input_c).\n    \"\"\"\n    flip = np.fliplr if side in {\"left\", \"right\"} else np.flipud\n    flipped = flip(sprite)\n\n    if side == \"left\":\n        sr, sc = pr, pc                     # sprite at pair origin\n        mr, mc = sr, sc + w                  # mirror right of sprite\n        anchor_r = random.randint(sr, sr + h - ANCHOR_SIZE)\n        anchor_c = sc + w\n        input_r, input_c = sr, sc - gap\n    elif side == \"right\":\n        sr, sc = pr, pc + w                  # sprite right half\n        mr, mc = pr, pc                      # mirror left half\n        anchor_r = random.randint(sr, sr + h - ANCHOR_SIZE)\n        anchor_c = sc - ANCHOR_SIZE\n        input_r, input_c = sr, sc + gap\n    elif side == \"above\":\n        sr, sc = pr, pc                      # sprite at top\n        mr, mc = sr + h, sc                  # mirror below\n        anchor_r = sr + h\n        anchor_c = random.randint(sc, sc + w - ANCHOR_SIZE)\n        input_r, input_c = sr - gap, sc\n    else:  # below\n        sr, sc = pr + h, pc                  # sprite at bottom\n        mr, mc = pr, pc                      # mirror above\n        anchor_r = sr - ANCHOR_SIZE\n        anchor_c = random.randint(sc, sc + w - ANCHOR_SIZE)\n        input_r, input_c = sr + gap, sc\n\n    return sr, sc, mr, mc, flipped, anchor_r, anchor_c, input_r, input_c\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Try to build one valid (input, output) pair; return input or None.\"\"\"\n    H = random.randint(GRID_MIN, GRID_MAX)\n    W = random.randint(GRID_MIN, GRID_MAX)\n    bg = random.randrange(NUM_COLORS)\n    sprite_color, anchor_color = random.sample(\n        [c for c in range(NUM_COLORS) if c != bg], 2)\n\n    side = random.choice(SIDES)\n    axis = \"lr\" if side in {\"left\", \"right\"} else \"ud\"\n    sprite = random.choice(_MASKS[axis]).copy()\n    h, w = map(int, sprite.shape)\n    gap = random.randint(GAP_MIN, GAP_MAX)\n\n    origin = _rand_pair_origin(H, W, h, w, side, gap)\n    if origin is None:\n        return None\n    pr, pc = origin\n\n    (sr, sc, mr, mc, flipped,\n     anchor_r, anchor_c, input_r, input_c) = _layout_for_side(\n        side, pr, pc, h, w, gap, sprite)\n\n    # Build expected output\n    out = np.full((H, W), bg, dtype=int)\n    _paint_mask(out, sprite, sr, sc, sprite_color, bg)\n    _paint_mask(out, flipped, mr, mc, anchor_color, bg)\n\n    # Build input\n    inp = np.full((H, W), bg, dtype=int)\n    _paint_mask(inp, sprite, input_r, input_c, sprite_color, bg)\n    paste(inp, np.full((ANCHOR_SIZE, ANCHOR_SIZE), anchor_color, dtype=int),\n          anchor_r, anchor_c)\n\n    # Oracle validation\n    comps = find_components(inp, bg=bg, connectivity=8, monochromatic=True)\n    if len(comps) != 2:\n        return None\n    try:\n        solved = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(solved, out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
