{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/8dab14c2.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Complete each boundary tab or notch by adding the complementary feature on the opposite side of the foreground object.\n\n    Input structure\n    - The grid has exactly two colors: a dominant background and one foreground object.\n    - The foreground object is a thick rectilinear shape with one-pixel tabs and notches on its boundary.\n\n    Rule\n    - A foreground tab is a one-neighbor boundary pixel; project through its full row or column span and remove the opposite edge pixel to make a matching notch.\n    - A background notch is a one-pixel cut with three foreground 4-neighbors; project across the full row or column span and add a tab just outside the opposite edge.\n    - Notches immediately beside a tab source are not independent sources, because that gap belongs to the tab's local boundary shape.\n\n    Key insight\n    - The changed pixels are not color-specific noise; they are paired jigsaw-like boundary features on opposite sides of the same thick row or column cross-section.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g)\n    assert len(colors) == 2, \"task expects exactly one foreground color and one background\"\n    fg_colors = [color for color in colors if color != bg]\n    assert len(fg_colors) == 1, \"task expects a single foreground color\"\n    fg = fg_colors[0]\n\n    mask = g == fg\n    out = g.copy()\n\n    tabs = _tab_sources(mask)\n    tab_cells = {cell for cell, _direction, _target in tabs}\n    changes = 0\n\n    for _cell, _direction, target in tabs:\n        if out[target] != bg:\n            out[target] = bg\n            changes += 1\n\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n            if bool(mask[r, c]):\n                continue\n\n            fg_dirs: list[tuple[int, int]] = []\n            bg_dirs: list[tuple[int, int]] = []\n            for dr, dc in DIRS4:\n                rr, cc = r + dr, c + dc\n                if in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]):\n                    fg_dirs.append((dr, dc))\n                else:\n                    bg_dirs.append((dr, dc))\n\n            if len(fg_dirs) != 3 or len(bg_dirs) != 1:\n                continue\n\n            outside_dr, outside_dc = bg_dirs[0]\n            dr, dc = -outside_dr, -outside_dc\n            side_a = (r - dc, c + dr)\n            side_b = (r + dc, c - dr)\n            if side_a in tab_cells or side_b in tab_cells:\n                continue\n\n            target = _outside_opposite_edge(mask, r, c, dr, dc)\n            if target is not None and not bool(mask[target]):\n                if out[target] != fg:\n                    out[target] = fg\n                    changes += 1\n\n    assert changes > 0, \"at least one complementary boundary feature must be produced\"\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_BG = 8\n_GEN_FG = 1\n_GEN_DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n# Canvas and placement bounds.\n_GEN_ROWS_RANGE = (13, 16)\n_GEN_COLS_RANGE = (15, 17)\n_GEN_MARGIN = 1\n\n# Clean L-shape arm bounds.\n_GEN_H_THICK_RANGE = (3, 5)\n_GEN_V_WIDTH_RANGE = (3, 6)\n_GEN_V_EXTRA_RANGE = (4, 10)\n_GEN_H_WIDTH_RANGE = (11, 14)\n_GEN_MAX_BODY_HEIGHT = 14\n_GEN_MIN_MODE_GAP = 2\n_GEN_MISSING_CORNERS = (\"TL\", \"TR\", \"BL\", \"BR\")\n\n# Boundary source feature counts.\n_GEN_PAIR_COUNT_RANGE = (1, 3)\n_GEN_MAX_TABS = 4\n\n# Retry limits.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:\n    return 0 <= r < shape[0] and 0 <= c < shape[1]\n\n\ndef _gen_has_tangent_support(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> bool:\n    if dr:\n        sides = ((r, c - 1), (r, c + 1))\n    else:\n        sides = ((r - 1, c), (r + 1, c))\n    return all(_gen_in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]) for rr, cc in sides)\n\n\ndef _gen_line_edges(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> tuple[tuple[int, int], tuple[int, int]] | None:\n    if dr:\n        rows = np.flatnonzero(mask[:, c])\n        if rows.size == 0:\n            return None\n        near_r = int(rows.min() if dr > 0 else rows.max())\n        far_r = int(rows.max() if dr > 0 else rows.min())\n        return (near_r, c), (far_r, c)\n\n    cols = np.flatnonzero(mask[r])\n    if cols.size == 0:\n        return None\n    near_c = int(cols.min() if dc > 0 else cols.max())\n    far_c = int(cols.max() if dc > 0 else cols.min())\n    return (r, near_c), (r, far_c)\n\n\ndef _gen_feature_slots(mask: np.ndarray) -> list[dict]:\n    slots: list[dict] = []\n    for r in range(mask.shape[0]):\n        for c in range(mask.shape[1]):\n            if not bool(mask[r, c]):\n                continue\n            for dr, dc in _GEN_DIRS4:\n                outside_r, outside_c = r - dr, c - dc\n                if not _gen_in_bounds(mask.shape, outside_r, outside_c):\n                    continue\n                if bool(mask[outside_r, outside_c]):\n                    continue\n\n                edges = _gen_line_edges(mask, r, c, dr, dc)\n                if edges is None or edges[0] != (r, c):\n                    continue\n                near, far = edges\n                far_out = (far[0] + dr, far[1] + dc)\n                if not _gen_in_bounds(mask.shape, far_out[0], far_out[1]):\n                    continue\n                if bool(mask[far_out]):\n                    continue\n                near_margin = (outside_r - dr, outside_c - dc)\n                far_margin = (far_out[0] + dr, far_out[1] + dc)\n                if not _gen_in_bounds(mask.shape, near_margin[0], near_margin[1]):\n                    continue\n                if not _gen_in_bounds(mask.shape, far_margin[0], far_margin[1]):\n                    continue\n\n                inner_r, inner_c = r + dr, c + dc\n                if not _gen_in_bounds(mask.shape, inner_r, inner_c) or not bool(mask[inner_r, inner_c]):\n                    continue\n                if not _gen_has_tangent_support(mask, near[0], near[1], dr, dc):\n                    continue\n                if not _gen_has_tangent_support(mask, far[0], far[1], dr, dc):\n                    continue\n\n                slots.append(\n                    {\n                        \"near\": near,\n                        \"near_out\": (outside_r, outside_c),\n                        \"far\": far,\n                        \"far_out\": far_out,\n                        \"dir\": (dr, dc),\n                    }\n                )\n    return slots\n\n\ndef _gen_protected_cells(slot: dict) -> set[tuple[int, int]]:\n    return {slot[\"near\"], slot[\"near_out\"], slot[\"far\"], slot[\"far_out\"]}\n\n\ndef _gen_l_configs() -> list[tuple[int, int, int, int]]:\n    \"\"\"Return clean L dimensions whose solver thickness mode is unambiguous.\"\"\"\n    configs: list[tuple[int, int, int, int]] = []\n    for h_thick in range(_GEN_H_THICK_RANGE[0], _GEN_H_THICK_RANGE[1] + 1):\n        for v_width in range(_GEN_V_WIDTH_RANGE[0], _GEN_V_WIDTH_RANGE[1] + 1):\n            for v_extra in range(_GEN_V_EXTRA_RANGE[0], _GEN_V_EXTRA_RANGE[1] + 1):\n                height = h_thick + v_extra\n                if height > _GEN_MAX_BODY_HEIGHT:\n                    continue\n                for h_width in range(_GEN_H_WIDTH_RANGE[0], _GEN_H_WIDTH_RANGE[1] + 1):\n                    run_counts: dict[int, int] = {}\n                    for length, count in (\n                        (h_width, h_thick),\n                        (v_width, v_extra),\n                        (height, v_width),\n                        (h_thick, h_width - v_width),\n                    ):\n                        run_counts[length] = run_counts.get(length, 0) + count\n                    max_count = max(run_counts.values())\n                    mode = min(length for length, count in run_counts.items() if count == max_count)\n                    counts = sorted(run_counts.values(), reverse=True)\n                    if mode == min(h_thick, v_width) and counts[0] >= counts[1] + _GEN_MIN_MODE_GAP:\n                        configs.append((h_thick, v_width, v_extra, h_width))\n    return configs\n\n\ndef _gen_clean_l() -> tuple[np.ndarray, int, int, int, int, str] | None:\n    h_thick, v_width, v_extra, h_width = random.choice(_gen_l_configs())\n\n    height = h_thick + v_extra\n    rows = random.randint(max(_GEN_ROWS_RANGE[0], height + 2 * _GEN_MARGIN), _GEN_ROWS_RANGE[1])\n    cols = random.randint(max(_GEN_COLS_RANGE[0], h_width + 2 * _GEN_MARGIN), _GEN_COLS_RANGE[1])\n    r0 = random.randint(_GEN_MARGIN, rows - height - _GEN_MARGIN)\n    c0 = random.randint(_GEN_MARGIN, cols - h_width - _GEN_MARGIN)\n\n    missing_corner = random.choice(_GEN_MISSING_CORNERS)\n    h_on_top = missing_corner[0] == \"B\"\n    v_on_left = missing_corner[1] == \"R\"\n\n    mask = np.zeros((rows, cols), dtype=bool)\n    h_rows = slice(r0, r0 + h_thick) if h_on_top else slice(r0 + v_extra, r0 + height)\n    v_cols = slice(c0, c0 + v_width) if v_on_left else slice(c0 + h_width - v_width, c0 + h_width)\n    mask[h_rows, c0 : c0 + h_width] = True\n    mask[r0 : r0 + height, v_cols] = True\n    return mask, h_thick, v_width, v_extra, h_width, missing_corner\n\n\ndef _gen_notch_sources(mask: np.ndarray) -> list[tuple[tuple[int, int], tuple[int, int], tuple[int, int] | None]]:\n    tab_cells = {cell for cell, _direction, _target in _tab_sources(mask)}\n    notches: list[tuple[tuple[int, int], tuple[int, int], tuple[int, int] | None]] = []\n    for r in range(mask.shape[0]):\n        for c in range(mask.shape[1]):\n            if bool(mask[r, c]):\n                continue\n\n            fg_dirs: list[tuple[int, int]] = []\n            bg_dirs: list[tuple[int, int]] = []\n            for dr, dc in _GEN_DIRS4:\n                rr, cc = r + dr, c + dc\n                if _gen_in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]):\n                    fg_dirs.append((dr, dc))\n                else:\n                    bg_dirs.append((dr, dc))\n\n            if len(fg_dirs) != 3 or len(bg_dirs) != 1:\n                continue\n\n            outside_dr, outside_dc = bg_dirs[0]\n            dr, dc = -outside_dr, -outside_dc\n            side_a = (r - dc, c + dr)\n            side_b = (r + dc, c - dr)\n            if side_a in tab_cells or side_b in tab_cells:\n                continue\n\n            if dr:\n                rows = np.flatnonzero(mask[:, c])\n                target = None if rows.size == 0 else (int(rows.max() + 1 if dr > 0 else rows.min() - 1), c)\n            else:\n                cols = np.flatnonzero(mask[r])\n                target = None if cols.size == 0 else (r, int(cols.max() + 1 if dc > 0 else cols.min() - 1))\n            if target is not None and not _gen_in_bounds(mask.shape, target[0], target[1]):\n                target = None\n            notches.append(((r, c), (dr, dc), target))\n    return notches\n\n\ndef _gen_apply_source_features(clean: np.ndarray, chosen: list[tuple[dict, str]]) -> np.ndarray:\n    mask = clean.copy()\n    for slot, source_type in chosen:\n        if source_type == \"tab\":\n            mask[slot[\"near_out\"]] = True\n        else:\n            mask[slot[\"near\"]] = False\n    return mask\n\n\ndef _gen_source_sets_match(mask: np.ndarray, chosen: list[tuple[dict, str]]) -> bool:\n    expected_tab_cells = {slot[\"near_out\"] for slot, source_type in chosen if source_type == \"tab\"}\n    found_tab_cells = {cell for cell, _direction, _target in _tab_sources(mask)}\n    if found_tab_cells != expected_tab_cells:\n        return False\n\n    expected_notch_cells = {slot[\"near\"] for slot, source_type in chosen if source_type == \"notch\"}\n    found_notch_cells = {\n        cell\n        for cell, _direction, target in _gen_notch_sources(mask)\n        if target is not None and not bool(mask[target])\n    }\n    return found_notch_cells == expected_notch_cells\n\n\ndef _gen_source_types() -> list[str]:\n    source_count = 2 * random.randint(_GEN_PAIR_COUNT_RANGE[0], _GEN_PAIR_COUNT_RANGE[1])\n    min_tabs = max(0, source_count - _GEN_MAX_TABS)\n    max_tabs = min(_GEN_MAX_TABS, source_count)\n    tab_count = random.randint(min_tabs, max_tabs)\n    source_types = [\"tab\"] * tab_count + [\"notch\"] * (source_count - tab_count)\n    random.shuffle(source_types)\n    return source_types\n\n\ndef _gen_choose_features(\n    clean: np.ndarray,\n    slots: list[dict],\n    source_types: list[str],\n    idx: int = 0,\n    chosen: list[tuple[dict, str]] | None = None,\n    blocked: set[tuple[int, int]] | None = None,\n) -> list[tuple[dict, str]] | None:\n    if chosen is None:\n        chosen = []\n    if blocked is None:\n        blocked = set()\n    if idx == len(source_types):\n        return chosen\n\n    candidates = slots[:]\n    random.shuffle(candidates)\n    source_type = source_types[idx]\n    for slot in candidates:\n        protected = _gen_protected_cells(slot)\n        if protected & blocked:\n            continue\n        trial = chosen + [(slot, source_type)]\n        source_mask = _gen_apply_source_features(clean, trial)\n        if not _gen_source_sets_match(source_mask, trial):\n            continue\n        result = _gen_choose_features(clean, slots, source_types, idx + 1, trial, blocked | protected)\n        if result is not None:\n            return result\n    return None\n\n\ndef _gen_render_pair(clean: np.ndarray, chosen: list[tuple[dict, str]]) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return input and expected-output masks for the selected source features.\"\"\"\n    out_mask = clean.copy()\n    for slot, source_type in chosen:\n        if source_type == \"tab\":\n            out_mask[slot[\"near_out\"]] = True\n            out_mask[slot[\"far\"]] = False\n        else:\n            out_mask[slot[\"near\"]] = False\n            out_mask[slot[\"far_out\"]] = True\n\n    inp_mask = out_mask.copy()\n    for slot, source_type in chosen:\n        if source_type == \"tab\":\n            inp_mask[slot[\"far\"]] = True\n        else:\n            inp_mask[slot[\"far_out\"]] = False\n    return inp_mask, out_mask\n\n\ndef _gen_to_grid(mask: np.ndarray) -> np.ndarray:\n    grid = np.full(mask.shape, _GEN_BG, dtype=int)\n    grid[mask] = _GEN_FG\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    clean_result = _gen_clean_l()\n    if clean_result is None:\n        return None\n    clean, h_thick, v_width, _v_extra, _h_width, _missing_corner = clean_result\n\n    slots = _gen_feature_slots(clean)\n    random.shuffle(slots)\n    chosen = _gen_choose_features(clean, slots, _gen_source_types())\n    if chosen is None:\n        return None\n\n    inp_mask, out_mask = _gen_render_pair(clean, chosen)\n\n    intended_thickness = min(h_thick, v_width)\n    if _body_thickness(inp_mask) != intended_thickness:\n        return None\n\n    if not _gen_source_sets_match(inp_mask, chosen):\n        return None\n\n    inp = _gen_to_grid(inp_mask)\n    expected = _gen_to_grid(out_mask)\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/f0100645.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide each inner colored object horizontally into the same-colored vertical wall until it touches an obstacle.\n\n    Input structure\n    - The background is the dominant color.\n    - The only foreground colors are two non-background colors.\n    - One foreground color fills the left column and the other fills the right column.\n    - Extra 8-connected objects of each wall color appear away from that color's wall.\n\n    Rule\n    - Clear the extra objects from their original positions.\n    - For each wall color, process its 8-connected extra objects from nearest to farthest from the matching wall.\n    - Slide each object horizontally toward its matching wall as far as possible without overlapping the wall or an already settled object of the same color.\n    - Keep the two vertical wall columns fixed.\n\n    Key insight\n    - The side columns act like color-specific gravity walls: same-colored objects compact sideways against their own wall while preserving each object's shape.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and min(g.shape) >= 2, \"expected a non-empty 2D grid with two side columns\"\n\n    bg = get_bg(g)\n    w = g.shape[1]\n    left_color = int(g[0, 0])\n    right_color = int(g[0, w - 1])\n\n    assert left_color != right_color, \"left and right walls must have different colors\"\n    assert bg not in {left_color, right_color}, \"walls must be foreground colors\"\n    assert np.all(g[:, 0] == left_color), \"left wall must fill the full left column\"\n    assert np.all(g[:, w - 1] == right_color), \"right wall must fill the full right column\"\n    assert set(map(int, np.unique(g))) == {int(bg), left_color, right_color}, \"expected exactly background plus two wall colors\"\n\n    out = np.full_like(g, int(bg))\n    out[:, 0] = left_color\n    out[:, w - 1] = right_color\n\n    placements: list[tuple[int, np.ndarray]] = []\n    for color, side_col, direction in ((left_color, 0, -1), (right_color, w - 1, 1)):\n        for coords in _settled_components(g, color, side_col, direction):\n            placements.append((color, coords))\n\n    occupied = (out != bg)\n    for color, coords in placements:\n        assert not np.any(occupied[coords[:, 0], coords[:, 1]]), \"different colors must not settle on the same pixel\"\n        out[coords[:, 0], coords[:, 1]] = color\n        occupied[coords[:, 0], coords[:, 1]] = True\n\n    assert int(np.sum(out == left_color)) == int(np.sum(g == left_color)), \"left color count must be preserved\"\n    assert int(np.sum(out == right_color)) == int(np.sum(g == right_color)), \"right color count must be preserved\"\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and palette bounds.\nGRID_HEIGHT_BOUNDS = (9, 10)\nGRID_WIDTH_BOUNDS = (9, 10)\nBACKGROUND_COLOR = 7\nWALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n# Object counts and pixel budgets.\nCOMPONENT_COUNT_BOUNDS = (2, 3)\nINNER_FOREGROUND_BOUNDS = (15, 23)\nSPRITE_PIXEL_BOUNDS = (1, 7)\n# Sprite geometry limits.\nSPRITE_HEIGHT_BOUNDS = (1, 5)\nSPRITE_WIDTH_BOUNDS = (1, 3)\nMIN_SPRITE_DENSITY = 0.56\n# Input scatter and retry limits.\nSCATTER_OFFSET_BOUNDS = (1, 5)\nGENERATION_ATTEMPTS = 300\n\nPlacement = tuple[int, np.ndarray, int, int, bool]\n\n\ndef _gen_bounded_composition(total: int, parts: int, lo: int, hi: int) -> list[int]:\n    values = []\n    remaining = int(total)\n    for i in range(int(parts)):\n        slots = int(parts) - i - 1\n        low = max(int(lo), remaining - int(hi) * slots)\n        high = min(int(hi), remaining - int(lo) * slots)\n        value = random.randint(low, high)\n        values.append(value)\n        remaining -= value\n    random.shuffle(values)\n    return values\n\n\ndef _gen_sprite_mask(size: int) -> np.ndarray:\n    size = int(size)\n    dims = [\n        (h, w)\n        for h in range(SPRITE_HEIGHT_BOUNDS[0], SPRITE_HEIGHT_BOUNDS[1] + 1)\n        for w in range(SPRITE_WIDTH_BOUNDS[0], SPRITE_WIDTH_BOUNDS[1] + 1)\n        if max(h, w) <= size <= h * w and size / (h * w) >= MIN_SPRITE_DENSITY\n    ]\n    h, w = random.choice(dims)\n\n    coords: set[tuple[int, int]] = set()\n    length = max(h, w)\n    if length == 1:\n        coords.add((0, 0))\n    else:\n        for i in range(length):\n            r = (i * (h - 1) + (length - 1) // 2) // (length - 1)\n            c = (i * (w - 1) + (length - 1) // 2) // (length - 1)\n            coords.add((int(r), int(c)))\n\n    while len(coords) < size:\n        frontier = []\n        for r, c in coords:\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    if dr == 0 and dc == 0:\n                        continue\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in coords:\n                        frontier.append((nr, nc))\n        coords.add(random.choice(frontier))\n\n    mask = np.zeros((h, w), dtype=bool)\n    for r, c in coords:\n        mask[r, c] = True\n    if random.choice([False, True]):\n        mask = np.flipud(mask)\n    if random.choice([False, True]):\n        mask = np.fliplr(mask)\n    return mask.copy()\n\n\ndef _gen_mask_coords(mask: np.ndarray, r0: int, c0: int) -> np.ndarray:\n    return np.argwhere(mask) + np.array([int(r0), int(c0)])\n\n\ndef _gen_base_grid(shape: tuple[int, int], bg: int, left_color: int, right_color: int) -> np.ndarray:\n    grid = np.full(shape, int(bg), dtype=int)\n    grid[:, 0] = int(left_color)\n    grid[:, shape[1] - 1] = int(right_color)\n    return grid\n\n\ndef _gen_place_output_side(\n    out: np.ndarray, color: int, masks: list[np.ndarray], *, left_side: bool, bg: int\n) -> list[Placement]:\n    h, w = out.shape\n    placements = []\n    for mask in sorted(masks, key=lambda m: int(m.sum()), reverse=True):\n        mh, mw = mask.shape\n        c0 = 1 if left_side else w - 1 - mw\n        rows = list(range(0, h - mh + 1))\n        random.shuffle(rows)\n        for r0 in rows:\n            coords = _gen_mask_coords(mask, r0, c0)\n            if np.any(out[coords[:, 0], coords[:, 1]] != bg):\n                continue\n            patch = np.where(mask, int(color), int(bg))\n            paste(out, patch, r0, c0, transparent=bg)\n            placements.append((int(color), mask, int(r0), int(c0), bool(left_side)))\n            break\n        else:\n            return []\n    return placements\n\n\ndef _gen_touches_existing(coords: np.ndarray, existing: list[np.ndarray]) -> bool:\n    for other in existing:\n        dr = np.abs(coords[:, None, 0] - other[None, :, 0])\n        dc = np.abs(coords[:, None, 1] - other[None, :, 1])\n        if bool(np.any((dr <= 1) & (dc <= 1))):\n            return True\n    return False\n\n\ndef _gen_scatter_input(\n    shape: tuple[int, int], bg: int, left_color: int, right_color: int, placements: list[Placement]\n) -> np.ndarray | None:\n    h, w = shape\n    inp = _gen_base_grid((h, w), bg, left_color, right_color)\n    by_color: dict[int, list[np.ndarray]] = {int(left_color): [], int(right_color): []}\n\n    shuffled = list(placements)\n    random.shuffle(shuffled)\n    for color, mask, r0, c_out, left_side in shuffled:\n        mh, mw = mask.shape\n        max_offset = (w - 2 - (c_out + mw - 1)) if left_side else (c_out - 1)\n        offsets = list(range(SCATTER_OFFSET_BOUNDS[0], min(SCATTER_OFFSET_BOUNDS[1], int(max_offset)) + 1))\n        random.shuffle(offsets)\n        for offset in offsets:\n            c_in = c_out + offset if left_side else c_out - offset\n            coords = _gen_mask_coords(mask, r0, c_in)\n            if np.any(inp[coords[:, 0], coords[:, 1]] != bg):\n                continue\n            if _gen_touches_existing(coords, by_color[int(color)]):\n                continue\n            patch = np.where(mask, int(color), int(bg))\n            paste(inp, patch, r0, c_in, transparent=bg)\n            by_color[int(color)].append(coords)\n            break\n        else:\n            return None\n    return inp\n\n\ndef _gen_output_layout(\n    shape: tuple[int, int], bg: int, left_color: int, right_color: int,\n    left_masks: list[np.ndarray], right_masks: list[np.ndarray],\n) -> tuple[np.ndarray, list[Placement]] | None:\n    out = _gen_base_grid(shape, bg, left_color, right_color)\n    left_placements = _gen_place_output_side(out, left_color, left_masks, left_side=True, bg=bg)\n    if len(left_placements) != len(left_masks):\n        return None\n    right_placements = _gen_place_output_side(out, right_color, right_masks, left_side=False, bg=bg)\n    if len(right_placements) != len(right_masks):\n        return None\n    return out, left_placements + right_placements\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    h = random.randint(*GRID_HEIGHT_BOUNDS)\n    w = random.randint(*GRID_WIDTH_BOUNDS)\n    bg = BACKGROUND_COLOR\n    left_color, right_color = random.sample(WALL_COLORS, 2)\n\n    left_count = random.randint(*COMPONENT_COUNT_BOUNDS)\n    right_count = random.randint(*COMPONENT_COUNT_BOUNDS)\n    total_inner = random.randint(*INNER_FOREGROUND_BOUNDS)\n    sizes = _gen_bounded_composition(total_inner, left_count + right_count, *SPRITE_PIXEL_BOUNDS)\n    left_masks = [_gen_sprite_mask(size) for size in sizes[:left_count]]\n    right_masks = [_gen_sprite_mask(size) for size in sizes[left_count:]]\n\n    layout = _gen_output_layout((h, w), bg, left_color, right_color, left_masks, right_masks)\n    if layout is None:\n        return None\n    out, placements = layout\n\n    inp = _gen_scatter_input((h, w), bg, left_color, right_color, placements)\n    if inp is None:\n        return None\n    try:\n        solved = main(inp)\n    except AssertionError:\n        return None\n    if np.array_equal(solved, out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
