{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nimport numpy as np\nfrom collections import Counter\n\n\ndef groups(idxs):\n    out=[]\n    if not len(idxs):\n        return out\n    start=prev=int(idxs[0])\n    cur=[start]\n    for x in map(int, idxs[1:]):\n        if x==prev+1:\n            cur.append(x)\n        else:\n            out.append(cur)\n            cur=[x]\n        prev=x\n    out.append(cur)\n    return out\n\n\ndef mode_nonzero(arr):\n    cnt=Counter(int(x) for x in arr if int(x)\"'!=0)\n    return cnt.most_common(1)[0][0]\n\n\ndef render(paths,H,W,recolor):\n    for p in paths:\n        if p['\"'orient']=='H':\n            prof=np.full(W,p['color'],dtype=int)\n            if recolor and p['width']==1:\n                for q in sorted([q for q in paths if q['orient']=='V' and q['width']==2], key=lambda x:x['cols'][0]):\n                    start=q['cols'][-1]+1\n                    if start < W:\n                        prof[start:] = q['color']\n            p['profile']=prof\n        else:\n            prof=np.full(H,p['color'],dtype=int)\n            if recolor and p['width']==1:\n                for q in sorted([q for q in paths if q['orient']=='H' and q['width']==2], key=lambda x:x['rows'][0]):\n                    start=q['rows'][-1]+1\n                    if start < H:\n                        prof[start:] = q['color']\n            p['profile']=prof\n    out=np.zeros((H,W),dtype=int)\n    order={'V1':0,'H1':1,'V2':2,'H2':3}\n    for p in sorted(paths,key=lambda p: order[p['orient']+str(p['width'])]):\n        if p['orient']=='H':\n            for r in p['rows']:\n                out[r,:]=p['profile']\n        else:\n            for c in p['cols']:\n                out[:,c]=p['profile']\n    return out\n\n\ndef solve(inp):\n    g=np.asarray(inp)\n    H,W=g.shape\n    row_counts=(g\"'!=0).sum(axis=1)\n    col_counts=(g!=0).sum(axis=0)\n    hgroups=groups(np.where(row_counts==W)[0])\n    vgroups=groups(np.where(col_counts==H)[0])\n    paths=[]\n    for rows in hgroups:\n        assert len(rows) in (1,2)\n        paths.append({'\"'orient':'H','rows':rows,'width':len(rows),'color':mode_nonzero(g[rows,:].ravel())})\n    for cols in vgroups:\n        assert len(cols) in (1,2)\n        paths.append({'orient':'V','cols':cols,'width':len(cols),'color':mode_nonzero(g[:,cols].ravel())})\n    return render(paths,H,W,True)\n\n\ndef place_bands(size,widths):\n    # margin 1 around grid to leave post-crossing room\n    for _ in range(1000):\n        starts=[]\n        occupied=set()\n        ok=True\n        order=list(range(len(widths)))\n        random.shuffle(order)\n        pos=[None]*len(widths)\n        for i in order:\n            w=widths[i]\n            cands=[]\n            for s in range(1,size-w):\n                band=set(range(s-1,s+w+1))\n                if occupied & band:\n                    continue\n                cands.append(s)\n            if not cands:\n                ok=False\n                break\n            s=random.choice(cands)\n            pos[i]=s\n            occupied.update(range(s-1,s+w+1))\n        if ok:\n            return [list(range(s,s+w)) for s,w in zip(pos,widths)]\n    raise RuntimeError\n\nfor _ in range(200):\n    H=random.randint(14,22)\n    W=random.randint(14,22)\n    h_count=random.randint(2,3)\n    v_count=random.randint(2,3)\n    h_widths=[1,2]+[random.randint(1,2) for _ in range(h_count-2)]\n    v_widths=[1,2]+[random.randint(1,2) for _ in range(v_count-2)]\n    if sum(h_widths)+2*(h_count-1)>=H or sum(v_widths)+2*(v_count-1)>=W:\n        continue\n    h_bands=place_bands(H,h_widths)\n    v_bands=place_bands(W,v_widths)\n    colors=random.sample(range(1,10), h_count+v_count)\n    paths=[]\n    for rows,w,col in zip(h_bands,h_widths,colors[:h_count]):\n        paths.append({'orient':'H','rows':rows,'width':w,'color':col})\n    for cols,w,col in zip(v_bands,v_widths,colors[h_count:]):\n        paths.append({'orient':'V','cols':cols,'width':w,'color':col})\n    inp=render([p.copy() for p in paths],H,W,False)\n    out=render([p.copy() for p in paths],H,W,True)\n    got=solve(inp)\n    if not np.array_equal(out,got):\n        print('mismatch')\n        print(H,W,paths)\n        print(inp)\n        print(out)\n        print(got)\n        raise SystemExit\nprint('ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
