e)\n   492\t    for room, color in zip(rooms, colors):\n   493\t        room.color = int(color)\n   494\t\n   495\t    grid = np.full((height, width), BG, dtype=int)\n   496\t    for room in rooms:\n   497\t        _draw_room(grid, room)\n   498\t\n   499\t    try:\n   500\t        out = main(grid)\n   501\t    except Exception:\n   502\t        return None\n   503\t\n   504\t    if out.shape != grid.shape:\n   505\t        return None\n   506\t    if np.array_equal(out, grid):\n   507\t        return None\n   508\t    return grid\n   509\t\n   510\t\n   511\tdef generate_input() -> np.ndarray:\n   512\t    rng = np.random.default_rng()\n   513\t    for _ in range(MAX_GEN_ATTEMPTS):\n   514\t        grid = _gen_attempt(rng)\n   515\t        if grid is not None:\n   516\t            return grid\n   517\t    raise RuntimeError(\"failed to generate a valid room-arrow grid\")\n","exit_code":0,"status":"completed"}}
