{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/train/99caaf76.py /home/lixinyu/snap/new/ARC_code/train/8a6d367c.py /home/lixinyu/snap/new/ARC_code/train/db7260a4.py /home/lixinyu/snap/new/ARC_code/eval/4c416de3.py; do nl -ba \"$f\" | sed -n '\"'1,260p'; done\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\t\n     3\tfrom collections import Counter\n     4\t\n     5\timport numpy as np\n     6\t\n     7\tfrom arc_utils import crop_bbox, find_components, get_bg, paste\n     8\timport random\n     9\t\n    10\t\n    11\t_CROSS_MASK = np.array(\n    12\t    [\n    13\t        [False, True, False],\n    14\t        [True, True, True],\n    15\t        [False, True, False],\n    16\t    ],\n    17\t    dtype=bool,\n    18\t)\n    19\t\n    20\t\n    21\tdef _marker_color(g: np.ndarray, bg: int) -> int:\n    22\t    counts = Counter(int(v) for v in g[g != int(bg)])\n    23\t    assert counts, \"expected foreground pixels\"\n    24\t    max_count = max(counts.values())\n    25\t    candidates = [color for color, count in counts.items() if count == max_count]\n    26\t    assert len(candidates) == 1, \"expected a unique repeated marker color\"\n    27\t    marker = int(candidates[0])\n    28\t    assert counts[marker] % 4 == 0, \"marker pixels should form 4-pixel sprites\"\n    29\t    return marker\n    30\t\n    31\t\n    32\tdef _block_kind(block: np.ndarray, bg: int, marker: int) -> str:\n    33\t    assert block.shape == (3, 3), \"expected 3x3 half-block\"\n    34\t    marker_mask = block == int(marker)\n    35\t    other_mask = (block != int(bg)) & ~marker_mask\n    36\t\n    37\t    if int(marker_mask.sum()) == 4 and not bool(other_mask.any()):\n    38\t        return \"marker\"\n    39\t\n    40\t    if not bool(marker_mask.any()) and int(other_mask.sum()) == 5:\n    41\t        assert np.array_equal(other_mask, _CROSS_MASK), \"expected a 5-pixel cross\"\n    42\t        return \"cross\"\n    43\t\n    44\t    raise AssertionError(\"expected either a marker block or a colored cross block\")\n    45\t\n    46\t\n    47\tdef _paste_checked(out: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:\n    48\t    h, w = patch.shape\n    49\t    target = out[int(r0) : int(r0) + h, int(c0) : int(c0) + w]\n    50\t    assert target.shape == patch.shape, \"target patch must fit in the grid\"\n    51\t    assert not bool(np.any((target != int(bg)) & (patch != int(bg)))), \"moved objects must not overlap\"\n    52\t    paste(out, patch, int(r0), int(c0), transparent=int(bg))\n    53\t\n    54\t\n    55\tdef main(grid: np.ndarray) -> np.ndarray:\n    56\t    \"\"\"\n    57\t    Move each marked cross object away from its marker to the grid edge while rotating the colored cross 180 degrees.\n    58\t\n    59\t    Input structure:\n    60\t    - The background is the dominant color.\n    61\t    - Each 8-connected foreground object has nine pixels: a 4-pixel marker-color\n    62\t      sprite attached to a 5-pixel non-marker colored cross.\n    63\t    - Each object bbox is either 3x6 or 6x3, so the marker sprite is on exactly\n    64\t      one side of the cross.\n    65\t\n    66\t    Rule:\n    67\t    - Move the whole object straight away from its marker side until the object\n    68\t      bbox touches the corresponding grid edge.\n    69\t    - Keep the marker sprite unchanged within the object.\n    70\t    - Rotate the 3x3 colored cross block by 180 degrees before placing it.\n    71\t\n    72\t    Key insight:\n    73\t    The marker sprite is a directional tail; the cross is the leading payload,\n    74\t    and only that payload turns around during the slide to the edge.\n    75\t    \"\"\"\n    76\t    g = np.asarray(grid, dtype=int)\n    77\t    H, W = g.shape\n    78\t    bg = get_bg(g)\n    79\t    marker = _marker_color(g, bg)\n    80\t\n    81\t    out = np.full_like(g, int(bg))\n    82\t    objects = find_components(g, bg=bg, connectivity=8, monochromatic=False)\n    83\t    assert objects, \"expected at least one composite object\"\n    84\t\n    85\t    for obj in objects:\n    86\t        assert int(obj[\"area\"]) == 9, \"each composite should contain 9 foreground pixels\"\n    87\t        r0, c0, _r1, _c1 = obj[\"bbox\"]\n    88\t        patch = crop_bbox(g, obj[\"bbox\"])\n    89\t        h, w = patch.shape\n    90\t        moved = patch.copy()\n    91\t\n    92\t        if (h, w) == (3, 6):\n    93\t            left = patch[:, :3]\n    94\t            right = patch[:, 3:]\n    95\t            left_kind = _block_kind(left, bg, marker)\n    96\t            right_kind = _block_kind(right, bg, marker)\n    97\t            assert {left_kind, right_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n    98\t\n    99\t            if left_kind == \"marker\":\n   100\t                moved[:, 3:] = np.rot90(right, 2)\n   101\t                target_r, target_c = int(r0), W - w\n   102\t            else:\n   103\t                moved[:, :3] = np.rot90(left, 2)\n   104\t                target_r, target_c = int(r0), 0\n   105\t\n   106\t        elif (h, w) == (6, 3):\n   107\t            top = patch[:3, :]\n   108\t            bottom = patch[3:, :]\n   109\t            top_kind = _block_kind(top, bg, marker)\n   110\t            bottom_kind = _block_kind(bottom, bg, marker)\n   111\t            assert {top_kind, bottom_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n   112\t\n   113\t            if top_kind == \"marker\":\n   114\t                moved[3:, :] = np.rot90(bottom, 2)\n   115\t                target_r, target_c = H - h, int(c0)\n   116\t            else:\n   117\t                moved[:3, :] = np.rot90(top, 2)\n   118\t                target_r, target_c = 0, int(c0)\n   119\t\n   120\t        else:\n   121\t            raise AssertionError(\"each composite bbox should be 3x6 or 6x3\")\n   122\t\n   123\t        _paste_checked(out, moved, target_r, target_c, bg)\n   124\t\n   125\t    return out\n   126\t\n   127\t# --------------- generator (att2) ---------------\n   128\t\n   129\t# Colors.\n   130\t_GEN_BG = 8\n   131\t_GEN_MARKER = 1\n   132\t_GEN_CENTER = 4\n   133\t_GEN_ARM_COLORS = [0, 2, 3, 5, 6, 7, 9]\n   134\t\n   135\t# Object layout.\n   136\t_GEN_SIDES = [\"left\", \"right\", \"top\", \"bottom\"]\n   137\t_GEN_MARKER_COORDS = {\n   138\t    \"left\": [(0, 0), (1, 1), (1, 2), (2, 0)],\n   139\t    \"right\": [(0, 2), (1, 0), (1, 1), (2, 2)],\n   140\t    \"top\": [(0, 0), (0, 2), (1, 1), (2, 1)],\n   141\t    \"bottom\": [(0, 1), (1, 1), (2, 0), (2, 2)],\n   142\t}\n   143\t_GEN_ARM_POSITIONS = [(0, 1), (1, 0), (1, 2), (2, 1)]\n   144\t\n   145\t# Canvas and placement bounds.\n   146\t_GEN_OBJECT_COUNT_RANGE = (1, 4)\n   147\t_GEN_MAX_SIDE = 18\n   148\t_GEN_MIN_SIDE_BY_OBJECT_COUNT = {1: 8, 2: 8, 3: 10, 4: 12}\n   149\t_GEN_PADDING = 1\n   150\t_GEN_EDGE_GAP = 2\n   151\t_GEN_HORIZONTAL_SIZE = (3, 6)\n   152\t_GEN_VERTICAL_SIZE = (6, 3)\n   153\t\n   154\t# Retry limits.\n   155\t_GEN_MAX_ATTEMPTS = 300\n   156\t\n   157\t\n   158\tdef _gen_marker_block(side: str) -> np.ndarray:\n   159\t    block = np.full((3, 3), _GEN_BG, dtype=int)\n   160\t    for r, c in _GEN_MARKER_COORDS[side]:\n   161\t        block[r, c] = _GEN_MARKER\n   162\t    return block\n   163\t\n   164\t\n   165\tdef _gen_cross_block() -> np.ndarray:\n   166\t    block = np.full((3, 3), _GEN_BG, dtype=int)\n   167\t    block[1, 1] = _GEN_CENTER\n   168\t    for (r, c), color in zip(_GEN_ARM_POSITIONS, random.sample(_GEN_ARM_COLORS, 4)):\n   169\t        block[r, c] = color\n   170\t    return block\n   171\t\n   172\t\n   173\tdef _gen_composite(side: str, cross: np.ndarray) -> np.ndarray:\n   174\t    marker = _gen_marker_block(side)\n   175\t    if side == \"left\":\n   176\t        return np.concatenate([marker, cross], axis=1)\n   177\t    if side == \"right\":\n   178\t        return np.concatenate([cross, marker], axis=1)\n   179\t    if side == \"top\":\n   180\t        return np.concatenate([marker, cross], axis=0)\n   181\t    return np.concatenate([cross, marker], axis=0)\n   182\t\n   183\t\n   184\tdef _gen_input_from_output(side: str, patch: np.ndarray) -> np.ndarray:\n   185\t    out = patch.copy()\n   186\t    if side == \"left\":\n   187\t        out[:, 3:] = np.rot90(out[:, 3:], 2)\n   188\t    elif side == \"right\":\n   189\t        out[:, :3] = np.rot90(out[:, :3], 2)\n   190\t    elif side == \"top\":\n   191\t        out[3:, :] = np.rot90(out[3:, :], 2)\n   192\t    else:\n   193\t        out[:3, :] = np.rot90(out[:3, :], 2)\n   194\t    return out\n   195\t\n   196\t\n   197\tdef _gen_can_place(canvas: np.ndarray, patch: np.ndarray, r0: int, c0: int, padding: int) -> bool:\n   198\t    h, w = patch.shape\n   199\t    H, W = canvas.shape\n   200\t    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:\n   201\t        return False\n   202\t    for dr, dc in np.argwhere(patch != _GEN_BG):\n   203\t        r = int(r0 + dr)\n   204\t        c = int(c0 + dc)\n   205\t        r1 = max(0, r - padding)\n   206\t        r2 = min(H, r + padding + 1)\n   207\t        c1 = max(0, c - padding)\n   208\t        c2 = min(W, c + padding + 1)\n   209\t        if np.any(canvas[r1:r2, c1:c2] != _GEN_BG):\n   210\t            return False\n   211\t    return True\n   212\t\n   213\t\n   214\tdef _gen_output_positions(side: str, H: int, W: int) -> list[tuple[int, int]]:\n   215\t    if side == \"left\":\n   216\t        return [(r, W - _GEN_HORIZONTAL_SIZE[1]) for r in range(H - _GEN_EDGE_GAP)]\n   217\t    if side == \"right\":\n   218\t        return [(r, 0) for r in range(H - _GEN_EDGE_GAP)]\n   219\t    if side == \"top\":\n   220\t        return [(H - _GEN_VERTICAL_SIZE[0], c) for c in range(W - _GEN_EDGE_GAP)]\n   221\t    return [(0, c) for c in range(W - _GEN_EDGE_GAP)]\n   222\t\n   223\t\n   224\tdef _gen_input_positions(side: str, H: int, W: int, target_r: int, target_c: int) -> list[tuple[int, int]]:\n   225\t    if side == \"left\":\n   226\t        return [(target_r, c) for c in range(0, W - _GEN_HORIZONTAL_SIZE[1] - _GEN_PADDING)]\n   227\t    if side == \"right\":\n   228\t        return [(target_r, c) for c in range(_GEN_EDGE_GAP, W - _GEN_HORIZONTAL_SIZE[1] + _GEN_PADDING)]\n   229\t    if side == \"top\":\n   230\t        return [(r, target_c) for r in range(0, H - _GEN_VERTICAL_SIZE[0] - _GEN_PADDING)]\n   231\t    return [(r, target_c) for r in range(_GEN_EDGE_GAP, H - _GEN_VERTICAL_SIZE[0] + _GEN_PADDING)]\n   232\t\n   233\t\n   234\tdef _gen_canvas_shape(n_obj: int) -> tuple[int, int]:\n   235\t    min_side = _GEN_MIN_SIDE_BY_OBJECT_COUNT[int(n_obj)]\n   236\t    return random.randint(min_side, _GEN_MAX_SIDE), random.randint(min_side, _GEN_MAX_SIDE)\n   237\t\n   238\t\n   239\tdef _gen_place_output_objects(expected: np.ndarray, n_obj: int) -> list[tuple[str, np.ndarray, int, int]] | None:\n   240\t    H, W = expected.shape\n   241\t    objects = []\n   242\t\n   243\t    for _ in range(n_obj):\n   244\t        sides = _GEN_SIDES[:]\n   245\t        random.shuffle(sides)\n   246\t        placed = False\n   247\t        for side in sides:\n   248\t            cross = _gen_cross_block()\n   249\t            patch = _gen_composite(side, cross)\n   250\t            positions = _gen_output_positions(side, H, W)\n   251\t            random.shuffle(positions)\n   252\t            for r0, c0 in positions:\n   253\t                if _gen_can_place(expected, patch, r0, c0, padding=_GEN_PADDING):\n   254\t                    paste(expected, patch, int(r0), int(c0), transparent=_GEN_BG)\n   255\t                    objects.append((side, patch, r0, c0))\n   256\t                    placed = True\n   257\t                    break\n   258\t            if placed:\n   259\t                break\n   260\t        if not placed:\n     1\tfrom __future__ import annotations\n     2\t\n     3\timport numpy as np\n     4\t\n     5\tfrom arc_utils import bbox_coords, find_components, get_bg, paste\n     6\t\n     7\t\n     8\tdef _find_frame(g: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:\n     9\t    candidates: list[tuple[int, int, tuple[int, int, int, int]]] = []\n    10\t    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n    11\t        color = int(comp[\"color\"])\n    12\t        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n    13\t        h = r1 - r0 + 1\n    14\t        w = c1 - c0 + 1\n    15\t        if h < 3 or w < 3:\n    16\t            continue\n    17\t\n    18\t        border = np.zeros((h, w), dtype=bool)\n    19\t        border[0, :] = True\n    20\t        border[-1, :] = True\n    21\t        border[:, 0] = True\n    22\t        border[:, -1] = True\n    23\t\n    24\t        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n    25\t        if int(comp[\"area\"]) == int(border.sum()) and np.array_equal(sub == color, border):\n    26\t            candidates.append((int(comp[\"area\"]), color, (r0, c0, r1, c1)))\n    27\t\n    28\t    assert candidates, \"expected one rectangular frame\"\n    29\t    max_area = max(area for area, _color, _bbox in candidates)\n    30\t    largest = [candidate for candidate in candidates if candidate[0] == max_area]\n    31\t    assert len(largest) == 1, \"rectangular frame must be structurally unique\"\n    32\t    _area, color, frame_bbox = largest[0]\n    33\t    return color, frame_bbox\n    34\t\n    35\t\n    36\tdef _templates_above_frame(g: np.ndarray, bg: int, frame_r0: int) -> list[np.ndarray]:\n    37\t    top = g[:frame_r0]\n    38\t    templates: list[np.ndarray] = []\n    39\t    for color in np.unique(top):\n    40\t        color = int(color)\n    41\t        if color == bg:\n    42\t            continue\n    43\t        coords = np.argwhere(top == color)\n    44\t        r0, c0, r1, c1 = bbox_coords(coords)\n    45\t        templates.append(top[r0 : r1 + 1, c0 : c1 + 1] == color)\n    46\t\n    47\t    assert templates, \"expected upper template masks\"\n    48\t    return templates\n    49\t\n    50\t\n    51\tdef main(grid: np.ndarray) -> np.ndarray:\n    52\t    \"\"\"\n    53\t    Complete the framed area by expanding the unique upper template that contains the existing seed pixels.\n    54\t\n    55\t    Input structure:\n    56\t    - A teal background contains small colored template masks above a larger rectangular frame.\n    57\t    - The frame encloses one fill color arranged as a partial block-scaled copy of one template.\n    58\t    - The frame interior dimensions are an integer square scale of the matching template bbox.\n    59\t\n    60\t    Rule:\n    61\t    - Crop to the rectangular frame.\n    62\t    - Identify the unique upper template whose block-scaled mask covers every existing fill pixel inside the frame.\n    63\t    - Reset the frame interior to background and paint the whole scaled mask with the fill color.\n    64\t\n    65\t    Key insight:\n    66\t    The lower colored pixels are seed cells that reveal which upper template should be completed inside the frame.\n    67\t    \"\"\"\n    68\t    g = np.asarray(grid, dtype=int)\n    69\t    bg = int(get_bg(g))\n    70\t    frame_color, (r0, c0, r1, c1) = _find_frame(g, bg)\n    71\t\n    72\t    out = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n    73\t    interior = out[1:-1, 1:-1]\n    74\t    fill_colors = set(map(int, np.unique(interior))) - {bg, frame_color}\n    75\t    assert len(fill_colors) == 1, \"frame interior must contain exactly one fill color\"\n    76\t    fill_color = fill_colors.pop()\n    77\t\n    78\t    seed = interior == fill_color\n    79\t    assert np.any(seed), \"frame must contain seed pixels\"\n    80\t    ih, iw = seed.shape\n    81\t\n    82\t    matches: list[np.ndarray] = []\n    83\t    for template in _templates_above_frame(g, bg, r0):\n    84\t        th, tw = template.shape\n    85\t        if ih % th != 0 or iw % tw != 0:\n    86\t            continue\n    87\t        scale_h = ih // th\n    88\t        scale_w = iw // tw\n    89\t        if scale_h != scale_w:\n    90\t            continue\n    91\t\n    92\t        scaled = np.kron(template, np.ones((scale_h, scale_w), dtype=bool))\n    93\t        if np.all(~seed | scaled):\n    94\t            matches.append(scaled)\n    95\t\n    96\t    assert len(matches) == 1, \"seed pixels must select exactly one scaled template\"\n    97\t    completed = matches[0]\n    98\t    assert completed.shape == interior.shape\n    99\t\n   100\t    interior[:, :] = bg\n   101\t    interior[completed] = fill_color\n   102\t    return out\n   103\t\n   104\t# --------------- generator (att2) ---------------\n   105\t\n   106\tGEN_BG = 8\n   107\tGEN_GRID_SHAPE = (27, 21)\n   108\tGEN_TEMPLATE_SHAPES = [(3, 3), (3, 4), (4, 3)]\n   109\tGEN_TEMPLATE_COUNT_RANGE = (2, 6)\n   110\tGEN_TEMPLATE_ROW = 1\n   111\tGEN_TEMPLATE_LEFT_MIN = 1\n   112\tGEN_TEMPLATE_GAP = 1\n   113\tGEN_MAX_TEMPLATE_SPAN = 19\n   114\tGEN_DENSITY_MIN_NUM = 1\n   115\tGEN_DENSITY_MIN_DEN = 2\n   116\tGEN_DENSITY_MAX_NUM = 5\n   117\tGEN_DENSITY_MAX_DEN = 6\n   118\tGEN_SCALE_RANGE = (2, 5)\n   119\tGEN_SEED_COUNTS = (2, 3)\n   120\tGEN_SEED_FRACTION_RANGE = (0.20, 0.60)\n   121\tGEN_FRAME_ROW_GAP = 2\n   122\tGEN_FRAME_LEFT_MIN = 1\n   123\tGEN_ATTEMPTS = 300\n   124\tGEN_PALETTE = [0, 1, 2, 3, 4, 5, 6, 7, 9]\n   125\t\n   126\tdef _gen_has_full_bbox(mask: np.ndarray) -> bool:\n   127\t    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())\n   128\t\n   129\t\n   130\tdef _gen_valid_masks(th: int, tw: int) -> list[np.ndarray]:\n   131\t    n = int(th * tw)\n   132\t    lo = (GEN_DENSITY_MIN_NUM * n + GEN_DENSITY_MIN_DEN - 1) // GEN_DENSITY_MIN_DEN\n   133\t    hi = (GEN_DENSITY_MAX_NUM * n) // GEN_DENSITY_MAX_DEN\n   134\t    masks: list[np.ndarray] = []\n   135\t    for bits in range(1 << n):\n   136\t        count = int(bits.bit_count())\n   137\t        if count < lo or count > hi:\n   138\t            continue\n   139\t        flat = np.array([(bits >> k) & 1 for k in range(n)], dtype=bool)\n   140\t        mask = flat.reshape(th, tw)\n   141\t        if _gen_has_full_bbox(mask):\n   142\t            masks.append(mask)\n   143\t    return masks\n   144\t\n   145\t\n   146\tdef _gen_colored_patch(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\n   147\t    patch = np.full(mask.shape, bg, dtype=int)\n   148\t    patch[mask] = int(color)\n   149\t    return patch\n   150\t\n   151\t\n   152\tdef _gen_draw_frame(shape: tuple[int, int], bg: int, frame_color: int) -> np.ndarray:\n   153\t    patch = np.full(shape, bg, dtype=int)\n   154\t    patch[0, :] = frame_color\n   155\t    patch[-1, :] = frame_color\n   156\t    patch[:, 0] = frame_color\n   157\t    patch[:, -1] = frame_color\n   158\t    return patch\n   159\t\n   160\t\n   161\tdef _gen_frame_patch(\n   162\t    target_mask: np.ndarray,\n   163\t    seed_cells: np.ndarray,\n   164\t    scale: int,\n   165\t    bg: int,\n   166\t    frame_color: int,\n   167\t    fill_color: int,\n   168\t) -> tuple[np.ndarray, np.ndarray]:\n   169\t    th, tw = map(int, target_mask.shape)\n   170\t    scaled = np.kron(target_mask, np.ones((scale, scale), dtype=bool))\n   171\t    out = _gen_draw_frame((th * scale + 2, tw * scale + 2), bg, frame_color)\n   172\t    out[1:-1, 1:-1][scaled] = fill_color\n   173\t\n   174\t    frame = _gen_draw_frame(out.shape, bg, frame_color)\n   175\t    for r, c in seed_cells:\n   176\t        rr = int(r) * scale\n   177\t        cc = int(c) * scale\n   178\t        frame[1 + rr : 1 + rr + scale, 1 + cc : 1 + cc + scale] = fill_color\n   179\t    return frame, out\n   180\t\n   181\t\n   182\tdef _gen_attempt() -> np.ndarray | None:\n   183\t    rng = np.random.default_rng()\n   184\t    bg = GEN_BG\n   185\t    count = int(rng.integers(*GEN_TEMPLATE_COUNT_RANGE))\n   186\t    shape_choices = [\n   187\t        shape for shape in GEN_TEMPLATE_SHAPES if count * shape[1] + count - 1 <= GEN_MAX_TEMPLATE_SPAN\n   188\t    ]\n   189\t    th, tw = shape_choices[int(rng.integers(0, len(shape_choices)))]\n   190\t    scale = int(rng.integers(*GEN_SCALE_RANGE))\n   191\t\n   192\t    valid_masks = _gen_valid_masks(th, tw)\n   193\t    if len(valid_masks) < count:\n   194\t        return None\n   195\t\n   196\t    target = valid_masks[int(rng.integers(0, len(valid_masks)))]\n   197\t    true_cells = np.argwhere(target)\n   198\t    target_area = int(len(true_cells))\n   199\t    min_seed_frac, max_seed_frac = GEN_SEED_FRACTION_RANGE\n   200\t    seed_counts = [k for k in GEN_SEED_COUNTS if min_seed_frac <= k / target_area <= max_seed_frac]\n   201\t    if not seed_counts:\n   202\t        return None\n   203\t    seed_count = int(seed_counts[int(rng.integers(0, len(seed_counts)))])\n   204\t    seed_idx = rng.choice(target_area, size=seed_count, replace=False)\n   205\t    seed_cells = true_cells[seed_idx]\n   206\t\n   207\t    covers_seed = np.array([bool(mask[seed_cells[:, 0], seed_cells[:, 1]].all()) for mask in valid_masks])\n   208\t    distractor_pool = [mask for mask, covers in zip(valid_masks, covers_seed) if not covers]\n   209\t    if len(distractor_pool) < count - 1:\n   210\t        return None\n   211\t    distractor_idx = rng.choice(len(distractor_pool), size=count - 1, replace=False)\n   212\t    distractors = [distractor_pool[int(i)] for i in distractor_idx]\n   213\t\n   214\t    masks = distractors + [target]\n   215\t    rng.shuffle(masks)\n   216\t\n   217\t    colors = list(GEN_PALETTE)\n   218\t    rng.shuffle(colors)\n   219\t    frame_color = int(colors[0])\n   220\t    fill_color = int(colors[1])\n   221\t    template_colors = [int(c) for c in colors[2 : 2 + count]]\n   222\t\n   223\t    frame, expected = _gen_frame_patch(target, seed_cells, scale, bg, frame_color, fill_color)\n   224\t    grid_h, grid_w = GEN_GRID_SHAPE\n   225\t    grid = np.full(GEN_GRID_SHAPE, bg, dtype=int)\n   226\t\n   227\t    total_template_w = count * tw + count - 1\n   228\t    template_c0 = int(rng.integers(GEN_TEMPLATE_LEFT_MIN, grid_w - total_template_w))\n   229\t    c = template_c0\n   230\t    for mask, color in zip(masks, template_colors):\n   231\t        paste(grid, _gen_colored_patch(mask, color, bg), GEN_TEMPLATE_ROW, c, transparent=bg)\n   232\t        c += tw + GEN_TEMPLATE_GAP\n   233\t\n   234\t    fh, fw = map(int, frame.shape)\n   235\t    min_r0 = th + GEN_FRAME_ROW_GAP\n   236\t    max_r0 = grid_h - fh\n   237\t    if min_r0 > max_r0:\n   238\t        return None\n   239\t    frame_r0 = int(rng.integers(min_r0, max_r0 + 1))\n   240\t    frame_c0 = int(rng.integers(GEN_FRAME_LEFT_MIN, grid_w - fw))\n   241\t    paste(grid, frame, frame_r0, frame_c0)\n   242\t\n   243\t    try:\n   244\t        if not np.array_equal(main(grid), expected):\n   245\t            return None\n   246\t    except Exception:\n   247\t        return None\n   248\t    return grid\n   249\t\n   250\t\n   251\tdef generate_input() -> np.ndarray:\n   252\t    for _ in range(GEN_ATTEMPTS):\n   253\t        grid = _gen_attempt()\n   254\t        if grid is not None:\n   255\t            return grid\n   256\t    raise RuntimeError(\"failed to generate valid 8a6d367c input\")\n     1\tfrom __future__ import annotations\n     2\t\n     3\timport numpy as np\n     4\t\n     5\tfrom arc_utils import colors_present, find_components, get_bg, paste\n     6\t\n     7\t\n     8\tdef _closed_u_containers(g: np.ndarray, wall_color: int, bg: int) -> list[tuple[int, int, int, int]]:\n     9\t    h, w = g.shape\n    10\t    containers = []\n    11\t\n    12\t    for bottom in range(1, h):\n    13\t        for left in range(w - 2):\n    14\t            if int(g[bottom, left]) != wall_color:\n    15\t                continue\n    16\t            for right in range(left + 2, w):\n    17\t                if int(g[bottom, right]) != wall_color:\n    18\t                    continue\n    19\t                if not np.all(g[bottom, left : right + 1] == wall_color):\n    20\t                    continue\n    21\t\n    22\t                top = bottom\n    23\t                while top > 0 and int(g[top - 1, left]) == wall_color and int(g[top - 1, right]) == wall_color:\n    24\t                    top -= 1\n    25\t                if top == bottom:\n    26\t                    continue\n    27\t\n    28\t                interior = g[top:bottom, left + 1 : right]\n    29\t                if interior.size == 0 or not np.all(interior == bg):\n    30\t                    continue\n    31\t                containers.append((top, bottom, left, right))\n    32\t\n    33\t    return containers\n    34\t\n    35\t\n    36\tdef main(grid: np.ndarray) -> np.ndarray:\n    37\t    \"\"\"\n    38\t    Drop the singleton marker into the matching red U-shaped container, or make a bottom-row puddle if no closed container is hit.\n    39\t\n    40\t    Input structure\n    41\t    - The grid has a dominant background, one singleton marker pixel on the top row,\n    42\t      and one other foreground color forming vertical bars and bottom segments.\n    43\t    - A closed container is a U shape: two vertical side bars with a continuous\n    44\t      bottom segment between them and an empty rectangular interior above the bottom.\n    45\t\n    46\t    Rule\n    47\t    - Remove the top marker from its original cell.\n    48\t    - If exactly one closed U-shaped container has the marker column within its\n    49\t      horizontal footprint, fill that container's empty interior with the marker color.\n    50\t    - If no closed container is under the marker column, fill the whole bottom row\n    51\t      with the marker color.\n    52\t\n    53\t    Key insight\n    54\t    - The marker does not identify a color by value; it identifies a vertical drop\n    55\t      column, and only a structurally closed U shape can catch and contain the fill.\n    56\t    \"\"\"\n    57\t    g = np.asarray(grid, dtype=int)\n    58\t    assert g.ndim == 2\n    59\t\n    60\t    bg = get_bg(g)\n    61\t    foreground_colors = colors_present(g, exclude={bg})\n    62\t    assert len(foreground_colors) == 2, \"expected marker and wall colors\"\n    63\t\n    64\t    singleton_colors = [color for color in foreground_colors if int(np.count_nonzero(g == color)) == 1]\n    65\t    assert len(singleton_colors) == 1, \"expected exactly one singleton marker color\"\n    66\t    marker_color = singleton_colors[0]\n    67\t\n    68\t    wall_colors = [color for color in foreground_colors if color != marker_color]\n    69\t    assert len(wall_colors) == 1\n    70\t    wall_color = wall_colors[0]\n    71\t\n    72\t    marker_coords = np.argwhere(g == marker_color)\n    73\t    assert marker_coords.shape == (1, 2)\n    74\t    marker_r, marker_c = map(int, marker_coords[0])\n    75\t    assert marker_r == 0, \"marker must sit on the top row\"\n    76\t\n    77\t    containers = [\n    78\t        container\n    79\t        for container in _closed_u_containers(g, wall_color, bg)\n    80\t        if container[0] > marker_r and container[2] <= marker_c <= container[3]\n    81\t    ]\n    82\t    assert len(containers) <= 1, \"marker column must select at most one closed container\"\n    83\t\n    84\t    out = g.copy()\n    85\t    out[marker_r, marker_c] = bg\n    86\t    if containers:\n    87\t        top, bottom, left, right = containers[0]\n    88\t        out[top:bottom, left + 1 : right] = marker_color\n    89\t    else:\n    90\t        assert np.all(out[-1, :] == bg), \"missed marker should fall to an empty bottom row\"\n    91\t        out[-1, :] = marker_color\n    92\t    return out\n    93\t\n    94\t# --------------- generator (o5x) ---------------\n    95\t\n    96\t# Fixed ARC colors and canvas.\n    97\t_GEN_BG = 0\n    98\t_GEN_MARKER = 1\n    99\t_GEN_WALL = 2\n   100\t_GEN_H = 10\n   101\t_GEN_W = 10\n   102\t\n   103\t# Vertical layout bounds; row 9 stays empty in generated inputs.\n   104\t_GEN_MARKER_ROW = 0\n   105\t_GEN_MIN_WALL_ROW = 2\n   106\t_GEN_LAST_WALL_ROW = 8\n   107\t\n   108\t# Closed container interior size ranges, with exclusive upper bounds.\n   109\t_GEN_INTERIOR_H_RANGE = (2, 4)\n   110\t_GEN_INTERIOR_W_RANGE = (1, 6)\n   111\t\n   112\t# Broken distractor patch size ranges, with exclusive upper bounds.\n   113\t_GEN_DISTRACTOR_H_RANGE = (2, 4)\n   114\t_GEN_DISTRACTOR_W_RANGE = (4, 7)\n   115\t\n   116\t# Scenario mix and distractor count ranges, with exclusive upper bounds.\n   117\t_GEN_FILL_CONTAINER_PROB = 0.67\n   118\t_GEN_MISSED_HAS_U_PROB = 0.55\n   119\t_GEN_DISTRACTORS_WITH_U_RANGE = (0, 2)\n   120\t_GEN_DISTRACTORS_WITHOUT_U_RANGE = (1, 4)\n   121\t\n   122\t# Rejection-sampling retry budget.\n   123\t_GEN_MAX_ATTEMPTS = 300\n   124\t\n   125\t\n   126\tdef _gen_u_patch(interior_h: int, interior_w: int) -> np.ndarray:\n   127\t    patch = np.full((interior_h + 1, interior_w + 2), _GEN_BG, dtype=int)\n   128\t    patch[:, 0] = _GEN_WALL\n   129\t    patch[:, -1] = _GEN_WALL\n   130\t    patch[-1, :] = _GEN_WALL\n   131\t    return patch\n   132\t\n   133\t\n   134\tdef _gen_sample_u() -> tuple[int, int, int, int, int, int]:\n   135\t    interior_h = int(np.random.randint(*_GEN_INTERIOR_H_RANGE))\n   136\t    interior_w = int(np.random.randint(*_GEN_INTERIOR_W_RANGE))\n   137\t    top = int(np.random.randint(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - interior_h + 1))\n   138\t    bottom = top + interior_h\n   139\t    left = int(np.random.randint(0, _GEN_W - interior_w - 1))\n   140\t    right = left + interior_w + 1\n   141\t    return top, bottom, left, right, interior_h, interior_w\n   142\t\n   143\t\n   144\tdef _gen_broken_u_patch(height: int, width: int, *, gap: int | None = None, missing_side: str | None = None) -> np.ndarray:\n   145\t    patch = np.full((height, width), _GEN_BG, dtype=int)\n   146\t    if missing_side != \"left\":\n   147\t        patch[:, 0] = _GEN_WALL\n   148\t    if missing_side != \"right\":\n   149\t        patch[:, -1] = _GEN_WALL\n   150\t    patch[-1, :] = _GEN_WALL\n   151\t    if gap is not None:\n   152\t        patch[-1, gap] = _GEN_BG\n   153\t    return patch\n   154\t\n   155\t\n   156\tdef _gen_distractor_patches() -> list[np.ndarray]:\n   157\t    patches: list[np.ndarray] = []\n   158\t\n   159\t    for h in range(*_GEN_DISTRACTOR_H_RANGE):\n   160\t        for w in range(*_GEN_DISTRACTOR_W_RANGE):\n   161\t            gap = int(np.random.randint(1, w - 1))\n   162\t            patches.append(_gen_broken_u_patch(h, w, gap=gap))\n   163\t            patches.append(_gen_broken_u_patch(h, w, missing_side=\"left\"))\n   164\t            patches.append(_gen_broken_u_patch(h, w, missing_side=\"right\"))\n   165\t\n   166\t    return patches\n   167\t\n   168\t\n   169\tdef _gen_valid_positions(grid: np.ndarray, patch: np.ndarray) -> list[tuple[int, int]]:\n   170\t    ph, pw = patch.shape\n   171\t    local = np.argwhere(patch == _GEN_WALL)\n   172\t    local_set = {(int(r), int(c)) for r, c in local}\n   173\t    touch_local = {\n   174\t        (r + dr, c + dc)\n   175\t        for r, c in local_set\n   176\t        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1))\n   177\t        if (r + dr, c + dc) not in local_set\n   178\t    }\n   179\t    positions: list[tuple[int, int]] = []\n   180\t\n   181\t    for r0 in range(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - ph + 2):\n   182\t        for c0 in range(0, _GEN_W - pw + 1):\n   183\t            if np.any(grid[r0 + local[:, 0], c0 + local[:, 1]] != _GEN_BG):\n   184\t                continue\n   185\t            touches = any(\n   186\t                0 <= r0 + r < _GEN_H\n   187\t                and 0 <= c0 + c < _GEN_W\n   188\t                and grid[r0 + r, c0 + c] == _GEN_WALL\n   189\t                for r, c in touch_local\n   190\t            )\n   191\t            if not touches:\n   192\t                positions.append((r0, c0))\n   193\t\n   194\t    return positions\n   195\t\n   196\t\n   197\tdef _gen_place_distractors(grid: np.ndarray, count: int) -> bool:\n   198\t    patches = _gen_distractor_patches()\n   199\t    for _ in range(count):\n   200\t        placed = False\n   201\t        for idx in np.random.permutation(len(patches)):\n   202\t            patch = patches[int(idx)]\n   203\t            positions = _gen_valid_positions(grid, patch)\n   204\t            if not positions:\n   205\t                continue\n   206\t            r0, c0 = positions[int(np.random.randint(0, len(positions)))]\n   207\t            paste(grid, patch, r0, c0, transparent=_GEN_BG)\n   208\t            placed = True\n   209\t            break\n   210\t        if not placed:\n   211\t            return False\n   212\t    return True\n   213\t\n   214\t\n   215\t_GenUBox = tuple[int, int, int, int]\n   216\t\n   217\t\n   218\tdef _gen_design_expected() -> tuple[np.ndarray, bool, _GenUBox | None, int, int]:\n   219\t    \"\"\"Build the expected output and return metadata needed to derive the input.\"\"\"\n   220\t    expected = np.full((_GEN_H, _GEN_W), _GEN_BG, dtype=int)\n   221\t    fill_container = bool(np.random.random() < _GEN_FILL_CONTAINER_PROB)\n   222\t    has_u = fill_container or bool(np.random.random() < _GEN_MISSED_HAS_U_PROB)\n   223\t    u_box = None\n   224\t\n   225\t    if has_u:\n   226\t        top, bottom, left, right, interior_h, interior_w = _gen_sample_u()\n   227\t        paste(expected, _gen_u_patch(interior_h, interior_w), top, left, transparent=_GEN_BG)\n   228\t        u_box = (top, bottom, left, right)\n   229\t        if fill_container:\n   230\t            marker_c = int(np.random.randint(left + 1, right))\n   231\t            expected[top:bottom, left + 1 : right] = _GEN_MARKER\n   232\t        else:\n   233\t            outside = [c for c in range(_GEN_W) if not (left <= c <= right)]\n   234\t            marker_c = int(outside[int(np.random.randint(0, len(outside)))])\n   235\t            expected[-1, :] = _GEN_MARKER\n   236\t        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITH_U_RANGE))\n   237\t    else:\n   238\t        marker_c = int(np.random.randint(0, _GEN_W))\n   239\t        expected[-1, :] = _GEN_MARKER\n   240\t        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITHOUT_U_RANGE))\n   241\t\n   242\t    return expected, fill_container, u_box, marker_c, distractor_count\n   243\t\n   244\t\n   245\tdef _gen_input_from_expected(expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> np.ndarray:\n   246\t    inp = expected.copy()\n   247\t    if fill_container:\n   248\t        assert u_box is not None\n   249\t        top, bottom, left, right = u_box\n   250\t        inp[top:bottom, left + 1 : right] = _GEN_BG\n   251\t    else:\n   252\t        inp[-1, :] = _GEN_BG\n   253\t    inp[_GEN_MARKER_ROW, marker_c] = _GEN_MARKER\n   254\t    return inp\n   255\t\n   256\t\n   257\tdef _gen_valid_pair(inp: np.ndarray, expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> bool:\n   258\t    \"\"\"Check structural invariants and the solver oracle.\"\"\"\n   259\t    if np.count_nonzero(inp == _GEN_MARKER) != 1 or inp[_GEN_MARKER_ROW, marker_c] != _GEN_MARKER:\n   260\t        return False\n     1\timport numpy as np\n     2\tfrom collections import Counter\n     3\t\n     4\tfrom arc_utils import get_bg\n     5\timport random\n     6\tfrom arc_utils import draw_line\n     7\t\n     8\t\n     9\tCORNER_KINDS = ('TL', 'TR', 'BL', 'BR')\n    10\t\n    11\t# Inward-along-frame-edge directions for each corner kind.\n    12\tEDGE_DIRS = {\n    13\t    'TL': ((+1, 0), (0, +1)),\n    14\t    'TR': ((+1, 0), (0, -1)),\n    15\t    'BL': ((-1, 0), (0, +1)),\n    16\t    'BR': ((-1, 0), (0, -1)),\n    17\t}\n    18\t# Outward-from-corner directions; cells here must not be 0 (guards mid-edge false positives).\n    19\tOUT_DIRS = {\n    20\t    'TL': ((-1, 0), (0, -1)),\n    21\t    'TR': ((-1, 0), (0, +1)),\n    22\t    'BL': ((+1, 0), (0, -1)),\n    23\t    'BR': ((+1, 0), (0, +1)),\n    24\t}\n    25\t\n    26\t# Radius for scanning a corner's neighborhood. Must exceed max canonical |dr|,|dc| a pattern can have.\n    27\t_NEIGH_R = 3\n    28\t\n    29\t\n    30\tdef _rot(dr, dc, kind):\n    31\t    \"\"\"Map actual offset <-> canonical (TL-orientation) offset; self-inverse.\"\"\"\n    32\t    if kind == 'TL': return (dr, dc)\n    33\t    if kind == 'TR': return (dr, -dc)\n    34\t    if kind == 'BL': return (-dr, dc)\n    35\t    if kind == 'BR': return (-dr, -dc)\n    36\t\n    37\t\n    38\tdef _edge_metric(g, r, c, dr, dc, bg, H, W, max_step=10):\n    39\t    \"\"\"Walk from (r,c) along (dr,dc) until bg/boundary. Return (non_bg_count, saw_zero).\n    40\t    A real frame edge has both: multiple non-bg cells and at least one 0-cell (to exclude\n    41\t    pattern-interior paths composed entirely of painted cells).\"\"\"\n    42\t    cnt = 0\n    43\t    saw_zero = False\n    44\t    for k in range(1, max_step + 1):\n    45\t        rr, cc = r + k*dr, c + k*dc\n    46\t        if not (0 <= rr < H and 0 <= cc < W): break\n    47\t        v = int(g[rr, cc])\n    48\t        if v == bg: break\n    49\t        cnt += 1\n    50\t        if v == 0: saw_zero = True\n    51\t    return cnt, saw_zero\n    52\t\n    53\t\n    54\tdef _find_corners(g, bg):\n    55\t    H, W = g.shape\n    56\t    corners = []\n    57\t    for r in range(H):\n    58\t        for c in range(W):\n    59\t            if int(g[r, c]) == bg:\n    60\t                continue\n    61\t            for kind in CORNER_KINDS:\n    62\t                (d1r, d1c), (d2r, d2c) = EDGE_DIRS[kind]\n    63\t                r1, c1 = r + d1r, c + d1c\n    64\t                r2, c2 = r + d2r, c + d2c\n    65\t                if not (0 <= r1 < H and 0 <= c1 < W and 0 <= r2 < H and 0 <= c2 < W):\n    66\t                    continue\n    67\t                if int(g[r1, c1]) == bg or int(g[r2, c2]) == bg:\n    68\t                    continue\n    69\t                # Each inward edge must be a real frame: >=3 non-bg cells AND >=1 actual 0.\n    70\t                cnt1, sz1 = _edge_metric(g, r, c, d1r, d1c, bg, H, W)\n    71\t                cnt2, sz2 = _edge_metric(g, r, c, d2r, d2c, bg, H, W)\n    72\t                if not (cnt1 >= 3 and sz1 and cnt2 >= 3 and sz2): continue\n    73\t                # Outward cells must not be 0 (rules out mid-edge false positives).\n    74\t                ok = True\n    75\t                for (odr, odc) in OUT_DIRS[kind]:\n    76\t                    rr, cc = r + odr, c + odc\n    77\t                    if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == 0:\n    78\t                        ok = False; break\n    79\t                if not ok: continue\n    80\t                corners.append((r, c, kind))\n    81\t                break  # one kind per cell\n    82\t    return corners\n    83\t\n    84\t\n    85\tdef _colored_around(g, r, c, kind, bg):\n    86\t    H, W = g.shape\n    87\t    items = []\n    88\t    for dr in range(-_NEIGH_R, _NEIGH_R + 1):\n    89\t        for dc in range(-_NEIGH_R, _NEIGH_R + 1):\n    90\t            rr, cc = r + dr, c + dc\n    91\t            if not (0 <= rr < H and 0 <= cc < W): continue\n    92\t            v = int(g[rr, cc])\n    93\t            if v == bg or v == 0: continue\n    94\t            items.append((_rot(dr, dc, kind), v))\n    95\t    return items\n    96\t\n    97\t\n    98\tdef main(grid: np.ndarray) -> np.ndarray:\n    99\t    \"\"\"\n   100\t    Replicate a pre-drawn corner pattern to every other marker-bearing corner.\n   101\t\n   102\t    Input structure:\n   103\t    - bg = most frequent color. Hollow 0-frames (possibly partial L-shapes); each\n   104\t      frame-corner cell is either 0 or a painted (non-bg, non-0) color.\n   105\t    - >= 1 'source' corner: the pattern is already drawn (one color, both outward\n   106\t      cells and an inward-diagonal trail).\n   107\t    - Other corners: a single colored pixel on the inward diagonal at the pattern's\n   108\t      deepest (k,k) offset; the pixel's color is that corner's target color.\n   109\t\n   110\t    Rule:\n   111\t    - Extract the canonical (TL-oriented) pattern from any source.\n   112\t    - For each non-source corner whose marker cell is colored, paint the same\n   113\t      pattern rotated to that corner's orientation, using the marker's color.\n   114\t\n   115\t    Key insight: the pattern is symmetric about the corner's inward-diagonal axis\n   116\t    (canonical dr == dc), so it reflects cleanly across all four corner orientations.\n   117\t    Painting uses each target's OWN marker color, not the source color.\n   118\t    \"\"\"\n   119\t    g = np.asarray(grid, dtype=int)\n   120\t    H, W = g.shape\n   121\t    bg = int(get_bg(g))\n   122\t\n   123\t    corners = _find_corners(g, bg)\n   124\t    assert corners, \"no frame corner detected\"\n   125\t\n   126\t    per_corner = {c: _colored_around(g, *c, bg) for c in corners}\n   127\t\n   128\t    # Source = corner with >=2 strictly-outward (canonical dr<0 or dc<0) colored cells\n   129\t    # of a single color.\n   130\t    def _is_outward(off): return off[0] < 0 or off[1] < 0\n   131\t    sources = []\n   132\t    for c_key, items in per_corner.items():\n   133\t        outward = [(o, v) for (o, v) in items if _is_outward(o)]\n   134\t        if len(outward) >= 2:\n   135\t            colors = {v for (_, v) in outward}\n   136\t            assert len(colors) == 1, (\n   137\t                f\"source {c_key} has mixed outward colors: {colors}\"\n   138\t            )\n   139\t            sources.append(c_key)\n   140\t    assert sources, \"at least one source corner (pre-drawn outward pattern) required\"\n   141\t\n   142\t    def _extract(c_key):\n   143\t        items = per_corner[c_key]\n   144\t        pat_col = Counter(v for (_, v) in items).most_common(1)[0][0]\n   145\t        return frozenset(o for (o, v) in items if v == pat_col), pat_col\n   146\t\n   147\t    canon, _ = _extract(sources[0])\n   148\t    for s in sources[1:]:\n   149\t        other, _ = _extract(s)\n   150\t        assert other == canon, (\n   151\t            f\"source patterns disagree: {sorted(canon)} vs {sorted(other)}\"\n   152\t        )\n   153\t\n   154\t    # Pattern must be symmetric about the corner's inward-diagonal axis (dr==dc).\n   155\t    for (dr, dc) in canon:\n   156\t        assert (dc, dr) in canon, (\n   157\t            f\"pattern not diagonally symmetric: ({dr},{dc}) has no mirror ({dc},{dr})\"\n   158\t        )\n   159\t\n   160\t    # Pattern must anchor at least one inward-diagonal cell so targets have a marker.\n   161\t    diag_ks = [dr for (dr, dc) in canon if dr == dc and dr > 0]\n   162\t    assert diag_ks, \"pattern has no inward-diagonal cell to anchor markers\"\n   163\t    marker_canon = (max(diag_ks), max(diag_ks))\n   164\t\n   165\t    # Classify non-source corners as targets by reading their marker cell.\n   166\t    src_set = set(sources)\n   167\t    targets = []\n   168\t    for c_key in corners:\n   169\t        if c_key in src_set: continue\n   170\t        r, c, kind = c_key\n   171\t        mdr, mdc = _rot(*marker_canon, kind)\n   172\t        mr, mc = r + mdr, c + mdc\n   173\t        if not (0 <= mr < H and 0 <= mc < W):\n   174\t            continue\n   175\t        v = int(g[mr, mc])\n   176\t        if v == bg or v == 0:\n   177\t            continue  # no marker: this detected corner plays no role\n   178\t        tcol = v\n   179\t        # All input cells at this corner's canonical pattern offsets must agree in color.\n   180\t        for (off, color) in per_corner[c_key]:\n   181\t            if off in canon:\n   182\t                assert color == tcol, (\n   183\t                    f\"target ({r},{c},{kind}) has conflicting color {color} at \"\n   184\t                    f\"canonical offset {off}; expected {tcol}\"\n   185\t                )\n   186\t        targets.append((r, c, kind, tcol))\n   187\t\n   188\t    assert targets, \"no target corners detected (every corner appears to be a source)\"\n   189\t\n   190\t    out = g.copy()\n   191\t    for (r, c, kind, tcol) in targets:\n   192\t        for (cdr, cdc) in canon:\n   193\t            adr, adc = _rot(cdr, cdc, kind)\n   194\t            rr, cc = r + adr, c + adc\n   195\t            if not (0 <= rr < H and 0 <= cc < W): continue\n   196\t            v = int(out[rr, cc])\n   197\t            assert v == bg or v == 0 or v == tcol, (\n   198\t                f\"paint conflict at ({rr},{cc}) for target ({r},{c},{kind}) \"\n   199\t                f\"color {tcol}: existing color {v}\"\n   200\t            )\n   201\t            out[rr, cc] = tcol\n   202\t\n   203\t    return out\n   204\t\n   205\t# --------------- generator (output-first pattern replication (Codex)) ---------------\n   206\t\n   207\t# --- canvas & layout ---\n   208\tH_RANGE = (18, 24)            # grid height bounds (inclusive)\n   209\tW_RANGE = (18, 24)            # grid width bounds (inclusive)\n   210\tBORDER = 1                    # min bg gap between a frame and grid edge\n   211\tFRAME_GAP = 4                 # min bg gap between two frames\n   212\tFRAME_SIZE_RANGE = (5, 8)     # per-side length of a hollow 0-frame (inclusive)\n   213\tSOURCE_MIN_SIZE = 6           # only frames strictly larger than the minimum may host sources\n   214\t\n   215\t# --- structural counts ---\n   216\tN_FRAMES_2_PROB = 0.5         # probability of 2-frame layout (else 3-frame)\n   217\tTWO_FRAME_HORIZONTAL_PROB = 0.5  # probability of side-by-side vs stacked 2-frame layout\n   218\tN_SOURCES_MAX = 2             # upper bound on source corners per grid (>= 1)\n   219\t\n   220\t# --- generation retries ---\n   221\tMAX_ATTEMPTS = 300\n   222\t\n   223\t# --- canonical (TL-oriented) pattern templates ---\n   224\t# Each: list of (dr, dc) offsets from the TL corner cell; must be diagonally\n   225\t# symmetric (dr==dc axis) and contain >=1 inward-diagonal cell (k, k) with k>=1.\n   226\tPATTERN_TEMPLATES = (\n   227\t    [(-1, 0), (0, -1), (0, 0), (1, 1)],\n   228\t    [(-1, -1), (-1, 0), (0, -1), (1, 1)],\n   229\t    [(-1, 0), (0, -1), (0, 0), (1, 1), (2, 2)],\n   230\t    [(-1, -1), (-1, 0), (0, -1), (1, 1), (0, 0)],\n   231\t    [(-1, -1), (-1, 0), (0, -1), (1, 1), (2, 2)],\n   232\t    [(-1, -1), (-1, 0), (0, -1), (0, 0), (1, 1), (2, 2)],\n   233\t)\n   234\t\n   235\t# Offsets from a frame's top-left origin (r, c) to each corner cell of a size-N frame:\n   236\t# applied as (r + dr*(size-1), c + dc*(size-1)).\n   237\t_CORNER_OFFSETS = {'TL': (0, 0), 'TR': (0, 1), 'BL': (1, 0), 'BR': (1, 1)}\n   238\t\n   239\t\n   240\tdef _split_total(total: int, parts: int) -> list[int]:\n   241\t    \"\"\"Partition `total` non-negative units into `parts` bins uniformly at random.\"\"\"\n   242\t    if parts == 1:\n   243\t        return [total]\n   244\t    cuts = sorted(random.sample(range(total + parts - 1), parts - 1))\n   245\t    out, prev = [], -1\n   246\t    for cut in cuts + [total + parts - 1]:\n   247\t        out.append(cut - prev - 1)\n   248\t        prev = cut\n   249\t    return out\n   250\t\n   251\t\n   252\tdef _choose_pattern() -> tuple[list[tuple[int, int]], int]:\n   253\t    \"\"\"Return (pattern cells, k_max = deepest inward-diagonal offset).\"\"\"\n   254\t    pattern = list(random.choice(PATTERN_TEMPLATES))\n   255\t    k_max = max(dr for dr, dc in pattern if dr == dc and dr > 0)\n   256\t    return pattern, k_max\n   257\t\n   258\t\n   259\tdef _draw_frame(grid: np.ndarray, r: int, c: int, size: int) -> None:\n   260\t    \"\"\"Draw a size x size hollow frame of 0 with TL at (r, c).\"\"\"\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py /home/lixinyu/snap/new/ARC_code/train/46c35fc7.py /home/lixinyu/snap/new/ARC_code/eval/c7f57c3e.py /home/lixinyu/snap/new/ARC_code/train/ad173014.py; do nl -ba \"$f\" | sed -n '\"'1,260p'; done\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py /home/lixinyu/snap/new/ARC_code/train/46c35fc7.py /home/lixinyu/snap/new/ARC_code/eval/c7f57c3e.py /home/lixinyu/snap/new/ARC_code/train/ad173014.py; do nl -ba \"$f\" | sed -n '\"'1,260p'; done\"","aggregated_output":"     1\timport numpy as np\n     2\t\n     3\tfrom arc_utils import get_bg as _bg_color, neighbors8\n     4\timport random\n     5\tfrom arc_utils import random_free_location, is_contiguous\n     6\t\n     7\t\n     8\tdef _rotate_cells(cells: list[tuple[int, int, int]], k: int) -> list[tuple[int, int, int]]:\n     9\t    pts = [(r, c, col) for r, c, col in cells]\n    10\t    for _ in range(k % 4):\n    11\t        pts = [(c, -r, col) for r, c, col in pts]  # 90° clockwise around origin\n    12\t    min_r = min(r for r, _, _ in pts)\n    13\t    min_c = min(c for _, c, _ in pts)\n    14\t    pts = [(r - min_r, c - min_c, col) for r, c, col in pts]\n    15\t    pts.sort()\n    16\t    return pts\n    17\t\n    18\t\n    19\tdef _variants(cells: list[tuple[int, int, int]]) -> list[list[tuple[int, int, int]]]:\n    20\t    seen: set[tuple[tuple[int, int, int], ...]] = set()\n    21\t    outs: list[list[tuple[int, int, int]]] = []\n    22\t    for k in range(4):\n    23\t        rot = _rotate_cells(cells, k)\n    24\t        key = tuple(rot)\n    25\t        if key not in seen:\n    26\t            seen.add(key)\n    27\t            outs.append(rot)\n    28\t    return outs\n    29\t\n    30\t\n    31\tdef _find_marker_color(g: np.ndarray, bg: int) -> int | None:\n    32\t    colors = [c for c in sorted(set(map(int, g.ravel()))) if c != bg]\n    33\t    counts = {c: int(np.sum(g == c)) for c in colors}\n    34\t    singletons = [c for c in colors if counts[c] == 1]\n    35\t    if singletons:\n    36\t        # Prefer a singleton that is 8-neigh adjacent to some other non-bg pixel.\n    37\t        for c in singletons:\n    38\t            r, col = map(int, np.argwhere(g == c)[0])\n    39\t            for nr, nc in neighbors8(r, col):\n    40\t                if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] != bg:\n    41\t                    return c\n    42\t        assert False, \"no adjacent singleton found — input must have adjacent singleton marker\"\n    43\t\n    44\t\n    45\tdef _extract_pieces(g: np.ndarray) -> tuple[list[dict], int]:\n    46\t    bg = _bg_color(g)\n    47\t    colors = [c for c in sorted(set(map(int, g.ravel()))) if c != bg]\n    48\t    if not colors:\n    49\t        return [], bg\n    50\t\n    51\t    marker_color = _find_marker_color(g, bg)\n    52\t    marker_pos = None\n    53\t    if marker_color is not None and int(np.sum(g == marker_color)) == 1:\n    54\t        marker_pos = tuple(map(int, np.argwhere(g == marker_color)[0]))\n    55\t\n    56\t    # Anchor color is the color 8-neigh adjacent to the marker.\n    57\t    anchor_color = None\n    58\t    if marker_pos is not None:\n    59\t        mr, mc = marker_pos\n    60\t        neigh = set()\n    61\t        for nr, nc in neighbors8(mr, mc):\n    62\t            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1]:\n    63\t                v = int(g[nr, nc])\n    64\t                if v != bg and v != marker_color:\n    65\t                    neigh.add(v)\n    66\t        if len(neigh) == 1:\n    67\t            anchor_color = next(iter(neigh))\n    68\t\n    69\t    pieces: list[dict] = []\n    70\t    used = set()\n    71\t\n    72\t    if anchor_color is not None and marker_pos is not None:\n    73\t        # Anchor is a multi-color piece: anchor_color pixels plus the marker pixel.\n    74\t        coords = []\n    75\t        for r, c in np.argwhere(g == anchor_color):\n    76\t            coords.append((int(r), int(c), int(anchor_color)))\n    77\t        mr, mc = marker_pos\n    78\t        coords.append((mr, mc, int(marker_color)))\n    79\t        # Normalize to local coordinates.\n    80\t        min_r = min(r for r, _, _ in coords)\n    81\t        min_c = min(c for _, c, _ in coords)\n    82\t        coords = [(r - min_r, c - min_c, col) for r, c, col in coords]\n    83\t        pieces.append(\n    84\t            {\n    85\t                \"name\": \"anchor\",\n    86\t                \"cells\": coords,\n    87\t                \"marker_color\": int(marker_color),\n    88\t            }\n    89\t        )\n    90\t        used.add(anchor_color)\n    91\t        used.add(marker_color)\n    92\t\n    93\t    for col in colors:\n    94\t        if col in used:\n    95\t            continue\n    96\t        coords = [(int(r), int(c), int(col)) for r, c in np.argwhere(g == col)]\n    97\t        min_r = min(r for r, _, _ in coords)\n    98\t        min_c = min(c for _, c, _ in coords)\n    99\t        coords = [(r - min_r, c - min_c, col) for r, c, col in coords]\n   100\t        pieces.append({\"name\": f\"c{col}\", \"cells\": coords})\n   101\t\n   102\t    return pieces, bg\n   103\t\n   104\t\n   105\tdef _dims(area: int) -> list[tuple[int, int]]:\n   106\t    pairs = []\n   107\t    for h in range(1, int(area**0.5) + 1):\n   108\t        if area % h == 0:\n   109\t            w = area // h\n   110\t            pairs.append((h, w))\n   111\t            if h != w:\n   112\t                pairs.append((w, h))\n   113\t    # Prefer close-to-square, then smaller height.\n   114\t    pairs.sort(key=lambda t: (abs(t[0] - t[1]), t[0], t[1]))\n   115\t    return pairs\n   116\t\n   117\t\n   118\tdef _placeable(board: np.ndarray, placement: list[tuple[int, int, int]]) -> bool:\n   119\t    for r, c, _ in placement:\n   120\t        if board[r, c] != -1:\n   121\t            return False\n   122\t    return True\n   123\t\n   124\t\n   125\tdef _apply(board: np.ndarray, placement: list[tuple[int, int, int]], val: int | None = None) -> None:\n   126\t    if val is None:\n   127\t        for r, c, col in placement:\n   128\t            board[r, c] = col\n   129\t    else:\n   130\t        for r, c, _ in placement:\n   131\t            board[r, c] = val\n   132\t\n   133\t\n   134\tdef _all_placements_for_variant(\n   135\t    variant: list[tuple[int, int, int]], H: int, W: int\n   136\t) -> list[list[tuple[int, int, int]]]:\n   137\t    max_r = max(r for r, _, _ in variant)\n   138\t    max_c = max(c for _, c, _ in variant)\n   139\t    ph, pw = max_r + 1, max_c + 1\n   140\t    outs: list[list[tuple[int, int, int]]] = []\n   141\t    for tr in range(H - ph + 1):\n   142\t        for tc in range(W - pw + 1):\n   143\t            outs.append([(r + tr, c + tc, col) for r, c, col in variant])\n   144\t    return outs\n   145\t\n   146\t\n   147\tdef _solve_packing(pieces: list[dict], H: int, W: int) -> np.ndarray | None:\n   148\t    board = np.full((H, W), -1, dtype=int)\n   149\t\n   150\t    # Build variants + placements per piece.\n   151\t    piece_vars: list[list[list[tuple[int, int, int]]]] = []\n   152\t    for p in pieces:\n   153\t        piece_vars.append(_variants(p[\"cells\"]))\n   154\t\n   155\t    # Place anchor first if present: marker must end up at (0,0).\n   156\t    remaining = list(range(len(pieces)))\n   157\t    anchor_idx = next((i for i, p in enumerate(pieces) if p[\"name\"] == \"anchor\"), None)\n   158\t    if anchor_idx is not None:\n   159\t        remaining.remove(anchor_idx)\n   160\t        marker_col = pieces[anchor_idx][\"marker_color\"]\n   161\t        anchor_solutions = []\n   162\t        for var in piece_vars[anchor_idx]:\n   163\t            marker_pts = [(r, c) for r, c, col in var if col == marker_col]\n   164\t            if len(marker_pts) != 1:\n   165\t                continue\n   166\t            mr, mc = marker_pts[0]\n   167\t            tr, tc = -mr, -mc\n   168\t            placed = [(r + tr, c + tc, col) for r, c, col in var]\n   169\t            if all(0 <= r < H and 0 <= c < W for r, c, _ in placed):\n   170\t                anchor_solutions.append(placed)\n   171\t        if not anchor_solutions:\n   172\t            return None\n   173\t        # Try each feasible anchor orientation (usually 1).\n   174\t        for anchor_place in anchor_solutions:\n   175\t            if not _placeable(board, anchor_place):\n   176\t                continue\n   177\t            _apply(board, anchor_place)\n   178\t\n   179\t            # Backtracking for remaining pieces.\n   180\t            def backtrack(rem: list[int]) -> bool:\n   181\t                if not rem:\n   182\t                    return True\n   183\t\n   184\t                # Choose piece with fewest fits under current board.\n   185\t                best_pi = None\n   186\t                best_options = None\n   187\t                best_count = None\n   188\t                for pi in rem:\n   189\t                    opts = []\n   190\t                    for var in piece_vars[pi]:\n   191\t                        for placement in _all_placements_for_variant(var, H, W):\n   192\t                            if _placeable(board, placement):\n   193\t                                opts.append(placement)\n   194\t                    cnt = len(opts)\n   195\t                    if cnt == 0:\n   196\t                        return False\n   197\t                    if best_count is None or cnt < best_count:\n   198\t                        best_count = cnt\n   199\t                        best_pi = pi\n   200\t                        best_options = opts\n   201\t                        if best_count == 1:\n   202\t                            break\n   203\t\n   204\t                assert best_pi is not None and best_options is not None\n   205\t                next_rem = [x for x in rem if x != best_pi]\n   206\t                for placement in best_options:\n   207\t                    _apply(board, placement)\n   208\t                    if backtrack(next_rem):\n   209\t                        return True\n   210\t                    _apply(board, placement, -1)\n   211\t                return False\n   212\t\n   213\t            if backtrack(remaining):\n   214\t                return board\n   215\t            _apply(board, anchor_place, -1)\n   216\t        return None\n   217\t\n   218\t    # No anchor: just pack all pieces.\n   219\t    def backtrack(rem: list[int]) -> bool:\n   220\t        if not rem:\n   221\t            return True\n   222\t        best_pi = None\n   223\t        best_options = None\n   224\t        best_count = None\n   225\t        for pi in rem:\n   226\t            opts = []\n   227\t            for var in piece_vars[pi]:\n   228\t                for placement in _all_placements_for_variant(var, H, W):\n   229\t                    if _placeable(board, placement):\n   230\t                        opts.append(placement)\n   231\t            cnt = len(opts)\n   232\t            if cnt == 0:\n   233\t                return False\n   234\t            if best_count is None or cnt < best_count:\n   235\t                best_count = cnt\n   236\t                best_pi = pi\n   237\t                best_options = opts\n   238\t        assert best_pi is not None and best_options is not None\n   239\t        next_rem = [x for x in rem if x != best_pi]\n   240\t        for placement in best_options:\n   241\t            _apply(board, placement)\n   242\t            if backtrack(next_rem):\n   243\t                return True\n   244\t            _apply(board, placement, -1)\n   245\t        return False\n   246\t\n   247\t    if backtrack(remaining):\n   248\t        return board\n   249\t    return None\n   250\t\n   251\t\n   252\tdef main(grid: np.ndarray) -> np.ndarray:\n   253\t    \"\"\"\n   254\t    Assemble colored rectangular sprites into a single tiled rectangle, anchored by a marker pixel.\n   255\t\n   256\t    Input structure:\n   257\t    - bg = most common color. Several solid-colored rectangular sprites scattered on the grid.\n   258\t    - One sprite has a unique single-pixel marker (different color) at one corner — this is the anchor.\n   259\t\n   260\t    Rule:\n     1\timport numpy as np\n     2\t\n     3\tfrom arc_utils import bbox_h, bbox_w, find_components, get_bg, paste\n     4\timport random\n     5\t\n     6\t\n     7\tdef _rotate_ring(out: np.ndarray, g: np.ndarray, r0: int, c0: int) -> None:\n     8\t    patch = g[r0 : r0 + 3, c0 : c0 + 3]\n     9\t\n    10\t    out[r0 + 0, c0 + 0] = patch[0, 2]\n    11\t    out[r0 + 0, c0 + 1] = patch[1, 0]\n    12\t    out[r0 + 0, c0 + 2] = patch[2, 2]\n    13\t    out[r0 + 1, c0 + 0] = patch[2, 1]\n    14\t    out[r0 + 1, c0 + 2] = patch[0, 1]\n    15\t    out[r0 + 2, c0 + 0] = patch[0, 0]\n    16\t    out[r0 + 2, c0 + 1] = patch[1, 2]\n    17\t    out[r0 + 2, c0 + 2] = patch[2, 0]\n    18\t\n    19\t\n    20\tdef main(grid: np.ndarray) -> np.ndarray:\n    21\t    \"\"\"Rotate the colors around every 3x3 foreground ring, with corners and side-centers cycling in opposite directions.\n    22\t\n    23\t    Input structure\n    24\t    - The grid has a dominant background color.\n    25\t    - Each 4-connected foreground object is a complete 3x3 ring: eight foreground pixels around a background center.\n    26\t\n    27\t    Rule\n    28\t    - For each ring, move corner colors one step around the four corners.\n    29\t    - Move side-center colors one step around the four side centers in the opposite direction.\n    30\t    - Leave the background center and all other background pixels unchanged.\n    31\t\n    32\t    Key insight\n    33\t    - Corners and side centers form two separate four-cycles on the same 3x3 ring.\n    34\t    \"\"\"\n    35\t    g = np.asarray(grid, dtype=int)\n    36\t    bg = get_bg(g)\n    37\t    out = g.copy()\n    38\t\n    39\t    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    40\t    assert components\n    41\t\n    42\t    for comp in components:\n    43\t        bbox = comp[\"bbox\"]\n    44\t        r0, c0, r1, c1 = map(int, bbox)\n    45\t        assert bbox_h(bbox) == 3\n    46\t        assert bbox_w(bbox) == 3\n    47\t        assert int(comp[\"area\"]) == 8\n    48\t        assert g[r0 + 1, c0 + 1] == bg\n    49\t\n    50\t        ring_coords = {\n    51\t            (r0 + dr, c0 + dc)\n    52\t            for dr in range(3)\n    53\t            for dc in range(3)\n    54\t            if (dr, dc) != (1, 1)\n    55\t        }\n    56\t        component_coords = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n    57\t        assert component_coords == ring_coords\n    58\t        assert r1 == r0 + 2\n    59\t        assert c1 == c0 + 2\n    60\t\n    61\t        _rotate_ring(out, g, r0, c0)\n    62\t\n    63\t    return out\n    64\t\n    65\t# --------------- generator (att2, o5x) ---------------\n    66\t\n    67\t# Color and canvas bounds.\n    68\tBG_COLOR = 7\n    69\tCOLOR_IDS = tuple(range(10))\n    70\tGRID_SIDE_MIN, GRID_SIDE_MAX = 6, 10\n    71\tMIN_BACKGROUND_PCT = 67\n    72\t\n    73\t# Ring geometry, counts, and placement spacing.\n    74\tRING_SIZE, RING_AREA, RING_GAP = 3, 8, 1\n    75\tRING_COUNT_MIN, RING_COUNT_MAX = 1, 2\n    76\tRING_UNIQUE_MIN, RING_UNIQUE_MAX = 2, RING_AREA\n    77\tRING_CELLS = (\n    78\t    (0, 0),\n    79\t    (0, 1),\n    80\t    (0, 2),\n    81\t    (1, 0),\n    82\t    (1, 2),\n    83\t    (2, 0),\n    84\t    (2, 1),\n    85\t    (2, 2),\n    86\t)\n    87\t\n    88\t# Retry budget for rejection through the solver oracle.\n    89\tGENERATION_RETRIES = 300\n    90\t\n    91\t\n    92\tdef _bbox_at(r: int, c: int) -> tuple[int, int, int, int]:\n    93\t    return r, c, r + RING_SIZE - 1, c + RING_SIZE - 1\n    94\t\n    95\t\n    96\tdef _separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n    97\t    return (\n    98\t        a[2] + RING_GAP < b[0]\n    99\t        or b[2] + RING_GAP < a[0]\n   100\t        or a[3] + RING_GAP < b[1]\n   101\t        or b[3] + RING_GAP < a[1]\n   102\t    )\n   103\t\n   104\t\n   105\tdef _valid_position_sets(rows: int, cols: int, count: int) -> list[tuple[tuple[int, int], ...]]:\n   106\t    positions = [(r, c) for r in range(rows - RING_SIZE + 1) for c in range(cols - RING_SIZE + 1)]\n   107\t    if count == 1:\n   108\t        return [(pos,) for pos in positions]\n   109\t\n   110\t    pairs = []\n   111\t    for i, first in enumerate(positions):\n   112\t        box1 = _bbox_at(*first)\n   113\t        for second in positions[i + 1 :]:\n   114\t            if _separated(box1, _bbox_at(*second)):\n   115\t                pairs.append((first, second))\n   116\t    return pairs\n   117\t\n   118\t\n   119\tdef _compatible_sizes(count: int) -> list[tuple[int, int]]:\n   120\t    sizes = []\n   121\t    for rows in range(GRID_SIDE_MIN, GRID_SIDE_MAX + 1):\n   122\t        for cols in range(GRID_SIDE_MIN, GRID_SIDE_MAX + 1):\n   123\t            area = rows * cols\n   124\t            if (area - RING_AREA * count) * 100 < MIN_BACKGROUND_PCT * area:\n   125\t                continue\n   126\t            if _valid_position_sets(rows, cols, count):\n   127\t                sizes.append((rows, cols))\n   128\t    return sizes\n   129\t\n   130\t\n   131\t_SIZES = {count: _compatible_sizes(count) for count in range(RING_COUNT_MIN, RING_COUNT_MAX + 1)}\n   132\t_POSITION_SETS = {\n   133\t    count: {size: _valid_position_sets(*size, count) for size in _SIZES[count]}\n   134\t    for count in _SIZES\n   135\t}\n   136\t\n   137\t\n   138\tdef _make_ring(bg: int) -> np.ndarray:\n   139\t    ring = np.full((RING_SIZE, RING_SIZE), bg, dtype=int)\n   140\t    palette = [color for color in COLOR_IDS if color != bg]\n   141\t    unique_count = random.randint(RING_UNIQUE_MIN, RING_UNIQUE_MAX)\n   142\t    chosen = random.sample(palette, unique_count)\n   143\t    values = chosen + [random.choice(chosen) for _ in range(RING_AREA - unique_count)]\n   144\t    random.shuffle(values)\n   145\t    for (dr, dc), color in zip(RING_CELLS, values):\n   146\t        ring[dr, dc] = color\n   147\t    return ring\n   148\t\n   149\t\n   150\tdef _rotated_output(grid: np.ndarray, positions: tuple[tuple[int, int], ...]) -> np.ndarray:\n   151\t    out = grid.copy()\n   152\t    for r0, c0 in positions:\n   153\t        _rotate_ring(out, grid, r0, c0)\n   154\t    return out\n   155\t\n   156\t\n   157\tdef _render_grid(rows: int, cols: int, positions: tuple[tuple[int, int], ...], bg: int) -> np.ndarray:\n   158\t    grid = np.full((rows, cols), bg, dtype=int)\n   159\t    for r0, c0 in positions:\n   160\t        paste(grid, _make_ring(bg), r0, c0)\n   161\t    return grid\n   162\t\n   163\t\n   164\tdef _oracle_accepts(grid: np.ndarray, positions: tuple[tuple[int, int], ...]) -> bool:\n   165\t    expected = _rotated_output(grid, positions)\n   166\t    try:\n   167\t        actual = main(grid)\n   168\t    except AssertionError:\n   169\t        return False\n   170\t    return np.array_equal(actual, expected)\n   171\t\n   172\t\n   173\tdef _gen_attempt() -> np.ndarray | None:\n   174\t    bg = BG_COLOR\n   175\t    count = random.randint(RING_COUNT_MIN, RING_COUNT_MAX)\n   176\t    rows, cols = random.choice(_SIZES[count])\n   177\t    positions = random.choice(_POSITION_SETS[count][(rows, cols)])\n   178\t    grid = _render_grid(rows, cols, positions, bg)\n   179\t    return grid if _oracle_accepts(grid, positions) else None\n   180\t\n   181\t\n   182\tdef generate_input() -> np.ndarray:\n   183\t    for _ in range(GENERATION_RETRIES):\n   184\t        grid = _gen_attempt()\n   185\t        if grid is not None:\n   186\t            return grid\n   187\t    raise RuntimeError(\"failed to generate a valid 46c35fc7 input\")\n     1\timport numpy as np\n     2\t\n     3\tfrom arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location\n     4\timport random\n     5\t\n     6\t\n     7\tdef _pick_anchor_bbox(arr: np.ndarray, bg: int) -> tuple[int, int, int, int]:\n     8\t    \"\"\"Pick a stable anchor bbox inside the sprite array (color-1 pixels; always present).\"\"\"\n     9\t    if np.any(arr == 1):\n    10\t        ys, xs = np.where(arr == 1)\n    11\t        return int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())\n    12\t    assert False, \"sprite array has no color-1 pixels and should always have them\"\n    13\t\n    14\t\n    15\tdef _scale_nn(arr: np.ndarray, scale: int) -> np.ndarray:\n    16\t    if scale <= 1:\n    17\t        return arr.copy()\n    18\t    return np.repeat(np.repeat(arr, scale, axis=0), scale, axis=1)\n    19\t\n    20\t\n    21\tdef main(grid: np.ndarray) -> np.ndarray:\n    22\t    \"\"\"\n    23\t    Swap every sprite to the opposite prototype while preserving scale and position.\n    24\t\n    25\t    Input structure:\n    26\t    - bg = most common color. Two distinct small sprite patterns (prototypes) appear at various scales.\n    27\t    - Each sprite instance is a scaled copy of one of the two prototypes, placed on the grid.\n    28\t\n    29\t    Rule:\n    30\t    - Identify the two prototype patterns from the smallest-area sprites.\n    31\t    - For each sprite, determine which prototype it matches and its integer scale factor.\n    32\t    - Replace it with the other prototype at the same scale, aligned by an internal anchor region (color-1 pixels).\n    33\t\n    34\t    Key insight: Every sprite toggles to the alternate prototype; the anchor sub-region inside each sprite pins the alignment so swapped sprites land in the correct position regardless of scale.\n    35\t    \"\"\"\n    36\t    g = np.asarray(grid, dtype=int)\n    37\t    h, w = g.shape\n    38\t    bg = get_bg(g)\n    39\t\n    40\t    comps = components_mask(g != bg, connectivity=8)\n    41\t    assert len(comps) >= 2, \"grid must contain at least 2 sprite components\"\n    42\t\n    43\t    # Extract sprite records.\n    44\t    sprites = []\n    45\t    for pts in comps:\n    46\t        r0, c0, r1, c1 = bbox_coords(pts)\n    47\t        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n    48\t        sprites.append({\"pts\": pts, \"bbox\": (r0, c0, r1, c1), \"arr\": arr})\n    49\t\n    50\t    # Determine two base prototypes from the smallest bbox area sprites.\n    51\t    areas = [int((s[\"bbox\"][2] - s[\"bbox\"][0] + 1) * (s[\"bbox\"][3] - s[\"bbox\"][1] + 1)) for s in sprites]\n    52\t    min_area = min(areas)\n    53\t    base = [s for s, a in zip(sprites, areas, strict=False) if a == min_area]\n    54\t    uniq: dict[tuple[int, ...], np.ndarray] = {}\n    55\t    for s in base:\n    56\t        key = tuple(s[\"arr\"].ravel().tolist())\n    57\t        if key not in uniq:\n    58\t            uniq[key] = s[\"arr\"]\n    59\t    assert len(uniq) == 2, \"smallest-area sprites must yield exactly 2 distinct prototype patterns\"\n    60\t\n    61\t    proto_keys = list(uniq.keys())[:2]\n    62\t    protos = [uniq[proto_keys[0]], uniq[proto_keys[1]]]\n    63\t\n    64\t    anc0 = _pick_anchor_bbox(protos[0], bg)\n    65\t    anc1 = _pick_anchor_bbox(protos[1], bg)\n    66\t    a0r0, a0c0, a0r1, a0c1 = anc0\n    67\t    base_anc_h = a0r1 - a0r0 + 1\n    68\t    base_anc_w = a0c1 - a0c0 + 1\n    69\t\n    70\t    out = g.copy()\n    71\t\n    72\t    for s in sprites:\n    73\t        r0, c0, r1, c1 = s[\"bbox\"]\n    74\t        arr = s[\"arr\"]\n    75\t        anc = _pick_anchor_bbox(arr, bg)\n    76\t        ar0, ac0, ar1, ac1 = anc\n    77\t        inst_anc_h = ar1 - ar0 + 1\n    78\t        inst_anc_w = ac1 - ac0 + 1\n    79\t        # infer integer scale\n    80\t        scale_h = max(1, inst_anc_h // max(1, base_anc_h))\n    81\t        scale_w = max(1, inst_anc_w // max(1, base_anc_w))\n    82\t        scale = int(max(scale_h, scale_w))\n    83\t\n    84\t        # score which prototype matches this sprite when aligned by core bbox\n    85\t        best_idx = 0\n    86\t        best_score = -1\n    87\t        for idx, p in enumerate(protos):\n    88\t            sp = _scale_nn(p, scale)\n    89\t            panc = _pick_anchor_bbox(p, bg)\n    90\t            pr0, pc0, pr1, pc1 = panc\n    91\t            pr0 *= scale\n    92\t            pc0 *= scale\n    93\t            # align anchor top-left to instance anchor top-left (global coords)\n    94\t            top = (r0 + ar0) - pr0\n    95\t            left = (c0 + ac0) - pc0\n    96\t\n    97\t            # overlap score: count matching non-bg pixels where prototype expects non-bg\n    98\t            score = 0\n    99\t            ph, pw = sp.shape\n   100\t            rr0 = max(0, top)\n   101\t            cc0 = max(0, left)\n   102\t            rr1 = min(h, top + ph)\n   103\t            cc1 = min(w, left + pw)\n   104\t            if rr0 >= rr1 or cc0 >= cc1:\n   105\t                continue\n   106\t            sub_g = g[rr0:rr1, cc0:cc1]\n   107\t            sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]\n   108\t            m = sub_p != bg\n   109\t            if np.any(m):\n   110\t                score = int(np.sum(sub_g[m] == sub_p[m]))\n   111\t            if score > best_score:\n   112\t                best_score = score\n   113\t                best_idx = idx\n   114\t\n   115\t        repl_idx = 1 - best_idx\n   116\t\n   117\t        # Clear current sprite pixels.\n   118\t        for rr, cc in s[\"pts\"]:\n   119\t            out[rr, cc] = bg\n   120\t\n   121\t        # Place replacement.\n   122\t        p = protos[repl_idx]\n   123\t        sp = _scale_nn(p, scale)\n   124\t        panc = _pick_anchor_bbox(p, bg)\n   125\t        pr0, pc0, pr1, pc1 = panc\n   126\t        pr0 *= scale\n   127\t        pc0 *= scale\n   128\t        top = (r0 + ar0) - pr0\n   129\t        left = (c0 + ac0) - pc0\n   130\t\n   131\t        ph, pw = sp.shape\n   132\t        rr0 = max(0, top)\n   133\t        cc0 = max(0, left)\n   134\t        rr1 = min(h, top + ph)\n   135\t        cc1 = min(w, left + pw)\n   136\t        sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]\n   137\t        m = sub_p != bg\n   138\t        out_slice = out[rr0:rr1, cc0:cc1]\n   139\t        out_slice[m] = sub_p[m]\n   140\t        out[rr0:rr1, cc0:cc1] = out_slice\n   141\t\n   142\t    return out\n   143\t\n   144\t# --------------- generator (o5x) ---------------\n   145\t\n   146\t# --- CFG: canvas ---\n   147\tGRID_SIZE_MIN = 18                  # square grid lower bound\n   148\tGRID_SIZE_MAX = 28                  # square grid upper bound\n   149\tGRID_MARGIN_FOR_SPRITES = 6         # min_n = max_sprite_dim + this\n   150\t\n   151\t# --- CFG: prototypes ---\n   152\tPROTO_SHAPES = [(4, 3), (3, 4), (4, 4)]  # (h, w) choices for label grid\n   153\tBG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9] # bg color pool (excludes 1)\n   154\tCOLOR_SHARE_PROB = 0.65             # prob that proto_B shares a color with proto_A\n   155\t\n   156\t# --- CFG: row-mask weights (anchor role vs variable role) ---\n   157\t#   each entry: (mask_type, weight)  where mask_type in {\"center\", \"outer\", \"full\"}\n   158\tANCHOR_ROW_WEIGHTS = [(\"center\", 0.45), (\"outer\", 0.35), (\"full\", 0.20)]\n   159\tVARIABLE_ROW_WEIGHTS = [(\"center\", 0.68), (\"full\", 0.32)]\n   160\tOUTER_FIXUP_PROB = 0.7             # when fixing no-edge row, prob of using outer vs full\n   161\t\n   162\t# --- CFG: sprite instances ---\n   163\tSPRITE_COUNTS = [3, 4]             # number of sprite instances per grid\n   164\tBIG_SCALES = [2, 3]                # scale factor for the one large sprite\n   165\t\n   166\t# --- CFG: placement ---\n   167\tPLACEMENT_BORDER = 1               # min distance from grid edge\n   168\tPLACEMENT_PADDING = 2              # min gap between sprite bboxes\n   169\tPLACEMENT_CONNECTIVITY = 8         # connectivity for padding check\n   170\t\n   171\t# --- CFG: generation retries ---\n   172\tMAX_RETRIES = 300\n   173\t\n   174\t# --- Row-mask patterns indexed by width ---\n   175\t_ROW_MASKS = {\n   176\t    \"center\": {3: [0, 1, 0], 4: [0, 1, 1, 0]},\n   177\t    \"outer\":  {3: [1, 0, 1], 4: [1, 0, 0, 1]},\n   178\t    \"full\":   {3: [1, 1, 1], 4: [1, 1, 1, 1]},\n   179\t}\n   180\t\n   181\t\n   182\tdef _row_mask(kind: str, w: int) -> list[int]:\n   183\t    \"\"\"Return a row occupancy mask of the given kind and width.\"\"\"\n   184\t    return list(_ROW_MASKS[kind][w])\n   185\t\n   186\t\n   187\tdef _anchor_bbox(arr: np.ndarray) -> tuple[int, int, int, int]:\n   188\t    \"\"\"Bounding box of color-1 (anchor) pixels: (r0, c0, r1, c1).\"\"\"\n   189\t    rs, cs = np.where(arr == 1)\n   190\t    return int(rs.min()), int(cs.min()), int(rs.max()), int(cs.max())\n   191\t\n   192\t\n   193\tdef _scale(arr: np.ndarray, k: int) -> np.ndarray:\n   194\t    \"\"\"Nearest-neighbor upscale by integer factor k.\"\"\"\n   195\t    if k == 1:\n   196\t        return arr.copy()\n   197\t    return np.repeat(np.repeat(arr, k, axis=0), k, axis=1)\n   198\t\n   199\t\n   200\tdef _make_labels() -> np.ndarray:\n   201\t    \"\"\"Build an (h, w) label grid with roles 1 (anchor), 2, 3 and bg holes (0).\"\"\"\n   202\t    h, w = random.choice(PROTO_SHAPES)\n   203\t\n   204\t    # Assign row counts per role (each role gets at least 1 row)\n   205\t    counts = {1: 1, 2: 1, 3: 1}\n   206\t    if h > 3:\n   207\t        counts[random.choice([1, 2, 3])] += h - 3\n   208\t    roles = []\n   209\t    for role in random.sample([1, 2, 3], 3):\n   210\t        roles.extend([role] * counts[role])\n   211\t\n   212\t    # Pick row masks via weighted sampling\n   213\t    weights_by_role = {\n   214\t        1: ANCHOR_ROW_WEIGHTS,\n   215\t        2: VARIABLE_ROW_WEIGHTS,\n   216\t        3: VARIABLE_ROW_WEIGHTS,\n   217\t    }\n   218\t    masks = []\n   219\t    for role in roles:\n   220\t        entries = weights_by_role[role]\n   221\t        kinds, wts = zip(*entries)\n   222\t        chosen_kind = random.choices(kinds, weights=wts)[0]\n   223\t        masks.append(_row_mask(chosen_kind, w))\n   224\t\n   225\t    # Fix-up: ensure at least one row touches the left/right edge\n   226\t    if not any(mask[0] or mask[-1] for mask in masks):\n   227\t        i = random.randrange(h)\n   228\t        if roles[i] == 1 and random.random() < OUTER_FIXUP_PROB:\n   229\t            masks[i] = _row_mask(\"outer\", w)\n   230\t        else:\n   231\t            masks[i] = _row_mask(\"full\", w)\n   232\t\n   233\t    # Fix-up: ensure at least one row has bg holes\n   234\t    if all(all(mask) for mask in masks):\n   235\t        masks[random.randrange(h)] = _row_mask(\"center\", w)\n   236\t\n   237\t    # Assemble label grid\n   238\t    labels = np.zeros((h, w), dtype=int)\n   239\t    for r, (role, mask) in enumerate(zip(roles, masks)):\n   240\t        for c, bit in enumerate(mask):\n   241\t            if bit:\n   242\t                labels[r, c] = role\n   243\t    return labels\n   244\t\n   245\t\n   246\tdef _make_prototypes(bg: int) -> tuple[np.ndarray, np.ndarray]:\n   247\t    \"\"\"Create proto_A and proto_B (flipud + recolored) from a shared label grid.\"\"\"\n   248\t    labels = _make_labels()\n   249\t    pool = [c for c in range(10) if c not in (bg, 1)]\n   250\t    a_cols = random.sample(pool, 2)\n   251\t    remaining = [c for c in pool if c not in a_cols]\n   252\t    if random.random() < COLOR_SHARE_PROB:\n   253\t        b_cols = [random.choice(a_cols), random.choice(remaining)]\n   254\t        random.shuffle(b_cols)\n   255\t    else:\n   256\t        b_cols = random.sample(remaining, 2)\n   257\t\n   258\t    def _colorize(lab: np.ndarray, cols: list[int]) -> np.ndarray:\n   259\t        proto = np.full(lab.shape, bg, dtype=int)\n   260\t        proto[lab == 1] = 1\n     1\timport math\n     2\t\n     3\timport numpy as np\n     4\t\n     5\tfrom arc_utils import bbox_coords, components_mask, get_bg, is_contiguous\n     6\timport random\n     7\t\n     8\t\n     9\tRED = 2\n    10\tBLUE = 1\n    11\t\n    12\t\n    13\tdef _extract_frames(g: np.ndarray, bg: int) -> tuple[list[dict], list[np.ndarray]]:\n    14\t    red_components = components_mask(g == RED, connectivity=4)\n    15\t    assert len(red_components) >= 3\n    16\t\n    17\t    frames = []\n    18\t    for coords in red_components:\n    19\t        r0, c0, r1, c1 = bbox_coords(coords)\n    20\t        h = r1 - r0 + 1\n    21\t        w = c1 - c0 + 1\n    22\t        assert h == w and h >= 3\n    23\t\n    24\t        patch = g[r0 : r1 + 1, c0 : c1 + 1]\n    25\t        border = np.zeros((h, w), dtype=bool)\n    26\t        border[0, :] = True\n    27\t        border[-1, :] = True\n    28\t        border[:, 0] = True\n    29\t        border[:, -1] = True\n    30\t\n    31\t        assert int(border.sum()) == int(coords.shape[0])\n    32\t        assert np.all(patch[border] == RED)\n    33\t        assert np.all(patch[~border] != RED)\n    34\t\n    35\t        interior = patch[1:-1, 1:-1]\n    36\t        interior_colors = set(map(int, np.unique(interior))) - {int(bg)}\n    37\t        assert len(interior_colors) == 1\n    38\t        color = interior_colors.pop()\n    39\t        mask = interior == color\n    40\t        assert mask.any()\n    41\t\n    42\t        frames.append(\n    43\t            {\n    44\t                \"bbox\": (r0, c0, r1, c1),\n    45\t                \"center\": ((r0 + r1) / 2, (c0 + c1) / 2),\n    46\t                \"color\": color,\n    47\t                \"mask\": mask,\n    48\t            }\n    49\t        )\n    50\t\n    51\t    return frames, red_components\n    52\t\n    53\t\n    54\tdef _blue_cycle_edges(g: np.ndarray, red_components: list[np.ndarray]) -> set[tuple[int, int]]:\n    55\t    red_id = {}\n    56\t    for i, coords in enumerate(red_components):\n    57\t        for r, c in coords:\n    58\t            red_id[(int(r), int(c))] = i\n    59\t\n    60\t    edges = set()\n    61\t    for coords in components_mask(g == BLUE, connectivity=4):\n    62\t        touched = set()\n    63\t        for r, c in coords:\n    64\t            rr = int(r)\n    65\t            cc = int(c)\n    66\t            for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):\n    67\t                frame_id = red_id.get((nr, nc))\n    68\t                if frame_id is not None:\n    69\t                    touched.add(frame_id)\n    70\t        assert len(touched) == 2\n    71\t        a, b = touched\n    72\t        edges.add(tuple(sorted((a, b))))\n    73\t\n    74\t    n = len(red_components)\n    75\t    assert len(edges) == n\n    76\t    for i in range(n):\n    77\t        assert sum(i in edge for edge in edges) == 2\n    78\t    return edges\n    79\t\n    80\t\n    81\tdef _clockwise_order(frames: list[dict], edges: set[tuple[int, int]]) -> list[int]:\n    82\t    mean_r = sum(frame[\"center\"][0] for frame in frames) / len(frames)\n    83\t    mean_c = sum(frame[\"center\"][1] for frame in frames) / len(frames)\n    84\t    angles = [\n    85\t        math.atan2(frame[\"center\"][0] - mean_r, frame[\"center\"][1] - mean_c)\n    86\t        for frame in frames\n    87\t    ]\n    88\t    assert len({round(angle, 12) for angle in angles}) == len(angles)\n    89\t\n    90\t    order = sorted(range(len(frames)), key=lambda i: angles[i])\n    91\t    for a, b in zip(order, order[1:] + order[:1]):\n    92\t        assert tuple(sorted((a, b))) in edges\n    93\t    return order\n    94\t\n    95\t\n    96\tdef main(grid: np.ndarray) -> np.ndarray:\n    97\t    \"\"\"Recolor each framed interior mask with the color from the next red frame clockwise around the blue connector cycle.\n    98\t\n    99\t    Input structure\n   100\t    - The grid contains hollow red square frames connected pairwise by blue line components.\n   101\t    - The blue components connect the frames into one cycle, with every frame touching exactly two blue components.\n   102\t    - Each frame interior contains background plus exactly one non-background color mask.\n   103\t\n   104\t    Rule\n   105\t    - Sort the red frames clockwise by their centers around the cycle.\n   106\t    - Keep each frame's interior mask shape in place, but recolor it with the interior color from the next clockwise frame.\n   107\t    - Leave the red frames, blue connectors, background, and interior background holes unchanged.\n   108\t\n   109\t    Key insight\n   110\t    - The colored masks do not move; the blue cycle gives the order in which their colors rotate.\n   111\t    \"\"\"\n   112\t    g = np.asarray(grid, dtype=int)\n   113\t    bg = get_bg(g)\n   114\t    frames, red_components = _extract_frames(g, bg)\n   115\t    edges = _blue_cycle_edges(g, red_components)\n   116\t    order = _clockwise_order(frames, edges)\n   117\t\n   118\t    out = g.copy()\n   119\t    for k, frame_id in enumerate(order):\n   120\t        next_id = order[(k + 1) % len(order)]\n   121\t        r0, c0, r1, c1 = frames[frame_id][\"bbox\"]\n   122\t        interior = out[r0 + 1 : r1, c0 + 1 : c1]\n   123\t        interior[frames[frame_id][\"mask\"]] = frames[next_id][\"color\"]\n   124\t    return out\n   125\t\n   126\t# --------------- generator (att1) ---------------\n   127\t\n   128\t# Palette constants.\n   129\tBG = 0\n   130\tCONNECTOR_BLUE = 1\n   131\tFRAME_RED = 2\n   132\tINTERIOR_COLORS = [3, 4, 5, 6, 7, 8, 9]\n   133\t\n   134\t# Canvas and frame bounds.\n   135\tFRAME_COUNT_RANGE = (3, 5)\n   136\tFRAME_SIZE_CHOICES = [5, 7]\n   137\tSMALL_FRAME_GRID_H_RANGE = (20, 27)\n   138\tSMALL_FRAME_GRID_W_RANGE = (21, 27)\n   139\tLARGE_FRAME_GRID_H_RANGE = (22, 27)\n   140\tLARGE_FRAME_GRID_W_RANGE = (23, 27)\n   141\tFRAME_GAP = 1\n   142\t\n   143\t# Interior mask density.\n   144\tMIN_INTERIOR_FILL = 0.30\n   145\tMAX_INTERIOR_FILL = 0.56\n   146\tMIN_INTERIOR_CELLS = 3\n   147\t\n   148\t# Angular placement.\n   149\tANGLE_PERTURB_RANGE = (-0.3, 0.3)\n   150\tMIN_RADIUS_PAD = 1\n   151\tMAX_RADIUS_PAD = 1\n   152\tANGLE_EPS = 1e-6\n   153\t\n   154\t# Connector constraints and retry budgets.\n   155\tMAX_TWO_TURN_TRIES = 20\n   156\tCONNECTOR_LENGTH_RANGE = (2, 24)\n   157\tGENERATION_ATTEMPTS = 300\n   158\t\n   159\tNEIGHBORS_8 = [\n   160\t    (dr, dc)\n   161\t    for dr in range(-1, 2)\n   162\t    for dc in range(-1, 2)\n   163\t    if not (dr == 0 and dc == 0)\n   164\t]\n   165\t\n   166\t\n   167\tdef _gen_mask(interior_size, color):\n   168\t    \"\"\"Generate an 8-connected mask for frame interior with fill 30-56%.\"\"\"\n   169\t    n = interior_size\n   170\t    total = n * n\n   171\t    min_fill = max(MIN_INTERIOR_CELLS, int(math.ceil(MIN_INTERIOR_FILL * total)))\n   172\t    max_fill = int(math.floor(MAX_INTERIOR_FILL * total))\n   173\t    target = random.randint(min_fill, max_fill)\n   174\t\n   175\t    mask = np.zeros((n, n), dtype=int)\n   176\t    start = (n // 2, n // 2)\n   177\t    mask[start] = color\n   178\t    filled = [start]\n   179\t    frontier = set()\n   180\t    _add_mask_frontier(frontier, mask, start)\n   181\t\n   182\t    while len(filled) < target and frontier:\n   183\t        cell = random.choice(list(frontier))\n   184\t        frontier.discard(cell)\n   185\t        mask[cell] = color\n   186\t        filled.append(cell)\n   187\t        _add_mask_frontier(frontier, mask, cell)\n   188\t\n   189\t    if len(filled) < min_fill:\n   190\t        return None\n   191\t    return mask\n   192\t\n   193\t\n   194\tdef _add_mask_frontier(frontier, mask, cell):\n   195\t    n = mask.shape[0]\n   196\t    for dr, dc in NEIGHBORS_8:\n   197\t        nr, nc = cell[0] + dr, cell[1] + dc\n   198\t        if 0 <= nr < n and 0 <= nc < n and mask[nr, nc] == 0:\n   199\t            frontier.add((nr, nc))\n   200\t\n   201\t\n   202\tdef _axis_path(start, end):\n   203\t    \"\"\"Return an inclusive straight segment between row- or column-aligned cells.\"\"\"\n   204\t    sr, sc = start\n   205\t    er, ec = end\n   206\t    if sr == er:\n   207\t        step = 1 if ec > sc else -1\n   208\t        return [(sr, c) for c in range(sc, ec + step, step)]\n   209\t    step = 1 if er > sr else -1\n   210\t    return [(r, sc) for r in range(sr, er + step, step)]\n   211\t\n   212\t\n   213\tdef _one_turn_path(start, corner, end):\n   214\t    return _axis_path(start, corner) + _axis_path(corner, end)[1:]\n   215\t\n   216\t\n   217\tdef _two_turn_vhv_path(start, mid_r, end):\n   218\t    _, sc = start\n   219\t    _, ec = end\n   220\t    corner1 = (mid_r, sc)\n   221\t    corner2 = (mid_r, ec)\n   222\t    return (\n   223\t        _axis_path(start, corner1)\n   224\t        + _axis_path(corner1, corner2)[1:]\n   225\t        + _axis_path(corner2, end)[1:]\n   226\t    )\n   227\t\n   228\t\n   229\tdef _two_turn_hvh_path(start, mid_c, end):\n   230\t    sr, _ = start\n   231\t    er, _ = end\n   232\t    corner1 = (sr, mid_c)\n   233\t    corner2 = (er, mid_c)\n   234\t    return (\n   235\t        _axis_path(start, corner1)\n   236\t        + _axis_path(corner1, corner2)[1:]\n   237\t        + _axis_path(corner2, end)[1:]\n   238\t    )\n   239\t\n   240\t\n   241\tdef _path_is_free(path, occupied):\n   242\t    return all(p not in occupied for p in path)\n   243\t\n   244\t\n   245\tdef _find_path(start, end, occupied):\n   246\t    \"\"\"Find an L-shaped path (0-2 turns) from start to end avoiding occupied cells.\"\"\"\n   247\t    sr, sc = start\n   248\t    er, ec = end\n   249\t\n   250\t    if sr == er or sc == ec:\n   251\t        path = _axis_path(start, end)\n   252\t        if _path_is_free(path, occupied):\n   253\t            return path\n   254\t\n   255\t    corners = [(sr, ec), (er, sc)]\n   256\t    random.shuffle(corners)\n   257\t    for corner in corners:\n   258\t        path = _one_turn_path(start, corner, end)\n   259\t        if _path_is_free(path, occupied):\n   260\t            return path\n","exit_code":0,"status":"completed"}}
