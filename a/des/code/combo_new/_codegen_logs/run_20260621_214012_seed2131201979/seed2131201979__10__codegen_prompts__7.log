(spec: 4-8 total, 2-6 normal, 0-2 colored)\n 322: MARKER_MIN = 4\n 323: MARKER_MAX = 8\n 324: NORMAL_MAX = 6\n 325: COLORED_MAX = 2\n 326: \n 327: # Color pool (all ARC colors except 1, which is reserved for T-marker cells)\n 328: COLOR_POOL = [c for c in range(10) if c != 1]\n 329: \n 330: # L9 rotation marker\n 331: L9_PROBABILITY = 0.5                        # chance of placing a rotation marker\n 332: L9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation\n 333:     'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],\n 334:     'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],\n 335: }\n 336: \n 337: # Generation retry budget\n 338: SEED_ATTEMPTS = 200                         # tries to place n distinct region seeds\n 339: GEN_RETRIES = 300                           # outer generate_input retry budget\n 340: \n 341: _DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n 342: \n 343: \n 344: # ── Small geometry helpers ─────────────────────────────────────────────\n 345: \n 346: def _get_bar(stem):\n 347:     \"\"\"Return the two bar directions perpendicular to *stem*.\"\"\"\n 348:     if stem[0] == 0:\n 349:         return [(-1, 0), (1, 0)]\n 350:     return [(0, -1), (0, 1)]\n 351: \n 352: \n 353: def _t_cells(center, stem):\n 354:     \"\"\"Return the 4 cells of a T marker: center + stem tip + 2 bar cells.\"\"\"\n 355:     r, c = center\n 356:     bar = _get_bar(stem)\n 357:     return {(r, c), (r + stem[0], c + stem[1]),\n 358:             (r + bar[0][0], c + bar[0][1]), (r + bar[1][0], c + bar[1][1])}\n 359: \n 360: \n 361: def _t_branch_cells(center, stem):\n 362:     \"\"\"Return the 3 branch cells (stem tip + 2 bar), excluding the center.\"\"\"\n 363:     r, c = center\n 364:     bar = _get_bar(stem)\n 365:     return {(r + stem[0], c + stem[1]),\n 366:             (r + bar[0][0], c + bar[0][1]),\n 367:             (r + bar[1][0], c + bar[1][1])}\n 368: \n 369: \n 370: def _t_neighborhood(center, stem):\n 371:     \"\"\"Return cells adjacent to any T cell but not part of the T itself.\"\"\"\n 372:     cells = _t_cells(center, stem)\n 373:     neighborhood = set()\n 374:     for r, c in cells:\n 375:         for dr, dc in _DIRS:\n 376:             nb = (r + dr, c + dc)\n 377:             if nb not in cells:\n 378:                 neighborhood.add(nb)\n 379:     return neighborhood\n 380: \n 381: \n 382: # ── Region partitioning ────────────────────────────────────────────────\n 383: \n 384: def _grow_regions(H: int, W: int, n_regions: int) -> np.ndarray | None:\n 385:     \"\"\"Grow n_regions from random seeds via randomized BFS; returns region-id array or None.\"\"\"\n 386:     region = np.full((H, W), -1, dtype=int)\n 387:     seeds = set()\n 388:     for _ in range(SEED_ATTEMPTS):\n 389:         if len(seeds) >= n_regions:\n 390:             break\n 391:         seeds.add((random.randint(1, H - 2), random.randint(1, W - 2)))\n 392:     if len(seeds) < n_regions:\n 393:         return None\n 394: \n 395:     frontier = []\n 396:     for i, (r, c) in enumerate(list(seeds)):\n 397:         region[r, c] = i\n 398:         for dr, dc in _DIRS:\n 399:             nr, nc = r + dr, c + dc\n 400:             if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:\n 401:                 frontier.append((nr, nc, i))\n 402:     random.shuffle(frontier)\n 403: \n 404:     while frontier:\n 405:         idx = random.randint(0, len(frontier) - 1)\n 406:         r, c, rid = frontier[idx]\n 407:         frontier[idx] = frontier[-1]\n 408:         frontier.pop()\n 409:         if region[r, c] != -1:\n 410:             continue\n 411:         region[r, c] = rid\n 412:         for dr, dc in _DIRS:\n 413:             nr, nc = r + dr, c + dc\n 414:             if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:\n 415:                 frontier.append((nr, nc, rid))\n 416: \n 417:     # Validate: each region must be 4-connected and have enough cells\n 418:     for rid in range(n_regions):\n 419