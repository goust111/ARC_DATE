{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/bc93ec48.py',\n'/home/lixinyu/snap/new/ARC_code/train/465b7d93.py',\n'/home/lixinyu/snap/new/ARC_code/eval/a251c730.py',\n'/home/lixinyu/snap/new/ARC_code/train/15660dd6.py',\n]\nfor path in files:\n    print(f'===== {path} =====')\n    text = Path(path).read_text()\n    for name in ['main', 'generate_input']:\n        marker = f'def {name}('\n        start = text.index(marker)\n        end = text.find('\\\\ndef ', start + 1)\n        if end == -1:\n            end = len(text)\n        print(text[start:end].rstrip())\n        print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/train/bc93ec48.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Copy each foreground object anchored in a true grid corner clockwise into the next corner.\n\n    Input structure\n    - The dominant color is the background.\n    - Foreground objects are monochromatic 4-connected components.\n    - Relevant objects are exactly those whose bounding box touches two adjacent borders at one grid corner.\n\n    Rule\n    - Start from the input unchanged.\n    - For each corner object, copy its pixel mask and color to the next corner clockwise: top-left to top-right, top-right to bottom-right, bottom-right to bottom-left, and bottom-left to top-left.\n    - Preserve each object's orientation by aligning its bounding box to the destination corner; stamps may overwrite existing pixels at the destination, but source pixels are not cleared.\n\n    Key insight\n    - Interior and side-only objects are distractors; only components actually anchored to a corner participate in the clockwise perimeter copy.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n    bg = get_bg(g)\n\n    by_corner: dict[Corner, dict] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        corner = _bbox_corner(comp[\"bbox\"], height, width)\n        if corner is None:\n            continue\n        assert corner not in by_corner, \"expected at most one source object per corner\"\n        by_corner[corner] = comp\n\n    assert by_corner, \"expected at least one corner-anchored object\"\n\n    out = g.copy()\n    planned: dict[tuple[int, int], int] = {}\n    for src_corner, comp in by_corner.items():\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        obj_h = int(r1 - r0 + 1)\n        obj_w = int(c1 - c0 + 1)\n        dst_corner = _NEXT_CORNER[src_corner]\n        dst_r0, dst_c0 = _corner_anchor(dst_corner, height, width, obj_h, obj_w)\n        color = int(comp[\"color\"])\n\n        for r_raw, c_raw in comp[\"coords\"]:\n            r = int(dst_r0 + int(r_raw) - r0)\n            c = int(dst_c0 + int(c_raw) - c0)\n            assert 0 <= r < height and 0 <= c < width, \"corner stamp must remain in bounds\"\n            assert (r, c) not in planned, \"expected non-overlapping corner stamps\"\n            planned[(r, c)] = color\n\n    for (r, c), color in planned.items():\n        out[r, c] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_BG = 7\n_GEN_MIN_SIZE, _GEN_MAX_SIZE = 8, 16\n_GEN_CORNERS = (\"TL\", \"TR\", \"BR\", \"BL\")\n_GEN_NEXT = {\"TL\": \"TR\", \"TR\": \"BR\", \"BR\": \"BL\", \"BL\": \"TL\"}\n_GEN_COLORS = (1, 2, 3, 4, 5, 6, 8, 9)\n\n_GEN_CORNER_COUNT_MIN, _GEN_CORNER_COUNT_MAX = 3, 4\n_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX = 1, 4\n_GEN_CORNER_MIN_PIXELS, _GEN_CORNER_MAX_PIXELS = 2, 12\n_GEN_CORNER_MIN_DENSITY = 0.62\n_GEN_SMALL_FULL_AREA_MAX, _GEN_SMALL_FULL_PROB = 12, 0.45\n_GEN_CORNER_DIMS = tuple(\n    (h, w)\n    for h in range(_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX + 1)\n    for w in range(_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX + 1)\n    if not (h == 1 and w == 1)\n)\n\n_GEN_BLOB_PIXELS_MIN, _GEN_BLOB_PIXELS_MAX = 1, 5\n_GEN_BLOB_H_MIN, _GEN_BLOB_H_MAX = 1, 5\n_GEN_BLOB_W_MIN, _GEN_BLOB_W_MAX = 1, 4\n_GEN_DISTRACTOR_BASE_COUNT = 4\n_GEN_DISTRACTOR_SIZE_SPAN = 8\n_GEN_DISTRACTOR_EXTRA_MAX, _GEN_DISTRACTOR_MIN_GAP = 10, 6\n\n_GEN_RETRY_LIMIT = 300\n_GEN_NEIGHBORS_4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid bc93ec48 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/465b7d93.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.\n\n    Input structure:\n    - The background is the dominant color.\n    - There are exactly two foreground colors: one forms a complete rectangular\n      one-pixel-thick frame, and the other forms one 4-connected sprite outside it.\n    - The frame interior is initially background.\n\n    Rule:\n    - Clear the original sprite from its outside location.\n    - Map the sprite bbox to the frame interior bbox, sending bbox extremes to\n      interior extremes.\n    - Draw straight horizontal or vertical segments between mapped positions of\n      adjacent sprite pixels, then fill any enclosed background region inside\n      those drawn segments.\n\n    Key insight:\n    The outside sprite is a miniature line/fill diagram for the frame interior,\n    not a bitmap to scale by block replication.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected one frame color and one sprite color\"\n\n    frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []\n    for color in colors:\n        frame_bbox = _rect_frame_bbox(g == int(color))\n        if frame_bbox is not None:\n            frame_candidates.append((int(color), frame_bbox))\n    assert len(frame_candidates) == 1, \"expected a unique rectangular frame\"\n\n    frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]\n    sprite_color = next(color for color in colors if color != frame_color)\n    sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)\n    assert len(sprite_components) == 1, \"expected a single 4-connected sprite\"\n    frame_region = np.zeros_like(g, dtype=bool)\n    frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True\n    assert not np.any((g == sprite_color) & frame_region), \"sprite must start outside the frame\"\n\n    sr0, sc0, sr1, sc1 = sprite_components[0][\"bbox\"]\n    sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color\n\n    ir0, ic0 = fr0 + 1, fc0 + 1\n    ir1, ic1 = fr1 - 1, fc1 - 1\n    assert ir0 <= ir1 and ic0 <= ic1, \"frame must have an interior\"\n    interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]\n    assert np.all(interior == bg), \"frame interior must start empty\"\n\n    stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))\n    out = g.copy()\n    out[g == sprite_color] = bg\n    out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and observed fixed colors.\n_GRID_SHAPE = (10, 10)\n_COLOR_COUNT = 10\n_BG = 7\n_FRAME_COLOR = 6\n\n# Frame size bounds and retry budget.\n_FRAME_SIZE_MIN = 3\n_FRAME_SIZE_MAX = 8\n_SINGLE_PIXEL_FRAME_SIZE = 3\n_MAX_GENERATION_ATTEMPTS = 300\n\n# Sprite color pool and source masks.\n_SPRITE_COLORS = tuple(c for c in range(_COLOR_COUNT) if c not in {_BG, _FRAME_COLOR})\n_SPRITE_SINGLE = np.ones((1, 1), dtype=bool)\n_SPRITE_PATTERNS_2X2 = [\n    np.array([[1, 1], [1, 0]], dtype=bool),\n    np.array([[1, 1], [0, 1]], dtype=bool),\n    np.array([[1, 0], [1, 1]], dtype=bool),\n    np.array([[0, 1], [1, 1]], dtype=bool),\n    np.array([[1, 1], [1, 1]], dtype=bool),\n]\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 465b7d93 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/a251c730.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp source sprites into a destination frame via color-matched singleton markers.\n\n    Input structure:\n    - Two bordered rectangles: source (multi-cell sprites) and destination (singleton markers).\n    - Each sprite has an anchor pixel — its least-frequent color. Markers share these colors.\n\n    Rule:\n    - Match each destination marker to the source sprite with the same anchor color.\n    - Translate the sprite so its anchor overlaps the marker position.\n    - Output is the destination rectangle, interior cleared before stamping.\n\n    Key insight: The rarest color per sprite doubles as a template key and positioning anchor.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # --- find all uniform-border rectangles (brute force, small grid) ---\n    def interior_bg(rect: tuple[int, int, int, int]) -> int:\n        r0, c0, r1, c1 = map(int, rect)\n        inner = g[int(r0) + 1 : int(r1), int(c0) + 1 : int(c1)]\n        return int(Counter(map(int, inner.flatten())).most_common(1)[0][0])\n\n    def rect_components(rect: tuple[int, int, int, int]) -> tuple[int, list[dict]]:\n        r0, c0, r1, c1 = map(int, rect)\n        inner = g[int(r0) + 1 : int(r1), int(c0) + 1 : int(c1)]\n        ibg = int(Counter(map(int, inner.flatten())).most_common(1)[0][0])\n        comps = []\n\n        for coords in components_mask(inner != int(ibg), connectivity=4):\n            if coords.size == 0:\n                continue\n            rr0, cc0, rr1, cc1 = bbox_coords(coords)\n            mask = np.zeros((int(rr1 - rr0 + 1), int(cc1 - cc0 + 1)), dtype=bool)\n            mask[coords[:, 0] - int(rr0), coords[:, 1] - int(cc0)] = True\n            patch = inner[int(rr0) : int(rr1) + 1, int(cc0) : int(cc1) + 1].copy()\n            patch[~mask] = 0\n\n            vals = [int(inner[int(r), int(c)]) for r, c in coords]\n            cols = Counter(vals)\n            comps.append(\n                {\n                    \"size\": int(coords.shape[0]),\n                    \"colors\": dict(cols),\n                    \"bbox\": (int(rr0), int(cc0), int(rr1), int(cc1)),\n                    \"mask\": mask,\n                    \"patch\": patch,\n                }\n            )\n\n        comps.sort(key=lambda d: -int(d[\"size\"]))\n        return int(ibg), comps\n\n    rects: list[tuple[int, tuple[int, int, int, int], int, int]] = []\n    min_h = 6\n    min_w = 6\n    for r0 in range(int(H)):\n        for c0 in range(int(W)):\n            bc = int(g[int(r0), int(c0)])\n            for r1 in range(int(r0 + min_h - 1), int(H)):\n                for c1 in range(int(c0 + min_w - 1), int(W)):\n                    # corners\n                    if int(g[int(r0), int(c1)]) != int(bc) or int(g[int(r1), int(c0)]) != int(bc) or int(\n                        g[int(r1), int(c1)]\n                    ) != int(bc):\n                        continue\n                    # border uniformity\n                    if not bool((g[int(r0), int(c0) : int(c1) + 1] == int(bc)).all()):\n                        continue\n                    if not bool((g[int(r1), int(c0) : int(c1) + 1] == int(bc)).all()):\n                        continue\n                    if not bool((g[int(r0) : int(r1) + 1, int(c0)] == int(bc)).all()):\n                        continue\n                    if not bool((g[int(r0) : int(r1) + 1, int(c1)] == int(bc)).all()):\n                        continue\n                    # interior bg must differ from border\n                    ibg = interior_bg((int(r0), int(c0), int(r1), int(c1)))\n                    if int(ibg) == int(bc):\n                        continue\n                    area = int((int(r1) - int(r0) + 1) * (int(c1) - int(c0) + 1))\n                    rects.append((int(area), (int(r0), int(c0), int(r1), int(c1)), int(bc), int(ibg)))\n\n    assert not (not rects)\n\n    rects.sort(reverse=True, key=lambda x: int(x[0]))\n    rects = rects[:6]\n\n    src = None\n    dst = None\n    for _area, rect, bc, _ibg in rects:\n        ibg2, comps = rect_components(rect)\n        max_sz = max([int(c[\"size\"]) for c in comps], default=0)\n        if max_sz > 1 and src is None:\n            src = (rect, bc, ibg2, comps)\n        if max_sz == 1 and len(comps) > 0 and dst is None:\n            dst = (rect, bc, ibg2, comps)\n\n    assert src is not None and dst is not None, 'must find both source (multi-cell) and destination (singleton) rectangles'\n\n    (sr, sc, sr1, sc1), _src_bc, src_bg, src_comps = src\n    (dr, dc, dr1, dc1), dst_bc, dst_bg, _dst_comps = dst\n\n    # --- build templates keyed by anchor color ---\n    templates: dict[int, tuple[np.ndarray, np.ndarray, tuple[int, int]]] = {}\n    for comp in src_comps:\n        cols = {k: int(v) for k, v in comp[\"colors\"].items() if int(k) != 0}\n        if not cols:\n            continue\n        anchor_col = int(min(cols.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n        patch = comp[\"patch\"]\n        mask = comp[\"mask\"]\n        anchors = np.argwhere((patch == int(anchor_col)) & mask)\n        if anchors.size == 0:\n            continue\n        ar, ac = map(int, anchors[0])\n        if int(anchor_col) not in templates or int(mask.sum()) > int(templates[int(anchor_col)][1].sum()):\n            templates[int(anchor_col)] = (patch.copy(), mask.copy(), (int(ar), int(ac)))\n\n    # --- create destination canvas and stamp ---\n    out_h = int(dr1 - dr + 1)\n    out_w = int(dc1 - dc + 1)\n    out = np.full((out_h, out_w), int(dst_bg), dtype=int)\n    out[0, :] = int(dst_bc)\n    out[-1, :] = int(dst_bc)\n    out[:, 0] = int(dst_bc)\n    out[:, -1] = int(dst_bc)\n\n    # Destination markers are singleton pixels (color != dst_bg) in the interior.\n    inner = g[int(dr) + 1 : int(dr1), int(dc) + 1 : int(dc1)]\n    for rr, cc in np.argwhere(inner != int(dst_bg)):\n        mr = int(dr + 1 + int(rr))\n        mc = int(dc + 1 + int(cc))\n        mcol = int(g[mr, mc])\n        if int(mcol) not in templates:\n            continue\n        patch, mask, (ar, ac) = templates[int(mcol)]\n        top = int((mr - dr) - int(ar))\n        left = int((mc - dc) - int(ac))\n        paste(out, patch, int(top), int(left), mask=mask, overwrite=True, clip=True)\n\n    return out\n\n# --------------- generator (O2) ---------------\n\n# === CFG: Canvas & layout ===\nGRID_SIZE = 30                     # fixed 30x30 canvas\nWALLPAPER_COLORS = (4, 5)         # number of wallpaper stripe colors (chosen per n_types)\nTOTAL_COLORS_TARGET = (7, 8, 9)   # total distinct color count targets\nGAP_RANGE = (1, 4)                # gap between rectangles during dimension selection\n\n# === CFG: Rectangle size bounds ===\nSRC_H_RANGE = (9, 19)             # source rect height (outer, inclusive)\nSRC_W_RANGE = (8, 18)             # source rect width (outer, inclusive)\nDST_H_RANGE = (9, 19)             # dest rect height (outer, inclusive)\nDST_W_RANGE = (8, 20)             # dest rect width (outer, inclusive)\nDST_W_SIDE_MAX = 20               # dest width cap for side-by-side layout\n\n# === CFG: Sprite & placement ===\nSPRITE_TYPE_CHOICES = (1, 2)      # number of distinct sprite types\nMARKER_COUNT_RANGE = (2, 3)       # markers in dest rect\nSOURCE_SPRITE_RANGE = (2, 4)      # total sprites in source rect\nMARKER_PLACE_RETRIES = 25         # retries per marker for non-overlapping placement\nSOURCE_SPRITE_PADDING = 1         # min gap between source sprites and edges\n\n# === CFG: Generation retries ===\nMAX_GEN_ATTEMPTS = 300            # outer retry limit\n\nSPRITE_SHAPES = [\n    ((\"AB.\", \"BBB\"), (0, 0)),\n    ((\"ABB\", \"BBB\"), (0, 0)),\n    ((\".A.\", \"BBB\", \".B.\"), (0, 1)),\n    ((\"AB.\", \"BBB\", \".BB\"), (0, 0)),\n    ((\"ABB\", \"BBB\", \"..B\"), (0, 0)),\n    ((\".AB\", \"BBB\", \"BB.\"), (0, 1)),\n    ((\"B.B\", \"BBB\", \".A.\"), (2, 1)),\n    ((\".B.\", \"BAB\", \".B.\"), (1, 1)),\n    ((\"BBB\", \"BAB\"), (1, 1)),\n    ((\"AB.\", \"BBB\", \".B.\"), (0, 0)),\n    ((\"BAB\", \"BBB\"), (0, 1)),\n]\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a251c730 input after %d attempts\" % MAX_GEN_ATTEMPTS)\n\n===== /home/lixinyu/snap/new/ARC_code/train/15660dd6.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Combine each column's repeated template mask with its single solid color swatch.\n\n    Input structure:\n    - The grid is a table of framed panels separated by background rows/columns.\n    - The leftmost column gives one solid row-label color for each panel row.\n    - In each panel column, exactly one panel has a solid non-background interior,\n      while the other panels share the same mask drawn in one template color on\n      the background.\n\n    Rule:\n    - For every panel column, find the row containing the solid interior swatch.\n    - Rebuild one output panel using that row's left label as the frame color.\n    - Fill the repeated template mask with the swatch color and leave the mask\n      background cells as background; separate rebuilt panels with one\n      background column.\n\n    Key insight:\n    The table encodes a colorized stencil per column: the solid panel supplies\n    the paint color and frame label, while the duplicate template panels supply\n    the shape mask.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    h, w = g.shape\n\n    sep_rows = [r for r in range(h) if np.all(g[r, :] == bg)]\n    sep_cols = [c for c in range(w) if np.all(g[:, c] == bg)]\n    row_ranges = _panel_ranges(sep_rows, h)\n    col_ranges = _column_ranges(sep_cols, w)\n\n    panel_heights = {r1 - r0 for r0, r1 in row_ranges}\n    panel_widths = {c1 - c0 for c0, c1 in col_ranges}\n    assert len(panel_heights) == 1 and len(panel_widths) == 1\n    panel_h = panel_heights.pop()\n    panel_w = panel_widths.pop()\n    assert panel_h >= 3 and panel_w >= 3, \"panels must have a frame and interior\"\n\n    labels: list[int] = []\n    panels: list[list[tuple[str, int, np.ndarray | None]]] = []\n    border_colors: set[int] = set()\n    mask_colors: set[int] = set()\n\n    for r0, r1 in row_ranges:\n        label_cells = g[r0:r1, 0]\n        assert np.all(label_cells == label_cells[0]), \"row label must be constant\"\n        label = int(label_cells[0])\n        assert label != bg, \"row label must be distinct from the background\"\n        labels.append(label)\n\n        row_panels = []\n        for c0, c1 in col_ranges:\n            panel = g[r0:r1, c0:c1]\n            assert panel.shape == (panel_h, panel_w)\n\n            border = np.concatenate(\n                [panel[0, :], panel[-1, :], panel[1:-1, 0], panel[1:-1, -1]]\n            )\n            assert np.all(border == border[0]), \"each input panel frame must be solid\"\n            border_colors.add(int(border[0]))\n\n            interior = panel[1:-1, 1:-1]\n            vals = set(map(int, np.unique(interior)))\n            if len(vals) == 1:\n                color = next(iter(vals))\n                assert color != bg, \"solid swatch cannot be background\"\n                row_panels.append((\"solid\", color, None))\n            else:\n                assert len(vals) == 2 and bg in vals, \"template panel must use bg plus one color\"\n                color = next(v for v in vals if v != bg)\n                mask_colors.add(color)\n                row_panels.append((\"mask\", color, interior == color))\n        panels.append(row_panels)\n\n    assert len(border_colors) == 1, \"all input panels must use one frame color\"\n    assert len(mask_colors) == 1, \"all template panels must use one mask color\"\n\n    out_w = len(col_ranges) * panel_w + len(col_ranges) - 1\n    out = np.full((panel_h, out_w), bg, dtype=int)\n\n    for ci in range(len(col_ranges)):\n        solid_entries: list[tuple[int, int]] = []\n        masks: list[np.ndarray] = []\n        for ri in range(len(row_ranges)):\n            kind, color, mask = panels[ri][ci]\n            if kind == \"solid\":\n                solid_entries.append((ri, color))\n            else:\n                assert mask is not None\n                masks.append(mask)\n\n        assert len(solid_entries) == 1, \"each panel column must have one solid swatch\"\n        assert len(masks) == len(row_ranges) - 1 and masks, \"remaining panels must be masks\"\n        base_mask = masks[0]\n        for mask in masks[1:]:\n            assert np.array_equal(mask, base_mask), \"mask panels in a column must match\"\n\n        swatch_row, swatch_color = solid_entries[0]\n        frame_color = labels[swatch_row]\n        panel = np.full((panel_h, panel_w), bg, dtype=int)\n        panel[0, :] = frame_color\n        panel[-1, :] = frame_color\n        panel[:, 0] = frame_color\n        panel[:, -1] = frame_color\n        panel[1:-1, 1:-1][base_mask] = swatch_color\n\n        out_c = ci * (panel_w + 1)\n        out[:, out_c : out_c + panel_w] = panel\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# --- Configuration ---\n_PANEL_ROWS = 3                  # number of panel rows (R)\n_PANEL_COLS_CHOICES = [3, 4]     # number of panel columns (C)\n_PANEL_SIZE_CHOICES = [5, 6, 7]  # panel side length including frame (N)\n_FILL_DENSITY_LO = 0.3           # minimum mask fill fraction\n_FILL_DENSITY_HI = 0.7           # maximum mask fill fraction\n_MASK_RETRIES = 100              # attempts per column to find a unique mask\n_GEN_RETRIES = 300               # outer generation attempts\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after %d attempts\" % _GEN_RETRIES)\n\n","exit_code":0,"status":"completed"}}
