{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np\nimport random\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed2131201979/9/3.py')\nmod = SourceFileLoader('new_arc_task_dbg', str(p)).load_module()\n\nrandom.seed(0)\ncounts = {'sample_none':0,'place_none':0,'assert':0,'mismatch':0,'ok':0}\nfor i in range(50):\n    loop_count = random.choice(mod.LOOP_COUNT_OPTIONS)\n    specs = mod._sample_specs(loop_count)\n    if specs is None:\n        counts['sample_none'] += 1\n        continue\n    specs = mod._place_specs(specs)\n    if specs is None:\n        counts['place_none'] += 1\n        continue\n    inp = mod._render_input(specs)\n    expected = mod._render_expected(specs)\n    inp, expected = mod._crop_pair(inp, expected)\n    try:\n        actual = mod.main(inp)\n    except AssertionError as e:\n        counts['assert'] += 1\n        print('ASSERT', i, e)\n        print(specs)\n        break\n    if np.array_equal(actual, expected):\n        counts['ok'] += 1\n    else:\n        counts['mismatch'] += 1\n        print('MISMATCH', i, inp.shape)\n        print(specs)\n        print('input\\\\n', inp)\n        print('expected\\\\n', expected)\n        print('actual\\\\n', actual)\n        break\nprint(counts)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
