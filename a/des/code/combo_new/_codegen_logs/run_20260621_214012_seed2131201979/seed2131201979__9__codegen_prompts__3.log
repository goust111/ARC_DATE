{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/48634b99.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, colors_present, find_components, get_bg, paste, random_free_location\nimport random\n\n\ndef _is_solid_vertical_bar(component: dict) -> bool:\n    return bbox_w(component[\"bbox\"]) == 1 and int(component[\"area\"]) == bbox_h(component[\"bbox\"])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Advance the marker from one half of a vertical bar to the same half of the next longer bar.\n\n    Input structure\n    - The grid has one dominant background color and exactly two foreground colors.\n    - One foreground color forms many vertical one-cell-wide bars; the other appears as a single vertical marker segment.\n    - The marker segment occupies exactly the top or bottom half of its containing vertical bar.\n    Rule\n    - Recolor the current marker segment back to the bar color.\n    - Find the unique all-bar-color vertical bar whose height is two pixels greater than the marked source bar.\n    - Recolor the same half of that next longer bar to the marker color.\n    Key insight\n    - Each bar's total height encodes an ordered size, and the marker advances from a 2k bar to the corresponding 2(k+1) bar while preserving whether it marks the top or bottom half.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = int(get_bg(g))\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, f\"expected exactly two foreground colors, got {colors}\"\n\n    mono_component_counts = {\n        int(color): len(\n            find_components(\n                g,\n                bg=bg,\n                colors=[int(color)],\n                connectivity=4,\n                monochromatic=True,\n            )\n        )\n        for color in colors\n    }\n    marker_colors = [color for color, count in mono_component_counts.items() if count == 1]\n    assert len(marker_colors) == 1, f\"expected one single-component marker color, got {mono_component_counts}\"\n    marker_color = int(marker_colors[0])\n\n    bar_colors = [int(color) for color in colors if int(color) != marker_color]\n    assert len(bar_colors) == 1\n    bar_color = int(bar_colors[0])\n\n    marker_components = find_components(\n        g,\n        bg=bg,\n        colors=[marker_color],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert len(marker_components) == 1\n    marker = marker_components[0]\n    marker_area = int(marker[\"area\"])\n    mr0, mc0, mr1, _mc1 = marker[\"bbox\"]\n    assert _is_solid_vertical_bar(marker)\n\n    bars = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    source_bars = [\n        bar\n        for bar in bars\n        if np.any(g[bar[\"coords\"][:, 0], bar[\"coords\"][:, 1]] == marker_color)\n    ]\n    assert len(source_bars) == 1, f\"expected one bar containing the marker, got {len(source_bars)}\"\n    source = source_bars[0]\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    source_h = bbox_h(source[\"bbox\"])\n    assert _is_solid_vertical_bar(source)\n    assert source_h == 2 * marker_area\n    assert mc0 == sc0 == sc1\n\n    if mr0 == sr0 and mr1 == sr0 + marker_area - 1:\n        marked_end = \"top\"\n    elif mr1 == sr1 and mr0 == sr1 - marker_area + 1:\n        marked_end = \"bottom\"\n    else:\n        raise AssertionError(f\"marker is not exactly one end-half: marker={marker['bbox']} source={source['bbox']}\")\n\n    target_h = source_h + 2\n    target_bars = []\n    for bar in bars:\n        values = g[bar[\"coords\"][:, 0], bar[\"coords\"][:, 1]]\n        if set(map(int, values)) != {bar_color}:\n            continue\n        if not _is_solid_vertical_bar(bar):\n            continue\n        if bbox_h(bar[\"bbox\"]) == target_h:\n            target_bars.append(bar)\n\n    assert len(target_bars) == 1, f\"expected one next-longer target bar, got {[bar['bbox'] for bar in target_bars]}\"\n    target = target_bars[0]\n    tr0, tc0, tr1, _tc1 = target[\"bbox\"]\n    target_half = target_h // 2\n\n    out = g.copy()\n    out[g == marker_color] = bar_color\n    if marked_end == \"top\":\n        out[tr0 : tr0 + target_half, tc0] = marker_color\n    else:\n        out[tr1 - target_half + 1 : tr1 + 1, tc0] = marker_color\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Fixed palette observed in all examples.\nBG = 7\nBAR_COLOR = 8\nMARKER_COLOR = 9\n# Grid geometry and vertical bar vocabulary.\nGRID_SHAPE = (16, 16)\nPROGRESSION_HEIGHTS = (2, 4, 6, 8, 10)\nSOURCE_HEIGHTS = PROGRESSION_HEIGHTS[:-1]\nDISTRACTOR_HEIGHT = 2\nHEIGHT_STEP = 2\n# Placement constraints and structural sampling.\nPLACEMENT_PADDING = 1\nPLACEMENT_CONNECTIVITY = 4\nDISTRACTOR_COUNT_RANGE = (5, 11)\nMARKED_HALVES = (\"top\", \"bottom\")\n# Rejection-sampling retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _paint_bar_half(grid: np.ndarray, row: int, col: int, height: int, marked_half: str, color: int) -> None:\n    \"\"\"Paint the selected top or bottom half in place.\"\"\"\n    half = height // 2\n    if marked_half == \"top\":\n        grid[row : row + half, col] = color\n    else:\n        grid[row + height - half : row + height, col] = color\n\n\ndef _bar_patch(height: int, *, marked_half: str | None = None) -> np.ndarray:\n    patch = np.full((height, 1), BAR_COLOR, dtype=int)\n    if marked_half is not None:\n        _paint_bar_half(patch, 0, 0, height, marked_half, MARKER_COLOR)\n    return patch\n\n\ndef _place_bar(canvas: np.ndarray, patch: np.ndarray) -> tuple[int, int]:\n    r, c = random_free_location(\n        canvas,\n        patch,\n        transparent=BG,\n        padding=PLACEMENT_PADDING,\n        padding_connectivity=PLACEMENT_CONNECTIVITY,\n    )\n    paste(canvas, patch, r, c)\n    return r, c\n\n\ndef _place_progression_bars(canvas: np.ndarray, target_h: int, marked_half: str) -> dict[int, tuple[int, int]]:\n    \"\"\"Place one bar for each progression height and return height to top-left.\"\"\"\n    bar_tops: dict[int, tuple[int, int]] = {}\n    for height in random.sample(PROGRESSION_HEIGHTS, len(PROGRESSION_HEIGHTS)):\n        marker = marked_half if height == target_h else None\n        bar_tops[height] = _place_bar(canvas, _bar_patch(height, marked_half=marker))\n    return bar_tops\n\n\ndef _derive_input(out: np.ndarray, bar_tops: dict[int, tuple[int, int]], source_h: int, target_h: int, marked_half: str) -> np.ndarray:\n    \"\"\"Move the output marker back from target to source.\"\"\"\n    inp = out.copy()\n    tr, tc = bar_tops[target_h]\n    _paint_bar_half(inp, tr, tc, target_h, marked_half, BAR_COLOR)\n\n    sr, sc = bar_tops[source_h]\n    _paint_bar_half(inp, sr, sc, source_h, marked_half, MARKER_COLOR)\n    return inp\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    source_h = random.choice(SOURCE_HEIGHTS)\n    target_h = source_h + HEIGHT_STEP\n    marked_half = random.choice(MARKED_HALVES)\n    out = np.full(GRID_SHAPE, BG, dtype=int)\n\n    try:\n        bar_tops = _place_progression_bars(out, target_h, marked_half)\n        for _ in range(random.randint(*DISTRACTOR_COUNT_RANGE)):\n            _place_bar(out, _bar_patch(DISTRACTOR_HEIGHT))\n    except ValueError:\n        return None\n\n    inp = _derive_input(out, bar_tops, source_h, target_h, marked_half)\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except AssertionError:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 48634b99 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\"","aggregated_output":"from __future__ import annotations\n\nimport math\n\nimport numpy as np\n\nfrom arc_utils import bbox, colors_present, crop_bbox, get_bg, label_mask\nimport random\n\n\ndef _count_enclosed_regions(walls: np.ndarray) -> int:\n    labels, n_labels = label_mask(~walls, connectivity=4)\n    h, w = walls.shape\n    count = 0\n    for k in range(1, n_labels + 1):\n        coords = np.argwhere(labels == k)\n        assert coords.size > 0\n        touches_edge = (\n            np.any(coords[:, 0] == 0)\n            or np.any(coords[:, 0] == h - 1)\n            or np.any(coords[:, 1] == 0)\n            or np.any(coords[:, 1] == w - 1)\n        )\n        if not touches_edge:\n            count += 1\n    return int(count)\n\n\ndef _reconstruct_walls(mask: np.ndarray) -> np.ndarray:\n    h, _w = mask.shape\n    col_counts = mask.sum(axis=0)\n    v_threshold = max(3, math.ceil(0.45 * h))\n    vcols = [int(c) for c, n in enumerate(col_counts) if int(n) >= v_threshold]\n    if len(vcols) < 2:\n        return mask.copy()\n\n    row_counts = mask.sum(axis=1)\n    h_threshold = max(3, len(vcols) + 1)\n    hrows = [int(r) for r, n in enumerate(row_counts) if int(n) >= h_threshold]\n    assert len(hrows) >= 2\n\n    walls = np.zeros_like(mask, dtype=bool)\n\n    for r in hrows:\n        for c0, c1 in zip(vcols, vcols[1:]):\n            segment = mask[r, c0 : c1 + 1]\n            length = int(c1 - c0 + 1)\n            hits = int(segment.sum())\n            dense = hits >= max(2, math.ceil(0.45 * length))\n            interior_evidence = length > 2 and hits >= 2 and bool(segment[1:-1].any())\n            if dense or interior_evidence:\n                walls[r, c0 : c1 + 1] = True\n\n    for c in vcols:\n        for r0, r1 in zip(hrows, hrows[1:]):\n            segment = mask[r0 : r1 + 1, c]\n            length = int(r1 - r0 + 1)\n            hits = int(segment.sum())\n            if hits >= max(2, math.ceil(0.45 * length)):\n                walls[r0 : r1 + 1, c] = True\n\n    return walls\n\n\ndef _room_count_for_color(g: np.ndarray, color: int) -> int:\n    b = bbox(g == int(color))\n    assert b is not None\n    mask = crop_bbox(g == int(color), b).astype(bool)\n    walls = _reconstruct_walls(mask)\n    return _count_enclosed_regions(walls)\n\n\ndef _walls_for_color(g: np.ndarray, color: int) -> np.ndarray:\n    b = bbox(g == int(color))\n    assert b is not None\n    r0, c0, r1, c1 = b\n    mask = crop_bbox(g == int(color), b).astype(bool)\n    walls = _reconstruct_walls(mask)\n    out = np.zeros_like(g, dtype=bool)\n    out[r0 : r1 + 1, c0 : c1 + 1] = walls\n    return out\n\n\ndef _cover_order(g: np.ndarray, group: list[tuple[int, int, np.ndarray]]) -> list[tuple[int, int, np.ndarray]]:\n    if len(group) == 1:\n        return group\n\n    by_color = {int(item[0]): item for item in group}\n    above: dict[int, set[int]] = {color: set() for color, _rooms, _walls in group}\n    indegree: dict[int, int] = {color: 0 for color, _rooms, _walls in group}\n\n    for i, (ca, _ra, wa) in enumerate(group):\n        for cb, _rb, wb in group[i + 1 :]:\n            overlap = wa & wb\n            if not bool(overlap.any()):\n                continue\n            visible = set(int(v) for v in np.unique(g[overlap]))\n            top_colors = visible & {int(ca), int(cb)}\n            assert len(top_colors) == 1\n            top = top_colors.pop()\n            under = int(cb) if top == int(ca) else int(ca)\n            if top not in above[under]:\n                above[under].add(top)\n                indegree[top] += 1\n\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    remaining = set(by_color)\n    while remaining:\n        ready = [color for color in remaining if indegree[color] == 0]\n        assert len(ready) == 1\n        color = ready[0]\n        remaining.remove(color)\n        ordered.append(by_color[color])\n        for nxt in above[color]:\n            indegree[nxt] -= 1\n    return ordered\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n\n    Input structure:\n    - Black background with several axis-aligned colored line drawings.\n    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n\n    Rule:\n    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n    - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n    - The color with no enclosed region is the noise/pad color.\n    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n\n    Key insight:\n    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg == 0\n\n    counts: list[tuple[int, int, np.ndarray]] = []\n    for color in colors_present(g, exclude={bg}):\n        rooms = _room_count_for_color(g, int(color))\n        walls = _walls_for_color(g, int(color))\n        counts.append((int(color), int(rooms), walls))\n\n    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n    assert drawings\n    assert len(pad_colors) == 1\n\n    pad = int(pad_colors[0])\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n        group = [item for item in drawings if item[1] == rooms]\n        ordered.extend(_cover_order(g, group))\n\n    width = max(rooms for _color, rooms, _walls in ordered)\n\n    out = np.full((len(ordered), width), pad, dtype=int)\n    for r, (color, rooms, _walls) in enumerate(ordered):\n        out[r, :rooms] = int(color)\n    return out\n\n# --------------- generator (claude-opus-4-6) ---------------\n\n# ---- CFG: Tunable generation parameters ----\n_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n    5: (25, 30, 25, 30, 16, 18),\n    4: (22, 30, 22, 30, 18, 22),\n    3: (20, 30, 20, 30, 22, 25),\n}\n_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n_OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n_GEN_RETRIES = 300                   # outer retry limit\n\n\ndef _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n    \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n    if n * min_gap > max_total:\n        return None\n    gaps = [min_gap] * n\n    remaining = max_total - sum(gaps)\n    for i in range(n):\n        extra = min(max_gap - gaps[i], remaining)\n        if extra > 0:\n            add = random.randint(0, extra)\n            gaps[i] += add\n            remaining -= add\n    random.shuffle(gaps)\n    return gaps\n\n\ndef _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n    \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n    if target_rooms == 1:\n        gap_h = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_h - 2))\n        gap_w = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_w - 2))\n        h, w = gap_h + 2, gap_w + 2\n        walls = np.zeros((h, w), dtype=bool)\n        walls[0, :] = True\n        walls[h - 1, :] = True\n        walls[:, 0] = True\n        walls[:, w - 1] = True\n        return walls\n\n    # For target_rooms >= 2: grid of cells, then selectively merge\n    possible_configs = []\n    for nv in range(2, 6):\n        for nh in range(2, 5):\n            cells = (nv - 1) * (nh - 1)\n            if target_rooms <= cells <= target_rooms + 4:\n                possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        for nv in range(2, 7):\n            for nh in range(2, 6):\n                cells = (nv - 1) * (nh - 1)\n                if cells >= target_rooms:\n                    possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        return None\n\n    n_vcols, n_hrows, total_cells = random.choice(possible_configs)\n    n_row_gaps = n_hrows - 1\n    n_col_gaps = n_vcols - 1\n    min_gap, max_gap = _CELL_GAP_RANGE\n\n    if min_gap * n_row_gaps > max_h - 1 or min_gap * n_col_gaps > max_w - 1:\n        return None\n\n    row_gaps = _random_gaps(n_row_gaps, min_gap, max_gap, max_h - 1)\n    col_gaps = _random_gaps(n_col_gaps, min_gap, max_gap, max_w - 1)\n    if row_gaps is None or col_gaps is None:\n        return None\n\n    # Compute line positions from cumulative gaps\n    vcol_positions = [0]\n    for gap in col_gaps:\n        vcol_positions.append(vcol_positions[-1] + gap)\n    hrow_positions = [0]\n    for gap in row_gaps:\n        hrow_positions.append(hrow_positions[-1] + gap)\n\n    frame_h = hrow_positions[-1] + 1\n    frame_w = vcol_positions[-1] + 1\n    walls = np.zeros((frame_h, frame_w), dtype=bool)\n    for r in hrow_positions:\n        walls[r, :] = True\n    for c in vcol_positions:\n        walls[:, c] = True\n\n    cells_to_merge = total_cells - target_rooms\n    if cells_to_merge == 0:\n        return walls\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/f18ec8cc.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\nimport itertools\nimport random\n\n\nBlock = tuple[int, int, int]  # c0, c1_exclusive, dominant color\n\n\ndef _unique_mode(values: np.ndarray) -> int:\n    counts = Counter(map(int, values.reshape(-1)))\n    ranked = counts.most_common()\n    assert ranked, \"expected a nonempty sequence\"\n    assert len(ranked) == 1 or ranked[0][1] > ranked[1][1], \"expected a unique dominant color\"\n    return int(ranked[0][0])\n\n\ndef _vertical_blocks(g: np.ndarray) -> list[Block]:\n    height, width = map(int, g.shape)\n    assert height > 0 and width > 0, \"expected a nonempty grid\"\n\n    column_colors = [_unique_mode(g[:, c]) for c in range(width)]\n    blocks: list[Block] = []\n    start = 0\n    current = column_colors[0]\n    for col, color in enumerate(column_colors[1:], start=1):\n        if color != current:\n            blocks.append((start, col, current))\n            start = col\n            current = color\n    blocks.append((start, width, current))\n\n    assert len(blocks) >= 3, \"expected at least three vertical color blocks\"\n    base_colors = [color for _, _, color in blocks]\n    assert len(set(base_colors)) == len(base_colors), \"block colors must be unique\"\n    return blocks\n\n\ndef _common_marker_rows(g: np.ndarray, blocks: list[Block]) -> list[tuple[int, int]]:\n    base_colors = {color for _, _, color in blocks}\n    rows: list[tuple[int, int]] = []\n    for r in range(g.shape[0]):\n        shared = base_colors.copy()\n        for c0, c1, _ in blocks:\n            shared &= set(map(int, g[r, c0:c1]))\n        if shared:\n            assert len(shared) == 1, \"expected each marker row to name one block color\"\n            rows.append((r, shared.pop()))\n    return rows\n\n\ndef _block_order(g: np.ndarray, blocks: list[Block]) -> list[int]:\n    block_count = len(blocks)\n    base_colors = [color for _, _, color in blocks]\n    marker_rows = _common_marker_rows(g, blocks)\n\n    if len(marker_rows) == block_count:\n        assert len({color for _, color in marker_rows}) == block_count, \"marker rows must name unique blocks\"\n        row_numbers = [row for row, _ in marker_rows]\n        marker_colors = [color for _, color in sorted(marker_rows)]\n        if max(row_numbers) - min(row_numbers) + 1 == block_count and marker_colors == list(reversed(base_colors)):\n            return list(reversed(range(block_count)))\n    else:\n        assert len(marker_rows) in (0, 1), \"incomplete marker rows should be absent or unique\"\n\n    return list(range(1, block_count)) + [0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reorder the vertical color-major blocks while preserving every block's internal pixels.\n\n    Input structure\n    The grid is divided into vertical blocks, each with a unique dominant color.\n    Small marker pixels from other block colors may appear inside the blocks.\n\n    Rule\n    If adjacent shared-color marker rows read exactly as the current block order\n    from right to left, reverse the blocks. Otherwise move the leftmost block to\n    the far right and shift the remaining blocks left.\n\n    Key insight\n    The transformation acts on whole vertical blocks, so marker pixels move with\n    their source block instead of being recolored or independently rearranged.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    blocks = _vertical_blocks(g)\n    order = _block_order(g, blocks)\n    assert sorted(order) == list(range(len(blocks))), \"block order must be a permutation\"\n\n    return np.concatenate([g[:, blocks[i][0] : blocks[i][1]] for i in order], axis=1)\n\n# --------------- generator (o5x) ---------------\n# Canvas, block, and color bounds.\nGEN_HEIGHT_RANGE = (7, 9)\nGEN_TOTAL_WIDTH_RANGE = (10, 15)\nGEN_BLOCK_COUNT_CHOICES = [3, 4]\nGEN_BLOCK_WIDTH_RANGE = (3, 7)\nGEN_COLOR_POOL = range(1, 10)\n\n# Marker-layout probabilities and row-sharing limits.\nGEN_REVERSE_PROB = 0.35\nGEN_ALIGNED_LEFT_SHIFT_PROB = 0.7\nGEN_NONCONSECUTIVE_LEFT_SHIFT_PROB = 0.5\nGEN_COMMON_COLOR_COUNT_RANGE = (0, 1)\n\n# Rejection-sampling retry limit.\nGEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_bounds(widths):\n    starts = [0, *itertools.accumulate(widths[:-1])]\n    return [(c0, c0 + width) for c0, width in zip(starts, widths)]\n\n\ndef _gen_expected(grid, widths, order):\n    bounds = _gen_bounds(widths)\n    return np.concatenate([grid[:, bounds[i][0] : bounds[i][1]] for i in order], axis=1)\n\n\ndef _gen_pick_widths(block_count):\n    min_width, max_width = GEN_BLOCK_WIDTH_RANGE\n    total = random.randint(\n        max(GEN_TOTAL_WIDTH_RANGE[0], min_width * block_count),\n        min(GEN_TOTAL_WIDTH_RANGE[1], max_width * block_count),\n    )\n    options = [\n        widths\n        for widths in itertools.product(range(min_width, max_width + 1), repeat=block_count)\n        if sum(widths) == total\n    ]\n    return list(random.choice(options))\n\n\ndef _gen_marker_col(c0, c1):\n    return random.randint(c0 + 1, c1 - 2)\n\n\ndef _gen_place_aligned(grid, widths, colors, color_rows):\n    bounds = _gen_bounds(widths)\n    for block_i, (c0, c1) in enumerate(bounds):\n        base = colors[block_i]\n        for color in colors:\n            if color != base:\n                grid[color_rows[color], _gen_marker_col(c0, c1)] = color\n\n\ndef _gen_nonconsecutive_rows(height, block_count):\n    options = [\n        rows\n        for rows in itertools.combinations(range(height), block_count)\n        if rows[-1] - rows[0] + 1 != block_count\n    ]\n    return list(random.choice(options))\n\n\ndef _gen_place_unaligned_left_shift(grid, widths, colors):\n    height = grid.shape[0]\n    bounds = _gen_bounds(widths)\n    common_colors = random.sample(colors, random.randint(*GEN_COMMON_COLOR_COUNT_RANGE))\n    row_by_common = {color: random.randrange(height) for color in common_colors}\n\n    assignments = []\n    for block_i, _ in enumerate(bounds):\n        base = colors[block_i]\n        used = set()\n        by_color = {}\n        for color in common_colors:\n            if color != base:\n                row = row_by_common[color]\n                used.add(row)\n                by_color[color] = row\n        foreign = [color for color in colors if color != base and color not in common_colors]\n        rows = random.sample([r for r in range(height) if r not in used], len(foreign))\n        for color, row in zip(foreign, rows):\n            by_color[color] = row\n        assignments.append(by_color)\n\n    for color in colors:\n        if color in common_colors:\n            continue\n        block_ids = [i for i, base in enumerate(colors) if base != color]\n        if len({assignments[i][color] for i in block_ids}) == 1:\n            block_i = random.choice(block_ids)\n            used = set(assignments[block_i].values())\n            old_row = assignments[block_i][color]\n            choices = [r for r in range(height) if r not in used and r != old_row]\n            assignments[block_i][color] = random.choice(choices)\n\n    for block_i, (c0, c1) in enumerate(bounds):\n        for color, row in assignments[block_i].items():\n            grid[row, _gen_marker_col(c0, c1)] = color\n\n\ndef _gen_base_grid():\n    height = random.randint(*GEN_HEIGHT_RANGE)\n    block_count = random.choice(GEN_BLOCK_COUNT_CHOICES)\n    colors = random.sample(GEN_COLOR_POOL, block_count)\n    widths = _gen_pick_widths(block_count)\n    grid = np.zeros((height, sum(widths)), dtype=int)\n    for color, (c0, c1) in zip(colors, _gen_bounds(widths)):\n        grid[:, c0:c1] = color\n    return grid, widths, colors\n\n\ndef _gen_place_reverse_markers(grid, widths, colors):\n    block_count = len(colors)\n    start = random.randint(0, grid.shape[0] - block_count)\n    rows = list(range(start, start + block_count))\n    color_rows = {color: row for color, row in zip(reversed(colors), rows)}\n    _gen_place_aligned(grid, widths, colors, color_rows)\n    return list(reversed(range(block_count)))\n\n\ndef _gen_place_left_shift_markers(grid, widths, colors):\n    if random.random() < GEN_ALIGNED_LEFT_SHIFT_PROB:\n        block_count = len(colors)\n        if random.random() < GEN_NONCONSECUTIVE_LEFT_SHIFT_PROB:\n            rows = _gen_nonconsecutive_rows(grid.shape[0], block_count)\n            ordered_colors = random.sample(colors, block_count)\n        else:\n            start = random.randint(0, grid.shape[0] - block_count)\n            rows = list(range(start, start + block_count))\n            ordered_colors = list(reversed(colors))\n            swap_i = random.randrange(block_count - 1)\n            ordered_colors[swap_i : swap_i + 2] = reversed(ordered_colors[swap_i : swap_i + 2])\n        color_rows = {color: row for color, row in zip(ordered_colors, rows)}\n        _gen_place_aligned(grid, widths, colors, color_rows)\n    else:\n        _gen_place_unaligned_left_shift(grid, widths, colors)\n    return list(range(1, len(colors))) + [0]\n\n\ndef _gen_place_markers(grid, widths, colors):\n    if random.random() < GEN_REVERSE_PROB:\n        return _gen_place_reverse_markers(grid, widths, colors)\n    return _gen_place_left_shift_markers(grid, widths, colors)\n\n\ndef _gen_attempt():\n    grid, widths, colors = _gen_base_grid()\n    order = _gen_place_markers(grid, widths, colors)\n    expected = _gen_expected(grid, widths, order)\n    return grid if np.array_equal(main(grid), expected) else None\n\n\ndef generate_input():\n    for _ in range(GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid f18ec8cc input\")\n","exit_code":0,"status":"completed"}}
