{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/3dc255db.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/3dc255db.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Eject content pixels from cup-shaped frames outward along each cup's tail direction.\n\n    Input structure:\n    - bg = background. Hollow cup/Y/funnel frames, each a unique border color.\n    - Each cup has a convergent tail spike on one side and an open mouth on the opposite side.\n    - Content pixels (a single non-border color per cup) sit inside the cup's mouth interior.\n\n    Rule:\n    - For each cup, identify its tail spike and tail direction.\n    - Erase all content pixels from the mouth interior.\n    - Draw a straight line of content-colored pixels from the spike outward in the tail direction,\n      one pixel per erased content pixel; cells beyond the grid edge are dropped.\n\n    Key insight: The tail spike is the unique convergent point whose outward direction is opposite\n    the mouth opening where the content lives.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n    out = g.copy()\n\n    DIR4 = {\"U\": (-1, 0), \"D\": (1, 0), \"L\": (0, -1), \"R\": (0, 1)}\n    OPPOSITE = {\"U\": \"D\", \"D\": \"U\", \"L\": \"R\", \"R\": \"L\"}\n\n    for border_col in colors_present(g, exclude={bg}):\n        for border_coords in components_mask(g == int(border_col), connectivity=8):\n            if border_coords.size == 0 or int(border_coords.shape[0]) < 5:\n                continue\n\n            r0, c0, r1, c1 = (int(v) for v in bbox_coords(border_coords))\n            bbox = (r0, c0, r1, c1)\n            border_set = {(int(r), int(c)) for r, c in border_coords}\n            corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}\n\n            # Candidate tail spikes: single border cell on a bbox edge, not at a corner.\n            edges = (\n                (\"U\", [p for p in border_set if p[0] == r0]),\n                (\"D\", [p for p in border_set if p[0] == r1]),\n                (\"L\", [p for p in border_set if p[1] == c0]),\n                (\"R\", [p for p in border_set if p[1] == c1]),\n            )\n            candidates = [\n                (d, cells[0]) for d, cells in edges\n                if len(cells) == 1 and cells[0] not in corners\n            ]\n            if not candidates:\n                continue\n\n            # Each candidate: flood from opposite bbox side; keep candidates whose flood\n            # reaches content (non-bg, non-border) cells.\n            passing = []\n            for d, spike in candidates:\n                mouth = _flood_from_bbox_side(border_set, bbox, OPPOSITE[d])\n                cnt = Counter()\n                for r, c in mouth:\n                    v = int(g[r, c])\n                    if v != bg and v != int(border_col):\n                        cnt[v] += 1\n                if not cnt:\n                    continue\n                content_col = int(cnt.most_common(1)[0][0])\n                content_cells = [p for p in mouth if int(g[p[0], p[1]]) == content_col]\n                passing.append((d, spike, content_col, content_cells))\n\n            # Only act on cups with an unambiguous tail.\n            if len(passing) != 1:\n                continue\n            tail_dir, spike, content_col, content_cells = passing[0]\n\n            # Erase content, then eject outward.\n            for r, c in content_cells:\n                out[r, c] = bg\n\n            dr, dc = DIR4[tail_dir]\n            sr, sc = spike\n            for t in range(1, len(content_cells) + 1):\n                rr = sr + dr * t\n                cc = sc + dc * t\n                if not (0 <= rr < H and 0 <= cc < W):\n                    break\n                out[rr, cc] = content_col\n\n    return out\n\n# --------------- generator (claude opus) ---------------\n\n# ==== Generator configuration ====\n# Canvas size bounds (inclusive)\nGRID_H_RANGE = (10, 13)\nGRID_W_RANGE = (10, 13)\n\n# Number of cups per grid (choices sampled uniformly)\nNUM_CUPS_CHOICES = (1, 2, 3)\n\n# Cup bbox bounds for the canonical (tail=U) patch.\n# After rotation to L/R the axes swap, so both orientations must fit spec bbox 3..8 rows x 3..7 cols.\nCUP_BBOX_MAX_UD = (8, 7)  # (max_h, max_w) when tail is U or D\nCUP_BBOX_MAX_LR = (7, 8)  # (max_h, max_w) when tail is L or R\n\n# Arm-length ranges for the canonical Y/funnel (inclusive)\nARM_LEN_RANGE = (1, 3)        # L and R diagonal arm length\nWALL_EXT_RANGE = (0, 4)       # hL / hR (extra vertical wall cells after arm touches side)\n\n# Content pixel count cap (per cup)\nCONTENT_COUNT_MAX = 7\n\n# Stray-pixel probability and color choice probability (border vs content)\nSTRAY_PROB = 0.4\nSTRAY_USE_BORDER_PROB = 0.5\n\n# Retry budgets\nGEN_RETRIES_PRIMARY = 300     # retries that honor a pre-chosen num_cups\nGEN_RETRIES_FALLBACK = 300    # fallback retries with random num_cups\n# ==================================\n\nDIR4 = {\"U\": (-1, 0), \"D\": (1, 0), \"L\": (0, -1), \"R\": (0, 1)}\n_STRUCT8 = np.ones((3, 3), dtype=bool)\n\n\ndef _build_canonical_cup(L: int, R: int, hL: int, hR: int, color: int) -> tuple[np.ndarray, tuple[int, int]]:\n    \"\"\"Build a Y/funnel cup with tail pointing UP (spike at top, row 0).\n\n    Left arm is a diagonal of length L going down-left; right arm length R down-right.\n    After the left arm reaches col 0 (at row L), the left wall continues for hL more rows.\n    Likewise the right wall continues for hR rows after its arm reaches col L+R.\n    Requires hL + hR >= 1 so the bbox has enough vertical extent for a mouth.\n    Returns (patch, spike_rc); bg in patch is 0.\"\"\"\n    assert L >= 1 and R >= 1 and hL >= 0 and hR >= 0 and (hL + hR) >= 1\n    w = L + R + 1\n    h = max(L + hL, R + hR) + 1\n    g = np.zeros((h, w), dtype=int)\n    g[0, L] = color                                   # spike\n    g[np.arange(1, L + 1), L - np.arange(1, L + 1)] = color   # left arm\n    g[np.arange(1, R + 1), L + np.arange(1, R + 1)] = color   # right arm\n    if hL:\n        g[L + 1:L + hL + 1, 0] = color                # left wall\n    if hR:\n        g[R + 1:R + hR + 1, w - 1] = color            # right wall\n    return g, (0, L)\n\n\ndef _mouth_interior_coords(patch: np.ndarray, border_color: int, opposite_side: str) -> list[tuple[int, int]]:\n    \"\"\"Flood-fill the interior of the cup patch from cells on the given bbox edge, stopping at\n    the border. Returns the sorted list of interior coordinates (seeds included).\"\"\"\n    h, w = patch.shape\n    border_mask = (patch == border_color)\n    if opposite_side == \"U\":\n        seeds = [(0, c) for c in range(w) if not border_mask[0, c]]\n    elif opposite_side == \"D\":\n        seeds = [(h - 1, c) for c in range(w) if not border_mask[h - 1, c]]\n    elif opposite_side == \"L\":\n        seeds = [(r, 0) for r in range(h) if not border_mask[r, 0]]\n    else:  # \"R\"\n        seeds = [(r, w - 1) for r in range(h) if not border_mask[r, w - 1]]\n    visited = set(seeds)\n    stack = list(seeds)\n    while stack:\n        r, c = stack.pop()\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited and not border_mask[nr, nc]:\n                visited.add((nr, nc))\n                stack.append((nr, nc))\n    return sorted(visited)\n\n\ndef _rotate_to_direction(\n    patch: np.ndarray, spike: tuple[int, int], mouth: list[tuple[int, int]], direction: str,\n) -> tuple[np.ndarray, tuple[int, int], list[tuple[int, int]]]:\n    \"\"\"Rotate a canonical (tail=U) patch, its spike and mouth coords to the target tail direction.\"\"\"\n    h, w = patch.shape\n    sr, sc = spike\n    if direction == \"U\":\n        return patch.copy(), (sr, sc), list(mouth)\n    if direction == \"D\":\n        return np.flipud(patch).copy(), (h - 1 - sr, sc), [(h - 1 - r, c) for (r, c) in mouth]\n    if direction == \"L\":\n        # rot90 k=1 (CCW): old (r, c) -> new (w-1-c, r)\n        return np.rot90(patch, k=1).copy(), (w - 1 - sc, sr), [(w - 1 - c, r) for (r, c) in mouth]\n    if direction == \"R\":\n        # rot90 k=-1 (CW): old (r, c) -> new (c, h-1-r)\n        return np.rot90(patch, k=-1).copy(), (sc, h - 1 - sr), [(c, h - 1 - r) for (r, c) in mouth]\n    raise ValueError(direction)\n\n\ndef _sample_cup_shape(rng: np.random.Generator, direction: str) -> tuple[int, int, int, int] | None:\n    \"\"\"Pick (L, R, hL, hR) parameters for a canonical cup, clamped so the patch fits the\n    task's bbox spec after rotation. Returns None if no feasible shape could be derived.\"\"\"\n    if direction in (\"U\", \"D\"):\n        max_h_canon, max_w_canon = CUP_BBOX_MAX_UD\n    else:\n        max_h_canon, max_w_canon = CUP_BBOX_MAX_LR\n\n    lo, hi = ARM_LEN_RANGE\n    L_arm = int(rng.integers(lo, hi + 1))\n    R_arm = int(rng.integers(lo, hi + 1))\n    while L_arm + R_arm + 1 > max_w_canon:\n        if L_arm >= R_arm:\n            L_arm -= 1\n        else:\n            R_arm -= 1\n\n    wlo, whi = WALL_EXT_RANGE\n    hL = int(rng.integers(wlo, whi + 1))\n    hR = int(rng.integers(wlo, whi + 1))\n    if hL + hR == 0:\n        hL = 1\n    while max(L_arm + hL, R_arm + hR) + 1 > max_h_canon:\n        if L_arm + hL >= R_arm + hR and hL > 0:\n            hL -= 1\n        elif hR > 0:\n            hR -= 1\n        else:\n            break\n    if hL + hR == 0:\n        return None\n    return L_arm, R_arm, hL, hR\n\n\ndef _try_place_cup(\n    rng: np.random.Generator, H: int, W: int, patch: np.ndarray, spike: tuple[int, int],\n    direction: str, content_count: int, occ_cup: np.ndarray, occ_path: np.ndarray,\n) -> tuple[int, int, list[tuple[int, int]], list[tuple[int, int]]] | None:\n    \"\"\"Find a valid placement offset (r0, c0) such that the cup's bbox has a 1-cell gap from\n    other cups and the ejection path from its spike is clear. Returns\n    (r0, c0, path_cells, ejection_cells) or None.\"\"\"\n    ph, pw = patch.shape\n    dr, dc = DIR4[direction]\n    occ_cup_dilated = ndimage.binary_dilation(occ_cup, structure=_STRUCT8)\n\n    coords_list = [(r0, c0) for r0 in range(H - ph + 1) for c0 in range(W - pw + 1)]\n    rng.shuffle(coords_list)\n\n    for r0, c0 in coords_list:\n        if occ_cup_dilated[r0:r0 + ph, c0:c0 + pw].any():\n            continue\n        if occ_path[r0:r0 + ph, c0:c0 + pw].any():\n            continue\n        sr_abs = r0 + spike[0]\n        sc_abs = c0 + spike[1]\n        rr, cc = sr_abs + dr, sc_abs + dc\n        path_cells = []\n        while 0 <= rr < H and 0 <= cc < W:\n            path_cells.append((rr, cc))\n            rr += dr\n            cc += dc\n        if not path_cells:\n            continue\n        if any(occ_cup[r, c] or occ_path[r, c] for r, c in path_cells):\n            continue\n        eject_len = min(content_count, len(path_cells))\n        return r0, c0, path_cells, path_cells[:eject_len]\n    return None\n\n\ndef _stray_candidate_mask(H: int, W: int, bbox: tuple[int, int, int, int], tail_dir: str) -> np.ndarray:\n    \"\"\"Boolean (H, W) mask of cells on the mouth side of ``bbox`` (opposite the tail direction),\n    restricted to the cup's perpendicular extent.\"\"\"\n    r0, c0, r1, c1 = bbox\n    mask = np.zeros((H, W), dtype=bool)\n    if tail_dir == \"R\":     # mouth to the left\n        mask[r0:r1 + 1, :c0] = True\n    elif tail_dir == \"L\":   # mouth to the right\n        mask[r0:r1 + 1, c1 + 1:] = True\n    elif tail_dir == \"D\":   # mouth upward\n        mask[:r0, c0:c1 + 1] = True\n    else:                   # \"U\", mouth downward\n        mask[r1 + 1:, c0:c1 + 1] = True\n    return mask\n\n\ndef _try_place_stray(\n    rng: np.random.Generator, canvas_in: np.ndarray, canvas_out: np.ndarray, cups_meta: list[dict],\n) -> None:\n    \"\"\"With probability ``STRAY_PROB``, place an isolated pixel on the mouth side of one cup.\n    The pixel must not touch any existing non-bg cell (1-cell gap) nor sit on a cup bbox or\n    ejection path, and its color reuses one of the chosen cup's colors.\"\"\"\n    if not cups_meta or rng.random() >= STRAY_PROB:\n        return\n    H, W = canvas_in.shape\n    meta = cups_meta[int(rng.integers(0, len(cups_meta)))]\n    stray_color = meta[\"border_color\"] if rng.random() < STRAY_USE_BORDER_PROB else meta[\"content_color\"]\n\n    forbidden = ndimage.binary_dilation(canvas_in != 0, structure=_STRUCT8)\n    for m in cups_meta:\n        br0, bc0, br1, bc1 = m[\"bbox\"]\n        forbidden[br0:br1 + 1, bc0:bc1 + 1] = True\n        for (r, c) in m[\"path_cells\"]:\n            forbidden[r, c] = True\n\n    candidate_mask = _stray_candidate_mask(H, W, meta[\"bbox\"], meta[\"direction\"]) & ~forbidden\n    candidates = np.argwhere(candidate_mask)\n    if candidates.size == 0:\n        return\n    r, c = candidates[int(rng.integers(0, len(candidates)))]\n    canvas_in[r, c] = stray_color\n    canvas_out[r, c] = stray_color\n\n\ndef _add_cup(\n    rng: np.random.Generator, H: int, W: int, border_color: int, content_color: int,\n    canvas_in: np.ndarray, canvas_out: np.ndarray, occ_cup: np.ndarray, occ_path: np.ndarray,\n) -> dict | None:\n    \"\"\"Build one cup (shape + placement + ejection line) and commit it to the canvases.\n    Returns a metadata dict, or None if no valid placement could be found this attempt.\"\"\"\n    direction = str(rng.choice([\"U\", \"D\", \"L\", \"R\"]))\n    shape = _sample_cup_shape(rng, direction)\n    if shape is None:\n        return None\n    L_arm, R_arm, hL, hR = shape\n\n    patch_canon, spike_canon = _build_canonical_cup(L_arm, R_arm, hL, hR, border_color)\n    mouth_canon = _mouth_interior_coords(patch_canon, border_color, opposite_side=\"D\")\n    if not mouth_canon:\n        return None\n\n    patch, spike, mouth = _rotate_to_direction(patch_canon, spike_canon, mouth_canon, direction)\n    ph, pw = patch.shape\n\n    content_count = int(rng.integers(1, min(CONTENT_COUNT_MAX, len(mouth)) + 1))\n\n    placement = _try_place_cup(\n        rng, H, W, patch, spike, direction, content_count, occ_cup, occ_path,\n    )\n    if placement is None:\n        return None\n    r0, c0, path_cells, ejection_cells = placement\n\n    patch_mask = patch != 0\n    canvas_out[r0:r0 + ph, c0:c0 + pw][patch_mask] = border_color\n    canvas_in[r0:r0 + ph, c0:c0 + pw][patch_mask] = border_color\n    occ_cup[r0:r0 + ph, c0:c0 + pw] = True\n    for (r, c) in ejection_cells:\n        canvas_out[r, c] = content_color\n    for (r, c) in path_cells:\n        occ_path[r, c] = True\n\n    return {\n        \"border_color\": border_color,\n        \"content_color\": content_color,\n        \"direction\": direction,\n        \"bbox\": (r0, c0, r0 + ph - 1, c0 + pw - 1),\n        \"mouth_abs\": [(r0 + r, c0 + c) for (r, c) in mouth],\n        \"content_count\": content_count,\n        \"path_cells\": path_cells,\n    }\n\n\ndef _scatter_content(rng: np.random.Generator, canvas_in: np.ndarray, cups_meta: list[dict]) -> bool:\n    \"\"\"Place each cup's content_count pixels at random inside its mouth interior.\n    Returns False if any cup's mouth is too small (should not normally happen).\"\"\"\n    for meta in cups_meta:\n        mouth_abs = meta[\"mouth_abs\"]\n        count = meta[\"content_count\"]\n        if len(mouth_abs) < count:\n            return False\n        idxs = rng.choice(len(mouth_abs), size=count, replace=False)\n        for i in idxs:\n            r, c = mouth_abs[int(i)]\n            canvas_in[r, c] = meta[\"content_color\"]\n    return True\n\n\ndef _gen_attempt(rng: np.random.Generator, num_cups: int | None = None) -> np.ndarray | None:\n    \"\"\"Single end-to-end generation attempt. Returns a valid input grid or None on failure.\n\n    Pipeline: sample canvas -> build/place each cup (committing borders and ejection lines to\n    canvas_out) -> scatter content into canvas_in -> optionally add a stray pixel -> oracle\n    check that main(canvas_in) == canvas_out.\n    \"\"\"\n    if num_cups is None:\n        num_cups = int(rng.choice(NUM_CUPS_CHOICES))\n    H = int(rng.integers(GRID_H_RANGE[0], GRID_H_RANGE[1] + 1))\n    W = int(rng.integers(GRID_W_RANGE[0], GRID_W_RANGE[1] + 1))\n    canvas_out = np.zeros((H, W), dtype=int)\n    canvas_in = np.zeros((H, W), dtype=int)\n\n    palette = list(range(1, 10))\n    rng.shuffle(palette)\n\n    # occ_cup: union of placed cup bboxes (dilation applied at check time for 1-cell gap).\n    # occ_path: union of ejection paths (must stay bg in the input).\n    occ_cup = np.zeros((H, W), dtype=bool)\n    occ_path = np.zeros((H, W), dtype=bool)\n\n    cups_meta: list[dict] = []\n    for _ in range(num_cups):\n        if len(palette) < 2:\n            return None\n        border_color = int(palette.pop())\n        content_color = int(palette.pop())\n        # Return content_color to the pool so other cups may reuse it as border or content\n        # (spec allows content colors to match other cups' border/content).\n        palette.append(content_color)\n\n        meta = _add_cup(\n            rng, H, W, border_color, content_color, canvas_in, canvas_out, occ_cup, occ_path,\n        )\n        if meta is None:\n            return None\n        cups_meta.append(meta)\n\n    if len(cups_meta) != num_cups:\n        return None\n\n    if not _scatter_content(rng, canvas_in, cups_meta):\n        return None\n\n    _try_place_stray(rng, canvas_in, canvas_out, cups_meta)\n\n    try:\n        produced = main(canvas_in)\n    except Exception:\n        return None\n    if not np.array_equal(produced, canvas_out):\n        return None\n    return canvas_in\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/c7f57c3e.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/c7f57c3e.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swap every sprite to the opposite prototype while preserving scale and position.\n\n    Input structure:\n    - bg = most common color. Two distinct small sprite patterns (prototypes) appear at various scales.\n    - Each sprite instance is a scaled copy of one of the two prototypes, placed on the grid.\n\n    Rule:\n    - Identify the two prototype patterns from the smallest-area sprites.\n    - For each sprite, determine which prototype it matches and its integer scale factor.\n    - Replace it with the other prototype at the same scale, aligned by an internal anchor region (color-1 pixels).\n\n    Key insight: Every sprite toggles to the alternate prototype; the anchor sub-region inside each sprite pins the alignment so swapped sprites land in the correct position regardless of scale.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    comps = components_mask(g != bg, connectivity=8)\n    assert len(comps) >= 2, \"grid must contain at least 2 sprite components\"\n\n    # Extract sprite records.\n    sprites = []\n    for pts in comps:\n        r0, c0, r1, c1 = bbox_coords(pts)\n        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        sprites.append({\"pts\": pts, \"bbox\": (r0, c0, r1, c1), \"arr\": arr})\n\n    # Determine two base prototypes from the smallest bbox area sprites.\n    areas = [int((s[\"bbox\"][2] - s[\"bbox\"][0] + 1) * (s[\"bbox\"][3] - s[\"bbox\"][1] + 1)) for s in sprites]\n    min_area = min(areas)\n    base = [s for s, a in zip(sprites, areas, strict=False) if a == min_area]\n    uniq: dict[tuple[int, ...], np.ndarray] = {}\n    for s in base:\n        key = tuple(s[\"arr\"].ravel().tolist())\n        if key not in uniq:\n            uniq[key] = s[\"arr\"]\n    assert len(uniq) == 2, \"smallest-area sprites must yield exactly 2 distinct prototype patterns\"\n\n    proto_keys = list(uniq.keys())[:2]\n    protos = [uniq[proto_keys[0]], uniq[proto_keys[1]]]\n\n    anc0 = _pick_anchor_bbox(protos[0], bg)\n    anc1 = _pick_anchor_bbox(protos[1], bg)\n    a0r0, a0c0, a0r1, a0c1 = anc0\n    base_anc_h = a0r1 - a0r0 + 1\n    base_anc_w = a0c1 - a0c0 + 1\n\n    out = g.copy()\n\n    for s in sprites:\n        r0, c0, r1, c1 = s[\"bbox\"]\n        arr = s[\"arr\"]\n        anc = _pick_anchor_bbox(arr, bg)\n        ar0, ac0, ar1, ac1 = anc\n        inst_anc_h = ar1 - ar0 + 1\n        inst_anc_w = ac1 - ac0 + 1\n        # infer integer scale\n        scale_h = max(1, inst_anc_h // max(1, base_anc_h))\n        scale_w = max(1, inst_anc_w // max(1, base_anc_w))\n        scale = int(max(scale_h, scale_w))\n\n        # score which prototype matches this sprite when aligned by core bbox\n        best_idx = 0\n        best_score = -1\n        for idx, p in enumerate(protos):\n            sp = _scale_nn(p, scale)\n            panc = _pick_anchor_bbox(p, bg)\n            pr0, pc0, pr1, pc1 = panc\n            pr0 *= scale\n            pc0 *= scale\n            # align anchor top-left to instance anchor top-left (global coords)\n            top = (r0 + ar0) - pr0\n            left = (c0 + ac0) - pc0\n\n            # overlap score: count matching non-bg pixels where prototype expects non-bg\n            score = 0\n            ph, pw = sp.shape\n            rr0 = max(0, top)\n            cc0 = max(0, left)\n            rr1 = min(h, top + ph)\n            cc1 = min(w, left + pw)\n            if rr0 >= rr1 or cc0 >= cc1:\n                continue\n            sub_g = g[rr0:rr1, cc0:cc1]\n            sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]\n            m = sub_p != bg\n            if np.any(m):\n                score = int(np.sum(sub_g[m] == sub_p[m]))\n            if score > best_score:\n                best_score = score\n                best_idx = idx\n\n        repl_idx = 1 - best_idx\n\n        # Clear current sprite pixels.\n        for rr, cc in s[\"pts\"]:\n            out[rr, cc] = bg\n\n        # Place replacement.\n        p = protos[repl_idx]\n        sp = _scale_nn(p, scale)\n        panc = _pick_anchor_bbox(p, bg)\n        pr0, pc0, pr1, pc1 = panc\n        pr0 *= scale\n        pc0 *= scale\n        top = (r0 + ar0) - pr0\n        left = (c0 + ac0) - pc0\n\n        ph, pw = sp.shape\n        rr0 = max(0, top)\n        cc0 = max(0, left)\n        rr1 = min(h, top + ph)\n        cc1 = min(w, left + pw)\n        sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]\n        m = sub_p != bg\n        out_slice = out[rr0:rr1, cc0:cc1]\n        out_slice[m] = sub_p[m]\n        out[rr0:rr1, cc0:cc1] = out_slice\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- CFG: canvas ---\nGRID_SIZE_MIN = 18                  # square grid lower bound\nGRID_SIZE_MAX = 28                  # square grid upper bound\nGRID_MARGIN_FOR_SPRITES = 6         # min_n = max_sprite_dim + this\n\n# --- CFG: prototypes ---\nPROTO_SHAPES = [(4, 3), (3, 4), (4, 4)]  # (h, w) choices for label grid\nBG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9] # bg color pool (excludes 1)\nCOLOR_SHARE_PROB = 0.65             # prob that proto_B shares a color with proto_A\n\n# --- CFG: row-mask weights (anchor role vs variable role) ---\n#   each entry: (mask_type, weight)  where mask_type in {\"center\", \"outer\", \"full\"}\nANCHOR_ROW_WEIGHTS = [(\"center\", 0.45), (\"outer\", 0.35), (\"full\", 0.20)]\nVARIABLE_ROW_WEIGHTS = [(\"center\", 0.68), (\"full\", 0.32)]\nOUTER_FIXUP_PROB = 0.7             # when fixing no-edge row, prob of using outer vs full\n\n# --- CFG: sprite instances ---\nSPRITE_COUNTS = [3, 4]             # number of sprite instances per grid\nBIG_SCALES = [2, 3]                # scale factor for the one large sprite\n\n# --- CFG: placement ---\nPLACEMENT_BORDER = 1               # min distance from grid edge\nPLACEMENT_PADDING = 2              # min gap between sprite bboxes\nPLACEMENT_CONNECTIVITY = 8         # connectivity for padding check\n\n# --- CFG: generation retries ---\nMAX_RETRIES = 300\n\n# --- Row-mask patterns indexed by width ---\n_ROW_MASKS = {\n    \"center\": {3: [0, 1, 0], 4: [0, 1, 1, 0]},\n    \"outer\":  {3: [1, 0, 1], 4: [1, 0, 0, 1]},\n    \"full\":   {3: [1, 1, 1], 4: [1, 1, 1, 1]},\n}\n\n\ndef _row_mask(kind: str, w: int) -> list[int]:\n    \"\"\"Return a row occupancy mask of the given kind and width.\"\"\"\n    return list(_ROW_MASKS[kind][w])\n\n\ndef _anchor_bbox(arr: np.ndarray) -> tuple[int, int, int, int]:\n    \"\"\"Bounding box of color-1 (anchor) pixels: (r0, c0, r1, c1).\"\"\"\n    rs, cs = np.where(arr == 1)\n    return int(rs.min()), int(cs.min()), int(rs.max()), int(cs.max())\n\n\ndef _scale(arr: np.ndarray, k: int) -> np.ndarray:\n    \"\"\"Nearest-neighbor upscale by integer factor k.\"\"\"\n    if k == 1:\n        return arr.copy()\n    return np.repeat(np.repeat(arr, k, axis=0), k, axis=1)\n\n\ndef _make_labels() -> np.ndarray:\n    \"\"\"Build an (h, w) label grid with roles 1 (anchor), 2, 3 and bg holes (0).\"\"\"\n    h, w = random.choice(PROTO_SHAPES)\n\n    # Assign row counts per role (each role gets at least 1 row)\n    counts = {1: 1, 2: 1, 3: 1}\n    if h > 3:\n        counts[random.choice([1, 2, 3])] += h - 3\n    roles = []\n    for role in random.sample([1, 2, 3], 3):\n        roles.extend([role] * counts[role])\n\n    # Pick row masks via weighted sampling\n    weights_by_role = {\n        1: ANCHOR_ROW_WEIGHTS,\n        2: VARIABLE_ROW_WEIGHTS,\n        3: VARIABLE_ROW_WEIGHTS,\n    }\n    masks = []\n    for role in roles:\n        entries = weights_by_role[role]\n        kinds, wts = zip(*entries)\n        chosen_kind = random.choices(kinds, weights=wts)[0]\n        masks.append(_row_mask(chosen_kind, w))\n\n    # Fix-up: ensure at least one row touches the left/right edge\n    if not any(mask[0] or mask[-1] for mask in masks):\n        i = random.randrange(h)\n        if roles[i] == 1 and random.random() < OUTER_FIXUP_PROB:\n            masks[i] = _row_mask(\"outer\", w)\n        else:\n            masks[i] = _row_mask(\"full\", w)\n\n    # Fix-up: ensure at least one row has bg holes\n    if all(all(mask) for mask in masks):\n        masks[random.randrange(h)] = _row_mask(\"center\", w)\n\n    # Assemble label grid\n    labels = np.zeros((h, w), dtype=int)\n    for r, (role, mask) in enumerate(zip(roles, masks)):\n        for c, bit in enumerate(mask):\n            if bit:\n                labels[r, c] = role\n    return labels\n\n\ndef _make_prototypes(bg: int) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Create proto_A and proto_B (flipud + recolored) from a shared label grid.\"\"\"\n    labels = _make_labels()\n    pool = [c for c in range(10) if c not in (bg, 1)]\n    a_cols = random.sample(pool, 2)\n    remaining = [c for c in pool if c not in a_cols]\n    if random.random() < COLOR_SHARE_PROB:\n        b_cols = [random.choice(a_cols), random.choice(remaining)]\n        random.shuffle(b_cols)\n    else:\n        b_cols = random.sample(remaining, 2)\n\n    def _colorize(lab: np.ndarray, cols: list[int]) -> np.ndarray:\n        proto = np.full(lab.shape, bg, dtype=int)\n        proto[lab == 1] = 1\n        proto[lab == 2] = cols[0]\n        proto[lab == 3] = cols[1]\n        return proto\n\n    return _colorize(labels, a_cols), _colorize(np.flipud(labels), b_cols)\n\n\ndef _union_bbox(patch_a: np.ndarray, patch_b: np.ndarray) -> tuple[int, int, int, int]:\n    \"\"\"Compute (dr, dc, union_h, union_w) for anchor-aligned placement of two patches.\n\n    dr, dc: offset from the input patch origin to the output patch origin.\n    union_h, union_w: bounding box that encloses both patches when anchor-aligned.\n    \"\"\"\n    oa = _anchor_bbox(patch_a)\n    ia = _anchor_bbox(patch_b)\n    dr = oa[0] - ia[0]\n    dc = oa[1] - ia[1]\n    h, w = patch_a.shape\n    return dr, dc, h + abs(dr), w + abs(dc)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Try once to build a valid grid; returns None on placement failure or oracle mismatch.\"\"\"\n    bg = random.choice(BG_CHOICES)\n    proto_a, proto_b = _make_prototypes(bg)\n    protos = [proto_a, proto_b]\n\n    # Build instance list: 1 of each proto at scale 1, plus 1 at big scale\n    count = random.choice(SPRITE_COUNTS)\n    big_scale = random.choice(BIG_SCALES)\n    instances = [(0, 1), (1, 1), (random.randrange(2), big_scale)]\n    if count == 4:\n        instances.append((random.randrange(2), 1))\n    random.shuffle(instances)\n    instances.sort(key=lambda item: item[1], reverse=True)  # place largest first\n\n    max_dim = max(max(protos[typ].shape) * scale for typ, scale in instances)\n    n = random.randint(max(GRID_SIZE_MIN, max_dim + GRID_MARGIN_FOR_SPRITES), GRID_SIZE_MAX)\n    out = np.full((n, n), bg, dtype=int)\n    inp = np.full((n, n), bg, dtype=int)\n    reserve = np.full((n, n), bg, dtype=int)\n\n    for out_type, scale in instances:\n        output_patch = _scale(protos[out_type], scale)\n        input_patch = _scale(protos[1 - out_type], scale)\n        dr, dc, uh, uw = _union_bbox(output_patch, input_patch)\n        marker = np.full((uh, uw), 1, dtype=int)\n        try:\n            ur, uc = random_free_location(\n                reserve, marker, transparent=bg,\n                border=PLACEMENT_BORDER, padding=PLACEMENT_PADDING,\n                padding_connectivity=PLACEMENT_CONNECTIVITY,\n            )\n        except ValueError:\n            return None\n\n        out_r = ur + max(0, -dr)\n        out_c = uc + max(0, -dc)\n        in_r, in_c = out_r + dr, out_c + dc\n\n        paste(reserve, marker, ur, uc)\n        paste(out, output_patch, out_r, out_c, transparent=bg)\n        paste(inp, input_patch, in_r, in_c, transparent=bg)\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
