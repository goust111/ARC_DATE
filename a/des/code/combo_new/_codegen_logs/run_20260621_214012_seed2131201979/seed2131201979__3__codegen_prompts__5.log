{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -c \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/train/b1986d4b.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _square_objects(g: np.ndarray, bg: int) -> list[dict]:\n    objects = []\n    for obj in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        if h == w and h >= 2 and int(obj[\"area\"]) == h * w:\n            objects.append({\"side\": int(h), \"color\": int(obj[\"color\"]), \"bbox\": obj[\"bbox\"]})\n    return objects\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Render the filled-square object counts as compact nested stacks ordered by count rank.\n\n    Input structure\n    A large noisy grid has a dominant background, scattered non-square noise, and\n    filled monochrome square objects. Each square side length has exactly one\n    object color, and side lengths form consecutive sizes.\n\n    Rule\n    Ignore non-square components. If the lowest square in the scene is of the\n    smallest side length, treat that one smallest square as a distractor and do\n    not count it. For count rank k from left to right, create one block from all\n    square sizes with at least k remaining objects; draw larger squares first and\n    smaller squares over their upper-left corner, then append one background\n    separator column.\n\n    Key insight\n    The output is a count histogram of square side lengths, but each histogram\n    slot is rendered as nested upper-left square masks using the side colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    objects = _square_objects(g, bg)\n    assert objects, \"expected filled square objects\"\n\n    sides = sorted({obj[\"side\"] for obj in objects})\n    assert sides == list(range(sides[0], sides[-1] + 1)), \"expected consecutive square side lengths\"\n\n    by_side = {side: [obj for obj in objects if obj[\"side\"] == side] for side in sides}\n    colors = {}\n    for side, side_objects in by_side.items():\n        side_colors = {obj[\"color\"] for obj in side_objects}\n        assert len(side_colors) == 1, \"each side length should have one color\"\n        colors[side] = side_colors.pop()\n\n    smallest = sides[0]\n    lowest_row = max(obj[\"bbox\"][2] for obj in objects)\n    lowest_smallest = [obj for obj in by_side[smallest] if obj[\"bbox\"][2] == lowest_row]\n    if lowest_smallest:\n        assert len(lowest_smallest) == 1, \"expected at most one lowest smallest distractor\"\n        drop_bbox = lowest_smallest[0][\"bbox\"]\n        by_side[smallest] = [obj for obj in by_side[smallest] if obj[\"bbox\"] != drop_bbox]\n\n    counts = {side: len(side_objects) for side, side_objects in by_side.items()}\n    assert all(count > 0 for count in counts.values()), \"each square size should remain represented\"\n\n    out_h = sides[-1] + 1\n    groups = []\n    for rank in range(max(counts.values())):\n        present_sides = [side for side in sides if counts[side] > rank]\n        assert present_sides, \"rank should contain at least one square size\"\n\n        group_w = max(present_sides)\n        group = np.full((out_h, group_w), bg, dtype=int)\n        for side in sorted(present_sides, reverse=True):\n            group[:side, :side] = colors[side]\n        groups.append(group)\n\n    out_w = sum(group.shape[1] + 1 for group in groups)\n    out = np.full((out_h, out_w), bg, dtype=int)\n    c = 0\n    for group in groups:\n        w = group.shape[1]\n        out[:, c : c + w] = group\n        c += w + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nSIDES = [2, 3, 4]\nALL_COLORS = list(range(10))\n\n# Canvas and object bounds.\nGRID_SIZE_RANGE = (25, 28)\nCOUNT_RANGE = (2, 6)\nSQUARE_GAP = 1\n\n# Noise and distractor controls.\nDISTRACTOR_PROB = 0.5\nNOISE_COUNT_RANGE = (40, 70)\n\n# Retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _choose_palette() -> tuple[int, dict[int, int], int]:\n    \"\"\"Choose one background, three square colors, and one noise color.\"\"\"\n    bg = random.choice(ALL_COLORS)\n    non_bg = [c for c in ALL_COLORS if c != bg]\n    random.shuffle(non_bg)\n    square_colors = {side: non_bg[i] for i, side in enumerate(SIDES)}\n    return bg, square_colors, non_bg[len(SIDES)]\n\n\ndef _make_square_queue(\n    counts: dict[int, int], square_colors: dict[int, int], has_distractor: bool\n) -> tuple[list[tuple[int, int]], tuple[int, int] | None]:\n    \"\"\"Return regular squares plus the separately placed distractor candidate.\"\"\"\n    squares = [(side, square_colors[side]) for side in SIDES for _ in range(counts[side])]\n    if has_distractor:\n        squares.append((SIDES[0], square_colors[SIDES[0]]))\n\n    random.shuffle(squares)\n    if not has_distractor:\n        return squares, None\n    return squares[:-1], squares[-1]\n\n\ndef _free_positions(occupied: np.ndarray, side: int, min_r: int = 0) -> list[tuple[int, int]]:\n    \"\"\"List top-left positions whose padded square footprint is unoccupied.\"\"\"\n    H, W = occupied.shape\n    valid = []\n    for r in range(min_r, H - side + 1):\n        for c in range(0, W - side + 1):\n            r0 = max(0, r - SQUARE_GAP)\n            r1 = min(H, r + side + SQUARE_GAP)\n            c0 = max(0, c - SQUARE_GAP)\n            c1 = min(W, c + side + SQUARE_GAP)\n            if not occupied[r0:r1, c0:c1].any():\n                valid.append((r, c))\n    return valid\n\n\ndef _mark_occupied(occupied: np.ndarray, r: int, c: int, side: int) -> None:\n    H, W = occupied.shape\n    r0 = max(0, r - SQUARE_GAP)\n    r1 = min(H, r + side + SQUARE_GAP)\n    c0 = max(0, c - SQUARE_GAP)\n    c1 = min(W, c + side + SQUARE_GAP)\n    occupied[r0:r1, c0:c1] = True\n\n\ndef _place_square(\n    grid: np.ndarray,\n    occupied: np.ndarray,\n    placed: list[tuple[int, int, int, int]],\n    side: int,\n    color: int,\n    positions: list[tuple[int, int]] | None = None,\n) -> bool:\n    \"\"\"Place one square at a random valid position and update grid state.\"\"\"\n    valid = _free_positions(occupied, side) if positions is None else positions\n    if not valid:\n        return False\n    r, c = random.choice(valid)\n    grid[r:r + side, c:c + side] = color\n    _mark_occupied(occupied, r, c, side)\n    placed.append((r, c, side, color))\n    return True\n\n\ndef _place_squares(\n    grid: np.ndarray,\n    occupied: np.ndarray,\n    regular_squares: list[tuple[int, int]],\n    distractor_sq: tuple[int, int] | None,\n) -> list[tuple[int, int, int, int]] | None:\n    \"\"\"Place all squares, requiring any distractor to sit below the others.\"\"\"\n    placed = []\n\n    random.shuffle(regular_squares)\n    for side, color in regular_squares:\n        if not _place_square(grid, occupied, placed, side, color):\n            return None\n\n    if distractor_sq is None:\n        return placed\n\n    d_side, d_color = distractor_sq\n    current_max_bottom = max(r + side - 1 for r, _, side, _ in placed) if placed else -1\n    min_r = max(0, current_max_bottom - d_side + 2)\n    valid = [\n        (r, c)\n        for r, c in _free_positions(occupied, d_side, min_r=min_r)\n        if r + d_side - 1 > current_max_bottom\n    ]\n    if not _place_square(grid, occupied, placed, d_side, d_color, valid):\n        return None\n    return placed\n\n\ndef _add_noise(grid: np.ndarray, bg: int, noise_color: int) -> bool:\n    \"\"\"Scatter noise onto background cells only.\"\"\"\n    free_cells = list(zip(*np.where(grid == bg)))\n    num_noise = random.randint(*NOISE_COUNT_RANGE)\n    if len(free_cells) < num_noise:\n        return False\n    random.shuffle(free_cells)\n    for r, c in free_cells[:num_noise]:\n        grid[r, c] = noise_color\n    return True\n\n\ndef _would_trigger_unintended_distractor(placed: list[tuple[int, int, int, int]]) -> bool:\n    \"\"\"Detect no-distractor samples where the solver would drop a small square.\"\"\"\n    lowest_row = max(r + side - 1 for r, _, side, _ in placed)\n    return any(side == SIDES[0] and r + side - 1 == lowest_row for r, _, side, _ in placed)\n\n\ndef _render_expected_output(\n    bg: int, counts: dict[int, int], square_colors: dict[int, int]\n) -> np.ndarray:\n    \"\"\"Render the count-derived oracle output used to validate samples.\"\"\"\n    out_h = SIDES[-1] + 1\n    groups = []\n    for rank in range(max(counts.values())):\n        present_sides = [side for side in SIDES if counts[side] > rank]\n        group = np.full((out_h, max(present_sides)), bg, dtype=int)\n        for side in sorted(present_sides, reverse=True):\n            group[:side, :side] = square_colors[side]\n        groups.append(group)\n\n    out_w = sum(group.shape[1] + 1 for group in groups)\n    out = np.full((out_h, out_w), bg, dtype=int)\n    c = 0\n    for group in groups:\n        w = group.shape[1]\n        out[:, c:c + w] = group\n        c += w + 1\n    return out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg, square_colors, noise_color = _choose_palette()\n    counts = {side: random.randint(*COUNT_RANGE) for side in SIDES}\n    has_distractor = random.random() < DISTRACTOR_PROB\n    regular_squares, distractor_sq = _make_square_queue(counts, square_colors, has_distractor)\n\n    H = random.randint(*GRID_SIZE_RANGE)\n    W = random.randint(*GRID_SIZE_RANGE)\n    grid = np.full((H, W), bg, dtype=int)\n    occupied = np.zeros((H, W), dtype=bool)\n\n    placed = _place_squares(grid, occupied, regular_squares, distractor_sq)\n    if placed is None or not _add_noise(grid, bg, noise_color):\n        return None\n\n    if not has_distractor and _would_trigger_unintended_distractor(placed):\n        return None\n\n    expected_out = _render_expected_output(bg, counts, square_colors)\n\n    try:\n        actual_out = main(grid)\n    except Exception:\n        return None\n\n    if not np.array_equal(actual_out, expected_out):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -c \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/58490d8a.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_coords, components_mask, crop_bbox, get_bg, label_mask, paste, random_free_location\nimport random\nfrom functools import lru_cache\nfrom itertools import combinations\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count colored objects and record tallies inside a legend box.\n\n    Input structure:\n    - A black rectangular legend box with key-color pixels in its leftmost non-black column.\n    - Outside the box, distinct objects of each key color are scattered across the grid.\n\n    Rule:\n    - For each key color, count separate same-colored objects outside the legend box.\n    - Output the legend box repainted: each key row gets one dot per object, spaced every other cell rightward from the key pixel.\n\n    Key insight: The legend is both the color index and the output canvas — object counts become dot sequences on the matching row.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    _bg = int(get_bg(g))\n\n    black = 0\n\n    # STEP 1) Find the legend bbox: largest black CC whose bbox contains some non-black pixels.\n    best = None  # (area, bbox)\n    for coords in components_mask(g == int(black), connectivity=8):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if (sub != int(black)).any():\n            area = int(coords.shape[0])\n            cand = (area, tuple(map(int, b)))\n            if best is None or cand[0] > best[0]:\n                best = cand\n\n    assert not (best is None)\n\n    r0, c0, r1, c1 = map(int, best[1])\n    box = crop_bbox(g, (r0, c0, r1, c1))\n    bh, bw = map(int, box.shape)\n\n    # STEP 2) Inside the legend bbox, find the key column:\n    # leftmost column with any non-black pixels (the \"key pixels\").\n    key_col = None\n    for cc in range(bw):\n        if (box[:, int(cc)] != int(black)).any():\n            key_col = int(cc)\n            break\n    if key_col is None:\n        return np.zeros_like(box)\n\n    keys = [(int(rr), int(box[int(rr), int(key_col)])) for rr in range(bh) if int(box[int(rr), int(key_col)]) != int(black)]\n    keys.sort(key=lambda t: int(t[0]))\n\n    outside = np.ones((H, W), dtype=bool)\n    outside[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = False\n    out = np.zeros((bh, bw), dtype=int)\n\n    # STEP 3/4) Count CCs of each key color outside the legend, then draw 1 dot per CC.\n    for rr, col in keys:\n        mask = (g == int(col)) & outside\n        _labc, nc = label_mask(mask, connectivity=8)\n        for i in range(int(nc)):\n            cc = int(key_col + 2 * i)\n            if 0 <= cc < bw:\n                out[int(rr), int(cc)] = int(col)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette and legend color choices.\nCOLOR_POOL = tuple(range(1, 10))\nBLACK = 0\nDISTRACTOR_PROB = 0.5\n\n# Key rows and tally dimensions.\nKEY_COUNT_RANGE = (2, 4)\nTARGET_COUNT_RANGE = (1, 5)\nKEY_ROW_FIRST = 1\nKEY_ROW_STEP = 2\nKEY_COLUMN = 1\nTALLY_COL_STEP = 2\nLEGEND_HEIGHT_TAIL = 1\nLEGEND_WIDTH_TAIL = 1\nLEGEND_SLACK_RANGE = (0, 3)\n\n# Canvas size and legend placement bounds.\nGRID_HEIGHT_RANGE = (20, 25)\nGRID_WIDTH_RANGE = (20, 25)\nLEGEND_EDGE_MARGIN = 2\n\n# Sprite shape and placement constraints.\nSPRITE_AREA_RANGE = (4, 7)\nSPRITE_BBOXES = ((2, 2), (2, 3), (3, 2), (3, 3))\nSPRITE_CONNECTIVITY = 8\nSPRITE_PADDING = 1\nSPRITE_PADDING_CONNECTIVITY = 8\n\n# Retry budget for rejection sampling.\nGENERATION_ATTEMPTS = 300\n\n\ndef _randint(bounds: tuple[int, int]) -> int:\n    \"\"\"Return an inclusive randint from a configured (low, high) pair.\"\"\"\n    return random.randint(bounds[0], bounds[1])\n\n\n@lru_cache(maxsize=None)\ndef _valid_masks(h: int, w: int, area: int) -> tuple[np.ndarray, ...]:\n    \"\"\"Return connected masks that span all four sides of the sprite bbox.\"\"\"\n    masks = []\n    for cells in combinations(range(h * w), area):\n        mask = np.zeros((h, w), dtype=bool)\n        for cell in cells:\n            mask[cell // w, cell % w] = True\n        spans_edges = mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()\n        if not spans_edges:\n            continue\n        _, n = label_mask(mask, connectivity=SPRITE_CONNECTIVITY)\n        if n == 1:\n            masks.append(mask)\n    return tuple(masks)\n\n\ndef _make_sprite(color: int, bg: int) -> np.ndarray:\n    \"\"\"Sample one connected same-color sprite drawn on the background color.\"\"\"\n    area = _randint(SPRITE_AREA_RANGE)\n    dims = []\n    for h, w in SPRITE_BBOXES:\n        if h * w >= area and _valid_masks(h, w, area):\n            dims.append((h, w))\n    h, w = random.choice(dims)\n    mask = random.choice(_valid_masks(h, w, area))\n    sprite = np.full((h, w), int(bg), dtype=int)\n    sprite[mask] = int(color)\n    return sprite\n\n\ndef _sample_palette() -> tuple[int, list[int], int | None]:\n    \"\"\"Choose background, key colors, and optional distractor color.\"\"\"\n    colors = list(COLOR_POOL)\n    bg = random.choice(colors)\n\n    k = _randint(KEY_COUNT_RANGE)\n    remaining = [c for c in colors if c != bg]\n    key_colors = random.sample(remaining, k)\n    remaining = [c for c in remaining if c not in key_colors]\n    distractor_color = random.choice(remaining) if remaining and random.random() < DISTRACTOR_PROB else None\n    return bg, key_colors, distractor_color\n\n\ndef _sample_counts(k: int) -> list[int]:\n    \"\"\"Sample the target outside-component count for each key color.\"\"\"\n    return [_randint(TARGET_COUNT_RANGE) for _ in range(k)]\n\n\ndef _legend_shape(k: int, max_count: int) -> tuple[int, int]:\n    \"\"\"Return legend height and width for the key count and largest tally.\"\"\"\n    bh = KEY_ROW_STEP * k + LEGEND_HEIGHT_TAIL\n    bw = TALLY_COL_STEP * max_count + LEGEND_WIDTH_TAIL + _randint(LEGEND_SLACK_RANGE)\n    return bh, bw\n\n\ndef _key_row(i: int) -> int:\n    \"\"\"Map a zero-based key index to its row inside the legend/output box.\"\"\"\n    return KEY_ROW_FIRST + KEY_ROW_STEP * i\n\n\ndef _build_expected(key_colors: list[int], counts: list[int]) -> np.ndarray:\n    \"\"\"Render the black output tally canvas implied by key colors and counts.\"\"\"\n    max_count = max(counts)\n    bh, bw = _legend_shape(len(key_colors), max_count)\n\n    expected = np.full((bh, bw), BLACK, dtype=int)\n    for i, (color, count) in enumerate(zip(key_colors, counts)):\n        rr = _key_row(i)\n        for j in range(count):\n            expected[rr, KEY_COLUMN + TALLY_COL_STEP * j] = int(color)\n    return expected\n\n\ndef _build_legend(shape: tuple[int, int], key_colors: list[int]) -> np.ndarray:\n    \"\"\"Return a black legend patch with only the key-column pixels filled.\"\"\"\n    legend = np.full(shape, BLACK, dtype=int)\n    for i, color in enumerate(key_colors):\n        legend[_key_row(i), KEY_COLUMN] = int(color)\n    return legend\n\n\ndef _new_grid_with_legend(bg: int, legend: np.ndarray) -> np.ndarray | None:\n    \"\"\"Sample a grid and paste the legend away from all canvas edges.\"\"\"\n    bh, bw = map(int, legend.shape)\n    H = _randint(GRID_HEIGHT_RANGE)\n    W = _randint(GRID_WIDTH_RANGE)\n    min_h = bh + 2 * LEGEND_EDGE_MARGIN\n    min_w = bw + 2 * LEGEND_EDGE_MARGIN\n    if H < min_h or W < min_w:\n        return None\n\n    grid = np.full((H, W), int(bg), dtype=int)\n    r0 = random.randint(LEGEND_EDGE_MARGIN, H - bh - LEGEND_EDGE_MARGIN)\n    c0 = random.randint(LEGEND_EDGE_MARGIN, W - bw - LEGEND_EDGE_MARGIN)\n    paste(grid, legend, r0, c0)\n    return grid\n\n\ndef _build_sprite_queue(\n    key_colors: list[int],\n    counts: list[int],\n    distractor_color: int | None,\n    bg: int,\n) -> list[np.ndarray]:\n    \"\"\"Create canonical key sprites, optional distractor sprite, and shuffle them.\"\"\"\n    sprites = []\n    for color, count in zip(key_colors, counts):\n        sprite = _make_sprite(color, bg)\n        for _ in range(count):\n            sprites.append(sprite.copy())\n    if distractor_color is not None:\n        sprites.append(_make_sprite(distractor_color, bg))\n    random.shuffle(sprites)\n    return sprites\n\n\ndef _place_sprites(grid: np.ndarray, sprites: list[np.ndarray], bg: int) -> None:\n    \"\"\"Paste sprites into random non-touching free locations in queue order.\"\"\"\n    for sprite in sprites:\n        sr, sc = random_free_location(\n            grid,\n            sprite,\n            transparent=bg,\n            padding=SPRITE_PADDING,\n            padding_connectivity=SPRITE_PADDING_CONNECTIVITY,\n        )\n        paste(grid, sprite, sr, sc, transparent=bg)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Run one output-first generation attempt and reject solver mismatches.\"\"\"\n    bg, key_colors, distractor_color = _sample_palette()\n    counts = _sample_counts(len(key_colors))\n    expected = _build_expected(key_colors, counts)\n    legend = _build_legend(expected.shape, key_colors)\n    grid = _new_grid_with_legend(bg, legend)\n    if grid is None:\n        return None\n\n    sprites = _build_sprite_queue(key_colors, counts, distractor_color, bg)\n    try:\n        _place_sprites(grid, sprites, bg)\n    except ValueError:\n        return None\n\n    if not np.array_equal(main(grid), expected):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/6d1d5c90.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import Color\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Remove the left control column and roll the remaining image downward by the red marker's row.\n\n    Input structure\n    - The input is a rectangular grid with a one-cell-wide control column on the left.\n    - That control column is all pink except for exactly one red marker pixel.\n    - The columns to the right are the image that remains in the output.\n\n    Rule\n    - Delete the left control column.\n    - Let r be the row index of the red marker in that column.\n    - Cyclically shift the remaining image downward by r rows.\n\n    Key insight\n    - The red marker's vertical position encodes the row-roll amount; the pink\n      column is only a control strip and is removed after reading it.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 1\n\n    control = g[:, 0]\n    marker_rows = np.where(control == Color.RED)[0]\n    assert marker_rows.size == 1\n    assert np.all((control == Color.PINK) | (control == Color.RED))\n    assert np.count_nonzero(control == Color.PINK) == h - 1\n\n    shift = int(marker_rows[0])\n    return np.roll(g[:, 1:], shift=shift, axis=0)\n\n# --------------- generator (att2) ---------------\n\n# Canvas/image bounds.\nIMAGE_HEIGHT_RANGE = (5, 8)\nIMAGE_WIDTH_RANGE = (5, 8)\nMAX_IMAGE_CELLS = 54\n# Color balancing.\nCOLOR_PALETTE = [Color.BLUE, Color.GREEN, Color.YELLOW, Color.GREY, Color.TEAL, Color.MAROON]\nCOLOR_COUNT = 6\nCELLS_PER_COLOR_RANGE = (4, 9)\n# Layout sampling.\nPATH_MODES = [\"row_snake\", \"col_snake\", \"row_runs\", \"col_runs\", \"diagonal\"]\nORIENTATION_CHOICES = [False, True]\n# Control strip and retry behavior.\nCONTROL_FILL_COLOR = Color.PINK\nCONTROL_MARKER_COLOR = Color.RED\nGENERATION_RETRIES = 300\n\n\ndef _bounded_counts(total: int) -> list[int]:\n    counts = []\n    remaining = total\n    lo, hi = CELLS_PER_COLOR_RANGE\n    for i in range(COLOR_COUNT):\n        left = COLOR_COUNT - i - 1\n        low = max(lo, remaining - left * hi)\n        high = min(hi, remaining - left * lo)\n        value = random.randint(low, high)\n        counts.append(value)\n        remaining -= value\n    random.shuffle(counts)\n    return counts\n\n\ndef _cell_path(h: int, w: int) -> list[tuple[int, int]]:\n    mode = random.choice(PATH_MODES)\n    if mode == \"row_snake\":\n        path = [(r, c) for r in range(h) for c in (range(w) if r % 2 == 0 else range(w - 1, -1, -1))]\n    elif mode == \"col_snake\":\n        path = [(r, c) for c in range(w) for r in (range(h) if c % 2 == 0 else range(h - 1, -1, -1))]\n    elif mode == \"row_runs\":\n        path = [(r, c) for r in range(h) for c in range(w)]\n    elif mode == \"col_runs\":\n        path = [(r, c) for c in range(w) for r in range(h)]\n    else:\n        path = []\n        for diag in range(h + w - 1):\n            cells = [(r, diag - r) for r in range(h) if 0 <= diag - r < w]\n            if diag % 2:\n                cells.reverse()\n            path.extend(cells)\n\n    if random.choice(ORIENTATION_CHOICES):\n        path = [(h - 1 - r, c) for r, c in path]\n    if random.choice(ORIENTATION_CHOICES):\n        path = [(r, w - 1 - c) for r, c in path]\n    if random.choice(ORIENTATION_CHOICES):\n        path.reverse()\n    return path\n\n\ndef _make_image(h: int, w: int) -> np.ndarray:\n    counts = _bounded_counts(h * w)\n    colors = COLOR_PALETTE[:]\n    random.shuffle(colors)\n    image = np.empty((h, w), dtype=int)\n    path = _cell_path(h, w)\n    idx = 0\n    for color, count in zip(colors, counts):\n        for r, c in path[idx : idx + count]:\n            image[r, c] = color\n        idx += count\n    return image\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    h = random.randint(*IMAGE_HEIGHT_RANGE)\n    iw = random.choice([w for w in range(IMAGE_WIDTH_RANGE[0], IMAGE_WIDTH_RANGE[1] + 1) if h * w <= MAX_IMAGE_CELLS])\n    image = _make_image(h, iw)\n\n    shift = random.randrange(h)\n    grid = np.empty((h, iw + 1), dtype=int)\n    grid[:, 0] = CONTROL_FILL_COLOR\n    grid[shift, 0] = CONTROL_MARKER_COLOR\n    grid[:, 1:] = image\n\n    expected = np.roll(image, shift=shift, axis=0)\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/train/652646ff.py\"","aggregated_output":"from __future__ import annotations\n\nimport random\n\nimport numpy as np\n\nfrom arc_utils import get_bg\n\n\n_RING: tuple[tuple[int, int], ...] = (\n    (0, 2),\n    (0, 3),\n    (1, 1),\n    (1, 4),\n    (2, 0),\n    (2, 5),\n    (3, 0),\n    (3, 5),\n    (4, 1),\n    (4, 4),\n    (5, 2),\n    (5, 3),\n)\n_RING_SIZE = 6\n_MIN_VISIBLE_RING_PIXELS = 8\n\n\ndef _matching_ring_offsets(coords: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    offset_counts: dict[tuple[int, int], int] = {}\n    for r, c in coords:\n        for dr, dc in _RING:\n            offset = (r - dr, c - dc)\n            offset_counts[offset] = offset_counts.get(offset, 0) + 1\n    return [offset for offset, count in offset_counts.items() if count == len(coords)]\n\n\ndef _find_ring_fragments(g: np.ndarray, bg: int) -> dict[int, tuple[tuple[int, int], set[tuple[int, int]]]]:\n    fragments: dict[int, tuple[tuple[int, int], set[tuple[int, int]]]] = {}\n    for color in np.unique(g):\n        color = int(color)\n        if color == bg:\n            continue\n        coords = [tuple(map(int, coord)) for coord in np.argwhere(g == color)]\n        if len(coords) < _MIN_VISIBLE_RING_PIXELS:\n            continue\n        offsets = _matching_ring_offsets(coords)\n        assert len(offsets) == 1, \"each substantial foreground color must be one ring fragment\"\n        fragments[color] = (offsets[0], set(coords))\n    assert fragments, \"expected at least one ring fragment\"\n    return fragments\n\n\ndef _layer_order(g: np.ndarray, fragments: dict[int, tuple[tuple[int, int], set[tuple[int, int]]]]) -> list[int]:\n    h, w = g.shape\n    ring_colors = set(fragments)\n    above_to_below = {color: set() for color in ring_colors}\n    indegree = {color: 0 for color in ring_colors}\n\n    for color, ((r0, c0), visible) in fragments.items():\n        expected = {(r0 + dr, c0 + dc) for dr, dc in _RING}\n        for r, c in expected - visible:\n            if not (0 <= r < h and 0 <= c < w):\n                continue\n            cover_color = int(g[r, c])\n            assert cover_color in ring_colors, \"hidden ring pixels must be covered by another ring\"\n            if color not in above_to_below[cover_color]:\n                above_to_below[cover_color].add(color)\n                indegree[color] += 1\n\n    order: list[int] = []\n    remaining = set(ring_colors)\n    while remaining:\n        top = [color for color in remaining if indegree[color] == 0]\n        assert len(top) == 1, \"ring occlusion must determine a unique top-to-bottom order\"\n        color = top[0]\n        order.append(color)\n        remaining.remove(color)\n        for below in above_to_below[color]:\n            indegree[below] -= 1\n    return order\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recover each partially hidden 6x6 ring sprite and stack complete copies from top layer to bottom layer.\n\n    Input structure:\n    - The dominant color is the background.\n    - Several non-background colors are visible fragments of the same 12-pixel\n      outline ring in a 6x6 box; small off-template marker pixels are noise.\n    - Ring fragments overlap, so upper rings replace some expected pixels of\n      lower rings, and a ring may also be clipped by the input boundary.\n\n    Rule:\n    - Identify every substantial color whose pixels all lie on one translated\n      copy of the ring template.\n    - For each missing in-bounds template pixel, the color currently occupying\n      that pixel is above the hidden ring.\n    - Topologically sort these occlusion relations from top to bottom, then draw\n      one complete 6x6 ring for each color in that order on a background canvas.\n\n    Key insight:\n    - The output is not a crop of the scene; it is the layer stack of complete\n      ring sprites reconstructed from their visible fragments.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fragments = _find_ring_fragments(g, bg)\n    order = _layer_order(g, fragments)\n\n    out = np.full((_RING_SIZE * len(order), _RING_SIZE), bg, dtype=int)\n    for i, color in enumerate(order):\n        base_r = i * _RING_SIZE\n        for dr, dc in _RING:\n            out[base_r + dr, dc] = color\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Ring template shared by rendering, validation, and output stacking.\n_GEN_RING: tuple[tuple[int, int], ...] = (\n    (0, 2),\n    (0, 3),\n    (1, 1),\n    (1, 4),\n    (2, 0),\n    (2, 5),\n    (3, 0),\n    (3, 5),\n    (4, 1),\n    (4, 4),\n    (5, 2),\n    (5, 3),\n)\n_GEN_RING_SIZE = 6\n\n# Scene size and structural counts.\n_GEN_GRID_SIZE_RANGE = (10, 20)\n_GEN_RING_COUNT_RANGE = (2, 4)\n_GEN_VISIBLE_PIXELS_RANGE = (8, 11)\n_GEN_COLORS = tuple(range(10))\n\n# Noise colors are isolated marker pixels on background cells.\n_GEN_NOISE_COLOR_COUNT_RANGE = (1, 2)\n_GEN_NOISE_PIXELS_PER_COLOR_RANGE = (2, 5)\n_GEN_NOISE_CLEARANCE = 1\n\n# Retry budget for rejection sampling a solver-consistent input.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _ring_cells(offset: tuple[int, int], n: int) -> set[tuple[int, int]]:\n    r0, c0 = offset\n    return {\n        (r0 + dr, c0 + dc)\n        for dr, dc in _GEN_RING\n        if 0 <= r0 + dr < n and 0 <= c0 + dc < n\n    }\n\n\ndef _gen_matching_ring_offsets(coords: set[tuple[int, int]]) -> list[tuple[int, int]]:\n    offset_counts: dict[tuple[int, int], int] = {}\n    for r, c in coords:\n        for dr, dc in _GEN_RING:\n            offset = (r - dr, c - dc)\n            offset_counts[offset] = offset_counts.get(offset, 0) + 1\n    return [offset for offset, count in offset_counts.items() if count == len(coords)]\n\n\ndef _has_unique_offset(coords: set[tuple[int, int]], offset: tuple[int, int]) -> bool:\n    return _gen_matching_ring_offsets(coords) == [offset]\n\n\ndef _stack_output(bg: int, colors: list[int]) -> np.ndarray:\n    out = np.full((_GEN_RING_SIZE * len(colors), _GEN_RING_SIZE), bg, dtype=int)\n    for i, color in enumerate(colors):\n        for dr, dc in _GEN_RING:\n            out[i * _GEN_RING_SIZE + dr, dc] = color\n    return out\n\n\ndef _render_scene(n: int, bg: int, colors: list[int], offsets: list[tuple[int, int]]) -> np.ndarray:\n    grid = np.full((n, n), bg, dtype=int)\n    for color, offset in reversed(list(zip(colors, offsets))):\n        for r, c in _ring_cells(offset, n):\n            grid[r, c] = color\n    return grid\n\n\ndef _choose_noise_cells(candidates: list[tuple[int, int]], count: int) -> list[tuple[int, int]] | None:\n    random.shuffle(candidates)\n    picked: list[tuple[int, int]] = []\n    for cell in candidates:\n        r, c = cell\n        if all(max(abs(r - pr), abs(c - pc)) > _GEN_NOISE_CLEARANCE for pr, pc in picked):\n            picked.append(cell)\n            if len(picked) == count:\n                return picked\n    return None\n\n\ndef _add_noise(grid: np.ndarray, bg: int, ring_colors: list[int], offsets: list[tuple[int, int]]) -> bool:\n    n = grid.shape[0]\n    occupied_ring_cells: set[tuple[int, int]] = set()\n    for offset in offsets:\n        occupied_ring_cells |= _ring_cells(offset, n)\n\n    available = [\n        (r, c)\n        for r in range(n)\n        for c in range(n)\n        if grid[r, c] == bg and (r, c) not in occupied_ring_cells\n    ]\n    noise_colors = random.sample(\n        [color for color in _GEN_COLORS if color != bg and color not in ring_colors],\n        random.randint(*_GEN_NOISE_COLOR_COUNT_RANGE),\n    )\n\n    for color in noise_colors:\n        count = random.randint(*_GEN_NOISE_PIXELS_PER_COLOR_RANGE)\n        cells = _choose_noise_cells(available[:], count)\n        if cells is None:\n            return False\n        for r, c in cells:\n            grid[r, c] = color\n        chosen = set(cells)\n        available = [\n            (r, c)\n            for r, c in available\n            if (r, c) not in chosen\n            and all(max(abs(r - pr), abs(c - pc)) > _GEN_NOISE_CLEARANCE for pr, pc in chosen)\n        ]\n    return True\n\n\ndef _candidate_offsets(\n    n: int,\n    max_offset: int,\n    offsets: list[tuple[int, int]],\n    higher_cells: list[set[tuple[int, int]]],\n) -> list[tuple[int, int]]:\n    \"\"\"Return valid next-ring offsets against the already placed higher layers.\"\"\"\n    covered_by_higher = set().union(*higher_cells)\n    covered_before_prev = set().union(*higher_cells[:-1]) if len(higher_cells) > 1 else set()\n    visible_prev = higher_cells[-1] - covered_before_prev\n    candidates: list[tuple[int, int]] = []\n\n    for r0 in range(max_offset + 1):\n        for c0 in range(max_offset + 1):\n            offset = (r0, c0)\n            if offset in offsets:\n                continue\n            cells = _ring_cells(offset, n)\n            visible = cells - covered_by_higher\n            if not _GEN_VISIBLE_PIXELS_RANGE[0] <= len(visible) <= _GEN_VISIBLE_PIXELS_RANGE[1]:\n                continue\n            if not cells & visible_prev:\n                continue\n            if not _has_unique_offset(visible, offset):\n                continue\n            candidates.append(offset)\n    return candidates\n\n\ndef _build_layer_offsets(n: int, ring_count: int) -> list[tuple[int, int]] | None:\n    \"\"\"Place top-to-bottom rings so each lower ring overlaps the visible chain.\"\"\"\n    max_offset = n - _GEN_RING_SIZE\n    offsets = [(random.randint(0, max_offset), random.randint(0, max_offset))]\n    higher_cells = [_ring_cells(offsets[0], n)]\n\n    for _ in range(1, ring_count):\n        candidates = _candidate_offsets(n, max_offset, offsets, higher_cells)\n        if not candidates:\n            return None\n        offset = random.choice(candidates)\n        offsets.append(offset)\n        higher_cells.append(_ring_cells(offset, n))\n    return offsets\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    ring_count = random.randint(*_GEN_RING_COUNT_RANGE)\n    bg = random.randrange(len(_GEN_COLORS))\n    ring_colors = random.sample([color for color in _GEN_COLORS if color != bg], ring_count)\n    n = random.randint(*_GEN_GRID_SIZE_RANGE)\n    expected_output = _stack_output(bg, ring_colors)\n\n    offsets = _build_layer_offsets(n, ring_count)\n    if offsets is None:\n        return None\n\n    grid = _render_scene(n, bg, ring_colors, offsets)\n    if not _add_noise(grid, bg, ring_colors, offsets):\n        return None\n\n    try:\n        if not np.array_equal(main(grid), expected_output):\n            return None\n    except Exception:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 652646ff input\")\n","exit_code":0,"status":"completed"}}
