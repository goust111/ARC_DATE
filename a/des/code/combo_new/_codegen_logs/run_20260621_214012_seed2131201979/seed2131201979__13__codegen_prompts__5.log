{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py && printf '\\\\n=====SPLIT=====\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py && printf '\\\\n=====FILE=====\\\\n' && sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py && printf '\\\\n=====SPLIT=====\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\ndef _get_enclosed_holes(sprite):\n    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n    h, w = sprite.shape\n    return [pts for pts in components_mask(~sprite, connectivity=4)\n            if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n\n\ndef _make_diamond():\n    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n    s = np.zeros((3, 3), dtype=bool)\n    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n    return s\n\n\ndef _make_hollow_sprite(h, w, rng):\n    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n    sprite = np.ones((h, w), dtype=bool)\n    if h >= 3 and w >= 3:\n        sprite[1:-1, 1:-1] = False\n    # Optionally add internal horizontal wall\n    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n        br = rng.randint(2, h - 2)\n        n = rng.randint(1, w - 2)\n        s = rng.randint(1, w - 1 - n + 1)\n        sprite[br, s:s + n] = True\n    # Optionally add internal vertical wall\n    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n        bc = rng.randint(2, w - 2)\n        n = rng.randint(1, h - 2)\n        s = rng.randint(1, h - 1 - n + 1)\n        sprite[s:s + n, bc] = True\n    # Optionally remove border cells for irregularity\n    if rng.random() < _P_BORDER_REMOVAL:\n        bcells = [(r, c) for r in range(h) for c in range(w)\n                  if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n        rng.shuffle(bcells)\n        for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n            test = sprite.copy()\n            test[cr, cc] = False\n            if _get_enclosed_holes(test):\n                sprite = test\n    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n        return None\n    return sprite\n\n\ndef _choose_colors(rng, N, num_filled):\n    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n    all_c = list(range(1, 10))\n    rng.shuffle(all_c)\n    border_keys = all_c[:N]\n    rng.shuffle(all_c)\n    fill_values = all_c[:N]\n    dist_cands = [c for c in range(1, 10) if c not in border_keys]\n    distractor_color = rng.choice(dist_cands)\n    mapping = dict(zip(border_keys, fill_values))\n    filled_keys = rng.sample(border_keys, num_filled)\n    return border_keys, fill_values, distractor_color, mapping, filled_keys\n\n\ndef _build_palette(side, border_keys, fill_values):\n    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n    N = len(border_keys)\n    if side in ('top', 'bottom'):\n        pal = np.zeros((2, N), dtype=int)\n        outer, inner = (0, 1) if side == 'top' else (1, 0)\n        pal[outer] = border_keys\n        pal[inner] = fill_values\n    else:\n        pal = np.zeros((N, 2), dtype=int)\n        outer, inner = (0, 1) if side == 'left' else (1, 0)\n        pal[:, outer] = border_keys\n        pal[:, inner] = fill_values\n    return pal\n\n\ndef _place_palette(grid, occ, pal, side, rng):\n    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n    H, W = grid.shape\n    pal_h, pal_w = pal.shape\n    if side == 'top':\n        pr0, pc0 = 0, rng.randint(0, W - pal_w)\n    elif side == 'bottom':\n        pr0, pc0 = H - pal_h, rng.randint(0, W - pal_w)\n    elif side == 'left':\n        pr0, pc0 = rng.randint(0, H - pal_h), 0\n    else:\n        pr0, pc0 = rng.randint(0, H - pal_h), W - pal_w\n    grid[pr0:pr0 + pal_h, pc0:pc0 + pal_w] = pal\n    occ[max(0, pr0 - 1):min(H, pr0 + pal_h + 1),\n        max(0, pc0 - 1):min(W, pc0 + pal_w + 1)] = True\n\n\ndef _find_valid_positions(H, W, occ, mask, holes):\n    \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n    sh, sw = mask.shape\n    positions = []\n    for r0 in range(H - sh + 1):\n        for c0 in range(W - sw + 1):\n            if occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n                   max(0, c0 - 1):min(W, c0 + sw + 1)].any():\n                continue\n            if any(r0 + hr == 0 or c0 + hc == 0 or r0 + hr == H - 1 or c0 + hc == W - 1\n                   for hpts in holes for hr, hc in hpts):\n                continue\n            positions.append((r0, c0))\n    return positions\n\n\ndef _paint_sprite(grid, r0, c0, mask, color, fill, holes):\n    \"\"\"Render a sprite onto the grid: border cells in color, hole cells in fill (if given).\"\"\"\n    grid[r0:r0 + mask.shape[0], c0:c0 + mask.shape[1]][mask] = color\n    if fill is not None:\n        for hpts in holes:\n            for hr, hc in hpts:\n                grid[r0 + hr, c0 + hc] = fill\n\n\ndef _gen_attempt():\n    rng = random.Random()\n    bg = 0\n\n    # Grid size and palette side\n    H = rng.randint(_GRID_H_MIN, _GRID_H_MAX)\n    W = rng.randint(_GRID_W_MIN, _GRID_W_MAX)\n    side = rng.choice(['top', 'bottom', 'left', 'right'])\n    if H <= _SMALL_H_THRESHOLD and side in ('top', 'bottom') and rng.random() < _SMALL_H_PALETTE_FLIP:\n        side = rng.choice(['left', 'right'])\n\n    max_N = H if side in ('left', 'right') else W\n    N = rng.randint(_PALETTE_N_MIN, min(_PALETTE_N_MAX, max_N))\n\n    # Sprite dimension bounds\n    max_sh = min(_SPRITE_H_MAX, H)\n    max_sw = min(_SPRITE_W_MAX, W)\n    if H <= _TINY_H_THRESHOLD:\n        max_sh = 3\n\n    # Sprite counts\n    num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, N))\n    total_sprites = num_filled + 1\n\n    # Generate sprite shapes\n    shapes = []\n    for _ in range(total_sprites):\n        sh = rng.randint(3, max_sh)\n        sw = rng.randint(3, max_sw)\n        if sh + sw > _SPRITE_DIM_SUM_CAP:\n            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)\n        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:\n            mask = _make_diamond()\n        else:\n            mask = _make_hollow_sprite(sh, sw, rng)\n        if mask is None:\n            return None\n        shapes.append(mask)\n\n    # Colors and palette\n    border_keys, fill_values, distractor_color, mapping, filled_keys = \\\n        _choose_colors(rng, N, num_filled)\n    pal = _build_palette(side, border_keys, fill_values)\n\n    grid = np.full((H, W), bg, dtype=int)\n    occ = np.zeros((H, W), dtype=bool)\n    _place_palette(grid, occ, pal, side, rng)\n\n    # Assign colors to sprites: filled sprites use palette keys, last one is distractor\n    infos = []\n    for i, mask in enumerate(shapes):\n        if i < num_filled:\n            c, f = filled_keys[i], mapping[filled_keys[i]]\n        else:\n            c, f = distractor_color, None\n        infos.append((mask, c, f))\n\n    # Place sprites\n    placed = []\n    for mask, color, fill in infos:\n        holes = _get_enclosed_holes(mask)\n        positions = _find_valid_positions(H, W, occ, mask, holes)\n        if not positions:\n            return None\n        r0, c0 = rng.choice(positions)\n        _paint_sprite(grid, r0, c0, mask, color, fill, holes)\n        placed.append((r0, c0, mask, fill))\n        sh, sw = mask.shape\n        occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n            max(0, c0 - 1):min(W, c0 + sw + 1)] = True\n\n    # Derive input from output by clearing filled holes\n    output = grid.copy()\n    inp = grid.copy()\n    for r0, c0, mask, fill in placed:\n        if fill is not None:\n            for hpts in _get_enclosed_holes(mask):\n                for hr, hc in hpts:\n                    inp[r0 + hr, c0 + hc] = bg\n\n    # Validate bg is dominant on border\n    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    if int(vals[cnts.argmax()]) != bg:\n        return None\n\n    # Oracle check\n    try:\n        if np.array_equal(main(inp), output):\n            return inp\n    except Exception:\n        pass\n    return None\n\n\ndef generate_input():\n\n=====SPLIT=====\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\n=====FILE=====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n                frontier.append((rr, cc))\n    return frontier\n\n\ndef _grow_body(area):\n    choices = [\n        (h, w)\n        for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n        for w in _inclusive_range(_BODY_WIDTH_RANGE)\n        if h * w >= area\n    ]\n    h, w = random.choice(choices)\n    cells = set(random.choice(_GROW_BODY_SEEDS))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, h, w)\n        if not frontier:\n            return _grow_body(area)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n\n\ndef _symmetric_body(area):\n    choices = []\n    for height in _inclusive_range(_BODY_HEIGHT_RANGE):\n        extra = area - height\n        if extra >= 2 and extra % 2 == 0 and extra // 2 <= height:\n            choices.append((height, extra // 2))\n    if not choices:\n        return _grow_body(area)\n\n    height, pair_count = random.choice(choices)\n    cells = {(r, 1) for r in range(height)}\n    rows = list(range(height))\n    random.shuffle(rows)\n    for r in rows[:pair_count]:\n        cells.add((r, 0))\n        cells.add((r, 2))\n\n    if height >= _SYMMETRIC_TRANSPOSE_MIN_HEIGHT and random.random() < _SYMMETRIC_TRANSPOSE_PROB:\n        cells = {(c, r) for r, c in cells}\n    return _flip(cells)\n\n\ndef _wide_body(area):\n    width = random.randint(_BODY_WIDTH_RANGE[0], min(_BODY_WIDTH_RANGE[1], area - 1))\n    height = random.choice([h for h in _inclusive_range(_BODY_HEIGHT_RANGE) if h * width >= area])\n    cells = {(0, c) for c in range(width)}\n    cells.add((1, random.randrange(width)))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, height, width)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n\n\ndef _frame_body(area):\n    choices = []\n    for h in _inclusive_range(_FRAME_HEIGHT_RANGE):\n        for w in _inclusive_range(_FRAME_WIDTH_RANGE):\n            perim = 2 * h + 2 * w - 4\n            removable = 2 * max(0, h - 2) + 2 * max(0, w - 2)\n            if perim >= area and perim - area <= min(_FRAME_MAX_GAP, removable):\n                choices.append((h, w))\n    if not choices:\n        return _grow_body(area)\n\n    h, w = random.choice(choices)\n    cells = {\n        (r, c)\n        for r in range(h)\n        for c in range(w)\n        if r in (0, h - 1) or c in (0, w - 1)\n    }\n    gap = len(cells) - area\n    if gap:\n        removable = [\n            (r, c)\n            for r, c in cells\n            if not (r in (0, h - 1) and c in (0, w - 1))\n        ]\n        for cell in random.sample(removable, gap):\n            cells.remove(cell)\n    return _flip(cells)\n\n\ndef _make_body(area):\n    x = random.random()\n    if area >= _FRAME_MIN_AREA and x < _FRAME_BODY_THRESHOLD:\n        return _frame_body(area)\n    if x < _WIDE_BODY_THRESHOLD:\n        return _wide_body(area)\n    if x < _SYMMETRIC_BODY_THRESHOLD:\n        return _symmetric_body(area)\n    return _grow_body(area)\n\n\ndef _marker_cell(body):\n    r0, c0, r1, c1 = _bbox(body)\n    interior, exterior = set(), set()\n    for r, c in body:\n        for dr, dc in _NEIGHBORS4:\n            p = (r + dr, c + dc)\n            if p in body:\n                continue\n            if r0 <= p[0] <= r1 and c0 <= p[1] <= c1:\n                interior.add(p)\n            else:\n                exterior.add(p)\n    pool = list(interior if interior and random.random() < _MARKER_INTERIOR_PROB else (exterior | interior))\n    return random.choice(pool)\n\n\ndef _make_sprite(area, body_color, marker_color, bg):\n    body = _make_body(area)\n    marker = _marker_cell(body)\n    all_cells = set(body) | {marker}\n    r0, c0, r1, c1 = _bbox(all_cells)\n    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)\n    for r, c in body:\n        patch[r - r0, c - c0] = int(body_color)\n    patch[marker[0] - r0, marker[1] - c0] = int(marker_color)\n    return {\"patch\": patch, \"offset\": (marker[0] - r0, marker[1] - c0)}\n\n\ndef _top_left(sprite, marker_r, marker_c):\n    off_r, off_c = sprite[\"offset\"]\n    return int(marker_r) - int(off_r), int(marker_c) - int(off_c)\n\n\ndef _can_place(canvas, sprite, marker_r, marker_c, bg):\n    patch = sprite[\"patch\"]\n    top, left = _top_left(sprite, marker_r, marker_c)\n    h, w = patch.shape\n    H, W = canvas.shape\n    if top < _INNER_BORDER_GAP or left < _INNER_BORDER_GAP:\n        return False\n    if top + h > H - _INNER_BORDER_GAP or left + w > W - _INNER_BORDER_GAP:\n        return False\n    mask = patch != int(bg)\n    view = canvas[top : top + h, left : left + w]\n    if bool((view[mask] != int(bg)).any()):\n        return False\n    return not _touches_foreground(canvas, mask, top, left, bg)\n\n\ndef _touches_foreground(canvas, mask, top, left, bg):\n    \"\"\"Return True if any patch cell has a non-bg 8-neighbor on canvas.\"\"\"\n    h, w = mask.shape\n    radius = _ISOLATION_RADIUS\n    occupied = canvas[top - radius : top + h + radius, left - radius : left + w + radius] != int(bg)\n    touch_zone = np.zeros((h + 2 * radius, w + 2 * radius), dtype=bool)\n    span = 2 * radius + 1\n    for dr in range(span):\n        for dc in range(span):\n            touch_zone[dr : dr + h, dc : dc + w] |= mask\n    return bool((occupied & touch_zone).any())\n\n\ndef _place(canvas, sprite, marker_r, marker_c, bg):\n    top, left = _top_left(sprite, marker_r, marker_c)\n    paste(canvas, sprite[\"patch\"], top, left, transparent=int(bg))\n\n\ndef _anchor_ok(canvas, r, c, bg):\n    H, W = canvas.shape\n    if not (r in (0, H - 1) or c in (0, W - 1)):\n        return False\n    if r in (0, H - 1) and c in (0, W - 1):\n        return False\n    return _isolated_bg_cell(canvas, r, c, bg)\n\n\ndef _isolated_bg_cell(canvas, r, c, bg):\n    \"\"\"Return True when a cell and its in-bounds 8-neighborhood are bg.\"\"\"\n    H, W = canvas.shape\n    radius = _ISOLATION_RADIUS\n    r0, r1 = max(0, r - radius), min(H, r + radius + 1)\n    c0, c1 = max(0, c - radius), min(W, c + radius + 1)\n    return not bool((canvas[r0:r1, c0:c1] != int(bg)).any())\n\n\ndef _anchor_candidates(canvas, bg):\n    H, W = canvas.shape\n    rows = list(range(_ANCHOR_EDGE_MARGIN, H - _ANCHOR_EDGE_MARGIN))\n    rows = rows or list(range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP))\n    cols = list(range(_ANCHOR_EDGE_MARGIN, W - _ANCHOR_EDGE_MARGIN))\n    cols = cols or list(range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP))\n    out = []\n    for c in cols:\n        out.append((\"h\", 0, c))\n        out.append((\"h\", H - 1, c))\n    for r in rows:\n        out.append((\"v\", r, 0))\n        out.append((\"v\", r, W - 1))\n    random.shuffle(out)\n    return [(axis, r, c) for axis, r, c in out if _anchor_ok(canvas, r, c, bg)]\n\n\ndef _put_anchor(canvas, r, c, color):\n    paste(canvas, np.array([[int(color)]], dtype=int), int(r), int(c))\n\n\ndef _aligned_positions(canvas, sprite, anchor, bg):\n    H, W = canvas.shape\n    if anchor[\"axis\"] == \"h\":\n        return [\n            (r, anchor[\"c\"])\n            for r in range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP)\n            if _can_place(canvas, sprite, r, anchor[\"c\"], bg)\n        ]\n    return [\n        (anchor[\"r\"], c)\n        for c in range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP)\n        if _can_place(canvas, sprite, anchor[\"r\"], c, bg)\n    ]\n\n\ndef _scatter_positions(canvas, sprite, anchor, marker, bg):\n    H, W = canvas.shape\n    mr, mc = marker\n    if anchor[\"axis\"] == \"h\":\n        return [\n            (mr, c)\n            for c in range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP)\n            if c != mc and _can_place(canvas, sprite, mr, c, bg)\n        ]\n    return [\n        (r, mc)\n        for r in range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP)\n        if r != mr and _can_place(canvas, sprite, r, mc, bg)\n    ]\n\n\ndef _body_color(bg, marker, used):\n    pool = [c for c in _COLORS if c not in {int(bg), int(marker)} and c not in used]\n    if not pool:\n        pool = [c for c in _COLORS if c not in {int(bg), int(marker)}]\n    return random.choice(pool)\n\n\ndef _bg_is_mode(grid, bg):\n    counts = Counter(map(int, grid.ravel()))\n    return counts[int(bg)] > max((n for c, n in counts.items() if c != int(bg)), default=0)\n\n\ndef _add_distractors(out, inp, anchors, bg):\n    vertical = [a for a in anchors if a[\"axis\"] == \"v\"]\n    if not vertical or random.random() >= _DISTRACTOR_PROB:\n        return\n    anchor = random.choice(vertical)\n    sprite = {\"patch\": np.array([[anchor[\"color\"]]], dtype=int), \"offset\": (0, 0)}\n    for _ in range(random.randint(*_DISTRACTOR_COUNT_RANGE)):\n        pairs = []\n        for c in range(_INNER_BORDER_GAP, out.shape[1] - _INNER_BORDER_GAP):\n            if not _can_place(out, sprite, anchor[\"r\"], c, bg):\n                continue\n            for r in range(_INNER_BORDER_GAP, out.shape[0] - _INNER_BORDER_GAP):\n                if r != anchor[\"r\"] and _can_place(inp, sprite, r, c, bg):\n                    pairs.append((r, c))\n        if not pairs:\n            return\n        in_r, col = random.choice(pairs)\n        _place(out, sprite, anchor[\"r\"], col, bg)\n        _place(inp, sprite, in_r, col, bg)\n\n\ndef _gen_attempt():\n    bg, out, inp = _new_canvas_pair()\n    placed = _place_anchors(out, inp, bg)\n    if placed is None:\n        return None\n    anchor_colors, anchors = placed\n\n    marker_colors = _marker_color_sequence(anchor_colors)\n    sprites = _place_aligned_sprites(out, anchors, marker_colors, bg)\n    if sprites is None:\n        return None\n\n    if not _scatter_sprites(inp, sprites, bg):\n        return None\n\n    _add_distractors(out, inp, anchors, bg)\n    if not _generated_grid_is_valid(inp, out, bg):\n        return None\n    return inp\n\n\ndef _new_canvas_pair():\n    \"\"\"Choose grid size/background and return matching output/input canvases.\"\"\"\n    H = random.randint(*_GRID_HEIGHT_RANGE)\n    W = random.randint(*_GRID_WIDTH_RANGE)\n    bg = random.randint(*_BG_COLOR_RANGE)\n    out = np.full((H, W), int(bg), dtype=int)\n    inp = np.full((H, W), int(bg), dtype=int)\n    return bg, out, inp\n\n\ndef _place_anchors(out, inp, bg):\n    \"\"\"Place distinct isolated border anchors into both canvases.\"\"\"\n    anchor_colors = random.sample([c for c in _COLORS if c != bg], random.randint(*_ANCHOR_COUNT_RANGE))\n    anchors = []\n    for color in anchor_colors:\n        candidates = _anchor_candidates(out, bg)\n        if not candidates:\n            return None\n        axis, r, c = random.choice(candidates)\n        anchor = {\"color\": int(color), \"r\": int(r), \"c\": int(c), \"axis\": axis}\n        anchors.append(anchor)\n        _put_anchor(out, r, c, color)\n        _put_anchor(inp, r, c, color)\n    return anchor_colors, anchors\n\n\ndef _marker_color_sequence(anchor_colors):\n    \"\"\"Expand anchor colors to the sprite count, allowing repeated markers.\"\"\"\n    n_sprites = random.randint(*_SPRITE_COUNT_RANGE)\n    marker_colors = anchor_colors[:]\n    while len(marker_colors) < n_sprites:\n        marker_colors.append(random.choice(anchor_colors))\n    random.shuffle(marker_colors)\n    return marker_colors\n\n\ndef _place_aligned_sprites(out, anchors, marker_colors, bg):\n    \"\"\"Build sprites in their solved locations and return their align metadata.\"\"\"\n    by_color = {a[\"color\"]: a for a in anchors}\n    used_body = set()\n    sprites = []\n    for marker in marker_colors:\n        anchor = by_color[int(marker)]\n        body = _body_color(bg, marker, used_body)\n        used_body.add(body)\n        sprite = _make_sprite(random.randint(*_BODY_AREA_RANGE), body, marker, bg)\n        positions = _aligned_positions(out, sprite, anchor, bg)\n        if not positions:\n            return None\n        marker_pos = random.choice(positions)\n        _place(out, sprite, marker_pos[0], marker_pos[1], bg)\n        sprites.append((sprite, anchor, marker_pos))\n    return sprites\n\n\ndef _scatter_sprites(inp, sprites, bg):\n    \"\"\"Move solved sprites onto the input canvas along the inverse axis.\"\"\"\n    random.shuffle(sprites)\n    for sprite, anchor, marker_pos in sprites:\n        positions = _scatter_positions(inp, sprite, anchor, marker_pos, bg)\n        if not positions:\n            return False\n        in_pos = random.choice(positions)\n        _place(inp, sprite, in_pos[0], in_pos[1], bg)\n    return True\n\n\ndef _generated_grid_is_valid(inp, out, bg):\n    \"\"\"Apply generator invariants and the solver oracle check.\"\"\"\n    if not _bg_is_mode(inp, bg):\n        return False\n    return bool(np.array_equal(main(inp), out))\n\n\ndef generate_input() -> np.ndarray:\n\n=====SPLIT=====\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 581f7754 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py && printf '\\\\n=====SPLIT=====\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py && printf '\\\\n=====FILE=====\\\\n' && sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/34cfa167.py && printf '\\\\n=====SPLIT=====\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/34cfa167.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\ndef _in_bounds(h, w, r, c):\n    return 0 <= r < h and 0 <= c < w\n\n\n# ---------------------------------------------------------------------------\n# Frame geometry\n# ---------------------------------------------------------------------------\n\ndef _frame_ring_coords(r0, c0, ch, cw):\n    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n\n    Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).\n    Ring = bbox boundary minus 4 corners.\n    \"\"\"\n    H, W = ch + 2, cw + 2\n    ring = []\n    for dr in range(H):\n        for dc in range(W):\n            on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)\n            corner = (dr in (0, H - 1)) and (dc in (0, W - 1))\n            if on_bdr and not corner:\n                ring.append((r0 + dr, c0 + dc))\n    cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]\n    return ring, cavity\n\n\ndef _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n\n    Returns True if: ring and cavity cells are empty, no cavity cell is\n    8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and\n    at least one ring cell is 8-adjacent to a line_col pixel.\n    \"\"\"\n    # Ring and cavity cells must all be empty\n    for rr, cc in ring:\n        if canvas[rr, cc] != -1:\n            return False\n    for rr, cc in cavity:\n        if canvas[rr, cc] != -1:\n            return False\n\n    # No cavity cell may be 8-adjacent to any line_col pixel\n    for cr, cc in cavity:\n        for nr, nc in neighbors8(cr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return False\n\n    # Ring must not be 8-adjacent to any non-bg, non-line_col pixel\n    ring_set = set(ring)\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:\n                continue\n            v = canvas[nr, nc]\n            if v != -1 and v != line_col:\n                return False\n\n    # At least one ring cell must be 8-adjacent to a line_col pixel\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return True\n    return False\n\n\n# ---------------------------------------------------------------------------\n# Line growth\n# ---------------------------------------------------------------------------\n\ndef _grow_line(grid, start, line_col, target_len, rng):\n    \"\"\"Grow a meandering 8-connected 1px-wide path of line_col from start.\"\"\"\n    h, w = grid.shape\n    path = [start]\n    dr_bias = 1 if start[0] < h // 2 else -1\n    dc_bias = 1 if start[1] < w // 2 else -1\n    cur = start\n    path_set = {start}\n    while len(path) < target_len:\n        # Build weighted direction list: diagonals preferred, bias-aligned boosted\n        dirs = []\n        for ddr, ddc in DIAG_DIRS:\n            aligned = (ddr == dr_bias or ddc == dc_bias)\n            w_d = DIAG_WEIGHT_ALIGNED if aligned else DIAG_WEIGHT_OTHER\n            dirs.extend([(ddr, ddc)] * w_d)\n        for ddr, ddc in ORTHO_DIRS:\n            aligned = (ddr == dr_bias and ddc == 0) or (ddc == dc_bias and ddr == 0)\n            w_d = ORTHO_WEIGHT_ALIGNED if aligned else ORTHO_WEIGHT_OTHER\n            dirs.extend([(ddr, ddc)] * w_d)\n        rng.shuffle(dirs)\n        placed = False\n        for ddr, ddc in dirs:\n            nr, nc = cur[0] + ddr, cur[1] + ddc\n            if not _in_bounds(h, w, nr, nc) or grid[nr, nc] != -1:\n                continue\n            # Keep path thin: reject if 8-adjacent to existing path (except cur)\n            if any((nnr, nnc) != cur and (nnr, nnc) in path_set\n                   for nnr, nnc in neighbors8(nr, nc)):\n                continue\n            # Strongly avoid grid border\n            if (nr == 0 or nc == 0 or nr == h - 1 or nc == w - 1) and rng.random() < BORDER_AVOIDANCE_PROB:\n                continue\n            cur = (nr, nc)\n            path.append(cur)\n            path_set.add(cur)\n            grid[nr, nc] = line_col\n            placed = True\n            break\n        if not placed:\n            if rng.random() < BIAS_FLIP_PROB:\n                dr_bias *= -1\n            if rng.random() < BIAS_FLIP_PROB:\n                dc_bias *= -1\n            break\n    return path\n\n\n# ---------------------------------------------------------------------------\n# Frame attachment\n# ---------------------------------------------------------------------------\n\ndef _halo_offsets(fh, fw):\n    \"\"\"Compute offsets around a frame bbox that lie outside it (the halo).\"\"\"\n    return [(dr, dc) for dr in range(-1, fh + 1) for dc in range(-1, fw + 1)\n            if not (0 <= dr < fh and 0 <= dc < fw)]\n\n\ndef _try_attach_frame(canvas, line_path, line_col, frame_col, rng, max_tries=FRAME_ATTACH_TRIES):\n    \"\"\"Try to place a frame loop 8-adjacent to some line pixel.\n\n    canvas is modified in place; returns (ring, cavity) or None on failure.\n    \"\"\"\n    h, w = canvas.shape\n    pad = FRAME_PLACEMENT_PAD\n    for _ in range(max_tries):\n        ch = rng.choice(CAVITY_SIZE_WEIGHTS)\n        cw = rng.choice(CAVITY_SIZE_WEIGHTS)\n        lp = rng.choice(line_path)\n        fh, fw = ch + 2, cw + 2\n        offsets = _halo_offsets(fh, fw)\n        rng.shuffle(offsets)\n        for dr, dc in offsets:\n            r0 = lp[0] - dr\n            c0 = lp[1] - dc\n            if r0 < pad or c0 < pad or r0 + fh > h - pad or c0 + fw > w - pad:\n                continue\n            ring, cavity = _frame_ring_coords(r0, c0, ch, cw)\n            if not _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n                continue\n            for rr, cc in ring:\n                canvas[rr, cc] = frame_col\n            return ring, cavity\n    return None\n\n\ndef _try_attach_distractor_frame(canvas, frame_col, rng, max_tries=DISTRACTOR_FRAME_TRIES):\n    \"\"\"Place a loop in empty space, not touching any non-bg pixel.\"\"\"\n    h, w = canvas.shape\n    for _ in range(max_tries):\n        ch = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\n        cw = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\n        fh, fw = ch + 2, cw + 2\n        r0 = rng.randint(1, h - fh - 1)\n        c0 = rng.randint(1, w - fw - 1)\n        # Check the full bbox + 1-cell margin is empty\n        ok = True\n        for rr in range(r0 - 1, r0 + fh + 1):\n            for cc in range(c0 - 1, c0 + fw + 1):\n                if _in_bounds(h, w, rr, cc) and canvas[rr, cc] != -1:\n                    ok = False\n                    break\n            if not ok:\n                break\n        if not ok:\n            continue\n        ring, _ = _frame_ring_coords(r0, c0, ch, cw)\n        for rr, cc in ring:\n            canvas[rr, cc] = frame_col\n        return True\n    return None\n\n\ndef _try_place_distractor_network(canvas, line_col, frame_colors_pool, rng):\n    \"\"\"Place a disconnected line+frame distractor (no seed).\"\"\"\n    h, w = canvas.shape\n    for _ in range(DISTRACTOR_NETWORK_TRIES):\n        r = rng.randint(2, h - 3)\n        c = rng.randint(2, w - 3)\n        if any(canvas[r + dr, c + dc] != -1 for dr in range(-1, 2) for dc in range(-1, 2)):\n            continue\n        canvas[r, c] = line_col\n        target_len = rng.randint(*DISTRACTOR_LINE_LEN)\n        path = _grow_line(canvas, (r, c), line_col, target_len, rng)\n        if len(path) < 3:\n            for pr, pc in path:\n                canvas[pr, pc] = -1\n            continue\n        attached = 0\n        for _ in range(rng.randint(*DISTRACTOR_NETWORK_FRAMES)):\n            fc = rng.choice(frame_colors_pool)\n            if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\n                attached += 1\n        if attached > 0:\n            return True\n        for pr, pc in path:\n            canvas[pr, pc] = -1\n    return False\n\n\n# ---------------------------------------------------------------------------\n# Main generator\n# ---------------------------------------------------------------------------\n\ndef _corner_config(corner_kind, h, w, rng):\n    \"\"\"Return (seed_rc, first_line_rc) for corner_kind in {TL,TR,BL,BR}.\"\"\"\n    if corner_kind == 'TL':\n        seed = (0, 0)\n        first = rng.choice([(0, 1), (1, 0)])\n    elif corner_kind == 'TR':\n        seed = (0, w - 1)\n        first = rng.choice([(0, w - 2), (1, w - 1)])\n    elif corner_kind == 'BL':\n        seed = (h - 1, 0)\n        first = rng.choice([(h - 1, 1), (h - 2, 0)])\n    elif corner_kind == 'BR':\n        seed = (h - 1, w - 1)\n        first = rng.choice([(h - 1, w - 2), (h - 2, w - 1)])\n    else:\n        raise ValueError(corner_kind)\n    return seed, first\n\n\ndef _distribute_loop_budget(num_seeds, num_attached_target, rng):\n    \"\"\"Distribute attached-loop budget across seeds, guaranteeing >= 1 each.\"\"\"\n    seed_order = list(range(num_seeds))\n    rng.shuffle(seed_order)\n    per_seed = [0] * num_seeds\n    remaining = num_attached_target\n    # Guarantee at least 1 per seed\n    while remaining > 0 and any(per_seed[i] == 0 for i in range(num_seeds)):\n        for i in seed_order:\n            if per_seed[i] == 0 and remaining > 0:\n                per_seed[i] += 1\n                remaining -= 1\n    # Distribute remainder randomly\n    while remaining > 0:\n        per_seed[rng.choice(seed_order)] += 1\n        remaining -= 1\n    return per_seed\n\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    h = rng.randint(*GRID_H_RANGE)\n    w = rng.randint(*GRID_W_RANGE)\n    bg = rng.choice(BG_COLORS)\n    palette = [c for c in range(10) if c != bg]\n    rng.shuffle(palette)\n\n    num_seeds = rng.choice(SEED_COUNT_WEIGHTS)\n    if num_seeds * 2 > len(palette):\n        return None\n\n    canvas = -np.ones((h, w), dtype=int)\n\n    seed_colors = [palette.pop() for _ in range(num_seeds)]\n    line_colors = [palette.pop() for _ in range(num_seeds)]\n\n    all_corners = ['TL', 'TR', 'BL', 'BR']\n    rng.shuffle(all_corners)\n    corners_used = all_corners[:num_seeds]\n\n    num_frame_cols = rng.randint(1, min(FRAME_COLORS_MAX, len(palette)))\n    frame_colors_pool = [palette.pop() for _ in range(num_frame_cols)]\n\n    # Grow seed lines\n    lines_info = []\n    for i in range(num_seeds):\n        seed_rc, first_rc = _corner_config(corners_used[i], h, w, rng)\n        if canvas[seed_rc] != -1 or canvas[first_rc] != -1:\n            return None\n        canvas[seed_rc] = seed_colors[i]\n        canvas[first_rc] = line_colors[i]\n        target_len = rng.randint(LINE_LEN_RANGE[0], min(LINE_LEN_RANGE[1], h + w))\n        path = _grow_line(canvas, first_rc, line_colors[i], target_len, rng)\n        if len(path) < MIN_LINE_LEN:\n            return None\n        lines_info.append((seed_colors[i], seed_rc, line_colors[i], path))\n\n    # Decide loop counts and distribute across seeds\n    total_loops_target = rng.randint(num_seeds, TOTAL_LOOPS_MAX)\n    num_distractors_target = rng.randint(0, max(0, total_loops_target - num_seeds))\n    num_attached_target = total_loops_target - num_distractors_target\n    per_seed = _distribute_loop_budget(num_seeds, num_attached_target, rng)\n\n    # Attach frames to each seed's line\n    for i, (_, _, line_col, path) in enumerate(lines_info):\n        attached = 0\n        for _ in range(per_seed[i]):\n            fc = rng.choice(frame_colors_pool)\n            if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\n                attached += 1\n        if attached == 0:\n            return None\n\n    # Place distractors\n    if rng.random() < DISTRACTOR_NETWORK_PROB:\n        _try_place_distractor_network(canvas, rng.choice(line_colors), frame_colors_pool, rng)\n    else:\n        for _ in range(rng.randint(0, DISTRACTOR_SOLO_MAX)):\n            _try_attach_distractor_frame(canvas, rng.choice(frame_colors_pool), rng)\n\n    # Finalize grid\n    grid = np.where(canvas == -1, bg, canvas).astype(int)\n\n    # Validate bg is most common color\n    vals, cnts = np.unique(grid, return_counts=True)\n    if int(vals[np.argmax(cnts)]) != bg:\n        return None\n\n    # Validate each seed color appears exactly once\n    for seed_col, _, _, _ in lines_info:\n        if int((grid == seed_col).sum()) != 1:\n            return None\n\n    # Oracle check: solver must change at least one cell\n    try:\n        out = main(grid)\n    except Exception:\n        return None\n    if np.array_equal(out, grid):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n\n=====SPLIT=====\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exhausted attempts\")\n\n=====FILE=====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.\n\n    Input structure:\n    - The background is the dominant color.\n    - Two same-color solid rectangular anchors of the same size sit on opposite\n      diagonal corners, with the first anchor above-left of the second.\n    - The upper-left anchor has two one-cell-thick vertical control bars to its\n      right and two one-cell-thick horizontal control bars below it.\n\n    Rule:\n    - Copy the anchor rectangle into the two missing corners of the implied\n      larger rectangle.\n    - Repeat the right-side control bars horizontally between the left and right\n      anchors, using their spacing as the period, and draw the outer top and\n      bottom borders in the first right-control color.\n    - Repeat the below-side control bars vertically between the top and bottom\n      anchors, using the same period, and draw the outer left and right borders\n      in the first below-control color.\n\n    Key insight: The small control bars are the first two ticks of two periodic\n    frame patterns; the diagonal anchor supplies the opposite corner and the\n    missing two anchor copies.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    source, dest, right_controls, below_controls = _find_structure(g, bg)\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    dr0, dc0, dr1, dc1 = dest[\"bbox\"]\n    anchor_color = int(source[\"color\"])\n    assert int(dest[\"color\"]) == anchor_color, \"anchor colors must match\"\n    assert bbox_h(source[\"bbox\"]) == bbox_h(dest[\"bbox\"]), \"anchor heights must match\"\n    assert bbox_w(source[\"bbox\"]) == bbox_w(dest[\"bbox\"]), \"anchor widths must match\"\n    assert sr0 > 0 and sc0 > 0, \"upper-left anchor must have space for outer frame\"\n    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \"lower-right anchor must have space for outer frame\"\n\n    right_offsets = [int(comp[\"bbox\"][1] - sc1) for comp in right_controls]\n    below_offsets = [int(comp[\"bbox\"][0] - sr1) for comp in below_controls]\n    assert right_offsets == below_offsets and right_offsets[0] == 1, \"control offsets must match from the anchor edge\"\n    step = int(right_offsets[1] - right_offsets[0])\n    assert step > 0, \"control bars must be separated\"\n    period = 2 * step\n    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, \"right frame must close next to the destination anchor\"\n    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, \"below frame must close next to the destination anchor\"\n\n    right_colors = [int(comp[\"color\"]) for comp in right_controls]\n    below_colors = [int(comp[\"color\"]) for comp in below_controls]\n    out = g.copy()\n\n    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)\n    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)\n\n    first_c = int(sc1 + right_offsets[0])\n    last_c = int(dc0 - 1)\n    for c in range(first_c, last_c + 1):\n        offset = int(c - sc1)\n        if (offset - right_offsets[0]) % period == 0:\n            color = right_colors[0]\n        elif (offset - right_offsets[1]) % period == 0:\n            color = right_colors[1]\n        else:\n            continue\n        _paint_rect(out, bg, sr0, c, sr1, c, color)\n        _paint_rect(out, bg, dr0, c, dr1, c, color)\n\n    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])\n    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])\n\n    first_r = int(sr1 + below_offsets[0])\n    last_r = int(dr0 - 1)\n    left_c = int(sc0 - 1)\n    right_c = int(dc1 + 1)\n    for r in range(first_r, last_r + 1):\n        _paint(out, bg, r, left_c, below_colors[0])\n        _paint(out, bg, r, right_c, below_colors[0])\n\n        offset = int(r - sr1)\n        if (offset - below_offsets[0]) % period == 0:\n            _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])\n            _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])\n        elif (offset - below_offsets[1]) % period == 0:\n            _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])\n            _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color sampling.\nCOLOR_COUNT, NON_BG_COLOR_COUNT = 10, 4\n\n# Anchor/repetition geometry.\nANCHOR_SIZE_RANGE = (1, 5)\nREPEAT_COUNT_RANGE = (2, 5)\nCONTROL_OFFSETS = (1, 3)\nFRAME_PERIOD, DEST_ANCHOR_GAP, STRUCTURE_FIXED_PAD = 4, 2, 3\n\n# Canvas/margins.\nCANVAS_MIN_SIZE, CANVAS_MAX_SIZE = 16, 30\nMARGIN_CHOICES = range(4)\nMIN_TOTAL_MARGIN, SOURCE_OUTER_MARGIN = 1, 1\n\n# Retry.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_paint_rect(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int) -> None:\n    grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)\n\n\ndef _choose_margins(struct_len: int) -> tuple[int, int]:\n    pairs = [\n        (before, after)\n        for before in MARGIN_CHOICES\n        for after in MARGIN_CHOICES\n        if MIN_TOTAL_MARGIN <= before + after\n        and CANVAS_MIN_SIZE <= struct_len + before + after <= CANVAS_MAX_SIZE\n    ]\n    return pairs[int(np.random.randint(len(pairs)))]\n\n\ndef _build_output(\n    rows: int,\n    cols: int,\n    bg: int,\n    anchor_color: int,\n    right1: int,\n    right2: int,\n    below1: int,\n    sr0: int,\n    sc0: int,\n    s: int,\n    nh: int,\n    nv: int,\n) -> tuple[np.ndarray, tuple[int, int, int, int, int, int, int, int]]:\n    out = np.full((rows, cols), int(bg), dtype=int)\n    sr1, sc1 = sr0 + s - 1, sc0 + s - 1\n    dr0 = sr1 + FRAME_PERIOD * nv + DEST_ANCHOR_GAP\n    dc0 = sc1 + FRAME_PERIOD * nh + DEST_ANCHOR_GAP\n    dr1, dc1 = dr0 + s - 1, dc0 + s - 1\n\n    for r0, c0 in ((sr0, sc0), (sr0, dc0), (dr0, sc0), (dr0, dc0)):\n        _gen_paint_rect(out, r0, c0, r0 + s - 1, c0 + s - 1, anchor_color)\n\n    first_c, last_c = sc1 + CONTROL_OFFSETS[0], dc0 - 1\n    for c in range(first_c, last_c + 1):\n        offset = c - sc1\n        if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:\n            color = right1\n        elif (offset - CONTROL_OFFSETS[1]) % FRAME_PERIOD == 0:\n            color = right2\n        else:\n            continue\n        _gen_paint_rect(out, sr0, c, sr1, c, color)\n        _gen_paint_rect(out, dr0, c, dr1, c, color)\n    _gen_paint_rect(out, sr0 - 1, first_c, sr0 - 1, last_c, right1)\n    _gen_paint_rect(out, dr1 + 1, first_c, dr1 + 1, last_c, right1)\n\n    first_r, last_r = sr1 + CONTROL_OFFSETS[0], dr0 - 1\n    left_c, right_c = sc0 - 1, dc1 + 1\n    for r in range(first_r, last_r + 1):\n        out[r, left_c] = below1\n        out[r, right_c] = below1\n        offset = r - sr1\n        if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:\n            _gen_paint_rect(out, r, left_c, r, sc1, below1)\n            _gen_paint_rect(out, r, dc0, r, right_c, below1)\n        elif (offset - CONTROL_OFFSETS[1]) % FRAME_PERIOD == 0:\n            _gen_paint_rect(out, r, sc0, r, sc1, right2)\n            _gen_paint_rect(out, r, dc0, r, dc1, right2)\n\n    return out, (sr0, sc0, sr1, sc1, dr0, dc0, dr1, dc1)\n\n\ndef _derive_input(\n    out: np.ndarray,\n    bg: int,\n    sr0: int,\n    sc0: int,\n    sr1: int,\n    sc1: int,\n    dr0: int,\n    dc0: int,\n    dr1: int,\n    dc1: int,\n) -> np.ndarray:\n    keep = np.zeros(out.shape, dtype=bool)\n    keep[sr0 : sr1 + 1, sc0 : sc1 + 1] = True\n    keep[dr0 : dr1 + 1, dc0 : dc1 + 1] = True\n    keep[sr0 : sr1 + 1, sc1 + CONTROL_OFFSETS[0]] = True\n    keep[sr0 : sr1 + 1, sc1 + CONTROL_OFFSETS[1]] = True\n    keep[sr1 + CONTROL_OFFSETS[0], sc0 : sc1 + 1] = True\n    keep[sr1 + CONTROL_OFFSETS[1], sc0 : sc1 + 1] = True\n\n    inp = np.full_like(out, int(bg))\n    inp[keep] = out[keep]\n    return inp\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = int(np.random.randint(COLOR_COUNT))\n    palette = [color for color in range(COLOR_COUNT) if color != bg]\n    anchor_color, right1, right2, below1 = map(\n        int, np.random.choice(palette, NON_BG_COLOR_COUNT, replace=False)\n    )\n\n    s = int(np.random.randint(ANCHOR_SIZE_RANGE[0], ANCHOR_SIZE_RANGE[1]))\n    nh = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))\n    nv = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))\n    struct_h = 2 * s + FRAME_PERIOD * nv + STRUCTURE_FIXED_PAD\n    struct_w = 2 * s + FRAME_PERIOD * nh + STRUCTURE_FIXED_PAD\n\n    top, bottom = _choose_margins(struct_h)\n    left, right = _choose_margins(struct_w)\n    rows, cols = struct_h + top + bottom, struct_w + left + right\n    sr0, sc0 = top + SOURCE_OUTER_MARGIN, left + SOURCE_OUTER_MARGIN\n\n    out, box = _build_output(\n        rows,\n        cols,\n        bg,\n        anchor_color,\n        right1,\n        right2,\n        below1,\n        sr0,\n        sc0,\n        s,\n        nh,\n        nv,\n    )\n    inp = _derive_input(out, bg, *box)\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n\n=====SPLIT=====\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py && printf '\\\\n=====SPLIT=====\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py && printf '\\\\n=====FILE=====\\\\n' && sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/13e47133.py && printf '\\\\n=====SPLIT=====\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/13e47133.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py && printf '\\\\n=====SPLIT=====\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py && printf '\\\\n=====FILE=====\\\\n' && sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/13e47133.py && printf '\\\\n=====SPLIT=====\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/13e47133.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n\n    Input structure:\n    - Black background with several axis-aligned colored line drawings.\n    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n\n    Rule:\n    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n    - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n    - The color with no enclosed region is the noise/pad color.\n    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n\n    Key insight:\n    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg == 0\n\n    counts: list[tuple[int, int, np.ndarray]] = []\n    for color in colors_present(g, exclude={bg}):\n        rooms = _room_count_for_color(g, int(color))\n        walls = _walls_for_color(g, int(color))\n        counts.append((int(color), int(rooms), walls))\n\n    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n    assert drawings\n    assert len(pad_colors) == 1\n\n    pad = int(pad_colors[0])\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n        group = [item for item in drawings if item[1] == rooms]\n        ordered.extend(_cover_order(g, group))\n\n    width = max(rooms for _color, rooms, _walls in ordered)\n\n    out = np.full((len(ordered), width), pad, dtype=int)\n    for r, (color, rooms, _walls) in enumerate(ordered):\n        out[r, :rooms] = int(color)\n    return out\n\n# --------------- generator (claude-opus-4-6) ---------------\n\n# ---- CFG: Tunable generation parameters ----\n_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n    5: (25, 30, 25, 30, 16, 18),\n    4: (22, 30, 22, 30, 18, 22),\n    3: (20, 30, 20, 30, 22, 25),\n}\n_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n_OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n_GEN_RETRIES = 300                   # outer retry limit\n\n\ndef _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n    \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n    if n * min_gap > max_total:\n        return None\n    gaps = [min_gap] * n\n    remaining = max_total - sum(gaps)\n    for i in range(n):\n        extra = min(max_gap - gaps[i], remaining)\n        if extra > 0:\n            add = random.randint(0, extra)\n            gaps[i] += add\n            remaining -= add\n    random.shuffle(gaps)\n    return gaps\n\n\ndef _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n    \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n    if target_rooms == 1:\n        gap_h = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_h - 2))\n        gap_w = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_w - 2))\n        h, w = gap_h + 2, gap_w + 2\n        walls = np.zeros((h, w), dtype=bool)\n        walls[0, :] = True\n        walls[h - 1, :] = True\n        walls[:, 0] = True\n        walls[:, w - 1] = True\n        return walls\n\n    # For target_rooms >= 2: grid of cells, then selectively merge\n    possible_configs = []\n    for nv in range(2, 6):\n        for nh in range(2, 5):\n            cells = (nv - 1) * (nh - 1)\n            if target_rooms <= cells <= target_rooms + 4:\n                possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        for nv in range(2, 7):\n            for nh in range(2, 6):\n                cells = (nv - 1) * (nh - 1)\n                if cells >= target_rooms:\n                    possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        return None\n\n    n_vcols, n_hrows, total_cells = random.choice(possible_configs)\n    n_row_gaps = n_hrows - 1\n    n_col_gaps = n_vcols - 1\n    min_gap, max_gap = _CELL_GAP_RANGE\n\n    if min_gap * n_row_gaps > max_h - 1 or min_gap * n_col_gaps > max_w - 1:\n        return None\n\n    row_gaps = _random_gaps(n_row_gaps, min_gap, max_gap, max_h - 1)\n    col_gaps = _random_gaps(n_col_gaps, min_gap, max_gap, max_w - 1)\n    if row_gaps is None or col_gaps is None:\n        return None\n\n    # Compute line positions from cumulative gaps\n    vcol_positions = [0]\n    for gap in col_gaps:\n        vcol_positions.append(vcol_positions[-1] + gap)\n    hrow_positions = [0]\n    for gap in row_gaps:\n        hrow_positions.append(hrow_positions[-1] + gap)\n\n    frame_h = hrow_positions[-1] + 1\n    frame_w = vcol_positions[-1] + 1\n    walls = np.zeros((frame_h, frame_w), dtype=bool)\n    for r in hrow_positions:\n        walls[r, :] = True\n    for c in vcol_positions:\n        walls[:, c] = True\n\n    cells_to_merge = total_cells - target_rooms\n    if cells_to_merge == 0:\n        return walls\n\n    # Union-find to merge adjacent cells by removing internal wall segments\n    parent = list(range(total_cells))\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(x, y):\n        px, py = find(x), find(y)\n        if px == py:\n            return False\n        parent[px] = py\n        return True\n\n    def cell_id(cr, cc):\n        return cr * (n_vcols - 1) + cc\n\n    # Enumerate internal wall segments (between adjacent cells)\n    internal_segments = []\n    for hi in range(1, n_hrows - 1):\n        r = hrow_positions[hi]\n        for ci in range(n_vcols - 1):\n            c0, c1 = vcol_positions[ci], vcol_positions[ci + 1]\n            internal_segments.append(('h', r, c0, c1, cell_id(hi - 1, ci), cell_id(hi, ci)))\n    for ci in range(1, n_vcols - 1):\n        c = vcol_positions[ci]\n        for hi in range(n_hrows - 1):\n            r0, r1 = hrow_positions[hi], hrow_positions[hi + 1]\n            internal_segments.append(('v', c, r0, r1, cell_id(hi, ci - 1), cell_id(hi, ci)))\n\n    random.shuffle(internal_segments)\n    merged = 0\n    for seg in internal_segments:\n        if merged >= cells_to_merge:\n            break\n        if seg[0] == 'h':\n            _, r, c0, c1, ca, cb = seg\n            if find(ca) != find(cb):\n                union(ca, cb)\n                walls[r, c0 + 1:c1] = False\n                merged += 1\n        else:\n            _, c, r0, r1, ca, cb = seg\n            if find(ca) != find(cb):\n                union(ca, cb)\n                walls[r0 + 1:r1, c] = False\n                merged += 1\n\n    if merged < cells_to_merge:\n        return None\n    if _count_enclosed_regions(walls) != target_rooms:\n        return None\n    return walls\n\n\ndef _force_overlap(positions, i, j, frames, grid_h, grid_w):\n    \"\"\"Try to reposition frame j so it overlaps frame i. Modifies positions in place.\"\"\"\n    fi_h, fi_w = frames[i][2].shape\n    fj_h, fj_w = frames[j][2].shape\n    ri, ci = positions[i]\n    r0_min = max(0, ri - fj_h + 2)\n    r0_max = min(grid_h - fj_h, ri + fi_h - 2)\n    c0_min = max(0, ci - fj_w + 2)\n    c0_max = min(grid_w - fj_w, ci + fi_w - 2)\n    if r0_min > r0_max or c0_min > c0_max:\n        return\n    for _ in range(_OVERLAP_RETRY):\n        rj = random.randint(r0_min, r0_max)\n        cj = random.randint(c0_min, c0_max)\n        # Verify bbox overlap\n        if (max(ri, rj) <= min(ri + fi_h - 1, rj + fj_h - 1) and\n                max(ci, cj) <= min(ci + fi_w - 1, cj + fj_w - 1)):\n            positions[j] = (rj, cj)\n            return\n\n\ndef _render_frames(frames, positions, render_order, grid_h, grid_w):\n    \"\"\"Render frame walls onto grid; return grid and set of visible frame pixel coords.\"\"\"\n    grid = np.zeros((grid_h, grid_w), dtype=int)\n    # Paint walls in render order (later overwrites earlier at overlaps)\n    for idx in render_order:\n        r0, c0 = positions[idx]\n        wall_arr = frames[idx][2]\n        color = frames[idx][0]\n        # Vectorized: find wall pixel offsets and stamp color\n        rs, cs = np.where(wall_arr)\n        grid[rs + r0, cs + c0] = color\n\n    # Compute visible frame pixels (where grid still shows that frame's color)\n    frame_mask = np.zeros((grid_h, grid_w), dtype=bool)\n    for idx in render_order:\n        r0, c0 = positions[idx]\n        wall_arr = frames[idx][2]\n        color = frames[idx][0]\n        rs, cs = np.where(wall_arr)\n        abs_rs, abs_cs = rs + r0, cs + c0\n        visible = grid[abs_rs, abs_cs] == color\n        frame_mask[abs_rs[visible], abs_cs[visible]] = True\n\n    return grid, frame_mask\n\n\ndef _scatter_noise(grid, frame_mask, noise_color, grid_h, grid_w):\n    \"\"\"Place noise pixels on non-wall cells and damage some wall cells.\"\"\"\n    total_cells = grid_h * grid_w\n    noise_fraction = random.uniform(*_NOISE_FRACTION_RANGE)\n    noise_count = int(total_cells * noise_fraction)\n\n    # Non-wall positions\n    nonwall_rs, nonwall_cs = np.where(~frame_mask)\n    perm = np.random.permutation(len(nonwall_rs))\n    n_nonwall = min(noise_count, len(perm))\n    sel = perm[:n_nonwall]\n    grid[nonwall_rs[sel], nonwall_cs[sel]] = noise_color\n    placed = n_nonwall\n\n    # Wall damage (up to _WALL_DAMAGE_FRACTION of wall pixels)\n    wall_rs, wall_cs = np.where(frame_mask)\n    n_wall = len(wall_rs)\n    max_damage = min(noise_count - placed, int(_WALL_DAMAGE_FRACTION * n_wall))\n    if max_damage > 0:\n        damage_perm = np.random.permutation(n_wall)[:max_damage]\n        grid[wall_rs[damage_perm], wall_cs[damage_perm]] = noise_color\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid puzzle grid.\"\"\"\n    frame_count = random.randint(*_FRAME_COUNT_RANGE)\n\n    # --- Room count assignment ---\n    available = list(range(_ROOM_COUNT_RANGE[0], _ROOM_COUNT_RANGE[1] + 1))\n    allow_tie = random.random() < _TIE_PROBABILITY and frame_count >= 3\n    if allow_tie:\n        distinct_needed = frame_count - 1\n        chosen = random.sample(available, min(distinct_needed, len(available)))\n        if len(chosen) < distinct_needed:\n            return None\n        room_counts = chosen + [random.choice(chosen)]\n    else:\n        if frame_count > len(available):\n            return None\n        room_counts = random.sample(available, frame_count)\n    random.shuffle(room_counts)\n\n    # --- Color assignment ---\n    chosen_colors = random.sample(list(range(1, 10)), frame_count + 1)\n    frame_colors = chosen_colors[:frame_count]\n    noise_color = chosen_colors[frame_count]\n\n    # --- Grid/frame size selection ---\n    cfg = _GRID_SIZE_BY_FRAMES.get(frame_count, _GRID_SIZE_BY_FRAMES[3])\n    h_min, h_max, w_min, w_max, f_max_h, f_max_w = cfg\n    grid_h = random.randint(h_min, h_max)\n    grid_w = random.randint(w_min, w_max)\n\n    # --- Build frames ---\n    frames = []\n    for color, target_rooms in zip(frame_colors, room_counts):\n        frame_data = _build_frame(target_rooms, max_h=f_max_h, max_w=f_max_w)\n        if frame_data is None:\n            return None\n        fh, fw = frame_data.shape\n        if fh > grid_h - 2 or fw > grid_w - 2:\n            return None\n        frames.append((color, target_rooms, frame_data))\n\n    # --- Place frames (largest first, random position) ---\n    positions = [None] * frame_count\n    for idx in sorted(range(frame_count), key=lambda i: -frames[i][2].size):\n        fh, fw = frames[idx][2].shape\n        positions[idx] = (random.randint(0, grid_h - fh), random.randint(0, grid_w - fw))\n\n    # --- Force overlaps for tied pairs ---\n    tied_pairs = [(i, j) for i in range(frame_count) for j in range(i + 1, frame_count)\n                  if room_counts[i] == room_counts[j]]\n    for i, j in tied_pairs:\n        _force_overlap(positions, i, j, frames, grid_h, grid_w)\n\n    # --- Force some non-tied overlaps ---\n    non_tied = [(i, j) for i in range(frame_count) for j in range(i + 1, frame_count)\n                if room_counts[i] != room_counts[j]]\n    n_extra = random.randint(*_EXTRA_OVERLAP_RANGE)\n    if n_extra > 0 and non_tied:\n        random.shuffle(non_tied)\n        for i, j in non_tied[:min(n_extra, len(non_tied))]:\n            _force_overlap(positions, i, j, frames, grid_h, grid_w)\n\n    # --- Render and add noise ---\n    render_order = list(range(frame_count))\n    random.shuffle(render_order)\n\n    grid, frame_mask = _render_frames(frames, positions, render_order, grid_h, grid_w)\n    _scatter_noise(grid, frame_mask, noise_color, grid_h, grid_w)\n\n    # --- Validate via solver oracle ---\n    try:\n        output = main(grid)\n    except Exception:\n        return None\n\n    # Build expected output: rows sorted by (room_count, render_order position)\n    frame_info = sorted(\n        [(room_counts[i], render_order.index(i), frame_colors[i]) for i in range(frame_count)])\n    max_rooms = max(rc for rc, _, _ in frame_info)\n    expected = np.full((frame_count, max_rooms), noise_color, dtype=int)\n    for r, (rc, _, color) in enumerate(frame_info):\n        expected[r, :rc] = color\n\n    return grid if np.array_equal(output, expected) else None\n\n\ndef generate_input() -> np.ndarray:\n\n=====SPLIT=====\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {_GEN_RETRIES} attempts\")\n\n=====FILE=====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill partitioned regions with concentric colored bands derived from marker pixels.\n\n    Input structure:\n    - Grid partitioned into regions by wall-colored lines.\n    - Each region has a dominant base color and a few isolated marker pixels of other colors at varying depths from the region boundary.\n\n    Rule:\n    - For each region, read marker colors ordered by their Chebyshev distance from the boundary to build a color palette.\n    - If no marker sits on the boundary itself, the base color leads the palette.\n    - Paint every cell with palette[distance mod palette_length], producing repeating concentric rectangular frames that radiate inward.\n\n    Key insight: Each marker's depth from the boundary defines its position in the cyclic palette; the pattern then tiles inward automatically.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    # Global background and wall color (the main partition lines).\n    bg = _mode(g)\n    other = g[g != bg]\n    wall = bg if other.size == 0 else _mode(other)\n\n    out = g.copy()\n    free = g != wall\n    comps = _cc4(free)\n\n    for pts in comps:\n        # Build component mask\n        comp_mask = np.zeros((h, w), dtype=bool)\n        for r, c in pts:\n            comp_mask[r, c] = True\n\n        vals = g[comp_mask]\n        base = _mode(vals)\n        dist = _boundary_distance(comp_mask)\n\n        # Markers are cells whose color differs from the region base.\n        # Pick at most one marker color per distance (closest in reading order).\n        dist_to_color: dict[int, int] = {}\n        for r, c in pts:\n            v = int(g[r, c])\n            if v == base:\n                continue\n            d = int(dist[r, c])\n            if d < 0:\n                continue\n            if d not in dist_to_color:\n                dist_to_color[d] = v\n            else:\n                # stable tie-breaker: prefer earlier (r,c)\n                pass\n\n        palette: list[int] = []\n        if dist_to_color:\n            ds = sorted(dist_to_color.keys())\n            if ds[0] > 0:\n                palette.append(int(base))\n            for d in ds:\n                palette.append(int(dist_to_color[d]))\n        else:\n            palette = [int(base)]\n\n        m = len(palette)\n        for r, c in pts:\n            d = int(dist[r, c])\n            out[r, c] = palette[d % m]\n\n    return out\n\n# --------------- generator (attempt 1 (Claude)) ---------------\n\n# ---- Canvas bounds ----\nH_MIN, H_MAX = 10, 30                       # grid height range\nW_MIN, W_MAX = 13, 30                       # grid width range\n\n# ---- Wall subdivision ----\nN_SPLITS_MIN, N_SPLITS_MAX = 2, 5           # recursive subdivision rounds\nMIN_REGION_DIM = 3                          # each half must keep >= this min dim\n# Threshold for splitting: need MIN_REGION_DIM + 1 (wall) + MIN_REGION_DIM\nSPLITTABLE_LEN = 2 * MIN_REGION_DIM + 1     # 7\n\n# ---- Region count filter ----\nN_REGIONS_MIN, N_REGIONS_MAX = 3, 6\n\n# ---- Markers per region ----\nMARKERS_PER_REGION_MAX = 3                  # cap on markers placed per region\nMARKER_COUNT_WEIGHTS = [1, 2, 3, 3]         # weights for choosing 0/1/2/3 markers\nSTART_DIST_MAX = 1                          # start distance cap (0 or 1)\n\n# ---- Distinct marker colors across grid ----\nDISTINCT_MARKER_COLORS_MIN, DISTINCT_MARKER_COLORS_MAX = 3, 9\n\n# ---- Retry budget ----\nGEN_MAX_ATTEMPTS = 300\n\n# Corner -> (diagonal step dr, dc, base row, base col) as a function of bbox.\n# Encoded as (row_from, col_from, dr, dc): 0=r0, 1=r1 for row_from; similarly col.\n_CORNERS = [(0, 0, 1, 1), (0, 1, 1, -1), (1, 0, -1, 1), (1, 1, -1, -1)]\n\n\ndef _max_cheb_depth(h: int, w: int) -> int:\n    \"\"\"Max Chebyshev depth from boundary in an h x w rectangle.\"\"\"\n    return (min(h, w) - 1) // 2\n\n\ndef _place_walls(H: int, W: int, rng: random.Random):\n    \"\"\"\n    Build a wall mask by recursive rectangular subdivision.\n\n    Returns (wall_mask, region_bboxes). wall_mask[r, c] == 1 on wall cells.\n    Each bbox = (r0, c0, r1, c1) inclusive for a 4-connected free region.\n    \"\"\"\n    wall_mask = np.zeros((H, W), dtype=int)\n    rects = [(0, 0, H - 1, W - 1)]\n    n_splits = rng.randint(N_SPLITS_MIN, N_SPLITS_MAX)\n\n    for _ in range(n_splits):\n        # Find rects large enough to split on at least one axis.\n        candidates = []\n        for i, (r0, c0, r1, c1) in enumerate(rects):\n            can_h = (r1 - r0 + 1) >= SPLITTABLE_LEN\n            can_v = (c1 - c0 + 1) >= SPLITTABLE_LEN\n            if can_h or can_v:\n                candidates.append((i, can_h, can_v))\n        if not candidates:\n            break\n\n        i, can_h, can_v = rng.choice(candidates)\n        r0, c0, r1, c1 = rects.pop(i)\n        axes = ('h',) * can_h + ('v',) * can_v\n        axis = rng.choice(axes)\n\n        if axis == 'h':\n            rr = rng.randint(r0 + MIN_REGION_DIM, r1 - MIN_REGION_DIM)\n            wall_mask[rr, c0:c1 + 1] = 1\n            rects.append((r0, c0, rr - 1, c1))\n            rects.append((rr + 1, c0, r1, c1))\n        else:\n            cc = rng.randint(c0 + MIN_REGION_DIM, c1 - MIN_REGION_DIM)\n            wall_mask[r0:r1 + 1, cc] = 1\n            rects.append((r0, c0, r1, cc - 1))\n            rects.append((r0, cc + 1, r1, c1))\n\n    return wall_mask, rects\n\n\ndef _place_markers(rect, marker_pool: list, rng: random.Random):\n    \"\"\"\n    Produce 0..MARKERS_PER_REGION_MAX markers along a diagonal from one bbox corner.\n    Each marker = (dist, color, r, c) with consecutive Chebyshev distances.\n    \"\"\"\n    r0, c0, r1, c1 = rect\n    max_d = _max_cheb_depth(r1 - r0 + 1, c1 - c0 + 1)\n    upper = min(MARKERS_PER_REGION_MAX, max_d)\n    if upper <= 0:\n        return []\n\n    n = rng.choices(range(len(MARKER_COUNT_WEIGHTS)), weights=MARKER_COUNT_WEIGHTS)[0]\n    n = min(n, upper)\n    if n == 0:\n        return []\n\n    # start_d in [0, min(START_DIST_MAX, max_d - n)]; controls whether base leads palette.\n    start_d = rng.randint(0, min(START_DIST_MAX, max_d - n))\n\n    row_from, col_from, dr, dc = rng.choice(_CORNERS)\n    br = r0 if row_from == 0 else r1\n    bc = c0 if col_from == 0 else c1\n\n    colors = rng.sample(marker_pool, n)\n    return [(start_d + k, col, br + dr * (start_d + k), bc + dc * (start_d + k))\n            for k, col in enumerate(colors)]\n\n\ndef _pick_palette(rng: random.Random):\n    \"\"\"Pick bg, wall, and the remaining 8-color marker pool (all distinct).\"\"\"\n    colors = list(range(10))\n    bg = rng.choice(colors)\n    colors.remove(bg)\n    wall = rng.choice(colors)\n    colors.remove(wall)\n    return bg, wall, colors\n\n\ndef _stamp_markers(grid, rects, bg, marker_pool, rng):\n    \"\"\"\n    Place markers into grid (in place). Returns the set of colors used, or\n    None if any marker would land outside its rect or overwrite non-bg.\n    \"\"\"\n    used = set()\n    for rect in rects:\n        for _d, col, rr, cc in _place_markers(rect, marker_pool, rng):\n            if not (rect[0] <= rr <= rect[2] and rect[1] <= cc <= rect[3]):\n                return None\n            if grid[rr, cc] != bg:\n                return None\n            grid[rr, cc] = col\n            used.add(col)\n    return used\n\n\ndef _validate_color_order(grid, bg, wall):\n    \"\"\"Confirm bg is mode and wall is second mode of the assembled grid.\"\"\"\n    vals, counts = np.unique(grid, return_counts=True)\n    order = np.argsort(-counts)\n    if int(vals[order[0]]) != bg:\n        return False\n    return len(order) >= 2 and int(vals[order[1]]) == wall\n\n\ndef _gen_attempt(rng: random.Random):\n    H = rng.randint(H_MIN, H_MAX)\n    W = rng.randint(W_MIN, W_MAX)\n\n    bg, wall, marker_pool = _pick_palette(rng)\n\n    wall_mask, rects = _place_walls(H, W, rng)\n    if not (N_REGIONS_MIN <= len(rects) <= N_REGIONS_MAX):\n        return None\n\n    grid = np.full((H, W), bg, dtype=int)\n    grid[wall_mask == 1] = wall\n\n    used = _stamp_markers(grid, rects, bg, marker_pool, rng)\n    if used is None:\n        return None\n    if not (DISTINCT_MARKER_COLORS_MIN <= len(used) <= DISTINCT_MARKER_COLORS_MAX):\n        return None\n    if not _validate_color_order(grid, bg, wall):\n        return None\n\n    # Final oracle: solver must produce a non-trivial transformation.\n    try:\n        out = main(grid)\n    except Exception:\n        return None\n    if np.array_equal(grid, out):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n\n=====SPLIT=====\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_MAX_ATTEMPTS):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(f\"generate_input failed after {GEN_MAX_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py && printf '\\\\n=====SPLIT=====\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py && printf '\\\\n=====FILE=====\\\\n' && sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py && printf '\\\\n=====SPLIT=====\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py && printf '\\\\n=====SPLIT=====\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py && printf '\\\\n=====FILE=====\\\\n' && sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py && printf '\\\\n=====SPLIT=====\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n    h, w = canvas_mask.shape\n    sr, sc = seed\n    if not canvas_mask[sr, sc]:\n        return None\n    blob = {(sr, sc)}\n    frontier = []\n    def push_neighbors(r, c):\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:\n                frontier.append((nr, nc))\n    push_neighbors(sr, sc)\n    while len(blob) < target_size and frontier:\n        idx = rng.randrange(len(frontier))\n        r, c = frontier.pop(idx)\n        if (r, c) in blob or not canvas_mask[r, c]:\n            continue\n        blob.add((r, c))\n        push_neighbors(r, c)\n    if len(blob) < target_size:\n        return None\n    return blob\n\n\ndef _blob_wall_cells(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n    wall = set()\n    for r, c in blob:\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in blob:\n                wall.add((nr, nc))\n    return wall\n\n\ndef _fill_holes(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Return blob with interior holes absorbed.\n\n    Barrier = blob union its wall ring. Any non-barrier cell unreachable from the grid\n    border through non-barrier cells is trapped and gets absorbed into the blob.\n    \"\"\"\n    walls = _blob_wall_cells(blob, h, w)\n    barrier = np.zeros((h, w), dtype=bool)\n    for r, c in blob:\n        barrier[r, c] = True\n    for r, c in walls:\n        barrier[r, c] = True\n\n    # Flood-fill from border through non-barrier cells.\n    reachable = np.zeros((h, w), dtype=bool)\n    stack = []\n    for r in range(h):\n        for c in (0, w - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    for c in range(w):\n        for r in (0, h - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    while stack:\n        r, c = stack.pop()\n        if reachable[r, c] or barrier[r, c]:\n            continue\n        reachable[r, c] = True\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and not reachable[nr, nc] and not barrier[nr, nc]:\n                stack.append((nr, nc))\n\n    trapped = (~reachable) & (~barrier)\n    if not trapped.any():\n        return blob\n    filled = set(blob)\n    for r, c in np.argwhere(trapped):\n        filled.add((int(r), int(c)))\n    return filled\n\n\n# ── Slide helpers ─────────────────────────────────────────────────\n\ndef _slide_step_valid(region_set: set, r: int, c: int, dr: int, dc: int) -> bool:\n    nr, nc = r + dr, c + dc\n    if (nr, nc) not in region_set:\n        return False\n    if dr != 0 and dc != 0:\n        if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n            return False\n    return True\n\n\ndef _forward_slide(region_set: set, start: tuple[int, int], dr: int, dc: int,\n                   blocked: set) -> tuple[int, int]:\n    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n    r, c = start\n    while True:\n        if not _slide_step_valid(region_set, r, c, dr, dc):\n            break\n        nr, nc = r + dr, c + dc\n        if (nr, nc) in blocked:\n            break\n        r, c = nr, nc\n    return (r, c)\n\n\n# ── Generator phases ─────────────────────────────────────────────\n\ndef _place_legends(rng: random.Random, grid: np.ndarray,\n                   ) -> tuple[np.ndarray, list[tuple[int, tuple[int,int]]]]:\n    \"\"\"Place 1-2 legend patches at grid corners.\n\n    Returns (legend_occupied mask, list of (wall_color, direction) pairs).\n    \"\"\"\n    h, w = grid.shape\n    n_legends = rng.choice([1, 2])\n    corners = rng.sample(CORNERS, n_legends)\n    wall_colors = rng.sample(WALL_COLOR_CHOICES, n_legends)\n\n    legend_occupied = np.zeros((h, w), dtype=bool)\n    legends = []\n\n    for corner, wc in zip(corners, wall_colors):\n        if rng.random() < CARDINAL_PROB:\n            dr, dc = rng.choice(CARDINAL_DIRS)\n            patch = _legend_5x5(wc, dr, dc)\n        else:\n            dr, dc = rng.choice(DIAGONAL_DIRS)\n            patch = _legend_6x7(wc, dr, dc)\n        ph, pw = patch.shape\n        r0, c0 = _corner_origin(corner, h, w, ph, pw)\n        paste(grid, patch, r0, c0)\n        # Reserve legend cells + buffer.\n        r_lo, r_hi = max(0, r0 - LEGEND_BUFFER), min(h, r0 + ph + LEGEND_BUFFER)\n        c_lo, c_hi = max(0, c0 - LEGEND_BUFFER), min(w, c0 + pw + LEGEND_BUFFER)\n        legend_occupied[r_lo:r_hi, c_lo:c_hi] = True\n        legends.append((wc, (dr, dc)))\n\n    return legend_occupied, legends\n\n\ndef _grow_regions(rng: random.Random, legends: list[tuple[int, tuple[int,int]]],\n                  legend_occupied: np.ndarray,\n                  ) -> list[dict] | None:\n    \"\"\"Grow irregular closed regions, one per assigned wall color.\n\n    Returns list of region dicts or None on failure.\n    \"\"\"\n    h, w = legend_occupied.shape\n    color_dir = {wc: d for wc, d in legends}\n    all_colors = [wc for wc, _ in legends]\n\n    # Assign 1-3 regions per wall color, cap total.\n    region_colors = []\n    for c in all_colors:\n        region_colors.extend([c] * rng.randint(*REGIONS_PER_COLOR))\n    if len(region_colors) > MAX_TOTAL_REGIONS:\n        region_colors = rng.sample(region_colors, MAX_TOTAL_REGIONS)\n    rng.shuffle(region_colors)\n\n    size_min, size_max = REGION_SIZE_BOUNDS[len(region_colors)]\n    occupied = legend_occupied.copy()\n    regions = []\n\n    for rc in region_colors:\n        dr, dc = color_dir[rc]\n        target_size = rng.randint(size_min, size_max)\n\n        # Build canvas: interior cells (not border) that are unoccupied.\n        canvas = np.ones((h, w), dtype=bool)\n        canvas[0, :] = False; canvas[-1, :] = False\n        canvas[:, 0] = False; canvas[:, -1] = False\n        canvas &= ~occupied\n        if not canvas.any():\n            continue\n\n        blob = _try_grow_valid_blob(rng, canvas, occupied, target_size, h, w)\n        if blob is None:\n            continue\n\n        walls = _blob_wall_cells(blob, h, w)\n        regions.append({'color': rc, 'dir': (dr, dc), 'interior': blob, 'walls': walls})\n\n        # Reserve blob + walls + 1-cell buffer around walls.\n        reserve = blob | walls\n        extra = set()\n        for r, c in walls:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in reserve:\n                    extra.add((nr, nc))\n        for r, c in reserve | extra:\n            occupied[r, c] = True\n\n    if not regions:\n        return None\n    # Every legend color must have at least one region.\n    if {reg['color'] for reg in regions} != set(all_colors):\n        return None\n    return regions\n\n\ndef _try_grow_valid_blob(rng: random.Random, canvas: np.ndarray,\n                         occupied: np.ndarray, target_size: int,\n                         h: int, w: int) -> set[tuple[int,int]] | None:\n    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n    for _ in range(BLOB_GROW_RETRIES):\n        free = np.argwhere(canvas)\n        if len(free) == 0:\n            break\n        sr, sc = free[rng.randrange(len(free))]\n        cand = _grow_blob(canvas, (int(sr), int(sc)), target_size, rng)\n        if cand is None:\n            continue\n        # Fill interior holes until stable.\n        while True:\n            filled = _fill_holes(cand, h, w)\n            if filled == cand:\n                break\n            cand = filled\n        # Absorbed cells must stay within canvas.\n        if any(not canvas[r, c] for r, c in cand):\n            continue\n        walls = _blob_wall_cells(cand, h, w)\n        # Walls must not overlap occupied cells or the grid border.\n        if any(occupied[wr, wc] or wr in (0, h - 1) or wc in (0, w - 1)\n               for wr, wc in walls):\n            continue\n        return cand\n    return None\n\n\ndef _validate_topology(grid: np.ndarray, regions: list[dict]) -> bool:\n    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n    h, w = grid.shape\n    labeled, n_comp = label_mask(grid == 0, connectivity=4)\n    bounded = []\n    for comp_id in range(1, n_comp + 1):\n        coords = np.argwhere(labeled == comp_id)\n        if any(r in (0, h - 1) or c in (0, w - 1) for r, c in coords):\n            continue\n        bounded.append({(int(r), int(c)) for r, c in coords})\n    region_sets = [reg['interior'] for reg in regions]\n    if len(bounded) != len(region_sets):\n        return False\n    return all(comp in region_sets for comp in bounded)\n\n\ndef _place_yellows(rng: random.Random, regions: list[dict],\n                   grid: np.ndarray) -> bool:\n    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n\n    Modifies grid in-place by painting yellow(4) at input positions.\n    Returns True on success.\n    \"\"\"\n    for reg in regions:\n        blob = reg['interior']\n        dr, dc = reg['dir']\n        n_yellows = rng.choice(YELLOWS_PER_REGION)\n\n        # Cells sorted by projection onto slide direction (farthest first).\n        cells_sorted = sorted(blob, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n        far_key = dr * cells_sorted[0][0] + dc * cells_sorted[0][1]\n        tier1 = [p for p in cells_sorted if dr * p[0] + dc * p[1] == far_key]\n\n        # Pick output positions: first at the farthest tier, second one step behind or at tier1.\n        first = tier1[rng.randrange(len(tier1))]\n        output_positions = [first]\n\n        if n_yellows == 2:\n            pr, pc = first[0] - dr, first[1] - dc\n            cands = ([(pr, pc)] if (pr, pc) in blob else []) + [p for p in tier1 if p != first]\n            if cands:\n                second = cands[rng.randrange(len(cands))]\n                if second != first:\n                    output_positions.append(second)\n\n        # Reverse-slide: process in solver order (far-to-near).\n        out_sorted = sorted(output_positions, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n        already_stopped = set()\n        yellows_input = []\n\n        for out_pos in out_sorted:\n            candidate = _find_reverse_slide(blob, out_pos, dr, dc, already_stopped,\n                                            yellows_input, rng)\n            if candidate is None:\n                return False\n            yellows_input.append(candidate)\n            already_stopped.add(out_pos)\n\n        for r, c in yellows_input:\n            grid[r, c] = 4\n    return True\n\n\ndef _find_reverse_slide(blob: set, out_pos: tuple[int,int], dr: int, dc: int,\n                        already_stopped: set, existing_inputs: list,\n                        rng: random.Random) -> tuple[int,int] | None:\n    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n    target_steps = rng.randint(1, MAX_SLIDE_STEPS)\n    for steps in range(target_steps, 0, -1):\n        r, c = out_pos\n        path_ok = True\n        for _ in range(steps):\n            pr, pc = r - dr, c - dc\n            if (pr, pc) not in blob or (pr, pc) in already_stopped or (pr, pc) in existing_inputs:\n                path_ok = False\n                break\n            if dr != 0 and dc != 0:\n                if (pr + dr, pc) not in blob or (pr, pc + dc) not in blob:\n                    path_ok = False\n                    break\n            r, c = pr, pc\n        if not path_ok:\n            continue\n        if _forward_slide(blob, (r, c), dr, dc, already_stopped) == out_pos:\n            return (r, c)\n    return None\n\n\ndef _oracle_check(input_grid: np.ndarray, regions: list[dict]) -> bool:\n    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n    h, w = input_grid.shape\n    try:\n        solver_out = main(input_grid)\n    except Exception:\n        return False\n    # Non-yellow, non-bg cells must be identical.\n    struct_mask = (input_grid != 4) & (input_grid != 0)\n    if not np.array_equal(solver_out[struct_mask], input_grid[struct_mask]):\n        return False\n    # Yellow count must be preserved.\n    if (solver_out == 4).sum() != (input_grid == 4).sum():\n        return False\n    # All output yellows must lie inside known region interiors.\n    regions_mask = np.zeros((h, w), dtype=bool)\n    for reg in regions:\n        for r, c in reg['interior']:\n            regions_mask[r, c] = True\n    return bool(np.all(regions_mask[solver_out == 4]))\n\n\n# ── Main generator ────────────────────────────────────────────────\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    h, w = GRID_H, GRID_W\n    grid = np.zeros((h, w), dtype=int)\n\n    legend_occupied, legends = _place_legends(rng, grid)\n    regions = _grow_regions(rng, legends, legend_occupied)\n    if regions is None:\n        return None\n\n    # Paint walls.\n    for reg in regions:\n        for r, c in reg['walls']:\n            grid[r, c] = reg['color']\n\n    if not _validate_topology(grid, regions):\n        return None\n\n    input_grid = grid.copy()\n    if not _place_yellows(rng, regions, input_grid):\n        return None\n    if not _oracle_check(input_grid, regions):\n        return None\n    return input_grid\n\n\ndef generate_input() -> np.ndarray:\n\n=====SPLIT=====\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\n\n=====FILE=====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the one blank in each corner region so all four regions have the same color multiset.\n\n    Input structure:\n    - The dominant background color forms one solid separator row and one solid\n      separator column.\n    - The separator cross splits the grid into four equal rectangular corner regions.\n    - Each corner region contains exactly one background-colored blank pixel.\n\n    Rule:\n    - Count the non-background colors in each corner region.\n    - The completed region multiset is defined by the maximum observed count of\n      each color across the four regions.\n    - Replace each region's blank pixel with the single color needed to match that\n      completed multiset.\n\n    Key insight:\n    - The separator color inside a corner region is a missing value marker; comparing\n      the four regions reveals the shared multiset without using numeric color order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    color_counts = Counter(map(int, g.reshape(-1)))\n    assert all(\n        color == bg or count < color_counts[bg] for color, count in color_counts.items()\n    ), \"background color must be uniquely dominant\"\n\n    cross_row, cross_col = _solid_separator_cross(g, bg)\n    regions = _quadrants(cross_row, cross_col, height, width)\n    region_shape = g[regions[0]].shape\n    region_area = int(np.prod(region_shape))\n\n    counts_by_region: list[Counter[int]] = []\n    blank_positions: list[tuple[int, int]] = []\n    for row_slice, col_slice in regions:\n        region = g[row_slice, col_slice]\n        assert region.shape == region_shape, \"all corner regions must have the same shape\"\n        blanks = np.argwhere(region == bg)\n        assert len(blanks) == 1, \"each corner region must have exactly one blank\"\n\n        counts_by_region.append(Counter(map(int, region[region != bg].reshape(-1))))\n        local_r, local_c = map(int, blanks[0])\n        blank_positions.append((row_slice.start + local_r, col_slice.start + local_c))\n\n    target_counts: Counter[int] = Counter()\n    for counts in counts_by_region:\n        for color, count in counts.items():\n            target_counts[color] = max(target_counts[color], count)\n    assert sum(target_counts.values()) == region_area, \"completed region multiset must be unique\"\n\n    out = g.copy()\n    for counts, (row, col) in zip(counts_by_region, blank_positions):\n        missing = target_counts - counts\n        assert len(missing) == 1, \"each blank must have exactly one matching fill color\"\n        fill_color, fill_count = next(iter(missing.items()))\n        assert fill_count == 1, \"each corner region must need one pixel of the fill color\"\n        out[row, col] = fill_color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n# Canvas/palette bounds.\nGRID_HALF_MIN = 2\nGRID_HALF_MAX = 6\nCOLOR_COUNT = 10\nMIN_TARGET_COLORS = 3\nMAX_NON_BG_COLORS = COLOR_COUNT - 1\n# Layout probabilities and constraints.\nPREFERRED_GRID_HALF = (2, 2)\nPREFERRED_GRID_PROB = 0.65\nQUADRANT_COUNT = 4\nSEPARATOR_WIDTH = 1\nBG_DOMINANCE_MARGIN = 1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _gen_bounded_composition(total: int, parts: int, max_each: int) -> list[int] | None:\n    if parts <= 0 or total < parts or total > parts * max_each:\n        return None\n\n    counts = []\n    remaining = total\n    for i in range(parts):\n        slots_left = parts - i - 1\n        lo = max(1, remaining - slots_left * max_each)\n        hi = min(max_each, remaining - slots_left)\n        counts.append(random.randint(lo, hi))\n        remaining -= counts[-1]\n\n    random.shuffle(counts)\n    return counts\n\n\ndef _gen_grid_options() -> list[tuple[int, int, list[int], int]]:\n    options = []\n    for k in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n        for m in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n            area = k * m\n            bg_count = 2 * k + 2 * m + SEPARATOR_WIDTH + QUADRANT_COUNT\n            max_target_count = (bg_count - BG_DOMINANCE_MARGIN) // QUADRANT_COUNT\n            max_colors = min(MAX_NON_BG_COLORS, area)\n            valid_counts = [\n                c\n                for c in range(MIN_TARGET_COLORS, max_colors + 1)\n                if area <= c * max_target_count\n            ]\n            if valid_counts:\n                options.append((k, m, valid_counts, max_target_count))\n    return options\n\n\ndef _gen_pick_grid_option() -> tuple[int, int, list[int], int]:\n    options = _gen_grid_options()\n    if random.random() < PREFERRED_GRID_PROB:\n        preferred_k, preferred_m = PREFERRED_GRID_HALF\n        for option in options:\n            if option[0] == preferred_k and option[1] == preferred_m:\n                return option\n    return random.choice(options)\n\n\ndef _gen_quadrant_offsets(k: int, m: int) -> list[tuple[int, int]]:\n    sep = SEPARATOR_WIDTH\n    return [(0, 0), (0, m + sep), (k + sep, 0), (k + sep, m + sep)]\n\n\ndef _gen_missing_colors(non_bg_colors: list[int]) -> list[int]:\n    missing_colors = [random.choice(non_bg_colors) for _ in range(QUADRANT_COUNT)]\n    if len(set(missing_colors)) == 1:\n        alternatives = [c for c in non_bg_colors if c != missing_colors[0]]\n        missing_colors[-1] = random.choice(alternatives)\n    return missing_colors\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = random.randrange(COLOR_COUNT)\n    k, m, valid_color_counts, max_target_count = _gen_pick_grid_option()\n    area = k * m\n\n    color_count = random.choice(valid_color_counts)\n    non_bg_colors = random.sample([c for c in range(COLOR_COUNT) if c != bg], color_count)\n    target_counts = _gen_bounded_composition(area, color_count, max_target_count)\n    if target_counts is None:\n        return None\n\n    target_values = []\n    for color, count in zip(non_bg_colors, target_counts):\n        target_values.extend([color] * count)\n\n    missing_colors = _gen_missing_colors(non_bg_colors)\n    out = np.full((2 * k + SEPARATOR_WIDTH, 2 * m + SEPARATOR_WIDTH), bg, dtype=int)\n    inp = out.copy()\n\n    for (r0, c0), missing_color in zip(_gen_quadrant_offsets(k, m), missing_colors):\n        values = target_values[:]\n        random.shuffle(values)\n        quadrant_out = np.array(values, dtype=int).reshape(k, m)\n\n        candidates = np.argwhere(quadrant_out == missing_color)\n        blank_r, blank_c = map(int, candidates[random.randrange(len(candidates))])\n        quadrant_in = quadrant_out.copy()\n        quadrant_in[blank_r, blank_c] = bg\n\n        out[r0 : r0 + k, c0 : c0 + m] = quadrant_out\n        inp[r0 : r0 + k, c0 : c0 + m] = quadrant_in\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n\n=====SPLIT=====\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid e3fe1151 input\")\n","exit_code":0,"status":"completed"}}
