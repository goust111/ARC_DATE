{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport random\nimport numpy as np\nfrom scipy.ndimage import label as scipy_label\nfrom arc_utils import bbox_h, bbox_w, find_components, in_bounds, neighbors4, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n\n\ndef _bfs_placement(feasible, sr, sc):\n    h2, w2 = feasible.shape\n    dist = -np.ones((h2, w2), dtype=int)\n    dist[sr, sc] = 0\n    q = deque([(sr, sc)])\n    while q:\n        r, c = q.popleft()\n        for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:\n                dist[rr, cc] = dist[r, c] + 1\n                q.append((rr, cc))\n    return dist\n\n\ndef _hamiltonian_walk(rows, cols, start, end):\n    total = rows * cols\n    best_path = None\n    best_len = 0\n    for _attempt in range(80):\n        visited = {start}\n        path = [start]\n        cur = start\n        while True:\n            if cur == end and len(path) >= total * 0.7:\n                if len(path) > best_len:\n                    best_path = list(path)\n                    best_len = len(path)\n                break\n            neighbors = []\n            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                nr, nc = cur[0] + dr, cur[1] + dc\n                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:\n                    neighbors.append((nr, nc))\n            if not neighbors:\n                break\n            valid = []\n            for nb in neighbors:\n                if nb == end:\n                    valid.append(nb)\n                    continue\n                test_visited = visited | {nb}\n                seen = {end}\n                q = deque([end])\n                while q:\n                    cr, cc = q.popleft()\n                    for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                        nr2, nc2 = cr + dr2, cc + dc2\n                        if (0 <= nr2 < rows and 0 <= nc2 < cols and\n                                (nr2, nc2) not in test_visited and (nr2, nc2) not in seen):\n                            seen.add((nr2, nc2))\n                            q.append((nr2, nc2))\n                for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                    ar, ac = nb[0] + dr2, nb[1] + dc2\n                    if (0 <= ar < rows and 0 <= ac < cols and\n                            (ar, ac) not in test_visited and (ar, ac) in seen):\n                        valid.append(nb)\n                        break\n            if not valid:\n                break\n            random.shuffle(valid)\n            nxt = valid[0]\n            visited.add(nxt)\n            path.append(nxt)\n            cur = nxt\n        if best_path and best_len >= total * 0.85:\n            break\n    return best_path\n\n\ndef _render_channel(grid, path, n, offsets_r, offsets_c):\n    pixel_pos = []\n    for cr, cc in path:\n        pr, pc = offsets_r[cr], offsets_c[cc]\n        pixel_pos.append((pr, pc))\n        grid[pr:pr + n, pc:pc + n] = _RIVER\n    for i in range(len(path) - 1):\n        pr1, pc1 = pixel_pos[i]\n        pr2, pc2 = pixel_pos[i + 1]\n        if pr1 == pr2:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n            grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER\n        else:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n            grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER\n    return pixel_pos\n\n\ndef _add_chokepoint(grid, pixel_pos_i, pixel_pos_j, n, direction):\n    H, W = grid.shape\n    pr1, pc1 = pixel_pos_i\n    pr2, pc2 = pixel_pos_j\n    narrow_w = random.randint(1, n - 1)\n    remove = n - narrow_w\n    side = random.randint(0, 1)\n\n    if direction == 'h':\n        c_lo = min(pc1, pc2) + n\n        c_hi = max(pc1, pc2)\n        if c_hi <= c_lo:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        c_mid = (c_lo + c_hi) // 2\n        c_start = max(c_lo, c_mid - total_len // 2)\n        for step in range(total_len):\n            c = c_start + step\n            if c < 0 or c >= W:\n                continue\n            if step < remove:\n                depth = step + 1\n            elif step >= total_len - remove:\n                depth = total_len - step\n            else:\n                depth = remove\n            for k in range(depth):\n                rr = pr1 + k if side == 0 else pr1 + n - 1 - k\n                if 0 <= rr < H and 0 <= c < W:\n                    grid[rr, c] = _BG\n    else:\n        r_lo = min(pr1, pr2) + n\n        r_hi = max(pr1, pr2)\n        if r_hi <= r_lo:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        r_mid = (r_lo + r_hi) // 2\n        r_start = max(r_lo, r_mid - total_len // 2)\n        for step in range(total_len):\n            r = r_start + step\n            if r < 0 or r >= H:\n                continue\n            if step < remove:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/e9fc42f2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/e9fc42f2.py\"","aggregated_output":"from collections import defaultdict, deque\n\nimport numpy as np\n\nfrom arc_utils import crop_bbox, find_components, get_bg, paste, random_free_location\nimport math\nimport random\n\n\ndef _connector_dir(sprite: np.ndarray, r: int, c: int) -> tuple[int, int]:\n    h, w = sprite.shape\n    dirs: list[tuple[int, int]] = []\n    if r == 0:\n        dirs.append((-1, 0))\n    if r == h - 1:\n        dirs.append((1, 0))\n    if c == 0:\n        dirs.append((0, -1))\n    if c == w - 1:\n        dirs.append((0, 1))\n    assert len(dirs) == 1\n    return dirs[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Assemble the foreground objects by docking equal-colored boundary markers edge-to-edge.\n\n    Input structure\n    The grid has a dominant background color and several 4-connected multicolor foreground\n    objects.  One foreground color is the body color; the less frequent foreground colors are\n    boundary connector markers, and each marker color appears once as a free end or twice as a\n    matched docking pair.\n\n    Rule\n    Crop each foreground object to its bounding box and translate the objects so that the two\n    occurrences of every paired connector color touch on their exposed boundary sides.  Preserve\n    each object's orientation and colors, then return the tight crop around the assembled\n    foreground on the original background color.\n\n    Key insight\n    The colored marker pixels are ports: matching colors specify which objects must touch, and\n    the marker's side of its object determines the direction of the translation.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    fg = g[g != bg]\n    assert fg.size > 0\n    values, counts = np.unique(fg, return_counts=True)\n    max_count = int(counts.max())\n    body_candidates = [int(v) for v, n in zip(values, counts) if int(n) == max_count]\n    assert len(body_candidates) == 1\n    body = body_candidates[0]\n    marker_colors = {int(v) for v in values if int(v) != body}\n    assert marker_colors\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert len(components) >= 2\n\n    sprites: list[np.ndarray] = []\n    marker_occurrences: dict[int, list[tuple[int, tuple[int, int], tuple[int, int]]]] = defaultdict(list)\n    for idx, comp in enumerate(components):\n        sprite = crop_bbox(g, comp[\"bbox\"])\n        sprites.append(sprite)\n        marker_locs = np.argwhere(np.isin(sprite, list(marker_colors)))\n        assert marker_locs.size > 0\n        for rr, cc in marker_locs:\n            r, c = int(rr), int(cc)\n            direction = _connector_dir(sprite, r, c)\n            marker_occurrences[int(sprite[r, c])].append((idx, (r, c), direction))\n\n    adjacency: list[list[tuple[int, tuple[int, int]]]] = [[] for _ in sprites]\n    paired_markers = 0\n    for occurrences in marker_occurrences.values():\n        assert len(occurrences) in (1, 2)\n        if len(occurrences) == 1:\n            continue\n        (a_idx, a_pos, a_dir), (b_idx, b_pos, b_dir) = occurrences\n        assert a_idx != b_idx\n        assert b_dir == (-a_dir[0], -a_dir[1])\n        delta = (a_pos[0] + a_dir[0] - b_pos[0], a_pos[1] + a_dir[1] - b_pos[1])\n        adjacency[a_idx].append((b_idx, delta))\n        adjacency[b_idx].append((a_idx, (-delta[0], -delta[1])))\n        paired_markers += 1\n    assert paired_markers == len(sprites) - 1\n\n    placements: dict[int, tuple[int, int]] = {0: (0, 0)}\n    queue = deque([0])\n    while queue:\n        idx = queue.popleft()\n        base_r, base_c = placements[idx]\n        for nbr, (dr, dc) in adjacency[idx]:\n            pos = (base_r + dr, base_c + dc)\n            if nbr in placements:\n                assert placements[nbr] == pos\n            else:\n                placements[nbr] = pos\n                queue.append(nbr)\n    assert len(placements) == len(sprites)\n\n    placed_fg: list[tuple[int, int]] = []\n    for idx, sprite in enumerate(sprites):\n        base_r, base_c = placements[idx]\n        for rr, cc in np.argwhere(sprite != bg):\n            placed_fg.append((base_r + int(rr), base_c + int(cc)))\n\n    r0 = min(r for r, _ in placed_fg)\n    c0 = min(c for _, c in placed_fg)\n    r1 = max(r for r, _ in placed_fg)\n    c1 = max(c for _, c in placed_fg)\n    out = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)\n\n    for idx, sprite in enumerate(sprites):\n        base_r, base_c = placements[idx]\n        rr, cc = base_r - r0, base_c - c0\n        mask = sprite != bg\n        target = out[rr : rr + sprite.shape[0], cc : cc + sprite.shape[1]]\n        assert target.shape == sprite.shape\n        assert not np.any((target != bg) & mask)\n        paste(out, sprite, rr, cc, transparent=bg)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette and marker vocabulary.\n_GEN_BG, _GEN_BODY = 2, 1\n_GEN_MARKERS = [3, 4, 8]\n\n# Port sides and their assembly directions.\n_GEN_SIDES = (\"T\", \"B\", \"L\", \"R\")\n_GEN_DIRS = {\"T\": (-1, 0), \"B\": (1, 0), \"L\": (0, -1), \"R\": (0, 1)}\n_GEN_OPPOSITE = {\"T\": \"B\", \"B\": \"T\", \"L\": \"R\", \"R\": \"L\"}\n\n# Canvas and scattering constraints.\n_GEN_CANVAS_SHAPE = (13, 13)\n_GEN_MAX_OUTPUT_SPAN = 13\n_GEN_SCATTER_PADDING, _GEN_PADDING_CONNECTIVITY = 2, 8\n_GEN_SHADOW_BG = 0\n\n# Sprite count, size, and special-case height controls.\n_GEN_SPRITE_COUNT_CHOICES = [2, 3, 4]\n_GEN_MIN_SPRITES, _GEN_MID_SPRITES, _GEN_MAX_SPRITES = 2, 3, 4\n_GEN_HEIGHT_RANGE, _GEN_COMPACT_HEIGHT_RANGE, _GEN_WIDTH_RANGE = (3, 8), (3, 6), (3, 6)\n_GEN_FOUR_SPRITE_HEIGHT_CHOICES = [3, 4, 5, 5, 6]\n_GEN_THREE_SPRITE_COMPACT_PROB = 0.7\n\n# Sprite fill and port-count constraints.\n_GEN_INTERIOR_MARGIN = 1\n_GEN_MIN_DENSITY, _GEN_MAX_DENSITY = 0.36, 0.89\n_GEN_MAX_PORTS_PER_SPRITE = 3\n\n# Generation retry budget.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_neighbors4(r, c, h, w):\n    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n        rr, cc = r + dr, c + dc\n        if 0 <= rr < h and 0 <= cc < w:\n            yield rr, cc\n\n\ndef _gen_boundary_coord(side, h, w):\n    low = _GEN_INTERIOR_MARGIN\n    if side == \"T\":\n        return 0, random.randint(low, w - 1 - low)\n    if side == \"B\":\n        return h - 1, random.randint(low, w - 1 - low)\n    if side == \"L\":\n        return random.randint(low, h - 1 - low), 0\n    return random.randint(low, h - 1 - low), w - 1\n\n\ndef _gen_inner_neighbor(side, r, c):\n    dr, dc = _GEN_DIRS[side]\n    return r - dr, c - dc\n\n\ndef _gen_add_path(cells, start, end):\n    r, c = start\n    er, ec = end\n    cells.add((r, c))\n    axes = [0, 1]\n    random.shuffle(axes)\n    for axis in axes:\n        while (axis == 0 and r != er) or (axis == 1 and c != ec):\n            if axis == 0:\n                r += 1 if er > r else -1\n            else:\n                c += 1 if ec > c else -1\n            cells.add((r, c))\n\n\ndef _gen_seed_sprite_cells(h, w, ports):\n    port_locs = {}\n    cells = set()\n    port_sides = {side for _, side in ports}\n\n    for color, side in ports:\n        r, c = _gen_boundary_coord(side, h, w)\n        port_locs[color] = (r, c)\n        cells.add((r, c))\n        cells.add(_gen_inner_neighbor(side, r, c))\n\n    for side in _GEN_SIDES:\n        if side in port_sides:\n            continue\n        r, c = _gen_boundary_coord(side, h, w)\n        cells.add((r, c))\n\n    return cells, port_locs\n\n\ndef _gen_connect_sprite_cells(cells, h, w):\n    low = _GEN_INTERIOR_MARGIN\n    center = (random.randint(low, h - 1 - low), random.randint(low, w - 1 - low))\n    cells.add(center)\n    for cell in list(cells):\n        _gen_add_path(cells, cell, center)\n\n\ndef _gen_frontier(cells, h, w):\n    return {\n        nbr\n        for r, c in cells\n        for nbr in _gen_neighbors4(r, c, h, w)\n        if nbr not in cells\n    }\n\n\ndef _gen_grow_sprite_cells(cells, h, w):\n    area = h * w\n    min_fg = max(len(cells), math.ceil(_GEN_MIN_DENSITY * area))\n    max_fg = math.floor(_GEN_MAX_DENSITY * area)\n    if min_fg > max_fg:\n        return False\n\n    target = random.randint(min_fg, max_fg)\n    while len(cells) < target:\n        frontier = _gen_frontier(cells, h, w)\n        if not frontier:\n            return False\n        cells.add(random.choice(tuple(frontier)))\n    return True\n\n\ndef _gen_paint_sprite(h, w, cells, ports, port_locs):\n    sprite = np.full((h, w), _GEN_BG, dtype=int)\n    for r, c in cells:\n        sprite[r, c] = _GEN_BODY\n    for color, _side in ports:\n        r, c = port_locs[color]\n        sprite[r, c] = color\n\n    for color, side in ports:\n        r, c = port_locs[color]\n        ir, ic = _gen_inner_neighbor(side, r, c)\n        if sprite[ir, ic] != _GEN_BODY:\n            return None\n","exit_code":0,"status":"completed"}}
