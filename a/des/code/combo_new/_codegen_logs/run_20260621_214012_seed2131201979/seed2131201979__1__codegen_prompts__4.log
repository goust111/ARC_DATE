{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, time\nfrom collections import deque\n\ndef enclosed(R,C,path,cycle=False):\n    nodes=[(r,c) for r in range(R) for c in range(C)]\n    idx=set(nodes)\n    adj={p:[q for q in nodes if abs(p[0]-q[0])+abs(p[1]-q[1])==1] for p in nodes}\n    edges={tuple(sorted((path[i],path[i+1]))) for i in range(len(path)-1)}\n    if cycle:\n        edges.add(tuple(sorted((path[-1],path[0]))))\n    seen=set(); enc=[]\n    for p in nodes:\n        if p in seen: continue\n        stack=[p]; seen.add(p); comp=[]; boundary=False\n        while stack:\n            u=stack.pop(); comp.append(u)\n            r,c=u\n            if r in (0,R-1) or c in (0,C-1): boundary=True\n            for v in adj[u]:\n                if tuple(sorted((u,v))) in edges: continue\n                if v not in seen:\n                    seen.add(v); stack.append(v)\n        if not boundary: enc.append(comp)\n    return enc\n\ndef random_hamiltonian_path(R,C,attempts=20000):\n    nodes=[(r,c) for r in range(R) for c in range(C)]\n    adj={p:[q for q in nodes if abs(p[0]-q[0])+abs(p[1]-q[1])==1] for p in nodes}\n    n=len(nodes)\n    for _ in range(attempts):\n        start=random.choice(nodes)\n        path=[start]; used={start}\n        while len(path)<n:\n            u=path[-1]\n            cand=[v for v in adj[u] if v not in used]\n            if not cand: break\n            random.shuffle(cand)\n            # warnsdorff\n            cand.sort(key=lambda v: sum(1 for w in adj[v] if w not in used))\n            v=cand[0]\n            path.append(v); used.add(v)\n        if len(path)==n:\n            yield path\n\nfor R,C in [(5,5),(5,6),(6,6),(4,5),(4,6)]:\n    found=False\n    t=time.time()\n    for path in random_hamiltonian_path(R,C,attempts=100000):\n        enc=enclosed(R,C,path,cycle=False)\n        if enc:\n            print('path',R,C,[len(c) for c in enc],path)\n            found=True\n            break\n        if path[0] in [q for q in [(path[-1][0]+1,path[-1][1]),(path[-1][0]-1,path[-1][1]),(path[-1][0],path[-1][1]+1),(path[-1][0],path[-1][1]-1)] if 0<=q[0]<R and 0<=q[1]<C]:\n            enc=enclosed(R,C,path,cycle=True)\n            if enc:\n                print('cycle',R,C,[len(c) for c in enc],path)\n                found=True\n                break\n    print('grid',R,C,'found',found,'time',time.time()-t)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
