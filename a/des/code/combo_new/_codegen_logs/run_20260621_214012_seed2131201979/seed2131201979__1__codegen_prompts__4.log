{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom collections import defaultdict\nshape=[(0,1),(0,2),(1,0),(1,1),(1,2),(1,3),(2,0),(2,1),(2,2),(2,3),(3,1),(3,2)]\nS=set(shape)\nadj={p:[q for q in shape if abs(p[0]-q[0])+abs(p[1]-q[1])==1] for p in shape}\nR=C=4\n\ndef enclosed(edges):\n    seen=set(); enc=[]\n    for p in shape:\n        if p in seen: continue\n        stack=[p]; seen.add(p); comp=[]; boundary=False\n        while stack:\n            u=stack.pop(); comp.append(u)\n            r,c=u\n            if r in (0,R-1) or c in (0,C-1): boundary=True\n            for v in adj[u]:\n                if tuple(sorted((u,v))) in edges: continue\n                if v not in seen:\n                    seen.add(v); stack.append(v)\n        if not boundary: enc.append(comp)\n    return enc\n\n# DFS all Hamiltonian paths maybe manageable 12 nodes\nfor start in shape:\n    path=[start]; used={start}\n    def dfs(u):\n        if len(path)==len(shape):\n            edges={tuple(sorted((path[i],path[i+1]))) for i in range(len(path)-1)}\n            enc=enclosed(edges)\n            if enc:\n                print('FOUND',start,[len(c) for c in enc],path)\n                raise SystemExit\n            return\n        cand=[v for v in adj[u] if v not in used]\n        cand.sort(key=lambda v: len([w for w in adj[v] if w not in used]))\n        for v in cand:\n            used.add(v); path.append(v)\n            dfs(v)\n            path.pop(); used.remove(v)\n    try:\n        dfs(start)\n    except SystemExit:\n        raise\nprint('none')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
