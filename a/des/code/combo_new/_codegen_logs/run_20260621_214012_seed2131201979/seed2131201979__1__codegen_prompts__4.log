{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nshape=[(0,0),(0,1),(0,2),(0,3),(1,0),(1,1),(1,2),(2,0)]\nshape_set=set(shape)\nadj={p:[q for q in shape if abs(p[0]-q[0])+abs(p[1]-q[1])==1] for p in shape}\nR=max(r for r,c in shape)+1; C=max(c for r,c in shape)+1\n\ndef encl(path):\n    edges={tuple(sorted((path[i],path[i+1]))) for i in range(len(path)-1)}\n    seen=set(); enc=[]\n    for p in shape:\n        if p in seen: continue\n        stack=[p]; seen.add(p); comp=[]; boundary=False\n        while stack:\n            u=stack.pop(); comp.append(u)\n            r,c=u\n            if r==0 or r==R-1 or c==0 or c==C-1:\n                boundary=True\n            for v in adj[u]:\n                if tuple(sorted((u,v))) in edges: continue\n                if v not in seen:\n                    seen.add(v); stack.append(v)\n        if not boundary: enc.append(comp)\n    return enc\n\nfor start in shape:\n    path=[start]; used={start}\n    def dfs(u):\n        if len(path)==len(shape):\n            enc=encl(path)\n            if not enc:\n                print('OPEN',path)\n                raise SystemExit\n            return\n        cand=[v for v in adj[u] if v not in used]\n        for v in cand:\n            used.add(v); path.append(v)\n            dfs(v)\n            path.pop(); used.remove(v)\n    try:\n        dfs(start)\n    except SystemExit:\n        raise\nprint('none')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
