\n                    enc=enclosed(shape,edges)\n                    if enc:\n                        print('n',n,'shape',norm,'path',path,'enc',enc)\n                        raise SystemExit\n                    return\n                cand=[v for v in adj[u] if v not in used]\n                cand.sort(key=lambda v: len([w for w in adj[v] if w not in used]))\n                for v in cand:\n                    used.add(v); path.append(v)\n                    dfs(v)\n                    path.pop(); used.remove(v)\n            try:\n                dfs(start)\n            except SystemExit:\n                raise\nfor n in range(6,8):\n    try:\n        find(n)\n    except SystemExit:\n        raise\nprint('none')\nPY\"","aggregated_output":"n 6 shape ((0, 0), (0, 1), (0, 2), (1, 2), (1, 3), (2, 3)) path [(0, 0), (0, 1), (0, 2), (1, 2), (1, 3), (2, 3)] enc [[(1, 2)]]\n","exit_code":0,"status":"completed"}}
