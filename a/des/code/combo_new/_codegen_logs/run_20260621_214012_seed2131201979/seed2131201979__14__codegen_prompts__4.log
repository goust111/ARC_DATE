{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport numpy as np\nfrom scipy.ndimage import label\nfrom arc_utils import get_bg, paste\nimport random\n\ndef apply_transform(arr: np.ndarray, flip_ud: bool = False, rot_k: int = 0) -> np.ndarray:\n    \"\"\"Positional-args helper (kept local; only used by this solver).\"\"\"\n    out = np.flipud(arr) if flip_ud else arr\n    return np.rot90(out, int(rot_k))\n\n\ndef transform_coords(coords, shape, flip_ud: bool = False, rot_k: int = 0):\n    \"\"\"Positional-args helper (kept local; only used by this solver).\"\"\"\n    mask = np.zeros(shape, dtype=bool)\n    for r, c in coords:\n        mask[int(r), int(c)] = True\n    out = apply_transform(mask, flip_ud=flip_ud, rot_k=rot_k)\n    return set(map(tuple, np.argwhere(out)))\n\n\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Dock train sprites onto station groups by matching coupler count, then orient via divider-color markers.\n\n    Input structure:\n    - bg; colored stripes (edge + internal) partition grid into rectangular regions.\n    - Color 8 forms train bodies; color 9 marks both isolated stations and train-attached couplers.\n    - Stripe-colored pixels on trains are orientation markers.\n\n    Rule:\n    - Stations = 8-connected 9-clusters not adjacent to any 8. Trains = components containing 8.\n    - Match train to station group where |couplers| == |station size|.\n    - Rotate/flip train so marker pixels face the same-color boundary stripe of the target region.\n    - Translate so couplers align exactly onto station cells; erase original position.\n\n    Key insight: Coupler count selects the docking target; marker color encodes which boundary stripe to face, fixing the unique orientation.\n    \"\"\"\n    inp = grid\n    grid = inp.copy()\n    H, W = grid.shape\n    bg = get_bg(grid)\n\n    # This puzzle's code is long because it reconstructs several \"structures\"\n    # that are implicit in the grid:\n    # - divider stripes (edge + internal) that partition the canvas into regions\n    # - station groups = 9-clusters not adjacent to any 8\n    # - train sprites = components containing 8 (with attached 9 \"couplers\")\n    # Then, for each train:\n    # - match target region by COUPLER COUNT (|couplers| == |station group|)\n    # - choose orientation by divider-color markers (face region boundary stripes)\n    # - translate so couplers land exactly onto the station group cells\n\n    def find_edge_stripes():\n        # Detect thick constant-color border stripes.\n        stripe = np.zeros((H, W), dtype=bool)\n        colors = set()\n        # Top edge\n        top_h = 0\n        for r in range(H):\n            row = grid[r, :]\n            if (row == row[0]).all() and row[0] != bg:\n                top_h += 1\n            else:\n                break\n        if top_h:\n            stripe[:top_h, :] = True\n            colors.add(int(grid[0, 0]))\n        # Bottom edge\n        bot_h = 0\n        for r in range(H - 1, -1, -1):\n            row = grid[r, :]\n            if (row == row[0]).all() and row[0] != bg:\n                bot_h += 1\n            else:\n                break\n        if bot_h:\n            stripe[H - bot_h :, :] = True\n            colors.add(int(grid[H - 1, 0]))\n        inner_r0, inner_r1 = top_h, H - bot_h\n        # Left edge (in inner rows)\n        left_w = 0\n        for c in range(W):\n            col = grid[inner_r0:inner_r1, c]\n            if col.size == 0:\n                break\n            if (col == col[0]).all() and col[0] != bg:\n                left_w += 1\n            else:\n                break\n        if left_w:\n            stripe[inner_r0:inner_r1, :left_w] = True\n            colors.add(int(grid[inner_r0, 0]))\n        # Right edge\n        right_w = 0\n        for c in range(W - 1, -1, -1):\n            col = grid[inner_r0:inner_r1, c]\n            if col.size == 0:\n                break\n            if (col == col[0]).all() and col[0] != bg:\n                right_w += 1\n            else:\n                break\n        if right_w:\n            stripe[inner_r0:inner_r1, W - right_w :] = True\n            colors.add(int(grid[inner_r0, W - 1]))\n        return stripe, colors, (top_h, bot_h, left_w, right_w)\n\n    def find_internal_stripes(edge_info):\n        # Detect internal constant-color stripes in the inner rectangle.\n        top_h, bot_h, left_w, right_w = edge_info\n        r0, r1, c0, c1 = top_h, H - bot_h, left_w, W - right_w\n        stripe = np.zeros((H, W), dtype=bool)\n        colors = set()\n        # Vertical internal stripes\n        c = c0\n        while c < c1:\n            col = grid[r0:r1, c]\n            if col.size and (col == col[0]).all() and col[0] != bg:\n                color = int(col[0])\n                c2 = c\n                while c2 + 1 < c1:\n                    col2 = grid[r0:r1, c2 + 1]\n                    if col2.size and (col2 == col2[0]).all() and int(col2[0]) == color:\n                        c2 += 1\n                    else:\n                        break\n                stripe[r0:r1, c : c2 + 1] = True\n                colors.add(color)\n                c = c2 + 1\n            else:\n                c += 1\n        # Horizontal internal stripes\n        r = r0\n        while r < r1:\n            row = grid[r, c0:c1]\n            if row.size and (row == row[0]).all() and row[0] != bg:\n                color = int(row[0])\n                r2 = r\n                while r2 + 1 < r1:\n                    row2 = grid[r2 + 1, c0:c1]\n                    if row2.size and (row2 == row2[0]).all() and int(row2[0]) == color:\n                        r2 += 1\n                    else:\n                        break\n                stripe[r : r2 + 1, c0:c1] = True\n                colors.add(color)\n                r = r2 + 1\n            else:\n                r += 1\n        return stripe, colors\n\n    def station_groups():\n        # Stations are 9 pixels with no adjacent 8 in the 8-neighborhood.\n        # Station groups are 8-connected components of those station pixels.\n        # Station 9s have no adjacent 8 in 8-neighborhood\n        sm = np.zeros((H, W), dtype=bool)\n        for r in range(H):\n            for c in range(W):\n                if grid[r, c] != 9:\n                    continue\n                ok = all(grid[r+dr, c+dc] != 8\n                        for dr in (-1, 0, 1) for dc in (-1, 0, 1)\n                        if (dr != 0 or dc != 0) and 0 <= r+dr < H and 0 <= c+dc < W)\n                if ok:\n                    sm[r, c] = True\n        # 8-connected clustering\n        struct = np.ones((3, 3), dtype=int)\n        lab, n = label(sm, structure=struct)\n        groups = []\n        for k in range(1, n + 1):\n            coords = np.argwhere(lab == k)\n            groups.append([(int(r), int(c)) for r, c in coords])\n        return groups\n\n    def regions_from_stripes(stripe_mask):\n        # Regions are connected components of all non-stripe cells.\n        non = ~stripe_mask\n        lab, n = label(non)\n        regs = []\n        for k in range(1, n + 1):\n            coords = np.argwhere(lab == k)\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            if (r1 - r0 + 1) >= 5 and (c1 - c0 + 1) >= 5:\n                regs.append({\"r0\": int(r0), \"r1\": int(r1), \"c0\": int(c0), \"c1\": int(c1)})\n        return regs\n\n    def boundary_dirs_for_region(reg, stripe_colors):\n        # For a region bbox, infer which stripe color borders each side.\n        # Returns map: stripe_color -> direction (0=up,1=right,2=down,3=left)\n        # Map stripe color -> direction (0=up, 1=right, 2=down, 3=left)\n        dirs = {}\n        r0, r1, c0, c1 = reg[\"r0\"], reg[\"r1\"], reg[\"c0\"], reg[\"c1\"]\n        if r0 - 1 >= 0:\n            mc = Counter(grid[r0 - 1, c0:c1 + 1].tolist()).most_common(1)[0][0]\n            if mc in stripe_colors:\n                dirs[int(mc)] = 0\n        if r1 + 1 < H:\n            mc = Counter(grid[r1 + 1, c0:c1 + 1].tolist()).most_common(1)[0][0]\n            if mc in stripe_colors:\n                dirs[int(mc)] = 2\n        if c0 - 1 >= 0:\n            mc = Counter(grid[r0:r1 + 1, c0 - 1].tolist()).most_common(1)[0][0]\n            if mc in stripe_colors:\n                dirs[int(mc)] = 3\n        if c1 + 1 < W:\n            mc = Counter(grid[r0:r1 + 1, c1 + 1].tolist()).most_common(1)[0][0]\n            if mc in stripe_colors:\n                dirs[int(mc)] = 1\n        return dirs\n\n    def xform_coords(coords, shape, flip_ud, rot_k):\n        \"\"\"Transform coords, return (list, new_shape).\"\"\"\n        result = transform_coords(coords, shape, flip_ud, rot_k)\n        new_shape = apply_transform(np.zeros(shape), flip_ud, rot_k).shape\n        return list(result), new_shape\n\n    def choose_best_op(train, divider_dirs):\n        # Pick orientation (flip/rot) that makes divider-color marker pixels\n        # \"face\" the region boundary stripe of the same color.\n        bbox0 = train[\"bbox\"]\n        H0, W0 = bbox0.shape\n        markers_by_color = defaultdict(list)\n        for v, r, c in train[\"marker_pixels\"]:\n            if v in divider_dirs:\n                markers_by_color[v].append((r, c))\n        assert markers_by_color, \"Each train must expose divider-colored markers\"\n        assert train[\"body9\"], \"Each train must carry at least one coupler\"\n        ref_r = sum(r for r, _ in train[\"body9\"]) / len(train[\"body9\"])\n        ref_c = sum(c for _, c in train[\"body9\"]) / len(train[\"body9\"])\n        best, best_score = (False, 0), -1\n        for flip_ud in (False, True):\n            for k in range(4):\n                ref_t = list(transform_coords([(int(round(ref_r)), int(round(ref_c)))], (H0, W0), flip_ud, k))\n                rr_ref, cc_ref = ref_t[0]\n                score = 0\n                for color, pts in markers_by_color.items():\n                    mr, mc = sum(r for r, _ in pts) / len(pts), sum(c for _, c in pts) / len(pts)\n                    m_t = list(transform_coords([(int(round(mr)), int(round(mc)))], (H0, W0), flip_ud, k))\n                    rr_m, cc_m = m_t[0]\n                    dr, dc = rr_m - rr_ref, cc_m - cc_ref\n                    dirc = (0 if dr < 0 else 2) if abs(dr) >= abs(dc) else (3 if dc < 0 else 1)\n                    if dirc == divider_dirs[color]:\n                        score += 1\n                if score > best_score:\n                    best_score, best = score, (flip_ud, k)\n        return best\n\n    # 1) Detect stripes and partition into regions\n    edge_mask, edge_colors, edge_info = find_edge_stripes()\n    internal_mask, internal_colors = find_internal_stripes(edge_info)\n    stripe_mask = edge_mask | internal_mask\n    stripe_colors = edge_colors | internal_colors\n    regions = regions_from_stripes(stripe_mask)\n\n    # 2) Station groups (targets)\n    groups = station_groups()\n    groups_by_size = defaultdict(list)\n    for g in groups:\n        groups_by_size[len(g)].append(g)\n    station_set = set(pt for g in groups for pt in g)\n\n    # 3) Trains (sources): CCs (excluding stripes) that contain 8.\n    #    Also record train-attached 9 couplers (9s NOT part of stations).\n    comp_mask = (grid != bg) & (~stripe_mask)\n    lab, n = label(comp_mask)\n    trains = []\n    for k in range(1, n + 1):\n        coords = np.argwhere(lab == k)\n        vals = [int(grid[r, c]) for r, c in coords]\n        if 8 not in vals:\n            continue\n        r0, c0 = coords.min(axis=0)\n        r1, c1 = coords.max(axis=0)\n        bbox = grid[r0:r1 + 1, c0:c1 + 1].copy()\n        abs_coords = [(int(r), int(c)) for r, c in coords]\n        body9, marker_pixels = [], []\n        for r, c in abs_coords:\n            v = int(grid[r, c])\n            if v == 9 and (r, c) not in station_set:\n                body9.append((int(r - r0), int(c - c0)))\n            if v in stripe_colors:\n                marker_pixels.append((v, int(r - r0), int(c - c0)))\n        trains.append({\n            \"abs_coords\": abs_coords,\n            \"bbox\": bbox,\n            \"body9\": body9,\n            \"marker_pixels\": marker_pixels,\n        })\n\n    out = grid.copy()\n    # 4) Clear trains from original positions (we'll redraw them docked).\n    for t in trains:\n        for r, c in t[\"abs_coords\"]:\n            out[r, c] = bg\n\n    # 5) Place each train by:\n    # - matching station group size by coupler count\n    # - choosing orientation by marker-vs-stripe rule\n    # - translating so couplers coincide exactly with station pixels\n    for t in trains:\n        n9 = len(t[\"body9\"])\n        assert n9 > 0, \"Each train must carry at least one coupler\"\n        candidate_groups = groups_by_size.get(n9)\n        assert candidate_groups is not None and len(candidate_groups) == 1, (\n            f\"Expected one station group for coupler count {n9}\"\n        )\n        g = candidate_groups[0]\n        gset = set(g)\n        matching_regions = [\n            rr\n            for rr in regions\n            if all(rr[\"r0\"] <= r <= rr[\"r1\"] and rr[\"c0\"] <= c <= rr[\"c1\"] for r, c in g)\n        ]\n        assert len(matching_regions) == 1, \"Each station group must belong to exactly one region\"\n        reg = matching_regions[0]\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -c \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport random\nimport numpy as np\nfrom scipy.ndimage import label as scipy_label\nfrom arc_utils import bbox_h, bbox_w, find_components, in_bounds, neighbors4, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n\n\ndef _bfs_placement(feasible, sr, sc):\n    h2, w2 = feasible.shape\n    dist = -np.ones((h2, w2), dtype=int)\n    dist[sr, sc] = 0\n    q = deque([(sr, sc)])\n    while q:\n        r, c = q.popleft()\n        for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:\n                dist[rr, cc] = dist[r, c] + 1\n                q.append((rr, cc))\n    return dist\n\n\ndef _hamiltonian_walk(rows, cols, start, end):\n    total = rows * cols\n    best_path = None\n    best_len = 0\n    for _attempt in range(80):\n        visited = {start}\n        path = [start]\n        cur = start\n        while True:\n            if cur == end and len(path) >= total * 0.7:\n                if len(path) > best_len:\n                    best_path = list(path)\n                    best_len = len(path)\n                break\n            neighbors = []\n            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                nr, nc = cur[0] + dr, cur[1] + dc\n                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:\n                    neighbors.append((nr, nc))\n            if not neighbors:\n                break\n            valid = []\n            for nb in neighbors:\n                if nb == end:\n                    valid.append(nb)\n                    continue\n                test_visited = visited | {nb}\n                seen = {end}\n                q = deque([end])\n                while q:\n                    cr, cc = q.popleft()\n                    for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                        nr2, nc2 = cr + dr2, cc + dc2\n                        if (0 <= nr2 < rows and 0 <= nc2 < cols and\n                                (nr2, nc2) not in test_visited and (nr2, nc2) not in seen):\n                            seen.add((nr2, nc2))\n                            q.append((nr2, nc2))\n                for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                    ar, ac = nb[0] + dr2, nb[1] + dc2\n                    if (0 <= ar < rows and 0 <= ac < cols and\n                            (ar, ac) not in test_visited and (ar, ac) in seen):\n                        valid.append(nb)\n                        break\n            if not valid:\n                break\n            random.shuffle(valid)\n            nxt = valid[0]\n            visited.add(nxt)\n            path.append(nxt)\n            cur = nxt\n        if best_path and best_len >= total * 0.85:\n            break\n    return best_path\n\n\ndef _render_channel(grid, path, n, offsets_r, offsets_c):\n    pixel_pos = []\n    for cr, cc in path:\n        pr, pc = offsets_r[cr], offsets_c[cc]\n        pixel_pos.append((pr, pc))\n        grid[pr:pr + n, pc:pc + n] = _RIVER\n    for i in range(len(path) - 1):\n        pr1, pc1 = pixel_pos[i]\n        pr2, pc2 = pixel_pos[i + 1]\n        if pr1 == pr2:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n            grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER\n        else:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n            grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER\n    return pixel_pos\n\n\ndef _add_chokepoint(grid, pixel_pos_i, pixel_pos_j, n, direction):\n    H, W = grid.shape\n    pr1, pc1 = pixel_pos_i\n    pr2, pc2 = pixel_pos_j\n    narrow_w = random.randint(1, n - 1)\n    remove = n - narrow_w\n    side = random.randint(0, 1)\n\n    if direction == 'h':\n        c_lo = min(pc1, pc2) + n\n        c_hi = max(pc1, pc2)\n        if c_hi <= c_lo:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        c_mid = (c_lo + c_hi) // 2\n        c_start = max(c_lo, c_mid - total_len // 2)\n        for step in range(total_len):\n            c = c_start + step\n            if c < 0 or c >= W:\n                continue\n            if step < remove:\n                depth = step + 1\n            elif step >= total_len - remove:\n                depth = total_len - step\n            else:\n                depth = remove\n            for k in range(depth):\n                rr = pr1 + k if side == 0 else pr1 + n - 1 - k\n                if 0 <= rr < H and 0 <= c < W:\n                    grid[rr, c] = _BG\n    else:\n        r_lo = min(pr1, pr2) + n\n        r_hi = max(pr1, pr2)\n        if r_hi <= r_lo:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        r_mid = (r_lo + r_hi) // 2\n        r_start = max(r_lo, r_mid - total_len // 2)\n        for step in range(total_len):\n            r = r_start + step\n            if r < 0 or r >= H:\n                continue\n            if step < remove:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py\"","aggregated_output":"import numpy as np\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Shear the rectangular input down-left onto a black canvas.\n\n    Input structure\n    A rectangular grid of colored pixels with no internal empty region to infer.\n\n    Rule\n    Create a black output with the same height and width W + H - 1, then copy\n    each input row r unchanged starting at column H - 1 - r.\n\n    Key insight\n    The colors and row contents are preserved; only the row offsets change so\n    the left edge forms a descending diagonal.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    out = np.zeros((h, w + h - 1), dtype=int)\n    for r in range(h):\n        start = h - 1 - r\n        out[r, start : start + w] = g[r]\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and palette bounds.\nMIN_HEIGHT, MAX_HEIGHT = 2, 10\nMIN_WIDTH, MAX_WIDTH = 1, 9\nMIN_COLOR_COUNT, MAX_COLOR_COUNT = 4, 5\nMAX_CELLS, MAX_OUTPUT_WIDTH = 36, 30\nPALETTE_VALUES = range(1, 10)\n\n# Fill pattern controls.\nFILL_MODES = (\"noise\", \"row_runs\", \"column_bands\", \"diagonal_bands\")\nMAX_ROW_RUN_CUTS = 3\nCOLUMN_NOISE_PROB = 0.5\nMIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND = 1, 3\nDIAGONAL_FLIP_PROB = 0.5\n\n# Generation safety.\nGENERATION_RETRIES = 300\n\n\ndef _ensure_palette_coverage(arr, palette):\n    positions = random.sample(range(arr.size), len(palette))\n    rows, cols = np.divmod(positions, arr.shape[1])\n    arr[rows, cols] = palette\n\n\ndef _fill_grid(h, w, palette):\n    k = len(palette)\n    mode = random.choice(FILL_MODES)\n    arr = np.zeros((h, w), dtype=int)\n\n    if mode == \"noise\":\n        arr[:] = np.random.choice(palette, size=(h, w))\n    elif mode == \"row_runs\":\n        for r in range(h):\n            cuts = sorted(random.sample(range(1, w), random.randint(0, min(w - 1, MAX_ROW_RUN_CUTS)))) if w > 1 else []\n            starts = [0] + cuts\n            ends = cuts + [w]\n            last = None\n            for c0, c1 in zip(starts, ends):\n                choices = [c for c in palette if c != last] or list(palette)\n                last = random.choice(choices)\n                arr[r, c0:c1] = last\n    elif mode == \"column_bands\":\n        for c in range(w):\n            arr[:, c] = random.choice(palette)\n        if random.random() < COLUMN_NOISE_PROB:\n            for r in range(h):\n                arr[r, random.randrange(w)] = random.choice(palette)\n    else:\n        band = random.randint(MIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND)\n        phase = random.randrange(k)\n        rows, cols = np.indices((h, w))\n        arr[:] = np.asarray(palette)[((rows + cols) // band + phase) % k]\n        if random.random() < DIAGONAL_FLIP_PROB:\n            arr = np.fliplr(arr)\n\n    _ensure_palette_coverage(arr, palette)\n    return arr\n\n\ndef _gen_attempt():\n    k = random.randint(MIN_COLOR_COUNT, MAX_COLOR_COUNT)\n    h = random.randint(MIN_HEIGHT, MAX_HEIGHT)\n    widths = [\n        w\n        for w in range(MIN_WIDTH, MAX_WIDTH + 1)\n        if h * w >= k and h * w <= MAX_CELLS and w + h - 1 <= MAX_OUTPUT_WIDTH\n    ]\n    if not widths:\n        return None\n    w = random.choice(widths)\n    palette = random.sample(PALETTE_VALUES, k)\n    return _fill_grid(h, w, palette)\n\n\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/f0100645.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import components_mask, get_bg, paste\nimport random\n\n\ndef _component_order(coords: np.ndarray, direction: int) -> tuple[int, int, int, int]:\n    rows = coords[:, 0]\n    cols = coords[:, 1]\n    if direction == -1:\n        return (int(cols.min()), int(rows.min()), int(cols.max()), int(rows.max()))\n    assert direction == 1, \"horizontal slide direction must be left or right\"\n    return (-int(cols.max()), int(rows.min()), -int(cols.min()), int(rows.max()))\n\n\ndef _settled_components(g: np.ndarray, color: int, side_col: int, direction: int) -> list[np.ndarray]:\n    h, w = g.shape\n    movable = (g == color)\n    movable[:, side_col] = False\n\n    comps = components_mask(movable, connectivity=8)\n    assert comps, \"expected at least one object away from the matching wall\"\n    comps.sort(key=lambda coords: _component_order(coords, direction))\n\n    settled = np.zeros((h, w), dtype=bool)\n    settled[:, side_col] = True\n    out_coords = []\n\n    for coords in comps:\n        shift = 0\n        while True:\n            candidate = coords + np.array([0, shift + direction])\n            cols = candidate[:, 1]\n            if int(cols.min()) < 0 or int(cols.max()) >= w:\n                break\n            if np.any(settled[candidate[:, 0], candidate[:, 1]]):\n                break\n            shift += direction\n\n        placed = coords + np.array([0, shift])\n        assert not np.any(settled[placed[:, 0], placed[:, 1]]), \"settled objects may touch but not overlap\"\n        settled[placed[:, 0], placed[:, 1]] = True\n        out_coords.append(placed)\n\n    return out_coords\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide each inner colored object horizontally into the same-colored vertical wall until it touches an obstacle.\n\n    Input structure\n    - The background is the dominant color.\n    - The only foreground colors are two non-background colors.\n    - One foreground color fills the left column and the other fills the right column.\n    - Extra 8-connected objects of each wall color appear away from that color's wall.\n\n    Rule\n    - Clear the extra objects from their original positions.\n    - For each wall color, process its 8-connected extra objects from nearest to farthest from the matching wall.\n    - Slide each object horizontally toward its matching wall as far as possible without overlapping the wall or an already settled object of the same color.\n    - Keep the two vertical wall columns fixed.\n\n    Key insight\n    - The side columns act like color-specific gravity walls: same-colored objects compact sideways against their own wall while preserving each object's shape.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and min(g.shape) >= 2, \"expected a non-empty 2D grid with two side columns\"\n\n    bg = get_bg(g)\n    w = g.shape[1]\n    left_color = int(g[0, 0])\n    right_color = int(g[0, w - 1])\n\n    assert left_color != right_color, \"left and right walls must have different colors\"\n    assert bg not in {left_color, right_color}, \"walls must be foreground colors\"\n    assert np.all(g[:, 0] == left_color), \"left wall must fill the full left column\"\n    assert np.all(g[:, w - 1] == right_color), \"right wall must fill the full right column\"\n    assert set(map(int, np.unique(g))) == {int(bg), left_color, right_color}, \"expected exactly background plus two wall colors\"\n\n    out = np.full_like(g, int(bg))\n    out[:, 0] = left_color\n    out[:, w - 1] = right_color\n\n    placements: list[tuple[int, np.ndarray]] = []\n    for color, side_col, direction in ((left_color, 0, -1), (right_color, w - 1, 1)):\n        for coords in _settled_components(g, color, side_col, direction):\n            placements.append((color, coords))\n\n    occupied = (out != bg)\n    for color, coords in placements:\n        assert not np.any(occupied[coords[:, 0], coords[:, 1]]), \"different colors must not settle on the same pixel\"\n        out[coords[:, 0], coords[:, 1]] = color\n        occupied[coords[:, 0], coords[:, 1]] = True\n\n    assert int(np.sum(out == left_color)) == int(np.sum(g == left_color)), \"left color count must be preserved\"\n    assert int(np.sum(out == right_color)) == int(np.sum(g == right_color)), \"right color count must be preserved\"\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and palette bounds.\nGRID_HEIGHT_BOUNDS = (9, 10)\nGRID_WIDTH_BOUNDS = (9, 10)\nBACKGROUND_COLOR = 7\nWALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n# Object counts and pixel budgets.\nCOMPONENT_COUNT_BOUNDS = (2, 3)\nINNER_FOREGROUND_BOUNDS = (15, 23)\nSPRITE_PIXEL_BOUNDS = (1, 7)\n# Sprite geometry limits.\nSPRITE_HEIGHT_BOUNDS = (1, 5)\nSPRITE_WIDTH_BOUNDS = (1, 3)\nMIN_SPRITE_DENSITY = 0.56\n# Input scatter and retry limits.\nSCATTER_OFFSET_BOUNDS = (1, 5)\nGENERATION_ATTEMPTS = 300\n\nPlacement = tuple[int, np.ndarray, int, int, bool]\n\n\ndef _gen_bounded_composition(total: int, parts: int, lo: int, hi: int) -> list[int]:\n    values = []\n    remaining = int(total)\n    for i in range(int(parts)):\n        slots = int(parts) - i - 1\n        low = max(int(lo), remaining - int(hi) * slots)\n        high = min(int(hi), remaining - int(lo) * slots)\n        value = random.randint(low, high)\n        values.append(value)\n        remaining -= value\n    random.shuffle(values)\n    return values\n\n\ndef _gen_sprite_mask(size: int) -> np.ndarray:\n    size = int(size)\n    dims = [\n        (h, w)\n        for h in range(SPRITE_HEIGHT_BOUNDS[0], SPRITE_HEIGHT_BOUNDS[1] + 1)\n        for w in range(SPRITE_WIDTH_BOUNDS[0], SPRITE_WIDTH_BOUNDS[1] + 1)\n        if max(h, w) <= size <= h * w and size / (h * w) >= MIN_SPRITE_DENSITY\n    ]\n    h, w = random.choice(dims)\n\n    coords: set[tuple[int, int]] = set()\n    length = max(h, w)\n    if length == 1:\n        coords.add((0, 0))\n    else:\n        for i in range(length):\n            r = (i * (h - 1) + (length - 1) // 2) // (length - 1)\n            c = (i * (w - 1) + (length - 1) // 2) // (length - 1)\n            coords.add((int(r), int(c)))\n\n    while len(coords) < size:\n        frontier = []\n        for r, c in coords:\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    if dr == 0 and dc == 0:\n                        continue\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in coords:\n                        frontier.append((nr, nc))\n        coords.add(random.choice(frontier))\n\n    mask = np.zeros((h, w), dtype=bool)\n    for r, c in coords:\n        mask[r, c] = True\n    if random.choice([False, True]):\n        mask = np.flipud(mask)\n    if random.choice([False, True]):\n        mask = np.fliplr(mask)\n    return mask.copy()\n\n\ndef _gen_mask_coords(mask: np.ndarray, r0: int, c0: int) -> np.ndarray:\n    return np.argwhere(mask) + np.array([int(r0), int(c0)])\n\n\ndef _gen_base_grid(shape: tuple[int, int], bg: int, left_color: int, right_color: int) -> np.ndarray:\n    grid = np.full(shape, int(bg), dtype=int)\n    grid[:, 0] = int(left_color)\n    grid[:, shape[1] - 1] = int(right_color)\n    return grid\n\n\ndef _gen_place_output_side(\n    out: np.ndarray, color: int, masks: list[np.ndarray], *, left_side: bool, bg: int\n) -> list[Placement]:\n    h, w = out.shape\n    placements = []\n    for mask in sorted(masks, key=lambda m: int(m.sum()), reverse=True):\n        mh, mw = mask.shape\n        c0 = 1 if left_side else w - 1 - mw\n        rows = list(range(0, h - mh + 1))\n        random.shuffle(rows)\n        for r0 in rows:\n            coords = _gen_mask_coords(mask, r0, c0)\n            if np.any(out[coords[:, 0], coords[:, 1]] != bg):\n                continue\n            patch = np.where(mask, int(color), int(bg))\n            paste(out, patch, r0, c0, transparent=bg)\n            placements.append((int(color), mask, int(r0), int(c0), bool(left_side)))\n            break\n        else:\n            return []\n    return placements\n\n\ndef _gen_touches_existing(coords: np.ndarray, existing: list[np.ndarray]) -> bool:\n    for other in existing:\n        dr = np.abs(coords[:, None, 0] - other[None, :, 0])\n        dc = np.abs(coords[:, None, 1] - other[None, :, 1])\n        if bool(np.any((dr <= 1) & (dc <= 1))):\n            return True\n    return False\n\n\ndef _gen_scatter_input(\n    shape: tuple[int, int], bg: int, left_color: int, right_color: int, placements: list[Placement]\n) -> np.ndarray | None:\n    h, w = shape\n    inp = _gen_base_grid((h, w), bg, left_color, right_color)\n    by_color: dict[int, list[np.ndarray]] = {int(left_color): [], int(right_color): []}\n\n    shuffled = list(placements)\n    random.shuffle(shuffled)\n    for color, mask, r0, c_out, left_side in shuffled:\n        mh, mw = mask.shape\n        max_offset = (w - 2 - (c_out + mw - 1)) if left_side else (c_out - 1)\n        offsets = list(range(SCATTER_OFFSET_BOUNDS[0], min(SCATTER_OFFSET_BOUNDS[1], int(max_offset)) + 1))\n        random.shuffle(offsets)\n        for offset in offsets:\n            c_in = c_out + offset if left_side else c_out - offset\n            coords = _gen_mask_coords(mask, r0, c_in)\n            if np.any(inp[coords[:, 0], coords[:, 1]] != bg):\n                continue\n            if _gen_touches_existing(coords, by_color[int(color)]):\n                continue\n            patch = np.where(mask, int(color), int(bg))\n            paste(inp, patch, r0, c_in, transparent=bg)\n            by_color[int(color)].append(coords)\n            break\n        else:\n            return None\n    return inp\n\n\ndef _gen_output_layout(\n    shape: tuple[int, int], bg: int, left_color: int, right_color: int,\n    left_masks: list[np.ndarray], right_masks: list[np.ndarray],\n) -> tuple[np.ndarray, list[Placement]] | None:\n    out = _gen_base_grid(shape, bg, left_color, right_color)\n    left_placements = _gen_place_output_side(out, left_color, left_masks, left_side=True, bg=bg)\n    if len(left_placements) != len(left_masks):\n        return None\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -c \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/21897d95.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter, deque\nimport numpy as np\n\nfrom arc_utils import label_mask\nimport random\n\n\nDIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))\nUP = (-1, 0)\nDOWN = (1, 0)\nRIGHT = (0, 1)\n\n\nclass _DSU:\n    def __init__(self, n: int):\n        self.parent = list(range(int(n)))\n\n    def find(self, x: int) -> int:\n        x = int(x)\n        while self.parent[x] != x:\n            self.parent[x] = self.parent[self.parent[x]]\n            x = self.parent[x]\n        return int(x)\n\n    def union(self, a: int, b: int) -> None:\n        ra = self.find(a)\n        rb = self.find(b)\n        if ra != rb:\n            self.parent[rb] = ra\n\n\ndef _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:\n    return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])\n\n\ndef _opp(d: tuple[int, int]) -> tuple[int, int]:\n    return (-int(d[0]), -int(d[1]))\n\n\ndef _stem_from_branches(branches: list[tuple[int, int]]) -> tuple[int, int]:\n    assert len(branches) == 3\n    branch_set = set(branches)\n    for d in branches:\n        if _opp(d) not in branch_set:\n            return d\n    raise AssertionError(\"T marker has no single stem\")\n\n\ndef _parse_tetromino(cells: set[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int], list[tuple[int, int]]] | None:\n    if len(cells) != 4:\n        return None\n    for r, c in cells:\n        branches = [(dr, dc) for dr, dc in DIRS if (r + dr, c + dc) in cells]\n        if len(branches) != 3:\n            continue\n        stem = _stem_from_branches(branches)\n        expected = {(r, c), (r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)}\n        expected.remove((r - stem[0], c - stem[1]))\n        if cells == expected:\n            bar = [d for d in branches if d != stem]\n            assert len(bar) == 2 and bar[0] == _opp(bar[1])\n            return (int(r), int(c)), stem, bar\n    return None\n\n\ndef _label_base_components(g: np.ndarray, control: np.ndarray) -> tuple[np.ndarray, list[int], list[int]]:\n    comp_id = np.full(g.shape, -1, dtype=int)\n    comp_colors: list[int] = []\n    comp_areas: list[int] = []\n    cid = 0\n    for col in sorted(set(map(int, g.ravel())) - {1}):\n        labels, n_labels = label_mask((g == col) & (~control), connectivity=4)\n        for k in range(1, int(n_labels) + 1):\n            coords = np.argwhere(labels == k)\n            if coords.size == 0:\n                continue\n            for rr, cc in coords:\n                comp_id[int(rr), int(cc)] = cid\n            comp_colors.append(int(col))\n            comp_areas.append(int(len(coords)))\n            cid += 1\n    return comp_id, comp_colors, comp_areas\n\n\ndef _solve_unrotated(g: np.ndarray) -> np.ndarray:\n    labels_1, n_1 = label_mask(g == 1, connectivity=4)\n    one_components = {\n        k: {tuple(map(int, xy)) for xy in np.argwhere(labels_1 == k)}\n        for k in range(1, int(n_1) + 1)\n    }\n    one_sizes = {k: len(cells) for k, cells in one_components.items()}\n\n    markers: list[dict] = []\n    used_ones: set[tuple[int, int]] = set()\n    control = np.zeros(g.shape, dtype=bool)\n\n    for cells in one_components.values():\n        parsed = _parse_tetromino(cells)\n        if parsed is None:\n            continue\n        center, stem, bar = parsed\n        markers.append({\"kind\": \"normal\", \"center\": center, \"stem\": stem, \"bar\": bar, \"cells\": cells})\n        used_ones |= cells\n        for r, c in cells:\n            control[r, c] = True\n\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n            if int(g[r, c]) == 1:\n                continue\n            branches: list[tuple[int, int]] = []\n            cells: list[tuple[int, int]] = []\n            ok = True\n            for d in DIRS:\n                rr, cc = r + d[0], c + d[1]\n                if not _in_bounds(g.shape, rr, cc) or int(g[rr, cc]) != 1:\n                    continue\n                label = int(labels_1[rr, cc])\n                if one_sizes[label] == 1 and (rr, cc) not in used_ones:\n                    branches.append(d)\n                    cells.append((rr, cc))\n                else:\n                    ok = False\n            if ok and len(branches) == 3:\n                stem = _stem_from_branches(branches)\n                bar = [d for d in branches if d != stem]\n                assert len(bar) == 2 and bar[0] == _opp(bar[1])\n                marker_cells = set(cells) | {(int(r), int(c))}\n                markers.append(\n                    {\n                        \"kind\": \"colored\",\n                        \"center\": (int(r), int(c)),\n                        \"stem\": stem,\n                        \"bar\": bar,\n                        \"cells\": marker_cells,\n                        \"target_color\": int(g[r, c]),\n                    }\n                )\n                used_ones |= set(cells)\n                for rr, cc in marker_cells:\n                    control[rr, cc] = True\n\n    all_one_cells = {tuple(map(int, xy)) for xy in np.argwhere(g == 1)}\n    assert all_one_cells == used_ones, \"all color-1 pixels must belong to a T control marker\"\n\n    for col in sorted(set(map(int, g.ravel())) - {1}):\n        labels, n_labels = label_mask((g == col) & (~control), connectivity=4)\n        for k in range(1, int(n_labels) + 1):\n            coords = np.argwhere(labels == k)\n            if len(coords) > 5:\n                continue\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            if len(coords) == (int(r1) - int(r0) + 1) * (int(c1) - int(c0) + 1):\n                continue\n            cells = {tuple(map(int, xy)) for xy in coords}\n            markers.append({\"kind\": \"small\", \"cells\": cells})\n            for rr, cc in cells:\n                control[rr, cc] = True\n\n    comp_id, comp_colors, comp_areas = _label_base_components(g, control)\n    assert comp_colors, \"at least one base region is required\"\n    dsu = _DSU(len(comp_colors))\n\n    def first_component_from(center: tuple[int, int], direction: tuple[int, int], start: int) -> int | None:\n        r, c = center\n        step = int(start)\n        while True:\n            rr = r + direction[0] * step\n            cc = c + direction[1] * step\n            if not _in_bounds(g.shape, rr, cc):\n                return None\n            if comp_id[rr, cc] >= 0:\n                return int(comp_id[rr, cc])\n            step += 1\n\n    def adjacent_component_counts(cells: set[tuple[int, int]]) -> Counter:\n        counts: Counter = Counter()\n        for r, c in cells:\n            for dr, dc in DIRS:\n                rr, cc = r + dr, c + dc\n                if _in_bounds(g.shape, rr, cc) and comp_id[rr, cc] >= 0:\n                    counts[int(comp_id[rr, cc])] += 1\n        return counts\n\n    for marker in markers:\n        if marker[\"kind\"] in {\"normal\", \"colored\"}:\n            center = marker[\"center\"]\n            stem = marker[\"stem\"]\n            dest = first_component_from(center, stem, start=2)\n            assert dest is not None, \"T marker must point at a destination region\"\n\n            source_parts: list[int] = []\n            for bar_dir in marker[\"bar\"]:\n                rr = center[0] + stem[0] + bar_dir[0]\n                cc = center[1] + stem[1] + bar_dir[1]\n                assert _in_bounds(g.shape, rr, cc) and comp_id[rr, cc] >= 0\n                source_parts.append(int(comp_id[rr, cc]))\n            source = source_parts[0]\n            for part in source_parts[1:]:\n                assert comp_colors[part] == comp_colors[source], \"T source diagonals must share a color\"\n                dsu.union(source, part)\n\n            for comp in adjacent_component_counts(marker[\"cells\"]):\n                if comp_colors[comp] == comp_colors[source]:\n                    dsu.union(source, comp)\n            marker[\"dest_comp\"] = dest\n            marker[\"source_comp\"] = source\n        else:\n            counts = adjacent_component_counts(marker[\"cells\"])\n            assert counts, \"small marker must touch its owner region\"\n            owner = max(counts, key=lambda c: (counts[c], comp_areas[c]))\n            for comp in counts:\n                if comp_colors[comp] == comp_colors[owner]:\n                    dsu.union(owner, comp)\n            marker[\"source_comp\"] = owner\n\n    root_color: dict[int, int] = {}\n    for i, col in enumerate(comp_colors):\n        root = dsu.find(i)\n        root_color.setdefault(root, int(col))\n        assert root_color[root] == int(col), \"merged region colors must match\"\n\n    final_color = dict(root_color)\n    for marker in markers:\n        if marker[\"kind\"] not in {\"normal\", \"colored\"}:\n            marker[\"source\"] = dsu.find(marker[\"source_comp\"])\n            continue\n        dest = dsu.find(marker[\"dest_comp\"])\n        source = dsu.find(marker[\"source_comp\"])\n        marker[\"source\"] = source\n        replacement = int(marker[\"target_color\"]) if marker[\"kind\"] == \"colored\" else int(root_color[source])\n        assert final_color[dest] in {root_color[dest], replacement}, \"conflicting T controls for one region\"\n        final_color[dest] = replacement\n\n    out = np.full(g.shape, -1, dtype=int)\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n            cid = int(comp_id[r, c])\n            if cid >= 0:\n                out[r, c] = int(final_color[dsu.find(cid)])\n\n    for marker in markers:\n        color = int(final_color[marker[\"source\"]])\n        for r, c in marker[\"cells\"]:\n            out[r, c] = color\n\n    assert bool(np.all(out >= 0)), \"all cells must be assigned\"\n    return out\n\n\ndef _find_l9_orientation(g: np.ndarray) -> str | None:\n    \"\"\"Find a 5-cell L-shaped color-9 marker and return its corner position.\"\"\"\n    mask9 = g == 9\n    if not mask9.any():\n        return None\n    labels, n = label_mask(mask9, connectivity=4)\n    for k in range(1, int(n) + 1):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -c \"sed -n '1,280p' /home/lixinyu/snap/new/ARC_code/eval/9385bd28.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg\nimport random\nfrom collections import Counter\n\n\ndef _find_legend(g: np.ndarray, bg: int) -> tuple[int, list[tuple[int, int, int]]]:\n    \"\"\"\n    Legend is a vertical stack of pairs at bottom-left.\n    Each legend row: (marker_color at col c, fill_color at col c+1).\n    Returns (legend_col, entries) where entries are ordered bottom->top as (row, marker, fill).\n    \"\"\"\n    h, w = g.shape\n    start_r = None\n    start_c = None\n    for r in range(h - 1, -1, -1):\n        nz = np.flatnonzero(g[r, :] != bg)\n        if nz.size:\n            start_r = r\n            start_c = int(nz[0])\n            break\n    assert start_r is not None and start_c is not None and start_c < w - 1, \\\n        \"legend must exist at bottom-left with at least 2 columns\"\n\n    entries: list[tuple[int, int, int]] = []\n    c = start_c\n    for r in range(start_r, -1, -1):\n        nz = np.flatnonzero(g[r, :] != bg)\n        if nz.size == 0 or int(nz[0]) != c or int(g[r, c]) == bg:\n            break\n        marker = int(g[r, c])\n        fill = int(g[r, c + 1]) if c + 1 < w else bg\n        entries.append((r, marker, fill))\n    return c, entries\n\n\ndef _l_anchor_present(pts: set[tuple[int, int]], r: int, c: int, arm1: tuple[int, int], arm2: tuple[int, int]) -> bool:\n    \"\"\"\n    Marker corners are L-shapes:\n      TL: (r,c), (r,c+1), (r+1,c)\n      TR: (r,c), (r,c-1), (r+1,c)\n      BL: (r,c), (r,c+1), (r-1,c)\n      BR: (r,c), (r,c-1), (r-1,c)\n\n    This is more robust than checking only corner membership, especially when the bbox is 2-wide/2-tall\n    where L arms can overlap other bbox corners.\n    \"\"\"\n    (dr1, dc1) = arm1\n    (dr2, dc2) = arm2\n    return (r, c) in pts and (r + dr1, c + dc1) in pts and (r + dr2, c + dc2) in pts\n\n\ndef _diamond_mask(h: int, w: int, r0: int, r1: int, c0: int, c1: int, a: tuple[int, int], b: tuple[int, int]) -> np.ndarray:\n    \"\"\"\n    Mask for all cells inside [r0..r1]x[c0..c1] that lie on some shortest 4-neigh path between corners a and b:\n      dist(a,p) + dist(p,b) == dist(a,b)\n    \"\"\"\n    ar, ac = a\n    br, bc = b\n    dab = abs(ar - br) + abs(ac - bc)\n    m = np.zeros((h, w), dtype=bool)\n    for r in range(r0, r1 + 1):\n        for c in range(c0, c1 + 1):\n            if abs(r - ar) + abs(c - ac) + abs(r - br) + abs(c - bc) == dab:\n                m[r, c] = True\n    return m\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill rectangles between diagonal marker pairs using a color legend.\n\n    Input structure:\n    - bg grid with a vertical legend at the bottom-left: each row is a (marker_color, fill_color) pair.\n    - Scattered L-shaped corner markers of each marker color define opposite corners of axis-aligned rectangles.\n    - Some markers are solid 2×2 blocks instead of corner pairs.\n\n    Rule:\n    - Read legend bottom-to-top; for each entry find all pixels of that marker color.\n    - Determine which two bbox corners carry L-shaped anchors — the *other* diagonal defines the fill region.\n    - Fill the diamond (all shortest-path cells between those two corners) with the legend's fill color.\n    - Solid 2×2 marker blocks are simply recolored to the fill color.\n    - Later legend entries are protected from earlier fills.\n\n    Key insight: The L-shaped anchors sit on the marker diagonal; the fill goes on the opposite diagonal of the bounding box.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    bg = get_bg(g)\n    legend_c, entries = _find_legend(g, bg)\n    assert entries, \"legend must contain at least one (marker, fill) entry\"\n\n    legend_mask = np.zeros_like(g, dtype=bool)\n    for r, _, _ in entries:\n        if 0 <= r < h and 0 <= legend_c < w:\n            legend_mask[r, legend_c] = True\n        if 0 <= r < h and 0 <= legend_c + 1 < w:\n            legend_mask[r, legend_c + 1] = True\n\n    out = g.copy()\n\n    marker_order = [m for _, m, _ in entries]\n    marker_set = set(marker_order)\n\n    # Process legend entries bottom -> top; earlier entries must not destroy later marker pixels.\n    for i, (_, marker, fill) in enumerate(entries):\n        eff_fill = int(fill)\n        marker_pts = set(map(tuple, np.argwhere((g == marker) & (~legend_mask))))\n        if len(marker_pts) < 2:\n            continue\n\n        rs = [r for r, _ in marker_pts]\n        cs = [c for _, c in marker_pts]\n        rmin, rmax = min(rs), max(rs)\n        cmin, cmax = min(cs), max(cs)\n\n        # Protect legend cells and all marker pixels for entries that appear later (higher) in the legend.\n        future_markers = set(marker_order[i + 1 :])\n        protect = legend_mask.copy()\n        for fm in future_markers:\n            protect |= (g == fm) & (~legend_mask)\n\n        # Also protect current marker pixels in the common case (so markers remain visible),\n        # except when they form a solid 2x2 block (treated as a filled marker that gets recolored).\n        if rmax - rmin == 1 and cmax - cmin == 1 and len(marker_pts) == 4:\n            # Solid 2x2 marker: recolor these pixels directly.\n            block = np.zeros_like(g, dtype=bool)\n            for r, c in marker_pts:\n                block[r, c] = True\n            out[block & (~protect)] = eff_fill\n            continue\n        else:\n            protect |= (g == marker) & (~legend_mask)\n\n        if rmin == rmax or cmin == cmax:\n            continue\n\n        tl = (rmin, cmin)\n        tr = (rmin, cmax)\n        bl = (rmax, cmin)\n        br = (rmax, cmax)\n\n        tl_anchor = _l_anchor_present(marker_pts, tl[0], tl[1], (0, 1), (1, 0))\n        tr_anchor = _l_anchor_present(marker_pts, tr[0], tr[1], (0, -1), (1, 0))\n        bl_anchor = _l_anchor_present(marker_pts, bl[0], bl[1], (0, 1), (-1, 0))\n        br_anchor = _l_anchor_present(marker_pts, br[0], br[1], (0, -1), (-1, 0))\n\n        score_tlbr = int(tl_anchor) + int(br_anchor)\n        score_trbl = int(tr_anchor) + int(bl_anchor)\n        assert score_tlbr != 0 or score_trbl != 0, \"at least one diagonal must have an L-anchor\"\n        assert score_tlbr != score_trbl, \"diagonal scores must not tie (tie-break path is unreachable)\"\n        if score_tlbr > score_trbl:\n            a, b = tr, bl\n        else:\n            a, b = tl, br\n\n        diamond = _diamond_mask(h, w, rmin, rmax, cmin, cmax, a, b)\n        out[diamond & (~protect)] = eff_fill\n\n    return out\n\n# --------------- generator (C1) ---------------\n\n# ── CFG: canvas & grid ──────────────────────────────────────────────\nGRID_H_RANGE = (10, 19)          # grid height bounds\nGRID_W_RANGE = (10, 19)          # grid width bounds\n\n# ── CFG: legend ─────────────────────────────────────────────────────\nLEGEND_COL_RANGE = (0, 2)        # legend left column (marker at c, fill at c+1)\nLEGEND_ENTRY_RANGE = (2, 5)      # number of legend entries\n\n# ── CFG: marker types ──────────────────────────────────────────────\nNOOP_PROB = 0.3                  # prob of one noop entry (marker with no pixels)\nBLOCK_PROB = 0.25                # prob of one 2x2 block entry\n\n# ── CFG: L-pair bbox shape ──────────────────────────────────────────\nBBOX_H_MAX = 19                  # max bbox height\nBBOX_W_MAX = 12                  # max bbox width\nBBOX_SHAPE_WEIGHTS = [0.75, 0.15, 0.10]  # [both>=3, h=2/w>=4, h>=4/w=2]\nTLBR_PROB = 0.8                  # prob of TL-BR diagonal (vs TR-BL)\n\n# ── CFG: distractor ────────────────────────────────────────────────\nDISTRACTOR_PROB = 0.25           # prob of adding a non-legend L-pair\n\n# ── CFG: retry budgets ─────────────────────────────────────────────\nBLOCK_RETRIES = 100              # placement attempts for a 2x2 block\nLPAIR_RETRIES = 150              # placement attempts for an L-pair\nDISTRACTOR_RETRIES = 60          # placement attempts for distractor\nGEN_RETRIES = 300                # outer generate_input retry budget\n\n_L_OFFSETS = {\n    \"TL\": [(0, 0), (0, 1), (1, 0)],\n    \"TR\": [(0, 0), (0, -1), (1, 0)],\n    \"BL\": [(0, 0), (0, 1), (-1, 0)],\n    \"BR\": [(0, 0), (0, -1), (-1, 0)],\n}\n\n\ndef _l_pair_cells(rmin: int, cmin: int, rmax: int, cmax: int, diag: str) -> list[tuple[int, int]]:\n    \"\"\"Return the 6 cells for an L-pair at opposite bbox corners. diag in {'TLBR','TRBL'}.\"\"\"\n    if diag == \"TLBR\":\n        anchors = [(\"TL\", rmin, cmin), (\"BR\", rmax, cmax)]\n    else:\n        anchors = [(\"TR\", rmin, cmax), (\"BL\", rmax, cmin)]\n    cells: list[tuple[int, int]] = []\n    for name, r, c in anchors:\n        for dr, dc in _L_OFFSETS[name]:\n            cells.append((r + dr, c + dc))\n    return cells\n\n\ndef _l_pair_valid_bbox(h: int, w: int) -> bool:\n    \"\"\"True if (h, w) avoids an L-anchor score tie.\n\n    Fails for (2,2), (2,3), (3,2). Safe: h>=3 and w>=3, or h==2 and w>=4, or h>=4 and w==2.\n    \"\"\"\n    if h < 2 or w < 2:\n        return False\n    if h == 2 and w <= 3:\n        return False\n    if w == 2 and h <= 3:\n        return False\n    return True\n\n\ndef _pick_bbox_size(H: int, W: int) -> tuple[int, int] | None:\n    \"\"\"Pick a random valid L-pair bbox size that fits in (H, W).\"\"\"\n    shape_choice = random.choices(\n        [\"both_ge3\", \"h2_w_ge4\", \"h_ge4_w2\"],\n        weights=BBOX_SHAPE_WEIGHTS,\n    )[0]\n    if shape_choice == \"both_ge3\":\n        bh = random.randint(3, min(BBOX_H_MAX, H))\n        bw = random.randint(3, min(BBOX_W_MAX, W))\n    elif shape_choice == \"h2_w_ge4\":\n        bh = 2\n        w_hi = min(BBOX_W_MAX, W)\n        if w_hi < 4:\n            return None\n        bw = random.randint(4, w_hi)\n    else:\n        h_hi = min(BBOX_H_MAX, H)\n        if h_hi < 4:\n            return None\n        bh = random.randint(4, h_hi)\n        bw = 2\n    if bh > H or bw > W or not _l_pair_valid_bbox(bh, bw):\n        return None\n    return bh, bw\n\n\ndef _try_place_l_pair(H: int, W: int, color: int, retries: int,\n                      can_place, do_place) -> bool:\n    \"\"\"Try to place an L-pair of `color` on the grid within `retries` attempts.\n\n    Returns True on success, False if all attempts failed.\n    \"\"\"\n    for _ in range(retries):\n        size = _pick_bbox_size(H, W)\n        if size is None:\n            continue\n        bh, bw = size\n        rmin = random.randint(0, H - bh)\n        cmin = random.randint(0, W - bw)\n        diag = \"TLBR\" if random.random() < TLBR_PROB else \"TRBL\"\n        cells = _l_pair_cells(rmin, cmin, rmin + bh - 1, cmin + bw - 1, diag)\n        if can_place(cells):\n            do_place(cells, color)\n            return True\n    return False\n\n\ndef _build_legend(H, W, bg):\n    \"\"\"Create legend entries and the corresponding grid/mask arrays.\n\n    Returns (grid, legend_rows, legend_mask, legend_c, legend_bot) or None on failure.\n    \"\"\"\n    legend_c = random.randint(*LEGEND_COL_RANGE)\n","exit_code":0,"status":"completed"}}
