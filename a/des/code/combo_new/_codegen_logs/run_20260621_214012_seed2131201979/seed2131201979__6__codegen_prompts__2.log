{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/21897d95.py | sed '\"'$d'\"'; printf '\\\\n=====\\\\n'; sed -n '/\"'^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/21897d95.py | sed -n '1,260p'; printf '\\\\n=====FILE====\\\\n'; sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/6350f1f4.py | sed '\"'$d'\"'; printf '\\\\n=====\\\\n'; sed -n '/\"'^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/6350f1f4.py | sed -n '1,260p'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.\n\n    Input structure:\n    - The grid is a mosaic of monochrome regions.\n    - Color 1 forms T-shaped control markers on region boundaries.\n    - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.\n    - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.\n\n    Rule:\n    - For a color-1 T marker, the single stem points at the destination region to repaint.\n    - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.\n    - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.\n    - All marker cells are filled with the final color of the source-side region.\n    - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.\n\n    Key insight:\n    - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = _solve_unrotated(g)\n    l9 = _find_l9_orientation(g)\n    if l9 == 'top_right':\n        return np.rot90(out, 1)\n    if l9 == 'top_left':\n        return np.rot90(out, 3)\n    return out\n\n# --------------- generator (l9rot) ---------------\n\n# ── Tunable constants ──────────────────────────────────────────────────\n# Canvas / region sizing\nGRID_SIZE_MAX = 30                          # max rows or cols\nMIN_REGION_CELLS = 6                        # per-spec minimum\nREGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)\nREGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts\nREGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS\n\n# Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)\nMARKER_MIN = 4\nMARKER_MAX = 8\nNORMAL_MAX = 6\nCOLORED_MAX = 2\n\n# Color pool (all ARC colors except 1, which is reserved for T-marker cells)\nCOLOR_POOL = [c for c in range(10) if c != 1]\n\n# L9 rotation marker\nL9_PROBABILITY = 0.5                        # chance of placing a rotation marker\nL9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation\n    'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],\n    'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],\n}\n\n# Generation retry budget\nSEED_ATTEMPTS = 200                         # tries to place n distinct region seeds\nGEN_RETRIES = 300                           # outer generate_input retry budget\n\n_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n# ── Small geometry helpers ─────────────────────────────────────────────\n\n\n=====\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n\n=====FILE====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Decode a block-grid image by swapping each sprite-coded cell with a solid cell and each blank cell with the sprite.\n\n    Input structure\n    The grid is partitioned by black separator rows and columns into equal-size\n    square blocks. Each block is either a copy of one two-color sprite or a\n    uniform blank block of the sprite's minority color; grey pixels are erased\n    cells that act as wildcards.\n\n    Rule\n    Infer the repeated sprite from fully visible mixed-color blocks. Replace a\n    block matching that sprite, ignoring grey erasures, with a solid block of\n    the sprite's majority color. Replace a uniform blank block with the sprite.\n    Separator rows and columns, including grey erasures on them, become black.\n\n    Key insight\n    The small sprite is a block-level code for one macro-cell state, and the\n    uniform minority-color block is the other state; the output renders the\n    opposite code in each macro-cell while cleaning erased pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n\n    row_separators = [r for r in range(H) if _is_separator_line(g[r, :])]\n    col_separators = [c for c in range(W) if _is_separator_line(g[:, c])]\n    row_intervals = _regular_intervals(row_separators, H)\n    col_intervals = _regular_intervals(col_separators, W)\n    block_heights = {r1 - r0 for r0, r1 in row_intervals}\n    block_widths = {c1 - c0 for c0, c1 in col_intervals}\n    assert block_heights == block_widths, \"encoded blocks must be square\"\n\n    payload_colors = colors_present(g, exclude={SEPARATOR, ERASED})\n    assert len(payload_colors) == 2, \"expected exactly two non-separator payload colors\"\n    sprite = _find_sprite(g, row_intervals, col_intervals, payload_colors)\n    foreground, blank = _foreground_and_blank(sprite, payload_colors)\n\n    out = np.zeros_like(g)\n    for r0, r1 in row_intervals:\n        for c0, c1 in col_intervals:\n            block = g[r0:r1, c0:c1]\n            known = block != ERASED\n            assert known.any(), \"each block must expose at least one non-grey cell\"\n            matches_sprite = bool(np.all(block[known] == sprite[known]))\n            matches_blank = bool(np.all(block[known] == blank))\n            assert matches_sprite != matches_blank, \"each block must unambiguously match the sprite or blank state\"\n            out[r0:r1, c0:c1] = foreground if matches_sprite else sprite\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette bounds.\nGRID_COUNT_RANGE, BLOCK_SIZE_RANGE = (2, 4), (2, 4)\nPAYLOAD_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\nPAYLOAD_COLOR_COUNT = 2\nGEN_SEPARATOR_COLOR, GEN_ERASED_COLOR = int(SEPARATOR), int(ERASED)\n\n# Sprite composition constraints.\nSPRITE_FG_MIN_RATIO, SPRITE_FG_MAX_RATIO = (2, 3), (3, 4)\nSPRITE_ATTEMPTS, TINY_BLOCK_SIZE = 80, 2\n\n# Macro-cell state constraints.\nMIN_BLANK_BLOCKS, MAX_BLANK_BLOCK_DENOMINATOR = 1, 2\n\n# Grey overlay constraints.\nGREY_MIN_FRACTION, GREY_MAX_FRACTION = 0.05, 0.25\nGREY_TWO_COMPONENT_PROBABILITY, GREY_TWO_COMPONENT_ATTEMPTS = 0.5, 30\nGREY_CONNECTIVITY, GENERATION_ATTEMPTS = 4, 300\n\nNEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\n\n=====\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/278e5215.py | sed '\"'$d'\"'; printf '\\\\n=====\\\\n'; sed -n '/\"'^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/278e5215.py | sed -n '1,240p'; printf '\\\\n=====FILE====\\\\n'; sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py | sed '\"'$d'\"'; printf '\\\\n=====\\\\n'; sed -n '/\"'^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py | sed -n '1,240p'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the large mask crop column-by-column using the separate three-row palette strip.\n\n    Input structure:\n    - The background is the most common color.\n    - One large monochrome foreground object is the mask; its bbox is the output region and may contain background holes.\n    - The remaining foreground is a 3-row palette rectangle with the same width as the mask bbox: two identical color rows and one uniform row.\n\n    Rule:\n    - Crop to the mask object's bbox.\n    - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n    - Replace background holes inside the crop with the palette's uniform third-row color.\n\n    Key insight:\n    The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    mask_color = _unique_largest_non_bg_color(g, bg)\n\n    b = _mask_bbox(g, mask_color)\n    mask_crop = crop_bbox(g == int(mask_color), b)\n    height, width = map(int, mask_crop.shape)\n\n    column_colors, hole_color = _palette(g, bg, mask_color, width)\n    out = np.tile(column_colors, (height, 1))\n    out[~mask_crop] = hole_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, colors, and object bounds.\nBACKGROUND_COLOR, MASK_COLOR = 0, 5\nCOLOR_MIN, COLOR_MAX = 1, 9\nGRID_SIDE_MIN, GRID_SIDE_MAX = 10, 18\nMASK_SIDE_MIN, MASK_SIDE_MAX = 5, 10\nPALETTE_HEIGHT = 3\nGAP_MIN, GAP_MAX = 1, 3\n\n# Palette run construction.\nRUN_COUNT_OPTIONS = (4, 5)\nRUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3\nCOLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5\nUNUSED_COLOR_BIAS = 0.7\n\n# Mask density and retry budget.\nMASK_DENSITY_MIN, MASK_DENSITY_MAX = 0.60, 0.71\nGENERATION_ATTEMPTS = 300\n\n\n\n=====\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n=====FILE====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n\n\n\n=====\ndef generate_input():\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n\n\n","exit_code":0,"status":"completed"}}
