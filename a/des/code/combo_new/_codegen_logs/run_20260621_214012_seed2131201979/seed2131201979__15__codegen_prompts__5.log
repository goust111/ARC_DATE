side == 0:\n243:    else:\n245:    grid[0, start_col] = GREEN\n246:    return grid\n250:    \"\"\"Rotate canonical (top-start) grid so the start edge matches `edge`.\"\"\"\n251:    if edge == \"top\":\n253:    if edge == \"bottom\":\n255:    if edge == \"left\":\n257:    return np.fliplr(grid.T).copy()  # edge == \"right\"\n261:    \"\"\"Check whether the solved output has green on the edge opposite to `edge`.\"\"\"\n262:    if edge == \"top\":\n264:    if edge == \"bottom\":\n266:    if edge == \"left\":\n268:    return bool(np.any(out[:, 0] == GREEN))\n272:    \"\"\"Single generation attempt: pick parameters, build grid, validate via solver.\"\"\"\n273:    edge = random.choice((\"top\", \"bottom\", \"left\", \"right\"))\n274:    if edge in (\"top\", \"bottom\"):\n277:    else:\n281:    count = random.randint(BAR_COUNT_LO, BAR_COUNT_HI)\n282:    blues = _choose_blues(count, main_hi)\n283:    main_size = random.randint(max(main_lo, _min_main_len(blues)), main_hi)\n284:    cross_size = random.randint(cross_lo, cross_hi)\n285:    first_side = random.randrange(2)\n287:    canonical = _canonical_grid(main_size, cross_size, blues, first_side)\n288:    if canonical is None:\n290:    inp = _orient_grid(canonical, edge)\n292:    try:\n298:    except Exception:\n300:    return inp\n303:def generate_input() -> np.ndarray:\n304:    for _ in range(MAX_GEN_RETRIES):\n308:    raise RuntimeError(\"failed to generate a valid cb2d8a2c input\")\n","exit_code":0,"status":"completed"}}
