= min(a + shelf_len - 1, W - 1)\n224:                # Check shelf cells don't conflict\n225:                conflict = False\n226:                for c in range(a, b + 1):\n227:                    if (shelf_row, c) in shelf_cells or (shelf_row, c) in reserved_bg:\n228:                        conflict = True\n229:                        break\n230:                if conflict:\n231:                    continue\n233:                # Compute overflow positions\n234:                left = max(0, a - 1)\n235:                right = min(W - 1, b + 1)\n237:                # Check overflow positions on spread row are not shelf\n238:                overflow_ok = True\n239:                for nc in {left, right}:\n240:                    if nc != col:\n241:                        if (spread_row, nc) in shelf_cells:\n242:                            overflow_ok = False\n243:                            break\n244:                if not overflow_ok:\n245:                    continue\n247:                # Add the shelf\n248:                if not try_add_shelf(shelf_row, a, b, is_cascade=True):\n249:                    continue\n251:                cascade_shelves.append((shelf_row, a, b))\n253:                # Reserve overflow positions and fall path cells as bg\n254:                reserve_overflow_and_fall(spread_row, left, right, col)\n256:                # Reserve the fall path from current position to shelf\n257:                for r_res in range(row + 1, shelf_row):\n258:                    reserved_bg.add((r_res, col))\n260:                # Add new streams from overflow\n261:                for nc in {left, right}:\n262:                    if nc != col:\n263:                        next_streams.append((spread_row, nc, depth + 1))\n265:                placed = True\n266:                break\n268:            # If no shelf placed, stream just falls to bottom (that's ok)\n270:        streams = next_streams\n273:        return None\n280:        grid[0, sc] = WATER\n281:        grid[1, sc] = WATER\n285:        for c in range(a, b + 1):\n286:            grid[r, c] = SHELF\n291:        for _attempt in range(20):\n292:            dr = random.randint(1, H - 1)\n293:            dl = random.randint(1, min(8, W))\n294:            da = random.randint(0, W - dl)\n295:            db = da + dl - 1\n296:            # Check no conflict with shelf_cells or reserved_bg\n297:            conflict = False\n298:            for c in range(da, db + 1):\n299:                if (dr, c) in shelf_cells or (dr, c) in reserved_bg:\n300:                    conflict = True\n301:                    break\n302:            if not conflict:\n303:                # Also check distractor doesn't intersect any active water fall path\n304:                # by ensuring it's not on a column where water falls through\n305:                if try_add_shelf(dr, da, db):\n306:                    for c in range(da, db + 1):\n307:                        grid[dr, c] = SHELF\n308:                    break\n312:        out = main(grid.copy())\n314:        return None\n317:        return None\n321:        for c in range(a, b + 1):\n322:            if out[r, c] != SHELF:\n323:                return None\n325:    return grid\n328:def generate_input() -> np.ndarray:\n330:        result = _gen_attempt()\n331:        if result is not None:\n332:            return result\n","exit_code":0,"status":"completed"}}
