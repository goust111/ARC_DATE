{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect framed squares via colored bridges following a control-pixel sequence.\n\n    Input structure:\n    - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.\n    - Control row below squares: colored pixels read left-to-right encode visitation order.\n\n    Rule:\n    - Start at the square matching first control color c0.\n    - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.\n    - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.\n\n    Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # border color = most common non-bg color\n    cnt = Counter(map(int, g.flatten()))\n    border = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            border = int(col)\n            break\n    assert not (border is None)\n\n    # detect framed squares as connected components of the border color\n    lab, n = label_mask(g == int(border), connectivity=4)\n    frames: list[dict] = []\n    for cid in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(cid))\n        if int(pts.shape[0]) < 8:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        if h < 3 or w < 3:\n            continue\n\n        t = None\n        inner_col = None\n        for tt in range(1, int(min(h, w) // 2) + 1):\n            inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]\n            if inner.size == 0:\n                continue\n            if bool((inner == int(border)).any()):\n                continue\n            u = set(map(int, inner.flatten()))\n            if len(u) != 1:\n                continue\n\n            ok = True\n            if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not ok:\n                continue\n\n            t = int(tt)\n            inner_col = int(next(iter(u)))\n            break\n\n        if t is None or inner_col is None:\n            continue\n\n        frames.append(\n            {\n                \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n                \"t\": int(t),\n                \"inner\": int(inner_col),\n                \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            }\n        )\n\n    assert not (not frames)\n\n    by: dict[int, list[dict]] = defaultdict(list)\n    for f in frames:\n        by[int(f[\"inner\"])].append(f)\n\n    max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n\n    # control row = bottom-most row below the squares with >=2 non-bg pixels\n    ctrl_r = None\n    for r in range(int(H - 1), int(max_frame_r), -1):\n        if int((g[int(r)] != int(bg)).sum()) >= 2:\n            ctrl_r = int(r)\n            break\n    assert not (ctrl_r is None)\n\n    ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n    assert not (len(ctrl) < 2)\n\n    def center(f: dict) -> tuple[int, int]:\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        return int((r0 + r1) // 2), int((c0 + c1) // 2)\n\n    def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n        a = f1[\"inner_bbox\"]\n        b = f2[\"inner_bbox\"]\n        same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n        same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))\n        return same_row, same_col\n\n    # choose start frame\n    start_color = int(ctrl[0])\n    assert not (start_color not in by)\n    start_cands = by[start_color]\n    if len(start_cands) == 1:\n        cur = start_cands[0]\n    else:\n        nxt_color = int(ctrl[1])\n        nxt_cands = by.get(nxt_color, [])\n        best = None\n        bestf = None\n        for f in start_cands:\n            for g2 in (nxt_cands if nxt_cands else [f]):\n                sr, sc = aligned(f, g2)\n                al = 1 if (sr or sc) else 0\n                (r1_, c1_) = center(f)\n                (r2_, c2_) = center(g2)\n                d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n                cand = (int(al), -int(d))\n                if best is None or cand > best:\n                    best = cand\n                    bestf = f\n        cur = bestf\n\n    out = g.copy()\n\n    def draw_bridge(fa: dict, fb: dict, color: int) -> None:\n        (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n        (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n        ia = fa[\"inner_bbox\"]\n        sr, sc = aligned(fa, fb)\n        if sr:\n            rr0, rr1 = int(ia[0]), int(ia[2])\n            if int(c1a) < int(c0b):\n                cc0, cc1 = int(c1a + 1), int(c0b - 1)\n            else:\n                cc0, cc1 = int(c1b + 1), int(c0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n            return\n        if sc:\n            cc0, cc1 = int(ia[1]), int(ia[3])\n            if int(r1a) < int(r0b):\n                rr0, rr1 = int(r1a + 1), int(r0b - 1)\n            else:\n                rr0, rr1 = int(r1b + 1), int(r0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n\n    for i in range(int(len(ctrl)) - 1):\n        a = int(ctrl[i])\n        b = int(ctrl[i + 1])\n        assert int(cur[\"inner\"]) == int(a)\n        assert b in by, f\"control color {b} has no matching frame\"\n        cands = by[b]\n        best = None\n        bestf = None\n        for f in cands:\n            sr, sc = aligned(cur, f)\n            al = 1 if (sr or sc) else 0\n            (r1_, c1_) = center(cur)\n            (r2_, c2_) = center(f)\n            d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n            cand = (int(al), -int(d))\n            if best is None or cand > best:\n                best = cand\n                bestf = f\n        nxt = bestf\n        draw_bridge(cur, nxt, int(a))\n        cur = nxt\n\n    return out\n\n\ndef _most_common_nonbg(g: np.ndarray, bg: int) -> int | None:\n    cnt = Counter(map(int, g.flatten()))\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            return int(col)\n    return None\n\ndef _draw_frame(g: np.ndarray, *, r0: int, c0: int, outer: int, t: int, border: int, inner_col: int) -> None:\n    g[int(r0) : int(r0 + outer), int(c0) : int(c0 + outer)] = int(border)\n    g[int(r0 + t) : int(r0 + outer - t), int(c0 + t) : int(c0 + outer - t)] = int(inner_col)\n\ndef _bridge_cells(fa: dict, fb: dict) -> set[tuple[int, int]]:\n    (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n    (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n    ia = fa[\"inner_bbox\"]\n    ib = fb[\"inner_bbox\"]\n    # same-row band\n    if int(ia[0]) == int(ib[0]) and int(ia[2]) == int(ib[2]):\n        rr0, rr1 = int(ia[0]), int(ia[2])\n        if int(c1a) < int(c0b):\n            cc0, cc1 = int(c1a + 1), int(c0b - 1)\n        else:\n            cc0, cc1 = int(c1b + 1), int(c0a - 1)\n        assert int(cc0) <= int(cc1), \"horizontal bridge gap must be non-empty\"\n        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n    # same-col band\n    if int(ia[1]) == int(ib[1]) and int(ia[3]) == int(ib[3]):\n        cc0, cc1 = int(ia[1]), int(ia[3])\n        if int(r1a) < int(r0b):\n            rr0, rr1 = int(r1a + 1), int(r0b - 1)\n        else:\n            rr0, rr1 = int(r1b + 1), int(r0a - 1)\n        assert int(rr0) <= int(rr1), \"vertical bridge gap must be non-empty\"\n        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n    return set()\n\n_DIGITS = [int(i) for i in range(10)]\n\ndef _gen_attempt() -> np.ndarray | None:\n    # --- colors ---\n    bg = int(np.random.choice(np.array(_DIGITS, dtype=int)))\n    border = int(np.random.choice(np.array([d for d in _DIGITS if int(d) != int(bg)], dtype=int)))\n    inner_palette = [int(d) for d in _DIGITS if int(d) not in (int(bg), int(border))]\n    if len(inner_palette) < 3:\n        return None\n\n    # --- geometry ---\n    t = int(np.random.choice(np.array([1, 1, 2], dtype=int)))\n    inner = int(np.random.randint(1, 4))  # 1..3\n    outer = int(inner + 2 * t)\n    if not (3 <= int(outer) <= 7):\n        return None\n\n    # lattice dims and number of squares (all on the path)\n    R = int(np.random.randint(2, 6))\n    C = int(np.random.randint(2, 6))\n    max_frames = int(R * C)\n    if max_frames < 4:\n        return None\n    n_frames = int(np.random.randint(4, int(min(12, max_frames)) + 1))\n\n    # sample a self-avoiding path of length n_frames starting at (0,0)\n    path: list[tuple[int, int]] | None = None\n    for _path_try in range(400):\n        p = [(0, 0)]\n        vis = {(0, 0)}\n        ok = True\n        for _ in range(int(n_frames) - 1):\n            cur = p[-1]\n            r, c = map(int, cur)\n            opts = [\n                (int(rr), int(cc))\n                for rr, cc in neighbors4(int(r), int(c))\n                if in_bounds((int(R), int(C)), int(rr), int(cc)) and (int(rr), int(cc)) not in vis\n            ]\n            if not opts:\n                ok = False\n                break\n            nxt = opts[int(np.random.randint(0, len(opts)))]\n            p.append((int(nxt[0]), int(nxt[1])))\n            vis.add((int(nxt[0]), int(nxt[1])))\n        if not ok:\n            continue\n        # Prefer scenes that span multiple rows/cols (matches eval's \"lattice\" feel).\n        if len({r for r, _c in p}) < 2 or len({c for _r, c in p}) < 2:\n            continue\n        path = p\n        break\n    if path is None:\n        return None\n\n    # sample uneven row/col gaps (eval-like) but keep at least 1 bg cell separation\n    row_gap = [int(np.random.randint(1, 6)) for _ in range(int(R) - 1)]\n    col_gap = [int(np.random.randint(1, 6)) for _ in range(int(C) - 1)]\n    top_margin = int(np.random.randint(1, 4))\n    left_margin = int(np.random.randint(1, 4))\n\n    r0s = [int(top_margin)]\n    for k in range(int(R) - 1):\n        r0s.append(int(r0s[-1] + outer + row_gap[int(k)]))\n    c0s = [int(left_margin)]\n    for k in range(int(C) - 1):\n        c0s.append(int(c0s[-1] + outer + col_gap[int(k)]))\n\n    # frame dicts (only for visited path cells)\n    slot_to_frame: dict[tuple[int, int], dict] = {}\n    frames: list[dict] = []\n    for rr, cc in path:\n        r0 = int(r0s[int(rr)])\n        c0 = int(c0s[int(cc)])\n        r1 = int(r0 + outer - 1)\n        c1 = int(c0 + outer - 1)\n        f = {\n            \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n            \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            \"slot\": (int(rr), int(cc)),\n        }\n        frames.append(f)\n        slot_to_frame[(int(rr), int(cc))] = f\n\n    max_r1 = max(int(f[\"bbox\"][2]) for f in frames)\n    max_c1 = max(int(f[\"bbox\"][3]) for f in frames)\n\n    ctrl_gap = int(np.random.randint(2, 6))\n    ctrl_r = int(max_r1 + ctrl_gap)\n    bottom_margin = 1  # eval-like: exactly one bg row below control row\n    right_margin = int(np.random.randint(1, 5))\n    H = int(ctrl_r + 1 + bottom_margin)\n    W = int(max_c1 + 1 + right_margin)\n\n    if not (7 <= int(H) <= 30 and 7 <= int(W) <= 30):\n        return None\n\n    # Assign inner colors with row/col uniqueness (in lattice coords).\n    # Force the start (top-left) inner color to be unique globally so main() starts correctly.\n    used_in_row: dict[int, set[int]] = defaultdict(set)\n    used_in_col: dict[int, set[int]] = defaultdict(set)\n\n    start_color = int(np.random.choice(np.array(inner_palette, dtype=int)))\n    colors_by_slot: dict[tuple[int, int], int] = {(0, 0): int(start_color)}\n    used_in_row[0].add(int(start_color))\n    used_in_col[0].add(int(start_color))\n\n    for rr, cc in path[1:]:\n        rr = int(rr)\n        cc = int(cc)\n        forbid = set(used_in_row[int(rr)]) | set(used_in_col[int(cc)]) | {int(start_color)}\n        choices = [int(x) for x in inner_palette if int(x) not in forbid]\n        if not choices:\n            return None\n        col = int(np.random.choice(np.array(choices, dtype=int)))\n        colors_by_slot[(int(rr), int(cc))] = int(col)\n        used_in_row[int(rr)].add(int(col))\n        used_in_col[int(cc)].add(int(col))\n\n    if len(colors_by_slot) != len(path):\n        return None\n\n    # Build virtual output: frames + bridges + control row.\n    out = np.full((int(H), int(W)), int(bg), dtype=int)\n    for f in frames:\n        rr, cc = map(int, f[\"slot\"])\n        r0, c0, _r1, _c1 = map(int, f[\"bbox\"])\n        _draw_frame(out, r0=int(r0), c0=int(c0), outer=int(outer), t=int(t), border=int(border), inner_col=int(colors_by_slot[(rr, cc)]))\n\n    # Bridges follow the 1-touch path.\n    bridge_cells_all: set[tuple[int, int]] = set()\n    ok = True\n    for a_slot, b_slot in zip(path, path[1:]):\n        fa = slot_to_frame[(int(a_slot[0]), int(a_slot[1]))]\n        fb = slot_to_frame[(int(b_slot[0]), int(b_slot[1]))]\n        cells = _bridge_cells(fa, fb)\n        if not cells:\n            ok = False\n            break\n        if cells & bridge_cells_all:\n            ok = False\n            break\n        for r, c in cells:\n            if not (0 <= int(r) < int(H) and 0 <= int(c) < int(W)):\n                ok = False\n                break\n            if int(out[int(r), int(c)]) != int(bg):\n                ok = False\n                break\n        if not ok:\n            break\n        paint = int(colors_by_slot[(int(a_slot[0]), int(a_slot[1]))])\n        for r, c in cells:\n            out[int(r), int(c)] = int(paint)\n        bridge_cells_all |= set(cells)\n\n    if not ok:\n        return None\n\n    # Control row encodes full visitation order. In eval, control pixels are at fixed columns:\n    # 1,3,5,... (gap=2), with bg everywhere else.\n    ctrl_colors = [int(colors_by_slot[(int(r), int(c))]) for r, c in path]\n    if len(ctrl_colors) < 2:\n        return None\n    ctrl_cols = [int(1 + 2 * i) for i in range(int(len(ctrl_colors)))]\n    if int(ctrl_cols[-1]) >= int(W):\n        return None\n    for col, cc in zip(ctrl_colors, ctrl_cols):\n        out[int(ctrl_r), int(cc)] = int(col)\n\n    # Invert to input by erasing bridges.\n    inp = out.copy()\n    for r, c in bridge_cells_all:\n        inp[int(r), int(c)] = int(bg)\n\n    # Ensure bg/border are inferred the way main() expects.\n    if int(get_bg(inp)) != int(bg):\n        return None\n    if int(_most_common_nonbg(inp, int(bg)) or -1) != int(border):\n        return None\n\n    # Validate: running main() on input recreates the virtual output exactly.\n    try:\n        pred = main(inp)\n    except Exception:\n        return None\n    if pred.shape != out.shape:\n        return None\n    if not bool(np.array_equal(pred, out)):\n        return None\n\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/df9fd884.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/df9fd884.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Move the colored object from the lower bracket lane to the upper bracket lane and drop it to the bottom edge.\n\n    Input structure\n    - The background is the dominant color.\n    - One frame color forms exactly two 4-connected bracket objects: a top-edge bracket open downward and a bottom-edge bracket open upward.\n    - One other 4-connected foreground object sits in the lower bracket's interior column span.\n\n    Rule\n    - Remove the movable object from its original cells.\n    - Keep its shape and color unchanged.\n    - Paste it with its bbox columns aligned to the top bracket's interior columns and with its bbox bottom aligned to the grid bottom.\n\n    Key insight\n    - The lower bracket identifies the object's source lane; the upper bracket provides the target lane, and the final vertical placement is bottom-aligned.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height, width = g.shape\n    bg = get_bg(g)\n\n    components_by_color = {}\n    bracket_candidates = []\n    for color in colors_present(g, exclude={bg}):\n        components = find_components(\n            g,\n            bg=bg,\n            colors=[color],\n            connectivity=4,\n            monochromatic=True,\n        )\n        components_by_color[color] = components\n        top = [component for component in components if _is_top_bracket(component)]\n        bottom = [\n            component for component in components\n            if _is_bottom_bracket(component, height)\n        ]\n        if len(components) == 2 and len(top) == 1 and len(bottom) == 1:\n            bracket_candidates.append((color, top[0], bottom[0]))\n\n    assert len(bracket_candidates) == 1\n    frame_color, top_bracket, bottom_bracket = bracket_candidates[0]\n\n    movers = [\n        component\n        for color, components in components_by_color.items()\n        if color != frame_color\n        for component in components\n    ]\n    assert len(movers) == 1\n    mover = movers[0]\n\n    _, mc0, _, mc1 = mover[\"bbox\"]\n    _br0, bc0, _br1, bc1 = bottom_bracket[\"bbox\"]\n    _tr0, tc0, _tr1, tc1 = top_bracket[\"bbox\"]\n    assert (mc0, mc1) == (bc0 + 1, bc1 - 1)\n    assert bbox_w(mover[\"bbox\"]) == tc1 - tc0 - 1\n\n    patch = crop_bbox(g, mover[\"bbox\"])\n    dest_r = height - patch.shape[0]\n    dest_c = tc0 + 1\n    assert dest_r >= 0\n    assert dest_c >= 0 and dest_c + patch.shape[1] <= width\n\n    out = g.copy()\n    mover_coords = mover[\"coords\"]\n    out[mover_coords[:, 0], mover_coords[:, 1]] = bg\n\n    colored_patch = patch != bg\n    target = out[dest_r:dest_r + patch.shape[0], dest_c:dest_c + patch.shape[1]]\n    assert np.all(target[colored_patch] == bg)\n\n    paste(out, patch, dest_r, dest_c, transparent=bg)\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed task colors.\nBG_COLOR, BRACKET_COLOR = 7, 4\nMOVER_COLORS = [0, 1, 2, 3, 5, 6, 8, 9]\n# Canvas, bracket, and mover-size bounds.\nGRID_SIZE_RANGE = (8, 9)\nBRACKET_WIDTH_RANGE = (3, 4)\nMOVER_HEIGHT_RANGE = (1, 3)\nMOVER_MAX_CELLS = 4\nMOVER_MIN_DENSITY_NUM = 2\nMOVER_MIN_DENSITY_DEN = 3\n# Layout choices and retry budget.\nTOP_LEFT_OPTIONS = [True, False]\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _gen_half_starts(grid_width, bracket_width, left_side):\n    if left_side:\n        return list(range(0, grid_width // 2 - bracket_width + 1))\n    return list(range((grid_width + 1) // 2, grid_width - bracket_width + 1))\n\ndef _gen_bracket_columns(grid_width, bracket_width):\n    \"\"\"Choose non-overlapping top/bottom bracket starts on opposite halves.\"\"\"\n    top_left = random.choice(TOP_LEFT_OPTIONS)\n    top_starts = _gen_half_starts(grid_width, bracket_width, top_left)\n    bottom_starts = _gen_half_starts(grid_width, bracket_width, not top_left)\n    if not top_starts or not bottom_starts:\n        return None\n    return random.choice(top_starts), random.choice(bottom_starts)\n\ndef _gen_add_bracket(grid, c0, width, top_edge):\n    edge_row, arm_row = (0, 1) if top_edge else (-1, -2)\n    grid[edge_row, c0:c0 + width] = BRACKET_COLOR\n    grid[arm_row, c0] = BRACKET_COLOR\n    grid[arm_row, c0 + width - 1] = BRACKET_COLOR\n\ndef _gen_sprite_masks(height, width):\n    area = height * width\n    min_cells = (MOVER_MIN_DENSITY_NUM * area + MOVER_MIN_DENSITY_DEN - 1) // MOVER_MIN_DENSITY_DEN\n    max_cells = min(MOVER_MAX_CELLS, area)\n    masks = []\n    for cell_count in range(min_cells, max_cells + 1):\n        for cells in itertools.combinations(range(area), cell_count):\n            mask = np.zeros((height, width), dtype=bool)\n            mask[np.unravel_index(cells, (height, width))] = True\n            if not mask.any(axis=0).all() or not mask.any(axis=1).all():\n                continue\n            if is_contiguous(mask.astype(int), background=0, connectivity=4):\n                masks.append(mask)\n    return masks\n\ndef _gen_mover_sprite(height, width, color, bg):\n    masks = _gen_sprite_masks(height, width)\n    if not masks:\n        return None\n    mask = random.choice(masks)\n    sprite = np.full((height, width), bg, dtype=int)\n    sprite[mask] = color\n    return sprite\n\ndef _gen_paste_if_clear(grid, sprite, row, col, sprite_mask):\n    \"\"\"Paste sprite only when every colored sprite cell lands on background.\"\"\"\n    target = grid[row:row + sprite.shape[0], col:col + sprite.shape[1]]\n    if not np.all(target[sprite_mask] == BG_COLOR):\n        return False\n    paste(grid, sprite, row, col, transparent=BG_COLOR)\n    return True\n\ndef _gen_attempt():\n    height = random.randint(*GRID_SIZE_RANGE)\n    grid_width = random.randint(*GRID_SIZE_RANGE)\n    bracket_width = random.randint(*BRACKET_WIDTH_RANGE)\n    interior_width = bracket_width - 2\n\n    bracket_columns = _gen_bracket_columns(grid_width, bracket_width)\n    if bracket_columns is None:\n        return None\n    top_c0, bottom_c0 = bracket_columns\n\n    mover_height = random.randint(*MOVER_HEIGHT_RANGE)\n    mover_color = random.choice(MOVER_COLORS)\n    sprite = _gen_mover_sprite(mover_height, interior_width, mover_color, BG_COLOR)\n    if sprite is None:\n        return None\n\n    out = np.full((height, grid_width), BG_COLOR, dtype=int)\n    _gen_add_bracket(out, top_c0, bracket_width, top_edge=True)\n    _gen_add_bracket(out, bottom_c0, bracket_width, top_edge=False)\n\n    dest_r = height - mover_height\n    dest_c = top_c0 + 1\n    sprite_mask = sprite != BG_COLOR\n    if not _gen_paste_if_clear(out, sprite, dest_r, dest_c, sprite_mask):\n        return None\n\n    inp = out.copy()\n    target = inp[dest_r:dest_r + mover_height, dest_c:dest_c + interior_width]\n    target[sprite_mask] = BG_COLOR\n\n    source_c = bottom_c0 + 1\n    max_source_r = height - 2 - mover_height\n    if max_source_r < 1:\n        return None\n    source_r = random.randint(1, max_source_r)\n    if not _gen_paste_if_clear(inp, sprite, source_r, source_c, sprite_mask):\n        return None\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\ndef generate_input():\n","exit_code":0,"status":"completed"}}
