{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/f0100645.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import components_mask, get_bg, paste\nimport random\n\n\ndef _component_order(coords: np.ndarray, direction: int) -> tuple[int, int, int, int]:\n    rows = coords[:, 0]\n    cols = coords[:, 1]\n    if direction == -1:\n        return (int(cols.min()), int(rows.min()), int(cols.max()), int(rows.max()))\n    assert direction == 1, \"horizontal slide direction must be left or right\"\n    return (-int(cols.max()), int(rows.min()), -int(cols.min()), int(rows.max()))\n\n\ndef _settled_components(g: np.ndarray, color: int, side_col: int, direction: int) -> list[np.ndarray]:\n    h, w = g.shape\n    movable = (g == color)\n    movable[:, side_col] = False\n\n    comps = components_mask(movable, connectivity=8)\n    assert comps, \"expected at least one object away from the matching wall\"\n    comps.sort(key=lambda coords: _component_order(coords, direction))\n\n    settled = np.zeros((h, w), dtype=bool)\n    settled[:, side_col] = True\n    out_coords = []\n\n    for coords in comps:\n        shift = 0\n        while True:\n            candidate = coords + np.array([0, shift + direction])\n            cols = candidate[:, 1]\n            if int(cols.min()) < 0 or int(cols.max()) >= w:\n                break\n            if np.any(settled[candidate[:, 0], candidate[:, 1]]):\n                break\n            shift += direction\n\n        placed = coords + np.array([0, shift])\n        assert not np.any(settled[placed[:, 0], placed[:, 1]]), \"settled objects may touch but not overlap\"\n        settled[placed[:, 0], placed[:, 1]] = True\n        out_coords.append(placed)\n\n    return out_coords\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide each inner colored object horizontally into the same-colored vertical wall until it touches an obstacle.\n\n    Input structure\n    - The background is the dominant color.\n    - The only foreground colors are two non-background colors.\n    - One foreground color fills the left column and the other fills the right column.\n    - Extra 8-connected objects of each wall color appear away from that color's wall.\n\n    Rule\n    - Clear the extra objects from their original positions.\n    - For each wall color, process its 8-connected extra objects from nearest to farthest from the matching wall.\n    - Slide each object horizontally toward its matching wall as far as possible without overlapping the wall or an already settled object of the same color.\n    - Keep the two vertical wall columns fixed.\n\n    Key insight\n    - The side columns act like color-specific gravity walls: same-colored objects compact sideways against their own wall while preserving each object's shape.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and min(g.shape) >= 2, \"expected a non-empty 2D grid with two side columns\"\n\n    bg = get_bg(g)\n    w = g.shape[1]\n    left_color = int(g[0, 0])\n    right_color = int(g[0, w - 1])\n\n    assert left_color != right_color, \"left and right walls must have different colors\"\n    assert bg not in {left_color, right_color}, \"walls must be foreground colors\"\n    assert np.all(g[:, 0] == left_color), \"left wall must fill the full left column\"\n    assert np.all(g[:, w - 1] == right_color), \"right wall must fill the full right column\"\n    assert set(map(int, np.unique(g))) == {int(bg), left_color, right_color}, \"expected exactly background plus two wall colors\"\n\n    out = np.full_like(g, int(bg))\n    out[:, 0] = left_color\n    out[:, w - 1] = right_color\n\n    placements: list[tuple[int, np.ndarray]] = []\n    for color, side_col, direction in ((left_color, 0, -1), (right_color, w - 1, 1)):\n        for coords in _settled_components(g, color, side_col, direction):\n            placements.append((color, coords))\n\n    occupied = (out != bg)\n    for color, coords in placements:\n        assert not np.any(occupied[coords[:, 0], coords[:, 1]]), \"different colors must not settle on the same pixel\"\n        out[coords[:, 0], coords[:, 1]] = color\n        occupied[coords[:, 0], coords[:, 1]] = True\n\n    assert int(np.sum(out == left_color)) == int(np.sum(g == left_color)), \"left color count must be preserved\"\n    assert int(np.sum(out == right_color)) == int(np.sum(g == right_color)), \"right color count must be preserved\"\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and palette bounds.\nGRID_HEIGHT_BOUNDS = (9, 10)\nGRID_WIDTH_BOUNDS = (9, 10)\nBACKGROUND_COLOR = 7\nWALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n# Object counts and pixel budgets.\nCOMPONENT_COUNT_BOUNDS = (2, 3)\nINNER_FOREGROUND_BOUNDS = (15, 23)\nSPRITE_PIXEL_BOUNDS = (1, 7)\n# Sprite geometry limits.\nSPRITE_HEIGHT_BOUNDS = (1, 5)\nSPRITE_WIDTH_BOUNDS = (1, 3)\nMIN_SPRITE_DENSITY = 0.56\n# Input scatter and retry limits.\nSCATTER_OFFSET_BOUNDS = (1, 5)\nGENERATION_ATTEMPTS = 300\n\nPlacement = tuple[int, np.ndarray, int, int, bool]\n\n\ndef _gen_bounded_composition(total: int, parts: int, lo: int, hi: int) -> list[int]:\n    values = []\n    remaining = int(total)\n    for i in range(int(parts)):\n        slots = int(parts) - i - 1\n        low = max(int(lo), remaining - int(hi) * slots)\n        high = min(int(hi), remaining - int(lo) * slots)\n        value = random.randint(low, high)\n        values.append(value)\n        remaining -= value\n    random.shuffle(values)\n    return values\n\n\ndef _gen_sprite_mask(size: int) -> np.ndarray:\n    size = int(size)\n    dims = [\n        (h, w)\n        for h in range(SPRITE_HEIGHT_BOUNDS[0], SPRITE_HEIGHT_BOUNDS[1] + 1)\n        for w in range(SPRITE_WIDTH_BOUNDS[0], SPRITE_WIDTH_BOUNDS[1] + 1)\n        if max(h, w) <= size <= h * w and size / (h * w) >= MIN_SPRITE_DENSITY\n    ]\n    h, w = random.choice(dims)\n\n    coords: set[tuple[int, int]] = set()\n    length = max(h, w)\n    if length == 1:\n        coords.add((0, 0))\n    else:\n        for i in range(length):\n            r = (i * (h - 1) + (length - 1) // 2) // (length - 1)\n            c = (i * (w - 1) + (length - 1) // 2) // (length - 1)\n            coords.add((int(r), int(c)))\n\n    while len(coords) < size:\n        frontier = []\n        for r, c in coords:\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    if dr == 0 and dc == 0:\n                        continue\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in coords:\n                        frontier.append((nr, nc))\n        coords.add(random.choice(frontier))\n\n    mask = np.zeros((h, w), dtype=bool)\n    for r, c in coords:\n        mask[r, c] = True\n    if random.choice([False, True]):\n        mask = np.flipud(mask)\n    if random.choice([False, True]):\n        mask = np.fliplr(mask)\n    return mask.copy()\n\n\ndef _gen_mask_coords(mask: np.ndarray, r0: int, c0: int) -> np.ndarray:\n    return np.argwhere(mask) + np.array([int(r0), int(c0)])\n\n\ndef _gen_base_grid(shape: tuple[int, int], bg: int, left_color: int, right_color: int) -> np.ndarray:\n    grid = np.full(shape, int(bg), dtype=int)\n    grid[:, 0] = int(left_color)\n    grid[:, shape[1] - 1] = int(right_color)\n    return grid\n\n\ndef _gen_place_output_side(\n    out: np.ndarray, color: int, masks: list[np.ndarray], *, left_side: bool, bg: int\n) -> list[Placement]:\n    h, w = out.shape\n    placements = []\n    for mask in sorted(masks, key=lambda m: int(m.sum()), reverse=True):\n        mh, mw = mask.shape\n        c0 = 1 if left_side else w - 1 - mw\n        rows = list(range(0, h - mh + 1))\n        random.shuffle(rows)\n        for r0 in rows:\n            coords = _gen_mask_coords(mask, r0, c0)\n            if np.any(out[coords[:, 0], coords[:, 1]] != bg):\n                continue\n            patch = np.where(mask, int(color), int(bg))\n            paste(out, patch, r0, c0, transparent=bg)\n            placements.append((int(color), mask, int(r0), int(c0), bool(left_side)))\n            break\n        else:\n            return []\n    return placements\n\n\ndef _gen_touches_existing(coords: np.ndarray, existing: list[np.ndarray]) -> bool:\n    for other in existing:\n        dr = np.abs(coords[:, None, 0] - other[None, :, 0])\n        dc = np.abs(coords[:, None, 1] - other[None, :, 1])\n        if bool(np.any((dr <= 1) & (dc <= 1))):\n            return True\n    return False\n\n\ndef _gen_scatter_input(\n    shape: tuple[int, int], bg: int, left_color: int, right_color: int, placements: list[Placement]\n) -> np.ndarray | None:\n    h, w = shape\n    inp = _gen_base_grid((h, w), bg, left_color, right_color)\n    by_color: dict[int, list[np.ndarray]] = {int(left_color): [], int(right_color): []}\n\n    shuffled = list(placements)\n    random.shuffle(shuffled)\n    for color, mask, r0, c_out, left_side in shuffled:\n        mh, mw = mask.shape\n        max_offset = (w - 2 - (c_out + mw - 1)) if left_side else (c_out - 1)\n        offsets = list(range(SCATTER_OFFSET_BOUNDS[0], min(SCATTER_OFFSET_BOUNDS[1], int(max_offset)) + 1))\n        random.shuffle(offsets)\n        for offset in offsets:\n            c_in = c_out + offset if left_side else c_out - offset\n            coords = _gen_mask_coords(mask, r0, c_in)\n            if np.any(inp[coords[:, 0], coords[:, 1]] != bg):\n                continue\n            if _gen_touches_existing(coords, by_color[int(color)]):\n                continue\n            patch = np.where(mask, int(color), int(bg))\n            paste(inp, patch, r0, c_in, transparent=bg)\n            by_color[int(color)].append(coords)\n            break\n        else:\n            return None\n    return inp\n\n\ndef _gen_output_layout(\n    shape: tuple[int, int], bg: int, left_color: int, right_color: int,\n    left_masks: list[np.ndarray], right_masks: list[np.ndarray],\n) -> tuple[np.ndarray, list[Placement]] | None:\n    out = _gen_base_grid(shape, bg, left_color, right_color)\n    left_placements = _gen_place_output_side(out, left_color, left_masks, left_side=True, bg=bg)\n    if len(left_placements) != len(left_masks):\n        return None\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/11dc524f.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste\nimport itertools\nimport random\n\n\ndef _intervals_overlap(a0: int, a1: int, b0: int, b1: int) -> bool:\n    return max(int(a0), int(b0)) <= min(int(a1), int(b1))\n\n\ndef _is_solid_2x2(comp: dict, g: np.ndarray) -> bool:\n    r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n    return (\n        int(comp[\"area\"]) == 4\n        and int(r1 - r0 + 1) == 2\n        and int(c1 - c0 + 1) == 2\n        and bool((g[r0 : r1 + 1, c0 : c1 + 1] == int(comp[\"color\"])).all())\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide the non-square sprite to the square anchor and replace the anchor with the sprite's mirror image.\n\n    Input structure:\n    - The background is the most common color.\n    - There is one 8-connected non-background sprite that is not a solid 2x2 square.\n    - There is one solid 2x2 square anchor in another non-background color.\n\n    Rule:\n    - Move the sprite straight toward the anchor along their unique cardinal separation until it touches the anchor's near edge.\n    - Reflect the moved sprite across that near edge and draw the reflected copy in the anchor color.\n    - Clear the original locations; the output keeps only the moved sprite and reflected anchor-color copy.\n\n    Key insight:\n    - The 2x2 square marks the mirror line: its side facing the sprite becomes the contact edge for a two-color reflected pair.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = map(int, g.shape)\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert len(comps) == 2\n\n    anchors = [comp for comp in comps if _is_solid_2x2(comp, g)]\n    assert len(anchors) == 1\n    anchor = anchors[0]\n\n    sprites = [comp for comp in comps if comp is not anchor]\n    assert len(sprites) == 1\n    sprite = sprites[0]\n    assert int(sprite[\"color\"]) != int(anchor[\"color\"])\n\n    sr0, sc0, sr1, sc1 = map(int, sprite[\"bbox\"])\n    ar0, ac0, ar1, ac1 = map(int, anchor[\"bbox\"])\n\n    candidates: list[tuple[str, int, int]] = []\n    if sc1 < ac0 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"left\", 0, ac0 - sc1 - 1))\n    if sc0 > ac1 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"right\", 0, ac1 + 1 - sc0))\n    if sr1 < ar0 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"above\", ar0 - sr1 - 1, 0))\n    if sr0 > ar1 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"below\", ar1 + 1 - sr0, 0))\n    assert len(candidates) == 1\n\n    side, dr, dc = candidates[0]\n    moved: list[tuple[int, int]] = []\n    mirrored: list[tuple[int, int]] = []\n    for r, c in sprite[\"coords\"]:\n        rr = int(r) + int(dr)\n        cc = int(c) + int(dc)\n        moved.append((rr, cc))\n        if side == \"left\":\n            mirrored.append((rr, 2 * ac0 - 1 - cc))\n        elif side == \"right\":\n            mirrored.append((rr, 2 * ac1 + 1 - cc))\n        elif side == \"above\":\n            mirrored.append((2 * ar0 - 1 - rr, cc))\n        else:\n            mirrored.append((2 * ar1 + 1 - rr, cc))\n\n    assert all(0 <= r < H and 0 <= c < W for r, c in moved)\n    assert all(0 <= r < H and 0 <= c < W for r, c in mirrored)\n    assert not (set(moved) & set(mirrored))\n\n    out = np.full_like(g, bg)\n    for r, c in moved:\n        out[r, c] = int(sprite[\"color\"])\n    for r, c in mirrored:\n        out[r, c] = int(anchor[\"color\"])\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import is_contiguous\n\n# ── Config ──────────────────────────────────────────────────────────────\nGRID_MIN, GRID_MAX = 10, 20        # canvas size range (rows and cols)\nSPRITE_AREA = 4                     # number of filled cells per sprite\nSPRITE_BBOX_SHAPES = [(2, 3), (3, 2), (3, 3)]  # allowed sprite bbox dims\nGAP_MIN, GAP_MAX = 2, 4            # empty-cell gap between sprite and anchor\nANCHOR_SIZE = 2                     # anchor is always a 2x2 solid square\nNUM_COLORS = 10                     # ARC color palette size\nSIDES = [\"left\", \"right\", \"above\", \"below\"]\nRETRY_LIMIT = 300                   # max attempts before raising\n\n\ndef _has_full_bbox(mask: np.ndarray) -> bool:\n    \"\"\"True if mask has at least one filled cell on each edge of its bounding box.\"\"\"\n    return (mask[0].any() and mask[-1].any() and\n            mask[:, 0].any() and mask[:, -1].any())\n\n\ndef _sprite_masks(axis: str) -> list[np.ndarray]:\n    \"\"\"Enumerate all valid 4-cell sprite masks for a given mirror axis.\n\n    A valid mask is 8-connected, spans its full bbox, and is NOT symmetric\n    along the given axis (lr or ud).\n    \"\"\"\n    flip = np.fliplr if axis == \"lr\" else np.flipud\n    out = []\n    for h, w in SPRITE_BBOX_SHAPES:\n        for cells in itertools.combinations(range(h * w), SPRITE_AREA):\n            mask = np.zeros((h, w), dtype=bool)\n            for cell in cells:\n                mask[cell // w, cell % w] = True\n            if not _has_full_bbox(mask):\n                continue\n            if not is_contiguous(mask, connectivity=8):\n                continue\n            if np.array_equal(mask, flip(mask)):\n                continue\n            out.append(mask)\n    return out\n\n\n_MASKS = {\"lr\": _sprite_masks(\"lr\"), \"ud\": _sprite_masks(\"ud\")}\n\n\ndef _paint_mask(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int,\n                color: int, bg: int) -> None:\n    \"\"\"Stamp a boolean mask onto grid at (r0, c0) using the given color.\"\"\"\n    patch = np.full(mask.shape, bg, dtype=int)\n    patch[mask] = color\n    paste(grid, patch, r0, c0, transparent=bg)\n\n\ndef _rand_pair_origin(H: int, W: int, h: int, w: int, side: str,\n                      gap: int) -> tuple[int, int] | None:\n    \"\"\"Pick a random origin for the touching sprite+mirror pair.\n\n    Returns (row, col) of the output pair's top-left corner, or None if the\n    pair cannot fit on the grid with enough room for the input-side gap.\n    \"\"\"\n    if side in {\"left\", \"right\"}:\n        r_lo, r_hi = 0, H - h\n        total_w = 2 * w + (gap if side == \"right\" else 0)\n        c_lo = gap if side == \"left\" else 0\n        c_hi = W - total_w if side == \"right\" else W - 2 * w\n    else:\n        c_lo, c_hi = 0, W - w\n        total_h = 2 * h + (gap if side == \"below\" else 0)\n        r_lo = gap if side == \"above\" else 0\n        r_hi = H - total_h if side == \"below\" else H - 2 * h\n    if r_lo > r_hi or c_lo > c_hi:\n        return None\n    return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)\n\n\ndef _layout_for_side(side: str, pr: int, pc: int, h: int, w: int,\n                     gap: int, sprite: np.ndarray):\n    \"\"\"Compute output and input placement params for a given side.\n\n    Returns (sprite_r, sprite_c, mirror_r, mirror_c, flipped_sprite,\n             anchor_r, anchor_c, input_r, input_c).\n    \"\"\"\n    flip = np.fliplr if side in {\"left\", \"right\"} else np.flipud\n    flipped = flip(sprite)\n\n    if side == \"left\":\n        sr, sc = pr, pc                     # sprite at pair origin\n        mr, mc = sr, sc + w                  # mirror right of sprite\n        anchor_r = random.randint(sr, sr + h - ANCHOR_SIZE)\n        anchor_c = sc + w\n        input_r, input_c = sr, sc - gap\n    elif side == \"right\":\n        sr, sc = pr, pc + w                  # sprite right half\n        mr, mc = pr, pc                      # mirror left half\n        anchor_r = random.randint(sr, sr + h - ANCHOR_SIZE)\n        anchor_c = sc - ANCHOR_SIZE\n        input_r, input_c = sr, sc + gap\n    elif side == \"above\":\n        sr, sc = pr, pc                      # sprite at top\n        mr, mc = sr + h, sc                  # mirror below\n        anchor_r = sr + h\n        anchor_c = random.randint(sc, sc + w - ANCHOR_SIZE)\n        input_r, input_c = sr - gap, sc\n    else:  # below\n        sr, sc = pr + h, pc                  # sprite at bottom\n        mr, mc = pr, pc                      # mirror above\n        anchor_r = sr - ANCHOR_SIZE\n        anchor_c = random.randint(sc, sc + w - ANCHOR_SIZE)\n        input_r, input_c = sr + gap, sc\n\n    return sr, sc, mr, mc, flipped, anchor_r, anchor_c, input_r, input_c\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Try to build one valid (input, output) pair; return input or None.\"\"\"\n    H = random.randint(GRID_MIN, GRID_MAX)\n    W = random.randint(GRID_MIN, GRID_MAX)\n    bg = random.randrange(NUM_COLORS)\n    sprite_color, anchor_color = random.sample(\n        [c for c in range(NUM_COLORS) if c != bg], 2)\n\n    side = random.choice(SIDES)\n    axis = \"lr\" if side in {\"left\", \"right\"} else \"ud\"\n    sprite = random.choice(_MASKS[axis]).copy()\n    h, w = map(int, sprite.shape)\n    gap = random.randint(GAP_MIN, GAP_MAX)\n\n    origin = _rand_pair_origin(H, W, h, w, side, gap)\n    if origin is None:\n        return None\n    pr, pc = origin\n\n    (sr, sc, mr, mc, flipped,\n     anchor_r, anchor_c, input_r, input_c) = _layout_for_side(\n        side, pr, pc, h, w, gap, sprite)\n\n    # Build expected output\n    out = np.full((H, W), bg, dtype=int)\n    _paint_mask(out, sprite, sr, sc, sprite_color, bg)\n    _paint_mask(out, flipped, mr, mc, anchor_color, bg)\n\n    # Build input\n    inp = np.full((H, W), bg, dtype=int)\n    _paint_mask(inp, sprite, input_r, input_c, sprite_color, bg)\n    paste(inp, np.full((ANCHOR_SIZE, ANCHOR_SIZE), anchor_color, dtype=int),\n          anchor_r, anchor_c)\n\n    # Oracle validation\n    comps = find_components(inp, bg=bg, connectivity=8, monochromatic=True)\n    if len(comps) != 2:\n        return None\n    try:\n        solved = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(solved, out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
