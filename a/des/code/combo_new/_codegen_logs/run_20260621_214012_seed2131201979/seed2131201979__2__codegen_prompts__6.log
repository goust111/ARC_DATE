{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed2131201979/2/6.py')\nmod = SourceFileLoader('new_arc_task_dbg', str(p)).load_module()\n\nfor seed in range(10000):\n    rng = np.random.default_rng(seed)\n    try:\n        cand = mod._generate_candidate(rng)\n    except Exception as e:\n        print('seed', seed, 'error', type(e).__name__, e)\n        # recreate piece specs step by step using same seed path\n        rng = np.random.default_rng(seed)\n        rows_n, cols_n = mod.LAYOUTS[int(rng.integers(len(mod.LAYOUTS)))]\n        piece_count = rows_n * cols_n\n        colors = [int(x) for x in rng.choice(np.array(mod.BODY_COLORS), size=piece_count, replace=False)]\n        min_h = max(4, cols_n + 1)\n        min_w = max(4, rows_n + 1)\n        row_heights = mod._sample_distinct(rng, min_h, 8, rows_n)\n        col_widths = mod._sample_distinct(rng, min_w, 8, cols_n)\n        specs = []\n        color_idx = 0\n        for i in range(rows_n):\n            row_specs = []\n            for j in range(cols_n):\n                row_specs.append(mod._blank_piece_spec(row_heights[i], col_widths[j], colors[color_idx]))\n                color_idx += 1\n            specs.append(row_specs)\n        for i in range(rows_n):\n            offsets = [int(x) for x in rng.choice(np.arange(1, row_heights[i] - 1), size=cols_n - 1, replace=False)]\n            for j, offset in enumerate(offsets):\n                left = specs[i][j]\n                right = specs[i][j + 1]\n                if bool(rng.integers(0, 2)):\n                    left['E']['protrusion'] = offset\n                    right['W']['notch'] = offset\n                else:\n                    left['E']['notch'] = offset\n                    right['W']['protrusion'] = offset\n        for j in range(cols_n):\n            offsets = [int(x) for x in rng.choice(np.arange(1, col_widths[j] - 1), size=rows_n - 1, replace=False)]\n            for i, offset in enumerate(offsets):\n                top = specs[i][j]\n                bottom = specs[i + 1][j]\n                if bool(rng.integers(0, 2)):\n                    top['S']['protrusion'] = offset\n                    bottom['N']['notch'] = offset\n                else:\n                    top['S']['notch'] = offset\n                    bottom['N']['protrusion'] = offset\n        patches = [mod._piece_patch(specs[i][j]) for i in range(rows_n) for j in range(cols_n)]\n        grid = mod._scatter_patches(rng, patches)\n        print('layout', (rows_n, cols_n), 'rows', row_heights, 'cols', col_widths)\n        for idx, patch in enumerate(patches):\n            print('patch', idx, patch.shape)\n            print(patch)\n        if grid is not None:\n            print('grid shape', grid.shape)\n            print(grid)\n            bg = mod._dominant_color(grid)\n            for ci, pts in enumerate(mod._components(grid \"'!= bg)):\n                vals = {int(grid[r,c]) for r,c in pts}\n                bodies = sorted(vals - {bg, mod.MAROON})\n                print('\"'comp', ci, 'colors', vals, 'body', bodies)\n                color = bodies[0]\n                body_pts = [(r,c) for r,c in pts if int(grid[r,c]) == color]\n                r0,c0,r1,c1 = mod._bbox(body_pts)\n                h = r1-r0+1; w = c1-c0+1\n                body_set = set(body_pts)\n                print('bbox', (r0,c0,r1,c1), 'hw', (h,w))\n                print('top missing', [k for k in range(w) if (r0, c0+k) not in body_set])\n                print('bot missing', [k for k in range(w) if (r1, c0+k) not in body_set])\n                print('left missing', [k for k in range(h) if (r0+k, c0) not in body_set])\n                print('right missing', [k for k in range(h) if (r0+k, c1) not in body_set])\n        break\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
