kground and bottom-aligned, one-cell-wide vertical bars.\n46:    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n47:    Rule\n48:    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n49:    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n50:    - Red bars that are not reached from a blue marker remain unchanged.\n51:    Key insight\n52:    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n53:    \"\"\"\n54:    g = np.asarray(grid, dtype=int)\n55:    bg = get_bg(g)\n56:    colors = set(map(int, np.unique(g))) - {bg}\n57:    assert colors <= {MARKER_COLOR, BODY_COLOR}\n58:    assert MARKER_COLOR in colors\n59:\n60:    bars = _vertical_bars(g, bg)\n61:    by_col = {bar[\"col\"]: bar for bar in bars}\n62:    assert len(by_col) == len(bars)\n63:\n64:    baselines = {bar[\"bottom\"] for bar in bars}\n65:    assert len(baselines) == 1\n66:    baseline = baselines.pop()\n67:    out = g.copy()\n68:    for bar in bars:\n69:        if bar[\"color\"] != MARKER_COLOR:\n70:            continue\n71:\n72:        group = [bar]\n73:        current = bar\n74:        while True:\n75:            next_col = current[\"col\"] + current[\"height\"]\n76:            next_bar = by_col.get(next_col)\n77:            if next_bar is None:\n78:                break\n79:            if next_bar[\"color\"] != BODY_COLOR:\n80:                break\n81:            group.append(next_bar)\n82:            current = next_bar\n83:\n84:        for item in group:\n85:            rows = item[\"coords\"][:, 0]\n86:            cols = item[\"coords\"][:, 1]\n87:            out[rows, cols] = bg\n88:\n89:        for item in group:\n90:            col = item[\"col\"]\n91:            height = item[\"height\"]\n92:            assert col + height <= g.shape[1]\n93:            out[baseline, col : col + height] = item[\"color\"]\n94:\n95:    return out\n96:\n97:# --------------- generator (att2) ---------------\n98:\n99:# Canvas bounds.\n100:MIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n101:\n102:# Bar and chain structure.\n103:MIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\n104:MIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\n105:MIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n106:\n107:# Layout padding and retry budget.\n108:GAP_VALUES = (1, 2, 3)\n109:MAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n110:\n111:\n112:def _chain_red_distributions(n_blue, n_red):\n113:    \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n114:    return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n115:\n116:\n117:def _bounded_tuples(values, n, max_sum):\n118:    \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n119:    return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n120:\n121:\n122:def _sample_groups():\n123:    \"\"\"Sample row count and bar groups before physical layout.\"\"\"\n124:    rows = random.randint(MIN_ROWS, MAX_ROWS)\n125:    max_height = min(MAX_BAR_HEIGHT, rows)\n126:    n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)\n127:    max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)\n128:    red_total = random.randint(MIN_RED_BARS, max_red)\n129:    min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)\n130:    max_unchained = min(MAX_UNCHAINED_RED, red_total)\n131:    n_unchained = random.randint(min_unchained, max_unchained)\n132:\n133:    distributions = _chain_red_distributions(n_blue, red_total - n_unchained)\n134:    if not distributions:\n135:        return N