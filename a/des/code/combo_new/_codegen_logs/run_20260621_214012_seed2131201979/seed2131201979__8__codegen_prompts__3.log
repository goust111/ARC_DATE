217:    Rule:\n218:    - Detect the containment tree of foreground objects using holes of each frame object.\n219:    - Replace every blob with one foreground pixel.\n220:    - Replace every frame with a rectangular border padded two cells around its direct children.\n221:    - Place siblings by their original row/column overlap and order, with one empty cell between canonical objects.\n222:\n223:    Key insight: The exact wobbly geometry is irrelevant; only enclosure plus relative sibling positions define the output.\n224:    \"\"\"\n225:    g = np.asarray(grid, dtype=int)\n226:    bg = int(get_bg(g))\n227:    fg_colors = sorted(set(map(int, g.flatten())) - {bg})\n228:    assert len(fg_colors) == 1\n229:    fg = int(fg_colors[0])\n230:\n231:    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg], return_format=\"dict\")\n232:    assert comps\n233:\n234:    nodes: list[_Node] = []\n235:    holes: list[list[np.ndarray]] = []\n236:    for comp in comps:\n237:        coords = np.asarray(comp[\"coords\"], dtype=int)\n238:        node = _Node(\n239:            coords=coords,\n240:            bbox=tuple(map(int, comp[\"bbox\"])),\n241:            center=coords.mean(axis=0),\n242:        )\n243:        node_holes = _component_holes(g.shape, coords)\n244:        node.is_frame = bool(node_holes)\n245:        nodes.append(node)\n246:        holes.append(node_holes)\n247:\n248:    assert any(node.is_frame for node in nodes)\n249:    for node_i, node in enumerate(nodes):\n250:        containers = []\n251:        for frame_i, frame in enumerate(nodes):\n252:            if node_i == frame_i or not frame.is_frame:\n253:                continue\n254:            if any(np.all(hole[tuple(node.coords.T)]) for hole in holes[frame_i]):\n255:                containers.append(frame)\n256:        if containers:\n257:            node.parent = min(containers, key=lambda item: int(item.coords.shape[0]))\n258:            node.parent.children.append(node)\n259:\n260:    roots = [node for node in nodes if node.parent is None]\n261:    mask = _layout_root(roots)\n262:    out = np.full(mask.shape, bg, dtype=int)\n263:    out[mask] = fg\n264:    return out\n265:\n266:# --------------- generator (o5x) ---------------\n267:\n268:# ── CFG: tunable generation parameters ──────────────────────────────────────\n269:# Grid / canvas bounds\n270:GRID_MIN = 16              # minimum grid dimension (rows or cols)\n271:GRID_MAX = 25              # maximum grid dimension\n272:MAX_EXTRA_PAD = 12         # max total padding beyond drawing extent\n273:MAX_PAD_PER_SIDE = 6       # max padding on one side\n274:\n275:# Frame geometry\n276:FRAME_H_RANGE = (7, 20)    # allowed frame bbox height\n277:FRAME_W_RANGE = (7, 24)    # allowed frame bbox width\n278:FRAME_CORNER_MAX = 5       # max corner wobble displacement\n279:FRAME_MIN_EDGE = 2         # min straight-edge length between corners\n280:FRAME_TURN_RATIO = (0.34, 0.43)  # acceptable turn-ratio range for wobbly loops\n281:FRAME_RETRIES = 60         # retries per frame-mask generation\n282:\n283:# Blob geometry\n284:BLOB_SIZE_RANGE = (4, 11)  # blob pixel count range\n285:BLOB_BBOX_RANGE = (2, 5)   # blob bbox dimension range (exclusive upper)\n286:\n287:# Layout / arrangement\n288:ARRANGE_GAP_COMPACT = (2, 3)   # inter-sibling gap range (compact mode)\n289:ARRANGE_GAP_NORMAL = (2, 5)    # inter-sibling gap range (normal mode)\n290:ARRANGE_EXTRA_SPAN = (0, 4)    # extra span added to cross-axis in arrangement\n291:FRAME_MARGIN_RANGE = (3, 5)    # margin around children inside a frame\n292:COMPACT_MARGIN = 3             # fixed margin in compact mode\n293:\n294:# Outside blob placement\n295:OUTSIDE_GAP_RANGE = (2, 5)    # gap between frame and outside blob\n296:\n297:# Tree structure probabilities\n298:DEPTH1_PROB = 0.35             # probability of depth-1 (blobs-only) tree\n299:OUTSIDE_BLOB_PROB = 0.35       # probability of having an outside blob\n300:DEPTH1_INSIDE_RANGE = (1, 3)   # blobs ins