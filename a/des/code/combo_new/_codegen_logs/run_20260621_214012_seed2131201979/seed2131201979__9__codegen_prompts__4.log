{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/9f41bd9c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the side-attached foreground object to the opposite wall, shear its lower rows inward, and paint the crossed floor cells.\n\n    Input structure:\n    - The top row is the upper background color and the bottom row is the\n      floor color.\n    - A single non-background, non-floor object touches exactly one vertical\n      grid edge and rests immediately above the first solid floor row.\n\n    Rule:\n    - Clear the source object to the upper background color.\n    - Repaint each object row on the opposite side: the first three relative\n      rows keep the edge alignment, and each lower row shifts one more pixel\n      inward from that side.\n    - On the first floor row, repaint the traversed side-to-object segment\n      maroon, stopping just before the final outer bottom support pixel.\n\n    Key insight:\n    - The side of the source object gives the horizontal direction, while the\n      row index inside the object gives the one-cell-per-row diagonal shear.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"grid must be two-dimensional\"\n    height, width = g.shape\n\n    top_colors = np.unique(g[0])\n    bottom_colors = np.unique(g[-1])\n    assert len(top_colors) == 1, \"top row must be a uniform background\"\n    assert len(bottom_colors) == 1, \"bottom row must be a uniform floor\"\n    bg = int(top_colors[0])\n    floor = int(bottom_colors[0])\n    assert bg != floor, \"background and floor colors must differ\"\n\n    colors = set(map(int, np.unique(g)))\n    assert len(colors) == 3, \"expected exactly background, floor, and one object color\"\n    object_colors = colors - {bg, floor}\n    assert len(object_colors) == 1, \"expected one moving object color\"\n    obj = object_colors.pop()\n\n    full_floor_rows = np.where(np.all(g == floor, axis=1))[0]\n    assert len(full_floor_rows) > 0, \"expected a solid floor row\"\n    floor_row = int(full_floor_rows[0])\n    assert 0 < floor_row < height, \"floor row must be inside the grid\"\n    assert np.all(g[floor_row:] == floor), \"floor must be a solid bottom band\"\n\n    obj_coords = np.argwhere(g == obj)\n    assert len(obj_coords) > 0, \"expected a moving object\"\n    r0, c0, r1, c1 = bbox_coords(obj_coords)\n    object_width = c1 - c0 + 1\n    assert r1 == floor_row - 1, \"object must rest directly above the floor\"\n    assert (c0 == 0) ^ (c1 == width - 1), \"object must touch exactly one side edge\"\n    assert np.all(g[:floor_row][g[:floor_row] != obj] == bg), \"upper region must contain only bg and object\"\n\n    moving_right = c0 == 0\n    out = g.copy()\n    out[g == obj] = bg\n\n    for r in range(r0, r1 + 1):\n        rel_r = r - r0\n        rel_cols = np.where(g[r, c0 : c1 + 1] == obj)[0]\n        assert len(rel_cols) > 0, \"every object bbox row must contain object pixels\"\n\n        inward_shift = max(0, rel_r - 2)\n        if moving_right:\n            start_col = width - object_width - inward_shift\n        else:\n            start_col = inward_shift\n        dst_cols = start_col + rel_cols\n        assert int(dst_cols.min()) >= 0 and int(dst_cols.max()) < width, \"moved object must fit in the grid\"\n        out[r, dst_cols] = obj\n\n    bottom_rel_cols = np.where(g[r1, c0 : c1 + 1] == obj)[0]\n    bottom_shift = max(0, r1 - r0 - 2)\n    bottom_start = width - object_width - bottom_shift if moving_right else bottom_shift\n    final_bottom_cols = bottom_start + bottom_rel_cols\n    trail_color = Color.MAROON\n    assert int(trail_color) not in colors, \"trail color must be new\"\n    if moving_right:\n        trail_end = int(final_bottom_cols.max()) - 1\n        assert trail_end >= 0, \"trail must cover at least one floor pixel\"\n        out[floor_row, : trail_end + 1] = int(trail_color)\n    else:\n        trail_start = int(final_bottom_cols.min()) + 1\n        assert trail_start < width, \"trail must cover at least one floor pixel\"\n        out[floor_row, trail_start:] = int(trail_color)\n\n    return out\n\n# --------------- generator (att2) ---------------\n# Canvas and band bounds.\nGRID_ROWS = range(16, 19)\nGRID_COLS = (16, 18)\nFLOOR_THICKNESS = range(4, 7)\nEMPTY_ROWS = range(3, 7)\n# Object shape and fit constraints.\nOBJECT_WIDTH = 5\nOBJECT_HEIGHT = (5, 11)\nSOLID_TOP_ROWS = 2\nSHEAR_LOCK_ROWS = 3\nCHECKER_COLS = (0, 2, 4)\n# Colors and retry budget.\nTRAIL_COLOR = int(Color.MAROON)\nAVAILABLE_COLORS = [c for c in range(10) if c != TRAIL_COLOR]\nMAX_GENERATION_ATTEMPTS = 300\nSIDES = (\"left\", \"right\")\n\nROW_LAYOUTS = [\n    (rows, floor_thick, empty_rows, rows - floor_thick - empty_rows)\n    for rows in GRID_ROWS\n    for floor_thick in FLOOR_THICKNESS\n    for empty_rows in EMPTY_ROWS\n    if OBJECT_HEIGHT[0] <= rows - floor_thick - empty_rows <= OBJECT_HEIGHT[1]\n]\n\n\ndef _gen_object_mask(height: int) -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fit a grey bar into a grey frame by aligning projections with colored columns, then stack colors above.\n\n    Input structure:\n    - bg, a grey structural color forming two components: a large rectangular frame (slot) and a smaller bar with upward projections.\n    - Colored pixels inside the slot mark target columns.\n\n    Rule:\n    - Move the bar upward into the slot so its bottom edge sits one cell above the slot's interior bottom.\n    - Shift it horizontally so the bar's upward projections align column-wise with the colored pixels in the slot.\n    - Stack the colored pixels immediately above the bar projections in each column.\n\n    Key insight: The bar's projections act as keys that must align with the colored-column \"locks\" in the slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    # Background: most frequent. \"Grey\" structural color: most frequent non-bg.\n    bg = _bg_color(g)\n    other = g[g != bg]\n    if other.size == 0:\n        return g.copy()\n    grey = _most_common(other)\n\n    def comps_of_color(color: int):\n        comps = [(len(pts), _bbox(pts), pts) for pts in _cc4(g == color)]\n        comps.sort(key=lambda t: (-t[0], t[1]))\n        return comps\n\n    grey_comps = comps_of_color(grey)\n    if len(grey_comps) < 2:\n        return g.copy()\n\n    # Slot is the largest grey component (the right-side frame); bar is the next largest.\n    (_, slot_bbox, _), (_, bar_bbox, bar_pts) = grey_comps[0], grey_comps[1]\n    sr0, sc0, sr1, sc1 = slot_bbox\n\n    # Base output: keep only the slot bbox content, clear all colored pixels inside it.\n    out = np.full_like(g, bg)\n    out[sr0 : sr1 + 1, sc0 : sc1 + 1] = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region = out[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region[(slot_region != bg) & (slot_region != grey)] = bg\n\n    # Compute bar translation: bottom of bar sits 1 cell above slot interior bottom.\n    bar_base_row = max(r for r, _ in bar_pts)\n    slot_interior_bottom = sr1 - 1\n    target_base_row = slot_interior_bottom - 1\n    dy = target_base_row - bar_base_row\n\n    # Determine bar projection columns (columns with any bar pixel above the base row).\n    col_min_row = {}\n    for r, c in bar_pts:\n        col_min_row[c] = min(col_min_row.get(c, r), r)\n    src_proj_cols = sorted([c for c, rmin in col_min_row.items() if rmin < bar_base_row])\n\n    # Determine destination columns from colored pixels in the original slot.\n    dst_cols_set = set()\n    for r, c in np.argwhere((g != bg) & (g != grey)):\n        r = int(r)\n        c = int(c)\n        if sr0 <= r <= sr1 and sc0 <= c <= sc1:\n            dst_cols_set.add(c)\n    dst_cols = sorted(dst_cols_set)\n\n    # Compute a robust horizontal shift aligning projection columns to colored columns.\n    dx = None\n    if src_proj_cols and len(src_proj_cols) == len(dst_cols):\n        deltas = [d - s for s, d in zip(src_proj_cols, dst_cols)]\n        if len(set(deltas)) == 1:\n            dx = deltas[0]\n    if dx is None:\n        # Brute pick dx that maximizes overlap of shifted projection cols with dst cols.\n        best = (-1, 0)\n        dst_set = set(dst_cols)\n        for cand_dx in range(-w, w + 1):\n            score = sum((c + cand_dx) in dst_set for c in src_proj_cols)\n            if score > best[0]:\n                best = (score, cand_dx)\n        dx = best[1]\n\n    # Paste bar into the slot (overwrite with grey).\n    placed = []\n    for r, c in bar_pts:\n        rr = r + dy\n        cc = c + dx\n        if sr0 <= rr <= sr1 and sc0 <= cc <= sc1:\n            out[rr, cc] = grey\n            placed.append((rr, cc))\n\n    # Move colored pixels: for each affected column, stack them immediately above the top of the bar in that column.\n    # Use colors from the original grid (inside slot bbox), ordered top->bottom.\n    placed_by_col = {}\n    for rr, cc in placed:\n        placed_by_col.setdefault(cc, []).append(rr)\n\n    interior_top = sr0 + 1\n    interior_bottom = sr1 - 1\n\n    for col in dst_cols:\n        if col not in placed_by_col:\n            continue\n        bar_top = min(placed_by_col[col])\n        desired_bottom = bar_top - 1\n        if desired_bottom < interior_top:\n            continue\n\n        # Extract original colored pixels in this column (ignore bg/grey).\n        rows = [r for r in range(sr0, sr1 + 1) if g[r, col] != bg and g[r, col] != grey]\n        if not rows:\n            continue\n        colors = [int(g[r, col]) for r in rows]  # top->bottom order by construction\n\n        max_len = desired_bottom - interior_top + 1\n        if max_len <= 0:\n            continue\n        if len(colors) > max_len:\n            colors = colors[-max_len:]\n\n        start_row = desired_bottom - len(colors) + 1\n        start_row = max(start_row, interior_top)\n\n        # Paint (overwrite) within the interior only.\n        for i, colv in enumerate(colors):\n            rr = start_row + i\n            if interior_top <= rr <= interior_bottom:\n                out[rr, col] = colv\n\n    return out\n\n# --------------- generator (attempt 3 (Codex)) ---------------\n\n# --- Palette ---\nBG = 0\nGREY = 5\nPALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)  # colors != bg and != grey\n\n# --- Canvas geometry (fixed per spec) ---\nH, W = 8, 20\n\n# --- Frame (right-hand slot) ---\nFRAME_R0, FRAME_C0 = 0, 9            # top-left of frame patch\nFRAME_H, FRAME_W = 8, 11             # frame patch dimensions\nLEFT_WALL_OPEN_ROWS = (4, 5)         # rows where the left wall of the frame is open\n\n# --- Slot columns inside the frame ---\nSLOT_COLS = [11, 13, 15, 17]         # absolute col indices\nSLOT_LENS = [3, 4, 4, 3]             # per-col length counted from row 1\nSLOT_TOP_ROW = 1                     # topmost interior row of slot columns\n\n# --- Bar geometry ---\nBAR_INPUT_C0 = 1                     # left column of bar in the input (pre-translation)\nBAR_OUTPUT_C0 = 11                   # left column of bar in the expected output (post-translation)\nBAR_R0 = 2                           # top row where bar patch is pasted\nBAR_H, BAR_W = 4, 7                  # bar patch dimensions (4 rows tall, base at local row 3)\nBAR_LOCAL_PROJ_COLS = [0, 2, 4, 6]   # bar projection columns within the patch\nBAR_BASE_ABS_ROW = BAR_R0 + BAR_H - 1  # row 5, absolute row of bar base after paste\n\n# --- Sampling parameters ---\nHEIGHT0_RANGE = (2, 5)               # rng.integers(low, high) -> {2,3,4} for first proj\nHEIGHT_REST_RANGE = (1, 5)           # rng.integers(low, high) -> {1,2,3,4} for other projs\nMAX_ATTEMPTS = 300\n\n\ndef _frame_patch() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
