{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/6e453dd6.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide black shapes rightward to a grey separator, then shoot red rays from enclosed holes.\n\n    Input structure:\n    - A vertical grey (5) separator column divides the grid into left and right halves.\n    - Black shapes sit on the left side against a background color (bg).\n\n    Rule:\n    - Translate each black connected component rightward until its right edge is flush with the separator.\n    - After sliding, find enclosed bg regions (holes) within the black shapes that touch the column just left of the separator.\n    - For each row spanned by such a hole, emit a red ray across the entire right half of the grid.\n\n    Key insight: Only holes adjacent to the separator trigger rays — the sliding creates enclosures that act as \"nozzles\" projecting rightward.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    sep_color = 5\n    black = 0\n    red = 2\n\n    sep = _find_separator_col(g, sep_color=sep_color)\n    bg = _background_color(g, sep_col=sep, sep_color=sep_color)\n\n    out = g.copy()\n\n    # Step 1: move black components on the left so that their right edge touches the separator.\n    left = out[:, :sep].copy()\n    left_mask = left == black\n    comps = _components4(left_mask)\n\n    # Clear old black pixels (leave other colors intact).\n    left[left == black] = bg\n\n    target_right = sep - 1  # last column in left side, adjacent to separator\n    for comp in comps:\n        max_c = max(c for _, c in comp)\n        delta = target_right - max_c\n        assert delta >= 0, \"left-side components must stay left of the separator\"\n        for r, c in comp:\n            nc = c + delta\n            assert 0 <= nc < sep, f\"shifted pixel {(r, c)} left the pane\"\n            left[r, nc] = black\n\n    out[:, :sep] = left\n\n    # Step 2: find enclosed background regions (holes) on the left.\n    # A hole is a bg component not touching the left subgrid boundary.\n    holes = []\n    for pts in _components4(left == bg):\n        if any(r == 0 or r == h - 1 or c == 0 or c == sep - 1 for r, c in pts):\n            continue\n        holes.append(pts)\n\n    # Step 3: if a hole touches column sep-2 (one cell left of the black border that touches separator),\n    # emit a red ray on the right side for each row containing hole pixels.\n    trigger_col = sep - 2\n    trigger_rows = []\n    for pts in holes:\n        if not any(c == trigger_col for _, c in pts):\n            continue\n        trigger_rows.extend(sorted(set(r for r, _ in pts)))\n    assert len(trigger_rows) == len(set(trigger_rows)), f\"trigger rows must be unique, got {trigger_rows}\"\n    for r in trigger_rows:\n        assert np.all(out[r, sep + 1 :] == bg), f\"right half of row {r} must be background before ray emission\"\n        out[r, sep + 1 :] = red\n\n    return out\n\n# --------------- generator (att4) ---------------\n\n# ── Colors ──\nBG = 6       # magenta background\nBLACK = 0    # sprite color\nRED = 2      # ray color\nSEP_COLOR = 5  # grey separator\n\n# ── Grid dimensions ──\nH_MIN, H_MAX = 16, 25\nW_MIN, W_MAX = 10, 16\nSEP_MIN, SEP_MAX = 5, 11       # separator column range\nRIGHT_W_MIN, RIGHT_W_MAX = 2, 4  # right-side width range\n\n# ── Sprite constraints ──\nN_SPRITES_MIN, N_SPRITES_MAX = 2, 5\nSPRITE_H_MAX = 8               # max sprite bbox height\nSPRITE_W_MAX = 6               # max sprite bbox width\nMIN_BAND_GAP = 1               # min bg rows between sprite bands\n\n# ── Probabilities ──\nSPLIT_PROB = 0.4                # emitter: probability of split (mini+main) layout\nEXTRA_EMITTERS_PROB = 0.25      # chance to add more emitters beyond the minimum\nFLUSH_PROB = 0.35               # chance one input sprite stays flush with separator\n\n# ── Retry budget ──\nMAX_RETRIES = 300\n\n\ndef _scatter(total, slots):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/e3f79277.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace a corner L with a same-color right-triangle outline in the corresponding corner of an enlarged canvas.\n\n    Input structure:\n    - The input is a square grid with one background color and one foreground color.\n    - The foreground is a one-pixel-thick L inside a square bbox.\n    - The L touches exactly one horizontal grid edge and one vertical grid edge, identifying a corner.\n\n    Rule:\n    - Fill a square output canvas of side 3n-2, where n is the input side length, with the background color.\n    - Double the L leg length to get the triangle side length.\n    - Draw the two perpendicular triangle legs on the same output corner edges and connect their free endpoints with the diagonal.\n\n    Key insight:\n    - The input L encodes the corner, color, and side length of the triangle outline; the missing side is the diagonal between the L's two free endpoints.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n    assert height == width, \"expected a square input grid\"\n\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1, \"expected exactly one foreground color\"\n    fg = fg_colors[0]\n\n    mask = g == fg\n    coords = np.argwhere(mask)\n    assert coords.size > 0, \"expected a foreground L\"\n    r0, c0 = map(int, coords.min(axis=0))\n    r1, c1 = map(int, coords.max(axis=0))\n    leg_len = r1 - r0 + 1\n    assert leg_len == c1 - c0 + 1, \"expected the L bbox to be square\"\n    assert leg_len > 1, \"expected a nontrivial L\"\n\n    touches_top = r0 == 0\n    touches_bottom = r1 == height - 1\n    touches_left = c0 == 0\n    touches_right = c1 == width - 1\n    assert sum((touches_top, touches_bottom)) == 1, \"expected the L to touch one horizontal grid edge\"\n    assert sum((touches_left, touches_right)) == 1, \"expected the L to touch one vertical grid edge\"\n\n    expected = np.zeros_like(mask, dtype=bool)\n    edge_row = r0 if touches_top else r1\n    edge_col = c0 if touches_left else c1\n    expected[edge_row, c0 : c1 + 1] = True\n    expected[r0 : r1 + 1, edge_col] = True\n    assert np.array_equal(mask, expected), \"expected foreground to be exactly a corner L\"\n\n    out_size = 3 * height - 2\n    side = 2 * leg_len\n    out = np.full((out_size, out_size), bg, dtype=int)\n    top = touches_top\n    left = touches_left\n    rr0 = 0 if top else out_size - side\n    cc0 = 0 if left else out_size - side\n    out_edge_row = rr0 if top else rr0 + side - 1\n    out_edge_col = cc0 if left else cc0 + side - 1\n\n    for i in range(side):\n        out[out_edge_row, cc0 + i] = fg\n        out[rr0 + i, out_edge_col] = fg\n        diag_col = side - 1 - i if top == left else i\n        out[rr0 + i, cc0 + diag_col] = fg\n\n    return out\n\n# --------------- generator (o5x) ---------------\nfrom arc_utils import bbox\n\n# Sampling bounds.\nGRID_SIZE_MIN = 4\nGRID_SIZE_MAX = 8\nLEG_LEN_MIN = 2\nCOLOR_VALUES = range(10)\nCOLOR_PAIR_SIZE = 2\nCORNER_ANCHORS = ((True, True), (True, False), (False, True), (False, False))\n\n# Output geometry and validation.\nOUTPUT_SCALE = 3\nOUTPUT_OFFSET = 2\nTRIANGLE_SIDE_SCALE = 2\nMAX_ATTEMPTS = 300\n\n\ndef _gen_expected_output(grid: np.ndarray) -> np.ndarray:\n","exit_code":0,"status":"completed"}}
