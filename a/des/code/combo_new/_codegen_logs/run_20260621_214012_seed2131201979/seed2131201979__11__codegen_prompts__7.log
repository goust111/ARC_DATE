\"\"\n/home/lixinyu/snap/new/ARC_code/eval/64efde09.py:311:    \"\"\"Choose and place 3 markers on boundary cells. Mutates *grid* in place.\n/home/lixinyu/snap/new/ARC_code/eval/64efde09.py:314:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/64efde09.py:394:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:9:    \"\"\"Positional-args helper (kept local; only used by this solver).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:15:    \"\"\"Positional-args helper (kept local; only used by this solver).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:25:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:26:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:41:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:217:        \"\"\"Transform coords, return (list, new_shape).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:416:    \"\"\"Find the pre-image of *patch* under *op* (brute-force over 8 ops).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:425:    \"\"\"Return ops whose inverse keeps patch within bbox size limits.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:453:    \"\"\"8-connected dilation via numpy shifts.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:467:    \"\"\"BFS from *body* to *goal*, adding the path into *body* (mutates).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:497:    \"\"\"Populate each region's 'dirs' mapping (stripe_color -> direction).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:523:    \"\"\"Build the background grid with edge/internal stripes and rectangular regions.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:617:    \"\"\"Choose 2-3 (color, direction) marker specs from region boundary dirs.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:630:    \"\"\"Pick a marker cell position at a random offset from the coupler bbox in *direction*.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:644:    \"\"\"Return the cell one step inward from *marker* (toward coupler center).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:652:    \"\"\"Ensure every coupler is 8-adjacent to the body via BFS paths.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:670:    \"\"\"Grow *body* toward *target* cells while respecting bbox limits.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:701:    \"\"\"Build a docked train patch: 8-body + 9-couplers + colored markers.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:765:    \"\"\"Find all valid (r, c) placements for *patch* within *region*.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:798:    \"\"\"Place N docked trains on the output grid; return (output, trains) or None.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:828:    \"\"\"Apply random transforms and scatter trains onto the input grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:899:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/d93c6891.py:83:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/d93c6891.py:84:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d93c6891.py:101:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d93c6891.py:178:    \"\"\"Try to place an orange rect flush against the given edge. Returns (or0,oc0,or1,oc1) or None.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d93c6891.py:302:    \"\"\"Sample gray bars and return oracle metadata for expected output.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d93c6891.py:397:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py:41:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py:42:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py:53:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py:113:    \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py:118:    \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py:123:    \"\"\"Sample row count and bar groups before physical layout.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py:152:    \"\"\"Sample gaps, heights, margins, and positioned bar columns.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py:220:    \"\"\"Render the sampled input grid and its expected transformed output.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py:236:    \"\"\"Return whether the solver accepts and matches the rendered output.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py:261:def generate_input():\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:8:    \"\"\"Local helper: build a boolean mask from bbox-relative component coordinates.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:20:    \"\"\"Canonicalize a boolean mask up to rotation and horizontal reflection.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:31:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:32:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:46:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:113:    \"\"\"Return all (h, w) bboxes where area fits with fill_ratio >= MIN_FILL_RATIO_X10/10.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:132:    \"\"\"Create a seed mask along a diagonal line spanning the bbox, randomly flipped.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:153:    \"\"\"Grow an 8-connected mask from a line seed to the target area.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:169:    \"\"\"Paint a boolean mask into a colored patch on a bg-filled array.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:176:    \"\"\"Generate a random 8-connected component with the given area and color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:189:    \"\"\"Apply a random rotation (0-3) and optional horizontal flip to a mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:197:    \"\"\"Create a duplicate of template's shape with a new color and random transform.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:206:    \"\"\"Distribute components horizontally with random spacing (min gap = MIN_COL_GAP).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:224:    \"\"\"Return a mask that is True wherever occupied or any 8-neighbor is occupied.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:238:    \"\"\"Check if mask placed at (r0, c0) overlaps any dilated-occupied cell.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:244:    \"\"\"Paint all components at their output positions.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:252:    \"\"\"Place components at random non-output rows without 8-neighbor overlap.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:284:    \"\"\"Create duplicate-shape (top) and unique-shape (bottom) component groups.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:321:    \"\"\"Single attempt: build output-first, derive input, validate with oracle.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:361:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/902510d5.py:57:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/902510d5.py:58:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/902510d5.py:80:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/902510d5.py:397:def generate_input():\n/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py:17:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py:18:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py:40:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py:259:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/99caa