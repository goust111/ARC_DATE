{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/7e576d6e.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import components_mask, get_bg\nimport random\n\n\ndef _color_counts(g: np.ndarray) -> dict[int, int]:\n    vals, counts = np.unique(g, return_counts=True)\n    return {int(v): int(n) for v, n in zip(vals, counts)}\n\n\ndef _roles(g: np.ndarray) -> tuple[int, int, int, int]:\n    bg = get_bg(g)\n    counts = _color_counts(g)\n    colors = [c for c in counts if c != bg]\n    assert len(colors) == 3, \"expected wall, door, and marker colors\"\n\n    marker_colors = [c for c in colors if counts[c] == 2]\n    assert len(marker_colors) == 1, \"expected exactly two marker pixels\"\n    path_color = marker_colors[0]\n\n    remaining = [c for c in colors if c != path_color]\n    areas = {c: counts[c] for c in remaining}\n    door_area = min(areas.values())\n    wall_area = max(areas.values())\n    door_colors = [c for c in remaining if counts[c] == door_area]\n    wall_colors = [c for c in remaining if counts[c] == wall_area]\n    assert len(door_colors) == 1 and len(wall_colors) == 1\n    assert door_area < wall_area, \"door color must be the smaller non-marker object set\"\n    return int(bg), int(path_color), int(door_colors[0]), int(wall_colors[0])\n\n\ndef _door_centers(g: np.ndarray, door_color: int) -> tuple[str, list[tuple[int, int]]]:\n    comps = components_mask(g == int(door_color), connectivity=4)\n    assert comps, \"expected door segments\"\n\n    orientations: list[str] = []\n    centers: list[tuple[int, int]] = []\n    for coords in comps:\n        assert coords.shape[0] == 3, \"each door segment is three pixels long\"\n        r0, c0 = coords.min(axis=0)\n        r1, c1 = coords.max(axis=0)\n        height = int(r1 - r0 + 1)\n        width = int(c1 - c0 + 1)\n        if height == 3 and width == 1:\n            orientations.append(\"vertical\")\n            centers.append((int(r0 + 1), int(c0)))\n        elif height == 1 and width == 3:\n            orientations.append(\"horizontal\")\n            centers.append((int(r0), int(c0 + 1)))\n        else:\n            raise AssertionError(\"door segments must be straight length-3 bars\")\n\n    assert len(set(orientations)) == 1, \"all doors must share an orientation\"\n    return orientations[0], centers\n\n\ndef _paint_segment(\n    out: np.ndarray,\n    start: tuple[int, int],\n    end: tuple[int, int],\n    color: int,\n    allowed: set[int],\n) -> None:\n    r0, c0 = map(int, start)\n    r1, c1 = map(int, end)\n    assert r0 == r1 or c0 == c1, \"path segments must be orthogonal\"\n    height, width = out.shape\n    assert 0 <= r0 < height and 0 <= r1 < height\n    assert 0 <= c0 < width and 0 <= c1 < width\n\n    if r0 == r1:\n        for c in range(min(c0, c1), max(c0, c1) + 1):\n            assert int(out[r0, c]) in allowed, \"path may only cover bg, doors, or markers\"\n            out[r0, c] = int(color)\n    else:\n        for r in range(min(r0, r1), max(r0, r1) + 1):\n            assert int(out[r, c0]) in allowed, \"path may only cover bg, doors, or markers\"\n            out[r, c0] = int(color)\n\n\ndef _markers(g: np.ndarray, path_color: int) -> list[tuple[int, int]]:\n    coords = np.argwhere(g == int(path_color))\n    assert coords.shape[0] == 2, \"expected two marker pixels\"\n    return [tuple(map(int, coord)) for coord in coords]\n\n\ndef _solve_vertical_walls(\n    g: np.ndarray,\n    centers: list[tuple[int, int]],\n    markers: list[tuple[int, int]],\n    bg: int,\n    path_color: int,\n    door_color: int,\n    wall_color: int,\n) -> np.ndarray:\n    out = g.copy()\n    centers = sorted(centers, key=lambda p: p[1])\n    wall_cols = sorted(set(map(int, np.argwhere(g == int(wall_color))[:, 1])))\n    assert len(wall_cols) == len(centers), \"each vertical wall must have one door\"\n    assert [c for _r, c in centers] == wall_cols\n    for _r, c in centers:\n        assert np.all(np.isin(g[:, c], [wall_color, door_color]))\n\n    start, end = sorted(markers, key=lambda p: p[1])\n    assert start[1] < centers[0][1] and end[1] > centers[-1][1]\n\n    allowed = {int(bg), int(path_color), int(door_color)}\n    cur = start\n    for door_r, door_c in centers:\n        approach = (cur[0], door_c - 1)\n        _paint_segment(out, cur, approach, path_color, allowed)\n        _paint_segment(out, approach, (door_r, door_c - 1), path_color, allowed)\n        _paint_segment(out, (door_r, door_c - 1), (door_r, door_c), path_color, allowed)\n        cur = (door_r, door_c)\n\n    _paint_segment(out, cur, (cur[0], end[1]), path_color, allowed)\n    _paint_segment(out, (cur[0], end[1]), end, path_color, allowed)\n    return out\n\n\ndef _solve_horizontal_walls(\n    g: np.ndarray,\n    centers: list[tuple[int, int]],\n    markers: list[tuple[int, int]],\n    bg: int,\n    path_color: int,\n    door_color: int,\n    wall_color: int,\n) -> np.ndarray:\n    out = g.copy()\n    centers = sorted(centers, key=lambda p: p[0])\n    wall_rows = sorted(set(map(int, np.argwhere(g == int(wall_color))[:, 0])))\n    assert len(wall_rows) == len(centers), \"each horizontal wall must have one door\"\n    assert [r for r, _c in centers] == wall_rows\n    for r, _c in centers:\n        assert np.all(np.isin(g[r, :], [wall_color, door_color]))\n\n    start, end = sorted(markers, key=lambda p: p[0])\n    assert start[0] < centers[0][0] and end[0] > centers[-1][0]\n\n    allowed = {int(bg), int(path_color), int(door_color)}\n    cur = start\n    for door_r, door_c in centers:\n        approach = (door_r - 1, cur[1])\n        _paint_segment(out, cur, approach, path_color, allowed)\n        _paint_segment(out, approach, (door_r - 1, door_c), path_color, allowed)\n        _paint_segment(out, (door_r - 1, door_c), (door_r, door_c), path_color, allowed)\n        cur = (door_r, door_c)\n\n    _paint_segment(out, cur, (end[0], cur[1]), path_color, allowed)\n    _paint_segment(out, (end[0], cur[1]), end, path_color, allowed)\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Draw the marker-colored route through the centers of all doors in the parallel wall maze.\n\n    Input structure:\n    - The grid has a background, parallel full-span walls, one three-pixel door\n      segment in each wall, and two marker pixels sharing a color.\n    - Walls are either all vertical or all horizontal, and the markers are on\n      opposite outer sides of the wall set.\n\n    Rule:\n    - Keep the scene unchanged except for the route.\n    - Visit the door centers in wall order from the upper/left marker side to\n      the lower/right marker side.\n    - In each corridor, draw an orthogonal path to the cell just before the next\n      wall, move along that wall to the door center, cross the center, and\n      continue to the next corridor; after the last door, connect to the other\n      marker.\n\n    Key insight:\n    - The three-pixel door segments mark the only crossing points through a set\n      of parallel walls, so the output is the corridor path threaded through\n      those centers.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg, path_color, door_color, wall_color = _roles(g)\n    orientation, centers = _door_centers(g, door_color)\n    markers = _markers(g, path_color)\n\n    if orientation == \"vertical\":\n        return _solve_vertical_walls(g, centers, markers, bg, path_color, door_color, wall_color)\n    assert orientation == \"horizontal\"\n    return _solve_horizontal_walls(g, centers, markers, bg, path_color, door_color, wall_color)\n\n# --------------- generator (att1) ---------------\n\n# Canvas and color role sampling.\nGRID_H = 30\nGRID_W = 30\nCOLOR_POOL = range(10)\nN_ROLE_COLORS = 4\n\n# Parallel wall and door geometry.\nORIENTATIONS = (\"vertical\", \"horizontal\")\nWALL_COUNT_RANGE = (3, 4)\nWALL_POS_LO = 4\nWALL_POS_HI_MARGIN = 5\nWALL_MIN_GAP = 2\nDOOR_CENTER_LO = 3\nDOOR_CENTER_HI_MARGIN = 4\n\n# Marker placement and retry budget.\nMARKER_EDGE_RANGE = (1, 3)\nMARKER_FREE_LO = 1\nMARKER_FREE_HI_MARGIN = 2\nGEN_RETRIES = 300\n\n\ndef _place_positions(n: int, lo: int, hi: int, min_gap: int, rng: random.Random) -> list[int] | None:\n    \"\"\"Place n positions in [lo..hi] with pairwise gap >= min_gap between consecutive sorted positions.\"\"\"\n    needed = n + (n - 1) * min_gap\n    span = hi - lo + 1\n    if span < needed:\n        return None\n    compressed_span = span - (n - 1) * min_gap\n    picks = sorted(rng.sample(range(compressed_span), n))\n    return [lo + picks[i] + i * min_gap for i in range(n)]\n\n\ndef _sample_wall_layout(orientation: str, n_walls: int, rng: random.Random):\n    \"\"\"Return wall positions and per-wall door centers for the chosen orientation.\"\"\"\n    wall_axis, door_axis = (GRID_W, GRID_H) if orientation == \"vertical\" else (GRID_H, GRID_W)\n    walls = _place_positions(\n        n_walls,\n        lo=WALL_POS_LO,\n        hi=wall_axis - WALL_POS_HI_MARGIN,\n        min_gap=WALL_MIN_GAP,\n        rng=rng,\n    )\n    if walls is None:\n        return None\n    doors = [rng.randint(DOOR_CENTER_LO, door_axis - DOOR_CENTER_HI_MARGIN) for _ in range(n_walls)]\n    return walls, doors\n\n\ndef _sample_markers(orientation: str, rng: random.Random) -> tuple[tuple[int, int], tuple[int, int]]:\n    \"\"\"Sample start/end markers on opposite outer corridors.\"\"\"\n    edge_lo, edge_hi = MARKER_EDGE_RANGE\n    if orientation == \"vertical\":\n        start_col = rng.randint(edge_lo, edge_hi)\n        start_row = rng.randint(MARKER_FREE_LO, GRID_H - MARKER_FREE_HI_MARGIN)\n        end_col = rng.randint(GRID_W - edge_hi - 1, GRID_W - edge_lo - 1)\n        end_row = rng.randint(MARKER_FREE_LO, GRID_H - MARKER_FREE_HI_MARGIN)\n    else:\n        start_row = rng.randint(edge_lo, edge_hi)\n        start_col = rng.randint(MARKER_FREE_LO, GRID_W - MARKER_FREE_HI_MARGIN)\n        end_row = rng.randint(GRID_H - edge_hi - 1, GRID_H - edge_lo - 1)\n        end_col = rng.randint(MARKER_FREE_LO, GRID_W - MARKER_FREE_HI_MARGIN)\n    return (start_row, start_col), (end_row, end_col)\n\n\ndef _render_grid(\n    orientation, bg, wall_color, door_color, marker_color, walls, doors, start, end\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/9f669b64.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/9f669b64.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, crop_bbox, find_components, get_bg, paste\nimport random\n\n\ndef _center(obj: dict, axis: int) -> float:\n    r0, c0, r1, c1 = obj[\"bbox\"]\n    return ((r0 + r1) / 2, (c0 + c1) / 2)[axis]\n\n\ndef _span(obj: dict, axis: int) -> int:\n    return bbox_h(obj[\"bbox\"]) if axis == 0 else bbox_w(obj[\"bbox\"])\n\n\ndef _is_solid_rectangle(g: np.ndarray, obj: dict) -> bool:\n    r0, c0, r1, c1 = obj[\"bbox\"]\n    color = int(obj[\"color\"])\n    return (\n        int(obj[\"area\"]) == (r1 - r0 + 1) * (c1 - c0 + 1)\n        and np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color)\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Push the central solid rectangle to the grid edge, splitting the perpendicular target rectangle around its path.\n\n    Input structure\n    - The background is the dominant color.\n    - There are exactly three monochrome foreground objects arranged on one\n      horizontal or vertical axis.\n    - The middle object on that axis is a solid rectangular moving object.\n    - One end object is a solid rectangle or bar whose long side is perpendicular\n      to the movement axis; this is the target to split.\n\n    Rule\n    - Move the middle rectangle along the axis toward the target until it is\n      flush with the grid edge in that direction.\n    - Clear the original middle rectangle and the original target.\n    - Split the target through the moving rectangle's two-cell-wide path and\n      shift the two halves one cell outward perpendicular to the movement.\n    - Keep the other end object unchanged.\n\n    Key insight\n    - The non-target end object acts as a pusher; the central rectangle travels\n      away from it through the perpendicular target, opening a matching gap.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(objects) == 3, \"expected exactly three foreground objects\"\n\n    row_centers = [_center(obj, 0) for obj in objects]\n    col_centers = [_center(obj, 1) for obj in objects]\n    row_spread = max(row_centers) - min(row_centers)\n    col_spread = max(col_centers) - min(col_centers)\n    assert min(row_spread, col_spread) <= 0.5, \"objects must share a row or column axis\"\n    axis = 0 if col_spread <= 0.5 else 1\n    perp = 1 - axis\n\n    ordered = sorted(objects, key=lambda obj: _center(obj, axis))\n    axis_centers = [_center(obj, axis) for obj in ordered]\n    assert axis_centers[0] < axis_centers[1] < axis_centers[2], \"expected a unique middle object\"\n\n    source = ordered[1]\n    end_objects = [ordered[0], ordered[2]]\n    assert _is_solid_rectangle(g, source), \"moving object must be a solid rectangle\"\n\n    target_candidates = [\n        obj\n        for obj in end_objects\n        if _is_solid_rectangle(g, obj) and _span(obj, perp) > _span(obj, axis)\n    ]\n    assert len(target_candidates) == 1, \"expected one perpendicular solid target\"\n    target = target_candidates[0]\n\n    direction = -1 if _center(target, axis) < _center(source, axis) else 1\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    tr0, tc0, tr1, tc1 = target[\"bbox\"]\n    source_lo = [sr0, sc0]\n    source_hi = [sr1, sc1]\n    target_lo = [tr0, tc0]\n    target_hi = [tr1, tc1]\n\n    source_perp_len = source_hi[perp] - source_lo[perp] + 1\n    assert source_perp_len == 2, \"moving object path must be two cells wide\"\n    assert target_lo[perp] <= source_lo[perp] <= source_hi[perp] <= target_hi[perp]\n    assert (\n        source_lo[perp] - target_lo[perp] == target_hi[perp] - source_hi[perp]\n    ), \"moving object must be centered across the target\"\n\n    out = g.copy()\n    for r, c in source[\"coords\"]:\n        out[int(r), int(c)] = bg\n    for r, c in target[\"coords\"]:\n        out[int(r), int(c)] = bg\n\n    shift = source_perp_len // 2\n    for r, c in target[\"coords\"]:\n        new_rc = [int(r), int(c)]\n        if new_rc[perp] <= source_lo[perp]:\n            new_rc[perp] -= shift\n        else:\n            assert new_rc[perp] >= source_hi[perp]\n            new_rc[perp] += shift\n        assert 0 <= new_rc[0] < H and 0 <= new_rc[1] < W, \"shifted target must stay in bounds\"\n        out[new_rc[0], new_rc[1]] = int(target[\"color\"])\n\n    source_patch = crop_bbox(g, source[\"bbox\"])\n    if axis == 0:\n        new_r = 0 if direction < 0 else H - source_patch.shape[0]\n        new_c = source_lo[1]\n    else:\n        new_r = source_lo[0]\n        new_c = 0 if direction < 0 else W - source_patch.shape[1]\n    dest = out[new_r : new_r + source_patch.shape[0], new_c : new_c + source_patch.shape[1]]\n    assert np.all(dest == bg), \"moving object destination must be clear\"\n    paste(out, source_patch, new_r, new_c)\n    return out\n\n# --------------- generator (att2) ---------------\n\nGEN_GRID_SIZE = 10\nGEN_BG = 7\nGEN_FG_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nGEN_SOURCE_PERP = 2\nGEN_SOURCE_ALONG_CHOICES = [2, 3]\nGEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX = 1, 4\nGEN_TARGET_OVERHANG_CHOICES = (1, 2)\nGEN_SOURCE_TARGET_GAP_RANGE = range(5)\nGEN_OTHER_WIDTH_CHOICES = (2, 4, 6)\nGEN_OTHER_MIN_STAIR_WIDTH = 4\nGEN_OTHER_MIN_STAIR_HEIGHT = 2\nGEN_ORIENTATION_COUNT, GEN_RETRY_LIMIT = 4, 300\n\n\ndef _gen_transform(grid: np.ndarray, orientation: int) -> np.ndarray:\n    if orientation == 0:\n        return grid.copy()\n    if orientation == 1:\n        return np.flipud(grid).copy()\n    if orientation == 2:\n        return np.rot90(grid, 1).copy()\n    return np.rot90(grid, -1).copy()\n\n\ndef _gen_even_centered_start(center_left: int, width: int) -> int:\n    return center_left - (width // 2 - 1)\n\n\ndef _gen_stair_patch(h: int, w: int, color: int, bg: int) -> np.ndarray:\n    patch = np.full((h, w), bg, dtype=int)\n    max_extra = w // 2 - 1\n    thresholds = sorted(random.randint(1, h - 1) for _ in range(max_extra))\n    for r in range(h):\n        extra = sum(r >= threshold for threshold in thresholds)\n        c0 = w // 2 - 1 - extra\n        c1 = w // 2 + extra\n        patch[r, c0 : c1 + 1] = color\n    return patch\n\n\ndef _gen_place_other(grid: np.ndarray, r0: int, center_left: int, color: int, bg: int) -> None:\n    h = grid.shape[0] - r0\n    in_bounds_widths = [\n        w\n        for w in GEN_OTHER_WIDTH_CHOICES\n        if 0 <= _gen_even_centered_start(center_left, w)\n        and _gen_even_centered_start(center_left, w) + w <= grid.shape[1]\n    ]\n    solid_widths = [w for w in in_bounds_widths if w <= h]\n    stair_widths = [w for w in in_bounds_widths if w >= GEN_OTHER_MIN_STAIR_WIDTH and h >= GEN_OTHER_MIN_STAIR_HEIGHT]\n\n    kinds = []\n    if solid_widths:\n        kinds.append(\"solid\")\n    if stair_widths:\n        kinds.append(\"stair\")\n    kind = random.choice(kinds)\n\n    if kind == \"solid\":\n        w = random.choice(solid_widths)\n        patch = np.full((h, w), color, dtype=int)\n    else:\n        w = random.choice(stair_widths)\n        patch = _gen_stair_patch(h, w, color, bg)\n    paste(grid, patch, r0, _gen_even_centered_start(center_left, w), transparent=bg)\n\n\ndef _gen_choose_layout() -> tuple[int, int, int, int, int, int] | None:\n    s_h = random.choice(GEN_SOURCE_ALONG_CHOICES)\n    t_h = random.randint(GEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX)\n    overhangs = [k for k in GEN_TARGET_OVERHANG_CHOICES if 2 * k + GEN_SOURCE_PERP > t_h]\n    k = random.choice(overhangs)\n    gap_options = [g for g in GEN_SOURCE_TARGET_GAP_RANGE if t_h + g + s_h <= GEN_GRID_SIZE - GEN_SOURCE_PERP]\n    if not gap_options:\n        return None\n    gap = random.choice(gap_options)\n    t0_max = GEN_GRID_SIZE - GEN_SOURCE_PERP - t_h - gap - s_h\n    t0 = random.randint(0, t0_max)\n    center_left = random.randint(k + 1, GEN_GRID_SIZE - k - 3)\n    return s_h, t_h, k, gap, t0, center_left\n\n\ndef _gen_canonical_pair(s_h: int, t_h: int, k: int, gap: int, t0: int, center_left: int, colors: list[int]) -> tuple[np.ndarray, np.ndarray]:\n    source_color, target_color, other_color = colors\n    source_patch = np.full((s_h, GEN_SOURCE_PERP), source_color, dtype=int)\n    target_patch = np.full((t_h, 2 * k + GEN_SOURCE_PERP), target_color, dtype=int)\n    split_half = np.full((t_h, k + 1), target_color, dtype=int)\n\n    out = np.full((GEN_GRID_SIZE, GEN_GRID_SIZE), GEN_BG, dtype=int)\n    paste(out, source_patch, 0, center_left)\n    paste(out, split_half, t0, center_left - k - 1)\n    paste(out, split_half, t0, center_left + GEN_SOURCE_PERP)\n\n    source_in_r = t0 + t_h + gap\n    other_r = source_in_r + s_h\n    _gen_place_other(out, other_r, center_left, other_color, GEN_BG)\n\n    inp = out.copy()\n    inp[0:s_h, center_left : center_left + GEN_SOURCE_PERP] = GEN_BG\n    inp[t0 : t0 + t_h, center_left - k - 1 : center_left] = GEN_BG\n    inp[t0 : t0 + t_h, center_left + GEN_SOURCE_PERP : center_left + k + 3] = GEN_BG\n    paste(inp, target_patch, t0, center_left - k)\n    paste(inp, source_patch, source_in_r, center_left)\n    return inp, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    colors = random.sample(GEN_FG_COLORS, 3)\n    layout = _gen_choose_layout()\n    if layout is None:\n        return None\n    inp, out = _gen_canonical_pair(*layout, colors)\n\n    orientation = random.randrange(GEN_ORIENTATION_COUNT)\n    inp = _gen_transform(inp, orientation)\n    out = _gen_transform(out, orientation)\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except AssertionError:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 9f669b64 input\")\n","exit_code":0,"status":"completed"}}
