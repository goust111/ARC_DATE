{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/9f5f939b.py | sed '\"'$d'\"'; printf '\\\\n###GEN###\\\\n'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/9f5f939b.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Mark the missing center of each plus-shaped arrangement of four two-pixel bars with yellow.\n\n    Input structure:\n    - The background is the dominant color.\n    - The single foreground color forms isolated 4-connected objects, each a horizontal or vertical two-pixel bar.\n    - Some bars form an implied plus sign: two horizontal bars and two vertical bars around an empty center, with a one-pixel gap between the center and each bar.\n\n    Rule:\n    - Keep the input unchanged except at implied plus-sign centers.\n    - For every background pixel with foreground bars at offsets 2-3 cells left, right, above, and below, recolor that center yellow.\n    - The one-pixel gaps immediately next to the center in the four cardinal directions must remain background.\n\n    Key insight:\n    - The yellow pixels are not extending a line; they identify the shared missing center where four separated two-pixel bars align as a plus sign.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = g.shape\n    assert height >= 7 and width >= 7, \"grid must be large enough for the plus motif\"\n\n    bg = get_bg(g)\n    foreground = colors_present(g, exclude={bg})\n    assert len(foreground) == 1, \"expected exactly one foreground color\"\n    fg = int(foreground[0])\n    assert bg != Color.YELLOW and fg != Color.YELLOW, \"yellow is reserved for output markers\"\n    _assert_two_cell_bars(g, bg, fg)\n\n    centers = [\n        (r, c)\n        for r in range(3, height - 3)\n        for c in range(3, width - 3)\n        if _is_cross_center(g, r, c, bg, fg)\n    ]\n    assert centers, \"expected at least one missing plus center\"\n\n    out = g.copy()\n    for r, c in centers:\n        out[r, c] = Color.YELLOW\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and color bounds.\nGRID_SIZE_MIN = 8\nGRID_SIZE_MAX_EXCLUSIVE = 21\nBACKGROUND_COLOR = 8\nFOREGROUND_COLOR = 1\n\n# Plus motif placement.\nPLUS_COUNT_MIN = 1\nPLUS_COUNT_MAX_EXCLUSIVE = 5\nCENTER_MARGIN = 3\nCENTER_TRIES = 100\n\n# Distractor bar placement.\nDISTRACTOR_RATIO_MIN = 0.2\nDISTRACTOR_RATIO_MAX = 0.6\nDISTRACTOR_RETRY_MULTIPLIER = 20\nNEW_PLUS_SCAN_RADIUS = 3\n\n# Overall generation retries.\nGENERATION_ATTEMPTS = 300\nNEIGHBOR_OFFSETS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\n\n###GEN###\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/48634b99.py | sed '\"'$d'\"'; printf '\\\\n###GEN###\\\\n'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/48634b99.py | sed '\"'$d'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/48634b99.py | sed '\"'$d'\"'; printf '\\\\n###GEN###\\\\n'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/48634b99.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Advance the marker from one half of a vertical bar to the same half of the next longer bar.\n\n    Input structure\n    - The grid has one dominant background color and exactly two foreground colors.\n    - One foreground color forms many vertical one-cell-wide bars; the other appears as a single vertical marker segment.\n    - The marker segment occupies exactly the top or bottom half of its containing vertical bar.\n    Rule\n    - Recolor the current marker segment back to the bar color.\n    - Find the unique all-bar-color vertical bar whose height is two pixels greater than the marked source bar.\n    - Recolor the same half of that next longer bar to the marker color.\n    Key insight\n    - Each bar's total height encodes an ordered size, and the marker advances from a 2k bar to the corresponding 2(k+1) bar while preserving whether it marks the top or bottom half.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = int(get_bg(g))\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, f\"expected exactly two foreground colors, got {colors}\"\n\n    mono_component_counts = {\n        int(color): len(\n            find_components(\n                g,\n                bg=bg,\n                colors=[int(color)],\n                connectivity=4,\n                monochromatic=True,\n            )\n        )\n        for color in colors\n    }\n    marker_colors = [color for color, count in mono_component_counts.items() if count == 1]\n    assert len(marker_colors) == 1, f\"expected one single-component marker color, got {mono_component_counts}\"\n    marker_color = int(marker_colors[0])\n\n    bar_colors = [int(color) for color in colors if int(color) != marker_color]\n    assert len(bar_colors) == 1\n    bar_color = int(bar_colors[0])\n\n    marker_components = find_components(\n        g,\n        bg=bg,\n        colors=[marker_color],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert len(marker_components) == 1\n    marker = marker_components[0]\n    marker_area = int(marker[\"area\"])\n    mr0, mc0, mr1, _mc1 = marker[\"bbox\"]\n    assert _is_solid_vertical_bar(marker)\n\n    bars = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    source_bars = [\n        bar\n        for bar in bars\n        if np.any(g[bar[\"coords\"][:, 0], bar[\"coords\"][:, 1]] == marker_color)\n    ]\n    assert len(source_bars) == 1, f\"expected one bar containing the marker, got {len(source_bars)}\"\n    source = source_bars[0]\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    source_h = bbox_h(source[\"bbox\"])\n    assert _is_solid_vertical_bar(source)\n    assert source_h == 2 * marker_area\n    assert mc0 == sc0 == sc1\n\n    if mr0 == sr0 and mr1 == sr0 + marker_area - 1:\n        marked_end = \"top\"\n    elif mr1 == sr1 and mr0 == sr1 - marker_area + 1:\n        marked_end = \"bottom\"\n    else:\n        raise AssertionError(f\"marker is not exactly one end-half: marker={marker['bbox']} source={source['bbox']}\")\n\n    target_h = source_h + 2\n    target_bars = []\n    for bar in bars:\n        values = g[bar[\"coords\"][:, 0], bar[\"coords\"][:, 1]]\n        if set(map(int, values)) != {bar_color}:\n            continue\n        if not _is_solid_vertical_bar(bar):\n            continue\n        if bbox_h(bar[\"bbox\"]) == target_h:\n            target_bars.append(bar)\n\n    assert len(target_bars) == 1, f\"expected one next-longer target bar, got {[bar['bbox'] for bar in target_bars]}\"\n    target = target_bars[0]\n    tr0, tc0, tr1, _tc1 = target[\"bbox\"]\n    target_half = target_h // 2\n\n    out = g.copy()\n    out[g == marker_color] = bar_color\n    if marked_end == \"top\":\n        out[tr0 : tr0 + target_half, tc0] = marker_color\n    else:\n        out[tr1 - target_half + 1 : tr1 + 1, tc0] = marker_color\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Fixed palette observed in all examples.\nBG = 7\nBAR_COLOR = 8\nMARKER_COLOR = 9\n# Grid geometry and vertical bar vocabulary.\nGRID_SHAPE = (16, 16)\nPROGRESSION_HEIGHTS = (2, 4, 6, 8, 10)\nSOURCE_HEIGHTS = PROGRESSION_HEIGHTS[:-1]\nDISTRACTOR_HEIGHT = 2\nHEIGHT_STEP = 2\n# Placement constraints and structural sampling.\nPLACEMENT_PADDING = 1\nPLACEMENT_CONNECTIVITY = 4\nDISTRACTOR_COUNT_RANGE = (5, 11)\nMARKED_HALVES = (\"top\", \"bottom\")\n# Rejection-sampling retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\n\n###GEN###\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/42f83767.py | sed '\"'$d'\"'; printf '\\\\n###GEN###\\\\n'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/42f83767.py | sed '\"'$d'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/42f83767.py | sed '\"'$d'\"'; printf '\\\\n###GEN###\\\\n'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/42f83767.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Expand the lower color grid by replacing each pixel with its matching top stencil.\n\n    Input structure\n    The input has a top legend and a lower dense color grid, separated by blank rows.\n    The legend contains left-to-right 2x2 color swatches and, to their right,\n    the same number of square neutral-color stencil masks.\n\n    Rule\n    Pair the swatches and stencil masks by left-to-right order. For every pixel in\n    the lower color grid, paste the paired stencil mask as one output block,\n    recoloring the mask pixels with that pixel's color and leaving mask holes as bg.\n\n    Key insight\n    The lower grid is not copied directly; it is an index grid whose colors select\n    the stencil shape from the legend, so each input pixel becomes one square block.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    row_runs = _runs(np.any(g != bg, axis=1))\n    assert len(row_runs) == 2\n    (top_r0, top_r1), (pattern_r0, pattern_r1) = row_runs\n    assert top_r0 == 0\n\n    stencil_size = top_r1 - top_r0 + 1\n    top = g[top_r0 : top_r1 + 1, :]\n    lower = g[pattern_r0 : pattern_r1 + 1, :]\n\n    pattern_box = bbox(lower != bg)\n    assert pattern_box is not None\n    pr0, pc0, pr1, pc1 = pattern_box\n    assert pr0 == 0 and pr1 == lower.shape[0] - 1\n    pattern = lower[:, pc0 : pc1 + 1]\n    assert np.all(pattern != bg)\n    pattern_colors = set(map(int, np.unique(pattern)))\n\n    top_colors = set(map(int, np.unique(top))) - {bg}\n    neutral_colors = top_colors - pattern_colors\n    assert len(neutral_colors) == 1\n    neutral = next(iter(neutral_colors))\n\n    swatches = []\n    for comp in find_components(top, bg=bg, colors=pattern_colors):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert comp[\"area\"] == 4\n        assert r1 - r0 + 1 == 2\n        assert c1 - c0 + 1 == 2\n        swatches.append((c0, int(comp[\"color\"])))\n    assert len(swatches) == len(pattern_colors)\n    assert len({c0 for c0, _color in swatches}) == len(swatches)\n\n    swatch_colors = [color for _c0, color in sorted(swatches)]\n    assert set(swatch_colors) == pattern_colors\n\n    stencil_col_runs = _runs(np.any(top == neutral, axis=0))\n    assert len(stencil_col_runs) == len(swatch_colors)\n\n    stencils = {}\n    for color, (c0, c1) in zip(swatch_colors, stencil_col_runs):\n        assert c1 - c0 + 1 == stencil_size\n        mask = top[:, c0 : c1 + 1] == neutral\n        assert mask.shape == (stencil_size, stencil_size)\n        assert np.any(mask)\n        stencils[color] = mask\n\n    h, w = pattern.shape\n    out = np.full((h * stencil_size, w * stencil_size), bg, dtype=int)\n    for r in range(h):\n        for c in range(w):\n            color = int(pattern[r, c])\n            assert color in stencils\n            block = out[\n                r * stencil_size : (r + 1) * stencil_size,\n                c * stencil_size : (c + 1) * stencil_size,\n            ]\n            block[stencils[color]] = color\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and legend geometry.\nBACKGROUND, NEUTRAL_COLOR, INPUT_ROWS = 0, 5, 15\nSWATCH_SIZE, SWATCH_STRIDE, STENCIL_GAP = 2, 3, 1\n\n# Structural size and palette bounds.\nCOLOR_COUNT_RANGE = (2, 4)\nSTENCIL_SIZE_RANGE, PATTERN_SIDE_RANGE = range(3, 7), range(4, 8)\nMAX_OUTPUT_SIDE, AVAILABLE_COLORS = 30, [1, 2, 3, 4, 6, 7, 8, 9]\nVALID_SIZE_PAIRS = [(s, p) for s in STENCIL_SIZE_RANGE for p in PATTERN_SIDE_RANGE if s * p <= MAX_OUTPUT_SIDE]\n\n# Stencil, pattern, and retry sampling.\nSTENCIL_FILL_RANGE = (0.60, 0.89)\nUNIQUE_STENCIL_RETRIES, GENERATION_RETRIES = 80, 300\nGAP_ROWS_RANGE = (1, 3)\nPATTERN_MODES = [\"iid\", \"rows\", \"cols\", \"checker\", \"tile\"]\nTILE_SIDE_RANGE = (2, 3)\n\n\n\n###GEN###\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n","exit_code":0,"status":"completed"}}
