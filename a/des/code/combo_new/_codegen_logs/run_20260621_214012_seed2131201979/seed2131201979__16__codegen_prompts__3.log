{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nfrom collections import Counter\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed2131201979/16/3.py')\nmod = SourceFileLoader('new_arc_task_stats', str(p)).load_module()\ncounts = Counter()\nfor _ in range(200):\n    inp = mod.generate_input()\n    bg, path, signals = mod._infer_bg_and_path(inp)\n    path_mask = inp == path\n    dirs = []\n    for r, c in np.argwhere(path_mask):\n        turn = mod._active_turn(inp, path_mask, signals, int(r), int(c))\n        if turn is None:\n            continue\n        neigh = mod._path_neighbors(path_mask, int(r), int(c))[0]\n        heading = (int(r) - neigh[0], int(c) - neigh[1])\n        if turn == mod._rotate_left(heading):\n            counts['left'] += 1\n        elif turn == mod._rotate_right(heading):\n            counts['right'] += 1\n        if heading[0] == 0:\n            counts['horizontal_heading'] += 1\n        else:\n            counts['vertical_heading'] += 1\n    counts[f'shape_{inp.shape[0]}x{inp.shape[1]}'] += 1\nprint(counts['left'], counts['right'], counts['horizontal_heading'], counts['vertical_heading'])\nprint('distinct_shapes', sum(1 for k in counts if k.startswith('shape_')))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
