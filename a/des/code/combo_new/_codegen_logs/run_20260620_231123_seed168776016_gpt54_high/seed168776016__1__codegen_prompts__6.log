ow color script to visit matching guide rails and draw the routed polyline.\n  57: \n  58:     Input structure:\n  59:     - The background is black.\n  60:     - The bottom row contains a one-pixel-tall instruction strip: its non-black pixels,\n  61:       read left to right, are the rail colors to visit in order.\n  62:     - Above the strip are several single-color straight rails, each one cell thick and\n  63:       either horizontal or vertical, plus one unique red start pixel.\n  64: \n  65:     Rule:\n  66:     - Read the instruction colors from the bottom row from left to right.\n  67:     - For each color, find the rail with that color. If the rail is horizontal, the brush\n  68:       moves horizontally from its current point until it reaches the near endpoint of that\n  69:       rail; if the rail is vertical, it moves vertically in the same way. The traversed gap\n  70:       cells are painted green.\n  71:     - After reaching the rail, continue along that rail to its opposite endpoint. Rail cells\n  72:       keep their rail color, and the brush stops on the far endpoint.\n  73:     - After all instructions are processed, erase the entire instruction strip to black.\n  74: \n  75:     Key insight:\n  76:     - The bottom row gives the visit order, while each visited rail's orientation determines\n  77:       whether the next path segment is horizontal or vertical.\n  78:     \"\"\"\n  79:     g = np.asarray(grid, dtype=int)\n  80:     assert g.ndim == 2 and g.shape[0] >= 2\n  81: \n  82:     commands = [int(v) for v in g[-1] if int(v) != BG]\n  83:     start_pts = np.argwhere(g[:-1] == START_COLOR)\n  84:     assert len(start_pts) == 1\n  85:     current = (int(start_pts[0, 0]), int(start_pts[0, 1]))\n  86:     rails = _extract_rails(g)\n  87: \n  88:     out = g.copy()\n  89:     out[-1, :] = BG\n  90: \n  91:     for color in commands:\n  92:         rail = rails[color]\n  93:         if rail[\"orientation\"] == \"h\":\n  94:             row = rail[\"row\"]\n  95:             assert current[0] == row\n  96:             if current[1] < rail[\"c0\"]:\n  97:                 for c in range(current[1] + 1, rail[\"c0\"]):\n  98:                     out[row, c] = PATH_COLOR\n  99:                 current = (row, rail[\"c1\"])\n 100:             else:\n 101:                 assert current[1] > rail[\"c1\"]\n 102:                 for c in range(rail[\"c1\"] + 1, current[1]):\n 103:                     out[row, c] = PATH_COLOR\n 104:                 current = (row, rail[\"c0\"])\n 105:         else:\n 106:             col = rail[\"col\"]\n 107:             assert current[1] == col\n 108:             if current[0] < rail[\"r0\"]:\n 109:                 for r in range(current[0] + 1, rail[\"r0\"]):\n 110:                     out[r, col] = PATH_COLOR\n 111:                 current = (rail[\"r1\"], col)\n 112:             else:\n 113:                 assert current[0] > rail[\"r1\"]\n 114:                 for r in range(rail[\"r1\"] + 1, current[0]):\n 115:                     out[r, col] = PATH_COLOR\n 116:                 current = (rail[\"r0\"], col)\n 117: \n 118:     return out\n 119: \n 120: \n 121: def _build_chain(rng: random.Random) -> Tuple[Tuple[int, int], list]:\n 122:     num_rails = rng.randint(*NUM_RAILS_RANGE)\n 123:     start = (\n 124:         rng.randint(START_MARGIN, WORK_H - START_MARGIN - 1),\n 125:         rng.randint(START_MARGIN, WORK_W - START_MARGIN - 1),\n 126:     )\n 127:     current = start\n 128:     used = {start}\n 129:     segments = []\n 130: \n 131:     for _ in range(num_rails):\n 132:         candidates = []\n 133:         dirs = [(0, 1, \"h\"), (0, -1, \"h\"), (1, 0, \"v\"), (-1, 0, \"v\")]\n 134:         rng.shuffle(dirs)\nENDSNIP\n 214:     cmd_start = rng.randint(0, final.shape[1] - len(colors))\n 215:     final[-1, cmd_start : cmd_start + len(colors)] = np.array(colors, dtype=int)\n 216:     return final\n 217: \n 218: \n 219: def generate_input() -> np.ndarray:\n 220:     rng = ra