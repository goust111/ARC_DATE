{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/46c35fc7.py',\n'/home/lixinyu/snap/new/ARC_code/eval/21897d95.py',\n'/home/lixinyu/snap/new/ARC_code/train/84551f4c.py',\n'/home/lixinyu/snap/new/ARC_code/eval/291dc1e1.py',\n]\nfor path in files:\n    text = Path(path).read_text()\n    lines = text.splitlines()\n    starts = []\n    for i,l in enumerate(lines):\n        if l.startswith('def main') or l.startswith('def generate_input'):\n            starts.append(i)\n    starts.append(len(lines))\n    print(f'===== {path} =====')\n    for a,b in zip(starts, starts[1:]):\n        name = lines[a].split('(')[0].strip()\n        print(f'--- {name} ---')\n        for line in lines[a:b]:\n            print(line)\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/train/46c35fc7.py =====\n--- def main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate the colors around every 3x3 foreground ring, with corners and side-centers cycling in opposite directions.\n\n    Input structure\n    - The grid has a dominant background color.\n    - Each 4-connected foreground object is a complete 3x3 ring: eight foreground pixels around a background center.\n\n    Rule\n    - For each ring, move corner colors one step around the four corners.\n    - Move side-center colors one step around the four side centers in the opposite direction.\n    - Leave the background center and all other background pixels unchanged.\n\n    Key insight\n    - Corners and side centers form two separate four-cycles on the same 3x3 ring.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    out = g.copy()\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert components\n\n    for comp in components:\n        bbox = comp[\"bbox\"]\n        r0, c0, r1, c1 = map(int, bbox)\n        assert bbox_h(bbox) == 3\n        assert bbox_w(bbox) == 3\n        assert int(comp[\"area\"]) == 8\n        assert g[r0 + 1, c0 + 1] == bg\n\n        ring_coords = {\n            (r0 + dr, c0 + dc)\n            for dr in range(3)\n            for dc in range(3)\n            if (dr, dc) != (1, 1)\n        }\n        component_coords = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n        assert component_coords == ring_coords\n        assert r1 == r0 + 2\n        assert c1 == c0 + 2\n\n        _rotate_ring(out, g, r0, c0)\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color and canvas bounds.\nBG_COLOR = 7\nCOLOR_IDS = tuple(range(10))\nGRID_SIDE_MIN, GRID_SIDE_MAX = 6, 10\nMIN_BACKGROUND_PCT = 67\n\n# Ring geometry, counts, and placement spacing.\nRING_SIZE, RING_AREA, RING_GAP = 3, 8, 1\nRING_COUNT_MIN, RING_COUNT_MAX = 1, 2\nRING_UNIQUE_MIN, RING_UNIQUE_MAX = 2, RING_AREA\nRING_CELLS = (\n    (0, 0),\n    (0, 1),\n    (0, 2),\n    (1, 0),\n    (1, 2),\n    (2, 0),\n    (2, 1),\n    (2, 2),\n)\n\n# Retry budget for rejection through the solver oracle.\nGENERATION_RETRIES = 300\n\n\ndef _bbox_at(r: int, c: int) -> tuple[int, int, int, int]:\n    return r, c, r + RING_SIZE - 1, c + RING_SIZE - 1\n\n\ndef _separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n    return (\n        a[2] + RING_GAP < b[0]\n        or b[2] + RING_GAP < a[0]\n        or a[3] + RING_GAP < b[1]\n        or b[3] + RING_GAP < a[1]\n    )\n\n\ndef _valid_position_sets(rows: int, cols: int, count: int) -> list[tuple[tuple[int, int], ...]]:\n    positions = [(r, c) for r in range(rows - RING_SIZE + 1) for c in range(cols - RING_SIZE + 1)]\n    if count == 1:\n        return [(pos,) for pos in positions]\n\n    pairs = []\n    for i, first in enumerate(positions):\n        box1 = _bbox_at(*first)\n        for second in positions[i + 1 :]:\n            if _separated(box1, _bbox_at(*second)):\n                pairs.append((first, second))\n    return pairs\n\n\ndef _compatible_sizes(count: int) -> list[tuple[int, int]]:\n    sizes = []\n    for rows in range(GRID_SIDE_MIN, GRID_SIDE_MAX + 1):\n        for cols in range(GRID_SIDE_MIN, GRID_SIDE_MAX + 1):\n            area = rows * cols\n            if (area - RING_AREA * count) * 100 < MIN_BACKGROUND_PCT * area:\n                continue\n            if _valid_position_sets(rows, cols, count):\n                sizes.append((rows, cols))\n    return sizes\n\n\n_SIZES = {count: _compatible_sizes(count) for count in range(RING_COUNT_MIN, RING_COUNT_MAX + 1)}\n_POSITION_SETS = {\n    count: {size: _valid_position_sets(*size, count) for size in _SIZES[count]}\n    for count in _SIZES\n}\n\n\ndef _make_ring(bg: int) -> np.ndarray:\n    ring = np.full((RING_SIZE, RING_SIZE), bg, dtype=int)\n    palette = [color for color in COLOR_IDS if color != bg]\n    unique_count = random.randint(RING_UNIQUE_MIN, RING_UNIQUE_MAX)\n    chosen = random.sample(palette, unique_count)\n    values = chosen + [random.choice(chosen) for _ in range(RING_AREA - unique_count)]\n    random.shuffle(values)\n    for (dr, dc), color in zip(RING_CELLS, values):\n        ring[dr, dc] = color\n    return ring\n\n\ndef _rotated_output(grid: np.ndarray, positions: tuple[tuple[int, int], ...]) -> np.ndarray:\n    out = grid.copy()\n    for r0, c0 in positions:\n        _rotate_ring(out, grid, r0, c0)\n    return out\n\n\ndef _render_grid(rows: int, cols: int, positions: tuple[tuple[int, int], ...], bg: int) -> np.ndarray:\n    grid = np.full((rows, cols), bg, dtype=int)\n    for r0, c0 in positions:\n        paste(grid, _make_ring(bg), r0, c0)\n    return grid\n\n\ndef _oracle_accepts(grid: np.ndarray, positions: tuple[tuple[int, int], ...]) -> bool:\n    expected = _rotated_output(grid, positions)\n    try:\n        actual = main(grid)\n    except AssertionError:\n        return False\n    return np.array_equal(actual, expected)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = BG_COLOR\n    count = random.randint(RING_COUNT_MIN, RING_COUNT_MAX)\n    rows, cols = random.choice(_SIZES[count])\n    positions = random.choice(_POSITION_SETS[count][(rows, cols)])\n    grid = _render_grid(rows, cols, positions, bg)\n    return grid if _oracle_accepts(grid, positions) else None\n\n\n--- def generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 46c35fc7 input\")\n===== /home/lixinyu/snap/new/ARC_code/eval/21897d95.py =====\n--- def main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.\n\n    Input structure:\n    - The grid is a mosaic of monochrome regions.\n    - Color 1 forms T-shaped control markers on region boundaries.\n    - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.\n    - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.\n\n    Rule:\n    - For a color-1 T marker, the single stem points at the destination region to repaint.\n    - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.\n    - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.\n    - All marker cells are filled with the final color of the source-side region.\n    - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.\n\n    Key insight:\n    - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = _solve_unrotated(g)\n    l9 = _find_l9_orientation(g)\n    if l9 == 'top_right':\n        return np.rot90(out, 1)\n    if l9 == 'top_left':\n        return np.rot90(out, 3)\n    return out\n\n# --------------- generator (l9rot) ---------------\n\n# ── Tunable constants ──────────────────────────────────────────────────\n# Canvas / region sizing\nGRID_SIZE_MAX = 30                          # max rows or cols\nMIN_REGION_CELLS = 6                        # per-spec minimum\nREGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)\nREGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts\nREGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS\n\n# Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)\nMARKER_MIN = 4\nMARKER_MAX = 8\nNORMAL_MAX = 6\nCOLORED_MAX = 2\n\n# Color pool (all ARC colors except 1, which is reserved for T-marker cells)\nCOLOR_POOL = [c for c in range(10) if c != 1]\n\n# L9 rotation marker\nL9_PROBABILITY = 0.5                        # chance of placing a rotation marker\nL9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation\n    'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],\n    'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],\n}\n\n# Generation retry budget\nSEED_ATTEMPTS = 200                         # tries to place n distinct region seeds\nGEN_RETRIES = 300                           # outer generate_input retry budget\n\n_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n# ── Small geometry helpers ─────────────────────────────────────────────\n\ndef _get_bar(stem):\n    \"\"\"Return the two bar directions perpendicular to *stem*.\"\"\"\n    if stem[0] == 0:\n        return [(-1, 0), (1, 0)]\n    return [(0, -1), (0, 1)]\n\n\ndef _t_cells(center, stem):\n    \"\"\"Return the 4 cells of a T marker: center + stem tip + 2 bar cells.\"\"\"\n    r, c = center\n    bar = _get_bar(stem)\n    return {(r, c), (r + stem[0], c + stem[1]),\n            (r + bar[0][0], c + bar[0][1]), (r + bar[1][0], c + bar[1][1])}\n\n\ndef _t_branch_cells(center, stem):\n    \"\"\"Return the 3 branch cells (stem tip + 2 bar), excluding the center.\"\"\"\n    r, c = center\n    bar = _get_bar(stem)\n    return {(r + stem[0], c + stem[1]),\n            (r + bar[0][0], c + bar[0][1]),\n            (r + bar[1][0], c + bar[1][1])}\n\n\ndef _t_neighborhood(center, stem):\n    \"\"\"Return cells adjacent to any T cell but not part of the T itself.\"\"\"\n    cells = _t_cells(center, stem)\n    neighborhood = set()\n    for r, c in cells:\n        for dr, dc in _DIRS:\n            nb = (r + dr, c + dc)\n            if nb not in cells:\n                neighborhood.add(nb)\n    return neighborhood\n\n\n# ── Region partitioning ────────────────────────────────────────────────\n\ndef _grow_regions(H: int, W: int, n_regions: int) -> np.ndarray | None:\n    \"\"\"Grow n_regions from random seeds via randomized BFS; returns region-id array or None.\"\"\"\n    region = np.full((H, W), -1, dtype=int)\n    seeds = set()\n    for _ in range(SEED_ATTEMPTS):\n        if len(seeds) >= n_regions:\n            break\n        seeds.add((random.randint(1, H - 2), random.randint(1, W - 2)))\n    if len(seeds) < n_regions:\n        return None\n\n    frontier = []\n    for i, (r, c) in enumerate(list(seeds)):\n        region[r, c] = i\n        for dr, dc in _DIRS:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:\n                frontier.append((nr, nc, i))\n    random.shuffle(frontier)\n\n    while frontier:\n        idx = random.randint(0, len(frontier) - 1)\n        r, c, rid = frontier[idx]\n        frontier[idx] = frontier[-1]\n        frontier.pop()\n        if region[r, c] != -1:\n            continue\n        region[r, c] = rid\n        for dr, dc in _DIRS:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:\n                frontier.append((nr, nc, rid))\n\n    # Validate: each region must be 4-connected and have enough cells\n    for rid in range(n_regions):\n        mask = region == rid\n        if mask.sum() < MIN_REGION_CELLS:\n            return None\n        _, n = label_mask(mask, connectivity=4)\n        if n != 1:\n            return None\n    return region\n\n\n# ── Adjacency discovery ───────────────────────────────────────────────\n\ndef _find_adjacent_pairs(region: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Return all directed (src, dst) pairs between adjacent regions.\"\"\"\n    H, W = region.shape\n    # Detect boundaries via horizontal and vertical neighbor differences\n    undirected = set()\n    for r in range(H):\n        for c in range(W):\n            for dr, dc in _DIRS:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < H and 0 <= nc < W:\n                    a, b = int(region[r, c]), int(region[nr, nc])\n                    if a != b:\n                        undirected.add((min(a, b), max(a, b)))\n    directed = []\n    for a, b in undirected:\n        directed.append((a, b))\n        directed.append((b, a))\n    return directed\n\n\n# ── Marker count selection ─────────────────────────────────────────────\n\ndef _choose_marker_counts(n_regions: int) -> tuple[int, int, int] | None:\n    \"\"\"Return (n_markers, n_normal, n_colored) or None if infeasible.\"\"\"\n    max_possible = min(MARKER_MAX, n_regions)\n    if max_possible < MARKER_MIN:\n        return None\n    n_markers = random.randint(MARKER_MIN, max_possible)\n    n_colored = random.randint(0, min(COLORED_MAX, n_markers - 2))\n    n_normal = n_markers - n_colored\n    if n_normal > NORMAL_MAX:\n        n_colored = n_markers - NORMAL_MAX\n        n_normal = NORMAL_MAX\n        if n_colored > COLORED_MAX:\n            n_markers = NORMAL_MAX + COLORED_MAX\n            n_colored = COLORED_MAX\n            n_normal = NORMAL_MAX\n    return n_markers, n_normal, n_colored\n\n\n# ── Marker placement search ───────────────────────────────────────────\n\ndef _find_valid_placements(region, src, dst, occupied_cells, occupied_neighbors, H, W):\n    \"\"\"Find all valid (center, stem) for placing a T marker from src toward dst.\"\"\"\n    candidates = []\n    for r in range(1, H - 1):\n        for c in range(1, W - 1):\n            for stem in _DIRS:\n                bar = _get_bar(stem)\n                cells = _t_cells((r, c), stem)\n                if not all(0 <= cr < H and 0 <= cc < W for cr, cc in cells):\n                    continue\n                if cells & occupied_cells:\n                    continue\n                if _t_neighborhood((r, c), stem) & occupied_cells:\n                    continue\n                if cells & occupied_neighbors:\n                    continue\n                # Diagonal cells (stem + each bar dir) must lie in source region\n                if not all(\n                    0 <= r + stem[0] + bd[0] < H and\n                    0 <= c + stem[1] + bd[1] < W and\n                    region[r + stem[0] + bd[0], c + stem[1] + bd[1]] == src\n                    for bd in bar\n                ):\n                    continue\n                # Walk along stem from step=2 until we hit dst or leave bounds\n                step = 2\n                found = False\n                while True:\n                    nr, nc = r + stem[0] * step, c + stem[1] * step\n                    if not (0 <= nr < H and 0 <= nc < W):\n                        break\n                    if (nr, nc) in occupied_cells or (nr, nc) in cells:\n                        step += 1\n                        continue\n                    found = int(region[nr, nc]) == dst\n                    break\n                if found:\n                    candidates.append(((r, c), stem))\n    return candidates\n\n\ndef _register_marker(kind, center, stem, occupied_cells, occupied_neighbors):\n    \"\"\"Update occupied_cells and occupied_neighbors after placing a marker.\"\"\"\n    cells = _t_cells(center, stem)\n    if kind == 'normal':\n        occupied_cells |= cells\n        occupied_neighbors |= (_t_neighborhood(center, stem) - cells)\n    else:\n        branch = _t_branch_cells(center, stem)\n        occupied_cells |= branch\n        occupied_cells.add(center)\n        # Each branch cell must remain a singleton: buffer all non-marker neighbors\n        for br, bc in branch:\n            for dr, dc in _DIRS:\n                nb = (br + dr, bc + dc)\n                if nb != center and nb not in branch:\n                    occupied_neighbors.add(nb)\n        for dr, dc in _DIRS:\n            nb = (center[0] + dr, center[1] + dc)\n            if nb not in branch:\n                occupied_neighbors.add(nb)\n\n\n# ── Grid construction ─────────────────────────────────────────────────\n\ndef _build_color_map(region: np.ndarray, colors: list[int]) -> np.ndarray:\n    \"\"\"Map region ids to colors via vectorized lookup.\"\"\"\n    lut = np.array(colors, dtype=int)\n    return lut[region]\n\n\ndef _stamp_markers_input(grid, placed_markers):\n    \"\"\"Write T-marker cells onto the input grid.\"\"\"\n    for kind, center, stem, _src, _dst, tc in placed_markers:\n        if kind == 'normal':\n            for cr, cc in _t_cells(center, stem):\n                grid[cr, cc] = 1\n        else:\n            grid[center[0], center[1]] = tc\n            for cr, cc in _t_branch_cells(center, stem):\n                grid[cr, cc] = 1\n\n\ndef _stamp_markers_output(grid, placed_markers, out_colors):\n    \"\"\"Fill marker cells in the output grid with the source region's final color.\"\"\"\n    for kind, center, stem, src, _dst, _tc in placed_markers:\n        color = out_colors[src]\n        for cr, cc in _t_cells(center, stem):\n            grid[cr, cc] = color\n\n\n# ── L9 rotation marker ────────────────────────────────────────────────\n\ndef _try_place_l9(region, placed_markers, occupied_neighbors, input_grid, output_grid, out_colors):\n    \"\"\"Attempt to place a 5-cell L9 marker; return orientation string or None.\"\"\"\n    if random.random() >= L9_PROBABILITY:\n        return None\n    orient = random.choice(list(L9_OFFSETS))\n    offsets = L9_OFFSETS[orient]\n    H, W = region.shape\n\n    all_marker_cells = set()\n    for kind, center, stem, *_ in placed_markers:\n        all_marker_cells |= _t_cells(center, stem)\n\n    candidates = []\n    for r in range(H):\n        for c in range(W):\n            cells = [(r + dr, c + dc) for dr, dc in offsets]\n            if not all(0 <= cr < H and 0 <= cc < W for cr, cc in cells):\n                continue\n            rid = int(region[r, c])\n            if not all(int(region[cr, cc]) == rid for cr, cc in cells):\n                continue\n            if any((cr, cc) in all_marker_cells for cr, cc in cells):\n                continue\n            if any((cr, cc) in occupied_neighbors for cr, cc in cells):\n                continue\n            candidates.append((r, c, rid))\n\n    if not candidates:\n        return None\n    lr, lc, rid = random.choice(candidates)\n    for dr, dc in offsets:\n        input_grid[lr + dr, lc + dc] = 9\n        output_grid[lr + dr, lc + dc] = out_colors[rid]\n    return orient\n\n\n# ── Main generation attempt ───────────────────────────────────────────\n\ndef _gen_attempt() -> np.ndarray | None:\n    n_regions = random.choices(REGION_COUNTS, weights=REGION_WEIGHTS)[0]\n    min_size = max(9, int(n_regions * REGION_SIZE_FACTOR))\n    H = random.randint(min_size, GRID_SIZE_MAX)\n    W = random.randint(min_size, GRID_SIZE_MAX)\n\n    region = _grow_regions(H, W, n_regions)\n    if region is None:\n        return None\n\n    directed_pairs = _find_adjacent_pairs(region)\n\n    counts = _choose_marker_counts(n_regions)\n    if counts is None:\n        return None\n    n_markers, n_normal, n_colored = counts\n\n    # Select src->dst pairs with unique destinations\n    random.shuffle(directed_pairs)\n    dest_used = set()\n    marker_pairs = []\n    for src, dst in directed_pairs:\n        if dst not in dest_used:\n            marker_pairs.append((src, dst))\n            dest_used.add(dst)\n            if len(marker_pairs) >= n_markers:\n                break\n    if len(marker_pairs) < n_markers:\n        n_markers = len(marker_pairs)\n        if n_markers < MARKER_MIN:\n            return None\n        n_colored = min(n_colored, n_markers - 1)\n        n_normal = n_markers - n_colored\n    random.shuffle(marker_pairs)\n\n    # Assign input colors\n    pool = list(COLOR_POOL)\n    random.shuffle(pool)\n    if n_regions > len(pool):\n        return None\n    input_colors = pool[:n_regions]\n\n    # Compute output colors from recoloring rules\n    out_colors = list(input_colors)\n    normal_pairs = marker_pairs[:n_normal]\n    colored_pairs = marker_pairs[n_normal:]\n\n    colored_targets = []\n    for _src, dst in colored_pairs:\n        cands = [c for c in pool if c != input_colors[dst]]\n        if not cands:\n            return None\n        colored_targets.append(random.choice(cands))\n\n    for src, dst in normal_pairs:\n        out_colors[dst] = input_colors[src]\n    for (src, dst), tc in zip(colored_pairs, colored_targets):\n        out_colors[dst] = tc\n\n    # Build marker definitions and place them\n    all_defs = [('normal', s, d, None) for s, d in normal_pairs] + \\\n               [('colored', s, d, tc) for (s, d), tc in zip(colored_pairs, colored_targets)]\n    random.shuffle(all_defs)\n\n    occupied_cells: set[tuple[int, int]] = set()\n    occupied_neighbors: set[tuple[int, int]] = set()\n    placed_markers = []\n    for kind, src, dst, tc in all_defs:\n        cands = _find_valid_placements(region, src, dst, occupied_cells, occupied_neighbors, H, W)\n        if not cands:\n            return None\n        center, stem = random.choice(cands)\n        _register_marker(kind, center, stem, occupied_cells, occupied_neighbors)\n        placed_markers.append((kind, center, stem, src, dst, tc))\n\n    # Build grids via vectorized lookup\n    input_grid = _build_color_map(region, input_colors)\n    output_grid = _build_color_map(region, out_colors)\n\n    _stamp_markers_input(input_grid, placed_markers)\n    _stamp_markers_output(output_grid, placed_markers, out_colors)\n\n    # Optional L9 rotation marker\n    l9_orient = _try_place_l9(region, placed_markers, occupied_neighbors,\n                              input_grid, output_grid, out_colors)\n    if l9_orient == 'top_right':\n        output_grid = np.rot90(output_grid, 1)\n    elif l9_orient == 'top_left':\n        output_grid = np.rot90(output_grid, 3)\n\n    try:\n        result = main(input_grid)\n    except Exception:\n        return None\n    return input_grid if np.array_equal(result, output_grid) else None\n\n\n--- def generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n===== /home/lixinyu/snap/new/ARC_code/train/84551f4c.py =====\n--- def main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n    Input structure\n    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n    Rule\n    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n    - Red bars that are not reached from a blue marker remain unchanged.\n    Key insight\n    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g))) - {bg}\n    assert colors <= {MARKER_COLOR, BODY_COLOR}\n    assert MARKER_COLOR in colors\n\n    bars = _vertical_bars(g, bg)\n    by_col = {bar[\"col\"]: bar for bar in bars}\n    assert len(by_col) == len(bars)\n\n    baselines = {bar[\"bottom\"] for bar in bars}\n    assert len(baselines) == 1\n    baseline = baselines.pop()\n    out = g.copy()\n    for bar in bars:\n        if bar[\"color\"] != MARKER_COLOR:\n            continue\n\n        group = [bar]\n        current = bar\n        while True:\n            next_col = current[\"col\"] + current[\"height\"]\n            next_bar = by_col.get(next_col)\n            if next_bar is None:\n                break\n            if next_bar[\"color\"] != BODY_COLOR:\n                break\n            group.append(next_bar)\n            current = next_bar\n\n        for item in group:\n            rows = item[\"coords\"][:, 0]\n            cols = item[\"coords\"][:, 1]\n            out[rows, cols] = bg\n\n        for item in group:\n            col = item[\"col\"]\n            height = item[\"height\"]\n            assert col + height <= g.shape[1]\n            out[baseline, col : col + height] = item[\"color\"]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nMIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n\n# Bar and chain structure.\nMIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\nMIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\nMIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n\n# Layout padding and retry budget.\nGAP_VALUES = (1, 2, 3)\nMAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n\n\ndef _chain_red_distributions(n_blue, n_red):\n    \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n    return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n\n\ndef _bounded_tuples(values, n, max_sum):\n    \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n    return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n\n\ndef _sample_groups():\n    \"\"\"Sample row count and bar groups before physical layout.\"\"\"\n    rows = random.randint(MIN_ROWS, MAX_ROWS)\n    max_height = min(MAX_BAR_HEIGHT, rows)\n    n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)\n    max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)\n    red_total = random.randint(MIN_RED_BARS, max_red)\n    min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)\n    max_unchained = min(MAX_UNCHAINED_RED, red_total)\n    n_unchained = random.randint(min_unchained, max_unchained)\n\n    distributions = _chain_red_distributions(n_blue, red_total - n_unchained)\n    if not distributions:\n        return None\n\n    groups = [\n        {\"kind\": \"chain\", \"colors\": [MARKER_COLOR] + [BODY_COLOR] * n_red}\n        for n_red in random.choice(distributions)\n    ]\n    groups.extend({\"kind\": \"unchained\", \"colors\": [BODY_COLOR]} for _ in range(n_unchained))\n    random.shuffle(groups)\n    if groups[0][\"kind\"] == \"unchained\":\n        for i, group in enumerate(groups):\n            if group[\"kind\"] == \"chain\":\n                groups[0], groups[i] = groups[i], groups[0]\n                break\n    return rows, max_height, groups\n\n\ndef _sample_layout(max_height, groups):\n    \"\"\"Sample gaps, heights, margins, and positioned bar columns.\"\"\"\n    n_bars = sum(len(group[\"colors\"]) for group in groups)\n    right_margin = random.randint(0, MAX_RIGHT_MARGIN)\n\n    gap_count = len(groups) - 1\n    if gap_count:\n        max_gap_sum = MAX_WIDTH - right_margin - MIN_BAR_HEIGHT * n_bars\n        gap_options = _bounded_tuples(GAP_VALUES, gap_count, max_gap_sum)\n        if not gap_options:\n            return None\n        gaps = list(random.choice(gap_options))\n    else:\n        gaps = []\n\n    height_options = _bounded_tuples(\n        tuple(range(MIN_BAR_HEIGHT, max_height + 1)),\n        n_bars,\n        MAX_WIDTH - right_margin - sum(gaps),\n    )\n    if not height_options:\n        return None\n    heights = list(random.choice(height_options))\n\n    idx = 0\n    for group in groups:\n        count = len(group[\"colors\"])\n        group[\"heights\"] = heights[idx : idx + count]\n        idx += count\n\n    span = sum(heights) + sum(gaps)\n    min_left = max(0, MIN_WIDTH - right_margin - span)\n    max_left = MAX_WIDTH - right_margin - span\n    if min_left > max_left:\n        return None\n    if min_left <= min(MAX_RANDOM_LEFT_MARGIN, max_left):\n        left_margin = random.randint(min_left, min(MAX_RANDOM_LEFT_MARGIN, max_left))\n    else:\n        left_margin = min_left\n\n    width = left_margin + span + right_margin\n    if not (MIN_WIDTH <= width <= MAX_WIDTH):\n        return None\n\n    bars = []\n    col = left_margin\n    gap_i = 0\n    for group_i, group in enumerate(groups):\n        chained = group[\"kind\"] == \"chain\"\n        for color, height in zip(group[\"colors\"], group[\"heights\"]):\n            bars.append(\n                {\n                    \"color\": color,\n                    \"height\": height,\n                    \"col\": col,\n                    \"chained\": chained,\n                }\n            )\n            col += height\n        if group_i + 1 < len(groups):\n            col += gaps[gap_i]\n            gap_i += 1\n\n    if col + right_margin != width:\n        return None\n    return bars, width\n\n\ndef _render_pair(rows, width, bars):\n    \"\"\"Render the sampled input grid and its expected transformed output.\"\"\"\n    baseline = rows - 1\n    inp = np.zeros((rows, width), dtype=int)\n    out = np.zeros_like(inp)\n    for bar in bars:\n        color, height, col = bar[\"color\"], bar[\"height\"], bar[\"col\"]\n        vertical = slice(baseline - height + 1, baseline + 1)\n        inp[vertical, col] = color\n        if bar[\"chained\"]:\n            out[baseline, col : col + height] = color\n        else:\n            out[vertical, col] = color\n    return inp, out\n\n\ndef _passes_oracle(inp, expected):\n    \"\"\"Return whether the solver accepts and matches the rendered output.\"\"\"\n    try:\n        actual = main(inp)\n    except Exception:\n        return False\n    return np.array_equal(actual, expected)\n\n\ndef _gen_attempt():\n    sampled = _sample_groups()\n    if sampled is None:\n        return None\n    rows, max_height, groups = sampled\n\n    layout = _sample_layout(max_height, groups)\n    if layout is None:\n        return None\n    bars, width = layout\n\n    inp, expected = _render_pair(rows, width, bars)\n    if not _passes_oracle(inp, expected):\n        return None\n    return inp\n\n\n--- def generate_input ---\ndef generate_input():\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 84551f4c input\")\n===== /home/lixinyu/snap/new/ARC_code/eval/291dc1e1.py =====\n--- def main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reorder and stack rectangles by proximity to two colored edge lines.\n\n    Input structure:\n    - bg = most common color.\n    - Two edge lines (h + v) meet at a corner marked by a unique color.\n    - \"Blue\" line is color 1 if present, else the longer line; other is \"red.\"\n    - Solid rectangles in the interior.\n\n    Rule:\n    - Sort rectangles by (distance to blue edge, distance to red edge).\n    - If the blue edge is vertical, rotate each rectangle 90° CCW.\n    - Stack top-to-bottom, centered horizontally.\n\n    Key insight: Edge-line colors encode a coordinate system; proximity to each axis determines stacking order and rotation.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # --- locate the marked corner ---\n    corners = [(0, 0), (0, int(W - 1)), (int(H - 1), 0), (int(H - 1), int(W - 1))]\n    corner = None\n    for r, c in corners:\n        if int(g[r, c]) == int(bg):\n            continue\n        nbr = []\n        if r == 0:\n            nbr.append(int(g[r + 1, c]))\n        if r == H - 1:\n            nbr.append(int(g[r - 1, c]))\n        if c == 0:\n            nbr.append(int(g[r, c + 1]))\n        if c == W - 1:\n            nbr.append(int(g[r, c - 1]))\n        if nbr and all(int(n) != int(g[r, c]) for n in nbr):\n            corner = (int(r), int(c))\n            break\n    assert corner is not None\n\n    cr, cc = map(int, corner)\n    marker = int(g[cr, cc])\n\n    # --- line colors adjacent to the corner ---\n    hstep = 1 if cc == 0 else -1\n    vstep = 1 if cr == 0 else -1\n    hcol = int(g[cr, cc + hstep])\n    vcol = int(g[cr + vstep, cc])\n\n    # Choose \"blue\" line color.\n    if hcol == 1 or vcol == 1:\n        blue_col = 1\n        red_col = int(vcol if hcol == 1 else hcol)\n    else:\n        # Fallback: longer line is blue.\n        hlen = 0\n        c = int(cc + hstep)\n        while 0 <= c < W and int(g[cr, c]) == int(hcol):\n            hlen += 1\n            c += int(hstep)\n        vlen = 0\n        r = int(cr + vstep)\n        while 0 <= r < H and int(g[r, cc]) == int(vcol):\n            vlen += 1\n            r += int(vstep)\n        if vlen >= hlen:\n            blue_col = int(vcol)\n            red_col = int(hcol)\n        else:\n            blue_col = int(hcol)\n            red_col = int(vcol)\n\n    blue_orient = \"h\" if int(hcol) == int(blue_col) else \"v\"\n    red_orient = \"h\" if int(hcol) == int(red_col) else \"v\"\n\n    # --- mask out the two edge lines (entire corner row + col) ---\n    line_mask = np.zeros((H, W), dtype=bool)\n    line_mask[cr, :] = True\n    line_mask[:, cc] = True\n\n    # --- extract solid rectangles (no bg inside bbox) ---\n    mask = (g != int(bg)) & (~line_mask) & (g != int(marker))\n    rects = []\n    for coords in components_mask(mask, connectivity=4):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if bool((sub == int(bg)).any()):\n            continue\n        rects.append({\"box\": tuple(map(int, b)), \"arr\": sub.copy()})\n\n    assert not (not rects)\n\n    def dist_to_edge(rect: dict, orient: str, edge_idx: int) -> int:\n        r0, c0, r1, c1 = map(int, rect[\"box\"])\n        if orient == \"v\":\n            col = int(edge_idx)\n            if int(c0) > col:\n                return int(c0 - col - 1)\n            if int(c1) < col:\n                return int(col - c1 - 1)\n            return 0\n        row = int(edge_idx)\n        if int(r0) > row:\n            return int(r0 - row - 1)\n        if int(r1) < row:\n            return int(row - r1 - 1)\n        return 0\n\n    blue_edge_idx = int(cc if blue_orient == \"v\" else cr)\n    red_edge_idx = int(cc if red_orient == \"v\" else cr)\n\n    def along_from_corner(rect: dict, orient: str) -> int:\n        r0, c0, r1, c1 = map(int, rect[\"box\"])\n        if orient == \"v\":\n            return int(r0 if cr == 0 else -r1)\n        return int(c0 if cc == 0 else -c1)\n\n    for rct in rects:\n        rct[\"db\"] = int(dist_to_edge(rct, blue_orient, blue_edge_idx))\n        rct[\"dr\"] = int(dist_to_edge(rct, red_orient, red_edge_idx))\n\n    rects.sort(\n        key=lambda r: (\n            int(r[\"db\"]),\n            int(r[\"dr\"]),\n            along_from_corner(r, blue_orient),\n            along_from_corner(r, red_orient),\n        )\n    )\n\n    # Rotate all rectangles if blue edge is vertical.\n    seq = []\n    for rct in rects:\n        a = rct[\"arr\"]\n        if blue_orient == \"v\":\n            a = np.rot90(a, k=1)  # CCW\n        seq.append(a)\n\n    outW = int(max(int(a.shape[1]) for a in seq))\n    outH = int(sum(int(a.shape[0]) for a in seq))\n    out = np.full((outH, outW), int(bg), dtype=int)\n\n    out_r = 0\n    for a in seq:\n        h, w = map(int, a.shape)\n        out_c = int((outW - w) // 2)\n        paste(out, a, int(out_r), int(out_c))\n        out_r += int(h)\n\n    return out\n\n# --------------- generator (attempt 3, Codex) ---------------\n\nBG = 8\nBLUE = 1\nRED = 2\nMARKER = 0\nDOMINANT_COLORS = np.array([3, 4, 5, 6, 7, 9], dtype=int)\nMINORITY_COLORS = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)\n\n\ndef _transform(grid: np.ndarray, blue_orient: str, corner: str) -> np.ndarray:\n    if blue_orient == \"h\":\n        if corner == \"tl\":\n            return grid\n        if corner == \"tr\":\n            return np.fliplr(grid)\n        if corner == \"bl\":\n            return np.flipud(grid)\n        return np.rot90(grid, 2)\n\n    base = np.rot90(grid, 1)\n    if corner == \"bl\":\n        return base\n    if corner == \"tl\":\n        return np.flipud(base)\n    if corner == \"tr\":\n        return np.rot90(grid, 3)\n    return np.flipud(np.rot90(grid, 3))\n\n\ndef _distribute_band_widths(count: int, used_target: int) -> list[int]:\n    extra_units = (used_target - (4 * count - 2)) // 2\n    order = np.random.permutation(count)\n    units = np.zeros(count, dtype=int)\n    remaining = int(extra_units)\n    for i, idx in enumerate(order):\n        slots_left = count - i - 1\n        lo = max(0, remaining - 3 * slots_left)\n        hi = min(3, remaining)\n        take = int(np.random.randint(lo, hi + 1))\n        units[int(idx)] = take\n        remaining -= take\n    return [2 + 2 * int(u) for u in units]\n\n\ndef _sprinkle_minorities(patch: np.ndarray, dominant: int) -> np.ndarray:\n    area = int(patch.size)\n    if area < 8 or np.random.rand() < 0.6:\n        return patch\n\n    max_minor = min(3, area // 4)\n    if max_minor < 2:\n        return patch\n\n    n_minor = int(np.random.randint(2, max_minor + 1))\n    n_colors = int(np.random.randint(1, min(2, n_minor) + 1))\n    minority_choices = [int(c) for c in MINORITY_COLORS if int(c) != dominant]\n    colors = np.random.choice(minority_choices, size=n_colors, replace=False)\n    cells = np.random.choice(area, size=n_minor, replace=False)\n    flat = patch.reshape(-1)\n    for idx, cell in enumerate(cells):\n        flat[int(cell)] = int(colors[idx % n_colors])\n    return patch\n\n\ndef _build_canonical() -> np.ndarray:\n    long_dim = int(np.random.randint(9, 29))\n    options = []\n    for trailing in (1, 2):\n        max_used = long_dim - 2 - trailing\n        if max_used < 6 or max_used % 2:\n            continue\n        max_count = min(5, (max_used + 2) // 4)\n        pairs = []\n        for a in range(2, max_count + 1):\n            for b in range(2, max_count + 1):\n                if a + b > 9:\n                    continue\n                eligible = []\n                if max_used <= 10 * a - 2:\n                    eligible.append(0)\n                if max_used <= 10 * b - 2:\n                    eligible.append(1)\n                if eligible:\n                    pairs.append((a, b, eligible))\n        if pairs:\n            options.append((max_used, pairs))\n\n    max_used, pairs = options[int(np.random.randint(len(options)))]\n    n0, n1, eligible = pairs[int(np.random.randint(len(pairs)))]\n    max_band = int(np.random.choice(eligible))\n    max0 = min(max_used, 10 * n0 - 2)\n    max1 = min(max_used, 10 * n1 - 2)\n    used0 = int(max_used if max_band == 0 else np.random.choice(np.arange(4 * n0 - 2, max0 + 1, 2)))\n    used1 = int(max_used if max_band == 1 else np.random.choice(np.arange(4 * n1 - 2, max1 + 1, 2)))\n    band0 = _distribute_band_widths(n0, used0)\n    band1 = _distribute_band_widths(n1, used1)\n\n    grid = np.full((8, long_dim), BG, dtype=int)\n    grid[0, :] = BLUE\n    grid[:, 0] = RED\n    grid[0, 0] = MARKER\n\n    for r0, widths in ((2, band0), (5, band1)):\n        c = 2\n        for w in widths:\n            color = int(np.random.choice(DOMINANT_COLORS))\n            patch = np.full((2, w), color, dtype=int)\n            patch = _sprinkle_minorities(patch, color)\n            paste(grid, patch, r0, c)\n            c += w + 2\n\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    canonical = _build_canonical()\n    blue_orient = str(np.random.choice([\"h\", \"v\"]))\n    corner = str(np.random.choice([\"tl\", \"tr\", \"bl\", \"br\"]))\n    return _transform(canonical, blue_orient, corner)\n\n\n--- def generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate input for 291dc1e1\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py',\n'/home/lixinyu/snap/new/ARC_code/eval/2b83f449.py',\n'/home/lixinyu/snap/new/ARC_code/eval/269e22fb.py',\n'/home/lixinyu/snap/new/ARC_code/train/34cfa167.py',\n]\nfor path in files:\n    text = Path(path).read_text()\n    lines = text.splitlines()\n    starts = []\n    for i,l in enumerate(lines):\n        if l.startswith('def main') or l.startswith('def generate_input'):\n            starts.append(i)\n    starts.append(len(lines))\n    print(f'===== {path} =====')\n    for a,b in zip(starts, starts[1:]):\n        name = lines[a].split('(')[0].strip()\n        print(f'--- {name} ---')\n        for line in lines[a:b]:\n            print(line)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py',\n'/home/lixinyu/snap/new/ARC_code/eval/2b83f449.py',\n'/home/lixinyu/snap/new/ARC_code/eval/269e22fb.py',\n'/home/lixinyu/snap/new/ARC_code/train/34cfa167.py',\n]\nfor path in files:\n    text = Path(path).read_text()\n    lines = text.splitlines()\n    starts = []\n    for i,l in enumerate(lines):\n        if l.startswith('def main') or l.startswith('def generate_input'):\n            starts.append(i)\n    starts.append(len(lines))\n    print(f'===== {path} =====')\n    for a,b in zip(starts, starts[1:]):\n        name = lines[a].split('(')[0].strip()\n        print(f'--- {name} ---')\n        for line in lines[a:b]:\n            print(line)\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/edb79dae.py =====\n--- def main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp recolored sprites into a framed region using placeholder positions and a color legend.\n\n    Input structure:\n    - bg background, a rectangular single-color frame, colored placeholder cells inside the frame.\n    - Outside the frame: sprite shapes (one per placeholder color) and a small legend mapping each placeholder color to an output color.\n\n    Rule:\n    - Find the frame and its interior placeholders.\n    - For each placeholder color, locate the matching-color sprite outside the frame.\n    - Stamp each sprite at the placeholder's position inside the frame.\n    - Recolor every stamped sprite to the output color defined by the legend.\n\n    Key insight: The legend pairs (overlapping two-color glyphs outside the frame) dictate the final recoloring — placeholder color selects the shape, legend maps it to the output color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    frame_col, (fr0, fc0, fr1, fc1) = _find_frame(g, bg)\n\n    crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1]\n    H, W = crop.shape\n    assert H >= 3 and W >= 3, f\"frame too small for interior: {(H, W)}\"\n\n    # Placeholder components inside the frame interior.\n    inner_mask = np.zeros((H, W), dtype=bool)\n    inner_mask[1:-1, 1:-1] = True\n    placeholder_colors = set(map(int, np.unique(crop[inner_mask]))) - {bg, frame_col}\n    assert placeholder_colors, \"no placeholder colors found inside frame\"\n\n    placeholders: list[tuple[int, tuple[int, int, int, int]]] = []\n    for col in sorted(placeholder_colors):\n        for pts in components_mask((crop == col) & inner_mask, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            placeholders.append((col, (r0, c0, r1, c1)))\n    # Eval inputs use one placement bbox size per placeholder color.\n    phw: dict[int, tuple[int, int]] = {}\n    for col in placeholder_colors:\n        dims = [(b[2] - b[0] + 1, b[3] - b[1] + 1) for c, b in placeholders if c == col]\n        assert dims, f\"no placeholder component found for color {col}\"\n        unique_dims = sorted(set(dims))\n        assert len(unique_dims) == 1, f\"ambiguous placeholder sizes for color {col}: {unique_dims}\"\n        phw[col] = unique_dims[0]\n\n    # Extract outside-frame components for sprite shapes and for legend color mapping.\n    outside = np.ones(g.shape, dtype=bool)\n    outside[fr0 : fr1 + 1, fc0 : fc1 + 1] = False\n\n    # Collect all outside components (with ids) for later pairing.\n    comps = []\n    colors = [int(c) for c in np.unique(g) if int(c) not in (bg, frame_col)]\n    cid = 0\n    for col in colors:\n        for pts in components_mask((g == col) & outside, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            pts_tuples = [(int(r), int(c)) for r, c in pts]\n            comps.append(\n                {\n                    \"id\": cid,\n                    \"col\": int(col),\n                    \"pts\": pts_tuples,\n                    \"bbox\": (r0, c0, r1, c1),\n                    \"area\": len(pts_tuples),\n                }\n            )\n            cid += 1\n\n    def _bbox_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n        ar0, ac0, ar1, ac1 = a\n        br0, bc0, br1, bc1 = b\n        return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)\n\n    # Legend mapping: detect small two-color glyph regions where two components overlap in bbox\n    # and the union bbox contains only those two colors (no background).\n    color_map: dict[int, int] = {}\n    legend_ids: set[int] = set()\n\n    for i in range(len(comps)):\n        for j in range(i + 1, len(comps)):\n            ci = comps[i]\n            cj = comps[j]\n            if ci[\"col\"] == cj[\"col\"]:\n                continue\n            if not _bbox_overlap(ci[\"bbox\"], cj[\"bbox\"]):\n                continue\n            r0 = min(ci[\"bbox\"][0], cj[\"bbox\"][0])\n            c0 = min(ci[\"bbox\"][1], cj[\"bbox\"][1])\n            r1 = max(ci[\"bbox\"][2], cj[\"bbox\"][2])\n            c1 = max(ci[\"bbox\"][3], cj[\"bbox\"][3])\n            # restrict to compact legend-like regions\n            if (r1 - r0 + 1) > 8 or (c1 - c0 + 1) > 8:\n                continue\n            sub = g[r0 : r1 + 1, c0 : c1 + 1]\n            sub_colors = set(map(int, np.unique(sub))) - {frame_col}\n            if bg in sub_colors:\n                continue\n            if len(sub_colors) != 2:\n                continue\n            cset = set(sub_colors)\n            if ci[\"col\"] not in cset or cj[\"col\"] not in cset:\n                continue\n\n            # Decide source->target.\n            # If exactly one color is used as a placeholder inside the frame, that one is source.\n            if (ci[\"col\"] in placeholder_colors) ^ (cj[\"col\"] in placeholder_colors):\n                src = ci[\"col\"] if ci[\"col\"] in placeholder_colors else cj[\"col\"]\n                tgt = cj[\"col\"] if src == ci[\"col\"] else ci[\"col\"]\n            else:\n                # Otherwise: the larger component in this pair is treated as the source.\n                assert ci[\"area\"] != cj[\"area\"], f\"ambiguous equal-area legend pair: {ci['col']} and {cj['col']}\"\n                if ci[\"area\"] > cj[\"area\"]:\n                    src, tgt = ci[\"col\"], cj[\"col\"]\n                else:\n                    src, tgt = cj[\"col\"], ci[\"col\"]\n\n            assert src in placeholder_colors, f\"legend source color {src} is not a placeholder\"\n            assert src not in color_map, f\"duplicate legend mapping for placeholder color {src}\"\n            color_map[src] = int(tgt)\n            legend_ids.add(ci[\"id\"])\n            legend_ids.add(cj[\"id\"])\n    assert set(color_map) == placeholder_colors, (\n        f\"legend mappings {sorted(color_map)} do not match placeholders {sorted(placeholder_colors)}\"\n    )\n\n    # Sprite shapes: for each placeholder color, pick the non-legend component matching placeholder size.\n    sprite_coords: dict[int, tuple[tuple[tuple[int, int], ...], int, int]] = {}\n    for src_col in sorted(placeholder_colors):\n        all_candidates = [c for c in comps if c[\"col\"] == src_col and c[\"id\"] not in legend_ids]\n        assert all_candidates, f\"no non-legend sprite found for color {src_col}\"\n        want_h, want_w = phw[src_col]\n        sized = [\n            c\n            for c in all_candidates\n            if (c[\"bbox\"][2] - c[\"bbox\"][0] + 1) == want_h and (c[\"bbox\"][3] - c[\"bbox\"][1] + 1) == want_w\n        ]\n        assert len(sized) == 1, f\"expected one size-matched sprite for color {src_col}, found {len(sized)}\"\n        base = sized[0]\n        sr0, sc0, sr1, sc1 = base[\"bbox\"]\n\n        # Some sprites can be split into multiple 4-connected components of the same color.\n        # Merge any additional (non-legend) components fully contained in the chosen sprite bbox.\n        pts_set = set(base[\"pts\"])\n        for c in all_candidates:\n            if c[\"id\"] == base[\"id\"]:\n                continue\n            r0, c0, r1, c1 = c[\"bbox\"]\n            assert sr0 <= r0 and sr1 >= r1 and sc0 <= c0 and sc1 >= c1, (\n                f\"extra sprite component for color {src_col} is outside the base bbox\"\n            )\n            pts_set.update(c[\"pts\"])\n\n        coords = tuple(sorted((r - sr0, c - sc0) for r, c in pts_set))\n        sprite_coords[src_col] = (coords, sr1 - sr0 + 1, sc1 - sc0 + 1)\n\n    # Build output crop: keep frame border, clear interior to bg, then paste recolored sprites.\n    out = crop.copy()\n    out[1:-1, 1:-1] = bg\n\n    for src_col, (pr0, pc0, pr1, pc1) in placeholders:\n        assert src_col in sprite_coords and src_col in color_map, f\"placeholder color {src_col} missing sprite or color mapping\"\n        tgt_col = int(color_map[src_col])\n        coords, sh, sw = sprite_coords[src_col]\n        assert (pr1 - pr0 + 1, pc1 - pc0 + 1) == (sh, sw), (\n            f\"placeholder size does not match sprite for color {src_col}\"\n        )\n        assert pr0 + sh <= H and pc0 + sw <= W, f\"sprite for color {src_col} does not fit at placeholder\"\n        # Align sprite's bbox top-left to placeholder bbox top-left.\n        off_r = pr0\n        off_c = pc0\n        for dr, dc in coords:\n            rr, cc = off_r + dr, off_c + dc\n            out[rr, cc] = tgt_col\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# === CFG: tunables ===\nFRAME_COL = 5                       # frame border color (always gray)\nSPRITE_N_RANGE = (3, 6)             # NxN sprite/placeholder size, exclusive upper\nGRID_ROWS_RANGE = (2, 4)            # placeholder grid row count, exclusive upper\nGRID_COLS_RANGE = (3, 5)            # placeholder grid col count, exclusive upper\nTOTAL_BLOCKS_RANGE = (6, 10)        # total filled slots (inclusive)\nMAX_EMPTY_SLOTS = 2                 # max empty slots in the grid\nNUM_COLORS_RANGE = (2, 5)           # K = number of distinct placeholder colors (inclusive)\nSPRITE_FILL_MIN = 0.5               # min sprite fill ratio\nSPRITE_FILL_MAX = 0.9               # max sprite fill ratio (clamped to n*n-1)\nMIN_FRAME_H = 13                    # minimum frame height\nMIN_FRAME_W = 18                    # minimum frame width\nMAX_FRAME_DIM = 21                  # maximum frame height or width\nFRAME_MARGIN_SLACK = 4              # max extra padding inside frame beyond content\nCANVAS_H_RANGE = (22, 31)           # final grid height range, exclusive upper\nCANVAS_W_RANGE = (23, 31)           # final grid width range, exclusive upper\nFRAME_POS_JITTER_PROB = 0.25        # probability of non-edge frame placement per axis\nPATCH_PADDING = 1                   # min bg gap between placed patches\nGEN_RETRIES = 300                   # outer retry budget\n\n\ndef _legend(src: int, tgt: int) -> np.ndarray:\n    \"\"\"Build a 3x4 legend block mapping src color to tgt color.\"\"\"\n    return np.array(\n        [[src, src, tgt, tgt],\n         [src, src, src, tgt],\n         [src, src, tgt, tgt]], dtype=int)\n\n\ndef _sprite_mask(n: int) -> np.ndarray:\n    \"\"\"Generate a random NxN binary mask with fill ratio in [SPRITE_FILL_MIN, SPRITE_FILL_MAX].\"\"\"\n    lo = max((n * n + 1) // 2, int(np.ceil(SPRITE_FILL_MIN * n * n)))\n    hi = min(int(np.floor(SPRITE_FILL_MAX * n * n)), n * n - 1)\n    target = random.randint(lo, hi)\n\n    # Seed: random walk column + one full row, then random orientation\n    mask = np.zeros((n, n), dtype=bool)\n    c = random.randrange(n)\n    for r in range(n):\n        c = max(0, min(n - 1, c + random.choice([-1, 0, 1])))\n        mask[r, c] = True\n    mask[random.randrange(n), :] = True\n\n    if random.random() < 0.5:\n        mask = mask.T.copy()\n    if random.random() < 0.5:\n        mask = np.flipud(mask)\n    if random.random() < 0.5:\n        mask = np.fliplr(mask)\n\n    # Grow to target fill by adding random frontier cells\n    while int(mask.sum()) < target:\n        dilated = np.zeros_like(mask)\n        dilated[1:, :] |= mask[:-1, :]\n        dilated[:-1, :] |= mask[1:, :]\n        dilated[:, 1:] |= mask[:, :-1]\n        dilated[:, :-1] |= mask[:, 1:]\n        frontier = list(zip(*np.where(dilated & ~mask)))\n        r, c = random.choice(frontier)\n        mask[r, c] = True\n    return mask\n\n\ndef _colored_sprite(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\n    \"\"\"Render a binary mask as a colored sprite on bg.\"\"\"\n    out = np.full(mask.shape, bg, dtype=int)\n    out[mask] = int(color)\n    return out\n\n\ndef _content_extent(n: int, grid_rows: int, grid_cols: int) -> tuple[int, int]:\n    \"\"\"Content area needed for grid_rows x grid_cols of NxN blocks with 1-cell gaps.\"\"\"\n    return (grid_rows * n + grid_rows - 1, grid_cols * n + grid_cols - 1)\n\n\ndef _choose_structure() -> tuple[int, int, int, int, int] | None:\n    \"\"\"Pick (n, rows, cols, empty_count, total) satisfying frame size constraints.\"\"\"\n    total = random.randint(*TOTAL_BLOCKS_RANGE)\n    options = []\n    for n in range(*SPRITE_N_RANGE):\n        for rows in range(*GRID_ROWS_RANGE):\n            for cols in range(*GRID_COLS_RANGE):\n                ch, cw = _content_extent(n, rows, cols)\n                base_fh = ch + 4  # +2 border +2 min margin\n                base_fw = cw + 4\n                slots = rows * cols\n                empty = slots - total\n                if base_fh <= MAX_FRAME_DIM and base_fw <= MAX_FRAME_DIM and 0 <= empty <= MAX_EMPTY_SLOTS:\n                    options.append((n, rows, cols, empty, total))\n    return random.choice(options) if options else None\n\n\ndef _choose_empty_slots(\n    rows: int, cols: int, empty_count: int\n) -> tuple[set[tuple[int, int]], list[tuple[int, int]]]:\n    \"\"\"Choose which grid slots are empty, ensuring every row and column has at least one filled slot.\n\n    Returns (empty_slots, shuffled filled_slots).\n    \"\"\"\n    slots = [(r, c) for r in range(rows) for c in range(cols)]\n    valid = []\n    for combo in itertools.combinations(slots, empty_count):\n        empty = set(combo)\n        filled = [s for s in slots if s not in empty]\n        if len({r for r, _ in filled}) == rows and len({c for _, c in filled}) == cols:\n            valid.append(empty)\n    empty_slots = random.choice(valid)\n    filled_slots = [s for s in slots if s not in empty_slots]\n    random.shuffle(filled_slots)\n    return empty_slots, filled_slots\n\n\ndef _make_bordered_frame(h: int, w: int, bg: int) -> np.ndarray:\n    \"\"\"Create an h x w frame filled with bg and a 1-cell FRAME_COL border.\"\"\"\n    frame = np.full((h, w), bg, dtype=int)\n    frame[0, :] = frame[-1, :] = FRAME_COL\n    frame[:, 0] = frame[:, -1] = FRAME_COL\n    return frame\n\n\ndef _place_patch(\n    grid: np.ndarray, reserve: np.ndarray, patch: np.ndarray, bg: int,\n    *, transparent: bool,\n) -> bool:\n    \"\"\"Find a free location for patch and paste it onto grid/reserve. Returns success.\"\"\"\n    blocker = np.full(patch.shape, FRAME_COL, dtype=int)\n    try:\n        r, c = random_free_location(reserve, blocker, transparent=bg, padding=PATCH_PADDING)\n    except ValueError:\n        return False\n    paste(reserve, blocker, r, c)\n    paste(grid, patch, r, c, transparent=bg if transparent else None)\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    # --- structure ---\n    struct = _choose_structure()\n    if struct is None:\n        return None\n    n, rows, cols, empty_count, _ = struct\n\n    bg = random.choice([c for c in range(10) if c != FRAME_COL])\n    usable = [c for c in range(10) if c not in (bg, FRAME_COL)]\n\n    # --- colors ---\n    k = random.randint(*NUM_COLORS_RANGE)\n    src_cols = random.sample(usable, k)\n    tgt_cols = [random.choice([c for c in usable if c != src]) for src in src_cols]\n    color_to_tgt = dict(zip(src_cols, tgt_cols))\n    masks = {src: _sprite_mask(n) for src in src_cols}\n\n    # --- frame dimensions & margins ---\n    ch, cw = _content_extent(n, rows, cols)\n    min_fh = max(MIN_FRAME_H, ch + 4)\n    min_fw = max(MIN_FRAME_W, cw + 4)\n    frame_h = random.randint(min_fh, min(MAX_FRAME_DIM, max(min_fh, ch + 2 + FRAME_MARGIN_SLACK)))\n    frame_w = random.randint(min_fw, min(MAX_FRAME_DIM, max(min_fw, cw + 2 + FRAME_MARGIN_SLACK)))\n    y_margin = frame_h - 2 - ch\n    x_margin = frame_w - 2 - cw\n    top_margin = random.randint(1, y_margin - 1)\n    left_margin = random.randint(1, x_margin - 1)\n\n    # --- slot assignment ---\n    _, filled_slots = _choose_empty_slots(rows, cols, empty_count)\n    cell_colors = {}\n    for slot, col in zip(filled_slots[:k], src_cols):\n        cell_colors[slot] = col\n    for slot in filled_slots[k:]:\n        cell_colors[slot] = random.choice(src_cols)\n\n    # --- build input & output frames ---\n    input_frame = _make_bordered_frame(frame_h, frame_w, bg)\n    output_frame = _make_bordered_frame(frame_h, frame_w, bg)\n    for (rr, cc), src in cell_colors.items():\n        r0 = 1 + top_margin + rr * (n + 1)\n        c0 = 1 + left_margin + cc * (n + 1)\n        paste(input_frame, np.full((n, n), src, dtype=int), r0, c0)\n        paste(output_frame, _colored_sprite(masks[src], color_to_tgt[src], bg), r0, c0, transparent=bg)\n\n    # --- canvas selection & frame placement ---\n    ext_area = k * (12 + n * n + 10)\n    possible_dims = [\n        (h, w)\n        for h in range(*CANVAS_H_RANGE)\n        for w in range(*CANVAS_W_RANGE)\n        if h >= frame_h and w >= frame_w and h * w - frame_h * frame_w >= ext_area\n    ]\n    if not possible_dims:\n        return None\n    h, w = random.choice(possible_dims)\n    grid = np.full((h, w), bg, dtype=int)\n    reserve = np.full((h, w), bg, dtype=int)\n\n    fr0 = random.choice([0, h - frame_h])\n    fc0 = random.choice([0, w - frame_w])\n    if h - frame_h > 2 and random.random() < FRAME_POS_JITTER_PROB:\n        fr0 = random.randrange(0, h - frame_h + 1)\n    if w - frame_w > 2 and random.random() < FRAME_POS_JITTER_PROB:\n        fc0 = random.randrange(0, w - frame_w + 1)\n    paste(grid, input_frame, fr0, fc0)\n    paste(reserve, np.full((frame_h, frame_w), FRAME_COL, dtype=int), fr0, fc0)\n\n    # --- place external patches (sprites + legends) ---\n    patches: list[tuple[np.ndarray, bool]] = []\n    for src, tgt in zip(src_cols, tgt_cols):\n        patches.append((_colored_sprite(masks[src], src, bg), True))\n        patches.append((_legend(src, tgt), False))\n    random.shuffle(patches)\n    patches.sort(key=lambda item: item[0].size, reverse=True)\n    for patch, transparent in patches:\n        if not _place_patch(grid, reserve, patch, bg, transparent=transparent):\n            return None\n\n    # --- oracle check ---\n    try:\n        if not np.array_equal(main(grid), output_frame):\n            return None\n    except Exception:\n        return None\n    return grid\n\n\n--- def generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        out = _gen_attempt()\n        if out is not None:\n            return out\n    raise RuntimeError(\"failed to generate valid edb79dae input\")\n===== /home/lixinyu/snap/new/ARC_code/eval/2b83f449.py =====\n--- def main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Simulate tokens falling through a pipe network after gates rotate open.\n\n    Input structure:\n    - Wall (0), bg (pipe fill), gate (horizontal 1×3 bars), token (small edge pixels).\n\n    Rule:\n    - Rotate each gate into a vertical blocker; gate cells become bg.\n    - Tokens drop downward through bg, choosing the extreme column for their side (left→min, right→max).\n    - Tokens settle at true pipe ends (adjacent to wall/boundary), packing inward.\n\n    Key insight: Tokens select drop columns by entry side and land at wall-bounded endpoints, ignoring blocker-bounded ones.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    colors = set(map(int, g.flatten()))\n\n    # --- infer gate color: any color forming 4-ccs of size 3 with bbox 1x3 (horizontal) ---\n    gate = None\n    for col in sorted(colors):\n        if int(col) == 0:\n            continue\n        lab, n = label_mask(g == int(col), connectivity=4)\n        found = False\n        for k in range(1, int(n) + 1):\n            pts = np.argwhere(lab == int(k))\n            if int(pts.shape[0]) != 3:\n                continue\n            r0, c0 = pts.min(axis=0)\n            r1, c1 = pts.max(axis=0)\n            if int(r1 - r0 + 1) == 1 and int(c1 - c0 + 1) == 3:\n                found = True\n                break\n        if found:\n            gate = int(col)\n            break\n    assert not (gate is None)\n\n    # --- token/bg inference ---\n    cnt_all = Counter(map(int, g.flatten()))\n    cand_token = [c for c in colors if int(c) not in (0, int(gate))]\n    assert not (not cand_token)\n    token = int(min(cand_token, key=lambda c: (int(cnt_all[int(c)]), int(c))))\n    cand_bg = [c for c in colors if int(c) not in (0, int(gate), int(token))]\n    assert cand_bg\n    bg = int(max(cand_bg, key=lambda c: (int(cnt_all[int(c)]), -int(c))))\n\n    # --- opened gate color (vertical post) ---\n    open_col = 6 if int(gate) == 7 and 6 not in colors else int(gate - 1) if int(gate) > 0 else 6\n\n    # --- rotate gates (gates open into bg, center becomes vertical open_col) ---\n    out = g.copy()\n    lab, n = label_mask(out == int(gate), connectivity=4)\n    for k in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(k))\n        if int(pts.shape[0]) != 3:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        if int(r1 - r0 + 1) != 1 or int(c1 - c0 + 1) != 3:\n            continue\n        r = int(r0)\n        c0 = int(c0)\n        center_c = int(c0 + 1)\n        out[int(r), int(c0) : int(c0) + 3] = int(bg)\n        for rr in (int(r - 1), int(r), int(r + 1)):\n            if 0 <= int(rr) < H:\n                out[int(rr), int(center_c)] = int(open_col)\n\n    # helpers\n    def segments_in_row(r: int) -> list[tuple[int, int]]:\n        segs: list[tuple[int, int]] = []\n        c = 0\n        while c < W:\n            if int(out[r, c]) != int(bg):\n                c += 1; continue\n            c0 = c\n            while c + 1 < W and int(out[r, c + 1]) == int(bg):\n                c += 1\n            segs.append((c0, c)); c += 1\n        return segs\n\n    def find_seg(segs: list[tuple[int, int]], c: int) -> tuple[int, int] | None:\n        for a, b in segs:\n            if a <= c <= b: return (a, b)\n        return None\n\n    def seg_exit(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single exit column, or None. Assert if >1 exit.\"\"\"\n        a, b = seg\n        if r + 2 >= H: return None\n        drops = [c for c in range(a, b + 1)\n                 if int(out[r + 1, c]) == int(bg) and int(out[r + 2, c]) == int(bg)]\n        assert len(drops) <= 1, f\"segment ({a},{b}) at row {r} has {len(drops)} exits: {drops}\"\n        return drops[0] if drops else None\n\n    def entry_from_above(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single entry column from the wall above, or None. Assert if >1.\"\"\"\n        a, b = seg\n        if r < 2: return None\n        entries = [c for c in range(a, b + 1)\n                   if int(out[r - 1, c]) == int(bg) and int(out[r - 2, c]) == int(bg)]\n        assert len(entries) <= 1, f\"segment ({a},{b}) at row {r} has {len(entries)} entries from above: {entries}\"\n        return entries[0] if entries else None\n\n    # Remove tokens; simulate; re-place.\n    token_pts = [(int(r), int(c)) for r, c in np.argwhere(out == int(token))]\n    out[out == int(token)] = int(bg)\n\n    # Phase 1: each token drops through single exits until stuck.\n    finals: list[tuple[int, int]] = []  # (row, col) of final position\n    for r, c in token_pts:\n        cur_r, cur_c = r, c\n        if int(out[cur_r, cur_c]) != int(bg):\n            finals.append((cur_r, cur_c)); continue\n        while True:\n            seg = find_seg(segments_in_row(cur_r), cur_c)\n            if seg is None: break\n            ex = seg_exit(cur_r, seg)\n            if ex is None: break\n            cur_r += 2; cur_c = ex\n            if cur_r >= H: break\n        finals.append((cur_r, cur_c))\n\n    # Phase 2: pack tokens at opposite end from entry.\n    buckets: dict[tuple[int, tuple[int, int], int], int] = defaultdict(int)\n    for r, c in finals:\n        segs = segments_in_row(r)\n        seg = find_seg(segs, c)\n        if seg is None: continue\n        a, b = seg\n        entry = entry_from_above(r, seg)\n        if entry is not None:\n            # Pack to opposite end from entry\n            pack_end = b if (entry - a) <= (b - entry) else a\n        else:\n            # No entry from above: token at starting position (grid edge), stay put\n            pack_end = a if c <= a else b\n        buckets[(r, seg, pack_end)] += 1\n\n    for (r, (a, b), pack_end), k in buckets.items():\n        if pack_end == a:\n            for i in range(k):\n                if a + i <= b: out[r, a + i] = int(token)\n        else:\n            for i in range(k):\n                if b - i >= a: out[r, b - i] = int(token)\n\n    return out\n\n# --------------- generator (Codex, output-first with spine) ---------------\n\nWALL = 0\nTOKEN = 3\nOPEN = 6\nGATE = 7\nBG = 8\n\n\ndef _build_opened_grid(gates: list[list[int]], holes: list[list[int]], width: int) -> np.ndarray:\n    n_walls = len(gates)\n    height = 2 * n_walls + 1\n    grid = np.full((height, width), WALL, dtype=int)\n\n    for pipe_idx in range(n_walls + 1):\n        r = 2 * pipe_idx\n        grid[r, :] = BG\n        for c in holes[pipe_idx]:\n            grid[r, c] = WALL\n\n    for wall_idx, centers in enumerate(gates):\n        r = 2 * wall_idx + 1\n        for c in centers:\n            grid[r, c - 1] = BG\n            grid[r, c] = OPEN\n            grid[r, c + 1] = BG\n            grid[r - 1, c] = OPEN\n            grid[r + 1, c] = OPEN\n\n    return grid\n\n\ndef _build_input(gates: list[list[int]], holes: list[list[int]], width: int) -> np.ndarray:\n    n_walls = len(gates)\n    height = 2 * n_walls + 1\n    grid = np.full((height, width), WALL, dtype=int)\n    gate_patch = np.full((1, 3), GATE, dtype=int)\n\n    for pipe_idx in range(n_walls + 1):\n        r = 2 * pipe_idx\n        grid[r, :] = BG\n        for c in holes[pipe_idx]:\n            grid[r, c] = WALL\n\n    for wall_idx, centers in enumerate(gates):\n        r = 2 * wall_idx + 1\n        for c in centers:\n            paste(grid, gate_patch, r, c - 1)\n\n    for pipe_idx in range(n_walls):\n        r = 2 * pipe_idx\n        grid[r, 0] = TOKEN\n        grid[r, width - 1] = TOKEN\n\n    return grid\n\n\ndef _segments_in_row(grid: np.ndarray, r: int) -> list[tuple[int, int]]:\n    width = grid.shape[1]\n    segments: list[tuple[int, int]] = []\n    c = 0\n    while c < width:\n        if grid[r, c] != BG:\n            c += 1\n            continue\n        start = c\n        while c + 1 < width and grid[r, c + 1] == BG:\n            c += 1\n        segments.append((start, c))\n        c += 1\n    return segments\n\n\ndef _find_segment(grid: np.ndarray, r: int, c: int) -> tuple[int, int] | None:\n    for seg in _segments_in_row(grid, r):\n        if seg[0] <= c <= seg[1]:\n            return seg\n    return None\n\n\ndef _exits_below(grid: np.ndarray, r: int, seg: tuple[int, int]) -> list[int]:\n    height = grid.shape[0]\n    if r + 2 >= height:\n        return []\n    a, b = seg\n    return [c for c in range(a, b + 1) if grid[r + 1, c] == BG and grid[r + 2, c] == BG]\n\n\ndef _entries_above(grid: np.ndarray, r: int, seg: tuple[int, int]) -> list[int]:\n    if r < 2:\n        return []\n    a, b = seg\n    return [c for c in range(a, b + 1) if grid[r - 1, c] == BG and grid[r - 2, c] == BG]\n\n\ndef _find_issues(grid: np.ndarray) -> list[tuple[int, tuple[int, int], list[int], list[int]]]:\n    height = grid.shape[0]\n    issues: list[tuple[int, tuple[int, int], list[int], list[int]]] = []\n    for r in range(0, height, 2):\n        for seg in _segments_in_row(grid, r):\n            above = _entries_above(grid, r, seg)\n            below = _exits_below(grid, r, seg)\n            if len(above) > 1 or len(below) > 1:\n                issues.append((r, seg, above, below))\n    return issues\n\n\ndef _separator_column(grid: np.ndarray, r: int, left: int, right: int) -> int | None:\n    choices = [c for c in range(left + 1, right) if grid[r, c] == BG]\n    if not choices:\n        return None\n    return int(choices[len(choices) // 2])\n\n\ndef _repair_holes(\n    gates: list[list[int]], holes: list[list[int]], width: int\n) -> list[list[int]] | None:\n    hole_sets = [set(row) for row in holes]\n\n    while True:\n        grid = _build_opened_grid(gates, [sorted(row) for row in hole_sets], width)\n        issues = _find_issues(grid)\n        if not issues:\n            return [sorted(row) for row in hole_sets]\n\n        r, _seg, above, below = issues[0]\n        pipe_idx = r // 2\n        if len(hole_sets[pipe_idx]) >= 2:\n            return None\n\n        events = sorted([(c, \"up\") for c in above] + [(c, \"down\") for c in below])\n        seen_up = False\n        seen_down = False\n        prev_col: int | None = None\n        new_cols: list[int] = []\n\n        for col, kind in events:\n            duplicate = (kind == \"up\" and seen_up) or (kind == \"down\" and seen_down)\n            if duplicate:\n                assert prev_col is not None\n                sep = _separator_column(grid, r, prev_col, col)\n                if sep is None:\n                    return None\n                new_cols.append(sep)\n                seen_up = False\n                seen_down = False\n\n            if kind == \"up\":\n                seen_up = True\n            else:\n                seen_down = True\n            prev_col = col\n\n        if not new_cols:\n            return None\n\n        for c in new_cols:\n            hole_sets[pipe_idx].add(c)\n            if len(hole_sets[pipe_idx]) > 2:\n                return None\n\n        if sum(len(row) for row in hole_sets) > 4:\n            return None\n\n\ndef _candidate_centers(gates: list[list[int]], row: int, width: int) -> list[int]:\n    candidates: list[int] = []\n    for c in range(2, width - 2):\n        if c in gates[row]:\n            continue\n        if any(abs(c - other) < 5 for other in gates[row]):\n            continue\n\n        ok = True\n        for adj in (row - 1, row + 1):\n            if 0 <= adj < len(gates) and any(abs(c - other) < 2 for other in gates[adj]):\n                ok = False\n                break\n        if ok:\n            candidates.append(c)\n    return candidates\n\n\ndef _simulate_output(opened: np.ndarray) -> tuple[np.ndarray, list[int]]:\n    height, width = opened.shape\n    n_walls = (height - 1) // 2\n\n    finals: list[tuple[int, int]] = []\n    drop_counts: list[int] = []\n\n    for pipe_idx in range(n_walls):\n        for start_c in (0, width - 1):\n            r = 2 * pipe_idx\n            c = start_c\n            drops = 0\n            while True:\n                seg = _find_segment(opened, r, c)\n                if seg is None:\n                    break\n                exits = _exits_below(opened, r, seg)\n                if len(exits) != 1:\n                    break\n                r += 2\n                c = exits[0]\n                drops += 1\n            finals.append((r, c))\n            drop_counts.append(drops)\n\n    out = opened.copy()\n    buckets: dict[tuple[int, tuple[int, int], int], int] = defaultdict(int)\n\n    for r, c in finals:\n        seg = _find_segment(opened, r, c)\n        if seg is None:\n            continue\n        a, b = seg\n        entries = _entries_above(opened, r, seg)\n        if len(entries) == 1:\n            entry = entries[0]\n            pack_end = b if (entry - a) <= (b - entry) else a\n        else:\n            pack_end = a if c <= a else b\n        buckets[(r, seg, pack_end)] += 1\n\n    for (r, (a, b), pack_end), count in buckets.items():\n        if pack_end == a:\n            for i in range(count):\n                if a + i <= b:\n                    out[r, a + i] = TOKEN\n        else:\n            for i in range(count):\n                if b - i >= a:\n                    out[r, b - i] = TOKEN\n\n    return out, drop_counts\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    n_walls = int(rng.integers(5, 10))\n    width = int(rng.integers(16, 20))\n\n    gates: list[list[int]] = [[] for _ in range(n_walls)]\n    holes: list[list[int]] = [[] for _ in range(n_walls + 1)]\n\n    spine_len = int(rng.integers(3, min(6, n_walls) + 1))\n    spine_start = int(rng.integers(0, n_walls - spine_len + 1))\n\n    prev_center: int | None = None\n    go_left = bool(rng.integers(2))  # alternate direction each step\n    for row in range(spine_start, spine_start + spine_len):\n        if prev_center is None:\n            options = list(range(3, width - 3))\n        elif go_left:\n            options = [c for c in range(3, prev_center - 1)]  # c <= prev - 2\n        else:\n            options = [c for c in range(prev_center + 2, width - 2)]  # c >= prev + 2\n        if not options:\n            return None\n        center = int(rng.choice(options))\n        gates[row] = [center]\n        prev_center = center\n        go_left = not go_left\n\n    holes = _repair_holes(gates, holes, width)\n    if holes is None:\n        return None\n\n    total_gates = sum(len(row) for row in gates)\n    target_total = int(rng.integers(max(6, total_gates), 13))\n\n    while total_gates < target_total:\n        candidates: list[tuple[int, int]] = []\n        for row in range(n_walls):\n            if len(gates[row]) >= 3:\n                continue\n            for center in _candidate_centers(gates, row, width):\n                candidates.append((row, center))\n\n        if not candidates:\n            break\n\n        order = rng.permutation(len(candidates))\n        added = False\n        for idx in order:\n            row, center = candidates[int(idx)]\n            new_gates = [list(cols) for cols in gates]\n            new_gates[row] = sorted(new_gates[row] + [center])\n            new_holes = _repair_holes(new_gates, holes, width)\n            if new_holes is None:\n                continue\n            gates = new_gates\n            holes = new_holes\n            total_gates += 1\n            added = True\n            break\n\n        if not added:\n            break\n\n    if not (6 <= total_gates <= 12):\n        return None\n\n    opened = _build_opened_grid(gates, holes, width)\n    if _find_issues(opened):\n        return None\n\n    output, drop_counts = _simulate_output(opened)\n    if max(drop_counts, default=0) < 3:\n        return None\n\n    inp = _build_input(gates, holes, width)\n    if not np.array_equal(main(inp), output):\n        return None\n\n    return inp\n\n\n--- def generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate input for task 2b83f449\")\n===== /home/lixinyu/snap/new/ARC_code/eval/269e22fb.py =====\n--- def main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a visible crop into the shared 20x20 binary motif in its matching orientation.\n\n    Input structure:\n    - The grid is a two-color rectangular crop of one rotation/reflection of the same 20x20 motif.\n    - One color is the motif foreground and the other color is the motif background.\n\n    Rule:\n    - Try each input color as the foreground mask.\n    - Match that mask against every possible window in every dihedral orientation of the motif.\n    - Repaint the uniquely matched full 20x20 motif with the matched foreground/background colors.\n\n    Key insight:\n    - The examples are partial windows of one canonical binary pattern; the local crop is distinctive enough to identify the full orientation and offset.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = map(int, g.shape)\n    assert H <= 20 and W <= 20\n\n    colors = colors_present(g)\n    assert len(colors) == 2\n\n    base = _pattern_mask()\n    matches: list[tuple[int, int, np.ndarray]] = []\n    for fg in colors:\n        bg = int(colors[0] if int(colors[1]) == int(fg) else colors[1])\n        visible = g == int(fg)\n        for pattern in _dihedral_variants(base):\n            for r in range(20 - H + 1):\n                for c in range(20 - W + 1):\n                    if np.array_equal(pattern[r : r + H, c : c + W], visible):\n                        matches.append((int(fg), int(bg), pattern))\n\n    assert len(matches) == 1\n    fg, bg, pattern = matches[0]\n    return np.where(pattern, int(fg), int(bg)).astype(int)\n===== /home/lixinyu/snap/new/ARC_code/train/34cfa167.py =====\n--- def main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.\n\n    Input structure:\n    - The background is the dominant color.\n    - Two same-color solid rectangular anchors of the same size sit on opposite\n      diagonal corners, with the first anchor above-left of the second.\n    - The upper-left anchor has two one-cell-thick vertical control bars to its\n      right and two one-cell-thick horizontal control bars below it.\n\n    Rule:\n    - Copy the anchor rectangle into the two missing corners of the implied\n      larger rectangle.\n    - Repeat the right-side control bars horizontally between the left and right\n      anchors, using their spacing as the period, and draw the outer top and\n      bottom borders in the first right-control color.\n    - Repeat the below-side control bars vertically between the top and bottom\n      anchors, using the same period, and draw the outer left and right borders\n      in the first below-control color.\n\n    Key insight: The small control bars are the first two ticks of two periodic\n    frame patterns; the diagonal anchor supplies the opposite corner and the\n    missing two anchor copies.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    source, dest, right_controls, below_controls = _find_structure(g, bg)\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    dr0, dc0, dr1, dc1 = dest[\"bbox\"]\n    anchor_color = int(source[\"color\"])\n    assert int(dest[\"color\"]) == anchor_color, \"anchor colors must match\"\n    assert bbox_h(source[\"bbox\"]) == bbox_h(dest[\"bbox\"]), \"anchor heights must match\"\n    assert bbox_w(source[\"bbox\"]) == bbox_w(dest[\"bbox\"]), \"anchor widths must match\"\n    assert sr0 > 0 and sc0 > 0, \"upper-left anchor must have space for outer frame\"\n    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \"lower-right anchor must have space for outer frame\"\n\n    right_offsets = [int(comp[\"bbox\"][1] - sc1) for comp in right_controls]\n    below_offsets = [int(comp[\"bbox\"][0] - sr1) for comp in below_controls]\n    assert right_offsets == below_offsets and right_offsets[0] == 1, \"control offsets must match from the anchor edge\"\n    step = int(right_offsets[1] - right_offsets[0])\n    assert step > 0, \"control bars must be separated\"\n    period = 2 * step\n    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, \"right frame must close next to the destination anchor\"\n    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, \"below frame must close next to the destination anchor\"\n\n    right_colors = [int(comp[\"color\"]) for comp in right_controls]\n    below_colors = [int(comp[\"color\"]) for comp in below_controls]\n    out = g.copy()\n\n    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)\n    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)\n\n    first_c = int(sc1 + right_offsets[0])\n    last_c = int(dc0 - 1)\n    for c in range(first_c, last_c + 1):\n        offset = int(c - sc1)\n        if (offset - right_offsets[0]) % period == 0:\n            color = right_colors[0]\n        elif (offset - right_offsets[1]) % period == 0:\n            color = right_colors[1]\n        else:\n            continue\n        _paint_rect(out, bg, sr0, c, sr1, c, color)\n        _paint_rect(out, bg, dr0, c, dr1, c, color)\n\n    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])\n    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])\n\n    first_r = int(sr1 + below_offsets[0])\n    last_r = int(dr0 - 1)\n    left_c = int(sc0 - 1)\n    right_c = int(dc1 + 1)\n    for r in range(first_r, last_r + 1):\n        _paint(out, bg, r, left_c, below_colors[0])\n        _paint(out, bg, r, right_c, below_colors[0])\n\n        offset = int(r - sr1)\n        if (offset - below_offsets[0]) % period == 0:\n            _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])\n            _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])\n        elif (offset - below_offsets[1]) % period == 0:\n            _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])\n            _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color sampling.\nCOLOR_COUNT, NON_BG_COLOR_COUNT = 10, 4\n\n# Anchor/repetition geometry.\nANCHOR_SIZE_RANGE = (1, 5)\nREPEAT_COUNT_RANGE = (2, 5)\nCONTROL_OFFSETS = (1, 3)\nFRAME_PERIOD, DEST_ANCHOR_GAP, STRUCTURE_FIXED_PAD = 4, 2, 3\n\n# Canvas/margins.\nCANVAS_MIN_SIZE, CANVAS_MAX_SIZE = 16, 30\nMARGIN_CHOICES = range(4)\nMIN_TOTAL_MARGIN, SOURCE_OUTER_MARGIN = 1, 1\n\n# Retry.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_paint_rect(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int) -> None:\n    grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)\n\n\ndef _choose_margins(struct_len: int) -> tuple[int, int]:\n    pairs = [\n        (before, after)\n        for before in MARGIN_CHOICES\n        for after in MARGIN_CHOICES\n        if MIN_TOTAL_MARGIN <= before + after\n        and CANVAS_MIN_SIZE <= struct_len + before + after <= CANVAS_MAX_SIZE\n    ]\n    return pairs[int(np.random.randint(len(pairs)))]\n\n\ndef _build_output(\n    rows: int,\n    cols: int,\n    bg: int,\n    anchor_color: int,\n    right1: int,\n    right2: int,\n    below1: int,\n    sr0: int,\n    sc0: int,\n    s: int,\n    nh: int,\n    nv: int,\n) -> tuple[np.ndarray, tuple[int, int, int, int, int, int, int, int]]:\n    out = np.full((rows, cols), int(bg), dtype=int)\n    sr1, sc1 = sr0 + s - 1, sc0 + s - 1\n    dr0 = sr1 + FRAME_PERIOD * nv + DEST_ANCHOR_GAP\n    dc0 = sc1 + FRAME_PERIOD * nh + DEST_ANCHOR_GAP\n    dr1, dc1 = dr0 + s - 1, dc0 + s - 1\n\n    for r0, c0 in ((sr0, sc0), (sr0, dc0), (dr0, sc0), (dr0, dc0)):\n        _gen_paint_rect(out, r0, c0, r0 + s - 1, c0 + s - 1, anchor_color)\n\n    first_c, last_c = sc1 + CONTROL_OFFSETS[0], dc0 - 1\n    for c in range(first_c, last_c + 1):\n        offset = c - sc1\n        if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:\n            color = right1\n        elif (offset - CONTROL_OFFSETS[1]) % FRAME_PERIOD == 0:\n            color = right2\n        else:\n            continue\n        _gen_paint_rect(out, sr0, c, sr1, c, color)\n        _gen_paint_rect(out, dr0, c, dr1, c, color)\n    _gen_paint_rect(out, sr0 - 1, first_c, sr0 - 1, last_c, right1)\n    _gen_paint_rect(out, dr1 + 1, first_c, dr1 + 1, last_c, right1)\n\n    first_r, last_r = sr1 + CONTROL_OFFSETS[0], dr0 - 1\n    left_c, right_c = sc0 - 1, dc1 + 1\n    for r in range(first_r, last_r + 1):\n        out[r, left_c] = below1\n        out[r, right_c] = below1\n        offset = r - sr1\n        if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:\n            _gen_paint_rect(out, r, left_c, r, sc1, below1)\n            _gen_paint_rect(out, r, dc0, r, right_c, below1)\n        elif (offset - CONTROL_OFFSETS[1]) % FRAME_PERIOD == 0:\n            _gen_paint_rect(out, r, sc0, r, sc1, right2)\n            _gen_paint_rect(out, r, dc0, r, dc1, right2)\n\n    return out, (sr0, sc0, sr1, sc1, dr0, dc0, dr1, dc1)\n\n\ndef _derive_input(\n    out: np.ndarray,\n    bg: int,\n    sr0: int,\n    sc0: int,\n    sr1: int,\n    sc1: int,\n    dr0: int,\n    dc0: int,\n    dr1: int,\n    dc1: int,\n) -> np.ndarray:\n    keep = np.zeros(out.shape, dtype=bool)\n    keep[sr0 : sr1 + 1, sc0 : sc1 + 1] = True\n    keep[dr0 : dr1 + 1, dc0 : dc1 + 1] = True\n    keep[sr0 : sr1 + 1, sc1 + CONTROL_OFFSETS[0]] = True\n    keep[sr0 : sr1 + 1, sc1 + CONTROL_OFFSETS[1]] = True\n    keep[sr1 + CONTROL_OFFSETS[0], sc0 : sc1 + 1] = True\n    keep[sr1 + CONTROL_OFFSETS[1], sc0 : sc1 + 1] = True\n\n    inp = np.full_like(out, int(bg))\n    inp[keep] = out[keep]\n    return inp\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = int(np.random.randint(COLOR_COUNT))\n    palette = [color for color in range(COLOR_COUNT) if color != bg]\n    anchor_color, right1, right2, below1 = map(\n        int, np.random.choice(palette, NON_BG_COLOR_COUNT, replace=False)\n    )\n\n    s = int(np.random.randint(ANCHOR_SIZE_RANGE[0], ANCHOR_SIZE_RANGE[1]))\n    nh = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))\n    nv = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))\n    struct_h = 2 * s + FRAME_PERIOD * nv + STRUCTURE_FIXED_PAD\n    struct_w = 2 * s + FRAME_PERIOD * nh + STRUCTURE_FIXED_PAD\n\n    top, bottom = _choose_margins(struct_h)\n    left, right = _choose_margins(struct_w)\n    rows, cols = struct_h + top + bottom, struct_w + left + right\n    sr0, sc0 = top + SOURCE_OUTER_MARGIN, left + SOURCE_OUTER_MARGIN\n\n    out, box = _build_output(\n        rows,\n        cols,\n        bg,\n        anchor_color,\n        right1,\n        right2,\n        below1,\n        sr0,\n        sc0,\n        s,\n        nh,\n        nv,\n    )\n    inp = _derive_input(out, bg, *box)\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\n\n--- def generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
