options.\n  73: BG_COLOR = 7\n  74: FG_COLORS = tuple(c for c in range(10) if c != BG_COLOR)\n  75: GRID_SIDES = (9, 11, 13)\n  76: \n  77: # Bar counts and weighted odd-length sampling.\n  78: MIN_BARS, EXTRA_LENGTH_CANDIDATES = 5, 5\n  79: MAX_BARS_BY_SIDE = {9: 6, 11: 8, 13: 10}\n  80: LENGTH_WEIGHT_BY_SIZE = {1: 8, 3: 56, 5: 26, 7: 6, 9: 3}\n  81: DEFAULT_LENGTH_WEIGHT = 1\n  82: ORIENTATIONS = (\"H\", \"V\")\n  83: \n  84: # Retry and placement search limits.\n  85: OUTER_ATTEMPTS, INNER_ATTEMPTS = 10, 50\n  86: CENTER_TRIAL_LIMIT = 80\n  87: \n  88: def _sample_lengths(N, K):\n  89:     possible_lengths = list(range(1, N + 1, 2))\n  90:     weights = [LENGTH_WEIGHT_BY_SIZE.get(l, DEFAULT_LENGTH_WEIGHT) for l in possible_lengths]\n  91:     lengths = random.choices(possible_lengths, weights=weights, k=K + EXTRA_LENGTH_CANDIDATES)\n  92:     lengths.sort(reverse=True)\n  93:     return lengths\n  94: \n  95: def _bar_pixels(cr, cc, length, orient):\n  96:     half = length // 2\n  97:     if orient == \"H\":\n  98:         return {(cr, cc + d) for d in range(-half, half + 1)}\n  99:     return {(cr + d, cc) for d in range(-half, half + 1)}\n 100: \n 101: def _place_one_bar(N, length, occupied):\n 102:     \"\"\"Return input pixels for one placed bar, mutating occupied on success.\"\"\"\n 103:     half = length // 2\n 104:     lo, hi = half, N - 1 - half\n 105:     if lo > hi:\n 106:         return None\n 107:     orient = random.choice(ORIENTATIONS)\n 108:     out_orient = \"V\" if orient == \"H\" else \"H\"\n 109:     candidates = [(r, c) for r in range(lo, hi + 1) for c in range(lo, hi + 1)]\n 110:     random.shuffle(candidates)\n 111: \n 112:     for cr, cc in candidates[:CENTER_TRIAL_LIMIT]:\n 113:         inp_pixels = _bar_pixels(cr, cc, length, orient)\n 114:         out_pixels = _bar_pixels(cr, cc, length, out_orient)\n 115:         footprint = inp_pixels | out_pixels\n 116:         if footprint & occupied:\n 117:             continue\n 118:         occup