he rotation center; the yellow-looking divider is not mirrored, it only separates the source from the empty target side.\n  20:     \"\"\"\n  21:     g = np.asarray(grid, dtype=int)\n  22:     assert g.ndim == 2\n  23:     h, w = g.shape\n  24:     assert h % 2 == 1 and w % 2 == 1\n  25: \n  26:     cr, cc = h // 2, w // 2\n  27:     bg = int(get_bg(g))\n  28: \n  29:     marker_color = int(g[cr, cc])\n  30:     assert marker_color != bg\n  31:     marker_mask = g == marker_color\n  32:     expected_markers = np.zeros(g.shape, dtype=bool)\n  33:     expected_markers[cr, 0] = True\n  34:     expected_markers[cr, cc] = True\n  35:     expected_markers[cr, w - 1] = True\n  36:     assert np.array_equal(marker_mask, expected_markers)\n  37: \n  38:     center_col = g[:, cc]\n  39:     divider_colors = {int(color) for color in np.unique(center_col) if int(color) != marker_color}\n  40:     assert len(divider_colors) == 1\n  41:     divider_color = next(iter(divider_colors))\n  42:     assert divider_color != bg\n  43:     expected_divider = np.zeros(g.shape, dtype=bool)\n  44:     expected_divider[:, cc] = True\n  45:     expected_divider[cr, cc] = False\n  46:     assert np.array_equal(g == divider_color, expected_divider)\n  47: \n  48:     source_mask = (g != bg) & (g != marker_color) & (g != divider_color)\n  49:     source_coords = np.argwhere(source_mask)\n  50:     assert source_coords.size > 0\n  51:     assert np.all(source_coords[:, 1] < cc)\n  52: \n  53:     out = g.copy()\n  54:     for r, c in source_coords:\n  55:         rr = 2 * cr - int(r)\n  56:         rc = 2 * cc - int(c)\n  57:         assert 0 <= rr < h and 0 <= rc < w\n  58:         assert out[rr, rc] == bg\n  59:         out[rr, rc] = g[r, c]\n  60: \n  61:     return out\n  62: \n  63: # --------------- generator (o5x) ---------------\n  64: \n  65: # Colors and canvas bounds.\n  66: BG_COLOR, DIVIDER_COLOR, MARKER_COLOR = 7, 4, 8\n  67: GRID_SIZES, MIN_EMPTY_BORDER_ROWS = (15, 17, 19), 1\n  68: \n  69: # Convex source shape bounds.\n  70: SOURCE_SPAN_RANGE = (10, 15)\n  71: SOURCE_MAX_WIDTH_RANGE = (5, 7)\n  72: SOURCE_EDGE_WIDTH_RANGE = (1, 3)\n  73: WIDTH_STEP_CAP, SOURCE_PIXEL_RANGE = 2, (35, 83)\n  74: \n  75: # Color palette, band orders, and retry budget.\n  76: SOURCE_COLORS = (0, 1, 2, 3, 5, 6, 9)\n  77: SOURCE_COLOR_COUNT_RANGE, GEN_ATTEMPTS = (3, 7), 300\n  78: COLORING_KEYS = (\n  79:     lambda item: (item[2], item[3], item[1]),\n  80:     lambda item: (item[3], item[2], item[1]),\n  81:     lambda item: (item[2] + item[3], item[2], item[1]),\n  82:     lambda item: (item[2] - item[3], item[2], item[1]),\n  83: )\n  84: \n  85: \n  86: def _gen_bounded_steps(total, slots, cap):\n  87:     steps = []\n  88:     remaining = total\n  89:     for i in range(slots):\n  90:         left = slots - i - 1\n  91:         lo = max(0, remaining - cap * left)\n  92:         hi = min(cap, remaining)\n  93:         step = random.randint(lo, hi)\n  94:         steps.append(step)\n  95:         remaining -= step\n  96:     return steps\n  97: \n  98: \n  99: def _gen_width_profile(span, max_width):\n 100:     edge_width_hi = min(SOURCE_EDGE_WIDTH_RANGE[1], max_width)\n 101:     start_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n 102:     end_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n 103:     min_up = (max_width - start_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n 104:     min_down = (max_width - end_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n 105:     if min_up + min_down + 1 > span:\n 106:         return None\n 107: \n 108:     peak_start = random.randint(min_up, span - 1 - min_down)\n 109:     peak_end = random.randint(peak_start, span - 1 - min_down)\n 110: \n 111:     widths = [start_width]\n 112:     for step in _gen_bounded_steps(max_width - start_width, peak_start, WIDTH_STEP_CAP):\n 113:         widths.append(widths[-1] + step)\n 114: \n 115:     widths.extend([max_width] * (peak_end - peak_start))