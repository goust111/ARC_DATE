{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/5623160b.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/5623160b.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Push every colored object touching maroon markers straight outward until it reaches the grid edge.\n\n    Input structure:\n    - The background is the dominant color.\n    - Maroon pixels are fixed markers.\n    - Every other foreground 4-connected object touches the marker pixels on exactly one cardinal side.\n\n    Rule:\n    - Clear each non-background, non-maroon object from its original position.\n    - Translate it in the direction away from its maroon contact until the object reaches the grid boundary.\n    - Keep the maroon marker pixels unchanged.\n\n    Key insight:\n    - The maroon contact side is a launcher: it determines a unique outward ray for the whole object, and the edge of the grid determines the translation distance.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg != MARKER_COLOR\n    assert bool(np.any(g == MARKER_COLOR))\n\n    marker_components = find_components(\n        g,\n        bg=bg,\n        connectivity=4,\n        monochromatic=True,\n        colors=[MARKER_COLOR],\n        return_format=\"dict\",\n    )\n    assert 1 <= len(marker_components) <= 3, \"maroon markers must form 1-3 moderate components\"\n    assert sum(int(comp[\"area\"]) for comp in marker_components) <= 17, \"maroon marker area must be moderate\"\n    assert all(int(comp[\"area\"]) <= 9 for comp in marker_components), \"each maroon component must be moderate\"\n\n    out = g.copy()\n    placements: list[tuple[int, np.ndarray]] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        color = int(comp[\"color\"])\n        if color == MARKER_COLOR:\n            continue\n\n        coords = comp[\"coords\"].astype(int, copy=False)\n        direction = _outward_direction(g, coords)\n        steps = _steps_to_edge(g.shape, coords, direction)\n        assert steps <= 8, \"push distance must stay within the observed moderate range\"\n        offset = np.array(direction, dtype=int) * steps\n        shifted = coords + offset\n        assert bool(\n            np.all(\n                (0 <= shifted[:, 0])\n                & (shifted[:, 0] < g.shape[0])\n                & (0 <= shifted[:, 1])\n                & (shifted[:, 1] < g.shape[1])\n            )\n        )\n        own = {tuple(coord) for coord in coords.tolist()}\n        for step in range(1, steps + 1):\n            swept = coords + np.array(direction, dtype=int) * step\n            for rr, cc in swept:\n                loc = (int(rr), int(cc))\n                assert loc in own or int(g[loc]) == bg, \"object movement path must be unobstructed\"\n\n        out[coords[:, 0], coords[:, 1]] = bg\n        placements.append((color, shifted))\n\n    assert placements\n    for color, coords in placements:\n        assert bool(np.all(out[coords[:, 0], coords[:, 1]] == bg)), \"moved objects must not collide\"\n        out[coords[:, 0], coords[:, 1]] = color\n\n    return out\n\n# --------------- generator (attempt 1 refined) ---------------\n\n# Generated grid colors.\nBG = 7\nMAROON = 9\nALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8]\nDIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n# Canvas and maroon marker bounds.\nGRID_SIZE_MIN = 9\nGRID_SIZE_MAX = 16\nMAROON_COMPONENT_MIN = 1\nMAROON_COMPONENT_MAX = 3\nMAROON_TOTAL_AREA_MAX = 17\nMAROON_COMPONENT_AREA_MAX = 9\nINTERIOR_PADDING = 1\nMAROON_PLACEMENT_TRIES = 80\n\n# Moving object bounds and push constraints.\nOBJECT_COUNT_MIN = 3\nOBJECT_COUNT_MAX = 7\nOBJECT_SIZE_MIN = 1\nOBJECT_SIZE_MAX = 5\nPUSH_DISTANCE_MAX = 8\nZERO_STEP_PROBABILITY = 0.25\nZERO_STEP_ALLOWANCE = 1\n\n# Retry limits for object placement and whole-grid generation.\nOBJECT_SHAPE_TRIES = 20\nCONTACT_CANDIDATE_LIMIT = 5\nGENERATE_RETRIES = 300\n\n\ndef _grow_polyomino(size, rng):\n    \"\"\"Grow a 4-connected polyomino of given size, normalized to (0, 0).\"\"\"\n    cells = {(0, 0)}\n    frontier = [(0, 0)]\n    while len(cells) < size:\n        r, c = rng.choice(frontier)\n        nbrs = [(r-1, c), (r+1, c), (r, c-1), (r, c+1)]\n        rng.shuffle(nbrs)\n        grown = False\n        for nr, nc in nbrs:\n            if (nr, nc) not in cells:\n                cells.add((nr, nc))\n                frontier.append((nr, nc))\n                grown = True\n                break\n        if not grown:\n            frontier.remove((r, c))\n            if not frontier:\n                break\n\n    min_r = min(r for r, c in cells)\n    min_c = min(c for r, c in cells)\n    return [(r - min_r, c - min_c) for r, c in cells]\n\n\ndef _gen_steps_to_edge(N, coords, direction):\n    arr = np.array(coords, dtype=int)\n    dr, dc = direction\n    if dr == -1:\n        return int(arr[:, 0].min())\n    if dr == 1:\n        return int(N - 1 - arr[:, 0].max())\n    if dc == -1:\n        return int(arr[:, 1].min())\n    return int(N - 1 - arr[:, 1].max())\n\n\ndef _swept_cells(N, coords, direction):\n    dr, dc = direction\n    steps = _gen_steps_to_edge(N, coords, direction)\n    own = set(coords)\n    swept = set()\n    for step in range(1, steps + 1):\n        for r, c in coords:\n            loc = (r + dr * step, c + dc * step)\n            if loc not in own:\n                swept.add(loc)\n    return swept\n\n\ndef _paths_are_clear(inp, objects):\n    N = inp.shape[0]\n    for _, inp_coords, _, direction in objects:\n        for r, c in _swept_cells(N, inp_coords, direction):\n            if inp[r, c] != BG:\n                return False\n    return True\n\n\ndef _paint_cells(grid, coords, color):\n    for r, c in coords:\n        grid[r, c] = color\n\n\ndef _place_maroon_components(rng, grid, num_maroon):\n    \"\"\"Place separated maroon components; returns (components, occupied) or None.\"\"\"\n    N = grid.shape[0]\n    maroon_components = []\n    all_maroon = set()\n    total_maroon = 0\n\n    for idx in range(num_maroon):\n        remaining_components = num_maroon - idx - 1\n        max_size = min(\n            MAROON_COMPONENT_AREA_MAX,\n            MAROON_TOTAL_AREA_MAX - total_maroon - remaining_components,\n        )\n        if max_size < 1:\n            return None\n\n        size = rng.randint(1, max_size)\n        cells = _grow_polyomino(size, rng)\n        h = max(r for r, c in cells) + 1\n        w = max(c for r, c in cells) + 1\n        if h > N - 2 or w > N - 2:\n            return None\n\n        placed = _try_place_maroon_component(rng, grid, cells, all_maroon)\n        if placed is None:\n            return None\n\n        _paint_cells(grid, placed, MAROON)\n        maroon_components.append(placed)\n        all_maroon.update(placed)\n        total_maroon += size\n\n    return maroon_components, all_maroon\n\n\ndef _try_place_maroon_component(rng, grid, cells, all_maroon):\n    N = grid.shape[0]\n    h = max(r for r, c in cells) + 1\n    w = max(c for r, c in cells) + 1\n    for _ in range(MAROON_PLACEMENT_TRIES):\n        r0 = rng.randint(INTERIOR_PADDING, N - INTERIOR_PADDING - h)\n        c0 = rng.randint(INTERIOR_PADDING, N - INTERIOR_PADDING - w)\n        abs_cells = [(r + r0, c + c0) for r, c in cells]\n        if not all(grid[r, c] == BG for r, c in abs_cells):\n            continue\n        if any((r + dr, c + dc) in all_maroon for r, c in abs_cells for dr, dc in DIRS):\n            continue\n        return abs_cells\n    return None\n\n\ndef _available_slots(N, maroon_components, all_maroon):\n    \"\"\"Return (component index, outward side, contact cells) slots around markers.\"\"\"\n    slots = []\n    for mi, m_cells in enumerate(maroon_components):\n        for dr, dc in DIRS:\n            contacts = []\n            for r, c in m_cells:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < N and 0 <= nc < N and (nr, nc) not in all_maroon:\n                    contacts.append((nr, nc))\n            if contacts:\n                slots.append((mi, (dr, dc), contacts))\n    return slots\n\n\ndef _choose_object_slots(rng, slots):\n    target_objects = rng.randint(OBJECT_COUNT_MIN, OBJECT_COUNT_MAX)\n    if len(slots) < target_objects:\n        target_objects = len(slots)\n    if target_objects < OBJECT_COUNT_MIN:\n        return None\n    rng.shuffle(slots)\n    return slots[:target_objects]\n\n\ndef _touching_maroon_sides(coords, all_maroon):\n    touching = set()\n    for r, c in coords:\n        for dr, dc in DIRS:\n            if (r + dr, c + dc) in all_maroon:\n                touching.add((dr, dc))\n    return touching\n\n\ndef _coords_from_contact(obj_cells, contact, rng):\n    anchor_idx = rng.randint(0, len(obj_cells) - 1)\n    ar, ac = obj_cells[anchor_idx]\n    offset_r = contact[0] - ar\n    offset_c = contact[1] - ac\n    return [(r + offset_r, c + offset_c) for r, c in obj_cells]\n\n\ndef _coords_in_bounds(N, coords):\n    return all(0 <= r < N and 0 <= c < N for r, c in coords)\n\n\ndef _translated_coords(coords, direction, steps):\n    dr, dc = direction\n    return [(r + dr * steps, c + dc * steps) for r, c in coords]\n\n\ndef _pick_unused_color(rng, used_colors):\n    remaining = [color for color in ALL_COLORS if color not in used_colors]\n    color = rng.choice(remaining)\n    used_colors.add(color)\n    return color\n\n\ndef _try_place_object(\n    rng,\n    N,\n    slot,\n    output,\n    input_occupied,\n    reserved_swept,\n    all_maroon,\n    color,\n    zero_step_budget,\n):\n    \"\"\"Try one side slot; mutates occupancy/output only after accepting a candidate.\"\"\"\n    _, direction, contact_cells = slot\n    dr, dc = direction\n    obj_size = rng.randint(OBJECT_SIZE_MIN, OBJECT_SIZE_MAX)\n\n    for _ in range(OBJECT_SHAPE_TRIES):\n        obj_cells = _grow_polyomino(obj_size, rng)\n        rng.shuffle(contact_cells)\n        for contact in contact_cells[:CONTACT_CANDIDATE_LIMIT]:\n            inp_coords = _coords_from_contact(obj_cells, contact, rng)\n            if not _coords_in_bounds(N, inp_coords):\n                continue\n\n            inp_set = set(inp_coords)\n            if inp_set & input_occupied:\n                continue\n            if inp_set & reserved_swept:\n                continue\n            if _touching_maroon_sides(inp_coords, all_maroon) != {(-dr, -dc)}:\n                continue\n\n            steps = _gen_steps_to_edge(N, inp_coords, direction)\n            if steps > PUSH_DISTANCE_MAX:\n                continue\n            if steps == 0 and zero_step_budget <= 0:\n                continue\n\n            out_coords = _translated_coords(inp_coords, direction, steps)\n            swept = _swept_cells(N, inp_coords, direction)\n            if swept & input_occupied:\n                continue\n            if not all(output[r, c] == BG for r, c in out_coords):\n                continue\n\n            _paint_cells(output, out_coords, color)\n            input_occupied.update(inp_set)\n            reserved_swept.update(swept)\n            if steps == 0:\n                zero_step_budget -= 1\n            return (color, inp_coords, out_coords, direction), zero_step_budget\n\n    return None, zero_step_budget\n\n\ndef _build_objects(rng, grid, all_maroon, chosen_slots):\n    \"\"\"Place edge-output objects and retain their derived input coordinates.\"\"\"\n    N = grid.shape[0]\n    output = grid.copy()\n    used_colors = set()\n    objects = []\n    input_occupied = set(all_maroon)\n    reserved_swept = set()\n    zero_step_budget = ZERO_STEP_ALLOWANCE if rng.random() < ZERO_STEP_PROBABILITY else 0\n\n    for slot in chosen_slots:\n        if len(used_colors) >= len(ALL_COLORS):\n            break\n        color = _pick_unused_color(rng, used_colors)\n        placed, zero_step_budget = _try_place_object(\n            rng,\n            N,\n            slot,\n            output,\n            input_occupied,\n            reserved_swept,\n            all_maroon,\n            color,\n            zero_step_budget,\n        )\n        if placed is not None:\n            objects.append(placed)\n\n    if len(objects) < OBJECT_COUNT_MIN or len(objects) > OBJECT_COUNT_MAX:\n        return None\n    return output, objects\n\n\ndef _build_input_grid(grid, objects):\n    inp = grid.copy()\n    for color, inp_coords, _, _ in objects:\n        if not all(inp[r, c] == BG for r, c in inp_coords):\n            return None\n        _paint_cells(inp, inp_coords, color)\n    return inp\n\n\ndef _solver_matches_output(inp, output):\n    try:\n        return np.array_equal(main(inp), output)\n    except Exception:\n        return False\n\n\ndef _gen_attempt():\n    rng = random.Random()\n    N = rng.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    grid = np.full((N, N), BG, dtype=int)\n\n    num_maroon = rng.randint(MAROON_COMPONENT_MIN, MAROON_COMPONENT_MAX)\n    placed_markers = _place_maroon_components(rng, grid, num_maroon)\n    if placed_markers is None:\n        return None\n    maroon_components, all_maroon = placed_markers\n\n    slots = _available_slots(N, maroon_components, all_maroon)\n    chosen_slots = _choose_object_slots(rng, slots)\n    if chosen_slots is None:\n        return None\n\n    built = _build_objects(rng, grid, all_maroon, chosen_slots)\n    if built is None:\n        return None\n    output, objects = built\n\n    inp = _build_input_grid(grid, objects)\n    if inp is None:\n        return None\n    if not _paths_are_clear(inp, objects):\n        return None\n    if not _solver_matches_output(inp, output):\n        return None\n\n    return inp\n\n\ndef generate_input():\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/9b5080bb.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/9b5080bb.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor the small defect bars on each shared-color object with the opposite panel color.\n\n    Input structure\n    - The grid contains two large panel colors and one shared object color.\n    - Each shared-color object is a mostly solid rectangle inside exactly one panel.\n    Rule\n    - Find the near-solid rectangular core of each object.\n    - Missing core pixels and one-cell protrusions define two-pixel bars perpendicular to the nearest core edge.\n    - Recolor those bars with the other panel color; leave all other pixels unchanged.\n    Key insight\n    - The colors to add are not tied to numeric ids: each object's surrounding panel identifies the opposite panel color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = g.copy()\n\n    object_color, components, panel_colors = _object_components(g)\n    for coords in components:\n        neighbors = _neighbor_colors(g, coords, object_color)\n        assert len(neighbors) == 1\n        panel_color = next(iter(neighbors))\n        target_colors = panel_colors - {panel_color}\n        assert len(target_colors) == 1\n        target_color = next(iter(target_colors))\n\n        rect = _core_rect(coords)\n        for r, c in _defect_bar_cells(coords, rect):\n            assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1]\n            assert int(g[r, c]) in {object_color, panel_color}\n            out[r, c] = target_color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Palette and canvas bounds.\nCOLOR_IDS = list(range(10))\nGRID_SIZE_MIN = 20\nGRID_SIZE_MAX = 27\n\n# Panel layout bounds and options.\nMIN_PANEL_DIM = 9\nMIN_VISIBLE_BORDERS = 2\nBORDER_CHOICES = (0, 1)\nOFFSET_MIN = 2\nOFFSET_MAX = 6\nHORIZONTAL_LAYOUT = 0\nVERTICAL_LAYOUT = 1\nHORIZONTAL_OFFSETS = (\"left\", \"right\", \"none\")\nVERTICAL_OFFSETS = (\"top\", \"bottom\", \"none\")\n\n# Object geometry and placement constraints.\nOBJECTS_PER_PANEL = (1, 2)\nCORE_H_MIN = 3\nCORE_H_MAX = 7\nCORE_W_MIN = 3\nCORE_W_MAX = 9\nDEFECT_COUNT_MIN = 1\nDEFECT_COUNT_MAX = 3\nDEFECT_SIDES = (\"top\", \"bottom\", \"left\", \"right\")\nDEFECT_TYPES = (\"missing\", \"protrusion\")\nPANEL_MARGIN = 1\nOBJECT_GAP = 2\nMAX_PLACE_TRIES = 30\n\n# Generation retry budget.\nMAX_GENERATE_ATTEMPTS = 300\n\n\ndef _choose_palette() -> tuple[int, int, int, int]:\n    colors = COLOR_IDS[:]\n    random.shuffle(colors)\n    return tuple(colors[:4])\n\n\ndef _choose_borders() -> tuple[int, int, int, int]:\n    borders = [random.choice(BORDER_CHOICES) for _ in range(4)]\n    while sum(borders) < MIN_VISIBLE_BORDERS:\n        borders[random.randint(0, 3)] = 1\n    return tuple(borders)\n\n\ndef _build_horizontal_panels(\n    grid: np.ndarray,\n    panel_a_color: int,\n    panel_b_color: int,\n) -> list[tuple[int, int, int, int, int]] | None:\n    \"\"\"Create two panels sharing a horizontal border; returns panel records.\"\"\"\n    H, W = grid.shape\n    split_r = random.randint(MIN_PANEL_DIM, H - MIN_PANEL_DIM - 1)\n    border_top, border_bot, border_left, border_right = _choose_borders()\n\n    pa_height = split_r - border_top\n    pb_height = H - border_bot - split_r\n    if pa_height < MIN_PANEL_DIM or pb_height < MIN_PANEL_DIM:\n        return None\n\n    offset_side = random.choice(HORIZONTAL_OFFSETS)\n    if offset_side == \"none\":\n        pa_c0, pa_c1 = border_left, W - 1 - border_right\n        pb_c0, pb_c1 = border_left, W - 1 - border_right\n    elif offset_side == \"left\":\n        offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_c0 = border_left\n            pa_c1 = W - 1 - border_right\n            pb_c0 = border_left + offset_cols\n            pb_c1 = W - 1 - border_right\n        else:\n            pa_c0 = border_left + offset_cols\n            pa_c1 = W - 1 - border_right\n            pb_c0 = border_left\n            pb_c1 = W - 1 - border_right\n    else:\n        offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_c0 = border_left\n            pa_c1 = W - 1 - border_right - offset_cols\n            pb_c0 = border_left\n            pb_c1 = W - 1 - border_right\n        else:\n            pa_c0 = border_left\n            pa_c1 = W - 1 - border_right\n            pb_c0 = border_left\n            pb_c1 = W - 1 - border_right - offset_cols\n\n    if pa_c1 - pa_c0 + 1 < MIN_PANEL_DIM or pb_c1 - pb_c0 + 1 < MIN_PANEL_DIM:\n        return None\n    if min(pa_c1, pb_c1) < max(pa_c0, pb_c0):\n        return None\n\n    pa_r0, pa_r1 = border_top, split_r - 1\n    pb_r0, pb_r1 = split_r, H - 1 - border_bot\n    grid[pa_r0:pa_r1 + 1, pa_c0:pa_c1 + 1] = panel_a_color\n    grid[pb_r0:pb_r1 + 1, pb_c0:pb_c1 + 1] = panel_b_color\n    return [\n        (panel_a_color, pa_r0, pa_r1, pa_c0, pa_c1),\n        (panel_b_color, pb_r0, pb_r1, pb_c0, pb_c1),\n    ]\n\n\ndef _build_vertical_panels(\n    grid: np.ndarray,\n    panel_a_color: int,\n    panel_b_color: int,\n) -> list[tuple[int, int, int, int, int]] | None:\n    \"\"\"Create two panels sharing a vertical border; returns panel records.\"\"\"\n    H, W = grid.shape\n    split_c = random.randint(MIN_PANEL_DIM, W - MIN_PANEL_DIM - 1)\n    border_top, border_bot, border_left, border_right = _choose_borders()\n\n    pa_width = split_c - border_left\n    pb_width = W - border_right - split_c\n    if pa_width < MIN_PANEL_DIM or pb_width < MIN_PANEL_DIM:\n        return None\n\n    offset_side = random.choice(VERTICAL_OFFSETS)\n    if offset_side == \"none\":\n        pa_r0, pa_r1 = border_top, H - 1 - border_bot\n        pb_r0, pb_r1 = border_top, H - 1 - border_bot\n    elif offset_side == \"top\":\n        offset_rows = random.randint(OFFSET_MIN, min(OFFSET_MAX, H - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_r0, pa_r1 = border_top, H - 1 - border_bot\n            pb_r0, pb_r1 = border_top + offset_rows, H - 1 - border_bot\n        else:\n            pa_r0, pa_r1 = border_top + offset_rows, H - 1 - border_bot\n            pb_r0, pb_r1 = border_top, H - 1 - border_bot\n    else:\n        offset_rows = random.randint(OFFSET_MIN, min(OFFSET_MAX, H - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_r0, pa_r1 = border_top, H - 1 - border_bot - offset_rows\n            pb_r0, pb_r1 = border_top, H - 1 - border_bot\n        else:\n            pa_r0, pa_r1 = border_top, H - 1 - border_bot\n            pb_r0, pb_r1 = border_top, H - 1 - border_bot - offset_rows\n\n    pa_c0, pa_c1 = border_left, split_c - 1\n    pb_c0, pb_c1 = split_c, W - 1 - border_right\n    if pa_r1 - pa_r0 + 1 < MIN_PANEL_DIM or pb_r1 - pb_r0 + 1 < MIN_PANEL_DIM:\n        return None\n    if min(pa_r1, pb_r1) < max(pa_r0, pb_r0):\n        return None\n\n    grid[pa_r0:pa_r1 + 1, pa_c0:pa_c1 + 1] = panel_a_color\n    grid[pb_r0:pb_r1 + 1, pb_c0:pb_c1 + 1] = panel_b_color\n    return [\n        (panel_a_color, pa_r0, pa_r1, pa_c0, pa_c1),\n        (panel_b_color, pb_r0, pb_r1, pb_c0, pb_c1),\n    ]\n\n\ndef _make_panel_grid(\n    panel_a_color: int,\n    panel_b_color: int,\n    bg_color: int,\n) -> tuple[np.ndarray, list[tuple[int, int, int, int, int]]] | None:\n    \"\"\"Sample the canvas and panel layout.\"\"\"\n    H = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    W = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    grid = np.full((H, W), bg_color, dtype=int)\n\n    orientation = random.randint(HORIZONTAL_LAYOUT, VERTICAL_LAYOUT)\n    if orientation == HORIZONTAL_LAYOUT:\n        panels = _build_horizontal_panels(grid, panel_a_color, panel_b_color)\n    else:\n        panels = _build_vertical_panels(grid, panel_a_color, panel_b_color)\n    if panels is None:\n        return None\n    return grid, panels\n\n\ndef _object_overlaps(full_bbox: tuple[int, int, int, int], placed_bboxes: list[tuple[int, int, int, int]]) -> bool:\n    full_r0, full_r1, full_c0, full_c1 = full_bbox\n    for br0, br1, bc0, bc1 in placed_bboxes:\n        if (\n            full_r0 - OBJECT_GAP <= br1\n            and full_r1 + OBJECT_GAP >= br0\n            and full_c0 - OBJECT_GAP <= bc1\n            and full_c1 + OBJECT_GAP >= bc0\n        ):\n            return True\n    return False\n\n\ndef _place_core(\n    panel_bbox: tuple[int, int, int, int],\n    core_h: int,\n    core_w: int,\n    sides: list[str],\n    placed_bboxes: list[tuple[int, int, int, int]],\n) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int]] | None:\n    \"\"\"Find a non-overlapping core bbox and its full bbox including bars.\"\"\"\n    pr0, pr1, pc0, pc1 = panel_bbox\n    extra_top = 1 if \"top\" in sides else 0\n    extra_bot = 1 if \"bottom\" in sides else 0\n    extra_left = 1 if \"left\" in sides else 0\n    extra_right = 1 if \"right\" in sides else 0\n\n    place_r0 = pr0 + PANEL_MARGIN + extra_top\n    place_r1 = pr1 - PANEL_MARGIN - extra_bot - core_h + 1\n    place_c0 = pc0 + PANEL_MARGIN + extra_left\n    place_c1 = pc1 - PANEL_MARGIN - extra_right - core_w + 1\n    if place_r1 < place_r0 or place_c1 < place_c0:\n        return None\n\n    for _ in range(MAX_PLACE_TRIES):\n        cr0 = random.randint(place_r0, place_r1)\n        cc0 = random.randint(place_c0, place_c1)\n        cr1 = cr0 + core_h - 1\n        cc1 = cc0 + core_w - 1\n        full_bbox = (cr0 - extra_top, cr1 + extra_bot, cc0 - extra_left, cc1 + extra_right)\n        if not _object_overlaps(full_bbox, placed_bboxes):\n            return (cr0, cr1, cc0, cc1), full_bbox\n    return None\n\n\ndef _apply_defect(\n    input_grid: np.ndarray,\n    output_grid: np.ndarray,\n    core_bbox: tuple[int, int, int, int],\n    side: str,\n    defect_type: str,\n    panel_color: int,\n    obj_color: int,\n    other_panel_color: int,\n) -> bool:\n    \"\"\"Apply one sampled input defect and its two-cell output bar.\"\"\"\n    cr0, cr1, cc0, cc1 = core_bbox\n    if side == \"top\":\n        if defect_type == \"missing\":\n            valid_cols = list(range(cc0 + 1, cc1))\n            if not valid_cols:\n                return False\n            dc = random.choice(valid_cols)\n            dr = cr0\n            input_grid[dr, dc] = panel_color\n            output_grid[dr - 1, dc] = other_panel_color\n            output_grid[dr, dc] = other_panel_color\n        else:\n            dc = random.randint(cc0, cc1)\n            dr = cr0 - 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr + 1, dc] = other_panel_color\n    elif side == \"bottom\":\n        if defect_type == \"missing\":\n            valid_cols = list(range(cc0 + 1, cc1))\n            if not valid_cols:\n                return False\n            dc = random.choice(valid_cols)\n            dr = cr1\n            input_grid[dr, dc] = panel_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr + 1, dc] = other_panel_color\n        else:\n            dc = random.randint(cc0, cc1)\n            dr = cr1 + 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr - 1, dc] = other_panel_color\n    elif side == \"left\":\n        if defect_type == \"missing\":\n            valid_rows = list(range(cr0 + 1, cr1))\n            if not valid_rows:\n                return False\n            dr = random.choice(valid_rows)\n            dc = cc0\n            input_grid[dr, dc] = panel_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc - 1] = other_panel_color\n        else:\n            dr = random.randint(cr0, cr1)\n            dc = cc0 - 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc + 1] = other_panel_color\n    else:\n        if defect_type == \"missing\":\n            valid_rows = list(range(cr0 + 1, cr1))\n            if not valid_rows:\n                return False\n            dr = random.choice(valid_rows)\n            dc = cc1\n            input_grid[dr, dc] = panel_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc + 1] = other_panel_color\n        else:\n            dr = random.randint(cr0, cr1)\n            dc = cc1 + 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc - 1] = other_panel_color\n    return True\n\n\ndef _place_panel_objects(\n    input_grid: np.ndarray,\n    output_grid: np.ndarray,\n    panel: tuple[int, int, int, int, int],\n    n_objs: int,\n    obj_color: int,\n    other_panel_color: int,\n) -> bool:\n    \"\"\"Place all objects for one panel into input and output grids.\"\"\"\n    panel_color, pr0, pr1, pc0, pc1 = panel\n    avail_r0 = pr0 + PANEL_MARGIN\n    avail_r1 = pr1 - PANEL_MARGIN\n    avail_c0 = pc0 + PANEL_MARGIN\n    avail_c1 = pc1 - PANEL_MARGIN\n    placed_bboxes = []\n\n    for _ in range(n_objs):\n        core_h = random.randint(CORE_H_MIN, min(CORE_H_MAX, avail_r1 - avail_r0 - 2))\n        core_w = random.randint(CORE_W_MIN, min(CORE_W_MAX, avail_c1 - avail_c0 - 2))\n        if core_h < CORE_H_MIN or core_w < CORE_W_MIN:\n            return False\n\n        n_defects = random.randint(DEFECT_COUNT_MIN, DEFECT_COUNT_MAX)\n        sides = random.sample(DEFECT_SIDES, n_defects)\n        defect_types = [random.choice(DEFECT_TYPES) for _ in range(n_defects)]\n\n        placed = _place_core((pr0, pr1, pc0, pc1), core_h, core_w, sides, placed_bboxes)\n        if placed is None:\n            return False\n        core_bbox, full_bbox = placed\n        placed_bboxes.append(full_bbox)\n\n        cr0, cr1, cc0, cc1 = core_bbox\n        output_grid[cr0:cr1 + 1, cc0:cc1 + 1] = obj_color\n        input_grid[cr0:cr1 + 1, cc0:cc1 + 1] = obj_color\n\n        for side, defect_type in zip(sides, defect_types):\n            if not _apply_defect(\n                input_grid,\n                output_grid,\n                core_bbox,\n                side,\n                defect_type,\n                panel_color,\n                obj_color,\n                other_panel_color,\n            ):\n                return False\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    obj_color, panel_a_color, panel_b_color, bg_color = _choose_palette()\n    layout = _make_panel_grid(panel_a_color, panel_b_color, bg_color)\n    if layout is None:\n        return None\n    grid, panels = layout\n\n    n_obj_a = random.choice(OBJECTS_PER_PANEL)\n    n_obj_b = random.choice(OBJECTS_PER_PANEL)\n    if not 2 <= n_obj_a + n_obj_b <= 4:\n        return None\n\n    output_grid = grid.copy()\n    input_grid = grid.copy()\n    object_counts = (n_obj_a, n_obj_b)\n    other_colors = (panel_b_color, panel_a_color)\n\n    for panel, n_objs, other_panel_color in zip(panels, object_counts, other_colors):\n        if not _place_panel_objects(\n            input_grid,\n            output_grid,\n            panel,\n            n_objs,\n            obj_color,\n            other_panel_color,\n        ):\n            return None\n\n    # Verify: run solver on input and check it produces the output\n    try:\n        result = main(input_grid)\n        if np.array_equal(result, output_grid):\n            return input_grid\n    except (AssertionError, IndexError, ValueError):\n        pass\n\n    return None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
