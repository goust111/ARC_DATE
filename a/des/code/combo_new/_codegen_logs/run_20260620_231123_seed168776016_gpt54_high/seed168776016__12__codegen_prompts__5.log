{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/6165ea8f.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords, colors_present, find_components, get_bg, paste, random_free_location\nimport random\n\n\ndef _tight_mask(mask: np.ndarray) -> np.ndarray:\n    coords = np.argwhere(mask)\n    assert coords.size, \"expected a nonempty mask\"\n    r0, c0, r1, c1 = bbox_coords(coords)\n    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)\n\n\ndef _mask_key(mask: np.ndarray) -> tuple[str, ...]:\n    return tuple(\"\".join(\"1\" if cell else \"0\" for cell in row) for row in mask)\n\n\ndef _shape_signature(mask: np.ndarray) -> tuple[str, ...]:\n    base = _tight_mask(mask)\n    variants = []\n    for k in range(4):\n        rotated = np.rot90(base, k)\n        variants.append(_mask_key(_tight_mask(rotated)))\n        variants.append(_mask_key(_tight_mask(np.fliplr(rotated))))\n    return min(variants)\n\n\ndef _legend_order(g: np.ndarray, bg: int) -> list[int]:\n    labels: list[tuple[int, int]] = []\n    W = g.shape[1]\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, min_area=1):\n        if int(comp[\"area\"]) != 1:\n            continue\n        r, c = map(int, comp[\"coords\"][0])\n        if c == W - 1:\n            labels.append((r, int(comp[\"color\"])))\n\n    labels.sort()\n    assert labels, \"expected a right-edge color legend\"\n    assert [r for r, _color in labels] == list(range(len(labels))), \"legend must start at the top edge\"\n\n    order = [color for _r, color in labels]\n    assert len(order) == len(set(order)), \"legend colors must be unique\"\n    assert set(order) == set(colors_present(g, exclude={bg})), \"legend must list every foreground color\"\n    return order\n\n\ndef _main_object_mask(g: np.ndarray, bg: int, color: int) -> np.ndarray:\n    comps = find_components(\n        g,\n        bg=bg,\n        connectivity=4,\n        monochromatic=True,\n        colors=[color],\n        min_area=1,\n    )\n    main = [comp for comp in comps if int(comp[\"area\"]) > 1]\n    label = [\n        comp\n        for comp in comps\n        if int(comp[\"area\"]) == 1 and int(comp[\"coords\"][0][1]) == g.shape[1] - 1\n    ]\n    assert len(main) == 1, \"expected exactly one main object for each legend color\"\n    assert len(label) == 1, \"expected exactly one right-edge singleton label for each legend color\"\n    assert len(comps) == 2, \"each legend color should appear only as one object and one label\"\n\n    r0, c0, r1, c1 = main[0][\"bbox\"]\n    return g[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(color)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Build a color-labeled shape-equivalence table from the objects listed on the right edge.\n\n    Input structure:\n    - The background contains one main 4-connected object for each foreground color.\n    - The rightmost column has one singleton pixel of each foreground color, listed top-to-bottom.\n    - Those singleton pixels define the row and column order of the output table.\n\n    Rule:\n    - Normalize each main object to its tight mask and compare masks up to rotation or reflection.\n    - Draw 2x2 color labels across the top and down the left, separated by one background row/column.\n    - For each off-diagonal table cell, paint a 2x2 red block when the two labeled objects have the same shape under rotation/reflection, otherwise paint a 2x2 grey block.\n    - Leave diagonal cells and all separators as background.\n\n    Key insight:\n    - Object positions and original orientations are distractors; the relation is dihedral shape equivalence, while the right-edge legend fixes the table order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    order = _legend_order(g, bg)\n    signatures = {color: _shape_signature(_main_object_mask(g, bg, color)) for color in order}\n\n    n = len(order)\n    out = np.full((3 * n + 2, 3 * n + 2), int(bg), dtype=int)\n\n    for i, color in enumerate(order):\n        band = 3 + 3 * i\n        out[0:2, band : band + 2] = int(color)\n        out[band : band + 2, 0:2] = int(color)\n\n    for i, row_color in enumerate(order):\n        for j, col_color in enumerate(order):\n            if i == j:\n                continue\n            cell_color = Color.RED if signatures[row_color] == signatures[col_color] else Color.GREY\n            r = 3 + 3 * i\n            c = 3 + 3 * j\n            out[r : r + 2, c : c + 2] = int(cell_color)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and object bounds.\nGEN_OBJECT_COUNT_RANGE, GEN_GRID_ROW_RANGE, GEN_GRID_COL_RANGE = (4, 7), (20, 25), (20, 23)\nGEN_OBJECT_AREA_RANGE, GEN_OBJECT_BBOX_RANGE, GEN_OBJECT_MAX_EXTRA_CELLS = (5, 13), (2, 7), 4\n# Shape-class sampling.\nGEN_CLASS_OPTIONS, GEN_MAX_CLASS_SIZE, GEN_UNIQUE_MASK_RETRIES = (2, 3), 3, 80\nGEN_DIHEDRAL_FLIP_PROB = 0.5\n# Output table layout and colors.\nGEN_OBJECT_COLORS, GEN_TABLE_BLOCK, GEN_TABLE_STEP = [1, 3, 4, 6, 7, 8, 9], 2, 3\nGEN_SAME_SHAPE_COLOR, GEN_DIFFERENT_SHAPE_COLOR = int(Color.RED), int(Color.GREY)\n# Input placement and retry limits.\nGEN_RESERVED_RIGHT_COLS, GEN_ATTEMPTS = 2, 300\nGEN_PLACEMENT_BORDER, GEN_PLACEMENT_PADDING, GEN_PLACEMENT_CONNECTIVITY = 1, 2, 4\nGEN_NEIGHBORS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _gen_tight_mask(mask: np.ndarray) -> np.ndarray:\n    coords = np.argwhere(mask)\n    r0, c0, r1, c1 = bbox_coords(coords)\n    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)\n\n\ndef _gen_mask_key(mask: np.ndarray) -> tuple[str, ...]:\n    return tuple(\"\".join(\"1\" if cell else \"0\" for cell in row) for row in mask)\n\n\ndef _gen_shape_signature(mask: np.ndarray) -> tuple[str, ...]:\n    base = _gen_tight_mask(mask)\n    variants = []\n    for k in range(4):\n        rotated = np.rot90(base, k)\n        variants.append(_gen_mask_key(_gen_tight_mask(rotated)))\n        variants.append(_gen_mask_key(_gen_tight_mask(np.fliplr(rotated))))\n    return min(variants)\n\n\ndef _has_hole(mask: np.ndarray) -> bool:\n    bg = ~mask.astype(bool)\n    if not bool(bg.any()):\n        return False\n\n    H, W = bg.shape\n    seen = np.zeros_like(bg, dtype=bool)\n    stack: list[tuple[int, int]] = []\n    for r in range(H):\n        for c in (0, W - 1):\n            if bg[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                stack.append((r, c))\n    for c in range(W):\n        for r in (0, H - 1):\n            if bg[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                stack.append((r, c))\n\n    while stack:\n        r, c = stack.pop()\n        for dr, dc in GEN_NEIGHBORS_4:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and bg[nr, nc] and not seen[nr, nc]:\n                seen[nr, nc] = True\n                stack.append((nr, nc))\n    return bool((bg & ~seen).any())\n\n\ndef _random_corner_path(h: int, w: int) -> np.ndarray:\n    starts = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]\n    sr, sc = random.choice(starts)\n    er, ec = h - 1 - sr, w - 1 - sc\n    moves = [(1 if er > sr else -1, 0)] * (h - 1)\n    moves += [(0, 1 if ec > sc else -1)] * (w - 1)\n    random.shuffle(moves)\n\n    mask = np.zeros((h, w), dtype=bool)\n    r, c = sr, sc\n    mask[r, c] = True\n    for dr, dc in moves:\n        r += dr\n        c += dc\n        mask[r, c] = True\n    return mask\n\n\ndef _growth_candidates(mask: np.ndarray) -> list[tuple[int, int]]:\n    h, w = mask.shape\n    choices = []\n    for r in range(h):\n        for c in range(w):\n            if mask[r, c]:\n                continue\n            touches = sum(\n                0 <= r + dr < h and 0 <= c + dc < w and mask[r + dr, c + dc]\n                for dr, dc in GEN_NEIGHBORS_4\n            )\n            if touches != 1:\n                continue\n            trial = mask.copy()\n            trial[r, c] = True\n            if not _has_hole(trial):\n                choices.append((r, c))\n    return choices\n\n\ndef _random_mask() -> np.ndarray | None:\n    area = random.randint(*GEN_OBJECT_AREA_RANGE)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, neighbors4\n\n\ndef _legend_directions(g: np.ndarray, bg: int) -> dict[int, tuple[int, int]]:\n    \"\"\"\n    Detect legend blocks on the border.\n\n    A legend is a border-touching non-background component whose most common color is the legend\n    background `C` (and also the region border color it controls). The legend contains at least\n    two additional colors: a \"center\" color (more frequent) and an \"indicator\" color (less frequent).\n\n    The movement direction for regions with border color `C` is:\n      sign(centroid(indicator) - centroid(center))\n    \"\"\"\n    h, w = g.shape\n    non_bg = g != bg\n    best: dict[int, tuple[int, tuple[int, int]]] = {}\n    for pts in components_mask(non_bg, connectivity=4):\n        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue\n        # Legends are filled rectangles on the border.\n        r0, c0, r1, c1 = bbox_coords(pts)\n        area = (r1 - r0 + 1) * (c1 - c0 + 1)\n        if area != len(pts):\n            continue\n\n        counts: dict[int, int] = {}\n        for r, c in pts:\n            v = int(g[r, c])\n            counts[v] = counts.get(v, 0) + 1\n        if len(counts) != 3:\n            continue\n\n        bg_col = max(counts, key=counts.get)\n        others = [(cnt, col) for col, cnt in counts.items() if col != bg_col]\n        if len(others) < 2:\n            continue\n        others.sort()  # ascending by count\n        if others[0][0] == others[1][0]:\n            # Tie: choose center as the color closer to the rectangle center.\n            rc = np.array([(r0 + r1) / 2.0, (c0 + c1) / 2.0])\n            cols = [others[0][1], others[1][1]]\n            cents = []\n            for col in cols:\n                pts_col = np.array([(r, c) for r, c in pts if int(g[r, c]) == col], dtype=float)\n                cents.append((np.sum((pts_col.mean(axis=0) - rc) ** 2), col))\n            cents.sort()\n            center_col = cents[0][1]\n            indicator_col = cents[1][1]\n        else:\n            indicator_col = others[0][1]\n            center_col = others[-1][1]\n\n        center = [(r, c) for r, c in pts if int(g[r, c]) == center_col]\n        indic = [(r, c) for r, c in pts if int(g[r, c]) == indicator_col]\n        if not center or not indic:\n            continue\n\n        cc = np.mean(np.array(center, dtype=float), axis=0)\n        ci = np.mean(np.array(indic, dtype=float), axis=0)\n        vr, vc = (ci - cc).tolist()\n        dr = 0 if abs(vr) < 1e-6 else (1 if vr > 0 else -1)\n        dc = 0 if abs(vc) < 1e-6 else (1 if vc > 0 else -1)\n        if dr == 0 and dc == 0:\n            continue\n\n        prev = best.get(bg_col)\n        if prev is None or len(pts) > prev[0]:\n            best[bg_col] = (len(pts), (dr, dc))\n\n    return {k: v for k, (_, v) in best.items()}\n\n\ndef _slide_points(region_set: set[tuple[int, int]], points: list[tuple[int, int]], dr: int, dc: int) -> list[tuple[int, int]]:\n    if not points:\n        return []\n    # Process from the far end (closest to destination boundary) inward.\n    points_sorted = sorted(points, key=lambda p: (dr * p[0] + dc * p[1], p[0], p[1]), reverse=True)\n    occupied = set()\n    out_pts = []\n    for r0, c0 in points_sorted:\n        r, c = r0, c0\n        while True:\n            nr, nc = r + dr, c + dc\n            if (nr, nc) not in region_set:\n                break\n            # For diagonal steps, disallow \"corner cutting\": both orthogonal intermediates must be inside the region.\n            if dr != 0 and dc != 0:\n                if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n                    break\n            if (nr, nc) in occupied:\n                break\n            r, c = nr, nc\n        occupied.add((r, c))\n        out_pts.append((r, c))\n    return out_pts\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n","exit_code":0,"status":"completed"}}
