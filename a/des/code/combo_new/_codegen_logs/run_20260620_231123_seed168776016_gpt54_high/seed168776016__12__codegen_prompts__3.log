{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nfrom collections import Counter\nimport numpy as np\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed168776016/12/3.py')\nmod = SourceFileLoader('arc_new_stats', str(p)).load_module()\n\ndef comps(g):\n    h,w=g.shape\n    seen=np.zeros((h,w),dtype=bool)\n    out=[]\n    for r in range(h):\n        for c in range(w):\n            if seen[r,c] or g[r,c]==0:\n                continue\n            color=int(g[r,c])\n            stack=[(r,c)]\n            seen[r,c]=True\n            pts=[]\n            while stack:\n                cr,cc=stack.pop()\n                pts.append((cr,cc))\n                for nr,nc in ((cr-1,cc),(cr+1,cc),(cr,cc-1),(cr,cc+1)):\n                    if 0<=nr<h and 0<=nc<w and not seen[nr,nc] and int(g[nr,nc])==color:\n                        seen[nr,nc]=True\n                        stack.append((nr,nc))\n            out.append((color,pts))\n    return out\n\ndef hole_count(g,color,pts):\n    rows=[r for r,_ in pts]; cols=[c for _,c in pts]\n    r0,r1=min(rows),max(rows); c0,c1=min(cols),max(cols)\n    sub=g[r0:r1+1,c0:c1+1]\n    mask=sub==color\n    bg=sub==0\n    h,w=mask.shape\n    seen=np.zeros((h,w),dtype=bool)\n    count=0\n    for r in range(h):\n        for c in range(w):\n            if seen[r,c] or not bg[r,c]:\n                continue\n            stack=[(r,c)]\n            seen[r,c]=True\n            pts2=[]\n            touch=False\n            while stack:\n                cr,cc=stack.pop()\n                pts2.append((cr,cc))\n                if cr in (0,h-1) or cc in (0,w-1):\n                    touch=True\n                for nr,nc in ((cr-1,cc),(cr+1,cc),(cr,cc-1),(cr,cc+1)):\n                    if 0<=nr<h and 0<=nc<w and not seen[nr,nc] and bg[nr,nc]:\n                        seen[nr,nc]=True\n                        stack.append((nr,nc))\n            if not touch:\n                count += 1\n    return count, ('h' if mask.shape[1] > mask.shape[0] else 'v')\n\nhc=Counter(); oc=Counter(); shapes=[]\nfor _ in range(100):\n    g=mod.generate_input()\n    oc[g.shape]+=1\n    for color,pts in comps(g):\n        n,ori=hole_count(g,color,pts)\n        hc[(n,ori)] += 1\nprint('hole_orientation_counts', dict(sorted(hc.items())))\nprint('sample_shapes', len(oc))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
