{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/8f215267.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count same-color patterns per frame and represent the tally as dots inside.\n\n    Input structure:\n    - bg = most common color.\n    - Hollow rectangular frames in various colors.\n    - Small monochrome pattern sprites scattered outside frames.\n\n    Rule:\n    - Remove all small patterns from the grid.\n    - For each frame of color C, count how many patterns share color C.\n    - Draw that many dots along the frame's center row, spaced by 2, starting from the right.\n\n    Key insight: Frames act as tally displays — scattered same-color patterns are \"absorbed\" and their count is shown as interior dots.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    out = g.copy()\n    bg = int(get_bg(g))\n\n    regions = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n\n    frames: list[dict] = []\n    patterns: list[dict] = []\n    for comp in regions:\n        b = comp[\"bbox\"]\n        h = bbox_h(b)\n        w = bbox_w(b)\n        area = int(comp[\"area\"])\n        is_frame = (h >= 5) and (w >= 5) and (area < (h * w * 0.7))\n        if is_frame:\n            frames.append(comp)\n        else:\n            patterns.append(comp)\n\n    # Remove patterns from output.\n    for p in patterns:\n        for r, c in p[\"coords\"]:\n            out[int(r), int(c)] = bg\n\n    # For each frame, count matching patterns and draw dots.\n    for f in frames:\n        col = int(f[\"color\"])\n        num_patterns = sum(1 for p in patterns if int(p[\"color\"]) == col)\n        if num_patterns <= 0:\n            continue\n\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        r_mid = (r0 + r1) // 2\n        for i in range(int(num_patterns)):\n            cc = int(c1 - 2 - 2 * i)\n            if cc > int(c0):\n                out[int(r_mid), int(cc)] = col\n\n    return out\n\n# --------------- generator (codex-att2) ---------------\n\n# --- layout geometry ---\nFRAME_H = 5                    # frame height (rows)\nFRAME_W = 11                   # frame width (cols)\nFRAME_R0 = 1                   # top-left row of first frame\nFRAME_C0 = 1                   # top-left col of all frames\nFRAME_GAP = 2                  # bg rows between consecutive frames\nGRID_W = 23                    # fixed grid width\nRIGHT_C0 = 13                  # first column of the right (sprite) region\nRIGHT_W = 9                    # width of the right region\n\n# --- structural counts ---\nN_FRAMES_RANGE = (3, 5)        # [lo, hi) for number of frames\nN_DISTRACTORS_RANGE = (1, 3)   # [lo, hi) for distractor sprite count\nTOTAL_PATTERNS_RANGE = (5, 11) # [lo, hi) for total sprite count\nMAX_DOTS_PER_FRAME = 4         # max dot tally inside one frame\nBOTTOM_PAD_RANGE = (0, 7)      # [lo, hi) extra bg rows when n_frames==3\n\n# --- sprite shape ---\nSPRITE_AREA_RANGE = (2, 9)     # [lo, hi) connected-cell count per sprite\nSPRITE_MAX_H = 4               # max bbox height for sprite\nSPRITE_MAX_W = 3               # max bbox width for sprite\nSPRITE_PADDING = 1             # gap between placed sprites\n\n# --- retry budget ---\nMAX_ATTEMPTS = 300\n\n\ndef _frame_patch(color: int, bg: int, n_dots: int) -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/58490d8a.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count colored objects and record tallies inside a legend box.\n\n    Input structure:\n    - A black rectangular legend box with key-color pixels in its leftmost non-black column.\n    - Outside the box, distinct objects of each key color are scattered across the grid.\n\n    Rule:\n    - For each key color, count separate same-colored objects outside the legend box.\n    - Output the legend box repainted: each key row gets one dot per object, spaced every other cell rightward from the key pixel.\n\n    Key insight: The legend is both the color index and the output canvas — object counts become dot sequences on the matching row.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    _bg = int(get_bg(g))\n\n    black = 0\n\n    # STEP 1) Find the legend bbox: largest black CC whose bbox contains some non-black pixels.\n    best = None  # (area, bbox)\n    for coords in components_mask(g == int(black), connectivity=8):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if (sub != int(black)).any():\n            area = int(coords.shape[0])\n            cand = (area, tuple(map(int, b)))\n            if best is None or cand[0] > best[0]:\n                best = cand\n\n    assert not (best is None)\n\n    r0, c0, r1, c1 = map(int, best[1])\n    box = crop_bbox(g, (r0, c0, r1, c1))\n    bh, bw = map(int, box.shape)\n\n    # STEP 2) Inside the legend bbox, find the key column:\n    # leftmost column with any non-black pixels (the \"key pixels\").\n    key_col = None\n    for cc in range(bw):\n        if (box[:, int(cc)] != int(black)).any():\n            key_col = int(cc)\n            break\n    if key_col is None:\n        return np.zeros_like(box)\n\n    keys = [(int(rr), int(box[int(rr), int(key_col)])) for rr in range(bh) if int(box[int(rr), int(key_col)]) != int(black)]\n    keys.sort(key=lambda t: int(t[0]))\n\n    outside = np.ones((H, W), dtype=bool)\n    outside[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = False\n    out = np.zeros((bh, bw), dtype=int)\n\n    # STEP 3/4) Count CCs of each key color outside the legend, then draw 1 dot per CC.\n    for rr, col in keys:\n        mask = (g == int(col)) & outside\n        _labc, nc = label_mask(mask, connectivity=8)\n        for i in range(int(nc)):\n            cc = int(key_col + 2 * i)\n            if 0 <= cc < bw:\n                out[int(rr), int(cc)] = int(col)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette and legend color choices.\nCOLOR_POOL = tuple(range(1, 10))\nBLACK = 0\nDISTRACTOR_PROB = 0.5\n\n# Key rows and tally dimensions.\nKEY_COUNT_RANGE = (2, 4)\nTARGET_COUNT_RANGE = (1, 5)\nKEY_ROW_FIRST = 1\nKEY_ROW_STEP = 2\nKEY_COLUMN = 1\nTALLY_COL_STEP = 2\nLEGEND_HEIGHT_TAIL = 1\nLEGEND_WIDTH_TAIL = 1\nLEGEND_SLACK_RANGE = (0, 3)\n\n# Canvas size and legend placement bounds.\nGRID_HEIGHT_RANGE = (20, 25)\nGRID_WIDTH_RANGE = (20, 25)\nLEGEND_EDGE_MARGIN = 2\n\n# Sprite shape and placement constraints.\nSPRITE_AREA_RANGE = (4, 7)\nSPRITE_BBOXES = ((2, 2), (2, 3), (3, 2), (3, 3))\nSPRITE_CONNECTIVITY = 8\nSPRITE_PADDING = 1\nSPRITE_PADDING_CONNECTIVITY = 8\n\n# Retry budget for rejection sampling.\nGENERATION_ATTEMPTS = 300\n\n\ndef _randint(bounds: tuple[int, int]) -> int:\n","exit_code":0,"status":"completed"}}
