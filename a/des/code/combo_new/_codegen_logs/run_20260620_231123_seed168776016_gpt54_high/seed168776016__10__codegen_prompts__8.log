{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nimport numpy as np\np = '/home/lixinyu/snap/a/des/code/combo_new/seed168776016/10/8.py'\nmod = SourceFileLoader('arc8_dbg', p).load_module()\nrng = np.random.default_rng(0)\nfor attempt in range(1000):\n    colors = list(rng.choice(mod.COLOR_POOL, size=4, replace=False))\n    groups = [mod._make_group(turn_class, color, rng) for turn_class, color in zip((0,1,2,3), colors)]\n    rng.shuffle(groups)\n    top_a, top_b, bot_a, bot_b = groups\n    hgap_top = int(rng.integers(1, 3))\n    hgap_bot = int(rng.integers(1, 3))\n    vgap = int(rng.integers(1, 3))\n    row1_h = max(top_a.shape[0], top_b.shape[0])\n    row2_h = max(bot_a.shape[0], bot_b.shape[0])\n    row1_w = top_a.shape[1] + hgap_top + top_b.shape[1]\n    row2_w = bot_a.shape[1] + hgap_bot + bot_b.shape[1]\n    base_h = row1_h + vgap + row2_h\n    base_w = max(row1_w, row2_w)\n    if base_h > 30 or base_w > 30:\n        continue\n    grid_h = int(rng.integers(base_h, 31))\n    grid_w = int(rng.integers(base_w, 31))\n    grid = np.full((grid_h, grid_w), mod.BG, dtype=int)\n    row1_y = int(rng.integers(0, grid_h - base_h + 1))\n    row2_y = row1_y + row1_h + vgap\n    row1_x = int(rng.integers(0, grid_w - row1_w + 1))\n    row2_x = int(rng.integers(0, grid_w - row2_w + 1))\n    top_a_y = row1_y + int(rng.integers(0, row1_h - top_a.shape[0] + 1))\n    top_b_y = row1_y + int(rng.integers(0, row1_h - top_b.shape[0] + 1))\n    bot_a_y = row2_y + int(rng.integers(0, row2_h - bot_a.shape[0] + 1))\n    bot_b_y = row2_y + int(rng.integers(0, row2_h - bot_b.shape[0] + 1))\n    mod._paste(grid, top_a, top_a_y, row1_x)\n    mod._paste(grid, top_b, top_b_y, row1_x + top_a.shape[1] + hgap_top)\n    mod._paste(grid, bot_a, bot_a_y, row2_x)\n    mod._paste(grid, bot_b, bot_b_y, row2_x + bot_a.shape[1] + hgap_bot)\n    recs = mod._find_receivers(grid, mod.BG, mod.GREY)\n    bad = []\n    for rec in recs:\n        try:\n            mod._find_attachment(grid, mod.GREY, rec['frame_bbox'])\n        except Exception as e:\n            bad.append((rec['frame_bbox'], str(e)))\n    if bad:\n        print('attempt', attempt, 'shape', grid.shape)\n        print('bad', bad)\n        print(grid)\n        break\nelse:\n    print('no failures')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
