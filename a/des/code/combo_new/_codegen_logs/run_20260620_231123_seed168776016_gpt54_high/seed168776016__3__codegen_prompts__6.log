{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main'\"\\\\|\"'^def generate_input'\"\\\\|\"'^    '\"\\\\\\\"\\\\\\\"\\\\\\\"/,+220p' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\ndef _in_bounds(h, w, r, c):\n    return 0 <= r < h and 0 <= c < w\n\n\n# ---------------------------------------------------------------------------\n# Frame geometry\n# ---------------------------------------------------------------------------\n\ndef _frame_ring_coords(r0, c0, ch, cw):\n    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n\n    Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).\n    Ring = bbox boundary minus 4 corners.\n    \"\"\"\n    H, W = ch + 2, cw + 2\n    ring = []\n    for dr in range(H):\n        for dc in range(W):\n            on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)\n            corner = (dr in (0, H - 1)) and (dc in (0, W - 1))\n            if on_bdr and not corner:\n                ring.append((r0 + dr, c0 + dc))\n    cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]\n    return ring, cavity\n\n\ndef _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n\n    Returns True if: ring and cavity cells are empty, no cavity cell is\n    8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and\n    at least one ring cell is 8-adjacent to a line_col pixel.\n    \"\"\"\n    # Ring and cavity cells must all be empty\n    for rr, cc in ring:\n        if canvas[rr, cc] != -1:\n            return False\n    for rr, cc in cavity:\n        if canvas[rr, cc] != -1:\n            return False\n\n    # No cavity cell may be 8-adjacent to any line_col pixel\n    for cr, cc in cavity:\n        for nr, nc in neighbors8(cr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return False\n\n    # Ring must not be 8-adjacent to any non-bg, non-line_col pixel\n    ring_set = set(ring)\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:\n                continue\n            v = canvas[nr, nc]\n            if v != -1 and v != line_col:\n                return False\n\n    # At least one ring cell must be 8-adjacent to a line_col pixel\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return True\n    return False\n\n\n# ---------------------------------------------------------------------------\n# Line growth\n# ---------------------------------------------------------------------------\n\ndef _grow_line(grid, start, line_col, target_len, rng):\n    \"\"\"Grow a meandering 8-connected 1px-wide path of line_col from start.\"\"\"\n    h, w = grid.shape\n    path = [start]\n    dr_bias = 1 if start[0] < h // 2 else -1\n    dc_bias = 1 if start[1] < w // 2 else -1\n    cur = start\n    path_set = {start}\n    while len(path) < target_len:\n        # Build weighted direction list: diagonals preferred, bias-aligned boosted\n        dirs = []\n        for ddr, ddc in DIAG_DIRS:\n            aligned = (ddr == dr_bias or ddc == dc_bias)\n            w_d = DIAG_WEIGHT_ALIGNED if aligned else DIAG_WEIGHT_OTHER\n            dirs.extend([(ddr, ddc)] * w_d)\n        for ddr, ddc in ORTHO_DIRS:\n            aligned = (ddr == dr_bias and ddc == 0) or (ddc == dc_bias and ddr == 0)\n            w_d = ORTHO_WEIGHT_ALIGNED if aligned else ORTHO_WEIGHT_OTHER\n    \"\"\"Compute offsets around a frame bbox that lie outside it (the halo).\"\"\"\n    return [(dr, dc) for dr in range(-1, fh + 1) for dc in range(-1, fw + 1)\n            if not (0 <= dr < fh and 0 <= dc < fw)]\n\n\ndef _try_attach_frame(canvas, line_path, line_col, frame_col, rng, max_tries=FRAME_ATTACH_TRIES):\n    \"\"\"Try to place a frame loop 8-adjacent to some line pixel.\n\n    canvas is modified in place; returns (ring, cavity) or None on failure.\n    \"\"\"\n    h, w = canvas.shape\n    pad = FRAME_PLACEMENT_PAD\n    for _ in range(max_tries):\n        ch = rng.choice(CAVITY_SIZE_WEIGHTS)\n        cw = rng.choice(CAVITY_SIZE_WEIGHTS)\n        lp = rng.choice(line_path)\n        fh, fw = ch + 2, cw + 2\n        offsets = _halo_offsets(fh, fw)\n        rng.shuffle(offsets)\n        for dr, dc in offsets:\n            r0 = lp[0] - dr\n            c0 = lp[1] - dc\n            if r0 < pad or c0 < pad or r0 + fh > h - pad or c0 + fw > w - pad:\n                continue\n            ring, cavity = _frame_ring_coords(r0, c0, ch, cw)\n            if not _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n                continue\n            for rr, cc in ring:\n                canvas[rr, cc] = frame_col\n            return ring, cavity\n    return None\n\n\ndef _try_attach_distractor_frame(canvas, frame_col, rng, max_tries=DISTRACTOR_FRAME_TRIES):\n    \"\"\"Place a loop in empty space, not touching any non-bg pixel.\"\"\"\n    h, w = canvas.shape\n    for _ in range(max_tries):\n        ch = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\n        cw = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\n        fh, fw = ch + 2, cw + 2\n        r0 = rng.randint(1, h - fh - 1)\n        c0 = rng.randint(1, w - fw - 1)\n        # Check the full bbox + 1-cell margin is empty\n        ok = True\n        for rr in range(r0 - 1, r0 + fh + 1):\n            for cc in range(c0 - 1, c0 + fw + 1):\n                if _in_bounds(h, w, rr, cc) and canvas[rr, cc] != -1:\n                    ok = False\n                    break\n            if not ok:\n                break\n        if not ok:\n            continue\n        ring, _ = _frame_ring_coords(r0, c0, ch, cw)\n        for rr, cc in ring:\n            canvas[rr, cc] = frame_col\n        return True\n    return None\n\n\ndef _try_place_distractor_network(canvas, line_col, frame_colors_pool, rng):\n    \"\"\"Place a disconnected line+frame distractor (no seed).\"\"\"\n    h, w = canvas.shape\n    for _ in range(DISTRACTOR_NETWORK_TRIES):\n        r = rng.randint(2, h - 3)\n        c = rng.randint(2, w - 3)\n        if any(canvas[r + dr, c + dc] != -1 for dr in range(-1, 2) for dc in range(-1, 2)):\n            continue\n        canvas[r, c] = line_col\n        target_len = rng.randint(*DISTRACTOR_LINE_LEN)\n        path = _grow_line(canvas, (r, c), line_col, target_len, rng)\n        if len(path) < 3:\n            for pr, pc in path:\n                canvas[pr, pc] = -1\n            continue\n        attached = 0\n        for _ in range(rng.randint(*DISTRACTOR_NETWORK_FRAMES)):\n            fc = rng.choice(frame_colors_pool)\n            if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\n                attached += 1\n        if attached > 0:\n            return True\n        for pr, pc in path:\n            canvas[pr, pc] = -1\n    return False\n\n\n# ---------------------------------------------------------------------------\n# Main generator\n# ---------------------------------------------------------------------------\n\ndef _corner_config(corner_kind, h, w, rng):\n    \"\"\"Return (seed_rc, first_line_rc) for corner_kind in {TL,TR,BL,BR}.\"\"\"\n    if corner_kind == 'TL':\n        seed = (0, 0)\n        first = rng.choice([(0, 1), (1, 0)])\n    elif corner_kind == 'TR':\n        seed = (0, w - 1)\n        first = rng.choice([(0, w - 2), (1, w - 1)])\n    elif corner_kind == 'BL':\n        seed = (h - 1, 0)\n        first = rng.choice([(h - 1, 1), (h - 2, 0)])\n    elif corner_kind == 'BR':\n        seed = (h - 1, w - 1)\n        first = rng.choice([(h - 1, w - 2), (h - 2, w - 1)])\n    else:\n        raise ValueError(corner_kind)\n    return seed, first\n\n\ndef _distribute_loop_budget(num_seeds, num_attached_target, rng):\n    \"\"\"Distribute attached-loop budget across seeds, guaranteeing >= 1 each.\"\"\"\n    seed_order = list(range(num_seeds))\n    rng.shuffle(seed_order)\n    per_seed = [0] * num_seeds\n    remaining = num_attached_target\n    # Guarantee at least 1 per seed\n    while remaining > 0 and any(per_seed[i] == 0 for i in range(num_seeds)):\n        for i in seed_order:\n            if per_seed[i] == 0 and remaining > 0:\n                per_seed[i] += 1\n                remaining -= 1\n    # Distribute remainder randomly\n    while remaining > 0:\n        per_seed[rng.choice(seed_order)] += 1\n        remaining -= 1\n    return per_seed\n\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    h = rng.randint(*GRID_H_RANGE)\n    w = rng.randint(*GRID_W_RANGE)\n    bg = rng.choice(BG_COLORS)\n    palette = [c for c in range(10) if c != bg]\n    rng.shuffle(palette)\n\n    num_seeds = rng.choice(SEED_COUNT_WEIGHTS)\n    if num_seeds * 2 > len(palette):\n        return None\n\n    canvas = -np.ones((h, w), dtype=int)\n\n    seed_colors = [palette.pop() for _ in range(num_seeds)]\n    line_colors = [palette.pop() for _ in range(num_seeds)]\n\n    all_corners = ['TL', 'TR', 'BL', 'BR']\n    rng.shuffle(all_corners)\n    corners_used = all_corners[:num_seeds]\n\n    num_frame_cols = rng.randint(1, min(FRAME_COLORS_MAX, len(palette)))\n    frame_colors_pool = [palette.pop() for _ in range(num_frame_cols)]\n\n    # Grow seed lines\n    lines_info = []\n    for i in range(num_seeds):\n        seed_rc, first_rc = _corner_config(corners_used[i], h, w, rng)\n        if canvas[seed_rc] != -1 or canvas[first_rc] != -1:\n            return None\n        canvas[seed_rc] = seed_colors[i]\n        canvas[first_rc] = line_colors[i]\n        target_len = rng.randint(LINE_LEN_RANGE[0], min(LINE_LEN_RANGE[1], h + w))\n        path = _grow_line(canvas, first_rc, line_colors[i], target_len, rng)\n        if len(path) < MIN_LINE_LEN:\n            return None\n        lines_info.append((seed_colors[i], seed_rc, line_colors[i], path))\n\n    # Decide loop counts and distribute across seeds\n    total_loops_target = rng.randint(num_seeds, TOTAL_LOOPS_MAX)\n    num_distractors_target = rng.randint(0, max(0, total_loops_target - num_seeds))\n    num_attached_target = total_loops_target - num_distractors_target\n    per_seed = _distribute_loop_budget(num_seeds, num_attached_target, rng)\n\n    # Attach frames to each seed's line\n    for i, (_, _, line_col, path) in enumerate(lines_info):\n        attached = 0\n        for _ in range(per_seed[i]):\n            fc = rng.choice(frame_colors_pool)\n            if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\n                attached += 1\n        if attached == 0:\n            return None\n\n    # Place distractors\n    if rng.random() < DISTRACTOR_NETWORK_PROB:\n        _try_place_distractor_network(canvas, rng.choice(line_colors), frame_colors_pool, rng)\n    else:\n        for _ in range(rng.randint(0, DISTRACTOR_SOLO_MAX)):\n            _try_attach_distractor_frame(canvas, rng.choice(frame_colors_pool), rng)\n\n    # Finalize grid\n    grid = np.where(canvas == -1, bg, canvas).astype(int)\n\n    # Validate bg is most common color\n    vals, cnts = np.unique(grid, return_counts=True)\n    if int(vals[np.argmax(cnts)]) != bg:\n        return None\n\n    # Validate each seed color appears exactly once\n    for seed_col, _, _, _ in lines_info:\n        if int((grid == seed_col).sum()) != 1:\n            return None\n\n    # Oracle check: solver must change at least one cell\n    try:\n        out = main(grid)\n    except Exception:\n        return None\n    if np.array_equal(out, grid):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exhausted attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main'\"\\\\|\"'^def generate_input'\"\\\\|\"'^    '\"\\\\\\\"\\\\\\\"\\\\\\\"/,+220p' /home/lixinyu/snap/new/ARC_code/eval/b5ca7ac4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move bordered 5×5 squares to their designated grid edges by border color.\n\n    Input structure:\n    - bg = most common color.\n    - Azure (8) and red (2) bordered 5×5 squares with colored interiors, scattered across the grid.\n\n    Rule:\n    - Azure squares → left edge (col 0); red squares → right edge (col W−5).\n    - Each square keeps its original row.\n    - Process azure left-to-right, red right-to-left (nearest-to-edge first).\n    - If a square's rows overlap an already-placed edge square, place it one square-width inward instead.\n\n    Key insight: Near-edge-first ordering plus row-overlap determines which square sits at the edge vs. the second column.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    out = np.full_like(g, bg)\n\n    SQUARE_SIZE = 5\n    def overlaps(a0: int, a1: int, b0: int, b1: int) -> bool:\n        return not (int(a1) < int(b0) or int(b1) < int(a0))\n\n    # Detect bordered squares by scanning 5x5 windows. This is robust even if frame-color pixels\n    # are connected between squares in the input.\n    squares = []\n    for r0 in range(H - SQUARE_SIZE + 1):\n        for c0 in range(W - SQUARE_SIZE + 1):\n            patch = crop_bbox(g, (int(r0), int(c0), int(r0 + SQUARE_SIZE - 1), int(c0 + SQUARE_SIZE - 1)))\n\n            border = np.concatenate([patch[0, :], patch[-1, :], patch[1:-1, 0], patch[1:-1, -1]])\n            if int(border.min()) != int(border.max()):\n                continue\n            frame_col = int(border[0])\n            if frame_col not in {2, 8}:\n                continue\n\n            inner = patch[1:-1, 1:-1]\n            if not bool((inner != int(frame_col)).any()):\n                continue\n\n            squares.append({\"frame\": int(frame_col), \"r0\": int(r0), \"c0\": int(c0), \"patch\": patch})\n\n    # Azure squares: sort by original column ascending (leftmost first).\n    azure_squares = sorted([s for s in squares if int(s[\"frame\"]) == 8], key=lambda s: int(s[\"c0\"]))\n    placed_at_default: list[tuple[int, int]] = []\n    for s in azure_squares:\n        r0 = int(s[\"r0\"])\n        r1 = int(r0 + SQUARE_SIZE - 1)\n        has_overlap = any(overlaps(r0, r1, pr0, pr1) for pr0, pr1 in placed_at_default)\n        dest_c = int(SQUARE_SIZE) if has_overlap else 0\n        paste(out, s[\"patch\"], r0, dest_c, transparent=bg)\n        if dest_c == 0:\n            placed_at_default.append((r0, r1))\n\n    # Red squares: sort by original column descending (rightmost first).\n    red_squares = sorted([s for s in squares if int(s[\"frame\"]) == 2], key=lambda s: -int(s[\"c0\"]))\n    placed_at_default = []\n    for s in red_squares:\n        r0 = int(s[\"r0\"])\n        r1 = int(r0 + SQUARE_SIZE - 1)\n        has_overlap = any(overlaps(r0, r1, pr0, pr1) for pr0, pr1 in placed_at_default)\n        dest_c = int(W - 2 * SQUARE_SIZE) if has_overlap else int(W - SQUARE_SIZE)\n        paste(out, s[\"patch\"], r0, dest_c, transparent=bg)\n        if dest_c == int(W - SQUARE_SIZE):\n            placed_at_default.append((r0, r1))\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# --- Configuration ---\nGRID_H, GRID_W = 22, 22          # canvas dimensions\nSQ = 5                            # square side length (frame + 3x3 interior)\nAZURE, RED = 8, 2                 # frame colors\nN_AZURE_RANGE = (3, 4)            # azure square count range\nN_RED_RANGE = (3, 5)              # red square count range\nMAX_INWARD = 2                    # max inward squares per side\nINPUT_COL_RETRIES = 50            # retries for input column assignment per side\nGEN_RETRIES = 500                 # outer generate_input retry limit\n\n\ndef _make_patch(frame_color: int, inner_color: int) -> np.ndarray:\n    \"\"\"Create a SQxSQ bordered patch with uniform interior.\"\"\"\n    p = np.full((SQ, SQ), frame_color, dtype=int)\n    p[1:-1, 1:-1] = inner_color\n    return p\n\n\ndef _rows_overlap(r_a: int, r_b: int) -> bool:\n    \"\"\"Check whether two SQ-tall row spans overlap.\"\"\"\n    return abs(r_a - r_b) < SQ\n\n\ndef _rects_overlap(r1, c1, r2, c2) -> bool:\n    \"\"\"Check whether two SQxSQ rectangles overlap.\"\"\"\n    return abs(r1 - r2) < SQ and abs(c1 - c2) < SQ\n\n\ndef _any_pairwise_overlap(positions: list[tuple]) -> bool:\n    \"\"\"Return True if any two (r, c, ...) entries overlap as SQxSQ rects.\"\"\"\n    for i in range(len(positions)):\n        for j in range(i + 1, len(positions)):\n            if _rects_overlap(positions[i][0], positions[i][1],\n                              positions[j][0], positions[j][1]):\n                return True\n    return False\n\n\ndef _assign_output_rows(n: int) -> tuple[list[int], list[int]] | None:\n    \"\"\"Pick edge and inward row positions for *n* squares on one side.\n\n    Returns (edge_rows, inward_rows) or None on failure.\n    Edge squares have non-overlapping row spans. Each inward square must\n    row-overlap at least one edge square.\n    \"\"\"\n    max_inward = min(MAX_INWARD, n - 1)\n    n_inward = random.randint(1, max_inward)\n    n_edge = n - n_inward\n\n    all_rows = list(range(GRID_H - SQ + 1))\n    random.shuffle(all_rows)\n    edge_rows: list[int] = []\n    for r in all_rows:\n        if all(not _rows_overlap(r, er) for er in edge_rows):\n            edge_rows.append(r)\n            if len(edge_rows) == n_edge:\n                break\n    if len(edge_rows) < n_edge:\n        return None\n\n    random.shuffle(all_rows)\n    inward_rows: list[int] = []\n    for r in all_rows:\n        if not any(_rows_overlap(r, er) for er in edge_rows):\n            continue\n        if any(_rows_overlap(r, ir) for ir in inward_rows):\n            continue\n        inward_rows.append(r)\n        if len(inward_rows) == n_inward:\n            break\n    if len(inward_rows) < n_inward:\n        return None\n    return edge_rows, inward_rows\n\n\ndef _place_side_squares(\n    output: np.ndarray, edge_rows: list[int], inward_rows: list[int],\n    colors: list[int], frame_color: int, edge_col: int, inward_col: int,\n) -> list[tuple[int, int, bool, np.ndarray]]:\n    \"\"\"Render edge and inward squares onto *output*, return metadata list.\n\n    Each entry is (row, out_col, is_edge, patch).\n    \"\"\"\n    placed: list[tuple[int, int, bool, np.ndarray]] = []\n    for i, r in enumerate(edge_rows):\n        p = _make_patch(frame_color, colors[i])\n        paste(output, p, r, edge_col)\n        placed.append((r, edge_col, True, p))\n    for i, r in enumerate(inward_rows):\n        p = _make_patch(frame_color, colors[len(edge_rows) + i])\n        paste(output, p, r, inward_col)\n        placed.append((r, inward_col, False, p))\n    return placed\n\n\ndef _derive_input_positions(\n    sq_list: list[tuple[int, int, bool, np.ndarray]], ascending: bool,\n) -> list[tuple[int, int, np.ndarray]] | None:\n    \"\"\"Assign random input columns that reproduce the solver's edge/inward placement.\n\n    For ascending (azure), the solver processes squares by input col ascending;\n    for descending (red), by input col descending. An inward square must appear\n    after at least one of its row-overlapping edge squares in processing order.\n\n    Returns list of (row, input_col, patch) or None on failure.\n    \"\"\"\n    edges = [(r, oc, p) for (r, oc, is_edge, p) in sq_list if is_edge]\n    inwards = [(r, oc, p) for (r, oc, is_edge, p) in sq_list if not is_edge]\n\n    # For each inward square, find which edge squares it row-overlaps\n    inward_deps = [[i for i, (er, _, _) in enumerate(edges) if _rows_overlap(ir, er)]\n                   for (ir, _, _) in inwards]\n\n    n = len(sq_list)\n    col_range = list(range(0, GRID_W - SQ + 1))\n    if len(col_range) < n:\n        return None\n\n    for _ in range(INPUT_COL_RETRIES):\n        # Build processing order: edges first (shuffled), inwards inserted after deps\n        edge_indices = list(range(len(edges)))\n        random.shuffle(edge_indices)\n        order: list[tuple[str, int]] = [('edge', i) for i in edge_indices]\n\n        inward_order = list(range(len(inwards)))\n        random.shuffle(inward_order)\n        for iw_idx in inward_order:\n            # Find the latest position of any dependency edge in the order\n            latest_pos = max(\n                (pos for d in inward_deps[iw_idx]\n                 for pos, (typ, idx) in enumerate(order)\n                 if typ == 'edge' and idx == d),\n                default=-1,\n            )\n            insert_pos = random.randint(latest_pos + 1, len(order))\n            order.insert(insert_pos, ('inward', iw_idx))\n\n        # Resolve each entry to (row, out_col, patch) in processing order\n        ordered_squares = [\n            (edges[idx] if typ == 'edge' else inwards[idx]) for typ, idx in order\n        ]\n\n        # Pick n distinct sorted input cols; reverse for descending side\n        chosen_cols = sorted(random.sample(col_range, n))\n        if not ascending:\n            chosen_cols = chosen_cols[::-1]\n\n    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n    bg = random.choice([c for c in range(10) if c not in {AZURE, RED}])\n    n_azure = random.randint(*N_AZURE_RANGE)\n    n_red = random.randint(*N_RED_RANGE)\n\n    # Assign output row positions for each side\n    azure_assign = _assign_output_rows(n_azure)\n    if azure_assign is None:\n        return None\n    red_assign = _assign_output_rows(n_red)\n    if red_assign is None:\n        return None\n    azure_edge_rows, azure_inward_rows = azure_assign\n    red_edge_rows, red_inward_rows = red_assign\n\n    # Assign unique inner colors per frame type\n    avail_azure = [c for c in range(10) if c not in {bg, AZURE}]\n    avail_red = [c for c in range(10) if c not in {bg, RED}]\n    if len(avail_azure) < n_azure or len(avail_red) < n_red:\n        return None\n    azure_colors = random.sample(avail_azure, n_azure)\n    red_colors = random.sample(avail_red, n_red)\n\n    # Build output grid\n    output = np.full((GRID_H, GRID_W), bg, dtype=int)\n    azure_out = _place_side_squares(\n        output, azure_edge_rows, azure_inward_rows, azure_colors,\n        AZURE, edge_col=0, inward_col=SQ)\n    red_out = _place_side_squares(\n        output, red_edge_rows, red_inward_rows, red_colors,\n        RED, edge_col=GRID_W - SQ, inward_col=GRID_W - 2 * SQ)\n\n    # Derive input column assignments\n    azure_input = _derive_input_positions(azure_out, ascending=True)\n    if azure_input is None:\n        return None\n    red_input = _derive_input_positions(red_out, ascending=False)\n    if red_input is None:\n        return None\n\n    # Cross-side overlap check\n    all_positions = azure_input + red_input\n    if _any_pairwise_overlap(all_positions):\n        return None\n\n    # Build and validate input grid\n    inp = np.full((GRID_H, GRID_W), bg, dtype=int)\n    for r, c, p in all_positions:\n        paste(inp, p, r, c)\n    try:\n        if np.array_equal(main(inp), output):\n            return inp\n    except Exception:\n        pass\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main'\"\\\\|\"'^def generate_input'\"\\\\|\"'^    '\"\\\\\\\"\\\\\\\"\\\\\\\"/,+220p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main'\"\\\\|\"'^def generate_input'\"\\\\|\"'^    '\"\\\\\\\"\\\\\\\"\\\\\\\"/,+220p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n                frontier.append((rr, cc))\n    return frontier\n\n\ndef _grow_body(area):\n    choices = [\n    \"\"\"Return True if any patch cell has a non-bg 8-neighbor on canvas.\"\"\"\n    h, w = mask.shape\n    radius = _ISOLATION_RADIUS\n    occupied = canvas[top - radius : top + h + radius, left - radius : left + w + radius] != int(bg)\n    touch_zone = np.zeros((h + 2 * radius, w + 2 * radius), dtype=bool)\n    span = 2 * radius + 1\n    for dr in range(span):\n        for dc in range(span):\n            touch_zone[dr : dr + h, dc : dc + w] |= mask\n    return bool((occupied & touch_zone).any())\n\n\ndef _place(canvas, sprite, marker_r, marker_c, bg):\n    top, left = _top_left(sprite, marker_r, marker_c)\n    paste(canvas, sprite[\"patch\"], top, left, transparent=int(bg))\n\n\ndef _anchor_ok(canvas, r, c, bg):\n    H, W = canvas.shape\n    if not (r in (0, H - 1) or c in (0, W - 1)):\n        return False\n    if r in (0, H - 1) and c in (0, W - 1):\n        return False\n    return _isolated_bg_cell(canvas, r, c, bg)\n\n\ndef _isolated_bg_cell(canvas, r, c, bg):\n    \"\"\"Return True when a cell and its in-bounds 8-neighborhood are bg.\"\"\"\n    H, W = canvas.shape\n    radius = _ISOLATION_RADIUS\n    r0, r1 = max(0, r - radius), min(H, r + radius + 1)\n    c0, c1 = max(0, c - radius), min(W, c + radius + 1)\n    return not bool((canvas[r0:r1, c0:c1] != int(bg)).any())\n\n\ndef _anchor_candidates(canvas, bg):\n    H, W = canvas.shape\n    rows = list(range(_ANCHOR_EDGE_MARGIN, H - _ANCHOR_EDGE_MARGIN))\n    rows = rows or list(range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP))\n    cols = list(range(_ANCHOR_EDGE_MARGIN, W - _ANCHOR_EDGE_MARGIN))\n    cols = cols or list(range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP))\n    out = []\n    for c in cols:\n        out.append((\"h\", 0, c))\n        out.append((\"h\", H - 1, c))\n    for r in rows:\n        out.append((\"v\", r, 0))\n        out.append((\"v\", r, W - 1))\n    random.shuffle(out)\n    return [(axis, r, c) for axis, r, c in out if _anchor_ok(canvas, r, c, bg)]\n\n\ndef _put_anchor(canvas, r, c, color):\n    paste(canvas, np.array([[int(color)]], dtype=int), int(r), int(c))\n\n\ndef _aligned_positions(canvas, sprite, anchor, bg):\n    H, W = canvas.shape\n    if anchor[\"axis\"] == \"h\":\n        return [\n            (r, anchor[\"c\"])\n            for r in range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP)\n            if _can_place(canvas, sprite, r, anchor[\"c\"], bg)\n        ]\n    return [\n        (anchor[\"r\"], c)\n        for c in range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP)\n        if _can_place(canvas, sprite, anchor[\"r\"], c, bg)\n    ]\n\n\ndef _scatter_positions(canvas, sprite, anchor, marker, bg):\n    H, W = canvas.shape\n    mr, mc = marker\n    if anchor[\"axis\"] == \"h\":\n        return [\n            (mr, c)\n            for c in range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP)\n            if c != mc and _can_place(canvas, sprite, mr, c, bg)\n        ]\n    return [\n        (r, mc)\n        for r in range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP)\n        if r != mr and _can_place(canvas, sprite, r, mc, bg)\n    ]\n\n\ndef _body_color(bg, marker, used):\n    pool = [c for c in _COLORS if c not in {int(bg), int(marker)} and c not in used]\n    if not pool:\n        pool = [c for c in _COLORS if c not in {int(bg), int(marker)}]\n    return random.choice(pool)\n\n\ndef _bg_is_mode(grid, bg):\n    counts = Counter(map(int, grid.ravel()))\n    return counts[int(bg)] > max((n for c, n in counts.items() if c != int(bg)), default=0)\n\n\ndef _add_distractors(out, inp, anchors, bg):\n    vertical = [a for a in anchors if a[\"axis\"] == \"v\"]\n    if not vertical or random.random() >= _DISTRACTOR_PROB:\n        return\n    anchor = random.choice(vertical)\n    sprite = {\"patch\": np.array([[anchor[\"color\"]]], dtype=int), \"offset\": (0, 0)}\n    for _ in range(random.randint(*_DISTRACTOR_COUNT_RANGE)):\n        pairs = []\n        for c in range(_INNER_BORDER_GAP, out.shape[1] - _INNER_BORDER_GAP):\n            if not _can_place(out, sprite, anchor[\"r\"], c, bg):\n                continue\n            for r in range(_INNER_BORDER_GAP, out.shape[0] - _INNER_BORDER_GAP):\n                if r != anchor[\"r\"] and _can_place(inp, sprite, r, c, bg):\n                    pairs.append((r, c))\n        if not pairs:\n            return\n        in_r, col = random.choice(pairs)\n        _place(out, sprite, anchor[\"r\"], col, bg)\n        _place(inp, sprite, in_r, col, bg)\n\n\ndef _gen_attempt():\n    bg, out, inp = _new_canvas_pair()\n    placed = _place_anchors(out, inp, bg)\n    if placed is None:\n        return None\n    anchor_colors, anchors = placed\n\n    marker_colors = _marker_color_sequence(anchor_colors)\n    sprites = _place_aligned_sprites(out, anchors, marker_colors, bg)\n    if sprites is None:\n        return None\n\n    if not _scatter_sprites(inp, sprites, bg):\n        return None\n\n    _add_distractors(out, inp, anchors, bg)\n    if not _generated_grid_is_valid(inp, out, bg):\n        return None\n    return inp\n\n\ndef _new_canvas_pair():\n    \"\"\"Choose grid size/background and return matching output/input canvases.\"\"\"\n    H = random.randint(*_GRID_HEIGHT_RANGE)\n    W = random.randint(*_GRID_WIDTH_RANGE)\n    bg = random.randint(*_BG_COLOR_RANGE)\n    out = np.full((H, W), int(bg), dtype=int)\n    inp = np.full((H, W), int(bg), dtype=int)\n    return bg, out, inp\n\n\ndef _place_anchors(out, inp, bg):\n    \"\"\"Place distinct isolated border anchors into both canvases.\"\"\"\n    anchor_colors = random.sample([c for c in _COLORS if c != bg], random.randint(*_ANCHOR_COUNT_RANGE))\n    anchors = []\n    for color in anchor_colors:\n        candidates = _anchor_candidates(out, bg)\n        if not candidates:\n            return None\n        axis, r, c = random.choice(candidates)\n        anchor = {\"color\": int(color), \"r\": int(r), \"c\": int(c), \"axis\": axis}\n        anchors.append(anchor)\n        _put_anchor(out, r, c, color)\n        _put_anchor(inp, r, c, color)\n    return anchor_colors, anchors\n\n\ndef _marker_color_sequence(anchor_colors):\n    \"\"\"Expand anchor colors to the sprite count, allowing repeated markers.\"\"\"\n    n_sprites = random.randint(*_SPRITE_COUNT_RANGE)\n    marker_colors = anchor_colors[:]\n    while len(marker_colors) < n_sprites:\n        marker_colors.append(random.choice(anchor_colors))\n    random.shuffle(marker_colors)\n    return marker_colors\n\n\ndef _place_aligned_sprites(out, anchors, marker_colors, bg):\n    \"\"\"Build sprites in their solved locations and return their align metadata.\"\"\"\n    by_color = {a[\"color\"]: a for a in anchors}\n    used_body = set()\n    sprites = []\n    for marker in marker_colors:\n        anchor = by_color[int(marker)]\n        body = _body_color(bg, marker, used_body)\n        used_body.add(body)\n        sprite = _make_sprite(random.randint(*_BODY_AREA_RANGE), body, marker, bg)\n        positions = _aligned_positions(out, sprite, anchor, bg)\n        if not positions:\n            return None\n        marker_pos = random.choice(positions)\n        _place(out, sprite, marker_pos[0], marker_pos[1], bg)\n        sprites.append((sprite, anchor, marker_pos))\n    return sprites\n\n\ndef _scatter_sprites(inp, sprites, bg):\n    \"\"\"Move solved sprites onto the input canvas along the inverse axis.\"\"\"\n    random.shuffle(sprites)\n    for sprite, anchor, marker_pos in sprites:\n        positions = _scatter_positions(inp, sprite, anchor, marker_pos, bg)\n        if not positions:\n            return False\n        in_pos = random.choice(positions)\n        _place(inp, sprite, in_pos[0], in_pos[1], bg)\n    return True\n\n\ndef _generated_grid_is_valid(inp, out, bg):\n    \"\"\"Apply generator invariants and the solver oracle check.\"\"\"\n    if not _bg_is_mode(inp, bg):\n        return False\n    return bool(np.array_equal(main(inp), out))\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 581f7754 input\")\n","exit_code":0,"status":"completed"}}
