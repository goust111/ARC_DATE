{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/135a2760.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repair noisy periodic patterns inside frame-delimited grid regions.\n\n    Input structure:\n    - Frame color (most common) forms full rows/cols, dividing the grid into rectangular regions.\n    - bg (second most common) fills empty space; each region contains a small colored tile repeated periodically with a few corrupted pixels.\n\n    Rule:\n    - For each region, find the bounding box of non-bg content.\n    - Infer the smallest repeating tile that explains the pattern (majority vote per residue position), requiring it repeat at least 2x per axis.\n    - Replace the region with the clean tiled version.\n\n    Key insight: Tile dimensions are unknown and must be inferred; prefer the smallest tile with genuine repetition over one that memorizes the entire region.\n    \"\"\"\n    g = np.array(grid, dtype=int).copy()\n    H, W = g.shape\n\n    cnt = Counter(map(int, g.flatten()))\n    frame = int(cnt.most_common(1)[0][0])\n    bg = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(frame):\n            bg = int(col)\n            break\n    assert not (bg is None)\n\n    fr = [int(r) for r in range(H) if bool((g[int(r), :] == int(frame)).all())]\n    fc = [int(c) for c in range(W) if bool((g[:, int(c)] == int(frame)).all())]\n    fr = sorted(set(fr))\n    fc = sorted(set(fc))\n\n    assert fr\n    assert fc\n\n    if fr[0] != 0:\n        fr = [-1] + fr\n    if fr[-1] != (H - 1):\n        fr = fr + [H]\n    else:\n        fr = fr + [H]\n\n    if fc[0] != 0:\n        fc = [-1] + fc\n    if fc[-1] != (W - 1):\n        fc = fc + [W]\n    else:\n        fc = fc + [W]\n\n    def reconstruct(core: np.ndarray, maxp: int = 12) -> np.ndarray:\n        h, w = core.shape\n        best_all = None  # ((mism, area), B)\n        best_ok = None\n\n        for ph in range(1, min(int(maxp), int(h)) + 1):\n            for pw in range(1, min(int(maxp), int(w)) + 1):\n                tile = np.zeros((int(ph), int(pw)), dtype=int)\n                for i in range(int(ph)):\n                    for j in range(int(pw)):\n                        vals = core[int(i) :: int(ph), int(j) :: int(pw)].flatten()\n                        tile[int(i), int(j)] = int(Counter(map(int, vals)).most_common(1)[0][0])\n\n                B = np.tile(tile, ((h + ph - 1) // ph, (w + pw - 1) // pw))[:h, :w]\n                mism = int(np.sum(B != core))\n                area = int(ph * pw)\n                key = (mism, area)\n\n                if best_all is None or key < best_all[0]:\n                    best_all = (key, B)\n\n                # Require some repetition (avoid memorizing the entire core).\n                ok = True\n                if int(ph) == int(h) and int(pw) == int(w):\n                    ok = False\n                if int(ph) < int(h) and (int(h) // int(ph)) < 2:\n                    ok = False\n                if int(pw) < int(w) and (int(w) // int(pw)) < 2:\n                    ok = False\n                if ok and (best_ok is None or key < best_ok[0]):\n                    best_ok = (key, B)\n\n        return (best_ok or best_all)[1]\n\n    out = g.copy()\n    for i in range(len(fr) - 1):\n        r0, r1 = int(fr[i]), int(fr[i + 1])\n        if int(r1 - r0) <= 1:\n            continue\n        rr0, rr1 = int(r0 + 1), int(r1 - 1)\n\n        for j in range(len(fc) - 1):\n            c0, c1 = int(fc[j]), int(fc[j + 1])\n            if int(c1 - c0) <= 1:\n                continue\n            cc0, cc1 = int(c0 + 1), int(c1 - 1)\n\n            A = g[rr0 : rr1 + 1, cc0 : cc1 + 1]\n            m = A != int(bg)\n            if not bool(m.any()):\n                continue\n\n            rs = np.where(m.any(axis=1))[0]\n            cs = np.where(m.any(axis=0))[0]\n            rmin, rmax = int(rs.min()), int(rs.max())\n            cmin, cmax = int(cs.min()), int(cs.max())\n\n            core = A[rmin : rmax + 1, cmin : cmax + 1]\n            rec = reconstruct(core)\n\n            A2 = A.copy()\n            A2[rmin : rmax + 1, cmin : cmax + 1] = rec\n            out[rr0 : rr1 + 1, cc0 : cc1 + 1] = A2\n\n    return out\n\n\ndef generate_input() -> np.ndarray:\n    bg = 0\n    frame = 5\n\n    # Region grid (2x2 or 3x2) with 1px frame separators.\n    n_r = int(np.random.randint(2, 4))\n    n_c = int(np.random.randint(2, 3))\n\n    r_sizes = [int(np.random.randint(6, 11)) for _ in range(n_r)]\n    c_sizes = [int(np.random.randint(6, 11)) for _ in range(n_c)]\n\n    H = int(sum(r_sizes) + (n_r + 1))\n    W = int(sum(c_sizes) + (n_c + 1))\n\n    g = np.full((H, W), int(frame), dtype=int)\n\n    # Fill each region with bg and optionally a repeating tile with noise.\n    any_pattern = False\n    r0 = 1\n    for i, rh in enumerate(r_sizes):\n        c0 = 1\n        for j, cw in enumerate(c_sizes):\n            region = np.full((int(rh), int(cw)), int(bg), dtype=int)\n\n            if bool(np.random.rand() < 0.85) or not any_pattern:\n                any_pattern = True\n                ph = int(np.random.randint(1, min(4, rh) + 1))\n                pw = int(np.random.randint(1, min(4, cw) + 1))\n\n                pal = [int(c) for c in np.random.choice(range(1, 10), size=int(np.random.randint(2, 5)), replace=False)]\n                pal = [c for c in pal if int(c) != int(frame)]\n                if not pal:\n                    pal = [2, 3]\n\n                tile = np.full((ph, pw), int(bg), dtype=int)\n                # Ensure at least one non-bg in the tile.\n                tile[int(np.random.randint(0, ph)), int(np.random.randint(0, pw))] = int(pal[0])\n                # Add a few more colored cells.\n                k = int(np.random.randint(0, ph * pw))\n                idx = np.random.choice(ph * pw, size=int(k), replace=False)\n                for t in idx:\n                    tile.flat[int(t)] = int(pal[int(np.random.randint(0, len(pal)))])\n\n                tiled = np.tile(tile, ((rh + ph - 1) // ph, (cw + pw - 1) // pw))[:rh, :cw]\n                region[:, :] = tiled\n\n                # Add small noise (flip a few cells) so reconstruction does real work.\n                n_noise = int(np.random.randint(0, max(1, (rh * cw) // 20)))\n                for _ in range(n_noise):\n                    rr = int(np.random.randint(0, rh))\n                    cc = int(np.random.randint(0, cw))\n                    if int(region[rr, cc]) != int(bg):\n                        region[rr, cc] = int(pal[int(np.random.randint(0, len(pal)))])\n\n            g[int(r0) : int(r0 + rh), int(c0) : int(c0 + cw)] = region\n            c0 += int(cw) + 1\n        r0 += int(rh) + 1\n\n    return g\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom arc_utils import get_bg, in_bounds, neighbors4, label_mask\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect framed squares via colored bridges following a control-pixel sequence.\n\n    Input structure:\n    - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.\n    - Control row below squares: colored pixels read left-to-right encode visitation order.\n\n    Rule:\n    - Start at the square matching first control color c0.\n    - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.\n    - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.\n\n    Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # border color = most common non-bg color\n    cnt = Counter(map(int, g.flatten()))\n    border = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            border = int(col)\n            break\n    assert not (border is None)\n\n    # detect framed squares as connected components of the border color\n    lab, n = label_mask(g == int(border), connectivity=4)\n    frames: list[dict] = []\n    for cid in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(cid))\n        if int(pts.shape[0]) < 8:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        if h < 3 or w < 3:\n            continue\n\n        t = None\n        inner_col = None\n        for tt in range(1, int(min(h, w) // 2) + 1):\n            inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]\n            if inner.size == 0:\n                continue\n            if bool((inner == int(border)).any()):\n                continue\n            u = set(map(int, inner.flatten()))\n            if len(u) != 1:\n                continue\n\n            ok = True\n            if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not ok:\n                continue\n\n            t = int(tt)\n            inner_col = int(next(iter(u)))\n            break\n\n        if t is None or inner_col is None:\n            continue\n\n        frames.append(\n            {\n                \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n                \"t\": int(t),\n                \"inner\": int(inner_col),\n                \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            }\n        )\n\n    assert not (not frames)\n\n    by: dict[int, list[dict]] = defaultdict(list)\n    for f in frames:\n        by[int(f[\"inner\"])].append(f)\n\n    max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n\n    # control row = bottom-most row below the squares with >=2 non-bg pixels\n    ctrl_r = None\n    for r in range(int(H - 1), int(max_frame_r), -1):\n        if int((g[int(r)] != int(bg)).sum()) >= 2:\n            ctrl_r = int(r)\n            break\n    assert not (ctrl_r is None)\n\n    ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n    assert not (len(ctrl) < 2)\n\n    def center(f: dict) -> tuple[int, int]:\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        return int((r0 + r1) // 2), int((c0 + c1) // 2)\n\n    def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n        a = f1[\"inner_bbox\"]\n        b = f2[\"inner_bbox\"]\n        same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n        same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))\n        return same_row, same_col\n\n    # choose start frame\n    start_color = int(ctrl[0])\n    assert not (start_color not in by)\n    start_cands = by[start_color]\n    if len(start_cands) == 1:\n        cur = start_cands[0]\n    else:\n        nxt_color = int(ctrl[1])\n        nxt_cands = by.get(nxt_color, [])\n        best = None\n        bestf = None\n        for f in start_cands:\n            for g2 in (nxt_cands if nxt_cands else [f]):\n                sr, sc = aligned(f, g2)\n                al = 1 if (sr or sc) else 0\n                (r1_, c1_) = center(f)\n                (r2_, c2_) = center(g2)\n                d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n                cand = (int(al), -int(d))\n                if best is None or cand > best:\n                    best = cand\n                    bestf = f\n        cur = bestf\n\n    out = g.copy()\n\n    def draw_bridge(fa: dict, fb: dict, color: int) -> None:\n        (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n        (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n        ia = fa[\"inner_bbox\"]\n        sr, sc = aligned(fa, fb)\n        if sr:\n            rr0, rr1 = int(ia[0]), int(ia[2])\n            if int(c1a) < int(c0b):\n                cc0, cc1 = int(c1a + 1), int(c0b - 1)\n            else:\n                cc0, cc1 = int(c1b + 1), int(c0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n            return\n        if sc:\n            cc0, cc1 = int(ia[1]), int(ia[3])\n            if int(r1a) < int(r0b):\n                rr0, rr1 = int(r1a + 1), int(r0b - 1)\n            else:\n                rr0, rr1 = int(r1b + 1), int(r0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n\n    for i in range(int(len(ctrl)) - 1):\n        a = int(ctrl[i])\n        b = int(ctrl[i + 1])\n        assert int(cur[\"inner\"]) == int(a)\n        assert b in by, f\"control color {b} has no matching frame\"\n        cands = by[b]\n        best = None\n        bestf = None\n        for f in cands:\n            sr, sc = aligned(cur, f)\n            al = 1 if (sr or sc) else 0\n            (r1_, c1_) = center(cur)\n            (r2_, c2_) = center(f)\n            d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n            cand = (int(al), -int(d))\n            if best is None or cand > best:\n                best = cand\n                bestf = f\n        nxt = bestf\n        draw_bridge(cur, nxt, int(a))\n        cur = nxt\n\n    return out\n\n\ndef _most_common_nonbg(g: np.ndarray, bg: int) -> int | None:\n    cnt = Counter(map(int, g.flatten()))\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            return int(col)\n    return None\n\ndef _draw_frame(g: np.ndarray, *, r0: int, c0: int, outer: int, t: int, border: int, inner_col: int) -> None:\n    g[int(r0) : int(r0 + outer), int(c0) : int(c0 + outer)] = int(border)\n    g[int(r0 + t) : int(r0 + outer - t), int(c0 + t) : int(c0 + outer - t)] = int(inner_col)\n\ndef _bridge_cells(fa: dict, fb: dict) -> set[tuple[int, int]]:\n    (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n    (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n    ia = fa[\"inner_bbox\"]\n    ib = fb[\"inner_bbox\"]\n    # same-row band\n    if int(ia[0]) == int(ib[0]) and int(ia[2]) == int(ib[2]):\n        rr0, rr1 = int(ia[0]), int(ia[2])\n        if int(c1a) < int(c0b):\n            cc0, cc1 = int(c1a + 1), int(c0b - 1)\n        else:\n            cc0, cc1 = int(c1b + 1), int(c0a - 1)\n        assert int(cc0) <= int(cc1), \"horizontal bridge gap must be non-empty\"\n        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n    # same-col band\n    if int(ia[1]) == int(ib[1]) and int(ia[3]) == int(ib[3]):\n        cc0, cc1 = int(ia[1]), int(ia[3])\n        if int(r1a) < int(r0b):\n            rr0, rr1 = int(r1a + 1), int(r0b - 1)\n        else:\n            rr0, rr1 = int(r1b + 1), int(r0a - 1)\n        assert int(rr0) <= int(rr1), \"vertical bridge gap must be non-empty\"\n        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n    return set()\n\n_DIGITS = [int(i) for i in range(10)]\n\ndef _gen_attempt() -> np.ndarray | None:\n    # --- colors ---\n    bg = int(np.random.choice(np.array(_DIGITS, dtype=int)))\n    border = int(np.random.choice(np.array([d for d in _DIGITS if int(d) != int(bg)], dtype=int)))\n    inner_palette = [int(d) for d in _DIGITS if int(d) not in (int(bg), int(border))]\n    if len(inner_palette) < 3:\n","exit_code":0,"status":"completed"}}
