{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport random\nfrom collections import Counter\nimport numpy as np\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed168776016/4/1.py')\nmod = SourceFileLoader('arc_test_mod', str(p)).load_module()\nreasons = Counter()\nfor seed in range(200):\n    rng = random.Random(seed)\n    height = rng.randint(mod.GRID_MIN, mod.GRID_MAX)\n    width = rng.randint(mod.GRID_MIN, mod.GRID_MAX)\n    axis = rng.choice((mod.VERTICAL_AXIS, mod.HORIZONTAL_AXIS))\n    sides = (mod.TOP, mod.BOTTOM) if axis == mod.VERTICAL_AXIS else (mod.LEFT, mod.RIGHT)\n    frame_count = mod._choose_frame_count(rng, height, width, axis)\n    colors = list(range(10))\n    rng.shuffle(colors)\n    bg, wall_color = colors[:2]\n    seed_colors = colors[2 : 2 + frame_count]\n    grid = np.full((height, width), bg, dtype=int)\n    occupied = np.zeros((height, width), dtype=bool)\n    reserved_rays = np.zeros((height, width), dtype=bool)\n    used_lines = set()\n    frames = []\n    ok = True\n    for frame_idx in range(frame_count):\n        side = rng.choice(sides)\n        seed_color = seed_colors[frame_idx]\n        placed = False\n        local = Counter()\n        for _ in range(mod.PLACEMENT_RETRIES):\n            bbox = mod._sample_bbox(rng, height, width, axis, side)\n            if bbox is None:\n                local['bbox_none'] += 1\n                continue\n            r0, c0, r1, c1 = bbox\n            if occupied[r0:r1+1, c0:c1+1].any():\n                local['occupied'] += 1\n                continue\n            if reserved_rays[r0:r1+1, c0:c1+1].any():\n                local['bbox_hits_ray'] += 1\n                continue\n            if axis == mod.VERTICAL_AXIS:\n                gap_c = rng.randint(c0 + 1, c1 - 1)\n                if gap_c in used_lines:\n                    local['used_line'] += 1\n                    continue\n                gap_r = r0 if side == mod.TOP else r1\n            else:\n                gap_r = rng.randint(r0 + 1, r1 - 1)\n                if gap_r in used_lines:\n                    local['used_line'] += 1\n                    continue\n                gap_c = c0 if side == mod.LEFT else c1\n            corridor = mod._outside_corridor((height, width), bbox, side, gap_r, gap_c)\n            line_cells = mod._inside_line(bbox, side, gap_r, gap_c)\n            if not mod._lane_free(corridor + line_cells, occupied, reserved_rays):\n                local['lane_blocked'] += 1\n                continue\n            seed_options = mod._seed_shapes_for_bbox(bbox)\n            if not seed_options:\n                local['seed_options'] += 1\n                continue\n            seed_shape = rng.choice(seed_options)\n            seed_r0, seed_c0 = mod._sample_seed_position(rng, axis, bbox, gap_c if axis == mod.VERTICAL_AXIS else gap_r, seed_shape)\n            seed_h, seed_w = seed_shape\n            spec = mod.FrameSpec(r0, c0, r1, c1, wall_color, gap_r, gap_c, side, seed_color, seed_r0, seed_c0, seed_r0+seed_h-1, seed_c0+seed_w-1)\n            mod._draw_frame(grid, spec)\n            mod._reserve_box(occupied, r0, c0, r1, c1)\n            for rr, cc in corridor + line_cells:\n                reserved_rays[rr, cc] = True\n            used_lines.add(gap_c if axis == mod.VERTICAL_AXIS else gap_r)\n            frames.append(spec)\n            placed = True\n            break\n        if not placed:\n            reasons['placement_fail'] += 1\n            reasons.update({f'place_{k}': v for k,v in local.items()})\n            ok = False\n            break\n    if not ok:\n        continue\n    if mod._dominant_color(grid) \"'!= bg:\n        reasons['\"'bg_not_dominant'] += 1\n        continue\n    expected = mod._render_expected(grid, frames)\n    try:\n        actual = mod.main(grid)\n    except Exception as e:\n        reasons[f'main_{type(e).__name__}'] += 1\n        continue\n    if not np.array_equal(actual, expected):\n        reasons['mismatch'] += 1\n        continue\n    reasons['success'] += 1\nprint(reasons)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
