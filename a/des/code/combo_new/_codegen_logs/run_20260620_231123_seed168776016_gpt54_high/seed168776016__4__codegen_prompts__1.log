{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def generate_input(/p;/''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the region enclosed by a wall sprite and radiate color outward through its opening.\n\n    Input structure:\n    - bg = most common color. Wall = most frequent non-bg color, forming a partial enclosure (e.g. U-shape).\n    - A fill-color pixel sits inside the enclosed area. Other non-bg pixels may act as obstacles.\n    Rule:\n    - Flood-fill the enclosed area with the fill color, radiating outward through the wall's open end.\n    - Obstacles cast \"shadows\" along the radiate direction, blocking fill behind them.\n\n    Key insight: The wall endpoints define the opening direction; fill radiates outward through it, and obstacles block propagation along that same axis.\n    \"\"\"\n    g = np.array(grid, copy=True)\n    h, w = g.shape\n\n    vals = np.unique(g)\n    bg = get_bg(g)\n\n    non_bg = [int(v) for v in vals if int(v) != bg]\n    assert non_bg, \"expected at least one non-background color\"\n\n    # Wall: most frequent non-background color.\n    wall = max(non_bg, key=lambda c: int((g == c).sum()))\n\n    wall_mask = g == wall\n\n    # Wall connected components (8-neigh).\n    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]\n    assert comps, \"expected at least one wall connected component\"\n\n    def sgn(x: int) -> int:\n        return (x > 0) - (x < 0)\n\n    other_colors = [c for c in non_bg if c != wall]\n    assert other_colors, \"expected at least one non-wall color (fill color)\"\n\n    # Pick fill color as the non-wall color closest (Manhattan distance) to the wall pixels.\n    wall_points = [p for comp in comps for p in comp]\n\n    def min_dist_to_wall(color: int) -> tuple[int, int]:\n        pts = list(zip(*np.where(g == color)))\n        pts = [(int(r), int(c)) for r, c in pts]\n        best_d = 10**9\n        for r, c in pts:\n            for wr, wc in wall_points:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0, len(pts)\n        return best_d, len(pts)\n\n    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))\n\n    fill_pos = list(zip(*np.where(g == fill)))\n    fill_pos = [(int(r), int(c)) for r, c in fill_pos]\n    if not fill_pos:\n        return g\n\n    # Choose the closest wall component to the fill seed (ties: larger component).\n    def comp_min_dist(comp: set[tuple[int, int]]) -> int:\n        best_d = 10**9\n        for r, c in fill_pos:\n            for wr, wc in comp:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0\n        return best_d\n\n    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))\n\n    comp_mask = np.zeros_like(wall_mask, dtype=bool)\n    for r, c in wall_comp:\n        comp_mask[r, c] = True\n\n    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:\n        out = []\n        for rr, cc in neighbors8(r, c):\n            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:\n                out.append((rr, cc))\n        return out\n\n    endpoints: list[tuple[int, int]] = []\n    for r, c in wall_comp:\n        if len(comp_neighbors(r, c)) == 1:\n            endpoints.append((r, c))\n\n    assert endpoints, \"expected wall component to have endpoints (degree-1 pixels)\"\n\n    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:\n        n1 = comp_neighbors(*ep)[0]\n        d1 = (sgn(n1[0] - ep[0]), sgn(n1[1] - ep[1]))  # inward\n        d_use = d1\n        is_12 = False\n        n2s = [p for p in comp_neighbors(*n1) if p != ep]\n        if n2s:\n            n2 = n2s[0]\n            d2 = (sgn(n2[0] - n1[0]), sgn(n2[1] - n1[1]))\n            if (d1[0] == 0) ^ (d1[1] == 0):\n                if d2[0] != 0 and d2[1] != 0:\n                    d_use = d2\n                    is_12 = True\n        return (-d_use[0], -d_use[1]), is_12\n\n    out_info = [outward_dir(ep) for ep in endpoints]\n    out_dirs = [d for d, _ in out_info]\n    tip_12 = [f for _, f in out_info]\n\n    dr_sum = sum(d[0] for d in out_dirs)\n    dc_sum = sum(d[1] for d in out_dirs)\n    rad = (sgn(dr_sum), sgn(dc_sum))\n\n    barrier = comp_mask.copy()\n\n    def add_ray(start: tuple[int, int], d: tuple[int, int], skip: int = 0) -> None:\n        rr, cc = start\n        for _ in range(skip):\n            rr += d[0]\n            cc += d[1]\n        while True:\n            rr += d[0]\n            cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:\n        rr, cc = start\n        step = 0\n        while True:\n            step += 1\n            if step % 2 == 1:\n                rr += d[0]; cc += d[1]\n            else:\n                if rad[0] != 0:\n                    rr += d[0]\n                else:\n                    cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):\n        if is_12:\n            add_ray_12(ep, d)\n        else:\n            add_ray(ep, d, skip=0)\n\n    passable = (~barrier) & ((g == bg) | (g == fill))\n    q = fill_pos[:]\n    seen = np.zeros_like(passable, dtype=bool)\n    for r, c in q:\n        if passable[r, c]:\n            seen[r, c] = True\n    while q:\n        r, c = q.pop()\n        for rr, cc in neighbors4(r, c):\n            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:\n                seen[rr, cc] = True\n                q.append((rr, cc))\n\n    filled_mask = (seen & (g == bg))\n\n    out = g.copy()\n    out[filled_mask] = fill\n\n    # Shadow behind obstacles (non-bg, non-fill, non-wall) along radiate direction.\n    obstacles = (g != bg) & (g != fill) & (g != wall)\n\n    def shadow_process(coords: list[tuple[int, int]]) -> None:\n        started = False\n        blocked = False\n        for r, c in coords:\n            if filled_mask[r, c]:\n                started = True\n            if started and obstacles[r, c]:\n                blocked = True\n                continue\n            if blocked and filled_mask[r, c]:\n                out[r, c] = bg\n                filled_mask[r, c] = False\n\n    if rad != (0, 0):\n        dr, dc = rad\n        if dr != 0 and dc == 0:\n            for c in range(w):\n                rows = range(h) if dr > 0 else range(h - 1, -1, -1)\n                shadow_process([(r, c) for r in rows])\n        elif dc != 0 and dr == 0:\n            for r in range(h):\n                cols = range(w) if dc > 0 else range(w - 1, -1, -1)\n                shadow_process([(r, c) for c in cols])\n        else:\n            # Diagonal scanlines\n            if dr == dc:\n                # r - c = const\n                for k in range(-(w - 1), h):\n                    coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]\n                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n                    shadow_process(coords)\n            else:\n                # r + c = const\n                for k in range(h + w - 1):\n                    coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]\n                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n                    shadow_process(coords)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom scipy.ndimage import distance_transform_cdt\n\n# -- Configuration constants --------------------------------------------------\n# Canvas size bounds\nGRID_H_VERT = (11, 18)       # height range when radiate_dir is vertical\nGRID_H_HORIZ = (8, 18)       # height range when radiate_dir is horizontal\nGRID_W = (15, 19)             # width range (all directions)\n\n# Wall geometry\nWALL_PIXELS_MIN = 17          # minimum wall pixel count\nWALL_PIXELS_MAX = 25          # maximum wall pixel count\nDEPTH_VERT = (5, 10)          # arm depth range for vertical radiate\nDEPTH_HORIZ = (6, 8)          # arm depth range for horizontal radiate\nGAP_VERT = (6, 7)             # endpoint gap for vertical radiate\nGAP_HORIZ = (5, 7)            # endpoint gap for horizontal radiate\nTIP_12_PROB = 0.5             # probability of 1:2 arm-angle mode (when eligible)\n\n# Placement margins\nOPEN_END_MARGIN = 3           # min cells from open end to radiate grid edge\n\n# Fill seed\nSEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]  # weighted choices for blob size\nSEED_DEPTH_LOOKBACK = 3       # seed must be within this many rows of closed end\n\n# Obstacles\nMAX_OBSTACLES = 5             # maximum obstacle pixel count\nOBSTACLE_IN_FILL_PROB = 0.65  # probability of forcing at least one obstacle in fill zone\nOBSTACLE_MIN_SEP = 2          # Chebyshev distance between obstacles (> this value)\n\n# Validation\nMIN_NEW_FILL = 20             # minimum newly-filled pixels for a valid output\nPALETTE_SIZE = (3, 5)         # number of distinct colors (bg + wall + fill + obstacle(s))\nGEN_RETRIES = 300             # max attempts in generate_input\n\n\ndef _degree1_pixels(points):\n    \"\"\"Return degree-1 pixels (exactly one 8-neighbor in the set).\"\"\"\n    pts = set(points)\n    return [(r, c) for r, c in pts\n            if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1]\n\n\ndef _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):\n    \"\"\"Build one zigzag arm from (0, start_v) toward (depth, target_v).\"\"\"\n    sign = 1 if target_v > start_v else -1\n    n_side_steps = abs(target_v - start_v)\n    chosen_rows = []\n    if n_side_steps:\n        if tip_12:\n            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]\n            extra_steps = 0\n        else:\n            chosen_rows = [1]\n            if n_side_steps > 1:\n                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)\n            chosen_rows.sort()\n\n    first_row = chosen_rows[0] if chosen_rows else 1\n    extra_rows = [r for r in chosen_rows if r != first_row]\n    random.shuffle(extra_rows)\n    orthogonal_rows = set(extra_rows[:extra_steps])\n\n    pts = [(0, start_v)]\n    u, v = 0, start_v\n    for row in range(1, depth + 1):\n        u += 1\n        if row in orthogonal_rows:\n            pts.append((u, v))\n            v += sign\n        elif row in chosen_rows:\n            v += sign\n        pts.append((u, v))\n    return pts\n\n\ndef _build_local_wall(rad, h, w):\n    \"\"\"Construct wall shape in local (u, v) coordinates. Returns (pts, depth, gap) or None.\"\"\"\n    if rad[0]:\n        max_depth = min(DEPTH_VERT[1], h - 6)\n        if max_depth < DEPTH_VERT[0]:\n            return None\n        depth = random.randint(DEPTH_VERT[0], max_depth)\n        gap = random.randint(*GAP_VERT)\n    else:\n        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))\n        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))\n\n    if gap == 5:\n        left_bottom, right_bottom = 2, 3\n    elif gap == 6:\n        left_bottom, right_bottom = 2, 4\n    else:\n        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])\n\n    bridge_extra = max(0, right_bottom - left_bottom - 1)\n    base_count = 2 * (depth + 1) + bridge_extra\n    max_extra_l = max(0, left_bottom - 1)\n    max_extra_r = max(0, gap - right_bottom - 1)\n    min_extra = max(0, WALL_PIXELS_MIN - base_count)\n    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)\n    if min_extra > max_extra:\n        return None\n\n    extra = random.randint(min_extra, max_extra)\n    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))\n    extra_r = extra - extra_l\n\n    max_n_side = max(left_bottom, gap - right_bottom)\n    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB\n    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)\n    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)\n    pts = set(left) | set(right)\n    for v in range(left_bottom, right_bottom + 1):\n        pts.add((depth, v))\n\n    # Pad wall to minimum size by adding 8-connected pixels that preserve 2 endpoints\n    while len(pts) < WALL_PIXELS_MIN:\n        candidates = [\n            (u, v) for u in range(max(0, depth - 3), depth + 1)\n            for v in range(gap + 1) if (u, v) not in pts\n            and sum((uu, vv) in pts\n                    for uu in range(u - 1, u + 2)\n                    for vv in range(v - 1, v + 2)\n                    if (uu, vv) != (u, v)) >= 2\n        ]\n        random.shuffle(candidates)\n        added = False\n        for p in candidates:\n            trial = pts | {p}\n            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:\n                pts = trial\n                added = True\n                break\n        if not added:\n            return None\n\n    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:\n        return None\n    return pts, depth, gap\n\n\ndef _map_local(u, v, rad, anchor):\n    \"\"\"Map local (u, v) to grid (r, c) given radiate direction and anchor.\"\"\"\n    r0, c0 = anchor\n    if rad == (-1, 0):\n        return r0 + u, c0 + v\n    if rad == (1, 0):\n        return r0 - u, c0 + v\n    if rad == (0, -1):\n        return r0 + v, c0 + u\n    return r0 + v, c0 - u\n\n\ndef _place_anchor(rad, h, w, depth, gap):\n    \"\"\"Choose anchor so the wall fits within margins.\"\"\"\n    if rad == (-1, 0):\n        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)\n    if rad == (1, 0):\n        return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)\n    if rad == (0, -1):\n        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)\n    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)\n\n\ndef _local_interior(wall, depth, gap):\n    \"\"\"Return bg cells strictly between the two wall arms in local coords.\"\"\"\n    by_row = {}\n    for u, v in wall:\n        by_row.setdefault(u, []).append(v)\n    interior = []\n    for u in range(1, depth):\n        if u not in by_row or len(by_row[u]) < 2:\n            continue\n        lo, hi = min(by_row[u]), max(by_row[u])\n        for v in range(lo + 1, hi):\n            if (u, v) not in wall:\n                interior.append((u, v))\n    return interior\n\n\ndef _grow_seed_blob(seed, interior_set):\n    \"\"\"Grow a small 4-connected blob from seed within interior cells.\"\"\"\n    blob = {seed}\n    target_size = random.choice(SEED_SIZE_WEIGHTS)\n    frontier = [seed]\n    while len(blob) < target_size and frontier:\n        p = frontier.pop(random.randrange(len(frontier)))\n        u, v = p\n        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):\n            if q in interior_set and q not in blob:\n                blob.add(q)\n                frontier.append(q)\n                if len(blob) >= target_size:\n                    break\n    return blob\n\n\ndef _obstacle_fits(pos, placed):\n    \"\"\"Check that pos is at least Chebyshev OBSTACLE_MIN_SEP from all placed obstacles.\"\"\"\n    r, c = pos\n    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)\n\n\ndef _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone):\n    \"\"\"Find bg cells far enough from wall for obstacle placement, using distance transform.\"\"\"\n    wall_mask = grid == wall_color\n    # distance_transform_cdt with chessboard metric gives Chebyshev distance to wall\n    dist = distance_transform_cdt(~wall_mask, metric='taxicab')\n    far_from_wall = dist > 1\n    eligible = (grid == bg) & far_from_wall\n    all_coords = list(zip(*np.where(eligible)))\n    fill_coords = [p for p in all_coords if nominal_fill_zone[p[0], p[1]]]\n    random.shuffle(all_coords)\n    random.shuffle(fill_coords)\n    return [(int(r), int(c)) for r, c in all_coords], [(int(r), int(c)) for r, c in fill_coords]\n\n\ndef _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid):\n    \"\"\"Place up to n_obstacles on the grid, preferring some in the fill zone.\"\"\"\n    placed = []\n    n_fill = random.randint(0, min(n_obstacles, len(fill_candidates)))\n    if fill_candidates and random.random() < OBSTACLE_IN_FILL_PROB:\n        n_fill = max(1, n_fill)\n    for p in fill_candidates:\n        if len(placed) >= n_fill:\n            break\n        if _obstacle_fits(p, placed):\n            placed.append(p)\n    placed_set = set(placed)\n    for p in candidates:\n        if len(placed) >= n_obstacles:\n            break\n        if p not in placed_set and _obstacle_fits(p, placed):\n            placed.append(p)\n            placed_set.add(p)\n    for i, (r, c) in enumerate(placed):\n        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]\n\n\ndef _touches_border(mask):\n    \"\"\"Check if any True cell in mask lies on the grid border.\"\"\"\n    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())\n\n\ndef _gen_attempt():\n    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])\n    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)\n    w = random.randint(*GRID_W)\n\n    built = _build_local_wall(rad, h, w)\n    if built is None:\n        return None\n    local_wall, depth, gap = built\n    anchor = _place_anchor(rad, h, w, depth, gap)\n\n    # Choose palette\n    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))\n    bg, wall_color, fill_color = palette[:3]\n    obstacle_colors = palette[3:]\n\n    # Render wall onto grid\n    grid = np.full((h, w), bg, dtype=int)\n    for u, v in local_wall:\n        r, c = _map_local(u, v, rad, anchor)\n        grid[r, c] = wall_color\n\n    # Place fill seed near the closed end\n    interior = _local_interior(local_wall, depth, gap)\n    wall_set = set(local_wall)\n    adjacent = [\n        p for p in interior\n        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])\n    ]\n    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]\n    if not seed_pool:\n        return None\n\n    blob = _grow_seed_blob(random.choice(seed_pool), set(interior))\n    for u, v in blob:\n        r, c = _map_local(u, v, rad, anchor)\n        if grid[r, c] != bg:\n            return None\n        grid[r, c] = fill_color\n\n    # Run solver to find nominal fill zone (used for obstacle placement)\n    try:\n        nominal_out = main(grid)\n    except Exception:\n        return None\n    nominal_fill_zone = (nominal_out == fill_color) & (grid == bg)\n\n    # Place obstacles\n    n_obstacles = random.randint(0, MAX_OBSTACLES)\n    if n_obstacles and not obstacle_colors:\n        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]\n        obstacle_colors = random.sample(available, random.randint(1, 2))\n    if n_obstacles:\n        candidates, fill_candidates = _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone)\n        _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid)\n\n    # Validate: solver must produce enough fill that reaches a border\n    try:\n        out = main(grid)\n    except Exception:\n        return None\n    new_fill = (out == fill_color) & (grid == bg)\n    if int(new_fill.sum()) < MIN_NEW_FILL or not _touches_border(new_fill):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid b9e38dc0 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def generate_input(/p;/''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def generate_input(/p;/''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\ndef _get_enclosed_holes(sprite):\n    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n    h, w = sprite.shape\n    return [pts for pts in components_mask(~sprite, connectivity=4)\n            if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n\n\ndef _make_diamond():\n    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n    s = np.zeros((3, 3), dtype=bool)\n    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n    return s\n\n\ndef _make_hollow_sprite(h, w, rng):\n    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n    sprite = np.ones((h, w), dtype=bool)\n    if h >= 3 and w >= 3:\n        sprite[1:-1, 1:-1] = False\n    # Optionally add internal horizontal wall\n    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n        br = rng.randint(2, h - 2)\n        n = rng.randint(1, w - 2)\n        s = rng.randint(1, w - 1 - n + 1)\n        sprite[br, s:s + n] = True\n    # Optionally add internal vertical wall\n    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n        bc = rng.randint(2, w - 2)\n        n = rng.randint(1, h - 2)\n        s = rng.randint(1, h - 1 - n + 1)\n        sprite[s:s + n, bc] = True\n    # Optionally remove border cells for irregularity\n    if rng.random() < _P_BORDER_REMOVAL:\n        bcells = [(r, c) for r in range(h) for c in range(w)\n                  if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n        rng.shuffle(bcells)\n        for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n            test = sprite.copy()\n            test[cr, cc] = False\n            if _get_enclosed_holes(test):\n                sprite = test\n    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n        return None\n    return sprite\n\n\ndef _choose_colors(rng, N, num_filled):\n    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n    all_c = list(range(1, 10))\n    rng.shuffle(all_c)\n    border_keys = all_c[:N]\n    rng.shuffle(all_c)\n    fill_values = all_c[:N]\n    dist_cands = [c for c in range(1, 10) if c not in border_keys]\n    distractor_color = rng.choice(dist_cands)\n    mapping = dict(zip(border_keys, fill_values))\n    filled_keys = rng.sample(border_keys, num_filled)\n    return border_keys, fill_values, distractor_color, mapping, filled_keys\n\n\ndef _build_palette(side, border_keys, fill_values):\n    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n    N = len(border_keys)\n    if side in ('top', 'bottom'):\n        pal = np.zeros((2, N), dtype=int)\n        outer, inner = (0, 1) if side == 'top' else (1, 0)\n        pal[outer] = border_keys\n        pal[inner] = fill_values\n    else:\n        pal = np.zeros((N, 2), dtype=int)\n        outer, inner = (0, 1) if side == 'left' else (1, 0)\n        pal[:, outer] = border_keys\n        pal[:, inner] = fill_values\n    return pal\n\n\ndef _place_palette(grid, occ, pal, side, rng):\n    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n    H, W = grid.shape\n    pal_h, pal_w = pal.shape\n    if side == 'top':\n        pr0, pc0 = 0, rng.randint(0, W - pal_w)\n    elif side == 'bottom':\n        pr0, pc0 = H - pal_h, rng.randint(0, W - pal_w)\n    elif side == 'left':\n        pr0, pc0 = rng.randint(0, H - pal_h), 0\n    else:\n        pr0, pc0 = rng.randint(0, H - pal_h), W - pal_w\n    grid[pr0:pr0 + pal_h, pc0:pc0 + pal_w] = pal\n    occ[max(0, pr0 - 1):min(H, pr0 + pal_h + 1),\n        max(0, pc0 - 1):min(W, pc0 + pal_w + 1)] = True\n\n\ndef _find_valid_positions(H, W, occ, mask, holes):\n    \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n    sh, sw = mask.shape\n    positions = []\n    for r0 in range(H - sh + 1):\n        for c0 in range(W - sw + 1):\n            if occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n                   max(0, c0 - 1):min(W, c0 + sw + 1)].any():\n                continue\n            if any(r0 + hr == 0 or c0 + hc == 0 or r0 + hr == H - 1 or c0 + hc == W - 1\n                   for hpts in holes for hr, hc in hpts):\n                continue\n            positions.append((r0, c0))\n    return positions\n\n\ndef _paint_sprite(grid, r0, c0, mask, color, fill, holes):\n    \"\"\"Render a sprite onto the grid: border cells in color, hole cells in fill (if given).\"\"\"\n    grid[r0:r0 + mask.shape[0], c0:c0 + mask.shape[1]][mask] = color\n    if fill is not None:\n        for hpts in holes:\n            for hr, hc in hpts:\n                grid[r0 + hr, c0 + hc] = fill\n\n\ndef _gen_attempt():\n    rng = random.Random()\n    bg = 0\n\n    # Grid size and palette side\n    H = rng.randint(_GRID_H_MIN, _GRID_H_MAX)\n    W = rng.randint(_GRID_W_MIN, _GRID_W_MAX)\n    side = rng.choice(['top', 'bottom', 'left', 'right'])\n    if H <= _SMALL_H_THRESHOLD and side in ('top', 'bottom') and rng.random() < _SMALL_H_PALETTE_FLIP:\n        side = rng.choice(['left', 'right'])\n\n    max_N = H if side in ('left', 'right') else W\n    N = rng.randint(_PALETTE_N_MIN, min(_PALETTE_N_MAX, max_N))\n\n    # Sprite dimension bounds\n    max_sh = min(_SPRITE_H_MAX, H)\n    max_sw = min(_SPRITE_W_MAX, W)\n    if H <= _TINY_H_THRESHOLD:\n        max_sh = 3\n\n    # Sprite counts\n    num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, N))\n    total_sprites = num_filled + 1\n\n    # Generate sprite shapes\n    shapes = []\n    for _ in range(total_sprites):\n        sh = rng.randint(3, max_sh)\n        sw = rng.randint(3, max_sw)\n        if sh + sw > _SPRITE_DIM_SUM_CAP:\n            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)\n        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:\n            mask = _make_diamond()\n        else:\n            mask = _make_hollow_sprite(sh, sw, rng)\n        if mask is None:\n            return None\n        shapes.append(mask)\n\n    # Colors and palette\n    border_keys, fill_values, distractor_color, mapping, filled_keys = \\\n        _choose_colors(rng, N, num_filled)\n    pal = _build_palette(side, border_keys, fill_values)\n\n    grid = np.full((H, W), bg, dtype=int)\n    occ = np.zeros((H, W), dtype=bool)\n    _place_palette(grid, occ, pal, side, rng)\n\n    # Assign colors to sprites: filled sprites use palette keys, last one is distractor\n    infos = []\n    for i, mask in enumerate(shapes):\n        if i < num_filled:\n            c, f = filled_keys[i], mapping[filled_keys[i]]\n        else:\n            c, f = distractor_color, None\n        infos.append((mask, c, f))\n\n    # Place sprites\n    placed = []\n    for mask, color, fill in infos:\n        holes = _get_enclosed_holes(mask)\n        positions = _find_valid_positions(H, W, occ, mask, holes)\n        if not positions:\n            return None\n        r0, c0 = rng.choice(positions)\n        _paint_sprite(grid, r0, c0, mask, color, fill, holes)\n        placed.append((r0, c0, mask, fill))\n        sh, sw = mask.shape\n        occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n            max(0, c0 - 1):min(W, c0 + sw + 1)] = True\n\n    # Derive input from output by clearing filled holes\n    output = grid.copy()\n    inp = grid.copy()\n    for r0, c0, mask, fill in placed:\n        if fill is not None:\n            for hpts in _get_enclosed_holes(mask):\n                for hr, hc in hpts:\n                    inp[r0 + hr, c0 + hc] = bg\n\n    # Validate bg is dominant on border\n    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    if int(vals[cnts.argmax()]) != bg:\n        return None\n\n    # Oracle check\n    try:\n        if np.array_equal(main(inp), output):\n            return inp\n    except Exception:\n        pass\n    return None\n\n\ndef generate_input():\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def generate_input(/p;/''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/465b7d93.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def generate_input(/p;/''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/465b7d93.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.\n\n    Input structure:\n    - The background is the dominant color.\n    - There are exactly two foreground colors: one forms a complete rectangular\n      one-pixel-thick frame, and the other forms one 4-connected sprite outside it.\n    - The frame interior is initially background.\n\n    Rule:\n    - Clear the original sprite from its outside location.\n    - Map the sprite bbox to the frame interior bbox, sending bbox extremes to\n      interior extremes.\n    - Draw straight horizontal or vertical segments between mapped positions of\n      adjacent sprite pixels, then fill any enclosed background region inside\n      those drawn segments.\n\n    Key insight:\n    The outside sprite is a miniature line/fill diagram for the frame interior,\n    not a bitmap to scale by block replication.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected one frame color and one sprite color\"\n\n    frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []\n    for color in colors:\n        frame_bbox = _rect_frame_bbox(g == int(color))\n        if frame_bbox is not None:\n            frame_candidates.append((int(color), frame_bbox))\n    assert len(frame_candidates) == 1, \"expected a unique rectangular frame\"\n\n    frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]\n    sprite_color = next(color for color in colors if color != frame_color)\n    sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)\n    assert len(sprite_components) == 1, \"expected a single 4-connected sprite\"\n    frame_region = np.zeros_like(g, dtype=bool)\n    frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True\n    assert not np.any((g == sprite_color) & frame_region), \"sprite must start outside the frame\"\n\n    sr0, sc0, sr1, sc1 = sprite_components[0][\"bbox\"]\n    sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color\n\n    ir0, ic0 = fr0 + 1, fc0 + 1\n    ir1, ic1 = fr1 - 1, fc1 - 1\n    assert ir0 <= ir1 and ic0 <= ic1, \"frame must have an interior\"\n    interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]\n    assert np.all(interior == bg), \"frame interior must start empty\"\n\n    stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))\n    out = g.copy()\n    out[g == sprite_color] = bg\n    out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and observed fixed colors.\n_GRID_SHAPE = (10, 10)\n_COLOR_COUNT = 10\n_BG = 7\n_FRAME_COLOR = 6\n\n# Frame size bounds and retry budget.\n_FRAME_SIZE_MIN = 3\n_FRAME_SIZE_MAX = 8\n_SINGLE_PIXEL_FRAME_SIZE = 3\n_MAX_GENERATION_ATTEMPTS = 300\n\n# Sprite color pool and source masks.\n_SPRITE_COLORS = tuple(c for c in range(_COLOR_COUNT) if c not in {_BG, _FRAME_COLOR})\n_SPRITE_SINGLE = np.ones((1, 1), dtype=bool)\n_SPRITE_PATTERNS_2X2 = [\n    np.array([[1, 1], [1, 0]], dtype=bool),\n    np.array([[1, 1], [0, 1]], dtype=bool),\n    np.array([[1, 0], [1, 1]], dtype=bool),\n    np.array([[0, 1], [1, 1]], dtype=bool),\n    np.array([[1, 1], [1, 1]], dtype=bool),\n]\n\ndef _outside_locations(\n    frame_bbox: tuple[int, int, int, int], patch_shape: tuple[int, int]\n) -> list[tuple[int, int]]:\n    fr0, fc0, fr1, fc1 = frame_bbox\n    ph, pw = patch_shape\n    locations: list[tuple[int, int]] = []\n    for r in range(_GRID_SHAPE[0] - ph + 1):\n        for c in range(_GRID_SHAPE[1] - pw + 1):\n            pr0, pc0, pr1, pc1 = r, c, r + ph - 1, c + pw - 1\n            separated = pr1 < fr0 or pr0 > fr1 or pc1 < fc0 or pc0 > fc1\n            if separated:\n                locations.append((r, c))\n    return locations\n\ndef _frame_positions(size: int, patch_shape: tuple[int, int]) -> list[tuple[int, int]]:\n    positions: list[tuple[int, int]] = []\n    for r in range(_GRID_SHAPE[0] - size + 1):\n        for c in range(_GRID_SHAPE[1] - size + 1):\n            frame_bbox = (r, c, r + size - 1, c + size - 1)\n            if _outside_locations(frame_bbox, patch_shape):\n                positions.append((r, c))\n    return positions\n\ndef _draw_frame(grid: np.ndarray, r0: int, c0: int, size: int, color: int) -> None:\n    r1, c1 = r0 + size - 1, c0 + size - 1\n    grid[r0 : r1 + 1, c0] = color\n    grid[r0 : r1 + 1, c1] = color\n    grid[r0, c0 : c1 + 1] = color\n    grid[r1, c0 : c1 + 1] = color\n\ndef _sample_sprite(size: int) -> np.ndarray:\n    return _SPRITE_SINGLE.copy() if size == _SINGLE_PIXEL_FRAME_SIZE else random.choice(_SPRITE_PATTERNS_2X2).copy()\n\ndef _sample_case() -> tuple[int, int, np.ndarray]:\n    sprite_color = random.choice(_SPRITE_COLORS)\n    size = random.randint(_FRAME_SIZE_MIN, _FRAME_SIZE_MAX)\n    return sprite_color, size, _sample_sprite(size)\n\ndef _build_candidate_grids(\n    frame_bbox: tuple[int, int, int, int], sprite: np.ndarray, sprite_color: int\n) -> tuple[np.ndarray, np.ndarray] | None:\n    fr0, fc0, fr1, fc1 = frame_bbox\n    stretched = _stretch_sprite(sprite, (fr1 - fr0 - 1, fc1 - fc0 - 1))\n    if not np.any(stretched):\n        return None\n\n    out = np.full(_GRID_SHAPE, _BG, dtype=int)\n    _draw_frame(out, fr0, fc0, fr1 - fr0 + 1, _FRAME_COLOR)\n    out[fr0 + 1 : fr1, fc0 + 1 : fc1][stretched] = sprite_color\n\n    inp = out.copy()\n    inp[fr0 + 1 : fr1, fc0 + 1 : fc1] = _BG\n\n    locations = _outside_locations(frame_bbox, sprite.shape)\n    if not locations:\n        return None\n    sr, sc = random.choice(locations)\n    patch = np.where(sprite, sprite_color, _BG)\n    paste(inp, patch, sr, sc, transparent=_BG)\n    return inp, out\n\ndef _gen_attempt() -> np.ndarray | None:\n    sprite_color, size, sprite = _sample_case()\n\n    frame_positions = _frame_positions(size, sprite.shape)\n    if not frame_positions:\n        return None\n    fr0, fc0 = random.choice(frame_positions)\n    frame_bbox = (fr0, fc0, fr0 + size - 1, fc0 + size - 1)\n\n    candidate = _build_candidate_grids(frame_bbox, sprite, sprite_color)\n    if candidate is None:\n        return None\n    inp, out = candidate\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(_MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 465b7d93 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def generate_input(/p;/''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def generate_input(/p;/''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n\n    Input structure:\n    - The grid has a dominant background color.\n    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n\n    Rule:\n    - Keep the input pixels unchanged.\n    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n\n    Key insight:\n    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    out = g.copy()\n    h, w = g.shape\n\n    markers: dict[int, int] = {}\n    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n            continue\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n        source = int(sub[0, 0])\n        halo = int(sub[0, 1])\n        assert source != halo, \"legend source and halo colors must differ\"\n        assert source not in markers, \"each source color must have exactly one legend marker\"\n\n        markers[source] = halo\n        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n\n    assert markers, \"expected at least one left-edge legend marker\"\n\n    for source, halo in markers.items():\n        objects = []\n        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n            if cells <= marker_source_cells[source]:\n                continue\n            objects.append(comp)\n        assert objects, \"each legend source color must label at least one non-marker object\"\n\n        for obj in objects:\n            r0, c0, r1, c1 = obj[\"bbox\"]\n            pr0 = max(0, int(r0) - 1)\n            pc0 = max(0, int(c0) - 1)\n            pr1 = min(h - 1, int(r1) + 1)\n            pc1 = min(w - 1, int(c1) + 1)\n\n            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n            coords = obj[\"coords\"]\n            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n            enclosed = object_interior(patch, background=bg)\n            fill_mask = (patch == bg) & ~enclosed\n\n            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n            target[fill_mask] = halo\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and color palette.\nBACKGROUND = 0\nGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\nAVAILABLE_COLORS = tuple(range(1, 10))\n\n# Legend layout.\nLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\nLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n\n# Sprite geometry and acceptance.\nSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\nSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\nSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\nSPRITE_RETRIES = 300\n\n# Object counts and placement.\nINSTANCE_MIN, INSTANCE_MAX = 1, 3\nOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\nEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\nPLACEMENT_RETRIES = 200\n\n# Whole-sample retry budget.\nGENERATION_RETRIES = 300\n\n\ndef _make_sprite(color):\n    \"\"\"Construct one LR-symmetric 4-connected sprite matching the configured area/hole bounds.\"\"\"\n    target_area = random.randint(SPRITE_AREA_MIN, SPRITE_AREA_MAX)\n    for _ in range(SPRITE_RETRIES):\n        fill_p = target_area / (SPRITE_SIZE * SPRITE_SIZE) + random.uniform(-SPRITE_FILL_JITTER, SPRITE_FILL_JITTER)\n        sprite = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=int)\n        for r in range(SPRITE_SIZE):\n            for c in range(SPRITE_MIRROR_COLS):\n                if random.random() < fill_p:\n                    sprite[r, c] = color\n                    sprite[r, SPRITE_SIZE - 1 - c] = color\n        area = int(np.count_nonzero(sprite))\n        if area != target_area:\n            continue\n        if not is_contiguous(sprite, background=BACKGROUND, connectivity=4):\n            continue\n        if not (np.any(sprite[0] != BACKGROUND) and np.any(sprite[-1] != BACKGROUND) and\n                np.any(sprite[:, 0] != BACKGROUND) and np.any(sprite[:, -1] != BACKGROUND)):\n            continue\n        padded = np.zeros((SPRITE_SIZE + 2, SPRITE_SIZE + 2), dtype=int)\n        padded[1:-1, 1:-1] = sprite\n        interior = object_interior(padded, background=BACKGROUND)\n        holes = int(np.sum(interior & (padded == BACKGROUND)))\n        if holes > MAX_INTERIOR_HOLES:\n            continue\n        return sprite\n    return None\n\n\ndef _boxes_overlap(a, b):\n    return a[0] <= b[2] and a[2] >= b[0] and a[1] <= b[3] and a[3] >= b[1]\n\n\ndef _draw_legend(grid, src1, halo1, src2, halo2):\n    lower_top = grid.shape[0] - LEGEND_MARKER_SIZE\n    upper_top = lower_top - LEGEND_VERTICAL_GAP - LEGEND_MARKER_SIZE\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src1\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo1\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src2\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo2\n    return (upper_top, LEGEND_SOURCE_COL, grid.shape[0] - 1, LEGEND_HALO_COL)\n\n\ndef _visible_window(sprite, size, r0, c0):\n    \"\"\"Return the visible grid bbox and matching sprite slice for a possibly clipped sprite.\"\"\"\n    vr0, vc0 = max(0, r0), max(0, c0)\n    vr1 = min(size - 1, r0 + SPRITE_SIZE - 1)\n    vc1 = min(size - 1, c0 + SPRITE_SIZE - 1)\n    visible = sprite[vr0 - r0:vr1 - r0 + 1, vc0 - c0:vc1 - c0 + 1]\n    return (vr0, vc0, vr1, vc1), visible\n\n\ndef _padded_bbox(visible_box, size):\n    vr0, vc0, vr1, vc1 = visible_box\n    return (max(0, vr0 - HALO_PADDING), max(0, vc0 - HALO_PADDING),\n            min(size - 1, vr1 + HALO_PADDING), min(size - 1, vc1 + HALO_PADDING))\n\n\ndef _place_objects(size, tasks, legend_box):\n    \"\"\"Choose non-overlapping object origins; returns placement tuples or None on retry exhaustion.\"\"\"\n    placed = []\n    placements = []\n    for sprite, sc, hc in tasks:\n        for _ in range(PLACEMENT_RETRIES):\n            if random.random() < EDGE_CLIP_PROB:\n                r0 = random.randint(-EDGE_CLIP_MARGIN, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n            else:\n                r0 = random.randint(0, size - SPRITE_SIZE)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE)\n            visible_box, visible = _visible_window(sprite, size, r0, c0)\n            if np.count_nonzero(visible) == 0:\n                continue\n\n            pbox = _padded_bbox(visible_box, size)\n            if (pbox[1] < OBJECT_MIN_COL or _boxes_overlap(pbox, legend_box) or\n                    any(_boxes_overlap(pbox, eb) for eb in placed)):\n                continue\n\n            placed.append(pbox)\n            placements.append((sprite, sc, hc, r0, c0))\n            break\n        else:\n            return None\n    return placements\n\n\ndef _render_output(grid, placements):\n    \"\"\"Render the paired output and return the generated input with halo-fill cells removed.\"\"\"\n    size = grid.shape[0]\n    output = grid.copy()\n    halo_mask = np.zeros((size, size), dtype=bool)\n\n    for sprite, sc, hc, r0, c0 in placements:\n        visible_box, visible = _visible_window(sprite, size, r0, c0)\n        vr0, vc0, vr1, vc1 = visible_box\n        output_region = output[vr0:vr1 + 1, vc0:vc1 + 1]\n        output_region[visible != BACKGROUND] = sc\n\n        pr0, pc0, pr1, pc1 = _padded_bbox(visible_box, size)\n        patch = np.zeros((pr1 - pr0 + 1, pc1 - pc0 + 1), dtype=int)\n        patch_region = patch[vr0 - pr0:vr1 - pr0 + 1, vc0 - pc0:vc1 - pc0 + 1]\n        patch_region[visible != BACKGROUND] = sc\n\n        enclosed = object_interior(patch, background=BACKGROUND)\n        fill = (patch == BACKGROUND) & ~enclosed\n        output_region = output[pr0:pr1 + 1, pc0:pc1 + 1]\n        output_region[fill] = hc\n        halo_region = halo_mask[pr0:pr1 + 1, pc0:pc1 + 1]\n        halo_region[fill] = True\n\n    inp = output.copy()\n    inp[halo_mask] = BACKGROUND\n    return inp, output\n\n\ndef _matches_oracle(inp, output):\n    try:\n        return np.array_equal(main(inp), output)\n    except Exception:\n        return False\n\n\ndef _gen_attempt():\n    sz = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    colors = list(AVAILABLE_COLORS)\n    random.shuffle(colors)\n    src1, halo1, src2, halo2 = colors[:4]\n\n    sprite1 = _make_sprite(src1)\n    sprite2 = _make_sprite(src2)\n    if sprite1 is None or sprite2 is None:\n        return None\n\n    n1 = random.randint(INSTANCE_MIN, INSTANCE_MAX)\n    n2 = random.randint(INSTANCE_MIN, INSTANCE_MAX)\n    tasks = [(sprite1, src1, halo1)] * n1 + [(sprite2, src2, halo2)] * n2\n    random.shuffle(tasks)\n\n    grid = np.zeros((sz, sz), dtype=int)\n    legend_box = _draw_legend(grid, src1, halo1, src2, halo2)\n\n    placements = _place_objects(sz, tasks, legend_box)\n    if placements is None:\n        return None\n\n    inp, output = _render_output(grid, placements)\n    if _matches_oracle(inp, output):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
