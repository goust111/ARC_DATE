in_{type(e).__name__}'] += 1\n        continue\n    if not np.array_equal(actual, expected):\n        reasons['mismatch'] += 1\n        continue\n    reasons['success'] += 1\nprint(reasons)\nPY\"","aggregated_output":"Counter({'place_occupied': 3169, 'mismatch': 180, 'placement_fail': 20, 'place_bbox_hits_ray': 20, 'place_lane_blocked': 10, 'place_used_line': 1})\n","exit_code":0,"status":"completed"}}
