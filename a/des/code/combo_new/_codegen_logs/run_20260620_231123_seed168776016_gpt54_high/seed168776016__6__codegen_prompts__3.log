{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/5623160b.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\nMARKER_COLOR = 9\nDIRECTIONS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _outward_direction(g: np.ndarray, coords: np.ndarray) -> tuple[int, int]:\n    H, W = g.shape\n    directions: set[tuple[int, int]] = set()\n    for r, c in coords:\n        rr = int(r)\n        cc = int(c)\n        for dr, dc in DIRECTIONS:\n            nr = rr + dr\n            nc = cc + dc\n            if 0 <= nr < H and 0 <= nc < W and int(g[nr, nc]) == MARKER_COLOR:\n                directions.add((-dr, -dc))\n\n    assert len(directions) == 1, \"each moving object must touch maroon markers on exactly one side\"\n    return directions.pop()\n\n\ndef _steps_to_edge(shape: tuple[int, int], coords: np.ndarray, direction: tuple[int, int]) -> int:\n    H, W = shape\n    dr, dc = direction\n    assert (dr == 0) != (dc == 0), \"movement direction must be cardinal\"\n    if dr < 0:\n        return int(coords[:, 0].min())\n    if dr > 0:\n        return int(H - 1 - coords[:, 0].max())\n    if dc < 0:\n        return int(coords[:, 1].min())\n    assert dc > 0\n    return int(W - 1 - coords[:, 1].max())\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Push every colored object touching maroon markers straight outward until it reaches the grid edge.\n\n    Input structure:\n    - The background is the dominant color.\n    - Maroon pixels are fixed markers.\n    - Every other foreground 4-connected object touches the marker pixels on exactly one cardinal side.\n\n    Rule:\n    - Clear each non-background, non-maroon object from its original position.\n    - Translate it in the direction away from its maroon contact until the object reaches the grid boundary.\n    - Keep the maroon marker pixels unchanged.\n\n    Key insight:\n    - The maroon contact side is a launcher: it determines a unique outward ray for the whole object, and the edge of the grid determines the translation distance.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg != MARKER_COLOR\n    assert bool(np.any(g == MARKER_COLOR))\n\n    marker_components = find_components(\n        g,\n        bg=bg,\n        connectivity=4,\n        monochromatic=True,\n        colors=[MARKER_COLOR],\n        return_format=\"dict\",\n    )\n    assert 1 <= len(marker_components) <= 3, \"maroon markers must form 1-3 moderate components\"\n    assert sum(int(comp[\"area\"]) for comp in marker_components) <= 17, \"maroon marker area must be moderate\"\n    assert all(int(comp[\"area\"]) <= 9 for comp in marker_components), \"each maroon component must be moderate\"\n\n    out = g.copy()\n    placements: list[tuple[int, np.ndarray]] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        color = int(comp[\"color\"])\n        if color == MARKER_COLOR:\n            continue\n\n        coords = comp[\"coords\"].astype(int, copy=False)\n        direction = _outward_direction(g, coords)\n        steps = _steps_to_edge(g.shape, coords, direction)\n        assert steps <= 8, \"push distance must stay within the observed moderate range\"\n        offset = np.array(direction, dtype=int) * steps\n        shifted = coords + offset\n        assert bool(\n            np.all(\n                (0 <= shifted[:, 0])\n                & (shifted[:, 0] < g.shape[0])\n                & (0 <= shifted[:, 1])\n                & (shifted[:, 1] < g.shape[1])\n            )\n        )\n        own = {tuple(coord) for coord in coords.tolist()}\n        for step in range(1, steps + 1):\n            swept = coords + np.array(direction, dtype=int) * step\n            for rr, cc in swept:\n                loc = (int(rr), int(cc))\n                assert loc in own or int(g[loc]) == bg, \"object movement path must be unobstructed\"\n\n        out[coords[:, 0], coords[:, 1]] = bg\n        placements.append((color, shifted))\n\n    assert placements\n    for color, coords in placements:\n        assert bool(np.all(out[coords[:, 0], coords[:, 1]] == bg)), \"moved objects must not collide\"\n        out[coords[:, 0], coords[:, 1]] = color\n\n    return out\n\n# --------------- generator (attempt 1 refined) ---------------\n\n# Generated grid colors.\nBG = 7\nMAROON = 9\nALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8]\nDIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n# Canvas and maroon marker bounds.\nGRID_SIZE_MIN = 9\nGRID_SIZE_MAX = 16\nMAROON_COMPONENT_MIN = 1\nMAROON_COMPONENT_MAX = 3\nMAROON_TOTAL_AREA_MAX = 17\nMAROON_COMPONENT_AREA_MAX = 9\nINTERIOR_PADDING = 1\nMAROON_PLACEMENT_TRIES = 80\n\n# Moving object bounds and push constraints.\nOBJECT_COUNT_MIN = 3\nOBJECT_COUNT_MAX = 7\nOBJECT_SIZE_MIN = 1\nOBJECT_SIZE_MAX = 5\nPUSH_DISTANCE_MAX = 8\nZERO_STEP_PROBABILITY = 0.25\nZERO_STEP_ALLOWANCE = 1\n\n# Retry limits for object placement and whole-grid generation.\nOBJECT_SHAPE_TRIES = 20\nCONTACT_CANDIDATE_LIMIT = 5\nGENERATE_RETRIES = 300\n\n\ndef _grow_polyomino(size, rng):\n    \"\"\"Grow a 4-connected polyomino of given size, normalized to (0, 0).\"\"\"\n    cells = {(0, 0)}\n    frontier = [(0, 0)]\n    while len(cells) < size:\n        r, c = rng.choice(frontier)\n        nbrs = [(r-1, c), (r+1, c), (r, c-1), (r, c+1)]\n        rng.shuffle(nbrs)\n        grown = False\n        for nr, nc in nbrs:\n            if (nr, nc) not in cells:\n                cells.add((nr, nc))\n                frontier.append((nr, nc))\n                grown = True\n                break\n        if not grown:\n            frontier.remove((r, c))\n            if not frontier:\n                break\n\n    min_r = min(r for r, c in cells)\n    min_c = min(c for r, c in cells)\n    return [(r - min_r, c - min_c) for r, c in cells]\n\n\ndef _gen_steps_to_edge(N, coords, direction):\n    arr = np.array(coords, dtype=int)\n    dr, dc = direction\n    if dr == -1:\n        return int(arr[:, 0].min())\n    if dr == 1:\n        return int(N - 1 - arr[:, 0].max())\n    if dc == -1:\n        return int(arr[:, 1].min())\n    return int(N - 1 - arr[:, 1].max())\n\n\ndef _swept_cells(N, coords, direction):\n    dr, dc = direction\n    steps = _gen_steps_to_edge(N, coords, direction)\n    own = set(coords)\n    swept = set()\n    for step in range(1, steps + 1):\n        for r, c in coords:\n            loc = (r + dr * step, c + dc * step)\n            if loc not in own:\n                swept.add(loc)\n    return swept\n\n\ndef _paths_are_clear(inp, objects):\n    N = inp.shape[0]\n    for _, inp_coords, _, direction in objects:\n        for r, c in _swept_cells(N, inp_coords, direction):\n            if inp[r, c] != BG:\n                return False\n    return True\n\n\ndef _paint_cells(grid, coords, color):\n    for r, c in coords:\n        grid[r, c] = color\n\n\ndef _place_maroon_components(rng, grid, num_maroon):\n    \"\"\"Place separated maroon components; returns (components, occupied) or None.\"\"\"\n    N = grid.shape[0]\n    maroon_components = []\n    all_maroon = set()\n    total_maroon = 0\n\n    for idx in range(num_maroon):\n        remaining_components = num_maroon - idx - 1\n        max_size = min(\n            MAROON_COMPONENT_AREA_MAX,\n            MAROON_TOTAL_AREA_MAX - total_maroon - remaining_components,\n        )\n        if max_size < 1:\n            return None\n\n        size = rng.randint(1, max_size)\n        cells = _grow_polyomino(size, rng)\n        h = max(r for r, c in cells) + 1\n        w = max(c for r, c in cells) + 1\n        if h > N - 2 or w > N - 2:\n            return None\n\n        placed = _try_place_maroon_component(rng, grid, cells, all_maroon)\n        if placed is None:\n            return None\n\n        _paint_cells(grid, placed, MAROON)\n        maroon_components.append(placed)\n        all_maroon.update(placed)\n        total_maroon += size\n\n    return maroon_components, all_maroon\n\n\ndef _try_place_maroon_component(rng, grid, cells, all_maroon):\n    N = grid.shape[0]\n    h = max(r for r, c in cells) + 1\n    w = max(c for r, c in cells) + 1\n    for _ in range(MAROON_PLACEMENT_TRIES):\n        r0 = rng.randint(INTERIOR_PADDING, N - INTERIOR_PADDING - h)\n        c0 = rng.randint(INTERIOR_PADDING, N - INTERIOR_PADDING - w)\n        abs_cells = [(r + r0, c + c0) for r, c in cells]\n        if not all(grid[r, c] == BG for r, c in abs_cells):\n            continue\n        if any((r + dr, c + dc) in all_maroon for r, c in abs_cells for dr, dc in DIRS):\n            continue\n        return abs_cells\n    return None\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/271d71e2.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom scipy.ndimage import label\nfrom arc_utils import STRUCT4, bbox_coords, colors_present, components_mask, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move bordered containers toward same-colored destination markers, charging gray cells to orange.\n\n    Input structure:\n    - bg = 6 (magenta). Black-bordered (0) rectangles with gray (5) / orange (7) interiors.\n    - A head sprite (9) sits adjacent to one container edge; a matching destination sprite lies along the movement axis.\n\n    Rule:\n    - Each container translates toward its destination along the head-to-dest axis.\n    - Steps = min(head-to-dest distance, number of gray interior cells).\n    - Gray cells become orange from the head-facing side inward, one per step.\n\n    Key insight: Gray cell count caps movement — a container stops short if it runs out of gray cells to charge.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    BORDER = 0\n    GREY = 5\n    FILL = 7\n    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    # True background is dominant non-border color (border can dominate in some cases).\n    cnt = Counter(map(int, g.flatten()))\n    bg = int(max((c for c in cnt.keys() if int(c) != int(BORDER)), key=lambda c: int(cnt[int(c)])))\n\n    def rect_border_coords(r0: int, c0: int, r1: int, c1: int):\n        for c in range(c0, c1 + 1):\n            yield (r0, c)\n            yield (r1, c)\n        for r in range(r0 + 1, r1):\n            yield (r, c0)\n            yield (r, c1)\n\n    # --- detect containers as rectangles enclosing GREY/FILL with BORDER frame ---\n    containers = []\n    for pts in components_mask((g == GREY) | (g == FILL), connectivity=4):\n        if pts.size == 0:\n            continue\n        ir0, ic0, ir1, ic1 = bbox_coords(pts)\n        r0, c0, r1, c1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)\n        if r0 < 0 or c0 < 0 or r1 >= H or c1 >= W:\n            continue\n        if any(int(g[r, c]) != BORDER for r, c in rect_border_coords(r0, c0, r1, c1)):\n            continue\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        if inner.size == 0 or not bool(np.isin(inner, [GREY, FILL]).all()):\n            continue\n        containers.append({\"box\": (r0, c0, r1, c1)})\n\n    assert not (not containers)\n\n    # head + destination are in some non-bg, non-border color (not GREY/FILL)\n    out = g.copy()\n\n    all_head_colors = [c for c in colors_present(g, exclude={bg, BORDER, GREY, FILL})]\n\n    # Precompute components for each head color.\n    comp_by_color: dict[int, list[dict]] = defaultdict(list)\n    for col in all_head_colors:\n        labc, nc = label(g == int(col), structure=STRUCT4)\n        for k in range(1, int(nc) + 1):\n            coords = np.argwhere(labc == int(k))\n            if coords.size == 0:\n                continue\n            r0, c0, r1, c1 = bbox_coords(coords)\n            pts = {(int(r), int(c)) for r, c in coords}\n            shape = {(int(r - r0), int(c - c0)) for r, c in pts}\n            comp_by_color[int(col)].append({\"pts\": pts, \"shape\": shape, \"tl\": (int(r0), int(c0))})\n\n    def pick_head_for_container(box_):\n        r0, c0, r1, c1 = box_\n        head_seeds = []\n        for r, c in rect_border_coords(r0, c0, r1, c1):\n            for dr, dc in DIR4:\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < H and 0 <= cc < W:\n                    val = int(g[rr, cc])\n                    if val not in (int(bg), int(BORDER), int(GREY), int(FILL)):\n                        head_seeds.append((rr, cc, val))\n        if not head_seeds:\n            return None\n\n        hc = int(Counter(val for _r, _c, val in head_seeds).most_common(1)[0][0])\n        seed_pts = {(r, c) for r, c, val in head_seeds if int(val) == int(hc)}\n        cands = comp_by_color.get(hc, [])\n        comp0 = None\n        for comp in cands:\n            if comp[\"pts\"] & seed_pts:\n                comp0 = comp\n                break\n        if comp0 is None:\n            return None\n\n        # Split head vs destination even if same-color pixels touch:\n        # head pixels are those with minimal manhattan distance to this container border.\n        border_pts = list(rect_border_coords(r0, c0, r1, c1))\n        best_d = None\n        dist = {}\n        for pr, pc in comp0[\"pts\"]:\n            d = min(abs(int(pr - br)) + abs(int(pc - bc)) for br, bc in border_pts)\n            dist[(int(pr), int(pc))] = int(d)\n            if best_d is None or d < best_d:\n                best_d = int(d)\n        if best_d is None:\n            return None\n        head_pts = {p for p, d in dist.items() if int(d) == int(best_d)}\n\n        # direction from head bbox relative to container box\n        coords = np.array(list(head_pts), dtype=int)\n        hr0, hc0, hr1, hc1 = bbox_coords(coords)\n        if hc1 < c0:\n            direction = (0, -1)\n        elif hc0 > c1:\n            direction = (0, 1)\n        elif hr1 < r0:\n            direction = (-1, 0)\n        elif hr0 > r1:\n            direction = (1, 0)\n        else:\n            direction = (0, 0)\n\n        # normalized head shape + top-left\n        r00, c00 = int(hr0), int(hc0)\n        head_shape = {(int(r - r00), int(c - c00)) for r, c in head_pts}\n        return {\n            \"color\": hc,\n            \"head_pts\": head_pts,\n            \"head_shape\": head_shape,\n            \"head_tl\": (r00, c00),\n            \"comp_pts\": set(comp0[\"pts\"]),\n            \"dir\": direction,\n        }\n\n    for cont in containers:\n        box_ = cont[\"box\"]\n        r0, c0, r1, c1 = box_\n\n        head_info = pick_head_for_container(box_)\n        if head_info is None:\n            continue\n        hc = int(head_info[\"color\"])\n        head_pts = set(head_info[\"head_pts\"])\n        head_shape = head_info[\"head_shape\"]\n        head_tl = head_info[\"head_tl\"]\n        comp_pts = set(head_info[\"comp_pts\"])\n        direction = head_info[\"dir\"]\n        if direction == (0, 0):\n            continue\n\n        # destination candidates\n        dests = []\n        for d in comp_by_color.get(hc, []):\n            if d[\"shape\"] != head_shape:\n                continue\n            if d[\"pts\"] == comp_pts:\n                continue\n            dests.append(d)\n\n        # add split-from-same-component destinations (when dest touches head by color)\n        rem = comp_pts - head_pts\n        if rem:\n            mask_rem = np.zeros((H, W), dtype=bool)\n            for rr, cc in rem:\n                mask_rem[int(rr), int(cc)] = True\n            labr, nr = label(mask_rem, structure=STRUCT4)\n            for k in range(1, int(nr) + 1):\n                pts = {(int(r), int(c)) for r, c in np.argwhere(labr == int(k))}\n                if not pts:\n                    continue\n                # reject if adjacent to BORDER\n                adj = False\n                for r, c in pts:\n                    for dr, dc in DIR4:\n                        rr, cc = int(r + dr), int(c + dc)\n                        if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(BORDER):\n                            adj = True\n                            break\n                    if adj:\n                        break\n                if adj:\n                    continue\n                rs = [r for r, _c in pts]\n                cs = [c for _r, c in pts]\n                r00, c00 = int(min(rs)), int(min(cs))\n                shp = {(int(r - r00), int(c - c00)) for r, c in pts}\n                if shp != head_shape:\n                    continue\n                dests.append({\"pts\": pts, \"shape\": shp, \"tl\": (r00, c00)})\n\n        if not dests:\n            continue\n\n        best = None\n        best_dest = None\n        for d in dests:\n            tr0 = int(d[\"tl\"][0] - head_tl[0])\n            tc0 = int(d[\"tl\"][1] - head_tl[1])\n            if direction[0] != 0 and tc0 != 0:\n                continue\n            if direction[1] != 0 and tr0 != 0:\n                continue\n            if direction[0] == 1 and tr0 <= 0:\n                continue\n            if direction[0] == -1 and tr0 >= 0:\n                continue\n            if direction[1] == 1 and tc0 <= 0:\n                continue\n            if direction[1] == -1 and tc0 >= 0:\n                continue\n            dist = abs(tr0) + abs(tc0)\n            if best is None or dist < best:\n                best = dist\n                best_dest = d\n        if best_dest is None:\n            continue\n\n        # translation to overlap head onto destination, capped by number of GREY cells\n        tr0 = int(best_dest[\"tl\"][0] - head_tl[0])\n        tc0 = int(best_dest[\"tl\"][1] - head_tl[1])\n        steps = abs(tr0) + abs(tc0)\n\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        grey_coords = [\n            (int(r0 + 1 + rr), int(c0 + 1 + cc))\n            for rr in range(inner.shape[0])\n            for cc in range(inner.shape[1])\n            if int(inner[rr, cc]) == GREY\n        ]\n        steps = min(int(steps), int(len(grey_coords)))\n\n        dr, dc = direction\n        tr = int(dr * steps)\n        tc = int(dc * steps)\n\n        # choose which greys to fill in order from head side inward\n        if direction == (0, 1):\n            order = sorted(grey_coords, key=lambda p: (-p[1], p[0]))\n        elif direction == (0, -1):\n            order = sorted(grey_coords, key=lambda p: (p[1], -p[0]))\n        elif direction == (1, 0):\n            order = sorted(grey_coords, key=lambda p: (-p[0], -p[1]))\n        else:  # (-1,0)\n            order = sorted(grey_coords, key=lambda p: (p[0], p[1]))\n        to_fill = set(order[:steps])\n\n        # erase original container rect and original head pixels (destination stays)\n        out[r0 : r1 + 1, c0 : c1 + 1] = int(bg)\n        for r, c in head_pts:\n            if int(out[int(r), int(c)]) == int(hc):\n                out[int(r), int(c)] = int(bg)\n\n","exit_code":0,"status":"completed"}}
