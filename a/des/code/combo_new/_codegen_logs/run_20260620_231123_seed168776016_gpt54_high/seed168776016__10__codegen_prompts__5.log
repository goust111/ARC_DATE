{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/42f83767.py | sed '\"'$d'\"'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/42f83767.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Expand the lower color grid by replacing each pixel with its matching top stencil.\n\n    Input structure\n    The input has a top legend and a lower dense color grid, separated by blank rows.\n    The legend contains left-to-right 2x2 color swatches and, to their right,\n    the same number of square neutral-color stencil masks.\n\n    Rule\n    Pair the swatches and stencil masks by left-to-right order. For every pixel in\n    the lower color grid, paste the paired stencil mask as one output block,\n    recoloring the mask pixels with that pixel's color and leaving mask holes as bg.\n\n    Key insight\n    The lower grid is not copied directly; it is an index grid whose colors select\n    the stencil shape from the legend, so each input pixel becomes one square block.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    row_runs = _runs(np.any(g != bg, axis=1))\n    assert len(row_runs) == 2\n    (top_r0, top_r1), (pattern_r0, pattern_r1) = row_runs\n    assert top_r0 == 0\n\n    stencil_size = top_r1 - top_r0 + 1\n    top = g[top_r0 : top_r1 + 1, :]\n    lower = g[pattern_r0 : pattern_r1 + 1, :]\n\n    pattern_box = bbox(lower != bg)\n    assert pattern_box is not None\n    pr0, pc0, pr1, pc1 = pattern_box\n    assert pr0 == 0 and pr1 == lower.shape[0] - 1\n    pattern = lower[:, pc0 : pc1 + 1]\n    assert np.all(pattern != bg)\n    pattern_colors = set(map(int, np.unique(pattern)))\n\n    top_colors = set(map(int, np.unique(top))) - {bg}\n    neutral_colors = top_colors - pattern_colors\n    assert len(neutral_colors) == 1\n    neutral = next(iter(neutral_colors))\n\n    swatches = []\n    for comp in find_components(top, bg=bg, colors=pattern_colors):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert comp[\"area\"] == 4\n        assert r1 - r0 + 1 == 2\n        assert c1 - c0 + 1 == 2\n        swatches.append((c0, int(comp[\"color\"])))\n    assert len(swatches) == len(pattern_colors)\n    assert len({c0 for c0, _color in swatches}) == len(swatches)\n\n    swatch_colors = [color for _c0, color in sorted(swatches)]\n    assert set(swatch_colors) == pattern_colors\n\n    stencil_col_runs = _runs(np.any(top == neutral, axis=0))\n    assert len(stencil_col_runs) == len(swatch_colors)\n\n    stencils = {}\n    for color, (c0, c1) in zip(swatch_colors, stencil_col_runs):\n        assert c1 - c0 + 1 == stencil_size\n        mask = top[:, c0 : c1 + 1] == neutral\n        assert mask.shape == (stencil_size, stencil_size)\n        assert np.any(mask)\n        stencils[color] = mask\n\n    h, w = pattern.shape\n    out = np.full((h * stencil_size, w * stencil_size), bg, dtype=int)\n    for r in range(h):\n        for c in range(w):\n            color = int(pattern[r, c])\n            assert color in stencils\n            block = out[\n                r * stencil_size : (r + 1) * stencil_size,\n                c * stencil_size : (c + 1) * stencil_size,\n            ]\n            block[stencils[color]] = color\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and legend geometry.\nBACKGROUND, NEUTRAL_COLOR, INPUT_ROWS = 0, 5, 15\nSWATCH_SIZE, SWATCH_STRIDE, STENCIL_GAP = 2, 3, 1\n\n# Structural size and palette bounds.\nCOLOR_COUNT_RANGE = (2, 4)\nSTENCIL_SIZE_RANGE, PATTERN_SIDE_RANGE = range(3, 7), range(4, 8)\nMAX_OUTPUT_SIDE, AVAILABLE_COLORS = 30, [1, 2, 3, 4, 6, 7, 8, 9]\nVALID_SIZE_PAIRS = [(s, p) for s in STENCIL_SIZE_RANGE for p in PATTERN_SIDE_RANGE if s * p <= MAX_OUTPUT_SIDE]\n\n# Stencil, pattern, and retry sampling.\nSTENCIL_FILL_RANGE = (0.60, 0.89)\nUNIQUE_STENCIL_RETRIES, GENERATION_RETRIES = 80, 300\nGAP_ROWS_RANGE = (1, 3)\nPATTERN_MODES = [\"iid\", \"rows\", \"cols\", \"checker\", \"tile\"]\nTILE_SIDE_RANGE = (2, 3)\n\n\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py | sed '\"'$d'\"'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py | sed '\"'$d'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py | sed '\"'$d'\"'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/753ea09b.py | sed '\"'$d'\"'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/753ea09b.py | sed '\"'$d'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/753ea09b.py | sed '\"'$d'\"'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/753ea09b.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the small background compartments bounded by the long contour color.\n\n    Input structure:\n    - The grid has one dominant background color and two foreground colors.\n    - The more frequent foreground color forms long 8-connected contour fragments.\n    - The other foreground color is a fixed distractor/obstacle color that partitions\n      the background but is never recolored.\n\n    Rule:\n    - Split the background into 4-connected regions using all foreground pixels as\n      barriers.\n    - Keep the two largest background regions as the outside of the contour drawing.\n    - Recolor every other background region that touches a long contour component\n      to the contour color; leave all foreground pixels unchanged.\n\n    Key insight:\n    The apparent area fill is exactly a component-level fill of bounded background\n    compartments, not a row-wise interpolation between individual contour pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    foreground = colors_present(g, exclude={bg})\n    assert len(foreground) == 2, \"expected exactly two foreground colors\"\n\n    fill_color = _unique_largest_color(g, foreground)\n    fill_lab, _n_fill = label_mask(g == fill_color, connectivity=8)\n    long_ids = _long_component_ids(fill_lab, _n_fill)\n\n    bg_lab, n_bg = label_mask(g == bg, connectivity=4)\n    exterior_ids = _two_exterior_bg_ids(bg_lab, n_bg)\n\n    out = g.copy()\n    for comp_id in range(1, n_bg + 1):\n        if comp_id in exterior_ids:\n            continue\n        coords = np.argwhere(bg_lab == comp_id)\n        if _touches_long_contour(coords, fill_lab, long_ids):\n            out[bg_lab == comp_id] = fill_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\nH, W = 30, 30\nGRID_SHAPE = (H, W)\nARC_COLOR_COUNT = 10\n\n# Long contour path layout.\nPATH_COUNT_OPTIONS = (2, 3)\nPATH_STEP_OPTIONS = (-1, 0, 1)\nPATH_GAP_MIN, PATH_GAP_MAX = 2, 5\nPATH_LEFT_MIN_COL, PATH_RIGHT_MARGIN = 2, 3\nPATH_START_MIN_COL = 3\nPATH_START_RIGHT_MARGIN = 4\nPATH_FAR_END_MIN_CHOICES, PATH_FAR_END_PROB, PATH_FAR_END_DELTA = 8, 0.7, 5\nPATH_SCORING_CANDIDATES = 5\nPATH_MIN_MOVES = 12\n\n# Contour distractors and extra contour pixels.\nOUTSIDE_MARGIN = 2\nOUTSIDE_SIDE_OPTIONS = (-1, 1)\nSHORT_FRAGMENT_COUNT_MIN, SHORT_FRAGMENT_COUNT_MAX = 3, 5\nSHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX = 1, 4\nSHORT_FRAGMENT_ATTEMPTS = 200\nSHORT_FRAGMENT_PATH_PADDING = 3\nCONTOUR_PIXELS_MIN, CONTOUR_PIXELS_MAX = 81, 108\n\n# Obstacle bars and scattered clusters.\nBAR_SEGMENT_MAX = 11\nSINGLE_CHANNEL_BARS_MIN, SINGLE_CHANNEL_BARS_MAX = 5, 11\nMULTI_CHANNEL_TOTAL_BARS_MIN, MULTI_CHANNEL_TOTAL_BARS_MAX = 4, 10\nMULTI_CHANNEL_INITIAL_BARS = 2\nMULTI_CHANNEL_MAX_BARS = 5\nBAR_WIDTH_MIN, BAR_WIDTH_MAX = 1, 5\nOBSTACLE_PIXELS_MIN, OBSTACLE_PIXELS_MAX = 36, 63\nOBSTACLE_EXTRA_PIXELS_MIN = 8\nOBSTACLE_OUTSIDE_QUOTA_MIN, OBSTACLE_OUTSIDE_QUOTA_MAX = 8, 16\nOBSTACLE_CLUSTER_SIZE_MIN, OBSTACLE_CLUSTER_SIZE_MAX = 1, 5\nOBSTACLE_ATTEMPTS = 300\nOBSTACLE_ZONE_OPTIONS = (\"outside\", \"inside\", \"any\")\n\n# Component validation.\nBG_REGIONS_MIN, BG_REGIONS_MAX = 8, 14\nEXTERIOR_REGION_COUNT = 2\nINTERIOR_REGIONS_MIN, INTERIOR_REGIONS_MAX = 6, 12\nINTERIOR_REGION_AREA_MAX = 57\nLONG_COMPONENT_MIN_SPAN = H // 3\nLONG_COMPONENT_COUNT_OPTIONS = (2, 3)\n\n# Retry limits and local neighborhoods.\nGENERATION_ATTEMPTS = 300\nNEIGHBOR_DELTAS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nNEIGHBOR_DELTAS_8 = NEIGHBOR_DELTAS_4 + ((-1, -1), (-1, 1), (1, -1), (1, 1))\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n","exit_code":0,"status":"completed"}}
