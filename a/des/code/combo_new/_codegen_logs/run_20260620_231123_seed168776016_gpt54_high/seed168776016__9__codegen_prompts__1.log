-\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_CF5FD0AD_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError('failed to generate cf5fd0ad input')\n\n===== /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py =====\n--- main lines 172-217 ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Predict the next panel in a framed sequence by continuing each scheduled colored interval.\n\n    Input structure\n    - The grid is made from three or more equal panels in one row or one column.\n    - The final input panel is the static target template; every earlier panel differs from it only by dynamic colors absent from the template.\n    - Each dynamic color appears in a regular temporal schedule across the earlier panels.\n\n    Rule\n    - Keep the final template panel as the output canvas.\n    - For every dynamic color whose schedule reaches the next panel, compare its last two appearances.\n    - Extrapolate each one-dimensional interval along the color's changing row or column axis and paint that predicted mask.\n\n    Key insight\n    - The task is not asking for the last visible panel, but for the next frame after the blank/template slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    panels, diff_colors = _split_panels(g)\n    template = panels[-1]\n    prior = panels[:-1]\n    next_time = len(prior)\n\n    predictions: list[tuple[int, np.ndarray]] = []\n    for color in diff_colors:\n        times = [i for i, panel in enumerate(prior) if np.any(panel == color)]\n        assert len(times) >= 2\n        gaps = [b - a for a, b in zip(times, times[1:])]\n        assert len(set(gaps)) == 1\n        period = gaps[0]\n        if next_time - times[-1] != period:\n            continue\n\n        previous = prior[times[-2]] == color\n        current = prior[times[-1]] == color\n        predictions.append((color, _extrapolate_mask(previous, current)))\n\n    assert predictions\n    occupied = np.zeros_like(template, dtype=bool)\n    for _color, mask in predictions:\n        assert not np.any(occupied & mask)\n        occupied |= mask\n\n    out = template.copy()\n    for color, mask in predictions:\n        out[mask] = color\n    return out\n\n--- generate_input lines 502-507 ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/985ae207.py =====\n--- main lines 81-128 ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repeat each 3x3 control-center sprite toward the matching solid rectangle until a copy first overlaps that rectangle.\n\n    Input structure\n    - The background is the dominant color.\n    - Each sprite is a 3x3 foreground object whose eight border pixels have one color and whose center has a different control color.\n    - For every control color, there is exactly one separate solid rectangular object of that color.\n\n    Rule\n    - Match each sprite to the unique solid rectangle whose color equals the sprite center.\n    - Copy the whole 3x3 sprite in the cardinal direction of that rectangle, stepping by three cells each time.\n    - Stop after pasting the first copy whose 3x3 bbox overlaps the rectangle; copied pixels overwrite the rectangle there.\n\n    Key insight\n    The center pixel is not the paint color: it is a destination key, while the entire 3x3 sprite is the motif tiled along the straight path.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h >= 3 and w >= 3\n\n    bg = int(get_bg(g))\n    sprites = _find_sprites(g, bg)\n    assert sprites, \"expected at least one 3x3 control-center sprite\"\n\n    out = g.copy()\n    for sprite_bbox, patch, center in sprites:\n        targets = _solid_rectangles(g, bg, center)\n        assert len(targets) == 1, \"each control color must have one solid rectangular target\"\n        target_bbox = targets[0][\"bbox\"]\n        assert not _intersects(sprite_bbox, target_bbox), \"sprite and target must start separate\"\n\n        dr, dc = _direction_to_target(sprite_bbox, target_bbox)\n        r, c = sprite_bbox[0], sprite_bbox[1]\n\n        while True:\n            current_bbox = (r, c, r + 2, c + 2)\n            assert 0 <= r and r + 3 <= h and 0 <= c and c + 3 <= w\n            paste(out, patch, r, c)\n\n            if _intersects(current_bbox, target_bbox):\n                break\n\n            r += dr * 3\n            c += dc * 3\n\n    return out\n\n--- generate_input lines 362-367 ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/99caaf76.py =====\n--- main lines 55-125 ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each marked cross object away from its marker to the grid edge while rotating the colored cross 180 degrees.\n\n    Input structure:\n    - The background is the dominant color.\n    - Each 8-connected foreground object has nine pixels: a 4-pixel marker-color\n      sprite attached to a 5-pixel non-marker colored cross.\n    - Each object bbox is either 3x6 or 6x3, so the marker sprite is on exactly\n      one side of the cross.\n\n    Rule:\n    - Move the whole object straight away from its marker side until the object\n      bbox touches the corresponding grid edge.\n    - Keep the marker sprite unchanged within the object.\n    - Rotate the 3x3 colored cross block by 180 degrees before placing it.\n\n    Key insight:\n    The marker sprite is a directional tail; the cross is the leading payload,\n    and only that payload turns around during the slide to the edge.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = get_bg(g)\n    marker = _marker_color(g, bg)\n\n    out = np.full_like(g, int(bg))\n    objects = find_components(g, bg=bg, connectivity=8, monochromatic=False)\n    assert objects, \"expected at least one composite object\"\n\n    for obj in objects:\n        assert int(obj[\"area\"]) == 9, \"each composite should contain 9 foreground pixels\"\n        r0, c0, _r1, _c1 = obj[\"bbox\"]\n        patch = crop_bbox(g, obj[\"bbox\"])\n        h, w = patch.shape\n        moved = patch.copy()\n\n        if (h, w) == (3, 6):\n            left = patch[:, :3]\n            right = patch[:, 3:]\n            left_kind = _block_kind(left, bg, marker)\n            right_kind = _block_kind(right, bg, marker)\n            assert {left_kind, right_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n\n            if left_kind == \"marker\":\n                moved[:, 3:] = np.rot90(right, 2)\n                target_r, target_c = int(r0), W - w\n            else:\n                moved[:, :3] = np.rot90(left, 2)\n                target_r, target_c = int(r0), 0\n\n        elif (h, w) == (6, 3):\n            top = patch[:3, :]\n            bottom = patch[3:, :]\n            top_kind = _block_kind(top, bg, marker)\n            bottom_kind = _block_kind(bottom, bg, marker)\n            assert {top_kind, bottom_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n\n            if top_kind == \"marker\":\n                moved[3:, :] = np.rot90(bottom, 2)\n                target_r, target_c = H - h, int(c0)\n            else:\n                moved[:3, :] = np.rot90(top, 2)\n                target_r, target_c = 0, int(c0)\n\n        else:\n            raise AssertionError(\"each composite bbox should be 3x6 or 6x3\")\n\n        _paste_checked(out, moved, target_r, target_c, bg)\n\n    return out\n\n--- generate_input lines 305-310 ---\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 99caaf76 input\")\n\n","exit_code":0,"status":"completed"}}
