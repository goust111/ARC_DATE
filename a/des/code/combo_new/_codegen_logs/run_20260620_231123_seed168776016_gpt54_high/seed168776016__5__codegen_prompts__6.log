{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg\nimport random\n\n\ndef _assert_output_footprints_disjoint(dims: list[tuple[int, int]]) -> None:\n    occupied: set[tuple[int, int]] = set()\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, cc) for r in range(short) for cc in range(c, c + long)}\n        assert not (occupied & cells), \"normalized output rectangles must not overlap\"\n        occupied |= cells\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, cc)\n            for r in range(10 - long, 10)\n            for cc in range(c, c + short)\n        }\n        assert not (occupied & cells), \"normalized output rectangles must not overlap\"\n        occupied |= cells\n        c += short + 1\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.\n\n    Input structure\n    The grid has one background color and one foreground color; the foreground forms\n    separate solid rectangles, ordered from left to right.\n\n    Rule\n    Build a 10-row background canvas whose width is the packed width of the wide\n    versions of the rectangles. For each source rectangle, paint a top-aligned\n    rectangle of shape min(h,w) by max(h,w), with one background column between\n    consecutive rectangles. Then, starting again from the left edge, paint a\n    bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,\n    again separated by one background column.\n\n    Key insight\n    The input rectangles are not copied in their original orientations; each object\n    contributes one horizontal-facing and one vertical-facing normalized rectangle,\n    preserving left-to-right object order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n    fg = fg_colors[0]\n\n    components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n    assert components\n    components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n\n    dims: list[tuple[int, int]] = []\n    for obj in components:\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert obj[\"area\"] == h * w\n        dims.append((h, w))\n\n    out_h = 10\n    out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n    _assert_output_footprints_disjoint(dims)\n    out = np.full((out_h, out_w), bg, dtype=int)\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[:short, c : c + long] = fg\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[out_h - long : out_h, c : c + short] = fg\n        c += short + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\n# Rectangle counts and dimensions.\nRECT_COUNT_MIN = 4\nRECT_COUNT_MAX = 6\nSHORT_SIDE_MIN = 1\nSHORT_SIDE_MAX = 3\nSIDE_SUM_MAX = 10\nLONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN\n\n# Canvas and packing constraints.\nARC_GRID_MAX = 30\nOUTPUT_HEIGHT = 10\nGAP_WIDTH = 1\n\n# Retry policy.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_d749d46f_output_footprints_disjoint(dims):\n    occupied = set()\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, c) for r in range(short) for c in range(col, col + long)}\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += long + GAP_WIDTH\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, c)\n            for r in range(OUTPUT_HEIGHT - long, OUTPUT_HEIGHT)\n            for c in range(col, col + short)\n        }\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += short + GAP_WIDTH\n\n    return True\n\n\ndef _sample_dimensions(n_rects):\n    \"\"\"Sample source rectangle dimensions under the output-width budget.\"\"\"\n    dims = []\n    remaining_budget = ARC_GRID_MAX - GAP_WIDTH * (n_rects - 1)\n\n    for i in range(n_rects):\n        rects_left = n_rects - i\n        min_needed = rects_left - 1\n        max_for_this = min(remaining_budget - min_needed, LONG_SIDE_MAX)\n        if max_for_this < SHORT_SIDE_MIN:\n            return None\n\n        short = random.randint(SHORT_SIDE_MIN, SHORT_SIDE_MAX)\n        max_long = min(SIDE_SUM_MAX - short, max_for_this)\n        if max_long < short:\n            short = SHORT_SIDE_MIN\n            max_long = min(LONG_SIDE_MAX, max_for_this)\n            if max_long < SHORT_SIDE_MIN:\n                return None\n\n        long = random.randint(short, max_long)\n        remaining_budget -= long\n\n        if random.random() < 0.5:\n            h, w = long, short\n        else:\n            h, w = short, long\n        dims.append((h, w))\n\n    return dims\n\n\ndef _input_shape(dims):\n    return max(h for h, _ in dims), sum(w for _, w in dims) + GAP_WIDTH * (len(dims) - 1)\n\n\ndef _background_is_dominant(dims, inp_h, inp_w):\n    fg_pixels = sum(h * w for h, w in dims)\n    total_pixels = inp_h * inp_w\n    bg_pixels = total_pixels - fg_pixels\n    return bg_pixels > fg_pixels\n\n\ndef _build_input_grid(dims, bg, fg, inp_h, inp_w):\n    grid = np.full((inp_h, inp_w), bg, dtype=int)\n    col = 0\n    for h, w in dims:\n        grid[:h, col:col + w] = fg\n        col += w + GAP_WIDTH\n    return grid\n\n\ndef _passes_solver_oracle(grid):\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return out.shape[0] == OUTPUT_HEIGHT\n\n\ndef _gen_attempt():\n    \"\"\"Generate one valid input grid, or None when sampled dimensions fail constraints.\"\"\"\n    bg, fg = random.sample(COLOR_VALUES, 2)\n    n_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)\n    dims = _sample_dimensions(n_rects)\n    if dims is None:\n        return None\n\n    inp_h, inp_w = _input_shape(dims)\n    if inp_w > ARC_GRID_MAX:\n        return None\n    if not _gen_d749d46f_output_footprints_disjoint(dims):\n        return None\n    if inp_h > ARC_GRID_MAX or inp_h < 1:\n        return None\n    if not _background_is_dominant(dims, inp_h, inp_w):\n        return None\n\n    grid = _build_input_grid(dims, bg, fg, inp_h, inp_w)\n    if not _passes_solver_oracle(grid):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/902510d5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/902510d5.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _corner_distances(shape: tuple[int, int], corner: str, r: int, c: int) -> tuple[int, int]:\n    H, W = shape\n    if corner == \"TL\":\n        return int(r), int(c)\n    if corner == \"TR\":\n        return int(r), int(W - 1 - c)\n    if corner == \"BL\":\n        return int(H - 1 - r), int(c)\n    assert corner == \"BR\"\n    return int(H - 1 - r), int(W - 1 - c)\n\n\ndef _paint_corner_triangle(out: np.ndarray, corner: str, side: int, color: int) -> None:\n    H, W = out.shape\n    assert side > 0, \"triangle side length must be positive\"\n    for r in range(H):\n        for c in range(W):\n            a, b = _corner_distances((H, W), corner, r, c)\n            if a + b < side:\n                out[r, c] = int(color)\n\n\ndef _diagonal_direction(coords: set[tuple[int, int]]) -> str | None:\n    r0 = min(r for r, _ in coords)\n    r1 = max(r for r, _ in coords)\n    c0 = min(c for _, c in coords)\n    c1 = max(c for _, c in coords)\n    height = r1 - r0 + 1\n    width = c1 - c0 + 1\n    if height != width:\n        return None\n    n = height\n    local = {(r - r0, c - c0) for r, c in coords}\n    main_ok = all((c, r) in local for r, c in local)\n    anti_ok = all((n - 1 - c, n - 1 - r) in local for r, c in local)\n    if main_ok:\n        if (0, 0) in local and (n - 1, n - 1) not in local:\n            return \"TL\"\n        if (n - 1, n - 1) in local and (0, 0) not in local:\n            return \"BR\"\n    if anti_ok:\n        if (0, n - 1) in local and (n - 1, 0) not in local:\n            return \"TR\"\n        if (n - 1, 0) in local and (0, n - 1) not in local:\n            return \"BL\"\n    return None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Keep the largest 8-connected motif and replace the corner/control pixels with a solid corner triangle.\n\n    Input structure\n    - The background is the dominant color.\n    - Exactly one grid corner contains a foreground control pixel; it gives the\n      corner from which the triangle is painted.\n    - There is one unique largest 8-connected monochrome foreground object, the\n      motif that remains in the output; all other foreground pixels are controls.\n    - Every foreground component outside that motif is a singleton control pixel.\n    - The fill color is the unique control color that appears in at least two\n      non-corner control pixels.\n\n    Rule\n    - Start from a blank background canvas and redraw only the largest motif.\n    - Count the non-corner control pixels; that count is the triangle side.\n    - Paint the fill color on the right-triangle region where those two distances\n      from the marked corner's edges sum to less than the side length.\n\n    Key insight\n    - The scattered singleton controls are counted into a compact triangular\n      stack at the marked corner; only the largest motif is not part of the count.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    corners = {\n        \"TL\": (0, 0),\n        \"TR\": (0, W - 1),\n        \"BL\": (H - 1, 0),\n        \"BR\": (H - 1, W - 1),\n    }\n    marked_corners = [\n        (name, rc) for name, rc in corners.items() if int(g[rc]) != int(bg)\n    ]\n    assert len(marked_corners) == 1, \"expected exactly one foreground corner marker\"\n    corner, (corner_r, corner_c) = marked_corners[0]\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert comps, \"expected at least one foreground component\"\n    max_area = max(int(comp[\"area\"]) for comp in comps)\n    motif_candidates = [comp for comp in comps if int(comp[\"area\"]) == max_area]\n    assert len(motif_candidates) == 1, \"expected a unique largest motif\"\n    motif = motif_candidates[0]\n    motif_color = int(motif[\"color\"])\n    motif_coords = {tuple(map(int, coord)) for coord in motif[\"coords\"]}\n    motif_direction = _diagonal_direction(motif_coords)\n    assert motif_direction is not None, \"motif must be square and diagonal-symmetric\"\n    assert motif_direction == corner, \"corner marker must match motif diagonal direction\"\n\n    control_coords = [\n        (int(r), int(c))\n        for r, c in np.argwhere(g != bg)\n        if (int(r), int(c)) not in motif_coords\n    ]\n    assert (corner_r, corner_c) in control_coords, \"corner marker must be a control pixel\"\n    assert len(control_coords) > 1, \"expected non-corner control pixels\"\n\n    control_components = [comp for comp in comps if comp is not motif]\n    assert all(int(comp[\"area\"]) == 1 for comp in control_components), \"controls must be singleton components\"\n\n    control_counts = Counter(\n        int(g[r, c])\n        for r, c in control_coords\n        if (int(r), int(c)) != (corner_r, corner_c)\n    )\n    fill_candidates = [\n        int(color) for color, count in control_counts.items() if int(count) >= 2\n    ]\n    assert len(fill_candidates) == 1, \"expected one repeated non-corner fill color\"\n    fill_color = fill_candidates[0]\n    side = len(control_coords) - 1\n\n    out = np.full_like(g, bg)\n    for r, c in motif_coords:\n        out[r, c] = motif_color\n    _paint_corner_triangle(out, corner, int(side), fill_color)\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_ATTEMPTS = 300\n\n# Canvas and triangle bounds.\n_GEN_ROW_BOUNDS = (6, 15)\n_GEN_COL_BOUNDS = (9, 14)\n_GEN_TRIANGLE_SIDE_BOUNDS = (2, 5)\n\n# Color and control-pixel sampling.\n_GEN_COLORS = tuple(range(1, 10))\n_GEN_MARKER_AVOID_FILL_PROB = 0.8\n_GEN_FILL_COUNT_BOUNDS = (2, 3)\n\n# Sparse square motifs observed in the task examples.\n_GEN_MOTIF_TEMPLATES = [\n    (\"..#.\", \".#..\", \"#.#.\", \"...#\"),\n    (\".#...\", \"..#..\", \"..##.\", \".#..#\", \"#....\"),\n    (\n        \"...###...\",\n        \"..#......\",\n        \".##......\",\n        \"#..#.....\",\n        \"#...#....\",\n        \"#....#...\",\n        \"......#..\",\n        \".......#.\",\n        \"........#\",\n    ),\n    (\"#...\", \".#.#\", \"..#.\", \".#..\"),\n    (\"...#\", \"#.#.\", \"##..\", \".##.\"),\n]\n\n\ndef _gen_triangle_mask(shape, corner, side):\n    H, W = shape\n    rr, cc = np.indices((H, W))\n    if corner == \"TL\":\n        return rr + cc < side\n    if corner == \"TR\":\n        return rr + (W - 1 - cc) < side\n    if corner == \"BL\":\n        return (H - 1 - rr) + cc < side\n    return (H - 1 - rr) + (W - 1 - cc) < side\n\n\ndef _gen_dilate8(mask):\n    out = mask.copy()\n    out[1:, :] |= mask[:-1, :]\n    out[:-1, :] |= mask[1:, :]\n    out[:, 1:] |= mask[:, :-1]\n    out[:, :-1] |= mask[:, 1:]\n    out[1:, 1:] |= mask[:-1, :-1]\n    out[1:, :-1] |= mask[:-1, 1:]\n    out[:-1, 1:] |= mask[1:, :-1]\n    out[:-1, :-1] |= mask[1:, 1:]\n    return out\n\n\ndef _gen_patch_from_lines(lines):\n    return np.array([[ch == \"#\" for ch in row] for row in lines], dtype=bool)\n\n\ndef _gen_patch_variants(patch):\n    variants = []\n    seen = set()\n    for k in range(4):\n        rotated = np.rot90(patch, k)\n        for variant in (rotated, np.fliplr(rotated)):\n            key = tuple(map(tuple, variant.astype(int)))\n            if key not in seen:\n                seen.add(key)\n                variants.append(variant.copy())\n    return variants\n\n\ndef _gen_reflect_anti_diagonal(patch):\n    return np.flipud(np.fliplr(patch.T))\n\n\ndef _gen_is_diagonal_symmetric_patch(patch):\n    if patch.shape[0] != patch.shape[1]:\n        return False\n    main_ok = np.array_equal(patch, patch.T)\n    return main_ok or np.array_equal(patch, _gen_reflect_anti_diagonal(patch))\n\n\ndef _gen_patch_direction(patch):\n    if patch.shape[0] != patch.shape[1]:\n        return None\n    n = patch.shape[0]\n    main_ok = np.array_equal(patch, patch.T)\n    anti_ok = np.array_equal(patch, _gen_reflect_anti_diagonal(patch))\n    if main_ok:\n        if patch[0, 0] and not patch[n - 1, n - 1]:\n            return \"TL\"\n        if patch[n - 1, n - 1] and not patch[0, 0]:\n            return \"BR\"\n    if anti_ok:\n        if patch[0, n - 1] and not patch[n - 1, 0]:\n            return \"TR\"\n        if patch[n - 1, 0] and not patch[0, n - 1]:\n            return \"BL\"\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/71e489b6.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/71e489b6.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import components_mask\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Highlight black defects in blue foreground by surrounding them with orange.\n\n    Input structure:\n    - Blue (1) foreground on black (0) bg; small black holes or protrusions within blue regions; occasional thin blue spurs into black areas.\n\n    Rule:\n    - Thin blue pixels mostly surrounded by black are absorbed into the background.\n    - Small black components (≤3 cells) and leaf pixels of larger black components are \"defects.\"\n    - Each defect gets an orange (7) 8-neighbor halo; the defect pixels themselves stay black.\n\n    Key insight: Only structural anomalies—tiny isolated patches and dangling endpoints—are marked, not bulk black regions.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    hole_col = 0\n    border_col = 7\n\n    # STEP 0) Fill blue (1) pixels to black (0) when mostly surrounded by black.\n    base = g.copy()\n    for r in range(H):\n        for c in range(W):\n            if int(base[r, c]) != 1:\n                continue\n            nb = 0\n            oob = 0\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + dr)\n                cc = int(c + dc)\n                if not (0 <= rr < H and 0 <= cc < W):\n                    oob += 1\n                    continue\n                if int(base[rr, cc]) == int(hole_col):\n                    nb += 1\n            # only count outside-as-black for corners (two out-of-bounds sides)\n            if oob >= 2:\n                nb += int(oob)\n            if nb >= 3:\n                base[int(r), int(c)] = int(hole_col)\n\n    # STEP 1/2) Collect target black pixels (they must remain black).\n    preserve: set[tuple[int, int]] = set()\n    comps = components_mask(base == int(hole_col), connectivity=4)\n    for coords in comps:\n        pts_list = [(int(r), int(c)) for r, c in coords]\n        if len(pts_list) <= 3:\n            preserve.update(pts_list)\n            continue\n        for r, c in pts_list:\n            nb = 0\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + dr)\n                cc = int(c + dc)\n                if 0 <= rr < H and 0 <= cc < W and int(base[rr, cc]) == int(hole_col):\n                    nb += 1\n            if nb <= 1:\n                preserve.add((int(r), int(c)))\n\n    # STEP 3) Paint orange in the Chebyshev-1 neighborhood of each target set/pixel.\n    out = base.copy()\n    for coords in comps:\n        pts_list = [(int(r), int(c)) for r, c in coords]\n        targets = pts_list if len(pts_list) <= 3 else [p for p in pts_list if p in preserve]\n        for r, c in targets:\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    rr = int(r + dr)\n                    cc = int(c + dc)\n                    if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in preserve:\n                        out[rr, cc] = int(border_col)\n\n    # Ensure target black pixels remain black.\n    for r, c in preserve:\n        out[int(r), int(c)] = int(hole_col)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# ── CFG: tunable generation parameters ──────────────────────────────\nGRID_H_RANGE = (16, 19)           # canvas height bounds\nGRID_W_RANGE = (16, 19)           # canvas width bounds\nMIN_BLUE_REGION = 30              # minimum blue region size (cells)\nMIN_BLACK_REGION = 20             # minimum black region size (cells)\nPARTITION_STYLES = ['h_stripes', 'rect_inset', 'l_shape']\nSTRIPE_CUTS_RANGE = (1, 3)       # number of horizontal cuts for h_stripes\nCUT_MARGIN = 3                   # min distance from grid edge for cuts\nINSET_MARGIN = 2                 # padding from edge for rect_inset\nINNER_INSET_MIN_GAP = 6          # min dimension for nested inset\nINNER_INSET_PROB = 0.5           # probability of nested inset\nDEFECT_COUNT_RANGE = (2, 9)      # number of defect holes to place\nDEFECT_SIZE_WEIGHTS = [6, 2, 1]  # weights for defect sizes [1, 2, 3]\nDEFECT_CLEARANCE = 2             # min Chebyshev distance between defects\nDEFECT_PLACE_TRIES = 50          # retries per defect placement\nLEAF_COUNT_RANGE = (0, 4)        # number of leaf protrusions\nSPUR_COUNT_RANGE = (2, 6)        # number of blue spurs in black regions\nMIN_DEFECTS = 2                  # reject grid if fewer defects placed\nMIN_SPURS = 2                    # reject grid if fewer spurs placed\nMAX_GEN_ATTEMPTS = 300           # outer retry limit\n\n\ndef _nearby(r: int, c: int, dist: int, ref: set) -> bool:\n    \"\"\"Return True if any pixel in `ref` is within Chebyshev distance `dist`.\"\"\"\n    for dr in range(-dist, dist + 1):\n        for dc in range(-dist, dist + 1):\n            if (r + dr, c + dc) in ref:\n                return True\n    return False\n\n\ndef _exclusion_zone(pixels, dist: int) -> set:\n    \"\"\"Return the set of all coords within Chebyshev `dist` of any pixel.\"\"\"\n    zone = set()\n    for r, c in pixels:\n        for dr in range(-dist, dist + 1):\n            for dc in range(-dist, dist + 1):\n                zone.add((r + dr, c + dc))\n    return zone\n\n\ndef _build_partition(H: int, W: int) -> np.ndarray:\n    \"\"\"Create an H x W grid partitioned into blue (1) and black (0) regions.\"\"\"\n    grid = np.zeros((H, W), dtype=int)\n    style = random.choice(PARTITION_STYLES)\n\n    if style == 'h_stripes':\n        n_cuts = random.randint(*STRIPE_CUTS_RANGE)\n        cuts = sorted(random.sample(\n            range(CUT_MARGIN, H - CUT_MARGIN), min(n_cuts, H - 2 * CUT_MARGIN)))\n        boundaries = [0] + cuts + [H]\n        first_color = random.randint(0, 1)\n        for i in range(len(boundaries) - 1):\n            grid[boundaries[i]:boundaries[i + 1], :] = (first_color + i) % 2\n\n    elif style == 'rect_inset':\n        bg = random.randint(0, 1)\n        grid[:, :] = bg\n        r0 = random.randint(INSET_MARGIN, H // 3)\n        r1 = random.randint(2 * H // 3, H - CUT_MARGIN)\n        c0 = random.randint(INSET_MARGIN, W // 3)\n        c1 = random.randint(2 * W // 3, W - CUT_MARGIN)\n        grid[r0:r1 + 1, c0:c1 + 1] = 1 - bg\n        if (r1 - r0 > INNER_INSET_MIN_GAP and c1 - c0 > INNER_INSET_MIN_GAP\n                and random.random() < INNER_INSET_PROB):\n            ir0 = random.randint(r0 + 2, r0 + (r1 - r0) // 3)\n            ir1 = random.randint(r0 + 2 * (r1 - r0) // 3, r1 - 2)\n            ic0 = random.randint(c0 + 2, c0 + (c1 - c0) // 3)\n            ic1 = random.randint(c0 + 2 * (c1 - c0) // 3, c1 - 2)\n            grid[ir0:ir1 + 1, ic0:ic1 + 1] = bg\n\n    elif style == 'l_shape':\n        bg = random.randint(0, 1)\n        grid[:, :] = bg\n        vc = random.randint(W // 3, 2 * W // 3)\n        if random.random() < 0.5:\n            grid[:, :vc] = 1 - bg\n            hc = random.randint(H // 3, 2 * H // 3)\n            grid[:hc, vc:] = 1 - bg\n        else:\n            grid[:, vc:] = 1 - bg\n            hc = random.randint(H // 3, 2 * H // 3)\n            grid[hc:, :vc] = 1 - bg\n\n    return grid\n\n\ndef _find_interior_blue(grid: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Return blue pixels whose 4-neighbors are all blue or out-of-bounds.\"\"\"\n    H, W = grid.shape\n    blue = grid == 1\n    # A blue pixel is interior if no in-bounds 4-neighbor is non-blue.\n    eroded = blue.copy()\n    eroded[:-1, :] &= blue[1:, :]   # neighbor below\n    eroded[1:, :]  &= blue[:-1, :]  # neighbor above\n    eroded[:, :-1] &= blue[:, 1:]   # neighbor right\n    eroded[:, 1:]  &= blue[:, :-1]  # neighbor left\n    rs, cs = np.where(eroded)\n    coords = list(zip(rs.tolist(), cs.tolist()))\n    random.shuffle(coords)\n    return coords\n\n\ndef _place_defects(grid: np.ndarray, interior_blue: list) -> tuple[set, int]:\n    \"\"\"Place 2-9 small black defects in blue-region interiors.\n\n    Returns (defect_pixels, defects_placed). Modifies `interior_blue` in place.\n    \"\"\"\n    H, W = grid.shape\n    n_defects = random.randint(*DEFECT_COUNT_RANGE)\n    defect_pixels: set[tuple[int, int]] = set()\n    interior_set = set(interior_blue)\n    defects_placed = 0\n\n    for _ in range(n_defects):\n        if not interior_blue:\n            break\n        defect_size = random.choices([1, 2, 3], weights=DEFECT_SIZE_WEIGHTS)[0]\n\n        placed = False\n        for _try in range(DEFECT_PLACE_TRIES):\n            if not interior_blue:\n                break\n            seed_r, seed_c = interior_blue[random.randint(0, len(interior_blue) - 1)]\n\n            if _nearby(seed_r, seed_c, DEFECT_CLEARANCE, defect_pixels):\n                continue\n\n            # Grow defect from seed\n            defect = [(seed_r, seed_c)]\n            if defect_size > 1:\n                dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n                random.shuffle(dirs)\n                for dr, dc in dirs:\n                    nr, nc = seed_r + dr, seed_c + dc\n                    if (nr, nc) not in interior_set or (nr, nc) in defect_pixels:\n                        continue\n                    # Check neighbor is surrounded by blue (except the seed)\n                    ok = True\n                    for dr2, dc2 in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        rr, cc = nr + dr2, nc + dc2\n                        if (rr, cc) == (seed_r, seed_c):\n                            continue\n                        if 0 <= rr < H and 0 <= cc < W:\n                            if grid[rr, cc] != 1 or (rr, cc) in defect_pixels:\n                                ok = False\n                                break\n                    if ok and not _nearby(nr, nc, DEFECT_CLEARANCE, defect_pixels):\n                        defect.append((nr, nc))\n                        if len(defect) >= defect_size:\n                            break\n\n            # Validate: every non-defect 4-neighbor of every defect pixel must be blue\n            defect_set = set(defect)\n","exit_code":0,"status":"completed"}}
