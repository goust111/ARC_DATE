{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"for spec in '/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:41:220' '/home/lixinyu/snap/new/ARC_code/train/aa62e3f4.py:17:180'; do IFS=: read -r f s e <<< \\\"\"'$spec\"; echo \"===== $f [$s,$e]\"; sed -n \"${s},${e}p\" \"$f\"; done'","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py [41,220]\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\ndef _in_bounds(h, w, r, c):\n    return 0 <= r < h and 0 <= c < w\n\n\n# ---------------------------------------------------------------------------\n# Frame geometry\n# ---------------------------------------------------------------------------\n\ndef _frame_ring_coords(r0, c0, ch, cw):\n    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n\n    Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).\n    Ring = bbox boundary minus 4 corners.\n    \"\"\"\n    H, W = ch + 2, cw + 2\n    ring = []\n    for dr in range(H):\n        for dc in range(W):\n            on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)\n            corner = (dr in (0, H - 1)) and (dc in (0, W - 1))\n            if on_bdr and not corner:\n                ring.append((r0 + dr, c0 + dc))\n    cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]\n    return ring, cavity\n\n\ndef _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n\n    Returns True if: ring and cavity cells are empty, no cavity cell is\n    8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and\n    at least one ring cell is 8-adjacent to a line_col pixel.\n    \"\"\"\n    # Ring and cavity cells must all be empty\n    for rr, cc in ring:\n        if canvas[rr, cc] != -1:\n            return False\n    for rr, cc in cavity:\n        if canvas[rr, cc] != -1:\n            return False\n\n    # No cavity cell may be 8-adjacent to any line_col pixel\n    for cr, cc in cavity:\n        for nr, nc in neighbors8(cr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return False\n===== /home/lixinyu/snap/new/ARC_code/train/aa62e3f4.py [17,180]\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace the outlined object with the outside contour of that outline in the marker color.\n\n    Input structure:\n    - A dominant background surrounds one 8-connected foreground outline.\n    - The outline is the unique largest foreground color.\n    - One or more smaller interior colors are inside the outline; the marker color\n      is the unique smallest non-outline color.\n\n    Rule:\n    - Erase all original foreground pixels to background.\n    - Paint every background pixel that is 4-adjacent to the outline with the\n      marker color.\n    - Keep the grid shape unchanged.\n\n    Key insight: The colored interior marker supplies the paint color, while the\n    largest outline supplies only the contour whose outside edge is traced.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    counts = Counter(map(int, g.flatten()))\n    foreground_colors = [color for color in counts if color != bg]\n    assert len(foreground_colors) >= 2, \"expected an outline color and a marker color\"\n\n    frame_count = max(counts[color] for color in foreground_colors)\n    frame_color = _unique_color_with_count(counts, foreground_colors, frame_count)\n    assert len(components_mask(g == frame_color, connectivity=8)) == 1, \"outline must be 8-connected\"\n\n    marker_candidates = [color for color in foreground_colors if color != frame_color]\n    marker_count = min(counts[color] for color in marker_candidates)\n    marker_color = _unique_color_with_count(counts, marker_candidates, marker_count)\n\n    out = np.full_like(g, bg)\n    contour: set[tuple[int, int]] = set()\n    for r, c in np.argwhere(g == frame_color):\n        for nr, nc in neighbors4(int(r), int(c)):\n            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] == bg:\n                contour.add((int(nr), int(nc)))\n    assert contour, \"expected outline to touch background contour cells\"\n\n    for r, c in contour:\n        out[r, c] = marker_color\n    return out\n\n# --------------- generator (att2) ---------------\n\nGRID_MIN, GRID_MAX = 5, 16\nN_COLORS = 10\n\nSHAPE_MIN_HEIGHT, SHAPE_MAX_HEIGHT = 5, 7\nSHAPE_MIN_WIDTH, SHAPE_MAX_WIDTH = 3, 5\nSTART_WIDTH_MIN, START_WIDTH_MAX = 1, 2\nMAX_LOCAL_WIDTH = 5\n\nMARKER_MIN_CELLS, MARKER_MAX_CELLS = 1, 3\n\nGEN_ATTEMPTS = 300\n\nEDGE_TOUCH_TOP_BOTTOM = \"TB\"\nCORNER_EDGE_PAIRS = [\"TL\", \"TR\", \"BL\", \"BR\"]\nZERO_DELTA_SHIFTS = [-1, 0, 0, 0, 1]\n\n\ndef _gen_grow_parts(total, n):\n    n_twos = total - n\n    parts = [2] * n_twos + [1] * (n - n_twos)\n    random.shuffle(parts)\n    return parts\n\ndef _gen_drop_parts(total, n):\n    if n == 0:\n        return []\n    n_twos = random.randint(max(0, total - n), min(total // 2, n))\n    n_ones = total - 2 * n_twos\n    parts = [2] * n_twos + [1] * n_ones + [0] * (n - n_twos - n_ones)\n    random.shuffle(parts)\n    return parts\n\ndef _gen_widths(height, max_width):\n    start = random.randint(START_WIDTH_MIN, START_WIDTH_MAX)\n    diff = max_width - start\n    grow_steps = random.randint((diff + 1) // 2, min(diff, height - 1))\n    widths = [start]\n    for inc in _gen_grow_parts(diff, grow_steps):\n        widths.append(widths[-1] + inc)\n\n    remaining = height - len(widths)\n    min_end = max(1, max_width - 2 * remaining)\n    end_width = random.randint(min_end, max_width)\n    for dec in _gen_drop_parts(max_width - end_width, remaining):\n        widths.append(widths[-1] - dec)\n    return widths\n\ndef _gen_intervals(widths):\n    left, right = 0, widths[0] - 1\n    intervals = [(left, right)]\n    for prev_width, width in zip(widths, widths[1:]):\n        delta = width - prev_width\n        if delta == 2:\n            left -= 1\n            right += 1\n        elif delta == 1:\n            if random.choice([False, True]):\n                left -= 1\n            else:\n                right += 1\n        elif delta == 0:\n            shift = random.choice(ZERO_DELTA_SHIFTS) if width >= 2 else 0\n            left += shift\n            right += shift\n        elif delta == -1:\n            if random.choice([False, True]):\n                left += 1\n            else:\n                right -= 1\n        elif delta == -2:\n            left += 1\n            right -= 1\n        intervals.append((left, right))\n\n    min_left = min(l for l, _ in intervals)\n    intervals = [(l - min_left, r - min_left) for l, r in intervals]\n    if max(r for _, r in intervals) + 1 > MAX_LOCAL_WIDTH:\n        return None\n    return intervals\n\ndef _gen_local_mask(intervals):\n    height = len(intervals)\n    width = max(r for _, r in intervals) + 1\n    mask = np.zeros((height, width), dtype=bool)\n    for r, (c0, c1) in enumerate(intervals):\n        mask[r, c0 : c1 + 1] = True\n    return mask\n\ndef _gen_place_shape(grid_shape, local_mask, edge_pair):\n    rows, cols = grid_shape\n    height, width = local_mask.shape\n    if edge_pair == EDGE_TOUCH_TOP_BOTTOM:\n        if height != rows or width > cols - 2:\n            return None\n        return 0, random.randint(1, cols - width - 1)\n    if height >= rows or width >= cols:\n        return None\n    if edge_pair == \"TL\":\n        return 0, 0\n    if edge_pair == \"TR\":\n        return 0, cols - width\n    if edge_pair == \"BL\":\n        return rows - height, 0\n    return rows - height, cols - width\n\ndef _gen_full_mask(rows, cols, local_mask, r0, c0):\n    mask = np.zeros((rows, cols), dtype=bool)\n    height, width = local_mask.shape\n    mask[r0 : r0 + height, c0 : c0 + width] = local_mask\n    return mask\n\ndef _gen_layers(mask):\n    remaining = mask.copy()\n    layers = []\n    rows, cols = mask.shape\n    while np.any(remaining):\n","exit_code":0,"status":"completed"}}
