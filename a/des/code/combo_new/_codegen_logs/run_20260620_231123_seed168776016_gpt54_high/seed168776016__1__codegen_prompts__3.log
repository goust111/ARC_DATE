{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed168776016/1/3.py')\nmod = SourceFileLoader('new_arc_task_extra', str(p)).load_module()\n\nfor i in range(100):\n    g = mod.generate_input()\n    body = g[:-1]\n    cmds = [int(v) for v in g[-1] if int(v) \"'!= mod.BG]\n    assert len(cmds) == len(set(cmds))\n    start = np.argwhere(body == mod.START_COLOR)\n    assert len(start) == 1\n    rails = mod._extract_rails(g)\n    assert set(cmds) == set(rails)\n    cur = tuple(map(int, start[0]))\n    for color in cmds:\n        rail = rails[color]\n        if rail['\"'orientation'] == 'h':\n            assert cur[0] == rail['row']\n            assert cur[1] < rail['c0'] or cur[1] > rail['c1']\n            cur = (rail['row'], rail['c1'] if cur[1] < rail['c0'] else rail['c0'])\n        else:\n            assert cur[1] == rail['col']\n            assert cur[0] < rail['r0'] or cur[0] > rail['r1']\n            cur = (rail['r1'] if cur[0] < rail['r0'] else rail['r0'], rail['col'])\nprint('extra_checks ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
