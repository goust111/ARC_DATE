{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/e729b7be.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the scene by adding the point-reflected copy of the colored object across the central marker.\n\n    Input structure\n    - The grid has odd dimensions, a dominant background, and a center-row marker color appearing only at the left edge, center, and right edge.\n    - A single divider color fills the center column except for the center marker.\n    - All remaining foreground pixels form the object to copy, entirely on the left side of the divider.\n    Rule\n    - Keep the input unchanged.\n    - For every object pixel, paint the pixel rotated 180 degrees around the center marker with the same color.\n    Key insight\n    - The center marker is the rotation center; the yellow-looking divider is not mirrored, it only separates the source from the empty target side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h % 2 == 1 and w % 2 == 1\n\n    cr, cc = h // 2, w // 2\n    bg = int(get_bg(g))\n\n    marker_color = int(g[cr, cc])\n    assert marker_color != bg\n    marker_mask = g == marker_color\n    expected_markers = np.zeros(g.shape, dtype=bool)\n    expected_markers[cr, 0] = True\n    expected_markers[cr, cc] = True\n    expected_markers[cr, w - 1] = True\n    assert np.array_equal(marker_mask, expected_markers)\n\n    center_col = g[:, cc]\n    divider_colors = {int(color) for color in np.unique(center_col) if int(color) != marker_color}\n    assert len(divider_colors) == 1\n    divider_color = next(iter(divider_colors))\n    assert divider_color != bg\n    expected_divider = np.zeros(g.shape, dtype=bool)\n    expected_divider[:, cc] = True\n    expected_divider[cr, cc] = False\n    assert np.array_equal(g == divider_color, expected_divider)\n\n    source_mask = (g != bg) & (g != marker_color) & (g != divider_color)\n    source_coords = np.argwhere(source_mask)\n    assert source_coords.size > 0\n    assert np.all(source_coords[:, 1] < cc)\n\n    out = g.copy()\n    for r, c in source_coords:\n        rr = 2 * cr - int(r)\n        rc = 2 * cc - int(c)\n        assert 0 <= rr < h and 0 <= rc < w\n        assert out[rr, rc] == bg\n        out[rr, rc] = g[r, c]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Colors and canvas bounds.\nBG_COLOR, DIVIDER_COLOR, MARKER_COLOR = 7, 4, 8\nGRID_SIZES, MIN_EMPTY_BORDER_ROWS = (15, 17, 19), 1\n\n# Convex source shape bounds.\nSOURCE_SPAN_RANGE = (10, 15)\nSOURCE_MAX_WIDTH_RANGE = (5, 7)\nSOURCE_EDGE_WIDTH_RANGE = (1, 3)\nWIDTH_STEP_CAP, SOURCE_PIXEL_RANGE = 2, (35, 83)\n\n# Color palette, band orders, and retry budget.\nSOURCE_COLORS = (0, 1, 2, 3, 5, 6, 9)\nSOURCE_COLOR_COUNT_RANGE, GEN_ATTEMPTS = (3, 7), 300\nCOLORING_KEYS = (\n    lambda item: (item[2], item[3], item[1]),\n    lambda item: (item[3], item[2], item[1]),\n    lambda item: (item[2] + item[3], item[2], item[1]),\n    lambda item: (item[2] - item[3], item[2], item[1]),\n)\n\n\ndef _gen_bounded_steps(total, slots, cap):\n    steps = []\n    remaining = total\n    for i in range(slots):\n        left = slots - i - 1\n        lo = max(0, remaining - cap * left)\n        hi = min(cap, remaining)\n        step = random.randint(lo, hi)\n        steps.append(step)\n        remaining -= step\n    return steps\n\n\ndef _gen_width_profile(span, max_width):\n    edge_width_hi = min(SOURCE_EDGE_WIDTH_RANGE[1], max_width)\n    start_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n    end_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n    min_up = (max_width - start_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n    min_down = (max_width - end_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n    if min_up + min_down + 1 > span:\n        return None\n\n    peak_start = random.randint(min_up, span - 1 - min_down)\n    peak_end = random.randint(peak_start, span - 1 - min_down)\n\n    widths = [start_width]\n    for step in _gen_bounded_steps(max_width - start_width, peak_start, WIDTH_STEP_CAP):\n        widths.append(widths[-1] + step)\n\n    widths.extend([max_width] * (peak_end - peak_start))\n\n    current = max_width\n    for step in _gen_bounded_steps(max_width - end_width, span - 1 - peak_end, WIDTH_STEP_CAP):\n        current -= step\n        widths.append(current)\n\n    area = sum(widths)\n    if not SOURCE_PIXEL_RANGE[0] <= area <= SOURCE_PIXEL_RANGE[1]:\n        return None\n    return widths\n\n\ndef _choose_source_extent(n, cr):\n    valid_spans = [s for s in range(SOURCE_SPAN_RANGE[0], SOURCE_SPAN_RANGE[1] + 1) if s <= n - 2 * MIN_EMPTY_BORDER_ROWS]\n    span = random.choice(valid_spans)\n    r0_min = max(MIN_EMPTY_BORDER_ROWS, cr - span + 1)\n    r0_max = min(cr, n - MIN_EMPTY_BORDER_ROWS - span)\n    r0 = random.randint(r0_min, r0_max)\n    return span, r0, cr - r0\n\n\ndef _paint_source_cells(out, r0, widths, outer, cc):\n    interior = []\n    source = []\n    for i, width in enumerate(widths):\n        r = r0 + i\n        c0 = cc - width\n        for j in range(width):\n            c = c0 + j\n            source.append((r, c))\n            if j == 0:\n                out[r, c] = outer\n            else:\n                interior.append((r, c, i, j))\n    return source, interior\n\n\ndef _gen_color_source(out, r0, widths, colors, cc):\n    outer = colors[0]\n    inner = colors[1:]\n    source, interior = _paint_source_cells(out, r0, widths, outer, cc)\n    if len(interior) < len(inner):\n        return None\n\n    key = COLORING_KEYS[random.randrange(len(COLORING_KEYS))]\n    interior.sort(key=key)\n    band_count = len(inner)\n    for rank, (r, c, _, _) in enumerate(interior):\n        out[r, c] = inner[min(band_count - 1, rank * band_count // len(interior))]\n\n    return source\n\n\ndef _reflect_source(out, source, cr, cc):\n    reflected = []\n    for r, c in source:\n        rr = 2 * cr - r\n        rc = 2 * cc - c\n        if out[rr, rc] != BG_COLOR:\n            return None\n        out[rr, rc] = out[r, c]\n        reflected.append((rr, rc))\n    return reflected\n\n\ndef _gen_attempt():\n    n = random.choice(GRID_SIZES)\n    cr = cc = n // 2\n    out = np.full((n, n), BG_COLOR, dtype=int)\n    out[:, cc] = DIVIDER_COLOR\n    out[cr, [0, cc, n - 1]] = MARKER_COLOR\n\n    span, r0, center_i = _choose_source_extent(n, cr)\n    max_width = random.randint(*SOURCE_MAX_WIDTH_RANGE)\n    widths = _gen_width_profile(span, max_width)\n    if widths is None:\n        return None\n    if widths[center_i] >= cc:\n        return None\n\n    color_count = random.randint(*SOURCE_COLOR_COUNT_RANGE)\n    colors = random.sample(SOURCE_COLORS, color_count)\n    source = _gen_color_source(out, r0, widths, colors, cc)\n    if source is None:\n        return None\n\n    reflected = _reflect_source(out, source, cr, cc)\n    if reflected is None:\n        return None\n\n    inp = out.copy()\n    for r, c in reflected:\n        inp[r, c] = BG_COLOR\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input():\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid e729b7be input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, components_mask, get_bg\nimport random\n\n\nAxis = tuple[int, str, int]\n\n\ndef _find_reflection_axis(g: np.ndarray, bg: int) -> Axis:\n    h, w = g.shape\n    candidates: list[Axis] = []\n\n    for color in colors_present(g, exclude={bg}):\n        mask = g == color\n        count = int(mask.sum())\n\n        if count == w:\n            for r in np.flatnonzero(mask.all(axis=1)):\n                candidates.append((int(color), \"row\", int(r)))\n\n        if count == h:\n            for c in np.flatnonzero(mask.all(axis=0)):\n                candidates.append((int(color), \"col\", int(c)))\n\n        if h == w and count == h:\n            main_diag = np.eye(h, dtype=bool)\n            anti_diag = np.fliplr(main_diag)\n            if np.all(mask[main_diag]):\n                candidates.append((int(color), \"main_diag\", 0))\n            if np.all(mask[anti_diag]):\n                candidates.append((int(color), \"anti_diag\", 0))\n\n    assert len(candidates) == 1, \"expected exactly one full straight reflection axis\"\n    return candidates[0]\n\n\ndef _reflect(axis: Axis, shape: tuple[int, int], r: int, c: int) -> tuple[int, int]:\n    _axis_color, kind, index = axis\n    h, w = shape\n\n    if kind == \"row\":\n        return 2 * index - r, c\n    if kind == \"col\":\n        return r, 2 * index - c\n    if kind == \"main_diag\":\n        assert h == w, \"diagonal reflection axis requires a square grid\"\n        return c, r\n    if kind == \"anti_diag\":\n        assert h == w, \"diagonal reflection axis requires a square grid\"\n        return h - 1 - c, w - 1 - r\n\n    raise AssertionError(f\"unknown axis kind: {kind}\")\n\n\ndef _smallest_non_axis_color(g: np.ndarray, bg: int, axis_color: int) -> int:\n    areas = {\n        int(color): int(np.count_nonzero(g == color))\n        for color in colors_present(g, exclude={bg, axis_color})\n    }\n    assert len(areas) >= 2, \"expected at least two non-axis foreground colors\"\n\n    min_area = min(areas.values())\n    colors = [color for color, area in areas.items() if area == min_area]\n    assert len(colors) == 1, \"smallest non-axis foreground color must be unique\"\n    return colors[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Mirror the smallest non-axis foreground color across the full straight axis.\n\n    Input structure\n    - The background is the dominant color.\n    - One foreground color forms exactly one full row, column, main diagonal, or anti-diagonal reflection axis.\n    - The remaining foreground colors include a unique least-populated color to copy.\n\n    Rule\n    - Preserve the input grid.\n    - Select every pixel of the unique smallest non-axis foreground color.\n    - Reflect those pixels across the full straight axis and paint the reflected positions with the same color.\n\n    Key insight\n    - The axis color marks the mirror line, while the color population chooses which set of objects is duplicated.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.size > 0, \"expected a non-empty 2D grid\"\n\n    bg = get_bg(g)\n    axis = _find_reflection_axis(g, bg)\n    axis_color = axis[0]\n    mirror_color = _smallest_non_axis_color(g, bg, axis_color)\n\n    out = g.copy()\n    h, w = g.shape\n    for r_raw, c_raw in np.argwhere(g == mirror_color):\n        r = int(r_raw)\n        c = int(c_raw)\n        rr, cc = _reflect(axis, g.shape, r, c)\n        assert 0 <= rr < h and 0 <= cc < w, \"reflected pixel must stay inside the grid\"\n        assert int(out[rr, cc]) in {bg, mirror_color}, \"reflection cannot overwrite another foreground object\"\n        out[rr, cc] = mirror_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n# Canvas and axis options.\n_GEN_GRID_SIZE_RANGE = (9, 17)\n_GEN_ODD_GRID_SIZES = [9, 11, 13, 15, 17]\n_GEN_AXIS_KINDS = [\"row\", \"col\", \"main_diag\", \"anti_diag\"]\n_GEN_CENTER_AXIS_KINDS = {\"row\", \"col\"}\n_GEN_SIDE_COUNT = 2\n# Foreground component size and count bounds.\n_GEN_COMPONENT_COUNT_RANGE = range(1, 4)\n_GEN_MIRROR_TOTAL_RANGE = (4, 12)\n_GEN_MIRROR_COMPONENT_SIZE_RANGE = (2, 7)\n_GEN_NONMIRROR_TOTAL_RANGE = (5, 17)\n_GEN_NONMIRROR_COMPONENT_SIZE_RANGE = (3, 9)\n_GEN_MIN_NONMIRROR_RATIO = (5, 4)\n_GEN_MAX_NONMIRROR_MULTIPLIER = 2\n# Search and geometry primitives.\n_GEN_RETRY_LIMIT = 300\n_GEN_COLORS = list(range(10))\n_GEN_DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\ndef _gen_draw_axis(grid: np.ndarray, axis_kind: str, color: int) -> None:\n    n = grid.shape[0]\n    if axis_kind == \"row\":\n        grid[n // 2, :] = color\n    elif axis_kind == \"col\":\n        grid[:, n // 2] = color\n    elif axis_kind == \"main_diag\":\n        np.fill_diagonal(grid, color)\n    else:\n        np.fill_diagonal(np.fliplr(grid), color)\n\n\ndef _gen_side_mask(n: int, axis_kind: str, side: int) -> np.ndarray:\n    rr, cc = np.indices((n, n))\n    if axis_kind == \"row\":\n        return rr < n // 2 if side == 0 else rr > n // 2\n    if axis_kind == \"col\":\n        return cc < n // 2 if side == 0 else cc > n // 2\n    if axis_kind == \"main_diag\":\n        return cc > rr if side == 0 else cc < rr\n    return rr + cc < n - 1 if side == 0 else rr + cc > n - 1\n\n\ndef _gen_reflect(axis_kind: str, n: int, r: int, c: int) -> tuple[int, int]:\n    if axis_kind == \"row\":\n        return n - 1 - r, c\n    if axis_kind == \"col\":\n        return r, n - 1 - c\n    if axis_kind == \"main_diag\":\n        return c, r\n    return n - 1 - c, n - 1 - r\n\n\ndef _gen_feasible_counts(total: int, lo: int, hi: int) -> list[int]:\n    return [count for count in _GEN_COMPONENT_COUNT_RANGE if count * lo <= total <= count * hi]\n\n\ndef _gen_partition(total: int, count: int, lo: int, hi: int) -> list[int]:\n    sizes = []\n    remaining = total\n    for idx in range(count):\n        left = count - idx - 1\n        cur_lo = max(lo, remaining - left * hi)\n        cur_hi = min(hi, remaining - left * lo)\n        size = random.randint(cur_lo, cur_hi)\n        sizes.append(size)\n        remaining -= size\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _gen_pick_component_sizes() -> tuple[list[int], list[int]]:\n    mirror_total = random.randint(*_GEN_MIRROR_TOTAL_RANGE)\n    ratio_num, ratio_den = _GEN_MIN_NONMIRROR_RATIO\n    nonmirror_lo = max(\n        _GEN_NONMIRROR_TOTAL_RANGE[0],\n        (ratio_num * mirror_total + ratio_den - 1) // ratio_den,\n    )\n    nonmirror_hi = min(_GEN_NONMIRROR_TOTAL_RANGE[1], _GEN_MAX_NONMIRROR_MULTIPLIER * mirror_total)\n    nonmirror_total = random.randint(nonmirror_lo, nonmirror_hi)\n\n    mirror_count = random.choice(_gen_feasible_counts(mirror_total, *_GEN_MIRROR_COMPONENT_SIZE_RANGE))\n    nonmirror_count = random.choice(_gen_feasible_counts(nonmirror_total, *_GEN_NONMIRROR_COMPONENT_SIZE_RANGE))\n    mirror_sizes = _gen_partition(mirror_total, mirror_count, *_GEN_MIRROR_COMPONENT_SIZE_RANGE)\n    nonmirror_sizes = _gen_partition(nonmirror_total, nonmirror_count, *_GEN_NONMIRROR_COMPONENT_SIZE_RANGE)\n    return mirror_sizes, nonmirror_sizes\n\n\ndef _gen_mark_neighbors(blocked: np.ndarray, coords: np.ndarray) -> None:\n    n = blocked.shape[0]\n    for r_raw, c_raw in coords:\n        r = int(r_raw)\n        c = int(c_raw)\n        blocked[r, c] = True\n        for dr, dc in _GEN_DIRS4:\n            rr = r + dr\n            cc = c + dc\n            if 0 <= rr < n and 0 <= cc < n:\n                blocked[rr, cc] = True\n\n\ndef _gen_grow_component(\n    side_mask: np.ndarray, occupied: np.ndarray, same_color_blocked: np.ndarray, size: int\n) -> np.ndarray | None:\n    available = side_mask & ~occupied & ~same_color_blocked\n    choices = [coords for coords in components_mask(available, connectivity=4) if len(coords) >= size]\n    if not choices:\n        return None\n\n    region = random.choice(choices)\n    seed = tuple(int(x) for x in region[random.randrange(len(region))])\n    selected = {seed}\n    frontier: set[tuple[int, int]] = set()\n","exit_code":0,"status":"completed"}}
