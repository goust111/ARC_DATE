{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/6350f1f4.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, colors_present, components_mask\nimport math\nimport random\n\n\nERASED = Color.GREY\nSEPARATOR = Color.BLACK\n\n\ndef _is_separator_line(line: np.ndarray) -> bool:\n    return set(map(int, line)).issubset({SEPARATOR, ERASED})\n\n\ndef _regular_intervals(separators: list[int], length: int) -> list[tuple[int, int]]:\n    assert separators, \"expected at least one separator line\"\n    bounds = [-1, *separators, int(length)]\n    intervals = [(bounds[i] + 1, bounds[i + 1]) for i in range(len(bounds) - 1)]\n    sizes = [end - start for start, end in intervals]\n    assert min(sizes) > 0, \"separators must leave non-empty blocks\"\n    assert len(set(sizes)) == 1, \"all encoded blocks must have the same size\"\n    return intervals\n\n\ndef _find_sprite(\n    g: np.ndarray,\n    row_intervals: list[tuple[int, int]],\n    col_intervals: list[tuple[int, int]],\n    payload_colors: list[int],\n) -> np.ndarray:\n    payload = set(payload_colors)\n    sprites = []\n\n    for r0, r1 in row_intervals:\n        for c0, c1 in col_intervals:\n            block = g[r0:r1, c0:c1]\n            block_colors = set(colors_present(block, exclude={ERASED}))\n            assert SEPARATOR not in block_colors, \"block interiors cannot contain separator color\"\n            if ERASED not in set(map(int, block.flat)) and block_colors == payload:\n                sprites.append(block.copy())\n\n    assert sprites, \"expected at least one fully visible sprite block\"\n    sprite = sprites[0]\n    for candidate in sprites:\n        assert np.array_equal(candidate, sprite), \"fully visible sprite blocks must match\"\n    return sprite\n\n\ndef _foreground_and_blank(sprite: np.ndarray, payload_colors: list[int]) -> tuple[int, int]:\n    counts = {color: int(np.count_nonzero(sprite == color)) for color in payload_colors}\n    assert counts[payload_colors[0]] != counts[payload_colors[1]], \"sprite colors must have a majority/minority split\"\n    foreground = max(payload_colors, key=lambda color: counts[color])\n    blank_colors = [color for color in payload_colors if color != foreground]\n    assert len(blank_colors) == 1\n    return int(foreground), int(blank_colors[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Decode a block-grid image by swapping each sprite-coded cell with a solid cell and each blank cell with the sprite.\n\n    Input structure\n    The grid is partitioned by black separator rows and columns into equal-size\n    square blocks. Each block is either a copy of one two-color sprite or a\n    uniform blank block of the sprite's minority color; grey pixels are erased\n    cells that act as wildcards.\n\n    Rule\n    Infer the repeated sprite from fully visible mixed-color blocks. Replace a\n    block matching that sprite, ignoring grey erasures, with a solid block of\n    the sprite's majority color. Replace a uniform blank block with the sprite.\n    Separator rows and columns, including grey erasures on them, become black.\n\n    Key insight\n    The small sprite is a block-level code for one macro-cell state, and the\n    uniform minority-color block is the other state; the output renders the\n    opposite code in each macro-cell while cleaning erased pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n\n    row_separators = [r for r in range(H) if _is_separator_line(g[r, :])]\n    col_separators = [c for c in range(W) if _is_separator_line(g[:, c])]\n    row_intervals = _regular_intervals(row_separators, H)\n    col_intervals = _regular_intervals(col_separators, W)\n    block_heights = {r1 - r0 for r0, r1 in row_intervals}\n    block_widths = {c1 - c0 for c0, c1 in col_intervals}\n    assert block_heights == block_widths, \"encoded blocks must be square\"\n\n    payload_colors = colors_present(g, exclude={SEPARATOR, ERASED})\n    assert len(payload_colors) == 2, \"expected exactly two non-separator payload colors\"\n    sprite = _find_sprite(g, row_intervals, col_intervals, payload_colors)\n    foreground, blank = _foreground_and_blank(sprite, payload_colors)\n\n    out = np.zeros_like(g)\n    for r0, r1 in row_intervals:\n        for c0, c1 in col_intervals:\n            block = g[r0:r1, c0:c1]\n            known = block != ERASED\n            assert known.any(), \"each block must expose at least one non-grey cell\"\n            matches_sprite = bool(np.all(block[known] == sprite[known]))\n            matches_blank = bool(np.all(block[known] == blank))\n            assert matches_sprite != matches_blank, \"each block must unambiguously match the sprite or blank state\"\n            out[r0:r1, c0:c1] = foreground if matches_sprite else sprite\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette bounds.\nGRID_COUNT_RANGE, BLOCK_SIZE_RANGE = (2, 4), (2, 4)\nPAYLOAD_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\nPAYLOAD_COLOR_COUNT = 2\nGEN_SEPARATOR_COLOR, GEN_ERASED_COLOR = int(SEPARATOR), int(ERASED)\n\n# Sprite composition constraints.\nSPRITE_FG_MIN_RATIO, SPRITE_FG_MAX_RATIO = (2, 3), (3, 4)\nSPRITE_ATTEMPTS, TINY_BLOCK_SIZE = 80, 2\n\n# Macro-cell state constraints.\nMIN_BLANK_BLOCKS, MAX_BLANK_BLOCK_DENOMINATOR = 1, 2\n\n# Grey overlay constraints.\nGREY_MIN_FRACTION, GREY_MAX_FRACTION = 0.05, 0.25\nGREY_TWO_COMPONENT_PROBABILITY, GREY_TWO_COMPONENT_ATTEMPTS = 0.5, 30\nGREY_CONNECTIVITY, GENERATION_ATTEMPTS = 4, 300\n\nNEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _separator_indices(n: int, block_size: int) -> set[int]:\n    return {(i + 1) * block_size + i for i in range(n - 1)}\n\n\ndef _block_origin(br: int, bc: int, block_size: int) -> tuple[int, int]:\n    return br * (block_size + 1), bc * (block_size + 1)\n\n\ndef _has_symmetry(mask: np.ndarray) -> bool:\n    return (\n        np.array_equal(mask, np.fliplr(mask))\n        or np.array_equal(mask, np.flipud(mask))\n        or np.array_equal(mask, np.rot90(mask, 2))\n    )\n\n\ndef _make_sprite(block_size: int, foreground: int, blank: int) -> np.ndarray | None:\n    area = block_size * block_size\n    min_num, min_den = SPRITE_FG_MIN_RATIO\n    max_num, max_den = SPRITE_FG_MAX_RATIO\n    fg_min = math.ceil(area * min_num / min_den)\n    fg_max = math.floor(area * max_num / max_den)\n    if fg_min > fg_max:\n        fg_min = fg_max = round(area * min_num / min_den)\n    fg_count = random.randint(fg_min, fg_max)\n    blank_count = area - fg_count\n\n    for _ in range(SPRITE_ATTEMPTS):\n        mask = np.ones((block_size, block_size), dtype=bool)\n        if block_size == TINY_BLOCK_SIZE:\n            blanks = [random.randrange(area)]\n        else:\n            cols = list(range(block_size))\n            random.shuffle(cols)\n            blanks = [r * block_size + cols[r] for r in range(block_size)]\n            extra = blank_count - block_size\n            if extra > 0:\n                pool = [i for i in range(area) if i not in blanks]\n                blanks.extend(random.sample(pool, extra))\n\n        for idx in blanks:\n            mask[idx // block_size, idx % block_size] = False\n\n        if block_size > TINY_BLOCK_SIZE:\n            row_mixed = all(0 < np.count_nonzero(mask[r]) < block_size for r in range(block_size))\n            col_mixed = all(0 < np.count_nonzero(mask[:, c]) < block_size for c in range(block_size))\n            if not row_mixed or not col_mixed:\n                continue\n        if _has_symmetry(mask):\n            continue\n\n        sprite = np.where(mask, foreground, blank).astype(int)\n        return sprite\n    return None\n\n\ndef _neighbors4(r: int, c: int, height: int, width: int):\n    for dr, dc in NEIGHBOR_OFFSETS_4:\n        nr, nc = r + dr, c + dc\n        if 0 <= nr < height and 0 <= nc < width:\n            yield nr, nc\n\n\ndef _grow_blob(allowed: np.ndarray, size: int) -> set[tuple[int, int]] | None:\n    comps = [\n        [tuple(map(int, rc)) for rc in coords]\n        for coords in components_mask(allowed, connectivity=GREY_CONNECTIVITY)\n        if len(coords) >= size\n    ]\n    if not comps:\n        return None\n\n    comp = random.choice(comps)\n    comp_set = set(comp)\n    seed = random.choice(comp)\n    blob = {seed}\n    frontier = {nb for nb in _neighbors4(*seed, *allowed.shape) if nb in comp_set}\n\n    while len(blob) < size:\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        blob.add(cell)\n        for nb in _neighbors4(*cell, *allowed.shape):\n            if nb in comp_set and nb not in blob:\n                frontier.add(nb)\n\n    return blob\n\n\ndef _make_grey_mask(allowed: np.ndarray, target: int) -> np.ndarray | None:\n    if target <= 0:\n        return np.zeros_like(allowed, dtype=bool)\n\n    want_two = target >= 2 and random.random() < GREY_TWO_COMPONENT_PROBABILITY\n    if want_two:\n        for _ in range(GREY_TWO_COMPONENT_ATTEMPTS):\n            first_size = random.randint(1, target - 1)\n            first = _grow_blob(allowed, first_size)\n            if first is None:\n                continue\n\n            blocked = set(first)\n            for r, c in tuple(first):\n                blocked.update(_neighbors4(r, c, *allowed.shape))\n\n            allowed_second = allowed.copy()\n            for r, c in blocked:\n                allowed_second[r, c] = False\n\n            second = _grow_blob(allowed_second, target - first_size)\n            if second is None:\n                continue\n\n            mask = np.zeros_like(allowed, dtype=bool)\n            for r, c in first | second:\n                mask[r, c] = True\n            return mask\n\n    one = _grow_blob(allowed, target)\n    if one is None:\n        return None\n\n    mask = np.zeros_like(allowed, dtype=bool)\n    for r, c in one:\n        mask[r, c] = True\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/3bd292e8.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import defaultdict, deque\n\nimport numpy as np\n\nfrom arc_utils import Color, get_bg, label_mask, neighbors4\nimport itertools\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor wall-separated background regions alternately, starting with grey in the lower-left region.\n\n    Input structure\n    - The grid has one dominant background color and one foreground wall color.\n    - The wall pixels form one or more 4-connected one-cell-thick segments.\n    - Each wall segment separates exactly two 4-connected background regions.\n    Rule\n    - Keep all wall pixels unchanged.\n    - Label the 4-connected background regions and connect two labels when they\n      touch opposite sides of the same wall segment.\n    - Color the region containing the lower-left corner grey, then flip between\n      grey and green across every wall adjacency.\n    Key insight\n    - The red walls define a bipartite map of regions; the lower-left background\n      region fixes which side of the alternating coloring is grey.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    H, W = g.shape\n\n    colors = set(map(int, g.flat))\n    assert len(colors) == 2, \"expected exactly one background color and one wall color\"\n    bg = get_bg(g)\n    wall_colors = colors - {int(bg)}\n    assert len(wall_colors) == 1\n    wall = int(next(iter(wall_colors)))\n\n    bg_lab, n_regions = label_mask(g == int(bg), connectivity=4)\n    assert n_regions >= 2, \"walls must split the background into multiple regions\"\n    start_region = int(bg_lab[H - 1, 0])\n    assert start_region > 0, \"lower-left corner must belong to a background region\"\n\n    wall_lab, n_walls = label_mask(g == wall, connectivity=4)\n    assert n_walls >= 1\n\n    graph: dict[int, set[int]] = defaultdict(set)\n    for wall_id in range(1, n_walls + 1):\n        adjacent_regions: set[int] = set()\n        for r, c in np.argwhere(wall_lab == wall_id):\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W:\n                    region_id = int(bg_lab[rr, cc])\n                    if region_id > 0:\n                        adjacent_regions.add(region_id)\n\n        assert len(adjacent_regions) == 2, \"each wall segment must separate exactly two regions\"\n        a, b = tuple(adjacent_regions)\n        graph[a].add(b)\n        graph[b].add(a)\n\n    parity = {start_region: 0}\n    queue = deque([start_region])\n    while queue:\n        region = queue.popleft()\n        for neighbor in graph[region]:\n            neighbor_parity = 1 - parity[region]\n            if neighbor in parity:\n                assert parity[neighbor] == neighbor_parity, \"region graph must be bipartite\"\n            else:\n                parity[neighbor] = neighbor_parity\n                queue.append(neighbor)\n\n    assert set(parity) == set(range(1, n_regions + 1)), \"all background regions must be wall-connected\"\n\n    out = g.copy()\n    for region_id, region_parity in parity.items():\n        out[bg_lab == region_id] = Color.GREY if region_parity == 0 else Color.GREEN\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Grid, colors, and retry policy.\nGRID_SIZES = (7, 8, 9)\nGRID_SIZES_FOR_THREE_WALLS = (8, 9)\nWALL_COUNT_RANGE = (1, 3)\nMAX_GENERATION_ATTEMPTS = 300\nBACKGROUND_COLOR = Color.ORANGE\nWALL_COLOR = Color.RED\n\n# Wall geometry constraints.\nWALL_LENGTH_RANGE = (4, 13)\nWALL_TURN_RANGE = (1, 5)\nENDPOINT_SPACING = 2\nMAX_STAIR_PARTS = 3\nMIN_FIRST_STAIR_COL = 1\n\n# Left-right corridor layout.\nLR_LAYOUT_MAX_WALLS = 2\nLR_LAYOUT_PROBABILITY = 0.55\nLR_TURN_OPTIONS = (2, 4)\nLR_CORRIDOR_MAX_SPAN = 3\nLR_CORRIDOR_GAP = 2\n\n# Canonical grids are randomly mapped through one of eight dihedral transforms.\nTRANSFORM_OPS = 8\n\n\ndef _contains(bounds: tuple[int, int], value: int) -> bool:\n    lo, hi = bounds\n    return lo <= int(value) <= hi\n\n\ndef _paint_wall_path(grid: np.ndarray, cells: list[tuple[int, int]]) -> bool:\n    for r, c in cells:\n        if grid[r, c] != BACKGROUND_COLOR:\n            return False\n        grid[r, c] = WALL_COLOR\n    return True\n\n\ndef _split_positive(total: int, parts: int) -> list[int]:\n    if parts == 1:\n        return [int(total)]\n    cuts = sorted(random.sample(range(1, int(total)), int(parts) - 1))\n    return [b - a for a, b in zip([0] + cuts, cuts + [int(total)])]\n\n\ndef _spaced_combos(values: list[int], n: int) -> list[tuple[int, ...]]:\n    return [\n        combo\n        for combo in itertools.combinations(values, n)\n        if all(combo[i + 1] - combo[i] >= ENDPOINT_SPACING for i in range(len(combo) - 1))\n    ]\n\n\ndef _choose_endpoints(H: int, W: int, n_walls: int) -> tuple[tuple[int, ...], tuple[int, ...]] | None:\n    rows = _spaced_combos(list(range(1, H - 1)), n_walls)\n    cols = _spaced_combos(list(range(1, W - 1)), n_walls)\n    valid: list[tuple[tuple[int, ...], tuple[int, ...]]] = []\n    for start_rows in rows:\n        for cols_asc in cols:\n            end_cols = tuple(reversed(cols_asc))\n            lengths = [c + (H - 1 - r) + 1 for r, c in zip(start_rows, end_cols)]\n            if all(_contains(WALL_LENGTH_RANGE, length) for length in lengths):\n                valid.append((start_rows, end_cols))\n    return random.choice(valid) if valid else None\n\n\ndef _stair_path_lb(H: int, W: int, start_r: int, end_c: int, min_first_col: int) -> list[tuple[int, int]] | None:\n    down = H - 1 - int(start_r)\n    right = int(end_c)\n    max_parts = min(MAX_STAIR_PARTS, down, right)\n    feasible = [k for k in range(1, max_parts + 1) if right >= int(min_first_col) + k - 1]\n    if not feasible:\n        return None\n    weights = [k * k for k in feasible]\n    k = random.choices(feasible, weights=weights, k=1)[0]\n\n    if k == 1:\n        horiz = [right]\n    else:\n        first = random.randint(int(min_first_col), right - (k - 1))\n        horiz = [first] + _split_positive(right - first, k - 1)\n    vert = _split_positive(down, k)\n\n    r, c = int(start_r), 0\n    cells = [(r, c)]\n    for h_run, v_run in zip(horiz, vert):\n        for _ in range(h_run):\n            c += 1\n            cells.append((r, c))\n        for _ in range(v_run):\n            r += 1\n            cells.append((r, c))\n\n    if (r, c) != (H - 1, int(end_c)):\n        return None\n    return cells\n\n\ndef _build_lower_left_grid(H: int, W: int, n_walls: int) -> np.ndarray | None:\n    endpoints = _choose_endpoints(H, W, n_walls)\n    if endpoints is None:\n        return None\n    start_rows, end_cols = endpoints\n\n    grid = np.full((H, W), BACKGROUND_COLOR, dtype=int)\n    for i, (start_r, end_c) in enumerate(zip(start_rows, end_cols)):\n        min_first_col = end_cols[i + 1] + ENDPOINT_SPACING if i + 1 < n_walls else MIN_FIRST_STAIR_COL\n        cells = _stair_path_lb(H, W, start_r, end_c, min_first_col)\n        if cells is None or not _paint_wall_path(grid, cells):\n            return None\n    return grid\n\n\ndef _choose_lr_corridors(H: int, n_walls: int) -> tuple[tuple[int, int], ...] | None:\n    intervals = []\n    for lo in range(1, H - 2):\n        for hi in range(lo + 1, min(H - 2, lo + LR_CORRIDOR_MAX_SPAN) + 1):\n            intervals.append((lo, hi))\n    valid: list[tuple[tuple[int, int], ...]] = []\n    for combo in itertools.combinations(intervals, n_walls):\n        if all(combo[i][1] + LR_CORRIDOR_GAP <= combo[i + 1][0] for i in range(n_walls - 1)):\n            valid.append(combo)\n    return random.choice(valid) if valid else None\n\n\ndef _lr_path(W: int, lo: int, hi: int) -> list[tuple[int, int]] | None:\n    short_turn, long_turn = LR_TURN_OPTIONS\n    turn_goal = random.choice(LR_TURN_OPTIONS)\n    if turn_goal == long_turn and W - 1 < long_turn:\n        turn_goal = short_turn\n\n    if turn_goal == short_turn:\n        h1 = random.randint(1, W - 2)\n        horiz = [h1, W - 1 - h1]\n        r0, r1 = random.sample(range(lo, hi + 1), 2)\n        rows = [r0, r1]\n    else:\n        if hi - lo >= 2:\n            if random.random() < 0.5:\n                rows = [lo, random.randint(lo + 1, hi - 1), hi]\n            else:\n                rows = [hi, random.randint(lo + 1, hi - 1), lo]\n            middle_min = 1\n        else:\n            rows = [lo, hi, lo] if random.random() < 0.5 else [hi, lo, hi]\n            middle_min = 2\n        if W - 1 < middle_min + 2:\n            return None\n        h2 = random.randint(middle_min, W - 3)\n        h1 = random.randint(1, W - 1 - h2 - 1)\n        horiz = [h1, h2, W - 1 - h1 - h2]\n\n    r, c = int(rows[0]), 0\n    cells = [(r, c)]\n    for i, h_run in enumerate(horiz):\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/f0f8a26d.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/f0f8a26d.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, find_components, get_bg\nimport random\n\n\ndef _rotated_bar_coords(coords: np.ndarray) -> list[tuple[int, int]]:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    height = r1 - r0 + 1\n    width = c1 - c0 + 1\n    area = int(coords.shape[0])\n\n    assert height == 1 or width == 1\n    length = max(height, width)\n    assert area == length\n    assert length % 2 == 1\n\n    cr = (r0 + r1) // 2\n    cc = (c0 + c1) // 2\n    half = length // 2\n\n    if length == 1:\n        return [(cr, cc)]\n    if height == 1:\n        return [(r, cc) for r in range(cr - half, cr + half + 1)]\n    return [(cr, c) for c in range(cc - half, cc + half + 1)]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate every foreground bar 90 degrees around its own center on the same canvas.\n\n    Input structure\n    The background is the dominant color, and all foreground pixels share one color.\n    Each 4-connected foreground object is a solid one-cell-thick horizontal or vertical\n    bar with odd length, with single-pixel bars allowed.\n\n    Rule\n    Clear the canvas to the background, then redraw every bar with its midpoint, length,\n    and color preserved while swapping horizontal and vertical orientation.\n\n    Key insight\n    The bars are independent objects: their centers and lengths identify the output\n    placement, so no matching, ordering, or global symmetry is needed.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n\n    out = np.full_like(g, bg)\n    h, w = g.shape\n    components = find_components(\n        g,\n        bg=bg,\n        connectivity=4,\n        monochromatic=True,\n        colors=fg_colors,\n    )\n    assert components\n\n    for comp in components:\n        color = int(comp[\"color\"])\n        for r, c in _rotated_bar_coords(comp[\"coords\"]):\n            assert 0 <= r < h and 0 <= c < w\n            assert out[r, c] == bg\n            out[r, c] = color\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# Palette and canvas options.\nBG_COLOR = 7\nFG_COLORS = tuple(c for c in range(10) if c != BG_COLOR)\nGRID_SIDES = (9, 11, 13)\n\n# Bar counts and weighted odd-length sampling.\nMIN_BARS, EXTRA_LENGTH_CANDIDATES = 5, 5\nMAX_BARS_BY_SIDE = {9: 6, 11: 8, 13: 10}\nLENGTH_WEIGHT_BY_SIZE = {1: 8, 3: 56, 5: 26, 7: 6, 9: 3}\nDEFAULT_LENGTH_WEIGHT = 1\nORIENTATIONS = (\"H\", \"V\")\n\n# Retry and placement search limits.\nOUTER_ATTEMPTS, INNER_ATTEMPTS = 10, 50\nCENTER_TRIAL_LIMIT = 80\n\ndef _sample_lengths(N, K):\n    possible_lengths = list(range(1, N + 1, 2))\n    weights = [LENGTH_WEIGHT_BY_SIZE.get(l, DEFAULT_LENGTH_WEIGHT) for l in possible_lengths]\n    lengths = random.choices(possible_lengths, weights=weights, k=K + EXTRA_LENGTH_CANDIDATES)\n    lengths.sort(reverse=True)\n    return lengths\n\ndef _bar_pixels(cr, cc, length, orient):\n    half = length // 2\n    if orient == \"H\":\n        return {(cr, cc + d) for d in range(-half, half + 1)}\n    return {(cr + d, cc) for d in range(-half, half + 1)}\n\ndef _place_one_bar(N, length, occupied):\n    \"\"\"Return input pixels for one placed bar, mutating occupied on success.\"\"\"\n    half = length // 2\n    lo, hi = half, N - 1 - half\n    if lo > hi:\n        return None\n    orient = random.choice(ORIENTATIONS)\n    out_orient = \"V\" if orient == \"H\" else \"H\"\n    candidates = [(r, c) for r in range(lo, hi + 1) for c in range(lo, hi + 1)]\n    random.shuffle(candidates)\n\n    for cr, cc in candidates[:CENTER_TRIAL_LIMIT]:\n        inp_pixels = _bar_pixels(cr, cc, length, orient)\n        out_pixels = _bar_pixels(cr, cc, length, out_orient)\n        footprint = inp_pixels | out_pixels\n        if footprint & occupied:\n            continue\n        occupied |= footprint\n        return inp_pixels\n    return None\n\ndef _place_bars(N, K):\n    occupied = set()\n    bars_input = []\n    for length in _sample_lengths(N, K):\n        if len(bars_input) >= K:\n            break\n        inp_pixels = _place_one_bar(N, length, occupied)\n        if inp_pixels is not None:\n            bars_input.append(inp_pixels)\n    return bars_input if len(bars_input) >= K else None\n\ndef _gen_attempt(N: int, K: int) -> np.ndarray | None:\n    fg = random.choice(FG_COLORS)\n    bars_input = _place_bars(N, K)\n    if bars_input is None:\n        return None\n\n    grid = np.full((N, N), BG_COLOR, dtype=int)\n    for bar_pixels in bars_input:\n        for r, c in bar_pixels:\n            grid[r, c] = fg\n\n    try:\n        main(grid)\n    except Exception:\n        return None\n    return grid\n\ndef generate_input() -> np.ndarray:\n    for _outer in range(OUTER_ATTEMPTS):\n        N = random.choice(GRID_SIDES)\n        K = random.randint(MIN_BARS, MAX_BARS_BY_SIDE[N])\n        for _ in range(INNER_ATTEMPTS):\n            result = _gen_attempt(N, K)\n            if result is not None:\n                return result\n    raise RuntimeError(\"Failed to generate valid input after many attempts\")\n","exit_code":0,"status":"completed"}}
