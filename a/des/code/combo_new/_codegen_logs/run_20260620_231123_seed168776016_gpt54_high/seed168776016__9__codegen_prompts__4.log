{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/def generate_input(/p' /home/lixinyu/snap/new/ARC_code/eval/269e22fb.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a visible crop into the shared 20x20 binary motif in its matching orientation.\n\n    Input structure:\n    - The grid is a two-color rectangular crop of one rotation/reflection of the same 20x20 motif.\n    - One color is the motif foreground and the other color is the motif background.\n\n    Rule:\n    - Try each input color as the foreground mask.\n    - Match that mask against every possible window in every dihedral orientation of the motif.\n    - Repaint the uniquely matched full 20x20 motif with the matched foreground/background colors.\n\n    Key insight:\n    - The examples are partial windows of one canonical binary pattern; the local crop is distinctive enough to identify the full orientation and offset.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = map(int, g.shape)\n    assert H <= 20 and W <= 20\n\n    colors = colors_present(g)\n    assert len(colors) == 2\n\n    base = _pattern_mask()\n    matches: list[tuple[int, int, np.ndarray]] = []\n    for fg in colors:\n        bg = int(colors[0] if int(colors[1]) == int(fg) else colors[1])\n        visible = g == int(fg)\n        for pattern in _dihedral_variants(base):\n            for r in range(20 - H + 1):\n                for c in range(20 - W + 1):\n                    if np.array_equal(pattern[r : r + H, c : c + W], visible):\n                        matches.append((int(fg), int(bg), pattern))\n\n    assert len(matches) == 1\n    fg, bg, pattern = matches[0]\n    return np.where(pattern, int(fg), int(bg)).astype(int)\n","exit_code":0,"status":"completed"}}
