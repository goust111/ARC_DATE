{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/f931b4a8.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count the two upper quadrant control regions to size an output made from the lower quadrant pattern.\n\n    Input structure:\n    - The grid is an even square split into four equal quadrants.\n    - Black is the background.\n    - The upper-left and upper-right quadrants are control regions.\n    - The lower-left quadrant is a color source tile; the lower-right quadrant is either a stencil tile or empty.\n\n    Rule:\n    - Output height is the number of non-background pixels in the upper-left quadrant.\n    - Output width is the number of non-background pixels in the upper-right quadrant.\n    - If the lower-right stencil has foreground pixels, tile it over the output; each stencil background pixel is filled from the lower-left quadrant cell at the corresponding coarse tile position.\n    - If the lower-right stencil is empty, tile the lower-left quadrant directly over the output.\n\n    Key insight:\n    - The top quadrants specify only dimensions, while the bottom quadrants specify a two-level repeated pattern: a fine stencil and coarse fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h == w and h % 2 == 0 and w % 2 == 0\n\n    bg = int(Color.BLACK)\n    qh, qw = h // 2, w // 2\n    upper_left = g[:qh, :qw]\n    upper_right = g[:qh, qw:]\n    fill_tile = g[qh:, :qw]\n    stencil = g[qh:, qw:]\n\n    out_h = int(np.count_nonzero(upper_left != bg))\n    out_w = int(np.count_nonzero(upper_right != bg))\n    assert out_h > 0 and out_w > 0\n\n    out = np.empty((out_h, out_w), dtype=int)\n    if not np.any(stencil != bg):\n        for r in range(out_h):\n            for c in range(out_w):\n                value = int(fill_tile[r % qh, c % qw])\n                assert value != bg\n                out[r, c] = value\n        return out\n\n    for r in range(out_h):\n        for c in range(out_w):\n            value = int(stencil[r % qh, c % qw])\n            if value == bg:\n                fill_r = r // qh\n                fill_c = c // qw\n                assert fill_r < qh and fill_c < qw\n                value = int(fill_tile[fill_r, fill_c])\n                assert value != bg\n            out[r, c] = value\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom math import ceil\n\n# ── configuration constants ──────────────────────────────────────────\nBLACK = 0\nCOLORS = tuple(range(1, 10))\n\nGRID_SIZES = (4, 8, 16)                # allowed input grid side-lengths N\nSTENCIL_EMPTY_PROB = 0.16               # chance lower-right is all-black\nLL_SOLID_PROB = 0.70                    # chance fill tile is single-color\nLL_MULTI_COLOR_RANGE = (2, 3)           # color count when fill tile is multi-color\nSTENCIL_SINGLE_COLOR_PROB = 0.75        # chance stencil uses one fg color\nSTENCIL_MULTI_COLOR_RANGE = (2, 4)      # color count when stencil is multi-color\nSTENCIL_FG_FRAC = (0.30, 0.75)          # fg fraction range for random stencil mode\nSTENCIL_FRAME_MIN_Q = 4                 # min quadrant size to allow frame stencil\nCONTROL_SINGLE_COLOR_PROB = 0.85        # chance control quadrant uses one color\nCONTROL_RECT_PROB = 0.85                # chance control pixels form an axis-aligned rect\nUL_MAX_COLORS = 3                       # max distinct colors in upper-left control\nUR_MAX_COLORS = 2                       # max distinct colors in upper-right control\nOUTPUT_DIM_MIN = 3                      # minimum output height/width\nOUTPUT_DIM_MAX = 16                     # maximum output height/width\nOUTPUT_AREA_MAX = 256                   # maximum output area\nGEN_MAX_RETRIES = 300                   # retry budget for generate_input\n\n\n# ── palette helpers ──────────────────────────────────────────────────\n\ndef _palette(k: int, pool=COLORS) -> list[int]:\n    \"\"\"Return k distinct colors sampled from pool.\"\"\"\n    pool = list(pool)\n    random.shuffle(pool)\n    return pool[:k]\n\n\ndef _random_color_array(shape: tuple[int, ...], palette: list[int]) -> np.ndarray:\n    \"\"\"Fill an array by drawing each cell independently from palette.\"\"\"\n    return np.array([random.choice(palette) for _ in range(int(np.prod(shape)))],\n                    dtype=int).reshape(shape)\n\n\n# ── coordinate orderings for control quadrant ────────────────────────\n\ndef _ordered_coords(q: int, mode: str) -> list[tuple[int, int]]:\n    \"\"\"Return all (r,c) in a qxq grid in a layout-dependent order.\"\"\"\n    coords = [(r, c) for r in range(q) for c in range(q)]\n    if mode == \"rect\":\n        r0, c0 = random.randint(0, q - 1), random.randint(0, q - 1)\n        return [((r + r0) % q, (c + c0) % q) for r, c in coords]\n    if mode == \"rows\":\n        rows, cols = list(range(q)), list(range(q))\n        random.shuffle(rows)\n        random.shuffle(cols)\n        return [(r, c) for r in rows for c in cols]\n    if mode == \"compact\":\n        ar, ac = random.randrange(q), random.randrange(q)\n        random.shuffle(coords)\n        return sorted(coords, key=lambda rc: (abs(rc[0] - ar) + abs(rc[1] - ac), random.random()))\n    # fallback\n    random.shuffle(coords)\n    return coords\n\n\n# ── quadrant builders ────────────────────────────────────────────────\n\ndef _make_lower_left(q: int, palette: list[int],\n                     required_coords: list[tuple[int, int]] | None = None) -> np.ndarray:\n    \"\"\"Build the fill tile (all non-black) using stripe/solid/diagonal patterns.\"\"\"\n    k = len(palette)\n    tile = np.empty((q, q), dtype=int)\n    mode = \"solid\" if k == 1 else random.choice([\"rows\", \"cols\", \"rows\", \"cols\", \"diagonal\"])\n\n    if mode == \"solid\":\n        tile[:] = palette[0]\n    elif mode == \"rows\":\n        offset = random.randrange(k)\n        for r in range(q):\n            tile[r, :] = palette[(r + offset) % k]\n    elif mode == \"cols\":\n        offset = random.randrange(k)\n        for c in range(q):\n            tile[:, c] = palette[(c + offset) % k]\n    elif mode == \"diagonal\":\n        offset = random.randrange(k)\n        rr, cc = np.mgrid[:q, :q]\n        idx = (rr + cc + offset) % k\n        for i, color in enumerate(palette):\n            tile[idx == i] = color\n\n    # ensure every palette color appears at least once\n    existing = set(map(int, np.unique(tile)))\n    missing = [c for c in palette if c not in existing]\n    if missing:\n        fix_coords = list(required_coords) if required_coords is not None else \\\n            [(r, c) for r in range(q) for c in range(q)]\n        random.shuffle(fix_coords)\n        for color, (r, c) in zip(missing, fix_coords):\n            tile[r, c] = color\n    return tile\n\n\ndef _make_stencil(q: int, palette: list[int]) -> np.ndarray:\n    \"\"\"Build the stencil tile (black = holes filled from fill tile).\"\"\"\n    tile = np.zeros((q, q), dtype=int)\n    modes = [\"checker\", \"row_stripe\", \"col_stripe\", \"random\", \"random\"]\n    if q >= STENCIL_FRAME_MIN_Q:\n        modes.append(\"frame\")\n    mode = random.choice(modes)\n\n    if mode == \"checker\":\n        parity = random.randrange(2)\n        mask = (np.arange(q)[:, None] + np.arange(q)[None, :]) % 2 == parity\n        tile[mask] = _random_color_array((int(mask.sum()),), palette)\n    elif mode == \"frame\":\n        t = random.randint(1, max(1, q // 4))\n        mask = np.ones((q, q), dtype=bool)\n        mask[t:q - t, t:q - t] = False\n        tile[mask] = _random_color_array((int(mask.sum()),), palette)\n    elif mode == \"row_stripe\":\n        parity = random.randrange(2)\n        for r in range(q):\n            if r % 2 == parity:\n                tile[r, :] = _random_color_array((q,), palette)\n    elif mode == \"col_stripe\":\n        parity = random.randrange(2)\n        for c in range(q):\n            if c % 2 == parity:\n                tile[:, c] = _random_color_array((q,), palette)\n    else:  # random scatter\n        area = q * q\n        lo = max(1, int(ceil(STENCIL_FG_FRAC[0] * area)))\n        hi = max(lo, int(STENCIL_FG_FRAC[1] * area))\n        fg_count = random.randint(lo, hi)\n        coords = [(r, c) for r in range(q) for c in range(q)]\n        random.shuffle(coords)\n        for r, c in coords[:fg_count]:\n            tile[r, c] = random.choice(palette)\n    return tile\n\n\ndef _make_control(q: int, count: int, max_colors: int, pool: list[int]) -> np.ndarray:\n    \"\"\"Build a control quadrant with exactly `count` non-black pixels.\"\"\"\n    k = 1 if random.random() < CONTROL_SINGLE_COLOR_PROB else \\\n        random.randint(2, min(max_colors, count, len(pool)))\n    pal = _palette(k, pool)\n    tile = np.full((q, q), BLACK, dtype=int)\n\n    factors = [(h, w) for h in range(1, q + 1) for w in range(1, q + 1) if h * w == count]\n    if factors and random.random() < CONTROL_RECT_PROB:\n        h, w = random.choice(factors)\n        r0 = random.randint(0, q - h)\n        c0 = random.randint(0, q - w)\n        tile[r0:r0 + h, c0:c0 + w] = _random_color_array((h, w), pal)\n    else:\n        mode = random.choice([\"rect\", \"compact\", \"rows\"])\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n","exit_code":0,"status":"completed"}}
