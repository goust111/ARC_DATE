{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nimport ast\npath = Path('/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py')\nsrc = path.read_text()\nmod = ast.parse(src)\nfor node in mod.body:\n    if isinstance(node, ast.FunctionDef) and node.name in ('main','generate_input'):\n        print(f'## {path.name}:{node.name}')\n        print('\\\\n'.join(src.splitlines()[node.lineno-1:node.end_lineno]))\n        print()\nPY\"","aggregated_output":"## ac6f9922.py:main\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\n## ac6f9922.py:generate_input\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid ac6f9922 input\")\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nimport ast\npath = Path('/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py')\nsrc = path.read_text()\nmod = ast.parse(src)\nfor node in mod.body:\n    if isinstance(node, ast.FunctionDef) and node.name in ('main','generate_input'):\n        print(f'## {path.name}:{node.name}')\n        print('\\\\n'.join(src.splitlines()[node.lineno-1:node.end_lineno]))\n        print()\nPY\"","aggregated_output":"## 8b7bacbf.py:main\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n## 8b7bacbf.py:generate_input\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exhausted attempts\")\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nimport ast\npath = Path('/home/lixinyu/snap/new/ARC_code/train/6ca952ad.py')\nsrc = path.read_text()\nmod = ast.parse(src)\nfor node in mod.body:\n    if isinstance(node, ast.FunctionDef) and node.name in ('main','generate_input'):\n        print(f'## {path.name}:{node.name}')\n        print('\\\\n'.join(src.splitlines()[node.lineno-1:node.end_lineno]))\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nimport ast\npath = Path('/home/lixinyu/snap/new/ARC_code/train/6ca952ad.py')\nsrc = path.read_text()\nmod = ast.parse(src)\nfor node in mod.body:\n    if isinstance(node, ast.FunctionDef) and node.name in ('main','generate_input'):\n        print(f'## {path.name}:{node.name}')\n        print('\\\\n'.join(src.splitlines()[node.lineno-1:node.end_lineno]))\n        print()\nPY\"","aggregated_output":"## 6ca952ad.py:main\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop every large foreground object straight down to the bottom while leaving small marker objects fixed.\n\n    Input structure:\n    - The grid has a dominant background color and exactly one foreground color.\n    - The foreground is split into separated 4-connected objects.\n    - Objects of area at most three are stationary markers; larger objects are moving sprites.\n\n    Rule:\n    - Clear each moving sprite from its original position.\n    - Translate each moving sprite vertically downward until its bbox bottom reaches the grid bottom.\n    - Repaint each translated sprite in its original color; small markers stay unchanged.\n\n    Key insight:\n    - Object area separates the active falling sprites from the small fixed markers, and all active sprites follow the same vertical path.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1, \"expected exactly one foreground color\"\n    fg = int(fg_colors[0])\n\n    components = find_components(\n        g,\n        bg=bg,\n        connectivity=4,\n        monochromatic=True,\n        colors=[fg],\n        return_format=\"dict\",\n    )\n    assert components, \"expected foreground objects\"\n\n    moving = [comp for comp in components if int(comp[\"area\"]) > SMALL_MARKER_MAX_AREA]\n    stationary = [comp for comp in components if int(comp[\"area\"]) <= SMALL_MARKER_MAX_AREA]\n    assert moving, \"expected at least one moving sprite\"\n    assert stationary, \"expected at least one fixed marker\"\n\n    out = g.copy()\n    for comp in moving:\n        coords = comp[\"coords\"]\n        out[coords[:, 0], coords[:, 1]] = bg\n\n    occupied = np.zeros((H, W), dtype=bool)\n    for comp in moving:\n        coords = comp[\"coords\"]\n        _r0, _c0, r1, _c1 = map(int, comp[\"bbox\"])\n        dr = H - 1 - r1\n        assert dr >= 0, \"moving sprite bbox must already be inside the grid\"\n\n        shifted = coords + np.array([dr, 0], dtype=int)\n        assert bool(np.all((0 <= shifted[:, 0]) & (shifted[:, 0] < H)))\n        assert bool(np.all((0 <= shifted[:, 1]) & (shifted[:, 1] < W)))\n        assert not bool(occupied[shifted[:, 0], shifted[:, 1]].any()), \"dropped sprites must not overlap\"\n        assert bool(np.all(out[shifted[:, 0], shifted[:, 1]] == bg)), \"drop path must end on background\"\n\n        occupied[shifted[:, 0], shifted[:, 1]] = True\n        out[shifted[:, 0], shifted[:, 1]] = int(comp[\"color\"])\n\n    return out\n\n## 6ca952ad.py:generate_input\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate a valid 6ca952ad input\")\n\n","exit_code":0,"status":"completed"}}
