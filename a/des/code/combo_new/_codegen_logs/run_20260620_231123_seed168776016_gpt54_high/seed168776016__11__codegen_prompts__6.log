{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '53,180p' /home/lixinyu/snap/new/ARC_code/eval/7b0280bc.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the shortest path between two terminal squares in a square-and-track graph.\n\n    Input structure:\n    - bg = most common color.\n    - Two non-bg colors form solid NxN squares (N>=2): one color marks exactly 2 terminals, the other marks stations.\n    - A third non-bg color forms 1-cell-wide track segments connecting pairs of squares (graph edges).\n\n    Rule:\n    - Find the shortest path (fewest edges) between the two terminal squares.\n    - Recolor every station square on that path to green.\n    - Recolor every track segment along that path to grey.\n    - Everything else unchanged.\n\n    Key insight: The grid encodes a graph where squares are nodes and tracks are edges; the task is graph shortest-path, not spatial proximity.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    # --- detect solid squares (nodes) and infer the dominant size N ---\n    square_cands = find_solid_squares(g, bg=bg, min_size=2, connectivity=8)\n    assert not (not square_cands)\n\n    size_counts = Counter([int(d[\"size\"]) for d in square_cands])\n    N = int(max(size_counts.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n    nodes_raw = [d for d in square_cands if int(d[\"size\"]) == int(N)]\n\n    nodes: list[dict] = []\n    for i, d in enumerate(nodes_raw):\n        pts = {(int(r), int(c)) for r, c in d[\"coords\"]}\n        nodes.append({\"id\": int(i), \"color\": int(d[\"color\"]), \"pts\": pts})\n\n    nodes_by_color: dict[int, list[int]] = defaultdict(list)\n    for nd in nodes:\n        nodes_by_color[int(nd[\"color\"])].append(int(nd[\"id\"]))\n\n    node_colors = sorted(nodes_by_color.keys())\n    assert not (len(node_colors) < 2)\n\n    terminal_color = None\n    station_color = None\n    for col in node_colors:\n        if len(nodes_by_color[int(col)]) == 2:\n            terminal_color = int(col)\n        else:\n            station_color = int(col)\n    assert not (terminal_color is None or station_color is None)\n    term_ids = list(map(int, nodes_by_color[int(terminal_color)]))\n\n    # Track color is the remaining non-bg color (not a node color).\n    non_bg_colors = colors_present(g, exclude={bg})\n    track_candidates = [c for c in non_bg_colors if int(c) not in (int(terminal_color), int(station_color))]\n    assert not (not track_candidates)\n    track_color = int(max(track_candidates, key=lambda c: int((g == int(c)).sum())))\n\n    # --- build node lookup ---\n    pix2node: dict[tuple[int, int], int] = {}\n    id2pts: dict[int, set[tuple[int, int]]] = {}\n    for nd in nodes:\n        nid = int(nd[\"id\"])\n        pts = set(nd[\"pts\"])\n        id2pts[nid] = pts\n        for p in pts:\n            pix2node[p] = nid\n\n    # --- build edges from track components that touch exactly 2 nodes (8-adjacency) ---\n    track_comps = components_mask(g == int(track_color), connectivity=8)\n    track_comp_pts: dict[int, list[tuple[int, int]]] = {}\n    adj: dict[int, list[tuple[int, int]]] = defaultdict(list)  # node -> [(neighbor, edge_id)]\n\n    for edge_id, coords in enumerate(track_comps, start=1):\n        pts = [(int(r), int(c)) for r, c in coords]\n        if not pts:\n            continue\n        touched: set[int] = set()\n        for r, c in pts:\n            for rr, cc in neighbors8(int(r), int(c)):\n                nid = pix2node.get((int(rr), int(cc)))\n                if nid is not None:\n                    touched.add(int(nid))\n        if len(touched) != 2:\n            continue\n        a, b = sorted(touched)\n        track_comp_pts[int(edge_id)] = pts\n        adj[int(a)].append((int(b), int(edge_id)))\n        adj[int(b)].append((int(a), int(edge_id)))\n\n    # --- shortest path between terminals (BFS by edge count) ---\n    start, goal = int(term_ids[0]), int(term_ids[1])\n    q = deque([start])\n    prev: dict[int, int | None] = {start: None}\n    prev_edge: dict[int, int | None] = {start: None}\n\n    while q:\n        u = int(q.popleft())\n        if u == goal:\n            break\n        for v, eid in adj.get(u, []):\n            if int(v) in prev:\n                continue\n            prev[int(v)] = int(u)\n            prev_edge[int(v)] = int(eid)\n            q.append(int(v))\n\n    assert not (goal not in prev)\n\n    node_path: list[int] = []\n    edge_path: list[int] = []\n    cur = int(goal)\n    while cur is not None:\n        node_path.append(int(cur))\n        e = prev_edge.get(int(cur))\n        if e is not None:\n            edge_path.append(int(e))\n        cur2 = prev.get(int(cur))\n        cur = int(cur2) if cur2 is not None else None\n    node_path.reverse()\n    edge_path.reverse()\n\n    # --- apply recolors in-place ---\n    out = g.copy()\n\n    term_set = set(map(int, term_ids))\n    for nid in node_path:\n        if int(nid) in term_set:\n            continue\n        for r, c in id2pts[int(nid)]:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '73,180p' /home/lixinyu/snap/new/ARC_code/eval/a6f40cea.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete partial paths inside a framed rectangle by projecting external color traces inward.\n\n    Input structure:\n    - bg, a 1px rectangular frame (border color) with uniform interior fill.\n    - Colored components outside the frame touching its edges.\n\n    Rule:\n    - Output = the frame's interior, filled with the fill color.\n    - Map each outside component's frame-touch points into interior coordinates.\n    - Monochrome components become solid Manhattan stripes between mapped endpoints.\n    - Two-color components become alternating-color Manhattan paths.\n\n    Key insight: Endpoint colors of two-color traces anchor the alternating phase deterministically.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    found = _find_framed_rect_uniform_fill(g, bg=int(bg))\n    assert not (found is None)\n    r0, c0, r1, c1, bc, fill = found\n    outH = int(r1 - r0 - 1)\n    outW = int(c1 - c0 - 1)\n    out = np.full((outH, outW), int(fill), dtype=int)\n    r_int0 = int(r0 + 1)\n    c_int0 = int(c0 + 1)\n\n    def map_to_out(rr: int, cc: int) -> tuple[int, int]:\n        r = max(0, min(outH - 1, int(rr - r_int0)))\n        c = max(0, min(outW - 1, int(cc - c_int0)))\n        return int(r), int(c)\n\n    def build_manhattan(p1: tuple[int, int], p2: tuple[int, int], cornerA: bool) -> list[tuple[int, int]]:\n        (ra, ca), (rb, cb) = p1, p2\n        if ra == rb:\n            step = 1 if cb >= ca else -1\n            return [(int(ra), int(c)) for c in range(int(ca), int(cb) + step, step)]\n        if ca == cb:\n            step = 1 if rb >= ra else -1\n            return [(int(r), int(ca)) for r in range(int(ra), int(rb) + step, step)]\n        if cornerA:\n            step = 1 if rb >= ra else -1\n            path = [(int(r), int(ca)) for r in range(int(ra), int(rb) + step, step)]\n            step = 1 if cb >= ca else -1\n            path += [(int(rb), int(c)) for c in range(int(ca) + step, int(cb) + step, step)]\n            return path\n        step = 1 if cb >= ca else -1\n        path = [(int(ra), int(c)) for c in range(int(ca), int(cb) + step, step)]\n        step = 1 if rb >= ra else -1\n        path += [(int(r), int(cb)) for r in range(int(ra) + step, int(rb) + step, step)]\n        return path\n\n    def inside_corner(p1: tuple[int, int], p2: tuple[int, int], cornerA: bool) -> bool:\n        (ra, ca), (rb, cb) = p1, p2\n        if ra == rb or ca == cb:\n            return True\n        corner = (rb, ca) if cornerA else (ra, cb)\n        rr, cc = corner\n        return (0 < rr < outH - 1) and (0 < cc < outW - 1)\n\n    # --- ring components (outside the frame) ---\n    comp_mask = (g != int(bg)) & (g != int(fill)) & (g != int(bc))\n    clab, cn = label(comp_mask, structure=STRUCT4)\n\n    ring = set()\n    for cc in range(c0, c1 + 1):\n        for rr in (r0 - 1, r1 + 1):\n            if 0 <= rr < H:\n                ring.add((int(rr), int(cc)))\n    for rr in range(r0, r1 + 1):\n        for cc in (c0 - 1, c1 + 1):\n            if 0 <= cc < W:\n                ring.add((int(rr), int(cc)))\n\n    # cid -> list of (mapped_r, mapped_c, color)\n    comp_pts: dict[int, list[tuple[int, int, int]]] = defaultdict(list)\n    for rr, cc in ring:\n        cid = int(clab[rr, cc])\n        if cid == 0:\n            continue\n        col = int(g[rr, cc])\n        mr, mc = map_to_out(rr, cc)\n        comp_pts[cid].append((mr, mc, col))\n\n    # per-component color sets\n    comp_cols: dict[int, list[int]] = {}\n    for cid in range(1, int(cn) + 1):\n        comp_cols[cid] = sorted(set(map(int, g[clab == int(cid)].flatten())))\n\n    deferred: dict[int, set[tuple[int, int]]] = defaultdict(set)\n\n    for cid, pts in comp_pts.items():\n        if len(pts) < 2:\n            continue\n        cols = comp_cols.get(cid, [])\n        if not cols:\n            continue\n\n        # build per-coordinate color histogram (clamp can merge multiple ring pixels)\n        hist: dict[tuple[int, int], Counter] = defaultdict(Counter)\n        for r, c, col in pts:\n            hist[(int(r), int(c))][int(col)] += 1\n\n        coords = list(hist.keys())\n\n        if len(cols) == 1:\n","exit_code":0,"status":"completed"}}
