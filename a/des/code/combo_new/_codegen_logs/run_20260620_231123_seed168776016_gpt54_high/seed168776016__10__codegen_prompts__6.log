in group:\n  90:             col = item[\"col\"]\n  91:             height = item[\"height\"]\n  92:             assert col + height <= g.shape[1]\n  93:             out[baseline, col : col + height] = item[\"color\"]\n  94: \n  95:     return out\n  96: \n  97: # --------------- generator (att2) ---------------\n  98: \n  99: # Canvas bounds.\n 100: MIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n 101: \n 102: # Bar and chain structure.\n 103: MIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\n 104: MIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\n 105: MIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n 106: \n 107: # Layout padding and retry budget.\n 108: GAP_VALUES = (1, 2, 3)\n 109: MAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n 110: \n 111: \n 112: def _chain_red_distributions(n_blue, n_red):\n 113:     \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n 114:     return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n 115: \n 116: \n 117: def _bounded_tuples(values, n, max_sum):\n 118:     \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n 119:     return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n 120: \n 121: \n 122: def _sample_groups():\n 123:     \"\"\"Sample row count and bar groups before physical layout.\"\"\"\n 124:     rows = random.randint(MIN_ROWS, MAX_ROWS)\n 125:     max_height = min(MAX_BAR_HEIGHT, rows)\n 126:     n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)\n 127:     max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)\n 128:     red_total = random.randint(MIN_RED_BARS, max_red)\n 129:     min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)\n 130:     max_unchained = min(MAX_UNCHAINED_RED, red_total)\n 131:     n_unchained = random.randint(min_unchained, max_unchained)\n 132: \n 133:     distributions = _chain_red_distributions(n_blue, red_total - n_unchained)\n 134:     if not distributions:\n 135:         return None\n 136: \n 137:     groups = [\n 138:         {\"kind\": \"chain\", \"colors\": [MARKER_COLOR] + [BODY_COLOR] * n_red}\n 139:         for n_red in random.choice(distributions)\n 140:     ]\n 141:     groups.extend({\"kind\": \"unchained\", \"colors\": [BODY_COLOR]} for _ in range(n_unchained))\n 142:     random.shuffle(groups)\n 143:     if groups[0][\"kind\"] == \"unchained\":\n 144:         for i, group in enumerate(groups):\n 145:             if group[\"kind\"] == \"chain\":\n 146:                 groups[0], groups[i] = groups[i], groups[0]\n 147:                 break\n 148:     return rows, max_height, groups\n 149: \n 150: \n 151: def _sample_layout(max_height, groups):\n 152:     \"\"\"Sample gaps, heights, margins, and positioned bar columns.\"\"\"\n 153:     n_bars = sum(len(group[\"colors\"]) for group in groups)\n 154:     right_margin = random.randint(0, MAX_RIGHT_MARGIN)\n 155: \n 156:     gap_count = len(groups) - 1\n 157:     if gap_count:\n 158:         max_gap_sum = MAX_WIDTH - right_margin - MIN_BAR_HEIGHT * n_bars\n 159:         gap_options = _bounded_tuples(GAP_VALUES, gap_count, max_gap_sum)\n 160:         if not gap_options:\n 161:             return None\n 162:         gaps = list(random.choice(gap_options))\n 163:     else:\n 164:         gaps = []\n 165: \n 166:     height_options = _bounded_tuples(\n 167:         tuple(range(MIN_BAR_HEIGHT, max_height + 1)),\n 168:         n_bars,\n 169:         MAX_WIDTH - right_margin - sum(gaps),\n 170:     )\n 171:     if not height_options:\n 172:         return None\n 173:     heights = list(random.choice(height_options))\n 174: \n 175:     idx = 0\n 176:     for group in groups:\n 177:         count = len(group[\"colors\"])\n 178:         group[\"heights\"] = heights[idx : idx + count]\n 179:         idx += count\n 180: \n\n 243: \n 244: def _gen_attempt():\n 245:     sampled = _sample_groups()\n 246:     if sampled is None:\n 247:         return None\n 248:     rows, max_height, groups = sampled\n 249: \n 250:     layout = _sample_layout(max_height, groups)\n 251:     if layout is None:\n 252:         return None\n 253:     bars, width = layout\n 254: \n 255:     inp, expected = _render_pair(rows, width, bars)\n 256:     if not _passes_oracle(inp, expected):\n 257:         return None\n 258:     return inp\n 259: \n 260: \n 261: def generate_input():\n 262:     for _ in range(MAX_GENERATION_ATTEMPTS):\n 263:         grid = _gen_attempt()\n 264:         if grid is not None:\n 265:             return grid\n 266:     raise RuntimeError(\"failed to generate a valid 84551f4c input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py =====\n 256: \n 257:         # Prefer an adjacent color that exists in the mapping; pick the most frequent border.\n 258:         border = None\n 259:         best = -1\n 260:         for col, cnt in adj_counts.items():\n 261:             if col not in mapping:\n 262:                 continue\n 263:             if cnt > best:\n 264:                 best = cnt\n 265:                 border = col\n 266:         if border is None:\n 267:             continue\n 268: \n 269:         fill = int(mapping[border])\n 270:         for r, c in pts:\n 271:             out[r, c] = fill\n 272: \n 273: \n 274: def main(grid: np.ndarray) -> np.ndarray:\n 275:     \"\"\"\n 276:     Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n 277: \n 278:     Input structure:\n 279:     - bg = most common color. Several hollow sprites with distinct border colors.\n 280:     - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n 281: \n 282:     Rule:\n 283:     - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n 284:     - Find enclosed bg regions (holes)