ity background (more stable than global mode here).\n  28:     bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n  29: \n  30:     # Detect solid square components (excluding bg).\n  31:     squares: list[dict] = []\n  32:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n  33:         col = int(comp[\"color\"])\n  34:         b = comp[\"bbox\"]\n  35:         if bbox_h(b) != bbox_w(b):\n  36:             continue\n  37:         patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n  38:         if not bool((patch == int(col)).all()):\n  39:             continue\n  40:         squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n  41: \n  42:     assert not (len(squares) < 2)\n  43: \n  44:     # Choose the size that appears at least twice (most common size).\n  45:     by_n: dict[int, list[dict]] = defaultdict(list)\n  46:     for s in squares:\n  47:         by_n[int(s[\"n\"])].append(s)\n  48:     nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n  49:     cand = by_n[int(nside)]\n  50:     assert not (len(cand) < 2)\n  51: \n  52:     cand.sort(key=lambda s: int(s[\"col\"]))\n  53:     mover = cand[0]\n  54:     dest = cand[1]\n  55: \n  56:     n = int(mover[\"n\"])\n  57:     sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n  58:     dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n  59: \n  60:     # River = most common remaining color (excluding bg and the two square colors).\n  61:     counts = Counter(map(int, g.flatten()))\n  62:     river = None\n  63:     for col, _ct in counts.most_common():\n  64:         if int(col) == int(bg):\n  65:             continue\n  66:         if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n  67:             continue\n  68:         river = int(col)\n  69:         break\n  70:     assert not (river is None)\n  71: \n  72:     trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n  73: \n  74:     # Feasible top-left placements: NxN window fully inside trav.\n  75:     h2 = int(H - n + 1)\n  76:     w2 = int(W - n + 1)\n  77:     assert not (h2 <= 0 or w2 <= 0)\n  78:     assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n  79: \n  80:     feasible = np.zeros((h2, w2), dtype=bool)\n  81:     for r in range(h2):\n  82:         for c in range(w2):\n  83:             if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n  84:                 feasible[int(r), int(c)] = True\n  85:     assert not (not bool(feasible[int(sr), int(sc)]))\n  86: \n  87:     # BFS on placement grid.\n  88:     dist = -np.ones((h2, w2), dtype=int)\n  89:     q = deque([(int(sr), int(sc))])\n  90:     dist[int(sr), int(sc)] = 0\n  91:     DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n  92:     while q:\n  93:         r, c = q.popleft()\n  94:         for dr2, dc2 in DIR4:\n  95:             rr = int(r + dr2)\n  96:             cc = int(c + dc2)\n  97:             if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n  98:                 dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n  99:                 q.append((int(rr), int(cc)))\n 100: \n 101:     # Pick target.\n 102:     if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n 103:         tr, tc = int(dr), int(dc)\n 104:     else:\n 105:         best = -1\n 106:         tr, tc = int(sr), int(sc)\n 107:         for r in range(h2):\n 108:             for c in range(w2):\n 109:                 if int(dist[int(r), int(c)]) > best:\n 110:                     best = int(dist[int(r), int(c)])\n 111:                     tr, tc = int(r), int(c)\n 112: \n 113:     out = g.copy()\n 114:     out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n 115:     out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n 116:     return out\n 117: \