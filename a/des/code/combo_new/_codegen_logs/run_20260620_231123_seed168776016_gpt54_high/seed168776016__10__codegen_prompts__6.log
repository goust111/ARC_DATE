ted 9-clusters not adjacent to any 8. Trains = components containing 8.\n  36:     - Match train to station group where |couplers| == |station size|.\n  37:     - Rotate/flip train so marker pixels face the same-color boundary stripe of the target region.\n  38:     - Translate so couplers align exactly onto station cells; erase original position.\n  39: \n  40:     Key insight: Coupler count selects the docking target; marker color encodes which boundary stripe to face, fixing the unique orientation.\n  41:     \"\"\"\n  42:     inp = grid\n  43:     grid = inp.copy()\n  44:     H, W = grid.shape\n  45:     bg = get_bg(grid)\n  46: \n  47:     # This puzzle's code is long because it reconstructs several \"structures\"\n  48:     # that are implicit in the grid:\n  49:     # - divider stripes (edge + internal) that partition the canvas into regions\n  50:     # - station groups = 9-clusters not adjacent to any 8\n  51:     # - train sprites = components containing 8 (with attached 9 \"couplers\")\n  52:     # Then, for each train:\n  53:     # - match target region by COUPLER COUNT (|couplers| == |station group|)\n  54:     # - choose orientation by divider-color markers (face region boundary stripes)\n  55:     # - translate so couplers land exactly onto the station group cells\n  56: \n  57:     def find_edge_stripes():\n  58:         # Detect thick constant-color border stripes.\n  59:         stripe = np.zeros((H, W), dtype=bool)\n  60:         colors = set()\n  61:         # Top edge\n  62:         top_h = 0\n  63:         for r in range(H):\n  64:             row = grid[r, :]\n  65:             if (row == row[0]).all() and row[0] != bg:\n  66:                 top_h += 1\n  67:             else:\n  68:                 break\n  69:         if top_h:\n  70:             stripe[:top_h, :] = True\n  71:             colors.add(int(grid[0, 0]))\n  72:         # Bottom edge\n  73:         bot_h = 0\n  74:         for r in range(H - 1, -1, -1):\n  75:             row = grid[r, :]\n  76:             if (row == row[0]).all() and row[0] != bg:\n  77:                 bot_h += 1\n  78:             else:\n  79:                 break\n  80:         if bot_h:\n  81:             stripe[H - bot_h :, :] = True\n  82:             colors.add(int(grid[H - 1, 0]))\n  83:         inner_r0, inner_r1 = top_h, H - bot_h\n  84:         # Left edge (in inner rows)\n  85:         left_w = 0\n  86:         for c in range(W):\n  87:             col = grid[inner_r0:inner_r1, c]\n  88:             if col.size == 0:\n  89:                 break\n  90:             if (col == col[0]).all() and col[0] != bg:\n  91:                 left_w += 1\n  92:             else:\n  93:                 break\n  94:         if left_w:\n  95:             stripe[inner_r0:inner_r1, :left_w] = True\n  96:             colors.add(int(grid[inner_r0, 0]))\n  97:         # Right edge\n  98:         right_w = 0\n  99:         for c in range(W - 1, -1, -1):\n 100:             col = grid[inner_r0:inner_r1, c]\n 101:             if col.size == 0:\n 102:                 break\n 103:             if (col == col[0]).all() and col[0] != bg:\n 104:                 right_w += 1\n 105:             else:\n 106:                 break\n 107:         if right_w:\n 108:             stripe[inner_r0:inner_r1, W - right_w :] = True\n 109:             colors.add(int(grid[inner_r0, W - 1]))\n 110:         return stripe, colors, (top_h, bot_h, left_w, right_w)\n 111: \n 112:     def find_internal_stripes(edge_info):\n 113:         # Detect internal constant-color stripes in the inner rectangle.\n 114:         top_h, bot_h, left_w, right_w = edge_info\n 115:         r0, r1, c0, c1 = top_h, H - bot_h, left_w, W - right_w\n 116:         stripe = np.zeros((H, W), dtype=bool)\n 117:         colors = set()\n 118:         # Vertical internal stripes\n 119:         c = c0\n 120:         while c < c1:\n 121:             col = grid[r0:r1, c]\n 122:             if col.size and (col == col[0]).all() and col[0] != bg: