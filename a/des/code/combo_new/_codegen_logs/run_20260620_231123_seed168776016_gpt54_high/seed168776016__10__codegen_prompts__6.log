le:\n  60:     - Crop to the mask object's bbox.\n  61:     - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n  62:     - Replace background holes inside the crop with the palette's uniform third-row color.\n  63: \n  64:     Key insight:\n  65:     The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n  66:     \"\"\"\n  67:     g = np.asarray(grid, dtype=int)\n  68:     bg = get_bg(g)\n  69:     mask_color = _unique_largest_non_bg_color(g, bg)\n  70: \n  71:     b = _mask_bbox(g, mask_color)\n  72:     mask_crop = crop_bbox(g == int(mask_color), b)\n  73:     height, width = map(int, mask_crop.shape)\n  74: \n  75:     column_colors, hole_color = _palette(g, bg, mask_color, width)\n  76:     out = np.tile(column_colors, (height, 1))\n  77:     out[~mask_crop] = hole_color\n  78:     return out\n  79: \n  80: # --------------- generator (o5x) ---------------\n  81: \n  82: # Canvas, colors, and object bounds.\n  83: BACKGROUND_COLOR, MASK_COLOR = 0, 5\n  84: COLOR_MIN, COLOR_MAX = 1, 9\n  85: GRID_SIDE_MIN, GRID_SIDE_MAX = 10, 18\n  86: MASK_SIDE_MIN, MASK_SIDE_MAX = 5, 10\n  87: PALETTE_HEIGHT = 3\n  88: GAP_MIN, GAP_MAX = 1, 3\n  89: \n  90: # Palette run construction.\n  91: RUN_COUNT_OPTIONS = (4, 5)\n  92: RUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3\n  93: COLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5\n  94: UNUSED_COLOR_BIAS = 0.7\n  95: \n  96: # Mask density and retry budget.\n  97: MASK_DENSITY_MIN, MASK_DENSITY_MAX = 0.60, 0.71\n  98: GENERATION_ATTEMPTS = 300\n  99: \n 100: \n 101: def _valid_run_lengths(width: int, n_runs: int) -> list[tuple[int, ...]]:\n 102:     length_range = range(RUN_LENGTH_MIN, RUN_LENGTH_MAX + 1)\n 103:     return [\n 104:         tuple(int(x) for x in lengths)\n 105:         for lengths in product(length_range, repeat=int(n_runs))\n 106:         if sum(lengths) == int(width)\n 107:     ]\n 108: \n 109: \n 110: def _run_colors(colors: list[int], n_runs: int) -> list[int]:\n 111:     seq: list[int] = []\n 112:     unused = set(colors)\n 113:     for i in range(int(n_runs)):\n 114:         slots_left = int(n_runs) - i\n 115:         choices = [c for c in colors if not seq or c != seq[-1]]\n 116:         if len(unused) >= slots_left:\n 117:             choices = [c for c in choices if c in unused]\n 118:         elif unused and random.random() < UNUSED_COLOR_BIAS:\n 119:             preferred = [c for c in choices if c in unused]\n 120:             if preferred:\n 121:                 choices = preferred\n 122:         color = random.choice(choices)\n 123:         seq.append(int(color))\n 124:         unused.discard(int(color))\n 125:     return seq\n 126: \n 127: \n 128: def _palette_row(width: int, colors: list[int]) -> np.ndarray:\n 129:     valid_counts = [\n 130:         n_runs for n_runs in RUN_COUNT_OPTIONS if _valid_run_lengths(int(width), n_runs)\n 131:     ]\n 132:     n_runs = random.choice(valid_counts)\n 133:     valid_lengths = _valid_run_lengths(int(width), n_runs)\n 134:     lengths = random.choice(valid_lengths)\n 135:     n_distinct = random.randint(\n 136:         COLUMN_COLOR_DISTINCT_MIN, min(COLUMN_COLOR_DISTINCT_MAX, n_runs)\n 137:     )\n 138:     chosen = random.sample(colors, n_distinct)\n 139:     seq = _run_colors(chosen, n_runs)\n 140:     return np.repeat(seq, lengths).astype(int)\n 141: \n 142: \n 143: def _neighbors4(r: int, c: int, h: int, w: int):\n 144:     if r > 0:\n 145:         yield r - 1, c\n 146:     if r + 1 < h:\n 147:         yield r + 1, c\n 148:     if c > 0:\n 149:         yield r, c - 1\n 150:     if c + 1 < w:\n 151:         yield r, c + 1\n 152: \n 153: \n 154: def _connected_mask(height: int, width: int, target_area: int) -> np.ndarray | None:\n 155:     \"\"\"Grow a connected mask with full row/column span to the target area.\"\"\"\n 156:     mask = np.zeros((int(height), int(width)), dtype=bool)\n 157:     steps = [\"D\"] * (int(height) - 1) + [\"R\"] * (int(width) - 1)\n 158:     random.shuffle(steps)\n 159: \n 160:     r = c = 0\n 161:     mask[r, c] = True\n 162:     for step in steps:\n 163:         if step == \"D\":\n 164:             r += 1\n 165:         else:\n 166:             c += 1\n 167:         mask[r, c] = True\n 168: \n 169:     if int(mask.sum()) > int(target_area):\n 170:         return None\n 171: \n 172:     frontier: set[tuple[int, int]] = set()\n 173: \n 174:     def add_frontier(rr: int, cc: int) -> None:\n 175:         for nr, nc in _neighbors4(rr, cc, int(height), int(width)):\n 176:             if not mask[nr, nc]:\n 177:                 frontier.add((int(nr), int(nc)))\n 178: \n 179:     for rr, cc in np.argwhere(mask):\n 180:         add_frontier(int(rr), int(cc))\n 181: \n 182:     while int(mask.sum()) < int(target_area):\n 183:         if not frontier:\n 184:             return None\n 185:         cell = random.choice(tuple(frontier))\n 186:         frontier.remove(cell)\n 187:         rr, cc = cell\n 188:         mask[rr, cc] = True\n 189:         add_frontier(rr, cc)\n\n 257:     column_colors, hole_color = _sample_palette(mask_w)\n 258:     area = int(mask_h) * int(mask_w)\n 259:     min_area = int(np.ceil(MASK_DENSITY_MIN * area))\n 260:     max_area = int(np.floor(MASK_DENSITY_MAX * area))\n 261:     target_area = random.randint(min_area, max_area)\n 262:     mask = _connected_mask(mask_h, mask_w, target_area)\n 263:     if mask is None:\n 264:         return None\n 265: \n 266:     output = np.tile(column_colors, (int(mask_h), 1))\n 267:     output[~mask] = int(hole_color)\n 268:     mask = output != int(hole_color)\n 269:     grid = _compose_grid(grid_h, grid_w, gap, mask, column_colors, hole_color)\n 270:     if np.array_equal(main(grid), output):\n 271:         return grid\n 272:     return None\n 273: \n 274: \n 275: def generate_input() -> np.ndarray:\n 276:     for _ in range(GENERATION_ATTEMPTS):\n 277:         grid = _gen_a