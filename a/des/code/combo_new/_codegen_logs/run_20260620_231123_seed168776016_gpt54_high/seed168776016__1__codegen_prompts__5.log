e's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n 288:     \"\"\"\n 289:     g = np.asarray(grid, dtype=int)\n 290:     bg = _bg_boundary(g)\n 291: \n 292:     mapping, pal_mask = _palette_mapping(g, bg)\n 293:     assert mapping, \"main: palette mapping must be non-empty\"\n 294: \n 295:     out = g.copy()\n 296:     _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n 297: \n 298:     return out\n 299: \n 300: # --------------- generator (c) ---------------\n 301: \n 302: # -- Configuration constants --------------------------------------------------\n 303: # Grid dimensions\n 304: _GRID_H_MIN, _GRID_H_MAX = 4, 13\n 305: _GRID_W_MIN, _GRID_W_MAX = 10, 15\n 306: _SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n 307: _SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n 308: _TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n 309: \n 310: # Palette\n 311: _PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n 312: \n 313: # Sprite geometry\n 314: _SPRITE_H_MAX = 7\n 315: _SPRITE_W_MAX = 6\n 316: _SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n 317: _SPRITE_CELL_MAX = 16\n 318: _FILLED_SPRITE_MAX = 3\n 319: \n 320: # Sprite mutation probabilities\n 321: _P_HORIZ_WALL = 0.3           # add horizontal internal wall\n 322: _P_VERT_WALL = 0.3            # add vertical internal wall\n 323: _P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n 324: _P_DIAMOND = 0.2              # use diamond shape for 3x3\n 325: \n 326: # Generation\n 327: _MAX_RETRIES = 300\n 328: # -- End configuration --------------------------------------------------------\n 329: \n 330: \n 331: def _get_enclosed_holes(sprite):\n 332:     \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n 333:     h, w = sprite.shape\n 334:     return [pts for pts in components_mask(~sprite, connectivity=4)\n 335:             if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n 336: \n 337: \n 338: def _make_diamond():\n 339:     \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n 340:     s = np.zeros((3, 3), dtype=bool)\n 341:     s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n 342:     return s\n 343: \n 344: \n 345: def _make_hollow_sprite(h, w, rng):\n 346:     \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n 347:     sprite = np.ones((h, w), dtype=bool)\n 348:     if h >= 3 and w >= 3:\n 349:         sprite[1:-1, 1:-1] = False\n 350:     # Optionally add internal horizontal wall\n 351:     if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n 352:         br = rng.randint(2, h - 2)\n 353:         n = rng.randint(1, w - 2)\n 354:         s = rng.randint(1, w - 1 - n + 1)\n 355:         sprite[br, s:s + n] = True\n 356:     # Optionally add internal vertical wall\n 357:     if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n 358:         bc = rng.randint(2, w - 2)\n 359:         n = rng.randint(1, h - 2)\n 360:         s = rng.randint(1, h - 1 - n + 1)\n 361:         sprite[s:s + n, bc] = True\n 362:     # Optionally remove border cells for irregularity\n 363:     if rng.random() < _P_BORDER_REMOVAL:\n 364:         bcells = [(r, c) for r in range(h) for c in range(w)\n 365:                   if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n 366:         rng.shuffle(bcells)\n 367:         for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n 368:             test = sprite.copy()\n 369:             test[cr, cc] = False\n 370:             if _get_enclosed_holes(test):\n 371:                 sprite = test\n 372:     if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n 373:         return None\n 374:     return sprite\n 375: \n 376: \n 377: def _choose_colors(rng, N, num_filled):\n 378:     \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n 379:     all_c = list(range(1, 10))\n 380:     rng.shuffle(all_c)\n 381:     border_keys = all_c[:N]\n 382:     rng.shuffle(all_c)\n 383:     fill_values = all_c[:N]\n 384:     dist_cands = [c for c in range(1, 10) if c not in border_keys]\n 385:     distractor_color = rng.choice(dist_cands)\n 386:     mapping = dict(zip(border_keys, fill_values))\n 387:     filled_keys = rng.sample(border_keys, num_filled)\n 388:     return border_keys, fill_values, distractor_color, mapping, filled_keys\n 389: \n 390: \n 391: def _build_palette(side, border_keys, fill_values):\n 392:     \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n 393:     N = len(border_keys)\n\n 544: def generate_input():\n 545:     for _ in range(_MAX_RETRIES):\n 546:         r = _gen_attempt()\n 547:         if r is not None:\n 548:             return r\n 549:     raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/2601afb7.py =====\n  29: def main(grid: np.ndarray) -> np.ndarray:\n  30:     \"\"\"Rotate each vertical bar's color one slot right and its height one slot left.\n  31: \n  32:     Input structure\n  33:     - A dominant background surrounds several monochrome one-cell-wide vertical bars.\n  34:     - Every bar is bottom-aligned and occupies a distinct column.\n  35:     - The ordered bar slots are read from left to right.\n  36: \n  37:     Rule\n  38:     - Keep the grid shape and the bar columns unchanged.\n  39:     - At slot i, use the color from the previous slot cyclically.\n  40:     - At slot i, use the height from the next slot cyclically.\n  41: \n  42:     Key insight\n  43:     - Color and height are independent cyclic attributes of the ordered bar slots:\n  44:       colors rotate right while heights rotate left.\n  45:     \"\"\"\n  46:     g = np.asarray(grid, dtype=int)\n  47:     height = g.shape[0]\n  48:     bg = get_bg(g)\n  49:     bars = _extract_bars(g, bg)\n  50: \n  51:     out = np.full_like(g, bg)\n  52:     count = len(bars)\n  53:     for i, bar in enumerate(bars):\n  54:         color = bars[(i - 1) % count][\"color\"]\n  55:         bar_height = bars[(i + 1) % count][\"height\"]\n  56:         assert 1 <= bar_height <= height\n  57:         out[height - bar_height : height, bar[\"col\"]] = color\n  58: \n  59:     return out\n  60: \n  61: # --------------- generator (o5x) ---------------\n  62: \n  63: _RNG = np.random.default_rng()\n  64: \n  65: # Canvas/bar bounds.\n  66: BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE = 3, 6\n  67: BACKGROUND_COLOR, MIN_BAR_HEIGHT = 7, 1\n  68: BAR_COL_OFFSET, BAR_COL_STRIDE = 1, 2\n  69: # Color and transform sampling.\n  70: COLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n  71: OUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1\n  72: # Retry limit.\n  73: MAX_GENERATION_ATTEMPTS = 300\n  74: \n  75: \n  76: def _render_bars(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n  77:     side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n  78:     grid = np.full((side, side), BACKGROUND_COLOR, dtype=int)\n  79:     for i, (color, bar_height) in enumerate(zip(colors, heights)):\n  80:         col = BAR_COL_STRIDE * i + BAR_COL_OFFSET\n  81:         grid[side - int(bar_height) : side, col] = int(color)\n  82:     return grid\n  83: \n  84: \n  85: def _expected_output(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n  86:     out_colors = np.roll(colors, OUTPUT_COLOR_SHIFT)\n  87:     out_heights = np.roll(heights, OUTPUT_HEIGHT_SHIFT)\n  88:     return _render_bars(n, out_colors, out_heights)\n  89: \n  90: \n  91: def _gen_attempt() -> np.ndarray | None:\n  92:     n = int(_RNG.integers(BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE))\n  93:     side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n  94:     colors = _RNG.choice(COLOR_POOL, size=n, replace=False)\n  95:     heights = _RNG.integers(MIN_BAR_HEIGHT, side, size=n)\n  96:     if len(set(map(int, heights))) == 1:\n  97:         idx = int(_RNG.integers(n))\n  98:         choices = [h for h in range(MIN_BAR_HEIGHT, side) if h != int(heights[idx])]\n  99:         heights[idx] = int(_RNG.choice(choices))\n 100: \n 101:     grid = _render_bars(n, colors, heights)\n 102:     if np.array_equal(main(grid), _expected_output(n, colors, heights)):\n 103:         return grid\n 104:     return None\n 105: \n 106: \n 107: def generate_input() -> np.ndarray:\n 108:     for _ in range(MAX_GENERATION_ATTEMPTS):\n 109:         grid = _gen_attempt()\n 110:         if grid is not None:\n 111:             return grid\n 112:     raise RuntimeError(\"failed to generate valid input\")\n\n 107: def generate_input() -> np.ndarray:\n 108:     for _ in range(MAX_GENERATION_ATTEMPTS):\n 109:         grid = _gen_attempt()\n 110:         if grid is not None:\n 111:             return grid\n 112:     raise RuntimeError(\"failed to generate valid input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py =====\n 261: def main(grid: np.ndarray) -> np.ndarray:\n 262:     \"\"\"\n 263:     Assemble and place enlarged sprites on a canvas using legend-panel instructions.\n 264: \n 265:     Input structure:\n 266:     - Color-6 separators divide the grid into a left legend column and a main canvas.\n 267:     - Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.\n 268: \n 269:     Rule:\n 270:     - Tile the unit sprite into each active cell of the frame to build an enlarged composite.\n 271:     - Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).\n 272:     - Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.\n 273: \n 274:     Key insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).\n 275:     \"\"\"\n 276:     g = np.asarray(grid, dtype=int)\n 277:     h, w = g.shape\n 278:     assert w >= 2, \"grid width must be >= 2\"\n 279: \n 280:     # Output canvas is the region between the left separator run and (optionally) a\n 281:     # right-side separator run near the far edge (right legend panel).\n 282:     left_sep, right_sep = _split_canvas(g)\n 283:     left_sep_c1 = left_sep[1]\n 284:     canvas_c0 = left_sep_c1 + 1\n 285:     canvas_c1 = right_sep[0] if right_sep is not None else w\n 286:     main = g[:, canvas_c0:canvas_c1].copy()\n 287: \n 288:     # Paint one constructed sprite per marker panel that lies outside the output canvas.\n 289:     marker_squares = _all_marker_panel_squares(g)\n 290:     assert marker_squares, \"no marker panel found\"\n 291: \n 292:     # Anchor alignment (ignore internal full-height/full-width 6 separators inside main).\n 293:     eff_h, eff_w = main.shape\n 294:     full6_cols = [c for c in range(eff_w) if np.all(main[:, c] == 6)]\n 295:     if full6_cols:\n 296:         eff_w = min(full6_cols)\n 297:     full6_rows = [r for r in range(eff_h) if np.all(main[r, :] == 6)]\n 298:     if full6_rows:\n 299:         eff_h = min(full6_rows)\n 300: \n 301:     out = main.copy()\n 302:     composite_written = np.zeros(out.shape, dtype=bool)\n 303: \n 304:     for marker_r0, marker_c0 in marker_squares:\n 305:         # Ignore marker panels inside the output canvas; only legends should drive drawing.\n 306:         if canvas_c0 <= marker_c0 < canvas_c1:\n 307:             continue\n 308: \n 309:         if marker_c0 + 5 > w:\n 310:             continue\n 311:         panel = g[:, marker_c0 : marker_c0 + 5]\n 312: \n 313:         unit = _extract_unit_sprite(panel)\n 314:         if unit is None:\n 315:             continue\n 316:         unit_sprite, unit_bb = unit\n 317: \n 318:         frame_bb = _extract_frame_bbox(panel, unit_bb, marker_r0)\n 319:         if frame_bb is None:\n 320:             continue\n 321:         fr0, fc0, fr1, fc1 = frame_bb\n 322:         frame = panel[fr0 : fr1 + 1, fc0 : fc1 + 1]\n 323:         frame_mask0 = (frame != 0) & (frame != 6)\n 324:         _, n8 = _scipy_label(frame_mask0, structure=np.ones((3, 3)))\n 325:         assert n8 == 1, f\"frame must be 8-connected, got {n8} components\"\n 326: \n 327:         # Rotate layout according to clockhand.\n 328:         dir_k = _rotation_from_clockhand(g, marker_r0, marker_c0)  # up=0, right=1, down=2, left=3\n 329:         frame_mask = np.rot90(frame_mask0, (-dir_k) % 4)\n 330: \n 331:         # Build composite by tiling the unit sprite into active frame cells.\n 332:         m_unit = (unit_sprite != 0) & (unit_sprite != 6)\n 333:         uh, uw = unit_sprite.shape\n 334:         fh, fw = frame_mask.shape\n 335:         comp = np.zeros((fh * uh, fw * uw), dtype=int)\n 336:         for i in range(fh):\n 337:             for j in range(fw):\n 338:                 if not frame_mask[i, j]:\n 339:                     continue\n 340:                 rr0 = i * uh\n 341:                 cc0 = j * uw\n 342:                 comp[rr0 : rr0 + uh, cc0 : cc0 + uw][m_unit] = unit_sprite[m_unit]\n 343: \n 344:         pos = _position_indices_from_border_square(g, marker_r0, marker_c0)\n 345:         if pos is None:\n 346:             continue\n 347:         pr, pc = pos\n 348: \n 349:         top = _anchor_to_top_left(pr, eff_h, comp.shape[0])\n 350:         left = _anchor_to_top_left(pc, eff_w, comp.shape[1])\n 351: \n 352:         ch, cw = comp.shape\n 353:         for r in range(ch):\n 354:             rr = top + r\n 355:             assert 0 <= rr < out.shape[0], \"sprite row out of canvas bounds\"\n 356:             for c in range(cw):\n 357:                 cc = left + c\n 358:                 assert 0 <= cc < out.shape[1], \"sprite col out of canvas bounds\"\n 359:                 if out[rr, cc] == 6:\n 360:                     continue\n 361:                 val = int(comp[r, c])\n 362:                 if val != 0 and val != 6:\n 363:                     assert not composite_written[rr, cc], \"composites must not overlap\"\n 364:                     composite_written[rr, cc] = True\n 365:                     out[rr, cc] = val\n 366:     return out\n 367: \n 368: # --------------- generator (refine_8conn_fill_overlap) ---------------\n 369: \n 370: # ── CFG: tunable generation parameters ──────────────────────────────\n 371: GRID_H_RANGE = (20, 30)         # output grid height\n 372: GRID_W = 30                     # output grid width (fixed)\n 373: LEGEND_COUNT_WEIGHTS = [1, 4]   # weights for [1-legend, 2-legend]\n 374: UNIT_SIZE_RANGE = (2, 5)        # NxN unit sprite side length\n 375: MIN_CANVAS_W = 8                # reject if canvas narrower than this\n 376: FRAME_H_RANGE = (4, 9)          # frame mask height (before rotation)\n 377: FRAME_W_RANGE = (3, 6)          # frame mask width  (before rotation)\n 378: FRAME_DENSITY = 0.5             # density for random_sprite frame generation\n 379: BAND_WIDTH_MIN = 4              # minimum band width for canvas background\n 380: MARKER_PANEL_HEIGHT = 8         # marker square (5) + rotation patch (3)\n\n 650: def generate_input() -> np.ndarray:\n 651:     for _ in range(GEN_RETRIES):\n 652:         result = _gen_attempt()\n 653:         if result is not None:\n 654:             return result\n 655:     raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/412b6263.py =====\n  38: def main(grid: np.ndarray) -> np.ndarray:\n  39:     \"\"\"\n  40:     Infer the background, rotate the whole input 90 degrees counterclockwise, and stack two framed copies vertically.\n  41: \n  42:     Input structure:\n  43:     - Blue is absent from the input.\n  44:     - One rare marker color appears in exactly two pixels.\n  45:     - The background is the unique non-marker color whose removal leaves exactly two 4-connected foreground objects, each with one marker pixel and