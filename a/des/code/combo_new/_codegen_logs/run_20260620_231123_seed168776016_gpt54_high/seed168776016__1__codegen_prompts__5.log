n  96:         (r, c)\n  97:         for r in range(h)\n  98:         for c in range(w)\n  99:         if r in (0, h - 1) or c in (0, w - 1)\n 100:     ]\n 101: \n 102: def _expected_output(inp: np.ndarray, bg: int) -> np.ndarray:\n 103:     tile = np.rot90(inp, 1)\n 104:     tile_h, tile_w = tile.shape\n 105:     out_h = OUTPUT_TILE_COPIES * tile_h + (OUTPUT_TILE_COPIES + 1) * FRAME_THICKNESS\n 106:     out_w = tile_w + 2 * FRAME_THICKNESS\n 107:     out = np.full((out_h, out_w), FRAME_COLOR, dtype=int)\n 108:     out[0, 0] = out[0, -1] = bg\n 109:     out[tile_h + FRAME_THICKNESS, 0] = out[tile_h + FRAME_THICKNESS, -1] = bg\n 110:     out[-1, 0] = out[-1, -1] = bg\n 111:     out[FRAME_THICKNESS : FRAME_THICKNESS + tile_h, FRAME_THICKNESS : FRAME_THICKNESS + tile_w] = tile\n 112:     second_top = tile_h + 2 * FRAME_THICKNESS\n 113:     out[second_top : second_top + tile_h, FRAME_THICKNESS : FRAME_THICKNESS + tile_w] = tile\n 114:     return out\n 115: \n 116: def _sample_object_dims(canvas_h: int, canvas_w: int) -> tuple[int, int] | None:\n 117:     feasible_dims = [\n 118:         (oh, ow)\n 119:         for oh in range(*OBJECT_SHAPE_RANGES[0])\n 120:         for ow in range(*OBJECT_SHAPE_RANGES[1])\n 121:         if oh <= canvas_h and ow <= canvas_w and (\n 122:             canvas_h - 2 * oh >= MIN_SEPARATION_GAP\n 123:             or canvas_w - 2 * ow >= MIN_SEPARATION_GAP\n 124:         )\n 125:     ]\n 126:     if not feasible_dims:\n 127:         return None\n 128:     return feasible_dims[int(np.random.randint(len(feasible_dims)))]\n 129: \n 130: \n 131: def _gen_attempt() -> np.ndarray | None:\n 132:     H = int(np.random.randint(*CANVAS_SHAPE_RANGES[0]))\n 133:     W = int(np.random.randint(*CANVAS_SHAPE_RANGES[1]))\n 134: \n 135:     dims = _sample_object_dims(H, W)\n 136:     if dims is None:\n 137:         return None\n 138:     oh, ow = dims\n 139: \n 140:     bg, body, marker = map(int, np.random.choice(INPUT_COLORS, size=PALETTE_SIZE, replace=False))\n 141:     inp = np.full((H, W), bg, dtype=int)\n 142:     inp[:oh, :ow] = body\n 143:     inp[H - oh : H, W - ow : W] = body\n 144:     mr, mc = _edge_cells(oh, ow)[int(np.random.randint(2 * oh + 2 * ow - 4))]\n 145:     inp[mr, mc] = marker\n 146:     inp[H - oh + mr, W - ow + mc] = marker\n 147: \n 148:     expected = _expected_output(inp, bg)\n 149:     if expected.shape[0] > MAX_OUTPUT_SIZE or expected.shape[1] > MAX_OUTPUT_SIZE:\n 150:         return None\n 151: \n 152:     try:\n 153:         actual = main(inp)\n 154:     except AssertionError:\n 155:         return None\n 156:     if not np.array_equal(actual, expected):\n 157:         return None\n\n 161: def generate_input() -> np.ndarray:\n 162:     for _ in range(MAX_GENERATION_ATTEMPTS):\n 163:         inp = _gen_attempt()\n 164:         if inp is not None:\n 165:             return inp\n 166:     raise RuntimeError(\"failed to generate valid input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/465b7d93.py =====\n  96: def main(grid: np.ndarray) -> np.ndarray:\n  97:     \"\"\"\n  98:     Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.\n  99: \n 100:     Input structure:\n 101:     - The background is the dominant color.\n 102:     - There are exactly two foreground colors: one forms a complete rectangular\n 103:       one-pixel-thick frame, and the other forms one 4-connected sprite outside it.\n 104:     - The frame interior is initially background.\n 105: \n 106:     Rule:\n 107:     - Clear the original sprite from its outside location.\n 108:     - Map the sprite bbox to the frame interior bbox, sending bbox extremes to\n 109:       interior extremes.\n 110:     - Draw straight horizontal or vertical segments between mapped positions of\n 111:       adjacent sprite pixels, then fill any enclosed background region inside\n 112:       those drawn segments.\n 113: \n 114:     Key insight:\n 115:     The outside sprite is a miniature line/fill diagram for the frame interior,\n 116:     not a bitmap to scale by block replication.\n 117:     \"\"\"\n 118:     g = np.asarray(grid, dtype=int)\n 119:     bg = get_bg(g)\n 120:     colors = colors_present(g, exclude={bg})\n 121:     assert len(colors) == 2, \"expected one frame color and one sprite color\"\n 122: \n 123:     frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []\n 124:     for color in colors:\n 125:         frame_bbox = _rect_frame_bbox(g == int(color))\n 126:         if frame_bbox is not None:\n 127:             frame_candidates.append((int(color), frame_bbox))\n 128:     assert len(frame_candidates) == 1, \"expected a unique rectangular frame\"\n 129: \n 130:     frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]\n 131:     sprite_color = next(color for color in colors if color != frame_color)\n 132:     sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)\n 133:     assert len(sprite_components) == 1, \"expected a single 4-connected sprite\"\n 134:     frame_region = np.zeros_like(g, dtype=bool)\n 135:     frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True\n 136:     assert not np.any((g == sprite_color) & frame_region), \"sprite must start outside the frame\"\n 137: \n 138:     sr0, sc0, sr1, sc1 = sprite_components[0][\"bbox\"]\n 139:     sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color\n 140: \n 141:     ir0, ic0 = fr0 + 1, fc0 + 1\n 142:     ir1, ic1 = fr1 - 1, fc1 - 1\n 143:     assert ir0 <= ir1 and ic0 <= ic1, \"frame must have an interior\"\n 144:     interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]\n 145:     assert np.all(interior == bg), \"frame interior must start empty\"\n 146: \n 147:     stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))\n 148:     out = g.copy()\n 149:     out[g == sprite_color] = bg\n 150:     out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color\n 151:     return out\n 152: \n 153: # --------------- generator (att2, o5x) ---------------\n 154: \n 155: # Canvas and observed fixed colors.\n 156: _GRID_SHAPE = (10, 10)\n 157: _COLOR_COUNT = 10\n 158: _BG = 7\n 159: _FRAME_COLOR = 6\n 160: \n 161: # Frame size bounds and retry budget.\n 162: _FRAME_SIZE_MIN = 3\n 163: _FRAME_SIZE_MAX = 8\n 164: _SINGLE_PIXEL_FRAME_SIZE = 3\n 165: _MAX_GENERATION_ATTEMPTS = 300\n 166: \n 167: # Sprite color pool and source masks.\n 168: _SPRITE_COLORS = tuple(c for c in range(_COLOR_COUNT) if c not in {_BG, _FRAME_COLOR})\n 169: _SPRITE_SINGLE = np.ones((1, 1), dtype=bool)\n 170: _SPRITE_PATTERNS_2X2 = [\n 171:     np.array([[1, 1], [1, 0]], dtype=bool),\n 172:     np.array([[1, 1], [0, 1]], dtype=bool),\n 173:     np.array([[1, 0], [1, 1]], dtype=bool),\n 174:     np.array([[0, 1], [1, 1]], dtype=bool),\n 175:     np.array([[1, 1], [1, 1]], dtype=bool),\n 176: ]\n 177: \n 178: def _outside_locations(\n 179:     frame_bbox: tuple[int, int, int, int], patch_shape: tuple[int, int]\n 180: ) -> list[tuple[int, int]]:\n 181:     fr0, fc0, fr1, fc1 = frame_bbox\n 182:     ph, pw = patch_shape\n 183:     locations: list[tuple[int, int]] = []\n 184:     for r in range(_GRID_SHAPE[0] - ph + 1):\n 185:         for c in range(_GRID_SHAPE[1] - pw + 1):\n 186:             pr0, pc0, pr1, pc1 = r, c, r + ph - 1, c + pw - 1\n 187:             separated = pr1 < fr0 or pr0 > fr1 or pc1 < fc0 or pc0 > fc1\n 188:             if separated:\n 189:                 locations.append((r, c))\n 190:     return locations\n 191: \n 192: def _frame_positions(size: int, patch_shape: tuple[int, int]) -> list[tuple[int, int]]:\n 193:     positions: list[tuple[int, int]] = []\n 194:     for r in range(_GRID_SHAPE[0] - size + 1):\n 195:         for c in range(_GRID_SHAPE[1] - size + 1):\n 196:             frame_bbox = (r, c, r + size - 1, c + size - 1)\n 197:             if _outside_locations(frame_bbox, patch_shape):\n 198:                 positions.append((r, c))\n 199:     return positions\n 200: \n 201: def _draw_frame(grid: np.ndarray, r0: int, c0: int, size: int, color: int) -> None:\n 202:     r1, c1 = r0 + size - 1, c0 + size - 1\n 203:     grid[r0 : r1 + 1, c0] = color\n 204:     grid[r0 : r1 + 1, c1] = color\n 205:     grid[r0, c0 : c1 + 1] = color\n 206:     grid[r1, c0 : c1 + 1] = color\n 207: \n 208: def _sample_sprite(size: int) -> np.ndarray:\n 209:     return _SPRITE_SINGLE.copy() if size == _SINGLE_PIXEL_FRAME_SIZE else random.choice(_SPRITE_PATTERNS_2X2).copy()\n 210: \n 211: def _sample_case() -> tuple[int, int, np.ndarray]:\n 212:     sprite_color = random.choice(_SPRITE_COLORS)\n 213:     size = random.randint(_FRAME_SIZE_MIN, _FRAME_SIZE_MAX)\n 214:     return sprite_color, size, _sample_sprite(size)\n 215: \n\n 260: def generate_input() -> np.ndarray:\n 261:     for _ in range(_MAX_GENERATION_ATTEMPTS):\n 262:         grid = _gen_attempt()\n 263:         if grid is not None:\n 264:             return grid\n 265:     raise RuntimeError(\"failed to generate a valid 465b7d93 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/bc93ec48.py =====\n  47: def main(grid: np.ndarray) -> np.ndarray:\n  48:     \"\"\"\n  49:     Copy each foreground object anchored in a true grid corner clockwise into the next corner.\n  50: \n  51:     Input structure\n  52:     - The dominant color is the background.\n  53:     - Foreground objects are monochromatic 4-connected components.\n  54:     - Relevant objects are exactly those whose bounding box touches two adjacent borders at one grid corner.\n  55: \n  56:     Rule\n  57:     - Start from the input unchanged.\n  58:     - For each corner object, copy its pixel mask and color to the next corner clockwise: top-left to top-right, top-right to bottom-right, bottom-right to bottom-left, and bottom-left to top-left.\n  59:     - Preserve each object's orientation by aligning its bounding box to the destination corner; stamps may overwrite existing pixels at the destination, but source pixels are not cleared.\n  60: \n  61:     Key insight\n  62:     - Interior and side-only objects are distractors; only components actually anchored to a corner participate in the clockwise perimeter copy.\n  63:     \"\"\"\n  64:     g = np.asarray(grid, dtype=int)\n  65:     assert g.ndim == 2, \"expected a 2D grid\"\n  66:     height, width = map(int, g.shape)\n  67:     bg = get_bg(g)\n  68: \n  69:     by_corner: dict[Corner, dict] = {}\n  70:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n  71:         corner = _bbox_corner(comp[\"bbox\"], height, width)\n  72:         if corner is None:\n  73:             continue\n  74:         assert corner not in by_corner, \"expected at most one source object per corner\"\n  75:         by_corner[corner] = comp\n  76: \n  77:     assert by_corner, \"expected at least one corner-anchored object\"\n  78: \n  79:     out = g.copy()\n  80:     planned: dict[tuple[int, int], int] = {}\n  81:     for src_corner, comp in by_corner.items():\n  82:         r0, c0, r1, c1 = comp[\"bbox\"]\n  83:         obj_h = int(r1 - r0 + 1)\n  84:         obj_w = int(c1 - c0 + 1)\n  85:         dst_corner = _NEXT_CORNER[src_corner]\n  86:         dst_r0, dst_c0 = _corner_anchor(dst_corner, height, width, obj_h, obj_w)\n  87:         color = int(comp[\"color\"])\n  88: \n  89:         for r_raw, c_raw in comp[\"coords\"]:\n  90:             r = int(dst_r0 + int(r_raw) - r0)\n  91:             c = int(dst_c0 + int(c_raw) - c0)\n  92:             assert 0 <= r < height and 0 <= c < width, \"corner stamp must remain in bounds\"\n  93:             assert (r, c) not in planned, \"expected non-overlapping corner stamps\"\n  94:             planned[(r, c)] = color\n  95: \n  96:     for (r, c), color in planned.items():\n  97:         out[r, c] = color\n  98: \n  99:     return out\n 100: \n 101: # --------------- generator (att2) ---------------\n 102: \n 103: _GEN_BG = 7\n 104: _GEN_MIN_SIZE, _GEN_MAX_SIZE = 8, 16\n 105: _GEN_CORNERS = (\"TL\", \"TR\", \"BR\", \"BL\")\n 106: _GEN_NEXT = {\"TL\": \"TR\", \"TR\": \"BR\", \"BR\": \"BL\", \"BL\": \"TL\"}\n 107: _GEN_COLORS = (1, 2, 3, 4, 5, 6, 8, 9)\n 108: \n 109: _GEN_CORNER_COUNT_MIN, _GEN_CORNER_COUNT_MAX = 3, 4\n 110: _GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX = 1, 4\n 111: _GEN_CORNER_MIN_PIXELS, _GEN_CORNER_MAX_PIXELS = 2, 12\n 112: _GEN_CORNER_MIN_DENSITY = 0.62\n 113: _GEN_SMALL_FULL_AREA_MAX, _GEN_SMALL_FULL_PROB = 12, 0.45\n 114: _GEN_CORNER_DIMS = tuple(\n 115:     (h, w)\n 116:     for h in range(_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX + 1)\n 117:     for w in range(_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX + 1)\n 118:     if not (h == 1 and w == 1)\n 119: )\n 120: \n 121: _GEN_BLOB_PIXELS_MIN, _GEN_BLOB_PIXELS_MAX = 1, 5\n 122: _GEN_BLOB_H_MIN, _GEN_BLOB_H_MAX = 1, 5\n 123: _GEN_BLOB_W_MIN, _GEN_BLOB_W_MAX = 1, 4\n 124: _GEN_DISTRACTOR_BASE_COUNT = 4\n 125: _GEN_DISTRACTOR_SIZE_SPAN = 8\n 126: _GEN_DISTRACTOR_EXTRA_MAX, _GEN_DISTRACTOR_MIN_GAP = 10, 6\n 127: \n 128: _GEN_RETRY_LIMIT = 300\n 129: _GEN_NEIGHBORS_4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n 130: \n 131: \n 132: def _gen_anchor(corner: str, n: int, h: int, w: int) -> tuple[int, int]:\n 133:     if corner == \"TL\":\n 134:         return 0, 0\n 135:     if corner == \"TR\":\n 136:         return 0, n - w\n 137:     if corner == \"BR\":\n 138:         return n - h, n - w\n 139:     if corner == \"BL\":\n 140:         return n - h, 0\n 141:     raise AssertionError(corner)\n 142: \n 143: \n 144: def _gen_source_local_corner(corner: str, h: int, w: int) -> tuple[int, int]:\n 145:     r = 0 if corner in (\"TL\", \"TR\") else h - 1\n 146:     c = 0 if corner in (\"TL\", \"BL\") else w - 1\n 147:     return r, c\n 148: \n 149: \n 150: def _gen_step_range(a: int, b: int) -> range:\n 151:     step = 1 if b >= a else -1\n 152:     return range(a, b + step, step)\n 153: \n 154: \n 155: def _gen_frontier(mask: np.ndarray) -> set[tuple[int, int]]:\n 156:     h, w = mask.shape\n 157:     frontier: set[tuple[int, int]] = set()\n 158:     for r, c in np