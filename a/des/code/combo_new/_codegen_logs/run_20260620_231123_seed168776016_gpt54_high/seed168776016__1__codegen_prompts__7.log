{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):\n        b = int(b)\n        f = int(f)\n        if b == bg:\n            continue\n        mapping[b] = f\n\n    return mapping, pal_mask\n\n\ndef _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:\n    \"\"\"\n    Find background regions (excluding the palette area) that do NOT touch the grid boundary,\n    and fill each region based on the most common adjacent border color (mapped via palette).\n    \"\"\"\n    h, w = out.shape\n    bg_mask = (out == bg) & (~pal_mask)\n    comps = components_mask(bg_mask, connectivity=4)\n    for pts in comps:\n        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n        if touches_boundary:\n            continue\n\n        adj_counts: dict[int, int] = {}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < h and 0 <= cc < w:\n                    if pal_mask[rr, cc]:\n                        continue\n                    v = int(out[rr, cc])\n                    if v == bg:\n                        continue\n                    adj_counts[v] = adj_counts.get(v, 0) + 1\n        if not adj_counts:\n            continue\n\n        # Prefer an adjacent color that exists in the mapping; pick the most frequent border.\n        border = None\n        best = -1\n        for col, cnt in adj_counts.items():\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/df9fd884.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_w, colors_present, crop_bbox, find_components, get_bg, is_contiguous, paste\nimport itertools\nimport random\n\n\ndef _cells(component):\n    return set(map(tuple, component[\"coords\"]))\n\n\ndef _is_top_bracket(component) -> bool:\n    r0, c0, r1, c1 = component[\"bbox\"]\n    width = c1 - c0 + 1\n    if r0 != 0 or r1 - r0 + 1 != 2 or width < 3:\n        return False\n    expected = {(r0, c) for c in range(c0, c1 + 1)}\n    expected |= {(r1, c0), (r1, c1)}\n    return _cells(component) == expected\n\n\ndef _is_bottom_bracket(component, height: int) -> bool:\n    r0, c0, r1, c1 = component[\"bbox\"]\n    width = c1 - c0 + 1\n    if r1 != height - 1 or r1 - r0 + 1 != 2 or width < 3:\n        return False\n    expected = {(r1, c) for c in range(c0, c1 + 1)}\n    expected |= {(r0, c0), (r0, c1)}\n    return _cells(component) == expected\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Move the colored object from the lower bracket lane to the upper bracket lane and drop it to the bottom edge.\n\n    Input structure\n    - The background is the dominant color.\n    - One frame color forms exactly two 4-connected bracket objects: a top-edge bracket open downward and a bottom-edge bracket open upward.\n    - One other 4-connected foreground object sits in the lower bracket's interior column span.\n\n    Rule\n    - Remove the movable object from its original cells.\n    - Keep its shape and color unchanged.\n    - Paste it with its bbox columns aligned to the top bracket's interior columns and with its bbox bottom aligned to the grid bottom.\n\n    Key insight\n    - The lower bracket identifies the object's source lane; the upper bracket provides the target lane, and the final vertical placement is bottom-aligned.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height, width = g.shape\n    bg = get_bg(g)\n\n    components_by_color = {}\n    bracket_candidates = []\n    for color in colors_present(g, exclude={bg}):\n        components = find_components(\n            g,\n            bg=bg,\n            colors=[color],\n            connectivity=4,\n            monochromatic=True,\n        )\n        components_by_color[color] = components\n        top = [component for component in components if _is_top_bracket(component)]\n        bottom = [\n            component for component in components\n            if _is_bottom_bracket(component, height)\n        ]\n        if len(components) == 2 and len(top) == 1 and len(bottom) == 1:\n            bracket_candidates.append((color, top[0], bottom[0]))\n\n    assert len(bracket_candidates) == 1\n    frame_color, top_bracket, bottom_bracket = bracket_candidates[0]\n\n    movers = [\n        component\n        for color, components in components_by_color.items()\n        if color != frame_color\n        for component in components\n    ]\n    assert len(movers) == 1\n    mover = movers[0]\n\n    _, mc0, _, mc1 = mover[\"bbox\"]\n    _br0, bc0, _br1, bc1 = bottom_bracket[\"bbox\"]\n    _tr0, tc0, _tr1, tc1 = top_bracket[\"bbox\"]\n    assert (mc0, mc1) == (bc0 + 1, bc1 - 1)\n    assert bbox_w(mover[\"bbox\"]) == tc1 - tc0 - 1\n\n    patch = crop_bbox(g, mover[\"bbox\"])\n    dest_r = height - patch.shape[0]\n    dest_c = tc0 + 1\n    assert dest_r >= 0\n    assert dest_c >= 0 and dest_c + patch.shape[1] <= width\n\n    out = g.copy()\n    mover_coords = mover[\"coords\"]\n    out[mover_coords[:, 0], mover_coords[:, 1]] = bg\n\n    colored_patch = patch != bg\n    target = out[dest_r:dest_r + patch.shape[0], dest_c:dest_c + patch.shape[1]]\n    assert np.all(target[colored_patch] == bg)\n\n    paste(out, patch, dest_r, dest_c, transparent=bg)\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed task colors.\nBG_COLOR, BRACKET_COLOR = 7, 4\nMOVER_COLORS = [0, 1, 2, 3, 5, 6, 8, 9]\n# Canvas, bracket, and mover-size bounds.\nGRID_SIZE_RANGE = (8, 9)\nBRACKET_WIDTH_RANGE = (3, 4)\nMOVER_HEIGHT_RANGE = (1, 3)\nMOVER_MAX_CELLS = 4\nMOVER_MIN_DENSITY_NUM = 2\nMOVER_MIN_DENSITY_DEN = 3\n# Layout choices and retry budget.\nTOP_LEFT_OPTIONS = [True, False]\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _gen_half_starts(grid_width, bracket_width, left_side):\n    if left_side:\n        return list(range(0, grid_width // 2 - bracket_width + 1))\n    return list(range((grid_width + 1) // 2, grid_width - bracket_width + 1))\n\ndef _gen_bracket_columns(grid_width, bracket_width):\n    \"\"\"Choose non-overlapping top/bottom bracket starts on opposite halves.\"\"\"\n    top_left = random.choice(TOP_LEFT_OPTIONS)\n    top_starts = _gen_half_starts(grid_width, bracket_width, top_left)\n    bottom_starts = _gen_half_starts(grid_width, bracket_width, not top_left)\n    if not top_starts or not bottom_starts:\n        return None\n    return random.choice(top_starts), random.choice(bottom_starts)\n\ndef _gen_add_bracket(grid, c0, width, top_edge):\n    edge_row, arm_row = (0, 1) if top_edge else (-1, -2)\n    grid[edge_row, c0:c0 + width] = BRACKET_COLOR\n    grid[arm_row, c0] = BRACKET_COLOR\n    grid[arm_row, c0 + width - 1] = BRACKET_COLOR\n\ndef _gen_sprite_masks(height, width):\n    area = height * width\n    min_cells = (MOVER_MIN_DENSITY_NUM * area + MOVER_MIN_DENSITY_DEN - 1) // MOVER_MIN_DENSITY_DEN\n    max_cells = min(MOVER_MAX_CELLS, area)\n    masks = []\n    for cell_count in range(min_cells, max_cells + 1):\n        for cells in itertools.combinations(range(area), cell_count):\n            mask = np.zeros((height, width), dtype=bool)\n            mask[np.unravel_index(cells, (height, width))] = True\n            if not mask.any(axis=0).all() or not mask.any(axis=1).all():\n                continue\n            if is_contiguous(mask.astype(int), background=0, connectivity=4):\n                masks.append(mask)\n    return masks\n\ndef _gen_mover_sprite(height, width, color, bg):\n    masks = _gen_sprite_masks(height, width)\n    if not masks:\n        return None\n    mask = random.choice(masks)\n    sprite = np.full((height, width), bg, dtype=int)\n    sprite[mask] = color\n    return sprite\n\ndef _gen_paste_if_clear(grid, sprite, row, col, sprite_mask):\n    \"\"\"Paste sprite only when every colored sprite cell lands on background.\"\"\"\n    target = grid[row:row + sprite.shape[0], col:col + sprite.shape[1]]\n    if not np.all(target[sprite_mask] == BG_COLOR):\n        return False\n    paste(grid, sprite, row, col, transparent=BG_COLOR)\n    return True\n\ndef _gen_attempt():\n    height = random.randint(*GRID_SIZE_RANGE)\n    grid_width = random.randint(*GRID_SIZE_RANGE)\n    bracket_width = random.randint(*BRACKET_WIDTH_RANGE)\n    interior_width = bracket_width - 2\n\n    bracket_columns = _gen_bracket_columns(grid_width, bracket_width)\n    if bracket_columns is None:\n        return None\n    top_c0, bottom_c0 = bracket_columns\n\n    mover_height = random.randint(*MOVER_HEIGHT_RANGE)\n    mover_color = random.choice(MOVER_COLORS)\n    sprite = _gen_mover_sprite(mover_height, interior_width, mover_color, BG_COLOR)\n    if sprite is None:\n        return None\n\n    out = np.full((height, grid_width), BG_COLOR, dtype=int)\n    _gen_add_bracket(out, top_c0, bracket_width, top_edge=True)\n    _gen_add_bracket(out, bottom_c0, bracket_width, top_edge=False)\n\n    dest_r = height - mover_height\n    dest_c = top_c0 + 1\n    sprite_mask = sprite != BG_COLOR\n    if not _gen_paste_if_clear(out, sprite, dest_r, dest_c, sprite_mask):\n        return None\n\n    inp = out.copy()\n    target = inp[dest_r:dest_r + mover_height, dest_c:dest_c + interior_width]\n    target[sprite_mask] = BG_COLOR\n\n    source_c = bottom_c0 + 1\n    max_source_r = height - 2 - mover_height\n    if max_source_r < 1:\n        return None\n    source_r = random.randint(1, max_source_r)\n    if not _gen_paste_if_clear(inp, sprite, source_r, source_c, sprite_mask):\n        return None\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\ndef generate_input():\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate df9fd884 input\")\n","exit_code":0,"status":"completed"}}
