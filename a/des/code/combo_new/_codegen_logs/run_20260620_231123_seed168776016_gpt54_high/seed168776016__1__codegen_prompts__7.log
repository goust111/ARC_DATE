{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport itertools\nimport random\n\n\nMARKER_COLOR = 1\nBODY_COLOR = 2\n\n\ndef _vertical_bars(g: np.ndarray, bg: int) -> list[dict]:\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    bars = []\n    baseline = None\n    for comp in comps:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert c0 == c1\n        coords = comp[\"coords\"]\n        height = r1 - r0 + 1\n        assert comp[\"area\"] == height\n        assert {(int(r), int(c)) for r, c in coords} == {(r, c0) for r in range(r0, r1 + 1)}\n        if baseline is None:\n            baseline = r1\n        else:\n            assert r1 == baseline\n        bars.append(\n            {\n                \"color\": int(comp[\"color\"]),\n                \"col\": int(c0),\n                \"bottom\": int(r1),\n                \"height\": int(height),\n                \"coords\": coords,\n            }\n        )\n\n    assert bars\n    return sorted(bars, key=lambda b: b[\"col\"])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n    Input structure\n    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n    Rule\n    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n    - Red bars that are not reached from a blue marker remain unchanged.\n    Key insight\n    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g))) - {bg}\n    assert colors <= {MARKER_COLOR, BODY_COLOR}\n    assert MARKER_COLOR in colors\n\n    bars = _vertical_bars(g, bg)\n    by_col = {bar[\"col\"]: bar for bar in bars}\n    assert len(by_col) == len(bars)\n\n    baselines = {bar[\"bottom\"] for bar in bars}\n    assert len(baselines) == 1\n    baseline = baselines.pop()\n    out = g.copy()\n    for bar in bars:\n        if bar[\"color\"] != MARKER_COLOR:\n            continue\n\n        group = [bar]\n        current = bar\n        while True:\n            next_col = current[\"col\"] + current[\"height\"]\n            next_bar = by_col.get(next_col)\n            if next_bar is None:\n                break\n            if next_bar[\"color\"] != BODY_COLOR:\n                break\n            group.append(next_bar)\n            current = next_bar\n\n        for item in group:\n            rows = item[\"coords\"][:, 0]\n            cols = item[\"coords\"][:, 1]\n            out[rows, cols] = bg\n\n        for item in group:\n            col = item[\"col\"]\n            height = item[\"height\"]\n            assert col + height <= g.shape[1]\n            out[baseline, col : col + height] = item[\"color\"]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nMIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n\n# Bar and chain structure.\nMIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\nMIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\nMIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n\n# Layout padding and retry budget.\nGAP_VALUES = (1, 2, 3)\nMAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n\n\ndef _chain_red_distributions(n_blue, n_red):\n    \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n    return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n\n\ndef _bounded_tuples(values, n, max_sum):\n    \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n    return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n\n\ndef _sample_groups():\n    \"\"\"Sample row count and bar groups before physical layout.\"\"\"\n    rows = random.randint(MIN_ROWS, MAX_ROWS)\n    max_height = min(MAX_BAR_HEIGHT, rows)\n    n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)\n    max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)\n    red_total = random.randint(MIN_RED_BARS, max_red)\n    min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)\n    max_unchained = min(MAX_UNCHAINED_RED, red_total)\n    n_unchained = random.randint(min_unchained, max_unchained)\n\n    distributions = _chain_red_distributions(n_blue, red_total - n_unchained)\n    if not distributions:\n        return None\n\n    groups = [\n        {\"kind\": \"chain\", \"colors\": [MARKER_COLOR] + [BODY_COLOR] * n_red}\n        for n_red in random.choice(distributions)\n    ]\n    groups.extend({\"kind\": \"unchained\", \"colors\": [BODY_COLOR]} for _ in range(n_unchained))\n    random.shuffle(groups)\n    if groups[0][\"kind\"] == \"unchained\":\n        for i, group in enumerate(groups):\n            if group[\"kind\"] == \"chain\":\n                groups[0], groups[i] = groups[i], groups[0]\n                break\n    return rows, max_height, groups\n\n\ndef _sample_layout(max_height, groups):\n    \"\"\"Sample gaps, heights, margins, and positioned bar columns.\"\"\"\n    n_bars = sum(len(group[\"colors\"]) for group in groups)\n    right_margin = random.randint(0, MAX_RIGHT_MARGIN)\n\n    gap_count = len(groups) - 1\n    if gap_count:\n        max_gap_sum = MAX_WIDTH - right_margin - MIN_BAR_HEIGHT * n_bars\n        gap_options = _bounded_tuples(GAP_VALUES, gap_count, max_gap_sum)\n        if not gap_options:\n            return None\n        gaps = list(random.choice(gap_options))\n    else:\n        gaps = []\n\n    height_options = _bounded_tuples(\n        tuple(range(MIN_BAR_HEIGHT, max_height + 1)),\n        n_bars,\n        MAX_WIDTH - right_margin - sum(gaps),\n    )\n    if not height_options:\n        return None\n    heights = list(random.choice(height_options))\n\n    idx = 0\n    for group in groups:\n        count = len(group[\"colors\"])\n        group[\"heights\"] = heights[idx : idx + count]\n        idx += count\n\n    span = sum(heights) + sum(gaps)\n    min_left = max(0, MIN_WIDTH - right_margin - span)\n    max_left = MAX_WIDTH - right_margin - span\n    if min_left > max_left:\n        return None\n    if min_left <= min(MAX_RANDOM_LEFT_MARGIN, max_left):\n        left_margin = random.randint(min_left, min(MAX_RANDOM_LEFT_MARGIN, max_left))\n    else:\n        left_margin = min_left\n\n    width = left_margin + span + right_margin\n    if not (MIN_WIDTH <= width <= MAX_WIDTH):\n        return None\n\n    bars = []\n    col = left_margin\n    gap_i = 0\n    for group_i, group in enumerate(groups):\n        chained = group[\"kind\"] == \"chain\"\n        for color, height in zip(group[\"colors\"], group[\"heights\"]):\n            bars.append(\n                {\n                    \"color\": color,\n                    \"height\": height,\n                    \"col\": col,\n                    \"chained\": chained,\n                }\n            )\n            col += height\n        if group_i + 1 < len(groups):\n            col += gaps[gap_i]\n            gap_i += 1\n\n    if col + right_margin != width:\n        return None\n    return bars, width\n\n\ndef _render_pair(rows, width, bars):\n    \"\"\"Render the sampled input grid and its expected transformed output.\"\"\"\n    baseline = rows - 1\n    inp = np.zeros((rows, width), dtype=int)\n    out = np.zeros_like(inp)\n    for bar in bars:\n        color, height, col = bar[\"color\"], bar[\"height\"], bar[\"col\"]\n        vertical = slice(baseline - height + 1, baseline + 1)\n        inp[vertical, col] = color\n        if bar[\"chained\"]:\n            out[baseline, col : col + height] = color\n        else:\n            out[vertical, col] = color\n    return inp, out\n\n\ndef _passes_oracle(inp, expected):\n    \"\"\"Return whether the solver accepts and matches the rendered output.\"\"\"\n    try:\n        actual = main(inp)\n    except Exception:\n        return False\n    return np.array_equal(actual, expected)\n\n\ndef _gen_attempt():\n    sampled = _sample_groups()\n    if sampled is None:\n        return None\n    rows, max_height, groups = sampled\n\n    layout = _sample_layout(max_height, groups)\n    if layout is None:\n        return None\n    bars, width = layout\n\n    inp, expected = _render_pair(rows, width, bars)\n    if not _passes_oracle(inp, expected):\n        return None\n    return inp\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\"","aggregated_output":"import numpy as np\nfrom collections import Counter, deque\n\nfrom arc_utils import components_mask, get_bg, neighbors4, neighbors8\nimport random\ndef _components_mask(mask: np.ndarray, conn8: bool) -> list[list[tuple[int, int]]]:\n    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(mask, connectivity=8 if conn8 else 4)]\n\n\ndef _touches_border(pts: list[tuple[int, int]], h: int, w: int) -> bool:\n    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n\n\ndef _seed_pixels(g: np.ndarray, bg: int) -> list[tuple[int, int]]:\n    h, w = g.shape\n    vals, cnts = np.unique(g, return_counts=True)\n    seeds: list[tuple[int, int]] = []\n    for v, cnt in zip(vals, cnts):\n        v = int(v)\n        if v == bg or int(cnt) != 1:\n            continue\n        r, c = map(int, np.argwhere(g == v)[0])\n        if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n            seeds.append((r, c))\n    return seeds\n\n\ndef _nonbg_component8_from(g: np.ndarray, start: tuple[int, int], bg: int) -> set[tuple[int, int]]:\n    h, w = g.shape\n    st = [start]\n    vis = {start}\n    while st:\n        r, c = st.pop()\n        for nr, nc in neighbors8(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in vis and int(g[nr, nc]) != bg:\n                vis.add((nr, nc))\n                st.append((nr, nc))\n    return vis\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\ndef _in_bounds(h, w, r, c):\n    return 0 <= r < h and 0 <= c < w\n\n\n# ---------------------------------------------------------------------------\n# Frame geometry\n# ---------------------------------------------------------------------------\n\ndef _frame_ring_coords(r0, c0, ch, cw):\n    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n\n    Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).\n    Ring = bbox boundary minus 4 corners.\n    \"\"\"\n    H, W = ch + 2, cw + 2\n    ring = []\n    for dr in range(H):\n        for dc in range(W):\n            on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)\n            corner = (dr in (0, H - 1)) and (dc in (0, W - 1))\n            if on_bdr and not corner:\n                ring.append((r0 + dr, c0 + dc))\n    cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]\n    return ring, cavity\n\n\ndef _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n\n    Returns True if: ring and cavity cells are empty, no cavity cell is\n    8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and\n    at least one ring cell is 8-adjacent to a line_col pixel.\n    \"\"\"\n    # Ring and cavity cells must all be empty\n    for rr, cc in ring:\n        if canvas[rr, cc] != -1:\n            return False\n    for rr, cc in cavity:\n        if canvas[rr, cc] != -1:\n            return False\n\n    # No cavity cell may be 8-adjacent to any line_col pixel\n    for cr, cc in cavity:\n        for nr, nc in neighbors8(cr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return False\n\n    # Ring must not be 8-adjacent to any non-bg, non-line_col pixel\n    ring_set = set(ring)\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:\n                continue\n            v = canvas[nr, nc]\n            if v != -1 and v != line_col:\n                return False\n\n    # At least one ring cell must be 8-adjacent to a line_col pixel\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return True\n    return False\n\n\n# ---------------------------------------------------------------------------\n# Line growth\n# ---------------------------------------------------------------------------\n\ndef _grow_line(grid, start, line_col, target_len, rng):\n    \"\"\"Grow a meandering 8-connected 1px-wide path of line_col from start.\"\"\"\n    h, w = grid.shape\n    path = [start]\n    dr_bias = 1 if start[0] < h // 2 else -1\n    dc_bias = 1 if start[1] < w // 2 else -1\n    cur = start\n    path_set = {start}\n    while len(path) < target_len:\n        # Build weighted direction list: diagonals preferred, bias-aligned boosted\n        dirs = []\n        for ddr, ddc in DIAG_DIRS:\n            aligned = (ddr == dr_bias or ddc == dc_bias)\n            w_d = DIAG_WEIGHT_ALIGNED if aligned else DIAG_WEIGHT_OTHER\n            dirs.extend([(ddr, ddc)] * w_d)\n        for ddr, ddc in ORTHO_DIRS:\n            aligned = (ddr == dr_bias and ddc == 0) or (ddc == dc_bias and ddr == 0)\n","exit_code":0,"status":"completed"}}
