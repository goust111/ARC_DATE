the wall-bordered square rooms need to be expanded from the route centerline to their full interior.\n 142:     \"\"\"\n 143:     g = np.asarray(grid, dtype=int)\n 144:     assert g.ndim == 2\n 145: \n 146:     bg = get_bg(g)\n 147:     counts = Counter(map(int, g.flat))\n 148: \n 149:     non_bg = colors_present(g, exclude={bg})\n 150:     assert len(non_bg) == 2\n 151:     assert counts[bg] > max(counts[color] for color in non_bg)\n 152:     non_bg_counts = {color: int(np.count_nonzero(g == color)) for color in non_bg}\n 153:     wall_count = max(non_bg_counts.values())\n 154:     wall_candidates = [color for color, count in non_bg_counts.items() if count == wall_count]\n 155:     assert len(wall_candidates) == 1\n 156:     wall = wall_candidates[0]\n 157:     paint_candidates = [color for color in non_bg if color != wall]\n 158:     assert len(paint_candidates) == 1\n 159:     paint = paint_candidates[0]\n 160:     assert non_bg_counts[wall] > non_bg_counts[paint]\n 161: \n 162:     endpoints = find_components(g, bg=bg, colors=[paint], connectivity=4)\n 163:     assert len(endpoints) == 2\n 164:     endpoint_coords = [component[\"coords\"] for component in endpoints]\n 165: \n 166:     room_sizes: set[int] = set()\n 167:     for coords in endpoint_coords:\n 168:         r0, c0, r1, c1 = bbox_coords(coords)\n 169:         bh = r1 - r0 + 1\n 170:         bw = c1 - c0 + 1\n 171:         assert coords.shape[0] == bh * bw\n 172:         room_sizes.add(max(bh, bw))\n 173: \n 174:     passable = g != wall\n 175:     dist0 = _distances_from(endpoint_coords[0], passable)\n 176:     dist1 = _distances_from(endpoint_coords[1], passable)\n 177:     endpoint_distances = [int(dist0[r, c]) for r, c in endpoint_coords[1]]\n 178:     reachable_distances = [d for d in endpoint_distances if d >= 0]\n 179:     assert len(reachable_distances) == len(endpoint_distances)\n 180:     shortest = min(reachable_distances)\n 181: \n 182:     route = (dist0 >= 0) & (dist1 >= 0) & (dist0 + dist1 == shortest)\n 183:     assert np.any(route)\n 184: \n 185:     fill = route.copy()\n 186:     rooms = _framed_square_rooms(g, wall, room_sizes)\n 187:     assert rooms\n 188:     for r, c, n in rooms:\n 189:         if np.any(route[r : r + n, c : c + n]):\n 190:             fill[r : r + n, c : c + n] = True\n 191: \n 192:     room_mask = np.zeros_like(fill, dtype=bool)\n 193:     for r, c, n in rooms:\n 194:         room_mask[r : r + n, c : c + n] = True\n 195:     open_fill = fill & (g == bg) & ~room_mask\n 196:     for r0, c0, r1, c1, area in _component_bboxes(open_fill):\n 197:         if r1 > r0 and c1 > c0 and area >= 20:\n 198:             assert _middle_fill_bounded_by_side_rooms(\n 199:                 (r0, c0, r1, c1),\n 200:                 rooms,\n 201:             ), \"middle fill must stay within the facing room-frame spans\"\n 202: \n 203:     H, W = g.shape\n 204:     for r, c, n in rooms:\n 205:         has_doorway = False\n 206:         if r > 0:\n 207:             has_doorway = has_doorway or np.any(g[r - 1, c : c + n] != wall)\n 208:         if r + n < H:\n 209:             has_doorway = has_doorway or np.any(g[r + n, c : c + n] != wall)\n 210:         if c > 0:\n 211:             has_doorway = has_doorway or np.any(g[r : r + n, c - 1] != wall)\n 212:         if c + n < W:\n 213:             has_doorway = has_doorway or np.any(g[r : r + n, c + n] != wall)\n 214:         if has_doorway:\n 215:             assert np.any(fill[r : r + n, c : c + n]), \"rooms with doorways must be on the shortest path\"\n 216: \n 217:     out = g.copy()\n 218:     out[fill & (g == bg)] = paint\n 219:     return out\n 220: \n 221: # --------------- generator (attempt 2 refined middle-fill) ---------------\n 222: \n 223: BG = 0\n 224: WALL = 8\n 225: PAINT_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]\n 226: \n 227: # Canvas bounds used by the observed evaluation examples.\n 228: ROW_MIN = 22\n 229: ROW_MAX = 29\n 230: COL_MIN = 24\n 231: COL_MAX = 28\n 232: \n 233: # Room-grid geometry and room-count filters.\n 234: ROOM_SIZE_RANGE = range(3, 6)\n 235: ROOM_GRID_RANGE = range(1, 8)\n 236: BLOCK_ROOM_MIN = 3\n 237: BLOCK_ROOM_MAX = 14\n 238: TOTAL_ROOM_MIN = 7\n 239: TOTAL_ROOM_MAX = 22\n 240: GAP_RANGE = range(3, 8)\n 241: ORIENTATIONS = (\"vertical\", \"horizontal\")\n 242: \n 243: # Coarse layout and final route validation thresholds.\n 244: LAYOUT_DISTANCE_MIN = 36\n 245: LAYOUT_DISTANCE_FLOORS = [36, 42, 48, 54, 60]\n 246: SHORTEST_DISTANCE_MIN = 36\n 247: SHORTEST_DISTANCE_MAX = 72\n 248: TURN_MIN = 8\n 249: TURN_MAX = 21\n 250: ON_ROUTE_ROOM_MIN = 6\n 251: ON_ROUTE_ROOM_MAX = 14\n 252: OFF_ROUTE_ROOM_MIN = 1\n 253: OFF_ROUTE_ROOM_MAX = 8\n 254: \n 255: # Connector sampling: offset connectors create the observed middle fill region.\n 256: OFFSET_CONNECTOR_PROB = 0.60\n 257: CONNECTOR_CHOICE_TRIES = 300\n 258: CONNECTOR_DELTA_MAX = 12\n 259: CONNECTOR_DELTA_MIN_CAP = 5\n 260: \n 261: # Endpoint room selection favors far rooms, with a minority near-exit branch.\n 262: NEAR_EXIT_ENDPOINT_PROB = 0.30\n 263: NEAR_EXIT_STEPS = [-1, 0, 1]\n 264: \n 265: # Full-example rejection retries.\n 266: GENERATE_ATTEMPTS = 300\n 267: \n---- generate_input head ----\n 719: def generate_input():\n 720:     for _ in range(GENERATE_ATTEMPTS):\n 721:         grid = _gen_attempt()\n 722:         if grid is not None:\n 723:             return grid\n 724:     raise RuntimeError(\"failed to generate valid 3ad05f52 input\")\n\n===== 136b0064.py =====\n  24: def main(grid: np.ndarray) -> np.ndarray:\n  25:     \"\"\"\n  26:     Draw a polyline by decoding 3x3 glyph instructions read across a divided grid.\n  27: \n  28:     Input structure:\n  29:     - Left of a full-height vertical divider: 3x3 colored glyphs on bg.\n  30:     - Right of divider: a single gray (5) start pixel.\n  31: \n  32:     Rule:\n  33:     - Remove the divider; shift the gray start into the left canvas.\n  34:     - Read glyphs in column-major order (left→right, top→bottom).\n  35:     - Each glyph's shape (pixel area) encodes a segment: area 4 → down 2, area 5 → right 3, area 6 → left 4, area 7 → left 2.\n  36:     - Append segments sequentially, stepping down one cell between each.\n  37: \n  38:     Key insight: Glyph pixel count (area) uniquely determines both segment length and direction — the shape itself is the instruction.\n  39:     \"\"\"\n  40:     g = np.array(grid, dtype=int)\n  41:     H, W = g.shape\n  42:     bg = int(get_bg(g))\n  43: \n  44:     # Divider is a full-height constant non-bg column.\n  45:     div_c, div_color = find_full_height_constant_col(g, bg=bg)\n  46:     assert div_c is not None\n  47: \n  48:     out = np.zeros((H, int(div_c)), dtype=int)\n  49: \n  50:     # Move gray start from right side into left canvas (remove divider col too).\n  51:     gray = np.argwhere(g == 5)\n  52:     if gray.size == 0:\n  53:         return out\n  54:     r_cur, c_cur = map(int, gray[0])\n  55:     c_cur = int(c_cur - (int(div_c) + 1))\n  56:     if not (0 <= c_cur < int(div_c)):\n  57:         return out\n  58:     out[int(r_cur), int(c_cur)] = 5\n  59: \n  60:     # Collect 3x3 glyph components on the left.\n  61:     left = g[:, : int(div_c)]\n  62:     ignore = {int(bg), 5}\n  63:     if div_color is not None:\n  64:         ignore.add(int(div_color))\n  65: \n  66:     glyphs: list[dict[str, int]] = []\n  67:     for comp in find_components(left, bg=bg, connectivity=8, monochromatic=True, return_format=\"dict\"):\n  68:         col = int(comp[\"color\"])\n  69:         if col in ignore:\n  70:             continue\n  71:         b = comp[\"bbox\"]\n  72:         if bbox_h(b) == 3 and bbox_w(b) == 3:\n  73:             r0, c0, _r1, _c1 = map(int, b)\n  74:             glyphs.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"area\": int(comp[\"area\"])})\n  75: \n  76:     glyphs.sort(key=lambda d: (int(d[\"c0\"]), int(d[\"r0\"])))\n  77: \n  78:     area_to_len = {4: 2, 5: 3, 6: 4, 7: 2}\n  79:     area_to_dir = {5: 1, 6: -1, 7: -1}  # diamond right; cross/U left\n  80: \n  81:     for glyph in glyphs:\n  82:         color = int(glyph[\"color\"])\n  83:         area = int(glyph[\"area\"])\n  84:         seg_len = int(area_to_len.get(area, 2))\n  85: \n  86:         r_cur = int(r_cur + 1)\n  87:         assert r_cur < H, f\"segment exits bottom: r_cur={r_cur}, H={H}\"\n  88:         out[r_cur, int(c_cur)] = color\n  89: \n  90:         if area == 4:  # vertical (down)\n  91:             end_r = r_cur + (seg_len - 1)\n  92:             assert end_r < H, f\"vertical segment exits bottom: end_r={end_r}, H={H}\"\n  93:             for _ in range(seg_len - 1):\n  94:                 r_cur = int(r_cur + 1)\n  95:                 out[r_cur, int(c_cur)] = color\n  96:         else:  # horizontal\n  97:             dir_h = int(area_to_dir.get(area, 1))\n  98:             end_c = int(c_cur) + dir_h * (seg_len - 1)\n  99:             assert 0 <= end_c < int(div_c), (\n 100:                 f\"horizontal segment exits canvas: c_cur={c_cur}, dir={dir_h}, \"\n 101:                 f\"seg_len={seg_len}, div_c={div_c}\"\n 102:             )\n 103:             for _ in range(seg_len - 1):\n 104:                 c_cur = int(c_cur + dir_h)\n 105:                 out[r_cur, c_cur] = color\n 106: \n 107:     return out\n 108: \n 109: # --------------- generator (attempt 1 (Claude)) ---------------\n 110: \n 111: # --- canvas geometry ---\n 112: N_MIN, N_MAX = 2, 5            # number of tile rows; H = 4*N - 1, num_glyphs = 2*N\n 113: GRID_W = 15                    # full input width\n 114: DIVIDER_COL = 7                # divider position (col), full-height\n 115: DIVIDER_COLOR = 4              # divider fill color\n 116: LEFT_W = 7                     # left canvas width (cols 0..6)\n 117: TILE_COLS = (0, 4)             # 3x3 tile c0 positions on the left\n 118: TILE_ROW_STRIDE = 4            # row spacing between successive tile slots\n 119: GRAY = 5                       # start-pixel color\n 120: GRAY_START_ROW = 0             # gray start always sits at row 0 [observed]\n 121: \n 122: # --- shape grammar (area -> 3x3 template, color, and (dr, dc) walk delta) ---\n 123: # Walk delta = total (row, col) displacement caused by one glyph instruction:\n 124: #   step down 1 then segment of (len, dir). E.g. area 4 (vertical len 2) => (+2, 0).\n 125: _TEMPLATES = {\n 126:     4: np.array([[1, 0, 1], [0, 1, 0], [0, 1, 0]], dtype=int),  # plus    -> down 2,  color 6\n 127:     5: np.array([[1, 1, 0], [1, 0, 1], [0, 1, 0]], dtype=int),  # diamond -> right 3, color 1\n 128:     6: np.array([[1, 1, 1], [0, 1, 0], [1, 0, 1]], dtype=int),  # cross   -> left 4,  color 3\n 129:     7: np.array([[1, 0, 1], [1, 0, 1], [1, 1, 1]], dtype=int),  # U       -> left 2,  color 2\n 130: }\n 131: _AREA_TO_COLOR = {4: 6, 5: 1, 6: 3, 7: 2}\n 132: _AREA_DELTA = {4: (2, 0), 5: (1, 2), 6: (1, -3), 7: (1, -1)}\n 133: _AREAS = (4, 5, 6, 7)\n 134: \n 135: # --- generation constraints ---\n 136: MIN_DIRECTION_CHANGES = 2      # min vertical<->horizontal flips across the walk\n 137: MAX_ATTEMPTS = 300             # outer retry budget\n 138: \n 139: \n 140: def _sample_path(N: int, start_col: int) -> list[int] | None:\n 141:     \"\"\"Random-walk a sequence of 2*N area instructions that stays in the left canvas.\n 142: \n 143:     Returns None if the walk dead-ends or fails the direction-change constraint.\n 144:     \"\"\"\n 145:     H = 4 * N - 1\n 146:     r, c = GRAY_START_ROW, start_col\n 147:     areas: list[int] = []\n 148:     for _ in range(2 * N):\n 149:         opts = [a for a in _AREAS\n 150:                 if r + _AREA_DELTA[a][0] < H and 0 <= c + _AREA_DELTA[a][1] < LEFT_W]\n 151:         if not opts:\n 152:             return None\n 153:         area = random.choice(opts)\n 154:         areas.append(area)\n 155:         dr, dc = _AREA_DELTA[area]\n 156:         r += dr\n 157:         c += dc\n 158: \n 159:     types = [a == 4 for a in areas]  # True = vertical, False = horizontal\n 160:     changes = sum(1 for i in range(1, len(types)) if types[i] != types[i - 1])\n 161:     if changes < MIN_DIRECTION_CHANGES:\n 162:         return None\n 163:     return areas\n 164: \n---- generate_input head ----\n 190: def generate_input() -> np.ndarray:\n 191:     for _ in range(MAX_ATTEMPTS):\n 192:         try:\n 193:             inp = _gen_attempt()\n 194:             if inp is None:\n 195:                 continue\n 196:             out = main(inp)  # oracle check\n 197:             if out.shape != (inp.shape[0], LEFT_W):\n 198:                 continue\n 199:             return inp\n 200:         except Exception:\n 201:             continue\n 202:     raise RuntimeError(f\"generate_input: failed after {MAX_ATTEMPTS} attempts\")\n\n===== 342ae2ed.py =====\n  33: def main(grid: np.ndarray) -> np.ndarray:\n  34:     \"\"\"\n  35:     Draw the missing diagonal connector segment between each pair of same-color rectangular objects.\n  36: \n  37:     Input structure:\n  38:     - The grid has one dominant background color.\n  39:     - Every foreground color appears as exactly two separated solid rectangular 4-connected objects.\n  40:     - The two rectangles of each color are diagonally offset with facing corners on a 45-degree line.\n  41: \n  42:     Rule:\n  43:     - Keep all existing rectangles unchanged.\n  44:     - For each foreground color, connect the lower facing corner of the upper rectangle to the upper facing corner of the lower rectangle.\n  45:     - Paint only the intervening background pixels on that diagonal, excluding the two endpoint pixels already in the rectangles.\n  46: \n  47:     Key insight:\n  48:     - Same-color rectangles define the endpoints; the output completes the open diagonal between their nearest facing corners.\n  49:     \"\"\"\n  50:     g = np.asarray(grid, dtype=int)\n  51:     bg = int(get_bg(g))\n  52:     out = g.copy()\n  53: \n  54:     for color in colors_present(g, exclude={bg}):\n  55:         components = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[color])\n  56:         assert len(components) == 2, \"each foreground color must have exactly two objects\"\n  57: \n  58:         rectangles = [_assert_solid_rectangle(g, int(color), component) for component in components]\n  59:         rectangles.sort(key=lambda b: b[0])\n  60:         upper, lower = rectangles\n  61:         start, end = _facing_corners(upper, lower)\n  62: \n  63:         row_delta = int(end[0] - start[0])\n  64:         col_delta = int(end[1] - start[1])\n  65:         assert row_delta > 0, \"connector must go downward from the upper rectangle\"\n  66:         assert abs(row_delta) == abs(col_delta), \"facing corners must be diagonally aligned\"\n  67: \n  68:         dr = 1\n  69:         dc = 1 if col_delta > 0 else -1\n  70:         r, c = int(start[0] + dr), int(start[1] + dc)\n  71:         while (r, c) != end:\n  72:             assert int(out[r, c]) == bg, \"connector path must pass through background\"\n  73:             out[r, c] = int(color)\n  74:             r += dr\n  75:             c += dc\n  76: \n  77:     return out\n  78: \n  79: # --------------- generator (att2, o5x) ---------------\n  80: \n  81: # Canvas and palette.\n  82: BG, N = 7, 16\n  83: FOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n  84: \n  85: # Pair sampling and rectangle spacing.\n  86: PAIR_COUNTS = [3, 4, 5]\n  87: PAIR_COUNT_WEIGHTS = [4, 10, 60]\n  88: LARGE_RECT_SIZE, SMALL_RECT_SIZE = 3, 2\n  89: MIN_RECT_GAP = 2\n  90: \n  91: # Connector sampling and retry budget.\n  92: DIRECTIONS = [1, -1]\n  93: GAP_RANGE, MAX_ATTEMPTS = (2, 6), 300\n  94: \n  95: Box = tuple[int, int, int, int]\n  96: Cells = list[tuple[int, int]]\n  97: Candidate = tuple[Box, Box, Cells]\n  98: \n  99: \n 100: def _bbox_gap_ok(a: Box, b: Box) -> bool:\n 101:     ar0, ac0, ar1, ac1 = a\n 102:     br0, bc0, br1, bc1 = b\n 103:     row_gap = max(ar0 - br1 - 1, br0 - ar1 - 1, 0)\n 104:     col_gap = max(ac0 - bc1 - 1, bc0 - ac1 - 1, 0)\n 105:     return max(row_gap, col_gap) >= MIN_RECT_GAP\n 106: \n 107: \n 108: def _rect_cells(box: Box) -> Cells:\n 109:     r0, c0, r1, c1 = box\n 110:     return [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]\n 111: \n 112: \n 113: def _candidate(\n 114:     size: int,\n 115:     direction: int,\n 116:     gap: int,\n 117:     ur: int,\n 118:     uc: int,\n 119: ) -> Candidate | None:\n 120:     delta = gap + 1\n 121:     upper = (ur, uc, ur + size - 1, uc + size - 1)\n 122:     if direction == 1:\n 123:         start = (upper[2], upper[3])\n 124:         end = (start[0] + delta, start[1] + delta)\n 125:         lower = (end[0], end[1], end[0] + size - 1, end[1] + size - 1)\n 126:     else:\n 127:         start = (upper[2], upper[1])\n 128:         end = (start[0] + delta, start[1] - delta)\n 129:         lower = (end[0], end[1] - size + 1, end[0] + size - 1, end[1])\n 130: \n 131:     if min(*upper, *lower) < 0 or max(upper[2], upper[3], lower[2], lower[3]) >= N:\n 132:         return None\n 133:     if not _bbox_gap_ok(upper, lower):\n 134:         return None\n 135:     diag = [(start[0] + k, start[1] + direction * k) for k in range(1, gap + 1)]\n 136:     return upper, lower, diag\n 137: \n 138: \n 139: def _valid_candidates(\n 140:     occupied: np.ndarray,\n 141:     existing_rects: list[Box],\n 142:     size: int,\n 143:     direction: int,\n 144:     gap: int,\n 145: ) -> list[Candidate]:\n 146:     out = []\n 147:     for ur in range(N - size + 1):\n 148:         for uc in range(N - size + 1):\n 149:             cand = _candidate(size, direction, gap, ur, uc)\n 150:             if cand is None:\n 151:                 continue\n 152:             upper, lower, diag = cand\n 153:             if any(not _bbox_gap_ok(box, old) for box in (upper, lower) for old in existing_rects):\n 154:                 continue\n 155:             cells = _rect_cells(upper) + _rect_cells(lower) + diag\n 156:             if any(bool(occupied[r, c]) for r, c in cells):\n 157:                 continue\n 158:             out.append(cand)\n 159:     random.shuffle(out)\n 160:     return out\n 161: \n 162: \n 163: def _place_rect(grid: np.ndarray, box: Box, color: int) -> None:\n 164:     r0, c0, r1, c1 = box\n 165:     grid[r0 : r1 + 1, c0 : c1 + 1] = color\n 166: \n 167: \n 168: def _sample_plan(n_pairs: int) -> tuple[list[int], list[int], list[int], list[int], list[int]]:\n 169:     colors = random.sample(FOREGROUND_COLORS, n_pairs)\n 170:     sizes = [LARGE_RECT_SIZE] + [SMALL_RECT_SIZE] * (n_pairs - 1)\n 171:     random.shuffle(sizes)\n 172:     directions = [1, -1] + [random.choice(DIRECTIONS) for _ in range(n_pairs - 2)]\n 173:     random.shuffle(directions)\n---- generate_input head ----\n 216: def generate_input() -> np.ndarray:\n 217:     for _ in range(MAX_ATTEMPTS):\n 218:         grid = _gen_attempt()\n 219:         if grid is not None:\n 220:             return grid\n 221:     raise RuntimeError(\"failed to generate valid 342ae2ed input\")\n\n===== 182e5d0f.py =====\n  88: def main(grid: np.ndarray) -> np.ndarray:\n  89:     \"\"\"\n  90:     Move each gray marker along its green path until it reaches the cell next to a black-green-black gate, erasing the path behind it.\n  91: \n  92:     Input structure:\n  93:     - The background is the dominant color.\n  94:     - Foreground components are made from a path color, a paired gate-end color, and single marker pixels.\n  95:     - A gate is a straight end-center-end motif whose center has the path color and whose two ends share the gate-end color.\n  96: \n  97:     Rule:\n  98:     - In every 4-connected foreground component with exactly one marker and one gate, erase the marker and all path-color pixels except the gate center.\n  99:     - Place the marker on the unique path-color pixel adjacent to the gate center but not between the two gate ends.\n 100:     - Components without both a marker and a gate stay unchanged.\n 101: \n 102:     Key insight: The black-green-black motif marks the stopping gate; the gray marker consumes the connected green path until it rests on the path cell immediately beside that gate.\n 103:     \"\"\"\n 104:     g = np.asarray(grid, dtype=int)\n 105:     bg = int(get_bg(g))\n 106:     path_color, end_color, marker_color = _role_colors(g, bg)\n 107:     out = g.copy()\n 108: \n 109:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False):\n 110:         coords = comp[\"coords\"]\n 111:         marker_coords = [\n 112:             tuple(map(int, coord)) for coord in coords if int(g[tuple(coord)]) == marker_color\n 113:         ]\n 114:         gates = _component_gates(g, coords, path_color, end_color)\n 115:         if not marker_coords or not gates:\n 116:             continue\n 117: \n 118:         assert len(marker_coords) == 1\n 119:         assert len(gates) == 1\n 120:         gate_r, gate_c, dr, dc = gates[0]\n 121:         gate = (gate_r, gate_c)\n 122:         gate_ends = {(gate_r - dr, gate_c - dc), (gate_r + dr, gate_c + dc)}\n 123:         coords_set = {tuple(map(int, coord)) for coord in coords}\n 124: \n 125:         parking = []\n 126:         for nr, nc in neighbors4(gate_r, gate_c):\n 127:             candidate = (int(nr), int(nc))\n 128:             if candidate in gate_ends:\n 129:                 continue\n 130:             if candidate in coords_set and int(g[candidate]) == path_color:\n 131:                 parking.append(candidate)\n 132:         assert len(parking) == 1\n 133: \n 134:         marker = marker_coords[0]\n 135:         assert _path_reaches_marker(g, parking[0], marker, path_color, {gate})\n 136: \n 137:         for r, c in coords:\n 138:             if int(g[r, c]) in (path_color, marker_color):\n 139:                 out[r, c] = bg\n 140:         out[gate] = path_color\n 141:         out[parking[0]] = marker_color\n 142: \n 143:     return out\n 144: \n 145: # --------------- generator (o5x) ---------------\n 146: \n 147: # -- Colors --\n 148: BG = 7\n 149: PATH = 3\n 150: END = 0\n 151: MARKER = 5\n 152: \n 153: # -- Grid dimensions --\n 154: GRID_MIN, GRID_MAX = 9, 14  # height/width range (inclusive)\n 155: \n 156: # -- Component counts --\n 157: N_ACTIVE_MIN, N_ACTIVE_MAX = 1, 2      # active components per grid\n 158: N_STATIC_GATE_MIN, N_STATIC_GATE_MAX = 0, 2  # static-gate (and static-marker) count\n 159: \n 160: # -- Path geometry --\n 161: ARM1_EXTRA_MAX = 1   # extra perpendicular arm cells (0 or 1)\n 162: ARM2_MAX = 10        # max parallel arm length\n 163: \n 164: # -- Retry budget --\n 165: MAX_RETRIES = 300\n 166: \n 167: \n 168: def _add(a: tuple[int, int], b: tuple[int, int], k: int = 1) -> tuple[int, int]:\n 169:     return a[0] + b[0] * k, a[1] + b[1] * k\n 170: \n 171: \n 172: def _on_boundary(shape: tuple[int, int], r: int, c: int) -> bool:\n 173:     H, W = shape\n 174:     return r == 0 or c == 0 or r == H - 1 or c == W - 1\n 175: \n 176: \n 177: def _gate_frames(H: int, W: int):\n 178:     \"\"\"Yield all valid gate placements: (center, gate_ends, inward_dir, parallel_dirs).\"\"\"\n 179:     for c in range(1, W - 1):\n 180:         yield (0, c), {(0, c - 1), (0, c + 1)}, (1, 0), ((0, -1), (0, 1))\n 181:         yield (H - 1, c), {(H - 1, c - 1), (H - 1, c + 1)}, (-1, 0), ((0, -1), (0, 1))\n 182:     for r in range(1, H - 1):\n 183:         yield (r, 0), {(r - 1, 0), (r + 1, 0)}, (0, 1), ((-1, 0), (1, 0))\n 184:         yield (r, W - 1), {(r - 1, W - 1), (r + 1, W - 1)}, (0, -1), ((-1, 0), (1, 0))\n 185: \n 186: \n 187: def _fits(component: set[tuple[int, int]], occupied: set[tuple[int, int]]) -> bool:\n 188:     \"\"\"Check that no cell in component overlaps or is 4-adjacent to occupied cells.\"\"\"\n 189:     for p in component:\n 190:         if p in occupied:\n 191:             return False\n 192:         if any(q in occupied for q in neighbors4(*p)):\n 193:             return False\n 194:     return True\n 195: \n 196: \n 197: def _active_markers(\n 198:     shape: tuple[int, int],\n 199:     far_end: tuple[int, int],\n 200:     path_cells: set[tuple[int, int]],\n 201:     gate_ends: set[tuple[int, int]],\n 202: ) -> list[tuple[int, int]]:\n 203:     \"\"\"Return valid marker positions: on boundary, adjacent to far_end, not adjacent to other path/gate cells.\"\"\"\n 204:     markers = []\n 205:     for nr, nc in neighbors4(*far_end):\n 206:         m = (nr, nc)\n 207:         if not in_bounds(shape, nr, nc) or not _on_boundary(shape, nr, nc):\n 208:             continue\n 209:         if m in path_cells or m in gate_ends:\n 210:             continue\n 211:         if any(q != far_end and abs(nr - q[0]) + abs(nc - q[1]) == 1 for q in path_cells):\n 212:             continue\n 213:         if any(abs(nr - q[0]) + abs(nc - q[1]) == 1 for q in gate_ends):\n 214:             continue\n 215:         markers.append(m)\n 216:     return markers\n 217: \n 218: \n 219: def _record_candidates(\n 220:     H: int, W: int, kind: str, occupied: set[tuple[int, int]]\n 221: ) -> list[dict[str, object]]:\n 222:     \"\"\"Enumerate all valid component placements of the given kind that don't conflict with occupied.\"\"\"\n 223:     shape = (H, W)\n 224:     records: list[dict[str, object]] = []\n 225:     for center, gate_ends, inward, parallel_dirs in _gate_frames(H, W):\n 226:         parking = _add(center, inward)\n 227:         if not in_bounds(shape, *parking):\n 228:             continue\n---- generate_input head ----\n 347: def generate_input() -> np.ndarray:\n 348:     for _ in range(MAX_RETRIES):\n 349:         grid = _gen_attempt()\n 350:         if grid is not None:\n 351:             return grid\n 352:     raise RuntimeError(\"failed to generate valid 182e5d0f input\")\n\n","exit_code":0,"status":"completed"}}
