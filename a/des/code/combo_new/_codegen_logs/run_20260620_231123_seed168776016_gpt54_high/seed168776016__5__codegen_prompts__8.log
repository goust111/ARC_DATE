the color string written on the path is reversed between the endpoints.\n  59:     \"\"\"\n  60:     g = np.asarray(grid, dtype=int)\n  61:     bg = int(get_bg(g))\n  62:     components = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n  63:     assert len(components) == 1, \"expected exactly one foreground path\"\n  64: \n  65:     path = _ordered_path(components[0][\"coords\"])\n  66:     values = [int(g[r, c]) for r, c in path]\n  67: \n  68:     out = g.copy()\n  69:     for (r, c), value in zip(path, reversed(values)):\n  70:         out[r, c] = value\n  71:     return out\n  72: \n  73: # --------------- generator (att2, o5x) ---------------\n  74: \n  75: # Grid and path geometry.\n  76: GRID_SHAPE = (10, 10)\n  77: BG_COLOR = 8\n  78: INTERIOR_MIN = 1\n  79: INTERIOR_MAX = 8\n  80: PATH_LEN_MIN, PATH_LEN_MAX = 8, 28\n  81: TURN_COUNT_MIN, TURN_COUNT_MAX = 2, 8\n  82: SEGMENT_STEPS_MIN, SEGMENT_STEPS_MAX = 1, 7\n  83: \n  84: # Direction and color sampling.\n  85: DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n  86: PATH_COLORS = [1, 2, 4, 5, 6, 7, 9]\n  87: PALETTE_SIZE_MIN, PALETTE_SIZE_MAX = 6, 7\n  88: \n  89: # Generation retry budget.\n  90: MAX_GENERATION_ATTEMPTS = 300\n  91: \n  92: \n  93: def _turn_dirs(direction: tuple[int, int] | None) -> list[tuple[int, int]]:\n  94:     if direction is None:\n  95:         dirs = list(DIRS)\n  96:     else:\n  97:         dr, dc = direction\n  98:         dirs = [(-dc, dr), (dc, -dr)]\n  99:     random.shuffle(dirs)\n 100:     return dirs\n 101: \n 102: \n 103: def _sample_run_lengths(n_segments: int, total_steps: int) -> list[int]:\n 104:     runs = []\n 105:     remaining = total_steps\n 106:     for i in range(n_segments):\n 107:         slots = n_segments - i - 1\n 108:         lo = max(SEGMENT_STEPS_MIN, remaining - SEGMENT_STEPS_MAX * slots)\n 109:         hi = min(SEGMENT_STEPS_MAX, remaining - SEGMENT_STEPS_MIN * slots)\n 110:         runs.append(random.randint(lo, hi))\n 111:         remaining -= runs[-1]\n 112:     random.shuffle(runs)\n 113:     return runs\n 114: \n 115: \n 116: def _sample_run_plan() -> list[int]:\n 117:     target_len = random.randint(PATH_LEN_MIN, PATH_LEN_MAX)\n 118:     total_steps = target_len - 1\n 119:     valid_turns = [\n 120:         turns\n 121:         for turns in range(TURN_COUNT_MIN, TURN_COUNT_MAX + 1)\n 122:         if SEGMENT_STEPS_MIN * (turns + 1) <= total_steps <= SEGMENT_STEPS_MAX * (turns + 1)\n 123:     ]\n 124:     turns = random.choice(valid_turns)\n 125:     return _sample_run_lengths(turns + 1, total_steps)\n 126: \n 127: \n 128: def _extend_segment(\n 129:     path: list[tuple[int, int]],\n 130:     used: set[tuple[int, int]],\n 131:     direction: tuple[int, int],\n 132:     steps: int,\n 133: ) -> tuple[list[tuple[int, int]], set[tuple[int, int]]] | None:\n 134:     dr, dc = direction\n 135:     new_path = list(path)\n 136:     new_used = set(used)\n 137:     r, c = new_path[-1]\n 138: \n 139:     for _ in range(steps):\n 140:         nr, nc = r + dr, c + dc\n 141:         if not (INTERIOR_MIN <= nr <= INTERIOR_MAX and INTERIOR_MIN <= nc <= INTERIOR_MAX):\n 142:             return None\n 143:         if (nr, nc) in new_used:\n 144:             return None\n 145:         if any((ar, ac) in new_used and (ar, ac) != (r, c) for ar, ac in neighbors4(nr, nc)):\n 146:             return None\n 147: \n 148:         new_path.append((nr, nc))\n 149:         new_used.add((nr, nc))\n 150:         r, c = nr, nc\n 151: \n 152:     return new_path, new_used\n 153: \n 154: \n 155: def _build_path(run_lengths: list[int]) -> list[tuple[int, int]] | None:\n 156:     starts = [(r, c) for r in range(INTERIOR_MIN, INTERIOR_MAX + 1) for c in range(INTERIOR_MIN, INTERIOR_MAX + 1)]\n 157:     random.shuffle(starts)\n 158: \n 159:     def search(\n 160:         seg_i: int,\n 161:         prev_dir: tuple[int, int] | None,\n 162:         path: list[tuple[int, int]],\n 163:         used: set[tuple[int, int]],\n 164:     ) -> list[tuple[int, int]] | None:\n 165:         if seg_i == len(run_lengths):\n 166:             return path\n 167:         for direction in _turn_dirs(prev_dir):\n 168:             extended = _extend_segment(path, used, direction, run_lengths[seg_i])\n 169:             if extended is None:\n 170:                 continue\n 171:             found = search(seg_i + 1, direction, extended[0], extended[1])\n 172:             if found is not None:\n 173:                 return found\n 174:         return None\n 175: \n 176:     for start in starts:\n 177:         found = search(0, None, [start], {start})\n 178:         if found is not None:\n 179:             return found\n 180:     return None\n 181: \n 182: \n 183: def _color_sequence(n: int) -> list[int]:\n---- generate_input head ----\n 221: def generate_input() -> np.ndarray:\n 222:     for _ in range(MAX_GENERATION_ATTEMPTS):\n 223:         grid = _gen_attempt()\n 224:         if grid is not None:\n 225:             return grid\n 226:     raise RuntimeError(\"failed to generate valid 5792cb4d input\")\n\n===== f8f52ecc.py =====\n 106: def main(grid: np.ndarray) -> np.ndarray:\n 107:     \"\"\"\n 108:     Connect same-colored foreground components with one-cell-wide orthogonal paths around teal wall segments.\n 109: \n 110:     Input structure\n 111:     - The dominant color is the background.\n 112:     - Teal cells are fixed wall segments and are never source connectors.\n 113:     - Other foreground colors appear as one or more 4-connected components; colors with a single component stay unchanged.\n 114: \n 115:     Rule\n 116:     - For each non-background, non-teal color, read its 4-connected components in row-major order.\n 117:     - Connect each consecutive pair by the shortest clear L-shaped path between the two components.\n 118:     - Clear paths may pass only through background or the same color, and they preserve the previous travel axis when both bends are possible.\n 119: \n 120:     Key insight\n 121:     - The output is not a global recolor: each color traces a routed chain through its own components while teal cells and other colors act as blockers.\n 122:     \"\"\"\n 123:     g = np.asarray(grid, dtype=int)\n 124:     bg = get_bg(g)\n 125:     wall = Color.TEAL\n 126:     assert np.any(g == wall), \"expected teal wall cells\"\n 127: \n 128:     out = g.copy()\n 129:     connected_color_count = 0\n 130:     for color in _source_colors(g, bg, wall):\n 131:         comps = [\n 132:             comp[\"coords\"]\n 133:             for comp in find_components(\n 134:                 g,\n 135:                 bg=bg,\n 136:                 connectivity=4,\n 137:                 monochromatic=True,\n 138:                 colors=[color],\n 139:             )\n 140:         ]\n 141:         comps.sort(key=lambda coords: tuple(map(int, coords.min(axis=0))))\n 142:         if len(comps) < 2:\n 143:             continue\n 144:         if len(comps) == 2 and len(comps[0]) == 1 and len(comps[1]) == 1:\n 145:             a = tuple(map(int, comps[0][0]))\n 146:             b = tuple(map(int, comps[1][0]))\n 147:             if a[0] != b[0] and a[1] != b[1]:\n 148:                 h_clear = _clear(_path_cells(a, b, \"h\"), g, bg, color)\n 149:                 v_clear = _clear(_path_cells(a, b, \"v\"), g, bg, color)\n 150:                 assert not (h_clear and v_clear), \"two diagonal singleton components need a blocking obstacle\"\n 151: \n 152:         connected_color_count += 1\n 153:         previous_axis: str | None = None\n 154:         for comp_a, comp_b in zip(comps, comps[1:]):\n 155:             path, previous_axis = _connector_path(comp_a, comp_b, out, bg, color, previous_axis)\n 156:             for r, c in path:\n 157:                 assert int(out[r, c]) in (bg, color), \"connector collision with another color\"\n 158:                 out[r, c] = color\n 159: \n 160:     assert connected_color_count > 0, \"expected at least one color with multiple components\"\n 161:     return out\n 162: \n 163: # --------------- generator (c) ---------------\n 164: \n 165: BG = Color.BLUE\n 166: WALL = Color.TEAL\n 167: \n 168: # Palette.\n 169: N_COLORS = 10\n 170: ALL_COLORS = [c for c in range(N_COLORS) if c not in (BG, WALL)]\n 171: \n 172: # Canvas sizing.\n 173: MIN_ROWS = 8\n 174: MAX_ROWS = 12\n 175: MIN_COLS = 10\n 176: MAX_COLS = 12\n 177: LARGE_GRID_CONNECTABLE_THRESHOLD = 3\n 178: LARGE_GRID_MIN_ROWS = 10\n 179: LARGE_GRID_MIN_COLS = 11\n 180: \n 181: # Foreground object counts and component sizes.\n 182: MIN_CONNECTABLE_COLORS = 1\n 183: MAX_CONNECTABLE_COLORS = 4\n 184: MIN_DISTRACTOR_COLORS = 0\n 185: MAX_DISTRACTOR_COLORS = 4\n 186: MIN_CHAIN_COMPONENTS = 2\n 187: MAX_CHAIN_COMPONENTS = 4\n 188: BLOB_SIZE_CHOICES = [1, 2, 3]\n 189: BLOB_SIZE_WEIGHTS = [6, 3, 1]\n 190: \n 191: # Wall geometry.\n 192: MIN_WALL_SEGMENTS = 1\n 193: MAX_WALL_SEGMENTS = 2\n 194: WALL_ROW_BORDER = 1\n 195: WALL_ROW_GAP = 1\n 196: MIN_WALL_LENGTH = 1\n 197: MAX_WALL_LENGTH = 8\n 198: \n 199: # Validation and retry limits.\n 200: BLOB_PLACEMENT_ATTEMPTS = 80\n 201: DISTRACTOR_PLACEMENT_ATTEMPTS = 50\n 202: GENERATION_ATTEMPTS = 300\n 203: MAX_PATH_CELLS = 25\n 204: MIN_BG_PCT = 79\n 205: MAX_BG_PCT = 90\n 206: \n 207: AXES = (\"h\", \"v\")\n 208: CARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n 209: ConnectorOption = tuple[str, list[Coord], Coord, Coord]\n 210: \n 211: \n 212: def _gen_source_colors(g: np.ndarray, bg: int, wall: int) -> list[int]:\n 213:     colors: list[int] = []\n 214:     seen = {int(bg), int(wall)}\n 215:     for raw in g.ravel():\n 216:         color = int(raw)\n 217:         if color not in seen:\n 218:             seen.add(color)\n 219:             colors.append(color)\n 220:     return colors\n 221: \n 222: \n 223: def _gen_path_has_marker(\n 224:     output: np.ndarray,\n 225:     color: int,\n 226:     path: list[Coord],\n 227:     start: Coord,\n 228:     stop: Coord,\n 229: ) -> bool:\n 230:     endpoints = {start, stop}\n 231:     return any((r, c) not in endpoints and int(output[r, c]) == color for r, c in path)\n 232: \n 233: \n 234: def _gen_path_cells(start: Coord, stop: Coord, first_axis: str) -> list[Coord]:\n 235:     r0, c0 = start\n 236:     r1, c1 = stop\n 237:     pts: list[Coord] = []\n 238: \n 239:     if first_axis == \"h\":\n 240:         c_step = 1 if c1 >= c0 else -1\n 241:         for c in range(c0, c1 + c_step, c_step):\n 242:             pts.append((r0, c))\n 243:         r_step = 1 if r1 >= r0 else -1\n 244:         for r in range(r0 + r_step, r1 + r_step, r_step):\n 245:             pts.append((r, c1))\n 246:         return pts\n---- generate_input head ----\n 599: def generate_input() -> np.ndarray:\n 600:     \"\"\"Generate a valid input grid for task f8f52ecc.\"\"\"\n 601:     for _ in range(GENERATION_ATTEMPTS):\n 602:         result = _gen_attempt()\n 603:         if result is not None:\n 604:             return result\n 605:     raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n\n===== d35bdbdc.py =====\n 119: def main(grid: np.ndarray) -> np.ndarray:\n 120:     \"\"\"\n 121:     Transfer center colors between bordered sprites matched by color, keeping only path-connected ones.\n 122: \n 123:     Input structure:\n 124:     - bg, grey (5) path network, and several small \"bordered sprites\" each having a border color and a single center pixel of a different color.\n 125:     - Grey path forms a one-stroke trail under 8-connectivity; its start/end cells touch exactly two destination sprites via ports.\n 126: \n 127:     Rule:\n 128:     - Destination sprites are determined by the grey trail's two endpoints.\n 129:     - For each destination, find the source sprite whose border color equals the destination's center color.\n 130:     - Replace the destination's center pixel with the source's center color.\n 131:     - Delete all non-destination sprites; grey paths and destinations remain.\n 132: \n 133:     Key insight: Center color of each destination acts as a lookup key into the border colors of other sprites, enabling indirect color transfer.\n 134:     \"\"\"\n 135:     g = np.asarray(grid, dtype=int)\n 136:     bg = _bg_boundary(g)\n 137:     grey = 5\n 138: \n 139:     sprites = _detect_bordered_sprites(g, bg, grey)\n 140:     assert sprites, \"expected at least one bordered sprite in the grid\"\n 141: \n 142:     # Trail endpoints determine the 2 destination sprites (no color tiebreaking).\n 143:     te1, te2 = _find_trail_endpoints(g, grey, sprites)\n 144:     trail_eps = {te1, te2}\n 145: \n 146:     eps_pair = [te1, te2]\n 147:     opts = {ep: [sp for sp in sprites if ep in _ports_for_sprite(sp, g, trail_eps)]\n 148:             for ep in eps_pair}\n 149: \n 150:     # Bipartite match: fewer-options-first; tiebreak by sprite farthest from OTHER endpoint\n 151:     dest: list[dict] = [None, None]  # type: ignore[list-item]\n 152:     order = [0, 1] if len(opts[te1]) <= len(opts[te2]) else [1, 0]\n 153:     used: set[int] = set()\n 154:     for i in order:\n 155:         ep = eps_pair[i]\n 156:         other = eps_pair[1 - i]\n 157:         cands = [sp for sp in opts[ep] if id(sp) not in used]\n 158:         best = max(cands, key=lambda sp: abs(sp[\"center_pos\"][0] - other[0])\n 159:                    + abs(sp[\"center_pos\"][1] - other[1]))\n 160:         dest[i] = best\n 161:         used.add(id(best))\n 162:     assert all(d is not None for d in dest), \"expected exactly 2 dest sprites from trail endpoints\"\n 163:     dest_ids = {id(sp) for sp in dest}\n 164: \n 165:     # Build border->sprites lookup (using original input attributes).\n 166:     by_border: dict[int, list[dict]] = {}\n 167:     for sp in sprites:\n 168:         by_border.setdefault(int(sp[\"border\"]), []).append(sp)\n 169: \n 170:     out = g.copy()\n 171: \n 172:     # Delete all non-destination sprites completely.\n 173:     for sp in sprites:\n 174:         if id(sp) in dest_ids:\n 175:             continue\n 176:         for r, c in sp[\"pts\"]:\n 177:             out[r, c] = bg\n 178: \n 179:     # Also delete any remaining non-grey, non-bg pixels not connected to a destination sprite.\n 180:     # (Some instances contain extra non-sprite components that are removed in the output.)\n 181:     keep = np.zeros(out.shape, dtype=bool)\n 182:     q: list[tuple[int, int]] = []\n 183:     for d in dest:\n 184:         for r, c in d[\"pts\"]:\n 185:             if out[r, c] != bg and out[r, c] != grey and not keep[r, c]:\n 186:                 keep[r, c] = True\n 187:                 q.append((r, c))\n 188:     while q:\n 189:         r, c = q.pop()\n 190:         for nr, nc in neighbors4(r, c):\n 191:             if 0 <= nr < out.shape[0] and 0 <= nc < out.shape[1]:\n 192:                 if keep[nr, nc]:\n 193:                     continue\n 194:                 if out[nr, nc] == bg or out[nr, nc] == grey:\n 195:                     continue\n 196:                 keep[nr, nc] = True\n 197:                 q.append((nr, nc))\n 198:     drop = (out != bg) & (out != grey) & (~keep)\n 199:     out[drop] = bg\n 200: \n 201:     # Update destination centers by matching their original center color to a source sprite border.\n 202:     for d in dest:\n 203:         want_border = int(d[\"center\"])\n 204:         srcs = by_border.get(want_border, [])\n 205:         if not srcs:\n 206:             continue\n 207:         assert len(srcs) == 1, \"each destination color should match at most one source border\"\n 208:         src = srcs[0]\n 209:         dr, dc = d[\"center_pos\"]\n 210:         out[dr, dc] = int(src[\"center\"])\n 211: \n 212:     return out\n 213: \n 214: # --------------- generator (c) ---------------\n 215: \n 216: from arc_utils import paste\n 217: \n 218: # ── CFG: tunable generation parameters ──────────────────────────────\n 219: GRID_H, GRID_W = 10, 10                    # canvas size\n 220: BG, GREY = 0, 5                            # background and path colors\n 221: SPRITE_COUNTS = [4, 5]                      # number of sprites per example\n 222: SOURCE_COUNTS = [1, 2]                      # possible number of source sprites\n 223: INTERIOR_DEST_WEIGHTS = [3, 1]              # weights for [0, 1] interior dests\n 224: PATH_LEN_MIN, PATH_LEN_MAX = 10, 24        # grey trail length bounds\n 225: MIN_PORT_DIST_FRAC = 3                      # min_port_dist = max(3, target_len // this)\n 226: MAX_THICKNESS = 3                           # max 8-neighbor degree for path cells\n 227: PATH_WANDER_AWAY_P = 0.5                    # P(choose away-moves) when budget is large\n 228: PATH_WANDER_DIAG_P = 0.6                    # P(prefer diagonal) in wander/moderate phases\n 229: PATH_MODERATE_RANDOM_P = 0.3               # P(random move) in moderate-budget phase\n 230: GEN_RETRIES = 300                           # outer retry limit\n 231: \n 232: \n 233: def _make_sprite_patch(shape_type, border_color, center_color):\n 234:     \"\"\"Return 3x3 patch for a box or plus. Center is at (1,1).\"\"\"\n 235:     if shape_type == 'box':\n 236:         p = np.full((3, 3), border_color, dtype=int)\n 237:     else:  # plus\n 238:         p = np.zeros((3, 3), dtype=int)\n 239:         for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n 240:             p[1 + dr, 1 + dc] = border_color\n 241:     p[1, 1] = center_color\n 242:     return p\n 243: \n 244: \n 245: def _place_sprite(grid, patch, r0, c0):\n 246:     \"\"\"Place patch cells on grid, skipping transparent (0) and out-of-bounds.\"\"\"\n 247:     paste(grid, patch, r0, c0, transparent=BG, clip=True)\n 248: \n 249: \n 250: def _erase_sprite(grid, patch, r0, c0):\n 251:     \"\"\"Undo a _place_sprite by zeroing non-transparent patch cells.\"\"\"\n 252:     H, W = grid.shape\n 253:     for dr in range(3):\n 254:         for dc in range(3):\n 255:             rr, cc = r0 + dr, c0 + dc\n 256:             if 0 <= rr < H and 0 <= cc < W and patch[dr, dc] != 0:\n 257:                 grid[rr, cc] = BG\n 258: \n 259: \n---- generate_input head ----\n 582: def generate_input():\n 583:     for _ in range(GEN_RETRIES):\n 584:         result = _gen_attempt()\n 585:         if result is not None:\n 586:             return result\n 587:     raise RuntimeError(f\"Failed to generate input after {GEN_RETRIES} attempts\")\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/3ad05f52.py',\n'/home/lixinyu/snap/new/ARC_code/eval/136b0064.py',\n'/home/lixinyu/snap/new/ARC_code/train/342ae2ed.py',\n'/home/lixinyu/snap/new/ARC_code/train/182e5d0f.py',\n]\nfor path in files:\n    print(f'===== {Path(path).name} =====')\n    lines = Path(path).read_text().splitlines()\n    def dump(start, end):\n        for i in range(start-1, min(end, len(lines))):\n            print(f'{i+1:4}: {lines[i]}')\n    starts = {}\n    for i,l in enumerate(lines,1):\n        if l.startswith('def main'):\n            starts['main']=i\n        if l.startswith('def generate_input'):\n            starts['gen']=i\n    dump(starts['main'], min(starts['gen']-1, starts['main']+140))\n    print('---- generate_input head ----')\n    dump(starts['gen'], min(len(lines), starts['gen']+180))\n    print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
