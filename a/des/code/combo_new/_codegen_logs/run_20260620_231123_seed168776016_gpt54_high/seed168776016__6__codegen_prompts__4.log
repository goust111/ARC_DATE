{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/14b8e18c.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/\"'^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/14b8e18c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Mark every complete square object with red pixels just outside its corners.\n\n    Input structure:\n    - A uniform background contains one or more monochrome 4-connected foreground objects.\n    - The relevant objects are square frames or filled squares: their bbox is square\n      and all cells on the bbox border have the object's color.\n    - Non-square bars and incomplete fragments may also appear and are ignored.\n\n    Rule:\n    - Keep the input unchanged.\n    - For each complete square object, paint red on the two outside background\n      pixels orthogonally adjacent to each of the square's four corners.\n\n    Key insight: The transformation is not based on size or color; it selects\n    objects whose bounding box is a complete square border and labels only their\n    exposed outer corner-adjacent cells.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    out = g.copy()\n\n    square_objects = [\n        obj\n        for obj in find_components(g, bg=bg, connectivity=4, monochromatic=True)\n        if _has_complete_square_border(g, obj)\n    ]\n    assert square_objects, \"expected at least one complete square object\"\n\n    for obj in square_objects:\n        coords = _corner_marker_coords(obj[\"bbox\"])\n        for r, c in coords:\n            assert in_bounds(g.shape, r, c), \"square object should have one-cell outside margin\"\n            assert int(g[r, c]) == int(bg), \"corner marker positions should be background\"\n            out[r, c] = Color.RED\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# ---- Configuration ----\nGRID_H, GRID_W = 10, 10\nBG_COLOR = Color.ORANGE                       # background color (7)\nFG_COLORS = [Color.PINK, Color.TEAL]          # foreground color choices\nSQUARE_COUNT_RANGE = [1, 2, 3, 4]             # number of squares to attempt\nSQUARE_SIZE_MIN = 2                            # minimum square side length\nMAX_SZ_BY_COUNT = {1: 8, 2: 6, 3: 5, 4: 4}   # max square size per count\nEDGE_MARGIN = 1                                # min gap from grid edge for squares\nDISTRACTOR_COUNT_MAX = 5                       # max distractor objects\nDISTRACTOR_TYPES = ['pixel', 'hbar', 'vbar', 'rect']\nDISTRACTOR_BAR_RANGE = (2, 4)                  # bar/rect dimension range\nDISTRACTOR_PLACE_RETRIES = 80                  # retries per distractor placement\nGEN_MAX_RETRIES = 300                          # outer generate_input retry limit\n\n\n\n---GEN---\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_MAX_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate input after %d attempts\" % GEN_MAX_RETRIES)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/d968ffd4.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/\"'^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/d968ffd4.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/d968ffd4.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/\"'^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/d968ffd4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Extend each of two aligned rectangular marker objects toward the other, filling half of the gap across the full perpendicular span.\n\n    Input structure\n    - A dominant background contains exactly two solid, same-sized monochromatic rectangles.\n    - The rectangles share either the same row span or the same column span, with a background gap between their facing edges.\n\n    Rule\n    - If the rectangles are side-by-side, color the left half of the inter-object gap across every row with the left object's color, and the right half with the right object's color.\n    - If one rectangle is above the other, color the upper half of the gap across every column with the upper object's color, and the lower half with the lower object's color.\n    - When the gap length is odd, leave the center row/column as background.\n\n    Key insight\n    - The marker objects are endpoints of an axial corridor; their own size identifies the facing edge, while the filled corridor spans the whole grid perpendicular to that axis.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(comps) == 2\n    assert all(_is_solid_rect(g, comp) for comp in comps)\n\n    a, b = comps\n    ar0, ac0, ar1, ac1 = a[\"bbox\"]\n    br0, bc0, br1, bc1 = b[\"bbox\"]\n    assert (ar1 - ar0, ac1 - ac0) == (br1 - br0, bc1 - bc0)\n\n    same_rows = (ar0, ar1) == (br0, br1)\n    same_cols = (ac0, ac1) == (bc0, bc1)\n    assert same_rows != same_cols\n\n    out = g.copy()\n    if same_rows:\n        left, right = sorted(comps, key=lambda comp: comp[\"bbox\"][1])\n        _lr0, _lc0, _lr1, lc1 = left[\"bbox\"]\n        _rr0, rc0, _rr1, _rc1 = right[\"bbox\"]\n        gap = rc0 - lc1 - 1\n        assert gap >= 1\n        span = gap // 2\n        out[:, lc1 + 1 : lc1 + 1 + span] = left[\"color\"]\n        out[:, rc0 - span : rc0] = right[\"color\"]\n    else:\n        top, bottom = sorted(comps, key=lambda comp: comp[\"bbox\"][0])\n        _tr0, _tc0, tr1, _tc1 = top[\"bbox\"]\n        br0, _bc0, _br1, _bc1 = bottom[\"bbox\"]\n        gap = br0 - tr1 - 1\n        assert gap >= 1\n        span = gap // 2\n        out[tr1 + 1 : tr1 + 1 + span, :] = top[\"color\"]\n        out[br0 - span : br0, :] = bottom[\"color\"]\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Layout ranges and bounds.\nALIGNMENTS = (\"H\", \"V\")\nRECT_PERP_BOUNDS = (1, 4)\nRECT_AXIAL_VALUES = range(1, 3)\nGAP_VALUES = range(6, 17)\nAXIAL_BOUNDS = (14, 22)\nMARGIN = 1\nPALETTE = tuple(range(10))\nMAX_GENERATION_ATTEMPTS = 300\nVALID_AXIAL_GAP_PAIRS = tuple(\n    (rect_axial, gap)\n    for rect_axial in RECT_AXIAL_VALUES\n    for gap in GAP_VALUES\n    if AXIAL_BOUNDS[0] <= 2 * rect_axial + gap + 2 * MARGIN <= AXIAL_BOUNDS[1]\n)\n\n\n\n---GEN---\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid d968ffd4 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/\"'^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/\"'^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n\n    Input structure:\n    - The grid has a dominant background color.\n    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n\n    Rule:\n    - Keep the input pixels unchanged.\n    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n\n    Key insight:\n    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    out = g.copy()\n    h, w = g.shape\n\n    markers: dict[int, int] = {}\n    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n            continue\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n        source = int(sub[0, 0])\n        halo = int(sub[0, 1])\n        assert source != halo, \"legend source and halo colors must differ\"\n        assert source not in markers, \"each source color must have exactly one legend marker\"\n\n        markers[source] = halo\n        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n\n    assert markers, \"expected at least one left-edge legend marker\"\n\n    for source, halo in markers.items():\n        objects = []\n        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n            if cells <= marker_source_cells[source]:\n                continue\n            objects.append(comp)\n        assert objects, \"each legend source color must label at least one non-marker object\"\n\n        for obj in objects:\n            r0, c0, r1, c1 = obj[\"bbox\"]\n            pr0 = max(0, int(r0) - 1)\n            pc0 = max(0, int(c0) - 1)\n            pr1 = min(h - 1, int(r1) + 1)\n            pc1 = min(w - 1, int(c1) + 1)\n\n            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n            coords = obj[\"coords\"]\n            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n            enclosed = object_interior(patch, background=bg)\n            fill_mask = (patch == bg) & ~enclosed\n\n            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n            target[fill_mask] = halo\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and color palette.\nBACKGROUND = 0\nGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\nAVAILABLE_COLORS = tuple(range(1, 10))\n\n# Legend layout.\nLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\nLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n\n# Sprite geometry and acceptance.\nSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\nSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\nSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\nSPRITE_RETRIES = 300\n\n# Object counts and placement.\nINSTANCE_MIN, INSTANCE_MAX = 1, 3\nOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\nEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\nPLACEMENT_RETRIES = 200\n\n# Whole-sample retry budget.\nGENERATION_RETRIES = 300\n\n\n\n---GEN---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
