{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/a/des/code/combo/seed1544388365/3/6.py\"","aggregated_output":"from __future__ import annotations\n\nimport random\nimport numpy as np\n\n\nCoord = tuple[int, int]\nDirection = tuple[int, int]\n\n\nBG = 0\nCOLOR_POOL = (1, 2, 3, 4, 5, 6, 7, 8, 9)\nDIRS: tuple[Direction, ...] = ((-1, 0), (0, 1), (1, 0), (0, -1))\n\nGRID_H_RANGE = (10, 18)\nGRID_W_RANGE = (10, 18)\nPAIR_COUNT_RANGE = (2, 5)\nPAIR_DENSITY = 45\nMIN_RAY_LEN = 3\nMAX_RAY_LEN = 9\nAXIS_MIX_PROB = 0.65\nCROSSING_PROB = 0.55\nSCENE_ATTEMPTS = 300\nPAIR_ATTEMPTS = 120\nCROSSING_ATTEMPTS = 120\n\n\ndef _perp(direction: Direction) -> Direction:\n    dr, _dc = direction\n    return (0, 1) if dr else (1, 0)\n\n\ndef _in_bounds(shape: tuple[int, int], cell: Coord) -> bool:\n    r, c = cell\n    return 0 <= r < shape[0] and 0 <= c < shape[1]\n\n\ndef _arrow_cells(tip: Coord, direction: Direction) -> list[Coord]:\n    r, c = tip\n    dr, dc = direction\n    pr, pc = _perp(direction)\n    return [\n        (r, c),\n        (r - dr + pr, c - dc + pc),\n        (r - dr - pr, c - dc - pc),\n    ]\n\n\ndef _ray_distance(tip: Coord, direction: Direction, cell: Coord) -> int | None:\n    tr, tc = tip\n    cr, cc = cell\n    dr, dc = direction\n    if dr != 0:\n        if cc != tc:\n            return None\n        delta = cr - tr\n        if delta * dr <= 0:\n            return None\n        return abs(delta)\n    if cr != tr:\n        return None\n    delta = cc - tc\n    if delta * dc <= 0:\n        return None\n    return abs(delta)\n\n\ndef _ray_cells(tip: Coord, target: Coord, direction: Direction) -> list[Coord]:\n    dist = _ray_distance(tip, direction, target)\n    assert dist is not None, \"target must lie on the forward ray\"\n    dr, dc = direction\n    r, c = tip\n    return [(r + dr * step, c + dc * step) for step in range(1, dist)]\n\n\ndef _build_pair(color: int, tip: Coord, direction: Direction, target: Coord) -> dict[str, object]:\n    arrow = _arrow_cells(tip, direction)\n    return {\n        \"color\": int(color),\n        \"tip\": (int(tip[0]), int(tip[1])),\n        \"direction\": (int(direction[0]), int(direction[1])),\n        \"target\": (int(target[0]), int(target[1])),\n        \"arrow\": tuple(arrow),\n        \"object_cells\": tuple(arrow + [target]),\n        \"ray\": tuple(_ray_cells(tip, target, direction)),\n    }\n\n\ndef _decode_pair(color: int, coords: np.ndarray) -> dict[str, object]:\n    positions = {tuple(map(int, rc)) for rc in coords}\n    assert len(positions) == 4, \"each color must contain exactly one emitter and one target\"\n\n    candidates: list[dict[str, object]] = []\n    for tip in sorted(positions):\n        for direction in DIRS:\n            arrow = set(_arrow_cells(tip, direction))\n            if not arrow.issubset(positions):\n                continue\n            others = positions - arrow\n            if len(others) != 1:\n                continue\n            target = next(iter(others))\n            if _ray_distance(tip, direction, target) is None:\n                continue\n            candidates.append(_build_pair(color, tip, direction, target))\n\n    assert len(candidates) == 1, \"every color must decode to one arrow-target pair\"\n    return candidates[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Find each 3-pixel arrow emitter, infer its facing direction, and paint a\n    ray from the tip until the same-color target pixel.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    pairs = []\n    for color in np.unique(g):\n        color = int(color)\n        if color == BG:\n            continue\n        pairs.append(_decode_pair(color, np.argwhere(g == color)))\n\n    out = g.copy()\n    for pair in sorted(pairs, key=lambda item: item[\"tip\"]):\n        for r, c in pair[\"ray\"]:\n            out[r, c] = int(pair[\"color\"])\n    return out\n\n\ndef _cells_clear(shape: tuple[int, int], cells: list[Coord], occupied: set[Coord]) -> bool:\n    for cell in cells:\n        if not _in_bounds(shape, cell):\n            return False\n        r, c = cell\n        for rr in range(r - 1, r + 2):\n            for cc in range(c - 1, c + 2):\n                if (rr, cc) in occupied:\n                    return False\n    return True\n\n\ndef _choose_length(max_len: int, prefer_long: bool) -> int:\n    assert max_len >= MIN_RAY_LEN\n    if not prefer_long or max_len == MIN_RAY_LEN:\n        return random.randint(MIN_RAY_LEN, max_len)\n    long_lo = max(MIN_RAY_LEN, (MIN_RAY_LEN + max_len) // 2)\n    if random.random() < 0.7:\n        return random.randint(long_lo, max_len)\n    return random.randint(MIN_RAY_LEN, max_len)\n\n\ndef _sample_directions(count: int, require_axis_mix: bool) -> list[Direction]:\n    if count == 0:\n        return []\n    if not require_axis_mix or count == 1:\n        return [random.choice(DIRS) for _ in range(count)]\n\n    vertical = [(-1, 0), (1, 0)]\n    horizontal = [(0, -1), (0, 1)]\n    dirs = [random.choice(vertical), random.choice(horizontal)]\n    while len(dirs) < count:\n        dirs.append(random.choice(DIRS))\n    random.shuffle(dirs)\n    return dirs\n\n\ndef _sample_free_pair(\n    shape: tuple[int, int],\n    color: int,\n    direction: Direction,\n    occupied: set[Coord],\n    *,\n    prefer_long: bool,\n) -> dict[str, object] | None:\n    H, W = shape\n    dr, dc = direction\n\n    for _ in range(PAIR_ATTEMPTS):\n        if (dr, dc) == (-1, 0):\n            if H < MIN_RAY_LEN + 2 or W < 3:\n                return None\n            tip = (random.randint(MIN_RAY_LEN, H - 2), random.randint(1, W - 2))\n            max_len = min(MAX_RAY_LEN, tip[0])\n        elif (dr, dc) == (1, 0):\n            if H < MIN_RAY_LEN + 2 or W < 3:\n                return None\n            tip = (random.randint(1, H - 1 - MIN_RAY_LEN), random.randint(1, W - 2))\n            max_len = min(MAX_RAY_LEN, H - 1 - tip[0])\n        elif (dr, dc) == (0, 1):\n            if W < MIN_RAY_LEN + 2 or H < 3:\n                return None\n            tip = (random.randint(1, H - 2), random.randint(1, W - 1 - MIN_RAY_LEN))\n            max_len = min(MAX_RAY_LEN, W - 1 - tip[1])\n        else:\n            assert (dr, dc) == (0, -1)\n            if W < MIN_RAY_LEN + 2 or H < 3:\n                return None\n            tip = (random.randint(1, H - 2), random.randint(MIN_RAY_LEN, W - 2))\n            max_len = min(MAX_RAY_LEN, tip[1])\n\n        if max_len < MIN_RAY_LEN:\n            continue\n        length = _choose_length(max_len, prefer_long)\n        target = (tip[0] + dr * length, tip[1] + dc * length)\n        pair = _build_pair(color, tip, direction, target)\n        cells = list(pair[\"object_cells\"])\n        if _cells_clear(shape, cells, occupied):\n            return pair\n    return None\n\n\ndef _split_choices(before_max: int, after_max: int) -> list[tuple[int, int]]:\n    choices = []\n    for before in range(1, before_max + 1):\n        for after in range(1, after_max + 1):\n            total = before + after\n            if MIN_RAY_LEN <= total <= MAX_RAY_LEN:\n                choices.append((before, after))\n    return choices\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/a/des/code/eval/seed2051249879/3/2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/a/des/code/eval/seed2051249879/3/2.py\"","aggregated_output":"from __future__ import annotations\n\nimport random\nfrom typing import Iterable\n\nimport numpy as np\n\n\nMAROON = 9\nDIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\nALL_DIRS = [\"U\", \"D\", \"L\", \"R\"]\n\n\ndef _get_bg(grid: np.ndarray) -> int:\n    values, counts = np.unique(grid, return_counts=True)\n    return int(values[int(np.argmax(counts))])\n\n\ndef _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:\n    h, w = mask.shape\n    seen = np.zeros_like(mask, dtype=bool)\n    out: list[list[tuple[int, int]]] = []\n    for r in range(h):\n        for c in range(w):\n            if not mask[r, c] or seen[r, c]:\n                continue\n            stack = [(r, c)]\n            seen[r, c] = True\n            coords: list[tuple[int, int]] = []\n            while stack:\n                rr, cc = stack.pop()\n                coords.append((rr, cc))\n                for dr, dc in DIR4:\n                    nr, nc = rr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n                        seen[nr, nc] = True\n                        stack.append((nr, nc))\n            out.append(coords)\n    return out\n\n\ndef _bbox(coords: Iterable[tuple[int, int]]) -> tuple[int, int, int, int]:\n    pts = list(coords)\n    rows = [r for r, _c in pts]\n    cols = [c for _r, c in pts]\n    return min(rows), min(cols), max(rows), max(cols)\n\n\ndef _parse_arrow(coords: list[tuple[int, int]]) -> dict[str, object]:\n    r0, c0, r1, c1 = _bbox(coords)\n    h = r1 - r0 + 1\n    w = c1 - c0 + 1\n    rel = {(r - r0, c - c0) for r, c in coords}\n    choices: list[dict[str, object]] = []\n\n    if h == 3 and w >= 3 and len(rel) == w + 2:\n        row_counts = [sum((rr, cc) in rel for cc in range(w)) for rr in range(3)]\n        if row_counts == [1, w, 1]:\n            head_cols = []\n            for rr in (0, 2):\n                cols = [cc for cc in range(w) if (rr, cc) in rel]\n                if len(cols) == 1:\n                    head_cols.append(cols[0])\n            if len(head_cols) == 2 and head_cols[0] == head_cols[1] and head_cols[0] in (0, w - 1):\n                direction = \"L\" if head_cols[0] == 0 else \"R\"\n                tail_rel = (1, w - 1) if direction == \"L\" else (1, 0)\n                head_rel = (1, 0) if direction == \"L\" else (1, w - 1)\n                choices.append(\n                    {\n                        \"dir\": direction,\n                        \"tail\": (r0 + tail_rel[0], c0 + tail_rel[1]),\n                        \"head\": (r0 + head_rel[0], c0 + head_rel[1]),\n                        \"pixels\": set(coords),\n                    }\n                )\n\n    if w == 3 and h >= 3 and len(rel) == h + 2:\n        col_counts = [sum((rr, cc) in rel for rr in range(h)) for cc in range(3)]\n        if col_counts == [1, h, 1]:\n            head_rows = []\n            for cc in (0, 2):\n                rows = [rr for rr in range(h) if (rr, cc) in rel]\n                if len(rows) == 1:\n                    head_rows.append(rows[0])\n            if len(head_rows) == 2 and head_rows[0] == head_rows[1] and head_rows[0] in (0, h - 1):\n                direction = \"U\" if head_rows[0] == 0 else \"D\"\n                tail_rel = (h - 1, 1) if direction == \"U\" else (0, 1)\n                head_rel = (0, 1) if direction == \"U\" else (h - 1, 1)\n                choices.append(\n                    {\n                        \"dir\": direction,\n                        \"tail\": (r0 + tail_rel[0], c0 + tail_rel[1]),\n                        \"head\": (r0 + head_rel[0], c0 + head_rel[1]),\n                        \"pixels\": set(coords),\n                    }\n                )\n\n    assert len(choices) == 1, \"expected one valid maroon arrow shape\"\n    return choices[0]\n\n\ndef _find_objects(grid: np.ndarray, bg: int) -> list[dict[str, object]]:\n    objects: list[dict[str, object]] = []\n    colors = sorted(int(color) for color in np.unique(grid) if int(color) not in (bg, MAROON))\n    next_id = 0\n    for color in colors:\n        for coords in _components(grid == color):\n            r0, c0, r1, c1 = _bbox(coords)\n            h = r1 - r0 + 1\n            w = c1 - c0 + 1\n            assert h == w and h in (2, 3), \"objects must be solid 2x2 or 3x3 squares\"\n            assert len(coords) == h * w, \"objects must be solid rectangles\"\n            objects.append(\n                {\n                    \"id\": next_id,\n                    \"color\": int(color),\n                    \"r0\": int(r0),\n                    \"c0\": int(c0),\n                    \"r1\": int(r1),\n                    \"c1\": int(c1),\n                }\n            )\n            next_id += 1\n    assert objects, \"expected at least one object\"\n    return objects\n\n\ndef _match_endpoint(\n    objects: list[dict[str, object]], direction: str, tail: tuple[int, int], head: tuple[int, int]\n) -> tuple[int, int]:\n    tr, tc = tail\n    hr, hc = head\n    if direction == \"R\":\n        src = [obj for obj in objects if obj[\"c1\"] == tc - 1 and obj[\"r0\"] <= tr <= obj[\"r1\"]]\n        dst = [obj for obj in objects if obj[\"c0\"] == hc + 1 and obj[\"r0\"] <= hr <= obj[\"r1\"]]\n    elif direction == \"L\":\n        src = [obj for obj in objects if obj[\"c0\"] == tc + 1 and obj[\"r0\"] <= tr <= obj[\"r1\"]]\n        dst = [obj for obj in objects if obj[\"c1\"] == hc - 1 and obj[\"r0\"] <= hr <= obj[\"r1\"]]\n    elif direction == \"D\":\n        src = [obj for obj in objects if obj[\"r1\"] == tr - 1 and obj[\"c0\"] <= tc <= obj[\"c1\"]]\n        dst = [obj for obj in objects if obj[\"r0\"] == hr + 1 and obj[\"c0\"] <= hc <= obj[\"c1\"]]\n    else:\n        src = [obj for obj in objects if obj[\"r0\"] == tr + 1 and obj[\"c0\"] <= tc <= obj[\"c1\"]]\n        dst = [obj for obj in objects if obj[\"r1\"] == hr - 1 and obj[\"c0\"] <= hc <= obj[\"c1\"]]\n    assert len(src) == 1 and len(dst) == 1, \"each arrow endpoint must touch exactly one object\"\n    return int(src[0][\"id\"]), int(dst[0][\"id\"])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Follow each maroon arrow chain and recolor every non-head object with the head color.\n\n    Input structure:\n    - The background is the most common color.\n    - Non-background, non-maroon objects are separate solid 2x2 or 3x3 squares.\n    - Each maroon component is one straight arrow with a triangular head.\n\n    Rule:\n    - Reconstruct the directed graph from arrow direction and endpoint contacts.\n    - For every chain head (object with no incoming arrow), broadcast its color to\n      all later objects in the chain.\n    - Erase all maroon arrows in the output.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    bg = _get_bg(g)\n    assert bg != MAROON, \"background must differ from maroon arrow color\"\n\n    objects = _find_objects(g, bg)\n    arrows = [_parse_arrow(coords) for coords in _components(g == MAROON)]\n\n    out_edge: dict[int, int] = {}\n    indegree = {int(obj[\"id\"]): 0 for obj in objects}\n    for arrow in arrows:\n        src, dst = _match_endpoint(objects, str(arrow[\"dir\"]), tuple(arrow[\"tail\"]), tuple(arrow[\"head\"]))\n        assert src != dst, \"arrows must connect distinct objects\"\n        assert src not in out_edge, \"each object has at most one outgoing arrow\"\n        out_edge[src] = dst\n        indegree[dst] += 1\n        assert indegree[dst] <= 1, \"each object has at most one incoming arrow\"\n\n    out = g.copy()\n    out[g == MAROON] = bg\n\n    colors = {int(obj[\"id\"]): int(obj[\"color\"]) for obj in objects}\n    object_map = {int(obj[\"id\"]): obj for obj in objects}\n    heads = [node for node, deg in indegree.items() if deg == 0]\n    assert heads, \"expected at least one chain head\"\n\n    visited: set[int] = set()\n    for head in heads:\n        head_color = colors[head]\n        current = head\n        first = True\n        while current not in visited:\n            visited.add(current)\n            if not first:\n                obj = object_map[current]\n                out[int(obj[\"r0\"]) : int(obj[\"r1\"]) + 1, int(obj[\"c0\"]) : int(obj[\"c1\"]) + 1] = head_color\n            first = False\n            if current not in out_edge:\n                break\n            current = out_edge[current]\n\n    assert len(visited) == len(objects), \"graph must be a disjoint union of chains\"\n    return out\n\n\nGRID_MIN = 18\nGRID_MAX = 28\nLINE_LEN_RANGE = (3, 5)\nCHAIN_ATTEMPTS = 120\nLINK_ATTEMPTS = 80\nPLACEMENT_ATTEMPTS = 120\nGEN_ATTEMPTS = 300\nPATCH_MAX_SPAN = 18\nVALID_LENGTHS = {\n    1: [(2,), (3,), (4,)],\n    2: [(2, 2), (2, 3), (2, 4), (3, 2), (3, 3), (4, 2)],\n    3: [(2, 2, 2), (2, 2, 3), (2, 3, 2), (3, 2, 2)],\n","exit_code":0,"status":"completed"}}
