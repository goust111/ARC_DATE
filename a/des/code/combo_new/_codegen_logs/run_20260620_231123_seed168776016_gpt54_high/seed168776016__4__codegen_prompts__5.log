{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/da6e95e5.py\"","aggregated_output":"from itertools import product\nfrom collections import defaultdict\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste, random_free_location\nimport random\n\n\nQUADS = ((0, 0), (0, 1), (1, 0), (1, 1))\n\n\ndef _record_components(g: np.ndarray, bg: int) -> list[dict]:\n    comps = []\n    for idx, comp in enumerate(\n        find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    ):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        comps.append(\n            {\n                **comp,\n                \"id\": idx,\n                \"h\": r1 - r0 + 1,\n                \"w\": c1 - c0 + 1,\n                \"cr2\": r0 + r1,\n                \"cc2\": c0 + c1,\n            }\n        )\n    return comps\n\n\ndef _bbox(comp: dict) -> tuple[int, int, int, int]:\n    return comp[\"bbox\"]\n\n\ndef _aligned_markers(markers: tuple[dict, dict, dict, dict]) -> bool:\n    bnw, bne, bsw, bse = map(_bbox, markers)\n    return (\n        (bnw[0], bnw[2]) == (bne[0], bne[2])\n        and (bsw[0], bsw[2]) == (bse[0], bse[2])\n        and (bnw[1], bnw[3]) == (bsw[1], bsw[3])\n        and (bne[1], bne[3]) == (bse[1], bse[3])\n        and bnw[2] < bsw[0]\n        and bne[2] < bse[0]\n        and bnw[3] < bne[1]\n        and bsw[3] < bse[1]\n    )\n\n\ndef _is_cluster(center: dict, markers: tuple[dict, dict, dict, dict]) -> bool:\n    nw, ne, sw, _ = markers\n    if not _aligned_markers(markers):\n        return False\n\n    r0, c0, r1, c1 = _bbox(center)\n    outer_r0 = min(_bbox(marker)[0] for marker in markers)\n    outer_c0 = min(_bbox(marker)[1] for marker in markers)\n    outer_r1 = max(_bbox(marker)[2] for marker in markers)\n    outer_c1 = max(_bbox(marker)[3] for marker in markers)\n\n    return (\n        outer_r0 <= r0 <= r1 <= outer_r1\n        and outer_c0 <= c0 <= c1 <= outer_c1\n        and nw[\"cr2\"] < center[\"cr2\"] < sw[\"cr2\"]\n        and nw[\"cc2\"] < center[\"cc2\"] < ne[\"cc2\"]\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Extract the central object from the marker cluster whose markers have the same color.\n\n    Input structure\n    The grid has a dominant background and several clusters; each cluster has four\n    same-color corner marker objects around one central monochromatic object.\n    Rule\n    Find every central object enclosed by four aligned corner markers of one color,\n    then choose the unique one whose object color equals the marker color.\n    Key insight\n    The answer is not the largest or most frequent object; it is the center of the\n    self-colored cluster, cropped to that object's bounding box with background kept.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    comps = _record_components(g, bg)\n\n    targets = {}\n    for center in comps:\n        by_marker_role = defaultdict(lambda: defaultdict(list))\n        for marker in comps:\n            if marker[\"id\"] == center[\"id\"]:\n                continue\n            if marker[\"cr2\"] == center[\"cr2\"] or marker[\"cc2\"] == center[\"cc2\"]:\n                continue\n            quad = (\n                0 if marker[\"cr2\"] < center[\"cr2\"] else 1,\n                0 if marker[\"cc2\"] < center[\"cc2\"] else 1,\n            )\n            key = (marker[\"color\"], marker[\"area\"], marker[\"h\"], marker[\"w\"])\n            by_marker_role[key][quad].append(marker)\n\n        for key, markers_by_quad in by_marker_role.items():\n            if not all(quad in markers_by_quad for quad in QUADS):\n                continue\n            for markers in product(*(markers_by_quad[quad] for quad in QUADS)):\n                if len({marker[\"id\"] for marker in markers}) != 4:\n                    continue\n                if _is_cluster(center, markers) and center[\"color\"] == key[0]:\n                    targets[center[\"id\"]] = center\n\n    assert len(targets) == 1\n    target = next(iter(targets.values()))\n    r0, c0, r1, c1 = _bbox(target)\n    out = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n    assert np.all((out == bg) | (out == target[\"color\"]))\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, palette, and placement.\nGRID_SHAPE = (30, 30)\nCOLOR_COUNT = 10\nPLACEMENT_BORDER = 1\n\n# Cluster structure and shared center bbox ranges.\nMARKER_SIZES = (2, 3)\nCENTER_BOUNDS_BY_MARKER = {\n    2: ((2, 4), (2, 5)),\n    3: ((3, 4), (3, 5)),\n}\nCLUSTER_COUNT_RANGE = (4, 6)\nCENTER_OFFSET = 2\n\n# Center sprite area and retry bounds.\nMIN_CENTER_AREA = 3\nMAX_CENTER_AREA = 14\nGEN_ATTEMPTS = 300\n\n\ndef _gen_l_marker(marker_size: int, color: int, bg: int) -> np.ndarray:\n    marker = np.full((marker_size, marker_size), bg, dtype=int)\n    marker[0, :] = color\n    marker[:, 0] = color\n    return marker\n\n\ndef _gen_center_mask(height: int, width: int, area: int) -> np.ndarray:\n    mask = np.zeros((height, width), dtype=bool)\n    if random.randrange(2):\n        r, c, end_r, end_c = 0, 0, height - 1, width - 1\n    else:\n        r, c, end_r, end_c = 0, width - 1, height - 1, 0\n\n    mask[r, c] = True\n    while (r, c) != (end_r, end_c):\n        if r < end_r:\n            r += 1\n        elif r > end_r:\n            r -= 1\n        if c < end_c:\n            c += 1\n        elif c > end_c:\n            c -= 1\n        mask[r, c] = True\n\n    while int(mask.sum()) < area:\n        candidates = set()\n        for rr, cc in np.argwhere(mask):\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    if dr == 0 and dc == 0:\n                        continue\n                    nr, nc = int(rr) + dr, int(cc) + dc\n                    if 0 <= nr < height and 0 <= nc < width and not mask[nr, nc]:\n                        candidates.add((nr, nc))\n        nr, nc = random.choice(tuple(candidates))\n        mask[nr, nc] = True\n    return mask\n\n\ndef _gen_center_patch(height: int, width: int, color: int, bg: int) -> np.ndarray:\n    min_area = max(MIN_CENTER_AREA, height, width)\n    max_area = min(MAX_CENTER_AREA, height * width - 1)\n    area = random.randint(min_area, max_area)\n    patch = np.full((height, width), bg, dtype=int)\n    patch[_gen_center_mask(height, width, area)] = color\n    return patch\n\n\ndef _gen_cluster_patch(\n    marker_size: int,\n    center_height: int,\n    center_width: int,\n    marker_color: int,\n    center_color: int,\n    bg: int,\n) -> tuple[np.ndarray, np.ndarray]:\n    overlap = marker_size - 2\n    center_r0 = CENTER_OFFSET\n    center_c0 = CENTER_OFFSET\n    bottom_r0 = center_r0 + center_height - overlap\n    right_c0 = center_c0 + center_width - overlap\n    patch = np.full((bottom_r0 + marker_size, right_c0 + marker_size), bg, dtype=int)\n\n    marker = _gen_l_marker(marker_size, marker_color, bg)\n    paste(patch, marker, 0, 0, transparent=bg)\n    paste(patch, np.fliplr(marker), 0, right_c0, transparent=bg)\n    paste(patch, np.flipud(marker), bottom_r0, 0, transparent=bg)\n    paste(patch, np.flipud(np.fliplr(marker)), bottom_r0, right_c0, transparent=bg)\n\n    center = _gen_center_patch(center_height, center_width, center_color, bg)\n    paste(patch, center, center_r0, center_c0, transparent=bg)\n    return patch, center\n\n\ndef _place_cluster_patches(patches: list[np.ndarray], bg: int) -> np.ndarray | None:\n    grid = np.full(GRID_SHAPE, bg, dtype=int)\n    occupied = np.zeros(GRID_SHAPE, dtype=int)\n    n_clusters = len(patches)\n    order = list(range(n_clusters))\n    random.shuffle(order)\n    try:\n        for idx in order:\n            patch = patches[idx]\n            h, w = patch.shape\n            rect = np.ones((h, w), dtype=int)\n            r0, c0 = random_free_location(\n                occupied, rect, transparent=0, border=PLACEMENT_BORDER\n            )\n            occupied[r0 : r0 + h, c0 : c0 + w] = 1\n            paste(grid, patch, r0, c0, transparent=bg)\n    except ValueError:\n        return None\n    return grid\n\n\ndef _solves_to_expected(grid: np.ndarray, expected: np.ndarray) -> bool:\n    try:\n        solved = main(grid)\n    except AssertionError:\n        return False\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox, components_mask, paste, random_free_location\nimport random\n\n\ndef _split_panels(g: np.ndarray) -> tuple[list[np.ndarray], set[int]]:\n    h, w = g.shape\n    candidates: list[tuple[list[np.ndarray], set[int]]] = []\n\n    for horizontal in (False, True):\n        dim = w if horizontal else h\n        for n in range(3, dim + 1):\n            if dim % n:\n                continue\n            ph, pw = (h, w // n) if horizontal else (h // n, w)\n            if ph < 2 or pw < 2:\n                continue\n            if horizontal:\n                panels = [g[:, i * pw : (i + 1) * pw] for i in range(n)]\n            else:\n                panels = [g[i * ph : (i + 1) * ph, :] for i in range(n)]\n\n            template = panels[-1]\n            template_colors = set(map(int, template.ravel()))\n            diff_colors: set[int] = set()\n            diff_counts = []\n            for panel in panels[:-1]:\n                diff = panel != template\n                diff_counts.append(int(diff.sum()))\n                diff_colors.update(map(int, panel[diff].ravel()))\n\n            if not diff_colors or not all(diff_counts):\n                continue\n            if diff_colors & template_colors:\n                continue\n            occurrences = {\n                color: sum(bool(np.any(panel == color)) for panel in panels[:-1])\n                for color in diff_colors\n            }\n            if not all(count >= 2 for count in occurrences.values()):\n                continue\n            candidates.append((panels, diff_colors))\n\n    assert len(candidates) == 1\n    return candidates[0]\n\n\ndef _intervals(line: np.ndarray) -> list[tuple[int, int]]:\n    out: list[tuple[int, int]] = []\n    i = 0\n    while i < len(line):\n        if not line[i]:\n            i += 1\n            continue\n        j = i\n        while j + 1 < len(line) and line[j + 1]:\n            j += 1\n        out.append((i, j))\n        i = j + 1\n    return out\n\n\ndef _shift_intervals(\n    intervals: list[tuple[int, int]], step: int, length: int\n) -> list[tuple[int, int]]:\n    shifted = []\n    for start, end in intervals:\n        new_start = start + step\n        new_end = end + step\n        assert 0 <= new_start <= new_end < length\n        shifted.append((new_start, new_end))\n    return shifted\n\n\ndef _is_prefix(shorter: list[tuple[int, int]], longer: list[tuple[int, int]]) -> bool:\n    return len(shorter) <= len(longer) and all(a == b for a, b in zip(shorter, longer))\n\n\ndef _required_bbox(mask: np.ndarray) -> tuple[int, int, int, int]:\n    b = bbox(mask)\n    assert b is not None\n    return b\n\n\ndef _motion_axis(a: np.ndarray, b: np.ndarray) -> tuple[int, int]:\n    ar0, ac0, ar1, ac1 = _required_bbox(a)\n    br0, bc0, br1, bc1 = _required_bbox(b)\n    row_motion = abs(br0 - ar0) + abs(br1 - ar1)\n    col_motion = abs(bc0 - ac0) + abs(bc1 - ac1)\n    assert row_motion != col_motion\n\n    if row_motion > col_motion:\n        deltas = [br0 - ar0, br1 - ar1]\n        axis = 0\n    else:\n        deltas = [bc0 - ac0, bc1 - ac1]\n        axis = 1\n    nonzero = [delta for delta in deltas if delta]\n    assert nonzero and all((delta > 0) == (nonzero[0] > 0) for delta in nonzero)\n    direction = 1 if nonzero[0] > 0 else -1\n    return axis, direction\n\n\ndef _draw_intervals(mask: np.ndarray, axis: int, line: int, intervals: list[tuple[int, int]]) -> None:\n    for start, end in intervals:\n        if axis == 0:\n            mask[start : end + 1, line] = True\n        else:\n            mask[line, start : end + 1] = True\n\n\ndef _extrapolate_mask(a: np.ndarray, b: np.ndarray) -> np.ndarray:\n    assert a.any() and b.any()\n    assert not np.array_equal(a, b)\n\n    axis, direction = _motion_axis(a, b)\n    added = b & ~a\n    assert added.any()\n    added_coords = np.argwhere(added)\n    extent = int(added_coords[:, axis].max() - added_coords[:, axis].min() + 1)\n    global_step = direction * extent\n\n    out = np.zeros_like(b, dtype=bool)\n    line_count = b.shape[1 - axis]\n    length = b.shape[axis]\n    for line in range(line_count):\n        if axis == 0:\n            a_intervals = _intervals(a[:, line])\n            b_intervals = _intervals(b[:, line])\n        else:\n            a_intervals = _intervals(a[line, :])\n            b_intervals = _intervals(b[line, :])\n\n        if not a_intervals and not b_intervals:\n            next_intervals: list[tuple[int, int]] = []\n        elif a_intervals and len(a_intervals) == len(b_intervals):\n            next_intervals = []\n            for (a0, a1), (b0, b1) in zip(a_intervals, b_intervals):\n                new_start = b0 + (b0 - a0)\n                new_end = b1 + (b1 - a1)\n                assert 0 <= new_start <= new_end < length\n                next_intervals.append((new_start, new_end))\n        elif a_intervals and _is_prefix(a_intervals, b_intervals):\n            extra_count = len(b_intervals) - len(a_intervals)\n            assert 0 < extra_count <= len(a_intervals)\n            previous = a_intervals[-extra_count:]\n            extra = b_intervals[-extra_count:]\n            steps = {\n                end_new - end_old\n                for old, new in zip(previous, extra)\n                for end_old, end_new in zip(old, new)\n            }\n            assert len(steps) == 1\n            step = steps.pop()\n            assert step\n            next_intervals = list(b_intervals) + _shift_intervals(extra, step, length)\n        elif not a_intervals and b_intervals:\n            next_intervals = list(b_intervals) + _shift_intervals(\n                b_intervals, global_step, length\n            )\n        else:\n            raise AssertionError\n\n        _draw_intervals(out, axis, line, next_intervals)\n\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Predict the next panel in a framed sequence by continuing each scheduled colored interval.\n\n    Input structure\n    - The grid is made from three or more equal panels in one row or one column.\n    - The final input panel is the static target template; every earlier panel differs from it only by dynamic colors absent from the template.\n    - Each dynamic color appears in a regular temporal schedule across the earlier panels.\n\n    Rule\n    - Keep the final template panel as the output canvas.\n    - For every dynamic color whose schedule reaches the next panel, compare its last two appearances.\n    - Extrapolate each one-dimensional interval along the color's changing row or column axis and paint that predicted mask.\n\n    Key insight\n    - The task is not asking for the last visible panel, but for the next frame after the blank/template slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    panels, diff_colors = _split_panels(g)\n    template = panels[-1]\n    prior = panels[:-1]\n    next_time = len(prior)\n\n    predictions: list[tuple[int, np.ndarray]] = []\n    for color in diff_colors:\n        times = [i for i, panel in enumerate(prior) if np.any(panel == color)]\n        assert len(times) >= 2\n        gaps = [b - a for a, b in zip(times, times[1:])]\n        assert len(set(gaps)) == 1\n        period = gaps[0]\n        if next_time - times[-1] != period:\n            continue\n\n        previous = prior[times[-2]] == color\n        current = prior[times[-1]] == color\n        predictions.append((color, _extrapolate_mask(previous, current)))\n\n    assert predictions\n    occupied = np.zeros_like(template, dtype=bool)\n    for _color, mask in predictions:\n        assert not np.any(occupied & mask)\n        occupied |= mask\n\n    out = template.copy()\n    for color, mask in predictions:\n        out[mask] = color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, orientation, and color sampling.\nPANEL_SIZE_MIN, PANEL_SIZE_MAX = 5, 11\nPANEL_COUNT_CHOICES, ORIENTATION_CHOICES = (3, 5), (False, True)\nCOLOR_POOL, TOTAL_COLOR_CHOICES, MOTION_AXIS_CHOICES = range(10), (4, 5), (0, 1)\n\n# Template decoration density and symmetry.\nTEMPLATE_MIN_DECO_CELLS = 4\nTEMPLATE_DECO_MIN_RATIO, TEMPLATE_DECO_MAX_RATIO = 0.10, 0.30\n\n# Blob motif and growth bounds.\nBLOB_GROWTH_MIN, BLOB_GROWTH_MAX = 1, 4\nBLOB_MAX_INITIAL_CELLS, BLOB_MAX_COMPONENTS = 7, 2\nBLOB_MAX_LINE_COUNT, BLOB_MAX_WIDTH = 3, 3\nBLOB_DIRECTIONS = (-1, 1)\n\n# Dynamic-color schedules.\nSHORT_PRIOR_COUNT, MAX_DYNAMIC_COLORS = 2, 3\nSCHEDULE_ALWAYS_2 = {\"period\": 1, \"times\": [0, 1], \"scheduled\": True}\nSCHEDULE_ALWAYS_4 = {\"period\": 1, \"times\": [0, 1, 2, 3], \"scheduled\": True}\nSCHEDULE_EVEN_4 = {\"period\": 2, \"times\": [0, 2], \"scheduled\": True}\n","exit_code":0,"status":"completed"}}
