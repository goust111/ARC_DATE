, dtype=int)\n 217:     h, w = g.shape\n 218:     bg = get_bg(g)\n 219: \n 220:     mover = 4  # yellow in ARC\n 221:     dirs = _legend_directions(g, bg)\n 222:     assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n 223: \n 224:     passable = (g == bg) | (g == mover)\n 225:     out = g.copy()\n 226: \n 227:     # Find enclosed passable regions (not connected to the outer border).\n 228:     for pts in components_mask(passable, connectivity=4):\n 229:         if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n 230:             continue  # outside background\n 231: \n 232:         movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n 233:         if not movers:\n 234:             continue\n 235: \n 236:         # Determine this region's border color by counting adjacent wall colors.\n 237:         border_counts: dict[int, int] = {}\n 238:         pset = {(int(r), int(c)) for r, c in pts}\n 239:         for r, c in pts:\n 240:             for nr, nc in neighbors4(r, c):\n 241:                 if not (0 <= nr < h and 0 <= nc < w):\n 242:                     continue\n 243:                 if (nr, nc) in pset:\n 244:                     continue\n 245:                 v = int(g[nr, nc])\n 246:                 if v == bg or v == mover:\n 247:                     continue\n 248:                 border_counts[v] = border_counts.get(v, 0) + 1\n 249:         if not border_counts:\n 250:             continue\n 251:         border_col = max(border_counts, key=border_counts.get)\n 252:         if border_col not in dirs:\n 253:             continue\n 254:         dr, dc = dirs[border_col]\n 255: \n 256:         # Clear old movers.\n 257:         for r, c in movers:\n 258:             out[r, c] = bg\n 259: \n 260:         # Slide and repaint.\n 261:         new_pts = _slide_points(pset, movers, dr, dc)\n 262:         for r, c in new_pts:\n 263:             out[r, c] = mover\n 264: \n 265:     return out\n 266: \n 267: # --------------- generator (claude-att1) ---------------\n 268: \n 269: \"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\n 270: import random\n 271: import numpy as np\n 272: \n 273: from arc_utils import label_mask, neighbors4, paste\n 274: \n 275: # ── Configuration ─────────────────────────────────────────────────\n 276: GRID_H, GRID_W = 20, 20\n 277: \n 278: # Legend\n 279: CARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n 280: DIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\n 281: CORNERS = ['TL', 'TR', 'BL', 'BR']\n 282: WALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\n 283: CARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\n 284: LEGEND_BUFFER = 1                          # cells of padding around legend patches\n 285: \n 286: # Regions\n 287: REGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\n 288: MAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\n 289: REGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n 290:     1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n 291: }\n 292: BLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n 293: \n 294: # Yellows\n 295: YELLOWS_PER_REGION = [1, 2]                # choices per region\n 296: MAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n 297: \n 298: # Outer loop\n 299: GEN_RETRIES = 300                          # max attempts in generate_input()\n 300: \n 301: \n 302: # ── Legend patches ────────────────────────────────────────────────\n 303: \n--- generate_input lines 604-613 ---\n1207: def generate_input() -> np.ndarray:\n1208:     rng = random.Random()\n1209:     for _ in range(GEN_RETRIES):\n1210:         try:\n1211:             g = _gen_attempt(rng)\n1212:         except Exception:\n1213:             continue\n1214:         if g is not None:\n1215:             return g\n1216:     raise RuntimeError(\"generate_input: exceeded retries\")\n===== /home/lixinyu/snap/new/ARC_code/eval/898e7135.py =====\n--- main lines 6-145 ---\n  11: def main(grid: np.ndarray) -> np.ndarray:\n  12:     \"\"\"\n  13:     Inflate a frame's hole-layout and fill each hole with its matching piece.\n  14: \n  15:     Input structure:\n  16:     - bg = most common color. Largest component is a monochrome frame enclosing bg holes.\n  17:     - Outside pieces composed of k×k blocks; k = side of smallest solid square piece.\n  18: \n  19:     Rule:\n  20:     - Extract connected hole regions inside the frame as slots.\n  21:     - Match each piece to a slot by comparing block-level shapes under rotation/flip.\n  22:     - Output the layout scaled by k, with pieces placed in slots; frame color as background.\n  23: \n  24:     Key insight: Pieces are k×k-block-scaled versions of holes; downsampling reveals shape matches under all 8 orientations.\n  25:     \"\"\"\n  26:     g = np.array(grid, dtype=int)\n  27:     bg = int(get_bg(g))\n  28: \n  29:     # --- find the largest connected component of foreground (multicolor) ---\n  30:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n  31:     assert not (not comps)\n  32:     frame_comp = max(comps, key=lambda d: int(d[\"area\"]))\n  33:     fr0, fc0, fr1, fc1 = map(int, frame_comp[\"bbox\"])\n  34: \n  35:     # The frame is monochrome; use its dominant color as output background.\n  36:     frame_cols = [int(g[int(r), int(c)]) for r, c in frame_comp[\"coords\"]]\n  37:     bgc = int(Counter(frame_cols).most_common(1)[0][0])\n  38: \n  39:     # --- layout = bg holes inside the frame bbox, tight-cropped ---\n  40:     sub = crop_bbox(g, (fr0, fc0, fr1, fc1))\n  41:     hole = sub == int(bg)\n  42:     hole_box = bbox(hole)\n  43:     assert hole_box is not None, \"frame must enclose at least one bg hole\"\n  44:     lr0, lc0, lr1, lc1 = map(int, hole_box)\n  45:     layout = hole[lr0 : lr1 + 1, lc0 : lc1 + 1]\n  46: \n  47:     # --- slot components in the layout ---\n  48:     slots = []\n  49:     for coords in components_mask(layout, connectivity=4):\n  50:         rr0, cc0, rr1, cc1 = bbox_coords(coords)\n  51:         rr0, cc0, rr1, cc1 = map(int, (rr0, cc0, rr1, cc1))\n  52:         h = int(rr1 - rr0 + 1)\n  53:         w = int(cc1 - cc0 + 1)\n  54:         sm = np.zeros((h, w), dtype=bool)\n  55:         sm[coords[:, 0] - rr0, coords[:, 1] - cc0] = True\n  56:         slots.append({\"area\": int(sm.sum()), \"r0\": int(rr0), \"c0\": int(cc0), \"mask\": sm})\n  57:     slots.sort(key=lambda s: (-int(s[\"area\"]), int(s[\"r0\"]), int(s[\"c0\"])))\n  58: \n  59:     assert slots, \"frame must contain at least one slot\"\n  60: \n  61:     # --- pieces = non-singleton foreground components excluding the frame component ---\n  62:     pieces = []\n  63:     for comp in comps:\n  64:         if comp is frame_comp:\n  65:             continue\n  66:         coords = comp[\"coords\"]\n  67:         if coords.size == 0 or int(coords.shape[0]) <= 1:\n  68:             continue\n  69:         pr0, pc0, pr1, pc1 = map(int, comp[\"bbox\"])\n  70:         patch = crop_bbox(g, (pr0, pc0, pr1, pc1))\n  71:         ph, pw = map(int, patch.shape)\n  72:         pm = np.zeros((ph, pw), dtype=bool)\n  73:         pm[coords[:, 0] - pr0, coords[:, 1] - pc0] = True\n  74:         pieces.append({\"area\": int(pm.sum()), \"mask\": pm, \"patch\": patch})\n  75: \n  76:     assert pieces, \"at least one non-frame piece must exist\"\n  77: \n  78:     # --- infer k from the smallest solid square piece ---\n  79:     k = None\n  80:     for p in pieces:\n  81:         h, w = map(int, p[\"mask\"].shape)\n  82:         if h == w and int(p[\"mask\"].sum()) == int(h * w):\n  83:             k = int(h) if k is None else min(int(k), int(h))\n  84:     k = int(k or 1)\n  85: \n  86:     def downsample_blocks(mask: np.ndarray) -> np.ndarray | None:\n  87:         hh, ww = mask.shape\n  88:         if hh % k != 0 or ww % k != 0:\n  89:             return None\n  90:         out_h, out_w = int(hh // k), int(ww // k)\n  91:         out = np.zeros((out_h, out_w), dtype=bool)\n  92:         for r in range(out_h):\n  93:             for c in range(out_w):\n  94:                 block = mask[int(r * k) : int((r + 1) * k), int(c * k) : int((c + 1) * k)]\n  95:                 if bool(block.all()):\n  96:                     out[r, c] = True\n  97:                 elif bool(block.any()):\n  98:                     return None\n  99:         return out\n 100: \n 101:     def dihedral_variants(\n 102:         patch: np.ndarray, mask: np.ndarray\n 103:     ) -> list[tuple[np.ndarray, np.ndarray]]:\n 104:         base = []\n 105:         for kk in range(4):\n 106:             p = np.rot90(patch, int(kk))\n 107:             m = np.rot90(mask, int(kk))\n 108:             base.append((p, m))\n 109:             base.append((np.fliplr(p), np.fliplr(m)))\n 110:         uniq = []\n 111:         seen = set()\n 112:         for p, m in base:\n 113:             key = m.tobytes()\n 114:             if key in seen:\n 115:                 continue\n 116:             seen.add(key)\n 117:             uniq.append((p, m))\n 118:         return uniq\n 119: \n 120:     # Precompute all usable (piece,variant) candidates with their block masks.\n 121:     candidates = []\n 122:     for pi, p in enumerate(pieces):\n 123:         for vp, vm in dihedral_variants(p[\"patch\"], p[\"mask\"]):\n 124:             um = downsample_blocks(vm)\n 125:             if um is None:\n 126:                 continue\n 127:             candidates.append({\"pi\": int(pi), \"area\": int(p[\"area\"]), \"um\": um, \"vp\": vp, \"vm\": vm})\n 128: \n 129:     used_piece: set[int] = set()\n 130:     placements: list[tuple[dict, dict]] = []\n 131:     for s in slots:\n 132:         need_area = int(s[\"area\"]) * int(k) * int(k)\n 133:         found = None\n 134:         for cand in candidates:\n 135:             if int(cand[\"pi\"]) in used_piece:\n 136:                 continue\n 137:             if int(cand[\"area\"]) != int(need_area):\n 138:                 continue\n 139:             if cand[\"um\"].shape != s[\"mask\"].shape:\n 140:                 continue\n 141:             if np.array_equal(cand[\"um\"], s[\"mask\"]):\n 142:                 found = cand\n 143:                 break\n 144:         assert found is not None, \"every slot must match a piece\"\n 145:         used_piece.add(int(found[\"pi\"]))\n 146:         placements.append((s, found))\n 147: \n 148:     outH = (int(layout.shape[0]) + 2) * int(k)\n 149:     outW = (int(layout.shape[1]) + 2) * int(k)\n 150:     out = np.full((outH, outW), int(bgc), dtype=int)\n--- generate_input lines 492-497 ---\n 983: def generate_input() -> np.ndarray:\n 984:     for _ in range(GENERATE_MAX_RETRIES):\n 985:         res = _gen_attempt()\n 986:         if res is not None:\n 987:             return res\n 988:     raise RuntimeError(\"generate_input: failed to generate after %d attempts\" % GENERATE_MAX_RETRIES)\n","exit_code":0,"status":"completed"}}
