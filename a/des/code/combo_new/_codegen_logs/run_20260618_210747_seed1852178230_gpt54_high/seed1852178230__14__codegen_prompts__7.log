e internal separator-colored pixels are placement markers; the single colored tile is the template to stamp into those marked cells.\n0059:     \"\"\"\n0060:     g = np.asarray(grid, dtype=int)\n0061:     assert g.ndim == 2 and g.size > 0, \"expected a nonempty 2D grid\"\n0062: \n0063:     separator, sep_rows, sep_cols = _separator_lines(g)\n0064:     row_spans = _spans(g.shape[0], sep_rows)\n0065:     col_spans = _spans(g.shape[1], sep_cols)\n0066: \n0067:     tile_heights = {r1 - r0 + 1 for r0, r1 in row_spans}\n0068:     tile_widths = {c1 - c0 + 1 for c0, c1 in col_spans}\n0069:     assert len(tile_heights) == 1 and len(tile_widths) == 1, \"expected equal-sized tile rows and columns\"\n0070:     tile_h = tile_heights.pop()\n0071:     tile_w = tile_widths.pop()\n0072: \n0073:     bg = _unique_mode(g[g != separator])\n0074:     assert bg != separator, \"background and separator colors must differ\"\n0075:     sprite_colors = [int(color) for color in np.unique(g) if int(color) not in {bg, separator}]\n0076:     assert len(sprite_colors) == 1, \"expected one sprite color\"\n0077:     sprite_color = sprite_colors[0]\n0078: \n0079:     source_tiles = []\n0080:     marked_origins = []\n0081:     for r0, r1 in row_spans:\n0082:         for c0, c1 in col_spans:\n0083:             tile = g[r0 : r1 + 1, c0 : c1 + 1]\n0084:             assert tile.shape == (tile_h, tile_w)\n0085:             has_sprite = np.any(tile == sprite_color)\n0086:             has_marker = np.any(tile == separator)\n0087:             if has_sprite:\n0088:                 assert not has_marker, \"source tile should contain only sprite and background\"\n0089:                 assert set(map(int, np.unique(tile))).issubset({bg, sprite_color})\n0090:                 source_tiles.append(tile.copy())\n0091:             elif has_marker:\n0092:                 assert set(map(int, np.unique(tile))).issubset({bg, separator})\n0093:                 marked_origins.append((r0, c0))\n0094:             else:\n0095:                 assert np.all(tile == bg), \"unmarked non-source tiles should be plain background\"\n0096: \n0097:     assert len(source_tiles) == 1, \"expected exactly one source sprite tile\"\n0098:     source_tile = source_tiles[0]\n0099: \n0100:     out = g.copy()\n0101:     for r0, c0 in marked_origins:\n0102:         out[r0 : r0 + tile_h, c0 : c0 + tile_w] = source_tile\n0103:     return out\n0104: \n0105: # --------------- generator (o5x) ---------------\n0106: \n0107: # Palette: separator, background, and sprite are distinct.\n0108: COLOR_POOL = range(10)\n0109: PALETTE_SIZE = 3\n0110: # Tile grid dimensions and odd square tile sizes.\n0111: TILE_ROWS_RANGE = (3, 4)\n0112: TILE_COLS_RANGE = (3, 4)\n0113: TILE_SIZE_CHOICES = [3, 5]\n0114: SEPARATOR_WIDTH = 1\n0115: # Sprite density and 4-connected component count by tile size.\n0116: SPRITE_PIXEL_RANGES = {3: (3, 4), 5: (8, 11)}\n0117: SPRITE_COMPONENT_CAPS = {3: 3, 5: 5}\n0118: NEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n0119: ORIENTATION_COUNT = 4\n0120: FLIP_PROBABILITY = 0.5\n0121: # Marker tiles and retry budget.\n0122: MARKER_COUNT_RANGE = (3, 5)\n0123: MAX_GENERATION_ATTEMPTS = 300\n0124: \n0125: \n0247: def generate_input() -> np.ndarray:\n0248:     for _ in range(MAX_GENERATION_ATTEMPTS):\n0249:         grid = _gen_attempt()\n0250:         if grid is not None:\n0251:             return grid\n0252:     raise RuntimeError(\"failed to generate a valid e734a0e8 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/d749d46f.py =====\n0031: def main(grid: np.ndarray) -> np.ndarray:\n0032:     \"\"\"\n0033:     Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.\n0034: \n0035:     Input structure\n0036:     The grid has one background color and one foreground color; the foreground forms\n0037:     separate solid rectangles, ordered from left to right.\n0038: \n0039:     Rule\n0040:     Build a 10-row background canvas whose width is the packed width of the wide\n0041:     versions of the rectangles. For each source rectangle, paint a top-aligned\n0042:     rectangle of shape min(h,w) by max(h,w), with one background column between\n0043:     consecutive rectangles. Then, starting again from the left edge, paint a\n0044:     bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,\n0045:     again separated by one background column.\n0046: \n0047:     Key insight\n0048:     The input rectangles are not copied in their original orientations; each object\n0049:     contributes one horizontal-facing and one vertical-facing normalized rectangle,\n0050:     preserving left-to-right object order.\n0051:     \"\"\"\n0052:     g = np.asarray(grid, dtype=int)\n0053:     bg = get_bg(g)\n0054:     fg_colors = colors_present(g, exclude={bg})\n0055:     assert len(fg_colors) == 1\n0056:     fg = fg_colors[0]\n0057: \n0058:     components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n0059:     assert components\n0060:     components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n0061: \n0062:     dims: list[tuple[int, int]] = []\n0063:     for obj in components:\n0064:         r0, c0, r1, c1 = obj[\"bbox\"]\n0065:         h = r1 - r0 + 1\n0066:         w = c1 - c0 + 1\n0067:         assert obj[\"area\"] == h * w\n0068:         dims.append((h, w))\n0069: \n0070:     out_h = 10\n0071:     out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n0072:     _assert_output_footprints_disjoint(dims)\n0073:     out = np.full((out_h, out_w), bg, dtype=int)\n0074: \n0075:     c = 0\n0076:     for h, w in dims:\n0077:         short, long = min(h, w), max(h, w)\n0078:         assert long <= out_h\n0079:         out[:short, c : c + long] = fg\n0080:         c += long + 1\n0081: \n0082:     c = 0\n0083:     for h, w in dims:\n0084:         short, long = min(h, w), max(h, w)\n0085:         assert long <= out_h\n0086:         out[out_h - long : out_h, c : c + short] = fg\n0087:         c += short + 1\n0088: \n0089:     return out\n0090: \n0091: # --------------- generator (att1) ---------------\n0092: \n0093: # Color palette.\n0094: COLOR_VALUES = tuple(range(10))\n0095: \n0096: # Rectangle counts and dimensions.\n0097: RECT_COUNT_MIN = 4\n0098: RECT_COUNT_MAX = 6\n0099: SHORT_SIDE_MIN = 1\n0100: SHORT_SIDE_MAX = 3\n0101: SIDE_SUM_MAX = 10\n0102: LONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN\n0103: \n0104: # Canvas and packing constraints.\n0105: ARC_GRID_MAX = 30\n0106: OUTPUT_HEIGHT = 10\n0107: GAP_WIDTH = 1\n0108: \n0109: # Retry policy.\n0110: MAX_GENERATION_ATTEMPTS = 300\n0111: \n0112: \n0226: def generate_input() -> np.ndarray:\n0227:     for _ in range(MAX_GENERATION_ATTEMPTS):\n0228:         result = _gen_attempt()\n0229:         if result is not None:\n0230:             return result\n0231:     raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n\n","exit_code":0,"status":"completed"}}
