{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/753ea09b.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg, label_mask, neighbors4, paste\nimport itertools\nimport random\n\n\ndef _unique_largest_color(g: np.ndarray, colors: list[int]) -> int:\n    counts = Counter(int(v) for v in g.ravel())\n    ranked = sorted(colors, key=lambda color: counts[int(color)], reverse=True)\n    assert len(ranked) >= 2, \"expected at least two candidate colors\"\n    assert counts[ranked[0]] > counts[ranked[1]], \"foreground majority must be unique\"\n    return int(ranked[0])\n\n\ndef _long_component_ids(lab: np.ndarray, n: int) -> set[int]:\n    h = int(lab.shape[0])\n    min_row_span = max(1, h // 3)\n    ids: set[int] = set()\n    for comp_id in range(1, n + 1):\n        coords = np.argwhere(lab == comp_id)\n        assert coords.size > 0, \"component labels must be nonempty\"\n        r0 = int(coords[:, 0].min())\n        r1 = int(coords[:, 0].max())\n        if r1 - r0 + 1 >= min_row_span:\n            ids.add(int(comp_id))\n    assert len(ids) >= 2, \"expected at least two long contour components\"\n    return ids\n\n\ndef _two_exterior_bg_ids(bg_lab: np.ndarray, n_bg: int) -> set[int]:\n    assert n_bg >= 3, \"expected interior and exterior background regions\"\n    sizes = {comp_id: int((bg_lab == comp_id).sum()) for comp_id in range(1, n_bg + 1)}\n    size_values = sorted(sizes.values(), reverse=True)\n    assert size_values[1] > size_values[2], \"two exterior regions must be separated by size\"\n    cutoff = size_values[1]\n    exterior = {comp_id for comp_id, size in sizes.items() if size >= cutoff}\n    assert len(exterior) == 2, \"expected exactly two exterior background regions\"\n    return exterior\n\n\ndef _touches_long_contour(\n    coords: np.ndarray,\n    fill_lab: np.ndarray,\n    long_ids: set[int],\n) -> bool:\n    for r, c in coords:\n        for rr, cc in neighbors4(int(r), int(c)):\n            if 0 <= rr < fill_lab.shape[0] and 0 <= cc < fill_lab.shape[1]:\n                if int(fill_lab[rr, cc]) in long_ids:\n                    return True\n    return False\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the small background compartments bounded by the long contour color.\n\n    Input structure:\n    - The grid has one dominant background color and two foreground colors.\n    - The more frequent foreground color forms long 8-connected contour fragments.\n    - The other foreground color is a fixed distractor/obstacle color that partitions\n      the background but is never recolored.\n\n    Rule:\n    - Split the background into 4-connected regions using all foreground pixels as\n      barriers.\n    - Keep the two largest background regions as the outside of the contour drawing.\n    - Recolor every other background region that touches a long contour component\n      to the contour color; leave all foreground pixels unchanged.\n\n    Key insight:\n    The apparent area fill is exactly a component-level fill of bounded background\n    compartments, not a row-wise interpolation between individual contour pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    foreground = colors_present(g, exclude={bg})\n    assert len(foreground) == 2, \"expected exactly two foreground colors\"\n\n    fill_color = _unique_largest_color(g, foreground)\n    fill_lab, _n_fill = label_mask(g == fill_color, connectivity=8)\n    long_ids = _long_component_ids(fill_lab, _n_fill)\n\n    bg_lab, n_bg = label_mask(g == bg, connectivity=4)\n    exterior_ids = _two_exterior_bg_ids(bg_lab, n_bg)\n\n    out = g.copy()\n    for comp_id in range(1, n_bg + 1):\n        if comp_id in exterior_ids:\n            continue\n        coords = np.argwhere(bg_lab == comp_id)\n        if _touches_long_contour(coords, fill_lab, long_ids):\n            out[bg_lab == comp_id] = fill_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\nH, W = 30, 30\nGRID_SHAPE = (H, W)\nARC_COLOR_COUNT = 10\n\n# Long contour path layout.\nPATH_COUNT_OPTIONS = (2, 3)\nPATH_STEP_OPTIONS = (-1, 0, 1)\nPATH_GAP_MIN, PATH_GAP_MAX = 2, 5\nPATH_LEFT_MIN_COL, PATH_RIGHT_MARGIN = 2, 3\nPATH_START_MIN_COL = 3\nPATH_START_RIGHT_MARGIN = 4\nPATH_FAR_END_MIN_CHOICES, PATH_FAR_END_PROB, PATH_FAR_END_DELTA = 8, 0.7, 5\nPATH_SCORING_CANDIDATES = 5\nPATH_MIN_MOVES = 12\n\n# Contour distractors and extra contour pixels.\nOUTSIDE_MARGIN = 2\nOUTSIDE_SIDE_OPTIONS = (-1, 1)\nSHORT_FRAGMENT_COUNT_MIN, SHORT_FRAGMENT_COUNT_MAX = 3, 5\nSHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX = 1, 4\nSHORT_FRAGMENT_ATTEMPTS = 200\nSHORT_FRAGMENT_PATH_PADDING = 3\nCONTOUR_PIXELS_MIN, CONTOUR_PIXELS_MAX = 81, 108\n\n# Obstacle bars and scattered clusters.\nBAR_SEGMENT_MAX = 11\nSINGLE_CHANNEL_BARS_MIN, SINGLE_CHANNEL_BARS_MAX = 5, 11\nMULTI_CHANNEL_TOTAL_BARS_MIN, MULTI_CHANNEL_TOTAL_BARS_MAX = 4, 10\nMULTI_CHANNEL_INITIAL_BARS = 2\nMULTI_CHANNEL_MAX_BARS = 5\nBAR_WIDTH_MIN, BAR_WIDTH_MAX = 1, 5\nOBSTACLE_PIXELS_MIN, OBSTACLE_PIXELS_MAX = 36, 63\nOBSTACLE_EXTRA_PIXELS_MIN = 8\nOBSTACLE_OUTSIDE_QUOTA_MIN, OBSTACLE_OUTSIDE_QUOTA_MAX = 8, 16\nOBSTACLE_CLUSTER_SIZE_MIN, OBSTACLE_CLUSTER_SIZE_MAX = 1, 5\nOBSTACLE_ATTEMPTS = 300\nOBSTACLE_ZONE_OPTIONS = (\"outside\", \"inside\", \"any\")\n\n# Component validation.\nBG_REGIONS_MIN, BG_REGIONS_MAX = 8, 14\nEXTERIOR_REGION_COUNT = 2\nINTERIOR_REGIONS_MIN, INTERIOR_REGIONS_MAX = 6, 12\nINTERIOR_REGION_AREA_MAX = 57\nLONG_COMPONENT_MIN_SPAN = H // 3\nLONG_COMPONENT_COUNT_OPTIONS = (2, 3)\n\n# Retry limits and local neighborhoods.\nGENERATION_ATTEMPTS = 300\nNEIGHBOR_DELTAS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nNEIGHBOR_DELTAS_8 = NEIGHBOR_DELTAS_4 + ((-1, -1), (-1, 1), (1, -1), (1, 1))\n\n\ndef _color_choices() -> tuple[int, int, int]:\n    colors = list(range(ARC_COLOR_COUNT))\n    random.shuffle(colors)\n    return int(colors[0]), int(colors[1]), int(colors[2])\n\n\ndef _path_columns(path_count: int) -> list[list[int]] | None:\n    gaps = [random.randint(PATH_GAP_MIN, PATH_GAP_MAX) for _ in range(path_count - 1)]\n    total_width = sum(gap + 1 for gap in gaps)\n    start_hi = W - PATH_START_RIGHT_MARGIN - total_width\n    if start_hi < PATH_START_MIN_COL:\n        return None\n\n    start = random.randint(PATH_START_MIN_COL, start_hi)\n    end_choices = list(range(PATH_START_MIN_COL, start_hi + 1))\n    if len(end_choices) > PATH_FAR_END_MIN_CHOICES and random.random() < PATH_FAR_END_PROB:\n        far = [c for c in end_choices if abs(c - start) >= PATH_FAR_END_DELTA]\n        if far:\n            end_choices = far\n    end = random.choice(end_choices)\n\n    cols = [start]\n    for gap in gaps:\n        cols.append(cols[-1] + gap + 1)\n    targets = [c + (end - start) for c in cols]\n\n    paths = [[int(c)] for c in cols]\n    for r in range(1, H):\n        valid: list[list[int]] = []\n        for steps in itertools.product(PATH_STEP_OPTIONS, repeat=path_count):\n            nxt = [cols[i] + steps[i] for i in range(path_count)]\n            if nxt[0] < PATH_LEFT_MIN_COL or nxt[-1] > W - PATH_RIGHT_MARGIN:\n                continue\n            if all(PATH_GAP_MIN <= nxt[i + 1] - nxt[i] - 1 <= PATH_GAP_MAX for i in range(path_count - 1)):\n                valid.append(nxt)\n        if not valid:\n            return None\n        ideal = [paths[i][0] + (targets[i] - paths[i][0]) * r / (H - 1) for i in range(path_count)]\n        scored = sorted(\n            valid,\n            key=lambda nxt: sum(abs(nxt[i] - ideal[i]) for i in range(path_count)) + random.random(),\n        )\n        cols = random.choice(scored[: max(1, min(PATH_SCORING_CANDIDATES, len(scored)))])\n        for i, c in enumerate(cols):\n            paths[i].append(int(c))\n\n    moves = sum(paths[i][r] != paths[i][r - 1] for i in range(path_count) for r in range(1, H))\n    if moves < PATH_MIN_MOVES:\n        return None\n    return paths\n\n\ndef _outside_enclosure(paths: list[list[int]], r: int, c: int, margin: int = OUTSIDE_MARGIN) -> bool:\n    return c <= paths[0][r] - margin or c >= paths[-1][r] + margin\n\n\ndef _inside_channel(paths: list[list[int]], r: int, c: int) -> bool:\n    return any(paths[i][r] < c < paths[i + 1][r] for i in range(len(paths) - 1))\n\n\ndef _touches_mask(mask: np.ndarray, coords: list[tuple[int, int]], connectivity: int) -> bool:\n    seen = set(coords)\n    deltas = NEIGHBOR_DELTAS_8 if connectivity == 8 else NEIGHBOR_DELTAS_4\n    for r, c in coords:\n        for dr, dc in deltas:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in seen and mask[rr, cc]:\n                return True\n    return False\n\n\ndef _place_short_fragments(\n    grid: np.ndarray, contour_mask: np.ndarray, paths: list[list[int]], contour: int, count: int\n) -> bool:\n    for _ in range(count):\n        size = random.randint(SHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX)\n        placed = False\n        for _attempt in range(SHORT_FRAGMENT_ATTEMPTS):\n            r = random.randrange(H)\n            side = random.choice(OUTSIDE_SIDE_OPTIONS)\n            if side < 0:\n                hi = paths[0][r] - SHORT_FRAGMENT_PATH_PADDING - size + 1\n                if hi < 0:\n                    continue\n                c0 = random.randint(0, hi)\n            else:\n                lo = paths[-1][r] + SHORT_FRAGMENT_PATH_PADDING\n                if lo + size > W:\n                    continue\n                c0 = random.randint(lo, W - size)\n            coords = [(r, c0 + i) for i in range(size)]\n            if any(grid[rr, cc] != grid[0, 0] for rr, cc in coords):\n                continue\n            if _touches_mask(contour_mask, coords, 8):\n                continue\n            patch = np.full((1, size), contour, dtype=int)\n            paste(grid, patch, r, c0)\n            for rr, cc in coords:\n                contour_mask[rr, cc] = True\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/71e489b6.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import components_mask\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Highlight black defects in blue foreground by surrounding them with orange.\n\n    Input structure:\n    - Blue (1) foreground on black (0) bg; small black holes or protrusions within blue regions; occasional thin blue spurs into black areas.\n\n    Rule:\n    - Thin blue pixels mostly surrounded by black are absorbed into the background.\n    - Small black components (≤3 cells) and leaf pixels of larger black components are \"defects.\"\n    - Each defect gets an orange (7) 8-neighbor halo; the defect pixels themselves stay black.\n\n    Key insight: Only structural anomalies—tiny isolated patches and dangling endpoints—are marked, not bulk black regions.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    hole_col = 0\n    border_col = 7\n\n    # STEP 0) Fill blue (1) pixels to black (0) when mostly surrounded by black.\n    base = g.copy()\n    for r in range(H):\n        for c in range(W):\n            if int(base[r, c]) != 1:\n                continue\n            nb = 0\n            oob = 0\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + dr)\n                cc = int(c + dc)\n                if not (0 <= rr < H and 0 <= cc < W):\n                    oob += 1\n                    continue\n                if int(base[rr, cc]) == int(hole_col):\n                    nb += 1\n            # only count outside-as-black for corners (two out-of-bounds sides)\n            if oob >= 2:\n                nb += int(oob)\n            if nb >= 3:\n                base[int(r), int(c)] = int(hole_col)\n\n    # STEP 1/2) Collect target black pixels (they must remain black).\n    preserve: set[tuple[int, int]] = set()\n    comps = components_mask(base == int(hole_col), connectivity=4)\n    for coords in comps:\n        pts_list = [(int(r), int(c)) for r, c in coords]\n        if len(pts_list) <= 3:\n            preserve.update(pts_list)\n            continue\n        for r, c in pts_list:\n            nb = 0\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + dr)\n                cc = int(c + dc)\n                if 0 <= rr < H and 0 <= cc < W and int(base[rr, cc]) == int(hole_col):\n                    nb += 1\n            if nb <= 1:\n                preserve.add((int(r), int(c)))\n\n    # STEP 3) Paint orange in the Chebyshev-1 neighborhood of each target set/pixel.\n    out = base.copy()\n    for coords in comps:\n        pts_list = [(int(r), int(c)) for r, c in coords]\n        targets = pts_list if len(pts_list) <= 3 else [p for p in pts_list if p in preserve]\n        for r, c in targets:\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    rr = int(r + dr)\n                    cc = int(c + dc)\n                    if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in preserve:\n                        out[rr, cc] = int(border_col)\n\n    # Ensure target black pixels remain black.\n    for r, c in preserve:\n        out[int(r), int(c)] = int(hole_col)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# ── CFG: tunable generation parameters ──────────────────────────────\nGRID_H_RANGE = (16, 19)           # canvas height bounds\nGRID_W_RANGE = (16, 19)           # canvas width bounds\nMIN_BLUE_REGION = 30              # minimum blue region size (cells)\nMIN_BLACK_REGION = 20             # minimum black region size (cells)\nPARTITION_STYLES = ['h_stripes', 'rect_inset', 'l_shape']\nSTRIPE_CUTS_RANGE = (1, 3)       # number of horizontal cuts for h_stripes\nCUT_MARGIN = 3                   # min distance from grid edge for cuts\nINSET_MARGIN = 2                 # padding from edge for rect_inset\nINNER_INSET_MIN_GAP = 6          # min dimension for nested inset\nINNER_INSET_PROB = 0.5           # probability of nested inset\nDEFECT_COUNT_RANGE = (2, 9)      # number of defect holes to place\nDEFECT_SIZE_WEIGHTS = [6, 2, 1]  # weights for defect sizes [1, 2, 3]\nDEFECT_CLEARANCE = 2             # min Chebyshev distance between defects\nDEFECT_PLACE_TRIES = 50          # retries per defect placement\nLEAF_COUNT_RANGE = (0, 4)        # number of leaf protrusions\nSPUR_COUNT_RANGE = (2, 6)        # number of blue spurs in black regions\nMIN_DEFECTS = 2                  # reject grid if fewer defects placed\nMIN_SPURS = 2                    # reject grid if fewer spurs placed\nMAX_GEN_ATTEMPTS = 300           # outer retry limit\n\n\ndef _nearby(r: int, c: int, dist: int, ref: set) -> bool:\n    \"\"\"Return True if any pixel in `ref` is within Chebyshev distance `dist`.\"\"\"\n    for dr in range(-dist, dist + 1):\n        for dc in range(-dist, dist + 1):\n            if (r + dr, c + dc) in ref:\n                return True\n    return False\n\n\ndef _exclusion_zone(pixels, dist: int) -> set:\n    \"\"\"Return the set of all coords within Chebyshev `dist` of any pixel.\"\"\"\n    zone = set()\n    for r, c in pixels:\n        for dr in range(-dist, dist + 1):\n            for dc in range(-dist, dist + 1):\n                zone.add((r + dr, c + dc))\n    return zone\n\n\ndef _build_partition(H: int, W: int) -> np.ndarray:\n    \"\"\"Create an H x W grid partitioned into blue (1) and black (0) regions.\"\"\"\n    grid = np.zeros((H, W), dtype=int)\n    style = random.choice(PARTITION_STYLES)\n\n    if style == 'h_stripes':\n        n_cuts = random.randint(*STRIPE_CUTS_RANGE)\n        cuts = sorted(random.sample(\n            range(CUT_MARGIN, H - CUT_MARGIN), min(n_cuts, H - 2 * CUT_MARGIN)))\n        boundaries = [0] + cuts + [H]\n        first_color = random.randint(0, 1)\n        for i in range(len(boundaries) - 1):\n            grid[boundaries[i]:boundaries[i + 1], :] = (first_color + i) % 2\n\n    elif style == 'rect_inset':\n        bg = random.randint(0, 1)\n        grid[:, :] = bg\n        r0 = random.randint(INSET_MARGIN, H // 3)\n        r1 = random.randint(2 * H // 3, H - CUT_MARGIN)\n        c0 = random.randint(INSET_MARGIN, W // 3)\n        c1 = random.randint(2 * W // 3, W - CUT_MARGIN)\n        grid[r0:r1 + 1, c0:c1 + 1] = 1 - bg\n        if (r1 - r0 > INNER_INSET_MIN_GAP and c1 - c0 > INNER_INSET_MIN_GAP\n                and random.random() < INNER_INSET_PROB):\n            ir0 = random.randint(r0 + 2, r0 + (r1 - r0) // 3)\n            ir1 = random.randint(r0 + 2 * (r1 - r0) // 3, r1 - 2)\n            ic0 = random.randint(c0 + 2, c0 + (c1 - c0) // 3)\n            ic1 = random.randint(c0 + 2 * (c1 - c0) // 3, c1 - 2)\n            grid[ir0:ir1 + 1, ic0:ic1 + 1] = bg\n\n    elif style == 'l_shape':\n        bg = random.randint(0, 1)\n        grid[:, :] = bg\n        vc = random.randint(W // 3, 2 * W // 3)\n        if random.random() < 0.5:\n            grid[:, :vc] = 1 - bg\n            hc = random.randint(H // 3, 2 * H // 3)\n            grid[:hc, vc:] = 1 - bg\n        else:\n            grid[:, vc:] = 1 - bg\n            hc = random.randint(H // 3, 2 * H // 3)\n            grid[hc:, :vc] = 1 - bg\n\n    return grid\n\n\ndef _find_interior_blue(grid: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Return blue pixels whose 4-neighbors are all blue or out-of-bounds.\"\"\"\n    H, W = grid.shape\n    blue = grid == 1\n    # A blue pixel is interior if no in-bounds 4-neighbor is non-blue.\n    eroded = blue.copy()\n    eroded[:-1, :] &= blue[1:, :]   # neighbor below\n    eroded[1:, :]  &= blue[:-1, :]  # neighbor above\n    eroded[:, :-1] &= blue[:, 1:]   # neighbor right\n    eroded[:, 1:]  &= blue[:, :-1]  # neighbor left\n    rs, cs = np.where(eroded)\n    coords = list(zip(rs.tolist(), cs.tolist()))\n    random.shuffle(coords)\n    return coords\n\n\ndef _place_defects(grid: np.ndarray, interior_blue: list) -> tuple[set, int]:\n    \"\"\"Place 2-9 small black defects in blue-region interiors.\n\n    Returns (defect_pixels, defects_placed). Modifies `interior_blue` in place.\n    \"\"\"\n    H, W = grid.shape\n    n_defects = random.randint(*DEFECT_COUNT_RANGE)\n    defect_pixels: set[tuple[int, int]] = set()\n    interior_set = set(interior_blue)\n    defects_placed = 0\n\n    for _ in range(n_defects):\n        if not interior_blue:\n            break\n        defect_size = random.choices([1, 2, 3], weights=DEFECT_SIZE_WEIGHTS)[0]\n\n        placed = False\n        for _try in range(DEFECT_PLACE_TRIES):\n            if not interior_blue:\n                break\n            seed_r, seed_c = interior_blue[random.randint(0, len(interior_blue) - 1)]\n\n            if _nearby(seed_r, seed_c, DEFECT_CLEARANCE, defect_pixels):\n                continue\n\n            # Grow defect from seed\n            defect = [(seed_r, seed_c)]\n            if defect_size > 1:\n                dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n                random.shuffle(dirs)\n                for dr, dc in dirs:\n                    nr, nc = seed_r + dr, seed_c + dc\n                    if (nr, nc) not in interior_set or (nr, nc) in defect_pixels:\n                        continue\n                    # Check neighbor is surrounded by blue (except the seed)\n                    ok = True\n                    for dr2, dc2 in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        rr, cc = nr + dr2, nc + dc2\n                        if (rr, cc) == (seed_r, seed_c):\n                            continue\n                        if 0 <= rr < H and 0 <= cc < W:\n                            if grid[rr, cc] != 1 or (rr, cc) in defect_pixels:\n                                ok = False\n                                break\n                    if ok and not _nearby(nr, nc, DEFECT_CLEARANCE, defect_pixels):\n                        defect.append((nr, nc))\n                        if len(defect) >= defect_size:\n                            break\n\n            # Validate: every non-defect 4-neighbor of every defect pixel must be blue\n            defect_set = set(defect)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/aa62e3f4.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import components_mask, get_bg, neighbors4\nimport random\n\n\ndef _unique_color_with_count(counts: Counter[int], colors: list[int], target_count: int) -> int:\n    matches = [color for color in colors if counts[color] == target_count]\n    assert len(matches) == 1, \"expected a unique structural color by area\"\n    return int(matches[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace the outlined object with the outside contour of that outline in the marker color.\n\n    Input structure:\n    - A dominant background surrounds one 8-connected foreground outline.\n    - The outline is the unique largest foreground color.\n    - One or more smaller interior colors are inside the outline; the marker color\n      is the unique smallest non-outline color.\n\n    Rule:\n    - Erase all original foreground pixels to background.\n    - Paint every background pixel that is 4-adjacent to the outline with the\n      marker color.\n    - Keep the grid shape unchanged.\n\n    Key insight: The colored interior marker supplies the paint color, while the\n    largest outline supplies only the contour whose outside edge is traced.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    counts = Counter(map(int, g.flatten()))\n    foreground_colors = [color for color in counts if color != bg]\n    assert len(foreground_colors) >= 2, \"expected an outline color and a marker color\"\n\n    frame_count = max(counts[color] for color in foreground_colors)\n    frame_color = _unique_color_with_count(counts, foreground_colors, frame_count)\n    assert len(components_mask(g == frame_color, connectivity=8)) == 1, \"outline must be 8-connected\"\n\n    marker_candidates = [color for color in foreground_colors if color != frame_color]\n    marker_count = min(counts[color] for color in marker_candidates)\n    marker_color = _unique_color_with_count(counts, marker_candidates, marker_count)\n\n    out = np.full_like(g, bg)\n    contour: set[tuple[int, int]] = set()\n    for r, c in np.argwhere(g == frame_color):\n        for nr, nc in neighbors4(int(r), int(c)):\n            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] == bg:\n                contour.add((int(nr), int(nc)))\n    assert contour, \"expected outline to touch background contour cells\"\n\n    for r, c in contour:\n        out[r, c] = marker_color\n    return out\n\n# --------------- generator (att2) ---------------\n\nGRID_MIN, GRID_MAX = 5, 16\nN_COLORS = 10\n\nSHAPE_MIN_HEIGHT, SHAPE_MAX_HEIGHT = 5, 7\nSHAPE_MIN_WIDTH, SHAPE_MAX_WIDTH = 3, 5\nSTART_WIDTH_MIN, START_WIDTH_MAX = 1, 2\nMAX_LOCAL_WIDTH = 5\n\nMARKER_MIN_CELLS, MARKER_MAX_CELLS = 1, 3\n\nGEN_ATTEMPTS = 300\n\nEDGE_TOUCH_TOP_BOTTOM = \"TB\"\nCORNER_EDGE_PAIRS = [\"TL\", \"TR\", \"BL\", \"BR\"]\nZERO_DELTA_SHIFTS = [-1, 0, 0, 0, 1]\n\n\ndef _gen_grow_parts(total, n):\n    n_twos = total - n\n    parts = [2] * n_twos + [1] * (n - n_twos)\n    random.shuffle(parts)\n    return parts\n\ndef _gen_drop_parts(total, n):\n    if n == 0:\n        return []\n    n_twos = random.randint(max(0, total - n), min(total // 2, n))\n    n_ones = total - 2 * n_twos\n    parts = [2] * n_twos + [1] * n_ones + [0] * (n - n_twos - n_ones)\n    random.shuffle(parts)\n    return parts\n\ndef _gen_widths(height, max_width):\n    start = random.randint(START_WIDTH_MIN, START_WIDTH_MAX)\n    diff = max_width - start\n    grow_steps = random.randint((diff + 1) // 2, min(diff, height - 1))\n    widths = [start]\n    for inc in _gen_grow_parts(diff, grow_steps):\n        widths.append(widths[-1] + inc)\n\n    remaining = height - len(widths)\n    min_end = max(1, max_width - 2 * remaining)\n    end_width = random.randint(min_end, max_width)\n    for dec in _gen_drop_parts(max_width - end_width, remaining):\n        widths.append(widths[-1] - dec)\n    return widths\n\ndef _gen_intervals(widths):\n    left, right = 0, widths[0] - 1\n    intervals = [(left, right)]\n    for prev_width, width in zip(widths, widths[1:]):\n        delta = width - prev_width\n        if delta == 2:\n            left -= 1\n            right += 1\n        elif delta == 1:\n            if random.choice([False, True]):\n                left -= 1\n            else:\n                right += 1\n        elif delta == 0:\n            shift = random.choice(ZERO_DELTA_SHIFTS) if width >= 2 else 0\n            left += shift\n            right += shift\n        elif delta == -1:\n            if random.choice([False, True]):\n                left += 1\n            else:\n                right -= 1\n        elif delta == -2:\n            left += 1\n            right -= 1\n        intervals.append((left, right))\n\n    min_left = min(l for l, _ in intervals)\n    intervals = [(l - min_left, r - min_left) for l, r in intervals]\n    if max(r for _, r in intervals) + 1 > MAX_LOCAL_WIDTH:\n        return None\n    return intervals\n\ndef _gen_local_mask(intervals):\n    height = len(intervals)\n    width = max(r for _, r in intervals) + 1\n    mask = np.zeros((height, width), dtype=bool)\n    for r, (c0, c1) in enumerate(intervals):\n        mask[r, c0 : c1 + 1] = True\n    return mask\n\ndef _gen_place_shape(grid_shape, local_mask, edge_pair):\n    rows, cols = grid_shape\n    height, width = local_mask.shape\n    if edge_pair == EDGE_TOUCH_TOP_BOTTOM:\n        if height != rows or width > cols - 2:\n            return None\n        return 0, random.randint(1, cols - width - 1)\n    if height >= rows or width >= cols:\n        return None\n    if edge_pair == \"TL\":\n        return 0, 0\n    if edge_pair == \"TR\":\n        return 0, cols - width\n    if edge_pair == \"BL\":\n        return rows - height, 0\n    return rows - height, cols - width\n\ndef _gen_full_mask(rows, cols, local_mask, r0, c0):\n    mask = np.zeros((rows, cols), dtype=bool)\n    height, width = local_mask.shape\n    mask[r0 : r0 + height, c0 : c0 + width] = local_mask\n    return mask\n\ndef _gen_layers(mask):\n    remaining = mask.copy()\n    layers = []\n    rows, cols = mask.shape\n    while np.any(remaining):\n        layer = np.zeros_like(mask)\n        for r, c in np.argwhere(remaining):\n            for nr, nc in neighbors4(int(r), int(c)):\n                if nr < 0 or nr >= rows or nc < 0 or nc >= cols or not remaining[nr, nc]:\n                    layer[r, c] = True\n                    break\n        layers.append(layer)\n        remaining[layer] = False\n    return layers\n\ndef _gen_contour(outline, shape):\n    rows, cols = shape.shape\n    contour = np.zeros_like(shape)\n    for r, c in np.argwhere(outline):\n        for nr, nc in neighbors4(int(r), int(c)):\n            if 0 <= nr < rows and 0 <= nc < cols and not shape[nr, nc]:\n                contour[nr, nc] = True\n    return contour\n\ndef _choose_canvas_and_shape_profile():\n    rows = random.randint(GRID_MIN, GRID_MAX)\n    cols = random.randint(GRID_MIN, GRID_MAX)\n    bg = random.randrange(N_COLORS)\n\n    edge_options = []\n    if rows <= SHAPE_MAX_HEIGHT:\n        edge_options.append(EDGE_TOUCH_TOP_BOTTOM)\n    if rows >= SHAPE_MIN_HEIGHT + 1:\n        edge_options.extend(CORNER_EDGE_PAIRS)\n    if not edge_options:\n        return None\n\n    edge_pair = random.choice(edge_options)\n    height = rows if edge_pair == EDGE_TOUCH_TOP_BOTTOM else random.randint(\n        SHAPE_MIN_HEIGHT, min(SHAPE_MAX_HEIGHT, rows - 1)\n    )\n    max_width_limit = cols - 2 if edge_pair == EDGE_TOUCH_TOP_BOTTOM else cols - 1\n    if max_width_limit < SHAPE_MIN_WIDTH:\n        return None\n    max_width = random.randint(SHAPE_MIN_WIDTH, min(SHAPE_MAX_WIDTH, max_width_limit))\n\n    intervals = _gen_intervals(_gen_widths(height, max_width))\n    if intervals is None:\n        return None\n    return rows, cols, bg, edge_pair, intervals\n\ndef _build_shape(rows, cols, edge_pair, intervals):\n    local_mask = _gen_local_mask(intervals)\n    placement = _gen_place_shape((rows, cols), local_mask, edge_pair)\n    if placement is None:\n        return None\n\n    shape = _gen_full_mask(rows, cols, local_mask, *placement)\n    shape_area = int(np.sum(shape))\n    if rows * cols - shape_area <= shape_area:\n        return None\n    return shape\n\ndef _split_valid_layers(shape):\n    layers = _gen_layers(shape)\n    if len(layers) < 2:\n        return None\n\n    outline = layers[0]\n    marker = layers[-1]\n    fill = shape & ~outline & ~marker\n\n    outline_count = int(np.sum(outline))\n    marker_count = int(np.sum(marker))\n    fill_count = int(np.sum(fill))\n    if marker_count < MARKER_MIN_CELLS or marker_count > MARKER_MAX_CELLS:\n        return None\n    if len(components_mask(outline, connectivity=8)) != 1:\n        return None\n    if fill_count and not (marker_count < fill_count < outline_count):\n        return None\n    return outline, fill, marker, fill_count\n\ndef _render_input(rows, cols, bg, masks, colors):\n    outline, fill, marker = masks\n","exit_code":0,"status":"completed"}}
