{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/fc7cae8d.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import crop_bbox, find_components, get_bg, paste, random_free_location\nimport random\nfrom arc_utils import paste, random_free_location\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Align a central rectangle to two colored frame-edge controls via rotation/reflection.\n\n    Input structure:\n    - bg grid with two solid-colored border edges (distinct non-bg colors).\n    - A central filled rectangle with 1px colored guide edges on two sides, colors matching the frame controls.\n\n    Rule:\n    - Rotate/mirror the object so its guide edges face the same sides as the matching frame controls.\n    - Crop off the 1px guide edges from aligned sides.\n\n    Key insight: Guide-edge colors encode target frame sides; the correct dihedral transform matches both simultaneously.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    def detect_controls_frame(arr: np.ndarray) -> list[tuple[str, int]]:\n        H, W = arr.shape\n        sides = {\n            \"top\": arr[0, 1:-1],\n            \"bottom\": arr[-1, 1:-1],\n            \"left\": arr[1:-1, 0],\n            \"right\": arr[1:-1, -1],\n        }\n        cand: list[tuple[str, int, int, int]] = []\n        for side, v in sides.items():\n            v = list(map(int, v))\n            v_nb = [x for x in v if x != int(bg)]\n            if not v_nb:\n                continue\n            col, count = Counter(v_nb).most_common(1)[0]\n            # allow up to 1 mismatch (overlap near corners with the other control color)\n            if int(count) >= len(v) - 1:\n                cand.append((side, int(col), int(count), int(len(v))))\n        cand.sort(key=lambda t: (t[2] / t[3], t[2]), reverse=True)\n        return [(s, c) for s, c, _cnt, _L in cand[:2]]\n\n    def extract_center_object(arr: np.ndarray) -> np.ndarray:\n        H, W = arr.shape\n        comps = find_components(arr, bg=int(bg), connectivity=4, monochromatic=False, return_format=\"dict\")\n        best = None  # (area, bbox)\n        for comp in comps:\n            r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n            if bool(r0 == 0 or c0 == 0 or r1 == H - 1 or c1 == W - 1):\n                continue\n            area = int(comp[\"area\"])\n            if best is None or area > best[0]:\n                best = (area, (r0, c0, r1, c1))\n        if best is None:\n            return arr.copy()\n        _area, b = best\n        return crop_bbox(arr, b)\n\n    def guide_edges(arr: np.ndarray) -> dict[str, int]:\n        fill = int(Counter(map(int, arr.flatten())).most_common(1)[0][0])\n        edges = {\n            \"top\": arr[0, :],\n            \"bottom\": arr[-1, :],\n            \"left\": arr[:, 0],\n            \"right\": arr[:, -1],\n        }\n        out: dict[str, int] = {}\n        for side, v in edges.items():\n            v = list(map(int, v))\n            v_nf = [x for x in v if x != int(fill)]\n            if not v_nf:\n                continue\n            col, count = Counter(v_nf).most_common(1)[0]\n            if int(count) >= len(v) - 1:\n                out[side] = int(col)\n        return out\n\n    ctrls = detect_controls_frame(g)\n    desired = {side: col for side, col in ctrls}\n    obj = extract_center_object(g)\n\n    # Try all dihedral transforms: rotations + optional horizontal flip.\n    for k in range(4):\n        base = np.rot90(obj, int(k))\n        for flip in [False, True]:\n            t = np.fliplr(base) if flip else base\n            gedges = guide_edges(t)\n            if all(side in gedges and int(gedges[side]) == int(col) for side, col in desired.items()):\n                top = 1 if \"top\" in desired else 0\n                bottom = int(t.shape[0]) - (1 if \"bottom\" in desired else 0)\n                left = 1 if \"left\" in desired else 0\n                right = int(t.shape[1]) - (1 if \"right\" in desired else 0)\n                return t[int(top) : int(bottom), int(left) : int(right)]\n\n    # Fallback: should not happen on this puzzle.\n    return obj\n\n# --------------- generator (Codex#2) ---------------\n\ndef _transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:\n    out = np.rot90(arr, int(k))\n    return np.fliplr(out) if flip else out\n\n\ndef _inverse_transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:\n    out = np.fliplr(arr) if flip else arr\n    return np.rot90(out, -int(k))\n\n\ndef _build_core(h: int, w: int, fill: int, pattern_colors: list[int]) -> np.ndarray:\n    core = np.full((h, w), int(fill), dtype=int)\n    area = h * w\n    max_nonfill = max(len(pattern_colors), int(area * 0.35))\n    target_nonfill = random.randint(max(len(pattern_colors), area // 10), max_nonfill)\n    painted = 0\n\n    for color in pattern_colors:\n        r = random.randrange(h)\n        c = random.randrange(w)\n        core[r, c] = int(color)\n        painted += 1\n\n    while painted < target_nonfill:\n        color = random.choice(pattern_colors)\n        shape_kind = random.choice([\"dot\", \"line\", \"rect\"])\n        if shape_kind == \"dot\":\n            cells = [(random.randrange(h), random.randrange(w))]\n        elif shape_kind == \"line\":\n            line_len = random.randint(2, min(5, max(h, w)))\n            if random.random() < 0.5:\n                rr = random.randrange(h)\n                c0 = random.randrange(max(1, w - line_len + 1))\n                cells = [(rr, c0 + dc) for dc in range(line_len)]\n            else:\n                r0 = random.randrange(max(1, h - line_len + 1))\n                cc = random.randrange(w)\n                cells = [(r0 + dr, cc) for dr in range(line_len)]\n        else:\n            mh = random.randint(1, min(3, h))\n            mw = random.randint(1, min(3, w))\n            r0 = random.randrange(h - mh + 1)\n            c0 = random.randrange(w - mw + 1)\n            cells = [(r0 + dr, c0 + dc) for dr in range(mh) for dc in range(mw)]\n\n        remaining = target_nonfill - painted\n        if remaining <= 0:\n            break\n        fill_cells = [(r, c) for r, c in cells if core[r, c] == fill]\n        if len(fill_cells) > remaining:\n            fill_cells = random.sample(fill_cells, remaining)\n        for r, c in fill_cells:\n            core[r, c] = int(color)\n        painted += len(fill_cells)\n        for r, c in cells:\n            if core[r, c] != fill:\n                continue\n            if painted >= target_nonfill:\n                break\n            core[r, c] = int(color)\n            painted += 1\n\n    return core\n\n\ndef _attach_guides(core: np.ndarray, guide_sides: tuple[str, str], guide_colors: dict[str, int]) -> np.ndarray:\n    h, w = core.shape\n    has_top = \"top\" in guide_sides\n    has_bottom = \"bottom\" in guide_sides\n    has_left = \"left\" in guide_sides\n    has_right = \"right\" in guide_sides\n    out = np.zeros((h + has_top + has_bottom, w + has_left + has_right), dtype=int)\n    r0 = 1 if has_top else 0\n    c0 = 1 if has_left else 0\n    paste(out, core, r0, c0)\n\n    if has_top:\n        out[0, c0 : c0 + w] = int(guide_colors[\"top\"])\n    if has_bottom:\n        out[-1, c0 : c0 + w] = int(guide_colors[\"bottom\"])\n    if has_left:\n        out[r0 : r0 + h, 0] = int(guide_colors[\"left\"])\n    if has_right:\n        out[r0 : r0 + h, -1] = int(guide_colors[\"right\"])\n\n    if has_top and has_left:\n        out[0, 0] = 0\n    if has_top and has_right:\n        out[0, -1] = 0\n    if has_bottom and has_left:\n        out[-1, 0] = 0\n    if has_bottom and has_right:\n        out[-1, -1] = 0\n    return out\n\n\ndef _paint_frame(grid: np.ndarray, horiz_side: str, vert_side: str, ctrl_h: int, ctrl_v: int) -> None:\n    n = grid.shape[0]\n    if horiz_side == \"top\":\n        grid[0, :] = int(ctrl_h)\n    else:\n        grid[-1, :] = int(ctrl_h)\n    if vert_side == \"left\":\n        grid[:, 0] = int(ctrl_v)\n    else:\n        grid[:, -1] = int(ctrl_v)\n\n    for side in (\"top\", \"bottom\", \"left\", \"right\"):\n        if side in (horiz_side, vert_side):\n            continue\n        if side in (\"top\", \"bottom\"):\n            r = 0 if side == \"top\" else n - 1\n            coords = [(r, c) for c in range(1, n - 1)]\n        else:\n            c = 0 if side == \"left\" else n - 1\n            coords = [(r, c) for r in range(1, n - 1)]\n        min_count = int(np.ceil(0.35 * len(coords)))\n        max_count = int(np.floor(0.60 * len(coords)))\n        noise_count = random.randint(min_count, max_count)\n        for r, c in random.sample(coords, noise_count):\n            grid[r, c] = 5\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = random.randint(22, 29)\n    horiz_side, vert_side = random.choice(\n        [(\"top\", \"left\"), (\"top\", \"right\"), (\"bottom\", \"left\"), (\"bottom\", \"right\")]\n    )\n\n    all_colors = list(range(1, 10))\n    ctrl_h, ctrl_v = random.sample([c for c in all_colors if c != 5], 2)\n    remaining = [c for c in all_colors if c not in {5, ctrl_h, ctrl_v}]\n    fill = random.choice(remaining)\n    remaining = [c for c in remaining if c != fill]\n    n_pattern_colors = random.randint(2, min(4, len(remaining)))\n    pattern_colors = random.sample(remaining, n_pattern_colors)\n\n    max_core_h = min(20, n - 3)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/3dc255db.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import bbox_coords, colors_present, components_mask, get_bg\nfrom scipy import ndimage\n\n\ndef _flood_from_bbox_side(border_set: set, bbox: tuple, side: str) -> set:\n    \"\"\"4-conn flood within bbox, seeded from non-border cells on the given bbox edge,\n    stopping at border cells. Returns the set of reached cells (includes seeds).\"\"\"\n    r0, c0, r1, c1 = bbox\n    if side == \"U\":\n        seeds = [(r0, c) for c in range(c0, c1 + 1) if (r0, c) not in border_set]\n    elif side == \"D\":\n        seeds = [(r1, c) for c in range(c0, c1 + 1) if (r1, c) not in border_set]\n    elif side == \"L\":\n        seeds = [(r, c0) for r in range(r0, r1 + 1) if (r, c0) not in border_set]\n    else:  # \"R\"\n        seeds = [(r, c1) for r in range(r0, r1 + 1) if (r, c1) not in border_set]\n\n    visited = set(seeds)\n    stack = list(seeds)\n    while stack:\n        r, c = stack.pop()\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nr, nc = r + dr, c + dc\n            if not (r0 <= nr <= r1 and c0 <= nc <= c1):\n                continue\n            if (nr, nc) in visited or (nr, nc) in border_set:\n                continue\n            visited.add((nr, nc))\n            stack.append((nr, nc))\n    return visited\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Eject content pixels from cup-shaped frames outward along each cup's tail direction.\n\n    Input structure:\n    - bg = background. Hollow cup/Y/funnel frames, each a unique border color.\n    - Each cup has a convergent tail spike on one side and an open mouth on the opposite side.\n    - Content pixels (a single non-border color per cup) sit inside the cup's mouth interior.\n\n    Rule:\n    - For each cup, identify its tail spike and tail direction.\n    - Erase all content pixels from the mouth interior.\n    - Draw a straight line of content-colored pixels from the spike outward in the tail direction,\n      one pixel per erased content pixel; cells beyond the grid edge are dropped.\n\n    Key insight: The tail spike is the unique convergent point whose outward direction is opposite\n    the mouth opening where the content lives.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n    out = g.copy()\n\n    DIR4 = {\"U\": (-1, 0), \"D\": (1, 0), \"L\": (0, -1), \"R\": (0, 1)}\n    OPPOSITE = {\"U\": \"D\", \"D\": \"U\", \"L\": \"R\", \"R\": \"L\"}\n\n    for border_col in colors_present(g, exclude={bg}):\n        for border_coords in components_mask(g == int(border_col), connectivity=8):\n            if border_coords.size == 0 or int(border_coords.shape[0]) < 5:\n                continue\n\n            r0, c0, r1, c1 = (int(v) for v in bbox_coords(border_coords))\n            bbox = (r0, c0, r1, c1)\n            border_set = {(int(r), int(c)) for r, c in border_coords}\n            corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}\n\n            # Candidate tail spikes: single border cell on a bbox edge, not at a corner.\n            edges = (\n                (\"U\", [p for p in border_set if p[0] == r0]),\n                (\"D\", [p for p in border_set if p[0] == r1]),\n                (\"L\", [p for p in border_set if p[1] == c0]),\n                (\"R\", [p for p in border_set if p[1] == c1]),\n            )\n            candidates = [\n                (d, cells[0]) for d, cells in edges\n                if len(cells) == 1 and cells[0] not in corners\n            ]\n            if not candidates:\n                continue\n\n            # Each candidate: flood from opposite bbox side; keep candidates whose flood\n            # reaches content (non-bg, non-border) cells.\n            passing = []\n            for d, spike in candidates:\n                mouth = _flood_from_bbox_side(border_set, bbox, OPPOSITE[d])\n                cnt = Counter()\n                for r, c in mouth:\n                    v = int(g[r, c])\n                    if v != bg and v != int(border_col):\n                        cnt[v] += 1\n                if not cnt:\n                    continue\n                content_col = int(cnt.most_common(1)[0][0])\n                content_cells = [p for p in mouth if int(g[p[0], p[1]]) == content_col]\n                passing.append((d, spike, content_col, content_cells))\n\n            # Only act on cups with an unambiguous tail.\n            if len(passing) != 1:\n                continue\n            tail_dir, spike, content_col, content_cells = passing[0]\n\n            # Erase content, then eject outward.\n            for r, c in content_cells:\n                out[r, c] = bg\n\n            dr, dc = DIR4[tail_dir]\n            sr, sc = spike\n            for t in range(1, len(content_cells) + 1):\n                rr = sr + dr * t\n                cc = sc + dc * t\n                if not (0 <= rr < H and 0 <= cc < W):\n                    break\n                out[rr, cc] = content_col\n\n    return out\n\n# --------------- generator (claude opus) ---------------\n\n# ==== Generator configuration ====\n# Canvas size bounds (inclusive)\nGRID_H_RANGE = (10, 13)\nGRID_W_RANGE = (10, 13)\n\n# Number of cups per grid (choices sampled uniformly)\nNUM_CUPS_CHOICES = (1, 2, 3)\n\n# Cup bbox bounds for the canonical (tail=U) patch.\n# After rotation to L/R the axes swap, so both orientations must fit spec bbox 3..8 rows x 3..7 cols.\nCUP_BBOX_MAX_UD = (8, 7)  # (max_h, max_w) when tail is U or D\nCUP_BBOX_MAX_LR = (7, 8)  # (max_h, max_w) when tail is L or R\n\n# Arm-length ranges for the canonical Y/funnel (inclusive)\nARM_LEN_RANGE = (1, 3)        # L and R diagonal arm length\nWALL_EXT_RANGE = (0, 4)       # hL / hR (extra vertical wall cells after arm touches side)\n\n# Content pixel count cap (per cup)\nCONTENT_COUNT_MAX = 7\n\n# Stray-pixel probability and color choice probability (border vs content)\nSTRAY_PROB = 0.4\nSTRAY_USE_BORDER_PROB = 0.5\n\n# Retry budgets\nGEN_RETRIES_PRIMARY = 300     # retries that honor a pre-chosen num_cups\nGEN_RETRIES_FALLBACK = 300    # fallback retries with random num_cups\n# ==================================\n\nDIR4 = {\"U\": (-1, 0), \"D\": (1, 0), \"L\": (0, -1), \"R\": (0, 1)}\n_STRUCT8 = np.ones((3, 3), dtype=bool)\n\n\ndef _build_canonical_cup(L: int, R: int, hL: int, hR: int, color: int) -> tuple[np.ndarray, tuple[int, int]]:\n    \"\"\"Build a Y/funnel cup with tail pointing UP (spike at top, row 0).\n\n    Left arm is a diagonal of length L going down-left; right arm length R down-right.\n    After the left arm reaches col 0 (at row L), the left wall continues for hL more rows.\n    Likewise the right wall continues for hR rows after its arm reaches col L+R.\n    Requires hL + hR >= 1 so the bbox has enough vertical extent for a mouth.\n    Returns (patch, spike_rc); bg in patch is 0.\"\"\"\n    assert L >= 1 and R >= 1 and hL >= 0 and hR >= 0 and (hL + hR) >= 1\n    w = L + R + 1\n    h = max(L + hL, R + hR) + 1\n    g = np.zeros((h, w), dtype=int)\n    g[0, L] = color                                   # spike\n    g[np.arange(1, L + 1), L - np.arange(1, L + 1)] = color   # left arm\n    g[np.arange(1, R + 1), L + np.arange(1, R + 1)] = color   # right arm\n    if hL:\n        g[L + 1:L + hL + 1, 0] = color                # left wall\n    if hR:\n        g[R + 1:R + hR + 1, w - 1] = color            # right wall\n    return g, (0, L)\n\n\ndef _mouth_interior_coords(patch: np.ndarray, border_color: int, opposite_side: str) -> list[tuple[int, int]]:\n    \"\"\"Flood-fill the interior of the cup patch from cells on the given bbox edge, stopping at\n    the border. Returns the sorted list of interior coordinates (seeds included).\"\"\"\n    h, w = patch.shape\n    border_mask = (patch == border_color)\n    if opposite_side == \"U\":\n        seeds = [(0, c) for c in range(w) if not border_mask[0, c]]\n    elif opposite_side == \"D\":\n        seeds = [(h - 1, c) for c in range(w) if not border_mask[h - 1, c]]\n    elif opposite_side == \"L\":\n        seeds = [(r, 0) for r in range(h) if not border_mask[r, 0]]\n    else:  # \"R\"\n        seeds = [(r, w - 1) for r in range(h) if not border_mask[r, w - 1]]\n    visited = set(seeds)\n    stack = list(seeds)\n    while stack:\n        r, c = stack.pop()\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited and not border_mask[nr, nc]:\n                visited.add((nr, nc))\n                stack.append((nr, nc))\n    return sorted(visited)\n\n\ndef _rotate_to_direction(\n    patch: np.ndarray, spike: tuple[int, int], mouth: list[tuple[int, int]], direction: str,\n) -> tuple[np.ndarray, tuple[int, int], list[tuple[int, int]]]:\n    \"\"\"Rotate a canonical (tail=U) patch, its spike and mouth coords to the target tail direction.\"\"\"\n    h, w = patch.shape\n    sr, sc = spike\n    if direction == \"U\":\n        return patch.copy(), (sr, sc), list(mouth)\n    if direction == \"D\":\n        return np.flipud(patch).copy(), (h - 1 - sr, sc), [(h - 1 - r, c) for (r, c) in mouth]\n    if direction == \"L\":\n        # rot90 k=1 (CCW): old (r, c) -> new (w-1-c, r)\n        return np.rot90(patch, k=1).copy(), (w - 1 - sc, sr), [(w - 1 - c, r) for (r, c) in mouth]\n    if direction == \"R\":\n        # rot90 k=-1 (CW): old (r, c) -> new (c, h-1-r)\n        return np.rot90(patch, k=-1).copy(), (sc, h - 1 - sr), [(c, h - 1 - r) for (r, c) in mouth]\n    raise ValueError(direction)\n\n\ndef _sample_cup_shape(rng: np.random.Generator, direction: str) -> tuple[int, int, int, int] | None:\n    \"\"\"Pick (L, R, hL, hR) parameters for a canonical cup, clamped so the patch fits the\n    task's bbox spec after rotation. Returns None if no feasible shape could be derived.\"\"\"\n    if direction in (\"U\", \"D\"):\n        max_h_canon, max_w_canon = CUP_BBOX_MAX_UD\n    else:\n        max_h_canon, max_w_canon = CUP_BBOX_MAX_LR\n\n    lo, hi = ARM_LEN_RANGE\n    L_arm = int(rng.integers(lo, hi + 1))\n    R_arm = int(rng.integers(lo, hi + 1))\n    while L_arm + R_arm + 1 > max_w_canon:\n        if L_arm >= R_arm:\n            L_arm -= 1\n        else:\n            R_arm -= 1\n\n    wlo, whi = WALL_EXT_RANGE\n    hL = int(rng.integers(wlo, whi + 1))\n    hR = int(rng.integers(wlo, whi + 1))\n    if hL + hR == 0:\n        hL = 1\n    while max(L_arm + hL, R_arm + hR) + 1 > max_h_canon:\n        if L_arm + hL >= R_arm + hR and hL > 0:\n            hL -= 1\n        elif hR > 0:\n            hR -= 1\n        else:\n            break\n    if hL + hR == 0:\n        return None\n    return L_arm, R_arm, hL, hR\n\n\ndef _try_place_cup(\n    rng: np.random.Generator, H: int, W: int, patch: np.ndarray, spike: tuple[int, int],\n    direction: str, content_count: int, occ_cup: np.ndarray, occ_path: np.ndarray,\n) -> tuple[int, int, list[tuple[int, int]], list[tuple[int, int]]] | None:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/985ae207.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, crop_bbox, find_components, get_bg, paste\nimport random\n\nBBox = tuple[int, int, int, int]\n\n\ndef _intersects(a: BBox, b: BBox) -> bool:\n    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])\n\n\ndef _solid_rectangles(g: np.ndarray, bg: int, color: int) -> list[dict]:\n    rectangles: list[dict] = []\n    for comp in find_components(\n        g,\n        bg=bg,\n        connectivity=4,\n        monochromatic=True,\n        colors=[color],\n        return_format=\"dict\",\n    ):\n        h = bbox_h(comp[\"bbox\"])\n        w = bbox_w(comp[\"bbox\"])\n        if int(comp[\"area\"]) > 1 and int(comp[\"area\"]) == h * w:\n            rectangles.append(comp)\n    return rectangles\n\n\ndef _find_sprites(g: np.ndarray, bg: int) -> list[tuple[BBox, np.ndarray, int]]:\n    sprites: list[tuple[BBox, np.ndarray, int]] = []\n    for comp in find_components(\n        g,\n        bg=bg,\n        connectivity=4,\n        monochromatic=False,\n        return_format=\"dict\",\n    ):\n        b = comp[\"bbox\"]\n        if bbox_h(b) != 3 or bbox_w(b) != 3 or int(comp[\"area\"]) != 9:\n            continue\n\n        patch = crop_bbox(g, b)\n        border = np.ones((3, 3), dtype=bool)\n        border[1, 1] = False\n        border_colors = set(map(int, patch[border]))\n        if len(border_colors) != 1:\n            continue\n\n        body = border_colors.pop()\n        center = int(patch[1, 1])\n        if body == bg or center == bg or body == center:\n            continue\n        sprites.append((b, patch, center))\n\n    return sprites\n\n\ndef _direction_to_target(sprite: BBox, target: BBox) -> tuple[int, int]:\n    r0, c0, r1, c1 = sprite\n    tr0, tc0, tr1, tc1 = target\n    row_overlap = not (r1 < tr0 or tr1 < r0)\n    col_overlap = not (c1 < tc0 or tc1 < c0)\n\n    directions: list[tuple[int, int]] = []\n    if row_overlap and tc0 > c1:\n        directions.append((0, 1))\n    if row_overlap and tc1 < c0:\n        directions.append((0, -1))\n    if col_overlap and tr0 > r1:\n        directions.append((1, 0))\n    if col_overlap and tr1 < r0:\n        directions.append((-1, 0))\n\n    assert len(directions) == 1, \"expected exactly one cardinal target direction\"\n    return directions[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repeat each 3x3 control-center sprite toward the matching solid rectangle until a copy first overlaps that rectangle.\n\n    Input structure\n    - The background is the dominant color.\n    - Each sprite is a 3x3 foreground object whose eight border pixels have one color and whose center has a different control color.\n    - For every control color, there is exactly one separate solid rectangular object of that color.\n\n    Rule\n    - Match each sprite to the unique solid rectangle whose color equals the sprite center.\n    - Copy the whole 3x3 sprite in the cardinal direction of that rectangle, stepping by three cells each time.\n    - Stop after pasting the first copy whose 3x3 bbox overlaps the rectangle; copied pixels overwrite the rectangle there.\n\n    Key insight\n    The center pixel is not the paint color: it is a destination key, while the entire 3x3 sprite is the motif tiled along the straight path.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h >= 3 and w >= 3\n\n    bg = int(get_bg(g))\n    sprites = _find_sprites(g, bg)\n    assert sprites, \"expected at least one 3x3 control-center sprite\"\n\n    out = g.copy()\n    for sprite_bbox, patch, center in sprites:\n        targets = _solid_rectangles(g, bg, center)\n        assert len(targets) == 1, \"each control color must have one solid rectangular target\"\n        target_bbox = targets[0][\"bbox\"]\n        assert not _intersects(sprite_bbox, target_bbox), \"sprite and target must start separate\"\n\n        dr, dc = _direction_to_target(sprite_bbox, target_bbox)\n        r, c = sprite_bbox[0], sprite_bbox[1]\n\n        while True:\n            current_bbox = (r, c, r + 2, c + 2)\n            assert 0 <= r and r + 3 <= h and 0 <= c and c + 3 <= w\n            paste(out, patch, r, c)\n\n            if _intersects(current_bbox, target_bbox):\n                break\n\n            r += dr * 3\n            c += dc * 3\n\n    return out\n\n# --------------- generator (att1) ---------------\n# Canvas and colors.\nBG_COLOR, COLOR_COUNT = 8, 10\nGRID_MIN_SIZE, GRID_MAX_SIZE = 20, 25\n\n# Rectangles.\nRECT_COUNT_MIN, RECT_COUNT_MAX = 2, 4\nRECT_SIDE_MIN, RECT_SIDE_MAX = 2, 14\nRECT_MARGIN, RECT_SPACING_PAD = 1, 5\nRECT_PLACEMENT_ATTEMPTS = 50\n\n# Sprites and paths.\nSPRITE_SIZE, SPRITE_TOTAL_MAX = 3, 5\nSPRITE_GAPS = [1, 4, 7, 10]\nDIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n\n# Retry limits.\nGENERATION_ATTEMPTS = 300\n\n\ndef _intersects_check(a, b):\n    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])\n\n\ndef _has_bg_border(grid, sr, sc, bg):\n    H, W = grid.shape\n    for r in range(sr, sr + SPRITE_SIZE):\n        for c in range(sc, sc + SPRITE_SIZE):\n            for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < H and 0 <= nc < W:\n                    if not (sr <= nr < sr + SPRITE_SIZE and sc <= nc < sc + SPRITE_SIZE):\n                        if grid[nr, nc] != bg:\n                            return False\n    return True\n\n\ndef _sample_palette(bg):\n    all_colors = [c for c in range(COLOR_COUNT) if c != bg]\n    random.shuffle(all_colors)\n    num_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)\n    body_color = all_colors[0]\n    target_colors = all_colors[1:1 + num_rects]\n    return body_color, target_colors\n\n\ndef _rect_has_spacing(rect, rects, pad):\n    r0, c0, r1, c1 = rect\n    for rr0, rc0, rr1, rc1, _ in rects:\n        if not (r1 + pad < rr0 or rr1 + pad < r0 or c1 + pad < rc0 or rc1 + pad < c0):\n            return False\n    return True\n\n\ndef _place_rectangles(grid, target_colors):\n    H, W = grid.shape\n    rects = []\n    for color in target_colors:\n        for _ in range(RECT_PLACEMENT_ATTEMPTS):\n            rh = random.randint(RECT_SIDE_MIN, min(RECT_SIDE_MAX, H - 4))\n            rw = random.randint(RECT_SIDE_MIN, min(RECT_SIDE_MAX, W - 4))\n            r0 = random.randint(RECT_MARGIN, H - rh - RECT_MARGIN)\n            c0 = random.randint(RECT_MARGIN, W - rw - RECT_MARGIN)\n            r1 = r0 + rh - 1\n            c1 = c0 + rw - 1\n            if _rect_has_spacing((r0, c0, r1, c1), rects, RECT_SPACING_PAD):\n                rects.append((r0, c0, r1, c1, color))\n                break\n        else:\n            return None\n    for (r0, c0, r1, c1, color) in rects:\n        grid[r0:r1 + 1, c0:c1 + 1] = color\n    return rects\n\n\ndef _assign_sprites(rects):\n    num_rects = len(rects)\n    sprite_assignments = []\n    for i, (_, _, _, _, color) in enumerate(rects):\n        sprite_assignments.append((i, color))\n    max_extra = min(SPRITE_TOTAL_MAX - len(sprite_assignments), num_rects)\n    if max_extra > 0:\n        extra = random.randint(0, max_extra)\n        for _ in range(extra):\n            i = random.randint(0, num_rects - 1)\n            sprite_assignments.append((i, rects[i][4]))\n    if len(sprite_assignments) > SPRITE_TOTAL_MAX:\n        sprite_assignments = sprite_assignments[:SPRITE_TOTAL_MAX]\n    return sprite_assignments\n\n\ndef _candidate_sprite_position(rect, direction, gap, H, W):\n    r0, c0, r1, c1, _ = rect\n    dr, dc = direction\n    if dr == 0 and dc == 1:\n        sc = c0 - gap - SPRITE_SIZE\n        valid_rows = list(range(max(0, r0), min(H - SPRITE_SIZE, r1) + 1))\n        if not valid_rows:\n            return None\n        sr = random.choice(valid_rows)\n    elif dr == 0 and dc == -1:\n        sc = c1 + gap + 1\n        valid_rows = list(range(max(0, r0), min(H - SPRITE_SIZE, r1) + 1))\n        if not valid_rows:\n            return None\n        sr = random.choice(valid_rows)\n    elif dr == 1 and dc == 0:\n        sr = r0 - gap - SPRITE_SIZE\n        valid_cols = list(range(max(0, c0), min(W - SPRITE_SIZE, c1) + 1))\n        if not valid_cols:\n            return None\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/78332cb0.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import get_bg\nimport itertools\nimport random\nfrom arc_utils import is_contiguous, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reorder 5×5 blocks into a connected strip by matching edge foreground pixels.\n\n    Input structure:\n    - bg = background; sep = divider color (full row/column lines).\n    - Several 5×5 sprite blocks in a grid, separated by sep lines.\n\n    Rule:\n    - Two blocks \"connect\" when their facing edges share foreground pixels at the same offset (e.g., A's right edge ∩ B's left edge).\n    - Chain all blocks in the orientation (horizontal or vertical) that admits a complete sequence.\n    - Output is a 1×N strip of blocks in chain order, separated by sep lines.\n\n    Key insight: Edge-contact overlap determines both block ordering and output orientation.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    def _most_common(a: np.ndarray) -> int:\n        return int(Counter(map(int, a.flatten())).most_common(1)[0][0])\n\n    def _find_sep(a: np.ndarray) -> int:\n        H, W = a.shape\n        cand: list[int] = []\n        for r in range(H):\n            if bool((a[int(r), :] == int(a[int(r), 0])).all()) and int(a[int(r), 0]) != int(bg):\n                cand.append(int(a[int(r), 0]))\n        for c in range(W):\n            if bool((a[:, int(c)] == int(a[0, int(c)])).all()) and int(a[0, int(c)]) != int(bg):\n                cand.append(int(a[0, int(c)]))\n        return int(Counter(cand).most_common(1)[0][0])\n\n    sep = _find_sep(g)\n\n    def _full_sep_rows(a: np.ndarray) -> list[int]:\n        return [int(r) for r in range(int(a.shape[0])) if bool((a[int(r), :] == int(sep)).all())]\n\n    def _full_sep_cols(a: np.ndarray) -> list[int]:\n        return [int(c) for c in range(int(a.shape[1])) if bool((a[:, int(c)] == int(sep)).all())]\n\n    def _split_by_rows(a: np.ndarray) -> list[np.ndarray]:\n        rows = _full_sep_rows(a)\n        segs: list[np.ndarray] = []\n        start = 0\n        for r in rows + [int(a.shape[0])]:\n            if int(r) > int(start):\n                segs.append(a[int(start) : int(r), :].copy())\n            start = int(r + 1)\n        return segs\n\n    def _split_by_cols(a: np.ndarray) -> list[np.ndarray]:\n        cols = _full_sep_cols(a)\n        segs: list[np.ndarray] = []\n        start = 0\n        for c in cols + [int(a.shape[1])]:\n            if int(c) > int(start):\n                segs.append(a[:, int(start) : int(c)].copy())\n            start = int(c + 1)\n        return segs\n\n    def _render_strip(blocks: list[np.ndarray], axis: int) -> np.ndarray:\n        # axis=0: vertical stack (sep rows), axis=1: horizontal stack (sep cols)\n        n = int(len(blocks))\n        if int(axis) == 0:\n            out = np.full((int(n * 5 + (n - 1)), 5), int(bg), dtype=int)\n            rr = 0\n            for i, b in enumerate(blocks):\n                out[int(rr) : int(rr + 5), :] = b\n                rr += 5\n                if int(i) < int(n - 1):\n                    out[int(rr), :] = int(sep)\n                    rr += 1\n            return out\n        out = np.full((5, int(n * 5 + (n - 1))), int(bg), dtype=int)\n        cc = 0\n        for i, b in enumerate(blocks):\n            out[:, int(cc) : int(cc + 5)] = b\n            cc += 5\n            if int(i) < int(n - 1):\n                out[:, int(cc)] = int(sep)\n                cc += 1\n        return out\n\n    def _split_blocks() -> list[np.ndarray]:\n        \"\"\"Return list of 5x5 blocks (order doesn't matter; we will match by connect).\"\"\"\n        rows = _full_sep_rows(g)\n        cols = _full_sep_cols(g)\n        if rows and cols:\n            r = int(rows[0])\n            c = int(cols[0])\n            return [\n                g[:r, :c],\n                g[:r, int(c + 1) :],\n                g[int(r + 1) :, :c],\n                g[int(r + 1) :, int(c + 1) :],\n            ]\n        if rows:\n            return _split_by_rows(g)\n        if cols:\n            return _split_by_cols(g)\n        return []\n\n    def _contacts(block: np.ndarray) -> dict[str, set[int]]:\n        \"\"\"Edge contact sets (offsets) for the block's foreground.\"\"\"\n        bbg = int(_most_common(block))\n        m = block != int(bbg)\n        top = set(np.where(m[0, :])[0].tolist())\n        bot = set(np.where(m[-1, :])[0].tolist())\n        left = set(np.where(m[:, 0])[0].tolist())\n        right = set(np.where(m[:, -1])[0].tolist())\n        return {\"top\": top, \"bot\": bot, \"left\": left, \"right\": right}\n\n    def _find_chain(blocks: list[np.ndarray], orient: str):\n        \"\"\"Find an ordering p of indices such that consecutive blocks connect in orient.\"\"\"\n        import itertools\n\n        cont = [_contacts(b) for b in blocks]\n\n        def ok(a: int, b: int) -> bool:\n            if orient == \"h\":\n                return len(cont[int(a)][\"right\"] & cont[int(b)][\"left\"]) > 0\n            return len(cont[int(a)][\"bot\"] & cont[int(b)][\"top\"]) > 0\n\n        idx = list(range(int(len(blocks))))\n        for perm in itertools.permutations(idx):\n            if all(ok(perm[i], perm[i + 1]) for i in range(len(idx) - 1)):\n                return perm\n        return None\n\n    blocks = _split_blocks()\n    assert not (not blocks)\n\n    chain_h = _find_chain(blocks, \"h\")\n    chain_v = _find_chain(blocks, \"v\")\n\n    if chain_h is not None and chain_v is None:\n        ordered = [blocks[i] for i in chain_h]\n        return _render_strip(ordered, axis=1)\n    if chain_v is not None and chain_h is None:\n        ordered = [blocks[i] for i in chain_v]\n        return _render_strip(ordered, axis=0)\n    assert not (chain_h is not None and chain_v is not None), \"ambiguous: both H and V chains found\"\n    assert chain_h is not None or chain_v is not None, \"must find at least one valid chain\"\n\n# --------------- generator (Codex attempt 2) ---------------\n\n# -- Configuration constants --------------------------------------------------\nBG = 7                          # background color\nSEP = 6                         # separator color\nPALETTE = [1, 2, 3, 4, 5, 8, 9]  # allowed foreground colors\n\nBLOCK_SIZE = 5                  # sprite dimensions (square)\nFG_AREA_MIN = 4                 # min foreground pixels per block\nFG_AREA_MAX = 10                # max foreground pixels per block\nEDGE_CONTACT_OFFSETS = [1, 2, 3]  # valid shared-edge contact rows/cols (interior only)\nFILLER_ROWS = [1, 3]            # fallback interior rows for minimum-area seed\n\nGRID_LAYOUT_PROB = 0.5          # probability of 2x2 grid layout when n=4\nMAX_RETRIES = 300               # outer generate_input retry budget\n# -----------------------------------------------------------------------------\n\n_OTHER = {\"h\": \"v\", \"v\": \"h\"}\n# Edge-pair keys: (leading edge of predecessor, trailing edge of successor)\n_EDGE_PAIRS = {\"h\": (\"right\", \"left\"), \"v\": (\"bot\", \"top\")}\n# _make_block keyword mapping per orientation:\n#   orient -> (leading_kw, trailing_kw)\n_ORIENT_KW = {\"h\": (\"left\", \"right\"), \"v\": (\"top\", \"bottom\")}\n\n\ndef _edge_sets(block: np.ndarray) -> dict[str, set[int]]:\n    \"\"\"Return sets of fg-pixel offsets on each edge of a 5x5 block.\"\"\"\n    mask = block != BG\n    return {\n        \"top\": set(np.where(mask[0])[0].tolist()),\n        \"bot\": set(np.where(mask[-1])[0].tolist()),\n        \"left\": set(np.where(mask[:, 0])[0].tolist()),\n        \"right\": set(np.where(mask[:, -1])[0].tolist()),\n    }\n\n\ndef _count_orders(blocks: list[np.ndarray], orient: str) -> int:\n    \"\"\"Count how many permutations form a valid chain in the given orientation.\"\"\"\n    contacts = [_edge_sets(block) for block in blocks]\n    lead, trail = _EDGE_PAIRS[orient]\n\n    def ok(a: int, b: int) -> bool:\n        return bool(contacts[a][lead] & contacts[b][trail])\n\n    total = 0\n    for perm in itertools.permutations(range(len(blocks))):\n        if all(ok(perm[i], perm[i + 1]) for i in range(len(perm) - 1)):\n            total += 1\n    return total\n\n\ndef _interior_frontier(mask: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Return interior cells (rows/cols 1-3) adjacent to the mask but not yet set.\"\"\"\n    interior = mask[1:4, 1:4]\n    # 4-neighbor dilation within interior\n    has_neighbor = np.zeros_like(interior)\n    has_neighbor[1:, :] |= interior[:-1, :]\n    has_neighbor[:-1, :] |= interior[1:, :]\n    has_neighbor[:, 1:] |= interior[:, :-1]\n    has_neighbor[:, :-1] |= interior[:, 1:]\n    # also check neighbors from border rows/cols of the full mask\n    has_neighbor[0, :] |= mask[0, 1:4]   # row above interior\n    has_neighbor[2, :] |= mask[4, 1:4]   # row below interior\n    has_neighbor[:, 0] |= mask[1:4, 0]   # col left of interior\n    has_neighbor[:, 2] |= mask[1:4, 4]   # col right of interior\n    candidates = has_neighbor & ~interior\n    rs, cs = np.where(candidates)\n    return [(int(r) + 1, int(c) + 1) for r, c in zip(rs, cs)]\n\n\ndef _base_mask(left_offset: int | None, right_offset: int | None,\n               target_area: int) -> np.ndarray | None:\n    \"\"\"Build a connected fg mask on a 5x5 grid with prescribed left/right edge contacts.\n\n    The mask is seeded from the edge-contact offsets, then grown randomly through\n    interior cells until target_area is reached.  Returns None on constraint violation.\n    \"\"\"\n    S = BLOCK_SIZE\n    mask = np.zeros((S, S), dtype=bool)\n\n    # Seed from edge contacts -- horizontal arm + vertical spine to center col\n    if left_offset is not None:\n        mask[left_offset, 0:3] = True\n        mask[min(left_offset, 2):max(left_offset, 2) + 1, 2] = True\n    if right_offset is not None:\n        mask[right_offset, 2:S] = True\n        mask[min(right_offset, 2):max(right_offset, 2) + 1, 2] = True\n\n","exit_code":0,"status":"completed"}}
