{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/8f215267.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg\nfrom arc_utils import paste, random_free_location\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count same-color patterns per frame and represent the tally as dots inside.\n\n    Input structure:\n    - bg = most common color.\n    - Hollow rectangular frames in various colors.\n    - Small monochrome pattern sprites scattered outside frames.\n\n    Rule:\n    - Remove all small patterns from the grid.\n    - For each frame of color C, count how many patterns share color C.\n    - Draw that many dots along the frame's center row, spaced by 2, starting from the right.\n\n    Key insight: Frames act as tally displays — scattered same-color patterns are \"absorbed\" and their count is shown as interior dots.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    out = g.copy()\n    bg = int(get_bg(g))\n\n    regions = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n\n    frames: list[dict] = []\n    patterns: list[dict] = []\n    for comp in regions:\n        b = comp[\"bbox\"]\n        h = bbox_h(b)\n        w = bbox_w(b)\n        area = int(comp[\"area\"])\n        is_frame = (h >= 5) and (w >= 5) and (area < (h * w * 0.7))\n        if is_frame:\n            frames.append(comp)\n        else:\n            patterns.append(comp)\n\n    # Remove patterns from output.\n    for p in patterns:\n        for r, c in p[\"coords\"]:\n            out[int(r), int(c)] = bg\n\n    # For each frame, count matching patterns and draw dots.\n    for f in frames:\n        col = int(f[\"color\"])\n        num_patterns = sum(1 for p in patterns if int(p[\"color\"]) == col)\n        if num_patterns <= 0:\n            continue\n\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        r_mid = (r0 + r1) // 2\n        for i in range(int(num_patterns)):\n            cc = int(c1 - 2 - 2 * i)\n            if cc > int(c0):\n                out[int(r_mid), int(cc)] = col\n\n    return out\n\n# --------------- generator (codex-att2) ---------------\n\n# --- layout geometry ---\nFRAME_H = 5                    # frame height (rows)\nFRAME_W = 11                   # frame width (cols)\nFRAME_R0 = 1                   # top-left row of first frame\nFRAME_C0 = 1                   # top-left col of all frames\nFRAME_GAP = 2                  # bg rows between consecutive frames\nGRID_W = 23                    # fixed grid width\nRIGHT_C0 = 13                  # first column of the right (sprite) region\nRIGHT_W = 9                    # width of the right region\n\n# --- structural counts ---\nN_FRAMES_RANGE = (3, 5)        # [lo, hi) for number of frames\nN_DISTRACTORS_RANGE = (1, 3)   # [lo, hi) for distractor sprite count\nTOTAL_PATTERNS_RANGE = (5, 11) # [lo, hi) for total sprite count\nMAX_DOTS_PER_FRAME = 4         # max dot tally inside one frame\nBOTTOM_PAD_RANGE = (0, 7)      # [lo, hi) extra bg rows when n_frames==3\n\n# --- sprite shape ---\nSPRITE_AREA_RANGE = (2, 9)     # [lo, hi) connected-cell count per sprite\nSPRITE_MAX_H = 4               # max bbox height for sprite\nSPRITE_MAX_W = 3               # max bbox width for sprite\nSPRITE_PADDING = 1             # gap between placed sprites\n\n# --- retry budget ---\nMAX_ATTEMPTS = 300\n\n\ndef _frame_patch(color: int, bg: int, n_dots: int) -> np.ndarray:\n    \"\"\"Build a FRAME_H x FRAME_W hollow rectangle with n_dots on the center row.\"\"\"\n    patch = np.full((FRAME_H, FRAME_W), bg, dtype=int)\n    patch[0, :] = color\n    patch[-1, :] = color\n    patch[:, 0] = color\n    patch[:, -1] = color\n    mid_r = FRAME_H // 2\n    dot_cols = [FRAME_W - 3 - 2 * i for i in range(n_dots)]\n    patch[mid_r, dot_cols] = color\n    return patch\n\n\ndef _sample_counts(rng: np.random.Generator, n_frames: int, total_match: int) -> list[int]:\n    \"\"\"Distribute total_match sprites across n_frames, each capped at MAX_DOTS_PER_FRAME.\"\"\"\n    counts = [0] * n_frames\n    order = rng.permutation(n_frames)\n    remaining = total_match\n    for pos, idx in enumerate(order):\n        frames_left = n_frames - pos - 1\n        lo = max(0, remaining - MAX_DOTS_PER_FRAME * frames_left)\n        hi = min(MAX_DOTS_PER_FRAME, remaining)\n        val = int(rng.integers(lo, hi + 1))\n        counts[int(idx)] = val\n        remaining -= val\n    return counts\n\n\ndef _grow_sprite(rng: np.random.Generator, h: int, w: int, area: int) -> list[tuple[int, int]]:\n    \"\"\"Grow a connected polyomino of the given area inside an h x w bounding box.\"\"\"\n    seed = (int(rng.integers(0, h)), int(rng.integers(0, w)))\n    cells = {seed}\n    while len(cells) < area:\n        frontier = []\n        for r, c in cells:\n            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                nb = (r + dr, c + dc)\n                if 0 <= nb[0] < h and 0 <= nb[1] < w and nb not in cells:\n                    frontier.append(nb)\n        cells.add(frontier[int(rng.integers(0, len(frontier)))])\n    return list(cells)\n\n\ndef _make_sprite(rng: np.random.Generator, color: int, bg: int) -> np.ndarray:\n    \"\"\"Generate a small random connected sprite, tight-cropped to its bounding box.\"\"\"\n    area = int(rng.integers(*SPRITE_AREA_RANGE))\n    dims = [(h, w) for h in range(1, SPRITE_MAX_H + 1)\n            for w in range(1, SPRITE_MAX_W + 1) if h * w >= area]\n    h, w = dims[int(rng.integers(0, len(dims)))]\n    cells = _grow_sprite(rng, h, w, area)\n    rs, cs = zip(*cells)\n    r_min, c_min = min(rs), min(cs)\n    patch = np.full((max(rs) - r_min + 1, max(cs) - c_min + 1), bg, dtype=int)\n    for r, c in cells:\n        patch[r - r_min, c - c_min] = color\n    return patch\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    # --- choose structure ---\n    n_frames = int(rng.integers(*N_FRAMES_RANGE))\n    n_distractors = int(rng.integers(*N_DISTRACTORS_RANGE))\n    total_patterns = int(rng.integers(*TOTAL_PATTERNS_RANGE))\n    total_match = total_patterns - n_distractors\n\n    palette = rng.choice(np.arange(10), size=1 + n_frames + n_distractors, replace=False)\n    bg = int(palette[0])\n    frame_colors = [int(x) for x in palette[1 : 1 + n_frames]]\n    distractor_colors = [int(x) for x in palette[1 + n_frames :]]\n\n    counts = _sample_counts(rng, n_frames, total_match)\n    bottom_pad = int(rng.integers(*BOTTOM_PAD_RANGE)) if n_frames == 3 else 0\n    height = FRAME_R0 + n_frames * FRAME_H + (n_frames - 1) * FRAME_GAP + bottom_pad\n\n    # --- build output (frames with dots) ---\n    out = np.full((height, GRID_W), bg, dtype=int)\n    frame_rows: list[int] = []\n    for i, (color, count) in enumerate(zip(frame_colors, counts)):\n        r0 = FRAME_R0 + i * (FRAME_H + FRAME_GAP)\n        frame_rows.append(r0)\n        paste(out, _frame_patch(color, bg, count), r0, FRAME_C0)\n\n    # --- derive input (dots removed, sprites placed right) ---\n    inp = out.copy()\n    for r0, count in zip(frame_rows, counts):\n        mid_r = r0 + FRAME_H // 2\n        dot_cols = [FRAME_C0 + FRAME_W - 3 - 2 * i for i in range(count)]\n        inp[mid_r, dot_cols] = bg\n\n    right_canvas = np.full((height, RIGHT_W), bg, dtype=int)\n    pattern_colors = [c for c, n in zip(frame_colors, counts) for _ in range(n)]\n    pattern_colors.extend(distractor_colors)\n    rng.shuffle(pattern_colors)\n\n    try:\n        for color in pattern_colors:\n            sprite = _make_sprite(rng, color, bg)\n            r0, c0 = random_free_location(\n                right_canvas, sprite, transparent=bg,\n                padding=SPRITE_PADDING, padding_connectivity=8,\n            )\n            paste(right_canvas, sprite, r0, c0, transparent=bg)\n    except ValueError:\n        return None\n\n    paste(inp, right_canvas, 0, RIGHT_C0, transparent=bg)\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"failed to generate a valid input after {MAX_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/8a6d367c.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/8a6d367c.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, find_components, get_bg, paste\n\n\ndef _find_frame(g: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:\n    candidates: list[tuple[int, int, tuple[int, int, int, int]]] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        color = int(comp[\"color\"])\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        if h < 3 or w < 3:\n            continue\n\n        border = np.zeros((h, w), dtype=bool)\n        border[0, :] = True\n        border[-1, :] = True\n        border[:, 0] = True\n        border[:, -1] = True\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        if int(comp[\"area\"]) == int(border.sum()) and np.array_equal(sub == color, border):\n            candidates.append((int(comp[\"area\"]), color, (r0, c0, r1, c1)))\n\n    assert candidates, \"expected one rectangular frame\"\n    max_area = max(area for area, _color, _bbox in candidates)\n    largest = [candidate for candidate in candidates if candidate[0] == max_area]\n    assert len(largest) == 1, \"rectangular frame must be structurally unique\"\n    _area, color, frame_bbox = largest[0]\n    return color, frame_bbox\n\n\ndef _templates_above_frame(g: np.ndarray, bg: int, frame_r0: int) -> list[np.ndarray]:\n    top = g[:frame_r0]\n    templates: list[np.ndarray] = []\n    for color in np.unique(top):\n        color = int(color)\n        if color == bg:\n            continue\n        coords = np.argwhere(top == color)\n        r0, c0, r1, c1 = bbox_coords(coords)\n        templates.append(top[r0 : r1 + 1, c0 : c1 + 1] == color)\n\n    assert templates, \"expected upper template masks\"\n    return templates\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the framed area by expanding the unique upper template that contains the existing seed pixels.\n\n    Input structure:\n    - A teal background contains small colored template masks above a larger rectangular frame.\n    - The frame encloses one fill color arranged as a partial block-scaled copy of one template.\n    - The frame interior dimensions are an integer square scale of the matching template bbox.\n\n    Rule:\n    - Crop to the rectangular frame.\n    - Identify the unique upper template whose block-scaled mask covers every existing fill pixel inside the frame.\n    - Reset the frame interior to background and paint the whole scaled mask with the fill color.\n\n    Key insight:\n    The lower colored pixels are seed cells that reveal which upper template should be completed inside the frame.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    frame_color, (r0, c0, r1, c1) = _find_frame(g, bg)\n\n    out = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n    interior = out[1:-1, 1:-1]\n    fill_colors = set(map(int, np.unique(interior))) - {bg, frame_color}\n    assert len(fill_colors) == 1, \"frame interior must contain exactly one fill color\"\n    fill_color = fill_colors.pop()\n\n    seed = interior == fill_color\n    assert np.any(seed), \"frame must contain seed pixels\"\n    ih, iw = seed.shape\n\n    matches: list[np.ndarray] = []\n    for template in _templates_above_frame(g, bg, r0):\n        th, tw = template.shape\n        if ih % th != 0 or iw % tw != 0:\n            continue\n        scale_h = ih // th\n        scale_w = iw // tw\n        if scale_h != scale_w:\n            continue\n\n        scaled = np.kron(template, np.ones((scale_h, scale_w), dtype=bool))\n        if np.all(~seed | scaled):\n            matches.append(scaled)\n\n    assert len(matches) == 1, \"seed pixels must select exactly one scaled template\"\n    completed = matches[0]\n    assert completed.shape == interior.shape\n\n    interior[:, :] = bg\n    interior[completed] = fill_color\n    return out\n\n# --------------- generator (att2) ---------------\n\nGEN_BG = 8\nGEN_GRID_SHAPE = (27, 21)\nGEN_TEMPLATE_SHAPES = [(3, 3), (3, 4), (4, 3)]\nGEN_TEMPLATE_COUNT_RANGE = (2, 6)\nGEN_TEMPLATE_ROW = 1\nGEN_TEMPLATE_LEFT_MIN = 1\nGEN_TEMPLATE_GAP = 1\nGEN_MAX_TEMPLATE_SPAN = 19\nGEN_DENSITY_MIN_NUM = 1\nGEN_DENSITY_MIN_DEN = 2\nGEN_DENSITY_MAX_NUM = 5\nGEN_DENSITY_MAX_DEN = 6\nGEN_SCALE_RANGE = (2, 5)\nGEN_SEED_COUNTS = (2, 3)\nGEN_SEED_FRACTION_RANGE = (0.20, 0.60)\nGEN_FRAME_ROW_GAP = 2\nGEN_FRAME_LEFT_MIN = 1\nGEN_ATTEMPTS = 300\nGEN_PALETTE = [0, 1, 2, 3, 4, 5, 6, 7, 9]\n\ndef _gen_has_full_bbox(mask: np.ndarray) -> bool:\n    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())\n\n\ndef _gen_valid_masks(th: int, tw: int) -> list[np.ndarray]:\n    n = int(th * tw)\n    lo = (GEN_DENSITY_MIN_NUM * n + GEN_DENSITY_MIN_DEN - 1) // GEN_DENSITY_MIN_DEN\n    hi = (GEN_DENSITY_MAX_NUM * n) // GEN_DENSITY_MAX_DEN\n    masks: list[np.ndarray] = []\n    for bits in range(1 << n):\n        count = int(bits.bit_count())\n        if count < lo or count > hi:\n            continue\n        flat = np.array([(bits >> k) & 1 for k in range(n)], dtype=bool)\n        mask = flat.reshape(th, tw)\n        if _gen_has_full_bbox(mask):\n            masks.append(mask)\n    return masks\n\n\ndef _gen_colored_patch(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\n    patch = np.full(mask.shape, bg, dtype=int)\n    patch[mask] = int(color)\n    return patch\n\n\ndef _gen_draw_frame(shape: tuple[int, int], bg: int, frame_color: int) -> np.ndarray:\n    patch = np.full(shape, bg, dtype=int)\n    patch[0, :] = frame_color\n    patch[-1, :] = frame_color\n    patch[:, 0] = frame_color\n    patch[:, -1] = frame_color\n    return patch\n\n\ndef _gen_frame_patch(\n    target_mask: np.ndarray,\n    seed_cells: np.ndarray,\n    scale: int,\n    bg: int,\n    frame_color: int,\n    fill_color: int,\n) -> tuple[np.ndarray, np.ndarray]:\n    th, tw = map(int, target_mask.shape)\n    scaled = np.kron(target_mask, np.ones((scale, scale), dtype=bool))\n    out = _gen_draw_frame((th * scale + 2, tw * scale + 2), bg, frame_color)\n    out[1:-1, 1:-1][scaled] = fill_color\n\n    frame = _gen_draw_frame(out.shape, bg, frame_color)\n    for r, c in seed_cells:\n        rr = int(r) * scale\n        cc = int(c) * scale\n        frame[1 + rr : 1 + rr + scale, 1 + cc : 1 + cc + scale] = fill_color\n    return frame, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n    bg = GEN_BG\n    count = int(rng.integers(*GEN_TEMPLATE_COUNT_RANGE))\n    shape_choices = [\n        shape for shape in GEN_TEMPLATE_SHAPES if count * shape[1] + count - 1 <= GEN_MAX_TEMPLATE_SPAN\n    ]\n    th, tw = shape_choices[int(rng.integers(0, len(shape_choices)))]\n    scale = int(rng.integers(*GEN_SCALE_RANGE))\n\n    valid_masks = _gen_valid_masks(th, tw)\n    if len(valid_masks) < count:\n        return None\n\n    target = valid_masks[int(rng.integers(0, len(valid_masks)))]\n    true_cells = np.argwhere(target)\n    target_area = int(len(true_cells))\n    min_seed_frac, max_seed_frac = GEN_SEED_FRACTION_RANGE\n    seed_counts = [k for k in GEN_SEED_COUNTS if min_seed_frac <= k / target_area <= max_seed_frac]\n    if not seed_counts:\n        return None\n    seed_count = int(seed_counts[int(rng.integers(0, len(seed_counts)))])\n    seed_idx = rng.choice(target_area, size=seed_count, replace=False)\n    seed_cells = true_cells[seed_idx]\n\n    covers_seed = np.array([bool(mask[seed_cells[:, 0], seed_cells[:, 1]].all()) for mask in valid_masks])\n    distractor_pool = [mask for mask, covers in zip(valid_masks, covers_seed) if not covers]\n    if len(distractor_pool) < count - 1:\n        return None\n    distractor_idx = rng.choice(len(distractor_pool), size=count - 1, replace=False)\n    distractors = [distractor_pool[int(i)] for i in distractor_idx]\n\n    masks = distractors + [target]\n    rng.shuffle(masks)\n\n    colors = list(GEN_PALETTE)\n    rng.shuffle(colors)\n    frame_color = int(colors[0])\n    fill_color = int(colors[1])\n    template_colors = [int(c) for c in colors[2 : 2 + count]]\n\n    frame, expected = _gen_frame_patch(target, seed_cells, scale, bg, frame_color, fill_color)\n    grid_h, grid_w = GEN_GRID_SHAPE\n    grid = np.full(GEN_GRID_SHAPE, bg, dtype=int)\n\n    total_template_w = count * tw + count - 1\n    template_c0 = int(rng.integers(GEN_TEMPLATE_LEFT_MIN, grid_w - total_template_w))\n    c = template_c0\n    for mask, color in zip(masks, template_colors):\n        paste(grid, _gen_colored_patch(mask, color, bg), GEN_TEMPLATE_ROW, c, transparent=bg)\n        c += tw + GEN_TEMPLATE_GAP\n\n    fh, fw = map(int, frame.shape)\n    min_r0 = th + GEN_FRAME_ROW_GAP\n    max_r0 = grid_h - fh\n    if min_r0 > max_r0:\n        return None\n    frame_r0 = int(rng.integers(min_r0, max_r0 + 1))\n    frame_c0 = int(rng.integers(GEN_FRAME_LEFT_MIN, grid_w - fw))\n","exit_code":0,"status":"completed"}}
