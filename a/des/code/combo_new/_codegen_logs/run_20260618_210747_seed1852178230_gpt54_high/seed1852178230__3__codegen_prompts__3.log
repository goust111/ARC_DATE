{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom z3 import *\n\ndef solve(h,w,timeout=20000):\n    n=h*w\n    x=[[Bool(f'x_{r}_{c}') for c in range(w)] for r in range(h)]\n    da=[[Int(f'da_{r}_{c}') for c in range(w)] for r in range(h)]\n    db=[[Int(f'db_{r}_{c}') for c in range(w)] for r in range(h)]\n    s=Solver(); s.set(timeout=timeout)\n    # symmetry: both colors on top edge\n    s.add(x[0][0])\n    s.add(Not(x[0][1]))\n    for r in range(h):\n        for c in range(w):\n            s.add(And(da[r][c] >= 0, da[r][c] <= n))\n            s.add(And(db[r][c] >= 0, db[r][c] <= n))\n            s.add(If(x[r][c], da[r][c] < n, da[r][c] == n))\n            s.add(If(Not(x[r][c]), db[r][c] < n, db[r][c] == n))\n    # choose unique roots anywhere in color\n    roota=[[Bool(f'ra_{r}_{c}') for c in range(w)] for r in range(h)]\n    rootb=[[Bool(f'rb_{r}_{c}') for c in range(w)] for r in range(h)]\n    s.add(PbEq([(roota[r][c],1) for r in range(h) for c in range(w)],1))\n    s.add(PbEq([(rootb[r][c],1) for r in range(h) for c in range(w)],1))\n    for r in range(h):\n        for c in range(w):\n            s.add(Implies(roota[r][c], x[r][c]))\n            s.add(Implies(rootb[r][c], Not(x[r][c])))\n            s.add(If(roota[r][c], da[r][c]==0, Implies(x[r][c], da[r][c]>0)))\n            s.add(If(rootb[r][c], db[r][c]==0, Implies(Not(x[r][c]), db[r][c]>0)))\n            ns=[(r+1,c),(r-1,c),(r,c+1),(r,c-1)]\n            ns=[(nr,nc) for nr,nc in ns if 0<=nr<h and 0<=nc<w]\n            s.add(Implies(And(x[r][c], da[r][c] > 0), Or(*[And(x[nr][nc], da[nr][nc] < da[r][c]) for nr,nc in ns])))\n            s.add(Implies(And(Not(x[r][c]), db[r][c] > 0), Or(*[And(Not(x[nr][nc]), db[nr][nc] < db[r][c]) for nr,nc in ns])))\n    for pts in [[(0,c) for c in range(w)],[(h-1,c) for c in range(w)],[(r,0) for r in range(h)],[(r,w-1) for r in range(h)]]:\n        s.add(Or(*[x[r][c] for r,c in pts]))\n        s.add(Or(*[Not(x[r][c]) for r,c in pts]))\n    res=s.check()\n    print('res',res)\n    if res==sat:\n        m=s.model()\n        for r in range(h):\n            print(''.join('#' if is_true(m.eval(x[r][c])) else '.' for c in range(w)))\n\nfor size in [(7,7),(8,8)]:\n    print(size)\n    solve(*size)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
