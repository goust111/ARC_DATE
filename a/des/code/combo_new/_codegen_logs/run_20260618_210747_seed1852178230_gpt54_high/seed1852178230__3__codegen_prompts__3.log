{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\n\ndef comp_stats(mask,val):\n    h=len(mask); w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    if not pts: return 0,0\n    seen=set([pts[0]]); q=deque([pts[0]])\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    touch=sum([\n        any(mask[0][c]==val for c in range(w)),\n        any(mask[h-1][c]==val for c in range(w)),\n        any(mask[r][0]==val for r in range(h)),\n        any(mask[r][w-1]==val for r in range(h)),\n    ])\n    return len(seen)==len(pts), touch\n\ndef score(mask):\n    ca,ta=comp_stats(mask,True)\n    cb,tb=comp_stats(mask,False)\n    s=(10 if ca else 0)+(10 if cb else 0)+ta+tb\n    return s\n\ndef mutate(mask):\n    h=len(mask); w=len(mask[0])\n    out=[row[:] for row in mask]\n    for _ in range(random.randint(1,3)):\n        r=random.randrange(h); c=random.randrange(w)\n        out[r][c]=not out[r][c]\n    return out\n\nfor h,w in [(5,5),(6,6),(6,7),(7,7),(8,8)]:\n    best=None; bests=-1\n    for restart in range(200):\n        m=[[random.random()<0.5 for _ in range(w)] for _ in range(h)]\n        s=score(m)\n        temp=5.0\n        for it in range(2000):\n            n=mutate(m)\n            sn=score(n)\n            if sn>s or random.random()<pow(2.71828,(sn-s)/max(temp,1e-3)):\n                m,s=n,sn\n            temp*=0.999\n            if s>bests:\n                bests=s; best=[row[:] for row in m]\n            if s==28:\n                print('found',h,w)\n                print('\\\\n'.join(''.join('#' if x else '.' for x in row) for row in m))\n                raise SystemExit\n    print('size',h,w,'best',bests)\n    print('\\\\n'.join(''.join('#' if x else '.' for x in row) for row in best))\n    print()\nprint('none')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
