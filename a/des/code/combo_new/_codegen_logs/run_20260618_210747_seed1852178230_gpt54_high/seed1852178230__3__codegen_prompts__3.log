{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom itertools import product\nfrom collections import deque\n\ndef connected(grid,val):\n    h=len(grid); w=len(grid[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==val]\n    if not pts: return False\n    q=deque([pts[0]]); seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and grid[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef touch(grid,val):\n    h=len(grid); w=len(grid[0])\n    return all([\n        any(grid[0][c]==val for c in range(w)),\n        any(grid[h-1][c]==val for c in range(w)),\n        any(grid[r][0]==val for r in range(h)),\n        any(grid[r][w-1]==val for r in range(h)),\n    ])\n\nh=w=6\n# boundary pattern: alternate ownership by halves along each side\nbase=[[None]*w for _ in range(h)]\n# top\nfor c in range(w): base[0][c] = c < w//2\n# right\nfor r in range(1,h-1): base[r][w-1] = r < h//2\n# bottom\nfor c in range(w): base[h-1][c] = c >= w//2\n# left\nfor r in range(1,h-1): base[r][0] = r >= h//2\n# corners maybe overwritten consistently?\nprint('boundary:')\nfor row in base: print(''.join('#' if v is True else '.' if v is False else '?' for v in row))\ninterior=[(r,c) for r in range(1,h-1) for c in range(1,w-1)]\nfor bits in range(1<<len(interior)):\n    g=[row[:] for row in base]\n    for i,(r,c) in enumerate(interior):\n        g[r][c]=bool((bits>>i)&1)\n    if connected(g,True) and connected(g,False) and touch(g,True) and touch(g,False):\n        print('found')\n        for row in g: print(''.join('#' if x else '.' for x in row))\n        break\nelse:\n    print('none')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
