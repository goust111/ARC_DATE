{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom itertools import product\nfrom collections import deque\n\ndef stats(grid,val):\n    h=len(grid); w=len(grid[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==val]\n    if not pts: return False,0\n    seen={pts[0]}; q=deque([pts[0]])\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and grid[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    touch=sum([\n        any(grid[0][c]==val for c in range(w)),\n        any(grid[h-1][c]==val for c in range(w)),\n        any(grid[r][0]==val for r in range(h)),\n        any(grid[r][w-1]==val for r in range(h)),\n    ])\n    return len(seen)==len(pts), touch\n\nfor h,w in [(5,6),(6,6),(7,6)]:\n    odd_cols=[c for c in range(w) if c%2==1]\n    even_cols=[c for c in range(w) if c%2==0]\n    rows=range(h)\n    cnt=0\n    for a_bits in product(rows, repeat=len(odd_cols)):\n        for b_bits in product(rows, repeat=len(even_cols)):\n            cnt+=1\n            g=[[c%2==0 for c in range(w)] for _ in range(h)]\n            for c,row in zip(odd_cols,a_bits):\n                for r in range(h):\n                    g[r][c]=False\n                g[row][c]=True\n            for c,row in zip(even_cols,b_bits):\n                for r in range(h):\n                    g[r][c]=True\n                g[row][c]=False\n            sa=stats(g,True); sb=stats(g,False)\n            if sa==(True,4) and sb==(True,4):\n                print('found',h,w,a_bits,b_bits)\n                for row in g:\n                    print(''.join('#' if x else '.' for x in row))\n                raise SystemExit\n    print('searched',cnt,'for',h,w)\nprint('none')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
