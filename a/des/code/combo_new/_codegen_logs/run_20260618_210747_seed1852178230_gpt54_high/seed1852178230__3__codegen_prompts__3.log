{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom itertools import product\nfrom collections import deque\n\ndef conn(mask):\n    h=len(mask); w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]]\n    if not pts: return False\n    q=deque([pts[0]]); seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc] and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef touches(mask):\n    h=len(mask); w=len(mask[0])\n    return any(mask[0][c] for c in range(w)) and any(mask[h-1][c] for c in range(w)) and any(mask[r][0] for r in range(h)) and any(mask[r][w-1] for r in range(h))\n\nfor h,w in [(4,4),(4,5),(5,5)]:\n    found=[]\n    n=h*w\n    for bits in range(1,1<<n):\n        if bits & 1 == 0:\n            pass\n        mask=[[False]*w for _ in range(h)]\n        for i in range(n):\n            if bits>>i &1:\n                mask[i//w][i%w]=True\n        comp=[[not mask[r][c] for c in range(w)] for r in range(h)]\n        if conn(mask) and conn(comp) and touches(mask) and touches(comp):\n            found.append(mask)\n            if len(found)>=5:\n                break\n    print((h,w), len(found))\n    for mask in found[:3]:\n        print('\\\\n'.join(''.join('#' if x else '.' for x in row) for row in mask))\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
