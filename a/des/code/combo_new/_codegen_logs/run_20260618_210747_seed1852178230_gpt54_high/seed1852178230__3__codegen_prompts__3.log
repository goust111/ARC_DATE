{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, math\nfrom collections import deque\n\ndef comp_stats(mask,val):\n    h=len(mask); w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    if not pts: return False,0\n    seen={pts[0]}; q=deque([pts[0]])\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    conn=len(seen)==len(pts)\n    touch=sum([\n        any(mask[0][c]==val for c in range(w)),\n        any(mask[h-1][c]==val for c in range(w)),\n        any(mask[r][0]==val for r in range(h)),\n        any(mask[r][w-1]==val for r in range(h)),\n    ])\n    return conn,touch\n\ndef score(mask):\n    ca,ta=comp_stats(mask,True)\n    cb,tb=comp_stats(mask,False)\n    return (10 if ca else 0)+(10 if cb else 0)+ta+tb, (ca,ta,cb,tb)\n\ndef mutate(mask):\n    h=len(mask); w=len(mask[0])\n    out=[row[:] for row in mask]\n    for _ in range(random.randint(1,3)):\n        r=random.randrange(h); c=random.randrange(w)\n        out[r][c]=not out[r][c]\n    return out\n\nh,w=6,6\nbest=None; bests=-1; bestinfo=None\nfor restart in range(400):\n    m=[[random.random()<0.5 for _ in range(w)] for _ in range(h)]\n    s,info=score(m)\n    temp=3.0\n    for it in range(5000):\n        n=mutate(m)\n        sn,info_n=score(n)\n        if sn>s or random.random()<math.exp((sn-s)/max(temp,1e-3)):\n            m,s,info=n,sn,info_n\n        temp*=0.9995\n        if s>bests:\n            bests=s; best=[row[:] for row in m]; bestinfo=info\n            print('new best',bests,bestinfo)\n            print('\\\\n'.join(''.join('#' if x else '.' for x in row) for row in best))\n            print()\n        if s==28:\n            raise SystemExit\nprint('done')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
