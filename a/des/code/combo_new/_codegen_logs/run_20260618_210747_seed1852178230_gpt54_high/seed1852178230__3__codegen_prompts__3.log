r: break\n        cells.add(random.choice(list(frontier)))\n    for r,c in cells:\n        mask[r][c]=True\n    return mask\n\nfor h,w in [(4,5),(5,5),(5,6),(6,6)]:\n    print('\"'size',h,w)\n    found=0\n    for _ in range(5000):\n        m=grow(h,w)\n        if conn(m,True) and conn(m,False) and touches(m,True) and touches(m,False):\n            found+=1\n            print('\\\\n'.join(''.join('#' if x else '.' for x in row) for row in m))\n            print()\n            if found>=5: break\n    print('found',found)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
