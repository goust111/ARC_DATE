int('done')\nPY\"","aggregated_output":"new best 18 (True, 4, False, 4)\n..#####...\n..#.#.#.#.\n.##.######\n.###..####\n##.#..###.\n.#.##.#..#\n...#######\n###.#.####\n.#####.###\n.##.##....\n\nTraceback (most recent call last):\n  File \"<stdin>\", line 45, in <module>\n  File \"<stdin>\", line 26, in score\n  File \"<stdin>\", line 13, in comp_stats\nKeyboardInterrupt\n","exit_code":130,"status":"failed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom itertools import product\nfrom collections import deque\n\ndef check(grid):\n    h=len(grid); w=len(grid[0])\n    def stats(val):\n        pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==val]\n        if not pts: return False,0\n        seen={pts[0]}; q=deque([pts[0]])\n        while q:\n            r,c=q.popleft()\n            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                nr,nc=r+dr,c+dc\n                if 0<=nr<h and 0<=nc<w and grid[nr][nc]==val and (nr,nc) not in seen:\n                    seen.add((nr,nc)); q.append((nr,nc))\n        touch=sum([\n            any(grid[0][c]==val for c in range(w)),\n            any(grid[h-1][c]==val for c in range(w)),\n            any(grid[r][0]==val for r in range(h)),\n            any(grid[r][w-1]==val for r in range(h)),\n        ])\n        return len(seen)==len(pts), touch\n    return stats(True), stats(False)\n\nfor h,w in [(5,6),(6,6),(7,6),(8,6),(7,8)]:\n    odd_cols=[c for c in range(w) if c%2==1]\n    even_cols=[c for c in range(w) if c%2==0]\n    found=False\n    for a_bits in product([0,h-1], repeat=len(odd_cols)):\n        for b_bits in product([0,h-1], repeat=len(even_cols)):\n            g=[[c%2==0 for c in range(w)] for _ in range(h)]\n            # odd cols base B; set one A bridge\n            for c,row in zip(odd_cols,a_bits):\n                for r in range(h):\n                    g[r][c]=False\n                g[row][c]=True\n            # even cols base A; set one B bridge\n            for c,row in zip(even_cols,b_bits):\n                for r in range(h):\n                    g[r][c]=True\n                g[row][c]=False\n            sa,sb=check(g)\n            if sa==(True,4) and sb==(True,4):\n                print('found',h,w,a_bits,b_bits)\n                for row in g:\n                    print(''.join('#' if x else '.' for x in row))\n                found=True\n                raise SystemExit\n    print('none for',h,w)\nprint('done')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
