{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom z3 import *\n\ndef find(h,w):\n    n=h*w\n    x=[[Bool(f'x_{r}_{c}') for c in range(w)] for r in range(h)]\n    da=[[Int(f'da_{r}_{c}') for c in range(w)] for r in range(h)]\n    db=[[Int(f'db_{r}_{c}') for c in range(w)] for r in range(h)]\n    s=Solver()\n    # nontrivial colors\n    for r in range(h):\n        for c in range(w):\n            s.add(And(da[r][c] >= 0, da[r][c] <= n))\n            s.add(And(db[r][c] >= 0, db[r][c] <= n))\n    # edge touch both colors\n    edges = {\n        'top':[(0,c) for c in range(w)],\n        'bot':[(h-1,c) for c in range(w)],\n        'left':[(r,0) for r in range(h)],\n        'right':[(r,w-1) for r in range(h)],\n    }\n    for pts in edges.values():\n        s.add(Or(*[x[r][c] for r,c in pts]))\n        s.add(Or(*[Not(x[r][c]) for r,c in pts]))\n    # roots unique via depth 0 on color, others >0\n    s.add(PbEq([(And(x[r][c], da[r][c]==0),1) for r in range(h) for c in range(w)], 1))\n    s.add(PbEq([(And(Not(x[r][c]), db[r][c]==0),1) for r in range(h) for c in range(w)], 1))\n    for r in range(h):\n        for c in range(w):\n            na=[(r+1,c),(r-1,c),(r,c+1),(r,c-1)]\n            na=[(nr,nc) for nr,nc in na if 0<=nr<h and 0<=nc<w]\n            s.add(Implies(x[r][c], da[r][c] < n))\n            s.add(Implies(Not(x[r][c]), db[r][c] < n))\n            s.add(Implies(And(x[r][c], da[r][c] > 0), Or(*[And(x[nr][nc], da[nr][nc] < da[r][c]) for nr,nc in na])))\n            s.add(Implies(And(Not(x[r][c]), db[r][c] > 0), Or(*[And(Not(x[nr][nc]), db[nr][nc] < db[r][c]) for nr,nc in na])))\n    # symmetry break\n    s.add(x[0][0])\n    if s.check()\"'!=sat:\n        print('\"'none',h,w)\n        return\n    m=s.model()\n    rows=[]\n    for r in range(h):\n        row=''.join('#' if is_true(m.eval(x[r][c])) else '.' for c in range(w))\n        rows.append(row)\n    print('size',h,w)\n    print('\\\\n'.join(rows))\n\nfor h,w in [(4,4),(4,5),(5,5),(5,6),(6,6)]:\n    find(h,w)\n    print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\n\ndef cycle(h,w):\n    assert w%2==0 and h>=2\n    cells=[]\n    cells.extend((0,c) for c in range(w))\n    for r in range(1,h):\n        if r%2==1:\n            cells.extend((r,c) for c in range(w-1,0,-1))\n        else:\n            cells.extend((r,c) for c in range(1,w))\n    cells.extend((r,0) for r in range(h-1,0,-1))\n    assert len(cells)==h*w\n    assert len(set(cells))==h*w\n    return cells\n\ndef touches(cells,h,w):\n    s=set(cells)\n    return any(r==0 for r,c in s) and any(r==h-1 for r,c in s) and any(c==0 for r,c in s) and any(c==w-1 for r,c in s)\n\nfor h,w in [(4,4),(5,4),(5,6),(6,6)]:\n    cyc=cycle(h,w)\n    n=len(cyc)\n    cands=[]\n    for start in range(n):\n        for L in range(1,n):\n            arc=[cyc[(start+i)%n] for i in range(L)]\n            other=[cyc[(start+L+i)%n] for i in range(n-L)]\n            if touches(arc,h,w) and touches(other,h,w):\n                cands.append((start,L))\n    print((h,w), len(cands), cands[:10])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
