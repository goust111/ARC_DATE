c1+1]=True\n\n\ndef gen_once(rng):\n    n=rng.randint(2,4)\n    top=rng.randint(1,2); bottom=rng.randint(1,2)\n    H=top+n*BOX+(n-1)*GAP+bottom\n    sep_gap=rng.randint(1,3); right_margin=rng.randint(1,3)\n    left_w=rng.randint(12, 30-(1+sep_gap+BOX+right_margin))\n    W=left_w+1+sep_gap+BOX+right_margin\n    blocked=np.zeros((H,left_w),dtype=bool)\n    dirs=['down','left','right']\n    rng.shuffle(dirs)\n    targets=[]\n    for i in range(n):\n        if i<3:\n            targets.append(dirs[i])\n        else:\n            targets.append(rng.choice(['down','left','right']))\n    pairs=[]\n    for i in range(n):\n        row_lo=top+i*(BOX+GAP)\n        row_hi=row_lo+BOX-1\n        target=targets[i]\n        ok=None\n        for att in range(500):\n            temp=blocked.copy()\n            segs=[]\n            good=True\n            for _ in range(2):\n                placed=False\n                for _ in range(200):\n                    seg=sample_segment(rng,row_lo,row_hi,1,left_w-2)\n                    if seg and can_place(seg,temp):\n                        mark(seg,temp)\n                        segs.append(seg)\n                        placed=True\n                        break\n                if not placed:\n                    good=False\n                    break\n            if not good:\n                continue\n            if infer(segs)==target:\n                ok=segs\n                blocked=temp\n                break\n        if ok is None:\n            return False\n        pairs.append(ok)\n    return True\n\nrng=random.Random(0)\ncount=0\nfor i in range(200):\n    if gen_once(rng):\n        count+=1\nprint('ok',count)\nPY\"","aggregated_output":"ok 200\n","exit_code":0,"status":"completed"}}
