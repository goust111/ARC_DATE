{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom itertools import product\n\ndef cells(seg):\n    r,c,o,L = seg\n    if o=='h':\n        return {(r, c+i) for i in range(L)}\n    return {(r+i, c) for i in range(L)}\n\ndef bbox_top(seg):\n    return seg[0]\n\ndef midpoint(seg):\n    r,c,o,L=seg\n    if o=='h':\n        return (r, c + (L-1)//2)\n    return (r + (L-1)//2, c)\n\ndef conn(a,b):\n    A,B=cells(a),cells(b)\n    for r,c in A:\n        if (r,c) in B: return True\n        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:\n            if (r+dr,c+dc) in B: return True\n    return False\n\nsegs=[]\nfor r in range(6):\n  for c in range(6):\n    for o in 'hv':\n      for L in range(2,6):\n        # keep within 8x8\n        if o=='h' and c+L-1>=8: continue\n        if o=='v' and r+L-1>=8: continue\n        segs.append((r,c,o,L))\n\nfound=[]\nfor a in segs:\n  for b in segs:\n    if a==b or conn(a,b):\n      continue\n    # a is first if bbox_top smaller or tie by left col maybe smaller\n    ta,tb=bbox_top(a),bbox_top(b)\n    if ta>tb: continue\n    if ta==tb and a[1]>b[1]: continue\n    ma=midpoint(a); mb=midpoint(b)\n    dr=mb[0]-ma[0]; dc=mb[1]-ma[1]\n    if abs(dr)>abs(dc) and dr<0:\n      found.append((a,b,ma,mb,(dr,dc)))\n      if len(found)>=20: break\n  if len(found)>=20: break\nprint('found', len(found))\nfor item in found[:10]:\n  print(item)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom itertools import product\n\ndef cells(seg):\n    r,c,o,L = seg\n    if o=='h':\n        return {(r, c+i) for i in range(L)}\n    return {(r+i, c) for i in range(L)}\n\ndef bbox_top(seg):\n    return seg[0]\n\ndef midpoint(seg):\n    r,c,o,L=seg\n    if o=='h':\n        return (r, c + (L-1)//2)\n    return (r + (L-1)//2, c)\n\ndef conn(a,b):\n    A,B=cells(a),cells(b)\n    for r,c in A:\n        if (r,c) in B: return True\n        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:\n            if (r+dr,c+dc) in B: return True\n    return False\n\nsegs=[]\nfor r in range(6):\n  for c in range(6):\n    for o in 'hv':\n      for L in range(2,6):\n        # keep within 8x8\n        if o=='h' and c+L-1>=8: continue\n        if o=='v' and r+L-1>=8: continue\n        segs.append((r,c,o,L))\n\nfound=[]\nfor a in segs:\n  for b in segs:\n    if a==b or conn(a,b):\n      continue\n    # a is first if bbox_top smaller or tie by left col maybe smaller\n    ta,tb=bbox_top(a),bbox_top(b)\n    if ta>tb: continue\n    if ta==tb and a[1]>b[1]: continue\n    ma=midpoint(a); mb=midpoint(b)\n    dr=mb[0]-ma[0]; dc=mb[1]-ma[1]\n    if abs(dr)>abs(dc) and dr<0:\n      found.append((a,b,ma,mb,(dr,dc)))\n      if len(found)>=20: break\n  if len(found)>=20: break\nprint('found', len(found))\nfor item in found[:10]:\n  print(item)\nPY\"","aggregated_output":"found 0\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nimport numpy as np\nfrom collections import Counter\n\nBG=0\nSEP=5\nPALETTE=[1,2,3,4,6,7,8,9]\nBOX=5\nGAP=2\n\n\ndef bbox(seg):\n    cells=seg['cells']\n    rs=[r for r,c in cells]\n    cs=[c for r,c in cells]\n    return min(rs),min(cs),max(rs),max(cs)\n\ndef midpoint(seg):\n    r0,c0,r1,c1=bbox(seg)\n    if r0==r1:\n        return (r0, c0 + (c1-c0)//2)\n    return (r0 + (r1-r0)//2, c0)\n\ndef order_pair(segs):\n    return sorted(segs, key=lambda s:(bbox(s)[0], bbox(s)[1], midpoint(s)[0], midpoint(s)[1]))\n\ndef infer(segs):\n    a,b=order_pair(segs)\n    if bbox(a)[0]==bbox(b)[0]:\n        return None\n    (r1,c1),(r2,c2)=midpoint(a),midpoint(b)\n    dr,dc=r2-r1,c2-c1\n    if abs(dr)==abs(dc):\n        return None\n    if abs(dr)>abs(dc):\n        return 'down' if dr>0 else 'up'\n    return 'right' if dc>0 else 'left'\n\ndef sample_segment(rng,row_lo,row_hi,col_lo,col_hi):\n    opts=[]\n    if col_hi-col_lo+1>=2:\n        opts.append('h')\n    if row_hi-row_lo+1>=2:\n        opts.append('v')\n    if not opts:\n        return None\n    o=rng.choice(opts)\n    if o=='h':\n        L=rng.randint(2, min(5, col_hi-col_lo+1))\n        r=rng.randint(row_lo,row_hi)\n        c=rng.randint(col_lo,col_hi-L+1)\n        cells=[(r,c+i) for i in range(L)]\n    else:\n        L=rng.randint(2, min(5, row_hi-row_lo+1))\n        r=rng.randint(row_lo,row_hi-L+1)\n        c=rng.randint(col_lo,col_hi)\n        cells=[(r+i,c) for i in range(L)]\n    return {'cells':cells}\n\ndef can_place(seg, blocked):\n    H,W=blocked.shape\n    r0,c0,r1,c1=bbox(seg)\n    rr0=max(0,r0-1); rr1=min(H-1,r1+1); cc0=max(0,c0-1); cc1=min(W-1,c1+1)\n    return not blocked[rr0:rr1+1, cc0:cc1+1].any()\n\ndef mark(seg, blocked):\n    H,W=blocked.shape\n    r0,c0,r1,c1=bbox(seg)\n    rr0=max(0,r0-1); rr1=min(H-1,r1+1); cc0=max(0,c0-1); cc1=min(W-1,c1+1)\n    blocked[rr0:rr1+1, cc0:cc1+1]=True\n\n\ndef gen_once(rng):\n    n=rng.randint(2,4)\n    top=rng.randint(1,2); bottom=rng.randint(1,2)\n    H=top+n*BOX+(n-1)*GAP+bottom\n    sep_gap=rng.randint(1,3); right_margin=rng.randint(1,3)\n    left_w=rng.randint(12, 30-(1+sep_gap+BOX+right_margin))\n    W=left_w+1+sep_gap+BOX+right_margin\n    blocked=np.zeros((H,left_w),dtype=bool)\n    dirs=['down','left','right']\n    rng.shuffle(dirs)\n    targets=[]\n    for i in range(n):\n        if i<3:\n            targets.append(dirs[i])\n        else:\n            targets.append(rng.choice(['down','left','right']))\n    pairs=[]\n    for i in range(n):\n        row_lo=top+i*(BOX+GAP)\n        row_hi=row_lo+BOX-1\n        target=targets[i]\n        ok=None\n        for att in range(500):\n            temp=blocked.copy()\n            segs=[]\n            good=True\n            for _ in range(2):\n                placed=False\n                for _ in range(200):\n                    seg=sample_segment(rng,row_lo,row_hi,1,left_w-2)\n                    if seg and can_place(seg,temp):\n                        mark(seg,temp)\n                        segs.append(seg)\n                        placed=True\n                        break\n                if not placed:\n                    good=False\n                    break\n            if not good:\n                continue\n            if infer(segs)==target:\n                ok=segs\n                blocked=temp\n                break\n        if ok is None:\n            return False\n        pairs.append(ok)\n    return True\n\nrng=random.Random(0)\ncount=0\nfor i in range(200):\n    if gen_once(rng):\n        count+=1\nprint('ok',count)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
