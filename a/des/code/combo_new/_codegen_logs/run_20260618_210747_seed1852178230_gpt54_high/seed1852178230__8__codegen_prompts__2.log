{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{show=0} /\"'^def (main|generate_input)'\"\\\\(/{show=1} /\"'^def / && $2 !~ /''^(main|generate_input)'\"\\\\(/ && show{show=0} show{print NR \\\":\\\" \"'$0}'\"' /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py\"","aggregated_output":"261:def main(grid: np.ndarray) -> np.ndarray:\n262:    \"\"\"\n263:    Assemble and place enlarged sprites on a canvas using legend-panel instructions.\n264:\n265:    Input structure:\n266:    - Color-6 separators divide the grid into a left legend column and a main canvas.\n267:    - Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.\n268:\n269:    Rule:\n270:    - Tile the unit sprite into each active cell of the frame to build an enlarged composite.\n271:    - Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).\n272:    - Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.\n273:\n274:    Key insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).\n275:    \"\"\"\n276:    g = np.asarray(grid, dtype=int)\n277:    h, w = g.shape\n278:    assert w >= 2, \"grid width must be >= 2\"\n279:\n280:    # Output canvas is the region between the left separator run and (optionally) a\n281:    # right-side separator run near the far edge (right legend panel).\n282:    left_sep, right_sep = _split_canvas(g)\n283:    left_sep_c1 = left_sep[1]\n284:    canvas_c0 = left_sep_c1 + 1\n285:    canvas_c1 = right_sep[0] if right_sep is not None else w\n286:    main = g[:, canvas_c0:canvas_c1].copy()\n287:\n288:    # Paint one constructed sprite per marker panel that lies outside the output canvas.\n289:    marker_squares = _all_marker_panel_squares(g)\n290:    assert marker_squares, \"no marker panel found\"\n291:\n292:    # Anchor alignment (ignore internal full-height/full-width 6 separators inside main).\n293:    eff_h, eff_w = main.shape\n294:    full6_cols = [c for c in range(eff_w) if np.all(main[:, c] == 6)]\n295:    if full6_cols:\n296:        eff_w = min(full6_cols)\n297:    full6_rows = [r for r in range(eff_h) if np.all(main[r, :] == 6)]\n298:    if full6_rows:\n299:        eff_h = min(full6_rows)\n300:\n301:    out = main.copy()\n302:    composite_written = np.zeros(out.shape, dtype=bool)\n303:\n304:    for marker_r0, marker_c0 in marker_squares:\n305:        # Ignore marker panels inside the output canvas; only legends should drive drawing.\n306:        if canvas_c0 <= marker_c0 < canvas_c1:\n307:            continue\n308:\n309:        if marker_c0 + 5 > w:\n310:            continue\n311:        panel = g[:, marker_c0 : marker_c0 + 5]\n312:\n313:        unit = _extract_unit_sprite(panel)\n314:        if unit is None:\n315:            continue\n316:        unit_sprite, unit_bb = unit\n317:\n318:        frame_bb = _extract_frame_bbox(panel, unit_bb, marker_r0)\n319:        if frame_bb is None:\n320:            continue\n321:        fr0, fc0, fr1, fc1 = frame_bb\n322:        frame = panel[fr0 : fr1 + 1, fc0 : fc1 + 1]\n323:        frame_mask0 = (frame != 0) & (frame != 6)\n324:        _, n8 = _scipy_label(frame_mask0, structure=np.ones((3, 3)))\n325:        assert n8 == 1, f\"frame must be 8-connected, got {n8} components\"\n326:\n327:        # Rotate layout according to clockhand.\n328:        dir_k = _rotation_from_clockhand(g, marker_r0, marker_c0)  # up=0, right=1, down=2, left=3\n329:        frame_mask = np.rot90(frame_mask0, (-dir_k) % 4)\n330:\n331:        # Build composite by tiling the unit sprite into active frame cells.\n332:        m_unit = (unit_sprite != 0) & (unit_sprite != 6)\n333:        uh, uw = unit_sprite.shape\n334:        fh, fw = frame_mask.shape\n335:        comp = np.zeros((fh * uh, fw * uw), dtype=int)\n336:        for i in range(fh):\n337:            for j in range(fw):\n338:                if not frame_mask[i, j]:\n339:                    continue\n340:                rr0 = i * uh\n341:                cc0 = j * uw\n342:                comp[rr0 : rr0 + uh, cc0 : cc0 + uw][m_unit] = unit_sprite[m_unit]\n343:\n344:        pos = _position_indices_from_border_square(g, marker_r0, marker_c0)\n345:        if pos is None:\n346:            continue\n347:        pr, pc = pos\n348:\n349:        top = _anchor_to_top_left(pr, eff_h, comp.shape[0])\n350:        left = _anchor_to_top_left(pc, eff_w, comp.shape[1])\n351:\n352:        ch, cw = comp.shape\n353:        for r in range(ch):\n354:            rr = top + r\n355:            assert 0 <= rr < out.shape[0], \"sprite row out of canvas bounds\"\n356:            for c in range(cw):\n357:                cc = left + c\n358:                assert 0 <= cc < out.shape[1], \"sprite col out of canvas bounds\"\n359:                if out[rr, cc] == 6:\n360:                    continue\n361:                val = int(comp[r, c])\n362:                if val != 0 and val != 6:\n363:                    assert not composite_written[rr, cc], \"composites must not overlap\"\n364:                    composite_written[rr, cc] = True\n365:                    out[rr, cc] = val\n366:    return out\n367:\n368:# --------------- generator (refine_8conn_fill_overlap) ---------------\n369:\n370:# ── CFG: tunable generation parameters ──────────────────────────────\n371:GRID_H_RANGE = (20, 30)         # output grid height\n372:GRID_W = 30                     # output grid width (fixed)\n373:LEGEND_COUNT_WEIGHTS = [1, 4]   # weights for [1-legend, 2-legend]\n374:UNIT_SIZE_RANGE = (2, 5)        # NxN unit sprite side length\n375:MIN_CANVAS_W = 8                # reject if canvas narrower than this\n376:FRAME_H_RANGE = (4, 9)          # frame mask height (before rotation)\n377:FRAME_W_RANGE = (3, 6)          # frame mask width  (before rotation)\n378:FRAME_DENSITY = 0.5             # density for random_sprite frame generation\n379:BAND_WIDTH_MIN = 4              # minimum band width for canvas background\n380:MARKER_PANEL_HEIGHT = 8         # marker square (5) + rotation patch (3)\n381:USABLE_COLORS = [1, 2, 3, 4, 5, 7, 8, 9]  # all colors except 0 (bg) and 6 (separator)\n382:ROTATION_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up/right/down/left clock-hand offsets\n383:GEN_RETRIES = 300               # max attempts in generate_input\n384:\n385:\n650:def generate_input() -> np.ndarray:\n651:    for _ in range(GEN_RETRIES):\n652:        result = _gen_attempt()\n653:        if result is not None:\n654:            return result\n655:    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
