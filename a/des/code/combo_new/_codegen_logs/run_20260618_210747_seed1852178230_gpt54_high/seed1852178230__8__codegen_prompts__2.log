{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{show=0} /\"'^def (main|generate_input)'\"\\\\(/{show=1} /\"'^def / && $2 !~ /''^(main|generate_input)'\"\\\\(/ && show{show=0} show{print NR \\\":\\\" \"'$0}'\"' /home/lixinyu/snap/new/ARC_code/eval/5545f144.py\"","aggregated_output":"190:def main(grid: np.ndarray) -> np.ndarray:\n191:    \"\"\"\n192:    Move a triangular sprite across the grid, consuming aligned marker pixels.\n193:\n194:    Input structure:\n195:    - Frames concatenated horizontally with solid divider columns; bg is most common color.\n196:    - Each frame: a triangular arrow-shaped sprite and scattered single-pixel markers, all one color.\n197:\n198:    Rule:\n199:    - Start from the rightmost frame.\n200:    - At each step, exactly one cardinal direction from the head has reachable\n201:      markers (on a half-line: same row or column); the sprite advances to the\n202:      nearest one.\n203:    - On reaching a marker, consume it; sprite re-faces that direction.\n204:    - Repeat until no markers remain; output the final sprite position on a clean bg.\n205:\n206:    Key insight: The triangle's tip encodes facing direction, which sets marker-consumption priority.\n207:    \"\"\"\n208:    g = np.asarray(grid, dtype=int)\n209:    frames, bg = _split_frames(g)\n210:\n211:    # Actor color is the non-bg, non-divider color.\n212:    solid_cols = [c for c in range(g.shape[1]) if len(set(map(int, g[:, c]))) == 1]\n213:    div_colors = {int(g[0, c]) for c in solid_cols if int(g[0, c]) != bg}\n214:    colors = set(map(int, g.ravel()))\n215:    actor = next(iter(colors - {bg} - div_colors))\n216:\n217:    # Use the latest frame (rightmost) as the starting state.\n218:    start = frames[-1]\n219:    return _simulate_to_end(start, actor)\n220:\n221:# --------------- generator (codex gpt-5.4 (retry, turn-sign randomized)) ---------------\n222:\n223:# --- CFG: canvas / frame bounds ---\n224:N_FRAMES_RANGE = (1, 5)          # rng.integers low/high+1 -> 1..4 frames\n225:FRAME_MAX = 16                   # rng.integers high for H, W -> 8..15 / 6..15\n226:H_FLOOR, H_CAP = 8, 15           # clamps for computed H lower bound\n227:W_FLOOR, W_CAP = 6, 15           # clamps for computed W lower bound\n228:\n229:# --- CFG: path complexity ---\n230:STEPS_RANGE = (4, 13)            # candidate total_steps (4..12 inclusive)\n231:STEP_DIST_RANGE = (2, 8)         # per-step manhattan distance choices (2..7 inclusive)\n232:TURN_RATIO_LO, TURN_RATIO_HI = 0.4, 0.9\n233:TURN_MIN_ABS = 3                 # absolute floor on #turns used during segment sampling\n234:MIN_TURNS_ACCEPT = 2             # post-hoc minimum for accepted paths\n235:MIN_DIR_DIVERSITY = 3            # >= 3 of {U,R,D,L} must appear\n236:MIN_DIST_VARIETY = 2             # >= 2 distinct step distances\n237:\n238:# --- CFG: template selection ---\n239:# Weights applied when n_steps >= TEMPLATE_HEAVY_THRESHOLD, in TEMPLATES order:\n240:# (hollow3, filled4, stem4, midfilled6). Otherwise uniform.\n241:TEMPLATE_HEAVY_THRESHOLD = 9\n242:TEMPLATE_WEIGHTS_HEAVY = (4, 5, 3, 2)\n243:\n244:# --- CFG: retry budget ---\n245:MAX_ATTEMPTS = 300\n246:\n247:# Precomputed: how many divisors in 1..4 each step count has (used to reweight n_steps\n248:# so that step counts compatible with fewer frame counts aren't over-represented).\n249:_STEP_AVAILABILITY = {n: sum(n % f == 0 for f in range(1, 5)) for n in range(*STEPS_RANGE)}\n250:\n251:\n530:def generate_input() -> np.ndarray:\n531:    rng = np.random.default_rng()\n532:    for _ in range(MAX_ATTEMPTS):\n533:        case = _build_case(rng)\n534:        if case is not None:\n535:            return case[\"input\"]\n536:    raise RuntimeError(f\"failed to generate a valid input after {MAX_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
