multicolor\"\n64:    ordered_main = _ordered_straight_run(main_coords)\n65:\n66:    out = np.full_like(g, bg)\n67:    for r, c in ordered_main:\n68:        color = int(g[r, c])\n69:        assert color != bg\n70:        assert out[r, c] == bg, \"main source pixel unexpectedly already painted\"\n71:        out[r, c] = color\n72:        for dr, dc in DIAG_DIRS:\n73:            nr, nc = r + dr, c + dc\n74:            while 0 <= nr < H and 0 <= nc < W and out[nr, nc] == bg:\n75:                out[nr, nc] = color\n76:                nr += dr\n77:                nc += dc\n78:\n79:    main_set = set(main_coords)\n80:    base = out.copy()\n81:    fill_regions: list[tuple[int, set[tuple[int, int]]]] = []\n82:    for comp in comps:\n83:        coords = _component_coords(comp)\n84:        if set(coords) == main_set:\n85:            continue\n86:\n87:        ordered_bar = _ordered_straight_run(coords)\n88:        colors = {int(g[r, c]) for r, c in ordered_bar}\n89:        assert len(colors) == 1, \"short bar must be monochrome\"\n90:        color = next(iter(colors))\n91:        assert color != bg\n92:        assert all(base[r, c] == bg for r, c in ordered_bar), \"short bar overlaps main rays\"\n93:\n94:        seen = set(ordered_bar)\n95:        q = deque(ordered_bar)\n96:        while q:\n97:            r, c = q.popleft()\n98:            for dr, dc in DIAG_DIRS:\n99:                nr, nc = r + dr, c + dc\n100:                if 0 <= nr < H and 0 <= nc < W and base[nr, nc] == bg and (nr, nc) not in seen:\n101:                    seen.add((nr, nc))\n102:                    q.append((nr, nc))\n103:        fill_regions.append((color, seen))\n104:\n105:    claimed: set[tuple[int, int]] = set()\n106:    for color, region in fill_regions:\n107:        assert claimed.isdisjoint(region), \"short-bar diagonal regions must be disjoint\"\n108:        claimed.update(region)\n109:        for r, c in region:\n110:            out[r, c] = color\n111:\n112:    for r, c in np.argwhere(g != bg):\n113:        assert out[int(r), int(c)] == int(g[int(r), int(c)]), \"input foreground must be preserved\"\n114:\n115:    return out\n116:\n117:# --------------- generator (o5x) ---------------\n118:\n119:# --- Configuration ---\n120:GRID_SIZE_MIN, GRID_SIZE_MAX = 4, 10\n121:RUN_LENGTH_MIN, RUN_LENGTH_MAX = 3, 7    # main run pixel count\n122:POS_MARGIN = 1                            # perpendicular position inset from grid edges\n123:COLOR_MIN, COLOR_MAX = 1, 9              # non-background color range (inclusive)\n124:MAX_RETRIES = 300                         # generate_input() retry budget\n125:\n126:_DIAG_DIRS = ((-1, -1), (-1, 1), (1, -1), (1, 1))\n127:_ORTH_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n128:\n129:# Edge definitions: (name, pair_generator) -- each yields adjacent cell pairs along one edge.\n130:_EDGE_DEFS = {\n131:    \"top\":    lambda n: (((0, c), (0, c + 1)) for c in range(n - 1)),\n132:    \"bottom\": lambda n: (((n - 1, c), (n - 1, c + 1)) for c in range(n - 1)),\n133:    \"left\":   lambda n: (((r, 0), (r + 1, 0)) for r in range(n - 1)),\n134:    \"right\":  lambda n: (((r, n - 1), (r + 1, n - 1)) for r in range(n - 1)),\n135:}\n136:\n137:\n282:def generate_input():\n283:    for _ in range(MAX_RETRIES):\n284:        grid = _gen_attempt()\n285:        if grid is not None:\n286:            return grid\n287:    raise RuntimeError(\"failed to generate valid 1190bc91 input\")\n","exit_code":0,"status":"completed"}}
