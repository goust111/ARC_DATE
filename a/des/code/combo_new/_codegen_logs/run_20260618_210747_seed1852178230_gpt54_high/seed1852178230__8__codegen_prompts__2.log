{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{show=0} /\"'^def (main|generate_input)'\"\\\\(/{show=1} /\"'^def / && $2 !~ /''^(main|generate_input)'\"\\\\(/ && show{show=0} show{print NR \\\":\\\" \"'$0}'\"' /home/lixinyu/snap/new/ARC_code/train/9f669b64.py\"","aggregated_output":"25:def main(grid: np.ndarray) -> np.ndarray:\n26:    \"\"\"\n27:    Push the central solid rectangle to the grid edge, splitting the perpendicular target rectangle around its path.\n28:\n29:    Input structure\n30:    - The background is the dominant color.\n31:    - There are exactly three monochrome foreground objects arranged on one\n32:      horizontal or vertical axis.\n33:    - The middle object on that axis is a solid rectangular moving object.\n34:    - One end object is a solid rectangle or bar whose long side is perpendicular\n35:      to the movement axis; this is the target to split.\n36:\n37:    Rule\n38:    - Move the middle rectangle along the axis toward the target until it is\n39:      flush with the grid edge in that direction.\n40:    - Clear the original middle rectangle and the original target.\n41:    - Split the target through the moving rectangle's two-cell-wide path and\n42:      shift the two halves one cell outward perpendicular to the movement.\n43:    - Keep the other end object unchanged.\n44:\n45:    Key insight\n46:    - The non-target end object acts as a pusher; the central rectangle travels\n47:      away from it through the perpendicular target, opening a matching gap.\n48:    \"\"\"\n49:    g = np.asarray(grid, dtype=int)\n50:    bg = get_bg(g)\n51:    H, W = g.shape\n52:\n53:    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n54:    assert len(objects) == 3, \"expected exactly three foreground objects\"\n55:\n56:    row_centers = [_center(obj, 0) for obj in objects]\n57:    col_centers = [_center(obj, 1) for obj in objects]\n58:    row_spread = max(row_centers) - min(row_centers)\n59:    col_spread = max(col_centers) - min(col_centers)\n60:    assert min(row_spread, col_spread) <= 0.5, \"objects must share a row or column axis\"\n61:    axis = 0 if col_spread <= 0.5 else 1\n62:    perp = 1 - axis\n63:\n64:    ordered = sorted(objects, key=lambda obj: _center(obj, axis))\n65:    axis_centers = [_center(obj, axis) for obj in ordered]\n66:    assert axis_centers[0] < axis_centers[1] < axis_centers[2], \"expected a unique middle object\"\n67:\n68:    source = ordered[1]\n69:    end_objects = [ordered[0], ordered[2]]\n70:    assert _is_solid_rectangle(g, source), \"moving object must be a solid rectangle\"\n71:\n72:    target_candidates = [\n73:        obj\n74:        for obj in end_objects\n75:        if _is_solid_rectangle(g, obj) and _span(obj, perp) > _span(obj, axis)\n76:    ]\n77:    assert len(target_candidates) == 1, \"expected one perpendicular solid target\"\n78:    target = target_candidates[0]\n79:\n80:    direction = -1 if _center(target, axis) < _center(source, axis) else 1\n81:\n82:    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n83:    tr0, tc0, tr1, tc1 = target[\"bbox\"]\n84:    source_lo = [sr0, sc0]\n85:    source_hi = [sr1, sc1]\n86:    target_lo = [tr0, tc0]\n87:    target_hi = [tr1, tc1]\n88:\n89:    source_perp_len = source_hi[perp] - source_lo[perp] + 1\n90:    assert source_perp_len == 2, \"moving object path must be two cells wide\"\n91:    assert target_lo[perp] <= source_lo[perp] <= source_hi[perp] <= target_hi[perp]\n92:    assert (\n93:        source_lo[perp] - target_lo[perp] == target_hi[perp] - source_hi[perp]\n94:    ), \"moving object must be centered across the target\"\n95:\n96:    out = g.copy()\n97:    for r, c in source[\"coords\"]:\n98:        out[int(r), int(c)] = bg\n99:    for r, c in target[\"coords\"]:\n100:        out[int(r), int(c)] = bg\n101:\n102:    shift = source_perp_len // 2\n103:    for r, c in target[\"coords\"]:\n104:        new_rc = [int(r), int(c)]\n105:        if new_rc[perp] <= source_lo[perp]:\n106:            new_rc[perp] -= shift\n107:        else:\n108:            assert new_rc[perp] >= source_hi[perp]\n109:            new_rc[perp] += shift\n110:        assert 0 <= new_rc[0] < H and 0 <= new_rc[1] < W, \"shifted target must stay in bounds\"\n111:        out[new_rc[0], new_rc[1]] = int(target[\"color\"])\n112:\n113:    source_patch = crop_bbox(g, source[\"bbox\"])\n114:    if axis == 0:\n115:        new_r = 0 if direction < 0 else H - source_patch.shape[0]\n116:        new_c = source_lo[1]\n117:    else:\n118:        new_r = source_lo[0]\n119:        new_c = 0 if direction < 0 else W - source_patch.shape[1]\n120:    dest = out[new_r : new_r + source_patch.shape[0], new_c : new_c + source_patch.shape[1]]\n121:    assert np.all(dest == bg), \"moving object destination must be clear\"\n122:    paste(out, source_patch, new_r, new_c)\n123:    return out\n124:\n125:# --------------- generator (att2) ---------------\n126:\n127:GEN_GRID_SIZE = 10\n128:GEN_BG = 7\n129:GEN_FG_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n130:GEN_SOURCE_PERP = 2\n131:GEN_SOURCE_ALONG_CHOICES = [2, 3]\n132:GEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX = 1, 4\n133:GEN_TARGET_OVERHANG_CHOICES = (1, 2)\n134:GEN_SOURCE_TARGET_GAP_RANGE = range(5)\n135:GEN_OTHER_WIDTH_CHOICES = (2, 4, 6)\n136:GEN_OTHER_MIN_STAIR_WIDTH = 4\n137:GEN_OTHER_MIN_STAIR_HEIGHT = 2\n138:GEN_ORIENTATION_COUNT, GEN_RETRY_LIMIT = 4, 300\n139:\n140:\n251:def generate_input() -> np.ndarray:\n252:    for _ in range(GEN_RETRY_LIMIT):\n253:        grid = _gen_attempt()\n254:        if grid is not None:\n255:            return grid\n256:    raise RuntimeError(\"failed to generate a valid 9f669b64 input\")\n","exit_code":0,"status":"completed"}}
