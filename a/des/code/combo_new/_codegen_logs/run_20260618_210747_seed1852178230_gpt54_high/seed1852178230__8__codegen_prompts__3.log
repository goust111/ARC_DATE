{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/52364a65.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste, random_free_location, random_sprite\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Erase the two leftmost columns of every foreground object, leaving the rest of each object in place.\n\n    Input structure:\n    - A grid has one dominant background color and several monochromatic 4-connected foreground objects.\n    - Each foreground object spans at least two columns in its bounding box.\n\n    Rule:\n    - Find each same-color 4-connected foreground object.\n    - Within each object's own bounding box, set foreground pixels in the two leftmost columns to the background color.\n    - Leave all other pixels unchanged.\n\n    Key insight:\n    - The deletion is measured from each object's local left edge, not from the grid edge or from a shared global column.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert components, \"expected at least one foreground object\"\n\n    out = g.copy()\n    for component in components:\n        coords = component[\"coords\"]\n        _r0, c0, _r1, c1 = map(int, component[\"bbox\"])\n        assert c1 - c0 + 1 >= 2, \"each object must span at least two columns\"\n\n        erase = coords[coords[:, 1] < c0 + 2]\n        out[erase[:, 0], erase[:, 1]] = bg\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n# Canvas constraints.\nBG = 8\nGRID_SIZE_RANGE = (8, 11)\nMIN_BACKGROUND_FRACTION = 0.50\n# Object sampling constraints.\nOBJECT_COUNT = 4\nFOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 7, 9]\nSPRITE_WIDTH_RANGE = (2, 6)\nSPRITE_HEIGHT_RANGE = (2, 5)\nSPRITE_PIXEL_RANGE = (4, 14)\nSPRITE_RETRIES = 30\nSPRITE_CONNECTIVITY = 4\nSPRITE_SYMMETRY = \"not_symmetric\"\n# Placement and global retry policy.\nPLACEMENT_PADDING = 1\nPLACEMENT_CONNECTIVITY = 8\nGENERATION_RETRIES = 300\n\ndef _sample_sprite(color: int) -> np.ndarray | None:\n    \"\"\"Return one connected sprite that lands inside the configured pixel-count range.\"\"\"\n    bw = random.randint(*SPRITE_WIDTH_RANGE)\n    bh = random.randint(*SPRITE_HEIGHT_RANGE)\n    max_px = bw * bh\n    min_px = max(SPRITE_PIXEL_RANGE[0], bw + bh - 1)\n    max_target_px = min(SPRITE_PIXEL_RANGE[1], max_px)\n    if min_px > max_target_px:\n        return None\n    target_px = random.randint(min_px, max_target_px)\n    density = target_px / max_px\n    for _ in range(SPRITE_RETRIES):\n        try:\n            sprite = random_sprite(bh, bw, density=density, color_palette=[color],\n                                   connectivity=SPRITE_CONNECTIVITY, background=BG,\n                                   symmetry=SPRITE_SYMMETRY)\n        except Exception:\n            continue\n        px = int(np.sum(sprite != BG))\n        if SPRITE_PIXEL_RANGE[0] <= px <= SPRITE_PIXEL_RANGE[1]:\n            return sprite\n    return None\n\ndef _place_sprite(grid: np.ndarray, sprite: np.ndarray) -> bool:\n    \"\"\"Paste sprite with the required Chebyshev gap; return False if no slot exists.\"\"\"\n    try:\n        r, c = random_free_location(grid, sprite, transparent=BG,\n                                    padding=PLACEMENT_PADDING,\n                                    padding_connectivity=PLACEMENT_CONNECTIVITY)\n    except ValueError:\n        return False\n    paste(grid, sprite, r, c, transparent=BG)\n    return True\n\ndef _solver_accepts(grid: np.ndarray) -> bool:\n    \"\"\"Return whether the solver accepts the sampled task instance.\"\"\"\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return out is not None\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(*GRID_SIZE_RANGE)\n    W = random.randint(*GRID_SIZE_RANGE)\n    grid = np.full((H, W), BG, dtype=int)\n    for color in random.sample(FOREGROUND_COLORS, OBJECT_COUNT):\n        sprite = _sample_sprite(color)\n        if sprite is None or not _place_sprite(grid, sprite):\n            return None\n    if np.sum(grid == BG) / grid.size < MIN_BACKGROUND_FRACTION:\n        return None\n    return grid if _solver_accepts(grid) else None\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate input after {GENERATION_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py\"","aggregated_output":"import numpy as np\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Shear the rectangular input down-left onto a black canvas.\n\n    Input structure\n    A rectangular grid of colored pixels with no internal empty region to infer.\n\n    Rule\n    Create a black output with the same height and width W + H - 1, then copy\n    each input row r unchanged starting at column H - 1 - r.\n\n    Key insight\n    The colors and row contents are preserved; only the row offsets change so\n    the left edge forms a descending diagonal.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    out = np.zeros((h, w + h - 1), dtype=int)\n    for r in range(h):\n        start = h - 1 - r\n        out[r, start : start + w] = g[r]\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and palette bounds.\nMIN_HEIGHT, MAX_HEIGHT = 2, 10\nMIN_WIDTH, MAX_WIDTH = 1, 9\nMIN_COLOR_COUNT, MAX_COLOR_COUNT = 4, 5\nMAX_CELLS, MAX_OUTPUT_WIDTH = 36, 30\nPALETTE_VALUES = range(1, 10)\n\n# Fill pattern controls.\nFILL_MODES = (\"noise\", \"row_runs\", \"column_bands\", \"diagonal_bands\")\nMAX_ROW_RUN_CUTS = 3\nCOLUMN_NOISE_PROB = 0.5\nMIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND = 1, 3\nDIAGONAL_FLIP_PROB = 0.5\n\n# Generation safety.\nGENERATION_RETRIES = 300\n\n\ndef _ensure_palette_coverage(arr, palette):\n    positions = random.sample(range(arr.size), len(palette))\n    rows, cols = np.divmod(positions, arr.shape[1])\n    arr[rows, cols] = palette\n\n\ndef _fill_grid(h, w, palette):\n    k = len(palette)\n    mode = random.choice(FILL_MODES)\n    arr = np.zeros((h, w), dtype=int)\n\n    if mode == \"noise\":\n        arr[:] = np.random.choice(palette, size=(h, w))\n    elif mode == \"row_runs\":\n        for r in range(h):\n            cuts = sorted(random.sample(range(1, w), random.randint(0, min(w - 1, MAX_ROW_RUN_CUTS)))) if w > 1 else []\n            starts = [0] + cuts\n            ends = cuts + [w]\n            last = None\n            for c0, c1 in zip(starts, ends):\n                choices = [c for c in palette if c != last] or list(palette)\n                last = random.choice(choices)\n                arr[r, c0:c1] = last\n    elif mode == \"column_bands\":\n        for c in range(w):\n            arr[:, c] = random.choice(palette)\n        if random.random() < COLUMN_NOISE_PROB:\n            for r in range(h):\n                arr[r, random.randrange(w)] = random.choice(palette)\n    else:\n        band = random.randint(MIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND)\n        phase = random.randrange(k)\n        rows, cols = np.indices((h, w))\n        arr[:] = np.asarray(palette)[((rows + cols) // band + phase) % k]\n        if random.random() < DIAGONAL_FLIP_PROB:\n            arr = np.fliplr(arr)\n\n    _ensure_palette_coverage(arr, palette)\n    return arr\n\n\ndef _gen_attempt():\n    k = random.randint(MIN_COLOR_COUNT, MAX_COLOR_COUNT)\n    h = random.randint(MIN_HEIGHT, MAX_HEIGHT)\n    widths = [\n        w\n        for w in range(MIN_WIDTH, MAX_WIDTH + 1)\n        if h * w >= k and h * w <= MAX_CELLS and w + h - 1 <= MAX_OUTPUT_WIDTH\n    ]\n    if not widths:\n        return None\n    w = random.choice(widths)\n    palette = random.sample(PALETTE_VALUES, k)\n    return _fill_grid(h, w, palette)\n\n\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
