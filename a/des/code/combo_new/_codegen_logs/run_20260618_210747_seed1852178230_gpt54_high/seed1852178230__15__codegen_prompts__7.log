   297\t\n   298\t    return out\n   299\t\n   300\t# --------------- generator (c) ---------------\n   301\t\n   302\t# -- Configuration constants --------------------------------------------------\n   303\t# Grid dimensions\n   304\t_GRID_H_MIN, _GRID_H_MAX = 4, 13\n   305\t_GRID_W_MIN, _GRID_W_MAX = 10, 15\n   306\t_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n   307\t_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n   308\t_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n   309\t\n   310\t# Palette\n   311\t_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n   312\t\n   313\t# Sprite geometry\n   314\t_SPRITE_H_MAX = 7\n   315\t_SPRITE_W_MAX = 6\n   316\t_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n   317\t_SPRITE_CELL_MAX = 16\n   318\t_FILLED_SPRITE_MAX = 3\n   319\t\n   320\t# Sprite mutation probabilities\n   321\t_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n   322\t_P_VERT_WALL = 0.3            # add vertical internal wall\n   323\t_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n   324\t_P_DIAMOND = 0.2              # use diamond shape for 3x3\n   325\t\n   326\t# Generation\n   327\t_MAX_RETRIES = 300\n   328\t# -- End configuration --------------------------------------------------------\n   329\t\n   330\t\n   331\tdef _get_enclosed_holes(sprite):\n   332\t    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n   333\t    h, w = sprite.shape\n   334\t    return [pts for pts in components_mask(~sprite, connectivity=4)\n   335\t            if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n   336\t\n   337\t\n   338\tdef _make_diamond():\n   339\t    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n   340\t    s = np.zeros((3, 3), dtype=bool)\n   544\tdef generate_input():\n   545\t    for _ in range(_MAX_RETRIES):\n   546\t        r = _gen_attempt()\n   547\t        if r is not None:\n   548\t            return r\n   549\t    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
