{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/train/84551f4c.py | sed -n '1,120p;261,360p'\"","aggregated_output":"     1\timport numpy as np\n     2\t\n     3\tfrom arc_utils import find_components, get_bg\n     4\timport itertools\n     5\timport random\n     6\t\n     7\t\n     8\tMARKER_COLOR = 1\n     9\tBODY_COLOR = 2\n    10\t\n    11\t\n    12\tdef _vertical_bars(g: np.ndarray, bg: int) -> list[dict]:\n    13\t    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    14\t    bars = []\n    15\t    baseline = None\n    16\t    for comp in comps:\n    17\t        r0, c0, r1, c1 = comp[\"bbox\"]\n    18\t        assert c0 == c1\n    19\t        coords = comp[\"coords\"]\n    20\t        height = r1 - r0 + 1\n    21\t        assert comp[\"area\"] == height\n    22\t        assert {(int(r), int(c)) for r, c in coords} == {(r, c0) for r in range(r0, r1 + 1)}\n    23\t        if baseline is None:\n    24\t            baseline = r1\n    25\t        else:\n    26\t            assert r1 == baseline\n    27\t        bars.append(\n    28\t            {\n    29\t                \"color\": int(comp[\"color\"]),\n    30\t                \"col\": int(c0),\n    31\t                \"bottom\": int(r1),\n    32\t                \"height\": int(height),\n    33\t                \"coords\": coords,\n    34\t            }\n    35\t        )\n    36\t\n    37\t    assert bars\n    38\t    return sorted(bars, key=lambda b: b[\"col\"])\n    39\t\n    40\t\n    41\tdef main(grid: np.ndarray) -> np.ndarray:\n    42\t    \"\"\"\n    43\t    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n    44\t    Input structure\n    45\t    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n    46\t    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n    47\t    Rule\n    48\t    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n    49\t    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n    50\t    - Red bars that are not reached from a blue marker remain unchanged.\n    51\t    Key insight\n    52\t    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n    53\t    \"\"\"\n    54\t    g = np.asarray(grid, dtype=int)\n    55\t    bg = get_bg(g)\n    56\t    colors = set(map(int, np.unique(g))) - {bg}\n    57\t    assert colors <= {MARKER_COLOR, BODY_COLOR}\n    58\t    assert MARKER_COLOR in colors\n    59\t\n    60\t    bars = _vertical_bars(g, bg)\n    61\t    by_col = {bar[\"col\"]: bar for bar in bars}\n    62\t    assert len(by_col) == len(bars)\n    63\t\n    64\t    baselines = {bar[\"bottom\"] for bar in bars}\n    65\t    assert len(baselines) == 1\n    66\t    baseline = baselines.pop()\n    67\t    out = g.copy()\n    68\t    for bar in bars:\n    69\t        if bar[\"color\"] != MARKER_COLOR:\n    70\t            continue\n    71\t\n    72\t        group = [bar]\n    73\t        current = bar\n    74\t        while True:\n    75\t            next_col = current[\"col\"] + current[\"height\"]\n    76\t            next_bar = by_col.get(next_col)\n    77\t            if next_bar is None:\n    78\t                break\n    79\t            if next_bar[\"color\"] != BODY_COLOR:\n    80\t                break\n    81\t            group.append(next_bar)\n    82\t            current = next_bar\n    83\t\n    84\t        for item in group:\n    85\t            rows = item[\"coords\"][:, 0]\n    86\t            cols = item[\"coords\"][:, 1]\n    87\t            out[rows, cols] = bg\n    88\t\n    89\t        for item in group:\n    90\t            col = item[\"col\"]\n    91\t            height = item[\"height\"]\n    92\t            assert col + height <= g.shape[1]\n    93\t            out[baseline, col : col + height] = item[\"color\"]\n    94\t\n    95\t    return out\n    96\t\n    97\t# --------------- generator (att2) ---------------\n    98\t\n    99\t# Canvas bounds.\n   100\tMIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n   101\t\n   102\t# Bar and chain structure.\n   103\tMIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\n   104\tMIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\n   105\tMIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n   106\t\n   107\t# Layout padding and retry budget.\n   108\tGAP_VALUES = (1, 2, 3)\n   109\tMAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n   110\t\n   111\t\n   112\tdef _chain_red_distributions(n_blue, n_red):\n   113\t    \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n   114\t    return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n   115\t\n   116\t\n   117\tdef _bounded_tuples(values, n, max_sum):\n   118\t    \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n   119\t    return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n   120\t\n   261\tdef generate_input():\n   262\t    for _ in range(MAX_GENERATION_ATTEMPTS):\n   263\t        grid = _gen_attempt()\n   264\t        if grid is not None:\n   265\t            return grid\n   266\t    raise RuntimeError(\"failed to generate a valid 84551f4c input\")\n","exit_code":0,"status":"completed"}}
