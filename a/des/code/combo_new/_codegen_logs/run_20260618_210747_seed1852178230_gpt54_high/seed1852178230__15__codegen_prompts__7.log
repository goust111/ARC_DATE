{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py | sed -n '1,120p;471,620p'\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\tfrom collections import Counter, defaultdict, deque\n     3\timport random\n     4\timport numpy as np\n     5\tfrom scipy.ndimage import label as scipy_label\n     6\tfrom arc_utils import bbox_h, bbox_w, find_components, in_bounds, neighbors4, paste\n     7\t\n     8\tdef main(grid: np.ndarray) -> np.ndarray:\n     9\t    \"\"\"\n    10\t    Slide a solid square through a winding channel to reach a same-sized target square.\n    11\t\n    12\t    Input structure:\n    13\t    - bg (most common color). A river color forms a winding corridor.\n    14\t    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n    15\t\n    16\t    Rule:\n    17\t    - The mover square travels along the river toward the destination.\n    18\t    - It can only pass through positions where the full NxN area is river.\n    19\t    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    20\t    - The mover's original position is filled with the river color.\n    21\t\n    22\t    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    23\t    \"\"\"\n    24\t    g = np.array(grid, dtype=int)\n    25\t    H, W = g.shape\n    26\t\n    27\t    # Corner-majority background (more stable than global mode here).\n    28\t    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n    29\t\n    30\t    # Detect solid square components (excluding bg).\n    31\t    squares: list[dict] = []\n    32\t    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n    33\t        col = int(comp[\"color\"])\n    34\t        b = comp[\"bbox\"]\n    35\t        if bbox_h(b) != bbox_w(b):\n    36\t            continue\n    37\t        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n    38\t        if not bool((patch == int(col)).all()):\n    39\t            continue\n    40\t        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n    41\t\n    42\t    assert not (len(squares) < 2)\n    43\t\n    44\t    # Choose the size that appears at least twice (most common size).\n    45\t    by_n: dict[int, list[dict]] = defaultdict(list)\n    46\t    for s in squares:\n    47\t        by_n[int(s[\"n\"])].append(s)\n    48\t    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    49\t    cand = by_n[int(nside)]\n    50\t    assert not (len(cand) < 2)\n    51\t\n    52\t    cand.sort(key=lambda s: int(s[\"col\"]))\n    53\t    mover = cand[0]\n    54\t    dest = cand[1]\n    55\t\n    56\t    n = int(mover[\"n\"])\n    57\t    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    58\t    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n    59\t\n    60\t    # River = most common remaining color (excluding bg and the two square colors).\n    61\t    counts = Counter(map(int, g.flatten()))\n    62\t    river = None\n    63\t    for col, _ct in counts.most_common():\n    64\t        if int(col) == int(bg):\n    65\t            continue\n    66\t        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n    67\t            continue\n    68\t        river = int(col)\n    69\t        break\n    70\t    assert not (river is None)\n    71\t\n    72\t    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n    73\t\n    74\t    # Feasible top-left placements: NxN window fully inside trav.\n    75\t    h2 = int(H - n + 1)\n    76\t    w2 = int(W - n + 1)\n    77\t    assert not (h2 <= 0 or w2 <= 0)\n    78\t    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n    79\t\n    80\t    feasible = np.zeros((h2, w2), dtype=bool)\n    81\t    for r in range(h2):\n    82\t        for c in range(w2):\n    83\t            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n    84\t                feasible[int(r), int(c)] = True\n    85\t    assert not (not bool(feasible[int(sr), int(sc)]))\n    86\t\n    87\t    # BFS on placement grid.\n    88\t    dist = -np.ones((h2, w2), dtype=int)\n    89\t    q = deque([(int(sr), int(sc))])\n    90\t    dist[int(sr), int(sc)] = 0\n    91\t    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    92\t    while q:\n    93\t        r, c = q.popleft()\n    94\t        for dr2, dc2 in DIR4:\n    95\t            rr = int(r + dr2)\n    96\t            cc = int(c + dc2)\n    97\t            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n    98\t                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n    99\t                q.append((int(rr), int(cc)))\n   100\t\n   101\t    # Pick target.\n   102\t    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n   103\t        tr, tc = int(dr), int(dc)\n   104\t    else:\n   105\t        best = -1\n   106\t        tr, tc = int(sr), int(sc)\n   107\t        for r in range(h2):\n   108\t            for c in range(w2):\n   109\t                if int(dist[int(r), int(c)]) > best:\n   110\t                    best = int(dist[int(r), int(c)])\n   111\t                    tr, tc = int(r), int(c)\n   112\t\n   113\t    out = g.copy()\n   114\t    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n   115\t    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n   116\t    return out\n   117\t\n   118\t\n   119\t# --- Generator ---\n   120\t\n   471\tdef generate_input():\n   472\t    for _ in range(300):\n   473\t        result = _gen_attempt()\n   474\t        if result is not None:\n   475\t            return result\n   476\t    raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n   477\t\n   478\t\n","exit_code":0,"status":"completed"}}
