{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py | sed -n '1,120p;260,360p'\"","aggregated_output":"     1\timport numpy as np\n     2\t\n     3\tfrom arc_utils import find_components, get_bg, is_contiguous, object_interior\n     4\timport random\n     5\t\n     6\t\n     7\tdef main(grid: np.ndarray) -> np.ndarray:\n     8\t    \"\"\"\n     9\t    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n    10\t\n    11\t    Input structure:\n    12\t    - The grid has a dominant background color.\n    13\t    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    14\t    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n    15\t\n    16\t    Rule:\n    17\t    - Keep the input pixels unchanged.\n    18\t    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    19\t    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n    20\t\n    21\t    Key insight:\n    22\t    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    23\t    \"\"\"\n    24\t    g = np.asarray(grid, dtype=int)\n    25\t    bg = int(get_bg(g))\n    26\t    out = g.copy()\n    27\t    h, w = g.shape\n    28\t\n    29\t    markers: dict[int, int] = {}\n    30\t    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    31\t    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n    32\t        r0, c0, r1, c1 = comp[\"bbox\"]\n    33\t        height = int(r1 - r0 + 1)\n    34\t        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n    35\t            continue\n    36\t\n    37\t        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n    38\t        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n    39\t        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n    40\t        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n    41\t        source = int(sub[0, 0])\n    42\t        halo = int(sub[0, 1])\n    43\t        assert source != halo, \"legend source and halo colors must differ\"\n    44\t        assert source not in markers, \"each source color must have exactly one legend marker\"\n    45\t\n    46\t        markers[source] = halo\n    47\t        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n    48\t\n    49\t    assert markers, \"expected at least one left-edge legend marker\"\n    50\t\n    51\t    for source, halo in markers.items():\n    52\t        objects = []\n    53\t        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n    54\t            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n    55\t            if cells <= marker_source_cells[source]:\n    56\t                continue\n    57\t            objects.append(comp)\n    58\t        assert objects, \"each legend source color must label at least one non-marker object\"\n    59\t\n    60\t        for obj in objects:\n    61\t            r0, c0, r1, c1 = obj[\"bbox\"]\n    62\t            pr0 = max(0, int(r0) - 1)\n    63\t            pc0 = max(0, int(c0) - 1)\n    64\t            pr1 = min(h - 1, int(r1) + 1)\n    65\t            pc1 = min(w - 1, int(c1) + 1)\n    66\t\n    67\t            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n    68\t            coords = obj[\"coords\"]\n    69\t            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n    70\t            enclosed = object_interior(patch, background=bg)\n    71\t            fill_mask = (patch == bg) & ~enclosed\n    72\t\n    73\t            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n    74\t            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n    75\t            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n    76\t            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n    77\t            target[fill_mask] = halo\n    78\t\n    79\t    return out\n    80\t\n    81\t# --------------- generator (att1, Claude) ---------------\n    82\t\n    83\t# Canvas and color palette.\n    84\tBACKGROUND = 0\n    85\tGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\n    86\tAVAILABLE_COLORS = tuple(range(1, 10))\n    87\t\n    88\t# Legend layout.\n    89\tLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\n    90\tLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n    91\t\n    92\t# Sprite geometry and acceptance.\n    93\tSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\n    94\tSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\n    95\tSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\n    96\tSPRITE_RETRIES = 300\n    97\t\n    98\t# Object counts and placement.\n    99\tINSTANCE_MIN, INSTANCE_MAX = 1, 3\n   100\tOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\n   101\tEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\n   102\tPLACEMENT_RETRIES = 200\n   103\t\n   104\t# Whole-sample retry budget.\n   105\tGENERATION_RETRIES = 300\n   106\t\n   107\t\n   108\tdef _make_sprite(color):\n   109\t    \"\"\"Construct one LR-symmetric 4-connected sprite matching the configured area/hole bounds.\"\"\"\n   110\t    target_area = random.randint(SPRITE_AREA_MIN, SPRITE_AREA_MAX)\n   111\t    for _ in range(SPRITE_RETRIES):\n   112\t        fill_p = target_area / (SPRITE_SIZE * SPRITE_SIZE) + random.uniform(-SPRITE_FILL_JITTER, SPRITE_FILL_JITTER)\n   113\t        sprite = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=int)\n   114\t        for r in range(SPRITE_SIZE):\n   115\t            for c in range(SPRITE_MIRROR_COLS):\n   116\t                if random.random() < fill_p:\n   117\t                    sprite[r, c] = color\n   118\t                    sprite[r, SPRITE_SIZE - 1 - c] = color\n   119\t        area = int(np.count_nonzero(sprite))\n   120\t        if area != target_area:\n   260\tdef generate_input() -> np.ndarray:\n   261\t    for _ in range(GENERATION_RETRIES):\n   262\t        result = _gen_attempt()\n   263\t        if result is not None:\n   264\t            return result\n   265\t    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
