       c = int(c0 + cc)\n   103\t            values = _reflection_orbit_values(g, r, c, lo, marker)\n   104\t            if values:\n   105\t                assert len(values) == 1\n   106\t                out[rr, cc] = values.pop()\n   107\t            else:\n   108\t                assert r < lo or c < lo\n   109\t                assert 0 <= c < g.shape[0] and 0 <= r < g.shape[1]\n   110\t                value = int(g[c, r])\n   111\t                assert value != marker\n   112\t                out[rr, cc] = value\n   113\t\n   114\t    return out\n   115\t\n   116\t# --------------- generator (o5x) ---------------\n   117\t\n   118\t# --- CFG: canvas & structure ---\n   119\t_N = 30                  # grid side length (always square)\n   120\t_LO = 2                  # outer border width (rows/cols 0..lo-1 are \"free\" border)\n   121\t_HI = _N - 1             # max row/col index\n   122\t\n   123\t# --- CFG: colors ---\n   124\t_PALETTE = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)  # 8 non-marker colors\n   125\t_MARKER = 8              # marker fill color\n   126\t\n   127\t# --- CFG: marker rectangle size ---\n   128\t_MARKER_DIM_LO = 3       # min marker side length\n   129\t_MARKER_DIM_HI = 9       # max marker side length (inclusive)\n   130\t_MARKER_AREA_LO = 16     # min marker area\n   131\t_MARKER_AREA_HI = 36     # max marker area\n   132\t\n   133\t# --- CFG: generation retries ---\n   134\t_MAX_RETRIES = 300\n   135\t\n   136\t_RNG = np.random.default_rng()\n   137\t_SIZE_PAIRS = [\n   138\t    (h, w)\n   139\t    for h in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)\n   140\t    for w in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)\n   141\t    if _MARKER_AREA_LO <= h * w <= _MARKER_AREA_HI\n   142\t]\n   143\t_PLACEMENT_CACHE: dict[tuple[int, int], list[tuple[int, int, list[tuple[int, int]]]]] = {}\n   144\t\n   145\t\n   146\tdef _orbit(r: int, c: int) -> set[tuple[int, int]]:\n   147\t    \"\"\"Return the LR+UD reflection orbit of (r, c) within the [_LO.._HI] axes.\"\"\"\n   148\t    rows = {r}\n   149\t    cols = {c}\n   150\t    if _LO <= r <= _HI:\n   151\t        rows.add(_LO + _HI - r)\n   152\t    if _LO <= c <= _HI:\n   153\t        cols.add(_LO + _HI - c)\n   154\t    return {(rr, cc) for rr in rows for cc in cols}\n   155\t\n   156\t\n   157\tdef _fallback_cells(r0: int, c0: int, h: int, w: int) -> list[tuple[int, int]] | None:\n   158\t    \"\"\"Identify marker cells whose entire orbit is inside the marker (need transpose fallback).\n   159\t\n   160\t    Returns None if the placement is invalid (a fully-covered orbit cell lies\n   251\t    \"\"\"Try once to generate a valid input grid. Returns None on failure.\"\"\"\n   252\t    clean = _build_clean()\n   253\t    h, w = _SIZE_PAIRS[int(_RNG.integers(len(_SIZE_PAIRS)))]\n   254\t    placements = _valid_placements(h, w)\n   255\t    if not placements:\n   256\t        return None\n   257\t    r0, c0, fallback = placements[int(_RNG.integers(len(placements)))]\n   258\t\n   259\t    # Ensure transpose-fallback cells share consistent colors across orbits\n   260\t    groups = [_orbit(r, c) | _orbit(c, r) for r, c in fallback]\n   261\t    _unify_groups(clean, groups)\n   262\t\n   263\t    expected = clean[r0 : r0 + h, c0 : c0 + w].copy()\n   264\t    inp = clean.copy()\n   265\t    inp[r0 : r0 + h, c0 : c0 + w] = _MARKER\n   266\t\n   267\t    try:\n   268\t        if np.array_equal(main(inp), expected):\n   269\t            return inp\n   270\t    except Exception:\n   271\t        return None\n   272\t    return None\n   273\t\n   274\t\n   275\tdef generate_input() -> np.ndarray:\n   276\t    for _ in range(_MAX_RETRIES):\n   277\t        grid = _gen_attempt()\n   278\t        if grid is not None:\n   279\t            return grid\n   280\t    raise RuntimeError(\"failed to generate a valid 0934a4d8 input\")\n","exit_code":0,"status":"completed"}}
