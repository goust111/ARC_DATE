{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/eval/e87109e9.py | sed -n '1,120p;535,700p'\"","aggregated_output":"     1\timport numpy as np\n     2\t\n     3\tfrom arc_utils import bbox_coords, components_mask\n     4\timport random\n     5\t\n     6\t_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n     7\t\n     8\t\n     9\tdef _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:\n    10\t    \"\"\"\n    11\t    Legend is a top region with a background color (typically 5) and 4 vertical bars.\n    12\t    Each bar's horizontal position inside its cell encodes turn direction:\n    13\t      - bar on left  -> 'L' (turn counterclockwise)\n    14\t      - bar on right -> 'R' (turn clockwise)\n    15\t    \"\"\"\n    16\t    legend = grid[:legend_h, :]\n    17\t    assert legend.size, \"legend must be non-empty\"\n    18\t    _vals, _cnts = np.unique(legend, return_counts=True); bg = int(_vals[_cnts.argmax()])\n    19\t\n    20\t    # Separator columns are solid bg throughout the legend.\n    21\t    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]\n    22\t    assert len(sep_cols) >= 2, \"legend separator columns must exist\"\n    23\t\n    24\t    turn: dict[int, str] = {}\n    25\t    for a, b in zip(sep_cols, sep_cols[1:], strict=False):\n    26\t        if b - a <= 2:\n    27\t            continue\n    28\t        interior = legend[1 : legend_h - 1, a + 1 : b]\n    29\t        colors = set(map(int, np.unique(interior)))\n    30\t        colors.discard(bg)\n    31\t        colors.discard(0)\n    32\t        assert len(colors) == 1, \"each legend cell must encode exactly one color\"\n    33\t        col = int(next(iter(colors)))\n    34\t        xs = np.where(interior == col)[1]\n    35\t        x = int(xs[0])  # relative to interior\n    36\t        # Decide left/right by proximity to borders (interior is typically 4 cells wide).\n    37\t        turn[col] = \"L\" if x <= (interior.shape[1] - 1) // 2 else \"R\"\n    38\t    assert len(turn) == 4, \"legend must encode four turn colors\"\n    39\t    return turn\n    40\t\n    41\t\n    42\tdef _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:\n    43\t    \"\"\"Return (r0,c0,size) for a solid square teal component.\"\"\"\n    44\t    candidates: list[tuple[int, int, int]] = []\n    45\t    for cells in components_mask(g == teal, connectivity=4):\n    46\t        r0, c0, r1, c1 = bbox_coords(cells)\n    47\t        hh = r1 - r0 + 1\n    48\t        ww = c1 - c0 + 1\n    49\t        if hh != ww:\n    50\t            continue\n    51\t        size = hh\n    52\t        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:\n    53\t            continue\n    54\t        candidates.append((int(r0), int(c0), int(size)))\n    55\t    assert len(candidates) == 1, \"main grid must contain exactly one solid teal square\"\n    56\t    return candidates[0]\n    57\t\n    58\t\n    59\tdef _rot_ccw(d: int) -> int:\n    60\t    return (d - 1) % 4\n    61\t\n    62\t\n    63\tdef _rot_cw(d: int) -> int:\n    64\t    return (d + 1) % 4\n    65\t\n    66\t\n    67\tdef main(grid: np.ndarray) -> np.ndarray:\n    68\t    \"\"\"\n    69\t    Emit four teal beams from a square, turning at colored obstacles per a legend.\n    70\t\n    71\t    Input structure:\n    72\t    - Top band: grey (5) legend with colored vertical bars in cells; bar position (left or right) encodes turn direction.\n    73\t    - Below: main grid with bg, a solid teal (8) square, and colored obstacle blocks.\n    74\t\n    75\t    Rule:\n    76\t    - Remove the legend from the output.\n    77\t    - From the teal square, shoot a beam in each cardinal direction (as a sliding copy of the square).\n    78\t    - Each beam paints teal over bg cells as it moves.\n    79\t    - On hitting an obstacle of color C, consult the legend: bar on left → turn counterclockwise, bar on right → turn clockwise. Continue in the new direction.\n    80\t    - Beams stop at grid edges.\n    81\t\n    82\t    Key insight: The legend's bar position (left vs right within its cell) is the encoding for turn direction at each obstacle color.\n    83\t    \"\"\"\n    84\t    g = np.asarray(grid, dtype=int)\n    85\t\n    86\t    # Legend height: crop everything above and including the last row containing legend bg (usually 5).\n    87\t    # In this dataset, the legend uses a dedicated color (5) that doesn't appear below.\n    88\t    legend_bg = 5\n    89\t    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]\n    90\t    assert rows_with_legend.size, \"legend rows must be present\"\n    91\t    legend_h = int(rows_with_legend.max() + 1)\n    92\t    assert np.array_equal(rows_with_legend, np.arange(legend_h)), \"legend color must be confined to the top band\"\n    93\t\n    94\t    legend_turn = _parse_legend(g, legend_h)\n    95\t\n    96\t    base = g[legend_h:, :].copy()\n    97\t    assert base.size, \"main grid must remain after legend crop\"\n    98\t\n    99\t    _vals, _cnts = np.unique(base, return_counts=True); bg = int(_vals[_cnts.argmax()])\n   100\t    teal = 8\n   101\t    src = _find_teal_square(base, teal=teal)\n   102\t    sr, sc, sz = src\n   103\t\n   104\t    out = base.copy()\n   105\t\n   106\t    def in_bounds(r: int, c: int) -> bool:\n   107\t        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]\n   108\t\n   109\t    def paint_block(r: int, c: int) -> None:\n   110\t        blk = out[r : r + sz, c : c + sz]\n   111\t        blk[blk == bg] = teal\n   112\t        out[r : r + sz, c : c + sz] = blk\n   113\t\n   114\t    def obstacle_color_at_next(nr: int, nc: int) -> int | None:\n   115\t        blk = out[nr : nr + sz, nc : nc + sz]\n   116\t        cols = set(map(int, np.unique(blk)))\n   117\t        cols.discard(bg)\n   118\t        cols.discard(teal)\n   119\t        if not cols:\n   120\t            return None\n   535\tdef generate_input() -> np.ndarray:\n   536\t    for _ in range(MAX_RETRIES):\n   537\t        grid = _gen_attempt()\n   538\t        if grid is not None:\n   539\t            return grid\n   540\t    raise RuntimeError(\"failed to generate e87109e9 input\")\n","exit_code":0,"status":"completed"}}
