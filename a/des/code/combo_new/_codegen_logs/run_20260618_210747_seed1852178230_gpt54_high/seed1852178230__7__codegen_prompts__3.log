{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{p=0} /\"'^def main'\"\\\\(/{p=1} /\"'^def generate_input'\"\\\\(/{p=2} p==1{print} p==2{print} p==2 && /\"'^    raise RuntimeError'\"\\\\(\\\"failed to generate valid input\\\"\\\\)/{p=0; print \\\"\\\"}' /home/lixinyu/snap/new/ARC_code/train/f18ec8cc.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reorder the vertical color-major blocks while preserving every block's internal pixels.\n\n    Input structure\n    The grid is divided into vertical blocks, each with a unique dominant color.\n    Small marker pixels from other block colors may appear inside the blocks.\n\n    Rule\n    If adjacent shared-color marker rows read exactly as the current block order\n    from right to left, reverse the blocks. Otherwise move the leftmost block to\n    the far right and shift the remaining blocks left.\n\n    Key insight\n    The transformation acts on whole vertical blocks, so marker pixels move with\n    their source block instead of being recolored or independently rearranged.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    blocks = _vertical_blocks(g)\n    order = _block_order(g, blocks)\n    assert sorted(order) == list(range(len(blocks))), \"block order must be a permutation\"\n\n    return np.concatenate([g[:, blocks[i][0] : blocks[i][1]] for i in order], axis=1)\n\n# --------------- generator (o5x) ---------------\n# Canvas, block, and color bounds.\nGEN_HEIGHT_RANGE = (7, 9)\nGEN_TOTAL_WIDTH_RANGE = (10, 15)\nGEN_BLOCK_COUNT_CHOICES = [3, 4]\nGEN_BLOCK_WIDTH_RANGE = (3, 7)\nGEN_COLOR_POOL = range(1, 10)\n\n# Marker-layout probabilities and row-sharing limits.\nGEN_REVERSE_PROB = 0.35\nGEN_ALIGNED_LEFT_SHIFT_PROB = 0.7\nGEN_NONCONSECUTIVE_LEFT_SHIFT_PROB = 0.5\nGEN_COMMON_COLOR_COUNT_RANGE = (0, 1)\n\n# Rejection-sampling retry limit.\nGEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_bounds(widths):\n    starts = [0, *itertools.accumulate(widths[:-1])]\n    return [(c0, c0 + width) for c0, width in zip(starts, widths)]\n\n\ndef _gen_expected(grid, widths, order):\n    bounds = _gen_bounds(widths)\n    return np.concatenate([grid[:, bounds[i][0] : bounds[i][1]] for i in order], axis=1)\n\n\ndef _gen_pick_widths(block_count):\n    min_width, max_width = GEN_BLOCK_WIDTH_RANGE\n    total = random.randint(\n        max(GEN_TOTAL_WIDTH_RANGE[0], min_width * block_count),\n        min(GEN_TOTAL_WIDTH_RANGE[1], max_width * block_count),\n    )\n    options = [\n        widths\n        for widths in itertools.product(range(min_width, max_width + 1), repeat=block_count)\n        if sum(widths) == total\n    ]\n    return list(random.choice(options))\n\n\ndef _gen_marker_col(c0, c1):\n    return random.randint(c0 + 1, c1 - 2)\n\n\ndef _gen_place_aligned(grid, widths, colors, color_rows):\n    bounds = _gen_bounds(widths)\n    for block_i, (c0, c1) in enumerate(bounds):\n        base = colors[block_i]\n        for color in colors:\n            if color != base:\n                grid[color_rows[color], _gen_marker_col(c0, c1)] = color\n\n\ndef _gen_nonconsecutive_rows(height, block_count):\n    options = [\n        rows\n        for rows in itertools.combinations(range(height), block_count)\n        if rows[-1] - rows[0] + 1 != block_count\n    ]\n    return list(random.choice(options))\n\n\ndef _gen_place_unaligned_left_shift(grid, widths, colors):\n    height = grid.shape[0]\n    bounds = _gen_bounds(widths)\n    common_colors = random.sample(colors, random.randint(*GEN_COMMON_COLOR_COUNT_RANGE))\n    row_by_common = {color: random.randrange(height) for color in common_colors}\n\n    assignments = []\n    for block_i, _ in enumerate(bounds):\n        base = colors[block_i]\n        used = set()\n        by_color = {}\n        for color in common_colors:\n            if color != base:\n                row = row_by_common[color]\n                used.add(row)\n                by_color[color] = row\n        foreign = [color for color in colors if color != base and color not in common_colors]\n        rows = random.sample([r for r in range(height) if r not in used], len(foreign))\n        for color, row in zip(foreign, rows):\n            by_color[color] = row\n        assignments.append(by_color)\n\n    for color in colors:\n        if color in common_colors:\n            continue\n        block_ids = [i for i, base in enumerate(colors) if base != color]\n        if len({assignments[i][color] for i in block_ids}) == 1:\n            block_i = random.choice(block_ids)\n            used = set(assignments[block_i].values())\n            old_row = assignments[block_i][color]\n            choices = [r for r in range(height) if r not in used and r != old_row]\n            assignments[block_i][color] = random.choice(choices)\n\n    for block_i, (c0, c1) in enumerate(bounds):\n        for color, row in assignments[block_i].items():\n            grid[row, _gen_marker_col(c0, c1)] = color\n\n\ndef _gen_base_grid():\n    height = random.randint(*GEN_HEIGHT_RANGE)\n    block_count = random.choice(GEN_BLOCK_COUNT_CHOICES)\n    colors = random.sample(GEN_COLOR_POOL, block_count)\n    widths = _gen_pick_widths(block_count)\n    grid = np.zeros((height, sum(widths)), dtype=int)\n    for color, (c0, c1) in zip(colors, _gen_bounds(widths)):\n        grid[:, c0:c1] = color\n    return grid, widths, colors\n\n\ndef _gen_place_reverse_markers(grid, widths, colors):\n    block_count = len(colors)\n    start = random.randint(0, grid.shape[0] - block_count)\n    rows = list(range(start, start + block_count))\n    color_rows = {color: row for color, row in zip(reversed(colors), rows)}\n    _gen_place_aligned(grid, widths, colors, color_rows)\n    return list(reversed(range(block_count)))\n\n\ndef _gen_place_left_shift_markers(grid, widths, colors):\n    if random.random() < GEN_ALIGNED_LEFT_SHIFT_PROB:\n        block_count = len(colors)\n        if random.random() < GEN_NONCONSECUTIVE_LEFT_SHIFT_PROB:\n            rows = _gen_nonconsecutive_rows(grid.shape[0], block_count)\n            ordered_colors = random.sample(colors, block_count)\n        else:\n            start = random.randint(0, grid.shape[0] - block_count)\n            rows = list(range(start, start + block_count))\n            ordered_colors = list(reversed(colors))\n            swap_i = random.randrange(block_count - 1)\n            ordered_colors[swap_i : swap_i + 2] = reversed(ordered_colors[swap_i : swap_i + 2])\n        color_rows = {color: row for color, row in zip(ordered_colors, rows)}\n        _gen_place_aligned(grid, widths, colors, color_rows)\n    else:\n        _gen_place_unaligned_left_shift(grid, widths, colors)\n    return list(range(1, len(colors))) + [0]\n\n\ndef _gen_place_markers(grid, widths, colors):\n    if random.random() < GEN_REVERSE_PROB:\n        return _gen_place_reverse_markers(grid, widths, colors)\n    return _gen_place_left_shift_markers(grid, widths, colors)\n\n\ndef _gen_attempt():\n    grid, widths, colors = _gen_base_grid()\n    order = _gen_place_markers(grid, widths, colors)\n    expected = _gen_expected(grid, widths, order)\n    return grid if np.array_equal(main(grid), expected) else None\n\n\ndef generate_input():\n    for _ in range(GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid f18ec8cc input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{p=0} /\"'^def main'\"\\\\(/{p=1} /\"'^def generate_input'\"\\\\(/{p=2} p==1{print} p==2{print} p==2 && /\"'^    raise RuntimeError'\"\\\\(\\\"failed to generate valid input\\\"\\\\)/{p=0; print \\\"\\\"}' /home/lixinyu/snap/new/ARC_code/eval/9aaea919.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{p=0} /\"'^def main'\"\\\\(/{p=1} /\"'^def generate_input'\"\\\\(/{p=2} p==1{print} p==2{print} p==2 && /\"'^    raise RuntimeError'\"\\\\(\\\"failed to generate valid input\\\"\\\\)/{p=0; print \\\"\\\"}' /home/lixinyu/snap/new/ARC_code/eval/9aaea919.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Transfer sprites from red-marked lanes to green-marked lanes, recoloring and stacking.\n\n    Input structure:\n    - bg = most common color. Red (2) and green (3) thin bars define vertical lanes.\n    - Each lane contains repeated identical monochrome sprites in an evenly spaced vertical grid.\n\n    Rule:\n    - Each red lane's sprites turn grey (5); their count transfers to the nearest green lane.\n    - New sprites fill empty lattice slots bottom-up, using the source shape recolored to the destination lane's sprite color.\n    - All marker bars are removed.\n\n    Key insight: Sprite count is conserved across lanes — red sprites become grey, and equally many new sprites stack into the green lane's regular grid.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    red_markers = _find_marker_bars(g, 2)\n    green_markers = _find_marker_bars(g, 3)\n    assert red_markers and green_markers, \"expected both red and green marker bars to be present\"\n\n    # Build destination lane state per green marker.\n    green_state = {}\n    for gm in green_markers:\n        _, dst_c0, _, dst_c1 = bbox_coords(np.array(gm))\n        dst_cols = range(dst_c0, dst_c1 + 1)\n        dst_set = set(gm)\n        dst_comps = _single_color_components_in_cols(g, dst_cols, bg)\n        dst_comps = [[p for p in pts if p not in dst_set] for pts in dst_comps]\n        dst_comps = [pts for pts in dst_comps if pts]\n        if not dst_comps:\n            continue\n\n        dst_sz = max(len(p) for p in dst_comps if len(p) != len(gm))\n        dst_sprites = [p for p in dst_comps if len(p) == dst_sz]\n        if not dst_sprites:\n            continue\n\n        dst_sprites_sorted = []\n        for pts in dst_sprites:\n            rmin = min(r for r, _ in pts)\n            cmin = min(c for _, c in pts)\n            dst_sprites_sorted.append((rmin, cmin, pts))\n        dst_sprites_sorted.sort()\n        dst_color = int(g[dst_sprites_sorted[0][2][0][0], dst_sprites_sorted[0][2][0][1]])\n\n        tops = sorted({rmin for rmin, _cmin, _pts in dst_sprites_sorted})\n        if len(tops) >= 2:\n            diffs = [b - a for a, b in zip(tops, tops[1:]) if b - a > 0]\n            period = int(np.gcd.reduce(diffs)) if diffs else 4\n        else:\n            r0, c0, r1, c1 = bbox_coords(np.array(dst_sprites_sorted[0][2]))\n            period = (r1 - r0 + 1) + 1\n\n        gc = (dst_c0 + dst_c1) / 2.0\n        green_state[id(gm)] = {\n            \"marker\": gm,\n            \"center\": gc,\n            \"dst_color\": dst_color,\n            \"period\": period,\n            \"occupied\": set(tops),\n            \"bottom0\": max(tops),\n        }\n\n    assert green_state, \"expected at least one green lane with valid sprites\"\n\n    out = g.copy()\n\n    for rm in red_markers:\n        _, src_c0, _, src_c1 = bbox_coords(np.array(rm))\n        src_cols = range(src_c0, src_c1 + 1)\n        src_set = set(rm)\n        src_comps = _single_color_components_in_cols(g, src_cols, bg)\n        src_comps = [[p for p in pts if p not in src_set] for pts in src_comps]\n        src_comps = [pts for pts in src_comps if pts]\n        if not src_comps:\n            continue\n\n        src_sz = max(len(p) for p in src_comps if len(p) != len(rm))\n        src_sprites = [p for p in src_comps if len(p) == src_sz]\n        if not src_sprites:\n            continue\n\n        # Grey out all source sprites.\n        for pts in src_sprites:\n            for r, c in pts:\n                out[r, c] = 5\n\n        # Nearest green lane by x-center.\n        rc = (src_c0 + src_c1) / 2.0\n        best = min(green_state.values(), key=lambda st: abs(st[\"center\"] - rc))\n\n        # Source template (top-most sprite), shifted horizontally to the destination lane center.\n        src_sprites_sorted = []\n        for pts in src_sprites:\n            rmin = min(r for r, _ in pts)\n            cmin = min(c for _, c in pts)\n            src_sprites_sorted.append((rmin, cmin, pts))\n        src_sprites_sorted.sort()\n        src_ref_r0, _src_ref_c0, src_ref_pts = src_sprites_sorted[0]\n\n        dc_shift = int(round(best[\"center\"] - rc))\n        src_offsets = [(r - src_ref_r0, c + dc_shift) for r, c in src_ref_pts]\n        sprite_h = max(dr for dr, _c in src_offsets) + 1\n\n        # Place as many sprites as removed, filling empty slots from the bottom upward.\n        n_new = len(src_sprites)\n        placed = 0\n        k = 0\n        while placed < n_new:\n            new_top = best[\"bottom0\"] - k * best[\"period\"]\n            k += 1\n            if new_top < 0 or new_top + sprite_h > h:\n                if new_top < 0:\n                    break\n                continue\n            if new_top in best[\"occupied\"]:\n                continue\n            ok = True\n            for dr, c in src_offsets:\n                rr = new_top + dr\n                if not (0 <= rr < h and 0 <= c < w):\n                    ok = False\n                    break\n                if int(out[rr, c]) != bg:\n                    ok = False\n                    break\n            if not ok:\n                continue\n            for dr, c in src_offsets:\n                out[new_top + dr, c] = best[\"dst_color\"]\n            best[\"occupied\"].add(new_top)\n            placed += 1\n\n    # Remove all marker bars.\n    for rm in red_markers:\n        for r, c in rm:\n            out[r, c] = bg\n    for gm in green_markers:\n        for r, c in gm:\n            out[r, c] = bg\n\n    return out\n\n# --------------- generator (O3) ---------------\n\n# --- CFG: canvas & layout ---\n_H, _W = 30, 30\n_NUM_LANES = 4\n_LANE_STARTS = [3, 9, 15, 21]       # col-0 of each lane's 5-wide sprite slot\n_MARKER_ROW = 29                     # row for red/green 1x5 marker bars\n_SPRITE_H, _SPRITE_W = 3, 5         # bounding box of the plus/diamond sprite\n\n# --- CFG: vertical stacking ---\n_BOTTOM_TOP = 25                     # top-row of the bottommost sprite\n_PERIOD = 4                          # vertical period (3 sprite rows + 1 gap)\n\n# --- CFG: color palette ---\n_BG_CHOICES = [0, 1, 4, 6, 7, 8, 9] # valid background colors (excludes 2, 3, 5)\n_GREY = 5                            # color used for greyed-out source sprites\n\n# --- CFG: counts & limits ---\n_MIN_SPRITES = 1                     # min sprites per lane in input\n_MAX_SPRITES = 3                     # max sprites per lane in input\n_MAX_LANE_TOTAL = 7                  # max sprites in green lane after transfer\n_GEN_RETRIES = 300                   # retry budget for generate_input()\n\n\ndef _sprite_patch(color: int, bg: int) -> np.ndarray:\n    \"\"\"Return a 3x5 plus/diamond sprite patch with bg-transparent corners.\"\"\"\n    patch = np.full((_SPRITE_H, _SPRITE_W), bg, dtype=int)\n    patch[0, 1:4] = color\n    patch[1, :] = color\n    patch[2, 1:4] = color\n    return patch\n\n\ndef _lane_tops(count: int) -> list[int]:\n    \"\"\"Return top-row positions for `count` sprites, ordered top-to-bottom.\"\"\"\n    return [_BOTTOM_TOP - _PERIOD * k for k in range(count - 1, -1, -1)]\n\n\ndef _paint_lane(grid: np.ndarray, lane_idx: int, color: int, count: int, bg: int) -> None:\n    \"\"\"Stamp `count` sprites of `color` into the given lane.\"\"\"\n    patch = _sprite_patch(color, bg)\n    c0 = _LANE_STARTS[lane_idx]\n    for r0 in _lane_tops(count):\n        paste(grid, patch, r0, c0, transparent=bg)\n\n\ndef _feasible_roles(counts: list[int]) -> dict[int, list[tuple[tuple[int, ...], int]]]:\n    \"\"\"Return feasible (reds, green) assignments grouped by number of red lanes.\"\"\"\n    grouped: dict[int, list[tuple[tuple[int, ...], int]]] = {1: [], 2: []}\n    for green in range(_NUM_LANES):\n        others = [i for i in range(_NUM_LANES) if i != green]\n        for red_count in (1, 2):\n            for reds in combinations(others, red_count):\n                if counts[green] + sum(counts[i] for i in reds) <= _MAX_LANE_TOTAL:\n                    grouped[red_count].append((reds, green))\n    return grouped\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    # Choose palette\n    bg = int(rng.choice(_BG_CHOICES))\n    sprite_palette = [c for c in range(10) if c not in (bg, _GREY)]\n    lane_colors = rng.choice(sprite_palette, size=_NUM_LANES, replace=False).tolist()\n    input_counts = rng.integers(_MIN_SPRITES, _MAX_SPRITES + 1, size=_NUM_LANES).tolist()\n\n    # Choose role assignment (red source lanes, green destination lane)\n    feasible = _feasible_roles(input_counts)\n    feasible_red_counts = [rc for rc in (1, 2) if feasible[rc]]\n    if not feasible_red_counts:\n        return None\n\n    red_count = int(rng.choice(feasible_red_counts))\n    reds, green = feasible[red_count][int(rng.integers(len(feasible[red_count])))]\n    red_set = set(reds)\n    gain = sum(input_counts[i] for i in reds)\n\n    # Build OUTPUT grid: red lanes use grey, green lane has extra sprites\n    output_counts = input_counts[:]\n    output_counts[green] += gain\n    out = np.full((_H, _W), bg, dtype=int)\n    for lane_idx in range(_NUM_LANES):\n        color = _GREY if lane_idx in red_set else lane_colors[lane_idx]\n        _paint_lane(out, lane_idx, color, output_counts[lane_idx], bg)\n\n    # Derive INPUT from output\n    inp = out.copy()\n    for lane_idx in reds:\n        _paint_lane(inp, lane_idx, lane_colors[lane_idx], input_counts[lane_idx], bg)\n\n    # Erase the gained sprites in the green lane and add markers\n    green_c0 = _LANE_STARTS[green]\n    for r0 in _lane_tops(output_counts[green])[:gain]:\n        inp[r0:r0 + _SPRITE_H, green_c0:green_c0 + _SPRITE_W] = bg\n    inp[_MARKER_ROW, green_c0:green_c0 + _SPRITE_W] = 3\n\n    for lane_idx in reds:\n        c0 = _LANE_STARTS[lane_idx]\n        inp[_MARKER_ROW, c0:c0 + _SPRITE_W] = 2\n\n    # Oracle check\n    if not np.array_equal(main(inp), out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"failed to generate a valid input after {_GEN_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
