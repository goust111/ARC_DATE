{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/a/des/code/combo_new/seed1852178230/12/4.py | sed -n '1,260p'\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\t\n     3\timport numpy as np\n     4\t\n     5\t\n     6\tBLACK = 0\n     7\tGREEN = 3\n     8\tGREY = 5\n     9\tMAROON = 9\n    10\tTILE_COLORS = (1, 2, 4, 6, 7, 8)\n    11\tMASKS = [(l, u, r) for l in (0, 1) for u in (0, 1) for r in (0, 1)]\n    12\tCORNER_BY_INDEX = ((0, 0), (0, 2), (2, 0), (2, 2), (0, 0), (0, 2), (2, 0), (2, 2))\n    13\tGEN_ATTEMPTS = 300\n    14\t\n    15\t\n    16\tdef _most_common_color(grid: np.ndarray) -> int:\n    17\t    values, counts = np.unique(grid, return_counts=True)\n    18\t    return int(values[np.argmax(counts)])\n    19\t\n    20\t\n    21\tdef _find_divider_col(grid: np.ndarray, bg: int) -> int:\n    22\t    preferred = np.flatnonzero(np.all(grid == MAROON, axis=0))\n    23\t    if preferred.size == 1:\n    24\t        return int(preferred[0])\n    25\t\n    26\t    candidates = []\n    27\t    for c in range(grid.shape[1]):\n    28\t        col = grid[:, c]\n    29\t        if int(col[0]) != bg and np.all(col == col[0]):\n    30\t            candidates.append(c)\n    31\t    assert len(candidates) == 1, f\"expected one full-height divider, got {candidates}\"\n    32\t    return int(candidates[0])\n    33\t\n    34\t\n    35\tdef _extract_templates(left: np.ndarray, bg: int) -> dict[tuple[int, int, int], np.ndarray]:\n    36\t    h, w = left.shape\n    37\t    templates: dict[tuple[int, int, int], np.ndarray] = {}\n    38\t    for r in range(3, h):\n    39\t        for c in range(w - 2):\n    40\t            label = left[r, c : c + 3]\n    41\t            if not np.all(np.isin(label, (GREEN, GREY))):\n    42\t                continue\n    43\t            if c > 0 and int(left[r, c - 1]) != bg:\n    44\t                continue\n    45\t            if c + 3 < w and int(left[r, c + 3]) != bg:\n    46\t                continue\n    47\t            tile = left[r - 3 : r, c : c + 3].copy()\n    48\t            if not np.any(tile != bg):\n    49\t                continue\n    50\t            mask = tuple(int(v == GREEN) for v in label.tolist())\n    51\t            assert mask not in templates, f\"duplicate template for mask {mask}\"\n    52\t            templates[mask] = tile\n    53\t    assert templates, \"failed to parse any labeled templates\"\n    54\t    return templates\n    55\t\n    56\t\n    57\tdef _sorted_seed_positions(canvas: np.ndarray) -> list[tuple[int, int]]:\n    58\t    coords = np.argwhere(canvas == GREEN)\n    59\t    order = np.lexsort((coords[:, 1], coords[:, 0]))\n    60\t    return [tuple(map(int, coords[i])) for i in order]\n    61\t\n    62\t\n    63\tdef _neighbor_mask(canvas: np.ndarray, r: int, c: int, bg: int) -> tuple[int, int, int]:\n    64\t    h, w = canvas.shape\n    65\t    return (\n    66\t        int(c - 1 >= 0 and int(canvas[r, c - 1]) != bg),\n    67\t        int(r - 1 >= 0 and int(canvas[r - 1, c]) != bg),\n    68\t        int(c + 1 < w and int(canvas[r, c + 1]) != bg),\n    69\t    )\n    70\t\n    71\t\n    72\tdef _stamp_tile(canvas: np.ndarray, tile: np.ndarray, center: tuple[int, int], bg: int) -> None:\n    73\t    h, w = canvas.shape\n    74\t    r0, c0 = center\n    75\t    for dr in range(-1, 2):\n    76\t        for dc in range(-1, 2):\n    77\t            rr = r0 + dr\n    78\t            cc = c0 + dc\n    79\t            if not (0 <= rr < h and 0 <= cc < w):\n    80\t                continue\n    81\t            value = int(tile[dr + 1, dc + 1])\n    82\t            if value != bg:\n    83\t                canvas[rr, cc] = value\n    84\t\n    85\t\n    86\tdef _solve_canvas(canvas: np.ndarray, templates: dict[tuple[int, int, int], np.ndarray], bg: int) -> np.ndarray:\n    87\t    out = canvas.copy()\n    88\t    for seed in _sorted_seed_positions(canvas):\n    89\t        mask = _neighbor_mask(out, seed[0], seed[1], bg)\n    90\t        assert mask in templates, f\"missing template for mask {mask}\"\n    91\t        _stamp_tile(out, templates[mask], seed, bg)\n    92\t    return out\n    93\t\n    94\t\n    95\tdef _solve_grid(grid: np.ndarray) -> np.ndarray:\n    96\t    g = np.asarray(grid, dtype=int)\n    97\t    bg = _most_common_color(g)\n    98\t    divider_col = _find_divider_col(g, bg)\n    99\t    templates = _extract_templates(g[:, :divider_col], bg)\n   100\t    return _solve_canvas(g[:, divider_col + 1 :], templates, bg)\n   101\t\n   102\t\n   103\tdef main(grid: np.ndarray) -> np.ndarray:\n   104\t    \"\"\"\n   105\t    Copy the labeled 3x3 texture that matches each seed's local neighborhood and grow the picture step by step.\n   106\t\n   107\t    Input structure:\n   108\t    - The background is black.\n   109\t    - A full-height maroon divider splits the grid into a left template area and a right main canvas.\n   110\t    - In the template area, each example consists of a 3x3 colored texture with an attached 1x3 label row underneath.\n   111\t    - In each label row, green marks mean \"left neighbor exists\", \"upper neighbor exists\", and \"right neighbor exists\"; grey marks absent directions.\n   112\t    - The main canvas contains isolated green seed pixels on background.\n   113\t\n   114\t    Rule:\n   115\t    - Read the green seeds on the main canvas in row-major order.\n   116\t    - For the current seed, test whether the left, upper, and right adjacent cells are already non-background on the current canvas.\n   117\t    - Match that three-bit neighborhood pattern to the unique label row in the template area.\n   118\t    - Stamp the corresponding 3x3 texture centered on the seed; only the texture's non-background pixels are drawn, so earlier pixels can remain visible.\n   119\t    - Each stamped texture immediately affects later seeds.\n   120\t    - Return only the right-side main canvas, excluding the divider and the template area.\n   121\t\n   122\t    Key insight:\n   123\t    - The label row is a direction code for the seed's visible neighborhood, and the seeds must be processed in a fixed order because earlier growth changes later neighborhood tests.\n   124\t    \"\"\"\n   125\t    return _solve_grid(np.asarray(grid, dtype=int))\n   126\t\n   127\t\n   128\tdef _build_tile(mask: tuple[int, int, int], rng: np.random.Generator, idx: int) -> np.ndarray:\n   129\t    base = int(rng.choice(np.array(TILE_COLORS, dtype=int)))\n   130\t    accent_pool = np.array([c for c in TILE_COLORS if c != base], dtype=int)\n   131\t    accent = int(rng.choice(accent_pool))\n   132\t\n   133\t    tile = np.full((3, 3), base, dtype=int)\n   134\t    tile[1, 1] = accent\n   135\t    tile[2, 1] = accent\n   136\t    if mask[0]:\n   137\t        tile[1, 0] = BLACK\n   138\t    if mask[1]:\n   139\t        tile[0, 1] = BLACK\n   140\t    if mask[2]:\n   141\t        tile[1, 2] = BLACK\n   142\t\n   143\t    cr, cc = CORNER_BY_INDEX[idx]\n   144\t    tile[cr, cc] = accent\n   145\t    if sum(mask) >= 2:\n   146\t        tile[2, cc] = accent\n   147\t    return tile\n   148\t\n   149\t\n   150\tdef _build_templates(rng: np.random.Generator) -> dict[tuple[int, int, int], np.ndarray]:\n   151\t    order = MASKS.copy()\n   152\t    rng.shuffle(order)\n   153\t    templates = {}\n   154\t    for idx, mask in enumerate(order):\n   155\t        templates[mask] = _build_tile(mask, rng, idx)\n   156\t    return templates\n   157\t\n   158\t\n   159\tdef _sample_row_positions(rng: np.random.Generator, height: int) -> list[int]:\n   160\t    base = np.array([0, 1, 1, 1, 0], dtype=int)\n   161\t    extra = int(height - 19)\n   162\t    if extra > 0:\n   163\t        base += rng.multinomial(extra, [0.2] * 5)\n   164\t    rows = [int(base[0])]\n   165\t    for gap in base[1:4]:\n   166\t        rows.append(rows[-1] + 4 + int(gap))\n   167\t    return rows\n   168\t\n   169\t\n   170\tdef _sample_col_positions(rng: np.random.Generator, left_width: int) -> list[int]:\n   171\t    base = np.array([0, 1, 0], dtype=int)\n   172\t    extra = int(left_width - 7)\n   173\t    if extra > 0:\n   174\t        base += rng.multinomial(extra, [1 / 3] * 3)\n   175\t    c0 = int(base[0])\n   176\t    c1 = c0 + 3 + int(base[1])\n   177\t    return [c0, c1]\n   178\t\n   179\t\n   180\tdef _place_template_panel(\n   181\t    grid: np.ndarray,\n   182\t    templates: dict[tuple[int, int, int], np.ndarray],\n   183\t    rows: list[int],\n   184\t    cols: list[int],\n   185\t) -> None:\n   186\t    masks = MASKS.copy()\n   187\t    rng = np.random.default_rng()\n   188\t    rng.shuffle(masks)\n   189\t    idx = 0\n   190\t    for r in rows:\n   191\t        for c in cols:\n   192\t            mask = masks[idx]\n   193\t            grid[r : r + 3, c : c + 3] = templates[mask]\n   194\t            grid[r + 3, c : c + 3] = np.array([GREEN if bit else GREY for bit in mask], dtype=int)\n   195\t            idx += 1\n   196\t\n   197\t\n   198\tdef _grow_seed_component(\n   199\t    rng: np.random.Generator,\n   200\t    gh: int,\n   201\t    gw: int,\n   202\t    target: int,\n   203\t) -> set[tuple[int, int]]:\n   204\t    cells = {(int(rng.integers(gh)), int(rng.integers(gw)))}\n   205\t    while len(cells) < target:\n   206\t        frontier = []\n   207\t        for r, c in cells:\n   208\t            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n   209\t                nr = r + dr\n   210\t                nc = c + dc\n   211\t                if 0 <= nr < gh and 0 <= nc < gw and (nr, nc) not in cells:\n   212\t                    frontier.append((nr, nc))\n   213\t        if frontier and (rng.random() < 0.85 or len(cells) < 4):\n   214\t            cells.add(frontier[int(rng.integers(len(frontier)))])\n   215\t            continue\n   216\t        empties = [(r, c) for r in range(gh) for c in range(gw) if (r, c) not in cells]\n   217\t        if not empties:\n   218\t            break\n   219\t        cells.add(empties[int(rng.integers(len(empties)))])\n   220\t    return cells\n   221\t\n   222\t\n   223\tdef _build_seed_canvas(rng: np.random.Generator, height: int, width: int) -> np.ndarray:\n   224\t    gh = int(rng.integers(4, 8))\n   225\t    gw = int(rng.integers(4, 8))\n   226\t    target = int(rng.integers(6, min(15, gh * gw) + 1))\n   227\t    cells = _grow_seed_component(rng, gh, gw, target)\n   228\t    top = int(rng.integers(1, height - gh))\n   229\t    left = int(rng.integers(1, width - gw))\n   230\t\n   231\t    canvas = np.full((height, width), BLACK, dtype=int)\n   232\t    for r, c in cells:\n   233\t        canvas[top + r, left + c] = GREEN\n   234\t    return canvas\n   235\t\n   236\t\n   237\tdef _seed_only_masks(canvas: np.ndarray) -> list[tuple[int, int, int]]:\n   238\t    seeds = _sorted_seed_positions(canvas)\n   239\t    seed_set = set(seeds)\n   240\t    return [\n   241\t        (\n   242\t            int((r, c - 1) in seed_set),\n   243\t            int((r - 1, c) in seed_set),\n   244\t            int((r, c + 1) in seed_set),\n   245\t        )\n   246\t        for r, c in seeds\n   247\t    ]\n   248\t\n   249\t\n   250\tdef _quality_ok(\n   251\t    seed_canvas: np.ndarray,\n   252\t    output: np.ndarray,\n   253\t    templates: dict[tuple[int, int, int], np.ndarray],\n   254\t) -> bool:\n   255\t    seeds = _sorted_seed_positions(seed_canvas)\n   256\t    if len(seeds) < 6:\n   257\t        return False\n   258\t\n   259\t    masks_seen = []\n   260\t    canvas = seed_canvas.copy()\n","exit_code":0,"status":"completed"}}
