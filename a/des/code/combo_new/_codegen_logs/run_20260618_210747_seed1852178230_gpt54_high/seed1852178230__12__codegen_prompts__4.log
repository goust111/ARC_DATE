{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom __future__ import annotations\nimport numpy as np\n\nBG=0\nGREEN=3\nGREY=5\nDIV=9\nTILE_COLORS=[1,2,4,6,7,8]\nMASKS=[(l,u,r) for l in (0,1) for u in (0,1) for r in (0,1)]\nCORNER_CELLS=[(0,0),(0,2),(2,0),(2,2),(0,0),(0,2),(2,0),(2,2)]\n\n\ndef build_tiles(rng):\n    tiles={}\n    for i,mask in enumerate(MASKS):\n        base=int(rng.choice(TILE_COLORS))\n        accent_choices=[c for c in TILE_COLORS if c\"'!=base]\n        accent=int(rng.choice(accent_choices))\n        tile=np.full((3,3), base, dtype=int)\n        tile[1,1]=accent\n        tile[2,1]=accent\n        if mask[0]:\n            tile[1,0]=BG\n        if mask[1]:\n            tile[0,1]=BG\n        if mask[2]:\n            tile[1,2]=BG\n        cr,cc=CORNER_CELLS[i]\n        tile[cr,cc]=accent\n        if sum(mask)>=2:\n            tile[2,2-cc]=accent if cr==0 else accent\n        tiles[mask]=tile\n    return tiles\n\n\ndef stamp(canvas, tile, r, c, bg=BG):\n    h,w=canvas.shape\n    for dr in range(-1,2):\n        for dc in range(-1,2):\n            rr=r+dr; cc=c+dc\n            if 0<=rr<h and 0<=cc<w:\n                val=int(tile[dr+1,dc+1])\n                if val!=bg:\n                    canvas[rr,cc]=val\n\n\ndef solve_canvas(canvas, tiles, bg=BG):\n    canvas=canvas.copy()\n    seeds=sorted(map(tuple,np.argwhere(canvas==GREEN).tolist()))\n    masks=[]\n    for r,c in seeds:\n        mask=(\n            1 if c-1>=0 and canvas[r,c-1]!=bg else 0,\n            1 if r-1>=0 and canvas[r-1,c]!=bg else 0,\n            1 if c+1<canvas.shape[1] and canvas[r,c+1]!=bg else 0,\n        )\n        masks.append(mask)\n        stamp(canvas, tiles[mask], r, c, bg)\n    return canvas,masks,seeds\n\n\ndef initial_masks(canvas,seeds,bg=BG):\n    s=set(seeds)\n    masks=[]\n    h,w=canvas.shape\n    for r,c in seeds:\n        masks.append((int((r,c-1) in s), int((r-1,c) in s), int((r,c+1) in s)))\n    return masks\n\n\ndef random_seed_canvas(rng, H, W):\n    gh=int(rng.integers(4,8))\n    gw=int(rng.integers(4,8))\n    max_cells=gh*gw\n    target=int(rng.integers(max(6,max_cells//3), min(15,max_cells*2//3)+1))\n    cells={(int(rng.integers(gh)), int(rng.integers(gw)))}\n    while len(cells)<target:\n        frontier=[]\n        for r,c in cells:\n            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                nr,nc=r+dr,c+dc\n                if 0<=nr<gh and 0<=nc<gw and (nr,nc) not in cells:\n                    frontier.append((nr,nc))\n        if not frontier:\n            break\n        cells.add(frontier[int(rng.integers(len(frontier)))])\n        if rng.random()<0.2:\n            empties=[(r,c) for r in range(gh) for c in range(gw) if (r,c) not in cells]\n            if empties:\n                cells.add(empties[int(rng.integers(len(empties)))])\n                if len(cells)>=target:\n                    break\n    sr=int(rng.integers(1, H-gh-1))\n    sc=int(rng.integers(1, W-gw-1))\n    canvas=np.full((H,W), BG, dtype=int)\n    for r,c in cells:\n        canvas[sr+r, sc+c]=GREEN\n    return canvas\n\nrng=np.random.default_rng(0)\ncounts=[]\nfor _ in range(500):\n    H=int(rng.integers(20,27))\n    W=int(rng.integers(10,21))\n    tiles=build_tiles(rng)\n    ok=False\n    for _ in range(300):\n        canvas=random_seed_canvas(rng,H,W)\n        out,masks,seeds=solve_canvas(canvas,tiles)\n        init=initial_masks(canvas,seeds)\n        bits=np.array(masks)\n        if len(seeds) < 6:\n            continue\n        distinct=len(set(masks))\n        if distinct < 4:\n            continue\n        if not all(bits[:,i].min()==0 and bits[:,i].max()==1 for i in range(3)):\n            continue\n        if not any(a!=b for a,b in zip(masks,init)):\n            continue\n        if np.count_nonzero(out!=BG) > H*W*0.55:\n            continue\n        counts.append(distinct)\n        ok=True\n        break\n    if not ok:\n        print('\"'failed')\n        break\nelse:\n    print('all ok', len(counts), 'avg distinct', sum(counts)/len(counts))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
