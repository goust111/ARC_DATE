{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nfrom collections import deque\nrng=np.random.default_rng(0)\n\nFRAME=5\nPALETTE=[1,2,3,4,6,7,8,9]\n\ndef bbox(coords):\n    coords=np.asarray(coords)\n    return tuple(map(int,(coords[:,0].min(),coords[:,1].min(),coords[:,0].max(),coords[:,1].max())))\n\ndef find_frame(g):\n    for color in np.unique(g):\n        color=int(color)\n        if color==0: continue\n        coords=np.argwhere(g==color)\n        r0,c0,r1,c1=bbox(coords)\n        h,w=r1-r0+1,c1-c0+1\n        if h<3 or w<3: continue\n        rel=coords-np.array([r0,c0])\n        border=((rel[:,0]==0)|(rel[:,0]==h-1)|(rel[:,1]==0)|(rel[:,1]==w-1))\n        if coords.shape[0]==2*h+2*w-4 and border.all():\n            return color,(r0,c0,r1,c1)\n    raise ValueError\n\ndef solve(grid):\n    g=np.asarray(grid)\n    frame,(fr0,fc0,fr1,fc1)=find_frame(g)\n    inner=g[fr0+1:fr1,fc0+1:fc1]\n    colors=[int(c) for c in np.unique(inner) if c not in (0,frame)]\n    rects=[]\n    for color in colors:\n        coords=np.argwhere(inner==color)\n        r0,c0,r1,c1=bbox(coords)\n        area=(r1-r0+1)*(c1-c0+1)\n        rects.append({'color':color,'bbox':(r0,c0,r1,c1),'h':r1-r0+1,'w':c1-c0+1,'hidden':area-int(coords.shape[0])})\n    n=len(rects)\n    outs=[set() for _ in range(n)]\n    indeg=[0]*n\n    for i in range(n):\n        a=rects[i]\n        ar0,ac0,ar1,ac1=a['bbox']\n        for j in range(i+1,n):\n            b=rects[j]\n            br0,bc0,br1,bc1=b['bbox']\n            r0=max(ar0,br0); c0=max(ac0,bc0); r1=min(ar1,br1); c1=min(ac1,bc1)\n            if r0>r1 or c0>c1: continue\n            patch=inner[r0:r1+1,c0:c1+1]\n            ha=np.any(patch==a['color']); hb=np.any(patch==b['color'])\n            if ha and not hb:\n                outs[i].add(j); indeg[j]+=1\n            elif hb and not ha:\n                outs[j].add(i); indeg[i]+=1\n            else:\n                raise AssertionError((i,j,ha,hb,patch))\n    order=[]\n    avail=[i for i,d in enumerate(indeg) if d==0]\n    while avail:\n        if len(avail)\"'!=1:\n            raise AssertionError(('\"'nonunique',avail,rects))\n        i=avail.pop()\n        order.append(i)\n        for j in list(outs[i]):\n            indeg[j]-=1\n            if indeg[j]==0:\n                avail.append(j)\n    if len(order)\"'!=n: raise AssertionError('\"'cycle')\n    ordered=[rects[i] for i in order]\n    H=max(r['h'] for r in ordered)\n    W=sum(r['w'] for r in ordered)+sum(r['hidden'] for r in ordered[:-1])\n    out=np.zeros((H,W),int)\n    c=0\n    for k,r in enumerate(ordered):\n        out[:r['h'],c:c+r['w']]=r['color']\n        c+=r['w']\n        if k+1<n: c+=r['hidden']\n    return out\n\ndef inter(a,b):\n    r0=max(a['r'],b['r']); c0=max(a['c'],b['c'])\n    r1=min(a['r']+a['h']-1,b['r']+b['h']-1); c1=min(a['c']+a['w']-1,b['c']+b['w']-1)\n    if r0>r1 or c0>c1: return 0, None\n    return (r1-r0+1)*(c1-c0+1),(r0,c0,r1,c1)\n\ndef gen_once():\n    n=int(rng.integers(3,5))\n    colors=list(rng.choice(PALETTE,size=n,replace=False))\n    rects=[]\n    h=int(rng.integers(3,6)); w=int(rng.integers(3,6))\n    rects.append({'r':0,'c':0,'h':h,'w':w,'color':colors[0]})\n    dirs=['br','bl','tr','tl']\n    for i in range(1,n):\n        h=int(rng.integers(3,6)); w=int(rng.integers(3,6))\n        prev=rects[-1]\n        oh=int(rng.integers(1,min(2,prev['h']-1,h)+1))\n        ow=int(rng.integers(1,min(2,prev['w']-1,w)+1))\n        d=dirs[int(rng.integers(0,4))]\n        if d=='br':\n            r=prev['r']+prev['h']-oh; c=prev['c']+prev['w']-ow\n        elif d=='bl':\n            r=prev['r']+prev['h']-oh; c=prev['c']-(w-ow)\n        elif d=='tr':\n            r=prev['r']-(h-oh); c=prev['c']+prev['w']-ow\n        else:\n            r=prev['r']-(h-oh); c=prev['c']-(w-ow)\n        rects.append({'r':r,'c':c,'h':h,'w':w,'color':colors[i]})\n    # reject nonadjacent overlaps\n    for i in range(n):\n        for j in range(i+1,n):\n            area,_=inter(rects[i],rects[j])\n            if j==i+1:\n                if area<=0 or area>4: return None\n            elif area>0:\n                return None\n    minr=min(r['r'] for r in rects); minc=min(r['c'] for r in rects)\n    for r in rects:\n        r['r']-=minr; r['c']-=minc\n    union_h=max(r['r']+r['h'] for r in rects)\n    union_w=max(r['c']+r['w'] for r in rects)\n    if union_h>20 or union_w>20: return None\n    inner_top=int(rng.integers(0,3)); inner_bottom=int(rng.integers(0,3)); inner_left=int(rng.integers(0,3)); inner_right=int(rng.integers(0,3))\n    inner_h=union_h+inner_top+inner_bottom\n    inner_w=union_w+inner_left+inner_right\n    if inner_h+2>26 or inner_w+2>26: return None\n    outer_v=int(rng.integers(0,4)); outer_h=int(rng.integers(0,4))\n    outer_top=outer_v//2; outer_bottom=outer_v-outer_top\n    outer_left=outer_h//2; outer_right=outer_h-outer_left\n    H=inner_h+2+outer_top+outer_bottom; W=inner_w+2+outer_left+outer_right\n    if H>30 or W>30: return None\n    grid=np.zeros((H,W),int)\n    fr0=outer_top; fc0=outer_left; fr1=fr0+inner_h+1; fc1=fc0+inner_w+1\n    grid[fr0,fc0:fc1+1]=FRAME; grid[fr1,fc0:fc1+1]=FRAME; grid[fr0:fr1+1,fc0]=FRAME; grid[fr0:fr1+1,fc1]=FRAME\n    shift_r=fr0+1+inner_top; shift_c=fc0+1+inner_left\n    for rect in rects:\n        rr=rect['r']+shift_r; cc=rect['c']+shift_c\n        grid[rr:rr+rect['h'],cc:cc+rect['w']]=rect['color']\n    out=solve(grid)\n    if max(out.shape)>30: return None\n    # hidden counts via original overlay\n    scene=np.zeros((union_h,union_w),int)\n    vis=[]\n    for rect in rects:\n        scene[rect['r']:rect['r']+rect['h'],rect['c']:rect['c']+rect['w']]=rect['color']\n    expected=[]\n    W2=0; H2=0\n    for rect in rects[::-1]:\n        mask=scene==rect['color']\n        visible=int(mask.sum())\n        hidden=rect['h']*rect['w']-visible\n        expected.append((rect['color'],rect['h'],rect['w'],hidden))\n        W2+=rect['w']; H2=max(H2,rect['h'])\n    W2+=sum(h for *_x,h in expected[:-1])\n    exp=np.zeros((H2,W2),int)\n    c=0\n    for idx,(color,h,w,hidden) in enumerate(expected):\n        exp[:h,c:c+w]=color\n        c+=w\n        if idx+1<len(expected): c+=hidden\n    if not np.array_equal(out,exp):\n        print(rects)\n        print(grid)\n        print(out)\n        print(exp)\n        raise SystemExit('mismatch')\n    return grid,out\n\nok=0\nfor t in range(1000):\n    x=gen_once()\n    if x is not None:\n        ok+=1\nprint('ok',ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
