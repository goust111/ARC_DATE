{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/6cbe9eb8.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, paste\n\n\ndef _rect_item(g: np.ndarray, color: int) -> dict:\n    coords = np.argwhere(g == int(color))\n    assert coords.size, \"expected a present color\"\n    r0, c0, r1, c1 = bbox_coords(coords)\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    area = h * w\n\n    rel = coords - np.array([r0, c0])\n    on_border = (\n        (rel[:, 0] == 0)\n        | (rel[:, 0] == h - 1)\n        | (rel[:, 1] == 0)\n        | (rel[:, 1] == w - 1)\n    )\n    if int(coords.shape[0]) == area:\n        kind = \"solid\"\n    else:\n        assert bool(np.all(on_border)), \"foreground colors must form rectangles or rectangular frames\"\n        kind = \"frame\"\n\n    return {\n        \"color\": int(color),\n        \"kind\": kind,\n        \"height\": h,\n        \"width\": w,\n        \"area\": area,\n    }\n\n\ndef _foreground_rectangles(g: np.ndarray) -> list[dict]:\n    items = []\n    for color in np.unique(g):\n        comps = components_mask(g == int(color), connectivity=4)\n        sizes = [int(comp.shape[0]) for comp in comps]\n        assert sizes, \"unique colors must have at least one component\"\n\n        # Wallpaper colors appear as many tiny disconnected islands; overlaid\n        # rectangle colors have one large component, sometimes split by occlusion.\n        if max(sizes) <= 3:\n            continue\n        assert len(comps) <= 4, \"foreground rectangle colors have only a few visible components\"\n        items.append(_rect_item(g, int(color)))\n\n    assert len(items) >= 2, \"expected at least two nested foreground rectangles\"\n    areas = [item[\"area\"] for item in items]\n    assert len(areas) == len(set(areas)), \"rectangle areas must define a unique nesting order\"\n    items.sort(key=lambda item: int(item[\"area\"]), reverse=True)\n    return items\n\n\ndef _paint_item(out: np.ndarray, item: dict, r: int, c: int) -> tuple[int, int, int, int]:\n    color = int(item[\"color\"])\n    h = int(item[\"height\"])\n    w = int(item[\"width\"])\n    assert 0 <= r and 0 <= c and r + h <= out.shape[0] and c + w <= out.shape[1]\n\n    if item[\"kind\"] == \"solid\":\n        out[r : r + h, c : c + w] = color\n        return r, c, h, w\n\n    assert item[\"kind\"] == \"frame\"\n    assert h >= 3 and w >= 3, \"frames must have an interior\"\n    out[r, c : c + w] = color\n    out[r + h - 1, c : c + w] = color\n    out[r : r + h, c] = color\n    out[r : r + h, c + w - 1] = color\n    return r + 1, c + 1, h - 2, w - 2\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rebuild the foreground rectangles as a largest-to-smallest lower-left nesting.\n\n    Input structure\n    - A periodic wallpaper background is overlaid by foreground colors that each form a rectangular frame or solid rectangle.\n    - The largest foreground rectangle is the output frame; smaller foreground rectangles are the objects to nest inside it.\n    - A frame may be partially hidden by a smaller rectangle, but its visible pixels still determine its bbox.\n\n    Rule\n    - Ignore the wallpaper and crop the result to the largest foreground rectangle's bbox size.\n    - Sort foreground rectangles by bbox area from largest to smallest.\n    - Reconstruct each frame or solid rectangle, placing every next smaller rectangle in the lower-left of the current rectangle's usable region.\n\n    Key insight\n    - The scattered background colors are not objects; the meaningful order is the unique descending rectangle size chain, and each step nests into the previous rectangle's lower-left interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    items = _foreground_rectangles(g)\n    outer = items[0]\n    out = np.zeros((int(outer[\"height\"]), int(outer[\"width\"])), dtype=int)\n\n    region = _paint_item(out, outer, 0, 0)\n    for item in items[1:]:\n        rr, cc, rh, rw = region\n        h = int(item[\"height\"])\n        w = int(item[\"width\"])\n        assert h <= rh and w <= rw, \"nested rectangle must fit in parent usable region\"\n        r = rr + rh - h\n        c = cc\n        region = _paint_item(out, item, r, c)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n_RNG = np.random.default_rng()\n\n# Colors and sentinels.\nCOLOR_VALUES, FOREGROUND_COLORS = tuple(range(10)), tuple(range(1, 10))\nTRANSPARENT = -1\n# Rectangle chain counts.\nITEM_COUNT_RANGE, THREE_ITEM_FRAME_OPTIONS = (3, 4), (1, 2)\nFOUR_ITEM_FRAME_COUNT = 2\n# Solid rectangle dimensions.\nINNER_SOLID_HEIGHT_RANGE, INNER_SOLID_WIDTH_RANGE = (2, 3), (2, 3)\nSECOND_SOLID_MAX_HEIGHT, SECOND_SOLID_MAX_WIDTH = 9, 9\n# Frame growth and bounds.\nFRAME_MIN_GROWTH, INNER_FRAME_MAX_GROWTH = 2, 5\nINNER_FRAME_MAX_HEIGHT, INNER_FRAME_MAX_WIDTH = 13, 11\nOUTER_FRAME_MIN_HEIGHT, OUTER_FRAME_MIN_WIDTH = 8, 8\nOUTER_FRAME_MAX_HEIGHT, OUTER_FRAME_MAX_WIDTH = 15, 13\n# Wallpaper canvas bounds and margin around the outer rectangle.\nCANVAS_HEIGHT_RANGE, CANVAS_WIDTH_RANGE = (13, 19), (22, 27)\nCANVAS_BORDER_MARGIN = 1\n# Wallpaper tile/color sampling.\nWALLPAPER_COLOR_COUNT_RANGE = (2, 4)\nZERO_WALLPAPER_ROLL_RANGE = (0, 4)\nZERO_WALLPAPER_THRESHOLD = 3\nTILE_SIZE_2 = 2\nTILE_SIZE_OPTIONS, TILE3_SIGN_OPTIONS = (2, 3), (1, 2)\n# Visibility/oracle retry limits.\nVISIBLE_OUTER_MIN_COMPONENT, MAX_VISIBLE_OUTER_COMPONENTS = 3, 4\nGENERATION_RETRY_LIMIT = 300\n\n\ndef _randint(lo: int, hi: int) -> int:\n    return int(_RNG.integers(int(lo), int(hi) + 1))\n\n\ndef _choice(seq):\n    return seq[_randint(0, len(seq) - 1)]\n\n\ndef _sample(seq, k: int) -> list[int]:\n    idx = _RNG.choice(len(seq), size=int(k), replace=False)\n    return [int(seq[int(i)]) for i in idx]\n\n\ndef _shuffled(seq) -> list[int]:\n    vals = list(seq)\n    _RNG.shuffle(vals)\n    return [int(v) for v in vals]\n\n\ndef _choose_dims(\n    h_min: int,\n    h_max: int,\n    w_min: int,\n    w_max: int,\n    used_areas: set[int],\n    *,\n    min_area: int = 0,\n) -> tuple[int, int] | None:\n    pairs = [\n        (h, w)\n        for h in range(int(h_min), int(h_max) + 1)\n        for w in range(int(w_min), int(w_max) + 1)\n        if h * w > int(min_area) and h * w not in used_areas\n    ]\n    return _choice(pairs) if pairs else None\n\n\ndef _build_items() -> list[dict]:\n    \"\"\"Build a largest-to-smallest rectangle chain with unique bbox areas.\"\"\"\n    n_items = _randint(*ITEM_COUNT_RANGE)\n    if n_items == ITEM_COUNT_RANGE[1]:\n        n_frames = FOUR_ITEM_FRAME_COUNT\n    else:\n        n_frames = _choice(THREE_ITEM_FRAME_OPTIONS)\n    n_solids = n_items - n_frames\n\n    colors = _sample(FOREGROUND_COLORS, n_items)\n    chain = []\n    used_areas: set[int] = set()\n\n    h = _randint(*INNER_SOLID_HEIGHT_RANGE)\n    w = _randint(*INNER_SOLID_WIDTH_RANGE)\n    chain.append({\"kind\": \"solid\", \"height\": h, \"width\": w})\n    used_areas.add(h * w)\n\n    if n_solids == 2:\n        dims = _choose_dims(h, SECOND_SOLID_MAX_HEIGHT, w, SECOND_SOLID_MAX_WIDTH, used_areas, min_area=h * w)\n        if dims is None:\n            return []\n        h, w = dims\n        chain.append({\"kind\": \"solid\", \"height\": h, \"width\": w})\n        used_areas.add(h * w)\n\n    if n_frames == 2:\n        dims = _choose_dims(\n            h + FRAME_MIN_GROWTH,\n            min(INNER_FRAME_MAX_HEIGHT, h + INNER_FRAME_MAX_GROWTH),\n            w + FRAME_MIN_GROWTH,\n            min(INNER_FRAME_MAX_WIDTH, w + INNER_FRAME_MAX_GROWTH),\n            used_areas,\n        )\n        if dims is None:\n            return []\n        h, w = dims\n        chain.append({\"kind\": \"frame\", \"height\": h, \"width\": w})\n        used_areas.add(h * w)\n\n    dims = _choose_dims(\n        max(OUTER_FRAME_MIN_HEIGHT, h + FRAME_MIN_GROWTH),\n        OUTER_FRAME_MAX_HEIGHT,\n        max(OUTER_FRAME_MIN_WIDTH, w + FRAME_MIN_GROWTH),\n        OUTER_FRAME_MAX_WIDTH,\n        used_areas,\n    )\n    if dims is None:\n        return []\n    h, w = dims\n    chain.append({\"kind\": \"frame\", \"height\": h, \"width\": w})\n\n    items = list(reversed(chain))\n    for item, color in zip(items, colors):\n        item[\"color\"] = int(color)\n        item[\"area\"] = int(item[\"height\"] * item[\"width\"])\n    return items\n\n\ndef _item_size(item: dict) -> tuple[int, int]:\n    return int(item[\"height\"]), int(item[\"width\"])\n\n\ndef _paint_item_view(view: np.ndarray, item: dict) -> None:\n    color = int(item[\"color\"])\n    if item[\"kind\"] == \"solid\":\n        view[:, :] = color\n    else:\n        view[0, :] = color\n        view[-1, :] = color\n        view[:, 0] = color\n        view[:, -1] = color\n\n\ndef _gen_paint_item(out: np.ndarray, item: dict, r: int, c: int) -> tuple[int, int, int, int]:\n    h, w = _item_size(item)\n    _paint_item_view(out[r : r + h, c : c + w], item)\n    if item[\"kind\"] == \"solid\":\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/58490d8a.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_coords, components_mask, crop_bbox, get_bg, label_mask, paste, random_free_location\nimport random\nfrom functools import lru_cache\nfrom itertools import combinations\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count colored objects and record tallies inside a legend box.\n\n    Input structure:\n    - A black rectangular legend box with key-color pixels in its leftmost non-black column.\n    - Outside the box, distinct objects of each key color are scattered across the grid.\n\n    Rule:\n    - For each key color, count separate same-colored objects outside the legend box.\n    - Output the legend box repainted: each key row gets one dot per object, spaced every other cell rightward from the key pixel.\n\n    Key insight: The legend is both the color index and the output canvas — object counts become dot sequences on the matching row.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    _bg = int(get_bg(g))\n\n    black = 0\n\n    # STEP 1) Find the legend bbox: largest black CC whose bbox contains some non-black pixels.\n    best = None  # (area, bbox)\n    for coords in components_mask(g == int(black), connectivity=8):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if (sub != int(black)).any():\n            area = int(coords.shape[0])\n            cand = (area, tuple(map(int, b)))\n            if best is None or cand[0] > best[0]:\n                best = cand\n\n    assert not (best is None)\n\n    r0, c0, r1, c1 = map(int, best[1])\n    box = crop_bbox(g, (r0, c0, r1, c1))\n    bh, bw = map(int, box.shape)\n\n    # STEP 2) Inside the legend bbox, find the key column:\n    # leftmost column with any non-black pixels (the \"key pixels\").\n    key_col = None\n    for cc in range(bw):\n        if (box[:, int(cc)] != int(black)).any():\n            key_col = int(cc)\n            break\n    if key_col is None:\n        return np.zeros_like(box)\n\n    keys = [(int(rr), int(box[int(rr), int(key_col)])) for rr in range(bh) if int(box[int(rr), int(key_col)]) != int(black)]\n    keys.sort(key=lambda t: int(t[0]))\n\n    outside = np.ones((H, W), dtype=bool)\n    outside[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = False\n    out = np.zeros((bh, bw), dtype=int)\n\n    # STEP 3/4) Count CCs of each key color outside the legend, then draw 1 dot per CC.\n    for rr, col in keys:\n        mask = (g == int(col)) & outside\n        _labc, nc = label_mask(mask, connectivity=8)\n        for i in range(int(nc)):\n            cc = int(key_col + 2 * i)\n            if 0 <= cc < bw:\n                out[int(rr), int(cc)] = int(col)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette and legend color choices.\nCOLOR_POOL = tuple(range(1, 10))\nBLACK = 0\nDISTRACTOR_PROB = 0.5\n\n# Key rows and tally dimensions.\nKEY_COUNT_RANGE = (2, 4)\nTARGET_COUNT_RANGE = (1, 5)\nKEY_ROW_FIRST = 1\nKEY_ROW_STEP = 2\nKEY_COLUMN = 1\nTALLY_COL_STEP = 2\nLEGEND_HEIGHT_TAIL = 1\nLEGEND_WIDTH_TAIL = 1\nLEGEND_SLACK_RANGE = (0, 3)\n\n# Canvas size and legend placement bounds.\nGRID_HEIGHT_RANGE = (20, 25)\nGRID_WIDTH_RANGE = (20, 25)\nLEGEND_EDGE_MARGIN = 2\n\n# Sprite shape and placement constraints.\nSPRITE_AREA_RANGE = (4, 7)\nSPRITE_BBOXES = ((2, 2), (2, 3), (3, 2), (3, 3))\nSPRITE_CONNECTIVITY = 8\nSPRITE_PADDING = 1\nSPRITE_PADDING_CONNECTIVITY = 8\n\n# Retry budget for rejection sampling.\nGENERATION_ATTEMPTS = 300\n\n\ndef _randint(bounds: tuple[int, int]) -> int:\n    \"\"\"Return an inclusive randint from a configured (low, high) pair.\"\"\"\n    return random.randint(bounds[0], bounds[1])\n\n\n@lru_cache(maxsize=None)\ndef _valid_masks(h: int, w: int, area: int) -> tuple[np.ndarray, ...]:\n    \"\"\"Return connected masks that span all four sides of the sprite bbox.\"\"\"\n    masks = []\n    for cells in combinations(range(h * w), area):\n        mask = np.zeros((h, w), dtype=bool)\n        for cell in cells:\n            mask[cell // w, cell % w] = True\n        spans_edges = mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()\n        if not spans_edges:\n            continue\n        _, n = label_mask(mask, connectivity=SPRITE_CONNECTIVITY)\n        if n == 1:\n            masks.append(mask)\n    return tuple(masks)\n\n\ndef _make_sprite(color: int, bg: int) -> np.ndarray:\n    \"\"\"Sample one connected same-color sprite drawn on the background color.\"\"\"\n    area = _randint(SPRITE_AREA_RANGE)\n    dims = []\n    for h, w in SPRITE_BBOXES:\n        if h * w >= area and _valid_masks(h, w, area):\n            dims.append((h, w))\n    h, w = random.choice(dims)\n    mask = random.choice(_valid_masks(h, w, area))\n    sprite = np.full((h, w), int(bg), dtype=int)\n    sprite[mask] = int(color)\n    return sprite\n\n\ndef _sample_palette() -> tuple[int, list[int], int | None]:\n    \"\"\"Choose background, key colors, and optional distractor color.\"\"\"\n    colors = list(COLOR_POOL)\n    bg = random.choice(colors)\n\n    k = _randint(KEY_COUNT_RANGE)\n    remaining = [c for c in colors if c != bg]\n    key_colors = random.sample(remaining, k)\n    remaining = [c for c in remaining if c not in key_colors]\n    distractor_color = random.choice(remaining) if remaining and random.random() < DISTRACTOR_PROB else None\n    return bg, key_colors, distractor_color\n\n\ndef _sample_counts(k: int) -> list[int]:\n    \"\"\"Sample the target outside-component count for each key color.\"\"\"\n    return [_randint(TARGET_COUNT_RANGE) for _ in range(k)]\n\n\ndef _legend_shape(k: int, max_count: int) -> tuple[int, int]:\n    \"\"\"Return legend height and width for the key count and largest tally.\"\"\"\n    bh = KEY_ROW_STEP * k + LEGEND_HEIGHT_TAIL\n    bw = TALLY_COL_STEP * max_count + LEGEND_WIDTH_TAIL + _randint(LEGEND_SLACK_RANGE)\n    return bh, bw\n\n\ndef _key_row(i: int) -> int:\n    \"\"\"Map a zero-based key index to its row inside the legend/output box.\"\"\"\n    return KEY_ROW_FIRST + KEY_ROW_STEP * i\n\n\ndef _build_expected(key_colors: list[int], counts: list[int]) -> np.ndarray:\n    \"\"\"Render the black output tally canvas implied by key colors and counts.\"\"\"\n    max_count = max(counts)\n    bh, bw = _legend_shape(len(key_colors), max_count)\n\n    expected = np.full((bh, bw), BLACK, dtype=int)\n    for i, (color, count) in enumerate(zip(key_colors, counts)):\n        rr = _key_row(i)\n        for j in range(count):\n            expected[rr, KEY_COLUMN + TALLY_COL_STEP * j] = int(color)\n    return expected\n\n\ndef _build_legend(shape: tuple[int, int], key_colors: list[int]) -> np.ndarray:\n    \"\"\"Return a black legend patch with only the key-column pixels filled.\"\"\"\n    legend = np.full(shape, BLACK, dtype=int)\n    for i, color in enumerate(key_colors):\n        legend[_key_row(i), KEY_COLUMN] = int(color)\n    return legend\n\n\ndef _new_grid_with_legend(bg: int, legend: np.ndarray) -> np.ndarray | None:\n    \"\"\"Sample a grid and paste the legend away from all canvas edges.\"\"\"\n    bh, bw = map(int, legend.shape)\n    H = _randint(GRID_HEIGHT_RANGE)\n    W = _randint(GRID_WIDTH_RANGE)\n    min_h = bh + 2 * LEGEND_EDGE_MARGIN\n    min_w = bw + 2 * LEGEND_EDGE_MARGIN\n    if H < min_h or W < min_w:\n        return None\n\n    grid = np.full((H, W), int(bg), dtype=int)\n    r0 = random.randint(LEGEND_EDGE_MARGIN, H - bh - LEGEND_EDGE_MARGIN)\n    c0 = random.randint(LEGEND_EDGE_MARGIN, W - bw - LEGEND_EDGE_MARGIN)\n    paste(grid, legend, r0, c0)\n    return grid\n\n\ndef _build_sprite_queue(\n    key_colors: list[int],\n    counts: list[int],\n    distractor_color: int | None,\n    bg: int,\n) -> list[np.ndarray]:\n    \"\"\"Create canonical key sprites, optional distractor sprite, and shuffle them.\"\"\"\n    sprites = []\n    for color, count in zip(key_colors, counts):\n        sprite = _make_sprite(color, bg)\n        for _ in range(count):\n            sprites.append(sprite.copy())\n    if distractor_color is not None:\n        sprites.append(_make_sprite(distractor_color, bg))\n    random.shuffle(sprites)\n    return sprites\n\n\ndef _place_sprites(grid: np.ndarray, sprites: list[np.ndarray], bg: int) -> None:\n    \"\"\"Paste sprites into random non-touching free locations in queue order.\"\"\"\n    for sprite in sprites:\n        sr, sc = random_free_location(\n            grid,\n            sprite,\n            transparent=bg,\n            padding=SPRITE_PADDING,\n            padding_connectivity=SPRITE_PADDING_CONNECTIVITY,\n        )\n        paste(grid, sprite, sr, sc, transparent=bg)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Run one output-first generation attempt and reject solver mismatches.\"\"\"\n    bg, key_colors, distractor_color = _sample_palette()\n    counts = _sample_counts(len(key_colors))\n    expected = _build_expected(key_colors, counts)\n    legend = _build_legend(expected.shape, key_colors)\n    grid = _new_grid_with_legend(bg, legend)\n    if grid is None:\n        return None\n\n    sprites = _build_sprite_queue(key_colors, counts, distractor_color, bg)\n    try:\n        _place_sprites(grid, sprites, bg)\n    except ValueError:\n        return None\n\n    if not np.array_equal(main(grid), expected):\n","exit_code":0,"status":"completed"}}
