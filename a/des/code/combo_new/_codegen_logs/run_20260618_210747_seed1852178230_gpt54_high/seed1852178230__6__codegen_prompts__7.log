{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/9f5f939b.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, colors_present, find_components, get_bg\n\n\nARM_OFFSETS = (\n    (0, -3),\n    (0, -2),\n    (0, 2),\n    (0, 3),\n    (-3, 0),\n    (-2, 0),\n    (2, 0),\n    (3, 0),\n)\nGAP_OFFSETS = ((0, -1), (0, 1), (-1, 0), (1, 0))\n\n\ndef _assert_two_cell_bars(g: np.ndarray, bg: int, fg: int) -> None:\n    components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n    assert components, \"expected foreground bars\"\n    for component in components:\n        coords = np.asarray(component[\"coords\"], dtype=int)\n        assert coords.shape == (2, 2), \"each foreground object must be a two-pixel bar\"\n        r0, c0 = map(int, coords[0])\n        r1, c1 = map(int, coords[1])\n        is_bar = (r0 == r1 and abs(c0 - c1) == 1) or (c0 == c1 and abs(r0 - r1) == 1)\n        assert is_bar, \"foreground objects must be horizontal or vertical adjacent pairs\"\n\n\ndef _is_cross_center(g: np.ndarray, r: int, c: int, bg: int, fg: int) -> bool:\n    if int(g[r, c]) != bg:\n        return False\n    return all(int(g[r + dr, c + dc]) == fg for dr, dc in ARM_OFFSETS) and all(\n        int(g[r + dr, c + dc]) == bg for dr, dc in GAP_OFFSETS\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Mark the missing center of each plus-shaped arrangement of four two-pixel bars with yellow.\n\n    Input structure:\n    - The background is the dominant color.\n    - The single foreground color forms isolated 4-connected objects, each a horizontal or vertical two-pixel bar.\n    - Some bars form an implied plus sign: two horizontal bars and two vertical bars around an empty center, with a one-pixel gap between the center and each bar.\n\n    Rule:\n    - Keep the input unchanged except at implied plus-sign centers.\n    - For every background pixel with foreground bars at offsets 2-3 cells left, right, above, and below, recolor that center yellow.\n    - The one-pixel gaps immediately next to the center in the four cardinal directions must remain background.\n\n    Key insight:\n    - The yellow pixels are not extending a line; they identify the shared missing center where four separated two-pixel bars align as a plus sign.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = g.shape\n    assert height >= 7 and width >= 7, \"grid must be large enough for the plus motif\"\n\n    bg = get_bg(g)\n    foreground = colors_present(g, exclude={bg})\n    assert len(foreground) == 1, \"expected exactly one foreground color\"\n    fg = int(foreground[0])\n    assert bg != Color.YELLOW and fg != Color.YELLOW, \"yellow is reserved for output markers\"\n    _assert_two_cell_bars(g, bg, fg)\n\n    centers = [\n        (r, c)\n        for r in range(3, height - 3)\n        for c in range(3, width - 3)\n        if _is_cross_center(g, r, c, bg, fg)\n    ]\n    assert centers, \"expected at least one missing plus center\"\n\n    out = g.copy()\n    for r, c in centers:\n        out[r, c] = Color.YELLOW\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and color bounds.\nGRID_SIZE_MIN = 8\nGRID_SIZE_MAX_EXCLUSIVE = 21\nBACKGROUND_COLOR = 8\nFOREGROUND_COLOR = 1\n\n# Plus motif placement.\nPLUS_COUNT_MIN = 1\nPLUS_COUNT_MAX_EXCLUSIVE = 5\nCENTER_MARGIN = 3\nCENTER_TRIES = 100\n\n# Distractor bar placement.\nDISTRACTOR_RATIO_MIN = 0.2\nDISTRACTOR_RATIO_MAX = 0.6\nDISTRACTOR_RETRY_MULTIPLIER = 20\nNEW_PLUS_SCAN_RADIUS = 3\n\n# Overall generation retries.\nGENERATION_ATTEMPTS = 300\nNEIGHBOR_OFFSETS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _offset_cells(r: int, c: int, offsets: tuple[tuple[int, int], ...]) -> list[tuple[int, int]]:\n    return [(r + dr, c + dc) for dr, dc in offsets]\n\n\ndef _all_cells_bg(grid: np.ndarray, cells: list[tuple[int, int]], bg: int) -> bool:\n    height, width = grid.shape\n    for r, c in cells:\n        if r < 0 or r >= height or c < 0 or c >= width:\n            return False\n        if grid[r, c] != bg:\n            return False\n    return True\n\n\ndef _cells_are_isolated(grid: np.ndarray, cells: list[tuple[int, int]], bg: int) -> bool:\n    \"\"\"Check that cells have no 4-neighbor foreground outside their own component.\"\"\"\n    height, width = grid.shape\n    cell_set = set(cells)\n    for r, c in cells:\n        for dr, dc in NEIGHBOR_OFFSETS:\n            nr, nc = r + dr, c + dc\n            if (nr, nc) in cell_set:\n                continue\n            if 0 <= nr < height and 0 <= nc < width and grid[nr, nc] != bg:\n                return False\n    return True\n\n\ndef _place_plus_centers(grid: np.ndarray, rng: np.random.Generator, count: int, bg: int, fg: int) -> list[tuple[int, int]]:\n    \"\"\"Place up to count complete plus motifs and return their hidden centers.\"\"\"\n    height, width = grid.shape\n    centers = []\n    for _ in range(count):\n        found = False\n        for _try in range(CENTER_TRIES):\n            r = int(rng.integers(CENTER_MARGIN, height - CENTER_MARGIN))\n            c = int(rng.integers(CENTER_MARGIN, width - CENTER_MARGIN))\n            arm_cells = _offset_cells(r, c, ARM_OFFSETS)\n            gap_cells = _offset_cells(r, c, GAP_OFFSETS)\n            all_cells = arm_cells + gap_cells + [(r, c)]\n\n            if not _all_cells_bg(grid, all_cells, bg):\n                continue\n            if not _cells_are_isolated(grid, arm_cells, bg):\n                continue\n\n            for ar, ac in arm_cells:\n                grid[ar, ac] = fg\n            centers.append((r, c))\n            found = True\n            break\n\n        if not found:\n            break\n    return centers\n\n\ndef _target_distractor_count(rng: np.random.Generator, plus_count: int) -> int:\n    arm_bars = plus_count * 4\n    ratio = rng.uniform(DISTRACTOR_RATIO_MIN, DISTRACTOR_RATIO_MAX)\n    return max(1, int(round(arm_bars * ratio / (1 - ratio))))\n\n\ndef _candidate_centers_near_bar(bar_cells: list[tuple[int, int]], height: int, width: int) -> set[tuple[int, int]]:\n    check_cells = set()\n    for br, bc in bar_cells:\n        for dr in range(-NEW_PLUS_SCAN_RADIUS, NEW_PLUS_SCAN_RADIUS + 1):\n            for dc in range(-NEW_PLUS_SCAN_RADIUS, NEW_PLUS_SCAN_RADIUS + 1):\n                cr, cc = br + dr, bc + dc\n                if CENTER_MARGIN <= cr < height - CENTER_MARGIN and CENTER_MARGIN <= cc < width - CENTER_MARGIN:\n                    check_cells.add((cr, cc))\n    return check_cells\n\n\ndef _would_create_extra_plus(\n    grid: np.ndarray, bar_cells: list[tuple[int, int]], centers: list[tuple[int, int]], bg: int, fg: int\n) -> bool:\n    height, width = grid.shape\n    for cr, cc in _candidate_centers_near_bar(bar_cells, height, width):\n        if (cr, cc) in centers:\n            continue\n        if grid[cr, cc] != bg:\n            continue\n        arms_ok = all(0 <= cr + dr < height and 0 <= cc + dc < width and grid[cr + dr, cc + dc] == fg\n                      for dr, dc in ARM_OFFSETS)\n        gaps_ok = all(0 <= cr + dr < height and 0 <= cc + dc < width and grid[cr + dr, cc + dc] == bg\n                      for dr, dc in GAP_OFFSETS)\n        if arms_ok and gaps_ok:\n            return True\n    return False\n\n\ndef _place_distractors(\n    grid: np.ndarray, rng: np.random.Generator, target_count: int, centers: list[tuple[int, int]], bg: int, fg: int\n) -> int:\n    height, width = grid.shape\n    placed = 0\n    for _ in range(target_count * DISTRACTOR_RETRY_MULTIPLIER):\n        if placed >= target_count:\n            break\n\n        orientation = rng.integers(0, 2)\n        r0 = int(rng.integers(0, height))\n        c0 = int(rng.integers(0, width))\n        if orientation == 0:\n            r1, c1 = r0, c0 + 1\n        else:\n            r1, c1 = r0 + 1, c0\n\n        if r1 >= height or c1 >= width:\n            continue\n        if grid[r0, c0] != bg or grid[r1, c1] != bg:\n            continue\n\n        bar_cells = [(r0, c0), (r1, c1)]\n        if not _cells_are_isolated(grid, bar_cells, bg):\n            continue\n\n        for r, c in bar_cells:\n            grid[r, c] = fg\n\n        if _would_create_extra_plus(grid, bar_cells, centers, bg, fg):\n            for r, c in bar_cells:\n                grid[r, c] = bg\n            continue\n\n        placed += 1\n    return placed\n\n\ndef _passes_solver_oracle(grid: np.ndarray, centers: list[tuple[int, int]]) -> bool:\n    try:\n        out = main(grid.copy())\n    except (AssertionError, Exception):\n        return False\n\n    expected = grid.copy()\n    for r, c in centers:\n        expected[r, c] = 4\n    return np.array_equal(out, expected)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    height = rng.integers(GRID_SIZE_MIN, GRID_SIZE_MAX_EXCLUSIVE)\n    width = rng.integers(GRID_SIZE_MIN, GRID_SIZE_MAX_EXCLUSIVE)\n    bg = BACKGROUND_COLOR\n    fg = FOREGROUND_COLOR\n\n    grid = np.full((height, width), bg, dtype=int)\n\n    plus_count = rng.integers(PLUS_COUNT_MIN, PLUS_COUNT_MAX_EXCLUSIVE)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/14b8e18c.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_h, bbox_w, find_components, get_bg, in_bounds\nimport random\n\n\ndef _has_complete_square_border(g: np.ndarray, obj: dict) -> bool:\n    r0, c0, r1, c1 = obj[\"bbox\"]\n    h = bbox_h(obj[\"bbox\"])\n    w = bbox_w(obj[\"bbox\"])\n    if h != w or h < 2:\n        return False\n\n    color = int(obj[\"color\"])\n    return bool(\n        np.all(g[r0, c0 : c1 + 1] == color)\n        and np.all(g[r1, c0 : c1 + 1] == color)\n        and np.all(g[r0 : r1 + 1, c0] == color)\n        and np.all(g[r0 : r1 + 1, c1] == color)\n    )\n\n\ndef _corner_marker_coords(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:\n    r0, c0, r1, c1 = bbox\n    return [\n        (r0 - 1, c0),\n        (r0, c0 - 1),\n        (r0 - 1, c1),\n        (r0, c1 + 1),\n        (r1 + 1, c0),\n        (r1, c0 - 1),\n        (r1 + 1, c1),\n        (r1, c1 + 1),\n    ]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Mark every complete square object with red pixels just outside its corners.\n\n    Input structure:\n    - A uniform background contains one or more monochrome 4-connected foreground objects.\n    - The relevant objects are square frames or filled squares: their bbox is square\n      and all cells on the bbox border have the object's color.\n    - Non-square bars and incomplete fragments may also appear and are ignored.\n\n    Rule:\n    - Keep the input unchanged.\n    - For each complete square object, paint red on the two outside background\n      pixels orthogonally adjacent to each of the square's four corners.\n\n    Key insight: The transformation is not based on size or color; it selects\n    objects whose bounding box is a complete square border and labels only their\n    exposed outer corner-adjacent cells.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    out = g.copy()\n\n    square_objects = [\n        obj\n        for obj in find_components(g, bg=bg, connectivity=4, monochromatic=True)\n        if _has_complete_square_border(g, obj)\n    ]\n    assert square_objects, \"expected at least one complete square object\"\n\n    for obj in square_objects:\n        coords = _corner_marker_coords(obj[\"bbox\"])\n        for r, c in coords:\n            assert in_bounds(g.shape, r, c), \"square object should have one-cell outside margin\"\n            assert int(g[r, c]) == int(bg), \"corner marker positions should be background\"\n            out[r, c] = Color.RED\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# ---- Configuration ----\nGRID_H, GRID_W = 10, 10\nBG_COLOR = Color.ORANGE                       # background color (7)\nFG_COLORS = [Color.PINK, Color.TEAL]          # foreground color choices\nSQUARE_COUNT_RANGE = [1, 2, 3, 4]             # number of squares to attempt\nSQUARE_SIZE_MIN = 2                            # minimum square side length\nMAX_SZ_BY_COUNT = {1: 8, 2: 6, 3: 5, 4: 4}   # max square size per count\nEDGE_MARGIN = 1                                # min gap from grid edge for squares\nDISTRACTOR_COUNT_MAX = 5                       # max distractor objects\nDISTRACTOR_TYPES = ['pixel', 'hbar', 'vbar', 'rect']\nDISTRACTOR_BAR_RANGE = (2, 4)                  # bar/rect dimension range\nDISTRACTOR_PLACE_RETRIES = 80                  # retries per distractor placement\nGEN_MAX_RETRIES = 300                          # outer generate_input retry limit\n\n\ndef _marker_coords(r0, c0, sz):\n    \"\"\"Return the 8 corner-adjacent cells outside a square at (r0,c0) with side `sz`.\"\"\"\n    r1, c1 = r0 + sz - 1, c0 + sz - 1\n    return [\n        (r0 - 1, c0), (r0, c0 - 1),\n        (r0 - 1, c1), (r0, c1 + 1),\n        (r1 + 1, c0), (r1, c0 - 1),\n        (r1 + 1, c1), (r1, c1 + 1),\n    ]\n\n\ndef _border_mask(r0, c0, sz, shape):\n    \"\"\"Return a boolean mask with True on the border cells of a square.\"\"\"\n    mask = np.zeros(shape, dtype=bool)\n    r1, c1 = r0 + sz - 1, c0 + sz - 1\n    mask[r0, c0:c1+1] = True\n    mask[r1, c0:c1+1] = True\n    mask[r0:r1+1, c0] = True\n    mask[r0:r1+1, c1] = True\n    return mask\n\n\ndef _draw_square(grid, occupied, marker_reserved, r0, c0, sz, fg):\n    \"\"\"Draw a square frame (or filled 2x2) onto the grid and update tracking masks.\"\"\"\n    r1, c1 = r0 + sz - 1, c0 + sz - 1\n    if sz == 2:\n        grid[r0:r1+1, c0:c1+1] = fg\n    else:\n        grid[r0, c0:c1+1] = fg\n        grid[r1, c0:c1+1] = fg\n        grid[r0:r1+1, c0] = fg\n        grid[r0:r1+1, c1] = fg\n    occupied |= _border_mask(r0, c0, sz, grid.shape)\n    for mr, mc in _marker_coords(r0, c0, sz):\n        marker_reserved[mr, mc] = True\n\n\ndef _distractor_dims(dtype):\n    \"\"\"Return (height, width) for a distractor of the given type.\"\"\"\n    lo, hi = DISTRACTOR_BAR_RANGE\n    if dtype == 'pixel':\n        return 1, 1\n    elif dtype == 'hbar':\n        return 1, random.randint(lo, hi)\n    elif dtype == 'vbar':\n        return random.randint(lo, hi), 1\n    else:\n        dh = random.randint(lo, hi)\n        dw = random.randint(lo, hi)\n        if dh == dw:\n            dw = dh + 1 if dh < hi else dh - 1\n        return dh, dw\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    fg = random.choice(FG_COLORS)\n    grid = np.full((GRID_H, GRID_W), BG_COLOR, dtype=int)\n    occupied = np.zeros((GRID_H, GRID_W), dtype=bool)\n    marker_reserved = np.zeros((GRID_H, GRID_W), dtype=bool)\n\n    num_squares = random.choice(SQUARE_COUNT_RANGE)\n    max_sz = MAX_SZ_BY_COUNT[num_squares]\n    sizes = sorted([random.randint(SQUARE_SIZE_MIN, max_sz)\n                     for _ in range(num_squares)], reverse=True)\n\n    placed_squares = []\n\n    def can_place(r0, c0, sz):\n        r1, c1 = r0 + sz - 1, c0 + sz - 1\n        if r0 < EDGE_MARGIN or c0 < EDGE_MARGIN or r1 > GRID_H - EDGE_MARGIN - 1 or c1 > GRID_W - EDGE_MARGIN - 1:\n            return False\n        for mr, mc in _marker_coords(r0, c0, sz):\n            if mr < 0 or mr >= GRID_H or mc < 0 or mc >= GRID_W:\n                return False\n            if occupied[mr, mc] or marker_reserved[mr, mc]:\n                return False\n        # Border cells must not overlap existing occupied cells\n        if (np.any(occupied[r0, c0:c1+1]) or np.any(occupied[r1, c0:c1+1]) or\n                np.any(occupied[r0:r1+1, c0]) or np.any(occupied[r0:r1+1, c1])):\n            return False\n        return True\n\n    for sz in sizes:\n        positions = [(r0, c0)\n                     for r0 in range(EDGE_MARGIN, GRID_H - sz)\n                     for c0 in range(EDGE_MARGIN, GRID_W - sz)\n                     if can_place(r0, c0, sz)]\n        if not positions:\n            continue\n        r0, c0 = random.choice(positions)\n        _draw_square(grid, occupied, marker_reserved, r0, c0, sz, fg)\n        placed_squares.append((r0, c0, sz))\n\n    if not placed_squares:\n        return None\n\n    # Place distractors\n    num_distractors = random.randint(0, DISTRACTOR_COUNT_MAX)\n    for _ in range(num_distractors):\n        dtype = random.choice(DISTRACTOR_TYPES)\n        for _try in range(DISTRACTOR_PLACE_RETRIES):\n            dh, dw = _distractor_dims(dtype)\n            r0 = random.randint(0, GRID_H - dh)\n            c0 = random.randint(0, GRID_W - dw)\n            region = grid[r0:r0+dh, c0:c0+dw]\n            reserved = marker_reserved[r0:r0+dh, c0:c0+dw]\n            if np.all(region == BG_COLOR) and not np.any(reserved):\n                grid[r0:r0+dh, c0:c0+dw] = fg\n                occupied[r0:r0+dh, c0:c0+dw] = True\n                break\n\n    # Validate with solver\n    try:\n        out = main(grid)\n    except Exception:\n        return None\n\n    expected = grid.copy()\n    for r0, c0, sz in placed_squares:\n        for mr, mc in _marker_coords(r0, c0, sz):\n            expected[mr, mc] = Color.RED\n    if not np.array_equal(out, expected):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_MAX_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate input after %d attempts\" % GEN_MAX_RETRIES)\n","exit_code":0,"status":"completed"}}
