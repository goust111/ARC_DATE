{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nfrom collections import Counter\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed1852178230/3/2.py')\nmod = SourceFileLoader('new_arc_task_stats', str(p)).load_module()\nparity = Counter()\nseed_counts = Counter()\nrect_counts = Counter()\nfor _ in range(200):\n    g = mod.generate_input()\n    frame_color = mod._find_frame_color(g)\n    frames = mod._components(g == frame_color)\n    rect_counts[len(frames)] += 1\n    for comp in frames:\n        r0, c0, r1, c1 = mod._bbox(comp)\n        ih = r1 - r0 - 1\n        iw = c1 - c0 - 1\n        parity[(ih % 2, iw % 2)] += 1\n        interior = g[r0 + 1:r1, c0 + 1:c1]\n        row_mid = (ih + 1) // 2\n        col_mid = (iw + 1) // 2\n        quads = set()\n        for rr, cc in zip(*((interior \"'!= 0) & (interior != frame_color)).nonzero()):\n            quads.add(mod._quadrant_of(int(rr), int(cc), row_mid, col_mid))\n        seed_counts[len(quads)] += 1\nprint('\"'parity', parity)\nprint('seed_counts', seed_counts)\nprint('rect_counts', rect_counts)\nPY\nfind /home/lixinyu/snap/a/des/code/combo_new/seed1852178230/3 -type d -name '__pycache__' -prune -exec rm -rf {} +\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
