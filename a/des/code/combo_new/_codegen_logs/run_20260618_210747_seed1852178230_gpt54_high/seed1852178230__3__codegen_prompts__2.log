{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/a/des/code/combo_new/seed1852178230/3/2.py | sed -n '1,260p'\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\t\n     3\timport random\n     4\tfrom collections import deque\n     5\t\n     6\timport numpy as np\n     7\t\n     8\t\n     9\tBG = 0\n    10\tGEN_FRAME_COLOR = 5\n    11\tSEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)\n    12\tQUADRANTS = (\"tl\", \"tr\", \"bl\", \"br\")\n    13\tMAX_GENERATION_ATTEMPTS = 300\n    14\tPLACEMENT_ATTEMPTS = 80\n    15\t\n    16\t\n    17\tdef main(grid: np.ndarray) -> np.ndarray:\n    18\t    \"\"\"\n    19\t    Fill each seeded quadrant of a gray rectangular room with the seed's color.\n    20\t\n    21\t    Input structure:\n    22\t    - The background is black.\n    23\t    - One-pixel-thick gray rectangular frames form several disjoint closed rooms.\n    24\t    - Inside each room there are one or more colored seed pixels, and seeds in the\n    25\t      same room occupy distinct quadrants of the room interior.\n    26\t\n    27\t    Rule:\n    28\t    - For every gray rectangle, split its interior into four quadrants.\n    29\t    - When the interior width or height is odd, the middle column belongs to the\n    30\t      left quadrants and the middle row belongs to the top quadrants.\n    31\t    - For each quadrant containing at least one seed, recolor all black pixels in\n    32\t      that quadrant to the seed color.\n    33\t    - Leave the gray borders, the seed pixels themselves, and every unseeded\n    34\t      quadrant unchanged.\n    35\t\n    36\t    Key insight:\n    37\t    - A seed does not spread from its exact position; it only labels one whole\n    38\t      quadrant of its enclosing rectangle, and that quadrant is what gets filled.\n    39\t    \"\"\"\n    40\t    g = np.asarray(grid, dtype=int)\n    41\t    assert g.ndim == 2, \"expected a 2D grid\"\n    42\t\n    43\t    frame_color = _find_frame_color(g)\n    44\t    frames = _components(g == frame_color)\n    45\t    assert frames, \"expected at least one rectangular frame\"\n    46\t\n    47\t    out = g.copy()\n    48\t    for comp in frames:\n    49\t        r0, c0, r1, c1 = _bbox(comp)\n    50\t        _assert_rect_frame(g, frame_color, r0, c0, r1, c1, comp)\n    51\t\n    52\t        interior = g[r0 + 1 : r1, c0 + 1 : c1]\n    53\t        inner_h, inner_w = interior.shape\n    54\t        row_mid = (inner_h + 1) // 2\n    55\t        col_mid = (inner_w + 1) // 2\n    56\t\n    57\t        quadrant_colors: dict[str, int] = {}\n    58\t        for rr, cc in np.argwhere((interior != BG) & (interior != frame_color)):\n    59\t            quad = _quadrant_of(int(rr), int(cc), row_mid, col_mid)\n    60\t            color = int(interior[int(rr), int(cc)])\n    61\t            prev = quadrant_colors.get(quad)\n    62\t            assert prev is None or prev == color, \"conflicting seed colors in one quadrant\"\n    63\t            quadrant_colors[quad] = color\n    64\t\n    65\t        assert quadrant_colors, \"each frame interior must contain at least one seed\"\n    66\t\n    67\t        for quad, color in quadrant_colors.items():\n    68\t            rs, cs = _quadrant_slice(quad, row_mid, col_mid, inner_h, inner_w)\n    69\t            patch = out[\n    70\t                slice(r0 + 1 + rs.start, r0 + 1 + rs.stop),\n    71\t                slice(c0 + 1 + cs.start, c0 + 1 + cs.stop),\n    72\t            ]\n    73\t            mask = patch == BG\n    74\t            patch[mask] = color\n    75\t\n    76\t    return out\n    77\t\n    78\t\n    79\tdef _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:\n    80\t    h, w = mask.shape\n    81\t    seen = np.zeros((h, w), dtype=bool)\n    82\t    comps: list[list[tuple[int, int]]] = []\n    83\t    for r in range(h):\n    84\t        for c in range(w):\n    85\t            if not mask[r, c] or seen[r, c]:\n    86\t                continue\n    87\t            q = deque([(r, c)])\n    88\t            seen[r, c] = True\n    89\t            comp: list[tuple[int, int]] = []\n    90\t            while q:\n    91\t                rr, cc = q.popleft()\n    92\t                comp.append((rr, cc))\n    93\t                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n    94\t                    nr, nc = rr + dr, cc + dc\n    95\t                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n    96\t                        seen[nr, nc] = True\n    97\t                        q.append((nr, nc))\n    98\t            comps.append(comp)\n    99\t    return comps\n   100\t\n   101\t\n   102\tdef _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:\n   103\t    rows = [r for r, _ in coords]\n   104\t    cols = [c for _, c in coords]\n   105\t    return min(rows), min(cols), max(rows), max(cols)\n   106\t\n   107\t\n   108\tdef _assert_rect_frame(\n   109\t    grid: np.ndarray,\n   110\t    frame_color: int,\n   111\t    r0: int,\n   112\t    c0: int,\n   113\t    r1: int,\n   114\t    c1: int,\n   115\t    comp: list[tuple[int, int]],\n   116\t) -> None:\n   117\t    h = r1 - r0 + 1\n   118\t    w = c1 - c0 + 1\n   119\t    assert h >= 4 and w >= 4, \"frames must enclose a non-empty 2x2+ interior\"\n   120\t\n   121\t    expected = set()\n   122\t    for r in range(r0, r1 + 1):\n   123\t        expected.add((r, c0))\n   124\t        expected.add((r, c1))\n   125\t    for c in range(c0, c1 + 1):\n   126\t        expected.add((r0, c))\n   127\t        expected.add((r1, c))\n   128\t\n   129\t    comp_set = set(comp)\n   130\t    assert comp_set == expected, \"frame color components must be rectangular borders\"\n   131\t    assert np.all(grid[r0, c0 : c1 + 1] == frame_color)\n   132\t    assert np.all(grid[r1, c0 : c1 + 1] == frame_color)\n   133\t    assert np.all(grid[r0 : r1 + 1, c0] == frame_color)\n   134\t    assert np.all(grid[r0 : r1 + 1, c1] == frame_color)\n   135\t\n   136\t\n   137\tdef _find_frame_color(grid: np.ndarray) -> int:\n   138\t    candidates: list[tuple[int, int]] = []\n   139\t    for color in map(int, np.unique(grid)):\n   140\t        if color == BG:\n   141\t            continue\n   142\t        comps = _components(grid == color)\n   143\t        if not comps:\n   144\t            continue\n   145\t        total = 0\n   146\t        ok = True\n   147\t        for comp in comps:\n   148\t            r0, c0, r1, c1 = _bbox(comp)\n   149\t            h = r1 - r0 + 1\n   150\t            w = c1 - c0 + 1\n   151\t            if h < 4 or w < 4:\n   152\t                ok = False\n   153\t                break\n   154\t            expected_area = 2 * (h + w) - 4\n   155\t            if len(comp) != expected_area:\n   156\t                ok = False\n   157\t                break\n   158\t            comp_set = set(comp)\n   159\t            for r in range(r0, r1 + 1):\n   160\t                if (r, c0) not in comp_set or (r, c1) not in comp_set:\n   161\t                    ok = False\n   162\t                    break\n   163\t            if not ok:\n   164\t                break\n   165\t            for c in range(c0, c1 + 1):\n   166\t                if (r0, c) not in comp_set or (r1, c) not in comp_set:\n   167\t                    ok = False\n   168\t                    break\n   169\t            if not ok:\n   170\t                break\n   171\t            total += len(comp)\n   172\t        if ok:\n   173\t            candidates.append((total, color))\n   174\t\n   175\t    assert candidates, \"could not identify the frame color\"\n   176\t    return max(candidates)[1]\n   177\t\n   178\t\n   179\tdef _quadrant_of(rr: int, cc: int, row_mid: int, col_mid: int) -> str:\n   180\t    top = rr < row_mid\n   181\t    left = cc < col_mid\n   182\t    if top and left:\n   183\t        return \"tl\"\n   184\t    if top and not left:\n   185\t        return \"tr\"\n   186\t    if not top and left:\n   187\t        return \"bl\"\n   188\t    return \"br\"\n   189\t\n   190\t\n   191\tdef _quadrant_slice(\n   192\t    quad: str,\n   193\t    row_mid: int,\n   194\t    col_mid: int,\n   195\t    inner_h: int,\n   196\t    inner_w: int,\n   197\t) -> tuple[slice, slice]:\n   198\t    if quad == \"tl\":\n   199\t        return slice(0, row_mid), slice(0, col_mid)\n   200\t    if quad == \"tr\":\n   201\t        return slice(0, row_mid), slice(col_mid, inner_w)\n   202\t    if quad == \"bl\":\n   203\t        return slice(row_mid, inner_h), slice(0, col_mid)\n   204\t    if quad == \"br\":\n   205\t        return slice(row_mid, inner_h), slice(col_mid, inner_w)\n   206\t    raise ValueError(f\"unknown quadrant {quad}\")\n   207\t\n   208\t\n   209\tdef _sample_dimension(rng: random.Random, limit: int) -> int:\n   210\t    parity = rng.choice((0, 1))\n   211\t    options = [v for v in range(2, limit + 1) if v % 2 == parity]\n   212\t    if not options:\n   213\t        options = list(range(2, limit + 1))\n   214\t    return rng.choice(options)\n   215\t\n   216\t\n   217\tdef _can_place(used: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int = 1) -> bool:\n   218\t    h, w = used.shape\n   219\t    rr0 = max(0, r0 - pad)\n   220\t    cc0 = max(0, c0 - pad)\n   221\t    rr1 = min(h - 1, r1 + pad)\n   222\t    cc1 = min(w - 1, c1 + pad)\n   223\t    return not bool(used[rr0 : rr1 + 1, cc0 : cc1 + 1].any())\n   224\t\n   225\t\n   226\tdef _mark_used(used: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int = 1) -> None:\n   227\t    h, w = used.shape\n   228\t    rr0 = max(0, r0 - pad)\n   229\t    cc0 = max(0, c0 - pad)\n   230\t    rr1 = min(h - 1, r1 + pad)\n   231\t    cc1 = min(w - 1, c1 + pad)\n   232\t    used[rr0 : rr1 + 1, cc0 : cc1 + 1] = True\n   233\t\n   234\t\n   235\tdef _paint_frame(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int) -> None:\n   236\t    grid[r0, c0 : c1 + 1] = color\n   237\t    grid[r1, c0 : c1 + 1] = color\n   238\t    grid[r0 : r1 + 1, c0] = color\n   239\t    grid[r0 : r1 + 1, c1] = color\n   240\t\n   241\t\n   242\tdef _quadrant_bounds(inner_h: int, inner_w: int, quad: str) -> tuple[int, int, int, int]:\n   243\t    row_mid = (inner_h + 1) // 2\n   244\t    col_mid = (inner_w + 1) // 2\n   245\t    rs, cs = _quadrant_slice(quad, row_mid, col_mid, inner_h, inner_w)\n   246\t    return rs.start, rs.stop, cs.start, cs.stop\n   247\t\n   248\t\n   249\tdef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n   250\t    height = rng.randint(12, 30)\n   251\t    width = rng.randint(12, 30)\n   252\t    grid = np.zeros((height, width), dtype=int)\n   253\t    used = np.zeros((height, width), dtype=bool)\n   254\t\n   255\t    max_rectangles = min(5, max(2, (height * width) // 110 + 1))\n   256\t    target_rectangles = rng.randint(2, max_rectangles)\n   257\t\n   258\t    placed = 0\n   259\t    inner_dim_cap = min(10, height - 3, width - 3)\n   260\t    if inner_dim_cap < 2:\n","exit_code":0,"status":"completed"}}
