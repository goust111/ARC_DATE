{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/34cfa167.py',\n'/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n'/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py',\n'/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py',\n'/home/lixinyu/snap/new/ARC_code/train/985ae207.py',\n'/home/lixinyu/snap/new/ARC_code/train/bd5af378.py',\n'/home/lixinyu/snap/new/ARC_code/train/a834deea.py',\n'/home/lixinyu/snap/new/ARC_code/train/db118e2a.py',\n]\nfor path in files:\n    print(f'FILE: {path}')\n    text = Path(path).read_text()\n    lines = text.splitlines()\n    starts = []\n    for i,l in enumerate(lines):\n        if l.startswith('def main(') or l.startswith('def generate_input('):\n            starts.append(i)\n    starts.append(len(lines))\n    for idx in range(len(starts)-1):\n        s = starts[idx]\n        e = starts[idx+1]\n        head = lines[s]\n        print(head)\n        for line in lines[s+1:min(e, s+80)]:\n            print(line)\n        print('---END---')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/34cfa167.py',\n'/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n'/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py',\n'/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py',\n'/home/lixinyu/snap/new/ARC_code/train/985ae207.py',\n'/home/lixinyu/snap/new/ARC_code/train/bd5af378.py',\n'/home/lixinyu/snap/new/ARC_code/train/a834deea.py',\n'/home/lixinyu/snap/new/ARC_code/train/db118e2a.py',\n]\nfor path in files:\n    print(f'FILE: {path}')\n    text = Path(path).read_text()\n    lines = text.splitlines()\n    starts = []\n    for i,l in enumerate(lines):\n        if l.startswith('def main(') or l.startswith('def generate_input('):\n            starts.append(i)\n    starts.append(len(lines))\n    for idx in range(len(starts)-1):\n        s = starts[idx]\n        e = starts[idx+1]\n        head = lines[s]\n        print(head)\n        for line in lines[s+1:min(e, s+80)]:\n            print(line)\n        print('---END---')\nPY\"","aggregated_output":"FILE: /home/lixinyu/snap/new/ARC_code/train/34cfa167.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.\n\n    Input structure:\n    - The background is the dominant color.\n    - Two same-color solid rectangular anchors of the same size sit on opposite\n      diagonal corners, with the first anchor above-left of the second.\n    - The upper-left anchor has two one-cell-thick vertical control bars to its\n      right and two one-cell-thick horizontal control bars below it.\n\n    Rule:\n    - Copy the anchor rectangle into the two missing corners of the implied\n      larger rectangle.\n    - Repeat the right-side control bars horizontally between the left and right\n      anchors, using their spacing as the period, and draw the outer top and\n      bottom borders in the first right-control color.\n    - Repeat the below-side control bars vertically between the top and bottom\n      anchors, using the same period, and draw the outer left and right borders\n      in the first below-control color.\n\n    Key insight: The small control bars are the first two ticks of two periodic\n    frame patterns; the diagonal anchor supplies the opposite corner and the\n    missing two anchor copies.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    source, dest, right_controls, below_controls = _find_structure(g, bg)\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    dr0, dc0, dr1, dc1 = dest[\"bbox\"]\n    anchor_color = int(source[\"color\"])\n    assert int(dest[\"color\"]) == anchor_color, \"anchor colors must match\"\n    assert bbox_h(source[\"bbox\"]) == bbox_h(dest[\"bbox\"]), \"anchor heights must match\"\n    assert bbox_w(source[\"bbox\"]) == bbox_w(dest[\"bbox\"]), \"anchor widths must match\"\n    assert sr0 > 0 and sc0 > 0, \"upper-left anchor must have space for outer frame\"\n    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \"lower-right anchor must have space for outer frame\"\n\n    right_offsets = [int(comp[\"bbox\"][1] - sc1) for comp in right_controls]\n    below_offsets = [int(comp[\"bbox\"][0] - sr1) for comp in below_controls]\n    assert right_offsets == below_offsets and right_offsets[0] == 1, \"control offsets must match from the anchor edge\"\n    step = int(right_offsets[1] - right_offsets[0])\n    assert step > 0, \"control bars must be separated\"\n    period = 2 * step\n    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, \"right frame must close next to the destination anchor\"\n    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, \"below frame must close next to the destination anchor\"\n\n    right_colors = [int(comp[\"color\"]) for comp in right_controls]\n    below_colors = [int(comp[\"color\"]) for comp in below_controls]\n    out = g.copy()\n\n    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)\n    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)\n\n    first_c = int(sc1 + right_offsets[0])\n    last_c = int(dc0 - 1)\n    for c in range(first_c, last_c + 1):\n        offset = int(c - sc1)\n        if (offset - right_offsets[0]) % period == 0:\n            color = right_colors[0]\n        elif (offset - right_offsets[1]) % period == 0:\n            color = right_colors[1]\n        else:\n            continue\n        _paint_rect(out, bg, sr0, c, sr1, c, color)\n        _paint_rect(out, bg, dr0, c, dr1, c, color)\n\n    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])\n    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])\n\n    first_r = int(sr1 + below_offsets[0])\n    last_r = int(dr0 - 1)\n    left_c = int(sc0 - 1)\n    right_c = int(dc1 + 1)\n    for r in range(first_r, last_r + 1):\n        _paint(out, bg, r, left_c, below_colors[0])\n        _paint(out, bg, r, right_c, below_colors[0])\n\n        offset = int(r - sr1)\n        if (offset - below_offsets[0]) % period == 0:\n---END---\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n---END---\nFILE: /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\n---END---\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\n---END---\nFILE: /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Predict the next panel in a framed sequence by continuing each scheduled colored interval.\n\n    Input structure\n    - The grid is made from three or more equal panels in one row or one column.\n    - The final input panel is the static target template; every earlier panel differs from it only by dynamic colors absent from the template.\n    - Each dynamic color appears in a regular temporal schedule across the earlier panels.\n\n    Rule\n    - Keep the final template panel as the output canvas.\n    - For every dynamic color whose schedule reaches the next panel, compare its last two appearances.\n    - Extrapolate each one-dimensional interval along the color's changing row or column axis and paint that predicted mask.\n\n    Key insight\n    - The task is not asking for the last visible panel, but for the next frame after the blank/template slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    panels, diff_colors = _split_panels(g)\n    template = panels[-1]\n    prior = panels[:-1]\n    next_time = len(prior)\n\n    predictions: list[tuple[int, np.ndarray]] = []\n    for color in diff_colors:\n        times = [i for i, panel in enumerate(prior) if np.any(panel == color)]\n        assert len(times) >= 2\n        gaps = [b - a for a, b in zip(times, times[1:])]\n        assert len(set(gaps)) == 1\n        period = gaps[0]\n        if next_time - times[-1] != period:\n            continue\n\n        previous = prior[times[-2]] == color\n        current = prior[times[-1]] == color\n        predictions.append((color, _extrapolate_mask(previous, current)))\n\n    assert predictions\n    occupied = np.zeros_like(template, dtype=bool)\n    for _color, mask in predictions:\n        assert not np.any(occupied & mask)\n        occupied |= mask\n\n    out = template.copy()\n    for color, mask in predictions:\n        out[mask] = color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, orientation, and color sampling.\nPANEL_SIZE_MIN, PANEL_SIZE_MAX = 5, 11\nPANEL_COUNT_CHOICES, ORIENTATION_CHOICES = (3, 5), (False, True)\nCOLOR_POOL, TOTAL_COLOR_CHOICES, MOTION_AXIS_CHOICES = range(10), (4, 5), (0, 1)\n\n# Template decoration density and symmetry.\nTEMPLATE_MIN_DECO_CELLS = 4\nTEMPLATE_DECO_MIN_RATIO, TEMPLATE_DECO_MAX_RATIO = 0.10, 0.30\n\n# Blob motif and growth bounds.\nBLOB_GROWTH_MIN, BLOB_GROWTH_MAX = 1, 4\nBLOB_MAX_INITIAL_CELLS, BLOB_MAX_COMPONENTS = 7, 2\nBLOB_MAX_LINE_COUNT, BLOB_MAX_WIDTH = 3, 3\nBLOB_DIRECTIONS = (-1, 1)\n\n# Dynamic-color schedules.\nSHORT_PRIOR_COUNT, MAX_DYNAMIC_COLORS = 2, 3\nSCHEDULE_ALWAYS_2 = {\"period\": 1, \"times\": [0, 1], \"scheduled\": True}\nSCHEDULE_ALWAYS_4 = {\"period\": 1, \"times\": [0, 1, 2, 3], \"scheduled\": True}\nSCHEDULE_EVEN_4 = {\"period\": 2, \"times\": [0, 2], \"scheduled\": True}\nSCHEDULE_FIRST3_4 = {\"period\": 1, \"times\": [0, 1, 2], \"scheduled\": False}\nSCHEDULE_ODD_4 = {\"period\": 2, \"times\": [1, 3], \"scheduled\": False}\nSCHEDULE_SECOND_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4)\nSCHEDULE_THIRD_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4, SCHEDULE_FIRST3_4, SCHEDULE_ODD_4)\n\n# Placement and retry limits.\nMASK_TRANSPARENT, PLACEMENT_BORDER = 0, 1\nGENERATION_RETRIES = 300\n\ndef _sym_orbits(h: int, w: int) -> list[list[tuple[int, int]]]:\n    seen: set[tuple[int, int]] = set()\n---END---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n---END---\nFILE: /home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert a rough nested line drawing into a clean canonical frame-and-dot diagram.\n\n    Input structure:\n    - The grid has one background color and one foreground color.\n    - Foreground 4-connected objects are rough closed frames or small filled blobs.\n    - Frames may contain other frames/blobs; blobs outside a frame remain outside it.\n\n    Rule:\n    - Detect the containment tree of foreground objects using holes of each frame object.\n    - Replace every blob with one foreground pixel.\n    - Replace every frame with a rectangular border padded two cells around its direct children.\n    - Place siblings by their original row/column overlap and order, with one empty cell between canonical objects.\n\n    Key insight: The exact wobbly geometry is irrelevant; only enclosure plus relative sibling positions define the output.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    fg_colors = sorted(set(map(int, g.flatten())) - {bg})\n    assert len(fg_colors) == 1\n    fg = int(fg_colors[0])\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg], return_format=\"dict\")\n    assert comps\n\n    nodes: list[_Node] = []\n    holes: list[list[np.ndarray]] = []\n    for comp in comps:\n        coords = np.asarray(comp[\"coords\"], dtype=int)\n        node = _Node(\n            coords=coords,\n            bbox=tuple(map(int, comp[\"bbox\"])),\n            center=coords.mean(axis=0),\n        )\n        node_holes = _component_holes(g.shape, coords)\n        node.is_frame = bool(node_holes)\n        nodes.append(node)\n        holes.append(node_holes)\n\n    assert any(node.is_frame for node in nodes)\n    for node_i, node in enumerate(nodes):\n        containers = []\n        for frame_i, frame in enumerate(nodes):\n            if node_i == frame_i or not frame.is_frame:\n                continue\n            if any(np.all(hole[tuple(node.coords.T)]) for hole in holes[frame_i]):\n                containers.append(frame)\n        if containers:\n            node.parent = min(containers, key=lambda item: int(item.coords.shape[0]))\n            node.parent.children.append(node)\n\n    roots = [node for node in nodes if node.parent is None]\n    mask = _layout_root(roots)\n    out = np.full(mask.shape, bg, dtype=int)\n    out[mask] = fg\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# ── CFG: tunable generation parameters ──────────────────────────────────────\n# Grid / canvas bounds\nGRID_MIN = 16              # minimum grid dimension (rows or cols)\nGRID_MAX = 25              # maximum grid dimension\nMAX_EXTRA_PAD = 12         # max total padding beyond drawing extent\nMAX_PAD_PER_SIDE = 6       # max padding on one side\n\n# Frame geometry\nFRAME_H_RANGE = (7, 20)    # allowed frame bbox height\nFRAME_W_RANGE = (7, 24)    # allowed frame bbox width\nFRAME_CORNER_MAX = 5       # max corner wobble displacement\nFRAME_MIN_EDGE = 2         # min straight-edge length between corners\nFRAME_TURN_RATIO = (0.34, 0.43)  # acceptable turn-ratio range for wobbly loops\nFRAME_RETRIES = 60         # retries per frame-mask generation\n\n# Blob geometry\nBLOB_SIZE_RANGE = (4, 11)  # blob pixel count range\nBLOB_BBOX_RANGE = (2, 5)   # blob bbox dimension range (exclusive upper)\n\n# Layout / arrangement\n---END---\ndef generate_input():\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 2d0172a1 input\")\n---END---\nFILE: /home/lixinyu/snap/new/ARC_code/train/985ae207.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repeat each 3x3 control-center sprite toward the matching solid rectangle until a copy first overlaps that rectangle.\n\n    Input structure\n    - The background is the dominant color.\n    - Each sprite is a 3x3 foreground object whose eight border pixels have one color and whose center has a different control color.\n    - For every control color, there is exactly one separate solid rectangular object of that color.\n\n    Rule\n    - Match each sprite to the unique solid rectangle whose color equals the sprite center.\n    - Copy the whole 3x3 sprite in the cardinal direction of that rectangle, stepping by three cells each time.\n    - Stop after pasting the first copy whose 3x3 bbox overlaps the rectangle; copied pixels overwrite the rectangle there.\n\n    Key insight\n    The center pixel is not the paint color: it is a destination key, while the entire 3x3 sprite is the motif tiled along the straight path.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h >= 3 and w >= 3\n\n    bg = int(get_bg(g))\n    sprites = _find_sprites(g, bg)\n    assert sprites, \"expected at least one 3x3 control-center sprite\"\n\n    out = g.copy()\n    for sprite_bbox, patch, center in sprites:\n        targets = _solid_rectangles(g, bg, center)\n        assert len(targets) == 1, \"each control color must have one solid rectangular target\"\n        target_bbox = targets[0][\"bbox\"]\n        assert not _intersects(sprite_bbox, target_bbox), \"sprite and target must start separate\"\n\n        dr, dc = _direction_to_target(sprite_bbox, target_bbox)\n        r, c = sprite_bbox[0], sprite_bbox[1]\n\n        while True:\n            current_bbox = (r, c, r + 2, c + 2)\n            assert 0 <= r and r + 3 <= h and 0 <= c and c + 3 <= w\n            paste(out, patch, r, c)\n\n            if _intersects(current_bbox, target_bbox):\n                break\n\n            r += dr * 3\n            c += dc * 3\n\n    return out\n\n# --------------- generator (att1) ---------------\n# Canvas and colors.\nBG_COLOR, COLOR_COUNT = 8, 10\nGRID_MIN_SIZE, GRID_MAX_SIZE = 20, 25\n\n# Rectangles.\nRECT_COUNT_MIN, RECT_COUNT_MAX = 2, 4\nRECT_SIDE_MIN, RECT_SIDE_MAX = 2, 14\nRECT_MARGIN, RECT_SPACING_PAD = 1, 5\nRECT_PLACEMENT_ATTEMPTS = 50\n\n# Sprites and paths.\nSPRITE_SIZE, SPRITE_TOTAL_MAX = 3, 5\nSPRITE_GAPS = [1, 4, 7, 10]\nDIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n\n# Retry limits.\nGENERATION_ATTEMPTS = 300\n\n\ndef _intersects_check(a, b):\n    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])\n\n\ndef _has_bg_border(grid, sr, sc, bg):\n    H, W = grid.shape\n    for r in range(sr, sr + SPRITE_SIZE):\n        for c in range(sc, sc + SPRITE_SIZE):\n            for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < H and 0 <= nc < W:\n---END---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n---END---\nFILE: /home/lixinyu/snap/new/ARC_code/train/bd5af378.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rewrite a corner L block into two nested L borders and a diagonal trace.\n\n    Input structure\n    A rectangular grid has exactly two colors: one color forms a one-cell-thick\n    L on two adjacent outer edges, and the other color fills the remaining\n    rectangle.\n\n    Rule\n    Normalize the L to the top-left corner. Paint the outer top-left L with the\n    fill color, the next inner L with the original border color, and the main\n    diagonal of the remaining inner rectangle with the fill color. All other\n    cells become color 8, then the original orientation is restored.\n\n    Key insight\n    The corner of the input L determines the orientation; after flipping to a\n    canonical top-left L, the output is the same nested-layer pattern for every\n    example.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    assert h >= 3 and w >= 3\n    assert 8 not in np.unique(g)\n\n    border_color, fill_color, flip_rows, flip_cols = _corner_l_spec(g)\n\n    canon = g\n    if flip_rows:\n        canon = np.flipud(canon)\n    if flip_cols:\n        canon = np.fliplr(canon)\n\n    assert np.all(canon[0, :] == border_color)\n    assert np.all(canon[:, 0] == border_color)\n    assert np.all(canon[1:, 1:] == fill_color)\n\n    out = np.full((h, w), 8, dtype=int)\n    out[0, 1:] = fill_color\n    out[1:, 0] = fill_color\n    out[1, 2:] = border_color\n    out[2:, 1] = border_color\n    for k in range(min(h - 2, w - 2)):\n        out[2 + k, 2 + k] = fill_color\n\n    if flip_cols:\n        out = np.fliplr(out)\n    if flip_rows:\n        out = np.flipud(out)\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, palette, and orientation sampling knobs.\nHEIGHT_RANGE = (5, 11)\nWIDTH_RANGE = (6, 11)\nAVAILABLE_COLORS = [0, 1, 2, 3, 4, 5, 6, 7, 9]\nCORNER_EDGES = ((0, 0), (0, -1), (-1, 0), (-1, -1))\nCORNER_FLIPS = ((False, False), (False, True), (True, False), (True, True))\n# Rejection budget: oracle check should pass on the first attempt.\nMAX_ATTEMPTS = 300\n\ndef _sample_params() -> tuple[int, int, int, int, int]:\n    \"\"\"Sample dimensions, ordered colors, and one of the four L corners.\"\"\"\n    h = int(np.random.randint(*HEIGHT_RANGE))\n    w = int(np.random.randint(*WIDTH_RANGE))\n    border_color, fill_color = np.random.choice(AVAILABLE_COLORS, size=2, replace=False)\n    corner = int(np.random.randint(len(CORNER_EDGES)))\n    return h, w, int(border_color), int(fill_color), corner\n\n\ndef _paint_corner_l(inp: np.ndarray, border_color: int, corner: int) -> None:\n    \"\"\"Paint the full row and column for the requested corner in-place.\"\"\"\n    edge_r, edge_c = CORNER_EDGES[corner]\n    inp[edge_r, :] = border_color\n    inp[:, edge_c] = border_color\n\n\ndef _canonical_output(h: int, w: int, border_color: int, fill_color: int) -> np.ndarray:\n    \"\"\"Render the top-left canonical answer before restoring orientation.\"\"\"\n    out = np.full((h, w), 8, dtype=int)\n---END---\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid bd5af378 input\")\n---END---\nFILE: /home/lixinyu/snap/new/ARC_code/train/a834deea.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill each black 5x5 region's missing interior positions with a fixed 3x3 positional color legend.\n\n    Input structure\n    - The grid uses teal as the dominant background and black for one or more\n      5x5 regions.\n    - Each black region has a black one-pixel border and a 3x3 interior that\n      may already contain teal pixels.\n\n    Rule\n    - Overlay the legend 1 7 6 / 4 8 5 / 2 9 3 on the 3x3 interior of every\n      5x5 black region.\n    - Wherever an interior non-center legend position is still black, recolor it\n      to the corresponding legend color; leave existing teal pixels, the center,\n      and the black border unchanged.\n\n    Key insight\n    - The colored output pixels are not derived from the teal motif shape; they\n      are the fixed position labels for the missing cells of each 3x3 interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    assert bg == Color.TEAL\n    fg_colors = colors_present(g, exclude={bg})\n    assert fg_colors == [Color.BLACK]\n\n    out = g.copy()\n    components = find_components(\n        g,\n        bg=bg,\n        connectivity=8,\n        monochromatic=True,\n        colors=[Color.BLACK],\n    )\n    assert components\n\n    for component in components:\n        b = component[\"bbox\"]\n        assert bbox_h(b) == 5 and bbox_w(b) == 5\n        r0, c0, _r1, _c1 = b\n        patch = crop_bbox(g, b)\n        assert np.all((patch == Color.BLACK) | (patch == bg))\n        assert np.all(patch[[0, -1], :] == Color.BLACK)\n        assert np.all(patch[:, [0, -1]] == Color.BLACK)\n        assert np.any(patch[1:4, 1:4] == bg)\n\n        for rr in range(3):\n            for cc in range(3):\n                color = int(LEGEND[rr, cc])\n                if color == bg:\n                    continue\n                grid_r = int(r0) + rr + 1\n                grid_c = int(c0) + cc + 1\n                if g[grid_r, grid_c] == Color.BLACK:\n                    out[grid_r, grid_c] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and region geometry.\nMIN_GRID_SIZE, MAX_GRID_SIZE = 9, 16\nREGION_SIZE, INTERIOR_SIZE, REGION_GAP = 5, 3, 1\n\n# Region count and interior-hole sampling.\nMIN_REGIONS, MAX_REGIONS = 1, 4\nMIN_TEAL_INTERIOR, MAX_TEAL_INTERIOR = 1, 6\nMAX_AREA_PER_REGION = 48\n\n# Generation retry limit and colors.\nMAX_GENERATION_ATTEMPTS = 300\nGEN_BG, GEN_FG = Color.TEAL, Color.BLACK\nGEN_PATCH = np.full((REGION_SIZE, REGION_SIZE), GEN_FG, dtype=int)\nGEN_INTERIOR = [\n    (rr, cc) for rr in range(INTERIOR_SIZE) for cc in range(INTERIOR_SIZE)\n]\n\n---END---\ndef generate_input():\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid a834deea input\")\n---END---\nFILE: /home/lixinyu/snap/new/ARC_code/train/db118e2a.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Normalize the framed input motif into a 5x5 icon and stamp two copies on a 15x15 canvas.\n\n    Input structure\n    The input is a rounded rectangular frame: the four corners are the background\n    color, and every other outer-border pixel has one frame color. Non-background\n    pixels inside that frame are the motif to preserve.\n\n    Rule\n    Make a 5x5 version of the rounded frame with a 3x3 interior. Crop the input\n    interior motif to its bounding box, center that crop in the 3x3 interior, and\n    paste the resulting 5x5 icon at upper-left positions (2, 2) and (8, 8) in a\n    15x15 background canvas.\n\n    Key insight\n    The variable-size frame is only a carrier; the meaningful object is the\n    compact interior motif, which is normalized to the fixed 3x3 icon interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    assert h >= 3 and w >= 3\n\n    corners = (g[0, 0], g[0, w - 1], g[h - 1, 0], g[h - 1, w - 1])\n    assert len(set(map(int, corners))) == 1\n    bg = int(corners[0])\n\n    border = np.concatenate((g[0, :], g[h - 1, :], g[:, 0], g[:, w - 1]))\n    frame_colors = set(map(int, border)) - {bg}\n    assert len(frame_colors) == 1\n    (frame_color,) = tuple(frame_colors)\n\n    assert np.all(g[0, 1 : w - 1] == frame_color)\n    assert np.all(g[h - 1, 1 : w - 1] == frame_color)\n    assert np.all(g[1 : h - 1, 0] == frame_color)\n    assert np.all(g[1 : h - 1, w - 1] == frame_color)\n\n    icon = np.full((5, 5), bg, dtype=int)\n    icon[0, 1:4] = frame_color\n    icon[4, 1:4] = frame_color\n    icon[1:4, 0] = frame_color\n    icon[1:4, 4] = frame_color\n\n    interior = g[1 : h - 1, 1 : w - 1]\n    motif_box = bbox(interior != bg)\n    assert motif_box is not None\n    r0, c0, r1, c1 = motif_box\n    motif = interior[r0 : r1 + 1, c0 : c1 + 1]\n    mh, mw = motif.shape\n    assert mh <= 3 and mw <= 3\n\n    icon_r = 1 + (3 - mh) // 2\n    icon_c = 1 + (3 - mw) // 2\n    icon[icon_r : icon_r + mh, icon_c : icon_c + mw] = motif\n\n    out = np.full((15, 15), bg, dtype=int)\n    out[2:7, 2:7] = icon\n    out[8:13, 8:13] = icon\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and color constants.\n_GEN_BG = 7\n_GEN_FRAME_COLORS = [1, 2, 3, 4, 5, 6, 8, 9]\n_GEN_PALETTE = [c for c in range(10) if c != _GEN_BG]\n\n# Input/output geometry.\n_GEN_INPUT_H_RANGE = (6, 10)\n_GEN_INPUT_W_RANGE = (5, 10)\n_GEN_ICON_SIZE = 5\n_GEN_ICON_INTERIOR = 3\n_GEN_OUTPUT_SIZE = 15\n_GEN_OUTPUT_POSITIONS = ((2, 2), (8, 8))\n\n# Motif sampling.\n_GEN_MOTIF_DIM_RANGE = (1, 4)\n_GEN_NON_BG_COUNT_RANGE = (1, 8)\n_GEN_COLOR_COUNT_RANGE = (1, 3)\n_GEN_FRAME_COLOR_INJECTION_RATE = 0.35\n\n---END---\ndef generate_input():\n    rng = np.random.default_rng()\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        inp = _gen_attempt(rng)\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid db118e2a input\")\n---END---\n","exit_code":0,"status":"completed"}}
