{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '7,340p' /home/lixinyu/snap/new/ARC_code/train/e729b7be.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the scene by adding the point-reflected copy of the colored object across the central marker.\n\n    Input structure\n    - The grid has odd dimensions, a dominant background, and a center-row marker color appearing only at the left edge, center, and right edge.\n    - A single divider color fills the center column except for the center marker.\n    - All remaining foreground pixels form the object to copy, entirely on the left side of the divider.\n    Rule\n    - Keep the input unchanged.\n    - For every object pixel, paint the pixel rotated 180 degrees around the center marker with the same color.\n    Key insight\n    - The center marker is the rotation center; the yellow-looking divider is not mirrored, it only separates the source from the empty target side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h % 2 == 1 and w % 2 == 1\n\n    cr, cc = h // 2, w // 2\n    bg = int(get_bg(g))\n\n    marker_color = int(g[cr, cc])\n    assert marker_color != bg\n    marker_mask = g == marker_color\n    expected_markers = np.zeros(g.shape, dtype=bool)\n    expected_markers[cr, 0] = True\n    expected_markers[cr, cc] = True\n    expected_markers[cr, w - 1] = True\n    assert np.array_equal(marker_mask, expected_markers)\n\n    center_col = g[:, cc]\n    divider_colors = {int(color) for color in np.unique(center_col) if int(color) != marker_color}\n    assert len(divider_colors) == 1\n    divider_color = next(iter(divider_colors))\n    assert divider_color != bg\n    expected_divider = np.zeros(g.shape, dtype=bool)\n    expected_divider[:, cc] = True\n    expected_divider[cr, cc] = False\n    assert np.array_equal(g == divider_color, expected_divider)\n\n    source_mask = (g != bg) & (g != marker_color) & (g != divider_color)\n    source_coords = np.argwhere(source_mask)\n    assert source_coords.size > 0\n    assert np.all(source_coords[:, 1] < cc)\n\n    out = g.copy()\n    for r, c in source_coords:\n        rr = 2 * cr - int(r)\n        rc = 2 * cc - int(c)\n        assert 0 <= rr < h and 0 <= rc < w\n        assert out[rr, rc] == bg\n        out[rr, rc] = g[r, c]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Colors and canvas bounds.\nBG_COLOR, DIVIDER_COLOR, MARKER_COLOR = 7, 4, 8\nGRID_SIZES, MIN_EMPTY_BORDER_ROWS = (15, 17, 19), 1\n\n# Convex source shape bounds.\nSOURCE_SPAN_RANGE = (10, 15)\nSOURCE_MAX_WIDTH_RANGE = (5, 7)\nSOURCE_EDGE_WIDTH_RANGE = (1, 3)\nWIDTH_STEP_CAP, SOURCE_PIXEL_RANGE = 2, (35, 83)\n\n# Color palette, band orders, and retry budget.\nSOURCE_COLORS = (0, 1, 2, 3, 5, 6, 9)\nSOURCE_COLOR_COUNT_RANGE, GEN_ATTEMPTS = (3, 7), 300\nCOLORING_KEYS = (\n    lambda item: (item[2], item[3], item[1]),\n    lambda item: (item[3], item[2], item[1]),\n    lambda item: (item[2] + item[3], item[2], item[1]),\n    lambda item: (item[2] - item[3], item[2], item[1]),\n)\n\n\ndef _gen_bounded_steps(total, slots, cap):\n    steps = []\n    remaining = total\n    for i in range(slots):\n        left = slots - i - 1\n        lo = max(0, remaining - cap * left)\n        hi = min(cap, remaining)\n        step = random.randint(lo, hi)\n        steps.append(step)\n        remaining -= step\n    return steps\n\n\ndef _gen_width_profile(span, max_width):\n    edge_width_hi = min(SOURCE_EDGE_WIDTH_RANGE[1], max_width)\n    start_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n    end_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n    min_up = (max_width - start_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n    min_down = (max_width - end_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n    if min_up + min_down + 1 > span:\n        return None\n\n    peak_start = random.randint(min_up, span - 1 - min_down)\n    peak_end = random.randint(peak_start, span - 1 - min_down)\n\n    widths = [start_width]\n    for step in _gen_bounded_steps(max_width - start_width, peak_start, WIDTH_STEP_CAP):\n        widths.append(widths[-1] + step)\n\n    widths.extend([max_width] * (peak_end - peak_start))\n\n    current = max_width\n    for step in _gen_bounded_steps(max_width - end_width, span - 1 - peak_end, WIDTH_STEP_CAP):\n        current -= step\n        widths.append(current)\n\n    area = sum(widths)\n    if not SOURCE_PIXEL_RANGE[0] <= area <= SOURCE_PIXEL_RANGE[1]:\n        return None\n    return widths\n\n\ndef _choose_source_extent(n, cr):\n    valid_spans = [s for s in range(SOURCE_SPAN_RANGE[0], SOURCE_SPAN_RANGE[1] + 1) if s <= n - 2 * MIN_EMPTY_BORDER_ROWS]\n    span = random.choice(valid_spans)\n    r0_min = max(MIN_EMPTY_BORDER_ROWS, cr - span + 1)\n    r0_max = min(cr, n - MIN_EMPTY_BORDER_ROWS - span)\n    r0 = random.randint(r0_min, r0_max)\n    return span, r0, cr - r0\n\n\ndef _paint_source_cells(out, r0, widths, outer, cc):\n    interior = []\n    source = []\n    for i, width in enumerate(widths):\n        r = r0 + i\n        c0 = cc - width\n        for j in range(width):\n            c = c0 + j\n            source.append((r, c))\n            if j == 0:\n                out[r, c] = outer\n            else:\n                interior.append((r, c, i, j))\n    return source, interior\n\n\ndef _gen_color_source(out, r0, widths, colors, cc):\n    outer = colors[0]\n    inner = colors[1:]\n    source, interior = _paint_source_cells(out, r0, widths, outer, cc)\n    if len(interior) < len(inner):\n        return None\n\n    key = COLORING_KEYS[random.randrange(len(COLORING_KEYS))]\n    interior.sort(key=key)\n    band_count = len(inner)\n    for rank, (r, c, _, _) in enumerate(interior):\n        out[r, c] = inner[min(band_count - 1, rank * band_count // len(interior))]\n\n    return source\n\n\ndef _reflect_source(out, source, cr, cc):\n    reflected = []\n    for r, c in source:\n        rr = 2 * cr - r\n        rc = 2 * cc - c\n        if out[rr, rc] != BG_COLOR:\n            return None\n        out[rr, rc] = out[r, c]\n        reflected.append((rr, rc))\n    return reflected\n\n\ndef _gen_attempt():\n    n = random.choice(GRID_SIZES)\n    cr = cc = n // 2\n    out = np.full((n, n), BG_COLOR, dtype=int)\n    out[:, cc] = DIVIDER_COLOR\n    out[cr, [0, cc, n - 1]] = MARKER_COLOR\n\n    span, r0, center_i = _choose_source_extent(n, cr)\n    max_width = random.randint(*SOURCE_MAX_WIDTH_RANGE)\n    widths = _gen_width_profile(span, max_width)\n    if widths is None:\n        return None\n    if widths[center_i] >= cc:\n        return None\n\n    color_count = random.randint(*SOURCE_COLOR_COUNT_RANGE)\n    colors = random.sample(SOURCE_COLORS, color_count)\n    source = _gen_color_source(out, r0, widths, colors, cc)\n    if source is None:\n        return None\n\n    reflected = _reflect_source(out, source, cr, cc)\n    if reflected is None:\n        return None\n\n    inp = out.copy()\n    for r, c in reflected:\n        inp[r, c] = BG_COLOR\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input():\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid e729b7be input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '38,620p' /home/lixinyu/snap/new/ARC_code/eval/edb79dae.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '38,620p' /home/lixinyu/snap/new/ARC_code/eval/edb79dae.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp recolored sprites into a framed region using placeholder positions and a color legend.\n\n    Input structure:\n    - bg background, a rectangular single-color frame, colored placeholder cells inside the frame.\n    - Outside the frame: sprite shapes (one per placeholder color) and a small legend mapping each placeholder color to an output color.\n\n    Rule:\n    - Find the frame and its interior placeholders.\n    - For each placeholder color, locate the matching-color sprite outside the frame.\n    - Stamp each sprite at the placeholder's position inside the frame.\n    - Recolor every stamped sprite to the output color defined by the legend.\n\n    Key insight: The legend pairs (overlapping two-color glyphs outside the frame) dictate the final recoloring — placeholder color selects the shape, legend maps it to the output color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    frame_col, (fr0, fc0, fr1, fc1) = _find_frame(g, bg)\n\n    crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1]\n    H, W = crop.shape\n    assert H >= 3 and W >= 3, f\"frame too small for interior: {(H, W)}\"\n\n    # Placeholder components inside the frame interior.\n    inner_mask = np.zeros((H, W), dtype=bool)\n    inner_mask[1:-1, 1:-1] = True\n    placeholder_colors = set(map(int, np.unique(crop[inner_mask]))) - {bg, frame_col}\n    assert placeholder_colors, \"no placeholder colors found inside frame\"\n\n    placeholders: list[tuple[int, tuple[int, int, int, int]]] = []\n    for col in sorted(placeholder_colors):\n        for pts in components_mask((crop == col) & inner_mask, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            placeholders.append((col, (r0, c0, r1, c1)))\n    # Eval inputs use one placement bbox size per placeholder color.\n    phw: dict[int, tuple[int, int]] = {}\n    for col in placeholder_colors:\n        dims = [(b[2] - b[0] + 1, b[3] - b[1] + 1) for c, b in placeholders if c == col]\n        assert dims, f\"no placeholder component found for color {col}\"\n        unique_dims = sorted(set(dims))\n        assert len(unique_dims) == 1, f\"ambiguous placeholder sizes for color {col}: {unique_dims}\"\n        phw[col] = unique_dims[0]\n\n    # Extract outside-frame components for sprite shapes and for legend color mapping.\n    outside = np.ones(g.shape, dtype=bool)\n    outside[fr0 : fr1 + 1, fc0 : fc1 + 1] = False\n\n    # Collect all outside components (with ids) for later pairing.\n    comps = []\n    colors = [int(c) for c in np.unique(g) if int(c) not in (bg, frame_col)]\n    cid = 0\n    for col in colors:\n        for pts in components_mask((g == col) & outside, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            pts_tuples = [(int(r), int(c)) for r, c in pts]\n            comps.append(\n                {\n                    \"id\": cid,\n                    \"col\": int(col),\n                    \"pts\": pts_tuples,\n                    \"bbox\": (r0, c0, r1, c1),\n                    \"area\": len(pts_tuples),\n                }\n            )\n            cid += 1\n\n    def _bbox_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n        ar0, ac0, ar1, ac1 = a\n        br0, bc0, br1, bc1 = b\n        return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)\n\n    # Legend mapping: detect small two-color glyph regions where two components overlap in bbox\n    # and the union bbox contains only those two colors (no background).\n    color_map: dict[int, int] = {}\n    legend_ids: set[int] = set()\n\n    for i in range(len(comps)):\n        for j in range(i + 1, len(comps)):\n            ci = comps[i]\n            cj = comps[j]\n            if ci[\"col\"] == cj[\"col\"]:\n                continue\n            if not _bbox_overlap(ci[\"bbox\"], cj[\"bbox\"]):\n                continue\n            r0 = min(ci[\"bbox\"][0], cj[\"bbox\"][0])\n            c0 = min(ci[\"bbox\"][1], cj[\"bbox\"][1])\n            r1 = max(ci[\"bbox\"][2], cj[\"bbox\"][2])\n            c1 = max(ci[\"bbox\"][3], cj[\"bbox\"][3])\n            # restrict to compact legend-like regions\n            if (r1 - r0 + 1) > 8 or (c1 - c0 + 1) > 8:\n                continue\n            sub = g[r0 : r1 + 1, c0 : c1 + 1]\n            sub_colors = set(map(int, np.unique(sub))) - {frame_col}\n            if bg in sub_colors:\n                continue\n            if len(sub_colors) != 2:\n                continue\n            cset = set(sub_colors)\n            if ci[\"col\"] not in cset or cj[\"col\"] not in cset:\n                continue\n\n            # Decide source->target.\n            # If exactly one color is used as a placeholder inside the frame, that one is source.\n            if (ci[\"col\"] in placeholder_colors) ^ (cj[\"col\"] in placeholder_colors):\n                src = ci[\"col\"] if ci[\"col\"] in placeholder_colors else cj[\"col\"]\n                tgt = cj[\"col\"] if src == ci[\"col\"] else ci[\"col\"]\n            else:\n                # Otherwise: the larger component in this pair is treated as the source.\n                assert ci[\"area\"] != cj[\"area\"], f\"ambiguous equal-area legend pair: {ci['col']} and {cj['col']}\"\n                if ci[\"area\"] > cj[\"area\"]:\n                    src, tgt = ci[\"col\"], cj[\"col\"]\n                else:\n                    src, tgt = cj[\"col\"], ci[\"col\"]\n\n            assert src in placeholder_colors, f\"legend source color {src} is not a placeholder\"\n            assert src not in color_map, f\"duplicate legend mapping for placeholder color {src}\"\n            color_map[src] = int(tgt)\n            legend_ids.add(ci[\"id\"])\n            legend_ids.add(cj[\"id\"])\n    assert set(color_map) == placeholder_colors, (\n        f\"legend mappings {sorted(color_map)} do not match placeholders {sorted(placeholder_colors)}\"\n    )\n\n    # Sprite shapes: for each placeholder color, pick the non-legend component matching placeholder size.\n    sprite_coords: dict[int, tuple[tuple[tuple[int, int], ...], int, int]] = {}\n    for src_col in sorted(placeholder_colors):\n        all_candidates = [c for c in comps if c[\"col\"] == src_col and c[\"id\"] not in legend_ids]\n        assert all_candidates, f\"no non-legend sprite found for color {src_col}\"\n        want_h, want_w = phw[src_col]\n        sized = [\n            c\n            for c in all_candidates\n            if (c[\"bbox\"][2] - c[\"bbox\"][0] + 1) == want_h and (c[\"bbox\"][3] - c[\"bbox\"][1] + 1) == want_w\n        ]\n        assert len(sized) == 1, f\"expected one size-matched sprite for color {src_col}, found {len(sized)}\"\n        base = sized[0]\n        sr0, sc0, sr1, sc1 = base[\"bbox\"]\n\n        # Some sprites can be split into multiple 4-connected components of the same color.\n        # Merge any additional (non-legend) components fully contained in the chosen sprite bbox.\n        pts_set = set(base[\"pts\"])\n        for c in all_candidates:\n            if c[\"id\"] == base[\"id\"]:\n                continue\n            r0, c0, r1, c1 = c[\"bbox\"]\n            assert sr0 <= r0 and sr1 >= r1 and sc0 <= c0 and sc1 >= c1, (\n                f\"extra sprite component for color {src_col} is outside the base bbox\"\n            )\n            pts_set.update(c[\"pts\"])\n\n        coords = tuple(sorted((r - sr0, c - sc0) for r, c in pts_set))\n        sprite_coords[src_col] = (coords, sr1 - sr0 + 1, sc1 - sc0 + 1)\n\n    # Build output crop: keep frame border, clear interior to bg, then paste recolored sprites.\n    out = crop.copy()\n    out[1:-1, 1:-1] = bg\n\n    for src_col, (pr0, pc0, pr1, pc1) in placeholders:\n        assert src_col in sprite_coords and src_col in color_map, f\"placeholder color {src_col} missing sprite or color mapping\"\n        tgt_col = int(color_map[src_col])\n        coords, sh, sw = sprite_coords[src_col]\n        assert (pr1 - pr0 + 1, pc1 - pc0 + 1) == (sh, sw), (\n            f\"placeholder size does not match sprite for color {src_col}\"\n        )\n        assert pr0 + sh <= H and pc0 + sw <= W, f\"sprite for color {src_col} does not fit at placeholder\"\n        # Align sprite's bbox top-left to placeholder bbox top-left.\n        off_r = pr0\n        off_c = pc0\n        for dr, dc in coords:\n            rr, cc = off_r + dr, off_c + dc\n            out[rr, cc] = tgt_col\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# === CFG: tunables ===\nFRAME_COL = 5                       # frame border color (always gray)\nSPRITE_N_RANGE = (3, 6)             # NxN sprite/placeholder size, exclusive upper\nGRID_ROWS_RANGE = (2, 4)            # placeholder grid row count, exclusive upper\nGRID_COLS_RANGE = (3, 5)            # placeholder grid col count, exclusive upper\nTOTAL_BLOCKS_RANGE = (6, 10)        # total filled slots (inclusive)\nMAX_EMPTY_SLOTS = 2                 # max empty slots in the grid\nNUM_COLORS_RANGE = (2, 5)           # K = number of distinct placeholder colors (inclusive)\nSPRITE_FILL_MIN = 0.5               # min sprite fill ratio\nSPRITE_FILL_MAX = 0.9               # max sprite fill ratio (clamped to n*n-1)\nMIN_FRAME_H = 13                    # minimum frame height\nMIN_FRAME_W = 18                    # minimum frame width\nMAX_FRAME_DIM = 21                  # maximum frame height or width\nFRAME_MARGIN_SLACK = 4              # max extra padding inside frame beyond content\nCANVAS_H_RANGE = (22, 31)           # final grid height range, exclusive upper\nCANVAS_W_RANGE = (23, 31)           # final grid width range, exclusive upper\nFRAME_POS_JITTER_PROB = 0.25        # probability of non-edge frame placement per axis\nPATCH_PADDING = 1                   # min bg gap between placed patches\nGEN_RETRIES = 300                   # outer retry budget\n\n\ndef _legend(src: int, tgt: int) -> np.ndarray:\n    \"\"\"Build a 3x4 legend block mapping src color to tgt color.\"\"\"\n    return np.array(\n        [[src, src, tgt, tgt],\n         [src, src, src, tgt],\n         [src, src, tgt, tgt]], dtype=int)\n\n\ndef _sprite_mask(n: int) -> np.ndarray:\n    \"\"\"Generate a random NxN binary mask with fill ratio in [SPRITE_FILL_MIN, SPRITE_FILL_MAX].\"\"\"\n    lo = max((n * n + 1) // 2, int(np.ceil(SPRITE_FILL_MIN * n * n)))\n    hi = min(int(np.floor(SPRITE_FILL_MAX * n * n)), n * n - 1)\n    target = random.randint(lo, hi)\n\n    # Seed: random walk column + one full row, then random orientation\n    mask = np.zeros((n, n), dtype=bool)\n    c = random.randrange(n)\n    for r in range(n):\n        c = max(0, min(n - 1, c + random.choice([-1, 0, 1])))\n        mask[r, c] = True\n    mask[random.randrange(n), :] = True\n\n    if random.random() < 0.5:\n        mask = mask.T.copy()\n    if random.random() < 0.5:\n        mask = np.flipud(mask)\n    if random.random() < 0.5:\n        mask = np.fliplr(mask)\n\n    # Grow to target fill by adding random frontier cells\n    while int(mask.sum()) < target:\n        dilated = np.zeros_like(mask)\n        dilated[1:, :] |= mask[:-1, :]\n        dilated[:-1, :] |= mask[1:, :]\n        dilated[:, 1:] |= mask[:, :-1]\n        dilated[:, :-1] |= mask[:, 1:]\n        frontier = list(zip(*np.where(dilated & ~mask)))\n        r, c = random.choice(frontier)\n        mask[r, c] = True\n    return mask\n\n\ndef _colored_sprite(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\n    \"\"\"Render a binary mask as a colored sprite on bg.\"\"\"\n    out = np.full(mask.shape, bg, dtype=int)\n    out[mask] = int(color)\n    return out\n\n\ndef _content_extent(n: int, grid_rows: int, grid_cols: int) -> tuple[int, int]:\n    \"\"\"Content area needed for grid_rows x grid_cols of NxN blocks with 1-cell gaps.\"\"\"\n    return (grid_rows * n + grid_rows - 1, grid_cols * n + grid_cols - 1)\n\n\ndef _choose_structure() -> tuple[int, int, int, int, int] | None:\n    \"\"\"Pick (n, rows, cols, empty_count, total) satisfying frame size constraints.\"\"\"\n    total = random.randint(*TOTAL_BLOCKS_RANGE)\n    options = []\n    for n in range(*SPRITE_N_RANGE):\n        for rows in range(*GRID_ROWS_RANGE):\n            for cols in range(*GRID_COLS_RANGE):\n                ch, cw = _content_extent(n, rows, cols)\n                base_fh = ch + 4  # +2 border +2 min margin\n                base_fw = cw + 4\n                slots = rows * cols\n                empty = slots - total\n                if base_fh <= MAX_FRAME_DIM and base_fw <= MAX_FRAME_DIM and 0 <= empty <= MAX_EMPTY_SLOTS:\n                    options.append((n, rows, cols, empty, total))\n    return random.choice(options) if options else None\n\n\ndef _choose_empty_slots(\n    rows: int, cols: int, empty_count: int\n) -> tuple[set[tuple[int, int]], list[tuple[int, int]]]:\n    \"\"\"Choose which grid slots are empty, ensuring every row and column has at least one filled slot.\n\n    Returns (empty_slots, shuffled filled_slots).\n    \"\"\"\n    slots = [(r, c) for r in range(rows) for c in range(cols)]\n    valid = []\n    for combo in itertools.combinations(slots, empty_count):\n        empty = set(combo)\n        filled = [s for s in slots if s not in empty]\n        if len({r for r, _ in filled}) == rows and len({c for _, c in filled}) == cols:\n            valid.append(empty)\n    empty_slots = random.choice(valid)\n    filled_slots = [s for s in slots if s not in empty_slots]\n    random.shuffle(filled_slots)\n    return empty_slots, filled_slots\n\n\ndef _make_bordered_frame(h: int, w: int, bg: int) -> np.ndarray:\n    \"\"\"Create an h x w frame filled with bg and a 1-cell FRAME_COL border.\"\"\"\n    frame = np.full((h, w), bg, dtype=int)\n    frame[0, :] = frame[-1, :] = FRAME_COL\n    frame[:, 0] = frame[:, -1] = FRAME_COL\n    return frame\n\n\ndef _place_patch(\n    grid: np.ndarray, reserve: np.ndarray, patch: np.ndarray, bg: int,\n    *, transparent: bool,\n) -> bool:\n    \"\"\"Find a free location for patch and paste it onto grid/reserve. Returns success.\"\"\"\n    blocker = np.full(patch.shape, FRAME_COL, dtype=int)\n    try:\n        r, c = random_free_location(reserve, blocker, transparent=bg, padding=PATCH_PADDING)\n    except ValueError:\n        return False\n    paste(reserve, blocker, r, c)\n    paste(grid, patch, r, c, transparent=bg if transparent else None)\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    # --- structure ---\n    struct = _choose_structure()\n    if struct is None:\n        return None\n    n, rows, cols, empty_count, _ = struct\n\n    bg = random.choice([c for c in range(10) if c != FRAME_COL])\n    usable = [c for c in range(10) if c not in (bg, FRAME_COL)]\n\n    # --- colors ---\n    k = random.randint(*NUM_COLORS_RANGE)\n    src_cols = random.sample(usable, k)\n    tgt_cols = [random.choice([c for c in usable if c != src]) for src in src_cols]\n    color_to_tgt = dict(zip(src_cols, tgt_cols))\n    masks = {src: _sprite_mask(n) for src in src_cols}\n\n    # --- frame dimensions & margins ---\n    ch, cw = _content_extent(n, rows, cols)\n    min_fh = max(MIN_FRAME_H, ch + 4)\n    min_fw = max(MIN_FRAME_W, cw + 4)\n    frame_h = random.randint(min_fh, min(MAX_FRAME_DIM, max(min_fh, ch + 2 + FRAME_MARGIN_SLACK)))\n    frame_w = random.randint(min_fw, min(MAX_FRAME_DIM, max(min_fw, cw + 2 + FRAME_MARGIN_SLACK)))\n    y_margin = frame_h - 2 - ch\n    x_margin = frame_w - 2 - cw\n    top_margin = random.randint(1, y_margin - 1)\n    left_margin = random.randint(1, x_margin - 1)\n\n    # --- slot assignment ---\n    _, filled_slots = _choose_empty_slots(rows, cols, empty_count)\n    cell_colors = {}\n    for slot, col in zip(filled_slots[:k], src_cols):\n        cell_colors[slot] = col\n    for slot in filled_slots[k:]:\n        cell_colors[slot] = random.choice(src_cols)\n\n    # --- build input & output frames ---\n    input_frame = _make_bordered_frame(frame_h, frame_w, bg)\n    output_frame = _make_bordered_frame(frame_h, frame_w, bg)\n    for (rr, cc), src in cell_colors.items():\n        r0 = 1 + top_margin + rr * (n + 1)\n        c0 = 1 + left_margin + cc * (n + 1)\n        paste(input_frame, np.full((n, n), src, dtype=int), r0, c0)\n        paste(output_frame, _colored_sprite(masks[src], color_to_tgt[src], bg), r0, c0, transparent=bg)\n\n    # --- canvas selection & frame placement ---\n    ext_area = k * (12 + n * n + 10)\n    possible_dims = [\n        (h, w)\n        for h in range(*CANVAS_H_RANGE)\n        for w in range(*CANVAS_W_RANGE)\n        if h >= frame_h and w >= frame_w and h * w - frame_h * frame_w >= ext_area\n    ]\n    if not possible_dims:\n        return None\n    h, w = random.choice(possible_dims)\n    grid = np.full((h, w), bg, dtype=int)\n    reserve = np.full((h, w), bg, dtype=int)\n\n    fr0 = random.choice([0, h - frame_h])\n    fc0 = random.choice([0, w - frame_w])\n    if h - frame_h > 2 and random.random() < FRAME_POS_JITTER_PROB:\n        fr0 = random.randrange(0, h - frame_h + 1)\n    if w - frame_w > 2 and random.random() < FRAME_POS_JITTER_PROB:\n        fc0 = random.randrange(0, w - frame_w + 1)\n    paste(grid, input_frame, fr0, fc0)\n    paste(reserve, np.full((frame_h, frame_w), FRAME_COL, dtype=int), fr0, fc0)\n\n    # --- place external patches (sprites + legends) ---\n    patches: list[tuple[np.ndarray, bool]] = []\n    for src, tgt in zip(src_cols, tgt_cols):\n        patches.append((_colored_sprite(masks[src], src, bg), True))\n        patches.append((_legend(src, tgt), False))\n    random.shuffle(patches)\n    patches.sort(key=lambda item: item[0].size, reverse=True)\n    for patch, transparent in patches:\n        if not _place_patch(grid, reserve, patch, bg, transparent=transparent):\n            return None\n\n    # --- oracle check ---\n    try:\n        if not np.array_equal(main(grid), output_frame):\n            return None\n    except Exception:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        out = _gen_attempt()\n        if out is not None:\n            return out\n    raise RuntimeError(\"failed to generate valid edb79dae input\")\n","exit_code":0,"status":"completed"}}
