{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '101,760p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n    h, w = canvas_mask.shape\n    sr, sc = seed\n    if not canvas_mask[sr, sc]:\n        return None\n    blob = {(sr, sc)}\n    frontier = []\n    def push_neighbors(r, c):\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:\n                frontier.append((nr, nc))\n    push_neighbors(sr, sc)\n    while len(blob) < target_size and frontier:\n        idx = rng.randrange(len(frontier))\n        r, c = frontier.pop(idx)\n        if (r, c) in blob or not canvas_mask[r, c]:\n            continue\n        blob.add((r, c))\n        push_neighbors(r, c)\n    if len(blob) < target_size:\n        return None\n    return blob\n\n\ndef _blob_wall_cells(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n    wall = set()\n    for r, c in blob:\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in blob:\n                wall.add((nr, nc))\n    return wall\n\n\ndef _fill_holes(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Return blob with interior holes absorbed.\n\n    Barrier = blob union its wall ring. Any non-barrier cell unreachable from the grid\n    border through non-barrier cells is trapped and gets absorbed into the blob.\n    \"\"\"\n    walls = _blob_wall_cells(blob, h, w)\n    barrier = np.zeros((h, w), dtype=bool)\n    for r, c in blob:\n        barrier[r, c] = True\n    for r, c in walls:\n        barrier[r, c] = True\n\n    # Flood-fill from border through non-barrier cells.\n    reachable = np.zeros((h, w), dtype=bool)\n    stack = []\n    for r in range(h):\n        for c in (0, w - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    for c in range(w):\n        for r in (0, h - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    while stack:\n        r, c = stack.pop()\n        if reachable[r, c] or barrier[r, c]:\n            continue\n        reachable[r, c] = True\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and not reachable[nr, nc] and not barrier[nr, nc]:\n                stack.append((nr, nc))\n\n    trapped = (~reachable) & (~barrier)\n    if not trapped.any():\n        return blob\n    filled = set(blob)\n    for r, c in np.argwhere(trapped):\n        filled.add((int(r), int(c)))\n    return filled\n\n\n# ── Slide helpers ─────────────────────────────────────────────────\n\ndef _slide_step_valid(region_set: set, r: int, c: int, dr: int, dc: int) -> bool:\n    nr, nc = r + dr, c + dc\n    if (nr, nc) not in region_set:\n        return False\n    if dr != 0 and dc != 0:\n        if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n            return False\n    return True\n\n\ndef _forward_slide(region_set: set, start: tuple[int, int], dr: int, dc: int,\n                   blocked: set) -> tuple[int, int]:\n    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n    r, c = start\n    while True:\n        if not _slide_step_valid(region_set, r, c, dr, dc):\n            break\n        nr, nc = r + dr, c + dc\n        if (nr, nc) in blocked:\n            break\n        r, c = nr, nc\n    return (r, c)\n\n\n# ── Generator phases ─────────────────────────────────────────────\n\ndef _place_legends(rng: random.Random, grid: np.ndarray,\n                   ) -> tuple[np.ndarray, list[tuple[int, tuple[int,int]]]]:\n    \"\"\"Place 1-2 legend patches at grid corners.\n\n    Returns (legend_occupied mask, list of (wall_color, direction) pairs).\n    \"\"\"\n    h, w = grid.shape\n    n_legends = rng.choice([1, 2])\n    corners = rng.sample(CORNERS, n_legends)\n    wall_colors = rng.sample(WALL_COLOR_CHOICES, n_legends)\n\n    legend_occupied = np.zeros((h, w), dtype=bool)\n    legends = []\n\n    for corner, wc in zip(corners, wall_colors):\n        if rng.random() < CARDINAL_PROB:\n            dr, dc = rng.choice(CARDINAL_DIRS)\n            patch = _legend_5x5(wc, dr, dc)\n        else:\n            dr, dc = rng.choice(DIAGONAL_DIRS)\n            patch = _legend_6x7(wc, dr, dc)\n        ph, pw = patch.shape\n        r0, c0 = _corner_origin(corner, h, w, ph, pw)\n        paste(grid, patch, r0, c0)\n        # Reserve legend cells + buffer.\n        r_lo, r_hi = max(0, r0 - LEGEND_BUFFER), min(h, r0 + ph + LEGEND_BUFFER)\n        c_lo, c_hi = max(0, c0 - LEGEND_BUFFER), min(w, c0 + pw + LEGEND_BUFFER)\n        legend_occupied[r_lo:r_hi, c_lo:c_hi] = True\n        legends.append((wc, (dr, dc)))\n\n    return legend_occupied, legends\n\n\ndef _grow_regions(rng: random.Random, legends: list[tuple[int, tuple[int,int]]],\n                  legend_occupied: np.ndarray,\n                  ) -> list[dict] | None:\n    \"\"\"Grow irregular closed regions, one per assigned wall color.\n\n    Returns list of region dicts or None on failure.\n    \"\"\"\n    h, w = legend_occupied.shape\n    color_dir = {wc: d for wc, d in legends}\n    all_colors = [wc for wc, _ in legends]\n\n    # Assign 1-3 regions per wall color, cap total.\n    region_colors = []\n    for c in all_colors:\n        region_colors.extend([c] * rng.randint(*REGIONS_PER_COLOR))\n    if len(region_colors) > MAX_TOTAL_REGIONS:\n        region_colors = rng.sample(region_colors, MAX_TOTAL_REGIONS)\n    rng.shuffle(region_colors)\n\n    size_min, size_max = REGION_SIZE_BOUNDS[len(region_colors)]\n    occupied = legend_occupied.copy()\n    regions = []\n\n    for rc in region_colors:\n        dr, dc = color_dir[rc]\n        target_size = rng.randint(size_min, size_max)\n\n        # Build canvas: interior cells (not border) that are unoccupied.\n        canvas = np.ones((h, w), dtype=bool)\n        canvas[0, :] = False; canvas[-1, :] = False\n        canvas[:, 0] = False; canvas[:, -1] = False\n        canvas &= ~occupied\n        if not canvas.any():\n            continue\n\n        blob = _try_grow_valid_blob(rng, canvas, occupied, target_size, h, w)\n        if blob is None:\n            continue\n\n        walls = _blob_wall_cells(blob, h, w)\n        regions.append({'color': rc, 'dir': (dr, dc), 'interior': blob, 'walls': walls})\n\n        # Reserve blob + walls + 1-cell buffer around walls.\n        reserve = blob | walls\n        extra = set()\n        for r, c in walls:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in reserve:\n                    extra.add((nr, nc))\n        for r, c in reserve | extra:\n            occupied[r, c] = True\n\n    if not regions:\n        return None\n    # Every legend color must have at least one region.\n    if {reg['color'] for reg in regions} != set(all_colors):\n        return None\n    return regions\n\n\ndef _try_grow_valid_blob(rng: random.Random, canvas: np.ndarray,\n                         occupied: np.ndarray, target_size: int,\n                         h: int, w: int) -> set[tuple[int,int]] | None:\n    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n    for _ in range(BLOB_GROW_RETRIES):\n        free = np.argwhere(canvas)\n        if len(free) == 0:\n            break\n        sr, sc = free[rng.randrange(len(free))]\n        cand = _grow_blob(canvas, (int(sr), int(sc)), target_size, rng)\n        if cand is None:\n            continue\n        # Fill interior holes until stable.\n        while True:\n            filled = _fill_holes(cand, h, w)\n            if filled == cand:\n                break\n            cand = filled\n        # Absorbed cells must stay within canvas.\n        if any(not canvas[r, c] for r, c in cand):\n            continue\n        walls = _blob_wall_cells(cand, h, w)\n        # Walls must not overlap occupied cells or the grid border.\n        if any(occupied[wr, wc] or wr in (0, h - 1) or wc in (0, w - 1)\n               for wr, wc in walls):\n            continue\n        return cand\n    return None\n\n\ndef _validate_topology(grid: np.ndarray, regions: list[dict]) -> bool:\n    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n    h, w = grid.shape\n    labeled, n_comp = label_mask(grid == 0, connectivity=4)\n    bounded = []\n    for comp_id in range(1, n_comp + 1):\n        coords = np.argwhere(labeled == comp_id)\n        if any(r in (0, h - 1) or c in (0, w - 1) for r, c in coords):\n            continue\n        bounded.append({(int(r), int(c)) for r, c in coords})\n    region_sets = [reg['interior'] for reg in regions]\n    if len(bounded) != len(region_sets):\n        return False\n    return all(comp in region_sets for comp in bounded)\n\n\ndef _place_yellows(rng: random.Random, regions: list[dict],\n                   grid: np.ndarray) -> bool:\n    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n\n    Modifies grid in-place by painting yellow(4) at input positions.\n    Returns True on success.\n    \"\"\"\n    for reg in regions:\n        blob = reg['interior']\n        dr, dc = reg['dir']\n        n_yellows = rng.choice(YELLOWS_PER_REGION)\n\n        # Cells sorted by projection onto slide direction (farthest first).\n        cells_sorted = sorted(blob, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n        far_key = dr * cells_sorted[0][0] + dc * cells_sorted[0][1]\n        tier1 = [p for p in cells_sorted if dr * p[0] + dc * p[1] == far_key]\n\n        # Pick output positions: first at the farthest tier, second one step behind or at tier1.\n        first = tier1[rng.randrange(len(tier1))]\n        output_positions = [first]\n\n        if n_yellows == 2:\n            pr, pc = first[0] - dr, first[1] - dc\n            cands = ([(pr, pc)] if (pr, pc) in blob else []) + [p for p in tier1 if p != first]\n            if cands:\n                second = cands[rng.randrange(len(cands))]\n                if second != first:\n                    output_positions.append(second)\n\n        # Reverse-slide: process in solver order (far-to-near).\n        out_sorted = sorted(output_positions, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n        already_stopped = set()\n        yellows_input = []\n\n        for out_pos in out_sorted:\n            candidate = _find_reverse_slide(blob, out_pos, dr, dc, already_stopped,\n                                            yellows_input, rng)\n            if candidate is None:\n                return False\n            yellows_input.append(candidate)\n            already_stopped.add(out_pos)\n\n        for r, c in yellows_input:\n            grid[r, c] = 4\n    return True\n\n\ndef _find_reverse_slide(blob: set, out_pos: tuple[int,int], dr: int, dc: int,\n                        already_stopped: set, existing_inputs: list,\n                        rng: random.Random) -> tuple[int,int] | None:\n    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n    target_steps = rng.randint(1, MAX_SLIDE_STEPS)\n    for steps in range(target_steps, 0, -1):\n        r, c = out_pos\n        path_ok = True\n        for _ in range(steps):\n            pr, pc = r - dr, c - dc\n            if (pr, pc) not in blob or (pr, pc) in already_stopped or (pr, pc) in existing_inputs:\n                path_ok = False\n                break\n            if dr != 0 and dc != 0:\n                if (pr + dr, pc) not in blob or (pr, pc + dc) not in blob:\n                    path_ok = False\n                    break\n            r, c = pr, pc\n        if not path_ok:\n            continue\n        if _forward_slide(blob, (r, c), dr, dc, already_stopped) == out_pos:\n            return (r, c)\n    return None\n\n\ndef _oracle_check(input_grid: np.ndarray, regions: list[dict]) -> bool:\n    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n    h, w = input_grid.shape\n    try:\n        solver_out = main(input_grid)\n    except Exception:\n        return False\n    # Non-yellow, non-bg cells must be identical.\n    struct_mask = (input_grid != 4) & (input_grid != 0)\n    if not np.array_equal(solver_out[struct_mask], input_grid[struct_mask]):\n        return False\n    # Yellow count must be preserved.\n    if (solver_out == 4).sum() != (input_grid == 4).sum():\n        return False\n    # All output yellows must lie inside known region interiors.\n    regions_mask = np.zeros((h, w), dtype=bool)\n    for reg in regions:\n        for r, c in reg['interior']:\n            regions_mask[r, c] = True\n    return bool(np.all(regions_mask[solver_out == 4]))\n\n\n# ── Main generator ────────────────────────────────────────────────\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    h, w = GRID_H, GRID_W\n    grid = np.zeros((h, w), dtype=int)\n\n    legend_occupied, legends = _place_legends(rng, grid)\n    regions = _grow_regions(rng, legends, legend_occupied)\n    if regions is None:\n        return None\n\n    # Paint walls.\n    for reg in regions:\n        for r, c in reg['walls']:\n            grid[r, c] = reg['color']\n\n    if not _validate_topology(grid, regions):\n        return None\n\n    input_grid = grid.copy()\n    if not _place_yellows(rng, regions, input_grid):\n        return None\n    if not _oracle_check(input_grid, regions):\n        return None\n    return input_grid\n\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '172,700p' /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '172,700p' /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Predict the next panel in a framed sequence by continuing each scheduled colored interval.\n\n    Input structure\n    - The grid is made from three or more equal panels in one row or one column.\n    - The final input panel is the static target template; every earlier panel differs from it only by dynamic colors absent from the template.\n    - Each dynamic color appears in a regular temporal schedule across the earlier panels.\n\n    Rule\n    - Keep the final template panel as the output canvas.\n    - For every dynamic color whose schedule reaches the next panel, compare its last two appearances.\n    - Extrapolate each one-dimensional interval along the color's changing row or column axis and paint that predicted mask.\n\n    Key insight\n    - The task is not asking for the last visible panel, but for the next frame after the blank/template slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    panels, diff_colors = _split_panels(g)\n    template = panels[-1]\n    prior = panels[:-1]\n    next_time = len(prior)\n\n    predictions: list[tuple[int, np.ndarray]] = []\n    for color in diff_colors:\n        times = [i for i, panel in enumerate(prior) if np.any(panel == color)]\n        assert len(times) >= 2\n        gaps = [b - a for a, b in zip(times, times[1:])]\n        assert len(set(gaps)) == 1\n        period = gaps[0]\n        if next_time - times[-1] != period:\n            continue\n\n        previous = prior[times[-2]] == color\n        current = prior[times[-1]] == color\n        predictions.append((color, _extrapolate_mask(previous, current)))\n\n    assert predictions\n    occupied = np.zeros_like(template, dtype=bool)\n    for _color, mask in predictions:\n        assert not np.any(occupied & mask)\n        occupied |= mask\n\n    out = template.copy()\n    for color, mask in predictions:\n        out[mask] = color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, orientation, and color sampling.\nPANEL_SIZE_MIN, PANEL_SIZE_MAX = 5, 11\nPANEL_COUNT_CHOICES, ORIENTATION_CHOICES = (3, 5), (False, True)\nCOLOR_POOL, TOTAL_COLOR_CHOICES, MOTION_AXIS_CHOICES = range(10), (4, 5), (0, 1)\n\n# Template decoration density and symmetry.\nTEMPLATE_MIN_DECO_CELLS = 4\nTEMPLATE_DECO_MIN_RATIO, TEMPLATE_DECO_MAX_RATIO = 0.10, 0.30\n\n# Blob motif and growth bounds.\nBLOB_GROWTH_MIN, BLOB_GROWTH_MAX = 1, 4\nBLOB_MAX_INITIAL_CELLS, BLOB_MAX_COMPONENTS = 7, 2\nBLOB_MAX_LINE_COUNT, BLOB_MAX_WIDTH = 3, 3\nBLOB_DIRECTIONS = (-1, 1)\n\n# Dynamic-color schedules.\nSHORT_PRIOR_COUNT, MAX_DYNAMIC_COLORS = 2, 3\nSCHEDULE_ALWAYS_2 = {\"period\": 1, \"times\": [0, 1], \"scheduled\": True}\nSCHEDULE_ALWAYS_4 = {\"period\": 1, \"times\": [0, 1, 2, 3], \"scheduled\": True}\nSCHEDULE_EVEN_4 = {\"period\": 2, \"times\": [0, 2], \"scheduled\": True}\nSCHEDULE_FIRST3_4 = {\"period\": 1, \"times\": [0, 1, 2], \"scheduled\": False}\nSCHEDULE_ODD_4 = {\"period\": 2, \"times\": [1, 3], \"scheduled\": False}\nSCHEDULE_SECOND_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4)\nSCHEDULE_THIRD_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4, SCHEDULE_FIRST3_4, SCHEDULE_ODD_4)\n\n# Placement and retry limits.\nMASK_TRANSPARENT, PLACEMENT_BORDER = 0, 1\nGENERATION_RETRIES = 300\n\ndef _sym_orbits(h: int, w: int) -> list[list[tuple[int, int]]]:\n    seen: set[tuple[int, int]] = set()\n    orbits: list[list[tuple[int, int]]] = []\n    for r in range(h):\n        for c in range(w):\n            if r not in (0, h - 1) and c not in (0, w - 1):\n                continue\n            if (r, c) in seen:\n                continue\n            orbit = sorted({(r, c), (r, w - 1 - c), (h - 1 - r, c), (h - 1 - r, w - 1 - c)})\n            seen.update(orbit)\n            orbits.append(orbit)\n    return orbits\n\n\ndef _make_template(h: int, w: int, bg: int, deco: int) -> np.ndarray:\n    out = np.full((h, w), bg, dtype=int)\n    area = h * w\n    min_deco = max(TEMPLATE_MIN_DECO_CELLS, int(np.ceil(area * TEMPLATE_DECO_MIN_RATIO)))\n    max_deco = max(min_deco, int(np.floor(area * TEMPLATE_DECO_MAX_RATIO)))\n    target = random.randint(min_deco, max_deco)\n    orbits = _sym_orbits(h, w)\n    random.shuffle(orbits)\n    count = 0\n    for orbit in orbits:\n        if count >= target:\n            break\n        if count + len(orbit) > max_deco and count >= min_deco:\n            continue\n        for r, c in orbit:\n            out[r, c] = deco\n        count += len(orbit)\n    return out\n\n\ndef _base_patterns(axis_len: int, line_len: int, max_back: int) -> list[tuple[int, list[list[tuple[int, int]]]]]:\n    patterns: list[tuple[int, list[list[tuple[int, int]]]]] = []\n    for growth in range(BLOB_GROWTH_MIN, BLOB_GROWTH_MAX + 1):\n        extra = max_back * growth\n        max_initial_width = axis_len - extra\n        if max_initial_width < 1:\n            continue\n\n        for lines in range(1, min(BLOB_MAX_LINE_COUNT, line_len) + 1):\n            for width in range(1, min(BLOB_MAX_WIDTH, max_initial_width, BLOB_MAX_INITIAL_CELLS // lines) + 1):\n                patterns.append((growth, [[(0, width - 1)] for _ in range(lines)]))\n\n        if line_len >= 2 and max_initial_width >= 2:\n            for lines in range(2, min(BLOB_MAX_LINE_COUNT + 1, line_len) + 1):\n                width = min(2, max_initial_width)\n                if lines * width <= BLOB_MAX_INITIAL_CELLS and width + 1 + extra <= axis_len:\n                    patterns.append((growth, [[(i % 2, i % 2 + width - 1)] for i in range(lines)]))\n\n        if line_len >= 3 and max_initial_width >= 3:\n            tee = [[(1, 1)], [(0, 2)], [(1, 1)]]\n            if 3 + extra <= axis_len:\n                patterns.append((growth, tee))\n\n        if line_len >= 2:\n            gap = extra + 1\n            if gap + 2 + extra <= axis_len:\n                for lines in range(2, min(BLOB_MAX_LINE_COUNT, line_len) + 1):\n                    split = [[(0, 0), (gap + 1, gap + 1)] for _ in range(lines)]\n                    if 2 * lines <= BLOB_MAX_INITIAL_CELLS:\n                        patterns.append((growth, split))\n    return patterns\n\n\ndef _draw_local(\n    intervals0: list[list[tuple[int, int]]],\n    growth: int,\n    max_back: int,\n    back: int,\n    direction: int,\n    axis: int,\n) -> np.ndarray:\n    grown = max_back - back\n    width = max(end for row in intervals0 for _start, end in row) + max_back * growth + 1\n    local = np.zeros((len(intervals0), width), dtype=bool)\n    for r, row in enumerate(intervals0):\n        for start, end in row:\n            local[r, start : end + grown * growth + 1] = True\n    if direction < 0:\n        local = np.fliplr(local)\n    if axis == 0:\n        local = local.T\n    return local\n\n\ndef _make_blob(axis_len: int, line_len: int, axis: int, max_back: int) -> tuple[int, dict[int, np.ndarray]] | None:\n    patterns = _base_patterns(axis_len, line_len, max_back)\n    if not patterns:\n        return None\n    by_growth: dict[int, list[list[list[tuple[int, int]]]]] = {}\n    for growth, intervals0 in patterns:\n        by_growth.setdefault(growth, []).append(intervals0)\n    growth = random.choice(sorted(by_growth))\n    intervals0 = random.choice(by_growth[growth])\n    direction = random.choice(BLOB_DIRECTIONS)\n    masks = {\n        back: _draw_local(intervals0, growth, max_back, back, direction, axis)\n        for back in range(max_back + 1)\n    }\n    largest = masks[0]\n    if largest.shape[0] > (line_len if axis == 1 else axis_len):\n        return None\n    if largest.shape[1] > (axis_len if axis == 1 else line_len):\n        return None\n    if len(components_mask(masks[max_back], connectivity=4)) > BLOB_MAX_COMPONENTS:\n        return None\n    return growth, masks\n\n\ndef _schedules(n_prior: int, n_colors: int) -> list[dict]:\n    if n_prior == SHORT_PRIOR_COUNT:\n        return [SCHEDULE_ALWAYS_2 for _ in range(n_colors)]\n\n    schedules = [SCHEDULE_ALWAYS_4, random.choice(SCHEDULE_SECOND_CHOICES)]\n    if n_colors == MAX_DYNAMIC_COLORS:\n        schedules.append(random.choice(SCHEDULE_THIRD_CHOICES))\n    return schedules\n\n\ndef _place_masks(\n    occupied: np.ndarray,\n    local_masks: dict[int, np.ndarray],\n) -> dict[int, np.ndarray] | None:\n    largest = local_masks[0]\n    patch = np.where(largest, 1, MASK_TRANSPARENT)\n    try:\n        r0, c0 = random_free_location(\n            occupied, patch, transparent=MASK_TRANSPARENT, border=PLACEMENT_BORDER\n        )\n    except ValueError:\n        return None\n    paste(occupied, patch, r0, c0, transparent=MASK_TRANSPARENT)\n\n    out: dict[int, np.ndarray] = {}\n    for back, local in local_masks.items():\n        full = np.zeros_like(occupied, dtype=bool)\n        full[r0 : r0 + local.shape[0], c0 : c0 + local.shape[1]] = local\n        out[back] = full\n    return out\n\n\ndef _place_dynamic_masks(\n    occupied: np.ndarray,\n    n_dynamic: int,\n    schedules: list[dict],\n    motion_axis: int,\n    n_prior: int,\n    axis_len: int,\n    line_len: int,\n) -> dict[int, dict[int, np.ndarray]] | None:\n    \"\"\"Return full-panel masks by color index, or None if any blob fails.\"\"\"\n    order = list(range(n_dynamic))\n    random.shuffle(order)\n    placed: dict[int, dict[int, np.ndarray]] = {}\n    for idx in order:\n        sched = schedules[idx]\n        if sched[\"scheduled\"]:\n            max_back = max((n_prior - t) // sched[\"period\"] for t in sched[\"times\"])\n        else:\n            last = sched[\"times\"][-1]\n            max_back = max((last - t) // sched[\"period\"] for t in sched[\"times\"])\n\n        blob = _make_blob(axis_len, line_len, motion_axis, max_back)\n        if blob is None:\n            return None\n        _growth, local_masks = blob\n        full_masks = _place_masks(occupied, local_masks)\n        if full_masks is None:\n            return None\n        placed[idx] = full_masks\n    return placed\n\n\ndef _paint_dynamic_masks(\n    panels: list[np.ndarray],\n    output: np.ndarray,\n    dynamic: list[int],\n    schedules: list[dict],\n    placed: dict[int, dict[int, np.ndarray]],\n    n_prior: int,\n) -> None:\n    \"\"\"Mutate prior panels and output with the preplaced dynamic-color masks.\"\"\"\n    for idx, color in enumerate(dynamic):\n        sched = schedules[idx]\n        full_masks = placed[idx]\n        if sched[\"scheduled\"]:\n            for t in sched[\"times\"]:\n                back = (n_prior - t) // sched[\"period\"]\n                panels[t][full_masks[back]] = color\n            output[full_masks[0]] = color\n        else:\n            last = sched[\"times\"][-1]\n            for t in sched[\"times\"]:\n                back = (last - t) // sched[\"period\"]\n                panels[t][full_masks[back]] = color\n\n\ndef _assemble_valid_input(\n    panels: list[np.ndarray],\n    template: np.ndarray,\n    output: np.ndarray,\n    horizontal: bool,\n) -> np.ndarray | None:\n    \"\"\"Return tiled input only when the solver oracle matches planned output.\"\"\"\n    if horizontal:\n        inp = np.concatenate([*panels, template], axis=1)\n    else:\n        inp = np.concatenate([*panels, template], axis=0)\n\n    try:\n        predicted = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(predicted, output):\n        return None\n    return inp\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    h = random.randint(PANEL_SIZE_MIN, PANEL_SIZE_MAX)\n    w = random.randint(PANEL_SIZE_MIN, PANEL_SIZE_MAX)\n    horizontal = random.choice(ORIENTATION_CHOICES)\n    n_panels = random.choice(PANEL_COUNT_CHOICES)\n    n_prior = n_panels - 1\n\n    colors = random.sample(COLOR_POOL, random.choice(TOTAL_COLOR_CHOICES))\n    bg, deco = colors[0], colors[1]\n    dynamic = colors[2:]\n\n    template = _make_template(h, w, bg, deco)\n    occupied = np.where(template == bg, MASK_TRANSPARENT, 1)\n    motion_axis = random.choice(MOTION_AXIS_CHOICES)\n    schedules = _schedules(n_prior, len(dynamic))\n\n    panels = [template.copy() for _ in range(n_prior)]\n    output = template.copy()\n    axis_len = h - 2 if motion_axis == 0 else w - 2\n    line_len = w - 2 if motion_axis == 0 else h - 2\n\n    placed = _place_dynamic_masks(\n        occupied, len(dynamic), schedules, motion_axis, n_prior, axis_len, line_len\n    )\n    if placed is None:\n        return None\n    _paint_dynamic_masks(panels, output, dynamic, schedules, placed, n_prior)\n    return _assemble_valid_input(panels, template, output, horizontal)\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
