{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/21897d95.py',\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n'/home/lixinyu/snap/new/ARC_code/train/bc93ec48.py',\n'/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n'/home/lixinyu/snap/new/ARC_code/train/465b7d93.py',\n'/home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py',\n'/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py',\n'/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py',\n]\nfor path in files[:4]:\n    text = Path(path).read_text()\n    print(f'===== {path} =====')\n    for name in ['def main(', 'def generate_input(']:\n        idx = text.find(name)\n        if idx == -1:\n            continue\n        start = text.rfind('\\\\n', 0, idx)\n        end = text.find('\\\\ndef ', idx + 1)\n        if end == -1:\n            end = len(text)\n        print(text[start+1:end].strip())\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/21897d95.py',\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n'/home/lixinyu/snap/new/ARC_code/train/bc93ec48.py',\n'/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n'/home/lixinyu/snap/new/ARC_code/train/465b7d93.py',\n'/home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py',\n'/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py',\n'/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py',\n]\nfor path in files[:4]:\n    text = Path(path).read_text()\n    print(f'===== {path} =====')\n    for name in ['def main(', 'def generate_input(']:\n        idx = text.find(name)\n        if idx == -1:\n            continue\n        start = text.rfind('\\\\n', 0, idx)\n        end = text.find('\\\\ndef ', idx + 1)\n        if end == -1:\n            end = len(text)\n        print(text[start+1:end].strip())\n        print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/21897d95.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.\n\n    Input structure:\n    - The grid is a mosaic of monochrome regions.\n    - Color 1 forms T-shaped control markers on region boundaries.\n    - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.\n    - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.\n\n    Rule:\n    - For a color-1 T marker, the single stem points at the destination region to repaint.\n    - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.\n    - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.\n    - All marker cells are filled with the final color of the source-side region.\n    - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.\n\n    Key insight:\n    - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = _solve_unrotated(g)\n    l9 = _find_l9_orientation(g)\n    if l9 == 'top_right':\n        return np.rot90(out, 1)\n    if l9 == 'top_left':\n        return np.rot90(out, 3)\n    return out\n\n# --------------- generator (l9rot) ---------------\n\n# ── Tunable constants ──────────────────────────────────────────────────\n# Canvas / region sizing\nGRID_SIZE_MAX = 30                          # max rows or cols\nMIN_REGION_CELLS = 6                        # per-spec minimum\nREGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)\nREGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts\nREGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS\n\n# Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)\nMARKER_MIN = 4\nMARKER_MAX = 8\nNORMAL_MAX = 6\nCOLORED_MAX = 2\n\n# Color pool (all ARC colors except 1, which is reserved for T-marker cells)\nCOLOR_POOL = [c for c in range(10) if c != 1]\n\n# L9 rotation marker\nL9_PROBABILITY = 0.5                        # chance of placing a rotation marker\nL9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation\n    'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],\n    'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],\n}\n\n# Generation retry budget\nSEED_ATTEMPTS = 200                         # tries to place n distinct region seeds\nGEN_RETRIES = 300                           # outer generate_input retry budget\n\n_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n# ── Small geometry helpers ─────────────────────────────────────────────\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/bc93ec48.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Copy each foreground object anchored in a true grid corner clockwise into the next corner.\n\n    Input structure\n    - The dominant color is the background.\n    - Foreground objects are monochromatic 4-connected components.\n    - Relevant objects are exactly those whose bounding box touches two adjacent borders at one grid corner.\n\n    Rule\n    - Start from the input unchanged.\n    - For each corner object, copy its pixel mask and color to the next corner clockwise: top-left to top-right, top-right to bottom-right, bottom-right to bottom-left, and bottom-left to top-left.\n    - Preserve each object's orientation by aligning its bounding box to the destination corner; stamps may overwrite existing pixels at the destination, but source pixels are not cleared.\n\n    Key insight\n    - Interior and side-only objects are distractors; only components actually anchored to a corner participate in the clockwise perimeter copy.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n    bg = get_bg(g)\n\n    by_corner: dict[Corner, dict] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        corner = _bbox_corner(comp[\"bbox\"], height, width)\n        if corner is None:\n            continue\n        assert corner not in by_corner, \"expected at most one source object per corner\"\n        by_corner[corner] = comp\n\n    assert by_corner, \"expected at least one corner-anchored object\"\n\n    out = g.copy()\n    planned: dict[tuple[int, int], int] = {}\n    for src_corner, comp in by_corner.items():\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        obj_h = int(r1 - r0 + 1)\n        obj_w = int(c1 - c0 + 1)\n        dst_corner = _NEXT_CORNER[src_corner]\n        dst_r0, dst_c0 = _corner_anchor(dst_corner, height, width, obj_h, obj_w)\n        color = int(comp[\"color\"])\n\n        for r_raw, c_raw in comp[\"coords\"]:\n            r = int(dst_r0 + int(r_raw) - r0)\n            c = int(dst_c0 + int(c_raw) - c0)\n            assert 0 <= r < height and 0 <= c < width, \"corner stamp must remain in bounds\"\n            assert (r, c) not in planned, \"expected non-overlapping corner stamps\"\n            planned[(r, c)] = color\n\n    for (r, c), color in planned.items():\n        out[r, c] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_BG = 7\n_GEN_MIN_SIZE, _GEN_MAX_SIZE = 8, 16\n_GEN_CORNERS = (\"TL\", \"TR\", \"BR\", \"BL\")\n_GEN_NEXT = {\"TL\": \"TR\", \"TR\": \"BR\", \"BR\": \"BL\", \"BL\": \"TL\"}\n_GEN_COLORS = (1, 2, 3, 4, 5, 6, 8, 9)\n\n_GEN_CORNER_COUNT_MIN, _GEN_CORNER_COUNT_MAX = 3, 4\n_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX = 1, 4\n_GEN_CORNER_MIN_PIXELS, _GEN_CORNER_MAX_PIXELS = 2, 12\n_GEN_CORNER_MIN_DENSITY = 0.62\n_GEN_SMALL_FULL_AREA_MAX, _GEN_SMALL_FULL_PROB = 12, 0.45\n_GEN_CORNER_DIMS = tuple(\n    (h, w)\n    for h in range(_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX + 1)\n    for w in range(_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX + 1)\n    if not (h == 1 and w == 1)\n)\n\n_GEN_BLOB_PIXELS_MIN, _GEN_BLOB_PIXELS_MAX = 1, 5\n_GEN_BLOB_H_MIN, _GEN_BLOB_H_MAX = 1, 5\n_GEN_BLOB_W_MIN, _GEN_BLOB_W_MAX = 1, 4\n_GEN_DISTRACTOR_BASE_COUNT = 4\n_GEN_DISTRACTOR_SIZE_SPAN = 8\n_GEN_DISTRACTOR_EXTRA_MAX, _GEN_DISTRACTOR_MIN_GAP = 10, 6\n\n_GEN_RETRY_LIMIT = 300\n_GEN_NEIGHBORS_4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid bc93ec48 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\n\n","exit_code":0,"status":"completed"}}
