{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/a/des/code/combo_new/seed1852178230/11/4.py | sed -n '1,260p'\"","aggregated_output":"     1\timport random\n     2\tfrom collections import Counter\n     3\t\n     4\timport numpy as np\n     5\t\n     6\t\n     7\tBG = 0\n     8\tDIVIDER = 5\n     9\tPALETTE = (1, 2, 3, 4, 6, 7, 8, 9)\n    10\tSIDE_OPTIONS = (3, 5)\n    11\tGEN_ATTEMPTS = 300\n    12\t\n    13\t\n    14\tdef get_bg(grid: np.ndarray) -> int:\n    15\t    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])\n    16\t\n    17\t\n    18\tdef rotate_offsets(offsets, turns: int):\n    19\t    turns = int(turns) % 4\n    20\t    out = {(int(dr), int(dc)) for dr, dc in offsets}\n    21\t    for _ in range(turns):\n    22\t        out = {(-dc, dr) for dr, dc in out}\n    23\t    return frozenset(out)\n    24\t\n    25\t\n    26\tdef _find_separator_row(grid: np.ndarray) -> tuple[int, int]:\n    27\t    candidates = []\n    28\t    for r in range(grid.shape[0]):\n    29\t        row = grid[r]\n    30\t        if np.all(row == row[0]):\n    31\t            candidates.append((r, int(row[0])))\n    32\t    assert len(candidates) == 1, \"expected exactly one full-width separator row\"\n    33\t    return candidates[0]\n    34\t\n    35\t\n    36\tdef _find_canvas_ranges(lower: np.ndarray, divider_color: int) -> tuple[list[tuple[int, int]], list[int]]:\n    37\t    sep_cols = [c for c in range(lower.shape[1]) if np.all(lower[:, c] == divider_color)]\n    38\t    assert len(sep_cols) == 3, \"expected three vertical separator columns\"\n    39\t    ranges = [\n    40\t        (0, sep_cols[0]),\n    41\t        (sep_cols[0] + 1, sep_cols[1]),\n    42\t        (sep_cols[1] + 1, sep_cols[2]),\n    43\t        (sep_cols[2] + 1, lower.shape[1]),\n    44\t    ]\n    45\t    return ranges, sep_cols\n    46\t\n    47\t\n    48\tdef _extract_color_offsets(square: np.ndarray, bg: int, divider_color: int) -> dict[int, frozenset[tuple[int, int]]]:\n    49\t    n = square.shape[0]\n    50\t    center = n // 2\n    51\t    assert square.shape[0] == square.shape[1] and n % 2 == 1\n    52\t    assert int(square[center, center]) == divider_color\n    53\t\n    54\t    color_offsets: dict[int, frozenset[tuple[int, int]]] = {}\n    55\t    for color in sorted(int(c) for c in np.unique(square)):\n    56\t        if color in (bg, divider_color):\n    57\t            continue\n    58\t        coords = np.argwhere(square == color)\n    59\t        assert coords.size > 0\n    60\t        offsets = frozenset((int(r - center), int(c - center)) for r, c in coords)\n    61\t        assert offsets\n    62\t        color_offsets[color] = offsets\n    63\t\n    64\t    assert len(color_offsets) == 4, \"expected exactly four encoded colors\"\n    65\t    first_offsets = next(iter(color_offsets.values()))\n    66\t    rotated_family = {rotate_offsets(first_offsets, k) for k in range(4)}\n    67\t    assert rotated_family == set(color_offsets.values()), \"encoded colors must be quarter-turn copies\"\n    68\t    return color_offsets\n    69\t\n    70\t\n    71\tdef main(grid: np.ndarray) -> np.ndarray:\n    72\t    \"\"\"\n    73\t    Decode a four-way rotational color code and render the requested rotated shape in each target canvas.\n    74\t\n    75\t    Input structure:\n    76\t    - The background is black. A single full-width grey row splits the grid into an upper code panel and a lower strip of four canvases.\n    77\t    - The upper panel has odd height and contains one odd-sized square code window whose center cell is grey; four non-grey colors occupy quarter-turn-related pixel sets around that center.\n    78\t    - The lower panel has the same height as the code window side length and consists of four equal square canvases separated by grey columns; each canvas is otherwise black except for a one-pixel color marker at its top-left corner.\n    79\t\n    80\t    Rule:\n    81\t    - Read the colored pixels in the upper square as four rotated versions of one hidden shape, keyed by color.\n    82\t    - For each lower canvas, use its top-left marker color to select the matching rotated pixel set from the upper code window.\n    83\t    - Output only the lower strip: keep the grey separator columns, clear the marker pixels, place the selected color pattern centered in each canvas, and paint the grey center cell of every canvas.\n    84\t\n    85\t    Key insight:\n    86\t    - The four colors in the upper panel do not denote four different objects; they are the same offset pattern under 90-degree rotations, so the marker color simply selects which rotated offset set must be copied into a blank target canvas.\n    87\t    \"\"\"\n    88\t    g = np.asarray(grid, dtype=int)\n    89\t    assert g.ndim == 2\n    90\t\n    91\t    bg = get_bg(g)\n    92\t    sep_r, divider_color = _find_separator_row(g)\n    93\t    top = g[:sep_r, :]\n    94\t    lower = g[sep_r + 1 :, :]\n    95\t    assert top.shape[0] == lower.shape[0] and top.shape[0] % 2 == 1\n    96\t\n    97\t    n = int(lower.shape[0])\n    98\t    radius = n // 2\n    99\t    canvas_ranges, sep_cols = _find_canvas_ranges(lower, divider_color)\n   100\t    assert all((c1 - c0) == n for c0, c1 in canvas_ranges), \"lower canvases must be square\"\n   101\t\n   102\t    center_positions = np.argwhere(top == divider_color)\n   103\t    assert center_positions.shape[0] == 1, \"expected one grey rotation center in the upper panel\"\n   104\t    cr, cc = map(int, center_positions[0])\n   105\t    assert cr == radius\n   106\t    assert radius <= cc < g.shape[1] - radius\n   107\t    assert np.all(top[:, : cc - radius] == bg)\n   108\t    assert np.all(top[:, cc + radius + 1 :] == bg)\n   109\t\n   110\t    square = top[:, cc - radius : cc + radius + 1]\n   111\t    assert square.shape == (n, n)\n   112\t    color_offsets = _extract_color_offsets(square, bg, divider_color)\n   113\t\n   114\t    out = np.full(lower.shape, bg, dtype=int)\n   115\t    for sep_c in sep_cols:\n   116\t        out[:, sep_c] = divider_color\n   117\t\n   118\t    for c0, c1 in canvas_ranges:\n   119\t        canvas = lower[:, c0:c1]\n   120\t        marker_color = int(canvas[0, 0])\n   121\t        assert marker_color not in (bg, divider_color)\n   122\t        assert marker_color in color_offsets\n   123\t\n   124\t        blank_check = canvas.copy()\n   125\t        blank_check[0, 0] = bg\n   126\t        assert np.all(blank_check == bg), \"input canvases should contain only the marker pixel\"\n   127\t\n   128\t        out_canvas = out[:, c0:c1]\n   129\t        out_canvas[radius, radius] = divider_color\n   130\t        for dr, dc in color_offsets[marker_color]:\n   131\t            rr = radius + int(dr)\n   132\t            cc2 = radius + int(dc)\n   133\t            assert 0 <= rr < n and 0 <= cc2 < n\n   134\t            assert out_canvas[rr, cc2] in (bg, marker_color)\n   135\t            out_canvas[rr, cc2] = marker_color\n   136\t\n   137\t    return out\n   138\t\n   139\t\n   140\tdef _canonical_positions(radius: int) -> list[tuple[int, int]]:\n   141\t    pts = []\n   142\t    for dr in range(-radius, radius + 1):\n   143\t        for dc in range(-radius, radius + 1):\n   144\t            if dr == 0 and dc == 0:\n   145\t                continue\n   146\t            if dr < 0 and dc >= 0:\n   147\t                pts.append((dr, dc))\n   148\t    return pts\n   149\t\n   150\t\n   151\tdef _neighbors8(a: tuple[int, int], b: tuple[int, int]) -> bool:\n   152\t    return max(abs(a[0] - b[0]), abs(a[1] - b[1])) == 1\n   153\t\n   154\t\n   155\tdef _random_base_offsets(side: int) -> frozenset[tuple[int, int]]:\n   156\t    radius = side // 2\n   157\t    pts = _canonical_positions(radius)\n   158\t    assert len(pts) >= 2\n   159\t    size_lo = 1 if side == 3 else 2\n   160\t    size_hi = min(len(pts), 3 if side == 3 else 6)\n   161\t\n   162\t    for _ in range(80):\n   163\t        target = random.randint(size_lo, size_hi)\n   164\t        shape = {random.choice(pts)}\n   165\t        while len(shape) < target:\n   166\t            frontier = [p for p in pts if p not in shape and any(_neighbors8(p, q) for q in shape)]\n   167\t            if not frontier:\n   168\t                break\n   169\t            shape.add(random.choice(frontier))\n   170\t        if len(shape) < size_lo:\n   171\t            continue\n   172\t        return frozenset(shape)\n   173\t\n   174\t    raise RuntimeError(\"failed to build a non-degenerate base shape\")\n   175\t\n   176\t\n   177\tdef _build_input(\n   178\t    side: int,\n   179\t    base_offsets: frozenset[tuple[int, int]],\n   180\t    color_to_turn: dict[int, int],\n   181\t    marker_order: list[int],\n   182\t    center_col: int,\n   183\t) -> np.ndarray:\n   184\t    width = 4 * side + 3\n   185\t    height = 2 * side + 1\n   186\t    radius = side // 2\n   187\t\n   188\t    grid = np.full((height, width), BG, dtype=int)\n   189\t    grid[side, :] = DIVIDER\n   190\t\n   191\t    for color, turns in color_to_turn.items():\n   192\t        for dr, dc in rotate_offsets(base_offsets, turns):\n   193\t            rr = radius + int(dr)\n   194\t            cc = center_col + int(dc)\n   195\t            assert 0 <= rr < side and 0 <= cc < width\n   196\t            assert grid[rr, cc] == BG\n   197\t            grid[rr, cc] = int(color)\n   198\t    grid[radius, center_col] = DIVIDER\n   199\t\n   200\t    sep_cols = [side, 2 * side + 1, 3 * side + 2]\n   201\t    lower = grid[side + 1 :, :]\n   202\t    for c in sep_cols:\n   203\t        lower[:, c] = DIVIDER\n   204\t\n   205\t    starts = [0, side + 1, 2 * (side + 1), 3 * (side + 1)]\n   206\t    for color, c0 in zip(marker_order, starts):\n   207\t        lower[0, c0] = int(color)\n   208\t\n   209\t    return grid\n   210\t\n   211\t\n   212\tdef _gen_attempt() -> np.ndarray | None:\n   213\t    side = random.choice(SIDE_OPTIONS)\n   214\t    width = 4 * side + 3\n   215\t    radius = side // 2\n   216\t\n   217\t    colors = random.sample(PALETTE, 4)\n   218\t    turns = [0, 1, 2, 3]\n   219\t    random.shuffle(turns)\n   220\t    color_to_turn = {color: turn for color, turn in zip(colors, turns)}\n   221\t    marker_order = random.sample(colors, len(colors))\n   222\t    center_col = random.randint(radius, width - radius - 1)\n   223\t    base_offsets = _random_base_offsets(side)\n   224\t\n   225\t    grid = _build_input(side, base_offsets, color_to_turn, marker_order, center_col)\n   226\t    try:\n   227\t        out = main(grid)\n   228\t    except AssertionError:\n   229\t        return None\n   230\t\n   231\t    expected_shape = (side, width)\n   232\t    if out.shape != expected_shape:\n   233\t        return None\n   234\t    return grid\n   235\t\n   236\t\n   237\tdef generate_input() -> np.ndarray:\n   238\t    for _ in range(GEN_ATTEMPTS):\n   239\t        grid = _gen_attempt()\n   240\t        if grid is not None:\n   241\t            return grid\n   242\t    raise RuntimeError(\"failed to generate a valid input\")\n","exit_code":0,"status":"completed"}}
