{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/6350f1f4.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, colors_present, components_mask\nimport math\nimport random\n\n\nERASED = Color.GREY\nSEPARATOR = Color.BLACK\n\n\ndef _is_separator_line(line: np.ndarray) -> bool:\n    return set(map(int, line)).issubset({SEPARATOR, ERASED})\n\n\ndef _regular_intervals(separators: list[int], length: int) -> list[tuple[int, int]]:\n    assert separators, \"expected at least one separator line\"\n    bounds = [-1, *separators, int(length)]\n    intervals = [(bounds[i] + 1, bounds[i + 1]) for i in range(len(bounds) - 1)]\n    sizes = [end - start for start, end in intervals]\n    assert min(sizes) > 0, \"separators must leave non-empty blocks\"\n    assert len(set(sizes)) == 1, \"all encoded blocks must have the same size\"\n    return intervals\n\n\ndef _find_sprite(\n    g: np.ndarray,\n    row_intervals: list[tuple[int, int]],\n    col_intervals: list[tuple[int, int]],\n    payload_colors: list[int],\n) -> np.ndarray:\n    payload = set(payload_colors)\n    sprites = []\n\n    for r0, r1 in row_intervals:\n        for c0, c1 in col_intervals:\n            block = g[r0:r1, c0:c1]\n            block_colors = set(colors_present(block, exclude={ERASED}))\n            assert SEPARATOR not in block_colors, \"block interiors cannot contain separator color\"\n            if ERASED not in set(map(int, block.flat)) and block_colors == payload:\n                sprites.append(block.copy())\n\n    assert sprites, \"expected at least one fully visible sprite block\"\n    sprite = sprites[0]\n    for candidate in sprites:\n        assert np.array_equal(candidate, sprite), \"fully visible sprite blocks must match\"\n    return sprite\n\n\ndef _foreground_and_blank(sprite: np.ndarray, payload_colors: list[int]) -> tuple[int, int]:\n    counts = {color: int(np.count_nonzero(sprite == color)) for color in payload_colors}\n    assert counts[payload_colors[0]] != counts[payload_colors[1]], \"sprite colors must have a majority/minority split\"\n    foreground = max(payload_colors, key=lambda color: counts[color])\n    blank_colors = [color for color in payload_colors if color != foreground]\n    assert len(blank_colors) == 1\n    return int(foreground), int(blank_colors[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Decode a block-grid image by swapping each sprite-coded cell with a solid cell and each blank cell with the sprite.\n\n    Input structure\n    The grid is partitioned by black separator rows and columns into equal-size\n    square blocks. Each block is either a copy of one two-color sprite or a\n    uniform blank block of the sprite's minority color; grey pixels are erased\n    cells that act as wildcards.\n\n    Rule\n    Infer the repeated sprite from fully visible mixed-color blocks. Replace a\n    block matching that sprite, ignoring grey erasures, with a solid block of\n    the sprite's majority color. Replace a uniform blank block with the sprite.\n    Separator rows and columns, including grey erasures on them, become black.\n\n    Key insight\n    The small sprite is a block-level code for one macro-cell state, and the\n    uniform minority-color block is the other state; the output renders the\n    opposite code in each macro-cell while cleaning erased pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n\n    row_separators = [r for r in range(H) if _is_separator_line(g[r, :])]\n    col_separators = [c for c in range(W) if _is_separator_line(g[:, c])]\n    row_intervals = _regular_intervals(row_separators, H)\n    col_intervals = _regular_intervals(col_separators, W)\n    block_heights = {r1 - r0 for r0, r1 in row_intervals}\n    block_widths = {c1 - c0 for c0, c1 in col_intervals}\n    assert block_heights == block_widths, \"encoded blocks must be square\"\n\n    payload_colors = colors_present(g, exclude={SEPARATOR, ERASED})\n    assert len(payload_colors) == 2, \"expected exactly two non-separator payload colors\"\n    sprite = _find_sprite(g, row_intervals, col_intervals, payload_colors)\n    foreground, blank = _foreground_and_blank(sprite, payload_colors)\n\n    out = np.zeros_like(g)\n    for r0, r1 in row_intervals:\n        for c0, c1 in col_intervals:\n            block = g[r0:r1, c0:c1]\n            known = block != ERASED\n            assert known.any(), \"each block must expose at least one non-grey cell\"\n            matches_sprite = bool(np.all(block[known] == sprite[known]))\n            matches_blank = bool(np.all(block[known] == blank))\n            assert matches_sprite != matches_blank, \"each block must unambiguously match the sprite or blank state\"\n            out[r0:r1, c0:c1] = foreground if matches_sprite else sprite\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette bounds.\nGRID_COUNT_RANGE, BLOCK_SIZE_RANGE = (2, 4), (2, 4)\nPAYLOAD_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\nPAYLOAD_COLOR_COUNT = 2\nGEN_SEPARATOR_COLOR, GEN_ERASED_COLOR = int(SEPARATOR), int(ERASED)\n\n# Sprite composition constraints.\nSPRITE_FG_MIN_RATIO, SPRITE_FG_MAX_RATIO = (2, 3), (3, 4)\nSPRITE_ATTEMPTS, TINY_BLOCK_SIZE = 80, 2\n\n# Macro-cell state constraints.\nMIN_BLANK_BLOCKS, MAX_BLANK_BLOCK_DENOMINATOR = 1, 2\n\n# Grey overlay constraints.\nGREY_MIN_FRACTION, GREY_MAX_FRACTION = 0.05, 0.25\nGREY_TWO_COMPONENT_PROBABILITY, GREY_TWO_COMPONENT_ATTEMPTS = 0.5, 30\nGREY_CONNECTIVITY, GENERATION_ATTEMPTS = 4, 300\n\nNEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _separator_indices(n: int, block_size: int) -> set[int]:\n    return {(i + 1) * block_size + i for i in range(n - 1)}\n\n\ndef _block_origin(br: int, bc: int, block_size: int) -> tuple[int, int]:\n    return br * (block_size + 1), bc * (block_size + 1)\n\n\ndef _has_symmetry(mask: np.ndarray) -> bool:\n    return (\n        np.array_equal(mask, np.fliplr(mask))\n        or np.array_equal(mask, np.flipud(mask))\n        or np.array_equal(mask, np.rot90(mask, 2))\n    )\n\n\ndef _make_sprite(block_size: int, foreground: int, blank: int) -> np.ndarray | None:\n    area = block_size * block_size\n    min_num, min_den = SPRITE_FG_MIN_RATIO\n    max_num, max_den = SPRITE_FG_MAX_RATIO\n    fg_min = math.ceil(area * min_num / min_den)\n    fg_max = math.floor(area * max_num / max_den)\n    if fg_min > fg_max:\n        fg_min = fg_max = round(area * min_num / min_den)\n    fg_count = random.randint(fg_min, fg_max)\n    blank_count = area - fg_count\n\n    for _ in range(SPRITE_ATTEMPTS):\n        mask = np.ones((block_size, block_size), dtype=bool)\n        if block_size == TINY_BLOCK_SIZE:\n            blanks = [random.randrange(area)]\n        else:\n            cols = list(range(block_size))\n            random.shuffle(cols)\n            blanks = [r * block_size + cols[r] for r in range(block_size)]\n            extra = blank_count - block_size\n            if extra > 0:\n                pool = [i for i in range(area) if i not in blanks]\n                blanks.extend(random.sample(pool, extra))\n\n        for idx in blanks:\n            mask[idx // block_size, idx % block_size] = False\n\n        if block_size > TINY_BLOCK_SIZE:\n            row_mixed = all(0 < np.count_nonzero(mask[r]) < block_size for r in range(block_size))\n            col_mixed = all(0 < np.count_nonzero(mask[:, c]) < block_size for c in range(block_size))\n            if not row_mixed or not col_mixed:\n                continue\n        if _has_symmetry(mask):\n            continue\n\n        sprite = np.where(mask, foreground, blank).astype(int)\n        return sprite\n    return None\n\n\ndef _neighbors4(r: int, c: int, height: int, width: int):\n    for dr, dc in NEIGHBOR_OFFSETS_4:\n        nr, nc = r + dr, c + dc\n        if 0 <= nr < height and 0 <= nc < width:\n            yield nr, nc\n\n\ndef _grow_blob(allowed: np.ndarray, size: int) -> set[tuple[int, int]] | None:\n    comps = [\n        [tuple(map(int, rc)) for rc in coords]\n        for coords in components_mask(allowed, connectivity=GREY_CONNECTIVITY)\n        if len(coords) >= size\n    ]\n    if not comps:\n        return None\n\n    comp = random.choice(comps)\n    comp_set = set(comp)\n    seed = random.choice(comp)\n    blob = {seed}\n    frontier = {nb for nb in _neighbors4(*seed, *allowed.shape) if nb in comp_set}\n\n    while len(blob) < size:\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        blob.add(cell)\n        for nb in _neighbors4(*cell, *allowed.shape):\n            if nb in comp_set and nb not in blob:\n                frontier.add(nb)\n\n    return blob\n\n\ndef _make_grey_mask(allowed: np.ndarray, target: int) -> np.ndarray | None:\n    if target <= 0:\n        return np.zeros_like(allowed, dtype=bool)\n\n    want_two = target >= 2 and random.random() < GREY_TWO_COMPONENT_PROBABILITY\n    if want_two:\n        for _ in range(GREY_TWO_COMPONENT_ATTEMPTS):\n            first_size = random.randint(1, target - 1)\n            first = _grow_blob(allowed, first_size)\n            if first is None:\n                continue\n\n            blocked = set(first)\n            for r, c in tuple(first):\n                blocked.update(_neighbors4(r, c, *allowed.shape))\n\n            allowed_second = allowed.copy()\n            for r, c in blocked:\n                allowed_second[r, c] = False\n\n            second = _grow_blob(allowed_second, target - first_size)\n            if second is None:\n                continue\n\n            mask = np.zeros_like(allowed, dtype=bool)\n            for r, c in first | second:\n                mask[r, c] = True\n            return mask\n\n    one = _grow_blob(allowed, target)\n    if one is None:\n        return None\n\n    mask = np.zeros_like(allowed, dtype=bool)\n    for r, c in one:\n        mask[r, c] = True\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/f0f8a26d.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, find_components, get_bg\nimport random\n\n\ndef _rotated_bar_coords(coords: np.ndarray) -> list[tuple[int, int]]:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    height = r1 - r0 + 1\n    width = c1 - c0 + 1\n    area = int(coords.shape[0])\n\n    assert height == 1 or width == 1\n    length = max(height, width)\n    assert area == length\n    assert length % 2 == 1\n\n    cr = (r0 + r1) // 2\n    cc = (c0 + c1) // 2\n    half = length // 2\n\n    if length == 1:\n        return [(cr, cc)]\n    if height == 1:\n        return [(r, cc) for r in range(cr - half, cr + half + 1)]\n    return [(cr, c) for c in range(cc - half, cc + half + 1)]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate every foreground bar 90 degrees around its own center on the same canvas.\n\n    Input structure\n    The background is the dominant color, and all foreground pixels share one color.\n    Each 4-connected foreground object is a solid one-cell-thick horizontal or vertical\n    bar with odd length, with single-pixel bars allowed.\n\n    Rule\n    Clear the canvas to the background, then redraw every bar with its midpoint, length,\n    and color preserved while swapping horizontal and vertical orientation.\n\n    Key insight\n    The bars are independent objects: their centers and lengths identify the output\n    placement, so no matching, ordering, or global symmetry is needed.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n\n    out = np.full_like(g, bg)\n    h, w = g.shape\n    components = find_components(\n        g,\n        bg=bg,\n        connectivity=4,\n        monochromatic=True,\n        colors=fg_colors,\n    )\n    assert components\n\n    for comp in components:\n        color = int(comp[\"color\"])\n        for r, c in _rotated_bar_coords(comp[\"coords\"]):\n            assert 0 <= r < h and 0 <= c < w\n            assert out[r, c] == bg\n            out[r, c] = color\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# Palette and canvas options.\nBG_COLOR = 7\nFG_COLORS = tuple(c for c in range(10) if c != BG_COLOR)\nGRID_SIDES = (9, 11, 13)\n\n# Bar counts and weighted odd-length sampling.\nMIN_BARS, EXTRA_LENGTH_CANDIDATES = 5, 5\nMAX_BARS_BY_SIDE = {9: 6, 11: 8, 13: 10}\nLENGTH_WEIGHT_BY_SIZE = {1: 8, 3: 56, 5: 26, 7: 6, 9: 3}\nDEFAULT_LENGTH_WEIGHT = 1\nORIENTATIONS = (\"H\", \"V\")\n\n# Retry and placement search limits.\nOUTER_ATTEMPTS, INNER_ATTEMPTS = 10, 50\nCENTER_TRIAL_LIMIT = 80\n\ndef _sample_lengths(N, K):\n    possible_lengths = list(range(1, N + 1, 2))\n    weights = [LENGTH_WEIGHT_BY_SIZE.get(l, DEFAULT_LENGTH_WEIGHT) for l in possible_lengths]\n    lengths = random.choices(possible_lengths, weights=weights, k=K + EXTRA_LENGTH_CANDIDATES)\n    lengths.sort(reverse=True)\n    return lengths\n\ndef _bar_pixels(cr, cc, length, orient):\n    half = length // 2\n    if orient == \"H\":\n        return {(cr, cc + d) for d in range(-half, half + 1)}\n    return {(cr + d, cc) for d in range(-half, half + 1)}\n\ndef _place_one_bar(N, length, occupied):\n    \"\"\"Return input pixels for one placed bar, mutating occupied on success.\"\"\"\n    half = length // 2\n    lo, hi = half, N - 1 - half\n    if lo > hi:\n        return None\n    orient = random.choice(ORIENTATIONS)\n    out_orient = \"V\" if orient == \"H\" else \"H\"\n    candidates = [(r, c) for r in range(lo, hi + 1) for c in range(lo, hi + 1)]\n    random.shuffle(candidates)\n\n    for cr, cc in candidates[:CENTER_TRIAL_LIMIT]:\n        inp_pixels = _bar_pixels(cr, cc, length, orient)\n        out_pixels = _bar_pixels(cr, cc, length, out_orient)\n        footprint = inp_pixels | out_pixels\n        if footprint & occupied:\n            continue\n        occupied |= footprint\n        return inp_pixels\n    return None\n\ndef _place_bars(N, K):\n    occupied = set()\n    bars_input = []\n    for length in _sample_lengths(N, K):\n        if len(bars_input) >= K:\n            break\n        inp_pixels = _place_one_bar(N, length, occupied)\n        if inp_pixels is not None:\n            bars_input.append(inp_pixels)\n    return bars_input if len(bars_input) >= K else None\n\ndef _gen_attempt(N: int, K: int) -> np.ndarray | None:\n    fg = random.choice(FG_COLORS)\n    bars_input = _place_bars(N, K)\n    if bars_input is None:\n        return None\n\n    grid = np.full((N, N), BG_COLOR, dtype=int)\n    for bar_pixels in bars_input:\n        for r, c in bar_pixels:\n            grid[r, c] = fg\n\n    try:\n        main(grid)\n    except Exception:\n        return None\n    return grid\n\ndef generate_input() -> np.ndarray:\n    for _outer in range(OUTER_ATTEMPTS):\n        N = random.choice(GRID_SIDES)\n        K = random.randint(MIN_BARS, MAX_BARS_BY_SIDE[N])\n        for _ in range(INNER_ATTEMPTS):\n            result = _gen_attempt(N, K)\n            if result is not None:\n                return result\n    raise RuntimeError(\"Failed to generate valid input after many attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/e729b7be.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the scene by adding the point-reflected copy of the colored object across the central marker.\n\n    Input structure\n    - The grid has odd dimensions, a dominant background, and a center-row marker color appearing only at the left edge, center, and right edge.\n    - A single divider color fills the center column except for the center marker.\n    - All remaining foreground pixels form the object to copy, entirely on the left side of the divider.\n    Rule\n    - Keep the input unchanged.\n    - For every object pixel, paint the pixel rotated 180 degrees around the center marker with the same color.\n    Key insight\n    - The center marker is the rotation center; the yellow-looking divider is not mirrored, it only separates the source from the empty target side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h % 2 == 1 and w % 2 == 1\n\n    cr, cc = h // 2, w // 2\n    bg = int(get_bg(g))\n\n    marker_color = int(g[cr, cc])\n    assert marker_color != bg\n    marker_mask = g == marker_color\n    expected_markers = np.zeros(g.shape, dtype=bool)\n    expected_markers[cr, 0] = True\n    expected_markers[cr, cc] = True\n    expected_markers[cr, w - 1] = True\n    assert np.array_equal(marker_mask, expected_markers)\n\n    center_col = g[:, cc]\n    divider_colors = {int(color) for color in np.unique(center_col) if int(color) != marker_color}\n    assert len(divider_colors) == 1\n    divider_color = next(iter(divider_colors))\n    assert divider_color != bg\n    expected_divider = np.zeros(g.shape, dtype=bool)\n    expected_divider[:, cc] = True\n    expected_divider[cr, cc] = False\n    assert np.array_equal(g == divider_color, expected_divider)\n\n    source_mask = (g != bg) & (g != marker_color) & (g != divider_color)\n    source_coords = np.argwhere(source_mask)\n    assert source_coords.size > 0\n    assert np.all(source_coords[:, 1] < cc)\n\n    out = g.copy()\n    for r, c in source_coords:\n        rr = 2 * cr - int(r)\n        rc = 2 * cc - int(c)\n        assert 0 <= rr < h and 0 <= rc < w\n        assert out[rr, rc] == bg\n        out[rr, rc] = g[r, c]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Colors and canvas bounds.\nBG_COLOR, DIVIDER_COLOR, MARKER_COLOR = 7, 4, 8\nGRID_SIZES, MIN_EMPTY_BORDER_ROWS = (15, 17, 19), 1\n\n# Convex source shape bounds.\nSOURCE_SPAN_RANGE = (10, 15)\nSOURCE_MAX_WIDTH_RANGE = (5, 7)\nSOURCE_EDGE_WIDTH_RANGE = (1, 3)\nWIDTH_STEP_CAP, SOURCE_PIXEL_RANGE = 2, (35, 83)\n\n# Color palette, band orders, and retry budget.\nSOURCE_COLORS = (0, 1, 2, 3, 5, 6, 9)\nSOURCE_COLOR_COUNT_RANGE, GEN_ATTEMPTS = (3, 7), 300\nCOLORING_KEYS = (\n    lambda item: (item[2], item[3], item[1]),\n    lambda item: (item[3], item[2], item[1]),\n    lambda item: (item[2] + item[3], item[2], item[1]),\n    lambda item: (item[2] - item[3], item[2], item[1]),\n)\n\n\ndef _gen_bounded_steps(total, slots, cap):\n    steps = []\n    remaining = total\n    for i in range(slots):\n        left = slots - i - 1\n        lo = max(0, remaining - cap * left)\n        hi = min(cap, remaining)\n        step = random.randint(lo, hi)\n        steps.append(step)\n        remaining -= step\n    return steps\n\n\ndef _gen_width_profile(span, max_width):\n    edge_width_hi = min(SOURCE_EDGE_WIDTH_RANGE[1], max_width)\n    start_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n    end_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n    min_up = (max_width - start_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n    min_down = (max_width - end_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n    if min_up + min_down + 1 > span:\n        return None\n\n    peak_start = random.randint(min_up, span - 1 - min_down)\n    peak_end = random.randint(peak_start, span - 1 - min_down)\n\n    widths = [start_width]\n    for step in _gen_bounded_steps(max_width - start_width, peak_start, WIDTH_STEP_CAP):\n        widths.append(widths[-1] + step)\n\n    widths.extend([max_width] * (peak_end - peak_start))\n\n    current = max_width\n    for step in _gen_bounded_steps(max_width - end_width, span - 1 - peak_end, WIDTH_STEP_CAP):\n        current -= step\n        widths.append(current)\n\n    area = sum(widths)\n    if not SOURCE_PIXEL_RANGE[0] <= area <= SOURCE_PIXEL_RANGE[1]:\n        return None\n    return widths\n\n\ndef _choose_source_extent(n, cr):\n    valid_spans = [s for s in range(SOURCE_SPAN_RANGE[0], SOURCE_SPAN_RANGE[1] + 1) if s <= n - 2 * MIN_EMPTY_BORDER_ROWS]\n    span = random.choice(valid_spans)\n    r0_min = max(MIN_EMPTY_BORDER_ROWS, cr - span + 1)\n    r0_max = min(cr, n - MIN_EMPTY_BORDER_ROWS - span)\n    r0 = random.randint(r0_min, r0_max)\n    return span, r0, cr - r0\n\n\ndef _paint_source_cells(out, r0, widths, outer, cc):\n    interior = []\n    source = []\n    for i, width in enumerate(widths):\n        r = r0 + i\n        c0 = cc - width\n        for j in range(width):\n            c = c0 + j\n            source.append((r, c))\n            if j == 0:\n                out[r, c] = outer\n            else:\n                interior.append((r, c, i, j))\n    return source, interior\n\n\ndef _gen_color_source(out, r0, widths, colors, cc):\n    outer = colors[0]\n    inner = colors[1:]\n    source, interior = _paint_source_cells(out, r0, widths, outer, cc)\n    if len(interior) < len(inner):\n        return None\n\n    key = COLORING_KEYS[random.randrange(len(COLORING_KEYS))]\n    interior.sort(key=key)\n    band_count = len(inner)\n    for rank, (r, c, _, _) in enumerate(interior):\n        out[r, c] = inner[min(band_count - 1, rank * band_count // len(interior))]\n\n    return source\n\n\ndef _reflect_source(out, source, cr, cc):\n    reflected = []\n    for r, c in source:\n        rr = 2 * cr - r\n        rc = 2 * cc - c\n        if out[rr, rc] != BG_COLOR:\n            return None\n        out[rr, rc] = out[r, c]\n        reflected.append((rr, rc))\n    return reflected\n\n\ndef _gen_attempt():\n    n = random.choice(GRID_SIZES)\n    cr = cc = n // 2\n    out = np.full((n, n), BG_COLOR, dtype=int)\n    out[:, cc] = DIVIDER_COLOR\n    out[cr, [0, cc, n - 1]] = MARKER_COLOR\n\n    span, r0, center_i = _choose_source_extent(n, cr)\n    max_width = random.randint(*SOURCE_MAX_WIDTH_RANGE)\n    widths = _gen_width_profile(span, max_width)\n    if widths is None:\n        return None\n    if widths[center_i] >= cc:\n        return None\n\n    color_count = random.randint(*SOURCE_COLOR_COUNT_RANGE)\n    colors = random.sample(SOURCE_COLORS, color_count)\n    source = _gen_color_source(out, r0, widths, colors, cc)\n    if source is None:\n        return None\n\n    reflected = _reflect_source(out, source, cr, cc)\n    if reflected is None:\n        return None\n\n    inp = out.copy()\n    for r, c in reflected:\n        inp[r, c] = BG_COLOR\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input():\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid e729b7be input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/db0c5428.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox, crop_bbox, get_bg, paste\nimport random\n\n\ndef _major_foreground_color(g: np.ndarray, bg: int) -> int:\n    vals, counts = np.unique(g[g != int(bg)], return_counts=True)\n    assert vals.size, \"input must contain foreground colors\"\n    return int(vals[int(np.argmax(counts))])\n\n\ndef _center_patch(g: np.ndarray, r0: int, c0: int, block: int, bg: int) -> np.ndarray:\n    assert block == 3, \"this task uses 3x3 blocks\"\n    main = _major_foreground_color(g, bg)\n    patch = np.full((block, block), main, dtype=int)\n\n    hole_r = int(r0) + block\n    hole_c = int(c0) + block\n    offsets = [-1, 1, 3]\n    for r in range(block):\n        for c in range(block):\n            if r == block // 2 and c == block // 2:\n                continue\n            patch[r, c] = int(g[hole_r + offsets[r], hole_c + offsets[c]])\n    return patch\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Expand a 3x3 block motif into a 5x5 block motif around its missing center.\n\n    Input structure:\n    - Teal background surrounds one 9x9 foreground motif.\n    - The motif is a 3x3 array of 3x3 blocks; the middle block is empty teal.\n    - Colored pixels immediately around the empty middle block encode the border\n      of the missing center block.\n\n    Rule:\n    - Keep the original 9x9 motif in place.\n    - Copy each of the eight surrounding 3x3 blocks to the opposite outer slot\n      of the implied 5x5 block grid, without rotating it.\n    - Fill the center block from the eight pixels around the hole; its center is\n      the motif's majority foreground color.\n\n    Key insight: The visible 9x9 motif is the middle of a larger periodic\n    block-level pattern, and the empty center is reconstructed from its immediate\n    inner boundary.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    motif_bbox = bbox(g != bg)\n    assert motif_bbox is not None, \"expected a foreground motif\"\n    r0, c0, r1, c1 = motif_bbox\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    assert h == w and h % 3 == 0, \"motif must be a square 3x3 block grid\"\n    block = h // 3\n\n    out = g.copy()\n    expanded_r0 = int(r0) - block\n    expanded_c0 = int(c0) - block\n\n    for br in range(3):\n        for bc in range(3):\n            if (br, bc) == (1, 1):\n                continue\n            src = crop_bbox(\n                g,\n                (\n                    int(r0) + br * block,\n                    int(c0) + bc * block,\n                    int(r0) + (br + 1) * block - 1,\n                    int(c0) + (bc + 1) * block - 1,\n                ),\n            )\n            dst_r = expanded_r0 + (4 - 2 * br) * block\n            dst_c = expanded_c0 + (4 - 2 * bc) * block\n            paste(out, src, dst_r, dst_c)\n\n    paste(out, _center_patch(g, int(r0), int(c0), block, bg), int(r0) + block, int(c0) + block)\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# -- CFG: canvas & structure --\nGRID_SIZE_MIN, GRID_SIZE_MAX = 16, 19       # square grid side length\nBLOCK = 3                                    # block side length\nMOTIF_SIZE = BLOCK * 3                       # 9x9 motif (3x3 grid of blocks)\nEXPANDED_SIZE = BLOCK * 5                    # 15x15 expanded output region\nMOTIF_PAD = 3                                # min distance from motif edge to grid edge\n\n# -- CFG: colors --\nBG = 8                                       # background color\nFOREGROUND_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]\nCOLOR_COUNT_MIN, COLOR_COUNT_MAX = 2, 4      # total foreground colors (incl. majority)\n\n# -- CFG: majority pixel counts (corner block + edge block combined) --\nMAJORITY_TOTAL_MIN, MAJORITY_TOTAL_MAX = 10, 16  # range for sum of major pixels in b00+b01\nCORNER_MAJOR_MIN, CORNER_MAJOR_MAX = 5, 8        # major pixels in corner block (diag-sym)\nEDGE_MAJOR_MIN, EDGE_MAJOR_MAX = 5, 8            # major pixels in edge block (LR-sym)\n\n# -- CFG: generation --\nMAX_RETRIES = 300\n\n# -- Symmetry orbits for 3x3 blocks --\n# Diagonal-symmetric orbits (b00 == b00.T): cells sharing a diag-orbit get the same color\nDIAG_ORBITS = (\n    ((0, 0),), ((1, 1),), ((2, 2),),\n    ((0, 1), (1, 0)),\n    ((0, 2), (2, 0)),\n    ((1, 2), (2, 1)),\n)\n# LR-symmetric orbits (b01 == fliplr(b01)): cells sharing an LR-orbit get the same color\nLR_ORBITS = (\n    ((0, 0), (0, 2)),\n    ((1, 0), (1, 2)),\n    ((2, 0), (2, 2)),\n    ((0, 1),), ((1, 1),), ((2, 1),),\n)\n\n# Row/col indices for sampling inner-boundary pixels that fill the center patch.\n# Maps block-local (r,c) -> motif row/col via BLOCK + offset.\n_CENTER_OFFSETS = np.array([-1, 1, 3])\n\n\ndef _major_orbits(orbits, forced_minor, target_count):\n    \"\"\"Enumerate all orbit subsets whose total pixel count equals target_count,\n    excluding orbits that contain any forced_minor coordinate, then pick one.\"\"\"\n    forced_minor = set(forced_minor)\n    usable = [\n        idx for idx, orbit in enumerate(orbits)\n        if all(coord not in forced_minor for coord in orbit)\n    ]\n    choices = []\n    for mask in range(1 << len(usable)):\n        selected = set()\n        total = 0\n        for bit, idx in enumerate(usable):\n            if mask & (1 << bit):\n                selected.add(idx)\n                total += len(orbits[idx])\n        if total == target_count:\n            choices.append(selected)\n    assert choices, \"unreachable symmetric majority count\"\n    return random.choice(choices)\n\n\ndef _seed_block(orbits, forced_minor, majority, target_count):\n    \"\"\"Build a BLOCK x BLOCK array with majority color placed in orbits totalling\n    target_count pixels. Returns (block, minor_orbits) where minor_orbits is a list\n    of (block_ref, orbit) pairs whose colors are still unset (-1).\"\"\"\n    block = np.full((BLOCK, BLOCK), -1, dtype=int)\n    major_idxs = _major_orbits(orbits, forced_minor, target_count)\n    minor_orbits = []\n    for idx, orbit in enumerate(orbits):\n        if idx in major_idxs:\n            for r, c in orbit:\n                block[r, c] = majority\n        else:\n            minor_orbits.append((block, orbit))\n    return block, minor_orbits\n\n\ndef _assign_minor_colors(minor_orbits, colors):\n    \"\"\"Assign minor colors to unfilled orbits, guaranteeing each color appears at\n    least once (remaining orbits get random picks).\"\"\"\n    random.shuffle(minor_orbits)\n    guaranteed = list(colors)\n    random.shuffle(guaranteed)\n    assignments = guaranteed + [\n        random.choice(colors) for _ in range(len(minor_orbits) - len(guaranteed))\n    ]\n    for (block, orbit), color in zip(minor_orbits, assignments):\n        for r, c in orbit:\n            block[r, c] = color\n\n\ndef _make_blocks(majority, minor_colors, corner_major, edge_major):\n    \"\"\"Build the two seed blocks (b00=corner, b01=edge) with D4/LR symmetry.\"\"\"\n    b00, corner_minors = _seed_block(DIAG_ORBITS, [(2, 2)], majority, corner_major)\n    b01, edge_minors = _seed_block(LR_ORBITS, [(2, 1)], majority, edge_major)\n    minor_orbits = corner_minors + edge_minors\n    assert len(minor_orbits) >= len(minor_colors)\n    _assign_minor_colors(minor_orbits, minor_colors)\n    assert np.all(b00 != -1) and np.all(b01 != -1)\n    return b00, b01\n\n\ndef _assemble_motif(b00, b01):\n    \"\"\"Assemble the 9x9 motif from two seed blocks via D4 symmetry; center block is bg.\"\"\"\n    motif = np.full((MOTIF_SIZE, MOTIF_SIZE), BG, dtype=int)\n    blocks = {\n        (0, 0): b00,\n        (0, 1): b01,\n        (0, 2): np.fliplr(b00),\n        (1, 0): b01.T,\n        (1, 2): np.rot90(b01, -1),\n        (2, 0): np.flipud(b00),\n        (2, 1): np.flipud(b01),\n        (2, 2): np.rot90(b00, 2),\n    }\n    for (br, bc), blk in blocks.items():\n        paste(motif, blk, br * BLOCK, bc * BLOCK)\n    return motif\n\n\ndef _gen_center_patch(motif, majority):\n    \"\"\"Reconstruct the center block from the 8 inner-boundary pixels of the motif.\n    Center pixel is the majority foreground color.\"\"\"\n    rows = BLOCK + _CENTER_OFFSETS\n    cols = BLOCK + _CENTER_OFFSETS\n    patch = motif[np.ix_(rows, cols)].copy()\n    patch[1, 1] = majority\n    return patch\n\n\ndef _expanded_output(motif, center):\n    \"\"\"Build the 15x15 expanded region: original motif (with center filled) in the\n    middle, each surrounding block mirrored to the opposite outer slot.\"\"\"\n    expanded = np.full((EXPANDED_SIZE, EXPANDED_SIZE), BG, dtype=int)\n    output_motif = motif.copy()\n    paste(output_motif, center, BLOCK, BLOCK)\n    paste(expanded, output_motif, BLOCK, BLOCK)\n    for br in range(3):\n        for bc in range(3):\n            if (br, bc) == (1, 1):\n                continue\n            src = motif[br * BLOCK:(br + 1) * BLOCK, bc * BLOCK:(bc + 1) * BLOCK]\n            paste(expanded, src, (4 - 2 * br) * BLOCK, (4 - 2 * bc) * BLOCK)\n    return expanded\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single generation attempt: build motif, verify via oracle, return input or None.\"\"\"\n    n = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    color_count = random.randint(COLOR_COUNT_MIN, COLOR_COUNT_MAX)\n    colors = random.sample(FOREGROUND_COLORS, color_count)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/898e7135.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import bbox, bbox_coords, components_mask, crop_bbox, find_components, get_bg, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Inflate a frame's hole-layout and fill each hole with its matching piece.\n\n    Input structure:\n    - bg = most common color. Largest component is a monochrome frame enclosing bg holes.\n    - Outside pieces composed of k×k blocks; k = side of smallest solid square piece.\n\n    Rule:\n    - Extract connected hole regions inside the frame as slots.\n    - Match each piece to a slot by comparing block-level shapes under rotation/flip.\n    - Output the layout scaled by k, with pieces placed in slots; frame color as background.\n\n    Key insight: Pieces are k×k-block-scaled versions of holes; downsampling reveals shape matches under all 8 orientations.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    # --- find the largest connected component of foreground (multicolor) ---\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n    frame_comp = max(comps, key=lambda d: int(d[\"area\"]))\n    fr0, fc0, fr1, fc1 = map(int, frame_comp[\"bbox\"])\n\n    # The frame is monochrome; use its dominant color as output background.\n    frame_cols = [int(g[int(r), int(c)]) for r, c in frame_comp[\"coords\"]]\n    bgc = int(Counter(frame_cols).most_common(1)[0][0])\n\n    # --- layout = bg holes inside the frame bbox, tight-cropped ---\n    sub = crop_bbox(g, (fr0, fc0, fr1, fc1))\n    hole = sub == int(bg)\n    hole_box = bbox(hole)\n    assert hole_box is not None, \"frame must enclose at least one bg hole\"\n    lr0, lc0, lr1, lc1 = map(int, hole_box)\n    layout = hole[lr0 : lr1 + 1, lc0 : lc1 + 1]\n\n    # --- slot components in the layout ---\n    slots = []\n    for coords in components_mask(layout, connectivity=4):\n        rr0, cc0, rr1, cc1 = bbox_coords(coords)\n        rr0, cc0, rr1, cc1 = map(int, (rr0, cc0, rr1, cc1))\n        h = int(rr1 - rr0 + 1)\n        w = int(cc1 - cc0 + 1)\n        sm = np.zeros((h, w), dtype=bool)\n        sm[coords[:, 0] - rr0, coords[:, 1] - cc0] = True\n        slots.append({\"area\": int(sm.sum()), \"r0\": int(rr0), \"c0\": int(cc0), \"mask\": sm})\n    slots.sort(key=lambda s: (-int(s[\"area\"]), int(s[\"r0\"]), int(s[\"c0\"])))\n\n    assert slots, \"frame must contain at least one slot\"\n\n    # --- pieces = non-singleton foreground components excluding the frame component ---\n    pieces = []\n    for comp in comps:\n        if comp is frame_comp:\n            continue\n        coords = comp[\"coords\"]\n        if coords.size == 0 or int(coords.shape[0]) <= 1:\n            continue\n        pr0, pc0, pr1, pc1 = map(int, comp[\"bbox\"])\n        patch = crop_bbox(g, (pr0, pc0, pr1, pc1))\n        ph, pw = map(int, patch.shape)\n        pm = np.zeros((ph, pw), dtype=bool)\n        pm[coords[:, 0] - pr0, coords[:, 1] - pc0] = True\n        pieces.append({\"area\": int(pm.sum()), \"mask\": pm, \"patch\": patch})\n\n    assert pieces, \"at least one non-frame piece must exist\"\n\n    # --- infer k from the smallest solid square piece ---\n    k = None\n    for p in pieces:\n        h, w = map(int, p[\"mask\"].shape)\n        if h == w and int(p[\"mask\"].sum()) == int(h * w):\n            k = int(h) if k is None else min(int(k), int(h))\n    k = int(k or 1)\n\n    def downsample_blocks(mask: np.ndarray) -> np.ndarray | None:\n        hh, ww = mask.shape\n        if hh % k != 0 or ww % k != 0:\n            return None\n        out_h, out_w = int(hh // k), int(ww // k)\n        out = np.zeros((out_h, out_w), dtype=bool)\n        for r in range(out_h):\n            for c in range(out_w):\n                block = mask[int(r * k) : int((r + 1) * k), int(c * k) : int((c + 1) * k)]\n                if bool(block.all()):\n                    out[r, c] = True\n                elif bool(block.any()):\n                    return None\n        return out\n\n    def dihedral_variants(\n        patch: np.ndarray, mask: np.ndarray\n    ) -> list[tuple[np.ndarray, np.ndarray]]:\n        base = []\n        for kk in range(4):\n            p = np.rot90(patch, int(kk))\n            m = np.rot90(mask, int(kk))\n            base.append((p, m))\n            base.append((np.fliplr(p), np.fliplr(m)))\n        uniq = []\n        seen = set()\n        for p, m in base:\n            key = m.tobytes()\n            if key in seen:\n                continue\n            seen.add(key)\n            uniq.append((p, m))\n        return uniq\n\n    # Precompute all usable (piece,variant) candidates with their block masks.\n    candidates = []\n    for pi, p in enumerate(pieces):\n        for vp, vm in dihedral_variants(p[\"patch\"], p[\"mask\"]):\n            um = downsample_blocks(vm)\n            if um is None:\n                continue\n            candidates.append({\"pi\": int(pi), \"area\": int(p[\"area\"]), \"um\": um, \"vp\": vp, \"vm\": vm})\n\n    used_piece: set[int] = set()\n    placements: list[tuple[dict, dict]] = []\n    for s in slots:\n        need_area = int(s[\"area\"]) * int(k) * int(k)\n        found = None\n        for cand in candidates:\n            if int(cand[\"pi\"]) in used_piece:\n                continue\n            if int(cand[\"area\"]) != int(need_area):\n                continue\n            if cand[\"um\"].shape != s[\"mask\"].shape:\n                continue\n            if np.array_equal(cand[\"um\"], s[\"mask\"]):\n                found = cand\n                break\n        assert found is not None, \"every slot must match a piece\"\n        used_piece.add(int(found[\"pi\"]))\n        placements.append((s, found))\n\n    outH = (int(layout.shape[0]) + 2) * int(k)\n    outW = (int(layout.shape[1]) + 2) * int(k)\n    out = np.full((outH, outW), int(bgc), dtype=int)\n\n    for s, cand in placements:\n        top = (int(s[\"r0\"]) + 1) * int(k)\n        left = (int(s[\"c0\"]) + 1) * int(k)\n        paste(out, cand[\"vp\"], int(top), int(left), mask=cand[\"vm\"], overwrite=True)\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for ARC-AGI-2 task 898e7135.\n\nOutput-first strategy:\n  1. Build a hole/wall layout of 4-conn slots (8-separated, includes unit slots).\n  2. For each slot, pick a distinct color + dihedral transform; upscale slot mask\n     by k to get the piece sprite (solid k*k blocks).\n  3. Assemble the frame (layout + 1-cell border of frame_color).\n  4. Scatter pieces outside the frame on a bg=0 canvas, plus single-pixel\n     distractor noise in a fresh color.\n\nThe generator validates main(input) == expected_output before returning.\n\"\"\"\n\nimport random\nimport numpy as np\n\nfrom arc_utils import paste, random_free_location\n\n# --- tunables ----------------------------------------------------------------\n\nK_CHOICES = [2, 3]                  # block scale factor\nLAYOUT_H_RANGE = (4, 12)           # inner layout rows\nLAYOUT_W_RANGE = (4, 8)            # inner layout cols\nN_SLOTS_RANGE = (3, 6)             # total slot count (incl. unit)\nN_UNITS_MAX = 2                    # max unit-slot count per example\nNON_UNIT_SIZE_CHOICES = [2, 3, 4, 5, 6, 7]  # area of non-unit slots\n\nHOLE_DENSITY_RANGE = (0.20, 0.50)  # valid hole fraction of layout area\nUNIT_SLOT_RETRIES = 20             # attempts per unit slot placement\nNON_UNIT_SLOT_RETRIES = 30         # attempts per non-unit slot placement\nGROW_SEED_TRIES = 8                # random seed cells tried per _grow_slot call\n\nCANVAS_DIM_RANGE = (15, 30)        # min/max for canvas height and width\nAREA_BUFFER_MULT = 4               # multiplier on piece area for canvas sizing\nAREA_BUFFER_CONST = 50             # additive constant for canvas area budget\n\nDISTRACTOR_RANGE = (8, 13)         # singleton distractor pixel count\nDISTRACTOR_RETRY_MULT = 10         # retry multiplier for distractor placement\nMIN_DISTRACTORS = 8                # minimum placed distractors to accept\n\nGENERATE_MAX_RETRIES = 300         # outer retry limit in generate_input\n\n\n# --- layout generation -------------------------------------------------------\n\ndef _canonical_shape_key(mask: np.ndarray) -> bytes:\n    \"\"\"Canonical bytes representation under D4 for a bool mask (tight-cropped).\"\"\"\n    variants = []\n    for kk in range(4):\n        r = np.rot90(mask, kk)\n        variants.append(r.tobytes() + bytes([r.shape[0], r.shape[1]]))\n        fr = np.fliplr(r)\n        variants.append(fr.tobytes() + bytes([fr.shape[0], fr.shape[1]]))\n    return min(variants)\n\n\ndef _grow_slot(forbidden: np.ndarray, target_size: int) -> np.ndarray | None:\n    \"\"\"Grow a 4-conn slot of given size starting from a random free cell.\n    `forbidden` marks cells that must not be used. Returns coords array or None.\n    \"\"\"\n    H, W = forbidden.shape\n    free_cells = np.argwhere(~forbidden)\n    if free_cells.size == 0:\n        return None\n    random.shuffle(free_cells)\n    for start in free_cells[:GROW_SEED_TRIES]:\n        r0, c0 = int(start[0]), int(start[1])\n        chosen = {(r0, c0)}\n        frontier = {(r0 - 1, c0), (r0 + 1, c0), (r0, c0 - 1), (r0, c0 + 1)}\n        while len(chosen) < target_size and frontier:\n            cands = [p for p in frontier if 0 <= p[0] < H and 0 <= p[1] < W\n                     and not forbidden[p[0], p[1]] and p not in chosen]\n            if not cands:\n                break\n            nr, nc = random.choice(cands)\n            chosen.add((nr, nc))\n            frontier.discard((nr, nc))\n            frontier.update({(nr - 1, nc), (nr + 1, nc), (nr, nc - 1), (nr, nc + 1)})\n        if len(chosen) == target_size:\n            return np.array(sorted(chosen))\n    return None\n\n\ndef _dilate8(mask: np.ndarray) -> np.ndarray:\n    \"\"\"Dilate a bool mask by 1 cell (8-connectivity).\"\"\"\n    out = mask.copy()\n    out[:-1, :] |= mask[1:, :]\n    out[1:, :] |= mask[:-1, :]\n    out[:, :-1] |= mask[:, 1:]\n    out[:, 1:] |= mask[:, :-1]\n    out[:-1, :-1] |= mask[1:, 1:]\n    out[1:, 1:] |= mask[:-1, :-1]\n    out[:-1, 1:] |= mask[1:, :-1]\n    out[1:, :-1] |= mask[:-1, 1:]\n    return out\n\n\ndef _forbid_coords(forbidden: np.ndarray, coords: np.ndarray) -> None:\n    \"\"\"Mark coords and their 8-neighbors as forbidden (in-place).\"\"\"\n    cell_mask = np.zeros_like(forbidden)\n    cell_mask[coords[:, 0], coords[:, 1]] = True\n    forbidden |= _dilate8(cell_mask)\n\n\ndef _gen_layout(h: int, w: int, n_slots: int, n_units: int) -> list[dict] | None:\n","exit_code":0,"status":"completed"}}
