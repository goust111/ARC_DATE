RuntimeError(\"Failed to generate valid after 300 attempts\")\nENDSNIP\nFILE /home/lixinyu/snap/new/ARC_code/train/b25e450b.py\n27: def main(grid: np.ndarray) -> np.ndarray:\n28:     \"\"\"\n29:     Slide each black border rectangle to the opposite border, recoloring its swept stripe orange and leaving the rectangle black at the far edge.\n30: \n31:     Input structure\n32:     - The grid contains black rectangular 4-connected masks, each touching exactly one outer border.\n33:     - Grey cells form incidental pattern content; orange is the trail color used when a black mask slides.\n34: \n35:     Rule\n36:     - Treat all black rectangles as moving simultaneously.\n37:     - A rectangle touching the top or bottom edge moves vertically to the opposite edge in the same columns.\n38:     - A rectangle touching the left or right edge moves horizontally to the opposite edge in the same rows.\n39:     - Recolor the complete swept row or column stripe to orange, then stamp every destination rectangle in black.\n40: \n41:     Key insight\n42:     - Edge contact gives the slide direction; the output is the set of opposite-edge black rectangles plus their orange trails.\n43:     \"\"\"\n44:     g = np.asarray(grid, dtype=int)\n45:     assert g.ndim == 2\n46:     h, w = g.shape\n47:     assert h > 0 and w > 0\n48: \n49:     moving = Color.BLACK\n50:     trail = Color.ORANGE\n51:     assert np.any(g == moving), \"expected at least one black rectangle\"\n52:     assert np.any(g == trail), \"expected orange trail color to be present\"\n53: \n54:     out = g.copy()\n55:     targets: list[BBox] = []\n56:     for coords in components_mask(g == moving, connectivity=4):\n57:         r0, c0, r1, c1 = bbox_coords(coords)\n58:         rect_h = r1 - r0 + 1\n59:         rect_w = c1 - c0 + 1\n60:         assert int(coords.shape[0]) == rect_h * rect_w, \"black mask must be a solid rectangle\"\n61: \n62:         side = _edge_side((r0, c0, r1, c1), g.shape)\n63:         if side == \"top\":\n64:             out[:, c0 : c1 + 1] = trail\n65:             targets.append((h - rect_h, c0, h - 1, c1))\n66:         elif side == \"bottom\":\n67:             out[:, c0 : c1 + 1] = trail\n68:             targets.append((0, c0, rect_h - 1, c1))\n69:         elif side == \"left\":\n70:             out[r0 : r1 + 1, :] = trail\n71:             targets.append((r0, w - rect_w, r1, w - 1))\n72:         else:\n73:             assert side == \"right\"\n74:             out[r0 : r1 + 1, :] = trail\n75:             targets.append((r0, 0, r1, rect_w - 1))\n76: \n77:     for r0, c0, r1, c1 in targets:\n78:         out[r0 : r1 + 1, c0 : c1 + 1] = moving\n79: \n80:     return out\n81: \n82: # --------------- generator (att1) ---------------\n83: \n84: # Canvas and palette.\n85: MIN_H, MAX_H = 6, 18\n86: MIN_W, MAX_W = 8, 14\n87: BG_GREY, BG_ORANGE = 5, 7\n88: GREY_FRAC_MIN, GREY_FRAC_MAX = 0.2, 0.6\n89: \n90: # Rectangle and band constraints.\n91: MIN_RECTS, MAX_RECTS = 1, 8\n92: MIN_BAND_SIZE, MAX_BAND_SIZE = 1, 6\n93: BAND_GAP = 1\n94: MIN_RECT_AREA, MAX_RECT_AREA = 2, 18\n95: MAX_RECT_SIDE = 6\n96: SOURCE_EDGE_OFFSET = 1\n97: \n98: # Retry limits.\n99: TARGET_COUNT_ATTEMPTS = 300\n100: ANY_COUNT_ATTEMPTS = 100\n101: \n102: \n103: def _partition_bands(\n104:     total: int, n: int, min_size: int, max_size: int, min_gap: int = 0\n105: ) -> list[tuple[int, int]] | None:\n106:     \"\"\"Place n non-overlapping inclusive bands inside [0, total - 1].\"\"\"\n107:     if n == 0:\n108:         return []\n109: \n110:     needed = n * min_size + (n - 1) * min_gap\n111:     if needed > total:\n112:         return None\n113: \n114:     effective_max = min(max_size, total - (n - 1) * (min_size + min_gap))\n115:     if effective_max < min_size:\n116:         return None\nENDSNIP\n295: def generate_input() -> np.ndarray:\n296:     target_count = random.randint(MIN_RECTS, MAX_RECTS)\n297:     for _ in range(TARGET_COUNT_ATTEMPTS):\n298:         result = _gen_attempt_with_count(target_count)\n299:         if result is not None:\n300:             return result\n301:     for _ in range(ANY_COUNT_ATTEMPTS):\n302:         result = _gen_attempt_with_count(random.randint(MIN_RECTS, MAX_RECTS))\n303:         if result is not None:\n304:             return result\n305:     raise RuntimeError(f\"Failed to generate valid input after {TARGET_COUNT_ATTEMPTS + ANY_COUNT_ATTEMPTS} attempts\")\nENDSNIP\n","exit_code":0,"status":"completed"}}
