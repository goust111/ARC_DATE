ap(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):\n        b = int(b)\n        f = int(f)\n        if b == bg:\n            continue\n        mapping[b] = f\n\n    return mapping, pal_mask\n\n\ndef _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:\n    \"\"\"\n    Find background regions (excluding the palette area) that do NOT touch the grid boundary,\n    and fill each region based on the most common adjacent border color (mapped via palette).\n    \"\"\"\n    h, w = out.shape\n    bg_mask = (out == bg) & (~pal_mask)\n    comps = components_mask(bg_mask, connectivity=4)\n    for pts in comps:\n        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n        if touches_boundary:\n            continue\n\n        adj_counts: dict[int, int] = {}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < h and 0 <= cc < w:\n                    if pal_mask[rr, cc]:\n                        continue\n                    v = int(out[rr, cc])\n                    if v == bg:\n                        continue\n                    adj_counts[v] = adj_counts.get(v, 0) + 1\n        if not adj_counts:\n            continue\n\n        # Prefer an adjacent color that exists in the mapping; pick the most frequent border.\n        border = None\n        best = -1\n        for col, cnt in adj_counts.items():\nFILE /home/lixinyu/snap/new/ARC_code/train/17b866bd.py\nfrom __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color\nimport random\n\n\n_INTERIOR_OFFSETS = (\n    (1, 2),\n    (1, 3),\n    (2, 1),\n    (2, 2),\n    (2, 3),\n    (2, 4),\n    (3, 1),\n    (3, 2),\n    (3, 3),\n    (3, 4),\n    (4, 2),\n    (4, 3),\n)\n_INTERIOR = set(_INTERIOR_OFFSETS)\n\n\ndef _lattice_color(g: np.ndarray, empty: int) -> int:\n    vals, counts = np.unique(g, return_counts=True)\n    assert vals.size >= 2, \"expected an empty color and a lattice color\"\n    max_count = int(counts.max())\n    winners = vals[counts == max_count]\n    assert winners.size == 1, \"lattice color must be unique\"\n    lattice = int(winners[0])\n    assert lattice != empty, \"the lattice color must differ from the empty color\"\n    return lattice\n\n\ndef _matches_anchor_template(g: np.ndarray, r: int, c: int, empty: int, lattice: int) -> bool:\n    for dr in range(5):\n        for dc in range(5):\n            if (dr, dc) == (0, 0):\n                continue\n            expected = empty if (dr, dc) in _INTERIOR else lattice\n            if int(g[r + dr, c + dc]) != expected:\n                return False\n    return True\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each marker from a lattice corner gap into the adjacent enclosed 12-pixel cavity.\n\n    Input structure:\n    - The grid is a repeated teal lattice around black 12-pixel cavities.\n    - A marker is a non-black pixel placed at the northwest corner gap of one\n      complete 5x5 lattice tile; the marker may itself be teal.\n\n    Rule:\n    - For every marked northwest corner gap, clear that marker to black.\n    - Fill the 12 black pixels in the tile immediately down-right of the marker\n      with the marker color.\n    - Leave the rest of the lattice unchanged.\n\n    Key insight:\n    - The apparent isolated markers are control pixels for the adjacent cavity;\n      teal markers are recognized as extra teal pixels occupying a gap that the\n      periodic lattice template says should be black.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    empty = Color.BACKGROUND\n    lattice = _lattice_color(g, empty)\n    h, w = g.shape\n\n    anchors: list[tuple[int, int, int]] = []\n    for r in range(h - 4):\n        for c in range(w - 4):\n            if _matches_anchor_template(g, r, c, empty, lattice) and int(g[r, c]) != empty:\n                anchors.append((r, c, int(g[r, c])))\n\n    assert anchors, \"expected at least one marked lattice anchor\"\n\n    out = g.copy()\n    for r, c, color in anchors:\n        out[r, c] = empty\n        for dr, dc in _INTERIOR_OFFSETS:\n            assert int(g[r + dr, c + dc]) == empty, \"anchor cavity must be empty before filling\"\n            out[r + dr, c + dc] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- CFG: tunable generation parameters ---\n_LATTICE = 8                       # lattice / frame color\n_EMPTY = 0                        # background / cavity color\n_TILE_RANGE = (3, 4)              # rows/cols of tiles (N, M each sampled from this)\n_MAX_MARKERS = 9                  # upper bound on marker count per grid\n_MAX_DISTINCT_NON_LATTICE = 3     # max distinct non-lattice marker colors\n_LATTICE_MARKER_PROB = 0.35       # probability of including lattice-color markers\n_NON_LATTICE_COLORS = (1, 2, 3, 4, 5, 6, 7, 9)\n_GEN_RETRIES = 300                # max attempts before giving up\n\n# Reuse cavity offsets from the solver section (identical to _INTERIOR_OFFSETS).\n_CAVITY_OFFSETS = _INTERIOR_OFFSETS\n\n\ndef _base_lattice(n_tiles: int, m_tiles: int) -> np.ndarray:\n    \"\"\"Build an empty lattice grid: all lattice cells = _LATTICE, corners and cavities = _EMPTY.\"\"\"\n    h, w = 5 * n_tiles + 1, 5 * m_tiles + 1\n    grid = np.full((h, w), _LATTICE, dtype=int)\n    rs, cs = np.mgrid[:h, :w]\n    dr, dc = rs % 5, cs % 5\n    corner = (dr == 0) & (dc == 0)\n    cavity = np.zeros((h, w), dtype=bool)\n    for ro, co in _CAVITY_OFFSETS:\n        cavity |= (dr == ro) & (dc == co)\n    grid[corner | cavity] = _EMPTY\n    return grid\n\n\ndef _choose_marker_colors(marker_count: int) -> list[int]:\n    \"\"\"Pick and assign marker colors: optionally include lattice color, plus 1-3 non-lattice colors.\"\"\"\n    include_lattice = random.random() < _LATTICE_MARKER_PROB\n    if include_lattice:\n        non_count = random.randint(0, min(_MAX_DISTINCT_NON_LATTICE, marker_count - 1))\n    else:\n        non_count = random.randint(1, min(_MAX_DISTINCT_NON_LATTICE, marker_count))\n\n    colors = random.sample(_NON_LATTICE_COLORS, non_count)\n    if include_lattice:\n        colors.append(_LATTICE)\n\n    assignments = colors[:]\n    assignments.extend(random.choice(colors) for _ in range(marker_count - len(assignments)))\n    random.shuffle(assignments)\n    return assignments\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Try to generate one valid input grid. Returns None on oracle mismatch.\"\"\"\n    n_tiles = random.randint(*_TILE_RANGE)\n    m_tiles = random.randint(*_TILE_RANGE)\n    total_tiles = n_tiles * m_tiles\n    marker_count = random.randint(1, min(_MAX_MARKERS, total_tiles - 1))\n\n    marked_tiles = [(i, j) for i in range(n_tiles) for j in range(m_tiles)]\n    random.shuffle(marked_tiles)\n    marked_tiles = marked_tiles[:marker_count]\n    marker_colors = _choose_marker_colors(marker_count)\n\n    out = _base_lattice(n_tiles, m_tiles)\n    for (i, j), color in zip(marked_tiles, marker_colors):\n        r0, c0 = 5 * i, 5 * j\n        for dr, dc in _CAVITY_OFFSETS:\n            out[r0 + dr, c0 + dc] = color\n\n    inp = out.copy()\n    for (i, j), color in zip(marked_tiles, marker_colors):\n        r0, c0 = 5 * i, 5 * j\n        for dr, dc in _CAVITY_OFFSETS:\n            inp[r0 + dr, c0 + dc] = _EMPTY\n        inp[r0, c0] = color\n\n    try:\n        solved = main(inp)\n    except Exception:\n        return None\n    if np.array_equal(solved, out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise AssertionError(\"failed to generate a valid 17b866bd input\")\nFILE /home/lixinyu/snap/new/ARC_code/train/9841fdad.py\nfrom __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import get_bg\n\n\ndef _single_divider_column(g: np.ndarray, frame: int) -> int:\n    dividers = [c for c in range(1, g.shape[1] - 1) if np.all(g[:, c] == frame)]\n    assert len(dividers) == 1, \"expected exactly one full-height interior divider\"\n    return int(dividers[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Expand the colored runs from the left reference panel into the blank right panel.\n\n    Input structure:\n    - A uniform rectangular frame surrounds the grid.\n    - One full-height divider of the frame color splits a left reference panel\n      from a blank right panel.\n    - Both panels have one background margin column on each side of their active\n      columns; the left active columns contain two-column endpoint slots, possibly\n      connected by same-color horizontal runs.\n\n    Rule:\n    - Keep the original grid and paint only in the right panel's active columns.\n    - A source run exactly matching the left endpoint slot is copied to the left\n      two columns of the right active span.\n    - A source run exactly matching the right endpoint slot is copied to the right\n      two columns of the right active span.\n    - A source run connecting the endpoint slots is stretched across the entire\n      right active span.\n\n    Key insight:\n    The left panel is a compressed legend for the right panel: endpoint markers\n    stay two pixels wide, while connectors between endpoints expand to fill the\n    distance between them.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    H, W = g.shape\n    assert H >= 3 and W >= 7, \"grid too small for framed two-panel structure\"\n\n    frame = int(g[0, 0])\n    assert np.all(g[0, :] == frame) and np.all(g[-1, :] == frame), \"bad horizontal frame\"\n    assert np.all(g[:, 0] == frame) and np.all(g[:, -1] == frame), \"bad vertical frame\"\n\n    divider = _single_divider_column(g, frame)\n    assert divider >= 5 and W - divider >= 6, \"panels must contain margins and active slots\"\n\n    left_panel = g[1 : H - 1, 1:divider]\n    left_bg = get_bg(left_panel)\n    assert np.all(left_panel[:, 0] == left_bg), \"left panel must have a left margin\"\n    assert np.all(left_panel[:, -1] == left_bg), \"left panel must have a right margin\"\n\n    mini_start = 2\n    mini_end = divider - 2\n    assert mini_end - mini_start + 1 >= 4, \"left active region must contain two endpoint slots\"\n    left_slot = (mini_start, mini_start + 1)\n    right_slot = (mini_end - 1, mini_end)\n\n    target_start = divider + 2\n    target_end = W - 3\n    assert target_end - target_start + 1 >= 4, \"right active region must contain endpoint slots\"\n    right_bg = int(g[1, divider + 1])\n    right_panel = g[1 : H - 1, divider + 1 : W - 1]\n    assert np.all(right_panel == right_bg), \"right panel must be blank before expansion\"\n\n    out = g.copy()\n    painted_any = False\n    for r in range(1, H - 1):\n        c = mini_start\n        while c <= mini_end:\n            color = int(g[r, c])\n            if color == left_bg:\n                c += 1\n                continue\n\n            c0 = c\n            while c <= mini_end and int(g[r, c]) == color:\n                c += 1\n            c1 = c - 1\n\n            in_left_slot = (c0, c1) == left_slot\n            in_right_slot = (c0, c1) == right_slot\n            if in_left_slot:\n                d0, d1 = target_start, target_start + 1\n            elif in_right_slot:\n                d0, d1 = target_end - 1, target_end\n            else:\n                assert c0 == left_slot[0] and c1 >= right_slot[0], \"run must connect endpoint slots\"\n                d0, d1 = target_start, target_end\n\n            assert np.all(out[r, d0 : d1 + 1] == right_bg), \"expanded runs must not collide\"\n            out[r, d0 : d1 + 1] = color\n            painted_any = True\n\n    assert painted_any, \"expected at least one colored source run\"\n    return out\n\n# --------------- generator (att2) ---------------\n# Color and retry controls.\nLEFT_BG = 1\nCOLOR_IDS = tuple(range(10))\nFRAME_COLORS = (0, 2, 3, 4, 5, 6, 7, 8, 9)\nMAX_RUN_COLORS = 4\nGENERATION_RETRIES = 300\n\n# Canvas, group, and row layout bounds.\nLEFT_ACTIVE_WIDTHS = range(4, 7)\nRIGHT_ACTIVE_WIDTHS = range(11, 14)\nTOTAL_HEIGHTS = (11, 15)\nRIGHT_TO_LEFT_MIN_RATIO = 2\nFIXED_WIDTH_CELLS = 7\nNON_GROUP_ROWS = 4\nGROUP_COUNTS = (3, 5)\nGROUP_HEIGHT_BOUNDS = (1, 2)\nGAP_BOUNDS = (1, 2)\nFIRST_ACTIVE_ROW = 2\n\n# Run pattern geometry.\nRUN_WIDTH = 2\nLEFT_ACTIVE_START = 2\nRIGHT_TARGET_OFFSET = 2\nBASE_PATTERNS = (\"LEFT\", \"RIGHT\", \"FULL\")\nDOUBLE_PATTERN = \"LEFT_RIGHT\"\n\ndef _gen_sequences_with_sum(length: int, lo: int, hi: int, total: int) -> list[tuple[int, ...]]:\n    if length == 0:\n        return [()] if total == 0 else []\n    if total < length * lo or total > length * hi:\n        return []\n    out = []\n    for value in range(lo, hi + 1):\n        for rest in _gen_sequences_with_sum(length - 1, lo, hi, total - value):\n            out.append((value,) + rest)\n    return out\n\n\ndef _gen_pattern_options(length: int, run_color_count: int, left_active_width: int) -> list[tuple[str, ...]]:\n    base = list(BASE_PATTERNS)\n    if run_color_count >= 2 and left_active_width >= RUN_WIDTH * 2 + 1:\n        base.append(DOUBLE_PATTERN)\n\n    options: list[tuple[str, ...]] = [()]\n    for _ in range(length):\n        options = [prefix + (pattern,) for prefix in options for pattern in base]\n\n    return [\n        patterns\n        for patterns in options\n        if sum(2 if pattern == DOUBLE_PATTERN else 1 for pattern in patterns) >= run_color_count\n        and any(pattern in (\"LEFT\", \"FULL\", DOUBLE_PATTERN) for pattern in patterns)\n        and any(pattern in (\"RIGHT\", \"FULL\", DOUBLE_PATTERN) for pattern in patterns)\n    ]\n\n\ndef _gen_take_color(rng: np.random.Generator, palette: np.ndarray, needed: list[int], exclude: int | None = None) -> int:\n    for i, color in enumerate(needed):\n        if color != exclude:\n            return needed.pop(i)\n    choices = [int(color) for color in palette if int(color) != exclude]\n    return int(rng.choice(choices))\n\n\ndef _gen_row_layout(rng: np.random.Generator, group_count: int, total_h: int):\n    row_total = total_h - NON_GROUP_ROWS\n    height_lo, height_hi = GROUP_HEIGHT_BOUNDS\n    gap_lo, gap_hi = GAP_BOUNDS\n    gap_count = group_count - 1\n    height_options = []\n    for height_sum in range(group_count * height_lo, group_count * height_hi + 1):\n        gap_total = row_total - height_sum\n        if gap_total < gap_count * gap_lo or gap_total > gap_count * gap_hi:\n            continue\n        height_seqs = _gen_sequences_with_sum(group_count, height_lo, height_hi, height_sum)\n        gap_seqs = _gen_sequences_with_sum(gap_count, gap_lo, gap_hi, gap_total)\n        height_options.extend((heights, gaps) for heights in height_seqs for gaps in gap_seqs)\n    if not height_options:\n        return None\n    return height_options[int(rng.integers(len(height_options)))]\n\n\ndef _gen_patterns_and_colors(rng, group_count: int, left_w: int, left_bg: int, right_bg: int):\n    max_segments = group_count * (2 if left_w >= RUN_WIDTH * 2 + 1 else 1)\n    run_color_count = int(rng.integers(1, min(MAX_RUN_COLORS, max_segments) + 1))\n    pattern_options = _gen_pattern_options(group_count, run_color_count, left_w)\n    if not pattern_options:\n        return None\n    patterns = pattern_options[int(rng.integers(len(pattern_options)))]\n\n    run_choices = [c for c in COLOR_IDS if c not in (left_bg, right_bg)]\n    run_colors = rng.choice(run_choices, size=run_color_count, replace=False)\n    needed_colors = [int(color) for color in run_colors]\n    rng.shuffle(needed_colors)\n\n    group_colors: list[tuple[int, ...]] = []\n    for pattern in patterns:\n        if pattern == DOUBLE_PATTERN:\n            left_color = _gen_take_color(rng, run_colors, needed_colors)\n            right_color = _gen_take_color(rng, run_colors, needed_colors, exclude=left_color)\n            group_colors.append((left_color, right_color))\n        else:\n            group_colors.append((_gen_take_color(rng, run_colors, needed_colors),))\n    return patterns, group_colors\n\n\ndef _render_grid(total_h: int, total_w: int, divider: int, left_w: int, colors, row_layout, pattern_data):\n    frame_color, left_bg, right_bg = colors\n    group_heights, group_gaps = row_layout\n    patterns, group_colors = pattern_data\n    out = np.full((total_h, total_w), right_bg, dtype=int)\n    out[:, 0] = frame_color\n    out[:, -1] = frame_color\n    out[0, :] = frame_color\n    out[-1, :] = frame_color\n    out[:, divider] = frame_color\n    out[1 : total_h - 1, 1:divider] = left_bg\n    out[1 : total_h - 1, divider + 1 : total_w - 1] = right_bg\n    left_start = LEFT_ACTIVE_START\n    left_end = left_start + left_w - 1\n    left_slot = slice(left_start, left_start + RUN_WIDTH)\n    right_slot = slice(left_end - RUN_WIDTH + 1, left_end + 1)\n    target_start = divider + RIGHT_TARGET_OFFSET\n    target_end = total_w - 3\n\n    row = FIRST_ACTIVE_ROW\n    for idx, (pattern, colors) in enumerate(zip(patterns, group_colors)):\n        for r in range(row, row + group_heights[idx]):\n            if pattern == \"LEFT\":\n                out[r, left_slot] = colors[0]\n                out[r, target_start : target_start + RUN_WIDTH] = colors[0]\n            elif pattern == \"RIGHT\":\n                out[r, right_slot] = colors[0]\n                out[r, target_end - RUN_WIDTH + 1 : target_end + 1] = colors[0]\n            elif pattern == \"FULL\":\n                out[r, left_start : left_end + 1] = colors[0]\n                out[r, target_start : target_end + 1] = colors[0]\n            else:\n                out[r, left_slot] = colors[0]\n                out[r, right_slot] = colors[1]\n                out[r, target_start : target_start + RUN_WIDTH] = colors[0]\n                out[r, target_end - RUN_WIDTH + 1 : target_end + 1] = colors[1]\n        row += group_heights[idx]\n        if idx < len(group_gaps):\n            row += group_gaps[idx]\n    return out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    frame_color = int(rng.choice(FRAME_COLORS))\n    right_bg = int(rng.choice([c for c in COLOR_IDS if c not in (LEFT_BG, frame_color)]))\n    colors = (frame_color, LEFT_BG, right_bg)\n    width_pairs = [\n        (wl, wr)\n        for wl in LEFT_ACTIVE_WIDTHS\n        for wr in RIGHT_ACTIVE_WIDTHS\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"agent_message","text":"参考题里普遍用了三类约束：先用几何/连通性识别对象，生成器做重试并用 `main()` 反验，另外会显式避免对象贴边、碰撞和歧义。我继续补读几个更接近的参考实现，然后直接落到这题的对象编码和放置约束。"}}
