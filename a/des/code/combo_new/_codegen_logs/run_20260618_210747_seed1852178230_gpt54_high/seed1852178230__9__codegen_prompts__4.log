ty]\n    random.shuffle(cells)\n    anchors=[]; used_d=set(); used_s=set()\n    for cell in cells:\n        if not (1 <= cell[0] < h-1 and 1 <= cell[1] < w-1):\n            continue\n        d = cell[0]-cell[1]; s=cell[0]+cell[1]\n        if d in used_d or s in used_s or not spaced(cell, anchors):\n            continue\n        anchors.append(cell); used_d.add(d); used_s.add(s)\n        if len(anchors)==target:\n            return anchors\n    return None\n\nfound=0\nfor _ in range(500):\n    h=random.randint(9,18); w=random.randint(9,18); parity=random.randint(0,1)\n    anchors=gen_open(h,w,parity)\n    if not anchors:\n        continue\n    g=checkerboard((h,w), random.choice(BG_COLORS))\n    for (r,c), color in zip(anchors, random.sample(ANCHOR_COLORS, len(anchors))):\n        g[r,c]=color\n    s=solve(g)\n    density=(s['painted']+len(anchors))/(h*w)\n    if s['painted'] >= max(6, len(anchors)*2) and density <= 0.45 and s['blocked'] <= 2 and s['boundary'] >= s['blocked'] + 4:\n        found += 1\nprint(found)\nPY\"","aggregated_output":"240\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport hashlib\nimport random\nimport numpy as np\n\nBG_COLORS = (4, 7)\nANCHOR_COLORS = [0, 1, 2, 3, 5, 6, 8, 9]\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nMODES = ('open', 'chain', 'cross')\n\n\ndef checkerboard(shape, even_color):\n    odd = BG_COLORS[1] if even_color == BG_COLORS[0] else BG_COLORS[0]\n    rows, cols = np.indices(shape)\n    return np.where(((rows + cols) & 1) == 0, even_color, odd).astype(int)\n\n\ndef infer_checkerboard(g):\n    colors, counts = np.unique(g, return_counts=True)\n    order = np.argsort(counts)[::-1]\n    a, b = int(colors[order[0]]), int(colors[order[1]])\n    rows, cols = np.indices(g.shape)\n    parity = (rows + cols) & 1\n    score0 = int(np.count_nonzero(g[parity == 0] == a) + np.count_nonzero(g[parity == 1] == b))\n    score1 = int(np.count_nonzero(g[parity == 0] == b) + np.count_nonzero(g[parity == 1] == a))\n    if score1 > score0:\n        a, b = b, a\n    expected = np.where(parity == 0, a, b)\n    return expected\n\n\ndef transform(g):\n    expected = infer_checkerboard(g)\n    anchors = [tuple(map(int, p)) for p in np.argwhere(g \"'!= expected)]\n    anchors.sort()\n    out = g.copy()\n    h, w = g.shape\n    stats = {\n        '\"'anchor_count': len(anchors),\n        'blocked_rays': 0,\n        'boundary_rays': 0,\n        'zero_blocked_rays': 0,\n        'positive_blocked_rays': 0,\n        'painted_cells': 0,\n    }\n    for r0, c0 in anchors:\n        color = int(g[r0, c0])\n        for dr, dc in DIAG_DIRS:\n            r, c = r0 + dr, c0 + dc\n            length = 0\n            while 0 <= r < h and 0 <= c < w:\n                if int(out[r, c]) \"'!= int(expected[r, c]):\n                    stats['\"'blocked_rays'] += 1\n                    if length == 0:\n                        stats['zero_blocked_rays'] += 1\n                    else:\n                        stats['positive_blocked_rays'] += 1\n                    break\n                out[r, c] = color\n                length += 1\n                stats['painted_cells'] += 1\n                r += dr\n                c += dc\n            else:\n                stats['boundary_rays'] += 1\n    stats['non_bg_cells'] = stats['anchor_count'] + stats['painted_cells']\n    return out, stats\n\n\ndef spaced(cell, others, min_cheb=2):\n    return all(max(abs(cell[0] - r), abs(cell[1] - c)) >= min_cheb for r, c in others)\n\n\ndef build_input(h, w, even_color, anchors):\n    g = checkerboard((h, w), even_color)\n    for (r, c), color in zip(anchors, random.sample(ANCHOR_COLORS, len(anchors))):\n        g[r, c] = color\n    return g\n\n\ndef gen_open(h, w, parity):\n    target = random.randint(2, 3)\n    cells = [(r, c) for r in range(h) for c in range(w) if ((r + c) & 1) == parity]\n    random.shuffle(cells)\n    anchors = []\n    used_d = set()\n    used_s = set()\n    for cell in cells:\n        if not (1 <= cell[0] < h - 1 and 1 <= cell[1] < w - 1):\n            continue\n        d = cell[0] - cell[1]\n        s = cell[0] + cell[1]\n        if d in used_d or s in used_s:\n            continue\n        if not spaced(cell, anchors):\n            continue\n        anchors.append(cell)\n        used_d.add(d)\n        used_s.add(s)\n        if len(anchors) == target:\n            return anchors\n    return None\n\n\ndef line_cells(h, w, parity, kind, const):\n    cells = []\n    for r in range(h):\n        for c in range(w):\n            if ((r + c) & 1) \"'!= parity:\n                continue\n            if (kind == '\"'diff' and r - c == const) or (kind == 'sum' and r + c == const):\n                cells.append((r, c))\n    cells.sort()\n    return cells\n\n\ndef choose_spaced(seq, count):\n    for _ in range(80):\n        picks = sorted(random.sample(range(len(seq)), count))\n        if all(b - a >= 2 for a, b in zip(picks, picks[1:])):\n            return [seq[i] for i in picks]\n    return None\n\n\ndef add_open_extras(h, w, parity, anchors, total):\n    cells = [(r, c) for r in range(h) for c in range(w) if ((r + c) & 1) == parity]\n    random.shuffle(cells)\n    used_d = {r - c for r, c in anchors}\n    used_s = {r + c for r, c in anchors}\n    out = list(anchors)\n    for cell in cells:\n        if len(out) == total:\n            break\n        if not spaced(cell, out):\n            continue\n        d = cell[0] - cell[1]\n        s = cell[0] + cell[1]\n        if d in used_d or s in used_s:\n            continue\n        out.append(cell)\n        used_d.add(d)\n        used_s.add(s)\n    return out if len(out) == total else None\n\n\ndef gen_chain(h, w, parity):\n    total = random.randint(2, 4)\n    group = random.randint(2, min(3, total))\n    kind = random.choice(('diff', 'sum'))\n    consts = list(range(-(w - 1), h)) if kind == 'diff' else list(range(h + w - 1))\n    random.shuffle(consts)\n    chosen = None\n    for const in consts:\n        cells = [p for p in line_cells(h, w, parity, kind, const) if 0 < p[0] < h - 1 and 0 < p[1] < w - 1]\n        if len(cells) < group:\n            continue\n        chosen = choose_spaced(cells, group)\n        if chosen is not None:\n            break\n    if chosen is None:\n        return None\n    return add_open_extras(h, w, parity, chosen, total)\n\n\ndef gen_cross(h, w, parity):\n    side = random.choice(('left', 'right'))\n    candidates = []\n    for r in range(2, h - 2):\n        for c in range(2, w - 2):\n            if ((r + c) & 1) \"'!= parity:\n                continue\n            if side == '\"'left':\n                max_a = min(r, c)\n                max_b = min(h - 1 - r, c)\n            else:\n                max_a = min(r, w - 1 - c)\n                max_b = min(h - 1 - r, w - 1 - c)\n            if max_a >= 2 and max_b >= 2:\n                candidates.append((r, c, max_a, max_b))\n    if not candidates:\n        return None\n    pr, pc, max_a, max_b = random.choice(candidates)\n    a = random.randint(2, min(max_a, 6))\n    b = random.randint(2, min(max_b, 6))\n    if side == 'left':\n        anchors = [(pr - a, pc - a), (pr + b, pc - b)]\n    else:\n        anchors = [(pr - a, pc + a), (pr + b, pc + b)]\n    if random.random() < 0.5:\n        extra_total = 3\n        extra = add_open_extras(h, w, parity, anchors, extra_total)\n        if extra is not None:\n            anchors = extra\n    return anchors\n\n\ndef is_valid(mode, stats, shape):\n    h, w = shape\n    density = stats['non_bg_cells'] / float(h * w)\n    if stats['painted_cells'] < max(6, stats['anchor_count'] * 2):\n        return False\n    if density < 0.08 or density > 0.45:\n        return False\n    if mode == 'open':\n        return stats['blocked_rays'] <= 2 and stats['boundary_rays'] >= stats['blocked_rays'] + 4\n    if mode == 'chain':\n        return stats['blocked_rays'] >= 2 and stats['zero_blocked_rays'] >= 1 and stats['boundary_rays'] >= 4\n    return stats['positive_blocked_rays'] >= 1 and stats['boundary_rays'] >= 4\n\n\ndef generate_one():\n    for _ in range(400):\n        mode = random.choice(MODES)\n        h = random.randint(9, 18)\n        w = random.randint(9, 18)\n        even_color = random.choice(BG_COLORS)\n        parity = random.randint(0, 1)\n        if mode == 'open':\n            anchors = gen_open(h, w, parity)\n        elif mode == 'chain':\n            anchors = gen_chain(h, w, parity)\n        else:\n            anchors = gen_cross(h, w, parity)\n        if anchors is None:\n            continue\n        g = build_input(h, w, even_color, anchors)\n        _out, stats = transform(g)\n        if is_valid(mode, stats, (h, w)):\n            return g, mode, stats\n    raise RuntimeError('failed')\n\nsigs=set(); mode_counts={m:0 for m in MODES}\nfor i in range(100):\n    g, mode, stats = generate_one()\n    mode_counts[mode]+=1\n    sigs.add(hashlib.md5(g.tobytes()+str(g.shape).encode()).hexdigest())\nprint('variants', len(sigs))\nprint(mode_counts)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
