{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '39,470p' /home/lixinyu/snap/new/ARC_code/train/f1bcbc2c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Paint the top-connected middle channel between two orange path components teal.\n\n    Input structure\n    - The background is black.\n    - One foreground color forms exactly two 4-connected one-pixel-wide path components.\n    - Optional non-background control pixels may sit in the channel between the two paths.\n\n    Rule\n    - Dilate each path component by one cell in the 8-neighborhood and intersect the two dilations; this gives the one-cell-wide middle channel.\n    - A control pixel in that channel is a blocker only when its 4-neighbors touch fewer than both path components; otherwise it is part of the channel and is repainted.\n    - After removing blockers, paint the channel component connected to the top edge teal and keep all other pixels unchanged.\n\n    Key insight\n    - The desired pixels are not found by region filling; they are the geometric overlap of the two paths' one-cell halos, with weakly attached control pixels splitting the channel.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    bg = get_bg(g)\n    assert bg == Color.BLACK, \"expected black background\"\n\n    path_color = _path_color(g, bg)\n    path_labels, n_paths = label_mask(g == path_color, connectivity=4)\n    assert n_paths == 2, \"expected two path components\"\n\n    channel = g != path_color\n    for label_id in range(1, n_paths + 1):\n        channel &= binary_dilation(path_labels == label_id, structure=STRUCT8)\n    assert np.any(channel), \"expected a middle channel between the paths\"\n\n    blocked = []\n    for r_raw, c_raw in np.argwhere(channel & (g != bg)):\n        r = int(r_raw)\n        c = int(c_raw)\n        adjacent = _adjacent_path_labels(path_labels, r, c)\n        assert adjacent, \"control pixel in channel must touch a path component\"\n        if len(adjacent) < n_paths:\n            blocked.append((r, c))\n        else:\n            assert len(adjacent) == n_paths, \"channel control pixel cannot touch extra path labels\"\n\n    passable = channel.copy()\n    for r, c in blocked:\n        passable[r, c] = False\n\n    channel_labels, n_channels = label_mask(passable, connectivity=4)\n    assert n_channels >= 1, \"expected at least one passable channel component\"\n    top_components = [\n        label_id for label_id in range(1, n_channels + 1) if np.any(channel_labels[0, :] == label_id)\n    ]\n    assert len(top_components) == 1, \"expected exactly one channel component connected to the top edge\"\n\n    paint = channel_labels == top_components[0]\n    assert np.any(paint), \"expected cells to paint\"\n    out = g.copy()\n    out[paint] = Color.TEAL\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and channel bounds.\nGEN_GRID_SHAPE = (10, 10)\nGEN_TOP_ROW = 0\nGEN_BOTTOM_ROW = 9\nGEN_LEFT_COL = 0\nGEN_RIGHT_COL = 9\nGEN_MIN_CHANNEL_COL = 1\nGEN_MAX_CHANNEL_COL = 8\n\n# Segment and turn sampling.\nGEN_MIN_TURNS = 2\nGEN_MAX_TURNS = 4\nGEN_VERTICAL_MIN = 2\nGEN_VERTICAL_MAX = 7\nGEN_VERTICAL_TOTAL_MIN = 6\nGEN_VERTICAL_TOTAL_MAX = 9\nGEN_FULL_HEIGHT_TOTAL = 9\nGEN_FULL_HEIGHT_PROB = 0.8\nGEN_HORIZONTAL_MIN = 2\nGEN_HORIZONTAL_MAX = 4\nGEN_HORIZONTAL_BUDGET = 7\n\n# Optional blocker placement.\nGEN_BLOCKER_PROB = 0.6\nGEN_BLOCKING_BLOCKER_PROB = 0.55\n\n# Retry budget for rejected geometry.\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_walk_segment(path, dr, dc, steps):\n    r, c = path[-1]\n    for _ in range(steps):\n        r += dr\n        c += dc\n        path.append((r, c))\n\n\ndef _gen_directions(hdir, turns):\n    directions = [(1, 0)]\n    for i in range(turns):\n        directions.append((0, hdir) if i % 2 == 0 else (1, 0))\n    return directions\n\n\ndef _gen_partition_total(total, count, minimum, maximum):\n    \"\"\"Randomly split total into count bounded positive steps.\"\"\"\n    steps = []\n    remaining = total\n    for i in range(count - 1):\n        rest = count - i - 1\n        hi = min(maximum, remaining - minimum * rest)\n        lo = max(minimum, remaining - maximum * rest)\n        val = random.randint(lo, hi)\n        steps.append(val)\n        remaining -= val\n    steps.append(remaining)\n    return steps\n\n\ndef _gen_vertical_steps(directions):\n    v_count = sum(1 for d in directions if d == (1, 0))\n    if directions[-1] == (1, 0) and random.random() < GEN_FULL_HEIGHT_PROB:\n        total = GEN_FULL_HEIGHT_TOTAL\n    else:\n        total = random.randint(GEN_VERTICAL_TOTAL_MIN, GEN_VERTICAL_TOTAL_MAX)\n    return _gen_partition_total(total, v_count, GEN_VERTICAL_MIN, GEN_VERTICAL_MAX)\n\n\ndef _gen_horizontal_steps(h_count):\n    steps = []\n    remaining = GEN_HORIZONTAL_BUDGET\n    for i in range(h_count):\n        hi = min(GEN_HORIZONTAL_MAX, remaining - GEN_HORIZONTAL_MIN * (h_count - i - 1))\n        step = random.randint(GEN_HORIZONTAL_MIN, hi)\n        steps.append(step)\n        remaining -= step\n    return steps\n\n\ndef _gen_start_col(hdir, h_steps):\n    total_h = sum(h_steps)\n    if hdir == 1:\n        return random.randint(GEN_MIN_CHANNEL_COL, GEN_MAX_CHANNEL_COL - total_h)\n    return random.randint(GEN_MIN_CHANNEL_COL + total_h, GEN_MAX_CHANNEL_COL)\n\n\ndef _gen_channel_path():\n    hdir = random.choice([-1, 1])\n    turns = random.randint(GEN_MIN_TURNS, GEN_MAX_TURNS)\n    directions = _gen_directions(hdir, turns)\n    v_steps = _gen_vertical_steps(directions)\n    h_steps = _gen_horizontal_steps(sum(1 for d in directions if d[0] == 0))\n    start_c = _gen_start_col(hdir, h_steps)\n\n    path = [(GEN_TOP_ROW, start_c)]\n    vi = 0\n    hi = 0\n    for dr, dc in directions:\n        if dr:\n            steps = v_steps[vi]\n            vi += 1\n        else:\n            steps = h_steps[hi]\n            hi += 1\n        _gen_walk_segment(path, dr, dc, steps)\n\n    if any(\n        r < GEN_TOP_ROW or r > GEN_BOTTOM_ROW or c < GEN_MIN_CHANNEL_COL or c > GEN_MAX_CHANNEL_COL\n        for r, c in path\n    ):\n        return None\n    return path\n\n\ndef _gen_left_normal(dr, dc):\n    return -dc, dr\n\n\ndef _gen_wall_sets(path):\n    left = set()\n    right = set()\n    channel = set(path)\n    for i, (r, c) in enumerate(path):\n        dirs = []\n        if i > 0:\n            pr, pc = path[i - 1]\n            dirs.append((r - pr, c - pc))\n        if i + 1 < len(path):\n            nr, nc = path[i + 1]\n            dirs.append((nr - r, nc - c))\n        for dr, dc in dirs:\n            lr, lc = _gen_left_normal(dr, dc)\n            if (r + lr, c + lc) not in channel:\n                left.add((r + lr, c + lc))\n            if (r - lr, c - lc) not in channel:\n                right.add((r - lr, c - lc))\n        if len(dirs) == 2 and dirs[0] != dirs[1]:\n            for side in (1, -1):\n                offsets = []\n                for dr, dc in dirs:\n                    lr, lc = _gen_left_normal(dr, dc)\n                    offsets.append((side * lr, side * lc))\n                direct = [(r + dr, c + dc) for dr, dc in offsets]\n                if all(cell not in channel for cell in direct):\n                    er = r + offsets[0][0] + offsets[1][0]\n                    ec = c + offsets[0][1] + offsets[1][1]\n                    if side == 1:\n                        left.add((er, ec))\n                    else:\n                        right.add((er, ec))\n    return left, right\n\n\ndef _gen_mask_from_cells(cells):\n    mask = np.zeros(GEN_GRID_SHAPE, dtype=bool)\n    cells = list(cells)\n    if cells:\n        rows, cols = zip(*cells)\n        mask[rows, cols] = True\n    return mask\n\n\ndef _gen_paint_cells(grid, cells, color):\n    cells = list(cells)\n    if cells:\n        rows, cols = zip(*cells)\n        grid[rows, cols] = color\n\n\ndef _gen_is_thin_component(mask):\n    comps = components_mask(mask, connectivity=4)\n    if len(comps) != 1:\n        return False\n    cells = {tuple(map(int, xy)) for xy in comps[0]}\n    for r, c in cells:\n        deg = sum((rr, cc) in cells for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)))\n        if deg > 2:\n            return False\n    return True\n\n\ndef _gen_channel_from_solver_geometry(grid):\n    labels, n_paths = label_mask(grid == Color.ORANGE, connectivity=4)\n    if n_paths != 2:\n        return None, None\n\n    channel = grid != Color.ORANGE\n    for label_id in range(1, n_paths + 1):\n        channel &= binary_dilation(labels == label_id, structure=STRUCT8)\n    return channel, labels\n\n\ndef _gen_render_valid_walls(channel_path):\n    \"\"\"Render orange walls and verify they induce exactly the sampled channel.\"\"\"\n    channel_cells = set(channel_path)\n    left, right = _gen_wall_sets(channel_path)\n    if left & right or left & channel_cells or right & channel_cells:\n        return None, None\n    if any(r < GEN_TOP_ROW or r > GEN_BOTTOM_ROW or c < GEN_LEFT_COL or c > GEN_RIGHT_COL for r, c in left | right):\n        return None, None\n\n    grid = np.zeros(GEN_GRID_SHAPE, dtype=int)\n    _gen_paint_cells(grid, left | right, Color.ORANGE)\n\n    left_mask = _gen_mask_from_cells(left)\n    right_mask = _gen_mask_from_cells(right)\n    if not _gen_is_thin_component(left_mask) or not _gen_is_thin_component(right_mask):\n        return None, None\n\n    channel, labels = _gen_channel_from_solver_geometry(grid)\n    if channel is None:\n        return None, None\n    expected_channel = _gen_mask_from_cells(channel_path)\n    if not np.array_equal(channel, expected_channel):\n        return None, None\n    return grid, labels\n\n\ndef _gen_blocker_candidates(labels, channel_path):\n    \"\"\"Return turn blockers and straight pass-through blocker locations.\"\"\"\n    turn_cells = []\n    straight_cells = []\n    for i, (r, c) in enumerate(channel_path):\n        if i == 0:\n            continue\n        adj = _adjacent_path_labels(labels, r, c)\n        if len(adj) == 1:\n            turn_cells.append((r, c))\n        elif len(adj) == 2:\n            straight_cells.append((r, c))\n    return turn_cells, straight_cells\n\n\ndef _gen_maybe_place_blocker(grid, labels, channel_path):\n    if random.random() < GEN_BLOCKER_PROB:\n        turn_cells, straight_cells = _gen_blocker_candidates(labels, channel_path)\n        if turn_cells and straight_cells:\n            if random.random() < GEN_BLOCKING_BLOCKER_PROB:\n                r, c = random.choice(turn_cells)\n            else:\n                r, c = random.choice(straight_cells)\n            grid[r, c] = Color.MAROON\n\n\ndef _gen_oracle_accepts(grid):\n    \"\"\"Accept only grids whose solver output paints a top-connected channel.\"\"\"\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return bool(np.any((out == Color.TEAL)[GEN_TOP_ROW, :]))\n\n\ndef _gen_attempt():\n    channel_path = _gen_channel_path()\n    if channel_path is None:\n        return None\n\n    grid, labels = _gen_render_valid_walls(channel_path)\n    if grid is None:\n        return None\n\n    _gen_maybe_place_blocker(grid, labels, channel_path)\n    if not _gen_oracle_accepts(grid):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid f1bcbc2c input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,640p' /home/lixinyu/snap/new/ARC_code/eval/271d71e2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,640p' /home/lixinyu/snap/new/ARC_code/eval/271d71e2.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom scipy.ndimage import label\nfrom arc_utils import STRUCT4, bbox_coords, colors_present, components_mask, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move bordered containers toward same-colored destination markers, charging gray cells to orange.\n\n    Input structure:\n    - bg = 6 (magenta). Black-bordered (0) rectangles with gray (5) / orange (7) interiors.\n    - A head sprite (9) sits adjacent to one container edge; a matching destination sprite lies along the movement axis.\n\n    Rule:\n    - Each container translates toward its destination along the head-to-dest axis.\n    - Steps = min(head-to-dest distance, number of gray interior cells).\n    - Gray cells become orange from the head-facing side inward, one per step.\n\n    Key insight: Gray cell count caps movement — a container stops short if it runs out of gray cells to charge.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    BORDER = 0\n    GREY = 5\n    FILL = 7\n    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    # True background is dominant non-border color (border can dominate in some cases).\n    cnt = Counter(map(int, g.flatten()))\n    bg = int(max((c for c in cnt.keys() if int(c) != int(BORDER)), key=lambda c: int(cnt[int(c)])))\n\n    def rect_border_coords(r0: int, c0: int, r1: int, c1: int):\n        for c in range(c0, c1 + 1):\n            yield (r0, c)\n            yield (r1, c)\n        for r in range(r0 + 1, r1):\n            yield (r, c0)\n            yield (r, c1)\n\n    # --- detect containers as rectangles enclosing GREY/FILL with BORDER frame ---\n    containers = []\n    for pts in components_mask((g == GREY) | (g == FILL), connectivity=4):\n        if pts.size == 0:\n            continue\n        ir0, ic0, ir1, ic1 = bbox_coords(pts)\n        r0, c0, r1, c1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)\n        if r0 < 0 or c0 < 0 or r1 >= H or c1 >= W:\n            continue\n        if any(int(g[r, c]) != BORDER for r, c in rect_border_coords(r0, c0, r1, c1)):\n            continue\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        if inner.size == 0 or not bool(np.isin(inner, [GREY, FILL]).all()):\n            continue\n        containers.append({\"box\": (r0, c0, r1, c1)})\n\n    assert not (not containers)\n\n    # head + destination are in some non-bg, non-border color (not GREY/FILL)\n    out = g.copy()\n\n    all_head_colors = [c for c in colors_present(g, exclude={bg, BORDER, GREY, FILL})]\n\n    # Precompute components for each head color.\n    comp_by_color: dict[int, list[dict]] = defaultdict(list)\n    for col in all_head_colors:\n        labc, nc = label(g == int(col), structure=STRUCT4)\n        for k in range(1, int(nc) + 1):\n            coords = np.argwhere(labc == int(k))\n            if coords.size == 0:\n                continue\n            r0, c0, r1, c1 = bbox_coords(coords)\n            pts = {(int(r), int(c)) for r, c in coords}\n            shape = {(int(r - r0), int(c - c0)) for r, c in pts}\n            comp_by_color[int(col)].append({\"pts\": pts, \"shape\": shape, \"tl\": (int(r0), int(c0))})\n\n    def pick_head_for_container(box_):\n        r0, c0, r1, c1 = box_\n        head_seeds = []\n        for r, c in rect_border_coords(r0, c0, r1, c1):\n            for dr, dc in DIR4:\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < H and 0 <= cc < W:\n                    val = int(g[rr, cc])\n                    if val not in (int(bg), int(BORDER), int(GREY), int(FILL)):\n                        head_seeds.append((rr, cc, val))\n        if not head_seeds:\n            return None\n\n        hc = int(Counter(val for _r, _c, val in head_seeds).most_common(1)[0][0])\n        seed_pts = {(r, c) for r, c, val in head_seeds if int(val) == int(hc)}\n        cands = comp_by_color.get(hc, [])\n        comp0 = None\n        for comp in cands:\n            if comp[\"pts\"] & seed_pts:\n                comp0 = comp\n                break\n        if comp0 is None:\n            return None\n\n        # Split head vs destination even if same-color pixels touch:\n        # head pixels are those with minimal manhattan distance to this container border.\n        border_pts = list(rect_border_coords(r0, c0, r1, c1))\n        best_d = None\n        dist = {}\n        for pr, pc in comp0[\"pts\"]:\n            d = min(abs(int(pr - br)) + abs(int(pc - bc)) for br, bc in border_pts)\n            dist[(int(pr), int(pc))] = int(d)\n            if best_d is None or d < best_d:\n                best_d = int(d)\n        if best_d is None:\n            return None\n        head_pts = {p for p, d in dist.items() if int(d) == int(best_d)}\n\n        # direction from head bbox relative to container box\n        coords = np.array(list(head_pts), dtype=int)\n        hr0, hc0, hr1, hc1 = bbox_coords(coords)\n        if hc1 < c0:\n            direction = (0, -1)\n        elif hc0 > c1:\n            direction = (0, 1)\n        elif hr1 < r0:\n            direction = (-1, 0)\n        elif hr0 > r1:\n            direction = (1, 0)\n        else:\n            direction = (0, 0)\n\n        # normalized head shape + top-left\n        r00, c00 = int(hr0), int(hc0)\n        head_shape = {(int(r - r00), int(c - c00)) for r, c in head_pts}\n        return {\n            \"color\": hc,\n            \"head_pts\": head_pts,\n            \"head_shape\": head_shape,\n            \"head_tl\": (r00, c00),\n            \"comp_pts\": set(comp0[\"pts\"]),\n            \"dir\": direction,\n        }\n\n    for cont in containers:\n        box_ = cont[\"box\"]\n        r0, c0, r1, c1 = box_\n\n        head_info = pick_head_for_container(box_)\n        if head_info is None:\n            continue\n        hc = int(head_info[\"color\"])\n        head_pts = set(head_info[\"head_pts\"])\n        head_shape = head_info[\"head_shape\"]\n        head_tl = head_info[\"head_tl\"]\n        comp_pts = set(head_info[\"comp_pts\"])\n        direction = head_info[\"dir\"]\n        if direction == (0, 0):\n            continue\n\n        # destination candidates\n        dests = []\n        for d in comp_by_color.get(hc, []):\n            if d[\"shape\"] != head_shape:\n                continue\n            if d[\"pts\"] == comp_pts:\n                continue\n            dests.append(d)\n\n        # add split-from-same-component destinations (when dest touches head by color)\n        rem = comp_pts - head_pts\n        if rem:\n            mask_rem = np.zeros((H, W), dtype=bool)\n            for rr, cc in rem:\n                mask_rem[int(rr), int(cc)] = True\n            labr, nr = label(mask_rem, structure=STRUCT4)\n            for k in range(1, int(nr) + 1):\n                pts = {(int(r), int(c)) for r, c in np.argwhere(labr == int(k))}\n                if not pts:\n                    continue\n                # reject if adjacent to BORDER\n                adj = False\n                for r, c in pts:\n                    for dr, dc in DIR4:\n                        rr, cc = int(r + dr), int(c + dc)\n                        if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(BORDER):\n                            adj = True\n                            break\n                    if adj:\n                        break\n                if adj:\n                    continue\n                rs = [r for r, _c in pts]\n                cs = [c for _r, c in pts]\n                r00, c00 = int(min(rs)), int(min(cs))\n                shp = {(int(r - r00), int(c - c00)) for r, c in pts}\n                if shp != head_shape:\n                    continue\n                dests.append({\"pts\": pts, \"shape\": shp, \"tl\": (r00, c00)})\n\n        if not dests:\n            continue\n\n        best = None\n        best_dest = None\n        for d in dests:\n            tr0 = int(d[\"tl\"][0] - head_tl[0])\n            tc0 = int(d[\"tl\"][1] - head_tl[1])\n            if direction[0] != 0 and tc0 != 0:\n                continue\n            if direction[1] != 0 and tr0 != 0:\n                continue\n            if direction[0] == 1 and tr0 <= 0:\n                continue\n            if direction[0] == -1 and tr0 >= 0:\n                continue\n            if direction[1] == 1 and tc0 <= 0:\n                continue\n            if direction[1] == -1 and tc0 >= 0:\n                continue\n            dist = abs(tr0) + abs(tc0)\n            if best is None or dist < best:\n                best = dist\n                best_dest = d\n        if best_dest is None:\n            continue\n\n        # translation to overlap head onto destination, capped by number of GREY cells\n        tr0 = int(best_dest[\"tl\"][0] - head_tl[0])\n        tc0 = int(best_dest[\"tl\"][1] - head_tl[1])\n        steps = abs(tr0) + abs(tc0)\n\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        grey_coords = [\n            (int(r0 + 1 + rr), int(c0 + 1 + cc))\n            for rr in range(inner.shape[0])\n            for cc in range(inner.shape[1])\n            if int(inner[rr, cc]) == GREY\n        ]\n        steps = min(int(steps), int(len(grey_coords)))\n\n        dr, dc = direction\n        tr = int(dr * steps)\n        tc = int(dc * steps)\n\n        # choose which greys to fill in order from head side inward\n        if direction == (0, 1):\n            order = sorted(grey_coords, key=lambda p: (-p[1], p[0]))\n        elif direction == (0, -1):\n            order = sorted(grey_coords, key=lambda p: (p[1], -p[0]))\n        elif direction == (1, 0):\n            order = sorted(grey_coords, key=lambda p: (-p[0], -p[1]))\n        else:  # (-1,0)\n            order = sorted(grey_coords, key=lambda p: (p[0], p[1]))\n        to_fill = set(order[:steps])\n\n        # erase original container rect and original head pixels (destination stays)\n        out[r0 : r1 + 1, c0 : c1 + 1] = int(bg)\n        for r, c in head_pts:\n            if int(out[int(r), int(c)]) == int(hc):\n                out[int(r), int(c)] = int(bg)\n\n        # stamp moved container rectangle (using paste for the bulk placement)\n        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        if to_fill:\n            for rr, cc in to_fill:\n                pr = int(rr - r0)\n                pc = int(cc - c0)\n                if 0 <= pr < patch.shape[0] and 0 <= pc < patch.shape[1] and int(patch[pr, pc]) == GREY:\n                    patch[pr, pc] = int(FILL)\n        paste(out, patch, int(r0 + tr), int(c0 + tc), clip=True)\n\n        # stamp moved head pixels\n        for r, c in head_pts:\n            rrr = int(r + tr)\n            ccc = int(c + tc)\n            if 0 <= rrr < H and 0 <= ccc < W:\n                out[rrr, ccc] = int(hc)\n\n    return out\n\n# --------------- generator (attempt 2, Claude) ---------------\n\nBG = 6\nBORDER = 0\nGREY = 5\nORANGE = 7\nHEAD_COLOR = 9\n\n# Direction mapping: head_side -> (dr, dc) movement direction\n# head on top -> container moves up; head on bottom -> moves down, etc.\nSIDE_TO_DIR = {0: (-1, 0), 1: (1, 0), 2: (0, -1), 3: (0, 1)}\n\n\ndef _interior_fill_order(inner_h: int, inner_w: int, head_side: int) -> list[tuple[int, int]]:\n    \"\"\"Return interior cell coords (local to inner rect) in fill order from head-facing side inward.\n    Matches the solver's grey sort keys exactly.\"\"\"\n    cells = [(r, c) for r in range(inner_h) for c in range(inner_w)]\n    if head_side == 3:    # right, direction (0,1): key (-col, row)\n        cells.sort(key=lambda p: (-p[1], p[0]))\n    elif head_side == 2:  # left, direction (0,-1): key (col, -row)\n        cells.sort(key=lambda p: (p[1], -p[0]))\n    elif head_side == 1:  # bottom, direction (1,0): key (-row, -col)\n        cells.sort(key=lambda p: (-p[0], -p[1]))\n    else:                 # top, direction (-1,0): key (row, col)\n        cells.sort(key=lambda p: (p[0], p[1]))\n    return cells\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n_containers = random.randint(2, 4)\n    n_decoys = random.choice([0, 0, 1])  # 0 or 1, slight bias toward 0\n    n_movers = n_containers - n_decoys\n    if n_movers < 1:\n        n_movers = 1\n        n_decoys = n_containers - 1\n\n    # Build container specs\n    specs = []\n    for i in range(n_containers):\n        is_decoy = (i >= n_movers)\n        inner_h = random.randint(1, 8)\n        inner_w = random.randint(1, 5)\n        inner_area = inner_h * inner_w\n        head_side = random.randint(0, 3)\n        outer_h = inner_h + 2\n        outer_w = inner_w + 2\n\n        if is_decoy:\n            initial_orange = inner_area\n            grey = 0\n            gap = random.randint(0, 6)\n            steps = 0\n        else:\n            grey = random.randint(1, inner_area)\n            initial_orange = inner_area - grey\n            gap = random.randint(0, 10)\n            h2d = gap + 1\n            steps = min(grey, h2d)\n\n        # Head length = container edge length along head direction\n        if head_side in (0, 1):\n            head_len = outer_w\n        else:\n            head_len = outer_h\n\n        specs.append({\n            'inner_h': inner_h, 'inner_w': inner_w,\n            'outer_h': outer_h, 'outer_w': outer_w,\n            'head_side': head_side, 'gap': gap, 'steps': steps,\n            'initial_orange': initial_orange, 'grey': grey,\n            'head_len': head_len, 'is_decoy': is_decoy,\n        })\n\n    # Compute assembly bounding boxes (in input position)\n    # Assembly = dest_line + gap + head_line + container\n    assemblies = []\n    for s in specs:\n        oh, ow = s['outer_h'], s['outer_w']\n        hs = s['head_side']\n        gap = s['gap']\n\n        if hs == 0:  # top: dest above head above container\n            total_h = 1 + gap + 1 + oh  # dest + gap + head + container\n            total_w = ow\n            cont_r = gap + 2  # container top row within assembly\n            cont_c = 0\n        elif hs == 1:  # bottom: container above head above dest\n            total_h = oh + 1 + gap + 1\n            total_w = ow\n            cont_r = 0\n            cont_c = 0\n        elif hs == 2:  # left: dest left of head left of container\n            total_h = oh\n            total_w = 1 + gap + 1 + ow\n            cont_r = 0\n            cont_c = gap + 2\n        else:  # right: container left of head left of dest\n            total_h = oh\n            total_w = ow + 1 + gap + 1\n            cont_r = 0\n            cont_c = 0\n\n        assemblies.append({**s, 'total_h': total_h, 'total_w': total_w,\n                           'cont_r': cont_r, 'cont_c': cont_c})\n\n    # Determine grid size\n    total_area = sum(a['total_h'] * a['total_w'] for a in assemblies)\n    min_side = max(8, int(total_area ** 0.5) + 2)\n    max_side = min(26, min_side + 8)\n    max_asm_h = max(a['total_h'] for a in assemblies)\n    max_asm_w = max(a['total_w'] for a in assemblies)\n\n    lo_h = max(8, max_asm_h + 2)\n    hi_h = max(lo_h, min(26, max_side + 4))\n    lo_w = max(8, max_asm_w + 2)\n    hi_w = max(lo_w, min(26, max_side + 4))\n\n    if lo_h > 26 or lo_w > 26:\n        return None\n\n    grid_h = random.randint(lo_h, min(26, hi_h))\n    grid_w = random.randint(lo_w, min(26, hi_w))\n\n    # Place assemblies with 1-cell bg gap between them\n    occupied = np.zeros((grid_h, grid_w), dtype=bool)\n    placements = []\n\n    for a in assemblies:\n        th, tw = a['total_h'], a['total_w']\n        if th > grid_h or tw > grid_w:\n            return None\n        placed = False\n        for _ in range(300):\n            r0 = random.randint(0, grid_h - th)\n            c0 = random.randint(0, grid_w - tw)\n            cr0 = max(0, r0 - 1)\n            cc0 = max(0, c0 - 1)\n            cr1 = min(grid_h, r0 + th + 1)\n            cc1 = min(grid_w, c0 + tw + 1)\n            if not occupied[cr0:cr1, cc0:cc1].any():\n                occupied[r0:r0+th, c0:c0+tw] = True\n                placements.append((r0, c0))\n                placed = True\n                break\n        if not placed:\n            return None\n\n    # Build input grid\n    grid = np.full((grid_h, grid_w), BG, dtype=int)\n\n    for a, (pr, pc) in zip(assemblies, placements):\n        oh, ow = a['outer_h'], a['outer_w']\n        hs = a['head_side']\n        gap = a['gap']\n        steps = a['steps']\n        inner_h, inner_w = a['inner_h'], a['inner_w']\n        initial_orange = a['initial_orange']\n\n        # Container top-left in grid coords\n        cr = pr + a['cont_r']\n        cc = pc + a['cont_c']\n\n        # Draw container border\n        grid[cr, cc:cc+ow] = BORDER\n        grid[cr+oh-1, cc:cc+ow] = BORDER\n        grid[cr:cr+oh, cc] = BORDER\n        grid[cr:cr+oh, cc+ow-1] = BORDER\n\n        # Fill interior\n        fill_order = _interior_fill_order(inner_h, inner_w, hs)\n        interior = np.full((inner_h, inner_w), GREY, dtype=int)\n        for idx_cell in range(initial_orange):\n            r, c = fill_order[idx_cell]\n            interior[r, c] = ORANGE\n        grid[cr+1:cr+1+inner_h, cc+1:cc+1+inner_w] = interior\n\n        # Draw head line\n        if hs == 0:\n            grid[cr-1, cc:cc+ow] = HEAD_COLOR\n        elif hs == 1:\n            grid[cr+oh, cc:cc+ow] = HEAD_COLOR\n        elif hs == 2:\n            grid[cr:cr+oh, cc-1] = HEAD_COLOR\n        else:\n            grid[cr:cr+oh, cc+ow] = HEAD_COLOR\n\n        # Draw dest line\n        if hs == 0:\n            grid[cr-2-gap, cc:cc+ow] = HEAD_COLOR\n        elif hs == 1:\n            grid[cr+oh+1+gap, cc:cc+ow] = HEAD_COLOR\n        elif hs == 2:\n            grid[cr:cr+oh, cc-2-gap] = HEAD_COLOR\n        else:\n            grid[cr:cr+oh, cc+ow+1+gap] = HEAD_COLOR\n\n    # Validate with solver\n    try:\n        output = main(grid)\n    except Exception:\n        return None\n\n    # Build expected output manually and compare\n    expected = grid.copy()\n    for a, (pr, pc) in zip(assemblies, placements):\n        oh, ow = a['outer_h'], a['outer_w']\n        hs = a['head_side']\n        steps = a['steps']\n        inner_h, inner_w = a['inner_h'], a['inner_w']\n        initial_orange = a['initial_orange']\n        dr, dc = SIDE_TO_DIR[hs]\n\n        cr = pr + a['cont_r']\n        cc = pc + a['cont_c']\n\n        if steps == 0:\n            continue\n\n        # Erase original container + head\n        expected[cr:cr+oh, cc:cc+ow] = BG\n        if hs == 0:\n            expected[cr-1, cc:cc+ow] = BG\n        elif hs == 1:\n            expected[cr+oh, cc:cc+ow] = BG\n        elif hs == 2:\n            expected[cr:cr+oh, cc-1] = BG\n        else:\n            expected[cr:cr+oh, cc+ow] = BG\n\n        # New position\n        nr = cr + dr * steps\n        nc = cc + dc * steps\n\n        # Build moved container patch with converted cells\n        fill_order = _interior_fill_order(inner_h, inner_w, hs)\n        interior = np.full((inner_h, inner_w), GREY, dtype=int)\n        for idx_cell in range(initial_orange + steps):\n            r, c = fill_order[idx_cell]\n            interior[r, c] = ORANGE\n        patch = np.full((oh, ow), BORDER, dtype=int)\n        patch[1:-1, 1:-1] = interior\n        expected[nr:nr+oh, nc:nc+ow] = patch\n\n        # Move head\n        if hs == 0:\n            expected[nr-1, nc:nc+ow] = HEAD_COLOR\n        elif hs == 1:\n            expected[nr+oh, nc:nc+ow] = HEAD_COLOR\n        elif hs == 2:\n            expected[nr:nr+oh, nc-1] = HEAD_COLOR\n        else:\n            expected[nr:nr+oh, nc+ow] = HEAD_COLOR\n\n    if not np.array_equal(output, expected):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid after 300 attempts\")\n","exit_code":0,"status":"completed"}}
