dr, dc) until hitting a wall or blocker.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:346:    \"\"\"Place 1-2 legend patches at grid corners.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:349:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:380:    \"\"\"Grow irregular closed regions, one per assigned wall color.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:383:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:440:    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:468:    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:485:    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:489:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:533:    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:556:    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:604:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/abbfd121.py:55:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/abbfd121.py:56:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/abbfd121.py:74:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/abbfd121.py:253:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/2e65ae53.py:87:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/2e65ae53.py:88:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/2e65ae53.py:103:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/2e65ae53.py:311:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:172:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:173:    \"\"\"Predict the next panel in a framed sequence by continuing each scheduled colored interval.\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:187:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:404:    \"\"\"Return full-panel masks by color index, or None if any blob fails.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:435:    \"\"\"Mutate prior panels and output with the preplaced dynamic-color masks.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:457:    \"\"\"Return tiled input only when the solver oracle matches planned output.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:502:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:208:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:209:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:224:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:324:    \"\"\"Check that mask is a single 4-connected simple closed curve with exactly one hole.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:342:    \"\"\"Interleave n_a copies of step_a with n_b copies of step_b, biased toward alternation.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:366:    \"\"\"Extend path with a straight line from its last point to end.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:378:    \"\"\"Extend path by applying a sequence of (dr, dc) deltas.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:387:    \"\"\"Fraction of direction changes along a cyclic path.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:397:    \"\"\"Generate a wobbly simple closed curve mask of size (h, w).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:445:    \"\"\"Generate a small filled blob mask (size 4-11, bbox 2x2 to 4x4).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:472:    \"\"\"Arrange children in a random layout (vertical, horizontal, or diagonal).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:514:    \"\"\"Recursively build masks and place children within frames.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:544:    \"\"\"Flatten tree into list, computing absolute positions.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:555:    \"\"\"Position an outside blob adjacent to the root frame.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:572:    \"\"\"Convert a generator _Obj (with absolute pos) to a solver _Node.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:588:    \"\"\"Compute expected solver output for the generated tree.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:607:    \"\"\"Build a random containment tree (1-2 frames, 1-4 blobs, optional outside blob).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:627:    \"\"\"Render all objects onto a padded grid. Returns None if size constraints fail.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:665:    \"\"\"Single generation attempt: build tree, render input, verify against solver.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:693:def generate_input():\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:6:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:7:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:20:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:156:\"\"\"Generator for ARC-AGI-2 task 898e7135.\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:167:\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:202:    \"\"\"Canonical bytes representation under D4 for a bool mask (tight-cropped).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:213:    \"\"\"Grow a 4-conn slot of given size starting from a random free cell.\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:215:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:240:    \"\"\"Dilate a bool mask by 1 cell (8-connectivity).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:254:    \"\"\"Mark coords and their 8-neighbors as forbidden (in-place).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:261:    \"\"\"Generate a layout grid with n_slots 4-connected slots (including n_units unit slots).\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:264:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:313:    \"\"\"Build output and input patches for one slot.\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:317:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:347:    \"\"\"Assemble the expected output grid: frame_color background with pieces placed.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:362:    \"\"\"Build the input grid: frame + scattered pieces + distractor noise.\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:364:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:492:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:8:    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:15:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:22:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:27:        \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:31:        \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:195:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:197:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:232:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:235:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:274:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:275:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:288:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:332:    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:339:    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:346:    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:378:    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:392:    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:408:    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:425:    \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:441:    \"\"\"Render a sprite onto the grid: border cells in color, hole cells in fill (if given).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:544:def generate_input():\n/home/lixinyu/snap/new/ARC_code/train/34cfa167.py:93:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/34cfa167.py:94:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/34cfa167.py:117:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/34cfa167.py:336:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
