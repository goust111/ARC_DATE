{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\"","aggregated_output":"import numpy as np\nfrom collections import Counter, deque\n\nfrom arc_utils import components_mask, get_bg, neighbors4, neighbors8\nimport random\ndef _components_mask(mask: np.ndarray, conn8: bool) -> list[list[tuple[int, int]]]:\n    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(mask, connectivity=8 if conn8 else 4)]\n\n\ndef _touches_border(pts: list[tuple[int, int]], h: int, w: int) -> bool:\n    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n\n\ndef _seed_pixels(g: np.ndarray, bg: int) -> list[tuple[int, int]]:\n    h, w = g.shape\n    vals, cnts = np.unique(g, return_counts=True)\n    seeds: list[tuple[int, int]] = []\n    for v, cnt in zip(vals, cnts):\n        v = int(v)\n        if v == bg or int(cnt) != 1:\n            continue\n        r, c = map(int, np.argwhere(g == v)[0])\n        if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n            seeds.append((r, c))\n    return seeds\n\n\ndef _nonbg_component8_from(g: np.ndarray, start: tuple[int, int], bg: int) -> set[tuple[int, int]]:\n    h, w = g.shape\n    st = [start]\n    vis = {start}\n    while st:\n        r, c = st.pop()\n        for nr, nc in neighbors8(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in vis and int(g[nr, nc]) != bg:\n                vis.add((nr, nc))\n                st.append((nr, nc))\n    return vis\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\ndef _in_bounds(h, w, r, c):\n    return 0 <= r < h and 0 <= c < w\n\n\n# ---------------------------------------------------------------------------\n# Frame geometry\n# ---------------------------------------------------------------------------\n\ndef _frame_ring_coords(r0, c0, ch, cw):\n    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n\n    Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).\n    Ring = bbox boundary minus 4 corners.\n    \"\"\"\n    H, W = ch + 2, cw + 2\n    ring = []\n    for dr in range(H):\n        for dc in range(W):\n            on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)\n            corner = (dr in (0, H - 1)) and (dc in (0, W - 1))\n            if on_bdr and not corner:\n                ring.append((r0 + dr, c0 + dc))\n    cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]\n    return ring, cavity\n\n\ndef _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n\n    Returns True if: ring and cavity cells are empty, no cavity cell is\n    8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and\n    at least one ring cell is 8-adjacent to a line_col pixel.\n    \"\"\"\n    # Ring and cavity cells must all be empty\n    for rr, cc in ring:\n        if canvas[rr, cc] != -1:\n            return False\n    for rr, cc in cavity:\n        if canvas[rr, cc] != -1:\n            return False\n\n    # No cavity cell may be 8-adjacent to any line_col pixel\n    for cr, cc in cavity:\n        for nr, nc in neighbors8(cr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return False\n\n    # Ring must not be 8-adjacent to any non-bg, non-line_col pixel\n    ring_set = set(ring)\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:\n                continue\n            v = canvas[nr, nc]\n            if v != -1 and v != line_col:\n                return False\n\n    # At least one ring cell must be 8-adjacent to a line_col pixel\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return True\n    return False\n\n\n# ---------------------------------------------------------------------------\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, components_mask, find_components, get_bg\nimport random\n\n\ndef _unique_largest_count_color(g: np.ndarray, colors: list[int]) -> int:\n    counts = [(int(np.sum(g == color)), int(color)) for color in colors]\n    max_count = max(count for count, _color in counts)\n    winners = [color for count, color in counts if count == max_count]\n    assert len(winners) == 1, \"expected one most numerous non-background obstacle color\"\n    return winners[0]\n\n\ndef _marker_bbox(g: np.ndarray, marker_colors: list[int]) -> tuple[int, int, int, int]:\n    mask = np.isin(g, marker_colors)\n    candidates: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(mask, connectivity=8):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        if r0 == 0:\n            candidates.append((r0, c0, r1, c1))\n\n    assert len(candidates) == 1, \"expected one top-edge marker component\"\n    return candidates[0]\n\n\ndef _runs(values: list[int]) -> list[tuple[int, int]]:\n    if not values:\n        return []\n\n    runs: list[tuple[int, int]] = []\n    start = prev = values[0]\n    for value in values[1:]:\n        if value == prev + 1:\n            prev = value\n            continue\n        runs.append((start, prev))\n        start = prev = value\n    runs.append((start, prev))\n    return runs\n\n\ndef _can_slide_right(base: np.ndarray, obstacle: int, bg: int, cols: list[int], marker_bottom_r: int, height: int) -> bool:\n    H, W = base.shape\n    assert cols\n    if cols[-1] + 1 >= W:\n        return False\n\n    for floor_r in range(marker_bottom_r + 1, H):\n        target_rows = np.arange(floor_r - height + 1, floor_r + 1)\n        if int(target_rows[0]) < 0:\n            continue\n\n        shifted_cols = [c + 1 for c in cols]\n        target_is_clear = all(np.all(base[target_rows, c] == bg) for c in shifted_cols)\n        if not target_is_clear:\n            continue\n\n        for c in cols:\n            if int(base[floor_r, c]) != obstacle:\n                continue\n            has_horizontal_neighbor = (\n                (c > 0 and int(base[floor_r, c - 1]) == obstacle)\n                or (c + 1 < W and int(base[floor_r, c + 1]) == obstacle)\n            )\n            if has_horizontal_neighbor:\n                return True\n\n    return False\n\n\ndef _clear_bottom_edge_gap(base: np.ndarray, out: np.ndarray, obstacle: int, bg: int, c: int, width: int) -> None:\n    H, W = base.shape\n    if int(base[H - 1, c]) != obstacle:\n        return\n\n    c1 = c\n    while c1 < W and int(base[H - 1, c1]) == obstacle:\n        c1 += 1\n\n    if c1 - c >= width:\n        out[H - 1, c + 1 : c + width] = bg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\n    Input structure\n    - The background is the dominant color.\n    - The most numerous non-background color forms stationary grey obstacle pixels.\n    - The other two colors form a single 3x3 top-edge marker whose top two rows\n      are maroon and whose bottom row contains maroon or blue control pixels.\n\n    Rule\n    - Erase the top marker.\n    - Treat each marker column as a vertical drop retaining its three colors.\n    - A column whose bottom control pixel is blue stops immediately above the\n      first grey pixel below that column, or bottom-aligns if none exists.\n    - Contiguous maroon-ended columns pass through obstacles and bottom-align;\n      if such a run has a clear down-right slide from a grey ledge, shift the\n      run one column right before bottom-aligning.\n    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n      the rest of the marker-width gap in that bottom bar.\n\n    Key insight\n    - The bottom row of the top marker is a control strip: blue cells mean\n      \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H = g.shape[0]\n    bg = int(get_bg(g))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 3, \"expected obstacle color plus two marker colors\"\n    obstacle = _unique_largest_count_color(g, non_bg)\n    marker_colors = [color for color in non_bg if color != obstacle]\n    assert len(marker_colors) == 2, \"expected exactly two marker colors\"\n\n    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)\n    marker = g[r0 : r1 + 1, c0 : c1 + 1]\n    marker_h, marker_w = marker.shape\n    assert (marker_h, marker_w) == (3, 3), \"expected a 3x3 marker\"\n    assert np.all(np.isin(marker, marker_colors)), \"marker bbox must contain only marker colors\"\n\n    pass_color = int(marker[0, 0])\n    assert np.all(marker[:2, :] == pass_color), \"top two marker rows must be the pass-through color\"\n    stop_colors = [color for color in marker_colors if color != pass_color]\n    assert len(stop_colors) == 1, \"expected one stop color\"\n    stop_color = stop_colors[0]\n\n    out = g.copy()\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    base = out.copy()\n\n    pass_columns: list[int] = []\n    for j in range(marker_w):\n        c = c0 + j\n        stack = marker[:, j]\n        bottom_control = int(stack[-1])\n\n        if bottom_control == stop_color:\n            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n            if len(obstacles_below):\n                floor_r = int(r1 + 1 + obstacles_below[0])\n                top_r = floor_r - marker_h\n            else:\n                top_r = H - marker_h\n            assert top_r >= 0, \"stopped column must fit above its obstacle\"\n            out[top_r : top_r + marker_h, c] = stack\n        else:\n            assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n            pass_columns.append(j)\n\n    for start_j, end_j in _runs(pass_columns):\n        source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n        top_r = H - marker_h\n\n        for j in range(start_j, end_j + 1):\n            c = c0 + j + shift\n            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n            out[top_r : top_r + marker_h, c] = marker[:, j]\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\nGRID_SIZE_RANGE = (14, 16)\nMARKER_SIZE = 3\nSTOP_COUNT_RANGE = (1, 3)\nOBSTACLE_COMPONENT_RANGE = (7, 9)\nOBSTACLE_PIXEL_RANGE = (20, 31)\nCOMPONENT_SIZE_RANGE = (1, 11)\nMIN_STOP_OBSTACLE_ROW = 6\nDROP_ZONE_HEIGHT = 3\nCOMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300\n\n\ndef _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:\n    grid = np.full((H, W), GEN_BG, dtype=int)\n    c0 = random.randint(0, W - MARKER_SIZE)\n    num_stops = random.randint(*STOP_COUNT_RANGE)\n    positions = list(range(MARKER_SIZE))\n    random.shuffle(positions)\n    stop_positions = sorted(positions[:num_stops])\n    marker = np.full((MARKER_SIZE, MARKER_SIZE), GEN_PASS, dtype=int)\n    for j in stop_positions:\n        marker[MARKER_SIZE - 1, j] = GEN_STOP\n    grid[0:MARKER_SIZE, c0:c0 + MARKER_SIZE] = marker\n    obstacle_pixels: set[tuple[int, int]] = set()\n    for j in stop_positions:\n        col = c0 + j\n        first_obs_row = random.randint(MIN_STOP_OBSTACLE_ROW, H - 1)\n        grid[first_obs_row, col] = GEN_OBSTACLE\n        obstacle_pixels.add((first_obs_row, col))\n    return grid, c0, stop_positions, obstacle_pixels\n\n\ndef _forbidden_cells(H: int, c0: int, stop_positions: list[int], obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]]:\n    forbidden = {(r, c) for r in range(MARKER_SIZE) for c in range(c0, c0 + MARKER_SIZE)}\n    for j in stop_positions:\n        col = c0 + j\n        for r in range(MARKER_SIZE, H):\n            if (r, col) not in obstacle_pixels:\n                continue\n            for dr in range(1, DROP_ZONE_HEIGHT + 1):\n                if r - dr >= 0:\n                    forbidden.add((r - dr, col))\n            break\n    return forbidden\n\n\ndef _sample_component_sizes(total_pixels: int, component_count: int) -> list[int] | None:\n    component_sizes = []\n    left = total_pixels\n    min_size, max_size = COMPONENT_SIZE_RANGE\n    for i in range(component_count):\n        remaining = component_count - i - 1\n        if remaining == 0:\n            size = left\n        else:\n            lo = max(min_size, left - max_size * remaining)\n            hi = min(max_size, left - min_size * remaining)\n            if lo > hi:\n                return None\n            size = random.randint(lo, hi)\n        left -= size\n        if size < min_size or size > max_size:\n            return None\n        component_sizes.append(size)\n    random.shuffle(component_sizes)\n    return component_sizes\n\n\ndef _grow_component(grid: np.ndarray, comp_size: int, forbidden: set[tuple[int, int]],\n                    obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]] | None:\n    H, W = grid.shape\n    sr, sc = random.randint(0, H - 1), random.randint(0, W - 1)\n    if (sr, sc) in forbidden or (sr, sc) in obstacle_pixels or grid[sr, sc] != GEN_BG:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import find_components, get_bg, neighbors4, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n                frontier.append((rr, cc))\n    return frontier\n\n\ndef _grow_body(area):\n    choices = [\n        (h, w)\n        for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n        for w in _inclusive_range(_BODY_WIDTH_RANGE)\n        if h * w >= area\n    ]\n    h, w = random.choice(choices)\n    cells = set(random.choice(_GROW_BODY_SEEDS))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, h, w)\n        if not frontier:\n            return _grow_body(area)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n","exit_code":0,"status":"completed"}}
