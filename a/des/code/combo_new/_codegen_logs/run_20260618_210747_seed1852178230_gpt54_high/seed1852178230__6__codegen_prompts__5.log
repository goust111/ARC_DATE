{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^# --------------- generator/p'\"' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^# --------------- generator/,/''^if __name__/p'\"' /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py\"","aggregated_output":"# --------------- generator (o5x) ---------------\n\n# Canvas, orientation, and color sampling.\nPANEL_SIZE_MIN, PANEL_SIZE_MAX = 5, 11\nPANEL_COUNT_CHOICES, ORIENTATION_CHOICES = (3, 5), (False, True)\nCOLOR_POOL, TOTAL_COLOR_CHOICES, MOTION_AXIS_CHOICES = range(10), (4, 5), (0, 1)\n\n# Template decoration density and symmetry.\nTEMPLATE_MIN_DECO_CELLS = 4\nTEMPLATE_DECO_MIN_RATIO, TEMPLATE_DECO_MAX_RATIO = 0.10, 0.30\n\n# Blob motif and growth bounds.\nBLOB_GROWTH_MIN, BLOB_GROWTH_MAX = 1, 4\nBLOB_MAX_INITIAL_CELLS, BLOB_MAX_COMPONENTS = 7, 2\nBLOB_MAX_LINE_COUNT, BLOB_MAX_WIDTH = 3, 3\nBLOB_DIRECTIONS = (-1, 1)\n\n# Dynamic-color schedules.\nSHORT_PRIOR_COUNT, MAX_DYNAMIC_COLORS = 2, 3\nSCHEDULE_ALWAYS_2 = {\"period\": 1, \"times\": [0, 1], \"scheduled\": True}\nSCHEDULE_ALWAYS_4 = {\"period\": 1, \"times\": [0, 1, 2, 3], \"scheduled\": True}\nSCHEDULE_EVEN_4 = {\"period\": 2, \"times\": [0, 2], \"scheduled\": True}\nSCHEDULE_FIRST3_4 = {\"period\": 1, \"times\": [0, 1, 2], \"scheduled\": False}\nSCHEDULE_ODD_4 = {\"period\": 2, \"times\": [1, 3], \"scheduled\": False}\nSCHEDULE_SECOND_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4)\nSCHEDULE_THIRD_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4, SCHEDULE_FIRST3_4, SCHEDULE_ODD_4)\n\n# Placement and retry limits.\nMASK_TRANSPARENT, PLACEMENT_BORDER = 0, 1\nGENERATION_RETRIES = 300\n\ndef _sym_orbits(h: int, w: int) -> list[list[tuple[int, int]]]:\n    seen: set[tuple[int, int]] = set()\n    orbits: list[list[tuple[int, int]]] = []\n    for r in range(h):\n        for c in range(w):\n            if r not in (0, h - 1) and c not in (0, w - 1):\n                continue\n            if (r, c) in seen:\n                continue\n            orbit = sorted({(r, c), (r, w - 1 - c), (h - 1 - r, c), (h - 1 - r, w - 1 - c)})\n            seen.update(orbit)\n            orbits.append(orbit)\n    return orbits\n\n\ndef _make_template(h: int, w: int, bg: int, deco: int) -> np.ndarray:\n    out = np.full((h, w), bg, dtype=int)\n    area = h * w\n    min_deco = max(TEMPLATE_MIN_DECO_CELLS, int(np.ceil(area * TEMPLATE_DECO_MIN_RATIO)))\n    max_deco = max(min_deco, int(np.floor(area * TEMPLATE_DECO_MAX_RATIO)))\n    target = random.randint(min_deco, max_deco)\n    orbits = _sym_orbits(h, w)\n    random.shuffle(orbits)\n    count = 0\n    for orbit in orbits:\n        if count >= target:\n            break\n        if count + len(orbit) > max_deco and count >= min_deco:\n            continue\n        for r, c in orbit:\n            out[r, c] = deco\n        count += len(orbit)\n    return out\n\n\ndef _base_patterns(axis_len: int, line_len: int, max_back: int) -> list[tuple[int, list[list[tuple[int, int]]]]]:\n    patterns: list[tuple[int, list[list[tuple[int, int]]]]] = []\n    for growth in range(BLOB_GROWTH_MIN, BLOB_GROWTH_MAX + 1):\n        extra = max_back * growth\n        max_initial_width = axis_len - extra\n        if max_initial_width < 1:\n            continue\n\n        for lines in range(1, min(BLOB_MAX_LINE_COUNT, line_len) + 1):\n            for width in range(1, min(BLOB_MAX_WIDTH, max_initial_width, BLOB_MAX_INITIAL_CELLS // lines) + 1):\n                patterns.append((growth, [[(0, width - 1)] for _ in range(lines)]))\n\n        if line_len >= 2 and max_initial_width >= 2:\n            for lines in range(2, min(BLOB_MAX_LINE_COUNT + 1, line_len) + 1):\n                width = min(2, max_initial_width)\n                if lines * width <= BLOB_MAX_INITIAL_CELLS and width + 1 + extra <= axis_len:\n                    patterns.append((growth, [[(i % 2, i % 2 + width - 1)] for i in range(lines)]))\n\n        if line_len >= 3 and max_initial_width >= 3:\n            tee = [[(1, 1)], [(0, 2)], [(1, 1)]]\n            if 3 + extra <= axis_len:\n                patterns.append((growth, tee))\n\n        if line_len >= 2:\n            gap = extra + 1\n            if gap + 2 + extra <= axis_len:\n                for lines in range(2, min(BLOB_MAX_LINE_COUNT, line_len) + 1):\n                    split = [[(0, 0), (gap + 1, gap + 1)] for _ in range(lines)]\n                    if 2 * lines <= BLOB_MAX_INITIAL_CELLS:\n                        patterns.append((growth, split))\n    return patterns\n\n\ndef _draw_local(\n    intervals0: list[list[tuple[int, int]]],\n    growth: int,\n    max_back: int,\n    back: int,\n    direction: int,\n    axis: int,\n) -> np.ndarray:\n    grown = max_back - back\n    width = max(end for row in intervals0 for _start, end in row) + max_back * growth + 1\n    local = np.zeros((len(intervals0), width), dtype=bool)\n    for r, row in enumerate(intervals0):\n        for start, end in row:\n            local[r, start : end + grown * growth + 1] = True\n    if direction < 0:\n        local = np.fliplr(local)\n    if axis == 0:\n        local = local.T\n    return local\n\n\ndef _make_blob(axis_len: int, line_len: int, axis: int, max_back: int) -> tuple[int, dict[int, np.ndarray]] | None:\n    patterns = _base_patterns(axis_len, line_len, max_back)\n    if not patterns:\n        return None\n    by_growth: dict[int, list[list[list[tuple[int, int]]]]] = {}\n    for growth, intervals0 in patterns:\n        by_growth.setdefault(growth, []).append(intervals0)\n    growth = random.choice(sorted(by_growth))\n    intervals0 = random.choice(by_growth[growth])\n    direction = random.choice(BLOB_DIRECTIONS)\n    masks = {\n        back: _draw_local(intervals0, growth, max_back, back, direction, axis)\n        for back in range(max_back + 1)\n    }\n    largest = masks[0]\n    if largest.shape[0] > (line_len if axis == 1 else axis_len):\n        return None\n    if largest.shape[1] > (axis_len if axis == 1 else line_len):\n        return None\n    if len(components_mask(masks[max_back], connectivity=4)) > BLOB_MAX_COMPONENTS:\n        return None\n    return growth, masks\n\n\ndef _schedules(n_prior: int, n_colors: int) -> list[dict]:\n    if n_prior == SHORT_PRIOR_COUNT:\n        return [SCHEDULE_ALWAYS_2 for _ in range(n_colors)]\n\n    schedules = [SCHEDULE_ALWAYS_4, random.choice(SCHEDULE_SECOND_CHOICES)]\n    if n_colors == MAX_DYNAMIC_COLORS:\n        schedules.append(random.choice(SCHEDULE_THIRD_CHOICES))\n    return schedules\n\n\ndef _place_masks(\n    occupied: np.ndarray,\n    local_masks: dict[int, np.ndarray],\n) -> dict[int, np.ndarray] | None:\n    largest = local_masks[0]\n    patch = np.where(largest, 1, MASK_TRANSPARENT)\n    try:\n        r0, c0 = random_free_location(\n            occupied, patch, transparent=MASK_TRANSPARENT, border=PLACEMENT_BORDER\n        )\n    except ValueError:\n        return None\n    paste(occupied, patch, r0, c0, transparent=MASK_TRANSPARENT)\n\n    out: dict[int, np.ndarray] = {}\n    for back, local in local_masks.items():\n        full = np.zeros_like(occupied, dtype=bool)\n        full[r0 : r0 + local.shape[0], c0 : c0 + local.shape[1]] = local\n        out[back] = full\n    return out\n\n\ndef _place_dynamic_masks(\n    occupied: np.ndarray,\n    n_dynamic: int,\n    schedules: list[dict],\n    motion_axis: int,\n    n_prior: int,\n    axis_len: int,\n    line_len: int,\n) -> dict[int, dict[int, np.ndarray]] | None:\n    \"\"\"Return full-panel masks by color index, or None if any blob fails.\"\"\"\n    order = list(range(n_dynamic))\n    random.shuffle(order)\n    placed: dict[int, dict[int, np.ndarray]] = {}\n    for idx in order:\n        sched = schedules[idx]\n        if sched[\"scheduled\"]:\n            max_back = max((n_prior - t) // sched[\"period\"] for t in sched[\"times\"])\n        else:\n            last = sched[\"times\"][-1]\n            max_back = max((last - t) // sched[\"period\"] for t in sched[\"times\"])\n\n        blob = _make_blob(axis_len, line_len, motion_axis, max_back)\n        if blob is None:\n            return None\n        _growth, local_masks = blob\n        full_masks = _place_masks(occupied, local_masks)\n        if full_masks is None:\n            return None\n        placed[idx] = full_masks\n    return placed\n\n\ndef _paint_dynamic_masks(\n    panels: list[np.ndarray],\n    output: np.ndarray,\n    dynamic: list[int],\n    schedules: list[dict],\n    placed: dict[int, dict[int, np.ndarray]],\n    n_prior: int,\n) -> None:\n    \"\"\"Mutate prior panels and output with the preplaced dynamic-color masks.\"\"\"\n    for idx, color in enumerate(dynamic):\n        sched = schedules[idx]\n        full_masks = placed[idx]\n        if sched[\"scheduled\"]:\n            for t in sched[\"times\"]:\n                back = (n_prior - t) // sched[\"period\"]\n                panels[t][full_masks[back]] = color\n            output[full_masks[0]] = color\n        else:\n            last = sched[\"times\"][-1]\n            for t in sched[\"times\"]:\n                back = (last - t) // sched[\"period\"]\n                panels[t][full_masks[back]] = color\n\n\ndef _assemble_valid_input(\n    panels: list[np.ndarray],\n    template: np.ndarray,\n    output: np.ndarray,\n    horizontal: bool,\n) -> np.ndarray | None:\n    \"\"\"Return tiled input only when the solver oracle matches planned output.\"\"\"\n    if horizontal:\n        inp = np.concatenate([*panels, template], axis=1)\n    else:\n        inp = np.concatenate([*panels, template], axis=0)\n\n    try:\n        predicted = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(predicted, output):\n        return None\n    return inp\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    h = random.randint(PANEL_SIZE_MIN, PANEL_SIZE_MAX)\n    w = random.randint(PANEL_SIZE_MIN, PANEL_SIZE_MAX)\n    horizontal = random.choice(ORIENTATION_CHOICES)\n    n_panels = random.choice(PANEL_COUNT_CHOICES)\n    n_prior = n_panels - 1\n\n    colors = random.sample(COLOR_POOL, random.choice(TOTAL_COLOR_CHOICES))\n    bg, deco = colors[0], colors[1]\n    dynamic = colors[2:]\n\n    template = _make_template(h, w, bg, deco)\n    occupied = np.where(template == bg, MASK_TRANSPARENT, 1)\n    motion_axis = random.choice(MOTION_AXIS_CHOICES)\n    schedules = _schedules(n_prior, len(dynamic))\n\n    panels = [template.copy() for _ in range(n_prior)]\n    output = template.copy()\n    axis_len = h - 2 if motion_axis == 0 else w - 2\n    line_len = w - 2 if motion_axis == 0 else h - 2\n\n    placed = _place_dynamic_masks(\n        occupied, len(dynamic), schedules, motion_axis, n_prior, axis_len, line_len\n    )\n    if placed is None:\n        return None\n    _paint_dynamic_masks(panels, output, dynamic, schedules, placed, n_prior)\n    return _assemble_valid_input(panels, template, output, horizontal)\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^# --------------- generator/,/''^if __name__/p'\"' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\"","aggregated_output":"# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\ndef _in_bounds(h, w, r, c):\n    return 0 <= r < h and 0 <= c < w\n\n\n# ---------------------------------------------------------------------------\n# Frame geometry\n# ---------------------------------------------------------------------------\n\ndef _frame_ring_coords(r0, c0, ch, cw):\n    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n\n    Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).\n    Ring = bbox boundary minus 4 corners.\n    \"\"\"\n    H, W = ch + 2, cw + 2\n    ring = []\n    for dr in range(H):\n        for dc in range(W):\n            on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)\n            corner = (dr in (0, H - 1)) and (dc in (0, W - 1))\n            if on_bdr and not corner:\n                ring.append((r0 + dr, c0 + dc))\n    cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]\n    return ring, cavity\n\n\ndef _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n\n    Returns True if: ring and cavity cells are empty, no cavity cell is\n    8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and\n    at least one ring cell is 8-adjacent to a line_col pixel.\n    \"\"\"\n    # Ring and cavity cells must all be empty\n    for rr, cc in ring:\n        if canvas[rr, cc] != -1:\n            return False\n    for rr, cc in cavity:\n        if canvas[rr, cc] != -1:\n            return False\n\n    # No cavity cell may be 8-adjacent to any line_col pixel\n    for cr, cc in cavity:\n        for nr, nc in neighbors8(cr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return False\n\n    # Ring must not be 8-adjacent to any non-bg, non-line_col pixel\n    ring_set = set(ring)\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:\n                continue\n            v = canvas[nr, nc]\n            if v != -1 and v != line_col:\n                return False\n\n    # At least one ring cell must be 8-adjacent to a line_col pixel\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return True\n    return False\n\n\n# ---------------------------------------------------------------------------\n# Line growth\n# ---------------------------------------------------------------------------\n\ndef _grow_line(grid, start, line_col, target_len, rng):\n    \"\"\"Grow a meandering 8-connected 1px-wide path of line_col from start.\"\"\"\n    h, w = grid.shape\n    path = [start]\n    dr_bias = 1 if start[0] < h // 2 else -1\n    dc_bias = 1 if start[1] < w // 2 else -1\n    cur = start\n    path_set = {start}\n    while len(path) < target_len:\n        # Build weighted direction list: diagonals preferred, bias-aligned boosted\n        dirs = []\n        for ddr, ddc in DIAG_DIRS:\n            aligned = (ddr == dr_bias or ddc == dc_bias)\n            w_d = DIAG_WEIGHT_ALIGNED if aligned else DIAG_WEIGHT_OTHER\n            dirs.extend([(ddr, ddc)] * w_d)\n        for ddr, ddc in ORTHO_DIRS:\n            aligned = (ddr == dr_bias and ddc == 0) or (ddc == dc_bias and ddr == 0)\n            w_d = ORTHO_WEIGHT_ALIGNED if aligned else ORTHO_WEIGHT_OTHER\n            dirs.extend([(ddr, ddc)] * w_d)\n        rng.shuffle(dirs)\n        placed = False\n        for ddr, ddc in dirs:\n            nr, nc = cur[0] + ddr, cur[1] + ddc\n            if not _in_bounds(h, w, nr, nc) or grid[nr, nc] != -1:\n                continue\n            # Keep path thin: reject if 8-adjacent to existing path (except cur)\n            if any((nnr, nnc) != cur and (nnr, nnc) in path_set\n                   for nnr, nnc in neighbors8(nr, nc)):\n                continue\n            # Strongly avoid grid border\n            if (nr == 0 or nc == 0 or nr == h - 1 or nc == w - 1) and rng.random() < BORDER_AVOIDANCE_PROB:\n                continue\n            cur = (nr, nc)\n            path.append(cur)\n            path_set.add(cur)\n            grid[nr, nc] = line_col\n            placed = True\n            break\n        if not placed:\n            if rng.random() < BIAS_FLIP_PROB:\n                dr_bias *= -1\n            if rng.random() < BIAS_FLIP_PROB:\n                dc_bias *= -1\n            break\n    return path\n\n\n# ---------------------------------------------------------------------------\n# Frame attachment\n# ---------------------------------------------------------------------------\n\ndef _halo_offsets(fh, fw):\n    \"\"\"Compute offsets around a frame bbox that lie outside it (the halo).\"\"\"\n    return [(dr, dc) for dr in range(-1, fh + 1) for dc in range(-1, fw + 1)\n            if not (0 <= dr < fh and 0 <= dc < fw)]\n\n\ndef _try_attach_frame(canvas, line_path, line_col, frame_col, rng, max_tries=FRAME_ATTACH_TRIES):\n    \"\"\"Try to place a frame loop 8-adjacent to some line pixel.\n\n    canvas is modified in place; returns (ring, cavity) or None on failure.\n    \"\"\"\n    h, w = canvas.shape\n    pad = FRAME_PLACEMENT_PAD\n    for _ in range(max_tries):\n        ch = rng.choice(CAVITY_SIZE_WEIGHTS)\n        cw = rng.choice(CAVITY_SIZE_WEIGHTS)\n        lp = rng.choice(line_path)\n        fh, fw = ch + 2, cw + 2\n        offsets = _halo_offsets(fh, fw)\n        rng.shuffle(offsets)\n        for dr, dc in offsets:\n            r0 = lp[0] - dr\n            c0 = lp[1] - dc\n            if r0 < pad or c0 < pad or r0 + fh > h - pad or c0 + fw > w - pad:\n                continue\n            ring, cavity = _frame_ring_coords(r0, c0, ch, cw)\n            if not _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n                continue\n            for rr, cc in ring:\n                canvas[rr, cc] = frame_col\n            return ring, cavity\n    return None\n\n\ndef _try_attach_distractor_frame(canvas, frame_col, rng, max_tries=DISTRACTOR_FRAME_TRIES):\n    \"\"\"Place a loop in empty space, not touching any non-bg pixel.\"\"\"\n    h, w = canvas.shape\n    for _ in range(max_tries):\n        ch = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\n        cw = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\n        fh, fw = ch + 2, cw + 2\n        r0 = rng.randint(1, h - fh - 1)\n        c0 = rng.randint(1, w - fw - 1)\n        # Check the full bbox + 1-cell margin is empty\n        ok = True\n        for rr in range(r0 - 1, r0 + fh + 1):\n            for cc in range(c0 - 1, c0 + fw + 1):\n                if _in_bounds(h, w, rr, cc) and canvas[rr, cc] != -1:\n                    ok = False\n                    break\n            if not ok:\n                break\n        if not ok:\n            continue\n        ring, _ = _frame_ring_coords(r0, c0, ch, cw)\n        for rr, cc in ring:\n            canvas[rr, cc] = frame_col\n        return True\n    return None\n\n\ndef _try_place_distractor_network(canvas, line_col, frame_colors_pool, rng):\n    \"\"\"Place a disconnected line+frame distractor (no seed).\"\"\"\n    h, w = canvas.shape\n    for _ in range(DISTRACTOR_NETWORK_TRIES):\n        r = rng.randint(2, h - 3)\n        c = rng.randint(2, w - 3)\n        if any(canvas[r + dr, c + dc] != -1 for dr in range(-1, 2) for dc in range(-1, 2)):\n            continue\n        canvas[r, c] = line_col\n        target_len = rng.randint(*DISTRACTOR_LINE_LEN)\n        path = _grow_line(canvas, (r, c), line_col, target_len, rng)\n        if len(path) < 3:\n            for pr, pc in path:\n                canvas[pr, pc] = -1\n            continue\n        attached = 0\n        for _ in range(rng.randint(*DISTRACTOR_NETWORK_FRAMES)):\n            fc = rng.choice(frame_colors_pool)\n            if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\n                attached += 1\n        if attached > 0:\n            return True\n        for pr, pc in path:\n            canvas[pr, pc] = -1\n    return False\n\n\n# ---------------------------------------------------------------------------\n# Main generator\n# ---------------------------------------------------------------------------\n\ndef _corner_config(corner_kind, h, w, rng):\n    \"\"\"Return (seed_rc, first_line_rc) for corner_kind in {TL,TR,BL,BR}.\"\"\"\n    if corner_kind == 'TL':\n        seed = (0, 0)\n        first = rng.choice([(0, 1), (1, 0)])\n    elif corner_kind == 'TR':\n        seed = (0, w - 1)\n        first = rng.choice([(0, w - 2), (1, w - 1)])\n    elif corner_kind == 'BL':\n        seed = (h - 1, 0)\n        first = rng.choice([(h - 1, 1), (h - 2, 0)])\n    elif corner_kind == 'BR':\n        seed = (h - 1, w - 1)\n        first = rng.choice([(h - 1, w - 2), (h - 2, w - 1)])\n    else:\n        raise ValueError(corner_kind)\n    return seed, first\n\n\ndef _distribute_loop_budget(num_seeds, num_attached_target, rng):\n    \"\"\"Distribute attached-loop budget across seeds, guaranteeing >= 1 each.\"\"\"\n    seed_order = list(range(num_seeds))\n    rng.shuffle(seed_order)\n    per_seed = [0] * num_seeds\n    remaining = num_attached_target\n    # Guarantee at least 1 per seed\n    while remaining > 0 and any(per_seed[i] == 0 for i in range(num_seeds)):\n        for i in seed_order:\n            if per_seed[i] == 0 and remaining > 0:\n                per_seed[i] += 1\n                remaining -= 1\n    # Distribute remainder randomly\n    while remaining > 0:\n        per_seed[rng.choice(seed_order)] += 1\n        remaining -= 1\n    return per_seed\n\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    h = rng.randint(*GRID_H_RANGE)\n    w = rng.randint(*GRID_W_RANGE)\n    bg = rng.choice(BG_COLORS)\n    palette = [c for c in range(10) if c != bg]\n    rng.shuffle(palette)\n\n    num_seeds = rng.choice(SEED_COUNT_WEIGHTS)\n    if num_seeds * 2 > len(palette):\n        return None\n\n    canvas = -np.ones((h, w), dtype=int)\n\n    seed_colors = [palette.pop() for _ in range(num_seeds)]\n    line_colors = [palette.pop() for _ in range(num_seeds)]\n\n    all_corners = ['TL', 'TR', 'BL', 'BR']\n    rng.shuffle(all_corners)\n    corners_used = all_corners[:num_seeds]\n\n    num_frame_cols = rng.randint(1, min(FRAME_COLORS_MAX, len(palette)))\n    frame_colors_pool = [palette.pop() for _ in range(num_frame_cols)]\n\n    # Grow seed lines\n    lines_info = []\n    for i in range(num_seeds):\n        seed_rc, first_rc = _corner_config(corners_used[i], h, w, rng)\n        if canvas[seed_rc] != -1 or canvas[first_rc] != -1:\n            return None\n        canvas[seed_rc] = seed_colors[i]\n        canvas[first_rc] = line_colors[i]\n        target_len = rng.randint(LINE_LEN_RANGE[0], min(LINE_LEN_RANGE[1], h + w))\n        path = _grow_line(canvas, first_rc, line_colors[i], target_len, rng)\n        if len(path) < MIN_LINE_LEN:\n            return None\n        lines_info.append((seed_colors[i], seed_rc, line_colors[i], path))\n\n    # Decide loop counts and distribute across seeds\n    total_loops_target = rng.randint(num_seeds, TOTAL_LOOPS_MAX)\n    num_distractors_target = rng.randint(0, max(0, total_loops_target - num_seeds))\n    num_attached_target = total_loops_target - num_distractors_target\n    per_seed = _distribute_loop_budget(num_seeds, num_attached_target, rng)\n\n    # Attach frames to each seed's line\n    for i, (_, _, line_col, path) in enumerate(lines_info):\n        attached = 0\n        for _ in range(per_seed[i]):\n            fc = rng.choice(frame_colors_pool)\n            if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\n                attached += 1\n        if attached == 0:\n            return None\n\n    # Place distractors\n    if rng.random() < DISTRACTOR_NETWORK_PROB:\n        _try_place_distractor_network(canvas, rng.choice(line_colors), frame_colors_pool, rng)\n    else:\n        for _ in range(rng.randint(0, DISTRACTOR_SOLO_MAX)):\n            _try_attach_distractor_frame(canvas, rng.choice(frame_colors_pool), rng)\n\n    # Finalize grid\n    grid = np.where(canvas == -1, bg, canvas).astype(int)\n\n    # Validate bg is most common color\n    vals, cnts = np.unique(grid, return_counts=True)\n    if int(vals[np.argmax(cnts)]) != bg:\n        return None\n\n    # Validate each seed color appears exactly once\n    for seed_col, _, _, _ in lines_info:\n        if int((grid == seed_col).sum()) != 1:\n            return None\n\n    # Oracle check: solver must change at least one cell\n    try:\n        out = main(grid)\n    except Exception:\n        return None\n    if np.array_equal(out, grid):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exhausted attempts\")\n","exit_code":0,"status":"completed"}}
