rect: Rect) -> np.ndarray:\n 145:     r, c, h, w = rect\n 146:     mask = np.zeros(shape, dtype=bool)\n 147:     mask[r : r + h, c : c + w] = True\n 148:     return mask\n 149: \n 150: \n 151: def _touches_all_edges(mask: np.ndarray) -> bool:\n 152:     return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())\n 153: \n 154: \n 155: def _valid_target_masks(gaps: np.ndarray, target: np.ndarray) -> bool:\n 156:     return (\n 157:         len(components_mask(gaps, connectivity=_COMPONENT_CONNECTIVITY)) == 2\n 158:         and len(components_mask(target, connectivity=_COMPONENT_CONNECTIVITY)) == 1\n 159:         and _touches_all_edges(target)\n 160:     )\n 161: \n 162: \n 163: def _make_target_configs() -> TargetConfigs:\n 164:     configs: TargetConfigs = {}\n 165:     for h in _TARGET_HEIGHTS:\n 166:         for w in _TARGET_WIDTHS:\n 167:             for s1, s2 in itertools.product(_GAP_SHAPES, repeat=2):\n 168:                 gap_area = s1[0] * s1[1] + s2[0] * s2[1]\n 169:                 fill_ratio = (h * w - gap_area) / (h * w)\n 170:                 if not _TARGET_FILL_RATIO_MIN <= fill_ratio <= _TARGET_FILL_RATIO_MAX:\n 171:                     continue\n 172:                 for r1 in range(h - s1[0] + 1):\n 173:                     for c1 in range(w - s1[1] + 1):\n 174:                         m1 = _rect_mask((h, w), (r1, c1, *s1))\n 175:                         for r2 in range(h - s2[0] + 1):\n 176:                             for c2 in range(w - s2[1] + 1):\n 177:                                 m2 = _rect_mask((h, w), (r2, c2, *s2))\n 178:                                 if np.any(m1 & m2):\n 179:                                     continue\n 180:                                 gaps = m1 | m2\n 181:                                 target = ~gaps\n 182:                                 if not _valid_target_masks(gaps, target):\n 183:                                     continue\n 184:                                 same_sh