en(marker_pts) == 4:\n 128:             # Solid 2x2 marker: recolor these pixels directly.\n 129:             block = np.zeros_like(g, dtype=bool)\n 130:             for r, c in marker_pts:\n 131:                 block[r, c] = True\n 132:             out[block & (~protect)] = eff_fill\n 133:             continue\n 134:         else:\n 135:             protect |= (g == marker) & (~legend_mask)\n 136: \n 137:         if rmin == rmax or cmin == cmax:\n 138:             continue\n 139: \n 140:         tl = (rmin, cmin)\n 141:         tr = (rmin, cmax)\n 142:         bl = (rmax, cmin)\n 143:         br = (rmax, cmax)\n 144: \n 145:         tl_anchor = _l_anchor_present(marker_pts, tl[0], tl[1], (0, 1), (1, 0))\n 146:         tr_anchor = _l_anchor_present(marker_pts, tr[0], tr[1], (0, -1), (1, 0))\n 147:         bl_anchor = _l_anchor_present(marker_pts, bl[0], bl[1], (0, 1), (-1, 0))\n 148:         br_anchor = _l_anchor_present(marker_pts, br[0], br[1], (0, -1), (-1, 0))\n 149: \n 150:         score_tlbr = int(tl_anchor) + int(br_anchor)\n 151:         score_trbl = int(tr_anchor) + int(bl_anchor)\n 152:         assert score_tlbr != 0 or score_trbl != 0, \"at least one diagonal must have an L-anchor\"\n 153:         assert score_tlbr != score_trbl, \"diagonal scores must not tie (tie-break path is unreachable)\"\n 154:         if score_tlbr > score_trbl:\n 155:             a, b = tr, bl\n 156:         else:\n 157:             a, b = tl, br\n 158: \n 159:         diamond = _diamond_mask(h, w, rmin, rmax, cmin, cmax, a, b)\n 160:         out[diamond & (~protect)] = eff_fill\n 161: \n 162:     return out\n 163: \n 164: # --------------- generator (C1) ---------------\n 165: \n 166: # ── CFG: canvas & grid ──────────────────────────────────────────────\n 167: GRID_H_RANGE = (10, 19)          # grid height bounds\n 168: GRID_W_RANGE = (10, 19)          # grid width bounds\n 169: \n 170: # ── CFG: legend ─────────────────────────────────────────────────────\n 171: LEGEND_COL_RAN