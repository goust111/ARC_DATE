lors[path_id])\n   188\t            downstream_colors[other].append(current_colors[other])\n   189\t            next_crossing[path_id] += 1\n   190\t            next_crossing[other] += 1\n   191\t            processed.add(cell)\n   192\t            progress = True\n   193\t\n   194\t        assert progress, \"crossing order is cyclic or ambiguous\"\n   195\t\n   196\t    for path_id, coords in enumerate(paths):\n   197\t        cuts = crossing_cuts[path_id]\n   198\t        if not cuts:\n   199\t            for r, c in coords:\n   200\t                out[r, c] = int(original_colors[path_id])\n   201\t            continue\n   202\t\n   203\t        for r, c in coords[: cuts[0]]:\n   204\t            out[r, c] = int(original_colors[path_id])\n   205\t\n   206\t        for idx, cut in enumerate(cuts):\n   207\t            color = int(downstream_colors[path_id][idx])\n   208\t            next_cut = cuts[idx + 1] if idx + 1 < len(cuts) else len(coords)\n   209\t            for r, c in coords[cut + 1 : next_cut]:\n   210\t                out[r, c] = color\n   211\t\n   212\t    for (r, c), color in crossing_colors.items():\n   213\t        out[r, c] = int(color)\n   214\t\n   215\t    return out\n   216\t\n   217\t\n   218\tdef main(grid: np.ndarray) -> np.ndarray:\n   219\t    \"\"\"\n   220\t    Repaint orthogonal paths by swapping the carried colors at grey crossing switches.\n   221\t\n   222\t    Input structure:\n   223\t    - The background is black.\n   224\t    - Foreground objects are one-pixel-wide 4-connected orthogonal paths with no branching outside crossings.\n   225\t    - A crossing is a shared pixel where exactly two paths overlap; that pixel is shown in grey and has four neighbors.\n   226\t    - Each path has one visible color away from crossings and meets an even number of crossings.\n   227\t\n   228\t    Rule:\n   229\t    - Recover every original path by tracing between its two endpoints, continuing straight through each grey 4-way crossing.\n   2