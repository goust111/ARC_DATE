/lixinyu/snap/new/ceshi/code/dfadab01/D3/2/code.py:36:#      non-overlapping and prevents accidental cross-pairings between different markers of the same\n/home/lixinyu/snap/new/ceshi/code/7b3084d4/D4/0/code.py:273:    if FEATURE == \"cross5\":\n/home/lixinyu/snap/new/ceshi/code/7b3084d4/D4/0/code.py:413:    if FEATURE == \"cross5\":\n/home/lixinyu/snap/new/ceshi/code/64efde09/D4/2/code.py:39:#     - The repeated-color pattern is controlled to exactly two distinct colors across three\n/home/lixinyu/snap/new/ceshi/code/97d7923e/D1/0/code.py:36:#   small shared cap palette across multiple fill groups and mixes at least two cap colors inside\n/home/lixinyu/snap/new/ceshi/code/97d7923e/D1/0/code.py:53:#   - Fill colors are distinct across groups and disjoint from all cap colors, preventing accidental\n/home/lixinyu/snap/new/ceshi/code/97d7923e/D1/0/code.py:58:#   Endpoint colors are deliberately unreliable because the same cap colors are reused across\n/home/lixinyu/snap/new/ceshi/code/97d7923e/D1/0/code.py:168:    - Bars in one logical group share the same interior fill color F, while cap colors may repeat across groups.\n/home/lixinyu/snap/new/ceshi/code/97d7923e/D1/0/code.py:204:MAX_TOTAL_BARS = 10          # max bars across all groups\n/home/lixinyu/snap/new/ceshi/code/97d7923e/D1/0/code.py:206:MIN_CAP_COLORS = 2           # use a shared, smaller cap palette to force cross-group reuse\n/home/lixinyu/snap/new/ceshi/code/97d7923e/D1/0/code.py:231:    \"\"\"Distribute bar columns across groups with random inter-group spacing.\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:20:#       - two or three teal plus-sign crosses, each with a black center hole\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:21:#       - every cross keeps the original equal arm-length constraint\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:27:#       - walkers are stepped in visible reading order of cross centers; this makes\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:30:#     - In the single-cross task, the empty center hole is unique and the solver can\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:33:#       detect every local plus-sign pattern and spawn four walkers per cross.\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:34:#     - Example: with two arm-2 crosses, the original logic would pick one dominant\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:35:#       row/column pair and ignore the second cross entirely; the new logic finds\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:44:#     - argmax(row_counts) / argmax(col_counts) assumed one cross; now it misses the\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:47:#       unchanged would let one cross erase or add cells that belong to another.\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:49:#       stored per detected cross.\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:51:#     - Generator places centers far enough apart that input crosses never overlap,\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:54:#       output cells, so no cross is reduced to noise.\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:56:#     - Priority is based on reading order of the visible cross holes, not on hidden\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:83:def _find_crosses(grid: np.ndarray) -> list[dict]:\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:86:    crosses = []\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:108:                crosses.append({\"center\": (r, c), \"arm_len\": lengths[0], \"arms\": arms})\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:109:    crosses.sort(key=lambda cross: cross[\"center\"])\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:110:    return crosses\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:117:    crosses = _find_crosses(grid)\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:118:    if len(crosses) < 2:\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:119:        raise ValueError(\"expected at least two crosses\")\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:123:    for src, cross in enumerate(crosses):\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:124:        for cells in cross[\"arms\"].values():\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:157:    for src, cross in enumerate(crosses):\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:159:            cells = cross[\"arms\"][outward]\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:263:        \"crosses\": crosses,\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:275:    Launch clockwise spiral walls from every teal cross and let them compete for space.\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:278:    - bg = 0 (black). Two or more teal (8) plus-sign crosses appear in the same square grid.\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:279:    - Each cross has a black center hole and four equal cardinal arms.\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:282:    - Detect every cross, sort the center holes in reading order, and start one agent from each arm tip.\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:283:    - Each agent keeps the original motion policy: turn right > go straight > turn left, with left forbidden on the border; straight moves are length 2 except immediately after a turn when they shrink to 1; arm-length-1 crosses still take the initial outward step.\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:294:    \"\"\"Build a grid containing multiple plus-sign crosses with center holes.\"\"\"\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:323:    owner_counts = [meta[\"owner_counts\"][i] for i in range(len(meta[\"crosses\"]))]\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:325:        \"num_crosses\": len(meta[\"crosses\"]),\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:326:        \"arm_lengths\": [cross[\"arm_len\"] for cross in meta[\"crosses\"]],\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:338:    num_crosses = 2 if arm == ARM_LEN_MAX else random.choice(NUM_CROSSES_CHOICES)\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:353:            if len(centers) == num_crosses:\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:355:        if len(centers) < num_crosses:\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:360:        owner_counts = [meta[\"owner_counts\"][i] for i in range(len(meta[\"crosses\"]))]\n/home/lixinyu/snap/new/ceshi/code/da515329/D13/1/code.py:363:        if len(meta[\"crosses\"]) != num_crosses:\n/home/lixinyu/snap/new/ceshi/code/5961cc34/D12/0/code.py:30:#    object types or hidden state. Uniform sampling across the four inward directions ensures\n/home/lixinyu/snap/new/ceshi/code/5961cc34/D12/0/code.py:45:#    The same occupancy, dilation, and ray-intersection checks keep blobs separated and stop\n/home/lixinyu/snap/new/ceshi/code/5961cc34/D12/0/code.py:49:#    output always extends red away from that cap into the grid. Across a few examples, the\n/home/lixinyu/snap/new/ceshi/code/db695cfb/D8/2/code.py:51:#       cross-segment magenta diagonals that could confuse line-color detection.\n/home/lixinyu/snap/new/ceshi/code/7b3084d4/D4/1/code.py:273:    if FEATURE == \"cross5\":\n/home/lixinyu/snap/new/ceshi/code/7b3084d4/D4/1/code.py:413:    if FEATURE == \"cross5\":\n/home/lixinyu/snap/new/ceshi/code/97d7923e/D14/0/code.py:201:MAX_TOTAL_BARS = 10          # max bars across all groups\n/home/lixinyu/snap/new/ceshi/code/97d7923e/D14/0/code.py:223:    \"\"\"Distribute bar columns across groups with random inter-group spacing.\n/home/lixinyu/snap/new/ceshi/code/dfadab01/D3/4/code.py:16:   - Real controls are no longer one colored pixel. Each control is now a small cross:\n/home/lixinyu/snap/n