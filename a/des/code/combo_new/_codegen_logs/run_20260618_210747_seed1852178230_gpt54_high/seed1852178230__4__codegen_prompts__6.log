\"] != b[\"candidate_idx\"])\n/home/lixinyu/snap/new/ceshi/code_combo/35ab12c3/27/code.py:831:        obstacle_candidate_switches += local_switches\n/home/lixinyu/snap/new/ceshi/code_combo/35ab12c3/27/code.py:841:        \"obstacle_candidate_switches\": obstacle_candidate_switches,\n/home/lixinyu/snap/new/ceshi/code_combo/35ab12c3/27/code.py:900:    if obstacle_effect_mode == \"switch\" and metrics[\"obstacle_candidate_switches\"] < 1:\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:217:def _gen_walk_score(band_dim, cross_dim, n_boundaries, amp, pct_range):\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:218:    cells = band_dim * cross_dim\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:225:        if _gen_walk_count(cross_dim, amp, WALK_START_POS, WALK_START_LAST, score, 0, 0)\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:232:def _gen_horizontal_grid(colors, thicknesses, cross_dim, offsets):\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:277:def _gen_boundary_offsets(thicknesses, cross_dim):\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:287:    base_score = _gen_walk_score(band_dim, cross_dim, n_boundaries, base_amp, pct_range)\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:290:    base = _gen_walk(cross_dim, base_score, base_amp)\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:297:            delta = np.zeros(cross_dim, dtype=int)\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:299:            max_score = min(max(1, cross_dim // DELTA_SCORE_CROSS_DIVISOR), cross_dim - 1)\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:301:            delta = _gen_walk(cross_dim, delta_score, amp)\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:315:    cross_range = HORIZONTAL_CROSS_DIM_RANGE if axis == HORIZONTAL_AXIS else VERTICAL_CROSS_DIM_RANGE\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:316:    cross_dim = random.randint(*cross_range)\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:318:    return colors, axis, thicknesses, cross_dim\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:321:def _gen_oriented_candidate(colors, axis, thicknesses, cross_dim, offsets):\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:323:    canonical = _gen_horizontal_grid(colors, thicknesses, cross_dim, offsets)\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:343:    colors, axis, thicknesses, cross_dim = _gen_sample_layout()\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:345:    offsets = _gen_boundary_offsets(thicknesses, cross_dim)\n/home/lixinyu/snap/new/ARC1_code/train/4be741c5.py:349:    grid, expected = _gen_oriented_candidate(colors, axis, thicknesses, cross_dim, offsets)\n/home/lixinyu/snap/new/ceshi/code_combo/58f5dbd5/17/code.py:48:#      slot. Because the largest motif bbox is 5x5, components never touch across slots.\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/7/code.py:40:# - Every generated puzzle contains all three widths across the four frames, so the D3 signal is\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/7/code.py:43:#   visually consistent instead of spreading evidence across too many placements.\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/7/code.py:67:# - The counting rule remains color equality, which is stable across examples and easy to compare.\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/7/code.py:225:    \"\"\"Distribute total_match across frames while keeping at least three active frames.\"\"\"\n/home/lixinyu/snap/new/ARC1_code/train/3af2c5a8.py:6:    Mirror the entire input across both axes to form a two-by-two reflected pattern.\n/home/lixinyu/snap/new/ARC1_code/train/3af2c5a8.py:18:    - The output is not object-based; the whole grid is the tile, and the larger grid is formed by reflecting that tile across the central row and column.\n/home/lixinyu/snap/new/ceshi/code_combo/35ab12c3/8/code.py:17:#      before the first blocker instead of crossing it.\n/home/lixinyu/snap/new/ceshi/code_combo/291dc1e1/42/code.py:76:- Across a few samples, a human sees the same ordering cue as the base task, but the output now has\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/22/code.py:30:#   1. Input layout becomes a 2x2 frame arrangement, so color-matching must work across both rows\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/22/code.py:51:#   moving sprites into the same overall bounding box. The solver therefore switches to an exact\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/22/code.py:66:# - A human can see two persistent signals across examples:\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/22/code.py:222:    \"\"\"Distribute counts across 4 frames with cap 2 and at least MIN_ACTIVE_FRAMES active.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/7c66cb00/18/code.py:51:#    - Fills remain unique across bars and every sprite uses exactly one fill color,\n/home/lixinyu/snap/new/ceshi/code_combo/7c66cb00/18/code.py:199:    - Each bar uses one fill color across cols 1..W-2 and one border color on the two side cells.\n/home/lixinyu/snap/new/ceshi/code_combo/58f5dbd5/15/code.py:49:# - Concrete example: if a red motif has True cells across a 4x4 bbox, the old rule would\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/17/code.py:68:    switches to an exact hollow-rectangle test with the generator's fixed size.\n/home/lixinyu/snap/new/ceshi/code_combo/898e7135/25/code.py:107:#     - Across examples, humans can see two outside-object classes: hollow contours that reappear as\n/home/lixinyu/snap/new/ceshi/code_combo/35ab12c3/24/code.py:13:#      - color 1: a horizontal bar A is drawn first and fills across the center.\n/home/lixinyu/snap/new/ceshi/code_combo/35ab12c3/24/code.py:19:#        would continue through the crossing and reach its far endpoint.\n/home/lixinyu/snap/new/ceshi/code_combo/35ab12c3/24/code.py:30:#      so the solver must make it explicit and the generator must create crossings where the\n/home/lixinyu/snap/new/ceshi/code_combo/35ab12c3/24/code.py:51:#    vary, but the same colors repeatedly win or lose crossings in a consistent hierarchy.\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/25/code.py:16:#      roads intersect several vertical roads, producing visible crossroads. Markers still sit\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/25/code.py:28:#      new rule: start on a row road -> enter an intersection -> if both forward and \"left\"\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/25/code.py:30:#      intersection take right -> stop exactly when the trace reaches the finish-colored cell.\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/25/code.py:59:#      inside the network at crossroads before reaching the finish pixel.\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/25/code.py:409:    - Path area: a thin network of horizontal and vertical corridors with visible intersections.\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/25/code.py:418:    Key insight: The route is determined by local corridor topology, not by ray collisions. The solver must read crossroads as decision points and use the alternating left/right side preference to pick a path through the grid toward the explicit target.\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/25/code.py:526:    intersections = 0\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/25/code.py:538:                intersections += 1\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/25/code.py:539:    return intersections >= 4\n/home/lixinyu/snap/new/ceshi/code_combo/0934a4d8/25/code.py:20:#      color 8, and that L must cross the active symmetry axis.\n/home/lixinyu/snap/new/ceshi/code_combo/0934a4d8/25/code.py:36:#    - The marker always crosses the active axis and every accepted sample has both\n/home/lixinyu/snap/new/ceshi/code_combo/0934a4d8/25/code.py:43:#    - \"marker = unique filled rectangle\" is false. Detection must switch to \"one\n/home/lixinyu/snap/new/ceshi/code_combo/0934a4d8/25/code.py:53:#      L crosses the axis, doubly hidden pairs can appear in the middle; generator\n/home/lixinyu/snap/new/ceshi/code_combo/0934a4d8/25/code.py:60:#    - The occupied cells truly cross the chosen axis, at least one marked cell has\n/home/lixinyu/snap/new/ceshi/code_combo/0934a4d8/25/code.py:67:#    - Across examples, humans can see exactly one global mirror direction and one\n/home/lixinyu/snap/new/ceshi/code_combo/0934a4d8/25/code.py:73:#      axis-crossing interaction is behaviorally supported instead of being latent.\n/home/lixinyu/snap/new/ceshi/code_combo/0934a4d8/25/code.py:206:def _crosses_axis_cells(cells: set[tuple[int, int]], axis: str, lo: int, n: int) -> bool:\n/home/lixinyu/snap/new/ceshi/code_combo/0934a4d8/25/code.py:227:    - For each marked cell, copy the value from its mirror partner across the active axis when that partner is visible; otherwise read the synchronized transpose witness at `(c, r)`.\n/home/lixinyu/snap/new/ceshi/code_combo/0934a4d8/25/code.py:230:    The fused challenge is not just \"find a different shape\" or \"find a different axis\" independently. The L crosses the only mirror axis, which creates a mix of easy cells and doubly hidden mirror pairs inside one crop, so the solver must identify the active axis, track the exact L footprint, and switch to transpose only where direct mirroring is blocked by the shape itself.\n/home/lixinyu/snap/new/ceshi/code_combo/0934a4d8/25/code.py:236:    assert _crosses_axis_cells(cells, axis, lo, int(g.shape[0]))\n/home/lixinyu/snap/new/ceshi/code_combo/0934a4d8/25/code.py:390:    if not _crosses_axis_cells(cells, axis, _LO, _N):\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/6/code.py:39:#       across samples instead of collapsing to the original width every time.\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/6/code.py:249:    Distribute matches across frames while respecting width-derived capacities.\n/home/lixinyu/snap/new/ceshi/code_combo/7c66cb00/8/code.py:42:#      that, so frame detection must switch to connected-component bbox validation.\n/home/lixinyu/snap/new/ceshi/code_combo/7c66cb00/8/code.py:240:    is transferred intact as a single object rather than recolored or split across targets.\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/15/code.py:220:    \"\"\"Distribute total_match sprites across n_frames, each capped at MAX_DOTS_PER_FRAME.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/898e7135/26/code.py:242:    - The puzzle no longer asks for cross-piece shape matching: color already specifies which piece belongs to which slot,\n/home/lixinyu/snap/new/ceshi/code_combo/7c66cb00/1/code.py:42:#      2. The sprite is still docked as one object, not split across multiple bars.\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/14/code.py:155:    \"\"\"Distribute total matching sprites across frames, capped per frame.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/8/code.py:37:#      That is easy to observe and repeats across samples.\n/home/lixinyu/snap/new/ceshi/code_combo/58f5dbd5/16/code.py:60:#    - Both new cues are local and countable: repeated connector colors across regions\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/5/code.py:22:#   known, ensuring enough empty space for the full intended outward run without crossing the grid\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/5/code.py:27:#   regimes are sampled, so the fused rule is observable across examples.\n/home/lixinyu/snap/new/ceshi/code_combo/0934a4d8/24/code.py:51:#    width changes across samples, so the symmetry axis must be inferred rather than\n/home/lixinyu/snap/new/ARC1_code/train/a2fd1cf0.py:20:    - Paint teal background cells across the red marker's row until reaching the green marker's column.\n/home/lixinyu/snap/new/ARC1_code/train/1caeab9d.py:59:    # This has to be the same across all three colors, because we concatenate them along the x axis\n/home/lixinyu/snap/new/ceshi/code_combo/35ab12c3/3/code.py:16:#      a shape, the solver advances one global dash phase across all non-vertex path\n/home/lixinyu/snap/new/ARC1_code/train/e48d4e1a.py:10:# In the input, you will see a 10x10 black grid. The grid has one row and one column colored solidly in a single color, forming a cross of that color across the grid. The grid also has H grey pixels in the rightmost column at the top of the grid.\n/home/lixinyu/snap/new/ARC1_code/train/e48d4e1a.py:11:# To create the output, convert the H grey pixels to be black. Then shift the \"cross\" H pixels to the left and H pixels down.\n/home/lixinyu/snap/new/ARC1_code/train/e48d4e1a.py:15:    Move a colored cross left and downward by the gray counter value.\n/home/lixinyu/snap/new/ARC1_code/train/e48d4e1a.py:24:    - Find the colored cross row, column, and color.\n/home/lixinyu/snap/new/ARC1_code/train/e48d4e1a.py:25:    - Recreate the cross on black after moving the row down and the column left by that count.\n/home/lixinyu/snap/new/ARC1_code/train/e48d4e1a.py:29:      how far to shift the cross.\n/home/lixinyu/snap/new/ARC1_code/train/e48d4e1a.py:34:    # 2. find the row and column of the cross, and its color.\n/home/lixinyu/snap/new/ARC1_code/train/e48d4e1a.py:46:    # create the output grid by recreating the cross at the new location\n/home/lixinyu/snap/new/ARC1_code/train/e48d4e1a.py:60:    # choose a column/row and color for the cross such that shifting by H stays in-bounds\n/home/lixinyu/snap/new/ceshi/code_combo/58f5dbd5/9/code.py:28:#      area, so the visible hole cuts across whichever pattern colors lie under it.\n/home/lixinyu/snap/new/ceshi/code_combo/58f5dbd5/9/code.py:59:#    - Using one shared accent color across the block region makes the pattern family read coherently, while the\n/home/lixinyu/snap/new/ceshi/code_combo/58f5dbd5/9/code.py:658:    \"\"\"Return whether the centered carving mask crosses both colors of the intact pattern tile.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/7c66cb00/11/code.py:28:#      creating multiple descendants across bars.\n/home/lixinyu/snap/new/ceshi/code_combo/7c66cb00/11/code.py:64:#      A