{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/136b0064.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg\nimport random\n\n\ndef find_full_height_constant_col(grid: np.ndarray, *, bg: int | None = None) -> tuple[int | None, int | None]:\n    \"\"\"\n    Local helper (only used by this solver): find a column where all values are identical and != bg.\n    Returns (col_idx, color) or (None, None).\n    \"\"\"\n    H, W = grid.shape\n    if bg is None:\n        bg = get_bg(grid)\n    bg = int(bg)\n\n    for c in range(int(W)):\n        col = grid[:, int(c)]\n        if (col == col[0]).all() and int(col[0]) != bg:\n            return int(c), int(col[0])\n    return None, None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Draw a polyline by decoding 3x3 glyph instructions read across a divided grid.\n\n    Input structure:\n    - Left of a full-height vertical divider: 3x3 colored glyphs on bg.\n    - Right of divider: a single gray (5) start pixel.\n\n    Rule:\n    - Remove the divider; shift the gray start into the left canvas.\n    - Read glyphs in column-major order (left→right, top→bottom).\n    - Each glyph's shape (pixel area) encodes a segment: area 4 → down 2, area 5 → right 3, area 6 → left 4, area 7 → left 2.\n    - Append segments sequentially, stepping down one cell between each.\n\n    Key insight: Glyph pixel count (area) uniquely determines both segment length and direction — the shape itself is the instruction.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # Divider is a full-height constant non-bg column.\n    div_c, div_color = find_full_height_constant_col(g, bg=bg)\n    assert div_c is not None\n\n    out = np.zeros((H, int(div_c)), dtype=int)\n\n    # Move gray start from right side into left canvas (remove divider col too).\n    gray = np.argwhere(g == 5)\n    if gray.size == 0:\n        return out\n    r_cur, c_cur = map(int, gray[0])\n    c_cur = int(c_cur - (int(div_c) + 1))\n    if not (0 <= c_cur < int(div_c)):\n        return out\n    out[int(r_cur), int(c_cur)] = 5\n\n    # Collect 3x3 glyph components on the left.\n    left = g[:, : int(div_c)]\n    ignore = {int(bg), 5}\n    if div_color is not None:\n        ignore.add(int(div_color))\n\n    glyphs: list[dict[str, int]] = []\n    for comp in find_components(left, bg=bg, connectivity=8, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        if col in ignore:\n            continue\n        b = comp[\"bbox\"]\n        if bbox_h(b) == 3 and bbox_w(b) == 3:\n            r0, c0, _r1, _c1 = map(int, b)\n            glyphs.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"area\": int(comp[\"area\"])})\n\n    glyphs.sort(key=lambda d: (int(d[\"c0\"]), int(d[\"r0\"])))\n\n    area_to_len = {4: 2, 5: 3, 6: 4, 7: 2}\n    area_to_dir = {5: 1, 6: -1, 7: -1}  # diamond right; cross/U left\n\n    for glyph in glyphs:\n        color = int(glyph[\"color\"])\n        area = int(glyph[\"area\"])\n        seg_len = int(area_to_len.get(area, 2))\n\n        r_cur = int(r_cur + 1)\n        assert r_cur < H, f\"segment exits bottom: r_cur={r_cur}, H={H}\"\n        out[r_cur, int(c_cur)] = color\n\n        if area == 4:  # vertical (down)\n            end_r = r_cur + (seg_len - 1)\n            assert end_r < H, f\"vertical segment exits bottom: end_r={end_r}, H={H}\"\n            for _ in range(seg_len - 1):\n                r_cur = int(r_cur + 1)\n                out[r_cur, int(c_cur)] = color\n        else:  # horizontal\n            dir_h = int(area_to_dir.get(area, 1))\n            end_c = int(c_cur) + dir_h * (seg_len - 1)\n            assert 0 <= end_c < int(div_c), (\n                f\"horizontal segment exits canvas: c_cur={c_cur}, dir={dir_h}, \"\n                f\"seg_len={seg_len}, div_c={div_c}\"\n            )\n            for _ in range(seg_len - 1):\n                c_cur = int(c_cur + dir_h)\n                out[r_cur, c_cur] = color\n\n    return out\n\n# --------------- generator (attempt 1 (Claude)) ---------------\n\n# --- canvas geometry ---\nN_MIN, N_MAX = 2, 5            # number of tile rows; H = 4*N - 1, num_glyphs = 2*N\nGRID_W = 15                    # full input width\nDIVIDER_COL = 7                # divider position (col), full-height\nDIVIDER_COLOR = 4              # divider fill color\nLEFT_W = 7                     # left canvas width (cols 0..6)\nTILE_COLS = (0, 4)             # 3x3 tile c0 positions on the left\nTILE_ROW_STRIDE = 4            # row spacing between successive tile slots\nGRAY = 5                       # start-pixel color\nGRAY_START_ROW = 0             # gray start always sits at row 0 [observed]\n\n# --- shape grammar (area -> 3x3 template, color, and (dr, dc) walk delta) ---\n# Walk delta = total (row, col) displacement caused by one glyph instruction:\n#   step down 1 then segment of (len, dir). E.g. area 4 (vertical len 2) => (+2, 0).\n_TEMPLATES = {\n    4: np.array([[1, 0, 1], [0, 1, 0], [0, 1, 0]], dtype=int),  # plus    -> down 2,  color 6\n    5: np.array([[1, 1, 0], [1, 0, 1], [0, 1, 0]], dtype=int),  # diamond -> right 3, color 1\n    6: np.array([[1, 1, 1], [0, 1, 0], [1, 0, 1]], dtype=int),  # cross   -> left 4,  color 3\n    7: np.array([[1, 0, 1], [1, 0, 1], [1, 1, 1]], dtype=int),  # U       -> left 2,  color 2\n}\n_AREA_TO_COLOR = {4: 6, 5: 1, 6: 3, 7: 2}\n_AREA_DELTA = {4: (2, 0), 5: (1, 2), 6: (1, -3), 7: (1, -1)}\n_AREAS = (4, 5, 6, 7)\n\n# --- generation constraints ---\nMIN_DIRECTION_CHANGES = 2      # min vertical<->horizontal flips across the walk\nMAX_ATTEMPTS = 300             # outer retry budget\n\n\ndef _sample_path(N: int, start_col: int) -> list[int] | None:\n    \"\"\"Random-walk a sequence of 2*N area instructions that stays in the left canvas.\n\n    Returns None if the walk dead-ends or fails the direction-change constraint.\n    \"\"\"\n    H = 4 * N - 1\n    r, c = GRAY_START_ROW, start_col\n    areas: list[int] = []\n    for _ in range(2 * N):\n        opts = [a for a in _AREAS\n                if r + _AREA_DELTA[a][0] < H and 0 <= c + _AREA_DELTA[a][1] < LEFT_W]\n        if not opts:\n            return None\n        area = random.choice(opts)\n        areas.append(area)\n        dr, dc = _AREA_DELTA[area]\n        r += dr\n        c += dc\n\n    types = [a == 4 for a in areas]  # True = vertical, False = horizontal\n    changes = sum(1 for i in range(1, len(types)) if types[i] != types[i - 1])\n    if changes < MIN_DIRECTION_CHANGES:\n        return None\n    return areas\n\n\ndef _render_grid(N: int, start_col: int, areas: list[int]) -> np.ndarray:\n    \"\"\"Paint divider, gray start, and all 2*N tiled glyphs into the input grid.\"\"\"\n    H = 4 * N - 1\n    grid = np.zeros((H, GRID_W), dtype=int)\n    grid[:, DIVIDER_COL] = DIVIDER_COLOR\n    grid[GRAY_START_ROW, DIVIDER_COL + 1 + start_col] = GRAY\n\n    # Column-major tiling: first N glyphs into TILE_COLS[0], next N into TILE_COLS[1].\n    for i, area in enumerate(areas):\n        tile_col = TILE_COLS[i // N]\n        r0 = TILE_ROW_STRIDE * (i % N)\n        grid[r0:r0 + 3, tile_col:tile_col + 3] = _TEMPLATES[area] * _AREA_TO_COLOR[area]\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    N = random.randint(N_MIN, N_MAX)\n    start_col = random.randint(0, LEFT_W - 1)\n    areas = _sample_path(N, start_col)\n    if areas is None:\n        return None\n    return _render_grid(N, start_col, areas)\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        try:\n            inp = _gen_attempt()\n            if inp is None:\n                continue\n            out = main(inp)  # oracle check\n            if out.shape != (inp.shape[0], LEFT_W):\n                continue\n            return inp\n        except Exception:\n            continue\n    raise RuntimeError(f\"generate_input: failed after {MAX_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/833966f4.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swap the upper two-pixel segment and the lower two-pixel segment around the fixed center pixel.\n\n    Input structure:\n    - The grid is a 5x1 vertical column of individual colored pixels.\n    - The middle pixel is a separator between two same-size two-pixel segments.\n\n    Rule:\n    - Keep the middle pixel in place.\n    - Reverse the order of the two pixels above the middle.\n    - Reverse the order of the two pixels below the middle.\n\n    Key insight:\n    - The transformation is local vertical order reversal on each side of the center, not a color-specific rule.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.shape == (5, 1), \"expected a 5x1 vertical column\"\n\n    out = g.copy()\n    out[0, 0], out[1, 0] = g[1, 0], g[0, 0]\n    out[3, 0], out[4, 0] = g[4, 0], g[3, 0]\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Fixed 5x1 column and color vocabulary.\nGRID_SHAPE = (5, 1)\nCOLOR_DOMAIN = range(10)\nCOLORS_PER_GRID = GRID_SHAPE[0]\n\n# Oracle/retry controls.\nOUTPUT_ROW_ORDER = (1, 0, 2, 4, 3)\nMAX_ATTEMPTS = 300\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        inp = np.array(random.sample(COLOR_DOMAIN, COLORS_PER_GRID), dtype=int).reshape(GRID_SHAPE)\n        if np.array_equal(main(inp), inp[OUTPUT_ROW_ORDER, :]):\n            return inp\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' /home/lixinyu/snap/new/ARC_code/train/34cfa167.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg\nimport random\n\n\ndef _is_solid_rect(g: np.ndarray, comp: dict) -> bool:\n    r0, c0, r1, c1 = comp[\"bbox\"]\n    area = int((r1 - r0 + 1) * (c1 - c0 + 1))\n    return int(comp[\"area\"]) == area and bool(np.all(g[r0 : r1 + 1, c0 : c1 + 1] == int(comp[\"color\"])))\n\n\ndef _find_structure(g: np.ndarray, bg: int) -> tuple[dict, dict, list[dict], list[dict]]:\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n    rects = [comp for comp in comps if _is_solid_rect(g, comp)]\n\n    candidates: list[tuple[dict, dict, list[dict], list[dict]]] = []\n    for color in {int(comp[\"color\"]) for comp in rects}:\n        same_color = [comp for comp in rects if int(comp[\"color\"]) == color]\n        for i, a in enumerate(same_color):\n            for b in same_color[i + 1 :]:\n                if bbox_h(a[\"bbox\"]) != bbox_h(b[\"bbox\"]) or bbox_w(a[\"bbox\"]) != bbox_w(b[\"bbox\"]):\n                    continue\n\n                ar0, ac0, _ar1, _ac1 = a[\"bbox\"]\n                br0, bc0, _br1, _bc1 = b[\"bbox\"]\n                if ar0 < br0 and ac0 < bc0:\n                    source, dest = a, b\n                elif br0 < ar0 and bc0 < ac0:\n                    source, dest = b, a\n                else:\n                    continue\n\n                sr0, sc0, sr1, sc1 = source[\"bbox\"]\n                dr0, dc0, _dr1, _dc1 = dest[\"bbox\"]\n                right = [\n                    comp\n                    for comp in rects\n                    if int(comp[\"color\"]) != color\n                    and comp[\"bbox\"][0] == sr0\n                    and comp[\"bbox\"][2] == sr1\n                    and comp[\"bbox\"][1] == comp[\"bbox\"][3]\n                    and sc1 < comp[\"bbox\"][1] < dc0\n                ]\n                below = [\n                    comp\n                    for comp in rects\n                    if int(comp[\"color\"]) != color\n                    and comp[\"bbox\"][1] == sc0\n                    and comp[\"bbox\"][3] == sc1\n                    and comp[\"bbox\"][0] == comp[\"bbox\"][2]\n                    and sr1 < comp[\"bbox\"][0] < dr0\n                ]\n\n                right_with_offsets = sorted(\n                    ((int(comp[\"bbox\"][1] - sc1), comp) for comp in right),\n                    key=lambda item: item[0],\n                )\n                below_with_offsets = sorted(\n                    ((int(comp[\"bbox\"][0] - sr1), comp) for comp in below),\n                    key=lambda item: item[0],\n                )\n                if len(right_with_offsets) == 2 and len(below_with_offsets) == 2:\n                    right_offsets = [offset for offset, _comp in right_with_offsets]\n                    below_offsets = [offset for offset, _comp in below_with_offsets]\n                    if right_offsets == below_offsets and right_offsets[0] == 1:\n                        candidates.append(\n                            (\n                                source,\n                                dest,\n                                [comp for _offset, comp in right_with_offsets],\n                                [comp for _offset, comp in below_with_offsets],\n                            )\n                        )\n\n    assert len(candidates) == 1, \"expected one anchor pair with matching right and below controls\"\n    return candidates[0]\n\n\ndef _paint(out: np.ndarray, bg: int, r: int, c: int, color: int) -> None:\n    assert int(out[r, c]) in {int(bg), int(color)}, \"paint target must be empty or already matching\"\n    out[r, c] = int(color)\n\n\ndef _paint_rect(out: np.ndarray, bg: int, r0: int, c0: int, r1: int, c1: int, color: int) -> None:\n    for r in range(int(r0), int(r1) + 1):\n        for c in range(int(c0), int(c1) + 1):\n            _paint(out, bg, r, c, color)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.\n\n    Input structure:\n    - The background is the dominant color.\n    - Two same-color solid rectangular anchors of the same size sit on opposite\n      diagonal corners, with the first anchor above-left of the second.\n    - The upper-left anchor has two one-cell-thick vertical control bars to its\n      right and two one-cell-thick horizontal control bars below it.\n\n    Rule:\n    - Copy the anchor rectangle into the two missing corners of the implied\n      larger rectangle.\n    - Repeat the right-side control bars horizontally between the left and right\n      anchors, using their spacing as the period, and draw the outer top and\n      bottom borders in the first right-control color.\n    - Repeat the below-side control bars vertically between the top and bottom\n      anchors, using the same period, and draw the outer left and right borders\n      in the first below-control color.\n\n    Key insight: The small control bars are the first two ticks of two periodic\n    frame patterns; the diagonal anchor supplies the opposite corner and the\n    missing two anchor copies.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    source, dest, right_controls, below_controls = _find_structure(g, bg)\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    dr0, dc0, dr1, dc1 = dest[\"bbox\"]\n    anchor_color = int(source[\"color\"])\n    assert int(dest[\"color\"]) == anchor_color, \"anchor colors must match\"\n    assert bbox_h(source[\"bbox\"]) == bbox_h(dest[\"bbox\"]), \"anchor heights must match\"\n    assert bbox_w(source[\"bbox\"]) == bbox_w(dest[\"bbox\"]), \"anchor widths must match\"\n    assert sr0 > 0 and sc0 > 0, \"upper-left anchor must have space for outer frame\"\n    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \"lower-right anchor must have space for outer frame\"\n\n    right_offsets = [int(comp[\"bbox\"][1] - sc1) for comp in right_controls]\n    below_offsets = [int(comp[\"bbox\"][0] - sr1) for comp in below_controls]\n    assert right_offsets == below_offsets and right_offsets[0] == 1, \"control offsets must match from the anchor edge\"\n    step = int(right_offsets[1] - right_offsets[0])\n    assert step > 0, \"control bars must be separated\"\n    period = 2 * step\n    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, \"right frame must close next to the destination anchor\"\n    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, \"below frame must close next to the destination anchor\"\n\n    right_colors = [int(comp[\"color\"]) for comp in right_controls]\n    below_colors = [int(comp[\"color\"]) for comp in below_controls]\n    out = g.copy()\n\n    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)\n    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)\n\n    first_c = int(sc1 + right_offsets[0])\n    last_c = int(dc0 - 1)\n    for c in range(first_c, last_c + 1):\n        offset = int(c - sc1)\n        if (offset - right_offsets[0]) % period == 0:\n            color = right_colors[0]\n        elif (offset - right_offsets[1]) % period == 0:\n            color = right_colors[1]\n        else:\n            continue\n        _paint_rect(out, bg, sr0, c, sr1, c, color)\n        _paint_rect(out, bg, dr0, c, dr1, c, color)\n\n    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])\n    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])\n\n    first_r = int(sr1 + below_offsets[0])\n    last_r = int(dr0 - 1)\n    left_c = int(sc0 - 1)\n    right_c = int(dc1 + 1)\n    for r in range(first_r, last_r + 1):\n        _paint(out, bg, r, left_c, below_colors[0])\n        _paint(out, bg, r, right_c, below_colors[0])\n\n        offset = int(r - sr1)\n        if (offset - below_offsets[0]) % period == 0:\n            _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])\n            _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])\n        elif (offset - below_offsets[1]) % period == 0:\n            _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])\n            _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color sampling.\nCOLOR_COUNT, NON_BG_COLOR_COUNT = 10, 4\n\n# Anchor/repetition geometry.\nANCHOR_SIZE_RANGE = (1, 5)\nREPEAT_COUNT_RANGE = (2, 5)\nCONTROL_OFFSETS = (1, 3)\nFRAME_PERIOD, DEST_ANCHOR_GAP, STRUCTURE_FIXED_PAD = 4, 2, 3\n\n# Canvas/margins.\nCANVAS_MIN_SIZE, CANVAS_MAX_SIZE = 16, 30\nMARGIN_CHOICES = range(4)\nMIN_TOTAL_MARGIN, SOURCE_OUTER_MARGIN = 1, 1\n\n# Retry.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_paint_rect(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int) -> None:\n    grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)\n\n\ndef _choose_margins(struct_len: int) -> tuple[int, int]:\n    pairs = [\n        (before, after)\n        for before in MARGIN_CHOICES\n        for after in MARGIN_CHOICES\n        if MIN_TOTAL_MARGIN <= before + after\n        and CANVAS_MIN_SIZE <= struct_len + before + after <= CANVAS_MAX_SIZE\n    ]\n    return pairs[int(np.random.randint(len(pairs)))]\n\n\ndef _build_output(\n    rows: int,\n    cols: int,\n    bg: int,\n    anchor_color: int,\n    right1: int,\n    right2: int,\n    below1: int,\n    sr0: int,\n    sc0: int,\n    s: int,\n    nh: int,\n    nv: int,\n) -> tuple[np.ndarray, tuple[int, int, int, int, int, int, int, int]]:\n    out = np.full((rows, cols), int(bg), dtype=int)\n    sr1, sc1 = sr0 + s - 1, sc0 + s - 1\n    dr0 = sr1 + FRAME_PERIOD * nv + DEST_ANCHOR_GAP\n    dc0 = sc1 + FRAME_PERIOD * nh + DEST_ANCHOR_GAP\n    dr1, dc1 = dr0 + s - 1, dc0 + s - 1\n\n    for r0, c0 in ((sr0, sc0), (sr0, dc0), (dr0, sc0), (dr0, dc0)):\n        _gen_paint_rect(out, r0, c0, r0 + s - 1, c0 + s - 1, anchor_color)\n\n    first_c, last_c = sc1 + CONTROL_OFFSETS[0], dc0 - 1\n    for c in range(first_c, last_c + 1):\n        offset = c - sc1\n        if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:\n            color = right1\n        elif (offset - CONTROL_OFFSETS[1]) % FRAME_PERIOD == 0:\n            color = right2\n        else:\n            continue\n        _gen_paint_rect(out, sr0, c, sr1, c, color)\n        _gen_paint_rect(out, dr0, c, dr1, c, color)\n    _gen_paint_rect(out, sr0 - 1, first_c, sr0 - 1, last_c, right1)\n    _gen_paint_rect(out, dr1 + 1, first_c, dr1 + 1, last_c, right1)\n\n    first_r, last_r = sr1 + CONTROL_OFFSETS[0], dr0 - 1\n    left_c, right_c = sc0 - 1, dc1 + 1\n    for r in range(first_r, last_r + 1):\n        out[r, left_c] = below1\n        out[r, right_c] = below1\n        offset = r - sr1\n        if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:\n            _gen_paint_rect(out, r, left_c, r, sc1, below1)\n            _gen_paint_rect(out, r, dc0, r, right_c, below1)\n        elif (offset - CONTROL_OFFSETS[1]) % FRAME_PERIOD == 0:\n            _gen_paint_rect(out, r, sc0, r, sc1, right2)\n            _gen_paint_rect(out, r, dc0, r, dc1, right2)\n\n    return out, (sr0, sc0, sr1, sc1, dr0, dc0, dr1, dc1)\n\n\ndef _derive_input(\n    out: np.ndarray,\n    bg: int,\n    sr0: int,\n    sc0: int,\n    sr1: int,\n    sc1: int,\n    dr0: int,\n    dc0: int,\n    dr1: int,\n    dc1: int,\n) -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/48634b99.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, colors_present, find_components, get_bg, paste, random_free_location\nimport random\n\n\ndef _is_solid_vertical_bar(component: dict) -> bool:\n    return bbox_w(component[\"bbox\"]) == 1 and int(component[\"area\"]) == bbox_h(component[\"bbox\"])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Advance the marker from one half of a vertical bar to the same half of the next longer bar.\n\n    Input structure\n    - The grid has one dominant background color and exactly two foreground colors.\n    - One foreground color forms many vertical one-cell-wide bars; the other appears as a single vertical marker segment.\n    - The marker segment occupies exactly the top or bottom half of its containing vertical bar.\n    Rule\n    - Recolor the current marker segment back to the bar color.\n    - Find the unique all-bar-color vertical bar whose height is two pixels greater than the marked source bar.\n    - Recolor the same half of that next longer bar to the marker color.\n    Key insight\n    - Each bar's total height encodes an ordered size, and the marker advances from a 2k bar to the corresponding 2(k+1) bar while preserving whether it marks the top or bottom half.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = int(get_bg(g))\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, f\"expected exactly two foreground colors, got {colors}\"\n\n    mono_component_counts = {\n        int(color): len(\n            find_components(\n                g,\n                bg=bg,\n                colors=[int(color)],\n                connectivity=4,\n                monochromatic=True,\n            )\n        )\n        for color in colors\n    }\n    marker_colors = [color for color, count in mono_component_counts.items() if count == 1]\n    assert len(marker_colors) == 1, f\"expected one single-component marker color, got {mono_component_counts}\"\n    marker_color = int(marker_colors[0])\n\n    bar_colors = [int(color) for color in colors if int(color) != marker_color]\n    assert len(bar_colors) == 1\n    bar_color = int(bar_colors[0])\n\n    marker_components = find_components(\n        g,\n        bg=bg,\n        colors=[marker_color],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert len(marker_components) == 1\n    marker = marker_components[0]\n    marker_area = int(marker[\"area\"])\n    mr0, mc0, mr1, _mc1 = marker[\"bbox\"]\n    assert _is_solid_vertical_bar(marker)\n\n    bars = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    source_bars = [\n        bar\n        for bar in bars\n        if np.any(g[bar[\"coords\"][:, 0], bar[\"coords\"][:, 1]] == marker_color)\n    ]\n    assert len(source_bars) == 1, f\"expected one bar containing the marker, got {len(source_bars)}\"\n    source = source_bars[0]\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    source_h = bbox_h(source[\"bbox\"])\n    assert _is_solid_vertical_bar(source)\n    assert source_h == 2 * marker_area\n    assert mc0 == sc0 == sc1\n\n    if mr0 == sr0 and mr1 == sr0 + marker_area - 1:\n        marked_end = \"top\"\n    elif mr1 == sr1 and mr0 == sr1 - marker_area + 1:\n        marked_end = \"bottom\"\n    else:\n        raise AssertionError(f\"marker is not exactly one end-half: marker={marker['bbox']} source={source['bbox']}\")\n\n    target_h = source_h + 2\n    target_bars = []\n    for bar in bars:\n        values = g[bar[\"coords\"][:, 0], bar[\"coords\"][:, 1]]\n        if set(map(int, values)) != {bar_color}:\n            continue\n        if not _is_solid_vertical_bar(bar):\n            continue\n        if bbox_h(bar[\"bbox\"]) == target_h:\n            target_bars.append(bar)\n\n    assert len(target_bars) == 1, f\"expected one next-longer target bar, got {[bar['bbox'] for bar in target_bars]}\"\n    target = target_bars[0]\n    tr0, tc0, tr1, _tc1 = target[\"bbox\"]\n    target_half = target_h // 2\n\n    out = g.copy()\n    out[g == marker_color] = bar_color\n    if marked_end == \"top\":\n        out[tr0 : tr0 + target_half, tc0] = marker_color\n    else:\n        out[tr1 - target_half + 1 : tr1 + 1, tc0] = marker_color\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Fixed palette observed in all examples.\nBG = 7\nBAR_COLOR = 8\nMARKER_COLOR = 9\n# Grid geometry and vertical bar vocabulary.\nGRID_SHAPE = (16, 16)\nPROGRESSION_HEIGHTS = (2, 4, 6, 8, 10)\nSOURCE_HEIGHTS = PROGRESSION_HEIGHTS[:-1]\nDISTRACTOR_HEIGHT = 2\nHEIGHT_STEP = 2\n# Placement constraints and structural sampling.\nPLACEMENT_PADDING = 1\nPLACEMENT_CONNECTIVITY = 4\nDISTRACTOR_COUNT_RANGE = (5, 11)\nMARKED_HALVES = (\"top\", \"bottom\")\n# Rejection-sampling retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _paint_bar_half(grid: np.ndarray, row: int, col: int, height: int, marked_half: str, color: int) -> None:\n    \"\"\"Paint the selected top or bottom half in place.\"\"\"\n    half = height // 2\n    if marked_half == \"top\":\n        grid[row : row + half, col] = color\n    else:\n        grid[row + height - half : row + height, col] = color\n\n\ndef _bar_patch(height: int, *, marked_half: str | None = None) -> np.ndarray:\n    patch = np.full((height, 1), BAR_COLOR, dtype=int)\n    if marked_half is not None:\n        _paint_bar_half(patch, 0, 0, height, marked_half, MARKER_COLOR)\n    return patch\n\n\ndef _place_bar(canvas: np.ndarray, patch: np.ndarray) -> tuple[int, int]:\n    r, c = random_free_location(\n        canvas,\n        patch,\n        transparent=BG,\n        padding=PLACEMENT_PADDING,\n        padding_connectivity=PLACEMENT_CONNECTIVITY,\n    )\n    paste(canvas, patch, r, c)\n    return r, c\n\n\ndef _place_progression_bars(canvas: np.ndarray, target_h: int, marked_half: str) -> dict[int, tuple[int, int]]:\n    \"\"\"Place one bar for each progression height and return height to top-left.\"\"\"\n    bar_tops: dict[int, tuple[int, int]] = {}\n    for height in random.sample(PROGRESSION_HEIGHTS, len(PROGRESSION_HEIGHTS)):\n        marker = marked_half if height == target_h else None\n        bar_tops[height] = _place_bar(canvas, _bar_patch(height, marked_half=marker))\n    return bar_tops\n\n\ndef _derive_input(out: np.ndarray, bar_tops: dict[int, tuple[int, int]], source_h: int, target_h: int, marked_half: str) -> np.ndarray:\n    \"\"\"Move the output marker back from target to source.\"\"\"\n    inp = out.copy()\n    tr, tc = bar_tops[target_h]\n    _paint_bar_half(inp, tr, tc, target_h, marked_half, BAR_COLOR)\n\n    sr, sc = bar_tops[source_h]\n    _paint_bar_half(inp, sr, sc, source_h, marked_half, MARKER_COLOR)\n    return inp\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    source_h = random.choice(SOURCE_HEIGHTS)\n    target_h = source_h + HEIGHT_STEP\n    marked_half = random.choice(MARKED_HALVES)\n    out = np.full(GRID_SHAPE, BG, dtype=int)\n\n    try:\n        bar_tops = _place_progression_bars(out, target_h, marked_half)\n        for _ in range(random.randint(*DISTRACTOR_COUNT_RANGE)):\n            _place_bar(out, _bar_patch(DISTRACTOR_HEIGHT))\n    except ValueError:\n        return None\n\n    inp = _derive_input(out, bar_tops, source_h, target_h, marked_half)\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except AssertionError:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 48634b99 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/2601afb7.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\n\n\ndef _extract_bars(g: np.ndarray, bg: int) -> list[dict[str, int]]:\n    height = g.shape[0]\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(components) >= 2\n\n    bars: list[dict[str, int]] = []\n    for comp in components:\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        color = int(comp[\"color\"])\n        area = int(comp[\"area\"])\n\n        assert c0 == c1\n        assert r1 == height - 1\n        assert area == r1 - r0 + 1\n        assert bool(np.all(g[r0 : r1 + 1, c0] == color))\n\n        bars.append({\"color\": color, \"col\": c0, \"height\": area})\n\n    bars.sort(key=lambda bar: bar[\"col\"])\n    assert len({bar[\"col\"] for bar in bars}) == len(bars)\n    return bars\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate each vertical bar's color one slot right and its height one slot left.\n\n    Input structure\n    - A dominant background surrounds several monochrome one-cell-wide vertical bars.\n    - Every bar is bottom-aligned and occupies a distinct column.\n    - The ordered bar slots are read from left to right.\n\n    Rule\n    - Keep the grid shape and the bar columns unchanged.\n    - At slot i, use the color from the previous slot cyclically.\n    - At slot i, use the height from the next slot cyclically.\n\n    Key insight\n    - Color and height are independent cyclic attributes of the ordered bar slots:\n      colors rotate right while heights rotate left.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height = g.shape[0]\n    bg = get_bg(g)\n    bars = _extract_bars(g, bg)\n\n    out = np.full_like(g, bg)\n    count = len(bars)\n    for i, bar in enumerate(bars):\n        color = bars[(i - 1) % count][\"color\"]\n        bar_height = bars[(i + 1) % count][\"height\"]\n        assert 1 <= bar_height <= height\n        out[height - bar_height : height, bar[\"col\"]] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n_RNG = np.random.default_rng()\n\n# Canvas/bar bounds.\nBAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE = 3, 6\nBACKGROUND_COLOR, MIN_BAR_HEIGHT = 7, 1\nBAR_COL_OFFSET, BAR_COL_STRIDE = 1, 2\n# Color and transform sampling.\nCOLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nOUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _render_bars(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n    grid = np.full((side, side), BACKGROUND_COLOR, dtype=int)\n    for i, (color, bar_height) in enumerate(zip(colors, heights)):\n        col = BAR_COL_STRIDE * i + BAR_COL_OFFSET\n        grid[side - int(bar_height) : side, col] = int(color)\n    return grid\n\n\ndef _expected_output(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n    out_colors = np.roll(colors, OUTPUT_COLOR_SHIFT)\n    out_heights = np.roll(heights, OUTPUT_HEIGHT_SHIFT)\n    return _render_bars(n, out_colors, out_heights)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = int(_RNG.integers(BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE))\n    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n    colors = _RNG.choice(COLOR_POOL, size=n, replace=False)\n    heights = _RNG.integers(MIN_BAR_HEIGHT, side, size=n)\n    if len(set(map(int, heights))) == 1:\n        idx = int(_RNG.integers(n))\n        choices = [h for h in range(MIN_BAR_HEIGHT, side) if h != int(heights[idx])]\n        heights[idx] = int(_RNG.choice(choices))\n\n    grid = _render_bars(n, colors, heights)\n    if np.array_equal(main(grid), _expected_output(n, colors, heights)):\n        return grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
