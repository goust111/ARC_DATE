{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/a/des/code/combo_new/seed1852178230/15/3.py | sed -n '1,260p'\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\t\n     3\tfrom collections import deque\n     4\timport random\n     5\t\n     6\timport numpy as np\n     7\t\n     8\t\n     9\tAZURE = 8\n    10\tGREY = 5\n    11\tPALETTE = (1, 2, 3, 4, 6, 7, 9)\n    12\tDIRECTIONS = (\"up\", \"down\", \"left\", \"right\")\n    13\tGEN_ATTEMPTS = 400\n    14\tPLACEMENT_ATTEMPTS = 300\n    15\t\n    16\t\n    17\tdef _most_common_color(grid: np.ndarray) -> int:\n    18\t    values, counts = np.unique(grid, return_counts=True)\n    19\t    return int(values[int(np.argmax(counts))])\n    20\t\n    21\t\n    22\tdef _components_of_color(grid: np.ndarray, color: int) -> list[dict]:\n    23\t    mask = grid == int(color)\n    24\t    h, w = mask.shape\n    25\t    seen = np.zeros((h, w), dtype=bool)\n    26\t    components: list[dict] = []\n    27\t\n    28\t    for r in range(h):\n    29\t        for c in range(w):\n    30\t            if not mask[r, c] or seen[r, c]:\n    31\t                continue\n    32\t            queue = deque([(r, c)])\n    33\t            seen[r, c] = True\n    34\t            coords: list[tuple[int, int]] = []\n    35\t            while queue:\n    36\t                rr, cc = queue.popleft()\n    37\t                coords.append((rr, cc))\n    38\t                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n    39\t                    nr, nc = rr + dr, cc + dc\n    40\t                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n    41\t                        seen[nr, nc] = True\n    42\t                        queue.append((nr, nc))\n    43\t\n    44\t            rows = [rr for rr, _cc in coords]\n    45\t            cols = [cc for _rr, cc in coords]\n    46\t            components.append(\n    47\t                {\n    48\t                    \"coords\": coords,\n    49\t                    \"bbox\": (min(rows), min(cols), max(rows), max(cols)),\n    50\t                    \"area\": len(coords),\n    51\t                }\n    52\t            )\n    53\t    return components\n    54\t\n    55\t\n    56\tdef _legend_patterns() -> dict[str, np.ndarray]:\n    57\t    patterns: dict[str, np.ndarray] = {}\n    58\t    for direction, missing in {\n    59\t        \"up\": (0, 1),\n    60\t        \"down\": (2, 1),\n    61\t        \"left\": (1, 0),\n    62\t        \"right\": (1, 2),\n    63\t    }.items():\n    64\t        mask = np.ones((3, 3), dtype=bool)\n    65\t        mask[1, 1] = False\n    66\t        mask[missing] = False\n    67\t        patterns[direction] = mask\n    68\t    return patterns\n    69\t\n    70\t\n    71\tPATTERNS = _legend_patterns()\n    72\t\n    73\t\n    74\tdef _find_legend(grid: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:\n    75\t    best: tuple[int, tuple[int, int, int, int], int] | None = None\n    76\t\n    77\t    for color in np.unique(grid):\n    78\t        color = int(color)\n    79\t        if color == bg:\n    80\t            continue\n    81\t        coords = np.argwhere(grid == color)\n    82\t        if coords.size == 0:\n    83\t            continue\n    84\t        r0, c0 = map(int, coords.min(axis=0))\n    85\t        r1, c1 = map(int, coords.max(axis=0))\n    86\t        sub = grid[r0 : r1 + 1, c0 : c1 + 1]\n    87\t        h, w = sub.shape\n    88\t        if h != 5 or w < 9 or (w - 1) % 4 != 0:\n    89\t            continue\n    90\t        if not np.all(sub[0, :] == color) or not np.all(sub[-1, :] == color):\n    91\t            continue\n    92\t        divider_cols = [c for c in range(w) if bool(np.all(sub[:, c] == color))]\n    93\t        if divider_cols[0] != 0 or divider_cols[-1] != w - 1:\n    94\t            continue\n    95\t        if any(b - a != 4 for a, b in zip(divider_cols, divider_cols[1:], strict=False)):\n    96\t            continue\n    97\t\n    98\t        cell_count = len(divider_cols) - 1\n    99\t        candidate = (cell_count, (r0, c0, r1, c1), color)\n   100\t        if best is None or candidate > best:\n   101\t            best = candidate\n   102\t\n   103\t    assert best is not None, \"expected one legend separator component\"\n   104\t    _cell_count, bbox, sep_color = best\n   105\t    return sep_color, bbox\n   106\t\n   107\t\n   108\tdef _read_legend(grid: np.ndarray, bg: int) -> tuple[int, dict[int, str], tuple[int, int, int, int]]:\n   109\t    sep_color, (r0, c0, r1, c1) = _find_legend(grid, bg)\n   110\t    sub = grid[r0 : r1 + 1, c0 : c1 + 1]\n   111\t    divider_cols = [c for c in range(sub.shape[1]) if bool(np.all(sub[:, c] == sep_color))]\n   112\t\n   113\t    mapping: dict[int, str] = {}\n   114\t    for left, right in zip(divider_cols, divider_cols[1:], strict=False):\n   115\t        patch = sub[1:4, left + 1 : right]\n   116\t        colors = [int(v) for v in np.unique(patch) if int(v) not in {bg, sep_color}]\n   117\t        assert len(colors) == 1, \"each legend cell must contain one symbol color\"\n   118\t        symbol_color = colors[0]\n   119\t        fg_mask = patch != bg\n   120\t        matches = [direction for direction, pattern in PATTERNS.items() if np.array_equal(fg_mask, pattern)]\n   121\t        assert len(matches) == 1, \"legend symbol must encode one opening direction\"\n   122\t        mapping[symbol_color] = matches[0]\n   123\t\n   124\t    return sep_color, mapping, (r0, c0, r1, c1)\n   125\t\n   126\t\n   127\tdef _find_target_rectangle(grid: np.ndarray, color: int) -> tuple[int, int, int, int]:\n   128\t    candidates: list[tuple[int, int, int, int]] = []\n   129\t    for comp in _components_of_color(grid, color):\n   130\t        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n   131\t        h = r1 - r0 + 1\n   132\t        w = c1 - c0 + 1\n   133\t        if comp[\"area\"] == h * w and h % 2 == 0 and w % 2 == 0:\n   134\t            candidates.append((r0, c0, r1, c1))\n   135\t\n   136\t    assert len(candidates) == 1, \"each legend color must match one solid even rectangle\"\n   137\t    return candidates[0]\n   138\t\n   139\t\n   140\tdef _apply_crop(out: np.ndarray, bbox: tuple[int, int, int, int], bg: int, direction: str) -> None:\n   141\t    r0, c0, r1, c1 = map(int, bbox)\n   142\t    h = r1 - r0 + 1\n   143\t    w = c1 - c0 + 1\n   144\t    assert h % 2 == 0 and w % 2 == 0\n   145\t\n   146\t    if direction == \"up\":\n   147\t        out[r0 + h // 2 : r1 + 1, c0 : c1 + 1] = bg\n   148\t    elif direction == \"down\":\n   149\t        out[r0 : r0 + h // 2, c0 : c1 + 1] = bg\n   150\t    elif direction == \"left\":\n   151\t        out[r0 : r1 + 1, c0 + w // 2 : c1 + 1] = bg\n   152\t    elif direction == \"right\":\n   153\t        out[r0 : r1 + 1, c0 : c0 + w // 2] = bg\n   154\t    else:\n   155\t        raise AssertionError(\"unknown direction\")\n   156\t\n   157\t\n   158\tdef main(grid: np.ndarray) -> np.ndarray:\n   159\t    \"\"\"\n   160\t    Use the opening direction of each top legend symbol to crop the matching lower color block to one half.\n   161\t\n   162\t    Input structure:\n   163\t    - The background is Azure.\n   164\t    - Near the top there is one Grey separator frame made of two full horizontal lines and repeated vertical dividers.\n   165\t    - Between adjacent Grey dividers, each 3x3 legend cell contains one monochrome open-square symbol whose missing side indicates up, down, left, or right.\n   166\t    - Elsewhere below the legend, each legend color appears again as exactly one solid even-sized filled rectangle.\n   167\t\n   168\t    Rule:\n   169\t    - Keep the Grey legend frame and every legend symbol unchanged.\n   170\t    - Match each lower solid rectangle to the legend symbol of the same color.\n   171\t    - Read the symbol's opening direction.\n   172\t    - Split the rectangle into two equal halves across the corresponding middle line, keep the half toward the opening direction, and recolor the opposite half to the Azure background.\n   173\t\n   174\t    Key insight:\n   175\t    - The top symbols are directional instructions rather than decorative shapes: the missing edge of each 3x3 open square tells which half of the same-colored rectangle survives.\n   176\t    \"\"\"\n   177\t    g = np.asarray(grid, dtype=int)\n   178\t    assert g.ndim == 2, \"expected a 2D grid\"\n   179\t\n   180\t    bg = int(_most_common_color(g))\n   181\t    _sep_color, color_to_direction, _legend_bbox = _read_legend(g, bg)\n   182\t\n   183\t    out = g.copy()\n   184\t    for color, direction in color_to_direction.items():\n   185\t        bbox = _find_target_rectangle(g, color)\n   186\t        _apply_crop(out, bbox, bg, direction)\n   187\t    return out\n   188\t\n   189\t\n   190\tdef _symbol_patch(color: int, direction: str, bg: int) -> np.ndarray:\n   191\t    patch = np.full((3, 3), bg, dtype=int)\n   192\t    patch[PATTERNS[direction]] = int(color)\n   193\t    return patch\n   194\t\n   195\t\n   196\tdef _build_legend(colors: list[int], directions: list[str], bg: int, sep: int) -> np.ndarray:\n   197\t    width = 4 * len(colors) + 1\n   198\t    legend = np.full((5, width), bg, dtype=int)\n   199\t    legend[0, :] = sep\n   200\t    legend[-1, :] = sep\n   201\t    for i, (color, direction) in enumerate(zip(colors, directions, strict=False)):\n   202\t        c0 = 4 * i\n   203\t        legend[:, c0] = sep\n   204\t        legend[:, c0 + 4] = sep\n   205\t        legend[1:4, c0 + 1 : c0 + 4] = _symbol_patch(color, direction, bg)\n   206\t    return legend\n   207\t\n   208\t\n   209\tdef _fits(occupied: np.ndarray, r0: int, c0: int, h: int, w: int) -> bool:\n   210\t    rr0 = max(0, r0 - 1)\n   211\t    cc0 = max(0, c0 - 1)\n   212\t    rr1 = min(occupied.shape[0], r0 + h + 1)\n   213\t    cc1 = min(occupied.shape[1], c0 + w + 1)\n   214\t    return not bool(np.any(occupied[rr0:rr1, cc0:cc1]))\n   215\t\n   216\t\n   217\tdef _mark(occupied: np.ndarray, r0: int, c0: int, h: int, w: int) -> None:\n   218\t    rr0 = max(0, r0 - 1)\n   219\t    cc0 = max(0, c0 - 1)\n   220\t    rr1 = min(occupied.shape[0], r0 + h + 1)\n   221\t    cc1 = min(occupied.shape[1], c0 + w + 1)\n   222\t    occupied[rr0:rr1, cc0:cc1] = True\n   223\t\n   224\t\n   225\tdef _direction_list(rng: random.Random, count: int) -> list[str]:\n   226\t    base = list(DIRECTIONS)\n   227\t    rng.shuffle(base)\n   228\t    if count <= 4:\n   229\t        return base[:count]\n   230\t    return base + [rng.choice(DIRECTIONS)]\n   231\t\n   232\t\n   233\tdef _expected_output(\n   234\t    grid: np.ndarray,\n   235\t    rects: dict[int, tuple[int, int, int, int]],\n   236\t    directions: dict[int, str],\n   237\t    bg: int,\n   238\t) -> np.ndarray:\n   239\t    out = grid.copy()\n   240\t    for color, bbox in rects.items():\n   241\t        _apply_crop(out, bbox, bg, directions[color])\n   242\t    return out\n   243\t\n   244\t\n   245\tdef _gen_attempt() -> np.ndarray | None:\n   246\t    rng = random.Random()\n   247\t    count = rng.randint(2, 5)\n   248\t    colors = rng.sample(list(PALETTE), count)\n   249\t    directions = _direction_list(rng, count)\n   250\t    legend = _build_legend(colors, directions, AZURE, GREY)\n   251\t\n   252\t    min_h = max(14, 10 + 2 * count)\n   253\t    min_w = max(16, legend.shape[1] + rng.randint(0, 5))\n   254\t    grid_h = rng.randint(min_h, 30)\n   255\t    grid_w = rng.randint(min_w, 30)\n   256\t    if legend.shape[1] > grid_w or legend.shape[0] > grid_h:\n   257\t        return None\n   258\t\n   259\t    legend_r0 = rng.randint(0, min(2, grid_h - legend.shape[0]))\n   260\t    legend_c0 = rng.randint(0, grid_w - legend.shape[1])\n","exit_code":0,"status":"completed"}}
