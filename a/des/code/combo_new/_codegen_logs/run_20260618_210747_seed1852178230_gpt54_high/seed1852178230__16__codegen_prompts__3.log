{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/train/2faf500b.py /home/lixinyu/snap/new/ARC_code/train/963c33f8.py /home/lixinyu/snap/new/ARC_code/train/18286ef8.py /home/lixinyu/snap/new/ARC_code/train/6ca952ad.py /home/lixinyu/snap/new/ARC_code/eval/581f7754.py /home/lixinyu/snap/new/ARC_code/train/af726779.py /home/lixinyu/snap/new/ARC_code/train/7e576d6e.py /home/lixinyu/snap/new/ARC_code/train/b74ca5d1.py; do echo \"===== $f\"; sed -n '\"'/def main(/,/\"'^def /p'\"' \\\"\"'$f\" | sed '\"'\"'$d'\"'; sed -n '/def generate_input(/,\"'$p'\"' \\\"\"'$f\"; done'","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/train/2faf500b.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Remove each fracture marker line and push the surrounding object pixels one cell away from it.\n\n    Input structure\n    - A background grid with 8-connected foreground objects made from a body color and a rarer marker color.\n    - Each object has a non-square bbox; the marker pixels form one complete fracture line across the shorter bbox axis.\n\n    Rule\n    - Erase all marker pixels.\n    - For a wide object, each row has one marker; body pixels left of it shift one cell left and body pixels right of it shift one cell right.\n    - For a tall object, each column has one marker; body pixels above it shift one cell up and body pixels below it shift one cell down.\n\n    Key insight\n    - The marker line is a crack through the object, so the two sides separate by one pixel perpendicular to the crack.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    marker, body = _role_colors(g, bg)\n    out = np.full_like(g, bg)\n\n    objects = find_components(\n        g,\n        bg=bg,\n        connectivity=8,\n        monochromatic=False,\n        colors=[marker, body],\n    )\n    assert objects, \"expected at least one fractured object\"\n\n    for obj in objects:\n        coords = obj[\"coords\"]\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        width = int(c1 - c0 + 1)\n        assert height != width, \"fractured object bbox must determine an orientation\"\n\n        vals = g[coords[:, 0], coords[:, 1]]\n        assert bool(np.any(vals == marker)), \"each object must contain marker pixels\"\n        assert bool(np.any(vals == body)), \"each object must contain body pixels\"\n\n        marker_coords = coords[vals == marker]\n        if width > height:\n            marker_by_row: dict[int, list[int]] = {}\n            for r, c in marker_coords:\n                marker_by_row.setdefault(int(r), []).append(int(c))\n            assert set(marker_by_row) == set(range(r0, r1 + 1)), \"wide object needs one marker in each row\"\n            assert all(len(cols) == 1 for cols in marker_by_row.values()), \"wide object marker row must be unique\"\n\n            for r, c in coords[vals == body]:\n                rr = int(r)\n                cc = int(c)\n                marker_c = marker_by_row[rr][0]\n                assert cc != marker_c, \"body pixel cannot occupy the marker column\"\n                shifted_c = cc - 1 if cc < marker_c else cc + 1\n                _set_body(out, rr, shifted_c, body)\n        else:\n            marker_by_col: dict[int, list[int]] = {}\n            for r, c in marker_coords:\n                marker_by_col.setdefault(int(c), []).append(int(r))\n            assert set(marker_by_col) == set(range(c0, c1 + 1)), \"tall object needs one marker in each column\"\n            assert all(len(rows) == 1 for rows in marker_by_col.values()), \"tall object marker column must be unique\"\n\n            for r, c in coords[vals == body]:\n                rr = int(r)\n                cc = int(c)\n                marker_r = marker_by_col[cc][0]\n                assert rr != marker_r, \"body pixel cannot occupy the marker row\"\n                shifted_r = rr - 1 if rr < marker_r else rr + 1\n                _set_body(out, shifted_r, cc, body)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, palette, and retry budget.\nBACKGROUND_COLOR = 0\nFOREGROUND_COLORS = tuple(range(1, 10))\nMAX_GRID_SIZE = 19\nMIN_GRID_SIZE_BY_COUNT = (8, 8, 10, 12, 14, 16, 18, 19)\nGENERATION_RETRIES = 300\n\n# Object counts, dimensions, and orientations.\nMIN_OBJECT_COUNT = 1\nMAX_OBJECT_COUNT = 7\nSHORT_SIDE_SIZES = (2, 3, 4, 5, 6)\nLONG_SIDE_FACTOR = 2\nWIDE = \"wide\"\nTALL = \"tall\"\nORIENTATIONS = [WIDE, TALL]\n\n# Dense layouts try smaller rectangles first while preserving random tie order.\nDENSE_COUNT_THRESHOLD = 6\nDENSE_PREFERRED_MAX_SHORT_SIDE = 3\nPACKED_COUNT_THRESHOLD = 4\nPACKED_PREFERRED_MAX_SHORT_SIDE = 4\n\n# Placement and retry constraints.\nSHIFT_PADDING = 1\nMIN_CHEB_GAP = 2\n\nBBox = tuple[int, int, int, int]\nLocation = tuple[int, int]\nObjectSpec = tuple[int, int, int, str]\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n===== /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\n    Input structure\n    - The background is the dominant color.\n    - The most numerous non-background color forms stationary grey obstacle pixels.\n    - The other two colors form a single 3x3 top-edge marker whose top two rows\n      are maroon and whose bottom row contains maroon or blue control pixels.\n\n    Rule\n    - Erase the top marker.\n    - Treat each marker column as a vertical drop retaining its three colors.\n    - A column whose bottom control pixel is blue stops immediately above the\n      first grey pixel below that column, or bottom-aligns if none exists.\n    - Contiguous maroon-ended columns pass through obstacles and bottom-align;\n      if such a run has a clear down-right slide from a grey ledge, shift the\n      run one column right before bottom-aligning.\n    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n      the rest of the marker-width gap in that bottom bar.\n\n    Key insight\n    - The bottom row of the top marker is a control strip: blue cells mean\n      \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H = g.shape[0]\n    bg = int(get_bg(g))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 3, \"expected obstacle color plus two marker colors\"\n    obstacle = _unique_largest_count_color(g, non_bg)\n    marker_colors = [color for color in non_bg if color != obstacle]\n    assert len(marker_colors) == 2, \"expected exactly two marker colors\"\n\n    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)\n    marker = g[r0 : r1 + 1, c0 : c1 + 1]\n    marker_h, marker_w = marker.shape\n    assert (marker_h, marker_w) == (3, 3), \"expected a 3x3 marker\"\n    assert np.all(np.isin(marker, marker_colors)), \"marker bbox must contain only marker colors\"\n\n    pass_color = int(marker[0, 0])\n    assert np.all(marker[:2, :] == pass_color), \"top two marker rows must be the pass-through color\"\n    stop_colors = [color for color in marker_colors if color != pass_color]\n    assert len(stop_colors) == 1, \"expected one stop color\"\n    stop_color = stop_colors[0]\n\n    out = g.copy()\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    base = out.copy()\n\n    pass_columns: list[int] = []\n    for j in range(marker_w):\n        c = c0 + j\n        stack = marker[:, j]\n        bottom_control = int(stack[-1])\n\n        if bottom_control == stop_color:\n            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n            if len(obstacles_below):\n                floor_r = int(r1 + 1 + obstacles_below[0])\n                top_r = floor_r - marker_h\n            else:\n                top_r = H - marker_h\n            assert top_r >= 0, \"stopped column must fit above its obstacle\"\n            out[top_r : top_r + marker_h, c] = stack\n        else:\n            assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n            pass_columns.append(j)\n\n    for start_j, end_j in _runs(pass_columns):\n        source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n        top_r = H - marker_h\n\n        for j in range(start_j, end_j + 1):\n            c = c0 + j + shift\n            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n            out[top_r : top_r + marker_h, c] = marker[:, j]\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\nGRID_SIZE_RANGE = (14, 16)\nMARKER_SIZE = 3\nSTOP_COUNT_RANGE = (1, 3)\nOBSTACLE_COMPONENT_RANGE = (7, 9)\nOBSTACLE_PIXEL_RANGE = (20, 31)\nCOMPONENT_SIZE_RANGE = (1, 11)\nMIN_STOP_OBSTACLE_ROW = 6\nDROP_ZONE_HEIGHT = 3\nCOMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n===== /home/lixinyu/snap/new/ARC_code/train/18286ef8.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Use the pink control pixel to choose where the maroon pixel belongs inside the grey 3x3 region, and turn the control pixel maroon.\n\n    Input structure:\n    - The grid contains one 3x3 region made from eight grey pixels and one maroon pixel.\n    - There is exactly one pink control pixel outside that region.\n\n    Rule:\n    - Restore the old maroon cell in the 3x3 region to grey.\n    - Compare the pink pixel to the 3x3 region: above/same band/below selects top/middle/bottom, and left/same band/right selects left/middle/right.\n    - Paint the selected cell maroon and recolor the pink control pixel maroon.\n\n    Key insight:\n    - The pink pixel acts as a relative-position marker for a 3x3 target inside the grey region.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    marker = np.argwhere(g == Color.PINK)\n    assert marker.shape == (1, 2), f\"expected one pink control pixel, got {len(marker)}\"\n    pr, pc = map(int, marker[0])\n\n    guide_mask = (g == Color.GREY) | (g == Color.MAROON)\n    guide_bbox = bbox(guide_mask)\n    assert guide_bbox is not None, \"missing grey/maroon guide region\"\n    r0, c0, r1, c1 = guide_bbox\n    assert (r1 - r0 + 1, c1 - c0 + 1) == (3, 3), \"guide region must be 3x3\"\n\n    block = g[r0 : r1 + 1, c0 : c1 + 1]\n    assert np.all((block == Color.GREY) | (block == Color.MAROON)), \"guide bbox contains non-guide colors\"\n    old = np.argwhere(block == Color.MAROON)\n    assert old.shape == (1, 2), f\"expected one maroon guide pixel, got {len(old)}\"\n    assert np.count_nonzero(block == Color.GREY) == 8, \"expected eight grey guide pixels\"\n    assert not (r0 <= pr <= r1 and c0 <= pc <= c1), \"pink control pixel must be outside guide region\"\n\n    tr = _relative_index(pr, r0, r1)\n    tc = _relative_index(pc, c0, c1)\n    old_r = r0 + int(old[0, 0])\n    old_c = c0 + int(old[0, 1])\n\n    out = g.copy()\n    out[old_r, old_c] = Color.GREY\n    out[tr, tc] = Color.MAROON\n    out[pr, pc] = Color.MAROON\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- CFG: tunable generation parameters ---\n_BAND_SIZE_MIN = 1          # min height/width of non-center bands\n_BAND_SIZE_MAX = 9          # max height/width of non-center bands\n_CENTER_BAND = 3    