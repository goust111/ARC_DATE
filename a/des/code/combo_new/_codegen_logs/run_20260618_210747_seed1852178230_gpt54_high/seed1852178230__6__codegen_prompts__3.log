= random.randint(*TOTAL_SPRITES_RANGE)\n505:    remaining = total - len(legends)\n506:    max_d = min(MAX_DISTRACTORS, remaining)\n507:    valid_d = [d for d in range(1, max_d + 1)\n509:    n_distractors = random.choice(valid_d)\n510:    extra_matches = remaining - n_distractors\n511:    extras = [0] * len(legends)\n512:    for _ in range(extra_matches):\n516:    plan = []\n517:    for i, (hole_count, color) in enumerate(legends):\n520:    legend_holes = {h for h, _ in legends}\n521:    distractor_holes = [h for h in range(MAX_HOLE_COUNT) if h not in legend_holes]\n522:    for _ in range(n_distractors):\n524:    random.shuffle(plan)\n525:    return plan\n529:    \"\"\"8-connectivity dilation of a boolean mask (1-cell padding in all directions).\"\"\"\n530:    return binary_dilation(mask, structure=_STRUCT8).astype(bool)\n534:    static_blocked: np.ndarray, occupied: np.ndarray, sprite: np.ndarray\n536:    \"\"\"Find a random valid placement for sprite, avoiding blocked and occupied areas.\"\"\"\n537:    h, w = sprite.shape\n538:    sprite_mask = sprite == GREY\n539:    occupied_pad = _dilate_mask(occupied != BG)\n540:    N = GRID_SIZE\n541:    candidates = [(r, c) for r in range(N - h + 1) for c in range(N - w + 1)]\n542:    random.shuffle(candidates)\n543:    for r, c in candidates:\n551:    return None\n555:    grid: np.ndarray, expected: np.ndarray, blocked: np.ndarray, legends: list[tuple[int, int]]\n557:    \"\"\"Generate and place all sprites (matches + distractors) onto the grid.\"\"\"\n558:    items = []\n559:    for hole_count, color in _sprite_plan(legends):\n564:    items.sort(key=lambda x: x[0], reverse=True)\n566:    occupied = np.zeros_like(grid)\n567:    for _, sprite, color in items:\n577:    return True\n583:    \"\"\"Single attempt: build layout, place sprites, validate via oracle.\"\"\"\n584:    N = GRID_SIZE\n585:    grid = np.zeros((N, N), dtype=int)\n586:    expected = np.zeros((N, N), dtype=int)\n587:    blocked = np.zeros((N, N), dtype=int)\n