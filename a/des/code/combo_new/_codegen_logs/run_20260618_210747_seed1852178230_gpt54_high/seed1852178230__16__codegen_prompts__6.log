ombo_new/seed1852178230/16/similarity_reports/4.json\n/home/lixinyu/snap/a/des/code/combo_new/seed1852178230/16/similarity_reports/5.json\n/home/lixinyu/snap/a/des/code/combo_new/seed1852178230/16/similarity_reports/6.json\n/home/lixinyu/snap/a/des/code/combo_new/seed1852178230/16/similarity_reports/7.json\n","exit_code":0,"status":"completed"}}
