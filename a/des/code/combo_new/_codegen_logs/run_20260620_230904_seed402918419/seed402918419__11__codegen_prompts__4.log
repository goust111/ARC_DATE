e — forming a 1-cell inner border.\n0034: \n0035:     Key insight: Only border-connected wall components act as real barriers; interior wall fragments are decorations to be removed.\n0036:     \"\"\"\n0037:     g = np.asarray(grid, dtype=int)\n0038:     h, w = g.shape\n0039:     bg = get_bg(g)\n0040: \n0041:     out = g.copy()\n0042: \n0043:     # Marker pixel is a unique (count==1) non-bg pixel on a corner.\n0044:     counts = Counter(int(v) for v in g.ravel())\n0045:     corners = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]\n0046:     marker = None\n0047:     for r, c in corners:\n0048:         v = int(g[r, c])\n0049:         if v != bg and counts.get(v, 0) == 1:\n0050:             marker = (r, c, v)\n0051:             break\n0052:     assert marker is not None, \"no unique single-pixel corner marker found\"\n0053: \n0054:     mr, mc, marker_col = marker\n0055: \n0056:     # Wall color: most frequent non-bg, non-marker color.\n0057:     other_cols = [c for c in counts.keys() if c not in (bg, marker_col)]\n0058:     assert other_cols, \"no non-bg non-marker colors found; cannot determine wall color\"\n0059:     wall_col = max(other_cols, key=lambda c: counts[c])\n0060: \n0061:     # First reach: treat all wall pixels as obstacles.\n0062:     reach0 = _flood(\n0063:         (mr, mc),\n0064:         lambda r, c: int(g[r, c]) in (bg, marker_col),\n0065:         h,\n0066:         w,\n0067:     )\n0068: \n0069:     # Structural walls are wall-color components that touch the border AND are adjacent to reach0.\n0070:     walls: set[tuple[int, int]] = set()\n0071:     for comp_arr in components_mask(g == wall_col, connectivity=4):\n0072:         comp = [(int(r), int(c)) for r, c in comp_arr]\n0073:         touches_border = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp)\n0074:         if not touches_border:\n0075:             continue\n0076:         adjacent_to_reach0 = any(any((nr, nc) in reach0 for nr, nc in neighbors4(r, c)) for r, c in comp)\n00