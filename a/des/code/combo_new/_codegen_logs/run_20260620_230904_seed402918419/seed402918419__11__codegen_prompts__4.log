s interior column span.\n0039: \n0040:     Rule\n0041:     - Remove the movable object from its original cells.\n0042:     - Keep its shape and color unchanged.\n0043:     - Paste it with its bbox columns aligned to the top bracket's interior columns and with its bbox bottom aligned to the grid bottom.\n0044: \n0045:     Key insight\n0046:     - The lower bracket identifies the object's source lane; the upper bracket provides the target lane, and the final vertical placement is bottom-aligned.\n0047:     \"\"\"\n0048:     g = np.asarray(grid, dtype=int)\n0049:     height, width = g.shape\n0050:     bg = get_bg(g)\n0051: \n0052:     components_by_color = {}\n0053:     bracket_candidates = []\n0054:     for color in colors_present(g, exclude={bg}):\n0055:         components = find_components(\n0056:             g,\n0057:             bg=bg,\n0058:             colors=[color],\n0059:             connectivity=4,\n0060:             monochromatic=True,\n0061:         )\n0062:         components_by_color[color] = components\n0063:         top = [component for component in components if _is_top_bracket(component)]\n0064:         bottom = [\n0065:             component for component in components\n0066:             if _is_bottom_bracket(component, height)\n0067:         ]\n0068:         if len(components) == 2 and len(top) == 1 and len(bottom) == 1:\n0069:             bracket_candidates.append((color, top[0], bottom[0]))\n0070: \n0071:     assert len(bracket_candidates) == 1\n0072:     frame_color, top_bracket, bottom_bracket = bracket_candidates[0]\n0073: \n0074:     movers = [\n0075:         component\n0076:         for color, components in components_by_color.items()\n0077:         if color != frame_color\n0078:         for component in components\n0079:     ]\n0080:     assert len(movers) == 1\n0081:     mover = movers[0]\n0082: \n0083:     _, mc0, _, mc1 = mover[\"bbox\"]\n0084:     _br0, bc0, _br1, bc1 = bottom_bracket[\"bbox\"]\n0085:     _tr0, tc0, _tr1, tc1 = top_bracket[\"bbox\"]\n0086:     assert (mc0, mc1) == (bc0 + 1, bc1 - 1)\n0087:     assert bbox_w(mover[\"bbox\"]) == tc1 - tc0 - 1\n0088: \n0089:     patch = crop_bbox(g, mover[\"bbox\"])\n0090:     dest_r = height - patch.shape[0]\n0091:     dest_c = tc0 + 1\n0092:     assert dest_r >= 0\n0093:     assert dest_c >= 0 and dest_c + patch.shape[1] <= width\n0094: \n0095:     out = g.copy()\n0096:     mover_coords = mover[\"coords\"]\n0097:     out[mover_coords[:, 0], mover_coords[:, 1]] = bg\n0098: \n0099:     colored_patch = patch != bg\n0100:     target = out[dest_r:dest_r + patch.shape[0], dest_c:dest_c + patch.shape[1]]\n0101:     assert np.all(target[colored_patch] == bg)\n0102: \n0103:     paste(out, patch, dest_r, dest_c, transparent=bg)\n0104:     return out\n0105: \n0106: # --------------- generator (o5x) ---------------\n0107: \n0108: # Fixed task colors.\n0109: BG_COLOR, BRACKET_COLOR = 7, 4\n0110: MOVER_COLORS = [0, 1, 2, 3, 5, 6, 8, 9]\n0111: # Canvas, bracket, and mover-size bounds.\n---\n0215:     return None\n0216: \n0217: def generate_input():\n0218:     for _ in range(MAX_GENERATION_ATTEMPTS):\n0219:         grid = _gen_attempt()\n0220:         if grid is not None:\n0221:             return grid\n0222:     raise RuntimeError(\"failed to generate df9fd884 input\")\n---\n====\nFILE: /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\n0272: \n0273: \n0274: def main(grid: np.ndarray) -> np.ndarray:\n0275:     \"\"\"\n0276:     Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n0277: \n0278:     Input structure:\n0279:     - bg = most common color. Several hollow sprites with distinct border colors.\n0280:     - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n0281: \n0282:     Rule:\n0283:     - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n0284:     - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n0285:     - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n0286: \n0287:     Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n0288:     \"\"\"\n0289:     g = np.asarray(grid, dtype=int)\n0290:     bg = _bg_boundary(g)\n0291: \n0292:     mapping, pal_mask = _palette_mapping(g, bg)\n0293:     assert mapping, \"main: palette mapping must be non-empty\"\n0294: \n0295:     out = g.copy()\n0296:     _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n0297: \n0298:     return out\n0299: \n0300: # --------------- generator (c) ---------------\n0301: \n0302: # -- Configuration constants --------------------------------------------------\n0303: # Grid dimensions\n0304: _GRID_H_MIN, _GRID_H_MAX = 4, 13\n0305: _GRID_W_MIN, _GRID_W_MAX = 10, 15\n0306: _SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n0307: _SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n0308: _TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n0309: \n0310: # Palette\n0311: _PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n0312: \n0313: # Sprite geometry\n0314: _SPRITE_H_MAX = 7\n0315: _SPRITE_W_MAX = 6\n0316: _SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n0317: _SPRITE_CELL_MAX = 16\n0318: _FILLED_SPRITE_MAX = 3\n0319: \n0320: # Sprite mutation probabilities\n0321: _P_HORIZ_WALL = 0.3           # add horizontal internal wall\n0322: _P_VERT_WALL = 0.3            # add vertical internal wall\n0323: _P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n0324: _P_DIAMOND = 0.2              # use diamond shape for 3x3\n0325: \n0326: # Generation\n0327: _MAX_RETRIES = 300\n0328: # -- End configuration --------------------------------------------------------\n0329: \n0330: \n0331: def _get_enclosed_holes(sprite):\n0332:     \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n0333:     h, w = sprite.shape\n0334:     return [pts for pts in components_mask(~sprite, connectivity=4)\n0335:             if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n0336: \n0337: \n0338: def _make_diamond():\n0339:     \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n0340:     s = np.zeros((3, 3), dtype=bool)\n0341:     s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n0342:     return s\n0343: \n0344: \n0345: def _make_hollow_sprite(h, w, rng):\n0346:     \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n0347:     sprite = np.ones((h, w), dtype=bool)\n0348:     if h >= 3 and w >= 3:\n0349:         sprite[1:-1, 1:-1] = False\n0350:     # Optionally add internal horizontal wall\n0351:     if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n0352:         br = rng.randint(2, h - 2)\n0353:         n = rng.randint(1, w - 2)\n---\n0542: \n0543: \n0544: def generate_input():\n0545:     for _ in range(_MAX_RETRIES):\n0546:         r = _gen_attempt()\n0547:         if r is not None:\n0548:             return r\n0549:     raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n---\n====\nFILE: /home/lixinyu/snap/new/ARC_code/train/753ea09b.py\n0057: \n0058: \n0059: def main(grid: np.ndarray) -> np.ndarray:\n0060:     \"\"\"\n0061:     Fill the small background compartments bounded by the long contour color.\n0062: \n0063:     Input structure:\n0064:     - The grid has one dominant background color and two foreground colors.\n0065:     - The more frequent foreground color forms long 8-connected contour fragments.\n0066:     - The other foreground color is a fixed distractor/obstacle color that partitions\n0067:       the background but is never recolored.\n0068: \n0069:     Rule:\n0070:     - Split the background into 4-connected regions using all foreground pixels as\n0071:       barriers.\n0072:     - Keep the two largest background regions as the outside of the contour drawing.\n0073:     - Recolor every other background region that touches a long contour component\n0074:       to the contour color; leave all foreground pixels unchanged.\n0075: \n0076:     Key insight:\n0077:     The apparent area fill is exactly a component-level fill of bounded background\n0078:     compartments, not a row-wise interpolation between individual contour pixels.\n0079:     \"\"\"\n0080:     g = np.asarray(grid, dtype=int)\n0081:     bg = get_bg(g)\n0082:     foreground = colors_present(g, exclude={bg})\n0083:     assert len(foreground) == 2, \"expected exactly two foreground colors\"\n0084: \n0085:     fill_color = _unique_largest_color(g, foreground)\n0086:     fill_lab, _n_fill = label_mask(g == fill_color, connectivity=8)\n0087:     long_ids = _long_component_ids(fill_lab, _n_fill)\n0088: \n0089:     bg_lab, n_bg = label_mask(g == bg, connectivity=4)\n0090:     exterior_ids = _two_exterior_bg_ids(bg_lab, n_bg)\n0091: \n0092:     out = g.copy()\n0093:     for comp_id in range(1, n_bg + 1):\n0094:         if comp_id in exterior_ids:\n0095:             continue\n0096:         coords = np.argwhere(bg_lab == comp_id)\n0097:         if _touches_long_contour(coords, fill_lab, long_ids):\n0098:             out[bg_lab == comp_id] = fill_color\n0099: \n0100:     return out\n0101: \n0102: # --------------- generator (att2) ---------------\n0103: \n0104: # Canvas and palette.\n0105: H, W = 30, 30\n0106: GRID_SHAPE = (H, W)\n0107: ARC_COLOR_COUNT = 10\n0108: \n0109: # Long contour path layout.\n0110: PATH_COUNT_OPTIONS = (2, 3)\n0111: PATH_STEP_OPTIONS = (-1, 0, 1)\n0112: PATH_GAP_MIN, PATH_GAP_MAX = 2, 5\n0113: PATH_LEFT_MIN_COL, PATH_RIGHT_MARGIN = 2, 3\n0114: PATH_START_MIN_COL = 3\n0115: PATH_START_RIGHT_MARGIN = 4\n0116: PATH_FAR_END_MIN_CHOICES, PATH_FAR_END_PROB, PATH_FAR_END_DELTA = 8, 0.7, 5\n0117: PATH_SCORING_CANDIDATES = 5\n0118: PATH_MIN_MOVES = 12\n0119: \n0120: # Contour distractors and extra contour pixels.\n0121: OUTSIDE_MARGIN = 2\n0122: OUTSIDE_SIDE_OPTIONS = (-1, 1)\n0123: SHORT_FRAGMENT_COUNT_MIN, SHORT_FRAGMENT_COUNT_MAX = 3, 5\n0124: SHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX = 1, 4\n0125: SHORT_FRAGMENT_ATTEMPTS = 200\n0126: SHORT_FRAGMENT_PATH_PADDING = 3\n0127: CONTOUR_PIXELS_MIN, CONTOUR_PIXELS_MAX = 81, 108\n0128: \n0129: # Obstacle bars and scattered clusters.\n0130: BAR_SEGMENT_MAX = 11\n0131: SINGLE_CHANNEL_BARS_MIN, SINGLE_CHANNEL_BARS_MAX = 5, 11\n0132: MULTI_CHANNEL_TOTAL_BARS_MIN, MULTI_CHANNEL_TOTAL_BARS_MAX = 4, 10\n0133: MULTI_CHANNEL_INITIAL_BARS = 2\n0134: MULTI_CHANNEL_MAX_BARS = 5\n0135: BAR_WIDTH_MIN, BAR_WIDTH_MAX = 1, 5\n0136: OBSTACLE_PIXELS_MIN, OBSTACLE_PIXELS_MAX = 36, 63\n0137: OBSTACLE_EXTRA_PIXELS_MIN = 8\n0138: OBSTACLE_OUTSIDE_QUOTA_MIN, OBSTACLE_OUTSIDE_QUOTA_MAX = 8, 16\n---\n0562: \n0563: \n0564: def generate_input() -> np.ndarray:\n0565:     for _ in range(GENERATION_ATTEMPTS):\n0566:         grid = _gen_attempt()\n0567:         if grid is not None:\n0568:             return grid\n0569:     raise RuntimeError(\"failed to generate valid 753ea09b input\")\n---\n====\nFILE: /home/lixinyu/snap/new/ARC_code/train/98c475bf.py\n0059: \n0060: \n0061: def main(grid: np.ndarray) -> np.ndarray:\n0062:     \"\"\"Erase the complete interior glyph and expand each endpoint marker pair into its color's full glyph.\n0063: \n0064:     Input structure\n0065:     - The grid is 20x20 with background inside two same-color full-height vertical frame bars.\n0066:     - Inside the frame there is one complete color glyph and one or more other colors appearing only as two endpoint markers in the same row.\n0067:     - Marker endpoints are always in the first and last interior columns.\n0068: \n0069:     Rule\n0070:     - Keep the vertical frame unchanged.\n0071:     - Erase any complete interior glyph.\n0072:     - For each endpoint marker pair, use that marker color's learned glyph template and anchor its horizontal bar on the marker row.\n0073: \n0074:     Key insight\n0075:     - Color identifies which glyph shape to draw; the two endpoint pixels are not copied objects, they are anchors for reconstructing that color's full symbol.\n0076:     \"\"\"\n0077:     g = np.asarray(grid, dtype=int)\n0078:     assert g.ndim == 2\n0079:     height, width = g.shape\n0080:     assert (height, width) == (20, 20)\n0081: \n0082:     bg = get_bg(g)\n0083:     assert bg == 0\n0084:     frame_color = int(g[0, 0])\n0085:     assert frame_color != bg\n0086:     assert np.all(g[:, 0] == frame_color)\n0087:     assert np.all(g[:, -1] == frame_color)\n0088:     assert np.count_nonzero(g == frame_color) == 2 * height\n0089: \n0090:     out = g.copy()\n0091:     marker_jobs: list[tuple[int, int]] = []\n0092:     erased_any = False\n0093: \n0094:     for color0 in np.unique(g):\n0095:         color = int(color0)\n0096:         if color in (bg, frame_color):\n0097:             continue\n0098: \n0099:         coords = np.argwhere(g == color)\n0100:         rows = _marker_rows(coords, width)\n0101:         if rows is not None:\n0102:             for row in rows:\n0103:                 marker_jobs.append((color, row))\n0104:         else:\n0105:             assert len(coords) > 2\n0106:             out[g == color] = bg\n0107:             erased_any = True\n0108: \n0109:     assert erased_any\n0110:     assert marker_jobs\n0111: \n0112:     claimed: dict[tuple[int, int], int] = {}\n0113:     for color, anchor_row in marker_jobs:\n0114:         for dr, c in _glyph_cells(color, width):\n0115:             r = anchor_row + dr\n0116:             assert 0 <= r < height\n0117:             assert LEFT_MARKER_COL <= c <= width - 2\n0118:             assert (r, c) not in claimed or claimed[(r, c)] == color\n0119:             assert out[r, c] in (bg, color)\n0120:             claimed[(r, c)] = color\n0121: \n0122:     for (r, c), color in claimed.items():\n0123:         out[r, c] = color\n0124: \n0125:     return out\n0126: \n0127: # --------------- generator (att2) ---------------\n0128: \n0129: # Canvas and palette.\n0130: _GEN_SIZE = 20\n0131: _GEN_GLYPH_COLORS = [1, 2, 3, 6, 7]\n0132: _GEN_FRAME_COLORS = (1, 2, 5, 7, 9)\n0133: # Object counts and retry budget.\n0134: _GEN_MARKER_COUNT_RANGE = (1, 3)\n0135: _GEN_RETRIES = 300\n0136: \n0137: \n0138: def _gen_abs_cells(color: int, anchor_row: int) -> set[tuple[int, int]]:\n0139:     return {(anchor_row + dr, c) for dr, c in _glyph_cells(color, _GEN_SIZE)}\n0140: \n---\n0221: \n0222: \n0223: def generate_input() -> np.ndarray:\n0224:     for _ in range(_GEN_RETRIES):\n0225:         grid = _gen_attempt()\n0226:         if grid is not None:\n0227:             return grid\n0228:     raise RuntimeError(\"failed to generate valid input\")\n---\n====\nFILE: /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\n0006: from arc_utils import bbox_h, bbox_w, find_components, in_bounds, neighbors4, paste\n0007: \n0008: def main(grid: np.ndarray) -> np.ndarray:\n0009:     \"\"\"\n0010:     Slide a solid square through a winding channel to reach a same-sized target square.\n0011: \n0012:     Input structure:\n0013:     - bg (most common color). A river color forms a winding corridor.\n0014:     - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n0015: \n0016:     Rule:\n0017:     - The mover square travels along the river toward the destination.\n0018:     - It can only pass through positions where the full NxN area is river.\n0019:     - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n0020:     - The mover's original position is filled with the river color.\n0021: \n0022:     Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n0023:     \"\"\"\n0024:     g = np.array(grid, dtype=int)\n0025:     H, W = g.shape\n0026: \n0027:     # Corner-majority background (more stable than global mode here).\n0028:     bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n0029: \n0030:     # Detect solid square components (excluding bg).\n0031:     squares: list[dict] = []\n0032:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n0033:         col = int(comp[\"color\"])\n0034:         b = comp[\"bbox\"]\n0035:         if bbox_h(b) != bbox_w(b):\n0036:             continue\n0037:         patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n0038:         if not bool((patch == int(col)).all()):\n0039:             continue\n0040:         squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n0041: \n0042:     assert not (len(squares) < 2)\n0043: \n0044:     # Choose the size that appears at least twice (most common size).\n0045:     by_n: dict[int, list[dict]] = defaultdict(list)\n0046:     for s in squares:\n0047:         by_n[int(s[\"n\"])].append(s)\n0048:     nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n0049:     cand = by_n[int(nside)]\n0050:     assert not (len(cand) < 2)\n0051: \n0052:     cand.sort(key=lambda s: int(s[\"col\"]))\n0053:     mover = cand[0]\n0054:     dest = cand[1]\n0055: \n0056:     n = int(mover[\"n\"])\n0057:     sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n0058:     dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n0059: \n0060:     # River = most common remaining color (excluding bg and the two square colors).\n0061:     counts = Counter(map(int, g.flatten()))\n0062:     river = None\n0063:     for col, _ct in counts.most_common():\n0064:         if int(col) == int(bg):\n0065:             continue\n0066:         if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n0067:             continue\n0068:         river = int(col)\n0069:         break\n0070:     assert not (river is None)\n0071: \n0072:     trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n0073: \n0074:     # Feasible top-left placements: NxN window fully inside trav.\n0075:     h2 = int(H - n + 1)\n0076:     w2 = int(W - n + 1)\n0077:     assert not (h2 <= 0 or w2 <= 0)\n0078:     assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n0079: \n0080:     feasible = np.zeros((h2, w2), dtype=bool)\n0081:     for r in range(h2):\n0082:         for c in range(w2):\n0083:             if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n0084:                 feasible[int(r), int(c)] = True\n0085:     assert not (not bool(feasible[int(sr), int(sc)]))\n0086: \n0087:     # BFS on placement grid.\n---\n0469: \n0470: \n0471: def generate_input():\n0472:     for _ in range(300):\n0473:         result = _gen_attempt()\n0474:         if result is not None:\n0475:             return result\n0476:     raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n0477: \n0478: \n---\n====\nFILE: /home/lixinyu/snap/new/ARC_code/eval/7c66cb00.py\n0006: from arc_utils import get_bg, paste\n0007: \n0008: def main(grid: np.ndarray) -> np.ndarray:\n0009:     \"\"\"\n0010:     Dock two-tone sprites into color-matched horizontal bars with a color swap.\n0011: \n0012:     Input structure:\n0013:     - bg = most common color.\n0014:     - Top area: small two-tone sprites (outer color + inner color).\n0015:     - Below: horizontal bars spanning most of the row, each with a fill color and border color on edges.\n0016: \n0017:     Rule:\n0018:     - Match each sprite to the bar whose fill color equals the sprite's outer color.\n0019:     - Place the sprite at its original x-position, aligned to the bar's bottom.\n0020:     - Recolor: sprite outer → bar border, sprite inner → bar fill.\n0021:     - Erase original sprites from the top area.\n0022: \n0023:     Key insight: Color matching is inverted — the sprite's dominant color identifies its target bar, then gets swapped to the bar's accent color.\n0024:     \"\"\"\n0025:     g = np.array(grid, dtype=int)\n0026:     H, W = g.shape\n0027:     out = g.copy()\n0028:     bg = int(Counter(g.flatten()).most_common(1)[0][0])\n0029: \n0030:     # Find bars.\n0031:     bars = []\n0032:     current_bar = None\n0033:     for r in range(H):\n0034:         row = g[int(r), :]\n0035:         non_bg = [int(v) for v in row if int(v) != int(bg)]\n0036:         if non_bg:\n0037:             c = Counter(non_bg)\n0038:             fill_color, count = c.most_common(1)[0]\n0039:             if int(count) > int(W * 0.7):\n0040:                 border = int(row[0]) if int(row[0]) != int(fill_color) else int(row[-1])\n0041:                 if current_bar and int(current_bar[\"fill\"]) == int(fill_color):\n0042:                     current_bar[\"r_max\"] = int(r)\n0043:                 else:\n0044:                     if current_bar:\n0045:                         bars.append(current_bar)\n0046:                     current_bar = {\"fill\": int(fill_color), \"border\": int(border), \"r_min\": int(r), \"r_max\": int(r)}\n0047:             else:\n0048:                 if current_bar:\n0049:                     bars.append(current_bar)\n0050:                     current_bar = None\n0051:         else:\n0052:             if current_bar:\n0053:                 bars.append(current_bar)\n0054:                 current_bar = None\n0055:     if current_bar:\n0056:         bars.append(current_bar)\n0057: \n0058:     assert bars, \"No bars found — grid must contain at least one horizontal bar\"\n0059: \n0060:     pattern_area_end = int(min(int(b[\"r_min\"]) for b in bars))\n0061: \n0062:     # Find patterns in top area: monochrome components by color, but we need full bbox content.\n0063:     patterns = []\n0064:     top = g[:pattern_area_end, :]\n0065:     for col in sorted(set(map(int, top.flatten())) - {int(bg)}):\n0066:         mask = top == int(col)\n0067:         if not bool(mask.any()):\n0068:             continue\n0069:         lab, n = label_mask(mask, connectivity=4)\n0070:         for region_id in range(1, int(n) + 1):\n0071:             coords = np.argwhere(lab == int(region_id))\n0072:             if coords.size == 0:\n0073:                 continue\n0074:             b = bbox_coords(coords)\n0075:             r0, c0, r1, c1 = map(int, b)\n0076:             bbox = crop_bbox(g, (r0, c0, r1, c1))\n0077: \n0078:             colors_in_bbox = Counter(map(int, bbox.flatten()))\n0079:             colors_in_bbox.pop(int(bg), None)\n0080:             if not colors_in_bbox:\n0081:                 continue\n0082:             outer_color = int(colors_in_bbox.most_common(1)[0][0])\n0083:             inner_colors = [int(c) for c in colors_in_bbox.keys() if int(c) != int(outer_color)]\n0084:             inner_color = int(inner_colors[0]) if inner_colors else None\n0085: \n0086:             patterns.append(\n0087:                 {\n---\n0311: \n0312: \n0313: def generate_input() -> np.ndarray:\n0314:     for _ in range(GEN_RETRIES):\n0315:         grid = _gen_attempt()\n0316:         if grid is not None:\n0317:             return grid\n0318:     raise RuntimeError(f\"failed to generate a valid input after {GEN_RETRIES} attempts\")\n---\n====\nFILE: /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\n0039: \n0040: \n0041: def main(grid: np.ndarray) -> np.ndarray:\n0042:     \"\"\"\n0043:     Fill enclosed regions along a line seeded by unique border pixels.\n0044: \n0045:     Input structure:\n0046:     - bg = most common color.\n0047:     - Colored lines/drawings on the grid.\n0048:     - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n0049: \n0050:     Rule:\n0051:     - Each border seed pixel connects (8-connected) to a line drawing.\n0052:     - Find closed bg cavities whose boundary touches that line.\n0053:     - Flood-fill each such cavity with the seed pixel's color.\n0054: \n0055:     Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n0056:     \"\"\"\n0057:     g = np.asarray(grid, dtype=int)\n0058:     h, w = g.shape\n0059:     bg = get_bg(g)\n0060: \n0061:     out = g.copy()\n0062: \n0063:     # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n0064:     bg_comps = _components_mask(g == bg, conn8=False)\n0065:     regions = []  # list of (set_pts, boundary_set, touches_border, size)\n0066:     for pts in bg_comps:\n0067:         region = set(pts)\n0068:         touches = _touches_border(pts, h, w)\n0069:         boundary = set()\n0070:         for r, c in region:\n0071:             for nr, nc in neighbors4(r, c):\n0072:                 if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n0073:                     boundary.add((nr, nc))\n0074:         regions.append((region, boundary, touches, len(region)))\n0075: \n0076:     corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n0077:     outside_idxs = set()\n0078:     for i, (reg, _, _, _) in enumerate(regions):\n0079:         if any(p in reg for p in corners if int(g[p]) == bg):\n0080:             outside_idxs.add(i)\n0081: \n0082:     cavities = []\n0083:     for i, (reg, bnd, _, _) in enumerate(regions):\n0084:         if i in outside_idxs or not bnd:\n0085:             continue\n0086:         bcols = {int(g[p]) for p in bnd}\n0087:         cavities.append((reg, bnd, bcols))\n0088: \n0089:     for sr, sc in _seed_pixels(g, bg):\n0090:         seed_col = int(g[sr, sc])\n0091: \n0092:         neigh_cols = []\n0093:         for nr, nc in neighbors4(sr, sc):\n0094:             if 0 <= nr < h and 0 <= nc < w:\n0095:                 v = int(g[nr, nc])\n0096:                 if v != bg:\n0097:                     neigh_cols.append(v)\n0098:         assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n0099:         line_col = Counter(neigh_cols).most_common(1)[0][0]\n0100: \n0101:         # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n0102:         traced = _nonbg_component8_from(g, (sr, sc), bg)\n0103: \n0104:         for cav, boundary, bcols in cavities:\n0105:             if len(bcols) != 1:\n0106:                 continue\n0107:             boundary_in_traced = boundary & traced\n0108:             if not boundary_in_traced:\n0109:                 continue\n0110: \n0111:             # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n0112:             # This prevents filling regions that are only connected through other structures, not the line itself.\n0113:             ok = False\n0114:             for r, c in boundary_in_traced:\n0115:                 for nr, nc in neighbors8(r, c):\n0116:                     if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n0117:                         ok = True\n0118:                         break\n0119:                 if ok:\n0120:                     break\n---\n0506: \n0507: \n0508: def generate_input() -> np.ndarray:\n0509:     rng = random.Random()\n0510:     for _ in range(GEN_RETRIES):\n0511:         g = _gen_attempt(rng)\n0512:         if g is not None:\n0513:             return g\n0514:     raise RuntimeError(\"generate_input: exhausted attempts\")\n---\n====\n","exit_code":0,"status":"completed"}}
