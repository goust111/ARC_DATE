{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/230f2e48.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, in_bounds, neighbors4\nimport random\n\n\ndef _line_color(g: np.ndarray, bg: int) -> int:\n    vals, counts = np.unique(g[g != int(bg)], return_counts=True)\n    assert vals.size == 3, \"expected one line color and two marker colors\"\n    max_count = int(counts.max())\n    winners = vals[counts == max_count]\n    assert winners.size == 1, \"line color must be uniquely most common\"\n    return int(winners[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fold each straight red rod at its black marker, leaving the gray-anchored side fixed.\n\n    Input structure:\n    - The background is the dominant color.\n    - Each foreground object is a straight horizontal or vertical 4-connected rod.\n    - Each rod contains many pixels of one line color, one endpoint marker, and one\n      interior control marker.\n\n    Rule:\n    - For every rod, keep the segment from the endpoint marker through the control\n      marker unchanged.\n    - Move the line-color tail on the far side of the control marker to a\n      perpendicular ray starting next to that marker.\n    - Choose the perpendicular direction with more space to the grid edge.\n\n    Key insight:\n    - The endpoint marker identifies the fixed side of the rod, while the control\n      marker is the hinge; the tail folds into the larger open half-plane.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = get_bg(g)\n    line_color = _line_color(g, bg)\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert components, \"expected at least one marked rod\"\n\n    clear: list[tuple[int, int]] = []\n    paint: list[tuple[int, int]] = []\n\n    for comp in components:\n        coords = [tuple(map(int, coord)) for coord in comp[\"coords\"]]\n        coord_set = set(coords)\n        marker_coords = [p for p in coords if int(g[p]) != line_color]\n        assert len(marker_coords) == 2, \"each rod must have exactly two markers\"\n\n        degrees = {\n            p: sum((nr, nc) in coord_set for nr, nc in neighbors4(*p))\n            for p in marker_coords\n        }\n        endpoints = [p for p, degree in degrees.items() if int(degree) == 1]\n        hinges = [p for p, degree in degrees.items() if int(degree) == 2]\n        assert len(endpoints) == 1 and len(hinges) == 1, \"markers must be endpoint and hinge\"\n        endpoint = endpoints[0]\n        hinge = hinges[0]\n\n        rows = {r for r, _c in coords}\n        cols = {c for _r, c in coords}\n        assert len(rows) == 1 or len(cols) == 1, \"each object must be a straight rod\"\n\n        if len(rows) == 1:\n            assert endpoint[0] == hinge[0], \"horizontal rod markers must share a row\"\n            fixed_sign = int(np.sign(endpoint[1] - hinge[1]))\n            assert fixed_sign != 0, \"endpoint and hinge must be distinct\"\n            tail_step = (0, -fixed_sign)\n            up_space = int(hinge[0])\n            down_space = int(H - 1 - hinge[0])\n            assert up_space != down_space, \"perpendicular direction must be unique\"\n            fold_step = (-1, 0) if up_space > down_space else (1, 0)\n        else:\n            assert endpoint[1] == hinge[1], \"vertical rod markers must share a column\"\n            fixed_sign = int(np.sign(endpoint[0] - hinge[0]))\n            assert fixed_sign != 0, \"endpoint and hinge must be distinct\"\n            tail_step = (-fixed_sign, 0)\n            left_space = int(hinge[1])\n            right_space = int(W - 1 - hinge[1])\n            assert left_space != right_space, \"perpendicular direction must be unique\"\n            fold_step = (0, -1) if left_space > right_space else (0, 1)\n\n        tail: list[tuple[int, int]] = []\n        step = 1\n        while True:\n            p = (\n                int(hinge[0]) + int(tail_step[0]) * step,\n                int(hinge[1]) + int(tail_step[1]) * step,\n            )\n            if p not in coord_set:\n                break\n            assert int(g[p]) == line_color, \"tail must contain only line-color pixels\"\n            tail.append(p)\n            step += 1\n        assert tail, \"each hinge must have a moving tail\"\n\n        for step in range(1, len(tail) + 1):\n            p = (\n                int(hinge[0]) + int(fold_step[0]) * step,\n                int(hinge[1]) + int(fold_step[1]) * step,\n            )\n            assert in_bounds(g.shape, *p), \"folded tail must remain in bounds\"\n            paint.append(p)\n        clear.extend(tail)\n\n    assert len(set(clear)) == len(clear), \"moving tails must not overlap\"\n    assert len(set(paint)) == len(paint), \"folded tails must not collide\"\n    clear_set = set(clear)\n    for p in paint:\n        assert int(g[p]) == int(bg) or p in clear_set, \"fold target must be empty\"\n\n    out = g.copy()\n    for p in clear:\n        out[p] = bg\n    for p in paint:\n        out[p] = line_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# ARC colors.\nBG, RED, HINGE, END = 7, 2, 0, 5\n\n# Canvas and rod-count sampling.\nGRID_SIZE_MIN, GRID_SIZE_MAX = 8, 16\nROD_COUNT_MIN, ROD_COUNT_MAX = 1, 7\nROD_DENSITY_DIVISOR = 28\n\n# Rod geometry sampling.\nHORIZONTAL, VERTICAL = \"h\", \"v\"\nORIENTATIONS = (HORIZONTAL, VERTICAL)\nFIXED_SIGNS = (-1, 1)\nROD_LEN_MIN, ROD_LEN_MAX = 3, 12\nFIXED_LEN_MIN, FIXED_LEN_MAX = 2, 9\nTAIL_LEN_MAX = 5\n\n# Placement and retry controls.\nGAP_DIRECTIONS = ((-1, 0), (1, 0), (0, -1), (0, 1))\nMAX_GENERATE_ATTEMPTS = 300\n\nRecord = dict[str, object]\nRecordKey = tuple[int, int, int, str]\n\n_RECORD_CACHE: dict[int, list[tuple[RecordKey, Record]]] = {}\n\n\ndef _expanded(cells: set[tuple[int, int]], n: int) -> set[tuple[int, int]]:\n    out = set(cells)\n    shape = (n, n)\n    for r, c in cells:\n        for dr, dc in GAP_DIRECTIONS:\n            nr, nc = r + dr, c + dc\n            if in_bounds(shape, nr, nc):\n                out.add((nr, nc))\n    return out\n\n\ndef _fold_steps(n: int, orient: str, hinge: tuple[int, int], fixed_sign: int):\n    \"\"\"Return fixed-arm and fold steps, or None for a centered hinge.\"\"\"\n    r, c = hinge\n    if orient == HORIZONTAL:\n        up, down = r, n - 1 - r\n        if up == down:\n            return None\n        return (0, fixed_sign), ((-1, 0) if up > down else (1, 0))\n\n    left, right = c, n - 1 - c\n    if left == right:\n        return None\n    return (fixed_sign, 0), ((0, -1) if left > right else (0, 1))\n\n\ndef _ray_cells(origin: tuple[int, int], step: tuple[int, int], count: int) -> list[tuple[int, int]]:\n    r, c = origin\n    dr, dc = step\n    return [(r + dr * k, c + dc * k) for k in range(1, count + 1)]\n\n\ndef _record(n: int, orient: str, fixed_len: int, tail_len: int, hinge: tuple[int, int], fixed_sign: int):\n    steps = _fold_steps(n, orient, hinge, fixed_sign)\n    if steps is None:\n        return None\n\n    fixed_step, fold_step = steps\n    tail_step = (-fixed_step[0], -fixed_step[1])\n    fixed = _ray_cells(hinge, fixed_step, fixed_len - 1)\n    tail = _ray_cells(hinge, tail_step, tail_len)\n    folded = _ray_cells(hinge, fold_step, tail_len)\n\n    all_cells = fixed + tail + folded + [hinge]\n    shape = (n, n)\n    if any(not in_bounds(shape, rr, cc) for rr, cc in all_cells):\n        return None\n\n    endpoint = fixed[-1]\n    fixed_red = fixed[:-1]\n    input_cells = {hinge, endpoint, *fixed_red, *tail}\n    envelope = input_cells | set(folded)\n    if len(envelope) != len(input_cells) + len(folded):\n        return None\n\n    return {\n        \"hinge\": hinge,\n        \"endpoint\": endpoint,\n        \"fixed_red\": fixed_red,\n        \"tail\": tail,\n        \"folded\": folded,\n        \"envelope\": envelope,\n        \"red_count\": fixed_len + tail_len - 2,\n    }\n\n\ndef _all_records(n: int) -> list[tuple[RecordKey, Record]]:\n    if n in _RECORD_CACHE:\n        return _RECORD_CACHE[n]\n\n    records: list[tuple[RecordKey, Record]] = []\n    for orient in ORIENTATIONS:\n        for total_len in range(ROD_LEN_MIN, ROD_LEN_MAX + 1):\n            fixed_min = max(FIXED_LEN_MIN, total_len - TAIL_LEN_MAX)\n            fixed_max = min(FIXED_LEN_MAX, total_len - 1)\n            for fixed_len in range(fixed_min, fixed_max + 1):\n                tail_len = total_len - fixed_len\n                key = (total_len, fixed_len, tail_len, orient)\n                for r in range(n):\n                    for c in range(n):\n                        for fixed_sign in FIXED_SIGNS:\n                            rec = _record(n, orient, fixed_len, tail_len, (r, c), fixed_sign)\n                            if rec is not None:\n                                records.append((key, rec))\n    _RECORD_CACHE[n] = records\n    return records\n\n\ndef _choose_record(n: int, blocked: set[tuple[int, int]], rod_count: int, current_red: int, is_last: bool):\n    by_key: dict[RecordKey, list[Record]] = {}\n    for key, rec in _all_records(n):\n        total_len = key[0]\n        red_count = total_len - 2\n        if is_last and current_red + red_count <= rod_count:\n            continue\n        if rec[\"envelope\"] & blocked:\n            continue\n        by_key.setdefault(key, []).append(rec)\n\n    if not by_key:\n        return None\n\n    totals = sorted({key[0] for key in by_key})\n    total_len = random.choice(totals)\n    fixed_lengths = sorted({key[1] for key in by_key if key[0] == total_len})\n    fixed_len = random.choice(fixed_lengths)\n    orientations = sorted({key[3] for key in by_key if key[:2] == (total_len, fixed_len)})\n    orient = random.choice(orientations)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/902510d5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/902510d5.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _corner_distances(shape: tuple[int, int], corner: str, r: int, c: int) -> tuple[int, int]:\n    H, W = shape\n    if corner == \"TL\":\n        return int(r), int(c)\n    if corner == \"TR\":\n        return int(r), int(W - 1 - c)\n    if corner == \"BL\":\n        return int(H - 1 - r), int(c)\n    assert corner == \"BR\"\n    return int(H - 1 - r), int(W - 1 - c)\n\n\ndef _paint_corner_triangle(out: np.ndarray, corner: str, side: int, color: int) -> None:\n    H, W = out.shape\n    assert side > 0, \"triangle side length must be positive\"\n    for r in range(H):\n        for c in range(W):\n            a, b = _corner_distances((H, W), corner, r, c)\n            if a + b < side:\n                out[r, c] = int(color)\n\n\ndef _diagonal_direction(coords: set[tuple[int, int]]) -> str | None:\n    r0 = min(r for r, _ in coords)\n    r1 = max(r for r, _ in coords)\n    c0 = min(c for _, c in coords)\n    c1 = max(c for _, c in coords)\n    height = r1 - r0 + 1\n    width = c1 - c0 + 1\n    if height != width:\n        return None\n    n = height\n    local = {(r - r0, c - c0) for r, c in coords}\n    main_ok = all((c, r) in local for r, c in local)\n    anti_ok = all((n - 1 - c, n - 1 - r) in local for r, c in local)\n    if main_ok:\n        if (0, 0) in local and (n - 1, n - 1) not in local:\n            return \"TL\"\n        if (n - 1, n - 1) in local and (0, 0) not in local:\n            return \"BR\"\n    if anti_ok:\n        if (0, n - 1) in local and (n - 1, 0) not in local:\n            return \"TR\"\n        if (n - 1, 0) in local and (0, n - 1) not in local:\n            return \"BL\"\n    return None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Keep the largest 8-connected motif and replace the corner/control pixels with a solid corner triangle.\n\n    Input structure\n    - The background is the dominant color.\n    - Exactly one grid corner contains a foreground control pixel; it gives the\n      corner from which the triangle is painted.\n    - There is one unique largest 8-connected monochrome foreground object, the\n      motif that remains in the output; all other foreground pixels are controls.\n    - Every foreground component outside that motif is a singleton control pixel.\n    - The fill color is the unique control color that appears in at least two\n      non-corner control pixels.\n\n    Rule\n    - Start from a blank background canvas and redraw only the largest motif.\n    - Count the non-corner control pixels; that count is the triangle side.\n    - Paint the fill color on the right-triangle region where those two distances\n      from the marked corner's edges sum to less than the side length.\n\n    Key insight\n    - The scattered singleton controls are counted into a compact triangular\n      stack at the marked corner; only the largest motif is not part of the count.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    corners = {\n        \"TL\": (0, 0),\n        \"TR\": (0, W - 1),\n        \"BL\": (H - 1, 0),\n        \"BR\": (H - 1, W - 1),\n    }\n    marked_corners = [\n        (name, rc) for name, rc in corners.items() if int(g[rc]) != int(bg)\n    ]\n    assert len(marked_corners) == 1, \"expected exactly one foreground corner marker\"\n    corner, (corner_r, corner_c) = marked_corners[0]\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert comps, \"expected at least one foreground component\"\n    max_area = max(int(comp[\"area\"]) for comp in comps)\n    motif_candidates = [comp for comp in comps if int(comp[\"area\"]) == max_area]\n    assert len(motif_candidates) == 1, \"expected a unique largest motif\"\n    motif = motif_candidates[0]\n    motif_color = int(motif[\"color\"])\n    motif_coords = {tuple(map(int, coord)) for coord in motif[\"coords\"]}\n    motif_direction = _diagonal_direction(motif_coords)\n    assert motif_direction is not None, \"motif must be square and diagonal-symmetric\"\n    assert motif_direction == corner, \"corner marker must match motif diagonal direction\"\n\n    control_coords = [\n        (int(r), int(c))\n        for r, c in np.argwhere(g != bg)\n        if (int(r), int(c)) not in motif_coords\n    ]\n    assert (corner_r, corner_c) in control_coords, \"corner marker must be a control pixel\"\n    assert len(control_coords) > 1, \"expected non-corner control pixels\"\n\n    control_components = [comp for comp in comps if comp is not motif]\n    assert all(int(comp[\"area\"]) == 1 for comp in control_components), \"controls must be singleton components\"\n\n    control_counts = Counter(\n        int(g[r, c])\n        for r, c in control_coords\n        if (int(r), int(c)) != (corner_r, corner_c)\n    )\n    fill_candidates = [\n        int(color) for color, count in control_counts.items() if int(count) >= 2\n    ]\n    assert len(fill_candidates) == 1, \"expected one repeated non-corner fill color\"\n    fill_color = fill_candidates[0]\n    side = len(control_coords) - 1\n\n    out = np.full_like(g, bg)\n    for r, c in motif_coords:\n        out[r, c] = motif_color\n    _paint_corner_triangle(out, corner, int(side), fill_color)\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_ATTEMPTS = 300\n\n# Canvas and triangle bounds.\n_GEN_ROW_BOUNDS = (6, 15)\n_GEN_COL_BOUNDS = (9, 14)\n_GEN_TRIANGLE_SIDE_BOUNDS = (2, 5)\n\n# Color and control-pixel sampling.\n_GEN_COLORS = tuple(range(1, 10))\n_GEN_MARKER_AVOID_FILL_PROB = 0.8\n_GEN_FILL_COUNT_BOUNDS = (2, 3)\n\n# Sparse square motifs observed in the task examples.\n_GEN_MOTIF_TEMPLATES = [\n    (\"..#.\", \".#..\", \"#.#.\", \"...#\"),\n    (\".#...\", \"..#..\", \"..##.\", \".#..#\", \"#....\"),\n    (\n        \"...###...\",\n        \"..#......\",\n        \".##......\",\n        \"#..#.....\",\n        \"#...#....\",\n        \"#....#...\",\n        \"......#..\",\n        \".......#.\",\n        \"........#\",\n    ),\n    (\"#...\", \".#.#\", \"..#.\", \".#..\"),\n    (\"...#\", \"#.#.\", \"##..\", \".##.\"),\n]\n\n\ndef _gen_triangle_mask(shape, corner, side):\n    H, W = shape\n    rr, cc = np.indices((H, W))\n    if corner == \"TL\":\n        return rr + cc < side\n    if corner == \"TR\":\n        return rr + (W - 1 - cc) < side\n    if corner == \"BL\":\n        return (H - 1 - rr) + cc < side\n    return (H - 1 - rr) + (W - 1 - cc) < side\n\n\ndef _gen_dilate8(mask):\n    out = mask.copy()\n    out[1:, :] |= mask[:-1, :]\n    out[:-1, :] |= mask[1:, :]\n    out[:, 1:] |= mask[:, :-1]\n    out[:, :-1] |= mask[:, 1:]\n    out[1:, 1:] |= mask[:-1, :-1]\n    out[1:, :-1] |= mask[:-1, 1:]\n    out[:-1, 1:] |= mask[1:, :-1]\n    out[:-1, :-1] |= mask[1:, 1:]\n    return out\n\n\ndef _gen_patch_from_lines(lines):\n    return np.array([[ch == \"#\" for ch in row] for row in lines], dtype=bool)\n\n\ndef _gen_patch_variants(patch):\n    variants = []\n    seen = set()\n    for k in range(4):\n        rotated = np.rot90(patch, k)\n        for variant in (rotated, np.fliplr(rotated)):\n            key = tuple(map(tuple, variant.astype(int)))\n            if key not in seen:\n                seen.add(key)\n                variants.append(variant.copy())\n    return variants\n\n\ndef _gen_reflect_anti_diagonal(patch):\n    return np.flipud(np.fliplr(patch.T))\n\n\ndef _gen_is_diagonal_symmetric_patch(patch):\n    if patch.shape[0] != patch.shape[1]:\n        return False\n    main_ok = np.array_equal(patch, patch.T)\n    return main_ok or np.array_equal(patch, _gen_reflect_anti_diagonal(patch))\n\n\ndef _gen_patch_direction(patch):\n    if patch.shape[0] != patch.shape[1]:\n        return None\n    n = patch.shape[0]\n    main_ok = np.array_equal(patch, patch.T)\n    anti_ok = np.array_equal(patch, _gen_reflect_anti_diagonal(patch))\n    if main_ok:\n        if patch[0, 0] and not patch[n - 1, n - 1]:\n            return \"TL\"\n        if patch[n - 1, n - 1] and not patch[0, 0]:\n            return \"BR\"\n    if anti_ok:\n        if patch[0, n - 1] and not patch[n - 1, 0]:\n            return \"TR\"\n        if patch[n - 1, 0] and not patch[0, n - 1]:\n            return \"BL\"\n    return None\n\n\ndef _gen_symmetric_motif_patch(max_h, max_w):\n    candidates = []\n    for lines in _GEN_MOTIF_TEMPLATES:\n        patch = _gen_patch_from_lines(lines)\n        for variant in _gen_patch_variants(patch):\n            h, w = variant.shape\n            direction = _gen_patch_direction(variant)\n            if (\n                h <= max_h\n                and w <= max_w\n                and _gen_is_diagonal_symmetric_patch(variant)\n                and direction is not None\n            ):\n                candidates.append((variant, direction))\n    if not candidates:\n        return None\n    patch, direction = random.choice(candidates)\n","exit_code":0,"status":"completed"}}
