tivity structuring element for dilation\n148: _STRUCT8 = generate_binary_structure(2, 2)\n149: \n150: \n151: # ---------- legend helpers ----------\n152: \n153: def _legend_span(hole_count: int) -> int:\n154:     \"\"\"Width (or height) of a single legend patch along the arrangement axis.\"\"\"\n155:     return 3 if hole_count == 0 else 2 * hole_count + 1\n156: \n157: \n158: def _legend_patch(hole_count: int, color: int, arrangement: str) -> np.ndarray:\n159:     \"\"\"Build a 3xSpan (horizontal) or Spanx3 (vertical) legend patch.\"\"\"\n160:     span = _legend_span(hole_count)\n161:     if arrangement == \"horizontal\":\n162:         patch = np.full((3, span), int(color), dtype=int)\n163:         if hole_count:\n164:             patch[1, 1::2] = BG\n165:     else:\n166:         patch = np.full((span, 3), int(color), dtype=int)\n167:         if hole_count:\n168:             patch[1::2, 1] = BG\n169:     return patch\n170: \n171: \n172: def _line_span(legends: list[tuple[int, int]]) -> int:\n173:     \"\"\"Total span of legend patches plus 1-cell gaps between them.\"\"\"\n174:     return sum(_legend_span(h) for h, _ in legends) + len(legends) - 1\n175: \n176: \n177: def _choose_legends(arrangement: str, max_span: int) -> list[tuple[int, int]]:\n178:     \"\"\"Pick 2-4 legends with distinct hole counts that fit within max_span.\"\"\"\n179:     count = random.randint(*LEGEND_COUNT_RANGE)\n180:     combos = [holes for holes in itertools.combinations(range(MAX_HOLE_COUNT), count)\n181:               if sum(_legend_span(h) for h in holes) + count - 1 <= max_span]\n182:     if not combos:\n183:         return _choose_legends(arrangement, max_span + 2)\n184:     holes = list(random.choice(combos))\n185:     random.shuffle(holes)\n186:     colors = random.sample(LEGEND_COLORS, count)\n187:     return list(zip(holes, colors))\n\n-- 600: def generate_input() -> np.ndarray:\n600: def generate_input() -> np.ndarray:\n601:     for _ in range(GEN_RETRIES):\n602:         try:\n603: