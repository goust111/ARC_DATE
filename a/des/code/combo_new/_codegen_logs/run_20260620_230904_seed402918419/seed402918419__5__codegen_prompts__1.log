{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/train/a09f6c25.py /home/lixinyu/snap/new/ARC_code/train/412b6263.py /home/lixinyu/snap/new/ARC_code/eval/21897d95.py /home/lixinyu/snap/new/ARC_code/eval/a25697e4.py; do echo \"===== $f\"; main_line=$(rg -n '\"'\"'^def main'\"' \\\"\"'$f\" | cut -d: -f1); gen_line=$(rg -n '\"'\"'^def generate_input'\"' \\\"\"'$f\" | cut -d: -f1); awk -v s=\"$main_line\" '\"'NR>=s && /\"'^def / && NR>s {exit} NR>=s'\"' \\\"\"'$f\" | sed -n '\"'1,220p'; echo; awk -v s=\\\"\"'$gen_line\" '\"'NR>=s && /\"'^def / && NR>s {exit} NR>=s'\"' \\\"\"'$f\" | sed -n '\"'1,220p'; echo; done\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/train/a09f6c25.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor each non-singleton red object by its symmetry axis and erase isolated red pixels.\n\n    Input structure:\n    - The grid has one dominant background color and red 4-connected foreground objects.\n    - Every non-singleton red object has exactly one reflection symmetry category:\n      horizontal, vertical, or diagonal.\n    - Single red pixels are noise.\n\n    Rule:\n    - Start from an all-background output of the same shape.\n    - Recolor horizontally symmetric red objects blue, vertically symmetric objects\n      green, and diagonally symmetric objects pink.\n    - Leave isolated red pixels as background.\n\n    Key insight: The target color is not tied to object position or size; it is a\n    label for the object's reflection symmetry.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g)))\n    assert colors - {int(bg)} == {2}, \"expected red as the only foreground color\"\n\n    out = np.full_like(g, int(bg))\n    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[2])\n    assert objects, \"expected at least one red object\"\n    assert sum(int(obj[\"area\"]) for obj in objects) == int((g == 2).sum())\n\n    for obj in objects:\n        coords = obj[\"coords\"]\n        assert int(obj[\"color\"]) == 2\n        if int(obj[\"area\"]) == 1:\n            continue\n\n        color = _symmetry_color(_component_mask(coords, obj[\"bbox\"]))\n        out[coords[:, 0], coords[:, 1]] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\nGRID_ROWS = (17, 28)\nGRID_COLS = (19, 27)\nBACKGROUND_COLORS = [0, 4, 5, 7, 8, 9]\nFOREGROUND_COLOR = 2\nOUTPUT_COLOR_BY_KIND = {\"H\": 1, \"V\": 3, \"D\": 6}\n\n# Object count and size constraints.\nOBJECT_COUNT_RANGE = (3, 7)\nH_COUNT_OPTIONS = (2, 3)\nV_COUNT_OPTIONS = (1, 2)\nD_COUNT_OPTIONS = (0, 1, 2)\nAREA_MIN = 6\nAREA_MAX = 28\nAREA_MIN_NUM = 2\nAREA_MIN_DEN = 5\nAREA_MAX_PERCENT = 73\nAREA_PERCENT_DEN = 100\n\n# Symmetric mask dimensions and growth retries.\nHV_HEIGHT_RANGE = range(3, 11)\nHV_WIDTH_RANGE = range(3, 12)\nD_SIZE_RANGE = range(4, 9)\nMASK_RETRIES = 30\n\n# Placement, noise, and generator retries.\nMULTI_MIN_L1 = 4\nSINGLETON_COUNT_RANGE = (3, 9)\nSINGLETON_MIN_L1_TO_MULTI = 3\nSINGLETON_MIN_L1_TO_SINGLETON = 2\nGENERATION_RETRIES = 300\n\n\n\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid a09f6c25 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/412b6263.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Infer the background, rotate the whole input 90 degrees counterclockwise, and stack two framed copies vertically.\n\n    Input structure:\n    - Blue is absent from the input.\n    - One rare marker color appears in exactly two pixels.\n    - The background is the unique non-marker color whose removal leaves exactly two 4-connected foreground objects, each with one marker pixel and one body color.\n    - The whole grid, including background and foreground objects, is the sprite to transform.\n\n    Rule:\n    - Rotate the entire input grid 90 degrees counterclockwise.\n    - Create a blue one-pixel frame around two vertical copies of the rotated grid.\n    - Use the input background color for the two endpoints of every horizontal frame/separator row.\n\n    Key insight: The output is not a crop of the foreground objects; it is two copies of the complete rotated input, separated and enclosed by a newly added blue border.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg, objects = _infer_background_and_objects(g)\n    assert bg != Color.BLUE\n    assert Color.BLUE not in set(map(int, g.ravel()))\n\n    copies = len(objects)\n\n    tile = np.rot90(g, 1)\n    tile_h, tile_w = map(int, tile.shape)\n\n    out_h = copies * tile_h + copies + 1\n    out_w = tile_w + 2\n    out = np.full((out_h, out_w), Color.BLUE, dtype=int)\n\n    for i in range(copies):\n        row = i * (tile_h + 1)\n        out[row, 0] = bg\n        out[row, -1] = bg\n        paste(out, tile, row + 1, 1)\n\n    out[-1, 0] = bg\n    out[-1, -1] = bg\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n# CFG: ranges use numpy's high-exclusive convention where applicable.\nCANVAS_SHAPE_RANGES = ((5, 10), (5, 11))\nOBJECT_SHAPE_RANGES = ((2, 5), (2, 5))\nMIN_SEPARATION_GAP = 1\nMAX_OUTPUT_SIZE = 30\nINPUT_COLORS = [0, 2, 3, 4, 5, 6, 7, 8, 9]\nPALETTE_SIZE = 3\nFRAME_COLOR = Color.BLUE\nOUTPUT_TILE_COPIES = 2\nFRAME_THICKNESS = 1\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/21897d95.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.\n\n    Input structure:\n    - The grid is a mosaic of monochrome regions.\n    - Color 1 forms T-shaped control markers on region boundaries.\n    - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.\n    - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.\n\n    Rule:\n    - For a color-1 T marker, the single stem points at the destination region to repaint.\n    - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.\n    - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.\n    - All marker cells are filled with the final color of the source-side region.\n    - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.\n\n    Key insight:\n    - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = _solve_unrotated(g)\n    l9 = _find_l9_orientation(g)\n    if l9 == 'top_right':\n        return np.rot90(out, 1)\n    if l9 == 'top_left':\n        return np.rot90(out, 3)\n    return out\n\n# --------------- generator (l9rot) ---------------\n\n# ── Tunable constants ──────────────────────────────────────────────────\n# Canvas / region sizing\nGRID_SIZE_MAX = 30                          # max rows or cols\nMIN_REGION_CELLS = 6                        # per-spec minimum\nREGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)\nREGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts\nREGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS\n\n# Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)\nMARKER_MIN = 4\nMARKER_MAX = 8\nNORMAL_MAX = 6\nCOLORED_MAX = 2\n\n# Color pool (all ARC colors except 1, which is reserved for T-marker cells)\nCOLOR_POOL = [c for c in range(10) if c != 1]\n\n# L9 rotation marker\nL9_PROBABILITY = 0.5                        # chance of placing a rotation marker\nL9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation\n    'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],\n    'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],\n}\n\n# Generation retry budget\nSEED_ATTEMPTS = 200                         # tries to place n distinct region seeds\nGEN_RETRIES = 300                           # outer generate_input retry budget\n\n_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n# ── Small geometry helpers ─────────────────────────────────────────────\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/a25697e4.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Dock movable tools into border-anchored frames by filling cavities.\n\n    Input structure:\n    - bg = most common color.\n    - Border-touching components cluster into anchor frames with interior bg cavities.\n    - Non-border 2-color components are movable tools.\n\n    Rule:\n    - Match each tool to a frame whose cavity size equals one of its color-region counts.\n    - Rotate/flip the tool so one color fills the cavity exactly; the other stays outside.\n    - If the docking orientation uses a reflection, swap the tool's two colors.\n\n    Key insight: Cavity size determines tool–frame pairing; reflection triggers color swap.\n    \"\"\"\n    inp = grid\n    g = inp.copy()\n    bg = get_bg(g)\n    H, W = g.shape\n\n    def bbox_gap(a, b) -> int:\n        (ar0, ac0, ar1, ac1) = a\n        (br0, bc0, br1, bc1) = b\n        def gap1(x0, x1, y0, y1):\n            if y1 < x0:\n                return int(x0 - y1)\n            if x1 < y0:\n                return int(y0 - x1)\n            return 0\n        return gap1(ar0, ar1, br0, br1) + gap1(ac0, ac1, bc0, bc1)\n\n    fg = g != int(bg)\n    lab, n = label(fg, structure=STRUCT4)\n    fixed_mask = np.zeros((H, W), dtype=bool)\n    fixed_components = []\n    for cid in range(1, n + 1):\n        pts = np.argwhere(lab == cid)\n        pts_list = [(int(r), int(c)) for r, c in pts]\n        touches = any(r == 0 or r == H - 1 or c == 0 or c == W - 1 for r, c in pts_list)\n        if not touches:\n            continue\n        fixed_components.append({\"pts\": pts_list, \"bbox\": (int(pts[:,0].min()), int(pts[:,1].min()), int(pts[:,0].max()), int(pts[:,1].max()))})\n        for r, c in pts_list:\n            fixed_mask[r, c] = True\n\n    assert not (not fixed_components)\n\n    # Cluster fixed components into anchor frames.\n    parent = list(range(len(fixed_components)))\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(a, b):\n        ra, rb = find(a), find(b)\n        if ra != rb:\n            parent[rb] = ra\n\n    for i in range(len(fixed_components)):\n        for j in range(i + 1, len(fixed_components)):\n            if bbox_gap(fixed_components[i][\"bbox\"], fixed_components[j][\"bbox\"]) <= 2:\n                union(i, j)\n\n    groups: dict[int, list[int]] = {}\n    for i in range(len(fixed_components)):\n        groups.setdefault(find(i), []).append(i)\n\n    anchor_groups = []\n    for idxs in groups.values():\n        pts = [p for i in idxs for p in fixed_components[i][\"pts\"]]\n        rs = [r for r, _c in pts]\n        cs = [c for _r, c in pts]\n        bbox = (min(rs), min(cs), max(rs), max(cs))\n        mask = np.zeros((H, W), dtype=bool)\n        for r, c in pts:\n            mask[r, c] = True\n        sock = np.zeros((H, W), dtype=bool)\n        for r in range(bbox[0], bbox[2] + 1):\n            for c in range(bbox[1], bbox[3] + 1):\n                if int(g[r, c]) != int(bg):\n                    continue\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    rr, cc = r + dr, c + dc\n                    if 0 <= rr < H and 0 <= cc < W and mask[rr, cc]:\n                        sock[r, c] = True\n                        break\n\n        # Cavity = largest bg component inside bbox that is adjacent to the anchor pixels.\n        cavity = np.zeros((H, W), dtype=bool)\n        sub_bg = (g[bbox[0] : bbox[2] + 1, bbox[1] : bbox[3] + 1] == int(bg))\n        sub_lab, sub_n = label(sub_bg, structure=STRUCT4)\n        best_c = None  # (area, cid)\n        for cid in range(1, sub_n + 1):\n            ptsc = np.argwhere(sub_lab == cid)\n            area = int(len(ptsc))\n            # check adjacency to anchor within bbox\n            adj = False\n            for rr, cc in ptsc:\n                r = int(bbox[0] + rr)\n                c = int(bbox[1] + cc)\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    r2, c2 = r + dr, c + dc\n                    if bbox[0] <= r2 <= bbox[2] and bbox[1] <= c2 <= bbox[3] and mask[r2, c2]:\n                        adj = True\n                        break\n                if adj:\n                    break\n            if not adj:\n                continue\n            cand = (area, -cid)\n            if best_c is None or cand > best_c:\n                best_c = cand\n                best_id = cid\n        if best_c is not None:\n            ptsc = np.argwhere(sub_lab == best_id)\n            for rr, cc in ptsc:\n                cavity[int(bbox[0] + rr), int(bbox[1] + cc)] = True\n        cav_bbox = None\n        if cavity.any():\n            ptsc2 = np.argwhere(cavity)\n            r0c, c0c = ptsc2.min(axis=0)\n            r1c, c1c = ptsc2.max(axis=0)\n            cav_bbox = (int(r0c), int(c0c), int(r1c), int(c1c))\n\n        # swap rule for this anchor group: look for a color that appears in >=2 fixed sub-components\n        # (within the group) with different sizes and larger-above-smaller.\n        swap_needed = False\n        for col in sorted({int(x) for x in np.unique(g[mask])} - {int(bg)}):\n            sub = (g == int(col)) & mask\n            labc, nc = label(sub, structure=STRUCT4)\n            if nc < 2:\n                continue\n            comps = []\n            for cid in range(1, nc + 1):\n                ptsc = np.argwhere(labc == cid)\n                comps.append((int(len(ptsc)), float(ptsc[:, 0].mean()), float(ptsc[:, 1].mean())))\n            comps.sort(reverse=True)\n            (s0, r0, _c0), (s1, r1, _c1) = comps[0], comps[1]\n            # Swap only when the larger component is vertically above the smaller one.\n            if s0 != s1 and r0 < r1:\n                swap_needed = True\n                break\n\n        # Dominant open direction: which side has the most bg neighbors.\n        dir_list = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # U,D,L,R\n        dir_counts = [0, 0, 0, 0]\n        for r, c in pts:\n            for di, (dr, dc) in enumerate(dir_list):\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(bg):\n                    dir_counts[di] += 1\n        open_dir = dir_list[int(np.argmax(dir_counts))]\n        _labg, _ng = label(mask, structure=STRUCT4)\n        single_piece = int(_ng) == 1\n        cavity_size = int(cavity.sum())\n\n        anchor_groups.append(\n            {\n                \"mask\": mask,\n                \"bbox\": bbox,\n                \"socket_mask\": sock,\n                \"cavity_mask\": cavity,\n                \"cavity_bbox\": cav_bbox,\n                \"open_dir\": open_dir,\n                \"swap_needed\": swap_needed,\n                \"single_piece\": single_piece,\n                \"cavity_size\": cavity_size,\n                \"size\": int(mask.sum()),\n            }\n        )\n    anchor_groups.sort(key=lambda d: -d[\"size\"])\n\n    # Movable multi-color components are the remaining foreground pixels.\n    mov_mask = fg & (~fixed_mask)\n    mov_lab, mov_n = label(mov_mask, structure=STRUCT4)\n    mov_comps = []\n    for cid in range(1, mov_n + 1):\n        pts = np.argwhere(mov_lab == cid)\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        m = mov_lab[r0 : r1 + 1, c0 : c1 + 1] == cid\n        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        patch[~m] = 0\n        mov_comps.append({\"bbox\": (int(r0), int(c0), int(r1), int(c1)), \"mask\": m, \"patch\": patch, \"size\": int(len(pts))})\n    mov_comps.sort(key=lambda d: -d[\"size\"])\n\n    def choose_group(bbox) -> int:\n        best_i = 0\n        best_d = None\n        for i, grp in enumerate(anchor_groups):\n            d = bbox_gap(bbox, grp[\"bbox\"])\n            if best_d is None or d < best_d:\n                best_d = d\n                best_i = i\n        return int(best_i)\n\n    def gen_variants(patch: np.ndarray, mask: np.ndarray):\n        \"\"\"All unique dihedral variants, with a reflection flag.\"\"\"\n        base: list[tuple[np.ndarray, np.ndarray, bool]] = []\n        for k in range(4):\n            p = np.rot90(patch, k)\n            m = np.rot90(mask, k)\n            base.append((p, m, False))\n            base.append((np.fliplr(p), np.fliplr(m), True))\n        uniq: list[tuple[np.ndarray, np.ndarray, bool]] = []\n        seen = set()\n        for p, m, is_flip in base:\n            key = (m.tobytes(), p[m].tobytes())\n            if key in seen:\n                continue\n            seen.add(key)\n            uniq.append((p, m, is_flip))\n        return uniq\n\n    out = np.full_like(g, int(bg))\n    out[fixed_mask] = g[fixed_mask]\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPT_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input after %d attempts\" % GEN_ATTEMPT_RETRIES)\n\n","exit_code":0,"status":"completed"}}
