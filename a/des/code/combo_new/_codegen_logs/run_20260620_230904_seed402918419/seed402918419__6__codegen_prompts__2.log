{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/f8f52ecc.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, find_components, get_bg\nimport random\n\nCoord = tuple[int, int]\n\n\ndef _path_cells(start: Coord, stop: Coord, first_axis: str) -> list[Coord]:\n    r0, c0 = start\n    r1, c1 = stop\n    pts: list[Coord] = []\n\n    if first_axis == \"h\":\n        c_step = 1 if c1 >= c0 else -1\n        for c in range(c0, c1 + c_step, c_step):\n            pts.append((r0, c))\n        r_step = 1 if r1 >= r0 else -1\n        for r in range(r0 + r_step, r1 + r_step, r_step):\n            pts.append((r, c1))\n        return pts\n\n    assert first_axis == \"v\", \"path axis must be horizontal or vertical\"\n    r_step = 1 if r1 >= r0 else -1\n    for r in range(r0, r1 + r_step, r_step):\n        pts.append((r, c0))\n    c_step = 1 if c1 >= c0 else -1\n    for c in range(c0 + c_step, c1 + c_step, c_step):\n        pts.append((r1, c))\n    return pts\n\n\ndef _last_axis(start: Coord, stop: Coord, first_axis: str) -> str:\n    dr = abs(start[0] - stop[0])\n    dc = abs(start[1] - stop[1])\n    if first_axis == \"h\":\n        return \"v\" if dr else \"h\"\n    assert first_axis == \"v\", \"path axis must be horizontal or vertical\"\n    return \"h\" if dc else \"v\"\n\n\ndef _axis_priority(start: Coord, stop: Coord, previous_axis: str | None) -> list[str]:\n    dr = abs(start[0] - stop[0])\n    dc = abs(start[1] - stop[1])\n    assert dr + dc > 0, \"components must be distinct\"\n\n    orders: list[str] = []\n    if previous_axis == \"h\" and dc:\n        orders.append(\"h\")\n    if previous_axis == \"v\" and dr:\n        orders.append(\"v\")\n\n    preferred = \"h\" if dc >= dr else \"v\"\n    if preferred not in orders:\n        orders.append(preferred)\n    other = \"v\" if preferred == \"h\" else \"h\"\n    if other not in orders:\n        orders.append(other)\n    return orders\n\n\ndef _clear(path: list[Coord], canvas: np.ndarray, bg: int, color: int) -> bool:\n    return all(int(canvas[r, c]) in (bg, color) for r, c in path)\n\n\ndef _connector_path(\n    comp_a: np.ndarray,\n    comp_b: np.ndarray,\n    canvas: np.ndarray,\n    bg: int,\n    color: int,\n    previous_axis: str | None,\n) -> tuple[list[Coord], str]:\n    pairs: list[tuple[int, int, int, int, int]] = []\n    for a_raw in comp_a:\n        ar, ac = map(int, a_raw)\n        for b_raw in comp_b:\n            br, bc = map(int, b_raw)\n            pairs.append((abs(ar - br) + abs(ac - bc), ar, ac, br, bc))\n\n    pairs.sort()\n    for _dist, ar, ac, br, bc in pairs:\n        start = (ar, ac)\n        stop = (br, bc)\n        for first_axis in _axis_priority(start, stop, previous_axis):\n            path = _path_cells(start, stop, first_axis)\n            if _clear(path, canvas, bg, color):\n                return path, _last_axis(start, stop, first_axis)\n\n    raise AssertionError(f\"expected an unobstructed one-bend connector for color {color}\")\n\n\ndef _source_colors(g: np.ndarray, bg: int, wall: int) -> list[int]:\n    colors: list[int] = []\n    seen = {int(bg), int(wall)}\n    for raw in g.ravel():\n        color = int(raw)\n        if color not in seen:\n            seen.add(color)\n            colors.append(color)\n    return colors\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect same-colored foreground components with one-cell-wide orthogonal paths around teal wall segments.\n\n    Input structure\n    - The dominant color is the background.\n    - Teal cells are fixed wall segments and are never source connectors.\n    - Other foreground colors appear as one or more 4-connected components; colors with a single component stay unchanged.\n\n    Rule\n    - For each non-background, non-teal color, read its 4-connected components in row-major order.\n    - Connect each consecutive pair by the shortest clear L-shaped path between the two components.\n    - Clear paths may pass only through background or the same color, and they preserve the previous travel axis when both bends are possible.\n\n    Key insight\n    - The output is not a global recolor: each color traces a routed chain through its own components while teal cells and other colors act as blockers.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    wall = Color.TEAL\n    assert np.any(g == wall), \"expected teal wall cells\"\n\n    out = g.copy()\n    connected_color_count = 0\n    for color in _source_colors(g, bg, wall):\n        comps = [\n            comp[\"coords\"]\n            for comp in find_components(\n                g,\n                bg=bg,\n                connectivity=4,\n                monochromatic=True,\n                colors=[color],\n            )\n        ]\n        comps.sort(key=lambda coords: tuple(map(int, coords.min(axis=0))))\n        if len(comps) < 2:\n            continue\n        if len(comps) == 2 and len(comps[0]) == 1 and len(comps[1]) == 1:\n            a = tuple(map(int, comps[0][0]))\n            b = tuple(map(int, comps[1][0]))\n            if a[0] != b[0] and a[1] != b[1]:\n                h_clear = _clear(_path_cells(a, b, \"h\"), g, bg, color)\n                v_clear = _clear(_path_cells(a, b, \"v\"), g, bg, color)\n                assert not (h_clear and v_clear), \"two diagonal singleton components need a blocking obstacle\"\n\n        connected_color_count += 1\n        previous_axis: str | None = None\n        for comp_a, comp_b in zip(comps, comps[1:]):\n            path, previous_axis = _connector_path(comp_a, comp_b, out, bg, color, previous_axis)\n            for r, c in path:\n                assert int(out[r, c]) in (bg, color), \"connector collision with another color\"\n                out[r, c] = color\n\n    assert connected_color_count > 0, \"expected at least one color with multiple components\"\n    return out\n\n# --------------- generator (c) ---------------\n\nBG = Color.BLUE\nWALL = Color.TEAL\n\n# Palette.\nN_COLORS = 10\nALL_COLORS = [c for c in range(N_COLORS) if c not in (BG, WALL)]\n\n# Canvas sizing.\nMIN_ROWS = 8\nMAX_ROWS = 12\nMIN_COLS = 10\nMAX_COLS = 12\nLARGE_GRID_CONNECTABLE_THRESHOLD = 3\nLARGE_GRID_MIN_ROWS = 10\nLARGE_GRID_MIN_COLS = 11\n\n# Foreground object counts and component sizes.\nMIN_CONNECTABLE_COLORS = 1\nMAX_CONNECTABLE_COLORS = 4\nMIN_DISTRACTOR_COLORS = 0\nMAX_DISTRACTOR_COLORS = 4\nMIN_CHAIN_COMPONENTS = 2\nMAX_CHAIN_COMPONENTS = 4\nBLOB_SIZE_CHOICES = [1, 2, 3]\nBLOB_SIZE_WEIGHTS = [6, 3, 1]\n\n# Wall geometry.\nMIN_WALL_SEGMENTS = 1\nMAX_WALL_SEGMENTS = 2\nWALL_ROW_BORDER = 1\nWALL_ROW_GAP = 1\nMIN_WALL_LENGTH = 1\nMAX_WALL_LENGTH = 8\n\n# Validation and retry limits.\nBLOB_PLACEMENT_ATTEMPTS = 80\nDISTRACTOR_PLACEMENT_ATTEMPTS = 50\nGENERATION_ATTEMPTS = 300\nMAX_PATH_CELLS = 25\nMIN_BG_PCT = 79\nMAX_BG_PCT = 90\n\nAXES = (\"h\", \"v\")\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nConnectorOption = tuple[str, list[Coord], Coord, Coord]\n\n\ndef _gen_source_colors(g: np.ndarray, bg: int, wall: int) -> list[int]:\n    colors: list[int] = []\n    seen = {int(bg), int(wall)}\n    for raw in g.ravel():\n        color = int(raw)\n        if color not in seen:\n            seen.add(color)\n            colors.append(color)\n    return colors\n\n\ndef _gen_path_has_marker(\n    output: np.ndarray,\n    color: int,\n    path: list[Coord],\n    start: Coord,\n    stop: Coord,\n) -> bool:\n    endpoints = {start, stop}\n    return any((r, c) not in endpoints and int(output[r, c]) == color for r, c in path)\n\n\ndef _gen_path_cells(start: Coord, stop: Coord, first_axis: str) -> list[Coord]:\n    r0, c0 = start\n    r1, c1 = stop\n    pts: list[Coord] = []\n\n    if first_axis == \"h\":\n        c_step = 1 if c1 >= c0 else -1\n        for c in range(c0, c1 + c_step, c_step):\n            pts.append((r0, c))\n        r_step = 1 if r1 >= r0 else -1\n        for r in range(r0 + r_step, r1 + r_step, r_step):\n            pts.append((r, c1))\n        return pts\n\n    r_step = 1 if r1 >= r0 else -1\n    for r in range(r0, r1 + r_step, r_step):\n        pts.append((r, c0))\n    c_step = 1 if c1 >= c0 else -1\n    for c in range(c0 + c_step, c1 + c_step, c_step):\n        pts.append((r1, c))\n    return pts\n\n\ndef _gen_last_axis(start: Coord, stop: Coord, first_axis: str) -> str:\n    dr = abs(start[0] - stop[0])\n    dc = abs(start[1] - stop[1])\n    if first_axis == \"h\":\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/b2bc3ffd.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg, paste\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Move every object above the solid bottom stripe upward by its own pixel count.\n\n    Input structure\n    The grid has a dominant background, exactly one full-width non-background row\n    that acts as a fixed stripe, and one or more 4-connected monochrome objects\n    above that stripe.\n\n    Rule\n    Clear each object from its original cells, then translate it straight upward\n    by the number of pixels in that object, preserving its shape and color. Leave\n    the full-width stripe unchanged.\n\n    Key insight\n    Each object's area is also its vertical displacement; the full-width row is a\n    fixed baseline, not a moving object.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    stripe_rows = [\n        r\n        for r in range(h)\n        if np.unique(g[r]).size == 1 and int(g[r, 0]) != bg\n    ]\n    assert len(stripe_rows) == 1\n    stripe_row = stripe_rows[0]\n    assert stripe_row == h - 1\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    stripe_components = []\n    moving_objects = []\n    for component in components:\n        coords = component[\"coords\"]\n        is_stripe = int(component[\"area\"]) == w and np.all(coords[:, 0] == stripe_row)\n        if is_stripe:\n            stripe_components.append(component)\n        else:\n            assert np.all(coords[:, 0] < stripe_row)\n            moving_objects.append(component)\n\n    assert len(stripe_components) == 1\n    assert moving_objects\n\n    out = g.copy()\n    for component in moving_objects:\n        coords = component[\"coords\"]\n        out[coords[:, 0], coords[:, 1]] = bg\n\n    occupied = np.zeros(g.shape, dtype=bool)\n    occupied[stripe_row, :] = True\n\n    for component in moving_objects:\n        coords = component[\"coords\"]\n        target = coords.copy()\n        target[:, 0] -= int(component[\"area\"])\n\n        assert np.all(target[:, 0] >= 0)\n        assert not np.any(occupied[target[:, 0], target[:, 1]])\n\n        occupied[target[:, 0], target[:, 1]] = True\n        out[target[:, 0], target[:, 1]] = int(component[\"color\"])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# CFG: canvas/colors, counts/spacing, shape/motion, biased sampling, retries.\n_GEN_GRID_SIZE = 8\n_GEN_BG = 7\n_GEN_STRIPE = 8\n_GEN_COLORS = [1, 2, 3, 4, 5, 6, 9]\n\n_GEN_OBJECT_COUNTS = [2, 3, 4]\n_GEN_MIN_INTER_OBJECT_GAP = 1\n\n_GEN_MAX_HEIGHT = 3\n_GEN_MAX_AREA = 6\n_GEN_SUPPORT_ROW_OFFSET = 2\n\n_GEN_TWO_OBJECT_WIDE_SPAN_PROB = 0.7\n_GEN_WIDE_WIDTH_CHOICES = (6, 5)\n_GEN_WIDEST_WIDTH_PROB = 0.55\n_GEN_SPAN6_AREA6_PROB = 0.75\n_GEN_SPAN5_AREA5_PROB = 0.65\n\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_partition_spans(n):\n    available = _GEN_GRID_SIZE - _GEN_MIN_INTER_OBJECT_GAP * (n - 1)\n    if n == 2 and random.random() < _GEN_TWO_OBJECT_WIDE_SPAN_PROB:\n        wide = _GEN_WIDE_WIDTH_CHOICES[0] if random.random() < _GEN_WIDEST_WIDTH_PROB else _GEN_WIDE_WIDTH_CHOICES[1]\n        widths = [wide, available - wide]\n        random.shuffle(widths)\n    else:\n        total = random.randint(n, available)\n        widths = [1] * n\n        for _ in range(total - n):\n            widths[random.randrange(n)] += 1\n        random.shuffle(widths)\n\n    extra = _GEN_GRID_SIZE - sum(widths) - _GEN_MIN_INTER_OBJECT_GAP * (n - 1)\n    gap_extra = [0] * (n + 1)\n    for _ in range(extra):\n        gap_extra[random.randrange(n + 1)] += 1\n\n    spans = []\n    c = gap_extra[0]\n    for i, width in enumerate(widths):\n        spans.append((c, c + width - 1))\n        c += width\n        if i < n - 1:\n            c += _GEN_MIN_INTER_OBJECT_GAP + gap_extra[i + 1]\n    return spans\n\n\ndef _gen_shape_params(span_width):\n    pairs = [\n        (area, height)\n        for height in range(1, _GEN_MAX_HEIGHT + 1)\n        for area in range(1, _GEN_MAX_AREA + 1)\n        if height <= area\n        and area + height <= _GEN_GRID_SIZE - 1\n        and area <= height * span_width\n    ]\n    areas = sorted({area for area, _ in pairs})\n    if span_width >= 6 and random.random() < _GEN_SPAN6_AREA6_PROB:\n        area = 6\n    elif span_width >= 5 and random.random() < _GEN_SPAN5_AREA5_PROB:\n        area = 5\n    else:\n        area = random.choice(areas)\n    heights = [height for cand_area, height in pairs if cand_area == area]\n    return area, random.choice(heights)\n\n\ndef _gen_connected_mask(area, height, width):\n    backbone_col = random.randrange(width)\n    cells = {(r, backbone_col) for r in range(height)}\n    while len(cells) < area:\n        frontier = set()\n        for r, c in cells:\n            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):\n                if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in cells:\n                    frontier.add((nr, nc))\n        cells.add(random.choice(tuple(frontier)))\n\n    mask = np.zeros((height, width), dtype=bool)\n    for r, c in cells:\n        mask[r, c] = True\n    return mask\n\n\ndef _gen_paste_shape(grid, mask, top, left, color):\n    patch = np.full(mask.shape, _GEN_BG, dtype=int)\n    patch[mask] = color\n    paste(grid, patch, top, left, transparent=_GEN_BG)\n\n\ndef _gen_build_objects(n_objects):\n    spans = _gen_partition_spans(n_objects)\n    colors = random.sample(_GEN_COLORS, n_objects)\n    objects = []\n    for color, (c0, c1) in zip(colors, spans):\n        span_width = c1 - c0 + 1\n        area, height = _gen_shape_params(span_width)\n        mask = _gen_connected_mask(area, height, span_width)\n        bottom = _GEN_GRID_SIZE - _GEN_SUPPORT_ROW_OFFSET - area\n        top = bottom - height + 1\n        if top < 0:\n            return None\n        objects.append((mask, top, c0, area, color))\n    return objects\n\n\ndef _gen_render(objects, shift_down=0):\n    grid = np.full((_GEN_GRID_SIZE, _GEN_GRID_SIZE), _GEN_BG, dtype=int)\n    grid[-1, :] = _GEN_STRIPE\n    for mask, top, c0, area, color in objects:\n        _gen_paste_shape(grid, mask, top + shift_down * area, c0, color)\n    return grid\n\n\ndef _gen_attempt():\n    n_objects = random.choice(_GEN_OBJECT_COUNTS)\n    objects = _gen_build_objects(n_objects)\n    if objects is None:\n        return None\n\n    out = _gen_render(objects)\n    inp = _gen_render(objects, shift_down=1)\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input():\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid b2bc3ffd input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/1190bc91.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import deque\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\nDIAG_DIRS = ((-1, -1), (-1, 1), (1, -1), (1, 1))\n\n\ndef _component_coords(comp: dict) -> list[tuple[int, int]]:\n    return [tuple(map(int, rc)) for rc in comp[\"coords\"]]\n\n\ndef _ordered_straight_run(coords: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    rows = {r for r, _c in coords}\n    cols = {c for _r, c in coords}\n    assert len(rows) == 1 or len(cols) == 1, \"foreground run must be horizontal or vertical\"\n\n    if len(rows) == 1:\n        row = next(iter(rows))\n        cs = sorted(c for _r, c in coords)\n        assert cs == list(range(cs[0], cs[-1] + 1)), \"horizontal run must be contiguous\"\n        return [(row, c) for c in cs]\n\n    col = next(iter(cols))\n    rs = sorted(r for r, _c in coords)\n    assert rs == list(range(rs[0], rs[-1] + 1)), \"vertical run must be contiguous\"\n    return [(r, col) for r in rs]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a sparse grid by casting occluding diagonal rays from the longest run and filling the remaining diagonal-connected regions from the short bars.\n\n    Input structure\n    - Black-background grid with one unique longest 4-connected foreground object.\n    - The longest object is a horizontal or vertical multicolor run; all other foreground objects are shorter monochrome bars.\n\n    Rule\n    - On a blank canvas, process the longest run from left to right or top to bottom; each pixel emits four 45-degree rays that stop at the first already-painted pixel.\n    - Each remaining monochrome bar fills every still-blank pixel reachable from it by diagonal steps.\n\n    Key insight\n    - Earlier pixels in the long run occlude later diagonal rays, and those ray barriers partition the background into diagonal-connected regions for the short bars.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert len(comps) >= 2, \"expected a main run plus at least one short bar\"\n\n    max_area = max(int(comp[\"area\"]) for comp in comps)\n    main_candidates = [comp for comp in comps if int(comp[\"area\"]) == max_area]\n    assert len(main_candidates) == 1, \"main run must be the unique largest foreground object\"\n\n    main = main_candidates[0]\n    main_coords = _component_coords(main)\n    assert len({int(g[r, c]) for r, c in main_coords}) >= 2, \"main run must be multicolor\"\n    ordered_main = _ordered_straight_run(main_coords)\n\n    out = np.full_like(g, bg)\n    for r, c in ordered_main:\n        color = int(g[r, c])\n        assert color != bg\n        assert out[r, c] == bg, \"main source pixel unexpectedly already painted\"\n        out[r, c] = color\n        for dr, dc in DIAG_DIRS:\n            nr, nc = r + dr, c + dc\n            while 0 <= nr < H and 0 <= nc < W and out[nr, nc] == bg:\n                out[nr, nc] = color\n                nr += dr\n                nc += dc\n\n    main_set = set(main_coords)\n    base = out.copy()\n    fill_regions: list[tuple[int, set[tuple[int, int]]]] = []\n    for comp in comps:\n        coords = _component_coords(comp)\n        if set(coords) == main_set:\n            continue\n\n        ordered_bar = _ordered_straight_run(coords)\n        colors = {int(g[r, c]) for r, c in ordered_bar}\n        assert len(colors) == 1, \"short bar must be monochrome\"\n        color = next(iter(colors))\n        assert color != bg\n        assert all(base[r, c] == bg for r, c in ordered_bar), \"short bar overlaps main rays\"\n\n        seen = set(ordered_bar)\n        q = deque(ordered_bar)\n        while q:\n            r, c = q.popleft()\n            for dr, dc in DIAG_DIRS:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < H and 0 <= nc < W and base[nr, nc] == bg and (nr, nc) not in seen:\n                    seen.add((nr, nc))\n                    q.append((nr, nc))\n        fill_regions.append((color, seen))\n\n    claimed: set[tuple[int, int]] = set()\n    for color, region in fill_regions:\n        assert claimed.isdisjoint(region), \"short-bar diagonal regions must be disjoint\"\n        claimed.update(region)\n        for r, c in region:\n            out[r, c] = color\n\n    for r, c in np.argwhere(g != bg):\n        assert out[int(r), int(c)] == int(g[int(r), int(c)]), \"input foreground must be preserved\"\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- Configuration ---\nGRID_SIZE_MIN, GRID_SIZE_MAX = 4, 10\nRUN_LENGTH_MIN, RUN_LENGTH_MAX = 3, 7    # main run pixel count\nPOS_MARGIN = 1                            # perpendicular position inset from grid edges\nCOLOR_MIN, COLOR_MAX = 1, 9              # non-background color range (inclusive)\nMAX_RETRIES = 300                         # generate_input() retry budget\n\n_DIAG_DIRS = ((-1, -1), (-1, 1), (1, -1), (1, 1))\n_ORTH_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n# Edge definitions: (name, pair_generator) -- each yields adjacent cell pairs along one edge.\n_EDGE_DEFS = {\n    \"top\":    lambda n: (((0, c), (0, c + 1)) for c in range(n - 1)),\n    \"bottom\": lambda n: (((n - 1, c), (n - 1, c + 1)) for c in range(n - 1)),\n    \"left\":   lambda n: (((r, 0), (r + 1, 0)) for r in range(n - 1)),\n    \"right\":  lambda n: (((r, n - 1), (r + 1, n - 1)) for r in range(n - 1)),\n}\n\n\ndef _diag_flood(ray, seeds):\n    \"\"\"BFS all zero-cells in *ray* diag-reachable from *seeds*. Returns the visited set (includes seeds).\"\"\"\n    n = ray.shape[0]\n    seen = set(seeds)\n    q = deque(seeds)\n    while q:\n        r, c = q.popleft()\n        for dr, dc in _DIAG_DIRS:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < n and 0 <= nc < n and ray[nr, nc] == 0 and (nr, nc) not in seen:\n                seen.add((nr, nc))\n                q.append((nr, nc))\n    return seen\n\n\ndef _cast_main_rays(n, orientation, length, pos, colors):\n    \"\"\"Place the main run and cast 4 diagonal rays from each pixel (with occlusion). Returns (ray_grid, coords) or (None, None).\"\"\"\n    ray = np.zeros((n, n), dtype=int)\n    if orientation == \"H\":\n        coords = [(pos, c) for c in range(n - length, n)]\n    else:\n        coords = [(r, pos) for r in range(n - length, n)]\n\n    for (r, c), color in zip(coords, colors):\n        if ray[r, c] != 0:\n            return None, None\n        ray[r, c] = color\n        for dr, dc in _DIAG_DIRS:\n            nr, nc = r + dr, c + dc\n            while 0 <= nr < n and 0 <= nc < n and ray[nr, nc] == 0:\n                ray[nr, nc] = color\n                nr += dr\n                nc += dc\n    return ray, coords\n\n\ndef _diag_labels(ray):\n    \"\"\"Label each diagonal-connected zero-region in *ray* with a unique integer. Non-zero cells get -1.\"\"\"\n    n = ray.shape[0]\n    labels = np.full_like(ray, -1, dtype=int)\n    next_label = 0\n    for sr, sc in np.argwhere(ray == 0):\n        sr, sc = int(sr), int(sc)\n        if labels[sr, sc] >= 0:\n            continue\n        for cell in _diag_flood(ray, [(sr, sc)]):\n            labels[cell] = next_label\n        next_label += 1\n    return labels\n\n\ndef _touches(cells, blocked):\n    \"\"\"True if any cell in *cells* is orthogonally adjacent to a cell in *blocked*.\"\"\"\n    for r, c in cells:\n        for dr, dc in _ORTH_DIRS:\n            if (r + dr, c + dc) in blocked:\n                return True\n    return False\n\n\ndef _edge_pairs(ray, labels, excluded_edge, blocked):\n    \"\"\"Find valid size-2 bar placements along grid edges (excluding *excluded_edge* and cells adjacent to *blocked*).\"\"\"\n    n = ray.shape[0]\n    pairs = []\n    for edge_name, gen_fn in _EDGE_DEFS.items():\n        if edge_name == excluded_edge:\n            continue\n        for pair in gen_fn(n):\n            if all(ray[p] == 0 for p in pair) and not _touches(pair, blocked):\n                pairs.append((pair, frozenset(int(labels[p]) for p in pair)))\n    return pairs\n\n\ndef _choose_bars(ray, main_coords, orientation):\n    \"\"\"Select 1 or 2 compatible bar placements from grid edges.\"\"\"\n    excluded_edge = \"right\" if orientation == \"H\" else \"bottom\"\n    labels = _diag_labels(ray)\n    candidates = _edge_pairs(ray, labels, excluded_edge, set(main_coords))\n    if not candidates:\n        return None\n\n    compatible_twos = []\n    for i, (pair_a, labels_a) in enumerate(candidates):\n        for pair_b, labels_b in candidates[i + 1:]:\n            if labels_a & labels_b or _touches(pair_b, set(pair_a)):\n                continue\n            compatible_twos.append((pair_a, pair_b))\n\n    if compatible_twos and random.choice((1, 2)) == 2:\n        return list(random.choice(compatible_twos))\n    return [random.choice(candidates)[0]]\n\n\ndef _bar_regions_disjoint(ray, bars):\n    \"\"\"Check that the diagonal flood regions of all bars are mutually disjoint.\"\"\"\n    claimed = set()\n    for pair in bars:\n        region = _diag_flood(ray, list(pair))\n        if claimed & region:\n            return False\n        claimed.update(region)\n    return True\n\n\ndef _build_output(ray, bars, bar_colors):\n    \"\"\"Overlay each bar's diagonal flood region onto the ray grid.\"\"\"\n    out = ray.copy()\n    for pair, color in zip(bars, bar_colors):\n        for r, c in _diag_flood(ray, list(pair)):\n            out[r, c] = color\n    return out\n\n\ndef _gen_attempt():\n    n = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    orientation = random.choice((\"H\", \"V\"))\n    length = random.randint(RUN_LENGTH_MIN, min(n - 1, RUN_LENGTH_MAX))\n    pos = random.randint(POS_MARGIN, n - 1 - POS_MARGIN)\n\n    colors = random.sample(range(COLOR_MIN, COLOR_MAX + 1), length)\n    ray, main_coords = _cast_main_rays(n, orientation, length, pos, colors)\n    if ray is None:\n        return None\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/df978a02.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, is_contiguous\nimport random\n\n\ndef _central_background_cell(g: np.ndarray, bg: int, objects: list[dict]) -> tuple[int, int]:\n    candidates: list[tuple[int, int, int, int]] = []\n    height, width = g.shape\n    for r in range(height):\n        for c in range(width):\n            if int(g[r, c]) != bg:\n                continue\n\n            distances = []\n            for obj in objects:\n                coords = obj[\"coords\"]\n                d = np.abs(coords[:, 0] - r) + np.abs(coords[:, 1] - c)\n                distances.append(int(d.min()))\n            candidates.append((sum(distances), max(distances), r, c))\n\n    assert candidates, \"expected at least one background cell\"\n    candidates.sort()\n    assert len(candidates) == 1 or candidates[0][:2] < candidates[1][:2], \"expected a unique central gap\"\n    return int(candidates[0][2]), int(candidates[0][3])\n\n\ndef _inward_tip(obj: dict, center_r: int, center_c: int) -> tuple[int, int]:\n    coords = obj[\"coords\"]\n    distances = np.abs(coords[:, 0] - center_r) + np.abs(coords[:, 1] - center_c)\n    min_dist = int(distances.min())\n    tips = coords[distances == min_dist]\n    assert len(tips) == 1, \"expected each losing object to have one inward tip\"\n    return int(tips[0, 0]), int(tips[0, 1])\n\n\ndef _outward_cap(obj: dict, center_r: int, center_c: int) -> list[tuple[int, int]]:\n    r0, c0, r1, c1 = obj[\"bbox\"]\n    obj_center_r = (r0 + r1) / 2\n    obj_center_c = (c0 + c1) / 2\n    row_offset = obj_center_r - center_r\n    col_offset = obj_center_c - center_c\n\n    if abs(row_offset) > abs(col_offset):\n        assert row_offset != 0, \"winner must sit away from the center\"\n        r = int(r0 - 1 if row_offset < 0 else r1 + 1)\n        return [(r, center_c - 1), (r, center_c), (r, center_c + 1)]\n\n    assert abs(col_offset) > abs(row_offset), \"winner must have a cardinal outward direction\"\n    c = int(c0 - 1 if col_offset < 0 else c1 + 1)\n    return [(center_r - 1, c), (center_r, c), (center_r + 1, c)]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Let the largest center-pointing object grow outward while every other object loses its inward tip.\n\n    Input structure\n    - The grid has a single dominant background color and four 8-connected monochromatic foreground objects.\n    - The objects surround a central background gap and point toward it from cardinal directions.\n    - Exactly one object has the largest area.\n\n    Rule\n    - Find the central background gap by minimizing aggregate distance to the four objects.\n    - Recolor the nearest-to-center pixel of each non-largest object to background.\n    - Add a three-pixel cap in the largest object's color on the side away from the center, centered on the shared row or column.\n\n    Key insight\n    - The edit is a transfer of prominence around a common center: losers retract at their tips, and the unique largest object extends outward from the center.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    objects = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format=\"dict\")\n    assert len(objects) == 4, \"expected four colored objects around the center\"\n\n    center_r, center_c = _central_background_cell(g, bg, objects)\n\n    areas = [int(obj[\"area\"]) for obj in objects]\n    max_area = max(areas)\n    assert areas.count(max_area) == 1, \"expected a unique largest object\"\n    winner = objects[areas.index(max_area)]\n\n    out = g.copy()\n    for obj in objects:\n        if obj is winner:\n            continue\n        r, c = _inward_tip(obj, center_r, center_c)\n        out[r, c] = bg\n\n    for r, c in _outward_cap(winner, center_r, center_c):\n        assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1], \"outward cap must stay in bounds\"\n        assert int(g[r, c]) == bg, \"outward cap must be painted on background\"\n        out[r, c] = int(winner[\"color\"])\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# Canvas and palette.\nGRID_H, GRID_W = 16, 16\nGEN_BG = 8\nGEN_COLORS = [c for c in range(10) if c != GEN_BG]\n\n# Center, direction, and gap sampling.\nCENTER_MIN, CENTER_MAX = 5, 10\nDIRECTIONS = ['above', 'below', 'left', 'right']\nDIRECTION_STEPS = {'above': (-1, 0), 'below': (1, 0), 'left': (0, -1), 'right': (0, 1)}\nVERTICAL_DIRECTIONS = ('above', 'below')\nTIP_GAP_MIN, TIP_GAP_MAX = 1, 2\n\n# Object area and growth bounds.\nWINNER_AREA_MIN, WINNER_AREA_MAX = 8, 22\nLOSER_AREA_MIN = 3\nOBJECT_AREA_MIN, OBJECT_AREA_MAX = 3, 22\nMAX_GROWTH_LAYERS, MAX_HALF_WIDTH_STEP = 10, 2\n\n# Cap, spacing, and retry limits.\nCAP_OFFSETS = (-1, 0, 1)\nCAP_MARGIN, MIN_OBJECT_DISTANCE = 1, 2\nGEN_RETRY_LIMIT = 300\n\n\ndef _tip_coord(cr: int, cc: int, direction: str, tip_gap: int) -> tuple[int, int]:\n    step_r, step_c = DIRECTION_STEPS[direction]\n    return cr + step_r * tip_gap, cc + step_c * tip_gap\n\n\ndef _perp_coord(direction: str, base_r: int, base_c: int, off: int) -> tuple[int, int]:\n    if direction in VERTICAL_DIRECTIONS:\n        return base_r, base_c + off\n    return base_r + off, base_c\n\n\ndef _build_cardinal_object(cr: int, cc: int, direction: str, tip_gap: int,\n                           target_area: int, rng: random.Random) -> list[tuple[int, int]] | None:\n    tip = _tip_coord(cr, cc, direction, tip_gap)\n    step_r, step_c = DIRECTION_STEPS[direction]\n\n    coords = [tip]\n    remaining = target_area - 1\n    prev_hw = 0\n    layer = 0\n\n    while remaining > 0:\n        layer += 1\n        br = tip[0] + step_r * layer\n        bc = tip[1] + step_c * layer\n\n        min_hw = max(prev_hw, 1) if layer == 1 else max(prev_hw - 1, 0)\n        max_hw = prev_hw + MAX_HALF_WIDTH_STEP\n        feasible_hws = [hw for hw in range(min_hw, max_hw + 1) if 2 * hw + 1 <= remaining]\n        if not feasible_hws:\n            needed_hw = (remaining - 1) // 2\n            if needed_hw >= min_hw and remaining == 2 * needed_hw + 1:\n                feasible_hws = [needed_hw]\n            else:\n                break\n\n        hw = rng.choice(feasible_hws)\n        layer_pixels = [_perp_coord(direction, br, bc, off) for off in range(-hw, hw + 1)]\n        coords.extend(layer_pixels)\n        remaining -= len(layer_pixels)\n        prev_hw = hw\n\n        if layer > MAX_GROWTH_LAYERS:\n            break\n\n    if remaining > 0 and layer >= 1:\n        br = tip[0] + step_r * layer\n        bc = tip[1] + step_c * layer\n        for side in [1, -1]:\n            if remaining <= 0:\n                break\n            ext = prev_hw + 1\n            p = _perp_coord(direction, br, bc, side * ext)\n            coords.append(p)\n            remaining -= 1\n\n    return coords if len(coords) >= OBJECT_AREA_MIN else None\n\n\ndef _cap_coords(direction: str, cr: int, cc: int, obj_coords: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    rows = [r for r, c in obj_coords]\n    cols = [c for r, c in obj_coords]\n    if direction == 'above':\n        return [(min(rows) - 1, cc + d) for d in CAP_OFFSETS]\n    elif direction == 'below':\n        return [(max(rows) + 1, cc + d) for d in CAP_OFFSETS]\n    elif direction == 'left':\n        return [(cr + d, min(cols) - 1) for d in CAP_OFFSETS]\n    else:\n        return [(cr + d, max(cols) + 1) for d in CAP_OFFSETS]\n\n\ndef _min_manhattan(a: list[tuple[int, int]], b: list[tuple[int, int]]) -> int:\n    return min(abs(ra - rb) + abs(ca - cb) for ra, ca in a for rb, cb in b)\n\n\ndef _sample_parameters(rng: random.Random):\n    cr = rng.randint(CENTER_MIN, CENTER_MAX)\n    cc = rng.randint(CENTER_MIN, CENTER_MAX)\n\n    directions = list(DIRECTIONS)\n    rng.shuffle(directions)\n    winner_dir = directions[0]\n    loser_dirs = directions[1:]\n\n    colors = rng.sample(GEN_COLORS, 4)\n    winner_color, loser_colors = colors[0], colors[1:]\n\n    winner_gap = rng.randint(TIP_GAP_MIN, TIP_GAP_MAX)\n    loser_gaps = [rng.randint(TIP_GAP_MIN, TIP_GAP_MAX) for _ in range(3)]\n\n    winner_area = rng.randint(WINNER_AREA_MIN, WINNER_AREA_MAX)\n    loser_areas = [rng.randint(LOSER_AREA_MIN, winner_area - 1) for _ in range(3)]\n\n    return (\n        cr, cc, winner_dir, loser_dirs, winner_color, loser_colors,\n        winner_gap, loser_gaps, winner_area, loser_areas,\n    )\n\n\ndef _build_objects(cr: int, cc: int, winner_dir: str, loser_dirs: list[str], winner_gap: int,\n                   loser_gaps: list[int], winner_area: int, loser_areas: list[int], rng: random.Random):\n    winner_coords = _build_cardinal_object(cr, cc, winner_dir, winner_gap, winner_area, rng)\n    if winner_coords is None:\n        return None, None\n\n    loser_coords_list = []\n    for i in range(3):\n        lc = _build_cardinal_object(cr, cc, loser_dirs[i], loser_gaps[i], loser_areas[i], rng)\n        if lc is None:\n            return None, None\n        loser_coords_list.append(lc)\n    return winner_coords, loser_coords_list\n\n\ndef _areas_are_valid(winner_coords: list[tuple[int, int]], loser_coords_list: list[list[tuple[int, int]]]) -> bool:\n    actual_areas = [len(winner_coords)] + [len(lc) for lc in loser_coords_list]\n    if any(a < OBJECT_AREA_MIN or a > OBJECT_AREA_MAX for a in actual_areas):\n        return False\n    return not any(len(lc) >= len(winner_coords) for lc in loser_coords_list)\n\n\ndef _points_fit_canvas(points: list[tuple[int, int]], cap: list[tuple[int, int]]) -> bool:\n    if not all(0 <= r < GRID_H and 0 <= c < GRID_W for r, c in points):\n        return False\n    return all(CAP_MARGIN <= r < GRID_H - CAP_MARGIN and CAP_MARGIN <= c < GRID_W - CAP_MARGIN for r, c in cap)\n\n\ndef _groups_are_valid(obj_groups: list[list[tuple[int, int]]]) -> bool:\n    for i in range(len(obj_groups)):\n        if len(set(obj_groups[i])) != len(obj_groups[i]):\n            return False\n        temp = np.zeros((GRID_H, GRID_W), dtype=int)\n        rows, cols = zip(*obj_groups[i])\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' /home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py\"","aggregated_output":"import numpy as np\nfrom collections import deque\n\nfrom arc_utils import components_mask, get_bg, neighbors4, neighbors8\nimport random\nfrom arc_utils import neighbors4\n\n\ndef _components(g: np.ndarray, col: int, conn8: bool) -> list[list[tuple[int, int]]]:\n    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(g == col, connectivity=8 if conn8 else 4)]\n\n\ndef _is_straight_line(comp: list[tuple[int, int]]) -> bool:\n    rs = [r for r, _ in comp]\n    cs = [c for _, c in comp]\n    if len(set(rs)) == 1:\n        row = rs[0]\n        cols = sorted(set(cs))\n        return cols == list(range(min(cols), max(cols) + 1))\n    if len(set(cs)) == 1:\n        col = cs[0]\n        rows = sorted(set(rs))\n        return rows == list(range(min(rows), max(rows) + 1))\n    return False\n\n\ndef _bar_endpoints(comp: list[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int]]:\n    rs = [r for r, _ in comp]\n    cs = [c for _, c in comp]\n    if len(set(cs)) == 1:\n        c = cs[0]\n        return (min(rs), c), (max(rs), c)\n    r = rs[0]\n    return (r, min(cs)), (r, max(cs))\n\n\ndef _touches_border(p: tuple[int, int], h: int, w: int) -> bool:\n    r, c = p\n    return r == 0 or c == 0 or r == h - 1 or c == w - 1\n\n\ndef _bfs_path(start: tuple[int, int], goal: tuple[int, int], walkable: np.ndarray) -> list[tuple[int, int]] | None:\n    h, w = walkable.shape\n    if start == goal:\n        return [start]\n    q = deque([start])\n    prev = {start: None}\n    while q:\n        r, c = q.popleft()\n        for nr, nc in neighbors8(r, c):\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            nxt = (nr, nc)\n            if nxt in prev:\n                continue\n            if not bool(walkable[nr, nc]) and nxt != goal:\n                continue\n            prev[nxt] = (r, c)\n            if nxt == goal:\n                q.clear()\n                break\n            q.append(nxt)\n    if goal not in prev:\n        return None\n    path = []\n    cur = goal\n    while cur is not None:\n        path.append(cur)\n        cur = prev[cur]\n    path.reverse()\n    return path\n\n\ndef _bfs_path_with_diag_filter(\n    start: tuple[int, int], goal: tuple[int, int], walkable: np.ndarray\n) -> list[tuple[int, int]] | None:\n    # Like _bfs_path but disallows diagonal steps when either orthogonal intermediate cell is also walkable.\n    h, w = walkable.shape\n    if start == goal:\n        return [start]\n    q = deque([start])\n    prev = {start: None}\n\n    def can_step(r: int, c: int, nr: int, nc: int) -> bool:\n        dr = nr - r\n        dc = nc - c\n        if dr == 0 or dc == 0:\n            return True\n        # diagonal: skip if either intermediate orth cell is in the walkable set\n        mid1 = (r, c + dc)\n        mid2 = (r + dr, c)\n        if 0 <= mid1[0] < h and 0 <= mid1[1] < w and bool(walkable[mid1]):\n            return False\n        if 0 <= mid2[0] < h and 0 <= mid2[1] < w and bool(walkable[mid2]):\n            return False\n        return True\n\n    while q:\n        r, c = q.popleft()\n        for nr, nc in neighbors8(r, c):\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            nxt = (nr, nc)\n            if nxt in prev:\n                continue\n            if not bool(walkable[nr, nc]) and nxt != goal:\n                continue\n            if not can_step(r, c, nr, nc):\n                continue\n            prev[nxt] = (r, c)\n            if nxt == goal:\n                q.clear()\n                break\n            q.append(nxt)\n    assert goal in prev, \"BFS-with-diag-filter must reach goal\"\n    path = []\n    cur = goal\n    while cur is not None:\n        path.append(cur)\n        cur = prev[cur]\n    path.reverse()\n    return path\n\n\ndef _greedy_manhattan_path(start: tuple[int, int], goal: tuple[int, int], walkable: np.ndarray) -> list[tuple[int, int]] | None:\n    h, w = walkable.shape\n\n    def md(p):\n        return abs(p[0] - goal[0]) + abs(p[1] - goal[1])\n\n    cur = start\n    path = [cur]\n    seen = {cur}\n    while cur != goal:\n        cur_md = md(cur)\n        best = None  # (md, is_diag, nr, nc)\n        for nr, nc in neighbors8(cur[0], cur[1]):\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            nxt = (nr, nc)\n            if nxt in seen:\n                continue\n            if not bool(walkable[nr, nc]) and nxt != goal:\n                continue\n            nmd = md(nxt)\n            if nmd >= cur_md:\n                continue\n            is_diag = 1 if (nr != cur[0] and nc != cur[1]) else 0\n            key = (nmd, is_diag, nr, nc)\n            if best is None or key < best:\n                best = key\n        if best is None:\n            return None\n        _, _, nr, nc = best\n        cur = (nr, nc)\n        path.append(cur)\n        seen.add(cur)\n    return path\n\n\ndef _segment_main_path(seg_pts: list[tuple[int, int]], start: tuple[int, int]) -> list[tuple[int, int]]:\n    # Extract the \"main stroke\" of the segment as a simple path.\n    #\n    # Use 4-neigh edges always. Allow diagonal edges only when they represent a true diagonal stroke,\n    # i.e. the diagonal pixels touch only at the corner (no orthogonal intermediate segment pixel),\n    # which prevents diagonal shortcuts across bends.\n    sset = set(seg_pts)\n\n    def neighbors(p: tuple[int, int]):\n        r, c = p\n        for q in neighbors4(r, c):\n            if q in sset:\n                yield q\n        for dr, dc in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:\n            q = (r + dr, c + dc)\n            if q not in sset:\n                continue\n            # If either orthogonal intermediate cell is occupied, treat this as a bend shortcut and skip.\n            mid1 = (r, c + dc)\n            mid2 = (r + dr, c)\n            if mid1 in sset or mid2 in sset:\n                continue\n            yield q\n\n    q = deque([start])\n    prev: dict[tuple[int, int], tuple[int, int] | None] = {start: None}\n    dist: dict[tuple[int, int], int] = {start: 0}\n    while q:\n        cur = q.popleft()\n        for nxt in neighbors(cur):\n            if nxt in prev:\n                continue\n            prev[nxt] = cur\n            dist[nxt] = dist[cur] + 1\n            q.append(nxt)\n\n    far = max(dist.keys(), key=lambda p: (dist[p], p[0], p[1]))\n    path = []\n    cur = far\n    while cur is not None:\n        path.append(cur)\n        cur = prev[cur]\n    path.reverse()\n    return path\n\n\ndef _segment_degrees(seg_pts: list[tuple[int, int]]) -> dict[tuple[int, int], int]:\n    sset = set(seg_pts)\n    deg = {p: 0 for p in sset}\n    for r, c in sset:\n        # 4-neigh\n        for q in neighbors4(r, c):\n            if q in sset:\n                deg[(r, c)] += 1\n        # diagonals only if no orth intermediate is present\n        for dr, dc in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:\n            q = (r + dr, c + dc)\n            if q not in sset:\n                continue\n            mid1 = (r, c + dc)\n            mid2 = (r + dr, c)\n            if mid1 in sset or mid2 in sset:\n                continue\n            deg[(r, c)] += 1\n    return deg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swing an irregular line segment around a nearby obstacle sprite, preserving its pixel count.\n\n    Input structure:\n    - bg, bar color (straight lines perpendicular to the grid edge, one end on the border), segment color (irregular stroke attached to bar's inner endpoint), obstacle color (sprite near the bar terminal).\n\n    Rule:\n    - Each bar is perpendicular to the edge it touches; its inner (terminal) endpoint has an attached irregular segment.\n    - The segment detaches and re-routes: it travels from the terminal toward the nearest obstacle, hugs the obstacle's boundary, then exits at a 45° diagonal.\n    - Total painted pixels equal the original segment length.\n\n    Key insight: The segment behaves like a rope swung around the obstacle — attach at the nearest point, trace the skin, exit diagonally, conserving length.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    colors = sorted(set(int(v) for v in np.unique(g)) - {bg})\n\n    out = g.copy()\n\n    def bar_candidates():\n        # Yield (bar_color, bar_component, terminal_endpoint).\n        for col in colors:\n            for comp in _components(g, col, conn8=False):\n                if len(comp) < 2 or not _is_straight_line(comp):\n                    continue\n                e0, e1 = _bar_endpoints(comp)\n                touch0 = _touches_border(e0, h, w)\n                touch1 = _touches_border(e1, h, w)\n                if touch0 == touch1:\n                    continue  # require exactly one endpoint on border\n                # Orientation must be perpendicular to the edge it touches.\n                rs = [r for r, _ in comp]\n                cs = [c for _, c in comp]\n                vertical = len(set(cs)) == 1\n                border_ep = e0 if touch0 else e1\n                if vertical:\n                    if border_ep[0] not in (0, h - 1):\n                        continue\n                else:\n                    if border_ep[1] not in (0, w - 1):\n                        continue\n                terminal_ep = e1 if touch0 else e0\n                # Must have an attached non-bg neighbor at terminal.\n                tr, tc = terminal_ep\n                if not any(\n                    0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) != bg and int(g[nr, nc]) != col\n                    for nr, nc in neighbors4(tr, tc)\n                ):\n                    continue\n                yield col, comp, terminal_ep\n","exit_code":0,"status":"completed"}}
