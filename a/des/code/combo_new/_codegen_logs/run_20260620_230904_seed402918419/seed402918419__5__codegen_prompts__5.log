         out[r, c] = marker_color\n  61:     return out\n  62: \n  63: # --------------- generator (att2) ---------------\n  64: \n  65: GRID_MIN, GRID_MAX = 5, 16\n  66: N_COLORS = 10\n  67: \n  68: SHAPE_MIN_HEIGHT, SHAPE_MAX_HEIGHT = 5, 7\n  69: SHAPE_MIN_WIDTH, SHAPE_MAX_WIDTH = 3, 5\n  70: START_WIDTH_MIN, START_WIDTH_MAX = 1, 2\n  71: MAX_LOCAL_WIDTH = 5\n  72: \n  73: MARKER_MIN_CELLS, MARKER_MAX_CELLS = 1, 3\n  74: \n  75: GEN_ATTEMPTS = 300\n  76: \n  77: EDGE_TOUCH_TOP_BOTTOM = \"TB\"\n  78: CORNER_EDGE_PAIRS = [\"TL\", \"TR\", \"BL\", \"BR\"]\n  79: ZERO_DELTA_SHIFTS = [-1, 0, 0, 0, 1]\n  80: \n  81: \n  82: def _gen_grow_parts(total, n):\n  83:     n_twos = total - n\n  84:     parts = [2] * n_twos + [1] * (n - n_twos)\n  85:     random.shuffle(parts)\n  86:     return parts\n  87: \n  88: def _gen_drop_parts(total, n):\n  89:     if n == 0:\n  90:         return []\n  91:     n_twos = random.randint(max(0, total - n), min(total // 2, n))\n  92:     n_ones = total - 2 * n_twos\n  93:     parts = [2] * n_twos + [1] * n_ones + [0] * (n - n_twos - n_ones)\n  94:     random.shuffle(parts)\n  95:     return parts\n  96: \n  97: def _gen_widths(height, max_width):\n  98:     start = random.randint(START_WIDTH_MIN, START_WIDTH_MAX)\n  99:     diff = max_width - start\n 100:     grow_steps = random.randint((diff + 1) // 2, min(diff, height - 1))\n 101:     widths = [start]\n 102:     for inc in _gen_grow_parts(diff, grow_steps):\n 103:         widths.append(widths[-1] + inc)\n 104: \n 105:     remaining = height - len(widths)\n 106:     min_end = max(1, max_width - 2 * remaining)\n 107:     end_width = random.randint(min_end, max_width)\n 108:     for dec in _gen_drop_parts(max_width - end_width, remaining):\n 109:         widths.append(widths[-1] - dec)\n 110:     return widths\n 111: \n 112: def _gen_intervals(widths):\n 113:     left, right = 0, widths[0] - 1\n 114:     intervals = [(left, right)]\n 115:     for prev_width, width in zip(widths, widths[1:]):\n