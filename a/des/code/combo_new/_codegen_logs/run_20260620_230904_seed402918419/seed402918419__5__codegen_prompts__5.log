((span, 3), int(color), dtype=int)\n 167:         if hole_count:\n 168:             patch[1::2, 1] = BG\n 169:     return patch\n 170: \n 171: \n 172: def _line_span(legends: list[tuple[int, int]]) -> int:\n 173:     \"\"\"Total span of legend patches plus 1-cell gaps between them.\"\"\"\n 174:     return sum(_legend_span(h) for h, _ in legends) + len(legends) - 1\n 175: \n 176: \n 177: def _choose_legends(arrangement: str, max_span: int) -> list[tuple[int, int]]:\n 178:     \"\"\"Pick 2-4 legends with distinct hole counts that fit within max_span.\"\"\"\n 179:     count = random.randint(*LEGEND_COUNT_RANGE)\n 180:     combos = [holes for holes in itertools.combinations(range(MAX_HOLE_COUNT), count)\n 181:               if sum(_legend_span(h) for h in holes) + count - 1 <= max_span]\n 182:     if not combos:\n 183:         return _choose_legends(arrangement, max_span + 2)\n 184:     holes = list(random.choice(combos))\n 185:     random.shuffle(holes)\n 186:     colors = random.sample(LEGEND_COLORS, count)\n 187:     return list(zip(holes, colors))\n 188: \n 189: \n 190: def _place_legend_line(\n 191:     grid: np.ndarray, legends: list[tuple[int, int]], arrangement: str, r: int, c: int\n 192: ) -> None:\n 193:     \"\"\"Paste legend patches sequentially along the arrangement axis.\"\"\"\n 194:     rr, cc = int(r), int(c)\n 195:     for hole_count, color in legends:\n 196:         patch = _legend_patch(hole_count, color, arrangement)\n 197:         paste(grid, patch, rr, cc)\n 198:         if arrangement == \"horizontal\":\n 199:             cc += patch.shape[1] + 1\n 200:         else:\n 201:             rr += patch.shape[0] + 1\n 202: \n 203: \n 204: # ---------- layout helpers ----------\n 205: \n 206: def _layout_full_horizontal(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:\n 207:     \"\"\"Place a full-row horizontal divider with legend panel above or below.\"\"\"\n... truncated 392 lines ...\n--- generate_input lines 600-608 ---\n 600: def ge