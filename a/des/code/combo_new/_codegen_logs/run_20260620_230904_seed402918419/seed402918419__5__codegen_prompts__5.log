budget.\n 119: TOP_LEFT_OPTIONS = [True, False]\n 120: MAX_GENERATION_ATTEMPTS = 300\n 121: \n 122: def _gen_half_starts(grid_width, bracket_width, left_side):\n 123:     if left_side:\n 124:         return list(range(0, grid_width // 2 - bracket_width + 1))\n 125:     return list(range((grid_width + 1) // 2, grid_width - bracket_width + 1))\n 126: \n 127: def _gen_bracket_columns(grid_width, bracket_width):\n 128:     \"\"\"Choose non-overlapping top/bottom bracket starts on opposite halves.\"\"\"\n 129:     top_left = random.choice(TOP_LEFT_OPTIONS)\n 130:     top_starts = _gen_half_starts(grid_width, bracket_width, top_left)\n 131:     bottom_starts = _gen_half_starts(grid_width, bracket_width, not top_left)\n 132:     if not top_starts or not bottom_starts:\n 133:         return None\n 134:     return random.choice(top_starts), random.choice(bottom_starts)\n 135: \n 136: def _gen_add_bracket(grid, c0, width, top_edge):\n 137:     edge_row, arm_row = (0, 1) if top_edge else (-1, -2)\n 138:     grid[edge_row, c0:c0 + width] = BRACKET_COLOR\n 139:     grid[arm_row, c0] = BRACKET_COLOR\n 140:     grid[arm_row, c0 + width - 1] = BRACKET_COLOR\n 141: \n 142: def _gen_sprite_masks(height, width):\n 143:     area = height * width\n 144:     min_cells = (MOVER_MIN_DENSITY_NUM * area + MOVER_MIN_DENSITY_DEN - 1) // MOVER_MIN_DENSITY_DEN\n 145:     max_cells = min(MOVER_MAX_CELLS, area)\n 146:     masks = []\n 147:     for cell_count in range(min_cells, max_cells + 1):\n 148:         for cells in itertools.combinations(range(area), cell_count):\n 149:             mask = np.zeros((height, width), dtype=bool)\n 150:             mask[np.unravel_index(cells, (height, width))] = True\n 151:             if not mask.any(axis=0).all() or not mask.any(axis=1).all():\n 152:                 continue\n 153:             if is_contiguous(mask.astype(int), background=0, connectivity=4):\n 154:                 masks.append(mask)\n 155:     return masks\n 156: \n 157: def _gen_mover_sprite