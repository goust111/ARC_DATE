n20:     \"\"\"\n21:     g = np.array(grid, dtype=int)\n22:     bg = int(get_bg(g))\n23: \n24:     # --- find the largest connected component of foreground (multicolor) ---\n25:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n26:     assert not (not comps)\n27:     frame_comp = max(comps, key=lambda d: int(d[\"area\"]))\n28:     fr0, fc0, fr1, fc1 = map(int, frame_comp[\"bbox\"])\n29: \n30:     # The frame is monochrome; use its dominant color as output background.\n31:     frame_cols = [int(g[int(r), int(c)]) for r, c in frame_comp[\"coords\"]]\n32:     bgc = int(Counter(frame_cols).most_common(1)[0][0])\n33: \n34:     # --- layout = bg holes inside the frame bbox, tight-cropped ---\n35:     sub = crop_bbox(g, (fr0, fc0, fr1, fc1))\n36:     hole = sub == int(bg)\n37:     hole_box = bbox(hole)\n38:     assert hole_box is not None, \"frame must enclose at least one bg hole\"\n39:     lr0, lc0, lr1, lc1 = map(int, hole_box)\n40:     layout = hole[lr0 : lr1 + 1, lc0 : lc1 + 1]\n41: \n42:     # --- slot components in the layout ---\n43:     slots = []\n44:     for coords in components_mask(layout, connectivity=4):\n45:         rr0, cc0, rr1, cc1 = bbox_coords(coords)\n46:         rr0, cc0, rr1, cc1 = map(int, (rr0, cc0, rr1, cc1))\n47:         h = int(rr1 - rr0 + 1)\n48:         w = int(cc1 - cc0 + 1)\n49:         sm = np.zeros((h, w), dtype=bool)\n50:         sm[coords[:, 0] - rr0, coords[:, 1] - cc0] = True\n51:         slots.append({\"area\": int(sm.sum()), \"r0\": int(rr0), \"c0\": int(cc0), \"mask\": sm})\n52:     slots.sort(key=lambda s: (-int(s[\"area\"]), int(s[\"r0\"]), int(s[\"c0\"])))\n53: \n54:     assert slots, \"frame must contain at least one slot\"\n55: \n56:     # --- pieces = non-singleton foreground components excluding the frame component ---\n57:     pieces = []\n58:     for comp in comps:\n59:         if comp is frame_comp:\n60:             continue\n61:         coords = comp[\"coords\"]\n62:         if coords.size == 0 or int(coords.shape[0]) <= 1:\n63:             continue\n64:         pr0, pc0, pr1, pc1 = map(int, comp[\"bbox\"])\n65:         patch = crop_bbox(g, (pr0, pc0, pr1, pc1))\n66:         ph, pw = map(int, patch.shape)\n67:         pm = np.zeros((ph, pw), dtype=bool)\n68:         pm[coords[:, 0] - pr0, coords[:, 1] - pc0] = True\n69:         pieces.append({\"area\": int(pm.sum()), \"mask\": pm, \"patch\": patch})\n70: \n71:     assert pieces, \"at least one non-frame piece must exist\"\n72: \n73:     # --- infer k from the smallest solid square piece ---\n74:     k = None\n75:     for p in pieces:\n76:         h, w = map(int, p[\"mask\"].shape)\n77:         if h == w and int(p[\"mask\"].sum()) == int(h * w):\n78:             k = int(h) if k is None else min(int(k), int(h))\n79:     k = int(k or 1)\n80: \n81:     def downsample_blocks(mask: np.ndarray) -> np.ndarray | None:\n82:         hh, ww = mask.shape\n83:         if hh % k != 0 or ww % k != 0:\n84:             return None\n85:         out_h, out_w = int(hh // k), int(ww // k)\n---ENDSNIP---\n490: \n491: \n492: def generate_input() -> np.ndarray:\n493:     for _ in range(GENERATE_MAX_RETRIES):\n494:         res = _gen_attempt()\n495:         if res is not None:\n496:             return res\n497:     raise RuntimeError(\"generate_input: failed to generate after %d attempts\" % GENERATE_MAX_RETRIES)\n---ENDSNIP---\n===FILEEND===\nFILE: /home/lixinyu/snap/new/ARC_code/train/412b6263.py\n36: \n37: \n38: def main(grid: np.ndarray) -> np.ndarray:\n39:     \"\"\"\n40:     Infer the background, rotate the whole input 90 degrees counterclockwise, and stack two framed copies vertically.\n41: \n42:     Input structure:\n43:     - Blue is absent from the input.\n44:     - One rare marker color appears in exactly two pixels.\n45:     - The background is the unique non-marker color whose removal leaves exactly two 4-connected foreground objects, each with one marker pixel and one body color.\n46:     - The