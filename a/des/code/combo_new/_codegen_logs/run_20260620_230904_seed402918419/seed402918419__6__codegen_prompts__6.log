reading direction; border colors in the palette uniquely key into fill colors.\n288:     \"\"\"\n289:     g = np.asarray(grid, dtype=int)\n290:     bg = _bg_boundary(g)\n291: \n292:     mapping, pal_mask = _palette_mapping(g, bg)\n293:     assert mapping, \"main: palette mapping must be non-empty\"\n294: \n295:     out = g.copy()\n296:     _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n297: \n298:     return out\n299: \n300: # --------------- generator (c) ---------------\n301: \n302: # -- Configuration constants --------------------------------------------------\n303: # Grid dimensions\n304: _GRID_H_MIN, _GRID_H_MAX = 4, 13\n305: _GRID_W_MIN, _GRID_W_MAX = 10, 15\n306: _SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n307: _SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n308: _TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n309: \n310: # Palette\n311: _PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n312: \n313: # Sprite geometry\n314: _SPRITE_H_MAX = 7\n315: _SPRITE_W_MAX = 6\n316: _SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n317: _SPRITE_CELL_MAX = 16\n318: _FILLED_SPRITE_MAX = 3\n319: \n320: # Sprite mutation probabilities\n321: _P_HORIZ_WALL = 0.3           # add horizontal internal wall\n322: _P_VERT_WALL = 0.3            # add vertical internal wall\n323: _P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n324: _P_DIAMOND = 0.2              # use diamond shape for 3x3\n325: \n326: # Generation\n327: _MAX_RETRIES = 300\n328: # -- End configuration --------------------------------------------------------\n329: \n330: \n331: def _get_enclosed_holes(sprite):\n332:     \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n333:     h, w = sprite.shape\n334:     return [pts for pts in components_mask(~sprite, connectivity=4)\n335:             if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n336: \n337: \n338: def _make_diamond():\n339:     \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n340:     s = np.zeros((3, 3), dtype=bool)\n341:     s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n342:     return s\n343: \n344: \n345: def _make_hollow_sprite(h, w, rng):\n346:     \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n347:     sprite = np.ones((h, w), dtype=bool)\n348:     if h >= 3 and w >= 3:\n349:         sprite[1:-1, 1:-1] = False\n350:     # Optionally add internal horizontal wall\n351:     if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n352:         br = rng.randint(2, h - 2)\n353:         n = rng.randint(1, w - 2)\n---ENDSNIP---\n542: \n543: \n544: def generate_input():\n545:     for _ in range(_MAX_RETRIES):\n546:         r = _gen_attempt()\n547:         if r is not None:\n548:             return r\n549:     raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n---ENDSNIP---\n===FILEEND===\nFILE: /home/lixinyu/snap/new/ARC_code/train/278e5215.py\n48: \n49: \n50: def main(grid: np.ndarray) -> np.ndarray:\n51:     \"\"\"\n52:     Recolor the large mask crop column-by-column using the separate three-row palette strip.\n53: \n54:     Input structure:\n55:     - The background is the most common color.\n56:     - One large monochrome foreground object is the mask; its bbox is the output region and may contain background holes.\n57:     - The remaining foreground is a 3-row palette rectangle with the same width as the mask bbox: two identical color rows and one uniform row.\n58: \n59:     Rule:\n60:     - Crop to the mask object's bbox.\n61:     - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n62:     - Replace background holes inside the crop with the palette's uniform third-row color.\n63: \n64:     Key insight:\n65:     The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n66:     \"\"\"\n67:     g = np.asarray(grid, dtype=int)\n68:     bg = get_bg(g)\n69:     mask_color = _unique_largest_non_bg_color(g, bg)\n70: \n71:     b = _mask_bbox(g, mask_color)\n72:     mask_crop = crop_bbox(g == int(mask_color), b)\n73:     height, width = map(int, mask_crop.shape)\n74: \n75:     column_colors, hole_color = _palette(g, bg, mask_color, width)\n76:     out = np.tile(column_colors, (height, 1))\n77:     out[~mask_crop] = hole_color\n78:     return out\n79: \n80: # --------------- generator (o5x) ---------------\n81: \n82: # Canvas, colors, and object bounds.\n83: BACKGROUND_COLOR, MASK_COLOR = 0, 5\n84: COLOR_MIN, COLOR_MAX = 1, 9\n85: GRID_SIDE_MIN, GRID_SIDE_MAX = 10, 18\n86: MASK_SIDE_MIN, MASK_SIDE_MAX = 5, 10\n87: PALETTE_HEIGHT = 3\n88: GAP_MIN, GAP_MAX = 1, 3\n89: \n90: # Palette run construction.\n91: RUN_COUNT_OPTIONS = (4, 5)\n92: RUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3\n93: COLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5\n94: UNUSED_COLOR_BIAS = 0.7\n95: \n96: # Mask density and retry budget.\n97: MASK_DENSITY_MIN, MASK_DENSITY_MAX = 0.60, 0.71\n98: GENERATION_ATTEMPTS = 300\n99: \n100: \n101: def _valid_run_lengths(width: int, n_runs: int) -> list[tuple[int, ...]]:\n102:     length_range = range(RUN_LENGTH_MIN, RUN_LENGTH_MAX + 1)\n103:     return [\n104:         tuple(int(x) for x in lengths)\n105:         for lengths in product(length_range, repeat=int(n_runs))\n106:         if sum(lengths) == int(width)\n107:     ]\n108: \n109: \n110: def _run_colors(colors: list[int], n_runs: int) -> list[int]:\n111:     seq: list[int] = []\n112:     unused = set(colors)\n113:     for i in range(int(n_runs)):\n114:         slots_left = int(n_runs) - i\n115:         choices = [c for c in colors if not seq or c != seq[-1]]\n116:         if len(unused) >= slots_left:\n117:             choices = [c for c in choices if c in unused]\n118:         elif unused and random.random() < UNUSED_COLOR_BIAS