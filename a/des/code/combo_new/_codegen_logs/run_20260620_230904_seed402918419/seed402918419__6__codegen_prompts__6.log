rop the input\n16:     interior motif to its bounding box, center that crop in the 3x3 interior, and\n17:     paste the resulting 5x5 icon at upper-left positions (2, 2) and (8, 8) in a\n18:     15x15 background canvas.\n19: \n20:     Key insight\n21:     The variable-size frame is only a carrier; the meaningful object is the\n22:     compact interior motif, which is normalized to the fixed 3x3 icon interior.\n23:     \"\"\"\n24:     g = np.asarray(grid, dtype=int)\n25:     h, w = g.shape\n26:     assert h >= 3 and w >= 3\n27: \n28:     corners = (g[0, 0], g[0, w - 1], g[h - 1, 0], g[h - 1, w - 1])\n29:     assert len(set(map(int, corners))) == 1\n30:     bg = int(corners[0])\n31: \n32:     border = np.concatenate((g[0, :], g[h - 1, :], g[:, 0], g[:, w - 1]))\n33:     frame_colors = set(map(int, border)) - {bg}\n34:     assert len(frame_colors) == 1\n35:     (frame_color,) = tuple(frame_colors)\n36: \n37:     assert np.all(g[0, 1 : w - 1] == frame_color)\n38:     assert np.all(g[h - 1, 1 : w - 1] == frame_color)\n39:     assert np.all(g[1 : h - 1, 0] == frame_color)\n40:     assert np.all(g[1 : h - 1, w - 1] == frame_color)\n41: \n42:     icon = np.full((5, 5), bg, dtype=int)\n43:     icon[0, 1:4] = frame_color\n44:     icon[4, 1:4] = frame_color\n45:     icon[1:4, 0] = frame_color\n46:     icon[1:4, 4] = frame_color\n47: \n48:     interior = g[1 : h - 1, 1 : w - 1]\n49:     motif_box = bbox(interior != bg)\n50:     assert motif_box is not None\n51:     r0, c0, r1, c1 = motif_box\n52:     motif = interior[r0 : r1 + 1, c0 : c1 + 1]\n53:     mh, mw = motif.shape\n54:     assert mh <= 3 and mw <= 3\n55: \n56:     icon_r = 1 + (3 - mh) // 2\n57:     icon_c = 1 + (3 - mw) // 2\n58:     icon[icon_r : icon_r + mh, icon_c : icon_c + mw] = motif\n59: \n60:     out = np.full((15, 15), bg, dtype=int)\n61:     out[2:7, 2:7] = icon\n62:     out[8:13, 8:13] = icon\n63:     return out\n64: \n65: # --------------- generator (att2) ---------------\n66: \n67: # Canvas and color constants.\n68: _GEN_BG = 7\n69: _GEN_FRAME_COLORS = [1, 2, 3, 4, 5, 6, 8, 9]\n70: _GEN_PALETTE = [c for c in range(10) if c != _GEN_BG]\n71: \n72: # Input/output geometry.\n73: _GEN_INPUT_H_RANGE = (6, 10)\n74: _GEN_INPUT_W_RANGE = (5, 10)\n75: _GEN_ICON_SIZE = 5\n76: _GEN_ICON_INTERIOR = 3\n77: _GEN_OUTPUT_SIZE = 15\n78: _GEN_OUTPUT_POSITIONS = ((2, 2), (8, 8))\n79: \n80: # Motif sampling.\n81: _GEN_MOTIF_DIM_RANGE = (1, 4)\n82: _GEN_NON_BG_COUNT_RANGE = (1, 8)\n83: _GEN_COLOR_COUNT_RANGE = (1, 3)\n84: _GEN_FRAME_COLOR_INJECTION_RATE = 0.35\n85: \n---ENDSNIP---\n195: \n196: \n197: def generate_input():\n198:     rng = np.random.default_rng()\n199:     for _ in range(_GEN_MAX_ATTEMPTS):\n200:         inp = _gen_attempt(rng)\n201:         if inp is not None:\n202:             return inp\n203:     raise RuntimeError(\"failed to generate valid db118e2a input\")\n---ENDSNIP---\n===FILEEND===\nFILE: /home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py\n206: \n207: \n208: def main(grid: np.ndarray) -> np.ndarray:\n209:     \"\"\"\n210:     Convert a rough nested line drawing into a clean canonical frame-and-dot diagram.\n211: \n212:     Input structure:\n213:     - The grid has one background color and one foreground color.\n214:     - Foreground 4-connected objects are rough closed frames or small filled blobs.\n215:     - Frames may contain other frames/blobs; blobs outside a frame remain outside it.\n216: \n217:     Rule:\n218:     - Detect the containment tree of foreground objects using holes of each frame object.\n219:     - Replace every blob with one foreground pixel.\n220:     - Replace every frame with a rectangular border padded two cells around its direct children.\n221:     - Place siblings by their original row/column overlap and order, with one empty cell between canonical objects.\n222: \n223:     Key insight: The exact wobbly geometry is irrelevant; only enclosure plus relative sibling positions define the output.\n224:     \"\"\"\n225:     g = np.asarray(grid, dtype=int)\n226:     bg = int(get_bg(g))\n227:     fg_colors = sorted(set(map(int, g.flatten())) - {bg})\n228:     assert len(fg_colors) == 1\n229:     fg = int(fg_colors[0])\n230: \n231:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg], return_format=\"dict\")\n232:     assert comps\n233: \n234:     nodes: list[_Node] = []\n235:     holes: list[list[np.ndarray]] = []\n236:     for comp in comps:\n237:         coords = np.asarray(comp[\"coords\"], dtype=int)\n238:         node = _Node(\n239:             coords=coords,\n240:             bbox=tuple(map(int, comp[\"bbox\"])),\n241:             center=coords.mean(axis=0),\n242:         )\n243:         node_holes = _component_holes(g.shape, coords)\n244:         node.is_frame = bool(node_holes)\n245:         nodes.append(node)\n246:         holes.append(node_holes)\n247: \n248:     assert any(node.is_frame for node in nodes)\n249:     for node_i, node in enumerate(nodes):\n250:         containers = []\n251:         for frame_i, frame in enumerate(nodes):\n252:             if node_i == frame_i or not frame.is_frame:\n253:                 continue\n254:             if any(np.all(hole[tuple(node.coords.T)]) for hole in holes[frame_i]):\n255:                 containers.append(frame)\n256:         if containers:\n257:             node.parent = min(containers, key=lambda item: int(item.coords.shape[0]))\n258:             node.parent.children.append(node)\n259: \n260:     roots = [node for node in nodes if node.parent is None]\n261:     mask = _layout_root(roots)\n262:     out = np.full(mask.shape, bg, dtype=int)\n263:     out[mask] = fg\n264:     return out\n265: \n266: # --------------- generator (o5x) ---------------\n267: \n268: # ── CFG: tunable generation parameters ──────────────────────────────────────\n269: # Grid / canvas bounds\n270: GRID_MIN = 16              # minimum grid dimension (rows or cols)\n271: GRID_MAX = 25              # maximum grid dimension\n272: MAX_EXTRA_PAD = 12 