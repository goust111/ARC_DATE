{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/36a08778.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Simulate water falling from top-edge sources, pooling on shelves, and cascading off edges.\n\n    Input structure:\n    - bg = most common color; water = rarest non-bg; shelf = other non-bg.\n    - Sources: water clusters touching top row. Shelves: horizontal segments.\n\n    Rule:\n    - Water falls down from sources, painting bg cells as water.\n    - On hitting a shelf, it spreads across the shelf span plus one cell past each end.\n    - From those overflow positions, water resumes falling independently.\n\n    Key insight: Each shelf splits a stream into two at its edges, creating a branching waterfall tree.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    cnt = Counter(map(int, g.flatten()))\n    bg = int(cnt.most_common(1)[0][0])\n    non = [int(c) for c in cnt.keys() if int(c) != int(bg)]\n    assert not (not non)\n    water = int(min(non, key=lambda c: (int(cnt[int(c)]), int(c))))\n    other = [int(c) for c in non if int(c) != int(water)]\n    assert not (not other)\n    shelf = int(other[0])\n\n    out = g.copy()\n\n    # sources: 8-connected components of water that touch the top edge; start from their bottommost row\n    sources: list[tuple[int, int]] = []\n    for coords in components_mask(g == int(water), connectivity=8):\n        if coords.size == 0:\n            continue\n        if not bool((coords[:, 0] == 0).any()):\n            continue\n        rmax = int(coords[:, 0].max())\n        cols = sorted({int(c) for r, c in coords if int(r) == int(rmax)})\n        for c in cols:\n            sources.append((int(rmax), int(c)))\n\n    # shelf segments (from original grid g)\n    shelf_segs: list[list[tuple[int, int]]] = [[] for _ in range(H)]\n    for r in range(H):\n        c = 0\n        while c < W:\n            if int(g[int(r), int(c)]) != int(shelf):\n                c += 1\n                continue\n            c0 = int(c)\n            while c + 1 < W and int(g[int(r), int(c + 1)]) == int(shelf):\n                c += 1\n            shelf_segs[int(r)].append((int(c0), int(c)))\n            c += 1\n\n    def find_shelf_seg(r: int, c: int) -> tuple[int, int] | None:\n        for a, b in shelf_segs[int(r)]:\n            if int(a) <= int(c) <= int(b):\n                return (int(a), int(b))\n        return None\n\n    def spread_limits(row: int, start_col: int, min_col: int, max_col: int) -> tuple[int, int]:\n        \"\"\"\n        Expand horizontally only through contiguous bg cells on the current row.\n\n        This prevents water from \"jumping\" over blockers that sit on the spread row.\n        \"\"\"\n        left = int(start_col)\n        while left - 1 >= int(min_col) and int(g[int(row), int(left - 1)]) == int(bg):\n            left -= 1\n\n        right = int(start_col)\n        while right + 1 <= int(max_col) and int(g[int(row), int(right + 1)]) == int(bg):\n            right += 1\n\n        return (int(left), int(right))\n\n    seen: set[tuple[int, int]] = set()\n    q = deque((int(r), int(c)) for r, c in sources)\n\n    while q:\n        r, c = q.popleft()\n        if (int(r), int(c)) in seen:\n            continue\n        seen.add((int(r), int(c)))\n\n        rr, cc = int(r), int(c)\n        out[rr, cc] = int(water)\n\n        while True:\n            nr = int(rr + 1)\n            if nr >= H:\n                break\n            below = int(g[int(nr), int(cc)])\n\n            if below == int(shelf):\n                seg = find_shelf_seg(nr, cc)\n                if seg is None:\n                    break\n                a, b = seg\n                left_bound = int(max(0, int(a - 1)))\n                right_bound = int(min(int(W - 1), int(b + 1)))\n                left, right = spread_limits(rr, cc, left_bound, right_bound)\n                for x in range(left, right + 1):\n                    if int(g[int(rr), int(x)]) == int(bg):\n                        out[int(rr), int(x)] = int(water)\n                for nc in {left, right}:\n                    if int(nc) != int(cc):\n                        q.append((int(rr), int(nc)))\n                break\n\n            rr = nr\n            out[int(rr), int(cc)] = int(water)\n\n    return out\n\n# --------------- generator (cascade tree top-down construction) ---------------\n\ndef _gen_attempt() -> np.ndarray | None:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/52364a65.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Erase the two leftmost columns of every foreground object, leaving the rest of each object in place.\n\n    Input structure:\n    - A grid has one dominant background color and several monochromatic 4-connected foreground objects.\n    - Each foreground object spans at least two columns in its bounding box.\n\n    Rule:\n    - Find each same-color 4-connected foreground object.\n    - Within each object's own bounding box, set foreground pixels in the two leftmost columns to the background color.\n    - Leave all other pixels unchanged.\n\n    Key insight:\n    - The deletion is measured from each object's local left edge, not from the grid edge or from a shared global column.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert components, \"expected at least one foreground object\"\n\n    out = g.copy()\n    for component in components:\n        coords = component[\"coords\"]\n        _r0, c0, _r1, c1 = map(int, component[\"bbox\"])\n        assert c1 - c0 + 1 >= 2, \"each object must span at least two columns\"\n\n        erase = coords[coords[:, 1] < c0 + 2]\n        out[erase[:, 0], erase[:, 1]] = bg\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n# Canvas constraints.\nBG = 8\nGRID_SIZE_RANGE = (8, 11)\nMIN_BACKGROUND_FRACTION = 0.50\n# Object sampling constraints.\nOBJECT_COUNT = 4\nFOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 7, 9]\nSPRITE_WIDTH_RANGE = (2, 6)\nSPRITE_HEIGHT_RANGE = (2, 5)\nSPRITE_PIXEL_RANGE = (4, 14)\nSPRITE_RETRIES = 30\nSPRITE_CONNECTIVITY = 4\nSPRITE_SYMMETRY = \"not_symmetric\"\n# Placement and global retry policy.\nPLACEMENT_PADDING = 1\nPLACEMENT_CONNECTIVITY = 8\nGENERATION_RETRIES = 300\n\ndef _sample_sprite(color: int) -> np.ndarray | None:\n","exit_code":0,"status":"completed"}}
