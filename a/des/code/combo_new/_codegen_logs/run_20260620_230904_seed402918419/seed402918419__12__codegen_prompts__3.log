{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p;/def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/train/9b5080bb.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor the small defect bars on each shared-color object with the opposite panel color.\n\n    Input structure\n    - The grid contains two large panel colors and one shared object color.\n    - Each shared-color object is a mostly solid rectangle inside exactly one panel.\n    Rule\n    - Find the near-solid rectangular core of each object.\n    - Missing core pixels and one-cell protrusions define two-pixel bars perpendicular to the nearest core edge.\n    - Recolor those bars with the other panel color; leave all other pixels unchanged.\n    Key insight\n    - The colors to add are not tied to numeric ids: each object's surrounding panel identifies the opposite panel color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = g.copy()\n\n    object_color, components, panel_colors = _object_components(g)\n    for coords in components:\n        neighbors = _neighbor_colors(g, coords, object_color)\n        assert len(neighbors) == 1\n        panel_color = next(iter(neighbors))\n        target_colors = panel_colors - {panel_color}\n        assert len(target_colors) == 1\n        target_color = next(iter(target_colors))\n\n        rect = _core_rect(coords)\n        for r, c in _defect_bar_cells(coords, rect):\n            assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1]\n            assert int(g[r, c]) in {object_color, panel_color}\n            out[r, c] = target_color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Palette and canvas bounds.\nCOLOR_IDS = list(range(10))\nGRID_SIZE_MIN = 20\nGRID_SIZE_MAX = 27\n\n# Panel layout bounds and options.\nMIN_PANEL_DIM = 9\nMIN_VISIBLE_BORDERS = 2\nBORDER_CHOICES = (0, 1)\nOFFSET_MIN = 2\nOFFSET_MAX = 6\nHORIZONTAL_LAYOUT = 0\nVERTICAL_LAYOUT = 1\nHORIZONTAL_OFFSETS = (\"left\", \"right\", \"none\")\nVERTICAL_OFFSETS = (\"top\", \"bottom\", \"none\")\n\n# Object geometry and placement constraints.\nOBJECTS_PER_PANEL = (1, 2)\nCORE_H_MIN = 3\nCORE_H_MAX = 7\nCORE_W_MIN = 3\nCORE_W_MAX = 9\nDEFECT_COUNT_MIN = 1\nDEFECT_COUNT_MAX = 3\nDEFECT_SIDES = (\"top\", \"bottom\", \"left\", \"right\")\nDEFECT_TYPES = (\"missing\", \"protrusion\")\nPANEL_MARGIN = 1\nOBJECT_GAP = 2\nMAX_PLACE_TRIES = 30\n\n# Generation retry budget.\nMAX_GENERATE_ATTEMPTS = 300\n\n\ndef _choose_palette() -> tuple[int, int, int, int]:\n    colors = COLOR_IDS[:]\n    random.shuffle(colors)\n    return tuple(colors[:4])\n\n\ndef _choose_borders() -> tuple[int, int, int, int]:\n    borders = [random.choice(BORDER_CHOICES) for _ in range(4)]\n    while sum(borders) < MIN_VISIBLE_BORDERS:\n        borders[random.randint(0, 3)] = 1\n    return tuple(borders)\n\n\ndef _build_horizontal_panels(\n    grid: np.ndarray,\n    panel_a_color: int,\n    panel_b_color: int,\n) -> list[tuple[int, int, int, int, int]] | None:\n    \"\"\"Create two panels sharing a horizontal border; returns panel records.\"\"\"\n    H, W = grid.shape\n    split_r = random.randint(MIN_PANEL_DIM, H - MIN_PANEL_DIM - 1)\n    border_top, border_bot, border_left, border_right = _choose_borders()\n\n    pa_height = split_r - border_top\n    pb_height = H - border_bot - split_r\n    if pa_height < MIN_PANEL_DIM or pb_height < MIN_PANEL_DIM:\n        return None\n\n    offset_side = random.choice(HORIZONTAL_OFFSETS)\n    if offset_side == \"none\":\n        pa_c0, pa_c1 = border_left, W - 1 - border_right\n        pb_c0, pb_c1 = border_left, W - 1 - border_right\n    elif offset_side == \"left\":\n        offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_c0 = border_left\n            pa_c1 = W - 1 - border_right\n            pb_c0 = border_left + offset_cols\n            pb_c1 = W - 1 - border_right\n        else:\n            pa_c0 = border_left + offset_cols\n            pa_c1 = W - 1 - border_right\n            pb_c0 = border_left\n            pb_c1 = W - 1 - border_right\n    else:\n        offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_c0 = border_left\n            pa_c1 = W - 1 - border_right - offset_cols\n            pb_c0 = border_left\n            pb_c1 = W - 1 - border_right\n        else:\n            pa_c0 = border_left\n            pa_c1 = W - 1 - border_right\n            pb_c0 = border_left\n            pb_c1 = W - 1 - border_right - offset_cols\n\n    if pa_c1 - pa_c0 + 1 < MIN_PANEL_DIM or pb_c1 - pb_c0 + 1 < MIN_PANEL_DIM:\n        return None\n    if min(pa_c1, pb_c1) < max(pa_c0, pb_c0):\n        return None\n\n    pa_r0, pa_r1 = border_top, split_r - 1\n    pb_r0, pb_r1 = split_r, H - 1 - border_bot\n    grid[pa_r0:pa_r1 + 1, pa_c0:pa_c1 + 1] = panel_a_color\n    grid[pb_r0:pb_r1 + 1, pb_c0:pb_c1 + 1] = panel_b_color\n    return [\n        (panel_a_color, pa_r0, pa_r1, pa_c0, pa_c1),\n        (panel_b_color, pb_r0, pb_r1, pb_c0, pb_c1),\n    ]\n\n\ndef _build_vertical_panels(\n    grid: np.ndarray,\n    panel_a_color: int,\n    panel_b_color: int,\n) -> list[tuple[int, int, int, int, int]] | None:\n    \"\"\"Create two panels sharing a vertical border; returns panel records.\"\"\"\n    H, W = grid.shape\n    split_c = random.randint(MIN_PANEL_DIM, W - MIN_PANEL_DIM - 1)\n    border_top, border_bot, border_left, border_right = _choose_borders()\n\n    pa_width = split_c - border_left\n    pb_width = W - border_right - split_c\n    if pa_width < MIN_PANEL_DIM or pb_width < MIN_PANEL_DIM:\n        return None\n\n    offset_side = random.choice(VERTICAL_OFFSETS)\n    if offset_side == \"none\":\n        pa_r0, pa_r1 = border_top, H - 1 - border_bot\n        pb_r0, pb_r1 = border_top, H - 1 - border_bot\n    elif offset_side == \"top\":\n        offset_rows = random.randint(OFFSET_MIN, min(OFFSET_MAX, H - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_r0, pa_r1 = border_top, H - 1 - border_bot\n            pb_r0, pb_r1 = border_top + offset_rows, H - 1 - border_bot\n        else:\n            pa_r0, pa_r1 = border_top + offset_rows, H - 1 - border_bot\n            pb_r0, pb_r1 = border_top, H - 1 - border_bot\n    else:\n        offset_rows = random.randint(OFFSET_MIN, min(OFFSET_MAX, H - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_r0, pa_r1 = border_top, H - 1 - border_bot - offset_rows\n            pb_r0, pb_r1 = border_top, H - 1 - border_bot\n        else:\n            pa_r0, pa_r1 = border_top, H - 1 - border_bot\n            pb_r0, pb_r1 = border_top, H - 1 - border_bot - offset_rows\n\n    pa_c0, pa_c1 = border_left, split_c - 1\n    pb_c0, pb_c1 = split_c, W - 1 - border_right\n    if pa_r1 - pa_r0 + 1 < MIN_PANEL_DIM or pb_r1 - pb_r0 + 1 < MIN_PANEL_DIM:\n        return None\n    if min(pa_r1, pb_r1) < max(pa_r0, pb_r0):\n        return None\n\n    grid[pa_r0:pa_r1 + 1, pa_c0:pa_c1 + 1] = panel_a_color\n    grid[pb_r0:pb_r1 + 1, pb_c0:pb_c1 + 1] = panel_b_color\n    return [\n        (panel_a_color, pa_r0, pa_r1, pa_c0, pa_c1),\n        (panel_b_color, pb_r0, pb_r1, pb_c0, pb_c1),\n    ]\n\n\ndef _make_panel_grid(\n    panel_a_color: int,\n    panel_b_color: int,\n    bg_color: int,\n) -> tuple[np.ndarray, list[tuple[int, int, int, int, int]]] | None:\n    \"\"\"Sample the canvas and panel layout.\"\"\"\n    H = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    W = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    grid = np.full((H, W), bg_color, dtype=int)\n\n    orientation = random.randint(HORIZONTAL_LAYOUT, VERTICAL_LAYOUT)\n    if orientation == HORIZONTAL_LAYOUT:\n        panels = _build_horizontal_panels(grid, panel_a_color, panel_b_color)\n    else:\n        panels = _build_vertical_panels(grid, panel_a_color, panel_b_color)\n    if panels is None:\n        return None\n    return grid, panels\n\n\ndef _object_overlaps(full_bbox: tuple[int, int, int, int], placed_bboxes: list[tuple[int, int, int, int]]) -> bool:\n    full_r0, full_r1, full_c0, full_c1 = full_bbox\n    for br0, br1, bc0, bc1 in placed_bboxes:\n        if (\n            full_r0 - OBJECT_GAP <= br1\n            and full_r1 + OBJECT_GAP >= br0\n            and full_c0 - OBJECT_GAP <= bc1\n            and full_c1 + OBJECT_GAP >= bc0\n        ):\n            return True\n    return False\n\n\ndef _place_core(\n    panel_bbox: tuple[int, int, int, int],\n    core_h: int,\n    core_w: int,\n    sides: list[str],\n    placed_bboxes: list[tuple[int, int, int, int]],\n) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int]] | None:\n    \"\"\"Find a non-overlapping core bbox and its full bbox including bars.\"\"\"\n    pr0, pr1, pc0, pc1 = panel_bbox\n    extra_top = 1 if \"top\" in sides else 0\n    extra_bot = 1 if \"bottom\" in sides else 0\n    extra_left = 1 if \"left\" in sides else 0\n    extra_right = 1 if \"right\" in sides else 0\n\n    place_r0 = pr0 + PANEL_MARGIN + extra_top\n    place_r1 = pr1 - PANEL_MARGIN - extra_bot - core_h + 1\n    place_c0 = pc0 + PANEL_MARGIN + extra_left\n    place_c1 = pc1 - PANEL_MARGIN - extra_right - core_w + 1\n    if place_r1 < place_r0 or place_c1 < place_c0:\n        return None\n\n    for _ in range(MAX_PLACE_TRIES):\n        cr0 = random.randint(place_r0, place_r1)\n        cc0 = random.randint(place_c0, place_c1)\n        cr1 = cr0 + core_h - 1\n        cc1 = cc0 + core_w - 1\n        full_bbox = (cr0 - extra_top, cr1 + extra_bot, cc0 - extra_left, cc1 + extra_right)\n        if not _object_overlaps(full_bbox, placed_bboxes):\n            return (cr0, cr1, cc0, cc1), full_bbox\n    return None\n\n\ndef _apply_defect(\n    input_grid: np.ndarray,\n    output_grid: np.ndarray,\n    core_bbox: tuple[int, int, int, int],\n    side: str,\n    defect_type: str,\n    panel_color: int,\n    obj_color: int,\n    other_panel_color: int,\n) -> bool:\n    \"\"\"Apply one sampled input defect and its two-cell output bar.\"\"\"\n    cr0, cr1, cc0, cc1 = core_bbox\n    if side == \"top\":\n        if defect_type == \"missing\":\n            valid_cols = list(range(cc0 + 1, cc1))\n            if not valid_cols:\n                return False\n            dc = random.choice(valid_cols)\n            dr = cr0\n            input_grid[dr, dc] = panel_color\n            output_grid[dr - 1, dc] = other_panel_color\n            output_grid[dr, dc] = other_panel_color\n        else:\n            dc = random.randint(cc0, cc1)\n            dr = cr0 - 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr + 1, dc] = other_panel_color\n    elif side == \"bottom\":\n        if defect_type == \"missing\":\n            valid_cols = list(range(cc0 + 1, cc1))\n            if not valid_cols:\n                return False\n            dc = random.choice(valid_cols)\n            dr = cr1\n            input_grid[dr, dc] = panel_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr + 1, dc] = other_panel_color\n        else:\n            dc = random.randint(cc0, cc1)\n            dr = cr1 + 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr - 1, dc] = other_panel_color\n    elif side == \"left\":\n        if defect_type == \"missing\":\n            valid_rows = list(range(cr0 + 1, cr1))\n            if not valid_rows:\n                return False\n            dr = random.choice(valid_rows)\n            dc = cc0\n            input_grid[dr, dc] = panel_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc - 1] = other_panel_color\n        else:\n            dr = random.randint(cr0, cr1)\n            dc = cc0 - 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc + 1] = other_panel_color\n    else:\n        if defect_type == \"missing\":\n            valid_rows = list(range(cr0 + 1, cr1))\n            if not valid_rows:\n                return False\n            dr = random.choice(valid_rows)\n            dc = cc1\n            input_grid[dr, dc] = panel_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc + 1] = other_panel_color\n        else:\n            dr = random.randint(cr0, cr1)\n            dc = cc1 + 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc - 1] = other_panel_color\n    return True\n\n\ndef _place_panel_objects(\n    input_grid: np.ndarray,\n    output_grid: np.ndarray,\n    panel: tuple[int, int, int, int, int],\n    n_objs: int,\n    obj_color: int,\n    other_panel_color: int,\n) -> bool:\n    \"\"\"Place all objects for one panel into input and output grids.\"\"\"\n    panel_color, pr0, pr1, pc0, pc1 = panel\n    avail_r0 = pr0 + PANEL_MARGIN\n    avail_r1 = pr1 - PANEL_MARGIN\n    avail_c0 = pc0 + PANEL_MARGIN\n    avail_c1 = pc1 - PANEL_MARGIN\n    placed_bboxes = []\n\n    for _ in range(n_objs):\n        core_h = random.randint(CORE_H_MIN, min(CORE_H_MAX, avail_r1 - avail_r0 - 2))\n        core_w = random.randint(CORE_W_MIN, min(CORE_W_MAX, avail_c1 - avail_c0 - 2))\n        if core_h < CORE_H_MIN or core_w < CORE_W_MIN:\n            return False\n\n        n_defects = random.randint(DEFECT_COUNT_MIN, DEFECT_COUNT_MAX)\n        sides = random.sample(DEFECT_SIDES, n_defects)\n        defect_types = [random.choice(DEFECT_TYPES) for _ in range(n_defects)]\n\n        placed = _place_core((pr0, pr1, pc0, pc1), core_h, core_w, sides, placed_bboxes)\n        if placed is None:\n            return False\n        core_bbox, full_bbox = placed\n        placed_bboxes.append(full_bbox)\n\n        cr0, cr1, cc0, cc1 = core_bbox\n        output_grid[cr0:cr1 + 1, cc0:cc1 + 1] = obj_color\n        input_grid[cr0:cr1 + 1, cc0:cc1 + 1] = obj_color\n\n        for side, defect_type in zip(sides, defect_types):\n            if not _apply_defect(\n                input_grid,\n                output_grid,\n                core_bbox,\n                side,\n                defect_type,\n                panel_color,\n                obj_color,\n                other_panel_color,\n            ):\n                return False\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    obj_color, panel_a_color, panel_b_color, bg_color = _choose_palette()\n    layout = _make_panel_grid(panel_a_color, panel_b_color, bg_color)\n    if layout is None:\n        return None\n    grid, panels = layout\n\n    n_obj_a = random.choice(OBJECTS_PER_PANEL)\n    n_obj_b = random.choice(OBJECTS_PER_PANEL)\n    if not 2 <= n_obj_a + n_obj_b <= 4:\n        return None\n\n    output_grid = grid.copy()\n    input_grid = grid.copy()\n    object_counts = (n_obj_a, n_obj_b)\n    other_colors = (panel_b_color, panel_a_color)\n\n    for panel, n_objs, other_panel_color in zip(panels, object_counts, other_colors):\n        if not _place_panel_objects(\n            input_grid,\n            output_grid,\n            panel,\n            n_objs,\n            obj_color,\n            other_panel_color,\n        ):\n            return None\n\n    # Verify: run solver on input and check it produces the output\n    try:\n        result = main(input_grid)\n        if np.array_equal(result, output_grid):\n            return input_grid\n    except (AssertionError, IndexError, ValueError):\n        pass\n\n    return None\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATE_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATE_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p;/def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/train/fe45cba4.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p;/def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/train/fe45cba4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the left-edge fragment into its same-colored anchor fragment to complete a solid rectangle.\n\n    Input structure\n    - The grid has a dominant background color.\n    - Exactly one foreground color is split into two 4-connected objects: one\n      touches the left edge, and the other is an anchor away from the left edge.\n    - The translated left-edge object and the anchor can form one filled rectangle.\n    Rule\n    - Find the unique split color whose left-edge object can be translated onto\n      background cells beside the other same-colored object so their union is a\n      solid axis-aligned rectangle.\n    - Clear the left-edge object's original cells to the background.\n    - Paint that object at the unique completing offset, preserving all other cells.\n    Key insight\n    - The active color is identified by object structure and rectangle completion,\n      not by a fixed color id; the same-colored anchor object stays in place.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    color, source, dr, dc = _completion_candidate(g, bg)\n\n    out = g.copy()\n    for r, c in source:\n        out[r, c] = int(bg)\n    for r, c in source:\n        rr, cc = r + dr, c + dc\n        assert int(out[rr, cc]) == int(bg), \"translated source must land on background cells\"\n        out[rr, cc] = int(color)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and object size bounds.\nGRID_SIZE_RANGE = (8, 16)\nOBJECT_HEIGHT_RANGE = (3, 5)\nRECT_WIDTH_RANGE = (4, 7)\nLEFT_PATCH_CANVAS_PAD = 3\n\n# Layout and shape constraints.\nROW_GAP_MIN = 1\nMIN_ROW_WIDTH = 1\nSOURCE_RIGHT_PAD = 2\nDST_WIDTH_RESERVED_COLS = 1\n\n# Sampling controls.\nPALETTE_COLORS = tuple(range(10))\nNONSPLIT_ABOVE_CHOICES = (True, False)\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_symmetric_widths(height: int, width: int, *, min_width: int = MIN_ROW_WIDTH,\n                          varied: bool = False, include_max: bool = False) -> list[int]:\n    \"\"\"Sample row widths and mirror them vertically.\"\"\"\n    half = (height + 1) // 2\n    vals = [random.randint(min_width, width) for _ in range(half)]\n    if include_max:\n        vals[random.randrange(half)] = width\n    if varied and width > min_width and len(set(vals + vals[: height // 2][::-1])) == 1:\n        j = random.randrange(half)\n        vals[j] = min(width, vals[j] + 1) if vals[j] < width else vals[j] - 1\n    return vals + vals[: height // 2][::-1]\n\n\ndef _right_anchored_mask(widths: list[int], patch_width: int) -> np.ndarray:\n    \"\"\"Return a mask whose true cells fill each row from the right edge.\"\"\"\n    row_widths = np.asarray(widths, dtype=int)[:, None]\n    cols = np.arange(patch_width)[None, :]\n    return cols >= patch_width - row_widths\n\n\ndef _gen_right_shape_with_max_width(height: int, patch_width: int, max_row_width: int,\n                                    color: int, bg: int) -> np.ndarray:\n    patch = np.full((height, patch_width), bg, dtype=int)\n    widths = _gen_symmetric_widths(height, max_row_width, varied=True, include_max=True)\n    patch[_right_anchored_mask(widths, patch_width)] = color\n    return patch\n\n\ndef _gen_pick_layout(n: int) -> tuple[int, int, int, int, int] | None:\n    h_min, h_max = OBJECT_HEIGHT_RANGE\n    pairs = [\n        (rh, nh)\n        for rh in range(h_min, h_max + 1)\n        for nh in range(h_min, h_max + 1)\n        if rh + nh + ROW_GAP_MIN <= n\n    ]\n    if not pairs:\n        return None\n    rect_h, nonsplit_h = random.choice(pairs)\n    min_w, max_w = RECT_WIDTH_RANGE[0], min(RECT_WIDTH_RANGE[1], n - LEFT_PATCH_CANVAS_PAD)\n    if max_w < min_w:\n        return None\n    rect_w = random.randint(min_w, max_w)\n\n    place_nonsplit_above = random.choice(NONSPLIT_ABOVE_CHOICES)\n    if place_nonsplit_above:\n        max_rect_top = n - rect_h\n        min_rect_top = nonsplit_h + ROW_GAP_MIN\n        if min_rect_top > max_rect_top:\n            return None\n        rect_top = random.randint(min_rect_top, max_rect_top)\n        nonsplit_top = random.randint(0, rect_top - nonsplit_h - ROW_GAP_MIN)\n    else:\n        max_rect_top = n - rect_h - nonsplit_h - ROW_GAP_MIN\n        if max_rect_top < 0:\n            return None\n        rect_top = random.randint(0, max_rect_top)\n        nonsplit_top = random.randint(rect_top + rect_h + ROW_GAP_MIN, n - nonsplit_h)\n    return rect_h, rect_w, rect_top, nonsplit_h, nonsplit_top\n\n\ndef _gen_split_patches(rect_h: int, rect_w: int, min_dst_width: int,\n                       split_color: int, bg: int) -> tuple[np.ndarray, np.ndarray, list[int]]:\n    dst_widths = _gen_symmetric_widths(rect_h, rect_w - 1, min_width=min_dst_width, varied=True)\n    dst = np.full((rect_h, rect_w), bg, dtype=int)\n    src = np.full((rect_h, rect_w), bg, dtype=int)\n    dst_mask = _right_anchored_mask(dst_widths, rect_w)\n    dst[dst_mask] = split_color\n    src[~dst_mask] = split_color\n    return dst, src, dst_widths\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = random.randint(*GRID_SIZE_RANGE)\n    layout = _gen_pick_layout(n)\n    if layout is None:\n        return None\n    rect_h, rect_w, rect_top, nonsplit_h, nonsplit_top = layout\n\n    colors = list(PALETTE_COLORS)\n    bg = random.choice(colors)\n    colors.remove(bg)\n    split_color, nonsplit_color = random.sample(colors, 2)\n    min_dst_width = max(MIN_ROW_WIDTH, 2 * rect_w - n + SOURCE_RIGHT_PAD)\n    if min_dst_width > rect_w - DST_WIDTH_RESERVED_COLS:\n        return None\n\n    dst, src, dst_widths = _gen_split_patches(rect_h, rect_w, min_dst_width, split_color, bg)\n    nonsplit = _gen_right_shape_with_max_width(\n        nonsplit_h,\n        rect_w,\n        max(dst_widths),\n        nonsplit_color,\n        bg,\n    )\n    split_area = rect_h * rect_w\n    nonsplit_area = int(np.count_nonzero(nonsplit == nonsplit_color))\n    bg_area = n * n - split_area - nonsplit_area\n    if bg_area <= max(split_area, nonsplit_area):\n        return None\n\n    rect_left = n - rect_w\n    out = np.full((n, n), bg, dtype=int)\n    out[rect_top : rect_top + rect_h, rect_left:n] = split_color\n    out[nonsplit_top : nonsplit_top + nonsplit_h, rect_left:n] = nonsplit\n\n    inp = out.copy()\n    inp[rect_top : rect_top + rect_h, rect_left:n] = bg\n    inp[rect_top : rect_top + rect_h, rect_left:n] = dst\n    # Opaque paste of src preserves the original small-canvas overlap behavior.\n    inp[rect_top : rect_top + rect_h, 0:rect_w] = src\n\n    try:\n        produced = main(inp)\n    except AssertionError:\n        return None\n    if not np.array_equal(produced, out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid fe45cba4 input\")\n","exit_code":0,"status":"completed"}}
