\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:617:    \"\"\"Choose 2-3 (color, direction) marker specs from region boundary dirs.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:630:    \"\"\"Pick a marker cell position at a random offset from the coupler bbox in *direction*.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:644:    \"\"\"Return the cell one step inward from *marker* (toward coupler center).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:652:    \"\"\"Ensure every coupler is 8-adjacent to the body via BFS paths.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:670:    \"\"\"Grow *body* toward *target* cells while respecting bbox limits.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:701:    \"\"\"Build a docked train patch: 8-body + 9-couplers + colored markers.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:765:    \"\"\"Find all valid (r, c) placements for *patch* within *region*.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:798:    \"\"\"Place N docked trains on the output grid; return (output, trains) or None.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:828:    \"\"\"Apply random transforms and scatter trains onto the input grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py:899:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py:7:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py:8:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py:20:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py:435:        \"\"\"Split `total` into segments each in [min_s, max_s].\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py:482:        \"\"\"Get (min_ri, min_ci, max_ri, max_ci) in grid cell coords for piece pid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py:491:        \"\"\"Get pixel dimensions of a grid cell range.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py:695:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/a395ee82.py:8:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/a395ee82.py:9:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a395ee82.py:24:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a395ee82.py:107:    \"\"\"Grow a random 4-connected polyomino of *n* cells in a rows x cols grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a395ee82.py:129:    \"\"\"Polyomino of *n* cells that spans exactly rows x cols (touches all 4 edges).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a395ee82.py:142:    \"\"\"4-connected template shape in h x w, spanning bbox, within area/fill bounds.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a395ee82.py:157:    \"\"\"Lattice polyomino of *n* cells with strictly interior origin.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a395ee82.py:170:    \"\"\"Return (min_dr, max_dr, min_dc, max_dc) for a list of (dr, dc) offsets.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a395ee82.py:182:    \"\"\"Try to find a valid singleton cluster position and build the input grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a395ee82.py:225:    \"\"\"Single attempt: pick colors, build template + lattice, place stamps + singletons.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a395ee82.py:266:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:8:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:9:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:22:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:240:    \"\"\"Solid rectangle h x w of booleans.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:245:    \"\"\"Remove boundary cells from a rect mask while preserving 4-connectivity.\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:248:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:292:    \"\"\"Build a cavity shape. If symmetric=True, the result is LR-symmetric.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:306:    \"\"\"Independently mutate two cavity shapes (dst + src) sharing the same (h, w) bbox.\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:309:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:329:    \"\"\"k=1: single cavity centered on the LR axis (odd width, LR-symmetric shape).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:339:    \"\"\"k=2: left + right mirror pair with an odd empty-column gap at the axis.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:359:    \"\"\"k=3: L + centered + R. Center slot has odd width and uses its own pair_id.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:382:    \"\"\"Pick the layout pattern for the current row, given remaining cavity budget.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:391:    \"\"\"Return an LR-symmetric list of cavity slots with a total count near n_target.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:423:    \"\"\"Render an object (src or dst) onto a tight canvas.\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:431:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:486:    \"\"\"Count 4-connected non-bg non-outline components (i.e. filled cavities).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:493:    \"\"\"Count 4-connected bg components fully enclosed by non-bg cells (not touching border).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:526:    \"\"\"Return one color per slot. Mirror-pair slots (same pair_id) share a color by\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:528:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:560:    \"\"\"Return (bg_color, shuffled_non_bg_palette).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:570:    \"\"\"Render src (filled) + dst (empty) from the layout and validate both.\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:572:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:608:    \"\"\"Place src and dst on a random-size canvas with a mandatory gap between them.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3a25b0d8.py:665:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:8:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:9:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:23:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:209:        \"\"\"All unique dihedral variants, with a reflection flag.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:439:    \"\"\"Manhattan gap between two axis-aligned bboxes (r0,c0,r1,c1).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:454:    \"\"\"Apply rot90(k) then optional horizontal flip.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:462:    \"\"\"Rotate/flip an array built for the left border to target the given side.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:475:    \"\"\"Swap two colors in a patch, returning a new array.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:484:    \"\"\"Return (row, col) offsets within the bottom bar to carve out a staircase notch.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:497:    \"\"\"Generate a random 4-connected handle sprite with exactly handle_area pixels.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:518:    \"\"\"Build a frame + docked tool pair oriented for the left border.\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:521:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:562:    \"\"\"Enumerate all valid (fw, top_h, bot_h, notch_n) combinations.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:582:    \"\"\"Pick frame geometry specs for each pair, ensuring distinct plug areas.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:619:    \"\"\"Return shuffled candidate (r0, c0) origins for placing a patch on the given border side.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:635:    \"\"\"Return shuffled list of unique D4 variants of patch, each with its flip flag.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:657:    \"\"\"Build one frame-tool pair, dock it onto the output, and record frame on input_grid.\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:660:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:717:    \"\"\"Pick a random D4 variant of the tool and place it at a free location on the grid.\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:720:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:739:    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:781:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:31:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:32:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:51:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:142:    \"\"\"Sample source rectangle dimensions under the output-width budget.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:202:    \"\"\"Generate one valid input grid, or None when sampled dimensions fail constraints.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:226:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/99caaf76.py:55:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/99caaf76.py:56:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/99caaf76.py:75:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/99caaf76.py:305:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:8:    \"\"\"Local helper: build a boolean mask from bbox-relative component coordinates.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:20:    \"\"\"Canonicalize a boolean mask up to rotation and horizontal reflection.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:31:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:32:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:46:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:113:    \"\"\"Return all (h, w) bboxes where area fits with fill_ratio >= MIN_FILL_RATIO_X10/10.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:132:    \"\"\"Create a seed mask along a diagonal line spanning the bbox, randomly flipped.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:153:    \"\"\"Grow an 8-connected mask from a line seed to the target area.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:169:    \"\"\"Paint a boolean mask into a colored patch on a bg-filled array.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:176:    \"\"\"Generate a random 8-connected component with the given area and color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:189:    \"\"\"Apply a random rotation (0-3) and optional horizontal flip to a mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:197:    \"\"\"Create a duplicate of template's shape with a new color and random transform.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:206:    \"\"\"Distribute components horizontally with random spacing (min gap = MIN_COL_GAP).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:224:    \"\"\"Return a mask that is True wherever occupied or any 8-neighbor is occupied.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:238:    \"\"\"Check if mask placed at (r0, c0) overlaps any dilated-occupied cell.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:244:    \"\"\"Paint all components at their output positions.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:252:    \"\"\"Place components at random non-output rows without 8-neighbor overlap.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:284:    \"\"\"Create duplicate-shape (top) and unique-shape (bottom) component groups.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:321:    \"\"\"Single attempt: build output-first, derive input, validate with oracle.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:361:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
