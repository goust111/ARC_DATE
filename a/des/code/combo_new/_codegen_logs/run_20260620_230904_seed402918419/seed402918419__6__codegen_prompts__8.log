{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom arc_utils import get_bg, in_bounds, neighbors4, label_mask\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect framed squares via colored bridges following a control-pixel sequence.\n\n    Input structure:\n    - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.\n    - Control row below squares: colored pixels read left-to-right encode visitation order.\n\n    Rule:\n    - Start at the square matching first control color c0.\n    - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.\n    - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.\n\n    Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # border color = most common non-bg color\n    cnt = Counter(map(int, g.flatten()))\n    border = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            border = int(col)\n            break\n    assert not (border is None)\n\n    # detect framed squares as connected components of the border color\n    lab, n = label_mask(g == int(border), connectivity=4)\n    frames: list[dict] = []\n    for cid in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(cid))\n        if int(pts.shape[0]) < 8:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        if h < 3 or w < 3:\n            continue\n\n        t = None\n        inner_col = None\n        for tt in range(1, int(min(h, w) // 2) + 1):\n            inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]\n            if inner.size == 0:\n                continue\n            if bool((inner == int(border)).any()):\n                continue\n            u = set(map(int, inner.flatten()))\n            if len(u) != 1:\n                continue\n\n            ok = True\n            if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not ok:\n                continue\n\n            t = int(tt)\n            inner_col = int(next(iter(u)))\n            break\n\n        if t is None or inner_col is None:\n            continue\n\n        frames.append(\n            {\n                \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n                \"t\": int(t),\n                \"inner\": int(inner_col),\n                \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            }\n        )\n\n    assert not (not frames)\n\n    by: dict[int, list[dict]] = defaultdict(list)\n    for f in frames:\n        by[int(f[\"inner\"])].append(f)\n\n    max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n\n    # control row = bottom-most row below the squares with >=2 non-bg pixels\n    ctrl_r = None\n    for r in range(int(H - 1), int(max_frame_r), -1):\n        if int((g[int(r)] != int(bg)).sum()) >= 2:\n            ctrl_r = int(r)\n            break\n    assert not (ctrl_r is None)\n\n    ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n    assert not (len(ctrl) < 2)\n\n    def center(f: dict) -> tuple[int, int]:\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        return int((r0 + r1) // 2), int((c0 + c1) // 2)\n\n    def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n        a = f1[\"inner_bbox\"]\n        b = f2[\"inner_bbox\"]\n        same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n        same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))\n        return same_row, same_col\n\n    # choose start frame\n    start_color = int(ctrl[0])\n    assert not (start_color not in by)\n    start_cands = by[start_color]\n    if len(start_cands) == 1:\n        cur = start_cands[0]\n    else:\n        nxt_color = int(ctrl[1])\n        nxt_cands = by.get(nxt_color, [])\n        best = None\n        bestf = None\n        for f in start_cands:\n            for g2 in (nxt_cands if nxt_cands else [f]):\n                sr, sc = aligned(f, g2)\n                al = 1 if (sr or sc) else 0\n                (r1_, c1_) = center(f)\n                (r2_, c2_) = center(g2)\n                d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n                cand = (int(al), -int(d))\n                if best is None or cand > best:\n                    best = cand\n                    bestf = f\n        cur = bestf\n\n    out = g.copy()\n\n    def draw_bridge(fa: dict, fb: dict, color: int) -> None:\n        (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n        (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n        ia = fa[\"inner_bbox\"]\n        sr, sc = aligned(fa, fb)\n        if sr:\n            rr0, rr1 = int(ia[0]), int(ia[2])\n            if int(c1a) < int(c0b):\n                cc0, cc1 = int(c1a + 1), int(c0b - 1)\n            else:\n                cc0, cc1 = int(c1b + 1), int(c0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n            return\n        if sc:\n            cc0, cc1 = int(ia[1]), int(ia[3])\n            if int(r1a) < int(r0b):\n                rr0, rr1 = int(r1a + 1), int(r0b - 1)\n            else:\n                rr0, rr1 = int(r1b + 1), int(r0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n\n    for i in range(int(len(ctrl)) - 1):\n        a = int(ctrl[i])\n        b = int(ctrl[i + 1])\n        assert int(cur[\"inner\"]) == int(a)\n        assert b in by, f\"control color {b} has no matching frame\"\n        cands = by[b]\n        best = None\n        bestf = None\n        for f in cands:\n            sr, sc = aligned(cur, f)\n            al = 1 if (sr or sc) else 0\n            (r1_, c1_) = center(cur)\n            (r2_, c2_) = center(f)\n            d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n            cand = (int(al), -int(d))\n            if best is None or cand > best:\n                best = cand\n                bestf = f\n        nxt = bestf\n        draw_bridge(cur, nxt, int(a))\n        cur = nxt\n\n    return out\n\n\ndef _most_common_nonbg(g: np.ndarray, bg: int) -> int | None:\n    cnt = Counter(map(int, g.flatten()))\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            return int(col)\n    return None\n\ndef _draw_frame(g: np.ndarray, *, r0: int, c0: int, outer: int, t: int, border: int, inner_col: int) -> None:\n    g[int(r0) : int(r0 + outer), int(c0) : int(c0 + outer)] = int(border)\n    g[int(r0 + t) : int(r0 + outer - t), int(c0 + t) : int(c0 + outer - t)] = int(inner_col)\n\ndef _bridge_cells(fa: dict, fb: dict) -> set[tuple[int, int]]:\n    (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n    (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n    ia = fa[\"inner_bbox\"]\n    ib = fb[\"inner_bbox\"]\n    # same-row band\n    if int(ia[0]) == int(ib[0]) and int(ia[2]) == int(ib[2]):\n        rr0, rr1 = int(ia[0]), int(ia[2])\n        if int(c1a) < int(c0b):\n            cc0, cc1 = int(c1a + 1), int(c0b - 1)\n        else:\n            cc0, cc1 = int(c1b + 1), int(c0a - 1)\n        assert int(cc0) <= int(cc1), \"horizontal bridge gap must be non-empty\"\n        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n    # same-col band\n    if int(ia[1]) == int(ib[1]) and int(ia[3]) == int(ib[3]):\n        cc0, cc1 = int(ia[1]), int(ia[3])\n        if int(r1a) < int(r0b):\n            rr0, rr1 = int(r1a + 1), int(r0b - 1)\n        else:\n            rr0, rr1 = int(r1b + 1), int(r0a - 1)\n        assert int(rr0) <= int(rr1), \"vertical bridge gap must be non-empty\"\n        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n    return set()\n\n_DIGITS = [int(i) for i in range(10)]\n\ndef _gen_attempt() -> np.ndarray | None:\n    # --- colors ---\n    bg = int(np.random.choice(np.array(_DIGITS, dtype=int)))\n    border = int(np.random.choice(np.array([d for d in _DIGITS if int(d) != int(bg)], dtype=int)))\n    inner_palette = [int(d) for d in _DIGITS if int(d) not in (int(bg), int(border))]\n    if len(inner_palette) < 3:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport itertools\nimport random\n\n\nMARKER_COLOR = 1\nBODY_COLOR = 2\n\n\ndef _vertical_bars(g: np.ndarray, bg: int) -> list[dict]:\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    bars = []\n    baseline = None\n    for comp in comps:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert c0 == c1\n        coords = comp[\"coords\"]\n        height = r1 - r0 + 1\n        assert comp[\"area\"] == height\n        assert {(int(r), int(c)) for r, c in coords} == {(r, c0) for r in range(r0, r1 + 1)}\n        if baseline is None:\n            baseline = r1\n        else:\n            assert r1 == baseline\n        bars.append(\n            {\n                \"color\": int(comp[\"color\"]),\n                \"col\": int(c0),\n                \"bottom\": int(r1),\n                \"height\": int(height),\n                \"coords\": coords,\n            }\n        )\n\n    assert bars\n    return sorted(bars, key=lambda b: b[\"col\"])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n    Input structure\n    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n    Rule\n    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n    - Red bars that are not reached from a blue marker remain unchanged.\n    Key insight\n    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g))) - {bg}\n    assert colors <= {MARKER_COLOR, BODY_COLOR}\n    assert MARKER_COLOR in colors\n\n    bars = _vertical_bars(g, bg)\n    by_col = {bar[\"col\"]: bar for bar in bars}\n    assert len(by_col) == len(bars)\n\n    baselines = {bar[\"bottom\"] for bar in bars}\n    assert len(baselines) == 1\n    baseline = baselines.pop()\n    out = g.copy()\n    for bar in bars:\n        if bar[\"color\"] != MARKER_COLOR:\n            continue\n\n        group = [bar]\n        current = bar\n        while True:\n            next_col = current[\"col\"] + current[\"height\"]\n            next_bar = by_col.get(next_col)\n            if next_bar is None:\n                break\n            if next_bar[\"color\"] != BODY_COLOR:\n                break\n            group.append(next_bar)\n            current = next_bar\n\n        for item in group:\n            rows = item[\"coords\"][:, 0]\n            cols = item[\"coords\"][:, 1]\n            out[rows, cols] = bg\n\n        for item in group:\n            col = item[\"col\"]\n            height = item[\"height\"]\n            assert col + height <= g.shape[1]\n            out[baseline, col : col + height] = item[\"color\"]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nMIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n\n# Bar and chain structure.\nMIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\nMIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\nMIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n\n# Layout padding and retry budget.\nGAP_VALUES = (1, 2, 3)\nMAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n\n\ndef _chain_red_distributions(n_blue, n_red):\n    \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n    return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n\n\ndef _bounded_tuples(values, n, max_sum):\n    \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n    return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n\n\ndef _sample_groups():\n    \"\"\"Sample row count and bar groups before physical layout.\"\"\"\n    rows = random.randint(MIN_ROWS, MAX_ROWS)\n    max_height = min(MAX_BAR_HEIGHT, rows)\n    n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)\n    max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)\n    red_total = random.randint(MIN_RED_BARS, max_red)\n    min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)\n    max_unchained = min(MAX_UNCHAINED_RED, red_total)\n    n_unchained = random.randint(min_unchained, max_unchained)\n\n    distributions = _chain_red_distributions(n_blue, red_total - n_unchained)\n    if not distributions:\n        return None\n\n    groups = [\n        {\"kind\": \"chain\", \"colors\": [MARKER_COLOR] + [BODY_COLOR] * n_red}\n        for n_red in random.choice(distributions)\n    ]\n    groups.extend({\"kind\": \"unchained\", \"colors\": [BODY_COLOR]} for _ in range(n_unchained))\n    random.shuffle(groups)\n    if groups[0][\"kind\"] == \"unchained\":\n        for i, group in enumerate(groups):\n            if group[\"kind\"] == \"chain\":\n                groups[0], groups[i] = groups[i], groups[0]\n                break\n    return rows, max_height, groups\n\n\ndef _sample_layout(max_height, groups):\n    \"\"\"Sample gaps, heights, margins, and positioned bar columns.\"\"\"\n    n_bars = sum(len(group[\"colors\"]) for group in groups)\n    right_margin = random.randint(0, MAX_RIGHT_MARGIN)\n\n    gap_count = len(groups) - 1\n    if gap_count:\n        max_gap_sum = MAX_WIDTH - right_margin - MIN_BAR_HEIGHT * n_bars\n        gap_options = _bounded_tuples(GAP_VALUES, gap_count, max_gap_sum)\n        if not gap_options:\n            return None\n        gaps = list(random.choice(gap_options))\n    else:\n        gaps = []\n\n    height_options = _bounded_tuples(\n        tuple(range(MIN_BAR_HEIGHT, max_height + 1)),\n        n_bars,\n        MAX_WIDTH - right_margin - sum(gaps),\n    )\n    if not height_options:\n        return None\n    heights = list(random.choice(height_options))\n\n    idx = 0\n    for group in groups:\n        count = len(group[\"colors\"])\n        group[\"heights\"] = heights[idx : idx + count]\n        idx += count\n\n    span = sum(heights) + sum(gaps)\n    min_left = max(0, MIN_WIDTH - right_margin - span)\n    max_left = MAX_WIDTH - right_margin - span\n    if min_left > max_left:\n        return None\n    if min_left <= min(MAX_RANDOM_LEFT_MARGIN, max_left):\n        left_margin = random.randint(min_left, min(MAX_RANDOM_LEFT_MARGIN, max_left))\n    else:\n        left_margin = min_left\n\n    width = left_margin + span + right_margin\n    if not (MIN_WIDTH <= width <= MAX_WIDTH):\n        return None\n\n    bars = []\n    col = left_margin\n    gap_i = 0\n    for group_i, group in enumerate(groups):\n        chained = group[\"kind\"] == \"chain\"\n        for color, height in zip(group[\"colors\"], group[\"heights\"]):\n            bars.append(\n                {\n                    \"color\": color,\n                    \"height\": height,\n                    \"col\": col,\n                    \"chained\": chained,\n                }\n            )\n            col += height\n        if group_i + 1 < len(groups):\n            col += gaps[gap_i]\n            gap_i += 1\n\n    if col + right_margin != width:\n        return None\n    return bars, width\n\n\ndef _render_pair(rows, width, bars):\n    \"\"\"Render the sampled input grid and its expected transformed output.\"\"\"\n    baseline = rows - 1\n    inp = np.zeros((rows, width), dtype=int)\n    out = np.zeros_like(inp)\n    for bar in bars:\n        color, height, col = bar[\"color\"], bar[\"height\"], bar[\"col\"]\n        vertical = slice(baseline - height + 1, baseline + 1)\n        inp[vertical, col] = color\n        if bar[\"chained\"]:\n            out[baseline, col : col + height] = color\n        else:\n            out[vertical, col] = color\n    return inp, out\n\n\ndef _passes_oracle(inp, expected):\n    \"\"\"Return whether the solver accepts and matches the rendered output.\"\"\"\n    try:\n        actual = main(inp)\n    except Exception:\n        return False\n","exit_code":0,"status":"completed"}}
