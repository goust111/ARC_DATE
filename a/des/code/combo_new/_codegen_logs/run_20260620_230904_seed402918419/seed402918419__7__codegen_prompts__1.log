{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/8a6d367c.py && printf '\\\\n---GEN---\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/8a6d367c.py | head -n 220\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the framed area by expanding the unique upper template that contains the existing seed pixels.\n\n    Input structure:\n    - A teal background contains small colored template masks above a larger rectangular frame.\n    - The frame encloses one fill color arranged as a partial block-scaled copy of one template.\n    - The frame interior dimensions are an integer square scale of the matching template bbox.\n\n    Rule:\n    - Crop to the rectangular frame.\n    - Identify the unique upper template whose block-scaled mask covers every existing fill pixel inside the frame.\n    - Reset the frame interior to background and paint the whole scaled mask with the fill color.\n\n    Key insight:\n    The lower colored pixels are seed cells that reveal which upper template should be completed inside the frame.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    frame_color, (r0, c0, r1, c1) = _find_frame(g, bg)\n\n    out = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n    interior = out[1:-1, 1:-1]\n    fill_colors = set(map(int, np.unique(interior))) - {bg, frame_color}\n    assert len(fill_colors) == 1, \"frame interior must contain exactly one fill color\"\n    fill_color = fill_colors.pop()\n\n    seed = interior == fill_color\n    assert np.any(seed), \"frame must contain seed pixels\"\n    ih, iw = seed.shape\n\n    matches: list[np.ndarray] = []\n    for template in _templates_above_frame(g, bg, r0):\n        th, tw = template.shape\n        if ih % th != 0 or iw % tw != 0:\n            continue\n        scale_h = ih // th\n        scale_w = iw // tw\n        if scale_h != scale_w:\n            continue\n\n        scaled = np.kron(template, np.ones((scale_h, scale_w), dtype=bool))\n        if np.all(~seed | scaled):\n            matches.append(scaled)\n\n    assert len(matches) == 1, \"seed pixels must select exactly one scaled template\"\n    completed = matches[0]\n    assert completed.shape == interior.shape\n\n    interior[:, :] = bg\n    interior[completed] = fill_color\n    return out\n\n# --------------- generator (att2) ---------------\n\nGEN_BG = 8\nGEN_GRID_SHAPE = (27, 21)\nGEN_TEMPLATE_SHAPES = [(3, 3), (3, 4), (4, 3)]\nGEN_TEMPLATE_COUNT_RANGE = (2, 6)\nGEN_TEMPLATE_ROW = 1\nGEN_TEMPLATE_LEFT_MIN = 1\nGEN_TEMPLATE_GAP = 1\nGEN_MAX_TEMPLATE_SPAN = 19\nGEN_DENSITY_MIN_NUM = 1\nGEN_DENSITY_MIN_DEN = 2\nGEN_DENSITY_MAX_NUM = 5\nGEN_DENSITY_MAX_DEN = 6\nGEN_SCALE_RANGE = (2, 5)\nGEN_SEED_COUNTS = (2, 3)\nGEN_SEED_FRACTION_RANGE = (0.20, 0.60)\nGEN_FRAME_ROW_GAP = 2\nGEN_FRAME_LEFT_MIN = 1\nGEN_ATTEMPTS = 300\nGEN_PALETTE = [0, 1, 2, 3, 4, 5, 6, 7, 9]\n\ndef _gen_has_full_bbox(mask: np.ndarray) -> bool:\n    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())\n\n\ndef _gen_valid_masks(th: int, tw: int) -> list[np.ndarray]:\n    n = int(th * tw)\n    lo = (GEN_DENSITY_MIN_NUM * n + GEN_DENSITY_MIN_DEN - 1) // GEN_DENSITY_MIN_DEN\n    hi = (GEN_DENSITY_MAX_NUM * n) // GEN_DENSITY_MAX_DEN\n    masks: list[np.ndarray] = []\n    for bits in range(1 << n):\n        count = int(bits.bit_count())\n        if count < lo or count > hi:\n            continue\n        flat = np.array([(bits >> k) & 1 for k in range(n)], dtype=bool)\n        mask = flat.reshape(th, tw)\n        if _gen_has_full_bbox(mask):\n            masks.append(mask)\n    return masks\n\n\ndef _gen_colored_patch(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\n    patch = np.full(mask.shape, bg, dtype=int)\n    patch[mask] = int(color)\n    return patch\n\n\ndef _gen_draw_frame(shape: tuple[int, int], bg: int, frame_color: int) -> np.ndarray:\n    patch = np.full(shape, bg, dtype=int)\n    patch[0, :] = frame_color\n    patch[-1, :] = frame_color\n    patch[:, 0] = frame_color\n    patch[:, -1] = frame_color\n    return patch\n\n\ndef _gen_frame_patch(\n    target_mask: np.ndarray,\n    seed_cells: np.ndarray,\n    scale: int,\n    bg: int,\n    frame_color: int,\n    fill_color: int,\n) -> tuple[np.ndarray, np.ndarray]:\n    th, tw = map(int, target_mask.shape)\n    scaled = np.kron(target_mask, np.ones((scale, scale), dtype=bool))\n    out = _gen_draw_frame((th * scale + 2, tw * scale + 2), bg, frame_color)\n    out[1:-1, 1:-1][scaled] = fill_color\n\n    frame = _gen_draw_frame(out.shape, bg, frame_color)\n    for r, c in seed_cells:\n        rr = int(r) * scale\n        cc = int(c) * scale\n        frame[1 + rr : 1 + rr + scale, 1 + cc : 1 + cc + scale] = fill_color\n    return frame, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n    bg = GEN_BG\n    count = int(rng.integers(*GEN_TEMPLATE_COUNT_RANGE))\n    shape_choices = [\n        shape for shape in GEN_TEMPLATE_SHAPES if count * shape[1] + count - 1 <= GEN_MAX_TEMPLATE_SPAN\n    ]\n    th, tw = shape_choices[int(rng.integers(0, len(shape_choices)))]\n    scale = int(rng.integers(*GEN_SCALE_RANGE))\n\n    valid_masks = _gen_valid_masks(th, tw)\n    if len(valid_masks) < count:\n        return None\n\n    target = valid_masks[int(rng.integers(0, len(valid_masks)))]\n    true_cells = np.argwhere(target)\n    target_area = int(len(true_cells))\n    min_seed_frac, max_seed_frac = GEN_SEED_FRACTION_RANGE\n    seed_counts = [k for k in GEN_SEED_COUNTS if min_seed_frac <= k / target_area <= max_seed_frac]\n    if not seed_counts:\n        return None\n    seed_count = int(seed_counts[int(rng.integers(0, len(seed_counts)))])\n    seed_idx = rng.choice(target_area, size=seed_count, replace=False)\n    seed_cells = true_cells[seed_idx]\n\n    covers_seed = np.array([bool(mask[seed_cells[:, 0], seed_cells[:, 1]].all()) for mask in valid_masks])\n    distractor_pool = [mask for mask, covers in zip(valid_masks, covers_seed) if not covers]\n    if len(distractor_pool) < count - 1:\n        return None\n    distractor_idx = rng.choice(len(distractor_pool), size=count - 1, replace=False)\n    distractors = [distractor_pool[int(i)] for i in distractor_idx]\n\n    masks = distractors + [target]\n    rng.shuffle(masks)\n\n    colors = list(GEN_PALETTE)\n    rng.shuffle(colors)\n    frame_color = int(colors[0])\n    fill_color = int(colors[1])\n    template_colors = [int(c) for c in colors[2 : 2 + count]]\n\n    frame, expected = _gen_frame_patch(target, seed_cells, scale, bg, frame_color, fill_color)\n    grid_h, grid_w = GEN_GRID_SHAPE\n    grid = np.full(GEN_GRID_SHAPE, bg, dtype=int)\n\n    total_template_w = count * tw + count - 1\n    template_c0 = int(rng.integers(GEN_TEMPLATE_LEFT_MIN, grid_w - total_template_w))\n    c = template_c0\n    for mask, color in zip(masks, template_colors):\n        paste(grid, _gen_colored_patch(mask, color, bg), GEN_TEMPLATE_ROW, c, transparent=bg)\n        c += tw + GEN_TEMPLATE_GAP\n\n    fh, fw = map(int, frame.shape)\n    min_r0 = th + GEN_FRAME_ROW_GAP\n    max_r0 = grid_h - fh\n    if min_r0 > max_r0:\n        return None\n    frame_r0 = int(rng.integers(min_r0, max_r0 + 1))\n    frame_c0 = int(rng.integers(GEN_FRAME_LEFT_MIN, grid_w - fw))\n    paste(grid, frame, frame_r0, frame_c0)\n\n    try:\n        if not np.array_equal(main(grid), expected):\n            return None\n    except Exception:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n\n---GEN---\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 8a6d367c input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/db615bd4.py && printf '\\\\n---GEN---\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/db615bd4.py | head -n 220\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/db615bd4.py && printf '\\\\n---GEN---\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/db615bd4.py | head -n 220\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Thicken the sparse frame and stamp the external sparse sprites into it in positional order.\n\n    Input structure\n    The grid has a dominant background color, a regular lattice color, one large\n    sparse rectangular frame, and one or more external monochrome sprites whose\n    pixels also sit on a two-step lattice.\n\n    Rule\n    Use the largest sparse rectangular perimeter as the frame. Clear that frame\n    region and the external sprite pixels to background, draw a solid one-pixel\n    border in the frame color, solidify each sparse sprite into its contiguous\n    two-step mask, and place the sprites inside the frame with equal gaps.\n    Wide frames receive sprites left-to-right by source position; tall frames\n    receive them top-to-bottom by source position.\n\n    Key insight\n    The frame supplies ordered slots: the sprite-to-slot assignment is by visible\n    source order, not by numeric color or by matching individual cells.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    counts = Counter(map(int, g.ravel()))\n    non_bg = colors_present(g, exclude={bg})\n    assert non_bg, \"expected foreground colors\"\n\n    max_non_bg_count = max(counts[c] for c in non_bg)\n    lattice_candidates = [c for c in non_bg if counts[c] == max_non_bg_count]\n    assert len(lattice_candidates) == 1, \"lattice color must be uniquely most frequent\"\n    lattice_color = lattice_candidates[0]\n\n    special_colors = [c for c in non_bg if c != lattice_color]\n    assert len(special_colors) >= 2, \"expected one frame and at least one sprite\"\n\n    coords_by_color = {c: np.argwhere(g == c) for c in special_colors}\n    frame_candidates = []\n    for color, coords in coords_by_color.items():\n        if _is_sparse_rect_perimeter(coords):\n            frame_candidates.append((color, bbox_coords(coords)))\n    assert frame_candidates, \"expected a sparse rectangular frame\"\n\n    max_area = max(_bbox_area(b) for _color, b in frame_candidates)\n    largest_frames = [(color, b) for color, b in frame_candidates if _bbox_area(b) == max_area]\n    assert len(largest_frames) == 1, \"frame must be the unique largest sparse perimeter\"\n    frame_color, frame_bbox = largest_frames[0]\n\n    source_colors = [c for c in special_colors if c != frame_color]\n    r0, c0, r1, c1 = frame_bbox\n    interior_h = r1 - r0 - 1\n    interior_w = c1 - c0 - 1\n    assert interior_h != interior_w, \"frame must have a unique long axis\"\n\n    sprites = []\n    for color in source_colors:\n        coords = coords_by_color[color]\n        b = bbox_coords(coords)\n        assert not _bboxes_overlap(b, frame_bbox), \"sprites must be outside the frame\"\n        mask = _solidified_mask(coords)\n        assert mask.any(), \"sprite mask must be nonempty\"\n        sprites.append({\"color\": color, \"bbox\": b, \"mask\": mask})\n\n    out = g.copy()\n    for color in source_colors:\n        coords = coords_by_color[color]\n        out[coords[:, 0], coords[:, 1]] = bg\n\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    out[r0, c0 : c1 + 1] = frame_color\n    out[r1, c0 : c1 + 1] = frame_color\n    out[r0 : r1 + 1, c0] = frame_color\n    out[r0 : r1 + 1, c1] = frame_color\n\n    _place_sprites_in_order(out, sprites, frame_bbox, horizontal=interior_w > interior_h)\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and lattice geometry.\nGRID_SIZE, LATTICE_STEP = 25, 2\nODD_ANCHOR_START, EVEN_ANCHOR_START = 1, 0\n\n# Palette roles.\nCOLOR_RANGE, BASE_COLOR_COUNT = range(10), 3\n\n# Sprite and frame logical dimensions.\nSPRITE_COUNTS = [2, 3]\nSPRITE_DIM_MIN, SPRITE_DIM_MAX = 1, 3\nALONG_SUM_MIN, ALONG_SUM_MAX = 3, 7\nFRAME_DIM_MIN, FRAME_DIM_MAX = 5, 9\nFRAME_MARGIN_DIMS = 2\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _choose_along_dims(n_sprites: int) -> list[int] | None:\n    along_dims = []\n    for i in range(n_sprites):\n        remaining = n_sprites - i - 1\n        current_sum = sum(along_dims)\n        lo = max(SPRITE_DIM_MIN, ALONG_SUM_MIN - current_sum - SPRITE_DIM_MAX * remaining)\n        hi = min(SPRITE_DIM_MAX, ALONG_SUM_MAX - current_sum - SPRITE_DIM_MIN * remaining)\n        if lo > hi:\n            return None\n        along_dims.append(random.randint(lo, hi))\n    return along_dims\n\n\ndef _choose_frame_shape(horizontal: bool, n_sprites: int) -> tuple[int, int, list[tuple[int, int]]] | None:\n    cross_dim = random.randint(SPRITE_DIM_MIN, SPRITE_DIM_MAX)\n    along_dims = _choose_along_dims(n_sprites)\n    if along_dims is None:\n        return None\n\n    frame_along = sum(along_dims) + FRAME_MARGIN_DIMS\n    min_cross = max(FRAME_DIM_MIN, cross_dim + 1)\n    possible_cross = [v for v in range(min_cross, FRAME_DIM_MAX + 1) if v != frame_along]\n    if not possible_cross:\n        return None\n\n    frame_cross = random.choice(possible_cross)\n    if horizontal:\n        return frame_cross, frame_along, [(cross_dim, w_l) for w_l in along_dims]\n    return frame_along, frame_cross, [(h_l, cross_dim) for h_l in along_dims]\n\n\ndef _pixel_bbox(sr: int, sc: int, h_l: int, w_l: int) -> tuple[int, int, int, int]:\n    return (sr, sc, sr + LATTICE_STEP * (h_l - 1), sc + LATTICE_STEP * (w_l - 1))\n\n\ndef _overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n    return a[0] <= b[2] and b[0] <= a[2] and a[1] <= b[3] and b[1] <= a[3]\n\n\ndef _choose_odd_bbox(h_l: int, w_l: int) -> tuple[int, int, int, int] | None:\n    max_r = GRID_SIZE - 1 - LATTICE_STEP * (h_l - 1)\n    max_c = GRID_SIZE - 1 - LATTICE_STEP * (w_l - 1)\n    valid_r = list(range(ODD_ANCHOR_START, max_r + 1, LATTICE_STEP))\n    valid_c = list(range(ODD_ANCHOR_START, max_c + 1, LATTICE_STEP))\n    if not valid_r or not valid_c:\n        return None\n\n    r0 = random.choice(valid_r)\n    c0 = random.choice(valid_c)\n    return _pixel_bbox(r0, c0, h_l, w_l)\n\n\ndef _stamp_sparse_frame(grid: np.ndarray, frame_bbox: tuple[int, int, int, int], frame_color: int) -> None:\n    r0, c0, r1, c1 = frame_bbox\n    grid[r0 : r1 + 1 : LATTICE_STEP, c0] = frame_color\n    grid[r0 : r1 + 1 : LATTICE_STEP, c1] = frame_color\n    grid[r0, c0 : c1 + 1 : LATTICE_STEP] = frame_color\n    grid[r1, c0 : c1 + 1 : LATTICE_STEP] = frame_color\n\n\ndef _choose_sprite_anchors(sprite_dims: list[tuple[int, int]], frame_bbox: tuple[int, int, int, int]) -> list[tuple[int, int]] | None:\n    placed_bboxes = []\n    sprite_anchors = []\n\n    for h_l, w_l in sprite_dims:\n        max_sr = GRID_SIZE - 1 - LATTICE_STEP * (h_l - 1)\n        max_sc = GRID_SIZE - 1 - LATTICE_STEP * (w_l - 1)\n        candidates = []\n        for sr in range(EVEN_ANCHOR_START, max_sr + 1, LATTICE_STEP):\n            for sc in range(EVEN_ANCHOR_START, max_sc + 1, LATTICE_STEP):\n                sb = _pixel_bbox(sr, sc, h_l, w_l)\n                if _overlap(sb, frame_bbox):\n                    continue\n                if any(_overlap(sb, pb) for pb in placed_bboxes):\n                    continue\n                candidates.append((sr, sc))\n        if not candidates:\n            return None\n\n        sr, sc = random.choice(candidates)\n        placed_bboxes.append(_pixel_bbox(sr, sc, h_l, w_l))\n        sprite_anchors.append((sr, sc))\n\n    return sprite_anchors\n\n\ndef _has_unique_ordering(sprite_anchors: list[tuple[int, int]], horizontal: bool) -> bool:\n    keys = [(sc, sr) for sr, sc in sprite_anchors] if horizontal else [(sr, sc) for sr, sc in sprite_anchors]\n    return len(set(keys)) == len(keys)\n\n\ndef _stamp_sparse_sprites(grid: np.ndarray, sprite_dims: list[tuple[int, int]], sprite_anchors: list[tuple[int, int]], sprite_colors: list[int]) -> None:\n    for i, (h_l, w_l) in enumerate(sprite_dims):\n        sr, sc = sprite_anchors[i]\n        grid[sr : sr + LATTICE_STEP * h_l : LATTICE_STEP, sc : sc + LATTICE_STEP * w_l : LATTICE_STEP] = sprite_colors[i]\n\n\ndef _lattice_is_unique_non_bg_max(grid: np.ndarray, bg: int, lattice_color: int) -> bool:\n    counts = Counter(grid.ravel().tolist())\n    non_bg = [c for c in counts if c != bg]\n    if not non_bg:\n        return False\n\n    max_count = max(counts[c] for c in non_bg)\n    lattice_cands = [c for c in non_bg if counts[c] == max_count]\n    return len(lattice_cands) == 1 and lattice_cands[0] == lattice_color\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n_sprites = random.choice(SPRITE_COUNTS)\n    palette = random.sample(COLOR_RANGE, BASE_COLOR_COUNT + n_sprites)\n    bg, lattice_color, frame_color = palette[0], palette[1], palette[2]\n    sprite_colors = palette[3:]\n    horizontal = random.choice([True, False])\n\n    frame_and_sprites = _choose_frame_shape(horizontal, n_sprites)\n    if frame_and_sprites is None:\n        return None\n    frame_H, frame_W, sprite_dims = frame_and_sprites\n\n    frame_bbox = _choose_odd_bbox(frame_H, frame_W)\n    if frame_bbox is None:\n        return None\n\n    grid = np.full((GRID_SIZE, GRID_SIZE), bg, dtype=int)\n    grid[ODD_ANCHOR_START::LATTICE_STEP, ODD_ANCHOR_START::LATTICE_STEP] = lattice_color\n    _stamp_sparse_frame(grid, frame_bbox, frame_color)\n\n    sprite_anchors = _choose_sprite_anchors(sprite_dims, frame_bbox)\n    if sprite_anchors is None or not _has_unique_ordering(sprite_anchors, horizontal):\n        return None\n\n    _stamp_sparse_sprites(grid, sprite_dims, sprite_anchors, sprite_colors)\n\n    if not _lattice_is_unique_non_bg_max(grid, bg, lattice_color):\n        return None\n\n    try:\n        main(grid)\n    except Exception:\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n\n---GEN---\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
