{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/58c02a16.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox, get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Expand the top-left seed mask into a recursive colored pattern and tile it across the full grid.\n\n    Input structure\n    - The background is the dominant color.\n    - All foreground lies in a top-left rectangle whose last row and last column are a solid secondary color.\n    - Removing that secondary-color row and column leaves a seed region containing background plus one primary color.\n\n    Rule\n    - Use the primary-color pixels in the seed as a binary mask.\n    - Replace each primary seed cell with a copy of the seed mask in the primary color, and each background seed cell\n      with a copy of the seed mask in the secondary color.\n    - Repeat and crop that expanded tile to the original grid shape.\n\n    Key insight\n    The solid L-shaped secondary-color border is a legend, not output content; it supplies the color used when the\n    seed's background cells are expanded.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    fg_bbox = bbox(g != bg)\n    assert fg_bbox is not None, \"expected a top-left foreground legend\"\n    r0, c0, r1, c1 = fg_bbox\n    assert r0 == 0 and c0 == 0, \"foreground legend must be anchored at the top-left corner\"\n\n    legend_box = g[: r1 + 1, : c1 + 1]\n    seed_h = legend_box.shape[0] - 1\n    seed_w = legend_box.shape[1] - 1\n    assert seed_h >= 1 and seed_w >= 1, \"legend must contain a non-empty seed plus border\"\n\n    secondary_border = np.concatenate((legend_box[:seed_h, seed_w], legend_box[seed_h, :]))\n    secondary_colors = np.unique(secondary_border)\n    assert secondary_colors.size == 1, \"expected one solid secondary-color border\"\n    secondary = int(secondary_colors[0])\n    assert secondary != bg, \"secondary border must be foreground\"\n\n    seed = legend_box[:seed_h, :seed_w]\n    primary_colors = np.unique(seed[seed != bg])\n    assert primary_colors.size == 1, \"seed must contain exactly one primary foreground color\"\n    primary = int(primary_colors[0])\n    assert primary != secondary, \"primary and secondary colors must be distinct\"\n    assert np.all((seed == bg) | (seed == primary)), \"seed may contain only background and primary colors\"\n    assert np.any(seed == bg), \"seed must include background cells that expand to the secondary color\"\n\n    seed_mask = seed == primary\n    H, W = g.shape\n    rows = np.arange(H)[:, None]\n    cols = np.arange(W)[None, :]\n\n    inner_mask = seed_mask[rows % seed_h, cols % seed_w]\n    meta_mask = seed_mask[(rows // seed_h) % seed_h, (cols // seed_w) % seed_w]\n\n    out = np.full(g.shape, bg, dtype=int)\n    out[inner_mask & meta_mask] = primary\n    out[inner_mask & ~meta_mask] = secondary\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color palette.\nBACKGROUND_COLOR, PALETTE_COLORS = 7, tuple(range(10))\n# Seed geometry.\nSEED_SIZES = (2, 3)\nSEED_DENSITY_MIN, SEED_DENSITY_MAX = 0.33, 0.67\n# Canvas layout.\nTILE_MULTIPLIERS, GRID_MIN, GRID_MAX = range(3, 6), 7, 16\nREMAINDERS_BY_SQUARENESS = {False: (0,), True: (0, 1)}\n# Retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _expected_output(seed_mask: np.ndarray, shape: tuple[int, int], bg: int, primary: int, secondary: int) -> np.ndarray:\n    \"\"\"Render the two-level fractal that main() should produce.\"\"\"\n    seed_h, seed_w = seed_mask.shape\n    H, W = shape\n    rows = np.arange(H)[:, None]\n    cols = np.arange(W)[None, :]\n\n    inner = seed_mask[rows % seed_h, cols % seed_w]\n    meta = seed_mask[(rows // seed_h) % seed_h, (cols // seed_w) % seed_w]\n\n    out = np.full((H, W), bg, dtype=int)\n    out[inner & meta] = primary\n    out[inner & ~meta] = secondary\n    return out\n\ndef _layout_options(seed_h: int, seed_w: int) -> list[tuple[int, int]]:\n    \"\"\"Return valid canvas shapes for a sampled seed size.\"\"\"\n    options = []\n    for k in TILE_MULTIPLIERS:\n        for rem in REMAINDERS_BY_SQUARENESS[seed_h == seed_w]:\n            H = seed_h * k + rem\n            W = seed_w * k + rem\n            if GRID_MIN <= H <= GRID_MAX and GRID_MIN <= W <= GRID_MAX and H >= seed_h * seed_h and W >= seed_w * seed_w:\n                options.append((H, W))\n    return options\n\ndef _random_seed_mask(seed_h: int, seed_w: int) -> np.ndarray:\n    \"\"\"Sample a nonempty, nonfull primary mask within density bounds.\"\"\"\n    area = seed_h * seed_w\n    lo = max(1, int(np.ceil(area * SEED_DENSITY_MIN)))\n    hi = min(area - 1, int(np.floor(area * SEED_DENSITY_MAX)))\n    n_primary = random.randint(lo, hi)\n    chosen = random.sample(range(area), n_primary)\n    mask = np.zeros((seed_h, seed_w), dtype=bool)\n    mask.reshape(-1)[chosen] = True\n    return mask\n\ndef _render_input(seed_mask: np.ndarray, shape: tuple[int, int], bg: int, primary: int, secondary: int) -> np.ndarray:\n    \"\"\"Render the top-left seed legend on a background canvas.\"\"\"\n    seed_h, seed_w = seed_mask.shape\n    inp = np.full(shape, bg, dtype=int)\n    inp[:seed_h, :seed_w][seed_mask] = primary\n    inp[seed_h, : seed_w + 1] = secondary\n    inp[:seed_h, seed_w] = secondary\n    return inp\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Build one oracle-checked input grid, or None if validation fails.\"\"\"\n    bg = BACKGROUND_COLOR\n    primary, secondary = random.sample([c for c in PALETTE_COLORS if c != bg], 2)\n\n    seed_h = random.choice(SEED_SIZES)\n    seed_w = random.choice(SEED_SIZES)\n    H, W = random.choice(_layout_options(seed_h, seed_w))\n\n    seed_mask = _random_seed_mask(seed_h, seed_w)\n    inp = _render_input(seed_mask, (H, W), bg, primary, secondary)\n    expected = _expected_output(seed_mask, (H, W), bg, primary, secondary)\n    try:\n        actual = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return inp\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 58c02a16 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import find_components, get_bg, neighbors4, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n","exit_code":0,"status":"completed"}}
