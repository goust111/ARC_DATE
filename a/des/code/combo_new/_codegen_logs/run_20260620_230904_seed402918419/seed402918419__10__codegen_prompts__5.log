\n  50:     - Red bars that are not reached from a blue marker remain unchanged.\n  51:     Key insight\n  52:     - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n  53:     \"\"\"\n  54:     g = np.asarray(grid, dtype=int)\n  55:     bg = get_bg(g)\n  56:     colors = set(map(int, np.unique(g))) - {bg}\n  57:     assert colors <= {MARKER_COLOR, BODY_COLOR}\n  58:     assert MARKER_COLOR in colors\n  59: \n  60:     bars = _vertical_bars(g, bg)\n  61:     by_col = {bar[\"col\"]: bar for bar in bars}\n  62:     assert len(by_col) == len(bars)\n  63: \n  64:     baselines = {bar[\"bottom\"] for bar in bars}\n  65:     assert len(baselines) == 1\n  66:     baseline = baselines.pop()\n  67:     out = g.copy()\n  68:     for bar in bars:\n  69:         if bar[\"color\"] != MARKER_COLOR:\n  70:             continue\n  71: \n  72:         group = [bar]\n  73:         current = bar\n  74:         while True:\n  75:             next_col = current[\"col\"] + current[\"height\"]\n  76:             next_bar = by_col.get(next_col)\n  77:             if next_bar is None:\n  78:                 break\n  79:             if next_bar[\"color\"] != BODY_COLOR:\n  80:                 break\n  81:             group.append(next_bar)\n  82:             current = next_bar\n  83: \n  84:         for item in group:\n  85:             rows = item[\"coords\"][:, 0]\n  86:             cols = item[\"coords\"][:, 1]\n  87:             out[rows, cols] = bg\n  88: \n  89:         for item in group:\n  90:             col = item[\"col\"]\n  91:             height = item[\"height\"]\n  92:             assert col + height <= g.shape[1]\n  93:             out[baseline, col : col + height] = item[\"color\"]\n  94: \n  95:     return out\n  96: \n  97: # --------------- generator (att2) ---------------\n  98: \n  99: # Canvas bounds.\n 100: MIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n 101: \n 102: # Bar and chain structure.\n 103: MIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\n 104: MIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\n 105: MIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n 106: \n 107: # Layout padding and retry budget.\n 108: GAP_VALUES = (1, 2, 3)\n 109: MAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n 110: \n 111: \n 112: def _chain_red_distributions(n_blue, n_red):\n 113:     \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n 114:     return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n 115: \n 116: \n 117: def _bounded_tuples(values, n, max_sum):\n 118:     \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n 119:     return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n 120: \n---\n 259: \n 260: \n 261: def generate_input():\n 262:     for _ in range(MAX_GENERATION_ATTEMPTS):\n 263:         grid = _gen_attempt()\n 264:         if grid is not None:\n 265:             return grid\n 266:     raise RuntimeError(\"failed to generate a valid 84551f4c input\")\n---\n====\nFILE: /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\n   6: from arc_utils import bbox_h, bbox_w, find_components, in_bounds, neighbors4, paste\n   7: \n   8: def main(grid: np.ndarray) -> np.ndarray:\n   9:     \"\"\"\n  10:     Slide a solid square through a winding channel to reach a same-sized target square.\n  11: \n  12:     Input structure:\n  13:     - bg (most common color). A river color forms a winding corridor.\n  14:     - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n  15: \n  16:     Rule:\n  17:     - The mover square travels along the river toward the destination.\n  18:     - It can only pass through positions where the full NxN area is river.\n  19:     - If reachable, the mover replaces the destination; otherwise