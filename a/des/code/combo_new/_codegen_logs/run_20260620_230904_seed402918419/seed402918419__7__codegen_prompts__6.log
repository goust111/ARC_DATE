r col in range(1, 10) if col not in arrow_colors]\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/28/code.py:550:    for ai in range(n_arrows):\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/28/code.py:551:        color = int(arrow_colors[ai])\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/28/code.py:564:            arrow_pts = [\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/28/code.py:570:            arrow_set = {(int(r), int(c)) for r, c in arrow_pts}\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/28/code.py:573:                for r, c in arrow_set\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/28/code.py:604:                arrow_set=arrow_set,\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/28/code.py:627:                    arrow_set=arrow_set,\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/28/code.py:666:                arrow_set=arrow_set,\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/28/code.py:674:            new_cells = set(arrow_set) | set(ray_set) | set(local_walls)\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/28/code.py:677:            if len(new_cells) != len(arrow_set) + len(ray_set) + len(local_walls):\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/28/code.py:680:            for r, c in arrow_set:\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/28/code.py:689:            occupied_input |= set(arrow_set) | set(local_walls)\n/home/lixinyu/snap/new/ceshi/code_combo/dbff022c/22/code.py:81:#      when space permits, but never mixes multiple conflicting rules inside one hole.\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:3:# Name: 统一轴向射线+形状决定距离+箭头精灵\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:21:#   - Every sprite is now a 3-pixel arrow that points directly along one of the 4 cardinal\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:22:#     directions, so direction is read from the visible tip instead of from an L/V \"gap\".\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:24:#     encoded by arrow family:\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:25:#       * kind \"L\": skew hook arrow, range 4\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:26:#       * kind \"V\": symmetric chevron arrow, range 6\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:29:#       * fused analogue can be a short-range up arrow {(5,5),(6,4),(6,5)}.\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:30:#         It points upward directly, so it lands at (1,5) = tip + 4*(-1,0).\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:31:#       * a long-range up arrow {(5,5),(6,4),(6,6)} points the same way but lands at\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:32:#         (-1,5) conceptually, so the generator only places such arrows where tip+6*dir stays\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:34:#         arrow silhouette plus the induced landing distance.\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:36:#   - The fusion is not simplified into a single arrow template: there are two reusable shape\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:41:#   - Generator examples force both arrow families to appear and reject cases whose output is\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:45:#     monochrome, 8-connected arrow matching exactly one template. The generator uses only\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:46:#     those templates and validates them with _arrow_info(...).\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:50:#     _arrow_info returns only those labels, and generator placements are precomputed by kind.\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:54:#   - Placements are precomputed only when both the arrow cells and tip+range*dir destination\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:59:#   - All arrows are axis-aligned, so the D1 change is visible directly in the input.\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:60:#   - The two arrow silhouettes are visually distinct, and both appear repeatedly, so the D2\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:66:#   - No rule depends on hidden ordering or color ranking; only local shape family, arrow tip,\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:67:#     and landing multiplicity matter.\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:111:def _arrow_info(\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:114:    \"\"\"Return (tip_rc, dir_rc, kind) for a 3-cell axis arrow sprite, else None.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:119:    for tip in comp:\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:120:        tr, tc = tip\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:125:                    matches.append((tip, direction, kind))\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:147:        info = _arrow_info(comp)\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:177:    Fire straight projectiles from 3-pixel arrow sprites, with range determined by arrow family.\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:180:    - The background is the most common color, and each foreground component is a 3-cell monochrome arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:181:    - Every arrow points directly up, down, left, or right from a single tip cell.\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:182:    - There are two arrow silhouettes: a skew hook family and a symmetric chevron family.\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:185:    - Read the firing direction from the arrow tip itself; all projectiles travel along cardinal rays only.\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:186:    - The arrow family sets the distance: hook arrows (