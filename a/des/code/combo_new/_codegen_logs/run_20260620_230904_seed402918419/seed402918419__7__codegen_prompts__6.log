rics[\"narrow_count\"] += 1\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/14/code.py:320:    num_narrow = random.randint(NARROW_COUNT_RANGE[0], min(NARROW_COUNT_RANGE[1], num_components - 1))\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/14/code.py:330:    thicknesses = [NARROW_THICKNESS] * num_narrow\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/14/code.py:331:    thicknesses.extend(random.choice(wide_choices) for _ in range(num_components - num_narrow))\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/14/code.py:394:        if metrics[\"narrow_count\"] < 1 or metrics[\"wide_count\"] < 1:\n/home/lixinyu/snap/new/ceshi/code_combo/e3721c99/12/code.py:353:    \"\"\"Place an L-shaped divider with legend panel in one corner.\"\"\"\n/home/lixinyu/snap/new/ceshi/code/195c6913/D11/0/code.py:45:#    to choose a start heading, and the generator must deliberately emit multiple\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/13/code.py:25:#   all moved pieces, so the “move from shadow to destination” idea is supported by multiple objects\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/7/code.py:111:    tip_12 = [flag for _, flag in out_info]\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/7/code.py:119:        \"tip_12\": tip_12,\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/7/code.py:258:        \"tip_12\": ray_info[\"tip_12\"],\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/7/code.py:269:    for ep, d, is_12 in zip(scene[\"endpoints\"], scene[\"out_dirs\"], scene[\"tip_12\"]):\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/7/code.py:449:def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/7/code.py:454:        if tip_12:\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/7/code.py:516:    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/7/code.py:517:    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/7/code.py:518:    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/7/code.py:714:    for ep, d, is_12 in zip(ray_info[\"endpoints\"], ray_info[\"out_dirs\"], ray_info[\"tip_12\"]):\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/7/code.py:745:        for ep, d, is_12 in zip(ray_info[\"endpoints\"], ray_info[\"out_dirs\"], ray_info[\"tip_12\"]):\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/5/code.py:42:     sample likely to show both multiple palette colors and at least one wraparound.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/27/code.py:41:   - The original task tolerated multiple triggers on one segment because all stayed relevant. In the fused rule,\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/27/code.py:50:   - Full segment corridors are reserved so distractors cannot appear inside blocked tails.\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/12/code.py:55:#    one-pixel 8-neighborhood outlines remain disjoint. Each group is anchored in a narrow column\n/home/lixinyu/snap/new/ceshi/code/abc82100/D1/3/code.py:79:#       人类可从 2-4 个样例看到：legend 的箭头方向决定某个 target 色与 stencil；\n/home/lixinyu/snap/new/ceshi/code/abc82100/D1/3/code.py:218:    Key insight: The legend's arrow direction is the real rule identifier; the scattered source\n/home/lixinyu/snap/new/ceshi/code/195c6913/D11/1/code.py:283:def _build_band(H: int, W: int, lobe_rows: list[int] | None = None, lobe_tail: int = 4) -> np.ndarray:\n/home/lixinyu/snap/new/ceshi/code/195c6913/D11/1/code.py:321:        lmax = min(H - 2, max(lobe_rows) + lobe_tail)\n/home/lixinyu/snap/new/ceshi/code/195c6913/D11/1/code.py:413:    lobe_tail = random.randint(4, 7) if init_dir == (1, 0) else random.randint(2, 5)\n/home/lixinyu/snap/new/ceshi/code/195c6913/D11/1/code.py:423:    mask = _build_band(H, W, lobe_rows=markers, lobe_tail=lobe_tail)\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/35/code.py:109:def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/35/code.py:114:        if tip_12:\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/35/code.py:173:    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/35/code.py:174:    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/35/code.py:175:    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/35/code.py:364:    tip_12 = [flag for _, flag in out_info]\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/35/code.py:395:    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):\n/home/lixinyu/snap/new/ceshi/code_combo/89565ca0/7/code.py:496:    tail = counts[1:]\n/home/lixinyu/snap/new/ceshi/code_combo/89565ca0/7/code.py:497:    random.shuffle(tail)\n/home/lixinyu/snap/new/ceshi/code_combo/89565ca0/7/code.py:498:    counts = [counts[0], *tail]\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/20/code.py:25:#      original solver recolors five cells and leaves the tail cell yellow.\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/20/code.py:55:#      teal, a bigger cross-with-tail does not, and a symmetric non-cross line also does\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/13/code.py:53:#    tail of controlled length, which keeps the component 4-connected and gives an\n/home/lixinyu/snap/new/ceshi/code_combo/b0039139/29/code.py:52:#      only multiplicity; that is no longer valid because component geometry now\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/32/code.py:28:#      k-th outward depth layer remains visible, where k is 2 for narrow/medium\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/32/code.py:204:            \"tip_12\": [],\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/32/code.py:257:    tip_12 = [flag for _, flag in out_info]\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/32/code.py:299:        \"tip_12\": tip_12,\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/32/code.py:329:    tip_12 = list(sig[\"tip_12\"])\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/32/code.py:362:    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/32/code.py:492:def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/32/code.py:497:        if tip_12:\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/32/code.py:556:    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/32/code.py:557:    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/32/code.py:558:    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)\n/home/lixinyu/snap/new/ceshi/code/abc82100/D1/2/code.py:22:#      multiple rules based on the visible local support count.\n/home/lixinyu/snap/new/ceshi/code/abc82100/D1/2/code.py:26:#      enough for humans, but large enough to distinguish multiple rules sharing\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/22/code.py:26:#    - D15 adds an isolated 3-pixel edge legend. Those pixels are not pieces; their left-to-right order\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/22/code.py:62:#    - Exactly one isolated 3-pixel edge legend exists.\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/22/code.py:146:    assert len(candidates) == 1, \"input must contain exactly one isolated 3-pixel edge legend\"\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/22/code.py:342:    - bg is the dominant color; one isolated 3-pixel legend sits on a grid edge and one large hollow rectangle is a destination template.\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/23/code.py:61:    Detect embedded '+' motifs inside a narrow strip and recolor each one to teal.\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/23/code.py:66:    - The true '+' motifs are arranged on one shared row or one shared column, so they read as a narrow 1-D chain, while other foreground cells are only distractors.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/33/code.py:18:    - Each real segment contains multiple on-segment magenta pixels.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/33/code.py:51:      it produces a full X with additional same-diagonal tails beyond the blue\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/33/code.py:65:    - Multiple on-segment magenta pixels still force the solver to infer the\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/33/code.py:130:    - Across examples, solvers can see that multiple magenta pixels appear on a\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/33/code.py:256:    - The background is the most common color. One non-background color forms endpoint pairs on shared 45-degree diagonals, and a different color may appear multiple times between those endpoints on the same diagonal.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/33/code.py:263:    - The puzzle combines two filters at once: multiple magenta pixels can lie on one blue diagonal, but only the topmost one matters, and its effect is a full X-shaped diagonal burst rather than the original perpendicular-only pair of rays.\n/home/lixinyu/snap/new/ceshi/code/195c6913/D7/1/code.py:154:    - First decode the cycle by recognizing whether the corner symbol is L-shaped or T-shaped.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/17/code.py:72:    Key insight: The endpoints no longer define immediate full-width radiation; they identify a narrow outlet, and the exterior fill must respect a fixed bottleneck width first, then a gradually widening cone.\n/home/lixinyu/snap/new/ceshi/code_combo/cb2d8a2c/29/code.py:36:   - The original `start_pts.shape[0] == 1` fails immediately: we now require multiple green border\n/home/lixinyu/snap/new/ceshi/code_combo/cb2d8a2c/29/code.py:59:   - Humans can read the input directly: multiple green source pixels on one edge, a dense stack of\n/home/lixinyu/snap/new/ceshi/code_combo/cb2d8a2c/29/code.py:76:   - No new color mapping has to be inferred; the novelty is purely in multiplicity of starts and in\n/home/lixinyu/snap/new/ceshi/code_combo/cb2d8a2c/29/code.py:126:    assert len(green_pts) >= 2, \"grid must contain multiple green source pixels\"\n/home/lixinyu/snap/new/ceshi/code_combo/cb2d8a2c/29/code.py:292:    - Multiple green (3) source pixels sit on one border edge; each one launches its own downward trunk.\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/41/code.py:249:        \"input color multiplicities must match the reconstructed checkerboard square\"\n/home/lixinyu/snap/new/ceshi/code_combo/b0039139/25/code.py:41:     count by a fixed multiplier.\n/home/lixinyu/snap/new/ceshi/code_combo/b0039139/25/code.py:48:     the solver must count only color-3 pixels.\n/home/lixinyu/snap/new/ceshi/code_combo/b0039139/25/code.py:52:     gradient seed, so examples must expose multiple copies.\n/home/lixinyu/snap/new/ceshi/code_combo/b0039139/25/code.py:156:    - Count all color-3 pixels in section 2; that total is the number of tile copies to produce.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/1/code.py:78:#     This avoids dense overlaps between multiple branches and keeps the\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/9/code.py:48:#   to scan would corrupt later length checks if multiple centers existed, so the solver keeps reads on g\n/home/lixinyu/snap/new/ceshi/code_combo/cb2d8a2c/18/code.py:28:     toward the original continuous-path task. To avoid that, the generator requires multiple\n/home/lixinyu/snap/new/ceshi/code_combo/cb2d8a2c/18/code.py:60:   - Across examples, the user sees detailed obstacle bars in the input but only sparse green\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/3/code.py:309:#   and any cell claimed by multiple branches in the same round stays unchanged while all claimants stop.\n/home/lixinyu/snap/new/ceshi/code_combo/b0039139/26/code.py:91:#      so no area mixes multiple annotation systems.\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/6/code.py:272:        assert len(cols) == len(groups), \"slot multiplicity must match input multiplicity\"\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:30:#        gap. The near pixel is the tail and the far pixel is the head, so the pair\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:36:#             and carve a virtual breach through the capped side selected by the arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:43:#        and places the outside arrow one gap away from the mouth side.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:49:#      separate from the outside arrow and from sparse obstacles.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:50:#    - The outside arrow has only four possible directions and always uses one 2-pixel\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:69:#      obstacle. That would incorrectly make the external arrow cast shadows, so the\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:73:#      arrow first and then score the trigger's 4-neighbors by dot product with that\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:74:#      arrow direction.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:93:#      for where the exterior radiation should go is the detached 2-pixel arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:94:#    - Across examples the same wall family appears with different arrow directions\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:99:#    - The two markers live in different zones: trigger on the wall, arrow outside\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:102:#      that could be mistaken for the outside