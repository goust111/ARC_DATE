/code.py:383:    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/27/code.py:384:    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/27/code.py:385:    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)\n/home/lixinyu/snap/new/ceshi/code_combo/e3721c99/28/code.py:35:#      from 2-4 examples while still allowing multiple distinct nested templates.\n/home/lixinyu/snap/new/ceshi/code/abc82100/D2/3/code.py:171:    - If a source color has multiple candidate legends, keep the most deeply nested stencil (innermost bbox).\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/8/code.py:265:    tip_12 = [flag for _, flag in out_info]\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/8/code.py:296:    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/8/code.py:475:def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/8/code.py:480:        if tip_12:\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/8/code.py:539:    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/8/code.py:540:    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/8/code.py:541:    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)\n/home/lixinyu/snap/new/ceshi/code_combo/89565ca0/19/code.py:502:        raise AssertionError(\"Noise budget too small for multiple visible colors\")\n/home/lixinyu/snap/new/ceshi/code_combo/e3721c99/36/code.py:344:    \"\"\"Place an L-shaped divider with legend panel in one corner.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/34/code.py:21:#      3) a deep narrow indentation that opens to the shell bbox edge.\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/34/cod