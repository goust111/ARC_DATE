ceshi/code_combo/142ca369/17/code.py:81:#   overlap between multiple trajectories, and the crop removes unused empty margins.\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:88:# - To preserve arrow detectability, wall colors are assigned greedily so orthogonally\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:96:# - Assumption: there is exactly one arrow in combo samples. Guaranteed by generating\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:98:#   accidental second arrow component.\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:105:def _is_arrow_pts(pts: list[tuple[int, int]]) -> bool:\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:113:def _arrow_dir_and_start(pts: list[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int]] | None:\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:136:def _find_arrows_and_walls(\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:139:    arrow_cells: set[tuple[int, int]] = set()\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:140:    arrows: list[tuple[int, list[tuple[int, int]]]] = []\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:144:            if _is_arrow_pts(pts):\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:145:                arrows.append((int(col), pts))\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:146:                arrow_cells |= set(pts)\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:151:        if (int(r), int(c)) not in arrow_cells\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:153:    return arrows, arrow_cells, wall_cells\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:160:    arrows, arrow_cells, wall_cells = _find_arrows_and_walls(g, bg)\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:165:    for start_col, pts in arrows:\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:166:        info = _arrow_dir_and_start(pts)\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:193:            if (nr, nc) in arrow_cells:\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:241:    Trace the arrow ray with original reflection physics, then crop to ray coverage.\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:244:    - there is only one arrow in generated samples,\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:326:    arrow_pts: list[tuple[int, int]],\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:329:    arrow_set = set(arrow_pts)\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:343:        blocked = arrow_set | ray_cells\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:379:                if wall in arrow_set or wall in ray_cells or wall in wall_cells:\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:418:def _assign_wall_colors(walls: list[tuple[int, int]], arrow_color: int) -> list[int] | None:\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:419:    palette = [c for c in range(1, 10) if c != int(arrow_color)]\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:453:    arrow_color = _rng.randint(1, 9)\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:458:    arrow_pts = [(mr, sc), (sr, mc), (sr, sc)]\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:459:    if any(not (0 <= r < H and 0 <= c < W) for r, c in arrow_pts):\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:462:    plan = _plan_geometry(H, W, (sr, sc), arrow_pts, n_bounces)\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:469:    wall_colors = _assign_wall_colors(walls, arrow_color)\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:480:    for r, c in arrow_pts:\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:481:        grid[r, c] = arrow_color\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:482:        full_out[r, c] = arrow_color\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:484:    cur_color = int(arrow_color)\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:513:    \"\"\"Generate the single-arrow, high-reflection, cropped-output combo variant.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/30/code.py:42:#    obstacles, keeping the output legible even with multiple walls.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/30/code.py:99:    tip_12 = [flag for _, flag in out_info]\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/30/code.py:131:    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/30/code.py:377:def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/30/code.py:382:        if tip_12:\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/30/code.py:444:    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/30/code.py:445:    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/30/code.py:446:    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)\n/home/lixinyu/snap/new/ceshi/code/13e47133/D10/2/code.py:20:#   radius 1, and so on. To preserve multiple marker colors instead of collapsing\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/1/code.py:40:#       - each rectangle may appear in multiple motif locations, but all rectangles must\n/home/lixinyu/snap/new/ceshi/code_combo/c4d067a0/19/code.py:420:    tail_rows = rows[-min(len(rows), 3) :]\n/home/lixinyu/snap/new/ceshi/code_combo/c4d067a0/19/code.py:421:    tail_cols = cols[-min(len(cols), 3) :]\n/home/lixinyu/snap/new/ceshi/code_combo/c4d067a0/19/code.py:423:    pool |= {(r, c) for r in tail_rows for c in head_cols}\n/home/lixinyu/snap/new/ceshi/code_combo/c4d067a0/19/code.py:424:    pool |= {(r, c) for r in head_rows for c in tail_cols}\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:3:# Name: 箭头源+标记配对\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:18:#    - In this combo, each active source endpoint becomes a 3-cell blue L-arrow. The degree-2\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:19:#      corner is the tip; the missing quadrant is the arrow's forward diagonal direction.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:20:#    - Each arrow also has exactly one orthogonally adjacent marker cell in a non-blue,\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:21:#      non-magenta color. Marker colors are the pairing labels: two arrows with the same marker\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:22:#      color form one active pair. The segment is drawn between their tips, and both arrows must\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:24:#    - Example: suppose arrows A and B have red markers. A's tip is at (3,3) and points SE;\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:25:#      B's tip is at (8,8) and points NW. Old logic would incorrectly read many blue cell pairs\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:26:#      inside the arrow bodies and could not tell which blue cells are endpoints. New logic first\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:27:#      parses each 4-connected 3-cell L, extracts its tip/direction, groups arrows by marker\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:31:#      arrow distractor on the same diagonal extension as a real pair. Geometry-only pairing would\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:40:#    - At most one uniquely marked distractor arrow is added. That is enough to make marker-based\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:44:#    - The old `by_color[line_color]` pool is invalid because a single arrow contains three blue\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:51:#      3-cell L arrow, each such arrow must have exactly one adjacent marker, active marker colors\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:52:#      must appear on exactly two arrows, and those two arrows must face each other along a shared\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:59:#      distractor arrows.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:60:#    - Marker cells are attached to the tip side of an arrow, stay off all active diagonals and\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:61:#      future rays, and touch only their own arrow in 4-neighborhood.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:63:#      arrow unambiguously.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:66:#    - Humans can directly see the L-arrow cue and infer that the diagonal leaves the tip through\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:68:#    - Repeated marker colors across distant arrows make the pairing label visible in a few\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:70:#    - Because every sample has multiple active pairs, the rule \"pair by repeated marker color,\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:71:#      then connect arrow tips\" is more plausible than any accidental one-off geometry heuristic.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:76:#    - Markers sit beside arrow tips instead of on the diagonal itself, so arrows, labels, path\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:78:#    - Distractor arrows, when present, are placed on diagonal extensions outside the active\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:82:#    - Marker colors do not transform into output colors; they only label which arrows belong\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:123:def _arrow_cells(tip: tuple[int, int], direction: tuple[int, int]) -> set[tuple[int, int]]:\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:124:    r, c = tip\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:134:def _tip_marker_candidates(tip: tuple[int, int], direction: tuple[int, int]) -> list[tuple[int, int]]:\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:135:    r, c = tip\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:157:def _find_arrows(grid: np.ndarray, bg: int) -> list[dict]:\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:160:    arrows: list[dict] = []\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:185:            tip = next(cell for cell, d in deg.items() if d == 2)\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:186:            rels = [(rr - tip[0], cc - tip[1]) for rr, cc in comp if (rr, cc) != tip]\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:206:            assert len(marker_cells) == 1, \"each arrow must have exactly one adjacent marker\"\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:208:            arrows.append(\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:210:                    \"tip\": tip,\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:218:    arrows.sort(key=lambda a: (a[\"tip\"], a[\"marker_color\"]))\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:219:    return arrows\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:223:    p = left[\"tip\"]\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:224:    q = right[\"tip\"]\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:235:def _active_pairs_from_arrows(arrows: list[dict]) -> list[dict]:\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:237:    for arrow in arrows:\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:238:        marker_groups.setdefault(arrow[\"marker_color\"], []).append(arrow)\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:248:        assert ordered is not None, \"same-color arrow pair must be diagonal and face inward\"\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:265:    Read marked blue arrow sprites as diagonal endpoints, connect same-marked arrow pairs, then emit rays from magenta cells on those diagonals.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:268:    - bg = most common color. Blue source objects are 3-cell L-shaped arrows whose corner cell is the tip and whose missing quadrant gives the forward diagonal.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:269:    - Each arrow has one orthogonally adjacent marker cell in a non-blue, non-magenta color. Marker colors that appear twice define the active arrow pairs.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:270:    - Magenta trigger cells may lie on the interior of active diagonals; uniquely marked arrows or off-diagonal magenta cells can appear as distractors.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:273:    - Parse every valid blue arrow, group arrows by marker color, and for each marker color that labels exactly two arrows, draw the blue diagonal segment between their tips.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:277:    - Neither raw blue geometry nor marker colors alone are sufficient: the L-shape identifies the true tip and diagonal direction, while the repeated marker color decides which two arrows should actually be connected.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:285:    arrows = _find_arrows(grid, bg)\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:286:    assert arrows, \"grid must contain at least one valid blue arrow\"\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:289:    for pair in _active_pairs_from_arrows(arrows):\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:403:    Ablation: parse arrows but ignore marker colors, pairing each arrow with its farthest\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:410:    arrows = _find_arrows(grid, bg)\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:413:    arrows_by_tip = {arrow[\"tip\"]: arrow for arrow in arrows}\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:415:    for arrow in arrows:\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:417:        best_tip = None\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:418:        for other in arrows:\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:419:            if other is arrow:\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:421:            ordered = _ordered_pair(arrow, other)\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:424:            dist = abs(other[\"tip\"][0] - arrow[\"tip\"][0])\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:427:                best_tip = other[\"tip\"]\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:428:        if best_tip is not None:\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:429:            pair = tuple(sorted((arrow[\"tip\"], best_tip)))\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:434:        left = arrows_by_tip[p]\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:435:        right = arrows_by_tip[q]\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:490:        start_cells = _arrow_cells(start, start_dir)\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:491:        end_cells = _arrow_cells(end, end_dir)\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:492:        all_arrow_cells = start_cells | end_cells\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:495:        if any(not _in_bounds(h, w, cell) for cell in all_arrow_cells):\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/6/code.py:497:        if any(cell in occupied or cell in drawn for cell in all_arrow_cells | path