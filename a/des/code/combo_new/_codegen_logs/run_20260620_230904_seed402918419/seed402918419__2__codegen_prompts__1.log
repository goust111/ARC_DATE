{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/db7260a4.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg, paste\n\n\ndef _closed_u_containers(g: np.ndarray, wall_color: int, bg: int) -> list[tuple[int, int, int, int]]:\n    h, w = g.shape\n    containers = []\n\n    for bottom in range(1, h):\n        for left in range(w - 2):\n            if int(g[bottom, left]) != wall_color:\n                continue\n            for right in range(left + 2, w):\n                if int(g[bottom, right]) != wall_color:\n                    continue\n                if not np.all(g[bottom, left : right + 1] == wall_color):\n                    continue\n\n                top = bottom\n                while top > 0 and int(g[top - 1, left]) == wall_color and int(g[top - 1, right]) == wall_color:\n                    top -= 1\n                if top == bottom:\n                    continue\n\n                interior = g[top:bottom, left + 1 : right]\n                if interior.size == 0 or not np.all(interior == bg):\n                    continue\n                containers.append((top, bottom, left, right))\n\n    return containers\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the singleton marker into the matching red U-shaped container, or make a bottom-row puddle if no closed container is hit.\n\n    Input structure\n    - The grid has a dominant background, one singleton marker pixel on the top row,\n      and one other foreground color forming vertical bars and bottom segments.\n    - A closed container is a U shape: two vertical side bars with a continuous\n      bottom segment between them and an empty rectangular interior above the bottom.\n\n    Rule\n    - Remove the top marker from its original cell.\n    - If exactly one closed U-shaped container has the marker column within its\n      horizontal footprint, fill that container's empty interior with the marker color.\n    - If no closed container is under the marker column, fill the whole bottom row\n      with the marker color.\n\n    Key insight\n    - The marker does not identify a color by value; it identifies a vertical drop\n      column, and only a structurally closed U shape can catch and contain the fill.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    foreground_colors = colors_present(g, exclude={bg})\n    assert len(foreground_colors) == 2, \"expected marker and wall colors\"\n\n    singleton_colors = [color for color in foreground_colors if int(np.count_nonzero(g == color)) == 1]\n    assert len(singleton_colors) == 1, \"expected exactly one singleton marker color\"\n    marker_color = singleton_colors[0]\n\n    wall_colors = [color for color in foreground_colors if color != marker_color]\n    assert len(wall_colors) == 1\n    wall_color = wall_colors[0]\n\n    marker_coords = np.argwhere(g == marker_color)\n    assert marker_coords.shape == (1, 2)\n    marker_r, marker_c = map(int, marker_coords[0])\n    assert marker_r == 0, \"marker must sit on the top row\"\n\n    containers = [\n        container\n        for container in _closed_u_containers(g, wall_color, bg)\n        if container[0] > marker_r and container[2] <= marker_c <= container[3]\n    ]\n    assert len(containers) <= 1, \"marker column must select at most one closed container\"\n\n    out = g.copy()\n    out[marker_r, marker_c] = bg\n    if containers:\n        top, bottom, left, right = containers[0]\n        out[top:bottom, left + 1 : right] = marker_color\n    else:\n        assert np.all(out[-1, :] == bg), \"missed marker should fall to an empty bottom row\"\n        out[-1, :] = marker_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed ARC colors and canvas.\n_GEN_BG = 0\n_GEN_MARKER = 1\n_GEN_WALL = 2\n_GEN_H = 10\n_GEN_W = 10\n\n# Vertical layout bounds; row 9 stays empty in generated inputs.\n_GEN_MARKER_ROW = 0\n_GEN_MIN_WALL_ROW = 2\n_GEN_LAST_WALL_ROW = 8\n\n# Closed container interior size ranges, with exclusive upper bounds.\n_GEN_INTERIOR_H_RANGE = (2, 4)\n_GEN_INTERIOR_W_RANGE = (1, 6)\n\n# Broken distractor patch size ranges, with exclusive upper bounds.\n_GEN_DISTRACTOR_H_RANGE = (2, 4)\n_GEN_DISTRACTOR_W_RANGE = (4, 7)\n\n# Scenario mix and distractor count ranges, with exclusive upper bounds.\n_GEN_FILL_CONTAINER_PROB = 0.67\n_GEN_MISSED_HAS_U_PROB = 0.55\n_GEN_DISTRACTORS_WITH_U_RANGE = (0, 2)\n_GEN_DISTRACTORS_WITHOUT_U_RANGE = (1, 4)\n\n# Rejection-sampling retry budget.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_u_patch(interior_h: int, interior_w: int) -> np.ndarray:\n    patch = np.full((interior_h + 1, interior_w + 2), _GEN_BG, dtype=int)\n    patch[:, 0] = _GEN_WALL\n    patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    return patch\n\n\ndef _gen_sample_u() -> tuple[int, int, int, int, int, int]:\n    interior_h = int(np.random.randint(*_GEN_INTERIOR_H_RANGE))\n    interior_w = int(np.random.randint(*_GEN_INTERIOR_W_RANGE))\n    top = int(np.random.randint(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - interior_h + 1))\n    bottom = top + interior_h\n    left = int(np.random.randint(0, _GEN_W - interior_w - 1))\n    right = left + interior_w + 1\n    return top, bottom, left, right, interior_h, interior_w\n\n\ndef _gen_broken_u_patch(height: int, width: int, *, gap: int | None = None, missing_side: str | None = None) -> np.ndarray:\n    patch = np.full((height, width), _GEN_BG, dtype=int)\n    if missing_side != \"left\":\n        patch[:, 0] = _GEN_WALL\n    if missing_side != \"right\":\n        patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    if gap is not None:\n        patch[-1, gap] = _GEN_BG\n    return patch\n\n\ndef _gen_distractor_patches() -> list[np.ndarray]:\n    patches: list[np.ndarray] = []\n\n    for h in range(*_GEN_DISTRACTOR_H_RANGE):\n        for w in range(*_GEN_DISTRACTOR_W_RANGE):\n            gap = int(np.random.randint(1, w - 1))\n            patches.append(_gen_broken_u_patch(h, w, gap=gap))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"left\"))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"right\"))\n\n    return patches\n\n\ndef _gen_valid_positions(grid: np.ndarray, patch: np.ndarray) -> list[tuple[int, int]]:\n    ph, pw = patch.shape\n    local = np.argwhere(patch == _GEN_WALL)\n    local_set = {(int(r), int(c)) for r, c in local}\n    touch_local = {\n        (r + dr, c + dc)\n        for r, c in local_set\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1))\n        if (r + dr, c + dc) not in local_set\n    }\n    positions: list[tuple[int, int]] = []\n\n    for r0 in range(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - ph + 2):\n        for c0 in range(0, _GEN_W - pw + 1):\n            if np.any(grid[r0 + local[:, 0], c0 + local[:, 1]] != _GEN_BG):\n                continue\n            touches = any(\n                0 <= r0 + r < _GEN_H\n                and 0 <= c0 + c < _GEN_W\n                and grid[r0 + r, c0 + c] == _GEN_WALL\n                for r, c in touch_local\n            )\n            if not touches:\n                positions.append((r0, c0))\n\n    return positions\n\n\ndef _gen_place_distractors(grid: np.ndarray, count: int) -> bool:\n    patches = _gen_distractor_patches()\n    for _ in range(count):\n        placed = False\n        for idx in np.random.permutation(len(patches)):\n            patch = patches[int(idx)]\n            positions = _gen_valid_positions(grid, patch)\n            if not positions:\n                continue\n            r0, c0 = positions[int(np.random.randint(0, len(positions)))]\n            paste(grid, patch, r0, c0, transparent=_GEN_BG)\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n\n\n_GenUBox = tuple[int, int, int, int]\n\n\ndef _gen_design_expected() -> tuple[np.ndarray, bool, _GenUBox | None, int, int]:\n    \"\"\"Build the expected output and return metadata needed to derive the input.\"\"\"\n    expected = np.full((_GEN_H, _GEN_W), _GEN_BG, dtype=int)\n    fill_container = bool(np.random.random() < _GEN_FILL_CONTAINER_PROB)\n    has_u = fill_container or bool(np.random.random() < _GEN_MISSED_HAS_U_PROB)\n    u_box = None\n\n    if has_u:\n        top, bottom, left, right, interior_h, interior_w = _gen_sample_u()\n        paste(expected, _gen_u_patch(interior_h, interior_w), top, left, transparent=_GEN_BG)\n        u_box = (top, bottom, left, right)\n        if fill_container:\n            marker_c = int(np.random.randint(left + 1, right))\n            expected[top:bottom, left + 1 : right] = _GEN_MARKER\n        else:\n            outside = [c for c in range(_GEN_W) if not (left <= c <= right)]\n            marker_c = int(outside[int(np.random.randint(0, len(outside)))])\n            expected[-1, :] = _GEN_MARKER\n        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITH_U_RANGE))\n    else:\n        marker_c = int(np.random.randint(0, _GEN_W))\n        expected[-1, :] = _GEN_MARKER\n        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITHOUT_U_RANGE))\n\n    return expected, fill_container, u_box, marker_c, distractor_count\n\n\ndef _gen_input_from_expected(expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> np.ndarray:\n    inp = expected.copy()\n    if fill_container:\n        assert u_box is not None\n        top, bottom, left, right = u_box\n        inp[top:bottom, left + 1 : right] = _GEN_BG\n    else:\n        inp[-1, :] = _GEN_BG\n    inp[_GEN_MARKER_ROW, marker_c] = _GEN_MARKER\n    return inp\n\n\ndef _gen_valid_pair(inp: np.ndarray, expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> bool:\n    \"\"\"Check structural invariants and the solver oracle.\"\"\"\n    if np.count_nonzero(inp == _GEN_MARKER) != 1 or inp[_GEN_MARKER_ROW, marker_c] != _GEN_MARKER:\n        return False\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/3ad05f52.py\"","aggregated_output":"from collections import Counter, deque\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, draw_line, find_components, get_bg, paste\nimport random\n\n\ndef _distances_from(sources: np.ndarray, passable: np.ndarray) -> np.ndarray:\n    h, w = passable.shape\n    dist = np.full((h, w), -1, dtype=int)\n    q: deque[tuple[int, int]] = deque()\n    for r, c in sources:\n        rr = int(r)\n        cc = int(c)\n        assert passable[rr, cc]\n        dist[rr, cc] = 0\n        q.append((rr, cc))\n\n    while q:\n        r, c = q.popleft()\n        nd = int(dist[r, c]) + 1\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nr = r + dr\n            nc = c + dc\n            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and dist[nr, nc] < 0:\n                dist[nr, nc] = nd\n                q.append((nr, nc))\n    return dist\n\n\ndef _framed_square_rooms(g: np.ndarray, wall: int, sizes: set[int]) -> list[tuple[int, int, int]]:\n    h, w = g.shape\n    rooms: list[tuple[int, int, int]] = []\n    for n in sorted(sizes):\n        assert n > 1\n        for r in range(h - n + 1):\n            for c in range(w - n + 1):\n                if np.any(g[r : r + n, c : c + n] == wall):\n                    continue\n\n                side_wall_counts: list[int] = []\n                if r > 0:\n                    side_wall_counts.append(int(np.count_nonzero(g[r - 1, c : c + n] == wall)))\n                if r + n < h:\n                    side_wall_counts.append(int(np.count_nonzero(g[r + n, c : c + n] == wall)))\n                if c > 0:\n                    side_wall_counts.append(int(np.count_nonzero(g[r : r + n, c - 1] == wall)))\n                if c + n < w:\n                    side_wall_counts.append(int(np.count_nonzero(g[r : r + n, c + n] == wall)))\n\n                if len(side_wall_counts) >= 3 and all(count >= n - 1 for count in side_wall_counts):\n                    rooms.append((r, c, n))\n    return rooms\n\n\ndef _component_bboxes(mask: np.ndarray) -> list[tuple[int, int, int, int, int]]:\n    h, w = mask.shape\n    seen = np.zeros_like(mask, dtype=bool)\n    components: list[tuple[int, int, int, int, int]] = []\n    for r in range(h):\n        for c in range(w):\n            if not mask[r, c] or seen[r, c]:\n                continue\n            q: deque[tuple[int, int]] = deque([(r, c)])\n            seen[r, c] = True\n            r0 = r1 = r\n            c0 = c1 = c\n            area = 0\n            while q:\n                rr, cc = q.popleft()\n                area += 1\n                r0 = min(r0, rr)\n                c0 = min(c0, cc)\n                r1 = max(r1, rr)\n                c1 = max(c1, cc)\n                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                    nr = rr + dr\n                    nc = cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n                        seen[nr, nc] = True\n                        q.append((nr, nc))\n            components.append((r0, c0, r1, c1, area))\n    return components\n\n\ndef _overlap_len(a0: int, a1: int, b0: int, b1: int) -> int:\n    return max(0, min(a1, b1) - max(a0, b0) + 1)\n\n\ndef _middle_fill_bounded_by_side_rooms(\n    bbox: tuple[int, int, int, int],\n    rooms: list[tuple[int, int, int]],\n) -> bool:\n    r0, c0, r1, c1 = bbox\n    left: list[tuple[int, int]] = []\n    right: list[tuple[int, int]] = []\n    above: list[tuple[int, int]] = []\n    below: list[tuple[int, int]] = []\n\n    for r, c, n in rooms:\n        rr1 = r + n - 1\n        cc1 = c + n - 1\n        row_overlap = _overlap_len(r0, r1, r, rr1)\n        col_overlap = _overlap_len(c0, c1, c, cc1)\n        if row_overlap > 0 and 1 <= c0 - cc1 <= 2:\n            left.append((r, rr1))\n        if row_overlap > 0 and 1 <= c - c1 <= 2:\n            right.append((r, rr1))\n        if col_overlap > 0 and 1 <= r0 - rr1 <= 2:\n            above.append((c, cc1))\n        if col_overlap > 0 and 1 <= r - r1 <= 2:\n            below.append((c, cc1))\n\n    def spans_contain(intervals_a: list[tuple[int, int]], intervals_b: list[tuple[int, int]], lo: int, hi: int) -> bool:\n        if not intervals_a or not intervals_b:\n            return False\n        a0 = min(start for start, _end in intervals_a)\n        a1 = max(end for _start, end in intervals_a)\n        b0 = min(start for start, _end in intervals_b)\n        b1 = max(end for _start, end in intervals_b)\n        return lo >= a0 and hi <= a1 and lo >= b0 and hi <= b1\n\n    return spans_contain(left, right, r0, r1) or spans_contain(above, below, c0, c1)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Paint the maze corridor and framed rooms lying on shortest paths between the two colored endpoint components.\n\n    Input structure\n    - The grid has a dominant background, one wall color forming thin orthogonal frames, and one endpoint/fill color.\n    - The endpoint/fill color forms exactly two 4-connected solid rectangular components; their larger side lengths define the framed room sizes.\n\n    Rule\n    - Treat wall pixels as blocked and every other pixel as passable.\n    - Find every passable pixel that lies on a shortest 4-connected path between the two endpoint components.\n    - Also fill any framed square room of an endpoint-derived size that intersects that shortest-path mask.\n\n    Key insight\n    - Shortest paths identify the route through open connector corridors, while the wall-bordered square rooms need to be expanded from the route centerline to their full interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    counts = Counter(map(int, g.flat))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 2\n    assert counts[bg] > max(counts[color] for color in non_bg)\n    non_bg_counts = {color: int(np.count_nonzero(g == color)) for color in non_bg}\n    wall_count = max(non_bg_counts.values())\n    wall_candidates = [color for color, count in non_bg_counts.items() if count == wall_count]\n    assert len(wall_candidates) == 1\n    wall = wall_candidates[0]\n    paint_candidates = [color for color in non_bg if color != wall]\n    assert len(paint_candidates) == 1\n    paint = paint_candidates[0]\n    assert non_bg_counts[wall] > non_bg_counts[paint]\n\n    endpoints = find_components(g, bg=bg, colors=[paint], connectivity=4)\n    assert len(endpoints) == 2\n    endpoint_coords = [component[\"coords\"] for component in endpoints]\n\n    room_sizes: set[int] = set()\n    for coords in endpoint_coords:\n        r0, c0, r1, c1 = bbox_coords(coords)\n        bh = r1 - r0 + 1\n        bw = c1 - c0 + 1\n        assert coords.shape[0] == bh * bw\n        room_sizes.add(max(bh, bw))\n\n    passable = g != wall\n    dist0 = _distances_from(endpoint_coords[0], passable)\n    dist1 = _distances_from(endpoint_coords[1], passable)\n    endpoint_distances = [int(dist0[r, c]) for r, c in endpoint_coords[1]]\n    reachable_distances = [d for d in endpoint_distances if d >= 0]\n    assert len(reachable_distances) == len(endpoint_distances)\n    shortest = min(reachable_distances)\n\n    route = (dist0 >= 0) & (dist1 >= 0) & (dist0 + dist1 == shortest)\n    assert np.any(route)\n\n    fill = route.copy()\n    rooms = _framed_square_rooms(g, wall, room_sizes)\n    assert rooms\n    for r, c, n in rooms:\n        if np.any(route[r : r + n, c : c + n]):\n            fill[r : r + n, c : c + n] = True\n\n    room_mask = np.zeros_like(fill, dtype=bool)\n    for r, c, n in rooms:\n        room_mask[r : r + n, c : c + n] = True\n    open_fill = fill & (g == bg) & ~room_mask\n    for r0, c0, r1, c1, area in _component_bboxes(open_fill):\n        if r1 > r0 and c1 > c0 and area >= 20:\n            assert _middle_fill_bounded_by_side_rooms(\n                (r0, c0, r1, c1),\n                rooms,\n            ), \"middle fill must stay within the facing room-frame spans\"\n\n    H, W = g.shape\n    for r, c, n in rooms:\n        has_doorway = False\n        if r > 0:\n            has_doorway = has_doorway or np.any(g[r - 1, c : c + n] != wall)\n        if r + n < H:\n            has_doorway = has_doorway or np.any(g[r + n, c : c + n] != wall)\n        if c > 0:\n            has_doorway = has_doorway or np.any(g[r : r + n, c - 1] != wall)\n        if c + n < W:\n            has_doorway = has_doorway or np.any(g[r : r + n, c + n] != wall)\n        if has_doorway:\n            assert np.any(fill[r : r + n, c : c + n]), \"rooms with doorways must be on the shortest path\"\n\n    out = g.copy()\n    out[fill & (g == bg)] = paint\n    return out\n\n# --------------- generator (attempt 2 refined middle-fill) ---------------\n\nBG = 0\nWALL = 8\nPAINT_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]\n\n# Canvas bounds used by the observed evaluation examples.\nROW_MIN = 22\nROW_MAX = 29\nCOL_MIN = 24\nCOL_MAX = 28\n\n# Room-grid geometry and room-count filters.\nROOM_SIZE_RANGE = range(3, 6)\nROOM_GRID_RANGE = range(1, 8)\nBLOCK_ROOM_MIN = 3\nBLOCK_ROOM_MAX = 14\nTOTAL_ROOM_MIN = 7\nTOTAL_ROOM_MAX = 22\nGAP_RANGE = range(3, 8)\nORIENTATIONS = (\"vertical\", \"horizontal\")\n\n# Coarse layout and final route validation thresholds.\nLAYOUT_DISTANCE_MIN = 36\nLAYOUT_DISTANCE_FLOORS = [36, 42, 48, 54, 60]\nSHORTEST_DISTANCE_MIN = 36\nSHORTEST_DISTANCE_MAX = 72\nTURN_MIN = 8\nTURN_MAX = 21\nON_ROUTE_ROOM_MIN = 6\nON_ROUTE_ROOM_MAX = 14\nOFF_ROUTE_ROOM_MIN = 1\nOFF_ROUTE_ROOM_MAX = 8\n\n# Connector sampling: offset connectors create the observed middle fill region.\nOFFSET_CONNECTOR_PROB = 0.60\nCONNECTOR_CHOICE_TRIES = 300\nCONNECTOR_DELTA_MAX = 12\nCONNECTOR_DELTA_MIN_CAP = 5\n\n","exit_code":0,"status":"completed"}}
