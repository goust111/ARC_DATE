{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/6165ea8f.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords, colors_present, find_components, get_bg, paste, random_free_location\nimport random\n\n\ndef _tight_mask(mask: np.ndarray) -> np.ndarray:\n    coords = np.argwhere(mask)\n    assert coords.size, \"expected a nonempty mask\"\n    r0, c0, r1, c1 = bbox_coords(coords)\n    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)\n\n\ndef _mask_key(mask: np.ndarray) -> tuple[str, ...]:\n    return tuple(\"\".join(\"1\" if cell else \"0\" for cell in row) for row in mask)\n\n\ndef _shape_signature(mask: np.ndarray) -> tuple[str, ...]:\n    base = _tight_mask(mask)\n    variants = []\n    for k in range(4):\n        rotated = np.rot90(base, k)\n        variants.append(_mask_key(_tight_mask(rotated)))\n        variants.append(_mask_key(_tight_mask(np.fliplr(rotated))))\n    return min(variants)\n\n\ndef _legend_order(g: np.ndarray, bg: int) -> list[int]:\n    labels: list[tuple[int, int]] = []\n    W = g.shape[1]\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, min_area=1):\n        if int(comp[\"area\"]) != 1:\n            continue\n        r, c = map(int, comp[\"coords\"][0])\n        if c == W - 1:\n            labels.append((r, int(comp[\"color\"])))\n\n    labels.sort()\n    assert labels, \"expected a right-edge color legend\"\n    assert [r for r, _color in labels] == list(range(len(labels))), \"legend must start at the top edge\"\n\n    order = [color for _r, color in labels]\n    assert len(order) == len(set(order)), \"legend colors must be unique\"\n    assert set(order) == set(colors_present(g, exclude={bg})), \"legend must list every foreground color\"\n    return order\n\n\ndef _main_object_mask(g: np.ndarray, bg: int, color: int) -> np.ndarray:\n    comps = find_components(\n        g,\n        bg=bg,\n        connectivity=4,\n        monochromatic=True,\n        colors=[color],\n        min_area=1,\n    )\n    main = [comp for comp in comps if int(comp[\"area\"]) > 1]\n    label = [\n        comp\n        for comp in comps\n        if int(comp[\"area\"]) == 1 and int(comp[\"coords\"][0][1]) == g.shape[1] - 1\n    ]\n    assert len(main) == 1, \"expected exactly one main object for each legend color\"\n    assert len(label) == 1, \"expected exactly one right-edge singleton label for each legend color\"\n    assert len(comps) == 2, \"each legend color should appear only as one object and one label\"\n\n    r0, c0, r1, c1 = main[0][\"bbox\"]\n    return g[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(color)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Build a color-labeled shape-equivalence table from the objects listed on the right edge.\n\n    Input structure:\n    - The background contains one main 4-connected object for each foreground color.\n    - The rightmost column has one singleton pixel of each foreground color, listed top-to-bottom.\n    - Those singleton pixels define the row and column order of the output table.\n\n    Rule:\n    - Normalize each main object to its tight mask and compare masks up to rotation or reflection.\n    - Draw 2x2 color labels across the top and down the left, separated by one background row/column.\n    - For each off-diagonal table cell, paint a 2x2 red block when the two labeled objects have the same shape under rotation/reflection, otherwise paint a 2x2 grey block.\n    - Leave diagonal cells and all separators as background.\n\n    Key insight:\n    - Object positions and original orientations are distractors; the relation is dihedral shape equivalence, while the right-edge legend fixes the table order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    order = _legend_order(g, bg)\n    signatures = {color: _shape_signature(_main_object_mask(g, bg, color)) for color in order}\n\n    n = len(order)\n    out = np.full((3 * n + 2, 3 * n + 2), int(bg), dtype=int)\n\n    for i, color in enumerate(order):\n        band = 3 + 3 * i\n        out[0:2, band : band + 2] = int(color)\n        out[band : band + 2, 0:2] = int(color)\n\n    for i, row_color in enumerate(order):\n        for j, col_color in enumerate(order):\n            if i == j:\n                continue\n            cell_color = Color.RED if signatures[row_color] == signatures[col_color] else Color.GREY\n            r = 3 + 3 * i\n            c = 3 + 3 * j\n            out[r : r + 2, c : c + 2] = int(cell_color)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and object bounds.\nGEN_OBJECT_COUNT_RANGE, GEN_GRID_ROW_RANGE, GEN_GRID_COL_RANGE = (4, 7), (20, 25), (20, 23)\nGEN_OBJECT_AREA_RANGE, GEN_OBJECT_BBOX_RANGE, GEN_OBJECT_MAX_EXTRA_CELLS = (5, 13), (2, 7), 4\n# Shape-class sampling.\nGEN_CLASS_OPTIONS, GEN_MAX_CLASS_SIZE, GEN_UNIQUE_MASK_RETRIES = (2, 3), 3, 80\nGEN_DIHEDRAL_FLIP_PROB = 0.5\n# Output table layout and colors.\nGEN_OBJECT_COLORS, GEN_TABLE_BLOCK, GEN_TABLE_STEP = [1, 3, 4, 6, 7, 8, 9], 2, 3\nGEN_SAME_SHAPE_COLOR, GEN_DIFFERENT_SHAPE_COLOR = int(Color.RED), int(Color.GREY)\n# Input placement and retry limits.\nGEN_RESERVED_RIGHT_COLS, GEN_ATTEMPTS = 2, 300\nGEN_PLACEMENT_BORDER, GEN_PLACEMENT_PADDING, GEN_PLACEMENT_CONNECTIVITY = 1, 2, 4\nGEN_NEIGHBORS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _gen_tight_mask(mask: np.ndarray) -> np.ndarray:\n    coords = np.argwhere(mask)\n    r0, c0, r1, c1 = bbox_coords(coords)\n    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)\n\n\ndef _gen_mask_key(mask: np.ndarray) -> tuple[str, ...]:\n    return tuple(\"\".join(\"1\" if cell else \"0\" for cell in row) for row in mask)\n\n\ndef _gen_shape_signature(mask: np.ndarray) -> tuple[str, ...]:\n    base = _gen_tight_mask(mask)\n    variants = []\n    for k in range(4):\n        rotated = np.rot90(base, k)\n        variants.append(_gen_mask_key(_gen_tight_mask(rotated)))\n        variants.append(_gen_mask_key(_gen_tight_mask(np.fliplr(rotated))))\n    return min(variants)\n\n\ndef _has_hole(mask: np.ndarray) -> bool:\n    bg = ~mask.astype(bool)\n    if not bool(bg.any()):\n        return False\n\n    H, W = bg.shape\n    seen = np.zeros_like(bg, dtype=bool)\n    stack: list[tuple[int, int]] = []\n    for r in range(H):\n        for c in (0, W - 1):\n            if bg[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                stack.append((r, c))\n    for c in range(W):\n        for r in (0, H - 1):\n            if bg[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                stack.append((r, c))\n\n    while stack:\n        r, c = stack.pop()\n        for dr, dc in GEN_NEIGHBORS_4:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and bg[nr, nc] and not seen[nr, nc]:\n                seen[nr, nc] = True\n                stack.append((nr, nc))\n    return bool((bg & ~seen).any())\n\n\ndef _random_corner_path(h: int, w: int) -> np.ndarray:\n    starts = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]\n    sr, sc = random.choice(starts)\n    er, ec = h - 1 - sr, w - 1 - sc\n    moves = [(1 if er > sr else -1, 0)] * (h - 1)\n    moves += [(0, 1 if ec > sc else -1)] * (w - 1)\n    random.shuffle(moves)\n\n    mask = np.zeros((h, w), dtype=bool)\n    r, c = sr, sc\n    mask[r, c] = True\n    for dr, dc in moves:\n        r += dr\n        c += dc\n        mask[r, c] = True\n    return mask\n\n\ndef _growth_candidates(mask: np.ndarray) -> list[tuple[int, int]]:\n    h, w = mask.shape\n    choices = []\n    for r in range(h):\n        for c in range(w):\n            if mask[r, c]:\n                continue\n            touches = sum(\n                0 <= r + dr < h and 0 <= c + dc < w and mask[r + dr, c + dc]\n                for dr, dc in GEN_NEIGHBORS_4\n            )\n            if touches != 1:\n                continue\n            trial = mask.copy()\n            trial[r, c] = True\n            if not _has_hole(trial):\n                choices.append((r, c))\n    return choices\n\n\ndef _random_mask() -> np.ndarray | None:\n    area = random.randint(*GEN_OBJECT_AREA_RANGE)\n    pairs = [\n        (h, w)\n        for h in range(GEN_OBJECT_BBOX_RANGE[0], GEN_OBJECT_BBOX_RANGE[1] + 1)\n        for w in range(GEN_OBJECT_BBOX_RANGE[0], GEN_OBJECT_BBOX_RANGE[1] + 1)\n        if h + w - 1 <= area <= h * w\n        and area - (h + w - 1) <= GEN_OBJECT_MAX_EXTRA_CELLS\n    ]\n    h, w = random.choice(pairs)\n    mask = _random_corner_path(h, w)\n\n    while int(mask.sum()) < area:\n        choices = _growth_candidates(mask)\n        if not choices:\n            return None\n        r, c = random.choice(choices)\n        mask[r, c] = True\n    return mask\n\n\ndef _class_sizes(n: int) -> list[int]:\n    k = random.choice([k for k in GEN_CLASS_OPTIONS if k <= n <= GEN_MAX_CLASS_SIZE * k])\n    sizes = [1] * k\n    for _ in range(n - k):\n        open_slots = [i for i, size in enumerate(sizes) if size < GEN_MAX_CLASS_SIZE]\n        sizes[random.choice(open_slots)] += 1\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _unique_canonical_masks(class_count: int) -> list[np.ndarray] | None:\n    canonical_masks: list[np.ndarray] = []\n    signatures: set[tuple[str, ...]] = set()\n    for _ in range(class_count):\n        for _ in range(GEN_UNIQUE_MASK_RETRIES):\n            mask = _random_mask()\n            if mask is None:\n                continue\n            sig = _gen_shape_signature(mask)\n            if sig in signatures:\n                continue\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/b1986d4b.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/b1986d4b.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _square_objects(g: np.ndarray, bg: int) -> list[dict]:\n    objects = []\n    for obj in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        if h == w and h >= 2 and int(obj[\"area\"]) == h * w:\n            objects.append({\"side\": int(h), \"color\": int(obj[\"color\"]), \"bbox\": obj[\"bbox\"]})\n    return objects\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Render the filled-square object counts as compact nested stacks ordered by count rank.\n\n    Input structure\n    A large noisy grid has a dominant background, scattered non-square noise, and\n    filled monochrome square objects. Each square side length has exactly one\n    object color, and side lengths form consecutive sizes.\n\n    Rule\n    Ignore non-square components. If the lowest square in the scene is of the\n    smallest side length, treat that one smallest square as a distractor and do\n    not count it. For count rank k from left to right, create one block from all\n    square sizes with at least k remaining objects; draw larger squares first and\n    smaller squares over their upper-left corner, then append one background\n    separator column.\n\n    Key insight\n    The output is a count histogram of square side lengths, but each histogram\n    slot is rendered as nested upper-left square masks using the side colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    objects = _square_objects(g, bg)\n    assert objects, \"expected filled square objects\"\n\n    sides = sorted({obj[\"side\"] for obj in objects})\n    assert sides == list(range(sides[0], sides[-1] + 1)), \"expected consecutive square side lengths\"\n\n    by_side = {side: [obj for obj in objects if obj[\"side\"] == side] for side in sides}\n    colors = {}\n    for side, side_objects in by_side.items():\n        side_colors = {obj[\"color\"] for obj in side_objects}\n        assert len(side_colors) == 1, \"each side length should have one color\"\n        colors[side] = side_colors.pop()\n\n    smallest = sides[0]\n    lowest_row = max(obj[\"bbox\"][2] for obj in objects)\n    lowest_smallest = [obj for obj in by_side[smallest] if obj[\"bbox\"][2] == lowest_row]\n    if lowest_smallest:\n        assert len(lowest_smallest) == 1, \"expected at most one lowest smallest distractor\"\n        drop_bbox = lowest_smallest[0][\"bbox\"]\n        by_side[smallest] = [obj for obj in by_side[smallest] if obj[\"bbox\"] != drop_bbox]\n\n    counts = {side: len(side_objects) for side, side_objects in by_side.items()}\n    assert all(count > 0 for count in counts.values()), \"each square size should remain represented\"\n\n    out_h = sides[-1] + 1\n    groups = []\n    for rank in range(max(counts.values())):\n        present_sides = [side for side in sides if counts[side] > rank]\n        assert present_sides, \"rank should contain at least one square size\"\n\n        group_w = max(present_sides)\n        group = np.full((out_h, group_w), bg, dtype=int)\n        for side in sorted(present_sides, reverse=True):\n            group[:side, :side] = colors[side]\n        groups.append(group)\n\n    out_w = sum(group.shape[1] + 1 for group in groups)\n    out = np.full((out_h, out_w), bg, dtype=int)\n    c = 0\n    for group in groups:\n        w = group.shape[1]\n        out[:, c : c + w] = group\n        c += w + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nSIDES = [2, 3, 4]\nALL_COLORS = list(range(10))\n\n# Canvas and object bounds.\nGRID_SIZE_RANGE = (25, 28)\nCOUNT_RANGE = (2, 6)\nSQUARE_GAP = 1\n\n# Noise and distractor controls.\nDISTRACTOR_PROB = 0.5\nNOISE_COUNT_RANGE = (40, 70)\n\n# Retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _choose_palette() -> tuple[int, dict[int, int], int]:\n    \"\"\"Choose one background, three square colors, and one noise color.\"\"\"\n    bg = random.choice(ALL_COLORS)\n    non_bg = [c for c in ALL_COLORS if c != bg]\n    random.shuffle(non_bg)\n    square_colors = {side: non_bg[i] for i, side in enumerate(SIDES)}\n    return bg, square_colors, non_bg[len(SIDES)]\n\n\ndef _make_square_queue(\n    counts: dict[int, int], square_colors: dict[int, int], has_distractor: bool\n) -> tuple[list[tuple[int, int]], tuple[int, int] | None]:\n    \"\"\"Return regular squares plus the separately placed distractor candidate.\"\"\"\n    squares = [(side, square_colors[side]) for side in SIDES for _ in range(counts[side])]\n    if has_distractor:\n        squares.append((SIDES[0], square_colors[SIDES[0]]))\n\n    random.shuffle(squares)\n    if not has_distractor:\n        return squares, None\n    return squares[:-1], squares[-1]\n\n\ndef _free_positions(occupied: np.ndarray, side: int, min_r: int = 0) -> list[tuple[int, int]]:\n    \"\"\"List top-left positions whose padded square footprint is unoccupied.\"\"\"\n    H, W = occupied.shape\n    valid = []\n    for r in range(min_r, H - side + 1):\n        for c in range(0, W - side + 1):\n            r0 = max(0, r - SQUARE_GAP)\n            r1 = min(H, r + side + SQUARE_GAP)\n            c0 = max(0, c - SQUARE_GAP)\n            c1 = min(W, c + side + SQUARE_GAP)\n            if not occupied[r0:r1, c0:c1].any():\n                valid.append((r, c))\n    return valid\n\n\ndef _mark_occupied(occupied: np.ndarray, r: int, c: int, side: int) -> None:\n    H, W = occupied.shape\n    r0 = max(0, r - SQUARE_GAP)\n    r1 = min(H, r + side + SQUARE_GAP)\n    c0 = max(0, c - SQUARE_GAP)\n    c1 = min(W, c + side + SQUARE_GAP)\n    occupied[r0:r1, c0:c1] = True\n\n\ndef _place_square(\n    grid: np.ndarray,\n    occupied: np.ndarray,\n    placed: list[tuple[int, int, int, int]],\n    side: int,\n    color: int,\n    positions: list[tuple[int, int]] | None = None,\n) -> bool:\n    \"\"\"Place one square at a random valid position and update grid state.\"\"\"\n    valid = _free_positions(occupied, side) if positions is None else positions\n    if not valid:\n        return False\n    r, c = random.choice(valid)\n    grid[r:r + side, c:c + side] = color\n    _mark_occupied(occupied, r, c, side)\n    placed.append((r, c, side, color))\n    return True\n\n\ndef _place_squares(\n    grid: np.ndarray,\n    occupied: np.ndarray,\n    regular_squares: list[tuple[int, int]],\n    distractor_sq: tuple[int, int] | None,\n) -> list[tuple[int, int, int, int]] | None:\n    \"\"\"Place all squares, requiring any distractor to sit below the others.\"\"\"\n    placed = []\n\n    random.shuffle(regular_squares)\n    for side, color in regular_squares:\n        if not _place_square(grid, occupied, placed, side, color):\n            return None\n\n    if distractor_sq is None:\n        return placed\n\n    d_side, d_color = distractor_sq\n    current_max_bottom = max(r + side - 1 for r, _, side, _ in placed) if placed else -1\n    min_r = max(0, current_max_bottom - d_side + 2)\n    valid = [\n        (r, c)\n        for r, c in _free_positions(occupied, d_side, min_r=min_r)\n        if r + d_side - 1 > current_max_bottom\n    ]\n    if not _place_square(grid, occupied, placed, d_side, d_color, valid):\n        return None\n    return placed\n\n\ndef _add_noise(grid: np.ndarray, bg: int, noise_color: int) -> bool:\n    \"\"\"Scatter noise onto background cells only.\"\"\"\n    free_cells = list(zip(*np.where(grid == bg)))\n    num_noise = random.randint(*NOISE_COUNT_RANGE)\n    if len(free_cells) < num_noise:\n        return False\n    random.shuffle(free_cells)\n    for r, c in free_cells[:num_noise]:\n        grid[r, c] = noise_color\n    return True\n\n\ndef _would_trigger_unintended_distractor(placed: list[tuple[int, int, int, int]]) -> bool:\n    \"\"\"Detect no-distractor samples where the solver would drop a small square.\"\"\"\n    lowest_row = max(r + side - 1 for r, _, side, _ in placed)\n    return any(side == SIDES[0] and r + side - 1 == lowest_row for r, _, side, _ in placed)\n\n\ndef _render_expected_output(\n    bg: int, counts: dict[int, int], square_colors: dict[int, int]\n) -> np.ndarray:\n    \"\"\"Render the count-derived oracle output used to validate samples.\"\"\"\n    out_h = SIDES[-1] + 1\n    groups = []\n    for rank in range(max(counts.values())):\n        present_sides = [side for side in SIDES if counts[side] > rank]\n        group = np.full((out_h, max(present_sides)), bg, dtype=int)\n        for side in sorted(present_sides, reverse=True):\n            group[:side, :side] = square_colors[side]\n        groups.append(group)\n\n    out_w = sum(group.shape[1] + 1 for group in groups)\n    out = np.full((out_h, out_w), bg, dtype=int)\n    c = 0\n    for group in groups:\n        w = group.shape[1]\n        out[:, c:c + w] = group\n        c += w + 1\n    return out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg, square_colors, noise_color = _choose_palette()\n    counts = {side: random.randint(*COUNT_RANGE) for side in SIDES}\n    has_distractor = random.random() < DISTRACTOR_PROB\n    regular_squares, distractor_sq = _make_square_queue(counts, square_colors, has_distractor)\n\n    H = random.randint(*GRID_SIZE_RANGE)\n    W = random.randint(*GRID_SIZE_RANGE)\n    grid = np.full((H, W), bg, dtype=int)\n    occupied = np.zeros((H, W), dtype=bool)\n\n    placed = _place_squares(grid, occupied, regular_squares, distractor_sq)\n    if placed is None or not _add_noise(grid, bg, noise_color):\n        return None\n\n    if not has_distractor and _would_trigger_unintended_distractor(placed):\n        return None\n\n","exit_code":0,"status":"completed"}}
