lsewhere outside the frame sit one sprite template per source color and one compact two-color\\n  legend per source color.\"\n/home/lixinyu/snap/new/tmp/review_summary_53fb4810.md:26:| D4 | 1 | 箭头形精灵 | pass | pass | pass | pass | pass | none |  |\n/home/lixinyu/snap/new/arc-agi-2-eval-annotations-merge.json:96:    \"src\": \"triangular arrow\",\n/home/lixinyu/snap/new/arc-agi-2-eval-annotations-merge.json:97:    \"path\": \"along the diagonal line pointed by the arrow then reflected by the wall\",\n/home/lixinyu/snap/new/arc-agi-2-eval-annotations-merge.json:144:    \"path\": \"blue pixels \\\"water channel\\\" that is wide enough to pass through until \\\"stuck\\\" because of too narrow\",\n/home/lixinyu/snap/new/arc-agi-2-eval-annotations-merge.json:145:    \"dst\": \"reach same sized red square or \\\"get stuck\\\" on the way where the blue path is too narrow\",\n/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py:375:MIN_CANVAS_W = 8                # reject if canvas narrower than this\n/home/lixinyu/snap/new/ARC_code/eval/6e453dd6.py:192:    # Optionally split into a narrower mini section + main section,\n/home/lixinyu/snap/new/ARC_code/eval/6e453dd6.py:213:        # Top = mini (narrower), bottom = main (full width)\n/home/lixinyu/snap/new/ARC_code/eval/6e453dd6.py:224:        # Top = main (full width), bottom = mini (narrower)\n/home/lixinyu/snap/new/ARC1_code/eval/22a4bbc2.py:104:    narrow_i = int(np.random.randint(len(heights)))\n/home/lixinyu/snap/new/ARC1_code/eval/22a4bbc2.py:108:        if i == narrow_i:\n/home/lixinyu/snap/new/tmp/combo_exec_a6f40cea_20260503_090135/report.md:12:| a6f40cea | 40 | D1/3+D3/0+D4/3+D5/0 | 全网格箭头射线 | D3/0, D5/0 | 50/50 | ✓（审查后修复） |\n/home/lixinyu/snap/new/tmp/combo_exec_a6f40cea_20260503_090135/report.json:655:    \"name\": \"全网格箭头射线\",\n/home/lixinyu/snap/new/tmp/combo_exec_a6f40cea_20260503_090135/report.json:660:    \"description\": \"全网格输出中，箭头精灵替代开放框，路径为纯直线从触点沿箭头方向贯穿到对边。保持原始尺寸同时可见箭头和内部射线，视觉关联增强。\",\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:103:    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:169:\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\n/home/lixinyu/snap/new/tmp/combo_exec_16b78196_merged_report.json:1405:    \"name\": \"终止标记精灵+方向箭头\",\n/home/lixinyu/snap/new/tmp/combo_exec_16b78196_merged_report.json:1410:    \"description\": \"链终止由特殊颜色的终止精灵标记（灰色精灵插入后链结束），有效缺口旁有箭头状标记指示链的生长方向。solver需：(1)解读缺口旁的方向标记确定链生长朝向，(2)识别终止精灵的特殊语义，(3)在方向标记指引下按序拼装直到遇到终止标记。两种符号系统协同工作：箭头指引开始和方向，特殊色指示结束。\",\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:7:    Trace diagonal rays from triangular arrows, reflecting off colored wall pixels.\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:10:    - bg grid with monochrome 3-pixel L-shaped \"arrows\" (2x2 bbox missing one corner) and scattered colored wall pixels.\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:13:    - Each arrow fires a ray diagonally away from its missing corner, painting bg cells in its color.\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:16:    - Ray stops when it exits the grid or reaches another arrow.\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:24:    def is_arrow_pts(pts: list[tuple[int, int]]) -> bool:\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:31:    def arrow_dir_and_start(pts: list[tuple[int, int]]):\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:54:    # Detect arrows per-color (cannot rely on global non-bg connectivity).\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:55:    arrow_cells: set[tuple[int, int]] = set()\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:56:    arrows: list[tuple[int, list[tuple[int, int]]]] = []\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:60:            if is_arrow_pts(pts):\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:61:                arrows.append((int(col), pts))\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:62:                arrow_cells |= set(pts)\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:65:        (int(r), int(c)) for r, c in np.argwhere(g != int(bg)) if (int(r), int(c)) not in arrow_cells\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:70:    for start_col, pts in arrows:\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:71:        info = arrow_dir_and_start(pts)\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:99:            if (nr, nc) in arrow_cells:\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:143:    Output-first: for each arrow, plan the full zigzag ray path (with 0-4 side-touch\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:144:    bounces), place walls at bounce points, then derive the input (arrows + walls).\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:147:    n_arrows = _rng.randint(1, 7)\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:150:    arrow_colors = palette[:n_arrows]\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:156:    for ai in range(n_arrows):\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:157:        color = arrow_colors[ai]\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:163:            # Start position with room for the 2x2 arrow bbox\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:172:            arrow_pts = [(r, c) for r in (mr, sr) for c in (mc, sc) if (r, c) != (mr, mc)]\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:173:            if any(not (0 <= r < H and 0 <= c < W) or (r, c) in occupied for r, c in arrow_pts):\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:181:            arrow_set = set(arrow_pts)\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:203:                    if (nr, nc) in occupied or (nr, nc) in ray_set or (nr, nc) in arrow_set:\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:240:                    if any((r, c) in occupied or (r, c) in ray_set or (r, c) in arrow_set\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:266:            new_cells = set(arrow_pts) | ray_set\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:269:            expected_count = len(arrow_pts) + len(ray_cells) + sum(len(w) for w, _ in walls)\n/home/lixinyu/snap/new/ARC_code/eval/142ca369.py:274:            for r, c in arrow_pts:\n/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py:22:    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py:216:    narrow_w = random.randint(1, n - 1)\n/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py:217:    remove = n - narrow_w\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:39:    - bg background; rectangular frame on right with colored markers on its edges; sprites in a narrow left strip separated by a constant-color divider column.\n/home/lixinyu/snap/new/ARC_code/eval/5545f144.py:196:    - Each frame: a triangular arrow-shaped sprite and scattered single-pixel markers, all one color.\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:11:# In the input, you will see several objects of the same color that are in an arrowhead shape and facing different directions.\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:12:# The goal is to find the directions of the arrowheads and draw lines that would represent the path they had been moving in to go in that direction.\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:16:    Extend each small arrowhead with a line in the direction it points.\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:19:    - The input is a black grid with several same-colored arrowhead objects.\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:20:    - Each arrowhead is a small shape whose missing corner indicates its direction.\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:21:    - Lines should use the arrowhead color.\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:24:    - Crop each arrowhead and compare the mean positions of colored and black cells.\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:26:    - Draw a line from the matching outer corner of the arrowhead's bounding box to the grid edge.\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:29:    - The arrowhead asymmetry identifies both the direction of travel and the corner where the path begins.\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:37:    # for each object, find the direction the arrowhead is pointing in by finding the relative mean position of colored and black pixels in the bounding box of the object\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:60:        # find the direction the arrowhead is pointing in, it is from the mean position of the colored pixels to the mean position of the black pixels\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:63:        # draw a line in the direction the arrowhead is pointing in from the corresponding corner of the bounding box\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:70:            # check if the corner is in the direction that the arrowhead is pointing\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:81:    # choose the color of the arrowheads\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:84:    # make the arrowheads by making a 2x2 square then removing one of the corners randomly and placing it randomly on the grid\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:86:        # make at arrowhead\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:87:        arrowhead = np.full((2, 2), color)\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:89:        arrowhead[corner // 2, corner % 2] = Color.BLACK\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:92:        _loc = first_free_location(grid, arrowhead, transparent=Color.BLACK, border=0, padding=1, padding_connectivity=8)\n/home/lixinyu/snap/new/ARC1_code/train/6e19193c.py:96:        paste(grid, arrowhead, r, c, transparent=Color.BLACK, clip=True)\n/home/lixinyu/snap/new/ceshi/code_combo/2d0172a1/28/code.py:29:#    2x4 horizontal arrow, a near-square inner frame, and a 4x2 vertical arrow, the\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:3:# Name: 箭头指示方向+L形框架\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:12:  3-pixel L-triomino arrow placed just outside one side of that cup.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:14:  visual L frame, either endpoint could be the ejecting endpoint; the nearby arrow\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:22:     endpoint on the side indicated by the external arrow component. The content\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:24:     the arrow-selected endpoint is first.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:26:     a straight line from that endpoint in the arrow-indicated direction.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:29:  - direction cue changed: inferred from shape -> read from nearby arrow component\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:33:- The arrow vocabulary is tiny: one fixed 3-cell 2x2-L component, placed on one of\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:37:  three leg relations for the arrow-selected endpoint: shorter, equal, and longer\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:38:  than the other endpoint's first leg. Equal-leg cups especially force the arrow\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:44:  each cup color appears as two components, the body and its arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:48:  construction; the arrow can choose the longer endpoint or an equal-leg case.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:50:  1. find L-body components and L-arrow components separately,\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:51:  2. pair an L body with the unique same-color arrow lying completely beyond one\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:53:  3. orient the body path so that its tail direction matches that arrow side,\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:58:- The generator builds each cup output-first: body + arrow + ejection line, then\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:60:- Cup+arrow combo bboxes keep a 1-cell gap from each other via dilated placement.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:68:  output line leaves from the endpoint nearest the small same-color arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:69:- Because equal-leg and arrow-to-longer-endpoint cases are common, shape-only\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:70:  explanations fail; the arrow is the only stable cue.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:74:- The arrow is kept close to its cup but separated by at least one empty row/col,\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:76:- The arrow is offset away from the exact ejection ray, so it remains visible in\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:81:- No color remapping is introduced. The arrow simply reuses the cup border color.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:83:  border colors, so humans and the solver can associate each arrow to its cup by\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:88:- Assumption: each cup border color has exactly one L-body component and one arrow\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:90:- Assumption: the arrow lies completely beyond exactly one side of the cup body's\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:92:  arrow templates.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:94:  has a tail direction matching the arrow side. Guaranteed by how each cup is built.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:235:def _is_arrow_component(cell_set: set[tuple[int, int]]) -> bool:\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:242:def _arrow_side(\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:243:    arrow_cells: set[tuple[int, int]],\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:246:    ar0, ac0, ar1, ac1 = _component_bbox(arrow_cells)\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:266:      same-color 3-cell arrow component on one side.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:267:    - The arrow side selects which endpoint of the L is the spike.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:269:      endpoint in the arrow-indicated direction.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:282:        arrow_components = [comp for comp in comps if _is_arrow_component(comp)]\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:293:            matched_arrows = []\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:294:            for arrow_set in arrow_components:\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:295:                side = _arrow_side(arrow_set, body_bbox)\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:297:                    matched_arrows.append((side, arrow_set))\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:298:            if len(matched_arrows) != 1:\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:301:            tail_dir = matched_arrows[0][0]\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:422:def _arrow_templates_for_body(\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:460:def _attach_arrow(\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:469:    arrow_template = _arrow_templates_for_body(tail_dir, spike, body_patch.shape)[int(rng.integers(0, 2))]\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:470:    arrow_coords = [(spike[0] + dr, spike[1] + dc) for dr, dc in arrow_template]\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:472:    all_coords = body_coords + arrow_coords\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:481:    for r, c in arrow_coords:\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/8/code.py:616:    patch, spike, mouth, body_bbox_local = _attach_arrow(\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:3:# Name: 箭头方向+矩形框架+边缘控制像素\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:29:       2. tail direction comes from a same-color 3-pixel L arrow attached beside the closed side,\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:32:   - Small trace: suppose a cup body is a tail-up rectangle, with a small same-color arrow above it and\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:34:     arrow conceptually, recognize the remaining component as an upward rectangular cup, infer UP from\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:35:     the arrow placement, count the four orange edge controls, erase those controls, and draw four orange\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:43:   - The arrow is fixed to a 3-cell L triomino, reused across all examples, so direction remains\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:52:   - \"Full component equals cup body\" is false because the arrow is attached to the border component.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:57:       1. enumerate 3-cell L arrow candidates on each border component,\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:59:       3. infer direction from the arrow side relative to the recovered cup bbox,\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:65:     controls never overlap the cup itself. The arrow may approach or touch a non-control border side;\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:67:   - Cup+arrow components keep at least a 1-cell gap from each other via 8-neighborhood dilation.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:68:   - Ejection rays are reserved globally so no cup body, arrow, or later ray occupies another ray.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:73:   - Across examples a human sees: empty rectangular cups, same-color arrows attached near the closed\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:76:   - Direction is not encoded by numeric color id; it is visible from local arrow placement.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:83:   - The arrow sits off the ejection ray, so it remains visible in both input and output.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:87:     directly visible: the cup geometry is rectangular, direction is a local arrow marker, and the\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:92:   - Assumption: each relevant border component contains exactly one removable 3-cell L arrow whose\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:93:     removal yields an exact rectangular cup. Guaranteed by `_attach_arrow`.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:94:   - Assumption: the arrow lies completely outside exactly one side of the recovered cup bbox. Guaranteed\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:95:     by the fixed arrow templates.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:190:def _enumerate_arrow_candidates(border_set: set[tuple[int, int]]) -> list[set[tuple[int, int]]]:\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:243:def _arrow_side(arrow_cells: set[tuple[int, int]], cup_bbox: tuple[int, int, int, int]) -> str | None:\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:244:    ar0, ac0, ar1, ac1 = bbox_coords(np.array(sorted(arrow_cells), dtype=int))\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:272:    \"\"\"Recover the cup body by stripping one arrow candidate from the merged component.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:274:    for arrow_cells in _enumerate_arrow_candidates(border_set):\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:275:        cup_set = border_set - arrow_cells\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:280:        tail_dir = _arrow_side(arrow_cells, cup_bbox)\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:299:                \"arrow_cells\": set(arrow_cells),\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:335:    - A same-color 3-pixel arrow attached beside the closed side tells the ejection direction.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:472:def _attach_arrow(\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:479:    \"\"\"Attach the same-color L arrow beside the closed side of the rectangular cup.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:481:    arrow_template = ARROW_OFFSETS[direction][int(rng.integers(0, 2))]\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:482:    arrow_coords = [(spike[0] + dr, spike[1] + dc) for dr, dc in arrow_template]\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:484:    all_coords = border_coords + arrow_coords\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:493:    for r, c in arrow_coords:\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:536:    \"\"\"Place the combined cup+arrow patch away from the border with a clear reserved ray.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/37/code.py:664:    patch, spike, cup_bbox_local = _attach_arrow(rng, patch_body, spike_body, direction, border_color)\n/home/lixinyu/snap/new/ARC_code/train/689c358e.py:73:    Mark each arrow-like sprite's pointed frame endpoint with its color and the opposite endpoint black.\n/home/lixinyu/snap/new/ARC_code/train/689c358e.py:77:    - Inside the frame are monochrome six-pixel sprites shaped as asymmetric T arrows.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:3:# Name: 箭头指示方向+矩形框架\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:6:Fusion variant of 3dc255db: rectangular 3-sided cups plus detached arrow markers.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:18:     detached same-color 3-pixel L arrow sits just outside one of the frame's closed sides. The\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:19:     mouth is determined from the open side; the spike is the center pixel of the arrow-indicated\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:21:   - Example: a 5x5 frame open downward can now eject upward, leftward, or rightward. If the arrow\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:28:   - The arrow vocabulary is small: a detached 3-cell L triomino, with two offset variants per\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:36:     border color is split across a frame component and a detached arrow component.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:38:     opening only determines the mouth; the arrow chooses among the three closed sides.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:40:     side, not from the side opposite the arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:43:       2. the associated arrow is a detached 3-cell 2x2-L component of the same color;\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:44:       3. the arrow lies exactly one blank cell beyond one frame side and overlaps that side's\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:50:   - Generator builds the output state first: cup frame + detached arrow + ejected line.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:51:   - Combined occupied cells of cup and arrow keep an 8-neighborhood gap from other cups/arrows.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:54:   - The arrow is offset away from the ray, so the output line never overwrites the marker.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:58:   - The detached arrow is plainly visible on one closed side, so humans can see that ejection is\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:65:   - Cups, arrows, and rays are kept disjoint across objects.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:69:   - No new color mapping is introduced. The arrow reuses the frame color, so the association is\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:76:   - Assumption: exactly one nearby L-arrow of the same color lies one cell beyond a closed side.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:77:     Guaranteed by fixed arrow templates and unique border colors per cup.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:211:def _is_l_arrow_component(cells: set[tuple[int, int]]) -> bool:\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:212:    \"\"\"3-cell detached arrow sprite: an L triomino inside a 2x2 bbox.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:232:def _arrow_side(\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:233:    arrow_cells: set[tuple[int, int]],\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:236:    \"\"\"Infer which cup side the detached arrow marks.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:237:    ar0, ac0, ar1, ac1 = (int(v) for v in bbox_coords(np.array(sorted(arrow_cells), dtype=int)))\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:255:    - A detached same-color 3-pixel L arrow picks one closed side as the tail.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:273:        arrow_candidates: list[set[tuple[int, int]]] = []\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:276:            if _is_l_arrow_component(comp_set):\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:277:                arrow_candidates.append(comp_set)\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:315:            for arrow_cells in arrow_candidates:\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:316:                tail_dir = _arrow_side(arrow_cells, bbox)\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:363:def _attach_arrow(\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:370:    \"\"\"Return a combined patch containing the frame and a detached arrow.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:378:    arrow_template = ARROW_OFFSETS[tail_dir][int(rng.integers(0, 2))]\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:379:    arrow_coords = [(spike[0] + dr, spike[1] + dc) for dr, dc in arrow_template]\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:380:    all_coords = body_coords + arrow_coords\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:390:    for r, c in arrow_coords:\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:430:    \"\"\"Place one cup+arrow combo while preserving spacing and a clear ray to the edge.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/7/code.py:538:    combo_patch, spike, mouth, body_bbox_local = _attach_arrow(\n/home/lixinyu/snap/new/ARC1_code/train/0a938d79.py:81:    # make a grid that is narrow and tall. This is for horizontal lines, and we will flip a coin at the end to transpose everything to make things vertical\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/30/code.py:32:#      canvases, so the count range is intentionally narrow.\n/home/lixinyu/snap/new/ceshi/code_combo/78332cb0/1/code.py:31:#      the color-choice hypothesis narrow and repeated across the full training set.\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/33/code.py:36:#    The cascade is intentionally narrow: one ordered chain, one visible comparison key per step, and\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:3:# Name: 带对角标记的精灵+方向箭头标记\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:15:#   a 2-pixel arrow stub made from the transferable payload color,\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:19:#   source.arrow -> dominant-axis direction to the target destination,\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:32:#   in the encoded arrow direction. So arrow direction alone is insufficient.\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:34:#   corners compatible with the chosen arrow direction. This keeps the symbolic alphabet small.\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:42:#   that border class and then resolve the target by arrow direction plus marker quadrant.\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:43:# - The D15-style directional cue is compressed to a 2-pixel center+neighbor arrow stub. That\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:46:#   3-pixel arrow while remaining a single readable object.\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:51:# - Sources are always fully visible 3x3 boxes so both the arrow and the diagonal marker are\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:53:# - Source placement is filtered so the two destinations are both in the source's arrow direction\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:58:# - The input visibly contains two deleted source boxes, each with an arrow and an extra corner\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:65:# - The arrow is a compact 2-pixel center+edge pointer, while the marker remains a single corner\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:75:# - For each real source, both destinations share the arrow direction but occupy the two marker\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:152:    assert patch[mr, mc] == border_color, \"marker corner must not overlap the arrow\"\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:409:def _detect_arrow_marker_sources(g: np.ndarray, bg: int, grey: int) -> list[dict]:\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:412:    The payload forms one of four 2-pixel arrow stubs and includes the center cell.\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:413:    The marker is a singleton corner not occupied by the arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:523:    - Each real source box has three simultaneous parts: a shared border color, a 2-pixel payload-colored arrow stub, and one extra diagonal marker pixel in a corner.\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:529:    - Among those same-border candidates, keep the unique source whose arrow points toward the destination and whose diagonal marker corner matches the destination's quadrant relative to that source.\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:533:    - Matching is now layered: the destination center color selects a source border class, the arrow gives a coarse global direction, and the diagonal marker resolves which destination inside that direction cone is the true target.\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:540:    sources = _detect_arrow_marker_sources(g, bg, grey)\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:542:    assert sources, \"expected marked arrow sources\"\n/home/lixinyu/snap/new/ceshi/code_combo/d35bdbdc/17/code.py:770:    sources = _detect_arrow_marker_sources(g, bg, GREY)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:23:      - 每个起点边上紧贴一个箭头色像素, 箭头偏移方向就是初始方向; solver 不再从边界位置硬推方向。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:25:      - 以左侧组件为例, 粒子在 `(r,0)` 且 `(r,1)` 是箭头, 因此先向右。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:32:    - 同一张图里固定出现四条边的起点, 且四个组件共享同一个可见模板, 便于人类从 2-4 个样例里归纳“边缘粒子 + 箭头 + 长路径追踪”。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:33:    - 颜色自由度被压到少量档位: 4 个走廊色、1 个箭头色、1 个背景色、1 个粒子色。颜色不编码隐藏语义, 只承担“同色墙/异色 breaker”的可见结构作用。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:35:    - 原 `_trace` 把初始方向写死为 `right`; 融合后必须改成读取箭头。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:36:    - 原 `_has_corridor` 只把 `{BG, PARTICLE}` 视作可走; 融合后箭头像素必须是可通行的, 否则粒子一出发就撞上标记。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:40:    - D5 与 D15 叠加后的潜在冲突是“方向会不会又退化成由边缘唯一决定”; 这里用显式箭头作为 solver 的唯一方向来源, 代码层面不再读取边的位置来推方向。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:47:    - 人类能直接看到四条边上各有一个品红粒子, 且粒子旁都有同色箭头标记。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:49:    - 规则完全由相邻关系、夹道同色、箭头偏移三种可见线索决定, 不依赖颜色编号或隐式排序。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:51:    - 箭头只出现在起点旁, 不会与内部墙体混在一起。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:58:    - solver 假设有效起点是边界粒子且拥有唯一相邻箭头。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:59:      generator 保证每个真实起点都满足这一点, 且没有额外伪箭头贴在粒子周围。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:134:    \"\"\"Return border particles that have exactly one adjacent arrow marker.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:193:    \"\"\"Move magenta edge particles by following explicit arrows through spiral corridors.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:196:    - bg=7, particle=6, arrow=2.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:198:    - Each valid particle has exactly one adjacent arrow pixel; that offset gives the initial direction.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:202:    - Start each edge particle in the arrow-indicated direction.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:203:    - Move straight through passable cells (`bg`, `particle`, `arrow`).\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:211:      change the tracing rule; only the arrow-selected initial direction changes.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:26:#    - `main()` launch-row detection assumed many bar colors might exist, but its real requirement is narrower:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/28/code.py:82:#   1. narrow lanes move, wide lanes do not;\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/28/code.py:89:# - The scene remains a small set of repeated elements: bar rows, narrow/wide\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/28/code.py:263:    \"\"\"Move magenta particles through dashed narrow corridors with bounded gap crossing.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:19:      - 每个粒子旁边多一个固定颜色的箭头像素; 粒子到箭头像素的相对偏移就是初始方向。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:20:      - 左边起点表现为 `(row,0)=particle, (row,1)=arrow`; 右边是 `(row,W-1)=particle, (row,W-2)=arrow`;\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:21:        顶/底边分别把箭头放在粒子正下/正上。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:24:      - 融合后: 若粒子在顶边 `(0,c_v-1)`, 箭头在 `(1,c_v-1)`, solver 先从箭头偏移读出 `down`,\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:29:    - 箭头只用一个专用颜色, 避免引入额外颜色映射。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:31:    - 箭头保持朝向网格内部的真实通路端点; 若让箭头沿边切向移动, 需要额外边界引导结构, 会把任务改得过重。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:33:    - 原 `_trace` 写死 `right`; 组合后必须改成参数, 且箭头像素必须视为可通行。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:34:    - 原 `main` 只扫描 `col 0`; 组合后必须扫描四条边, 并从唯一相邻箭头恢复方向。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:35:    - 原 `_has_corridor` 只把 `BG/PARTICLE` 当作可通行; 组合后若不把 `ARROW` 也算 passable, 起步时就会被箭头挡住。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:36:    - 原 generator 会无条件铺满 `col 0` 粒子; 组合后绝不能这样做, 否则会覆盖右/顶/底起点和箭头。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:38:    - 新 solver 额外假设: 每个有效边界粒子恰有一个 4 邻箭头。generator 通过专门放置并校验 `_edge_starts` 来保证。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:43:    - 箭头永远落在粒子的内侧相邻可通行格, 不与彩墙重叠, 不越界。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:45:    - 样例中会同时看到左/右/上/下四种边界起点, 且每个起点都带同色箭头标记, 人类可直接归纳“箭头给初始方向”。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:46:    - 输出只移动粒子, 不删除箭头, 因此输入中的起始证据在输出里仍可对照。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:49:    - 箭头只出现在边界起点旁, 不进入内部转弯区, 不与假走廊装饰混叠。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:50:    - 走廊仍是单层结构: 彩条=墙, BG/箭头=可走区域, 品红=被移动对象。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:52:    - 颜色机制只保留原题的“同色夹墙可转弯”; 箭头颜色固定且不参与颜色映射。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:54:    - solver 假设有效起点都在边界且恰有一个箭头邻居; generator 在放置后调用 `_edge_starts` 验证。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:56:    - solver 假设箭头方向确实通向可通行路径; generator 只从 `_candidate_starts_for_plan` 产出的合法端点放置起点。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:118:    \"\"\"Return border particles whose unique adjacent arrow pixel defines the start direction.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:183:    \"\"\"Move arrow-marked edge particles through same-color corridors.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:186:    - bg=7, particle=6, arrow marker=2.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:188:    - Particles may appear on any of the four grid edges, each with exactly one adjacent arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:191:    - The arrow offset relative to a border particle gives its initial direction.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:192:    - The particle moves straight through passable cells (bg, particle, arrow).\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:199:      You must first read each edge particle's adjacent arrow to recover the initial\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:630:def _place_particles_and_arrows(g: np.ndarray, starts: list[tuple[int, int, str]]) -> bool:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:631:    \"\"\"Place particles on the border and their unique adjacent arrow markers.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:633:    arrow_cells: set[tuple[int, int]] = set()\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:641:        if (ar, ac) in arrow_cells:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:645:        arrow_cells.add((ar, ac))\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:709:    if not _place_particles_and_arrows(g, starts):\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/8/code.py:124:    \"\"\"True iff (r,c) is inside a real narrow corridor under the fused rule.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/8/code.py:163:    \"\"\"Move magenta particles through broken narrow corridors.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/8/code.py:174:    - The particle stops at the grid edge or when no valid narrow turn exists.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/8/code.py:178:      the narrow 1-row gap whose two dashed rails are still visible within radius 1, even if\n/home/lixinyu/snap/new/ceshi/code_combo/6ffbe589/6/code.py:74:#      to narrow strips on the middle box / inner box edges.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/11/code.py:43:#    - Free parameters are kept narrow: only three spiral columns vary per path,\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:28:# - The palette remains in the original narrow regime: four non-bg/non-particle\n/home/lixinyu/snap/new/ceshi/code_combo/e12f9a14/43/code.py:68:#       combo outputs differ from a narrow unbounded baseline on the same inputs.\n/home/lixinyu/snap/new/ceshi/code_combo/28a6681f/49/code.py:26:#     The family is intentionally narrow: one basin template, one erasable source component, one\n/home/lixinyu/snap/new/ceshi/code_combo/8b7bacbf/25/code.py:20:#      * The same seed line also touches a U-shaped pocket whose 5-region reaches the top edge through a narrow\n/home/lixinyu/snap/new/ceshi/code_combo/dbff022c/36/code.py:21:#    \"any enclosed hole\" logic is therefore narrowed to \"interiors of detected rectangle\n/home/lixinyu/snap/new/ceshi/code_combo/28a6681f/18/code.py:35:#    - The basin family is deliberately narrow: two adjacent cups with an optional overflow divider.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/25/code.py:35:#    - this fusion narrows the true transform family to morphology, introduces a\n/home/lixinyu/snap/new/ceshi/code_combo/28a6681f/43/code.py:16:#      The generated landform is a high right-side shelf beside a narrow vertical chute; a\n/home/lixinyu/snap/new/ceshi/code_combo/28a6681f/25/code.py:37:#    The family is deliberately narrow:\n/home/lixinyu/snap/new/ceshi/code_combo/28a6681f/26/code.py:431:def _add_right_source(g: np.ndarray, top_row: int, narrow_rows: int, color: int) -> None:\n/home/lixinyu/snap/new/ceshi/code_combo/28a6681f/26/code.py:474:        narrow_rows = 0\n/home/lixinyu/snap/new/ceshi/code_combo/28a6681f/26/code.py:482:        _add_right_source(g, right_top, narrow_rows, right_color)\n/home/lixinyu/snap/new/ceshi/code_combo/e12f9a14/42/code.py:21:#      generator narrows legal exits to one corner gap per frame, so every beam is diagonal.\n/home/lixinyu/snap/new/ceshi/code_combo/28a6681f/27/code.py:25:# - The geometry is deliberately narrow: always two adjacent basins, always a shorter\n/home/lixinyu/snap/new/ceshi/code_combo/dbff022c/20/code.py:38:#   narrow, which guarantees a visible disagreement between pixel-majority and side-vote\n/home/lixinyu/snap/new/ceshi/code_combo/8b7bacbf/2/code.py:26:#      keeps the visual degree of freedom narrow and repeatable across 2-4 ARC examples.\n/home/lixinyu/snap/new/ceshi/code_combo/28a6681f/8/code.py:17:#    - The fused change fixes the lower area to a long chain of 4 or 5 narrow basins. The top\n/home/lixinyu/snap/new/ceshi/code_combo/28a6681f/8/code.py:288:    - Bottom-anchored solids form a chain of 4 or 5 narrow basins separated by single divider walls.\n/home/lixinyu/snap/new/ceshi/code_combo/5dbc8537/19/code.py:44:#      narrows the target to the two blue-striped holes. One hole shows a red\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:19:#       1) use the arrow between the two training frames to read source -> destination,\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:31:#         - read the arrow to fix direction,\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:45:#     - The arrow only appears between horizontally or vertically adjacent training frames, which keeps the\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:49:#       invalid once direction is explicitly marked, so the solver now decodes the arrow first.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:58:#       for a thin arrow to fit between any allowed training pair.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:59:#     - Sprite pixels live strictly inside frame interiors. The arrow is drawn only in the corridor\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:62:#     - A human can see the arrow before reasoning about the transform.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:84:#     - `decode_training_direction()` assumes one isolated arrow component sits in the gap between the\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:341:        arrow = _direction_from_component(pts, axis)\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:342:        if arrow == \"right\":\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:344:        if arrow == \"left\":\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:373:    arrow = _direction_from_component(pts, axis)\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:374:    if arrow == \"down\":\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:376:    if arrow == \"up\":\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:383:    Solve a framed sprite analogy where a directed arrow and three color roles specify a contour rule.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:389:    - A thin single-color arrow lies between the two training frames and points from the example source\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:393:    - Match the training pair by identical non-zero palettes, then decode the arrow to determine the\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:401:    - The arrow removes direction ambiguity, while the color counts reveal the stable role.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:662:def draw_direction_arrow(\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/15/code.py:813:    draw_direction_arrow(grid, frame_boxes[train_direction[0]], frame_boxes[train_direction[1]], marker_color)\n/home/lixinyu/snap/new/ceshi/code_combo/28a6681f/24/code.py:37:#    - or, for the narrower layout, the same receiver with one inner step.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/29/code.py:57:    arrow\".\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/29/code.py:96:    color matches and visible arrow orientation.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/29/code.py:249:      color match between a side-mounted legend and its chamber wall; the arrow orientation inside that\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/20/code.py:14:#      then both training frames and both test/blank frames have right-edge gaps, and a thin arrow\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/20/code.py:19:#      corridor arrow -> transform the test sprite -> write it into the blank frame -> return the\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/20/code.py:27:#    - The arrow and the frame gaps encode the same direction redundantly. That redundancy is\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/20/code.py:34:#      both the gap side and the arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/20/code.py:40:#    - Frames are placed on a 2x2 structured layout with minimum corridor width, so arrows fit\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/20/code.py:43:#      erased -> interior sprite pasted -> corridor arrows drawn. This keeps each layer separable.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/20/code.py:45:#    - A human sees four obviously broken frames, two arrows, and one empty destination frame.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/20/code.py:54:#      original rule families, while direction is conveyed structurally by gap orientation and arrow\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/20/code.py:481:def decode_arrow_direction(\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/20/code.py:576:    arrow_dir = decode_arrow_direction(grid, frames, pair)\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/20/code.py:577:    if gap_dir is None or arrow_dir is None or gap_dir != arrow_dir:\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/20/code.py:602:    - The training pair and the test/blank pair each have a thin arrow in the corridor between them,\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/20/code.py:603:      and the arrow direction matches the shared gap side of that pair.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/20/code.py:607:      the source->destination order from the combined gap-side cue and corridor arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/20/code.py:1026:def draw_direction_arrow(\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/20/code.py:1169:    draw_direction_arrow(grid, frame_boxes[train_dir[0]], frame_boxes[train_dir[1]], marker_color)\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/20/code.py:1170:    draw_direction_arrow(grid, frame_boxes[test_blank_dir[0]], frame_boxes[test_blank_dir[1]], marker_color)\n/home/lixinyu/snap/new/ceshi/code_combo/28a6681f/33/code.py:33:#    The geometry is intentionally narrow and repetitive rather than highly free-form:\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/43/code.py:53:#    - 图例的两个红点一横一竖，非常直观地提示“这不是一个单向箭头，而是两阶段正交指令”。\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/43/code.py:395:    - The legend no longer means one atomic arrow. It encodes two cardinal sub-moves, and the fixed processing order is part of the rule: horizontal first, vertical second.\n/home/lixinyu/snap/new/ceshi/code_combo/28a6681f/11/code.py:30:#    - The geometry family is intentionally narrow: one top source shelf and three shaft mouths.\n/home/lixinyu/snap/new/ceshi/code_combo/e12f9a14/41/code.py:35:#    - The rule is intentionally narrowed to straight rays and single-gap generated samples. This keeps the\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/25/code.py:23:#       - then each mover reads the arrow tied to its own color inside that legend;\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/25/code.py:25:#         pink stays at its input cell even if its arrow points into open space.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/25/code.py:33:#       the same visible mover color now selects both which arrow to read and how much of that\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/25/code.py:67:#     - Pink is only accepted when its own arrow has at least one open step ahead, so \"pink does\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/25/code.py:257:    Slide multi-colored mover pixels inside sealed wall regions using color-specific arrows and color-specific travel lengths.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/25/code.py:272:    - Wall color chooses which legend applies, while mover color chooses both which arrow to read inside that legend and how much of the available path to traverse.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/25/code.py:353:    raise RuntimeError(\"_sample_legend_dirs: unable to place non-overlapping color-specific arrows\")\n/home/lixinyu/snap/new/ceshi/code_combo/cbebaa4b/17/code.py:32:#     - tabs are narrower than the strip, which makes concave/convex shoulders visible without exploding the case count\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/5/code.py:13:# - The generator uses narrow funnel chambers so both changes are externally visible:\n/home/lixinyu/snap/new/ceshi/code_combo/5dbc8537/14/code.py:35:#    - \"holes can be found anywhere inside the bbox\" is narrowed to rectangular bg\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:18:#   - D11/0 removes direction guessing. A thin arrow is drawn in the corridor\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:30:#       3. decode the arrow so direction is fixed before rule inference\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:44:#     after adding a dedicated anchor color, an arrow color, a frame color, and a\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:51:#   - find_square_frames() still works because the arrow never touches a frame.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:57:#     explicit and should be decoded from the arrow instead of guessed.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:62:#     * the training pair is axis-adjacent with a unique arrow component in its gap\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:68:#     and column gap, so the arrow fits cleanly between adjacent training frames.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:69:#   - The arrow is drawn only in the corridor between the chosen pair and never\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:78:#   - The arrow is a separate unique-color component outside all frames, so it does\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:90:#     repeats the same joint pattern: arrow fixes direction, anchor stays fixed,\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:333:        arrow = _direction_from_component(pts, axis)\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:334:        if arrow == \"right\":\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:336:        if arrow == \"left\":\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:365:    arrow = _direction_from_component(pts, axis)\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:366:    if arrow == \"down\":\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:368:    if arrow == \"up\":\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:375:    Learn an anchor-aware contour rule from a framed training pair with an explicit arrow, then solve the test sprite.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:380:    - Every non-blank sprite contains exactly one shared-color anchor pixel, and a thin arrow outside the frames points from the training source frame to the training destination frame.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:384:    - Use the arrow to decide the training direction, then verify that the destination equals the 4-connected outer boundary of the source body, where the body means all non-zero pixels except the anchor.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:388:    - The anchor is not ordinary foreground. It stays visible but should be mentally removed before tracing the body's outline, and the arrow removes any need to guess which training frame is the source.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:604:def draw_direction_arrow(\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/9/code.py:695:    draw_direction_arrow(grid, frame_boxes[train_direction[0]], frame_boxes[train_direction[1]], marker_color)\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/26/code.py:78:    - using only cardinal arrows avoids mixing the D6 geometric effect with diagonal corner-cutting\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/26/code.py:88:    - the fused change is inferable from shape geometry plus arrow direction, not from numeric color\n/home/lixinyu/snap/new/ceshi/code_combo/e12f9a14/6/code.py:63:#      one narrower opening so the contrast is present within each grid.\n/home/lixinyu/snap/new/ceshi/code_combo/e12f9a14/6/code.py:758:    narrow_candidates = [i for i, available in enumerate(available_per_block) if i != wide_idx and (1 in available or 2 in available)]\n/home/lixinyu/snap/new/ceshi/code_combo/e12f9a14/6/code.py:759:    if not narrow_candidates:\n/home/lixinyu/snap/new/ceshi/code_combo/e12f9a14/6/code.py:761:    narrow_idx = narrow_candidates[int(rng.integers(len(narrow_candidates)))]\n/home/lixinyu/snap/new/ceshi/code_combo/e12f9a14/6/code.py:767:        elif i == narrow_idx:\n/home/lixinyu/snap/new/ceshi/code_combo/e12f9a14/6/code.py:768:            narrow_sizes = [size for size in (1, 2) if size in available]\n/home/lixinyu/snap/new/ceshi/code_combo/e12f9a14/6/code.py:769:            size = narrow_sizes[int(rng.integers(len(narrow_sizes)))]\n/home/lixinyu/snap/new/ceshi/code_combo/28a6681f/7/code.py:42:#      narrow basin columns bounded by walls or grid edges; final water still occupies complete\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/32/code.py:32:        - at a narrow elbow the bridge square exists but the parallel lane disappears, so the\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/32/code.py:35:        - two yellows under the same arrow can end at different depths: one reaches the remote\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/32/code.py:317:    - The wall color still chooses the arrow, but the final resting place now depends on both the\n/home/lixinyu/snap/new/ceshi/code_combo/5dbc8537/12/code.py:127:    Key insight: The puzzle is solved by a genuine two-step cue hierarchy: size only says which pieces can fit, marker count narrows the candidate slot set, and the marker layout inside equally counted rectangles determines the final correspondence.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/13/code.py:378:    Launch wall-jammed yellow pixels using the legend arrows, with the touching wall causing the first rebound and later wall hits continuing the reflected path.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/13/code.py:390:    - The yellow pixels are not supposed to reverse-slide directly; they must be fired along the legend arrow from a wall-touching start, so the initial wall contact determines the rebound and the rest of the reflected route.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/27/code.py:78:#     visible legend arrows.\n/home/lixinyu/snap/new/ceshi/code_combo/28a6681f/32/code.py:228:    - Bottom-anchored divider columns create 4 or 5 narrow basins along the lower edge; a short upper platform supports the source,\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/40/code.py:46:  - Room interiors are narrow in the stacking axis and longer in the motion axis, which\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:167:      the arrow-like offset inside the legend.\n/home/lixinyu/snap/new/ceshi/code_combo/abc82100/39/code.py:78:   - Restricting the generator to a narrow family of odd hollow frames makes the\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/39/code.py:43:    - B-only rooms no longer follow B's shown arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/39/code.py:65:      with three colors and a centroid-based arrow cue.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/39/code.py:87:  - The A-only room anchors the normal meaning of a legend arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/39/code.py:88:  - The B-only room shows that B's displayed arrow is not the real motion cue.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/39/code.py:109:      uses B's displayed arrow directly instead of sign(disp_A - disp_B).\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/39/code.py:342:    two-legend rule instead of a one-color one-arrow lookup.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/39/code.py:353:    - A's true direction is the arrow shown inside A.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/39/code.py:354:    - B's true direction is not its own shown arrow; it is sign(A_display - B_display).\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/39/code.py:361:    legend directions must itself be decoded from the relationship between the two visible arrows.\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/13/code.py:40:#    The rule family is narrowed to symmetry transforms because that is the most\n/home/lixinyu/snap/new/ceshi/code_combo/28a6681f/15/code.py:39:#    - The family is intentionally narrow: one validated landform, horizontal mirroring, and\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:3:# Name: 箭头图例+沿墙滑动\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:11:#      color itself forms a small arrow silhouette.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:14:#    - Fusion rule used here: the arrow still has an orientation, but that orientation is not a\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:16:#      the matching legend corner, the arrow tells us which of the two tangent directions to take\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:19:#    - Small trace: if a TL-corner legend contains a wall-colored arrow pointing east, then for\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:22:#      step is east, it uses the counterclockwise track. The same arrow would have meant \"slide\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:28:#    - Arrow directions still come from a small discrete family (4 cardinals via 5x5 arrows, 4\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:29:#      diagonals via 6x7 arrows), avoiding excessive freedom while keeping the visual cue obvious.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:35:#      That is invalid now because legends are two-color arrow templates. The new solver matches\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:36:#      the dominant-color silhouette against 5x5 / 6x7 arrow masks.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:42:#    - Fusion-specific new assumption: the arrow direction must equal one of the two possible first\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:47:#      so later-chosen 5x5 or 6x7 arrows never collide with walls.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:54:#      the legend visibly looks like an arrow rather than a dot-offset code, and the yellows stay\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:56:#    - Because the arrow matches the initial tangent at the anchor, samples make clear that the\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:57:#      arrow is not a free-space motion vector: the yellows do not cut across the room.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:68:#    - The chosen arrow direction equals the clockwise first step or the counterclockwise first\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:135:def _cardinal_arrow_mask(dr: int, dc: int) -> np.ndarray:\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:140:def _diagonal_arrow_mask(dr: int, dc: int) -> np.ndarray:\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:152:CARDINAL_TEMPLATE_MASKS = {(dr, dc): _cardinal_arrow_mask(dr, dc) for dr, dc in CARDINAL_DIRS}\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:153:DIAGONAL_TEMPLATE_MASKS = {(dr, dc): _diagonal_arrow_mask(dr, dc) for dr, dc in DIAGONAL_DIRS}\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:164:        patch[_cardinal_arrow_mask(dr, dc)] = fill\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:167:    patch[_diagonal_arrow_mask(dr, dc)] = fill\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:207:def _match_arrow_direction(fill_mask: np.ndarray) -> tuple[int, int] | None:\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41