", \"context\": \"along the diagonal line pointed by the arrow\"},\n/home/lixinyu/snap/new/arc2_mechanism_tags_raw.json:96:    {\"tag\": \"width_constraint\", \"field\": \"path\", \"context\": \"stuck because channel is too narrow\"}\n/home/lixinyu/snap/new/rebuild_tags_100.py:82:    \"object:marker\":           [\"marker\", \"seed\", \"arrow\", \"indicator\", \"标记\", \"种子\", \"箭头\", \"指针\"],\n/home/lixinyu/snap/new/ARC1_code/eval/60a26a3e.py:335:    span_narrow = min(h_span, w_span)\n/home/lixinyu/snap/new/ARC1_code/eval/60a26a3e.py:337:    if arms is None or span_narrow < _GEN_MIN_STEP:\n/home/lixinyu/snap/new/ARC1_code/eval/60a26a3e.py:340:    leg = random.randint(_GEN_MIN_STEP, min(_GEN_MAX_STEP, span_narrow))\n/home/lixinyu/snap/new/tmp/combo_exec_5961cc34_20260506_215902/report.md:11:| 5961cc34 | 9 | D1/2+D4/2 | 螺旋射线+箭头形起始标记 | D4/2 | 50/50 | ✓（审查后修复） |\n/home/lixinyu/snap/new/tmp/combo_exec_5961cc34_20260506_215902/report.json:567:    \"name\": \"螺旋射线+箭头形起始标记\",\n/home/lixinyu/snap/new/tmp/combo_exec_5961cc34_20260506_215902/report.json:571:    \"description\": \"箭头形标记的凸出部分指示初始射线方向，射线遇边界时顺时针转90度继续前进形成螺旋路径。解题者需从箭头推断方向并追踪螺旋式转弯。\",\n/home/lixinyu/snap/new/ARC1_code/eval/7d419a02.py:31:    The separator-line axis is the narrow axis of the hourglass; the other axis\n/home/lixinyu/snap/new/ARC1_code/eval/7d419a02.py:33:    are nonzero and the narrow-axis distance is no greater than the opening-axis\n/home/lixinyu/snap/new/tmp/combo_exec_53fb4810_20260506_103138/report.md:6:| 53fb4810 | 4 | D2/0+D4/1 | 箭头形精灵凸出方向 | D2/0, D4/1 | 50/50 | ✓（审查后修复） |\n/home/lixinyu/snap/new/tmp/combo_exec_53fb4810_20260506_103138/report.md:29:| 53fb4810 | 27 | D3/1+D4/1+D5/0 | 箭头精灵大瓦片颜色循环 | D3/1, D4/1, D5/0 | 50/50 | ✓ |\n/home/lixinyu/snap/new/tmp/review_pack_53fb4810.json:73:      \"variant_name\": \"箭头形精灵\",\n/home/lixinyu/snap/new/tmp/combo_exec_53fb4810_20260506_103138/report.json:213:    \"name\": \"箭头形精灵凸出方向\",\n/home/lixinyu/snap/new/tmp/combo_exec_53fb4810_20260506_103138/report.json:218:    \"description\": \"源对象为箭头形状，且射线方向由精灵自身形状的不对称凸出部分决定（而非标记相对位置）。箭头朝向和凸起同时暗示方向。\",\n/home/lixinyu/snap/new/tmp/combo_exec_53fb4810_20260506_103138/report.json:1825:    \"name\": \"箭头精灵大瓦片颜色循环\",\n/home/lixinyu/snap/new/tmp/combo_exec_53fb4810_20260506_103138/report.json:1831:    \"description\": \"源为箭头形精灵（方向由箭头指示），标记为大尺寸瓦片，且重复���颜色循环替换。\",\n/home/lixinyu/snap/new/tmp/combo_exec_8b9c3697_20260503_101340/report.json:219:    \"description\": \"红色精灵带有方向标记（如箭头像素），结构上有连接器接口。匹配条件为：精灵的方向标记必须指向连接器且形状兼容。匹配后精灵沿标记方向滑入对接，轨迹涂黑。\",\n/home/lixinyu/snap/new/tmp/combo_exec_8b9c3697_20260503_101340/report.json:497:    \"description\": \"红色精灵带方向标记（箭头像素），目标从封闭插槽变为开放式停靠杆。精灵必须沿标记方向移动，碰到停靠杆即停靠。轨迹涂黑，方向不对的精灵被擦除。\",\n/home/lixinyu/snap/new/tmp/audit_53fb4810.json:66:    \"variant_name\": \"箭头形精灵\",\n/home/lixinyu/snap/new/tmp/combo_exec_a25697e4_20260502_195415/report.json:1552:    \"description\": \"工具内部有方向标记像素(如箭头形状的特殊色点)。仅允许旋转(禁止翻转)。标记像素指示工具应旋转到的目标朝向(标记朝上=不旋转，朝右=90度等)。对接后标记像素保留。\",\n/home/lixinyu/snap/new/tmp/combo_exec_a47bf94d_20260503_054255/report.json:81:    \"description\": \"管道交叉处用不同颜色的箭头像素指示转向方向作为默认规则，同时交叉标记颜色（red/blue）决定在该交叉处是直行还是转弯。当两种规则冲突时，颜色编码优先。解题者需学习两层路由规则及其优先级关系。\",\n/home/lixinyu/snap/new/tmp/audit_combo_3dc255db.json:78:    \"name\": \"箭头指示方向+矩形框架\",\n/home/lixinyu/snap/new/tmp/audit_combo_3dc255db.json:90:    \"name\": \"箭头指示方向+L形框架\",\n/home/lixinyu/snap/new/tmp/audit_combo_3dc255db.json:438:    \"name\": \"箭头方向+矩形框架+边缘控制像素\",\n/home/lixinyu/snap/new/tmp/combo_exec_195c6913_20260506_042805/report.md:12:| 195c6913 | 10 | D4/4+D7/1 | 箭头标记编码方向+L/T形模板 | D4/4, D7/1 | 50/50 | ✓（审查后修复） |\n/home/lixinyu/snap/new/tmp/combo_exec_195c6913_20260506_042805/report.md:24:| 195c6913 | 22 | D2/2+D4/4+D11/1 | 符号转向指令+箭头标记+模板方向符号 | D2/2, D4/4, D11/1 | 50/50 | ✓（审查后修复） |\n/home/lixinyu/snap/new/tmp/combo_exec_21897d95_20260506_043640/report.md:23:| 21897d95 | 21 | D3/2+D7/2 | 箭头标记与镜像 | D7/2 | 50/50 | ✓（审查后修复） |\n/home/lixinyu/snap/new/tmp/combo_exec_195c6913_20260506_042805/report.json:634:    \"name\": \"箭头标记编码方向+L/T形模板\",\n/home/lixinyu/snap/new/tmp/combo_exec_195c6913_20260506_042805/report.json:639:    \"description\": \"标记为3像素L形/箭头形（形状指示初始方向），模板色块呈L形或T形排列在角落（循环顺序由顺时针外圈读取规则决定）。两者组合：输入中有两类形状需解读——箭头标记（推断方向）和L/T形模板（推断循环顺序）。\",\n/home/lixinyu/snap/new/tmp/combo_exec_195c6913_20260506_042805/report.json:1464:    \"name\": \"符号转向指令+箭头标记+模板方向符号\",\n/home/lixinyu/snap/new/tmp/combo_exec_195c6913_20260506_042805/report.json:1470:    \"description\": \"标记为3像素箭头形（指示初始方向），模板区增加方向指示符号指定转向序列（条形标记左侧=CCW、右侧=CW），初始方向由模板中额外符号指定。组合效果：输入中充满方向编码符号——箭头标记给初始方向，模板符号给转向序列。\",\n/home/lixinyu/snap/new/tmp/combo_exec_21897d95_20260506_043640/report.json:151:    \"description\": \"使用L形三连骨牌（3单元直角形状）替代T形四连骨牌作为标记。L的短臂指向目标区域。源区域不再通过对角线单元确定，而是通过茎尖端（短臂末端向前延伸1格）的横向邻居确定。解题者需要：(1)识别L形标记并判定短臂方向，(2)从茎尖端向两侧搜索源区域颜色。\",\n/home/lixinyu/snap/new/tmp/combo_exec_21897d95_20260506_043640/report.json:1136:    \"description\": \"区域为规则的矩形（通过水平垂直分割线划分），无旋转机制。T标记放在目标区域内部（而非边界上），茎方向指向外部远离目标。源区域通过茎反方向确定。在矩形分割中，每个目标矩形内包含一个T标记，标记\\\"箭头\\\"指向外部表示\\\"我的新颜色来自那个方向\\\"。\",\n/home/lixinyu/snap/new/tmp/combo_exec_21897d95_20260506_043640/report.json:1410:    \"name\": \"箭头标记与镜像\",\n/home/lixinyu/snap/new/tmp/combo_exec_21897d95_20260506_043640/report.json:1414:    \"description\": \"使用箭头形状（茎+两个对角线V形箭尖，5单元）作为T标记替代品，箭头明确指向目标区域。L形标记触发镜像翻转。箭头标记在镜像后视觉上方向反转，解题者需要注意镜像前箭头指向的是镜像前的目标——重着色在镜像之前执行。\",\n/home/lixinyu/snap/new/tmp/combo_exec_4a21e3da_20260429_094852/report.json:95:    \"name\": \"箭头指示方向+颜色编码指令\",\n/home/lixinyu/snap/new/tmp/combo_exec_4a21e3da_20260429_094852/report.json:653:    \"name\": \"箭头指示方向+距离编码射线长度\",\n/home/lixinyu/snap/new/tmp/combo_exec_4a21e3da_20260429_094852/summary.md:8:| 4a21e3da | 6 | D3/3+D17/0 | 箭头指示方向+颜色编码指令 | （无） | 50/50 | ✓ |\n/home/lixinyu/snap/new/tmp/combo_exec_4a21e3da_20260429_094852/summary.md:39:| 4a21e3da | 37 | D3/3+D4/3 | 箭头指示方向+距离编码射线长度 | （无） | 50/50 | ✓ |\n/home/lixinyu/snap/new/tmp/variant_logs_3dc255db/audit.json:66:    \"variant_name\": \"箭头像素指示方向\",\n/home/lixin