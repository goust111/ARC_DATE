{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport random\nimport numpy as np\nfrom scipy.ndimage import label as scipy_label\nfrom arc_utils import bbox_h, bbox_w, find_components, in_bounds, neighbors4, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n\n\ndef _bfs_placement(feasible, sr, sc):\n    h2, w2 = feasible.shape\n    dist = -np.ones((h2, w2), dtype=int)\n    dist[sr, sc] = 0\n    q = deque([(sr, sc)])\n    while q:\n        r, c = q.popleft()\n        for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:\n                dist[rr, cc] = dist[r, c] + 1\n                q.append((rr, cc))\n    return dist\n\n\ndef _hamiltonian_walk(rows, cols, start, end):\n    total = rows * cols\n    best_path = None\n    best_len = 0\n    for _attempt in range(80):\n        visited = {start}\n        path = [start]\n        cur = start\n        while True:\n            if cur == end and len(path) >= total * 0.7:\n                if len(path) > best_len:\n                    best_path = list(path)\n                    best_len = len(path)\n                break\n            neighbors = []\n            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                nr, nc = cur[0] + dr, cur[1] + dc\n                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:\n                    neighbors.append((nr, nc))\n            if not neighbors:\n                break\n            valid = []\n            for nb in neighbors:\n                if nb == end:\n                    valid.append(nb)\n                    continue\n                test_visited = visited | {nb}\n                seen = {end}\n                q = deque([end])\n                while q:\n                    cr, cc = q.popleft()\n                    for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                        nr2, nc2 = cr + dr2, cc + dc2\n                        if (0 <= nr2 < rows and 0 <= nc2 < cols and\n                                (nr2, nc2) not in test_visited and (nr2, nc2) not in seen):\n                            seen.add((nr2, nc2))\n                            q.append((nr2, nc2))\n                for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                    ar, ac = nb[0] + dr2, nb[1] + dc2\n                    if (0 <= ar < rows and 0 <= ac < cols and\n                            (ar, ac) not in test_visited and (ar, ac) in seen):\n                        valid.append(nb)\n                        break\n            if not valid:\n                break\n            random.shuffle(valid)\n            nxt = valid[0]\n            visited.add(nxt)\n            path.append(nxt)\n            cur = nxt\n        if best_path and best_len >= total * 0.85:\n            break\n    return best_path\n\n\ndef _render_channel(grid, path, n, offsets_r, offsets_c):\n    pixel_pos = []\n    for cr, cc in path:\n        pr, pc = offsets_r[cr], offsets_c[cc]\n        pixel_pos.append((pr, pc))\n        grid[pr:pr + n, pc:pc + n] = _RIVER\n    for i in range(len(path) - 1):\n        pr1, pc1 = pixel_pos[i]\n        pr2, pc2 = pixel_pos[i + 1]\n        if pr1 == pr2:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n            grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER\n        else:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n            grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER\n    return pixel_pos\n\n\ndef _add_chokepoint(grid, pixel_pos_i, pixel_pos_j, n, direction):\n    H, W = grid.shape\n    pr1, pc1 = pixel_pos_i\n    pr2, pc2 = pixel_pos_j\n    narrow_w = random.randint(1, n - 1)\n    remove = n - narrow_w\n    side = random.randint(0, 1)\n\n    if direction == 'h':\n        c_lo = min(pc1, pc2) + n\n        c_hi = max(pc1, pc2)\n        if c_hi <= c_lo:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        c_mid = (c_lo + c_hi) // 2\n        c_start = max(c_lo, c_mid - total_len // 2)\n        for step in range(total_len):\n            c = c_start + step\n            if c < 0 or c >= W:\n                continue\n            if step < remove:\n                depth = step + 1\n            elif step >= total_len - remove:\n                depth = total_len - step\n            else:\n                depth = remove\n            for k in range(depth):\n                rr = pr1 + k if side == 0 else pr1 + n - 1 - k\n                if 0 <= rr < H and 0 <= c < W:\n                    grid[rr, c] = _BG\n    else:\n        r_lo = min(pr1, pr2) + n\n        r_hi = max(pr1, pr2)\n        if r_hi <= r_lo:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        r_mid = (r_lo + r_hi) // 2\n        r_start = max(r_lo, r_mid - total_len // 2)\n        for step in range(total_len):\n            r = r_start + step\n            if r < 0 or r >= H:\n                continue\n            if step < remove:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/0934a4d8.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import deque\n\nimport numpy as np\n\nfrom arc_utils import bbox\n\n\ndef _solid_rectangle_marker(g: np.ndarray) -> tuple[int, tuple[int, int, int, int]]:\n    candidates: list[tuple[int, int, tuple[int, int, int, int]]] = []\n    for color in np.unique(g):\n        mask = g == int(color)\n        b = bbox(mask)\n        assert b is not None\n        r0, c0, r1, c1 = b\n        area = int((r1 - r0 + 1) * (c1 - c0 + 1))\n        if area > 1 and int(mask.sum()) == area and bool(np.all(mask[r0 : r1 + 1, c0 : c1 + 1])):\n            candidates.append((area, int(color), b))\n\n    assert len(candidates) == 1\n    _area, color, b = candidates[0]\n    return color, b\n\n\ndef _find_reflected_strip_start(g: np.ndarray, marker: int) -> int:\n    n, m = map(int, g.shape)\n    assert n == m\n    hi = n - 1\n\n    for lo in range(n // 2 + 1):\n        strip = g[:, lo : hi + 1]\n        strip_reflected = strip[:, ::-1]\n        known = (strip != marker) & (strip_reflected != marker)\n        if bool(np.any((strip != strip_reflected) & known)):\n            continue\n\n        strip = g[lo : hi + 1, :]\n        strip_reflected = strip[::-1, :]\n        known = (strip != marker) & (strip_reflected != marker)\n        if bool(np.any((strip != strip_reflected) & known)):\n            continue\n\n        return lo\n\n    raise AssertionError(\"no reflected strip found\")\n\n\ndef _reflection_orbit_values(g: np.ndarray, r: int, c: int, lo: int, marker: int) -> set[int]:\n    n = int(g.shape[0])\n    hi = n - 1\n    seen: set[tuple[int, int]] = set()\n    values: set[int] = set()\n    q: deque[tuple[int, int]] = deque([(int(r), int(c))])\n\n    while q:\n        rr, cc = q.popleft()\n        if (rr, cc) in seen:\n            continue\n        seen.add((rr, cc))\n\n        value = int(g[rr, cc])\n        if value != marker:\n            values.add(value)\n\n        if lo <= cc <= hi:\n            q.append((rr, lo + hi - cc))\n        if lo <= rr <= hi:\n            q.append((lo + hi - rr, cc))\n\n    return values\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reveal the rectangular patch hidden by the solid marker using the grid's reflection symmetries.\n\n    Input structure:\n    - A square colored pattern with one solid rectangular marker color occluding a patch.\n    - The visible pattern has horizontal and vertical reflection symmetry on a large lower/right strip.\n    - The top and left outer strips also expose transpose counterparts for cells not recoverable by those reflections.\n\n    Rule:\n    - Find the unique color whose full extent is a solid rectangle; this rectangle is the output region.\n    - Infer the reflected strip start as the smallest row/column offset whose lower/right strips are mirror-consistent, ignoring marker pixels.\n    - For each marker pixel, copy the unique non-marker value in its horizontal/vertical reflection orbit; if that orbit is entirely hidden in the outer strip, use the transposed top/left-strip counterpart.\n\n    Key insight:\n    The marker is not part of the pattern; it covers a missing rectangle whose cells are still determined by the visible mirror or transpose copies elsewhere in the grid.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    marker, (r0, c0, r1, c1) = _solid_rectangle_marker(g)\n    lo = _find_reflected_strip_start(g, marker)\n\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    out = np.empty((h, w), dtype=int)\n\n    for rr in range(h):\n        for cc in range(w):\n            r = int(r0 + rr)\n            c = int(c0 + cc)\n            values = _reflection_orbit_values(g, r, c, lo, marker)\n            if values:\n                assert len(values) == 1\n                out[rr, cc] = values.pop()\n            else:\n                assert r < lo or c < lo\n                assert 0 <= c < g.shape[0] and 0 <= r < g.shape[1]\n                value = int(g[c, r])\n                assert value != marker\n                out[rr, cc] = value\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- CFG: canvas & structure ---\n_N = 30                  # grid side length (always square)\n_LO = 2                  # outer border width (rows/cols 0..lo-1 are \"free\" border)\n_HI = _N - 1             # max row/col index\n\n# --- CFG: colors ---\n_PALETTE = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)  # 8 non-marker colors\n_MARKER = 8              # marker fill color\n\n# --- CFG: marker rectangle size ---\n_MARKER_DIM_LO = 3       # min marker side length\n_MARKER_DIM_HI = 9       # max marker side length (inclusive)\n_MARKER_AREA_LO = 16     # min marker area\n_MARKER_AREA_HI = 36     # max marker area\n\n# --- CFG: generation retries ---\n_MAX_RETRIES = 300\n\n_RNG = np.random.default_rng()\n_SIZE_PAIRS = [\n    (h, w)\n    for h in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)\n    for w in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)\n    if _MARKER_AREA_LO <= h * w <= _MARKER_AREA_HI\n]\n_PLACEMENT_CACHE: dict[tuple[int, int], list[tuple[int, int, list[tuple[int, int]]]]] = {}\n\n\ndef _orbit(r: int, c: int) -> set[tuple[int, int]]:\n    \"\"\"Return the LR+UD reflection orbit of (r, c) within the [_LO.._HI] axes.\"\"\"\n    rows = {r}\n    cols = {c}\n    if _LO <= r <= _HI:\n        rows.add(_LO + _HI - r)\n    if _LO <= c <= _HI:\n        cols.add(_LO + _HI - c)\n    return {(rr, cc) for rr in rows for cc in cols}\n\n\ndef _fallback_cells(r0: int, c0: int, h: int, w: int) -> list[tuple[int, int]] | None:\n    \"\"\"Identify marker cells whose entire orbit is inside the marker (need transpose fallback).\n\n    Returns None if the placement is invalid (a fully-covered orbit cell lies\n    inside the inner block, or its transpose is also inside the marker).\n    \"\"\"\n    r1, c1 = r0 + h, c0 + w\n    cells: list[tuple[int, int]] = []\n    for r in range(r0, r1):\n        for c in range(c0, c1):\n            if all(r0 <= rr < r1 and c0 <= cc < c1 for rr, cc in _orbit(r, c)):\n                if r >= _LO and c >= _LO:\n                    return None  # orbit fully hidden but no transpose fallback available\n                if r0 <= c < r1 and c0 <= r < c1:\n                    return None  # transpose cell also hidden by marker\n                cells.append((r, c))\n    return cells\n\n\ndef _valid_placements(h: int, w: int) -> list[tuple[int, int, list[tuple[int, int]]]]:\n    \"\"\"Return all valid (r0, c0, fallback_cells) placements for a h x w marker, cached.\"\"\"\n    key = (h, w)\n    if key not in _PLACEMENT_CACHE:\n        placements: list[tuple[int, int, list[tuple[int, int]]]] = []\n        for r0 in range(_N - h + 1):\n            for c0 in range(_N - w + 1):\n                fallback = _fallback_cells(r0, c0, h, w)\n                if fallback is not None:\n                    placements.append((r0, c0, fallback))\n        _PLACEMENT_CACHE[key] = placements\n    return _PLACEMENT_CACHE[key]\n\n\ndef _unify_groups(clean: np.ndarray, groups: list[set[tuple[int, int]]]) -> None:\n    \"\"\"Merge coordinate groups with union-find so all members share a random color.\"\"\"\n    parent: dict[tuple[int, int], tuple[int, int]] = {}\n\n    def find(x: tuple[int, int]) -> tuple[int, int]:\n        parent.setdefault(x, x)\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(a: tuple[int, int], b: tuple[int, int]) -> None:\n        ra, rb = find(a), find(b)\n        if ra != rb:\n            parent[rb] = ra\n\n    for group in groups:\n        coords = list(group)\n        if not coords:\n            continue\n        for coord in coords[1:]:\n            union(coords[0], coord)\n\n    merged: dict[tuple[int, int], list[tuple[int, int]]] = {}\n    for coord in parent:\n        merged.setdefault(find(coord), []).append(coord)\n\n    for coords in merged.values():\n        color = int(_RNG.choice(_PALETTE))\n        for r, c in coords:\n            clean[r, c] = color\n\n\ndef _build_clean() -> np.ndarray:\n    \"\"\"Build a clean NxN grid with bilateral LR+UD symmetry on the [lo..N-1] axes.\"\"\"\n    half = (_N - _LO) // 2\n    clean = np.empty((_N, _N), dtype=int)\n\n    # Inner block: quarter tile mirrored LR then UD\n    q = _RNG.choice(_PALETTE, size=(half, half))\n    top = np.concatenate([q, q[:, ::-1]], axis=1)\n    clean[_LO:_N, _LO:_N] = np.concatenate([top, top[::-1, :]], axis=0)\n\n    # Top border rows: LR-symmetric on [lo..N-1]\n    for r in range(_LO):\n        vals = _RNG.choice(_PALETTE, size=half)\n        clean[r, _LO : _LO + half] = vals\n        clean[r, _LO + half : _N] = vals[::-1]\n\n    # Left border cols: UD-symmetric on [lo..N-1]\n    for c in range(_LO):\n        vals = _RNG.choice(_PALETTE, size=half)\n        clean[_LO : _LO + half, c] = vals\n        clean[_LO + half : _N, c] = vals[::-1]\n\n    # Top-left corner: free (no symmetry constraint)\n    clean[:_LO, :_LO] = _RNG.choice(_PALETTE, size=(_LO, _LO))\n    return clean\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Try once to generate a valid input grid. Returns None on failure.\"\"\"\n    clean = _build_clean()\n    h, w = _SIZE_PAIRS[int(_RNG.integers(len(_SIZE_PAIRS)))]\n    placements = _valid_placements(h, w)\n    if not placements:\n        return None\n    r0, c0, fallback = placements[int(_RNG.integers(len(placements)))]\n\n    # Ensure transpose-fallback cells share consistent colors across orbits\n    groups = [_orbit(r, c) | _orbit(c, r) for r, c in fallback]\n","exit_code":0,"status":"completed"}}
