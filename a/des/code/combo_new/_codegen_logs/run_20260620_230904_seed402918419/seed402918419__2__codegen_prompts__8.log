{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/20fb2937.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste, random_free_location\nimport random\n\n\ndef _solid_separator_row(g: np.ndarray, bg: int) -> int:\n    rows = [\n        r\n        for r in range(g.shape[0])\n        if np.all(g[r] == int(g[r, 0])) and int(g[r, 0]) != int(bg)\n    ]\n    assert len(rows) == 1, \"expected one solid non-background separator row\"\n    return int(rows[0])\n\n\ndef _legend_mapping(g: np.ndarray, sep: int, bg: int) -> tuple[dict[int, int], int]:\n    top = g[:sep]\n    comps = find_components(top, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n\n    sprites = []\n    markers = []\n    for comp in comps:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        area = int(comp[\"area\"])\n        if area == 1:\n            markers.append(comp)\n        else:\n            assert h == w and area == h * w, \"legend sprites must be filled squares\"\n            sprites.append(comp)\n\n    assert len(sprites) == len(markers) and len(sprites) > 0, \"legend must pair each sprite with one marker\"\n\n    sizes = {int(s[\"bbox\"][2] - s[\"bbox\"][0] + 1) for s in sprites}\n    assert len(sizes) == 1, \"all legend sprites must have the same size\"\n    size = sizes.pop()\n    assert size % 2 == 1, \"legend sprite size must have a center pixel\"\n\n    marker_rows = {int(m[\"coords\"][0][0]) for m in markers}\n    assert len(marker_rows) == 1, \"legend markers must lie on one row\"\n    marker_colors = [int(m[\"color\"]) for m in markers]\n    assert len(set(marker_colors)) == len(marker_colors), \"legend marker colors must be unique\"\n\n    sprites.sort(key=lambda s: (int(s[\"bbox\"][1] + s[\"bbox\"][3]), int(s[\"bbox\"][0])))\n    markers.sort(key=lambda m: (int(m[\"coords\"][0][1]), int(m[\"coords\"][0][0])))\n\n    mapping: dict[int, int] = {}\n    for sprite, marker in zip(sprites, markers):\n        _sr0, sc0, _sr1, sc1 = sprite[\"bbox\"]\n        mr, mc = map(int, marker[\"coords\"][0])\n        assert mc == (int(sc0) + int(sc1)) // 2, \"marker must align with its sprite center column\"\n        assert mr > int(sprite[\"bbox\"][2]), \"marker must sit below its sprite\"\n        mapping[int(marker[\"color\"])] = int(sprite[\"color\"])\n\n    return mapping, int(size)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace each marker below the separator with the mapped top legend square centered on that marker.\n\n    Input structure:\n    - The background surrounds a top legend, one solid non-background separator row, and a lower marker field.\n    - The legend contains equal-size filled square sprites, with a singleton marker below each sprite and aligned to its center column.\n    - The lower field contains only background and marker colors from the legend.\n\n    Rule:\n    - Pair legend markers to legend sprites by left-to-right position.\n    - Discard the legend and separator; keep the grid width and the rows below the separator.\n    - In the lower field, replace every marker pixel by a filled square of the paired sprite color, centered at the marker location.\n\n    Key insight: The top area is a positional color legend, and the actual output is the post-separator marker field expanded by that legend.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    sep = _solid_separator_row(g, bg)\n    mapping, size = _legend_mapping(g, sep, bg)\n\n    lower = g[sep + 1 :]\n    out = np.full_like(lower, bg)\n    radius = size // 2\n\n    for r, c in np.argwhere(lower != bg):\n        key = int(lower[r, c])\n        assert key in mapping, \"lower field marker must appear in the legend\"\n        r0 = int(r) - radius\n        c0 = int(c) - radius\n        r1 = r0 + size\n        c1 = c0 + size\n        assert 0 <= r0 and 0 <= c0 and r1 <= out.shape[0] and c1 <= out.shape[1], \"expanded square must fit in output\"\n        assert np.all(out[r0:r1, c0:c1] == bg), \"expanded squares must not overlap\"\n        out[r0:r1, c0:c1] = mapping[key]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and legend geometry.\nBACKGROUND_COLOR, SEPARATOR_COLOR = 7, 6\nFIELD_SHAPE = (13, 11)\nFIELD_WIDTH = FIELD_SHAPE[1]\nSQUARE_SIZE = 3\nSQUARE_RADIUS = SQUARE_SIZE // 2\nLEGEND_HEIGHT, LEGEND_MARKER_ROW, LEGEND_COLUMN_STRIDE = 6, 4, 4\n\n# Palette and object counts.\nPALETTE_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nNUM_COLOR_PAIRS, SQUARE_COUNT_CHOICES = 3, [8, 9]\n\nEMPTY, MAX_GENERATION_ATTEMPTS = 0, 300\n\n\ndef _color_pairs() -> tuple[list[int], list[int]]:\n    \"\"\"Return disjoint sprite and marker palettes in legend order.\"\"\"\n    picked = random.sample(PALETTE_COLORS, NUM_COLOR_PAIRS * 2)\n    return picked[:NUM_COLOR_PAIRS], picked[NUM_COLOR_PAIRS:]\n\n\ndef _place_centers(n: int) -> list[tuple[int, int]] | None:\n    \"\"\"Place non-overlapping 3x3 squares and return their centers.\"\"\"\n    occ = np.full(FIELD_SHAPE, EMPTY, dtype=int)\n    patch = np.ones((SQUARE_SIZE, SQUARE_SIZE), dtype=int)\n    centers: list[tuple[int, int]] = []\n    for _ in range(n):\n        try:\n            r0, c0 = random_free_location(occ, patch, transparent=EMPTY)\n        except ValueError:\n            return None\n        paste(occ, patch, r0, c0)\n        centers.append((r0 + SQUARE_RADIUS, c0 + SQUARE_RADIUS))\n    return centers\n\n\ndef _touch_graph(centers: list[tuple[int, int]]) -> list[set[int]]:\n    \"\"\"Connect square indices whose rendered 3x3 blocks share an edge.\"\"\"\n    neighbors = [set() for _ in centers]\n    for i, (r1, c1) in enumerate(centers):\n        for j, (r2, c2) in enumerate(centers[i + 1 :], start=i + 1):\n            dr = abs(r1 - r2)\n            dc = abs(c1 - c2)\n            if (dr == SQUARE_SIZE and dc < SQUARE_SIZE) or (dc == SQUARE_SIZE and dr < SQUARE_SIZE):\n                neighbors[i].add(j)\n                neighbors[j].add(i)\n    return neighbors\n\n\ndef _assign_square_ids(centers: list[tuple[int, int]]) -> list[int] | None:\n    \"\"\"Assign all color ids while preventing same-color touching squares.\"\"\"\n    neighbors = _touch_graph(centers)\n    order = list(range(len(centers)))\n    random.shuffle(order)\n    order.sort(key=lambda i: len(neighbors[i]), reverse=True)\n    ids: list[int | None] = [None] * len(centers)\n    required = set(range(NUM_COLOR_PAIRS))\n\n    def backtrack(pos: int, used: set[int]) -> bool:\n        if pos == len(order):\n            return used == required\n        if len(required - used) > len(order) - pos:\n            return False\n        i = order[pos]\n        choices = list(range(NUM_COLOR_PAIRS))\n        random.shuffle(choices)\n        for color_id in choices:\n            if any(ids[j] == color_id for j in neighbors[i]):\n                continue\n            ids[i] = color_id\n            if backtrack(pos + 1, used | {color_id}):\n                return True\n            ids[i] = None\n        return False\n\n    if not backtrack(0, set()):\n        return None\n    return [int(x) for x in ids]\n\n\ndef _build_grids(\n    centers: list[tuple[int, int]],\n    square_ids: list[int],\n    sprite_colors: list[int],\n    marker_colors: list[int],\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return an assembled input grid and the matching oracle output.\"\"\"\n    out = np.full(FIELD_SHAPE, BACKGROUND_COLOR, dtype=int)\n    lower = np.full(FIELD_SHAPE, BACKGROUND_COLOR, dtype=int)\n    for (r, c), idx in zip(centers, square_ids):\n        patch = np.full((SQUARE_SIZE, SQUARE_SIZE), sprite_colors[idx], dtype=int)\n        paste(out, patch, r - SQUARE_RADIUS, c - SQUARE_RADIUS)\n        lower[r, c] = marker_colors[idx]\n\n    legend = np.full((LEGEND_HEIGHT, FIELD_WIDTH), BACKGROUND_COLOR, dtype=int)\n    for i, (sprite, marker) in enumerate(zip(sprite_colors, marker_colors)):\n        c0 = i * LEGEND_COLUMN_STRIDE\n        legend[:SQUARE_SIZE, c0 : c0 + SQUARE_SIZE] = sprite\n        legend[LEGEND_MARKER_ROW, c0 + SQUARE_RADIUS] = marker\n\n    sep = np.full((1, FIELD_WIDTH), SEPARATOR_COLOR, dtype=int)\n    return np.vstack([legend, sep, lower]), out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    sprite_colors, marker_colors = _color_pairs()\n    n_squares = random.choice(SQUARE_COUNT_CHOICES)\n    centers = _place_centers(n_squares)\n    if centers is None:\n        return None\n    square_ids = _assign_square_ids(centers)\n    if square_ids is None:\n        return None\n\n    inp, out = _build_grids(centers, square_ids, sprite_colors, marker_colors)\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid 20fb2937 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\"","aggregated_output":"from __future__ import annotations\n\nimport math\n\nimport numpy as np\n\nfrom arc_utils import bbox, colors_present, crop_bbox, get_bg, label_mask\nimport random\n\n\ndef _count_enclosed_regions(walls: np.ndarray) -> int:\n    labels, n_labels = label_mask(~walls, connectivity=4)\n    h, w = walls.shape\n    count = 0\n    for k in range(1, n_labels + 1):\n        coords = np.argwhere(labels == k)\n        assert coords.size > 0\n        touches_edge = (\n            np.any(coords[:, 0] == 0)\n            or np.any(coords[:, 0] == h - 1)\n            or np.any(coords[:, 1] == 0)\n            or np.any(coords[:, 1] == w - 1)\n        )\n        if not touches_edge:\n            count += 1\n    return int(count)\n\n\ndef _reconstruct_walls(mask: np.ndarray) -> np.ndarray:\n    h, _w = mask.shape\n    col_counts = mask.sum(axis=0)\n    v_threshold = max(3, math.ceil(0.45 * h))\n    vcols = [int(c) for c, n in enumerate(col_counts) if int(n) >= v_threshold]\n    if len(vcols) < 2:\n        return mask.copy()\n\n    row_counts = mask.sum(axis=1)\n    h_threshold = max(3, len(vcols) + 1)\n    hrows = [int(r) for r, n in enumerate(row_counts) if int(n) >= h_threshold]\n    assert len(hrows) >= 2\n\n    walls = np.zeros_like(mask, dtype=bool)\n\n    for r in hrows:\n        for c0, c1 in zip(vcols, vcols[1:]):\n            segment = mask[r, c0 : c1 + 1]\n            length = int(c1 - c0 + 1)\n            hits = int(segment.sum())\n            dense = hits >= max(2, math.ceil(0.45 * length))\n            interior_evidence = length > 2 and hits >= 2 and bool(segment[1:-1].any())\n            if dense or interior_evidence:\n                walls[r, c0 : c1 + 1] = True\n\n    for c in vcols:\n        for r0, r1 in zip(hrows, hrows[1:]):\n            segment = mask[r0 : r1 + 1, c]\n            length = int(r1 - r0 + 1)\n            hits = int(segment.sum())\n            if hits >= max(2, math.ceil(0.45 * length)):\n                walls[r0 : r1 + 1, c] = True\n\n    return walls\n\n\ndef _room_count_for_color(g: np.ndarray, color: int) -> int:\n    b = bbox(g == int(color))\n    assert b is not None\n    mask = crop_bbox(g == int(color), b).astype(bool)\n    walls = _reconstruct_walls(mask)\n    return _count_enclosed_regions(walls)\n\n\ndef _walls_for_color(g: np.ndarray, color: int) -> np.ndarray:\n    b = bbox(g == int(color))\n    assert b is not None\n    r0, c0, r1, c1 = b\n    mask = crop_bbox(g == int(color), b).astype(bool)\n    walls = _reconstruct_walls(mask)\n    out = np.zeros_like(g, dtype=bool)\n    out[r0 : r1 + 1, c0 : c1 + 1] = walls\n    return out\n\n\ndef _cover_order(g: np.ndarray, group: list[tuple[int, int, np.ndarray]]) -> list[tuple[int, int, np.ndarray]]:\n    if len(group) == 1:\n        return group\n\n    by_color = {int(item[0]): item for item in group}\n    above: dict[int, set[int]] = {color: set() for color, _rooms, _walls in group}\n    indegree: dict[int, int] = {color: 0 for color, _rooms, _walls in group}\n\n    for i, (ca, _ra, wa) in enumerate(group):\n        for cb, _rb, wb in group[i + 1 :]:\n            overlap = wa & wb\n            if not bool(overlap.any()):\n                continue\n            visible = set(int(v) for v in np.unique(g[overlap]))\n            top_colors = visible & {int(ca), int(cb)}\n            assert len(top_colors) == 1\n            top = top_colors.pop()\n            under = int(cb) if top == int(ca) else int(ca)\n            if top not in above[under]:\n                above[under].add(top)\n                indegree[top] += 1\n\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    remaining = set(by_color)\n    while remaining:\n        ready = [color for color in remaining if indegree[color] == 0]\n        assert len(ready) == 1\n        color = ready[0]\n        remaining.remove(color)\n        ordered.append(by_color[color])\n        for nxt in above[color]:\n            indegree[nxt] -= 1\n    return ordered\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n\n    Input structure:\n    - Black background with several axis-aligned colored line drawings.\n    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n\n    Rule:\n    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n    - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n    - The color with no enclosed region is the noise/pad color.\n    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n\n    Key insight:\n    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg == 0\n\n    counts: list[tuple[int, int, np.ndarray]] = []\n    for color in colors_present(g, exclude={bg}):\n        rooms = _room_count_for_color(g, int(color))\n        walls = _walls_for_color(g, int(color))\n        counts.append((int(color), int(rooms), walls))\n\n    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n    assert drawings\n    assert len(pad_colors) == 1\n\n    pad = int(pad_colors[0])\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n        group = [item for item in drawings if item[1] == rooms]\n        ordered.extend(_cover_order(g, group))\n\n    width = max(rooms for _color, rooms, _walls in ordered)\n\n    out = np.full((len(ordered), width), pad, dtype=int)\n    for r, (color, rooms, _walls) in enumerate(ordered):\n        out[r, :rooms] = int(color)\n    return out\n\n# --------------- generator (claude-opus-4-6) ---------------\n\n# ---- CFG: Tunable generation parameters ----\n_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n    5: (25, 30, 25, 30, 16, 18),\n    4: (22, 30, 22, 30, 18, 22),\n    3: (20, 30, 20, 30, 22, 25),\n}\n_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n_OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n_GEN_RETRIES = 300                   # outer retry limit\n\n\ndef _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n    \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n    if n * min_gap > max_total:\n        return None\n    gaps = [min_gap] * n\n    remaining = max_total - sum(gaps)\n    for i in range(n):\n        extra = min(max_gap - gaps[i], remaining)\n        if extra > 0:\n            add = random.randint(0, extra)\n            gaps[i] += add\n            remaining -= add\n    random.shuffle(gaps)\n    return gaps\n\n\ndef _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n    \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n    if target_rooms == 1:\n        gap_h = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_h - 2))\n        gap_w = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_w - 2))\n        h, w = gap_h + 2, gap_w + 2\n        walls = np.zeros((h, w), dtype=bool)\n        walls[0, :] = True\n        walls[h - 1, :] = True\n        walls[:, 0] = True\n        walls[:, w - 1] = True\n        return walls\n\n    # For target_rooms >= 2: grid of cells, then selectively merge\n    possible_configs = []\n    for nv in range(2, 6):\n        for nh in range(2, 5):\n            cells = (nv - 1) * (nh - 1)\n            if target_rooms <= cells <= target_rooms + 4:\n                possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        for nv in range(2, 7):\n            for nh in range(2, 6):\n                cells = (nv - 1) * (nh - 1)\n                if cells >= target_rooms:\n                    possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        return None\n\n    n_vcols, n_hrows, total_cells = random.choice(possible_configs)\n    n_row_gaps = n_hrows - 1\n    n_col_gaps = n_vcols - 1\n    min_gap, max_gap = _CELL_GAP_RANGE\n\n    if min_gap * n_row_gaps > max_h - 1 or min_gap * n_col_gaps > max_w - 1:\n        return None\n\n    row_gaps = _random_gaps(n_row_gaps, min_gap, max_gap, max_h - 1)\n    col_gaps = _random_gaps(n_col_gaps, min_gap, max_gap, max_w - 1)\n    if row_gaps is None or col_gaps is None:\n        return None\n\n    # Compute line positions from cumulative gaps\n    vcol_positions = [0]\n    for gap in col_gaps:\n        vcol_positions.append(vcol_positions[-1] + gap)\n    hrow_positions = [0]\n    for gap in row_gaps:\n        hrow_positions.append(hrow_positions[-1] + gap)\n\n    frame_h = hrow_positions[-1] + 1\n    frame_w = vcol_positions[-1] + 1\n    walls = np.zeros((frame_h, frame_w), dtype=bool)\n    for r in hrow_positions:\n        walls[r, :] = True\n    for c in vcol_positions:\n        walls[:, c] = True\n\n    cells_to_merge = total_cells - target_rooms\n    if cells_to_merge == 0:\n        return walls\n","exit_code":0,"status":"completed"}}
