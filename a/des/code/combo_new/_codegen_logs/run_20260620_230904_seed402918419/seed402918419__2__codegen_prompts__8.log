/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:557:        color=int(arrow_colors[0]),\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:566:    _commit_placement(grid, occupied, arrow_cells, static_walls, prior_ray_cells, foundation)\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:570:    for color in arrow_colors[1:]:\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:571:        candidate = _plan_collision_arrow(\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:576:            arrow_cells=arrow_cells,\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:584:        _commit_placement(grid, occupied, arrow_cells, static_walls, prior_ray_cells, candidate)\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:590:    if fused_meta[\"prior_stops\"] < target_arrows - 1:\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:599:    scores = [int(item[\"order_key\"][0]) for item in fused_meta[\"per_arrow\"]]\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:600:    if len(scores) != target_arrows or any(a >= b for a, b in zip(scores, scores[1:])):\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:3:# Name: 全网格箭头射线\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:23:#    - D3/0: each meaningful source is now an arrow sprite, not an open frame\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:25:#    - D4/3: the ray starts at the arrow's touchpoint and continues to the\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:27:#    - D5/0: the output keeps the full canvas, so arrows remain visible outside\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:29:#    Example: a top-side arrow has its tip on row r0-1 at column c0+1+k and its\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:30:#    head/shaft extend upward, so the arrow visibly points downward into the\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:33:#    If the arrow uses two colors, the tip color is also the first ray color.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:37:#    2-3 arrows per sample and commonly uses two-color arrows. To avoid visual\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:39:#    vertical rays (top/bottom arrows) or horizontal rays (left/right arrows).\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:45:#      Meaningful arrows have exactly one ring-touching tip.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:51:#    The combo therefore needs a new primitive: detect one arrow tip, infer its\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:56:#    for each ray, then places the matching arrow just outside the corresponding\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:63:#    - arrows visibly replace the old open rectangles\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:64:#    - each arrow points into the frame from the side where the ray starts\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:65:#    - the output keeps the whole scene, so the outside arrow and inside ray are\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:72:#    outline, clearly separated arrows, and uncluttered interior stripes.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:75:#    Monochrome arrows produce solid rays. Two-color arrows alternate along the\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:87:#    - Meaningful components must have exactly one ring hit and a valid arrow-tip\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:93:#    - Distractors must not mimic an arrow touching the ring. The generator keeps\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:201:def _has_arrow_tip(coords: set[tuple[int, int]], tip: tuple[int, int], side: str) -> bool:\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:256:def _decode_arrow_components(\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:287:        if side is None or not _has_arrow_tip(coords, tip, side):\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:360:def _place_arrow_component(\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:387:def _arrow_backbone(side: str, tip: tuple[int, int], length: int) -> list[tuple[int, int]]:\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:487:    Reconstruct full-span interior rays from external arrows while preserving the full canvas.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:491:    - Useful external components are arrow sprites whose tips touch the ring just outside the frame.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:496:    - Reset the frame interior to its fill color, then decode each valid arrow tip as one boundary startpoint.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:498:    - Monochrome arrows produce solid rays; two-color arrows alternate starting from the visible tip color.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:502:      \"the opposite side\" rather than \"another touchpoint\", solving reduces to detecting the arrow tip,\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:515:    decoded = _decode_arrow_components(g, bg=bg, bc=bc, fill=fill, r0=r0, c0=c0, r1=r1, c1=c1)\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:624:        backbone = _arrow_backbone(side, tip, _ARROW_LEN)\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/40/code.py:626:        if not _place_arrow_component(grid, comp_mask, backbone, head, colors, bg):\n/home/lixinyu/snap/new/ceshi/code_combo/6e4f6532/4/code.py:782:def _place_docked_trains(base, bg, regions, label_pool, arrow_color, n_trains, shared_size=None):\n/home/lixinyu/snap/new/ceshi/code_combo/6e4f6532/4/code.py:813:                output[indicator_abs] = arrow_color\n/home/lixinyu/snap/new/ceshi/code_combo/6e4f6532/4/code.py:913:    arrow_color = random.choice(extra_pool)\n/home/lixinyu/snap/new/ceshi/code_combo/6e4f6532/4/code.py:914:    label_pool = [c for c in extra_pool if c != arrow_color]\n/home/lixinyu/snap/new/ceshi/code_combo/6e4f6532/4/code.py:924:        arrow_color,\n/home/lixinyu/snap/new/ceshi/code_combo/6e4f6532/4/code.py:932:        t[\"indicator_color\"] = arrow_color\n/home/lixinyu/snap/new/ceshi/code_combo/6e4f6532/4/code.py:934:    metrics = _combo_metrics(trains, arrow_color)\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/22/code.py:30:   - The generator keeps the path family narrow: two stripe paths come from a\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/22/code.py:32:   - The generator keeps the exterior routing narrow and template-based, so\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:3:# Name: 箭头射线填充\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:25:#    - The useful outer component is now a bent arrow, not an open rectangle.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:27:#    - The arrow's pointing side is read from the tip orientation:\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:28:#         top-ring tip  -> arrow points down\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:29:#         bottom-ring   -> arrow points up\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:30:#         left-ring     -> arrow points right\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:31:#         right-ring    -> arrow points left\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:35:#    - Suppose the frame interior is 6x9 and an arrow tip touches the top ring at\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:38:#    - In this combo, the same tip maps to interior start (0,3), but the arrow is\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:41:#    - If the arrow uses two colors, the tip color is still the first color and\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:49:#    - vertical family: top/bottom arrows create full columns\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:50:#    - horizontal family: left/right arrows create full rows\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:58:#      endpoint is now implicit: it is always the far boundary in the arrow's\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:62:#      components are one-arrow-per-ray with a single startpoint.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:71:#    the cropped interior will be painted, then constructs corner-local bent arrows\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:72:#    outside the frame whose tips project to those starts. Each arrow:\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:77:#    - uses a corner-local outer bend so different arrows stay separated\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:82:#    - the external cues are arrows rather than open rectangular frames\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:84:#    The repeated presence of both top and bottom arrows (or left and right arrows)\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:90:#    the frame. The outer arrows remain parked in separate corner bands around the\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:91:#    frame, so the frame border, startpoints, and arrowheads stay readable.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:94:#    Color behavior remains structural rather than numeric. Monochrome arrows yield\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:95:#    solid rays. Two-color arrows alternate starting from the tip color, so the\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:96:#    only color-order cue needed by the solver is directly visible on the arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:97:#    This also makes direction matter: a top arrow and a bottom arrow on different\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:103:#    - original a6 expects two ring touches and therefore misses the arrows\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:104:#    - D3-only would decode the same bent arrow into an adjacent-side L endpoint,\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:106:#    The generator therefore always builds bent arrows whose adjacent-side tail\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:223:def _has_arrow_tip(coords: set[tuple[int, int]], tip: tuple[int, int], side: str) -> bool:\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:282:    Rebuild full-span interior rays from external bent arrows around a framed rectangle.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:286:    - Useful outer components are bent arrows with exactly one ring-touching tip on the frame.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:292:    - For each valid arrow, map its tip to the corresponding interior boundary cell.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:293:    - Starting from that cell, extend a straight row or column in the arrow's direction until the\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:295:    - Monochrome arrows paint a solid ray; two-color arrows alternate along the ray beginning with\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:300:      arrow direction determines both the ray orientation and which far side acts as the stop.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:341:        if not _has_arrow_tip(coords, tip, start_side):\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:415:def _place_arrow_component(\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:473:def _arrow_specs(kind: str, start_side: str, H: int, W: int, r0: int, c0: int, r1: int, c1: int):\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:647:        inner, backbone, head = _arrow_specs(kind, start_side, H, W, r0, c0, r1, c1)\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/6/code.py:663:        if not _place_arrow_component(grid, comp_mask, backbone, head, colors, bg):\n/home/lixinyu/snap/new/ceshi/code_combo/16b78196/25/code.py:23:#    matching, so the cues only narrow the search.\n/home/lixinyu/snap/new/ceshi/code_combo/e3721c99/6/code.py:55:#    - Each indentation is a single narrow rectangular notch. No extra markers are added.\n/home/lixinyu/snap/new/ceshi/code_combo/16b78196/21/code.py:3:# Name: 终止标记精灵+方向箭头\n/home/lixinyu/snap/new/ceshi/code_combo/16b78196/21/code.py:41:#      examples for both arrow markers and terminal sprites, but the two roles are\n/home/lixinyu/snap/new/ceshi/code_combo/16b78196/21/code.py:44:#    - Decoy notches remain present, so the arrow is not decorative.\n/home/lixinyu/snap/new/ceshi/code_combo/16b78196/21/code.py:86:#    - Only 1-2 small arrow markers are added, and each is placed adjacent to one\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/43/code.py:36:#      - fixed narrow width 5 and heights 5..8,\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/26/code.py:34:#      single-pixel fillers, while avoiding overfitting to a narrower orientation test than the combo\n/home/lixinyu/snap/new/ceshi/code_combo/16b78196/13/code.py:45:#   - The bar length is kept in a narrow but visibly short range (15-19 cells on\n/home/lixinyu/snap/new/ceshi/code_combo/3e6067c3/3/code.py:238:    narrow = fa if int(fa[\"inner_size\"]) <= int(fb[\"inner_size\"]) else fb\n/home/lixinyu/snap/new/ceshi/code_combo/3e6067c3/3/code.py:239:    ib = narrow[\"inner_bbox\"]\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/47/code.py:35:#     - The family is intentionally narrowed to one clear layout instead of the full\n/home/lixinyu/snap/new/ceshi/code_combo/f931b4a8/1/code.py:42:#     - The unused axis is kept narrow (2-4 cells) so the bbox cue is visible\n/home/lixinyu/snap/new/ceshi/code_combo/f931b4a8/3/code.py:37:#      narrow and edge-anchored, so the offset cue is visually clean instead of looking like random scatter.\n/home/lixinyu/snap/new/ceshi/code_combo/16b78196/6/code.py:258:    1. use notch border color to narrow root-piece candidates,\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/14/code.py:37:# - The rectangle stays portrait and narrow (6x5), close to the original task's dense\n/home/lixinyu/snap/new/ceshi/code_combo/16b78196/12/code.py:58:    - each continuation uses a strip that is 1 cell narrower than the previous piece.\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/36/code.py:300:    - The puzzle is no longer solved in one placement pass: color first tells which scraps belong together, then color semantics narrow the vertical band, and finally the ordered row layout resolves which same-band chamber each assembled subcomponent occupies.\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/11/code.py:17:#    To keep the rule visible but not underconstrained, the output family is narrowed to two small\n/home/lixinyu/snap/new/ceshi/code_combo/62593bfd/21/code.py:246:        raise ValueError(\"grid too narrow for crop margins\")\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/35/code.py:72:#       overlap, and the narrow five-column layout keeps the assembled pattern easy to parse.\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/30/code.py:30:#     - The rectangle stays narrow and portrait like the source task, so the family still looks like\n/home/lixinyu/snap/new/ceshi/code_combo/f931b4a8/34/code.py:33:#     because bbox-based size encoding is capped by quadrant size. The fusion therefore narrows\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/11/code.py:9:- The strip-of-frames input format stays the same, but the arrow sprite now uses\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/11/code.py:336:    - Each frame shows one diagonal arrow sprite and the still-unvisited single-pixel markers in the same actor color.\n/home/lixinyu/snap/new/ceshi/code_combo/71e489b6/25/code.py:234:    blue-region outlier,\" while the marker has narrowed from an unrestricted\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/11/code.py:270:    Draw red outer outlines, but count both true holes and deep narrow indentations when choosing the recolor tier.\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/37/code.py:29:#      skipped (<= 10), narrow-halo (11-15), and wide-halo (>= 16).\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/15/code.py:54:# - Human-facing cue 1: in the rightmost frame the arrow points one way while the\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/15/code.py:305:    Key insight: One nearby dot reveals the stride, but the arrow tip no longer\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/34/code.py:21:#      3) a deep narrow indentation that opens to the shell bbox edge.\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/34/code.py:279:      by a green nested object, and some shells instead expose a deep narrow notch from one bbox edge.\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/34/code.py:289:      cavity: an empty enclosed hole, a green nested core, and a deep narrow indentation are all\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/14/code.py:56:#   - Every generated grid contains at least one narrow frame and at least one wide\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/14/code.py:82:#   - The generator rejects layouts that cannot fit both narrow and wide frames under\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/14/code.py:95:#   - Only four colors appear in outputs: yellow background, blue narrow frames, teal\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/14/code.py:286:        \"narrow_count\": 0,\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/14/code.py:303:            metrics[\"narrow_count\"] += 1\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/14/code.py:320:    num_narrow = random.randint(NARROW_COUNT_RANGE[0], min(NARROW_COUNT_RANGE[1], num_components - 1))\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/14/code.py:330:    thicknesses = [NARROW_THICKNESS] * num_narrow\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/14/code.py:331:    thicknesses.extend(random.choice(wide_choices) for _ in range(num_components - num_narrow))\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/14/code.py:394:        if metrics[\"narrow_count\"] < 1 or metrics[\"wide_count\"] < 1:\n/home/lixinyu/snap/new/ceshi/review/db695cfb_parent_review.md:19:| db695cfb | D6 | 2 | 箭头形状指示方向 | 12/12 | ✓ |\n/home/lixinyu/snap/new/ceshi/review/db695cfb_parent_review.md:165:## D6/2 箭头形状指示方向\n/home/lixinyu/snap/new/ceshi/code_combo/aa4ec2a5/12/code.py:55:#    one-pixel 8-neighborhood outlines remain disjoint. Each group is anchored in a narrow column\n/home/lixinyu/snap/new/ceshi/code_combo/71e489b6/36/code.py:26:#    black cells. Example on a narrow black stripe:\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/21/code.py:30:#    - The template family stays small and arrow-like: one unique tip plus 1-2\n/home/lixinyu/snap/new/ceshi/review/db695cfb_parent_review.json:911:      \"variant_name\": \"箭头形状指示方向\",\n/home/lixinyu/snap/new/ceshi/review/db695cfb_parent_review.json:912:      \"prompt_variant_name\": \"箭头形状指示方向\",\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/30/code.py:207:    - The grid itself is a long narrow window: either 5x15..18 or 15..18x5.\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/12/code.py:259:    - The informative object is an extreme-aspect-ratio band, either narrow-horizontal or narrow-vertical; the third color is padding only.\n/home/lixinyu/snap/new/ceshi/review/b10624e5_prompt_doc_summary.json:47:    \"change_line\": \"锚块内部的空洞作为目标槽位 — 目标锚块改为空心结构（内部有洞），缩放后的图案需要填充进锚块内部的空洞中。类似拼图嵌合，解题者需要同时考虑缩放和空间限制。\",\n/home/lixinyu/snap/new/ceshi/review/b10624e5_prompt_doc_summary.json:61:    \"change_line\": \"图案平铺填满目标象限空余区域 — 缩放后的图案不只放置一次，而是像瓷砖一样平铺填满目标象限中锚块以外的所有空余区域。解题者需要推断平铺规则和边界裁剪。\",\n/home/lixinyu/snap/new/ceshi/review/b10624e5_prompt_doc_summary.json:159:    \"change_line\": \"箭头标记指示反射方向 — 每个目标象限附近有方向性标记像素（如单像素偏移构成的箭头），指示该象限的反射方式。反射轴不再由象限位置唯一确定，而需要读取标记。\",\n/home/lixinyu/snap/new/ceshi/review/b10624e5_prompt_doc_summary.json:160:    \"doc_first\": \"Copy the TL motif into the other quadrants, scaling by anchor size and mirroring by arrow markers.\",\n/home/lixinyu/snap/new/ceshi/review/b10624e5_prompt_doc_summary.json:187:    \"change_line\": \"图案在锚块内部（重叠） — 源图案覆盖在锚块上方（与锚块像素重叠），通过与锚块颜色不同来区分。目标同样将缩放后的图案叠加到目标锚块上。需要处理颜色叠加逻辑。\",\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/4/code.py:64:# Marker templates are centered on the landing cell. The arrow direction becomes\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/4/code.py:83:#   arrow glyphs. The center of each glyph is still the landing cell, but the\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/4/code.py:88:#   2. The consumed marker at H1 carries an arrow, say \"Down\".\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/4/code.py:91:#   4. Therefore the same visible arrow on the marker is both a turn command\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/4/code.py:98:# - Only one extra object family is introduced: a compact 5-cell arrow glyph in\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/4/code.py:134:#   while the consumed marker's own arrow tells \"how to face next\".\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/4/code.py:143:#   merges with the arrow glyphs.\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/4/code.py:147:#   arrows, the last snapshot remains readable even with multi-step lookahead.\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/4/code.py:338:    - Each frame contains one actor-colored triangle plus marker-colored mini-arrow glyphs whose center cells are future landing points.\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/4/code.py:343:    - When a marker is consumed, the marker's own arrow sets the new facing; if markers remain, that arrow direction must also be the direction of the next marker that will be consumed from the new head.\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/4/code.py:346:    Key insight: The triangle tip tells you which marker is eaten now, while the eaten marker's arrow tells you how the sprite must face for the next leg, so every step couples local consumption with one-step lookahead.\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/13/code.py:80:#      current arrow, the remaining markers, and the already-painted prefix trail.\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/22/code.py:17:#    Keep the original frame strip and the original arrow geometry, but fuse\n/home/lixinyu/snap/new/ceshi/code_combo/cb2d8a2c/33/code.py:54:#    narrow connectors, so the output reads as one coherent serpentine region\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:3:# Name: 箭头标记与镜像\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:7:#   The old 4-cell T is replaced by a 5-cell arrow. We keep the original logical anchor:\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:9:#   but the marker now adds one tail cell behind that center. For stem RIGHT, the arrow cells are\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:12:#   region the arrow comes out of, read from the tail-side ownership around (r,c-1). The visual\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:17:#   arrow-driven recoloring is complete.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:21:#   using blue. Here the arrow \">\" does the same recolor first. If the grid also contains a\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:23:#   the erased arrow-colored patch appears on the opposite side, so a human must not read the\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:26:#   The arrow keeps only four axial directions, so the rule family does not explode, but the\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:28:#   5-cell silhouette rather than a 4-cell T. The generator keeps multiple arrows per board and\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:33:#      That no longer holds for colored arrows: the color-1 part is a 3-cell head cluster plus\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:34:#      one singleton tail around a colored center. The solver therefore parses normal arrows from\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:35:#      5-cell color-1 components and colored arrows by local geometry around each non-1 center.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:36:#   2. The old source lookup from off-marker diagonal cells no longer applies, because the arrow's\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:38:#      source from the arrow tail: the marker emerges from that region and points across the border.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:40:#      after explicit arrow cells are masked out. This remains safe because arrow cells are marked\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:43:#      unflipped arrows, while `main()` applies the L9-triggered flip only afterward.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:45:#   The generator reserves every arrow cell plus a neighbor buffer, so normal arrows stay isolated\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:46:#   5-cell color-1 components. Colored arrows get a stronger buffer: the tail must remain a 1-cell\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:48:#   solver uses those exact component sizes to recognize the colored-arrow pattern.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:100:def _arrow_cells(center: tuple[int, int], stem: tuple[int, int]) -> set[tuple[int, int]]:\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:114:def _arrow_branch_cells(center: tuple[int, int], stem: tuple[int, int]) -> set[tuple[int, int]]:\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:115:    return _arrow_cells(center, stem) - {tuple(map(int, center))}\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:118:def _arrow_source_diagonals(center: tuple[int, int], stem: tuple[int, int]) -> list[tuple[int, int]]:\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:126:def _arrow_tail(center: tuple[int, int], stem: tuple[int, int]) -> tuple[int, int]:\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:130:def _arrow_front_cluster(center: tuple[int, int], stem: tuple[int, int]) -> set[tuple[int, int]]:\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:134:    return {front, *_arrow_source_diagonals(center, stem)}\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:137:def _arrow_neighborhood(center: tuple[int, int], stem: tuple[int, int]) -> set[tuple[int, int]]:\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:138:    cells = _arrow_cells(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:148:def _parse_arrow_pentomino(\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:156:            if cells == _arrow_cells(center, stem):\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:193:        parsed = _parse_arrow_pentomino(cells)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:209:                branch = _arrow_branch_cells(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:216:                tail = _arrow_tail(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:217:                front_cluster = _arrow_front_cluster(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:238:            assert len(matches) <= 1, \"colored arrow center must have a unique orientation\"\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:258:    assert all_one_cells == used_ones, \"all color-1 pixels must belong to an arrow control marker\"\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:305:            assert dest is not None, \"arrow marker must point at a destination region\"\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:307:            tail_counts = adjacent_component_counts({_arrow_tail(center, stem)})\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:308:            assert tail_counts, \"arrow tail must touch its source-side region\"\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:340:        assert final_color[dest] in {root_color[dest], replacement}, \"conflicting arrow controls for one region\"\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:404:    Recolor mosaic regions from arrow-shaped boundary controls, erase those controls, and optionally mirror the finished mosaic from a color-9 L marker.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:408:    - Color 1 now forms 5-cell arrows instead of T tetrominoes: a 3-cell shaft plus a 2-cell diagonal arrowhead.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:409:    - Some arrows use a colored middle shaft cell with four surrounding color-1 arrow cells; that middle color is a literal replacement color.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:413:    - For each arrow, the shaft direction points toward the destination region; read that destination from the first base region reached two steps ahead of the arrow's middle cell.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:414:    - The source side is the region the arrow emerges from at its tail; a plain color-1 arrow copies that source region's original color, while a colored-center arrow uses its center color instead.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:415:    - After recoloring, every arrow cell is filled with the final color of the source-side region.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:419:    - The arrow tells you what changes before any global transform happens, while the L only flips the completed answer; if you mentally flip first, the arrow directions become misleading.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:426:# --------------- generator (arrowflip) ---------------\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:544:                cells = _arrow_cells(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:549:                if _arrow_neighborhood(center, stem) & occupied_cells:\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:553:                tail = _arrow_tail(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:590:    cells = _arrow_cells(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:593:        occupied_neighbors |= (_arrow_neighborhood(center, stem) - cells)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:596:    tail = _arrow_tail(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:597:    front_cluster = _arrow_front_cluster(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:610:        if nb not in _arrow_branch_cells(center, stem):\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:621:            for rr, cc in _arrow_cells(center, stem):\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:625:            for rr, cc in _arrow_branch_cells(center, stem):\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:632:        for rr, cc in _arrow_cells(center, stem):\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:649:        all_marker_cells |= _arrow_cells(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/12/code.py:23:# - The visible vocabulary stays the same: each frame has one actor-colored arrow\n/home/lixinyu/snap/new/ceshi/code_combo/5545f144/12/code.py:329:    Continue a multi-frame marker-consuming arrow simulation whose body phase changes after every landing.\n/home/lixinyu/snap/new/ceshi/code_combo/a32d8b75/26/code.py:644:        narrowed = [c for c in subset if score_fn(c) == best]\n/home/lixinyu/snap/new/ceshi/code_combo/a32d8b75/26/code.py:645:        if narrowed:\n/home/lixinyu/snap/new/ceshi/code_combo/a32d8b75/26/code.py:646:            subset = narrowed\n/home/lixinyu/snap/new/ceshi/code_combo/cb2d8a2c/12/code.py:22:#      rows below the left bar, their thick diagonal halos overlap in the center and leave a narrow\n/home/lixinyu/snap/new/ceshi/code_combo/cb2d8a2c/12/code.py:39:#      D10/0 requires overlapping halos and narrow channels, so the generator now chooses very\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/31/code.py:19:#    direction. This combo narrows that geometry to one specific family: a 1-pixel rectangular\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:4:#   -> 箭头像素指示方向\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:5:\"\"\"Variant of 3dc255db with arrow-indicated ejection direction.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:17:     L-shaped arrow is attached near the tail side. The arrow is 8-connected to\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:20:   - The arrow is placed so the old bbox-based spike heuristic is no longer safe:\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:21:     the merged border component's outer bbox includes the arrow, so the cup body\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:22:     must be recovered by identifying and removing that arrow candidate first.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:25:     cup has a small same-color arrow above it. The merged component's top edge is\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:26:     now widened by the arrow, so \"unique top-edge spike\" is no longer reliable.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:27:     The new solver removes the 3-cell arrow candidate, observes the arrow lies\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:34:   - Each cup always has exactly one arrow, and the arrow always uses the cup's\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:36:   - The arrow may lean to either perpendicular side of the ray, so the samples do\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:41:     This is false now because the arrow is merged into the same 8-connected\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:44:   - Original mouth flood is still valid, but only after stripping the arrow.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:49:       4. derive direction from which side the arrow lies on relative to that cup.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:51:     such valid arrow candidate. The generator enforces that.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:55:     same-color arrow offset near the tail side.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:56:   - The arrow is kept off the direct ejection path, so the output line never\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:57:     overwrites the arrow.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:58:   - Placement checks use the combined cup+arrow patch, so arrows do not overlap\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:62:   - Humans can see a cup plus a small same-color arrow near one side. The output\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:65:   - This does not degenerate to the original rule because the arrow is merged\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:70:   - The arrow stays adjacent to its own cup and uses the same border color, so it\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:76:   - No new color mapping is introduced. The arrow reuses the cup border color.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:81:   - Assumption: each processed border component has one removable 3-cell L arrow\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:83:   - Assumption: the arrow lies completely beyond exactly one side of the cup\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:84:     body's bbox. Guaranteed by generator's fixed arrow templates.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:85:   - Assumption: after removing the arrow, the cup body still has one spike on the\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:86:     arrow-indicated side. Guaranteed because the underlying cup body is the\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:152:def _enumerate_arrow_candidates(border_set: set[tuple[int, int]]) -> list[set[tuple[int, int]]]:\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:168:def _arrow_side(arrow_cells: set[tuple[int, int]], cup_bbox: tuple[int, int, int, int]) -> str | None:\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:169:    ar0, ac0, ar1, ac1 = bbox_coords(np.array(sorted(arrow_cells), dtype=int))\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:201:    - Each cup border component includes a same-color 3-pixel arrow marker.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:203:    - The side on which the arrow sits determines the ejection direction.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:222:            for arrow_cells in _enumerate_arrow_candidates(border_set):\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:223:                cup_set = border_set - arrow_cells\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:228:                tail_dir = _arrow_side(arrow_cells, cup_bbox)\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:403:def _attach_arrow(\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:411:    \"\"\"Expand the original cup patch with a same-color 3-cell arrow.\"\"\"\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:413:    arrow_template = ARROW_OFFSETS[direction][int(rng.integers(0, 2))]\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:414:    arrow_coords = [(spike[0] + dr, spike[1] + dc) for dr, dc in arrow_template]\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:416:    all_coords = border_coords + arrow_coords\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:425:    for r, c in arrow_coords:\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:560:    patch, spike, mouth, cup_bbox_local = _attach_arrow(\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/37/code.py:31:#    period (AABB). This keeps the rule rich enough to be seen but narrow enough\n/home/lixinyu/snap/new/ceshi/code_combo/edb79dae/11/code.py:525:# The generator keeps the original global geometry family but narrows some degrees of freedom so the\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/32/code.py:28:#      k-th outward depth layer remains visible, where k is 2 for narrow/medium\n/home/lixinyu/snap/new/ceshi/code_combo/a32d8b75/28/code.py:67:#    - The legend still uses one narrow column block per side, so symbols remain easy\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/38/code.py:30:#    - 由端点射出两条斜边的几何失效: 现在应由每个缺口两侧的墙尖端分别发射平行射线，形成多条独立带区。\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/38/code.py:381:    - An outer-arc gap emits a narrow band toward the right side of the grid, while a bridge gap emits a vertical band toward the nearest border; each band is bounded by rays launched from the two wall tips around that gap.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:36:#             and carve a virtual breach through the capped side selected by the arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:43:#        and places the outside arrow one gap away from the mouth side.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:49:#      separate from the outside arrow and from sparse obstacles.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:50:#    - The outside arrow has only four possible directions and always uses one 2-pixel\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:69:#      obstacle. That would incorrectly make the external arrow cast shadows, so the\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:73:#      arrow first and then score the trigger's 4-neighbors by dot product with that\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:74:#      arrow direction.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:93:#      for where the exterior radiation should go is the detached 2-pixel arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:94:#    - Across examples the same wall family appears with different arrow directions\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:99:#    - The two markers live in different zones: trigger on the wall, arrow outside\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:102:#      that could be mistaken for the outside arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:118:#      distances from its two pixels; generator makes that the only external arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:121:#    - The trigger has at least one passable 4-neighbor in the arrow direction and\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:332:    - Treat the trigger as part of the wall, decode the arrow to decide which capped side becomes a virtual opening, and start flood-fill from the trigger's inner-side neighbor.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:335:    Key insight: Neither old cue survives on its own: the fill source is no longer inside the enclosure, and the opening is no longer visible in the wall shape, so the solver must combine the border trigger with the detached arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:436:    assert best_score > 0, \"expected trigger interior to lie in the arrow-selected direction\"\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:635:    dist_arrow = distance_transform_cdt(~dir_marker_mask, metric=\"chessboard\")\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/15/code.py:636:    eligible = (grid == bg) & (dist_solid > 1) & (dist_arrow > 1)\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/17/code.py:72:    Key insight: The endpoints no longer define immediate full-width radiation; they identify a narrow outlet, and the exterior fill must respect a fixed bottleneck width first, then a gradually widening cone.\n/home/lixinyu/snap/new/ceshi/code_combo/edb79dae/6/code.py:10:#    - Combo: the frame interior is blank. Instead, single-cell markers sit in a narrow band left of\n/home/lixinyu/snap/new/ceshi/code_combo/edb79dae/6/code.py:153:    - Just outside the frame, a narrow band on the left carries colored row markers and a narrow band\n/home/lixinyu/snap/new/ceshi/code_combo/edb79dae/28/code.py:23:#    output shows a large silhouette with a narrow smaller-color trace inside the overlap.\n/home/lixinyu/snap/new/ceshi/code/2d0172a1/D4/2/code.py:40:#     The variant is intentionally narrow: every canonical frame always uses exactly two\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/24/code.py:72:#     - each generated sprite has nozzle width 1 or 2, both visually legible in a narrow left pane\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/23/code.py:33:# - The right pane is narrowed only slightly less than the seed task: width is kept in 3..4.\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/22/code.py:201:    - A full-height grey (5) separator column splits a narrow left ray pane from a wider right sprite pane.\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/36/code.py:171:    - A single full-height grey separator column splits the grid into a wider left pane and a narrow right pane.\n/home/lixinyu/snap/new/ceshi/code/2d0172a1/D10/1/code.py:38:#     the variant is intentionally narrow: only output shape changes\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/35/code.py:192:    - A full-height grey (5) separator splits the grid into a wide left pane and a narrow right pane.\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/6/code.py:146:    - A full-height grey (5) separator column divides the grid into a wide left sprite pane and a narrow right ray pane.\n/home/lixinyu/snap/new/ceshi/code/16b78196/D8/1/code.py:51:    - that cavity spans a strip exactly 1 cell narrower than the previous piece.\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/13/code.py:204:    - One full-height grey (5) separator column splits the grid into a left sprite field and a narrow right chamber.\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/30/code.py:350:    assert flush_c0 >= 0, \"left pane too narrow for 3x3 sprites\"\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/10/code.py:16:#       separator column, and a narrow right pane that starts as plain background.\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/10/code.py:38:#       emitter fraction, and narrow right pane.\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/10/code.py:150:    - A single full-height grey separator column divides a left sprite pane from a narrow right pane.\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/9/code.py:200:    - A single full-height grey (5) separator column splits the board into a left sprite pane and a narrow right pane.\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/21/code.py:23:#      one ignored 1x1 trigger-side hole, one narrow-but-valid area>=2 hole with width 1,\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/21/code.py:49:#      wide and narrow emitters into a single indistinct block.\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/21/code.py:52:#      same separator-facing column as the others but produces no red; a narrow valid cavity\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/12/code.py:35:#      narrow (2-4 rows) just like the original right receiving pane stayed narrow.\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/15/code.py:69:#   red/blue diagonals while narrow-hole examples produce dashed red diagonals, and both kinds stop\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/20/code.py:38:#   - main() now assumes a narrow-left / wide-right layout. The generator guarantees\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/20/code.py:57:#     pane, and outputs that are narrower than inputs because only the right pane is\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/20/code.py:113:    - A full-height grey (5) separator sits near the left edge, leaving a narrow sprite pane on the left and a much wider empty pane on the right.\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/20/code.py:132:        f\"expected narrow-left / wide-right panes, got left_w={sep}, right_w={right_w}\"\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:3:# Name: 箭头指示方向+距离编码射线长度\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:31:    - each control is now a 3-cell L-shaped arrow touching exactly one border:\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:39:      arrow's border position encodes one of three visible depth bins by distance\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:45:        top arrow at column 8 on a 20-wide grid is near the top-edge midpoint,\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:46:        so after decoding a downward arrow the solver draws a long vertical ray on\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:47:        column 8. A top arrow at column 7 is farther from the midpoint, so the\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:52:  - I keep only one extra shape family: four cardinal arrow orientations. That\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:63:    one arrow would look like three controls. New solver first extracts 4-connected\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:72:    the full 3-cell arrow must be preserved in output.\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:75:    come from decoded arrow launches.\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:79:    `[1, H-2]`, so every arrow touches exactly one border.\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:81:    arrows never overlap fg.\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:89:  - A human can see arrow orientation directly from the 3-cell corner shape and\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:104:  - All ctrl cells belong to 1 or 2 size-3 L-shaped arrow components.\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:146:def _decode_arrow(comp: list[tuple[int, int]], H: int, W: int) -> dict[str, object]:\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:182:        raise AssertionError(\"Unexpected control arrow shape\")\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:187:def _find_arrows(g: np.ndarray, ctrl: int) -> list[dict[str, object]]:\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:188:    arrows = [_decode_arrow(comp, *g.shape) for comp in _components4(g == int(ctrl))]\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:189:    arrows.sort(key=lambda a: (str(a[\"edge\"]), tuple(a[\"launch\"])))\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:190:    return arrows\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:320:    arrows = _find_arrows(g, ctrl)\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:324:    for arrow in arrows:\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:325:        edge = str(arrow[\"edge\"])\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:326:        launch_r, launch_c = tuple(int(x) for x in arrow[\"launch\"])\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:336:    for arrow in arrows:\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:340:            str(arrow[\"edge\"]),\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:341:            tuple(int(x) for x in arrow[\"launch\"]),\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:348:    for arrow in arrows:\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:349:        for r, c in tuple(arrow[\"cells\"]):\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:395:    Decode each border arrow, use its orientation as ray direction and its border\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:426:def _make_arrow(edge: str, split: int, H: int, W: int) -> tuple[set[tuple[int, int]], tuple[int, int]]:\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:467:def _count_nonlong_arrows(arrows: list[dict[str, object]], H: int, W: int) -> int:\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:469:    for arrow in arrows:\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:470:        launch_r, launch_c = tuple(int(x) for x in arrow[\"launch\"])\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:471:        edge = str(arrow[\"edge\"])\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:494:    arrows: list[dict[str, object]] = []\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:504:            cells, launch = _make_arrow(edge, int(c_split), H, W)\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:505:            arrows.append({\"edge\": edge, \"cells\": cells, \"launch\": launch})\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:511:            cells, launch = _make_arrow(edge, int(r_split), H, W)\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:512:            arrows.append({\"edge\": edge, \"cells\": cells, \"launch\": launch})\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:745:    for arrow in arrows:\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:746:        for r, c in set(arrow[\"cells\"]):\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:749:    if _count_nonlong_arrows(arrows, H, W) < 1:\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:778:    arrows = _find_arrows(g, ctrl)\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:780:    nonlong_controls = int(_count_nonlong_arrows(arrows, H, W))\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:783:    for arrow in arrows:\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:784:        edge = str(arrow[\"edge\"])\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/37/code.py:785:        launch = tuple(int(x) for x in arrow[\"launch\"])\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D7/1/code.py:52:#     - For multi-cup inputs the generator constrains cup centers to a narrow shared row band\n/home/lixinyu/snap/new/ceshi/code/898e7135/D14/0/code.py:126:    assert w >= 2, \"grid too narrow for legend\"\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/28/code.py:48:  - The legend vocabulary is intentionally small: only two 3-cell arrow-like glyphs,\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D5/3/code.py:39:# - The variant is intentionally narrow: corridor geometry, turn shapes, and\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:3:# Name: 箭头指示方向+颜色编码指令\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:10:- 原题的控制源是边缘单像素；这里改成 3 像素、4 连通、单色的 L 形箭头。箭头朝向即发射方向：\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:16:- 具体例子：若顶部是红箭头、左侧是青箭头，则 vertical split 由顶部箭头给出，horizontal split 由左箭头给出。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:21:- 与原题相比，解题链从“看边缘单点”变成“先识别 L 形箭头朝向，再读箭头颜色的动作语义”。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:24:- 方向只有四种箭头朝向，动作只有两种颜色指令，离散档位很少，避免自由度过多。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:30:- 原 solver 假设 `np.argwhere(g == ctrl)` 得到的每个点都是独立发射源；融合后不成立，必须先对所有控制色像素做 4 连通分量分组，再把每个 3 像素分量解码成一个箭头。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:32:- 原 generator 假设输出 ray 只有一种控制色、控制符号只有单像素；融合后必须输出整支箭头，并用各自颜色重画 ray。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:35:- 箭头 split 坐标限制在 40%-60% 且远离角落，并额外约束在 `[1, W-2]` 或 `[1, H-2]`，保证 2x2 箭头框完全落在网格内且只接触一条边。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:36:- sprite 仍保持四周至少 4 格 margin，因此箭头与 sprite、split-line fg、角落输出 piece 均不重叠。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:40:- 输入里箭头形状本身直接暴露“方向是从形状读出来，而不是只看所在边”。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:41:- 输出里 ray 使用与箭头相同的颜色，颜色指令在输入和输出中都重复出现。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:42:- 生成器偏向混色双箭头，并强制旋转受影响 piece 非 90 度对称，因此观察者能从少量样例看出“某色箭头附近的片段会转向后进角落”。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:50:- 颜色变化总是伴随固定结构线索：同色箭头 + 同色 ray + 与该控制边接壤的区域动作一致。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:51:- 为防退化，生成器在末尾显式比较“融合规则输出”与“忽略颜色、只按箭头平移”的基线；只要存在旋转受影响区域，就要求两者输出必须不同。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:54:- `rotating_kept_regions`: 当前样例中受青色箭头影响、应发生旋转的保留区域数量。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:55:- `changed_pixels_vs_move_only`: 融合 solver 输出与“同样解箭头、但忽略颜色只平移”的基线输出的像素差数量。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:59:- 所有控制像素恰好组成 1 或 2 个 3 像素、单色、4 连通的 L 形箭头；generator 保证这一点。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:60:- 最多一个 vertical split、最多一个 horizontal split；generator 只在互相垂直的边上放置箭头。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:199:def _decode_arrow(comp: list[tuple[int, int]], H: int, W: int) -> dict[str, object]:\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:234:        raise AssertionError(\"Unexpected arrow shape\")\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:257:        arrow = _decode_arrow(comp, H, W)\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:258:        arrow[\"color\"] = int(color)\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:259:        controls.append(arrow)\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:367:    - 先把边缘控制对象识别成 3 像素 L 形箭头，并由形状恢复 inward ray 的方向与 split 行/列。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:369:    - 再由箭头颜色决定各保留区域的动作：\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:452:def _make_arrow(edge: str, split: int, H: int, W: int) -> tuple[set[tuple[int, int]], tuple[int, int]]:\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:524:            cells, launch = _make_arrow(edge, c_split, H, W)\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/6/code.py:528:            cells, launch = _make_arrow(edge, r_split, H, W)\n/home/lixinyu/snap/new/ceshi/code/28a6681f/D2/0/code.py:22:#       into the narrow side column. In this variant, adjacent corner-style exits are dead:\n/home/lixinyu/snap/new/ceshi/code/28a6681f/D2/0/code.py:49:#     - Therefore the variant redefines horizontal reachability narrowly: the drop column must\n/home/lixinyu/snap/new/ceshi/code/28a6681f/D2/0/code.py:95:    shafts plus longer flat shelves, so narrow step chutes no longer connect basins.\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D5/0/code.py:24:#    would look like the original narrow stripe or a solid rectangle. Freedom is still\n/home/lixinyu/snap/new/ceshi/code/28a6681f/D1/1/code.py:207:    Move a compact water plug through a wall-bounded corridor until the corridor ends or narrows.\n/home/lixinyu/snap/new/ceshi/code/28a6681f/D1/1/code.py:212:    - The source plug starts at one endpoint of the reachable corridor. Downstream sections may bend and may later narrow.\n/home/lixinyu/snap/new/ceshi/code/28a6681f/D1/1/code.py:218:    - Relocate the plug to the last reachable placement before the corridor terminates or becomes too narrow.\n/home/lixinyu/snap/new/ceshi/code/221dfab4/D12/2/code.py:41:#    steps, and unless at least two decoded green stripes visibly flood pixels outside the narrow span. This makes the\n/home/lixinyu/snap/new/ceshi/code/28a6681f/D1/2/code.py:16:#    \"air\" is no longer the transport medium. Instead, color 8 marks a narrow pipe network.\n/home/lixinyu/snap/new/ceshi/code/221dfab4/D10/1/code.py:29:#    stripe's current narrowed span. Green stripes still recolor the entire row/column's\n/home/lixinyu/snap/new/ceshi/code/221dfab4/D10/1/code.py:30:#    existing non-background pixels to green before repainting the narrowed stripe cells.\n/home/lixinyu/snap/new/ceshi/code/221dfab4/D10/1/code.py:49:#    and at least one green flood changes a foreground pixel outside the narrowed stripe.\n/home/lixinyu/snap/new/ceshi/code/8f3a5a89/D1/2/code.py:54:#      examples and infer that some slits are too narrow to count as passable.\n/home/lixinyu/snap/new/ceshi/code/28a6681f/D3/1/code.py:240:    - The remaining colors form fixed shelves, walls, and narrow reservoirs anchored to the lower half.\n/home/lixinyu/snap/new/ceshi/code/38007db0/D5/2/code.py:90:#     much shorter/narrower than the original single-column lattice\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D15/2/code.py:28:#    particle still sits on the border, but it now has one dedicated adjacent arrow-marker\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D15/2/code.py:45:#    is rotated by 0/90/180/270 degrees and every start gets an explicit arrow marker. This\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D15/2/code.py:52:#    - Treating only {BG, PARTICLE} as passable would make the arrow marker act like a wall.\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D15/2/code.py:66:#    Using one dedicated arrow color avoids overloading corridor colors. Markers only appear\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D15/2/code.py:74:#    - Each movable particle is on the border and has exactly one 4-neighbor arrow marker.\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D15/2/code.py:75:#    - The arrow marker color appears only in these local start pairs.\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D15/2/code.py:121:    \"\"\"Return border particles with a unique adjacent arrow marker.\"\"\"\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D15/2/code.py:149:    \"\"\"Move particles through same-color corridors; initial direction comes from edge arrows.\"\"\"\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:3:# Change: '+'精灵为小型中心对称色块（3x3十字、3x4胖十字、5x4胖菱形等），bbox至少3x3，左右+上下对称... → 箭头形精灵\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:10:# - The shared anchor color now forms several small arrow blobs instead of plus-like symmetric blobs.\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:11:# - Each arrow is one of a few fixed templates, rotated to point U/D/L/R.\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:12:# - Each arrow still owns exactly one colored seed tile and one grid keeps one ray pre-extended.\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:14:#   (clockwise from the pointing direction), while the arrow's own facing direction tells us where the\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:15:#   ray should go. Example: a right-pointing arrow has its seed directly below it, but the seed repeats\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:17:#   we must read the arrow shape and project \"right\".\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:24:# - Each generated grid uses at least two arrow orientations so the orientation cue is actually visible.\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:26:# - detect_dominant_big_component_color still works because arrows remain the only components with both\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:35:#   wrong arrow and the solver sees exactly one adjacent non-arrow component per arrow.\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:37:#   existing arrow-neighborhood guard cells.\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:39:# - Human-solvable cue: arrows visibly point one way while their seed sits on a different side.\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:40:# - The kept pre-extended ray demonstrates that the repeated pattern follows the arrow orientation, not\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:44:# - Rays do not overlap arrows and do not touch foreign arrows.\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:51:# - For every generated arrow, the unique attachment side must be orthogonal to the ray direction.\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:52:# - Per sample, at least two distinct arrow orientations should usually appear.\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:54:# - Solver assumes every big anchor component exactly matches one rotated arrow template.\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:55:# - Solver assumes each arrow has exactly one adjacent non-anchor component (seed or pre-extended ray).\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:177:        \"launch\": (2, 2),  # canonical right-arrow: seed attaches below this cell\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:207:_CANONICAL_ATTACH_NORMAL = (1, 0)  # right-arrow seeds attach on the clockwise flank: below\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:255:def _oriented_arrow_spec(spec: dict, direction: str) -> tuple[np.ndarray, tuple[int, int], tuple[int, int]]:\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:262:def _match_arrow_direction(mask: np.ndarray) -> tuple[int, int] | None:\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:299:    Extend marker tiles forward from arrow-shaped anchors by repeating them to the grid edge.\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:303:    - A dominant non-bg color forms several small arrow sprites, possibly in different rotations.\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:304:    - Each arrow has exactly one adjacent colored marker component; one of these rays may already be long.\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:307:    - For each arrow, recognize which way the arrow points from its shape.\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:309:    - Repeat that payload in the arrow's pointing direction until the boundary, without overwriting arrow pixels.\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:311:    Key insight: The marker's attachment side is no longer the direction cue; the arrow silhouette itself\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:319:    arrow_col = detect_dominant_big_component_color(g, bg=bg, min_h=3, min_w=3, connectivity=4)\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:320:    if arrow_col is None:\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:323:    arrow_lab, an = label_mask(g == int(arrow_col), connectivity=4)\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:324:    non_mask = (g != int(bg)) & (g != int(arrow_col))\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:328:        arrow_mask = arrow_lab == int(ak)\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:329:        arrow_coords = np.argwhere(arrow_mask)\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:330:        if arrow_coords.size == 0:\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:333:        ar0, ac0, ar1, ac1 = bbox_coords(arrow_coords)\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:334:        local_arrow = g[int(ar0):int(ar1) + 1, int(ac0):int(ac1) + 1] == int(arrow_col)\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:335:        direction = _match_arrow_direction(local_arrow)\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:340:        for r, c in arrow_coords:\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:366:            protect={int(arrow_col)},\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:372:# --------------- generator (D4 arrow variant) ---------------\n/home/lixinyu/snap/new/ceshi/code/53fb4810/D4/1/code.py:514:def _mark_arrow_guard(guard: n