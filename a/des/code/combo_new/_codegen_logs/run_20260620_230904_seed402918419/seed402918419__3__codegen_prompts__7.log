{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/db0c5428.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox, crop_bbox, get_bg, paste\nimport random\n\n\ndef _major_foreground_color(g: np.ndarray, bg: int) -> int:\n    vals, counts = np.unique(g[g != int(bg)], return_counts=True)\n    assert vals.size, \"input must contain foreground colors\"\n    return int(vals[int(np.argmax(counts))])\n\n\ndef _center_patch(g: np.ndarray, r0: int, c0: int, block: int, bg: int) -> np.ndarray:\n    assert block == 3, \"this task uses 3x3 blocks\"\n    main = _major_foreground_color(g, bg)\n    patch = np.full((block, block), main, dtype=int)\n\n    hole_r = int(r0) + block\n    hole_c = int(c0) + block\n    offsets = [-1, 1, 3]\n    for r in range(block):\n        for c in range(block):\n            if r == block // 2 and c == block // 2:\n                continue\n            patch[r, c] = int(g[hole_r + offsets[r], hole_c + offsets[c]])\n    return patch\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Expand a 3x3 block motif into a 5x5 block motif around its missing center.\n\n    Input structure:\n    - Teal background surrounds one 9x9 foreground motif.\n    - The motif is a 3x3 array of 3x3 blocks; the middle block is empty teal.\n    - Colored pixels immediately around the empty middle block encode the border\n      of the missing center block.\n\n    Rule:\n    - Keep the original 9x9 motif in place.\n    - Copy each of the eight surrounding 3x3 blocks to the opposite outer slot\n      of the implied 5x5 block grid, without rotating it.\n    - Fill the center block from the eight pixels around the hole; its center is\n      the motif's majority foreground color.\n\n    Key insight: The visible 9x9 motif is the middle of a larger periodic\n    block-level pattern, and the empty center is reconstructed from its immediate\n    inner boundary.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    motif_bbox = bbox(g != bg)\n    assert motif_bbox is not None, \"expected a foreground motif\"\n    r0, c0, r1, c1 = motif_bbox\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    assert h == w and h % 3 == 0, \"motif must be a square 3x3 block grid\"\n    block = h // 3\n\n    out = g.copy()\n    expanded_r0 = int(r0) - block\n    expanded_c0 = int(c0) - block\n\n    for br in range(3):\n        for bc in range(3):\n            if (br, bc) == (1, 1):\n                continue\n            src = crop_bbox(\n                g,\n                (\n                    int(r0) + br * block,\n                    int(c0) + bc * block,\n                    int(r0) + (br + 1) * block - 1,\n                    int(c0) + (bc + 1) * block - 1,\n                ),\n            )\n            dst_r = expanded_r0 + (4 - 2 * br) * block\n            dst_c = expanded_c0 + (4 - 2 * bc) * block\n            paste(out, src, dst_r, dst_c)\n\n    paste(out, _center_patch(g, int(r0), int(c0), block, bg), int(r0) + block, int(c0) + block)\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# -- CFG: canvas & structure --\nGRID_SIZE_MIN, GRID_SIZE_MAX = 16, 19       # square grid side length\nBLOCK = 3                                    # block side length\nMOTIF_SIZE = BLOCK * 3                       # 9x9 motif (3x3 grid of blocks)\nEXPANDED_SIZE = BLOCK * 5                    # 15x15 expanded output region\nMOTIF_PAD = 3                                # min distance from motif edge to grid edge\n\n# -- CFG: colors --\nBG = 8                                       # background color\nFOREGROUND_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]\nCOLOR_COUNT_MIN, COLOR_COUNT_MAX = 2, 4      # total foreground colors (incl. majority)\n\n# -- CFG: majority pixel counts (corner block + edge block combined) --\nMAJORITY_TOTAL_MIN, MAJORITY_TOTAL_MAX = 10, 16  # range for sum of major pixels in b00+b01\nCORNER_MAJOR_MIN, CORNER_MAJOR_MAX = 5, 8        # major pixels in corner block (diag-sym)\nEDGE_MAJOR_MIN, EDGE_MAJOR_MAX = 5, 8            # major pixels in edge block (LR-sym)\n\n# -- CFG: generation --\nMAX_RETRIES = 300\n\n# -- Symmetry orbits for 3x3 blocks --\n# Diagonal-symmetric orbits (b00 == b00.T): cells sharing a diag-orbit get the same color\nDIAG_ORBITS = (\n    ((0, 0),), ((1, 1),), ((2, 2),),\n    ((0, 1), (1, 0)),\n    ((0, 2), (2, 0)),\n    ((1, 2), (2, 1)),\n)\n# LR-symmetric orbits (b01 == fliplr(b01)): cells sharing an LR-orbit get the same color\nLR_ORBITS = (\n    ((0, 0), (0, 2)),\n    ((1, 0), (1, 2)),\n    ((2, 0), (2, 2)),\n    ((0, 1),), ((1, 1),), ((2, 1),),\n)\n\n# Row/col indices for sampling inner-boundary pixels that fill the center patch.\n# Maps block-local (r,c) -> motif row/col via BLOCK + offset.\n_CENTER_OFFSETS = np.array([-1, 1, 3])\n\n\ndef _major_orbits(orbits, forced_minor, target_count):\n    \"\"\"Enumerate all orbit subsets whose total pixel count equals target_count,\n    excluding orbits that contain any forced_minor coordinate, then pick one.\"\"\"\n    forced_minor = set(forced_minor)\n    usable = [\n        idx for idx, orbit in enumerate(orbits)\n        if all(coord not in forced_minor for coord in orbit)\n    ]\n    choices = []\n    for mask in range(1 << len(usable)):\n        selected = set()\n        total = 0\n        for bit, idx in enumerate(usable):\n            if mask & (1 << bit):\n                selected.add(idx)\n                total += len(orbits[idx])\n        if total == target_count:\n            choices.append(selected)\n    assert choices, \"unreachable symmetric majority count\"\n    return random.choice(choices)\n\n\ndef _seed_block(orbits, forced_minor, majority, target_count):\n    \"\"\"Build a BLOCK x BLOCK array with majority color placed in orbits totalling\n    target_count pixels. Returns (block, minor_orbits) where minor_orbits is a list\n    of (block_ref, orbit) pairs whose colors are still unset (-1).\"\"\"\n    block = np.full((BLOCK, BLOCK), -1, dtype=int)\n    major_idxs = _major_orbits(orbits, forced_minor, target_count)\n    minor_orbits = []\n    for idx, orbit in enumerate(orbits):\n        if idx in major_idxs:\n            for r, c in orbit:\n                block[r, c] = majority\n        else:\n            minor_orbits.append((block, orbit))\n    return block, minor_orbits\n\n\ndef _assign_minor_colors(minor_orbits, colors):\n    \"\"\"Assign minor colors to unfilled orbits, guaranteeing each color appears at\n    least once (remaining orbits get random picks).\"\"\"\n    random.shuffle(minor_orbits)\n    guaranteed = list(colors)\n    random.shuffle(guaranteed)\n    assignments = guaranteed + [\n        random.choice(colors) for _ in range(len(minor_orbits) - len(guaranteed))\n    ]\n    for (block, orbit), color in zip(minor_orbits, assignments):\n        for r, c in orbit:\n            block[r, c] = color\n\n\ndef _make_blocks(majority, minor_colors, corner_major, edge_major):\n    \"\"\"Build the two seed blocks (b00=corner, b01=edge) with D4/LR symmetry.\"\"\"\n    b00, corner_minors = _seed_block(DIAG_ORBITS, [(2, 2)], majority, corner_major)\n    b01, edge_minors = _seed_block(LR_ORBITS, [(2, 1)], majority, edge_major)\n    minor_orbits = corner_minors + edge_minors\n    assert len(minor_orbits) >= len(minor_colors)\n    _assign_minor_colors(minor_orbits, minor_colors)\n    assert np.all(b00 != -1) and np.all(b01 != -1)\n    return b00, b01\n\n\ndef _assemble_motif(b00, b01):\n    \"\"\"Assemble the 9x9 motif from two seed blocks via D4 symmetry; center block is bg.\"\"\"\n    motif = np.full((MOTIF_SIZE, MOTIF_SIZE), BG, dtype=int)\n    blocks = {\n        (0, 0): b00,\n        (0, 1): b01,\n        (0, 2): np.fliplr(b00),\n        (1, 0): b01.T,\n        (1, 2): np.rot90(b01, -1),\n        (2, 0): np.flipud(b00),\n        (2, 1): np.flipud(b01),\n        (2, 2): np.rot90(b00, 2),\n    }\n    for (br, bc), blk in blocks.items():\n        paste(motif, blk, br * BLOCK, bc * BLOCK)\n    return motif\n\n\ndef _gen_center_patch(motif, majority):\n    \"\"\"Reconstruct the center block from the 8 inner-boundary pixels of the motif.\n    Center pixel is the majority foreground color.\"\"\"\n    rows = BLOCK + _CENTER_OFFSETS\n    cols = BLOCK + _CENTER_OFFSETS\n    patch = motif[np.ix_(rows, cols)].copy()\n    patch[1, 1] = majority\n    return patch\n\n\ndef _expanded_output(motif, center):\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/e87109e9.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/e87109e9.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask\nimport random\n\n_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n\n\ndef _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:\n    \"\"\"\n    Legend is a top region with a background color (typically 5) and 4 vertical bars.\n    Each bar's horizontal position inside its cell encodes turn direction:\n      - bar on left  -> 'L' (turn counterclockwise)\n      - bar on right -> 'R' (turn clockwise)\n    \"\"\"\n    legend = grid[:legend_h, :]\n    assert legend.size, \"legend must be non-empty\"\n    _vals, _cnts = np.unique(legend, return_counts=True); bg = int(_vals[_cnts.argmax()])\n\n    # Separator columns are solid bg throughout the legend.\n    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]\n    assert len(sep_cols) >= 2, \"legend separator columns must exist\"\n\n    turn: dict[int, str] = {}\n    for a, b in zip(sep_cols, sep_cols[1:], strict=False):\n        if b - a <= 2:\n            continue\n        interior = legend[1 : legend_h - 1, a + 1 : b]\n        colors = set(map(int, np.unique(interior)))\n        colors.discard(bg)\n        colors.discard(0)\n        assert len(colors) == 1, \"each legend cell must encode exactly one color\"\n        col = int(next(iter(colors)))\n        xs = np.where(interior == col)[1]\n        x = int(xs[0])  # relative to interior\n        # Decide left/right by proximity to borders (interior is typically 4 cells wide).\n        turn[col] = \"L\" if x <= (interior.shape[1] - 1) // 2 else \"R\"\n    assert len(turn) == 4, \"legend must encode four turn colors\"\n    return turn\n\n\ndef _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:\n    \"\"\"Return (r0,c0,size) for a solid square teal component.\"\"\"\n    candidates: list[tuple[int, int, int]] = []\n    for cells in components_mask(g == teal, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(cells)\n        hh = r1 - r0 + 1\n        ww = c1 - c0 + 1\n        if hh != ww:\n            continue\n        size = hh\n        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:\n            continue\n        candidates.append((int(r0), int(c0), int(size)))\n    assert len(candidates) == 1, \"main grid must contain exactly one solid teal square\"\n    return candidates[0]\n\n\ndef _rot_ccw(d: int) -> int:\n    return (d - 1) % 4\n\n\ndef _rot_cw(d: int) -> int:\n    return (d + 1) % 4\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Emit four teal beams from a square, turning at colored obstacles per a legend.\n\n    Input structure:\n    - Top band: grey (5) legend with colored vertical bars in cells; bar position (left or right) encodes turn direction.\n    - Below: main grid with bg, a solid teal (8) square, and colored obstacle blocks.\n\n    Rule:\n    - Remove the legend from the output.\n    - From the teal square, shoot a beam in each cardinal direction (as a sliding copy of the square).\n    - Each beam paints teal over bg cells as it moves.\n    - On hitting an obstacle of color C, consult the legend: bar on left → turn counterclockwise, bar on right → turn clockwise. Continue in the new direction.\n    - Beams stop at grid edges.\n\n    Key insight: The legend's bar position (left vs right within its cell) is the encoding for turn direction at each obstacle color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n\n    # Legend height: crop everything above and including the last row containing legend bg (usually 5).\n    # In this dataset, the legend uses a dedicated color (5) that doesn't appear below.\n    legend_bg = 5\n    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]\n    assert rows_with_legend.size, \"legend rows must be present\"\n    legend_h = int(rows_with_legend.max() + 1)\n    assert np.array_equal(rows_with_legend, np.arange(legend_h)), \"legend color must be confined to the top band\"\n\n    legend_turn = _parse_legend(g, legend_h)\n\n    base = g[legend_h:, :].copy()\n    assert base.size, \"main grid must remain after legend crop\"\n\n    _vals, _cnts = np.unique(base, return_counts=True); bg = int(_vals[_cnts.argmax()])\n    teal = 8\n    src = _find_teal_square(base, teal=teal)\n    sr, sc, sz = src\n\n    out = base.copy()\n\n    def in_bounds(r: int, c: int) -> bool:\n        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]\n\n    def paint_block(r: int, c: int) -> None:\n        blk = out[r : r + sz, c : c + sz]\n        blk[blk == bg] = teal\n        out[r : r + sz, c : c + sz] = blk\n\n    def obstacle_color_at_next(nr: int, nc: int) -> int | None:\n        blk = out[nr : nr + sz, nc : nc + sz]\n        cols = set(map(int, np.unique(blk)))\n        cols.discard(bg)\n        cols.discard(teal)\n        if not cols:\n            return None\n        assert len(cols) == 1, \"beam footprint must not hit mixed obstacle colors\"\n        return int(next(iter(cols)))\n\n    # Four beams, each is a moving copy of the teal square.\n    for d0 in range(4):\n        r, c, d = sr, sc, d0\n        seen: set[tuple[int, int, int]] = set()\n        while True:\n            state = (r, c, d)\n            assert state not in seen, \"beam path must not cycle\"\n            seen.add(state)\n\n            dr, dc = _DIRS[d]\n            nr, nc = r + dr, c + dc\n            if not in_bounds(nr, nc):\n                break\n\n            oc = obstacle_color_at_next(nr, nc)\n            if oc is None:\n                r, c = nr, nc\n                paint_block(r, c)\n                continue\n\n            assert oc in legend_turn, \"obstacle color must be encoded by legend\"\n            turn = legend_turn[oc]\n            d = _rot_ccw(d) if turn == \"L\" else _rot_cw(d)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# ── Configuration ──────────────────────────────────────────────────────\n_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n_N, _E, _S, _W = range(4)\n\n# Color palettes\nLEGEND_COLOR_POOL = [1, 2, 3, 4, 6]          # colors eligible for obstacles / legend\nBG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]        # colors eligible for main-grid background\nLEGEND_BG = 5                                  # legend background color\nTEAL = 8                                       # beam / square color\n\n# Canvas dimensions\nGRID_H_RANGE = (19, 24)                        # main-grid height (rows)\nGRID_W = 24                                    # main-grid width (fixed)\nLEGEND_H = 6                                   # legend height (rows)\nLEGEND_CELL_STARTS = [1, 7, 13, 19]           # col offsets for legend cells\n\n# Teal square\nTEAL_SZ2_PROB = 0.75                           # P(size=2); else size=3\nSQUARE_EDGE_GAP = 5                            # min gap from square to grid edges\n\n# Obstacles\nOBS_COUNT_4_PROB = 0.65                        # P(4 obstacles); else 3\nOBS_THICKNESS_RANGE = (2, 4)                   # obstacle shorter-dimension bounds\nOBS_SINGLE_MARGIN = 6                          # margin subtracted when only one side present\nOBS_BOTH_GAP = 2                               # gap subtracted when both sides present\n\n# Span selection\nSPAN_MIN_MULT = 3                              # min obstacle length = SPAN_MIN_MULT * sz\nSPAN_MAX_MULT = 14                             # max obstacle length = SPAN_MAX_MULT * sz\nSPAN_COMPACT_PROB = 0.4                        # P(bias toward compact spans)\n\n# Retry budget\nMAX_RETRIES = 300\n\n\ndef _rot(d: int, turn: str) -> int:\n    \"\"\"Rotate direction d by turn ('L' = CCW, 'R' = CW).\"\"\"\n    return (d - 1) % 4 if turn == \"L\" else (d + 1) % 4\n\n\n# ── Obstacle span selection ───────────────────────────────────────────\n\ndef _choose_span(\n    axis_len: int,\n    required: list[tuple[int, int]],\n    excluded: list[tuple[int, int]],\n    min_len: int,\n    max_len: int,\n) -> tuple[int, int] | None:\n    \"\"\"Pick a (start, end) span covering all *required* intervals, avoiding all *excluded*.\"\"\"\n    req0 = min(a for a, _ in required)\n    req1 = max(b for _, b in required)\n    lo = max(min_len, req1 - req0 + 1)\n    hi = min(max_len, axis_len)\n    choices: list[tuple[int, int, int]] = []\n    for length in range(lo, hi + 1):\n        start0 = max(0, req1 - length + 1)\n        start1 = min(req0, axis_len - length)\n        for start in range(start0, start1 + 1):\n            end = start + length - 1\n            if all(end < a or start > b for a, b in excluded):\n                choices.append((length, start, end))\n    if not choices:\n        return None\n\n    # Bias mildly toward compact side bars while still covering long-span cases.\n    lengths = sorted({length for length, _, _ in choices})\n    if random.random() < SPAN_COMPACT_PROB:\n        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]\n        pool = [(start, end) for length, start, end in choices if length <= cutoff]\n    else:\n        pool = [(start, end) for _, start, end in choices]\n    return random.choice(pool)\n\n\n# ── Beam simulation (oracle) ──────────────────────────────────────────\n\ndef _simulate_paths(\n    base: np.ndarray, turns: dict[int, str], bg: int\n) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]]]:\n    \"\"\"Simulate 4 beams from the teal square, returning painted grid and per-beam hit lists.\"\"\"\n    vals, counts = np.unique(base, return_counts=True)\n    assert int(vals[counts.argmax()]) == bg\n\n    teal_locs = np.argwhere(base == TEAL)\n    assert teal_locs.size\n    sr, sc = teal_locs.min(axis=0)\n    r1, c1 = teal_locs.max(axis=0)\n    sz = int(r1 - sr + 1)\n","exit_code":0,"status":"completed"}}
