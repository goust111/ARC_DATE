ng.\nMAX_GAP_LEVELS = 3\nSINGLE_LEVEL_MIN_ROWS = 2\nMIN_GAP_ROW_RANGE = (1, 2)\n\n# Rejection loop.\nGENERATION_ATTEMPTS = 300\n\n\ndef _cols_for_gap(width: int, gap: int) -> tuple[int, int]:\n","exit_code":0,"status":"completed"}}
