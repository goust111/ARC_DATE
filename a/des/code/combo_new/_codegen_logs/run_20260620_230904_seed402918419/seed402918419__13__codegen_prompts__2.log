{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\nimport numpy as np\n\nSIDES = ('top','bottom','left','right')\nOPPOSITE = {'top':'bottom','bottom':'top','left':'right','right':'left'}\n\n\ndef comps(mask):\n    h,w = mask.shape\n    seen = np.zeros((h,w), dtype=bool)\n    out=[]\n    for r in range(h):\n        for c in range(w):\n            if not mask[r,c] or seen[r,c]:\n                continue\n            q=deque([(r,c)])\n            seen[r,c]=True\n            pts=[]\n            while q:\n                rr,cc=q.popleft()\n                pts.append((rr,cc))\n                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                    nr,nc=rr+dr,cc+dc\n                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:\n                        seen[nr,nc]=True\n                        q.append((nr,nc))\n            out.append(np.array(pts, dtype=int))\n    return out\n\n\ndef make_slot(color, side, h, w, off):\n    a = np.full((h,w), color, dtype=int)\n    if side=='left':\n        a[off,0]=0\n    elif side=='right':\n        a[off,w-1]=0\n    elif side=='top':\n        a[0,off]=0\n    else:\n        a[h-1,off]=0\n    return a\n\n\ndef make_tooth(color, side, h, w, off):\n    if side in ('left','right'):\n        a = np.zeros((h,w+1), dtype=int)\n        if side=='left':\n            a[:,1:]=color\n            a[off,0]=color\n        else:\n            a[:,:w]=color\n            a[off,w]=color\n    else:\n        a = np.zeros((h+1,w), dtype=int)\n        if side=='top':\n            a[1:,:]=color\n            a[0,off]=color\n        else:\n            a[:h,:]=color\n            a[h,off]=color\n    return a\n\n\ndef classify(arr):\n    mask = arr \"'!= 0\n    h,w = mask.shape\n    cand=[]\n    miss = np.argwhere(~mask)\n    if miss.shape[0] == 1:\n        r,c = map(int, miss[0])\n        sides=[]\n        if r == 0: sides.append('\"'top')\n        if r == h-1: sides.append('bottom')\n        if c == 0: sides.append('left')\n        if c == w-1: sides.append('right')\n        if len(sides) == 1:\n            side = sides[0]\n            limit = w if side in ('top','bottom') else h\n            off = c if side in ('top','bottom') else r\n            if 0 < off < limit - 1:\n                cand.append(('slot', side, off))\n    if w >= 2 and mask[:, :-1].all() and mask[:, -1].sum() == 1:\n        off = int(np.flatnonzero(mask[:, -1])[0])\n        if 0 < off < h - 1:\n            cand.append(('tooth', 'right', off))\n    if w >= 2 and mask[:, 1:].all() and mask[:, 0].sum() == 1:\n        off = int(np.flatnonzero(mask[:, 0])[0])\n        if 0 < off < h - 1:\n            cand.append(('tooth', 'left', off))\n    if h >= 2 and mask[:-1, :].all() and mask[-1, :].sum() == 1:\n        off = int(np.flatnonzero(mask[-1, :])[0])\n        if 0 < off < w - 1:\n            cand.append(('tooth', 'bottom', off))\n    if h >= 2 and mask[1:, :].all() and mask[0, :].sum() == 1:\n        off = int(np.flatnonzero(mask[0, :])[0])\n        if 0 < off < w - 1:\n            cand.append(('tooth', 'top', off))\n    return cand\n\nfor side in SIDES:\n    for _ in range(20):\n        h = random.randint(3,6)\n        w = random.randint(3,6)\n        off = random.randint(1, (w-2 if side in ('top','bottom') else h-2))\n        a = make_slot(2, side, h, w, off)\n        c = classify(a)\n        assert c == [('slot', side, off)], (side, off, c, a)\n        ts = OPPOSITE[side]\n        h2 = random.randint(3,6)\n        w2 = random.randint(3,6)\n        off2 = random.randint(1, (w2-2 if ts in ('top','bottom') else h2-2))\n        b = make_tooth(2, ts, h2, w2, off2)\n        c2 = classify(b)\n        assert c2 == [('tooth', ts, off2)], (ts, off2, c2, b)\nprint('ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
