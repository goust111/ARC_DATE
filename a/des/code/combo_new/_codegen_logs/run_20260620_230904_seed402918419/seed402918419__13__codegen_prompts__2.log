{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/57edb29d.py',\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n'/home/lixinyu/snap/new/ARC_code/eval/13e47133.py',\n'/home/lixinyu/snap/new/ARC_code/train/6cbe9eb8.py',\n'/home/lixinyu/snap/new/ARC_code/eval/291dc1e1.py',\n'/home/lixinyu/snap/new/ARC_code/eval/898e7135.py',\n'/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py',\n'/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n]\nfor path in files:\n    text = Path(path).read_text()\n    print(f'FILE: {path}')\n    for name in ('main', 'generate_input'):\n        marker = f'def {name}('\n        idx = text.find(marker)\n        if idx == -1:\n            print(f'  MISSING {name}')\n            continue\n        end = text.find('\\\\ndef ', idx + 1)\n        if end == -1:\n            end = len(text)\n        snippet = text[idx:end].strip()\n        print(f'--- {name} ---')\n        print(snippet[:4000])\n        print('--- END ---')\n    print('=====')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/57edb29d.py',\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n'/home/lixinyu/snap/new/ARC_code/eval/13e47133.py',\n'/home/lixinyu/snap/new/ARC_code/train/6cbe9eb8.py',\n'/home/lixinyu/snap/new/ARC_code/eval/291dc1e1.py',\n'/home/lixinyu/snap/new/ARC_code/eval/898e7135.py',\n'/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py',\n'/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n]\nfor path in files:\n    text = Path(path).read_text()\n    print(f'FILE: {path}')\n    for name in ('main', 'generate_input'):\n        marker = f'def {name}('\n        idx = text.find(marker)\n        if idx == -1:\n            print(f'  MISSING {name}')\n            continue\n        end = text.find('\\\\ndef ', idx + 1)\n        if end == -1:\n            end = len(text)\n        snippet = text[idx:end].strip()\n        print(f'--- {name} ---')\n        print(snippet[:4000])\n        print('--- END ---')\n    print('=====')\nPY\"","aggregated_output":"FILE: /home/lixinyu/snap/new/ARC_code/train/57edb29d.py\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extract the single plain rectangle and redraw it with the aligned rectangles' border-relative marker pattern.\n\n    Input structure:\n    - The boundary color is the background/separator.\n    - Foreground objects are dense rectangular regions; exactly one rectangle has only its base color.\n    - Other rectangles contain their base color plus marker pixels.\n\n    Rule:\n    - Crop the only plain rectangle; this crop is the output canvas.\n    - Use marked rectangles whose row span overlaps the plain rectangle's row span.\n    - Transfer their marker pixels by preserving each marker run's distance from the nearest rectangle edges.\n\n    Key insight:\n    - The marked rectangles are examples of an edge-relative pattern, so the missing plain rectangle receives the same pattern resized to its own dimensions.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    bg = _boundary_bg(g)\n\n    objects = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False):\n        bbox = tuple(map(int, comp[\"bbox\"]))\n        sub = crop_bbox(g, bbox)\n        assert np.all(sub != bg), \"foreground rectangles must be dense\"\n\n        base_color = _unique_most_common(sub)\n        marker_colors = set(map(int, sub.reshape(-1))) - {int(base_color)}\n        objects.append(\n            {\n                \"bbox\": bbox,\n                \"sub\": sub,\n                \"base_color\": int(base_color),\n                \"marker_colors\": marker_colors,\n            }\n        )\n\n    plain = [obj for obj in objects if not obj[\"marker_colors\"]]\n    assert len(plain) == 1, \"expected exactly one plain rectangle\"\n    target = plain[0]\n    tr0, tc0, tr1, tc1 = target[\"bbox\"]\n    target_shape = (int(tr1 - tr0 + 1), int(tc1 - tc0 + 1))\n\n    sources = [\n        obj\n        for obj in objects\n        if obj[\"marker_colors\"] and _row_overlap(obj[\"bbox\"], target[\"bbox\"])\n    ]\n    assert sources, \"expected at least one marked rectangle aligned with the plain rectangle\"\n\n    marker_colors = set()\n    for source in sources:\n        marker_colors.update(source[\"marker_colors\"])\n    assert len(marker_colors) == 1, \"aligned marked rectangles must share one marker color\"\n    marker_color = int(next(iter(marker_colors)))\n\n    masks = []\n    for source in sources:\n        assert source[\"marker_colors\"] == {marker_color}, \"source must contain only the shared marker color\"\n        masks.append(_adapt_marker_mask(source[\"sub\"], marker_color, target_shape))\n\n    pattern = masks[0]\n    for mask in masks[1:]:\n        assert np.array_equal(mask, pattern), \"aligned marked rectangles must encode the same pattern\"\n\n    out = np.full(target_shape, int(target[\"base_color\"]), dtype=int)\n    out[pattern] = marker_color\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and separator colors.\nBG = 4\nNON_BG = [c for c in range(10) if c != BG]\nGRID_H_RANGE = (20, 28)\nGRID_W_RANGE = (20, 28)\nBORDER_GAP = 1\nBAND_GAP = 1\n# Rectangle counts and dimensions.\nRECT_COUNT_RANGE = (3, 6)\nOVERLAP_MARKED_COUNT = 2\nRECT_H_RANGE = (5, 20)\nRECT_W_RANGE = (5, 12)\nPLAIN_EXTRA_ROW_ROOM = 2\n# Marker pattern sampling.\nMARKER_PAIR_COUNT_RANGE = (1, 3)\nMARKER_EDGE_PAIRS = [(1, 1), (1, 2), (2, 1), (2, 2)]\n# Retry budget.\nGENERATION_ATTEMPTS = 300\n--- END ---\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n--- END ---\n=====\nFILE: /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n--- END ---\n--- generate_input ---\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n--- END ---\n=====\nFILE: /home/lixinyu/snap/new/ARC_code/eval/13e47133.py\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill partitioned regions with concentric colored bands derived from marker pixels.\n\n    Input structure:\n    - Grid partitioned into regions by wall-colored lines.\n    - Each region has a dominant base color and a few isolated marker pixels of other colors at varying depths from the region boundary.\n\n    Rule:\n    - For each region, read marker colors ordered by their Chebyshev distance from the boundary to build a color palette.\n    - If no marker sits on the boundary itself, the base color leads the palette.\n    - Paint every cell with palette[distance mod palette_length], producing repeating concentric rectangular frames that radiate inward.\n\n    Key insight: Each marker's depth from the boundary defines its position in the cyclic palette; the pattern then tiles inward automatically.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    # Global background and wall color (the main partition lines).\n    bg = _mode(g)\n    other = g[g != bg]\n    wall = bg if other.size == 0 else _mode(other)\n\n    out = g.copy()\n    free = g != wall\n    comps = _cc4(free)\n\n    for pts in comps:\n        # Build component mask\n        comp_mask = np.zeros((h, w), dtype=bool)\n        for r, c in pts:\n            comp_mask[r, c] = True\n\n        vals = g[comp_mask]\n        base = _mode(vals)\n        dist = _boundary_distance(comp_mask)\n\n        # Markers are cells whose color differs from the region base.\n        # Pick at most one marker color per distance (closest in reading order).\n        dist_to_color: dict[int, int] = {}\n        for r, c in pts:\n            v = int(g[r, c])\n            if v == base:\n                continue\n            d = int(dist[r, c])\n            if d < 0:\n                continue\n            if d not in dist_to_color:\n                dist_to_color[d] = v\n            else:\n                # stable tie-breaker: prefer earlier (r,c)\n                pass\n\n        palette: list[int] = []\n        if dist_to_color:\n            ds = sorted(dist_to_color.keys())\n            if ds[0] > 0:\n                palette.append(int(base))\n            for d in ds:\n                palette.append(int(dist_to_color[d]))\n        else:\n            palette = [int(base)]\n\n        m = len(palette)\n        for r, c in pts:\n            d = int(dist[r, c])\n            out[r, c] = palette[d % m]\n\n    return out\n\n# --------------- generator (attempt 1 (Claude)) ---------------\n\n# ---- Canvas bounds ----\nH_MIN, H_MAX = 10, 30                       # grid height range\nW_MIN, W_MAX = 13, 30                       # grid width range\n\n# ---- Wall subdivision ----\nN_SPLITS_MIN, N_SPLITS_MAX = 2, 5           # recursive subdivision rounds\nMIN_REGION_DIM = 3                          # each half must keep >= this min dim\n# Threshold for splitting: need MIN_REGION_DIM + 1 (wall) + MIN_REGION_DIM\nSPLITTABLE_LEN = 2 * MIN_REGION_DIM + 1     # 7\n\n# ---- Region count filter ----\nN_REGIONS_MIN, N_REGIONS_MAX = 3, 6\n\n# ---- Markers per region ----\nMARKERS_PER_REGION_MAX = 3                  # cap on markers placed per region\nMARKER_COUNT_WEIGHTS = [1, 2, 3, 3]         # weights for choosing 0/1/2/3 markers\nSTART_DIST_MAX = 1                          # start distance cap (0 or 1)\n\n# ---- Distinct marker colors across grid ----\nDISTINCT_MARKER_COLORS_MIN, DISTINCT_MARKER_COLORS_MAX = 3, 9\n\n# ---- Retry budget ----\nGEN_MAX_ATTEMPTS = 300\n\n# Corner -> (diagonal step dr, dc, base row, base col) as a function of bbox.\n# Encoded as (row_from, col_from, dr, dc): 0=r0, 1=r1 for row_from; similarly col.\n_CORNERS = [(0, 0, 1, 1), (0, 1, 1, -1), (1, 0, -1, 1), (1, 1, -1, -1)]\n--- END ---\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_MAX_ATTEMPTS):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(f\"generate_input failed after {GEN_MAX_ATTEMPTS} attempts\")\n--- END ---\n=====\nFILE: /home/lixinyu/snap/new/ARC_code/train/6cbe9eb8.py\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rebuild the foreground rectangles as a largest-to-smallest lower-left nesting.\n\n    Input structure\n    - A periodic wallpaper background is overlaid by foreground colors that each form a rectangular frame or solid rectangle.\n    - The largest foreground rectangle is the output frame; smaller foreground rectangles are the objects to nest inside it.\n    - A frame may be partially hidden by a smaller rectangle, but its visible pixels still determine its bbox.\n\n    Rule\n    - Ignore the wallpaper and crop the result to the largest foreground rectangle's bbox size.\n    - Sort foreground rectangles by bbox area from largest to smallest.\n    - Reconstruct each frame or solid rectangle, placing every next smaller rectangle in the lower-left of the current rectangle's usable region.\n\n    Key insight\n    - The scattered background colors are not objects; the meaningful order is the unique descending rectangle size chain, and each step nests into the previous rectangle's lower-left interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    items = _foreground_rectangles(g)\n    outer = items[0]\n    out = np.zeros((int(outer[\"height\"]), int(outer[\"width\"])), dtype=int)\n\n    region = _paint_item(out, outer, 0, 0)\n    for item in items[1:]:\n        rr, cc, rh, rw = region\n        h = int(item[\"height\"])\n        w = int(item[\"width\"])\n        assert h <= rh and w <= rw, \"nested rectangle must fit in parent usable region\"\n        r = rr + rh - h\n        c = cc\n        region = _paint_item(out, item, r, c)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n_RNG = np.random.default_rng()\n\n# Colors and sentinels.\nCOLOR_VALUES, FOREGROUND_COLORS = tuple(range(10)), tuple(range(1, 10))\nTRANSPARENT = -1\n# Rectangle chain counts.\nITEM_COUNT_RANGE, THREE_ITEM_FRAME_OPTIONS = (3, 4), (1, 2)\nFOUR_ITEM_FRAME_COUNT = 2\n# Solid rectangle dimensions.\nINNER_SOLID_HEIGHT_RANGE, INNER_SOLID_WIDTH_RANGE = (2, 3), (2, 3)\nSECOND_SOLID_MAX_HEIGHT, SECOND_SOLID_MAX_WIDTH = 9, 9\n# Frame growth and bounds.\nFRAME_MIN_GROWTH, INNER_FRAME_MAX_GROWTH = 2, 5\nINNER_FRAME_MAX_HEIGHT, INNER_FRAME_MAX_WIDTH = 13, 11\nOUTER_FRAME_MIN_HEIGHT, OUTER_FRAME_MIN_WIDTH = 8, 8\nOUTER_FRAME_MAX_HEIGHT, OUTER_FRAME_MAX_WIDTH = 15, 13\n# Wallpaper canvas bounds and margin around the outer rectangle.\nCANVAS_HEIGHT_RANGE, CANVAS_WIDTH_RANGE = (13, 19), (22, 27)\nCANVAS_BORDER_MARGIN = 1\n# Wallpaper tile/color sampling.\nWALLPAPER_COLOR_COUNT_RANGE = (2, 4)\nZERO_WALLPAPER_ROLL_RANGE = (0, 4)\nZERO_WALLPAPER_THRESHOLD = 3\nTILE_SIZE_2 = 2\nTILE_SIZE_OPTIONS, TILE3_SIGN_OPTIONS = (2, 3), (1, 2)\n# Visibility/oracle retry limits.\nVISIBLE_OUTER_MIN_COMPONENT, MAX_VISIBLE_OUTER_COMPONENTS = 3, 4\nGENERATION_RETRY_LIMIT = 300\n--- END ---\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid input\")\n--- END ---\n=====\nFILE: /home/lixinyu/snap/new/ARC_code/eval/291dc1e1.py\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reorder and stack rectangles by proximity to two colored edge lines.\n\n    Input structure:\n    - bg = most common color.\n    - Two edge lines (h + v) meet at a corner marked by a unique color.\n    - \"Blue\" line is color 1 if present, else the longer line; other is \"red.\"\n    - Solid rectangles in the interior.\n\n    Rule:\n    - Sort rectangles by (distance to blue edge, distance to red edge).\n    - If the blue edge is vertical, rotate each rectangle 90° CCW.\n    - Stack top-to-bottom, centered horizontally.\n\n    Key insight: Edge-line colors encode a coordinate system; proximity to each axis determines stacking order and rotation.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # --- locate the marked corner ---\n    corners = [(0, 0), (0, int(W - 1)), (int(H - 1), 0), (int(H - 1), int(W - 1))]\n    corner = None\n    for r, c in corners:\n        if int(g[r, c]) == int(bg):\n            continue\n        nbr = []\n        if r == 0:\n            nbr.append(int(g[r + 1, c]))\n        if r == H - 1:\n            nbr.append(int(g[r - 1, c]))\n        if c == 0:\n            nbr.append(int(g[r, c + 1]))\n        if c == W - 1:\n            nbr.append(int(g[r, c - 1]))\n        if nbr and all(int(n) != int(g[r, c]) for n in nbr):\n            corner = (int(r), int(c))\n            break\n    assert corner is not None\n\n    cr, cc = map(int, corner)\n    marker = int(g[cr, cc])\n\n    # --- line colors adjacent to the corner ---\n    hstep = 1 if cc == 0 else -1\n    vstep = 1 if cr == 0 else -1\n    hcol = int(g[cr, cc + hstep])\n    vcol = int(g[cr + vstep, cc])\n\n    # Choose \"blue\" line color.\n    if hcol == 1 or vcol == 1:\n        blue_col = 1\n        red_col = int(vcol if hcol == 1 else hcol)\n    else:\n        # Fallback: longer line is blue.\n        hlen = 0\n        c = int(cc + hstep)\n        while 0 <= c < W and int(g[cr, c]) == int(hcol):\n            hlen += 1\n            c += int(hstep)\n        vlen = 0\n        r = int(cr + vstep)\n        while 0 <= r < H and int(g[r, cc]) == int(vcol):\n            vlen += 1\n            r += int(vstep)\n        if vlen >= hlen:\n            blue_col = int(vcol)\n            red_col = int(hcol)\n        else:\n            blue_col = int(hcol)\n            red_col = int(vcol)\n\n    blue_orient = \"h\" if int(hcol) == int(blue_col) else \"v\"\n    red_orient = \"h\" if int(hcol) == int(red_col) else \"v\"\n\n    # --- mask out the two edge lines (entire corner row + col) ---\n    line_mask = np.zeros((H, W), dtype=bool)\n    line_mask[cr, :] = True\n    line_mask[:, cc] = True\n\n    # --- extract solid rectangles (no bg inside bbox) ---\n    mask = (g != int(bg)) & (~line_mask) & (g != int(marker))\n    rects = []\n    for coords in components_mask(mask, connectivity=4):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if bool((sub == int(bg)).any()):\n            continue\n        rects.append({\"box\": tuple(map(int, b)), \"arr\": sub.copy()})\n\n    assert not (not rects)\n\n    def dist_to_edge(rect: dict, orient: str, edge_idx: int) -> int:\n        r0, c0, r1, c1 = map(int, rect[\"box\"])\n        if orient == \"v\":\n            col = int(edge_idx)\n            if int(c0) > col:\n                return int(c0 - col - 1)\n            if int(c1) < col:\n                return int(col - c1 - 1)\n            return 0\n        row = int(edge_idx)\n        if int(r0) > row:\n            return int(r0 - row - 1)\n        if int(r1) < row:\n            return int(row - r1 - 1)\n        return 0\n\n    blue_edge_idx = int(cc if blue_orient == \"v\" else cr)\n    red_edge_idx = int(cc if red_orient == \"v\" else cr)\n\n    def along_from_corner(rect: dict, orient: str) -> int:\n        r0, c0, r1, c1 = map(int, rect[\"box\"])\n        if orient == \"v\":\n            return int(r0 if cr == 0 else -r1)\n        return int(c0 if cc == 0 else -c1)\n\n    for rct in rects:\n        rct[\"db\"] = int(dist_to_edge(rct, blue_orient, blue\n--- END ---\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate input for 291dc1e1\")\n--- END ---\n=====\nFILE: /home/lixinyu/snap/new/ARC_code/eval/898e7135.py\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Inflate a frame's hole-layout and fill each hole with its matching piece.\n\n    Input structure:\n    - bg = most common color. Largest component is a monochrome frame enclosing bg holes.\n    - Outside pieces composed of k×k blocks; k = side of smallest solid square piece.\n\n    Rule:\n    - Extract connected hole regions inside the frame as slots.\n    - Match each piece to a slot by comparing block-level shapes under rotation/flip.\n    - Output the layout scaled by k, with pieces placed in slots; frame color as background.\n\n    Key insight: Pieces are k×k-block-scaled versions of holes; downsampling reveals shape matches under all 8 orientations.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    # --- find the largest connected component of foreground (multicolor) ---\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n    frame_comp = max(comps, key=lambda d: int(d[\"area\"]))\n    fr0, fc0, fr1, fc1 = map(int, frame_comp[\"bbox\"])\n\n    # The frame is monochrome; use its dominant color as output background.\n    frame_cols = [int(g[int(r), int(c)]) for r, c in frame_comp[\"coords\"]]\n    bgc = int(Counter(frame_cols).most_common(1)[0][0])\n\n    # --- layout = bg holes inside the frame bbox, tight-cropped ---\n    sub = crop_bbox(g, (fr0, fc0, fr1, fc1))\n    hole = sub == int(bg)\n    hole_box = bbox(hole)\n    assert hole_box is not None, \"frame must enclose at least one bg hole\"\n    lr0, lc0, lr1, lc1 = map(int, hole_box)\n    layout = hole[lr0 : lr1 + 1, lc0 : lc1 + 1]\n\n    # --- slot components in the layout ---\n    slots = []\n    for coords in components_mask(layout, connectivity=4):\n        rr0, cc0, rr1, cc1 = bbox_coords(coords)\n        rr0, cc0, rr1, cc1 = map(int, (rr0, cc0, rr1, cc1))\n        h = int(rr1 - rr0 + 1)\n        w = int(cc1 - cc0 + 1)\n        sm = np.zeros((h, w), dtype=bool)\n        sm[coords[:, 0] - rr0, coords[:, 1] - cc0] = True\n        slots.append({\"area\": int(sm.sum()), \"r0\": int(rr0), \"c0\": int(cc0), \"mask\": sm})\n    slots.sort(key=lambda s: (-int(s[\"area\"]), int(s[\"r0\"]), int(s[\"c0\"])))\n\n    assert slots, \"frame must contain at least one slot\"\n\n    # --- pieces = non-singleton foreground components excluding the frame component ---\n    pieces = []\n    for comp in comps:\n        if comp is frame_comp:\n            continue\n        coords = comp[\"coords\"]\n        if coords.size == 0 or int(coords.shape[0]) <= 1:\n            continue\n        pr0, pc0, pr1, pc1 = map(int, comp[\"bbox\"])\n        patch = crop_bbox(g, (pr0, pc0, pr1, pc1))\n        ph, pw = map(int, patch.shape)\n        pm = np.zeros((ph, pw), dtype=bool)\n        pm[coords[:, 0] - pr0, coords[:, 1] - pc0] = True\n        pieces.append({\"area\": int(pm.sum()), \"mask\": pm, \"patch\": patch})\n\n    assert pieces, \"at least one non-frame piece must exist\"\n\n    # --- infer k from the smallest solid square piece ---\n    k = None\n    for p in pieces:\n        h, w = map(int, p[\"mask\"].shape)\n        if h == w and int(p[\"mask\"].sum()) == int(h * w):\n            k = int(h) if k is None else min(int(k), int(h))\n    k = int(k or 1)\n\n    def downsample_blocks(mask: np.ndarray) -> np.ndarray | None:\n        hh, ww = mask.shape\n        if hh % k != 0 or ww % k != 0:\n            return None\n        out_h, out_w = int(hh // k), int(ww // k)\n        out = np.zeros((out_h, out_w), dtype=bool)\n        for r in range(out_h):\n            for c in range(out_w):\n                block = mask[int(r * k) : int((r + 1) * k), int(c * k) : int((c + 1) * k)]\n                if bool(block.all()):\n                    out[r, c] = True\n                elif bool(block.any()):\n                    return None\n        return out\n\n    def dihedral_variants(\n        patch: np.ndarray, mask: np.ndarray\n    ) -> list[tuple[np.ndarray, np.ndarray]]:\n        base = []\n        for kk in range(4):\n            p = np.rot90(patch, int(kk))\n            m = np.rot9\n--- END ---\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATE_MAX_RETRIES):\n        res = _gen_attempt()\n        if res is not None:\n            return res\n    raise RuntimeError(\"generate_input: failed to generate after %d attempts\" % GENERATE_MAX_RETRIES)\n--- END ---\n=====\nFILE: /home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extend a green path from one grid edge to the opposite, routing around red bars at a distance dictated by their blue pixel count.\n\n    Input structure:\n    - bg = azure (8). Red/blue bars (color 2/1) act as obstacles.\n    - A single green (3) pixel sits on a grid border — the path start.\n\n    Rule:\n    - Each bar's keep-out radius equals its number of blue pixels; the path must stay farther than that from every bar cell.\n    - The green pixel extends inward toward the opposite edge, turning at right angles to navigate around forbidden zones.\n    - After the path is drawn, all blue pixels become red.\n\n    Key insight: Blue pixels on a bar encode its danger radius — more blue means a wider no-go zone the path must respect.\n    \"\"\"\n    g = np.array(grid, copy=True)\n    h, w = g.shape\n\n    BG = 8\n    GREEN = 3\n    BLUE = 1\n    RED = 2\n\n    dirs = _DIRS_URDL  # U, R, D, L\n\n    # --- find the unique green start pixel on the border ---\n    start_pts = np.argwhere(g == GREEN)\n    assert start_pts.shape[0] == 1, \"grid must contain exactly one green start pixel\"\n    sr, sc = map(int, start_pts[0])\n\n    # Inward initial direction + opposite-edge target.\n    if sr == 0:\n        init_dir = 2  # down\n        goal_kind, goal_val = \"row\", h - 1\n    elif sr == h - 1:\n        init_dir = 0  # up\n        goal_kind, goal_val = \"row\", 0\n    elif sc == 0:\n        init_dir = 1  # right\n        goal_kind, goal_val = \"col\", w - 1\n    elif sc == w - 1:\n        init_dir = 3  # left\n        goal_kind, goal_val = \"col\", 0\n    else:\n        raise AssertionError(\"green start must be on a border edge\")\n\n    def is_goal(r: int, c: int) -> bool:\n        return (r == goal_val) if goal_kind == \"row\" else (c == goal_val)\n\n    # --- find bar components (colors {1,2}) ---\n    bar_mask = (g == BLUE) | (g == RED)\n    bar_comps = components_mask(bar_mask, connectivity=4)\n\n    # --- build forbidden region: for each bar, forbid cells within Manhattan distance <= blue_count ---\n    forbidden = np.zeros((h, w), dtype=bool)\n    for comp in bar_comps:\n        blue_count = sum(1 for r, c in comp if g[r, c] == BLUE)\n        radius = int(blue_count)\n\n        dist = np.full((h, w), -1, dtype=np.int16)\n        q = deque()\n        for r, c in comp:\n            dist[r, c] = 0\n            q.append((r, c))\n\n        while q:\n            r, c = q.popleft()\n            d = int(dist[r, c])\n            forbidden[r, c] = True\n            if d == radius:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h and 0 <= cc < w and dist[rr, cc] == -1:\n                    dist[rr, cc] = d + 1\n                    q.append((rr, cc))\n\n    blocked = bar_mask | forbidden\n    blocked[sr, sc] = False\n\n    # --- Dijkstra: minimize (steps, turns) ---\n    INF = (10**9, 10**9)\n    best_cost: dict[tuple[int, int, int], tuple[int, int]] = {(sr, sc, init_dir): (0, 0)}\n    prev: dict[tuple[int, int, int], tuple[int, int, int]] = {}\n    heap: list[tuple[tuple[int, int], int, int, int]] = [((0, 0), sr, sc, init_dir)]\n\n    goal_state: tuple[int, int, int] | None = None\n    while heap:\n        (steps, turns), r, c, dprev = heapq.heappop(heap)\n        if (steps, turns) != best_cost.get((r, c, dprev), INF):\n            continue\n        if is_goal(r, c) and (r, c) != (sr, sc):\n            goal_state = (r, c, dprev)\n            break\n        for nd, (dr, dc) in enumerate(dirs):\n            rr, cc = r + dr, c + dc\n            if not (0 <= rr < h and 0 <= cc < w):\n                continue\n            if blocked[rr, cc]:\n                continue\n            ncost = (steps + 1, turns + (0 if nd == dprev else 1))\n            key = (rr, cc, nd)\n            if ncost < best_cost.get(key, INF):\n                best_cost[key] = ncost\n                prev[key] = (r, c, dprev)\n                heapq.heappush(heap, (ncost, rr, cc, nd))\n\n    # --- paint path + convert blue -> red ---\n    out = g.copy()\n    assert goal_state is not None\n--- END ---\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid cb2d8a2c input\")\n--- END ---\n=====\nFILE: /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────\n--- END ---\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\n--- END ---\n=====\n","exit_code":0,"status":"completed"}}
