cts[0][\"bbox\"]\n  46:     height = int(r1 - r0 + 1)\n  47:     assert height % 2 == 0, \"object bbox height must split evenly\"\n  48: \n  49:     split_row = int(r0 + height // 2)\n  50:     row_ids = np.arange(g.shape[0])[:, None]\n  51:     fg = g != int(bg)\n  52:     upper = fg & (row_ids < split_row)\n  53:     lower = fg & (row_ids >= split_row)\n  54:     assert np.any(upper), \"expected a nonempty upper half\"\n  55:     assert np.any(lower), \"expected a nonempty lower half\"\n  56:     assert int(upper.sum()) == int(lower.sum()), \"expected equal upper and lower areas\"\n  57: \n  58:     upper_boundary_cols = np.flatnonzero(upper[split_row - 1])\n  59:     lower_boundary_cols = np.flatnonzero(lower[split_row])\n  60:     assert upper_boundary_cols.size > 0, \"upper half must touch the split boundary\"\n  61:     assert lower_boundary_cols.size > 0, \"lower half must touch the split boundary\"\n  62: \n  63:     shift = int(lower_boundary_cols.max() + 1 - upper_boundary_cols.min())\n  64:     assert shift > 0, \"upper half must shift right\"\n  65: \n  66:     upper_rows, upper_cols = np.where(upper)\n  67:     lower_rows, lower_cols = np.where(lower)\n  68:     shifted_upper_cols = upper_cols + shift\n  69:     assert int(shifted_upper_cols.max()) < g.shape[1], \"shifted upper half must fit in the grid\"\n  70: \n  71:     out = np.full_like(g, int(bg))\n  72:     out[lower_rows, lower_cols] = _swapped_values(g[lower_rows, lower_cols], color_a, color_b)\n  73:     out[upper_rows, shifted_upper_cols] = _swapped_values(g[upper_rows, upper_cols], color_a, color_b)\n  74:     return out\n  75: \n  76: # --------------- generator (o5x) ---------------\n  77: \n  78: from arc_utils import paste as _gen_paste\n  79: # Canvas and palette.\n  80: GEN_BG, GEN_GRID_SIZE = 8, 16\n  81: GEN_COLOR_POOL = [c for c in range(10) if c != GEN_BG]\n  82: \n  83: # Symmetric object shape.\n  84: GEN_HALF_HEIGHTS, GEN_MAX_WIDTHS = [3, 4], [5, 7]\n  85: GEN_MIN_ROW_WIDTH, GE