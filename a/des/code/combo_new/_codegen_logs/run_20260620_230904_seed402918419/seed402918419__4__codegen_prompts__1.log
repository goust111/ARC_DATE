{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nfrom collections import defaultdict\n\n# enumerate connected shapes size 2-4 up to translation and rotation? use brute from subsets small bounding boxes\n\ndef norm(coords):\n    coords=sorted(coords)\n    minr=min(r for r,c in coords); minc=min(c for r,c in coords)\n    return tuple(sorted((r-minr,c-minc) for r,c in coords))\n\ndef rots(coords):\n    pts=list(coords)\n    out=[]\n    for k in range(4):\n        arr=np.array(pts)\n        if k:\n            # apply 90 ccw k times around origin\n            arr=arr.copy()\n            for _ in range(k):\n                arr=np.stack([-arr[:,1], arr[:,0]], axis=1)\n        out.append(norm(map(tuple, arr)))\n    return out\n\ndef canon(coords):\n    return min(rots(coords))\n\ndef conn(coords):\n    s=set(coords)\n    stack=[next(iter(s))]; seen={stack[0]}\n    while stack:\n        r,c=stack.pop()\n        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:\n            p=(r+dr,c+dc)\n            if p in s and p not in seen:\n                seen.add(p); stack.append(p)\n    return len(seen)==len(s)\n\nshapes=[]\nseen=set()\nfor h in range(1,5):\n  for w in range(1,5):\n    cells=[(r,c) for r in range(h) for c in range(w)]\n    from itertools import combinations\n    for n in range(2,5):\n      for comb in combinations(cells,n):\n        if not conn(comb):\n          continue\n        ca=canon(comb)\n        if ca in seen:\n          continue\n        seen.add(ca)\n        shapes.append(ca)\nprint('count',len(shapes))\n\ndef mask_from(coords):\n    h=max(r for r,c in coords)+1; w=max(c for r,c in coords)+1\n    m=np.zeros((h,w),dtype=int)\n    for r,c in coords: m[r,c]=1\n    return m\n\ndef dock_ok(m, side):\n    pts=np.argwhere(m)\n    h,w=m.shape\n    if side=='top':\n        rr=pts[:,0].max(); edge=pts[pts[:,0]==rr][:,1]\n        other=pts[pts[:,0]<rr]\n        width=edge.max()-edge.min()+1\n        contiguous=len(edge)==width\n        return contiguous, width, tuple(sorted(edge-edge.min()))\n    if side=='bottom':\n        rr=pts[:,0].min(); edge=pts[pts[:,0]==rr][:,1]\n        width=edge.max()-edge.min()+1\n        contiguous=len(edge)==width\n        return contiguous, width, tuple(sorted(edge-edge.min()))\n    if side=='left':\n        cc=pts[:,1].max(); edge=pts[pts[:,1]==cc][:,0]\n        width=edge.max()-edge.min()+1\n        contiguous=len(edge)==width\n        return contiguous, width, tuple(sorted(edge-edge.min()))\n    if side=='right':\n        cc=pts[:,1].min(); edge=pts[pts[:,1]==cc][:,0]\n        width=edge.max()-edge.min()+1\n        contiguous=len(edge)==width\n        return contiguous, width, tuple(sorted(edge-edge.min()))\n\ndef rot(m,k): return np.rot90(m,k)\nfor coords in shapes:\n    m=mask_from(coords)\n    found=[]\n    for side in ['top','bottom','left','right']:\n        vals=[]\n        for k in range(4):\n            mk=rot(m,k)\n            cont,w,pat=dock_ok(mk,side)\n            if cont:\n                vals.append((k,w,pat,mk.shape))\n        byw=defaultdict(list)\n        for x in vals:\n            byw[x[1]].append(x)\n        for w,lst in byw.items():\n            if len(lst)==1:\n                found.append((side,w,lst[0][0],lst[0][3]))\n    if found:\n        print('shape')\n        print(m)\n        print(found)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
