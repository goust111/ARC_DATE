{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c \"sed -n '41,150p;261,420p' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n    Input structure\n    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n    Rule\n    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n    - Red bars that are not reached from a blue marker remain unchanged.\n    Key insight\n    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g))) - {bg}\n    assert colors <= {MARKER_COLOR, BODY_COLOR}\n    assert MARKER_COLOR in colors\n\n    bars = _vertical_bars(g, bg)\n    by_col = {bar[\"col\"]: bar for bar in bars}\n    assert len(by_col) == len(bars)\n\n    baselines = {bar[\"bottom\"] for bar in bars}\n    assert len(baselines) == 1\n    baseline = baselines.pop()\n    out = g.copy()\n    for bar in bars:\n        if bar[\"color\"] != MARKER_COLOR:\n            continue\n\n        group = [bar]\n        current = bar\n        while True:\n            next_col = current[\"col\"] + current[\"height\"]\n            next_bar = by_col.get(next_col)\n            if next_bar is None:\n                break\n            if next_bar[\"color\"] != BODY_COLOR:\n                break\n            group.append(next_bar)\n            current = next_bar\n\n        for item in group:\n            rows = item[\"coords\"][:, 0]\n            cols = item[\"coords\"][:, 1]\n            out[rows, cols] = bg\n\n        for item in group:\n            col = item[\"col\"]\n            height = item[\"height\"]\n            assert col + height <= g.shape[1]\n            out[baseline, col : col + height] = item[\"color\"]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nMIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n\n# Bar and chain structure.\nMIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\nMIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\nMIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n\n# Layout padding and retry budget.\nGAP_VALUES = (1, 2, 3)\nMAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n\n\ndef _chain_red_distributions(n_blue, n_red):\n    \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n    return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n\n\ndef _bounded_tuples(values, n, max_sum):\n    \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n    return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n\n\ndef _sample_groups():\n    \"\"\"Sample row count and bar groups before physical layout.\"\"\"\n    rows = random.randint(MIN_ROWS, MAX_ROWS)\n    max_height = min(MAX_BAR_HEIGHT, rows)\n    n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)\n    max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)\n    red_total = random.randint(MIN_RED_BARS, max_red)\n    min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)\n    max_unchained = min(MAX_UNCHAINED_RED, red_total)\n    n_unchained = random.randint(min_unchained, max_unchained)\n\n    distributions = _chain_red_distributions(n_blue, red_total - n_unchained)\n    if not distributions:\n        return None\n\n    groups = [\n        {\"kind\": \"chain\", \"colors\": [MARKER_COLOR] + [BODY_COLOR] * n_red}\n        for n_red in random.choice(distributions)\n    ]\n    groups.extend({\"kind\": \"unchained\", \"colors\": [BODY_COLOR]} for _ in range(n_unchained))\n    random.shuffle(groups)\n    if groups[0][\"kind\"] == \"unchained\":\n        for i, group in enumerate(groups):\n            if group[\"kind\"] == \"chain\":\n                groups[0], groups[i] = groups[i], groups[0]\n                break\n    return rows, max_height, groups\n\n\ndef generate_input():\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 84551f4c input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -c \"sed -n '94,150p;160,320p' /home/lixinyu/snap/new/ARC_code/train/a416fc5b.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Add the two missing colored arms of a centered diamond-sprite motif, or clear a completed motif to a blank square.\n\n    Input structure\n    An 11x11 board has orange background and pink separator bars forming nine 3x3 cells. Occupied cells contain a four-pixel diamond sprite; the center cell and one neighboring cell are red, and a completed board may also contain one grey and one teal sprite.\n\n    Rule\n    With only the two red sprites present, preserve the board and add grey and teal diamond sprites 135 degrees clockwise and counterclockwise from the non-center red arm. If those expected grey and teal sprites are already present, output an all-background square whose side length is the total number of sprite pixels.\n\n    Key insight\n    The non-center red sprite is an eight-neighbor direction from the center; the other two colored arms are fixed rotations of that direction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg, row_bands, col_bands, sprites = _parse_board(g)\n\n    red_positions = [pos for pos, color in sprites.items() if color == Color.RED]\n    assert len(red_positions) == 2 and (1, 1) in red_positions\n    red_arm_pos = [pos for pos in red_positions if pos != (1, 1)][0]\n    expected = _expected_added_sprites(red_arm_pos)\n\n    non_red_sprites = {pos: color for pos, color in sprites.items() if color != Color.RED}\n    if non_red_sprites:\n        assert len(sprites) == 4\n        assert non_red_sprites == expected\n        side = len(sprites) * len(DIAMOND_CELLS)\n        return np.full((side, side), bg, dtype=int)\n\n    out = g.copy()\n    for pos, color in expected.items():\n        assert pos not in sprites\n        _paint_diamond(out, row_bands, col_bands, pos, color, bg)\n    return out\n\n# --------------- generator (att2) ---------------\n\nGRID_SHAPE = (11, 11)\nCELL_BANDS = ((0, 3), (4, 7), (8, 11))\nSEPARATOR_INDICES = (3, 7)\nCENTER_POS = (1, 1)\nMODE_B_PROBABILITY = 0.25\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _gen_blank_board() -> tuple[np.ndarray, tuple[tuple[int, int], ...], tuple[tuple[int, int], ...]]:\n    row_bands = CELL_BANDS\n    col_bands = CELL_BANDS\n    grid = np.full(GRID_SHAPE, Color.ORANGE, dtype=int)\n    grid[list(SEPARATOR_INDICES), :] = Color.PINK\n    grid[:, list(SEPARATOR_INDICES)] = Color.PINK\n    return grid, row_bands, col_bands\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    grid, row_bands, col_bands = _gen_blank_board()\n    direction = NEIGHBOR_DIRECTIONS[np.random.randint(len(NEIGHBOR_DIRECTIONS))]\n    arm_pos = (CENTER_POS[0] + direction[0], CENTER_POS[1] + direction[1])\n    expected = _expected_added_sprites(arm_pos)\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is None:\n            continue\n        try:\n            main(grid)\n        except AssertionError:\n            continue\n        return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c \"sed -n '12,140p;452,620p' /home/lixinyu/snap/new/ARC_code/train/3bd292e8.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor wall-separated background regions alternately, starting with grey in the lower-left region.\n\n    Input structure\n    - The grid has one dominant background color and one foreground wall color.\n    - The wall pixels form one or more 4-connected one-cell-thick segments.\n    - Each wall segment separates exactly two 4-connected background regions.\n    Rule\n    - Keep all wall pixels unchanged.\n    - Label the 4-connected background regions and connect two labels when they\n      touch opposite sides of the same wall segment.\n    - Color the region containing the lower-left corner grey, then flip between\n      grey and green across every wall adjacency.\n    Key insight\n    - The red walls define a bipartite map of regions; the lower-left background\n      region fixes which side of the alternating coloring is grey.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    H, W = g.shape\n\n    colors = set(map(int, g.flat))\n    assert len(colors) == 2, \"expected exactly one background color and one wall color\"\n    bg = get_bg(g)\n    wall_colors = colors - {int(bg)}\n    assert len(wall_colors) == 1\n    wall = int(next(iter(wall_colors)))\n\n    bg_lab, n_regions = label_mask(g == int(bg), connectivity=4)\n    assert n_regions >= 2, \"walls must split the background into multiple regions\"\n    start_region = int(bg_lab[H - 1, 0])\n    assert start_region > 0, \"lower-left corner must belong to a background region\"\n\n    wall_lab, n_walls = label_mask(g == wall, connectivity=4)\n    assert n_walls >= 1\n\n    graph: dict[int, set[int]] = defaultdict(set)\n    for wall_id in range(1, n_walls + 1):\n        adjacent_regions: set[int] = set()\n        for r, c in np.argwhere(wall_lab == wall_id):\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W:\n                    region_id = int(bg_lab[rr, cc])\n                    if region_id > 0:\n                        adjacent_regions.add(region_id)\n\n        assert len(adjacent_regions) == 2, \"each wall segment must separate exactly two regions\"\n        a, b = tuple(adjacent_regions)\n        graph[a].add(b)\n        graph[b].add(a)\n\n    parity = {start_region: 0}\n    queue = deque([start_region])\n    while queue:\n        region = queue.popleft()\n        for neighbor in graph[region]:\n            neighbor_parity = 1 - parity[region]\n            if neighbor in parity:\n                assert parity[neighbor] == neighbor_parity, \"region graph must be bipartite\"\n            else:\n                parity[neighbor] = neighbor_parity\n                queue.append(neighbor)\n\n    assert set(parity) == set(range(1, n_regions + 1)), \"all background regions must be wall-connected\"\n\n    out = g.copy()\n    for region_id, region_parity in parity.items():\n        out[bg_lab == region_id] = Color.GREY if region_parity == 0 else Color.GREEN\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Grid, colors, and retry policy.\nGRID_SIZES = (7, 8, 9)\nGRID_SIZES_FOR_THREE_WALLS = (8, 9)\nWALL_COUNT_RANGE = (1, 3)\nMAX_GENERATION_ATTEMPTS = 300\nBACKGROUND_COLOR = Color.ORANGE\nWALL_COLOR = Color.RED\n\n# Wall geometry constraints.\nWALL_LENGTH_RANGE = (4, 13)\nWALL_TURN_RANGE = (1, 5)\nENDPOINT_SPACING = 2\nMAX_STAIR_PARTS = 3\nMIN_FIRST_STAIR_COL = 1\n\n# Left-right corridor layout.\nLR_LAYOUT_MAX_WALLS = 2\nLR_LAYOUT_PROBABILITY = 0.55\nLR_TURN_OPTIONS = (2, 4)\nLR_CORRIDOR_MAX_SPAN = 3\nLR_CORRIDOR_GAP = 2\n\n# Canonical grids are randomly mapped through one of eight dihedral transforms.\nTRANSFORM_OPS = 8\n\n\ndef _contains(bounds: tuple[int, int], value: int) -> bool:\n    lo, hi = bounds\n    return lo <= int(value) <= hi\n\n\ndef _paint_wall_path(grid: np.ndarray, cells: list[tuple[int, int]]) -> bool:\n    for r, c in cells:\n        if grid[r, c] != BACKGROUND_COLOR:\n            return False\n        grid[r, c] = WALL_COLOR\n    return True\n\n\ndef _split_positive(total: int, parts: int) -> list[int]:\n    if parts == 1:\n        return [int(total)]\n    cuts = sorted(random.sample(range(1, int(total)), int(parts) - 1))\n    return [b - a for a, b in zip([0] + cuts, cuts + [int(total)])]\n\n\ndef _spaced_combos(values: list[int], n: int) -> list[tuple[int, ...]]:\n    return [\n        combo\n        for combo in itertools.combinations(values, n)\n        if all(combo[i + 1] - combo[i] >= ENDPOINT_SPACING for i in range(len(combo) - 1))\n    ]\n\n\ndef _choose_endpoints(H: int, W: int, n_walls: int) -> tuple[tuple[int, ...], tuple[int, ...]] | None:\n    rows = _spaced_combos(list(range(1, H - 1)), n_walls)\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 3bd292e8 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"sed -n '16,120p;168,320p' /home/lixinyu/snap/new/ARC_code/train/fc4aaf52.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Split the two-color object horizontally, swap its colors, and slide the upper half to the right.\n\n    Input structure:\n    - The grid has one background color and exactly two foreground colors.\n    - All foreground pixels form one 4-connected object with an even-height bbox.\n    - The object has foreground pixels on both rows adjacent to its horizontal midpoint.\n\n    Rule:\n    - Split the object into upper and lower halves at the midpoint of its bbox.\n    - Swap the two foreground colors in both halves.\n    - Keep the lower half in place and shift the upper half right until its lower-left\n      boundary pixel is diagonally adjacent to the lower half's upper-right boundary pixel.\n\n    Key insight:\n    - The object is not copied or reflected; it is broken at the horizontal waist,\n      recolored by exchanging the two visible object colors, then rejoined diagonally.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected exactly two foreground colors\"\n    color_a, color_b = colors\n\n    objects = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert len(objects) == 1, \"expected one connected foreground object\"\n    r0, _c0, r1, _c1 = objects[0][\"bbox\"]\n    height = int(r1 - r0 + 1)\n    assert height % 2 == 0, \"object bbox height must split evenly\"\n\n    split_row = int(r0 + height // 2)\n    row_ids = np.arange(g.shape[0])[:, None]\n    fg = g != int(bg)\n    upper = fg & (row_ids < split_row)\n    lower = fg & (row_ids >= split_row)\n    assert np.any(upper), \"expected a nonempty upper half\"\n    assert np.any(lower), \"expected a nonempty lower half\"\n    assert int(upper.sum()) == int(lower.sum()), \"expected equal upper and lower areas\"\n\n    upper_boundary_cols = np.flatnonzero(upper[split_row - 1])\n    lower_boundary_cols = np.flatnonzero(lower[split_row])\n    assert upper_boundary_cols.size > 0, \"upper half must touch the split boundary\"\n    assert lower_boundary_cols.size > 0, \"lower half must touch the split boundary\"\n\n    shift = int(lower_boundary_cols.max() + 1 - upper_boundary_cols.min())\n    assert shift > 0, \"upper half must shift right\"\n\n    upper_rows, upper_cols = np.where(upper)\n    lower_rows, lower_cols = np.where(lower)\n    shifted_upper_cols = upper_cols + shift\n    assert int(shifted_upper_cols.max()) < g.shape[1], \"shifted upper half must fit in the grid\"\n\n    out = np.full_like(g, int(bg))\n    out[lower_rows, lower_cols] = _swapped_values(g[lower_rows, lower_cols], color_a, color_b)\n    out[upper_rows, shifted_upper_cols] = _swapped_values(g[upper_rows, upper_cols], color_a, color_b)\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import paste as _gen_paste\n# Canvas and palette.\nGEN_BG, GEN_GRID_SIZE = 8, 16\nGEN_COLOR_POOL = [c for c in range(10) if c != GEN_BG]\n\n# Symmetric object shape.\nGEN_HALF_HEIGHTS, GEN_MAX_WIDTHS = [3, 4], [5, 7]\nGEN_MIN_ROW_WIDTH, GEN_WIDTH_STEP = 1, 2\nGEN_ROW_SWAP_PROB, GEN_ROW_SWAP_HEIGHT = 0.25, 4\nGEN_ROW_SWAP_INDICES = (1, 2)\n\n# Placement and validation.\nGEN_MARGIN, GEN_RETRIES = 1, 300\n\n\ndef _gen_fc4aaf52_swap(arr: np.ndarray, color_a: int, color_b: int) -> np.ndarray:\n    out = arr.copy()\n    out[arr == color_a] = color_b\n    out[arr == color_b] = color_a\n    return out\n\n\ndef _gen_fc4aaf52_upper(half_h: int, border_color: int, fill_color: int) -> np.ndarray:\n    max_w = random.choice(GEN_MAX_WIDTHS)\n    widths = [max_w]\n    for _ in range(half_h - 1):\n        prev_w = widths[-1]\n        widths.append(random.choice([max(GEN_MIN_ROW_WIDTH, prev_w - GEN_WIDTH_STEP), prev_w]))\n    widths = list(reversed(widths))\n    if random.random() < GEN_ROW_SWAP_PROB and half_h == GEN_ROW_SWAP_HEIGHT:\n        i, j = GEN_ROW_SWAP_INDICES\n        widths[i], widths[j] = widths[j], widths[i]\n\n    bottom_lefts = [0]\n    bottom_widths = list(reversed(widths))\n    for i, width in enumerate(bottom_widths[1:], start=1):\n        prev_l = bottom_lefts[-1]\n        prev_r = prev_l + bottom_widths[i - 1] - 1\n        choices = [left for left in range(max_w - width + 1) if max(left, prev_l) <= min(left + width - 1, prev_r)]\n        bottom_lefts.append(random.choice(choices))\n    lefts = list(reversed(bottom_lefts))\n\n    upper = np.full((half_h, max_w), GEN_BG, dtype=int)\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid fc4aaf52 input\")\n","exit_code":0,"status":"completed"}}
