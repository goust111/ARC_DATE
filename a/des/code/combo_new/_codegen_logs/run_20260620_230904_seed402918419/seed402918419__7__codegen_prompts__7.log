{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np\n\ndef gen(S=6):\n    n=random.randint(2,S-2); m=random.randint(2,S-2)\n    x=[n]\n    for r in range(1,S-1):\n        prev=x[-1]\n        x.append(max(1,min(S-1, prev+random.choice([-1,0,1]))))\n    x.append(n)\n    y=[m]\n    for c in range(1,S-1):\n        prev=y[-1]\n        y.append(max(1,min(S-1, prev+random.choice([-1,0,1]))))\n    y.append(m)\n    grid=np.zeros((S,S),dtype=int)\n    for r in range(S):\n        for c in range(S):\n            top = r < y[c]\n            left = c < x[r]\n            label = (0 if top else 2) + (0 if left else 1)\n            grid[r,c]=label\n    return grid,x,y\n\ndef comps(mask):\n    S=mask.shape[0]\n    seen=np.zeros_like(mask,dtype=bool)\n    out=[]\n    for r in range(S):\n        for c in range(S):\n            if not mask[r,c] or seen[r,c]:\n                continue\n            st=[(r,c)]; seen[r,c]=True; pts=[]\n            while st:\n                rr,cc=st.pop(); pts.append((rr,cc))\n                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                    nr,nc=rr+dr,cc+dc\n                    if 0<=nr<S and 0<=nc<S and mask[nr,nc] and not seen[nr,nc]:\n                        seen[nr,nc]=True; st.append((nr,nc))\n            out.append(pts)\n    return out\n\nok=0\nfor _ in range(1000):\n    S=random.randint(4,7)\n    g,x,y=gen(S)\n    valid=True\n    for k in range(4):\n        pts=np.argwhere(g==k)\n        if len(pts)<2:\n            valid=False; break\n        if len(comps(g==k))\"'!=1:\n            valid=False; break\n        r0,c0=pts.min(0); r1,c1=pts.max(0)\n        # need TL and BR corners occupied in bbox\n        if not (g[r0,c0]==k and g[r1,c1]==k):\n            valid=False; break\n    if valid:\n        ok+=1\nprint('\"'ok',ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
