{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/a/des/code/combo_new/seed402918419/7/1.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\n\nDIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nSIDE_TO_DIR = {\n    \"top\": (-1, 0),\n    \"bottom\": (1, 0),\n    \"left\": (0, -1),\n    \"right\": (0, 1),\n}\nSIDES = tuple(SIDE_TO_DIR)\n\nSHAPE_LIBRARY = [\n    np.array([[1]], dtype=bool),\n    np.array([[1, 1]], dtype=bool),\n    np.array([[1], [1]], dtype=bool),\n    np.array([[1, 1], [1, 0]], dtype=bool),\n    np.array([[1, 1], [0, 1]], dtype=bool),\n    np.array([[1, 0], [1, 1]], dtype=bool),\n    np.array([[0, 1], [1, 1]], dtype=bool),\n    np.array([[1, 1], [1, 1]], dtype=bool),\n    np.array([[1, 1, 1]], dtype=bool),\n    np.array([[1], [1], [1]], dtype=bool),\n]\n\nGEN_ATTEMPTS = 400\nGEN_GRID_RANGE = (22, 31)\nGEN_FRAME_COUNT_RANGE = (1, 4)\nGEN_REPEAT_RANGE = (1, 5)\nGEN_FRAME_SIDE_RANGE = (5, 9)\nGEN_CHAIN_PADDING = 1\n\n\ndef _dominant_color(grid: np.ndarray) -> int:\n    values, counts = np.unique(grid, return_counts=True)\n    return int(values[int(np.argmax(counts))])\n\n\ndef _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:\n    return (\n        int(coords[:, 0].min()),\n        int(coords[:, 1].min()),\n        int(coords[:, 0].max()),\n        int(coords[:, 1].max()),\n    )\n\n\ndef _components_mask(mask: np.ndarray) -> list[np.ndarray]:\n    mask = np.asarray(mask, dtype=bool)\n    h, w = mask.shape\n    seen = np.zeros((h, w), dtype=bool)\n    comps: list[np.ndarray] = []\n\n    for r, c in np.argwhere(mask):\n        r = int(r)\n        c = int(c)\n        if seen[r, c]:\n            continue\n        seen[r, c] = True\n        stack = [(r, c)]\n        coords: list[tuple[int, int]] = []\n        while stack:\n            rr, cc = stack.pop()\n            coords.append((rr, cc))\n            for dr, dc in DIR4:\n                nr = rr + dr\n                nc = cc + dc\n                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n                    seen[nr, nc] = True\n                    stack.append((nr, nc))\n        comps.append(np.array(coords, dtype=int))\n    return comps\n\n\ndef _perimeter_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:\n    cells: set[tuple[int, int]] = set()\n    for c in range(c0, c1 + 1):\n        cells.add((r0, c))\n        cells.add((r1, c))\n    for r in range(r0 + 1, r1):\n        cells.add((r, c0))\n        cells.add((r, c1))\n    return cells\n\n\ndef _gap_side(gap: tuple[int, int], bbox: tuple[int, int, int, int]) -> str | None:\n    r0, c0, r1, c1 = bbox\n    r, c = gap\n    if r == r0 and c0 < c < c1:\n        return \"top\"\n    if r == r1 and c0 < c < c1:\n        return \"bottom\"\n    if c == c0 and r0 < r < r1:\n        return \"left\"\n    if c == c1 and r0 < r < r1:\n        return \"right\"\n    return None\n\n\ndef _count_motif_components(interior: np.ndarray, bg: int, frame_color: int) -> int:\n    total = 0\n    for color in np.unique(interior):\n        color = int(color)\n        if color == bg or color == frame_color:\n            continue\n        total += len(_components_mask(interior == color))\n    return total\n\n\ndef _find_frames(grid: np.ndarray, bg: int) -> list[dict]:\n    frames: list[dict] = []\n    for color in np.unique(grid):\n        color = int(color)\n        if color == bg:\n            continue\n        for coords in _components_mask(grid == color):\n            r0, c0, r1, c1 = _bbox(coords)\n            if r1 - r0 < 2 or c1 - c0 < 2:\n                continue\n\n            coord_set = {(int(r), int(c)) for r, c in coords}\n            perimeter = _perimeter_cells(r0, c0, r1, c1)\n            if not coord_set.issubset(perimeter):\n                continue\n\n            missing = list(perimeter - coord_set)\n            if len(missing) != 1:\n                continue\n\n            gap = missing[0]\n            side = _gap_side(gap, (r0, c0, r1, c1))\n            if side is None or int(grid[gap]) != bg:\n                continue\n\n            interior = grid[r0 + 1 : r1, c0 + 1 : c1]\n            motif_mask = (interior != bg) & (interior != color)\n            if not motif_mask.any():\n                continue\n\n            repeats = _count_motif_components(interior, bg, color)\n            if repeats <= 0:\n                continue\n\n            motif_pixels = [\n                (r0 + 1 + int(rr), c0 + 1 + int(cc), int(interior[rr, cc]))\n                for rr, cc in np.argwhere(motif_mask)\n            ]\n            step = (r1 - r0 + 1) if side in (\"top\", \"bottom\") else (c1 - c0 + 1)\n            frames.append(\n                {\n                    \"bbox\": (r0, c0, r1, c1),\n                    \"color\": color,\n                    \"side\": side,\n                    \"step\": step,\n                    \"repeats\": repeats,\n                    \"motif_pixels\": motif_pixels,\n                }\n            )\n\n    frames.sort(key=lambda item: item[\"bbox\"])\n    return frames\n\n\ndef _project_pattern(\n    out: np.ndarray,\n    motif_pixels: list[tuple[int, int, int]],\n    side: str,\n    step: int,\n    repeats: int,\n) -> None:\n    h, w = out.shape\n    dr, dc = SIDE_TO_DIR[side]\n    for copy_idx in range(1, repeats + 1):\n        shift = copy_idx * step\n        for r, c, color in motif_pixels:\n            rr = r + dr * shift\n            cc = c + dc * shift\n            if 0 <= rr < h and 0 <= cc < w:\n                out[rr, cc] = color\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Project each framed interior motif outward in the direction marked by the frame gap.\n\n    Input structure:\n    - A dominant black background contains several one-pixel-thick rectangular frames, each missing exactly one border pixel on one side.\n    - Every frame is monochrome and encloses one or more same-colored interior blocks in another color.\n    - The missing border pixel indicates one of the four cardinal projection directions.\n\n    Rule:\n    - For each frame, detect which side contains the single-pixel gap.\n    - Count the number N of 4-connected interior blocks inside that frame.\n    - Treat all non-frame colored cells inside the frame as one motif and copy that motif N times outside the frame along the gap direction.\n    - Consecutive copies are separated by the full frame height for top/bottom gaps or the full frame width for left/right gaps, and the original frame stays unchanged.\n\n    Key insight:\n    - The gap chooses the projection axis, while the number of internal blocks chooses how many equally spaced copies to emit.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = _dominant_color(g)\n    out = g.copy()\n\n    for frame in _find_frames(g, bg):\n        _project_pattern(\n            out,\n            frame[\"motif_pixels\"],\n            frame[\"side\"],\n            int(frame[\"step\"]),\n            int(frame[\"repeats\"]),\n        )\n\n    return out\n\n\ndef _chain_bbox(\n    r0: int,\n    c0: int,\n    height: int,\n    width: int,\n    side: str,\n    repeats: int,\n) -> tuple[int, int, int, int]:\n    if side == \"top\":\n        return (r0 - repeats * height, c0, r0 + height - 1, c0 + width - 1)\n    if side == \"bottom\":\n        return (r0, c0, r0 + (repeats + 1) * height - 1, c0 + width - 1)\n    if side == \"left\":\n        return (r0, c0 - repeats * width, r0 + height - 1, c0 + width - 1)\n    return (r0, c0, r0 + height - 1, c0 + (repeats + 1) * width - 1)\n\n\ndef _bbox_is_free(blocked: np.ndarray, bbox: tuple[int, int, int, int]) -> bool:\n    r0, c0, r1, c1 = bbox\n    return not bool(blocked[r0 : r1 + 1, c0 : c1 + 1].any())\n\n\ndef _mark_blocked(blocked: np.ndarray, bbox: tuple[int, int, int, int], pad: int) -> None:\n    h, w = blocked.shape\n    r0, c0, r1, c1 = bbox\n    rr0 = max(0, r0 - pad)\n    cc0 = max(0, c0 - pad)\n    rr1 = min(h - 1, r1 + pad)\n    cc1 = min(w - 1, c1 + pad)\n    blocked[rr0 : rr1 + 1, cc0 : cc1 + 1] = True\n\n\ndef _paint_frame(\n    grid: np.ndarray,\n    r0: int,\n    c0: int,\n    height: int,\n    width: int,\n    color: int,\n    side: str,\n    gap_offset: int,\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/a/des/code/combo_new/seed402918419/7/2.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\nimport numpy as np\n\n\nCoord = tuple[int, int]\n\n\ndef _bg_color(grid: np.ndarray) -> int:\n    return 0 if np.any(grid == 0) else int(Counter(map(int, grid.flat)).most_common(1)[0][0])\n\n\ndef _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:\n    r0, c0 = coords.min(axis=0)\n    r1, c1 = coords.max(axis=0)\n    return int(r0), int(c0), int(r1), int(c1)\n\n\ndef _components(mask: np.ndarray) -> list[list[Coord]]:\n    h, w = mask.shape\n    seen = np.zeros_like(mask, dtype=bool)\n    parts: list[list[Coord]] = []\n    for r in range(h):\n        for c in range(w):\n            if not mask[r, c] or seen[r, c]:\n                continue\n            stack = [(r, c)]\n            seen[r, c] = True\n            comp: list[Coord] = []\n            while stack:\n                cr, cc = stack.pop()\n                comp.append((int(cr), int(cc)))\n                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                    nr = cr + dr\n                    nc = cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n                        seen[nr, nc] = True\n                        stack.append((nr, nc))\n            parts.append(comp)\n    return parts\n\n\ndef _shape_key(coords: list[Coord]) -> tuple[Coord, ...]:\n    r0 = min(r for r, _c in coords)\n    c0 = min(c for _r, c in coords)\n    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))\n\n\ndef _border_coords(r0: int, c0: int, r1: int, c1: int) -> list[Coord]:\n    coords: list[Coord] = []\n    for c in range(c0, c1 + 1):\n        coords.append((int(r0), int(c)))\n        coords.append((int(r1), int(c)))\n    for r in range(r0 + 1, r1):\n        coords.append((int(r), int(c0)))\n        coords.append((int(r), int(c1)))\n    return coords\n\n\ndef _frame_bbox_if_valid(grid: np.ndarray, color: int) -> tuple[int, int, int, int] | None:\n    coords = np.argwhere(grid == int(color))\n    if coords.size == 0:\n        return None\n    r0, c0, r1, c1 = _bbox(coords)\n    h = r1 - r0 + 1\n    w = c1 - c0 + 1\n    if h < 5 or w < 5:\n        return None\n\n    mask = grid == int(color)\n    rows = coords[:, 0]\n    cols = coords[:, 1]\n    if not np.all((rows == r0) | (rows == r1) | (cols == c0) | (cols == c1)):\n        return None\n    if not (mask[r0, c0] and mask[r0, c1] and mask[r1, c0] and mask[r1, c1]):\n        return None\n    return r0, c0, r1, c1\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reassemble keyed line fragments back into their matching broken rectangle borders.\n\n    Input structure:\n    - Black background with several single-cell-thick rectangular borders in different colors.\n    - Each border color forms an incomplete rectangle: one or more straight edge segments are missing.\n    - Outside the frames are line fragments in other colors, and each fragment color appears once more as a single marker pixel inside exactly one frame.\n\n    Rule:\n    - Identify each frame by its incomplete rectangular border geometry.\n    - Use the interior marker pixel to pair one fragment color with one frame, then compare the outside fragment shapes with the missing perimeter segments of that frame.\n    - Remove the marker and the outside fragments, and fill the missing perimeter cells with the frame's border color.\n\n    Key insight:\n    - The marker pixel is the ownership key, while the fragment geometry reveals which border gaps must be restored.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_color(g)\n    out = g.copy()\n\n    colors = [int(color) for color in np.unique(g) if int(color) != int(bg)]\n    frames: list[dict[str, object]] = []\n    frame_by_color: dict[int, int] = {}\n    for color in colors:\n        bbox = _frame_bbox_if_valid(g, int(color))\n        if bbox is None:\n            continue\n        frame_by_color[int(color)] = len(frames)\n        frames.append({\"frame_color\": int(color), \"bbox\": bbox})\n\n    assert frames, \"expected at least one incomplete frame\"\n\n    owner_by_piece_color: dict[int, int] = {}\n    marker_by_piece_color: dict[int, Coord] = {}\n    fragments_by_piece_color: dict[int, list[list[Coord]]] = {}\n\n    for color in colors:\n        if color in frame_by_color:\n            continue\n        coords = [tuple(map(int, coord)) for coord in np.argwhere(g == int(color))]\n        owner: int | None = None\n        marker: Coord | None = None\n        outside_mask = np.zeros(g.shape, dtype=bool)\n\n        for r, c in coords:\n            inside = []\n            for idx, frame in enumerate(frames):\n                r0, c0, r1, c1 = frame[\"bbox\"]  # type: ignore[index]\n                if int(r0) < r < int(r1) and int(c0) < c < int(c1):\n                    inside.append(idx)\n            if inside:\n                assert len(inside) == 1, \"marker cannot belong to multiple frames\"\n                if owner is None:\n                    owner = int(inside[0])\n                assert owner == int(inside[0]), \"a fragment color must map to one frame\"\n                assert marker is None, \"expected exactly one marker pixel\"\n                marker = (int(r), int(c))\n            else:\n                outside_mask[int(r), int(c)] = True\n\n        assert owner is not None and marker is not None, \"piece color must have one interior marker\"\n        fragment_comps = _components(outside_mask)\n        assert fragment_comps, \"piece color must have outside fragments\"\n        owner_by_piece_color[int(color)] = int(owner)\n        marker_by_piece_color[int(color)] = marker\n        fragments_by_piece_color[int(color)] = fragment_comps\n\n    piece_color_for_frame: dict[int, int] = {}\n    for piece_color, owner in owner_by_piece_color.items():\n        assert owner not in piece_color_for_frame, \"each frame must have a unique marker color\"\n        piece_color_for_frame[int(owner)] = int(piece_color)\n\n    for idx, frame in enumerate(frames):\n        assert idx in piece_color_for_frame, \"every frame must have a marker/piece color\"\n        piece_color = int(piece_color_for_frame[idx])\n        frame_color = int(frame[\"frame_color\"])  # type: ignore[index]\n        r0, c0, r1, c1 = frame[\"bbox\"]  # type: ignore[index]\n\n        border = _border_coords(int(r0), int(c0), int(r1), int(c1))\n        missing_mask = np.zeros(g.shape, dtype=bool)\n        missing_coords: list[Coord] = []\n        for r, c in border:\n            if int(g[r, c]) != frame_color:\n                missing_mask[int(r), int(c)] = True\n                missing_coords.append((int(r), int(c)))\n\n        missing_comps = _components(missing_mask)\n        need = Counter(_shape_key(comp) for comp in missing_comps)\n        have = Counter(_shape_key(comp) for comp in fragments_by_piece_color[piece_color])\n        assert need == have, \"outside fragments must match the frame gaps\"\n\n        mr, mc = marker_by_piece_color[piece_color]\n        out[int(mr), int(mc)] = bg\n        for comp in fragments_by_piece_color[piece_color]:\n            for r, c in comp:\n                out[int(r), int(c)] = bg\n        for r, c in missing_coords:\n            out[int(r), int(c)] = frame_color\n\n    return out\n\n\n# --------------- generator ---------------\n\nGEN_BG = 0\nGEN_CANVAS = 30\nGEN_FRAME_COUNT_RANGE = (2, 5)\nGEN_FRAME_H_RANGE = (5, 10)\nGEN_FRAME_W_RANGE = (5, 10)\nGEN_FRAME_PAD = 1\nGEN_FRAGMENT_PAD = 1\nGEN_GAPS_PER_FRAME = (1, 3)\nGEN_CROP_MARGIN = 3\nGEN_ATTEMPTS = 400\n\n\ndef _draw_frame(\n    canvas: np.ndarray,\n    r0: int,\n    c0: int,\n    h: int,\n    w: int,\n    color: int,\n    gap_cells: set[Coord] | None = None,\n) -> None:\n    gaps = gap_cells or set()\n    r1 = r0 + h - 1\n    c1 = c0 + w - 1\n    for r, c in _border_coords(r0, c0, r1, c1):\n        if (int(r), int(c)) not in gaps:\n            canvas[int(r), int(c)] = int(color)\n\n\ndef _line_patch(length: int, vertical: bool, color: int) -> np.ndarray:\n    if vertical:\n        patch = np.full((length, 1), int(color), dtype=int)\n    else:\n        patch = np.full((1, length), int(color), dtype=int)\n    return patch\n\n\ndef _reserve_spot(\n    blocked: np.ndarray,\n    height: int,\n    width: int,\n    pad: int,\n    rng: np.random.Generator,\n) -> tuple[int, int] | None:\n    h, w = blocked.shape\n    candidates: list[Coord] = []\n    for r0 in range(h - height + 1):\n        for c0 in range(w - width + 1):\n            rr0 = max(0, r0 - pad)\n            cc0 = max(0, c0 - pad)\n            rr1 = min(h, r0 + height + pad)\n            cc1 = min(w, c0 + width + pad)\n            if not blocked[rr0:rr1, cc0:cc1].any():\n                candidates.append((int(r0), int(c0)))\n    if not candidates:\n        return None\n    return candidates[int(rng.integers(0, len(candidates)))]\n\n\ndef _mark_blocked(blocked: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int) -> None:\n    rr0 = max(0, int(r0) - pad)\n    cc0 = max(0, int(c0) - pad)\n    rr1 = min(blocked.shape[0], int(r0) + h + pad)\n    cc1 = min(blocked.shape[1], int(c0) + w + pad)\n    blocked[rr0:rr1, cc0:cc1] = True\n\n\ndef _sample_gaps(\n    rng: np.random.Generator,\n    h: int,\n    w: int,\n    required_orientation: str | None,\n) -> list[list[Coord]]:\n    all_sides = [\"top\", \"bottom\", \"left\", \"right\"]\n    if required_orientation == \"H\":\n","exit_code":0,"status":"completed"}}
