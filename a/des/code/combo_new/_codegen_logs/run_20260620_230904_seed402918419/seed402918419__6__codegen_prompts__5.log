{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/c6141b15.py\"","aggregated_output":"from itertools import combinations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, draw_line, find_components, get_bg, random_sprite\nimport random\n\n\nCoord = tuple[int, int]\n\n\ndef _sgn(x: int) -> int:\n    return (x > 0) - (x < 0)\n\n\ndef _straight_line_cells(a: Coord, b: Coord) -> set[Coord] | None:\n    r0, c0 = a\n    r1, c1 = b\n    dr = r1 - r0\n    dc = c1 - c0\n    if not (dr == 0 or dc == 0 or abs(dr) == abs(dc)):\n        return None\n    sr = _sgn(dr)\n    sc = _sgn(dc)\n    return {(r0 + i * sr, c0 + i * sc) for i in range(max(abs(dr), abs(dc)) + 1)}\n\n\ndef _segment_endpoints(coords: np.ndarray) -> tuple[Coord, Coord] | None:\n    cells = {tuple(map(int, rc)) for rc in coords}\n    if len(cells) < 2:\n        return None\n\n    endpoints: list[Coord] = []\n    for r, c in cells:\n        degree = sum(\n            (r + dr, c + dc) in cells\n            for dr in (-1, 0, 1)\n            for dc in (-1, 0, 1)\n            if (dr, dc) != (0, 0)\n        )\n        if degree == 1:\n            endpoints.append((r, c))\n        elif degree != 2:\n            return None\n\n    if len(endpoints) != 2:\n        return None\n    line = _straight_line_cells(endpoints[0], endpoints[1])\n    if line != cells:\n        return None\n    return endpoints[0], endpoints[1]\n\n\ndef _normalized_shape(coords: np.ndarray) -> frozenset[Coord]:\n    r0, c0, _r1, _c1 = bbox_coords(coords)\n    return frozenset((int(r - r0), int(c - c0)) for r, c in coords)\n\n\ndef _center_anchor(coords: np.ndarray) -> Coord | None:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    if (r0 + r1) % 2 or (c0 + c1) % 2:\n        return None\n    anchor = ((r0 + r1) // 2, (c0 + c1) // 2)\n    if anchor not in {tuple(map(int, rc)) for rc in coords}:\n        return None\n    return anchor\n\n\ndef _are_repeated_centered_sprites(components: list[np.ndarray]) -> bool:\n    if len(components) < 2:\n        return False\n    shapes = {_normalized_shape(coords) for coords in components}\n    return len(shapes) == 1 and all(_center_anchor(coords) is not None for coords in components)\n\n\ndef _non_collinear_three(points: list[Coord]) -> bool:\n    if len(points) != 3:\n        return True\n    (r0, c0), (r1, c1), (r2, c2) = points\n    return (r1 - r0) * (c2 - c0) != (r2 - r0) * (c1 - c0)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swap a connector segment with repeated marker sprites by connecting the marker anchors and stamping the sprite at the segment endpoints.\n\n    Input structure\n    The grid has one background color and exactly two foreground colors. One foreground color forms a single straight 8-connected segment. The other foreground color forms two or more identical centered sprites.\n\n    Rule\n    Build a background canvas of the same size. Draw straight connector-color segments between every pair of original sprite anchors. Then stamp the marker sprite, using its centered anchor, onto the two endpoints of the original connector segment.\n\n    Key insight\n    The original segment endpoints are the destinations for the repeated sprite, while the original sprite centers become the vertices of the new connector-color complete graph.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2\n\n    components_by_color = {\n        color: [\n            component[\"coords\"]\n            for component in find_components(g, bg=bg, colors=[color], connectivity=8)\n        ]\n        for color in colors\n    }\n\n    connector_colors = [\n        color\n        for color, components in components_by_color.items()\n        if len(components) == 1 and _segment_endpoints(components[0]) is not None\n    ]\n    sprite_colors = [\n        color\n        for color, components in components_by_color.items()\n        if _are_repeated_centered_sprites(components)\n    ]\n    assert len(connector_colors) == 1\n    assert len(sprite_colors) == 1\n\n    connector_color = connector_colors[0]\n    sprite_color = sprite_colors[0]\n    assert connector_color != sprite_color\n\n    endpoint_pair = _segment_endpoints(components_by_color[connector_color][0])\n    assert endpoint_pair is not None\n\n    sprite_components = components_by_color[sprite_color]\n    anchors: list[Coord] = []\n    for coords in sprite_components:\n        anchor = _center_anchor(coords)\n        assert anchor is not None\n        anchors.append(anchor)\n    assert _non_collinear_three(anchors), \"three repeated sprites must form a non-collinear triangle\"\n\n    reference_anchor = _center_anchor(sprite_components[0])\n    assert reference_anchor is not None\n    sprite_offsets = [\n        (int(r - reference_anchor[0]), int(c - reference_anchor[1]))\n        for r, c in sprite_components[0]\n    ]\n\n    out = np.full_like(g, bg)\n    for a, b in combinations(anchors, 2):\n        assert _straight_line_cells(a, b) is not None\n        draw_line(out, a[0], a[1], end_r=b[0], end_c=b[1], color=connector_color)\n\n    height, width = out.shape\n    for endpoint_r, endpoint_c in endpoint_pair:\n        for dr, dc in sprite_offsets:\n            r = endpoint_r + dr\n            c = endpoint_c + dc\n            assert 0 <= r < height and 0 <= c < width\n            out[r, c] = sprite_color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and colors.\nGRID_SIZE_MIN = 11\nGRID_SIZE_MAX = 16\nBACKGROUND_COLOR = 7\nFOREGROUND_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n\n# Symmetric sprite shape.\nSPRITE_HEIGHT_CHOICES = [1, 3, 3, 5, 5]\nSPRITE_WIDTH_CHOICES = [1, 3, 3, 5]\nSPRITE_DIM_SWAP_PROB = 0.5\nSPRITE_QUADRANT_FILL_PROB = 0.5\nSPRITE_BUILD_RETRIES = 50\n\n# Anchor layout.\nTHREE_SPRITE_PROB = 0.85\nANCHOR_LAYOUT_RETRIES = 100\nANCHOR_DIRECTIONS = ['h', 'v', 'd1', 'd2']\nTWO_ANCHOR_DIST_MIN = 3\nTWO_ANCHOR_DIST_MAX = 8\nTRIANGLE_DELTA_MIN = 3\nTRIANGLE_DELTA_MAX = 7\nTRIANGLE_ROTATIONS = [0, 1, 2, 3]\n\n# Connector segment.\nSEGMENT_RETRIES = 100\nSEGMENT_LENGTH_MIN = 6\nSEGMENT_LENGTH_MAX = 10\n\n# Overall retry budget.\nGENERATE_RETRIES = 300\n\n\ndef _gen2_symmetric_sprite(color):\n    \"\"\"Generate one connected LR+UD symmetric sprite with a filled center.\"\"\"\n    h = random.choice(SPRITE_HEIGHT_CHOICES)\n    w = random.choice(SPRITE_WIDTH_CHOICES)\n    if random.random() < SPRITE_DIM_SWAP_PROB:\n        h, w = w, h\n\n    if h == 1 and w == 1:\n        return np.array([[color]])\n\n    half_h = h // 2 + 1\n    half_w = w // 2 + 1\n    sprite = np.zeros((h, w), dtype=int)\n    cr, cc = h // 2, w // 2\n    sprite[cr, cc] = color\n\n    for r in range(half_h):\n        for c in range(half_w):\n            if random.random() < SPRITE_QUADRANT_FILL_PROB:\n                sprite[r, c] = color\n                sprite[r, w - 1 - c] = color\n                sprite[h - 1 - r, c] = color\n                sprite[h - 1 - r, w - 1 - c] = color\n\n    sprite[cr, cc] = color\n\n    from arc_utils import is_contiguous\n    mask = (sprite != 0)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport itertools\nimport random\n\n\nMARKER_COLOR = 1\nBODY_COLOR = 2\n\n\ndef _vertical_bars(g: np.ndarray, bg: int) -> list[dict]:\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    bars = []\n    baseline = None\n    for comp in comps:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert c0 == c1\n        coords = comp[\"coords\"]\n        height = r1 - r0 + 1\n        assert comp[\"area\"] == height\n        assert {(int(r), int(c)) for r, c in coords} == {(r, c0) for r in range(r0, r1 + 1)}\n        if baseline is None:\n            baseline = r1\n        else:\n            assert r1 == baseline\n        bars.append(\n            {\n                \"color\": int(comp[\"color\"]),\n                \"col\": int(c0),\n                \"bottom\": int(r1),\n                \"height\": int(height),\n                \"coords\": coords,\n            }\n        )\n\n    assert bars\n    return sorted(bars, key=lambda b: b[\"col\"])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n    Input structure\n    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n    Rule\n    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n    - Red bars that are not reached from a blue marker remain unchanged.\n    Key insight\n    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g))) - {bg}\n    assert colors <= {MARKER_COLOR, BODY_COLOR}\n    assert MARKER_COLOR in colors\n\n    bars = _vertical_bars(g, bg)\n    by_col = {bar[\"col\"]: bar for bar in bars}\n    assert len(by_col) == len(bars)\n\n    baselines = {bar[\"bottom\"] for bar in bars}\n    assert len(baselines) == 1\n    baseline = baselines.pop()\n    out = g.copy()\n    for bar in bars:\n        if bar[\"color\"] != MARKER_COLOR:\n            continue\n\n        group = [bar]\n        current = bar\n        while True:\n            next_col = current[\"col\"] + current[\"height\"]\n            next_bar = by_col.get(next_col)\n            if next_bar is None:\n                break\n            if next_bar[\"color\"] != BODY_COLOR:\n                break\n            group.append(next_bar)\n            current = next_bar\n\n        for item in group:\n            rows = item[\"coords\"][:, 0]\n            cols = item[\"coords\"][:, 1]\n            out[rows, cols] = bg\n\n        for item in group:\n            col = item[\"col\"]\n            height = item[\"height\"]\n            assert col + height <= g.shape[1]\n            out[baseline, col : col + height] = item[\"color\"]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nMIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n\n# Bar and chain structure.\nMIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\nMIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\nMIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n\n# Layout padding and retry budget.\nGAP_VALUES = (1, 2, 3)\nMAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n\n\ndef _chain_red_distributions(n_blue, n_red):\n    \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n    return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n\n\ndef _bounded_tuples(values, n, max_sum):\n    \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n    return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n\n\ndef _sample_groups():\n    \"\"\"Sample row count and bar groups before physical layout.\"\"\"\n    rows = random.randint(MIN_ROWS, MAX_ROWS)\n    max_height = min(MAX_BAR_HEIGHT, rows)\n    n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)\n    max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)\n    red_total = random.randint(MIN_RED_BARS, max_red)\n    min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)\n    max_unchained = min(MAX_UNCHAINED_RED, red_total)\n    n_unchained = random.randint(min_unchained, max_unchained)\n\n    distributions = _chain_red_distributions(n_blue, red_total - n_unchained)\n    if not distributions:\n        return None\n\n    groups = [\n        {\"kind\": \"chain\", \"colors\": [MARKER_COLOR] + [BODY_COLOR] * n_red}\n        for n_red in random.choice(distributions)\n    ]\n    groups.extend({\"kind\": \"unchained\", \"colors\": [BODY_COLOR]} for _ in range(n_unchained))\n    random.shuffle(groups)\n    if groups[0][\"kind\"] == \"unchained\":\n        for i, group in enumerate(groups):\n            if group[\"kind\"] == \"chain\":\n                groups[0], groups[i] = groups[i], groups[0]\n                break\n    return rows, max_height, groups\n\n\ndef _sample_layout(max_height, groups):\n    \"\"\"Sample gaps, heights, margins, and positioned bar columns.\"\"\"\n    n_bars = sum(len(group[\"colors\"]) for group in groups)\n    right_margin = random.randint(0, MAX_RIGHT_MARGIN)\n\n    gap_count = len(groups) - 1\n    if gap_count:\n        max_gap_sum = MAX_WIDTH - right_margin - MIN_BAR_HEIGHT * n_bars\n        gap_options = _bounded_tuples(GAP_VALUES, gap_count, max_gap_sum)\n        if not gap_options:\n            return None\n        gaps = list(random.choice(gap_options))\n    else:\n        gaps = []\n\n    height_options = _bounded_tuples(\n        tuple(range(MIN_BAR_HEIGHT, max_height + 1)),\n        n_bars,\n        MAX_WIDTH - right_margin - sum(gaps),\n    )\n    if not height_options:\n        return None\n    heights = list(random.choice(height_options))\n\n    idx = 0\n    for group in groups:\n        count = len(group[\"colors\"])\n        group[\"heights\"] = heights[idx : idx + count]\n        idx += count\n\n    span = sum(heights) + sum(gaps)\n    min_left = max(0, MIN_WIDTH - right_margin - span)\n    max_left = MAX_WIDTH - right_margin - span\n    if min_left > max_left:\n        return None\n    if min_left <= min(MAX_RANDOM_LEFT_MARGIN, max_left):\n        left_margin = random.randint(min_left, min(MAX_RANDOM_LEFT_MARGIN, max_left))\n    else:\n        left_margin = min_left\n\n    width = left_margin + span + right_margin\n    if not (MIN_WIDTH <= width <= MAX_WIDTH):\n        return None\n\n    bars = []\n    col = left_margin\n    gap_i = 0\n    for group_i, group in enumerate(groups):\n        chained = group[\"kind\"] == \"chain\"\n        for color, height in zip(group[\"colors\"], group[\"heights\"]):\n            bars.append(\n                {\n                    \"color\": color,\n                    \"height\": height,\n                    \"col\": col,\n                    \"chained\": chained,\n                }\n            )\n            col += height\n        if group_i + 1 < len(groups):\n            col += gaps[gap_i]\n            gap_i += 1\n\n    if col + right_margin != width:\n        return None\n    return bars, width\n\n\ndef _render_pair(rows, width, bars):\n    \"\"\"Render the sampled input grid and its expected transformed output.\"\"\"\n","exit_code":0,"status":"completed"}}
