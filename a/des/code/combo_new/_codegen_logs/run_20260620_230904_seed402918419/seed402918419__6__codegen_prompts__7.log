{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' /home/lixinyu/snap/new/ARC_code/eval/faa9f03d.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' /home/lixinyu/snap/new/ARC_code/eval/faa9f03d.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import components_mask, get_bg\nimport random\n\n\nDIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _pts(mask: np.ndarray) -> set[tuple[int, int]]:\n    return {tuple(map(int, rc)) for rc in np.argwhere(mask)}\n\n\ndef _axis_support(mask: set[tuple[int, int]], r: int, c: int, axis: int) -> bool:\n    if axis == 0:\n        return (r, c - 1) in mask or (r, c + 1) in mask\n    return (r - 1, c) in mask or (r + 1, c) in mask\n\n\ndef _perp_support(mask: set[tuple[int, int]], r: int, c: int, axis: int) -> bool:\n    if axis == 0:\n        return (r - 1, c) in mask or (r + 1, c) in mask\n    return (r, c - 1) in mask or (r, c + 1) in mask\n\n\ndef _component_count(shape: tuple[int, int], pts: set[tuple[int, int]]) -> int:\n    mask = np.zeros(shape, dtype=bool)\n    for r, c in pts:\n        mask[r, c] = True\n    return len(components_mask(mask, connectivity=4))\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repair a one-cell-thick colored line network by replacing singleton markers, filling short orthogonal gaps, and redirecting yellow-marked arms to the edge.\n\n    Input structure:\n    - A rectangular grid with a dominant background.\n    - Line colors form one-cell-thick horizontal/vertical stroke fragments.\n    - Marker colors are exactly those whose 4-connected components are all singleton pixels.\n    - Red singleton markers are missing line cells; yellow singleton markers are directional controls next to a line endpoint.\n\n    Rule:\n    - Assign every marker to the nearest visible line color in row/column line-of-sight, preferring an endpoint supported along that same axis.\n    - For each line color, fill the gap between consecutive facing endpoints in a row or column.\n    - A yellow control erases the old straight arm on the far side of its endpoint and paints the same color from that endpoint through the control pixel to the grid edge.\n    - At crossings, yellow-control rays win; otherwise an original-vs-filled crossing uses the more fragmented pre-repair line color, while pure filled crossings use the lower color id.\n\n    Key insight: The singleton markers identify which sparse stroke fragments belong together; after they are colored, the intended lines are the axis-aligned gaps between facing endpoints, with yellow controls flipping one arm to the marked side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    colors = set(map(int, g.ravel())) - {bg}\n    assert colors, \"expected foreground line and marker colors\"\n\n    marker_colors: set[int] = set()\n    for color in colors:\n        comps = components_mask(g == color, connectivity=4)\n        assert comps, \"foreground color must have at least one component\"\n        if max(len(comp) for comp in comps) == 1:\n            marker_colors.add(int(color))\n\n    line_colors = colors - marker_colors\n    assert line_colors, \"expected at least one non-marker line color\"\n    assert marker_colors, \"expected singleton marker colors\"\n\n    original = {color: _pts(g == color) for color in line_colors}\n    assignment: dict[tuple[int, int], int] = {}\n    assign_dir: dict[tuple[int, int], tuple[int, int]] = {}\n\n    marker_mask = np.isin(g, list(marker_colors))\n    for r0, c0 in _pts(marker_mask):\n        candidates: list[tuple[int, int, int, int, int]] = []\n        for dr, dc in DIRS4:\n            r, c = r0 + dr, c0 + dc\n            dist = 1\n            while 0 <= r < H and 0 <= c < W:\n                value = int(g[r, c])\n                if value in line_colors:\n                    axis = 0 if dr == 0 else 1\n                    supported = _axis_support(original[value], r, c, axis)\n                    candidates.append((dist, 0 if supported else 1, value, dr, dc))\n                    break\n                if value == bg or value in marker_colors:\n                    r += dr\n                    c += dc\n                    dist += 1\n                    continue\n                break\n\n        assert candidates, f\"marker at {(r0, c0)} cannot see a line color\"\n        candidates.sort()\n        _dist, _unsupported, color, dr, dc = candidates[0]\n        assignment[(r0, c0)] = int(color)\n        assign_dir[(r0, c0)] = (int(dr), int(dc))\n\n    masks = {color: set(pts) for color, pts in original.items()}\n    marker_pts = {color: set() for color in line_colors}\n    for pt, color in assignment.items():\n        masks[color].add(pt)\n        marker_pts[color].add(pt)\n\n    comp_count = {color: _component_count(g.shape, masks[color]) for color in line_colors}\n\n    def has_axis_support(color: int, r: int, c: int, axis: int) -> bool:\n        return (r, c) in marker_pts[color] or _axis_support(masks[color], r, c, axis)\n\n    def should_fill(color: int, a: tuple[int, int], b: tuple[int, int], axis: int) -> bool:\n        r1, c1 = a\n        r2, c2 = b\n        gap = c2 - c1 - 1 if axis == 0 else r2 - r1 - 1\n        if gap <= 0:\n            return False\n\n        a_axis = has_axis_support(color, r1, c1, axis)\n        b_axis = has_axis_support(color, r2, c2, axis)\n        if gap == 1:\n            if a_axis or b_axis:\n                return True\n            a_perp = _perp_support(masks[color], r1, c1, axis)\n            b_perp = _perp_support(masks[color], r2, c2, axis)\n            return not (a_perp and b_perp)\n\n        if (r1, c1) in marker_pts[color] and (r2, c2) in marker_pts[color]:\n            return False\n        return a_axis and b_axis\n\n    for color in sorted(line_colors):\n        additions: set[tuple[int, int]] = set()\n        for r in range(H):\n            cols = sorted(c for rr, c in masks[color] if rr == r)\n            for c1, c2 in zip(cols, cols[1:]):\n                if should_fill(color, (r, c1), (r, c2), axis=0):\n                    additions.update((r, c) for c in range(c1 + 1, c2))\n\n        for c in range(W):\n            rows = sorted(r for r, cc in masks[color] if cc == c)\n            for r1, r2 in zip(rows, rows[1:]):\n                if should_fill(color, (r1, c), (r2, c), axis=1):\n                    additions.update((r, c) for r in range(r1 + 1, r2))\n\n        masks[color].update(additions)\n\n    control_ray = {color: set() for color in line_colors}\n    if 4 in marker_colors:\n        for control in _pts(g == 4):\n            color = assignment[control]\n            dr, dc = assign_dir[control]\n\n            r, c = control[0] + dr, control[1] + dc\n            pivot: tuple[int, int] | None = None\n            while 0 <= r < H and 0 <= c < W:\n                if (r, c) in masks[color]:\n                    pivot = (r, c)\n                    break\n                r += dr\n                c += dc\n            assert pivot is not None, f\"yellow control at {control} has no assigned endpoint\"\n\n            old_start = (pivot[0] + dr, pivot[1] + dc)\n            if old_start in masks[color]:\n                stack = [old_start]\n                old_arm: set[tuple[int, int]] = set()\n                while stack:\n                    q = stack.pop()\n                    if q == pivot or q in old_arm or q not in masks[color]:\n                        continue\n                    old_arm.add(q)\n                    qr, qc = q\n                    for ndr, ndc in DIRS4:\n                        stack.append((qr + ndr, qc + ndc))\n\n                assert old_arm, f\"yellow control at {control} found no old arm to erase\"\n                for q in old_arm:\n                    masks[color].discard(q)\n                    marker_pts[color].discard(q)\n                    control_ray[color].discard(q)\n\n            pr, pc = -dr, -dc\n            r, c = pivot\n            while 0 <= r < H and 0 <= c < W:\n                masks[color].add((r, c))\n                control_ray[color].add((r, c))\n                r += pr\n                c += pc\n\n    claims: dict[tuple[int, int], list[int]] = {}\n    for color, pts in masks.items():\n        for pt in pts:\n            claims.setdefault(pt, []).append(int(color))\n\n    out = np.full_like(g, bg)\n\n    def marker_brackets(color: int, pt: tuple[int, int]) -> bool:\n        r, c = pt\n        same_row = [mc for mr, mc in marker_pts[color] if mr == r]\n        if any(mc < c for mc in same_row) and any(mc > c for mc in same_row):\n            return True\n        same_col = [mr for mr, mc in marker_pts[color] if mc == c]\n        return any(mr < r for mr in same_col) and any(mr > r for mr in same_col)\n\n    for pt, colors_here in claims.items():\n        forced = {color for color in colors_here if pt in control_ray[color]}\n        if forced:\n            assert len(forced) == 1, f\"ambiguous yellow-control rays at {pt}: {forced}\"\n            out[pt] = next(iter(forced))\n            continue\n\n        if len(colors_here) == 1:\n            out[pt] = colors_here[0]\n            continue\n\n        original_crossing = [color for color in colors_here if int(g[pt]) == color]\n        if original_crossing:\n            out[pt] = min(colors_here, key=lambda color: (-comp_count[color], color))\n        else:\n            bracketed = [color for color in colors_here if marker_brackets(color, pt)]\n            if bracketed:\n                out[pt] = min(bracketed, key=lambda color: (-comp_count[color], color))\n            else:\n                out[pt] = min(colors_here)\n\n    # Assert: every visible endpoint is on the boundary (or at a crossing)\n    for color in line_colors:\n        for comp in components_mask(out == color, connectivity=4):\n            pts_set = set(map(tuple, comp))\n            for r, c in pts_set:\n                nbrs = [(nr, nc) for nr, nc in [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]\n                        if (nr, nc) in pts_set]\n                if len(nbrs) != 1:\n                    continue\n                on_boundary = (r == 0 or r == H - 1 or c == 0 or c == W - 1)\n                if on_boundary:\n                    # Perpendicularity check\n                    nr, nc = nbrs[0]\n                    dr, dc = nr - r, nc - c\n                    if not ((r in (0, H-1)) and (c in (0, W-1))):\n                        perp = ((r == 0 and dr == 1) or (r == H-1 and dr == -1)\n                                or (c == 0 and dc == 1) or (c == W-1 and dc == -1))\n                        assert perp, f\"boundary endpoint ({r},{c}) color {color} not perpendicular\"\n                    continue\n                adj_other = any(\n                    0 <= r+dr < H and 0 <= c+dc < W\n                    and int(out[r+dr, c+dc]) not in (bg, color)\n                    for dr, dc in DIRS4)\n                assert adj_other, f\"dangling endpoint ({r},{c}) color {color}: not on boundary or crossing\"\n\n    # Assert: every line color crosses at least one other color\n    color_cells = {c: set() for c in line_colors}\n    for r in range(H):\n        for c in range(W):\n            v = int(out[r, c])\n            if v in line_colors:\n                color_cells[v].add((r, c))\n    crossing_colors = set()\n    for r in range(H):\n        for c in range(W):\n            a = int(out[r, c])\n            if a not in line_colors:\n                continue\n            for b in line_colors - {a}:\n                if (((r, c-1) in color_cells[b] and (r, c+1) in color_cells[b])\n                        or ((r-1, c) in color_cells[b] and (r+1, c) in color_cells[b])):\n                    crossing_colors.add(a)\n                    crossing_colors.add(b)\n    for color in line_colors:\n        assert color in crossing_colors, f\"color {color} has no crossing with any other color\"\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- CFG: grid & palette ---\nH = W = 12\nBG = 0\nDIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport itertools\nimport random\n\n\nMARKER_COLOR = 1\nBODY_COLOR = 2\n\n\ndef _vertical_bars(g: np.ndarray, bg: int) -> list[dict]:\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    bars = []\n    baseline = None\n    for comp in comps:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert c0 == c1\n        coords = comp[\"coords\"]\n        height = r1 - r0 + 1\n        assert comp[\"area\"] == height\n        assert {(int(r), int(c)) for r, c in coords} == {(r, c0) for r in range(r0, r1 + 1)}\n        if baseline is None:\n            baseline = r1\n        else:\n            assert r1 == baseline\n        bars.append(\n            {\n                \"color\": int(comp[\"color\"]),\n                \"col\": int(c0),\n                \"bottom\": int(r1),\n                \"height\": int(height),\n                \"coords\": coords,\n            }\n        )\n\n    assert bars\n    return sorted(bars, key=lambda b: b[\"col\"])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n    Input structure\n    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n    Rule\n    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n    - Red bars that are not reached from a blue marker remain unchanged.\n    Key insight\n    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g))) - {bg}\n    assert colors <= {MARKER_COLOR, BODY_COLOR}\n    assert MARKER_COLOR in colors\n\n    bars = _vertical_bars(g, bg)\n    by_col = {bar[\"col\"]: bar for bar in bars}\n    assert len(by_col) == len(bars)\n\n    baselines = {bar[\"bottom\"] for bar in bars}\n    assert len(baselines) == 1\n    baseline = baselines.pop()\n    out = g.copy()\n    for bar in bars:\n        if bar[\"color\"] != MARKER_COLOR:\n            continue\n\n        group = [bar]\n        current = bar\n        while True:\n            next_col = current[\"col\"] + current[\"height\"]\n            next_bar = by_col.get(next_col)\n            if next_bar is None:\n                break\n            if next_bar[\"color\"] != BODY_COLOR:\n                break\n            group.append(next_bar)\n            current = next_bar\n\n        for item in group:\n            rows = item[\"coords\"][:, 0]\n            cols = item[\"coords\"][:, 1]\n            out[rows, cols] = bg\n\n        for item in group:\n            col = item[\"col\"]\n            height = item[\"height\"]\n            assert col + height <= g.shape[1]\n            out[baseline, col : col + height] = item[\"color\"]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nMIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n\n# Bar and chain structure.\nMIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\nMIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\nMIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n\n# Layout padding and retry budget.\nGAP_VALUES = (1, 2, 3)\nMAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n\n\ndef _chain_red_distributions(n_blue, n_red):\n    \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n    return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n\n\ndef _bounded_tuples(values, n, max_sum):\n    \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n    return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n\n\ndef _sample_groups():\n    \"\"\"Sample row count and bar groups before physical layout.\"\"\"\n    rows = random.randint(MIN_ROWS, MAX_ROWS)\n    max_height = min(MAX_BAR_HEIGHT, rows)\n    n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)\n    max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)\n    red_total = random.randint(MIN_RED_BARS, max_red)\n    min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)\n    max_unchained = min(MAX_UNCHAINED_RED, red_total)\n    n_unchained = random.randint(min_unchained, max_unchained)\n\n    distributions = _chain_red_distributions(n_blue, red_total - n_unchained)\n    if not distributions:\n        return None\n\n    groups = [\n        {\"kind\": \"chain\", \"colors\": [MARKER_COLOR] + [BODY_COLOR] * n_red}\n        for n_red in random.choice(distributions)\n    ]\n    groups.extend({\"kind\": \"unchained\", \"colors\": [BODY_COLOR]} for _ in range(n_unchained))\n    random.shuffle(groups)\n    if groups[0][\"kind\"] == \"unchained\":\n        for i, group in enumerate(groups):\n            if group[\"kind\"] == \"chain\":\n                groups[0], groups[i] = groups[i], groups[0]\n                break\n    return rows, max_height, groups\n\n\ndef _sample_layout(max_height, groups):\n    \"\"\"Sample gaps, heights, margins, and positioned bar columns.\"\"\"\n    n_bars = sum(len(group[\"colors\"]) for group in groups)\n    right_margin = random.randint(0, MAX_RIGHT_MARGIN)\n\n    gap_count = len(groups) - 1\n    if gap_count:\n        max_gap_sum = MAX_WIDTH - right_margin - MIN_BAR_HEIGHT * n_bars\n        gap_options = _bounded_tuples(GAP_VALUES, gap_count, max_gap_sum)\n        if not gap_options:\n            return None\n        gaps = list(random.choice(gap_options))\n    else:\n        gaps = []\n\n    height_options = _bounded_tuples(\n        tuple(range(MIN_BAR_HEIGHT, max_height + 1)),\n        n_bars,\n        MAX_WIDTH - right_margin - sum(gaps),\n    )\n    if not height_options:\n        return None\n    heights = list(random.choice(height_options))\n\n    idx = 0\n    for group in groups:\n        count = len(group[\"colors\"])\n        group[\"heights\"] = heights[idx : idx + count]\n        idx += count\n\n    span = sum(heights) + sum(gaps)\n    min_left = max(0, MIN_WIDTH - right_margin - span)\n    max_left = MAX_WIDTH - right_margin - span\n    if min_left > max_left:\n        return None\n    if min_left <= min(MAX_RANDOM_LEFT_MARGIN, max_left):\n        left_margin = random.randint(min_left, min(MAX_RANDOM_LEFT_MARGIN, max_left))\n    else:\n        left_margin = min_left\n\n    width = left_margin + span + right_margin\n    if not (MIN_WIDTH <= width <= MAX_WIDTH):\n        return None\n\n    bars = []\n    col = left_margin\n    gap_i = 0\n    for group_i, group in enumerate(groups):\n        chained = group[\"kind\"] == \"chain\"\n        for color, height in zip(group[\"colors\"], group[\"heights\"]):\n            bars.append(\n                {\n                    \"color\": color,\n                    \"height\": height,\n                    \"col\": col,\n                    \"chained\": chained,\n                }\n            )\n            col += height\n        if group_i + 1 < len(groups):\n            col += gaps[gap_i]\n            gap_i += 1\n\n    if col + right_margin != width:\n        return None\n    return bars, width\n\n\ndef _render_pair(rows, width, bars):\n    \"\"\"Render the sampled input grid and its expected transformed output.\"\"\"\n    baseline = rows - 1\n    inp = np.zeros((rows, width), dtype=int)\n    out = np.zeros_like(inp)\n    for bar in bars:\n        color, height, col = bar[\"color\"], bar[\"height\"], bar[\"col\"]\n        vertical = slice(baseline - height + 1, baseline + 1)\n        inp[vertical, col] = color\n        if bar[\"chained\"]:\n            out[baseline, col : col + height] = color\n        else:\n            out[vertical, col] = color\n    return inp, out\n\n\ndef _passes_oracle(inp, expected):\n    \"\"\"Return whether the solver accepts and matches the rendered output.\"\"\"\n    try:\n        actual = main(inp)\n    except Exception:\n        return False\n","exit_code":0,"status":"completed"}}
