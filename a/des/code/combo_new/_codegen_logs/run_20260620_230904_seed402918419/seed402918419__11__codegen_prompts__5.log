{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np\nfrom collections import Counter\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed402918419/11/5.py')\nmod = SourceFileLoader('new_arc_task_dbg', str(p)).load_module()\n\nfor trial in range(500):\n    specs = mod._sample_frame_specs()\n    if specs is None:\n        continue\n    widths = [int(spec['w']) for spec in specs]\n    max_h = max(int(spec['h']) for spec in specs)\n    min_width = sum(widths) + 2 * (len(widths) - 1) + 2\n    width = int(mod._RNG.integers(min_width, min(31, min_width + 7)))\n    packed = mod._pack_columns(widths, width - 2, min_gap=2)\n    if packed is None:\n        continue\n    cols = [1 + int(c) for c in packed]\n    sep_row = max_h + int(mod._RNG.integers(3, 6))\n    fragment_masks = []\n    rots = []\n    for spec in specs:\n        rot = int(mod._RNG.integers(0, 4))\n        rots.append(rot)\n        fragment_masks.append(mod._crop_mask(np.rot90(spec['mask'], rot)))\n    remaining_height = 30 - (sep_row + 1)\n    placed = mod._place_fragments(fragment_masks, width, remaining_height)\n    if placed is None:\n        continue\n    bottom_height, fragment_positions = placed\n    height = sep_row + 1 + bottom_height\n    grid = np.full((height, width), mod.BG, dtype=int)\n    grid[sep_row, :] = mod.SEPARATOR\n    for spec, c0 in zip(specs, cols, strict=False):\n        h = int(spec['h']); w = int(spec['w'])\n        r_max = sep_row - h - 1\n        if r_max < 0:\n            break\n        r0 = int(mod._RNG.integers(0, r_max + 1))\n        frame = mod._frame_mask(h, w, spec['coords'])\n        grid[r0:r0+h, c0:c0+w][frame] = int(spec['color'])\n    else:\n        for mask, (r0, c0) in zip(fragment_masks, fragment_positions, strict=False):\n            rr, cc = np.where(mask)\n            grid[sep_row + 1 + r0 + rr, c0 + cc] = mod.FRAGMENT\n        try:\n            mod.main(grid)\n        except Exception as exc:\n            print('trial', trial, type(exc).__name__, exc)\n            print('shape', grid.shape, 'sep', sep_row)\n            print(grid)\n            top = grid[:sep_row, :]\n            frames = mod._extract_frames(top, mod.BG, mod.SEPARATOR)\n            print('spec keys', Counter(mod._rotation_key(spec['mask']) for spec in specs))\n            print('frame keys', Counter(mod._rotation_key(frame['gap_mask']) for frame in frames))\n            print('frag keys', Counter(mod._rotation_key(mod._coords_to_mask(comp)[0]) for comp in mod._components(grid[sep_row+1:,:] == mod.FRAGMENT)))\n            for i, spec in enumerate(specs):\n                print('spec', i, 'hw', spec['h'], spec['w'], 'turns', spec['turns'], 'coords', spec['coords'])\n                print(spec['mask'].astype(int))\n            for i, frame in enumerate(frames):\n                print('frame', i, 'color', frame['color'])\n                print(frame['gap_mask'].astype(int))\n            raise\nprint('no failures')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
