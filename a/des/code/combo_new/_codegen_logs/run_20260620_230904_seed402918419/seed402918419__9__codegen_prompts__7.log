ion sets around cell\n            va={(r-cell[0],c-cell[1]) for r,c in na}\n            vb={(r-cell[0],c-cell[1]) for r,c in nb}\n            if any(x[0]==0 for x in va) == any(x[0]==0 for x in vb):\n                return None\n            # crossing should provide four neighbors total\n            alln=va|vb\n            if len(alln)<4:\n                return None\n    return paths, cell_owners\n\ndef endpoint_owner(paths):\n    # terminal labels by owner line\n    return {paths[o][-1]:o for o in paths}\n\ndef move(token, rank, net):\n    paths, cell_owners = net\n    pos=paths[token][0]\n    d=(paths[token][1][0]-pos[0], paths[token][1][1]-pos[1])\n    seen=set()\n    terms=endpoint_owner(paths)\n    for _ in range(200):\n        pos=(pos[0]+d[0], pos[1]+d[1])\n        if pos in terms:\n            return terms[pos]\n        owners=cell_owners.get(pos, [])\n        if len(owners)==2:\n            horiz=[o for o in owners if any(n[0]==pos[0] for n in path_neighbors(paths[o], pos))]\n            vert=[o for o in owners if any(n[1]==pos[1] for n in path_neighbors(paths[o], pos))]\n            if len(horiz)\"'!=1 or len(vert)!=1:\n                return '\"'bad'\n            other = vert[0] if d[0]==0 else horiz[0]\n            if rank[token] >= rank[other]:\n                d=rot_right[d]\n        else:\n            # if no straight cell ahead, must follow local bend of current owner path by graph adjacency\n            # use all grey neighbors from owners containing this cell\n            # infer from paths union\n            neigh=[]\n            for o,p in paths.items():\n                if pos in p[1:]:\n                    idx=p.index(pos)\n                    for j in [idx-1, idx+1]:\n                        if 0<=j<len(p):\n                            neigh.append(p[j])\n            neigh=[n for n in set(neigh) if n\"'!=(pos[0]-d[0], pos[1]-d[1])]\n            straight=(pos[0]+d[0], pos[1]+d[1])\n            if straight in neigh:\n                pass\n            elif len(neigh)==1:\n                nd=(neigh[0][0]-pos[0], neigh[0][1]-pos[1])\n                d=nd\n            elif len(neigh)==0:\n                return '\"'dead'\n            else:\n                return 'fork'\n        if (pos,d) in seen:\n            return 'loop'\n        seen.add((pos,d))\n    return 'long'\n\nvalid=[]\nfor turn_vals in product(*[turn_options[s] for s in 'LRTB']):\n    turns=dict(zip('LRTB',turn_vals))\n    net=build_net(turns)\n    if net is None:\n        continue\n    # terminals unique and not on edges? ignore for search\n    terms=[net[0][o][-1] for o in 'LRTB']\n    if len(set(terms))<4: continue\n    for order in permutations('LRTB'):\n        rank={c:i for i,c in enumerate(order)}\n        outs={tok:move(tok,rank,net) for tok in 'LRTB'}\n        if len(set(outs.values()))==4 and all(v in 'LRTB' for v in outs.values()):\n            valid.append((turns,order,outs))\n            break\nprint('valid',len(valid))\nfor v in valid[:20]:\n    print(v)\nPY\"","aggregated_output":"valid 0\n","exit_code":0,"status":"completed"}}
