{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/a25697e4.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport numpy as np\nfrom scipy.ndimage import label\nfrom arc_utils import STRUCT4, STRUCT8, get_bg, paste, random_free_location, random_sprite\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Dock movable tools into border-anchored frames by filling cavities.\n\n    Input structure:\n    - bg = most common color.\n    - Border-touching components cluster into anchor frames with interior bg cavities.\n    - Non-border 2-color components are movable tools.\n\n    Rule:\n    - Match each tool to a frame whose cavity size equals one of its color-region counts.\n    - Rotate/flip the tool so one color fills the cavity exactly; the other stays outside.\n    - If the docking orientation uses a reflection, swap the tool's two colors.\n\n    Key insight: Cavity size determines tool–frame pairing; reflection triggers color swap.\n    \"\"\"\n    inp = grid\n    g = inp.copy()\n    bg = get_bg(g)\n    H, W = g.shape\n\n    def bbox_gap(a, b) -> int:\n        (ar0, ac0, ar1, ac1) = a\n        (br0, bc0, br1, bc1) = b\n        def gap1(x0, x1, y0, y1):\n            if y1 < x0:\n                return int(x0 - y1)\n            if x1 < y0:\n                return int(y0 - x1)\n            return 0\n        return gap1(ar0, ar1, br0, br1) + gap1(ac0, ac1, bc0, bc1)\n\n    fg = g != int(bg)\n    lab, n = label(fg, structure=STRUCT4)\n    fixed_mask = np.zeros((H, W), dtype=bool)\n    fixed_components = []\n    for cid in range(1, n + 1):\n        pts = np.argwhere(lab == cid)\n        pts_list = [(int(r), int(c)) for r, c in pts]\n        touches = any(r == 0 or r == H - 1 or c == 0 or c == W - 1 for r, c in pts_list)\n        if not touches:\n            continue\n        fixed_components.append({\"pts\": pts_list, \"bbox\": (int(pts[:,0].min()), int(pts[:,1].min()), int(pts[:,0].max()), int(pts[:,1].max()))})\n        for r, c in pts_list:\n            fixed_mask[r, c] = True\n\n    assert not (not fixed_components)\n\n    # Cluster fixed components into anchor frames.\n    parent = list(range(len(fixed_components)))\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(a, b):\n        ra, rb = find(a), find(b)\n        if ra != rb:\n            parent[rb] = ra\n\n    for i in range(len(fixed_components)):\n        for j in range(i + 1, len(fixed_components)):\n            if bbox_gap(fixed_components[i][\"bbox\"], fixed_components[j][\"bbox\"]) <= 2:\n                union(i, j)\n\n    groups: dict[int, list[int]] = {}\n    for i in range(len(fixed_components)):\n        groups.setdefault(find(i), []).append(i)\n\n    anchor_groups = []\n    for idxs in groups.values():\n        pts = [p for i in idxs for p in fixed_components[i][\"pts\"]]\n        rs = [r for r, _c in pts]\n        cs = [c for _r, c in pts]\n        bbox = (min(rs), min(cs), max(rs), max(cs))\n        mask = np.zeros((H, W), dtype=bool)\n        for r, c in pts:\n            mask[r, c] = True\n        sock = np.zeros((H, W), dtype=bool)\n        for r in range(bbox[0], bbox[2] + 1):\n            for c in range(bbox[1], bbox[3] + 1):\n                if int(g[r, c]) != int(bg):\n                    continue\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    rr, cc = r + dr, c + dc\n                    if 0 <= rr < H and 0 <= cc < W and mask[rr, cc]:\n                        sock[r, c] = True\n                        break\n\n        # Cavity = largest bg component inside bbox that is adjacent to the anchor pixels.\n        cavity = np.zeros((H, W), dtype=bool)\n        sub_bg = (g[bbox[0] : bbox[2] + 1, bbox[1] : bbox[3] + 1] == int(bg))\n        sub_lab, sub_n = label(sub_bg, structure=STRUCT4)\n        best_c = None  # (area, cid)\n        for cid in range(1, sub_n + 1):\n            ptsc = np.argwhere(sub_lab == cid)\n            area = int(len(ptsc))\n            # check adjacency to anchor within bbox\n            adj = False\n            for rr, cc in ptsc:\n                r = int(bbox[0] + rr)\n                c = int(bbox[1] + cc)\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    r2, c2 = r + dr, c + dc\n                    if bbox[0] <= r2 <= bbox[2] and bbox[1] <= c2 <= bbox[3] and mask[r2, c2]:\n                        adj = True\n                        break\n                if adj:\n                    break\n            if not adj:\n                continue\n            cand = (area, -cid)\n            if best_c is None or cand > best_c:\n                best_c = cand\n                best_id = cid\n        if best_c is not None:\n            ptsc = np.argwhere(sub_lab == best_id)\n            for rr, cc in ptsc:\n                cavity[int(bbox[0] + rr), int(bbox[1] + cc)] = True\n        cav_bbox = None\n        if cavity.any():\n            ptsc2 = np.argwhere(cavity)\n            r0c, c0c = ptsc2.min(axis=0)\n            r1c, c1c = ptsc2.max(axis=0)\n            cav_bbox = (int(r0c), int(c0c), int(r1c), int(c1c))\n\n        # swap rule for this anchor group: look for a color that appears in >=2 fixed sub-components\n        # (within the group) with different sizes and larger-above-smaller.\n        swap_needed = False\n        for col in sorted({int(x) for x in np.unique(g[mask])} - {int(bg)}):\n            sub = (g == int(col)) & mask\n            labc, nc = label(sub, structure=STRUCT4)\n            if nc < 2:\n                continue\n            comps = []\n            for cid in range(1, nc + 1):\n                ptsc = np.argwhere(labc == cid)\n                comps.append((int(len(ptsc)), float(ptsc[:, 0].mean()), float(ptsc[:, 1].mean())))\n            comps.sort(reverse=True)\n            (s0, r0, _c0), (s1, r1, _c1) = comps[0], comps[1]\n            # Swap only when the larger component is vertically above the smaller one.\n            if s0 != s1 and r0 < r1:\n                swap_needed = True\n                break\n\n        # Dominant open direction: which side has the most bg neighbors.\n        dir_list = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # U,D,L,R\n        dir_counts = [0, 0, 0, 0]\n        for r, c in pts:\n            for di, (dr, dc) in enumerate(dir_list):\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(bg):\n                    dir_counts[di] += 1\n        open_dir = dir_list[int(np.argmax(dir_counts))]\n        _labg, _ng = label(mask, structure=STRUCT4)\n        single_piece = int(_ng) == 1\n        cavity_size = int(cavity.sum())\n\n        anchor_groups.append(\n            {\n                \"mask\": mask,\n                \"bbox\": bbox,\n                \"socket_mask\": sock,\n                \"cavity_mask\": cavity,\n                \"cavity_bbox\": cav_bbox,\n                \"open_dir\": open_dir,\n                \"swap_needed\": swap_needed,\n                \"single_piece\": single_piece,\n                \"cavity_size\": cavity_size,\n                \"size\": int(mask.sum()),\n            }\n        )\n    anchor_groups.sort(key=lambda d: -d[\"size\"])\n\n    # Movable multi-color components are the remaining foreground pixels.\n    mov_mask = fg & (~fixed_mask)\n    mov_lab, mov_n = label(mov_mask, structure=STRUCT4)\n    mov_comps = []\n    for cid in range(1, mov_n + 1):\n        pts = np.argwhere(mov_lab == cid)\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        m = mov_lab[r0 : r1 + 1, c0 : c1 + 1] == cid\n        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        patch[~m] = 0\n        mov_comps.append({\"bbox\": (int(r0), int(c0), int(r1), int(c1)), \"mask\": m, \"patch\": patch, \"size\": int(len(pts))})\n    mov_comps.sort(key=lambda d: -d[\"size\"])\n\n    def choose_group(bbox) -> int:\n        best_i = 0\n        best_d = None\n        for i, grp in enumerate(anchor_groups):\n            d = bbox_gap(bbox, grp[\"bbox\"])\n            if best_d is None or d < best_d:\n                best_d = d\n                best_i = i\n        return int(best_i)\n\n    def gen_variants(patch: np.ndarray, mask: np.ndarray):\n        \"\"\"All unique dihedral variants, with a reflection flag.\"\"\"\n        base: list[tuple[np.ndarray, np.ndarray, bool]] = []\n        for k in range(4):\n            p = np.rot90(patch, k)\n            m = np.rot90(mask, k)\n            base.append((p, m, False))\n            base.append((np.fliplr(p), np.fliplr(m), True))\n        uniq: list[tuple[np.ndarray, np.ndarray, bool]] = []\n        seen = set()\n        for p, m, is_flip in base:\n            key = (m.tobytes(), p[m].tobytes())\n            if key in seen:\n                continue\n            seen.add(key)\n            uniq.append((p, m, is_flip))\n        return uniq\n\n    out = np.full_like(g, int(bg))\n    out[fixed_mask] = g[fixed_mask]\n    placed_global = fixed_mask.copy()\n    placed_groups = [grp[\"mask\"].copy() for grp in anchor_groups]\n\n    group_for_comp: list[int]\n    # Match condition (key): a tool can dock into a frame only if one of its two color-regions has\n    # pixel-count equal to the frame's cavity size. Use this to assign tools to frames (one-to-one\n    # when counts match), falling back to distance only if no such match exists.\n    comp_color_counts: list[dict[int, int]] = []\n    for comp in mov_comps:\n        vals = [int(x) for x in comp[\"patch\"][comp[\"mask\"]].flatten() if int(x) != 0]\n        comp_color_counts.append(dict(Counter(vals)))\n\n    def compatible(ci: int, gi: int) -> bool:\n        cav_sz = int(anchor_groups[gi][\"cavity_size\"])\n        return any(int(v) == cav_sz for v in comp_color_counts[ci].values())\n\n    if len(mov_comps) == len(anchor_groups) and len(anchor_groups) > 1:\n        import itertools\n\n        best_perm = None\n        best_score = None\n        for perm in itertools.permutations(range(len(anchor_groups))):\n            ok = True\n            hits = 0\n            dist_sum = 0\n            for ci, gi in enumerate(perm):\n                if not compatible(ci, gi):\n                    ok = False\n                    break\n                hits += 1\n                dist_sum += bbox_gap(mov_comps[ci][\"bbox\"], anchor_groups[gi][\"bbox\"])\n            if not ok:\n                continue\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/8698868d.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import bbox_coords, bbox_h, bbox_w, crop_bbox, find_components, label_mask\nimport random\nfrom arc_utils import label_mask, random_free_location, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Match sprites to frames by connected-hole count, then nest each sprite inside its frame.\n\n    Input structure:\n    - bg = azure (8). Large hollow squares (frames) arranged in a grid; smaller filled squares (sprites) placed elsewhere.\n    - Each frame and sprite has a distinct color. Sprites may contain holes (non-sprite-color pixels).\n\n    Rule:\n    - Frames form a regular grid; some may be bg-colored (invisible).\n    - Count connected hole regions inside each frame's interior and each sprite.\n    - Pair each frame with the sprite sharing the same hole count.\n    - Place the matched sprite inside the frame border; recolor sprite holes to the frame's color.\n\n    Key insight: The matching key is the number of connected hole components, not hole area or color.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    BG = 8  # Azure background for this puzzle family\n\n    comps = find_components(g, bg=BG, connectivity=4, monochromatic=True, return_format=\"dict\")\n\n    # Find square regions (lower fill threshold to catch sprites with holes).\n    MIN_FILL_RATIO = 0.5\n    square_regions: list[tuple[int, dict]] = []\n    for comp in comps:\n        b = comp[\"bbox\"]\n        h = int(bbox_h(b))\n        w = int(bbox_w(b))\n        area = int(comp[\"area\"])\n        if h == w and 4 <= h <= 10 and area >= int(h * h * MIN_FILL_RATIO):\n            square_regions.append((int(h), comp))\n\n    assert not (not square_regions)\n\n    # Group by size - frames are larger, sprites are smaller.\n    sizes: dict[int, list[dict]] = {}\n    for size, comp in square_regions:\n        sizes.setdefault(int(size), []).append(comp)\n\n    size_list = sorted(sizes.keys(), reverse=True)\n    frame_size = int(size_list[0])\n    sprite_size = int(size_list[1]) if len(size_list) > 1 else int(frame_size - 2)\n\n    frames = sizes.get(int(frame_size), [])\n    sprites_raw = sizes.get(int(sprite_size), [])\n    assert not (not frames)\n\n    # Determine frame grid structure from frame positions.\n    frame_positions = [(int(f[\"bbox\"][0]), int(f[\"bbox\"][1])) for f in frames]\n    min_r = min(r for r, c in frame_positions)\n    min_c = min(c for r, c in frame_positions)\n    max_r = max(r for r, c in frame_positions)\n    max_c = max(c for r, c in frame_positions)\n\n    n_rows = int((max_r - min_r) // frame_size + 1)\n    n_cols = int((max_c - min_c) // frame_size + 1)\n\n    # Build frame grid (including potential background-colored frames).\n    frame_grid = []\n    for ri in range(n_rows):\n        for ci in range(n_cols):\n            inp_r = int(min_r + ri * frame_size)\n            inp_c = int(min_c + ci * frame_size)\n            region = g[inp_r : inp_r + frame_size, inp_c : inp_c + frame_size]\n            border = np.concatenate([region[0, :], region[-1, :], region[:, 0], region[:, -1]])\n            frame_color = int(Counter(map(int, border.flatten())).most_common(1)[0][0])\n\n            inner = region[1:-1, 1:-1]\n            hole_mask = inner != int(frame_color)\n            _lab, num_holes = label_mask(hole_mask, connectivity=4)\n\n            frame_grid.append({\"color\": int(frame_color), \"out_r\": int(ri * frame_size), \"out_c\": int(ci * frame_size), \"holes\": int(num_holes)})\n\n    # Process sprites - count holes in each.\n    sprites = []\n    for comp in sprites_raw:\n        b = comp[\"bbox\"]\n        sprite_region = crop_bbox(g, b)\n        sprite_color = int(comp[\"color\"])\n        hole_mask = sprite_region != int(sprite_color)\n        _lab, num_holes = label_mask(hole_mask, connectivity=4)\n        sprites.append({\"color\": int(sprite_color), \"holes\": int(num_holes), \"content\": sprite_region.copy(), \"h\": int(sprite_region.shape[0]), \"w\": int(sprite_region.shape[1])})\n\n    # Match frames to sprites by hole count.\n    matches: dict[tuple[int, int], tuple[dict, dict]] = {}\n    used_sprites: set[int] = set()\n    for f in frame_grid:\n        for i, s in enumerate(sprites):\n            if int(i) not in used_sprites and int(f[\"holes\"]) == int(s[\"holes\"]):\n                matches[(int(f[\"out_r\"]), int(f[\"out_c\"]))] = (f, s)\n                used_sprites.add(int(i))\n                break\n\n    # Build output grid.\n    out_h = int(n_rows * frame_size)\n    out_w = int(n_cols * frame_size)\n    out = np.full((out_h, out_w), int(BG), dtype=int)\n\n    for f in frame_grid:\n        fr, fc = int(f[\"out_r\"]), int(f[\"out_c\"])\n        frame_color = int(f[\"color\"])\n        out[fr : fr + frame_size, fc : fc + frame_size] = int(frame_color)\n\n        if (fr, fc) in matches:\n            _f, sprite = matches[(fr, fc)]\n            content = np.array(sprite[\"content\"], dtype=int).copy()\n            sprite_color = int(sprite[\"color\"])\n            content[content != int(sprite_color)] = int(frame_color)\n\n            sh, sw = int(sprite[\"h\"]), int(sprite[\"w\"])\n            out[fr + 1 : fr + 1 + sh, fc + 1 : fc + 1 + sw] = content\n\n    return out\n\n# --------------- generator (attempt_1) ---------------\n\n# ── Configuration ──────────────────────────────────────────────────────\nBG = 8                      # background color (solver hardcodes azure=8)\nFRAME_SIZE_RANGE = [6, 7, 8]  # square frame side length\nGRID_DIM_RANGE = (1, 4)     # rows/cols of the frame grid (exclusive upper)\nN_RANGE = (2, 6)             # min/max frame count (inclusive)\nCANVAS_MIN = 15              # minimum input grid side\nCANVAS_MAX = 30              # maximum input grid side\nSPRITE_PADDING = 2           # extra canvas room for sprite placement\nSPRITE_PLACEMENT_PAD = 1     # padding around sprites when placing\nHOLE_START_MAX = 1           # max starting hole count (0 or 1)\nSEED_RETRIES = 50            # retries for placing isolated seed cells\nGEN_RETRIES = 300            # outer generate_input retry budget\n\n# Precompute valid grid layouts: {N: [(rows, cols), ...]}\n_LAYOUTS_BY_N: dict[int, list[tuple[int, int]]] = {}\nfor _r in range(GRID_DIM_RANGE[0], GRID_DIM_RANGE[1]):\n    for _c in range(GRID_DIM_RANGE[0], GRID_DIM_RANGE[1]):\n        if N_RANGE[0] <= _r * _c <= N_RANGE[1]:\n            _LAYOUTS_BY_N.setdefault(_r * _c, []).append((_r, _c))\n_VALID_NS = sorted(_LAYOUTS_BY_N.keys())\n\n\ndef _place_isolated_seeds(size: int, count: int) -> list[tuple[int, int]] | None:\n    \"\"\"Place `count` cells inside a (size x size) border, each mutually 4-isolated.\n    Returns seed positions or None on failure.\"\"\"\n    inner_positions = [(r, c) for r in range(1, size - 1) for c in range(1, size - 1)]\n    for _ in range(SEED_RETRIES):\n        random.shuffle(inner_positions)\n        seeds: list[tuple[int, int]] = []\n        for r, c in inner_positions:\n            if all(abs(r - rr) + abs(c - cc) > 1 for rr, cc in seeds):\n                seeds.append((r, c))\n                if len(seeds) == count:\n                    return seeds\n    return None\n\n\ndef _make_sprite_interior(size: int, hole_count: int, sprite_color: int) -> np.ndarray | None:\n    \"\"\"Build a size x size sprite with solid border and exactly `hole_count`\n    4-connected bg-hole components in the interior (grown from isolated seeds).\"\"\"\n    sprite = np.full((size, size), sprite_color, dtype=int)\n    if hole_count == 0:\n        return sprite\n    inner_cells = (size - 2) ** 2\n    if inner_cells < hole_count:\n        return None\n\n    seeds = _place_isolated_seeds(size, hole_count)\n    if seeds is None:\n        return None\n\n    # Initialize each component as its seed\n    comps: list[set[tuple[int, int]]] = [{s} for s in seeds]\n    all_hole = set(seeds)\n    for r, c in seeds:\n        sprite[r, c] = BG\n\n    # Grow each component randomly; keep components 4-separated\n    max_grow = max(1, inner_cells // max(hole_count, 1) - 1)\n    for ci, comp in enumerate(comps):\n        grow = random.randint(0, min(max_grow, inner_cells - len(all_hole)))\n        for _ in range(grow):\n            frontier = []\n            for r, c in comp:\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    nr, nc = r + dr, c + dc\n                    if not (1 <= nr <= size - 2 and 1 <= nc <= size - 2):\n                        continue\n                    if (nr, nc) in all_hole:\n                        continue\n                    # Must not be 4-adjacent to any OTHER component\n                    if any((nr + dr2, nc + dc2) in other\n                           for j, other in enumerate(comps) if j != ci\n                           for dr2, dc2 in [(-1, 0), (1, 0), (0, -1), (0, 1), (0, 0)]):\n                        continue\n                    frontier.append((nr, nc))\n            if not frontier:\n                break\n            cell = random.choice(frontier)\n            comp.add(cell)\n            all_hole.add(cell)\n            sprite[cell[0], cell[1]] = BG\n\n    _, num = label_mask(sprite != sprite_color, connectivity=4)\n    if num != hole_count:\n        return None\n    return sprite\n\n\ndef _make_frame(frame_size: int, hole_count: int, frame_color: int) -> np.ndarray | None:\n    \"\"\"Build an input-style frame: solid frame_color square with `hole_count`\n    single-pixel bg cells scattered in interior (each 4-isolated).\"\"\"\n    frame = np.full((frame_size, frame_size), frame_color, dtype=int)\n    if hole_count == 0:\n        return frame\n    inner_cells = (frame_size - 2) ** 2\n    if inner_cells < hole_count:\n        return None\n\n    seeds = _place_isolated_seeds(frame_size, hole_count)\n    if seeds is None:\n        return None\n\n    for r, c in seeds:\n        frame[r, c] = BG\n\n    _, num = label_mask(frame != frame_color, connectivity=4)\n    if num != hole_count:\n        return None\n    return frame\n\n\ndef _build_expected_output(frames, sprites, frame_colors, rows_grid, cols_grid,\n                           frame_size, sprite_size) -> np.ndarray:\n    \"\"\"Build the expected output grid: frame borders with matched sprites nested inside.\"\"\"\n    expected = np.full((rows_grid * frame_size, cols_grid * frame_size), BG, dtype=int)\n    sprite_by_k = {k: spatch for k, spatch in sprites}\n    for idx, (k, _) in enumerate(frames):\n        ri, ci = idx // cols_grid, idx % cols_grid\n        rr, cc = ri * frame_size, ci * frame_size\n        fc = frame_colors[idx]\n        expected[rr:rr + frame_size, cc:cc + frame_size] = fc\n        content = sprite_by_k[k].copy()\n        content[content == BG] = fc\n        expected[rr + 1:rr + 1 + sprite_size, cc + 1:cc + 1 + sprite_size] = content\n    return expected\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    # 1. Pick N and grid layout\n    N = random.choice(_VALID_NS)\n    rows_grid, cols_grid = random.choice(_LAYOUTS_BY_N[N])\n    frame_size = random.choice(FRAME_SIZE_RANGE)\n    sprite_size = frame_size - 2\n\n    # 2. Canvas size (must fit frame grid + room for sprites)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/898e7135.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import bbox, bbox_coords, components_mask, crop_bbox, find_components, get_bg, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Inflate a frame's hole-layout and fill each hole with its matching piece.\n\n    Input structure:\n    - bg = most common color. Largest component is a monochrome frame enclosing bg holes.\n    - Outside pieces composed of k×k blocks; k = side of smallest solid square piece.\n\n    Rule:\n    - Extract connected hole regions inside the frame as slots.\n    - Match each piece to a slot by comparing block-level shapes under rotation/flip.\n    - Output the layout scaled by k, with pieces placed in slots; frame color as background.\n\n    Key insight: Pieces are k×k-block-scaled versions of holes; downsampling reveals shape matches under all 8 orientations.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    # --- find the largest connected component of foreground (multicolor) ---\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n    frame_comp = max(comps, key=lambda d: int(d[\"area\"]))\n    fr0, fc0, fr1, fc1 = map(int, frame_comp[\"bbox\"])\n\n    # The frame is monochrome; use its dominant color as output background.\n    frame_cols = [int(g[int(r), int(c)]) for r, c in frame_comp[\"coords\"]]\n    bgc = int(Counter(frame_cols).most_common(1)[0][0])\n\n    # --- layout = bg holes inside the frame bbox, tight-cropped ---\n    sub = crop_bbox(g, (fr0, fc0, fr1, fc1))\n    hole = sub == int(bg)\n    hole_box = bbox(hole)\n    assert hole_box is not None, \"frame must enclose at least one bg hole\"\n    lr0, lc0, lr1, lc1 = map(int, hole_box)\n    layout = hole[lr0 : lr1 + 1, lc0 : lc1 + 1]\n\n    # --- slot components in the layout ---\n    slots = []\n    for coords in components_mask(layout, connectivity=4):\n        rr0, cc0, rr1, cc1 = bbox_coords(coords)\n        rr0, cc0, rr1, cc1 = map(int, (rr0, cc0, rr1, cc1))\n        h = int(rr1 - rr0 + 1)\n        w = int(cc1 - cc0 + 1)\n        sm = np.zeros((h, w), dtype=bool)\n        sm[coords[:, 0] - rr0, coords[:, 1] - cc0] = True\n        slots.append({\"area\": int(sm.sum()), \"r0\": int(rr0), \"c0\": int(cc0), \"mask\": sm})\n    slots.sort(key=lambda s: (-int(s[\"area\"]), int(s[\"r0\"]), int(s[\"c0\"])))\n\n    assert slots, \"frame must contain at least one slot\"\n\n    # --- pieces = non-singleton foreground components excluding the frame component ---\n    pieces = []\n    for comp in comps:\n        if comp is frame_comp:\n            continue\n        coords = comp[\"coords\"]\n        if coords.size == 0 or int(coords.shape[0]) <= 1:\n            continue\n        pr0, pc0, pr1, pc1 = map(int, comp[\"bbox\"])\n        patch = crop_bbox(g, (pr0, pc0, pr1, pc1))\n        ph, pw = map(int, patch.shape)\n        pm = np.zeros((ph, pw), dtype=bool)\n        pm[coords[:, 0] - pr0, coords[:, 1] - pc0] = True\n        pieces.append({\"area\": int(pm.sum()), \"mask\": pm, \"patch\": patch})\n\n    assert pieces, \"at least one non-frame piece must exist\"\n\n    # --- infer k from the smallest solid square piece ---\n    k = None\n    for p in pieces:\n        h, w = map(int, p[\"mask\"].shape)\n        if h == w and int(p[\"mask\"].sum()) == int(h * w):\n            k = int(h) if k is None else min(int(k), int(h))\n    k = int(k or 1)\n\n    def downsample_blocks(mask: np.ndarray) -> np.ndarray | None:\n        hh, ww = mask.shape\n        if hh % k != 0 or ww % k != 0:\n            return None\n        out_h, out_w = int(hh // k), int(ww // k)\n        out = np.zeros((out_h, out_w), dtype=bool)\n        for r in range(out_h):\n            for c in range(out_w):\n                block = mask[int(r * k) : int((r + 1) * k), int(c * k) : int((c + 1) * k)]\n                if bool(block.all()):\n                    out[r, c] = True\n                elif bool(block.any()):\n                    return None\n        return out\n\n    def dihedral_variants(\n        patch: np.ndarray, mask: np.ndarray\n    ) -> list[tuple[np.ndarray, np.ndarray]]:\n        base = []\n        for kk in range(4):\n            p = np.rot90(patch, int(kk))\n            m = np.rot90(mask, int(kk))\n            base.append((p, m))\n            base.append((np.fliplr(p), np.fliplr(m)))\n        uniq = []\n        seen = set()\n        for p, m in base:\n            key = m.tobytes()\n            if key in seen:\n                continue\n            seen.add(key)\n            uniq.append((p, m))\n        return uniq\n\n    # Precompute all usable (piece,variant) candidates with their block masks.\n    candidates = []\n    for pi, p in enumerate(pieces):\n        for vp, vm in dihedral_variants(p[\"patch\"], p[\"mask\"]):\n            um = downsample_blocks(vm)\n            if um is None:\n                continue\n            candidates.append({\"pi\": int(pi), \"area\": int(p[\"area\"]), \"um\": um, \"vp\": vp, \"vm\": vm})\n\n    used_piece: set[int] = set()\n    placements: list[tuple[dict, dict]] = []\n    for s in slots:\n        need_area = int(s[\"area\"]) * int(k) * int(k)\n        found = None\n        for cand in candidates:\n            if int(cand[\"pi\"]) in used_piece:\n                continue\n            if int(cand[\"area\"]) != int(need_area):\n                continue\n            if cand[\"um\"].shape != s[\"mask\"].shape:\n                continue\n            if np.array_equal(cand[\"um\"], s[\"mask\"]):\n                found = cand\n                break\n        assert found is not None, \"every slot must match a piece\"\n        used_piece.add(int(found[\"pi\"]))\n        placements.append((s, found))\n\n    outH = (int(layout.shape[0]) + 2) * int(k)\n    outW = (int(layout.shape[1]) + 2) * int(k)\n    out = np.full((outH, outW), int(bgc), dtype=int)\n\n    for s, cand in placements:\n        top = (int(s[\"r0\"]) + 1) * int(k)\n        left = (int(s[\"c0\"]) + 1) * int(k)\n        paste(out, cand[\"vp\"], int(top), int(left), mask=cand[\"vm\"], overwrite=True)\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for ARC-AGI-2 task 898e7135.\n\nOutput-first strategy:\n  1. Build a hole/wall layout of 4-conn slots (8-separated, includes unit slots).\n  2. For each slot, pick a distinct color + dihedral transform; upscale slot mask\n     by k to get the piece sprite (solid k*k blocks).\n  3. Assemble the frame (layout + 1-cell border of frame_color).\n  4. Scatter pieces outside the frame on a bg=0 canvas, plus single-pixel\n     distractor noise in a fresh color.\n\nThe generator validates main(input) == expected_output before returning.\n\"\"\"\n\nimport random\nimport numpy as np\n\nfrom arc_utils import paste, random_free_location\n\n# --- tunables ----------------------------------------------------------------\n\nK_CHOICES = [2, 3]                  # block scale factor\nLAYOUT_H_RANGE = (4, 12)           # inner layout rows\nLAYOUT_W_RANGE = (4, 8)            # inner layout cols\nN_SLOTS_RANGE = (3, 6)             # total slot count (incl. unit)\nN_UNITS_MAX = 2                    # max unit-slot count per example\nNON_UNIT_SIZE_CHOICES = [2, 3, 4, 5, 6, 7]  # area of non-unit slots\n\nHOLE_DENSITY_RANGE = (0.20, 0.50)  # valid hole fraction of layout area\nUNIT_SLOT_RETRIES = 20             # attempts per unit slot placement\nNON_UNIT_SLOT_RETRIES = 30         # attempts per non-unit slot placement\nGROW_SEED_TRIES = 8                # random seed cells tried per _grow_slot call\n\nCANVAS_DIM_RANGE = (15, 30)        # min/max for canvas height and width\nAREA_BUFFER_MULT = 4               # multiplier on piece area for canvas sizing\nAREA_BUFFER_CONST = 50             # additive constant for canvas area budget\n\nDISTRACTOR_RANGE = (8, 13)         # singleton distractor pixel count\nDISTRACTOR_RETRY_MULT = 10         # retry multiplier for distractor placement\nMIN_DISTRACTORS = 8                # minimum placed distractors to accept\n\nGENERATE_MAX_RETRIES = 300         # outer retry limit in generate_input\n\n\n# --- layout generation -------------------------------------------------------\n\ndef _canonical_shape_key(mask: np.ndarray) -> bytes:\n    \"\"\"Canonical bytes representation under D4 for a bool mask (tight-cropped).\"\"\"\n    variants = []\n    for kk in range(4):\n        r = np.rot90(mask, kk)\n        variants.append(r.tobytes() + bytes([r.shape[0], r.shape[1]]))\n        fr = np.fliplr(r)\n        variants.append(fr.tobytes() + bytes([fr.shape[0], fr.shape[1]]))\n    return min(variants)\n\n\ndef _grow_slot(forbidden: np.ndarray, target_size: int) -> np.ndarray | None:\n    \"\"\"Grow a 4-conn slot of given size starting from a random free cell.\n    `forbidden` marks cells that must not be used. Returns coords array or None.\n    \"\"\"\n    H, W = forbidden.shape\n    free_cells = np.argwhere(~forbidden)\n    if free_cells.size == 0:\n        return None\n    random.shuffle(free_cells)\n    for start in free_cells[:GROW_SEED_TRIES]:\n        r0, c0 = int(start[0]), int(start[1])\n        chosen = {(r0, c0)}\n        frontier = {(r0 - 1, c0), (r0 + 1, c0), (r0, c0 - 1), (r0, c0 + 1)}\n        while len(chosen) < target_size and frontier:\n            cands = [p for p in frontier if 0 <= p[0] < H and 0 <= p[1] < W\n                     and not forbidden[p[0], p[1]] and p not in chosen]\n            if not cands:\n                break\n            nr, nc = random.choice(cands)\n            chosen.add((nr, nc))\n            frontier.discard((nr, nc))\n            frontier.update({(nr - 1, nc), (nr + 1, nc), (nr, nc - 1), (nr, nc + 1)})\n        if len(chosen) == target_size:\n            return np.array(sorted(chosen))\n    return None\n\n\ndef _dilate8(mask: np.ndarray) -> np.ndarray:\n    \"\"\"Dilate a bool mask by 1 cell (8-connectivity).\"\"\"\n    out = mask.copy()\n    out[:-1, :] |= mask[1:, :]\n    out[1:, :] |= mask[:-1, :]\n    out[:, :-1] |= mask[:, 1:]\n    out[:, 1:] |= mask[:, :-1]\n    out[:-1, :-1] |= mask[1:, 1:]\n    out[1:, 1:] |= mask[:-1, :-1]\n    out[:-1, 1:] |= mask[1:, :-1]\n    out[1:, :-1] |= mask[:-1, 1:]\n    return out\n\n\ndef _forbid_coords(forbidden: np.ndarray, coords: np.ndarray) -> None:\n    \"\"\"Mark coords and their 8-neighbors as forbidden (in-place).\"\"\"\n    cell_mask = np.zeros_like(forbidden)\n    cell_mask[coords[:, 0], coords[:, 1]] = True\n    forbidden |= _dilate8(cell_mask)\n\n\ndef _gen_layout(h: int, w: int, n_slots: int, n_units: int) -> list[dict] | None:\n","exit_code":0,"status":"completed"}}
