{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/6350f1f4.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, colors_present, components_mask\nimport math\nimport random\n\n\nERASED = Color.GREY\nSEPARATOR = Color.BLACK\n\n\ndef _is_separator_line(line: np.ndarray) -> bool:\n    return set(map(int, line)).issubset({SEPARATOR, ERASED})\n\n\ndef _regular_intervals(separators: list[int], length: int) -> list[tuple[int, int]]:\n    assert separators, \"expected at least one separator line\"\n    bounds = [-1, *separators, int(length)]\n    intervals = [(bounds[i] + 1, bounds[i + 1]) for i in range(len(bounds) - 1)]\n    sizes = [end - start for start, end in intervals]\n    assert min(sizes) > 0, \"separators must leave non-empty blocks\"\n    assert len(set(sizes)) == 1, \"all encoded blocks must have the same size\"\n    return intervals\n\n\ndef _find_sprite(\n    g: np.ndarray,\n    row_intervals: list[tuple[int, int]],\n    col_intervals: list[tuple[int, int]],\n    payload_colors: list[int],\n) -> np.ndarray:\n    payload = set(payload_colors)\n    sprites = []\n\n    for r0, r1 in row_intervals:\n        for c0, c1 in col_intervals:\n            block = g[r0:r1, c0:c1]\n            block_colors = set(colors_present(block, exclude={ERASED}))\n            assert SEPARATOR not in block_colors, \"block interiors cannot contain separator color\"\n            if ERASED not in set(map(int, block.flat)) and block_colors == payload:\n                sprites.append(block.copy())\n\n    assert sprites, \"expected at least one fully visible sprite block\"\n    sprite = sprites[0]\n    for candidate in sprites:\n        assert np.array_equal(candidate, sprite), \"fully visible sprite blocks must match\"\n    return sprite\n\n\ndef _foreground_and_blank(sprite: np.ndarray, payload_colors: list[int]) -> tuple[int, int]:\n    counts = {color: int(np.count_nonzero(sprite == color)) for color in payload_colors}\n    assert counts[payload_colors[0]] != counts[payload_colors[1]], \"sprite colors must have a majority/minority split\"\n    foreground = max(payload_colors, key=lambda color: counts[color])\n    blank_colors = [color for color in payload_colors if color != foreground]\n    assert len(blank_colors) == 1\n    return int(foreground), int(blank_colors[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Decode a block-grid image by swapping each sprite-coded cell with a solid cell and each blank cell with the sprite.\n\n    Input structure\n    The grid is partitioned by black separator rows and columns into equal-size\n    square blocks. Each block is either a copy of one two-color sprite or a\n    uniform blank block of the sprite's minority color; grey pixels are erased\n    cells that act as wildcards.\n\n    Rule\n    Infer the repeated sprite from fully visible mixed-color blocks. Replace a\n    block matching that sprite, ignoring grey erasures, with a solid block of\n    the sprite's majority color. Replace a uniform blank block with the sprite.\n    Separator rows and columns, including grey erasures on them, become black.\n\n    Key insight\n    The small sprite is a block-level code for one macro-cell state, and the\n    uniform minority-color block is the other state; the output renders the\n    opposite code in each macro-cell while cleaning erased pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n\n    row_separators = [r for r in range(H) if _is_separator_line(g[r, :])]\n    col_separators = [c for c in range(W) if _is_separator_line(g[:, c])]\n    row_intervals = _regular_intervals(row_separators, H)\n    col_intervals = _regular_intervals(col_separators, W)\n    block_heights = {r1 - r0 for r0, r1 in row_intervals}\n    block_widths = {c1 - c0 for c0, c1 in col_intervals}\n    assert block_heights == block_widths, \"encoded blocks must be square\"\n\n    payload_colors = colors_present(g, exclude={SEPARATOR, ERASED})\n    assert len(payload_colors) == 2, \"expected exactly two non-separator payload colors\"\n    sprite = _find_sprite(g, row_intervals, col_intervals, payload_colors)\n    foreground, blank = _foreground_and_blank(sprite, payload_colors)\n\n    out = np.zeros_like(g)\n    for r0, r1 in row_intervals:\n        for c0, c1 in col_intervals:\n            block = g[r0:r1, c0:c1]\n            known = block != ERASED\n            assert known.any(), \"each block must expose at least one non-grey cell\"\n            matches_sprite = bool(np.all(block[known] == sprite[known]))\n            matches_blank = bool(np.all(block[known] == blank))\n            assert matches_sprite != matches_blank, \"each block must unambiguously match the sprite or blank state\"\n            out[r0:r1, c0:c1] = foreground if matches_sprite else sprite\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette bounds.\nGRID_COUNT_RANGE, BLOCK_SIZE_RANGE = (2, 4), (2, 4)\nPAYLOAD_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\nPAYLOAD_COLOR_COUNT = 2\nGEN_SEPARATOR_COLOR, GEN_ERASED_COLOR = int(SEPARATOR), int(ERASED)\n\n# Sprite composition constraints.\nSPRITE_FG_MIN_RATIO, SPRITE_FG_MAX_RATIO = (2, 3), (3, 4)\nSPRITE_ATTEMPTS, TINY_BLOCK_SIZE = 80, 2\n\n# Macro-cell state constraints.\nMIN_BLANK_BLOCKS, MAX_BLANK_BLOCK_DENOMINATOR = 1, 2\n\n# Grey overlay constraints.\nGREY_MIN_FRACTION, GREY_MAX_FRACTION = 0.05, 0.25\nGREY_TWO_COMPONENT_PROBABILITY, GREY_TWO_COMPONENT_ATTEMPTS = 0.5, 30\nGREY_CONNECTIVITY, GENERATION_ATTEMPTS = 4, 300\n\nNEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _separator_indices(n: int, block_size: int) -> set[int]:\n    return {(i + 1) * block_size + i for i in range(n - 1)}\n\n\ndef _block_origin(br: int, bc: int, block_size: int) -> tuple[int, int]:\n    return br * (block_size + 1), bc * (block_size + 1)\n\n\ndef _has_symmetry(mask: np.ndarray) -> bool:\n    return (\n        np.array_equal(mask, np.fliplr(mask))\n        or np.array_equal(mask, np.flipud(mask))\n        or np.array_equal(mask, np.rot90(mask, 2))\n    )\n\n\ndef _make_sprite(block_size: int, foreground: int, blank: int) -> np.ndarray | None:\n    area = block_size * block_size\n    min_num, min_den = SPRITE_FG_MIN_RATIO\n    max_num, max_den = SPRITE_FG_MAX_RATIO\n    fg_min = math.ceil(area * min_num / min_den)\n    fg_max = math.floor(area * max_num / max_den)\n    if fg_min > fg_max:\n        fg_min = fg_max = round(area * min_num / min_den)\n    fg_count = random.randint(fg_min, fg_max)\n    blank_count = area - fg_count\n\n    for _ in range(SPRITE_ATTEMPTS):\n        mask = np.ones((block_size, block_size), dtype=bool)\n        if block_size == TINY_BLOCK_SIZE:\n            blanks = [random.randrange(area)]\n        else:\n            cols = list(range(block_size))\n            random.shuffle(cols)\n            blanks = [r * block_size + cols[r] for r in range(block_size)]\n            extra = blank_count - block_size\n            if extra > 0:\n                pool = [i for i in range(area) if i not in blanks]\n                blanks.extend(random.sample(pool, extra))\n\n        for idx in blanks:\n            mask[idx // block_size, idx % block_size] = False\n\n        if block_size > TINY_BLOCK_SIZE:\n            row_mixed = all(0 < np.count_nonzero(mask[r]) < block_size for r in range(block_size))\n            col_mixed = all(0 < np.count_nonzero(mask[:, c]) < block_size for c in range(block_size))\n            if not row_mixed or not col_mixed:\n                continue\n        if _has_symmetry(mask):\n            continue\n\n        sprite = np.where(mask, foreground, blank).astype(int)\n        return sprite\n    return None\n\n\ndef _neighbors4(r: int, c: int, height: int, width: int):\n    for dr, dc in NEIGHBOR_OFFSETS_4:\n        nr, nc = r + dr, c + dc\n        if 0 <= nr < height and 0 <= nc < width:\n            yield nr, nc\n\n\ndef _grow_blob(allowed: np.ndarray, size: int) -> set[tuple[int, int]] | None:\n    comps = [\n        [tuple(map(int, rc)) for rc in coords]\n        for coords in components_mask(allowed, connectivity=GREY_CONNECTIVITY)\n        if len(coords) >= size\n    ]\n    if not comps:\n        return None\n\n    comp = random.choice(comps)\n    comp_set = set(comp)\n    seed = random.choice(comp)\n    blob = {seed}\n    frontier = {nb for nb in _neighbors4(*seed, *allowed.shape) if nb in comp_set}\n\n    while len(blob) < size:\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        blob.add(cell)\n        for nb in _neighbors4(*cell, *allowed.shape):\n            if nb in comp_set and nb not in blob:\n                frontier.add(nb)\n\n    return blob\n\n\ndef _make_grey_mask(allowed: np.ndarray, target: int) -> np.ndarray | None:\n    if target <= 0:\n        return np.zeros_like(allowed, dtype=bool)\n\n    want_two = target >= 2 and random.random() < GREY_TWO_COMPONENT_PROBABILITY\n    if want_two:\n        for _ in range(GREY_TWO_COMPONENT_ATTEMPTS):\n            first_size = random.randint(1, target - 1)\n            first = _grow_blob(allowed, first_size)\n            if first is None:\n                continue\n\n            blocked = set(first)\n            for r, c in tuple(first):\n                blocked.update(_neighbors4(r, c, *allowed.shape))\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/230f2e48.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, in_bounds, neighbors4\nimport random\n\n\ndef _line_color(g: np.ndarray, bg: int) -> int:\n    vals, counts = np.unique(g[g != int(bg)], return_counts=True)\n    assert vals.size == 3, \"expected one line color and two marker colors\"\n    max_count = int(counts.max())\n    winners = vals[counts == max_count]\n    assert winners.size == 1, \"line color must be uniquely most common\"\n    return int(winners[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fold each straight red rod at its black marker, leaving the gray-anchored side fixed.\n\n    Input structure:\n    - The background is the dominant color.\n    - Each foreground object is a straight horizontal or vertical 4-connected rod.\n    - Each rod contains many pixels of one line color, one endpoint marker, and one\n      interior control marker.\n\n    Rule:\n    - For every rod, keep the segment from the endpoint marker through the control\n      marker unchanged.\n    - Move the line-color tail on the far side of the control marker to a\n      perpendicular ray starting next to that marker.\n    - Choose the perpendicular direction with more space to the grid edge.\n\n    Key insight:\n    - The endpoint marker identifies the fixed side of the rod, while the control\n      marker is the hinge; the tail folds into the larger open half-plane.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = get_bg(g)\n    line_color = _line_color(g, bg)\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert components, \"expected at least one marked rod\"\n\n    clear: list[tuple[int, int]] = []\n    paint: list[tuple[int, int]] = []\n\n    for comp in components:\n        coords = [tuple(map(int, coord)) for coord in comp[\"coords\"]]\n        coord_set = set(coords)\n        marker_coords = [p for p in coords if int(g[p]) != line_color]\n        assert len(marker_coords) == 2, \"each rod must have exactly two markers\"\n\n        degrees = {\n            p: sum((nr, nc) in coord_set for nr, nc in neighbors4(*p))\n            for p in marker_coords\n        }\n        endpoints = [p for p, degree in degrees.items() if int(degree) == 1]\n        hinges = [p for p, degree in degrees.items() if int(degree) == 2]\n        assert len(endpoints) == 1 and len(hinges) == 1, \"markers must be endpoint and hinge\"\n        endpoint = endpoints[0]\n        hinge = hinges[0]\n\n        rows = {r for r, _c in coords}\n        cols = {c for _r, c in coords}\n        assert len(rows) == 1 or len(cols) == 1, \"each object must be a straight rod\"\n\n        if len(rows) == 1:\n            assert endpoint[0] == hinge[0], \"horizontal rod markers must share a row\"\n            fixed_sign = int(np.sign(endpoint[1] - hinge[1]))\n            assert fixed_sign != 0, \"endpoint and hinge must be distinct\"\n            tail_step = (0, -fixed_sign)\n            up_space = int(hinge[0])\n            down_space = int(H - 1 - hinge[0])\n            assert up_space != down_space, \"perpendicular direction must be unique\"\n            fold_step = (-1, 0) if up_space > down_space else (1, 0)\n        else:\n            assert endpoint[1] == hinge[1], \"vertical rod markers must share a column\"\n            fixed_sign = int(np.sign(endpoint[0] - hinge[0]))\n            assert fixed_sign != 0, \"endpoint and hinge must be distinct\"\n            tail_step = (-fixed_sign, 0)\n            left_space = int(hinge[1])\n            right_space = int(W - 1 - hinge[1])\n            assert left_space != right_space, \"perpendicular direction must be unique\"\n            fold_step = (0, -1) if left_space > right_space else (0, 1)\n\n        tail: list[tuple[int, int]] = []\n        step = 1\n        while True:\n            p = (\n                int(hinge[0]) + int(tail_step[0]) * step,\n                int(hinge[1]) + int(tail_step[1]) * step,\n            )\n            if p not in coord_set:\n                break\n            assert int(g[p]) == line_color, \"tail must contain only line-color pixels\"\n            tail.append(p)\n            step += 1\n        assert tail, \"each hinge must have a moving tail\"\n\n        for step in range(1, len(tail) + 1):\n            p = (\n                int(hinge[0]) + int(fold_step[0]) * step,\n                int(hinge[1]) + int(fold_step[1]) * step,\n            )\n            assert in_bounds(g.shape, *p), \"folded tail must remain in bounds\"\n            paint.append(p)\n        clear.extend(tail)\n\n    assert len(set(clear)) == len(clear), \"moving tails must not overlap\"\n    assert len(set(paint)) == len(paint), \"folded tails must not collide\"\n    clear_set = set(clear)\n    for p in paint:\n        assert int(g[p]) == int(bg) or p in clear_set, \"fold target must be empty\"\n\n    out = g.copy()\n    for p in clear:\n        out[p] = bg\n    for p in paint:\n        out[p] = line_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# ARC colors.\nBG, RED, HINGE, END = 7, 2, 0, 5\n\n# Canvas and rod-count sampling.\nGRID_SIZE_MIN, GRID_SIZE_MAX = 8, 16\nROD_COUNT_MIN, ROD_COUNT_MAX = 1, 7\nROD_DENSITY_DIVISOR = 28\n\n# Rod geometry sampling.\nHORIZONTAL, VERTICAL = \"h\", \"v\"\nORIENTATIONS = (HORIZONTAL, VERTICAL)\nFIXED_SIGNS = (-1, 1)\nROD_LEN_MIN, ROD_LEN_MAX = 3, 12\nFIXED_LEN_MIN, FIXED_LEN_MAX = 2, 9\nTAIL_LEN_MAX = 5\n\n# Placement and retry controls.\nGAP_DIRECTIONS = ((-1, 0), (1, 0), (0, -1), (0, 1))\nMAX_GENERATE_ATTEMPTS = 300\n\nRecord = dict[str, object]\nRecordKey = tuple[int, int, int, str]\n\n_RECORD_CACHE: dict[int, list[tuple[RecordKey, Record]]] = {}\n\n\ndef _expanded(cells: set[tuple[int, int]], n: int) -> set[tuple[int, int]]:\n    out = set(cells)\n    shape = (n, n)\n    for r, c in cells:\n        for dr, dc in GAP_DIRECTIONS:\n            nr, nc = r + dr, c + dc\n            if in_bounds(shape, nr, nc):\n                out.add((nr, nc))\n    return out\n\n\ndef _fold_steps(n: int, orient: str, hinge: tuple[int, int], fixed_sign: int):\n    \"\"\"Return fixed-arm and fold steps, or None for a centered hinge.\"\"\"\n    r, c = hinge\n    if orient == HORIZONTAL:\n        up, down = r, n - 1 - r\n        if up == down:\n            return None\n        return (0, fixed_sign), ((-1, 0) if up > down else (1, 0))\n\n    left, right = c, n - 1 - c\n    if left == right:\n        return None\n    return (fixed_sign, 0), ((0, -1) if left > right else (0, 1))\n\n\ndef _ray_cells(origin: tuple[int, int], step: tuple[int, int], count: int) -> list[tuple[int, int]]:\n    r, c = origin\n    dr, dc = step\n    return [(r + dr * k, c + dc * k) for k in range(1, count + 1)]\n\n\ndef _record(n: int, orient: str, fixed_len: int, tail_len: int, hinge: tuple[int, int], fixed_sign: int):\n    steps = _fold_steps(n, orient, hinge, fixed_sign)\n    if steps is None:\n        return None\n\n    fixed_step, fold_step = steps\n    tail_step = (-fixed_step[0], -fixed_step[1])\n    fixed = _ray_cells(hinge, fixed_step, fixed_len - 1)\n    tail = _ray_cells(hinge, tail_step, tail_len)\n    folded = _ray_cells(hinge, fold_step, tail_len)\n\n    all_cells = fixed + tail + folded + [hinge]\n    shape = (n, n)\n    if any(not in_bounds(shape, rr, cc) for rr, cc in all_cells):\n        return None\n\n    endpoint = fixed[-1]\n    fixed_red = fixed[:-1]\n    input_cells = {hinge, endpoint, *fixed_red, *tail}\n    envelope = input_cells | set(folded)\n    if len(envelope) != len(input_cells) + len(folded):\n        return None\n\n    return {\n        \"hinge\": hinge,\n        \"endpoint\": endpoint,\n        \"fixed_red\": fixed_red,\n        \"tail\": tail,\n        \"folded\": folded,\n        \"envelope\": envelope,\n        \"red_count\": fixed_len + tail_len - 2,\n    }\n\n\ndef _all_records(n: int) -> list[tuple[RecordKey, Record]]:\n    if n in _RECORD_CACHE:\n        return _RECORD_CACHE[n]\n\n    records: list[tuple[RecordKey, Record]] = []\n    for orient in ORIENTATIONS:\n        for total_len in range(ROD_LEN_MIN, ROD_LEN_MAX + 1):\n            fixed_min = max(FIXED_LEN_MIN, total_len - TAIL_LEN_MAX)\n            fixed_max = min(FIXED_LEN_MAX, total_len - 1)\n            for fixed_len in range(fixed_min, fixed_max + 1):\n                tail_len = total_len - fixed_len\n                key = (total_len, fixed_len, tail_len, orient)\n                for r in range(n):\n                    for c in range(n):\n                        for fixed_sign in FIXED_SIGNS:\n                            rec = _record(n, orient, fixed_len, tail_len, (r, c), fixed_sign)\n                            if rec is not None:\n                                records.append((key, rec))\n    _RECORD_CACHE[n] = records\n    return records\n\n\n","exit_code":0,"status":"completed"}}
