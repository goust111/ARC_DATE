{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/2faf500b.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg, in_bounds\nimport random\n\n\ndef _role_colors(g: np.ndarray, bg: int) -> tuple[int, int]:\n    fg = colors_present(g, exclude={bg})\n    assert len(fg) == 2, \"expected exactly two foreground colors\"\n\n    counts = {color: int(np.count_nonzero(g == color)) for color in fg}\n    marker_count = min(counts.values())\n    body_count = max(counts.values())\n    markers = [color for color, count in counts.items() if count == marker_count]\n    bodies = [color for color, count in counts.items() if count == body_count]\n    assert marker_count < body_count, \"fracture marker color must be the minority foreground color\"\n    assert len(markers) == 1 and len(bodies) == 1, \"foreground roles must be unique\"\n    return markers[0], bodies[0]\n\n\ndef _set_body(out: np.ndarray, r: int, c: int, color: int) -> None:\n    assert in_bounds(out.shape, r, c), \"shifted object pixel must stay in bounds\"\n    assert int(out[r, c]) != int(color), \"shifted object pixels must not collide\"\n    out[r, c] = int(color)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Remove each fracture marker line and push the surrounding object pixels one cell away from it.\n\n    Input structure\n    - A background grid with 8-connected foreground objects made from a body color and a rarer marker color.\n    - Each object has a non-square bbox; the marker pixels form one complete fracture line across the shorter bbox axis.\n\n    Rule\n    - Erase all marker pixels.\n    - For a wide object, each row has one marker; body pixels left of it shift one cell left and body pixels right of it shift one cell right.\n    - For a tall object, each column has one marker; body pixels above it shift one cell up and body pixels below it shift one cell down.\n\n    Key insight\n    - The marker line is a crack through the object, so the two sides separate by one pixel perpendicular to the crack.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    marker, body = _role_colors(g, bg)\n    out = np.full_like(g, bg)\n\n    objects = find_components(\n        g,\n        bg=bg,\n        connectivity=8,\n        monochromatic=False,\n        colors=[marker, body],\n    )\n    assert objects, \"expected at least one fractured object\"\n\n    for obj in objects:\n        coords = obj[\"coords\"]\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        width = int(c1 - c0 + 1)\n        assert height != width, \"fractured object bbox must determine an orientation\"\n\n        vals = g[coords[:, 0], coords[:, 1]]\n        assert bool(np.any(vals == marker)), \"each object must contain marker pixels\"\n        assert bool(np.any(vals == body)), \"each object must contain body pixels\"\n\n        marker_coords = coords[vals == marker]\n        if width > height:\n            marker_by_row: dict[int, list[int]] = {}\n            for r, c in marker_coords:\n                marker_by_row.setdefault(int(r), []).append(int(c))\n            assert set(marker_by_row) == set(range(r0, r1 + 1)), \"wide object needs one marker in each row\"\n            assert all(len(cols) == 1 for cols in marker_by_row.values()), \"wide object marker row must be unique\"\n\n            for r, c in coords[vals == body]:\n                rr = int(r)\n                cc = int(c)\n                marker_c = marker_by_row[rr][0]\n                assert cc != marker_c, \"body pixel cannot occupy the marker column\"\n                shifted_c = cc - 1 if cc < marker_c else cc + 1\n                _set_body(out, rr, shifted_c, body)\n        else:\n            marker_by_col: dict[int, list[int]] = {}\n            for r, c in marker_coords:\n                marker_by_col.setdefault(int(c), []).append(int(r))\n            assert set(marker_by_col) == set(range(c0, c1 + 1)), \"tall object needs one marker in each column\"\n            assert all(len(rows) == 1 for rows in marker_by_col.values()), \"tall object marker column must be unique\"\n\n            for r, c in coords[vals == body]:\n                rr = int(r)\n                cc = int(c)\n                marker_r = marker_by_col[cc][0]\n                assert rr != marker_r, \"body pixel cannot occupy the marker row\"\n                shifted_r = rr - 1 if rr < marker_r else rr + 1\n                _set_body(out, shifted_r, cc, body)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, palette, and retry budget.\nBACKGROUND_COLOR = 0\nFOREGROUND_COLORS = tuple(range(1, 10))\nMAX_GRID_SIZE = 19\nMIN_GRID_SIZE_BY_COUNT = (8, 8, 10, 12, 14, 16, 18, 19)\nGENERATION_RETRIES = 300\n\n# Object counts, dimensions, and orientations.\nMIN_OBJECT_COUNT = 1\nMAX_OBJECT_COUNT = 7\nSHORT_SIDE_SIZES = (2, 3, 4, 5, 6)\nLONG_SIDE_FACTOR = 2\nWIDE = \"wide\"\nTALL = \"tall\"\nORIENTATIONS = [WIDE, TALL]\n\n# Dense layouts try smaller rectangles first while preserving random tie order.\nDENSE_COUNT_THRESHOLD = 6\nDENSE_PREFERRED_MAX_SHORT_SIDE = 3\nPACKED_COUNT_THRESHOLD = 4\nPACKED_PREFERRED_MAX_SHORT_SIDE = 4\n\n# Placement and retry constraints.\nSHIFT_PADDING = 1\nMIN_CHEB_GAP = 2\n\nBBox = tuple[int, int, int, int]\nLocation = tuple[int, int]\nObjectSpec = tuple[int, int, int, str]\n\n\ndef _interval_sep(a0: int, a1: int, b0: int, b1: int) -> int:\n    if a1 < b0:\n        return b0 - a1\n    if b1 < a0:\n        return a0 - b1\n    return 0\n\n\ndef _cheb_gap_at_least_2(a: BBox, b: BBox) -> bool:\n    dr = _interval_sep(a[0], a[2], b[0], b[2])\n    dc = _interval_sep(a[1], a[3], b[1], b[3])\n    return max(dr, dc) >= MIN_CHEB_GAP\n\n\ndef _overlap(a: BBox, b: BBox) -> bool:\n    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])\n\n\ndef _expanded_bbox(r: int, c: int, h: int, w: int) -> BBox:\n    if w > h:\n        return r, c - SHIFT_PADDING, r + h - 1, c + w - 1 + SHIFT_PADDING\n    return r - SHIFT_PADDING, c, r + h - 1 + SHIFT_PADDING, c + w - 1\n\n\ndef _object_dims(short_side: int, orient: str) -> tuple[int, int]:\n    if orient == WIDE:\n        return short_side, LONG_SIDE_FACTOR * short_side\n    return LONG_SIDE_FACTOR * short_side, short_side\n\n\ndef _locations(n: int, h: int, w: int, originals: list[BBox], expanded: list[BBox]) -> list[Location]:\n    if w > h:\n        row_range = range(0, n - h + 1)\n        col_range = range(SHIFT_PADDING, n - w - SHIFT_PADDING + 1)\n    else:\n        row_range = range(SHIFT_PADDING, n - h - SHIFT_PADDING + 1)\n        col_range = range(0, n - w + 1)\n\n    locs: list[Location] = []\n    for r in row_range:\n        for c in col_range:\n            orig = (r, c, r + h - 1, c + w - 1)\n            exp = _expanded_bbox(r, c, h, w)\n            if any(not _cheb_gap_at_least_2(orig, old) for old in originals):\n                continue\n            if any(_overlap(exp, old) for old in expanded):\n                continue\n            locs.append((r, c))\n    random.shuffle(locs)\n    return locs\n\n\ndef _draw_object(grid: np.ndarray, expected: np.ndarray, r: int, c: int, s: int, orient: str, body: int, marker: int) -> None:\n    h, w = _object_dims(s, orient)\n    grid[r : r + h, c : c + w] = body\n    bits = [0, 1] + [random.randrange(2) for _ in range(s - 2)]\n    random.shuffle(bits)\n\n    if orient == WIDE:\n        rows = r + np.arange(s)\n        marker_cols = c + s - 1 + np.asarray(bits)\n        grid[rows, marker_cols] = marker\n        for row, marker_c in zip(rows, marker_cols):\n            expected[row, c - SHIFT_PADDING : marker_c - SHIFT_PADDING] = body\n            expected[row, marker_c + SHIFT_PADDING + 1 : c + w + SHIFT_PADDING] = body\n    else:\n        cols = c + np.arange(s)\n        marker_rows = r + s - 1 + np.asarray(bits)\n        grid[marker_rows, cols] = marker\n        for col, marker_r in zip(cols, marker_rows):\n            expected[r - SHIFT_PADDING : marker_r - SHIFT_PADDING, col] = body\n            expected[marker_r + SHIFT_PADDING + 1 : r + h + SHIFT_PADDING, col] = body\n\n\ndef _size_order(count: int) -> list[int]:\n    sizes = list(SHORT_SIDE_SIZES)\n    random.shuffle(sizes)\n    if count >= DENSE_COUNT_THRESHOLD:\n        return sorted(sizes, key=lambda s: (s > DENSE_PREFERRED_MAX_SHORT_SIDE, random.random()))\n    if count >= PACKED_COUNT_THRESHOLD:\n        return sorted(sizes, key=lambda s: (s > PACKED_PREFERRED_MAX_SHORT_SIDE, random.random()))\n    return sizes\n\n\ndef _place_objects(n: int, count: int) -> list[ObjectSpec] | None:\n    \"\"\"Pick non-overlapping object specs; return None if this attempt cannot fit them.\"\"\"\n    originals: list[BBox] = []\n    expanded: list[BBox] = []\n    placed: list[ObjectSpec] = []\n\n    for _ in range(count):\n        choices: list[tuple[int, str, list[Location]]] = []\n        for s in _size_order(count):\n            for orient in random.sample(ORIENTATIONS, 2):\n                h, w = _object_dims(s, orient)\n                locs = _locations(n, h, w, originals, expanded)\n                if locs:\n                    choices.append((s, orient, locs))\n        if not choices:\n            return None\n\n        s, orient, locs = random.choice(choices)\n        r, c = random.choice(locs)\n        h, w = _object_dims(s, orient)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/5ecac7f7.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste\nimport random\n\n\ndef _ordered_objects(panel: np.ndarray, bg: int) -> list[dict]:\n    objects = find_components(panel, bg=bg, connectivity=4, monochromatic=True)\n    assert len(objects) == 3, \"each panel must contain exactly three monochrome objects\"\n\n    objects = sorted(objects, key=lambda obj: obj[\"bbox\"][1])\n    previous_right = -1\n    for obj in objects:\n        _r0, c0, _r1, c1 = obj[\"bbox\"]\n        assert c0 > previous_right, \"panel objects must be strictly ordered left to right\"\n        previous_right = c1\n    return objects\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Combine the left, middle, and right ordered objects from three separated panels.\n\n    Input structure\n    - The grid is three HxH panels separated by one-cell vertical separator bars.\n    - The background is the dominant color, and each panel contains exactly three same-color 4-connected foreground objects.\n\n    Rule\n    - Build a new HxH background canvas.\n    - From the left panel copy its leftmost object, from the middle panel copy its middle object, and from the right panel copy its rightmost object.\n\n    Key insight\n    - The separator bars create three aligned layers, and the panel's own left-to-right object order selects which object survives in the merged output.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    H, W = g.shape\n    assert W == 3 * H + 2, \"expected three square panels separated by two columns\"\n\n    bg = get_bg(g)\n    sep_a = int(g[0, H])\n    sep_b = int(g[0, 2 * H + 1])\n    assert sep_a == sep_b and sep_a != bg, \"separator bars must use the same non-bg color\"\n    assert bool(np.all(g[:, H] == sep_a)), \"first separator column must be solid\"\n    assert bool(np.all(g[:, 2 * H + 1] == sep_a)), \"second separator column must be solid\"\n\n    panels = [\n        g[:, :H],\n        g[:, H + 1 : 2 * H + 1],\n        g[:, 2 * H + 2 :],\n    ]\n    assert all(panel.shape == (H, H) for panel in panels), \"panels must be HxH\"\n\n    out = np.full((H, H), bg, dtype=int)\n    for panel_index, panel in enumerate(panels):\n        obj = _ordered_objects(panel, bg)[panel_index]\n        color = int(obj[\"color\"])\n        for r, c in obj[\"coords\"]:\n            rr, cc = int(r), int(c)\n            assert out[rr, cc] == bg, \"selected objects must not overlap\"\n            out[rr, cc] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette values observed in the task.\n_BG = 7\n_SEP = 6\n_COLORS = [0, 1, 2, 3, 4, 5, 8, 9]\n\n# Panel geometry and object ordering.\n_GRID_SIZES = [5, 6]\n_N_PANELS = 3\n_OBJECTS_PER_PANEL = 3\n_DISTRACTOR_KEYS = [(0, 1), (0, 2), (1, 0), (1, 2), (2, 0), (2, 1)]\n\n# Object-size, density, and color-reuse controls.\n_MAX_OBJECT_AREA = 8\n_AREA_BUDGET_BY_SIZE = {5: 56, 6: 72}\n_MAX_COLOR_REUSES = 2\n\n# Random-growth shape controls.\n_FRONTIER_COMPACT_BIAS = 0.35\n_FRONTIER_COMPACT_TOP_K = 3\n_NEIGHBOR_DELTAS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n# Retry limit for rejecting failed growth or oracle mismatches.\n_MAX_ATTEMPTS = 300\n\n\ndef _segments(H: int) -> list[tuple[int, int]]:\n    a, b = sorted(random.sample(range(1, H), 2))\n    return [(0, a - 1), (a, b - 1), (b, H - 1)]\n\n\ndef _object_patch(H: int, cols: tuple[int, int], color: int, area: int) -> np.ndarray | None:\n    c0, c1 = cols\n    W = c1 - c0 + 1\n    target = int(area)\n    if target < 1 or target > H * W:\n        return None\n\n    start = (random.randrange(H), random.randrange(W))\n    cells = {start}\n    frontier: set[tuple[int, int]] = set()\n\n    def add_frontier(r: int, c: int) -> None:\n        for dr, dc in _NEIGHBOR_DELTAS:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in cells:\n                frontier.add((rr, cc))\n\n    add_frontier(*start)\n    while len(cells) < target:\n        if not frontier:\n            return None\n        if random.random() < _FRONTIER_COMPACT_BIAS:\n            options = sorted(\n                frontier,\n                key=lambda rc: sum(\n                    (rc[0] + dr, rc[1] + dc) in cells for dr, dc in _NEIGHBOR_DELTAS\n                ),\n                reverse=True,\n            )\n            top_k = max(1, min(_FRONTIER_COMPACT_TOP_K, len(options)))\n            cell = random.choice(options[:top_k])\n        else:\n            cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        cells.add(cell)\n        add_frontier(*cell)\n\n    patch = np.full((H, H), _BG, dtype=int)\n    for r, c in cells:\n        patch[r, c0 + c] = int(color)\n    return patch\n\n\ndef _choose_area(H: int, cols: tuple[int, int], budget: int, remaining_slots: int) -> int | None:\n    width = cols[1] - cols[0] + 1\n    high = min(_MAX_OBJECT_AREA, H * width, budget - (remaining_slots - 1))\n    if high < 1:\n        return None\n    return random.randint(1, high)\n\n\ndef _assign_colors(selected: list[int]) -> dict[tuple[int, int], int] | None:\n    colors = {(i, i): int(selected[i]) for i in range(_OBJECTS_PER_PANEL)}\n    used_by_panel = [set() for _ in range(_N_PANELS)]\n    counts = {c: 0 for c in _COLORS}\n    for i, color in enumerate(selected):\n        used_by_panel[i].add(int(color))\n        counts[int(color)] += 1\n\n    distractors = list(_DISTRACTOR_KEYS)\n    random.shuffle(distractors)\n    for panel_i, obj_i in distractors:\n        options = [\n            color\n            for color in _COLORS\n            if counts[color] < _MAX_COLOR_REUSES and color not in used_by_panel[panel_i]\n        ]\n        if not options:\n            return None\n        color = random.choice(options)\n        colors[(panel_i, obj_i)] = color\n        used_by_panel[panel_i].add(color)\n        counts[color] += 1\n    return colors\n\n\ndef _sample_patch(H: int, segs: list[tuple[int, int]], obj_i: int, color: int, budget: int, remaining: int):\n    area = _choose_area(H, segs[obj_i], budget, remaining)\n    if area is None:\n        return None\n    patch = _object_patch(H, segs[obj_i], color, area)\n    if patch is None:\n        return None\n    return patch, budget - area, remaining - 1\n\n\ndef _sample_objects(H: int, segs: list[tuple[int, int]], selected_colors: list[int], colors):\n    \"\"\"Return all panel objects plus the expected merged output.\"\"\"\n    budget = _AREA_BUDGET_BY_SIZE[H]\n    remaining = _N_PANELS * _OBJECTS_PER_PANEL\n    objects: dict[tuple[int, int], np.ndarray] = {}\n    out = np.full((H, H), _BG, dtype=int)\n\n    for i in range(_OBJECTS_PER_PANEL):\n        sampled = _sample_patch(H, segs, i, selected_colors[i], budget, remaining)\n        if sampled is None:\n            return None\n        patch, budget, remaining = sampled\n        objects[(i, i)] = patch\n        paste(out, patch, 0, 0, transparent=_BG)\n\n    for panel_i, obj_i in _DISTRACTOR_KEYS:\n        sampled = _sample_patch(H, segs, obj_i, colors[(panel_i, obj_i)], budget, remaining)\n        if sampled is None:\n            return None\n        patch, budget, remaining = sampled\n        objects[(panel_i, obj_i)] = patch\n    return objects, out\n\n\ndef _render_input(H: int, objects: dict[tuple[int, int], np.ndarray]) -> np.ndarray:\n    \"\"\"Render all objects into three panels separated by solid bars.\"\"\"\n    inp = np.full((H, _N_PANELS * H + (_N_PANELS - 1)), _BG, dtype=int)\n    for sep_i in range(1, _N_PANELS):\n        inp[:, sep_i * H + (sep_i - 1)] = _SEP\n    for panel_i in range(_N_PANELS):\n        panel = np.full((H, H), _BG, dtype=int)\n        for obj_i in range(_OBJECTS_PER_PANEL):\n            paste(panel, objects[(panel_i, obj_i)], 0, 0, transparent=_BG)\n        paste(inp, panel, 0, panel_i * (H + 1))\n    return inp\n\n\ndef _passes_oracle(inp: np.ndarray, expected: np.ndarray) -> bool:\n    try:\n        actual = main(inp)\n    except AssertionError:\n        return False\n    return bool(np.array_equal(actual, expected))\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.choice(_GRID_SIZES)\n    segs = _segments(H)\n    selected_colors = random.sample(_COLORS, _OBJECTS_PER_PANEL)\n    colors = _assign_colors(selected_colors)\n    if colors is None:\n        return None\n\n    sampled = _sample_objects(H, segs, selected_colors, colors)\n    if sampled is None:\n        return None\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/ac0c2ac3.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Fill each centered square ring with the color of the marker at that ring distance.\n\n    Input structure\n    The input is an odd square grid with a dominant background color and one\n    non-background marker for every Chebyshev distance from the grid center.\n    Rule\n    The output replaces the background with concentric square rings centered on\n    the middle cell; every cell at distance d from the center takes the color of\n    the unique marker whose distance from the center is d.\n    Key insight\n    The scattered markers are not objects to move; their Chebyshev distances\n    form a palette for the centered square rings.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    assert h == w and h % 2 == 1\n\n    bg = get_bg(g)\n    _, counts = np.unique(g, return_counts=True)\n    max_count = int(counts.max())\n    assert int(np.count_nonzero(counts == max_count)) == 1\n    assert int(np.count_nonzero(g == bg)) == max_count\n\n    center_r = h // 2\n    center_c = w // 2\n    radius = h // 2\n    markers = np.argwhere(g != bg)\n    assert len(markers) == radius + 1\n\n    ring_colors: dict[int, int] = {}\n    for r, c in markers:\n        dist = max(abs(int(r) - center_r), abs(int(c) - center_c))\n        assert dist not in ring_colors\n        ring_colors[dist] = int(g[r, c])\n    assert set(ring_colors) == set(range(radius + 1))\n\n    rr = np.arange(h)[:, None]\n    cc = np.arange(w)[None, :]\n    distances = np.maximum(np.abs(rr - center_r), np.abs(cc - center_c))\n    out = np.empty_like(g)\n    for dist in range(radius + 1):\n        out[distances == dist] = ring_colors[dist]\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas sizes are odd squares; radius is derived as side // 2.\nGEN_GRID_SIZES = (7, 9, 11, 13)\n# ARC colors: one background plus distinct marker/ring colors.\nGEN_COLORS = tuple(range(10))\n# Retry budget for the solver-oracle guard.\nGEN_MAX_ATTEMPTS = 300\n\ndef _gen_ring_coords(n: int, dist: int) -> np.ndarray:\n    center = n // 2\n    rr = np.arange(n)[:, None]\n    cc = np.arange(n)[None, :]\n    mask = np.maximum(np.abs(rr - center), np.abs(cc - center)) == dist\n    return np.argwhere(mask)\n\n\ndef _gen_grids(\n    n: int, bg: int, ring_colors: list[int], rng: np.random.Generator\n) -> tuple[np.ndarray, np.ndarray]:\n    coords_by_dist = [_gen_ring_coords(n, dist) for dist in range(n // 2 + 1)]\n    out = np.empty((n, n), dtype=int)\n    inp = np.full((n, n), bg, dtype=int)\n    for color, coords in zip(ring_colors, coords_by_dist):\n        out[coords[:, 0], coords[:, 1]] = color\n        marker_idx = int(rng.integers(0, len(coords)))\n        r, c = coords[marker_idx]\n        inp[int(r), int(c)] = color\n    return inp, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n    n = int(rng.choice(GEN_GRID_SIZES))\n    radius = n // 2\n    bg = int(rng.integers(0, len(GEN_COLORS)))\n    palette = [color for color in GEN_COLORS if color != bg]\n    rng.shuffle(palette)\n    ring_colors = palette[: radius + 1]\n    inp, out = _gen_grids(n, bg, ring_colors, rng)\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid ac0c2ac3 input\")\n","exit_code":0,"status":"completed"}}
