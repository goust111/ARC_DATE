    source_color: int,
    target_color: int,
    rng: np.random.Generator,
) -> dict | None:
    gate_gap = int(rng.choice([0, 2, 4] if is_open else [1, 3]))
    post_gap = int(rng.integers(0, 3))

    if direction in ("R", "L"):
        band_h = int(rng.integers(3, 6))
        source_w = int(rng.integers(3, 7))
        target_w = int(rng.integers(3, 7))
        if band_h > h:
            return None
        r0 = int(rng.integers(0, h - band_h + 1))
        anchor_r = int(rng.integers(r0 + 1, r0 + band_h - 1))
        if direction == "R":
            max_c0 = w - (source_w + target_w + gate_gap + post_gap + 4)
            if max_c0 < 0:
                return None
            c0 = int(rng.integers(0, max_c0 + 1))
            tail = (anchor_r, c0 + source_w)
            tip = (anchor_r, c0 + source_w + 2)
            gate = (anchor_r, c0 + source_w + 3 + gate_gap)
            target_left = gate[1] + 1 + post_gap
            target_entry = (anchor_r, target_left)
            target_cols = range(target_left, target_left + target_w)
        else:
            min_c0 = target_w + gate_gap + post_gap + 4
            max_c0 = w - source_w
            if min_c0 > max_c0:
                return None
            c0 = int(rng.integers(min_c0, max_c0 + 1))
            tail = (anchor_r, c0 - 1)
            tip = (anchor_r, c0 - 3)
            gate = (anchor_r, c0 - 4 - gate_gap)
            target_right = gate[1] - 1 - post_gap
            target_left = target_right - target_w + 1
            target_entry = (anchor_r, target_right)
            target_cols = range(target_left, target_right + 1)

        source_cells = {(r, c) for r in range(r0, r0 + band_h) for c in range(c0, c0 + source_w)}
        target_cells = {(r, c) for r in range(r0, r0 + band_h) for c in target_cols}
    else:
        band_w = int(rng.integers(3, 6))
        source_h = int(rng.integers(3, 7))
        target_h = int(rng.integers(3, 7))
        if band_w > w:
            return None
        c0 = int(rng.integers(0, w - band_w + 1))
        anchor_c = int(rng.integers(c0 + 1, c0 + band_w - 1))
        if direction == "D":
            max_r0 = h - (source_h + target_h + gate_gap + post_gap + 4)
            if max_r0 < 0:
                return None
            r0 = int(rng.integers(0, max_r0 + 1))
            tail = (r0 + source_h, anchor_c)
            tip = (r0 + source_h + 2, anchor_c)
            gate = (r0 + source_h + 3 + gate_gap, anchor_c)
            target_top = gate[0] + 1 + post_gap
            target_entry = (target_top, anchor_c)
            target_rows = range(target_top, target_top + target_h)
        else:
            min_r0 = target_h + gate_gap + post_gap + 4
            max_r0 = h - source_h
            if min_r0 > max_r0:
                return None
            r0 = int(rng.integers(min_r0, max_r0 + 1))
            tail = (r0 - 1, anchor_c)
            tip = (r0 - 3, anchor_c)
            gate = (r0 - 4 - gate_gap, anchor_c)
            target_bottom = gate[0] - 1 - post_gap
            target_top = target_bottom - target_h + 1
            target_entry = (target_bottom, anchor_c)
            target_rows = range(target_top, target_bottom + 1)

        source_cells = {(r, c) for r in range(r0, r0 + source_h) for c in range(c0, c0 + band_w)}
        target_cells = {(r, c) for r in target_rows for c in range(c0, c0 + band_w)}

    arrow_cells = {(tail[0] + dr, tail[1] + dc) for dr, dc in _arrow_offsets(direction)}
    path_cells = set(_module_paths(tip, gate, target_entry, direction))
    actual = set(source_cells) | set(target_cells) | set(arrow_cells) | {gate}
    all_cells = actual | path_cells

    for r, c in all_cells:
        if not (0 <= r < h and 0 <= c < w):
            return None
    if len(actual) != len(source_cells) + len(target_cells) + len(arrow_cells) + 1:
        return None
    if source_cells & target_cells:
        return None
    if actual & path_cells:
        return None

    target_rows_list = [r for r, _ in target_cells]
    target_cols_list = [c for _, c in target_cells]
    return {
        "open": is_open,
        "source_color": source_color,
        "target_color": target_color,
        "source_cells": source_cells,
        "target_cells": target_cells,
        "arrow_cells": arrow_cells,
        "gate": gate,
        "reserve": _reserve_cells(all_cells, h, w),
        "target_bbox": (
            min(target_rows_list),
            min(target_cols_list),
            max(target_rows_list),
            max(target_cols_list),
        ),
    }


def _expected_output(grid: np.ndarray, modules: list[dict]) -> np.ndarray:
    out = grid.copy()
    for module in modules:
        if not module["open"]:
            continue
        r0, c0, r1, c1 = module["target_bbox"]
        out[r0 : r1 + 1, c0 : c1 + 1] = module["source_color"]
    return out


def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
    h = int(rng.integers(18, 31))
    w = int(rng.integers(18, 31))
    n_pairs = 2 if rng.random() < 0.5 else 3
    states = _sample_states(n_pairs, rng)
    directions = list(rng.choice(np.array(["R", "L", "U", "D"]), size=n_pairs, replace=True))
    colors = [int(v) for v in rng.choice(np.array(RECT_COLORS), size=2 * n_pairs, replace=False)]

    reserved = np.zeros((h, w), dtype=bool)
    modules: list[dict] = []
    for i in range(n_pairs):
        source_color = colors[2 * i]
        target_color = colors[2 * i + 1]
        placed = False
        for _ in range(PLACE_ATTEMPTS):
            module = _sample_module(h, w, directions[i], states[i], source_color, target_color, rng)
            if module is None:
                continue
            if any(reserved[r, c] for r, c in module["reserve"]):
                continue
            for r, c in module["reserve"]:
                reserved[r, c] = True
            modules.append(module)
            placed = True
            break
        if not placed:
            return None

    grid = np.full((h, w), BLACK, dtype=int)
    for module in modules:
        for r, c in module["source_cells"]:
            grid[r, c] = module["source_color"]
        for r, c in module["target_cells"]:
            grid[r, c] = module["target_color"]
        for r, c in module["arrow_cells"]:
            grid[r, c] = GREY
        gr, gc = module["gate"]
        grid[gr, gc] = AZURE

    if not np.array_equal(main(grid), _expected_output(grid, modules)):
        return None
    return grid


def generate_input() -> np.ndarray:
    rng = np.random.default_rng()
    for _ in range(GEN_ATTEMPTS):
        grid = _gen_attempt(rng)
        if grid is not None:
            return grid
    raise RuntimeError(f"generate_input failed after {GEN_ATTEMPTS} attempts")
