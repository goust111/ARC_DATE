    r1 = min(h - 1, max(rows) + 1)
    c0 = max(0, min(cols) - 1)
    c1 = min(w - 1, max(cols) + 1)
    return {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}


def _sample_module(
    h: int,
