def main(grid: np.ndarray) -> np.ndarray:
    """
    Propagate a source rectangle'"'s color through an arrow only when the gate distance has even parity.

    Input structure:
    - The background is black.
    - Several large solid rectangles of distinct colors appear on the grid.
