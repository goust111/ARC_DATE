+from __future__ import annotations
+
+from dataclasses import dataclass, field
+
+import numpy as np
+
+
+@dataclass
+class _Frame:
+    color: int
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+    parent: int | None = None
+    depth: int = 0
+
+    @property
+    def height(self) -> int:
+        return self.r1 - self.r0 + 1
+
+    @property
+    def width(self) -> int:
+        return self.c1 - self.c0 + 1
+
+    @property
+    def area(self) -> int:
+        return self.height * self.width
+
+
+@dataclass
+class _Node:
+    depth: int
+    children: list["_Node"] = field(default_factory=list)
+    outer_h: int = 0
+    outer_w: int = 0
+    bbox: tuple[int, int, int, int] | None = None
+    layout: str = "leaf"
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    values = np.asarray(grid, dtype=int).ravel()
+    return int(np.bincount(values).argmax())
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _frame_from_component(coords: np.ndarray, color: int) -> _Frame | None:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    r0, r1 = int(rows.min()), int(rows.max())
+    c0, c1 = int(cols.min()), int(cols.max())
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+    if coords.shape[0] != 2 * (h + w) - 4:
+        return None
+
+    patch = np.zeros((h, w), dtype=bool)
+    patch[rows - r0, cols - c0] = True
+    border = np.zeros_like(patch)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    if not np.array_equal(patch, border):
+        return None
+    return _Frame(color=color, r0=r0, c0=c0, r1=r1, c1=c1)
+
+
+def _contains(outer: _Frame, inner: _Frame) -> bool:
+    return (
+        outer.r0 < inner.r0
+        and outer.c0 < inner.c0
+        and outer.r1 > inner.r1
+        and outer.c1 > inner.c1
+    )
+
+
+def _annotate_depths(frames: list[_Frame]) -> None:
+    for i, frame in enumerate(frames):
+        parents = [j for j, other in enumerate(frames) if i != j and _contains(other, frame)]
+        if parents:
+            frame.parent = min(parents, key=lambda j: frames[j].area)
+
+    def depth_of(idx: int) -> int:
