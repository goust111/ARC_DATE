+def _split_extra(rng: np.random.Generator, total: int, slots: int) -> list[int]:
+    if slots == 1:
+        return [total]
+    if total == 0:
+        return [0] * slots
+    probs = np.full(slots, 1.0 / slots)
+    return rng.multinomial(total, probs).tolist()
+
