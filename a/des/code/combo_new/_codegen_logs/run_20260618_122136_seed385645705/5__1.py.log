+    if side == "top":
+        return r, c + rng.randint(1, w - 2)
+    if side == "bottom":
+        return r + h - 1, c + rng.randint(1, w - 2)
+    if side == "left":
+        return r + rng.randint(1, h - 2), c
+    if side == "right":
+        return r + rng.randint(1, h - 2), c + w - 1
