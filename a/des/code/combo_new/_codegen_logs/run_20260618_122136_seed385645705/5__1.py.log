+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _palette_colors(grid: np.ndarray, bg: int, frame_color: int) -> list[int]:
+    coords = np.argwhere((grid != bg) & (grid != frame_color))
