+def _collapse_pair(a: np.ndarray, b: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    ra0, ca0, ra1, ca1 = _bbox(a)
+    rb0, cb0, rb1, cb1 = _bbox(b)
+    row_overlap = max(ra0, rb0) <= min(ra1, rb1)
+    col_overlap = max(ca0, cb0) <= min(ca1, cb1)
