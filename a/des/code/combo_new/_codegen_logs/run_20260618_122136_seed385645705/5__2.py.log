+def _normalize(coords: np.ndarray) -> np.ndarray:
+    arr = np.asarray(coords, dtype=int).copy()
+    arr[:, 0] -= int(arr[:, 0].min())
+    arr[:, 1] -= int(arr[:, 1].min())
+    order = np.lexsort((arr[:, 1], arr[:, 0]))
+    return arr[order]
