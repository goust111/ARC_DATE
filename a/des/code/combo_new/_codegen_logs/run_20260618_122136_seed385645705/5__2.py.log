+            top_min = shift
+            top_max = height - touch - shp_h - shift
+            if top_min > top_max or shp_w > width:
+                continue
+            r0 = int(rng.integers(top_min, top_max + 1))
+            c0 = int(rng.integers(0, width - shp_w + 1))
+
