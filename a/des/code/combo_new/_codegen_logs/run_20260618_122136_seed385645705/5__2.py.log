+def _expand(cells: set[tuple[int, int]], height: int, width: int) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                rr = int(r + dr)
+                cc = int(c + dc)
+                if 0 <= rr < height and 0 <= cc < width:
