+    arr[:, 1] -= int(arr[:, 1].min())
+    order = np.lexsort((arr[:, 1], arr[:, 0]))
+    return arr[order]
+
+
+def _transform_shape(coords: np.ndarray, rotations: int, flip: bool) -> np.ndarray:
