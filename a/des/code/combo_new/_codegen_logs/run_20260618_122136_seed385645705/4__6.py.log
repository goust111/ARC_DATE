+            "frame": frame,
+            "arrow": arrow,
+            "tip": tip,
+            "step": step,
+            "path": path,
+            "target": target,
+            "footprint": footprint,
+            "occupied": occupied,
+        }
+    return None
+
+
+def _shape_range(n_regions: int) -> tuple[tuple[int, int], tuple[int, int]]:
+    if n_regions == 2:
+        return (18, 24), (18, 24)
+    if n_regions == 3:
+        return (22, 28), (22, 28)
+    return (26, 30), (26, 30)
+
+
+def _expected_output(grid: np.ndarray, regions: list[dict[str, object]]) -> np.ndarray:
+    out = grid.copy()
+    for region in regions:
