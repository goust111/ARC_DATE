+        out[r0 + 1 : r1, c0 + 1 : c1] = color
+        for r, c in region["arrow"]:
+            out[r, c] = BLACK
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    n_regions = random.randint(2, 4)
+    h_range, w_range = _shape_range(n_regions)
