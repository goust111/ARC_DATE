+            grid[r, c] = GREY
+        for r, c in region["arrow"]:
+            grid[r, c] = MAROON
+        tr, tc = region["target"]
+        grid[tr, tc] = region["color"]
+
+    expected = _expected_output(grid, regions)
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
