+    h, w = grid.shape
+    r, c = tip
+    dr, dc = step
+    while True:
+        r += dr
+        c += dc
+        if not (0 <= r < h and 0 <= c < w):
+            break
+        value = int(grid[r, c])
+        if value not in (BLACK, GREY, MAROON):
+            return value
+    raise AssertionError("ray did not hit a colored target pixel")
