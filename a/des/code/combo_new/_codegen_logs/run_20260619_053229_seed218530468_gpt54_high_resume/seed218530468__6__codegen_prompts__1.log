{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py /home/lixinyu/snap/new/ARC_code/train/db7260a4.py /home/lixinyu/snap/new/ARC_code/train/465b7d93.py /home/lixinyu/snap/new/ARC_code/train/84551f4c.py /home/lixinyu/snap/new/ARC_code/train/bae5c565.py /home/lixinyu/snap/new/ARC_code/train/e734a0e8.py; do echo \"FILE:$f\"; sed -n '\"'/def main/,/def generate_input/p' \\\"\"'$f\" | sed '\"'\"'$d'\"'; sed -n '/def generate_input/,\"'$p'\"' \\\"\"'$f\" | head -n 140; echo; done'","aggregated_output":"FILE:/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n    h, w = canvas_mask.shape\n    sr, sc = seed\n    if not canvas_mask[sr, sc]:\n        return None\n    blob = {(sr, sc)}\n    frontier = []\n    def push_neighbors(r, c):\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:\n                frontier.append((nr, nc))\n    push_neighbors(sr, sc)\n    while len(blob) < target_size and frontier:\n        idx = rng.randrange(len(frontier))\n        r, c = frontier.pop(idx)\n        if (r, c) in blob or not canvas_mask[r, c]:\n            continue\n        blob.add((r, c))\n        push_neighbors(r, c)\n    if len(blob) < target_size:\n        return None\n    return blob\n\n\ndef _blob_wall_cells(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n    wall = set()\n    for r, c in blob:\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in blob:\n                wall.add((nr, nc))\n    return wall\n\n\ndef _fill_holes(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Return blob with interior holes absorbed.\n\n    Barrier = blob union its wall ring. Any non-barrier cell unreachable from the grid\n    border through non-barrier cells is trapped and gets absorbed into the blob.\n    \"\"\"\n    walls = _blob_wall_cells(blob, h, w)\n    barrier = np.zeros((h, w), dtype=bool)\n    for r, c in blob:\n        barrier[r, c] = True\n    for r, c in walls:\n        barrier[r, c] = True\n\n    # Flood-fill from border through non-barrier cells.\n    reachable = np.zeros((h, w), dtype=bool)\n    stack = []\n    for r in range(h):\n        for c in (0, w - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    for c in range(w):\n        for r in (0, h - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    while stack:\n        r, c = stack.pop()\n        if reachable[r, c] or barrier[r, c]:\n            continue\n        reachable[r, c] = True\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and not reachable[nr, nc] and not barrier[nr, nc]:\n                stack.append((nr, nc))\n\n    trapped = (~reachable) & (~barrier)\n    if not trapped.any():\n        return blob\n    filled = set(blob)\n    for r, c in np.argwhere(trapped):\n        filled.add((int(r), int(c)))\n    return filled\n\n\n# ── Slide helpers ─────────────────────────────────────────────────\n\ndef _slide_step_valid(region_set: set, r: int, c: int, dr: int, dc: int) -> bool:\n    nr, nc = r + dr, c + dc\n    if (nr, nc) not in region_set:\n        return False\n    if dr != 0 and dc != 0:\n        if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n            return False\n    return True\n\n\ndef _forward_slide(region_set: set, start: tuple[int, int], dr: int, dc: int,\n                   blocked: set) -> tuple[int, int]:\n    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n    r, c = start\n    while True:\n        if not _slide_step_valid(region_set, r, c, dr, dc):\n            break\n        nr, nc = r + dr, c + dc\n        if (nr, nc) in blocked:\n            break\n        r, c = nr, nc\n    return (r, c)\n\n\n# ── Generator phases ─────────────────────────────────────────────\n\ndef _place_legends(rng: random.Random, grid: np.ndarray,\n                   ) -> tuple[np.ndarray, list[tuple[int, tuple[int,int]]]]:\n    \"\"\"Place 1-2 legend patches at grid corners.\n\n    Returns (legend_occupied mask, list of (wall_color, direction) pairs).\n    \"\"\"\n    h, w = grid.shape\n    n_legends = rng.choice([1, 2])\n    corners = rng.sample(CORNERS, n_legends)\n    wall_colors = rng.sample(WALL_COLOR_CHOICES, n_legends)\n\n    legend_occupied = np.zeros((h, w), dtype=bool)\n    legends = []\n\n    for corner, wc in zip(corners, wall_colors):\n        if rng.random() < CARDINAL_PROB:\n            dr, dc = rng.choice(CARDINAL_DIRS)\n            patch = _legend_5x5(wc, dr, dc)\n        else:\n            dr, dc = rng.choice(DIAGONAL_DIRS)\n            patch = _legend_6x7(wc, dr, dc)\n        ph, pw = patch.shape\n        r0, c0 = _corner_origin(corner, h, w, ph, pw)\n        paste(grid, patch, r0, c0)\n        # Reserve legend cells + buffer.\n        r_lo, r_hi = max(0, r0 - LEGEND_BUFFER), min(h, r0 + ph + LEGEND_BUFFER)\n        c_lo, c_hi = max(0, c0 - LEGEND_BUFFER), min(w, c0 + pw + LEGEND_BUFFER)\n        legend_occupied[r_lo:r_hi, c_lo:c_hi] = True\n        legends.append((wc, (dr, dc)))\n\n    return legend_occupied, legends\n\n\ndef _grow_regions(rng: random.Random, legends: list[tuple[int, tuple[int,int]]],\n                  legend_occupied: np.ndarray,\n                  ) -> list[dict] | None:\n    \"\"\"Grow irregular closed regions, one per assigned wall color.\n\n    Returns list of region dicts or None on failure.\n    \"\"\"\n    h, w = legend_occupied.shape\n    color_dir = {wc: d for wc, d in legends}\n    all_colors = [wc for wc, _ in legends]\n\n    # Assign 1-3 regions per wall color, cap total.\n    region_colors = []\n    for c in all_colors:\n        region_colors.extend([c] * rng.randint(*REGIONS_PER_COLOR))\n    if len(region_colors) > MAX_TOTAL_REGIONS:\n        region_colors = rng.sample(region_colors, MAX_TOTAL_REGIONS)\n    rng.shuffle(region_colors)\n\n    size_min, size_max = REGION_SIZE_BOUNDS[len(region_colors)]\n    occupied = legend_occupied.copy()\n    regions = []\n\n    for rc in region_colors:\n        dr, dc = color_dir[rc]\n        target_size = rng.randint(size_min, size_max)\n\n        # Build canvas: interior cells (not border) that are unoccupied.\n        canvas = np.ones((h, w), dtype=bool)\n        canvas[0, :] = False; canvas[-1, :] = False\n        canvas[:, 0] = False; canvas[:, -1] = False\n        canvas &= ~occupied\n        if not canvas.any():\n            continue\n\n        blob = _try_grow_valid_blob(rng, canvas, occupied, target_size, h, w)\n        if blob is None:\n            continue\n\n        walls = _blob_wall_cells(blob, h, w)\n        regions.append({'color': rc, 'dir': (dr, dc), 'interior': blob, 'walls': walls})\n\n        # Reserve blob + walls + 1-cell buffer around walls.\n        reserve = blob | walls\n        extra = set()\n        for r, c in walls:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in reserve:\n                    extra.add((nr, nc))\n        for r, c in reserve | extra:\n            occupied[r, c] = True\n\n    if not regions:\n        return None\n    # Every legend color must have at least one region.\n    if {reg['color'] for reg in regions} != set(all_colors):\n        return None\n    return regions\n\n\ndef _try_grow_valid_blob(rng: random.Random, canvas: np.ndarray,\n                         occupied: np.ndarray, target_size: int,\n                         h: int, w: int) -> set[tuple[int,int]] | None:\n    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n    for _ in range(BLOB_GROW_RETRIES):\n        free = np.argwhere(canvas)\n        if len(free) == 0:\n            break\n        sr, sc = free[rng.randrange(len(free))]\n        cand = _grow_blob(canvas, (int(sr), int(sc)), target_size, rng)\n        if cand is None:\n            continue\n        # Fill interior holes until stable.\n        while True:\n            filled = _fill_holes(cand, h, w)\n            if filled == cand:\n                break\n            cand = filled\n        # Absorbed cells must stay within canvas.\n        if any(not canvas[r, c] for r, c in cand):\n            continue\n        walls = _blob_wall_cells(cand, h, w)\n        # Walls must not overlap occupied cells or the grid border.\n        if any(occupied[wr, wc] or wr in (0, h - 1) or wc in (0, w - 1)\n               for wr, wc in walls):\n            continue\n        return cand\n    return None\n\n\ndef _validate_topology(grid: np.ndarray, regions: list[dict]) -> bool:\n    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n    h, w = grid.shape\n    labeled, n_comp = label_mask(grid == 0, connectivity=4)\n    bounded = []\n    for comp_id in range(1, n_comp + 1):\n        coords = np.argwhere(labeled == comp_id)\n        if any(r in (0, h - 1) or c in (0, w - 1) for r, c in coords):\n            continue\n        bounded.append({(int(r), int(c)) for r, c in coords})\n    region_sets = [reg['interior'] for reg in regions]\n    if len(bounded) != len(region_sets):\n        return False\n    return all(comp in region_sets for comp in bounded)\n\n\ndef _place_yellows(rng: random.Random, regions: list[dict],\n                   grid: np.ndarray) -> bool:\n    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n\n    Modifies grid in-place by painting yellow(4) at input positions.\n    Returns True on success.\n    \"\"\"\n    for reg in regions:\n        blob = reg['interior']\n        dr, dc = reg['dir']\n        n_yellows = rng.choice(YELLOWS_PER_REGION)\n\n        # Cells sorted by projection onto slide direction (farthest first).\n        cells_sorted = sorted(blob, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n        far_key = dr * cells_sorted[0][0] + dc * cells_sorted[0][1]\n        tier1 = [p for p in cells_sorted if dr * p[0] + dc * p[1] == far_key]\n\n        # Pick output positions: first at the farthest tier, second one step behind or at tier1.\n        first = tier1[rng.randrange(len(tier1))]\n        output_positions = [first]\n\n        if n_yellows == 2:\n            pr, pc = first[0] - dr, first[1] - dc\n            cands = ([(pr, pc)] if (pr, pc) in blob else []) + [p for p in tier1 if p != first]\n            if cands:\n                second = cands[rng.randrange(len(cands))]\n                if second != first:\n                    output_positions.append(second)\n\n        # Reverse-slide: process in solver order (far-to-near).\n        out_sorted = sorted(output_positions, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n        already_stopped = set()\n        yellows_input = []\n\n        for out_pos in out_sorted:\n            candidate = _find_reverse_slide(blob, out_pos, dr, dc, already_stopped,\n                                            yellows_input, rng)\n            if candidate is None:\n                return False\n            yellows_input.append(candidate)\n            already_stopped.add(out_pos)\n\n        for r, c in yellows_input:\n            grid[r, c] = 4\n    return True\n\n\ndef _find_reverse_slide(blob: set, out_pos: tuple[int,int], dr: int, dc: int,\n                        already_stopped: set, existing_inputs: list,\n                        rng: random.Random) -> tuple[int,int] | None:\n    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n    target_steps = rng.randint(1, MAX_SLIDE_STEPS)\n    for steps in range(target_steps, 0, -1):\n        r, c = out_pos\n        path_ok = True\n        for _ in range(steps):\n            pr, pc = r - dr, c - dc\n            if (pr, pc) not in blob or (pr, pc) in already_stopped or (pr, pc) in existing_inputs:\n                path_ok = False\n                break\n            if dr != 0 and dc != 0:\n                if (pr + dr, pc) not in blob or (pr, pc + dc) not in blob:\n                    path_ok = False\n                    break\n            r, c = pr, pc\n        if not path_ok:\n            continue\n        if _forward_slide(blob, (r, c), dr, dc, already_stopped) == out_pos:\n            return (r, c)\n    return None\n\n\ndef _oracle_check(input_grid: np.ndarray, regions: list[dict]) -> bool:\n    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n    h, w = input_grid.shape\n    try:\n        solver_out = main(input_grid)\n    except Exception:\n        return False\n    # Non-yellow, non-bg cells must be identical.\n    struct_mask = (input_grid != 4) & (input_grid != 0)\n    if not np.array_equal(solver_out[struct_mask], input_grid[struct_mask]):\n        return False\n    # Yellow count must be preserved.\n    if (solver_out == 4).sum() != (input_grid == 4).sum():\n        return False\n    # All output yellows must lie inside known region interiors.\n    regions_mask = np.zeros((h, w), dtype=bool)\n    for reg in regions:\n        for r, c in reg['interior']:\n            regions_mask[r, c] = True\n    return bool(np.all(regions_mask[solver_out == 4]))\n\n\n# ── Main generator ────────────────────────────────────────────────\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    h, w = GRID_H, GRID_W\n    grid = np.zeros((h, w), dtype=int)\n\n    legend_occupied, legends = _place_legends(rng, grid)\n    regions = _grow_regions(rng, legends, legend_occupied)\n    if regions is None:\n        return None\n\n    # Paint walls.\n    for reg in regions:\n        for r, c in reg['walls']:\n            grid[r, c] = reg['color']\n\n    if not _validate_topology(grid, regions):\n        return None\n\n    input_grid = grid.copy()\n    if not _place_yellows(rng, regions, input_grid):\n        return None\n    if not _oracle_check(input_grid, regions):\n        return None\n    return input_grid\n\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\n\nFILE:/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n\n    Input structure:\n    - The grid has a dominant background color.\n    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n\n    Rule:\n    - Keep the input pixels unchanged.\n    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n\n    Key insight:\n    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    out = g.copy()\n    h, w = g.shape\n\n    markers: dict[int, int] = {}\n    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n            continue\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n        source = int(sub[0, 0])\n        halo = int(sub[0, 1])\n        assert source != halo, \"legend source and halo colors must differ\"\n        assert source not in markers, \"each source color must have exactly one legend marker\"\n\n        markers[source] = halo\n        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n\n    assert markers, \"expected at least one left-edge legend marker\"\n\n    for source, halo in markers.items():\n        objects = []\n        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n            if cells <= marker_source_cells[source]:\n                continue\n            objects.append(comp)\n        assert objects, \"each legend source color must label at least one non-marker object\"\n\n        for obj in objects:\n            r0, c0, r1, c1 = obj[\"bbox\"]\n            pr0 = max(0, int(r0) - 1)\n            pc0 = max(0, int(c0) - 1)\n            pr1 = min(h - 1, int(r1) + 1)\n            pc1 = min(w - 1, int(c1) + 1)\n\n            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n            coords = obj[\"coords\"]\n            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n            enclosed = object_interior(patch, background=bg)\n            fill_mask = (patch == bg) & ~enclosed\n\n            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n            target[fill_mask] = halo\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and color palette.\nBACKGROUND = 0\nGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\nAVAILABLE_COLORS = tuple(range(1, 10))\n\n# Legend layout.\nLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\nLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n\n# Sprite geometry and acceptance.\nSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\nSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\nSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\nSPRITE_RETRIES = 300\n\n# Object counts and placement.\nINSTANCE_MIN, INSTANCE_MAX = 1, 3\nOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\nEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\nPLACEMENT_RETRIES = 200\n\n# Whole-sample retry budget.\nGENERATION_RETRIES = 300\n\n\ndef _make_sprite(color):\n    \"\"\"Construct one LR-symmetric 4-connected sprite matching the configured area/hole bounds.\"\"\"\n    target_area = random.randint(SPRITE_AREA_MIN, SPRITE_AREA_MAX)\n    for _ in range(SPRITE_RETRIES):\n        fill_p = target_area / (SPRITE_SIZE * SPRITE_SIZE) + random.uniform(-SPRITE_FILL_JITTER, SPRITE_FILL_JITTER)\n        sprite = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=int)\n        for r in range(SPRITE_SIZE):\n            for c in range(SPRITE_MIRROR_COLS):\n                if random.random() < fill_p:\n                    sprite[r, c] = color\n                    sprite[r, SPRITE_SIZE - 1 - c] = color\n        area = int(np.count_nonzero(sprite))\n        if area != target_area:\n            continue\n        if not is_contiguous(sprite, background=BACKGROUND, connectivity=4):\n            continue\n        if not (np.any(sprite[0] != BACKGROUND) and np.any(sprite[-1] != BACKGROUND) and\n                np.any(sprite[:, 0] != BACKGROUND) and np.any(sprite[:, -1] != BACKGROUND)):\n            continue\n        padded = np.zeros((SPRITE_SIZE + 2, SPRITE_SIZE + 2), dtype=int)\n        padded[1:-1, 1:-1] = sprite\n        interior = object_interior(padded, background=BACKGROUND)\n        holes = int(np.sum(interior & (padded == BACKGROUND)))\n        if holes > MAX_INTERIOR_HOLES:\n            continue\n        return sprite\n    return None\n\n\ndef _boxes_overlap(a, b):\n    return a[0] <= b[2] and a[2] >= b[0] and a[1] <= b[3] and a[3] >= b[1]\n\n\ndef _draw_legend(grid, src1, halo1, src2, halo2):\n    lower_top = grid.shape[0] - LEGEND_MARKER_SIZE\n    upper_top = lower_top - LEGEND_VERTICAL_GAP - LEGEND_MARKER_SIZE\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src1\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo1\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src2\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo2\n    return (upper_top, LEGEND_SOURCE_COL, grid.shape[0] - 1, LEGEND_HALO_COL)\n\n\ndef _visible_window(sprite, size, r0, c0):\n    \"\"\"Return the visible grid bbox and matching sprite slice for a possibly clipped sprite.\"\"\"\n    vr0, vc0 = max(0, r0), max(0, c0)\n    vr1 = min(size - 1, r0 + SPRITE_SIZE - 1)\n    vc1 = min(size - 1, c0 + SPRITE_SIZE - 1)\n    visible = sprite[vr0 - r0:vr1 - r0 + 1, vc0 - c0:vc1 - c0 + 1]\n    return (vr0, vc0, vr1, vc1), visible\n\n\ndef _padded_bbox(visible_box, size):\n    vr0, vc0, vr1, vc1 = visible_box\n    return (max(0, vr0 - HALO_PADDING), max(0, vc0 - HALO_PADDING),\n            min(size - 1, vr1 + HALO_PADDING), min(size - 1, vc1 + HALO_PADDING))\n\n\ndef _place_objects(size, tasks, legend_box):\n    \"\"\"Choose non-overlapping object origins; returns placement tuples or None on retry exhaustion.\"\"\"\n    placed = []\n    placements = []\n    for sprite, sc, hc in tasks:\n        for _ in range(PLACEMENT_RETRIES):\n            if random.random() < EDGE_CLIP_PROB:\n                r0 = random.randint(-EDGE_CLIP_MARGIN, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n            else:\n                r0 = random.randint(0, size - SPRITE_SIZE)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE)\n            visible_box, visible = _visible_window(sprite, size, r0, c0)\n            if np.count_nonzero(visible) == 0:\n                continue\n\n            pbox = _padded_bbox(visible_box, size)\n            if (pbox[1] < OBJECT_MIN_COL or _boxes_overlap(pbox, legend_box) or\n                    any(_boxes_overlap(pbox, eb) for eb in placed)):\n                continue\n\n            placed.append(pbox)\n            placements.append((sprite, sc, hc, r0, c0))\n            break\n        else:\n            return None\n    return placements\n\n\ndef _render_output(grid, placements):\n    \"\"\"Render the paired output and return the generated input with halo-fill cells removed.\"\"\"\n    size = grid.shape[0]\n    output = grid.copy()\n    halo_mask = np.zeros((size, size), dtype=bool)\n\n    for sprite, sc, hc, r0, c0 in placements:\n        visible_box, visible = _visible_window(sprite, size, r0, c0)\n        vr0, vc0, vr1, vc1 = visible_box\n        output_region = output[vr0:vr1 + 1, vc0:vc1 + 1]\n        output_region[visible != BACKGROUND] = sc\n\n        pr0, pc0, pr1, pc1 = _padded_bbox(visible_box, size)\n        patch = np.zeros((pr1 - pr0 + 1, pc1 - pc0 + 1), dtype=int)\n        patch_region = patch[vr0 - pr0:vr1 - pr0 + 1, vc0 - pc0:vc1 - pc0 + 1]\n        patch_region[visible != BACKGROUND] = sc\n\n        enclosed = object_interior(patch, background=BACKGROUND)\n        fill = (patch == BACKGROUND) & ~enclosed\n        output_region = output[pr0:pr1 + 1, pc0:pc1 + 1]\n        output_region[fill] = hc\n        halo_region = halo_mask[pr0:pr1 + 1, pc0:pc1 + 1]\n        halo_region[fill] = True\n\n    inp = output.copy()\n    inp[halo_mask] = BACKGROUND\n    return inp, output\n\n\ndef _matches_oracle(inp, output):\n    try:\n        return np.array_equal(main(inp), output)\n    except Exception:\n        return False\n\n\ndef _gen_attempt():\n    sz = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    colors = list(AVAILABLE_COLORS)\n    random.shuffle(colors)\n    src1, halo1, src2, halo2 = colors[:4]\n\n    sprite1 = _make_sprite(src1)\n    sprite2 = _make_sprite(src2)\n    if sprite1 is None or sprite2 is None:\n        return None\n\n    n1 = random.randint(INSTANCE_MIN, INSTANCE_MAX)\n    n2 = random.randint(INSTANCE_MIN, INSTANCE_MAX)\n    tasks = [(sprite1, src1, halo1)] * n1 + [(sprite2, src2, halo2)] * n2\n    random.shuffle(tasks)\n\n    grid = np.zeros((sz, sz), dtype=int)\n    legend_box = _draw_legend(grid, src1, halo1, src2, halo2)\n\n    placements = _place_objects(sz, tasks, legend_box)\n    if placements is None:\n        return None\n\n    inp, output = _render_output(grid, placements)\n    if _matches_oracle(inp, output):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRIES} attempts\")\n\nFILE:/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\ndef _get_enclosed_holes(sprite):\n    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n    h, w = sprite.shape\n    return [pts for pts in components_mask(~sprite, connectivity=4)\n            if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n\n\ndef _make_diamond():\n    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n    s = np.zeros((3, 3), dtype=bool)\n    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n    return s\n\n\ndef _make_hollow_sprite(h, w, rng):\n    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n    sprite = np.ones((h, w), dtype=bool)\n    if h >= 3 and w >= 3:\n        sprite[1:-1, 1:-1] = False\n    # Optionally add internal horizontal wall\n    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n        br = rng.randint(2, h - 2)\n        n = rng.randint(1, w - 2)\n        s = rng.randint(1, w - 1 - n + 1)\n        sprite[br, s:s + n] = True\n    # Optionally add internal vertical wall\n    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n        bc = rng.randint(2, w - 2)\n        n = rng.randint(1, h - 2)\n        s = rng.randint(1, h - 1 - n + 1)\n        sprite[s:s + n, bc] = True\n    # Optionally remove border cells for irregularity\n    if rng.random() < _P_BORDER_REMOVAL:\n        bcells = [(r, c) for r in range(h) for c in range(w)\n                  if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n        rng.shuffle(bcells)\n        for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n            test = sprite.copy()\n            test[cr, cc] = False\n            if _get_enclosed_holes(test):\n                sprite = test\n    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n        return None\n    return sprite\n\n\ndef _choose_colors(rng, N, num_filled):\n    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n    all_c = list(range(1, 10))\n    rng.shuffle(all_c)\n    border_keys = all_c[:N]\n    rng.shuffle(all_c)\n    fill_values = all_c[:N]\n    dist_cands = [c for c in range(1, 10) if c not in border_keys]\n    distractor_color = rng.choice(dist_cands)\n    mapping = dict(zip(border_keys, fill_values))\n    filled_keys = rng.sample(border_keys, num_filled)\n    return border_keys, fill_values, distractor_color, mapping, filled_keys\n\n\ndef _build_palette(side, border_keys, fill_values):\n    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n    N = len(border_keys)\n    if side in ('top', 'bottom'):\n        pal = np.zeros((2, N), dtype=int)\n        outer, inner = (0, 1) if side == 'top' else (1, 0)\n        pal[outer] = border_keys\n        pal[inner] = fill_values\n    else:\n        pal = np.zeros((N, 2), dtype=int)\n        outer, inner = (0, 1) if side == 'left' else (1, 0)\n        pal[:, outer] = border_keys\n        pal[:, inner] = fill_values\n    return pal\n\n\ndef _place_palette(grid, occ, pal, side, rng):\n    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n    H, W = grid.shape\n    pal_h, pal_w = pal.shape\n    if side == 'top':\n        pr0, pc0 = 0, rng.randint(0, W - pal_w)\n    elif side == 'bottom':\n        pr0, pc0 = H - pal_h, rng.randint(0, W - pal_w)\n    elif side == 'left':\n        pr0, pc0 = rng.randint(0, H - pal_h), 0\n    else:\n        pr0, pc0 = rng.randint(0, H - pal_h), W - pal_w\n    grid[pr0:pr0 + pal_h, pc0:pc0 + pal_w] = pal\n    occ[max(0, pr0 - 1):min(H, pr0 + pal_h + 1),\n        max(0, pc0 - 1):min(W, pc0 + pal_w + 1)] = True\n\n\ndef _find_valid_positions(H, W, occ, mask, holes):\n    \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n    sh, sw = mask.shape\n    positions = []\n    for r0 in range(H - sh + 1):\n        for c0 in range(W - sw + 1):\n            if occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n                   max(0, c0 - 1):min(W, c0 + sw + 1)].any():\n                continue\n            if any(r0 + hr == 0 or c0 + hc == 0 or r0 + hr == H - 1 or c0 + hc == W - 1\n                   for hpts in holes for hr, hc in hpts):\n                continue\n            positions.append((r0, c0))\n    return positions\n\n\ndef _paint_sprite(grid, r0, c0, mask, color, fill, holes):\n    \"\"\"Render a sprite onto the grid: border cells in color, hole cells in fill (if given).\"\"\"\n    grid[r0:r0 + mask.shape[0], c0:c0 + mask.shape[1]][mask] = color\n    if fill is not None:\n        for hpts in holes:\n            for hr, hc in hpts:\n                grid[r0 + hr, c0 + hc] = fill\n\n\ndef _gen_attempt():\n    rng = random.Random()\n    bg = 0\n\n    # Grid size and palette side\n    H = rng.randint(_GRID_H_MIN, _GRID_H_MAX)\n    W = rng.randint(_GRID_W_MIN, _GRID_W_MAX)\n    side = rng.choice(['top', 'bottom', 'left', 'right'])\n    if H <= _SMALL_H_THRESHOLD and side in ('top', 'bottom') and rng.random() < _SMALL_H_PALETTE_FLIP:\n        side = rng.choice(['left', 'right'])\n\n    max_N = H if side in ('left', 'right') else W\n    N = rng.randint(_PALETTE_N_MIN, min(_PALETTE_N_MAX, max_N))\n\n    # Sprite dimension bounds\n    max_sh = min(_SPRITE_H_MAX, H)\n    max_sw = min(_SPRITE_W_MAX, W)\n    if H <= _TINY_H_THRESHOLD:\n        max_sh = 3\n\n    # Sprite counts\n    num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, N))\n    total_sprites = num_filled + 1\n\n    # Generate sprite shapes\n    shapes = []\n    for _ in range(total_sprites):\n        sh = rng.randint(3, max_sh)\n        sw = rng.randint(3, max_sw)\n        if sh + sw > _SPRITE_DIM_SUM_CAP:\n            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)\n        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:\n            mask = _make_diamond()\n        else:\n            mask = _make_hollow_sprite(sh, sw, rng)\n        if mask is None:\n            return None\n        shapes.append(mask)\n\n    # Colors and palette\n    border_keys, fill_values, distractor_color, mapping, filled_keys = \\\n        _choose_colors(rng, N, num_filled)\n    pal = _build_palette(side, border_keys, fill_values)\n\n    grid = np.full((H, W), bg, dtype=int)\n    occ = np.zeros((H, W), dtype=bool)\n    _place_palette(grid, occ, pal, side, rng)\n\n    # Assign colors to sprites: filled sprites use palette keys, last one is distractor\n    infos = []\n    for i, mask in enumerate(shapes):\n        if i < num_filled:\n            c, f = filled_keys[i], mapping[filled_keys[i]]\n        else:\n            c, f = distractor_color, None\n        infos.append((mask, c, f))\n\n    # Place sprites\n    placed = []\n    for mask, color, fill in infos:\n        holes = _get_enclosed_holes(mask)\n        positions = _find_valid_positions(H, W, occ, mask, holes)\n        if not positions:\n            return None\n        r0, c0 = rng.choice(positions)\n        _paint_sprite(grid, r0, c0, mask, color, fill, holes)\n        placed.append((r0, c0, mask, fill))\n        sh, sw = mask.shape\n        occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n            max(0, c0 - 1):min(W, c0 + sw + 1)] = True\n\n    # Derive input from output by clearing filled holes\n    output = grid.copy()\n    inp = grid.copy()\n    for r0, c0, mask, fill in placed:\n        if fill is not None:\n            for hpts in _get_enclosed_holes(mask):\n                for hr, hc in hpts:\n                    inp[r0 + hr, c0 + hc] = bg\n\n    # Validate bg is dominant on border\n    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    if int(vals[cnts.argmax()]) != bg:\n        return None\n\n    # Oracle check\n    try:\n        if np.array_equal(main(inp), output):\n            return inp\n    except Exception:\n        pass\n    return None\n\n\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\nFILE:/home/lixinyu/snap/new/ARC_code/train/db7260a4.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the singleton marker into the matching red U-shaped container, or make a bottom-row puddle if no closed container is hit.\n\n    Input structure\n    - The grid has a dominant background, one singleton marker pixel on the top row,\n      and one other foreground color forming vertical bars and bottom segments.\n    - A closed container is a U shape: two vertical side bars with a continuous\n      bottom segment between them and an empty rectangular interior above the bottom.\n\n    Rule\n    - Remove the top marker from its original cell.\n    - If exactly one closed U-shaped container has the marker column within its\n      horizontal footprint, fill that container's empty interior with the marker color.\n    - If no closed container is under the marker column, fill the whole bottom row\n      with the marker color.\n\n    Key insight\n    - The marker does not identify a color by value; it identifies a vertical drop\n      column, and only a structurally closed U shape can catch and contain the fill.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    foreground_colors = colors_present(g, exclude={bg})\n    assert len(foreground_colors) == 2, \"expected marker and wall colors\"\n\n    singleton_colors = [color for color in foreground_colors if int(np.count_nonzero(g == color)) == 1]\n    assert len(singleton_colors) == 1, \"expected exactly one singleton marker color\"\n    marker_color = singleton_colors[0]\n\n    wall_colors = [color for color in foreground_colors if color != marker_color]\n    assert len(wall_colors) == 1\n    wall_color = wall_colors[0]\n\n    marker_coords = np.argwhere(g == marker_color)\n    assert marker_coords.shape == (1, 2)\n    marker_r, marker_c = map(int, marker_coords[0])\n    assert marker_r == 0, \"marker must sit on the top row\"\n\n    containers = [\n        container\n        for container in _closed_u_containers(g, wall_color, bg)\n        if container[0] > marker_r and container[2] <= marker_c <= container[3]\n    ]\n    assert len(containers) <= 1, \"marker column must select at most one closed container\"\n\n    out = g.copy()\n    out[marker_r, marker_c] = bg\n    if containers:\n        top, bottom, left, right = containers[0]\n        out[top:bottom, left + 1 : right] = marker_color\n    else:\n        assert np.all(out[-1, :] == bg), \"missed marker should fall to an empty bottom row\"\n        out[-1, :] = marker_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed ARC colors and canvas.\n_GEN_BG = 0\n_GEN_MARKER = 1\n_GEN_WALL = 2\n_GEN_H = 10\n_GEN_W = 10\n\n# Vertical layout bounds; row 9 stays empty in generated inputs.\n_GEN_MARKER_ROW = 0\n_GEN_MIN_WALL_ROW = 2\n_GEN_LAST_WALL_ROW = 8\n\n# Closed container interior size ranges, with exclusive upper bounds.\n_GEN_INTERIOR_H_RANGE = (2, 4)\n_GEN_INTERIOR_W_RANGE = (1, 6)\n\n# Broken distractor patch size ranges, with exclusive upper bounds.\n_GEN_DISTRACTOR_H_RANGE = (2, 4)\n_GEN_DISTRACTOR_W_RANGE = (4, 7)\n\n# Scenario mix and distractor count ranges, with exclusive upper bounds.\n_GEN_FILL_CONTAINER_PROB = 0.67\n_GEN_MISSED_HAS_U_PROB = 0.55\n_GEN_DISTRACTORS_WITH_U_RANGE = (0, 2)\n_GEN_DISTRACTORS_WITHOUT_U_RANGE = (1, 4)\n\n# Rejection-sampling retry budget.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_u_patch(interior_h: int, interior_w: int) -> np.ndarray:\n    patch = np.full((interior_h + 1, interior_w + 2), _GEN_BG, dtype=int)\n    patch[:, 0] = _GEN_WALL\n    patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    return patch\n\n\ndef _gen_sample_u() -> tuple[int, int, int, int, int, int]:\n    interior_h = int(np.random.randint(*_GEN_INTERIOR_H_RANGE))\n    interior_w = int(np.random.randint(*_GEN_INTERIOR_W_RANGE))\n    top = int(np.random.randint(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - interior_h + 1))\n    bottom = top + interior_h\n    left = int(np.random.randint(0, _GEN_W - interior_w - 1))\n    right = left + interior_w + 1\n    return top, bottom, left, right, interior_h, interior_w\n\n\ndef _gen_broken_u_patch(height: int, width: int, *, gap: int | None = None, missing_side: str | None = None) -> np.ndarray:\n    patch = np.full((height, width), _GEN_BG, dtype=int)\n    if missing_side != \"left\":\n        patch[:, 0] = _GEN_WALL\n    if missing_side != \"right\":\n        patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    if gap is not None:\n        patch[-1, gap] = _GEN_BG\n    return patch\n\n\ndef _gen_distractor_patches() -> list[np.ndarray]:\n    patches: list[np.ndarray] = []\n\n    for h in range(*_GEN_DISTRACTOR_H_RANGE):\n        for w in range(*_GEN_DISTRACTOR_W_RANGE):\n            gap = int(np.random.randint(1, w - 1))\n            patches.append(_gen_broken_u_patch(h, w, gap=gap))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"left\"))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"right\"))\n\n    return patches\n\n\ndef _gen_valid_positions(grid: np.ndarray, patch: np.ndarray) -> list[tuple[int, int]]:\n    ph, pw = patch.shape\n    local = np.argwhere(patch == _GEN_WALL)\n    local_set = {(int(r), int(c)) for r, c in local}\n    touch_local = {\n        (r + dr, c + dc)\n        for r, c in local_set\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1))\n        if (r + dr, c + dc) not in local_set\n    }\n    positions: list[tuple[int, int]] = []\n\n    for r0 in range(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - ph + 2):\n        for c0 in range(0, _GEN_W - pw + 1):\n            if np.any(grid[r0 + local[:, 0], c0 + local[:, 1]] != _GEN_BG):\n                continue\n            touches = any(\n                0 <= r0 + r < _GEN_H\n                and 0 <= c0 + c < _GEN_W\n                and grid[r0 + r, c0 + c] == _GEN_WALL\n                for r, c in touch_local\n            )\n            if not touches:\n                positions.append((r0, c0))\n\n    return positions\n\n\ndef _gen_place_distractors(grid: np.ndarray, count: int) -> bool:\n    patches = _gen_distractor_patches()\n    for _ in range(count):\n        placed = False\n        for idx in np.random.permutation(len(patches)):\n            patch = patches[int(idx)]\n            positions = _gen_valid_positions(grid, patch)\n            if not positions:\n                continue\n            r0, c0 = positions[int(np.random.randint(0, len(positions)))]\n            paste(grid, patch, r0, c0, transparent=