snap/new/ARC_code/eval/dbff022c.py:31:        \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:195:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:197:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:232:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:235:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:274:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:275:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:278:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:282:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:287:    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:288:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:332:    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:339:    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:346:    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:378:    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:392:    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:408:    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:425:    \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:441:    \"\"\"Render a sprite onto the grid: border cells in