{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/e39e9282.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import Color, find_components, get_bg\nimport itertools\nimport random\n\n\ndef _squares(g: np.ndarray, bg: int) -> list[tuple[int, int, int, int, int]]:\n    out: list[tuple[int, int, int, int, int]] = []\n    for comp in find_components(\n        g,\n        bg=bg,\n        colors=[Color.GREY, Color.PINK],\n        connectivity=4,\n    ):\n        color = int(comp[\"color\"])\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert comp[\"area\"] == 9\n        assert r1 - r0 == 2 and c1 - c0 == 2\n        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color)\n        out.append((r0, c0, r1, c1, color))\n    assert out\n    return out\n\n\ndef _touch_side(\n    r: int, c: int, square: tuple[int, int, int, int, int]\n) -> str | None:\n    r0, c0, r1, c1, _color = square\n    if r0 <= r <= r1:\n        if c == c0 - 1:\n            return \"left\"\n        if c == c1 + 1:\n            return \"right\"\n    if c0 <= c <= c1:\n        if r == r0 - 1:\n            return \"above\"\n        if r == r1 + 1:\n            return \"below\"\n    return None\n\n\ndef _target_for_marker(\n    r: int, c: int, side: str, square: tuple[int, int, int, int, int]\n) -> tuple[int, int]:\n    r0, c0, r1, c1, color = square\n    if color == Color.PINK:\n        if side in {\"left\", \"right\"}:\n            return r, (c0 + c1) // 2\n        return (r0 + r1) // 2, c\n\n    assert color == Color.GREY\n    if side == \"left\":\n        return r, c0\n    if side == \"right\":\n        return r, c1\n    if side == \"above\":\n        return r0, c\n    assert side == \"below\"\n    return r1, c\n\n\ndef _pink_targets_for_markers(\n    markers: list[tuple[int, int, str]],\n    square: tuple[int, int, int, int, int],\n) -> set[tuple[int, int]]:\n    _r0, _c0, _r1, _c1, color = square\n    assert color == Color.PINK\n    return {_target_for_marker(r, c, side, square) for r, c, side in markers}\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Project maroon markers into adjacent grey or pink 3x3 squares, erasing grey squares afterward.\n\n    Input structure\n    The grid has a dominant background, solid 3x3 grey and/or pink squares, and maroon marker pixels or segments directly touching one side of exactly one square.\n    Rule\n    Grey squares are erased; their adjacent maroon markers stay in place and stamp the nearest edge cell inside the grey square. Pink squares stay pink; their adjacent maroon markers disappear and stamp the corresponding cell on the square's middle row or middle column.\n    Key insight\n    The side touched by a marker determines the projection: grey uses the near edge, while pink uses the centerline, preserving the marker's coordinate along that side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g)))\n    assert colors <= {bg, Color.GREY, Color.PINK, Color.MAROON}\n    assert Color.MAROON in colors\n\n    squares = _squares(g, bg)\n    out = g.copy()\n    out[g == Color.GREY] = bg\n\n    paint: set[tuple[int, int]] = set()\n    remove_sources: list[tuple[int, int]] = []\n    pink_markers_by_square: dict[int, list[tuple[int, int, str]]] = {}\n    for r, c in np.argwhere(g == Color.MAROON):\n        hits = []\n        for idx, square in enumerate(squares):\n            side = _touch_side(int(r), int(c), square)\n            if side is not None:\n                hits.append((side, idx, square))\n        assert len(hits) == 1\n\n        side, idx, square = hits[0]\n        if square[4] == Color.PINK:\n            pink_markers_by_square.setdefault(idx, []).append((int(r), int(c), side))\n            remove_sources.append((int(r), int(c)))\n        else:\n            target = _target_for_marker(int(r), int(c), side, square)\n            tr, tc = target\n            assert g[tr, tc] == square[4]\n            paint.add(target)\n\n    for idx, markers in pink_markers_by_square.items():\n        square = squares[idx]\n        for target in _pink_targets_for_markers(markers, square):\n            tr, tc = target\n            assert g[tr, tc] == square[4]\n            paint.add(target)\n\n    for r, c in remove_sources:\n        out[r, c] = bg\n    for r, c in paint:\n        out[r, c] = Color.MAROON\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import paste\n\n\n# Colors.\n_GEN_BG = 8\n_GEN_GREY = 5\n_GEN_PINK = 6\n_GEN_MAROON = 9\n\n# Canvas and square geometry.\n_GEN_CANVAS_MIN = 9\n_GEN_CANVAS_MAX = 15\n_GEN_CANVAS_MAX_DELTA = 2\n_GEN_SQUARE_SIZE = 3\n_GEN_SQUARE_LAST = _GEN_SQUARE_SIZE - 1\n_GEN_SQUARE_GAP = 1\n\n# Square count bounds.\n_GEN_TOTAL_SQUARE_MIN = 1\n_GEN_TOTAL_SQUARE_MAX = 7\n_GEN_GREY_SQUARE_MAX = 3\n_GEN_PINK_SQUARE_MAX = 4\n\n# Marker side and count bounds.\n_GEN_SIDES = (\"left\", \"right\", \"above\", \"below\")\n_GEN_MARKER_SIDE_MIN = 1\n_GEN_MARKER_SIDE_MAX = 3\n_GEN_MARKER_PER_SIDE_MAX = 3\n_GEN_MARKER_TOTAL_MAX = 5\n\n# Rejection sampling budget.\n_GEN_MAX_ATTEMPTS = 300\n_GEN_SQUARE_PATCHES = {color: np.full((_GEN_SQUARE_SIZE, _GEN_SQUARE_SIZE), color, dtype=int) for color in (_GEN_GREY, _GEN_PINK)}\n\n_GenSquare = tuple[int, int, int]\n_GenMarker = tuple[int, int, str]\n\n\ndef _gen_square_gap_ok(r0: int, c0: int, squares: list[_GenSquare]) -> bool:\n    last = _GEN_SQUARE_LAST\n    gap = _GEN_SQUARE_GAP\n    r1, c1 = r0 + last, c0 + last\n    for sr0, sc0, _color in squares:\n        sr1, sc1 = sr0 + last, sc0 + last\n        if not (\n            r1 < sr0 - gap\n            or sr1 < r0 - gap\n            or c1 < sc0 - gap\n            or sc1 < c0 - gap\n        ):\n            return False\n    return True\n\n\ndef _gen_place_square(grid: np.ndarray, r0: int, c0: int, color: int) -> None:\n    paste(grid, _GEN_SQUARE_PATCHES[int(color)], r0, c0)\n\n\ndef _gen_side_for_cell(r: int, c: int, square: _GenSquare) -> str | None:\n    r0, c0, _color = square\n    r1, c1 = r0 + _GEN_SQUARE_LAST, c0 + _GEN_SQUARE_LAST\n    if r0 <= r <= r1:\n        if c == c0 - 1:\n            return \"left\"\n        if c == c1 + 1:\n            return \"right\"\n    if c0 <= c <= c1:\n        if r == r0 - 1:\n            return \"above\"\n        if r == r1 + 1:\n            return \"below\"\n    return None\n\n\ndef _gen_inside_square(r: int, c: int, square: _GenSquare) -> bool:\n    r0, c0, _color = square\n    r1, c1 = r0 + _GEN_SQUARE_LAST, c0 + _GEN_SQUARE_LAST\n    return r0 <= r <= r1 and c0 <= c <= c1\n\n\ndef _gen_valid_marker_slot(r: int, c: int, squares: list[_GenSquare]) -> bool:\n    if any(_gen_inside_square(r, c, square) for square in squares):\n        return False\n    hits = sum(\n        _gen_side_for_cell(r, c, square) is not None for square in squares\n    )\n    return hits == 1\n\n\ndef _gen_side_slots(H: int, W: int, square: _GenSquare, squares: list[_GenSquare]) -> dict[str, list[tuple[int, int]]]:\n    r0, c0, _color = square\n    edge = _GEN_SQUARE_SIZE\n    raw = {\n        \"left\": [(r, c0 - 1) for r in range(r0, r0 + edge)] if c0 > 0 else [],\n        \"right\": [(r, c0 + edge) for r in range(r0, r0 + edge)] if c0 + edge < W else [],\n        \"above\": [(r0 - 1, c) for c in range(c0, c0 + edge)] if r0 > 0 else [],\n        \"below\": [(r0 + edge, c) for c in range(c0, c0 + edge)] if r0 + edge < H else [],\n    }\n    return {\n        side: [\n            (r, c)\n            for r, c in slots\n            if _gen_valid_marker_slot(r, c, squares)\n        ]\n        for side, slots in raw.items()\n    }\n\n\ndef _gen_split_marker_total(total: int, caps: list[int]) -> list[int] | None:\n    counts: list[int] = []\n    remaining = int(total)\n    for i, cap in enumerate(caps):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/758abdf0.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg\nimport random\n\nCoord = tuple[int, int]\nCellPair = tuple[Coord, Coord]\n\n\ndef _edge_bar(g: np.ndarray, bg: int) -> tuple[str, int]:\n    h, w = g.shape\n    candidates: list[tuple[str, int, np.ndarray]] = []\n\n    for color in colors_present(g, exclude={bg}):\n        if np.all(g[0, :] == color):\n            mask = np.zeros_like(g, dtype=bool)\n            mask[0, :] = True\n            candidates.append((\"top\", int(color), mask))\n        if np.all(g[h - 1, :] == color):\n            mask = np.zeros_like(g, dtype=bool)\n            mask[h - 1, :] = True\n            candidates.append((\"bottom\", int(color), mask))\n        if np.all(g[:, 0] == color):\n            mask = np.zeros_like(g, dtype=bool)\n            mask[:, 0] = True\n            candidates.append((\"left\", int(color), mask))\n        if np.all(g[:, w - 1] == color):\n            mask = np.zeros_like(g, dtype=bool)\n            mask[:, w - 1] = True\n            candidates.append((\"right\", int(color), mask))\n\n    assert len(candidates) == 1, \"expected exactly one full non-bg edge bar\"\n    edge, color, mask = candidates[0]\n    assert np.array_equal(g == color, mask), \"edge-bar color must occur only on that edge\"\n    return edge, color\n\n\ndef _lane_cells(edge: str, shape: tuple[int, int], lane: int) -> tuple[CellPair, CellPair]:\n    h, w = shape\n    if edge == \"top\":\n        return ((1, lane), (2, lane)), ((h - 2, lane), (h - 1, lane))\n    if edge == \"bottom\":\n        return ((h - 2, lane), (h - 3, lane)), ((1, lane), (0, lane))\n    if edge == \"left\":\n        return ((lane, 1), (lane, 2)), ((lane, w - 2), (lane, w - 1))\n    if edge == \"right\":\n        return ((lane, w - 2), (lane, w - 3)), ((lane, 1), (lane, 0))\n    raise AssertionError(f\"unknown edge {edge!r}\")\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Advance short marker bars away from the full edge bar, turning completed two-pixel markers into edge-color marks at the opposite side.\n\n    Input structure\n    - The background is the dominant color.\n    - One non-background color forms a complete one-cell-thick bar on exactly one outer edge.\n    - The other foreground color appears only in the first two cells inward from that bar, lane by lane.\n\n    Rule\n    - In each lane perpendicular to the edge bar, a one-pixel marker adjacent to the bar grows one more cell inward.\n    - A two-pixel marker in those first two inward cells is cleared back to background.\n    - The cleared two-pixel marker is replaced by a two-pixel mark of the edge-bar color at the opposite side of the same lane.\n\n    Key insight\n    - The full edge bar defines both the orientation and the direction of the local two-step marker cycle.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    edge, edge_color = _edge_bar(g, bg)\n    marker_colors = colors_present(g, exclude={bg, edge_color})\n    assert len(marker_colors) == 1, \"expected exactly one marker color\"\n    marker = int(marker_colors[0])\n\n    h, w = g.shape\n    perp_len = h if edge in {\"top\", \"bottom\"} else w\n    assert perp_len >= 5, \"need non-overlapping near and opposite two-cell marks\"\n    lanes = range(w) if edge in {\"top\", \"bottom\"} else range(h)\n\n    out = g.copy()\n    near_cells: set[tuple[int, int]] = set()\n    changed = False\n    for lane in lanes:\n        near, far = _lane_cells(edge, g.shape, int(lane))\n        near_cells.update(near)\n        first, second = (int(g[r, c]) for r, c in near)\n\n        if first == marker and second == marker:\n            assert all(int(g[r, c]) == bg for r, c in far), \"opposite target cells must be background\"\n            for r, c in near:\n                out[r, c] = bg\n            for r, c in far:\n                out[r, c] = edge_color\n            changed = True\n        elif first == marker:\n            assert second == bg, \"single marker must have background behind it\"\n            out[near[1]] = marker\n            changed = True\n        else:\n            assert first == bg and second == bg, \"empty lanes must be background in the first two inward cells\"\n\n    for r, c in np.argwhere(g == marker):\n        assert (int(r), int(c)) in near_cells, \"markers must be in the first two inward cells\"\n    assert changed, \"expected at least one marker to transform\"\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and edge choices.\nEDGE_NAMES = [\"top\", \"bottom\", \"left\", \"right\"]\nSIZE_MIN, SIZE_MAX = 8, 16\n\n# Lane population constraints.\nNONEMPTY_LANES_MIN, NONEMPTY_LANES_MAX = 3, 7\nNONEMPTY_RATIO_MIN, NONEMPTY_RATIO_MAX = 0.25, 0.44\nSINGLE_LANES_MIN, SINGLE_LANES_MAX = 1, 4\nDOUBLE_LANES_MIN, DOUBLE_LANES_MAX = 1, 4\n\n# Palette and retry limits.\nCOLOR_COUNT = 10\nPALETTE_SIZE = 3\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _choose_shape(edge: str, nonempty: int) -> tuple[int, int]:\n    \"\"\"Choose dimensions whose lane count satisfies the active-lane ratio.\"\"\"\n    lane_lengths = [\n        n\n        for n in range(SIZE_MIN, SIZE_MAX + 1)\n        if NONEMPTY_RATIO_MIN <= nonempty / n <= NONEMPTY_RATIO_MAX\n    ]\n    lanes = random.choice(lane_lengths)\n    perp = random.randint(SIZE_MIN, SIZE_MAX)\n    if edge in {\"top\", \"bottom\"}:\n        return perp, lanes\n    return lanes, perp\n\n\ndef _paint_edge_bar(g: np.ndarray, out: np.ndarray, edge: str, edge_color: int) -> None:\n    \"\"\"Paint the same full edge bar in the input and expected output grids.\"\"\"\n    h, w = g.shape\n    edge_index = {\n        \"top\": (0, slice(None)),\n        \"bottom\": (h - 1, slice(None)),\n        \"left\": (slice(None), 0),\n        \"right\": (slice(None), w - 1),\n    }[edge]\n    g[edge_index] = edge_color\n    out[edge_index] = edge_color\n\n\ndef _choose_lane_states(lane_count: int, nonempty: int) -> tuple[list[int], set[int]]:\n    \"\"\"Choose active lanes and the subset that should start as singles.\"\"\"\n    min_singles = max(SINGLE_LANES_MIN, nonempty - DOUBLE_LANES_MAX)\n    max_singles = min(SINGLE_LANES_MAX, nonempty - DOUBLE_LANES_MIN)\n    singles = random.randint(min_singles, max_singles)\n    active_lanes = random.sample(range(lane_count), nonempty)\n    return active_lanes, set(random.sample(active_lanes, singles))\n\n\ndef _apply_lane(g, out, edge, lane, marker, edge_color, is_single):\n    \"\"\"Render one input lane plus its expected transformed output cells.\"\"\"\n    near, far = _lane_cells(edge, g.shape, lane)\n    first, second = near\n    g[first] = marker\n    if is_single:\n        out[first] = marker\n        out[second] = marker\n        return\n\n    g[second] = marker\n    for r, c in far:\n        out[r, c] = edge_color\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    edge = random.choice(EDGE_NAMES)\n    nonempty = random.randint(NONEMPTY_LANES_MIN, NONEMPTY_LANES_MAX)\n    h, w = _choose_shape(edge, nonempty)\n\n    bg, edge_color, marker = random.sample(range(COLOR_COUNT), PALETTE_SIZE)\n    g = np.full((h, w), bg, dtype=int)\n    out = g.copy()\n\n    _paint_edge_bar(g, out, edge, edge_color)\n    lane_count = w if edge in {\"top\", \"bottom\"} else h\n    active_lanes, single_lanes = _choose_lane_states(lane_count, nonempty)\n\n    for lane in active_lanes:\n        _apply_lane(g, out, edge, lane, marker, edge_color, lane in single_lanes)\n\n    try:\n        solved = main(g)\n    except Exception:\n        return None\n    if not np.array_equal(solved, out):\n        return None\n    return g\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 758abdf0 input\")\n","exit_code":0,"status":"completed"}}
