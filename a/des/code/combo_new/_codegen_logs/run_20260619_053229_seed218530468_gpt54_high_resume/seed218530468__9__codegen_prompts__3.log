{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg\nimport random\n\n\ndef _assert_output_footprints_disjoint(dims: list[tuple[int, int]]) -> None:\n    occupied: set[tuple[int, int]] = set()\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, cc) for r in range(short) for cc in range(c, c + long)}\n        assert not (occupied & cells), \"normalized output rectangles must not overlap\"\n        occupied |= cells\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, cc)\n            for r in range(10 - long, 10)\n            for cc in range(c, c + short)\n        }\n        assert not (occupied & cells), \"normalized output rectangles must not overlap\"\n        occupied |= cells\n        c += short + 1\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.\n\n    Input structure\n    The grid has one background color and one foreground color; the foreground forms\n    separate solid rectangles, ordered from left to right.\n\n    Rule\n    Build a 10-row background canvas whose width is the packed width of the wide\n    versions of the rectangles. For each source rectangle, paint a top-aligned\n    rectangle of shape min(h,w) by max(h,w), with one background column between\n    consecutive rectangles. Then, starting again from the left edge, paint a\n    bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,\n    again separated by one background column.\n\n    Key insight\n    The input rectangles are not copied in their original orientations; each object\n    contributes one horizontal-facing and one vertical-facing normalized rectangle,\n    preserving left-to-right object order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n    fg = fg_colors[0]\n\n    components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n    assert components\n    components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n\n    dims: list[tuple[int, int]] = []\n    for obj in components:\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert obj[\"area\"] == h * w\n        dims.append((h, w))\n\n    out_h = 10\n    out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n    _assert_output_footprints_disjoint(dims)\n    out = np.full((out_h, out_w), bg, dtype=int)\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[:short, c : c + long] = fg\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[out_h - long : out_h, c : c + short] = fg\n        c += short + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\n# Rectangle counts and dimensions.\nRECT_COUNT_MIN = 4\nRECT_COUNT_MAX = 6\nSHORT_SIDE_MIN = 1\nSHORT_SIDE_MAX = 3\nSIDE_SUM_MAX = 10\nLONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN\n\n# Canvas and packing constraints.\nARC_GRID_MAX = 30\nOUTPUT_HEIGHT = 10\nGAP_WIDTH = 1\n\n# Retry policy.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_d749d46f_output_footprints_disjoint(dims):\n    occupied = set()\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, c) for r in range(short) for c in range(col, col + long)}\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += long + GAP_WIDTH\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, c)\n            for r in range(OUTPUT_HEIGHT - long, OUTPUT_HEIGHT)\n            for c in range(col, col + short)\n        }\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += short + GAP_WIDTH\n\n    return True\n\n\ndef _sample_dimensions(n_rects):\n    \"\"\"Sample source rectangle dimensions under the output-width budget.\"\"\"\n    dims = []\n    remaining_budget = ARC_GRID_MAX - GAP_WIDTH * (n_rects - 1)\n\n    for i in range(n_rects):\n        rects_left = n_rects - i\n        min_needed = rects_left - 1\n        max_for_this = min(remaining_budget - min_needed, LONG_SIDE_MAX)\n        if max_for_this < SHORT_SIDE_MIN:\n            return None\n\n        short = random.randint(SHORT_SIDE_MIN, SHORT_SIDE_MAX)\n        max_long = min(SIDE_SUM_MAX - short, max_for_this)\n        if max_long < short:\n            short = SHORT_SIDE_MIN\n            max_long = min(LONG_SIDE_MAX, max_for_this)\n            if max_long < SHORT_SIDE_MIN:\n                return None\n\n        long = random.randint(short, max_long)\n        remaining_budget -= long\n\n        if random.random() < 0.5:\n            h, w = long, short\n        else:\n            h, w = short, long\n        dims.append((h, w))\n\n    return dims\n\n\ndef _input_shape(dims):\n    return max(h for h, _ in dims), sum(w for _, w in dims) + GAP_WIDTH * (len(dims) - 1)\n\n\ndef _background_is_dominant(dims, inp_h, inp_w):\n    fg_pixels = sum(h * w for h, w in dims)\n    total_pixels = inp_h * inp_w\n    bg_pixels = total_pixels - fg_pixels\n    return bg_pixels > fg_pixels\n\n\ndef _build_input_grid(dims, bg, fg, inp_h, inp_w):\n    grid = np.full((inp_h, inp_w), bg, dtype=int)\n    col = 0\n    for h, w in dims:\n        grid[:h, col:col + w] = fg\n        col += w + GAP_WIDTH\n    return grid\n\n\ndef _passes_solver_oracle(grid):\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return out.shape[0] == OUTPUT_HEIGHT\n\n\ndef _gen_attempt():\n    \"\"\"Generate one valid input grid, or None when sampled dimensions fail constraints.\"\"\"\n    bg, fg = random.sample(COLOR_VALUES, 2)\n    n_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)\n    dims = _sample_dimensions(n_rects)\n    if dims is None:\n        return None\n\n    inp_h, inp_w = _input_shape(dims)\n    if inp_w > ARC_GRID_MAX:\n        return None\n    if not _gen_d749d46f_output_footprints_disjoint(dims):\n        return None\n    if inp_h > ARC_GRID_MAX or inp_h < 1:\n        return None\n    if not _background_is_dominant(dims, inp_h, inp_w):\n        return None\n\n    grid = _build_input_grid(dims, bg, fg, inp_h, inp_w)\n    if not _passes_solver_oracle(grid):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport numpy as np\nfrom scipy.ndimage import label\nfrom arc_utils import STRUCT4, STRUCT8, get_bg, in_bounds, neighbors4, paste, random_free_location\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble scattered rectangular pieces into a rectangle at an L-marker corner.\n\n    Input structure:\n    - bg = most common color. Non-bg rectangular pieces scattered on the grid.\n    - 3-pixel L-marker (2x2 minus one cell) tags the corner; the gap is the corner cell.\n\n    Rule:\n    - rect_col = most common color across all piece pixels; all outer rectangle edges must be rect_col.\n    - Translate pieces (no rotation) to tile the rectangle; touching edges must match, with rect_col as wildcard.\n\n    Key insight: rect_col acts as wildcard during edge matching — only non-rect_col pixels at shared boundaries must agree.\n    \"\"\"\n    inp = grid\n    g = np.array(inp, dtype=int)\n    GH, GW = g.shape\n\n    bg = int(Counter(map(int, g.flatten())).most_common(1)[0][0])\n\n    # Find marker: a color appearing exactly 3 times forming an L in a 2x2 bbox.\n    cnt = Counter(map(int, g.flatten()))\n    mark = None\n    missing = None\n    mb = None  # marker bbox\n    for col in sorted([c for c, n in cnt.items() if int(c) != int(bg) and int(n) == 3]):\n        pts = [(int(r), int(c)) for r, c in np.argwhere(g == int(col))]\n        rs = [r for r, _ in pts]\n        cs = [c for _, c in pts]\n        r0, r1 = min(rs), max(rs)\n        c0, c1 = min(cs), max(cs)\n        if (r1 - r0) == 1 and (c1 - c0) == 1:\n            all4 = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}\n            miss = list(all4 - set(pts))\n            if len(miss) == 1:\n                mark = int(col)\n                missing = miss[0]\n                mb = (r0, c0, r1, c1)\n                break\n\n    assert not (mark is None or missing is None or mb is None)\n\n    r0, c0, r1, c1 = mb\n    # Rectangle corner is opposite the marker bulk.\n    if missing == (r0, c0):\n        corner = \"BR\"\n    elif missing == (r0, c1):\n        corner = \"BL\"\n    elif missing == (r1, c0):\n        corner = \"TR\"\n    else:\n        corner = \"TL\"\n\n    # Decompose occupied mask (non-bg and non-marker) into rectangles.\n    occ = (g != int(bg)) & (g != int(mark))\n    used = np.zeros_like(occ, dtype=bool)\n    rects = []  # (r, c, h, w, arr)\n    while True:\n        idx = np.argwhere(occ & (~used))\n        if idx.size == 0:\n            break\n        rr, cc = map(int, idx[0])\n        w = 0\n        while cc + w < GW and bool(occ[rr, cc + w]) and (not bool(used[rr, cc + w])):\n            w += 1\n        h = 0\n        while rr + h < GH and bool((occ[rr + h, cc : cc + w] & (~used[rr + h, cc : cc + w])).all()):\n            h += 1\n        used[rr : rr + h, cc : cc + w] = True\n        rects.append((rr, cc, h, w, g[rr : rr + h, cc : cc + w].copy()))\n\n    total_area = int(sum(int(h) * int(w) for _r, _c, h, w, _a in rects))\n\n    # The final rectangle's border/background color.\n    allpix = []\n    for _r, _c, _h, _w, a in rects:\n        allpix.extend(map(int, a.flatten()))\n    rect_col = int(Counter(allpix).most_common(1)[0][0])\n\n    mr, mc = map(int, missing)\n\n    # Anchor piece: the rectangle containing the corner cell.\n    anchor_idx = None\n    for i, (rr, cc, h, w, _a) in enumerate(rects):\n        if rr <= mr < rr + h and cc <= mc < cc + w:\n            anchor_idx = i\n            break\n\n    pieces = [a for _r, _c, _h, _w, a in rects]\n    ph = [int(p.shape[0]) for p in pieces]\n    pw = [int(p.shape[1]) for p in pieces]\n\n    # Candidate rectangle dimensions are factor pairs of total_area that fit in the grid\n    # when anchored at (mr, mc) as the specified corner.\n    dims = []\n    for hh in range(1, int(total_area**0.5) + 1):\n        if total_area % hh == 0:\n            dims.append((hh, total_area // hh))\n            if hh * hh != total_area:\n                dims.append((total_area // hh, hh))\n\n    def fits(H, W):\n        if corner == \"TL\":\n            tr, tc = mr, mc\n        elif corner == \"TR\":\n            tr, tc = mr, mc - W + 1\n        elif corner == \"BL\":\n            tr, tc = mr - H + 1, mc\n        else:  # \"BR\"\n            tr, tc = mr - H + 1, mc - W + 1\n        return 0 <= tr and 0 <= tc and (tr + H) <= GH and (tc + W) <= GW\n\n    dims = [(int(H), int(W)) for H, W in dims if fits(int(H), int(W))]\n    dims = sorted(dims, key=lambda t: (-t[0] * t[1], -t[0], -t[1]))\n\n    def compat(v1, v2):\n        v1 = np.array(v1, dtype=int)\n        v2 = np.array(v2, dtype=int)\n        m = (v1 != int(rect_col)) & (v2 != int(rect_col))\n        return bool((v1[m] == v2[m]).all())\n\n    def assemble(H, W):\n        occ2 = np.full((H, W), -1, dtype=int)\n        usedp = [False] * len(pieces)\n\n        def boundary_ok(a, r, c):\n            h, w = a.shape\n            if r == 0 and not np.all(a[0, :] == int(rect_col)):\n                return False\n            if (r + h) == H and not np.all(a[-1, :] == int(rect_col)):\n                return False\n            if c == 0 and not np.all(a[:, 0] == int(rect_col)):\n                return False\n            if (c + w) == W and not np.all(a[:, -1] == int(rect_col)):\n                return False\n            return True\n\n        def neighbor_ok(a, r, c):\n            h, w = a.shape\n            if c > 0:\n                left = occ2[r : r + h, c - 1]\n                m = left != -1\n                if m.any() and (not compat(left[m], a[:, 0][m])):\n                    return False\n            if (c + w) < W:\n                right = occ2[r : r + h, c + w]\n                m = right != -1\n                if m.any() and (not compat(right[m], a[:, -1][m])):\n                    return False\n            if r > 0:\n                up = occ2[r - 1, c : c + w]\n                m = up != -1\n                if m.any() and (not compat(up[m], a[0, :][m])):\n                    return False\n            if (r + h) < H:\n                down = occ2[r + h, c : c + w]\n                m = down != -1\n                if m.any() and (not compat(down[m], a[-1, :][m])):\n                    return False\n            return True\n\n        def can_place(i, r, c):\n            a = pieces[i]\n            h, w = a.shape\n            if (r + h) > H or (c + w) > W:\n                return False\n            if (occ2[r : r + h, c : c + w] != -1).any():\n                return False\n            if not boundary_ok(a, r, c):\n                return False\n            if not neighbor_ok(a, r, c):\n                return False\n            return True\n\n        def place(i, r, c):\n            a = pieces[i]\n            h, w = a.shape\n            occ2[r : r + h, c : c + w] = a\n            usedp[i] = True\n\n        def unplace(i, r, c):\n            a = pieces[i]\n            h, w = a.shape\n            occ2[r : r + h, c : c + w] = -1\n            usedp[i] = False\n\n        # Pre-place anchor piece if the corner cell is exactly a corner of that piece.\n        if anchor_idx is not None:\n            rr, cc, h0, w0, _ = rects[anchor_idx]\n            corners = {\n                (rr, cc): \"TL\",\n                (rr, cc + w0 - 1): \"TR\",\n                (rr + h0 - 1, cc): \"BL\",\n                (rr + h0 - 1, cc + w0 - 1): \"BR\",\n            }\n            if (mr, mc) in corners and corners[(mr, mc)] == corner:\n                ah, aw = ph[anchor_idx], pw[anchor_idx]\n                if corner == \"TL\":\n                    ar0, ac0 = 0, 0\n                elif corner == \"TR\":\n                    ar0, ac0 = 0, W - aw\n                elif corner == \"BL\":\n                    ar0, ac0 = H - ah, 0\n                else:  # \"BR\"\n                    ar0, ac0 = H - ah, W - aw\n                if can_place(anchor_idx, ar0, ac0):\n                    place(anchor_idx, ar0, ac0)\n\n        order = sorted(range(len(pieces)), key=lambda i: (-ph[i] * pw[i], -ph[i], -pw[i], i))\n\n        def next_empty():\n            idx = np.argwhere(occ2 == -1)\n            if idx.size == 0:\n                return None\n            return tuple(map(int, idx[0]))\n\n        solved = False\n\n        def bt():\n            nonlocal solved\n            nxt = next_empty()\n            if nxt is None:\n                solved = True\n                return\n            r, c = nxt\n            for i in order:\n                if usedp[i]:\n                    continue\n                if can_place(i, r, c):\n                    place(i, r, c)\n                    bt()\n                    if solved:\n                        return\n                    unplace(i, r, c)\n","exit_code":0,"status":"completed"}}
