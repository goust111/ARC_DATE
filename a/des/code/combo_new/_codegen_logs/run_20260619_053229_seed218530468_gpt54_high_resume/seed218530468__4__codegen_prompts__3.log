:177:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7666fa5d.py:206:    \"\"\"Try to split segs[idx] into two 8-disconnected pieces on the same k (in-place).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7666fa5d.py:232:    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7666fa5d.py:280:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py:12:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py:13:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py:16:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py:20:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py:25:    Key insight: Blue pixels on a bar encode its danger radius — more blue means a wider no-go zone the path must respect.\n/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py:26:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py:159:    \"\"\"Minimum main-axis size to fit all bars with required spacing.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py:167:    \"\"\"Distribute `total` into `parts` non-negative integers uniformly (stars-and-bars).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py:180:    \"\"\"Pick blue counts per bar such that they fit within main_hi.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py:190:    \"\"\"Valid bar length range given cross-axis size and blue count.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py:199:    \"\"\"Paint a single bar on `row` starting from the given wall side.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py:215:    \"\"\"Build the grid in canonical orientation (start edge = top, path goes down).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py:250:    \"\"\"Rotate canonical (top-start) grid so the start edge matches `edge`.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py:261:    \"\"\"Check whether the solved output has green on the edge opposite to `edge`.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py:272:    \"\"\"Single generation attempt: pick parameters, build grid, validate via solver.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/cb2d8a2c.py:303:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:8:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:9:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:12:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:16:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:20:    Key insight: Each color has its own independent symmetry axis; the task is per-color denoising, not whole-grid symmetry.\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:21:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:96:    \"\"\"Return {axis_k: symmetric_pair_count} for every candidate vertical axis.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:110:    \"\"\"Return the highest axis score excluding the true axis.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:116:    \"\"\"Enumerate all (h, w, target_count, center_count) tuples satisfying spec constraints.\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:120:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:156:    \"\"\"Pick a random (h, w, target_count, center_count), weighting toward denser fills.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:168:    \"\"\"Choose left_count cells from the left half-grid (h x side_w), ensuring connectivity.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:190:    \"\"\"Return boolean mask of which rows have a center-column pixel.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:198:    \"\"\"Build a vertically-symmetric sprite and return (sprite_array, local_axis_k).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:226:    \"\"\"Place sprites into slot regions on a fresh grid. Returns (grid, placed_specs) or None.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:247:    \"\"\"Find all cells 4-adjacent to the clean shape that are valid noise placements.\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:251:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:279:    \"\"\"Add noise pixels to one sprite in inp. Returns False if constraints can't be met.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:328:    \"\"\"Single attempt: build clean sprites, place them, add noise, validate via solver.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8e5c0c38.py:364:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py:14:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py:15:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py:18:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py:22:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py:27:    Key insight: The bar's projections act as keys that must align with the colored-column \"locks\" in the slot.\n/home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py:28:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py:179:    \"\"\"Grey frame with top/bottom/right walls closed and a 2-cell gap in the left wall.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py:189:    \"\"\"Horizontal bar base with 4 upward grey projections at local cols {0,2,4,6}.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py:199:    \"\"\"Paint one slot column.\n/home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py:203:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py:247:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:8:    \"\"\"Local helper: build a boolean mask from bbox-relative component coordinates.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:20:    \"\"\"Canonicalize a boolean mask up to rotation and horizontal reflection.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:31:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:32:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:35:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:39:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:45:    Key insight: The sorting criterion is shape frequency (rotation-invariant), not area — duplicated shapes go up, unique shapes go down.\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:46:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:113:    \"\"\"Return all (h, w) bboxes where area fits with fill_ratio >= MIN_FILL_RATIO_X10/10.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:132:    \"\"\"Create a seed mask along a diagonal line spanning the bbox, randomly flipped.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:153:    \"\"\"Grow an 8-connected mask from a line seed to the target area.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:169:    \"\"\"Paint a boolean mask into a colored patch on a bg-filled array.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:176:    \"\"\"Generate a random 8-connected component with the given area and color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:189:    \"\"\"Apply a random rotation (0-3) and optional horizontal flip to a mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:197:    \"\"\"Create a duplicate of template's shape with a new color and random transform.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:206:    \"\"\"Distribute components horizontally with random spacing (min gap = MIN_COL_GAP).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:224:    \"\"\"Return a mask that is True wherever occupied or any 8-neighbor is occupied.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:238:    \"\"\"Check if mask placed at (r0, c0) overlaps any dilated-occupied cell.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:244:    \"\"\"Paint all components at their output positions.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:252:    \"\"\"Place components at random non-output rows without 8-neighbor overlap.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:284:    \"\"\"Create duplicate-shape (top) and unique-shape (bottom) component groups.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:321:    \"\"\"Single attempt: build output-first, derive input, validate with oracle.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:361:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:12:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:13:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:29:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:343:    \"\"\"Connect background-region labels separated by each wall component.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:389:    \"\"\"Validate task constraints and return the solver-expected output grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:452:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py:8:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py:9:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py:12:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py:16:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py:22:    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py:23:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py:471:def generate_input():\n/home/lixinyu/snap/new/ARC_code/eval/16b78196.py:5:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/16b78196.py:6:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/16b78196.py:9:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/16b78196.py:13:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/16b78196.py:19:    Key insight: The root piece's extent perpendicular to the chain direction locks the strip width for all subsequent pieces in that chain.\n/home/lixinyu/snap/new/ARC_code/eval/16b78196.py:20:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/16b78196.py:279:    \"\"\"Check 4-connectivity of a cell set.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/16b78196.py:297:    \"\"\"Grow a 4-connected shape of exactly *target* cells within *available*, starting from *seeds*.\n/home/lixinyu/snap/new/ARC_code/eval/16b78196.py:301:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/16b78196.py:379:    \"\"\"Build one (input, output) pair; returns (input, output) or None.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/16b78196.py:689:def generate_input():\n/home/lixinyu/snap/new/ARC_code/eval/16b78196.py:690:    \"\"\"Generate a valid input grid for task 16b78196 (max 300 retries).\"\"\"\n","exit_code":0,"status":"completed"}}
