{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/16b78196.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import components_mask, find_components, get_bg\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble colored sprites into a central bar's notches, chaining successive pieces along fixed-width strips.\n\n    Input structure:\n    - bg = most common color. Largest monochrome component is a solid \"bar\" with boundary notches (bg holes opening to its bbox edge).\n    - Several smaller colored sprites scattered around the bar.\n\n    Rule:\n    - Each bar notch is filled by a root piece whose shape exactly covers the hole.\n    - The root defines a strip (column-span or row-span) for its chain.\n    - Successive pieces fill the bg cells inside the previous piece's bbox, locked to the same strip width.\n    - Multiple chains grow independently from different bar notches.\n\n    Key insight: The root piece's extent perpendicular to the chain direction locks the strip width for all subsequent pieces in that chain.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    bg = get_bg(g)\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n    comps.sort(key=lambda d: -d[\"area\"])\n    assert comps\n\n    bar = comps[0]\n    pieces_raw = comps[1:]\n\n    out = np.full((H, W), int(bg), dtype=int)\n    bar_r0, bar_c0, bar_r1, bar_c1 = map(int, bar[\"bbox\"])\n    bar_h, bar_w = bar_r1 - bar_r0 + 1, bar_c1 - bar_c0 + 1\n    bar_color = int(bar[\"color\"])\n    bar_occ = set((int(r), int(c)) for r, c in bar[\"coords\"])\n    bar_mask = np.zeros((bar_h, bar_w), dtype=bool)\n    for r, c in bar_occ:\n        bar_mask[r - bar_r0, c - bar_c0] = True\n    for r, c in bar_occ:\n        out[r, c] = bar_color\n\n    def shape_from_coords(coords: np.ndarray, bbox):\n        r0, c0, r1, c1 = map(int, bbox)\n        h, w = r1 - r0 + 1, c1 - c0 + 1\n        rel = [(int(r - r0), int(c - c0)) for r, c in coords]\n        rel_set = set(rel)\n        return {\"rel\": rel, \"rel_set\": rel_set, \"h\": h, \"w\": w}\n\n    pieces = []\n    for p in pieces_raw:\n        # For this puzzle, pieces are used in their original orientation (no rotation / flip).\n        r0, c0 = map(int, p[\"bbox\"][:2])\n        pieces.append({\"color\": int(p[\"color\"]), \"shape\": shape_from_coords(p[\"coords\"], p[\"bbox\"]), \"orig\": (r0, c0)})\n\n    def bar_notches(bar_mask, bar_r0, bar_c0):\n        empty = ~bar_mask\n        h, w = map(int, empty.shape)\n        notches = []\n        for pts in components_mask(empty, connectivity=4):\n            r = pts[:, 0]\n            c = pts[:, 1]\n            top = int((r == 0).sum())\n            bottom = int((r == h - 1).sum())\n            left = int((c == 0).sum())\n            right = int((c == w - 1).sum())\n\n            # Keep only holes that open to the bar bbox boundary.\n            if top + bottom + left + right == 0:\n                continue\n\n            hole_gl = set((bar_r0 + int(rr), bar_c0 + int(cc)) for rr, cc in pts)\n\n            # Axis is determined by which bbox side has the widest mouth.\n            side, mouth_n = max(\n                [(name, cnt) for name, cnt in [(\"top\", top), (\"bottom\", bottom), (\"left\", left), (\"right\", right)] if cnt > 0],\n                key=lambda x: x[1],\n            )\n            axis = \"cols\" if side in (\"top\", \"bottom\") else \"rows\"\n            notches.append({\"axis\": axis, \"hole\": hole_gl, \"mouth_n\": mouth_n})\n        return notches\n\n    notches = bar_notches(bar_mask, bar_r0, bar_c0)\n\n    def pixels(v, top, left):\n        return set((top + lr, left + lc) for lr, lc in v[\"rel\"])\n\n    def placement_pts(v, top, left, occ, must_cover=None, strip=None):\n        if top < 0 or left < 0 or top + v[\"h\"] > H or left + v[\"w\"] > W:\n            return None\n        if strip is not None:\n            axis, A, B = strip\n            if axis == \"cols\":\n                if left != A or v[\"w\"] != B - A + 1:\n                    return None\n            else:\n                if top != A or v[\"h\"] != B - A + 1:\n                    return None\n        pts = pixels(v, top, left)\n        if pts & occ:\n            return None\n        if must_cover is not None and not (must_cover <= pts):\n            return None\n        return pts\n\n    def aligned_positions(axis, A, cover, v):\n        if axis == \"cols\":\n            left = A\n            tops = set()\n            for rN, cN in cover:\n                for lr, lc in v[\"rel\"]:\n                    if cN == left + lc:\n                        tops.add(rN - lr)\n            for top in tops:\n                yield top, left\n        else:\n            top = A\n            lefts = set()\n            for rN, cN in cover:\n                for lr, lc in v[\"rel\"]:\n                    if rN == top + lr:\n                        lefts.add(cN - lc)\n            for left in lefts:\n                yield top, left\n\n    def touches(pts, other):\n        for r, c in pts:\n            for dr, dc in DIR4:\n                if (r + dr, c + dc) in other:\n                    return True\n        return False\n\n    def hole_positions(hole, v):\n        pos = set()\n        for rH, cH in hole:\n            for lr, lc in v[\"rel\"]:\n                pos.add((rH - lr, cH - lc))\n        return pos\n\n    # Root candidates: fill the bar hole (no strip constraint yet).\n    root_cands = []\n    for ni, n in enumerate(notches):\n        axis = n[\"axis\"]\n\n        for pi, p in enumerate(pieces):\n            v = p[\"shape\"]\n            for top, left in hole_positions(n[\"hole\"], v):\n                pts = placement_pts(v, top, left, bar_occ, must_cover=n[\"hole\"])\n                if pts is None:\n                    continue\n                if axis == \"cols\":\n                    A, B = int(left), int(left + v[\"w\"] - 1)\n                else:\n                    A, B = int(top), int(top + v[\"h\"] - 1)\n                mv = abs(int(top) - int(p[\"orig\"][0])) + abs(int(left) - int(p[\"orig\"][1]))\n                root_cands.append(\n                    (\n                        (int(mv), -int(n[\"mouth_n\"])),\n                        {\"ni\": ni, \"pi\": pi, \"top\": int(top), \"left\": int(left), \"axis\": axis, \"A\": A, \"B\": B, \"shape\": v},\n                    )\n                )\n\n    root_cands.sort(key=lambda x: x[0])\n    cand_roots = [pair[1] for pair in root_cands[:20]]\n\n    best_out = out.copy()\n    best_key = None\n\n    def search(out_grid, occ_set, chains, remaining):\n        nonlocal best_out, best_key\n        placed_cnt = len(pieces) - len(remaining)\n        key = (placed_cnt, -len(remaining), -len(occ_set))\n        if best_key is None or key > best_key:\n            best_key = key\n            best_out = out_grid.copy()\n        if not remaining:\n            return True\n\n        def gen_extend_moves(chain, remaining_set):\n            axis = chain[\"axis\"]\n            A, B = int(chain[\"A\"]), int(chain[\"B\"])\n            head = chain[\"head\"]\n            head_pts = pixels(head[\"shape\"], head[\"top\"], head[\"left\"])\n            head_top, head_left = int(head[\"top\"]), int(head[\"left\"])\n            head_h, head_w = int(head[\"shape\"][\"h\"]), int(head[\"shape\"][\"w\"])\n\n            cavity = {\n                (r, c)\n                for r in range(head_top, head_top + head_h)\n                for c in range(head_left, head_left + head_w)\n                if out_grid[r, c] == bg\n            }\n            if not cavity:\n                return []\n\n            moves = []\n            for pi in remaining_set:\n                v = pieces[pi][\"shape\"]\n                for top, left in aligned_positions(axis, A, cavity, v):\n                    pts = placement_pts(v, top, left, occ_set, must_cover=cavity, strip=(axis, A, B))\n                    if pts is None:\n                        continue\n                    if not touches(pts, head_pts):\n                        continue\n                    moves.append((pi, top, left, pts, v))\n            return moves\n\n        # Try extending any chain.\n        for ch in chains:\n            moves = gen_extend_moves(ch, remaining)\n            if not moves:\n                continue\n            # small branching factor is enough for this puzzle\n            for pi, top, left, pts, v in moves[:8]:\n                # apply\n                for r, c in pts:\n                    out_grid[r, c] = int(pieces[pi][\"color\"])\n                old_head = ch[\"head\"]\n                ch[\"head\"] = {\"top\": int(top), \"left\": int(left), \"shape\": v}\n                occ2 = set(occ_set) | set(pts)\n                rem2 = set(remaining)\n                rem2.remove(pi)\n                if search(out_grid, occ2, chains, rem2):\n                    return True\n                # undo\n                ch[\"head\"] = old_head\n                for r, c in pts:\n                    out_grid[r, c] = int(bg)\n                # restore bar pixels (roots are always non-overlapping)\n                for r, c in bar_occ:\n                    out_grid[r, c] = bar_color\n        return False\n\n    # Try small root subsets (1..3) from top candidates.\n    from itertools import combinations\n\n    for k in range(1, min(3, len(cand_roots)) + 1):\n        for roots_sel in combinations(range(len(cand_roots)), k):\n            used_p = set()\n            used_n = set()\n            occ0 = set(bar_occ)\n            out0 = np.full((H, W), int(bg), dtype=int)\n            for r, c in bar_occ:\n                out0[r, c] = bar_color\n\n            chains = []\n            ok = True\n            for idx in roots_sel:\n                root = cand_roots[idx]\n                if root[\"pi\"] in used_p or root[\"ni\"] in used_n:\n                    ok = False\n                    break\n                pts = pixels(root[\"shape\"], root[\"top\"], root[\"left\"])\n                if pts & occ0:\n                    ok = False\n                    break\n                used_p.add(root[\"pi\"])\n                used_n.add(root[\"ni\"])\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/3bd292e8.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import defaultdict, deque\n\nimport numpy as np\n\nfrom arc_utils import Color, get_bg, label_mask, neighbors4\nimport itertools\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor wall-separated background regions alternately, starting with grey in the lower-left region.\n\n    Input structure\n    - The grid has one dominant background color and one foreground wall color.\n    - The wall pixels form one or more 4-connected one-cell-thick segments.\n    - Each wall segment separates exactly two 4-connected background regions.\n    Rule\n    - Keep all wall pixels unchanged.\n    - Label the 4-connected background regions and connect two labels when they\n      touch opposite sides of the same wall segment.\n    - Color the region containing the lower-left corner grey, then flip between\n      grey and green across every wall adjacency.\n    Key insight\n    - The red walls define a bipartite map of regions; the lower-left background\n      region fixes which side of the alternating coloring is grey.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    H, W = g.shape\n\n    colors = set(map(int, g.flat))\n    assert len(colors) == 2, \"expected exactly one background color and one wall color\"\n    bg = get_bg(g)\n    wall_colors = colors - {int(bg)}\n    assert len(wall_colors) == 1\n    wall = int(next(iter(wall_colors)))\n\n    bg_lab, n_regions = label_mask(g == int(bg), connectivity=4)\n    assert n_regions >= 2, \"walls must split the background into multiple regions\"\n    start_region = int(bg_lab[H - 1, 0])\n    assert start_region > 0, \"lower-left corner must belong to a background region\"\n\n    wall_lab, n_walls = label_mask(g == wall, connectivity=4)\n    assert n_walls >= 1\n\n    graph: dict[int, set[int]] = defaultdict(set)\n    for wall_id in range(1, n_walls + 1):\n        adjacent_regions: set[int] = set()\n        for r, c in np.argwhere(wall_lab == wall_id):\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W:\n                    region_id = int(bg_lab[rr, cc])\n                    if region_id > 0:\n                        adjacent_regions.add(region_id)\n\n        assert len(adjacent_regions) == 2, \"each wall segment must separate exactly two regions\"\n        a, b = tuple(adjacent_regions)\n        graph[a].add(b)\n        graph[b].add(a)\n\n    parity = {start_region: 0}\n    queue = deque([start_region])\n    while queue:\n        region = queue.popleft()\n        for neighbor in graph[region]:\n            neighbor_parity = 1 - parity[region]\n            if neighbor in parity:\n                assert parity[neighbor] == neighbor_parity, \"region graph must be bipartite\"\n            else:\n                parity[neighbor] = neighbor_parity\n                queue.append(neighbor)\n\n    assert set(parity) == set(range(1, n_regions + 1)), \"all background regions must be wall-connected\"\n\n    out = g.copy()\n    for region_id, region_parity in parity.items():\n        out[bg_lab == region_id] = Color.GREY if region_parity == 0 else Color.GREEN\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Grid, colors, and retry policy.\nGRID_SIZES = (7, 8, 9)\nGRID_SIZES_FOR_THREE_WALLS = (8, 9)\nWALL_COUNT_RANGE = (1, 3)\nMAX_GENERATION_ATTEMPTS = 300\nBACKGROUND_COLOR = Color.ORANGE\nWALL_COLOR = Color.RED\n\n# Wall geometry constraints.\nWALL_LENGTH_RANGE = (4, 13)\nWALL_TURN_RANGE = (1, 5)\nENDPOINT_SPACING = 2\nMAX_STAIR_PARTS = 3\nMIN_FIRST_STAIR_COL = 1\n\n# Left-right corridor layout.\nLR_LAYOUT_MAX_WALLS = 2\nLR_LAYOUT_PROBABILITY = 0.55\nLR_TURN_OPTIONS = (2, 4)\nLR_CORRIDOR_MAX_SPAN = 3\nLR_CORRIDOR_GAP = 2\n\n# Canonical grids are randomly mapped through one of eight dihedral transforms.\nTRANSFORM_OPS = 8\n\n\ndef _contains(bounds: tuple[int, int], value: int) -> bool:\n    lo, hi = bounds\n    return lo <= int(value) <= hi\n\n\ndef _paint_wall_path(grid: np.ndarray, cells: list[tuple[int, int]]) -> bool:\n    for r, c in cells:\n        if grid[r, c] != BACKGROUND_COLOR:\n            return False\n        grid[r, c] = WALL_COLOR\n    return True\n\n\ndef _split_positive(total: int, parts: int) -> list[int]:\n    if parts == 1:\n        return [int(total)]\n    cuts = sorted(random.sample(range(1, int(total)), int(parts) - 1))\n    return [b - a for a, b in zip([0] + cuts, cuts + [int(total)])]\n\n\ndef _spaced_combos(values: list[int], n: int) -> list[tuple[int, ...]]:\n    return [\n        combo\n        for combo in itertools.combinations(values, n)\n        if all(combo[i + 1] - combo[i] >= ENDPOINT_SPACING for i in range(len(combo) - 1))\n    ]\n\n\ndef _choose_endpoints(H: int, W: int, n_walls: int) -> tuple[tuple[int, ...], tuple[int, ...]] | None:\n    rows = _spaced_combos(list(range(1, H - 1)), n_walls)\n    cols = _spaced_combos(list(range(1, W - 1)), n_walls)\n    valid: list[tuple[tuple[int, ...], tuple[int, ...]]] = []\n    for start_rows in rows:\n        for cols_asc in cols:\n            end_cols = tuple(reversed(cols_asc))\n            lengths = [c + (H - 1 - r) + 1 for r, c in zip(start_rows, end_cols)]\n            if all(_contains(WALL_LENGTH_RANGE, length) for length in lengths):\n                valid.append((start_rows, end_cols))\n    return random.choice(valid) if valid else None\n\n\ndef _stair_path_lb(H: int, W: int, start_r: int, end_c: int, min_first_col: int) -> list[tuple[int, int]] | None:\n    down = H - 1 - int(start_r)\n    right = int(end_c)\n    max_parts = min(MAX_STAIR_PARTS, down, right)\n    feasible = [k for k in range(1, max_parts + 1) if right >= int(min_first_col) + k - 1]\n    if not feasible:\n        return None\n    weights = [k * k for k in feasible]\n    k = random.choices(feasible, weights=weights, k=1)[0]\n\n    if k == 1:\n        horiz = [right]\n    else:\n        first = random.randint(int(min_first_col), right - (k - 1))\n        horiz = [first] + _split_positive(right - first, k - 1)\n    vert = _split_positive(down, k)\n\n    r, c = int(start_r), 0\n    cells = [(r, c)]\n    for h_run, v_run in zip(horiz, vert):\n        for _ in range(h_run):\n            c += 1\n            cells.append((r, c))\n        for _ in range(v_run):\n            r += 1\n            cells.append((r, c))\n\n    if (r, c) != (H - 1, int(end_c)):\n        return None\n    return cells\n\n\ndef _build_lower_left_grid(H: int, W: int, n_walls: int) -> np.ndarray | None:\n    endpoints = _choose_endpoints(H, W, n_walls)\n    if endpoints is None:\n        return None\n    start_rows, end_cols = endpoints\n\n    grid = np.full((H, W), BACKGROUND_COLOR, dtype=int)\n    for i, (start_r, end_c) in enumerate(zip(start_rows, end_cols)):\n        min_first_col = end_cols[i + 1] + ENDPOINT_SPACING if i + 1 < n_walls else MIN_FIRST_STAIR_COL\n        cells = _stair_path_lb(H, W, start_r, end_c, min_first_col)\n        if cells is None or not _paint_wall_path(grid, cells):\n            return None\n    return grid\n\n\ndef _choose_lr_corridors(H: int, n_walls: int) -> tuple[tuple[int, int], ...] | None:\n    intervals = []\n    for lo in range(1, H - 2):\n        for hi in range(lo + 1, min(H - 2, lo + LR_CORRIDOR_MAX_SPAN) + 1):\n            intervals.append((lo, hi))\n    valid: list[tuple[tuple[int, int], ...]] = []\n    for combo in itertools.combinations(intervals, n_walls):\n        if all(combo[i][1] + LR_CORRIDOR_GAP <= combo[i + 1][0] for i in range(n_walls - 1)):\n            valid.append(combo)\n    return random.choice(valid) if valid else None\n\n\ndef _lr_path(W: int, lo: int, hi: int) -> list[tuple[int, int]] | None:\n    short_turn, long_turn = LR_TURN_OPTIONS\n    turn_goal = random.choice(LR_TURN_OPTIONS)\n    if turn_goal == long_turn and W - 1 < long_turn:\n        turn_goal = short_turn\n\n    if turn_goal == short_turn:\n        h1 = random.randint(1, W - 2)\n        horiz = [h1, W - 1 - h1]\n        r0, r1 = random.sample(range(lo, hi + 1), 2)\n        rows = [r0, r1]\n    else:\n        if hi - lo >= 2:\n            if random.random() < 0.5:\n                rows = [lo, random.randint(lo + 1, hi - 1), hi]\n            else:\n                rows = [hi, random.randint(lo + 1, hi - 1), lo]\n            middle_min = 1\n        else:\n            rows = [lo, hi, lo] if random.random() < 0.5 else [hi, lo, hi]\n            middle_min = 2\n        if W - 1 < middle_min + 2:\n            return None\n        h2 = random.randint(middle_min, W - 3)\n        h1 = random.randint(1, W - 1 - h2 - 1)\n        horiz = [h1, h2, W - 1 - h1 - h2]\n\n    r, c = int(rows[0]), 0\n    cells = [(r, c)]\n    for i, h_run in enumerate(horiz):\n        for _ in range(h_run):\n            c += 1\n            cells.append((r, c))\n        if i < len(rows) - 1:\n            target = int(rows[i + 1])\n            step = 1 if target > r else -1\n            while r != target:\n                r += step\n                cells.append((r, c))\n\n    if c != W - 1:\n        return None\n    if not _contains(WALL_LENGTH_RANGE, len(cells)):\n        return None\n    return cells\n\n\ndef _build_lr_grid(H: int, W: int, n_walls: int) -> np.ndarray | None:\n    corridors = _choose_lr_corridors(H, n_walls)\n    if corridors is None:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport random\nimport numpy as np\nfrom scipy.ndimage import label as scipy_label\nfrom arc_utils import bbox_h, bbox_w, find_components, in_bounds, neighbors4, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n\n\ndef _bfs_placement(feasible, sr, sc):\n    h2, w2 = feasible.shape\n    dist = -np.ones((h2, w2), dtype=int)\n    dist[sr, sc] = 0\n    q = deque([(sr, sc)])\n    while q:\n        r, c = q.popleft()\n        for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:\n                dist[rr, cc] = dist[r, c] + 1\n                q.append((rr, cc))\n    return dist\n\n\ndef _hamiltonian_walk(rows, cols, start, end):\n    total = rows * cols\n    best_path = None\n    best_len = 0\n    for _attempt in range(80):\n        visited = {start}\n        path = [start]\n        cur = start\n        while True:\n            if cur == end and len(path) >= total * 0.7:\n                if len(path) > best_len:\n                    best_path = list(path)\n                    best_len = len(path)\n                break\n            neighbors = []\n            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                nr, nc = cur[0] + dr, cur[1] + dc\n                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:\n                    neighbors.append((nr, nc))\n            if not neighbors:\n                break\n            valid = []\n            for nb in neighbors:\n                if nb == end:\n                    valid.append(nb)\n                    continue\n                test_visited = visited | {nb}\n                seen = {end}\n                q = deque([end])\n                while q:\n                    cr, cc = q.popleft()\n                    for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                        nr2, nc2 = cr + dr2, cc + dc2\n                        if (0 <= nr2 < rows and 0 <= nc2 < cols and\n                                (nr2, nc2) not in test_visited and (nr2, nc2) not in seen):\n                            seen.add((nr2, nc2))\n                            q.append((nr2, nc2))\n                for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                    ar, ac = nb[0] + dr2, nb[1] + dc2\n                    if (0 <= ar < rows and 0 <= ac < cols and\n                            (ar, ac) not in test_visited and (ar, ac) in seen):\n                        valid.append(nb)\n                        break\n            if not valid:\n                break\n            random.shuffle(valid)\n            nxt = valid[0]\n            visited.add(nxt)\n            path.append(nxt)\n            cur = nxt\n        if best_path and best_len >= total * 0.85:\n            break\n    return best_path\n\n\ndef _render_channel(grid, path, n, offsets_r, offsets_c):\n    pixel_pos = []\n    for cr, cc in path:\n        pr, pc = offsets_r[cr], offsets_c[cc]\n        pixel_pos.append((pr, pc))\n        grid[pr:pr + n, pc:pc + n] = _RIVER\n    for i in range(len(path) - 1):\n        pr1, pc1 = pixel_pos[i]\n        pr2, pc2 = pixel_pos[i + 1]\n        if pr1 == pr2:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n            grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER\n        else:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n            grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER\n    return pixel_pos\n\n\ndef _add_chokepoint(grid, pixel_pos_i, pixel_pos_j, n, direction):\n    H, W = grid.shape\n    pr1, pc1 = pixel_pos_i\n    pr2, pc2 = pixel_pos_j\n    narrow_w = random.randint(1, n - 1)\n    remove = n - narrow_w\n    side = random.randint(0, 1)\n\n    if direction == 'h':\n        c_lo = min(pc1, pc2) + n\n        c_hi = max(pc1, pc2)\n        if c_hi <= c_lo:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        c_mid = (c_lo + c_hi) // 2\n        c_start = max(c_lo, c_mid - total_len // 2)\n        for step in range(total_len):\n            c = c_start + step\n            if c < 0 or c >= W:\n                continue\n            if step < remove:\n                depth = step + 1\n            elif step >= total_len - remove:\n                depth = total_len - step\n            else:\n                depth = remove\n            for k in range(depth):\n                rr = pr1 + k if side == 0 else pr1 + n - 1 - k\n                if 0 <= rr < H and 0 <= c < W:\n                    grid[rr, c] = _BG\n    else:\n        r_lo = min(pr1, pr2) + n\n        r_hi = max(pr1, pr2)\n        if r_hi <= r_lo:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        r_mid = (r_lo + r_hi) // 2\n        r_start = max(r_lo, r_mid - total_len // 2)\n        for step in range(total_len):\n            r = r_start + step\n            if r < 0 or r >= H:\n                continue\n            if step < remove:\n","exit_code":0,"status":"completed"}}
