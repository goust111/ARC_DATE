 connectivity=4, monochromatic=True):\n        if _is_full_grid_frame(component, g.shape):\n            continue\n        sprites.append((int(component[\"area\"]), _component_sprite(component, bg)))\n\n    assert sprites\n    areas = [area for area, _sprite in sprites]\n    assert len(areas) == len(set(areas))\n\n    out = np.full_like(g, bg)\n    c = 0\n    for _area, sprite in sorted(sprites, key=lambda item: item[0]):\n        h, w = sprite.shape\n        assert h <= H and c + w <= W\n        paste(out, sprite, H - h, c, transparent=bg)\n        c += w\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\nBG = 7\nALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n\n# Canvas and sprite bounds.\nGRID_HEIGHT, GRID_WIDTH = 10, 10\nSPRITE_MIN_AREA, SPRITE_MAX_AREA = 1, 12\nSPRITE_MAX_HEIGHT, SPRITE_MAX_WIDTH = 6, 4\nMIN_SPRITE_DENSITY = 0.5\n\n# Sprite sampling and validation.\nSPRITE_COUNT_CHOICES = [3, 4]\nSPRITE_CONNECTIVITY = 4\nSPRITE_SYMMETRY = 'not_symmetric'\nSPRITE_RETRY_LIMIT = 20\n\n# Frame, placement, and generation retries.\nFRAME_PROBABILITY = 0.3\nFRAME_BORDER, NO_FRAME_BORDER = 1, 0\nGENERATION_RETRY_LIMIT = 300\n\nVALID_SPRITE_SHAPES = {\n    area: [(h, w) for h in range(1, SPRITE_MAX_HEIGHT + 1)\n           for w in range(1, SPRITE_MAX_WIDTH + 1)\n           if h * w >= area and area / (h * w) >= MIN_SPRITE_DENSITY]\n    for area in range(SPRITE_MIN_AREA, SPRITE_MAX_AREA + 1)\n}\n\n================================================================================\ndef generate_input():\n    for _ in range(GENERATION_RETRY_LIMIT):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRY_LIMIT} attempts\")\n\n================================================================================\nFILE: /home/lixinyu/snap/new/ARC_code/train/42f83767.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Expand the lower color grid by replacing each pixel with its matching top stencil.\n\n    Input structure\n    The input has a top legend and a lower dense color grid, separated by blank rows.\n    The legend contains left-to-right 2x2 color swatches and, to their right,\n    the same number of square neutral-color stencil masks.\n\n    Rule\n    Pair the swatches and stencil masks by left-to-right order. For every pixel in\n    the lower color grid, paste the paired stencil mask as one output block,\n    recoloring the mask pixels with that pixel's color and leaving mask holes as bg.\n\n    Key insight\n    The lower grid is not copied directly; it is an index grid whose colors select\n    the stencil shape from the legend, so each input pixel becomes one square block.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    row_runs = _runs(np.any(g != bg, axis=1))\n    assert len(row_runs) == 2\n    (top_r0, top_r1), (pattern_r0, pattern_r1) = row_runs\n    assert top_r0 == 0\n\n    stencil_size = top_r1 - top_r0 + 1\n    top = g[top_r0 : top_r1 + 1, :]\n    lower = g[pattern_r0 : pattern_r1 + 1, :]\n\n    pattern_box = bbox(lower != bg)\n    assert pattern_box is not None\n    pr0, pc0, pr1, pc1 = pattern_box\n    assert pr0 == 0 and pr1 == lower.shape[0] - 1\n    pattern = lower[:, pc0 : pc1 + 1]\n    assert np.all(pattern != bg)\n    pattern_colors = set(map(int, np.unique(pattern)))\n\n    top_colors = set(map(int, np.unique(top))) - {bg}\n    neutral_colors = top_colors - pattern_colors\n    assert len(neutral_colors) == 1\n    neutral = next(iter(neutral_colors))\n\n    swatches = []\n    for comp in find_components(top, bg=bg, colors=pattern_colors):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert comp[\"area\"] == 4\n        assert r1 - r0 + 1 == 2\n        assert c1 - c0 + 1 == 2\n        swatches.append((c0, int(comp[\"color\"])))\n    assert len(swatches) == len(pattern_colors)\n    assert len({c0 for c0, _color in swatches}) == len(swatches)\n\n    swatch_colors = [color for _c0, color in sorted(swatches)]\n    assert set(swatch_colors) == pattern_colors\n\n    stencil_col_runs = _runs(np.any(top == neutral, axis=0))\n    assert len(stencil_col_runs) == len(swatch_colors)\n\n    stencils = {}\n    for color, (c0, c1) in zip(swatch_colors, stencil_col_runs):\n        assert c1 - c0 + 1 == stencil_size\n        mask = top[:, c0 : c1 + 1] == neutral\n        assert mask.shape == (stencil_size, stencil_size)\n        assert np.any(mask)\n        stencils[color] = mask\n\n    h, w = pattern.shape\n    out = np.full((h * stencil_size, w * stencil_size), bg, dtype=int)\n    for r in range(h):\n        for c in range(w):\n            color = int(pattern[r, c])\n            assert color in stencils\n            block = out[\n                r * stencil_size : (r + 1) * stencil_size,\n                c * stencil_size : (c + 1) * stencil_size,\n            ]\n            block[stencils[color]] = color\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and legend geometry.\nBACKGROUND, NEUTRAL_COLOR, INPUT_ROWS = 0, 5, 15\nSWATCH_SIZE, SWATCH_STRIDE, STENCIL_GAP = 2, 3, 1\n\n# Structural size and palette bounds.\nCOLOR_COUNT_RANGE = (2, 4)\nSTENCIL_SIZE_RANGE, PATTERN_SIDE_RANGE = range(3, 7), range(4, 8)\nMAX_OUTPUT_SIDE, AVAILABLE_COLORS = 30, [1, 2, 3, 4, 6, 7, 8, 9]\nVALID_SIZE_PAIRS = [(s, p) for s in STENCIL_SIZE_RANGE for p in PATTERN_SIDE_RANGE if s * p <= MAX_OUTPUT_SIDE]\n\n# Stencil, pattern, and retry sampling.\nSTENCIL_FILL_RANGE = (0.60, 0.89)\nUNIQUE_STENCIL_RETRIES, GENERATION_RETRIES = 80, 300\nGAP_ROWS_RANGE = (1, 3)\nPATTERN_MODES = [\"iid\", \"rows\", \"cols\", \"checker\", \"tile\"]\nTILE_SIDE_RANGE = (2, 3)\n\n================================================================================\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 42f83767 input\")\n\n================================================================================\nFILE: /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect framed squares via colored bridges following a control-pixel sequence.\n\n    Input structure:\n    - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.\n    - Control row below squares: colored pixels read left-to-right encode visitation order.\n\n    Rule:\n    - Start at the square matching first control color c0.\n    - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.\n    - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.\n\n    Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # border color = most common non-bg color\n    cnt = Counter(map(int, g.flatten()))\n    border = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            border = int(col)\n            break\n    assert not (border is None)\n\n    # detect framed squares as connected components of the border color\n    lab, n = label_mask(g == int(border), connectivity=4)\n    frames: list[dict] = []\n    for cid in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(cid))\n        if int(pts.shape[0]) < 8:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        if h < 3 or w < 3:\n            continue\n\n        t = None\n        inner_col = None\n        for tt in range(1, int(min(h, w) // 2) + 1):\n            inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]\n            if inner.size == 0:\n                continue\n            if bool((inner == int(border)).any()):\n                continue\n            u = set(map(int, inner.flatten()))\n            if len(u) != 1:\n                continue\n\n            ok = True\n            if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not ok:\n                continue\n\n            t = int(tt)\n            inner_col = int(next(iter(u)))\n            break\n\n        if t is None or inner_col is None:\n            continue\n\n        frames.append(\n            {\n                \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n                \"t\": int(t),\n                \"inner\": int(inner_col),\n                \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            }\n        )\n\n    assert not (not frames)\n\n    by: dict[int, list[dict]] = defaultdict(list)\n    for f in frames:\n        by[int(f[\"inner\"])].append(f)\n\n    max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n\n    # control row = bottom-most row below the squares with >=2 non-bg pixels\n    ctrl_r = None\n    for r in range(int(H - 1), int(max_frame_r), -1):\n        if int((g[int(r)] != int(bg)).sum()) >= 2:\n            ctrl_r = int(r)\n            break\n    assert not (ctrl_r is None)\n\n    ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n    assert not (len(ctrl) < 2)\n\n    def center(f: dict) -> tuple[int, int]:\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        return int((r0 + r1) // 2), int((c0 + c1) // 2)\n\n    def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n        a = f1[\"inner_bbox\"]\n        b = f2[\"inner_bbox\"]\n        same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n        same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))\n        return same_row, same_col\n\n    # choose start frame\n    start_color = int(ctrl[0])\n    assert not (start_color not in by)\n    start_cands = by[start_color]\n    if len(start_cands) == 1:\n        cur = start_cands[0]\n    else:\n        nxt_color = int(ctrl[1])\n        nxt_cands = by.get(nxt_color, [])\n        best = None\n        bestf = None\n        for f in start_cands:\n            for g2 in (nxt_cands if nxt_cands else [f]):\n                sr, sc = aligned(f, g2)\n                al = 1 if (sr or sc) else 0\n                (r1_, c1_) = center(f)\n                (r2_, c2_) = center(g2)\n                d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n                cand = (int(al), -int(d))\n                if best is None or cand > best:\n                    best = cand\n                    bestf = f\n        cur = bestf\n\n    out = g.copy()\n\n    def draw_bridge(fa: dict, fb: dict, color: int) -> None:\n        (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n        (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n        ia = fa[\"inner_bbox\"]\n        sr, sc = aligned(fa, fb)\n        if sr:\n            rr0, rr1 = int(ia[0]), int(ia[2])\n            if int(c1a) < int(c0b):\n                cc0, cc1 = int(c1a + 1), int(c0b - 1)\n            else:\n                cc0, cc1 = int(c1b + 1), int(c0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n            return\n        if sc:\n            cc0, cc1 = int(ia[1]), int(ia[3])\n            if int(r1a) < int(r0b):\n                rr0, rr1 = int(r1a + 1), int(r0b - 1)\n            else:\n                rr0, rr1 = int(r1b + 1), int(r0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n\n    for i in range(int(len(ctrl)) - 1):\n        a = int(ctrl[i])\n        b = int(ctrl[i + 1])\n        assert int(cur[\"inner\"]) == int(a)\n        assert b in by, f\"control color {b} has no matching frame\"\n        cands = by[b]\n        best = None\n        bestf = None\n        for f in cands:\n            sr, sc = aligned(cur, f)\n            al = 1 if (sr or sc) else 0\n            (r1_, c1_) = center(cur)\n            (r2_, c2_) = center(f)\n            d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n            cand = (int(al), -int(d))\n            if best is None or cand > best:\n                best = cand\n                bestf = f\n        nxt = bestf\n        draw_bridge(cur, nxt, int(a))\n        cur = nxt\n\n    return out\n\n================================================================================\ndef generate_input() -> np.ndarray:\n    for _ in range(500):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after 500 attempts\")\n\n================================================================================\nFILE: /home/lixinyu/snap/new/ARC_code/train/8abad3cf.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Repack each non-background color group as a solid square ordered by increasing size.\n\n    Input structure\n    The grid has one dominant background color, and each other color has a\n    perfect-square pixel count. Those square side lengths are unique.\n\n    Rule\n    Convert every non-background color into a filled square whose side length is\n    the square root of its pixel count. Place the squares from left to right in\n    increasing side length, bottom-aligned, with one background column between\n    neighboring squares.\n\n    Key insight\n    The original geometry of each color is discarded; only the color's total\n    pixel count determines the size of its packed output square.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    specs: list[tuple[int, int]] = []\n    for color in colors_present(g, exclude={bg}):\n        count = int(np.count_nonzero(g == color))\n        side = math.isqrt(count)\n        assert side * side == count\n        specs.append((color, side))\n\n    assert specs\n    sides = [side for _color, side in specs]\n    assert len(set(sides)) == len(sides)\n\n    ordered = sorted(specs, key=lambda item: item[1])\n    height = max(side for _color, side in ordered)\n    width = sum(side for _color, side in ordered) + len(ordered) - 1\n    out = np.full((height, width), bg, dtype=int)\n\n    col = 0\n    for i, (color, side) in enumerate(ordered):\n        out[height - side : height, col : col + side] = color\n        col += side\n        if i != len(ordered) - 1:\n            col += 1\n\n    assert col == width\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Fixed task palette/background.\nBG_COLOR = 7\nALL_COLORS = range(10)\n\n# Color-group structure.\nCOLOR_COUNTS = [2, 3]\nSIDE_LENGTHS = range(1, 6)\n\n# Input canvas and density bounds.\nROW_RANGE = range(5, 8)\nCOL_RANGE = range(4, 11)\nMIN_BG_FRACTION = 0.42\nMAX_BG_FRACTION = 0.58\n\n# Retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n================================================================================\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n\n================================================================================\nFILE: /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n================================================================================\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\n================================================================================\nFILE: /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n================================================================================\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 581f7754 input\")\n\n================================================================================\nFILE: /home/lixinyu/snap/new/ARC_code/eval/2ba387bc.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Sort scattered 4×4 squares into two columns by type: frames left, solids right.\n\n    Input structure:\n    - bg = most common color. Multiple 4×4 objects on bg.\n    - Frames: colored 1px border, bg-filled 2×2 interior.\n    - Solids: entirely filled with one non-bg color.\n\n    Rule:\n    - Classify each 4×4 object as frame or solid by its interior.\n    - Sort each group top-to-bottom by input row.\n    - Stack frames in left column (cols 0–3), solids in right (cols 4–7).\n    - Output is 8 wide; height = 4 × max(#frames, #solids), bg-padded.\n\n    Key insight: Frame vs solid is determined solely by whether the 2×2 interior matches bg.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n    frames: list[tuple[int, int, np.ndarray]] = []\n    solids: list[tuple[int, int, np.ndarray]] = []\n\n    for comp in comps:\n        b = comp[\"bbox\"]\n        if bbox_h(b) != 4 or bbox_w(b) != 4:\n            continue\n        r0, c0, _r1, _c1 = b\n        sub = crop_bbox(g, b)\n\n        border = np.concatenate([sub[0, :], sub[-1, :], sub[1:-1, 0], sub[1:-1, -1]])\n        bcols = set(map(int, border.flatten()))\n\n        if len(bcols) == 1 and bool((sub[1:3, 1:3] == int(bg)).all()):\n            frames.append((int(r0), int(c0), sub))\n        else:\n            solids.append((int(r0), int(c0), sub))\n\n    frames.sort(key=lambda t: (int(t[0]), int(t[1])))\n    solids.sort(key=lambda t: (int(t[0]), int(t[1])))\n\n    outH = 4 * max(int(len(frames)), int(len(solids)))\n    outW = 8\n    out = np.full((outH, outW), int(bg), dtype=int)\n\n    for i, (_r0, _c0, sub) in enumerate(frames):\n        paste(out, sub, int(i * 4), 0)\n    for i, (_r0, _c0, sub) in enumerate(solids):\n        paste(out, sub, int(i * 4), 4)\n\n    return out\n\n================================================================================\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input failed after 300 attempts\")\n\n================================================================================\nFILE: /home/lixinyu/snap/new/ARC_code/eval/7c66cb00.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Dock two-tone sprites into color-matched horizontal bars with a color swap.\n\n    Input structure:\n    - bg = most common color.\n    - Top area: small two-tone sprites (outer color + inner color).\n    - Below: horizontal bars spanning most of the row, each with a fill color and border color on edges.\n\n    Rule:\n    - Match each sprite to the bar whose fill color equals the sprite's outer color.\n    - Place the sprite at its original x-position, aligned to the bar's bottom.\n    - Recolor: sprite outer → bar border, sprite inner → bar fill.\n    - Erase original sprites from the top area.\n\n    Key insight: Color matching is inverted — the sprite's dominant color identifies its target bar, then gets swapped to the bar's accent color.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    out = g.copy()\n    bg = int(Counter(g.flatten()).most_common(1)[0][0])\n\n    # Find bars.\n    bars = []\n    current_bar = None\n    for r in range(H):\n        row = g[int(r), :]\n        non_bg = [int(v) for v in row if int(v) != int(bg)]\n        if non_bg:\n            c = Counter(non_bg)\n            fill_color, count = c.most_common(1)[0]\n            if int(count) > int(W * 0.7):\n                border = int(row[0]) if int(row[0]) != int(fill_color) else int(row[-1])\n                if current_bar and int(current_bar[\"fill\"]) == int(fill_color):\n                    current_bar[\"r_max\"] = int(r)\n                else:\n                    if current_bar:\n                        bars.append(current_bar)\n                    current_bar = {\"fill\": int(fill_color), \"border\": int(border), \"r_min\": int(r), \"r_max\": int(r)}\n            else:\n                if current_bar:\n                    bars.append(current_bar)\n                    current_bar = None\n        else:\n            if current_bar:\n                bars.append(current_bar)\n                current_bar = None\n    if current_bar:\n        bars.append(current_bar)\n\n    assert bars, \"No bars found — grid must contain at least one horizontal bar\"\n\n    pattern_area_end = int(min(int(b[\"r_min\"]) for b in bars))\n\n    # Find patterns in top area: monochrome components by color, but we need full bbox content.\n    patterns = []\n    top = g[:pattern_area_end, :]\n    for col in sorted(set(map(int, top.flatten())) - {int(bg)}):\n        mask = top == int(col)\n        if not bool(mask.any()):\n            continue\n        lab, n = label_mask(mask, connectivity=4)\n        for region_id in range(1, int(n) + 1):\n            coords = np.argwhere(lab == int(region_id))\n            if coords.size == 0:\n                continue\n            b = bbox_coords(coords)\n            r0, c0, r1, c1 = map(int, b)\n            bbox = crop_bbox(g, (r0, c0, r1, c1))\n\n            colors_in_bbox = Counter(map(int, bbox.flatten()))\n            colors_in_bbox.pop(int(bg), None)\n            if not colors_in_bbox:\n                continue\n            outer_color = int(colors_in_bbox.most_common(1)[0][0])\n            inner_colors = [int(c) for c in colors_in_bbox.keys() if int(c) != int(outer_color)]\n            inner_color = int(inner_colors[0]) if inner_colors else None\n\n            patterns.append(\n                {\n                    \"outer_color\": int(outer_color),\n                    \"inner_color\": inner_color,\n                    \"r0\": int(r0),\n                    \"c0\": int(c0),\n                    \"h\": int(bbox.shape[0]),\n                    \"w\": int(bbox.shape[1]),\n                    \"content\": bbox,\n                }\n            )\n\n    # Clear patterns from output.\n    out[:pattern_area_end, :] = np.where(out[:pattern_area_end, :] != int(bg), int(bg), out[:pattern_area_end, :])\n\n    # Match and place patterns.\n    for bar in bars:\n        matching = [p for p in patterns if int(p[\"outer_color\"]) == int(bar[\"fill\"])]\n        for pat in matching:\n            transformed = np.array(pat[\"content\"], dtype=int).copy()\n            for rr in range(int(pat[\"h\"])):\n                for cc in range(int(pat[\"w\"])):\n                    v = int(transformed[int(rr), int(cc)])\n                    if v == int(pat[\"outer_color\"]):\n                        transformed[int(rr), int(cc)] = int(bar[\"border\"])\n                    elif pat[\"inner_color\"] is not None and v == int(pat[\"inner_color\"]):\n                        transformed[int(rr), int(cc)] = int(bar[\"fill\"])\n\n            place_r = int(bar[\"r_max\"] - pat[\"h\"] + 1)\n            place_c = int(pat[\"c0\"])\n            paste(out, transformed, place_r, place_c, transparent=int(bg))\n\n    return out\n\n# --------------- generator (Codex attempt 2) ---------------\n\n# --- Configuration constants ---\nGRID_H = 30                   # canvas height\nGRID_W = 24                   # canvas width\nBAR_COUNT_RANGE = (2, 3)      # number of horizontal bars\nSPRITE_COUNT_RANGE = (2, 3)   # number of sprites above bars\nBAR_HEIGHT_RANGE = (4, 8)     # per-bar row height\nMAX_THREE_BAR_TOTAL = 20      # max total bar height when n_bars == 3\nMIN_TOP_AREA = 7              # minimum rows above first bar for sprite area\nSPRITE_H_RANGE = (2, 5)      # sprite height (clamped to bar height)\nSPRITE_W_RANGE = (2, 9)      # sprite width\nINNER_COLOR_PROB = 0.45       # probability of adding an inner-color region\nGEN_RETRIES = 300             # max attempts in generate_input()\n\n================================================================================\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"failed to generate a valid input after {GEN_RETRIES} attempts\")\n\n================================================================================\n","exit_code":0,"status":"completed"}}
