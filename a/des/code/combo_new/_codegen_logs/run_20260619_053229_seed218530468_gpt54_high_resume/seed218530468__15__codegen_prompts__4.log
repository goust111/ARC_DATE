{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/d968ffd4.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _is_solid_rect(g: np.ndarray, comp: dict) -> bool:\n    r0, c0, r1, c1 = comp[\"bbox\"]\n    h = r1 - r0 + 1\n    w = c1 - c0 + 1\n    return comp[\"area\"] == h * w and np.all(g[r0 : r1 + 1, c0 : c1 + 1] == comp[\"color\"])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Extend each of two aligned rectangular marker objects toward the other, filling half of the gap across the full perpendicular span.\n\n    Input structure\n    - A dominant background contains exactly two solid, same-sized monochromatic rectangles.\n    - The rectangles share either the same row span or the same column span, with a background gap between their facing edges.\n\n    Rule\n    - If the rectangles are side-by-side, color the left half of the inter-object gap across every row with the left object's color, and the right half with the right object's color.\n    - If one rectangle is above the other, color the upper half of the gap across every column with the upper object's color, and the lower half with the lower object's color.\n    - When the gap length is odd, leave the center row/column as background.\n\n    Key insight\n    - The marker objects are endpoints of an axial corridor; their own size identifies the facing edge, while the filled corridor spans the whole grid perpendicular to that axis.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(comps) == 2\n    assert all(_is_solid_rect(g, comp) for comp in comps)\n\n    a, b = comps\n    ar0, ac0, ar1, ac1 = a[\"bbox\"]\n    br0, bc0, br1, bc1 = b[\"bbox\"]\n    assert (ar1 - ar0, ac1 - ac0) == (br1 - br0, bc1 - bc0)\n\n    same_rows = (ar0, ar1) == (br0, br1)\n    same_cols = (ac0, ac1) == (bc0, bc1)\n    assert same_rows != same_cols\n\n    out = g.copy()\n    if same_rows:\n        left, right = sorted(comps, key=lambda comp: comp[\"bbox\"][1])\n        _lr0, _lc0, _lr1, lc1 = left[\"bbox\"]\n        _rr0, rc0, _rr1, _rc1 = right[\"bbox\"]\n        gap = rc0 - lc1 - 1\n        assert gap >= 1\n        span = gap // 2\n        out[:, lc1 + 1 : lc1 + 1 + span] = left[\"color\"]\n        out[:, rc0 - span : rc0] = right[\"color\"]\n    else:\n        top, bottom = sorted(comps, key=lambda comp: comp[\"bbox\"][0])\n        _tr0, _tc0, tr1, _tc1 = top[\"bbox\"]\n        br0, _bc0, _br1, _bc1 = bottom[\"bbox\"]\n        gap = br0 - tr1 - 1\n        assert gap >= 1\n        span = gap // 2\n        out[tr1 + 1 : tr1 + 1 + span, :] = top[\"color\"]\n        out[br0 - span : br0, :] = bottom[\"color\"]\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Layout ranges and bounds.\nALIGNMENTS = (\"H\", \"V\")\nRECT_PERP_BOUNDS = (1, 4)\nRECT_AXIAL_VALUES = range(1, 3)\nGAP_VALUES = range(6, 17)\nAXIAL_BOUNDS = (14, 22)\nMARGIN = 1\nPALETTE = tuple(range(10))\nMAX_GENERATION_ATTEMPTS = 300\nVALID_AXIAL_GAP_PAIRS = tuple(\n    (rect_axial, gap)\n    for rect_axial in RECT_AXIAL_VALUES\n    for gap in GAP_VALUES\n    if AXIAL_BOUNDS[0] <= 2 * rect_axial + gap + 2 * MARGIN <= AXIAL_BOUNDS[1]\n)\n\n\ndef _choose_layout() -> tuple[str, int, int, int]:\n    alignment = random.choice(ALIGNMENTS)\n    rect_perp = random.randint(*RECT_PERP_BOUNDS)\n    rect_axial, gap = random.choice(VALID_AXIAL_GAP_PAIRS)\n    return alignment, rect_perp, rect_axial, gap\n\n\ndef _choose_colors() -> tuple[int, int, int]:\n    bg = random.choice(PALETTE)\n    color_a, color_b = random.sample([color for color in PALETTE if color != bg], 2)\n    return bg, color_a, color_b\n\n\ndef _render_horizontal(rect_perp: int, rect_axial: int, gap: int, bg: int, color_a: int, color_b: int) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Build the horizontal input/output pair; vertical cases are its transpose.\"\"\"\n    perp = rect_perp + 2 * MARGIN\n    axial = 2 * rect_axial + gap + 2 * MARGIN\n    left_c0 = MARGIN\n    left_c1 = left_c0 + rect_axial - 1\n    right_c1 = axial - MARGIN - 1\n    right_c0 = right_c1 - rect_axial + 1\n    row0 = MARGIN\n    row1 = row0 + rect_perp - 1\n\n    out = np.full((perp, axial), bg, dtype=int)\n    out[row0 : row1 + 1, left_c0 : left_c1 + 1] = color_a\n    out[row0 : row1 + 1, right_c0 : right_c1 + 1] = color_b\n\n    span = gap // 2\n    out[:, left_c1 + 1 : left_c1 + 1 + span] = color_a\n    out[:, right_c0 - span : right_c0] = color_b\n\n    inp = out.copy()\n    inp[:, left_c1 + 1 : right_c0] = bg\n    return inp, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    alignment, rect_perp, rect_axial, gap = _choose_layout()\n    bg, color_a, color_b = _choose_colors()\n    inp, out = _render_horizontal(rect_perp, rect_axial, gap, bg, color_a, color_b)\n    if alignment == \"V\":\n        inp = inp.T.copy()\n        out = out.T.copy()\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid d968ffd4 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/136b0064.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg\nimport random\n\n\ndef find_full_height_constant_col(grid: np.ndarray, *, bg: int | None = None) -> tuple[int | None, int | None]:\n    \"\"\"\n    Local helper (only used by this solver): find a column where all values are identical and != bg.\n    Returns (col_idx, color) or (None, None).\n    \"\"\"\n    H, W = grid.shape\n    if bg is None:\n        bg = get_bg(grid)\n    bg = int(bg)\n\n    for c in range(int(W)):\n        col = grid[:, int(c)]\n        if (col == col[0]).all() and int(col[0]) != bg:\n            return int(c), int(col[0])\n    return None, None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Draw a polyline by decoding 3x3 glyph instructions read across a divided grid.\n\n    Input structure:\n    - Left of a full-height vertical divider: 3x3 colored glyphs on bg.\n    - Right of divider: a single gray (5) start pixel.\n\n    Rule:\n    - Remove the divider; shift the gray start into the left canvas.\n    - Read glyphs in column-major order (left→right, top→bottom).\n    - Each glyph's shape (pixel area) encodes a segment: area 4 → down 2, area 5 → right 3, area 6 → left 4, area 7 → left 2.\n    - Append segments sequentially, stepping down one cell between each.\n\n    Key insight: Glyph pixel count (area) uniquely determines both segment length and direction — the shape itself is the instruction.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # Divider is a full-height constant non-bg column.\n    div_c, div_color = find_full_height_constant_col(g, bg=bg)\n    assert div_c is not None\n\n    out = np.zeros((H, int(div_c)), dtype=int)\n\n    # Move gray start from right side into left canvas (remove divider col too).\n    gray = np.argwhere(g == 5)\n    if gray.size == 0:\n        return out\n    r_cur, c_cur = map(int, gray[0])\n    c_cur = int(c_cur - (int(div_c) + 1))\n    if not (0 <= c_cur < int(div_c)):\n        return out\n    out[int(r_cur), int(c_cur)] = 5\n\n    # Collect 3x3 glyph components on the left.\n    left = g[:, : int(div_c)]\n    ignore = {int(bg), 5}\n    if div_color is not None:\n        ignore.add(int(div_color))\n\n    glyphs: list[dict[str, int]] = []\n    for comp in find_components(left, bg=bg, connectivity=8, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        if col in ignore:\n            continue\n        b = comp[\"bbox\"]\n        if bbox_h(b) == 3 and bbox_w(b) == 3:\n            r0, c0, _r1, _c1 = map(int, b)\n            glyphs.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"area\": int(comp[\"area\"])})\n\n    glyphs.sort(key=lambda d: (int(d[\"c0\"]), int(d[\"r0\"])))\n\n    area_to_len = {4: 2, 5: 3, 6: 4, 7: 2}\n    area_to_dir = {5: 1, 6: -1, 7: -1}  # diamond right; cross/U left\n\n    for glyph in glyphs:\n        color = int(glyph[\"color\"])\n        area = int(glyph[\"area\"])\n        seg_len = int(area_to_len.get(area, 2))\n\n        r_cur = int(r_cur + 1)\n        assert r_cur < H, f\"segment exits bottom: r_cur={r_cur}, H={H}\"\n        out[r_cur, int(c_cur)] = color\n\n        if area == 4:  # vertical (down)\n            end_r = r_cur + (seg_len - 1)\n            assert end_r < H, f\"vertical segment exits bottom: end_r={end_r}, H={H}\"\n            for _ in range(seg_len - 1):\n                r_cur = int(r_cur + 1)\n                out[r_cur, int(c_cur)] = color\n        else:  # horizontal\n            dir_h = int(area_to_dir.get(area, 1))\n            end_c = int(c_cur) + dir_h * (seg_len - 1)\n            assert 0 <= end_c < int(div_c), (\n                f\"horizontal segment exits canvas: c_cur={c_cur}, dir={dir_h}, \"\n                f\"seg_len={seg_len}, div_c={div_c}\"\n            )\n            for _ in range(seg_len - 1):\n                c_cur = int(c_cur + dir_h)\n                out[r_cur, c_cur] = color\n\n    return out\n\n# --------------- generator (attempt 1 (Claude)) ---------------\n\n# --- canvas geometry ---\nN_MIN, N_MAX = 2, 5            # number of tile rows; H = 4*N - 1, num_glyphs = 2*N\nGRID_W = 15                    # full input width\nDIVIDER_COL = 7                # divider position (col), full-height\nDIVIDER_COLOR = 4              # divider fill color\nLEFT_W = 7                     # left canvas width (cols 0..6)\nTILE_COLS = (0, 4)             # 3x3 tile c0 positions on the left\nTILE_ROW_STRIDE = 4            # row spacing between successive tile slots\nGRAY = 5                       # start-pixel color\nGRAY_START_ROW = 0             # gray start always sits at row 0 [observed]\n\n# --- shape grammar (area -> 3x3 template, color, and (dr, dc) walk delta) ---\n# Walk delta = total (row, col) displacement caused by one glyph instruction:\n#   step down 1 then segment of (len, dir). E.g. area 4 (vertical len 2) => (+2, 0).\n_TEMPLATES = {\n    4: np.array([[1, 0, 1], [0, 1, 0], [0, 1, 0]], dtype=int),  # plus    -> down 2,  color 6\n    5: np.array([[1, 1, 0], [1, 0, 1], [0, 1, 0]], dtype=int),  # diamond -> right 3, color 1\n    6: np.array([[1, 1, 1], [0, 1, 0], [1, 0, 1]], dtype=int),  # cross   -> left 4,  color 3\n    7: np.array([[1, 0, 1], [1, 0, 1], [1, 1, 1]], dtype=int),  # U       -> left 2,  color 2\n}\n_AREA_TO_COLOR = {4: 6, 5: 1, 6: 3, 7: 2}\n_AREA_DELTA = {4: (2, 0), 5: (1, 2), 6: (1, -3), 7: (1, -1)}\n_AREAS = (4, 5, 6, 7)\n\n# --- generation constraints ---\nMIN_DIRECTION_CHANGES = 2      # min vertical<->horizontal flips across the walk\nMAX_ATTEMPTS = 300             # outer retry budget\n\n\ndef _sample_path(N: int, start_col: int) -> list[int] | None:\n    \"\"\"Random-walk a sequence of 2*N area instructions that stays in the left canvas.\n\n    Returns None if the walk dead-ends or fails the direction-change constraint.\n    \"\"\"\n    H = 4 * N - 1\n    r, c = GRAY_START_ROW, start_col\n    areas: list[int] = []\n    for _ in range(2 * N):\n        opts = [a for a in _AREAS\n                if r + _AREA_DELTA[a][0] < H and 0 <= c + _AREA_DELTA[a][1] < LEFT_W]\n        if not opts:\n            return None\n        area = random.choice(opts)\n        areas.append(area)\n        dr, dc = _AREA_DELTA[area]\n        r += dr\n        c += dc\n\n    types = [a == 4 for a in areas]  # True = vertical, False = horizontal\n    changes = sum(1 for i in range(1, len(types)) if types[i] != types[i - 1])\n    if changes < MIN_DIRECTION_CHANGES:\n        return None\n    return areas\n\n\ndef _render_grid(N: int, start_col: int, areas: list[int]) -> np.ndarray:\n    \"\"\"Paint divider, gray start, and all 2*N tiled glyphs into the input grid.\"\"\"\n    H = 4 * N - 1\n    grid = np.zeros((H, GRID_W), dtype=int)\n    grid[:, DIVIDER_COL] = DIVIDER_COLOR\n    grid[GRAY_START_ROW, DIVIDER_COL + 1 + start_col] = GRAY\n\n    # Column-major tiling: first N glyphs into TILE_COLS[0], next N into TILE_COLS[1].\n    for i, area in enumerate(areas):\n        tile_col = TILE_COLS[i // N]\n        r0 = TILE_ROW_STRIDE * (i % N)\n        grid[r0:r0 + 3, tile_col:tile_col + 3] = _TEMPLATES[area] * _AREA_TO_COLOR[area]\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    N = random.randint(N_MIN, N_MAX)\n    start_col = random.randint(0, LEFT_W - 1)\n    areas = _sample_path(N, start_col)\n    if areas is None:\n        return None\n    return _render_grid(N, start_col, areas)\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        try:\n            inp = _gen_attempt()\n            if inp is None:\n                continue\n            out = main(inp)  # oracle check\n            if out.shape != (inp.shape[0], LEFT_W):\n                continue\n            return inp\n        except Exception:\n            continue\n    raise RuntimeError(f\"generate_input: failed after {MAX_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg\nimport random\n\n\ndef _touches_edge(coords: np.ndarray, height: int, width: int) -> bool:\n    rows = coords[:, 0]\n    cols = coords[:, 1]\n    return bool(\n        np.any((rows == 0) | (rows == height - 1) | (cols == 0) | (cols == width - 1))\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, table, frame, and slot dimensions.\nCANVAS_MIN, CANVAS_MAX = 13, 19\nTABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\nROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\nAXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n\n# Object and palette sampling limits.\nN_COLORS, MAX_OBJECT_COLORS = 10, 6\nMAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\nOBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n\n# Rejection sampling cap.\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_axis_options(n_slots, slot_min, slot_max):\n    options = []\n\n    def rec_slots(i, cur):\n        if i == n_slots:\n            rec_seps(0, [], cur)\n            return\n        for size in range(slot_min, slot_max + 1):\n            rec_slots(i + 1, cur + [size])\n\n    def rec_seps(i, cur, slots):\n        if i == n_slots - 1:\n            for before in AXIS_OUTER_OPTIONS:\n                for after in AXIS_OUTER_OPTIONS:\n                    for pad_before in AXIS_PADDING_OPTIONS:\n                        for pad_after in AXIS_PADDING_OPTIONS:\n                            total = (\n                                before\n                                + after\n                                + pad_before\n                                + pad_after\n                                + sum(slots)\n                                + sum(cur)\n                            )\n                            if 13 <= total <= 19:\n                                options.append(\n                                    (\n                                        tuple(slots),\n                                        tuple(cur),\n                                        before,\n                                        after,\n                                        pad_before,\n                                        pad_after,\n                                        total,\n                                )\n                            )\n            return\n        for sep in AXIS_SEPARATOR_OPTIONS:\n            rec_seps(i + 1, cur + [sep], slots)\n\n    rec_slots(0, [])\n    return options\n\n\ndef _gen_positions(axis):\n    sizes, seps, outer_before, _outer_after, pad_before, _pad_after, _total = axis\n    starts = []\n    pos = outer_before + pad_before\n    for i, size in enumerate(sizes):\n        starts.append(pos)\n        pos += size\n        if i < len(seps):\n            pos += seps[i]\n    return starts\n\n\ndef _gen_choose_axis(n_slots, slot_min, slot_max, other_axis=None, max_object_loss=0):\n    options = _gen_axis_options(n_slots, slot_min, slot_max)\n    if other_axis is None:\n        return random.choice(options)\n\n    good = []\n    for axis in options:\n        row_axis = axis if slot_max == ROW_SLOT_SIZE_RANGE[1] else other_axis\n        col_axis = axis if slot_max == COL_SLOT_SIZE_RANGE[1] else other_axis\n        height = row_axis[-1]\n        width = col_axis[-1]\n        frame_height = height - row_axis[2] - row_axis[3]\n        frame_width = width - col_axis[2] - col_axis[3]\n        slot_area = sum(row_axis[0]) * sum(col_axis[0])\n        outer_bg = height * width - frame_height * frame_width\n        bg_room = outer_bg + slot_area - max_object_loss\n        frame_area = frame_height * frame_width - slot_area\n        if bg_room > frame_area:\n            good.append(axis)\n    return random.choice(good or options)\n\n\ndef _gen_assign_colors(shape, bg, frame):\n    n_slots = shape[0] * shape[1]\n    filled_count = random.randint(1, n_slots - 1)\n    filled = random.sample(range(n_slots), filled_count)\n    colors = [c for c in range(N_COLORS) if c not in (bg, frame)]\n    n_colors = random.randint(1, min(MAX_OBJECT_COLORS, filled_count, len(colors)))\n    palette = random.sample(colors, n_colors)\n    assignments = palette[:]\n    assignments.extend(random.choice(palette) for _ in range(filled_count - n_colors))\n    random.shuffle(assignments)\n\n    out = np.full(shape, bg, dtype=int)\n    for idx, color in zip(filled, assignments):\n        out[idx // shape[1], idx % shape[1]] = color\n    return out, filled_count\n\n\ndef _gen_object_shape(slot_h, slot_w):\n    by_area = {}\n    for obj_h in range(1, min(MAX_OBJECT_HEIGHT, slot_h - 2 * OBJECT_MARGIN) + 1):\n        for obj_w in range(1, min(MAX_OBJECT_WIDTH, slot_w - 2 * OBJECT_MARGIN) + 1):\n            by_area.setdefault(obj_h * obj_w, []).append((obj_h, obj_w))\n    area = random.choice(list(by_area))\n    return random.choice(by_area[area])\n\n\ndef _gen_choose_layout(rows, cols, filled_count):\n    row_axis = _gen_choose_axis(rows, *ROW_SLOT_SIZE_RANGE)\n    loss = MAX_OBJECT_AREA * filled_count\n    col_axis = _gen_choose_axis(cols, *COL_SLOT_SIZE_RANGE, row_axis, max_object_loss=loss)\n    return row_axis, col_axis, _gen_positions(row_axis), _gen_positions(col_axis)\n\n\ndef _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts):\n    height = row_axis[-1]\n    width = col_axis[-1]\n    grid = np.full((height, width), bg, dtype=int)\n    rt, rb = row_axis[2], row_axis[3]\n    cl, cr = col_axis[2], col_axis[3]\n    grid[rt : height - rb, cl : width - cr] = frame\n\n    for r, slot_h in zip(row_starts, row_axis[0]):\n        for c, slot_w in zip(col_starts, col_axis[0]):\n            grid[r : r + slot_h, c : c + slot_w] = bg\n    return grid\n\n\ndef _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts):\n    for out_r, slot_r in enumerate(row_starts):\n        slot_h = row_axis[0][out_r]\n        for out_c, slot_c in enumerate(col_starts):\n            color = int(out[out_r, out_c])\n            if color == bg:\n                continue\n            slot_w = col_axis[0][out_c]\n            obj_h, obj_w = _gen_object_shape(slot_h, slot_w)\n            obj_r = random.randint(slot_r + OBJECT_MARGIN, slot_r + slot_h - obj_h - OBJECT_MARGIN)\n            obj_c = random.randint(slot_c + OBJECT_MARGIN, slot_c + slot_w - obj_w - OBJECT_MARGIN)\n            grid[obj_r : obj_r + obj_h, obj_c : obj_c + obj_w] = color\n\n\ndef _gen_is_valid(grid, out, bg, frame):\n    counts = np.bincount(grid.ravel(), minlength=N_COLORS)\n    if int(np.argmax(counts)) != bg:\n        return False\n    if counts[frame] <= max(counts[c] for c in range(N_COLORS) if c not in (bg, frame)):\n        return False\n    try:\n        actual = main(grid)\n    except Exception:\n        return False\n    return bool(np.array_equal(actual, out))\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rows = random.randint(*TABLE_ROWS_RANGE)\n    cols = random.randint(*TABLE_COLS_RANGE)\n    bg, frame = random.sample(range(N_COLORS), 2)\n\n    out, filled_count = _gen_assign_colors((rows, cols), bg, frame)\n    row_axis, col_axis, row_starts, col_starts = _gen_choose_layout(rows, cols, filled_count)\n    grid = _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts)\n    _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts)\n\n    if _gen_is_valid(grid, out, bg, frame):\n        return grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/d93c6891.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords, bbox_h, bbox_w, find_components, neighbors4\nimport random\n\n\ndef _orientation(\n    coords: np.ndarray,\n    contacts: list[tuple[int, int, int, int]],\n) -> str:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    assert h == 1 or w == 1, \"expected each gray source to be a one-cell-thick bar\"\n\n    if h == 1 and w > 1:\n        return \"horizontal\"\n    if w == 1 and h > 1:\n        return \"vertical\"\n\n    implied: set[str] = set()\n    for tr, tc, sr, sc in contacts:\n        if tr == sr:\n            implied.add(\"horizontal\")\n        elif tc == sc:\n            implied.add(\"vertical\")\n        else:\n            raise AssertionError(\"gray source must touch orange by a 4-neighbor side\")\n    assert len(implied) == 1, \"singleton gray source has ambiguous orientation\"\n    return implied.pop()\n\n\ndef _fill_rows(\n    out: np.ndarray,\n    r0: int,\n    c0: int,\n    r1: int,\n    c1: int,\n    count: int,\n    contact_rows: set[int],\n) -> None:\n    width = int(c1 - c0 + 1)\n    height = int(r1 - r0 + 1)\n    assert count % width == 0, \"gray count must make complete orange rows\"\n    stripe_count = int(count // width)\n    assert 0 < stripe_count <= height, \"row fill must fit inside the orange rectangle\"\n\n    assert contact_rows in ({r0}, {r1}), \"horizontal bars must touch exactly one extreme row\"\n    if contact_rows == {r0}:\n        rows = list(range(r0, r0 + stripe_count))\n    else:\n        rows = list(range(r1 - stripe_count + 1, r1 + 1))\n\n    out[rows, c0 : c1 + 1] = Color.GRAY\n\n\ndef _fill_cols(\n    out: np.ndarray,\n    r0: int,\n    c0: int,\n    r1: int,\n    c1: int,\n    count: int,\n    contact_cols: set[int],\n) -> None:\n    width = int(c1 - c0 + 1)\n    height = int(r1 - r0 + 1)\n    assert count % height == 0, \"gray count must make complete orange columns\"\n    stripe_count = int(count // height)\n    assert 0 < stripe_count <= width, \"column fill must fit inside the orange rectangle\"\n\n    assert contact_cols in ({c0}, {c1}), \"vertical bars must touch exactly one extreme column\"\n    if contact_cols == {c0}:\n        cols = list(range(c0, c0 + stripe_count))\n    else:\n        cols = list(range(c1 - stripe_count + 1, c1 + 1))\n\n    out[r0 : r1 + 1, cols] = Color.GRAY\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each gray bar into its adjacent orange rectangle as full stripes from the contacted edge.\n\n    Input structure\n    - The scene uses black outside space, yellow fill, gray one-cell-thick bars, and solid orange rectangles.\n    - Each gray bar 4-touches exactly one orange rectangle; some orange rectangles have no touching gray bar.\n    - Gray bars touching the same orange rectangle all have the same orientation.\n\n    Rule\n    - Recolor every original gray cell to yellow.\n    - For each orange rectangle touched by gray bars, count the gray cells assigned to that rectangle.\n    - Horizontal gray bars repaint that many cells as complete orange rows starting from the contacted top or bottom row.\n    - Vertical gray bars repaint that many cells as complete orange columns starting from the contacted left or right column.\n    - Orange rectangles with no touching gray bar remain unchanged.\n\n    Key insight\n    - The gray pixels are not copied by shape; their count is transferred into the neighboring orange rectangle as edge-aligned row or column stripes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.YELLOW, Color.GRAY, Color.ORANGE}\n\n    orange = find_components(g, bg=Color.YELLOW, colors=[Color.ORANGE], connectivity=4)\n    gray = find_components(g, bg=Color.YELLOW, colors=[Color.GRAY], connectivity=4)\n    assert orange and gray, \"expected orange rectangles and gray source bars\"\n\n    orange_index: dict[tuple[int, int], int] = {}\n    orange_bboxes: list[tuple[int, int, int, int]] = []\n    for i, obj in enumerate(orange):\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        assert obj[\"area\"] == bbox_h(obj[\"bbox\"]) * bbox_w(obj[\"bbox\"])\n        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == Color.ORANGE)\n        orange_bboxes.append((int(r0), int(c0), int(r1), int(c1)))\n        for r, c in obj[\"coords\"]:\n            orange_index[(int(r), int(c))] = i\n\n    source_by_target: dict[int, list[tuple[dict, list[tuple[int, int, int, int]]]]] = {}\n    for src in gray:\n        touched: dict[int, list[tuple[int, int, int, int]]] = {}\n        for sr_raw, sc_raw in src[\"coords\"]:\n            sr = int(sr_raw)\n            sc = int(sc_raw)\n            for tr, tc in neighbors4(sr, sc):\n                target_i = orange_index.get((int(tr), int(tc)))\n                if target_i is not None:\n                    touched.setdefault(target_i, []).append((int(tr), int(tc), sr, sc))\n\n        assert len(touched) == 1, \"each gray bar must touch exactly one orange rectangle\"\n        target_i = next(iter(touched))\n        source_by_target.setdefault(target_i, []).append((src, touched[target_i]))\n\n    out = g.copy()\n    out[g == Color.GRAY] = Color.YELLOW\n\n    for target_i, sources in source_by_target.items():\n        r0, c0, r1, c1 = orange_bboxes[target_i]\n        orientations = {_orientation(src[\"coords\"], contacts) for src, contacts in sources}\n        assert len(orientations) == 1, \"all gray bars for one orange rectangle must share orientation\"\n        count = sum(int(src[\"area\"]) for src, _contacts in sources)\n        contacts = [contact for _src, src_contacts in sources for contact in src_contacts]\n\n        if orientations == {\"horizontal\"}:\n            contact_rows = {tr for tr, _tc, _sr, _sc in contacts}\n            assert contact_rows <= {r0, r1}\n            _fill_rows(out, r0, c0, r1, c1, count, contact_rows)\n        else:\n            assert orientations == {\"vertical\"}\n            contact_cols = {tc for _tr, tc, _sr, _sc in contacts}\n            assert contact_cols <= {c0, c1}\n            _fill_cols(out, r0, c0, r1, c1, count, contact_cols)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGRID_H_RANGE, GRID_W_RANGE = (10, 18), (14, 18)\nCONTENT_H_RANGE, CONTENT_W_RANGE = (6, 13), (12, 15)\nBORDER_RANGE = (0, 4)\n\nEDGES, HORIZONTAL_EDGES = (\"top\", \"bottom\", \"left\", \"right\"), (\"top\", \"bottom\")\nORANGE_COUNT_CHOICES, ORANGE_COUNT_WEIGHTS = [1, 2, 3, 4], [1, 2, 3, 4]\nORANGE_H_RANGE, ORANGE_W_RANGE = (1, 5), (2, 6)\nORANGE_AREA_RANGE = (4, 12)\nORANGE_PLACE_RETRIES = 80\n\nMAX_UNTOUCHED_ORANGES = 1\nBARS_PER_ORANGE_RANGE, TOTAL_BARS_RANGE = (1, 2), (2, 6)\nBAR_LENGTH_RANGE = (1, 7)\nBAR_COUNT_RETRIES = 50\n\nGENERATE_RETRIES = 300\n\n\ndef _place_orange(edge, cr0, cc0, cr1, cc1, occupied):\n    \"\"\"Try to place an orange rect flush against the given edge. Returns (or0,oc0,or1,oc1) or None.\"\"\"\n    for _ in range(ORANGE_PLACE_RETRIES):\n        oh = random.randint(*ORANGE_H_RANGE)\n        ow = random.randint(*ORANGE_W_RANGE)\n        if not (ORANGE_AREA_RANGE[0] <= oh * ow <= ORANGE_AREA_RANGE[1]):\n            continue\n        if edge in HORIZONTAL_EDGES:\n            or0 = cr0 if edge == 'top' else cr1 - oh + 1\n            or1 = or0 + oh - 1\n            lo, hi = cc0 + 1, cc1 - ow  # avoid touching perpendicular edges\n        else:\n            oc0 = cc0 if edge == 'left' else cc1 - ow + 1\n            oc1 = oc0 + ow - 1\n            lo, hi = cr0 + 1, cr1 - oh  # avoid touching perpendicular edges\n        if hi < lo:\n            continue\n        v = random.randint(lo, hi)\n        if edge in HORIZONTAL_EDGES:\n            oc0, oc1 = v, v + ow - 1\n        else:\n            or0, or1 = v, v + oh - 1\n        if or0 < cr0 or or1 > cr1 or oc0 < cc0 or oc1 > cc1:\n            continue\n        if occupied[or0:or1+1, oc0:oc1+1].any():\n            continue\n        return (or0, oc0, or1, oc1)\n    return None\n\n\ndef _make_canvas() -> tuple[np.ndarray, tuple[int, int, int, int]] | None:\n    content_h = random.randint(*CONTENT_H_RANGE)\n    content_w = random.randint(*CONTENT_W_RANGE)\n    border_top = random.randint(*BORDER_RANGE)\n    border_bottom = random.randint(*BORDER_RANGE)\n    border_left = random.randint(*BORDER_RANGE)\n    border_right = random.randint(*BORDER_RANGE)\n    grid_h = content_h + border_top + border_bottom\n    grid_w = content_w + border_left + border_right\n    if not (GRID_H_RANGE[0] <= grid_h <= GRID_H_RANGE[1] and GRID_W_RANGE[0] <= grid_w <= GRID_W_RANGE[1]):\n        return None\n\n    grid = np.full((grid_h, grid_w), Color.BLACK, dtype=int)\n    cr0, cc0 = border_top, border_left\n    cr1, cc1 = cr0 + content_h - 1, cc0 + content_w - 1\n    grid[cr0:cr1+1, cc0:cc1+1] = Color.YELLOW\n    return grid, (cr0, cc0, cr1, cc1)\n\n\ndef _place_oranges(content_box, occupied) -> list[tuple[str, int, int, int, int]] | None:\n    cr0, cc0, cr1, cc1 = content_box\n    num_orange = random.choices(ORANGE_COUNT_CHOICES, weights=ORANGE_COUNT_WEIGHTS)[0]\n    edges = random.sample(EDGES, num_orange)\n    orange_rects = []\n    for edge in edges:\n        result = _place_orange(edge, cr0, cc0, cr1, cc1, occupied)\n        if result is None:\n            return None\n        or0, oc0, or1, oc1 = result\n        occupied[or0:or1+1, oc0:oc1+1] = True\n        orange_rects.append((edge, or0, oc0, or1, oc1))\n    return orange_rects\n\n\ndef _choose_touched_oranges(num_orange):\n    max_untouched = min(MAX_UNTOUCHED_ORANGES, num_orange - 1)\n    num_untouched = random.randint(0, max_untouched) if num_orange > 1 else 0\n    indices = list(range(num_orange))\n    random.shuffle(indices)\n    untouched_set = set(indices[:num_untouched])\n    return [i for i in range(num_orange) if i not in untouched_set]\n\n\ndef _choose_bars_per_orange(touched_list):\n    for _ in range(BAR_COUNT_RETRIES):\n        bpo = [random.randint(*BARS_PER_ORANGE_RANGE) for _ in touched_list]\n        if TOTAL_BARS_RANGE[0] <= sum(bpo) <= TOTAL_BARS_RANGE[1]:\n            return bpo\n    return None\n\n\ndef _split_bar_lengths(total_gray, n_bars):\n    min_len, max_len = BAR_LENGTH_RANGE\n    if n_bars == 2 and total_gray >= 2:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom arc_utils import get_bg, in_bounds, neighbors4, label_mask\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect framed squares via colored bridges following a control-pixel sequence.\n\n    Input structure:\n    - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.\n    - Control row below squares: colored pixels read left-to-right encode visitation order.\n\n    Rule:\n    - Start at the square matching first control color c0.\n    - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.\n    - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.\n\n    Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # border color = most common non-bg color\n    cnt = Counter(map(int, g.flatten()))\n    border = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            border = int(col)\n            break\n    assert not (border is None)\n\n    # detect framed squares as connected components of the border color\n    lab, n = label_mask(g == int(border), connectivity=4)\n    frames: list[dict] = []\n    for cid in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(cid))\n        if int(pts.shape[0]) < 8:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        if h < 3 or w < 3:\n            continue\n\n        t = None\n        inner_col = None\n        for tt in range(1, int(min(h, w) // 2) + 1):\n            inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]\n            if inner.size == 0:\n                continue\n            if bool((inner == int(border)).any()):\n                continue\n            u = set(map(int, inner.flatten()))\n            if len(u) != 1:\n                continue\n\n            ok = True\n            if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not ok:\n                continue\n\n            t = int(tt)\n            inner_col = int(next(iter(u)))\n            break\n\n        if t is None or inner_col is None:\n            continue\n\n        frames.append(\n            {\n                \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n                \"t\": int(t),\n                \"inner\": int(inner_col),\n                \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            }\n        )\n\n    assert not (not frames)\n\n    by: dict[int, list[dict]] = defaultdict(list)\n    for f in frames:\n        by[int(f[\"inner\"])].append(f)\n\n    max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n\n    # control row = bottom-most row below the squares with >=2 non-bg pixels\n    ctrl_r = None\n    for r in range(int(H - 1), int(max_frame_r), -1):\n        if int((g[int(r)] != int(bg)).sum()) >= 2:\n            ctrl_r = int(r)\n            break\n    assert not (ctrl_r is None)\n\n    ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n    assert not (len(ctrl) < 2)\n\n    def center(f: dict) -> tuple[int, int]:\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        return int((r0 + r1) // 2), int((c0 + c1) // 2)\n\n    def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n        a = f1[\"inner_bbox\"]\n        b = f2[\"inner_bbox\"]\n        same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n        same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))\n        return same_row, same_col\n\n    # choose start frame\n    start_color = int(ctrl[0])\n    assert not (start_color not in by)\n    start_cands = by[start_color]\n    if len(start_cands) == 1:\n        cur = start_cands[0]\n    else:\n        nxt_color = int(ctrl[1])\n        nxt_cands = by.get(nxt_color, [])\n        best = None\n        bestf = None\n        for f in start_cands:\n            for g2 in (nxt_cands if nxt_cands else [f]):\n                sr, sc = aligned(f, g2)\n                al = 1 if (sr or sc) else 0\n                (r1_, c1_) = center(f)\n                (r2_, c2_) = center(g2)\n                d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n                cand = (int(al), -int(d))\n                if best is None or cand > best:\n                    best = cand\n                    bestf = f\n        cur = bestf\n\n    out = g.copy()\n\n    def draw_bridge(fa: dict, fb: dict, color: int) -> None:\n        (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n        (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n        ia = fa[\"inner_bbox\"]\n        sr, sc = aligned(fa, fb)\n        if sr:\n            rr0, rr1 = int(ia[0]), int(ia[2])\n            if int(c1a) < int(c0b):\n                cc0, cc1 = int(c1a + 1), int(c0b - 1)\n            else:\n                cc0, cc1 = int(c1b + 1), int(c0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n            return\n        if sc:\n            cc0, cc1 = int(ia[1]), int(ia[3])\n            if int(r1a) < int(r0b):\n                rr0, rr1 = int(r1a + 1), int(r0b - 1)\n            else:\n                rr0, rr1 = int(r1b + 1), int(r0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n\n    for i in range(int(len(ctrl)) - 1):\n        a = int(ctrl[i])\n        b = int(ctrl[i + 1])\n        assert int(cur[\"inner\"]) == int(a)\n        assert b in by, f\"control color {b} has no matching frame\"\n        cands = by[b]\n        best = None\n        bestf = None\n        for f in cands:\n            sr, sc = aligned(cur, f)\n            al = 1 if (sr or sc) else 0\n            (r1_, c1_) = center(cur)\n            (r2_, c2_) = center(f)\n            d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n            cand = (int(al), -int(d))\n            if best is None or cand > best:\n                best = cand\n                bestf = f\n        nxt = bestf\n        draw_bridge(cur, nxt, int(a))\n        cur = nxt\n\n    return out\n\n\ndef _most_common_nonbg(g: np.ndarray, bg: int) -> int | None:\n    cnt = Counter(map(int, g.flatten()))\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            return int(col)\n    return None\n\ndef _draw_frame(g: np.ndarray, *, r0: int, c0: int, outer: int, t: int, border: int, inner_col: int) -> None:\n    g[int(r0) : int(r0 + outer), int(c0) : int(c0 + outer)] = int(border)\n    g[int(r0 + t) : int(r0 + outer - t), int(c0 + t) : int(c0 + outer - t)] = int(inner_col)\n\ndef _bridge_cells(fa: dict, fb: dict) -> set[tuple[int, int]]:\n    (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n    (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n    ia = fa[\"inner_bbox\"]\n    ib = fb[\"inner_bbox\"]\n    # same-row band\n    if int(ia[0]) == int(ib[0]) and int(ia[2]) == int(ib[2]):\n        rr0, rr1 = int(ia[0]), int(ia[2])\n        if int(c1a) < int(c0b):\n            cc0, cc1 = int(c1a + 1), int(c0b - 1)\n        else:\n            cc0, cc1 = int(c1b + 1), int(c0a - 1)\n        assert int(cc0) <= int(cc1), \"horizontal bridge gap must be non-empty\"\n        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n    # same-col band\n    if int(ia[1]) == int(ib[1]) and int(ia[3]) == int(ib[3]):\n        cc0, cc1 = int(ia[1]), int(ia[3])\n        if int(r1a) < int(r0b):\n            rr0, rr1 = int(r1a + 1), int(r0b - 1)\n        else:\n            rr0, rr1 = int(r1b + 1), int(r0a - 1)\n        assert int(rr0) <= int(rr1), \"vertical bridge gap must be non-empty\"\n        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n    return set()\n\n_DIGITS = [int(i) for i in range(10)]\n\ndef _gen_attempt() -> np.ndarray | None:\n    # --- colors ---\n    bg = int(np.random.choice(np.array(_DIGITS, dtype=int)))\n    border = int(np.random.choice(np.array([d for d in _DIGITS if int(d) != int(bg)], dtype=int)))\n    inner_palette = [int(d) for d in _DIGITS if int(d) not in (int(bg), int(border))]\n    if len(inner_palette) < 3:\n        return None\n\n    # --- geometry ---\n    t = int(np.random.choice(np.array([1, 1, 2], dtype=int)))\n    inner = int(np.random.randint(1, 4))  # 1..3\n    outer = int(inner + 2 * t)\n    if not (3 <= int(outer) <= 7):\n        return None\n\n    # lattice dims and number of squares (all on the path)\n    R = int(np.random.randint(2, 6))\n    C = int(np.random.randint(2, 6))\n    max_frames = int(R * C)\n    if max_frames < 4:\n        return None\n    n_frames = int(np.random.randint(4, int(min(12, max_frames)) + 1))\n\n    # sample a self-avoiding path of length n_frames starting at (0,0)\n    path: list[tuple[int, int]] | None = None\n    for _path_try in range(400):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import find_components, get_bg, neighbors4, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n                frontier.append((rr, cc))\n    return frontier\n\n\ndef _grow_body(area):\n    choices = [\n        (h, w)\n        for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n        for w in _inclusive_range(_BODY_WIDTH_RANGE)\n        if h * w >= area\n    ]\n    h, w = random.choice(choices)\n    cells = set(random.choice(_GROW_BODY_SEEDS))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, h, w)\n        if not frontier:\n            return _grow_body(area)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n\n\ndef _symmetric_body(area):\n    choices = []\n    for height in _inclusive_range(_BODY_HEIGHT_RANGE):\n        extra = area - height\n        if extra >= 2 and extra % 2 == 0 and extra // 2 <= height:\n            choices.append((height, extra // 2))\n    if not choices:\n        return _grow_body(area)\n\n    height, pair_count = random.choice(choices)\n    cells = {(r, 1) for r in range(height)}\n    rows = list(range(height))\n    random.shuffle(rows)\n    for r in rows[:pair_count]:\n        cells.add((r, 0))\n        cells.add((r, 2))\n\n    if height >= _SYMMETRIC_TRANSPOSE_MIN_HEIGHT and random.random() < _SYMMETRIC_TRANSPOSE_PROB:\n","exit_code":0,"status":"completed"}}
