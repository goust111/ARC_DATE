0/code.py:372:def _find_protrusion_candidates(\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/40/code.py:382:            if host == color_a and _safe_protrusion_candidate(clean, r, c, color_b, color_a):\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/40/code.py:384:            elif host == color_b and _safe_protrusion_candidate(clean, r, c, color_a, color_b):\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/40/code.py:393:    protrusions: list[tuple[int, int, int]],\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/40/code.py:403:    for r, c, stamp_color in protrusions:\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/40/code.py:409:    for r, c, _ in protrusions:\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/40/code.py:417:    protrusions: list[tuple[int, int, int]],\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/40/code.py:427:    for r, c, _ in protrusions:\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/40/code.py:563:    protrusion_candidates = _find_protrusion_candidates(clean, (color_a, color_b))\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/40/code.py:564:    desired_hi = min(PROTRUSION_COUNT_MAX, len(protrusion_candidates))\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/40/code.py:571:            [(r, c) for r, c, _ in protrusion_candidates],\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/40/code.py:581:    protrusions = [(r, c, source) for r, c, source in protrusion_candidates if (r, c) in chosen_set]\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/40/code.py:582:    if len(protrusions) != len(chosen_set):\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/40/code.py:589:    for r, c, source in protrusions:\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/40/code.py:592:    forbidden = _forbidden_patch_cells(groups_a, groups_b, protrusions, inp.shape)\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/40/code.py:598:    output = _stamp_triggers(inp, groups_a, groups_b, protrusions, color_a, color_b)\n/home/lixinyu/snap/new/ceshi/code_combo/80a900e0/6/code.py:3:# Name: 彩虹短射线\n/home/lixinyu/snap/new/ceshi/code_combo/80a900e0/30/code.py:3:# Name: 顶点菱形色射线\n/home/lixinyu/snap/new/ceshi/code_combo/88bcf3b4/23/code.py:3:# Name: 颜色编码方向等分双色绕行\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/20/code.py:3:# Name: 背景散落像素提供映射线索+色斑指示激活条件\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/20/code.py:122:    Remove one-cell specks/protrusions before detecting black dents.\n/home/lixinyu/snap/new/ceshi/code_combo/80a900e0/12/code.py:9:#    - 原题输出：菱形仍是 A，射线长成 B。\n/home/lixinyu/snap/new/ceshi/code_combo/80a900e0/12/code.py:10:#    - 本融合输出：菱形改成 B，外线段仍是 B，射线改成 A。也就是“菱形色”和“射线色”整体对换。\n/home/lixinyu/snap/new/ceshi/code_combo/80a900e0/12/code.py:20:#    - `_is_diamond8` 的几何前提不变；输入里没有射线，因此菱形识别不受融合影响。\n/home/lixinyu/snap/new/ceshi/code_combo/80a900e0/12/code.py:22:#    - 原题把外线段颜色 `ocol` 直接用于射线着色；融合后这条前提失效，射线必须改用菱形原色 `dcol`。\n/home/lixinyu/snap/new/ceshi/code_combo/80a900e0/12/code.py:27:#    - 生成器继续采用 output-first：先放置菱形、外线段与完整射线，再把射线抹回棋盘得到输入。\n/home/lixinyu/snap/new/ceshi/code_combo/80a900e0/12/code.py:28:#    - 候选放置要求菱形、线段、未来射线全部互不重叠，不越界，并且不同对象之间的占用集合互斥。\n/home/lixinyu/snap/new/ceshi/code_combo/80a900e0/12/code.py:29:#    - 每条已选边都必须产生至少少量可见射线像素，否则该样本会被拒绝。\n/home/lixinyu/snap/new/ceshi/code_combo/80a900e0/12/code.py:32:#    - 人眼应能在少量样例里看到稳定规律：输入里“内层菱形=A，贴边短线=B”；输出里“菱形=B，新射线=A”。\n/home/lixinyu/snap/new/ceshi/code_combo/80a900e0/12/code.py:34:#    - 生成器强制 `diamond_color != border_color`，并保证射线可见，避免退化成与原题难区分的弱样例。\n/home/lixinyu/snap/new/ceshi/code_combo/80a900e0/12/code.py:38:#    - 稀疏棋盘格和不重叠放置继续保留，使“菱形 / 外线段 / 射线”三类结构边界清晰。\n/home/lixinyu/snap/new/ceshi/code_combo/80a900e0/12/code.py:42:#    - 多个样例会重复展示相同的结构关系：外线段颜色流入菱形，菱形原色流向射线。\n/home/lixinyu/snap/new/ceshi/code_combo/2ba387bc/5/code.py:16:#      所以这里做必要的配套调整：右类对象也改成有彩色 2x2 内芯，但边框故意破成双色。\n/home/lixinyu/snap/new/ceshi/code_combo/2ba387bc/5/code.py:35:#    - 两类对象都只使用 2 种非背景色，避免出现“左列是双色、右列是三色”的简化捷径。\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/2/code.py:99:    Remove one-cell specks/protrusions before detecting black dents.\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/8/code.py:3:# Name: 统一轴向射线+形状决定距离+箭头精灵\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/9/code.py:101:    Remove one-cell specks/protrusions before reading dent geometry.\n/home/lixinyu/snap/new/ceshi/code_combo/898e7135/26/code.py:3:# Name: 双色对应匹配\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:23:#      3) protrusions: one-cell cross-boundary bulges that cleanup rewrites back to the\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:29:#      old protrusion rule: [a a a; a b a; a a a] centered on a b-cell inside region a\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:34:#    - The generator deliberately includes both mixed dents and protrusions in every\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:47:#    - The original cleanup erased protrusions permanently. Under D14/2, cleanup can no\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:78:#    - For a protrusion, the \"opposite region color\" equals the protrusion's source\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:97:# --- CFG: protrusions ---\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:203:def _protrusion_centers(\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:235:    Convert strict black dents and one-cell protrusions into teal-centered patches.\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:240:      specks, and some one-cell protrusions where one region pokes into the other.\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:249:      each such one-cell protrusion is treated as a trigger too. Every trigger stamps its clipped\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:255:      still flip, mixed dents stop flipping, and cross-boundary protrusions start flipping. The\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:264:    protrusions = _protrusion_centers(g, clean, colors)\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:268:    for r, c, host in dents + protrusions:\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:272:    for r, c, _host in dents + protrusions:\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:416:    protrusions: list[tuple[int, int, int]],\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:428:    for r, c, source in protrusions:\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:434:    for r, c, _ in protrusions:\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:465:def _neighbor_protrusion_safe(\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:495:def _safe_protrusion_candidate(\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:529:    if not _neighbor_protrusion_safe(clean, r, c, source, host, bg):\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:534:def _find_protrusion_candidates(\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:545:            if host == color_a and _safe_protrusion_candidate(clean, r, c, color_b, color_a, bg):\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:547:            elif host == color_b and _safe_protrusion_candidate(clean, r, c, color_a, color_b, bg):\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:617:    protrusion_candidates = _find_protrusion_candidates(clean, colors, bg)\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:618:    desired_hi = min(PROTRUSION_COUNT_MAX, len(protrusion_candidates))\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:622:    protrusion_positions = None\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:624:        protrusion_positions = _pick_with_blockers(\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:625:            [(r, c) for r, c, _ in protrusion_candidates],\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:630:        if protrusion_positions is not None:\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:632:    if protrusion_positions is None:\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:635:    chosen_pos = set(protrusion_positions)\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:636:    protrusions = [(r, c, source) for r, c, source in protrusion_candidates if (r, c) in chosen_pos]\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:637:    if len(protrusions) != len(chosen_pos):\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:640:    output = _stamp_output(clean, strict_groups_a, strict_groups_b, mixed_a, mixed_b, protrusions, color_a, color_b)\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/10/code.py:648:    for r, c, source in protrusions:\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/21/code.py:107:    Remove one-cell specks/protrusions before detecting black dents.\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/21/code.py:110:    stray protrusions, the second stabilizes the corrected local majority.\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/8/code.py:19:#     - 输入仍然是壁纸上的两个带边框矩形。source 里放完整双色精灵；destination 不再放单像素，\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/8/code.py:58:#     - 指示像素统一使用 destination 边框色，避免再引入一类无结构新颜色；source/output 仍保持双色精灵，\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/4/code.py:64:    Remove one-cell specks/protrusions before detecting black dents.\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/24/code.py:29:#      colors A0, A1, A2. Type A0 also contains two relay pixels colored A1,\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/24/code.py:30:#      and type A1 contains two relay pixels colored A2.\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/24/code.py:33:#      Round 2: each fresh A1 relay pixel now behaves as a marker, so the A1\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/24/code.py:35:#      Round 3: newly created A2 relay pixels trigger every A2 stamp.\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/24/code.py:46:#    - Use sprite templates with exactly one unique anchor pixel and two relay\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/24/code.py:60:#      that exact coordinate and color. The generator guarantees relay colors are\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/24/code.py:88:#    - Colors are only used through visible equality. A relay pixel has exactly\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/24/code.py:98:#    - Body colors never equal any anchor color; relay colors are always anchor\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/24/code.py:389:    - Each source sprite has one uniquely rare anchor color, and some non-anchor pixels may reuse other sprite anchors as relay colors. A root anchor color may appear at several destination markers.\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/24/code.py:394:    - After each round, treat every newly stamped anchor-colored relay pixel as a fresh marker for the next round, and repeat until no unseen markers remain. Return the cropped destination rectangle after the full cascade.\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/24/code.py:446:            {\"A\": sprite[\"anchor\"], \"R\": sprite[\"relay\"], \"B\": sprite[\"body\"]},\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/24/code.py:470:            {\"A\": sprite[\"anchor\"], \"R\": sprite[\"relay\"], \"B\": sprite[\"body\"]},\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/24/code.py:587:        relay = int(anchors[i + 1]) if i + 1 < int(n_types) else int(body)\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/24/code.py:593:                \"relay\": int(relay),\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/5/code.py:261:    Remove one-cell specks/protrusions before detecting black dents.\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/5/code.py:340:      specks or protrusions, while the legend is surrounded by a black moat.\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/2/code.py:3:# Name: 双色精灵编码距离与方向\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/2/code.py:27:#     - 原 solver 逐色找连通块，双色后会把一个精灵拆开；这里改成对 g != bg 做 8 连通分量。\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/2/code.py:33:#     - generator 继续走 output-first：先构造碰撞/命中事件，再把双色精灵画回输入，并用 main 反验。\n/home/lixinyu/snap/new/ceshi/code_combo/409aa875/2/code.py:40:#     - 输出侧仍只新增 9 与可能的 1，被击中的双色精灵整块统一染成 9，不会留下混色残影。\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/28/code.py:21:#        3. teal point sitting on a region boundary where a one-cell protrusion was repaired.\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/28/code.py:25:#      and several boundary protrusions per sample so both new teal roles appear repeatedly instead of as one-off accidents.\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/28/code.py:35:#    - Delete-to-black cells are reserved for the D6 trace role; recolor-to-other cells are reserved for the D14 protrusion\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/28/code.py:57:# - Every intended protrusion is a one-cell wrong-color boundary contaminant that the local cleanup would recolor into the\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/28/code.py:60:#   protrusion sites: guaranteed by candidate filtering and post-placement verification.\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/28/code.py:107:    be recolored into the opposite foreground region become D14 protrusion marks.\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/28/code.py:123:        return int(other), \"protrusion\"\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/28/code.py:156:    protrusions: list[tuple[int, int]] = []\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/28/code.py:163:            elif marker == \"protrusion\":\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/28/code.py:164:                protrusions.append((r, c))\n/home/lixinyu/snap/new/ceshi/code_combo/de809cff/28/code.py:165:    return specks, protrusions\n/home/lixinyu/snap/new/cesh