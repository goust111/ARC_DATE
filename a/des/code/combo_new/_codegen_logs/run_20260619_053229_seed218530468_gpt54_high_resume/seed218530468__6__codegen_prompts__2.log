{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/bae5c565.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Erase the top palette row and redraw it below as a widening wedge centered on its missing cell.\n\n    Input structure\n    - The top row is a palette row with exactly one background gap.\n    - Below it, the only foreground is one vertical marker bar of a single color.\n    - The marker bar is either in the gap column or immediately beside it.\n\n    Rule\n    - Clear the grid to background.\n    - Starting at the top of the marker bar, each next row copies one more\n      column of the top-row palette on both sides of the gap.\n    - Fill the gap column with the marker color, and keep the vertical marker bar.\n\n    Key insight\n    - The lone background cell in the top row is the center of the expanding\n      copy; the lower vertical bar provides the center color and the row where\n      the expansion begins.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    height, width = g.shape\n\n    bg = get_bg(g)\n    top = g[0, :]\n    gap_cols = np.flatnonzero(top == bg)\n    assert gap_cols.size == 1, \"expected exactly one background gap in the top row\"\n    gap_col = int(gap_cols[0])\n\n    lower_coords = np.argwhere(g[1:, :] != bg)\n    assert lower_coords.size > 0, \"expected a lower marker bar\"\n    lower_coords[:, 0] += 1\n\n    marker_colors = {int(g[r, c]) for r, c in lower_coords}\n    marker_cols = {int(c) for _r, c in lower_coords}\n    assert len(marker_colors) == 1, \"expected one lower marker color\"\n    assert len(marker_cols) == 1, \"expected one lower marker column\"\n    marker = marker_colors.pop()\n    line_col = marker_cols.pop()\n    line_start = int(lower_coords[:, 0].min())\n\n    assert np.all(g[1:line_start, :] == bg), \"rows before the marker bar must be background\"\n    assert np.all(g[line_start:, line_col] == marker), \"marker bar must be solid\"\n    assert lower_coords.shape[0] == height - line_start, \"marker bar must be the only lower foreground\"\n    assert line_col == gap_col or abs(line_col - gap_col) == 1\n    if line_col != gap_col:\n        assert top[line_col] == marker\n    assert np.all(top[np.arange(width) != gap_col] != bg), \"only the gap may be background in the palette row\"\n\n    out = np.full_like(g, bg)\n    out[line_start:, line_col] = marker\n\n    for r in range(line_start, height):\n        radius = r - line_start\n        c0 = max(0, gap_col - radius)\n        c1 = min(width - 1, gap_col + radius)\n        for c in range(c0, c1 + 1):\n            if radius == 0 and c == gap_col and line_col != gap_col:\n                continue\n            out[r, c] = marker if c == gap_col else int(top[c])\n        out[r, line_col] = marker\n\n    return out\n\n# --------------- generator (att2) ---------------\n# Canvas, structure, and retries.\n_CANVAS_SIZES = (9, 11, 13)\n_LINE_START_MIN = 2\n_MAX_ATTEMPTS = 300\n# Color roles.\n_BACKGROUND, _MARKER = 5, 8\n_PALETTE_COLORS = (0, 1, 2, 3, 4, 6, 7, 8, 9)\n\n\ndef _gen_expected_output(inp: np.ndarray, line_start: int) -> np.ndarray:\n    n = inp.shape[0]\n    gap_col = n // 2\n    out = np.full_like(inp, _BACKGROUND)\n    top = inp[0]\n\n    for r in range(line_start, n):\n        radius = r - line_start\n        c0 = max(0, gap_col - radius)\n        c1 = min(n - 1, gap_col + radius)\n        for c in range(c0, c1 + 1):\n            out[r, c] = _MARKER if c == gap_col else int(top[c])\n\n    return out\n\n\ndef _make_input_grid(n: int, line_start: int) -> np.ndarray:\n    gap_col = n // 2\n    inp = np.full((n, n), _BACKGROUND, dtype=int)\n    for c in range(n):\n        if c != gap_col:\n            inp[0, c] = random.choice(_PALETTE_COLORS)\n    inp[line_start:, gap_col] = _MARKER\n    return inp\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = random.choice(_CANVAS_SIZES)\n    line_start = random.randint(_LINE_START_MIN, n // 2 - 1)\n    inp = _make_input_grid(n, line_start)\n    expected = _gen_expected_output(inp, line_start)\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid bae5c565 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/9344f635.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste\nimport random\n\n\ndef _add_bar(bar_colors: dict[int, int], index: int, color: int) -> None:\n    previous = bar_colors.setdefault(int(index), int(color))\n    assert previous == int(color), \"bar axis cannot receive two different colors\"\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extend each colored domino marker into a full row or column bar, with horizontal bars covering vertical bars at crossings.\n\n    Input structure:\n    - The background is the dominant color.\n    - Every foreground object is a 4-connected same-color domino of exactly two pixels.\n    - A horizontal domino marks a row to paint; a vertical domino marks a column to paint.\n\n    Rule:\n    - Paint each marked column entirely with the color of its vertical domino marker.\n    - Paint each marked row entirely with the color of its horizontal domino marker.\n    - Rows are painted after columns, so row bars overwrite column bars at intersections.\n\n    Key insight:\n    - The two-pixel orientation is the instruction: horizontal markers emit row bars, vertical markers emit column bars, and the only layering cue is row-over-column.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    bg = get_bg(g)\n\n    row_colors: dict[int, int] = {}\n    col_colors: dict[int, int] = {}\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n    assert components, \"expected at least one foreground domino\"\n\n    for comp in components:\n        color = int(comp[\"color\"])\n        coords = comp[\"coords\"]\n        assert len(coords) == 2, \"each foreground object must be a two-pixel domino\"\n        r0, c0, r1, c1 = comp[\"bbox\"]\n\n        if r0 == r1 and c1 == c0 + 1:\n            _add_bar(row_colors, r0, color)\n        elif c0 == c1 and r1 == r0 + 1:\n            _add_bar(col_colors, c0, color)\n        else:\n            raise AssertionError(\"domino marker must be horizontal or vertical\")\n\n    out = np.full_like(g, int(bg))\n    for c, color in col_colors.items():\n        out[:, c] = int(color)\n    for r, color in row_colors.items():\n        out[r, :] = int(color)\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\n_GEN_BG = 7\n_GEN_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n_GEN_SIZE_MIN = 7\n_GEN_SIZE_MAX = 10\n\n# Bar counts and color diversity.\n_GEN_H_COUNT_MIN = 2\n_GEN_H_COUNT_MAX = 3\n_GEN_V_COUNT_MIN = 1\n_GEN_V_COUNT_MAX = 4\n_GEN_TOTAL_COUNT_MIN = 4\n_GEN_TOTAL_COUNT_MAX = 7\n_GEN_UNIQUE_COLOR_MIN = 3\n_GEN_UNIQUE_COLOR_MAX = 5\n\n# Marker placement.\n_GEN_ROW_MARGIN = 1\n_GEN_DOMINO_LEN = 2\n_GEN_DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n_GEN_MAX_ATTEMPTS = 300\n\ndef _gen_counts() -> tuple[int, int]:\n    h_count = random.randint(_GEN_H_COUNT_MIN, _GEN_H_COUNT_MAX)\n    min_v = max(_GEN_V_COUNT_MIN, _GEN_TOTAL_COUNT_MIN - h_count)\n    max_v = min(_GEN_V_COUNT_MAX, _GEN_TOTAL_COUNT_MAX - h_count)\n    return h_count, random.randint(min_v, max_v)\n\ndef _gen_bar_colors(n_bars: int) -> list[int]:\n    n_unique = random.randint(_GEN_UNIQUE_COLOR_MIN, min(_GEN_UNIQUE_COLOR_MAX, n_bars))\n    chosen = random.sample(_GEN_COLORS, n_unique)\n    colors = chosen + [random.choice(chosen) for _ in range(n_bars - n_unique)]\n    random.shuffle(colors)\n    return colors\n\ndef _gen_bars(n: int) -> tuple[list[tuple[str, int, int]], list[tuple[str, int, int]]]:\n    h_count, v_count = _gen_counts()\n    rows = random.sample(range(_GEN_ROW_MARGIN, n - _GEN_ROW_MARGIN), h_count)\n    cols = random.sample(range(n), v_count)\n    colors = _gen_bar_colors(h_count + v_count)\n    h_bars = [(\"h\", r, colors[i]) for i, r in enumerate(rows)]\n    v_bars = [(\"v\", c, colors[h_count + i]) for i, c in enumerate(cols)]\n    return h_bars, v_bars\n\ndef _gen_marker_options(n: int, orient: str, index: int, color: int):\n    if orient == \"h\":\n        opts = [\n            (index, c, [(index, c), (index, c + 1)], np.full((1, _GEN_DOMINO_LEN), color, dtype=int))\n            for c in range(n - _GEN_DOMINO_LEN + 1)\n        ]\n    else:\n        opts = [\n            (r, index, [(r, index), (r + 1, index)], np.full((_GEN_DOMINO_LEN, 1), color, dtype=int))\n            for r in range(n - _GEN_DOMINO_LEN + 1)\n        ]\n    random.shuffle(opts)\n    return opts\n\ndef _gen_can_place(grid: np.ndarray, cells: list[tuple[int, int]], color: int) -> bool:\n    h, w = grid.shape\n    cell_set = set(cells)\n    for r, c in cells:\n        if grid[r, c] != _GEN_BG:\n            return False\n        for dr, dc in _GEN_DIR4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in cell_set and grid[rr, cc] == color:\n                return False\n    return True\n\ndef _gen_render_output(n: int, h_bars: list[tuple[str, int, int]], v_bars: list[tuple[str, int, int]]) -> np.ndarray:\n    out = np.full((n, n), _GEN_BG, dtype=int)\n    for _, c, color in v_bars:\n        out[:, c] = color\n    for _, r, color in h_bars:\n        out[r, :] = color\n    return out\n\ndef _gen_place_markers(n: int, bars: list[tuple[str, int, int]]) -> np.ndarray | None:\n    grid = np.full((n, n), _GEN_BG, dtype=int)\n    ordered = list(bars)\n    random.shuffle(ordered)\n\n    def backtrack(i: int) -> bool:\n        if i == len(ordered):\n            return True\n        orient, index, color = ordered[i]\n        for r0, c0, cells, patch in _gen_marker_options(n, orient, index, color):\n            if not _gen_can_place(grid, cells, color):\n                continue\n            paste(grid, patch, r0, c0)\n            if backtrack(i + 1):\n                return True\n            for r, c in cells:\n                grid[r, c] = _GEN_BG\n        return False\n\n    return grid if backtrack(0) else None\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = random.randint(_GEN_SIZE_MIN, _GEN_SIZE_MAX)\n    h_bars, v_bars = _gen_bars(n)\n    out = _gen_render_output(n, h_bars, v_bars)\n    inp = _gen_place_markers(n, h_bars + v_bars)\n    if inp is None:\n        return None\n    if not np.array_equal(main(inp), out):\n        return None\n    return inp\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid 9344f635 input\")\n","exit_code":0,"status":"completed"}}
