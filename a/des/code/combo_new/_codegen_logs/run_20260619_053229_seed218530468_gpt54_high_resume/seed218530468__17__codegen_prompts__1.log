{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/8f215267.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg\nfrom arc_utils import paste, random_free_location\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count same-color patterns per frame and represent the tally as dots inside.\n\n    Input structure:\n    - bg = most common color.\n    - Hollow rectangular frames in various colors.\n    - Small monochrome pattern sprites scattered outside frames.\n\n    Rule:\n    - Remove all small patterns from the grid.\n    - For each frame of color C, count how many patterns share color C.\n    - Draw that many dots along the frame's center row, spaced by 2, starting from the right.\n\n    Key insight: Frames act as tally displays — scattered same-color patterns are \"absorbed\" and their count is shown as interior dots.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    out = g.copy()\n    bg = int(get_bg(g))\n\n    regions = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n\n    frames: list[dict] = []\n    patterns: list[dict] = []\n    for comp in regions:\n        b = comp[\"bbox\"]\n        h = bbox_h(b)\n        w = bbox_w(b)\n        area = int(comp[\"area\"])\n        is_frame = (h >= 5) and (w >= 5) and (area < (h * w * 0.7))\n        if is_frame:\n            frames.append(comp)\n        else:\n            patterns.append(comp)\n\n    # Remove patterns from output.\n    for p in patterns:\n        for r, c in p[\"coords\"]:\n            out[int(r), int(c)] = bg\n\n    # For each frame, count matching patterns and draw dots.\n    for f in frames:\n        col = int(f[\"color\"])\n        num_patterns = sum(1 for p in patterns if int(p[\"color\"]) == col)\n        if num_patterns <= 0:\n            continue\n\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        r_mid = (r0 + r1) // 2\n        for i in range(int(num_patterns)):\n            cc = int(c1 - 2 - 2 * i)\n            if cc > int(c0):\n                out[int(r_mid), int(cc)] = col\n\n    return out\n\n# --------------- generator (codex-att2) ---------------\n\n# --- layout geometry ---\nFRAME_H = 5                    # frame height (rows)\nFRAME_W = 11                   # frame width (cols)\nFRAME_R0 = 1                   # top-left row of first frame\nFRAME_C0 = 1                   # top-left col of all frames\nFRAME_GAP = 2                  # bg rows between consecutive frames\nGRID_W = 23                    # fixed grid width\nRIGHT_C0 = 13                  # first column of the right (sprite) region\nRIGHT_W = 9                    # width of the right region\n\n# --- structural counts ---\nN_FRAMES_RANGE = (3, 5)        # [lo, hi) for number of frames\nN_DISTRACTORS_RANGE = (1, 3)   # [lo, hi) for distractor sprite count\nTOTAL_PATTERNS_RANGE = (5, 11) # [lo, hi) for total sprite count\nMAX_DOTS_PER_FRAME = 4         # max dot tally inside one frame\nBOTTOM_PAD_RANGE = (0, 7)      # [lo, hi) extra bg rows when n_frames==3\n\n# --- sprite shape ---\nSPRITE_AREA_RANGE = (2, 9)     # [lo, hi) connected-cell count per sprite\nSPRITE_MAX_H = 4               # max bbox height for sprite\nSPRITE_MAX_W = 3               # max bbox width for sprite\nSPRITE_PADDING = 1             # gap between placed sprites\n\n# --- retry budget ---\nMAX_ATTEMPTS = 300\n\n\ndef _frame_patch(color: int, bg: int, n_dots: int) -> np.ndarray:\n    \"\"\"Build a FRAME_H x FRAME_W hollow rectangle with n_dots on the center row.\"\"\"\n    patch = np.full((FRAME_H, FRAME_W), bg, dtype=int)\n    patch[0, :] = color\n    patch[-1, :] = color\n    patch[:, 0] = color\n    patch[:, -1] = color\n    mid_r = FRAME_H // 2\n    dot_cols = [FRAME_W - 3 - 2 * i for i in range(n_dots)]\n    patch[mid_r, dot_cols] = color\n    return patch\n\n\ndef _sample_counts(rng: np.random.Generator, n_frames: int, total_match: int) -> list[int]:\n    \"\"\"Distribute total_match sprites across n_frames, each capped at MAX_DOTS_PER_FRAME.\"\"\"\n    counts = [0] * n_frames\n    order = rng.permutation(n_frames)\n    remaining = total_match\n    for pos, idx in enumerate(order):\n        frames_left = n_frames - pos - 1\n        lo = max(0, remaining - MAX_DOTS_PER_FRAME * frames_left)\n        hi = min(MAX_DOTS_PER_FRAME, remaining)\n        val = int(rng.integers(lo, hi + 1))\n        counts[int(idx)] = val\n        remaining -= val\n    return counts\n\n\ndef _grow_sprite(rng: np.random.Generator, h: int, w: int, area: int) -> list[tuple[int, int]]:\n    \"\"\"Grow a connected polyomino of the given area inside an h x w bounding box.\"\"\"\n    seed = (int(rng.integers(0, h)), int(rng.integers(0, w)))\n    cells = {seed}\n    while len(cells) < area:\n        frontier = []\n        for r, c in cells:\n            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                nb = (r + dr, c + dc)\n                if 0 <= nb[0] < h and 0 <= nb[1] < w and nb not in cells:\n                    frontier.append(nb)\n        cells.add(frontier[int(rng.integers(0, len(frontier)))])\n    return list(cells)\n\n\ndef _make_sprite(rng: np.random.Generator, color: int, bg: int) -> np.ndarray:\n    \"\"\"Generate a small random connected sprite, tight-cropped to its bounding box.\"\"\"\n    area = int(rng.integers(*SPRITE_AREA_RANGE))\n    dims = [(h, w) for h in range(1, SPRITE_MAX_H + 1)\n            for w in range(1, SPRITE_MAX_W + 1) if h * w >= area]\n    h, w = dims[int(rng.integers(0, len(dims)))]\n    cells = _grow_sprite(rng, h, w, area)\n    rs, cs = zip(*cells)\n    r_min, c_min = min(rs), min(cs)\n    patch = np.full((max(rs) - r_min + 1, max(cs) - c_min + 1), bg, dtype=int)\n    for r, c in cells:\n        patch[r - r_min, c - c_min] = color\n    return patch\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    # --- choose structure ---\n    n_frames = int(rng.integers(*N_FRAMES_RANGE))\n    n_distractors = int(rng.integers(*N_DISTRACTORS_RANGE))\n    total_patterns = int(rng.integers(*TOTAL_PATTERNS_RANGE))\n    total_match = total_patterns - n_distractors\n\n    palette = rng.choice(np.arange(10), size=1 + n_frames + n_distractors, replace=False)\n    bg = int(palette[0])\n    frame_colors = [int(x) for x in palette[1 : 1 + n_frames]]\n    distractor_colors = [int(x) for x in palette[1 + n_frames :]]\n\n    counts = _sample_counts(rng, n_frames, total_match)\n    bottom_pad = int(rng.integers(*BOTTOM_PAD_RANGE)) if n_frames == 3 else 0\n    height = FRAME_R0 + n_frames * FRAME_H + (n_frames - 1) * FRAME_GAP + bottom_pad\n\n    # --- build output (frames with dots) ---\n    out = np.full((height, GRID_W), bg, dtype=int)\n    frame_rows: list[int] = []\n    for i, (color, count) in enumerate(zip(frame_colors, counts)):\n        r0 = FRAME_R0 + i * (FRAME_H + FRAME_GAP)\n        frame_rows.append(r0)\n        paste(out, _frame_patch(color, bg, count), r0, FRAME_C0)\n\n    # --- derive input (dots removed, sprites placed right) ---\n    inp = out.copy()\n    for r0, count in zip(frame_rows, counts):\n        mid_r = r0 + FRAME_H // 2\n        dot_cols = [FRAME_C0 + FRAME_W - 3 - 2 * i for i in range(count)]\n        inp[mid_r, dot_cols] = bg\n\n    right_canvas = np.full((height, RIGHT_W), bg, dtype=int)\n    pattern_colors = [c for c, n in zip(frame_colors, counts) for _ in range(n)]\n    pattern_colors.extend(distractor_colors)\n    rng.shuffle(pattern_colors)\n\n    try:\n        for color in pattern_colors:\n            sprite = _make_sprite(rng, color, bg)\n            r0, c0 = random_free_location(\n                right_canvas, sprite, transparent=bg,\n                padding=SPRITE_PADDING, padding_connectivity=8,\n            )\n            paste(right_canvas, sprite, r0, c0, transparent=bg)\n    except ValueError:\n        return None\n\n    paste(inp, right_canvas, 0, RIGHT_C0, transparent=bg)\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"failed to generate a valid input after {MAX_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, neighbors4\n\n\ndef _legend_directions(g: np.ndarray, bg: int) -> dict[int, tuple[int, int]]:\n    \"\"\"\n    Detect legend blocks on the border.\n\n    A legend is a border-touching non-background component whose most common color is the legend\n    background `C` (and also the region border color it controls). The legend contains at least\n    two additional colors: a \"center\" color (more frequent) and an \"indicator\" color (less frequent).\n\n    The movement direction for regions with border color `C` is:\n      sign(centroid(indicator) - centroid(center))\n    \"\"\"\n    h, w = g.shape\n    non_bg = g != bg\n    best: dict[int, tuple[int, tuple[int, int]]] = {}\n    for pts in components_mask(non_bg, connectivity=4):\n        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue\n        # Legends are filled rectangles on the border.\n        r0, c0, r1, c1 = bbox_coords(pts)\n        area = (r1 - r0 + 1) * (c1 - c0 + 1)\n        if area != len(pts):\n            continue\n\n        counts: dict[int, int] = {}\n        for r, c in pts:\n            v = int(g[r, c])\n            counts[v] = counts.get(v, 0) + 1\n        if len(counts) != 3:\n            continue\n\n        bg_col = max(counts, key=counts.get)\n        others = [(cnt, col) for col, cnt in counts.items() if col != bg_col]\n        if len(others) < 2:\n            continue\n        others.sort()  # ascending by count\n        if others[0][0] == others[1][0]:\n            # Tie: choose center as the color closer to the rectangle center.\n            rc = np.array([(r0 + r1) / 2.0, (c0 + c1) / 2.0])\n            cols = [others[0][1], others[1][1]]\n            cents = []\n            for col in cols:\n                pts_col = np.array([(r, c) for r, c in pts if int(g[r, c]) == col], dtype=float)\n                cents.append((np.sum((pts_col.mean(axis=0) - rc) ** 2), col))\n            cents.sort()\n            center_col = cents[0][1]\n            indicator_col = cents[1][1]\n        else:\n            indicator_col = others[0][1]\n            center_col = others[-1][1]\n\n        center = [(r, c) for r, c in pts if int(g[r, c]) == center_col]\n        indic = [(r, c) for r, c in pts if int(g[r, c]) == indicator_col]\n        if not center or not indic:\n            continue\n\n        cc = np.mean(np.array(center, dtype=float), axis=0)\n        ci = np.mean(np.array(indic, dtype=float), axis=0)\n        vr, vc = (ci - cc).tolist()\n        dr = 0 if abs(vr) < 1e-6 else (1 if vr > 0 else -1)\n        dc = 0 if abs(vc) < 1e-6 else (1 if vc > 0 else -1)\n        if dr == 0 and dc == 0:\n            continue\n\n        prev = best.get(bg_col)\n        if prev is None or len(pts) > prev[0]:\n            best[bg_col] = (len(pts), (dr, dc))\n\n    return {k: v for k, (_, v) in best.items()}\n\n\ndef _slide_points(region_set: set[tuple[int, int]], points: list[tuple[int, int]], dr: int, dc: int) -> list[tuple[int, int]]:\n    if not points:\n        return []\n    # Process from the far end (closest to destination boundary) inward.\n    points_sorted = sorted(points, key=lambda p: (dr * p[0] + dc * p[1], p[0], p[1]), reverse=True)\n    occupied = set()\n    out_pts = []\n    for r0, c0 in points_sorted:\n        r, c = r0, c0\n        while True:\n            nr, nc = r + dr, c + dc\n            if (nr, nc) not in region_set:\n                break\n            # For diagonal steps, disallow \"corner cutting\": both orthogonal intermediates must be inside the region.\n            if dr != 0 and dc != 0:\n                if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n                    break\n            if (nr, nc) in occupied:\n                break\n            r, c = nr, nc\n        occupied.add((r, c))\n        out_pts.append((r, c))\n    return out_pts\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n    h, w = canvas_mask.shape\n    sr, sc = seed\n    if not canvas_mask[sr, sc]:\n        return None\n    blob = {(sr, sc)}\n    frontier = []\n    def push_neighbors(r, c):\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:\n                frontier.append((nr, nc))\n    push_neighbors(sr, sc)\n    while len(blob) < target_size and frontier:\n        idx = rng.randrange(len(frontier))\n        r, c = frontier.pop(idx)\n        if (r, c) in blob or not canvas_mask[r, c]:\n            continue\n        blob.add((r, c))\n        push_neighbors(r, c)\n    if len(blob) < target_size:\n        return None\n","exit_code":0,"status":"completed"}}
