{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc 'files=(/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py /home/lixinyu/snap/new/ARC_code/eval/7491f3cf.py /home/lixinyu/snap/new/ARC_code/train/d749d46f.py)\nfor f in \"${files[@]}\"; do\n  echo \"===== $f : main =====\"\n  m=$(rg -n \"''^def main\" \"$f\" | cut -d: -f1)\n  g=$(rg -n \"''^def generate_input\" \"$f\" | cut -d: -f1)\n  sed -n \"${m},$((m+120))p\" \"$f\"\n  echo \"===== $f : generate_input =====\"\n  sed -n \"${g},$((g+170))p\" \"$f\"\n done'","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py : main =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\ndef _get_enclosed_holes(sprite):\n    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n    h, w = sprite.shape\n    return [pts for pts in components_mask(~sprite, connectivity=4)\n            if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n\n\ndef _make_diamond():\n    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n    s = np.zeros((3, 3), dtype=bool)\n    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n    return s\n\n\ndef _make_hollow_sprite(h, w, rng):\n    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n    sprite = np.ones((h, w), dtype=bool)\n    if h >= 3 and w >= 3:\n        sprite[1:-1, 1:-1] = False\n    # Optionally add internal horizontal wall\n    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n        br = rng.randint(2, h - 2)\n        n = rng.randint(1, w - 2)\n        s = rng.randint(1, w - 1 - n + 1)\n        sprite[br, s:s + n] = True\n    # Optionally add internal vertical wall\n    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n        bc = rng.randint(2, w - 2)\n        n = rng.randint(1, h - 2)\n        s = rng.randint(1, h - 1 - n + 1)\n        sprite[s:s + n, bc] = True\n    # Optionally remove border cells for irregularity\n    if rng.random() < _P_BORDER_REMOVAL:\n        bcells = [(r, c) for r in range(h) for c in range(w)\n                  if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n        rng.shuffle(bcells)\n        for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n            test = sprite.copy()\n            test[cr, cc] = False\n            if _get_enclosed_holes(test):\n                sprite = test\n    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n        return None\n    return sprite\n\n\ndef _choose_colors(rng, N, num_filled):\n    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n    all_c = list(range(1, 10))\n    rng.shuffle(all_c)\n    border_keys = all_c[:N]\n    rng.shuffle(all_c)\n    fill_values = all_c[:N]\n    dist_cands = [c for c in range(1, 10) if c not in border_keys]\n    distractor_color = rng.choice(dist_cands)\n    mapping = dict(zip(border_keys, fill_values))\n    filled_keys = rng.sample(border_keys, num_filled)\n    return border_keys, fill_values, distractor_color, mapping, filled_keys\n\n\ndef _build_palette(side, border_keys, fill_values):\n    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n    N = len(border_keys)\n    if side in ('top', 'bottom'):\n===== /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py : generate_input =====\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n===== /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py : main =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, table, frame, and slot dimensions.\nCANVAS_MIN, CANVAS_MAX = 13, 19\nTABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\nROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\nAXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n\n# Object and palette sampling limits.\nN_COLORS, MAX_OBJECT_COLORS = 10, 6\nMAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\nOBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n\n# Rejection sampling cap.\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_axis_options(n_slots, slot_min, slot_max):\n    options = []\n\n    def rec_slots(i, cur):\n        if i == n_slots:\n            rec_seps(0, [], cur)\n            return\n        for size in range(slot_min, slot_max + 1):\n            rec_slots(i + 1, cur + [size])\n\n    def rec_seps(i, cur, slots):\n        if i == n_slots - 1:\n            for before in AXIS_OUTER_OPTIONS:\n                for after in AXIS_OUTER_OPTIONS:\n                    for pad_before in AXIS_PADDING_OPTIONS:\n                        for pad_after in AXIS_PADDING_OPTIONS:\n                            total = (\n                                before\n                                + after\n                                + pad_before\n                                + pad_after\n                                + sum(slots)\n                                + sum(cur)\n                            )\n                            if 13 <= total <= 19:\n                                options.append(\n                                    (\n                                        tuple(slots),\n                                        tuple(cur),\n                                        before,\n                                        after,\n                                        pad_before,\n                                        pad_after,\n                                        total,\n                                )\n                            )\n            return\n        for sep in AXIS_SEPARATOR_OPTIONS:\n            rec_seps(i + 1, cur + [sep], slots)\n\n    rec_slots(0, [])\n    return options\n\n\ndef _gen_positions(axis):\n    sizes, seps, outer_before, _outer_after, pad_before, _pad_after, _total = axis\n===== /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py : generate_input =====\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid ac6f9922 input\")\n===== /home/lixinyu/snap/new/ARC_code/eval/7491f3cf.py : main =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Composite two pattern tiles into a fourth panel using flood-fill from an indicator pixel.\n\n    Input structure:\n    - Four 5×5 panels in one row, border-separated.\n    - Panel 0: cue pixels = wall boundary (8-connected, edge-to-edge, through center)\n               + one 8-isolated indicator pixel.\n    - Panels 1–2: source patterns. Panel 3: blank (to fill).\n\n    Rule:\n    - Flood-fill (4-conn) from indicator, blocked by wall → inside region.\n    - Inside → non-bg from panel 1; outside → non-bg from panel 2.\n    - Wall → panel 1 if non-bg; panel 2 fallback when wall is 4-connected.\n\n    Key insight: The cue panel's isolated indicator and wall partition the tile into inside/outside masks that select between the two source panels.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n\n    border = int(g[0, 0])\n    tiles = [g[1:6, 1 + 6 * j : 1 + 6 * j + 5].copy() for j in range(4)]\n    t0, t1, t2, _t3 = tiles\n    b = int(Counter(t1.flatten()).most_common(1)[0][0])\n    assert border != b, \"border color must differ from tile background\"\n\n    t0_bg = int(Counter(t0.flatten()).most_common(1)[0][0])\n    cue_set = {(int(r), int(c)) for r in range(5) for c in range(5) if int(t0[r, c]) != t0_bg}\n    assert cue_set, \"no cue pixels found\"\n\n    # --- Indicator = the unique 8-isolated cue pixel ---\n    indicator = None\n    for r, c in cue_set:\n        if not any((nr, nc) in cue_set for nr, nc in neighbors8(r, c)):\n            assert indicator is None, \"multiple 8-isolated cue pixels\"\n            indicator = (r, c)\n    assert indicator is not None, \"no 8-isolated cue pixel found\"\n\n    # Indicator must sit at a tile corner or edge midpoint\n    valid_pos = {(0,0),(0,4),(4,0),(4,4),(0,2),(2,0),(2,4),(4,2)}\n    assert indicator in valid_pos, f\"indicator {indicator} not at corner/edge-midpoint\"\n\n    wall = cue_set - {indicator}\n\n    # --- Structural assertions (feedback for generate_input agents) ---\n    assert (2, 2) in wall, \"wall must pass through the grid center (2,2)\"\n\n    # Wall must be symmetric about the line from indicator to center (2,2)\n    ir, ic = indicator\n    dr, dc = 2 - ir, 2 - ic\n    if dr == 0:\n        _refl = lambda r, c: (4 - r, c)\n    elif dc == 0:\n        _refl = lambda r, c: (r, 4 - c)\n    elif dr * dc > 0:\n        _refl = lambda r, c: (c, r)\n    else:\n        _refl = lambda r, c: (4 - c, 4 - r)\n    assert wall == {_refl(r, c) for r, c in wall}, \"wall must be symmetric about indicator→center axis\"\n\n    sides_touched = set()\n    for r, c in wall:\n        if r == 0: sides_touched.add(\"top\")\n        if r == 4: sides_touched.add(\"bottom\")\n        if c == 0: sides_touched.add(\"left\")\n        if c == 4: sides_touched.add(\"right\")\n    assert len(sides_touched) >= 2, f\"wall must span edge-to-edge, only touches {sides_touched}\"\n\n    # --- Flood fill inside region ---\n    EMPTY, WALL, INSIDE = 0, 1, 2\n    tmp = np.zeros((5, 5), dtype=int)\n    for r, c in wall:\n        tmp[r, c] = WALL\n    flood_fill(tmp, indicator[0], indicator[1], INSIDE, connectivity=4)\n    inside = {(int(r), int(c)) for r, c in np.argwhere(tmp == INSIDE)}\n\n    outside = {(r, c) for r in range(5) for c in range(5)} - inside - wall\n    assert outside, \"wall must partition the grid — outside region is empty\"\n\n    # Wall 4-connectivity determines boundary blending behavior:\n    # axis-aligned walls (4-connected) allow t2 fallback; diagonal walls don't.\n    wall_mask = np.zeros((5, 5), dtype=bool)\n    for r, c in wall:\n        wall_mask[r, c] = True\n    _, n_comp = label_mask(wall_mask, connectivity=4)\n    wall_4conn = (n_comp == 1)\n\n    # --- Build output tile ---\n    out3 = np.full((5, 5), b, dtype=int)\n    for r in range(5):\n        for c in range(5):\n            v1, v2 = int(t1[r, c]), int(t2[r, c])\n            if (r, c) in inside:\n                if v1 != b:\n                    out3[r, c] = v1\n            elif (r, c) in wall:\n                if v1 != b:\n                    out3[r, c] = v1\n                elif wall_4conn and v2 != b:\n                    out3[r, c] = v2\n            else:\n                if v2 != b:\n                    out3[r, c] = v2\n\n    out = g.copy()\n    out[1:6, 1 + 6 * 3 : 1 + 6 * 3 + 5] = out3\n    return out\n\n# --------------- generator (subagent) ---------------\n\n# ── Tunables ──────────────────────────────────────────────────────────────────\nTILE_SZ = 5                    # each panel is 5x5\nGRID_ROWS, GRID_COLS = 7, 25  # fixed output grid shape\nNUM_COLORS = 10                # ARC color palette size\n\nT1_MIN_PX, T1_MAX_PX = 8, 12  # tile-1 non-bg pixel range\nT2_MIN_PX, T2_MAX_PX = 9, 12  # tile-2 non-bg pixel range\nORBIT_INCLUDE_PROB = 0.55      # per-orbit inclusion probability for pattern sampling\nPATTERN_RETRIES = 200          # max retries per _sample_symmetric_pattern call\nGEN_RETRIES = 300              # max retries in generate_input outer loop\nLBEND_PROB = 0.2               # L-bend wall probability (eval ratio ~4:1 straight:L-bend)\n\n===== /home/lixinyu/snap/new/ARC_code/eval/7491f3cf.py : generate_input =====\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(f\"generate_input failed after {GEN_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/d749d46f.py : main =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.\n\n    Input structure\n    The grid has one background color and one foreground color; the foreground forms\n    separate solid rectangles, ordered from left to right.\n\n    Rule\n    Build a 10-row background canvas whose width is the packed width of the wide\n    versions of the rectangles. For each source rectangle, paint a top-aligned\n    rectangle of shape min(h,w) by max(h,w), with one background column between\n    consecutive rectangles. Then, starting again from the left edge, paint a\n    bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,\n    again separated by one background column.\n\n    Key insight\n    The input rectangles are not copied in their original orientations; each object\n    contributes one horizontal-facing and one vertical-facing normalized rectangle,\n    preserving left-to-right object order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n    fg = fg_colors[0]\n\n    components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n    assert components\n    components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n\n    dims: list[tuple[int, int]] = []\n    for obj in components:\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert obj[\"area\"] == h * w\n        dims.append((h, w))\n\n    out_h = 10\n    out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n    _assert_output_footprints_disjoint(dims)\n    out = np.full((out_h, out_w), bg, dtype=int)\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[:short, c : c + long] = fg\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[out_h - long : out_h, c : c + short] = fg\n        c += short + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\n# Rectangle counts and dimensions.\nRECT_COUNT_MIN = 4\nRECT_COUNT_MAX = 6\nSHORT_SIDE_MIN = 1\nSHORT_SIDE_MAX = 3\nSIDE_SUM_MAX = 10\nLONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN\n\n# Canvas and packing constraints.\nARC_GRID_MAX = 30\nOUTPUT_HEIGHT = 10\nGAP_WIDTH = 1\n\n# Retry policy.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_d749d46f_output_footprints_disjoint(dims):\n    occupied = set()\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, c) for r in range(short) for c in range(col, col + long)}\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += long + GAP_WIDTH\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, c)\n            for r in range(OUTPUT_HEIGHT - long, OUTPUT_HEIGHT)\n            for c in range(col, col + short)\n        }\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += short + GAP_WIDTH\n\n    return True\n\n\ndef _sample_dimensions(n_rects):\n    \"\"\"Sample source rectangle dimensions under the output-width budget.\"\"\"\n    dims = []\n    remaining_budget = ARC_GRID_MAX - GAP_WIDTH * (n_rects - 1)\n\n    for i in range(n_rects):\n        rects_left = n_rects - i\n        min_needed = rects_left - 1\n        max_for_this = min(remaining_budget - min_needed, LONG_SIDE_MAX)\n        if max_for_this < SHORT_SIDE_MIN:\n            return None\n===== /home/lixinyu/snap/new/ARC_code/train/d749d46f.py : generate_input =====\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'files=(/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py /home/lixinyu/snap/new/ARC_code/train/9b5080bb.py /home/lixinyu/snap/new/ARC_code/train/34cfa167.py /home/lixinyu/snap/new/ARC_code/eval/581f7754.py)\nfor f in \"${files[@]}\"; do\n  echo \"===== $f : main =====\"\n  m=$(rg -n \"''^def main\" \"$f\" | cut -d: -f1)\n  g=$(rg -n \"''^def generate_input\" \"$f\" | cut -d: -f1)\n  sed -n \"${m},$((m+120))p\" \"$f\"\n  echo \"===== $f : generate_input =====\"\n  sed -n \"${g},$((g+170))p\" \"$f\"\n done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'files=(/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py /home/lixinyu/snap/new/ARC_code/train/9b5080bb.py /home/lixinyu/snap/new/ARC_code/train/34cfa167.py /home/lixinyu/snap/new/ARC_code/eval/581f7754.py)\nfor f in \"${files[@]}\"; do\n  echo \"===== $f : main =====\"\n  m=$(rg -n \"''^def main\" \"$f\" | cut -d: -f1)\n  g=$(rg -n \"''^def generate_input\" \"$f\" | cut -d: -f1)\n  sed -n \"${m},$((m+120))p\" \"$f\"\n  echo \"===== $f : generate_input =====\"\n  sed -n \"${g},$((g+170))p\" \"$f\"\n done'","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py : main =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n===== /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py : generate_input =====\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\n===== /home/lixinyu/snap/new/ARC_code/train/9b5080bb.py : main =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor the small defect bars on each shared-color object with the opposite panel color.\n\n    Input structure\n    - The grid contains two large panel colors and one shared object color.\n    - Each shared-color object is a mostly solid rectangle inside exactly one panel.\n    Rule\n    - Find the near-solid rectangular core of each object.\n    - Missing core pixels and one-cell protrusions define two-pixel bars perpendicular to the nearest core edge.\n    - Recolor those bars with the other panel color; leave all other pixels unchanged.\n    Key insight\n    - The colors to add are not tied to numeric ids: each object's surrounding panel identifies the opposite panel color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = g.copy()\n\n    object_color, components, panel_colors = _object_components(g)\n    for coords in components:\n        neighbors = _neighbor_colors(g, coords, object_color)\n        assert len(neighbors) == 1\n        panel_color = next(iter(neighbors))\n        target_colors = panel_colors - {panel_color}\n        assert len(target_colors) == 1\n        target_color = next(iter(target_colors))\n\n        rect = _core_rect(coords)\n        for r, c in _defect_bar_cells(coords, rect):\n            assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1]\n            assert int(g[r, c]) in {object_color, panel_color}\n            out[r, c] = target_color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Palette and canvas bounds.\nCOLOR_IDS = list(range(10))\nGRID_SIZE_MIN = 20\nGRID_SIZE_MAX = 27\n\n# Panel layout bounds and options.\nMIN_PANEL_DIM = 9\nMIN_VISIBLE_BORDERS = 2\nBORDER_CHOICES = (0, 1)\nOFFSET_MIN = 2\nOFFSET_MAX = 6\nHORIZONTAL_LAYOUT = 0\nVERTICAL_LAYOUT = 1\nHORIZONTAL_OFFSETS = (\"left\", \"right\", \"none\")\nVERTICAL_OFFSETS = (\"top\", \"bottom\", \"none\")\n\n# Object geometry and placement constraints.\nOBJECTS_PER_PANEL = (1, 2)\nCORE_H_MIN = 3\nCORE_H_MAX = 7\nCORE_W_MIN = 3\nCORE_W_MAX = 9\nDEFECT_COUNT_MIN = 1\nDEFECT_COUNT_MAX = 3\nDEFECT_SIDES = (\"top\", \"bottom\", \"left\", \"right\")\nDEFECT_TYPES = (\"missing\", \"protrusion\")\nPANEL_MARGIN = 1\nOBJECT_GAP = 2\nMAX_PLACE_TRIES = 30\n\n# Generation retry budget.\nMAX_GENERATE_ATTEMPTS = 300\n\n\ndef _choose_palette() -> tuple[int, int, int, int]:\n    colors = COLOR_IDS[:]\n    random.shuffle(colors)\n    return tuple(colors[:4])\n\n\ndef _choose_borders() -> tuple[int, int, int, int]:\n    borders = [random.choice(BORDER_CHOICES) for _ in range(4)]\n    while sum(borders) < MIN_VISIBLE_BORDERS:\n        borders[random.randint(0, 3)] = 1\n    return tuple(borders)\n\n\ndef _build_horizontal_panels(\n    grid: np.ndarray,\n    panel_a_color: int,\n    panel_b_color: int,\n) -> list[tuple[int, int, int, int, int]] | None:\n    \"\"\"Create two panels sharing a horizontal border; returns panel records.\"\"\"\n    H, W = grid.shape\n    split_r = random.randint(MIN_PANEL_DIM, H - MIN_PANEL_DIM - 1)\n    border_top, border_bot, border_left, border_right = _choose_borders()\n\n    pa_height = split_r - border_top\n    pb_height = H - border_bot - split_r\n    if pa_height < MIN_PANEL_DIM or pb_height < MIN_PANEL_DIM:\n        return None\n\n    offset_side = random.choice(HORIZONTAL_OFFSETS)\n    if offset_side == \"none\":\n        pa_c0, pa_c1 = border_left, W - 1 - border_right\n        pb_c0, pb_c1 = border_left, W - 1 - border_right\n    elif offset_side == \"left\":\n        offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_c0 = border_left\n            pa_c1 = W - 1 - border_right\n            pb_c0 = border_left + offset_cols\n            pb_c1 = W - 1 - border_right\n        else:\n            pa_c0 = border_left + offset_cols\n            pa_c1 = W - 1 - border_right\n            pb_c0 = border_left\n            pb_c1 = W - 1 - border_right\n    else:\n        offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_c0 = border_left\n            pa_c1 = W - 1 - border_right - offset_cols\n            pb_c0 = border_left\n            pb_c1 = W - 1 - border_right\n        else:\n===== /home/lixinyu/snap/new/ARC_code/train/9b5080bb.py : generate_input =====\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATE_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATE_ATTEMPTS} attempts\")\n===== /home/lixinyu/snap/new/ARC_code/train/34cfa167.py : main =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.\n\n    Input structure:\n    - The background is the dominant color.\n    - Two same-color solid rectangular anchors of the same size sit on opposite\n      diagonal corners, with the first anchor above-left of the second.\n    - The upper-left anchor has two one-cell-thick vertical control bars to its\n      right and two one-cell-thick horizontal control bars below it.\n\n    Rule:\n    - Copy the anchor rectangle into the two missing corners of the implied\n      larger rectangle.\n    - Repeat the right-side control bars horizontally between the left and right\n      anchors, using their spacing as the period, and draw the outer top and\n      bottom borders in the first right-control color.\n    - Repeat the below-side control bars vertically between the top and bottom\n      anchors, using the same period, and draw the outer left and right borders\n      in the first below-control color.\n\n    Key insight: The small control bars are the first two ticks of two periodic\n    frame patterns; the diagonal anchor supplies the opposite corner and the\n    missing two anchor copies.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    source, dest, right_controls, below_controls = _find_structure(g, bg)\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    dr0, dc0, dr1, dc1 = dest[\"bbox\"]\n    anchor_color = int(source[\"color\"])\n    assert int(dest[\"color\"]) == anchor_color, \"anchor colors must match\"\n    assert bbox_h(source[\"bbox\"]) == bbox_h(dest[\"bbox\"]), \"anchor heights must match\"\n    assert bbox_w(source[\"bbox\"]) == bbox_w(dest[\"bbox\"]), \"anchor widths must match\"\n    assert sr0 > 0 and sc0 > 0, \"upper-left anchor must have space for outer frame\"\n    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \"lower-right anchor must have space for outer frame\"\n\n    right_offsets = [int(comp[\"bbox\"][1] - sc1) for comp in right_controls]\n    below_offsets = [int(comp[\"bbox\"][0] - sr1) for comp in below_controls]\n    assert right_offsets == below_offsets and right_offsets[0] == 1, \"control offsets must match from the anchor edge\"\n    step = int(right_offsets[1] - right_offsets[0])\n    assert step > 0, \"control bars must be separated\"\n    period = 2 * step\n    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, \"right frame must close next to the destination anchor\"\n    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, \"below frame must close next to the destination anchor\"\n\n    right_colors = [int(comp[\"color\"]) for comp in right_controls]\n    below_colors = [int(comp[\"color\"]) for comp in below_controls]\n    out = g.copy()\n\n    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)\n    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)\n\n    first_c = int(sc1 + right_offsets[0])\n    last_c = int(dc0 - 1)\n    for c in range(first_c, last_c + 1):\n        offset = int(c - sc1)\n        if (offset - right_offsets[0]) % period == 0:\n            color = right_colors[0]\n        elif (offset - right_offsets[1]) % period == 0:\n            color = right_colors[1]\n        else:\n            continue\n        _paint_rect(out, bg, sr0, c, sr1, c, color)\n        _paint_rect(out, bg, dr0, c, dr1, c, color)\n\n    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])\n    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])\n\n    first_r = int(sr1 + below_offsets[0])\n    last_r = int(dr0 - 1)\n    left_c = int(sc0 - 1)\n    right_c = int(dc1 + 1)\n    for r in range(first_r, last_r + 1):\n        _paint(out, bg, r, left_c, below_colors[0])\n        _paint(out, bg, r, right_c, below_colors[0])\n\n        offset = int(r - sr1)\n        if (offset - below_offsets[0]) % period == 0:\n            _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])\n            _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])\n        elif (offset - below_offsets[1]) % period == 0:\n            _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])\n            _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color sampling.\nCOLOR_COUNT, NON_BG_COLOR_COUNT = 10, 4\n\n# Anchor/repetition geometry.\nANCHOR_SIZE_RANGE = (1, 5)\nREPEAT_COUNT_RANGE = (2, 5)\nCONTROL_OFFSETS = (1, 3)\nFRAME_PERIOD, DEST_ANCHOR_GAP, STRUCTURE_FIXED_PAD = 4, 2, 3\n\n# Canvas/margins.\nCANVAS_MIN_SIZE, CANVAS_MAX_SIZE = 16, 30\nMARGIN_CHOICES = range(4)\nMIN_TOTAL_MARGIN, SOURCE_OUTER_MARGIN = 1, 1\n\n# Retry.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_paint_rect(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int) -> None:\n    grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)\n\n\ndef _choose_margins(struct_len: int) -> tuple[int, int]:\n    pairs = [\n        (before, after)\n        for before in MARGIN_CHOICES\n        for after in MARGIN_CHOICES\n        if MIN_TOTAL_MARGIN <= before + after\n        and CANVAS_MIN_SIZE <= struct_len + before + after <= CANVAS_MAX_SIZE\n    ]\n    return pairs[int(np.random.randint(len(pairs)))]\n===== /home/lixinyu/snap/new/ARC_code/train/34cfa167.py : generate_input =====\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n===== /home/lixinyu/snap/new/ARC_code/eval/581f7754.py : main =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n===== /home/lixinyu/snap/new/ARC_code/eval/581f7754.py : generate_input =====\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 581f7754 input\")\n","exit_code":0,"status":"completed"}}
