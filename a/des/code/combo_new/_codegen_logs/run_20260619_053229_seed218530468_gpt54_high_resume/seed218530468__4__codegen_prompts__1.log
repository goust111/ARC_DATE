{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed218530468/4/1.py')\nmod = SourceFileLoader('new_arc_task_semantic', str(p)).load_module()\n\nfor i in range(200):\n    inp = mod.generate_input()\n    out = mod.main(inp)\n    frames = mod._find_frames(inp, mod.BG)\n    assert frames, 'no frames found'\n    for frame in frames:\n        r0, c0, r1, c1 = frame['bbox']\n        side = frame['side']\n        gap = frame['gap']\n        color = frame['marker_color']\n        count = frame['count']\n        target = mod._target_cells(frame['bbox'], side, gap)\n        interior = out[r0 + 1:r1, c0 + 1:c1]\n        non_bg = np.argwhere(interior \"'!= mod.BG)\n        grey = frame['\"'color']\n        for rr, cc in non_bg:\n            val = int(interior[rr, cc])\n            assert val == color, f'unexpected interior color {val}'\n        expected = set(target[:count])\n        for r in range(r0 + 1, r1):\n            for c in range(c0 + 1, c1):\n                val = int(out[r, c])\n                if (r, c) in expected:\n                    assert val == color, 'missing bar pixel'\n                else:\n                    assert val == mod.BG, 'extra interior residue'\n        assert int(out[gap]) == mod.BG\n        border = mod._border_positions(r0, c0, r1, c1)\n        border.remove(gap)\n        assert all(int(out[r, c]) == grey for r, c in border)\nprint('semantic_ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
