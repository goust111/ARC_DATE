{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, math\nfrom collections import deque\n\ndef conn(mask,val):\n    h=len(mask); w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    if not pts: return False\n    q=deque([pts[0]])\n    seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef touches(mask,val):\n    h=len(mask); w=len(mask[0])\n    return [\n        any(mask[0][c]==val for c in range(w)),\n        any(mask[h-1][c]==val for c in range(w)),\n        any(mask[r][0]==val for r in range(h)),\n        any(mask[r][w-1]==val for r in range(h)),\n    ]\n\ndef score(mask):\n    h=len(mask); w=len(mask[0])\n    s=0\n    for val in (True,False):\n        t=touches(mask,val)\n        s += sum(t)\n        s += 4 if conn(mask,val) else 0\n    # prefer balanced and irregular\n    a=sum(sum(row) for row in mask); n=h*w\n    s -= abs(a - n/2)/n\n    # avoid full monochrome rows/cols\n    s += sum(0.2 for r in range(h) if any(mask[r][c] for c in range(w)) and any(not mask[r][c] for c in range(w)))\n    s += sum(0.2 for c in range(w) if any(mask[r][c] for r in range(h)) and any(not mask[r][c] for r in range(h)))\n    return s\n\ndef find(h,w):\n    for restart in range(200):\n        m=[[random.random()<0.5 for c in range(w)] for r in range(h)]\n        cur=score(m)\n        T=2.5\n        for step in range(10000):\n            if conn(m,True) and conn(m,False) and all(touches(m,True)) and all(touches(m,False)):\n                return m\n            r=random.randrange(h); c=random.randrange(w)\n            m[r][c]=not m[r][c]\n            if all(all(row) for row in [m]):\n                pass\n            new=score(m)\n            if new >= cur or random.random() < math.exp((new-cur)/max(T,1e-6)):\n                cur=new\n            else:\n                m[r][c]=not m[r][c]\n            T*=0.9997\n    return None\n\nfor dims in [(5,5),(5,6),(6,6),(6,7),(7,7),(8,8)]:\n    m=find(*dims)\n    print('dims',dims,'found',m is not None)\n    if m:\n        for r in range(dims[0]):\n            print(''.join('#' if m[r][c] else '.' for c in range(dims[1])))\n        print('---')\nPY\"","aggregated_output":"dims (5, 5) found False\ndims (5, 6) found False\ndims (6, 6) found False\ndims (6, 7) found False\ndims (7, 7) found False\ndims (8, 8) found False\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\n\ndef conn(mask):\n    h=len(mask); w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]]\n    if not pts: return False\n    q=deque([pts[0]]); seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc] and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef touch(mask):\n    h=len(mask); w=len(mask[0])\n    return [any(mask[0][c] for c in range(w)), any(mask[h-1][c] for c in range(w)), any(mask[r][0] for r in range(h)), any(mask[r][w-1] for r in range(h))]\n\ndef build(h,w,tries=10000):\n    assert (h*w)%2==0 and h%2==0\n    top=h//2\n    for _ in range(tries):\n        A=[[r<top for c in range(w)] for r in range(h)]\n        # candidate additions in bottom half, starting from row top\n        frontier=[(top, c) for c in range(w)]\n        random.shuffle(frontier)\n        seen_add=set()\n        for _step in range(200):\n            if all(touch(A)) and conn(A):\n                return A\n            cands=[]\n            for r in range(top,h):\n                for c in range(w):\n                    if A[r][c]:\n                        continue\n                    # must attach to existing A\n                    if not any(0<=r+dr<h and 0<=c+dc<w and A[r+dr][c+dc] for dr,dc in ((1,0),(-1,0),(0,1),(0,-1))):\n                        continue\n                    rr,cc=h-1-r,w-1-c\n                    if not A[rr][cc]:\n                        continue\n                    cands.append((r,c))\n            random.shuffle(cands)\n            moved=False\n            for r,c in cands[:50]:\n                rr,cc=h-1-r,w-1-c\n                A[r][c]=True; A[rr][cc]=False\n                if conn(A):\n                    moved=True\n                    break\n                A[r][c]=False; A[rr][cc]=True\n            if not moved:\n                break\n    return None\n\nfor dims in [(4,6),(6,6),(6,8),(8,8),(8,10)]:\n    m=build(*dims)\n    print('dims',dims,'found',m is not None)\n    if m:\n        for r in range(dims[0]): print(''.join('#' if m[r][c] else '.' for c in range(dims[1])))\n        print('A conn',conn(m),'touch',touch(m),'antisym',all(m[r][c] \"'!= m[dims[0]-1-r][dims[1]-1-c] for r in range(dims[0]) for c in range(dims[1])))\n        print('\"'---')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
