{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools\nfrom collections import deque\n\ndef conn(mask,h,w,val=True):\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    if not pts: return False\n    q=deque([pts[0]])\n    seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef touch(mask,h,w,val=True):\n    return all([\n        any(mask[0][c]==val for c in range(w)),\n        any(mask[h-1][c]==val for c in range(w)),\n        any(mask[r][0]==val for r in range(h)),\n        any(mask[r][w-1]==val for r in range(h)),\n    ])\n\ndef show(mask,h,w):\n    for r in range(h):\n        print(''.join('#' if mask[r][c] else '.' for c in range(w)))\n\nfor h,w in [(4,4),(4,5),(5,5)]:\n    n=h*w\n    found=0\n    for bits in range(1,1<<n):\n        if bits & 1 ==0: pass\n        mask=[[False]*w for _ in range(h)]\n        a=0\n        for i in range(n):\n            if bits>>i &1:\n                r=i//w; c=i%w; mask[r][c]=True; a+=1\n        if a<4 or n-a<4: continue\n        if not conn(mask,h,w,True) or not conn(mask,h,w,False): continue\n        if not touch(mask,h,w,True) or not touch(mask,h,w,False): continue\n        print('found',h,w,'area',a)\n        show(mask,h,w)\n        print()\n        found=1\n        break\n    print('done',h,w,found)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
