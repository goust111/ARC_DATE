{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\n\ndef maze(h,w,seed=0):\n    # h,w odd >=5 ; True=wall(A), False=passage(B)\n    g=[[True]*w for _ in range(h)]\n    cells=[(r,c) for r in range(1,h,2) for c in range(1,w,2)]\n    for r,c in cells: g[r][c]=False\n    vis={(1,1)}\n    stack=[(1,1)]\n    while stack:\n        r,c=stack[-1]\n        nbr=[]\n        for dr,dc in ((2,0),(-2,0),(0,2),(0,-2)):\n            nr,nc=r+dr,c+dc\n            if 1<=nr<h-1 and 1<=nc<w-1 and (nr,nc) not in vis:\n                nbr.append((nr,nc,dr//2,dc//2))\n        if nbr:\n            nr,nc,mr,mc=random.choice(nbr)\n            vis.add((nr,nc))\n            g[r+mr][c+mc]=False\n            stack.append((nr,nc))\n        else:\n            stack.pop()\n    # open four side entrances connected to passages\n    openings=[(0,1),(h-1,w-2),(1,0),(h-2,w-1)]\n    for r,c in openings: g[r][c]=False\n    return g\n\ndef conn(mask,val):\n    h=len(mask); w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    if not pts: return False\n    q=deque([pts[0]])\n    seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef touch(mask,val):\n    h=len(mask); w=len(mask[0])\n    return [any(mask[0][c]==val for c in range(w)), any(mask[h-1][c]==val for c in range(w)), any(mask[r][0]==val for r in range(h)), any(mask[r][w-1]==val for r in range(h))]\nfor dims in [(5,5),(7,7),(7,9),(9,9)]:\n    for _ in range(5):\n        m=maze(*dims)\n        if conn(m,True) and conn(m,False) and all(touch(m,True)) and all(touch(m,False)):\n            print('found',dims)\n            for r in range(dims[0]): print(''.join('#' if m[r][c] else '.' for c in range(dims[1])))\n            print('---')\n            break\n    else:\n        print('none',dims)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
