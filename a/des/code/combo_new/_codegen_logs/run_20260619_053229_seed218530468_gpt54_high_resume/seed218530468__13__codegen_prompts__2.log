{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\n\ndef conn(mask,val=True):\n    h=len(mask); w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    if not pts: return False\n    q=deque([pts[0]])\n    seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef touch(mask,val=True):\n    h=len(mask); w=len(mask[0])\n    return all([\n        any(mask[0][c]==val for c in range(w)),\n        any(mask[h-1][c]==val for c in range(w)),\n        any(mask[r][0]==val for r in range(h)),\n        any(mask[r][w-1]==val for r in range(h)),\n    ])\n\ndef grow(h,w,k):\n    cells={(random.randrange(h),random.randrange(w))}\n    while len(cells)<k:\n        frontier=[]\n        for r,c in list(cells):\n            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                nr,nc=r+dr,c+dc\n                if 0<=nr<h and 0<=nc<w and (nr,nc) not in cells:\n                    frontier.append((nr,nc))\n        if not frontier: return None\n        cells.add(random.choice(frontier))\n    mask=[[False]*w for _ in range(h)]\n    for r,c in cells: mask[r][c]=True\n    return mask\n\nfor h,w in [(5,5),(5,6),(6,6),(6,7),(7,7)]:\n    found=False\n    for _ in range(200000):\n        k=random.randint(h+w-2, h*w-(h+w-2))\n        m=grow(h,w,k)\n        if m is None: continue\n        if not touch(m,True): continue\n        if not conn(m,False): continue\n        if not touch(m,False): continue\n        print('found',h,w,'k',k)\n        for r in range(h): print(''.join('#' if m[r][c] else '.' for c in range(w)))\n        print('---')\n        found=True\n        break\n    print('done',h,w,found)\nPY\"","aggregated_output":"done 5 5 False\ndone 5 6 False\ndone 6 6 False\ndone 6 7 False\ndone 7 7 False\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, math\nfrom collections import deque\n\ndef conn(mask,val):\n    h=len(mask); w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    if not pts: return False\n    q=deque([pts[0]])\n    seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef touches(mask,val):\n    h=len(mask); w=len(mask[0])\n    return [\n        any(mask[0][c]==val for c in range(w)),\n        any(mask[h-1][c]==val for c in range(w)),\n        any(mask[r][0]==val for r in range(h)),\n        any(mask[r][w-1]==val for r in range(h)),\n    ]\n\ndef score(mask):\n    h=len(mask); w=len(mask[0])\n    s=0\n    for val in (True,False):\n        t=touches(mask,val)\n        s += sum(t)\n        s += 4 if conn(mask,val) else 0\n    # prefer balanced and irregular\n    a=sum(sum(row) for row in mask); n=h*w\n    s -= abs(a - n/2)/n\n    # avoid full monochrome rows/cols\n    s += sum(0.2 for r in range(h) if any(mask[r][c] for c in range(w)) and any(not mask[r][c] for c in range(w)))\n    s += sum(0.2 for c in range(w) if any(mask[r][c] for r in range(h)) and any(not mask[r][c] for r in range(h)))\n    return s\n\ndef find(h,w):\n    for restart in range(200):\n        m=[[random.random()<0.5 for c in range(w)] for r in range(h)]\n        cur=score(m)\n        T=2.5\n        for step in range(10000):\n            if conn(m,True) and conn(m,False) and all(touches(m,True)) and all(touches(m,False)):\n                return m\n            r=random.randrange(h); c=random.randrange(w)\n            m[r][c]=not m[r][c]\n            if all(all(row) for row in [m]):\n                pass\n            new=score(m)\n            if new >= cur or random.random() < math.exp((new-cur)/max(T,1e-6)):\n                cur=new\n            else:\n                m[r][c]=not m[r][c]\n            T*=0.9997\n    return None\n\nfor dims in [(5,5),(5,6),(6,6),(6,7),(7,7),(8,8)]:\n    m=find(*dims)\n    print('dims',dims,'found',m is not None)\n    if m:\n        for r in range(dims[0]):\n            print(''.join('#' if m[r][c] else '.' for c in range(dims[1])))\n        print('---')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\ndef spiral(h,w):\n    top,left=0,0; bottom=h-1; right=w-1\n    out=[]\n    while top<=bottom and left<=right:\n        for c in range(left,right+1): out.append((top,c))\n        top+=1\n        for r in range(top,bottom+1): out.append((r,right))\n        right-=1\n        if top<=bottom:\n            for c in range(right,left-1,-1): out.append((bottom,c))\n            bottom-=1\n        if left<=right:\n            for r in range(bottom,top-1,-1): out.append((r,left))\n            left+=1\n    return out\n\ndef valid(h,w):\n    path=spiral(h,w)\n    n=len(path)\n    ans=[]\n    for k in range(1,n):\n        A=set(path[:k]); B=set(path[k:])\n        ok=True\n        for S in (A,B):\n            if not any(r==0 for r,c in S): ok=False\n            if not any(r==h-1 for r,c in S): ok=False\n            if not any(c==0 for r,c in S): ok=False\n            if not any(c==w-1 for r,c in S): ok=False\n        if ok: ans.append(k)\n    return ans\nfor dims in [(5,5),(5,6),(6,6),(6,7),(7,7),(8,8)]:\n    ks=valid(*dims)\n    print(dims, ks[:10], 'count', len(ks))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
