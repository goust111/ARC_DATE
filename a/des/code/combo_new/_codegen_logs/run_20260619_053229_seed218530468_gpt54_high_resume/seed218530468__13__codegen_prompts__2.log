{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\n\ndef grow(h,w,tries=5000):\n    need=h*w//2\n    for _ in range(tries):\n        start=(random.randrange(h), random.randrange(w))\n        A={start}\n        banned={(h-1-start[0], w-1-start[1])}\n        while len(A)<need:\n            frontier=[]\n            for r,c in list(A):\n                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                    nr,nc=r+dr,c+dc\n                    if 0<=nr<h and 0<=nc<w and (nr,nc) not in A and (nr,nc) not in banned:\n                        frontier.append((nr,nc))\n            if not frontier:\n                break\n            # bias toward uncovered sides\n            sides=[any(r==0 for r,c in A), any(r==h-1 for r,c in A), any(c==0 for r,c in A), any(c==w-1 for r,c in A)]\n            scored=[]\n            for cell in set(frontier):\n                r,c=cell\n                score=random.random()\n                if not sides[0]: score += 3*(h-r)\n                if not sides[1]: score += 3*(r+1)\n                if not sides[2]: score += 3*(w-c)\n                if not sides[3]: score += 3*(c+1)\n                scored.append((score,cell))\n            scored.sort(reverse=True)\n            chosen=scored[0][1] if random.random()<0.7 else random.choice(scored[:min(6,len(scored))])[1]\n            A.add(chosen)\n            banned.add((h-1-chosen[0], w-1-chosen[1]))\n        if len(A)\"'!=need:\n            continue\n        mask=[[False]*w for _ in range(h)]\n        for r,c in A: mask[r][c]=True\n        # connectivity by construction, but verify antisym full-orbit cover\n        if not all(mask[r][c] != mask[h-1-r][w-1-c] for r in range(h) for c in range(w)):\n            continue\n        if all([any(mask[0][c] for c in range(w)), any(mask[h-1][c] for c in range(w)), any(mask[r][0] for r in range(h)), any(mask[r][w-1] for r in range(h))]):\n            return mask\n    return None\n\ndef conn(mask,val=True):\n    h=len(mask);w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    if not pts: return False\n    q=deque([pts[0]]);seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc));q.append((nr,nc))\n    return len(seen)==len(pts)\nfor dims in [(4,6),(4,8),(6,6),(6,8),(6,10),(8,8),(8,10)]:\n    m=grow(*dims)\n    print('\"'dims',dims,'found',m is not None)\n    if m:\n        print('A',conn(m,True),'B',conn(m,False))\n        for r in range(dims[0]): print(''.join('#' if m[r][c] else '.' for c in range(dims[1])))\n        print('---')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
