{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom z3 import *\n\ndef find(h,w):\n    n=h*w\n    A=[[Bool(f'a_{r}_{c}') for c in range(w)] for r in range(h)]\n    rootA=[[Bool(f'ra_{r}_{c}') for c in range(w)] for r in range(h)]\n    rootB=[[Bool(f'rb_{r}_{c}') for c in range(w)] for r in range(h)]\n    dA=[[Int(f'da_{r}_{c}') for c in range(w)] for r in range(h)]\n    dB=[[Int(f'db_{r}_{c}') for c in range(w)] for r in range(h)]\n    s=Solver()\n    \n    def neigh(r,c):\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w:\n                yield nr,nc\n    \n    # nontrivial\n    s.add(Sum([If(A[r][c],1,0) for r in range(h) for c in range(w)]) >= 4)\n    s.add(Sum([If(Not(A[r][c]),1,0) for r in range(h) for c in range(w)]) >= 4)\n    # roots unique\n    s.add(Sum([If(rootA[r][c],1,0) for r in range(h) for c in range(w)]) == 1)\n    s.add(Sum([If(rootB[r][c],1,0) for r in range(h) for c in range(w)]) == 1)\n    for r in range(h):\n        for c in range(w):\n            s.add(Implies(rootA[r][c], A[r][c]))\n            s.add(Implies(rootB[r][c], Not(A[r][c])))\n            s.add(If(A[r][c], And(dA[r][c] >= 0, dA[r][c] < n), dA[r][c] == -1))\n            s.add(If(Not(A[r][c]), And(dB[r][c] >= 0, dB[r][c] < n), dB[r][c] == -1))\n            s.add(Implies(rootA[r][c], dA[r][c] == 0))\n            s.add(Implies(rootB[r][c], dB[r][c] == 0))\n            # every non-root cell has lower-distance same-region neighbor\n            s.add(Implies(And(A[r][c], Not(rootA[r][c])), Or([And(A[nr][nc], dA[nr][nc] < dA[r][c]) for nr,nc in neigh(r,c)])))\n            s.add(Implies(And(Not(A[r][c]), Not(rootB[r][c])), Or([And(Not(A[nr][nc]), dB[nr][nc] < dB[r][c]) for nr,nc in neigh(r,c)])))\n    # both touch all sides\n    s.add(Or([A[0][c] for c in range(w)]))\n    s.add(Or([A[h-1][c] for c in range(w)]))\n    s.add(Or([A[r][0] for r in range(h)]))\n    s.add(Or([A[r][w-1] for r in range(h)]))\n    s.add(Or([Not(A[0][c]) for c in range(w)]))\n    s.add(Or([Not(A[h-1][c]) for c in range(w)]))\n    s.add(Or([Not(A[r][0]) for r in range(h)]))\n    s.add(Or([Not(A[r][w-1]) for r in range(h)]))\n    # irregular: not all one row/col full, at least 3 boundary transitions maybe\n    # avoid trivial near-rectangles by requiring at least one interior cell of each color\n    s.add(Or([A[r][c] for r in range(1,h-1) for c in range(1,w-1)]))\n    s.add(Or([Not(A[r][c]) for r in range(1,h-1) for c in range(1,w-1)]))\n    if s.check()\"'!=sat:\n        return None\n    m=s.model()\n    rows=[]\n    for r in range(h):\n        row='\"''.join('#' if is_true(m.evaluate(A[r][c])) else '.' for c in range(w))\n        rows.append(row)\n    return rows\n\nfor dims in [(5,5),(5,6),(6,6),(5,7),(6,7),(7,7)]:\n    sol=find(*dims)\n    print('dims',dims)\n    if sol:\n        print('\\\\n'.join(sol))\n    else:\n        print('none')\n    print('---')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
