{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, math, time\nfrom collections import deque\n\ndef analyze(mask):\n    h=len(mask); w=len(mask[0])\n    def comps(val):\n        seen=[[False]*w for _ in range(h)]\n        count=0; largest=0\n        for r in range(h):\n            for c in range(w):\n                if seen[r][c] or mask[r][c]\"'!=val: continue\n                count+=1\n                q=deque([(r,c)]); seen[r][c]=True; size=0\n                while q:\n                    x,y=q.popleft(); size+=1\n                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\n                        nx,ny=x+dx,y+dy\n                        if 0<=nx<h and 0<=ny<w and not seen[nx][ny] and mask[nx][ny]==val:\n                            seen[nx][ny]=True; q.append((nx,ny))\n                largest=max(largest,size)\n        return count,largest\n    c1,l1=comps(True); c0,l0=comps(False)\n    s1=sum([any(mask[0][c] for c in range(w)), any(mask[h-1][c] for c in range(w)), any(mask[r][0] for r in range(h)), any(mask[r][w-1] for r in range(h))])\n    s0=sum([any(not mask[0][c] for c in range(w)), any(not mask[h-1][c] for c in range(w)), any(not mask[r][0] for r in range(h)), any(not mask[r][w-1] for r in range(h))])\n    return c1,l1,s1,c0,l0,s0\n\ndef score(mask):\n    c1,l1,s1,c0,l0,s0=analyze(mask)\n    return 200*(s1+s0) - 500*(c1+c0) + 3*(l1+l0)\n\ndef search(h,w,restarts=200,steps=2000):\n    best_mask=None; best_score=-10**9; best_info=None\n    for rst in range(restarts):\n        # structured init: random mix of stripes and blobs\n        mask=[[random.random()<0.5 for c in range(w)] for r in range(h)]\n        # enforce both colors on each boundary side with random flips\n        for c in range(w):\n            if c==0: pass\n        cur=score(mask); T=5.0\n        for step in range(steps):\n            info=analyze(mask)\n            if info==(1, sum(sum(row) for row in mask),4, 1, h*w-sum(sum(row) for row in mask),4):\n                return mask,info\n            if cur>best_score:\n                best_score=cur; best_mask=[row[:] for row in mask]; best_info=info\n            r=random.randrange(h); c=random.randrange(w)\n            mask[r][c]=not mask[r][c]\n            # keep both colors present\n            if all(all(row) for row in [mask]) or not any(any(row) for row in mask):\n                mask[r][c]=not mask[r][c]; continue\n            new=score(mask)\n            if new>=cur or random.random()<math.exp((new-cur)/max(T,1e-6)):\n                cur=new\n            else:\n                mask[r][c]=not mask[r][c]\n            T*=0.9995\n    return best_mask,best_info\nfor dims in [(7,7),(7,8),(8,8),(8,9),(9,9)]:\n    m,info=search(*dims)\n    print('\"'dims',dims,'info',info)\n    if m:\n        for r in range(dims[0]): print(''.join('#' if m[r][c] else '.' for c in range(dims[1])))\n        print('---')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom collections import deque\nrows=[(0,2),(1,3),(2,4),(3,5),(4,6),(3,5),(2,4)]\nh=w=7\nmask=[[False]*w for _ in range(h)]\nfor r,(l,r1) in enumerate(rows):\n    for c in range(l,r1+1): mask[r][c]=True\nfor row in mask: print(''.join('#' if x else '.' for x in row))\n\ndef conn(val):\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    q=deque([pts[0]]);seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc));q.append((nr,nc))\n    return len(seen)==len(pts)\nfor val in [True,False]:\n    print(val,conn(val),[\n        any(mask[0][c]==val for c in range(w)),\n        any(mask[h-1][c]==val for c in range(w)),\n        any(mask[r][0]==val for r in range(h)),\n        any(mask[r][w-1]==val for r in range(h)),\n    ])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
