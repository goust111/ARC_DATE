{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\n\ndef make(rn,cn,cell=2):\n    H=rn*cell + (rn+1)\n    W=cn*cell + (cn+1)\n    g=[[True]*W for _ in range(H)] # True=wall A\n    # carve rooms\n    room_tl={}\n    for r in range(rn):\n        for c in range(cn):\n            r0=1 + r*(cell+1)\n            c0=1 + c*(cell+1)\n            room_tl[(r,c)]=(r0,c0)\n            for rr in range(r0,r0+cell):\n                for cc in range(c0,c0+cell):\n                    g[rr][cc]=False\n    # spanning tree over rooms\n    start=(0,0)\n    vis={start}; stack=[start]\n    while stack:\n        r,c=stack[-1]\n        nbr=[]\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<rn and 0<=nc<cn and (nr,nc) not in vis:\n                nbr.append((nr,nc))\n        if nbr:\n            nr,nc=random.choice(nbr)\n            vis.add((nr,nc)); stack.append((nr,nc))\n            r0,c0=room_tl[(r,c)]\n            nr0,nc0=room_tl[(nr,nc)]\n            if nr==r+1:\n                g[r0+cell][c0+cell//2]=False\n            elif nr==r-1:\n                g[nr0+cell][c0+cell//2]=False\n            elif nc==c+1:\n                g[r0+cell//2][c0+cell]=False\n            elif nc==c-1:\n                g[r0+cell//2][nc0+cell]=False\n        else:\n            stack.pop()\n    # boundary doors at four sides from corner-ish rooms\n    topc=room_tl[(0,cn//2)][1] + cell//2\n    botc=room_tl[(rn-1,cn//2)][1] + cell//2\n    leftr=room_tl[(rn//2,0)][0] + cell//2\n    rightr=room_tl[(rn//2,cn-1)][0] + cell//2\n    g[0][topc]=False; g[H-1][botc]=False; g[leftr][0]=False; g[rightr][W-1]=False\n    return g\n\ndef conn(mask,val):\n    H=len(mask); W=len(mask[0])\n    pts=[(r,c) for r in range(H) for c in range(W) if mask[r][c]==val]\n    if not pts: return False\n    q=deque([pts[0]]); seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<H and 0<=nc<W and mask[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef touch(mask,val):\n    H=len(mask); W=len(mask[0])\n    return [any(mask[0][c]==val for c in range(W)),any(mask[H-1][c]==val for c in range(W)),any(mask[r][0]==val for r in range(H)),any(mask[r][W-1]==val for r in range(H))]\nfor dims in [(2,2),(2,3),(3,3)]:\n    ok=0\n    for _ in range(200):\n        m=make(*dims)\n        if conn(m,True) and conn(m,False) and all(touch(m,True)) and all(touch(m,False)):\n            print('found coarse',dims,'size',len(m),len(m[0]))\n            for r in range(len(m)): print(''.join('#' if m[r][c] else '.' for c in range(len(m[0]))))\n            ok=1\n            break\n    print('done',dims,ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
