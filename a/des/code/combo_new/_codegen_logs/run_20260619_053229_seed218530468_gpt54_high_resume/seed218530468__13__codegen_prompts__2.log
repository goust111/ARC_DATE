{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom collections import deque\n\ndef test(seq,w):\n    h=len(seq)\n    mask=[[False]*w for _ in range(h)]\n    for r,l in enumerate(seq):\n        for c in range(l,l+3): mask[r][c]=True\n    def conn(val):\n        pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n        if not pts: return False\n        q=deque([pts[0]]);seen={pts[0]}\n        while q:\n            r,c=q.popleft()\n            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                nr,nc=r+dr,c+dc\n                if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                    seen.add((nr,nc));q.append((nr,nc))\n        return len(seen)==len(pts)\n    return mask, conn(True), conn(False)\n\ndef search(h,w,width=3):\n    res=[]\n    def rec(r,seq):\n        if r==h:\n            mask,c1,c0=test(seq,w)\n            if c1 and c0:\n                t1=[any(mask[0][c] for c in range(w)), any(mask[h-1][c] for c in range(w)), any(mask[r][0] for r in range(h)), any(mask[r][w-1] for r in range(h))]\n                t0=[any(not mask[0][c] for c in range(w)), any(not mask[h-1][c] for c in range(w)), any(not mask[r][0] for r in range(h)), any(not mask[r][w-1] for r in range(h))]\n                if all(t1) and all(t0):\n                    print('found',seq)\n                    for row in mask: print(''.join('#' if x else '.' for x in row))\n                    raise SystemExit\n            return\n        starts=range(w-width+1)\n        for l in starts:\n            if seq and abs(l-seq[-1])>1: continue\n            rec(r+1, seq+[l])\n    rec(0,[])\n\nfor h,w in [(7,7),(8,8),(9,9)]:\n    print('search',h,w)\n    search(h,w,3)\nprint('none')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
