{"type":"item.started","item":{"id":"item_108","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\n\ndef conn(mask,val):\n    h=len(mask);w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    if not pts: return False\n    q=deque([pts[0]]); seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef touches(mask,val):\n    h=len(mask);w=len(mask[0])\n    return [any(mask[0][c]==val for c in range(w)),any(mask[h-1][c]==val for c in range(w)),any(mask[r][0]==val for r in range(h)),any(mask[r][w-1]==val for r in range(h))]\n\ndef rand_path(a,b,h,w,used,max_steps=200):\n    cur=a; path=[a]\n    seen=set(used)|{a}\n    for _ in range(max_steps):\n        if cur==b: return path\n        r,c=cur\n        nbr=[]\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and (nr,nc) not in seen:\n                dist=abs(nr-b[0])+abs(nc-b[1])\n                # avoid extra boundary touches except target side maybe\n                penalty=0\n                if nr in (0,h-1) or nc in (0,w-1):\n                    if (nr,nc)\"'!=b:\n                        penalty += 3\n                nbr.append((dist+penalty+random.random()*0.5,(nr,nc)))\n        if not nbr:\n            return None\n        nbr.sort(key=lambda x:x[0])\n        cur=random.choice(nbr[:min(3,len(nbr))])[1]\n        path.append(cur); seen.add(cur)\n    return None\n\ndef attempt(h,w):\n    top=(0, random.randint(1,w-2))\n    left=(random.randint(1,h-2),0)\n    bottom=(h-1, random.randint(1,w-2))\n    right=(random.randint(1,h-2),w-1)\n    order=[top,left,bottom,right]\n    used=set(); full=[]\n    cur=order[0]; used.add(cur); full=[cur]\n    for nxt in order[1:]:\n        p=rand_path(cur,nxt,h,w,used)\n        if p is None: return None\n        for cell in p[1:]:\n            full.append(cell); used.add(cell)\n        cur=nxt\n    mask=[[False]*w for _ in range(h)]\n    for r,c in full: mask[r][c]=True\n    return mask\nfor dims in [(7,7),(8,8),(9,9),(10,10),(8,10)]:\n    found=None\n    for i in range(5000):\n        mask=attempt(*dims)\n        if mask and conn(mask,True) and conn(mask,False) and all(touches(mask,True)) and all(touches(mask,False)):\n            found=mask; break\n    print('\"'dims',dims,'found',found is not None)\n    if found:\n        for r in range(dims[0]): print(''.join('#' if found[r][c] else '.' for c in range(dims[1])))\n        print('---')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
