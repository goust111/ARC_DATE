{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\n\ndef conn(mask):\n    h=len(mask); w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]]\n    if not pts: return False\n    q=deque([pts[0]])\n    seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc] and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef touch(mask):\n    h=len(mask); w=len(mask[0])\n    return all([\n        any(mask[0][c] for c in range(w)),\n        any(mask[h-1][c] for c in range(w)),\n        any(mask[r][0] for r in range(h)),\n        any(mask[r][w-1] for r in range(h)),\n    ])\n\ndef sample(h,w):\n    width=random.randint(2,max(2,w-2))\n    L=[]; R=[]\n    left_touch=False; right_touch=False\n    l=random.randint(0,w-width)\n    r=l+width-1\n    for row in range(h):\n        if row==0:\n            # sometimes force left or right touch? top row any interval\n            pass\n        if row>0:\n            dl=random.choice([-1,0,1])\n            dr=random.choice([-1,0,1])\n            nl=max(0,min(w-width,l+dl))\n            nr=nl+width-1\n            l,r=nl,nr\n        # occasional width change\n        if row>0 and random.random()<0.5:\n            nw=max(2,min(w-2,width+random.choice([-1,1])))\n            # keep overlap with prev\n            centers=list(range(max(0,l-(nw-width)), min(w-nw,l+(width)) +1))\n            if centers:\n                nl=random.choice(centers); nr=nl+nw-1; width=nw; l,r=nl,nr\n        L.append(l); R.append(r)\n        left_touch |= (l==0)\n        right_touch |= (r==w-1)\n    mask=[[False]*w for _ in range(h)]\n    for rr in range(h):\n        for cc in range(L[rr],R[rr]+1): mask[rr][cc]=True\n    return mask,left_touch,right_t