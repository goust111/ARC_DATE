{"type":"item.started","item":{"id":"item_113","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, sys\nfrom collections import deque\nsys.setrecursionlimit(10000)\n\ndef conn(cells,h,w):\n    if not cells: return False\n    start=next(iter(cells)); q=deque([start]); seen={start}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and (nr,nc) in cells and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(cells)\n\ndef touches(cells,h,w):\n    return [any(r==0 for r,c in cells), any(r==h-1 for r,c in cells), any(c==0 for r,c in cells), any(c==w-1 for r,c in cells)]\n\ndef search(h,w,max_nodes=200000):\n    allc={(r,c) for r in range(h) for c in range(w)}\n    anchors=[(0,1),(h-2,0),(h-1,w-2),(1,w-1)]\n    random.shuffle(anchors)\n    start=anchors[0]\n    S={start}; T=allc-S\n    seen_states=set(); nodes=0\n    def dfs(S,T):\n        nonlocal nodes\n        nodes+=1\n        if nodes>max_nodes:\n            return None\n        ts=touches(S,h,w); tt=touches(T,h,w)\n        if all(ts) and all(tt):\n            return set(S)\n        if len(S) > h*w-6:\n            return None\n        key=(frozenset(S),)\n        # skip storing all states huge\n        frontier=[]\n        for r,c in S:\n            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                nr,nc=r+dr,c+dc\n                if 0<=nr<h and 0<=nc<w and (nr,nc) not in S:\n                    frontier.append((nr,nc))\n        frontier=list(set(frontier))\n        if not frontier:\n            return None\n        def score(cell):\n            r,c=cell; s=random.random()\n            if not ts[0]: s += (h-r)*4\n            if not ts[1]: s += (r+1)*4\n            if not ts[2]: s += (w-c)*4\n            if not ts[3]: s += (c+1)*4\n            # prefer not stealing last side-touch from T\n            if r==0 and sum(1 for rr,cc in T if rr==0)==1: s-=100\n            if r==h-1 and sum(1 for rr,cc in T if rr==h-1)==1: s-=100\n            if c==0 and sum(1 for rr,cc in T if cc==0)==1: s-=100\n            if c==w-1 and sum(1 for rr,cc in T if cc==w-1)==1: s-=100\n            return -s\n        frontier.sort(key=score)\n        for cell in frontier:\n            newT=T-{cell}\n            if not newT:\n                continue\n            if not all(touches(newT,h,w)):\n                continue\n            if not conn(newT,h,w):\n                continue\n            S.add(cell)\n            res=dfs(S,newT)\n            if res is not None:\n                return res\n            S.remove(cell)\n        return None\n    return dfs(S,T)\n\nfor dims in [(5,5),(6,6),(7,7),(7,8),(8,8),(8,9)]:\n    res=search(*dims,max_nodes=50000)\n    print('dims',dims,'found',res is not None)\n    if res:\n        h,w=dims\n        for r in range(h): print(''.join('#' if (r,c) in res else '.' for c in range(w)))\n        print('---')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
