{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, math, time\nfrom collections import deque\n\ndef eval_mask(mask):\n    h=len(mask); w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]]\n    q=deque([pts[0]]); seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc] and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    touch=sum([\n        any(mask[0][c] for c in range(w)),\n        any(mask[h-1][c] for c in range(w)),\n        any(mask[r][0] for r in range(h)),\n        any(mask[r][w-1] for r in range(h)),\n    ])\n    return len(seen), touch, len(pts)\n\ndef rand_mask(h,w):\n    mask=[[False]*w for _ in range(h)]\n    used=set(); orbits=[]\n    for r in range(h):\n        for c in range(w):\n            rr,cc=h-1-r,w-1-c\n            if (r,c) in used: continue\n            used.add((r,c)); used.add((rr,cc))\n            orbits.append(((r,c),(rr,cc)))\n            val=random.random()<0.5\n            mask[r][c]=val; mask[rr][cc]=not val\n    return mask,orbits\n\ndef search(h,w,steps=50000,restarts=50):\n    for restart in range(restarts):\n        mask,orbits=rand_mask(h,w)\n        best=eval_mask(mask); cur=best\n        T=3.0\n        for step in range(steps):\n            size,touch,n=cur\n            if size==n and touch==4:\n                return mask\n            (a,b)=random.choice(orbits)\n            (r1,c1),(r2,c2)=a,b\n            mask[r1][c1],mask[r2][c2]=mask[r2][c2],mask[r1][c1]\n            new=eval_mask(mask)\n            # weighted score\n            sc=cur[0]+5*cur[1]\n            ns=new[0]+5*new[1]\n            if ns>=sc or random.random()<math.exp((ns-sc)/max(T,1e-6)):\n                cur=new\n            else:\n                mask[r1][c1],mask[r2][c2]=mask[r2][c2],mask[r1][c1]\n            T*=0.9999\n    return None\nfor dims in [(4,6),(4,8),(6,6),(6,8),(8,8),(8,10)]:\n    m=search(*dims)\n    print('dims',dims,'found',m is not None)\n    if m:\n        for r in range(dims[0]): print(''.join('#' if m[r][c] else '.' for c in range(dims[1])))\n        print('---')\nPY\"","aggregated_output":"dims (4, 6) found False\ndims (4, 8) found False\ndims (6, 6) found False\ndims (6, 8) found False\ndims (8, 8) found False\ndims (8, 10) found False\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom collections import deque\n\ndef comps(h,w,segments):\n    blocked=set()\n    for (r1,c1),(r2,c2) in segments:\n        if r1==r2:\n            row=r1; a,b=sorted((c1,c2))\n            for c in range(a,b):\n                if 0<row<h+1 and 0<=row-1<h and 0<=row<h:\n                    blocked.add(((row-1,c),(row,c))); blocked.add(((row,c),(row-1,c)))\n        elif c1==c2:\n            col=c1; a,b=sorted((r1,r2))\n            for r in range(a,b):\n                if 0<col<w+1 and 0<=col-1<w and 0<=col<w:\n                    blocked.add(((r,col-1),(r,col))); blocked.add(((r,col),(r,col-1)))\n        else: raise ValueError\n    seen=[[False]*w for _ in range(h)]; out=[]\n    for sr in range(h):\n      for sc in range(w):\n        if seen[sr][sc]: continue\n        q=deque([(sr,sc)]); seen[sr][sc]=True; comp=[]\n        while q:\n          r,c=q.popleft(); comp.append((r,c))\n          for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and not seen[nr][nc] and ((r,c),(nr,nc)) not in blocked:\n              seen[nr][nc]=True; q.append((nr,nc))\n        out.append(comp)\n    return out\nh=w=7\nsegs=[((0,2),(2,2)),((2,2),(2,7)),((2,2),(4,2)),((4,2),(4,0)),((4,2),(4,5)),((4,5),(7,5))]\ncs=comps(h,w,segs)\nprint('n',len(cs),list(map(len,cs)))\nfor i,comp in enumerate(cs):\n    print(i,[any(r==0 for r,c in comp),any(r==h-1 for r,c in comp),any(c==0 for r,c in comp),any(c==w-1 for r,c in comp)])\nmask=[[False]*w for _ in range(h)]\nfor r,c in cs[0]: mask[r][c]=True\nfor row in mask: print(''.join('#' if x else '.' for x in row))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
