{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools\nfrom collections import deque\n\ndef conn(mask,h,w,val=True):\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    if not pts: return False\n    q=deque([pts[0]])\n    seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef touch(mask,h,w,val=True):\n    return all([\n        any(mask[0][c]==val for c in range(w)),\n        any(mask[h-1][c]==val for c in range(w)),\n        any(mask[r][0]==val for r in range(h)),\n        any(mask[r][w-1]==val for r in range(h)),\n    ])\n\ndef show(mask,h,w):\n    for r in range(h):\n        print(''.join('#' if mask[r][c] else '.' for c in range(w)))\n\nfor h,w in [(4,4),(4,5),(5,5)]:\n    n=h*w\n    found=0\n    for bits in range(1,1<<n):\n        if bits & 1 ==0: pass\n        mask=[[False]*w for _ in range(h)]\n        a=0\n        for i in range(n):\n            if bits>>i &1:\n                r=i//w; c=i%w; mask[r][c]=True; a+=1\n        if a<4 or n-a<4: continue\n        if not conn(mask,h,w,True) or not conn(mask,h,w,False): continue\n        if not touch(mask,h,w,True) or not touch(mask,h,w,False): continue\n        print('found',h,w,'area',a)\n        show(mask,h,w)\n        print()\n        found=1\n        break\n    print('done',h,w,found)\nPY\"","aggregated_output":"done 4 4 0\ndone 4 5 0\ndone 5 5 0\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, math, time\nfrom collections import deque\nh=w=5\n\ndef conn(mask,val):\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    if not pts: return False,0\n    q=deque([pts[0]])\n    seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts), len(seen)\n\ndef sides(mask,val):\n    return [\n        any(mask[0][c]==val for c in range(w)),\n        any(mask[h-1][c]==val for c in range(w)),\n        any(mask[r][0]==val for r in range(h)),\n        any(mask[r][w-1]==val for r in range(h)),\n    ]\n\ndef score(mask):\n    s=0\n    ok1,n1=conn(mask,True); ok0,n0=conn(mask,False)\n    s += (10 if ok1 else n1/5)\n    s += (10 if ok0 else n0/5)\n    s += sum(sides(mask,True))\n    s += sum(sides(mask,False))\n    a=sum(sum(row) for row in mask)\n    s -= abs(a-12)\n    for r in range(h):\n        if any(mask[r][c] for c in range(w)) and any(not mask[r][c] for c in range(w)): s+=0.2\n    for c in range(w):\n        if any(mask[r][c] for r in range(h)) and any(not mask[r][c] for r in range(h)): s+=0.2\n    return s\n\nbest=None; bestm=None\nstart=time.time()\nfor restart in range(2000):\n    mask=[[random.random()<0.5 for c in range(w)] for r in range(h)]\n    cur=score(mask)\n    T=3\n    for step in range(2000):\n        ok1,_=conn(mask,True); ok0,_=conn(mask,False)\n        if ok1 and ok0 and all(sides(mask,True)) and all(sides(mask,False)):\n            print('FOUND')\n            for r in range(h): print(''.join('#' if mask[r][c] else '.' for c in range(w)))\n            raise SystemExit\n        r=random.randrange(h); c=random.randrange(w)\n        mask[r][c]=not mask[r][c]\n        new=score(mask)\n        if best is None or new>best:\n            best,bestm=new,[row[:] for row in mask]\n        if new>=cur or random.random()<math.exp((new-cur)/T):\n            cur=new\n        else:\n            mask[r][c]=not mask[r][c]\n        T*=0.999\nprint('no found best',best)\nfor r in range(h): print(''.join('#' if bestm[r][c] else '.' for c in range(w)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
