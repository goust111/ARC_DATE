{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom collections import deque\n\ndef conn(mask,val):\n    h=len(mask); w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    if not pts: return False\n    q=deque([pts[0]])\n    seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef touch(mask,val):\n    h=len(mask); w=len(mask[0])\n    return all(any(mask[r][c]==val for c in range(w)) for r,c in [(0,None)])\n\ndef touches(mask,val):\n    h=len(mask); w=len(mask[0])\n    return all([\n        any(mask[0][c]==val for c in range(w)),\n        any(mask[h-1][c]==val for c in range(w)),\n        any(mask[r][0]==val for r in range(h)),\n        any(mask[r][w-1]==val for r in range(h)),\n    ])\n\ndef rec(h,w,row,prev,seq):\n    if row==h:\n        mask=[[False]*w for _ in range(h)]\n        for rr,(l,r) in enumerate(seq):\n            for cc in range(l,r+1): mask[rr][cc]=True\n        if conn(mask,True) and conn(mask,False) and touches(mask,True) and touches(mask,False):\n            print('found',h,w,seq)\n            for r in range(h): print(''.join('#' if mask[r][c] else '.' for c in range(w)))\n            return True\n        return False\n    for l in range(w):\n        for r in range(l,w):\n            if prev is not None:\n                pl,pr=prev\n                if r < pl or l > pr:\n                    continue\n            if rec(h,w,row+1,(l,r),seq+[(l,r)]):\n                return True\n    return False\n\nfor h,w in [(5,5),(5,6),(6,6),(5,7),(6,7)]:\n    ok=rec(h,w,0,None,[])\n    print('done',h,w,ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
