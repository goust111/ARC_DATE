{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\n\ndef conn(mask,val):\n    h=len(mask); w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    if not pts: return False\n    q=deque([pts[0]])\n    seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef touches(mask,val):\n    h=len(mask); w=len(mask[0])\n    return [any(mask[0][c]==val for c in range(w)), any(mask[h-1][c]==val for c in range(w)), any(mask[r][0]==val for r in range(h)), any(mask[r][w-1]==val for r in range(h))]\n\ndef gen(h,w):\n    mask=[[False]*w for _ in range(h)]\n    # coarse grid anchors on boundary\n    anchors=[(0,w//2),(h//2,0),(h-1,w//2),(h//2,w-1)]\n    pts=[(1+2*i,1+2*j) for i in range((h-1)//2) for j in range((w-1)//2)]\n    # map anchors to nearest interior nodes with spokes\n    nodes=[(1,w//2 if w//2%2==1 else w//2-1),(h//2 if h//2%2==1 else h//2-1,1),(h-2,w//2 if w//2%2==1 else w//2-1),(h//2 if h//2%2==1 else h//2-1,w-2)]\n    # connect nodes by random DFS tree over complete graph with Manhattan paths via center-ish points\n    order=nodes[:]\n    random.shuffle(order)\n    path=[]\n    cur=order[0]\n    used={cur}\n    for nxt in order[1:]:\n        r,c=cur\n        rr,cc=nxt\n        # random orthogonal route\n        if random.random()<0.5:\n            step1=[(x,c) for x in range(min(r,rr),max(r,rr)+1,1)]\n            step2=[(rr,y) for y in range(min(c,cc),max(c,cc)+1,1)]\n        else:\n            step1=[(r,y) for y in range(min(c,cc),max(c,cc)+1,1)]\n            step2=[(x,cc) for x in range(min(r,rr),max(r,rr)+1,1)]\n        curpath=step1+step2[1:]\n        path.extend(curpath)\n        cur=nxt\n    # add spokes to boundary\n    for r,c in path:\n        mask[r][c]=True\n    spokes=[[(0,nodes[0][1])],[(nodes[1][0],0)],[(h-1,nodes[2][1])],[(nodes[3][0],w-1)]]\n    for ar,ac in anchors:\n        # connect straight inward to nearest path cell on same row/col\n        if ar==0:\n            col=nodes[0][1]\n            for r in range(0,2): mask[r][col]=True\n        elif ar==h-1:\n            col=nodes[2][1]\n            for r in range(h-2,h): mask[r][col]=True\n        elif ac==0:\n            row=nodes[1][0]\n            for c in range(0,2): mask[row][c]=True\n        else:\n            row=nodes[3][0]\n            for c in range(w-2,w): mask[row][c]=True\n    return mask\n\nfor dims in [(7,7),(7,9),(9,9),(9,11)]:\n    ok=0\n    for _ in range(5000):\n        m=gen(*dims)\n        if conn(m,True) and conn(m,False) and all(touches(m,True)) and all(touches(m,False)):\n            print('found',dims)\n            for r in range(dims[0]): print(''.join('#' if m[r][c] else '.' for c in range(dims[1])))\n            ok=1\n            break\n    print('done',dims,ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
