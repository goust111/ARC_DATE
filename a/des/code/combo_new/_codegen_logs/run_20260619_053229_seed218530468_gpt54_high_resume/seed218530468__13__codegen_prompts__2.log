{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom collections import deque\nh,w=6,8\nA=[[r < h//2 for c in range(w)] for r in range(h)]\n# bottom leg in col1 rows3..5, anti-sym remove col6 rows0..2\nfor r in range(3,6):\n    A[r][1]=True\n    rr,cc=h-1-r,w-1-1\n    A[rr][cc]=False\nfor row in A: print(''.join('#' if x else '.' for x in row))\n\ndef conn(mask,val):\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    q=deque([pts[0]]);seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc));q.append((nr,nc))\n    return len(seen)==len(pts)\nmask=A\nprint('A conn',conn(mask,True),'B conn',conn(mask,False))\nfor val in [True,False]:\n    print(val,[any(mask[0][c]==val for c in range(w)),any(mask[h-1][c]==val for c in range(w)),any(mask[r][0]==val for r in range(h)),any(mask[r][w-1]==val for r in range(h))])\nprint('antisym',all(mask[r][c] \"'!= mask[h-1-r][w-1-c] for r in range(h) for c in range(w)))\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
