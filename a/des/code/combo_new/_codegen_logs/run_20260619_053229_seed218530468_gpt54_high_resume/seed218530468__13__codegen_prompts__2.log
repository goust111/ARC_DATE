{"type":"item.started","item":{"id":"item_81","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom collections import deque\npatterns=[\n['.#####.','.#.....','.#.###.','.#...#.','.###.#.','.....#.','.#####.'],\n['.#####.','.#.....','.#.###.','.#.#...','.#.###.','.#.....','.#####.'],\n['..####.','..#....','.##.##.','.#...#.','.##.##.','....#..','.####..'],\n['.####..','.#...#.','.###.#.','...#.#.','.###.#.','.#...#.','..####.'],\n]\nfor pat in patterns:\n    h=len(pat); w=len(pat[0])\n    mask=[[ch=='#' for ch in row] for row in pat]\n    def conn(val):\n        pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n        if not pts: return False\n        q=deque([pts[0]]);seen={pts[0]}\n        while q:\n            r,c=q.popleft()\n            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                nr,nc=r+dr,c+dc\n                if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                    seen.add((nr,nc));q.append((nr,nc))\n        return len(seen)==len(pts)\n    print('pattern')\n    for row in pat: print(row)\n    for val in [True,False]:\n        print(val,conn(val),[\n            any(mask[0][c]==val for c in range(w)), any(mask[h-1][c]==val for c in range(w)), any(mask[r][0]==val for r in range(h)), any(mask[r][w-1]==val for r in range(h))])\n    print('---')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
