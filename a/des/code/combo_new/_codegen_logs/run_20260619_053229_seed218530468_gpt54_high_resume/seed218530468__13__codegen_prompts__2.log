{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque, defaultdict\n\ndef base(rn,cn,cell=2):\n    H=rn*cell + (rn+1)\n    W=cn*cell + (cn+1)\n    g=[[True]*W for _ in range(H)] # True=wall A initially\n    room_tl={}\n    for r in range(rn):\n        for c in range(cn):\n            r0=1 + r*(cell+1)\n            c0=1 + c*(cell+1)\n            room_tl[(r,c)]=(r0,c0)\n            for rr in range(r0,r0+cell):\n                for cc in range(c0,c0+cell):\n                    g[rr][cc]=False\n    vis={(0,0)}; stack=[(0,0)]\n    while stack:\n        r,c=stack[-1]\n        nbr=[]\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<rn and 0<=nc<cn and (nr,nc) not in vis:\n                nbr.append((nr,nc))\n        if nbr:\n            nr,nc=random.choice(nbr)\n            vis.add((nr,nc)); stack.append((nr,nc))\n            r0,c0=room_tl[(r,c)]\n            nr0,nc0=room_tl[(nr,nc)]\n            if nr==r+1:\n                g[r0+cell][c0+cell//2]=False\n            elif nr==r-1:\n                g[nr0+cell][c0+cell//2]=False\n            elif nc==c+1:\n                g[r0+cell//2][c0+cell]=False\n            elif nc==c-1:\n                g[r0+cell//2][nc0+cell]=False\n        else:\n            stack.pop()\n    topc=room_tl[(0,cn//2)][1] + cell//2\n    botc=room_tl[(rn-1,cn//2)][1] + cell//2\n    leftr=room_tl[(rn//2,0)][0] + cell//2\n    rightr=room_tl[(rn//2,cn-1)][0] + cell//2\n    g[0][topc]=False; g[H-1][botc]=False; g[leftr][0]=False; g[rightr][W-1]=False\n    return g\n\ndef comps(mask,val):\n    H=len(mask); W=len(mask[0])\n    seen=[[False]*W for _ in range(H)]\n    out=[]; lab=[[-1]*W for _ in range(H)]\n    for r in range(H):\n      for c in range(W):\n        if seen[r][c] or mask[r][c]\"'!=val: continue\n        q=deque([(r,c)]); seen[r][c]=True; pts=[]\n        idx=len(out)\n        while q:\n          x,y=q.popleft(); pts.append((x,y)); lab[x][y]=idx\n          for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\n            nx,ny=x+dx,y+dy\n            if 0<=nx<H and 0<=ny<W and not seen[nx][ny] and mask[nx][ny]==val:\n              seen[nx][ny]=True; q.append((nx,ny))\n        out.append(pts)\n    return out,lab\n\ndef connected(mask,val):\n    cs,_=comps(mask,val)\n    return len(cs)==1\n\ndef touches(mask,val):\n    H=len(mask); W=len(mask[0])\n    return [any(mask[0][c]==val for c in range(W)),any(mask[H-1][c]==val for c in range(W)),any(mask[r][0]==val for r in range(H)),any(mask[r][W-1]==val for r in range(H))]\n\ndef bridge(mask):\n    H=len(mask);W=len(mask[0])\n    for _ in range(100):\n        cs,lab=comps(mask,True)\n        if len(cs)==1:\n            return True\n        cands=[]\n        for r in range(H):\n            for c in range(W):\n                if mask[r][c]:\n                    continue\n                neigh={lab[nr][nc] for nr,nc in ((r+1,c),(r-1,c),(r,c+1),(r,c-1)) if 0<=nr<H and 0<=nc<W and mask[nr][nc]}\n                if len(neigh)>=2:\n                    cands.append((r,c))\n        random.shuffle(cands)\n        moved=False\n        for r,c in cands:\n            mask[r][c]=True\n            if connected(mask,False) and all(touches(mask,False)):\n                moved=True\n                break\n            mask[r][c]=False\n        if not moved:\n            return False\n    return False\n\nfor dims in [(2,2),(2,3),(3,3),(3,4)]:\n    ok=0\n    for _ in range(200):\n        m=base(*dims)\n        if bridge(m) and connected(m,True) and connected(m,False) and all(touches(m,True)) and all(touches(m,False)):\n            print('\"'found coarse',dims,'size',len(m),len(m[0]))\n            for r in range(len(m)): print(''.join('#' if m[r][c] else '.' for c in range(len(m[0]))))\n            ok=1\n            break\n    print('done',dims,ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
