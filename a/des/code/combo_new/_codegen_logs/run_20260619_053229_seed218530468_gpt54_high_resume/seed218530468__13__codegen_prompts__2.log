{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\n\ndef conn(mask):\n    h=len(mask); w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]]\n    if not pts: return False\n    q=deque([pts[0]])\n    seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc] and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef touch(mask):\n    h=len(mask); w=len(mask[0])\n    return all([\n        any(mask[0][c] for c in range(w)),\n        any(mask[h-1][c] for c in range(w)),\n        any(mask[r][0] for r in range(h)),\n        any(mask[r][w-1] for r in range(h)),\n    ])\n\ndef trial(h,w,N=2000):\n    ok=0\n    for _ in range(N):\n        p=random.uniform(0.35,0.65)\n        m=[[random.random()<p for c in range(w)] for r in range(h)]\n        if all(all(row) for row in [m]) or not any(any(row) for row in m):\n            continue\n        if not conn(m):\n            continue\n        cm=[[not m[r][c] for c in range(w)] for r in range(h)]\n        if not conn(cm):\n            continue\n        if not touch(m) or not touch(cm):\n            continue\n        a=sum(sum(row) for row in m)\n        if a<max(4,(h*w)//4) or a>h*w-max(4,(h*w)//4):\n            continue\n        ok+=1\n    return ok\n\nfor h in range(4,7):\n    for w in range(4,7):\n        print((h,w), trial(h,w))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
