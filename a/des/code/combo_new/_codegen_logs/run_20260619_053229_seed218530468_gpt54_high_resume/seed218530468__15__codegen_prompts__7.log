fe1151.py ====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the one blank in each corner region so all four regions have the same color multiset.\n\n    Input structure:\n    - The dominant background color forms one solid separator row and one solid\n      separator column.\n    - The separator cross splits the grid into four equal rectangular corner regions.\n    - Each corner region contains exactly one background-colored blank pixel.\n\n    Rule:\n    - Count the non-background colors in each corner region.\n    - The completed region multiset is defined by the maximum observed count of\n      each color across the four regions.\n    - Replace each region's blank pixel with the single color needed to match that\n      completed multiset.\n\n    Key insight:\n    - The separator color inside a corner region is a missing value marker; comparing\n      the four regions reveals the shared multiset without using numeric color order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    color_counts = Counter(map(int, g.reshape(-1)))\n    assert all(\n        color == bg or count < color_counts[bg] for color, count in color_counts.items()\n    ), \"background color must be uniquely dominant\"\n\n    cross_row, cross_col = _solid_separator_cross(g, bg)\n    regions = _quadrants(cross_row, cross_col, height, width)\n    region_shape = g[regions[0]].shape\n    region_area = int(np.prod(region_shape))\n\n    counts_by_region: list[Counter[int]] = []\n    blank_positions: list[tuple[int, int]] = []\n    for row_slice, col_slice in regions:\n        region = g[row_slice, col_slice]\n        assert region.shape == region_shape, \"all corner regions must have the same shape\"\n        blanks = np.argwhere(region == bg)\n        assert len(blanks) == 1, \"each corner region must have exactly one blank\"\n\n        counts_by_region.append(Counter(map(int, region[region != bg].reshape(-1))))\n        local_r, local_c = map(int, blanks[0])\n        blank_positions.append((row_slice.start + local_r, col_slice.start + local_c))\n\n    target_counts: Counter[int] = Counter()\n    for counts in counts_by_region:\n        for color, count in counts.items():\n            target_counts[color] = max(target_counts[color], count)\n    assert sum(target_counts.values()) == region_area, \"completed region multiset must be unique\"\n\n    out = g.copy()\n    for counts, (row, col) in zip(counts_by_region, blank_positions):\n        missing = target_counts - counts\n        assert len(missing) == 1, \"each blank must have exactly one matching fill color\"\n        fill_color, fill_count = next(iter(missing.items()))\n        assert fill_count == 1, \"each corner region must need one pixel of the fill color\"\n        out[row, col] = fill_color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n# Canvas/palette bounds.\nGRID_HALF_MIN = 2\nGRID_HALF_MAX = 6\nCOLOR_COUNT = 10\nMIN_TARGET_COLORS = 3\nMAX_NON_BG_COLORS = COLOR_COUNT - 1\n# Layout probabilities and constraints.\nPREFERRED_GRID_HALF = (2, 2)\nPREFERRED_GRID_PROB = 0.65\nQUADRANT_COUNT = 4\nSEPARATOR_WIDTH = 1\nBG_DOMINANCE_MARGIN = 1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _gen_bounded_composition(total: int, parts: int, max_each: int) -> list[int] | None:\n    if parts <= 0 or total < parts or total > parts * max_each:\n        return None\n\n    counts = []\n    remaining = total\n    for i in range(parts):\n        slots_left = parts - i - 1\n        lo = max(1, remaining - slots_left * max_each)\n        hi = min(max_each, remaining - slots_left)\n        counts.append(random.randint(lo, hi))\n        remaining -= counts[-1]\n\n    random.shuffle(counts)\n    return counts\n\n\ndef _gen_grid_options() -> list[tuple[int, int, list[int], int]]:\n    options = []\n    for k in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n        for m in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n            area = k * m\n            bg_count = 2 * k + 2 * m + SEPARATOR_WIDTH + QUADRANT_COUNT\n            max_target_count = (bg_count - BG_DOMINANCE_MARGIN) // QUADRANT_COUNT\n            max_colors = min(MAX_NON_BG_COLORS, area)\n            valid_counts = [\n                c\n                for c in range(MIN_TARGET_COLORS, max_colors + 1)\n                if area <= c * max_target_count\n            ]\n            if valid_counts:\n                options.append((k, m, valid_counts, max_target_count))\n    return options\n\n\ndef _gen_pick_grid_option() -> tuple[int, int, list[int], int]:\n    options = _gen_grid_options()\n    if random.random() < PREFERRED_GRID_PROB:\n        preferred_k, preferred_m = PREFERRED_GRID_HALF\n        for option in options:\n            if option[0] == preferred_k and option[1] == preferred_m:\n                return option\n    return random.choice(options)\n\n\ndef _gen_quadrant_offsets(k: int, m: int) -> list[tuple[int, int]]:\n    sep = SEPARATOR_WIDTH\n    return [(0, 0), (0, m + sep), (k + sep, 0), (k + sep, m + sep)]\n\n\ndef _gen_missing_colors(non_bg_colors: list[int]) -> list[int]:\n    missing_colors = [random.choice(non_bg_colors) for _ in range(QUADRANT_COUNT)]\n    if len(set(missing_colors)) == 1:\n        alternatives = [c for c in non_bg_colors if c != missing_colors[0]]\n        missing_colors[-1] = random.choice(alternatives)\n    return missing_colors\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = random.randrange(COLOR_COUNT)\n    k, m, valid_color_counts, max_target_count = _gen_pick_grid_option()\n    area = k * m\n\n    color_count = random.choice(valid_color_counts)\n    non_bg_colors = random.sample([c for c in range(COLOR_COUNT) if c != bg], color_count)\n    target_counts = _gen_bounded_composition(area, color_count, max_target_count)\n    if target_counts is None:\n        return None\n\n    target_values = []\n    for color, count in zip(non_bg_colors, target_counts):\n        target_values.extend([color] * count)\n\n    missing_colors = _gen_missing_colors(non_bg_colors)\n    out = np.full((2 * k + SEPARATOR_WIDTH, 2 * m + SEPARATOR_WIDTH), bg, dtype=int)\n    inp = out.copy()\n\n    for (r0, c0), missing_color in zip(_gen_quadrant_offsets(k, m), missing_colors):\n        values = target_values[:]\n        random.shuffle(values)\n        quadrant_out = np.array(values, dtype=int).reshape(k, m)\n\n        candidates = np.argwhere(quadrant_out == missing_color)\n        blank_r, blank_c = map(int, candidates[random.randrange(len(candidates))])\n        quadrant_in = quadrant_out.copy()\n        quadrant_in[blank_r, blank_c] = bg\n\n        out[r0 : r0 + k, c0 : c0 + m] = quadrant_out\n        inp[r0 : r0 + k, c0 : c0 + m] = quadrant_in\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n\n---- generate_input ----\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid e3fe1151 input\")\n\n==== /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py ====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Predict the next panel in a framed sequence by continuing each scheduled colored interval.\n\n    Input structure\n    - The grid is made from three or more equal panels in one row or one column.\n    - The final input panel is the static target template; every earlier panel differs from it only by dynamic colors absent from the template.\n    - Each dynamic color appears in a regular temporal schedule across the earlier panels.\n\n    Rule\n    - Keep the final template panel as the output canvas.\n    - For every dynamic color whose schedule reaches the next panel, compare its last two appearances.\n    - Extrapolate each one-dimensional interval along the color's changing row or column axis and paint that predicted mask.\n\n    Key insight\n    - The task is not asking for the last visible panel, but for the next frame after the blank/template slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    panels, diff_colors = _split_panels(g)\n    template = panels[-1]\n    prior = panels[:-1]\n    next_time = len(prior)\n\n    predictions: list[tuple[int, np.ndarray]] = []\n    for color in diff_colors:\n        times = [i for i, panel in enumerate(prior) if np.any(panel == color)]\n        assert len(times) >= 2\n        gaps = [b - a for a, b in zip(times, times[1:])]\n        assert len(set(gaps)) == 1\n        period = gaps[0]\n        if next_time - times[-1] != period:\n            continue\n\n        previous = prior[times[-2]] == color\n        current = prior[times[-1]] == color\n        predictions.append((color, _extrapolate_mask(previous, current)))\n\n    assert predictions\n    occupied = np.zeros_like(template, dtype=bool)\n    for _color, mask in predictions:\n        assert not np.any(occupied & mask)\n        occupied |= mask\n\n    out = template.copy()\n    for color, mask in predictions:\n        out[mask] = color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, orientation, and color sampling.\nPANEL_SIZE_MIN, PANEL_SIZE_MAX = 5, 11\nPANEL_COUNT_CHOICES, ORIENTATION_CHOICES = (3, 5), (False, True)\nCOLOR_POOL, TOTAL_COLOR_CHOICES, MOTION_AXIS_CHOICES = range(10), (4, 5), (0, 1)\n\n# Template decoration density and symmetry.\nTEMPLATE_MIN_DECO_CELLS = 4\nTEMPLATE_DECO_MIN_RATIO, TEMPLATE_DECO_MAX_RATIO = 0.10, 0.30\n\n# Blob motif and growth bounds.\nBLOB_GROWTH_MIN, BLOB_GROWTH_MAX = 1, 4\nBLOB_MAX_INITIAL_CELLS, BLOB_MAX_COMPONENTS = 7, 2\nBLOB_MAX_LINE_COUNT, BLOB_MAX_WIDTH = 3, 3\nBLOB_DIRECTIONS = (-1, 1)\n\n# Dynamic-color schedules.\nSHORT_PRIOR_COUNT, MAX_DYNAMIC_COLORS = 2, 3\nSCHEDULE_ALWAYS_2 = {\"period\": 1, \"times\": [0, 1], \"scheduled\": True}\nSCHEDULE_ALWAYS_4 = {\"period\": 1, \"times\": [0, 1, 2, 3], \"scheduled\": True}\nSCHEDULE_EVEN_4 = {\"period\": 2, \"times\": [0, 2], \"scheduled\": True}\nSCHEDULE_FIRST3_4 = {\"period\": 1, \"times\": [0, 1, 2], \"scheduled\": False}\nSCHEDULE_ODD_4 = {\"period\": 2, \"times\": [1, 3], \"scheduled\": False}\nSCHEDULE_SECOND_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4)\nSCHEDULE_THIRD_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4, SCHEDULE_FIRST3_4, SCHEDULE_ODD_4)\n\n# Placement and retry limits.\nMASK_TRANSPARENT, PLACEMENT_BORDER = 0, 1\nGENERATION_RETRIES = 300\n\ndef _sym_orbits(h: int, w: int) -> list[list[tuple[int, int]]]:\n    seen: set[tuple[int, int]] = set()\n    orbits: list[list[tuple[int, int]]] = []\n    for r in range(h):\n        for c in range(w):\n            if r not in (0, h - 1) and c not in (0, w - 1):\n                continue\n            if (r, c) in seen:\n                continue\n            orbit = sorted({(r, c), (r, w - 1 - c), (h - 1 - r, c), (h - 1 - r, w - 1 - c)})\n            seen.update(orbit)\n            orbits.append(orbit)\n    return orbits\n\n\ndef _make_template(h: int, w: int, bg: int, deco: int) -> np.ndarray:\n    out = np.full((h, w), bg, dtype=int)\n    area = h * w\n    min_deco = max(TEMPLATE_MIN_DECO_CELLS, int(np.ceil(area * TEMPLATE_DECO_MIN_RATIO)))\n    max_deco = max(min_deco, int(np.floor(area * TEMPLATE_DECO_MAX_RATIO)))\n    target = random.randint(min_deco, max_deco)\n    orbits = _sym_orbits(h, w)\n    random.shuffle(orbits)\n    count = 0\n    for orbit in orbits:\n        if count >= target:\n            break\n        if count + len(orbit) > max_deco and count >= min_deco:\n            continue\n        for r, c in orbit:\n            out[r, c] = deco\n        count += len(orbit)\n    return out\n\n\ndef _base_patterns(axis_len: int, line_len: int, max_back: int) -> list[tuple[int, list[list[tuple[int, int]]]]]:\n    patterns: list[tuple[int, list[list[tuple[int, int]]]]] = []\n    for growth in range(BLOB_GROWTH_MIN, BLOB_GROWTH_MAX + 1):\n        extra = max_back * growth\n        max_initial_width = axis_len - extra\n        if max_initial_width < 1:\n            continue\n\n        for lines in range(1, min(BLOB_MAX_LINE_COUNT, line_len) + 1):\n            for width in range(1, min(BLOB_MAX_WIDTH, max_initial_width, BLOB_MAX_INITIAL_CELLS // lines) + 1):\n                patterns.append((growth, [[(0, width - 1)] for _ in range(lines)]))\n\n        if line_len >= 2 and max_initial_width >= 2:\n            for lines in range(2, min(BLOB_MAX_LINE_COUNT + 1, line_len) + 1):\n                width = min(2, max_initial_width)\n                if lines * width <= BLOB_MAX_INITIAL_CELLS and width + 1 + extra <= axis_len:\n                    patterns.append((growth, [[(i % 2, i % 2 + width - 1)] for i in range(lines)]))\n\n        if line_len >= 3 and max_initial_width >= 3:\n            tee = [[(1, 1)], [(0, 2)], [(1, 1)]]\n            if 3 + extra <= axis_len:\n                patterns.append((growth, tee))\n\n        if line_len >= 2:\n            gap = extra + 1\n            if gap + 2 + extra <= axis_len:\n                for lines in range(2, min(BLOB_MAX_LINE_COUNT, line_len) + 1):\n                    split = [[(0, 0), (gap + 1, gap + 1)] for _ in range(lines)]\n                    if 2 * lines <= BLOB_MAX_INITIAL_CELLS:\n                        patterns.append((growth, split))\n    return patterns\n\n\ndef _draw_local(\n    intervals0: list[list[tuple[int, int]]],\n    growth: int,\n    max_back: int,\n    back: int,\n    direction: int,\n    axis: int,\n) -> np.ndarray:\n    grown = max_back - back\n    width = max(end for row in intervals0 for _start, end in row) + max_back * growth + 1\n    local = np.zeros((len(intervals0), width), dtype=bool)\n    for r, row in enumerate(intervals0):\n        for start, end in row:\n            local[r, start : end + grown * growth + 1] = True\n    if direction < 0:\n        local = np.fliplr(local)\n    if axis == 0:\n        local = local.T\n    return local\n\n\ndef _make_blob(axis_len: int, line_len: int, axis: int, max_back: int) -> tuple[int, dict[int, np.ndarray]] | None:\n    patterns = _base_patterns(axis_len, line_len, max_back)\n    if not patterns:\n        return None\n    by_growth: dict[int, list[list[list[tuple[int, int]]]]] = {}\n    for growth, intervals0 in patterns:\n        by_growth.setdefault(growth, []).append(intervals0)\n    growth = random.choice(sorted(by_growth))\n    intervals0 = random.choice(by_growth[growth])\n    direction = random.choice(BLOB_DIRECTIONS)\n    masks = {\n        back: _draw_local(intervals0, growth, max_back, back, direction, axis)\n        for back in range(max_back + 1)\n    }\n    largest = masks[0]\n    if largest.shape[0] > (line_len if axis == 1 else axis_len):\n        return None\n    if largest.shape[1] > (axis_len if axis == 1 else line_len):\n        return None\n    if len(components_mask(masks[max_back], connectivity=4)) > BLOB_MAX_COMPONENTS:\n        return None\n    return growth, masks\n\n\ndef _schedules(n_prior: int, n_colors: int) -> list[dict]:\n    if n_prior == SHORT_PRIOR_COUNT:\n        return [SCHEDULE_ALWAYS_2 for _ in range(n_colors)]\n\n    schedules = [SCHEDULE_ALWAYS_4, random.choice(SCHEDULE_SECOND_CHOICES)]\n    if n_colors == MAX_DYNAMIC_COLORS:\n        schedules.append(random.choice(SCHEDULE_THIRD_CHOICES))\n    return schedules\n\n\ndef _place_masks(\n    occupied: np.ndarray,\n    local_masks: dict[int, np.ndarray],\n) -> dict[int, np.ndarray] | None:\n    largest = local_masks[0]\n    patch = np.where(largest, 1, MASK_TRANSPARENT)\n    try:\n        r0, c0 = random_free_location(\n            occupied, patch, transparent=MASK_TRANSPARENT, border=PLACEMENT_BORDER\n        )\n    except ValueError:\n        return None\n    paste(occupied, patch, r0, c0, transparent=MASK_TRANSPARENT)\n\n    out: dict[int, np.ndarray] = {}\n    for back, local in local_masks.items():\n        full = np.zeros_like(occupied, dtype=bool)\n        full[r0 : r0 + local.shape[0], c0 : c0 + local.shape[1]] = local\n        out[back] = full\n    return out\n\n\ndef _place_dynamic_masks(\n    occupied: np.ndarray,\n    n_dynamic: int,\n    schedules: list[dict],\n    motion_axis: int,\n    n_prior: int,\n    axis_len: int,\n    line_len: int,\n) -> dict[int, dict[int, np.ndarray]] | None:\n    \"\"\"Return full-panel masks by color index, or None if any blob fails.\"\"\"\n    order = list(range(n_dynamic))\n    random.shuffle(order)\n    placed: dict[int, dict[int, np.ndarray]] = {}\n    for idx in order:\n        sched = schedules[idx]\n        if sched[\"scheduled\"]:\n            max_back = max((n_prior - t) // sched[\"period\"] for t in sched[\"times\"])\n        else:\n            last = sched[\"times\"][-1]\n            max_back = max((last - t) // sched[\"period\"] for t in sched[\"times\"])\n\n        blob = _make_blob(axis_len, line_len, motion_axis, max_back)\n        if blob is None:\n            return None\n        _growth, local_masks = blob\n        full_masks = _place_masks(occupied, local_masks)\n        if full_masks is None:\n            return None\n        placed[idx] = full_masks\n    return placed\n\n\ndef _paint_dynamic_masks(\n    panels: list[np.ndarray],\n    output: np.ndarray,\n    dynamic: list[int],\n    schedules: list[dict],\n    placed: dict[int, dict[int, np.ndarray]],\n    n_prior: int,\n) -> None:\n    \"\"\"Mutate prior panels and output with the preplaced dynamic-color masks.\"\"\"\n    for idx, color in enumerate(dynamic):\n        sched = schedules[idx]\n        full_masks = placed[idx]\n        if sched[\"scheduled\"]:\n            for t in sched[\"times\"]:\n                back = (n_prior - t) // sched[\"period\"]\n                panels[t][full_masks[back]] = color\n            output[full_masks[0]] = color\n        else:\n            last = sched[\"times\"][-1]\n            for t in sched[\"times\"]:\n                back = (last - t) // sched[\"period\"]\n                panels[t][full_masks[back]] = color\n\n\ndef _assemble_valid_input(\n    panels: list[np.ndarray],\n    template: np.ndarray,\n    output: np.ndarray,\n    horizontal: bool,\n) -> np.ndarray | None:\n    \"\"\"Return tiled input only when the solver oracle matches planned output.\"\"\"\n    if horizontal:\n        inp = np.concatenate([*panels, template], axis=1)\n    else:\n        inp = np.concatenate([*panels, template], axis=0)\n\n    try:\n        predicted = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(predicted, output):\n        return None\n    return inp\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    h = random.randint(PANEL_SIZE_MIN, PANEL_SIZE_MAX)\n    w = random.randint(PANEL_SIZE_MIN, PANEL_SIZE_MAX)\n    horizontal = random.choice(ORIENTATION_CHOICES)\n    n_panels = random.choice(PANEL_COUNT_CHOICES)\n    n_prior = n_panels - 1\n\n    colors = random.sample(COLOR_POOL, random.choice(TOTAL_COLOR_CHOICES))\n    bg, deco = colors[0], colors[1]\n    dynamic = colors[2:]\n\n    template = _make_template(h, w, bg, deco)\n    occupied = np.where(template == bg, MASK_TRANSPARENT, 1)\n    motion_axis = random.choice(MOTION_AXIS_CHOICES)\n    schedules = _schedules(n_prior, len(dynamic))\n\n    panels = [template.copy() for _ in range(n_prior)]\n    output = template.copy()\n    axis_len = h - 2 if motion_axis == 0 else w - 2\n    line_len = w - 2 if motion_axis == 0 else h - 2\n\n    placed = _place_dynamic_masks(\n        occupied, len(dynamic), schedules, motion_axis, n_prior, axis_len, line_len\n    )\n    if placed is None:\n        return None\n    _paint_dynamic_masks(panels, output, dynamic, schedules, placed, n_prior)\n    return _assemble_valid_input(panels, template, output, horizontal)\n\n\ndef generate_input() -> np.ndarray:\n\n---- generate_input ----\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n==== /home/lixinyu/snap/new/ARC_code/train/412b6263.py ====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Infer the background, rotate the whole input 90 degrees counterclockwise, and stack two framed copies vertically.\n\n    Input structure:\n    - Blue is absent from the input.\n    - One rare marker color appears in exactly two pixels.\n    - The background is the unique non-marker color whose removal leaves exactly two 4-connected foreground objects, each with one marker pixel and one body color.\n    - The whole grid, including background and foreground objects, is the sprite to transform.\n\n    Rule:\n    - Rotate the entire input grid 90 degrees counterclockwise.\n    - Create a blue one-pixel frame around two vertical copies of the rotated grid.\n    - Use the input background color for the two endpoints of every horizontal frame/separator row.\n\n    Key insight: The output is not a crop of the foreground objects; it is two copies of the complete rotated input, separated and enclosed by a newly added blue border.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg, objects = _infer_background_and_objects(g)\n    assert bg != Color.BLUE\n    assert Color.BLUE not in set(map(int, g.ravel()))\n\n    copies = len(objects)\n\n    tile = np.rot90(g, 1)\n    tile_h, tile_w = map(int, tile.shape)\n\n    out_h = copies * tile_h + copies + 1\n    out_w = tile_w + 2\n    out = np.full((out_h, out_w), Color.BLUE, dtype=int)\n\n    for i in range(copies):\n        row = i * (tile_h + 1)\n        out[row, 0] = bg\n        out[row, -1] = bg\n        paste(out, tile, row + 1, 1)\n\n    out[-1, 0] = bg\n    out[-1, -1] = bg\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n# CFG: ranges use numpy's high-exclusive convention where applicable.\nCANVAS_SHAPE_RANGES = ((5, 10), (5, 11))\nOBJECT_SHAPE_RANGES = ((2, 5), (2, 5))\nMIN_SEPARATION_GAP = 1\nMAX_OUTPUT_SIZE = 30\nINPUT_COLORS = [0, 2, 3, 4, 5, 6, 7, 8, 9]\nPALETTE_SIZE = 3\nFRAME_COLOR = Color.BLUE\nOUTPUT_TILE_COPIES = 2\nFRAME_THICKNESS = 1\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _edge_cells(h: int, w: int) -> list[tuple[int, int]]:\n    return [\n        (r, c)\n        for r in range(h)\n        for c in range(w)\n        if r in (0, h - 1) or c in (0, w - 1)\n    ]\n\ndef _expected_output(inp: np.ndarray, bg: int) -> np.ndarray:\n    tile = np.rot90(inp, 1)\n    tile_h, tile_w = tile.shape\n    out_h = OUTPUT_TILE_COPIES * tile_h + (OUTPUT_TILE_COPIES + 1) * FRAME_THICKNESS\n    out_w = tile_w + 2 * FRAME_THICKNESS\n    out = np.full((out_h, out_w), FRAME_COLOR, dtype=int)\n    out[0, 0] = out[0, -1] = bg\n    out[tile_h + FRAME_THICKNESS, 0] = out[tile_h + FRAME_THICKNESS, -1] = bg\n    out[-1, 0] = out[-1, -1] = bg\n    out[FRAME_THICKNESS : FRAME_THICKNESS + tile_h, FRAME_THICKNESS : FRAME_THICKNESS + tile_w] = tile\n    second_top = tile_h + 2 * FRAME_THICKNESS\n    out[second_top : second_top + tile_h, FRAME_THICKNESS : FRAME_THICKNESS + tile_w] = tile\n    return out\n\ndef _sample_object_dims(canvas_h: int, canvas_w: int) -> tuple[int, int] | None:\n    feasible_dims = [\n        (oh, ow)\n        for oh in range(*OBJECT_SHAPE_RANGES[0])\n        for ow in range(*OBJECT_SHAPE_RANGES[1])\n        if oh <= canvas_h and ow <= canvas_w and (\n            canvas_h - 2 * oh >= MIN_SEPARATION_GAP\n            or canvas_w - 2 * ow >= MIN_SEPARATION_GAP\n        )\n    ]\n    if not feasible_dims:\n        return None\n    return feasible_dims[int(np.random.randint(len(feasible_dims)))]\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = int(np.random.randint(*CANVAS_SHAPE_RANGES[0]))\n    W = int(np.random.randint(*CANVAS_SHAPE_RANGES[1]))\n\n    dims = _sample_object_dims(H, W)\n    if dims is None:\n        return None\n    oh, ow = dims\n\n    bg, body, marker = map(int, np.random.choice(INPUT_COLORS, size=PALETTE_SIZE, replace=False))\n    inp = np.full((H, W), bg, dtype=int)\n    inp[:oh, :ow] = body\n    inp[H - oh : H, W - ow : W] = body\n    mr, mc = _edge_cells(oh, ow)[int(np.random.randint(2 * oh + 2 * ow - 4))]\n    inp[mr, mc] = marker\n    inp[H - oh + mr, W - ow + mc] = marker\n\n    expected = _expected_output(inp, bg)\n    if expected.shape[0] > MAX_OUTPUT_SIZE or expected.shape[1] > MAX_OUTPUT_SIZE:\n        return None\n\n    try:\n        actual = main(inp)\n    except AssertionError:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n\n---- generate_input ----\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"for f in /home/lixinyu/snap/new/ARC_code/train/57edb29d.py /home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py /home/lixinyu/snap/new/ARC_code/train/f18ec8cc.py; do printf '\\\\n==== %s ====\\\\n' \\\"\"'$f\"; sed -n '\"'/\"'^def main/,/''^def generate_input/p'\"' \\\"\"'$f\"; printf '\"'\\\\n---- generate_input ----\\\\n'; sed -n '/\"'^def generate_input/,$p'\"' \\\"\"'$f\" | sed -n '\"'1,120p'; done\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"for f in /home/lixinyu/snap/new/ARC_code/train/57edb29d.py /home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py /home/lixinyu/snap/new/ARC_code/train/f18ec8cc.py; do printf '\\\\n==== %s ====\\\\n' \\\"\"'$f\"; sed -n '\"'/\"'^def main/,/''^def generate_input/p'\"' \\\"\"'$f\"; printf '\"'\\\\n---- generate_input ----\\\\n'; sed -n '/\"'^def generate_input/,$p'\"' \\\"\"'$f\" | sed -n '\"'1,120p'; done\"","aggregated_output":"\n==== /home/lixinyu/snap/new/ARC_code/train/57edb29d.py ====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extract the single plain rectangle and redraw it with the aligned rectangles' border-relative marker pattern.\n\n    Input structure:\n    - The boundary color is the background/separator.\n    - Foreground objects are dense rectangular regions; exactly one rectangle has only its base color.\n    - Other rectangles contain their base color plus marker pixels.\n\n    Rule:\n    - Crop the only plain rectangle; this crop is the output canvas.\n    - Use marked rectangles whose row span overlaps the plain rectangle's row span.\n    - Transfer their marker pixels by preserving each marker run's distance from the nearest rectangle edges.\n\n    Key insight:\n    - The marked rectangles are examples of an edge-relative pattern, so the missing plain rectangle receives the same pattern resized to its own dimensions.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    bg = _boundary_bg(g)\n\n    objects = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False):\n        bbox = tuple(map(int, comp[\"bbox\"]))\n        sub = crop_bbox(g, bbox)\n        assert np.all(sub != bg), \"foreground rectangles must be dense\"\n\n        base_color = _unique_most_common(sub)\n        marker_colors = set(map(int, sub.reshape(-1))) - {int(base_color)}\n        objects.append(\n            {\n                \"bbox\": bbox,\n                \"sub\": sub,\n                \"base_color\": int(base_color),\n                \"marker_colors\": marker_colors,\n            }\n        )\n\n    plain = [obj for obj in objects if not obj[\"marker_colors\"]]\n    assert len(plain) == 1, \"expected exactly one plain rectangle\"\n    target = plain[0]\n    tr0, tc0, tr1, tc1 = target[\"bbox\"]\n    target_shape = (int(tr1 - tr0 + 1), int(tc1 - tc0 + 1))\n\n    sources = [\n        obj\n        for obj in objects\n        if obj[\"marker_colors\"] and _row_overlap(obj[\"bbox\"], target[\"bbox\"])\n    ]\n    assert sources, \"expected at least one marked rectangle aligned with the plain rectangle\"\n\n    marker_colors = set()\n    for source in sources:\n        marker_colors.update(source[\"marker_colors\"])\n    assert len(marker_colors) == 1, \"aligned marked rectangles must share one marker color\"\n    marker_color = int(next(iter(marker_colors)))\n\n    masks = []\n    for source in sources:\n        assert source[\"marker_colors\"] == {marker_color}, \"source must contain only the shared marker color\"\n        masks.append(_adapt_marker_mask(source[\"sub\"], marker_color, target_shape))\n\n    pattern = masks[0]\n    for mask in masks[1:]:\n        assert np.array_equal(mask, pattern), \"aligned marked rectangles must encode the same pattern\"\n\n    out = np.full(target_shape, int(target[\"base_color\"]), dtype=int)\n    out[pattern] = marker_color\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and separator colors.\nBG = 4\nNON_BG = [c for c in range(10) if c != BG]\nGRID_H_RANGE = (20, 28)\nGRID_W_RANGE = (20, 28)\nBORDER_GAP = 1\nBAND_GAP = 1\n# Rectangle counts and dimensions.\nRECT_COUNT_RANGE = (3, 6)\nOVERLAP_MARKED_COUNT = 2\nRECT_H_RANGE = (5, 20)\nRECT_W_RANGE = (5, 12)\nPLAIN_EXTRA_ROW_ROOM = 2\n# Marker pattern sampling.\nMARKER_PAIR_COUNT_RANGE = (1, 3)\nMARKER_EDGE_PAIRS = [(1, 1), (1, 2), (2, 1), (2, 2)]\n# Retry budget.\nGENERATION_ATTEMPTS = 300\n\n\ndef _stamp_pattern(rect: np.ndarray, marker: int, pairs: list[tuple[int, int]]):\n    h, w = rect.shape\n    for nr, nc in pairs:\n        for r in (nr, h - 1 - nr):\n            for c in (nc, w - 1 - nc):\n                rect[r, c] = marker\n\n\ndef _pick_dim(near_vals: list[int], lo: int, hi: int) -> int:\n    min_dim = max(lo, max(2 * nv + 2 for nv in near_vals))\n    cands = [d for d in range(min_dim, hi + 1) if all(d >= 2 * nv + 2 and d != 2 * nv + 1 for nv in near_vals)]\n    return random.choice(cands) if cands else -1\n\n\ndef _choose_marker_pattern():\n    n_pairs = random.randint(*MARKER_PAIR_COUNT_RANGE)\n    pairs = sorted(random.sample(MARKER_EDGE_PAIRS, min(n_pairs, len(MARKER_EDGE_PAIRS))))\n    near_rows = [p[0] for p in pairs]\n    near_cols = [p[1] for p in pairs]\n    return pairs, near_rows, near_cols\n\n\ndef _choose_palette(n_rects: int):\n    needed = n_rects + 1  # base colors + marker\n    if needed > len(NON_BG):\n        return None\n    chosen = random.sample(NON_BG, needed)\n    plain_base, marker_color = chosen[0], chosen[-1]\n    marked_bases = chosen[1:-1]\n    return plain_base, marker_color, marked_bases\n\n\ndef _make_marked_rect(h: int, w: int, base: int, marker: int, pairs: list[tuple[int, int]]) -> np.ndarray:\n    rect = np.full((h, w), base, dtype=int)\n    _stamp_pattern(rect, marker, pairs)\n    return rect\n\n\ndef _choose_plain_shape(near_rows: list[int], near_cols: list[int], avail_h: int, avail_w: int):\n    hp = _pick_dim(near_rows, RECT_H_RANGE[0], min(RECT_H_RANGE[1], avail_h - PLAIN_EXTRA_ROW_ROOM))\n    wp = _pick_dim(near_cols, RECT_W_RANGE[0], min(RECT_W_RANGE[1], avail_w))\n    if hp < 0 or wp < 0:\n        return None\n    return hp, wp\n\n\ndef _has_overlap_width_budget(avail_w: int, plain_w: int) -> bool:\n    remaining_w = avail_w - plain_w - OVERLAP_MARKED_COUNT * BAND_GAP\n    max_overlap_w = remaining_w // OVERLAP_MARKED_COUNT\n    if max_overlap_w >= RECT_W_RANGE[0]:\n        return True\n    return remaining_w >= RECT_W_RANGE[0]\n\n\ndef _build_overlap_rects(avail_h, avail_w, plain_w, near_rows, near_cols, marked_bases, marker_color, pairs):\n    if not _has_overlap_width_budget(avail_w, plain_w):\n        return None\n\n    min_w, max_w = RECT_W_RANGE\n    min_h, max_h = RECT_H_RANGE\n    overlap_rects = []\n    remaining_w = avail_w - plain_w - OVERLAP_MARKED_COUNT * BAND_GAP\n    for i in range(OVERLAP_MARKED_COUNT):\n        if i == 0:\n            max_w_i = min(remaining_w - min_w, max_w)\n        else:\n            max_w_i = min(remaining_w, max_w)\n        wm = _pick_dim(near_cols, min_w, max(min_w, max_w_i))\n        if wm < 0:\n            return None\n        remaining_w -= wm\n        if remaining_w < 0:\n            return None\n        hm = _pick_dim(near_rows, min_h, min(max_h, avail_h))\n        if hm < 0:\n            return None\n        overlap_rects.append(_make_marked_rect(hm, wm, marked_bases[i], marker_color, pairs))\n    return overlap_rects\n\n\ndef _build_non_overlap_rects(n_marked, overlap_band_h, avail_h, avail_w, near_rows, near_cols, marked_bases, marker_color, pairs):\n    min_h, max_h = RECT_H_RANGE\n    min_w, max_w = RECT_W_RANGE\n    non_overlap_rects = []\n    for i in range(OVERLAP_MARKED_COUNT, n_marked):\n        remaining_h_for_bands = avail_h - overlap_band_h - BAND_GAP\n        if remaining_h_for_bands < min_h:\n            return None\n        hm = _pick_dim(near_rows, min_h, min(max_h, remaining_h_for_bands))\n        wm = _pick_dim(near_cols, min_w, min(max_w, avail_w))\n        if hm < 0 or wm < 0:\n            return None\n        non_overlap_rects.append(_make_marked_rect(hm, wm, marked_bases[i], marker_color, pairs))\n    return non_overlap_rects\n\n\ndef _pack_non_overlap_bands(rects: list[np.ndarray], avail_w: int) -> list[list[np.ndarray]]:\n    bands = []\n    remaining = list(rects)\n    random.shuffle(remaining)\n    while remaining:\n        band = [remaining.pop(0)]\n        band_w = band[0].shape[1]\n        i = 0\n        while i < len(remaining):\n            if band_w + BAND_GAP + remaining[i].shape[1] <= avail_w:\n                band_w += BAND_GAP + remaining[i].shape[1]\n                band.append(remaining.pop(i))\n            else:\n                i += 1\n        bands.append(band)\n    return bands\n\n\ndef _choose_layout_shape(target_h, target_w, plain_w, overlap_rects, overlap_band_h, non_overlap_bands):\n    non_overlap_heights = [max(r.shape[0] for r in band) for band in non_overlap_bands]\n    total_content_h = overlap_band_h + sum(non_overlap_heights) + len(non_overlap_bands) * BAND_GAP\n    total_h = total_content_h + 2 * BORDER_GAP\n    if total_h > target_h:\n        return None\n\n    actual_h = max(target_h, total_h)\n    if actual_h > GRID_H_RANGE[1]:\n        return None\n\n    overlap_band_w = plain_w + sum(rect.shape[1] for rect in overlap_rects) + OVERLAP_MARKED_COUNT * BAND_GAP\n    max_band_w = overlap_band_w\n    for band in non_overlap_bands:\n        band_w = sum(r.shape[1] for r in band) + max(0, len(band) - 1) * BAND_GAP\n        max_band_w = max(max_band_w, band_w)\n    actual_w = max(target_w, max_band_w + 2 * BORDER_GAP)\n    if actual_w > GRID_W_RANGE[1]:\n        return None\n    return actual_h, actual_w\n\n\ndef _make_overlap_items(plain_h, plain_w, plain_base, overlap_rects, overlap_band_h):\n    \"\"\"Return band items whose marked rectangles overlap the plain rectangle's rows.\"\"\"\n    overlap_items = [(0, np.full((plain_h, plain_w), plain_base, dtype=int))]\n    for rect in overlap_rects:\n        overlap_items.append((0, rect))\n    random.shuffle(overlap_items)\n\n    plain_idx = None\n    for idx, (_, rect) in enumerate(overlap_items):\n        if rect.shape == (plain_h, plain_w) and np.all(rect == plain_base):\n            plain_idx = idx\n            break\n    if plain_idx is None:\n        return None\n\n    offset_p = random.randint(0, max(0, overlap_band_h - plain_h))\n    overlap_items[plain_idx] = (offset_p, overlap_items[plain_idx][1])\n    p_r0_local, p_r1_local = offset_p, offset_p + plain_h - 1\n\n    for idx in range(len(overlap_items)):\n        if idx == plain_idx:\n            continue\n        rect = overlap_items[idx][1]\n        rh = rect.shape[0]\n        lo_off = max(0, p_r0_local - rh + 1)\n        hi_off = min(overlap_band_h - rh, p_r1_local)\n        if lo_off > hi_off:\n            return None\n        off = random.randint(lo_off, hi_off)\n        overlap_items[idx] = (off, rect)\n    return overlap_items\n\n\ndef _make_non_overlap_items(non_overlap_bands: list[list[np.ndarray]]) -> list[list[tuple[int, np.ndarray]]]:\n    bands = []\n    for band_rects in non_overlap_bands:\n        band_h = max(r.shape[0] for r in band_rects)\n        items = [(random.randint(0, max(0, band_h - r.shape[0])), r) for r in band_rects]\n        bands.append(items)\n    return bands\n\n\ndef _render_bands(actual_h: int, actual_w: int, all_bands: list[list[tuple[int, np.ndarray]]]):\n    \"\"\"Render band items with one-cell separators and a one-cell border.\"\"\"\n    random.shuffle(all_bands)\n\n    band_heights = []\n    for items in all_bands:\n        bh = max(off + r.shape[0] for off, r in items)\n        band_heights.append(bh)\n\n    grid = np.full((actual_h, actual_w), BG, dtype=int)\n    cur_row = BORDER_GAP\n    for bi, items in enumerate(all_bands):\n        band_content_w = sum(r.shape[1] for _, r in items) + max(0, len(items) - 1) * BAND_GAP\n        remaining_w = actual_w - 2 * BORDER_GAP - band_content_w\n        left_pad = random.randint(0, max(0, remaining_w))\n        cur_col = BORDER_GAP + left_pad\n\n        for off, rect in items:\n            rh, rw = rect.shape\n            r0 = cur_row + off\n            c0 = cur_col\n            if r0 + rh > actual_h - BORDER_GAP or c0 + rw > actual_w - BORDER_GAP:\n                return None\n            grid[r0:r0+rh, c0:c0+rw] = rect\n            cur_col += rw + BAND_GAP\n\n        cur_row += band_heights[bi] + BAND_GAP\n    return grid\n\n\ndef _accept_if_solver_matches(grid: np.ndarray, output: np.ndarray) -> np.ndarray | None:\n    try:\n        result = main(grid)\n        if np.array_equal(result, output):\n            return grid\n    except Exception:\n        pass\n    return None\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    pairs, near_rows, near_cols = _choose_marker_pattern()\n\n    n_rects = random.randint(*RECT_COUNT_RANGE)\n    n_marked = n_rects - 1\n    palette = _choose_palette(n_rects)\n    if palette is None:\n        return None\n    plain_base, marker_color, marked_bases = palette\n\n    target_h = random.randint(*GRID_H_RANGE)\n    target_w = random.randint(*GRID_W_RANGE)\n    avail_h = target_h - 2 * BORDER_GAP\n    avail_w = target_w - 2 * BORDER_GAP\n\n    plain_shape = _choose_plain_shape(near_rows, near_cols, avail_h, avail_w)\n    if plain_shape is None:\n        return None\n    plain_h, plain_w = plain_shape\n    output = _make_marked_rect(plain_h, plain_w, plain_base, marker_color, pairs)\n\n    overlap_rects = _build_overlap_rects(\n        avail_h, avail_w, plain_w, near_rows, near_cols, marked_bases, marker_color, pairs\n    )\n    if overlap_rects is None:\n        return None\n    overlap_band_h = max(plain_h, *(rect.shape[0] for rect in overlap_rects))\n\n    non_overlap_rects = _build_non_overlap_rects(\n        n_marked, overlap_band_h, avail_h, avail_w, near_rows, near_cols, marked_bases, marker_color, pairs\n    )\n    if non_overlap_rects is None:\n        return None\n    non_overlap_bands = _pack_non_overlap_bands(non_overlap_rects, avail_w)\n\n    layout_shape = _choose_layout_shape(\n        target_h, target_w, plain_w, overlap_rects, overlap_band_h, non_overlap_bands\n    )\n    if layout_shape is None:\n        return None\n    actual_h, actual_w = layout_shape\n\n    overlap_items = _make_overlap_items(plain_h, plain_w, plain_base, overlap_rects, overlap_band_h)\n    if overlap_items is None:\n        return None\n    all_bands = [overlap_items] + _make_non_overlap_items(non_overlap_bands)\n\n    grid = _render_bands(actual_h, actual_w, all_bands)\n    if grid is None:\n        return None\n    return _accept_if_solver_matches(grid, output)\n\n\ndef generate_input() -> np.ndarray:\n\n---- generate_input ----\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n\n==== /home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py ====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Mirror the smallest non-axis foreground color across the full straight axis.\n\n    Input structure\n    - The background is the dominant color.\n    - One foreground color forms exactly one full row, column, main diagonal, or anti-diagonal reflection axis.\n    - The remaining foreground colors include a unique least-populated color to copy.\n\n    Rule\n    - Preserve the input grid.\n    - Select every pixel of the unique smallest non-axis foreground color.\n    - Reflect those pixels across the full straight axis and paint the reflected positions with the same color.\n\n    Key insight\n    - The axis color marks the mirror line, while the color population chooses which set of objects is duplicated.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.size > 0, \"expected a non-empty 2D grid\"\n\n    bg = get_bg(g)\n    axis = _find_reflection_axis(g, bg)\n    axis_color = axis[0]\n    mirror_color = _smallest_non_axis_color(g, bg, axis_color)\n\n    out = g.copy()\n    h, w = g.shape\n    for r_raw, c_raw in np.argwhere(g == mirror_color):\n        r = int(r_raw)\n        c = int(c_raw)\n        rr, cc = _reflect(axis, g.shape, r, c)\n        assert 0 <= rr < h and 0 <= cc < w, \"reflected pixel must stay inside the grid\"\n        assert int(out[rr, cc]) in {bg, mirror_color}, \"reflection cannot overwrite another foreground object\"\n        out[rr, cc] = mirror_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n# Canvas and axis options.\n_GEN_GRID_SIZE_RANGE = (9, 17)\n_GEN_ODD_GRID_SIZES = [9, 11, 13, 15, 17]\n_GEN_AXIS_KINDS = [\"row\", \"col\", \"main_diag\", \"anti_diag\"]\n_GEN_CENTER_AXIS_KINDS = {\"row\", \"col\"}\n_GEN_SIDE_COUNT = 2\n# Foreground component size and count bounds.\n_GEN_COMPONENT_COUNT_RANGE = range(1, 4)\n_GEN_MIRROR_TOTAL_RANGE = (4, 12)\n_GEN_MIRROR_COMPONENT_SIZE_RANGE = (2, 7)\n_GEN_NONMIRROR_TOTAL_RANGE = (5, 17)\n_GEN_NONMIRROR_COMPONENT_SIZE_RANGE = (3, 9)\n_GEN_MIN_NONMIRROR_RATIO = (5, 4)\n_GEN_MAX_NONMIRROR_MULTIPLIER = 2\n# Search and geometry primitives.\n_GEN_RETRY_LIMIT = 300\n_GEN_COLORS = list(range(10))\n_GEN_DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\ndef _gen_draw_axis(grid: np.ndarray, axis_kind: str, color: int) -> None:\n    n = grid.shape[0]\n    if axis_kind == \"row\":\n        grid[n // 2, :] = color\n    elif axis_kind == \"col\":\n        grid[:, n // 2] = color\n    elif axis_kind == \"main_diag\":\n        np.fill_diagonal(grid, color)\n    else:\n        np.fill_diagonal(np.fliplr(grid), color)\n\n\ndef _gen_side_mask(n: int, axis_kind: str, side: int) -> np.ndarray:\n    rr, cc = np.indices((n, n))\n    if axis_kind == \"row\":\n        return rr < n // 2 if side == 0 else rr > n // 2\n    if axis_kind == \"col\":\n        return cc < n // 2 if side == 0 else cc > n // 2\n    if axis_kind == \"main_diag\":\n        return cc > rr if side == 0 else cc < rr\n    return rr + cc < n - 1 if side == 0 else rr + cc > n - 1\n\n\ndef _gen_reflect(axis_kind: str, n: int, r: int, c: int) -> tuple[int, int]:\n    if axis_kind == \"row\":\n        return n - 1 - r, c\n    if axis_kind == \"col\":\n        return r, n - 1 - c\n    if axis_kind == \"main_diag\":\n        return c, r\n    return n - 1 - c, n - 1 - r\n\n\ndef _gen_feasible_counts(total: int, lo: int, hi: int) -> list[int]:\n    return [count for count in _GEN_COMPONENT_COUNT_RANGE if count * lo <= total <= count * hi]\n\n\ndef _gen_partition(total: int, count: int, lo: int, hi: int) -> list[int]:\n    sizes = []\n    remaining = total\n    for idx in range(count):\n        left = count - idx - 1\n        cur_lo = max(lo, remaining - left * hi)\n        cur_hi = min(hi, remaining - left * lo)\n        size = random.randint(cur_lo, cur_hi)\n        sizes.append(size)\n        remaining -= size\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _gen_pick_component_sizes() -> tuple[list[int], list[int]]:\n    mirror_total = random.randint(*_GEN_MIRROR_TOTAL_RANGE)\n    ratio_num, ratio_den = _GEN_MIN_NONMIRROR_RATIO\n    nonmirror_lo = max(\n        _GEN_NONMIRROR_TOTAL_RANGE[0],\n        (ratio_num * mirror_total + ratio_den - 1) // ratio_den,\n    )\n    nonmirror_hi = min(_GEN_NONMIRROR_TOTAL_RANGE[1], _GEN_MAX_NONMIRROR_MULTIPLIER * mirror_total)\n    nonmirror_total = random.randint(nonmirror_lo, nonmirror_hi)\n\n    mirror_count = random.choice(_gen_feasible_counts(mirror_total, *_GEN_MIRROR_COMPONENT_SIZE_RANGE))\n    nonmirror_count = random.choice(_gen_feasible_counts(nonmirror_total, *_GEN_NONMIRROR_COMPONENT_SIZE_RANGE))\n    mirror_sizes = _gen_partition(mirror_total, mirror_count, *_GEN_MIRROR_COMPONENT_SIZE_RANGE)\n    nonmirror_sizes = _gen_partition(nonmirror_total, nonmirror_count, *_GEN_NONMIRROR_COMPONENT_SIZE_RANGE)\n    return mirror_sizes, nonmirror_sizes\n\n\ndef _gen_mark_neighbors(blocked: np.ndarray, coords: np.ndarray) -> None:\n    n = blocked.shape[0]\n    for r_raw, c_raw in coords:\n        r = int(r_raw)\n        c = int(c_raw)\n        blocked[r, c] = True\n        for dr, dc in _GEN_DIRS4:\n            rr = r + dr\n            cc = c + dc\n            if 0 <= rr < n and 0 <= cc < n:\n                blocked[rr, cc] = True\n\n\ndef _gen_grow_component(\n    side_mask: np.ndarray, occupied: np.ndarray, same_color_blocked: np.ndarray, size: int\n) -> np.ndarray | None:\n    available = side_mask & ~occupied & ~same_color_blocked\n    choices = [coords for coords in components_mask(available, connectivity=4) if len(coords) >= size]\n    if not choices:\n        return None\n\n    region = random.choice(choices)\n    seed = tuple(int(x) for x in region[random.randrange(len(region))])\n    selected = {seed}\n    frontier: set[tuple[int, int]] = set()\n    n = available.shape[0]\n\n    def add_frontier(r: int, c: int) -> None:\n        for dr, dc in _GEN_DIRS4:\n            rr = r + dr\n            cc = c + dc\n            if 0 <= rr < n and 0 <= cc < n and available[rr, cc] and (rr, cc) not in selected:\n                frontier.add((rr, cc))\n\n    add_frontier(*seed)\n    while len(selected) < size:\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        selected.add(cell)\n        add_frontier(*cell)\n\n    return np.array(list(selected), dtype=int)\n\n\ndef _gen_place_components(\n    grid: np.ndarray,\n    side_mask: np.ndarray,\n    occupied: np.ndarray,\n    color: int,\n    sizes: list[int],\n) -> list[tuple[int, int]] | None:\n    same_color_blocked = np.zeros_like(occupied, dtype=bool)\n    placed: list[tuple[int, int]] = []\n    for size in sizes:\n        coords = _gen_grow_component(side_mask, occupied, same_color_blocked, size)\n        if coords is None:\n            return None\n        grid[coords[:, 0], coords[:, 1]] = color\n        occupied[coords[:, 0], coords[:, 1]] = True\n        _gen_mark_neighbors(same_color_blocked, coords)\n        placed.extend((int(r), int(c)) for r, c in coords)\n    return placed\n\n\ndef _gen_pick_axis_layout() -> tuple[str, int]:\n    axis_kind = random.choice(_GEN_AXIS_KINDS)\n    if axis_kind in _GEN_CENTER_AXIS_KINDS:\n        n = random.choice(_GEN_ODD_GRID_SIZES)\n    else:\n        n = random.randint(*_GEN_GRID_SIZE_RANGE)\n    return axis_kind, n\n\n\ndef _gen_pick_palette() -> tuple[int, int, int, int]:\n    bg = random.choice(_GEN_COLORS)\n    axis_color = random.choice([color for color in _GEN_COLORS if color != bg])\n    mirror_color, nonmirror_color = random.sample(\n        [color for color in _GEN_COLORS if color not in {bg, axis_color}], 2\n    )\n    return bg, axis_color, mirror_color, nonmirror_color\n\n\ndef _gen_reflect_mirror_cells(\n    out: np.ndarray, mirror_cells: list[tuple[int, int]], axis_kind: str, bg: int, mirror_color: int\n) -> list[tuple[int, int]] | None:\n    n = out.shape[0]\n    reflected: list[tuple[int, int]] = []\n    for r, c in mirror_cells:\n        rr, cc = _gen_reflect(axis_kind, n, r, c)\n        if out[rr, cc] not in {bg, mirror_color}:\n            return None\n        reflected.append((rr, cc))\n        out[rr, cc] = mirror_color\n    return reflected\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    axis_kind, n = _gen_pick_axis_layout()\n    bg, axis_color, mirror_color, nonmirror_color = _gen_pick_palette()\n    mirror_sizes, nonmirror_sizes = _gen_pick_component_sizes()\n\n    out = np.full((n, n), bg, dtype=int)\n    _gen_draw_axis(out, axis_kind, axis_color)\n    occupied = out != bg\n    side_mask = _gen_side_mask(n, axis_kind, random.randrange(_GEN_SIDE_COUNT))\n\n    if _gen_place_components(out, side_mask, occupied, nonmirror_color, nonmirror_sizes) is None:\n        return None\n    mirror_cells = _gen_place_components(out, side_mask, occupied, mirror_color, mirror_sizes)\n    if mirror_cells is None:\n        return None\n\n    reflected = _gen_reflect_mirror_cells(out, mirror_cells, axis_kind, bg, mirror_color)\n    if reflected is None:\n        return None\n\n    inp = out.copy()\n    for rr, cc in reflected:\n        inp[rr, cc] = bg\n\n    try:\n        solved = main(inp)\n    except AssertionError:\n        return None\n    if not np.array_equal(solved, out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n\n---- generate_input ----\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid ad3b40cf input\")\n\n==== /home/lixinyu/snap/new/ARC_code/train/f18ec8cc.py ====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reorder the vertical color-major blocks while preserving every block's internal pixels.\n\n    Input structure\n    The grid is divided into vertical blocks, each with a unique dominant color.\n    Small marker pixels from other block colors may appear inside the blocks.\n\n    Rule\n    If adjacent shared-color marker rows read exactly as the current block order\n    from right to left, reverse the blocks. Otherwise move the leftmost block to\n    the far right and shift the remaining blocks left.\n\n    Key insight\n    The transformation acts on whole vertical blocks, so marker pixels move with\n    their source block instead of being recolored or independently rearranged.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    blocks = _vertical_blocks(g)\n    order = _block_order(g, blocks)\n    assert sorted(order) == list(range(len(blocks))), \"block order must be a permutation\"\n\n    return np.concatenate([g[:, blocks[i][0] : blocks[i][1]] for i in order], axis=1)\n\n# --------------- generator (o5x) ---------------\n# Canvas, block, and color bounds.\nGEN_HEIGHT_RANGE = (7, 9)\nGEN_TOTAL_WIDTH_RANGE = (10, 15)\nGEN_BLOCK_COUNT_CHOICES = [3, 4]\nGEN_BLOCK_WIDTH_RANGE = (3, 7)\nGEN_COLOR_POOL = range(1, 10)\n\n# Marker-layout probabilities and row-sharing limits.\nGEN_REVERSE_PROB = 0.35\nGEN_ALIGNED_LEFT_SHIFT_PROB = 0.7\nGEN_NONCONSECUTIVE_LEFT_SHIFT_PROB = 0.5\nGEN_COMMON_COLOR_COUNT_RANGE = (0, 1)\n\n# Rejection-sampling retry limit.\nGEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_bounds(widths):\n    starts = [0, *itertools.accumulate(widths[:-1])]\n    return [(c0, c0 + width) for c0, width in zip(starts, widths)]\n\n\ndef _gen_expected(grid, widths, order):\n    bounds = _gen_bounds(widths)\n    return np.concatenate([grid[:, bounds[i][0] : bounds[i][1]] for i in order], axis=1)\n\n\ndef _gen_pick_widths(block_count):\n    min_width, max_width = GEN_BLOCK_WIDTH_RANGE\n    total = random.randint(\n        max(GEN_TOTAL_WIDTH_RANGE[0], min_width * block_count),\n        min(GEN_TOTAL_WIDTH_RANGE[1], max_width * block_count),\n    )\n    options = [\n        widths\n        for widths in itertools.product(range(min_width, max_width + 1), repeat=block_count)\n        if sum(widths) == total\n    ]\n    return list(random.choice(options))\n\n\ndef _gen_marker_col(c0, c1):\n    return random.randint(c0 + 1, c1 - 2)\n\n\ndef _gen_place_aligned(grid, widths, colors, color_rows):\n    bounds = _gen_bounds(widths)\n    for block_i, (c0, c1) in enumerate(bounds):\n        base = colors[block_i]\n        for color in colors:\n            if color != base:\n                grid[color_rows[color], _gen_marker_col(c0, c1)] = color\n\n\ndef _gen_nonconsecutive_rows(height, block_count):\n    options = [\n        rows\n        for rows in itertools.combinations(range(height), block_count)\n        if rows[-1] - rows[0] + 1 != block_count\n    ]\n    return list(random.choice(options))\n\n\ndef _gen_place_unaligned_left_shift(grid, widths, colors):\n    height = grid.shape[0]\n    bounds = _gen_bounds(widths)\n    common_colors = random.sample(colors, random.randint(*GEN_COMMON_COLOR_COUNT_RANGE))\n    row_by_common = {color: random.randrange(height) for color in common_colors}\n\n    assignments = []\n    for block_i, _ in enumerate(bounds):\n        base = colors[block_i]\n        used = set()\n        by_color = {}\n        for color in common_colors:\n            if color != base:\n                row = row_by_common[color]\n                used.add(row)\n                by_color[color] = row\n        foreign = [color for color in colors if color != base and color not in common_colors]\n        rows = random.sample([r for r in range(height) if r not in used], len(foreign))\n        for color, row in zip(foreign, rows):\n            by_color[color] = row\n        assignments.append(by_color)\n\n    for color in colors:\n        if color in common_colors:\n            continue\n        block_ids = [i for i, base in enumerate(colors) if base != color]\n        if len({assignments[i][color] for i in block_ids}) == 1:\n            block_i = random.choice(block_ids)\n            used = set(assignments[block_i].values())\n            old_row = assignments[block_i][color]\n            choices = [r for r in range(height) if r not in used and r != old_row]\n            assignments[block_i][color] = random.choice(choices)\n\n    for block_i, (c0, c1) in enumerate(bounds):\n        for color, row in assignments[block_i].items():\n            grid[row, _gen_marker_col(c0, c1)] = color\n\n\ndef _gen_base_grid():\n    height = random.randint(*GEN_HEIGHT_RANGE)\n    block_count = random.choice(GEN_BLOCK_COUNT_CHOICES)\n    colors = random.sample(GEN_COLOR_POOL, block_count)\n    widths = _gen_pick_widths(block_count)\n    grid = np.zeros((height, sum(widths)), dtype=int)\n    for color, (c0, c1) in zip(colors, _gen_bounds(widths)):\n        grid[:, c0:c1] = color\n    return grid, widths, colors\n\n\ndef _gen_place_reverse_markers(grid, widths, colors):\n    block_count = len(colors)\n    start = random.randint(0, grid.shape[0] - block_count)\n    rows = list(range(start, start + block_count))\n    color_rows = {color: row for color, row in zip(reversed(colors), rows)}\n    _gen_place_aligned(grid, widths, colors, color_rows)\n    return list(reversed(range(block_count)))\n\n\ndef _gen_place_left_shift_markers(grid, widths, colors):\n    if random.random() < GEN_ALIGNED_LEFT_SHIFT_PROB:\n        block_count = len(colors)\n        if random.random() < GEN_NONCONSECUTIVE_LEFT_SHIFT_PROB:\n            rows = _gen_nonconsecutive_rows(grid.shape[0], block_count)\n            ordered_colors = random.sample(colors, block_count)\n        else:\n            start = random.randint(0, grid.shape[0] - block_count)\n            rows = list(range(start, start + block_count))\n            ordered_colors = list(reversed(colors))\n            swap_i = random.randrange(block_count - 1)\n            ordered_colors[swap_i : swap_i + 2] = reversed(ordered_colors[swap_i : swap_i + 2])\n        color_rows = {color: row for color, row in zip(ordered_colors, rows)}\n        _gen_place_aligned(grid, widths, colors, color_rows)\n    else:\n        _gen_place_unaligned_left_shift(grid, widths, colors)\n    return list(range(1, len(colors))) + [0]\n\n\ndef _gen_place_markers(grid, widths, colors):\n    if random.random() < GEN_REVERSE_PROB:\n        return _gen_place_reverse_markers(grid, widths, colors)\n    return _gen_place_left_shift_markers(grid, widths, colors)\n\n\ndef _gen_attempt():\n    grid, widths, colors = _gen_base_grid()\n    order = _gen_place_markers(grid, widths, colors)\n    expected = _gen_expected(grid, widths, order)\n    return grid if np.array_equal(main(grid), expected) else None\n\n\ndef generate_input():\n\n---- generate_input ----\ndef generate_input():\n    for _ in range(GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid f18ec8cc input\")\n","exit_code":0,"status":"completed"}}
