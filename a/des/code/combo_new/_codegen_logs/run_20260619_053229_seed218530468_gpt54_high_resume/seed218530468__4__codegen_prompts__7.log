{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/48634b99.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Advance the marker from one half of a vertical bar to the same half of the next longer bar.\n\n    Input structure\n    - The grid has one dominant background color and exactly two foreground colors.\n    - One foreground color forms many vertical one-cell-wide bars; the other appears as a single vertical marker segment.\n    - The marker segment occupies exactly the top or bottom half of its containing vertical bar.\n    Rule\n    - Recolor the current marker segment back to the bar color.\n    - Find the unique all-bar-color vertical bar whose height is two pixels greater than the marked source bar.\n    - Recolor the same half of that next longer bar to the marker color.\n    Key insight\n    - Each bar's total height encodes an ordered size, and the marker advances from a 2k bar to the corresponding 2(k+1) bar while preserving whether it marks the top or bottom half.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = int(get_bg(g))\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, f\"expected exactly two foreground colors, got {colors}\"\n\n    mono_component_counts = {\n        int(color): len(\n            find_components(\n                g,\n                bg=bg,\n                colors=[int(color)],\n                connectivity=4,\n                monochromatic=True,\n            )\n        )\n        for color in colors\n    }\n    marker_colors = [color for color, count in mono_component_counts.items() if count == 1]\n    assert len(marker_colors) == 1, f\"expected one single-component marker color, got {mono_component_counts}\"\n    marker_color = int(marker_colors[0])\n\n    bar_colors = [int(color) for color in colors if int(color) != marker_color]\n    assert len(bar_colors) == 1\n    bar_color = int(bar_colors[0])\n\n    marker_components = find_components(\n        g,\n        bg=bg,\n        colors=[marker_color],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert len(marker_components) == 1\n    marker = marker_components[0]\n    marker_area = int(marker[\"area\"])\n    mr0, mc0, mr1, _mc1 = marker[\"bbox\"]\n    assert _is_solid_vertical_bar(marker)\n\n    bars = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    source_bars = [\n        bar\n        for bar in bars\n        if np.any(g[bar[\"coords\"][:, 0], bar[\"coords\"][:, 1]] == marker_color)\n    ]\n    assert len(source_bars) == 1, f\"expected one bar containing the marker, got {len(source_bars)}\"\n    source = source_bars[0]\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    source_h = bbox_h(source[\"bbox\"])\n    assert _is_solid_vertical_bar(source)\n    assert source_h == 2 * marker_area\n    assert mc0 == sc0 == sc1\n\n    if mr0 == sr0 and mr1 == sr0 + marker_area - 1:\n        marked_end = \"top\"\n    elif mr1 == sr1 and mr0 == sr1 - marker_area + 1:\n        marked_end = \"bottom\"\n    else:\n        raise AssertionError(f\"marker is not exactly one end-half: marker={marker['bbox']} source={source['bbox']}\")\n\n    target_h = source_h + 2\n    target_bars = []\n    for bar in bars:\n        values = g[bar[\"coords\"][:, 0], bar[\"coords\"][:, 1]]\n        if set(map(int, values)) != {bar_color}:\n            continue\n        if not _is_solid_vertical_bar(bar):\n            continue\n        if bbox_h(bar[\"bbox\"]) == target_h:\n            target_bars.append(bar)\n\n    assert len(target_bars) == 1, f\"expected one next-longer target bar, got {[bar['bbox'] for bar in target_bars]}\"\n    target = target_bars[0]\n    tr0, tc0, tr1, _tc1 = target[\"bbox\"]\n    target_half = target_h // 2\n\n    out = g.copy()\n    out[g == marker_color] = bar_color\n    if marked_end == \"top\":\n        out[tr0 : tr0 + target_half, tc0] = marker_color\n    else:\n        out[tr1 - target_half + 1 : tr1 + 1, tc0] = marker_color\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Fixed palette observed in all examples.\nBG = 7\nBAR_COLOR = 8\nMARKER_COLOR = 9\n# Grid geometry and vertical bar vocabulary.\nGRID_SHAPE = (16, 16)\nPROGRESSION_HEIGHTS = (2, 4, 6, 8, 10)\nSOURCE_HEIGHTS = PROGRESSION_HEIGHTS[:-1]\nDISTRACTOR_HEIGHT = 2\nHEIGHT_STEP = 2\n# Placement constraints and structural sampling.\nPLACEMENT_PADDING = 1\nPLACEMENT_CONNECTIVITY = 4\nDISTRACTOR_COUNT_RANGE = (5, 11)\nMARKED_HALVES = (\"top\", \"bottom\")\n# Rejection-sampling retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/9385bd28.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill rectangles between diagonal marker pairs using a color legend.\n\n    Input structure:\n    - bg grid with a vertical legend at the bottom-left: each row is a (marker_color, fill_color) pair.\n    - Scattered L-shaped corner markers of each marker color define opposite corners of axis-aligned rectangles.\n    - Some markers are solid 2×2 blocks instead of corner pairs.\n\n    Rule:\n    - Read legend bottom-to-top; for each entry find all pixels of that marker color.\n    - Determine which two bbox corners carry L-shaped anchors — the *other* diagonal defines the fill region.\n    - Fill the diamond (all shortest-path cells between those two corners) with the legend's fill color.\n    - Solid 2×2 marker blocks are simply recolored to the fill color.\n    - Later legend entries are protected from earlier fills.\n\n    Key insight: The L-shaped anchors sit on the marker diagonal; the fill goes on the opposite diagonal of the bounding box.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    bg = get_bg(g)\n    legend_c, entries = _find_legend(g, bg)\n    assert entries, \"legend must contain at least one (marker, fill) entry\"\n\n    legend_mask = np.zeros_like(g, dtype=bool)\n    for r, _, _ in entries:\n        if 0 <= r < h and 0 <= legend_c < w:\n            legend_mask[r, legend_c] = True\n        if 0 <= r < h and 0 <= legend_c + 1 < w:\n            legend_mask[r, legend_c + 1] = True\n\n    out = g.copy()\n\n    marker_order = [m for _, m, _ in entries]\n    marker_set = set(marker_order)\n\n    # Process legend entries bottom -> top; earlier entries must not destroy later marker pixels.\n    for i, (_, marker, fill) in enumerate(entries):\n        eff_fill = int(fill)\n        marker_pts = set(map(tuple, np.argwhere((g == marker) & (~legend_mask))))\n        if len(marker_pts) < 2:\n            continue\n\n        rs = [r for r, _ in marker_pts]\n        cs = [c for _, c in marker_pts]\n        rmin, rmax = min(rs), max(rs)\n        cmin, cmax = min(cs), max(cs)\n\n        # Protect legend cells and all marker pixels for entries that appear later (higher) in the legend.\n        future_markers = set(marker_order[i + 1 :])\n        protect = legend_mask.copy()\n        for fm in future_markers:\n            protect |= (g == fm) & (~legend_mask)\n\n        # Also protect current marker pixels in the common case (so markers remain visible),\n        # except when they form a solid 2x2 block (treated as a filled marker that gets recolored).\n        if rmax - rmin == 1 and cmax - cmin == 1 and len(marker_pts) == 4:\n            # Solid 2x2 marker: recolor these pixels directly.\n            block = np.zeros_like(g, dtype=bool)\n            for r, c in marker_pts:\n                block[r, c] = True\n            out[block & (~protect)] = eff_fill\n            continue\n        else:\n            protect |= (g == marker) & (~legend_mask)\n\n        if rmin == rmax or cmin == cmax:\n            continue\n\n        tl = (rmin, cmin)\n        tr = (rmin, cmax)\n        bl = (rmax, cmin)\n        br = (rmax, cmax)\n\n        tl_anchor = _l_anchor_present(marker_pts, tl[0], tl[1], (0, 1), (1, 0))\n        tr_anchor = _l_anchor_present(marker_pts, tr[0], tr[1], (0, -1), (1, 0))\n        bl_anchor = _l_anchor_present(marker_pts, bl[0], bl[1], (0, 1), (-1, 0))\n        br_anchor = _l_anchor_present(marker_pts, br[0], br[1], (0, -1), (-1, 0))\n\n        score_tlbr = int(tl_anchor) + int(br_anchor)\n        score_trbl = int(tr_anchor) + int(bl_anchor)\n        assert score_tlbr != 0 or score_trbl != 0, \"at least one diagonal must have an L-anchor\"\n        assert score_tlbr != score_trbl, \"diagonal scores must not tie (tie-break path is unreachable)\"\n        if score_tlbr > score_trbl:\n            a, b = tr, bl\n        else:\n            a, b = tl, br\n\n        diamond = _diamond_mask(h, w, rmin, rmax, cmin, cmax, a, b)\n        out[diamond & (~protect)] = eff_fill\n\n    return out\n\n# --------------- generator (C1) ---------------\n\n# ── CFG: canvas & grid ──────────────────────────────────────────────\nGRID_H_RANGE = (10, 19)          # grid height bounds\nGRID_W_RANGE = (10, 19)          # grid width bounds\n\n# ── CFG: legend ─────────────────────────────────────────────────────\nLEGEND_COL_RANGE = (0, 2)        # legend left column (marker at c, fill at c+1)\nLEGEND_ENTRY_RANGE = (2, 5)      # number of legend entries\n\n# ── CFG: marker types ──────────────────────────────────────────────\nNOOP_PROB = 0.3                  # prob of one noop entry (marker with no pixels)\nBLOCK_PROB = 0.25                # prob of one 2x2 block entry\n\n# ── CFG: L-pair bbox shape ──────────────────────────────────────────\nBBOX_H_MAX = 19                  # max bbox height\nBBOX_W_MAX = 12                  # max bbox width\nBBOX_SHAPE_WEIGHTS = [0.75, 0.15, 0.10]  # [both>=3, h=2/w>=4, h>=4/w=2]\nTLBR_PROB = 0.8                  # prob of TL-BR diagonal (vs TR-BL)\n\n# ── CFG: distractor ────────────────────────────────────────────────\nDISTRACTOR_PROB = 0.25           # prob of adding a non-legend L-pair\n\n# ── CFG: retry budgets ─────────────────────────────────────────────\nBLOCK_RETRIES = 100              # placement attempts for a 2x2 block\nLPAIR_RETRIES = 150              # placement attempts for an L-pair\nDISTRACTOR_RETRIES = 60          # placement attempts for distractor\nGEN_RETRIES = 300                # outer generate_input retry budget\n\n_L_OFFSETS = {\n    \"TL\": [(0, 0), (0, 1), (1, 0)],\n    \"TR\": [(0, 0), (0, -1), (1, 0)],\n    \"BL\": [(0, 0), (0, 1), (-1, 0)],\n    \"BR\": [(0, 0), (0, -1), (-1, 0)],\n}\n\n\n","exit_code":0,"status":"completed"}}
