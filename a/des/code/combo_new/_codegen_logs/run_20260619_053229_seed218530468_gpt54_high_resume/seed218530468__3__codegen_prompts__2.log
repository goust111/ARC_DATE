{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/eval/898e7135.py /home/lixinyu/snap/new/ARC_code/eval/2c181942.py /home/lixinyu/snap/new/ARC_code/train/465b7d93.py /home/lixinyu/snap/new/ARC_code/train/ad173014.py; do echo \"===== $f\"; awk '\"'BEGIN{mode=0} /\"'^def main'\"\\\\(/ {mode=1} /\"'^def generate_input'\"\\\\(/ {mode=2} mode{print}' \\\"\"'$f\"; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/eval/898e7135.py /home/lixinyu/snap/new/ARC_code/eval/2c181942.py /home/lixinyu/snap/new/ARC_code/train/465b7d93.py /home/lixinyu/snap/new/ARC_code/train/ad173014.py; do echo \"===== $f\"; awk '\"'BEGIN{mode=0} /\"'^def main'\"\\\\(/ {mode=1} /\"'^def generate_input'\"\\\\(/ {mode=2} mode{print}' \\\"\"'$f\"; done'","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/898e7135.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Inflate a frame's hole-layout and fill each hole with its matching piece.\n\n    Input structure:\n    - bg = most common color. Largest component is a monochrome frame enclosing bg holes.\n    - Outside pieces composed of k×k blocks; k = side of smallest solid square piece.\n\n    Rule:\n    - Extract connected hole regions inside the frame as slots.\n    - Match each piece to a slot by comparing block-level shapes under rotation/flip.\n    - Output the layout scaled by k, with pieces placed in slots; frame color as background.\n\n    Key insight: Pieces are k×k-block-scaled versions of holes; downsampling reveals shape matches under all 8 orientations.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    # --- find the largest connected component of foreground (multicolor) ---\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n    frame_comp = max(comps, key=lambda d: int(d[\"area\"]))\n    fr0, fc0, fr1, fc1 = map(int, frame_comp[\"bbox\"])\n\n    # The frame is monochrome; use its dominant color as output background.\n    frame_cols = [int(g[int(r), int(c)]) for r, c in frame_comp[\"coords\"]]\n    bgc = int(Counter(frame_cols).most_common(1)[0][0])\n\n    # --- layout = bg holes inside the frame bbox, tight-cropped ---\n    sub = crop_bbox(g, (fr0, fc0, fr1, fc1))\n    hole = sub == int(bg)\n    hole_box = bbox(hole)\n    assert hole_box is not None, \"frame must enclose at least one bg hole\"\n    lr0, lc0, lr1, lc1 = map(int, hole_box)\n    layout = hole[lr0 : lr1 + 1, lc0 : lc1 + 1]\n\n    # --- slot components in the layout ---\n    slots = []\n    for coords in components_mask(layout, connectivity=4):\n        rr0, cc0, rr1, cc1 = bbox_coords(coords)\n        rr0, cc0, rr1, cc1 = map(int, (rr0, cc0, rr1, cc1))\n        h = int(rr1 - rr0 + 1)\n        w = int(cc1 - cc0 + 1)\n        sm = np.zeros((h, w), dtype=bool)\n        sm[coords[:, 0] - rr0, coords[:, 1] - cc0] = True\n        slots.append({\"area\": int(sm.sum()), \"r0\": int(rr0), \"c0\": int(cc0), \"mask\": sm})\n    slots.sort(key=lambda s: (-int(s[\"area\"]), int(s[\"r0\"]), int(s[\"c0\"])))\n\n    assert slots, \"frame must contain at least one slot\"\n\n    # --- pieces = non-singleton foreground components excluding the frame component ---\n    pieces = []\n    for comp in comps:\n        if comp is frame_comp:\n            continue\n        coords = comp[\"coords\"]\n        if coords.size == 0 or int(coords.shape[0]) <= 1:\n            continue\n        pr0, pc0, pr1, pc1 = map(int, comp[\"bbox\"])\n        patch = crop_bbox(g, (pr0, pc0, pr1, pc1))\n        ph, pw = map(int, patch.shape)\n        pm = np.zeros((ph, pw), dtype=bool)\n        pm[coords[:, 0] - pr0, coords[:, 1] - pc0] = True\n        pieces.append({\"area\": int(pm.sum()), \"mask\": pm, \"patch\": patch})\n\n    assert pieces, \"at least one non-frame piece must exist\"\n\n    # --- infer k from the smallest solid square piece ---\n    k = None\n    for p in pieces:\n        h, w = map(int, p[\"mask\"].shape)\n        if h == w and int(p[\"mask\"].sum()) == int(h * w):\n            k = int(h) if k is None else min(int(k), int(h))\n    k = int(k or 1)\n\n    def downsample_blocks(mask: np.ndarray) -> np.ndarray | None:\n        hh, ww = mask.shape\n        if hh % k != 0 or ww % k != 0:\n            return None\n        out_h, out_w = int(hh // k), int(ww // k)\n        out = np.zeros((out_h, out_w), dtype=bool)\n        for r in range(out_h):\n            for c in range(out_w):\n                block = mask[int(r * k) : int((r + 1) * k), int(c * k) : int((c + 1) * k)]\n                if bool(block.all()):\n                    out[r, c] = True\n                elif bool(block.any()):\n                    return None\n        return out\n\n    def dihedral_variants(\n        patch: np.ndarray, mask: np.ndarray\n    ) -> list[tuple[np.ndarray, np.ndarray]]:\n        base = []\n        for kk in range(4):\n            p = np.rot90(patch, int(kk))\n            m = np.rot90(mask, int(kk))\n            base.append((p, m))\n            base.append((np.fliplr(p), np.fliplr(m)))\n        uniq = []\n        seen = set()\n        for p, m in base:\n            key = m.tobytes()\n            if key in seen:\n                continue\n            seen.add(key)\n            uniq.append((p, m))\n        return uniq\n\n    # Precompute all usable (piece,variant) candidates with their block masks.\n    candidates = []\n    for pi, p in enumerate(pieces):\n        for vp, vm in dihedral_variants(p[\"patch\"], p[\"mask\"]):\n            um = downsample_blocks(vm)\n            if um is None:\n                continue\n            candidates.append({\"pi\": int(pi), \"area\": int(p[\"area\"]), \"um\": um, \"vp\": vp, \"vm\": vm})\n\n    used_piece: set[int] = set()\n    placements: list[tuple[dict, dict]] = []\n    for s in slots:\n        need_area = int(s[\"area\"]) * int(k) * int(k)\n        found = None\n        for cand in candidates:\n            if int(cand[\"pi\"]) in used_piece:\n                continue\n            if int(cand[\"area\"]) != int(need_area):\n                continue\n            if cand[\"um\"].shape != s[\"mask\"].shape:\n                continue\n            if np.array_equal(cand[\"um\"], s[\"mask\"]):\n                found = cand\n                break\n        assert found is not None, \"every slot must match a piece\"\n        used_piece.add(int(found[\"pi\"]))\n        placements.append((s, found))\n\n    outH = (int(layout.shape[0]) + 2) * int(k)\n    outW = (int(layout.shape[1]) + 2) * int(k)\n    out = np.full((outH, outW), int(bgc), dtype=int)\n\n    for s, cand in placements:\n        top = (int(s[\"r0\"]) + 1) * int(k)\n        left = (int(s[\"c0\"]) + 1) * int(k)\n        paste(out, cand[\"vp\"], int(top), int(left), mask=cand[\"vm\"], overwrite=True)\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for ARC-AGI-2 task 898e7135.\n\nOutput-first strategy:\n  1. Build a hole/wall layout of 4-conn slots (8-separated, includes unit slots).\n  2. For each slot, pick a distinct color + dihedral transform; upscale slot mask\n     by k to get the piece sprite (solid k*k blocks).\n  3. Assemble the frame (layout + 1-cell border of frame_color).\n  4. Scatter pieces outside the frame on a bg=0 canvas, plus single-pixel\n     distractor noise in a fresh color.\n\nThe generator validates main(input) == expected_output before returning.\n\"\"\"\n\nimport random\nimport numpy as np\n\nfrom arc_utils import paste, random_free_location\n\n# --- tunables ----------------------------------------------------------------\n\nK_CHOICES = [2, 3]                  # block scale factor\nLAYOUT_H_RANGE = (4, 12)           # inner layout rows\nLAYOUT_W_RANGE = (4, 8)            # inner layout cols\nN_SLOTS_RANGE = (3, 6)             # total slot count (incl. unit)\nN_UNITS_MAX = 2                    # max unit-slot count per example\nNON_UNIT_SIZE_CHOICES = [2, 3, 4, 5, 6, 7]  # area of non-unit slots\n\nHOLE_DENSITY_RANGE = (0.20, 0.50)  # valid hole fraction of layout area\nUNIT_SLOT_RETRIES = 20             # attempts per unit slot placement\nNON_UNIT_SLOT_RETRIES = 30         # attempts per non-unit slot placement\nGROW_SEED_TRIES = 8                # random seed cells tried per _grow_slot call\n\nCANVAS_DIM_RANGE = (15, 30)        # min/max for canvas height and width\nAREA_BUFFER_MULT = 4               # multiplier on piece area for canvas sizing\nAREA_BUFFER_CONST = 50             # additive constant for canvas area budget\n\nDISTRACTOR_RANGE = (8, 13)         # singleton distractor pixel count\nDISTRACTOR_RETRY_MULT = 10         # retry multiplier for distractor placement\nMIN_DISTRACTORS = 8                # minimum placed distractors to accept\n\nGENERATE_MAX_RETRIES = 300         # outer retry limit in generate_input\n\n\n# --- layout generation -------------------------------------------------------\n\ndef _canonical_shape_key(mask: np.ndarray) -> bytes:\n    \"\"\"Canonical bytes representation under D4 for a bool mask (tight-cropped).\"\"\"\n    variants = []\n    for kk in range(4):\n        r = np.rot90(mask, kk)\n        variants.append(r.tobytes() + bytes([r.shape[0], r.shape[1]]))\n        fr = np.fliplr(r)\n        variants.append(fr.tobytes() + bytes([fr.shape[0], fr.shape[1]]))\n    return min(variants)\n\n\ndef _grow_slot(forbidden: np.ndarray, target_size: int) -> np.ndarray | None:\n    \"\"\"Grow a 4-conn slot of given size starting from a random free cell.\n    `forbidden` marks cells that must not be used. Returns coords array or None.\n    \"\"\"\n    H, W = forbidden.shape\n    free_cells = np.argwhere(~forbidden)\n    if free_cells.size == 0:\n        return None\n    random.shuffle(free_cells)\n    for start in free_cells[:GROW_SEED_TRIES]:\n        r0, c0 = int(start[0]), int(start[1])\n        chosen = {(r0, c0)}\n        frontier = {(r0 - 1, c0), (r0 + 1, c0), (r0, c0 - 1), (r0, c0 + 1)}\n        while len(chosen) < target_size and frontier:\n            cands = [p for p in frontier if 0 <= p[0] < H and 0 <= p[1] < W\n                     and not forbidden[p[0], p[1]] and p not in chosen]\n            if not cands:\n                break\n            nr, nc = random.choice(cands)\n            chosen.add((nr, nc))\n            frontier.discard((nr, nc))\n            frontier.update({(nr - 1, nc), (nr + 1, nc), (nr, nc - 1), (nr, nc + 1)})\n        if len(chosen) == target_size:\n            return np.array(sorted(chosen))\n    return None\n\n\ndef _dilate8(mask: np.ndarray) -> np.ndarray:\n    \"\"\"Dilate a bool mask by 1 cell (8-connectivity).\"\"\"\n    out = mask.copy()\n    out[:-1, :] |= mask[1:, :]\n    out[1:, :] |= mask[:-1, :]\n    out[:, :-1] |= mask[:, 1:]\n    out[:, 1:] |= mask[:, :-1]\n    out[:-1, :-1] |= mask[1:, 1:]\n    out[1:, 1:] |= mask[:-1, :-1]\n    out[:-1, 1:] |= mask[1:, :-1]\n    out[1:, :-1] |= mask[:-1, 1:]\n    return out\n\n\ndef _forbid_coords(forbidden: np.ndarray, coords: np.ndarray) -> None:\n    \"\"\"Mark coords and their 8-neighbors as forbidden (in-place).\"\"\"\n    cell_mask = np.zeros_like(forbidden)\n    cell_mask[coords[:, 0], coords[:, 1]] = True\n    forbidden |= _dilate8(cell_mask)\n\n\ndef _gen_layout(h: int, w: int, n_slots: int, n_units: int) -> list[dict] | None:\n    \"\"\"Generate a layout grid with n_slots 4-connected slots (including n_units unit slots).\n    Returns list of {coords, area, mask, shape_key} or None on failure.\n    Unit slots appear first in the returned list.\n    \"\"\"\n    forbidden = np.zeros((h, w), dtype=bool)\n    slots: list[dict] = []\n    used_shape_keys: set[bytes] = set()\n\n    # Place unit slots first (trivially small, easy to fit)\n    for _ in range(n_units):\n        for _ in range(UNIT_SLOT_RETRIES):\n            coords = _grow_slot(forbidden, 1)\n            if coords is not None:\n                slots.append({\"coords\": coords, \"area\": 1})\n                _forbid_coords(forbidden, coords)\n                break\n        else:\n            return None\n\n    # Place non-unit slots with distinct D4 shapes\n    for _ in range(n_slots - n_units):\n        size = random.choice(NON_UNIT_SIZE_CHOICES)\n        for _ in range(NON_UNIT_SLOT_RETRIES):\n            coords = _grow_slot(forbidden, size)\n            if coords is None:\n                continue\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            sm = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)\n            sm[coords[:, 0] - r0, coords[:, 1] - c0] = True\n            key = _canonical_shape_key(sm)\n            if key in used_shape_keys:\n                continue\n            used_shape_keys.add(key)\n            slots.append({\"coords\": coords, \"area\": size, \"mask\": sm, \"shape_key\": key})\n            _forbid_coords(forbidden, coords)\n            break\n        else:\n            return None\n\n    # Validate hole density\n    density = sum(s[\"area\"] for s in slots) / (h * w)\n    lo, hi = HOLE_DENSITY_RANGE\n    if not (lo <= density <= hi):\n        return None\n\n    return slots\n\n\n# --- piece construction ------------------------------------------------------\n\ndef _make_piece(slot: dict, color: int, k: int, apply_dihedral: bool) -> dict:\n    \"\"\"Build output and input patches for one slot.\n    For unit slots (area=1), the piece is a solid k*k square with no dihedral\n    transform needed. For non-unit slots, a random dihedral is applied to the\n    input-side patch.\n    \"\"\"\n    if slot[\"area\"] == 1:\n        patch = np.full((k, k), color, dtype=int)\n        mask = np.ones((k, k), dtype=bool)\n        return {\"color\": color, \"slot\": slot,\n                \"out_patch\": patch, \"out_mask\": mask,\n                \"in_patch\": patch, \"in_mask\": mask}\n\n    out_mask = np.kron(slot[\"mask\"], np.ones((k, k), dtype=bool))\n    out_patch = np.where(out_mask, color, 0).astype(int)\n\n    if apply_dihedral:\n        rot = random.randint(0, 3)\n        in_mask = np.rot90(out_mask, rot)\n        in_patch = np.rot90(out_patch, rot)\n        if random.random() < 0.5:\n            in_mask = np.fliplr(in_mask)\n            in_patch = np.fliplr(in_patch)\n    else:\n        in_mask, in_patch = out_mask, out_patch\n\n    return {\"color\": color, \"slot\": slot,\n            \"out_patch\": out_patch, \"out_mask\": out_mask,\n            \"in_patch\": in_patch, \"in_mask\": in_mask}\n\n\n# --- output assembly ---------------------------------------------------------\n\ndef _build_expected_output(pieces: list[dict], layout_h: int, layout_w: int,\n                           k: int, frame_color: int) -> np.ndarray:\n    \"\"\"Assemble the expected output grid: frame_color background with pieces placed.\"\"\"\n    out = np.full(((layout_h + 2) * k, (layout_w + 2) * k), frame_color, dtype=int)\n    for p in pieces:\n        coords = p[\"slot\"][\"coords\"]\n        top = (int(coords[:, 0].min()) + 1) * k\n        left = (int(coords[:, 1].min()) + 1) * k\n        paste(out, p[\"out_patch\"], top, left, mask=p[\"out_mask\"], overwrite=True)\n    return out\n\n\n# --- input canvas assembly ---------------------------------------------------\n\ndef _build_input_canvas(pieces: list[dict], layout_mask: np.ndarray,\n                        layout_h: int, layout_w: int, k: int,\n                        frame_color: int, distractor_color: int) -> np.ndarray | None:\n    \"\"\"Build the input grid: frame + scattered pieces + distractor noise.\n    Returns canvas or None if placement fails.\n    \"\"\"\n    frame_h, frame_w = layout_h + 2, layout_w + 2\n    total_piece_area = sum(int(p[\"in_mask\"].sum()) for p in pieces)\n    needed_cells = frame_h * frame_w + AREA_BUFFER_MULT * total_piece_area + AREA_BUFFER_CONST\n\n    # Canvas dimensions: start random within spec range, grow if area insufficient\n    min_h = max(CANVAS_DIM_RANGE[0], frame_h + 2)\n    min_w = max(CANVAS_DIM_RANGE[0], frame_w + 2)\n    canvas_h = random.randint(min_h, CANVAS_DIM_RANGE[1])\n    canvas_w = random.randint(min_w, CANVAS_DIM_RANGE[1])\n    while canvas_h * canvas_w < needed_cells and (canvas_h < CANVAS_DIM_RANGE[1] or canvas_w < CANVAS_DIM_RANGE[1]):\n        if canvas_h <= canvas_w and canvas_h < CANVAS_DIM_RANGE[1]:\n            canvas_h += 1\n        elif canvas_w < CANVAS_DIM_RANGE[1]:\n            canvas_w += 1\n        else:\n            break\n    if canvas_h * canvas_w < needed_cells:\n        return None\n\n    canvas = np.zeros((canvas_h, canvas_w), dtype=int)\n\n    # Build and place the frame (1-cell border of frame_color around the layout)\n    frame_img = np.full((frame_h, frame_w), frame_color, dtype=int)\n    frame_img[1:-1, 1:-1] = np.where(layout_mask, 0, frame_color)\n    fr_max, fc_max = canvas_h - frame_h - 1, canvas_w - frame_w - 1\n    if fr_max < 1 or fc_max < 1:\n        return None\n    paste(canvas, frame_img, random.randint(1, fr_max), random.randint(1, fc_max))\n\n    # Place pieces outside the frame, largest-first for better packing\n    for p in sorted(pieces, key=lambda p: -int(p[\"in_mask\"].sum())):\n        try:\n            pr, pc = random_free_location(\n                canvas, p[\"in_patch\"],\n                transparent=0, border=0, padding=1, padding_connectivity=8,\n            )\n        except ValueError:\n            return None\n        paste(canvas, p[\"in_patch\"], pr, pc, mask=p[\"in_mask\"], overwrite=True)\n\n    # Scatter distractor singletons (isolated single pixels in a dedicated color)\n    n_distractors = random.randint(*DISTRACTOR_RANGE)\n    placed = 0\n    for _ in range(n_distractors * DISTRACTOR_RETRY_MULT):\n        if placed >= n_distractors:\n            break\n        rr, cc = random.randint(0, canvas_h - 1), random.randint(0, canvas_w - 1)\n        if canvas[rr, cc] != 0:\n            continue\n        r_lo, r_hi = max(0, rr - 1), min(canvas_h, rr + 2)\n        c_lo, c_hi = max(0, cc - 1), min(canvas_w, cc + 2)\n        if np.any(canvas[r_lo:r_hi, c_lo:c_hi] != 0):\n            continue\n        canvas[rr, cc] = distractor_color\n        placed += 1\n    if placed < MIN_DISTRACTORS:\n        return None\n\n    # bg=0 must remain the most common color for solver's get_bg\n    vals, counts = np.unique(canvas, return_counts=True)\n    if int(vals[np.argmax(counts)]) != 0:\n        return None\n\n    return canvas\n\n\n# --- main generator attempt --------------------------------------------------\n\ndef _gen_attempt() -> np.ndarray | None:\n    k = random.choice(K_CHOICES)\n    layout_h = random.randint(*LAYOUT_H_RANGE)\n    layout_w = random.randint(*LAYOUT_W_RANGE)\n    n_slots = random.randint(*N_SLOTS_RANGE)\n    n_units = random.randint(1, min(N_UNITS_MAX, n_slots - 1))\n\n    # Allocate colors: frame, distractor, then per-piece\n    palette = list(range(1, 10))\n    random.shuffle(palette)\n    frame_color = palette.pop()\n    distractor_color = palette.pop()\n    needed_piece_colors = (n_slots - n_units) + 1  # +1 shared unit color\n    if len(palette) < needed_piece_colors:\n        return None\n    non_unit_colors = palette[:n_slots - n_units]\n    unit_color = palette[n_slots - n_units]\n\n    # Build layout\n    slots = _gen_layout(layout_h, layout_w, n_slots, n_units)\n    if slots is None:\n        return None\n    unit_slots = slots[:n_units]\n    non_unit_slots = slots[n_units:]\n\n    # Validate that holes touch all 4 borders (so solver's tight-crop matches our layout)\n    layout_mask = np.zeros((layout_h, layout_w), dtype=bool)\n    for s in slots:\n        layout_mask[s[\"coords\"][:, 0], s[\"coords\"][:, 1]] = True\n    if not (layout_mask[0].any() and layout_mask[-1].any()\n            and layout_mask[:, 0].any() and layout_mask[:, -1].any()):\n        return None\n\n    # Build pieces\n    pieces = [_make_piece(s, non_unit_colors[i], k, apply_dihedral=True)\n              for i, s in enumerate(non_unit_slots)]\n    pieces += [_make_piece(s, unit_color, k, apply_dihedral=False)\n               for s in unit_slots]\n\n    # Build expected output\n    expected_out = _build_expected_output(pieces, layout_h, layout_w, k, frame_color)\n\n    # Build input canvas\n    canvas = _build_input_canvas(pieces, layout_mask, layout_h, layout_w, k,\n                                 frame_color, distractor_color)\n    if canvas is None:\n        return None\n\n    # Oracle check\n    try:\n        produced = main(canvas)\n    except Exception:\n        return None\n    if not np.array_equal(produced, expected_out):\n        return None\n\n    return canvas\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATE_MAX_RETRIES):\n        res = _gen_attempt()\n        if res is not None:\n            return res\n    raise RuntimeError(\"generate_input: failed to generate after %d attempts\" % GENERATE_MAX_RETRIES)\n===== /home/lixinyu/snap/new/ARC_code/eval/2c181942.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Attach monochrome sprites to the matching sides of a central hollow square.\n\n    Input structure:\n    - bg = background. A hollow NxN square (hub) with bg corners/interior and four differently-colored edges (top, bottom, left, right).\n    - 2-4 monochrome sprites scattered on the grid, each matching one hub edge color.\n\n    Rule:\n    - For each hub edge color, find the matching sprite outside the hub.\n    - Rotate the sprite (0/90/180/270°) so its contact edge has exactly N-2 contiguous cells aligned with the hub side, and the rotated sprite is mirror-symmetric along the contact-edge axis (UD for left/right, LR for top/bottom).\n    - Translate it to adjoin that hub side. \n    - Clear everything else to bg; output is hub + attached sprites only.\n\n    Key insight: Each edge color uniquely pairs a sprite to a side; symmetry along the contact-edge axis disambiguates the correct rotation.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def _find_hub():\n        best = None  # (score, (r,c,n), (top,bot,left,right))\n        for n in range(3, 7):\n            for r in range(0, int(H - n + 1)):\n                for c in range(0, int(W - n + 1)):\n                    # corners must be bg\n                    if (\n                        int(g[int(r), int(c)]) != int(bg)\n                        or int(g[int(r), int(c + n - 1)]) != int(bg)\n                        or int(g[int(r + n - 1), int(c)]) != int(bg)\n                        or int(g[int(r + n - 1), int(c + n - 1)]) != int(bg)\n                    ):\n                        continue\n                    inner = g[int(r + 1) : int(r + n - 1), int(c + 1) : int(c + n - 1)]\n                    if not bool((inner == int(bg)).all()):\n                        continue\n\n                    top = g[int(r), int(c + 1) : int(c + n - 1)]\n                    bot = g[int(r + n - 1), int(c + 1) : int(c + n - 1)]\n                    left = g[int(r + 1) : int(r + n - 1), int(c)]\n                    right = g[int(r + 1) : int(r + n - 1), int(c + n - 1)]\n\n                    if bool((top == int(bg)).any()) or bool((bot == int(bg)).any()) or bool((left == int(bg)).any()) or bool((right == int(bg)).any()):\n                        continue\n                    if (\n                        len(set(map(int, top))) != 1\n                        or len(set(map(int, bot))) != 1\n                        or len(set(map(int, left))) != 1\n                        or len(set(map(int, right))) != 1\n                    ):\n                        continue\n\n                    cr = float(r + (n - 1) / 2)\n                    cc = float(c + (n - 1) / 2)\n                    score = abs(float(cr - (H - 1) / 2)) + abs(float(cc - (W - 1) / 2))\n                    cand = (\n                        float(score),\n                        (int(r), int(c), int(n)),\n                        (int(top[0]), int(bot[0]), int(left[0]), int(right[0])),\n                    )\n                    if best is None or float(cand[0]) < float(best[0]):\n                        best = cand\n        return best\n\n    hub = _find_hub()\n    assert not (hub is None)\n\n    _score, (r, c, n), (top_col, bot_col, left_col, right_col) = hub\n    hub_mask = np.zeros((H, W), dtype=bool)\n    hub_mask[int(r) : int(r + n), int(c) : int(c + n)] = True\n\n    out = np.full_like(g, int(bg))\n    out[int(r) : int(r + n), int(c) : int(c + n)] = g[int(r) : int(r + n), int(c) : int(c + n)]\n\n    target = int(n - 2)  # length of the hub edge segment (excluding corners)\n\n    def _crop_to_mask(arr: np.ndarray, mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:\n        pts = np.argwhere(mask)\n        r0, c0, r1, c1 = bbox_coords(pts)\n        return arr[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1], mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]\n\n    def _edge_segment(mask: np.ndarray, side: str):\n        pts = np.argwhere(mask)\n        if pts.size == 0:\n            return None\n        if side == \"top\":\n            rr = int(pts[:, 0].min())\n            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n            return (\"h\", int(rr), cols)\n        if side == \"bot\":\n            rr = int(pts[:, 0].max())\n            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n            return (\"h\", int(rr), cols)\n        if side == \"left\":\n            cc = int(pts[:, 1].min())\n            rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n            return (\"v\", int(cc), rows)\n        if side == \"right\":\n            cc = int(pts[:, 1].max())\n            rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n            return (\"v\", int(cc), rows)\n        return None\n\n    def _is_contig(seq: list[int]) -> bool:\n        return bool(seq) and all(int(seq[i]) + 1 == int(seq[i + 1]) for i in range(len(seq) - 1))\n\n    # desired attachment geometry: adjacent (touching) the hub side segment\n    segs = {\n        \"top\": (int(top_col), (\"bot\", int(r - 1), list(range(int(c + 1), int(c + n - 1))))),\n        \"bot\": (int(bot_col), (\"top\", int(r + n), list(range(int(c + 1), int(c + n - 1))))),\n        \"left\": (int(left_col), (\"right\", int(c - 1), list(range(int(r + 1), int(r + n - 1))))),\n        \"right\": (int(right_col), (\"left\", int(c + n), list(range(int(r + 1), int(r + n - 1))))),\n    }\n\n    for _side, (col, (need_edge, fixed, span)) in segs.items():\n        col = int(col)\n        m = (g == int(col)) & (~hub_mask)\n        if not bool(m.any()):\n            continue\n\n        # Sprites can be only diagonally connected (e.g. V-shapes), so extract with 8-connectivity.\n        labc, nc = label_mask(m, connectivity=8)\n        best_id = None\n        best_sz = -1\n        for cid in range(1, int(nc) + 1):\n            sz = int((labc == int(cid)).sum())\n            if sz > best_sz:\n                best_sz = sz\n                best_id = int(cid)\n        if best_id is None or best_sz <= 0:\n            continue\n\n        spr_mask = labc == int(best_id)\n        spr_arr = g.copy()\n        spr_arr[~spr_mask] = int(bg)\n        spr_arr, spr_mask = _crop_to_mask(spr_arr, spr_mask)\n\n        found = None  # (a, msk, dr, dc)\n        for krot in range(4):\n            a = np.rot90(spr_arr, int(krot))\n            msk = np.rot90(spr_mask, int(krot))\n            a, msk = _crop_to_mask(a, msk)\n\n            # Attached sprite must be mirror-symmetric along the contact edge axis\n            if need_edge in (\"left\", \"right\"):\n                if not bool(np.array_equal(msk, np.flipud(msk))):\n                    continue\n            else:\n                if not bool(np.array_equal(msk, np.fliplr(msk))):\n                    continue\n\n            seg = _edge_segment(msk, need_edge)\n            if seg is None:\n                continue\n\n            if need_edge in (\"left\", \"right\"):\n                _typ, edge_c, rows = seg\n                if len(rows) != int(target) or not _is_contig(rows):\n                    continue\n                dr = int(span[0] - rows[0])\n                dc = int(fixed - edge_c)\n            else:\n                _typ, edge_r, cols = seg\n                if len(cols) != int(target) or not _is_contig(cols):\n                    continue\n                dr = int(fixed - edge_r)\n                dc = int(span[0] - cols[0])\n\n            placed = {(int(rr + dr), int(cc2 + dc)) for rr, cc2 in np.argwhere(msk)}\n            if any(not (0 <= R < H and 0 <= C < W) for R, C in placed):\n                continue\n\n            # ensure no conflicts with already-drawn hub (or previously placed sprites)\n            ok = True\n            for R, C in placed:\n                val = int(a[int(R - dr), int(C - dc)])\n                if val == int(bg):\n                    continue\n                if int(out[int(R), int(C)]) != int(bg) and int(out[int(R), int(C)]) != val:\n                    ok = False\n                    break\n            if not ok:\n                continue\n\n            found = (a, msk, int(dr), int(dc))\n            break\n\n        if found is None:\n            continue\n\n        a, msk, dr, dc = found\n        paste(out, a, int(dr), int(dc), mask=msk, overwrite=True, clip=True)\n\n    return out\n\n\n# ---------------------------------------------------------------------------\n# Generator\n# ---------------------------------------------------------------------------\n\nfrom scipy.ndimage import label as _label\n\ndef _make_sprite_mask(edge_len: int, side: str, rng: random.Random) -> np.ndarray | None:\n    \"\"\"\n    Constructively build a sprite mask in the attached orientation for `side`.\n    The mask is bool, 8-connected, has the correct symmetry and contact-edge length,\n    and exactly 1 rotation (out of 4) is a valid attachment for any hub side.\n\n    Strategy: build in canonical \"left-attach\" frame (flipud symmetric, contact on right col),\n    then rotate to the target side.\n    \"\"\"\n    # Build in \"left-attach\" frame: h rows, w cols.\n    # Right column = contact edge with exactly `edge_len` contiguous filled cells.\n    # flipud symmetric (rows mirror top-to-bottom).\n    # h > w ensures not square, breaking 90-degree rotation ambiguity.\n    # Also ensure NOT fliplr symmetric to prevent the complementary side matching.\n    e = edge_len  # = 2 for N=4\n    h = rng.choice([3, 4])  # height: 3 or 4 (must be > e to break symmetry)\n    w = rng.randint(2, 4)   # width: 2-4 (cols including the contact column)\n\n    half_h = (h + 1) // 2  # rows to decide (rest mirrored vertically)\n\n    for _attempt in range(100):\n        grid = np.zeros((h, w), dtype=bool)\n\n        # Contact edge: rightmost column, middle `e` rows filled, rest empty.\n        # For flipud symmetry with h=3 or h=4 and e=2:\n        #   h=3: rows 0,2 empty; row 1 filled -> only 1 contiguous. No good.\n        #   Actually for h=4, e=2: rows 1,2 filled (symmetric pair). Contact = [F,T,T,F]\n        #   For h=3, e=2: rows 0,2 mirrored. If row 0=T, row 2=T, row 1=T -> 3 contig.\n        #                  If row 0=F, row 2=F, row 1=T -> 1 contig. Not enough.\n        #                  Need to allow row0=T,row1=T,row2=T -> 3 != e.\n        # So for h=3, e=2 the rightmost col can't have exactly 2 contiguous cells\n        # with flipud symmetry. Let me think differently.\n\n        # The contact edge doesn't have to span the full height. It's the N-2 contiguous\n        # cells on the attachment side. For \"left-attach\", the solver checks the RIGHT edge\n        # of the cropped sprite: exactly e contiguous filled cells.\n\n        # Build each row from right to left. Rightmost col is the contact column.\n        # For flipud symmetry, row[i] mirrors row[h-1-i].\n        # Decide top half, mirror to bottom.\n\n        for ri in range(half_h):\n            mirror_ri = h - 1 - ri\n            for ci in range(w):\n                if ci == w - 1:\n                    # Contact column: fill rows that form the contiguous e-block\n                    # Place the e-block centered. For h=4,e=2: rows 1,2. For h=3,e=2: impossible with strict flipud.\n                    # Instead: just decide freely and check later\n                    val = rng.random() < 0.5\n                else:\n                    val = rng.random() < 0.5\n                grid[ri, ci] = val\n                grid[mirror_ri, ci] = val\n\n        # Check: rightmost column has exactly e contiguous filled cells\n        right_col = grid[:, -1]\n        # Find contiguous runs\n        runs = []\n        count = 0\n        for v in right_col:\n            if v:\n                count += 1\n            else:\n                if count > 0:\n                    runs.append(count)\n                count = 0\n        if count > 0:\n            runs.append(count)\n        if len(runs) != 1 or runs[0] != e:\n            continue\n\n        # Trim empty rows/cols\n        rows_any = grid.any(axis=1)\n        cols_any = grid.any(axis=0)\n        if not rows_any.any():\n            continue\n        r0, r1 = np.where(rows_any)[0][[0, -1]]\n        c0, c1 = np.where(cols_any)[0][[0, -1]]\n        grid = grid[r0:r1+1, c0:c1+1]\n\n        if grid.shape[0] < 2 or grid.shape[1] < 2:\n            continue\n\n        # Check flipud symmetry\n        if not np.array_equal(grid, np.flipud(grid)):\n            continue\n\n        # Check 8-connectivity\n        labeled, num = _label(grid, structure=np.ones((3, 3), dtype=int))\n        if num != 1:\n            continue\n\n        # Must NOT be fliplr symmetric (to avoid the other side matching)\n        if np.array_equal(grid, np.fliplr(grid)):\n            continue\n\n        # Pixel count 4-12\n        px = int(grid.sum())\n        if px < 4 or px > 12:\n            continue\n\n        # Now verify exactly 1 valid attachment across all 4 rotations x 4 sides.\n        # The solver, for each side, tries rot90 x 0-3 and checks:\n        #   - correct symmetry (fliplr for top/bot, flipud for left/right)\n        #   - contact edge = e contiguous cells on the correct side\n        # We need exactly 1 such (rotation, side) pair across all possibilities.\n        # Actually, the solver matches by color, so each sprite is only tested against\n        # one side. But we need: for ANY side the solver might try, only 1 rotation works.\n        # Since the solver already picks the first valid rotation, we just need that\n        # for the intended side, exactly 1 rotation of the sprite is valid.\n\n        # Check: for the canonical \"left\" side, how many rotations are valid?\n        valid_for_left = 0\n        for k in range(4):\n            rot = np.rot90(grid, k)\n            # Trim\n            ra = rot.any(axis=1)\n            ca = rot.any(axis=0)\n            rr0, rr1 = np.where(ra)[0][[0, -1]]\n            cc0, cc1 = np.where(ca)[0][[0, -1]]\n            cr = rot[rr0:rr1+1, cc0:cc1+1]\n            # Left side needs flipud + right-edge = e contiguous\n            if not np.array_equal(cr, np.flipud(cr)):\n                continue\n            rc = cr[:, -1]\n            runs2 = []\n            cnt2 = 0\n            for v in rc:\n                if v: cnt2 += 1\n                else:\n                    if cnt2 > 0: runs2.append(cnt2)\n                    cnt2 = 0\n            if cnt2 > 0: runs2.append(cnt2)\n            if len(runs2) == 1 and runs2[0] == e:\n                valid_for_left += 1\n\n        if valid_for_left != 1:\n            continue\n\n        # Success! Now rotate to target side.\n        # grid is in \"left-attach\" frame (contact on right, flipud symmetric).\n        # left -> as-is\n        # right -> fliplr (contact moves to left side)\n        # top -> rot90 CW (contact moves to bottom)\n        # bot -> rot90 CCW (contact moves to top)\n        if side == \"left\":\n            mask = grid.copy()\n        elif side == \"right\":\n            mask = np.fliplr(grid)\n        elif side == \"top\":\n            mask = np.rot90(grid, -1)  # CW: right->bottom\n        else:  # bot\n            mask = np.rot90(grid, 1)   # CCW: right->top\n        return mask\n\n    return None\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = random.Random()\n    bg = 8\n    N = 4\n    edge_len = N - 2  # = 2\n\n    H = rng.randint(18, 26)\n    W = rng.randint(20, 26)\n\n    # Choose 4 distinct non-bg colors for hub edges\n    all_colors = [c for c in range(10) if c != bg]\n    rng.shuffle(all_colors)\n    top_col, bot_col, left_col, right_col = all_colors[:4]\n\n    sides = [\"top\", \"bot\", \"left\", \"right\"]\n    side_colors = {\"top\": top_col, \"bot\": bot_col, \"left\": left_col, \"right\": right_col}\n\n    # Choose K sides (2-4) to get sprites\n    K = rng.randint(2, 4)\n    sprite_sides = rng.sample(sides, K)\n\n    # Generate sprite masks for each chosen side\n    sprite_masks = {}\n    for side in sprite_sides:\n        mask = _make_sprite_mask(edge_len, side, rng)\n        if mask is None:\n            return None\n        sprite_masks[side] = mask\n\n    # Compute max sprite extent to ensure enough margin for hub placement\n    max_sprite_h = max(m.shape[0] for m in sprite_masks.values())\n    max_sprite_w = max(m.shape[1] for m in sprite_masks.values())\n    max_extent = max(max_sprite_h, max_sprite_w)\n    margin = max_extent + 2\n\n    # Place hub near center with margin\n    hub_r_min = margin\n    hub_r_max = H - N - margin\n    hub_c_min = margin\n    hub_c_max = W - N - margin\n    if hub_r_min > hub_r_max or hub_c_min > hub_c_max:\n        return None\n\n    hub_r = rng.randint(hub_r_min, hub_r_max)\n    hub_c = rng.randint(hub_c_min, hub_c_max)\n\n    # Build output grid\n    out = np.full((H, W), bg, dtype=int)\n\n    # Place hub\n    # Top edge\n    for ci in range(1, N - 1):\n        out[hub_r, hub_c + ci] = top_col\n    # Bottom edge\n    for ci in range(1, N - 1):\n        out[hub_r + N - 1, hub_c + ci] = bot_col\n    # Left edge\n    for ri in range(1, N - 1):\n        out[hub_r + ri, hub_c] = left_col\n    # Right edge\n    for ri in range(1, N - 1):\n        out[hub_r + ri, hub_c + N - 1] = right_col\n\n    # Attach sprites to hub in output\n    attached_sprites = {}  # side -> (arr, mask, sr, sc) in output coords\n    for side in sprite_sides:\n        mask = sprite_masks[side]\n        sh, sw = mask.shape\n        color = side_colors[side]\n        arr = np.where(mask, color, bg).astype(int)\n\n        # Compute placement so sprite's contact edge is flush with hub side.\n        # The solver's segs dict defines: for each side, the contact position and span.\n        #   top -> sprite's bot row at hub_r-1, cols hub_c+1..hub_c+N-2\n        #   bot -> sprite's top row at hub_r+N, cols hub_c+1..hub_c+N-2\n        #   left -> sprite's right col at hub_c-1, rows hub_r+1..hub_r+N-2\n        #   right -> sprite's left col at hub_c+N, rows hub_r+1..hub_r+N-2\n        if side == \"top\":\n            # Find first filled col on bottom row of sprite\n            filled = np.where(mask[-1])[0]\n            sc = hub_c + 1 - int(filled[0])\n            sr = hub_r - sh  # bottom row of sprite at row hub_r-1\n        elif side == \"bot\":\n            filled = np.where(mask[0])[0]\n            sc = hub_c + 1 - int(filled[0])\n            sr = hub_r + N  # top row of sprite at row hub_r+N\n        elif side == \"left\":\n            filled = np.where(mask[:, -1])[0]\n            sr = hub_r + 1 - int(filled[0])\n            sc = hub_c - sw  # right col of sprite at col hub_c-1\n        else:  # right\n            filled = np.where(mask[:, 0])[0]\n            sr = hub_r + 1 - int(filled[0])\n            sc = hub_c + N  # left col of sprite at col hub_c+N\n\n        # Check bounds\n        if sr < 0 or sc < 0 or sr + sh > H or sc + sw > W:\n            return None\n\n        # Check no overlap with existing content\n        for r in range(sh):\n            for c in range(sw):\n                if mask[r, c] and out[sr + r, sc + c] != bg:\n                    return None\n\n        paste(out, arr, sr, sc, transparent=bg)\n        attached_sprites[side] = (arr, mask, sr, sc)\n\n    # Verify output is correct by running solver later (via oracle check)\n\n    # Build input: hub + scattered sprites in random rotations + optional distractor\n    inp = np.full((H, W), bg, dtype=int)\n    # Place hub on input\n    inp[hub_r:hub_r+N, hub_c:hub_c+N] = out[hub_r:hub_r+N, hub_c:hub_c+N]\n\n    # Canvas for placement tracking\n    canvas = inp.copy()\n\n    for side in sprite_sides:\n        arr, mask, sr, sc = attached_sprites[side]\n        # Apply a random non-identity rotation\n        # But we need to ensure the solver will find the right rotation\n        # The solver uses 8-connectivity labeling and picks the largest component of matching color\n        # Apply a random rotation (1-3 quarter turns, avoiding identity)\n        k = rng.choice([1, 2, 3])\n        rotated_arr = np.rot90(arr, k)\n        rotated_mask = np.rot90(mask, k)\n\n        # Crop to bounding box of the mask\n        rows_any = rotated_mask.any(axis=1)\n        cols_any = rotated_mask.any(axis=0)\n        r0_idx, r1_idx = np.where(rows_any)[0][[0, -1]]\n        c0_idx, c1_idx = np.where(cols_any)[0][[0, -1]]\n        cropped_arr = rotated_arr[r0_idx:r1_idx+1, c0_idx:c1_idx+1]\n        cropped_mask = rotated_mask[r0_idx:r1_idx+1, c0_idx:c1_idx+1]\n        patch = np.where(cropped_mask, cropped_arr, bg).astype(int)\n\n        try:\n            pr, pc = random_free_location(canvas, patch, transparent=bg, padding=2, padding_connectivity=8)\n        except ValueError:\n            return None\n        paste(canvas, patch, pr, pc, transparent=bg)\n        paste(inp, patch, pr, pc, transparent=bg)\n\n    # Optionally add a distractor (0 or 1)\n    if rng.random() < 0.3:\n        used_colors = set(side_colors.values())\n        distractor_colors = [c for c in range(10) if c != bg and c not in used_colors]\n        if distractor_colors:\n            dcol = rng.choice(distractor_colors)\n            # Make a small distractor sprite\n            dist_mask = _make_sprite_mask(edge_len, rng.choice(sides), rng)\n            if dist_mask is not None:\n                dist_arr = np.where(dist_mask, dcol, bg).astype(int)\n                try:\n                    pr, pc = random_free_location(canvas, dist_arr, transparent=bg, padding=2, padding_connectivity=8)\n                    paste(canvas, dist_arr, pr, pc, transparent=bg)\n                    paste(inp, dist_arr, pr, pc, transparent=bg)\n                except ValueError:\n                    pass  # skip distractor if no room\n\n    # Oracle check\n    result = main(inp)\n    if not np.array_equal(result, out):\n        return None\n\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n===== /home/lixinyu/snap/new/ARC_code/train/465b7d93.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.\n\n    Input structure:\n    - The background is the dominant color.\n    - There are exactly two foreground colors: one forms a complete rectangular\n      one-pixel-thick frame, and the other forms one 4-connected sprite outside it.\n    - The frame interior is initially background.\n\n    Rule:\n    - Clear the original sprite from its outside location.\n    - Map the sprite bbox to the frame interior bbox, sending bbox extremes to\n      interior extremes.\n    - Draw straight horizontal or vertical segments between mapped positions of\n      adjacent sprite pixels, then fill any enclosed background region inside\n      those drawn segments.\n\n    Key insight:\n    The outside sprite is a miniature line/fill diagram for the frame interior,\n    not a bitmap to scale by block replication.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected one frame color and one sprite color\"\n\n    frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []\n    for color in colors:\n        frame_bbox = _rect_frame_bbox(g == int(color))\n        if frame_bbox is not None:\n            frame_candidates.append((int(color), frame_bbox))\n    assert len(frame_candidates) == 1, \"expected a unique rectangular frame\"\n\n    frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]\n    sprite_color = next(color for color in colors if color != frame_color)\n    sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)\n    assert len(sprite_components) == 1, \"expected a single 4-connected sprite\"\n    frame_region = np.zeros_like(g, dtype=bool)\n    frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True\n    assert not np.any((g == sprite_color) & frame_region), \"sprite must start outside the frame\"\n\n    sr0, sc0, sr1, sc1 = sprite_components[0][\"bbox\"]\n    sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color\n\n    ir0, ic0 = fr0 + 1, fc0 + 1\n    ir1, ic1 = fr1 - 1, fc1 - 1\n    assert ir0 <= ir1 and ic0 <= ic1, \"frame must have an interior\"\n    interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]\n    assert np.all(interior == bg), \"frame interior must start empty\"\n\n    stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))\n    out = g.copy()\n    out[g == sprite_color] = bg\n    out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and observed fixed colors.\n_GRID_SHAPE = (10, 10)\n_COLOR_COUNT = 10\n_BG = 7\n_FRAME_COLOR = 6\n\n# Frame size bounds and retry budget.\n_FRAME_SIZE_MIN = 3\n_FRAME_SIZE_MAX = 8\n_SINGLE_PIXEL_FRAME_SIZE = 3\n_MAX_GENERATION_ATTEMPTS = 300\n\n# Sprite color pool and source masks.\n_SPRITE_COLORS = tuple(c for c in range(_COLOR_COUNT) if c not in {_BG, _FRAME_COLOR})\n_SPRITE_SINGLE = np.ones((1, 1), dtype=bool)\n_SPRITE_PATTERNS_2X2 = [\n    np.array([[1, 1], [1, 0]], dtype=bool),\n    np.array([[1, 1], [0, 1]], dtype=bool),\n    np.array([[1, 0], [1, 1]], dtype=bool),\n    np.array([[0, 1], [1, 1]], dtype=bool),\n    np.array([[1, 1], [1, 1]], dtype=bool),\n]\n\ndef _outside_locations(\n    frame_bbox: tuple[int, int, int, int], patch_shape: tuple[int, int]\n) -> list[tuple[int, int]]:\n    fr0, fc0, fr1, fc1 = frame_bbox\n    ph, pw = patch_shape\n    locations: list[tuple[int, int]] = []\n    for r in range(_GRID_SHAPE[0] - ph + 1):\n        for c in range(_GRID_SHAPE[1] - pw + 1):\n            pr0, pc0, pr1, pc1 = r, c, r + ph - 1, c + pw - 1\n            separated = pr1 < fr0 or pr0 > fr1 or pc1 < fc0 or pc0 > fc1\n            if separated:\n                locations.append((r, c))\n    return locations\n\ndef _frame_positions(size: int, patch_shape: tuple[int, int]) -> list[tuple[int, int]]:\n    positions: list[tuple[int, int]] = []\n    for r in range(_GRID_SHAPE[0] - size + 1):\n        for c in range(_GRID_SHAPE[1] - size + 1):\n            frame_bbox = (r, c, r + size - 1, c + size - 1)\n            if _outside_locations(frame_bbox, patch_shape):\n                positions.append((r, c))\n    return positions\n\ndef _draw_frame(grid: np.ndarray, r0: int, c0: int, size: int, color: int) -> None:\n    r1, c1 = r0 + size - 1, c0 + size - 1\n    grid[r0 : r1 + 1, c0] = color\n    grid[r0 : r1 + 1, c1] = color\n    grid[r0, c0 : c1 + 1] = color\n    grid[r1, c0 : c1 + 1] = color\n\ndef _sample_sprite(size: int) -> np.ndarray:\n    return _SPRITE_SINGLE.copy() if size == _SINGLE_PIXEL_FRAME_SIZE else random.choice(_SPRITE_PATTERNS_2X2).copy()\n\ndef _sample_case() -> tuple[int, int, np.ndarray]:\n    sprite_color = random.choice(_SPRITE_COLORS)\n    size = random.randint(_FRAME_SIZE_MIN, _FRAME_SIZE_MAX)\n    return sprite_color, size, _sample_sprite(size)\n\ndef _build_candidate_grids(\n    frame_bbox: tuple[int, int, int, int], sprite: np.ndarray, sprite_color: int\n) -> tuple[np.ndarray, np.ndarray] | None:\n    fr0, fc0, fr1, fc1 = frame_bbox\n    stretched = _stretch_sprite(sprite, (fr1 - fr0 - 1, fc1 - fc0 - 1))\n    if not np.any(stretched):\n        return None\n\n    out = np.full(_GRID_SHAPE, _BG, dtype=int)\n    _draw_frame(out, fr0, fc0, fr1 - fr0 + 1, _FRAME_COLOR)\n    out[fr0 + 1 : fr1, fc0 + 1 : fc1][stretched] = sprite_color\n\n    inp = out.copy()\n    inp[fr0 + 1 : fr1, fc0 + 1 : fc1] = _BG\n\n    locations = _outside_locations(frame_bbox, sprite.shape)\n    if not locations:\n        return None\n    sr, sc = random.choice(locations)\n    patch = np.where(sprite, sprite_color, _BG)\n    paste(inp, patch, sr, sc, transparent=_BG)\n    return inp, out\n\ndef _gen_attempt() -> np.ndarray | None:\n    sprite_color, size, sprite = _sample_case()\n\n    frame_positions = _frame_positions(size, sprite.shape)\n    if not frame_positions:\n        return None\n    fr0, fc0 = random.choice(frame_positions)\n    frame_bbox = (fr0, fc0, fr0 + size - 1, fc0 + size - 1)\n\n    candidate = _build_candidate_grids(frame_bbox, sprite, sprite_color)\n    if candidate is None:\n        return None\n    inp, out = candidate\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 465b7d93 input\")\n===== /home/lixinyu/snap/new/ARC_code/train/ad173014.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor each framed interior mask with the color from the next red frame clockwise around the blue connector cycle.\n\n    Input structure\n    - The grid contains hollow red square frames connected pairwise by blue line components.\n    - The blue components connect the frames into one cycle, with every frame touching exactly two blue components.\n    - Each frame interior contains background plus exactly one non-background color mask.\n\n    Rule\n    - Sort the red frames clockwise by their centers around the cycle.\n    - Keep each frame's interior mask shape in place, but recolor it with the interior color from the next clockwise frame.\n    - Leave the red frames, blue connectors, background, and interior background holes unchanged.\n\n    Key insight\n    - The colored masks do not move; the blue cycle gives the order in which their colors rotate.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    frames, red_components = _extract_frames(g, bg)\n    edges = _blue_cycle_edges(g, red_components)\n    order = _clockwise_order(frames, edges)\n\n    out = g.copy()\n    for k, frame_id in enumerate(order):\n        next_id = order[(k + 1) % len(order)]\n        r0, c0, r1, c1 = frames[frame_id][\"bbox\"]\n        interior = out[r0 + 1 : r1, c0 + 1 : c1]\n        interior[frames[frame_id][\"mask\"]] = frames[next_id][\"color\"]\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Palette constants.\nBG = 0\nCONNECTOR_BLUE = 1\nFRAME_RED = 2\nINTERIOR_COLORS = [3, 4, 5, 6, 7, 8, 9]\n\n# Canvas and frame bounds.\nFRAME_COUNT_RANGE = (3, 5)\nFRAME_SIZE_CHOICES = [5, 7]\nSMALL_FRAME_GRID_H_RANGE = (20, 27)\nSMALL_FRAME_GRID_W_RANGE = (21, 27)\nLARGE_FRAME_GRID_H_RANGE = (22, 27)\nLARGE_FRAME_GRID_W_RANGE = (23, 27)\nFRAME_GAP = 1\n\n# Interior mask density.\nMIN_INTERIOR_FILL = 0.30\nMAX_INTERIOR_FILL = 0.56\nMIN_INTERIOR_CELLS = 3\n\n# Angular placement.\nANGLE_PERTURB_RANGE = (-0.3, 0.3)\nMIN_RADIUS_PAD = 1\nMAX_RADIUS_PAD = 1\nANGLE_EPS = 1e-6\n\n# Connector constraints and retry budgets.\nMAX_TWO_TURN_TRIES = 20\nCONNECTOR_LENGTH_RANGE = (2, 24)\nGENERATION_ATTEMPTS = 300\n\nNEIGHBORS_8 = [\n    (dr, dc)\n    for dr in range(-1, 2)\n    for dc in range(-1, 2)\n    if not (dr == 0 and dc == 0)\n]\n\n\ndef _gen_mask(interior_size, color):\n    \"\"\"Generate an 8-connected mask for frame interior with fill 30-56%.\"\"\"\n    n = interior_size\n    total = n * n\n    min_fill = max(MIN_INTERIOR_CELLS, int(math.ceil(MIN_INTERIOR_FILL * total)))\n    max_fill = int(math.floor(MAX_INTERIOR_FILL * total))\n    target = random.randint(min_fill, max_fill)\n\n    mask = np.zeros((n, n), dtype=int)\n    start = (n // 2, n // 2)\n    mask[start] = color\n    filled = [start]\n    frontier = set()\n    _add_mask_frontier(frontier, mask, start)\n\n    while len(filled) < target and frontier:\n        cell = random.choice(list(frontier))\n        frontier.discard(cell)\n        mask[cell] = color\n        filled.append(cell)\n        _add_mask_frontier(frontier, mask, cell)\n\n    if len(filled) < min_fill:\n        return None\n    return mask\n\n\ndef _add_mask_frontier(frontier, mask, cell):\n    n = mask.shape[0]\n    for dr, dc in NEIGHBORS_8:\n        nr, nc = cell[0] + dr, cell[1] + dc\n        if 0 <= nr < n and 0 <= nc < n and mask[nr, nc] == 0:\n            frontier.add((nr, nc))\n\n\ndef _axis_path(start, end):\n    \"\"\"Return an inclusive straight segment between row- or column-aligned cells.\"\"\"\n    sr, sc = start\n    er, ec = end\n    if sr == er:\n        step = 1 if ec > sc else -1\n        return [(sr, c) for c in range(sc, ec + step, step)]\n    step = 1 if er > sr else -1\n    return [(r, sc) for r in range(sr, er + step, step)]\n\n\ndef _one_turn_path(start, corner, end):\n    return _axis_path(start, corner) + _axis_path(corner, end)[1:]\n\n\ndef _two_turn_vhv_path(start, mid_r, end):\n    _, sc = start\n    _, ec = end\n    corner1 = (mid_r, sc)\n    corner2 = (mid_r, ec)\n    return (\n        _axis_path(start, corner1)\n        + _axis_path(corner1, corner2)[1:]\n        + _axis_path(corner2, end)[1:]\n    )\n\n\ndef _two_turn_hvh_path(start, mid_c, end):\n    sr, _ = start\n    er, _ = end\n    corner1 = (sr, mid_c)\n    corner2 = (er, mid_c)\n    return (\n        _axis_path(start, corner1)\n        + _axis_path(corner1, corner2)[1:]\n        + _axis_path(corner2, end)[1:]\n    )\n\n\ndef _path_is_free(path, occupied):\n    return all(p not in occupied for p in path)\n\n\ndef _find_path(start, end, occupied):\n    \"\"\"Find an L-shaped path (0-2 turns) from start to end avoiding occupied cells.\"\"\"\n    sr, sc = start\n    er, ec = end\n\n    if sr == er or sc == ec:\n        path = _axis_path(start, end)\n        if _path_is_free(path, occupied):\n            return path\n\n    corners = [(sr, ec), (er, sc)]\n    random.shuffle(corners)\n    for corner in corners:\n        path = _one_turn_path(start, corner, end)\n        if _path_is_free(path, occupied):\n            return path\n\n    for _ in range(MAX_TWO_TURN_TRIES):\n        if sr != er and sc != ec:\n            mid_r = random.randint(min(sr, er), max(sr, er))\n            path = _two_turn_vhv_path(start, mid_r, end)\n            if _path_is_free(path, occupied):\n                return path\n\n            mid_c = random.randint(min(sc, ec), max(sc, ec))\n            path = _two_turn_hvh_path(start, mid_c, end)\n            if _path_is_free(path, occupied):\n                return path\n\n    return None\n\n\ndef _pick_attachment(frame_bbox, side, occupied):\n    \"\"\"Pick an attachment point on the given side of a frame border.\n    Returns (border_cell, connector_start) where connector_start is one step outside.\"\"\"\n    r0, c0, r1, c1 = frame_bbox\n    if side == 'top':\n        cols = list(range(c0 + 1, c1))\n        random.shuffle(cols)\n        for c in cols:\n            border = (r0, c)\n            outside = (r0 - 1, c)\n            if outside not in occupied and 0 <= outside[0]:\n                return border, outside\n    elif side == 'bottom':\n        cols = list(range(c0 + 1, c1))\n        random.shuffle(cols)\n        for c in cols:\n            border = (r1, c)\n            outside = (r1 + 1, c)\n            if outside not in occupied:\n                return border, outside\n    elif side == 'left':\n        rows = list(range(r0 + 1, r1))\n        random.shuffle(rows)\n        for r in rows:\n            border = (r, c0)\n            outside = (r, c0 - 1)\n            if outside not in occupied and 0 <= outside[1]:\n                return border, outside\n    elif side == 'right':\n        rows = list(range(r0 + 1, r1))\n        random.shuffle(rows)\n        for r in rows:\n            border = (r, c1)\n            outside = (r, c1 + 1)\n            if outside not in occupied:\n                return border, outside\n    return None, None\n\n\ndef _best_side(frame_bbox, target_r, target_c):\n    \"\"\"Determine which side of a frame is closest to a target point.\"\"\"\n    r0, c0, r1, c1 = frame_bbox\n    cr = (r0 + r1) / 2\n    cc = (c0 + c1) / 2\n    dr = target_r - cr\n    dc = target_c - cc\n\n    if abs(dr) > abs(dc):\n        return 'bottom' if dr > 0 else 'top'\n    else:\n        return 'right' if dc > 0 else 'left'\n\n\ndef _choose_colors(n_frames):\n    avail_colors = INTERIOR_COLORS[:]\n    random.shuffle(avail_colors)\n    return avail_colors[:n_frames]\n\n\ndef _choose_grid_size(frame_size):\n    if frame_size == 7:\n        h_range = LARGE_FRAME_GRID_H_RANGE\n        w_range = LARGE_FRAME_GRID_W_RANGE\n    else:\n        h_range = SMALL_FRAME_GRID_H_RANGE\n        w_range = SMALL_FRAME_GRID_W_RANGE\n    return random.randint(*h_range), random.randint(*w_range)\n\n\ndef _frame_bboxes_overlap(a, b):\n    r0a, c0a, r1a, c1a = a\n    r0b, c0b, r1b, c1b = b\n    return not (\n        r1a + FRAME_GAP < r0b\n        or r1b + FRAME_GAP < r0a\n        or c1a + FRAME_GAP < c0b\n        or c1b + FRAME_GAP < c0a\n    )\n\n\ndef _place_frame_bboxes(n_frames, frame_size, grid_h, grid_w):\n    \"\"\"Place non-overlapping frame boxes in clockwise angular order.\"\"\"\n    center_r = grid_h / 2\n    center_c = grid_w / 2\n\n    base_angles = [2 * math.pi * i / n_frames for i in range(n_frames)]\n    angle_perturb = [random.uniform(*ANGLE_PERTURB_RANGE) for _ in range(n_frames)]\n    angles = [base_angles[i] + angle_perturb[i] for i in range(n_frames)]\n    angles.sort()\n\n    min_radius = frame_size + MIN_RADIUS_PAD\n    max_radius = min(grid_h, grid_w) / 2 - frame_size / 2 - MAX_RADIUS_PAD\n    if max_radius < min_radius:\n        return None\n\n    frame_bboxes = []\n    for angle in angles:\n        radius = random.uniform(min_radius, max_radius)\n        fr = center_r + radius * math.sin(angle) - frame_size / 2\n        fc = center_c + radius * math.cos(angle) - frame_size / 2\n        fr = int(round(fr))\n        fc = int(round(fc))\n        fr = max(0, min(grid_h - frame_size, fr))\n        fc = max(0, min(grid_w - frame_size, fc))\n        frame_bboxes.append((fr, fc, fr + frame_size - 1, fc + frame_size - 1))\n\n    for i in range(n_frames):\n        for j in range(i + 1, n_frames):\n            if _frame_bboxes_overlap(frame_bboxes[i], frame_bboxes[j]):\n                return None\n\n    for r0, c0, r1, c1 in frame_bboxes:\n        if r0 < 0 or c0 < 0 or r1 >= grid_h or c1 >= grid_w:\n            return None\n    return frame_bboxes\n\n\ndef _gen_clockwise_order(frame_bboxes):\n    \"\"\"Return frame indexes sorted by angle around their shared centroid.\"\"\"\n    n_frames = len(frame_bboxes)\n    centers = [((r0 + r1) / 2, (c0 + c1) / 2) for r0, c0, r1, c1 in frame_bboxes]\n    mean_r = sum(c[0] for c in centers) / n_frames\n    mean_c = sum(c[1] for c in centers) / n_frames\n    cw_angles = [math.atan2(c[0] - mean_r, c[1] - mean_c) for c in centers]\n\n    sorted_angles = sorted(enumerate(cw_angles), key=lambda x: x[1])\n    angle_vals = [a for _, a in sorted_angles]\n    for i in range(len(angle_vals) - 1):\n        if abs(angle_vals[i + 1] - angle_vals[i]) < ANGLE_EPS:\n            return None, None\n    return [idx for idx, _ in sorted_angles], centers\n\n\ndef _draw_frame(grid, frame_bbox, occupied):\n    r0, c0, r1, c1 = frame_bbox\n    grid[r0, c0:c1 + 1] = FRAME_RED\n    grid[r1, c0:c1 + 1] = FRAME_RED\n    grid[r0:r1 + 1, c0] = FRAME_RED\n    grid[r0:r1 + 1, c1] = FRAME_RED\n    for c in range(c0, c1 + 1):\n        occupied.add((r0, c))\n        occupied.add((r1, c))\n    for r in range(r0, r1 + 1):\n        occupied.add((r, c0))\n        occupied.add((r, c1))\n\n\ndef _place_mask(grid, frame_bbox, mask, occupied):\n    r0, c0, _, _ = frame_bbox\n    rows, cols = np.nonzero(mask)\n    grid[r0 + 1 + rows, c0 + 1 + cols] = mask[rows, cols]\n    occupied.update((r0 + 1 + int(r), c0 + 1 + int(c)) for r, c in zip(rows, cols))\n\n\ndef _render_frames(grid, frame_bboxes, colors, interior_size):\n    \"\"\"Draw frame borders and colored interior masks; return the occupied cells.\"\"\"\n    masks = []\n    occupied = set()\n    for frame_bbox, color in zip(frame_bboxes, colors):\n        _draw_frame(grid, frame_bbox, occupied)\n        mask = _gen_mask(interior_size, color)\n        if mask is None:\n            return None\n        masks.append(mask)\n        _place_mask(grid, frame_bbox, mask, occupied)\n    return occupied\n\n\ndef _path_in_bounds(path, grid_h, grid_w):\n    return all(0 <= r < grid_h and 0 <= c < grid_w for r, c in path)\n\n\ndef _draw_path(grid, path, occupied):\n    for r, c in path:\n        grid[r, c] = CONNECTOR_BLUE\n        occupied.add((r, c))\n\n\ndef _connect_cycle(grid, frame_bboxes, centers, cw_order, occupied):\n    \"\"\"Connect adjacent clockwise frames with bounded blue paths.\"\"\"\n    grid_h, grid_w = grid.shape\n    n_frames = len(frame_bboxes)\n    for k in range(n_frames):\n        fi = cw_order[k]\n        fj = cw_order[(k + 1) % n_frames]\n\n        ci_r, ci_c = centers[fi]\n        cj_r, cj_c = centers[fj]\n\n        side_i = _best_side(frame_bboxes[fi], cj_r, cj_c)\n        side_j = _best_side(frame_bboxes[fj], ci_r, ci_c)\n\n        border_i, start_i = _pick_attachment(frame_bboxes[fi], side_i, occupied)\n        if border_i is None:\n            return False\n\n        border_j, start_j = _pick_attachment(frame_bboxes[fj], side_j, occupied)\n        if border_j is None:\n            return False\n\n        path = _find_path(start_i, start_j, occupied)\n        if path is None:\n            return False\n\n        min_len, max_len = CONNECTOR_LENGTH_RANGE\n        if len(path) < min_len or len(path) > max_len:\n            return False\n\n        if not _path_in_bounds(path, grid_h, grid_w):\n            return False\n        _draw_path(grid, path, occupied)\n    return True\n\n\ndef _gen_attempt():\n    n_frames = random.randint(*FRAME_COUNT_RANGE)\n    frame_size = random.choice(FRAME_SIZE_CHOICES)\n    interior_size = frame_size - 2\n    colors = _choose_colors(n_frames)\n    grid_h, grid_w = _choose_grid_size(frame_size)\n\n    frame_bboxes = _place_frame_bboxes(n_frames, frame_size, grid_h, grid_w)\n    if frame_bboxes is None:\n        return None\n\n    cw_order, centers = _gen_clockwise_order(frame_bboxes)\n    if cw_order is None:\n        return None\n\n    grid = np.zeros((grid_h, grid_w), dtype=int)\n    occupied = _render_frames(grid, frame_bboxes, colors, interior_size)\n    if occupied is None:\n        return None\n\n    if not _connect_cycle(grid, frame_bboxes, centers, cw_order, occupied):\n        return None\n\n    try:\n        main(grid)\n    except (AssertionError, Exception):\n        return None\n\n    return grid\n\n\ndef generate_input():\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py /home/lixinyu/snap/new/ARC_code/eval/8f215267.py /home/lixinyu/snap/new/ARC_code/train/8a6d367c.py; do echo \"===== $f\"; awk '\"'BEGIN{mode=0} /\"'^def main'\"\\\\(/ {mode=1} /\"'^def generate_input'\"\\\\(/ {mode=2} mode{print}' \\\"\"'$f\"; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py /home/lixinyu/snap/new/ARC_code/eval/8f215267.py /home/lixinyu/snap/new/ARC_code/train/8a6d367c.py; do echo \"===== $f\"; awk '\"'BEGIN{mode=0} /\"'^def main'\"\\\\(/ {mode=1} /\"'^def generate_input'\"\\\\(/ {mode=2} mode{print}' \\\"\"'$f\"; done'","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n    h, w = canvas_mask.shape\n    sr, sc = seed\n    if not canvas_mask[sr, sc]:\n        return None\n    blob = {(sr, sc)}\n    frontier = []\n    def push_neighbors(r, c):\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:\n                frontier.append((nr, nc))\n    push_neighbors(sr, sc)\n    while len(blob) < target_size and frontier:\n        idx = rng.randrange(len(frontier))\n        r, c = frontier.pop(idx)\n        if (r, c) in blob or not canvas_mask[r, c]:\n            continue\n        blob.add((r, c))\n        push_neighbors(r, c)\n    if len(blob) < target_size:\n        return None\n    return blob\n\n\ndef _blob_wall_cells(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n    wall = set()\n    for r, c in blob:\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in blob:\n                wall.add((nr, nc))\n    return wall\n\n\ndef _fill_holes(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Return blob with interior holes absorbed.\n\n    Barrier = blob union its wall ring. Any non-barrier cell unreachable from the grid\n    border through non-barrier cells is trapped and gets absorbed into the blob.\n    \"\"\"\n    walls = _blob_wall_cells(blob, h, w)\n    barrier = np.zeros((h, w), dtype=bool)\n    for r, c in blob:\n        barrier[r, c] = True\n    for r, c in walls:\n        barrier[r, c] = True\n\n    # Flood-fill from border through non-barrier cells.\n    reachable = np.zeros((h, w), dtype=bool)\n    stack = []\n    for r in range(h):\n        for c in (0, w - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    for c in range(w):\n        for r in (0, h - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    while stack:\n        r, c = stack.pop()\n        if reachable[r, c] or barrier[r, c]:\n            continue\n        reachable[r, c] = True\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and not reachable[nr, nc] and not barrier[nr, nc]:\n                stack.append((nr, nc))\n\n    trapped = (~reachable) & (~barrier)\n    if not trapped.any():\n        return blob\n    filled = set(blob)\n    for r, c in np.argwhere(trapped):\n        filled.add((int(r), int(c)))\n    return filled\n\n\n# ── Slide helpers ─────────────────────────────────────────────────\n\ndef _slide_step_valid(region_set: set, r: int, c: int, dr: int, dc: int) -> bool:\n    nr, nc = r + dr, c + dc\n    if (nr, nc) not in region_set:\n        return False\n    if dr != 0 and dc != 0:\n        if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n            return False\n    return True\n\n\ndef _forward_slide(region_set: set, start: tuple[int, int], dr: int, dc: int,\n                   blocked: set) -> tuple[int, int]:\n    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n    r, c = start\n    while True:\n        if not _slide_step_valid(region_set, r, c, dr, dc):\n            break\n        nr, nc = r + dr, c + dc\n        if (nr, nc) in blocked:\n            break\n        r, c = nr, nc\n    return (r, c)\n\n\n# ── Generator phases ─────────────────────────────────────────────\n\ndef _place_legends(rng: random.Random, grid: np.ndarray,\n                   ) -> tuple[np.ndarray, list[tuple[int, tuple[int,int]]]]:\n    \"\"\"Place 1-2 legend patches at grid corners.\n\n    Returns (legend_occupied mask, list of (wall_color, direction) pairs).\n    \"\"\"\n    h, w = grid.shape\n    n_legends = rng.choice([1, 2])\n    corners = rng.sample(CORNERS, n_legends)\n    wall_colors = rng.sample(WALL_COLOR_CHOICES, n_legends)\n\n    legend_occupied = np.zeros((h, w), dtype=bool)\n    legends = []\n\n    for corner, wc in zip(corners, wall_colors):\n        if rng.random() < CARDINAL_PROB:\n            dr, dc = rng.choice(CARDINAL_DIRS)\n            patch = _legend_5x5(wc, dr, dc)\n        else:\n            dr, dc = rng.choice(DIAGONAL_DIRS)\n            patch = _legend_6x7(wc, dr, dc)\n        ph, pw = patch.shape\n        r0, c0 = _corner_origin(corner, h, w, ph, pw)\n        paste(grid, patch, r0, c0)\n        # Reserve legend cells + buffer.\n        r_lo, r_hi = max(0, r0 - LEGEND_BUFFER), min(h, r0 + ph + LEGEND_BUFFER)\n        c_lo, c_hi = max(0, c0 - LEGEND_BUFFER), min(w, c0 + pw + LEGEND_BUFFER)\n        legend_occupied[r_lo:r_hi, c_lo:c_hi] = True\n        legends.append((wc, (dr, dc)))\n\n    return legend_occupied, legends\n\n\ndef _grow_regions(rng: random.Random, legends: list[tuple[int, tuple[int,int]]],\n                  legend_occupied: np.ndarray,\n                  ) -> list[dict] | None:\n    \"\"\"Grow irregular closed regions, one per assigned wall color.\n\n    Returns list of region dicts or None on failure.\n    \"\"\"\n    h, w = legend_occupied.shape\n    color_dir = {wc: d for wc, d in legends}\n    all_colors = [wc for wc, _ in legends]\n\n    # Assign 1-3 regions per wall color, cap total.\n    region_colors = []\n    for c in all_colors:\n        region_colors.extend([c] * rng.randint(*REGIONS_PER_COLOR))\n    if len(region_colors) > MAX_TOTAL_REGIONS:\n        region_colors = rng.sample(region_colors, MAX_TOTAL_REGIONS)\n    rng.shuffle(region_colors)\n\n    size_min, size_max = REGION_SIZE_BOUNDS[len(region_colors)]\n    occupied = legend_occupied.copy()\n    regions = []\n\n    for rc in region_colors:\n        dr, dc = color_dir[rc]\n        target_size = rng.randint(size_min, size_max)\n\n        # Build canvas: interior cells (not border) that are unoccupied.\n        canvas = np.ones((h, w), dtype=bool)\n        canvas[0, :] = False; canvas[-1, :] = False\n        canvas[:, 0] = False; canvas[:, -1] = False\n        canvas &= ~occupied\n        if not canvas.any():\n            continue\n\n        blob = _try_grow_valid_blob(rng, canvas, occupied, target_size, h, w)\n        if blob is None:\n            continue\n\n        walls = _blob_wall_cells(blob, h, w)\n        regions.append({'color': rc, 'dir': (dr, dc), 'interior': blob, 'walls': walls})\n\n        # Reserve blob + walls + 1-cell buffer around walls.\n        reserve = blob | walls\n        extra = set()\n        for r, c in walls:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in reserve:\n                    extra.add((nr, nc))\n        for r, c in reserve | extra:\n            occupied[r, c] = True\n\n    if not regions:\n        return None\n    # Every legend color must have at least one region.\n    if {reg['color'] for reg in regions} != set(all_colors):\n        return None\n    return regions\n\n\ndef _try_grow_valid_blob(rng: random.Random, canvas: np.ndarray,\n                         occupied: np.ndarray, target_size: int,\n                         h: int, w: int) -> set[tuple[int,int]] | None:\n    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n    for _ in range(BLOB_GROW_RETRIES):\n        free = np.argwhere(canvas)\n        if len(free) == 0:\n            break\n        sr, sc = free[rng.randrange(len(free))]\n        cand = _grow_blob(canvas, (int(sr), int(sc)), target_size, rng)\n        if cand is None:\n            continue\n        # Fill interior holes until stable.\n        while True:\n            filled = _fill_holes(cand, h, w)\n            if filled == cand:\n                break\n            cand = filled\n        # Absorbed cells must stay within canvas.\n        if any(not canvas[r, c] for r, c in cand):\n            continue\n        walls = _blob_wall_cells(cand, h, w)\n        # Walls must not overlap occupied cells or the grid border.\n        if any(occupied[wr, wc] or wr in (0, h - 1) or wc in (0, w - 1)\n               for wr, wc in walls):\n            continue\n        return cand\n    return None\n\n\ndef _validate_topology(grid: np.ndarray, regions: list[dict]) -> bool:\n    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n    h, w = grid.shape\n    labeled, n_comp = label_mask(grid == 0, connectivity=4)\n    bounded = []\n    for comp_id in range(1, n_comp + 1):\n        coords = np.argwhere(labeled == comp_id)\n        if any(r in (0, h - 1) or c in (0, w - 1) for r, c in coords):\n            continue\n        bounded.append({(int(r), int(c)) for r, c in coords})\n    region_sets = [reg['interior'] for reg in regions]\n    if len(bounded) != len(region_sets):\n        return False\n    return all(comp in region_sets for comp in bounded)\n\n\ndef _place_yellows(rng: random.Random, regions: list[dict],\n                   grid: np.ndarray) -> bool:\n    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n\n    Modifies grid in-place by painting yellow(4) at input positions.\n    Returns True on success.\n    \"\"\"\n    for reg in regions:\n        blob = reg['interior']\n        dr, dc = reg['dir']\n        n_yellows = rng.choice(YELLOWS_PER_REGION)\n\n        # Cells sorted by projection onto slide direction (farthest first).\n        cells_sorted = sorted(blob, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n        far_key = dr * cells_sorted[0][0] + dc * cells_sorted[0][1]\n        tier1 = [p for p in cells_sorted if dr * p[0] + dc * p[1] == far_key]\n\n        # Pick output positions: first at the farthest tier, second one step behind or at tier1.\n        first = tier1[rng.randrange(len(tier1))]\n        output_positions = [first]\n\n        if n_yellows == 2:\n            pr, pc = first[0] - dr, first[1] - dc\n            cands = ([(pr, pc)] if (pr, pc) in blob else []) + [p for p in tier1 if p != first]\n            if cands:\n                second = cands[rng.randrange(len(cands))]\n                if second != first:\n                    output_positions.append(second)\n\n        # Reverse-slide: process in solver order (far-to-near).\n        out_sorted = sorted(output_positions, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n        already_stopped = set()\n        yellows_input = []\n\n        for out_pos in out_sorted:\n            candidate = _find_reverse_slide(blob, out_pos, dr, dc, already_stopped,\n                                            yellows_input, rng)\n            if candidate is None:\n                return False\n            yellows_input.append(candidate)\n            already_stopped.add(out_pos)\n\n        for r, c in yellows_input:\n            grid[r, c] = 4\n    return True\n\n\ndef _find_reverse_slide(blob: set, out_pos: tuple[int,int], dr: int, dc: int,\n                        already_stopped: set, existing_inputs: list,\n                        rng: random.Random) -> tuple[int,int] | None:\n    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n    target_steps = rng.randint(1, MAX_SLIDE_STEPS)\n    for steps in range(target_steps, 0, -1):\n        r, c = out_pos\n        path_ok = True\n        for _ in range(steps):\n            pr, pc = r - dr, c - dc\n            if (pr, pc) not in blob or (pr, pc) in already_stopped or (pr, pc) in existing_inputs:\n                path_ok = False\n                break\n            if dr != 0 and dc != 0:\n                if (pr + dr, pc) not in blob or (pr, pc + dc) not in blob:\n                    path_ok = False\n                    break\n            r, c = pr, pc\n        if not path_ok:\n            continue\n        if _forward_slide(blob, (r, c), dr, dc, already_stopped) == out_pos:\n            return (r, c)\n    return None\n\n\ndef _oracle_check(input_grid: np.ndarray, regions: list[dict]) -> bool:\n    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n    h, w = input_grid.shape\n    try:\n        solver_out = main(input_grid)\n    except Exception:\n        return False\n    # Non-yellow, non-bg cells must be identical.\n    struct_mask = (input_grid != 4) & (input_grid != 0)\n    if not np.array_equal(solver_out[struct_mask], input_grid[struct_mask]):\n        return False\n    # Yellow count must be preserved.\n    if (solver_out == 4).sum() != (input_grid == 4).sum():\n        return False\n    # All output yellows must lie inside known region interiors.\n    regions_mask = np.zeros((h, w), dtype=bool)\n    for reg in regions:\n        for r, c in reg['interior']:\n            regions_mask[r, c] = True\n    return bool(np.all(regions_mask[solver_out == 4]))\n\n\n# ── Main generator ────────────────────────────────────────────────\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    h, w = GRID_H, GRID_W\n    grid = np.zeros((h, w), dtype=int)\n\n    legend_occupied, legends = _place_legends(rng, grid)\n    regions = _grow_regions(rng, legends, legend_occupied)\n    if regions is None:\n        return None\n\n    # Paint walls.\n    for reg in regions:\n        for r, c in reg['walls']:\n            grid[r, c] = reg['color']\n\n    if not _validate_topology(grid, regions):\n        return None\n\n    input_grid = grid.copy()\n    if not _place_yellows(rng, regions, input_grid):\n        return None\n    if not _oracle_check(input_grid, regions):\n        return None\n    return input_grid\n\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\n===== /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble and place enlarged sprites on a canvas using legend-panel instructions.\n\n    Input structure:\n    - Color-6 separators divide the grid into a left legend column and a main canvas.\n    - Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.\n\n    Rule:\n    - Tile the unit sprite into each active cell of the frame to build an enlarged composite.\n    - Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).\n    - Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.\n\n    Key insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    assert w >= 2, \"grid width must be >= 2\"\n\n    # Output canvas is the region between the left separator run and (optionally) a\n    # right-side separator run near the far edge (right legend panel).\n    left_sep, right_sep = _split_canvas(g)\n    left_sep_c1 = left_sep[1]\n    canvas_c0 = left_sep_c1 + 1\n    canvas_c1 = right_sep[0] if right_sep is not None else w\n    main = g[:, canvas_c0:canvas_c1].copy()\n\n    # Paint one constructed sprite per marker panel that lies outside the output canvas.\n    marker_squares = _all_marker_panel_squares(g)\n    assert marker_squares, \"no marker panel found\"\n\n    # Anchor alignment (ignore internal full-height/full-width 6 separators inside main).\n    eff_h, eff_w = main.shape\n    full6_cols = [c for c in range(eff_w) if np.all(main[:, c] == 6)]\n    if full6_cols:\n        eff_w = min(full6_cols)\n    full6_rows = [r for r in range(eff_h) if np.all(main[r, :] == 6)]\n    if full6_rows:\n        eff_h = min(full6_rows)\n\n    out = main.copy()\n    composite_written = np.zeros(out.shape, dtype=bool)\n\n    for marker_r0, marker_c0 in marker_squares:\n        # Ignore marker panels inside the output canvas; only legends should drive drawing.\n        if canvas_c0 <= marker_c0 < canvas_c1:\n            continue\n\n        if marker_c0 + 5 > w:\n            continue\n        panel = g[:, marker_c0 : marker_c0 + 5]\n\n        unit = _extract_unit_sprite(panel)\n        if unit is None:\n            continue\n        unit_sprite, unit_bb = unit\n\n        frame_bb = _extract_frame_bbox(panel, unit_bb, marker_r0)\n        if frame_bb is None:\n            continue\n        fr0, fc0, fr1, fc1 = frame_bb\n        frame = panel[fr0 : fr1 + 1, fc0 : fc1 + 1]\n        frame_mask0 = (frame != 0) & (frame != 6)\n        _, n8 = _scipy_label(frame_mask0, structure=np.ones((3, 3)))\n        assert n8 == 1, f\"frame must be 8-connected, got {n8} components\"\n\n        # Rotate layout according to clockhand.\n        dir_k = _rotation_from_clockhand(g, marker_r0, marker_c0)  # up=0, right=1, down=2, left=3\n        frame_mask = np.rot90(frame_mask0, (-dir_k) % 4)\n\n        # Build composite by tiling the unit sprite into active frame cells.\n        m_unit = (unit_sprite != 0) & (unit_sprite != 6)\n        uh, uw = unit_sprite.shape\n        fh, fw = frame_mask.shape\n        comp = np.zeros((fh * uh, fw * uw), dtype=int)\n        for i in range(fh):\n            for j in range(fw):\n                if not frame_mask[i, j]:\n                    continue\n                rr0 = i * uh\n                cc0 = j * uw\n                comp[rr0 : rr0 + uh, cc0 : cc0 + uw][m_unit] = unit_sprite[m_unit]\n\n        pos = _position_indices_from_border_square(g, marker_r0, marker_c0)\n        if pos is None:\n            continue\n        pr, pc = pos\n\n        top = _anchor_to_top_left(pr, eff_h, comp.shape[0])\n        left = _anchor_to_top_left(pc, eff_w, comp.shape[1])\n\n        ch, cw = comp.shape\n        for r in range(ch):\n            rr = top + r\n            assert 0 <= rr < out.shape[0], \"sprite row out of canvas bounds\"\n            for c in range(cw):\n                cc = left + c\n                assert 0 <= cc < out.shape[1], \"sprite col out of canvas bounds\"\n                if out[rr, cc] == 6:\n                    continue\n                val = int(comp[r, c])\n                if val != 0 and val != 6:\n                    assert not composite_written[rr, cc], \"composites must not overlap\"\n                    composite_written[rr, cc] = True\n                    out[rr, cc] = val\n    return out\n\n# --------------- generator (refine_8conn_fill_overlap) ---------------\n\n# ── CFG: tunable generation parameters ──────────────────────────────\nGRID_H_RANGE = (20, 30)         # output grid height\nGRID_W = 30                     # output grid width (fixed)\nLEGEND_COUNT_WEIGHTS = [1, 4]   # weights for [1-legend, 2-legend]\nUNIT_SIZE_RANGE = (2, 5)        # NxN unit sprite side length\nMIN_CANVAS_W = 8                # reject if canvas narrower than this\nFRAME_H_RANGE = (4, 9)          # frame mask height (before rotation)\nFRAME_W_RANGE = (3, 6)          # frame mask width  (before rotation)\nFRAME_DENSITY = 0.5             # density for random_sprite frame generation\nBAND_WIDTH_MIN = 4              # minimum band width for canvas background\nMARKER_PANEL_HEIGHT = 8         # marker square (5) + rotation patch (3)\nUSABLE_COLORS = [1, 2, 3, 4, 5, 7, 8, 9]  # all colors except 0 (bg) and 6 (separator)\nROTATION_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up/right/down/left clock-hand offsets\nGEN_RETRIES = 300               # max attempts in generate_input\n\n\ndef _allocate_colors(num_legends):\n    \"\"\"Pick unit colors (2 per legend), 2 background colors, and 1 frame color per legend.\"\"\"\n    pool = list(USABLE_COLORS)\n    random.shuffle(pool)\n\n    unit_color_sets = []\n    used_unit = set()\n    for _ in range(num_legends):\n        if len(pool) < 2:\n            return None\n        c1, c2 = pool.pop(), pool.pop()\n        unit_color_sets.append((c1, c2))\n        used_unit.update([c1, c2])\n\n    bg_cands = [c for c in pool if c not in used_unit]\n    if len(bg_cands) < 2:\n        return None\n    random.shuffle(bg_cands)\n    bg_colors = (bg_cands[0], bg_cands[1])\n\n    frame_colors = []\n    all_set = set(USABLE_COLORS)\n    for uc in unit_color_sets:\n        candidates = list(all_set - set(uc))\n        frame_colors.append(random.choice(candidates))\n\n    return unit_color_sets, bg_colors, frame_colors\n\n\ndef _color_swap(sprite, c1, c2):\n    \"\"\"Return a copy of sprite with the two colors swapped.\"\"\"\n    sa, sb = sorted([c1, c2])\n    out = sprite.copy()\n    out[sprite == sa] = sb\n    out[sprite == sb] = sa\n    return out\n\n\ndef _design_legend(leg, unit_colors, frame_color, marker_r0, grid_h, canvas_w):\n    \"\"\"Fill in sprite, frame, and rotation for one legend dict. Returns False on failure.\"\"\"\n    N = leg[\"N\"]\n    uc1, uc2 = unit_colors\n\n    # Unit sprite: NxN, fully filled, exactly 2 colors\n    sprite = np.full((N, N), uc1, dtype=int)\n    num_c2 = random.randint(1, N * N - 1)\n    for p in random.sample(range(N * N), num_c2):\n        sprite[p // N, p % N] = uc2\n\n    legend_sprite = _color_swap(sprite, uc1, uc2)\n\n    avail = marker_r0 - (N + 1)\n    # Enumerate valid (frame_H, frame_W, rot_k) combos\n    combos = []\n    for fH in range(*FRAME_H_RANGE):\n        if avail < fH + 1:\n            continue\n        for fW in range(*FRAME_W_RANGE):\n            for rk in range(4):\n                rh, rw = (fH, fW) if rk % 2 == 0 else (fW, fH)\n                if rh * N <= grid_h and rw * N <= canvas_w:\n                    combos.append((fH, fW, rk))\n    if not combos:\n        return False\n    frame_H, frame_W, rot_k = random.choice(combos)\n\n    frame_mask = random_sprite(\n        frame_H, frame_W, density=FRAME_DENSITY, connectivity=8,\n        color_palette=[1], symmetry=\"not_symmetric\"\n    ) != 0\n    rot_frame = np.rot90(frame_mask, (-rot_k) % 4)\n\n    leg.update(sprite=sprite, legend_sprite=legend_sprite, frame_mask=frame_mask,\n               frame_H=frame_H, frame_W=frame_W, frame_color=frame_color,\n               rot_k=rot_k, rotated_frame=rot_frame)\n    return True\n\n\ndef _comp_size(leg):\n    \"\"\"Return (height, width) of the composite after rotation.\"\"\"\n    rf = leg[\"rotated_frame\"]\n    N = leg[\"N\"]\n    return rf.shape[0] * N, rf.shape[1] * N\n\n\ndef _assign_anchors(legends, grid_h, canvas_w):\n    \"\"\"Assign anchor positions to legends, avoiding overlap for 2-legend case. Returns False on failure.\"\"\"\n    if len(legends) == 1:\n        pr, pc = random.randint(0, 2), random.randint(0, 2)\n        ch, cw = _comp_size(legends[0])\n        legends[0].update(pr=pr, pc=pc,\n                          comp_top=_anchor_to_top_left(pr, grid_h, ch),\n                          comp_left=_anchor_to_top_left(pc, canvas_w, cw))\n        return True\n\n    a, b = legends[0], legends[1]\n    a_ch, a_cw = _comp_size(a)\n    b_ch, b_cw = _comp_size(b)\n    valid_pairs = []\n    for apr in range(3):\n        for apc in range(3):\n            at = _anchor_to_top_left(apr, grid_h, a_ch)\n            al = _anchor_to_top_left(apc, canvas_w, a_cw)\n            if at < 0 or al < 0 or at + a_ch > grid_h or al + a_cw > canvas_w:\n                continue\n            for bpr in range(3):\n                for bpc in range(3):\n                    bt = _anchor_to_top_left(bpr, grid_h, b_ch)\n                    bl = _anchor_to_top_left(bpc, canvas_w, b_cw)\n                    if bt < 0 or bl < 0 or bt + b_ch > grid_h or bl + b_cw > canvas_w:\n                        continue\n                    # Reject overlapping bounding boxes\n                    if at < bt + b_ch and bt < at + a_ch and al < bl + b_cw and bl < al + a_cw:\n                        continue\n                    valid_pairs.append((apr, apc, at, al, bpr, bpc, bt, bl))\n    if not valid_pairs:\n        return False\n    apr, apc, at, al, bpr, bpc, bt, bl = random.choice(valid_pairs)\n    a.update(pr=apr, pc=apc, comp_top=at, comp_left=al)\n    b.update(pr=bpr, pc=bpc, comp_top=bt, comp_left=bl)\n    return True\n\n\ndef _build_banded_canvas(grid_h, canvas_w, bg1, bg2):\n    \"\"\"Build a canvas with alternating horizontal or vertical color bands.\"\"\"\n    canvas = np.zeros((grid_h, canvas_w), dtype=int)\n    band_dir = random.choice([\"h\", \"v\"])\n    dim = grid_h if band_dir == \"h\" else canvas_w\n    bw = random.randint(BAND_WIDTH_MIN, max(BAND_WIDTH_MIN, dim // 2))\n    band_indices = np.arange(dim) // bw % 2\n    colors = np.array([bg1, bg2])\n    if band_dir == \"h\":\n        canvas[:] = colors[band_indices][:, None]\n    else:\n        canvas[:] = colors[band_indices][None, :]\n    return canvas\n\n\ndef _overlay_composites(canvas, legends):\n    \"\"\"Stamp each legend's tiled composite onto the canvas (non-{0,6} pixels overwrite).\"\"\"\n    output = canvas.copy()\n    for leg in legends:\n        sp, rf = leg[\"sprite\"], leg[\"rotated_frame\"]\n        N = leg[\"N\"]\n        t, l = leg[\"comp_top\"], leg[\"comp_left\"]\n        fh, fw = rf.shape\n\n        # Build full composite by tiling the unit sprite into active frame cells\n        comp = np.zeros((fh * N, fw * N), dtype=int)\n        sprite_mask = (sp != 0) & (sp != 6)\n        for i in range(fh):\n            for j in range(fw):\n                if rf[i, j]:\n                    r0, c0 = i * N, j * N\n                    comp[r0:r0 + N, c0:c0 + N][sprite_mask] = sp[sprite_mask]\n\n        # Overwrite canvas where composite has content and canvas isn't color 6\n        region = output[t:t + fh * N, l:l + fw * N]\n        write_mask = (comp != 0) & (region != 6)\n        region[write_mask] = comp[write_mask]\n    return output\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    grid_h = random.randint(*GRID_H_RANGE)\n    num_legends = random.choices([1, 2], weights=LEGEND_COUNT_WEIGHTS)[0]\n\n    # Per legend: pick N, compute legend_w\n    legends = []\n    for _ in range(num_legends):\n        N = random.randint(*UNIT_SIZE_RANGE)\n        legends.append({\"N\": N, \"legend_w\": N + 2})\n\n    # Layout widths\n    left_lw = legends[0][\"legend_w\"]\n    left_total = left_lw + 1  # legend + 1 separator col\n    right_total = (1 + legends[1][\"legend_w\"]) if num_legends == 2 else 0\n    canvas_w = GRID_W - left_total - right_total\n    if canvas_w < MIN_CANVAS_W:\n        return None\n\n    # Color allocation\n    colors = _allocate_colors(num_legends)\n    if colors is None:\n        return None\n    unit_color_sets, (bg1, bg2), frame_colors = colors\n\n    marker_r0 = grid_h - MARKER_PANEL_HEIGHT\n\n    # Design each legend panel\n    for li in range(num_legends):\n        if not _design_legend(legends[li], unit_color_sets[li], frame_colors[li],\n                              marker_r0, grid_h, canvas_w):\n            return None\n\n    # Assign anchor positions\n    if not _assign_anchors(legends, grid_h, canvas_w):\n        return None\n\n    # Build canvas and overlay composites\n    canvas = _build_banded_canvas(grid_h, canvas_w, bg1, bg2)\n    output = _overlay_composites(canvas, legends)\n\n    # Assemble input grid\n    grid = np.zeros((grid_h, GRID_W), dtype=int)\n    canvas_c0 = left_total\n    grid[:, canvas_c0:canvas_c0 + canvas_w] = canvas\n\n    _place_legend(grid, legends[0], col_start=0, sep_col=left_lw,\n                  marker_r0=marker_r0, is_right=False)\n    if num_legends == 2:\n        r_sep = canvas_c0 + canvas_w\n        _place_legend(grid, legends[1], col_start=r_sep + 1, sep_col=r_sep,\n                      marker_r0=marker_r0, is_right=True)\n\n    # Validate via solver\n    try:\n        if np.array_equal(main(grid), output):\n            return grid\n    except Exception:\n        pass\n    return None\n\n\ndef _place_legend(grid, leg, col_start, sep_col, marker_r0, is_right):\n    \"\"\"Draw one legend panel (separator, marker square, rotation patch, sprite, frame).\"\"\"\n    N = leg[\"N\"]\n    grid[:, sep_col] = 6\n\n    # Marker square column: sprite at col_start+1 must fit within the 5-wide panel\n    mc0 = (col_start + max(0, N - 4)) if not is_right else (sep_col + max(0, N - 3))\n\n    # 5x5 border-6 marker square\n    grid[marker_r0:marker_r0 + 5, mc0:mc0 + 5] = 0\n    grid[marker_r0, mc0:mc0 + 5] = 6\n    grid[marker_r0 + 4, mc0:mc0 + 5] = 6\n    grid[marker_r0:marker_r0 + 5, mc0] = 6\n    grid[marker_r0:marker_r0 + 5, mc0 + 4] = 6\n    grid[marker_r0 + 1 + leg[\"pr\"], mc0 + 1 + leg[\"pc\"]] = 4\n\n    # Rotation patch: 3x5 block with 6-borders on cols 0,4 and 3x3 clock-hand inside\n    rr0 = marker_r0 + 5\n    grid[rr0:rr0 + 3, mc0:mc0 + 5] = 0\n    grid[rr0:rr0 + 3, mc0] = 6\n    grid[rr0:rr0 + 3, mc0 + 4] = 6\n    cx_r, cx_c = rr0 + 1, mc0 + 2\n    dr, dc = ROTATION_DIRS[leg[\"rot_k\"]]\n    grid[cx_r, cx_c] = 7\n    grid[cx_r + dr, cx_c + dc] = 7\n\n    # Unit sprite at row 1\n    sp_col = col_start + 1 - mc0\n    grid[1:1 + N, mc0 + sp_col:mc0 + sp_col + N] = leg[\"legend_sprite\"]\n\n    # Frame mask between unit sprite bottom and marker top\n    fH, fW = leg[\"frame_H\"], leg[\"frame_W\"]\n    avail = marker_r0 - (N + 1)\n    gap = random.randint(1, max(1, avail - fH))\n    fr_start = N + 1 + gap\n    f_col = random.randint(0, max(0, 4 - fW))\n    frame_region = grid[fr_start:fr_start + fH, mc0 + f_col:mc0 + f_col + fW]\n    frame_region[leg[\"frame_mask\"]] = leg[\"frame_color\"]\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n===== /home/lixinyu/snap/new/ARC_code/eval/8f215267.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count same-color patterns per frame and represent the tally as dots inside.\n\n    Input structure:\n    - bg = most common color.\n    - Hollow rectangular frames in various colors.\n    - Small monochrome pattern sprites scattered outside frames.\n\n    Rule:\n    - Remove all small patterns from the grid.\n    - For each frame of color C, count how many patterns share color C.\n    - Draw that many dots along the frame's center row, spaced by 2, starting from the right.\n\n    Key insight: Frames act as tally displays — scattered same-color patterns are \"absorbed\" and their count is shown as interior dots.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    out = g.copy()\n    bg = int(get_bg(g))\n\n    regions = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n\n    frames: list[dict] = []\n    patterns: list[dict] = []\n    for comp in regions:\n        b = comp[\"bbox\"]\n        h = bbox_h(b)\n        w = bbox_w(b)\n        area = int(comp[\"area\"])\n        is_frame = (h >= 5) and (w >= 5) and (area < (h * w * 0.7))\n        if is_frame:\n            frames.append(comp)\n        else:\n            patterns.append(comp)\n\n    # Remove patterns from output.\n    for p in patterns:\n        for r, c in p[\"coords\"]:\n            out[int(r), int(c)] = bg\n\n    # For each frame, count matching patterns and draw dots.\n    for f in frames:\n        col = int(f[\"color\"])\n        num_patterns = sum(1 for p in patterns if int(p[\"color\"]) == col)\n        if num_patterns <= 0:\n            continue\n\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        r_mid = (r0 + r1) // 2\n        for i in range(int(num_patterns)):\n            cc = int(c1 - 2 - 2 * i)\n            if cc > int(c0):\n                out[int(r_mid), int(cc)] = col\n\n    return out\n\n# --------------- generator (codex-att2) ---------------\n\n# --- layout geometry ---\nFRAME_H = 5                    # frame height (rows)\nFRAME_W = 11                   # frame width (cols)\nFRAME_R0 = 1                   # top-left row of first frame\nFRAME_C0 = 1                   # top-left col of all frames\nFRAME_GAP = 2                  # bg rows between consecutive frames\nGRID_W = 23                    # fixed grid width\nRIGHT_C0 = 13                  # first column of the right (sprite) region\nRIGHT_W = 9                    # width of the right region\n\n# --- structural counts ---\nN_FRAMES_RANGE = (3, 5)        # [lo, hi) for number of frames\nN_DISTRACTORS_RANGE = (1, 3)   # [lo, hi) for distractor sprite count\nTOTAL_PATTERNS_RANGE = (5, 11) # [lo, hi) for total sprite count\nMAX_DOTS_PER_FRAME = 4         # max dot tally inside one frame\nBOTTOM_PAD_RANGE = (0, 7)      # [lo, hi) extra bg rows when n_frames==3\n\n# --- sprite shape ---\nSPRITE_AREA_RANGE = (2, 9)     # [lo, hi) connected-cell count per sprite\nSPRITE_MAX_H = 4               # max bbox height for sprite\nSPRITE_MAX_W = 3               # max bbox width for sprite\nSPRITE_PADDING = 1             # gap between placed sprites\n\n# --- retry budget ---\nMAX_ATTEMPTS = 300\n\n\ndef _frame_patch(color: int, bg: int, n_dots: int) -> np.ndarray:\n    \"\"\"Build a FRAME_H x FRAME_W hollow rectangle with n_dots on the center row.\"\"\"\n    patch = np.full((FRAME_H, FRAME_W), bg, dtype=int)\n    patch[0, :] = color\n    patch[-1, :] = color\n    patch[:, 0] = color\n    patch[:, -1] = color\n    mid_r = FRAME_H // 2\n    dot_cols = [FRAME_W - 3 - 2 * i for i in range(n_dots)]\n    patch[mid_r, dot_cols] = color\n    return patch\n\n\ndef _sample_counts(rng: np.random.Generator, n_frames: int, total_match: int) -> list[int]:\n    \"\"\"Distribute total_match sprites across n_frames, each capped at MAX_DOTS_PER_FRAME.\"\"\"\n    counts = [0] * n_frames\n    order = rng.permutation(n_frames)\n    remaining = total_match\n    for pos, idx in enumerate(order):\n        frames_left = n_frames - pos - 1\n        lo = max(0, remaining - MAX_DOTS_PER_FRAME * frames_left)\n        hi = min(MAX_DOTS_PER_FRAME, remaining)\n        val = int(rng.integers(lo, hi + 1))\n        counts[int(idx)] = val\n        remaining -= val\n    return counts\n\n\ndef _grow_sprite(rng: np.random.Generator, h: int, w: int, area: int) -> list[tuple[int, int]]:\n    \"\"\"Grow a connected polyomino of the given area inside an h x w bounding box.\"\"\"\n    seed = (int(rng.integers(0, h)), int(rng.integers(0, w)))\n    cells = {seed}\n    while len(cells) < area:\n        frontier = []\n        for r, c in cells:\n            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                nb = (r + dr, c + dc)\n                if 0 <= nb[0] < h and 0 <= nb[1] < w and nb not in cells:\n                    frontier.append(nb)\n        cells.add(frontier[int(rng.integers(0, len(frontier)))])\n    return list(cells)\n\n\ndef _make_sprite(rng: np.random.Generator, color: int, bg: int) -> np.ndarray:\n    \"\"\"Generate a small random connected sprite, tight-cropped to its bounding box.\"\"\"\n    area = int(rng.integers(*SPRITE_AREA_RANGE))\n    dims = [(h, w) for h in range(1, SPRITE_MAX_H + 1)\n            for w in range(1, SPRITE_MAX_W + 1) if h * w >= area]\n    h, w = dims[int(rng.integers(0, len(dims)))]\n    cells = _grow_sprite(rng, h, w, area)\n    rs, cs = zip(*cells)\n    r_min, c_min = min(rs), min(cs)\n    patch = np.full((max(rs) - r_min + 1, max(cs) - c_min + 1), bg, dtype=int)\n    for r, c in cells:\n        patch[r - r_min, c - c_min] = color\n    return patch\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    # --- choose structure ---\n    n_frames = int(rng.integers(*N_FRAMES_RANGE))\n    n_distractors = int(rng.integers(*N_DISTRACTORS_RANGE))\n    total_patterns = int(rng.integers(*TOTAL_PATTERNS_RANGE))\n    total_match = total_patterns - n_distractors\n\n    palette = rng.choice(np.arange(10), size=1 + n_frames + n_distractors, replace=False)\n    bg = int(palette[0])\n    frame_colors = [int(x) for x in palette[1 : 1 + n_frames]]\n    distractor_colors = [int(x) for x in palette[1 + n_frames :]]\n\n    counts = _sample_counts(rng, n_frames, total_match)\n    bottom_pad = int(rng.integers(*BOTTOM_PAD_RANGE)) if n_frames == 3 else 0\n    height = FRAME_R0 + n_frames * FRAME_H + (n_frames - 1) * FRAME_GAP + bottom_pad\n\n    # --- build output (frames with dots) ---\n    out = np.full((height, GRID_W), bg, dtype=int)\n    frame_rows: list[int] = []\n    for i, (color, count) in enumerate(zip(frame_colors, counts)):\n        r0 = FRAME_R0 + i * (FRAME_H + FRAME_GAP)\n        frame_rows.append(r0)\n        paste(out, _frame_patch(color, bg, count), r0, FRAME_C0)\n\n    # --- derive input (dots removed, sprites placed right) ---\n    inp = out.copy()\n    for r0, count in zip(frame_rows, counts):\n        mid_r = r0 + FRAME_H // 2\n        dot_cols = [FRAME_C0 + FRAME_W - 3 - 2 * i for i in range(count)]\n        inp[mid_r, dot_cols] = bg\n\n    right_canvas = np.full((height, RIGHT_W), bg, dtype=int)\n    pattern_colors = [c for c, n in zip(frame_colors, counts) for _ in range(n)]\n    pattern_colors.extend(distractor_colors)\n    rng.shuffle(pattern_colors)\n\n    try:\n        for color in pattern_colors:\n            sprite = _make_sprite(rng, color, bg)\n            r0, c0 = random_free_location(\n                right_canvas, sprite, transparent=bg,\n                padding=SPRITE_PADDING, padding_connectivity=8,\n            )\n            paste(right_canvas, sprite, r0, c0, transparent=bg)\n    except ValueError:\n        return None\n\n    paste(inp, right_canvas, 0, RIGHT_C0, transparent=bg)\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"failed to generate a valid input after {MAX_ATTEMPTS} attempts\")\n===== /home/lixinyu/snap/new/ARC_code/train/8a6d367c.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the framed area by expanding the unique upper template that contains the existing seed pixels.\n\n    Input structure:\n    - A teal background contains small colored template masks above a larger rectangular frame.\n    - The frame encloses one fill color arranged as a partial block-scaled copy of one template.\n    - The frame interior dimensions are an integer square scale of the matching template bbox.\n\n    Rule:\n    - Crop to the rectangular frame.\n    - Identify the unique upper template whose block-scaled mask covers every existing fill pixel inside the frame.\n    - Reset the frame interior to background and paint the whole scaled mask with the fill color.\n\n    Key insight:\n    The lower colored pixels are seed cells that reveal which upper template should be completed inside the frame.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    frame_color, (r0, c0, r1, c1) = _find_frame(g, bg)\n\n    out = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n    interior = out[1:-1, 1:-1]\n    fill_colors = set(map(int, np.unique(interior))) - {bg, frame_color}\n    assert len(fill_colors) == 1, \"frame interior must contain exactly one fill color\"\n    fill_color = fill_colors.pop()\n\n    seed = interior == fill_color\n    assert np.any(seed), \"frame must contain seed pixels\"\n    ih, iw = seed.shape\n\n    matches: list[np.ndarray] = []\n    for template in _templates_above_frame(g, bg, r0):\n        th, tw = template.shape\n        if ih % th != 0 or iw % tw != 0:\n            continue\n        scale_h = ih // th\n        scale_w = iw // tw\n        if scale_h != scale_w:\n            continue\n\n        scaled = np.kron(template, np.ones((scale_h, scale_w), dtype=bool))\n        if np.all(~seed | scaled):\n            matches.append(scaled)\n\n    assert len(matches) == 1, \"seed pixels must select exactly one scaled template\"\n    completed = matches[0]\n    assert completed.shape == interior.shape\n\n    interior[:, :] = bg\n    interior[completed] = fill_color\n    return out\n\n# --------------- generator (att2) ---------------\n\nGEN_BG = 8\nGEN_GRID_SHAPE = (27, 21)\nGEN_TEMPLATE_SHAPES = [(3, 3), (3, 4), (4, 3)]\nGEN_TEMPLATE_COUNT_RANGE = (2, 6)\nGEN_TEMPLATE_ROW = 1\nGEN_TEMPLATE_LEFT_MIN = 1\nGEN_TEMPLATE_GAP = 1\nGEN_MAX_TEMPLATE_SPAN = 19\nGEN_DENSITY_MIN_NUM = 1\nGEN_DENSITY_MIN_DEN = 2\nGEN_DENSITY_MAX_NUM = 5\nGEN_DENSITY_MAX_DEN = 6\nGEN_SCALE_RANGE = (2, 5)\nGEN_SEED_COUNTS = (2, 3)\nGEN_SEED_FRACTION_RANGE = (0.20, 0.60)\nGEN_FRAME_ROW_GAP = 2\nGEN_FRAME_LEFT_MIN = 1\nGEN_ATTEMPTS = 300\nGEN_PALETTE = [0, 1, 2, 3, 4, 5, 6, 7, 9]\n\ndef _gen_has_full_bbox(mask: np.ndarray) -> bool:\n    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())\n\n\ndef _gen_valid_masks(th: int, tw: int) -> list[np.ndarray]:\n    n = int(th * tw)\n    lo = (GEN_DENSITY_MIN_NUM * n + GEN_DENSITY_MIN_DEN - 1) // GEN_DENSITY_MIN_DEN\n    hi = (GEN_DENSITY_MAX_NUM * n) // GEN_DENSITY_MAX_DEN\n    masks: list[np.ndarray] = []\n    for bits in range(1 << n):\n        count = int(bits.bit_count())\n        if count < lo or count > hi:\n            continue\n        flat = np.array([(bits >> k) & 1 for k in range(n)], dtype=bool)\n        mask = flat.reshape(th, tw)\n        if _gen_has_full_bbox(mask):\n            masks.append(mask)\n    return masks\n\n\ndef _gen_colored_patch(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\n    patch = np.full(mask.shape, bg, dtype=int)\n    patch[mask] = int(color)\n    return patch\n\n\ndef _gen_draw_frame(shape: tuple[int, int], bg: int, frame_color: int) -> np.ndarray:\n    patch = np.full(shape, bg, dtype=int)\n    patch[0, :] = frame_color\n    patch[-1, :] = frame_color\n    patch[:, 0] = frame_color\n    patch[:, -1] = frame_color\n    return patch\n\n\ndef _gen_frame_patch(\n    target_mask: np.ndarray,\n    seed_cells: np.ndarray,\n    scale: int,\n    bg: int,\n    frame_color: int,\n    fill_color: int,\n) -> tuple[np.ndarray, np.ndarray]:\n    th, tw = map(int, target_mask.shape)\n    scaled = np.kron(target_mask, np.ones((scale, scale), dtype=bool))\n    out = _gen_draw_frame((th * scale + 2, tw * scale + 2), bg, frame_color)\n    out[1:-1, 1:-1][scaled] = fill_color\n\n    frame = _gen_draw_frame(out.shape, bg, frame_color)\n    for r, c in seed_cells:\n        rr = int(r) * scale\n        cc = int(c) * scale\n        frame[1 + rr : 1 + rr + scale, 1 + cc : 1 + cc + scale] = fill_color\n    return frame, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n    bg = GEN_BG\n    count = int(rng.integers(*GEN_TEMPLATE_COUNT_RANGE))\n    shape_choices = [\n        shape for shape in GEN_TEMPLATE_SHAPES if count * shape[1] + count - 1 <= GEN_MAX_TEMPLATE_SPAN\n    ]\n    th, tw = shape_choices[int(rng.integers(0, len(shape_choices)))]\n    scale = int(rng.integers(*GEN_SCALE_RANGE))\n\n    valid_masks = _gen_valid_masks(th, tw)\n    if len(valid_masks) < count:\n        return None\n\n    target = valid_masks[int(rng.integers(0, len(valid_masks)))]\n    true_cells = np.argwhere(target)\n    target_area = int(len(true_cells))\n    min_seed_frac, max_seed_frac = GEN_SEED_FRACTION_RANGE\n    seed_counts = [k for k in GEN_SEED_COUNTS if min_seed_frac <= k / target_area <= max_seed_frac]\n    if not seed_counts:\n        return None\n    seed_count = int(seed_counts[int(rng.integers(0, len(seed_counts)))])\n    seed_idx = rng.choice(target_area, size=seed_count, replace=False)\n    seed_cells = true_cells[seed_idx]\n\n    covers_seed = np.array([bool(mask[seed_cells[:, 0], seed_cells[:, 1]].all()) for mask in valid_masks])\n    distractor_pool = [mask for mask, covers in zip(valid_masks, covers_seed) if not covers]\n    if len(distractor_pool) < count - 1:\n        return None\n    distractor_idx = rng.choice(len(distractor_pool), size=count - 1, replace=False)\n    distractors = [distractor_pool[int(i)] for i in distractor_idx]\n\n    masks = distractors + [target]\n    rng.shuffle(masks)\n\n    colors = list(GEN_PALETTE)\n    rng.shuffle(colors)\n    frame_color = int(colors[0])\n    fill_color = int(colors[1])\n    template_colors = [int(c) for c in colors[2 : 2 + count]]\n\n    frame, expected = _gen_frame_patch(target, seed_cells, scale, bg, frame_color, fill_color)\n    grid_h, grid_w = GEN_GRID_SHAPE\n    grid = np.full(GEN_GRID_SHAPE, bg, dtype=int)\n\n    total_template_w = count * tw + count - 1\n    template_c0 = int(rng.integers(GEN_TEMPLATE_LEFT_MIN, grid_w - total_template_w))\n    c = template_c0\n    for mask, color in zip(masks, template_colors):\n        paste(grid, _gen_colored_patch(mask, color, bg), GEN_TEMPLATE_ROW, c, transparent=bg)\n        c += tw + GEN_TEMPLATE_GAP\n\n    fh, fw = map(int, frame.shape)\n    min_r0 = th + GEN_FRAME_ROW_GAP\n    max_r0 = grid_h - fh\n    if min_r0 > max_r0:\n        return None\n    frame_r0 = int(rng.integers(min_r0, max_r0 + 1))\n    frame_c0 = int(rng.integers(GEN_FRAME_LEFT_MIN, grid_w - fw))\n    paste(grid, frame, frame_r0, frame_c0)\n\n    try:\n        if not np.array_equal(main(grid), expected):\n            return None\n    except Exception:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 8a6d367c input\")\n","exit_code":0,"status":"completed"}}
