{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools\nimport numpy as np\n\n\ndef normalize(cells):\n    min_r = min(r for r,c in cells)\n    min_c = min(c for r,c in cells)\n    return tuple(sorted((r-min_r,c-min_c) for r,c in cells))\n\ndef connected(cells):\n    cells = set(cells)\n    stack = [next(iter(cells))]\n    seen = {stack[0]}\n    while stack:\n        r,c = stack.pop()\n        for nr,nc in ((r+1,c),(r-1,c),(r,c+1),(r,c-1)):\n            if (nr,nc) in cells and (nr,nc) not in seen:\n                seen.add((nr,nc))\n                stack.append((nr,nc))\n    return len(seen)==len(cells)\n\ndef direction(mask):\n    row_counts = mask.sum(axis=1)\n    col_counts = mask.sum(axis=0)\n    candidates = []\n    for name, profile, perp in [\n        ('up', row_counts, col_counts),\n        ('down', row_counts[::-1], col_counts),\n        ('left', col_counts, row_counts),\n        ('right', col_counts[::-1], row_counts),\n    ]:\n        if len(profile) < 2 or profile[0] >= profile[-1]:\n            continue\n        if np.any(np.diff(profile) < 0):\n            continue\n        tip_idx = 0\n        tip_slice = np.where(mask[0] if name=='up' else mask[-1] if name=='down' else mask[:,0] if name=='left' else mask[:,-1])[0]\n        # approximate tip centeredness\n        if name in ('up','down'):\n            tip_coords = np.argwhere(mask[0] if name=='up' else mask[-1])[:,0]\n            center = (mask.shape[1]-1)/2\n        else:\n            tip_coords = np.argwhere(mask[:,0] if name=='left' else mask[:,-1])[:,0]\n            center = (mask.shape[0]-1)/2\n        centeredness = -float(np.mean(np.abs(tip_coords-center))) if len(tip_coords) else -999\n        score = (int(profile[-1]-profile[0]), -abs(int(perp[0]-perp[-1])), centeredness, len(profile))\n        candidates.append((score,name))\n    if not candidates:\n        return None\n    candidates.sort(reverse=True)\n    if len(candidates) > 1 and candidates[0][0] == candidates[1][0]:\n        return None\n    return candidates[0][1]\n\nshapes=[]\nfor n in (3,4,5):\n    for cells in itertools.combinations([(r,c) for r in range(4) for c in range(4)], n):\n        if not connected(cells):\n            continue\n        norm = normalize(cells)\n        if norm in shapes:\n            continue\n        shapes.append(norm)\n\nup=[]\nfor cells in shapes:\n    h=max(r for r,c in cells)+1; w=max(c for r,c in cells)+1\n    mask=np.zeros((h,w),dtype=int)\n    for r,c in cells: mask[r,c]=1\n    d=direction(mask)\n    if d=='up':\n        up.append(cells)\nprint('total unique connected', len(shapes))\nprint('up count', len(up))\nfor cells in up[:50]:\n    h=max(r for r,c in cells)+1; w=max(c for r,c in cells)+1\n    mask=np.full((h,w),'.',dtype='<U1')\n    for r,c in cells: mask[r,c]='#'\n    print(cells)\n    for row in mask: print(''.join(row))\n    print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
