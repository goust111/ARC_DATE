{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -c \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/train/97c75046.py && sed -n '/def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/train/97c75046.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the single marker to the endpoint reached by sliding along the obstacle contour.\n\n    Input structure:\n    - A dominant background color fills the canvas.\n    - One single-pixel marker sits away from a connected obstacle region of the\n      remaining color.\n    - The marker has exactly one horizontal or vertical sightline to the obstacle.\n\n    Rule:\n    - Find the last background pixel before the obstacle along that sightline.\n    - From that pixel, try the two diagonal turns that continue around the\n      obstacle boundary.\n    - Move the marker to the endpoint of the turn that remains 4-adjacent to the\n      obstacle for the longest distance.\n\n    Key insight:\n    The marker is not placed by distance to the obstacle; it first points to the\n    obstacle, then follows the visible outside contour until that contour segment ends.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    marker = _unique_marker_color(g, bg)\n    obstacle = _obstacle_color(g, bg, marker)\n\n    marker_coords = np.argwhere(g == marker)\n    assert marker_coords.shape == (1, 2), \"expected exactly one marker pixel\"\n    marker_pos = tuple(map(int, marker_coords[0]))\n\n    direction, contour_start = _sightline_to_obstacle(g, marker_pos, obstacle, bg)\n    assert _adjacent_to_color(g, contour_start, obstacle), \"contour must start next to obstacle\"\n    dest = _walk_contour(g, contour_start, direction, obstacle, bg)\n    assert int(g[dest]) == bg, \"destination should be background\"\n\n    out = g.copy()\n    out[marker_pos] = bg\n    out[dest] = marker\n    return out\n\n# --------------- generator (att2) ---------------\n\nBG_COLOR = 7\nGEN_RETRIES = 300\n\n# Obstacle shape bounds.\nOBSTACLE_HEIGHT_RANGE = (4, 8)\nOBSTACLE_WIDTH_RANGE = (3, 8)\nOBSTACLE_AREA_RANGE = (6, 33)\nMAX_BOUNDARY_LEFT = 7\nBOUNDARY_STEP_PROB = 0.55\n\n# Marker sightline and contour-walk bounds.\nWALK_LEN_RANGE = (1, 4)\nSIGHTLINE_GAP_RANGE = (2, 5)\nCANVAS_SIZE_RANGE = (6, 16)\n\n\ndef _gen_boundary(h: int, start_row: int, walk_len: int, start_left: int) -> list[int]:\n    lefts = [0] * h\n    lefts[start_row] = start_left\n\n    for r in range(start_row - 1, -1, -1):\n        if lefts[r + 1] == 0:\n            lefts[r] = 0\n        else:\n            lefts[r] = lefts[r + 1] - random.randint(0, 1)\n\n    for i in range(1, walk_len + 1):\n        lefts[start_row + i] = start_left + i\n\n    stop_row = start_row + walk_len + 1\n    if stop_row < h:\n        lefts[stop_row] = lefts[stop_row - 1]\n        for r in range(stop_row + 1, h):\n            if lefts[r - 1] < MAX_BOUNDARY_LEFT and random.random() < BOUNDARY_STEP_PROB:\n                lefts[r] = lefts[r - 1] + 1\n            else:\n                lefts[r] = lefts[r - 1]\n\n    return lefts\n\n\ndef _gen_transform(g: np.ndarray, rotations: int, mirror: bool) -> np.ndarray:\n    out = np.rot90(g, rotations)\n    if mirror:\n        out = np.fliplr(out)\n    return out.copy()\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = BG_COLOR\n    colors = [c for c in range(10) if c != bg]\n    obstacle = random.choice(colors)\n    marker = random.choice([c for c in colors if c != obstacle])\n\n    h = random.randint(*OBSTACLE_HEIGHT_RANGE)\n    walk_len = random.randint(WALK_LEN_RANGE[0], min(WALK_LEN_RANGE[1], h - 3))\n    start_row = random.randint(1, h - walk_len - 2)\n    gap = random.randint(*SIGHTLINE_GAP_RANGE)\n\n    max_start_left = min(gap, MAX_BOUNDARY_LEFT - walk_len)\n    if max_start_left < 1:\n        return None\n    start_left = random.randint(1, max_start_left)\n\n    lefts = _gen_boundary(h, start_row, walk_len, start_left)\n    min_left = min(lefts)\n    max_left = max(lefts)\n    sum_lefts = sum(lefts)\n\n    w_min = max(\n        OBSTACLE_WIDTH_RANGE[0],\n        max_left + 1,\n        min_left + 3,\n        (OBSTACLE_AREA_RANGE[0] + sum_lefts + h - 1) // h,\n    )\n    w_max = min(OBSTACLE_WIDTH_RANGE[1], (OBSTACLE_AREA_RANGE[1] + sum_lefts) // h)\n    if w_min > w_max:\n        return None\n    w = random.randint(w_min, w_max)\n    area = h * w - sum_lefts\n    if not (OBSTACLE_AREA_RANGE[0] <= area <= OBSTACLE_AREA_RANGE[1]):\n        return None\n\n    c0 = gap - start_left + 1\n    min_cols = max(CANVAS_SIZE_RANGE[0], c0 + w)\n    possible_cols = [\n        cols\n        for cols in range(min_cols, CANVAS_SIZE_RANGE[1] + 1)\n        if max(CANVAS_SIZE_RANGE[0], h, (2 * area + 2 + cols - 1) // cols) <= CANVAS_SIZE_RANGE[1]\n    ]\n    if not possible_cols:\n        return None\n    cols = random.choice(possible_cols)\n    min_rows = max(CANVAS_SIZE_RANGE[0], h, (2 * area + 2 + cols - 1) // cols)\n    rows = random.randint(min_rows, CANVAS_SIZE_RANGE[1])\n    r0 = random.randint(0, rows - h)\n\n    out = np.full((rows, cols), bg, dtype=int)\n    for rr, left in enumerate(lefts):\n        out[r0 + rr, c0 + left : c0 + w] = obstacle\n\n    contour_start = (r0 + start_row, gap)\n    dest = (contour_start[0] + walk_len, contour_start[1] + walk_len)\n    marker_pos = (contour_start[0], 0)\n\n    if out[dest] != bg or out[marker_pos] != bg:\n        return None\n\n    inp = out.copy()\n    inp[marker_pos] = marker\n    out[dest] = marker\n\n    rotations = random.randrange(4)\n    mirror = random.random() < 0.5\n    inp = _gen_transform(inp, rotations, mirror)\n    out = _gen_transform(out, rotations, mirror)\n\n    if not np.array_equal(main(inp), out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input for 97c75046\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -c \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/eval/36a08778.py && sed -n '/def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/eval/36a08778.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Simulate water falling from top-edge sources, pooling on shelves, and cascading off edges.\n\n    Input structure:\n    - bg = most common color; water = rarest non-bg; shelf = other non-bg.\n    - Sources: water clusters touching top row. Shelves: horizontal segments.\n\n    Rule:\n    - Water falls down from sources, painting bg cells as water.\n    - On hitting a shelf, it spreads across the shelf span plus one cell past each end.\n    - From those overflow positions, water resumes falling independently.\n\n    Key insight: Each shelf splits a stream into two at its edges, creating a branching waterfall tree.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    cnt = Counter(map(int, g.flatten()))\n    bg = int(cnt.most_common(1)[0][0])\n    non = [int(c) for c in cnt.keys() if int(c) != int(bg)]\n    assert not (not non)\n    water = int(min(non, key=lambda c: (int(cnt[int(c)]), int(c))))\n    other = [int(c) for c in non if int(c) != int(water)]\n    assert not (not other)\n    shelf = int(other[0])\n\n    out = g.copy()\n\n    # sources: 8-connected components of water that touch the top edge; start from their bottommost row\n    sources: list[tuple[int, int]] = []\n    for coords in components_mask(g == int(water), connectivity=8):\n        if coords.size == 0:\n            continue\n        if not bool((coords[:, 0] == 0).any()):\n            continue\n        rmax = int(coords[:, 0].max())\n        cols = sorted({int(c) for r, c in coords if int(r) == int(rmax)})\n        for c in cols:\n            sources.append((int(rmax), int(c)))\n\n    # shelf segments (from original grid g)\n    shelf_segs: list[list[tuple[int, int]]] = [[] for _ in range(H)]\n    for r in range(H):\n        c = 0\n        while c < W:\n            if int(g[int(r), int(c)]) != int(shelf):\n                c += 1\n                continue\n            c0 = int(c)\n            while c + 1 < W and int(g[int(r), int(c + 1)]) == int(shelf):\n                c += 1\n            shelf_segs[int(r)].append((int(c0), int(c)))\n            c += 1\n\n    def find_shelf_seg(r: int, c: int) -> tuple[int, int] | None:\n        for a, b in shelf_segs[int(r)]:\n            if int(a) <= int(c) <= int(b):\n                return (int(a), int(b))\n        return None\n\n    def spread_limits(row: int, start_col: int, min_col: int, max_col: int) -> tuple[int, int]:\n        \"\"\"\n        Expand horizontally only through contiguous bg cells on the current row.\n\n        This prevents water from \"jumping\" over blockers that sit on the spread row.\n        \"\"\"\n        left = int(start_col)\n        while left - 1 >= int(min_col) and int(g[int(row), int(left - 1)]) == int(bg):\n            left -= 1\n\n        right = int(start_col)\n        while right + 1 <= int(max_col) and int(g[int(row), int(right + 1)]) == int(bg):\n            right += 1\n\n        return (int(left), int(right))\n\n    seen: set[tuple[int, int]] = set()\n    q = deque((int(r), int(c)) for r, c in sources)\n\n    while q:\n        r, c = q.popleft()\n        if (int(r), int(c)) in seen:\n            continue\n        seen.add((int(r), int(c)))\n\n        rr, cc = int(r), int(c)\n        out[rr, cc] = int(water)\n\n        while True:\n            nr = int(rr + 1)\n            if nr >= H:\n                break\n            below = int(g[int(nr), int(cc)])\n\n            if below == int(shelf):\n                seg = find_shelf_seg(nr, cc)\n                if seg is None:\n                    break\n                a, b = seg\n                left_bound = int(max(0, int(a - 1)))\n                right_bound = int(min(int(W - 1), int(b + 1)))\n                left, right = spread_limits(rr, cc, left_bound, right_bound)\n                for x in range(left, right + 1):\n                    if int(g[int(rr), int(x)]) == int(bg):\n                        out[int(rr), int(x)] = int(water)\n                for nc in {left, right}:\n                    if int(nc) != int(cc):\n                        q.append((int(rr), int(nc)))\n                break\n\n            rr = nr\n            out[int(rr), int(cc)] = int(water)\n\n    return out\n\n# --------------- generator (cascade tree top-down construction) ---------------\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input for the waterfall cascade task.\"\"\"\n    BG, WATER, SHELF = 7, 6, 2\n\n    H = random.randint(8, 30)\n    W = random.randint(5, 30)\n\n    num_sources = random.choice([1, 2]) if W >= 14 else 1\n    if num_sources == 2:\n        src1 = random.randint(0, W - 8)\n        src2 = random.randint(src1 + 7, W - 1)\n        source_cols = [src1, src2]\n    else:\n        source_cols = [random.randint(0, W - 1)]\n\n    # Track cells reserved for shelf\n    shelf_cells: set[tuple[int, int]] = set()\n    # Cells that must remain bg (overflow positions, fall paths, source positions)\n    reserved_bg: set[tuple[int, int]] = set()\n\n    # Reserve source positions\n    for sc in source_cols:\n        reserved_bg.add((0, sc))\n        reserved_bg.add((1, sc))\n\n    all_shelves: list[tuple[int, int, int]] = []  # (row, a, b)\n\n    def try_add_shelf(r: int, a: int, b: int, is_cascade: bool = False) -> bool:\n        \"\"\"Try to add a shelf segment. Check no conflict with existing shelves or reserved bg cells.\"\"\"\n        cells = [(r, c) for c in range(a, b + 1)]\n        for cell in cells:\n            if cell in shelf_cells or cell in reserved_bg:\n                return False\n        for cell in cells:\n            shelf_cells.add(cell)\n        all_shelves.append((r, a, b))\n        return True\n\n    def reserve_overflow_and_fall(spread_row: int, left: int, right: int, incoming_col: int):\n        \"\"\"Reserve overflow positions and their fall paths as must-be-bg.\"\"\"\n        for nc in {left, right}:\n            if nc != incoming_col:\n                # The overflow position itself must be bg\n                reserved_bg.add((spread_row, nc))\n                # Fall path below must be bg until next shelf or grid bottom\n                # We'll just reserve the overflow position for now;\n                # fall path conflicts are handled by checking during shelf placement\n\n    max_depth = random.randint(2, 5)\n    if H < max_depth * 2 + 3:\n        max_depth = max(2, (H - 3) // 2)\n\n    # Build cascade tree top-down\n    # Each stream: (current_row, col, depth)\n    streams: list[tuple[int, int, int]] = [(1, sc, 0) for sc in source_cols]\n    cascade_shelves: list[tuple[int, int, int]] = []\n    processed = set()\n\n    while streams:\n        next_streams = []\n        random.shuffle(streams)\n        for (row, col, depth) in streams:\n            if (row, col) in processed:\n                continue\n            processed.add((row, col))\n\n            if depth >= max_depth or row + 2 >= H:\n                continue\n\n            min_shelf_row = row + 2\n            max_shelf_row = min(H - 1, row + 8)\n            if min_shelf_row > max_shelf_row:\n                continue\n\n            # Try a few times to place a shelf\n            placed = False\n            for _try in range(10):\n                shelf_row = random.randint(min_shelf_row, max_shelf_row)\n                spread_row = shelf_row - 1\n                if spread_row <= row:\n                    continue\n\n                # Check fall path from (row+1, col) to (shelf_row-1, col) is clear\n                blocked = False\n                for r_check in range(row + 1, shelf_row):\n                    if (r_check, col) in shelf_cells:\n                        blocked = True\n                        break\n                if blocked:\n                    continue\n\n                # Generate shelf segment containing col\n                shelf_len = random.randint(2, min(8, W))\n                max_start = col\n                min_start = max(0, col - shelf_len + 1)\n                if min_start > max_start:\n                    continue\n                a = random.randint(min_start, max_start)\n                b = min(a + shelf_len - 1, W - 1)\n\n                # Check shelf cells don't conflict\n                conflict = False\n                for c in range(a, b + 1):\n                    if (shelf_row, c) in shelf_cells or (shelf_row, c) in reserved_bg:\n                        conflict = True\n                        break\n                if conflict:\n                    continue\n\n                # Compute overflow positions\n                left = max(0, a - 1)\n                right = min(W - 1, b + 1)\n\n                # Check overflow positions on spread row are not shelf\n                overflow_ok = True\n                for nc in {left, right}:\n                    if nc != col:\n                        if (spread_row, nc) in shelf_cells:\n                            overflow_ok = False\n                            break\n                if not overflow_ok:\n                    continue\n\n                # Add the shelf\n                if not try_add_shelf(shelf_row, a, b, is_cascade=True):\n                    continue\n\n                cascade_shelves.append((shelf_row, a, b))\n\n                # Reserve overflow positions and fall path cells as bg\n                reserve_overflow_and_fall(spread_row, left, right, col)\n\n                # Reserve the fall path from current position to shelf\n                for r_res in range(row + 1, shelf_row):\n                    reserved_bg.add((r_res, col))\n\n                # Add new streams from overflow\n                for nc in {left, right}:\n                    if nc != col:\n                        next_streams.append((spread_row, nc, depth + 1))\n\n                placed = True\n                break\n\n            # If no shelf placed, stream just falls to bottom (that's ok)\n\n        streams = next_streams\n\n    if len(cascade_shelves) < 3:\n        return None\n\n    # Build the grid\n    grid = np.full((H, W), BG, dtype=int)\n\n    # Place sources\n    for sc in source_cols:\n        grid[0, sc] = WATER\n        grid[1, sc] = WATER\n\n    # Place all shelves\n    for (r, a, b) in all_shelves:\n        for c in range(a, b + 1):\n            grid[r, c] = SHELF\n\n    # Add 0-5 distractor shelves (carefully avoiding reserved_bg and shelf_cells)\n    num_distractors = random.randint(0, 5)\n    for _ in range(num_distractors):\n        for _attempt in range(20):\n            dr = random.randint(1, H - 1)\n            dl = random.randint(1, min(8, W))\n            da = random.randint(0, W - dl)\n            db = da + dl - 1\n            # Check no conflict with shelf_cells or reserved_bg\n            conflict = False\n            for c in range(da, db + 1):\n                if (dr, c) in shelf_cells or (dr, c) in reserved_bg:\n                    conflict = True\n                    break\n            if not conflict:\n                # Also check distractor doesn't intersect any active water fall path\n                # by ensuring it's not on a column where water falls through\n                if try_add_shelf(dr, da, db):\n                    for c in range(da, db + 1):\n                        grid[dr, c] = SHELF\n                    break\n\n    # Verify with solver\n    try:\n        out = main(grid.copy())\n    except Exception:\n        return None\n\n    if np.array_equal(out, grid):\n        return None\n\n    # Verify shelf cells are preserved in output\n    for (r, a, b) in all_shelves:\n        for c in range(a, b + 1):\n            if out[r, c] != SHELF:\n                return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py && sed -n '/def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n\n\ndef _bfs_placement(feasible, sr, sc):\n    h2, w2 = feasible.shape\n    dist = -np.ones((h2, w2), dtype=int)\n    dist[sr, sc] = 0\n    q = deque([(sr, sc)])\n    while q:\n        r, c = q.popleft()\n        for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:\n                dist[rr, cc] = dist[r, c] + 1\n                q.append((rr, cc))\n    return dist\n\n\ndef _hamiltonian_walk(rows, cols, start, end):\n    total = rows * cols\n    best_path = None\n    best_len = 0\n    for _attempt in range(80):\n        visited = {start}\n        path = [start]\n        cur = start\n        while True:\n            if cur == end and len(path) >= total * 0.7:\n                if len(path) > best_len:\n                    best_path = list(path)\n                    best_len = len(path)\n                break\n            neighbors = []\n            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                nr, nc = cur[0] + dr, cur[1] + dc\n                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:\n                    neighbors.append((nr, nc))\n            if not neighbors:\n                break\n            valid = []\n            for nb in neighbors:\n                if nb == end:\n                    valid.append(nb)\n                    continue\n                test_visited = visited | {nb}\n                seen = {end}\n                q = deque([end])\n                while q:\n                    cr, cc = q.popleft()\n                    for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                        nr2, nc2 = cr + dr2, cc + dc2\n                        if (0 <= nr2 < rows and 0 <= nc2 < cols and\n                                (nr2, nc2) not in test_visited and (nr2, nc2) not in seen):\n                            seen.add((nr2, nc2))\n                            q.append((nr2, nc2))\n                for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                    ar, ac = nb[0] + dr2, nb[1] + dc2\n                    if (0 <= ar < rows and 0 <= ac < cols and\n                            (ar, ac) not in test_visited and (ar, ac) in seen):\n                        valid.append(nb)\n                        break\n            if not valid:\n                break\n            random.shuffle(valid)\n            nxt = valid[0]\n            visited.add(nxt)\n            path.append(nxt)\n            cur = nxt\n        if best_path and best_len >= total * 0.85:\n            break\n    return best_path\n\n\ndef _render_channel(grid, path, n, offsets_r, offsets_c):\n    pixel_pos = []\n    for cr, cc in path:\n        pr, pc = offsets_r[cr], offsets_c[cc]\n        pixel_pos.append((pr, pc))\n        grid[pr:pr + n, pc:pc + n] = _RIVER\n    for i in range(len(path) - 1):\n        pr1, pc1 = pixel_pos[i]\n        pr2, pc2 = pixel_pos[i + 1]\n        if pr1 == pr2:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n            grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER\n        else:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n            grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER\n    return pixel_pos\n\n\ndef _add_chokepoint(grid, pixel_pos_i, pixel_pos_j, n, direction):\n    H, W = grid.shape\n    pr1, pc1 = pixel_pos_i\n    pr2, pc2 = pixel_pos_j\n    narrow_w = random.randint(1, n - 1)\n    remove = n - narrow_w\n    side = random.randint(0, 1)\n\n    if direction == 'h':\n        c_lo = min(pc1, pc2) + n\n        c_hi = max(pc1, pc2)\n        if c_hi <= c_lo:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        c_mid = (c_lo + c_hi) // 2\n        c_start = max(c_lo, c_mid - total_len // 2)\n        for step in range(total_len):\n            c = c_start + step\n            if c < 0 or c >= W:\n                continue\n            if step < remove:\n                depth = step + 1\n            elif step >= total_len - remove:\n                depth = total_len - step\n            else:\n                depth = remove\n            for k in range(depth):\n                rr = pr1 + k if side == 0 else pr1 + n - 1 - k\n                if 0 <= rr < H and 0 <= c < W:\n                    grid[rr, c] = _BG\n    else:\n        r_lo = min(pr1, pr2) + n\n        r_hi = max(pr1, pr2)\n        if r_hi <= r_lo:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        r_mid = (r_lo + r_hi) // 2\n        r_start = max(r_lo, r_mid - total_len // 2)\n        for step in range(total_len):\n            r = r_start + step\n            if r < 0 or r >= H:\n                continue\n            if step < remove:\n                depth = step + 1\n            elif step >= total_len - remove:\n                depth = total_len - step\n            else:\n                depth = remove\n            for k in range(depth):\n                cc = pc1 + k if side == 0 else pc1 + n - 1 - k\n                if 0 <= r < H and 0 <= cc < W:\n                    grid[r, cc] = _BG\n\n\ndef _river_connected(grid):\n    mask = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)\n    if not mask.any():\n        return False\n    labeled, num = scipy_label(mask.astype(int))\n    return num == 1\n\n\ndef _compute_offsets(G, n, num_coarse):\n    if num_coarse == 1:\n        return [1]\n    first = 1\n    last = G - n - 1\n    if last < first:\n        return None\n    step = (last - first) / (num_coarse - 1)\n    return [int(round(first + i * step)) for i in range(num_coarse)]\n\n\ndef _gen_attempt():\n    reached = random.random() < 0.5\n    n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])\n\n    min_size = max(10, 5 * n)\n    if min_size > 20:\n        return None\n    G = random.randint(min_size, 20)\n    H = W = G\n\n    min_spacing = n + 1\n    max_coarse = max(3, (G - 2) // min_spacing)\n    coarse_dim = random.randint(3, min(6, max_coarse))\n    coarse_rows = coarse_cols = coarse_dim\n\n    offsets_r = _compute_offsets(G, n, coarse_rows)\n    offsets_c = _compute_offsets(G, n, coarse_cols)\n    if offsets_r is None or offsets_c is None:\n        return None\n    for i in range(len(offsets_r) - 1):\n        if offsets_r[i + 1] - offsets_r[i] < n:\n            return None\n    for i in range(len(offsets_c) - 1):\n        if offsets_c[i + 1] - offsets_c[i] < n:\n            return None\n\n    edge_cells = set()\n    for c in range(coarse_cols):\n        edge_cells.add((0, c))\n        edge_cells.add((coarse_rows - 1, c))\n    for r in range(1, coarse_rows - 1):\n        edge_cells.add((r, 0))\n        edge_cells.add((r, coarse_cols - 1))\n    edge_cells = list(edge_cells)\n    random.shuffle(edge_cells)\n    start_coarse = edge_cells[0]\n    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))\n    end_coarse = far[0] if far[0] != start_coarse else far[1]\n\n    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)\n    if walk is None or len(walk) < 4:\n        return None\n    if len(set(cr for cr, _ in walk)) < coarse_rows or len(set(cc for _, cc in walk)) < coarse_cols:\n        return None\n\n    grid = np.full((H, W), _BG, dtype=int)\n    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)\n\n    mask = (grid != _BG)\n    if np.any(mask, axis=1).sum() / H < 0.70 or np.any(mask, axis=0).sum() / W < 0.70:\n        return None\n\n    mover_r, mover_c = pixel_pos[0]\n    dest_r, dest_c = pixel_pos[-1]\n\n    # Extend dest to touch grid edge\n    def _extend_to_edge(pr, pc):\n        candidates = []\n        for direction in ['top', 'bottom', 'left', 'right']:\n            if direction == 'top':\n                dist = pr\n                if dist == 0:\n                    candidates.append((0, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n) if c < W):\n                    candidates.append((0, pc, dist))\n            elif direction == 'bottom':\n                dist = H - (pr + n)\n                if dist == 0:\n                    candidates.append((pr, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n) if c < W):\n                    candidates.append((H - n, pc, dist))\n            elif direction == 'left':\n                dist = pc\n                if dist == 0:\n                    candidates.append((pr, 0, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc) if r < H):\n                    candidates.append((pr, 0, dist))\n            elif direction == 'right':\n                dist = W - (pc + n)\n                if dist == 0:\n                    candidates.append((pr, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W) if r < H):\n                    candidates.append((pr, W - n, dist))\n        if not candidates:\n            return None\n        candidates.sort(key=lambda x: x[2])\n        return candidates[0][:2]\n\n    result = _extend_to_edge(dest_r, dest_c)\n    if result is None:\n        return None\n    new_dest_r, new_dest_c = result\n    if new_dest_r != dest_r:\n        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n\n        grid[r_lo:r_hi, dest_c:dest_c + n] = _RIVER\n    if new_dest_c != dest_c:\n        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n\n        grid[dest_r:dest_r + n, c_lo:c_hi] = _RIVER\n    dest_r, dest_c = new_dest_r, new_dest_c\n    if not (dest_r == 0 or dest_r + n == H or dest_c == 0 or dest_c + n == W):\n        return None\n\n    # Mover: near edge but not touching\n    touching = (mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W)\n    if touching:\n        if mover_r == 0:\n            grid[0, mover_c:mover_c + n] = _RIVER; mover_r = 1\n        elif mover_r + n == H:\n            grid[H - 1, mover_c:mover_c + n] = _RIVER; mover_r = H - n - 1\n        elif mover_c == 0:\n            grid[mover_r:mover_r + n, 0] = _RIVER; mover_c = 1\n        elif mover_c + n == W:\n            grid[mover_r:mover_r + n, W - 1] = _RIVER; mover_c = W - n - 1\n    if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:\n        return None\n    if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:\n        return None\n\n    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\n    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _RIVER\n\n    # Chokepoints for stuck case\n    if not reached and n >= 2:\n        num_choke = random.randint(1, min(3, len(walk) - 2))\n        min_seg = max(1, len(walk) // 4)\n        available = list(range(min_seg, len(walk) - 1))\n        random.shuffle(available)\n        for seg_idx in available[:num_choke]:\n            pr1, pc1 = pixel_pos[seg_idx]\n            pr2, pc2 = pixel_pos[min(seg_idx + 1, len(pixel_pos) - 1)]\n            direction = 'h' if pr1 == pr2 else 'v'\n            _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)\n        if not _river_connected(grid):\n            return None\n\n    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _MOVER\n    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _DEST\n\n    trav = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)\n    h2, w2 = H - n + 1, W - n + 1\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if trav[r:r + n, c:c + n].all():\n                feasible[r, c] = True\n    if not feasible[mover_r, mover_c]:\n        return None\n\n    dist = _bfs_placement(feasible, mover_r, mover_c)\n    dest_ok = (0 <= dest_r < h2 and 0 <= dest_c < w2 and\n               feasible[dest_r, dest_c] and dist[dest_r, dest_c] >= 0)\n    if reached and not dest_ok:\n        return None\n    if not reached and dest_ok:\n        return None\n\n    if dest_ok:\n        tr, tc = dest_r, dest_c\n    else:\n        best_d = -1\n        tr, tc = mover_r, mover_c\n        for r in range(h2):\n            for c in range(w2):\n                if dist[r, c] > best_d:\n                    best_d = dist[r, c]\n                    tr, tc = r, c\n\n    output = grid.copy()\n    output[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\n    output[tr:tr + n, tc:tc + n] = _MOVER\n\n    if not np.array_equal(main(grid), output):\n        return None\n    return grid\n\n\ndef generate_input():\ndef generate_input():\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py && sed -n '/def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py && sed -n '/def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swing an irregular line segment around a nearby obstacle sprite, preserving its pixel count.\n\n    Input structure:\n    - bg, bar color (straight lines perpendicular to the grid edge, one end on the border), segment color (irregular stroke attached to bar's inner endpoint), obstacle color (sprite near the bar terminal).\n\n    Rule:\n    - Each bar is perpendicular to the edge it touches; its inner (terminal) endpoint has an attached irregular segment.\n    - The segment detaches and re-routes: it travels from the terminal toward the nearest obstacle, hugs the obstacle's boundary, then exits at a 45° diagonal.\n    - Total painted pixels equal the original segment length.\n\n    Key insight: The segment behaves like a rope swung around the obstacle — attach at the nearest point, trace the skin, exit diagonally, conserving length.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    colors = sorted(set(int(v) for v in np.unique(g)) - {bg})\n\n    out = g.copy()\n\n    def bar_candidates():\n        # Yield (bar_color, bar_component, terminal_endpoint).\n        for col in colors:\n            for comp in _components(g, col, conn8=False):\n                if len(comp) < 2 or not _is_straight_line(comp):\n                    continue\n                e0, e1 = _bar_endpoints(comp)\n                touch0 = _touches_border(e0, h, w)\n                touch1 = _touches_border(e1, h, w)\n                if touch0 == touch1:\n                    continue  # require exactly one endpoint on border\n                # Orientation must be perpendicular to the edge it touches.\n                rs = [r for r, _ in comp]\n                cs = [c for _, c in comp]\n                vertical = len(set(cs)) == 1\n                border_ep = e0 if touch0 else e1\n                if vertical:\n                    if border_ep[0] not in (0, h - 1):\n                        continue\n                else:\n                    if border_ep[1] not in (0, w - 1):\n                        continue\n                terminal_ep = e1 if touch0 else e0\n                # Must have an attached non-bg neighbor at terminal.\n                tr, tc = terminal_ep\n                if not any(\n                    0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) != bg and int(g[nr, nc]) != col\n                    for nr, nc in neighbors4(tr, tc)\n                ):\n                    continue\n                yield col, comp, terminal_ep\n\n    # Process all valid bars; compute moves based on the original grid.\n    moves = []  # list of (seg_comp_pts, seg_color, new_pts)\n    for bar_col, bar_comp, terminal in sorted(list(bar_candidates()), key=lambda x: (-len(x[1]), x[0], x[2])):\n        # Segment neighbor candidates at terminal.\n        neigh = []\n        for nr, nc in neighbors4(terminal[0], terminal[1]):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg and v != bar_col:\n                    neigh.append((v, (nr, nc)))\n        assert neigh, f\"bar terminal {terminal} must have a non-bg/non-bar neighbor\"\n\n        # Choose a segment that behaves like a 1-cell-thick stroke attached at an endpoint.\n        best_seg = None  # (L, comp_size, seg_col, seg_start, seg_comp)\n        for cand_col, cand_start in neigh:\n            for comp in _components(g, cand_col, conn8=True):\n                if cand_start in comp:\n                    if len(comp) < 2:\n                        break\n                    deg = _segment_degrees(comp)\n                    if deg.get(cand_start, 0) != 1:\n                        break\n                    path = _segment_main_path(comp, cand_start)\n                    L = len(path)\n                    key = (L, len(comp), cand_col, cand_start[0], cand_start[1])\n                    if best_seg is None or key > best_seg[0]:\n                        best_seg = (key, cand_col, cand_start, comp)\n                    break\n        assert best_seg is not None, f\"no valid segment for bar at {terminal}\"\n        (L, _, _, _, _), seg_col, seg_start, seg_comp = best_seg\n\n        # Nearest obstacle component (any other non-bg color) to the terminal.\n        obstacle_candidates = [c for c in colors if c not in (bar_col, seg_col)]\n        assert obstacle_candidates, \"must have at least one obstacle color distinct from bar and segment\"\n\n        best = None  # (dist, min_r, min_c)\n        obstacle_set = None\n        for col in obstacle_candidates:\n            for comp in _components(g, col, conn8=True):\n                d = min(abs(r - terminal[0]) + abs(c - terminal[1]) for r, c in comp)\n                mr = min(r for r, _ in comp)\n                mc = min(c for _, c in comp)\n                key = (d, mr, mc)\n                if best is None or key < best:\n                    best = key\n                    obstacle_set = set(comp)\n        assert obstacle_set is not None, \"must find at least one obstacle component\"\n\n        off_r = seg_start[0] - terminal[0]\n        off_c = seg_start[1] - terminal[1]\n\n        # Path from terminal to obstacle (prefer monotone manhattan decrease).\n        walkable = (g == bg) | (g == seg_col)\n        walkable[terminal] = True\n        # Choose an obstacle pixel so that the translated endpoint (p_near + offset) lies OUTSIDE the obstacle,\n        # i.e. the segment connects to the obstacle \"skin\" rather than landing inside the obstacle and wasting length.\n        def pick_p_near() -> tuple[int, int]:\n            good = []\n            for pr, pc in obstacle_set:\n                er, ec = pr + off_r, pc + off_c\n                if not (0 <= er < h and 0 <= ec < w):\n                    continue\n                if (er, ec) in obstacle_set:\n                    continue\n                if int(g[er, ec]) not in (bg, seg_col):\n                    continue\n                d = abs(pr - terminal[0]) + abs(pc - terminal[1])\n                good.append((d, pr, pc))\n            assert good, \"no obstacle pixel has a valid translated endpoint outside obstacle\"\n            _, pr, pc = min(good)\n            return (pr, pc)\n\n        p_near = pick_p_near()\n        walkable[p_near] = True\n        path_t_to_obs = _greedy_manhattan_path(terminal, p_near, walkable) or _bfs_path(terminal, p_near, walkable)\n        assert path_t_to_obs is not None, f\"no path from terminal {terminal} to obstacle {p_near}\"\n        shifted = [(r + off_r, c + off_c) for r, c in path_t_to_obs]\n        assert all(0 <= r < h and 0 <= c < w for r, c in shifted), \\\n            \"shifted segment path must stay within grid\"\n        assert shifted and shifted[0] == seg_start, \\\n            \"shifted path must start at seg_start\"\n        entry = shifted[-1]\n\n        # Obstacle-adjacent skin.\n        skin = set()\n        for r, c in obstacle_set:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in obstacle_set:\n                    skin.add((nr, nc))\n\n        # Pick exit as the farthest walkable skin cell from the terminal (ties resolved by projecting away).\n        # Use obstacle centroid direction as an 'away' vector.\n        cr = sum(r for r, _ in obstacle_set) / len(obstacle_set)\n        cc = sum(c for _, c in obstacle_set) / len(obstacle_set)\n        away = (cr - terminal[0], cc - terminal[1])\n\n        def skin_ok(p):\n            r, c = p\n            return int(g[r, c]) == bg or int(g[r, c]) == seg_col\n\n        skin_candidates = [p for p in skin if skin_ok(p)] + [entry]\n        def exit_key(p):\n            r, c = p\n            md = abs(r - terminal[0]) + abs(c - terminal[1])\n            dot = (r - terminal[0]) * away[0] + (c - terminal[1]) * away[1]\n            return (md, dot, -r, -c)\n\n        exit_cell = max(skin_candidates, key=exit_key)\n\n        # BFS along skin (8-neigh) from entry to exit.\n        skin_walkable = np.zeros((h, w), dtype=bool)\n        for r, c in skin:\n            if skin_ok((r, c)):\n                skin_walkable[r, c] = True\n        skin_walkable[entry] = True\n        skin_walkable[exit_cell] = True\n        boundary_path = _bfs_path_with_diag_filter(entry, exit_cell, skin_walkable) or [entry]\n\n        # Extension direction is the last step used to reach the exit on the skin path.\n        assert len(boundary_path) >= 2, \"boundary path must have at least 2 cells to derive extension direction\"\n        dr_ext = boundary_path[-1][0] - boundary_path[-2][0]\n        dc_ext = boundary_path[-1][1] - boundary_path[-2][1]\n\n        route = list(shifted)\n        if boundary_path and boundary_path[0] == entry:\n            route.extend(boundary_path[1:])\n\n        cur = route[-1]\n        while len(route) < L:\n            nr, nc = cur[0] + dr_ext, cur[1] + dc_ext\n            if not (0 <= nr < h and 0 <= nc < w):\n                break\n            if int(g[nr, nc]) != bg and int(g[nr, nc]) != seg_col:\n                break\n            route.append((nr, nc))\n            cur = (nr, nc)\n\n        new_pts = route[:L]\n\n        # Assert: output segment must not overlap obstacle\n        assert not any(p in obstacle_set for p in new_pts), \"output segment passes through obstacle\"\n\n        # Assert: output segment has monotone wrapping shape (FL*F*FR* or FR*F*FL*)\n        rs_bar = [r for r, _ in bar_comp]\n        cs_bar = [c for _, c in bar_comp]\n        if len(set(cs_bar)) == 1:\n            fwd = (1, 0) if min(rs_bar) == 0 else (-1, 0)\n        else:\n            fwd = (0, 1) if min(cs_bar) == 0 else (0, -1)\n        step_classes = []\n        for j in range(len(new_pts) - 1):\n            dr = new_pts[j + 1][0] - new_pts[j][0]\n            dc = new_pts[j + 1][1] - new_pts[j][1]\n            fwd_comp = dr * fwd[0] + dc * fwd[1]\n            perp_comp = dr * fwd[1] + dc * (-fwd[0])\n            if abs(dr) + abs(dc) == 1:\n                step_classes.append('F' if fwd_comp > 0 else 'X')\n            elif fwd_comp > 0 and perp_comp > 0:\n                step_classes.append('FR')\n            elif fwd_comp > 0 and perp_comp < 0:\n                step_classes.append('FL')\n            else:\n                step_classes.append('X')\n        s = ''.join(step_classes)\n        import re\n        assert re.fullmatch(r'(FL)*(F)*(FR)*', s) or re.fullmatch(r'(FR)*(F)*(FL)*', s), \\\n            f\"output segment not monotone wrap: {' '.join(step_classes)}\"\n\n        # Assert: when approach diagonal exists (p1>=1), obstacle must be 4-adj to V apex inner side\n        first_step = step_classes[0] if step_classes else ''\n        if first_step in ('FL', 'FR'):\n            p1_end = 0\n            for j2, sc in enumerate(step_classes):\n                if sc == first_step:\n                    p1_end = j2 + 1\n                else:\n                    break\n            apex = new_pts[p1_end]\n            perp_dir = (seg_start[0] - terminal[0], seg_start[1] - terminal[1])\n            inner = (-perp_dir[0], -perp_dir[1])\n            apex_inner = (apex[0] + inner[0], apex[1] + inner[1])\n            assert apex_inner in obstacle_set, \\\n                f\"obstacle not tight at V apex: apex={apex}, inner={apex_inner}\"\n\n        moves.append((seg_comp, seg_col, new_pts))\n\n    # Clear segments first, then repaint.\n    for seg_comp, seg_col, _ in moves:\n        for r, c in seg_comp:\n            out[r, c] = bg\n\n    for _, seg_col, new_pts in moves:\n        for r, c in new_pts:\n            if int(out[r, c]) == bg:\n                out[r, c] = seg_col\n    return out\n\n# --------------- generator (attempt_2) ---------------\n\nfrom arc_utils import paint_coords\n\n# ── CFG: tunable generation parameters ──────────────────────────────────────\nGRID_SIZE_MIN, GRID_SIZE_MAX = 7, 27       # square grid side length\nBAR_LEN_MIN, BAR_LEN_MAX = 3, 7           # bar length (px)\nBAR_CLEARANCE = 4                           # n must exceed bar_len by this much\nSEG_LEN_MIN, SEG_LEN_MAX = 5, 9           # segment pixel count\nPHASE_MAX = 3                               # max length for p1 and p2 individually\nOBS_SIZE_MIN, OBS_SIZE_MAX = 1, 9          # obstacle sprite pixel count\nOBS_MD_MIN, OBS_MD_MAX = 2, 6             # obstacle manhattan distance from terminal\nINPUT_TURN_MIN, INPUT_TURN_MAX = 2, 5     # turns in the input irregular stroke\nDIAG_CONTINUE_PROB = 0.35                  # probability of continuing a diagonal run\nDIAG_START_PROB = 0.5                       # probability of starting/switching to diagonal\nMAX_RETRIES = 300                           # generate_input retry budget\nPLACEMENT_PAD = 1                           # padding around placed triples\n\nEDGE_DATA = {\n    \"top\": {\"fwd\": (1, 0), \"side\": (0, 1)},\n    \"bottom\": {\"fwd\": (-1, 0), \"side\": (0, -1)},\n    \"left\": {\"fwd\": (0, 1), \"side\": (-1, 0)},\n    \"right\": {\"fwd\": (0, -1), \"side\": (1, 0)},\n}\n\n\ndef _terminal_for(edge: str, n: int, bar_len: int, pos: int) -> tuple[int, int]:\n    \"\"\"Return the interior endpoint of a bar placed along *edge*.\"\"\"\n    if edge == \"top\":\n        return (bar_len - 1, pos)\n    if edge == \"bottom\":\n        return (n - bar_len, pos)\n    if edge == \"left\":\n        return (pos, bar_len - 1)\n    return (pos, n - bar_len)\n\n\ndef _transform(\n    locals_: list[tuple[int, int]], edge: str, n: int, bar_len: int, pos: int\n) -> list[tuple[int, int]]:\n    \"\"\"Map local (fwd, side) coords to global (row, col) for a given edge/pos.\"\"\"\n    tr, tc = _terminal_for(edge, n, bar_len, pos)\n    fr, fc = EDGE_DATA[edge][\"fwd\"]\n    sr, sc = EDGE_DATA[edge][\"side\"]\n    return [(tr + lr * fr + lc * sr, tc + lr * fc + lc * sc) for lr, lc in locals_]\n\n\ndef _grow_obstacle(\n    start: tuple[int, int], max_size: int, forbidden: set[tuple[int, int]]\n) -> list[tuple[int, int]]:\n    \"\"\"Grow a 4-connected sprite from *start*, avoiding *forbidden* cells.\"\"\"\n    obstacle = {start}\n    for _ in range(max_size - 1):\n        cands = [\n            (nr, nc)\n            for r, c in obstacle\n            for nr, nc in neighbors4(r, c)\n            if (nr, nc) not in obstacle and (nr, nc) not in forbidden\n        ]\n        if not cands:\n            break\n        obstacle.add(random.choice(cands))\n    return list(obstacle)\n\n\ndef _build_input_path(seg_len: int, turns: int, side: int) -> list[tuple[int, int]]:\n    \"\"\"Build an irregular 8-connected stroke going backward (away from border).\"\"\"\n    remaining = seg_len - 1\n    coords = [(0, side)]\n    diag_step = (-1, side)\n    orth_step = (-1, 0)\n    last_was_diag = None\n    turns_left = turns\n    while remaining > 0:\n        if turns_left <= 0:\n            step = diag_step if last_was_diag else orth_step\n            if last_was_diag is None:\n                step = random.choice([diag_step, orth_step])\n            run = remaining\n        else:\n            if last_was_diag is None:\n                is_diag = random.random() < DIAG_START_PROB\n            elif last_was_diag:\n                is_diag = random.random() < DIAG_CONTINUE_PROB\n            else:\n                is_diag = random.random() < DIAG_START_PROB\n            step = diag_step if is_diag else orth_step\n            if last_was_diag is not None and is_diag != last_was_diag:\n                turns_left -= 1\n            max_run = remaining - turns_left\n            run = random.randint(1, max(1, min(max_run, remaining)))\n        last_was_diag = (step == diag_step)\n        for _ in range(run):\n            pr, pc = coords[-1]\n            coords.append((pr + step[0], pc + step[1]))\n        remaining -= run\n    return coords\n\n\ndef _build_output_path(\n    seg_len: int, side: int, p1: int, p2: int, p3: int\n) -> list[tuple[int, int]]:\n    \"\"\"Build the 3-phase monotone output segment in local coords.\"\"\"\n    coords = [(0, side)]\n    # (fwd_dr, lateral_dc) for each phase: approach, alongside, exit\n    phase_steps = [(1, side), (1, 0), (1, -side)]\n    for phase_len, (dr, dc) in zip([p1, p2, p3], phase_steps):\n        for _ in range(phase_len):\n            pr, pc = coords[-1]\n            coords.append((pr + dr, pc + dc))\n    return coords\n\n\ndef _is_4adj(coords_a: list[tuple[int, int]], coords_b: list[tuple[int, int]]) -> bool:\n    \"\"\"Return True if any cell in *coords_a* overlaps or is 4-adjacent to *coords_b*.\"\"\"\n    bset = set(coords_b)\n    for r, c in coords_a:\n        if (r, c) in bset:\n            return True\n        for nr, nc in neighbors4(r, c):\n            if (nr, nc) in bset:\n                return True\n    return False\n\n\ndef _make_triple(n: int) -> dict | None:\n    \"\"\"Generate one bar+segment+obstacle triple in local coordinates (origin at terminal).\"\"\"\n    max_bar = min(BAR_LEN_MAX, n - BAR_CLEARANCE)\n    if max_bar < BAR_LEN_MIN:\n        return None\n\n    bar_len = random.randint(BAR_LEN_MIN, max_bar)\n    max_seg = min(SEG_LEN_MAX, n - bar_len + 1)\n    if max_seg < SEG_LEN_MIN:\n        return None\n    seg_len = random.randint(SEG_LEN_MIN, max_seg)\n    side = random.choice((-1, 1))\n    bar = [(-k, 0) for k in range(bar_len)]\n    bar_set = set(bar)\n\n    # Phase lengths: p1 >= 1, p2 >= 0, p3 >= 0, p1+p2+p3 = seg_len-1\n    remaining = seg_len - 1\n    p1 = random.randint(1, min(remaining - 1, PHASE_MAX))\n    remaining -= p1\n    p2 = random.randint(0, min(remaining, PHASE_MAX))\n    p3 = remaining - p2\n\n    output_seg = _build_output_path(seg_len, side, p1, p2, p3)\n    seg_set = set(output_seg)\n\n    # V apex inner: grow obstacle from here\n    apex = output_seg[p1]\n    apex_inner = (apex[0], apex[1] - side)\n    if apex_inner in seg_set or apex_inner in bar_set:\n        return None\n\n    obs_size = random.randint(OBS_SIZE_MIN, OBS_SIZE_MAX)\n    obstacle = _grow_obstacle(apex_inner, obs_size, seg_set | bar_set)\n\n    # Manhattan distance from terminal check\n    nearest_md = min(abs(r) + abs(c) for r, c in obstacle)\n    if not (OBS_MD_MIN <= nearest_md <= OBS_MD_MAX):\n        return None\n\n    # Input segment\n    max_turns = min(INPUT_TURN_MAX, seg_len - 2)\n    turns = random.randint(INPUT_TURN_MIN, max_turns)\n    input_seg = _build_input_path(seg_len, turns, side)\n\n    if _is_4adj(input_seg, obstacle):\n        return None\n\n    union = bar + obstacle + input_seg + output_seg\n    rs = [r for r, _ in union]\n    cs = [c for _, c in union]\n\n    return {\n        \"bar_len\": bar_len,\n        \"bar\": bar,\n        \"obstacle\": obstacle,\n        \"input_seg\": input_seg,\n        \"output_seg\": output_seg,\n        \"bbox\": (min(rs), min(cs), max(rs), max(cs)),\n    }\n\n\ndef _expanded_bbox(coords: list[tuple[int, int]], n: int) -> tuple[int, int, int, int]:\n    \"\"\"Compute bounding box of *coords* expanded by PLACEMENT_PAD, clamped to [0, n-1].\"\"\"\n    rs = [r for r, _ in coords]\n    cs = [c for _, c in coords]\n    return (\n        max(0, min(rs) - PLACEMENT_PAD),\n        max(0, min(cs) - PLACEMENT_PAD),\n        min(n - 1, max(rs) + PLACEMENT_PAD),\n        min(n - 1, max(cs) + PLACEMENT_PAD),\n    )\n\n\ndef _place_triple(\n    triple: dict, edge: str, n: int, reserved: np.ndarray\n) -> dict | None:\n    \"\"\"Try to place a triple on *edge*, returning global coords or None.\"\"\"\n    positions = list(range(n))\n    random.shuffle(positions)\n    union = triple[\"bar\"] + triple[\"obstacle\"] + triple[\"input_seg\"] + triple[\"output_seg\"]\n    bar_len = triple[\"bar_len\"]\n\n    for pos in positions:\n        union_g = _transform(union, edge, n, bar_len, pos)\n        if any(r < 0 or c < 0 or r >= n or c >= n for r, c in union_g):\n            continue\n        r0, c0, r1, c1 = _expanded_bbox(union_g, n)\n        if reserved[r0 : r1 + 1, c0 : c1 + 1].any():\n            continue\n        placed = {\n            \"bar\": _transform(triple[\"bar\"], edge, n, bar_len, pos),\n            \"obstacle\": _transform(triple[\"obstacle\"], edge, n, bar_len, pos),\n            \"input_seg\": _transform(triple[\"input_seg\"], edge, n, bar_len, pos),\n            \"output_seg\": _transform(triple[\"output_seg\"], edge, n, bar_len, pos),\n            \"terminal\": _transform([(0, 0)], edge, n, bar_len, pos)[0],\n            \"reserve\": (r0, c0, r1, c1),\n        }\n        return placed\n    return None\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt: build grid with 1-3 triples, validate via oracle.\"\"\"\n    n = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    if n < 11:\n        max_triples = 1\n    elif n < 15:\n        max_triples = 2\n    else:\n        max_triples = 3\n    triple_count = random.randint(1, max_triples)\n\n    bg, bar_color, seg_color, obstacle_color = random.sample(range(10), 4)\n    inp = np.full((n, n), bg, dtype=int)\n    out = np.full((n, n), bg, dtype=int)\n    reserved = np.zeros((n, n), dtype=bool)\n    placed_triples = []\n\n    for edge in random.sample(list(EDGE_DATA), triple_count):\n        triple = _make_triple(n)\n        if triple is None:\n            return None\n        placed = _place_triple(triple, edge, n, reserved)\n        if placed is None:\n            return None\n\n        paint_coords(inp, placed[\"bar\"], bar_color)\n        paint_coords(inp, placed[\"obstacle\"], obstacle_color)\n        paint_coords(inp, placed[\"input_seg\"], seg_color)\n\n        paint_coords(out, placed[\"bar\"], bar_color)\n        paint_coords(out, placed[\"obstacle\"], obstacle_color)\n        paint_coords(out, placed[\"output_seg\"], seg_color)\n\n        r0, c0, r1, c1 = placed[\"reserve\"]\n        reserved[r0 : r1 + 1, c0 : c1 + 1] = True\n        placed_triples.append(placed)\n\n    if len(placed_triples) > 1:\n        for i, placed in enumerate(placed_triples):\n            tr, tc = placed[\"terminal\"]\n            own = min(abs(r - tr) + abs(c - tc) for r, c in placed[\"obstacle\"])\n            other = min(\n                abs(r - tr) + abs(c - tc)\n                for j, other_placed in enumerate(placed_triples)\n                if j != i\n                for r, c in other_placed[\"obstacle\"]\n            )\n            if own >= other:\n                return None\n\n    try:\n        if not np.array_equal(main(inp), out):\n            return None\n    except Exception:\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"failed to generate a valid input after {MAX_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
