{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/305b1341.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, get_bg\nimport random\n\n\ndef _legend_pairs(g: np.ndarray, bg: int) -> list[tuple[int, int]]:\n    pairs: list[tuple[int, int]] = []\n    for r in range(g.shape[0]):\n        left = int(g[r, 0])\n        right = int(g[r, 1])\n        if left == bg or right == bg:\n            break\n        pairs.append((left, right))\n    assert pairs, \"expected a non-empty two-column legend at the upper left\"\n    return pairs\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Expand each sparse color object into a filled rectangular region using its legend-paired fill color.\n\n    Input structure\n    A background-color grid has a two-column legend in columns 0 and 1, starting at row 0: each row gives\n    a source color in the left column and that source color's fill color in the right column.  Outside the\n    legend, the foreground pixels are sparse dot objects whose colors are exactly the legend source colors.\n\n    Rule\n    Clear the legend.  For each source color, take the bbox of all of its non-legend dots, expand that bbox\n    by one pixel in every direction, and fill background cells inside the expanded rectangle with the paired\n    legend fill color while preserving every original non-legend dot.\n\n    Key insight\n    The legend order is also the layer order: earlier legend rows are in front, so fill rectangles are painted\n    from the last legend row back to the first and higher-priority fills overwrite lower-priority fills.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n    assert W >= 2, \"expected room for a two-column legend\"\n\n    pairs = _legend_pairs(g, bg)\n    source_colors = {source for source, _fill in pairs}\n    assert len(source_colors) == len(pairs), \"legend source colors must be unique\"\n\n    legend_mask = np.zeros(g.shape, dtype=bool)\n    legend_mask[: len(pairs), :2] = True\n    dot_mask = (g != bg) & ~legend_mask\n    assert dot_mask.any(), \"expected source dots outside the legend\"\n    assert set(map(int, g[dot_mask])).issubset(source_colors), \"outside dots must use legend source colors\"\n\n    dots_by_color: dict[int, np.ndarray] = {}\n    all_dots = np.zeros(g.shape, dtype=bool)\n    for source, _fill in pairs:\n        coords = np.argwhere(dot_mask & (g == source))\n        assert coords.size, \"each legend source color must appear outside the legend\"\n        dots_by_color[source] = coords\n        all_dots[coords[:, 0], coords[:, 1]] = True\n\n    out = np.full_like(g, bg)\n    for source, fill in reversed(pairs):\n        r0, c0, r1, c1 = bbox_coords(dots_by_color[source])\n        r0 = max(0, r0 - 1)\n        c0 = max(0, c0 - 1)\n        r1 = min(H - 1, r1 + 1)\n        c1 = min(W - 1, c1 + 1)\n\n        region = out[r0 : r1 + 1, c0 : c1 + 1]\n        background_inside_region = ~all_dots[r0 : r1 + 1, c0 : c1 + 1]\n        region[background_inside_region] = fill\n\n    out[all_dots] = g[all_dots]\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and legend geometry.\nGRID_HEIGHT, GRID_WIDTH = 20, 20\nBACKGROUND_COLOR = 0\nLEGEND_COLS = 2\nDOT_STRIDE, BBOX_PAD, NON_OVERLAP_GAP = 2, 1, 1\n\n# Legend palette sampling.\nCOLORS = tuple(range(1, 10))\nPAIR_COUNT_CHOICES = (2, 3)\nROTATED_SOURCE_FILL_PROB = 0.45\n\n# Dot-grid shape sampling.\nDOT_ROWS_MIN, DOT_ROWS_MAX = 2, 8\nDOT_COLS_MIN, DOT_COLS_MAX = 2, 5\n\n# Layout search.\nTHREE_PAIR_FORCED_OVERLAP_STEPS = (1, 2)\nMODE_OVERLAP, MODE_OVERLAP_ANY, MODE_SEPARATE, MODE_ANY = \"overlap\", \"overlap_any\", \"separate\", \"any\"\nPOST_FORCED_LAYOUT_MODES = (MODE_SEPARATE, MODE_OVERLAP_ANY, MODE_ANY)\nPOST_FORCED_LAYOUT_WEIGHTS = (3, 3, 1)\n\n# Generation retry budget.\nGENERATION_RETRIES = 300\n\n\ndef _origin_bbox(origin: tuple[int, int], dot_rows: int, dot_cols: int) -> tuple[int, int, int, int]:\n    r, c = origin\n    return (\n        r - BBOX_PAD,\n        c - BBOX_PAD,\n        r + DOT_STRIDE * (dot_rows - 1) + BBOX_PAD,\n        c + DOT_STRIDE * (dot_cols - 1) + BBOX_PAD,\n    )\n\n\ndef _hits_legend(box: tuple[int, int, int, int], n_pairs: int) -> bool:\n    r0, c0, r1, c1 = box\n    return r0 <= n_pairs - 1 and r1 >= 0 and c0 <= LEGEND_COLS - 1 and c1 >= 0\n\n\ndef _legal_origins(n_pairs: int, dot_rows: int, dot_cols: int) -> list[tuple[int, int]]:\n    origins: list[tuple[int, int]] = []\n    max_r = GRID_HEIGHT - 1 - BBOX_PAD - DOT_STRIDE * (dot_rows - 1)\n    max_c = GRID_WIDTH - 1 - BBOX_PAD - DOT_STRIDE * (dot_cols - 1)\n    for r in range(BBOX_PAD, max_r + 1):\n        for c in range(BBOX_PAD, max_c + 1):\n            box = _origin_bbox((r, c), dot_rows, dot_cols)\n            if not _hits_legend(box, n_pairs):\n                origins.append((r, c))\n    return origins\n\n\ndef _dot_coords(origin: tuple[int, int], dot_rows: int, dot_cols: int) -> np.ndarray:\n    rows = origin[0] + DOT_STRIDE * np.arange(dot_rows)\n    cols = origin[1] + DOT_STRIDE * np.arange(dot_cols)\n    rr, cc = np.meshgrid(rows, cols, indexing=\"ij\")\n    return np.stack([rr.ravel(), cc.ravel()], axis=1).astype(int)\n\n\ndef _expanded_bbox(coords: np.ndarray) -> tuple[int, int, int, int]:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    return (\n        max(0, r0 - BBOX_PAD),\n        max(0, c0 - BBOX_PAD),\n        min(GRID_HEIGHT - 1, r1 + BBOX_PAD),\n        min(GRID_WIDTH - 1, c1 + BBOX_PAD),\n    )\n\n\ndef _inside_box(coords: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:\n    r0, c0, r1, c1 = box\n    return (coords[:, 0] >= r0) & (coords[:, 0] <= r1) & (coords[:, 1] >= c0) & (coords[:, 1] <= c1)\n\n\ndef _separated_by_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n    return (\n        a[2] + NON_OVERLAP_GAP < b[0]\n        or b[2] + NON_OVERLAP_GAP < a[0]\n        or a[3] + NON_OVERLAP_GAP < b[1]\n        or b[3] + NON_OVERLAP_GAP < a[1]\n    )\n\n\ndef _intersection_bounds(\n    a: tuple[int, int, int, int], b: tuple[int, int, int, int]\n) -> tuple[int, int, int, int] | None:\n    r0, c0 = max(a[0], b[0]), max(a[1], b[1])\n    r1, c1 = min(a[2], b[2]), min(a[3], b[3])\n    if r0 > r1 or c0 > c1:\n        return None\n    return r0, c0, r1, c1\n\n\ndef _intersection_has_background(\n    a: tuple[int, int, int, int], b: tuple[int, int, int, int], dot_mask: np.ndarray\n) -> bool:\n    bounds = _intersection_bounds(a, b)\n    if bounds is None:\n        return False\n    r0, c0, r1, c1 = bounds\n    return bool((~dot_mask[r0 : r1 + 1, c0 : c1 + 1]).any())\n\n\ndef _remove_dots_covered_by_higher_priority(\n    coords: np.ndarray, higher_boxes: list[tuple[int, int, int, int]]\n) -> np.ndarray:\n    keep = np.ones(len(coords), dtype=bool)\n    for box in higher_boxes:\n        keep &= ~_inside_box(coords, box)\n    return coords[keep]\n\n\ndef _scene_data(\n    sizes: list[tuple[int, int]], origins: list[tuple[int, int]]\n) -> tuple[list[np.ndarray], list[tuple[int, int, int, int]], np.ndarray] | None:\n    remaining: list[np.ndarray] = []\n    boxes: list[tuple[int, int, int, int]] = []\n    dot_mask = np.zeros((GRID_HEIGHT, GRID_WIDTH), dtype=bool)\n\n    for (dot_rows, dot_cols), origin in zip(sizes, origins):\n        coords = _remove_dots_covered_by_higher_priority(_dot_coords(origin, dot_rows, dot_cols), boxes)\n        if coords.size == 0:\n            return None\n        if len(set(map(int, coords[:, 0]))) != dot_rows or len(set(map(int, coords[:, 1]))) != dot_cols:\n            return None\n        if dot_mask[coords[:, 0], coords[:, 1]].any():\n            return None\n        dot_mask[coords[:, 0], coords[:, 1]] = True\n        remaining.append(coords)\n        boxes.append(_expanded_bbox(coords))\n\n    return remaining, boxes, dot_mask\n\n\ndef _render_output(\n    pairs: list[tuple[int, int]], remaining: list[np.ndarray], boxes: list[tuple[int, int, int, int]], dot_mask: np.ndarray\n) -> np.ndarray:\n    out = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)\n    for idx in range(len(pairs) - 1, -1, -1):\n        _source, fill = pairs[idx]\n        r0, c0, r1, c1 = boxes[idx]\n        region = out[r0 : r1 + 1, c0 : c1 + 1]\n        region[~dot_mask[r0 : r1 + 1, c0 : c1 + 1]] = fill\n    for (source, _fill), coords in zip(pairs, remaining):\n        out[coords[:, 0], coords[:, 1]] = source\n    return out\n\n\ndef _build_input(pairs: list[tuple[int, int]], remaining: list[np.ndarray]) -> np.ndarray:\n    grid = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)\n    grid[: len(pairs), :LEGEND_COLS] = np.asarray(pairs, dtype=int)\n    for (source, _fill), coords in zip(pairs, remaining):\n        grid[coords[:, 0], coords[:, 1]] = source\n    return grid\n\n\ndef _visible_overlap(\n    pairs: list[tuple[int, int]], boxes: list[tuple[int, int, int, int]], dot_mask: np.ndarray, out: np.ndarray\n) -> bool:\n    for hi in range(len(pairs)):\n        for lo in range(hi + 1, len(pairs)):\n            bounds = _intersection_bounds(boxes[hi], boxes[lo])\n            if bounds is None:\n                continue\n            r0, c0, r1, c1 = bounds\n            overlap_fill = (~dot_mask[r0 : r1 + 1, c0 : c1 + 1]) & (\n                out[r0 : r1 + 1, c0 : c1 + 1] == pairs[hi][1]\n            )\n            lr0, lc0, lr1, lc1 = boxes[lo]\n            lower_fill = (~dot_mask[lr0 : lr1 + 1, lc0 : lc1 + 1]) & (\n                out[lr0 : lr1 + 1, lc0 : lc1 + 1] == pairs[lo][1]\n            )\n            if overlap_fill.any() and lower_fill.any():\n                return True\n    return False\n\n\ndef _choose_pairs(n_pairs: int) -> list[tuple[int, int]]:\n    colors = list(COLORS)\n    sources = random.sample(colors, n_pairs)\n    non_sources = [c for c in colors if c not in sources]\n    if random.random() < ROTATED_SOURCE_FILL_PROB:\n        fills = sources[1:] + sources[:1]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import get_bg, paste\nimport random\n\n\ndef _constant_non_bg_rows(g: np.ndarray, bg: int) -> list[int]:\n    return [\n        int(r)\n        for r in range(g.shape[0])\n        if bool(np.all(g[r, :] == g[r, 0])) and int(g[r, 0]) != int(bg)\n    ]\n\n\ndef _cell_signature(g: np.ndarray, r0: int, c0: int, size: int, bg: int) -> tuple[tuple[int, int, int], ...] | None:\n    cell = g[int(r0) : int(r0) + int(size), int(c0) : int(c0) + int(size)]\n    mask = cell != int(bg)\n    if not bool(mask.any()):\n        return None\n    return tuple(\n        (int(r), int(c), int(cell[r, c]))\n        for r, c in zip(*np.where(mask), strict=False)\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Look up query glyphs in a reference table and mark whether they form a line.\n\n    Input structure:\n    - Teal background with two full-width pink separator rows.\n    - Above the first separator is a query row of 5x5 glyph cells.\n    - Between separators is a reference table of the same 5x5 cells; a glyph is\n      identified by both its color and its 3x3 shape.\n\n    Rule:\n    - Green-fill the background inside every table cell whose glyph exactly\n      appears in the query row.\n    - If the matched table cells form one complete row or one complete column,\n      also green-fill the query band and the bottom verdict band.\n    - Otherwise leave the query band unchanged and fill the bottom verdict band red.\n\n    Key insight: The bottom color is not a count; it is the yes/no answer to\n    whether the queried glyphs align as a full row or column in the table.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n    cell_size = 5\n\n    sep_rows = _constant_non_bg_rows(g, bg)\n    assert len(sep_rows) >= 2, \"expected two full-width separator rows\"\n    top_sep = sep_rows[0]\n    bottom_sep = sep_rows[-1]\n\n    table_region = g[top_sep + 1 : bottom_sep, :]\n    table_fg = np.argwhere(table_region != bg)\n    assert table_fg.size, \"reference table must contain glyphs\"\n\n    first_glyph_r = top_sep + 1 + int(table_fg[:, 0].min())\n    first_glyph_c = int(table_fg[:, 1].min())\n    row0 = first_glyph_r - 1\n    col0 = first_glyph_c - 1\n\n    row_starts = list(range(row0, bottom_sep, cell_size))\n    row_starts = [r for r in row_starts if r + cell_size <= bottom_sep]\n    col_starts = list(range(col0, w, cell_size))\n    col_starts = [c for c in col_starts if c + cell_size <= w]\n    assert row_starts and col_starts, \"could not infer table cell grid\"\n\n    query_sigs = [\n        sig\n        for c in col_starts\n        if (sig := _cell_signature(g, 0, c, cell_size, bg)) is not None\n    ]\n    query_set = set(query_sigs)\n    assert len(query_sigs) == len(query_set), \"query glyphs should be distinct\"\n\n    out = g.copy()\n    selected: list[tuple[int, int]] = []\n    for ri, r in enumerate(row_starts):\n        for ci, c in enumerate(col_starts):\n            if _cell_signature(g, r, c, cell_size, bg) not in query_set:\n                continue\n            selected.append((int(ri), int(ci)))\n            cell = out[r : r + cell_size, c : c + cell_size]\n            cell[cell == bg] = 3\n\n    complete_query = len(query_sigs) == len(col_starts)\n    same_row = len({r for r, _c in selected}) == 1\n    same_col = len({c for _r, c in selected}) == 1\n    success = complete_query and len(selected) == len(query_sigs) and (same_row or same_col)\n\n    if success:\n        query_band = out[:top_sep, :]\n        query_band[query_band == bg] = 3\n        out[bottom_sep + 1 :, :] = 3\n    else:\n        out[bottom_sep + 1 :, :] = 2\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# -- Grid layout --\nGRID_H, GRID_W = 30, 22       # fixed canvas size\nTOP_SEP_ROW = 5                # query-band separator row\nBOTTOM_SEP_ROW = 27            # table-bottom separator row\nQUERY_BAND_H = 5               # height of query band (rows 0..4)\nVERDICT_ROW = 28               # verdict band starts here\n\n# -- Colors --\nBG = 8                         # teal background\nGREEN = 3                      # success / match highlight\nRED = 2                        # fail verdict\nSEP = 6                        # separator row color\nGLYPH_COLORS = (0, 1, 2, 4, 5, 6, 7, 9)  # 8 available glyph colors\n\n# -- Table geometry --\nTABLE_DIM = 4                  # 4x4 grid of cells\nCELL = 5                       # each cell is 5x5\nROWS = (7, 12, 17, 22)        # row offsets for 4 table rows\nCOLS = (1, 6, 11, 16)         # col offsets for 4 table columns\n\n# -- Glyph shape --\nFILL_MIN, FILL_MAX = 5, 9     # filled-pixel range per 3x3 glyph\nSHAPE_BASE_COUNTS = {5: 2, 6: 2, 7: 2, 8: 2, 9: 1}  # min shapes per fill-count\nMAX_SHAPES_PER_FILL = 5       # cap during random top-up\n\n# -- Color distribution --\nCOLOR_MIN, COLOR_MAX = 1, 3   # each color used 1-3 times across 16 cells\n\n# -- Outcome probabilities --\nP_SUCCESS = 0.4               # chance of success outcome\nP_QUERY_3 = 0.35              # chance of 3-query fail (vs 4-query fail)\nFAIL_MODES = (\"rect\", \"bent_row\", \"bent_col\", \"scatter_rows\", \"scatter_cols\")\n\n# -- Generation --\nMAX_RETRIES = 300\n\n\ndef _has_full_bbox(mask: int) -> bool:\n    \"\"\"True if the 3x3 bitmask spans all four edges (non-empty top/bottom/left/right rows).\"\"\"\n    bits = [(mask >> i) & 1 for i in range(9)]\n    return (\n        any(bits[0:3])\n        and any(bits[6:9])\n        and any(bits[i] for i in (0, 3, 6))\n        and any(bits[i] for i in (2, 5, 8))\n    )\n\n\nPATTERNS_BY_FILL = {\n    k: tuple(m for m in range(1 << 9) if m.bit_count() == k and _has_full_bbox(m))\n    for k in range(FILL_MIN, FILL_MAX + 1)\n}\n\n\ndef _balanced_color_list() -> list[int]:\n    \"\"\"Assign 16 colors (one per cell) so each of the 8 palette colors appears 1-3 times.\"\"\"\n    counts = {c: COLOR_MIN for c in GLYPH_COLORS}\n    extras = TABLE_DIM * TABLE_DIM - len(GLYPH_COLORS) * COLOR_MIN  # 16 - 8 = 8\n    for _ in range(extras):\n        choices = [c for c in GLYPH_COLORS if counts[c] < COLOR_MAX]\n        counts[random.choice(choices)] += 1\n    colors = [c for c, n in counts.items() for _ in range(n)]\n    random.shuffle(colors)\n    return colors\n\n\ndef _balanced_shape_masks() -> list[int]:\n    \"\"\"Pick 16 distinct 3x3 shape masks with a balanced distribution of fill counts.\"\"\"\n    counts = dict(SHAPE_BASE_COUNTS)\n    extras = TABLE_DIM * TABLE_DIM - sum(counts.values())  # 16 - 9 = 7\n    for _ in range(extras):\n        choices = [k for k in range(FILL_MIN, FILL_MAX) if counts[k] < MAX_SHAPES_PER_FILL]\n        counts[random.choice(choices)] += 1\n\n    masks: list[int] = []\n    for k, n in counts.items():\n        masks.extend(random.sample(PATTERNS_BY_FILL[k], n))\n    random.shuffle(masks)\n    return masks\n\n\ndef _glyph(mask: int, color: int) -> np.ndarray:\n    \"\"\"Render a 3x3 bitmask as a CELL x CELL array with 1-pixel border of BG.\"\"\"\n    cell = np.full((CELL, CELL), BG, dtype=int)\n    bits = np.array([(mask >> i) & 1 for i in range(9)], dtype=bool).reshape(3, 3)\n    cell[1:4, 1:4][bits] = color\n    return cell\n\n\ndef _line_cells() -> list[tuple[int, int]]:\n    \"\"\"Pick a complete row or column of 4 cells (shuffled order).\"\"\"\n    if random.random() < 0.5:\n        r = random.randrange(TABLE_DIM)\n        cells = [(r, c) for c in range(TABLE_DIM)]\n    else:\n        c = random.randrange(TABLE_DIM)\n        cells = [(r, c) for r in range(TABLE_DIM)]\n    random.shuffle(cells)\n    return cells\n\n\ndef _fail_cells(count: int) -> list[tuple[int, int]]:\n    \"\"\"Pick `count` distinct cells that do NOT all share a single row or column.\"\"\"\n    if count == 3:\n        rs = random.sample(range(TABLE_DIM), random.choice((2, 3)))\n        cs = random.sample(range(TABLE_DIM), random.choice((2, 3)))\n        cells = [(rs[0], cs[0]), (rs[1], cs[1])]\n        pool = [(r, c) for r in rs for c in cs if (r, c) not in cells]\n        cells.append(random.choice(pool))\n    else:\n        mode = random.choice(FAIL_MODES)\n        if mode == \"rect\":\n            rs = random.sample(range(TABLE_DIM), 2)\n            cs = random.sample(range(TABLE_DIM), 2)\n            cells = [(r, c) for r in rs for c in cs]\n        elif mode == \"bent_row\":\n            r = random.randrange(TABLE_DIM)\n            dropped_c = random.randrange(TABLE_DIM)\n            new_r = random.choice([rr for rr in range(TABLE_DIM) if rr != r])\n            cells = [(r, c) for c in range(TABLE_DIM) if c != dropped_c] + [(new_r, dropped_c)]\n        elif mode == \"bent_col\":\n            c = random.randrange(TABLE_DIM)\n            dropped_r = random.randrange(TABLE_DIM)\n            new_c = random.choice([cc for cc in range(TABLE_DIM) if cc != c])\n            cells = [(r, c) for r in range(TABLE_DIM) if r != dropped_r] + [(dropped_r, new_c)]\n        elif mode == \"scatter_rows\":\n            base_c = random.randrange(TABLE_DIM)\n            cols = [base_c] * TABLE_DIM\n            for r in random.sample(range(TABLE_DIM), random.choice((1, 2, 3))):\n                cols[r] = random.choice([c for c in range(TABLE_DIM) if c != base_c])\n            cells = [(r, cols[r]) for r in range(TABLE_DIM)]\n        else:\n            base_r = random.randrange(TABLE_DIM)\n            rows = [base_r] * TABLE_DIM\n            for c in random.sample(range(TABLE_DIM), random.choice((1, 2, 3))):\n                rows[c] = random.choice([r for r in range(TABLE_DIM) if r != base_r])\n            cells = [(rows[c], c) for c in range(TABLE_DIM)]\n\n    assert len(cells) == count and len(set(cells)) == count\n    assert len({r for r, _c in cells}) > 1 and len({c for _r, c in cells}) > 1\n    random.shuffle(cells)\n    return cells\n\n\ndef _expected_output(grid: np.ndarray, cells: list[tuple[int, int]], success: bool) -> np.ndarray:\n    \"\"\"Build the expected solver output by green-filling matched cells and verdict band.\"\"\"\n    out = grid.copy()\n    for r_i, c_i in cells:\n        cell = out[ROWS[r_i] : ROWS[r_i] + CELL, COLS[c_i] : COLS[c_i] + CELL]\n        cell[cell == BG] = GREEN\n    if success:\n        query_band = out[:QUERY_BAND_H, :]\n        query_band[query_band == BG] = GREEN\n        out[VERDICT_ROW:, :] = GREEN\n","exit_code":0,"status":"completed"}}
