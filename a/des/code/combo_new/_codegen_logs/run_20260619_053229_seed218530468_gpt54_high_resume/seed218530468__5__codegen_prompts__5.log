    Rule:\n/home/lixinyu/snap/new/ARC_code/train/9f5f939b.py:55:    Key insight:\n/home/lixinyu/snap/new/ARC_code/train/9f5f939b.py:57:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/9f5f939b.py:123:    \"\"\"Check that cells have no 4-neighbor foreground outside their own component.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/9f5f939b.py:137:    \"\"\"Place up to count complete plus motifs and return their hidden centers.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/9f5f939b.py:279:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:59:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:60:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:63:    Input structure:\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:69:    Rule:\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:76:    Key insight:\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:79:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:491:    \"\"\"Render the primary path columns and return the grid plus long-contour mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:502:    \"\"\"Add short distractors, then pad long contours to the sampled pixel target.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:518:    \"\"\"Place channel bars first, then scatter isolated obstacle clusters.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:527:    \"\"\"Build the output-first pair and carry validation metadata.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:564:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py:22:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py:23:    \"\"\"Recolor each placeholder object according to its normalized shape while leaving the background fixed.\n/home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py:36:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py:84:    \"\"\"Return all six shape ids plus 0-2 duplicate ids, then shuffle them.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py:113:    \"\"\"Place one shape at the first free candidate in a randomized scan.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py:140:def generate_input():\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:7:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:8:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:11:    Input structure:\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:16:    Rule:\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:21:    Key insight:\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:23:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:109:    \"\"\"Construct one LR-symmetric 4-connected sprite matching the configured area/hole bounds.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:152:    \"\"\"Return the visible grid bbox and matching sprite slice for a possibly clipped sprite.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:167:    \"\"\"Choose non-overlapping object origins; returns placement tuples or None on retry exhaustion.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:196:    \"\"\"Render the paired output and return the generated input with halo-fill cells removed.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:260:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/465b7d93.py:96:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/465b7d93.py:97:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/465b7d93.py:100:    Input structure:\n/home/lixinyu/snap/new/ARC_code/train/465b7d93.py:106:    Rule:\n/home/lixinyu/snap/new/ARC_code/train/465b7d93.py:114:    Key insight:\n/home/lixinyu/snap/new/ARC_code/train/465b7d93.py:117:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/465b7d93.py:260:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:12:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:13:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:29:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:343:    \"\"\"Connect background-region labels separated by each wall component.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:389:    \"\"\"Validate task constraints and return the solver-expected output grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:452:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
