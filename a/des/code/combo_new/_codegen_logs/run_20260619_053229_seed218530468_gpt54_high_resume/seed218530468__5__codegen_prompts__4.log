{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/409aa875.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, get_bg as _bg_color, neighbors4, neighbors8\nimport random\nfrom collections import Counter, defaultdict\nfrom arc_utils import bbox_coords, components_mask, get_bg, paste\n\n\ndef _cc8(mask: np.ndarray) -> list[list[tuple[int, int]]]:\n    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(mask, connectivity=8)]\n\n\ndef _triangle_apex_and_dir(comp: list[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int]] | None:\n    # Returns (apex_rc, dir_rc). Direction is one of 4-neigh (axis) or diagonal.\n    if len(comp) != 3:\n        return None\n    s = set(comp)\n\n    deg4 = {}\n    deg8 = {}\n    for r, c in comp:\n        deg4[(r, c)] = sum(1 for n in neighbors4(r, c) if n in s)\n        deg8[(r, c)] = sum(1 for n in neighbors8(r, c) if n in s)\n\n    # L-shape (axis-aligned): one pixel has two 4-neighbors (the corner).\n    corners = [p for p, d in deg4.items() if d == 2]\n    if corners:\n        corner = corners[0]\n        cr, cc = corner\n        arms = []\n        for r, c in comp:\n            if (r, c) == corner:\n                continue\n            dr, dc = r - cr, c - cc\n            if abs(dr) + abs(dc) == 1:\n                arms.append((dr, dc))\n        if len(arms) != 2:\n            return None\n        dr_sum = arms[0][0] + arms[1][0]\n        dc_sum = arms[0][1] + arms[1][1]\n        # Projectile goes in the diagonal direction opposite the missing 2x2 corner.\n        dr = -dr_sum\n        dc = -dc_sum\n        dr = 0 if dr == 0 else (1 if dr > 0 else -1)\n        dc = 0 if dc == 0 else (1 if dc > 0 else -1)\n        return corner, (dr, dc)\n\n    # Diagonal V-shape: one pixel has two 8-neighbors (diagonal legs).\n    apexes = [p for p, d in deg8.items() if d == 2]\n    if len(apexes) != 1:\n        return None\n    apex = apexes[0]\n    ar, ac = apex\n    others = [p for p in comp if p != apex]\n    d1 = (others[0][0] - ar, others[0][1] - ac)\n    d2 = (others[1][0] - ar, others[1][1] - ac)\n    dr_sum = d1[0] + d2[0]\n    dc_sum = d1[1] + d2[1]\n    # The direction is the axis direction opposite the average of the two diagonal legs.\n    dr = -(dr_sum // 2)\n    dc = -(dc_sum // 2)\n    if abs(dr) + abs(dc) != 1:\n        return None\n    return apex, (dr, dc)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fire projectiles from 3-pixel triangle sprites; mark collisions with maroon or blue.\n\n    Input structure:\n    - bg = most common color. Non-bg 3-pixel sprites shaped as axis-aligned L's or diagonal V's.\n\n    Rule:\n    - Each triangle has an apex and an emission direction determined by its shape: L-shapes fire diagonally away from the missing corner; V-shapes fire along the axis away from the open side.\n    - A projectile lands exactly 5 cells from the apex in the emission direction.\n    - If it hits an existing sprite, that entire sprite is recolored to maroon (9).\n    - If two projectiles land on the same empty cell, that cell becomes blue (1); a lone projectile on empty bg paints maroon (9).\n\n    Key insight: The triangle's orientation encodes both direction and target; dual-projectile collisions on open bg produce blue, not maroon.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = _bg_color(g)\n\n    # Find all monochrome components for each non-bg color.\n    comps: list[list[tuple[int, int]]] = []\n    cell_to_comp: dict[tuple[int, int], int] = {}\n    for col in sorted(set(int(v) for v in np.unique(g)) - {bg}):\n        for comp in _cc8(g == col):\n            cid = len(comps)\n            comps.append(comp)\n            for rc in comp:\n                cell_to_comp[rc] = cid\n\n    # Each triangle emits a projectile. The visible effect is at the collision location only.\n    # From training, the collision location is 5 cells away from the apex in its emission direction.\n    dest_to_shooters: dict[tuple[int, int], list[int]] = {}\n    for cid, comp in enumerate(comps):\n        ad = _triangle_apex_and_dir(comp)\n        if ad is None:\n            continue\n        (ar, ac), (dr, dc) = ad\n        rr = ar + 5 * dr\n        cc = ac + 5 * dc\n        if 0 <= rr < h and 0 <= cc < w:\n            dest_to_shooters.setdefault((rr, cc), []).append(cid)\n\n    hit_components: set[int] = set()\n    for dest in dest_to_shooters:\n        if dest in cell_to_comp:\n            hit_components.add(cell_to_comp[dest])\n\n    out = g.copy()\n\n    # Projectile hitting a sprite recolors the entire sprite to maroon (9).\n    for cid in hit_components:\n        for r, c in comps[cid]:\n            out[r, c] = 9\n\n    # Projectile collision locations on empty background.\n    for (r, c), shooters in dest_to_shooters.items():\n        if (r, c) in cell_to_comp:\n            continue\n        if len(shooters) >= 2:\n            out[r, c] = 1\n        else:\n            out[r, c] = 9\n\n    return out\n\n# --------------- generator (attempt 2 (Codex)) ---------------\n\n# ---- canvas / palette ----\nH = W = 16                                        # fixed grid size\nBG = 7                                            # fixed background color\nHIT_COLOR = 9                                     # recolor for hit sprites and lone-hit bg cells\nCOLLISION_COLOR = 1                               # bg cells hit by >=2 projectiles\nSPRITE_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]       # any color != BG\n\n# ---- geometry ----\nPROJECTILE_DIST = 5                               # apex + 5*dir = landing cell\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]  # L-shape fires diagonally\nAXIS_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]    # V-shape fires axis-aligned\nALL_DIRS = DIAG_DIRS + AXIS_DIRS\n\n# ---- structural counts per grid ----\nSPRITE_COUNT_RANGE = (4, 9)                       # inclusive sprite count\nMAX_HIT_EVENTS = 2                                # projectile-hits-sprite events per grid\nMAX_COLL_EVENTS = 2                               # multi-projectile-on-bg collision events per grid\n\n# ---- generation retries ----\nMAX_ATTEMPTS = 300\n\n\ndef _sprite_cells(apex: tuple[int, int], direction: tuple[int, int]) -> tuple[tuple[int, int], ...]:\n    \"\"\"Return the 3 pixel coords of a triangle sprite with given apex and firing direction.\n\n    Diagonal dir -> L-shape occupying 3 corners of a 2x2 (missing the corner opposite dir).\n    Axis dir -> V-shape with apex + 2 diagonal legs pointing opposite dir.\n    \"\"\"\n    ar, ac = apex\n    dr, dc = direction\n    if abs(dr) + abs(dc) == 2:\n        return ((ar, ac), (ar - dr, ac), (ar, ac - dc))\n    if dr != 0:\n        return ((ar, ac), (ar - dr, ac - 1), (ar - dr, ac + 1))\n    return ((ar, ac), (ar - 1, ac - dc), (ar + 1, ac - dc))\n\n\ndef _in_bounds_cells(cells: tuple[tuple[int, int], ...]) -> bool:\n    return all(0 <= r < H and 0 <= c < W for r, c in cells)\n\n\ndef _halo(cells: tuple[tuple[int, int], ...]) -> frozenset[tuple[int, int]]:\n    \"\"\"Cell + 8-neighborhood, clipped to grid. Used to enforce Chebyshev>=2 separation.\"\"\"\n    return frozenset(\n        (rr, cc)\n        for r, c in cells\n        for rr in range(max(0, r - 1), min(H, r + 2))\n        for cc in range(max(0, c - 1), min(W, c + 2))\n    )\n\n\ndef _build_placements() -> tuple[list[dict], dict[tuple[int, int], list[dict]]]:\n    \"\"\"Precompute all (apex, dir) placements whose sprite and landing cell are in-bounds.\"\"\"\n    placements: list[dict] = []\n    by_dest: dict[tuple[int, int], list[dict]] = defaultdict(list)\n    for ar in range(H):\n        for ac in range(W):\n            for dr, dc in ALL_DIRS:\n                dest = (ar + PROJECTILE_DIST * dr, ac + PROJECTILE_DIST * dc)\n                if not (0 <= dest[0] < H and 0 <= dest[1] < W):\n                    continue\n                cells = _sprite_cells((ar, ac), (dr, dc))\n                if not _in_bounds_cells(cells):\n                    continue\n                placement = {\n                    \"apex\": (ar, ac),\n                    \"dir\": (dr, dc),\n                    \"dest\": dest,\n                    \"cells\": cells,\n                    \"cell_set\": frozenset(cells),\n                    \"halo\": _halo(cells),\n                }\n                placements.append(placement)\n                by_dest[dest].append(placement)\n    return placements, by_dest\n\n\nPLACEMENTS, PLACEMENTS_BY_DEST = _build_placements()\n\n\ndef _fits(placement: dict, occupied: set[tuple[int, int]], reserved_bg: set[tuple[int, int]]) -> bool:\n    \"\"\"Placement is OK if its halo doesn't touch any occupied cell and its cells are free.\"\"\"\n    return not (placement[\"halo\"] & occupied) and not (placement[\"cell_set\"] & reserved_bg)\n\n\ndef _paint_sprite(grid: np.ndarray, placement: dict, color: int) -> None:\n    for r, c in placement[\"cells\"]:\n","exit_code":0,"status":"completed"}}
