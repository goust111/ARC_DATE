{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert a rough nested line drawing into a clean canonical frame-and-dot diagram.\n\n    Input structure:\n    - The grid has one background color and one foreground color.\n    - Foreground 4-connected objects are rough closed frames or small filled blobs.\n    - Frames may contain other frames/blobs; blobs outside a frame remain outside it.\n\n    Rule:\n    - Detect the containment tree of foreground objects using holes of each frame object.\n    - Replace every blob with one foreground pixel.\n    - Replace every frame with a rectangular border padded two cells around its direct children.\n    - Place siblings by their original row/column overlap and order, with one empty cell between canonical objects.\n\n    Key insight: The exact wobbly geometry is irrelevant; only enclosure plus relative sibling positions define the output.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    fg_colors = sorted(set(map(int, g.flatten())) - {bg})\n    assert len(fg_colors) == 1\n    fg = int(fg_colors[0])\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg], return_format=\"dict\")\n    assert comps\n\n    nodes: list[_Node] = []\n    holes: list[list[np.ndarray]] = []\n    for comp in comps:\n        coords = np.asarray(comp[\"coords\"], dtype=int)\n        node = _Node(\n            coords=coords,\n            bbox=tuple(map(int, comp[\"bbox\"])),\n            center=coords.mean(axis=0),\n        )\n        node_holes = _component_holes(g.shape, coords)\n        node.is_frame = bool(node_holes)\n        nodes.append(node)\n        holes.append(node_holes)\n\n    assert any(node.is_frame for node in nodes)\n    for node_i, node in enumerate(nodes):\n        containers = []\n        for frame_i, frame in enumerate(nodes):\n            if node_i == frame_i or not frame.is_frame:\n                continue\n            if any(np.all(hole[tuple(node.coords.T)]) for hole in holes[frame_i]):\n                containers.append(frame)\n        if containers:\n            node.parent = min(containers, key=lambda item: int(item.coords.shape[0]))\n            node.parent.children.append(node)\n\n    roots = [node for node in nodes if node.parent is None]\n    mask = _layout_root(roots)\n    out = np.full(mask.shape, bg, dtype=int)\n    out[mask] = fg\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# ── CFG: tunable generation parameters ──────────────────────────────────────\n# Grid / canvas bounds\nGRID_MIN = 16              # minimum grid dimension (rows or cols)\nGRID_MAX = 25              # maximum grid dimension\nMAX_EXTRA_PAD = 12         # max total padding beyond drawing extent\nMAX_PAD_PER_SIDE = 6       # max padding on one side\n\n# Frame geometry\nFRAME_H_RANGE = (7, 20)    # allowed frame bbox height\nFRAME_W_RANGE = (7, 24)    # allowed frame bbox width\nFRAME_CORNER_MAX = 5       # max corner wobble displacement\nFRAME_MIN_EDGE = 2         # min straight-edge length between corners\nFRAME_TURN_RATIO = (0.34, 0.43)  # acceptable turn-ratio range for wobbly loops\nFRAME_RETRIES = 60         # retries per frame-mask generation\n\n# Blob geometry\nBLOB_SIZE_RANGE = (4, 11)  # blob pixel count range\nBLOB_BBOX_RANGE = (2, 5)   # blob bbox dimension range (exclusive upper)\n\n# Layout / arrangement\nARRANGE_GAP_COMPACT = (2, 3)   # inter-sibling gap range (compact mode)\nARRANGE_GAP_NORMAL = (2, 5)    # inter-sibling gap range (normal mode)\nARRANGE_EXTRA_SPAN = (0, 4)    # extra span added to cross-axis in arrangement\nFRAME_MARGIN_RANGE = (3, 5)    # margin around children inside a frame\nCOMPACT_MARGIN = 3             # fixed margin in compact mode\n\n# Outside blob placement\nOUTSIDE_GAP_RANGE = (2, 5)    # gap between frame and outside blob\n\n# Tree structure probabilities\nDEPTH1_PROB = 0.35             # probability of depth-1 (blobs-only) tree\nOUTSIDE_BLOB_PROB = 0.35       # probability of having an outside blob\nDEPTH1_INSIDE_RANGE = (1, 3)   # blobs inside single frame (depth-1)\nDEPTH2_INNER_BLOBS = (1, 2)    # blobs inside inner frame (depth-2)\nDEPTH2_OUTER_BLOBS = (0, 2)    # sibling blobs beside inner frame (depth-2)\nMAX_TOTAL_CHILDREN = 4         # max children before suppressing outside blob\n\n# Step-mix alternation bias\nSTEP_MIX_ALT_PROB = 0.7       # probability of alternating direction in corner wobble\n\n# Generation retry budget\nGEN_RETRIES = 300              # max attempts in generate_input()\n# ────────────────────────────────────────────────────────────────────────────\n\n\nclass _Obj:\n    def __init__(self, kind, children=None, outside_side=None):\n        self.kind = kind\n        self.children = list(children or [])\n        self.mask = None\n        self.rel = (0, 0)\n        self.pos = (0, 0)\n        self.outside_side = outside_side\n\n\ndef _loop_ok(mask):\n    \"\"\"Check that mask is a single 4-connected simple closed curve with exactly one hole.\"\"\"\n    _, n = label_mask(mask, connectivity=4)\n    if n != 1:\n        return False\n    # Vectorized degree check: each True pixel must have exactly 2 True 4-neighbors\n    deg = np.zeros_like(mask, dtype=int)\n    deg[1:, :] += mask[:-1, :]\n    deg[:-1, :] += mask[1:, :]\n    deg[:, 1:] += mask[:, :-1]\n    deg[:, :-1] += mask[:, 1:]\n    if not np.all(deg[mask] == 2):\n        return False\n    inv_lab, inv_n = label_mask(~mask, connectivity=4)\n    boundary = set(inv_lab[0, :]) | set(inv_lab[-1, :]) | set(inv_lab[:, 0]) | set(inv_lab[:, -1])\n    return sum(1 for k in range(1, inv_n + 1) if k not in boundary) == 1\n\n\ndef _step_mix(n_a, step_a, n_b, step_b):\n    \"\"\"Interleave n_a copies of step_a with n_b copies of step_b, biased toward alternation.\"\"\"\n    out = []\n    last = None\n    while n_a or n_b:\n        if n_a and n_b:\n            if last is not None and random.random() < STEP_MIX_ALT_PROB:\n                pick = \"b\" if last == \"a\" else \"a\"\n            else:\n                pick = \"a\" if random.random() < n_a / (n_a + n_b) else \"b\"\n        elif n_a:\n            pick = \"a\"\n        else:\n            pick = \"b\"\n        if pick == \"a\":\n            out.append(step_a)\n            n_a -= 1\n        else:\n            out.append(step_b)\n            n_b -= 1\n        last = pick\n    return out\n\n\ndef _add_line(path, end):\n    \"\"\"Extend path with a straight line from its last point to end.\"\"\"\n    r, c = path[-1]\n    er, ec = end\n    dr = 0 if er == r else (1 if er > r else -1)\n    dc = 0 if ec == c else (1 if ec > c else -1)\n    while (r, c) != (er, ec):\n        r += dr\n        c += dc\n        path.append((r, c))\n\n\ndef _add_steps(path, steps):\n    \"\"\"Extend path by applying a sequence of (dr, dc) deltas.\"\"\"\n    r, c = path[-1]\n    for dr, dc in steps:\n        r += dr\n        c += dc\n        path.append((r, c))\n\n\ndef _turn_ratio(path):\n    \"\"\"Fraction of direction changes along a cyclic path.\"\"\"\n    dirs = []\n    cyc = path + [path[0]]\n    for (r0, c0), (r1, c1) in zip(cyc, cyc[1:]):\n        dirs.append((r1 - r0, c1 - c0))\n    turns = sum(1 for a, b in zip(dirs, dirs[1:] + [dirs[0]]) if a != b)\n    return turns / len(path)\n\n\ndef _frame_mask(h, w):\n    \"\"\"Generate a wobbly simple closed curve mask of size (h, w).\"\"\"\n    max_dx = min(FRAME_CORNER_MAX, max(1, (w - 5) // 2))\n    max_dy = min(FRAME_CORNER_MAX, max(1, (h - 5) // 2))\n    lo, hi = FRAME_TURN_RATIO\n    for _ in range(FRAME_RETRIES):\n        tl_dx = random.randint(1, max_dx)\n        tr_dx = random.randint(1, max_dx)\n        br_dx = random.randint(1, max_dx)\n        bl_dx = random.randint(1, max_dx)\n        tl_dy = random.randint(1, max_dy)\n        tr_dy = random.randint(1, max_dy)\n        br_dy = random.randint(1, max_dy)\n        bl_dy = random.randint(1, max_dy)\n\n        p0 = (0, tl_dx)\n        p1 = (0, w - 1 - tr_dx)\n        p2 = (tr_dy, w - 1)\n        p3 = (h - 1 - br_dy, w - 1)\n        p4 = (h - 1, w - 1 - br_dx)\n        p5 = (h - 1, bl_dx)\n        p6 = (h - 1 - bl_dy, 0)\n        p7 = (tl_dy, 0)\n        if not (p1[1] - p0[1] >= FRAME_MIN_EDGE and p3[0] - p2[0] >= FRAME_MIN_EDGE\n                and p4[1] - p5[1] >= FRAME_MIN_EDGE and p6[0] - p7[0] >= FRAME_MIN_EDGE):\n            continue\n\n        path = [p0]\n        _add_line(path, p1)\n        _add_steps(path, _step_mix(tr_dy, (1, 0), tr_dx, (0, 1)))\n        _add_line(path, p3)\n        _add_steps(path, _step_mix(br_dy, (1, 0), br_dx, (0, -1)))\n        _add_line(path, p5)\n        _add_steps(path, _step_mix(bl_dy, (-1, 0), bl_dx, (0, -1)))\n        _add_line(path, p7)\n        _add_steps(path, _step_mix(tl_dy, (-1, 0), tl_dx, (0, 1)))\n        if path[-1] == path[0]:\n            path.pop()\n\n        coords = np.array(path, dtype=int)\n        mask = np.zeros((h, w), dtype=bool)\n        mask[coords[:, 0], coords[:, 1]] = True\n        ratio = _turn_ratio(path)\n        if lo <= ratio <= hi and _loop_ok(mask):\n            return mask\n    return None\n\n\ndef _blob_mask():\n    \"\"\"Generate a small filled blob mask (size 4-11, bbox 2x2 to 4x4).\"\"\"\n    size = random.randint(*BLOB_SIZE_RANGE)\n    feasible = [\n        (h, w)\n        for h in range(*BLOB_BBOX_RANGE)\n        for w in range(*BLOB_BBOX_RANGE)\n        if h * w >= size and h + w - 1 <= size\n    ]\n    h, w = random.choice(feasible)\n    rr = random.randrange(h)\n    cc = random.randrange(w)\n    cells = {(r, cc) for r in range(h)} | {(rr, c) for c in range(w)}\n    while len(cells) < size:\n        frontier = []\n        for r, c in cells:\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                p = (r + dr, c + dc)\n                if 0 <= p[0] < h and 0 <= p[1] < w and p not in cells:\n                    frontier.append(p)\n        cells.add(random.choice(frontier))\n    mask = np.zeros((h, w), dtype=bool)\n    pts = np.array(list(cells), dtype=int)\n    mask[pts[:, 0], pts[:, 1]] = True\n    return mask\n\n\ndef _arrange(children, compact=False):\n    \"\"\"Arrange children in a random layout (vertical, horizontal, or diagonal).\"\"\"\n    random.shuffle(children)\n    dims = [child.mask.shape for child in children]\n    k = len(children)\n    if k == 1:\n        return {children[0]: (0, 0)}, dims[0][0], dims[0][1]\n\n    mode = random.choice((\"vertical\", \"horizontal\", \"diagonal\"))\n    gap_lo, gap_hi = ARRANGE_GAP_COMPACT if compact else ARRANGE_GAP_NORMAL\n    gaps = [random.randint(gap_lo, gap_hi) for _ in range(k - 1)]\n    placements = {}\n\n    if mode == \"vertical\":\n        group_h = sum(h for h, _ in dims) + sum(gaps)\n        group_w = max(w for _, w in dims) + random.randint(*ARRANGE_EXTRA_SPAN)\n        r = 0\n        for child, (h, w), gap in zip(children, dims, gaps + [0]):\n            placements[child] = (r, random.randint(0, group_w - w))\n            r += h + gap\n        return placements, group_h, group_w\n\n    if mode == \"horizontal\":\n        group_h = max(h for h, _ in dims) + random.randint(*ARRANGE_EXTRA_SPAN)\n        group_w = sum(w for _, w in dims) + sum(gaps)\n        c = 0\n        for child, (h, w), gap in zip(children, dims, gaps + [0]):\n            placements[child] = (random.randint(0, group_h - h), c)\n            c += w + gap\n        return placements, group_h, group_w\n\n    # diagonal\n    group_h = sum(h for h, _ in dims) + sum(gaps)\n    group_w = sum(w for _, w in dims) + sum(gaps)\n    r = c = 0\n    for child, (h, w), gap in zip(children, dims, gaps + [0]):\n        placements[child] = (r, c)\n        r += h + gap\n        c += w + gap\n    return placements, group_h, group_w\n\n\ndef _prepare(node, compact=False):\n    \"\"\"Recursively build masks and place children within frames.\"\"\"\n    if node.kind == \"blob\":\n        node.mask = _blob_mask()\n        return True\n\n    for child in node.children:\n        if not _prepare(child, compact=child.kind == \"frame\"):\n            return False\n\n    has_frame_child = any(child.kind == \"frame\" for child in node.children)\n    tight = compact or has_frame_child\n    placements, group_h, group_w = _arrange(node.children, compact=tight)\n    margin = COMPACT_MARGIN if tight else random.randint(*FRAME_MARGIN_RANGE)\n    min_h = max(FRAME_H_RANGE[0], group_h + 2 * margin)\n    min_w = max(FRAME_W_RANGE[0], group_w + 2 * margin)\n    if min_h > FRAME_H_RANGE[1] or min_w > FRAME_W_RANGE[1]:\n        return False\n    h_hi = min(FRAME_H_RANGE[1], min_h + 2) if compact else FRAME_H_RANGE[1]\n    w_hi = min(FRAME_W_RANGE[1], min_w + 3) if compact else FRAME_W_RANGE[1]\n    h = random.randint(min_h, h_hi)\n    w = random.randint(min_w, w_hi)\n    top = margin + random.randint(0, h - 2 * margin - group_h)\n    left = margin + random.randint(0, w - 2 * margin - group_w)\n    for child, (r, c) in placements.items():\n        child.rel = (top + r, left + c)\n    node.mask = _frame_mask(h, w)\n    return node.mask is not None\n\n\ndef _walk(node, base=(0, 0)):\n    \"\"\"Flatten tree into list, computing absolute positions.\"\"\"\n    br, bc = base\n    rr, cc = node.rel\n    node.pos = (br + rr, bc + cc)\n    out = [node]\n    for child in node.children:\n        out.extend(_walk(child, node.pos))\n    return out\n\n\ndef _place_outside(root, outside):\n    \"\"\"Position an outside blob adjacent to the root frame.\"\"\"\n    assert root.mask is not None and outside.mask is not None\n    h, w = root.mask.shape\n    bh, bw = outside.mask.shape\n    gap = random.randint(*OUTSIDE_GAP_RANGE)\n    side = outside.outside_side\n    if side == \"right\":\n        outside.rel = (random.randint(1, h - bh - 1), w + gap)\n    elif side == \"left\":\n        outside.rel = (random.randint(1, h - bh - 1), -gap - bw)\n    elif side == \"bottom\":\n        outside.rel = (h + gap, random.randint(1, w - bw - 1))\n    else:\n        outside.rel = (-gap - bh, random.randint(1, w - bw - 1))\n\n\ndef _node_from_obj(obj):\n    \"\"\"Convert a generator _Obj (with absolute pos) to a solver _Node.\"\"\"\n    assert obj.mask is not None\n    r0, c0 = obj.pos\n    coords = np.argwhere(obj.mask) + np.array([r0, c0])\n    lo = coords.min(axis=0)\n    hi = coords.max(axis=0)\n    node = _Node(\n        coords=coords.astype(int),\n        bbox=(int(lo[0]), int(lo[1]), int(hi[0]), int(hi[1])),\n        center=coords.mean(axis=0),\n    )\n    node.is_frame = obj.kind == \"frame\"\n    return node\n\n\ndef _expected_output(root, outside, bg, fg):\n    \"\"\"Compute expected solver output for the generated tree.\"\"\"\n    def add(obj):\n        node = _node_from_obj(obj)\n        for child in obj.children:\n            child_node = add(child)\n            child_node.parent = node\n            node.children.append(child_node)\n        return node\n\n    roots = [add(root)]\n    if outside is not None:\n        roots.append(add(outside))\n    mask = _layout_root(roots)\n    out = np.full(mask.shape, bg, dtype=int)\n    out[mask] = fg\n    return out\n\n\ndef _make_tree():\n    \"\"\"Build a random containment tree (1-2 frames, 1-4 blobs, optional outside blob).\"\"\"\n    root = _Obj(\"frame\")\n    outside = None\n    sides = (\"left\", \"right\", \"top\", \"bottom\")\n    if random.random() < DEPTH1_PROB:\n        n_inside = random.randint(*DEPTH1_INSIDE_RANGE)\n        root.children = [_Obj(\"blob\") for _ in range(n_inside)]\n        if n_inside < MAX_TOTAL_CHILDREN and random.random() < OUTSIDE_BLOB_PROB:\n            outside = _Obj(\"blob\", outside_side=random.choice(sides))\n    else:\n        inner = _Obj(\"frame\")\n        inner.children = [_Obj(\"blob\") for _ in range(random.randint(*DEPTH2_INNER_BLOBS))]\n        outer_blobs = [_Obj(\"blob\") for _ in range(random.randint(*DEPTH2_OUTER_BLOBS))]\n        root.children = [inner] + outer_blobs\n        if len(inner.children) + len(outer_blobs) < MAX_TOTAL_CHILDREN and random.random() < OUTSIDE_BLOB_PROB:\n            outside = _Obj(\"blob\", outside_side=random.choice(sides))\n    return root, outside\n\n\ndef _draw(objects, bg, fg):\n    \"\"\"Render all objects onto a padded grid. Returns None if size constraints fail.\"\"\"\n    min_r = min(obj.pos[0] for obj in objects)\n    min_c = min(obj.pos[1] for obj in objects)\n    max_r = max(obj.pos[0] + obj.mask.shape[0] for obj in objects)\n    max_c = max(obj.pos[1] + obj.mask.shape[1] for obj in objects)\n    draw_h = max_r - min_r\n    draw_w = max_c - min_c\n    if draw_h > GRID_MAX or draw_w > GRID_MAX:\n        return None\n\n    extra_h_min = max(0, GRID_MIN - draw_h)\n    extra_w_min = max(0, GRID_MIN - draw_w)\n    extra_h_max = min(MAX_EXTRA_PAD, GRID_MAX - draw_h)\n    extra_w_max = min(MAX_EXTRA_PAD, GRID_MAX - draw_w)\n    if extra_h_min > extra_h_max or extra_w_min > extra_w_max:\n        return None\n    extra_h = random.randint(extra_h_min, extra_h_max)\n    extra_w = random.randint(extra_w_min, extra_w_max)\n    top_pad = random.randint(max(0, extra_h - MAX_PAD_PER_SIDE), min(MAX_PAD_PER_SIDE, extra_h))\n    left_pad = random.randint(max(0, extra_w - MAX_PAD_PER_SIDE), min(MAX_PAD_PER_SIDE, extra_w))\n    shift_r = top_pad - min_r\n    shift_c = left_pad - min_c\n\n    grid = np.full((draw_h + extra_h, draw_w + extra_w), bg, dtype=int)\n    for obj in objects:\n        assert obj.mask is not None\n        r = obj.pos[0] + shift_r\n        c = obj.pos[1] + shift_c\n        obj.pos = (r, c)\n        patch = np.full(obj.mask.shape, bg, dtype=int)\n        patch[obj.mask] = fg\n        paste(grid, patch, r, c, transparent=bg)\n    if np.count_nonzero(grid == bg) <= np.count_nonzero(grid == fg):\n        return None\n    return grid\n\n\ndef _gen_attempt():\n    \"\"\"Single generation attempt: build tree, render input, verify against solver.\"\"\"\n    bg, fg = random.sample(range(10), 2)\n    root, outside = _make_tree()\n    if not _prepare(root):\n        return None\n    if outside is not None:\n        if not _prepare(outside):\n            return None\n        _place_outside(root, outside)\n\n    objects = _walk(root)\n    if outside is not None:\n        outside.pos = outside.rel\n        objects.append(outside)\n\n    grid = _draw(objects, bg, fg)\n    if grid is None:\n        return None\n    expected = _expected_output(root, outside, bg, fg)\n    try:\n        got = main(grid)\n    except Exception:\n        return None\n    if not np.array_equal(got, expected):\n        return None\n    return grid\n\n\ndef generate_input():\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Predict the next panel in a framed sequence by continuing each scheduled colored interval.\n\n    Input structure\n    - The grid is made from three or more equal panels in one row or one column.\n    - The final input panel is the static target template; every earlier panel differs from it only by dynamic colors absent from the template.\n    - Each dynamic color appears in a regular temporal schedule across the earlier panels.\n\n    Rule\n    - Keep the final template panel as the output canvas.\n    - For every dynamic color whose schedule reaches the next panel, compare its last two appearances.\n    - Extrapolate each one-dimensional interval along the color's changing row or column axis and paint that predicted mask.\n\n    Key insight\n    - The task is not asking for the last visible panel, but for the next frame after the blank/template slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    panels, diff_colors = _split_panels(g)\n    template = panels[-1]\n    prior = panels[:-1]\n    next_time = len(prior)\n\n    predictions: list[tuple[int, np.ndarray]] = []\n    for color in diff_colors:\n        times = [i for i, panel in enumerate(prior) if np.any(panel == color)]\n        assert len(times) >= 2\n        gaps = [b - a for a, b in zip(times, times[1:])]\n        assert len(set(gaps)) == 1\n        period = gaps[0]\n        if next_time - times[-1] != period:\n            continue\n\n        previous = prior[times[-2]] == color\n        current = prior[times[-1]] == color\n        predictions.append((color, _extrapolate_mask(previous, current)))\n\n    assert predictions\n    occupied = np.zeros_like(template, dtype=bool)\n    for _color, mask in predictions:\n        assert not np.any(occupied & mask)\n        occupied |= mask\n\n    out = template.copy()\n    for color, mask in predictions:\n        out[mask] = color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, orientation, and color sampling.\nPANEL_SIZE_MIN, PANEL_SIZE_MAX = 5, 11\nPANEL_COUNT_CHOICES, ORIENTATION_CHOICES = (3, 5), (False, True)\nCOLOR_POOL, TOTAL_COLOR_CHOICES, MOTION_AXIS_CHOICES = range(10), (4, 5), (0, 1)\n\n# Template decoration density and symmetry.\nTEMPLATE_MIN_DECO_CELLS = 4\nTEMPLATE_DECO_MIN_RATIO, TEMPLATE_DECO_MAX_RATIO = 0.10, 0.30\n\n# Blob motif and growth bounds.\nBLOB_GROWTH_MIN, BLOB_GROWTH_MAX = 1, 4\nBLOB_MAX_INITIAL_CELLS, BLOB_MAX_COMPONENTS = 7, 2\nBLOB_MAX_LINE_COUNT, BLOB_MAX_WIDTH = 3, 3\nBLOB_DIRECTIONS = (-1, 1)\n\n# Dynamic-color schedules.\nSHORT_PRIOR_COUNT, MAX_DYNAMIC_COLORS = 2, 3\nSCHEDULE_ALWAYS_2 = {\"period\": 1, \"times\": [0, 1], \"scheduled\": True}\nSCHEDULE_ALWAYS_4 = {\"period\": 1, \"times\": [0, 1, 2, 3], \"scheduled\": True}\nSCHEDULE_EVEN_4 = {\"period\": 2, \"times\": [0, 2], \"scheduled\": True}\nSCHEDULE_FIRST3_4 = {\"period\": 1, \"times\": [0, 1, 2], \"scheduled\": False}\nSCHEDULE_ODD_4 = {\"period\": 2, \"times\": [1, 3], \"scheduled\": False}\nSCHEDULE_SECOND_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4)\nSCHEDULE_THIRD_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4, SCHEDULE_FIRST3_4, SCHEDULE_ODD_4)\n\n# Placement and retry limits.\nMASK_TRANSPARENT, PLACEMENT_BORDER = 0, 1\nGENERATION_RETRIES = 300\n\ndef _sym_orbits(h: int, w: int) -> list[list[tuple[int, int]]]:\n    seen: set[tuple[int, int]] = set()\n    orbits: list[list[tuple[int, int]]] = []\n    for r in range(h):\n        for c in range(w):\n            if r not in (0, h - 1) and c not in (0, w - 1):\n                continue\n            if (r, c) in seen:\n                continue\n            orbit = sorted({(r, c), (r, w - 1 - c), (h - 1 - r, c), (h - 1 - r, w - 1 - c)})\n            seen.update(orbit)\n            orbits.append(orbit)\n    return orbits\n\n\ndef _make_template(h: int, w: int, bg: int, deco: int) -> np.ndarray:\n    out = np.full((h, w), bg, dtype=int)\n    area = h * w\n    min_deco = max(TEMPLATE_MIN_DECO_CELLS, int(np.ceil(area * TEMPLATE_DECO_MIN_RATIO)))\n    max_deco = max(min_deco, int(np.floor(area * TEMPLATE_DECO_MAX_RATIO)))\n    target = random.randint(min_deco, max_deco)\n    orbits = _sym_orbits(h, w)\n    random.shuffle(orbits)\n    count = 0\n    for orbit in orbits:\n        if count >= target:\n            break\n        if count + len(orbit) > max_deco and count >= min_deco:\n            continue\n        for r, c in orbit:\n            out[r, c] = deco\n        count += len(orbit)\n    return out\n\n\ndef _base_patterns(axis_len: int, line_len: int, max_back: int) -> list[tuple[int, list[list[tuple[int, int]]]]]:\n    patterns: list[tuple[int, list[list[tuple[int, int]]]]] = []\n    for growth in range(BLOB_GROWTH_MIN, BLOB_GROWTH_MAX + 1):\n        extra = max_back * growth\n        max_initial_width = axis_len - extra\n        if max_initial_width < 1:\n            continue\n\n        for lines in range(1, min(BLOB_MAX_LINE_COUNT, line_len) + 1):\n            for width in range(1, min(BLOB_MAX_WIDTH, max_initial_width, BLOB_MAX_INITIAL_CELLS // lines) + 1):\n                patterns.append((growth, [[(0, width - 1)] for _ in range(lines)]))\n\n        if line_len >= 2 and max_initial_width >= 2:\n            for lines in range(2, min(BLOB_MAX_LINE_COUNT + 1, line_len) + 1):\n                width = min(2, max_initial_width)\n                if lines * width <= BLOB_MAX_INITIAL_CELLS and width + 1 + extra <= axis_len:\n                    patterns.append((growth, [[(i % 2, i % 2 + width - 1)] for i in range(lines)]))\n\n        if line_len >= 3 and max_initial_width >= 3:\n            tee = [[(1, 1)], [(0, 2)], [(1, 1)]]\n            if 3 + extra <= axis_len:\n                patterns.append((growth, tee))\n\n        if line_len >= 2:\n            gap = extra + 1\n            if gap + 2 + extra <= axis_len:\n                for lines in range(2, min(BLOB_MAX_LINE_COUNT, line_len) + 1):\n                    split = [[(0, 0), (gap + 1, gap + 1)] for _ in range(lines)]\n                    if 2 * lines <= BLOB_MAX_INITIAL_CELLS:\n                        patterns.append((growth, split))\n    return patterns\n\n\ndef _draw_local(\n    intervals0: list[list[tuple[int, int]]],\n    growth: int,\n    max_back: int,\n    back: int,\n    direction: int,\n    axis: int,\n) -> np.ndarray:\n    grown = max_back - back\n    width = max(end for row in intervals0 for _start, end in row) + max_back * growth + 1\n    local = np.zeros((len(intervals0), width), dtype=bool)\n    for r, row in enumerate(intervals0):\n        for start, end in row:\n            local[r, start : end + grown * growth + 1] = True\n    if direction < 0:\n        local = np.fliplr(local)\n    if axis == 0:\n        local = local.T\n    return local\n\n\ndef _make_blob(axis_len: int, line_len: int, axis: int, max_back: int) -> tuple[int, dict[int, np.ndarray]] | None:\n    patterns = _base_patterns(axis_len, line_len, max_back)\n    if not patterns:\n        return None\n    by_growth: dict[int, list[list[list[tuple[int, int]]]]] = {}\n    for growth, intervals0 in patterns:\n        by_growth.setdefault(growth, []).append(intervals0)\n    growth = random.choice(sorted(by_growth))\n    intervals0 = random.choice(by_growth[growth])\n    direction = random.choice(BLOB_DIRECTIONS)\n    masks = {\n        back: _draw_local(intervals0, growth, max_back, back, direction, axis)\n        for back in range(max_back + 1)\n    }\n    largest = masks[0]\n    if largest.shape[0] > (line_len if axis == 1 else axis_len):\n        return None\n    if largest.shape[1] > (axis_len if axis == 1 else line_len):\n        return None\n    if len(components_mask(masks[max_back], connectivity=4)) > BLOB_MAX_COMPONENTS:\n        return None\n    return growth, masks\n\n\ndef _schedules(n_prior: int, n_colors: int) -> list[dict]:\n    if n_prior == SHORT_PRIOR_COUNT:\n        return [SCHEDULE_ALWAYS_2 for _ in range(n_colors)]\n\n    schedules = [SCHEDULE_ALWAYS_4, random.choice(SCHEDULE_SECOND_CHOICES)]\n    if n_colors == MAX_DYNAMIC_COLORS:\n        schedules.append(random.choice(SCHEDULE_THIRD_CHOICES))\n    return schedules\n\n\ndef _place_masks(\n    occupied: np.ndarray,\n    local_masks: dict[int, np.ndarray],\n) -> dict[int, np.ndarray] | None:\n    largest = local_masks[0]\n    patch = np.where(largest, 1, MASK_TRANSPARENT)\n    try:\n        r0, c0 = random_free_location(\n            occupied, patch, transparent=MASK_TRANSPARENT, border=PLACEMENT_BORDER\n        )\n    except ValueError:\n        return None\n    paste(occupied, patch, r0, c0, transparent=MASK_TRANSPARENT)\n\n    out: dict[int, np.ndarray] = {}\n    for back, local in local_masks.items():\n        full = np.zeros_like(occupied, dtype=bool)\n        full[r0 : r0 + local.shape[0], c0 : c0 + local.shape[1]] = local\n        out[back] = full\n    return out\n\n\ndef _place_dynamic_masks(\n    occupied: np.ndarray,\n    n_dynamic: int,\n    schedules: list[dict],\n    motion_axis: int,\n    n_prior: int,\n    axis_len: int,\n    line_len: int,\n) -> dict[int, dict[int, np.ndarray]] | None:\n    \"\"\"Return full-panel masks by color index, or None if any blob fails.\"\"\"\n    order = list(range(n_dynamic))\n    random.shuffle(order)\n    placed: dict[int, dict[int, np.ndarray]] = {}\n    for idx in order:\n        sched = schedules[idx]\n        if sched[\"scheduled\"]:\n            max_back = max((n_prior - t) // sched[\"period\"] for t in sched[\"times\"])\n        else:\n            last = sched[\"times\"][-1]\n            max_back = max((last - t) // sched[\"period\"] for t in sched[\"times\"])\n\n        blob = _make_blob(axis_len, line_len, motion_axis, max_back)\n        if blob is None:\n            return None\n        _growth, local_masks = blob\n        full_masks = _place_masks(occupied, local_masks)\n        if full_masks is None:\n            return None\n        placed[idx] = full_masks\n    return placed\n\n\ndef _paint_dynamic_masks(\n    panels: list[np.ndarray],\n    output: np.ndarray,\n    dynamic: list[int],\n    schedules: list[dict],\n    placed: dict[int, dict[int, np.ndarray]],\n    n_prior: int,\n) -> None:\n    \"\"\"Mutate prior panels and output with the preplaced dynamic-color masks.\"\"\"\n    for idx, color in enumerate(dynamic):\n        sched = schedules[idx]\n        full_masks = placed[idx]\n        if sched[\"scheduled\"]:\n            for t in sched[\"times\"]:\n                back = (n_prior - t) // sched[\"period\"]\n                panels[t][full_masks[back]] = color\n            output[full_masks[0]] = color\n        else:\n            last = sched[\"times\"][-1]\n            for t in sched[\"times\"]:\n                back = (last - t) // sched[\"period\"]\n                panels[t][full_masks[back]] = color\n\n\ndef _assemble_valid_input(\n    panels: list[np.ndarray],\n    template: np.ndarray,\n    output: np.ndarray,\n    horizontal: bool,\n) -> np.ndarray | None:\n    \"\"\"Return tiled input only when the solver oracle matches planned output.\"\"\"\n    if horizontal:\n        inp = np.concatenate([*panels, template], axis=1)\n    else:\n        inp = np.concatenate([*panels, template], axis=0)\n\n    try:\n        predicted = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(predicted, output):\n        return None\n    return inp\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    h = random.randint(PANEL_SIZE_MIN, PANEL_SIZE_MAX)\n    w = random.randint(PANEL_SIZE_MIN, PANEL_SIZE_MAX)\n    horizontal = random.choice(ORIENTATION_CHOICES)\n    n_panels = random.choice(PANEL_COUNT_CHOICES)\n    n_prior = n_panels - 1\n\n    colors = random.sample(COLOR_POOL, random.choice(TOTAL_COLOR_CHOICES))\n    bg, deco = colors[0], colors[1]\n    dynamic = colors[2:]\n\n    template = _make_template(h, w, bg, deco)\n    occupied = np.where(template == bg, MASK_TRANSPARENT, 1)\n    motion_axis = random.choice(MOTION_AXIS_CHOICES)\n    schedules = _schedules(n_prior, len(dynamic))\n\n    panels = [template.copy() for _ in range(n_prior)]\n    output = template.copy()\n    axis_len = h - 2 if motion_axis == 0 else w - 2\n    line_len = w - 2 if motion_axis == 0 else h - 2\n\n    placed = _place_dynamic_masks(\n        occupied, len(dynamic), schedules, motion_axis, n_prior, axis_len, line_len\n    )\n    if placed is None:\n        return None\n    _paint_dynamic_masks(panels, output, dynamic, schedules, placed, n_prior)\n    return _assemble_valid_input(panels, template, output, horizontal)\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
