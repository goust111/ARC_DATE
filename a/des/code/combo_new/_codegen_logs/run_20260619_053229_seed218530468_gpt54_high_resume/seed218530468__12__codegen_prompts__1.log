{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/f931b4a8.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count the two upper quadrant control regions to size an output made from the lower quadrant pattern.\n\n    Input structure:\n    - The grid is an even square split into four equal quadrants.\n    - Black is the background.\n    - The upper-left and upper-right quadrants are control regions.\n    - The lower-left quadrant is a color source tile; the lower-right quadrant is either a stencil tile or empty.\n\n    Rule:\n    - Output height is the number of non-background pixels in the upper-left quadrant.\n    - Output width is the number of non-background pixels in the upper-right quadrant.\n    - If the lower-right stencil has foreground pixels, tile it over the output; each stencil background pixel is filled from the lower-left quadrant cell at the corresponding coarse tile position.\n    - If the lower-right stencil is empty, tile the lower-left quadrant directly over the output.\n\n    Key insight:\n    - The top quadrants specify only dimensions, while the bottom quadrants specify a two-level repeated pattern: a fine stencil and coarse fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h == w and h % 2 == 0 and w % 2 == 0\n\n    bg = int(Color.BLACK)\n    qh, qw = h // 2, w // 2\n    upper_left = g[:qh, :qw]\n    upper_right = g[:qh, qw:]\n    fill_tile = g[qh:, :qw]\n    stencil = g[qh:, qw:]\n\n    out_h = int(np.count_nonzero(upper_left != bg))\n    out_w = int(np.count_nonzero(upper_right != bg))\n    assert out_h > 0 and out_w > 0\n\n    out = np.empty((out_h, out_w), dtype=int)\n    if not np.any(stencil != bg):\n        for r in range(out_h):\n            for c in range(out_w):\n                value = int(fill_tile[r % qh, c % qw])\n                assert value != bg\n                out[r, c] = value\n        return out\n\n    for r in range(out_h):\n        for c in range(out_w):\n            value = int(stencil[r % qh, c % qw])\n            if value == bg:\n                fill_r = r // qh\n                fill_c = c // qw\n                assert fill_r < qh and fill_c < qw\n                value = int(fill_tile[fill_r, fill_c])\n                assert value != bg\n            out[r, c] = value\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom math import ceil\n\n# ── configuration constants ──────────────────────────────────────────\nBLACK = 0\nCOLORS = tuple(range(1, 10))\n\nGRID_SIZES = (4, 8, 16)                # allowed input grid side-lengths N\nSTENCIL_EMPTY_PROB = 0.16               # chance lower-right is all-black\nLL_SOLID_PROB = 0.70                    # chance fill tile is single-color\nLL_MULTI_COLOR_RANGE = (2, 3)           # color count when fill tile is multi-color\nSTENCIL_SINGLE_COLOR_PROB = 0.75        # chance stencil uses one fg color\nSTENCIL_MULTI_COLOR_RANGE = (2, 4)      # color count when stencil is multi-color\nSTENCIL_FG_FRAC = (0.30, 0.75)          # fg fraction range for random stencil mode\nSTENCIL_FRAME_MIN_Q = 4                 # min quadrant size to allow frame stencil\nCONTROL_SINGLE_COLOR_PROB = 0.85        # chance control quadrant uses one color\nCONTROL_RECT_PROB = 0.85                # chance control pixels form an axis-aligned rect\nUL_MAX_COLORS = 3                       # max distinct colors in upper-left control\nUR_MAX_COLORS = 2                       # max distinct colors in upper-right control\nOUTPUT_DIM_MIN = 3                      # minimum output height/width\nOUTPUT_DIM_MAX = 16                     # maximum output height/width\nOUTPUT_AREA_MAX = 256                   # maximum output area\nGEN_MAX_RETRIES = 300                   # retry budget for generate_input\n\n\n# ── palette helpers ──────────────────────────────────────────────────\n\ndef _palette(k: int, pool=COLORS) -> list[int]:\n","exit_code":0,"status":"completed"}}
