{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nfrom collections import Counter\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed218530468/8/4.py')\nmod = SourceFileLoader('arc_semantic_check', str(p)).load_module()\n\nfor t in range(200):\n    inp = mod.generate_input()\n    out = mod.main(inp)\n\n    line = mod._line_color(inp)\n    rows = np.flatnonzero(np.all(inp == line, axis=1))\n    cols = np.flatnonzero(np.all(inp == line, axis=0))\n    sep_idx = [i for i, d in enumerate(np.diff(cols)) if d == 1][0]\n    row_slices = [(rows[i] + 1, rows[i + 1]) for i in range(len(rows) - 1)]\n    main_cols = [(cols[i] + 1, cols[i + 1]) for i in range(sep_idx)]\n    legend = (cols[sep_idx + 1] + 1, cols[sep_idx + 2])\n\n    vals = []\n    for r0, r1 in row_slices:\n        for c0, c1 in main_cols:\n            vals.extend(map(int, inp[r0:r1, c0:c1].ravel()))\n    bg = Counter(vals).most_common(1)[0][0]\n    signal = [c for c in Counter(vals) if c \"'!= bg][0]\n\n    mapping = {}\n    for r0, r1 in row_slices:\n        patch = inp[r0:r1, legend[0]:legend[1]]\n        n = int(np.count_nonzero(patch == signal))\n        if n:\n            mapping[n] = patch.copy()\n    assert set(mapping) == {1,2,3}\n\n    for r0, r1 in row_slices:\n        assert np.all(out[r0:r1, legend[0]:legend[1]] == bg)\n        for c0, c1 in main_cols:\n            patch_in = inp[r0:r1, c0:c1]\n            patch_out = out[r0:r1, c0:c1]\n            n = int(np.count_nonzero(patch_in == signal))\n            if n == 0:\n                assert np.array_equal(patch_in, patch_out)\n            else:\n                assert np.array_equal(patch_out, mapping[n])\nprint('\"'semantic_ok', 200)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
