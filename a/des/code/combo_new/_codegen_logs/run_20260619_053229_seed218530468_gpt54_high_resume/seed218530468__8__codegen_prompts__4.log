{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '35,170p;213,360p' /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py && printf '\\\\n=====\\\\n' && sed -n '50,210p;275,420p' /home/lixinyu/snap/new/ARC_code/train/278e5215.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the one blank in each corner region so all four regions have the same color multiset.\n\n    Input structure:\n    - The dominant background color forms one solid separator row and one solid\n      separator column.\n    - The separator cross splits the grid into four equal rectangular corner regions.\n    - Each corner region contains exactly one background-colored blank pixel.\n\n    Rule:\n    - Count the non-background colors in each corner region.\n    - The completed region multiset is defined by the maximum observed count of\n      each color across the four regions.\n    - Replace each region's blank pixel with the single color needed to match that\n      completed multiset.\n\n    Key insight:\n    - The separator color inside a corner region is a missing value marker; comparing\n      the four regions reveals the shared multiset without using numeric color order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    color_counts = Counter(map(int, g.reshape(-1)))\n    assert all(\n        color == bg or count < color_counts[bg] for color, count in color_counts.items()\n    ), \"background color must be uniquely dominant\"\n\n    cross_row, cross_col = _solid_separator_cross(g, bg)\n    regions = _quadrants(cross_row, cross_col, height, width)\n    region_shape = g[regions[0]].shape\n    region_area = int(np.prod(region_shape))\n\n    counts_by_region: list[Counter[int]] = []\n    blank_positions: list[tuple[int, int]] = []\n    for row_slice, col_slice in regions:\n        region = g[row_slice, col_slice]\n        assert region.shape == region_shape, \"all corner regions must have the same shape\"\n        blanks = np.argwhere(region == bg)\n        assert len(blanks) == 1, \"each corner region must have exactly one blank\"\n\n        counts_by_region.append(Counter(map(int, region[region != bg].reshape(-1))))\n        local_r, local_c = map(int, blanks[0])\n        blank_positions.append((row_slice.start + local_r, col_slice.start + local_c))\n\n    target_counts: Counter[int] = Counter()\n    for counts in counts_by_region:\n        for color, count in counts.items():\n            target_counts[color] = max(target_counts[color], count)\n    assert sum(target_counts.values()) == region_area, \"completed region multiset must be unique\"\n\n    out = g.copy()\n    for counts, (row, col) in zip(counts_by_region, blank_positions):\n        missing = target_counts - counts\n        assert len(missing) == 1, \"each blank must have exactly one matching fill color\"\n        fill_color, fill_count = next(iter(missing.items()))\n        assert fill_count == 1, \"each corner region must need one pixel of the fill color\"\n        out[row, col] = fill_color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n# Canvas/palette bounds.\nGRID_HALF_MIN = 2\nGRID_HALF_MAX = 6\nCOLOR_COUNT = 10\nMIN_TARGET_COLORS = 3\nMAX_NON_BG_COLORS = COLOR_COUNT - 1\n# Layout probabilities and constraints.\nPREFERRED_GRID_HALF = (2, 2)\nPREFERRED_GRID_PROB = 0.65\nQUADRANT_COUNT = 4\nSEPARATOR_WIDTH = 1\nBG_DOMINANCE_MARGIN = 1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _gen_bounded_composition(total: int, parts: int, max_each: int) -> list[int] | None:\n    if parts <= 0 or total < parts or total > parts * max_each:\n        return None\n\n    counts = []\n    remaining = total\n    for i in range(parts):\n        slots_left = parts - i - 1\n        lo = max(1, remaining - slots_left * max_each)\n        hi = min(max_each, remaining - slots_left)\n        counts.append(random.randint(lo, hi))\n        remaining -= counts[-1]\n\n    random.shuffle(counts)\n    return counts\n\n\ndef _gen_grid_options() -> list[tuple[int, int, list[int], int]]:\n    options = []\n    for k in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n        for m in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n            area = k * m\n            bg_count = 2 * k + 2 * m + SEPARATOR_WIDTH + QUADRANT_COUNT\n            max_target_count = (bg_count - BG_DOMINANCE_MARGIN) // QUADRANT_COUNT\n            max_colors = min(MAX_NON_BG_COLORS, area)\n            valid_counts = [\n                c\n                for c in range(MIN_TARGET_COLORS, max_colors + 1)\n                if area <= c * max_target_count\n            ]\n            if valid_counts:\n                options.append((k, m, valid_counts, max_target_count))\n    return options\n\n\ndef _gen_pick_grid_option() -> tuple[int, int, list[int], int]:\n    options = _gen_grid_options()\n    if random.random() < PREFERRED_GRID_PROB:\n        preferred_k, preferred_m = PREFERRED_GRID_HALF\n        for option in options:\n            if option[0] == preferred_k and option[1] == preferred_m:\n                return option\n    return random.choice(options)\n\n\ndef _gen_quadrant_offsets(k: int, m: int) -> list[tuple[int, int]]:\n    sep = SEPARATOR_WIDTH\n    return [(0, 0), (0, m + sep), (k + sep, 0), (k + sep, m + sep)]\n\n\ndef _gen_missing_colors(non_bg_colors: list[int]) -> list[int]:\n    missing_colors = [random.choice(non_bg_colors) for _ in range(QUADRANT_COUNT)]\n    if len(set(missing_colors)) == 1:\n        alternatives = [c for c in non_bg_colors if c != missing_colors[0]]\n        missing_colors[-1] = random.choice(alternatives)\n    return missing_colors\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid e3fe1151 input\")\n\n=====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the large mask crop column-by-column using the separate three-row palette strip.\n\n    Input structure:\n    - The background is the most common color.\n    - One large monochrome foreground object is the mask; its bbox is the output region and may contain background holes.\n    - The remaining foreground is a 3-row palette rectangle with the same width as the mask bbox: two identical color rows and one uniform row.\n\n    Rule:\n    - Crop to the mask object's bbox.\n    - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n    - Replace background holes inside the crop with the palette's uniform third-row color.\n\n    Key insight:\n    The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    mask_color = _unique_largest_non_bg_color(g, bg)\n\n    b = _mask_bbox(g, mask_color)\n    mask_crop = crop_bbox(g == int(mask_color), b)\n    height, width = map(int, mask_crop.shape)\n\n    column_colors, hole_color = _palette(g, bg, mask_color, width)\n    out = np.tile(column_colors, (height, 1))\n    out[~mask_crop] = hole_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, colors, and object bounds.\nBACKGROUND_COLOR, MASK_COLOR = 0, 5\nCOLOR_MIN, COLOR_MAX = 1, 9\nGRID_SIDE_MIN, GRID_SIDE_MAX = 10, 18\nMASK_SIDE_MIN, MASK_SIDE_MAX = 5, 10\nPALETTE_HEIGHT = 3\nGAP_MIN, GAP_MAX = 1, 3\n\n# Palette run construction.\nRUN_COUNT_OPTIONS = (4, 5)\nRUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3\nCOLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5\nUNUSED_COLOR_BIAS = 0.7\n\n# Mask density and retry budget.\nMASK_DENSITY_MIN, MASK_DENSITY_MAX = 0.60, 0.71\nGENERATION_ATTEMPTS = 300\n\n\ndef _valid_run_lengths(width: int, n_runs: int) -> list[tuple[int, ...]]:\n    length_range = range(RUN_LENGTH_MIN, RUN_LENGTH_MAX + 1)\n    return [\n        tuple(int(x) for x in lengths)\n        for lengths in product(length_range, repeat=int(n_runs))\n        if sum(lengths) == int(width)\n    ]\n\n\ndef _run_colors(colors: list[int], n_runs: int) -> list[int]:\n    seq: list[int] = []\n    unused = set(colors)\n    for i in range(int(n_runs)):\n        slots_left = int(n_runs) - i\n        choices = [c for c in colors if not seq or c != seq[-1]]\n        if len(unused) >= slots_left:\n            choices = [c for c in choices if c in unused]\n        elif unused and random.random() < UNUSED_COLOR_BIAS:\n            preferred = [c for c in choices if c in unused]\n            if preferred:\n                choices = preferred\n        color = random.choice(choices)\n        seq.append(int(color))\n        unused.discard(int(color))\n    return seq\n\n\ndef _palette_row(width: int, colors: list[int]) -> np.ndarray:\n    valid_counts = [\n        n_runs for n_runs in RUN_COUNT_OPTIONS if _valid_run_lengths(int(width), n_runs)\n    ]\n    n_runs = random.choice(valid_counts)\n    valid_lengths = _valid_run_lengths(int(width), n_runs)\n    lengths = random.choice(valid_lengths)\n    n_distinct = random.randint(\n        COLUMN_COLOR_DISTINCT_MIN, min(COLUMN_COLOR_DISTINCT_MAX, n_runs)\n    )\n    chosen = random.sample(colors, n_distinct)\n    seq = _run_colors(chosen, n_runs)\n    return np.repeat(seq, lengths).astype(int)\n\n\ndef _neighbors4(r: int, c: int, h: int, w: int):\n    if r > 0:\n        yield r - 1, c\n    if r + 1 < h:\n        yield r + 1, c\n    if c > 0:\n        yield r, c - 1\n    if c + 1 < w:\n        yield r, c + 1\n\n\ndef _connected_mask(height: int, width: int, target_area: int) -> np.ndarray | None:\n    \"\"\"Grow a connected mask with full row/column span to the target area.\"\"\"\n    mask = np.zeros((int(height), int(width)), dtype=bool)\n    steps = [\"D\"] * (int(height) - 1) + [\"R\"] * (int(width) - 1)\n    random.shuffle(steps)\n\n    r = c = 0\n    mask[r, c] = True\n    for step in steps:\n        if step == \"D\":\n            r += 1\n        else:\n            c += 1\n        mask[r, c] = True\n\n    if int(mask.sum()) > int(target_area):\n        return None\n\n    frontier: set[tuple[int, int]] = set()\n\n    def add_frontier(rr: int, cc: int) -> None:\n        for nr, nc in _neighbors4(rr, cc, int(height), int(width)):\n            if not mask[nr, nc]:\n                frontier.add((int(nr), int(nc)))\n\n    for rr, cc in np.argwhere(mask):\n        add_frontier(int(rr), int(cc))\n\n    while int(mask.sum()) < int(target_area):\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        rr, cc = cell\n        mask[rr, cc] = True\n        add_frontier(rr, cc)\n\n    return mask\n\n\ndef _grid_choices(mask_h: int, mask_w: int, gap: int) -> list[tuple[int, int]]:\n    \"\"\"Grid sizes where the mask remains the unique largest non-bg object.\"\"\"\n    max_mask = int(np.floor(MASK_DENSITY_MAX * int(mask_h) * int(mask_w)))\n    min_h = max(GRID_SIDE_MIN, int(mask_h) + PALETTE_HEIGHT + int(gap))\n    min_w = max(GRID_SIDE_MIN, int(mask_w))\n    choices: list[tuple[int, int]] = []\n    for h in range(min_h, GRID_SIDE_MAX + 1):\n        for w in range(min_w, GRID_SIDE_MAX + 1):\n            if h * w - max_mask - PALETTE_HEIGHT * int(mask_w) > max_mask:\n                choices.append((h, w))\n    return choices\n\n\ndef _sample_dimensions() -> tuple[int, int, int, int, int] | None:\n    \"\"\"Sample mask size, layout gap, and compatible grid size.\"\"\"\n    mask_h = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)\n    mask_w = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
