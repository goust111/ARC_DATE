{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '22,120p;140,280p' /home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py && printf '\\\\n=====\\\\n' && sed -n '32,140p;150,300p' /home/lixinyu/snap/new/ARC_code/train/37ce87bb.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor each placeholder object according to its normalized shape while leaving the background fixed.\n\n    Input structure\n    A same-size grid with one dominant background color and one foreground\n    placeholder color forming separated 4-connected objects.\n\n    Rule\n    Replace every placeholder object by the color assigned to its exact\n    translation-normalized mask; all background pixels remain unchanged.\n\n    Key insight\n    The input objects are a shape legend with repeated instances: identical\n    masks always receive identical colors, independent of their position.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n\n    out = g.copy()\n    comps = find_components(\n        g,\n        bg=bg,\n        colors=[fg_colors[0]],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert comps\n    for comp in comps:\n        coords = comp[\"coords\"]\n        shape = _shape_signature(coords)\n        assert shape in SHAPE_TO_COLOR\n        out[tuple(coords.T)] = SHAPE_TO_COLOR[shape]\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and colors.\nGRID_H = 9\nGRID_W = 9\nBG_COLOR = 7\nFG_COLOR = 6\n\n# Object count and retry limits.\nMIN_OBJECTS = 6\nMAX_OBJECTS_EXCLUSIVE = 9\nGENERATION_RETRIES = 300\nRESERVED_PADDING = 1\n\n# Canonical shapes: (cells, height, width), in the same order used for duplicates.\nSHAPES = [\n    (((0, 0), (0, 1), (1, 1)), 2, 2),  # L-triomino -> 4\n    (((0, 0), (0, 1), (1, 1), (1, 2)), 2, 3),  # S-tetromino -> 8\n    (((0, 1), (1, 0), (1, 1), (1, 2), (2, 1)), 3, 3),  # plus -> 3\n    (((0, 0), (1, 0), (2, 0)), 3, 1),  # vertical-3 -> 2\n    (((0, 0), (1, 0)), 2, 1),  # domino -> 9\n    (((0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (1, 2)), 2, 3),  # 2x3 rect -> 5\n]\n\n\ndef _choose_shape_indices(rng):\n    \"\"\"Return all six shape ids plus 0-2 duplicate ids, then shuffle them.\"\"\"\n    num_objects = rng.integers(MIN_OBJECTS, MAX_OBJECTS_EXCLUSIVE)\n    shape_indices = list(range(len(SHAPES)))\n    num_duplicates = num_objects - len(SHAPES)\n    if num_duplicates > 0:\n        shape_indices.extend(rng.integers(0, len(SHAPES), size=num_duplicates).tolist())\n    rng.shuffle(shape_indices)\n    return shape_indices\n\n\ndef _shuffled_positions(rng, shape_h, shape_w):\n    positions = [\n        (r, c)\n        for r in range(GRID_H - shape_h + 1)\n        for c in range(GRID_W - shape_w + 1)\n    ]\n    rng.shuffle(positions)\n    return positions\n\n\ndef _reserve_bbox(occupied, r, c, shape_h, shape_w):\n    r0 = max(0, r - RESERVED_PADDING)\n    c0 = max(0, c - RESERVED_PADDING)\n    r1 = min(GRID_H, r + shape_h + RESERVED_PADDING)\n    c1 = min(GRID_W, c + shape_w + RESERVED_PADDING)\n    occupied[r0:r1, c0:c1] = True\n\n\ndef _place_shape(grid, occupied, cells, shape_h, shape_w, rng):\n    \"\"\"Place one shape at the first free candidate in a randomized scan.\"\"\"\n    for r, c in _shuffled_positions(rng, shape_h, shape_w):\n        if occupied[r:r + shape_h, c:c + shape_w].any():\n            continue\n        for dr, dc in cells:\n            grid[r + dr, c + dc] = FG_COLOR\n        _reserve_bbox(occupied, r, c, shape_h, shape_w)\n        return True\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate input after {GENERATION_RETRIES} attempts\")\n\n=====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Compute a grey result bar by adding teal bar heights and subtracting red bar heights.\n\n    Input structure\n    - The grid has a dominant background and several bottom-aligned one-cell-wide vertical bars.\n    - Teal bars are positive operands; red bars are negative operands.\n    - The penultimate column is an empty result slot.\n\n    Rule\n    - Keep every input bar unchanged.\n    - Compute result height = total teal bar height - total red bar height.\n    - Paint that many bottom cells of the penultimate column grey.\n\n    Key insight\n    - The bars encode arithmetic by height, with color providing the sign.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height, width = g.shape\n    bg = get_bg(g)\n    bars = _operand_bars(g, bg)\n\n    result_height = 0\n    for bar in bars:\n        if bar[\"color\"] == Color.TEAL:\n            result_height += bar[\"height\"]\n        else:\n            assert bar[\"color\"] == Color.RED\n            result_height -= bar[\"height\"]\n\n    assert 0 < result_height <= height\n    assert width >= 2\n    result_col = width - 2\n    assert bool(np.all(g[:, result_col] == bg))\n\n    out = g.copy()\n    out[height - result_height : height, result_col] = Color.GREY\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas, object, and result-size bounds.\nBAR_COUNT_RANGE = (2, 6)\nGRID_HEIGHT_RANGE = (6, 12)\nTOP_MARGIN_ROWS, RESULT_HEIGHT_MIN = 1, 1\n# Column layout.\nBAR_COL_START, BAR_COL_STRIDE, WIDTH_EXTRA_COLS, RESULT_COL_FROM_RIGHT = 1, 2, 3, 2\n# Color palette and retry budget.\nBG_COLOR, RESULT_COLOR, POSITIVE_COLOR, NEGATIVE_COLOR = Color.ORANGE, Color.GREY, Color.TEAL, Color.RED\nGEN_RETRY_LIMIT = 300\n\n\ndef _bounded_composition(total: int, parts: int, *, upper: int) -> list[int] | None:\n    \"\"\"Sample positive bounded parts summing to total, or None if impossible.\"\"\"\n    if parts == 0:\n        return [] if total == 0 else None\n    if not (parts <= total <= parts * upper):\n        return None\n    values = []\n    remaining = total\n    for i in range(parts):\n        slots = parts - i - 1\n        lo = max(1, remaining - slots * upper)\n        hi = min(upper, remaining - slots)\n        value = random.randint(lo, hi)\n        values.append(value)\n        remaining -= value\n    random.shuffle(values)\n    return values\n\n\ndef _sample_bar_specs(n: int, max_bar_height: int) -> tuple[list[tuple[int, int]], int] | None:\n    \"\"\"Sample shuffled operand specs and the matching grey result height.\"\"\"\n    result_height = random.randint(RESULT_HEIGHT_MIN, max_bar_height)\n    feasible_teal_counts = []\n    for teal_count in range(1, n + 1):\n        red_count = n - teal_count\n        red_sum_lo = max(red_count, teal_count - result_height)\n        red_sum_hi = min(red_count * max_bar_height, teal_count * max_bar_height - result_height)\n        if red_sum_lo <= red_sum_hi:\n            feasible_teal_counts.append((teal_count, red_sum_lo, red_sum_hi))\n    if not feasible_teal_counts:\n        return None\n\n    teal_count, red_sum_lo, red_sum_hi = random.choice(feasible_teal_counts)\n    red_count = n - teal_count\n    red_sum = random.randint(red_sum_lo, red_sum_hi)\n    teal_sum = red_sum + result_height\n    teal_heights = _bounded_composition(teal_sum, teal_count, upper=max_bar_height)\n    red_heights = _bounded_composition(red_sum, red_count, upper=max_bar_height)\n    if teal_heights is None or red_heights is None:\n        return None\n\n    bar_specs = [(POSITIVE_COLOR, h) for h in teal_heights] + [(NEGATIVE_COLOR, h) for h in red_heights]\n    random.shuffle(bar_specs)\n    return bar_specs, result_height\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = random.randint(*BAR_COUNT_RANGE)\n    height = random.randint(*GRID_HEIGHT_RANGE)\n    max_bar_height = height - TOP_MARGIN_ROWS\n    width = BAR_COL_STRIDE * n + WIDTH_EXTRA_COLS\n    if (sampled := _sample_bar_specs(n, max_bar_height)) is None:\n        return None\n    bar_specs, result_height = sampled\n    out = np.full((height, width), BG_COLOR, dtype=int)\n    for i, (color, bar_height) in enumerate(bar_specs):\n        col = BAR_COL_START + BAR_COL_STRIDE * i\n        out[height - bar_height : height, col] = color\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
