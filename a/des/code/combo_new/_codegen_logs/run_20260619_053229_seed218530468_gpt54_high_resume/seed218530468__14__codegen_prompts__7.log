{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/7491f3cf.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Composite two pattern tiles into a fourth panel using flood-fill from an indicator pixel.\n\n    Input structure:\n    - Four 5×5 panels in one row, border-separated.\n    - Panel 0: cue pixels = wall boundary (8-connected, edge-to-edge, through center)\n               + one 8-isolated indicator pixel.\n    - Panels 1–2: source patterns. Panel 3: blank (to fill).\n\n    Rule:\n    - Flood-fill (4-conn) from indicator, blocked by wall → inside region.\n    - Inside → non-bg from panel 1; outside → non-bg from panel 2.\n    - Wall → panel 1 if non-bg; panel 2 fallback when wall is 4-connected.\n\n    Key insight: The cue panel's isolated indicator and wall partition the tile into inside/outside masks that select between the two source panels.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n\n    border = int(g[0, 0])\n    tiles = [g[1:6, 1 + 6 * j : 1 + 6 * j + 5].copy() for j in range(4)]\n    t0, t1, t2, _t3 = tiles\n    b = int(Counter(t1.flatten()).most_common(1)[0][0])\n    assert border != b, \"border color must differ from tile background\"\n\n    t0_bg = int(Counter(t0.flatten()).most_common(1)[0][0])\n    cue_set = {(int(r), int(c)) for r in range(5) for c in range(5) if int(t0[r, c]) != t0_bg}\n    assert cue_set, \"no cue pixels found\"\n\n    # --- Indicator = the unique 8-isolated cue pixel ---\n    indicator = None\n    for r, c in cue_set:\n        if not any((nr, nc) in cue_set for nr, nc in neighbors8(r, c)):\n            assert indicator is None, \"multiple 8-isolated cue pixels\"\n            indicator = (r, c)\n    assert indicator is not None, \"no 8-isolated cue pixel found\"\n\n    # Indicator must sit at a tile corner or edge midpoint\n    valid_pos = {(0,0),(0,4),(4,0),(4,4),(0,2),(2,0),(2,4),(4,2)}\n    assert indicator in valid_pos, f\"indicator {indicator} not at corner/edge-midpoint\"\n\n    wall = cue_set - {indicator}\n\n    # --- Structural assertions (feedback for generate_input agents) ---\n    assert (2, 2) in wall, \"wall must pass through the grid center (2,2)\"\n\n    # Wall must be symmetric about the line from indicator to center (2,2)\n    ir, ic = indicator\n    dr, dc = 2 - ir, 2 - ic\n    if dr == 0:\n        _refl = lambda r, c: (4 - r, c)\n    elif dc == 0:\n        _refl = lambda r, c: (r, 4 - c)\n    elif dr * dc > 0:\n        _refl = lambda r, c: (c, r)\n    else:\n        _refl = lambda r, c: (4 - c, 4 - r)\n    assert wall == {_refl(r, c) for r, c in wall}, \"wall must be symmetric about indicator→center axis\"\n\n    sides_touched = set()\n    for r, c in wall:\n        if r == 0: sides_touched.add(\"top\")\n        if r == 4: sides_touched.add(\"bottom\")\n        if c == 0: sides_touched.add(\"left\")\n        if c == 4: sides_touched.add(\"right\")\n    assert len(sides_touched) >= 2, f\"wall must span edge-to-edge, only touches {sides_touched}\"\n\n    # --- Flood fill inside region ---\n    EMPTY, WALL, INSIDE = 0, 1, 2\n    tmp = np.zeros((5, 5), dtype=int)\n    for r, c in wall:\n        tmp[r, c] = WALL\n    flood_fill(tmp, indicator[0], indicator[1], INSIDE, connectivity=4)\n    inside = {(int(r), int(c)) for r, c in np.argwhere(tmp == INSIDE)}\n\n    outside = {(r, c) for r in range(5) for c in range(5)} - inside - wall\n    assert outside, \"wall must partition the grid — outside region is empty\"\n\n    # Wall 4-connectivity determines boundary blending behavior:\n    # axis-aligned walls (4-connected) allow t2 fallback; diagonal walls don't.\n    wall_mask = np.zeros((5, 5), dtype=bool)\n    for r, c in wall:\n        wall_mask[r, c] = True\n    _, n_comp = label_mask(wall_mask, connectivity=4)\n    wall_4conn = (n_comp == 1)\n\n    # --- Build output tile ---\n    out3 = np.full((5, 5), b, dtype=int)\n    for r in range(5):\n        for c in range(5):\n            v1, v2 = int(t1[r, c]), int(t2[r, c])\n            if (r, c) in inside:\n                if v1 != b:\n                    out3[r, c] = v1\n            elif (r, c) in wall:\n                if v1 != b:\n                    out3[r, c] = v1\n                elif wall_4conn and v2 != b:\n                    out3[r, c] = v2\n            else:\n                if v2 != b:\n                    out3[r, c] = v2\n\n    out = g.copy()\n    out[1:6, 1 + 6 * 3 : 1 + 6 * 3 + 5] = out3\n    return out\n\n# --------------- generator (subagent) ---------------\n\n# ── Tunables ──────────────────────────────────────────────────────────────────\nTILE_SZ = 5                    # each panel is 5x5\nGRID_ROWS, GRID_COLS = 7, 25  # fixed output grid shape\nNUM_COLORS = 10                # ARC color palette size\n\nT1_MIN_PX, T1_MAX_PX = 8, 12  # tile-1 non-bg pixel range\nT2_MIN_PX, T2_MAX_PX = 9, 12  # tile-2 non-bg pixel range\nORBIT_INCLUDE_PROB = 0.55      # per-orbit inclusion probability for pattern sampling\nPATTERN_RETRIES = 200          # max retries per _sample_symmetric_pattern call\nGEN_RETRIES = 300              # max retries in generate_input outer loop\nLBEND_PROB = 0.2               # L-bend wall probability (eval ratio ~4:1 straight:L-bend)\n\n# ── Symmetric pattern orbits (D1+D2 symmetry on 5x5) ─────────────────────────\n_ORBITS = [\n    [(0, 0), (4, 4)],\n    [(0, 4), (4, 0)],\n    [(2, 2)],\n    [(1, 1), (3, 3)],\n    [(1, 3), (3, 1)],\n    [(0, 1), (1, 0), (3, 4), (4, 3)],\n    [(0, 2), (2, 0), (2, 4), (4, 2)],\n    [(0, 3), (3, 0), (1, 4), (4, 1)],\n    [(1, 2), (2, 1), (2, 3), (3, 2)],\n]\n\n\ndef _sample_symmetric_pattern(bg: int, fg: int, rng: random.Random, *,\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n#