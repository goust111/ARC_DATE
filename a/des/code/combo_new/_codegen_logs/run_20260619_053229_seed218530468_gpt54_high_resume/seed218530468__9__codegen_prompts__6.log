{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/2faf500b.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg, in_bounds\nimport random\n\n\ndef _role_colors(g: np.ndarray, bg: int) -> tuple[int, int]:\n    fg = colors_present(g, exclude={bg})\n    assert len(fg) == 2, \"expected exactly two foreground colors\"\n\n    counts = {color: int(np.count_nonzero(g == color)) for color in fg}\n    marker_count = min(counts.values())\n    body_count = max(counts.values())\n    markers = [color for color, count in counts.items() if count == marker_count]\n    bodies = [color for color, count in counts.items() if count == body_count]\n    assert marker_count < body_count, \"fracture marker color must be the minority foreground color\"\n    assert len(markers) == 1 and len(bodies) == 1, \"foreground roles must be unique\"\n    return markers[0], bodies[0]\n\n\ndef _set_body(out: np.ndarray, r: int, c: int, color: int) -> None:\n    assert in_bounds(out.shape, r, c), \"shifted object pixel must stay in bounds\"\n    assert int(out[r, c]) != int(color), \"shifted object pixels must not collide\"\n    out[r, c] = int(color)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Remove each fracture marker line and push the surrounding object pixels one cell away from it.\n\n    Input structure\n    - A background grid with 8-connected foreground objects made from a body color and a rarer marker color.\n    - Each object has a non-square bbox; the marker pixels form one complete fracture line across the shorter bbox axis.\n\n    Rule\n    - Erase all marker pixels.\n    - For a wide object, each row has one marker; body pixels left of it shift one cell left and body pixels right of it shift one cell right.\n    - For a tall object, each column has one marker; body pixels above it shift one cell up and body pixels below it shift one cell down.\n\n    Key insight\n    - The marker line is a crack through the object, so the two sides separate by one pixel perpendicular to the crack.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    marker, body = _role_colors(g, bg)\n    out = np.full_like(g, bg)\n\n    objects = find_components(\n        g,\n        bg=bg,\n        connectivity=8,\n        monochromatic=False,\n        colors=[marker, body],\n    )\n    assert objects, \"expected at least one fractured object\"\n\n    for obj in objects:\n        coords = obj[\"coords\"]\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        width = int(c1 - c0 + 1)\n        assert height != width, \"fractured object bbox must determine an orientation\"\n\n        vals = g[coords[:, 0], coords[:, 1]]\n        assert bool(np.any(vals == marker)), \"each object must contain marker pixels\"\n        assert bool(np.any(vals == body)), \"each object must contain body pixels\"\n\n        marker_coords = coords[vals == marker]\n        if width > height:\n            marker_by_row: dict[int, list[int]] = {}\n            for r, c in marker_coords:\n                marker_by_row.setdefault(int(r), []).append(int(c))\n            assert set(marker_by_row) == set(range(r0, r1 + 1)), \"wide object needs one marker in each row\"\n            assert all(len(cols) == 1 for cols in marker_by_row.values()), \"wide object marker row must be unique\"\n\n            for r, c in coords[vals == body]:\n                rr = int(r)\n                cc = int(c)\n                marker_c = marker_by_row[rr][0]\n                assert cc != marker_c, \"body pixel cannot occupy the marker column\"\n                shifted_c = cc - 1 if cc < marker_c else cc + 1\n                _set_body(out, rr, shifted_c, body)\n        else:\n            marker_by_col: dict[int, list[int]] = {}\n            for r, c in marker_coords:\n                marker_by_col.setdefault(int(c), []).append(int(r))\n            assert set(marker_by_col) == set(range(c0, c1 + 1)), \"tall object needs one marker in each column\"\n            assert all(len(rows) == 1 for rows in marker_by_col.values()), \"tall object marker column must be unique\"\n\n            for r, c in coords[vals == body]:\n                rr = int(r)\n                cc = int(c)\n                marker_r = marker_by_col[cc][0]\n                assert rr != marker_r, \"body pixel cannot occupy the marker row\"\n                shifted_r = rr - 1 if rr < marker_r else rr + 1\n                _set_body(out, shifted_r, cc, body)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, palette, and retry budget.\nBACKGROUND_COLOR = 0\nFOREGROUND_COLORS = tuple(range(1, 10))\nMAX_GRID_SIZE = 19\nMIN_GRID_SIZE_BY_COUNT = (8, 8, 10, 12, 14, 16, 18, 19)\nGENERATION_RETRIES = 300\n\n# Object counts, dimensions, and orientations.\nMIN_OBJECT_COUNT = 1\nMAX_OBJECT_COUNT = 7\nSHORT_SIDE_SIZES = (2, 3, 4, 5, 6)\nLONG_SIDE_FACTOR = 2\nWIDE = \"wide\"\nTALL = \"tall\"\nORIENTATIONS = [WIDE, TALL]\n\n# Dense layouts try smaller rectangles first while preserving random tie order.\nDENSE_COUNT_THRESHOLD = 6\nDENSE_PREFERRED_MAX_SHORT_SIDE = 3\nPACKED_COUNT_THRESHOLD = 4\nPACKED_PREFERRED_MAX_SHORT_SIDE = 4\n\n# Placement and retry constraints.\nSHIFT_PADDING = 1\nMIN_CHEB_GAP = 2\n\nBBox = tuple[int, int, int, int]\nLocation = tuple[int, int]\nObjectSpec = tuple[int, int, int, str]\n\n\ndef _interval_sep(a0: int, a1: int, b0: int, b1: int) -> int:\n    if a1 < b0:\n        return b0 - a1\n    if b1 < a0:\n        return a0 - b1\n    return 0\n\n\ndef _cheb_gap_at_least_2(a: BBox, b: BBox) -> bool:\n    dr = _interval_sep(a[0], a[2], b[0], b[2])\n    dc = _interval_sep(a[1], a[3], b[1], b[3])\n    return max(dr, dc) >= MIN_CHEB_GAP\n\n\ndef _overlap(a: BBox, b: BBox) -> bool:\n    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])\n\n\ndef _expanded_bbox(r: int, c: int, h: int, w: int) -> BBox:\n    if w > h:\n        return r, c - SHIFT_PADDING, r + h - 1, c + w - 1 + SHIFT_PADDING\n    return r - SHIFT_PADDING, c, r + h - 1 + SHIFT_PADDING, c + w - 1\n\n\ndef _object_dims(short_side: int, orient: str) -> tuple[int, int]:\n    if orient == WIDE:\n        return short_side, LONG_SIDE_FACTOR * short_side\n    return LONG_SIDE_FACTOR * short_side, short_side\n\n\ndef _locations(n: int, h: int, w: int, originals: list[BBox], expanded: list[BBox]) -> list[Location]:\n    if w > h:\n        row_range = range(0, n - h + 1)\n        col_range = range(SHIFT_PADDING, n - w - SHIFT_PADDING + 1)\n    else:\n        row_range = range(SHIFT_PADDING, n - h - SHIFT_PADDING + 1)\n        col_range = range(0, n - w + 1)\n\n    locs: list[Location] = []\n    for r in row_range:\n        for c in col_range:\n            orig = (r, c, r + h - 1, c + w - 1)\n            exp = _expanded_bbox(r, c, h, w)\n            if any(not _cheb_gap_at_least_2(orig, old) for old in originals):\n                continue\n            if any(_overlap(exp, old) for old in expanded):\n                continue\n            locs.append((r, c))\n    random.shuffle(locs)\n    return locs\n\n\ndef _draw_object(grid: np.ndarray, expected: np.ndarray, r: int, c: int, s: int, orient: str, body: int, marker: int) -> None:\n    h, w = _object_dims(s, orient)\n    grid[r : r + h, c : c + w] = body\n    bits = [0, 1] + [random.randrange(2) for _ in range(s - 2)]\n    random.shuffle(bits)\n\n    if orient == WIDE:\n        rows = r + np.arange(s)\n        marker_cols = c + s - 1 + np.asarray(bits)\n        grid[rows, marker_cols] = marker\n        for row, marker_c in zip(rows, marker_cols):\n            expected[row, c - SHIFT_PADDING : marker_c - SHIFT_PADDING] = body\n            expected[row, marker_c + SHIFT_PADDING + 1 : c + w + SHIFT_PADDING] = body\n    else:\n        cols = c + np.arange(s)\n        marker_rows = r + s - 1 + np.asarray(bits)\n        grid[marker_rows, cols] = marker\n        for col, marker_r in zip(cols, marker_rows):\n            expected[r - SHIFT_PADDING : marker_r - SHIFT_PADDING, col] = body\n            expected[marker_r + SHIFT_PADDING + 1 : r + h + SHIFT_PADDING, col] = body\n\n\ndef _size_order(count: int) -> list[int]:\n    sizes = list(SHORT_SIDE_SIZES)\n    random.shuffle(sizes)\n    if count >= DENSE_COUNT_THRESHOLD:\n        return sorted(sizes, key=lambda s: (s > DENSE_PREFERRED_MAX_SHORT_SIDE, random.random()))\n    if count >= PACKED_COUNT_THRESHOLD:\n        return sorted(sizes, key=lambda s: (s > PACKED_PREFERRED_MAX_SHORT_SIDE, random.random()))\n    return sizes\n\n\ndef _place_objects(n: int, count: int) -> list[ObjectSpec] | None:\n    \"\"\"Pick non-overlapping object specs; return None if this attempt cannot fit them.\"\"\"\n    originals: list[BBox] = []\n    expanded: list[BBox] = []\n    placed: list[ObjectSpec] = []\n\n    for _ in range(count):\n        choices: list[tuple[int, str, list[Location]]] = []\n        for s in _size_order(count):\n            for orient in random.sample(ORIENTATIONS, 2):\n                h, w = _object_dims(s, orient)\n                locs = _locations(n, h, w, originals, expanded)\n                if locs:\n                    choices.append((s, orient, locs))\n        if not choices:\n            return None\n\n        s, orient, locs = random.choice(choices)\n        r, c = random.choice(locs)\n        h, w = _object_dims(s, orient)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/e39e9282.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import Color, find_components, get_bg\nimport itertools\nimport random\n\n\ndef _squares(g: np.ndarray, bg: int) -> list[tuple[int, int, int, int, int]]:\n    out: list[tuple[int, int, int, int, int]] = []\n    for comp in find_components(\n        g,\n        bg=bg,\n        colors=[Color.GREY, Color.PINK],\n        connectivity=4,\n    ):\n        color = int(comp[\"color\"])\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert comp[\"area\"] == 9\n        assert r1 - r0 == 2 and c1 - c0 == 2\n        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color)\n        out.append((r0, c0, r1, c1, color))\n    assert out\n    return out\n\n\ndef _touch_side(\n    r: int, c: int, square: tuple[int, int, int, int, int]\n) -> str | None:\n    r0, c0, r1, c1, _color = square\n    if r0 <= r <= r1:\n        if c == c0 - 1:\n            return \"left\"\n        if c == c1 + 1:\n            return \"right\"\n    if c0 <= c <= c1:\n        if r == r0 - 1:\n            return \"above\"\n        if r == r1 + 1:\n            return \"below\"\n    return None\n\n\ndef _target_for_marker(\n    r: int, c: int, side: str, square: tuple[int, int, int, int, int]\n) -> tuple[int, int]:\n    r0, c0, r1, c1, color = square\n    if color == Color.PINK:\n        if side in {\"left\", \"right\"}:\n            return r, (c0 + c1) // 2\n        return (r0 + r1) // 2, c\n\n    assert color == Color.GREY\n    if side == \"left\":\n        return r, c0\n    if side == \"right\":\n        return r, c1\n    if side == \"above\":\n        return r0, c\n    assert side == \"below\"\n    return r1, c\n\n\ndef _pink_targets_for_markers(\n    markers: list[tuple[int, int, str]],\n    square: tuple[int, int, int, int, int],\n) -> set[tuple[int, int]]:\n    _r0, _c0, _r1, _c1, color = square\n    assert color == Color.PINK\n    return {_target_for_marker(r, c, side, square) for r, c, side in markers}\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Project maroon markers into adjacent grey or pink 3x3 squares, erasing grey squares afterward.\n\n    Input structure\n    The grid has a dominant background, solid 3x3 grey and/or pink squares, and maroon marker pixels or segments directly touching one side of exactly one square.\n    Rule\n    Grey squares are erased; their adjacent maroon markers stay in place and stamp the nearest edge cell inside the grey square. Pink squares stay pink; their adjacent maroon markers disappear and stamp the corresponding cell on the square's middle row or middle column.\n    Key insight\n    The side touched by a marker determines the projection: grey uses the near edge, while pink uses the centerline, preserving the marker's coordinate along that side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g)))\n    assert colors <= {bg, Color.GREY, Color.PINK, Color.MAROON}\n    assert Color.MAROON in colors\n\n    squares = _squares(g, bg)\n    out = g.copy()\n    out[g == Color.GREY] = bg\n\n    paint: set[tuple[int, int]] = set()\n    remove_sources: list[tuple[int, int]] = []\n    pink_markers_by_square: dict[int, list[tuple[int, int, str]]] = {}\n    for r, c in np.argwhere(g == Color.MAROON):\n        hits = []\n        for idx, square in enumerate(squares):\n            side = _touch_side(int(r), int(c), square)\n            if side is not None:\n                hits.append((side, idx, square))\n        assert len(hits) == 1\n\n        side, idx, square = hits[0]\n        if square[4] == Color.PINK:\n            pink_markers_by_square.setdefault(idx, []).append((int(r), int(c), side))\n            remove_sources.append((int(r), int(c)))\n        else:\n            target = _target_for_marker(int(r), int(c), side, square)\n            tr, tc = target\n            assert g[tr, tc] == square[4]\n            paint.add(target)\n\n    for idx, markers in pink_markers_by_square.items():\n        square = squares[idx]\n        for target in _pink_targets_for_markers(markers, square):\n            tr, tc = target\n            assert g[tr, tc] == square[4]\n            paint.add(target)\n\n    for r, c in remove_sources:\n        out[r, c] = bg\n    for r, c in paint:\n        out[r, c] = Color.MAROON\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import paste\n\n\n# Colors.\n_GEN_BG = 8\n_GEN_GREY = 5\n_GEN_PINK = 6\n_GEN_MAROON = 9\n\n# Canvas and square geometry.\n_GEN_CANVAS_MIN = 9\n_GEN_CANVAS_MAX = 15\n_GEN_CANVAS_MAX_DELTA = 2\n_GEN_SQUARE_SIZE = 3\n_GEN_SQUARE_LAST = _GEN_SQUARE_SIZE - 1\n_GEN_SQUARE_GAP = 1\n\n# Square count bounds.\n_GEN_TOTAL_SQUARE_MIN = 1\n_GEN_TOTAL_SQUARE_MAX = 7\n_GEN_GREY_SQUARE_MAX = 3\n_GEN_PINK_SQUARE_MAX = 4\n\n# Marker side and count bounds.\n_GEN_SIDES = (\"left\", \"right\", \"above\", \"below\")\n_GEN_MARKER_SIDE_MIN = 1\n_GEN_MARKER_SIDE_MAX = 3\n_GEN_MARKER_PER_SIDE_MAX = 3\n_GEN_MARKER_TOTAL_MAX = 5\n\n# Rejection sampling budget.\n_GEN_MAX_ATTEMPTS = 300\n_GEN_SQUARE_PATCHES = {color: np.full((_GEN_SQUARE_SIZE, _GEN_SQUARE_SIZE), color, dtype=int) for color in (_GEN_GREY, _GEN_PINK)}\n\n_GenSquare = tuple[int, int, int]\n_GenMarker = tuple[int, int, str]\n\n\ndef _gen_square_gap_ok(r0: int, c0: int, squares: list[_GenSquare]) -> bool:\n    last = _GEN_SQUARE_LAST\n    gap = _GEN_SQUARE_GAP\n    r1, c1 = r0 + last, c0 + last\n    for sr0, sc0, _color in squares:\n        sr1, sc1 = sr0 + last, sc0 + last\n        if not (\n            r1 < sr0 - gap\n            or sr1 < r0 - gap\n            or c1 < sc0 - gap\n            or sc1 < c0 - gap\n        ):\n            return False\n    return True\n\n\ndef _gen_place_square(grid: np.ndarray, r0: int, c0: int, color: int) -> None:\n    paste(grid, _GEN_SQUARE_PATCHES[int(color)], r0, c0)\n\n\ndef _gen_side_for_cell(r: int, c: int, square: _GenSquare) -> str | None:\n    r0, c0, _color = square\n    r1, c1 = r0 + _GEN_SQUARE_LAST, c0 + _GEN_SQUARE_LAST\n    if r0 <= r <= r1:\n        if c == c0 - 1:\n            return \"left\"\n        if c == c1 + 1:\n            return \"right\"\n    if c0 <= c <= c1:\n        if r == r0 - 1:\n            return \"above\"\n        if r == r1 + 1:\n            return \"below\"\n    return None\n\n\ndef _gen_inside_square(r: int, c: int, square: _GenSquare) -> bool:\n    r0, c0, _color = square\n    r1, c1 = r0 + _GEN_SQUARE_LAST, c0 + _GEN_SQUARE_LAST\n    return r0 <= r <= r1 and c0 <= c <= c1\n\n\ndef _gen_valid_marker_slot(r: int, c: int, squares: list[_GenSquare]) -> bool:\n    if any(_gen_inside_square(r, c, square) for square in squares):\n        return False\n    hits = sum(\n        _gen_side_for_cell(r, c, square) is not None for square in squares\n    )\n    return hits == 1\n\n\ndef _gen_side_slots(H: int, W: int, square: _GenSquare, squares: list[_GenSquare]) -> dict[str, list[tuple[int, int]]]:\n    r0, c0, _color = square\n    edge = _GEN_SQUARE_SIZE\n    raw = {\n        \"left\": [(r, c0 - 1) for r in range(r0, r0 + edge)] if c0 > 0 else [],\n        \"right\": [(r, c0 + edge) for r in range(r0, r0 + edge)] if c0 + edge < W else [],\n        \"above\": [(r0 - 1, c) for c in range(c0, c0 + edge)] if r0 > 0 else [],\n        \"below\": [(r0 + edge, c) for c in range(c0, c0 + edge)] if r0 + edge < H else [],\n    }\n    return {\n        side: [\n            (r, c)\n            for r, c in slots\n            if _gen_valid_marker_slot(r, c, squares)\n        ]\n        for side, slots in raw.items()\n    }\n\n\ndef _gen_split_marker_total(total: int, caps: list[int]) -> list[int] | None:\n    counts: list[int] = []\n    remaining = int(total)\n    for i, cap in enumerate(caps):\n","exit_code":0,"status":"completed"}}
