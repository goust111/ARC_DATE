{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/6350f1f4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Decode a block-grid image by swapping each sprite-coded cell with a solid cell and each blank cell with the sprite.\n\n    Input structure\n    The grid is partitioned by black separator rows and columns into equal-size\n    square blocks. Each block is either a copy of one two-color sprite or a\n    uniform blank block of the sprite's minority color; grey pixels are erased\n    cells that act as wildcards.\n\n    Rule\n    Infer the repeated sprite from fully visible mixed-color blocks. Replace a\n    block matching that sprite, ignoring grey erasures, with a solid block of\n    the sprite's majority color. Replace a uniform blank block with the sprite.\n    Separator rows and columns, including grey erasures on them, become black.\n\n    Key insight\n    The small sprite is a block-level code for one macro-cell state, and the\n    uniform minority-color block is the other state; the output renders the\n    opposite code in each macro-cell while cleaning erased pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n\n    row_separators = [r for r in range(H) if _is_separator_line(g[r, :])]\n    col_separators = [c for c in range(W) if _is_separator_line(g[:, c])]\n    row_intervals = _regular_intervals(row_separators, H)\n    col_intervals = _regular_intervals(col_separators, W)\n    block_heights = {r1 - r0 for r0, r1 in row_intervals}\n    block_widths = {c1 - c0 for c0, c1 in col_intervals}\n    assert block_heights == block_widths, \"encoded blocks must be square\"\n\n    payload_colors = colors_present(g, exclude={SEPARATOR, ERASED})\n    assert len(payload_colors) == 2, \"expected exactly two non-separator payload colors\"\n    sprite = _find_sprite(g, row_intervals, col_intervals, payload_colors)\n    foreground, blank = _foreground_and_blank(sprite, payload_colors)\n\n    out = np.zeros_like(g)\n    for r0, r1 in row_intervals:\n        for c0, c1 in col_intervals:\n            block = g[r0:r1, c0:c1]\n            known = block != ERASED\n            assert known.any(), \"each block must expose at least one non-grey cell\"\n            matches_sprite = bool(np.all(block[known] == sprite[known]))\n            matches_blank = bool(np.all(block[known] == blank))\n            assert matches_sprite != matches_blank, \"each block must unambiguously match the sprite or blank state\"\n            out[r0:r1, c0:c1] = foreground if matches_sprite else sprite\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette bounds.\nGRID_COUNT_RANGE, BLOCK_SIZE_RANGE = (2, 4), (2, 4)\nPAYLOAD_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\nPAYLOAD_COLOR_COUNT = 2\nGEN_SEPARATOR_COLOR, GEN_ERASED_COLOR = int(SEPARATOR), int(ERASED)\n\n# Sprite composition constraints.\nSPRITE_FG_MIN_RATIO, SPRITE_FG_MAX_RATIO = (2, 3), (3, 4)\nSPRITE_ATTEMPTS, TINY_BLOCK_SIZE = 80, 2\n\n# Macro-cell state constraints.\nMIN_BLANK_BLOCKS, MAX_BLANK_BLOCK_DENOMINATOR = 1, 2\n\n# Grey overlay constraints.\nGREY_MIN_FRACTION, GREY_MAX_FRACTION = 0.05, 0.25\nGREY_TWO_COMPONENT_PROBABILITY, GREY_TWO_COMPONENT_ATTEMPTS = 0.5, 30\nGREY_CONNECTIVITY, GENERATION_ATTEMPTS = 4, 300\n\nNEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _separator_indices(n: int, block_size: int) -> set[int]:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/5b37cb25.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Fill each plus-shaped background notch with the color of the frame side it opens toward.\n\n    Input structure\n    - A one-cell-thick rectangular frame has four solid-colored sides and neutral corner pixels.\n    - The frame interior contains a dominant background color and one foreground object color.\n    - Some object boundaries contain five-pixel plus-shaped background notches.\n\n    Rule\n    - Find every background plus whose opposite side is supported by foreground object pixels and whose open side faces one frame side.\n    - Recolor the five pixels of that plus with the color of the facing frame side.\n    - Leave all other pixels unchanged.\n\n    Key insight\n    The frame side colors are direction labels for the open notches in the foreground object.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    h, w = g.shape\n    assert h >= 5 and w >= 5, \"expected room for a frame and plus notches\"\n\n    side_color = {\n        \"top\": _uniform_side(g[0, 1:-1]),\n        \"bottom\": _uniform_side(g[-1, 1:-1]),\n        \"left\": _uniform_side(g[1:-1, 0]),\n        \"right\": _uniform_side(g[1:-1, -1]),\n    }\n    bg, obj = _interior_colors(g[1:-1, 1:-1])\n\n    out = g.copy()\n    painted: set[tuple[int, int]] = set()\n    notch_count = 0\n    for r in range(1, h - 1):\n        for c in range(1, w - 1):\n            cross = tuple((r + dr, c + dc) for dr, dc in _CROSS)\n            if not all(int(g[rr, cc]) == bg for rr, cc in cross):\n                continue\n\n            dirs = _direction_for_notch(g, r, c, obj)\n            assert len(dirs) <= 1, \"expected each plus notch to open in at most one direction\"\n            if not dirs:\n                continue\n\n            notch_count += 1\n            color = side_color[dirs[0]]\n            for cell in cross:\n                assert cell not in painted, \"expected non-overlapping plus notches\"\n                painted.add(cell)\n                out[cell] = color\n\n    assert notch_count > 0, \"expected at least one plus notch\"\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\n_GEN_GRID_SIZE, _GEN_CORNER_COLOR = 30, 0\n_GEN_COLOR_POOL, _GEN_PALETTE_SIZE = range(1, 10), 6\n\n# Object size and total filled-area budget.\n_OBJECT_COUNT_MIN, _OBJECT_COUNT_MAX = 3, 4\n_OBJECT_DIM_MIN, _OBJECT_DIM_MAX = 5, 20\n_OBJECT_AREA_MIN, _OBJECT_AREA_MAX = 30, 180\n_TOTAL_OBJECT_AREA_MAX, _MIN_REMAINING_OBJECT_AREA = 360, 30\n\n# Placement gap against frame and other objects.\n_PLACEMENT_BORDER, _PLACEMENT_PADDING, _PLACEMENT_PADDING_CONNECTIVITY = 2, 2, 8\n\n# Notch geometry and counts.\n_GEN_CROSS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))\n_GEN_DIRECTIONS = {\n    \"top\": (-1, 0),\n    \"bottom\": (1, 0),\n    \"left\": (0, -1),\n    \"right\": (0, 1),\n}\n_EDGES = tuple(_GEN_DIRECTIONS)\n_NOTCH_EDGE_MARGIN, _MAX_TOTAL_NOTCHES = 2, 8\n_NOTCHES_PER_OBJECT = (1, 2, 3)\n\n# Rejection-sampling retry cap.\n_GEN_RETRY_LIMIT = 300\n_DIM_PAIRS = [(h, w) for h in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1)\n              for w in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1) if _OBJECT_AREA_MIN <= h * w <= _OBJECT_AREA_MAX]\n\n\ndef _notch_cells(r, c, direction):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\ndef _get_enclosed_holes(sprite):\n","exit_code":0,"status":"completed"}}
