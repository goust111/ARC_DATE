{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nfrom collections import Counter\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed218530468/7/3.py')\nmod = SourceFileLoader('new_arc_task_stats', str(p)).load_module()\nmode_counts = Counter()\nfor _ in range(200):\n    grid = mod.generate_input()\n    bg = mod.BG\n    border = np.zeros_like(grid, dtype=bool)\n    border[0,:]=border[-1,:]=True\n    border[:,0]=border[:,-1]=True\n    emitters = [\n        mod._emitter_from_position(grid.shape[0], grid.shape[1], int(r), int(c), int(grid[r,c]))\n        for r,c in np.argwhere(border & (grid \"'!= bg))\n    ]\n    has_tie = False\n    for coords in mod._components4(grid == mod.OBJECT):\n        rows = {int(r) for r in coords[:,0]}\n        cols = {int(c) for c in coords[:,1]}\n        counts = Counter()\n        for emitter in emitters:\n            hits = emitter['\"'line'] in rows if emitter['axis'] == 'row' else emitter['line'] in cols\n            if hits:\n                counts[int(emitter['color'])] += 1\n        if counts:\n            max_votes = max(counts.values())\n            if sum(v == max_votes for v in counts.values()) > 1:\n                has_tie = True\n                break\n    mode_counts['tie' if has_tie else 'non_tie'] += 1\nprint(dict(mode_counts))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
