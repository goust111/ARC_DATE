{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/d93c6891.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords, bbox_h, bbox_w, find_components, neighbors4\nimport random\n\n\ndef _orientation(\n    coords: np.ndarray,\n    contacts: list[tuple[int, int, int, int]],\n) -> str:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    assert h == 1 or w == 1, \"expected each gray source to be a one-cell-thick bar\"\n\n    if h == 1 and w > 1:\n        return \"horizontal\"\n    if w == 1 and h > 1:\n        return \"vertical\"\n\n    implied: set[str] = set()\n    for tr, tc, sr, sc in contacts:\n        if tr == sr:\n            implied.add(\"horizontal\")\n        elif tc == sc:\n            implied.add(\"vertical\")\n        else:\n            raise AssertionError(\"gray source must touch orange by a 4-neighbor side\")\n    assert len(implied) == 1, \"singleton gray source has ambiguous orientation\"\n    return implied.pop()\n\n\ndef _fill_rows(\n    out: np.ndarray,\n    r0: int,\n    c0: int,\n    r1: int,\n    c1: int,\n    count: int,\n    contact_rows: set[int],\n) -> None:\n    width = int(c1 - c0 + 1)\n    height = int(r1 - r0 + 1)\n    assert count % width == 0, \"gray count must make complete orange rows\"\n    stripe_count = int(count // width)\n    assert 0 < stripe_count <= height, \"row fill must fit inside the orange rectangle\"\n\n    assert contact_rows in ({r0}, {r1}), \"horizontal bars must touch exactly one extreme row\"\n    if contact_rows == {r0}:\n        rows = list(range(r0, r0 + stripe_count))\n    else:\n        rows = list(range(r1 - stripe_count + 1, r1 + 1))\n\n    out[rows, c0 : c1 + 1] = Color.GRAY\n\n\ndef _fill_cols(\n    out: np.ndarray,\n    r0: int,\n    c0: int,\n    r1: int,\n    c1: int,\n    count: int,\n    contact_cols: set[int],\n) -> None:\n    width = int(c1 - c0 + 1)\n    height = int(r1 - r0 + 1)\n    assert count % height == 0, \"gray count must make complete orange columns\"\n    stripe_count = int(count // height)\n    assert 0 < stripe_count <= width, \"column fill must fit inside the orange rectangle\"\n\n    assert contact_cols in ({c0}, {c1}), \"vertical bars must touch exactly one extreme column\"\n    if contact_cols == {c0}:\n        cols = list(range(c0, c0 + stripe_count))\n    else:\n        cols = list(range(c1 - stripe_count + 1, c1 + 1))\n\n    out[r0 : r1 + 1, cols] = Color.GRAY\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each gray bar into its adjacent orange rectangle as full stripes from the contacted edge.\n\n    Input structure\n    - The scene uses black outside space, yellow fill, gray one-cell-thick bars, and solid orange rectangles.\n    - Each gray bar 4-touches exactly one orange rectangle; some orange rectangles have no touching gray bar.\n    - Gray bars touching the same orange rectangle all have the same orientation.\n\n    Rule\n    - Recolor every original gray cell to yellow.\n    - For each orange rectangle touched by gray bars, count the gray cells assigned to that rectangle.\n    - Horizontal gray bars repaint that many cells as complete orange rows starting from the contacted top or bottom row.\n    - Vertical gray bars repaint that many cells as complete orange columns starting from the contacted left or right column.\n    - Orange rectangles with no touching gray bar remain unchanged.\n\n    Key insight\n    - The gray pixels are not copied by shape; their count is transferred into the neighboring orange rectangle as edge-aligned row or column stripes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.YELLOW, Color.GRAY, Color.ORANGE}\n\n    orange = find_components(g, bg=Color.YELLOW, colors=[Color.ORANGE], connectivity=4)\n    gray = find_components(g, bg=Color.YELLOW, colors=[Color.GRAY], connectivity=4)\n    assert orange and gray, \"expected orange rectangles and gray source bars\"\n\n    orange_index: dict[tuple[int, int], int] = {}\n    orange_bboxes: list[tuple[int, int, int, int]] = []\n    for i, obj in enumerate(orange):\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        assert obj[\"area\"] == bbox_h(obj[\"bbox\"]) * bbox_w(obj[\"bbox\"])\n        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == Color.ORANGE)\n        orange_bboxes.append((int(r0), int(c0), int(r1), int(c1)))\n        for r, c in obj[\"coords\"]:\n            orange_index[(int(r), int(c))] = i\n\n    source_by_target: dict[int, list[tuple[dict, list[tuple[int, int, int, int]]]]] = {}\n    for src in gray:\n        touched: dict[int, list[tuple[int, int, int, int]]] = {}\n        for sr_raw, sc_raw in src[\"coords\"]:\n            sr = int(sr_raw)\n            sc = int(sc_raw)\n            for tr, tc in neighbors4(sr, sc):\n                target_i = orange_index.get((int(tr), int(tc)))\n                if target_i is not None:\n                    touched.setdefault(target_i, []).append((int(tr), int(tc), sr, sc))\n\n        assert len(touched) == 1, \"each gray bar must touch exactly one orange rectangle\"\n        target_i = next(iter(touched))\n        source_by_target.setdefault(target_i, []).append((src, touched[target_i]))\n\n    out = g.copy()\n    out[g == Color.GRAY] = Color.YELLOW\n\n    for target_i, sources in source_by_target.items():\n        r0, c0, r1, c1 = orange_bboxes[target_i]\n        orientations = {_orientation(src[\"coords\"], contacts) for src, contacts in sources}\n        assert len(orientations) == 1, \"all gray bars for one orange rectangle must share orientation\"\n        count = sum(int(src[\"area\"]) for src, _contacts in sources)\n        contacts = [contact for _src, src_contacts in sources for contact in src_contacts]\n\n        if orientations == {\"horizontal\"}:\n            contact_rows = {tr for tr, _tc, _sr, _sc in contacts}\n            assert contact_rows <= {r0, r1}\n            _fill_rows(out, r0, c0, r1, c1, count, contact_rows)\n        else:\n            assert orientations == {\"vertical\"}\n            contact_cols = {tc for _tr, tc, _sr, _sc in contacts}\n            assert contact_cols <= {c0, c1}\n            _fill_cols(out, r0, c0, r1, c1, count, contact_cols)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGRID_H_RANGE, GRID_W_RANGE = (10, 18), (14, 18)\nCONTENT_H_RANGE, CONTENT_W_RANGE = (6, 13), (12, 15)\nBORDER_RANGE = (0, 4)\n\nEDGES, HORIZONTAL_EDGES = (\"top\", \"bottom\", \"left\", \"right\"), (\"top\", \"bottom\")\nORANGE_COUNT_CHOICES, ORANGE_COUNT_WEIGHTS = [1, 2, 3, 4], [1, 2, 3, 4]\nORANGE_H_RANGE, ORANGE_W_RANGE = (1, 5), (2, 6)\nORANGE_AREA_RANGE = (4, 12)\nORANGE_PLACE_RETRIES = 80\n\nMAX_UNTOUCHED_ORANGES = 1\nBARS_PER_ORANGE_RANGE, TOTAL_BARS_RANGE = (1, 2), (2, 6)\nBAR_LENGTH_RANGE = (1, 7)\nBAR_COUNT_RETRIES = 50\n\nGENERATE_RETRIES = 300\n\n\ndef _place_orange(edge, cr0, cc0, cr1, cc1, occupied):\n    \"\"\"Try to place an orange rect flush against the given edge. Returns (or0,oc0,or1,oc1) or None.\"\"\"\n    for _ in range(ORANGE_PLACE_RETRIES):\n        oh = random.randint(*ORANGE_H_RANGE)\n        ow = random.randint(*ORANGE_W_RANGE)\n        if not (ORANGE_AREA_RANGE[0] <= oh * ow <= ORANGE_AREA_RANGE[1]):\n            continue\n        if edge in HORIZONTAL_EDGES:\n            or0 = cr0 if edge == 'top' else cr1 - oh + 1\n            or1 = or0 + oh - 1\n            lo, hi = cc0 + 1, cc1 - ow  # avoid touching perpendicular edges\n        else:\n            oc0 = cc0 if edge == 'left' else cc1 - ow + 1\n            oc1 = oc0 + ow - 1\n            lo, hi = cr0 + 1, cr1 - oh  # avoid touching perpendicular edges\n        if hi < lo:\n            continue\n        v = random.randint(lo, hi)\n        if edge in HORIZONTAL_EDGES:\n            oc0, oc1 = v, v + ow - 1\n        else:\n            or0, or1 = v, v + oh - 1\n        if or0 < cr0 or or1 > cr1 or oc0 < cc0 or oc1 > cc1:\n            continue\n        if occupied[or0:or1+1, oc0:oc1+1].any():\n            continue\n        return (or0, oc0, or1, oc1)\n    return None\n\n\ndef _make_canvas() -> tuple[np.ndarray, tuple[int, int, int, int]] | None:\n    content_h = random.randint(*CONTENT_H_RANGE)\n    content_w = random.randint(*CONTENT_W_RANGE)\n    border_top = random.randint(*BORDER_RANGE)\n    border_bottom = random.randint(*BORDER_RANGE)\n    border_left = random.randint(*BORDER_RANGE)\n    border_right = random.randint(*BORDER_RANGE)\n    grid_h = content_h + border_top + border_bottom\n    grid_w = content_w + border_left + border_right\n    if not (GRID_H_RANGE[0] <= grid_h <= GRID_H_RANGE[1] and GRID_W_RANGE[0] <= grid_w <= GRID_W_RANGE[1]):\n        return None\n\n    grid = np.full((grid_h, grid_w), Color.BLACK, dtype=int)\n    cr0, cc0 = border_top, border_left\n    cr1, cc1 = cr0 + content_h - 1, cc0 + content_w - 1\n    grid[cr0:cr1+1, cc0:cc1+1] = Color.YELLOW\n    return grid, (cr0, cc0, cr1, cc1)\n\n\ndef _place_oranges(content_box, occupied) -> list[tuple[str, int, int, int, int]] | None:\n    cr0, cc0, cr1, cc1 = content_box\n    num_orange = random.choices(ORANGE_COUNT_CHOICES, weights=ORANGE_COUNT_WEIGHTS)[0]\n    edges = random.sample(EDGES, num_orange)\n    orange_rects = []\n    for edge in edges:\n        result = _place_orange(edge, cr0, cc0, cr1, cc1, occupied)\n        if result is None:\n            return None\n        or0, oc0, or1, oc1 = result\n        occupied[or0:or1+1, oc0:oc1+1] = True\n        orange_rects.append((edge, or0, oc0, or1, oc1))\n    return orange_rects\n\n\ndef _choose_touched_oranges(num_orange):\n    max_untouched = min(MAX_UNTOUCHED_ORANGES, num_orange - 1)\n    num_untouched = random.randint(0, max_untouched) if num_orange > 1 else 0\n    indices = list(range(num_orange))\n    random.shuffle(indices)\n    untouched_set = set(indices[:num_untouched])\n    return [i for i in range(num_orange) if i not in untouched_set]\n\n\ndef _choose_bars_per_orange(touched_list):\n    for _ in range(BAR_COUNT_RETRIES):\n        bpo = [random.randint(*BARS_PER_ORANGE_RANGE) for _ in touched_list]\n        if TOTAL_BARS_RANGE[0] <= sum(bpo) <= TOTAL_BARS_RANGE[1]:\n            return bpo\n    return None\n\n\ndef _split_bar_lengths(total_gray, n_bars):\n    min_len, max_len = BAR_LENGTH_RANGE\n    if n_bars == 2 and total_gray >= 2:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg\nimport random\n\n\ndef _touches_edge(coords: np.ndarray, height: int, width: int) -> bool:\n    rows = coords[:, 0]\n    cols = coords[:, 1]\n    return bool(\n        np.any((rows == 0) | (rows == height - 1) | (cols == 0) | (cols == width - 1))\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, table, frame, and slot dimensions.\nCANVAS_MIN, CANVAS_MAX = 13, 19\nTABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\nROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\nAXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n\n# Object and palette sampling limits.\nN_COLORS, MAX_OBJECT_COLORS = 10, 6\nMAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\nOBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n\n# Rejection sampling cap.\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_axis_options(n_slots, slot_min, slot_max):\n    options = []\n\n    def rec_slots(i, cur):\n        if i == n_slots:\n            rec_seps(0, [], cur)\n            return\n        for size in range(slot_min, slot_max + 1):\n            rec_slots(i + 1, cur + [size])\n\n    def rec_seps(i, cur, slots):\n        if i == n_slots - 1:\n            for before in AXIS_OUTER_OPTIONS:\n                for after in AXIS_OUTER_OPTIONS:\n                    for pad_before in AXIS_PADDING_OPTIONS:\n                        for pad_after in AXIS_PADDING_OPTIONS:\n                            total = (\n                                before\n                                + after\n                                + pad_before\n                                + pad_after\n                                + sum(slots)\n                                + sum(cur)\n                            )\n                            if 13 <= total <= 19:\n                                options.append(\n                                    (\n                                        tuple(slots),\n                                        tuple(cur),\n                                        before,\n                                        after,\n                                        pad_before,\n                                        pad_after,\n                                        total,\n                                )\n                            )\n            return\n        for sep in AXIS_SEPARATOR_OPTIONS:\n            rec_seps(i + 1, cur + [sep], slots)\n\n    rec_slots(0, [])\n    return options\n\n\ndef _gen_positions(axis):\n    sizes, seps, outer_before, _outer_after, pad_before, _pad_after, _total = axis\n    starts = []\n    pos = outer_before + pad_before\n    for i, size in enumerate(sizes):\n        starts.append(pos)\n        pos += size\n        if i < len(seps):\n            pos += seps[i]\n    return starts\n\n\ndef _gen_choose_axis(n_slots, slot_min, slot_max, other_axis=None, max_object_loss=0):\n    options = _gen_axis_options(n_slots, slot_min, slot_max)\n    if other_axis is None:\n        return random.choice(options)\n\n    good = []\n    for axis in options:\n        row_axis = axis if slot_max == ROW_SLOT_SIZE_RANGE[1] else other_axis\n        col_axis = axis if slot_max == COL_SLOT_SIZE_RANGE[1] else other_axis\n        height = row_axis[-1]\n        width = col_axis[-1]\n        frame_height = height - row_axis[2] - row_axis[3]\n        frame_width = width - col_axis[2] - col_axis[3]\n        slot_area = sum(row_axis[0]) * sum(col_axis[0])\n        outer_bg = height * width - frame_height * frame_width\n        bg_room = outer_bg + slot_area - max_object_loss\n        frame_area = frame_height * frame_width - slot_area\n        if bg_room > frame_area:\n            good.append(axis)\n    return random.choice(good or options)\n\n\ndef _gen_assign_colors(shape, bg, frame):\n    n_slots = shape[0] * shape[1]\n    filled_count = random.randint(1, n_slots - 1)\n    filled = random.sample(range(n_slots), filled_count)\n    colors = [c for c in range(N_COLORS) if c not in (bg, frame)]\n    n_colors = random.randint(1, min(MAX_OBJECT_COLORS, filled_count, len(colors)))\n    palette = random.sample(colors, n_colors)\n    assignments = palette[:]\n    assignments.extend(random.choice(palette) for _ in range(filled_count - n_colors))\n    random.shuffle(assignments)\n\n    out = np.full(shape, bg, dtype=int)\n    for idx, color in zip(filled, assignments):\n        out[idx // shape[1], idx % shape[1]] = color\n    return out, filled_count\n\n\ndef _gen_object_shape(slot_h, slot_w):\n    by_area = {}\n    for obj_h in range(1, min(MAX_OBJECT_HEIGHT, slot_h - 2 * OBJECT_MARGIN) + 1):\n        for obj_w in range(1, min(MAX_OBJECT_WIDTH, slot_w - 2 * OBJECT_MARGIN) + 1):\n            by_area.setdefault(obj_h * obj_w, []).append((obj_h, obj_w))\n    area = random.choice(list(by_area))\n    return random.choice(by_area[area])\n\n\ndef _gen_choose_layout(rows, cols, filled_count):\n    row_axis = _gen_choose_axis(rows, *ROW_SLOT_SIZE_RANGE)\n    loss = MAX_OBJECT_AREA * filled_count\n    col_axis = _gen_choose_axis(cols, *COL_SLOT_SIZE_RANGE, row_axis, max_object_loss=loss)\n    return row_axis, col_axis, _gen_positions(row_axis), _gen_positions(col_axis)\n\n\ndef _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts):\n    height = row_axis[-1]\n    width = col_axis[-1]\n    grid = np.full((height, width), bg, dtype=int)\n    rt, rb = row_axis[2], row_axis[3]\n    cl, cr = col_axis[2], col_axis[3]\n    grid[rt : height - rb, cl : width - cr] = frame\n\n    for r, slot_h in zip(row_starts, row_axis[0]):\n        for c, slot_w in zip(col_starts, col_axis[0]):\n            grid[r : r + slot_h, c : c + slot_w] = bg\n    return grid\n\n\ndef _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts):\n    for out_r, slot_r in enumerate(row_starts):\n        slot_h = row_axis[0][out_r]\n        for out_c, slot_c in enumerate(col_starts):\n            color = int(out[out_r, out_c])\n            if color == bg:\n                continue\n            slot_w = col_axis[0][out_c]\n            obj_h, obj_w = _gen_object_shape(slot_h, slot_w)\n            obj_r = random.randint(slot_r + OBJECT_MARGIN, slot_r + slot_h - obj_h - OBJECT_MARGIN)\n            obj_c = random.randint(slot_c + OBJECT_MARGIN, slot_c + slot_w - obj_w - OBJECT_MARGIN)\n            grid[obj_r : obj_r + obj_h, obj_c : obj_c + obj_w] = color\n\n\ndef _gen_is_valid(grid, out, bg, frame):\n    counts = np.bincount(grid.ravel(), minlength=N_COLORS)\n    if int(np.argmax(counts)) != bg:\n        return False\n    if counts[frame] <= max(counts[c] for c in range(N_COLORS) if c not in (bg, frame)):\n        return False\n    try:\n        actual = main(grid)\n    except Exception:\n        return False\n    return bool(np.array_equal(actual, out))\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rows = random.randint(*TABLE_ROWS_RANGE)\n    cols = random.randint(*TABLE_COLS_RANGE)\n    bg, frame = random.sample(range(N_COLORS), 2)\n\n    out, filled_count = _gen_assign_colors((rows, cols), bg, frame)\n    row_axis, col_axis, row_starts, col_starts = _gen_choose_layout(rows, cols, filled_count)\n    grid = _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts)\n    _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts)\n\n    if _gen_is_valid(grid, out, bg, frame):\n        return grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n","exit_code":0,"status":"completed"}}
