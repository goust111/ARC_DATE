{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '61,170p;223,360p' /home/lixinyu/snap/new/ARC_code/train/98c475bf.py\nsed -n '41,170p;508,680p' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Erase the complete interior glyph and expand each endpoint marker pair into its color's full glyph.\n\n    Input structure\n    - The grid is 20x20 with background inside two same-color full-height vertical frame bars.\n    - Inside the frame there is one complete color glyph and one or more other colors appearing only as two endpoint markers in the same row.\n    - Marker endpoints are always in the first and last interior columns.\n\n    Rule\n    - Keep the vertical frame unchanged.\n    - Erase any complete interior glyph.\n    - For each endpoint marker pair, use that marker color's learned glyph template and anchor its horizontal bar on the marker row.\n\n    Key insight\n    - Color identifies which glyph shape to draw; the two endpoint pixels are not copied objects, they are anchors for reconstructing that color's full symbol.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    height, width = g.shape\n    assert (height, width) == (20, 20)\n\n    bg = get_bg(g)\n    assert bg == 0\n    frame_color = int(g[0, 0])\n    assert frame_color != bg\n    assert np.all(g[:, 0] == frame_color)\n    assert np.all(g[:, -1] == frame_color)\n    assert np.count_nonzero(g == frame_color) == 2 * height\n\n    out = g.copy()\n    marker_jobs: list[tuple[int, int]] = []\n    erased_any = False\n\n    for color0 in np.unique(g):\n        color = int(color0)\n        if color in (bg, frame_color):\n            continue\n\n        coords = np.argwhere(g == color)\n        rows = _marker_rows(coords, width)\n        if rows is not None:\n            for row in rows:\n                marker_jobs.append((color, row))\n        else:\n            assert len(coords) > 2\n            out[g == color] = bg\n            erased_any = True\n\n    assert erased_any\n    assert marker_jobs\n\n    claimed: dict[tuple[int, int], int] = {}\n    for color, anchor_row in marker_jobs:\n        for dr, c in _glyph_cells(color, width):\n            r = anchor_row + dr\n            assert 0 <= r < height\n            assert LEFT_MARKER_COL <= c <= width - 2\n            assert (r, c) not in claimed or claimed[(r, c)] == color\n            assert out[r, c] in (bg, color)\n            claimed[(r, c)] = color\n\n    for (r, c), color in claimed.items():\n        out[r, c] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\n_GEN_SIZE = 20\n_GEN_GLYPH_COLORS = [1, 2, 3, 6, 7]\n_GEN_FRAME_COLORS = (1, 2, 5, 7, 9)\n# Object counts and retry budget.\n_GEN_MARKER_COUNT_RANGE = (1, 3)\n_GEN_RETRIES = 300\n\n\ndef _gen_abs_cells(color: int, anchor_row: int) -> set[tuple[int, int]]:\n    return {(anchor_row + dr, c) for dr, c in _glyph_cells(color, _GEN_SIZE)}\n\n\ndef _gen_valid_rows(color: int) -> list[int]:\n    drs = [dr for dr, _ in _glyph_cells(color, _GEN_SIZE)]\n    return list(range(-min(drs), _GEN_SIZE - max(drs)))\n\n\ndef _gen_framed_grid(frame_color: int) -> np.ndarray:\n    grid = np.zeros((_GEN_SIZE, _GEN_SIZE), dtype=int)\n    grid[:, 0] = frame_color\n    grid[:, -1] = frame_color\n    return grid\n\n\ndef _gen_render_glyph(grid: np.ndarray, color: int, anchor_row: int) -> None:\n    for r, c in _gen_abs_cells(color, anchor_row):\n        grid[r, c] = color\n\n\ndef _gen_marker_jobs(colors: list[int], rng: np.random.Generator) -> list[tuple[int, int]] | None:\n    row_options = [_gen_valid_rows(color) for color in colors]\n    choices: list[tuple[tuple[int, ...], list[tuple[int, int]]]] = []\n\n    if len(colors) == 1:\n        for row in row_options[0]:\n            choices.append(((row,), [(colors[0], row)]))\n    else:\n        for row0 in row_options[0]:\n            cells0 = _gen_abs_cells(colors[0], row0)\n            for row1 in row_options[1]:\n                if cells0.isdisjoint(_gen_abs_cells(colors[1], row1)):\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exhausted attempts\")\n","exit_code":0,"status":"completed"}}
