{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nimport numpy as np\n\nBLACK=0\nGREY=5\nMAROON=9\nPALETTE=[1,2,3,4,6,7,8]\nDIRS=[(-1,0),(1,0),(0,-1),(0,1)]\n\n\ndef line_cells(a,b):\n    (r1,c1),(r2,c2)=a,b\n    if r1==r2:\n        step=1 if c2>=c1 else -1\n        return [(r1,c) for c in range(c1,c2+step,step)]\n    if c1==c2:\n        step=1 if r2>=r1 else -1\n        return [(r,c1) for r in range(r1,r2+step,step)]\n    raise ValueError\n\n\ndef cat(*parts):\n    out=[]\n    for part in parts:\n        if not part:\n            continue\n        if out and out[-1]==part[0]:\n            out.extend(part[1:])\n        else:\n            out.extend(part)\n    return out\n\n\ndef connect(a,b):\n    if a==b:\n        return [a]\n    if a[0]==b[0] or a[1]==b[1]:\n        return line_cells(a,b)\n    bends=[(a[0],b[1]),(b[0],a[1])]\n    random.shuffle(bends)\n    bend=bends[0]\n    return cat(line_cells(a,bend), line_cells(bend,b))\n\n\ndef sample_scene():\n    nr=random.randint(2,4)\n    nc=random.randint(2,4)\n    heights=[random.randint(2,5) for _ in range(nr)]\n    widths=[random.randint(2,5) for _ in range(nc)]\n    board_h=sum(heights)+nr+1\n    board_w=sum(widths)+nc+1\n    H,W=board_h+2,board_w+2\n    if H>30 or W>30:\n        return None\n    rb=[1]\n    for h in heights:\n        rb.append(rb[-1]+h+1)\n    cb=[1]\n    for w in widths:\n        cb.append(cb[-1]+w+1)\n    rects={}\n    for i in range(nr):\n        for j in range(nc):\n            rects[(i,j)]=(rb[i]+1, rb[i+1]-1, cb[j]+1, cb[j+1]-1)\n    side_pairs=[('top','bottom'),('top','right'),('left','bottom'),('left','right')]\n    start_side,end_side=random.choice(side_pairs)\n    def touches(cell, side):\n        i,j=cell\n        return {'top':i==0,'bottom':i==nr-1,'left':j==0,'right':j==nc-1}[side]\n    def neighbors(cell):\n        i,j=cell\n        out=[]\n        for di,dj in [(-1,0),(1,0),(0,-1),(0,1)]:\n            ni,nj=i+di,j+dj\n            if 0<=ni<nr and 0<=nj<nc:\n                out.append((ni,nj))\n        random.shuffle(out)\n        return out\n    def find_path():\n        total=nr*nc\n        lengths=list(range(min(8,total),2,-1))\n        random.shuffle(lengths)\n        starts=[cell for cell in rects if touches(cell,start_side)]\n        random.shuffle(starts)\n        for length in lengths:\n            for start in starts:\n                def dfs(path, seen):\n                    cur=path[-1]\n                    if len(path)==length:\n                        return path if touches(cur,end_side) and cur\"'!=start else None\n                    for nb in neighbors(cur):\n                        if nb in seen:\n                            continue\n                        res=dfs(path+[nb], seen|{nb})\n                        if res is not None:\n                            return res\n                        \n                    return None\n                res=dfs([start], {start})\n                if res is not None:\n                    return res\n        return None\n    region_path=find_path()\n    if region_path is None:\n        return None\n    colors={cell: random.choice(PALETTE) for cell in rects}\n    path_colors=[colors[cell] for cell in region_path]\n    if len(set(path_colors))<2:\n        # force at least one difference\n        colors[region_path[-1]]=random.choice([c for c in PALETTE if c!=colors[region_path[0]]])\n    grid=np.full((H,W), BLACK, dtype=int)\n    br0,br1,bc0,bc1=1,H-2,1,W-2\n    for r in rb:\n        grid[r, bc0:bc1+1]=GREY\n    for c in cb:\n        grid[br0:br1+1, c]=GREY\n    for cell,rect in rects.items():\n        r0,r1,c0,c1=rect\n        grid[r0:r1+1,c0:c1+1]=colors[cell]\n\n    def outer_port(rect, side):\n        r0,r1,c0,c1=rect\n        if side=='\"'top':\n            c=random.randint(c0,c1)\n            return (r0-1,c), (r0-2,c), 'top'\n        if side=='bottom':\n            c=random.randint(c0,c1)\n            return (r1+1,c), (r1+2,c), 'bottom'\n        if side=='left':\n            r=random.randint(r0,r1)\n            return (r,c0-1), (r,c0-2), 'left'\n        r=random.randint(r0,r1)\n        return (r,c1+1), (r,c1+2), 'right'\n\n    def shared(a,b):\n        ra=rects[a]; rb_=rects[b]\n        (ar0,ar1,ac0,ac1)=ra\n        (br0_,br1_,bc0_,bc1_)=rb_\n        ai,aj=a; bi,bj=b\n        if ai==bi and bj==aj+1:\n            r=random.randint(ar0,ar1)\n            return (r,ac1+1), ('right','left')\n        if ai==bi and bj==aj-1:\n            r=random.randint(ar0,ar1)\n            return (r,ac0-1), ('left','right')\n        if aj==bj and bi==ai+1:\n            c=random.randint(ac0,ac1)\n            return (ar1+1,c), ('bottom','top')\n        if aj==bj and bi==ai-1:\n            c=random.randint(ac0,ac1)\n            return (ar0-1,c), ('top','bottom')\n        raise ValueError\n\n    outer_start, start_edge, _ = outer_port(rects[region_path[0]], start_side)\n    outer_end, end_edge, _ = outer_port(rects[region_path[-1]], end_side)\n    entries={region_path[0]]: (start_side, outer_start)}\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
