ords.max(axis=0)\n    board = g[br0:br1+1, bc0:bc1+1]\n    row_bounds = []\n    for r in range(board.shape[0]):\n        row = board[r]\n        if np.all(np.isin(row, [GREY, MAROON])):\n            grey = int(np.count_nonzero(row == GREY))\n            maroon = int(np.count_nonzero(row == MAROON))\n            if grey > maroon:\n                row_bounds.append(br0 + r)\n    col_bounds = []\n    for c in range(board.shape[1]):\n        col = board[:, c]\n        if np.all(np.isin(col, [GREY, MAROON])):\n            grey = int(np.count_nonzero(col == GREY))\n            maroon = int(np.count_nonzero(col == MAROON))\n            if grey > maroon:\n                col_bounds.append(bc0 + c)\n    return (br0, br1, bc0, bc1), row_bounds, col_bounds\n\n\ndef build_scene():\n    nr = random.randint(2, 4)\n    nc = random.randint(2, 4)\n    heights = [random.randint(2, 5) for _ in range(nr)]\n    widths = [random.randint(2, 5) for _ in range(nc)]\n    board_h = sum(heights) + nr + 1\n    board_w = sum(widths) + nc + 1\n    H, W = board_h + 2, board_w + 2\n    if H > 30 or W > 30:\n        return None\n\n    row_bounds = [1]\n    for h in heights:\n        row_bounds.append(row_bounds[-1] + h + 1)\n    col_bounds = [1]\n    for w in widths:\n        col_bounds.append(col_bounds[-1] + w + 1)\n\n    rects = {}\n    for i in range(nr):\n        for j in range(nc):\n            rects[(i, j)] = (row_bounds[i] + 1, row_bounds[i + 1] - 1, col_bounds[j] + 1, col_bounds[j + 1] - 1)\n\n    def touches_side(cell, side):\n        i, j = cell\n        return {'\"'top': i == 0, 'bottom': i == nr - 1, 'left': j == 0, 'right': j == nc - 1}[side]\n\n    def neighbors(cell):\n        i, j = cell\n        nbrs = []\n        for di, dj in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            ni, nj = i + di, j + dj\n            if 0 <= ni < nr and 0 <= nj < nc:\n                nbrs.append((ni, nj))\n        random.shuffle(nbrs)\n        return nbrs\n\n    def random_region_path(start_side, end_side):\n        total = nr * nc\n        lengths = list(range(min(8, total), 2, -1))\n        random.shuffle(lengths)\n        starts = [cell for cell in rects if touches_side(cell, start_side)]\n        random.shuffle(starts)\n        for length in lengths:\n            for start in starts:\n                def dfs(path, seen):\n                    cur = path[-1]\n                    if len(path) == length:\n                        return path if touches_side(cur, end_side) and cur \"'!= start else None\n                    for nb in neighbors(cur):\n                        if nb in seen:\n                            continue\n                        res = dfs(path + [nb], seen | {nb})\n                        if res is not None:\n                            return res\n                    return None\n                res = dfs([start], {start})\n                if res is not None:\n                    return res\n        return None\n\n    start_side, end_side = random.choice(SIDE_PAIRS)\n    region_path = random_region_path(start_side, end_side)\n    if region_path is None:\n        return None\n\n    colors = {cell: random.choice(PALETTE) for cell in rects}\n    visited_colors = [colors[cell] for cell in region_path]\n    if len(set(visited_colors)) < 2:\n        colors[region_path[-1]] = random.choice([c for c in PALETTE if c != colors[region_path[0]]])\n\n    grid = np.full((H, W), BLACK, dtype=int)\n    board_r0, board_r1 = 1, H - 2\n    board_c0, board_c1 = 1, W - 2\n    for r in row_bounds:\n        grid[r, board_c0:board_c1 + 1] = GREY\n    for c in col_bounds:\n        grid[board_r0:board_r1 + 1, c] = GREY\n    for cell, rect in rects.items():\n        r0, r1, c0, c1 = rect\n        grid[r0:r1 + 1, c0:c1 + 1] = colors[cell]\n\n    def outer_port(rect, side):\n        r0, r1, c0, c1 = rect\n        if side == '\"'top':\n            c = random.randint(c0, c1)\n            return (r0 - 1, c), (r0 - 2, c)\n        if side == 'bottom':\n            c = random.ra