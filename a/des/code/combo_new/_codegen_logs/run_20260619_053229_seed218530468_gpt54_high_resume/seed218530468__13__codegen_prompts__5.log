th.append(end_edge)\n    if len(set(global_path)) \"'!= len(global_path):\n        return None\n    for r, c in global_path:\n        grid[r, c] = MAROON\n\n    bbox, found_rows, found_cols = detect_bounds(grid)\n    if bbox != (board_r0, board_r1, board_c0, board_c1):\n        return None\n    if found_rows != row_bounds or found_cols != col_bounds:\n        return None\n    return grid\n\n\nfor i in range(2000):\n    x = build_scene()\n    if x is not None:\n        print('\"'success', i, x.shape)\n        break\nelse:\n    print('none')\nPY\"","aggregated_output":"success 0 (17, 14)\n","exit_code":0,"status":"completed"}}
