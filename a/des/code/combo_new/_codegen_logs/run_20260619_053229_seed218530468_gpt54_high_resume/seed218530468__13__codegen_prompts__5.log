sertionError('\"'missing board')\n    br0, bc0 = coords.min(axis=0)\n    br1, bc1 = coords.max(axis=0)\n    board = g[br0:br1 + 1, bc0:bc1 + 1]\n    row_bounds = []\n    for r in range(board.shape[0]):\n        row = board[r]\n        if np.all(np.isin(row, [GREY, MAROON])):\n            grey = int(np.count_nonzero(row == GREY))\n            maroon = int(np.count_nonzero(row == MAROON))\n            if grey > maroon:\n                row_bounds.append(br0 + r)\n    col_bounds = []\n    for c in range(board.shape[1]):\n        col = board[:, c]\n        if np.all(np.isin(col, [GREY, MAROON])):\n            grey = int(np.count_nonzero(col == GREY))\n            maroon = int(np.count_nonzero(col == MAROON))\n            if grey > maroon:\n                col_bounds.append(bc0 + c)\n    return (br0, br1, bc0, bc1), row_bounds, col_bounds\n\n\ndef trace_path(g):\n    path = set(map(tuple, np.argwhere(g == MAROON)))\n    def nbrs(cell):\n        r, c = cell\n        out = []\n        for dr, dc in DIRS:\n            nr, nc = r + dr, c + dc\n            if (nr, nc) in path:\n                out.append((nr, nc))\n        return out\n    endpoints = [cell for cell in path if len(nbrs(cell)) == 1]\n    if len(endpoints) \"'!= 2:\n        raise AssertionError(('\"'bad endpoints', endpoints))\n    start_candidates = [cell for cell in endpoints if cell[0] == 0 or cell[1] == 0]\n    if len(start_candidates) == 1:\n        start = start_candidates[0]\n    else:\n        start = min(endpoints)\n    order = [start]\n    prev = None\n    cur = start\n    while True:\n        nexts = [nb for nb in nbrs(cur) if nb \"'!= prev]\n        if not nexts:\n            break\n        if len(nexts) != 1:\n            raise AssertionError(('\"'branch', cur, nexts))\n        prev, cur = cur, nexts[0]\n        order.append(cur)\n    if len(order) \"'!= len(path):\n        raise AssertionError('\"'disconnected path')\n    return order\n\n\ndef main(g):\n    g = np.asarray(g, dtype=int)\n    (br0, b