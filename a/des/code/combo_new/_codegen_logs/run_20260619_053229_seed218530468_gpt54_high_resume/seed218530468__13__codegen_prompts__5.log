{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nimport numpy as np\n\nBLACK = 0\nGREY = 5\nMAROON = 9\nPALETTE = [1, 2, 3, 4, 6, 7, 8]\nDIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\nSIDE_PAIRS = [('top', 'bottom'), ('top', 'right'), ('left', 'bottom'), ('left', 'right')]\n\n\ndef line_cells(a, b):\n    (r1, c1), (r2, c2) = a, b\n    if r1 == r2:\n        step = 1 if c2 >= c1 else -1\n        return [(r1, c) for c in range(c1, c2 + step, step)]\n    if c1 == c2:\n        step = 1 if r2 >= r1 else -1\n        return [(r, c1) for r in range(r1, r2 + step, step)]\n    raise ValueError('not axis-aligned')\n\n\ndef concat_parts(*parts):\n    out = []\n    for part in parts:\n        if not part:\n            continue\n        if out and out[-1] == part[0]:\n            out.extend(part[1:])\n        else:\n            out.extend(part)\n    return out\n\n\ndef connect_points(a, b):\n    if a == b:\n        return [a]\n    if a[0] == b[0] or a[1] == b[1]:\n        return line_cells(a, b)\n    bends = [(a[0], b[1]), (b[0], a[1])]\n    random.shuffle(bends)\n    bend = bends[0]\n    return concat_parts(line_cells(a, bend), line_cells(bend, b))\n\n\ndef inside_neighbor(rect, side, cell):\n    r0, r1, c0, c1 = rect\n    r, c = cell\n    if side == 'top':\n        return (r0, c)\n    if side == 'bottom':\n        return (r1, c)\n    if side == 'left':\n        return (r, c0)\n    if side == 'right':\n        return (r, c1)\n    raise ValueError(side)\n\n\ndef build_region_segment(rect, entry_side, entry_cell, exit_side, exit_cell):\n    q1 = inside_neighbor(rect, entry_side, entry_cell)\n    q2 = inside_neighbor(rect, exit_side, exit_cell)\n    middle = connect_points(q1, q2)\n    return concat_parts([entry_cell], middle, [exit_cell])\n\n\ndef build_scene():\n    nr = random.randint(2, 4)\n    nc = random.randint(2, 4)\n    heights = [random.randint(2, 5) for _ in range(nr)]\n    widths = [random.randint(2, 5) for _ in range(nc)]\n    board_h = sum(heights) + nr + 1\n    board_w = sum(widths) + nc + 1\n    H, W = board_h + 2, board_w + 2\n    if H > 30 or W > 30:\n        return None\n\n    row_bounds = [1]\n    for h in heights:\n        row_bounds.append(row_bounds[-1] + h + 1)\n    col_bounds = [1]\n    for w in widths:\n        col_bounds.append(col_bounds[-1] + w + 1)\n\n    rects = {}\n    for i in range(nr):\n        for j in range(nc):\n            rects[(i, j)] = (row_bounds[i] + 1, row_bounds[i + 1] - 1, col_bounds[j] + 1, col_bounds[j + 1] - 1)\n\n    def touches_side(cell, side):\n        i, j = cell\n        return {\n            'top': i == 0,\n            'bottom': i == nr - 1,\n            'left': j == 0,\n            'right': j == nc - 1,\n        }[side]\n\n    def neighbors(cell):\n        i, j = cell\n        nbrs = []\n        for di, dj in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            ni, nj = i + di, j + dj\n            if 0 <= ni < nr and 0 <= nj < nc:\n                nbrs.append((ni, nj))\n        random.shuffle(nbrs)\n        return nbrs\n\n    def random_region_path(start_side, end_side):\n        total = nr * nc\n        lengths = list(range(min(8, total), 2, -1))\n        random.shuffle(lengths)\n        starts = [cell for cell in rects if touches_side(cell, start_side)]\n        random.shuffle(starts)\n        for length in lengths:\n            for start in starts:\n                def dfs(path, seen):\n                    cur = path[-1]\n                    if len(path) == length:\n                        return path if touches_side(cur, end_side) and cur \"'!= start else None\n                    for nb in neighbors(cur):\n                        if nb in seen:\n                            continue\n                        res = dfs(path + [nb], seen | {nb})\n                        if res is not None:\n                            return res\n                    return None\n                res = dfs([start], {start})\n     