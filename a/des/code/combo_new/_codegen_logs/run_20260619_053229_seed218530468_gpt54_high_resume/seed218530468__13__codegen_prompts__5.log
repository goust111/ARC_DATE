     return (ar1 + 1, c), ('bottom', 'top')\n        if aj == bj and bi == ai - 1:\n            c = random.randint(ac0, ac1)\n            return (ar0 - 1, c), ('top', 'bottom')\n        raise ValueError('non-neighbor pair')\n\n    entry = {}\n    exit_ = {}\n    start_frame, start_edge = outer_port(rects[region_path[0]], start_side)\n    exit_[region_path[-1]] = (end_side, outer_port(rects[region_path[-1]], end_side)[0])\n    entry[region_path[0]] = (start_side, start_frame)\n    end_frame, end_edge = outer_port(rects[region_path[-1]], end_side)\n    exit_[region_path[-1]] = (end_side, end_frame)\n\n    for a, b in zip(region_path, region_path[1:]):\n        cell, (side_a, side_b) = shared_port(a, b)\n        exit_[a] = (side_a, cell)\n        entry[b] = (side_b, cell)\n\n    global_path = [start_edge]\n    used_counts = {}\n    for cell in region_path:\n        seg = build_region_segment(rects[cell], entry[cell][0], entry[cell][1], exit_[cell][0], exit_[cell][1])\n        if global_path[-1] == seg[0]:\n            global_path.extend(seg[1:])\n        else:\n            global_path.extend(seg)\n        r0, r1, c0, c1 = rects[cell]\n        in_region = {(r, c) for r, c in seg if r0 <= r <= r1 and c0 <= c <= c1}\n        if len(in_region) >= (r1 - r0 + 1) * (c1 - c0 + 1):\n            return None\n    global_path.append(end_edge)\n    if len(set(global_path)) \"'!= len(global_path):\n        return None\n    for r, c in global_path:\n        grid[r, c] = MAROON\n    return grid, rects, region_path\n\n\ndef trace_path(g):\n    path = set(map(tuple, np.argwhere(g == MAROON)))\n    def nbrs(cell):\n        r, c = cell\n        out = []\n        for dr, dc in DIRS:\n            nr, nc = r + dr, c + dc\n            if (nr, nc) in path:\n                out.append((nr, nc))\n        return out\n    endpoints = [cell for cell in path if len(nbrs(cell)) == 1]\n    assert len(endpoints) == 2, endpoints\n    start_candidates = [cell for cell in endpoints if cell[0] == 0 or cell[1] == 0]\n    if len(start_candidates) == 1:\n        start = start_candidates[0]\n    else:\n        start = min(endpoints)\n    order = [start]\n    prev = None\n    cur = start\n    while True:\n        nexts = [nb for nb in nbrs(cur) if nb != prev]\n        if not nexts:\n            break\n        assert len(nexts) == 1, (cur, nexts)\n        prev, cur = cur, nexts[0]\n        order.append(cur)\n    assert len(order) == len(path)\n    return order\n\n\ndef main(g):\n    g = np.asarray(g, dtype=int)\n    board_mask = (g != BLACK) & (g != MAROON)\n    coords = np.argwhere(board_mask)\n    br0, bc0 = coords.min(axis=0)\n    br1, bc1 = coords.max(axis=0)\n    board = g[br0:br1+1, bc0:bc1+1]\n    row_bounds = [br0 + r for r in range(board.shape[0]) if np.all(np.isin(board[r], [GREY, MAROON])) and np.any(board[r] == GREY)]\n    col_bounds = [bc0 + c for c in range(board.shape[1]) if np.all(np.isin(board[:, c], [GREY, MAROON])) and np.any(board[:, c] == GREY)]\n    region_map = -np.ones_like(g, dtype=int)\n    region_rects = []\n    region_colors = []\n    rid = 0\n    for ra, rb in zip(row_bounds, row_bounds[1:]):\n        for ca, cb in zip(col_bounds, col_bounds[1:]):\n            r0, r1 = ra + 1, rb - 1\n            c0, c1 = ca + 1, cb - 1\n            if r0 > r1 or c0 > c1:\n                continue\n            region_map[r0:r1+1, c0:c1+1] = rid\n            vals = [int(v) for v in g[r0:r1+1, c0:c1+1].ravel() if v != MAROON]\n            vals = [v for v in vals if v not in (BLACK, GREY)]\n            assert vals\n            region_rects.append((r0, r1, c0, c1))\n            region_colors.append(max(set(vals), key=vals.count))\n            rid += 1\n    order = trace_path(g)\n    seq = []\n    for cell in order:\n        rid = int(region_map[cell])\n        if rid >= 0 and (not seq or seq[-1] != rid):\n            seq.append(rid)\n    assert len(seq) >= 2\n    shift = {seq[i]: region_colors[seq[(i + 1) % len(seq)]] for i in range(len(seq))}\n    out = np.full_like(g, BLACK)\n    for r in row_bounds:\n        out[r, bc0:bc1+1] = GREY\n    for c in col_bounds:\n        out[br0:br1+1, c] = GREY\n    for rid, (r0, r1, c0, c1) in enumerate(region_rects):\n        out[r0:r1+1, c0:c1+1] = shift.get(rid, region_colors[rid])\n    return out\n\nfor i in range(200):\n    built = build_scene()\n    assert built is not None, i\n    grid, rects, path = built\n    out = main(grid)\n    assert out.shape == grid.shape\n    assert np.any(grid == MAROON)\nprint('\"'ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
