{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"awk '/\"'^def main'\"\\\\(/,/\"'^def generate_input'\"\\\\(/ {print} /\"'^def generate_input'\"\\\\(/,0 {print}' /home/lixinyu/snap/new/ARC_code/train/342ae2ed.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Draw the missing diagonal connector segment between each pair of same-color rectangular objects.\n\n    Input structure:\n    - The grid has one dominant background color.\n    - Every foreground color appears as exactly two separated solid rectangular 4-connected objects.\n    - The two rectangles of each color are diagonally offset with facing corners on a 45-degree line.\n\n    Rule:\n    - Keep all existing rectangles unchanged.\n    - For each foreground color, connect the lower facing corner of the upper rectangle to the upper facing corner of the lower rectangle.\n    - Paint only the intervening background pixels on that diagonal, excluding the two endpoint pixels already in the rectangles.\n\n    Key insight:\n    - Same-color rectangles define the endpoints; the output completes the open diagonal between their nearest facing corners.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    out = g.copy()\n\n    for color in colors_present(g, exclude={bg}):\n        components = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[color])\n        assert len(components) == 2, \"each foreground color must have exactly two objects\"\n\n        rectangles = [_assert_solid_rectangle(g, int(color), component) for component in components]\n        rectangles.sort(key=lambda b: b[0])\n        upper, lower = rectangles\n        start, end = _facing_corners(upper, lower)\n\n        row_delta = int(end[0] - start[0])\n        col_delta = int(end[1] - start[1])\n        assert row_delta > 0, \"connector must go downward from the upper rectangle\"\n        assert abs(row_delta) == abs(col_delta), \"facing corners must be diagonally aligned\"\n\n        dr = 1\n        dc = 1 if col_delta > 0 else -1\n        r, c = int(start[0] + dr), int(start[1] + dc)\n        while (r, c) != end:\n            assert int(out[r, c]) == bg, \"connector path must pass through background\"\n            out[r, c] = int(color)\n            r += dr\n            c += dc\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and palette.\nBG, N = 7, 16\nFOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n\n# Pair sampling and rectangle spacing.\nPAIR_COUNTS = [3, 4, 5]\nPAIR_COUNT_WEIGHTS = [4, 10, 60]\nLARGE_RECT_SIZE, SMALL_RECT_SIZE = 3, 2\nMIN_RECT_GAP = 2\n\n# Connector sampling and retry budget.\nDIRECTIONS = [1, -1]\nGAP_RANGE, MAX_ATTEMPTS = (2, 6), 300\n\nBox = tuple[int, int, int, int]\nCells = list[tuple[int, int]]\nCandidate = tuple[Box, Box, Cells]\n\n\ndef _bbox_gap_ok(a: Box, b: Box) -> bool:\n    ar0, ac0, ar1, ac1 = a\n    br0, bc0, br1, bc1 = b\n    row_gap = max(ar0 - br1 - 1, br0 - ar1 - 1, 0)\n    col_gap = max(ac0 - bc1 - 1, bc0 - ac1 - 1, 0)\n    return max(row_gap, col_gap) >= MIN_RECT_GAP\n\n\ndef _rect_cells(box: Box) -> Cells:\n    r0, c0, r1, c1 = box\n    return [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]\n\n\ndef _candidate(\n    size: int,\n    direction: int,\n    gap: int,\n    ur: int,\n    uc: int,\n) -> Candidate | None:\n    delta = gap + 1\n    upper = (ur, uc, ur + size - 1, uc + size - 1)\n    if direction == 1:\n        start = (upper[2], upper[3])\n        end = (start[0] + delta, start[1] + delta)\n        lower = (end[0], end[1], end[0] + size - 1, end[1] + size - 1)\n    else:\n        start = (upper[2], upper[1])\n        end = (start[0] + delta, start[1] - delta)\n        lower = (end[0], end[1] - size + 1, end[0] + size - 1, end[1])\n\n    if min(*upper, *lower) < 0 or max(upper[2], upper[3], lower[2], lower[3]) >= N:\n        return None\n    if not _bbox_gap_ok(upper, lower):\n        return None\n    diag = [(start[0] + k, start[1] + direction * k) for k in range(1, gap + 1)]\n    return upper, lower, diag\n\n\ndef _valid_candidates(\n    occupied: np.ndarray,\n    existing_rects: list[Box],\n    size: int,\n    direction: int,\n    gap: int,\n) -> list[Candidate]:\n    out = []\n    for ur in range(N - size + 1):\n        for uc in range(N - size + 1):\n            cand = _candidate(size, direction, gap, ur, uc)\n            if cand is None:\n                continue\n            upper, lower, diag = cand\n            if any(not _bbox_gap_ok(box, old) for box in (upper, lower) for old in existing_rects):\n                continue\n            cells = _rect_cells(upper) + _rect_cells(lower) + diag\n            if any(bool(occupied[r, c]) for r, c in cells):\n                continue\n            out.append(cand)\n    random.shuffle(out)\n    return out\n\n\ndef _place_rect(grid: np.ndarray, box: Box, color: int) -> None:\n    r0, c0, r1, c1 = box\n    grid[r0 : r1 + 1, c0 : c1 + 1] = color\n\n\ndef _sample_plan(n_pairs: int) -> tuple[list[int], list[int], list[int], list[int], list[int]]:\n    colors = random.sample(FOREGROUND_COLORS, n_pairs)\n    sizes = [LARGE_RECT_SIZE] + [SMALL_RECT_SIZE] * (n_pairs - 1)\n    random.shuffle(sizes)\n    directions = [1, -1] + [random.choice(DIRECTIONS) for _ in range(n_pairs - 2)]\n    random.shuffle(directions)\n    gaps = [random.randint(*GAP_RANGE) for _ in range(n_pairs)]\n    order = list(range(n_pairs))\n    random.shuffle(order)\n    order.sort(key=lambda i: (sizes[i], gaps[i]), reverse=True)\n    return colors, sizes, directions, gaps, order\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n_pairs = random.choices(PAIR_COUNTS, weights=PAIR_COUNT_WEIGHTS, k=1)[0]\n    colors, sizes, directions, gaps, order = _sample_plan(n_pairs)\n    output = np.full((N, N), BG, dtype=int)\n    occupied = np.zeros((N, N), dtype=bool)\n    rects: list[Box] = []\n    diagonals: list[Cells] = []\n\n    for idx in order:\n        cands = _valid_candidates(occupied, rects, sizes[idx], directions[idx], gaps[idx])\n        if not cands:\n            return None\n        upper, lower, diag = random.choice(cands)\n        color = colors[idx]\n        _place_rect(output, upper, color)\n        _place_rect(output, lower, color)\n        for r, c in diag:\n            output[r, c] = color\n        for r, c in _rect_cells(upper) + _rect_cells(lower) + diag:\n            occupied[r, c] = True\n        rects.extend([upper, lower])\n        diagonals.append(diag)\n\n    inp = output.copy()\n    for diag in diagonals:\n        for r, c in diag:\n            inp[r, c] = BG\n    try:\n        if np.array_equal(main(inp), output):\n            return inp\n    except Exception:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 342ae2ed input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"awk '/\"'^def main'\"\\\\(/,/\"'^def generate_input'\"\\\\(/ {print} /\"'^def generate_input'\"\\\\(/,0 {print}' /home/lixinyu/snap/new/ARC_code/eval/136b0064.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"awk '/\"'^def main'\"\\\\(/,/\"'^def generate_input'\"\\\\(/ {print} /\"'^def generate_input'\"\\\\(/,0 {print}' /home/lixinyu/snap/new/ARC_code/eval/136b0064.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Draw a polyline by decoding 3x3 glyph instructions read across a divided grid.\n\n    Input structure:\n    - Left of a full-height vertical divider: 3x3 colored glyphs on bg.\n    - Right of divider: a single gray (5) start pixel.\n\n    Rule:\n    - Remove the divider; shift the gray start into the left canvas.\n    - Read glyphs in column-major order (left→right, top→bottom).\n    - Each glyph's shape (pixel area) encodes a segment: area 4 → down 2, area 5 → right 3, area 6 → left 4, area 7 → left 2.\n    - Append segments sequentially, stepping down one cell between each.\n\n    Key insight: Glyph pixel count (area) uniquely determines both segment length and direction — the shape itself is the instruction.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # Divider is a full-height constant non-bg column.\n    div_c, div_color = find_full_height_constant_col(g, bg=bg)\n    assert div_c is not None\n\n    out = np.zeros((H, int(div_c)), dtype=int)\n\n    # Move gray start from right side into left canvas (remove divider col too).\n    gray = np.argwhere(g == 5)\n    if gray.size == 0:\n        return out\n    r_cur, c_cur = map(int, gray[0])\n    c_cur = int(c_cur - (int(div_c) + 1))\n    if not (0 <= c_cur < int(div_c)):\n        return out\n    out[int(r_cur), int(c_cur)] = 5\n\n    # Collect 3x3 glyph components on the left.\n    left = g[:, : int(div_c)]\n    ignore = {int(bg), 5}\n    if div_color is not None:\n        ignore.add(int(div_color))\n\n    glyphs: list[dict[str, int]] = []\n    for comp in find_components(left, bg=bg, connectivity=8, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        if col in ignore:\n            continue\n        b = comp[\"bbox\"]\n        if bbox_h(b) == 3 and bbox_w(b) == 3:\n            r0, c0, _r1, _c1 = map(int, b)\n            glyphs.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"area\": int(comp[\"area\"])})\n\n    glyphs.sort(key=lambda d: (int(d[\"c0\"]), int(d[\"r0\"])))\n\n    area_to_len = {4: 2, 5: 3, 6: 4, 7: 2}\n    area_to_dir = {5: 1, 6: -1, 7: -1}  # diamond right; cross/U left\n\n    for glyph in glyphs:\n        color = int(glyph[\"color\"])\n        area = int(glyph[\"area\"])\n        seg_len = int(area_to_len.get(area, 2))\n\n        r_cur = int(r_cur + 1)\n        assert r_cur < H, f\"segment exits bottom: r_cur={r_cur}, H={H}\"\n        out[r_cur, int(c_cur)] = color\n\n        if area == 4:  # vertical (down)\n            end_r = r_cur + (seg_len - 1)\n            assert end_r < H, f\"vertical segment exits bottom: end_r={end_r}, H={H}\"\n            for _ in range(seg_len - 1):\n                r_cur = int(r_cur + 1)\n                out[r_cur, int(c_cur)] = color\n        else:  # horizontal\n            dir_h = int(area_to_dir.get(area, 1))\n            end_c = int(c_cur) + dir_h * (seg_len - 1)\n            assert 0 <= end_c < int(div_c), (\n                f\"horizontal segment exits canvas: c_cur={c_cur}, dir={dir_h}, \"\n                f\"seg_len={seg_len}, div_c={div_c}\"\n            )\n            for _ in range(seg_len - 1):\n                c_cur = int(c_cur + dir_h)\n                out[r_cur, c_cur] = color\n\n    return out\n\n# --------------- generator (attempt 1 (Claude)) ---------------\n\n# --- canvas geometry ---\nN_MIN, N_MAX = 2, 5            # number of tile rows; H = 4*N - 1, num_glyphs = 2*N\nGRID_W = 15                    # full input width\nDIVIDER_COL = 7                # divider position (col), full-height\nDIVIDER_COLOR = 4              # divider fill color\nLEFT_W = 7                     # left canvas width (cols 0..6)\nTILE_COLS = (0, 4)             # 3x3 tile c0 positions on the left\nTILE_ROW_STRIDE = 4            # row spacing between successive tile slots\nGRAY = 5                       # start-pixel color\nGRAY_START_ROW = 0             # gray start always sits at row 0 [observed]\n\n# --- shape grammar (area -> 3x3 template, color, and (dr, dc) walk delta) ---\n# Walk delta = total (row, col) displacement caused by one glyph instruction:\n#   step down 1 then segment of (len, dir). E.g. area 4 (vertical len 2) => (+2, 0).\n_TEMPLATES = {\n    4: np.array([[1, 0, 1], [0, 1, 0], [0, 1, 0]], dtype=int),  # plus    -> down 2,  color 6\n    5: np.array([[1, 1, 0], [1, 0, 1], [0, 1, 0]], dtype=int),  # diamond -> right 3, color 1\n    6: np.array([[1, 1, 1], [0, 1, 0], [1, 0, 1]], dtype=int),  # cross   -> left 4,  color 3\n    7: np.array([[1, 0, 1], [1, 0, 1], [1, 1, 1]], dtype=int),  # U       -> left 2,  color 2\n}\n_AREA_TO_COLOR = {4: 6, 5: 1, 6: 3, 7: 2}\n_AREA_DELTA = {4: (2, 0), 5: (1, 2), 6: (1, -3), 7: (1, -1)}\n_AREAS = (4, 5, 6, 7)\n\n# --- generation constraints ---\nMIN_DIRECTION_CHANGES = 2      # min vertical<->horizontal flips across the walk\nMAX_ATTEMPTS = 300             # outer retry budget\n\n\ndef _sample_path(N: int, start_col: int) -> list[int] | None:\n    \"\"\"Random-walk a sequence of 2*N area instructions that stays in the left canvas.\n\n    Returns None if the walk dead-ends or fails the direction-change constraint.\n    \"\"\"\n    H = 4 * N - 1\n    r, c = GRAY_START_ROW, start_col\n    areas: list[int] = []\n    for _ in range(2 * N):\n        opts = [a for a in _AREAS\n                if r + _AREA_DELTA[a][0] < H and 0 <= c + _AREA_DELTA[a][1] < LEFT_W]\n        if not opts:\n            return None\n        area = random.choice(opts)\n        areas.append(area)\n        dr, dc = _AREA_DELTA[area]\n        r += dr\n        c += dc\n\n    types = [a == 4 for a in areas]  # True = vertical, False = horizontal\n    changes = sum(1 for i in range(1, len(types)) if types[i] != types[i - 1])\n    if changes < MIN_DIRECTION_CHANGES:\n        return None\n    return areas\n\n\ndef _render_grid(N: int, start_col: int, areas: list[int]) -> np.ndarray:\n    \"\"\"Paint divider, gray start, and all 2*N tiled glyphs into the input grid.\"\"\"\n    H = 4 * N - 1\n    grid = np.zeros((H, GRID_W), dtype=int)\n    grid[:, DIVIDER_COL] = DIVIDER_COLOR\n    grid[GRAY_START_ROW, DIVIDER_COL + 1 + start_col] = GRAY\n\n    # Column-major tiling: first N glyphs into TILE_COLS[0], next N into TILE_COLS[1].\n    for i, area in enumerate(areas):\n        tile_col = TILE_COLS[i // N]\n        r0 = TILE_ROW_STRIDE * (i % N)\n        grid[r0:r0 + 3, tile_col:tile_col + 3] = _TEMPLATES[area] * _AREA_TO_COLOR[area]\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    N = random.randint(N_MIN, N_MAX)\n    start_col = random.randint(0, LEFT_W - 1)\n    areas = _sample_path(N, start_col)\n    if areas is None:\n        return None\n    return _render_grid(N, start_col, areas)\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        try:\n            inp = _gen_attempt()\n            if inp is None:\n                continue\n            out = main(inp)  # oracle check\n            if out.shape != (inp.shape[0], LEFT_W):\n                continue\n            return inp\n        except Exception:\n            continue\n    raise RuntimeError(f\"generate_input: failed after {MAX_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"awk '/\"'^def main'\"\\\\(/,/\"'^def generate_input'\"\\\\(/ {print} /\"'^def generate_input'\"\\\\(/,0 {print}' /home/lixinyu/snap/new/ARC_code/train/7e2bad24.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"awk '/\"'^def main'\"\\\\(/,/\"'^def generate_input'\"\\\\(/ {print} /\"'^def generate_input'\"\\\\(/,0 {print}' /home/lixinyu/snap/new/ARC_code/train/7e2bad24.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extend the diagonal blue ray through the grid, reflecting it off red line-segment mirrors.\n\n    Input structure\n    - Black-background grid with one diagonal 8-connected blue ray seed.\n    - Red foreground objects, when present, are straight horizontal or vertical mirror segments.\n    - Other foreground bars are transparent to the ray and may be overwritten where the ray crosses them.\n\n    Rule\n    - Start from the ray seed endpoint whose outward diagonal extension remains inside the grid.\n    - Paint the ray continuously in that diagonal direction until it leaves the grid.\n    - If the next cell is a red mirror, do not paint it; reflect by flipping the row direction on a horizontal mirror or the column direction on a vertical mirror.\n\n    Key insight\n    - The non-red bars are decoys: only red bars reflect the diagonal path, while all other crossed cells become blue.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    ray_color, seed = _ray_seed(g, bg)\n    r, c, dr, dc = _initial_state(g.shape, seed)\n    mirrors = _mirror_orientations(g, bg)\n\n    out = g.copy()\n    seen: set[tuple[int, int, int, int]] = set()\n    while True:\n        state = (r, c, dr, dc)\n        assert state not in seen, \"ray path must not loop\"\n        seen.add(state)\n\n        nr, nc = r + dr, c + dc\n        if not in_bounds(g.shape, nr, nc):\n            break\n\n        if int(g[nr, nc]) == Color.RED:\n            orientation = mirrors.get((nr, nc))\n            assert orientation is not None, \"red cell must belong to a mirror segment\"\n            if orientation == \"horizontal\":\n                dr = -dr\n            else:\n                assert orientation == \"vertical\"\n                dc = -dc\n            continue\n\n        out[nr, nc] = ray_color\n        r, c = nr, nc\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and color layout.\nGRID_HEIGHT = 16\nGRID_WIDTH = 16\nBACKGROUND_COLOR = 0\n\n# Ray and seed sampling ranges.\nREFLECTION_COUNT_RANGE = (0, 4)\nSEED_LENGTH_RANGE = (3, 6)\nTOTAL_PATH_LENGTH_RANGE = (15, 16)\nNEW_CELLS_RANGE = (9, 13)\nDIAGONAL_CHOICES = (-1, 1)\nSTART_EDGES = (\"top\", \"bottom\", \"left\", \"right\")\n\n# Bar structure ranges and orientations.\nBAR_LENGTH_RANGE = (4, 14)\nMIRROR_ORIENTATIONS = [\"horizontal\", \"vertical\"]\nDECOY_COUNT_RANGE = (0, 3)\nDECOY_PLACEMENT_ATTEMPTS = 30\n\n# Rejection sampling budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _inside(r: int, c: int) -> bool:\n    return 0 <= r < GRID_HEIGHT and 0 <= c < GRID_WIDTH\n\n\ndef _random_start_state() -> tuple[int, int, int, int]:\n    \"\"\"Choose a boundary cell with a diagonal direction whose backward extension is OOB.\"\"\"\n    edge = random.choice(START_EDGES)\n    if edge == \"top\":\n        return 0, random.randint(0, GRID_WIDTH - 1), 1, random.choice(DIAGONAL_CHOICES)\n    if edge == \"bottom\":\n        return (\n            GRID_HEIGHT - 1,\n            random.randint(0, GRID_WIDTH - 1),\n            -1,\n            random.choice(DIAGONAL_CHOICES),\n        )\n    if edge == \"left\":\n        return random.randint(0, GRID_HEIGHT - 1), 0, random.choice(DIAGONAL_CHOICES), 1\n    return (\n        random.randint(0, GRID_HEIGHT - 1),\n        GRID_WIDTH - 1,\n        random.choice(DIAGONAL_CHOICES),\n        -1,\n    )\n\n\ndef _build_seed_cells(\n    r0: int,\n    c0: int,\n    dr: int,\n    dc: int,\n    seed_len: int,\n) -> list[tuple[int, int]] | None:\n    cells = []\n    for i in range(seed_len):\n        sr, sc = r0 + i * dr, c0 + i * dc\n        if not _inside(sr, sc):\n            return None\n        cells.append((sr, sc))\n    return cells\n\n\ndef _split_path_segments(new_cells_needed: int, n_reflections: int) -> list[int] | None:\n    \"\"\"Partition painted cells across straight ray segments before each reflection.\"\"\"\n    if n_reflections == 0:\n        return [new_cells_needed]\n    if new_cells_needed < n_reflections + 1:\n        return None\n\n    cuts = sorted(random.sample(range(1, new_cells_needed), n_reflections))\n    segments = []\n    prev = 0\n    for cut in cuts:\n        segments.append(cut - prev)\n        prev = cut\n    segments.append(new_cells_needed - prev)\n    return segments\n\n\ndef _walk_segment(\n    r: int,\n    c: int,\n    dr: int,\n    dc: int,\n    seg_len: int,\n    occupied: set[tuple[int, int]],\n    path_cells: list[tuple[int, int]],\n) -> tuple[int, int] | None:\n    \"\"\"Append seg_len new ray cells and return the segment endpoint.\"\"\"\n    for _ in range(seg_len):\n        nr, nc = r + dr, c + dc\n        if not _inside(nr, nc) or (nr, nc) in occupied:\n            return None\n        path_cells.append((nr, nc))\n        occupied.add((nr, nc))\n        r, c = nr, nc\n    return r, c\n\n\ndef _reflected_direction(orientation: str, dr: int, dc: int) -> tuple[int, int]:\n    if orientation == \"horizontal\":\n        return -dr, dc\n    return dr, -dc\n\n\ndef _segment_start_bounds(anchor: int, length: int, limit: int) -> tuple[int, int] | None:\n    start_min = max(0, anchor - length + 1)\n    start_max = min(anchor, limit - length)\n    if start_min > start_max:\n        return None\n\n    interior_min = max(start_min, 1)\n    interior_max = min(start_max, limit - length - 1) if length < limit else start_max\n    if interior_min <= interior_max:\n        return interior_min, interior_max\n    return start_min, start_max\n\n\ndef _bar_cells_through(\n    orientation: str,\n    r: int,\n    c: int,\n    length: int,\n) -> list[tuple[int, int]] | None:\n    if orientation == \"horizontal\":\n        bounds = _segment_start_bounds(c, length, GRID_WIDTH)\n        if bounds is None:\n            return None\n        start = random.randint(*bounds)\n        return [(r, start + j) for j in range(length)]\n\n    bounds = _segment_start_bounds(r, length, GRID_HEIGHT)\n    if bounds is None:\n        return None\n    start = random.randint(*bounds)\n    return [(start + j, c) for j in range(length)]\n\n\ndef _try_place_mirror(\n    r: int,\n    c: int,\n    dr: int,\n    dc: int,\n    occupied: set[tuple[int, int]],\n) -> tuple[str, list[tuple[int, int]], int, int] | None:\n    \"\"\"Try both mirror orientations at the next ray cell and return the reflected direction.\"\"\"\n    mr, mc = r + dr, c + dc\n    if not _inside(mr, mc) or (mr, mc) in occupied:\n        return None\n\n    orientations = MIRROR_ORIENTATIONS.copy()\n    random.shuffle(orientations)\n    for orientation in orientations:\n        new_dr, new_dc = _reflected_direction(orientation, dr, dc)\n        next_r, next_c = r + new_dr, c + new_dc\n        if not _inside(next_r, next_c) or (next_r, next_c) in occupied:\n            continue\n\n        bar_len = random.randint(*BAR_LENGTH_RANGE)\n        bar_cells = _bar_cells_through(orientation, mr, mc, bar_len)\n        if bar_cells is None:\n            continue\n\n        bar_set = set(bar_cells)\n        if bar_set & occupied:\n            continue\n\n        occupied |= bar_set\n        return orientation, bar_cells, new_dr, new_dc\n    return None\n\n\ndef _random_decoy_cells(orientation: str, length: int) -> list[tuple[int, int]] | None:\n    if orientation == \"horizontal\":\n        row = random.randint(0, GRID_HEIGHT - 1)\n        start = random.randint(0, max(0, GRID_WIDTH - length))\n        start = max(1, min(start, GRID_WIDTH - length - 1))\n        if start < 0 or start + length > GRID_WIDTH:\n            return None\n        return [(row, start + j) for j in range(length)]\n\n    col = random.randint(0, GRID_WIDTH - 1)\n    start = random.randint(0, max(0, GRID_HEIGHT - length))\n    start = max(1, min(start, GRID_HEIGHT - length - 1))\n    if start < 0 or start + length > GRID_HEIGHT:\n        return None\n    return [(start + j, col) for j in range(length)]\n\n\ndef _place_decoys(\n    occupied: set[tuple[int, int]],\n    path_cells: list[tuple[int, int]],\n) -> list[list[tuple[int, int]]]:\n    decoy_bars = []\n    path_set = set(path_cells)\n    for _ in range(random.randint(*DECOY_COUNT_RANGE)):\n        orientation = random.choice(MIRROR_ORIENTATIONS)\n        length = random.randint(*BAR_LENGTH_RANGE)\n\n        for _ in range(DECOY_PLACEMENT_ATTEMPTS):\n            cells = _random_decoy_cells(orientation, length)\n            if cells is None:\n                continue\n\n            cell_set = set(cells)\n            if cell_set & occupied:\n                continue\n            if len(cell_set & path_set) > 2:\n                continue\n\n            decoy_bars.append(cells)\n            occupied |= cell_set\n            break\n    return decoy_bars\n\n\ndef _paint_cells(grid: np.ndarray, cells: list[tuple[int, int]], color: int) -> None:\n    for r, c in cells:\n        grid[r, c] = color\n\n\ndef _render_input(\n    seed_cells: list[tuple[int, int]],\n    mirror_bars: list[tuple[str, list[tuple[int, int]]]],\n    decoy_bars: list[list[tuple[int, int]]],\n) -> np.ndarray:\n    grid = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)\n    _paint_cells(grid, seed_cells, Color.BLUE)\n    for _orientation, bar_cells in mirror_bars:\n        _paint_cells(grid, bar_cells, Color.RED)\n    for cells in decoy_bars:\n        _paint_cells(grid, cells, Color.GREEN)\n    return grid\n\n\ndef _matches_solver_oracle(\n    grid: np.ndarray,\n    seed_cells: list[tuple[int, int]],\n    path_cells: list[tuple[int, int]],\n) -> bool:\n    try:\n        output = main(grid)\n    except Exception:\n        return False\n\n    expected = grid.copy()\n    _paint_cells(expected, path_cells, Color.BLUE)\n    if not np.array_equal(output, expected):\n        return False\n\n    new_count = len(path_cells)\n    total_path = len(seed_cells) + new_count\n    return (\n        NEW_CELLS_RANGE[0] <= new_count <= NEW_CELLS_RANGE[1]\n        and TOTAL_PATH_LENGTH_RANGE[0] <= total_path <= TOTAL_PATH_LENGTH_RANGE[1]\n    )\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n_reflections = random.randint(*REFLECTION_COUNT_RANGE)\n    r0, c0, dr, dc = _random_start_state()\n    br, bc = r0 - dr, c0 - dc\n    if _inside(br, bc):\n        return None\n\n    seed_len = random.randint(*SEED_LENGTH_RANGE)\n    seed_cells = _build_seed_cells(r0, c0, dr, dc, seed_len)\n    if seed_cells is None:\n        return None\n\n    total_target = random.randint(*TOTAL_PATH_LENGTH_RANGE)\n    new_cells_needed = total_target - seed_len\n    segments = _split_path_segments(new_cells_needed, n_reflections)\n    if segments is None:\n        return None\n\n    r, c = seed_cells[-1]\n    cur_dr, cur_dc = dr, dc\n    occupied = set(seed_cells)\n    path_cells: list[tuple[int, int]] = []\n    mirror_bars: list[tuple[str, list[tuple[int, int]]]] = []\n\n    for seg_idx, seg_len in enumerate(segments):\n        endpoint = _walk_segment(r, c, cur_dr, cur_dc, seg_len, occupied, path_cells)\n        if endpoint is None:\n            return None\n        r, c = endpoint\n\n        if seg_idx < n_reflections:\n            placed_mirror = _try_place_mirror(r, c, cur_dr, cur_dc, occupied)\n            if placed_mirror is None:\n                return None\n            orientation, bar_cells, cur_dr, cur_dc = placed_mirror\n            mirror_bars.append((orientation, bar_cells))\n\n    final_nr, final_nc = r + cur_dr, c + cur_dc\n    if _inside(final_nr, final_nc):\n        return None\n\n    decoy_bars = _place_decoys(occupied, path_cells)\n    grid = _render_input(seed_cells, mirror_bars, decoy_bars)\n    if not _matches_solver_oracle(grid, seed_cells, path_cells):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
