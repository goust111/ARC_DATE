{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect framed squares via colored bridges following a control-pixel sequence.\n\n    Input structure:\n    - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.\n    - Control row below squares: colored pixels read left-to-right encode visitation order.\n\n    Rule:\n    - Start at the square matching first control color c0.\n    - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.\n    - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.\n\n    Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # border color = most common non-bg color\n    cnt = Counter(map(int, g.flatten()))\n    border = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            border = int(col)\n            break\n    assert not (border is None)\n\n    # detect framed squares as connected components of the border color\n    lab, n = label_mask(g == int(border), connectivity=4)\n    frames: list[dict] = []\n    for cid in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(cid))\n        if int(pts.shape[0]) < 8:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        if h < 3 or w < 3:\n            continue\n\n        t = None\n        inner_col = None\n        for tt in range(1, int(min(h, w) // 2) + 1):\n            inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]\n            if inner.size == 0:\n                continue\n            if bool((inner == int(border)).any()):\n                continue\n            u = set(map(int, inner.flatten()))\n            if len(u) != 1:\n                continue\n\n            ok = True\n            if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not ok:\n                continue\n\n            t = int(tt)\n            inner_col = int(next(iter(u)))\n            break\n\n        if t is None or inner_col is None:\n            continue\n\n        frames.append(\n            {\n                \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n                \"t\": int(t),\n                \"inner\": int(inner_col),\n                \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            }\n        )\n\n    assert not (not frames)\n\n    by: dict[int, list[dict]] = defaultdict(list)\n    for f in frames:\n        by[int(f[\"inner\"])].append(f)\n\n    max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n\n    # control row = bottom-most row below the squares with >=2 non-bg pixels\n    ctrl_r = None\n    for r in range(int(H - 1), int(max_frame_r), -1):\n        if int((g[int(r)] != int(bg)).sum()) >= 2:\n            ctrl_r = int(r)\n            break\n    assert not (ctrl_r is None)\n\n    ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n    assert not (len(ctrl) < 2)\n\n    def center(f: dict) -> tuple[int, int]:\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        return int((r0 + r1) // 2), int((c0 + c1) // 2)\n\n    def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n        a = f1[\"inner_bbox\"]\n        b = f2[\"inner_bbox\"]\n        same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n        same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))\n        return same_row, same_col\n\n    # choose start frame\n    start_color = int(ctrl[0])\n    assert not (start_color not in by)\n    start_cands = by[start_color]\n    if len(start_cands) == 1:\n        cur = start_cands[0]\n    else:\n        nxt_color = int(ctrl[1])\n        nxt_cands = by.get(nxt_color, [])\n        best = None\n        bestf = None\n        for f in start_cands:\n            for g2 in (nxt_cands if nxt_cands else [f]):\n                sr, sc = aligned(f, g2)\n                al = 1 if (sr or sc) else 0\n                (r1_, c1_) = center(f)\n                (r2_, c2_) = center(g2)\n                d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n                cand = (int(al), -int(d))\n                if best is None or cand > best:\n                    best = cand\n                    bestf = f\n        cur = bestf\n\n    out = g.copy()\n\n    def draw_bridge(fa: dict, fb: dict, color: int) -> None:\n        (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n        (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n        ia = fa[\"inner_bbox\"]\n        sr, sc = aligned(fa, fb)\n        if sr:\n            rr0, rr1 = int(ia[0]), int(ia[2])\n            if int(c1a) < int(c0b):\n                cc0, cc1 = int(c1a + 1), int(c0b - 1)\n            else:\n                cc0, cc1 = int(c1b + 1), int(c0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n            return\n        if sc:\n            cc0, cc1 = int(ia[1]), int(ia[3])\n            if int(r1a) < int(r0b):\n                rr0, rr1 = int(r1a + 1), int(r0b - 1)\n            else:\n                rr0, rr1 = int(r1b + 1), int(r0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n\n    for i in range(int(len(ctrl)) - 1):\n        a = int(ctrl[i])\n        b = int(ctrl[i + 1])\n        assert int(cur[\"inner\"]) == int(a)\n        assert b in by, f\"control color {b} has no matching frame\"\n        cands = by[b]\n        best = None\n        bestf = None\n        for f in cands:\n            sr, sc = aligned(cur, f)\n            al = 1 if (sr or sc) else 0\n            (r1_, c1_) = center(cur)\n            (r2_, c2_) = center(f)\n            d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n            cand = (int(al), -int(d))\n            if best is None or cand > best:\n                best = cand\n                bestf = f\n        nxt = bestf\n        draw_bridge(cur, nxt, int(a))\n        cur = nxt\n\n    return out\n\n\ndef _most_common_nonbg(g: np.ndarray, bg: int) -> int | None:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/5961cc34.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Build a red ray network by activating blue blobs via directional green ports.\n\n    Input structure:\n    - bg = most common color. Large blue blobs with adjacent green pixels marking port directions.\n    - Start marker: yellow pixel atop a short red segment at grid bottom.\n\n    Rule:\n    - Extend a ray upward from start; on hitting a blue blob, recolor it red.\n    - Activated blobs emit thick rays through green ports until boundary or another blob.\n    - Cascade until no new blobs are reached.\n\n    Key insight: Green pixels encode ray direction and width; the network activates as a chain reaction from one start point.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # --- STEP 1) Detect the start \"port\" (red vertical segment with a non-red cap above) ---\n    start_candidates: list[tuple[int, int, int, list[tuple[int, int]]]] = []\n\n    for col in colors_present(g, exclude={bg}):\n        for coords in components_mask(g == int(col), connectivity=8):\n            if coords.size == 0:\n                continue\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n\n            # thin vertical segment, height>=2, touches bottom\n            if c0 != c1 or (r1 - r0 + 1) < 2:\n                continue\n            if r1 != int(H - 1):\n                continue\n            # solid vertical segment\n            if any(int(g[rr, c0]) != int(col) for rr in range(int(r0), int(r1) + 1)):\n                continue\n            if int(r0) - 1 < 0:\n                continue\n            cap = int(g[int(r0) - 1, int(c0)])\n            if cap == int(bg) or cap == int(col):\n                continue\n\n            start_candidates.append(\n                (\n                    int(col),\n                    int(cap),\n                    int(c0),\n                    [(int(rr), int(c0)) for rr in range(int(r0), int(r1) + 1)],\n                )\n            )\n\n    assert len(start_candidates) == 1\n    red_col, yellow_col, start_col, start_seg = start_candidates[0]\n\n    # --- STEP 2) Identify blob colors ---\n    # Blue = dominant remaining color by pixel count (excluding bg/start colors).\n    counts = Counter(map(int, g.flatten()))\n    other_cols = [(int(cnt), int(col)) for col, cnt in counts.items() if int(col) not in (bg, red_col, yellow_col)]\n    assert other_cols\n    max_count = max(cnt for cnt, _col in other_cols)\n    blue_candidates = [int(col) for cnt, col in other_cols if cnt == max_count]\n    assert len(blue_candidates) == 1\n    blue_col = int(blue_candidates[0])\n\n    # Green = the unique other color that is 4-adjacent to blue.\n    green_candidates: list[int] = []\n    for col in colors_present(g, exclude={bg, red_col, yellow_col, blue_col}):\n        pts = np.argwhere(g == int(col))\n        if pts.size == 0:\n            continue\n        ok = False\n        for r, c in pts:\n            r = int(r)\n            c = int(c)\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + dr)\n                cc = int(c + dc)\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(blue_col):\n                    ok = True\n                    break\n            if ok:\n                break\n        if ok:\n            green_candidates.append(int(col))\n\n    assert len(green_candidates) == 1\n    green_col = int(green_candidates[0])\n\n    out = np.full_like(g, int(bg))\n\n    # --- STEP 3) Extract blue blobs as connected components, and build a pixel->blob map ---\n    blob_id = np.full((H, W), -1, dtype=int)\n    blobs: list[dict] = []\n\n    for coords in components_mask(g == int(blue_col), connectivity=8):\n        pts = [(int(r), int(c)) for r, c in coords]\n        bi = int(len(blobs))\n        for r, c in pts:\n            blob_id[int(r), int(c)] = bi\n        blobs.append({\"pts\": pts, \"ports\": []})\n\n    # --- STEP 4) For each blob, find its ports from adjacent green markers ---\n    for blob in blobs:\n        pts = blob[\"pts\"]\n        seen_dirs: set[tuple[int, int]] = set()\n        for r, c in pts:\n            for ddr, ddc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + ddr)\n                cc = int(c + ddc)\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(green_col):\n                    seen_dirs.add((int(ddr), int(ddc)))\n        for ddr, ddc in seen_dirs:\n            port_pixels = [\n                (int(r), int(c))\n                for (r, c) in pts\n                if 0 <= int(r + ddr) < H and 0 <= int(c + ddc) < W and int(g[int(r + ddr), int(c + ddc)]) == int(green_col)\n            ]\n            assert port_pixels\n            blob[\"ports\"].append({\"dir\": (int(ddr), int(ddc)), \"pixels\": port_pixels})\n\n    activated: set[int] = set()\n    queue: list[int] = []\n\n    def activate_blob_at(r: int, c: int) -> None:\n        \"\"\"Recolor a blob to red when first hit by a ray; enqueue it to emit its ports.\"\"\"\n        bi = int(blob_id[int(r), int(c)])\n        assert bi >= 0\n        if bi in activated:\n            return\n        activated.add(int(bi))\n        queue.append(int(bi))\n        for pr, pc in blobs[bi][\"pts\"]:\n            out[int(pr), int(pc)] = int(red_col)\n\n    # --- STEP 5) Draw the start ray upward (thin) and stop at the first blob hit ---\n    for r, c in start_seg:\n        out[int(r), int(c)] = int(red_col)\n    top_r = min(int(r) for r, _c in start_seg)\n    assert int(top_r) > 0 and int(g[int(top_r) - 1, int(start_col)]) == int(yellow_col)\n    out[int(top_r) - 1, int(start_col)] = int(red_col)\n    for r in range(int(top_r) - 1, -1, -1):\n        out[int(r), int(start_col)] = int(red_col)\n        if int(g[int(r), int(start_col)]) == int(blue_col):\n            activate_blob_at(int(r), int(start_col))\n            break\n\n    def extend_thick(port_pixels: list[tuple[int, int]], d: tuple[int, int]) -> None:\n        \"\"\"Extend a ray from each port pixel until boundary or blob hit.\"\"\"\n        ddr, ddc = map(int, d)\n        for pr, pc in port_pixels:\n            r, c = int(pr), int(pc)\n            while True:\n                r += int(ddr)\n                c += int(ddc)\n                if not (0 <= r < H and 0 <= c < W):\n                    break\n                out[int(r), int(c)] = int(red_col)\n                if int(g[int(r), int(c)]) == int(blue_col):\n                    activate_blob_at(int(r), int(c))\n                    break\n\n    # --- STEP 6) Propagate (BFS): activated blob -> emit rays -> activate more blobs ---\n    while queue:\n        bi = int(queue.pop(0))\n        for port in blobs[bi][\"ports\"]:\n            extend_thick(port[\"pixels\"], port[\"dir\"])\n\n    assert len(blobs) - len(activated) <= 1, \"at most 1 distractor blob\"\n\n    return out\n\n# --------------- generator (a2_cascade) ---------------\n\nfrom arc_utils import paint_coords\n\n# --- Colors ---\nBG = 8\nBLUE = 1\nRED = 2\nGREEN = 3\nYELLOW = 4\n\n# --- Directions ---\nUP = (-1, 0)\nDOWN = (1, 0)\nLEFT = (0, -1)\nRIGHT = (0, 1)\nDIRS = (UP, DOWN, LEFT, RIGHT)\nOPP = {UP: DOWN, DOWN: UP, LEFT: RIGHT, RIGHT: LEFT}\n\n# --- Diamond/octagon shapes (h, w) ---\nSHAPES = ((3, 4), (4, 4), (5, 4), (5, 6), (6, 6), (8, 8))\n_SHAPE_WIDTHS = {\n    (3, 4): (2, 4, 2),\n    (4, 4): (2, 4, 4, 2),\n    (5, 4): (2, 4, 4, 4, 2),\n    (5, 6): (2, 4, 6, 4, 2),\n    (6, 6): (2, 4, 6, 6, 4, 2),\n    (8, 8): (2, 4, 6, 8, 8, 6, 4, 2),\n}\n\n# --- Canvas bounds ---\nH_MIN, H_MAX = 13, 27\nW_MIN, W_MAX = 15, 27\nSTART_COL_PAD = 2        # min distance from start column to grid edge\n\n# --- Start segment ---\nSTART_H_MIN, START_H_MAX = 2, 3  # red segment height (below yellow cap)\n\n# --- Chain / distractor ---\nCHAIN_LEN_WEIGHTS = [1, 3, 3, 3]  # weights for chain_len in [0, 1, 2, 3]\nMAX_BLOB_COUNT = 4                 # chain + distractors combined\nMAX_DISTRACTORS = 1\n\n# --- Placement ---\nMIN_GAP_FIRST = 4   # along-axis gap between start and first blob\nMIN_GAP_CHAIN = 3   # along-axis gap between successive chain blobs\n\n# --- Retry ---\nGEN_RETRIES = 300\n\n\ndef _shape_mask(h: int, w: int) -> np.ndarray:\n","exit_code":0,"status":"completed"}}
