ld_endpoints_pair(h, w, colors, rng)\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/12/code.py:726:        return build_comp_checker_pair(h, w, colors, rng)\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/12/code.py:728:        return build_invert0_pair(h, w, colors, rng)\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/12/code.py:730:        return build_sym_pair(h, w, colors, rng, params[\"idx\"])\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/12/code.py:732:        return build_sym_fill_pair(h, w, colors, rng, params[\"keep0\"])\n/home/lixinyu/snap/new/ceshi/code_combo/4c7dc4dd/12/code.py:737:    return build_training_pair(kind, params, h, w, colors, rng)[0]\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/12/code.py:272:    Grow a recursive diagonal lattice from blue endpoint pairs and then color the cells trapped inside it.\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/18/code.py:401:    - Use only diagonal row/column pairings per mover color.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/3/code.py:45:#       the old solver transformed one endpoint token and copied a complement outward; the new solver\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/3/code.py:46:#       requires a complementary pair and performs one inward aggregation event.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/3/code.py:60:#     requires pairing two endpoint fragments of the same color and opposite kinds.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/3/code.py:452:    Merge complementary endpoint fragments through wire networks into central solid blocks.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/3/code.py:460:    - When the two endpoint tokens on a route are complementary fragments of the same color\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/3/code.py:466:      decomposing and sending a complement outward, two partial shapes converge and recombine centrally.\n/home/lixinyu/snap/new/ceshi/code_combo/b5ca7ac4/22/code.py:59:#    - Same-color overlaps are pairwise only, and cross-color output collisions are forbidden.\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/26/code.py:25:#   1. Read one diagonal pair per color in the left strip. Example: color 4 at\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/26/code.py:294:    movers = [p for p in pairs if int(p[\"color\"]) in targets]\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/26/code.py:321:def _make_diagonal_pair(color: int, h: int, w: int) -> np.ndarray:\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/26/code.py:325:        pair[0, 0] = int(color)\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/26/code.py:326:        pair[int(h) - 1, int(w) - 1] = int(color)\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/26/code.py:328:        pair[0, int(w) - 1] = int(color)\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/26/code.py:329:        pair[int(h) - 1, 0] = int(color)\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/26/code.py:490:    for mc, pair in zip(mover_colors, mover_pairs):\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/26/code.py:531:    for mc, pair in zip(mover_colors, mover_pairs):\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/26/code.py:534:        pair = _make_diagonal_pair(int(dc_color), int(heights[n_movers + k]), int(widths[n_movers + k]))\n/home/lixinyu/snap/new/ceshi/code_combo/13e47133/22/code.py:20:#   unambiguous for humans: the complementary color of each marker is simply the\n/home/lixinyu/snap/new/ceshi/code_combo/13e47133/22/code.py:38:#   and only the paired marker colors in the output.  Because every region repeats\n/home/lixinyu/snap/new/ceshi/code_combo/13e47133/22/code.py:121:        complements = [colors[0]]\n/home/lixinyu/snap/new/ceshi/code_combo/13e47133/22/code.py:123:        complements = [colors[1], colors[0]]\n/home/lixinyu/snap/new/ceshi/code_combo/13e47133/22/code.py:128:        complements = []\n/home/lixinyu/snap/new/ceshi/code_combo/13e47133/22/code.py:135:            complements.append(colors[best_j])\n/home/lixinyu/snap/new/ceshi/code_combo/13e47133/22/code.py:137:    for color, partner in zip(colors, complements):\n/home/lixinyu/snap/new/ceshi/code_combo/13e47133/22/code.py:153:    - Build a cyclic palette in two-layer chunks: each marker contributes its own color for one layer and the paired marker color for the next layer.\n/home/lixinyu/snap/new/ceshi/code_combo/13e47133/22/code.py:158:    The global \"same marker count in every region\" constraint makes the pairing rule stable across the whole grid: each region presents the same two-marker template, so the output reveals that every marker generates a self-color ring followed by a partner-color ring instead of the original one-color-per-depth cycle.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D2/0/code.py:290:    - Each endpoint token sends its complementary pattern to the far endpoint reached by the pipe: solid emits X, X emits diamond.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D2/0/code.py:294:    - Token shapes still cycle toward diamond/X complements, but endpoint pairing must now be inferred by reading each 9-rectangle's aspect-ratio-controlled reflection rather than assuming opposite-face pass-through.\n/home/lixinyu/snap/new/ceshi/code_combo/b9e38dc0/14/code.py:352:      two sprite neighborhoods. The stable relation is color pairing: interior seed color identifies\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/5/code.py:67:#       complement polarity from becoming another legal solution.\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/5/code.py:75:#     - original polarity loop relied on the complement not being a legal motif;\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/5/code.py:107:# These fixed bits break polarity/complement ambiguity without adding markers.\n/home/lixinyu/snap/new/ceshi/code/f560132c/D5/2/code.py:482:    \"\"\"Flood-fill partition the complement of the anchor into 3 connected regions.\"\"\"\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D2/1/code.py:231:    Route colored 3x3 tokens through cyan wire networks and emit the complementary shape at the far endpoint.\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/26/code.py:273:    - Because the family is exactly 50% dense and closed under seed complementation, the wrong foreground choice can still produce a valid raw seed match; the reliable invariant is the final colored 20x20 image, not the raw polarity match count.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D2/3/code.py:284:    - Each endpoint token sends its complementary shape to the far endpoint of its wire: solid sends an X, X sends a diamond.\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D4/3/code.py:18:#   painted with its channel-pair color, the upward segment keeps the most recent\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D4/3/code.py:51:#   painted path is legible as belonging to nearby bar pairs. No new marker color\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D4/3/code.py:83:    \"\"\"Return the flanking-pair color for a valid corridor cell, else None.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/33/code.py:316:    paired_colors = 0\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/33/code.py:324:            paired_colors += 1\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/33/code.py:329:        \"paired_colors\": int(paired_colors),\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/33/code.py:656:    if metrics[\"paired_colors\"] < 1:\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/8/code.py:61:#   training pairs without relying on hidden numeric color identities.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D2/2/code.py:316:    - Each sender emits its complementary 3x3 pattern to the opposite endpoint of its wire:\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/23/code.py:38:#   no crop has a complementary-polarity twin anywhere in the motif family, so the\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/23/code.py:45:#   2. the complemented mask also appears somewhere in the motif family, so the\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/23/code.py:71:#   of 8 color pairs instead of arbitrary colors.\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/23/code.py:262:    Reconstruct the full motif by decoding orientation from the color pair and polarity from the larger color value.\n/home/lixinyu/snap/new/ceshi/code_combo/58f5dbd5/29/code.py:70:#       border support is the projected motif subset rather than its complement.\n/home/lixinyu/snap/new/ceshi/code_combo/58f5dbd5/29/code.py:74:#     still must separate object classes, pair by color, and preserve spatial order.\n/home/lixinyu/snap/new/ceshi/code_combo/fc7cae8d/29/code.py:45:#    - Each active corner contributes one unique pair of guide colors.\n/home/lixinyu/snap/new/ceshi/code/f560132c/D2/3/code.py:349:BODY_COLOR_COUNT = 3                           # legend unique + one duplicated pair + one remaining unique body color\n/home/lixinyu/snap/new/ceshi/code/f560132c/D2/3/code.py:422:    \"\"\"Flood-fill partition the complement of the legend into 3 connected regions.\"\"\"\n/home/lixinyu/snap/new/ceshi/code/f560132c/D2/3/code.py:581:    shared_pair = _pick_shared_color_pair(masks)\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/24/code.py:150:        if {int(pair[0]), int(pair[1])} == color_set\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/24/code.py:196:    - Each of the four 10x10 quadrants uses its own fixed ordered foreground/background color pair, so the crop colors identify the source quadrant.\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/6/code.py:27:#     - The hard-coded motif is neither self-complementary nor 90-degree symmetric, so inversion and\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D8/0/code.py:48:#      the same rest-shape on both ends; channels that avoid maroon keep the original complementary\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D8/0/code.py:278:      the parity of encountered maroon rectangles controls whether the transmitted complement flips.\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/30/code.py:129:def _render_complement(\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/30/code.py:215:    - After finding the unique strip placement, repaint the full motif with the recovered colors and erase the matched visible strip, leaving only its complement.\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/30/code.py:221:    return _render_complement(pattern, fg, bg, strip_r0, strip_c0, strip_h, strip_w)\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/30/code.py:259:    expected = _render_complement(pattern, fg, bg, strip_r0, strip_c0, strip_h, strip_w)\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/30/code.py:286:    - the resulting sample has exactly one valid match and produces the intended complement output.\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/30/code.py:300:    raise AssertionError(\"failed to generate a unique border-aware complement strip\")\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D8/1/code.py:18:#      receives the complementary shape.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D8/1/code.py:36:#    - Original main unconditionally drew the far complementary token after tracing. In the variant\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D8/1/code.py:49:#    complement appear while a 3x3 / 3x1 rectangle leaves the far side blank.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D8/1/code.py:262:    - Each endpoint token then tries to send its complementary shape to the far endpoint.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D8/1/code.py:265:      while odd area blocks the transmission and no far complementary token is created.\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/11/code.py:48:# - 与原题不同的是，完整图案前景/背景各占一半，并且 180 度对置区域呈互补关系，因此不同样例里会\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/11/code.py:172:    - Because the balanced motif is designed so that a 180-degree rotation equals its binary complement, two different logical candidates can fit the same crop even though they collapse to the same final colored 20x20 image.\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/12/code.py:21:#       complement of the matched strip window\", with an explicit tight-crop step.\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/12/code.py:41:#     - To make the complement visibly U-shaped rather than an arbitrary hole, motif\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/12/code.py:56:#     - Tight-cropping must be driven by the geometric complement mask, not by motif\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/12/code.py:71:#       different motif offsets, the complement rule is visible from a few examples\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/12/code.py:86:#       complement really removes at least one foreground pixel from the full motif.\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/12/code.py:237:def _render_complement_tight(\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/12/code.py:255:    Recover the shared motif from a padded thin strip, then return only the strip's complement.\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/12/code.py:264:    - Repaint the matched motif with the recovered foreground/background colors, erase the matched strip rectangle back to background, and tight-crop the remaining geometric complement.\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/12/code.py:272:    return _render_complement_tight(pattern, fg, bg, r, c, h, w)\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/12/code.py:300:    expected = _render_complement_tight(pattern, fg, bg, r, c, h, w)\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D8/2/code.py:20:#      \"emit\" shape and its 4-cell complementary \"rest\" shape. They still partition a 3x3\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D8/2/code.py:39:#      solver must preserve its source orientation and rotate the complementary destination\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D8/2/code.py:64:_REST_BASE = [(-1, 0), (0, -1), (0, 0), (1, 0)]  # canonical 4-cell complement left behind\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D8/2/code.py:65:_EMIT_BASE = [(-1, -1), (-1, 1), (0, 1), (1, -1), (1, 1)]  # complement sent through wire\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D8/2/code.py:331:      complement to the opposite endpoint.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D8/2/code.py:332:    - A 5-cell emit token stays in place and sends the complementary 4-cell rest-shape.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D8/2/code.py:333:    - Each time a transmitted complement passes through a 9-rectangle, rotate it by 90 degrees:\n/home/lixinyu/snap/new/ceshi/code_combo/58f5dbd5/31/code.py:13:#   rest. Here there are only two colors to pair, but the operative relation is still color match:\n/home/lixinyu/snap/new/ceshi/code_combo/b99e7126/4/code.py:29:#      异常格只展示最终模板的一部分碎片；这些碎片先在同一 3x3 坐标系里做并集，得到一\n/home/lixinyu/snap/new/ceshi/code_combo/b99e7126/4/code.py:38:#    - 每个碎片都必须是完整模板的真子集、都含中心像素、都有 3-5 个活跃像素，并且至少\n/home/lixinyu/snap/new/ceshi/code_combo/b99e7126/4/code.py:39:#      两个碎片图案不同。这样输入中“多个不同异常格”肉眼可见，输出中“每处都扩成同一\n/home/lixinyu/snap/new/ceshi/code_combo/b99e7126/4/code.py:44:#    - 原“异常格里出现次数最多的颜色就是 active”在碎片场景不稳定，因为碎片可能稀疏；\n/home/lixinyu/snap/new/ceshi/code_combo/b99e7126/4/code.py:53:#    - 每个碎片都使用相同的 shared 色和 anomaly 色，只在像素形状上不同，保证“组合”\n/home/lixinyu/snap/new/ceshi/code_combo/b99e7126/4/code.py:62:#    - 输入中的碎片仅出现在中心格，不会在同一局部块里堆叠多层对象。\n/home/lixinyu/snap/new/ceshi/code_combo/b99e7126/4/code.py:70:#    - solver 假设每个碎片都是真子集且中心 active；generator 采样时强制，并拒绝任何会\n/home/lixinyu/snap/new/ceshi/code_combo/b99e7126/4/code.py:71:#      退化成“各自独立放大自己的碎片”即可得到同样输出的样本。\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D13/2/code.py:26:#   bar pairs, and real channels from same-color bar pairs.\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/23/code.py:388:    - paired_colors: movers with at least two row marks and two col marks.\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/23/code.py:397:    paired_colors = 0\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/23/code.py:403:            paired_colors += 1\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/23/code.py:411:        \"paired_colors\": int(paired_colors),\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/23/code.py:538:    if metrics[\"paired_colors\"] < 1:\n/home/lixinyu/snap/new/ceshi/code_combo/fc7cae8d/27/code.py:454:    swap_pair = tuple(random.sample(pattern_colors, 2))\n/home/lixinyu/snap/new/ceshi/code_combo/fc7cae8d/27/code.py:531:    out = phase1.copy() if pair is None else _swap_selected_colors(phase1, int(pair[0]), int(pair[1]))\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D1/1/code.py:16:# - 仍然保留原题的 token 语义：solid 3x3 在原地裂解成 diamond；solid/X 都会把互补形状送到同色管道另一端。\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D1/1/code.py:257:    Route colored tokens through mixed orthogonal/diagonal pipes and emit their complementary 3x3 forms.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D1/1/code.py:266:    - Any solid or X token at one pipe endpoint sends its complementary shape to the opposite endpoint:\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/15/code.py:585:    if not _pair_gap_ok(int(anchor), int(total_length), same_color_specs):\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/2/code.py:158:    - the complemented window also exists somewhere, so old two-polarity matching would stay viable.\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/2/code.py:173:            complement_count = int(counts[_window_key(~window)])\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/2/code.py:175:            if bool(window[0, 0]) and has_bg and int(counts[key]) == 1 and complement_count >= 1:\n/home/lixinyu/snap/new/ceshi/code_combo/269e22fb/2/code.py:176:                candidates.append((H, W, variant_idx, r, c, complement_count))\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/6/code.py:314:    - `paired_colors`: mover colors with at least two marks on both axes.\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/6/code.py:327:    paired_colors = 0\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/6/code.py:335:            paired_colors += 1\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/6/code.py:343:        \"paired_colors\": int(paired_colors),\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/6/code.py:592:    if metrics[\"paired_colors\"] < 1:\n/home/lixinyu/snap/new/ceshi/code_combo/58f5dbd5/24/code.py:25:#      paired with one smaller same-colored motif; the motif is centered inside the\n/home/lixinyu/snap/new/ceshi/code_combo/fc7cae8d/8/code.py:20:#    - solve orientation by shape complement: after one dihedral transform, the object's bg-hole mask\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D1/2/code.py:17:      - every other endpoint reached by that BFS receives the source token's complementary shape\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D1/2/code.py:24:      - endpoint -> greedy trace along one path -> stop at one terminal -> stamp one complement\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D1/2/code.py:26:      - endpoint -> BFS over the abstract wire graph -> visit branch junctions -> collect all reachable terminals -> stamp complements at each\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D1/2/code.py:34:    - the source alternates between solid and X so both complementary outcomes remain represented across examples\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D1/2/code.py:246:    Spread one token's signal through a branching pipe graph and stamp its complement at every reached leaf.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D1/2/code.py:254:    - The source endpoint injects a BFS signal into the wire graph. Whenever that signal reaches another endpoint, place the source token's complementary shape there.\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D6/1/code.py:32:#     - N 采用全局唯一值，而不是每条路径各自不同，避免规则碎片化。\n/home/lixinyu/snap/new/ceshi/code/f560132c/D4/1/code.py:455:    \"\"\"Flood-fill partition the complement of the legend into 3 connected regions.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/12/code.py:19:#   同时碎片从上边和左边冒出来。\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/12/code.py:50:# - 除一个强制触发融合行为的 mover 外，其余 mover 优先选择不 wrap 的标记组合，降低 interior 内部的碎片密度。\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/16/code.py:22:#      pairing. If color X has sorted rows [r1, r2] and sorted cols [c1, c2],\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/16/code.py:407:    - `paired_colors`: mover colors with at least 2 row marks and 2 col marks.\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/16/code.py:449:    paired_colors = 0\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/16/code.py:455:            paired_colors += 1\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/16/code.py:465:        \"paired_colors\": int(paired_colors),\n/home/lixinyu/snap/new/ceshi/code_combo/247ef758/16/code.py:596:    if metrics[\"paired_colors\"] < 1:\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D3/0/code.py:268:    - Each endpoint token sends its complementary 3×3 pattern to the far endpoint of the same wire route.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D3/0/code.py:272:    - The original endpoint-to-endpoint transmission still determines where complements appear, but now the route itself becomes visible: follow the same-colored trail to pair source token, pipe path, and far-end completion.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D3/1/code.py:298:    - Each source token sends its complementary shape to the opposite endpoint:\n/home/lixinyu/snap/new/ceshi/code_combo/da515329/3/code.py:318:    Key insight: This fusion is easiest to solve in two hidden stages. First complement the teal/black image into the original occupancy space. Then mirror that occupancy grid, run the original clockwise solver, and unmirror the result; the mirror converts clockwise growth into the desired counterclockwise carving without re-deriving the cleanup cases.\n/home/lixinyu/snap/new/ceshi/code_combo/dfadab01/33/code.py:64:#    - The generator forces two complementary witnesses: one marker type repeated across all four\n/home/lixinyu/snap/new/ceshi/code_combo/58f5dbd5/7/code.py:128:    - In the top-left corner, a vertical list of 1x2 color pairs [A, B] specifies how the motif's primary color A\n/home/lixinyu/snap/new/ceshi/code_combo/58f5dbd5/23/code.py:115:    - The block is not paired with one stencil anymore. Several two-color motifs of the same primary color must be\n/home/lixinyu/snap/new/ceshi/code_combo/b99e7126/22/code.py:112:def _repair_defect(defect_arr: np.ndarray, source_mask: np.ndarray, stamp_color: int) -> np.ndarray:\n/home/lixinyu/snap/new/ceshi/code_combo/b99e7126/22/code.py:116:    repaired[repaint] = stamp_color\n/home/lixinyu/snap/new/ceshi/code_combo/b99e7126/22/code.py:185:    repaired = _repair_defect(defect_arr, source_mask, stamp_color)\n/home/lixinyu/snap/new/ceshi/code_combo/b99e7126/22/code.py:274:    out[r0 : r0 + CELL_INNER, c0 : c0 + CELL_INNER] = _repair_defect(defect_arr, source_mask, stamp_color)\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D3/3/code.py:20:#   input token detection -> route tracing -> place complementary token -> leave wires unchanged.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D3/3/code.py:22:#   input token detection -> route tracing -> place complementary token -> recolor ordered route\n/home/lixinyu/snap/new/ceshi/code_combo/58f5dbd5/35/code.py:598:            1 iff non-block components occupy exactly the complementary diagonal pair.\n/home/lixinyu/snap/new/ceshi/code_combo/dfadab01/3/code.py:113:    - pair23_overlap_pixels: cells touched by both marker colors 2 and 3\n/home/lixinyu/snap/new/ceshi/code_combo/dfadab01/3/code.py:115:    - pair_count: number of distinct cross-color overlap pairs present in one instance\n/home/lixinyu/snap/new/ceshi/code/f560132c/D14/1/code.py:21:#      decode source->target pairs, then recolor each assembled piece by matching the piece's original body color.\n/home/lixinyu/snap/new/ceshi/code_combo/fc7cae8d/42/code.py:193:       - Exactly one adjacent side-pair shares a high-density dominant carrier color.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D12/0/code.py:32:#   and 9-rect pass-throughs, and stamp complementary shapes at the far ends.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D12/0/code.py:238:    - The only moving objects are the solid 3x3 blocks. Remove those blocks to recover the wire graph, trace from the adjacent endpoint to the far endpoint, and place the complementary X there while leaving a diamond at the source location.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D12/3/code.py:15:#   - 输出不改：每个颜色最终都形成一对 diamond / X，wire 只负责把互补部分送到另一端。\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D12/3/code.py:35:#     否则 solver 会把残块碎片当成 wire 杂点。\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D12/3/code.py:271:    Repair chipped source tokens near wire endpoints, then transmit their complementary shapes.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D12/3/code.py:277:    - First interpret every dense fragment as a repaired solid 3x3. It is cleared and replaced in place by a diamond, while its complementary X is sent to the far endpoint through the wire.\n/home/lixinyu/snap/new/ceshi/code_combo/b99e7126/14/code.py:64:#    2-4 training pairs, solvers can see that active cells are chosen by the minority stencil but colored\n/home/lixinyu/snap/new/ceshi/code_combo/58f5dbd5/15/code.py:47:#   and every usable motif occupies an exact 4x4 bbox. The solver still pairs by color, but\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D12/2/code.py:11:#     - output remains the same stable complementary pair per routed color:\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D12/2/code.py:18:#     - the solver must complete both partial shapes into the full complementary pair\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D12/2/code.py:310:    Complete paired partial endpoint tokens into full complementary shapes across each wire route.\n/home/lixinyu/snap/new/ceshi/code_combo/58f5dbd5/2/code.py:21:#    The source task pairs each solid 5x5 block with a same-colored 3x3 motif and carves the\n/home/lixinyu/snap/new/ceshi/code_combo/da515329/34/code.py:26:#      also reveals which quadrant owns which pair of colors.\n/home/lixinyu/snap/new/ceshi/code_combo/da515329/34/code.py:28:#    - The palette uses exactly four direction-owned pairs, so the color hypothesis space is structured rather\n/home/lixinyu/snap/new/ceshi/code_combo/da515329/34/code.py:32:#      of collapsing back toward a plain four-pair recoloring.\n/home/lixinyu/snap/new/ceshi/code_combo/da515329/34/code.py:49:#      spiral pair is missing one of its two colors are discarded.\n/home/lixinyu/snap/new/ceshi/code_combo/da515329/34/code.py:88:SPIRAL_COLORS = tuple(color for pair in SPIRAL_PAIRS for color in pair)\n/home/lixinyu/snap/new/ceshi/code_combo/da515329/34/code.py:439:    - Paint is direction-owned and turn-sensitive: up uses 2/6, right uses 1/7, down uses 3/9, left uses 4/5. Straight continuation keeps the current color, and the move that turns 90 degrees switches to the other color in that spiral's pair. The fixed round-robin slot also chooses the launch shade within each pair: the first and third spirals start with the pair's first color, while the second and fourth start with the pair's second color.\n/home/lixinyu/snap/new/ceshi/code_combo/7b0280bc/16/code.py:50:    terminal_pair_colors = sorted(int(col) for col, ids in nodes_by_color.items() if len(ids) == 2)\n/home/lixinyu/snap/new/ceshi/code_combo/7b0280bc/16/code.py:52:    assert len(terminal_pair_colors) == 2\n/home/lixinyu/snap/new/ceshi/code_combo/7b0280bc/16/code.py:55:        for col in terminal_pair_colors\n/home/lixinyu/snap/new/ceshi/code_combo/7b0280bc/16/code.py:60:        if int(c) not in {bg, station_color, *terminal_pair_colors}\n/home/lixinyu/snap/new/ceshi/code_combo/7b0280bc/16/code.py:160:    node_pair_colors = [PAIR1_NODE_COLOR, PAIR2_NODE_COLOR]\n/home/lixinyu/snap/new/ceshi/code_combo/7b0280bc/16/code.py:165:            color = SHARED_COLOR if int(node_counts[int(nid)]) > 1 else int(node_pair_colors[pair_idx])\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D4/3/code.py:13:#   - travel-L (4 cells): the complementary lower-right L inside the same 3x3 footprint.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D4/3/code.py:20:#     then the far endpoint receives the complementary 4-cell travel-L.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D4/3/code.py:261:    Send split 3x3 tokens through the wire permutation, using an asymmetric pair of complementary L-shapes.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D4/3/code.py:270:    - A solid 3x3 token is decomposed into two fixed complementary parts inside the same 3x3 footprint:\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D4/3/code.py:274:      to receive the complementary 5-cell stay-L instead.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D4/3/code.py:278:      pre-split travel-L is completed by routing its missing complement to the opposite endpoint.\n/home/lixinyu/snap/new/ceshi/code_combo/dfadab01/20/code.py:89:#      have produced the same orientation/color pair determined only by color 5 itself.\n/home/lixinyu/snap/new/ceshi/code/d35bdbdc/D5/1/code.py:230:    - Keep the two destinations, keep the matched sources, and simultaneously exchange each paired destination/source center color.\n/home/lixinyu/snap/new/ceshi/code_combo/58f5dbd5/16/code.py:440:    \"\"\"Assign pairwise-distinct motif masks to true connector colors.\"\"\"\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D4/2/code.py:17:#      Existing half-tokens are already \"at rest\" and only emit the complementary half.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D4/2/code.py:265:      complementary half to the routed endpoint on the opposite side.\n/home/lixinyu/snap/new/ceshi/code_combo/fc7cae8d/39/code.py:255:    4. Use the frame control-color pair to select a recolor rule from the legend and recolor the core.\n/home/lixinyu/snap/new/ceshi/code_combo/581f7754/29/code.py:31:#    one pair of sprites sharing that long anchor color to overlap in the solved\n/home/lixinyu/snap/new/ceshi/code_combo/581f7754/29/code.py:66:# - Input movable objects are pairwise separated and do not include conflict color 9.\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D7/0/code.py:303:    Real channels have same-color bar pairs; fake channels have mismatched colors.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D15/0/code.py:28:#   Wire tracing uses full-grid coordinates and can place far-end complements near endpoints; therefore cropping\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D15/0/code.py:231:      endpoint token sends its complementary shape to the routed far endpoint.\n/home/lixinyu/snap/new/ceshi/code_combo/58f5dbd5/21/code.py:42:#     - main 中按颜色寻找最小同色非5x5组件，依赖“每个块颜色唯一，matching motif 同色且比块小，也没有同色碎片”；\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D7/1/code.py:89:    \"\"\"Return the bar-pair color of the corridor containing the endpoint cell.\"\"\"\n/home/lixinyu/snap/new/ceshi/code/d35bdbdc/D7/3/code.py:23:      - within each pair, exactly one sprite has center_color == partner.border_color;\n/home/lixinyu/snap/new/ceshi/code/d35bdbdc/D7/3/code.py:73:    - within each pair, only one center changes, and it changes to the partner's center color\n/home/lixinyu/snap/new/ceshi/code/d35bdbdc/D7/3/code.py:247:    - Within that local pair, if one sprite's center color equals the other sprite's border color, that sprite is\n/home/lixinyu/snap/new/ceshi/code/d35bdbdc/D7/3/code.py:253:      source/destination pairing, so color transfer must be resolved component-by-component rather than globally.\n/home/lixinyu/snap/new/ceshi/code_combo/da515329/6/code.py:54:#     - Each direction has its own fixed pair, so D14 is also visible. The four base colors are\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D7/3/code.py:292:    Real channels have same-color bar pairs; fake channels have mismatched colors.\n/home/lixinyu/snap/new/ceshi/code_combo/581f7754/25/code.py:326:    - Read each movable sprite's least-frequent color as its marker and pair it with the border pixel of the same color.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D15/2/code.py:27:#       receives the transmitted complement is shown.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D15/2/code.py:414:      token started\" and \"where its complement arrived\".\n/home/lixinyu/snap/new/ceshi/code_combo/7b0280bc/14/code.py:49:    pair_colors = [int(col) for col, cnt in marker_counts.items() if int(cnt) == 2]\n/home/lixinyu/snap/new/ceshi/code_combo/7b0280bc/14/code.py:50:    assert len(pair_colors) == 1\n/home/lixinyu/snap/new/ceshi/code_combo/7b0280bc/14/code.py:51:    pair_color = int(pair_colors[0])\n/home/lixinyu/snap/new/ceshi/code_combo/7b0280bc/14/code.py:73:        if int(d[\"marker_color\"]) == int(pair_color):\n/home/lixinyu/snap/new/ceshi/code_combo/7b0280bc/14/code.py:128:    - The terminal pair is the unique marker color that appears exactly twice.\n/home/lixinyu/snap/new/ceshi/code_combo/581f7754/27/code.py:17:#    - Original 581f7754 paired a sprite to an anchor by marker color, then stopped exactly\n/home/lixinyu/snap/new/ceshi/code_combo/fc7cae8d/4/code.py:24:#      The object contains one top/left guide pair of color 3 with run lengths 6 and 9. A main-\n/home/lixinyu/snap/new/ceshi/code_combo/dfadab01/5/code.py:270:def _place_marker_pair(inp: np.ndarray, marker_color: int, center_r: int, center_c: int, diag_index: int) -> bool:\n/home/lixinyu/snap/new/ceshi/code_combo/dfadab01/5/code.py:291:    Decode diagonal pixel-pair markers into fixed glyphs, then let nearest different-color markers exchange glyph colors.\n/home/lixinyu/snap/new/ceshi/code_combo/dfadab01/5/code.py:298:    - First pair same-color pixels that differ by four rows and four columns; each midpoint is a recovered marker anchor.\n/home/lixinyu/snap/new/ceshi/code_combo/dfadab01/5/code.py:304:    - Neither input pixel directly becomes a glyph: first recover one logical marker from a visible diagonal pair, then use spatial nearest-neighbor reasoning between those decoded markers to decide whether each glyph keeps its own color or borrows a neighbor's.\n/home/lixinyu/snap/new/ceshi/code_combo/dfadab01/5/code.py:362:        used_colors = {color for pair_spec in pair_specs for color in pair_spec}\n/home/lixinyu/snap/new/ceshi/code_combo/dfadab01/5/code.py:378:        if not _place_marker_pair(inp, colors[0], centers[0][0], centers[0][1], diag_index):\n/home/lixinyu/snap/new/ceshi/code_combo/dfadab01/5/code.py:380:        if not _place_marker_pair(inp, colors[1], centers[1][0], centers[1][1], diag_index):\n/home/lixinyu/snap/new/ceshi/code_combo/dfadab01/5/code.py:393:        if not _place_marker_pair(inp, marker_color, center_r, center_c, diag_index):\n/home/lixinyu/snap/new/ceshi/code_combo/fc7cae8d/22/code.py:73:#    - `main()` assumes exactly one quadrant pair matches the object's two guide colors. The generator\n/home/lixinyu/snap/new/ceshi/code/2c181942/D8/0/code.py:266:    # Also ensure NOT fliplr symmetric to prevent the complementary side matching.\n/home/lixinyu/snap/new/ceshi/code/6e4f6532/D16/2/code.py:21:#    To keep the stripe pair readable and avoid color collisions, each instance\n/home/lixinyu/snap/new/ceshi/code/6e4f6532/D16/2/code.py:49:#    Each stripe owns exactly one pair of colors, and the marker colors come only\n/home/lixinyu/snap/new/ceshi/code/6e4f6532/D16/2/code.py:50:#    from those visible pairs. Humans can match marker colors back to stripe\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D6/1/code.py:22:# - The 5x5 solid splits into two complementary 5x5-scale shapes:\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D6/1/code.py:26:#   the resting shape (large cross), while the missing complement (corner-star)\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D6/1/code.py:36:# - The two complementary results are still few and repeated across channels:\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D6/1/code.py:275:    Transmit enlarged colored tokens along wire networks, splitting each 5×5 source into complementary large shapes.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D6/1/code.py:281:    - Every solid 5×5 block is replaced in place by the large cross (middle row + middle column), and its complementary corner-star is sent to the far endpoint of the same wire component.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D6/1/code.py:285:    - Inside a 5×5 square, the solid token decomposes exactly into two complementary pieces: a 9-cell cross and sixteen corner cells. The wire network only decides where the missing complementary piece should appear.\n/home/lixinyu/snap/new/ceshi/code_combo/fc7cae8d/6/code.py:213:    Align an opposite-guide object to opposite frame controls using shape complement.\n/home/lixinyu/snap/new/ceshi/code_combo/581f7754/23/code.py:610:def _place_sprite_pairs(inp, anchors, marker_colors, bg):\n/home/lixinyu/snap/new/ceshi/code_combo/581f7754/23/code.py:712:    placed = _place_sprite_pairs(inp, anchors, marker_colors, bg)\n/home/lixinyu/snap/new/ceshi/code_combo/581f7754/1/code.py:31:#       they still pair because size rank overrides color.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D6/2/code.py:38:#     - ordered color pairs are sampled per channel; colors may repeat across\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D6/2/code.py:39:#       channels but each pair is distinct, so the grid truly carries double-color tracking\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D6/2/code.py:73:# - Ordered color pairs exclude wire colors and require distinct sub-colors.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D6/2/code.py:610:    color_pairs = _sample_color_pairs(n)\n/home/lixinyu/snap/new/ceshi/code/2c181942/D1/0/code.py:52:#       - 原题在这里是“看 top 的颜色”；变体变成“看 top 的凹口位置并找几何互补的嘴型”。\n/home/lixinyu/snap/new/ceshi/code_combo/fc7cae8d/30/code.py:238:    Phase 2: use the frame control-color pair to select an action tile and recolor one pattern color.\n/home/lixinyu/snap/new/ceshi/code_combo/e3721c99/26/code.py:59:#       - The seed solver never needed geometric pairing information after