WS = (3, 4)                    # staircase row count options\n/home/lixinyu/snap/new/ARC_code/eval/c4d067a0.py:129:LEGEND_COLS = (2, 3)                    # staircase column count options\n/home/lixinyu/snap/new/ARC_code/eval/c4d067a0.py:146:def _enumerate_staircase_shapes():\n/home/lixinyu/snap/new/ARC_code/eval/c4d067a0.py:147:    \"\"\"Enumerate all valid (widths) tuples for the staircase legend shape.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/c4d067a0.py:175:# All valid staircase width tuples, precomputed once\n/home/lixinyu/snap/new/ARC_code/eval/c4d067a0.py:176:_STAIRCASE_SHAPES = _enumerate_staircase_shapes()\n/home/lixinyu/snap/new/ARC_code/eval/c4d067a0.py:179:def _pick_staircase():\n/home/lixinyu/snap/new/ARC_code/eval/c4d067a0.py:180:    \"\"\"Pick a random staircase shape; return (filled_pts, adjacent_pairs).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/c4d067a0.py:260:    pts, pairs = _pick_staircase()\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:484:    \"\"\"Return (row, col) offsets within the bottom bar to carve out a staircase notch.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/195c6913.py:205:    \"\"\"Return a boolean mask for a thick meandering anti-diagonal band.\n/home/lixinyu/snap/new/ARC_code/eval/e12f9a14.py:149:    - 45° collision: beams merge into a zigzag (alternating cardinal + diagonal steps) with no gap at the meeting point.\n/home/lixinyu/snap/new/ARC_code/eval/e12f9a14.py:151:    Key insight: Two distinct collision rules — 90° produces a gap and single-pixel diagonal lines; 45° produces no gap and thicker zigzag bands.\n/home/lixinyu/snap/new/ARC_code/eval/e12f9a14.py:291:        # 45°: merge and turn to a 22.5° zigzag (alternate diag+card), no gap.\n/home/lixinyu/snap/new/ARC_code/eval/e12f9a14.py:330:        assert in_bounds(adj) and is_free(adj) and cell_owner.get(adj) is None, \"expected free adjacent zigzag step\"\n/home/lixinyu/snap/new/ARC_code/eval/7b5033c1.py:8:    Straighten a colored snake path into a single-column s