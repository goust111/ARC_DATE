{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, collections\nimport numpy as np\n\ndef neigh(cell,h,w):\n    r,c=cell\n    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n        nr,nc=r+dr,c+dc\n        if 0<=nr<h and 0<=nc<w:\n            yield nr,nc\n\ndef connected(mask):\n    h,w=mask.shape\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r,c]]\n    if not pts: return False\n    q=[pts[0]]; seen={pts[0]}\n    for x in q:\n        for y in neigh(x,h,w):\n            if mask[y] and y not in seen:\n                seen.add(y); q.append(y)\n    return len(seen)==len(pts)\n\ndef full_bbox(mask):\n    pts=np.argwhere(mask)\n    if len(pts)==0:return False\n    rs=pts[:,0]; cs=pts[:,1]\n    return rs.min()==0 and rs.max()==mask.shape[0]-1 and cs.min()==0 and cs.max()==mask.shape[1]-1\n\ndef sample_connected(h,w,target):\n    cells=[(r,c) for r in range(h) for c in range(w)]\n    start=random.choice(cells)\n    A={start}\n    frontier=set(neigh(start,h,w))\n    while len(A)<target and frontier:\n        cell=random.choice(tuple(frontier))\n        frontier.remove(cell)\n        A.add(cell)\n        for n in neigh(cell,h,w):\n            if n not in A:\n                frontier.add(n)\n    if len(A)\"'!=target: return None\n    mask=np.zeros((h,w),bool)\n    for r,c in A: mask[r,c]=1\n    return mask\n\nfor h,w in [(3,3),(4,4),(4,5),(5,5),(5,6)]:\n    ok=0; tot=2000\n    for _ in range(tot):\n        target=random.randint(max(4,(h*w)//3), min(h*w-4, (2*h*w)//3))\n        m=sample_connected(h,w,target)\n        if m is None: continue\n        comp=~m\n        if connected(m) and connected(comp) and full_bbox(m) and full_bbox(comp):\n            ok+=1\n    print((h,w), ok/tot)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
