uild_comp_checker_pair(n, colors, rng)\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D8/3/code.py:768:        return build_invert0_pair(n, colors, rng)\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D8/3/code.py:770:        return build_sym_pair(n, colors, rng, params[\"idx\"])\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D8/3/code.py:772:        return build_sym_fill_pair(n, colors, rng, params[\"keep0\"])\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/15/code.py:163:    assert len(vertical_line_candidates) <= 1, \"paired vertical edge-line color must be unique when present\"\n/home/lixinyu/snap/new/ceshi/code_combo/2c181942/9/code.py:310:    - pair sprites to hub sides by color\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/13/code.py:119:    assert len(vertical_line_candidates) <= 1, \"paired vertical edge-line color must be unique when present\"\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D3/1/code.py:89:    - Identify the training pair by matching body color-sets after removing the anchor color.\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D3/1/code.py:596:    built_train = build_anchored_pair(n, train_colors, anchor_color, idx, rng)\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D3/1/code.py:601:    built_test = build_anchored_pair(n, test_colors, anchor_color, idx, rng, anchor_avoid=train_anchor)\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/38/code.py:3:# Name: 面积排序决定位置+碎片面积均等\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/48/code.py:17:    保留原题“把散落碎片拼成严格左右镜像矩形”的骨架，同时叠加两层新要求：\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/48/code.py:20:    不能 4 邻接。图例本身要从拼图碎片里剔除，避免污染面积、组件和 frame 检测。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/48/code.py:25:      - 其余非背景像素仍是散落碎片；frame 仍整体保留相对位置，非 frame 碎片散布在别处。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/48/code.py:31:      - solver 先把“最常见颜色”当背景，提取所有非背景碎片。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/48/code.py:32:      - can_place() 里若某位置会让两个同色碎片 4 邻接，则拒绝该放置。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/48/code.py:35:      - can_place() 不再检查“同色相邻”；改为检查当前碎片颜色与已放邻居颜色是否构成图例指定禁邻对。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/48/code.py:36:      - 图例护城河必须等于当前样例背景色，因此背景变化会直接参与前处理；若误判背景，图例和碎片分离都会失败。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/48/code.py:48:    - 输出面积、因子分解、frame bbox、锚点检测都依赖“只统计真实碎片”，所以图例清理必须发生在这些步骤之前。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/48/code.py:164:    assert len(vertical_line_candidates) <= 1, \"paired vertical edge-line color must be unique when present\"\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/48/code.py:348:    - After that cleanup, the frame fixes much of the rectangle and the legend-specified pairwise ban replaces the old same-color ban, leaving a propagation-only assembly.\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/48/code.py:618:    chunk_colors = _assign_chunk_colors(chunks, W, forbidden_pair, fill_colors)\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D3/2/code.py:963:def build_multi_component_pair(kind: str, setup_params: dict, colors: list[int], rng: random.Random) -> tuple[np.ndarray, np.ndarray]:\n/home/lixinyu/snap/new/ceshi/code/b10624e5/D5/3/code.py:33:    - _find_dividers still assumes exactly one full non-bg row/col pair with the same color; unchanged.\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/40/code.py:3:# Name: 保持输入尺寸+碎片移动轨迹连线\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/40/code.py:121:    assert len(vertical_line_candidates) <= 1, \"paired vertical edge-line color must be unique when present\"\n/home/lixinyu/snap/new/ceshi/code_combo/64efde09/6/code.py:236:        pair = (int(color), int(template_id))\n/home/lixinyu/snap/new/ceshi/code_combo/64efde09/6/code.py:242:        pair = (int(color), int(template_id))\n/home/lixinyu/snap/new/ceshi/code_combo/64efde09/6/code.py:267:                                new_pair = (int(color), int(hit_tid))\n/home/lixinyu/snap/new/ceshi/code_combo/2c181942/4/code.py:22:#   - each detached monochrome sprite is paired to one side by color equality;\n/home/lixinyu/snap/new/ceshi/code_combo/2c181942/4/code.py:27:#   - detached sprites are paired by hub-relative position, not by their color:\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:17:#    - 原题: 单一背景上散落若干碎片，solver 统计全部前景面积，反推出一个左右对称的稠密矩形，再把碎片拼回去。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:18:#    - 融合后: 画布先被左右双色背景切成两个大区；中间放着一个已经定位好的大框架，框架内部保留洞，框架外散落碎片。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:19:#      这些碎片不是再去拼成整块矩形，而是分别填进框架洞中；左背景区的碎片对应左半洞，右背景区对应右半洞。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:23:#      最后只拿对应区的外部碎片去做同形匹配。与原题相比，`总面积->矩形尺寸` 这一步完全消失，取而代之的是\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:27:#      并强制外部碎片按所属背景区散布，保证人眼能看到“左边碎片填左洞、右边碎片填右洞”。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:35:#    - 新增假设: 框架是唯一最大单色 8 连通前景组件；生成器用单色大框架且面积远大于任何外部碎片来保证。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:38:#    - 散布阶段先用 `-1` 阻塞整个框架 bbox，再把外部碎片放到各自背景区，最后恢复 bbox 内的双色背景并覆写框架像素，\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:39:#      因此碎片不会越界、不会提前落入洞中，也不会与框架重叠。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:41:#    - `random_free_location(..., border=1, padding=1)` 保证外部碎片彼此分离，顶/底边保留纯背景供 solver 检测 split。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:43:#    - 输入中最显眼的是一块横跨双色背景分界的大框架，内部左右各有空洞；框架外两侧分别散落与洞同形的碎片。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:44:#    - 输出直接是同一框架被填满后的结果。对人类来说，规则可归纳为“先忽略双色背景本身，再用左右两侧碎片分别补上左右洞”。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:45:#    - 这里不依赖颜色编号大小、组件枚举顺序等不可视因素；洞和碎片的对应完全由可见的形状与所在背景区决定。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:47:#    - 框架固定为单色，双色背景只在空白区域与洞位出现，外部碎片与框架隔离，图层关系清楚。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:53:#    - solver 假设顶行和底行完整暴露同一个竖直 split；generator 对框架和碎片都保留 1 像素外边框。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:54:#    - solver 假设每个洞形在对应背景区外部有同形碎片；generator 直接从每个洞组件裁出一个同色 patch 并散到同侧区域。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:55:#    - solver 假设洞不跨 split，且外部碎片也不跨 split；generator 通过“中心列为框架 + 分区内散布”强制满足。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:57:#    - 统计框架 bbox 内左区洞组件数 `L_holes` 与右区洞组件数 `R_holes`，以及框架外左/右区碎片数 `L_pieces`、`R_pieces`。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/39/code.py:59:#      原题与仅 D3 变体都不会同时出现“框架内双色洞位 + 外部碎片按双色分区归属”的统计特征。\n/home/lixinyu/snap/new/ceshi/code_combo/64efde09/14/code.py:240:    cycle_pairs = _template_cycle_order(sprites, template_id_to_color)\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/23/code.py:3:# Name: 干扰像素+干扰碎片\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/23/code.py:9:#       - 输出仍是由真实碎片拼出的致密矩形，且必须严格左右镜像。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/23/code.py:14:#         2) 位于框外、完全不参与拼装的 1-2 个干扰碎片。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/23/code.py:15:#       - solver 必须先删单点噪声，再从剩余碎片里排除结构性噪声。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/23/code.py:19:#       - 真实非框架碎片散落在框外。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/23/code.py:21:#       - 干扰碎片也散落在框外，看起来和真实碎片同属“外部散件”区域。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/23/code.py:28:#         还必须继续做“删 1-2 个外部碎片”的子集筛选，才能回到 40 并完成拼装。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/23/code.py:31:#       - 框内杂点与框外碎片分区明确，人类能看出有两种不同噪声角色。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/23/code.py:33:#       - 干扰碎片使用输出中不会出现的颜色，确保“有整块外部碎片被丢弃”在样例里足够显眼。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/23/code.py:36:#       - 外部干扰碎片最多 2 个，因此子集筛选只需测试很小的组合空间。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/23/code.py:42:#       - 原 solver 假设每个 4 连通分量都参与拼装；融合后对外部干扰碎片不成立。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/23/code.py:46:#       - 在剩余碎片上用面积方程筛子集，再用 req 约束 + 镜像拼装验证形状匹配。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/23/code.py:49:#       - 真实框架 bbox 整块预留，真实碎片与干扰碎片都只散落在框外，互不重叠且带 8 邻域 padding。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/23/code.py:50:#       - 干扰像素只写入框内的非框架背景格，因此不会覆盖框架，也不会与外部碎片相连。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/23/code.py:54:#       - 2-3 组样例就能看到：框里有散点要忽略，框外也有整块碎片要忽略。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/23/code.py:60:#       - 结构性噪声只会是框外的 1-2 个完整碎片。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/23/code.py:144:    assert len(vertical_line_candidates) <= 1, \"paired vertical edge-line color must be unique when present\"\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D12/2/code.py:40:#     - Frame finding, blank-frame detection, and pair matching by color set still\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D12/2/code.py:53:#     - Training pair shares a two-color palette; test uses a disjoint two-color\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D12/2/code.py:425:    - In the D12 variant, each non-blank sprite uses two interior colors: one color keeps the same footprint across the training pair while the other color is the one that actually changes.\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D12/2/code.py:428:    - Find the training pair by matching interior color sets, and treat the last non-blank frame as the test sprite.\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D12/2/code.py:429:    - From the training pair, infer both the transform type (fill, endpoints, invert-0, symmetry family, etc.) and which color is the changing color.\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D12/2/code.py:537:def build_fill_pair(n: int, colors: list[int], rng: random.Random) -> tuple[np.ndarray, np.ndarray]:\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D12/2/code.py:566:def build_endpoints_pair(n: int, colors: list[int], rng: random.Random) -> tuple[np.ndarray, np.ndarray]:\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D12/2/code.py:594:def build_invert0_pair(n: int, colors: list[int], rng: random.Random) -> tuple[np.ndarray, np.ndarray]:\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D12/2/code.py:621:def build_training_pair(kind: str, params: dict, n: int, colors: list[int], rng: random.Random):\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D12/2/code.py:623:        return build_fill_pair(n, colors, rng)\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D12/2/code.py:625:        return build_endpoints_pair(n, colors, rng)\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D12/2/code.py:627:        return build_invert0_pair(n, colors, rng)\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/22/code.py:3:# Name: 碎片叠放到模板上+边缘图例\n/home/lixinyu/snap/new/ceshi/code_combo/2c181942/34/code.py:39:# - 原代码 `label_mask(m, connectivity=8)` 后取最大同色块，假设不存在同色碎片和多色组件。\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D4/0/code.py:75:    - Two non-blank frame interiors form a training pair because they share the same non-zero color set.\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D4/0/code.py:80:    - Infer the interior transformation demonstrated by that pair (reflection, fill, endpoint extraction, inversion, checker complement, or symmetry fill).\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D4/0/code.py:811:def build_fill_pair(n: int, colors: list[int], rng: random.Random) -> tuple[np.ndarray, np.ndarray]:\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D4/0/code.py:830:def build_endpoints_pair(n: int, colors: list[int], rng: random.Random) -> tuple[np.ndarray, np.ndarray]:\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D4/0/code.py:851:def build_comp_checker_pair(n: int, colors: list[int], rng: random.Random) -> tuple[np.ndarray, np.ndarray]:\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D4/0/code.py:875:def build_invert0_pair(n: int, colors: list[int], rng: random.Random) -> tuple[np.ndarray, np.ndarray]:\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D4/0/code.py:930:def build_sym_pair(n: int, colors: list[int], rng: random.Random, idx: int) -> tuple[np.ndarray, np.ndarray]:\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D4/0/code.py:1002:def build_training_pair(kind: str, params: dict, n: int, colors: list[int], rng: random.Random):\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D4/0/code.py:1005:        return build_fill_pair(n, colors, rng)\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D4/0/code.py:1007:        return build_endpoints_pair(n, colors, rng)\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D4/0/code.py:1009:        return build_comp_checker_pair(n, colors, rng)\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D4/0/code.py:1011:        return build_invert0_pair(n, colors, rng)\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D4/0/code.py:1013:        return build_sym_pair(n, colors, rng, params[\"idx\"])\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D4/0/code.py:1015:        return build_sym_fill_pair(n, colors, rng, params[\"keep0\"])\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/2/code.py:11:    from: 原题主要依赖单色碎片的几何洞匹配；输入朝向就是输出朝向。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/2/code.py:12:    to: 内部碎片改成“主体色横条 + 两个端点提示色”的多色部件，真正决定上下相邻顺序的是端点颜色；\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/2/code.py:23:        原题看到一个单色碎片时，会问“它几何上能塞进哪个洞”，位置对了就结束。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/41/code.py:25:#     - scatter the transpose-side cells of that parity, plus all complementary-parity\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/41/code.py:29:#         2. every 4-neighbor pair has different colors, i.e. checkerboard alternation\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/41/code.py:187:      transpose-side cells of that parity and all complementary cells are scattered elsewhere as singletons.\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/41/code.py:197:    the opposite triangle; then checkerboard alternation identifies the complementary parity class.\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/41/code.py:244:    assert len(fill_candidates) == 1, \"exactly one complementary fill color must remain\"\n/home/lixinyu/snap/new/ceshi/code_combo/2c181942/36/code.py:28:#         complementary to one dock side. A same-color distractor sprite may also exist\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/9/code.py:17:#   split-line 残留、射线终点、角落碎片轮廓都对应“先整体旋过的精灵”，而角落碎片的\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/9/code.py:36:# - 输出覆盖安全性默认角落碎片互不冲突；generator 显式拒绝跨越 split line 的旋转片段。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/9/code.py:47:# - 保留片段强制对其要求的 krot 非旋转不变，因此角落碎片形状会明显改变，而不是只换位置。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/9/code.py:52:# - 输出仍是三层结构：ctrl 射线、split-line fg、角落碎片。局部旋转只改变碎片轮廓，不引入叠色。\n/home/lixinyu/snap/new/ceshi/code_combo/4a21e3da/9/code.py:62:# - 假设局部旋转后的角落碎片不会越过 split line；generator 在输出侧逐片验证。\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/0/code.py:74:    - The training pair shares the same three-color palette, while the test sprite uses a disjoint three-color palette.\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/0/code.py:77:    - Match the training pair by identical interior color sets.\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/0/code.py:78:    - Within that pair, treat the smallest-count color as stable and the other two colors as the primary and secondary variables.\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/0/code.py:807:def build_fill_pair(n: int, colors: list[int], rng: random.Random) -> tuple[np.ndarray, np.ndarray]:\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/0/code.py:834:def build_endpoints_pair(n: int, colors: list[int], rng: random.Random) -> tuple[np.ndarray, np.ndarray]:\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/0/code.py:874:def build_comp_checker_pair(n: int, colors: list[int], rng: random.Random) -> tuple[np.ndarray, np.ndarray]:\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/0/code.py:937:def build_sym_pair(n: int, colors: list[int], rng: random.Random, idx: int) -> tuple[np.ndarray, np.ndarray]:\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/0/code.py:957:def build_training_pair(kind: str, params: dict, n: int, colors: list[int], rng: random.Random):\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/0/code.py:959:        return build_fill_pair(n, colors, rng)\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/0/code.py:961:        return build_endpoints_pair(n, colors, rng)\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/0/code.py:963:        return build_comp_checker_pair(n, colors, rng)\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/0/code.py:965:        return build_sym_pair(n, colors, rng, params[\"idx\"])\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/6/code.py:16:#   - 原题把碎片拼成一个左右镜像的矩形，并默认镜像两侧同色。这里不能再沿用这个前提。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/6/code.py:18:#   - 输入仍然给出一个成组保留的 frame；非 frame 碎片散落在外部。先用 frame 重建 pre-swap\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/6/code.py:45:#   - 输入里能直接看到一个上下镜像的 frame 轮廓，且顶部/底部碎片成对出现；输出则保留这套上下\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/6/code.py:54:#   - 输入必含一个由少量 8 连通碎片组成的 UD-symmetric frame 组，其 union bbox 就是输出尺寸。\n/home/lixinyu/snap/new/ceshi/code_combo/2c181942/13/code.py:30:#        * one true hub: hollow 4x4, four pairwise-distinct side colors\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/9/code.py:8:#     keep: 输出仍是把真实单色碎片拼成一个严格左右镜像的致密矩形；框架锚点、\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/9/code.py:15:#       先按 D2/3 单变体生成一个“可识别框架 + 框外散落真实碎片 + 框内孤立噪声点”的基础画布。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/9/code.py:18:#       因而最终输入上，真实碎片、背景和干扰点都出现在网格单元里，网格线颜色独立且等距重复。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/9/code.py:20:#       人眼会先看到大面积规则格栅，再看到框内几颗零散彩点，以及框外若干真正碎片。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/9/code.py:27:#       原 solver 直接把所有非背景 4 连通分量当真碎片，再用总面积推输出尺寸。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/9/code.py:31:#       最后仅用剩余真实碎片执行原有传播式拼装。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/9/code.py:40:#       与原题允许的边界 1x1 真碎片形成可观察但不混乱的对照。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/9/code.py:47:#     - 旧代码假设所有非背景像素都是有效碎片；融合后网格线和干扰点都违反该前提。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/9/code.py:51:#     基础画布阶段仍保证真实碎片互不重叠、框内噪声不覆盖框架且彼此不相邻。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/9/code.py:55:#     真碎片在框外、干扰点在框内，两者空间分区清楚，视觉上不会糊成一团。\n/home/lixinyu/snap/new/ceshi/code_combo/e8686506/9/code.py:129:    assert len(vertical_line_candidates) <= 1, \"paired vertical edge-line color must be unique when present\"\n/home/lixinyu/snap/new/ceshi/code/1818057f/D4/0/code.py:69:      rule from a few IO pairs without relying on hidden color-id conventions.\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/1/code.py:18:#   - The training pair shares both colors, but the stable color is the\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/1/code.py:22:#     training pair's variable color.\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/1/code.py:31:#     layer from rule inference, and prefer the pair whose stable color is also\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/1/code.py:48:#     makes it visually collapse into an invert0-like complement rule.\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/1/code.py:114:    - The training pair keeps the stable color in exactly the same cells, while the test sprite reuses that stable color id in a different anchor shape.\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/1/code.py:117:    - Find the training pair by looking for two non-blank sprites that preserve at least one non-zero color mask exactly.\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/1/code.py:122:    - Shared colors alone do not identify the pair anymore; the unchanged placement of the shared anchor color shows which two frames form the example and which color should be ignored while learning the real transform.\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/1/code.py:580:def build_fill_pair(n: int, color: int, blocked: np.ndarray, rng: random.Random) -> tuple[np.ndarray, np.ndarray]:\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/1/code.py:619:def build_endpoints_pair(n: int, color: int, blocked: np.ndarray, rng: random.Random) -> tuple[np.ndarray, np.ndarray]:\n/home/lixinyu/snap/new/ceshi/code/4c7dc4dd/D13/1/code.py:649:def build_invert0_pair(n: int, color: int, blocked: np.ndarray, rng: random