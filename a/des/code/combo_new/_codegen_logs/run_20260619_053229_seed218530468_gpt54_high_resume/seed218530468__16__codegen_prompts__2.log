{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np\n\ndef connected(mask):\n    h,w=mask.shape\n    pts=list(zip(*np.where(mask)))\n    if not pts:return False\n    seen={pts[0]}; q=[pts[0]]\n    for r,c in q:\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef crop(mask):\n    pts=np.argwhere(mask)\n    r0,c0=pts.min(0); r1,c1=pts.max(0)\n    return mask[r0:r1+1,c0:c1+1]\n\ndef sample(h,w):\n    target=random.randint(max(2,h*w//4), min(h*w-2, 3*h*w//4))\n    cells=[(r,c) for r in range(h) for c in range(w)]\n    start=random.choice(cells)\n    A={start}; frontier=set()\n    for d in ((1,0),(-1,0),(0,1),(0,-1)):\n        nr,nc=start[0]+d[0],start[1]+d[1]\n        if 0<=nr<h and 0<=nc<w: frontier.add((nr,nc))\n    while len(A)<target and frontier:\n        cell=random.choice(tuple(frontier)); frontier.remove(cell); A.add(cell)\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=cell[0]+dr,cell[1]+dc\n            if 0<=nr<h and 0<=nc<w and (nr,nc) not in A: frontier.add((nr,nc))\n    if len(A)\"'!=target: return False\n    m=np.zeros((h,w),bool)\n    for r,c in A: m[r,c]=1\n    n=~m\n    if not connected(m) or not connected(n): return False\n    cm,cn=crop(m),crop(n)\n    if cm.sum()==cm.size or cn.sum()==cn.size: return False\n    return True\n\nfor h,w in [(3,4),(4,4),(4,5),(5,5),(5,6),(6,6)]:\n    ok=0\n    for _ in range(2000):\n        ok+=sample(h,w)\n    print((h,w), ok/2000)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
