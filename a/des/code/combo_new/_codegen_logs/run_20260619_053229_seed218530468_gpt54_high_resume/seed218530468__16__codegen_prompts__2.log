{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/7c66cb00.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import bbox_coords, crop_bbox, find_components, get_bg, label_mask, paste\nimport random\nfrom arc_utils import get_bg, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Dock two-tone sprites into color-matched horizontal bars with a color swap.\n\n    Input structure:\n    - bg = most common color.\n    - Top area: small two-tone sprites (outer color + inner color).\n    - Below: horizontal bars spanning most of the row, each with a fill color and border color on edges.\n\n    Rule:\n    - Match each sprite to the bar whose fill color equals the sprite's outer color.\n    - Place the sprite at its original x-position, aligned to the bar's bottom.\n    - Recolor: sprite outer → bar border, sprite inner → bar fill.\n    - Erase original sprites from the top area.\n\n    Key insight: Color matching is inverted — the sprite's dominant color identifies its target bar, then gets swapped to the bar's accent color.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    out = g.copy()\n    bg = int(Counter(g.flatten()).most_common(1)[0][0])\n\n    # Find bars.\n    bars = []\n    current_bar = None\n    for r in range(H):\n        row = g[int(r), :]\n        non_bg = [int(v) for v in row if int(v) != int(bg)]\n        if non_bg:\n            c = Counter(non_bg)\n            fill_color, count = c.most_common(1)[0]\n            if int(count) > int(W * 0.7):\n                border = int(row[0]) if int(row[0]) != int(fill_color) else int(row[-1])\n                if current_bar and int(current_bar[\"fill\"]) == int(fill_color):\n                    current_bar[\"r_max\"] = int(r)\n                else:\n                    if current_bar:\n                        bars.append(current_bar)\n                    current_bar = {\"fill\": int(fill_color), \"border\": int(border), \"r_min\": int(r), \"r_max\": int(r)}\n            else:\n                if current_bar:\n                    bars.append(current_bar)\n                    current_bar = None\n        else:\n            if current_bar:\n                bars.append(current_bar)\n                current_bar = None\n    if current_bar:\n        bars.append(current_bar)\n\n    assert bars, \"No bars found — grid must contain at least one horizontal bar\"\n\n    pattern_area_end = int(min(int(b[\"r_min\"]) for b in bars))\n\n    # Find patterns in top area: monochrome components by color, but we need full bbox content.\n    patterns = []\n    top = g[:pattern_area_end, :]\n    for col in sorted(set(map(int, top.flatten())) - {int(bg)}):\n        mask = top == int(col)\n        if not bool(mask.any()):\n            continue\n        lab, n = label_mask(mask, connectivity=4)\n        for region_id in range(1, int(n) + 1):\n            coords = np.argwhere(lab == int(region_id))\n            if coords.size == 0:\n                continue\n            b = bbox_coords(coords)\n            r0, c0, r1, c1 = map(int, b)\n            bbox = crop_bbox(g, (r0, c0, r1, c1))\n\n            colors_in_bbox = Counter(map(int, bbox.flatten()))\n            colors_in_bbox.pop(int(bg), None)\n            if not colors_in_bbox:\n                continue\n            outer_color = int(colors_in_bbox.most_common(1)[0][0])\n            inner_colors = [int(c) for c in colors_in_bbox.keys() if int(c) != int(outer_color)]\n            inner_color = int(inner_colors[0]) if inner_colors else None\n\n            patterns.append(\n                {\n                    \"outer_color\": int(outer_color),\n                    \"inner_color\": inner_color,\n                    \"r0\": int(r0),\n                    \"c0\": int(c0),\n                    \"h\": int(bbox.shape[0]),\n                    \"w\": int(bbox.shape[1]),\n                    \"content\": bbox,\n                }\n            )\n\n    # Clear patterns from output.\n    out[:pattern_area_end, :] = np.where(out[:pattern_area_end, :] != int(bg), int(bg), out[:pattern_area_end, :])\n\n    # Match and place patterns.\n    for bar in bars:\n        matching = [p for p in patterns if int(p[\"outer_color\"]) == int(bar[\"fill\"])]\n        for pat in matching:\n            transformed = np.array(pat[\"content\"], dtype=int).copy()\n            for rr in range(int(pat[\"h\"])):\n                for cc in range(int(pat[\"w\"])):\n                    v = int(transformed[int(rr), int(cc)])\n                    if v == int(pat[\"outer_color\"]):\n                        transformed[int(rr), int(cc)] = int(bar[\"border\"])\n                    elif pat[\"inner_color\"] is not None and v == int(pat[\"inner_color\"]):\n                        transformed[int(rr), int(cc)] = int(bar[\"fill\"])\n\n            place_r = int(bar[\"r_max\"] - pat[\"h\"] + 1)\n            place_c = int(pat[\"c0\"])\n            paste(out, transformed, place_r, place_c, transparent=int(bg))\n\n    return out\n\n# --------------- generator (Codex attempt 2) ---------------\n\n# --- Configuration constants ---\nGRID_H = 30                   # canvas height\nGRID_W = 24                   # canvas width\nBAR_COUNT_RANGE = (2, 3)      # number of horizontal bars\nSPRITE_COUNT_RANGE = (2, 3)   # number of sprites above bars\nBAR_HEIGHT_RANGE = (4, 8)     # per-bar row height\nMAX_THREE_BAR_TOTAL = 20      # max total bar height when n_bars == 3\nMIN_TOP_AREA = 7              # minimum rows above first bar for sprite area\nSPRITE_H_RANGE = (2, 5)      # sprite height (clamped to bar height)\nSPRITE_W_RANGE = (2, 9)      # sprite width\nINNER_COLOR_PROB = 0.45       # probability of adding an inner-color region\nGEN_RETRIES = 300             # max attempts in generate_input()\n\n\ndef _sample_bar_heights(n_bars: int) -> list[int]:\n    \"\"\"Sample bar heights that leave enough room for the sprite top area.\"\"\"\n    while True:\n        heights = [random.randint(*BAR_HEIGHT_RANGE) for _ in range(n_bars)]\n        if n_bars == 3 and sum(heights) > MAX_THREE_BAR_TOTAL:\n            continue\n        if GRID_H - sum(heights) - (n_bars - 1) < MIN_TOP_AREA:\n            continue\n        return heights\n\n\ndef _build_bars(bg: int, fills: list[int], borders: list[int],\n                heights: list[int]) -> tuple[np.ndarray, list[dict]]:\n    \"\"\"Render horizontal bars bottom-up and return (grid, bar_info_list).\"\"\"\n    grid = np.full((GRID_H, GRID_W), bg, dtype=int)\n    bars = [None] * len(heights)\n    r = GRID_H\n    for i in range(len(heights) - 1, -1, -1):\n        h = heights[i]\n        r0, r1 = r - h, r - 1\n        grid[r0:r1 + 1, 1:GRID_W - 1] = fills[i]\n        grid[r0:r1 + 1, 0] = borders[i]\n        grid[r0:r1 + 1, GRID_W - 1] = borders[i]\n        bars[i] = {\"fill\": fills[i], \"border\": borders[i],\n                    \"h\": h, \"r_min\": r0, \"r_max\": r1}\n        r = r0 - 1\n    return grid, bars\n\n\ndef _make_sprite(outer_idx: int, bars: list[dict]) -> dict:\n    \"\"\"Create a sprite patch with outer color and optional inner color region.\"\"\"\n    outer_fill = bars[outer_idx][\"fill\"]\n    h = random.randint(SPRITE_H_RANGE[0], min(SPRITE_H_RANGE[1], bars[outer_idx][\"h\"]))\n    w = random.randint(*SPRITE_W_RANGE)\n    patch = np.full((h, w), outer_fill, dtype=int)\n\n    inner_idx = None\n    inner_bbox = None\n    if len(bars) >= 2 and h >= 3 and w >= 3 and random.random() < INNER_COLOR_PROB:\n        inner_choices = [i for i in range(len(bars)) if i != outer_idx]\n        inner_idx = random.choice(inner_choices)\n        # Enumerate valid inner region sizes: centered horizontally, minority area\n        valid_inner = [(ih, iw)\n                       for ih in range(1, h - 1)\n                       for iw in range(1, w - 1)\n                       if (w - iw) % 2 == 0 and ih * iw * 2 < h * w]\n        if valid_inner:\n            ih, iw = random.choice(valid_inner)\n            ir0 = random.randint(1, h - ih - 1)\n            ic0 = (w - iw) // 2\n            patch[ir0:ir0 + ih, ic0:ic0 + iw] = bars[inner_idx][\"fill\"]\n            inner_bbox = (ir0, ic0, ih, iw)\n        else:\n            inner_idx = None\n\n    return {\"outer_idx\": outer_idx, \"inner_idx\": inner_idx,\n            \"patch\": patch, \"h\": h, \"w\": w, \"inner_bbox\": inner_bbox}\n\n\ndef _interval_free(occ: np.ndarray, start: int, length: int) -> bool:\n    \"\"\"Check that occ[start:start+length] is all False.\"\"\"\n    return not occ[start:start + length].any()\n\n\ndef _rect_separated(rects: list[tuple[int, int, int, int]],\n                     r0: int, c0: int, h: int, w: int) -> bool:\n    \"\"\"Check that a new rect has at least 1-cell gap from all existing rects.\"\"\"\n    r1, c1 = r0 + h - 1, c0 + w - 1\n    for rr0, cc0, rr1, cc1 in rects:\n        if not (r1 < rr0 - 1 or rr1 < r0 - 1 or c1 < cc0 - 1 or cc1 < c0 - 1):\n            return False\n    return True\n\n\ndef _place_sprites(sprites: list[dict], bars: list[dict],\n                   top_h: int) -> list[dict] | None:\n    \"\"\"Find valid placements for all sprites. Returns placed list or None.\"\"\"\n    bar_occ = [np.zeros(GRID_W, dtype=bool) for _ in bars]\n    top_rects: list[tuple[int, int, int, int]] = []\n    placed = []\n\n    for sp in sprites:\n        h, w = sp[\"h\"], sp[\"w\"]\n        outer_idx, inner_idx = sp[\"outer_idx\"], sp[\"inner_idx\"]\n\n        candidates = []\n        for c0 in range(1, GRID_W - w):\n            if not _interval_free(bar_occ[outer_idx], c0, w):\n                continue\n            if inner_idx is not None:\n                _, ic0, _, iw = sp[\"inner_bbox\"]\n                if not _interval_free(bar_occ[inner_idx], c0 + ic0, iw):\n                    continue\n            for r0 in range(0, top_h - h + 1):\n                if _rect_separated(top_rects, r0, c0, h, w):\n                    candidates.append((r0, c0))\n\n        if not candidates:\n            return None\n\n        r0, c0 = random.choice(candidates)\n        bar_occ[outer_idx][c0:c0 + w] = True\n        if inner_idx is not None:\n            _, ic0, _, iw = sp[\"inner_bbox\"]\n            bar_occ[inner_idx][c0 + ic0:c0 + ic0 + iw] = True\n\n        placed.append({**sp, \"r0\": r0, \"c0\": c0})\n        top_rects.append((r0, c0, r0 + h - 1, c0 + w - 1))\n\n    return placed\n\n\ndef _render(base: np.ndarray, placed: list[dict], bars: list[dict],\n            bg: int) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Render input (sprites in top area) and output (sprites docked in bars).\"\"\"\n    inp, out = base.copy(), base.copy()\n\n    for sp in placed:\n        patch = sp[\"patch\"].copy()\n        outer_bar = bars[sp[\"outer_idx\"]]\n        h, c0 = sp[\"h\"], sp[\"c0\"]\n\n        # Input: paste original sprite in top area\n        paste(inp, patch, sp[\"r0\"], c0, transparent=bg)\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg\nimport random\n\n\ndef _touches_edge(coords: np.ndarray, height: int, width: int) -> bool:\n    rows = coords[:, 0]\n    cols = coords[:, 1]\n    return bool(\n        np.any((rows == 0) | (rows == height - 1) | (cols == 0) | (cols == width - 1))\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, table, frame, and slot dimensions.\nCANVAS_MIN, CANVAS_MAX = 13, 19\nTABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\nROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\nAXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n\n# Object and palette sampling limits.\nN_COLORS, MAX_OBJECT_COLORS = 10, 6\nMAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\nOBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n\n# Rejection sampling cap.\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_axis_options(n_slots, slot_min, slot_max):\n    options = []\n\n    def rec_slots(i, cur):\n        if i == n_slots:\n            rec_seps(0, [], cur)\n            return\n        for size in range(slot_min, slot_max + 1):\n            rec_slots(i + 1, cur + [size])\n\n    def rec_seps(i, cur, slots):\n        if i == n_slots - 1:\n            for before in AXIS_OUTER_OPTIONS:\n                for after in AXIS_OUTER_OPTIONS:\n                    for pad_before in AXIS_PADDING_OPTIONS:\n                        for pad_after in AXIS_PADDING_OPTIONS:\n                            total = (\n                                before\n                                + after\n                                + pad_before\n                                + pad_after\n                                + sum(slots)\n                                + sum(cur)\n                            )\n                            if 13 <= total <= 19:\n                                options.append(\n                                    (\n                                        tuple(slots),\n                                        tuple(cur),\n                                        before,\n                                        after,\n                                        pad_before,\n                                        pad_after,\n                                        total,\n                                )\n                            )\n            return\n        for sep in AXIS_SEPARATOR_OPTIONS:\n            rec_seps(i + 1, cur + [sep], slots)\n\n    rec_slots(0, [])\n    return options\n\n\ndef _gen_positions(axis):\n    sizes, seps, outer_before, _outer_after, pad_before, _pad_after, _total = axis\n    starts = []\n    pos = outer_before + pad_before\n    for i, size in enumerate(sizes):\n        starts.append(pos)\n        pos += size\n        if i < len(seps):\n            pos += seps[i]\n    return starts\n\n\ndef _gen_choose_axis(n_slots, slot_min, slot_max, other_axis=None, max_object_loss=0):\n    options = _gen_axis_options(n_slots, slot_min, slot_max)\n    if other_axis is None:\n        return random.choice(options)\n\n    good = []\n    for axis in options:\n        row_axis = axis if slot_max == ROW_SLOT_SIZE_RANGE[1] else other_axis\n        col_axis = axis if slot_max == COL_SLOT_SIZE_RANGE[1] else other_axis\n        height = row_axis[-1]\n        width = col_axis[-1]\n        frame_height = height - row_axis[2] - row_axis[3]\n        frame_width = width - col_axis[2] - col_axis[3]\n        slot_area = sum(row_axis[0]) * sum(col_axis[0])\n        outer_bg = height * width - frame_height * frame_width\n        bg_room = outer_bg + slot_area - max_object_loss\n        frame_area = frame_height * frame_width - slot_area\n        if bg_room > frame_area:\n            good.append(axis)\n    return random.choice(good or options)\n\n\ndef _gen_assign_colors(shape, bg, frame):\n    n_slots = shape[0] * shape[1]\n    filled_count = random.randint(1, n_slots - 1)\n    filled = random.sample(range(n_slots), filled_count)\n    colors = [c for c in range(N_COLORS) if c not in (bg, frame)]\n    n_colors = random.randint(1, min(MAX_OBJECT_COLORS, filled_count, len(colors)))\n    palette = random.sample(colors, n_colors)\n    assignments = palette[:]\n    assignments.extend(random.choice(palette) for _ in range(filled_count - n_colors))\n    random.shuffle(assignments)\n\n    out = np.full(shape, bg, dtype=int)\n    for idx, color in zip(filled, assignments):\n        out[idx // shape[1], idx % shape[1]] = color\n    return out, filled_count\n\n\ndef _gen_object_shape(slot_h, slot_w):\n    by_area = {}\n    for obj_h in range(1, min(MAX_OBJECT_HEIGHT, slot_h - 2 * OBJECT_MARGIN) + 1):\n        for obj_w in range(1, min(MAX_OBJECT_WIDTH, slot_w - 2 * OBJECT_MARGIN) + 1):\n            by_area.setdefault(obj_h * obj_w, []).append((obj_h, obj_w))\n    area = random.choice(list(by_area))\n    return random.choice(by_area[area])\n\n\ndef _gen_choose_layout(rows, cols, filled_count):\n    row_axis = _gen_choose_axis(rows, *ROW_SLOT_SIZE_RANGE)\n    loss = MAX_OBJECT_AREA * filled_count\n    col_axis = _gen_choose_axis(cols, *COL_SLOT_SIZE_RANGE, row_axis, max_object_loss=loss)\n    return row_axis, col_axis, _gen_positions(row_axis), _gen_positions(col_axis)\n\n\ndef _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts):\n    height = row_axis[-1]\n    width = col_axis[-1]\n    grid = np.full((height, width), bg, dtype=int)\n    rt, rb = row_axis[2], row_axis[3]\n    cl, cr = col_axis[2], col_axis[3]\n    grid[rt : height - rb, cl : width - cr] = frame\n\n    for r, slot_h in zip(row_starts, row_axis[0]):\n        for c, slot_w in zip(col_starts, col_axis[0]):\n            grid[r : r + slot_h, c : c + slot_w] = bg\n    return grid\n\n\ndef _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts):\n    for out_r, slot_r in enumerate(row_starts):\n        slot_h = row_axis[0][out_r]\n        for out_c, slot_c in enumerate(col_starts):\n            color = int(out[out_r, out_c])\n            if color == bg:\n                continue\n            slot_w = col_axis[0][out_c]\n            obj_h, obj_w = _gen_object_shape(slot_h, slot_w)\n            obj_r = random.randint(slot_r + OBJECT_MARGIN, slot_r + slot_h - obj_h - OBJECT_MARGIN)\n            obj_c = random.randint(slot_c + OBJECT_MARGIN, slot_c + slot_w - obj_w - OBJECT_MARGIN)\n            grid[obj_r : obj_r + obj_h, obj_c : obj_c + obj_w] = color\n\n\ndef _gen_is_valid(grid, out, bg, frame):\n    counts = np.bincount(grid.ravel(), minlength=N_COLORS)\n    if int(np.argmax(counts)) != bg:\n        return False\n    if counts[frame] <= max(counts[c] for c in range(N_COLORS) if c not in (bg, frame)):\n        return False\n    try:\n        actual = main(grid)\n    except Exception:\n        return False\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py\"","aggregated_output":"import numpy as np\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Shear the rectangular input down-left onto a black canvas.\n\n    Input structure\n    A rectangular grid of colored pixels with no internal empty region to infer.\n\n    Rule\n    Create a black output with the same height and width W + H - 1, then copy\n    each input row r unchanged starting at column H - 1 - r.\n\n    Key insight\n    The colors and row contents are preserved; only the row offsets change so\n    the left edge forms a descending diagonal.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    out = np.zeros((h, w + h - 1), dtype=int)\n    for r in range(h):\n        start = h - 1 - r\n        out[r, start : start + w] = g[r]\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and palette bounds.\nMIN_HEIGHT, MAX_HEIGHT = 2, 10\nMIN_WIDTH, MAX_WIDTH = 1, 9\nMIN_COLOR_COUNT, MAX_COLOR_COUNT = 4, 5\nMAX_CELLS, MAX_OUTPUT_WIDTH = 36, 30\nPALETTE_VALUES = range(1, 10)\n\n# Fill pattern controls.\nFILL_MODES = (\"noise\", \"row_runs\", \"column_bands\", \"diagonal_bands\")\nMAX_ROW_RUN_CUTS = 3\nCOLUMN_NOISE_PROB = 0.5\nMIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND = 1, 3\nDIAGONAL_FLIP_PROB = 0.5\n\n# Generation safety.\nGENERATION_RETRIES = 300\n\n\ndef _ensure_palette_coverage(arr, palette):\n    positions = random.sample(range(arr.size), len(palette))\n    rows, cols = np.divmod(positions, arr.shape[1])\n    arr[rows, cols] = palette\n\n\ndef _fill_grid(h, w, palette):\n    k = len(palette)\n    mode = random.choice(FILL_MODES)\n    arr = np.zeros((h, w), dtype=int)\n\n    if mode == \"noise\":\n        arr[:] = np.random.choice(palette, size=(h, w))\n    elif mode == \"row_runs\":\n        for r in range(h):\n            cuts = sorted(random.sample(range(1, w), random.randint(0, min(w - 1, MAX_ROW_RUN_CUTS)))) if w > 1 else []\n            starts = [0] + cuts\n            ends = cuts + [w]\n            last = None\n            for c0, c1 in zip(starts, ends):\n                choices = [c for c in palette if c != last] or list(palette)\n                last = random.choice(choices)\n                arr[r, c0:c1] = last\n    elif mode == \"column_bands\":\n        for c in range(w):\n            arr[:, c] = random.choice(palette)\n        if random.random() < COLUMN_NOISE_PROB:\n            for r in range(h):\n                arr[r, random.randrange(w)] = random.choice(palette)\n    else:\n        band = random.randint(MIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND)\n        phase = random.randrange(k)\n        rows, cols = np.indices((h, w))\n        arr[:] = np.asarray(palette)[((rows + cols) // band + phase) % k]\n        if random.random() < DIAGONAL_FLIP_PROB:\n            arr = np.fliplr(arr)\n\n    _ensure_palette_coverage(arr, palette)\n    return arr\n\n\ndef _gen_attempt():\n    k = random.randint(MIN_COLOR_COUNT, MAX_COLOR_COUNT)\n    h = random.randint(MIN_HEIGHT, MAX_HEIGHT)\n    widths = [\n        w\n        for w in range(MIN_WIDTH, MAX_WIDTH + 1)\n        if h * w >= k and h * w <= MAX_CELLS and w + h - 1 <= MAX_OUTPUT_WIDTH\n    ]\n    if not widths:\n        return None\n    w = random.choice(widths)\n    palette = random.sample(PALETTE_VALUES, k)\n    return _fill_grid(h, w, palette)\n\n\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
