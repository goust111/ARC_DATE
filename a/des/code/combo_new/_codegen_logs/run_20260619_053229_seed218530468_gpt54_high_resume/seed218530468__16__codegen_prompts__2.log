{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nfrom itertools import product\n\ndef connected(mask):\n    h,w=mask.shape\n    pts=list(zip(*np.where(mask)))\n    if not pts:return False\n    seen={pts[0]}; q=[pts[0]]\n    for r,c in q:\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:\n                seen.add((nr,nc)); q.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef full_bbox(mask):\n    pts=np.argwhere(mask)\n    if len(pts)==0:return False\n    rs=pts[:,0]; cs=pts[:,1]\n    return rs.min()==0 and rs.max()==mask.shape[0]-1 and cs.min()==0 and cs.max()==mask.shape[1]-1\n\nh=w=4\nvalid=[]\nfor bits in range(1,1<<(h*w)):\n    m=np.array([(bits>>i)&1 for i in range(h*w)],dtype=bool).reshape(h,w)\n    if connected(m) and connected(~m) and full_bbox(m) and full_bbox(~m):\n        valid.append(m)\nprint('count',len(valid))\nfor idx,m in enumerate(valid[:20]):\n    print('---',idx)\n    for r in range(h):\n        print(''.join('1' if x else '0' for x in m[r]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
