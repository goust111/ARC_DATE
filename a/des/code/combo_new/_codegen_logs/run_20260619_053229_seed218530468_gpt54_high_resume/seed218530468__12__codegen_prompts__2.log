{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/train/7e576d6e.py | sed -n '158,360p'\"","aggregated_output":"   158\tdef main(grid: np.ndarray) -> np.ndarray:\n   159\t    \"\"\"\n   160\t    Draw the marker-colored route through the centers of all doors in the parallel wall maze.\n   161\t\n   162\t    Input structure:\n   163\t    - The grid has a background, parallel full-span walls, one three-pixel door\n   164\t      segment in each wall, and two marker pixels sharing a color.\n   165\t    - Walls are either all vertical or all horizontal, and the markers are on\n   166\t      opposite outer sides of the wall set.\n   167\t\n   168\t    Rule:\n   169\t    - Keep the scene unchanged except for the route.\n   170\t    - Visit the door centers in wall order from the upper/left marker side to\n   171\t      the lower/right marker side.\n   172\t    - In each corridor, draw an orthogonal path to the cell just before the next\n   173\t      wall, move along that wall to the door center, cross the center, and\n   174\t      continue to the next corridor; after the last door, connect to the other\n   175\t      marker.\n   176\t\n   177\t    Key insight:\n   178\t    - The three-pixel door segments mark the only crossing points through a set\n   179\t      of parallel walls, so the output is the corridor path threaded through\n   180\t      those centers.\n   181\t    \"\"\"\n   182\t    g = np.asarray(grid, dtype=int)\n   183\t    bg, path_color, door_color, wall_color = _roles(g)\n   184\t    orientation, centers = _door_centers(g, door_color)\n   185\t    markers = _markers(g, path_color)\n   186\t\n   187\t    if orientation == \"vertical\":\n   188\t        return _solve_vertical_walls(g, centers, markers, bg, path_color, door_color, wall_color)\n   189\t    assert orientation == \"horizontal\"\n   190\t    return _solve_horizontal_walls(g, centers, markers, bg, path_color, door_color, wall_color)\n   191\t\n   192\t# --------------- generator (att1) ---------------\n   193\t\n   194\t# Canvas and color role sampling.\n   195\tGRID_H = 30\n   196\tGRID_W = 30\n   197\tCOLOR_POOL = range(10)\n   198\tN_ROLE_COLORS = 4\n   199\t\n   200\t# Parallel wall and door geometry.\n   201\tORIENTATIONS = (\"vertical\", \"horizontal\")\n   202\tWALL_COUNT_RANGE = (3, 4)\n   203\tWALL_POS_LO = 4\n   204\tWALL_POS_HI_MARGIN = 5\n   205\tWALL_MIN_GAP = 2\n   206\tDOOR_CENTER_LO = 3\n   207\tDOOR_CENTER_HI_MARGIN = 4\n   208\t\n   209\t# Marker placement and retry budget.\n   210\tMARKER_EDGE_RANGE = (1, 3)\n   211\tMARKER_FREE_LO = 1\n   212\tMARKER_FREE_HI_MARGIN = 2\n   213\tGEN_RETRIES = 300\n   214\t\n   215\t\n   216\tdef _place_positions(n: int, lo: int, hi: int, min_gap: int, rng: random.Random) -> list[int] | None:\n   217\t    \"\"\"Place n positions in [lo..hi] with pairwise gap >= min_gap between consecutive sorted positions.\"\"\"\n   218\t    needed = n + (n - 1) * min_gap\n   219\t    span = hi - lo + 1\n   220\t    if span < needed:\n   221\t        return None\n   222\t    compressed_span = span - (n - 1) * min_gap\n   223\t    picks = sorted(rng.sample(range(compressed_span), n))\n   224\t    return [lo + picks[i] + i * min_gap for i in range(n)]\n   225\t\n   226\t\n   227\tdef _sample_wall_layout(orientation: str, n_walls: int, rng: random.Random):\n   228\t    \"\"\"Return wall positions and per-wall door centers for the chosen orientation.\"\"\"\n   229\t    wall_axis, door_axis = (GRID_W, GRID_H) if orientation == \"vertical\" else (GRID_H, GRID_W)\n   230\t    walls = _place_positions(\n   231\t        n_walls,\n   232\t        lo=WALL_POS_LO,\n   233\t        hi=wall_axis - WALL_POS_HI_MARGIN,\n   234\t        min_gap=WALL_MIN_GAP,\n   235\t        rng=rng,\n   236\t    )\n   237\t    if walls is None:\n   238\t        return None\n   239\t    doors = [rng.randint(DOOR_CENTER_LO, door_axis - DOOR_CENTER_HI_MARGIN) for _ in range(n_walls)]\n   240\t    return walls, doors\n   241\t\n   242\t\n   243\tdef _sample_markers(orientation: str, rng: random.Random) -> tuple[tuple[int, int], tuple[int, int]]:\n   244\t    \"\"\"Sample start/end markers on opposite outer corridors.\"\"\"\n   245\t    edge_lo, edge_hi = MARKER_EDGE_RANGE\n   246\t    if orientation == \"vertical\":\n   247\t        start_col = rng.randint(edge_lo, edge_hi)\n   248\t        start_row = rng.randint(MARKER_FREE_LO, GRID_H - MARKER_FREE_HI_MARGIN)\n   249\t        end_col = rng.randint(GRID_W - edge_hi - 1, GRID_W - edge_lo - 1)\n   250\t        end_row = rng.randint(MARKER_FREE_LO, GRID_H - MARKER_FREE_HI_MARGIN)\n   251\t    else:\n   252\t        start_row = rng.randint(edge_lo, edge_hi)\n   253\t        start_col = rng.randint(MARKER_FREE_LO, GRID_W - MARKER_FREE_HI_MARGIN)\n   254\t        end_row = rng.randint(GRID_H - edge_hi - 1, GRID_H - edge_lo - 1)\n   255\t        end_col = rng.randint(MARKER_FREE_LO, GRID_W - MARKER_FREE_HI_MARGIN)\n   256\t    return (start_row, start_col), (end_row, end_col)\n   257\t\n   258\t\n   259\tdef _render_grid(\n   260\t    orientation, bg, wall_color, door_color, marker_color, walls, doors, start, end\n   261\t) -> np.ndarray:\n   262\t    \"\"\"Render walls, doors, and the two markers into a fresh input grid.\"\"\"\n   263\t    grid = np.full((GRID_H, GRID_W), bg, dtype=int)\n   264\t    if orientation == \"vertical\":\n   265\t        for wall_col, door_row in zip(walls, doors):\n   266\t            grid[:, wall_col] = wall_color\n   267\t            grid[door_row - 1 : door_row + 2, wall_col] = door_color\n   268\t    else:\n   269\t        for wall_row, door_col in zip(walls, doors):\n   270\t            grid[wall_row, :] = wall_color\n   271\t            grid[wall_row, door_col - 1 : door_col + 2] = door_color\n   272\t\n   273\t    grid[start] = marker_color\n   274\t    grid[end] = marker_color\n   275\t    return grid\n   276\t\n   277\t\n   278\tdef _gen_attempt() -> np.ndarray | None:\n   279\t    rng = random.Random()\n   280\t    bg, wall_color, door_color, marker_color = rng.sample(COLOR_POOL, N_ROLE_COLORS)\n   281\t    orientation = rng.choice(ORIENTATIONS)\n   282\t    n_walls = rng.randint(*WALL_COUNT_RANGE)\n   283\t\n   284\t    layout = _sample_wall_layout(orientation, n_walls, rng)\n   285\t    if layout is None:\n   286\t        return None\n   287\t    walls, doors = layout\n   288\t    start, end = _sample_markers(orientation, rng)\n   289\t    grid = _render_grid(orientation, bg, wall_color, door_color, marker_color, walls, doors, start, end)\n   290\t\n   291\t    try:\n   292\t        main(grid)\n   293\t    except Exception:\n   294\t        return None\n   295\t\n   296\t    return grid\n   297\t\n   298\t\n   299\tdef generate_input() -> np.ndarray:\n   300\t    for _ in range(GEN_RETRIES):\n   301\t        result = _gen_attempt()\n   302\t        if result is not None:\n   303\t            return result\n   304\t    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
