{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/train/34cfa167.py | sed -n '93,420p'\"","aggregated_output":"    93\tdef main(grid: np.ndarray) -> np.ndarray:\n    94\t    \"\"\"\n    95\t    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.\n    96\t\n    97\t    Input structure:\n    98\t    - The background is the dominant color.\n    99\t    - Two same-color solid rectangular anchors of the same size sit on opposite\n   100\t      diagonal corners, with the first anchor above-left of the second.\n   101\t    - The upper-left anchor has two one-cell-thick vertical control bars to its\n   102\t      right and two one-cell-thick horizontal control bars below it.\n   103\t\n   104\t    Rule:\n   105\t    - Copy the anchor rectangle into the two missing corners of the implied\n   106\t      larger rectangle.\n   107\t    - Repeat the right-side control bars horizontally between the left and right\n   108\t      anchors, using their spacing as the period, and draw the outer top and\n   109\t      bottom borders in the first right-control color.\n   110\t    - Repeat the below-side control bars vertically between the top and bottom\n   111\t      anchors, using the same period, and draw the outer left and right borders\n   112\t      in the first below-control color.\n   113\t\n   114\t    Key insight: The small control bars are the first two ticks of two periodic\n   115\t    frame patterns; the diagonal anchor supplies the opposite corner and the\n   116\t    missing two anchor copies.\n   117\t    \"\"\"\n   118\t    g = np.asarray(grid, dtype=int)\n   119\t    bg = get_bg(g)\n   120\t    source, dest, right_controls, below_controls = _find_structure(g, bg)\n   121\t\n   122\t    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n   123\t    dr0, dc0, dr1, dc1 = dest[\"bbox\"]\n   124\t    anchor_color = int(source[\"color\"])\n   125\t    assert int(dest[\"color\"]) == anchor_color, \"anchor colors must match\"\n   126\t    assert bbox_h(source[\"bbox\"]) == bbox_h(dest[\"bbox\"]), \"anchor heights must match\"\n   127\t    assert bbox_w(source[\"bbox\"]) == bbox_w(dest[\"bbox\"]), \"anchor widths must match\"\n   128\t    assert sr0 > 0 and sc0 > 0, \"upper-left anchor must have space for outer frame\"\n   129\t    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \"lower-right anchor must have space for outer frame\"\n   130\t\n   131\t    right_offsets = [int(comp[\"bbox\"][1] - sc1) for comp in right_controls]\n   132\t    below_offsets = [int(comp[\"bbox\"][0] - sr1) for comp in below_controls]\n   133\t    assert right_offsets == below_offsets and right_offsets[0] == 1, \"control offsets must match from the anchor edge\"\n   134\t    step = int(right_offsets[1] - right_offsets[0])\n   135\t    assert step > 0, \"control bars must be separated\"\n   136\t    period = 2 * step\n   137\t    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, \"right frame must close next to the destination anchor\"\n   138\t    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, \"below frame must close next to the destination anchor\"\n   139\t\n   140\t    right_colors = [int(comp[\"color\"]) for comp in right_controls]\n   141\t    below_colors = [int(comp[\"color\"]) for comp in below_controls]\n   142\t    out = g.copy()\n   143\t\n   144\t    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)\n   145\t    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)\n   146\t\n   147\t    first_c = int(sc1 + right_offsets[0])\n   148\t    last_c = int(dc0 - 1)\n   149\t    for c in range(first_c, last_c + 1):\n   150\t        offset = int(c - sc1)\n   151\t        if (offset - right_offsets[0]) % period == 0:\n   152\t            color = right_colors[0]\n   153\t        elif (offset - right_offsets[1]) % period == 0:\n   154\t            color = right_colors[1]\n   155\t        else:\n   156\t            continue\n   157\t        _paint_rect(out, bg, sr0, c, sr1, c, color)\n   158\t        _paint_rect(out, bg, dr0, c, dr1, c, color)\n   159\t\n   160\t    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])\n   161\t    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])\n   162\t\n   163\t    first_r = int(sr1 + below_offsets[0])\n   164\t    last_r = int(dr0 - 1)\n   165\t    left_c = int(sc0 - 1)\n   166\t    right_c = int(dc1 + 1)\n   167\t    for r in range(first_r, last_r + 1):\n   168\t        _paint(out, bg, r, left_c, below_colors[0])\n   169\t        _paint(out, bg, r, right_c, below_colors[0])\n   170\t\n   171\t        offset = int(r - sr1)\n   172\t        if (offset - below_offsets[0]) % period == 0:\n   173\t            _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])\n   174\t            _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])\n   175\t        elif (offset - below_offsets[1]) % period == 0:\n   176\t            _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])\n   177\t            _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])\n   178\t\n   179\t    return out\n   180\t\n   181\t# --------------- generator (att2, o5x) ---------------\n   182\t\n   183\t# Color sampling.\n   184\tCOLOR_COUNT, NON_BG_COLOR_COUNT = 10, 4\n   185\t\n   186\t# Anchor/repetition geometry.\n   187\tANCHOR_SIZE_RANGE = (1, 5)\n   188\tREPEAT_COUNT_RANGE = (2, 5)\n   189\tCONTROL_OFFSETS = (1, 3)\n   190\tFRAME_PERIOD, DEST_ANCHOR_GAP, STRUCTURE_FIXED_PAD = 4, 2, 3\n   191\t\n   192\t# Canvas/margins.\n   193\tCANVAS_MIN_SIZE, CANVAS_MAX_SIZE = 16, 30\n   194\tMARGIN_CHOICES = range(4)\n   195\tMIN_TOTAL_MARGIN, SOURCE_OUTER_MARGIN = 1, 1\n   196\t\n   197\t# Retry.\n   198\tMAX_GENERATION_ATTEMPTS = 300\n   199\t\n   200\t\n   201\tdef _gen_paint_rect(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int) -> None:\n   202\t    grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)\n   203\t\n   204\t\n   205\tdef _choose_margins(struct_len: int) -> tuple[int, int]:\n   206\t    pairs = [\n   207\t        (before, after)\n   208\t        for before in MARGIN_CHOICES\n   209\t        for after in MARGIN_CHOICES\n   210\t        if MIN_TOTAL_MARGIN <= before + after\n   211\t        and CANVAS_MIN_SIZE <= struct_len + before + after <= CANVAS_MAX_SIZE\n   212\t    ]\n   213\t    return pairs[int(np.random.randint(len(pairs)))]\n   214\t\n   215\t\n   216\tdef _build_output(\n   217\t    rows: int,\n   218\t    cols: int,\n   219\t    bg: int,\n   220\t    anchor_color: int,\n   221\t    right1: int,\n   222\t    right2: int,\n   223\t    below1: int,\n   224\t    sr0: int,\n   225\t    sc0: int,\n   226\t    s: int,\n   227\t    nh: int,\n   228\t    nv: int,\n   229\t) -> tuple[np.ndarray, tuple[int, int, int, int, int, int, int, int]]:\n   230\t    out = np.full((rows, cols), int(bg), dtype=int)\n   231\t    sr1, sc1 = sr0 + s - 1, sc0 + s - 1\n   232\t    dr0 = sr1 + FRAME_PERIOD * nv + DEST_ANCHOR_GAP\n   233\t    dc0 = sc1 + FRAME_PERIOD * nh + DEST_ANCHOR_GAP\n   234\t    dr1, dc1 = dr0 + s - 1, dc0 + s - 1\n   235\t\n   236\t    for r0, c0 in ((sr0, sc0), (sr0, dc0), (dr0, sc0), (dr0, dc0)):\n   237\t        _gen_paint_rect(out, r0, c0, r0 + s - 1, c0 + s - 1, anchor_color)\n   238\t\n   239\t    first_c, last_c = sc1 + CONTROL_OFFSETS[0], dc0 - 1\n   240\t    for c in range(first_c, last_c + 1):\n   241\t        offset = c - sc1\n   242\t        if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:\n   243\t            color = right1\n   244\t        elif (offset - CONTROL_OFFSETS[1]) % FRAME_PERIOD == 0:\n   245\t            color = right2\n   246\t        else:\n   247\t            continue\n   248\t        _gen_paint_rect(out, sr0, c, sr1, c, color)\n   249\t        _gen_paint_rect(out, dr0, c, dr1, c, color)\n   250\t    _gen_paint_rect(out, sr0 - 1, first_c, sr0 - 1, last_c, right1)\n   251\t    _gen_paint_rect(out, dr1 + 1, first_c, dr1 + 1, last_c, right1)\n   252\t\n   253\t    first_r, last_r = sr1 + CONTROL_OFFSETS[0], dr0 - 1\n   254\t    left_c, right_c = sc0 - 1, dc1 + 1\n   255\t    for r in range(first_r, last_r + 1):\n   256\t        out[r, left_c] = below1\n   257\t        out[r, right_c] = below1\n   258\t        offset = r - sr1\n   259\t        if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:\n   260\t            _gen_paint_rect(out, r, left_c, r, sc1, below1)\n   261\t            _gen_paint_rect(out, r, dc0, r, right_c, below1)\n   262\t        elif (offset - CONTROL_OFFSETS[1]) % FRAME_PERIOD == 0:\n   263\t            _gen_paint_rect(out, r, sc0, r, sc1, right2)\n   264\t            _gen_paint_rect(out, r, dc0, r, dc1, right2)\n   265\t\n   266\t    return out, (sr0, sc0, sr1, sc1, dr0, dc0, dr1, dc1)\n   267\t\n   268\t\n   269\tdef _derive_input(\n   270\t    out: np.ndarray,\n   271\t    bg: int,\n   272\t    sr0: int,\n   273\t    sc0: int,\n   274\t    sr1: int,\n   275\t    sc1: int,\n   276\t    dr0: int,\n   277\t    dc0: int,\n   278\t    dr1: int,\n   279\t    dc1: int,\n   280\t) -> np.ndarray:\n   281\t    keep = np.zeros(out.shape, dtype=bool)\n   282\t    keep[sr0 : sr1 + 1, sc0 : sc1 + 1] = True\n   283\t    keep[dr0 : dr1 + 1, dc0 : dc1 + 1] = True\n   284\t    keep[sr0 : sr1 + 1, sc1 + CONTROL_OFFSETS[0]] = True\n   285\t    keep[sr0 : sr1 + 1, sc1 + CONTROL_OFFSETS[1]] = True\n   286\t    keep[sr1 + CONTROL_OFFSETS[0], sc0 : sc1 + 1] = True\n   287\t    keep[sr1 + CONTROL_OFFSETS[1], sc0 : sc1 + 1] = True\n   288\t\n   289\t    inp = np.full_like(out, int(bg))\n   290\t    inp[keep] = out[keep]\n   291\t    return inp\n   292\t\n   293\t\n   294\tdef _gen_attempt() -> np.ndarray | None:\n   295\t    bg = int(np.random.randint(COLOR_COUNT))\n   296\t    palette = [color for color in range(COLOR_COUNT) if color != bg]\n   297\t    anchor_color, right1, right2, below1 = map(\n   298\t        int, np.random.choice(palette, NON_BG_COLOR_COUNT, replace=False)\n   299\t    )\n   300\t\n   301\t    s = int(np.random.randint(ANCHOR_SIZE_RANGE[0], ANCHOR_SIZE_RANGE[1]))\n   302\t    nh = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))\n   303\t    nv = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))\n   304\t    struct_h = 2 * s + FRAME_PERIOD * nv + STRUCTURE_FIXED_PAD\n   305\t    struct_w = 2 * s + FRAME_PERIOD * nh + STRUCTURE_FIXED_PAD\n   306\t\n   307\t    top, bottom = _choose_margins(struct_h)\n   308\t    left, right = _choose_margins(struct_w)\n   309\t    rows, cols = struct_h + top + bottom, struct_w + left + right\n   310\t    sr0, sc0 = top + SOURCE_OUTER_MARGIN, left + SOURCE_OUTER_MARGIN\n   311\t\n   312\t    out, box = _build_output(\n   313\t        rows,\n   314\t        cols,\n   315\t        bg,\n   316\t        anchor_color,\n   317\t        right1,\n   318\t        right2,\n   319\t        below1,\n   320\t        sr0,\n   321\t        sc0,\n   322\t        s,\n   323\t        nh,\n   324\t        nv,\n   325\t    )\n   326\t    inp = _derive_input(out, bg, *box)\n   327\t\n   328\t    try:\n   329\t        if np.array_equal(main(inp), out):\n   330\t            return inp\n   331\t    except Exception:\n   332\t        return None\n   333\t    return None\n   334\t\n   335\t\n   336\tdef generate_input() -> np.ndarray:\n   337\t    for _ in range(MAX_GENERATION_ATTEMPTS):\n   338\t        grid = _gen_attempt()\n   339\t        if grid is not None:\n   340\t            return grid\n   341\t    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
