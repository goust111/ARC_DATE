{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/train/1d61978c.py | sed -n '1,340p'\"","aggregated_output":"     1\timport numpy as np\n     2\t\n     3\tfrom arc_utils import Color, get_bg\n     4\timport random\n     5\t\n     6\t\n     7\tdef main(grid: np.ndarray) -> np.ndarray:\n     8\t    \"\"\"Recolor the two diagonal foreground-bar orientations, assigning teal to the larger orientation and red to the smaller one.\n     9\t\n    10\t    Input structure\n    11\t    - The grid has one dominant background color and one foreground color.\n    12\t    - Foreground pixels form one-cell-thick diagonal bars.\n    13\t    - Every foreground pixel belongs to exactly one diagonal orientation.\n    14\t\n    15\t    Rule\n    16\t    - Keep the background unchanged.\n    17\t    - Classify each foreground pixel by whether it has a diagonal neighbor on the NW/SE axis or the NE/SW axis.\n    18\t    - Recolor the orientation with more foreground pixels teal and the other orientation red.\n    19\t\n    20\t    Key insight\n    21\t    - The output colors depend on the relative population of the two diagonal orientations, not on a fixed slash direction or position.\n    22\t    \"\"\"\n    23\t    g = np.asarray(grid, dtype=int)\n    24\t    bg = get_bg(g)\n    25\t    fg_colors = [int(color) for color in np.unique(g) if int(color) != bg]\n    26\t    assert len(fg_colors) == 1\n    27\t\n    28\t    fg = g != bg\n    29\t    out = g.copy()\n    30\t    height, width = g.shape\n    31\t    groups = {\"nw_se\": [], \"ne_sw\": []}\n    32\t\n    33\t    for r0, c0 in np.argwhere(fg):\n    34\t        r, c = int(r0), int(c0)\n    35\t        has_nw_se = (\n    36\t            (r > 0 and c > 0 and fg[r - 1, c - 1])\n    37\t            or (r + 1 < height and c + 1 < width and fg[r + 1, c + 1])\n    38\t        )\n    39\t        has_ne_sw = (\n    40\t            (r > 0 and c + 1 < width and fg[r - 1, c + 1])\n    41\t            or (r + 1 < height and c > 0 and fg[r + 1, c - 1])\n    42\t        )\n    43\t        assert has_nw_se ^ has_ne_sw\n    44\t        groups[\"nw_se\" if has_nw_se else \"ne_sw\"].append((r, c))\n    45\t\n    46\t    nw_se_count = len(groups[\"nw_se\"])\n    47\t    ne_sw_count = len(groups[\"ne_sw\"])\n    48\t    assert nw_se_count > 0 and ne_sw_count > 0\n    49\t    assert nw_se_count != ne_sw_count\n    50\t\n    51\t    larger = \"nw_se\" if nw_se_count > ne_sw_count else \"ne_sw\"\n    52\t    smaller = \"ne_sw\" if larger == \"nw_se\" else \"nw_se\"\n    53\t\n    54\t    for r, c in groups[larger]:\n    55\t        out[r, c] = Color.TEAL\n    56\t    for r, c in groups[smaller]:\n    57\t        out[r, c] = Color.RED\n    58\t\n    59\t    return out\n    60\t\n    61\t# --------------- generator (o5x) ---------------\n    62\t\n    63\t# Grid and palette.\n    64\tGRID_HEIGHT = 16\n    65\tGRID_WIDTH = 16\n    66\tBACKGROUND_COLOR, FOREGROUND_COLOR = Color.ORANGE, Color.GRAY\n    67\tLARGER_COLOR, SMALLER_COLOR = Color.TEAL, Color.RED\n    68\t\n    69\t# Bar orientation labels and diagonal column deltas.\n    70\tNW_SE = \"nw_se\"\n    71\tNE_SW = \"ne_sw\"\n    72\tORIENTATIONS = (NW_SE, NE_SW)\n    73\tORIENTATION_DC = {NW_SE: 1, NE_SW: -1}\n    74\t\n    75\t# Bar count, length, and foreground density bounds.\n    76\tTOTAL_BARS_MIN, TOTAL_BARS_MAX = 2, 6\n    77\tBAR_LENGTH_MIN, BAR_LENGTH_MAX = 2, 10\n    78\tFG_PIXELS_MIN, FG_PIXELS_MAX = 5, 29\n    79\t\n    80\t# Placement exclusion and retry controls.\n    81\tBLOCK_RADIUS = 1\n    82\tBLOCK_DELTAS = tuple(\n    83\t    (dr, dc)\n    84\t    for dr in range(-BLOCK_RADIUS, BLOCK_RADIUS + 1)\n    85\t    for dc in range(-BLOCK_RADIUS, BLOCK_RADIUS + 1)\n    86\t)\n    87\tGENERATION_ATTEMPTS = 300\n    88\t\n    89\t\n    90\tdef _coords_for_bar(orientation, length, r0, c0):\n    91\t    dc = ORIENTATION_DC[orientation]\n    92\t    return tuple((r0 + i, c0 + dc * i) for i in range(length))\n    93\t\n    94\t\n    95\tdef _make_bar_catalog():\n    96\t    catalog = {}\n    97\t    for orientation in ORIENTATIONS:\n    98\t        for length in range(BAR_LENGTH_MIN, BAR_LENGTH_MAX + 1):\n    99\t            bars = []\n   100\t            for r in range(GRID_HEIGHT - length + 1):\n   101\t                if orientation == NW_SE:\n   102\t                    cols = range(GRID_WIDTH - length + 1)\n   103\t                else:\n   104\t                    cols = range(length - 1, GRID_WIDTH)\n   105\t                for c in cols:\n   106\t                    bars.append(_coords_for_bar(orientation, length, r, c))\n   107\t            catalog[(orientation, length)] = tuple(bars)\n   108\t    return catalog\n   109\t\n   110\t\n   111\t_BAR_CATALOG = _make_bar_catalog()\n   112\t\n   113\t\n   114\tdef _blocked_after(coords):\n   115\t    blocked = set()\n   116\t    for r, c in coords:\n   117\t        for dr, dc in BLOCK_DELTAS:\n   118\t            rr, cc = r + dr, c + dc\n   119\t            if 0 <= rr < GRID_HEIGHT and 0 <= cc < GRID_WIDTH:\n   120\t                blocked.add((rr, cc))\n   121\t    return blocked\n   122\t\n   123\t\n   124\tdef _adjust_random_length(lengths, predicate, delta, required=True):\n   125\t    choices = [i for i, length in enumerate(lengths) if predicate(length)]\n   126\t    if not choices and not required:\n   127\t        return False\n   128\t    lengths[random.choice(choices)] += delta\n   129\t    return True\n   130\t\n   131\t\n   132\tdef _random_lengths(n):\n   133\t    lengths = [random.randint(BAR_LENGTH_MIN, BAR_LENGTH_MAX) for _ in range(n)]\n   134\t    while sum(lengths) > FG_PIXELS_MAX:\n   135\t        if not _adjust_random_length(lengths, lambda length: length > BAR_LENGTH_MIN, -1, required=False):\n   136\t            break\n   137\t    if sum(lengths) < FG_PIXELS_MIN:\n   138\t        _adjust_random_length(lengths, lambda length: length < BAR_LENGTH_MAX, 1)\n   139\t    random.shuffle(lengths)\n   140\t    return lengths\n   141\t\n   142\t\n   143\tdef _break_equal_orientation_lengths(nw_lengths, ne_lengths, total_pixels):\n   144\t    groups = [nw_lengths, ne_lengths]\n   145\t    group = random.choice(groups)\n   146\t    if total_pixels < FG_PIXELS_MAX:\n   147\t        if not _adjust_random_length(group, lambda length: length < BAR_LENGTH_MAX, 1, required=False):\n   148\t            other = ne_lengths if group is nw_lengths else nw_lengths\n   149\t            _adjust_random_length(other, lambda length: length > BAR_LENGTH_MIN, -1)\n   150\t    else:\n   151\t        if not _adjust_random_length(group, lambda length: length > BAR_LENGTH_MIN, -1, required=False):\n   152\t            other = ne_lengths if group is nw_lengths else nw_lengths\n   153\t            _adjust_random_length(other, lambda length: length < BAR_LENGTH_MAX, 1)\n   154\t\n   155\t\n   156\tdef _make_bar_specs():\n   157\t    total_count = random.randint(TOTAL_BARS_MIN, TOTAL_BARS_MAX)\n   158\t    nw_count = random.randint(1, total_count - 1)\n   159\t    ne_count = total_count - nw_count\n   160\t\n   161\t    lengths = _random_lengths(total_count)\n   162\t    nw_lengths = lengths[:nw_count]\n   163\t    ne_lengths = lengths[nw_count:]\n   164\t\n   165\t    nw_sum = sum(nw_lengths)\n   166\t    ne_sum = sum(ne_lengths)\n   167\t    if nw_sum == ne_sum:\n   168\t        _break_equal_orientation_lengths(nw_lengths, ne_lengths, sum(lengths))\n   169\t\n   170\t    specs = [(NW_SE, length) for length in nw_lengths]\n   171\t    specs.extend((NE_SW, length) for length in ne_lengths)\n   172\t    specs.sort(key=lambda item: (-item[1], random.random()))\n   173\t    return specs\n   174\t\n   175\t\n   176\tdef _place_bars(specs):\n   177\t    placed = []\n   178\t    blocked = set()\n   179\t    for orientation, length in specs:\n   180\t        candidates = [\n   181\t            coords\n   182\t            for coords in _BAR_CATALOG[(orientation, length)]\n   183\t            if all(coord not in blocked for coord in coords)\n   184\t        ]\n   185\t        if not candidates:\n   186\t            return None\n   187\t        coords = random.choice(candidates)\n   188\t        placed.append((orientation, coords))\n   189\t        blocked.update(_blocked_after(coords))\n   190\t    return placed\n   191\t\n   192\t\n   193\tdef _paint_coords(grid, coords, color):\n   194\t    rows, cols = zip(*coords)\n   195\t    grid[rows, cols] = color\n   196\t\n   197\t\n   198\tdef _render_input_grid(placed):\n   199\t    grid = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)\n   200\t    for _, coords in placed:\n   201\t        _paint_coords(grid, coords, FOREGROUND_COLOR)\n   202\t    return grid\n   203\t\n   204\t\n   205\tdef _expected_output(grid, placed):\n   206\t    counts = {orientation: 0 for orientation in ORIENTATIONS}\n   207\t    for orientation, coords in placed:\n   208\t        counts[orientation] += len(coords)\n   209\t    if counts[NW_SE] == counts[NE_SW]:\n   210\t        return None\n   211\t\n   212\t    larger = NW_SE if counts[NW_SE] > counts[NE_SW] else NE_SW\n   213\t    out = grid.copy()\n   214\t    for orientation, coords in placed:\n   215\t        color = LARGER_COLOR if orientation == larger else SMALLER_COLOR\n   216\t        _paint_coords(out, coords, color)\n   217\t    return out\n   218\t\n   219\t\n   220\tdef _gen_attempt():\n   221\t    specs = _make_bar_specs()\n   222\t    placed = _place_bars(specs)\n   223\t    if placed is None:\n   224\t        return None\n   225\t\n   226\t    grid = _render_input_grid(placed)\n   227\t    expected = _expected_output(grid, placed)\n   228\t    if expected is None:\n   229\t        return None\n   230\t    try:\n   231\t        if not np.array_equal(main(grid), expected):\n   232\t            return None\n   233\t    except Exception:\n   234\t        return None\n   235\t    return grid\n   236\t\n   237\t\n   238\tdef generate_input():\n   239\t    for _ in range(GENERATION_ATTEMPTS):\n   240\t        grid = _gen_attempt()\n   241\t        if grid is not None:\n   242\t            return grid\n   243\t    raise RuntimeError(\"failed to generate input\")\n","exit_code":0,"status":"completed"}}
