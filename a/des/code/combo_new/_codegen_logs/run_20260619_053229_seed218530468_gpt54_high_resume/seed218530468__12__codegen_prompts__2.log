{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/train/e048c9ed.py | sed -n '1,180p'\"","aggregated_output":"     1\timport numpy as np\n     2\t\n     3\tfrom arc_utils import Color, get_bg\n     4\timport random\n     5\t\n     6\t\n     7\t_QUANTITY_TO_COLOR = {2: Color.BLUE, 3: Color.YELLOW, 4: Color.MAROON, 5: Color.PINK}\n     8\t\n     9\t\n    10\tdef main(grid: np.ndarray) -> np.ndarray:\n    11\t    \"\"\"Add a quantity-color label in the top marker column for each horizontal bar.\n    12\t\n    13\t    Input structure\n    14\t    - The grid has a black background and one non-background marker pixel in the top row.\n    15\t    - Below the marker row, every non-empty source row contains one solid monochrome horizontal bar to the left of the marker column.\n    16\t    - Source rows are staggered every other row.\n    17\t\n    18\t    Rule\n    19\t    - Copy the input grid.\n    20\t    - For each source bar, read its quantity as the bar length.\n    21\t    - Paint the quantity color in the marker column on the same row as the bar:\n    22\t      2->1, 3->4, 4->9, 5->6.\n    23\t\n    24\t    Key insight\n    25\t    - The grey marker supplies the result column, while each bar supplies a small quantity with a fixed color code.\n    26\t    \"\"\"\n    27\t    g = np.asarray(grid, dtype=int)\n    28\t    bg = get_bg(g)\n    29\t    assert bg == 0, \"expected black background for square-digit labels\"\n    30\t\n    31\t    marker_cols = np.flatnonzero(g[0] != bg)\n    32\t    assert len(marker_cols) == 1, \"expected exactly one top-row marker\"\n    33\t    marker_c = int(marker_cols[0])\n    34\t    assert g[0, marker_c] == Color.GREY, \"top-row marker must be grey\"\n    35\t\n    36\t    source_rows = [r for r in range(1, g.shape[0]) if np.any(g[r] != bg)]\n    37\t    assert source_rows, \"expected at least one source bar\"\n    38\t    first_source_row = source_rows[0]\n    39\t\n    40\t    out = g.copy()\n    41\t    for bar_order, r in enumerate(source_rows):\n    42\t        assert (r - first_source_row) % 2 == 0, \"source bars must follow the staggered row spacing\"\n    43\t        cols = np.flatnonzero(g[r] != bg)\n    44\t        c0, c1 = int(cols[0]), int(cols[-1])\n    45\t        expected_cols = np.arange(c0, c1 + 1)\n    46\t        assert np.array_equal(cols, expected_cols), \"source row must contain one contiguous bar\"\n    47\t        assert np.unique(g[r, c0 : c1 + 1]).size == 1, \"source bar must be monochrome\"\n    48\t        assert c1 < marker_c, \"source bar must lie to the left of the marker column\"\n    49\t        assert g[r, marker_c] == bg, \"marker-column output cell must be empty\"\n    50\t\n    51\t        bar_length = c1 - c0 + 1\n    52\t        assert 2 <= bar_length <= 5, \"bar length quantity must be 2-5\"\n    53\t        assert bar_length in _QUANTITY_TO_COLOR, \"quantity must be one of 2, 3, 4, or 5\"\n    54\t        out[r, marker_c] = _QUANTITY_TO_COLOR[bar_length]\n    55\t\n    56\t    return out\n    57\t\n    58\t# --------------- generator (o5x) ---------------\n    59\t\n    60\t# Row/bar structure.\n    61\tBAR_COUNT_RANGE, FIRST_ROWS_SINGLE, FIRST_ROWS_MULTI = (1, 4), (2,), (1, 2)\n    62\tROW_STRIDE, BAR_LENGTHS, START_COL_RANGE = 2, (2, 3, 4, 5), (0, 2)\n    63\t# Marker/canvas placement.\n    64\tMARKER_COL_RANGE, MARKER_WEIGHTS = (2, 9), (8, 1)\n    65\tWIDTH_EXTRA_RANGE, MAX_WIDTH = (1, 8), 12\n    66\t# Colors and retry budget.\n    67\tCOLOR_RANGE, MARKER_COLOR, BG_COLOR = (1, 9), Color.GREY, 0\n    68\tMAX_ATTEMPTS = 300\n    69\t\n    70\tdef _gen_attempt() -> np.ndarray | None:\n    71\t    num_bars = random.randint(*BAR_COUNT_RANGE)\n    72\t    first_rows = FIRST_ROWS_SINGLE if num_bars == 1 else FIRST_ROWS_MULTI\n    73\t    first_src_row = random.choice(first_rows)\n    74\t    height = ROW_STRIDE * (first_src_row + num_bars - 1)\n    75\t\n    76\t    bar_lengths = random.sample(BAR_LENGTHS, k=num_bars)\n    77\t    start_cols = [random.randint(*START_COL_RANGE) for _ in range(num_bars)]\n    78\t    max_bar_end = max(c + length - 1 for c, length in zip(start_cols, bar_lengths))\n    79\t\n    80\t    marker_min = max(MARKER_COL_RANGE[0], max_bar_end + 1)\n    81\t    if marker_min > MARKER_COL_RANGE[1]:\n    82\t        return None\n    83\t    marker_choices = list(range(marker_min, MARKER_COL_RANGE[1] + 1))\n    84\t    marker_weights = [MARKER_WEIGHTS[0]] + [MARKER_WEIGHTS[1]] * (len(marker_choices) - 1)\n    85\t    marker_col = random.choices(marker_choices, weights=marker_weights, k=1)[0]\n    86\t    width = random.randint(marker_col + WIDTH_EXTRA_RANGE[0], min(MAX_WIDTH, marker_col + WIDTH_EXTRA_RANGE[1]))\n    87\t\n    88\t    grid = np.zeros((height, width), dtype=int)\n    89\t    grid[0, marker_col] = MARKER_COLOR\n    90\t\n    91\t    for i, (start_col, bar_length) in enumerate(zip(start_cols, bar_lengths)):\n    92\t        row = first_src_row + ROW_STRIDE * i\n    93\t        grid[row, start_col : start_col + bar_length] = random.randint(*COLOR_RANGE)\n    94\t\n    95\t    try:\n    96\t        main(grid)\n    97\t    except AssertionError:\n    98\t        return None\n    99\t    return grid\n   100\t\n   101\t\n   102\tdef generate_input() -> np.ndarray:\n   103\t    for _ in range(MAX_ATTEMPTS):\n   104\t        grid = _gen_attempt()\n   105\t        if grid is not None:\n   106\t            return grid\n   107\t    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
