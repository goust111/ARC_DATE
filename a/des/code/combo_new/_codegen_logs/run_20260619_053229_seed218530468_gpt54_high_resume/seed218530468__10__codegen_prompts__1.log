arting from the contacted left or right column.\n  97:     - Orange rectangles with no touching gray bar remain unchanged.\n  98: \n  99:     Key insight\n 100:     - The gray pixels are not copied by shape; their count is transferred into the neighboring orange rectangle as edge-aligned row or column stripes.\n 101:     \"\"\"\n 102:     g = np.asarray(grid, dtype=int)\n 103:     assert g.ndim == 2, \"expected a 2D grid\"\n 104:     assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.YELLOW, Color.GRAY, Color.ORANGE}\n 105: \n 106:     orange = find_components(g, bg=Color.YELLOW, colors=[Color.ORANGE], connectivity=4)\n 107:     gray = find_components(g, bg=Color.YELLOW, colors=[Color.GRAY], connectivity=4)\n 108:     assert orange and gray, \"expected orange rectangles and gray source bars\"\n 109: \n 110:     orange_index: dict[tuple[int, int], int] = {}\n 111:     orange_bboxes: list[tuple[int, int, int, int]] = []\n 112:     for i, obj in enumerate(orange):\n 113:         r0, c0, r1, c1 = obj[\"bbox\"]\n 114:         assert obj[\"area\"] == bbox_h(obj[\"bbox\"]) * bbox_w(obj[\"bbox\"])\n 115:         assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == Color.ORANGE)\n 116:         orange_bboxes.append((int(r0), int(c0), int(r1), int(c1)))\n 117:         for r, c in obj[\"coords\"]:\n 118:             orange_index[(int(r), int(c))] = i\n 119: \n 120:     source_by_target: dict[int, list[tuple[dict, list[tuple[int, int, int, int]]]]] = {}\n 121:     for src in gray:\n 122:         touched: dict[int, list[tuple[int, int, int, int]]] = {}\n 123:         for sr_raw, sc_raw in src[\"coords\"]:\n 124:             sr = int(sr_raw)\n 125:             sc = int(sc_raw)\n 126:             for tr, tc in neighbors4(sr, sc):\n 127:                 target_i = orange_index.get((int(tr), int(tc)))\n 128:                 if target_i is not None:\n 129:                     touched.setdefault(target_i, []).append((int(tr), int(tc), sr, sc))\n 130: \n 131:         assert len(touched) == 1, \"each gray bar must touch exactly one orange rectangle\"\n 132:         target_i = next(iter(touched))\n 133:         source_by_target.setdefault(target_i, []).append((src, touched[target_i]))\n 134: \n 135:     out = g.copy()\n 136:     out[g == Color.GRAY] = Color.YELLOW\n 137: \n 138:     for target_i, sources in source_by_target.items():\n 139:         r0, c0, r1, c1 = orange_bboxes[target_i]\n 140:         orientations = {_orientation(src[\"coords\"], contacts) for src, contacts in sources}\n 141:         assert len(orientations) == 1, \"all gray bars for one orange rectangle must share orientation\"\n 142:         count = sum(int(src[\"area\"]) for src, _contacts in sources)\n 143:         contacts = [contact for _src, src_contacts in sources for contact in src_contacts]\n 144: \n 145:         if orientations == {\"horizontal\"}:\n 146:             contact_rows = {tr for tr, _tc, _sr, _sc in contacts}\n 147:             assert contact_rows <= {r0, r1}\n 148:             _fill_rows(out, r0, c0, r1, c1, count, contact_rows)\n 149:         else:\n 150:             assert orientations == {\"vertical\"}\n 151:             contact_cols = {tc for _tr, tc, _sr, _sc in contacts}\n 152:             assert contact_cols <= {c0, c1}\n 153:             _fill_cols(out, r0, c0, r1, c1, count, contact_cols)\n 154: \n 155:     return out\n 156: \n 157: # --------------- generator (att1) ---------------\n 158: \n 159: GRID_H_RANGE, GRID_W_RANGE = (10, 18), (14, 18)\n 160: CONTENT_H_RANGE, CONTENT_W_RANGE = (6, 13), (12, 15)\n 161: BORDER_RANGE = (0, 4)\n 162: \n 163: EDGES, HORIZONTAL_EDGES = (\"top\", \"bottom\", \"left\", \"right\"), (\"top\", \"bottom\")\n 164: ORANGE_COUNT_CHOICES, ORANGE_COUNT_WEIGHTS = [1, 2, 3, 4], [1, 2, 3, 4]\n 165: ORANGE_H_RANGE, ORANGE_W_RANGE = (1, 5), (2, 6)\n 166: ORANGE_AREA_RANGE = (4, 12)\n 167: ORANGE_PLACE_RETRIES = 80\n 168: \n 169: MAX_UNTOUCHED_ORANGES = 1\n 170: BARS_PER_ORANGE_RANGE, TOTAL_BARS_RANGE = (1, 2), (2, 6)\n 171: BAR_LENGTH_RANGE = (1, 7)\n 172: BAR_COUNT_RETRIES = 50\n 173: \n 174: GENERATE_RETRIES = 300\n 175: \n 176: \n--- generate_input lines 397-402 ---\n 397: def generate_input() -> np.ndarray:\n 398:     for _ in range(GENERATE_RETRIES):\n 399:         result = _gen_attempt()\n 400:         if result is not None:\n 401:             return result\n 402:     raise RuntimeError(f\"Failed to generate valid input after {GENERATE_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/54dc2872.py =====\n--- main lines 51-179 ---\n  51: def main(grid: np.ndarray) -> np.ndarray:\n  52:     \"\"\"Move each marked L-shaped sprite onto the separate pixel matching its marker color.\n  53: \n  54:     Input structure\n  55:     - The background is the dominant color.\n  56:     - Foreground has 4-connected multicolor sprites and isolated one-pixel controls.\n  57:     - Each sprite has one repeated body color in an L shape plus one embedded marker\n  58:       pixel of a different color.\n  59: \n  60:     Rule\n  61:     - If the embedded marker color also appears as a separate isolated control pixel,\n  62:       translate the whole sprite so the body L-bend lands on that control pixel.\n  63:     - Clear each moved sprite from its old position, clear its consumed control pixel,\n  64:       then paste all translated sprites; sprites without a matching control stay put.\n  65: \n  66:     Key insight\n  67:     - The marker color pairs a sprite with its destination control, while the L-bend\n  68:       gives the orientation-independent anchor cell to place on that destination.\n  69:     \"\"\"\n  70:     g = np.asarray(grid, dtype=int)\n  71:     bg = get_bg(g)\n  72:     components = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n  73: \n  74:     controls_by_color: dict[int, list[tuple[int, int]]] = defaultdict(list)\n  75:     sprites = []\n  76:     for comp in components:\n  77:         coords = comp[\"coords\"]\n  78:         if len(coords) == 1:\n  79:             r, c = map(int, coords[0])\n  80:             controls_by_color[int(g[r, c])].append((r, c))\n  81:         else:\n  82:             sprites.append(comp)\n  83: \n  84:     moves = []\n  85:     for sprite in sprites:\n  86:         coords = sprite[\"coords\"]\n  87:         counts = Counter(int(g[r, c]) for r, c in coords)\n  88:         marker_colors = [color for color, count in counts.items() if count == 1]\n  89:         body_colors = [color for color, count in counts.items() if count > 1]\n  90:         assert len(counts) == 2, f\"sprite must have two colors, got {counts}\"\n  91:         assert len(marker_colors) == 1, f\"sprite must have one embedded marker, got {counts}\"\n  92:         assert len(body_colors) == 1, f\"sprite must have one body color, got {counts}\"\n  93: \n  94:         body_color = body_colors[0]\n  95:         body_coords = np.array(\n  96:             [(int(r), int(c)) for r, c in coords if int(g[r, c]) == body_color],\n  97:             dtype=int,\n  98:         )\n  99:         anchor = _l_bend(body_coords)\n 100: \n 101:         marker_color = marker_colors[0]\n 102:         marker = next(\n 103:             (int(r), int(c)) for r, c in coords if int(g[r, c]) == marker_color\n 104:         )\n 105:         controls = controls_by_color.get(marker_color, [])\n 106:         if not controls:\n 107:             continue\n 108:         assert len(controls) == 1, f\"marker color {marker_color} must have one control\"\n 109:         target = controls[0]\n 110:         _outer_diagonal_distance(anchor, marker, target)\n 111: \n 112:         dr = target[0] - anchor[0]\n 113:         dc = target[1] - anchor[1]\n 114: \n 115:         translated = []\n 116:         for r, c in coords:\n 117:             nr = int(r) + dr\n 118:             nc = int(c) + dc\n 119:             assert 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1], \"move must stay in bounds\"\n 120:             translated.append((nr, nc, int(g[r, c])))\n 121:         moves.append((coords, target, translated))\n 122: \n 123:     assert moves, \"expected at least one marker-controlled move\"\n 124: \n 125:     out = g.copy()\n 126:     cleared = set()\n 127:     for coords, target, _translated in moves:\n 128:         for r, c in coords:\n 129:             cleared.add((int(r), int(c)))\n 130:         cleared.add(target)\n 131:     for r, c in cleared:\n 132:         out[r, c] = bg\n 133: \n 134:     occupied = set()\n 135:     for _coords, _target, translated in moves:\n 136:         for r, c, _color in translated:\n 137:             assert out[r, c] == bg, \"translated sprite must land on cleared/background cells\"\n 138:             assert (r, c) not in occupied, \"translated sprites must not overlap\"\n 139:             occupied.add((r, c))\n 140:         for r, c, color in translated:\n 141:             out[r, c] = color\n 142: \n 143:     return out\n 144: \n 145: # --------------- generator (attempt 2) ---------------\n 146: \n 147: # Canvas and palette.\n 148: BG_COLOR = 0\n 149: GRID_ROWS = 12\n 150: GRID_COL_CHOICES = [12, 13]\n 151: COLORS = list(range(1, 10))\n 152: \n 153: # L-sprite geometry.\n 154: LEG_LEN_MIN = 2\n 155: LEG_LEN_MAX = 4\n 156: MIN_BODY_PIXELS = 4\n 157: ORIENTATION_COUNT = 4\n 158: LEG_PAIRS = [\n 159:     (v_len, h_len)\n 160:     for v_len in range(LEG_LEN_MIN, LEG_LEN_MAX + 1)\n 161:     for h_len in range(LEG_LEN_MIN, LEG_LEN_MAX + 1)\n 162:     if v_len + h_len - 1 >= MIN_BODY_PIXELS\n 163: ]\n 164: \n 165: # Sprite/control counts and rates.\n 166: SPRITE_COUNT_MIN = 2\n 167: SPRITE_COUNT_MAX = 4\n 168: MIN_MOVED_SPRITES = 1\n 169: MAX_MOVED_SPRITES = 2\n 170: MAX_STATIONARY_SPRITES = 2\n... [truncated]\n--- generate_input lines 377-382 ---\n 377: def generate_input() -> np.ndarray:\n 378:     for _ in range(GENERATION_RETRIES):\n 379:         grid = _gen_attempt()\n 380:         if grid is not None:\n 381:             return grid\n 382:     raise RuntimeError(\"failed to generate valid input\")\n\n","exit_code":0,"status":"completed"}}
