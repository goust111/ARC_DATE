snap/new/ARC_code/eval/7b0280bc.py:400:    \"\"\"Generate the sequence of footprint top-left positions from (sr,sc) to (er,ec).\n/home/lixinyu/snap/new/ARC_code/eval/7b0280bc.py:403:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7b0280bc.py:422:    \"\"\"Route a (N-1)-wide track strip between two node squares.\n/home/lixinyu/snap/new/ARC_code/eval/7b0280bc.py:426:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7b0280bc.py:455:    \"\"\"Single attempt to generate a valid input grid.  Returns None on failure.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7b0280bc.py:565:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/37ce87bb.py:32:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/37ce87bb.py:33:    \"\"\"Compute a grey result bar by adding teal bar heights and subtracting red bar heights.\n/home/lixinyu/snap/new/ARC_code/train/37ce87bb.py:47:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/37ce87bb.py:84:    \"\"\"Sample positive bounded parts summing to total, or None if impossible.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/37ce87bb.py:103:    \"\"\"Sample shuffled operand specs and the matching grey result height.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/37ce87bb.py:150:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py:8:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py:9:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py:12:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py:16:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py:22:    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py:23:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py:471:def generate_input():\n/home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py:9:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py:10:    \"\"\"Convert scattered foreground objects into bottom-aligned count bars in a fixed five-color order.\n/home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py:26:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py:71:    \"\"\"Generate one candidate grid, returning None when placement or validation fails.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py:88:    \"\"\"Sample per-color component counts matching the output histogram contract.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py:114:    \"\"\"Place each color's requested number of same-color-separated blobs.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py:161:    \"\"\"Recompute 8-connected components to reject accidental same-color merges.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py:189:    \"\"\"Generate a random small 8-connected blob mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py:211:    \"\"\"Grow a small mask by repeatedly adding an 8-neighbor of existing pixels.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py:259:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py:6:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py:7:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py:10:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py:14:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py:19:    Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n/home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py:20:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py:427:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:59:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:60:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:63:    Input structure:\n/home/lixinyu/snap/new/ARC_code/t