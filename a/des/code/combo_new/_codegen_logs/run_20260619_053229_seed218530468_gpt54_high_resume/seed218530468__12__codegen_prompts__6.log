comp_id in range(1, n_bg + 1):\n    94\t        if comp_id in exterior_ids:\n    95\t            continue\n    96\t        coords = np.argwhere(bg_lab == comp_id)\n    97\t        if _touches_long_contour(coords, fill_lab, long_ids):\n    98\t            out[bg_lab == comp_id] = fill_color\n    99\t\n   100\t    return out\n   101\t\n   102\t# --------------- generator (att2) ---------------\n   103\t\n   104\t# Canvas and palette.\n   105\tH, W = 30, 30\n   106\tGRID_SHAPE = (H, W)\n   107\tARC_COLOR_COUNT = 10\n   108\t\n   109\t# Long contour path layout.\n   110\tPATH_COUNT_OPTIONS = (2, 3)\n   111\tPATH_STEP_OPTIONS = (-1, 0, 1)\n   112\tPATH_GAP_MIN, PATH_GAP_MAX = 2, 5\n   113\tPATH_LEFT_MIN_COL, PATH_RIGHT_MARGIN = 2, 3\n   114\tPATH_START_MIN_COL = 3\n   115\tPATH_START_RIGHT_MARGIN = 4\n   116\tPATH_FAR_END_MIN_CHOICES, PATH_FAR_END_PROB, PATH_FAR_END_DELTA = 8, 0.7, 5\n   117\tPATH_SCORING_CANDIDATES = 5\n   118\tPATH_MIN_MOVES = 12\n   119\t\n   120\t# Contour distractors and extra contour pixels.\n   121\tOUTSIDE_MARGIN = 2\n   122\tOUTSIDE_SIDE_OPTIONS = (-1, 1)\n   123\tSHORT_FRAGMENT_COUNT_MIN, SHORT_FRAGMENT_COUNT_MAX = 3, 5\n   124\tSHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX = 1, 4\n   125\tSHORT_FRAGMENT_ATTEMPTS = 200\n   126\tSHORT_FRAGMENT_PATH_PADDING = 3\n   127\tCONTOUR_PIXELS_MIN, CONTOUR_PIXELS_MAX = 81, 108\n   128\t\n   129\t# Obstacle bars and scattered clusters.\n   130\tBAR_SEGMENT_MAX = 11\n   131\tSINGLE_CHANNEL_BARS_MIN, SINGLE_CHANNEL_BARS_MAX = 5, 11\n   132\tMULTI_CHANNEL_TOTAL_BARS_MIN, MULTI_CHANNEL_TOTAL_BARS_MAX = 4, 10\n   133\tMULTI_CHANNEL_INITIAL_BARS = 2\n   134\tMULTI_CHANNEL_MAX_BARS = 5\n   135\tBAR_WIDTH_MIN, BAR_WIDTH_MAX = 1, 5\n   136\tOBSTACLE_PIXELS_MIN, OBSTACLE_PIXELS_MAX = 36, 63\n   137\tOBSTACLE_EXTRA_PIXELS_MIN = 8\n   138\tOBSTACLE_OUTSIDE_QUOTA_MIN, OBSTACLE_OUTSIDE_QUOTA_MAX = 8, 16\n   139\tOBSTACLE_CLUSTER_SIZE_MIN, OBSTACLE_CLUSTER_SIZE_MAX = 1, 5\n   140\tOBSTACLE_ATTEMPTS = 300\n   564\tdef generate_input() -> np.ndarray:\n   565\t    for _ in range(GENERATION_ATTEMPTS):\n   566\t        grid = _gen_attempt()\n   567\t        if grid is not None:\n   568\t            return grid\n   569\t    raise RuntimeError(\"failed to generate valid 753ea09b input\")\n","exit_code":0,"status":"completed"}}
