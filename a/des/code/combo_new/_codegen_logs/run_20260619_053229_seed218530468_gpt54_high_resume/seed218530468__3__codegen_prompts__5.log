{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed218530468/3/5.py')\nmod = SourceFileLoader('new_arc_task_verify', str(p)).load_module()\n\nfor _ in range(50):\n    inp = mod.generate_input()\n    out = mod.main(inp)\n    objects, groups, isolated = mod._parse_scene(inp)\n\n    for idx in isolated:\n        for r, c in objects[idx]['coords']:\n            assert out[r, c] == mod.GREY\n\n    for group in groups:\n        color = group['color']\n        members = list(group['objects'])\n        coords = [pt for idx in members for pt in objects[idx]['coords']]\n        rows = [r for r, _ in coords]\n        cols = [c for _, c in coords]\n        r0, r1 = min(rows), max(rows)\n        c0, c1 = min(cols), max(cols)\n        n = len(members)\n        if n == 2:\n            for r, c in coords:\n                assert out[r, c] == color\n            for edge in group['edges']:\n                for r, c in edge['pixels']:\n                    assert out[r, c] == color\n        elif n == 3:\n            assert np.all(out[r0, c0:c1+1] == color)\n            assert np.all(out[r1, c0:c1+1] == color)\n            assert np.all(out[r0:r1+1, c0] == color)\n            assert np.all(out[r0:r1+1, c1] == color)\n            for r, c in coords:\n                assert out[r, c] == color\n        else:\n            assert np.all(out[r0:r1+1, c0:c1+1] == color)\nprint('semantic_ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
