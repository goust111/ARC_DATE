{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fit a grey bar into a grey frame by aligning projections with colored columns, then stack colors above.\n\n    Input structure:\n    - bg, a grey structural color forming two components: a large rectangular frame (slot) and a smaller bar with upward projections.\n    - Colored pixels inside the slot mark target columns.\n\n    Rule:\n    - Move the bar upward into the slot so its bottom edge sits one cell above the slot's interior bottom.\n    - Shift it horizontally so the bar's upward projections align column-wise with the colored pixels in the slot.\n    - Stack the colored pixels immediately above the bar projections in each column.\n\n    Key insight: The bar's projections act as keys that must align with the colored-column \"locks\" in the slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    # Background: most frequent. \"Grey\" structural color: most frequent non-bg.\n    bg = _bg_color(g)\n    other = g[g != bg]\n    if other.size == 0:\n        return g.copy()\n    grey = _most_common(other)\n\n    def comps_of_color(color: int):\n        comps = [(len(pts), _bbox(pts), pts) for pts in _cc4(g == color)]\n        comps.sort(key=lambda t: (-t[0], t[1]))\n        return comps\n\n    grey_comps = comps_of_color(grey)\n    if len(grey_comps) < 2:\n        return g.copy()\n\n    # Slot is the largest grey component (the right-side frame); bar is the next largest.\n    (_, slot_bbox, _), (_, bar_bbox, bar_pts) = grey_comps[0], grey_comps[1]\n    sr0, sc0, sr1, sc1 = slot_bbox\n\n    # Base output: keep only the slot bbox content, clear all colored pixels inside it.\n    out = np.full_like(g, bg)\n    out[sr0 : sr1 + 1, sc0 : sc1 + 1] = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region = out[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region[(slot_region != bg) & (slot_region != grey)] = bg\n\n    # Compute bar translation: bottom of bar sits 1 cell above slot interior bottom.\n    bar_base_row = max(r for r, _ in bar_pts)\n    slot_interior_bottom = sr1 - 1\n    target_base_row = slot_interior_bottom - 1\n    dy = target_base_row - bar_base_row\n\n    # Determine bar projection columns (columns with any bar pixel above the base row).\n    col_min_row = {}\n    for r, c in bar_pts:\n        col_min_row[c] = min(col_min_row.get(c, r), r)\n    src_proj_cols = sorted([c for c, rmin in col_min_row.items() if rmin < bar_base_row])\n\n    # Determine destination columns from colored pixels in the original slot.\n    dst_cols_set = set()\n    for r, c in np.argwhere((g != bg) & (g != grey)):\n        r = int(r)\n        c = int(c)\n        if sr0 <= r <= sr1 and sc0 <= c <= sc1:\n            dst_cols_set.add(c)\n    dst_cols = sorted(dst_cols_set)\n\n    # Compute a robust horizontal shift aligning projection columns to colored columns.\n    dx = None\n    if src_proj_cols and len(src_proj_cols) == len(dst_cols):\n        deltas = [d - s for s, d in zip(src_proj_cols, dst_cols)]\n        if len(set(deltas)) == 1:\n            dx = deltas[0]\n    if dx is None:\n        # Brute pick dx that maximizes overlap of shifted projection cols with dst cols.\n        best = (-1, 0)\n        dst_set = set(dst_cols)\n        for cand_dx in range(-w, w + 1):\n            score = sum((c + cand_dx) in dst_set for c in src_proj_cols)\n            if score > best[0]:\n                best = (score, cand_dx)\n        dx = best[1]\n\n    # Paste bar into the slot (overwrite with grey).\n    placed = []\n    for r, c in bar_pts:\n        rr = r + dy\n        cc = c + dx\n        if sr0 <= rr <= sr1 and sc0 <= cc <= sc1:\n            out[rr, cc] = grey\n            placed.append((rr, cc))\n\n    # Move colored pixels: for each affected column, stack them immediately above the top of the bar in that column.\n    # Use colors from the original grid (inside slot bbox), ordered top->bottom.\n    placed_by_col = {}\n    for rr, cc in placed:\n        placed_by_col.setdefault(cc, []).append(rr)\n\n    interior_top = sr0 + 1\n    interior_bottom = sr1 - 1\n\n    for col in dst_cols:\n        if col not in placed_by_col:\n            continue\n        bar_top = min(placed_by_col[col])\n        desired_bottom = bar_top - 1\n        if desired_bottom < interior_top:\n            continue\n\n        # Extract original colored pixels in this column (ignore bg/grey).\n        rows = [r for r in range(sr0, sr1 + 1) if g[r, col] != bg and g[r, col] != grey]\n        if not rows:\n            continue\n        colors = [int(g[r, col]) for r in rows]  # top->bottom order by construction\n\n        max_len = desired_bottom - interior_top + 1\n        if max_len <= 0:\n            continue\n        if len(colors) > max_len:\n            colors = colors[-max_len:]\n\n        start_row = desired_bottom - len(colors) + 1\n        start_row = max(start_row, interior_top)\n\n        # Paint (overwrite) within the interior only.\n        for i, colv in enumerate(colors):\n            rr = start_row + i\n            if interior_top <= rr <= interior_bottom:\n                out[rr, col] = colv\n\n    return out\n\n# --------------- generator (attempt 3 (Codex)) ---------------\n\n# --- Palette ---\nBG = 0\nGREY = 5\nPALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)  # colors != bg and != grey\n\n# --- Canvas geometry (fixed per spec) ---\nH, W = 8, 20\n\n# --- Frame (right-hand slot) ---\nFRAME_R0, FRAME_C0 = 0, 9            # top-left of frame patch\nFRAME_H, FRAME_W = 8, 11             # frame patch dimensions\nLEFT_WALL_OPEN_ROWS = (4, 5)         # rows where the left wall of the frame is open\n\n# --- Slot columns inside the frame ---\nSLOT_COLS = [11, 13, 15, 17]         # absolute col indices\nSLOT_LENS = [3, 4, 4, 3]             # per-col length counted from row 1\nSLOT_TOP_ROW = 1                     # topmost interior row of slot columns\n\n# --- Bar geometry ---\nBAR_INPUT_C0 = 1                     # left column of bar in the input (pre-translation)\nBAR_OUTPUT_C0 = 11                   # left column of bar in the expected output (post-translation)\nBAR_R0 = 2                           # top row where bar patch is pasted\nBAR_H, BAR_W = 4, 7                  # bar patch dimensions (4 rows tall, base at local row 3)\nBAR_LOCAL_PROJ_COLS = [0, 2, 4, 6]   # bar projection columns within the patch\nBAR_BASE_ABS_ROW = BAR_R0 + BAR_H - 1  # row 5, absolute row of bar base after paste\n\n# --- Sampling parameters ---\nHEIGHT0_RANGE = (2, 5)               # rng.integers(low, high) -> {2,3,4} for first proj\nHEIGHT_REST_RANGE = (1, 5)           # rng.integers(low, high) -> {1,2,3,4} for other projs\nMAX_ATTEMPTS = 300\n\n\ndef _frame_patch() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the region enclosed by a wall sprite and radiate color outward through its opening.\n\n    Input structure:\n    - bg = most common color. Wall = most frequent non-bg color, forming a partial enclosure (e.g. U-shape).\n    - A fill-color pixel sits inside the enclosed area. Other non-bg pixels may act as obstacles.\n    Rule:\n    - Flood-fill the enclosed area with the fill color, radiating outward through the wall's open end.\n    - Obstacles cast \"shadows\" along the radiate direction, blocking fill behind them.\n\n    Key insight: The wall endpoints define the opening direction; fill radiates outward through it, and obstacles block propagation along that same axis.\n    \"\"\"\n    g = np.array(grid, copy=True)\n    h, w = g.shape\n\n    vals = np.unique(g)\n    bg = get_bg(g)\n\n    non_bg = [int(v) for v in vals if int(v) != bg]\n    assert non_bg, \"expected at least one non-background color\"\n\n    # Wall: most frequent non-background color.\n    wall = max(non_bg, key=lambda c: int((g == c).sum()))\n\n    wall_mask = g == wall\n\n    # Wall connected components (8-neigh).\n    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]\n    assert comps, \"expected at least one wall connected component\"\n\n    def sgn(x: int) -> int:\n        return (x > 0) - (x < 0)\n\n    other_colors = [c for c in non_bg if c != wall]\n    assert other_colors, \"expected at least one non-wall color (fill color)\"\n\n    # Pick fill color as the non-wall color closest (Manhattan distance) to the wall pixels.\n    wall_points = [p for comp in comps for p in comp]\n\n    def min_dist_to_wall(color: int) -> tuple[int, int]:\n        pts = list(zip(*np.where(g == color)))\n        pts = [(int(r), int(c)) for r, c in pts]\n        best_d = 10**9\n        for r, c in pts:\n            for wr, wc in wall_points:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0, len(pts)\n        return best_d, len(pts)\n\n    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))\n\n    fill_pos = list(zip(*np.where(g == fill)))\n    fill_pos = [(int(r), int(c)) for r, c in fill_pos]\n    if not fill_pos:\n        return g\n\n    # Choose the closest wall component to the fill seed (ties: larger component).\n    def comp_min_dist(comp: set[tuple[int, int]]) -> int:\n        best_d = 10**9\n        for r, c in fill_pos:\n            for wr, wc in comp:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0\n        return best_d\n\n    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))\n\n    comp_mask = np.zeros_like(wall_mask, dtype=bool)\n    for r, c in wall_comp:\n        comp_mask[r, c] = True\n\n    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:\n        out = []\n        for rr, cc in neighbors8(r, c):\n            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:\n                out.append((rr, cc))\n        return out\n\n    endpoints: list[tuple[int, int]] = []\n    for r, c in wall_comp:\n        if len(comp_neighbors(r, c)) == 1:\n            endpoints.append((r, c))\n\n    assert endpoints, \"expected wall component to have endpoints (degree-1 pixels)\"\n\n    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:\n        n1 = comp_neighbors(*ep)[0]\n        d1 = (sgn(n1[0] - ep[0]), sgn(n1[1] - ep[1]))  # inward\n        d_use = d1\n        is_12 = False\n        n2s = [p for p in comp_neighbors(*n1) if p != ep]\n        if n2s:\n            n2 = n2s[0]\n            d2 = (sgn(n2[0] - n1[0]), sgn(n2[1] - n1[1]))\n            if (d1[0] == 0) ^ (d1[1] == 0):\n                if d2[0] != 0 and d2[1] != 0:\n                    d_use = d2\n                    is_12 = True\n        return (-d_use[0], -d_use[1]), is_12\n\n    out_info = [outward_dir(ep) for ep in endpoints]\n    out_dirs = [d for d, _ in out_info]\n    tip_12 = [f for _, f in out_info]\n\n    dr_sum = sum(d[0] for d in out_dirs)\n    dc_sum = sum(d[1] for d in out_dirs)\n    rad = (sgn(dr_sum), sgn(dc_sum))\n\n    barrier = comp_mask.copy()\n\n    def add_ray(start: tuple[int, int], d: tuple[int, int], skip: int = 0) -> None:\n        rr, cc = start\n        for _ in range(skip):\n            rr += d[0]\n            cc += d[1]\n        while True:\n            rr += d[0]\n            cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:\n        rr, cc = start\n        step = 0\n        while True:\n            step += 1\n            if step % 2 == 1:\n                rr += d[0]; cc += d[1]\n            else:\n                if rad[0] != 0:\n                    rr += d[0]\n                else:\n                    cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):\n        if is_12:\n            add_ray_12(ep, d)\n        else:\n            add_ray(ep, d, skip=0)\n\n    passable = (~barrier) & ((g == bg) | (g == fill))\n    q = fill_pos[:]\n    seen = np.zeros_like(passable, dtype=bool)\n    for r, c in q:\n        if passable[r, c]:\n            seen[r, c] = True\n    while q:\n        r, c = q.pop()\n        for rr, cc in neighbors4(r, c):\n            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not