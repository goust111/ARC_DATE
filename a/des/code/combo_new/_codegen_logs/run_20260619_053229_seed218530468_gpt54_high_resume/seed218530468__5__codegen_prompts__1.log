{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np\nimport random\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed218530468/5/1.py')\nmod = SourceFileLoader('new_arc_task_dbg', str(p)).load_module()\n\nfor attempt in range(1000):\n    frame_count = random.choice(mod.FRAME_COUNT_CHOICES)\n    specs = mod._make_specs(frame_count)\n    if specs is None:\n        continue\n    total_box_area = sum(spec['height'] * spec['width'] for spec in specs)\n    total_box_area += sum(spec['piece_mask'].shape[0] * spec['piece_mask'].shape[1] for spec in specs)\n    dims = None\n    for _ in range(20):\n        rows = random.randint(*mod.GRID_SIDE_RANGE)\n        cols = random.randint(*mod.GRID_SIDE_RANGE)\n        if rows * cols >= total_box_area * 2:\n            dims = (rows, cols)\n            break\n    if dims is None:\n        continue\n    rows, cols = dims\n    occupied = np.zeros((rows, cols), dtype=bool)\n    frame_positions = {}\n    ok = True\n    frame_order = sorted(range(frame_count), key=lambda i: specs[i]['height'] * specs[i]['width'], reverse=True)\n    for index in frame_order:\n        h = specs[index]['height']\n        w = specs[index]['width']\n        placed = False\n        for _ in range(mod.PLACEMENT_RETRIES):\n            top = random.randint(0, rows - h)\n            left = random.randint(0, cols - w)\n            if mod._can_place(occupied, top, left, h, w, pad=1):\n                frame_positions[index] = (top, left)\n                mod._mark_box(occupied, top, left, h, w)\n                placed = True\n                break\n        if not placed:\n            ok = False\n            break\n    if not ok:\n        continue\n    piece_positions = {}\n    piece_order = sorted(range(frame_count), key=lambda i: specs[i]['piece_mask'].size, reverse=True)\n    for index in piece_order:\n        h, w = specs[index]['piece_mask'].shape\n        placed = False\n        for _ in range(mod.PLACEMENT_RETRIES):\n            top = random.randint(0, rows - h)\n            left = random.randint(0, cols - w)\n            if mod._can_place(occupied, top, left, h, w, pad=1):\n                piece_positions[index] = (top, left)\n                mod._mark_box(occupied, top, left, h, w)\n                placed = True\n                break\n        if not placed:\n            ok = False\n            break\n    if not ok:\n        continue\n    inp = np.full((rows, cols), mod.BG_COLOR, dtype=int)\n    for index, spec in enumerate(specs):\n        top, left = frame_positions[index]\n        h = spec['height']\n        w = spec['width']\n        border = np.zeros((h, w), dtype=bool)\n        border[0, :] = True\n        border[-1, :] = True\n        border[:, 0] = True\n        border[:, -1] = True\n        frame_mask = border & ~spec['gap_full']\n        mod._draw_mask(inp, top, left, frame_mask, spec['frame_color'])\n    for index, spec in enumerate(specs):\n        top, left = piece_positions[index]\n        mod._draw_mask(inp, top, left, spec['piece_mask'], spec['piece_color'])\n    try:\n        mod.main(inp)\n    except Exception as e:\n        print('failed attempt', attempt, type(e).__name__, e)\n        print('grid shape', inp.shape)\n        for i, spec in enumerate(specs):\n            print('spec', i, 'frame_color', spec['frame_color'], 'turns', mod.ROTATION_BY_FRAME_COLOR[spec['frame_color']], 'frame', (spec['height'], spec['width']), 'gap')\n            print(spec['gap_crop'].astype(int))\n            print('piece')\n            print(spec['piece_mask'].astype(int))\n        print('input')\n        print(inp)\n        break\nelse:\n    print('no failure found')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
