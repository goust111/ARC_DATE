{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\n\ndef detect(a):\n    h,w=a.shape\n    dirs=[]\n    for c in range(1,w-2+1):\n        for pts in [[(0,c),(0,c+1),(1,c)],[(0,c),(0,c+1),(1,c+1)]]:\n            if all(a[r,cc]==0 for r,cc in pts):\n                dirs.append('up')\n    for c in range(1,w-2+1):\n        for pts in [[(h-1,c),(h-1,c+1),(h-2,c)],[(h-1,c),(h-1,c+1),(h-2,c+1)]]:\n            if all(a[r,cc]==0 for r,cc in pts):\n                dirs.append('down')\n    for r in range(1,h-2+1):\n        for pts in [[(r,0),(r+1,0),(r,1)],[(r,0),(r+1,0),(r+1,1)]]:\n            if all(a[rr,c]==0 for rr,c in pts):\n                dirs.append('left')\n        for pts in [[(r,w-1),(r+1,w-1),(r,w-2)],[(r,w-1),(r+1,w-1),(r+1,w-2)]]:\n            if all(a[rr,c]==0 for rr,c in pts):\n                dirs.append('right')\n    return dirs\n\npatterns={\n'A':['#...','#.##','###.'],\n'B':['#..#','#.##','###.'],\n'C':['#...','###.','####'],\n'D':['...#','#.##','###.'],\n'E':['.#..','###.','####'],\n}\nfor name,rows in patterns.items():\n    a=np.array([[1 if ch=='#' else 0 for ch in row] for row in rows],dtype=int)\n    print(name,a.sum(),detect(a))\n    for k in range(4):\n        b=np.rot90(a,k)\n        print(' rot',k,b.shape,b.sum(),detect(b))\n    print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
