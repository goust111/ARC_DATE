{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom collections import deque\n\ndef connected(cells,h,w):\n    pts=[(r,c) for r in range(h) for c in range(w) if cells[r][c]]\n    q=deque([pts[0]]); seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:\n            rr,cc=r+dr,c+dc\n            if 0<=rr<h and 0<=cc<w and cells[rr][cc] and (rr,cc) not in seen:\n                seen.add((rr,cc)); q.append((rr,cc))\n    return len(seen)==len(pts)\n\ndef tight(c,h,w):\n    return any(c[0][x] for x in range(w)) and any(c[h-1][x] for x in range(w)) and any(c[y][0] for y in range(h)) and any(c[y][w-1] for y in range(h))\n\ndef up_notches(c):\n    h=len(c); w=len(c[0]); out=[]\n    for x in range(1,w-2+1):\n        for pts in [[(0,x),(0,x+1),(1,x)],[(0,x),(0,x+1),(1,x+1)]]:\n            if all(not c[r][cc] for r,cc in pts):\n                out.append(tuple(pts))\n    return out\n\nfor h,w in [(3,4),(3,5),(4,4)]:\n    print('size',h,w)\n    res=[]\n    for mask in range(1<<(h*w)):\n        area=mask.bit_count()\n        if not (5<=area<=8):\n            continue\n        c=[[bool(mask & (1<<(r*w+cc))) for cc in range(w)] for r in range(h)]\n        if not tight(c,h,w) or not connected(c,h,w):\n            continue\n        uns=up_notches(c)\n        # no down/left/right notches by symmetry omitted for now; just unique up notch and exactly area holes small\n        if len(uns)\"'!=1:\n            continue\n        bg=sum(not c[r][cc] for r in range(h) for cc in range(w))\n        if bg>5:\n            continue\n        res.append((bg,area,c))\n    res.sort(key=lambda t:(t[0],-t[1]))\n    for bg,area,c in res[:25]:\n        print('\"'bg',bg,'area',area)\n        for row in c:\n            print(''.join('#' if x else '.' for x in row))\n        print()\n    print('count',len(res))\n    print('---')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
