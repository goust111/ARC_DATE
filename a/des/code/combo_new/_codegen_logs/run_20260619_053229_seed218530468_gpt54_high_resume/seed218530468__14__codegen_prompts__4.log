{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom itertools import product\nfrom collections import deque\n\ndef connected(cells,h,w):\n    pts=[(r,c) for r in range(h) for c in range(w) if cells[r][c]]\n    if not pts: return False\n    q=deque([pts[0]])\n    seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:\n            rr,cc=r+dr,c+dc\n            if 0<=rr<h and 0<=cc<w and cells[rr][cc] and (rr,cc) not in seen:\n                seen.add((rr,cc)); q.append((rr,cc))\n    return len(seen)==len(pts)\n\ndef notch_dirs(c):\n    h=len(c); w=len(c[0])\n    dirs=[]\n    # up/down side notches not touching left/right corners\n    for x in range(w-1):\n        # up on top edge only\n        if 0<x and x+1<w-1:\n            pats=[[(0,x),(0,x+1),(1,x)],[(0,x),(0,x+1),(1,x+1)]]\n            for pts in pats:\n                if all(not c[r][cc] for r,cc in pts):\n                    dirs.append(('up',tuple(pts)))\n        if 0<x and x+1<w-1:\n            pats=[[(h-1,x),(h-1,x+1),(h-2,x)],[(h-1,x),(h-1,x+1),(h-2,x+1)]]\n            for pts in pats:\n                if all(not c[r][cc] for r,cc in pts):\n                    dirs.append(('down',tuple(pts)))\n    for y in range(h-1):\n        if 0<y and y+1<h-1:\n            pats=[[(y,0),(y+1,0),(y,1)],[(y,0),(y+1,0),(y+1,1)]]\n            for pts in pats:\n                if all(not c[r][cc] for r,cc in pts):\n                    dirs.append(('left',tuple(pts)))\n            pats=[[(y,w-1),(y+1,w-1),(y,w-2)],[(y,w-1),(y+1,w-1),(y+1,w-2)]]\n            for pts in pats:\n                if all(not c[r][cc] for r,cc in pts):\n                    dirs.append(('right',tuple(pts)))\n    return dirs\n\nfor h,w in [(3,4),(4,3),(4,4),(3,5),(5,3)]:\n    found=[]\n    for mask in range(1<<(h*w)):\n        area=mask.bit_count()\n        if not (4<=area<=8):\n            continue\n        c=[[bool(mask & (1<<(r*w+cc))) for cc in range(w)] for r in range(h)]\n        if not connected(c,h,w):\n            continue\n        dirs=notch_dirs(c)\n        if len(dirs)==1:\n            d,_=dirs[0]\n            found.append((area,d,c))\n    print('size',h,w,'found',len(found))\n    for area,d,c in found[:10]:\n        print('area',area,d)\n        for row in c:\n            print(''.join('#' if x else '.' for x in row))\n        print()\n    print('---')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
