{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom collections import deque\nimport numpy as np\n\ndef connected(a):\n    h,w=a.shape\n    pts=[(r,c) for r in range(h) for c in range(w) if a[r,c]]\n    if not pts: return False\n    q=deque([pts[0]]); seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:\n            rr,cc=r+dr,c+dc\n            if 0<=rr<h and 0<=cc<w and a[rr,cc] and (rr,cc) not in seen:\n                seen.add((rr,cc)); q.append((rr,cc))\n    return len(seen)==len(pts)\n\ndef tight(a):\n    h,w=a.shape\n    return a[0].any() and a[h-1].any() and a[:,0].any() and a[:,w-1].any()\n\ndef detect(a):\n    h,w=a.shape; dirs=[]\n    for c in range(1,w-2+1):\n        for pts in [[(0,c),(0,c+1),(1,c)],[(0,c),(0,c+1),(1,c+1)]]:\n            if all(a[r,cc]==0 for r,cc in pts): dirs.append('up')\n        for pts in [[(h-1,c),(h-1,c+1),(h-2,c)],[(h-1,c),(h-1,c+1),(h-2,c+1)]]:\n            if all(a[r,cc]==0 for r,cc in pts): dirs.append('down')\n    for r in range(1,h-2+1):\n        for pts in [[(r,0),(r+1,0),(r,1)],[(r,0),(r+1,0),(r+1,1)]]:\n            if all(a[rr,c]==0 for rr,c in pts): dirs.append('left')\n        for pts in [[(r,w-1),(r+1,w-1),(r,w-2)],[(r,w-1),(r+1,w-1),(r+1,w-2)]]:\n            if all(a[rr,c]==0 for rr,c in pts): dirs.append('right')\n    return dirs\n\ngood=[]\nfor h,w in [(3,4),(4,3),(3,5),(5,3),(4,4)]:\n    for mask in range(1<<(h*w)):\n        area=mask.bit_count()\n        if not (5<=area<=8):\n            continue\n        a=np.array([(mask>>i)&1 for i in range(h*w)],dtype=int).reshape(h,w)\n        if not tight(a) or not connected(a):\n            continue\n        ok=True\n        expect=['up','left','down','right']\n        for k,dirn in enumerate(expect):\n            ds=detect(np.rot90(a,k))\n            if ds\"'!=[dirn]:\n                ok=False; break\n        if ok:\n            good.append(a)\nprint('\"'count',len(good))\n# dedupe by rotations maybe just print first 20\nseen=set(); out=[]\nfor a in good:\n    key='\\\\n'.join(''.join('#' if x else '.' for x in row) for row in a)\n    if key in seen: continue\n    seen.add(key); out.append(a)\nfor a in out[:30]:\n    print('area',a.sum(),'shape',a.shape)\n    print('\\\\n'.join(''.join('#' if x else '.' for x in row) for row in a))\n    print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
