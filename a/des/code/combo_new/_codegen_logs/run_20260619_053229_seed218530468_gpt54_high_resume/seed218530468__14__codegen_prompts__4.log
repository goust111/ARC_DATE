{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\n\ndef build(h,w,variant='left'):\n    a=np.ones((h,w),dtype=int)\n    if variant=='left':\n        a[0,0]=a[0,1]=a[1,0]=0\n    else:\n        a[0,w-2]=a[0,w-1]=a[1,w-1]=0\n    return a\n\ndef detect(a):\n    dirs=[]\n    for r in range(a.shape[0]-1):\n        for c in range(a.shape[1]-1):\n            win=a[r:r+2,c:c+2]\n            if win.sum()\"'!=1:\n                continue\n            if win[0].sum()==0:\n                dirs.append('\"'up')\n            elif win[1].sum()==0:\n                dirs.append('down')\n            elif win[:,0].sum()==0:\n                dirs.append('left')\n            elif win[:,1].sum()==0:\n                dirs.append('right')\n    return dirs\n\nfor h,w in [(2,3),(2,4),(2,5),(3,3)]:\n    for var in ['left','right']:\n        a=build(h,w,var)\n        print((h,w,var),a.sum(),detect(a),sep='\\\\n')\n        for k,dirn in [(0,'up'),(1,'left'),(2,'down'),(3,'right')]:\n            b=np.rot90(a,k)\n            print('rot',k,dirn,b.shape,b.sum(),detect(b))\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
