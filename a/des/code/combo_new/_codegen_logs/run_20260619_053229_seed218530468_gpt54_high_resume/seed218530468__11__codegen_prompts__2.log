 the configured area/hole bounds.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:152:    \"\"\"Return the visible grid bbox and matching sprite slice for a possibly clipped sprite.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:167:    \"\"\"Choose non-overlapping object origins; returns placement tuples or None on retry exhaustion.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:196:    \"\"\"Render the paired output and return the generated input with halo-fill cells removed.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py:260:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/14b8e18c.py:39:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/14b8e18c.py:40:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/14b8e18c.py:57:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/14b8e18c.py:96:    \"\"\"Return the 8 corner-adjacent cells outside a square at (r0,c0) with side `sz`.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/14b8e18c.py:107:    \"\"\"Return a boolean mask with True on the border cells of a square.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/14b8e18c.py:118:    \"\"\"Draw a square frame (or filled 2x2) onto the grid and update tracking masks.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/14b8e18c.py:133:    \"\"\"Return (height, width) for a distractor of the given type.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/14b8e18c.py:222:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py:8:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py:11:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py:24:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py:25:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py:39:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py:141:    \"\"\"Random-walk a sequence of 2*N area instructions that stays in the left canvas.\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py:144:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py:167:    \"\"\"Paint divider, gray start, and all 2*N tiled glyphs into the input grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py:190:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/22806e14.py:22:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/22806e14.py:23:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/22806e14.py:37:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/22806e14.py:129:    \"\"\"Paste separated squares; return placements or None if placement fails.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/22806e14.py:149:    \"\"\"Return marker top-lefts with the requested center-in-bbox relation.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/22806e14.py:174:    \"\"\"Apply the solver's target transform to the generated input grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/22806e14.py:187:    \"\"\"Try one complete sample, returning None when constraints cannot be met.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/22806e14.py:226:def generate_input():\n/home/lixinyu/snap/new/ARC_code/train/f1bcbc2c.py:39:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/f1bcbc2c.py:40:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/f1bcbc2c.py:55:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/f1bcbc2c.py:146:    \"\"\"Randomly split total into count bounded positive steps.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/f1bcbc2c.py:294:    \"\"\"Render orange walls and verify they induce exactly the sampled channel.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/f1bcbc2c.py:320:    \"\"\"Return turn blockers and straight pass-through blocker locations.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/f1bcbc2c.py:346:    \"\"\"Accept only grids whose solver output paints a top-connected channel.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/f1bcbc2c.py:369:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/320afe60.py:40:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/320afe60.py:41:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/320afe60.py:56:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/320afe60.py:297:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/ad173014.py:96:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/ad173014.py:97:    \"\"\"Recolor each framed interior mask with the color from the next red frame clockwise around the blue connector cycle.\n/home/lixinyu/snap/new/ARC_code/train/ad173014.py:111:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad173014.py:168:    \"\"\"Generate an 8-connected mask for frame interior with fill 30-56%.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad173014.py:203:    \"\"\"Return an inclusive straight segment between row- or column-aligned cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad173014.py:246:    \"\"\"Find an L-shaped path (0-2 turns) from start to end avoiding occupied cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad173014.py:278:    \"\"\"Pick an attachment point on the given side of a frame border.\n/home/lixinyu/snap/new/ARC_code/train/ad173014.py:317:    \"\"\"Determine which side of a frame is closest to a target point.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad173014.py:358:    \"\"\"Place non-overlapping frame boxes in clockwise angular order.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad173014.py:395:    \"\"\"Return frame indexes sorted by angle around their shared centroid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad173014.py:432:    \"\"\"Draw frame borders and colored interior masks; return the occupied cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad173014.py:456:    \"\"\"Connect adjacent clockwise frames with bounded blue paths.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad173014.py:522:def generate_input():\n","exit_code":0,"s