{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nfrom collections import defaultdict\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed1583749884/2/1.py')\nmod = SourceFileLoader('new_arc_task_branchcheck', str(p)).load_module()\n\ndef count_branches(grid):\n    labels, comps = mod._label_components(grid, 0)\n    pairs = mod._build_gap_pairs(labels, grid == 0)\n    degree = defaultdict(int)\n    equal = 0\n    unequal = 0\n    for (a, b), info in pairs.items():\n        degree[a] += 1\n        degree[b] += 1\n        if comps[a]['area'] == comps[b]['area']:\n            equal += 1\n        else:\n            unequal += 1\n    isolated = sum(1 for comp in comps if degree[comp['id']] == 0)\n    return equal, unequal, isolated\n\nstats = {'equal_cases':0,'isolated_cases':0,'both':0}\nfor _ in range(100):\n    g = mod.generate_input()\n    equal, unequal, isolated = count_branches(g)\n    if equal:\n        stats['equal_cases'] += 1\n    if isolated:\n        stats['isolated_cases'] += 1\n    if equal and isolated:\n        stats['both'] += 1\n    assert unequal >= 1\nprint(stats)\nPY\nrm -rf /home/lixinyu/snap/a/des/code/combo_new/seed1583749884/2/__pycache__\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
