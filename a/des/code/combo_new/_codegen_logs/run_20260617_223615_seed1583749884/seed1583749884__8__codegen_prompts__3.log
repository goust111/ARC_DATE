{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/aa62e3f4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace the outlined object with the outside contour of that outline in the marker color.\n\n    Input structure:\n    - A dominant background surrounds one 8-connected foreground outline.\n    - The outline is the unique largest foreground color.\n    - One or more smaller interior colors are inside the outline; the marker color\n      is the unique smallest non-outline color.\n\n    Rule:\n    - Erase all original foreground pixels to background.\n    - Paint every background pixel that is 4-adjacent to the outline with the\n      marker color.\n    - Keep the grid shape unchanged.\n\n    Key insight: The colored interior marker supplies the paint color, while the\n    largest outline supplies only the contour whose outside edge is traced.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    counts = Counter(map(int, g.flatten()))\n    foreground_colors = [color for color in counts if color != bg]\n    assert len(foreground_colors) >= 2, \"expected an outline color and a marker color\"\n\n    frame_count = max(counts[color] for color in foreground_colors)\n    frame_color = _unique_color_with_count(counts, foreground_colors, frame_count)\n    assert len(components_mask(g == frame_color, connectivity=8)) == 1, \"outline must be 8-connected\"\n\n    marker_candidates = [color for color in foreground_colors if color != frame_color]\n    marker_count = min(counts[color] for color in marker_candidates)\n    marker_color = _unique_color_with_count(counts, marker_candidates, marker_count)\n\n    out = np.full_like(g, bg)\n    contour: set[tuple[int, int]] = set()\n    for r, c in np.argwhere(g == frame_color):\n        for nr, nc in neighbors4(int(r), int(c)):\n            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] == bg:\n                contour.add((int(nr), int(nc)))\n    assert contour, \"expected outline to touch background contour cells\"\n\n    for r, c in contour:\n        out[r, c] = marker_color\n    return out\n\n# --------------- generator (att2) ---------------\n\nGRID_MIN, GRID_MAX = 5, 16\nN_COLORS = 10\n\nSHAPE_MIN_HEIGHT, SHAPE_MAX_HEIGHT = 5, 7\nSHAPE_MIN_WIDTH, SHAPE_MAX_WIDTH = 3, 5\nSTART_WIDTH_MIN, START_WIDTH_MAX = 1, 2\nMAX_LOCAL_WIDTH = 5\n\nMARKER_MIN_CELLS, MARKER_MAX_CELLS = 1, 3\n\nGEN_ATTEMPTS = 300\n\nEDGE_TOUCH_TOP_BOTTOM = \"TB\"\nCORNER_EDGE_PAIRS = [\"TL\", \"TR\", \"BL\", \"BR\"]\nZERO_DELTA_SHIFTS = [-1, 0, 0, 0, 1]\n\n\ndef _gen_grow_parts(total, n):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/c7f57c3e.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swap every sprite to the opposite prototype while preserving scale and position.\n\n    Input structure:\n    - bg = most common color. Two distinct small sprite patterns (prototypes) appear at various scales.\n    - Each sprite instance is a scaled copy of one of the two prototypes, placed on the grid.\n\n    Rule:\n    - Identify the two prototype patterns from the smallest-area sprites.\n    - For each sprite, determine which prototype it matches and its integer scale factor.\n    - Replace it with the other prototype at the same scale, aligned by an internal anchor region (color-1 pixels).\n\n    Key insight: Every sprite toggles to the alternate prototype; the anchor sub-region inside each sprite pins the alignment so swapped sprites land in the correct position regardless of scale.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    comps = components_mask(g != bg, connectivity=8)\n    assert len(comps) >= 2, \"grid must contain at least 2 sprite components\"\n\n    # Extract sprite records.\n    sprites = []\n    for pts in comps:\n        r0, c0, r1, c1 = bbox_coords(pts)\n        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        sprites.append({\"pts\": pts, \"bbox\": (r0, c0, r1, c1), \"arr\": arr})\n\n    # Determine two base prototypes from the smallest bbox area sprites.\n    areas = [int((s[\"bbox\"][2] - s[\"bbox\"][0] + 1) * (s[\"bbox\"][3] - s[\"bbox\"][1] + 1)) for s in sprites]\n    min_area = min(areas)\n    base = [s for s, a in zip(sprites, areas, strict=False) if a == min_area]\n    uniq: dict[tuple[int, ...], np.ndarray] = {}\n    for s in base:\n        key = tuple(s[\"arr\"].ravel().tolist())\n        if key not in uniq:\n            uniq[key] = s[\"arr\"]\n    assert len(uniq) == 2, \"smallest-area sprites must yield exactly 2 distinct prototype patterns\"\n\n    proto_keys = list(uniq.keys())[:2]\n    protos = [uniq[proto_keys[0]], uniq[proto_keys[1]]]\n\n    anc0 = _pick_anchor_bbox(protos[0], bg)\n    anc1 = _pick_anchor_bbox(protos[1], bg)\n    a0r0, a0c0, a0r1, a0c1 = anc0\n    base_anc_h = a0r1 - a0r0 + 1\n    base_anc_w = a0c1 - a0c0 + 1\n\n    out = g.copy()\n\n    for s in sprites:\n        r0, c0, r1, c1 = s[\"bbox\"]\n        arr = s[\"arr\"]\n        anc = _pick_anchor_bbox(arr, bg)\n        ar0, ac0, ar1, ac1 = anc\n        inst_anc_h = ar1 - ar0 + 1\n        inst_anc_w = ac1 - ac0 + 1\n        # infer integer scale\n        scale_h = max(1, inst_anc_h // max(1, base_anc_h))\n        scale_w = max(1, inst_anc_w // max(1, base_anc_w))\n        scale = int(max(scale_h, scale_w))\n\n        # score which prototype matches this sprite when aligned by core bbox\n        best_idx = 0\n        best_score = -1\n        for idx, p in enumerate(protos):\n            sp = _scale_nn(p, scale)\n            panc = _pick_anchor_bbox(p, bg)\n            pr0, pc0, pr1, pc1 = panc\n            pr0 *= scale\n            pc0 *= scale\n            # align anchor top-left to instance anchor top-left (global coords)\n            top = (r0 + ar0) - pr0\n            left = (c0 + ac0) - pc0\n\n            # overlap score: count matching non-bg pixels where prototype expects non-bg\n            score = 0\n            ph, pw = sp.shape\n            rr0 = max(0, top)\n            cc0 = max(0, left)\n            rr1 = min(h, top + ph)\n            cc1 = min(w, left + pw)\n            if rr0 >= rr1 or cc0 >= cc1:\n                continue\n            sub_g = g[rr0:rr1, cc0:cc1]\n            sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]\n            m = sub_p != bg\n            if np.any(m):\n                score = int(np.sum(sub_g[m] == sub_p[m]))\n            if score > best_score:\n                best_score = score\n                best_idx = idx\n\n        repl_idx = 1 - best_idx\n\n        # Clear current sprite pixels.\n        for rr, cc in s[\"pts\"]:\n            out[rr, cc] = bg\n\n        # Place replacement.\n        p = protos[repl_idx]\n        sp = _scale_nn(p, scale)\n        panc = _pick_anchor_bbox(p, bg)\n        pr0, pc0, pr1, pc1 = panc\n        pr0 *= scale\n        pc0 *= scale\n        top = (r0 + ar0) - pr0\n        left = (c0 + ac0) - pc0\n\n        ph, pw = sp.shape\n        rr0 = max(0, top)\n        cc0 = max(0, left)\n        rr1 = min(h, top + ph)\n        cc1 = min(w, left + pw)\n        sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]\n        m = sub_p != bg\n        out_slice = out[rr0:rr1, cc0:cc1]\n        out_slice[m] = sub_p[m]\n        out[rr0:rr1, cc0:cc1] = out_slice\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- CFG: canvas ---\nGRID_SIZE_MIN = 18                  # square grid lower bound\nGRID_SIZE_MAX = 28                  # square grid upper bound\nGRID_MARGIN_FOR_SPRITES = 6         # min_n = max_sprite_dim + this\n\n# --- CFG: prototypes ---\nPROTO_SHAPES = [(4, 3), (3, 4), (4, 4)]  # (h, w) choices for label grid\nBG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9] # bg color pool (excludes 1)\nCOLOR_SHARE_PROB = 0.65             # prob that proto_B shares a color with proto_A\n\n# --- CFG: row-mask weights (anchor role vs variable role) ---\n#   each entry: (mask_type, weight)  where mask_type in {\"center\", \"outer\", \"full\"}\nANCHOR_ROW_WEIGHTS = [(\"center\", 0.45), (\"outer\", 0.35), (\"full\", 0.20)]\nVARIABLE_ROW_WEIGHTS = [(\"center\", 0.68), (\"full\", 0.32)]\nOUTER_FIXUP_PROB = 0.7             # when fixing no-edge row, prob of using outer vs full\n\n# --- CFG: sprite instances ---\nSPRITE_COUNTS = [3, 4]             # number of sprite instances per grid\nBIG_SCALES = [2, 3]                # scale factor for the one large sprite\n\n# --- CFG: p