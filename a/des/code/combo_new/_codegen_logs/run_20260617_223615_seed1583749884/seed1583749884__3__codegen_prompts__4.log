{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/6165ea8f.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords, colors_present, find_components, get_bg, paste, random_free_location\nimport random\n\n\ndef _tight_mask(mask: np.ndarray) -> np.ndarray:\n    coords = np.argwhere(mask)\n    assert coords.size, \"expected a nonempty mask\"\n    r0, c0, r1, c1 = bbox_coords(coords)\n    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)\n\n\ndef _mask_key(mask: np.ndarray) -> tuple[str, ...]:\n    return tuple(\"\".join(\"1\" if cell else \"0\" for cell in row) for row in mask)\n\n\ndef _shape_signature(mask: np.ndarray) -> tuple[str, ...]:\n    base = _tight_mask(mask)\n    variants = []\n    for k in range(4):\n        rotated = np.rot90(base, k)\n        variants.append(_mask_key(_tight_mask(rotated)))\n        variants.append(_mask_key(_tight_mask(np.fliplr(rotated))))\n    return min(variants)\n\n\ndef _legend_order(g: np.ndarray, bg: int) -> list[int]:\n    labels: list[tuple[int, int]] = []\n    W = g.shape[1]\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, min_area=1):\n        if int(comp[\"area\"]) != 1:\n            continue\n        r, c = map(int, comp[\"coords\"][0])\n        if c == W - 1:\n            labels.append((r, int(comp[\"color\"])))\n\n    labels.sort()\n    assert labels, \"expected a right-edge color legend\"\n    assert [r for r, _color in labels] == list(range(len(labels))), \"legend must start at the top edge\"\n\n    order = [color for _r, color in labels]\n    assert len(order) == len(set(order)), \"legend colors must be unique\"\n    assert set(order) == set(colors_present(g, exclude={bg})), \"legend must list every foreground color\"\n    return order\n\n\ndef _main_object_mask(g: np.ndarray, bg: int, color: int) -> np.ndarray:\n    comps = find_components(\n        g,\n        bg=bg,\n        connectivity=4,\n        monochromatic=True,\n        colors=[color],\n        min_area=1,\n    )\n    main = [comp for comp in comps if int(comp[\"area\"]) > 1]\n    label = [\n        comp\n        for comp in comps\n        if int(comp[\"area\"]) == 1 and int(comp[\"coords\"][0][1]) == g.shape[1] - 1\n    ]\n    assert len(main) == 1, \"expected exactly one main object for each legend color\"\n    assert len(label) == 1, \"expected exactly one right-edge singleton label for each legend color\"\n    assert len(comps) == 2, \"each legend color should appear only as one object and one label\"\n\n    r0, c0, r1, c1 = main[0][\"bbox\"]\n    return g[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(color)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Build a color-labeled shape-equivalence table from the objects listed on the right edge.\n\n    Input structure:\n    - The background contains one main 4-connected object for each foreground color.\n    - The rightmost column has one singleton pixel of each foreground color, listed top-to-bottom.\n    - Those singleton pixels define the row and column order of the output table.\n\n    Rule:\n    - Normalize each main object to its tight mask and compare masks up to rotation or reflection.\n    - Draw 2x2 color labels across the top and down the left, separated by one background row/column.\n    - For each off-diagonal table cell, paint a 2x2 red block when the two labeled objects have the same shape under rotation/reflection, otherwise paint a 2x2 grey block.\n    - Leave diagonal cells and all separators as background.\n\n    Key insight:\n    - Object positions and original orientations are distractors; the relation is dihedral shape equivalence, while the right-edge legend fixes the table order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    order = _legend_order(g, bg)\n    signatures = {color: _shape_signature(_main_object_mask(g, bg, color)) for color in order}\n\n    n = len(order)\n    out = np.full((3 * n + 2, 3 * n + 2), int(bg), dtype=int)\n\n    for i, color in enumerate(order):\n        band = 3 + 3 * i\n        out[0:2, band : band + 2] = int(color)\n        out[band : band + 2, 0:2] = int(color)\n\n    for i, row_color in enumerate(order):\n        for j, col_color in enumerate(order):\n            if i == j:\n                continue\n            cell_color = Color.RED if signatures[row_color] == signatures[col_color] else Color.GREY\n            r = 3 + 3 * i\n            c = 3 + 3 * j\n            out[r : r + 2, c : c + 2] = int(cell_color)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and object bounds.\nGEN_OBJECT_COUNT_RANGE, GEN_GRID_ROW_RANGE, GEN_GRID_COL_RANGE = (4, 7), (20, 25), (20, 23)\nGEN_OBJECT_AREA_RANGE, GEN_OBJECT_BBOX_RANGE, GEN_OBJECT_MAX_EXTRA_CELLS = (5, 13), (2, 7), 4\n# Shape-class sampling.\nGEN_CLASS_OPTIONS, GEN_MAX_CLASS_SIZE, GEN_UNIQUE_MASK_RETRIES = (2, 3), 3, 80\nGEN_DIHEDRAL_FLIP_PROB = 0.5\n# Output table layout and colors.\nGEN_OBJECT_COLORS, GEN_TABLE_BLOCK, GEN_TABLE_STEP = [1, 3, 4, 6, 7, 8, 9], 2, 3\nGEN_SAME_SHAPE_COLOR, GEN_DIFFERENT_SHAPE_COLOR = int(Color.RED), int(Color.GREY)\n# Input placement and retry limits.\nGEN_RESERVED_RIGHT_COLS, GEN_ATTEMPTS = 2, 300\nGEN_PLACEMENT_BORDER, GEN_PLACEMENT_PADDING, GEN_PLACEMENT_CONNECTIVITY = 1, 2, 4\nGEN_NEIGHBORS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _gen_tight_mask(mask: np.ndarray) -> np.ndarray:\n    coords = np.argwhere(mask)\n    r0, c0, r1, c1 = bbox_coords(coords)\n    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)\n\n\ndef _gen_mask_key(mask: np.ndarray) -> tuple[str, ...]:\n    return tuple(\"\".join(\"1\" if cell else \"0\" for cell in row) for row in mask)\n\n\ndef _gen_shape_signature(mask: np.ndarray) -> tuple[str, ...]:\n    base = _gen_tight_mask(mask)\n    variants = []\n    for k in range(4):\n        rotated = np.rot90(base, k)\n        variants.append(_gen_mask_key(_gen_tight_mask(rotated)))\n        variants.append(_gen_mask_key(_gen_tight_mask(np.fliplr(rotated))))\n    return min(variants)\n\n\ndef _has_hole(mask: np.ndarray) -> bool:\n    bg = ~mask.astype(bool)\n    if not bool(bg.any()):\n        return False\n\n    H, W = bg.shape\n    seen = np.zeros_like(bg, dtype=bool)\n    stack: list[tuple[int, int]] = []\n    for r in range(H):\n        for c in (0, W - 1):\n            if bg[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                stack.append((r, c))\n    for c in range(W):\n        for r in (0, H - 1):\n            if bg[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                stack.append((r, c))\n\n    while stack:\n        r, c = stack.pop()\n        for dr, dc in GEN_NEIGHBORS_4:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and bg[nr, nc] and not seen[nr, nc]:\n                seen[nr, nc] = True\n                stack.append((nr, nc))\n    return bool((bg & ~seen).any())\n\n\ndef _random_corner_path(h: int, w: int) -> np.ndarray:\n    starts = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]\n    sr, sc = random.choice(starts)\n    er, ec = h - 1 - sr, w - 1 - sc\n    moves = [(1 if er > sr else -1, 0)] * (h - 1)\n    moves += [(0, 1 if ec > sc else -1)] * (w - 1)\n    random.shuffle(moves)\n\n    mask = np.zeros((h, w), dtype=bool)\n    r, c = sr, sc\n    mask[r, c] = True\n    for dr, dc in moves:\n        r += dr\n        c += dc\n        mask[r, c] = True\n    return mask\n\n\ndef _growth_candidates(mask: np.ndarray) -> list[tuple[int, int]]:\n    h, w = mask.shape\n    choices = []\n    for r in range(h):\n        for c in range(w):\n            if mask[r, c]:\n                continue\n            touches = sum(\n                0 <= r + dr < h and 0 <= c + dc < w and mask[r + dr, c + dc]\n                for dr, dc in GEN_NEIGHBORS_4\n            )\n            if touches != 1:\n                continue\n            trial = mask.copy()\n            trial[r, c] = True\n            if not _has_hole(trial):\n                choices.append((r, c))\n    return choices\n\n\ndef _random_mask() -> np.ndarray | None:\n    area = random.randint(*GEN_OBJECT_AREA_RANGE)\n    pairs = [\n        (h, w)\n        for h in range(GEN_OBJECT_BBOX_RANGE[0], GEN_OBJECT_BBOX_RANGE[1] + 1)\n        for w in range(GEN_OBJECT_BBOX_RANGE[0], GEN_OBJECT_BBOX_RANGE[1] + 1)\n        if h + w - 1 <= area <= h * w\n        and area - (h + w - 1) <= GEN_OBJECT_MAX_EXTRA_CELLS\n    ]\n    h, w = random.choice(pairs)\n    mask = _random_corner_path(h, w)\n\n    while int(mask.sum()) < area:\n        choices = _growth_candidates(mask)\n        if not choices:\n            return None\n        r, c = random.choice(choices)\n        mask[r, c] = True\n    return mask\n\n\ndef _class_sizes(n: int) -> list[int]:\n    k = random.choice([k for k in GEN_CLASS_OPTIONS if k <= n <= GEN_MAX_CLASS_SIZE * k])\n    sizes = [1] * k\n    for _ in range(n - k):\n        open_slots = [i for i, size in enumerate(sizes) if size < GEN_MAX_CLASS_SIZE]\n        sizes[random.choice(open_slots)] += 1\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _unique_canonical_masks(class_count: int) -> list[np.ndarray] | None:\n    canonical_masks: list[np.ndarray] = []\n    signatures: set[tuple[str, ...]] = set()\n    for _ in range(class_count):\n        for _ in range(GEN_UNIQUE_MASK_RETRIES):\n            mask = _random_mask()\n            if mask is None:\n                continue\n            sig = _gen_shape_signature(mask)\n            if sig in signatures:\n                continue\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/afe3afe9.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg, paste\nimport random\n\n\ndef _marker_side(g: np.ndarray, bg: int) -> tuple[str, int]:\n    sides: list[tuple[str, int]] = []\n    for color in set(map(int, g.ravel())) - {bg}:\n        if np.all(g[0, :] == color):\n            sides.append((\"top\", color))\n        if np.all(g[:, -1] == color):\n            sides.append((\"right\", color))\n        if np.all(g[-1, :] == color):\n            sides.append((\"bottom\", color))\n        if np.all(g[:, 0] == color):\n            sides.append((\"left\", color))\n\n    assert len(sides) == 1, sides\n    return sides[0]\n\n\ndef _symbolic_grid(g: np.ndarray) -> tuple[np.ndarray, str, int]:\n    bg = get_bg(g)\n    side, marker = _marker_side(g, bg)\n    assert marker == 1, marker\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n\n    objects: list[tuple[int, int, int]] = []\n    for component in components:\n        color = component[\"color\"]\n        if color == marker:\n            continue\n\n        b = component[\"bbox\"]\n        assert component[\"area\"] == 8, component\n        assert bbox_h(b) == 3 and bbox_w(b) == 3, component\n\n        r0, c0, r1, c1 = b\n        patch = g[r0 : r1 + 1, c0 : c1 + 1]\n        expected = np.full((3, 3), color, dtype=int)\n        expected[1, 1] = bg\n        assert np.array_equal(patch, expected), patch\n        objects.append((r0, c0, color))\n\n    assert objects\n    rows = sorted({r for r, _c, _color in objects})\n    cols = sorted({c for _r, c, _color in objects})\n    symbolic = np.full((len(rows), len(cols)), bg, dtype=int)\n    row_index = {r: i for i, r in enumerate(rows)}\n    col_index = {c: i for i, c in enumerate(cols)}\n\n    for r, c, color in objects:\n        rr = row_index[r]\n        cc = col_index[c]\n        assert symbolic[rr, cc] == bg\n        symbolic[rr, cc] = color\n\n    if side in (\"top\", \"bottom\"):\n        dominant_cols = range(3, 6) if side == \"top\" else range(0, 3)\n        dominant_values = [\n            int(symbolic[r, c])\n            for r in range(symbolic.shape[0])\n            for c in dominant_cols\n            if int(symbolic[r, c]) != bg\n        ]\n    else:\n        dominant_rows = range(0, 3) if side == \"left\" else range(3, 6)\n        dominant_values = [\n            int(symbolic[r, c])\n            for r in dominant_rows\n            for c in range(symbolic.shape[1])\n            if int(symbolic[r, c]) != bg\n        ]\n    assert dominant_values and set(dominant_values) == {8}, dominant_values\n\n    return symbolic, side, bg\n\n\ndef _compact(symbolic: np.ndarray, side: str, bg: int) -> np.ndarray:\n    out = np.full_like(symbolic, bg)\n\n    if side == \"top\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, symbolic.shape[1] - len(values) :] = values\n    elif side == \"right\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[symbolic.shape[0] - len(values) :, c] = values\n    elif side == \"bottom\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, : len(values)] = values\n    elif side == \"left\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[: len(values), c] = values\n    else:\n        raise AssertionError(side)\n\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Convert each hollow 3x3 symbol to one pixel and slide the pixels clockwise from the marked edge.\n\n    Input structure\n    - The grid has a background, one full-edge marker line, and monochrome hollow 3x3 foreground symbols.\n    - The symbols lie on a coarse row/column lattice; fully empty lattice rows or columns are absent from the output.\n\n    Rule\n    - Replace each hollow 3x3 symbol with one pixel of its color in the corresponding coarse-grid cell.\n    - The marker edge gives the compaction direction by clockwise border travel: top -> right, right -> down, bottom -> left, left -> up.\n    - Preserve the order of non-background pixels while sliding them as far as possible in that direction.\n\n    Key insight\n    - The large picture is a scaled symbolic grid, and the blue edge marker acts as a gravity direction rather than as output content.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    symbolic, side, bg = _symbolic_grid(g)\n    return _compact(symbolic, side, bg)\n\n# --------------- generator (att2) ---------------\n\n# Canvas and colors.\nGEN_BG = 0\nGEN_GRID_SHAPE = (30, 30)\nGEN_MARKER_COLOR = 1\nGEN_DOMINANT_COLOR = 8\nGEN_ACCENT_COLORS = [2, 3, 4, 5, 6, 7, 9]\n\n# Symbolic lattice layout.\nGEN_SIDES = [\"top\", \"right\", \"bottom\", \"left\"]\nGEN_SYMBOLIC_HW = (7, 6)\nGEN_SYMBOLIC_VW = (6, 7)\nGEN_DOMINANT_COUNT_RANGE = (13, 17)\nGEN_ACCENT_COUNT_RANGE = (6, 8)\nGEN_SPLIT_INDEX = 3\n\n# Physical lattice coordinates.\nGEN_GAP_SIX_POSITIONS = [1, 5, 9, 17, 21, 25]\nGEN_SEVEN_FROM_MARKER = [2, 6, 10, 14, 18, 22, 26]\nGEN_SEVEN_FROM_OTHER = [1, 5, 9, 13, 17, 21, 25]\nGEN_SYMBOL_PATCH_SIZE = 3\n\n# Generation retries.\nGEN_MAX_ATTEMPTS = 300\n\ndef _gen_compact(symbolic, side, bg):\n    out = np.full_like(symbolic, bg)\n\n    if side == \"top\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, symbolic.shape[1] - len(values) :] = values\n    elif side == \"right\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[symbolic.shape[0] - len(values) :, c] = values\n    elif side == \"bottom\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, : len(values)] = values\n    elif side == \"left\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[: len(values), c] = values\n    else:\n        raise AssertionError(side)\n\n    return out\n\n\ndef _gen_covering_cells(rows, cols, count):\n    rows = list(rows)\n    cols = list(cols)\n    cells = set()\n\n    shuffled_rows = rows[:]\n    random.shuffle(shuffled_rows)\n    for r in shuffled_rows:\n        cells.add((r, random.choice(cols)))\n\n    for c in cols:\n        if all(cc != c for _rr, cc in cells):\n            cells.add((random.choice(rows), c))\n\n    remaining = [(r, c) for r in rows for c in cols if (r, c) not in cells]\n    random.shuffle(remaining)\n    cells.update(remaining[: count - len(cells)])\n    return cells\n\n\ndef _gen_fill(symbolic, rows, cols, count, color):\n    for r, c in _gen_covering_cells(rows, cols, count):\n        symbolic[r, c] = color\n\n\ndef _gen_symbolic(side, bg):\n    color_a, color_b = random.sample(GEN_ACCENT_COLORS, 2)\n\n    if side in (\"top\", \"bottom\"):\n        symbolic = np.full(GEN_SYMBOLIC_HW, bg, dtype=int)\n        dominant_cols = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1]) if side == \"top\" else range(0, GEN_SPLIT_INDEX)\n        accent_cols = range(0, GEN_SPLIT_INDEX) if side == \"top\" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1])\n        _gen_fill(symbolic, range(GEN_SYMBOLIC_HW[0]), dominant_cols, random.randint(*GEN_DOMINANT_COUNT_RANGE), GEN_DOMINANT_COLOR)\n        _gen_fill(symbolic, range(0, GEN_SPLIT_INDEX), accent_cols, random.randint(*GEN_ACCENT_COUNT_RANGE), color_a)\n        _gen_fill(symbolic, range(GEN_SPLIT_INDEX + 1, GEN_SYMBOLIC_HW[0]), accent_cols, random.randint(*GEN_ACCENT_COUNT_RANGE), color_b)\n    else:\n        symbolic = np.full(GEN_SYMBOLIC_VW, bg, dtype=int)\n        dominant_rows = range(0, GEN_SPLIT_INDEX) if side == \"left\" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0])\n        accent_rows = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0]) if side == \"left\" else range(0, GEN_SPLIT_INDEX)\n        _gen_fill(symbolic, dominant_rows, range(GEN_SYMBOLIC_VW[1]), random.randint(*GEN_DOMINANT_COUNT_RANGE), GEN_DOMINANT_COLOR)\n        _gen_fill(symbolic, accent_rows, range(0, GEN_SPLIT_INDEX), random.randint(*GEN_ACCENT_COUNT_RANGE), color_a)\n        _gen_fill(symbolic, accent_rows, range(GEN_SPLIT_INDEX + 1, GEN_SYMBOLIC_VW[1]), random.randint(*GEN_ACCENT_COUNT_RANGE), color_b)\n\n    return symbolic\n\n\ndef _gen_lattice_positions(side):\n    if side == \"top\":\n        return GEN_SEVEN_FROM_MARKER, GEN_GAP_SIX_POSITIONS\n    if side == \"bottom\":\n        return GEN_SEVEN_FROM_OTHER, GEN_GAP_SIX_POSITIONS\n    if side == \"left\":\n        return GEN_GAP_SIX_POSITIONS, GEN_SEVEN_FROM_MARKER\n    return GEN_GAP_SIX_POSITIONS, GEN_SEVEN_FROM_OTHER\n\n\ndef _gen_place_marker(grid, side):\n    if side == \"top\":\n        grid[0, :] = GEN_MARKER_COLOR\n    elif side == \"right\":\n        grid[:, -1] = GEN_MARKER_COLOR\n    elif side == \"bottom\":\n        grid[-1, :] = GEN_MARKER_COLOR\n    else:\n        grid[:, 0] = GEN_MARKER_COLOR\n\n\ndef _gen_hollow_patch(color, bg):\n    patch = np.full((GEN_SYMBOL_PATCH_SIZE, GEN_SYMBOL_PATCH_SIZE), color, dtype=int)\n    patch[GEN_SYMBOL_PATCH_SIZE // 2, GEN_SYMBOL_PATCH_SIZE // 2] = bg\n    return patch\n\n\ndef _gen_expand(symbolic, side, bg):\n    grid = np.full(GEN_GRID_SHAPE, bg, dtype=int)\n    _gen_place_marker(grid, side)\n\n    row_positions, col_positions = _gen_lattice_positions(side)\n    for r in range(symbolic.shape[0]):\n        for c in range(symbolic.shape[1]):\n            color = int(symbolic[r, c])\n            if color == bg:\n                continue\n            paste(grid, _gen_hollow_patch(color, bg), row_positions[r], col_positions[c])\n    return grid\n\n","exit_code":0,"status":"completed"}}
