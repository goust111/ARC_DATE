{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/cbebaa4b.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble scattered jigsaw sprites around a central yellow anchor by pairing red connector pixels.\n\n    Input structure:\n    - bg = black (0). Several colored sprites scattered on the grid.\n    - One anchor sprite contains a 3×3 yellow (4) block.\n    - Each sprite has red (2) connector pixels along its edges.\n\n    Rule:\n    - The anchor stays in place; remaining sprites attach one at a time.\n    - Each sprite is translated so that one of its red pixels overlaps an unpaired red pixel on the growing assembly.\n    - Every red connector must pair with exactly one other, forming a complete joined structure.\n\n    Key insight: Red pixels act as jigsaw pegs — each must match exactly one counterpart, and the assembly order is determined by which unpaired connectors remain.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = 0\n\n    pieces = _extract_pieces(g, bg)\n    assert pieces, \"input must have at least one colored piece\"\n\n    # Anchor is the unique piece containing the 3x3 yellow (color 4) block.\n    anchors = [p for p in pieces if np.any(p[\"arr\"] == 4)]\n    assert len(anchors) == 1, \"input must have exactly one yellow (4) anchor piece\"\n    anchor = anchors[0]\n    rest = [p for p in pieces if p is not anchor]\n\n    canvas = np.full((h, w), bg, dtype=int)\n    ar0, ac0, _, _ = anchor[\"bbox\"]\n    placed = _try_place(canvas, anchor[\"arr\"], ar0, ac0, bg)\n    assert placed is not None, \"anchor piece must fit on canvas at its original position\"\n\n    total_ports = int(sum(len(p[\"reds\"]) for p in pieces))\n    assert total_ports % 2 == 0, \"total red connector ports must be even for complete pairing\"\n    target_unique_red = total_ports // 2\n\n    # Track how many original red pixels map to each assembled red coordinate.\n    red_counts: dict[tuple[int, int], int] = {}\n    for rr, cc in anchor[\"reds\"]:\n        red_counts[(ar0 + rr, ac0 + cc)] = red_counts.get((ar0 + rr, ac0 + cc), 0) + 1\n\n    # Backtracking assembly by pairing up red connector pixels.\n    solutions: list[np.ndarray] = []\n\n    def dfs(cur: np.ndarray, remaining: list[dict], rc: dict[tuple[int, int], int]) -> None:\n        if len(solutions) >= 2:\n            return\n\n        if not remaining:\n            if len(rc) == target_unique_red and all(v == 2 for v in rc.values()):\n                solutions.append(cur)\n            return\n\n        if len(rc) > target_unique_red:\n            return\n\n        # Unpaired reds are exactly those with count==1; always pair one of them next.\n        unpaired = [k for k, v in rc.items() if v == 1]\n        if not unpaired:\n            return\n\n        rc1 = {k for k, v in rc.items() if v == 1}\n\n        # Pick the most constrained unpaired red coordinate: fewest ways to cover it.\n        best_moves = None\n        for t in unpaired:\n            moves = []\n            tr, tc = t\n            for idx, p in enumerate(remaining):\n                ph, pw = p[\"shape\"]\n                for pr, pc in p[\"reds\"]:\n                    top = tr - pr\n                    left = tc - pc\n                    if top < 0 or left < 0 or top + ph > h or left + pw > w:\n                        continue\n                    # quick red-count feasibility\n                    bad = False\n                    overlap = 0\n                    for rr, cc in p[\"reds\"]:\n                        gr, gc = top + rr, left + cc\n                        prev = rc.get((gr, gc), 0)\n                        if prev >= 2:\n                            bad = True\n                            break\n                        if (gr, gc) in rc1:\n                            overlap += 1\n                    if bad:\n                        continue\n                    # must overlap at least the target (guaranteed), but keep for scoring\n                    moves.append((idx, top, left, overlap))\n            if not moves:\n                return\n            if best_moves is None or len(moves) < len(best_moves):\n                best_moves = moves\n                if len(best_moves) == 1:\n                    break\n\n        assert best_moves is not None, \"there must be at least one feasible connector move\"\n\n        # Deduplicate moves by (piece, top, left) keeping max overlap score.\n        dedup: dict[tuple[int, int, int], int] = {}\n        for idx, top, left, ov in best_moves:\n            k = (idx, top, left)\n            dedup[k] = max(dedup.get(k, 0), ov)\n        moves2 = [(idx, top, left, ov) for (idx, top, left), ov in dedup.items()]\n        moves2.sort(key=lambda x: (-x[3], -remaining[x[0]][\"area\"], x[1], x[2], x[0]))\n\n        for idx, top, left, _ov in moves2:\n            p = remaining[idx]\n            next_remaining = remaining[:idx] + remaining[idx + 1 :]\n\n            next_rc = dict(rc)\n            for rr, cc in p[\"reds\"]:\n                gr, gc = top + rr, left + cc\n                next_rc[(gr, gc)] = next_rc.get((gr, gc), 0) + 1\n\n            nxt = _try_place(cur, p[\"arr\"], top, left, bg)\n            if nxt is None:\n                continue\n            dfs(nxt, next_remaining, next_rc)\n            if len(solutions) >= 2:\n                return\n\n    dfs(placed, rest, red_counts)\n    assert len(solutions) == 1, \"jigsaw assembly must have exactly one valid solution\"\n    return solutions[0]\n\n# --------------- generator (o5x) ---------------\n\n# ── Tunable configuration ──────────────────────────────────────────────\n# Canvas\nGRID_H_RANGE = (22, 26)               # output grid height bounds\nGRID_W_RANGE = (22, 26)               # output grid width bounds\nMAX_ASSEMBLY_DIM = 24                  # assembled jigsaw must fit inside this\n\n# Pieces\nPIECE_COUNT_RANGE = (4, 6)            # non-anchor sprite count\nPIECE_H_RANGE = (4, 7)               # piece bbox height bounds\nPIECE_W_RANGE = (4, 8)               # piece bbox width bounds\nPIECE_DIM_CANDIDATES = 12            # random (h,w) trials per piece placement\nPIECE_COLORS = [1, 3, 5, 6, 7, 8, 9] # available non-red, non-yellow colors\nPIECE_CAP = 2                         # max connections per piece node\nBAR_SKIP_PROB = 0.35                  # probability of dropping one decorative bar\n\n# Anchor\nANCHOR_BLOCK_CHOICES = [(3, 3), (4, 5)]  # yellow block (h, w) options\nANCHOR_CAP_CHOICES = [1, 2]              # max connections for anchor node\n\n# Scatter\nSCATTER_PADDING = 2                   # Chebyshev gap between scattered sprites\n\n# Generation\nGEN_RETRY_LIMIT = 300                 # max attempts before raising RuntimeError\n\n# ── Side geometry lookups ──────────────────────────────────────────────\nSIDES = (\"top\", \"right\", \"bottom\", \"left\")\nOPPOSITE = {\"top\": \"bottom\", \"bottom\": \"top\", \"left\": \"right\", \"right\": \"left\"}\nINWARD = {\"top\": (1, 0), \"bottom\": (-1, 0), \"left\": (0, 1), \"right\": (0, -1)}\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/7666fa5d.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the parallelogram-shaped region between parallel anti-diagonal line segments with red.\n\n    Input structure:\n    - bg = most common color.\n    - One non-bg color forms short diagonal segments, each lying on a single anti-diagonal (r+c = const).\n    - Segments come in parallel pairs bounding a region to be filled.\n\n    Rule:\n    - For each main-diagonal axis (r−c = const), collect anti-diagonal segments whose span covers that axis.\n    - Sort those segments by their anti-diagonal index (r+c).\n    - Fill all bg cells lying strictly between consecutive segment pairs along that axis with red (color 2).\n\n    Key insight: The two diagonal directions decouple — segments sit on anti-diagonals, and filling sweeps along main diagonals between them, forming parallelogram regions.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    bg = _bg_color(g)\n    non_bg = [c for c in sorted(set(map(int, g.ravel()))) if c != bg]\n    assert non_bg, \"grid must contain at least one non-background color\"\n\n    # This task uses one diagonal-line color and fills with 2.\n    line = max(non_bg, key=lambda c: int(np.sum(g == c)))\n    fill = 2\n\n    comps = _cc8(g == line)\n\n    # Each diagonal segment is on a constant anti-diagonal sum k=r+c,\n    # and spans a continuous range of main-diagonal indices b=r-c.\n    segs: list[tuple[int, int, int]] = []\n    for pts in comps:\n        ks = {r + c for r, c in pts}\n        if len(ks) != 1:\n            continue\n        k = int(next(iter(ks)))\n        bs = [r - c for r, c in pts]\n        segs.append((k, int(min(bs)), int(max(bs))))\n\n    out = g.copy()\n\n    # Scan each main diagonal b=r-c. For every b, find the active diagonal segments\n    # (those whose b-range covers b), sort them by k=r+c, then fill between adjacent\n    # segments for cells on this b with k strictly between.\n    for b in range(-(w - 1), h):\n        active = [s for s in segs if s[1] <= b <= s[2]]\n        if len(active) < 2:\n            continue\n        active.sort(key=lambda t: t[0])\n        ks = [t[0] for t in active]\n\n        r_min = max(0, b)\n        r_max = min(h - 1, (w - 1) + b)\n        for k_left, k_right in zip(ks, ks[1:]):\n            for r in range(r_min, r_max + 1):\n                c = r - b\n                k = r + c\n                if k_left < k < k_right and out[r, c] == bg:\n                    out[r, c] = fill\n\n    return out\n\n# --------------- generator (Claude attempt 1) ---------------\n\n\"\"\"Generator for ARC-AGI-2 task 7666fa5d (parallelogram fill between anti-diagonal segments).\"\"\"\n\n# -- Grid & color constants --\nH = W = 16\nBG = 8\nFILL = 2\nLINE_COLORS = [1, 3, 4, 5, 6, 7, 9]  # not 2 (fill), not 8 (bg)\n\n# -- Anti-diagonal (k = r+c) layout --\nK_LO, K_HI = 4, 26                    # allowed k range\nGAP_VALUES = (4, 6, 8)                 # even gaps between consecutive k-values\nGAP_TARGET_SPANS = (14, 16)            # valid total k-span for 4-k layouts\nNUM_KS_CHOICES = [4, 5]                # number of anti-diagonals to use\nNUM_KS_WEIGHTS = [1, 1]                # sampling weights for num_ks\n\n# -- Segment geometry --\nSEG_LEN_MIN, SEG_LEN_MAX = 2, 9       # segment length in cells\nOVERLAP_MIN_B = 2                      # min b-overlap between consecutive segments\n\n# -- Segment splitting --\nSPLIT_PROB = 0.4                       # probability of splitting one segment\nSPLIT_MIN_LEN = 4                      # min segment length (cells) to be splittable\nSPLIT_B_GAP = 4                        # min b-gap to break 8-connectivity\nSPLIT_PIECE2_LEN_MIN = 2              # second piece length range\nSPLIT_PIECE2_LEN_MAX = 6\n\n# -- Retry budgets --\nSEG_RETRY = 40                         # retries per segment placement\nSPLIT_RETRY = 10                       # retries for segment splitting\nGEN_RETRY = 300                        # outer generate_input retries\n\n# -- Validation --\nMIN_FILL_CELLS = 3                     # min fill cells in output\n\n\n","exit_code":0,"status":"completed"}}
