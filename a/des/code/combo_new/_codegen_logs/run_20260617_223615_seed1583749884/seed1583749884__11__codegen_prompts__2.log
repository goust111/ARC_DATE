{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py | sed '\"'$d'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swing an irregular line segment around a nearby obstacle sprite, preserving its pixel count.\n\n    Input structure:\n    - bg, bar color (straight lines perpendicular to the grid edge, one end on the border), segment color (irregular stroke attached to bar's inner endpoint), obstacle color (sprite near the bar terminal).\n\n    Rule:\n    - Each bar is perpendicular to the edge it touches; its inner (terminal) endpoint has an attached irregular segment.\n    - The segment detaches and re-routes: it travels from the terminal toward the nearest obstacle, hugs the obstacle's boundary, then exits at a 45° diagonal.\n    - Total painted pixels equal the original segment length.\n\n    Key insight: The segment behaves like a rope swung around the obstacle — attach at the nearest point, trace the skin, exit diagonally, conserving length.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    colors = sorted(set(int(v) for v in np.unique(g)) - {bg})\n\n    out = g.copy()\n\n    def bar_candidates():\n        # Yield (bar_color, bar_component, terminal_endpoint).\n        for col in colors:\n            for comp in _components(g, col, conn8=False):\n                if len(comp) < 2 or not _is_straight_line(comp):\n                    continue\n                e0, e1 = _bar_endpoints(comp)\n                touch0 = _touches_border(e0, h, w)\n                touch1 = _touches_border(e1, h, w)\n                if touch0 == touch1:\n                    continue  # require exactly one endpoint on border\n                # Orientation must be perpendicular to the edge it touches.\n                rs = [r for r, _ in comp]\n                cs = [c for _, c in comp]\n                vertical = len(set(cs)) == 1\n                border_ep = e0 if touch0 else e1\n                if vertical:\n                    if border_ep[0] not in (0, h - 1):\n                        continue\n                else:\n                    if border_ep[1] not in (0, w - 1):\n                        continue\n                terminal_ep = e1 if touch0 else e0\n                # Must have an attached non-bg neighbor at terminal.\n                tr, tc = terminal_ep\n                if not any(\n                    0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) != bg and int(g[nr, nc]) != col\n                    for nr, nc in neighbors4(tr, tc)\n                ):\n                    continue\n                yield col, comp, terminal_ep\n\n    # Process all valid bars; compute moves based on the original grid.\n    moves = []  # list of (seg_comp_pts, seg_color, new_pts)\n    for bar_col, bar_comp, terminal in sorted(list(bar_candidates()), key=lambda x: (-len(x[1]), x[0], x[2])):\n        # Segment neighbor candidates at terminal.\n        neigh = []\n        for nr, nc in neighbors4(terminal[0], terminal[1]):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg and v != bar_col:\n                    neigh.append((v, (nr, nc)))\n        assert neigh, f\"bar terminal {terminal} must have a non-bg/non-bar neighbor\"\n\n        # Choose a segment that behaves like a 1-cell-thick stroke attached at an endpoint.\n        best_seg = None  # (L, comp_size, seg_col, seg_start, seg_comp)\n        for cand_col, cand_start in neigh:\n            for comp in _components(g, cand_col, conn8=True):\n                if cand_start in comp:\n                    if len(comp) < 2:\n                        break\n                    deg = _segment_degrees(comp)\n                    if deg.get(cand_start, 0) != 1:\n                        break\n                    path = _segment_main_path(comp, cand_start)\n                    L = len(path)\n                    key = (L, len(comp), cand_col, cand_start[0], cand_start[1])\n                    if best_seg is None or key > best_seg[0]:\n                        best_seg = (key, cand_col, cand_start, comp)\n                    break\n        assert best_seg is not None, f\"no valid segment for bar at {terminal}\"\n        (L, _, _, _, _), seg_col, seg_start, seg_comp = best_seg\n\n        # Nearest obstacle component (any other non-bg color) to the terminal.\n        obstacle_candidates = [c for c in colors if c not in (bar_col, seg_col)]\n        assert obstacle_candidates, \"must have at least one obstacle color distinct from bar and segment\"\n\n        best = None  # (dist, min_r, min_c)\n        obstacle_set = None\n        for col in obstacle_candidates:\n            for comp in _components(g, col, conn8=True):\n                d = min(abs(r - terminal[0]) + abs(c - terminal[1]) for r, c in comp)\n                mr = min(r for r, _ in comp)\n                mc = min(c for _, c in comp)\n                key = (d, mr, mc)\n                if best is None or key < best:\n                    best = key\n                    obstacle_set = set(comp)\n        assert obstacle_set is not None, \"must find at least one obstacle component\"\n\n        off_r = seg_start[0] - terminal[0]\n        off_c = seg_start[1] - terminal[1]\n\n        # Path from terminal to obstacle (prefer monotone manhattan decrease).\n        walkable = (g == bg) | (g == seg_col)\n        walkable[terminal] = True\n        # Choose an obstacle pixel so that the translated endpoint (p_near + offset) lies OUTSIDE the obstacle,\n        # i.e. the segment connects to the obstacle \"skin\" rather than landing inside the obstacle and wasting length.\n        def pick_p_near() -> tuple[int, int]:\n            good = []\n            for pr, pc in obstacle_set:\n                er, ec = pr + off_r, pc + off_c\n                if not (0 <= er < h and 0 <= ec < w):\n                    continue\n                if (er, ec) in obstacle_set:\n                    continue\n                if int(g[er, ec]) not in (bg, seg_col):\n                    continue\n                d = abs(pr - terminal[0]) + abs(pc - terminal[1])\n                good.append((d, pr, pc))\n            assert good, \"no obstacle pixel has a valid translated endpoint outside obstacle\"\n            _, pr, pc = min(good)\n            return (pr, pc)\n\n        p_near = pick_p_near()\n        walkable[p_near] = True\n        path_t_to_obs = _greedy_manhattan_path(terminal, p_near, walkable) or _bfs_path(terminal, p_near, walkable)\n        assert path_t_to_obs is not None, f\"no path from terminal {terminal} to obstacle {p_near}\"\n        shifted = [(r + off_r, c + off_c) for r, c in path_t_to_obs]\n        assert all(0 <= r < h and 0 <= c < w for r, c in shifted), \\\n            \"shifted segment path must stay within grid\"\n        assert shifted and shifted[0] == seg_start, \\\n            \"shifted path must start at seg_start\"\n        entry = shifted[-1]\n\n        # Obstacle-adjacent skin.\n        skin = set()\n        for r, c in obstacle_set:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in obstacle_set:\n                    skin.add((nr, nc))\n\n        # Pick exit as the farthest walkable skin cell from the terminal (ties resolved by projecting away).\n        # Use obstacle centroid direction as an 'away' vector.\n        cr = sum(r for r, _ in obstacle_set) / len(obstacle_set)\n        cc = sum(c for _, c in obstacle_set) / len(obstacle_set)\n        away = (cr - terminal[0], cc - terminal[1])\n\n        def skin_ok(p):\n            r, c = p\n            return int(g[r, c]) == bg or int(g[r, c]) == seg_col\n\n        skin_candidates = [p for p in skin if skin_ok(p)] + [entry]\n        def exit_key(p):\n            r, c = p\n            md = abs(r - terminal[0]) + abs(c - terminal[1])\n            dot = (r - terminal[0]) * away[0] + (c - terminal[1]) * away[1]\n            return (md, dot, -r, -c)\n\n        exit_cell = max(skin_candidates, key=exit_key)\n\n        # BFS along skin (8-neigh) from entry to exit.\n        skin_walkable = np.zeros((h, w), dtype=bool)\n        for r, c in skin:\n            if skin_ok((r, c)):\n                skin_walkable[r, c] = True\n        skin_walkable[entry] = True\n        skin_walkable[exit_cell] = True\n        boundary_path = _bfs_path_with_diag_filter(entry, exit_cell, skin_walkable) or [entry]\n\n        # Extension direction is the last step used to reach the exit on the skin path.\n        assert len(boundary_path) >= 2, \"boundary path must have at least 2 cells to derive extension direction\"\n        dr_ext = boundary_path[-1][0] - boundary_path[-2][0]\n        dc_ext = boundary_path[-1][1] - boundary_path[-2][1]\n\n        route = list(shifted)\n        if boundary_path and boundary_path[0] == entry:\n            route.extend(boundary_path[1:])\n\n        cur = route[-1]\n        while len(route) < L:\n            nr, nc = cur[0] + dr_ext, cur[1] + dc_ext\n            if not (0 <= nr < h and 0 <= nc < w):\n                break\n            if int(g[nr, nc]) != bg and int(g[nr, nc]) != seg_col:\n                break\n            route.append((nr, nc))\n            cur = (nr, nc)\n\n        new_pts = route[:L]\n\n        # Assert: output segment must not overlap obstacle\n        assert not any(p in obstacle_set for p in new_pts), \"output segment passes through obstacle\"\n\n        # Assert: output segment has monotone wrapping shape (FL*F*FR* or FR*F*FL*)\n        rs_bar = [r for r, _ in bar_comp]\n        cs_bar = [c for _, c in bar_comp]\n        if len(set(cs_bar)) == 1:\n            fwd = (1, 0) if min(rs_bar) == 0 else (-1, 0)\n        else:\n            fwd = (0, 1) if min(cs_bar) == 0 else (0, -1)\n        step_classes = []\n        for j in range(len(new_pts) - 1):\n            dr = new_pts[j + 1][0] - new_pts[j][0]\n            dc = new_pts[j + 1][1] - new_pts[j][1]\n            fwd_comp = dr * fwd[0] + dc * fwd[1]\n            perp_comp = dr * fwd[1] + dc * (-fwd[0])\n            if abs(dr) + abs(dc) == 1:\n                step_classes.append('F' if fwd_comp > 0 else 'X')\n            elif fwd_comp > 0 and perp_comp > 0:\n                step_classes.append('FR')\n            elif fwd_comp > 0 and perp_comp < 0:\n                step_classes.append('FL')\n            else:\n                step_classes.append('X')\n        s = ''.join(step_classes)\n        import re\n        assert re.fullmatch(r'(FL)*(F)*(FR)*', s) or re.fullmatch(r'(FR)*(F)*(FL)*', s), \\\n            f\"output segment not monotone wrap: {' '.join(step_classes)}\"\n\n        # Assert: when approach diagonal exists (p1>=1), obstacle must be 4-adj to V apex inner side\n        first_step = step_classes[0] if step_classes else ''\n        if first_step in ('FL', 'FR'):\n            p1_end = 0\n            for j2, sc in enumerate(step_classes):\n                if sc == first_step:\n                    p1_end = j2 + 1\n                else:\n                    break\n            apex = new_pts[p1_end]\n            perp_dir = (seg_start[0] - terminal[0], seg_start[1] - terminal[1])\n            inner = (-perp_dir[0], -perp_dir[1])\n            apex_inner = (apex[0] + inner[0], apex[1] + inner[1])\n            assert apex_inner in obstacle_set, \\\n                f\"obstacle not tight at V apex: apex={apex}, inner={apex_inner}\"\n\n        moves.append((seg_comp, seg_col, new_pts))\n\n    # Clear segments first, then repaint.\n    for seg_comp, seg_col, _ in moves:\n        for r, c in seg_comp:\n            out[r, c] = bg\n\n    for _, seg_col, new_pts in moves:\n        for r, c in new_pts:\n            if int(out[r, c]) == bg:\n                out[r, c] = seg_col\n    return out\n\n# --------------- generator (attempt_2) ---------------\n\nfrom arc_utils import paint_coords\n\n# ── CFG: tunable generation parameters ──────────────────────────────────────\nGRID_SIZE_MIN, GRID_SIZE_MAX = 7, 27       # square grid side length\nBAR_LEN_MIN, BAR_LEN_MAX = 3, 7           # bar length (px)\nBAR_CLEARANCE = 4                           # n must exceed bar_len by this much\nSEG_LEN_MIN, SEG_LEN_MAX = 5, 9           # segment pixel count\nPHASE_MAX = 3                               # max length for p1 and p2 individually\nOBS_SIZE_MIN, OBS_SIZE_MAX = 1, 9          # obstacle sprite pixel count\nOBS_MD_MIN, OBS_MD_MAX = 2, 6             # obstacle manhattan distance from terminal\nINPUT_TURN_MIN, INPUT_TURN_MAX = 2, 5     # turns in the input irregular stroke\nDIAG_CONTINUE_PROB = 0.35                  # probability of continuing a diagonal run\nDIAG_START_PROB = 0.5                       # probability of starting/switching to diagonal\nMAX_RETRIES = 300                           # generate_input retry budget\nPLACEMENT_PAD = 1                           # padding around placed triples\n\nEDGE_DATA = {\n    \"top\": {\"fwd\": (1, 0), \"side\": (0, 1)},\n    \"bottom\": {\"fwd\": (-1, 0), \"side\": (0, -1)},\n    \"left\": {\"fwd\": (0, 1), \"side\": (-1, 0)},\n    \"right\": {\"fwd\": (0, -1), \"side\": (1, 0)},\n}\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/34cfa167.py | sed '\"'$d'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/34cfa167.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.\n\n    Input structure:\n    - The background is the dominant color.\n    - Two same-color solid rectangular anchors of the same size sit on opposite\n      diagonal corners, with the first anchor above-left of the second.\n    - The upper-left anchor has two one-cell-thick vertical control bars to its\n      right and two one-cell-thick horizontal control bars below it.\n\n    Rule:\n    - Copy the anchor rectangle into the two missing corners of the implied\n      larger rectangle.\n    - Repeat the right-side control bars horizontally between the left and right\n      anchors, using their spacing as the period, and draw the outer top and\n      bottom borders in the first right-control color.\n    - Repeat the below-side control bars vertically between the top and bottom\n      anchors, using the same period, and draw the outer left and right borders\n      in the first below-control color.\n\n    Key insight: The small control bars are the first two ticks of two periodic\n    frame patterns; the diagonal anchor supplies the opposite corner and the\n    missing two anchor copies.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    source, dest, right_controls, below_controls = _find_structure(g, bg)\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    dr0, dc0, dr1, dc1 = dest[\"bbox\"]\n    anchor_color = int(source[\"color\"])\n    assert int(dest[\"color\"]) == anchor_color, \"anchor colors must match\"\n    assert bbox_h(source[\"bbox\"]) == bbox_h(dest[\"bbox\"]), \"anchor heights must match\"\n    assert bbox_w(source[\"bbox\"]) == bbox_w(dest[\"bbox\"]), \"anchor widths must match\"\n    assert sr0 > 0 and sc0 > 0, \"upper-left anchor must have space for outer frame\"\n    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \"lower-right anchor must have space for outer frame\"\n\n    right_offsets = [int(comp[\"bbox\"][1] - sc1) for comp in right_controls]\n    below_offsets = [int(comp[\"bbox\"][0] - sr1) for comp in below_controls]\n    assert right_offsets == below_offsets and right_offsets[0] == 1, \"control offsets must match from the anchor edge\"\n    step = int(right_offsets[1] - right_offsets[0])\n    assert step > 0, \"control bars must be separated\"\n    period = 2 * step\n    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, \"right frame must close next to the destination anchor\"\n    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, \"below frame must close next to the destination anchor\"\n\n    right_colors = [int(comp[\"color\"]) for comp in right_controls]\n    below_colors = [int(comp[\"color\"]) for comp in below_controls]\n    out = g.copy()\n\n    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)\n    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)\n\n    first_c = int(sc1 + right_offsets[0])\n    last_c = int(dc0 - 1)\n    for c in range(first_c, last_c + 1):\n        offset = int(c - sc1)\n        if (offset - right_offsets[0]) % period == 0:\n            color = right_colors[0]\n        elif (offset - right_offsets[1]) % period == 0:\n            color = right_colors[1]\n        else:\n            continue\n        _paint_rect(out, bg, sr0, c, sr1, c, color)\n        _paint_rect(out, bg, dr0, c, dr1, c, color)\n\n    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])\n    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])\n\n    first_r = int(sr1 + below_offsets[0])\n    last_r = int(dr0 - 1)\n    left_c = int(sc0 - 1)\n    right_c = int(dc1 + 1)\n    for r in range(first_r, last_r + 1):\n        _paint(out, bg, r, left_c, below_colors[0])\n        _paint(out, bg, r, right_c, below_colors[0])\n\n        offset = int(r - sr1)\n        if (offset - below_offsets[0]) % period == 0:\n            _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])\n            _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])\n        elif (offset - below_offsets[1]) % period == 0:\n            _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])\n            _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color sampling.\nCOLOR_COUNT, NON_BG_COLOR_COUNT = 10, 4\n\n# Anchor/repetition geometry.\nANCHOR_SIZE_RANGE = (1, 5)\nREPEAT_COUNT_RANGE = (2, 5)\nCONTROL_OFFSETS = (1, 3)\nFRAME_PERIOD, DEST_ANCHOR_GAP, STRUCTURE_FIXED_PAD = 4, 2, 3\n\n# Canvas/margins.\nCANVAS_MIN_SIZE, CANVAS_MAX_SIZE = 16, 30\nMARGIN_CHOICES = range(4)\nMIN_TOTAL_MARGIN, SOURCE_OUTER_MARGIN = 1, 1\n\n# Retry.\nMAX_GENERATION_ATTEMPTS = 300\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py | sed '\"'$d'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\n","exit_code":0,"status":"completed"}}
