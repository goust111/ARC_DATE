{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/247ef758.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move colored sprites from the left strip into a framed area at marker-defined targets.\n\n    Input structure:\n    - bg background; rectangular frame on right with colored markers on its edges; sprites in a narrow left strip separated by a constant-color divider column.\n\n    Rule:\n    - For each color, target rows/cols are where both opposite frame edges share that color. Targets are the Cartesian product.\n    - Erase each sprite from the left and stamp it centered at every target. Higher sprites cover lower ones.\n\n    Key insight: One sprite replicates to a grid of row × column marker intersections.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # --- frame interior: largest bg component not touching boundary ---\n    inner_bbox = largest_enclosed_component_bbox(g == int(bg), connectivity=4)\n    assert not (inner_bbox is None)\n    ir0, ic0, ir1, ic1 = map(int, inner_bbox)\n    fr0, fc0, fr1, fc1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)\n\n    # --- divider columns (fixed) on the left side ---\n    divider_mask = np.zeros((H, W), dtype=bool)\n    for c in range(0, max(0, int(fc0))):\n        colv = g[:, int(c)]\n        non = colv[colv != int(bg)]\n        if int(len(non)) >= int(H - 1) and len(set(map(int, non))) == 1:\n            divider_mask[:, int(c)] = True\n\n    left_cols = (np.arange(W)[None, :] < int(fc0))\n\n    # --- sprites: per-color 8-connected components in left area (excluding divider) ---\n    sprites = []\n    for col in sorted(set(map(int, g.flatten())) - {int(bg)}):\n        mask = (g == int(col)) & left_cols & (~divider_mask)\n        if not bool(mask.any()):\n            continue\n        slab, sn = label_mask(mask, connectivity=8)\n        for sid in range(1, int(sn) + 1):\n            pts = np.argwhere(slab == int(sid))\n            r0, c0 = pts.min(axis=0)\n            r1, c1 = pts.max(axis=0)\n            r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n            m = slab[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(sid)\n            sprites.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"r1\": int(r1), \"c1\": int(c1), \"mask\": m})\n\n    move_colors = {int(s[\"color\"]) for s in sprites}\n\n    # --- marker-derived targets (restricted to colors that actually appear as sprites) ---\n    row_marks: dict[int, list[int]] = defaultdict(list)\n    col_marks: dict[int, list[int]] = defaultdict(list)\n    for r in range(int(ir0), int(ir1) + 1):\n        cl = int(g[int(r), int(fc0)])\n        cr = int(g[int(r), int(fc1)])\n        if cl == cr and cl != int(bg) and cl in move_colors:\n            row_marks[int(cl)].append(int(r))\n    for c in range(int(ic0), int(ic1) + 1):\n        ct = int(g[int(fr0), int(c)])\n        cb = int(g[int(fr1), int(c)])\n        if ct == cb and ct != int(bg) and ct in move_colors:\n            col_marks[int(ct)].append(int(c))\n\n    targets: dict[int, list[tuple[int, int]]] = {}\n    for col in set(row_marks.keys()) & set(col_marks.keys()):\n        pts = {(int(r), int(c)) for r in row_marks[int(col)] for c in col_marks[int(col)]}\n        targets[int(col)] = sorted(pts)\n\n    out = g.copy()\n    movers = [s for s in sprites if int(s[\"color\"]) in targets]\n\n    # Erase originals of moved sprites.\n    for s in movers:\n        r0, c0 = int(s[\"r0\"]), int(s[\"c0\"])\n        for rr, cc in np.argwhere(s[\"mask\"]):\n            out[int(r0) + int(rr), int(c0) + int(cc)] = int(bg)\n\n    # Bottom-to-top ordering: lower sprites first, upper sprites last (covering).\n    movers.sort(key=lambda s: (-((int(s[\"r0\"]) + int(s[\"r1\"])) / 2.0), int(s[\"c0\"])))\n\n    for s in movers:\n        col = int(s[\"color\"])\n        cr = (int(s[\"r0\"]) + int(s[\"r1\"])) // 2\n        cc = (int(s[\"c0\"]) + int(s[\"c1\"])) // 2\n        pix = [(int(s[\"r0\"]) + int(rr), int(s[\"c0\"]) + int(cc2)) for rr, cc2 in np.argwhere(s[\"mask\"])]\n\n        for tr, tc in targets[int(col)]:\n            dr = int(tr - cr)\n            dc = int(tc - cc)\n            for r, c in pix:\n                rr = int(r + dr)\n                cc3 = int(c + dc)\n                if int(ir0) <= rr <= int(ir1) and int(ic0) <= cc3 <= int(ic1):\n                    out[rr, cc3] = int(col)\n\n    return out\n\n\n# ---------------------------------------------------------------------------\n# generate_input\n# ---------------------------------------------------------------------------\nimport random\n\n\ndef _pick_spaced(candidates: list[int], n: int, min_spacing: int) -> list[int] | None:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n    Input structure\n    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n    Rule\n    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n    - Red bars that are not reached from a blue marker remain unchanged.\n    Key insight\n    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g))) - {bg}\n    assert colors <= {MARKER_COLOR, BODY_COLOR}\n    assert MARKER_COLOR in colors\n\n    bars = _vertical_bars(g, bg)\n    by_col = {bar[\"col\"]: bar for bar in bars}\n    assert len(by_col) == len(bars)\n\n    baselines = {bar[\"bottom\"] for bar in bars}\n    assert len(baselines) == 1\n    baseline = baselines.pop()\n    out = g.copy()\n    for bar in bars:\n        if bar[\"color\"] != MARKER_COLOR:\n            continue\n\n        group = [bar]\n        current = bar\n        while True:\n            next_col = current[\"col\"] + current[\"height\"]\n            next_bar = by_col.get(next_col)\n            if next_bar is None:\n                break\n            if next_bar[\"color\"] != BODY_COLOR:\n                break\n            group.append(next_bar)\n            current = next_bar\n\n        for item in group:\n            rows = item[\"coords\"][:, 0]\n            cols = item[\"coords\"][:, 1]\n            out[rows, cols] = bg\n\n        for item in group:\n            col = item[\"col\"]\n            height = item[\"height\"]\n            assert col + height <= g.shape[1]\n            out[baseline, col : col + height] = item[\"color\"]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nMIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n\n# Bar and chain structure.\nMIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\nMIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\nMIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n\n# Layout padding and retry budget.\nGAP_VALUES = (1, 2, 3)\nMAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n\n\ndef _chain_red_distributions(n_blue, n_red):\n","exit_code":0,"status":"completed"}}
