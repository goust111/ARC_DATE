olor) for color in np.unique(g) if int(color) not in {bg, separator}]\n  76:     assert len(sprite_colors) == 1, \"expected one sprite color\"\n  77:     sprite_color = sprite_colors[0]\n  78: \n  79:     source_tiles = []\n  80:     marked_origins = []\n  81:     for r0, r1 in row_spans:\n  82:         for c0, c1 in col_spans:\n  83:             tile = g[r0 : r1 + 1, c0 : c1 + 1]\n  84:             assert tile.shape == (tile_h, tile_w)\n  85:             has_sprite = np.any(tile == sprite_color)\n  86:             has_marker = np.any(tile == separator)\n  87:             if has_sprite:\n  88:                 assert not has_marker, \"source tile should contain only sprite and background\"\n  89:                 assert set(map(int, np.unique(tile))).issubset({bg, sprite_color})\n  90:                 source_tiles.append(tile.copy())\n  91:             elif has_marker:\n  92:                 assert set(map(int, np.unique(tile))).issubset({bg, separator})\n  93:                 marked_origins.append((r0, c0))\n  94:             else:\n  95:                 assert np.all(tile == bg), \"unmarked non-source tiles should be plain background\"\n  96: \n  97:     assert len(source_tiles) == 1, \"expected exactly one source sprite tile\"\n  98:     source_tile = source_tiles[0]\n  99: \n 100:     out = g.copy()\n 101:     for r0, c0 in marked_origins:\n 102:         out[r0 : r0 + tile_h, c0 : c0 + tile_w] = source_tile\n 103:     return out\n 104: \n 105: # --------------- generator (o5x) ---------------\n 106: \n 107: # Palette: separator, background, and sprite are distinct.\n 108: COLOR_POOL = range(10)\n 109: PALETTE_SIZE = 3\n 110: # Tile grid dimensions and odd square tile sizes.\n 111: TILE_ROWS_RANGE = (3, 4)\n 112: TILE_COLS_RANGE = (3, 4)\n 113: TILE_SIZE_CHOICES = [3, 5]\n 114: SEPARATOR_WIDTH = 1\n 115: # Sprite density and 4-connected component count by tile size.\n 116: SPRITE_PIXEL_RANGES = {3: (3, 4), 5: (8, 11)}\n 117: SPRITE_COMPONENT_CAPS = {3: 3, 5: 5}\n 118: NEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n 119: ORIENTATION_COUNT = 4\n 120: FLIP_PROBABILITY = 0.5\n 121: # Marker tiles and retry budget.\n 122: MARKER_COUNT_RANGE = (3, 5)\n 123: MAX_GENERATION_ATTEMPTS = 300\n 124: \n 125: \n 126: def _gen_neighbors4(r: int, c: int, size: int):\n 127:     for dr, dc in NEIGHBOR_OFFSETS_4:\n 128:         rr, cc = r + dr, c + dc\n 129:         if 0 <= rr < size and 0 <= cc < size:\n 130:             yield rr, cc\n 131: \n 132: \n 133: def _gen_partition(total: int, parts: int) -> list[int]:\n 134:     sizes = [1] * parts\n 135:     for _ in range(total - parts):\n 136:         sizes[random.randrange(parts)] += 1\n 137:     random.shuffle(sizes)\n 138:     return sizes\n 139: \n 140: \n 141: def _gen_separate_from_other(labels: np.ndarray, r: int, c: int, label: int) -> bool:\n 142:     size = int(labels.shape[0])\n 143:     for rr, cc in _gen_neighbors4(r, c, size):\n 144:         if labels[rr, cc] not in (0, label):\n 145:             return False\n 146:     return True\n 147: \n 148: \n 149: def _gen_sprite_tile(size: int, bg: int, sprite_color: int) -> np.ndarray | None:\n 150:     pixel_count = random.randint(*SPRITE_PIXEL_RANGES[size])\n 151:     component_count = random.randint(1, min(SPRITE_COMPONENT_CAPS[size], pixel_count))\n 152:     labels = np.zeros((size, size), dtype=int)\n 153:     for label, component_size in enumerate(_gen_partition(pixel_count, component_count), start=1):\n 154:         seed_candidates = [\n 155:             (r, c)\n 156:             for r in range(size)\n 157:             for c in range(size)\n 158:             if labels[r, c] == 0 and _gen_separate_from_other(labels, r, c, label)\n 159:         ]\n 160:         if not seed_candidates:\n 161:             return None\n 162: \n 163:         seed = random.choice(seed_candidates)\n 164:         labels[seed] = label\n 165:         cells = [seed]\n 166:         while len(cells) < component_size:\n 167:             growth = []\n 168:             for r, c in cells:\n 169:                 for rr, cc in _gen_neighbors4(r, c, size):\n 170:                     if labels[rr, cc] == 0 and _gen_separate_from_other(labels, rr, cc, label):\n 171:                         growth.append((rr, cc))\n 172:             if not growth:\n 173:                 return None\n 174:             cell = random.choice(growth)\n 175:             labels[cell] = label\n 176:             cells.append(cell)\n 177: \n 178:     tile = np.full((size, size), bg, dtype=int)\n 179:     tile[labels > 0] = sprite_color\n 180:     tile = np.rot90(tile, random.randrange(ORIENTATION_COUNT))\n 181:     if random.random() < FLIP_PROBABILITY:\n 182:         tile = np.fliplr(tile)\n 183:     if random.random() < FLIP_PROBABILITY:\n\n 244:     return inp\n 245: \n 246: \n 247: def generate_input() -> np.ndarray:\n 248:     for _ in range(MAX_GENERATION_ATTEMPTS):\n 249:         grid = _gen_attempt()\n 250:         if grid is not None:\n 251:             return grid\n 252:     raise RuntimeError(\"failed to generate a valid e734a0e8 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py =====\n 169:     return out\n 170: \n 171: \n 172: def main(grid: np.ndarray) -> np.ndarray:\n 173:     \"\"\"Predict the next panel in a framed sequence by continuing each scheduled colored interval.\n 174: \n 175:     Input structure\n 176:     - The grid is made from three or more equal panels in one row or one column.\n 177:     - The final input panel is the static target template; every earlier panel differs from it only by dynamic colors absent from the template.\n 178:     - Each dynamic color appears in a regular temporal schedule across the earlier panels.\n 179: \n 180:     Rule\n 181:     - Keep the final template panel as the output canvas.\n 182:     - For every dynamic color whose schedule reaches the next panel, compare its last two appearances.\n 183:     - Extrapolate each one-dimensional interval along the color's changing row or