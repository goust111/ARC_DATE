:     \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n 206:     g = np.full((5, 5), fill, dtype=int)\n 207:     g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n 208:     g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n 209:     rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n 210:     return np.rot90(g, rot[(dr, dc)])\n 211: \n 212: \n 213: def _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n 214:     \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n 215:     g = np.full((6, 7), fill, dtype=int)\n 216:     g[1, 3] = 1\n 217:     g[2, 1] = 1; g[2, 4] = 1\n 218:     g[3, 2] = 1; g[3, 5] = 2\n 219:     g[4, 3] = 2\n 220:     if (dr, dc) == (1, 1): return g\n 221:     if (dr, dc) == (-1, 1): return np.flipud(g)\n 222:     if (dr, dc) == (1, -1): return np.fliplr(g)\n 223:     if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n 224:     raise ValueError((dr, dc))\n 225: \n 226: \n 227: def _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n 228:     \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n 229:     if corner == 'TL': return 0, 0\n 230:     if corner == 'TR': return 0, w - pw\n 231:     if corner == 'BL': return h - ph, 0\n 232:     if corner == 'BR': return h - ph, w - pw\n 233:     raise ValueError(corner)\n 234: \n 235: \n 236: # ── Blob growing / topology ──────────────────────────────────────\n 237: \n 238: def _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n 239:                rng: random.Random) -> set[tuple[int, int]] | None:\n 240:     \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n 241:     h, w = canvas_mask.shape\n\n 601:     return input_grid\n 602: \n 603: \n 604: def generate_input() -> np.ndarray:\n 605:     rng = random.Random()\n 606:     for _ in range(GEN_RETRIES):\n 607:         try:\n 608:             g = _gen_attempt(rng)\n 609:         except Exception:\n 610:             continue\n 61