:     bg = int(counts.most_common(1)[0][0])\n  29:     sep = int(max((cnt, col) for col, cnt in counts.items() if col != bg)[1])\n  30: \n  31:     sep_cols = [c for c in range(W) if (g[:, c] == sep).sum() >= H // 2]\n  32:     sep_rows = [r for r in range(H) if (g[r, :] == sep).sum() >= W // 2]\n  33:     assert sep_cols and sep_rows\n  34: \n  35:     N = sep_cols[0]\n  36:     starts = [0] + [c + 1 for c in sep_cols]\n  37:     K = len(starts)\n  38: \n  39:     # Read K templates from the top band\n  40:     tcols = []\n  41:     tmasks = []\n  42:     for st in starts:\n  43:         sub = g[0:N, st:st + N]\n  44:         vals = {int(v) for v in sub.flat} - {bg, sep}\n  45:         assert len(vals) == 1\n  46:         col = vals.pop()\n  47:         tcols.append(col)\n  48:         tmasks.append(sub == col)\n  49:     assert len(set(tcols)) == K\n  50:     tcol_to_j = {col: j for j, col in enumerate(tcols)}\n  51: \n  52:     # Read palette colors from the bottom band\n  53:     pal_r0 = sep_rows[-1] + 1\n  54:     pcols = []\n  55:     for st in starts:\n  56:         sub = g[pal_r0:H, st:st + N]\n  57:         vals = {int(v) for v in sub.flat} - {bg, sep}\n  58:         assert len(vals) == 1\n  59:         pcols.append(vals.pop())\n  60: \n  61:     # Read markers from the middle band and build stamp placements\n  62:     mid_r0 = N + 1\n  63:     out = np.full((N * N, N * N), bg, dtype=int)\n  64:     slot_owner = {}\n  65: \n  66:     for st in starts:\n  67:         tile_color = None\n  68:         for lr in range(N):\n  69:             for lc in range(N):\n  70:                 v = int(g[mid_r0 + lr, st + lc])\n  71:                 if v == bg or v == sep:\n  72:                     continue\n  73:                 assert tile_color is None or v == tile_color, \"tile column must have uniform marker color\"\n  74:                 tile_color = v\n  75:                 j = tcol_to_j[v]\n  76:                 assert (lr, lc) not in slot_owner or slot_owner[(lr