array(grid, dtype=int)\n 117:     h, w = g.shape\n 118:     bg = get_bg(g)\n 119: \n 120:     mover = 4  # yellow in ARC\n 121:     dirs = _legend_directions(g, bg)\n 122:     assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n 123: \n 124:     passable = (g == bg) | (g == mover)\n 125:     out = g.copy()\n 126: \n 127:     # Find enclosed passable regions (not connected to the outer border).\n 128:     for pts in components_mask(passable, connectivity=4):\n 129:         if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n 130:             continue  # outside background\n 131: \n 132:         movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n 133:         if not movers:\n 134:             continue\n 135: \n 136:         # Determine this region's border color by counting adjacent wall colors.\n 137:         border_counts: dict[int, int] = {}\n 138:         pset = {(int(r), int(c)) for r, c in pts}\n 139:         for r, c in pts:\n 140:             for nr, nc in neighbors4(r, c):\n 141:                 if not (0 <= nr < h and 0 <= nc < w):\n 142:                     continue\n 143:                 if (nr, nc) in pset:\n 144:                     continue\n 145:                 v = int(g[nr, nc])\n 146:                 if v == bg or v == mover:\n 147:                     continue\n 148:                 border_counts[v] = border_counts.get(v, 0) + 1\n 149:         if not border_counts:\n 150:             continue\n 151:         border_col = max(border_counts, key=border_counts.get)\n 152:         if border_col not in dirs:\n 153:             continue\n 154:         dr, dc = dirs[border_col]\n 155: \n 156:         # Clear old movers.\n 157:         for r, c in movers:\n 158:             out[r, c] = bg\n 159: \n 160:         # Slide and repaint.\n 161:         new_pts = _slide_points(pset, movers, dr, dc)\n 162:         for r, c in new_pts:\n 163:             out[r, c] = mover\n 164: \n--- generate_input lines 604-613 ---\n 604: def generate_input() -> np.ndarray:\n 605:     rng = random.Random()\n 606:     for _ in range(GEN_RETRIES):\n 607:         try:\n 608:             g = _gen_attempt(rng)\n 609:         except Exception:\n 610:             continue\n 611:         if g is not None:\n 612:             return g\n\n===== /home/lixinyu/snap/new/ARC_code/train/a834deea.py =====\n--- main lines 19-78 ---\n  19: def main(grid: np.ndarray) -> np.ndarray:\n  20:     \"\"\"\n  21:     Fill each black 5x5 region's missing interior positions with a fixed 3x3 positional color legend.\n  22: \n  23:     Input structure\n  24:     - The grid uses teal as the dominant background and black for one or more\n  25:       5x5 regions.\n  26:     - Each black region has a black one-pixel border and a 3x3 interior that\n  27:       may already contain teal pixels.\n  28: \n  29:     Rule\n  30:     - Overlay the legend 1 7 6 / 4 8 5 / 2 9 3 on the 3x3 interior of every\n  31:       5x5 black region.\n  32:     - Wherever an interior non-center legend position is still black, recolor it\n  33:       to the corresponding legend color; leave existing teal pixels, the center,\n  34:       and the black border unchanged.\n  35: \n  36:     Key insight\n  37:     - The colored output pixels are not derived from the teal motif shape; they\n  38:       are the fixed position labels for the missing cells of each 3x3 interior.\n  39:     \"\"\"\n  40:     g = np.asarray(grid, dtype=int)\n  41:     assert g.ndim == 2\n  42: \n  43:     bg = get_bg(g)\n  44:     assert bg == Color.TEAL\n  45:     fg_colors = colors_present(g, exclude={bg})\n  46:     assert fg_colors == [Color.BLACK]\n  47: \n  48:     out = g.copy()\n  49:     components = find_components(\n  50:         g,\n  51:         bg=bg,\n  52:         connectivity=8,\n  53:         monochromatic=True,\n  54:         colors=[Color.BLACK],\n  55:     )\n  56:     assert components\n  57: \n  58:     for component in components:\n  59:         b = component[\"bbox\"]\n  60:         assert bbox_h(b) == 5 and bbox_w(b) == 5\n  61:         r0, c0, _r1, _c1 = b\n  62:         patch = crop_bbox(g, b)\n  63:         assert np.all((patch == Color.BLACK) | (patch == bg))\n  64:         assert np.all(patch[[0, -1], :] == Color.BLACK)\n  65:         assert np.all(patch[:, [0, -1]] == Color.BLACK)\n  66:         assert np.any(patch[1:4, 1:4] == bg)\n  67: \n  68:         for rr in range(3):\n  69:             for cc in range(3):\n  70:                 color = int(LEGEND[rr, cc])\n  71:                 if color == bg:\n  72:                     continue\n  73:                 grid_r = int(r0) + rr + 1\n  74:                 grid_c = int(c0) + cc + 1\n  75:                 if g[grid_r, grid_c] == Color.BLACK:\n  76:                     out[grid_r, grid_c] = color\n  77: \n--- generate_input lines 184-189 ---\n 184: def generate_input():\n 185:     for _ in range(MAX_GENERATION_ATTEMPTS):\n 186:         grid = _gen_attempt()\n 187:         if grid is not None:\n 188:             return grid\n\n===== /home/lixinyu/snap/new/ARC_code/eval/31f7f899.py =====\n--- main lines 6-85 ---\n   6: def main(grid: np.ndarray) -> np.ndarray:\n   7:     \"\"\"\n   8:     Sort vertical bars by height and redistribute them across fixed colored slots.\n   9: \n  10:     Input structure:\n  11:     - bg background; a horizontal base line of a single color spans the full grid width.\n  12:     - Several monochrome vertical bars of distinct colors rise upward from the base line.\n  13: \n  14:     Rule:\n  15:     - Rank bar shapes by height (shortest to tallest).\n  16:     - Rank original x-positions (slots) left to right.\n  17:     - Place the i-th shortest shape into the i-th leftmost slot, recoloring it to that slot's original color.\n  18:     - The base line is preserved unchanged.\n  19: \n  20:     Key insight: Each slot keeps its x-position and color identity; only the bar silhouettes are redistributed among slots by height order.\n  21:     \"\"\"\n  22:     g = np.array(grid, dtype=int)\n  23:     H, W = g.shape\n  24:     bg = int(get_bg(g))\n  25: \n  26:     # Base row/color = (row,color) with maximal count on that row (excluding bg).\n  27:     best = None  # (count, row, color)\n  28:     for r in range(H):\n  29:         vals, counts = np.unique(g[r, :], return_counts=True)\n  30:         for v, cnt in zip(vals, counts):\n  31:             v = int(v)\n  32:             cnt = int(cnt)\n  33:             if v == bg:\n  34:                 continue\n  35:             if best is None or cnt > best[0]:\n  36:                 best = (cnt, int(r), int(v))\n  37:     assert not (best is None)\n  38:     _cnt, base_r, base_col = best\n  39: \n  40:     objects: list[dict[str, object]] = []\n  41:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n  42:         col = int(comp[\"color\"])\n  43:         if col in {int(bg), int(base_col)}:\n  44:             continue\n  45: \n  46:         pts = comp[\"coords\"]\n  47:         b = comp[\"bbox\"]\n  48:         height = int(bbox_h(b))\n  49: \n  50:         base_cols = sorted(int(c) for r, c in pts if int(r) == int(base_r))\n  51:         if base_cols:\n  52:             anchor = int(base_cols[len(base_cols) // 2])\n  53:         else:\n  54:             cols_sorted = sorted(int(c) for _r, c in pts)\n  55:             anchor = int(cols_sorted[len(cols_sorted) // 2])\n  56: \n  57:         rel = [(int(r) - int(base_r), int(c) - int(anchor)) for r, c in pts]\n  58:         objects.append(\n  59:             {\n  60:                 \"color\": int(col),\n  61:                 \"anchor\": int(anchor),\n  62:                 \"height\": int(height),\n  63:                 \"size\": int(len(rel)),\n  64:                 \"rel\": rel,\n  65:             }\n  66:         )\n  67: \n  68:     # Slots are determined by original x-positions; slot colors must be preserved.\n  69:     slots = sorted(objects, key=lambda o: (int(o[\"anchor\"]), int(o[\"color\"])))\n  70:     # Shapes are ordered by height (shortest -> tallest).\n  71:     shapes = sorted(objects, key=lambda o: (int(o[\"height\"]), int(o[\"size\"]), int(o[\"anchor\"]), int(o[\"color\"])))\n  72: \n  73:     out = np.full_like(g, bg)\n  74:     out[int(base_r), :] = int(base_col)\n  75: \n  76:     for slot, shape in zip(slots, shapes):\n  77:         slot_col = int(slot[\"color\"])\n  78:         slot_anchor = int(slot[\"anchor\"])\n  79:         for dr, dc in shape[\"rel\"]:\n  80:             rr = int(base_r) + int(dr)\n  81:             cc = int(slot_anchor) + int(dc)\n  82:             if 0 <= rr < H and 0 <= cc < W:\n  83:                 out[rr, cc] = int(slot_col)\n  84: \n--- generate_input lines 155-160 ---\n 155: def generate_input() -> np.ndarray:\n 156:     for _ in range(300):\n 157:         result = _gen_attempt()\n 158:         if result is not None:\n 159:             return result\n\n===== /home/lixinyu/snap/new/ARC_code/train/3ad05f52.py =====\n--- main lines 127-219 ---\n 127: def main(grid: np.ndarray) -> np.ndarray:\n 128:     \"\"\"\n 129:     Paint the maze corridor and framed rooms lying on shortest paths between the two colored endpoint components.\n 130: \n 131:     Input structure\n 132:     - The grid has a dominant background, one wall color forming thin orthogonal frames, and one endpoint/fill color.\n 133:     - The endpoint/fill color forms exactly two 4-connected solid rectangular components; their larger side lengths define the framed room sizes.\n 134: \n 135:     Rule\n 136:     - Treat wall pixels as blocked and every other pixel as passable.\n 137:     - Find every passable pixel that lies on a shortest 4-connected path between the two endpoint components.\n 138:     - Also fill any framed square room of an endpoint-derived size that intersects that shortest-path mask.\n 139: \n 140:     Key insight\n 141:     - Shortest paths identify the route through open connector corridors, while the wall-bordered square rooms need to be expanded from the route centerline to their full interior.\n 142:     \"\"\"\n 143:     g = np.asarray(grid, dtype=int)\n 144:     assert g.ndim == 2\n 145: \n 146:     bg = get_bg(g)\n 147:     counts = Counter(map(int, g.flat))\n 148: \n 149:     non_bg = colors_present(g, exclude={bg})\n 150:     assert len(non_bg) == 2\n 151:     assert counts[bg] > max(counts[color] for color in non_bg)\n 152:     non_bg_counts = {color: int(np.count_nonzero(g == color)) for color in non_bg}\n 153:     wall_count = max(non_bg_counts.values())\n 154:     wall_candidates = [color for color, count in non_bg_counts.items() if count == wall_count]\n 155:     assert len(wall_candidates) == 1\n 156:     wall = wall_candidates[0]\n 157:     paint_candidates = [color for color in non_bg if color != wall]\n 158:     assert len(paint_candidates) == 1\n 159:     paint = paint_candidates[0]\n 160:     assert non_bg_counts[wall] > non_bg_counts[paint]\n 161: \n 162:     endpoints = find_components(g, bg=bg, colors=[paint], connectivity=4)\n 163:     assert len(endpoints) == 2\n 164:     endpoint_coords = [component[\"coords\"] for component in endpoints]\n 165: \n 166:     room_sizes: set[int] = set()\n 167:     for coords in endpoint_coords:\n 168:         r0, c0, r1, c1 = bbox_coords(coords)\n 169:         bh = r1 - r0 + 1\n 170:         bw = c1 - c0 + 1\n 171:         assert coords.shape[0] == bh * bw\n 172:         room_sizes.add(max(bh, bw))\n 173: \n 174:     passable = g != wall\n 175:     dist0 = _distances_from(endpoint_coords[0], passable)\n 176:     dist1 = _distances_from(endpoint_coords[1], passable)\n 177:     endpoint_distances = [int(dist0[r, c]) for r, c in endpoint_coords[1]]\n 178:     reachable_distances = [d for d in endpoint_distances if d >= 0]\n 179:     assert len(reachable_distances) == len(endpoint_distances)\n 180:     shortest = min(reachable_distances)\n 181: \n 182:     route = (dist0 >= 0) & (dist1 >= 0) & (dist0 + dist1 == shortest)\n 183:     assert np.any(route)\n 184: \n 185:     fill = route.copy()\n 186:     rooms = _framed_square_rooms(g, wall, room_sizes)\n 187:     assert rooms\n 188:     for r, c, n in rooms:\n 189:         if np.any(route[r : r + n, c : c + n]):\n 190:             fill[r : r + n, c : c + n] = True\n 191: \n 192:     room_mask = np.zeros_like(fill, dtype=bool)\n 193:     for r, c, n in rooms:\n 194:         room_mask[r : r + n, c : c + n] = True\n 195:     open_fill = fill & (g == bg) & ~room_mask\n 196:     for r0, c0, r1, c1, area in _component_bboxes(open_fill):\n 197:         if r1 > r0 and c1 > c0 and area >= 20:\n 198:             assert _middle_fill_bounded_by_side_rooms(\n 199:                 (r0, c0, r1, c1),\n 200:                 rooms,\n 201:             ), \"middle fill must stay within the facing room-frame spans\"\n 202: \n 203:     H, W = g.shape\n 204:     for r, c, n in rooms:\n 205:         has_doorway = False\n 206:         if r > 0:\n...\n--- generate_input lines 719-724 ---\n 719: def generate_input():\n 720:     for _ in range(GENERATE_ATTEMPTS):\n 721:         grid = _gen_attempt()\n 722:         if grid is not None:\n 723:             return grid\n\n","exit_code":0,"status":"completed"}}
