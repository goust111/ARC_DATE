 \"\"\"Distribute total_match sprites across n_frames, each capped at MAX_DOTS_PER_FRAME.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8f215267.py:120:    \"\"\"Grow a connected polyomino of the given area inside an h x w bounding box.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8f215267.py:135:    \"\"\"Generate a small random connected sprite, tight-cropped to its bounding box.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8f215267.py:204:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/f931b4a8.py:9:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/f931b4a8.py:10:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f931b4a8.py:27:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f931b4a8.py:95:    \"\"\"Return k distinct colors sampled from pool.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f931b4a8.py:102:    \"\"\"Fill an array by drawing each cell independently from palette.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f931b4a8.py:110:    \"\"\"Return all (r,c) in a qxq grid in a layout-dependent order.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f931b4a8.py:133:    \"\"\"Build the fill tile (all non-black) using stripe/solid/diagonal patterns.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f931b4a8.py:168:    \"\"\"Build the stencil tile (black = holes filled from fill tile).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f931b4a8.py:207:    \"\"\"Build a control quadrant with exactly `count` non-black pixels.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f931b4a8.py:231:    \"\"\"Reproduce the solver's tiling logic for oracle validation.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f931b4a8.py:243:    \"\"\"Try once to produce a valid grid; return None on failure.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f931b4a8.py:298:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
