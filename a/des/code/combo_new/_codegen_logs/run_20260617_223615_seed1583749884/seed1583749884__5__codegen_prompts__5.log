{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/135a2760.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repair noisy periodic patterns inside frame-delimited grid regions.\n\n    Input structure:\n    - Frame color (most common) forms full rows/cols, dividing the grid into rectangular regions.\n    - bg (second most common) fills empty space; each region contains a small colored tile repeated periodically with a few corrupted pixels.\n\n    Rule:\n    - For each region, find the bounding box of non-bg content.\n    - Infer the smallest repeating tile that explains the pattern (majority vote per residue position), requiring it repeat at least 2x per axis.\n    - Replace the region with the clean tiled version.\n\n    Key insight: Tile dimensions are unknown and must be inferred; prefer the smallest tile with genuine repetition over one that memorizes the entire region.\n    \"\"\"\n    g = np.array(grid, dtype=int).copy()\n    H, W = g.shape\n\n    cnt = Counter(map(int, g.flatten()))\n    frame = int(cnt.most_common(1)[0][0])\n    bg = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(frame):\n            bg = int(col)\n            break\n    assert not (bg is None)\n\n    fr = [int(r) for r in range(H) if bool((g[int(r), :] == int(frame)).all())]\n    fc = [int(c) for c in range(W) if bool((g[:, int(c)] == int(frame)).all())]\n    fr = sorted(set(fr))\n    fc = sorted(set(fc))\n\n    assert fr\n    assert fc\n\n    if fr[0] != 0:\n        fr = [-1] + fr\n    if fr[-1] != (H - 1):\n        fr = fr + [H]\n    else:\n        fr = fr + [H]\n\n    if fc[0] != 0:\n        fc = [-1] + fc\n    if fc[-1] != (W - 1):\n        fc = fc + [W]\n    else:\n        fc = fc + [W]\n\n    def reconstruct(core: np.ndarray, maxp: int = 12) -> np.ndarray:\n        h, w = core.shape\n        best_all = None  # ((mism, area), B)\n        best_ok = None\n\n        for ph in range(1, min(int(maxp), int(h)) + 1):\n            for pw in range(1, min(int(maxp), int(w)) + 1):\n                tile = np.zeros((int(ph), int(pw)), dtype=int)\n                for i in range(int(ph)):\n                    for j in range(int(pw)):\n                        vals = core[int(i) :: int(ph), int(j) :: int(pw)].flatten()\n                        tile[int(i), int(j)] = int(Counter(map(int, vals)).most_common(1)[0][0])\n\n                B = np.tile(tile, ((h + ph - 1) // ph, (w + pw - 1) // pw))[:h, :w]\n                mism = int(np.sum(B != core))\n                area = int(ph * pw)\n                key = (mism, area)\n\n                if best_all is None or key < best_all[0]:\n                    best_all = (key, B)\n\n                # Require some repetition (avoid memorizing the entire core).\n                ok = True\n                if int(ph) == int(h) and int(pw) == int(w):\n                    ok = False\n                if int(ph) < int(h) and (int(h) // int(ph)) < 2:\n                    ok = False\n                if int(pw) < int(w) and (int(w) // int(pw)) < 2:\n                    ok = False\n                if ok and (best_ok is None or key < best_ok[0]):\n                    best_ok = (key, B)\n\n        return (best_ok or best_all)[1]\n\n    out = g.copy()\n    for i in range(len(fr) - 1):\n        r0, r1 = int(fr[i]), int(fr[i + 1])\n        if int(r1 - r0) <= 1:\n            continue\n        rr0, rr1 = int(r0 + 1), int(r1 - 1)\n\n        for j in range(len(fc) - 1):\n            c0, c1 = int(fc[j]), int(fc[j + 1])\n            if int(c1 - c0) <= 1:\n                continue\n            cc0, cc1 = int(c0 + 1), int(c1 - 1)\n\n            A = g[rr0 : rr1 + 1, cc0 : cc1 + 1]\n            m = A != int(bg)\n            if not bool(m.any()):\n                continue\n\n            rs = np.where(m.any(axis=1))[0]\n            cs = np.where(m.any(axis=0))[0]\n            rmin, rmax = int(rs.min()), int(rs.max())\n            cmin, cmax = int(cs.min()), int(cs.max())\n\n            core = A[rmin : rmax + 1, cmin : cmax + 1]\n            rec = reconstruct(core)\n\n            A2 = A.copy()\n            A2[rmin : rmax + 1, cmin : cmax + 1] = rec\n            out[rr0 : rr1 + 1, cc0 : cc1 + 1] = A2\n\n    return out\n\n\ndef generate_input() -> np.ndarray:\n    bg = 0\n    frame = 5\n\n    # Region grid (2x2 or 3x2) with 1px frame separators.\n    n_r = int(np.random.randint(2, 4))\n    n_c = int(np.random.randint(2, 3))\n\n    r_sizes = [int(np.random.randint(6, 11)) for _ in range(n_r)]\n    c_sizes = [int(np.random.randint(6, 11)) for _ in range(n_c)]\n\n    H = int(sum(r_sizes) + (n_r + 1))\n    W = int(sum(c_sizes) + (n_c + 1))\n\n    g = np.full((H, W), int(frame), dtype=int)\n\n    # Fill each region with bg and optionally a repeating tile with noise.\n    any_pattern = False\n    r0 = 1\n    for i, rh in enumerate(r_sizes):\n        c0 = 1\n        for j, cw in enumerate(c_sizes):\n            region = np.full((int(rh), int(cw)), int(bg), dtype=int)\n\n            if bool(np.random.rand() < 0.85) or not any_pattern:\n                any_pattern = True\n                ph = int(np.random.randint(1, min(4, rh) + 1))\n                pw = int(np.random.randint(1, min(4, cw) + 1))\n\n                pal = [int(c) for c in np.random.choice(range(1, 10), size=int(np.random.randint(2, 5)), replace=False)]\n                pal = [c for c in pal if int(c) != int(frame)]\n                if not pal:\n                    pal = [2, 3]\n\n                tile = np.full((ph, pw), int(bg), dtype=int)\n                # Ensure at least one non-bg in the tile.\n                tile[int(np.random.randint(0, ph)), int(np.random.randint(0, pw))] = int(pal[0])\n                # Add a few more colored cells.\n                k = int(np.random.randint(0, ph * pw))\n                idx = np.random.choice(ph * pw, size=int(k), replace=False)\n                for t in idx:\n                    tile.flat[int(t)] = int(pal[int(np.random.randint(0, len(pal)))])\n\n                tiled = np.tile(tile, ((rh + ph - 1) // ph, (cw + pw - 1) // pw))[:rh, :cw]\n                region[:, :] = tiled\n\n                # Add small noise (flip a few cells) so reconstruction does real work.\n                n_noise = int(np.random.randint(0, max(1, (rh * cw) // 20)))\n                for _ in range(n_noise):\n                    rr = int(np.random.randint(0, rh))\n                    cc = int(np.random.randint(0, cw))\n                    if int(region[rr, cc]) != int(bg):\n                        region[rr, cc] = int(pal[int(np.random.randint(0, len(pal)))])\n\n            g[int(r0) : int(r0 + rh), int(c0) : int(c0 + cw)] = region\n            c0 += int(cw) + 1\n        r0 += int(rh) + 1\n\n    return g\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/b99e7126.py\"","aggregated_output":"from functools import reduce\nfrom math import gcd\n\nimport numpy as np\nimport random\nfrom itertools import combinations\nfrom arc_utils import paste\n\ndef _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:\n    \"\"\"\n    Infer a regular cell grid separated by full rows/cols of the same line color.\n    Returns (step, row_divs, col_divs) where:\n      - row_divs/col_divs are divider indices\n      - step is the spacing between dividers (cell size including divider).\n    \"\"\"\n    h, w = g.shape\n    line = int(g[0, 0])\n    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]\n    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]\n    assert len(row_divs) >= 2 and len(col_divs) >= 2, \"need at least 2 row and 2 col dividers\"\n    row_divs.sort()\n    col_divs.sort()\n    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]\n    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]\n    step = reduce(gcd, drs + dcs)\n    assert step > 1, \"divider step must be > 1\"\n    assert row_divs[0] == 0 and col_divs[0] == 0, \"first divider must be at index 0\"\n    assert (h - 1) % step == 0 and (w - 1) % step == 0, \"grid dimensions must be (k*step + 1)\"\n    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, \"last divider must be at boundary\"\n    return int(step), row_divs, col_divs\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Scale a minority cell's inner pattern up to the cell-grid level, completing a fractal overlay.\n\n    Input structure:\n    - Grid divided into NxN cells by separator lines of a single color.\n    - Most cells share an identical interior pattern (majority); a few have a distinct pattern (minority).\n\n    Rule:\n    - Extract the inner pixel pattern from the minority cell.\n    - Treat each pixel as a cell-sized stamp: active pixels → minority pattern, inactive → majority pattern.\n    - Position this scaled-up pattern on the cell grid so existing minority cells align with active pixels.\n    - Fill in all remaining active positions with the minority pattern.\n\n    Key insight: The minority cell's interior is a miniature blueprint of where minority cells should appear at the grid scale — fractal self-similarity.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    step, _, _ = _infer_cell_grid_params(g)\n    n = (g.shape[0] - 1) // step\n    inner = step - 1\n\n    # Extract interior patterns per cell.\n    patterns: dict[tuple[int, ...], np.ndarray] = {}\n    cell_pat: list[list[tuple[int, ...]]] = []\n    for i in range(n):\n        row: list[tuple[int, ...]] = []\n        for j in range(n):\n            r0 = i * step + 1\n            c0 = j * step + 1\n            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()\n            pat = tuple(pat_arr.ravel().tolist())\n            if pat not in patterns:\n                patterns[pat] = pat_arr\n            row.append(pat)\n        cell_pat.append(row)\n\n    # Find minority/majority cell patterns.\n    counts: dict[tuple[int, ...], int] = {}\n    for i in range(n):\n        for j in range(n):\n            p = cell_pat[i][j]\n            counts[p] = counts.get(p, 0) + 1\n    assert len(counts) >= 2, \"must have at least 2 distinct cell patterns (minority + majority)\"\n\n    minority_pat = min(counts.items(), key=lambda kv: kv[1])[0]\n    majority_pat = max(counts.items(), key=lambda kv: kv[1])[0]\n    minority_arr = patterns[minority_pat]\n\n    # Mask derived from the minority cell's inner pattern:\n    # active color is the most frequent color within the minority pattern.\n    _vals, _cnts = np.unique(minority_arr, return_counts=True)\n    active_color = int(_vals[_cnts.argmax()])\n    mask = (minority_arr == active_color)\n    mh, mw = mask.shape\n\n    existing = np.zeros((n, n), dtype=bool)\n    for i in range(n):\n        for j in range(n):\n            existing[i, j] = cell_pat[i][j] == minority_pat\n\n    # Find the unique placement of the m×m mask in the cell grid such that:\n    # - all existing minority cells lie within the block\n    # - within the block, existing minority cells only occur where mask is True\n    candidates: list[tuple[int, int]] = []\n    for top in range(0, n - mh + 1):\n        for left in range(0, n - mw + 1):\n            block = np.zeros_like(existing)\n            block[top : top + mh, left : left + mw] = True\n            if np.any(existing & ~block):\n                continue\n            ex_block = existing[top : top + mh, left : left + mw]\n            if np.any(ex_block & ~mask):\n                continue\n            candidates.append((int(top), int(left)))\n    assert len(candidates) == 1, \"must have a unique mask placement aligning existing minority cells\"\n    top, left = candidates[0]\n\n    out = g.copy()\n    for i in range(mh):\n        for j in range(mw):\n            target_pat = minority_arr if mask[i, j] else patterns[majority_pat]\n            r0 = (top + i) * step + 1\n            c0 = (left + j) * step + 1\n            out[r0 : r0 + inner, c0 : c0 + inner] = target_pat\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- CFG: tunable generation parameters ---\nCELL_GRID_N = 7           # number of cells per row/col in the 7x7 cell grid\nCELL_INNER = 3            # interior size of each cell (3x3)\nCELL_STEP = 4             # stride between cell origins (inner + 1 divider)\nGRID_SIZE = 29            # full pixel grid: N*STEP+1\nMASK_SIZE = 3             # minority mask dimensions (same as CELL_INNER)\nPLACEMENT_RANGE = CELL_GRID_N - MASK_SIZE + 1  # valid offset range: 0..4\nACTIVE_PIXEL_COUNTS = (6, 7)   # active pixels in minority mask\nGIVEN_CELL_SIZES = [3, 4]      # number of minority cells shown in input\nCOLOR_POOL = 10           # sample 4 distinct colors from 0..9\nMAX_RETRIES = 300         # generate_input retry budget\n\n# LR-symmetric pixel groups: pairs share left/right, singletons sit on center col\n_LR_GROUPS = [\n    ((0, 0), (0, 2)),\n    ((1, 0), (1, 2)),\n    ((2, 0), (2, 2)),\n    ((0, 1),),\n    ((1, 1),),\n    ((2, 1),),\n]\n\n# Pre-compute all valid minority masks (grouped by active count) at module load.\n# Each mask is LR-symmetric with active pixels spanning all 4 edges.\ndef _precompute_masks():\n    \"\"\"Enumerate all valid LR-symmetric 3x3 masks, keyed by active pixel count.\"\"\"\n    weights = [len(g) for g in _LR_GROUPS]\n    by_count = {}\n    for active_count in ACTIVE_PIXEL_COUNTS:\n        inactive_count = MASK_SIZE * MASK_SIZE - active_count\n        masks = []\n        for k in range(1, len(_LR_GROUPS) + 1):\n            for combo in combinations(range(len(_LR_GROUPS)), k):\n                if sum(weights[i] for i in combo) != inactive_count:\n                    continue\n                mask = np.ones((MASK_SIZE, MASK_SIZE), dtype=bool)\n                for i in combo:\n                    for r, c in _LR_GROUPS[i]:\n                        mask[r, c] = False\n                if mask[0, :].any() and mask[2, :].any() and mask[:, 0].any() and mask[:, 2].any():\n                    masks.append(mask)\n        by_count[active_count] = masks\n    return by_count\n\n_MASKS_BY_COUNT = _precompute_masks()\n\n\ndef _random_lr_pattern(color_a, color_b):\n    \"\"\"Generate a random LR-symmetric 3x3 pattern using two colors (guaranteed non-uniform).\"\"\"\n    arr = np.empty((MASK_SIZE, MASK_SIZE), dtype=int)\n    choices = [random.choice((color_a, color_b)) for _ in _LR_GROUPS]\n    if all(v == choices[0] for v in choices):\n        choices[random.randrange(len(choices))] = color_b if choices[0] == color_a else color_a\n    for group, color in zip(_LR_GROUPS, choices):\n        for r, c in group:\n            arr[r, c] = color\n    return arr\n\n\ndef _random_minority_mask():\n    \"\"\"Pick a random valid minority mask (uniform over active count, then uniform within count).\"\"\"\n    active_count = random.choice(ACTIVE_PIXEL_COUNTS)\n    return random.choice(_MASKS_BY_COUNT[active_count])\n\n\ndef _placement_candidates(mask, subset, top, left):\n    \"\"\"Find all (t, l) offsets where the given subset of active cells is consistent with mask.\"\"\"\n    existing = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)\n    for r, c in subset:\n        existing[top + r, left + c] = True\n\n    candidates = []\n    for t in range(PLACEMENT_RANGE):\n        for l in range(PLACEMENT_RANGE):\n            block = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)\n            block[t : t + MASK_SIZE, l : l + MASK_SIZE] = True\n            if np.any(existing & ~block):\n                continue\n            if np.any(existing[t : t + MASK_SIZE, l : l + MASK_SIZE] & ~mask):\n                continue\n            candidates.append((t, l))\n    return candidates\n\n\ndef _choose_given_subset(mask, top, left):\n    \"\"\"Choose a subset of active mask positions that uniquely determines the placement.\"\"\"\n    active = [tuple(coord) for coord in np.argwhere(mask)]\n    sizes = list(GIVEN_CELL_SIZES)\n    random.shuffle(sizes)\n    for size in sizes:\n        valid = [\n            subset\n            for subset in combinations(active, size)\n            if _placement_candidates(mask, subset, top, left) == [(top, left)]\n        ]\n        if valid:\n            return random.choice(valid)\n    return None\n\n\ndef _cell_origin(i, j):\n    \"\"\"Pixel origin of cell (i, j) interior within the full grid.\"\"\"\n    return i * CELL_STEP + 1, j * CELL_STEP + 1\n\n\ndef _build_grid(separator, majority, minority, active_cells):\n    \"\"\"Construct a 29x29 grid: fill all cells with majority, then overwrite active_cells.\"\"\"\n    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)\n    for i in range(CELL_GRID_N):\n        for j in range(CELL_GRID_N):\n            paste(grid, majority, *_cell_origin(i, j))\n    for i, j in active_cells:\n        paste(grid, minority, *_cell_origin(i, j))\n    return grid\n\n\ndef _gen_attempt():\n    \"\"\"Single generation attempt: build output, choose input subset, verify with solver.\"\"\"\n    separator, maj_exclusive, shared, min_exclusive = random.sample(range(COLOR_POOL), 4)\n    majority = _random_lr_pattern(shared, maj_exclusive)\n    mask = _random_minority_mask()\n    minority = np.where(mask, min_exclusive, shared).astype(int)\n\n    top = random.randrange(PLACEMENT_RANGE)\n    left = random.randrange(PLACEMENT_RANGE)\n    active_cells = [(top + r, left + c) for r, c in np.argwhere(mask)]\n    out = _build_grid(separator, majority, minority, active_cells)\n\n    subset = _choose_given_subset(mask, top, left)\n    if subset is None:\n        return None\n    given_cells = [(top + r, left + c) for r, c in subset]\n    inp = _build_grid(separator, majority, minority, given_cells)\n\n    try:\n        solved = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(solved, out):\n        return None\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/6350f1f4.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, colors_present, components_mask\nimport math\nimport random\n\n\nERASED = Color.GREY\nSEPARATOR = Color.BLACK\n\n\ndef _is_separator_line(line: np.ndarray) -> bool:\n    return set(map(int, line)).issubset({SEPARATOR, ERASED})\n\n\ndef _regular_intervals(separators: list[int], length: int) -> list[tuple[int, int]]:\n    assert separators, \"expected at least one separator line\"\n    bounds = [-1, *separators, int(length)]\n    intervals = [(bounds[i] + 1, bounds[i + 1]) for i in range(len(bounds) - 1)]\n    sizes = [end - start for start, end in intervals]\n    assert min(sizes) > 0, \"separators must leave non-empty blocks\"\n    assert len(set(sizes)) == 1, \"all encoded blocks must have the same size\"\n    return intervals\n\n\ndef _find_sprite(\n    g: np.ndarray,\n    row_intervals: list[tuple[int, int]],\n    col_intervals: list[tuple[int, int]],\n    payload_colors: list[int],\n) -> np.ndarray:\n    payload = set(payload_colors)\n    sprites = []\n\n    for r0, r1 in row_intervals:\n        for c0, c1 in col_intervals:\n            block = g[r0:r1, c0:c1]\n            block_colors = set(colors_present(block, exclude={ERASED}))\n            assert SEPARATOR not in block_colors, \"block interiors cannot contain separator color\"\n            if ERASED not in set(map(int, block.flat)) and block_colors == payload:\n                sprites.append(block.copy())\n\n    assert sprites, \"expected at least one fully visible sprite block\"\n    sprite = sprites[0]\n    for candidate in sprites:\n        assert np.array_equal(candidate, sprite), \"fully visible sprite blocks must match\"\n    return sprite\n\n\ndef _foreground_and_blank(sprite: np.ndarray, payload_colors: list[int]) -> tuple[int, int]:\n    counts = {color: int(np.count_nonzero(sprite == color)) for color in payload_colors}\n    assert counts[payload_colors[0]] != counts[payload_colors[1]], \"sprite colors must have a majority/minority split\"\n    foreground = max(payload_colors, key=lambda color: counts[color])\n    blank_colors = [color for color in payload_colors if color != foreground]\n    assert len(blank_colors) == 1\n    return int(foreground), int(blank_colors[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Decode a block-grid image by swapping each sprite-coded cell with a solid cell and each blank cell with the sprite.\n\n    Input structure\n    The grid is partitioned by black separator rows and columns into equal-size\n    square blocks. Each block is either a copy of one two-color sprite or a\n    uniform blank block of the sprite's minority color; grey pixels are erased\n    cells that act as wildcards.\n\n    Rule\n    Infer the repeated sprite from fully visible mixed-color blocks. Replace a\n    block matching that sprite, ignoring grey erasures, with a solid block of\n    the sprite's majority color. Replace a uniform blank block with the sprite.\n    Separator rows and columns, including grey erasures on them, become black.\n\n    Key insight\n    The small sprite is a block-level code for one macro-cell state, and the\n    uniform minority-color block is the other state; the output renders the\n    opposite code in each macro-cell while cleaning erased pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n\n    row_separators = [r for r in range(H) if _is_separator_line(g[r, :])]\n    col_separators = [c for c in range(W) if _is_separator_line(g[:, c])]\n    row_intervals = _regular_intervals(row_separators, H)\n    col_intervals = _regular_intervals(col_separators, W)\n    block_heights = {r1 - r0 for r0, r1 in row_intervals}\n    block_widths = {c1 - c0 for c0, c1 in col_intervals}\n    assert block_heights == block_widths, \"encoded blocks must be square\"\n\n    payload_colors = colors_present(g, exclude={SEPARATOR, ERASED})\n    assert len(payload_colors) == 2, \"expected exactly two non-separator payload colors\"\n    sprite = _find_sprite(g, row_intervals, col_intervals, payload_colors)\n    foreground, blank = _foreground_and_blank(sprite, payload_colors)\n\n    out = np.zeros_like(g)\n    for r0, r1 in row_intervals:\n        for c0, c1 in col_intervals:\n            block = g[r0:r1, c0:c1]\n            known = block != ERASED\n            assert known.any(), \"each block must expose at least one non-grey cell\"\n            matches_sprite = bool(np.all(block[known] == sprite[known]))\n            matches_blank = bool(np.all(block[known] == blank))\n            assert matches_sprite != matches_blank, \"each block must unambiguously match the sprite or blank state\"\n            out[r0:r1, c0:c1] = foreground if matches_sprite else sprite\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette bounds.\nGRID_COUNT_RANGE, BLOCK_SIZE_RANGE = (2, 4), (2, 4)\nPAYLOAD_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\nPAYLOAD_COLOR_COUNT = 2\nGEN_SEPARATOR_COLOR, GEN_ERASED_COLOR = int(SEPARATOR), int(ERASED)\n\n# Sprite composition constraints.\nSPRITE_FG_MIN_RATIO, SPRITE_FG_MAX_RATIO = (2, 3), (3, 4)\nSPRITE_ATTEMPTS, TINY_BLOCK_SIZE = 80, 2\n\n# Macro-cell state constraints.\nMIN_BLANK_BLOCKS, MAX_BLANK_BLOCK_DENOMINATOR = 1, 2\n\n# Grey overlay constraints.\nGREY_MIN_FRACTION, GREY_MAX_FRACTION = 0.05, 0.25\nGREY_TWO_COMPONENT_PROBABILITY, GREY_TWO_COMPONENT_ATTEMPTS = 0.5, 30\nGREY_CONNECTIVITY, GENERATION_ATTEMPTS = 4, 300\n\nNEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _separator_indices(n: int, block_size: int) -> set[int]:\n    return {(i + 1) * block_size + i for i in range(n - 1)}\n\n\ndef _block_origin(br: int, bc: int, block_size: int) -> tuple[int, int]:\n    return br * (block_size + 1), bc * (block_size + 1)\n\n\ndef _has_symmetry(mask: np.ndarray) -> bool:\n    return (\n        np.array_equal(mask, np.fliplr(mask))\n        or np.array_equal(mask, np.flipud(mask))\n        or np.array_equal(mask, np.rot90(mask, 2))\n    )\n\n\ndef _make_sprite(block_size: int, foreground: int, blank: int) -> np.ndarray | None:\n    area = block_size * block_size\n    min_num, min_den = SPRITE_FG_MIN_RATIO\n    max_num, max_den = SPRITE_FG_MAX_RATIO\n    fg_min = math.ceil(area * min_num / min_den)\n    fg_max = math.floor(area * max_num / max_den)\n    if fg_min > fg_max:\n        fg_min = fg_max = round(area * min_num / min_den)\n    fg_count = random.randint(fg_min, fg_max)\n    blank_count = area - fg_count\n\n    for _ in range(SPRITE_ATTEMPTS):\n        mask = np.ones((block_size, block_size), dtype=bool)\n        if block_size == TINY_BLOCK_SIZE:\n            blanks = [random.randrange(area)]\n        else:\n            cols = list(range(block_size))\n            random.shuffle(cols)\n            blanks = [r * block_size + cols[r] for r in range(block_size)]\n            extra = blank_count - block_size\n            if extra > 0:\n                pool = [i for i in range(area) if i not in blanks]\n                blanks.extend(random.sample(pool, extra))\n\n        for idx in blanks:\n            mask[idx // block_size, idx % block_size] = False\n\n        if block_size > TINY_BLOCK_SIZE:\n            row_mixed = all(0 < np.count_nonzero(mask[r]) < block_size for r in range(block_size))\n            col_mixed = all(0 < np.count_nonzero(mask[:, c]) < block_size for c in range(block_size))\n            if not row_mixed or not col_mixed:\n                continue\n        if _has_symmetry(mask):\n            continue\n\n        sprite = np.where(mask, foreground, blank).astype(int)\n        return sprite\n    return None\n\n\ndef _neighbors4(r: int, c: int, height: int, width: int):\n    for dr, dc in NEIGHBOR_OFFSETS_4:\n        nr, nc = r + dr, c + dc\n        if 0 <= nr < height and 0 <= nc < width:\n            yield nr, nc\n\n\ndef _grow_blob(allowed: np.ndarray, size: int) -> set[tuple[int, int]] | None:\n    comps = [\n        [tuple(map(int, rc)) for rc in coords]\n        for coords in components_mask(allowed, connectivity=GREY_CONNECTIVITY)\n        if len(coords) >= size\n    ]\n    if not comps:\n        return None\n\n    comp = random.choice(comps)\n    comp_set = set(comp)\n    seed = random.choice(comp)\n    blob = {seed}\n    frontier = {nb for nb in _neighbors4(*seed, *allowed.shape) if nb in comp_set}\n\n    while len(blob) < size:\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        blob.add(cell)\n        for nb in _neighbors4(*cell, *allowed.shape):\n            if nb in comp_set and nb not in blob:\n                frontier.add(nb)\n\n    return blob\n\n\ndef _make_grey_mask(allowed: np.ndarray, target: int) -> np.ndarray | None:\n    if target <= 0:\n        return np.zeros_like(allowed, dtype=bool)\n\n    want_two = target >= 2 and random.random() < GREY_TWO_COMPONENT_PROBABILITY\n    if want_two:\n        for _ in range(GREY_TWO_COMPONENT_ATTEMPTS):\n            first_size = random.randint(1, target - 1)\n            first = _grow_blob(allowed, first_size)\n            if first is None:\n                continue\n\n            blocked = set(first)\n            for r, c in tuple(first):\n                blocked.update(_neighbors4(r, c, *allowed.shape))\n\n            allowed_second = allowed.copy()\n            for r, c in blocked:\n                allowed_second[r, c] = False\n\n            second = _grow_blob(allowed_second, target - first_size)\n            if second is None:\n                continue\n\n            mask = np.zeros_like(allowed, dtype=bool)\n            for r, c in first | second:\n                mask[r, c] = True\n            return mask\n\n    one = _grow_blob(allowed, target)\n    if one is None:\n        return None\n\n    mask = np.zeros_like(allowed, dtype=bool)\n    for r, c in one:\n        mask[r, c] = True\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/faa9f03d.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import components_mask, get_bg\nimport random\n\n\nDIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _pts(mask: np.ndarray) -> set[tuple[int, int]]:\n    return {tuple(map(int, rc)) for rc in np.argwhere(mask)}\n\n\ndef _axis_support(mask: set[tuple[int, int]], r: int, c: int, axis: int) -> bool:\n    if axis == 0:\n        return (r, c - 1) in mask or (r, c + 1) in mask\n    return (r - 1, c) in mask or (r + 1, c) in mask\n\n\ndef _perp_support(mask: set[tuple[int, int]], r: int, c: int, axis: int) -> bool:\n    if axis == 0:\n        return (r - 1, c) in mask or (r + 1, c) in mask\n    return (r, c - 1) in mask or (r, c + 1) in mask\n\n\ndef _component_count(shape: tuple[int, int], pts: set[tuple[int, int]]) -> int:\n    mask = np.zeros(shape, dtype=bool)\n    for r, c in pts:\n        mask[r, c] = True\n    return len(components_mask(mask, connectivity=4))\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repair a one-cell-thick colored line network by replacing singleton markers, filling short orthogonal gaps, and redirecting yellow-marked arms to the edge.\n\n    Input structure:\n    - A rectangular grid with a dominant background.\n    - Line colors form one-cell-thick horizontal/vertical stroke fragments.\n    - Marker colors are exactly those whose 4-connected components are all singleton pixels.\n    - Red singleton markers are missing line cells; yellow singleton markers are directional controls next to a line endpoint.\n\n    Rule:\n    - Assign every marker to the nearest visible line color in row/column line-of-sight, preferring an endpoint supported along that same axis.\n    - For each line color, fill the gap between consecutive facing endpoints in a row or column.\n    - A yellow control erases the old straight arm on the far side of its endpoint and paints the same color from that endpoint through the control pixel to the grid edge.\n    - At crossings, yellow-control rays win; otherwise an original-vs-filled crossing uses the more fragmented pre-repair line color, while pure filled crossings use the lower color id.\n\n    Key insight: The singleton markers identify which sparse stroke fragments belong together; after they are colored, the intended lines are the axis-aligned gaps between facing endpoints, with yellow controls flipping one arm to the marked side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    colors = set(map(int, g.ravel())) - {bg}\n    assert colors, \"expected foreground line and marker colors\"\n\n    marker_colors: set[int] = set()\n    for color in colors:\n        comps = components_mask(g == color, connectivity=4)\n        assert comps, \"foreground color must have at least one component\"\n        if max(len(comp) for comp in comps) == 1:\n            marker_colors.add(int(color))\n\n    line_colors = colors - marker_colors\n    assert line_colors, \"expected at least one non-marker line color\"\n    assert marker_colors, \"expected singleton marker colors\"\n\n    original = {color: _pts(g == color) for color in line_colors}\n    assignment: dict[tuple[int, int], int] = {}\n    assign_dir: dict[tuple[int, int], tuple[int, int]] = {}\n\n    marker_mask = np.isin(g, list(marker_colors))\n    for r0, c0 in _pts(marker_mask):\n        candidates: list[tuple[int, int, int, int, int]] = []\n        for dr, dc in DIRS4:\n            r, c = r0 + dr, c0 + dc\n            dist = 1\n            while 0 <= r < H and 0 <= c < W:\n                value = int(g[r, c])\n                if value in line_colors:\n                    axis = 0 if dr == 0 else 1\n                    supported = _axis_support(original[value], r, c, axis)\n                    candidates.append((dist, 0 if supported else 1, value, dr, dc))\n                    break\n                if value == bg or value in marker_colors:\n                    r += dr\n                    c += dc\n                    dist += 1\n                    continue\n                break\n\n        assert candidates, f\"marker at {(r0, c0)} cannot see a line color\"\n        candidates.sort()\n        _dist, _unsupported, color, dr, dc = candidates[0]\n        assignment[(r0, c0)] = int(color)\n        assign_dir[(r0, c0)] = (int(dr), int(dc))\n\n    masks = {color: set(pts) for color, pts in original.items()}\n    marker_pts = {color: set() for color in line_colors}\n    for pt, color in assignment.items():\n        masks[color].add(pt)\n        marker_pts[color].add(pt)\n\n    comp_count = {color: _component_count(g.shape, masks[color]) for color in line_colors}\n\n    def has_axis_support(color: int, r: int, c: int, axis: int) -> bool:\n        return (r, c) in marker_pts[color] or _axis_support(masks[color], r, c, axis)\n\n    def should_fill(color: int, a: tuple[int, int], b: tuple[int, int], axis: int) -> bool:\n        r1, c1 = a\n        r2, c2 = b\n        gap = c2 - c1 - 1 if axis == 0 else r2 - r1 - 1\n        if gap <= 0:\n            return False\n\n        a_axis = has_axis_support(color, r1, c1, axis)\n        b_axis = has_axis_support(color, r2, c2, axis)\n        if gap == 1:\n            if a_axis or b_axis:\n                return True\n            a_perp = _perp_support(masks[color], r1, c1, axis)\n            b_perp = _perp_support(masks[color], r2, c2, axis)\n            return not (a_perp and b_perp)\n\n        if (r1, c1) in marker_pts[color] and (r2, c2) in marker_pts[color]:\n            return False\n        return a_axis and b_axis\n\n    for color in sorted(line_colors):\n        additions: set[tuple[int, int]] = set()\n        for r in range(H):\n            cols = sorted(c for rr, c in masks[color] if rr == r)\n            for c1, c2 in zip(cols, cols[1:]):\n                if should_fill(color, (r, c1), (r, c2), axis=0):\n                    additions.update((r, c) for c in range(c1 + 1, c2))\n\n        for c in range(W):\n            rows = sorted(r for r, cc in masks[color] if cc == c)\n            for r1, r2 in zip(rows, rows[1:]):\n                if should_fill(color, (r1, c), (r2, c), axis=1):\n                    additions.update((r, c) for r in range(r1 + 1, r2))\n\n        masks[color].update(additions)\n\n    control_ray = {color: set() for color in line_colors}\n    if 4 in marker_colors:\n        for control in _pts(g == 4):\n            color = assignment[control]\n            dr, dc = assign_dir[control]\n\n            r, c = control[0] + dr, control[1] + dc\n            pivot: tuple[int, int] | None = None\n            while 0 <= r < H and 0 <= c < W:\n                if (r, c) in masks[color]:\n                    pivot = (r, c)\n                    break\n                r += dr\n                c += dc\n            assert pivot is not None, f\"yellow control at {control} has no assigned endpoint\"\n\n            old_start = (pivot[0] + dr, pivot[1] + dc)\n            if old_start in masks[color]:\n                stack = [old_start]\n                old_arm: set[tuple[int, int]] = set()\n                while stack:\n                    q = stack.pop()\n                    if q == pivot or q in old_arm or q not in masks[color]:\n                        continue\n                    old_arm.add(q)\n                    qr, qc = q\n                    for ndr, ndc in DIRS4:\n                        stack.append((qr + ndr, qc + ndc))\n\n                assert old_arm, f\"yellow control at {control} found no old arm to erase\"\n                for q in old_arm:\n                    masks[color].discard(q)\n                    marker_pts[color].discard(q)\n                    control_ray[color].discard(q)\n\n            pr, pc = -dr, -dc\n            r, c = pivot\n            while 0 <= r < H and 0 <= c < W:\n                masks[color].add((r, c))\n                control_ray[color].add((r, c))\n                r += pr\n                c += pc\n\n    claims: dict[tuple[int, int], list[int]] = {}\n    for color, pts in masks.items():\n        for pt in pts:\n            claims.setdefault(pt, []).append(int(color))\n\n    out = np.full_like(g, bg)\n\n    def marker_brackets(color: int, pt: tuple[int, int]) -> bool:\n        r, c = pt\n        same_row = [mc for mr, mc in marker_pts[color] if mr == r]\n        if any(mc < c for mc in same_row) and any(mc > c for mc in same_row):\n            return True\n        same_col = [mr for mr, mc in marker_pts[color] if mc == c]\n        return any(mr < r for mr in same_col) and any(mr > r for mr in same_col)\n\n    for pt, colors_here in claims.items():\n        forced = {color for color in colors_here if pt in control_ray[color]}\n        if forced:\n            assert len(forced) == 1, f\"ambiguous yellow-control rays at {pt}: {forced}\"\n            out[pt] = next(iter(forced))\n            continue\n\n        if len(colors_here) == 1:\n            out[pt] = colors_here[0]\n            continue\n\n        original_crossing = [color for color in colors_here if int(g[pt]) == color]\n        if original_crossing:\n            out[pt] = min(colors_here, key=lambda color: (-comp_count[color], color))\n        else:\n            bracketed = [color for color in colors_here if marker_brackets(color, pt)]\n            if bracketed:\n                out[pt] = min(bracketed, key=lambda color: (-comp_count[color], color))\n            else:\n                out[pt] = min(colors_here)\n\n    # Assert: every visible endpoint is on the boundary (or at a crossing)\n    for color in line_colors:\n        for comp in components_mask(out == color, connectivity=4):\n            pts_set = set(map(tuple, comp))\n            for r, c in pts_set:\n                nbrs = [(nr, nc) for nr, nc in [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]\n                        if (nr, nc) in pts_set]\n                if len(nbrs) != 1:\n                    continue\n                on_boundary = (r == 0 or r == H - 1 or c == 0 or c == W - 1)\n                if on_boundary:\n                    # Perpendicularity check\n                    nr, nc = nbrs[0]\n                    dr, dc = nr - r, nc - c\n                    if not ((r in (0, H-1)) and (c in (0, W-1))):\n                        perp = ((r == 0 and dr == 1) or (r == H-1 and dr == -1)\n                                or (c == 0 and dc == 1) or (c == W-1 and dc == -1))\n                        assert perp, f\"boundary endpoint ({r},{c}) color {color} not perpendicular\"\n                    continue\n                adj_other = any(\n                    0 <= r+dr < H and 0 <= c+dc < W\n                    and int(out[r+dr, c+dc]) not in (bg, color)\n                    for dr, dc in DIRS4)\n                assert adj_other, f\"dangling endpoint ({r},{c}) color {color}: not on boundary or crossing\"\n\n    # Assert: every line color crosses at least one other color\n    color_cells = {c: set() for c in line_colors}\n    for r in range(H):\n        for c in range(W):\n            v = int(out[r, c])\n            if v in line_colors:\n                color_cells[v].add((r, c))\n    crossing_colors = set()\n    for r in range(H):\n","exit_code":0,"status":"completed"}}
