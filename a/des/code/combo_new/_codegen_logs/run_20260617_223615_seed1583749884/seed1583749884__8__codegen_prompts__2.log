{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/c6141b15.py\"","aggregated_output":"from itertools import combinations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, draw_line, find_components, get_bg, random_sprite\nimport random\n\n\nCoord = tuple[int, int]\n\n\ndef _sgn(x: int) -> int:\n    return (x > 0) - (x < 0)\n\n\ndef _straight_line_cells(a: Coord, b: Coord) -> set[Coord] | None:\n    r0, c0 = a\n    r1, c1 = b\n    dr = r1 - r0\n    dc = c1 - c0\n    if not (dr == 0 or dc == 0 or abs(dr) == abs(dc)):\n        return None\n    sr = _sgn(dr)\n    sc = _sgn(dc)\n    return {(r0 + i * sr, c0 + i * sc) for i in range(max(abs(dr), abs(dc)) + 1)}\n\n\ndef _segment_endpoints(coords: np.ndarray) -> tuple[Coord, Coord] | None:\n    cells = {tuple(map(int, rc)) for rc in coords}\n    if len(cells) < 2:\n        return None\n\n    endpoints: list[Coord] = []\n    for r, c in cells:\n        degree = sum(\n            (r + dr, c + dc) in cells\n            for dr in (-1, 0, 1)\n            for dc in (-1, 0, 1)\n            if (dr, dc) != (0, 0)\n        )\n        if degree == 1:\n            endpoints.append((r, c))\n        elif degree != 2:\n            return None\n\n    if len(endpoints) != 2:\n        return None\n    line = _straight_line_cells(endpoints[0], endpoints[1])\n    if line != cells:\n        return None\n    return endpoints[0], endpoints[1]\n\n\ndef _normalized_shape(coords: np.ndarray) -> frozenset[Coord]:\n    r0, c0, _r1, _c1 = bbox_coords(coords)\n    return frozenset((int(r - r0), int(c - c0)) for r, c in coords)\n\n\ndef _center_anchor(coords: np.ndarray) -> Coord | None:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    if (r0 + r1) % 2 or (c0 + c1) % 2:\n        return None\n    anchor = ((r0 + r1) // 2, (c0 + c1) // 2)\n    if anchor not in {tuple(map(int, rc)) for rc in coords}:\n        return None\n    return anchor\n\n\ndef _are_repeated_centered_sprites(components: list[np.ndarray]) -> bool:\n    if len(components) < 2:\n        return False\n    shapes = {_normalized_shape(coords) for coords in components}\n    return len(shapes) == 1 and all(_center_anchor(coords) is not None for coords in components)\n\n\ndef _non_collinear_three(points: list[Coord]) -> bool:\n    if len(points) != 3:\n        return True\n    (r0, c0), (r1, c1), (r2, c2) = points\n    return (r1 - r0) * (c2 - c0) != (r2 - r0) * (c1 - c0)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swap a connector segment with repeated marker sprites by connecting the marker anchors and stamping the sprite at the segment endpoints.\n\n    Input structure\n    The grid has one background color and exactly two foreground colors. One foreground color forms a single straight 8-connected segment. The other foreground color forms two or more identical centered sprites.\n\n    Rule\n    Build a background canvas of the same size. Draw straight connector-color segments between every pair of original sprite anchors. Then stamp the marker sprite, using its centered anchor, onto the two endpoints of the original connector segment.\n\n    Key insight\n    The original segment endpoints are the destinations for the repeated sprite, while the original sprite centers become the vertices of the new connector-color complete graph.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2\n\n    components_by_color = {\n        color: [\n            component[\"coords\"]\n            for component in find_components(g, bg=bg, colors=[color], connectivity=8)\n        ]\n        for color in colors\n    }\n\n    connector_colors = [\n        color\n        for color, components in components_by_color.items()\n        if len(components) == 1 and _segment_endpoints(components[0]) is not None\n    ]\n    sprite_colors = [\n        color\n        for color, components in components_by_color.items()\n        if _are_repeated_centered_sprites(components)\n    ]\n    assert len(connector_colors) == 1\n    assert len(sprite_colors) == 1\n\n    connector_color = connector_colors[0]\n    sprite_color = sprite_colors[0]\n    assert connector_color != sprite_color\n\n    endpoint_pair = _segment_endpoints(components_by_color[connector_color][0])\n    assert endpoint_pair is not None\n\n    sprite_components = components_by_color[sprite_color]\n    anchors: list[Coord] = []\n    for coords in sprite_components:\n        anchor = _center_anchor(coords)\n        assert anchor is not None\n        anchors.append(anchor)\n    assert _non_collinear_three(anchors), \"three repeated sprites must form a non-collinear triangle\"\n\n    reference_anchor = _center_anchor(sprite_components[0])\n    assert reference_anchor is not None\n    sprite_offsets = [\n        (int(r - reference_anchor[0]), int(c - reference_anchor[1]))\n        for r, c in sprite_components[0]\n    ]\n\n    out = np.full_like(g, bg)\n    for a, b in combinations(anchors, 2):\n        assert _straight_line_cells(a, b) is not None\n        draw_line(out, a[0], a[1], end_r=b[0], end_c=b[1], color=connector_color)\n\n    height, width = out.shape\n    for endpoint_r, endpoint_c in endpoint_pair:\n        for dr, dc in sprite_offsets:\n            r = endpoint_r + dr\n            c = endpoint_c + dc\n            assert 0 <= r < height and 0 <= c < width\n            out[r, c] = sprite_color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and colors.\nGRID_SIZE_MIN = 11\nGRID_SIZE_MAX = 16\nBACKGROUND_COLOR = 7\nFOREGROUND_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n\n# Symmetric sprite shape.\nSPRITE_HEIGHT_CHOICES = [1, 3, 3, 5, 5]\nSPRITE_WIDTH_CHOICES = [1, 3, 3, 5]\nSPRITE_DIM_SWAP_PROB = 0.5\nSPRITE_QUADRANT_FILL_PROB = 0.5\nSPRITE_BUILD_RETRIES = 50\n\n# Anchor layout.\nTHREE_SPRITE_PROB = 0.85\nANCHOR_LAYOUT_RETRIES = 100\nANCHOR_DIRECTIONS = ['h', 'v', 'd1', 'd2']\nTWO_ANCHOR_DIST_MIN = 3\nTWO_ANCHOR_DIST_MAX = 8\nTRIANGLE_DELTA_MIN = 3\nTRIANGLE_DELTA_MAX = 7\nTRIANGLE_ROTATIONS = [0, 1, 2, 3]\n\n# Connector segment.\nSEGMENT_RETRIES = 100\nSEGMENT_LENGTH_MIN = 6\nSEGMENT_LENGTH_MAX = 10\n\n# Overall retry budget.\nGENERATE_RETRIES = 300\n\n\ndef _gen2_symmetric_sprite(color):\n    \"\"\"Generate one connected LR+UD symmetric sprite with a filled center.\"\"\"\n    h = random.choice(SPRITE_HEIGHT_CHOICES)\n    w = random.choice(SPRITE_WIDTH_CHOICES)\n    if random.random() < SPRITE_DIM_SWAP_PROB:\n        h, w = w, h\n\n    if h == 1 and w == 1:\n        return np.array([[color]])\n\n    half_h = h // 2 + 1\n    half_w = w // 2 + 1\n    sprite = np.zeros((h, w), dtype=int)\n    cr, cc = h // 2, w // 2\n    sprite[cr, cc] = color\n\n    for r in range(half_h):\n        for c in range(half_w):\n            if random.random() < SPRITE_QUADRANT_FILL_PROB:\n                sprite[r, c] = color\n                sprite[r, w - 1 - c] = color\n                sprite[h - 1 - r, c] = color\n                sprite[h - 1 - r, w - 1 - c] = color\n\n    sprite[cr, cc] = color\n\n    from arc_utils import is_contiguous\n    mask = (sprite != 0)\n    if not mask.any():\n        sprite[cr, cc] = color\n        mask = (sprite != 0)\n    if not is_contiguous(mask, background=0, connectivity=8):\n        return None\n\n    if not np.any(sprite[0, :]) or not np.any(sprite[-1, :]):\n        return None\n    if not np.any(sprite[:, 0]) or not np.any(sprite[:, -1]):\n        return None\n\n    return sprite\n\n\ndef _gen_sprite_offsets(sprite):\n    h, w = sprite.shape\n    cr, cc = h // 2, w // 2\n    offsets = []\n    for r in range(h):\n        for c in range(w):\n            if sprite[r, c] != 0:\n                offsets.append((r - cr, c - cc))\n    return offsets\n\n\ndef _gen_sprite_cells_at(offsets, anchor_r, anchor_c):\n    return {(anchor_r + dr, anchor_c + dc) for dr, dc in offsets}\n\n\ndef _fits_in_grid(offsets, anchor_r, anchor_c, h, w):\n    for dr, dc in offsets:\n        r, c = anchor_r + dr, anchor_c + dc\n        if not (0 <= r < h and 0 <= c < w):\n            return False\n    return True\n\n\ndef _choose_sprite(sprite_color):\n    for _ in range(SPRITE_BUILD_RETRIES):\n        sprite = _gen2_symmetric_sprite(sprite_color)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/b74ca5d1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/b74ca5d1.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import defaultdict\nfrom typing import NamedTuple\nfrom numpy.random import default_rng\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg\n\n\nclass Sprite(NamedTuple):\n    body: int\n    marker: int\n    top: int\n    left: int\n    marker_rc: tuple[int, int]\n    mask: np.ndarray\n    body_mask: np.ndarray\n\n\ndef _corners(h: int, w: int) -> list[tuple[int, int]]:\n    return [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]\n\n\ndef _corner_labels(g: np.ndarray, bg: int) -> tuple[set[int], dict[int, tuple[int, int]]]:\n    labels: set[int] = set()\n    label_corner: dict[int, tuple[int, int]] = {}\n    h, w = g.shape\n    for r, c in _corners(h, w):\n        color = int(g[r, c])\n        if color == bg:\n            continue\n        assert color not in label_corner, \"each marker color must appear in exactly one corner\"\n        labels.add(color)\n        label_corner[color] = (r, c)\n    assert labels, \"expected at least one corner marker\"\n    return labels, label_corner\n\n\ndef _find_sprites(g: np.ndarray, bg: int, labels: set[int]) -> list[Sprite]:\n    h, w = g.shape\n    sprites: list[Sprite] = []\n    body_colors = set(colors_present(g, exclude={bg})) - labels\n    assert body_colors, \"expected non-corner body colors\"\n\n    for body in sorted(body_colors):\n        body_pts = np.argwhere(g == body)\n        assert body_pts.size, \"body color must be present\"\n        r0, c0 = body_pts.min(axis=0)\n        r1, c1 = body_pts.max(axis=0)\n        assert r1 - r0 < 5 and c1 - c0 < 5, \"each body color must fit in one 5x5 window\"\n\n        candidates: list[Sprite] = []\n        top_min = max(0, int(r1) - 4)\n        top_max = min(int(r0), h - 5)\n        left_min = max(0, int(c1) - 4)\n        left_max = min(int(c0), w - 5)\n        for top in range(top_min, top_max + 1):\n            for left in range(left_min, left_max + 1):\n                window = g[top : top + 5, left : left + 5]\n                other_colors = set(colors_present(window, exclude={bg, body}))\n                if len(other_colors) != 1:\n                    continue\n                marker = other_colors.pop()\n                if marker not in labels:\n                    continue\n                if int(np.count_nonzero(window == marker)) != 1:\n                    continue\n                if int(np.count_nonzero(window == body)) != len(body_pts):\n                    continue\n\n                marker_pos = np.argwhere(window == marker)\n                assert len(marker_pos) == 1\n                mr, mc = map(int, marker_pos[0])\n                candidates.append(\n                    Sprite(\n                        body=int(body),\n                        marker=int(marker),\n                        top=int(top),\n                        left=int(left),\n                        marker_rc=(mr, mc),\n                        mask=window != bg,\n                        body_mask=window == body,\n                    )\n                )\n\n        assert len(candidates) == 1, \"each body color must define a unique marked 5x5 sprite\"\n        sprites.append(candidates[0])\n\n    return sprites\n\n\ndef _owner_sets(group: list[Sprite]) -> list[list[set[int]]]:\n    owners = [[set() for _c in range(5)] for _r in range(5)]\n    for i, sprite in enumerate(group):\n        for r, c in np.argwhere(sprite.mask):\n            owners[int(r)][int(c)].add(i)\n    return owners\n\n\ndef _run_reaches_target_edge(\n    owners: list[list[set[int]]], owner: int, r: int, c: int, *, top_corner: bool\n) -> bool:\n    if top_corner:\n        rr = r\n        while rr >= 0 and owner in owners[rr][c]:\n            rr -= 1\n        return rr == -1\n\n    rr = r\n    while rr < 5 and owner in owners[rr][c]:\n        rr += 1\n    return rr == 5\n\n\ndef _corner_composite_mask(group: list[Sprite], *, top_corner: bool) -> np.ndarray:\n    owners = _owner_sets(group)\n    keep = np.array([[bool(owners[r][c]) for c in range(5)] for r in range(5)], dtype=bool)\n\n    # A one-sprite vertical tail hidden behind horizontal neighbors from other sprites\n    # is not part of the visible composite unless that run reaches the target edge.\n    if top_corner:\n        rows = range(1, 4)\n        away_step = 1\n        toward = lambda r: r - 1\n        in_bounds = lambda r: r < 5\n    else:\n        rows = range(3, 0, -1)\n        away_step = -1\n        toward = lambda r: r + 1\n        in_bounds = lambda r: r >= 0\n\n    for r in rows:\n        for c in range(1, 4):\n            if not keep[r, c] or len(owners[r][c]) != 1:\n                continue\n            owner = next(iter(owners[r][c]))\n            if _run_reaches_target_edge(owners, owner, r, c, top_corner=top_corner):\n                continue\n            if owner not in owners[toward(r)][c]:\n                continue\n            if not owners[r][c - 1] or not owners[r][c + 1]:\n                continue\n            if owner in owners[r][c - 1] or owner in owners[r][c + 1]:\n                continue\n\n            rr = r\n            while in_bounds(rr) and keep[rr, c] and owners[rr][c] == {owner}:\n                keep[rr, c] = False\n                rr += away_step\n\n    return keep\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swap each 5x5 sprite with its corner marker color and stamp same-marker composite masks into the matching corner.\n\n    Input structure:\n    - A 30x30 grid has one dominant background color.\n    - Non-background corner pixels are marker labels.\n    - Every other foreground color is the body of one 5x5 sprite containing exactly one pixel of a corner marker color.\n\n    Rule:\n    - For each sprite, recolor body pixels to the sprite marker color and recolor the marker pixel back to its body color.\n    - If a marker lies on the side facing its matching corner and another same-marker sprite has a body pixel at that same local cell, use that visible body color for the marker pixel.\n    - For each corner marker, overlay the masks of all sprites with that marker color into the corner 5x5 block and paint the visible composite with the marker color.\n\n    Key insight:\n    The corner pixels are labels that group 5x5 sprites by their embedded marker color; each labeled corner shows the grouped sprite silhouette.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = int(get_bg(g))\n    labels, label_corner = _corner_labels(g, bg)\n    sprites = _find_sprites(g, bg, labels)\n\n    by_marker: dict[int, list[Sprite]] = defaultdict(list)\n    for sprite in sprites:\n        by_marker[sprite.marker].append(sprite)\n\n    out = g.copy()\n    for sprite in sprites:\n        window = g[sprite.top : sprite.top + 5, sprite.left : sprite.left + 5]\n        patch = out[sprite.top : sprite.top + 5, sprite.left : sprite.left + 5]\n        patch[window == sprite.body] = sprite.marker\n\n        mr, mc = sprite.marker_rc\n        replacement = sprite.body\n        _corner_r, corner_c = label_corner[sprite.marker]\n        side_col = 0 if corner_c == 0 else 4\n        if mc == side_col:\n            overlaps = [\n                other.body\n                for other in by_marker[sprite.marker]\n                if other is not sprite and bool(other.body_mask[mr, mc])\n            ]\n            if overlaps:\n                assert len(overlaps) == 1, \"side marker overlap must identify one visible body color\"\n                replacement = overlaps[0]\n        patch[mr, mc] = replacement\n\n    for r, c in _corners(h, w):\n        label = int(g[r, c])\n        if label == bg:\n            continue\n        group = by_marker[label]\n        assert group, \"each corner marker must have at least one matching sprite\"\n        mask = _corner_composite_mask(group, top_corner=(r == 0))\n        rows = slice(0, 5) if r == 0 else slice(h - 5, h)\n        cols = slice(0, 5) if c == 0 else slice(w - 5, w)\n        patch = out[rows, cols]\n        patch[mask] = label\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and sprite geometry.\nGRID_H = 30\nGRID_W = 30\nSPRITE_SIZE = 5\nPLACEMENT_GAP = 1\n\n# Marker and sprite counts.\nNUM_CORNERS_OPTIONS = (2, 3)\nNUM_SPRITES_OPTIONS = (4, 5)\nMIN_GROUP_SPRITES = 1\nMAX_GROUP_SPRITES = 3\n\n# Sprite mask sampling: foreground includes the one marker pixel.\nMIN_BODY_PIXELS = 4\nMAX_BODY_PIXELS = 15\nMIN_FOREGROUND_PIXELS = MIN_BODY_PIXELS + 1\nMAX_FOREGROUND_PIXELS_EXCLUSIVE = MAX_BODY_PIXELS + 2\n\n# Retry budgets.\nDISTRIBUTION_ATTEMPTS = 100\nSPRITE_MASK_ATTEMPTS = 200\nGENERATE_ATTEMPTS = 300\n\nARC_COLORS = list(range(10))\nCORNER_POSITIONS = (\n    (0, 0),\n    (0, GRID_W - 1),\n    (GRID_H - 1, 0),\n    (GRID_H - 1, GRID_W - 1),\n)\nSPRITE_CELLS = [(r, c) for r in range(SPRITE_SIZE) for c in range(SPRITE_SIZE)]\n\n\ndef _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:\n    \"\"\"Generate a single valid input grid for the b74ca5d1 task.\"\"\"\n    all_colors = ARC_COLORS.copy()\n    rng.shuffle(all_colors)\n    bg = all_colors[0]\n\n    num_corners = rng.choice(NUM_CORNERS_OPTIONS)\n    chosen_corner_indices = rng.choice(4, size=num_corners, replace=False)\n","exit_code":0,"status":"completed"}}
