{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py && printf '\\\\n###GEN###\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/b1986d4b.py && printf '\\\\n###GEN###\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/b1986d4b.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Render the filled-square object counts as compact nested stacks ordered by count rank.\n\n    Input structure\n    A large noisy grid has a dominant background, scattered non-square noise, and\n    filled monochrome square objects. Each square side length has exactly one\n    object color, and side lengths form consecutive sizes.\n\n    Rule\n    Ignore non-square components. If the lowest square in the scene is of the\n    smallest side length, treat that one smallest square as a distractor and do\n    not count it. For count rank k from left to right, create one block from all\n    square sizes with at least k remaining objects; draw larger squares first and\n    smaller squares over their upper-left corner, then append one background\n    separator column.\n\n    Key insight\n    The output is a count histogram of square side lengths, but each histogram\n    slot is rendered as nested upper-left square masks using the side colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    objects = _square_objects(g, bg)\n    assert objects, \"expected filled square objects\"\n\n    sides = sorted({obj[\"side\"] for obj in objects})\n    assert sides == list(range(sides[0], sides[-1] + 1)), \"expected consecutive square side lengths\"\n\n    by_side = {side: [obj for obj in objects if obj[\"side\"] == side] for side in sides}\n    colors = {}\n    for side, side_objects in by_side.items():\n        side_colors = {obj[\"color\"] for obj in side_objects}\n        assert len(side_colors) == 1, \"each side length should have one color\"\n        colors[side] = side_colors.pop()\n\n    smallest = sides[0]\n    lowest_row = max(obj[\"bbox\"][2] for obj in objects)\n    lowest_smallest = [obj for obj in by_side[smallest] if obj[\"bbox\"][2] == lowest_row]\n    if lowest_smallest:\n        assert len(lowest_smallest) == 1, \"expected at most one lowest smallest distractor\"\n        drop_bbox = lowest_smallest[0][\"bbox\"]\n        by_side[smallest] = [obj for obj in by_side[smallest] if obj[\"bbox\"] != drop_bbox]\n\n    counts = {side: len(side_objects) for side, side_objects in by_side.items()}\n    assert all(count > 0 for count in counts.values()), \"each square size should remain represented\"\n\n    out_h = sides[-1] + 1\n    groups = []\n    for rank in range(max(counts.values())):\n        present_sides = [side for side in sides if counts[side] > rank]\n        assert present_sides, \"rank should contain at least one square size\"\n\n        group_w = max(present_sides)\n        group = np.full((out_h, group_w), bg, dtype=int)\n        for side in sorted(present_sides, reverse=True):\n            group[:side, :side] = colors[side]\n        groups.append(group)\n\n    out_w = sum(group.shape[1] + 1 for group in groups)\n    out = np.full((out_h, out_w), bg, dtype=int)\n    c = 0\n    for group in groups:\n        w = group.shape[1]\n        out[:, c : c + w] = group\n        c += w + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nSIDES = [2, 3, 4]\nALL_COLORS = list(range(10))\n\n# Canvas and object bounds.\nGRID_SIZE_RANGE = (25, 28)\nCOUNT_RANGE = (2, 6)\nSQUARE_GAP = 1\n\n# Noise and distractor controls.\nDISTRACTOR_PROB = 0.5\nNOISE_COUNT_RANGE = (40, 70)\n\n# Retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _choose_palette() -> tuple[int, dict[int, int], int]:\n    \"\"\"Choose one background, three square colors, and one noise color.\"\"\"\n    bg = random.choice(ALL_COLORS)\n    non_bg = [c for c in ALL_COLORS if c != bg]\n    random.shuffle(non_bg)\n    square_colors = {side: non_bg[i] for i, side in enumerate(SIDES)}\n    return bg, square_colors, non_bg[len(SIDES)]\n\n\ndef _make_square_queue(\n    counts: dict[int, int], square_colors: dict[int, int], has_distractor: bool\n) -> tuple[list[tuple[int, int]], tuple[int, int] | None]:\n    \"\"\"Return regular squares plus the separately placed distractor candidate.\"\"\"\n    squares = [(side, square_colors[side]) for side in SIDES for _ in range(counts[side])]\n    if has_distractor:\n        squares.append((SIDES[0], square_colors[SIDES[0]]))\n\n    random.shuffle(squares)\n    if not has_distractor:\n        return squares, None\n    return squares[:-1], squares[-1]\n\n\ndef _free_positions(occupied: np.ndarray, side: int, min_r: int = 0) -> list[tuple[int, int]]:\n    \"\"\"List top-left positions whose padded square footprint is unoccupied.\"\"\"\n    H, W = occupied.shape\n    valid = []\n    for r in range(min_r, H - side + 1):\n        for c in range(0, W - side + 1):\n            r0 = max(0, r - SQUARE_GAP)\n            r1 = min(H, r + side + SQUARE_GAP)\n            c0 = max(0, c - SQUARE_GAP)\n            c1 = min(W, c + side + SQUARE_GAP)\n            if not occupied[r0:r1, c0:c1].any():\n                valid.append((r, c))\n    return valid\n\n\ndef _mark_occupied(occupied: np.ndarray, r: int, c: int, side: int) -> None:\n    H, W = occupied.shape\n    r0 = max(0, r - SQUARE_GAP)\n    r1 = min(H, r + side + SQUARE_GAP)\n    c0 = max(0, c - SQUARE_GAP)\n    c1 = min(W, c + side + SQUARE_GAP)\n    occupied[r0:r1, c0:c1] = True\n\n\ndef _place_square(\n    grid: np.ndarray,\n    occupied: np.ndarray,\n    placed: list[tuple[int, int, int, int]],\n    side: int,\n    color: int,\n    positions: list[tuple[int, int]] | None = None,\n) -> bool:\n    \"\"\"Place one square at a random valid position and update grid state.\"\"\"\n    valid = _free_positions(occupied, side) if positions is None else positions\n    if not valid:\n        return False\n    r, c = random.choice(valid)\n    grid[r:r + side, c:c + side] = color\n    _mark_occupied(occupied, r, c, side)\n    placed.append((r, c, side, color))\n    return True\n\n\ndef _place_squares(\n    grid: np.ndarray,\n    occupied: np.ndarray,\n    regular_squares: list[tuple[int, int]],\n    distractor_sq: tuple[int, int] | None,\n) -> list[tuple[int, int, int, int]] | None:\n    \"\"\"Place all squares, requiring any distractor to sit below the others.\"\"\"\n    placed = []\n\n    random.shuffle(regular_squares)\n    for side, color in regular_squares:\n        if not _place_square(grid, occupied, placed, side, color):\n            return None\n\n    if distractor_sq is None:\n        return placed\n\n    d_side, d_color = distractor_sq\n    current_max_bottom = max(r + side - 1 for r, _, side, _ in placed) if placed else -1\n    min_r = max(0, current_max_bottom - d_side + 2)\n    valid = [\n        (r, c)\n        for r, c in _free_positions(occupied, d_side, min_r=min_r)\n        if r + d_side - 1 > current_max_bottom\n    ]\n    if not _place_square(grid, occupied, placed, d_side, d_color, valid):\n        return None\n    return placed\n\n\ndef _add_noise(grid: np.ndarray, bg: int, noise_color: int) -> bool:\n    \"\"\"Scatter noise onto background cells only.\"\"\"\n    free_cells = list(zip(*np.where(grid == bg)))\n    num_noise = random.randint(*NOISE_COUNT_RANGE)\n    if len(free_cells) < num_noise:\n        return False\n    random.shuffle(free_cells)\n    for r, c in free_cells[:num_noise]:\n        grid[r, c] = noise_color\n    return True\n\n\ndef _would_trigger_unintended_distractor(placed: list[tuple[int, int, int, int]]) -> bool:\n    \"\"\"Detect no-distractor samples where the solver would drop a small square.\"\"\"\n    lowest_row = max(r + side - 1 for r, _, side, _ in placed)\n    return any(side == SIDES[0] and r + side - 1 == lowest_row for r, _, side, _ in placed)\n\n\ndef _render_expected_output(\n    bg: int, counts: dict[int, int], square_colors: dict[int, int]\n) -> np.ndarray:\n    \"\"\"Render the count-derived oracle output used to validate samples.\"\"\"\n    out_h = SIDES[-1] + 1\n    groups = []\n    for rank in range(max(counts.values())):\n        present_sides = [side for side in SIDES if counts[side] > rank]\n        group = np.full((out_h, max(present_sides)), bg, dtype=int)\n        for side in sorted(present_sides, reverse=True):\n            group[:side, :side] = square_colors[side]\n        groups.append(group)\n\n    out_w = sum(group.shape[1] + 1 for group in groups)\n    out = np.full((out_h, out_w), bg, dtype=int)\n    c = 0\n    for group in groups:\n        w = group.shape[1]\n        out[:, c:c + w] = group\n        c += w + 1\n    return out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg, square_colors, noise_color = _choose_palette()\n    counts = {side: random.randint(*COUNT_RANGE) for side in SIDES}\n    has_distractor = random.random() < DISTRACTOR_PROB\n    regular_squares, distractor_sq = _make_square_queue(counts, square_colors, has_distractor)\n\n    H = random.randint(*GRID_SIZE_RANGE)\n    W = random.randint(*GRID_SIZE_RANGE)\n    grid = np.full((H, W), bg, dtype=int)\n    occupied = np.zeros((H, W), dtype=bool)\n\n    placed = _place_squares(grid, occupied, regular_squares, distractor_sq)\n    if placed is None or not _add_noise(grid, bg, noise_color):\n        return None\n\n    if not has_distractor and _would_trigger_unintended_distractor(placed):\n        return None\n\n    expected_out = _render_expected_output(bg, counts, square_colors)\n\n    try:\n        actual_out = main(grid)\n    except Exception:\n        return None\n\n    if not np.array_equal(actual_out, expected_out):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n\n###GEN###\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py && printf '\\\\n###GEN###\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.\n\n    Input structure\n    The grid has one background color and one foreground color; the foreground forms\n    separate solid rectangles, ordered from left to right.\n\n    Rule\n    Build a 10-row background canvas whose width is the packed width of the wide\n    versions of the rectangles. For each source rectangle, paint a top-aligned\n    rectangle of shape min(h,w) by max(h,w), with one background column between\n    consecutive rectangles. Then, starting again from the left edge, paint a\n    bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,\n    again separated by one background column.\n\n    Key insight\n    The input rectangles are not copied in their original orientations; each object\n    contributes one horizontal-facing and one vertical-facing normalized rectangle,\n    preserving left-to-right object order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n    fg = fg_colors[0]\n\n    components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n    assert components\n    components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n\n    dims: list[tuple[int, int]] = []\n    for obj in components:\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert obj[\"area\"] == h * w\n        dims.append((h, w))\n\n    out_h = 10\n    out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n    _assert_output_footprints_disjoint(dims)\n    out = np.full((out_h, out_w), bg, dtype=int)\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[:short, c : c + long] = fg\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[out_h - long : out_h, c : c + short] = fg\n        c += short + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\n# Rectangle counts and dimensions.\nRECT_COUNT_MIN = 4\nRECT_COUNT_MAX = 6\nSHORT_SIDE_MIN = 1\nSHORT_SIDE_MAX = 3\nSIDE_SUM_MAX = 10\nLONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN\n\n# Canvas and packing constraints.\nARC_GRID_MAX = 30\nOUTPUT_HEIGHT = 10\nGAP_WIDTH = 1\n\n# Retry policy.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_d749d46f_output_footprints_disjoint(dims):\n    occupied = set()\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, c) for r in range(short) for c in range(col, col + long)}\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += long + GAP_WIDTH\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, c)\n            for r in range(OUTPUT_HEIGHT - long, OUTPUT_HEIGHT)\n            for c in range(col, col + short)\n        }\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += short + GAP_WIDTH\n\n    return True\n\n\ndef _sample_dimensions(n_rects):\n    \"\"\"Sample source rectangle dimensions under the output-width budget.\"\"\"\n    dims = []\n    remaining_budget = ARC_GRID_MAX - GAP_WIDTH * (n_rects - 1)\n\n    for i in range(n_rects):\n        rects_left = n_rects - i\n        min_needed = rects_left - 1\n        max_for_this = min(remaining_budget - min_needed, LONG_SIDE_MAX)\n        if max_for_this < SHORT_SIDE_MIN:\n            return None\n\n        short = random.randint(SHORT_SIDE_MIN, SHORT_SIDE_MAX)\n        max_long = min(SIDE_SUM_MAX - short, max_for_this)\n        if max_long < short:\n            short = SHORT_SIDE_MIN\n            max_long = min(LONG_SIDE_MAX, max_for_this)\n            if max_long < SHORT_SIDE_MIN:\n                return None\n\n        long = random.randint(short, max_long)\n        remaining_budget -= long\n\n        if random.random() < 0.5:\n            h, w = long, short\n        else:\n            h, w = short, long\n        dims.append((h, w))\n\n    return dims\n\n\ndef _input_shape(dims):\n    return max(h for h, _ in dims), sum(w for _, w in dims) + GAP_WIDTH * (len(dims) - 1)\n\n\ndef _background_is_dominant(dims, inp_h, inp_w):\n    fg_pixels = sum(h * w for h, w in dims)\n    total_pixels = inp_h * inp_w\n    bg_pixels = total_pixels - fg_pixels\n    return bg_pixels > fg_pixels\n\n\ndef _build_input_grid(dims, bg, fg, inp_h, inp_w):\n    grid = np.full((inp_h, inp_w), bg, dtype=int)\n    col = 0\n    for h, w in dims:\n        grid[:h, col:col + w] = fg\n        col += w + GAP_WIDTH\n    return grid\n\n\ndef _passes_solver_oracle(grid):\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return out.shape[0] == OUTPUT_HEIGHT\n\n\ndef _gen_attempt():\n    \"\"\"Generate one valid input grid, or None when sampled dimensions fail constraints.\"\"\"\n    bg, fg = random.sample(COLOR_VALUES, 2)\n    n_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)\n    dims = _sample_dimensions(n_rects)\n    if dims is None:\n        return None\n\n    inp_h, inp_w = _input_shape(dims)\n    if inp_w > ARC_GRID_MAX:\n        return None\n    if not _gen_d749d46f_output_footprints_disjoint(dims):\n        return None\n    if inp_h > ARC_GRID_MAX or inp_h < 1:\n        return None\n    if not _background_is_dominant(dims, inp_h, inp_w):\n        return None\n\n    grid = _build_input_grid(dims, bg, fg, inp_h, inp_w)\n    if not _passes_solver_oracle(grid):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n\n###GEN###\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"参考实现里有两个共性需要保留：一是 `generate_input()` 通过拒绝采样反向验证 `main()`，二是会显式限制画布和输出上界，避免偶发 30x30 违规。继续把剩余 4 个参考题的函数读完，再定生成器约束。"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py && printf '\\\\n###GEN###\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py && printf '\\\\n###GEN###\\\\n' && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Look up query glyphs in a reference table and mark whether they form a line.\n\n    Input structure:\n    - Teal background with two full-width pink separator rows.\n    - Above the first separator is a query row of 5x5 glyph cells.\n    - Between separators is a reference table of the same 5x5 cells; a glyph is\n      identified by both its color and its 3x3 shape.\n\n    Rule:\n    - Green-fill the background inside every table cell whose glyph exactly\n      appears in the query row.\n    - If the matched table cells form one complete row or one complete column,\n      also green-fill the query band and the bottom verdict band.\n    - Otherwise leave the query band unchanged and fill the bottom verdict band red.\n\n    Key insight: The bottom color is not a count; it is the yes/no answer to\n    whether the queried glyphs align as a full row or column in the table.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n    cell_size = 5\n\n    sep_rows = _constant_non_bg_rows(g, bg)\n    assert len(sep_rows) >= 2, \"expected two full-width separator rows\"\n    top_sep = sep_rows[0]\n    bottom_sep = sep_rows[-1]\n\n    table_region = g[top_sep + 1 : bottom_sep, :]\n    table_fg = np.argwhere(table_region != bg)\n    assert table_fg.size, \"reference table must contain glyphs\"\n\n    first_glyph_r = top_sep + 1 + int(table_fg[:, 0].min())\n    first_glyph_c = int(table_fg[:, 1].min())\n    row0 = first_glyph_r - 1\n    col0 = first_glyph_c - 1\n\n    row_starts = list(range(row0, bottom_sep, cell_size))\n    row_starts = [r for r in row_starts if r + cell_size <= bottom_sep]\n    col_starts = list(range(col0, w, cell_size))\n    col_starts = [c for c in col_starts if c + cell_size <= w]\n    assert row_starts and col_starts, \"could not infer table cell grid\"\n\n    query_sigs = [\n        sig\n        for c in col_starts\n        if (sig := _cell_signature(g, 0, c, cell_size, bg)) is not None\n    ]\n    query_set = set(query_sigs)\n    assert len(query_sigs) == len(query_set), \"query glyphs should be distinct\"\n\n    out = g.copy()\n    selected: list[tuple[int, int]] = []\n    for ri, r in enumerate(row_starts):\n        for ci, c in enumerate(col_starts):\n            if _cell_signature(g, r, c, cell_size, bg) not in query_set:\n                continue\n            selected.append((int(ri), int(ci)))\n            cell = out[r : r + cell_size, c : c + cell_size]\n            cell[cell == bg] = 3\n\n    complete_query = len(query_sigs) == len(col_starts)\n    same_row = len({r for r, _c in selected}) == 1\n    same_col = len({c for _r, c in selected}) == 1\n    success = complete_query and len(selected) == len(query_sigs) and (same_row or same_col)\n\n    if success:\n        query_band = out[:top_sep, :]\n        query_band[query_band == bg] = 3\n        out[bottom_sep + 1 :, :] = 3\n    else:\n        out[bottom_sep + 1 :, :] = 2\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# -- Grid layout --\nGRID_H, GRID_W = 30, 22       # fixed canvas size\nTOP_SEP_ROW = 5                # query-band separator row\nBOTTOM_SEP_ROW = 27            # table-bottom separator row\nQUERY_BAND_H = 5               # height of query band (rows 0..4)\nVERDICT_ROW = 28               # verdict band starts here\n\n# -- Colors --\nBG = 8                         # teal background\nGREEN = 3                      # success / match highlight\nRED = 2                        # fail verdict\nSEP = 6                        # separator row color\nGLYPH_COLORS = (0, 1, 2, 4, 5, 6, 7, 9)  # 8 available glyph colors\n\n# -- Table geometry --\nTABLE_DIM = 4                  # 4x4 grid of cells\nCELL = 5                       # each cell is 5x5\nROWS = (7, 12, 17, 22)        # row offsets for 4 table rows\nCOLS = (1, 6, 11, 16)         # col offsets for 4 table columns\n\n# -- Glyph shape --\nFILL_MIN, FILL_MAX = 5, 9     # filled-pixel range per 3x3 glyph\nSHAPE_BASE_COUNTS = {5: 2, 6: 2, 7: 2, 8: 2, 9: 1}  # min shapes per fill-count\nMAX_SHAPES_PER_FILL = 5       # cap during random top-up\n\n# -- Color distribution --\nCOLOR_MIN, COLOR_MAX = 1, 3   # each color used 1-3 times across 16 cells\n\n# -- Outcome probabilities --\nP_SUCCESS = 0.4               # chance of success outcome\nP_QUERY_3 = 0.35              # chance of 3-query fail (vs 4-query fail)\nFAIL_MODES = (\"rect\", \"bent_row\", \"bent_col\", \"scatter_rows\", \"scatter_cols\")\n\n# -- Generation --\nMAX_RETRIES = 300\n\n\ndef _has_full_bbox(mask: int) -> bool:\n    \"\"\"True if the 3x3 bitmask spans all four edges (non-empty top/bottom/left/right rows).\"\"\"\n    bits = [(mask >> i) & 1 for i in range(9)]\n    return (\n        any(bits[0:3])\n        and any(bits[6:9])\n        and any(bits[i] for i in (0, 3, 6))\n        and any(bits[i] for i in (2, 5, 8))\n    )\n\n\nPATTERNS_BY_FILL = {\n    k: tuple(m for m in range(1 << 9) if m.bit_count() == k and _has_full_bbox(m))\n    for k in range(FILL_MIN, FILL_MAX + 1)\n}\n\n\ndef _balanced_color_list() -> list[int]:\n    \"\"\"Assign 16 colors (one per cell) so each of the 8 palette colors appears 1-3 times.\"\"\"\n    counts = {c: COLOR_MIN for c in GLYPH_COLORS}\n    extras = TABLE_DIM * TABLE_DIM - len(GLYPH_COLORS) * COLOR_MIN  # 16 - 8 = 8\n    for _ in range(extras):\n        choices = [c for c in GLYPH_COLORS if counts[c] < COLOR_MAX]\n        counts[random.choice(choices)] += 1\n    colors = [c for c, n in counts.items() for _ in range(n)]\n    random.shuffle(colors)\n    return colors\n\n\ndef _balanced_shape_masks() -> list[int]:\n    \"\"\"Pick 16 distinct 3x3 shape masks with a balanced distribution of fill counts.\"\"\"\n    counts = dict(SHAPE_BASE_COUNTS)\n    extras = TABLE_DIM * TABLE_DIM - sum(counts.values())  # 16 - 9 = 7\n    for _ in range(extras):\n        choices = [k for k in range(FILL_MIN, FILL_MAX) if counts[k] < MAX_SHAPES_PER_FILL]\n        counts[random.choice(choices)] += 1\n\n    masks: list[int] = []\n    for k, n in counts.items():\n        masks.extend(random.sample(PATTERNS_BY_FILL[k], n))\n    random.shuffle(masks)\n    return masks\n\n\ndef _glyph(mask: int, color: int) -> np.ndarray:\n    \"\"\"Render a 3x3 bitmask as a CELL x CELL array with 1-pixel border of BG.\"\"\"\n    cell = np.full((CELL, CELL), BG, dtype=int)\n    bits = np.array([(mask >> i) & 1 for i in range(9)], dtype=bool).reshape(3, 3)\n    cell[1:4, 1:4][bits] = color\n    return cell\n\n\ndef _line_cells() -> list[tuple[int, int]]:\n    \"\"\"Pick a complete row or column of 4 cells (shuffled order).\"\"\"\n    if random.random() < 0.5:\n        r = random.randrange(TABLE_DIM)\n        cells = [(r, c) for c in range(TABLE_DIM)]\n    else:\n        c = random.randrange(TABLE_DIM)\n        cells = [(r, c) for r in range(TABLE_DIM)]\n    random.shuffle(cells)\n    return cells\n\n\ndef _fail_cells(count: int) -> list[tuple[int, int]]:\n    \"\"\"Pick `count` distinct cells that do NOT all share a single row or column.\"\"\"\n    if count == 3:\n        rs = random.sample(range(TABLE_DIM), random.choice((2, 3)))\n        cs = random.sample(range(TABLE_DIM), random.choice((2, 3)))\n        cells = [(rs[0], cs[0]), (rs[1], cs[1])]\n        pool = [(r, c) for r in rs for c in cs if (r, c) not in cells]\n        cells.append(random.choice(pool))\n    else:\n        mode = random.choice(FAIL_MODES)\n        if mode == \"rect\":\n            rs = random.sample(range(TABLE_DIM), 2)\n            cs = random.sample(range(TABLE_DIM), 2)\n            cells = [(r, c) for r in rs for c in cs]\n        elif mode == \"bent_row\":\n            r = random.randrange(TABLE_DIM)\n            dropped_c = random.randrange(TABLE_DIM)\n            new_r = random.choice([rr for rr in range(TABLE_DIM) if rr != r])\n            cells = [(r, c) for c in range(TABLE_DIM) if c != dropped_c] + [(new_r, dropped_c)]\n        elif mode == \"bent_col\":\n            c = random.randrange(TABLE_DIM)\n            dropped_r = random.randrange(TABLE_DIM)\n            new_c = random.choice([cc for cc in range(TABLE_DIM) if cc != c])\n            cells = [(r, c) for r in range(TABLE_DIM) if r != dropped_r] + [(dropped_r, new_c)]\n        elif mode == \"scatter_rows\":\n            base_c = random.randrange(TABLE_DIM)\n            cols = [base_c] * TABLE_DIM\n            for r in random.sample(range(TABLE_DIM), random.choice((1, 2, 3))):\n                cols[r] = random.choice([c for c in range(TABLE_DIM) if c != base_c])\n            cells = [(r, cols[r]) for r in range(TABLE_DIM)]\n        else:\n            base_r = random.randrange(TABLE_DIM)\n            rows = [base_r] * TABLE_DIM\n            for c in random.sample(range(TABLE_DIM), random.choice((1, 2, 3))):\n                rows[c] = random.choice([r for r in range(TABLE_DIM) if r != base_r])\n            cells = [(rows[c], c) for c in range(TABLE_DIM)]\n\n    assert len(cells) == count and len(set(cells)) == count\n    assert len({r for r, _c in cells}) > 1 and len({c for _r, c in cells}) > 1\n    random.shuffle(cells)\n    return cells\n\n\ndef _expected_output(grid: np.ndarray, cells: list[tuple[int, int]], success: bool) -> np.ndarray:\n    \"\"\"Build the expected solver output by green-filling matched cells and verdict band.\"\"\"\n    out = grid.copy()\n    for r_i, c_i in cells:\n        cell = out[ROWS[r_i] : ROWS[r_i] + CELL, COLS[c_i] : COLS[c_i] + CELL]\n        cell[cell == BG] = GREEN\n    if success:\n        query_band = out[:QUERY_BAND_H, :]\n        query_band[query_band == BG] = GREEN\n        out[VERDICT_ROW:, :] = GREEN\n    else:\n        out[VERDICT_ROW:, :] = RED\n    return out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Try to generate one valid input grid; return None on oracle mismatch.\"\"\"\n    grid = np.full((GRID_H, GRID_W), BG, dtype=int)\n    grid[TOP_SEP_ROW, :] = SEP\n    grid[BOTTOM_SEP_ROW, :] = SEP\n\n    masks = _balanced_shape_masks()\n    colors = _balanced_color_list()\n    glyphs: list[np.ndarray] = []\n    for i, (mask, color) in enumerate(zip(masks, colors, strict=True)):\n        glyph = _glyph(mask, color)\n        glyphs.append(glyph)\n        r_i, c_i = divmod(i, TABLE_DIM)\n        paste(grid, glyph, ROWS[r_i], COLS[c_i])\n\n    success = random.random() < P_SUCCESS\n    if success:\n        query_cells = _line_cells()\n    else:\n        count = 3 if random.random() < P_QUERY_3 else 4\n        query_cells = _fail_cells(count)\n\n    for slot, (r_i, c_i) in enumerate(query_cells):\n        paste(grid, glyphs[r_i * TABLE_DIM + c_i], 0, COLS[slot])\n\n    expected = _expected_output(grid, query_cells, success)\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n\n###GEN###\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid d8e07eb2 input\")\n","exit_code":0,"status":"completed"}}
