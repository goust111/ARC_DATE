{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg\nimport random\n\n\ndef _assert_output_footprints_disjoint(dims: list[tuple[int, int]]) -> None:\n    occupied: set[tuple[int, int]] = set()\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, cc) for r in range(short) for cc in range(c, c + long)}\n        assert not (occupied & cells), \"normalized output rectangles must not overlap\"\n        occupied |= cells\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, cc)\n            for r in range(10 - long, 10)\n            for cc in range(c, c + short)\n        }\n        assert not (occupied & cells), \"normalized output rectangles must not overlap\"\n        occupied |= cells\n        c += short + 1\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.\n\n    Input structure\n    The grid has one background color and one foreground color; the foreground forms\n    separate solid rectangles, ordered from left to right.\n\n    Rule\n    Build a 10-row background canvas whose width is the packed width of the wide\n    versions of the rectangles. For each source rectangle, paint a top-aligned\n    rectangle of shape min(h,w) by max(h,w), with one background column between\n    consecutive rectangles. Then, starting again from the left edge, paint a\n    bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,\n    again separated by one background column.\n\n    Key insight\n    The input rectangles are not copied in their original orientations; each object\n    contributes one horizontal-facing and one vertical-facing normalized rectangle,\n    preserving left-to-right object order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n    fg = fg_colors[0]\n\n    components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n    assert components\n    components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n\n    dims: list[tuple[int, int]] = []\n    for obj in components:\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert obj[\"area\"] == h * w\n        dims.append((h, w))\n\n    out_h = 10\n    out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n    _assert_output_footprints_disjoint(dims)\n    out = np.full((out_h, out_w), bg, dtype=int)\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[:short, c : c + long] = fg\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[out_h - long : out_h, c : c + short] = fg\n        c += short + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\n# Rectangle counts and dimensions.\nRECT_COUNT_MIN = 4\nRECT_COUNT_MAX = 6\nSHORT_SIDE_MIN = 1\nSHORT_SIDE_MAX = 3\nSIDE_SUM_MAX = 10\nLONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN\n\n# Canvas and packing constraints.\nARC_GRID_MAX = 30\nOUTPUT_HEIGHT = 10\nGAP_WIDTH = 1\n\n# Retry policy.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_d749d46f_output_footprints_disjoint(dims):\n    occupied = set()\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, c) for r in range(short) for c in range(col, col + long)}\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += long + GAP_WIDTH\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, c)\n            for r in range(OUTPUT_HEIGHT - long, OUTPUT_HEIGHT)\n            for c in range(col, col + short)\n        }\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += short + GAP_WIDTH\n\n    return True\n\n\ndef _sample_dimensions(n_rects):\n    \"\"\"Sample source rectangle dimensions under the output-width budget.\"\"\"\n    dims = []\n    remaining_budget = ARC_GRID_MAX - GAP_WIDTH * (n_rects - 1)\n\n    for i in range(n_rects):\n        rects_left = n_rects - i\n        min_needed = rects_left - 1\n        max_for_this = min(remaining_budget - min_needed, LONG_SIDE_MAX)\n        if max_for_this < SHORT_SIDE_MIN:\n            return None\n\n        short = random.randint(SHORT_SIDE_MIN, SHORT_SIDE_MAX)\n        max_long = min(SIDE_SUM_MAX - short, max_for_this)\n        if max_long < short:\n            short = SHORT_SIDE_MIN\n            max_long = min(LONG_SIDE_MAX, max_for_this)\n            if max_long < SHORT_SIDE_MIN:\n                return None\n\n        long = random.randint(short, max_long)\n        remaining_budget -= long\n\n        if random.random() < 0.5:\n            h, w = long, short\n        else:\n            h, w = short, long\n        dims.append((h, w))\n\n    return dims\n\n\ndef _input_shape(dims):\n    return max(h for h, _ in dims), sum(w for _, w in dims) + GAP_WIDTH * (len(dims) - 1)\n\n\ndef _background_is_dominant(dims, inp_h, inp_w):\n    fg_pixels = sum(h * w for h, w in dims)\n    total_pixels = inp_h * inp_w\n    bg_pixels = total_pixels - fg_pixels\n    return bg_pixels > fg_pixels\n\n\ndef _build_input_grid(dims, bg, fg, inp_h, inp_w):\n    grid = np.full((inp_h, inp_w), bg, dtype=int)\n    col = 0\n    for h, w in dims:\n        grid[:h, col:col + w] = fg\n        col += w + GAP_WIDTH\n    return grid\n\n\ndef _passes_solver_oracle(grid):\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return out.shape[0] == OUTPUT_HEIGHT\n\n\ndef _gen_attempt():\n    \"\"\"Generate one valid input grid, or None when sampled dimensions fail constraints.\"\"\"\n    bg, fg = random.sample(COLOR_VALUES, 2)\n    n_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)\n    dims = _sample_dimensions(n_rects)\n    if dims is None:\n        return None\n\n    inp_h, inp_w = _input_shape(dims)\n    if inp_w > ARC_GRID_MAX:\n        return None\n    if not _gen_d749d46f_output_footprints_disjoint(dims):\n        return None\n    if inp_h > ARC_GRID_MAX or inp_h < 1:\n        return None\n    if not _background_is_dominant(dims, inp_h, inp_w):\n        return None\n\n    grid = _build_input_grid(dims, bg, fg, inp_h, inp_w)\n    if not _passes_solver_oracle(grid):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/eval/58490d8a.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_coords, components_mask, crop_bbox, get_bg, label_mask, paste, random_free_location\nimport random\nfrom functools import lru_cache\nfrom itertools import combinations\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count colored objects and record tallies inside a legend box.\n\n    Input structure:\n    - A black rectangular legend box with key-color pixels in its leftmost non-black column.\n    - Outside the box, distinct objects of each key color are scattered across the grid.\n\n    Rule:\n    - For each key color, count separate same-colored objects outside the legend box.\n    - Output the legend box repainted: each key row gets one dot per object, spaced every other cell rightward from the key pixel.\n\n    Key insight: The legend is both the color index and the output canvas — object counts become dot sequences on the matching row.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    _bg = int(get_bg(g))\n\n    black = 0\n\n    # STEP 1) Find the legend bbox: largest black CC whose bbox contains some non-black pixels.\n    best = None  # (area, bbox)\n    for coords in components_mask(g == int(black), connectivity=8):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if (sub != int(black)).any():\n            area = int(coords.shape[0])\n            cand = (area, tuple(map(int, b)))\n            if best is None or cand[0] > best[0]:\n                best = cand\n\n    assert not (best is None)\n\n    r0, c0, r1, c1 = map(int, best[1])\n    box = crop_bbox(g, (r0, c0, r1, c1))\n    bh, bw = map(int, box.shape)\n\n    # STEP 2) Inside the legend bbox, find the key column:\n    # leftmost column with any non-black pixels (the \"key pixels\").\n    key_col = None\n    for cc in range(bw):\n        if (box[:, int(cc)] != int(black)).any():\n            key_col = int(cc)\n            break\n    if key_col is None:\n        return np.zeros_like(box)\n\n    keys = [(int(rr), int(box[int(rr), int(key_col)])) for rr in range(bh) if int(box[int(rr), int(key_col)]) != int(black)]\n    keys.sort(key=lambda t: int(t[0]))\n\n    outside = np.ones((H, W), dtype=bool)\n    outside[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = False\n    out = np.zeros((bh, bw), dtype=int)\n\n    # STEP 3/4) Count CCs of each key color outside the legend, then draw 1 dot per CC.\n    for rr, col in keys:\n        mask = (g == int(col)) & outside\n        _labc, nc = label_mask(mask, connectivity=8)\n        for i in range(int(nc)):\n            cc = int(key_col + 2 * i)\n            if 0 <= cc < bw:\n                out[int(rr), int(cc)] = int(col)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette and legend color choices.\nCOLOR_POOL = tuple(range(1, 10))\nBLACK = 0\nDISTRACTOR_PROB = 0.5\n\n# Key rows and tally dimensions.\nKEY_COUNT_RANGE = (2, 4)\nTARGET_COUNT_RANGE = (1, 5)\nKEY_ROW_FIRST = 1\nKEY_ROW_STEP = 2\nKEY_COLUMN = 1\nTALLY_COL_STEP = 2\nLEGEND_HEIGHT_TAIL = 1\nLEGEND_WIDTH_TAIL = 1\nLEGEND_SLACK_RANGE = (0, 3)\n\n# Canvas size and legend placement bounds.\nGRID_HEIGHT_RANGE = (20, 25)\nGRID_WIDTH_RANGE = (20, 25)\nLEGEND_EDGE_MARGIN = 2\n\n# Sprite shape and placement constraints.\nSPRITE_AREA_RANGE = (4, 7)\nSPRITE_BBOXES = ((2, 2), (2, 3), (3, 2), (3, 3))\nSPRITE_CONNECTIVITY = 8\nSPRITE_PADDING = 1\nSPRITE_PADDING_CONNECTIVITY = 8\n\n# Retry budget for rejection sampling.\nGENERATION_ATTEMPTS = 300\n\n\ndef _randint(bounds: tuple[int, int]) -> int:\n    \"\"\"Return an inclusive randint from a configured (low, high) pair.\"\"\"\n    return random.randint(bounds[0], bounds[1])\n\n\n@lru_cache(maxsize=None)\ndef _valid_masks(h: int, w: int, area: int) -> tuple[np.ndarray, ...]:\n    \"\"\"Return connected masks that span all four sides of the sprite bbox.\"\"\"\n    masks = []\n    for cells in combinations(range(h * w), area):\n        mask = np.zeros((h, w), dtype=bool)\n        for cell in cells:\n            mask[cell // w, cell % w] = True\n        spans_edges = mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()\n        if not spans_edges:\n            continue\n        _, n = label_mask(mask, connectivity=SPRITE_CONNECTIVITY)\n        if n == 1:\n            masks.append(mask)\n    return tuple(masks)\n\n\ndef _make_sprite(color: int, bg: int) -> np.ndarray:\n    \"\"\"Sample one connected same-color sprite drawn on the background color.\"\"\"\n    area = _randint(SPRITE_AREA_RANGE)\n    dims = []\n    for h, w in SPRITE_BBOXES:\n        if h * w >= area and _valid_masks(h, w, area):\n            dims.append((h, w))\n    h, w = random.choice(dims)\n    mask = random.choice(_valid_masks(h, w, area))\n    sprite = np.full((h, w), int(bg), dtype=int)\n    sprite[mask] = int(color)\n    return sprite\n\n\ndef _sample_palette() -> tuple[int, list[int], int | None]:\n    \"\"\"Choose background, key colors, and optional distractor color.\"\"\"\n    colors = list(COLOR_POOL)\n    bg = random.choice(colors)\n\n    k = _randint(KEY_COUNT_RANGE)\n    remaining = [c for c in colors if c != bg]\n    key_colors = random.sample(remaining, k)\n    remaining = [c for c in remaining if c not in key_colors]\n    distractor_color = random.choice(remaining) if remaining and random.random() < DISTRACTOR_PROB else None\n    return bg, key_colors, distractor_color\n\n\ndef _sample_counts(k: int) -> list[int]:\n    \"\"\"Sample the target outside-component count for each key color.\"\"\"\n    return [_randint(TARGET_COUNT_RANGE) for _ in range(k)]\n\n\ndef _legend_shape(k: int, max_count: int) -> tuple[int, int]:\n    \"\"\"Return legend height and width for the key count and largest tally.\"\"\"\n    bh = KEY_ROW_STEP * k + LEGEND_HEIGHT_TAIL\n    bw = TALLY_COL_STEP * max_count + LEGEND_WIDTH_TAIL + _randint(LEGEND_SLACK_RANGE)\n    return bh, bw\n\n\ndef _key_row(i: int) -> int:\n    \"\"\"Map a zero-based key index to its row inside the legend/output box.\"\"\"\n    return KEY_ROW_FIRST + KEY_ROW_STEP * i\n\n\ndef _build_expected(key_colors: list[int], counts: list[int]) -> np.ndarray:\n    \"\"\"Render the black output tally canvas implied by key colors and counts.\"\"\"\n    max_count = max(counts)\n    bh, bw = _legend_shape(len(key_colors), max_count)\n\n    expected = np.full((bh, bw), BLACK, dtype=int)\n    for i, (color, count) in enumerate(zip(key_colors, counts)):\n        rr = _key_row(i)\n        for j in range(count):\n            expected[rr, KEY_COLUMN + TALLY_COL_STEP * j] = int(color)\n    return expected\n\n\ndef _build_legend(shape: tuple[int, int], key_colors: list[int]) -> np.ndarray:\n    \"\"\"Return a black legend patch with only the key-column pixels filled.\"\"\"\n    legend = np.full(shape, BLACK, dtype=int)\n    for i, color in enumerate(key_colors):\n        legend[_key_row(i), KEY_COLUMN] = int(color)\n    return legend\n\n\ndef _new_grid_with_legend(bg: int, legend: np.ndarray) -> np.ndarray | None:\n    \"\"\"Sample a grid and paste the legend away from all canvas edges.\"\"\"\n    bh, bw = map(int, legend.shape)\n    H = _randint(GRID_HEIGHT_RANGE)\n    W = _randint(GRID_WIDTH_RANGE)\n    min_h = bh + 2 * LEGEND_EDGE_MARGIN\n    min_w = bw + 2 * LEGEND_EDGE_MARGIN\n    if H < min_h or W < min_w:\n        return None\n\n    grid = np.full((H, W), int(bg), dtype=int)\n    r0 = random.randint(LEGEND_EDGE_MARGIN, H - bh - LEGEND_EDGE_MARGIN)\n    c0 = random.randint(LEGEND_EDGE_MARGIN, W - bw - LEGEND_EDGE_MARGIN)\n    paste(grid, legend, r0, c0)\n    return grid\n\n\ndef _build_sprite_queue(\n    key_colors: list[int],\n    counts: list[int],\n    distractor_color: int | None,\n    bg: int,\n) -> list[np.ndarray]:\n    \"\"\"Create canonical key sprites, optional distractor sprite, and shuffle them.\"\"\"\n    sprites = []\n    for color, count in zip(key_colors, counts):\n        sprite = _make_sprite(color, bg)\n        for _ in range(count):\n            sprites.append(sprite.copy())\n    if distractor_color is not None:\n        sprites.append(_make_sprite(distractor_color, bg))\n    random.shuffle(sprites)\n    return sprites\n\n\ndef _place_sprites(grid: np.ndarray, sprites: list[np.ndarray], bg: int) -> None:\n    \"\"\"Paste sprites into random non-touching free locations in queue order.\"\"\"\n    for sprite in sprites:\n        sr, sc = random_free_location(\n            grid,\n            sprite,\n            transparent=bg,\n            padding=SPRITE_PADDING,\n            padding_connectivity=SPRITE_PADDING_CONNECTIVITY,\n        )\n        paste(grid, sprite, sr, sc, transparent=bg)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Run one output-first generation attempt and reject solver mismatches.\"\"\"\n    bg, key_colors, distractor_color = _sample_palette()\n    counts = _sample_counts(len(key_colors))\n    expected = _build_expected(key_colors, counts)\n    legend = _build_legend(expected.shape, key_colors)\n    grid = _new_grid_with_legend(bg, legend)\n    if grid is None:\n        return None\n\n    sprites = _build_sprite_queue(key_colors, counts, distractor_color, bg)\n    try:\n        _place_sprites(grid, sprites, bg)\n    except ValueError:\n        return None\n\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 58490d8a input\")\n","exit_code":0,"status":"completed"}}
