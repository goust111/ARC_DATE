lixinyu/snap/new/ARC_code/eval/58490d8a.py:171:    \"\"\"Map a zero-based key index to its row inside the legend/output box.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:176:    \"\"\"Render the black output tally canvas implied by key colors and counts.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:189:    \"\"\"Return a black legend patch with only the key-column pixels filled.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:197:    \"\"\"Sample a grid and paste the legend away from all canvas edges.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:219:    \"\"\"Create canonical key sprites, optional distractor sprite, and shuffle them.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:232:    \"\"\"Paste sprites into random non-touching free locations in queue order.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:245:    \"\"\"Run one output-first generation attempt and reject solver mismatches.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:265:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/e3fe1151.py:35:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/e3fe1151.py:36:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/e3fe1151.py:55:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/e3fe1151.py:213:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:31:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:32:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:51:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:142:    \"\"\"Sample source rectangle dimensions under the output-width budget.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:202:    \"\"\"Generate one valid input grid, or None when sampled dimensions fail constraints.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:226:def generate_input() -> np.ndarray:\n","exit_code":0,"