{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/221dfab4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Propagate a repeating striped pattern from a yellow border segment toward the opposite edge, recoloring foreground objects on certain stripes.\n\n    Input structure:\n    - bg = most common color. Foreground blobs of another color scattered in the interior.\n    - A short yellow (4) segment sits on one border edge.\n\n    Rule:\n    - From the yellow segment, march toward the opposite edge in steps of 2 cells, cycling colors Y, Y, G (4, 4, 3). The 1-cell gap between stripes is forced to bg.\n    - Yellow stripes paint only within the segment's span.\n    - Green stripes additionally recolor all non-bg pixels across the entire row/column to green.\n\n    Key insight: Green stripes act as a \"flood\" that recolors existing objects on the full row/column, while yellow stripes are confined to the segment span.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n    out = g.copy()\n\n    Y = 4\n    G = 3\n\n    border = np.zeros((H, W), dtype=bool)\n    border[0, :] = True\n    border[-1, :] = True\n    border[:, 0] = True\n    border[:, -1] = True\n\n    smask = (g == int(Y)) & border\n    if not bool(smask.any()):\n        return out\n\n    lab, n = label_mask(smask, connectivity=4)\n    if int(n) <= 0:\n        return out\n\n    best_id = max(range(1, int(n) + 1), key=lambda cid: int((lab == int(cid)).sum()))\n    pts = np.argwhere(lab == int(best_id))\n\n    rs = pts[:, 0]\n    cs = pts[:, 1]\n    r0, r1 = int(rs.min()), int(rs.max())\n    c0, c1 = int(cs.min()), int(cs.max())\n\n    if r0 == r1:\n        orient = \"h\"\n        start_pos = int(r0)\n        cols = sorted(int(c) for c in cs)\n        span = list(range(int(cols[0]), int(cols[-1]) + 1))\n        dir1 = 1 if start_pos == 0 else -1\n        limit = H\n    elif c0 == c1:\n        orient = \"v\"\n        start_pos = int(c0)\n        rows = sorted(int(r) for r in rs)\n        span = list(range(int(rows[0]), int(rows[-1]) + 1))\n        dir1 = 1 if start_pos == 0 else -1\n        limit = W\n    else:\n        # Unexpected: not a straight edge segment.\n        return out\n\n    cycle = [int(Y), int(Y), int(G)]\n\n    step = 0\n    while True:\n        pos = int(start_pos) + int(dir1) * (2 * int(step))\n        if not (0 <= pos < int(limit)):\n            break\n\n        col = int(cycle[int(step) % 3])\n\n        if orient == \"h\":\n            if col == int(G):\n                out[pos, :] = np.where(out[pos, :] != int(bg), int(G), out[pos, :])\n            for c in span:\n                out[pos, int(c)] = col\n            # Force the 1-cell gap to background within the segment span.\n            gap = int(start_pos) + int(dir1) * (2 * int(step) + 1)\n            if 0 <= gap < H:\n                for c in span:\n                    out[int(gap), int(c)] = int(bg)\n        else:\n            if col == int(G):\n                out[:, pos] = np.where(out[:, pos] != int(bg), int(G), out[:, pos])\n            for r in span:\n                out[int(r), pos] = col\n            gap = int(start_pos) + int(dir1) * (2 * int(step) + 1)\n            if 0 <= gap < W:\n                for r in span:\n                    out[int(r), int(gap)] = int(bg)\n\n        step += 1\n\n    return out\n\n\n# --------------- generator ---------------\nimport random\nfrom arc_utils import random_sprite, random_free_location\n\n\ndef _gen_attempt():\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n\n    Input structure:\n    - Black background with several axis-aligned colored line drawings.\n    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n\n    Rule:\n    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n    - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n    - The color with no enclosed region is the noise/pad color.\n    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n\n    Key insight:\n    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg == 0\n\n    counts: list[tuple[int, int, np.ndarray]] = []\n    for color in colors_present(g, exclude={bg}):\n        rooms = _room_count_for_color(g, int(color))\n        walls = _walls_for_color(g, int(color))\n        counts.append((int(color), int(rooms), walls))\n\n    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n    assert drawings\n    assert len(pad_colors) == 1\n\n    pad = int(pad_colors[0])\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n        group = [item for item in drawings if item[1] == rooms]\n        ordered.extend(_cover_order(g, group))\n\n    width = max(rooms for _color, rooms, _walls in ordered)\n\n    out = np.full((len(ordered), width), pad, dtype=int)\n    for r, (color, rooms, _walls) in enumerate(ordered):\n        out[r, :rooms] = int(color)\n    return out\n\n# --------------- generator (claude-opus-4-6) ---------------\n\n# ---- CFG: Tunable generation parameters ----\n_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n    5: (25, 30, 25, 30, 16, 18),\n    4: (22, 30, 22, 30, 18, 22),\n    3: (20, 30, 20, 30, 22, 25),\n}\n_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n_OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n_GEN_RETRIES = 300                   # outer retry limit\n\n\ndef _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n","exit_code":0,"status":"completed"}}
