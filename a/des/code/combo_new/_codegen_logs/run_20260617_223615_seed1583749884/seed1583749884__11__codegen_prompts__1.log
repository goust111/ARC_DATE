{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg\nimport random\n\n\ndef _touches_edge(coords: np.ndarray, height: int, width: int) -> bool:\n    rows = coords[:, 0]\n    cols = coords[:, 1]\n    return bool(\n        np.any((rows == 0) | (rows == height - 1) | (cols == 0) | (cols == width - 1))\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, table, frame, and slot dimensions.\nCANVAS_MIN, CANVAS_MAX = 13, 19\nTABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\nROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\nAXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n\n# Object and palette sampling limits.\nN_COLORS, MAX_OBJECT_COLORS = 10, 6\nMAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\nOBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n\n# Rejection sampling cap.\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_axis_options(n_slots, slot_min, slot_max):\n    options = []\n\n    def rec_slots(i, cur):\n        if i == n_slots:\n            rec_seps(0, [], cur)\n            return\n        for size in range(slot_min, slot_max + 1):\n            rec_slots(i + 1, cur + [size])\n\n    def rec_seps(i, cur, slots):\n        if i == n_slots - 1:\n            for before in AXIS_OUTER_OPTIONS:\n                for after in AXIS_OUTER_OPTIONS:\n                    for pad_before in AXIS_PADDING_OPTIONS:\n                        for pad_after in AXIS_PADDING_OPTIONS:\n                            total = (\n                                before\n                                + after\n                                + pad_before\n                                + pad_after\n                                + sum(slots)\n                                + sum(cur)\n                            )\n                            if 13 <= total <= 19:\n                                options.append(\n                                    (\n                                        tuple(slots),\n                                        tuple(cur),\n                                        before,\n                                        after,\n                                        pad_before,\n                                        pad_after,\n                                        total,\n                                )\n                            )\n            return\n        for sep in AXIS_SEPARATOR_OPTIONS:\n            rec_seps(i + 1, cur + [sep], slots)\n\n    rec_slots(0, [])\n    return options\n\n\ndef _gen_positions(axis):\n    sizes, seps, outer_before, _outer_after, pad_before, _pad_after, _total = axis\n    starts = []\n    pos = outer_before + pad_before\n    for i, size in enumerate(sizes):\n        starts.append(pos)\n        pos += size\n        if i < len(seps):\n            pos += seps[i]\n    return starts\n\n\ndef _gen_choose_axis(n_slots, slot_min, slot_max, other_axis=None, max_object_loss=0):\n    options = _gen_axis_options(n_slots, slot_min, slot_max)\n    if other_axis is None:\n        return random.choice(options)\n\n    good = []\n    for axis in options:\n        row_axis = axis if slot_max == ROW_SLOT_SIZE_RANGE[1] else other_axis\n        col_axis = axis if slot_max == COL_SLOT_SIZE_RANGE[1] else other_axis\n        height = row_axis[-1]\n        width = col_axis[-1]\n        frame_height = height - row_axis[2] - row_axis[3]\n        frame_width = width - col_axis[2] - col_axis[3]\n        slot_area = sum(row_axis[0]) * sum(col_axis[0])\n        outer_bg = height * width - frame_height * frame_width\n        bg_room = outer_bg + slot_area - max_object_loss\n        frame_area = frame_height * frame_width - slot_area\n        if bg_room > frame_area:\n            good.append(axis)\n    return random.choice(good or options)\n\n\ndef _gen_assign_colors(shape, bg, frame):\n    n_slots = shape[0] * shape[1]\n    filled_count = random.randint(1, n_slots - 1)\n    filled = random.sample(range(n_slots), filled_count)\n    colors = [c for c in range(N_COLORS) if c not in (bg, frame)]\n    n_colors = random.randint(1, min(MAX_OBJECT_COLORS, filled_count, len(colors)))\n    palette = random.sample(colors, n_colors)\n    assignments = palette[:]\n    assignments.extend(random.choice(palette) for _ in range(filled_count - n_colors))\n    random.shuffle(assignments)\n\n    out = np.full(shape, bg, dtype=int)\n    for idx, color in zip(filled, assignments):\n        out[idx // shape[1], idx % shape[1]] = color\n    return out, filled_count\n\n\ndef _gen_object_shape(slot_h, slot_w):\n    by_area = {}\n    for obj_h in range(1, min(MAX_OBJECT_HEIGHT, slot_h - 2 * OBJECT_MARGIN) + 1):\n        for obj_w in range(1, min(MAX_OBJECT_WIDTH, slot_w - 2 * OBJECT_MARGIN) + 1):\n            by_area.setdefault(obj_h * obj_w, []).append((obj_h, obj_w))\n    area = random.choice(list(by_area))\n    return random.choice(by_area[area])\n\n\ndef _gen_choose_layout(rows, cols, filled_count):\n    row_axis = _gen_choose_axis(rows, *ROW_SLOT_SIZE_RANGE)\n    loss = MAX_OBJECT_AREA * filled_count\n    col_axis = _gen_choose_axis(cols, *COL_SLOT_SIZE_RANGE, row_axis, max_object_loss=loss)\n    return row_axis, col_axis, _gen_positions(row_axis), _gen_positions(col_axis)\n\n\ndef _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts):\n    height = row_axis[-1]\n    width = col_axis[-1]\n    grid = np.full((height, width), bg, dtype=int)\n    rt, rb = row_axis[2], row_axis[3]\n    cl, cr = col_axis[2], col_axis[3]\n    grid[rt : height - rb, cl : width - cr] = frame\n\n    for r, slot_h in zip(row_starts, row_axis[0]):\n        for c, slot_w in zip(col_starts, col_axis[0]):\n            grid[r : r + slot_h, c : c + slot_w] = bg\n    return grid\n\n\ndef _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts):\n    for out_r, slot_r in enumerate(row_starts):\n        slot_h = row_axis[0][out_r]\n        for out_c, slot_c in enumerate(col_starts):\n            color = int(out[out_r, out_c])\n            if color == bg:\n                continue\n            slot_w = col_axis[0][out_c]\n            obj_h, obj_w = _gen_object_shape(slot_h, slot_w)\n            obj_r = random.randint(slot_r + OBJECT_MARGIN, slot_r + slot_h - obj_h - OBJECT_MARGIN)\n            obj_c = random.randint(slot_c + OBJECT_MARGIN, slot_c + slot_w - obj_w - OBJECT_MARGIN)\n            grid[obj_r : obj_r + obj_h, obj_c : obj_c + obj_w] = color\n\n\ndef _gen_is_valid(grid, out, bg, frame):\n    counts = np.bincount(grid.ravel(), minlength=N_COLORS)\n    if int(np.argmax(counts)) != bg:\n        return False\n    if counts[frame] <= max(counts[c] for c in range(N_COLORS) if c not in (bg, frame)):\n        return False\n    try:\n        actual = main(grid)\n    except Exception:\n        return False\n    return bool(np.array_equal(actual, out))\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rows = random.randint(*TABLE_ROWS_RANGE)\n    cols = random.randint(*TABLE_COLS_RANGE)\n    bg, frame = random.sample(range(N_COLORS), 2)\n\n    out, filled_count = _gen_assign_colors((rows, cols), bg, frame)\n    row_axis, col_axis, row_starts, col_starts = _gen_choose_layout(rows, cols, filled_count)\n    grid = _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts)\n    _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts)\n\n    if _gen_is_valid(grid, out, bg, frame):\n        return grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid ac6f9922 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/train/278e5215.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import bbox, components_mask, crop_bbox, get_bg, paste\nimport random\nfrom itertools import product\n\n\ndef _unique_largest_non_bg_color(g: np.ndarray, bg: int) -> int:\n    counts = Counter(map(int, g.flatten()))\n    non_bg_counts = [(color, count) for color, count in counts.items() if color != int(bg)]\n    assert non_bg_counts\n\n    largest_count = max(count for _color, count in non_bg_counts)\n    candidates = [color for color, count in non_bg_counts if count == largest_count]\n    assert len(candidates) == 1\n    return int(candidates[0])\n\n\ndef _mask_bbox(g: np.ndarray, mask_color: int) -> tuple[int, int, int, int]:\n    mask = g == int(mask_color)\n    comps = components_mask(mask, connectivity=4)\n    assert len(comps) == 1\n\n    b = bbox(mask)\n    assert b is not None\n    return b\n\n\ndef _palette(g: np.ndarray, bg: int, mask_color: int, width: int) -> tuple[np.ndarray, int]:\n    palette_mask = (g != int(bg)) & (g != int(mask_color))\n    b = bbox(palette_mask)\n    assert b is not None\n\n    palette = crop_bbox(g, b)\n    assert palette.shape == (3, int(width))\n    assert bool(np.all(palette != int(bg)))\n    assert bool(np.all(palette != int(mask_color)))\n    assert bool(np.array_equal(palette[0], palette[1]))\n    assert len(set(map(int, palette[2]))) == 1\n\n    column_colors = palette[0].copy()\n    hole_color = int(palette[2, 0])\n    return column_colors, hole_color\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the large mask crop column-by-column using the separate three-row palette strip.\n\n    Input structure:\n    - The background is the most common color.\n    - One large monochrome foreground object is the mask; its bbox is the output region and may contain background holes.\n    - The remaining foreground is a 3-row palette rectangle with the same width as the mask bbox: two identical color rows and one uniform row.\n\n    Rule:\n    - Crop to the mask object's bbox.\n    - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n    - Replace background holes inside the crop with the palette's uniform third-row color.\n\n    Key insight:\n    The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    mask_color = _unique_largest_non_bg_color(g, bg)\n\n    b = _mask_bbox(g, mask_color)\n    mask_crop = crop_bbox(g == int(mask_color), b)\n    height, width = map(int, mask_crop.shape)\n\n    column_colors, hole_color = _palette(g, bg, mask_color, width)\n    out = np.tile(column_colors, (height, 1))\n    out[~mask_crop] = hole_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, colors, and object bounds.\nBACKGROUND_COLOR, MASK_COLOR = 0, 5\nCOLOR_MIN, COLOR_MAX = 1, 9\nGRID_SIDE_MIN, GRID_SIDE_MAX = 10, 18\nMASK_SIDE_MIN, MASK_SIDE_MAX = 5, 10\nPALETTE_HEIGHT = 3\nGAP_MIN, GAP_MAX = 1, 3\n\n# Palette run construction.\nRUN_COUNT_OPTIONS = (4, 5)\nRUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3\nCOLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5\nUNUSED_COLOR_BIAS = 0.7\n\n# Mask density and retry budget.\nMASK_DENSITY_MIN, MASK_DENSITY_MAX = 0.60, 0.71\nGENERATION_ATTEMPTS = 300\n\n\ndef _valid_run_lengths(width: int, n_runs: int) -> list[tuple[int, ...]]:\n    length_range = range(RUN_LENGTH_MIN, RUN_LENGTH_MAX + 1)\n    return [\n        tuple(int(x) for x in lengths)\n        for lengths in product(length_range, repeat=int(n_runs))\n        if sum(lengths) == int(width)\n    ]\n\n\ndef _run_colors(colors: list[int], n_runs: int) -> list[int]:\n    seq: list[int] = []\n    unused = set(colors)\n    for i in range(int(n_runs)):\n        slots_left = int(n_runs) - i\n        choices = [c for c in colors if not seq or c != seq[-1]]\n        if len(unused) >= slots_left:\n            choices = [c for c in choices if c in unused]\n        elif unused and random.random() < UNUSED_COLOR_BIAS:\n            preferred = [c for c in choices if c in unused]\n            if preferred:\n                choices = preferred\n        color = random.choice(choices)\n        seq.append(int(color))\n        unused.discard(int(color))\n    return seq\n\n\ndef _palette_row(width: int, colors: list[int]) -> np.ndarray:\n    valid_counts = [\n        n_runs for n_runs in RUN_COUNT_OPTIONS if _valid_run_lengths(int(width), n_runs)\n    ]\n    n_runs = random.choice(valid_counts)\n    valid_lengths = _valid_run_lengths(int(width), n_runs)\n    lengths = random.choice(valid_lengths)\n    n_distinct = random.randint(\n        COLUMN_COLOR_DISTINCT_MIN, min(COLUMN_COLOR_DISTINCT_MAX, n_runs)\n    )\n    chosen = random.sample(colors, n_distinct)\n    seq = _run_colors(chosen, n_runs)\n    return np.repeat(seq, lengths).astype(int)\n\n\ndef _neighbors4(r: int, c: int, h: int, w: int):\n    if r > 0:\n        yield r - 1, c\n    if r + 1 < h:\n        yield r + 1, c\n    if c > 0:\n        yield r, c - 1\n    if c + 1 < w:\n        yield r, c + 1\n\n\ndef _connected_mask(height: int, width: int, target_area: int) -> np.ndarray | None:\n    \"\"\"Grow a connected mask with full row/column span to the target area.\"\"\"\n    mask = np.zeros((int(height), int(width)), dtype=bool)\n    steps = [\"D\"] * (int(height) - 1) + [\"R\"] * (int(width) - 1)\n    random.shuffle(steps)\n\n    r = c = 0\n    mask[r, c] = True\n    for step in steps:\n        if step == \"D\":\n            r += 1\n        else:\n            c += 1\n        mask[r, c] = True\n\n    if int(mask.sum()) > int(target_area):\n        return None\n\n    frontier: set[tuple[int, int]] = set()\n\n    def add_frontier(rr: int, cc: int) -> None:\n        for nr, nc in _neighbors4(rr, cc, int(height), int(width)):\n            if not mask[nr, nc]:\n                frontier.add((int(nr), int(nc)))\n\n    for rr, cc in np.argwhere(mask):\n        add_frontier(int(rr), int(cc))\n\n    while int(mask.sum()) < int(target_area):\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        rr, cc = cell\n        mask[rr, cc] = True\n        add_frontier(rr, cc)\n\n    return mask\n\n\ndef _grid_choices(mask_h: int, mask_w: int, gap: int) -> list[tuple[int, int]]:\n    \"\"\"Grid sizes where the mask remains the unique largest non-bg object.\"\"\"\n    max_mask = int(np.floor(MASK_DENSITY_MAX * int(mask_h) * int(mask_w)))\n    min_h = max(GRID_SIDE_MIN, int(mask_h) + PALETTE_HEIGHT + int(gap))\n    min_w = max(GRID_SIDE_MIN, int(mask_w))\n    choices: list[tuple[int, int]] = []\n    for h in range(min_h, GRID_SIDE_MAX + 1):\n        for w in range(min_w, GRID_SIDE_MAX + 1):\n            if h * w - max_mask - PALETTE_HEIGHT * int(mask_w) > max_mask:\n                choices.append((h, w))\n    return choices\n\n\ndef _sample_dimensions() -> tuple[int, int, int, int, int] | None:\n    \"\"\"Sample mask size, layout gap, and compatible grid size.\"\"\"\n    mask_h = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)\n    mask_w = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)\n    gap = random.randint(GAP_MIN, GAP_MAX)\n    grid_choices = _grid_choices(mask_h, mask_w, gap)\n    if not grid_choices:\n        return None\n    grid_h, grid_w = random.choice(grid_choices)\n    return mask_h, mask_w, gap, grid_h, grid_w\n\n\ndef _sample_palette(mask_w: int) -> tuple[np.ndarray, int]:\n    \"\"\"Choose hole color and the same-width column palette row.\"\"\"\n    available = [c for c in range(COLOR_MIN, COLOR_MAX + 1) if c != MASK_COLOR]\n    hole_color = random.choice(available)\n    column_pool = [c for c in available if c != hole_color]\n    column_colors = _palette_row(mask_w, column_pool)\n    return column_colors, int(hole_color)\n\n\ndef _compose_grid(grid_h, grid_w, gap, mask, column_colors, hole_color) -> np.ndarray:\n    \"\"\"Paste mask and palette into disjoint row bands of a blank grid.\"\"\"\n    mask_h, mask_w = map(int, mask.shape)\n    hole_row = np.full(int(mask_w), int(hole_color), dtype=int)\n    palette = np.vstack([column_colors, column_colors, hole_row])\n    mask_sprite = np.where(mask, MASK_COLOR, BACKGROUND_COLOR)\n    grid = np.zeros((int(grid_h), int(grid_w)), dtype=int)\n    block_h = int(mask_h) + PALETTE_HEIGHT + int(gap)\n    top = random.randint(0, int(grid_h) - block_h)\n    palette_above = random.choice([True, False])\n    if palette_above:\n        palette_r = top\n        mask_r = top + PALETTE_HEIGHT + int(gap)\n    else:\n        mask_r = top\n        palette_r = top + int(mask_h) + int(gap)\n    mask_c = random.randint(0, int(grid_w) - int(mask_w))\n    palette_c = random.randint(0, int(grid_w) - int(mask_w))\n    paste(grid, mask_sprite, mask_r, mask_c, transparent=BACKGROUND_COLOR)\n    paste(grid, palette, palette_r, palette_c, transparent=None)\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    dims = _sample_dimensions()\n    if dims is None:\n        return None\n    mask_h, mask_w, gap, grid_h, grid_w = dims\n\n    column_colors, hole_color = _sample_palette(mask_w)\n    area = int(mask_h) * int(mask_w)\n    min_area = int(np.ceil(MASK_DENSITY_MIN * area))\n    max_area = int(np.floor(MASK_DENSITY_MAX * area))\n    target_area = random.randint(min_area, max_area)\n    mask = _connected_mask(mask_h, mask_w, target_area)\n    if mask is None:\n        return None\n\n    output = np.tile(column_colors, (int(mask_h), 1))\n    output[~mask] = int(hole_color)\n    mask = output != int(hole_color)\n    grid = _compose_grid(grid_h, grid_w, gap, mask, column_colors, hole_color)\n    if np.array_equal(main(grid), output):\n        return grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
