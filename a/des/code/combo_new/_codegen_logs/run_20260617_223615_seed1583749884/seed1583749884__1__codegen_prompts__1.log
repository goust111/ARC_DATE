{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/67e490f4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill holes inside a large template frame using shape-matched outside sprites.\n\n    Input structure:\n    - bg = most common color. One large monochrome frame object (template).\n    - Inside the frame: holes of various shapes (non-frame-color regions).\n    - Outside the frame: small monochrome sprites scattered on bg.\n\n    Rule:\n    - Crop to the frame's bounding box; fill entirely with frame color.\n    - For each hole, find an outside sprite whose shape matches (rotation/flip allowed).\n    - Fill the hole with the matched sprite's color. If multiple sprites match, use the most frequent color.\n\n    Key insight: Sprites act as shape-coded color keys — their shape identifies which hole they fill, their color determines the fill color.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    # STEP 1) Find the template frame: largest connected component of any non-bg color (8-connected).\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format=\"dict\")\n    assert comps\n    frame_area = max(int(comp[\"area\"]) for comp in comps)\n    frame_candidates = [comp for comp in comps if int(comp[\"area\"]) == frame_area]\n    assert len(frame_candidates) == 1\n    frame = frame_candidates[0]\n    frame_col = int(frame[\"color\"])\n    fb = frame[\"bbox\"]\n    r0, c0, r1, c1 = map(int, fb)\n\n    sub = crop_bbox(g, fb)\n    th, tw = sub.shape\n\n    # STEP 2) Extract hole components inside the bbox (anything not equal to frame color), 4-connected.\n    hole_mask = (sub != int(frame_col))\n    holes: list[tuple[tuple[tuple[int, int], bytes], tuple[int, int], np.ndarray]] = []  # (key, (r0,c0), mask)\n    for coords in components_mask(hole_mask, connectivity=4):\n        hr0, hc0, hr1, hc1 = bbox_coords(coords)\n        hh = int(hr1 - hr0 + 1)\n        ww = int(hc1 - hc0 + 1)\n        rel = coords - np.array([hr0, hc0])\n        m = np.zeros((hh, ww), dtype=bool)\n        m[rel[:, 0], rel[:, 1]] = True\n        key = (m.shape, m.tobytes())\n        holes.append((key, (int(hr0), int(hc0)), m))\n\n    # STEP 3) Extract sprites outside the bbox.\n    outside = g.copy()\n    outside[r0 : r1 + 1, c0 : c1 + 1] = int(bg)\n    spr_comps = find_components(outside, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    # key -> color -> count\n    sprites_by_key: dict[tuple[tuple[int, int], bytes], dict[int, int]] = {}\n\n    def _all_mask_keys(mask: np.ndarray):\n        \"\"\"Generate keys for all rotations (and optional vertical flip) of a boolean mask.\"\"\"\n        m0 = mask.astype(bool)\n        for flip in (False, True):\n            m1 = np.flipud(m0) if flip else m0\n            for k in range(4):\n                m2 = np.rot90(m1, k)\n                yield (m2.shape, m2.tobytes())\n\n    for comp in spr_comps:\n        coords = comp[\"coords\"]\n        bb = comp[\"bbox\"]\n        sr0, sc0, sr1, sc1 = map(int, bb)\n        hh = int(sr1 - sr0 + 1)\n        ww = int(sc1 - sc0 + 1)\n\n        vals = [int(v) for v in g[coords[:, 0], coords[:, 1]]]\n        scol = int(Counter(vals).most_common(1)[0][0])\n\n        rel = coords - np.array([sr0, sc0])\n        m = np.zeros((hh, ww), dtype=bool)\n        m[rel[:, 0], rel[:, 1]] = True\n\n        for key in _all_mask_keys(m):\n            bucket = sprites_by_key.setdefault(key, {})\n            bucket[scol] = int(bucket.get(scol, 0)) + 1\n\n    # STEP 4) Render output: start from solid frame color, then fill each hole by shape match.\n    out = np.full((th, tw), int(frame_col), dtype=int)\n    for key, (hr0, hc0), hmask in holes:\n        cmap = sprites_by_key.get(key)\n        assert cmap is not None\n        # choose the most frequent sprite color for this shape; break ties by preferring smaller color id\n        scol = max(cmap.items(), key=lambda kv: (kv[1], -kv[0]))[0]\n        patch = np.full(hmask.shape, int(scol), dtype=int)\n        paste(out, patch, int(hr0), int(hc0), mask=hmask)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# ── Configuration ──────────────────────────────────────────────────────\nNUM_COLORS = 10\nGRID_SIZE = 30\n\n# Frame bbox dimensions\nFRAME_H_RANGE = (7, 13)\nFRAME_W_RANGE = (7, 20)\n\n# Hole layout\nSHAPE_COUNT_RANGE = (3, 6)          # distinct canonical hole shapes\nMIN_SHAPES = 3                       # minimum to accept a layout\nSHAPE_MAX_AREA = 8                   # max cells per hole shape\nFRAME_DENSITY_RANGE = (0.55, 0.92)   # fraction of frame_col in frame bbox\nMIN_TOTAL_HOLES = 5                  # minimum hole instances\nPLACEMENT_RETRIES = 80               # retries per symmetric placement attempt\nMULT_EVEN_WEIGHTS = ([1, 2], [4, 1])       # (values, weights) for even-dim frames\nMULT_ODD_WEIGHTS = ([1, 2, 3], [3, 2, 1])  # (values, weights) for odd-dim frames\n\n# Sprite scattering\nWINNING_SPRITE_RANGE = (2, 5)        # winning-color sprites per hole shape\nOTHER_COLOR_MAX = 2                  # max distinct losing colors per shape\nSPRITE_PADDING = 1                   # Chebyshev separation (bg cells)\n\n# Generation retry budget\nMAX_GEN_ATTEMPTS = 300\n\n\ndef _all_rot_flip(mask: np.ndarray):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n\n    Input structure:\n    - The grid has a dominant background color.\n    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n\n    Rule:\n    - Keep the input pixels unchanged.\n    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n\n    Key insight:\n    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    out = g.copy()\n    h, w = g.shape\n\n    markers: dict[int, int] = {}\n    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n            continue\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n        source = int(sub[0, 0])\n        halo = int(sub[0, 1])\n        assert source != halo, \"legend source and halo colors must differ\"\n        assert source not in markers, \"each source color must have exactly one legend marker\"\n\n        markers[source] = halo\n        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n\n    assert markers, \"expected at least one left-edge legend marker\"\n\n    for source, halo in markers.items():\n        objects = []\n        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n            if cells <= marker_source_cells[source]:\n                continue\n            objects.append(comp)\n        assert objects, \"each legend source color must label at least one non-marker object\"\n\n        for obj in objects:\n            r0, c0, r1, c1 = obj[\"bbox\"]\n            pr0 = max(0, int(r0) - 1)\n            pc0 = max(0, int(c0) - 1)\n            pr1 = min(h - 1, int(r1) + 1)\n            pc1 = min(w - 1, int(c1) + 1)\n\n            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n            coords = obj[\"coords\"]\n            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n            enclosed = object_interior(patch, background=bg)\n            fill_mask = (patch == bg) & ~enclosed\n\n            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n            target[fill_mask] = halo\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and color palette.\nBACKGROUND = 0\nGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\nAVAILABLE_COLORS = tuple(range(1, 10))\n\n# Legend layout.\nLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\nLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n\n# Sprite geometry and acceptance.\nSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\nSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\nSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\nSPRITE_RETRIES = 300\n\n# Object counts and placement.\nINSTANCE_MIN, INSTANCE_MAX = 1, 3\nOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\nEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\nPLACEMENT_RETRIES = 200\n\n# Whole-sample retry budget.\nGENERATION_RETRIES = 300\n\n\ndef _make_sprite(color):\n","exit_code":0,"status":"completed"}}
