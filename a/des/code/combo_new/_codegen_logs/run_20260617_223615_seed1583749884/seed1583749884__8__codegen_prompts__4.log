  \"\"\"\n  35:     Delete each foreign-color object whose bounding box is contained by a larger object of another color.\n  36: \n  37:     Input structure\n  38:     - The black pixels are the empty canvas, and every other color forms one or more 8-connected monochromatic objects.\n  39:     - Some larger foreground objects act as loose U/C-like containers around smaller objects of different colors.\n  40:     Rule\n  41:     - Find all 8-connected monochromatic non-black objects.\n  42:     - Recolor an object to black exactly when its bounding box is contained in the bounding box of a larger object of another color.\n  43:     - Keep all other pixels unchanged.\n  44:     Key insight\n  45:     - The removable objects are identified by containment in another color's rectangular extent, not by their own color or shape.\n  46:     \"\"\"\n  47:     g = np.asarray(grid, dtype=int)\n  48:     assert g.ndim == 2\n  49:     assert np.any(g == 0)\n  50: \n  51:     bg = 0\n  52:     objects = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format=\"dict\")\n  53:     assert objects\n  54: \n  55:     out = g.copy()\n  56:     removed_any = False\n  57:     for obj in objects:\n  58:         contained = [\n  59:             other\n  60:             for other in objects\n  61:             if other is not obj\n  62:             and other[\"color\"] != obj[\"color\"]\n  63:             and other[\"area\"] > obj[\"area\"]\n  64:             and _bbox_contains(other[\"bbox\"], obj[\"bbox\"])\n  65:         ]\n  66:         if contained:\n  67:             assert any(_wholly_in_three_sided_cavity(other, obj) for other in contained)\n  68:             coords = obj[\"coords\"]\n  69:             out[coords[:, 0], coords[:, 1]] = bg\n  70:             removed_any = True\n  71: \n  72:     assert removed_any\n  73:     return out\n  74: \n  75: # --------------- generator (att2) ---------------\n  76: \n  77: # Canvas and palette ranges.\n  78: _GEN_SMALL_GRID_PROB = 0.18\n  79: _GEN_SMALL_GRID_SIZE_RANGE, _GEN_LARGE_GRID_SIZE_RANGE = (3, 5), (10, 15)\n  80: _GEN_PALETTE_SIZE_RANGE, _GEN_FOREGROUND_COLORS = (2, 5), range(1, 10)\n  81: # Container shape constraints and retry limits.\n  82: _GEN_CONTAINER_COUNT_PROB = 0.45\n  83: _GEN_CONTAINER_MIN_GRID_AREA, _GEN_CONTAINER_MIN_SIDE_FOR_PAIR = 36, 4\n  84: _GEN_CONTAINER_AREA_RANGE, _GEN_CONTAINER_FILL_RATIO_RANGE = (7, 21), (0.25, 0.78)\n  85: _GEN_ARCHETYPE_TRIES = 8\n  86: \n  87: # Inner object counts and size limits.\n  88: _GEN_TWO_CONTAINER_EXTRA_INNER_PROB = 0.45\n  89: _GEN_INNER_COUNT_RANGE, _GEN_INNER_AREA_MAX = (1, 2), 4\n  90: _GEN_INNER_SPRITE_TRIES = 12\n  91: # Standalone and adjacent distractor controls.\n  92: _GEN_OUTSIDE_ADJACENT_MIN_AREA, _GEN_OUTSIDE_ADJACENT_PROB = 80, 0.25\n  93: _GEN_ADJACENT_AREA_RANGE = range(2, 6)\n  94: _GEN_ADJACENT_SPRITE_SIZE_MAX, _GEN_ADJACENT_SPRITE_TRIES = (3, 4), 12\n  95: _GEN_DENSE_GRID_MIN_AREA, _GEN_DENSE_STANDALONE_PROB, _GEN_DENSE_DISTRACTOR_PROB = 120, 0.12, 0.08\n  96: _GEN_DENSE_STANDALONE_COUNT_RANGE = (6, 9)\n  97: _GEN_STANDALONE_COUNT_CHOICES, _GEN_STANDALONE_COUNT_WEIGHTS = [0, 1, 2, 3], [35, 30, 25, 10]\n  98: _GEN_SMALL_DISTRACTOR_AREA_MAX, _GEN_LARGE_DISTRACTOR_AREA_MAX = 3, 11\n  99: _GEN_DISTRACTOR_SPRITE_TRIES = 10\n 100: # Geometric thresholds and final retry limit.\n 101: _GEN_STEP_DIAGONAL_BREAK_PROB, _GEN_CAVITY_SUPPORT_MIN, _GEN_MAX_ATTEMPTS = 0.35, 3, 300\n 102: \n 103: \n 656: def generate_input() -> np.ndarray:\n 657:     for _ in range(_GEN_MAX_ATTEMPTS):\n 658:         grid = _gen_attempt()\n 659:         if grid is not None:\n 660:             return grid\n 661:     raise RuntimeError(\"failed to generate valid input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/538b439f.py =====\n 121: def main(grid: np.ndarray) -> np.ndarray:\n 122:     \"\"\"\n 123:     Reflect the solid rectangular source objects across the full separator line and color the gap with the separator color.\n 124: \n 1