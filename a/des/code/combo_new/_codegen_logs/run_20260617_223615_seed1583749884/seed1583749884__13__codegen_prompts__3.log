{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg\n\n\nSHAPE_TO_COLOR = {\n    ((0, 0), (0, 1), (1, 1)): 4,\n    ((0, 0), (0, 1), (1, 1), (1, 2)): 8,\n    ((0, 1), (1, 0), (1, 1), (1, 2), (2, 1)): 3,\n    ((0, 0), (1, 0), (2, 0)): 2,\n    ((0, 0), (1, 0)): 9,\n    ((0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (1, 2)): 5,\n}\n\n\ndef _shape_signature(coords: np.ndarray) -> tuple[tuple[int, int], ...]:\n    coords = np.asarray(coords, dtype=int)\n    shifted = coords - coords.min(axis=0)\n    return tuple(sorted((int(r), int(c)) for r, c in shifted))\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor each placeholder object according to its normalized shape while leaving the background fixed.\n\n    Input structure\n    A same-size grid with one dominant background color and one foreground\n    placeholder color forming separated 4-connected objects.\n\n    Rule\n    Replace every placeholder object by the color assigned to its exact\n    translation-normalized mask; all background pixels remain unchanged.\n\n    Key insight\n    The input objects are a shape legend with repeated instances: identical\n    masks always receive identical colors, independent of their position.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n\n    out = g.copy()\n    comps = find_components(\n        g,\n        bg=bg,\n        colors=[fg_colors[0]],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert comps\n    for comp in comps:\n        coords = comp[\"coords\"]\n        shape = _shape_signature(coords)\n        assert shape in SHAPE_TO_COLOR\n        out[tuple(coords.T)] = SHAPE_TO_COLOR[shape]\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and colors.\nGRID_H = 9\nGRID_W = 9\nBG_COLOR = 7\nFG_COLOR = 6\n\n# Object count and retry limits.\nMIN_OBJECTS = 6\nMAX_OBJECTS_EXCLUSIVE = 9\nGENERATION_RETRIES = 300\nRESERVED_PADDING = 1\n\n# Canonical shapes: (cells, height, width), in the same order used for duplicates.\nSHAPES = [\n    (((0, 0), (0, 1), (1, 1)), 2, 2),  # L-triomino -> 4\n    (((0, 0), (0, 1), (1, 1), (1, 2)), 2, 3),  # S-tetromino -> 8\n    (((0, 1), (1, 0), (1, 1), (1, 2), (2, 1)), 3, 3),  # plus -> 3\n    (((0, 0), (1, 0), (2, 0)), 3, 1),  # vertical-3 -> 2\n    (((0, 0), (1, 0)), 2, 1),  # domino -> 9\n    (((0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (1, 2)), 2, 3),  # 2x3 rect -> 5\n]\n\n\ndef _choose_shape_indices(rng):\n    \"\"\"Return all six shape ids plus 0-2 duplicate ids, then shuffle them.\"\"\"\n    num_objects = rng.integers(MIN_OBJECTS, MAX_OBJECTS_EXCLUSIVE)\n    shape_indices = list(range(len(SHAPES)))\n    num_duplicates = num_objects - len(SHAPES)\n    if num_duplicates > 0:\n        shape_indices.extend(rng.integers(0, len(SHAPES), size=num_duplicates).tolist())\n    rng.shuffle(shape_indices)\n    return shape_indices\n\n\ndef _shuffled_positions(rng, shape_h, shape_w):\n    positions = [\n        (r, c)\n        for r in range(GRID_H - shape_h + 1)\n        for c in range(GRID_W - shape_w + 1)\n    ]\n    rng.shuffle(positions)\n    return positions\n\n\ndef _reserve_bbox(occupied, r, c, shape_h, shape_w):\n    r0 = max(0, r - RESERVED_PADDING)\n    c0 = max(0, c - RESERVED_PADDING)\n    r1 = min(GRID_H, r + shape_h + RESERVED_PADDING)\n    c1 = min(GRID_W, c + shape_w + RESERVED_PADDING)\n    occupied[r0:r1, c0:c1] = True\n\n\ndef _place_shape(grid, occupied, cells, shape_h, shape_w, rng):\n    \"\"\"Place one shape at the first free candidate in a randomized scan.\"\"\"\n    for r, c in _shuffled_positions(rng, shape_h, shape_w):\n        if occupied[r:r + shape_h, c:c + shape_w].any():\n            continue\n        for dr, dc in cells:\n            grid[r + dr, c + dc] = FG_COLOR\n        _reserve_bbox(occupied, r, c, shape_h, shape_w)\n        return True\n    return False\n\n\ndef _gen_attempt():\n    rng = np.random.default_rng()\n    grid = np.full((GRID_H, GRID_W), BG_COLOR, dtype=int)\n    occupied = np.zeros((GRID_H, GRID_W), dtype=bool)\n\n    for idx in _choose_shape_indices(rng):\n        cells, shape_h, shape_w = SHAPES[idx]\n        if not _place_shape(grid, occupied, cells, shape_h, shape_w, rng):\n            return None\n\n    out = main(grid)\n    if out is None:\n        return None\n    return grid\n\n\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate input after {GENERATION_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/b7955b3c.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\nfrom arc_utils import paste\n\n\nUNKNOWN = 8\nPLUS_SHAPE = {(0, 1), (1, 0), (1, 1), (1, 2), (2, 1)}\n\n\ndef _assert_plus_masks(g: np.ndarray) -> None:\n    mask = g == UNKNOWN\n    coords = np.argwhere(mask)\n    assert coords.size, \"expected at least one color-8 mask\"\n\n    seen = np.zeros(g.shape, dtype=bool)\n    h, w = g.shape\n    for r0, c0 in coords:\n        r0 = int(r0)\n        c0 = int(c0)\n        if seen[r0, c0]:\n            continue\n\n        stack = [(r0, c0)]\n        seen[r0, c0] = True\n        comp: list[tuple[int, int]] = []\n        while stack:\n            r, c = stack.pop()\n            comp.append((r, c))\n            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):\n                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n                    seen[nr, nc] = True\n                    stack.append((nr, nc))\n\n        rs = [r for r, _ in comp]\n        cs = [c for _, c in comp]\n        top, left = min(rs), min(cs)\n        rel = {(r - top, c - left) for r, c in comp}\n        assert rel == PLUS_SHAPE, \"each color-8 component must be a 3x3 plus mask\"\n\n\ndef _component_bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:\n    rows = [r for r, _ in cells]\n    cols = [c for _, c in cells]\n    return min(rows), max(rows), min(cols), max(cols)\n\n\ndef _same_color_components(a: np.ndarray) -> list[tuple[int, list[tuple[int, int]]]]:\n    h, w = a.shape\n    seen = np.zeros(a.shape, dtype=bool)\n    components: list[tuple[int, list[tuple[int, int]]]] = []\n\n    for r0 in range(h):\n        for c0 in range(w):\n            if seen[r0, c0]:\n                continue\n\n            color = int(a[r0, c0])\n            stack = [(r0, c0)]\n            seen[r0, c0] = True\n            comp: list[tuple[int, int]] = []\n            while stack:\n                r, c = stack.pop()\n                comp.append((r, c))\n                for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):\n                    if (\n                        0 <= nr < h\n                        and 0 <= nc < w\n                        and not seen[nr, nc]\n                        and int(a[nr, nc]) == color\n                    ):\n                        seen[nr, nc] = True\n                        stack.append((nr, nc))\n\n            components.append((color, comp))\n\n    return components\n\n\ndef _background_color(a: np.ndarray) -> int:\n    colors, counts = np.unique(a, return_counts=True)\n    return int(colors[int(np.argmax(counts))])\n\n\ndef _plus_bars(g: np.ndarray) -> list[dict[str, set[tuple[int, int]]]]:\n    mask = g == UNKNOWN\n    seen = np.zeros(g.shape, dtype=bool)\n    h, w = g.shape\n    bars: list[dict[str, set[tuple[int, int]]]] = []\n\n    for r0, c0 in map(tuple, np.argwhere(mask)):\n        r0 = int(r0)\n        c0 = int(c0)\n        if seen[r0, c0]:\n            continue\n\n        stack = [(r0, c0)]\n        seen[r0, c0] = True\n        comp: list[tuple[int, int]] = []\n        while stack:\n            r, c = stack.pop()\n            comp.append((r, c))\n            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):\n                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n                    seen[nr, nc] = True\n                    stack.append((nr, nc))\n\n        rs = [r for r, _ in comp]\n        cs = [c for _, c in comp]\n        cr = (min(rs) + max(rs)) // 2\n        cc = (min(cs) + max(cs)) // 2\n        bars.append(\n            {\n                \"hbar\": {(cr, cc - 1), (cr, cc), (cr, cc + 1)},\n                \"vbar\": {(cr - 1, cc), (cr, cc), (cr + 1, cc)},\n            }\n        )\n\n    return bars\n\n\ndef _assert_mask_preserves_non_bg_extents(g: np.ndarray, out: np.ndarray) -> None:\n    mask = g == UNKNOWN\n    bg = _background_color(out)\n\n    for color, comp in _same_color_components(out):\n        if color == bg:\n            continue\n\n        hidden = [(r, c) for r, c in comp if mask[r, c]]\n        if not hidden:\n            continue\n\n        visible = [(r, c) for r, c in comp if not mask[r, c]]\n        assert visible, \"mask cannot fully cover a non-background component\"\n        assert _component_bbox(visible) == _component_bbox(comp), (\n            \"mask cannot hide the visible height or width of a non-background component\"\n        )\n\n\ndef _assert_non_bg_support_is_irregular(out: np.ndarray) -> None:\n    bg = _background_color(out)\n    support = [(int(r), int(c)) for r, c in np.argwhere(out != bg)]\n    assert support, \"expected non-background mosaic cells\"\n    r0, r1, c0, c1 = _component_bbox(support)\n    bbox_area = (r1 - r0 + 1) * (c1 - c0 + 1)\n    assert len(support) < bbox_area, \"non-background cells must form an irregular support, not a filled rectangle\"\n\n\ndef _assert_no_visible_short_side_against_plus(g: np.ndarray, out: np.ndarray) -> None:\n    mask = g == UNKNOWN\n    bars = _plus_bars(g)\n    bg = _background_color(out)\n    h, w = out.shape\n\n    for color, comp_list in _same_color_components(out):\n        if color == bg:\n            continue\n\n        comp = set(comp_list)\n        r0, r1, c0, c1 = _component_bbox(comp_list)\n        comp_h = r1 - r0 + 1\n        comp_w = c1 - c0 + 1\n        sides: list[tuple[list[tuple[int, int]], tuple[int, int], str]] = []\n        if comp_w < 3:\n            sides.append(([(r0, c) for c in range(c0, c1 + 1)], (-1, 0), \"hbar\"))\n            sides.append(([(r1, c) for c in range(c0, c1 + 1)], (1, 0), \"hbar\"))\n        if comp_h < 3:\n            sides.append(([(r, c0) for r in range(r0, r1 + 1)], (0, -1), \"vbar\"))\n            sides.append(([(r, c1) for r in range(r0, r1 + 1)], (0, 1), \"vbar\"))\n\n        for side_cells, (dr, dc), bar_name in sides:\n            if not all(cell in comp for cell in side_cells):\n                continue\n            if any(mask[r, c] for r, c in side_cells):\n                continue\n\n            adjacent = [(r + dr, c + dc) for r, c in side_cells]\n            if not all(0 <= r < h and 0 <= c < w for r, c in adjacent):\n                continue\n            assert not any(\n                all(cell in bar[bar_name] for cell in adjacent)\n                for bar in bars\n            ), \"visible side shorter than 3 cannot be fully adjacent to a plus bar\"\n\n\ndef _exact_parallel_line_fill(a: np.ndarray) -> np.ndarray:\n    out = a.copy()\n    h, w = out.shape\n\n    changed = True\n    while changed:\n        changed = False\n        for axis in (0, 1):\n            n_lines = h if axis == 0 else w\n            lines = [\n                out[i, :].copy() if axis == 0 else out[:, i].copy()\n                for i in range(n_lines)\n            ]\n\n            for i, line in enumerate(lines):\n                for pos in np.flatnonzero(line == UNKNOWN):\n                    best_support = -1\n                    best_distance = n_lines + 1\n                    best_values: set[int] = set()\n\n                    for j, other in enumerate(lines):\n                        if i == j or other[pos] == UNKNOWN:\n                            continue\n\n                        known = (line != UNKNOWN) & (other != UNKNOWN)\n                        if not np.any(known) or np.any(line[known] != other[known]):\n                            continue\n\n                        support = int(np.sum(known))\n                        distance = abs(i - j)\n                        value = int(other[pos])\n                        if support > best_support or (\n                            support == best_support and distance < best_distance\n                        ):\n                            best_support = support\n                            best_distance = distance\n                            best_values = {value}\n                        elif support == best_support and distance == best_distance:\n                            best_values.add(value)\n\n                    if len(best_values) == 1:\n                        value = next(iter(best_values))\n                        if axis == 0:\n                            out[i, pos] = value\n                        else:\n                            out[pos, i] = value\n                        changed = True\n\n    return out\n\n\ndef _opposite_pair_fill(a: np.ndarray) -> np.ndarray:\n    out = a.copy()\n    h, w = out.shape\n\n    changed = True\n    while changed:\n        changed = False\n        for r, c in map(tuple, np.argwhere(out == UNKNOWN)):\n            r = int(r)\n            c = int(c)\n            candidates: list[int] = []\n            if r > 0 and r + 1 < h and out[r - 1, c] == out[r + 1, c] != UNKNOWN:\n                candidates.append(int(out[r - 1, c]))\n            if c > 0 and c + 1 < w and out[r, c - 1] == out[r, c + 1] != UNKNOWN:\n                candidates.append(int(out[r, c - 1]))\n            if candidates and len(set(candidates)) == 1:\n                out[r, c] = candidates[0]\n                changed = True\n\n    return out\n\n\ndef _run_length(a: np.ndarray, r: int, c: int, dr: int, dc: int, color: int) -> int:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/9b30e358.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import get_bg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Repeat the bottom foreground motif upward until it fills the whole grid.\n\n    Input structure\n    - The background is the dominant color.\n    - The only foreground pixels occupy a contiguous block of rows at the bottom.\n    - That bottom block is the complete vertical motif, including its background cells.\n\n    Rule\n    - Copy the bottom motif rows repeatedly upward across the full grid.\n    - Preserve horizontal alignment and vertical phase: the original first motif row remains at its input row.\n    - The output shape is unchanged.\n\n    Key insight\n    The blank rows above the bottom foreground block are missing repetitions of the same row motif, not empty space.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    row_has_fg = np.any(g != bg, axis=1)\n    assert np.any(row_has_fg), \"expected a bottom foreground motif\"\n    top = int(np.flatnonzero(row_has_fg)[0])\n    assert top > 0, \"expected background rows above the motif\"\n    assert np.all(row_has_fg[top:]), \"motif rows must be contiguous through the bottom\"\n\n    motif = g[top:].copy()\n    motif_h = int(motif.shape[0])\n\n    out = np.empty_like(g)\n    for r in range(g.shape[0]):\n        out[r] = motif[(int(r) - top) % motif_h]\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and motif size bounds.\nHEIGHT_RANGE = (8, 14)\nWIDTH_RANGE = (5, 9)\nMOTIF_H_RANGE = (3, 6)\n# Foreground support and density limits.\nBBOX_W_RANGE = (3, 5)\nFG_DENSITY_RANGE = (0.30, 0.50)\n# Generation retry limit.\nMAX_ATTEMPTS = 300\n\ndef _sample_dims(rng) -> tuple[int, int, int, int] | None:\n    \"\"\"Return height, width, blank rows, and motif height.\"\"\"\n    motif_h = int(rng.integers(MOTIF_H_RANGE[0], MOTIF_H_RANGE[1] + 1))\n    min_h = max(HEIGHT_RANGE[0], motif_h * 2)\n    if min_h > HEIGHT_RANGE[1]:\n        return None\n    height = int(rng.integers(min_h, HEIGHT_RANGE[1] + 1))\n    width = int(rng.integers(WIDTH_RANGE[0], WIDTH_RANGE[1] + 1))\n    return height, width, height - motif_h, motif_h\n\ndef _sample_fg_cells(rng, motif_h: int, width: int, bbox_w: int) -> set[tuple[int, int]] | None:\n    \"\"\"Choose bbox-local cells while forcing every row and both bbox edges.\"\"\"\n    min_fg = max(motif_h, int(np.ceil(FG_DENSITY_RANGE[0] * motif_h * width)))\n    max_fg = min(motif_h * bbox_w, int(np.floor(FG_DENSITY_RANGE[1] * motif_h * width)))\n    if max_fg < min_fg:\n        return None\n    target_fg = int(rng.integers(min_fg, max_fg + 1))\n    selected = {(int(rng.integers(0, motif_h)), 0), (int(rng.integers(0, motif_h)), bbox_w - 1)}\n    for r in range(motif_h):\n        if not any(rr == r for rr, _ in selected):\n            selected.add((r, int(rng.integers(0, bbox_w))))\n    if len(selected) > target_fg:\n        return None\n    remaining = [\n        (r, c)\n        for r in range(motif_h)\n        for c in range(bbox_w)\n        if (r, c) not in selected\n    ]\n    need = target_fg - len(selected)\n    if need:\n        for i in rng.choice(len(remaining), size=need, replace=False):\n            selected.add(remaining[int(i)])\n    return selected\n\ndef _paint_motif(rng, motif_h: int, width: int, c0: int, selected: set[tuple[int, int]], bg: int, fg_colors: list[int]) -> np.ndarray:\n    \"\"\"Render selected bbox-local cells into a full-width motif.\"\"\"\n    motif = np.full((motif_h, width), bg, dtype=int)\n    coords = list(selected)\n    coords = [coords[int(i)] for i in rng.permutation(len(coords))]\n    for i, (r, c) in enumerate(coords):\n        if i == 0:\n            color = fg_colors[0]\n        elif i == 1:\n            color = fg_colors[1]\n        else:\n            color = int(rng.choice(fg_colors))\n        motif[r, c0 + c] = color\n    return motif\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n    dims = _sample_dims(rng)\n    if dims is None:\n        return None\n    height, width, blank_rows, motif_h = dims\n    colors = rng.choice(np.arange(10), size=3, replace=False)\n    bg = int(colors[0])\n    fg_colors = [int(colors[1]), int(colors[2])]\n    bbox_w = int(rng.integers(BBOX_W_RANGE[0], min(BBOX_W_RANGE[1], width) + 1))\n    c0 = int(rng.integers(0, width - bbox_w + 1))\n    selected = _sample_fg_cells(rng, motif_h, width, bbox_w)\n    if selected is None:\n        return None\n    motif = _paint_motif(rng, motif_h, width, c0, selected, bg, fg_colors)\n    expected = motif[(np.arange(height) - blank_rows) % motif_h]\n    inp = expected.copy()\n    inp[:blank_rows] = bg\n    if np.array_equal(main(inp), expected):\n        return inp\n    return None\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 9b30e358 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/20fb2937.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste, random_free_location\nimport random\n\n\ndef _solid_separator_row(g: np.ndarray, bg: int) -> int:\n    rows = [\n        r\n        for r in range(g.shape[0])\n        if np.all(g[r] == int(g[r, 0])) and int(g[r, 0]) != int(bg)\n    ]\n    assert len(rows) == 1, \"expected one solid non-background separator row\"\n    return int(rows[0])\n\n\ndef _legend_mapping(g: np.ndarray, sep: int, bg: int) -> tuple[dict[int, int], int]:\n    top = g[:sep]\n    comps = find_components(top, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n\n    sprites = []\n    markers = []\n    for comp in comps:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        area = int(comp[\"area\"])\n        if area == 1:\n            markers.append(comp)\n        else:\n            assert h == w and area == h * w, \"legend sprites must be filled squares\"\n            sprites.append(comp)\n\n    assert len(sprites) == len(markers) and len(sprites) > 0, \"legend must pair each sprite with one marker\"\n\n    sizes = {int(s[\"bbox\"][2] - s[\"bbox\"][0] + 1) for s in sprites}\n    assert len(sizes) == 1, \"all legend sprites must have the same size\"\n    size = sizes.pop()\n    assert size % 2 == 1, \"legend sprite size must have a center pixel\"\n\n    marker_rows = {int(m[\"coords\"][0][0]) for m in markers}\n    assert len(marker_rows) == 1, \"legend markers must lie on one row\"\n    marker_colors = [int(m[\"color\"]) for m in markers]\n    assert len(set(marker_colors)) == len(marker_colors), \"legend marker colors must be unique\"\n\n    sprites.sort(key=lambda s: (int(s[\"bbox\"][1] + s[\"bbox\"][3]), int(s[\"bbox\"][0])))\n    markers.sort(key=lambda m: (int(m[\"coords\"][0][1]), int(m[\"coords\"][0][0])))\n\n    mapping: dict[int, int] = {}\n    for sprite, marker in zip(sprites, markers):\n        _sr0, sc0, _sr1, sc1 = sprite[\"bbox\"]\n        mr, mc = map(int, marker[\"coords\"][0])\n        assert mc == (int(sc0) + int(sc1)) // 2, \"marker must align with its sprite center column\"\n        assert mr > int(sprite[\"bbox\"][2]), \"marker must sit below its sprite\"\n        mapping[int(marker[\"color\"])] = int(sprite[\"color\"])\n\n    return mapping, int(size)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace each marker below the separator with the mapped top legend square centered on that marker.\n\n    Input structure:\n    - The background surrounds a top legend, one solid non-background separator row, and a lower marker field.\n    - The legend contains equal-size filled square sprites, with a singleton marker below each sprite and aligned to its center column.\n    - The lower field contains only background and marker colors from the legend.\n\n    Rule:\n    - Pair legend markers to legend sprites by left-to-right position.\n    - Discard the legend and separator; keep the grid width and the rows below the separator.\n    - In the lower field, replace every marker pixel by a filled square of the paired sprite color, centered at the marker location.\n\n    Key insight: The top area is a positional color legend, and the actual output is the post-separator marker field expanded by that legend.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    sep = _solid_separator_row(g, bg)\n    mapping, size = _legend_mapping(g, sep, bg)\n\n    lower = g[sep + 1 :]\n    out = np.full_like(lower, bg)\n    radius = size // 2\n\n    for r, c in np.argwhere(lower != bg):\n        key = int(lower[r, c])\n        assert key in mapping, \"lower field marker must appear in the legend\"\n        r0 = int(r) - radius\n        c0 = int(c) - radius\n        r1 = r0 + size\n        c1 = c0 + size\n        assert 0 <= r0 and 0 <= c0 and r1 <= out.shape[0] and c1 <= out.shape[1], \"expanded square must fit in output\"\n        assert np.all(out[r0:r1, c0:c1] == bg), \"expanded squares must not overlap\"\n        out[r0:r1, c0:c1] = mapping[key]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and legend geometry.\nBACKGROUND_COLOR, SEPARATOR_COLOR = 7, 6\nFIELD_SHAPE = (13, 11)\nFIELD_WIDTH = FIELD_SHAPE[1]\nSQUARE_SIZE = 3\nSQUARE_RADIUS = SQUARE_SIZE // 2\nLEGEND_HEIGHT, LEGEND_MARKER_ROW, LEGEND_COLUMN_STRIDE = 6, 4, 4\n\n# Palette and object counts.\nPALETTE_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nNUM_COLOR_PAIRS, SQUARE_COUNT_CHOICES = 3, [8, 9]\n\nEMPTY, MAX_GENERATION_ATTEMPTS = 0, 300\n\n\ndef _color_pairs() -> tuple[list[int], list[int]]:\n    \"\"\"Return disjoint sprite and marker palettes in legend order.\"\"\"\n    picked = random.sample(PALETTE_COLORS, NUM_COLOR_PAIRS * 2)\n    return picked[:NUM_COLOR_PAIRS], picked[NUM_COLOR_PAIRS:]\n\n\ndef _place_centers(n: int) -> list[tuple[int, int]] | None:\n    \"\"\"Place non-overlapping 3x3 squares and return their centers.\"\"\"\n    occ = np.full(FIELD_SHAPE, EMPTY, dtype=int)\n    patch = np.ones((SQUARE_SIZE, SQUARE_SIZE), dtype=int)\n    centers: list[tuple[int, int]] = []\n    for _ in range(n):\n        try:\n            r0, c0 = random_free_location(occ, patch, transparent=EMPTY)\n        except ValueError:\n            return None\n        paste(occ, patch, r0, c0)\n        centers.append((r0 + SQUARE_RADIUS, c0 + SQUARE_RADIUS))\n    return centers\n\n\ndef _touch_graph(centers: list[tuple[int, int]]) -> list[set[int]]:\n    \"\"\"Connect square indices whose rendered 3x3 blocks share an edge.\"\"\"\n    neighbors = [set() for _ in centers]\n    for i, (r1, c1) in enumerate(centers):\n        for j, (r2, c2) in enumerate(centers[i + 1 :], start=i + 1):\n            dr = abs(r1 - r2)\n            dc = abs(c1 - c2)\n            if (dr == SQUARE_SIZE and dc < SQUARE_SIZE) or (dc == SQUARE_SIZE and dr < SQUARE_SIZE):\n                neighbors[i].add(j)\n                neighbors[j].add(i)\n    return neighbors\n\n\ndef _assign_square_ids(centers: list[tuple[int, int]]) -> list[int] | None:\n    \"\"\"Assign all color ids while preventing same-color touching squares.\"\"\"\n    neighbors = _touch_graph(centers)\n    order = list(range(len(centers)))\n    random.shuffle(order)\n    order.sort(key=lambda i: len(neighbors[i]), reverse=True)\n    ids: list[int | None] = [None] * len(centers)\n    required = set(range(NUM_COLOR_PAIRS))\n\n    def backtrack(pos: int, used: set[int]) -> bool:\n        if pos == len(order):\n            return used == required\n        if len(required - used) > len(order) - pos:\n            return False\n        i = order[pos]\n        choices = list(range(NUM_COLOR_PAIRS))\n        random.shuffle(choices)\n        for color_id in choices:\n            if any(ids[j] == color_id for j in neighbors[i]):\n                continue\n            ids[i] = color_id\n            if backtrack(pos + 1, used | {color_id}):\n                return True\n            ids[i] = None\n        return False\n\n    if not backtrack(0, set()):\n        return None\n    return [int(x) for x in ids]\n\n\ndef _build_grids(\n    centers: list[tuple[int, int]],\n    square_ids: list[int],\n    sprite_colors: list[int],\n    marker_colors: list[int],\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return an assembled input grid and the matching oracle output.\"\"\"\n    out = np.full(FIELD_SHAPE, BACKGROUND_COLOR, dtype=int)\n    lower = np.full(FIELD_SHAPE, BACKGROUND_COLOR, dtype=int)\n    for (r, c), idx in zip(centers, square_ids):\n        patch = np.full((SQUARE_SIZE, SQUARE_SIZE), sprite_colors[idx], dtype=int)\n        paste(out, patch, r - SQUARE_RADIUS, c - SQUARE_RADIUS)\n        lower[r, c] = marker_colors[idx]\n\n    legend = np.full((LEGEND_HEIGHT, FIELD_WIDTH), BACKGROUND_COLOR, dtype=int)\n    for i, (sprite, marker) in enumerate(zip(sprite_colors, marker_colors)):\n        c0 = i * LEGEND_COLUMN_STRIDE\n        legend[:SQUARE_SIZE, c0 : c0 + SQUARE_SIZE] = sprite\n        legend[LEGEND_MARKER_ROW, c0 + SQUARE_RADIUS] = marker\n\n    sep = np.full((1, FIELD_WIDTH), SEPARATOR_COLOR, dtype=int)\n    return np.vstack([legend, sep, lower]), out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    sprite_colors, marker_colors = _color_pairs()\n    n_squares = random.choice(SQUARE_COUNT_CHOICES)\n    centers = _place_centers(n_squares)\n    if centers is None:\n        return None\n    square_ids = _assign_square_ids(centers)\n    if square_ids is None:\n        return None\n\n    inp, out = _build_grids(centers, square_ids, sprite_colors, marker_colors)\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid 20fb2937 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/2e65ae53.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste, random_free_location\nimport random\n\n\ndef _dominant_foreground_color(g: np.ndarray, bg: int) -> int:\n    vals, counts = np.unique(g[g != int(bg)], return_counts=True)\n    assert vals.size > 0, \"expected foreground pixels\"\n    max_count = int(counts.max())\n    winners = vals[counts == max_count]\n    assert winners.size == 1, \"expected one largest foreground color for lattice frames\"\n    return int(winners[0])\n\n\ndef _parse_frames(g: np.ndarray, bg: int, frame_color: int) -> list[tuple[list[int], list[int]]]:\n    frames: list[tuple[list[int], list[int]]] = []\n    components = find_components(\n        g,\n        bg=int(bg),\n        colors=[int(frame_color)],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert components, \"expected at least one lattice frame\"\n\n    for comp in components:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        sub = g[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(frame_color)\n\n        row_idx = [r for r in range(sub.shape[0]) if bool(sub[r, :].all())]\n        col_idx = [c for c in range(sub.shape[1]) if bool(sub[:, c].all())]\n        assert len(row_idx) >= 2 and len(col_idx) >= 2, \"frame must divide slots\"\n        assert row_idx[0] == 0 and row_idx[-1] == sub.shape[0] - 1\n        assert col_idx[0] == 0 and col_idx[-1] == sub.shape[1] - 1\n        assert all(a + 1 < b for a, b in zip(row_idx, row_idx[1:]))\n        assert all(a + 1 < b for a, b in zip(col_idx, col_idx[1:]))\n\n        expected = np.zeros_like(sub, dtype=bool)\n        expected[row_idx, :] = True\n        expected[:, col_idx] = True\n        assert np.array_equal(sub, expected), \"frame must be a complete rectangular lattice\"\n\n        rows = [int(r0) + r for r in row_idx]\n        cols = [int(c0) + c for c in col_idx]\n        frames.append((rows, cols))\n\n    slot_rows = len(frames[0][0]) - 1\n    slot_cols = len(frames[0][1]) - 1\n    for rows, cols in frames:\n        assert len(rows) - 1 == slot_rows\n        assert len(cols) - 1 == slot_cols\n    return frames\n\n\ndef _infer_slot_colors(\n    g: np.ndarray,\n    bg: int,\n    frame_color: int,\n    frames: list[tuple[list[int], list[int]]],\n) -> dict[tuple[int, int], int]:\n    slot_rows = len(frames[0][0]) - 1\n    slot_cols = len(frames[0][1]) - 1\n    colors: dict[tuple[int, int], int] = {}\n\n    for rows, cols in frames:\n        for sr in range(slot_rows):\n            for sc in range(slot_cols):\n                region = g[rows[sr] + 1 : rows[sr + 1], cols[sc] + 1 : cols[sc + 1]]\n                marker = region[(region != int(bg)) & (region != int(frame_color))]\n                if marker.size == 0:\n                    continue\n                vals = np.unique(marker)\n                assert vals.size == 1, \"each colored slot must contain one color\"\n                color = int(vals[0])\n                key = (sr, sc)\n                assert key not in colors or colors[key] == color\n                colors[key] = color\n\n    expected = {(sr, sc) for sr in range(slot_rows) for sc in range(slot_cols)}\n    assert set(colors) == expected, \"colored slots must identify every logical slot\"\n    return colors\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill every lattice slot from the color assigned to that slot position by the other lattices.\n\n    Input structure:\n    - The background is the dominant color.\n    - The largest foreground color forms several one-pixel-thick rectangular lattice frames.\n    - The frame lines divide each lattice into the same row-by-column set of rectangular slots; some slots already contain one non-frame color.\n\n    Rule:\n    - Infer a color for each logical slot position from the colored slots across all lattice frames.\n    - Repaint every slot interior in every lattice with the inferred color for its row/column position.\n    - Keep the frame lines and all background outside frames unchanged.\n\n    Key insight:\n    - Slot sizes vary by frame, but the complete color pattern is indexed by lattice slot position rather than by absolute pixel size or location.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    frame_color = _dominant_foreground_color(g, bg)\n    frames = _parse_frames(g, bg, frame_color)\n    slot_colors = _infer_slot_colors(g, bg, frame_color, frames)\n\n    out = g.copy()\n    for rows, cols in frames:\n        for sr in range(len(rows) - 1):\n            for sc in range(len(cols) - 1):\n                out[rows[sr] + 1 : rows[sr + 1], cols[sc] + 1 : cols[sc + 1]] = slot_colors[\n                    (sr, sc)\n                ]\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Grid and palette choices.\nBG = 0\nGRID_SIZE_RANGE = (22, 28)\nNEAR_SQUARE_PROB = 0.65\nNEAR_SQUARE_DELTAS = [-2, -1, 0, 1, 2]\nFOREGROUND_COLORS = range(1, 10)\nPALETTE_SIZE = 5\n\n# Lattice geometry.\nSLOT_SIZE_RANGE = (1, 8)\nFRAME_HEIGHT_RANGE = (5, 18)\nFRAME_WIDTH_RANGE = (5, 14)\nLATTICE_LINE_COUNT = 3\nSLOT_POSITIONS = [(0, 0), (0, 1), (1, 0), (1, 1)]\n\n# Frame count and area allocation.\nFRAME_COUNT_RANGE = (4, 6)\nMIN_FRAME_AREA = 25\nAREA_BUDGET_RANGE = (0.55, 0.88)\nAREA_WEIGHT_SCALE = 35.0\n\n# Placement and retry limits.\nEDGE_BORDER = 1\nPLACEMENT_PADDING = 1\nPLACEMENT_CONNECTIVITY = 8\nMAX_GENERATION_ATTEMPTS = 300\n\nFrameSpec = tuple[tuple[int, int], tuple[int, int]]\nPlacedFrame = tuple[int, int, tuple[int, int], tuple[int, int]]\nSlotColors = dict[tuple[int, int], int]\n\n\ndef _line_indices(lengths: tuple[int, int]) -> list[int]:\n    return [0, int(lengths[0]) + 1, int(lengths[0]) + int(lengths[1]) + 2]\n\n\ndef _slot_options() -> dict[tuple[int, int], list[FrameSpec]]:\n    options: dict[tuple[int, int], list[FrameSpec]] = {}\n    slot_min, slot_max = SLOT_SIZE_RANGE\n    height_min, height_max = FRAME_HEIGHT_RANGE\n    width_min, width_max = FRAME_WIDTH_RANGE\n    for h0 in range(slot_min, slot_max + 1):\n        for h1 in range(slot_min, slot_max + 1):\n            height = h0 + h1 + LATTICE_LINE_COUNT\n            if not height_min <= height <= height_max:\n                continue\n            for w0 in range(slot_min, slot_max + 1):\n                for w1 in range(slot_min, slot_max + 1):\n                    width = w0 + w1 + LATTICE_LINE_COUNT\n                    if not width_min <= width <= width_max:\n                        continue\n                    options.setdefault((height, width), []).append(((h0, h1), (w0, w1)))\n    return options\n\n\n_SIZE_OPTIONS = _slot_options()\n\n\ndef _choose_frame_specs(n_frames: int, rows: int, cols: int) -> list[FrameSpec] | None:\n    keys = [size for size in _SIZE_OPTIONS if size[0] <= rows - 2 * EDGE_BORDER and size[1] <= cols - 2 * EDGE_BORDER]\n    random.shuffle(keys)\n\n    usable = (rows - 2 * EDGE_BORDER) * (cols - 2 * EDGE_BORDER)\n    budget = int(usable * random.uniform(*AREA_BUDGET_RANGE))\n    chosen_sizes: list[tuple[int, int]] = []\n    remaining = budget\n\n    for i in range(n_frames):\n        slots_left = n_frames - i - 1\n        candidates = [\n            size\n            for size in keys\n            if size not in chosen_sizes\n            and size[0] * size[1] <= remaining - slots_left * MIN_FRAME_AREA\n        ]\n        if not candidates:\n            return None\n        weights = []\n        target = max(MIN_FRAME_AREA, remaining / (slots_left + 1))\n        for height, width in candidates:\n            area = height * width\n            weights.append(1.0 / (1.0 + abs(area - target) / AREA_WEIGHT_SCALE))\n        size = random.choices(candidates, weights=weights, k=1)[0]\n        chosen_sizes.append(size)\n        remaining -= size[0] * size[1]\n\n    specs = [random.choice(_SIZE_OPTIONS[size]) for size in chosen_sizes]\n    specs.sort(key=lambda spec: (sum(spec[0]) + LATTICE_LINE_COUNT) * (sum(spec[1]) + LATTICE_LINE_COUNT), reverse=True)\n    return specs\n\n\ndef _choose_canvas_shape() -> tuple[int, int]:\n    grid_min, grid_max = GRID_SIZE_RANGE\n    rows = random.randint(grid_min, grid_max)\n    cols = random.randint(grid_min, grid_max)\n    if random.random() < NEAR_SQUARE_PROB:\n        delta = random.choice(NEAR_SQUARE_DELTAS)\n        cols = min(grid_max, max(grid_min, rows + delta))\n    return rows, cols\n\n\ndef _choose_palette() -> tuple[int, SlotColors]:\n    colors = random.sample(FOREGROUND_COLORS, PALETTE_SIZE)\n    frame_color = colors[0]\n    color_values = colors[1:]\n    random.shuffle(color_values)\n    slot_colors = {pos: color_values[i] for i, pos in enumerate(SLOT_POSITIONS)}\n    return frame_color, slot_colors\n\n\ndef _make_output_patch(heights: tuple[int, int], widths: tuple[int, int], frame_color: int, slot_colors: SlotColors) -> tuple[np.ndarray, list[int], list[int]]:\n    row_lines = _line_indices(heights)\n    col_lines = _line_indices(widths)\n    patch = np.zeros((row_lines[-1] + 1, col_lines[-1] + 1), dtype=int)\n    patch[row_lines, :] = int(frame_color)\n    patch[:, col_lines] = int(frame_color)\n\n    for sr, sc in SLOT_POSITIONS:\n        patch[row_lines[sr] + 1 : row_lines[sr + 1], col_lines[sc] + 1 : col_lines[sc + 1]] = slot_colors[(sr, sc)]\n    return patch, row_lines, col_lines\n\n\ndef _hint_providers(n_frames: int) -> dict[tuple[int, int], int]:\n    providers = [random.randrange(n_frames) for _ in SLOT_POSITIONS]\n    if len(set(providers)) == 1:\n        providers[random.randrange(len(providers))] = random.choice(\n            [idx for idx in range(n_frames) if idx != providers[0]]\n        )\n    return {pos: providers[i] for i, pos in enumerate(SLOT_POSITIONS)}\n\n\ndef _place_frames(rows: int, cols: int, specs: list[FrameSpec]) -> list[PlacedFrame] | None:\n    occ = np.zeros((rows, cols), dtype=int)\n    placed: list[PlacedFrame] = []\n    for heights, widths in specs:\n        height = sum(heights) + LATTICE_LINE_COUNT\n        width = sum(widths) + LATTICE_LINE_COUNT\n        block = np.ones((height, width), dtype=int)\n        try:\n            r0, c0 = random_free_location(occ, block, transparent=BG, border=EDGE_BORDER, padding=PLACEMENT_PADDING, padding_connectivity=PLACEMENT_CONNECTIVITY)\n","exit_code":0,"status":"completed"}}
