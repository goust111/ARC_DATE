.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py:23:    \"\"\"Recolor each placeholder object according to its normalized shape while leaving the background fixed.\n/home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py:36:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py:84:    \"\"\"Return all six shape ids plus 0-2 duplicate ids, then shuffle them.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py:113:    \"\"\"Place one shape at the first free candidate in a randomized scan.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py:140:def generate_input():\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:8:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:9:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:21:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:110:    \"\"\"Return an inclusive randint from a configured (low, high) pair.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:116:    \"\"\"Return connected masks that span all four sides of the sprite bbox.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:132:    \"\"\"Sample one connected same-color sprite drawn on the background color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:146:    \"\"\"Choose background, key colors, and optional distractor color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:159:    \"\"\"Sample the target outside-component count for each key color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:164:    \"\"\"Return legend height and width for the key count and largest tally.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:171:    \"\"\"Map a zero-based key index to its row inside the legend/output box.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:176:    \"\"\"Render the black output tally canvas implied by key colors and counts.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:189:    \"\"\"Return a black