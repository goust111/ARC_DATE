']\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-182-WALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-183-CARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-184-LEGEND_BUFFER = 1                          # cells of padding around legend patches\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-185-\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-186-# Regions\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-187-REGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-188-MAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-189-REGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-190-    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-191-}\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-192-BLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-193-\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-194-# Yellows\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-195-YELLOWS_PER_REGION = [1, 2]                # choices per region\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-196-MAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-197-\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-198-# Outer loop\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-199-GEN_RETRIES = 300                          # max attempts in generate_input()\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-200-\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py-201-\n/home/lixinyu/sna