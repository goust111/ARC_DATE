{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/98c475bf.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg\n\n\nLEFT_MARKER_COL = 1\n\n\ndef _glyph_cells(color: int, width: int) -> set[tuple[int, int]]:\n    left = LEFT_MARKER_COL\n    right = width - 2\n    assert right - left + 1 == 18\n\n    cells: set[tuple[int, int]] = set()\n\n    if color == 1:\n        cells.update((0, c) for c in range(left, right + 1))\n        for dr in (-1, 1):\n            cells.update({(dr, right - 4), (dr, right - 2)})\n    elif color == 2:\n        cells.update((0, c) for c in range(left, right + 1))\n        for dr in (-2, 2):\n            cells.update({(dr, left + 5), (dr, left + 7)})\n        for dr in (-1, 1):\n            cells.add((dr, left + 6))\n    elif color == 3:\n        cells.update((0, c) for c in range(left, left + 3))\n        cells.update((0, c) for c in range(left + 6, right + 1))\n        for dr in (-2, 2):\n            cells.add((dr, left + 4))\n        for dr in (-1, 1):\n            cells.update({(dr, left + 3), (dr, left + 5)})\n    elif color == 6:\n        cells.update((0, c) for c in range(left, right + 1) if c != left + 2)\n        for dr in (-2, 3):\n            cells.update((dr, c) for c in (left + 1, left + 2, left + 3))\n        for dr in (-1, 1, 2):\n            cells.update({(dr, left + 1), (dr, left + 3)})\n    elif color == 7:\n        cells.update((0, c) for c in range(left, right + 1))\n        for dr in (-2, -1, 1, 2):\n            cells.update({(dr, right - 5), (dr, right - 3)})\n    else:\n        raise AssertionError(f\"unknown glyph color: {color}\")\n\n    return cells\n\n\ndef _marker_rows(coords: np.ndarray, width: int) -> list[int] | None:\n    by_row: dict[int, list[int]] = {}\n    for r0, c0 in coords:\n        r, c = int(r0), int(c0)\n        by_row.setdefault(r, []).append(c)\n\n    right = width - 2\n    if all(sorted(cols) == [LEFT_MARKER_COL, right] for cols in by_row.values()):\n        return sorted(by_row)\n    return None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Erase the complete interior glyph and expand each endpoint marker pair into its color's full glyph.\n\n    Input structure\n    - The grid is 20x20 with background inside two same-color full-height vertical frame bars.\n    - Inside the frame there is one complete color glyph and one or more other colors appearing only as two endpoint markers in the same row.\n    - Marker endpoints are always in the first and last interior columns.\n\n    Rule\n    - Keep the vertical frame unchanged.\n    - Erase any complete interior glyph.\n    - For each endpoint marker pair, use that marker color's learned glyph template and anchor its horizontal bar on the marker row.\n\n    Key insight\n    - Color identifies which glyph shape to draw; the two endpoint pixels are not copied objects, they are anchors for reconstructing that color's full symbol.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    height, width = g.shape\n    assert (height, width) == (20, 20)\n\n    bg = get_bg(g)\n    assert bg == 0\n    frame_color = int(g[0, 0])\n    assert frame_color != bg\n    assert np.all(g[:, 0] == frame_color)\n    assert np.all(g[:, -1] == frame_color)\n    assert np.count_nonzero(g == frame_color) == 2 * height\n\n    out = g.copy()\n    marker_jobs: list[tuple[int, int]] = []\n    erased_any = False\n\n    for color0 in np.unique(g):\n        color = int(color0)\n        if color in (bg, frame_color):\n            continue\n\n        coords = np.argwhere(g == color)\n        rows = _marker_rows(coords, width)\n        if rows is not None:\n            for row in rows:\n                marker_jobs.append((color, row))\n        else:\n            assert len(coords) > 2\n            out[g == color] = bg\n            erased_any = True\n\n    assert erased_any\n    assert marker_jobs\n\n    claimed: dict[tuple[int, int], int] = {}\n    for color, anchor_row in marker_jobs:\n        for dr, c in _glyph_cells(color, width):\n            r = anchor_row + dr\n            assert 0 <= r < height\n            assert LEFT_MARKER_COL <= c <= width - 2\n            assert (r, c) not in claimed or claimed[(r, c)] == color\n            assert out[r, c] in (bg, color)\n            claimed[(r, c)] = color\n\n    for (r, c), color in claimed.items():\n        out[r, c] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\n_GEN_SIZE = 20\n_GEN_GLYPH_COLORS = [1, 2, 3, 6, 7]\n_GEN_FRAME_COLORS = (1, 2, 5, 7, 9)\n# Object counts and retry budget.\n_GEN_MARKER_COUNT_RANGE = (1, 3)\n_GEN_RETRIES = 300\n\n\ndef _gen_abs_cells(color: int, anchor_row: int) -> set[tuple[int, int]]:\n    return {(anchor_row + dr, c) for dr, c in _glyph_cells(color, _GEN_SIZE)}\n\n\ndef _gen_valid_rows(color: int) -> list[int]:\n    drs = [dr for dr, _ in _glyph_cells(color, _GEN_SIZE)]\n    return list(range(-min(drs), _GEN_SIZE - max(drs)))\n\n\ndef _gen_framed_grid(frame_color: int) -> np.ndarray:\n    grid = np.zeros((_GEN_SIZE, _GEN_SIZE), dtype=int)\n    grid[:, 0] = frame_color\n    grid[:, -1] = frame_color\n    return grid\n\n\ndef _gen_render_glyph(grid: np.ndarray, color: int, anchor_row: int) -> None:\n    for r, c in _gen_abs_cells(color, anchor_row):\n        grid[r, c] = color\n\n\ndef _gen_marker_jobs(colors: list[int], rng: np.random.Generator) -> list[tuple[int, int]] | None:\n    row_options = [_gen_valid_rows(color) for color in colors]\n    choices: list[tuple[tuple[int, ...], list[tuple[int, int]]]] = []\n\n    if len(colors) == 1:\n        for row in row_options[0]:\n            choices.append(((row,), [(colors[0], row)]))\n    else:\n        for row0 in row_options[0]:\n            cells0 = _gen_abs_cells(colors[0], row0)\n            for row1 in row_options[1]:\n                if cells0.isdisjoint(_gen_abs_cells(colors[1], row1)):\n                    choices.append(((row0, row1), [(colors[0], row0), (colors[1], row1)]))\n\n    if not choices:\n        return None\n    return choices[int(rng.integers(len(choices)))][1]\n\n\ndef _gen_example_rows(example_color: int, marker_jobs: list[tuple[int, int]]) -> list[int]:\n    marker_points = {(row, 1) for _, row in marker_jobs} | {\n        (row, _GEN_SIZE - 2) for _, row in marker_jobs\n    }\n    return [\n        row\n        for row in _gen_valid_rows(example_color)\n        if _gen_abs_cells(example_color, row).isdisjoint(marker_points)\n    ]\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    marker_count = int(rng.integers(*_GEN_MARKER_COUNT_RANGE))\n    active = list(rng.choice(_GEN_GLYPH_COLORS, size=marker_count + 1, replace=False))\n    marker_colors = active[:marker_count]\n    example_color = active[-1]\n    frame_choices = [c for c in _GEN_FRAME_COLORS if c not in active]\n    frame_color = int(rng.choice(frame_choices))\n\n    marker_jobs = _gen_marker_jobs(marker_colors, rng)\n    if marker_jobs is None:\n        return None\n\n    out = _gen_framed_grid(frame_color)\n    for color, row in marker_jobs:\n        _gen_render_glyph(out, color, row)\n\n    example_rows = _gen_example_rows(example_color, marker_jobs)\n    if not example_rows:\n        return None\n    example_row = int(rng.choice(example_rows))\n\n    inp = _gen_framed_grid(frame_color)\n    _gen_render_glyph(inp, example_color, example_row)\n    for color, row in marker_jobs:\n        inp[row, 1] = color\n        inp[row, _GEN_SIZE - 2] = color\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/8a6d367c.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/8a6d367c.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, find_components, get_bg, paste\n\n\ndef _find_frame(g: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:\n    candidates: list[tuple[int, int, tuple[int, int, int, int]]] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        color = int(comp[\"color\"])\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        if h < 3 or w < 3:\n            continue\n\n        border = np.zeros((h, w), dtype=bool)\n        border[0, :] = True\n        border[-1, :] = True\n        border[:, 0] = True\n        border[:, -1] = True\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        if int(comp[\"area\"]) == int(border.sum()) and np.array_equal(sub == color, border):\n            candidates.append((int(comp[\"area\"]), color, (r0, c0, r1, c1)))\n\n    assert candidates, \"expected one rectangular frame\"\n    max_area = max(area for area, _color, _bbox in candidates)\n    largest = [candidate for candidate in candidates if candidate[0] == max_area]\n    assert len(largest) == 1, \"rectangular frame must be structurally unique\"\n    _area, color, frame_bbox = largest[0]\n    return color, frame_bbox\n\n\ndef _templates_above_frame(g: np.ndarray, bg: int, frame_r0: int) -> list[np.ndarray]:\n    top = g[:frame_r0]\n    templates: list[np.ndarray] = []\n    for color in np.unique(top):\n        color = int(color)\n        if color == bg:\n            continue\n        coords = np.argwhere(top == color)\n        r0, c0, r1, c1 = bbox_coords(coords)\n        templates.append(top[r0 : r1 + 1, c0 : c1 + 1] == color)\n\n    assert templates, \"expected upper template masks\"\n    return templates\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the framed area by expanding the unique upper template that contains the existing seed pixels.\n\n    Input structure:\n    - A teal background contains small colored template masks above a larger rectangular frame.\n    - The frame encloses one fill color arranged as a partial block-scaled copy of one template.\n    - The frame interior dimensions are an integer square scale of the matching template bbox.\n\n    Rule:\n    - Crop to the rectangular frame.\n    - Identify the unique upper template whose block-scaled mask covers every existing fill pixel inside the frame.\n    - Reset the frame interior to background and paint the whole scaled mask with the fill color.\n\n    Key insight:\n    The lower colored pixels are seed cells that reveal which upper template should be completed inside the frame.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    frame_color, (r0, c0, r1, c1) = _find_frame(g, bg)\n\n    out = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n    interior = out[1:-1, 1:-1]\n    fill_colors = set(map(int, np.unique(interior))) - {bg, frame_color}\n    assert len(fill_colors) == 1, \"frame interior must contain exactly one fill color\"\n    fill_color = fill_colors.pop()\n\n    seed = interior == fill_color\n    assert np.any(seed), \"frame must contain seed pixels\"\n    ih, iw = seed.shape\n\n    matches: list[np.ndarray] = []\n    for template in _templates_above_frame(g, bg, r0):\n        th, tw = template.shape\n        if ih % th != 0 or iw % tw != 0:\n            continue\n        scale_h = ih // th\n        scale_w = iw // tw\n        if scale_h != scale_w:\n            continue\n\n        scaled = np.kron(template, np.ones((scale_h, scale_w), dtype=bool))\n        if np.all(~seed | scaled):\n            matches.append(scaled)\n\n    assert len(matches) == 1, \"seed pixels must select exactly one scaled template\"\n    completed = matches[0]\n    assert completed.shape == interior.shape\n\n    interior[:, :] = bg\n    interior[completed] = fill_color\n    return out\n\n# --------------- generator (att2) ---------------\n\nGEN_BG = 8\nGEN_GRID_SHAPE = (27, 21)\nGEN_TEMPLATE_SHAPES = [(3, 3), (3, 4), (4, 3)]\nGEN_TEMPLATE_COUNT_RANGE = (2, 6)\nGEN_TEMPLATE_ROW = 1\nGEN_TEMPLATE_LEFT_MIN = 1\nGEN_TEMPLATE_GAP = 1\nGEN_MAX_TEMPLATE_SPAN = 19\nGEN_DENSITY_MIN_NUM = 1\nGEN_DENSITY_MIN_DEN = 2\nGEN_DENSITY_MAX_NUM = 5\nGEN_DENSITY_MAX_DEN = 6\nGEN_SCALE_RANGE = (2, 5)\nGEN_SEED_COUNTS = (2, 3)\nGEN_SEED_FRACTION_RANGE = (0.20, 0.60)\nGEN_FRAME_ROW_GAP = 2\nGEN_FRAME_LEFT_MIN = 1\nGEN_ATTEMPTS = 300\nGEN_PALETTE = [0, 1, 2, 3, 4, 5, 6, 7, 9]\n\ndef _gen_has_full_bbox(mask: np.ndarray) -> bool:\n    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())\n\n\ndef _gen_valid_masks(th: int, tw: int) -> list[np.ndarray]:\n    n = int(th * tw)\n    lo = (GEN_DENSITY_MIN_NUM * n + GEN_DENSITY_MIN_DEN - 1) // GEN_DENSITY_MIN_DEN\n    hi = (GEN_DENSITY_MAX_NUM * n) // GEN_DENSITY_MAX_DEN\n    masks: list[np.ndarray] = []\n    for bits in range(1 << n):\n        count = int(bits.bit_count())\n        if count < lo or count > hi:\n            continue\n        flat = np.array([(bits >> k) & 1 for k in range(n)], dtype=bool)\n        mask = flat.reshape(th, tw)\n        if _gen_has_full_bbox(mask):\n            masks.append(mask)\n    return masks\n\n\ndef _gen_colored_patch(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\n    patch = np.full(mask.shape, bg, dtype=int)\n    patch[mask] = int(color)\n    return patch\n\n\ndef _gen_draw_frame(shape: tuple[int, int], bg: int, frame_color: int) -> np.ndarray:\n    patch = np.full(shape, bg, dtype=int)\n    patch[0, :] = frame_color\n    patch[-1, :] = frame_color\n    patch[:, 0] = frame_color\n    patch[:, -1] = frame_color\n    return patch\n\n\ndef _gen_frame_patch(\n    target_mask: np.ndarray,\n    seed_cells: np.ndarray,\n    scale: int,\n    bg: int,\n    frame_color: int,\n    fill_color: int,\n) -> tuple[np.ndarray, np.ndarray]:\n    th, tw = map(int, target_mask.shape)\n    scaled = np.kron(target_mask, np.ones((scale, scale), dtype=bool))\n    out = _gen_draw_frame((th * scale + 2, tw * scale + 2), bg, frame_color)\n    out[1:-1, 1:-1][scaled] = fill_color\n\n    frame = _gen_draw_frame(out.shape, bg, frame_color)\n    for r, c in seed_cells:\n        rr = int(r) * scale\n        cc = int(c) * scale\n        frame[1 + rr : 1 + rr + scale, 1 + cc : 1 + cc + scale] = fill_color\n    return frame, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n    bg = GEN_BG\n    count = int(rng.integers(*GEN_TEMPLATE_COUNT_RANGE))\n    shape_choices = [\n        shape for shape in GEN_TEMPLATE_SHAPES if count * shape[1] + count - 1 <= GEN_MAX_TEMPLATE_SPAN\n    ]\n    th, tw = shape_choices[int(rng.integers(0, len(shape_choices)))]\n    scale = int(rng.integers(*GEN_SCALE_RANGE))\n\n    valid_masks = _gen_valid_masks(th, tw)\n    if len(valid_masks) < count:\n        return None\n\n    target = valid_masks[int(rng.integers(0, len(valid_masks)))]\n    true_cells = np.argwhere(target)\n    target_area = int(len(true_cells))\n    min_seed_frac, max_seed_frac = GEN_SEED_FRACTION_RANGE\n    seed_counts = [k for k in GEN_SEED_COUNTS if min_seed_frac <= k / target_area <= max_seed_frac]\n    if not seed_counts:\n        return None\n    seed_count = int(seed_counts[int(rng.integers(0, len(seed_counts)))])\n    seed_idx = rng.choice(target_area, size=seed_count, replace=False)\n    seed_cells = true_cells[seed_idx]\n\n    covers_seed = np.array([bool(mask[seed_cells[:, 0], seed_cells[:, 1]].all()) for mask in valid_masks])\n    distractor_pool = [mask for mask, covers in zip(valid_masks, covers_seed) if not covers]\n    if len(distractor_pool) < count - 1:\n        return None\n    distractor_idx = rng.choice(len(distractor_pool), size=count - 1, replace=False)\n    distractors = [distractor_pool[int(i)] for i in distractor_idx]\n\n    masks = distractors + [target]\n    rng.shuffle(masks)\n\n    colors = list(GEN_PALETTE)\n    rng.shuffle(colors)\n    frame_color = int(colors[0])\n    fill_color = int(colors[1])\n    template_colors = [int(c) for c in colors[2 : 2 + count]]\n\n    frame, expected = _gen_frame_patch(target, seed_cells, scale, bg, frame_color, fill_color)\n    grid_h, grid_w = GEN_GRID_SHAPE\n    grid = np.full(GEN_GRID_SHAPE, bg, dtype=int)\n\n    total_template_w = count * tw + count - 1\n    template_c0 = int(rng.integers(GEN_TEMPLATE_LEFT_MIN, grid_w - total_template_w))\n    c = template_c0\n    for mask, color in zip(masks, template_colors):\n        paste(grid, _gen_colored_patch(mask, color, bg), GEN_TEMPLATE_ROW, c, transparent=bg)\n        c += tw + GEN_TEMPLATE_GAP\n\n    fh, fw = map(int, frame.shape)\n    min_r0 = th + GEN_FRAME_ROW_GAP\n    max_r0 = grid_h - fh\n    if min_r0 > max_r0:\n        return None\n    frame_r0 = int(rng.integers(min_r0, max_r0 + 1))\n    frame_c0 = int(rng.integers(GEN_FRAME_LEFT_MIN, grid_w - fw))\n    paste(grid, frame, frame_r0, frame_c0)\n\n    try:\n        if not np.array_equal(main(grid), expected):\n            return None\n    except Exception:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 8a6d367c input\")\n","exit_code":0,"status":"completed"}}
