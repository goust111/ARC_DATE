{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '35,160p' /home/lixinyu/snap/new/ARC_code/eval/faa9f03d.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repair a one-cell-thick colored line network by replacing singleton markers, filling short orthogonal gaps, and redirecting yellow-marked arms to the edge.\n\n    Input structure:\n    - A rectangular grid with a dominant background.\n    - Line colors form one-cell-thick horizontal/vertical stroke fragments.\n    - Marker colors are exactly those whose 4-connected components are all singleton pixels.\n    - Red singleton markers are missing line cells; yellow singleton markers are directional controls next to a line endpoint.\n\n    Rule:\n    - Assign every marker to the nearest visible line color in row/column line-of-sight, preferring an endpoint supported along that same axis.\n    - For each line color, fill the gap between consecutive facing endpoints in a row or column.\n    - A yellow control erases the old straight arm on the far side of its endpoint and paints the same color from that endpoint through the control pixel to the grid edge.\n    - At crossings, yellow-control rays win; otherwise an original-vs-filled crossing uses the more fragmented pre-repair line color, while pure filled crossings use the lower color id.\n\n    Key insight: The singleton markers identify which sparse stroke fragments belong together; after they are colored, the intended lines are the axis-aligned gaps between facing endpoints, with yellow controls flipping one arm to the marked side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    colors = set(map(int, g.ravel())) - {bg}\n    assert colors, \"expected foreground line and marker colors\"\n\n    marker_colors: set[int] = set()\n    for color in colors:\n        comps = components_mask(g == color, connectivity=4)\n        assert comps, \"foreground color must have at least one component\"\n        if max(len(comp) for comp in comps) == 1:\n            marker_colors.add(int(color))\n\n    line_colors = colors - marker_colors\n    assert line_colors, \"expected at least one non-marker line color\"\n    assert marker_colors, \"expected singleton marker colors\"\n\n    original = {color: _pts(g == color) for color in line_colors}\n    assignment: dict[tuple[int, int], int] = {}\n    assign_dir: dict[tuple[int, int], tuple[int, int]] = {}\n\n    marker_mask = np.isin(g, list(marker_colors))\n    for r0, c0 in _pts(marker_mask):\n        candidates: list[tuple[int, int, int, int, int]] = []\n        for dr, dc in DIRS4:\n            r, c = r0 + dr, c0 + dc\n            dist = 1\n            while 0 <= r < H and 0 <= c < W:\n                value = int(g[r, c])\n                if value in line_colors:\n                    axis = 0 if dr == 0 else 1\n                    supported = _axis_support(original[value], r, c, axis)\n                    candidates.append((dist, 0 if supported else 1, value, dr, dc))\n                    break\n                if value == bg or value in marker_colors:\n                    r += dr\n                    c += dc\n                    dist += 1\n                    continue\n                break\n\n        assert candidates, f\"marker at {(r0, c0)} cannot see a line color\"\n        candidates.sort()\n        _dist, _unsupported, color, dr, dc = candidates[0]\n        assignment[(r0, c0)] = int(color)\n        assign_dir[(r0, c0)] = (int(dr), int(dc))\n\n    masks = {color: set(pts) for color, pts in original.items()}\n    marker_pts = {color: set() for color in line_colors}\n    for pt, color in assignment.items():\n        masks[color].add(pt)\n        marker_pts[color].add(pt)\n\n    comp_count = {color: _component_count(g.shape, masks[color]) for color in line_colors}\n\n    def has_axis_support(color: int, r: int, c: int, axis: int) -> bool:\n        return (r, c) in marker_pts[color] or _axis_support(masks[color], r, c, axis)\n\n    def should_fill(color: int, a: tuple[int, int], b: tuple[int, int], axis: int) -> bool:\n        r1, c1 = a\n        r2, c2 = b\n        gap = c2 - c1 - 1 if axis == 0 else r2 - r1 - 1\n        if gap <= 0:\n            return False\n\n        a_axis = has_axis_support(color, r1, c1, axis)\n        b_axis = has_axis_support(color, r2, c2, axis)\n        if gap == 1:\n            if a_axis or b_axis:\n                return True\n            a_perp = _perp_support(masks[color], r1, c1, axis)\n            b_perp = _perp_support(masks[color], r2, c2, axis)\n            return not (a_perp and b_perp)\n\n        if (r1, c1) in marker_pts[color] and (r2, c2) in marker_pts[color]:\n            return False\n        return a_axis and b_axis\n\n    for color in sorted(line_colors):\n        additions: set[tuple[int, int]] = set()\n        for r in range(H):\n            cols = sorted(c for rr, c in masks[color] if rr == r)\n            for c1, c2 in zip(cols, cols[1:]):\n                if should_fill(color, (r, c1), (r, c2), axis=0):\n                    additions.update((r, c) for c in range(c1 + 1, c2))\n\n        for c in range(W):\n            rows = sorted(r for r, cc in masks[color] if cc == c)\n            for r1, r2 in zip(rows, rows[1:]):\n                if should_fill(color, (r1, c), (r2, c), axis=1):\n                    additions.update((r, c) for r in range(r1 + 1, r2))\n\n        masks[color].update(additions)\n\n    control_ray = {color: set() for color in line_colors}\n    if 4 in marker_colors:\n        for control in _pts(g == 4):\n            color = assignment[control]\n            dr, dc = assign_dir[control]\n\n            r, c = control[0] + dr, control[1] + dc\n            pivot: tuple[int, int] | None = None\n            while 0 <= r < H and 0 <= c < W:\n                if (r, c) in masks[color]:\n                    pivot = (r, c)\n                    break\n                r += dr\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '5,105p' /home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '5,105p' /home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Shear the rectangular input down-left onto a black canvas.\n\n    Input structure\n    A rectangular grid of colored pixels with no internal empty region to infer.\n\n    Rule\n    Create a black output with the same height and width W + H - 1, then copy\n    each input row r unchanged starting at column H - 1 - r.\n\n    Key insight\n    The colors and row contents are preserved; only the row offsets change so\n    the left edge forms a descending diagonal.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    out = np.zeros((h, w + h - 1), dtype=int)\n    for r in range(h):\n        start = h - 1 - r\n        out[r, start : start + w] = g[r]\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and palette bounds.\nMIN_HEIGHT, MAX_HEIGHT = 2, 10\nMIN_WIDTH, MAX_WIDTH = 1, 9\nMIN_COLOR_COUNT, MAX_COLOR_COUNT = 4, 5\nMAX_CELLS, MAX_OUTPUT_WIDTH = 36, 30\nPALETTE_VALUES = range(1, 10)\n\n# Fill pattern controls.\nFILL_MODES = (\"noise\", \"row_runs\", \"column_bands\", \"diagonal_bands\")\nMAX_ROW_RUN_CUTS = 3\nCOLUMN_NOISE_PROB = 0.5\nMIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND = 1, 3\nDIAGONAL_FLIP_PROB = 0.5\n\n# Generation safety.\nGENERATION_RETRIES = 300\n\n\ndef _ensure_palette_coverage(arr, palette):\n    positions = random.sample(range(arr.size), len(palette))\n    rows, cols = np.divmod(positions, arr.shape[1])\n    arr[rows, cols] = palette\n\n\ndef _fill_grid(h, w, palette):\n    k = len(palette)\n    mode = random.choice(FILL_MODES)\n    arr = np.zeros((h, w), dtype=int)\n\n    if mode == \"noise\":\n        arr[:] = np.random.choice(palette, size=(h, w))\n    elif mode == \"row_runs\":\n        for r in range(h):\n            cuts = sorted(random.sample(range(1, w), random.randint(0, min(w - 1, MAX_ROW_RUN_CUTS)))) if w > 1 else []\n            starts = [0] + cuts\n            ends = cuts + [w]\n            last = None\n            for c0, c1 in zip(starts, ends):\n                choices = [c for c in palette if c != last] or list(palette)\n                last = random.choice(choices)\n                arr[r, c0:c1] = last\n    elif mode == \"column_bands\":\n        for c in range(w):\n            arr[:, c] = random.choice(palette)\n        if random.random() < COLUMN_NOISE_PROB:\n            for r in range(h):\n                arr[r, random.randrange(w)] = random.choice(palette)\n    else:\n        band = random.randint(MIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND)\n        phase = random.randrange(k)\n        rows, cols = np.indices((h, w))\n        arr[:] = np.asarray(palette)[((rows + cols) // band + phase) % k]\n        if random.random() < DIAGONAL_FLIP_PROB:\n            arr = np.fliplr(arr)\n\n    _ensure_palette_coverage(arr, palette)\n    return arr\n\n\ndef _gen_attempt():\n    k = random.randint(MIN_COLOR_COUNT, MAX_COLOR_COUNT)\n    h = random.randint(MIN_HEIGHT, MAX_HEIGHT)\n    widths = [\n        w\n        for w in range(MIN_WIDTH, MAX_WIDTH + 1)\n        if h * w >= k and h * w <= MAX_CELLS and w + h - 1 <= MAX_OUTPUT_WIDTH\n    ]\n    if not widths:\n        return None\n    w = random.choice(widths)\n    palette = random.sample(PALETTE_VALUES, k)\n    return _fill_grid(h, w, palette)\n\n\n","exit_code":0,"status":"completed"}}
