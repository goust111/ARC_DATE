are validation failures.\n0084: MAX_GENERATION_ATTEMPTS = 300\n0085: \n0086: \n0087: def _pattern_tiles(csize: int, lattice: int, sep: int) -> dict[int, np.ndarray]:\n0088:     \"\"\"Build one structured tile per lattice diagonal, or {} if validation fails.\"\"\"\n0089:     colors = [c for c in range(COLOR_COUNT) if c != sep]\n0090:     random.shuffle(colors)\n0091:     palette = colors[: random.randint(PATTERN_TILE_MIN_COLORS, len(colors))]\n0092:     palette_arr = np.asarray(palette, dtype=int)\n0093:     k = len(palette)\n0094: \n0095:     rr, cc = np.indices((csize, csize))\n0096:     base = (rr + cc + random.randrange(k)) % k\n0097:     if random.choice([False, True]):\n0098:         base = base.T\n0099:     if random.choice([False, True]):\n0100:         base = np.fliplr(base)\n0101:     if random.choice([False, True]):\n0102:         base = np.flipud(base)\n0103:     tiles = {}\n0104:     for diag in range(2 * lattice - 1):\n0105:         tile_idx = (base + random.randrange(k)) % k\n0106:         tile = palette_arr[tile_idx]\n0107:         # Encode the diagonal id in four cells so variants are guaranteed distinct.\n0108:         for bit in range(DIAGONAL_ID_BITS):\n0109:             tile.flat[bit] = palette[(diag >> bit) & 1]\n0110:         if len(np.unique(tile)) < PATTERN_TILE_MIN_COLORS:\n0111:             return {}\n0112:         tiles[diag] = tile\n0113:     return tiles\n0114: \n0115: \n0116: def _sample_solid_block(lattice, colors):\n0117:     \"\"\"Return ((row, col, height, width), output colors) for the solid block.\"\"\"\n0118:     solid_h = random.randint(*SOLID_SIZE_RANGE)\n0119:     solid_w = random.randint(*SOLID_SIZE_RANGE)\n0120:     solid_r0 = random.randint(0, lattice - solid_h)\n0121:     solid_c0 = random.randint(0, lattice - solid_w)\n0122:     flat = np.random.choice(colors, size=solid_h * solid_w).astype(int)\n0123:     if len(set(map(int, flat))) == 1:\n0124:         change_at = random.randrange(len(flat))\n0125:         flat[change_at] = random.choice([c for c in colors if c != int(flat[change_at])])\n0126:     return (solid_r0, solid_c0, solid_h, solid_w), flat.reshape((solid_h, solid_w))\n0127: \n0128: \n0129: def _render_grid(lattice, csize, sep, block, out, tiles):\n0130:     \"\"\"Assemble the separator lattice from solid cells and pattern tiles.\"\"\"\n0131:     n = lattice * csize + (lattice - 1)\n0132:     grid = np.full((n, n), sep, dtype=int)\n0133:     solid_r0, solid_c0, solid_h, solid_w = block\n0134:     stride = csize + SEPARATOR_WIDTH\n0135:     for ri in range(lattice):\n0136:         for ci in range(lattice):\n0137:             r0, c0 = ri * stride, ci * stride\n0138:             if solid_r0 <= ri < solid_r0 + solid_h and solid_c0 <= ci < solid_c0 + solid_w:\n0139:                 cell = np.full((csize, csize), int(out[ri - solid_r0, ci - solid_c0]), dtype=int)\n0140:             else:\n0141:                 cell = tiles[(ri - ci) % (2 * lattice - 1)]\n0142:             paste(grid, cell, r0, c0)\n0143:     return grid\n0144: \n0145: \n0146: def _valid_generated_grid(grid, lattice, csize, sep, block):\n0147:     \"\"\"Check separator lines and non-solid cells before the solver oracle.\"\"\"\n0148:     stride = csize + SEPARATOR_WIDTH\n0149:     sep_lines = [csize + i * stride for i in range(lattice - 1)]\n0150:     if not all(np.all(grid[r, :] == sep) and np.all(grid[:, r] == sep) for r in sep_lines):\n0151:         return False\n0152:     solid_r0, solid_c0, solid_h, solid_w = block\n0153:     for ri in range(lattice):\n0154:         for ci in range(lattice):\n0155:             if solid_r0 <= ri < solid_r0 + solid_h and solid_c0 <= ci < solid_c0 + solid_w:\n0156:                 continue\n0157:             r0, c0 = ri * stride, ci * stride\n0158:             if len(np.unique(grid[r0 : r0 + csize, c0 : c0 + csize])) < PATTERN_CELL_MIN_COLORS:\n...\n0174:     try:\n0175:         if not np.array_equal(main(grid), out):\n0176:             return None\n0177:     except AssertionError:\n0178:         return None\n0179:     return grid\n0180: \n0181: \n0182: def generate_input() -> np.ndarray:\n0183:     for _ in range(MAX_GENERATION_ATTEMPTS):\n0184:         grid = _gen_attempt()\n0185:         if grid is not None:\n0186:             return grid\n0187:     raise RuntimeError(\"failed to generate valid 458e3a53 input\")\n===== /home/lixinyu/snap/new/ARC_code/train/da6e95e5.py =====\n0061:     return (\n0062:         outer_r0 <= r0 <= r1 <= outer_r1\n0063:         and outer_c0 <= c0 <= c1 <= outer_c1\n0064:         and nw[\"cr2\"] < center[\"cr2\"] < sw[\"cr2\"]\n0065:         and nw[\"cc2\"] < center[\"cc2\"] < ne[\"cc2\"]\n0066:     )\n0067: \n0068: \n0069: def main(grid: np.ndarray) -> np.ndarray:\n0070:     \"\"\"Extract the central object from the marker cluster whose markers have the same color.\n0071: \n0072:     Input structure\n0073:     The grid has a dominant background and several clusters; each cluster has four\n0074:     same-color corner marker objects around one central monochromatic object.\n0075:     Rule\n0076:     Find every central object enclosed by four aligned corner markers of one color,\n0077:     then choose the unique one whose object color equals the marker color.\n0078:     Key insight\n0079:     The answer is not the largest or most frequent object; it is the center of the\n0080:     self-colored cluster, cropped to that object's bounding box with background kept.\n0081:     \"\"\"\n0082:     g = np.asarray(grid, dtype=int)\n0083:     bg = get_bg(g)\n0084:     comps = _record_components(g, bg)\n0085: \n0086:     targets = {}\n0087:     for center in comps:\n0088:         by_marker_role = defaultdict(lambda: defaultdict(list))\n0089:         for marker in comps:\n0090:             if marker[\"id\"] == center[\"id\"]:\n0091:                 continue\n0092:             if marker[\"cr2\"] == center[\"cr2\"] or marker[\"cc2\"] == center[\"cc2\"]:\n0093:                 continue\n0094:             quad = (\n0095:        