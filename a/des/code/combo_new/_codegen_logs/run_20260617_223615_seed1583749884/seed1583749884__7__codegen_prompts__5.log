g colors\n0161: COLOR_POOL = [0, 1, 3, 5, 6, 7, 8, 9]  # non-red, non-bg candidate colors\n0162: \n0163: # --- Target anchor parameters ---\n0164: TARGET_SIZE_RANGE = (1, 4)              # anchor size range for non-TL quadrants\n0165: \n0166: # --- Generation retry limit ---\n0167: MAX_RETRIES = 300\n0168: \n0169: \n0170: def _resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:\n0171:     \"\"\"Nearest-neighbor resize supporting fractional scale ratios.\"\"\"\n0172:     src_h, src_w = img.shape\n0173:     rr = np.clip(np.floor(np.arange(new_h) * src_h / new_h).astype(int), 0, src_h - 1)\n0174:     cc = np.clip(np.floor(np.arange(new_w) * src_w / new_w).astype(int), 0, src_w - 1)\n0175:     return img[rr[:, None], cc[None, :]]\n0176: \n0177: \n0178: def _scaled_patch(patch: np.ndarray, qb: int, qr: int, target_size: int) -> np.ndarray:\n0179:     \"\"\"Reflect and scale the source patch for a given quadrant and target anchor size.\"\"\"\n0180:     p = patch\n0181:     if qr:\n0182:         p = np.fliplr(p)\n0183:     if qb:\n0184:         p = np.flipud(p)\n0185:     ratio = target_size / SOURCE_ANCHOR_SIZE\n0186:     h = max(1, int(round(p.shape[0] * ratio)))\n0187:     w = max(1, int(round(p.shape[1] * ratio)))\n0188:     return _resize_nn(p, h, w)\n0189: \n0190: \n0191: def _grow_4conn(h: int, w: int, seeds: set[tuple[int, int]], n_fill: int) -> set[tuple[int, int]]:\n0192:     \"\"\"Grow a 4-connected region from seeds until it has n_fill cells.\"\"\"\n0193:     filled = set(seeds)\n0194:     frontier = set()\n0195:     for r, c in seeds:\n0196:         for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n0197:             nr, nc = r + dr, c + dc\n0198:             if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:\n0199:                 frontier.add((nr, nc))\n0200:     while len(filled) < n_fill and frontier:\n0201:         cell = random.choice(list(frontier))\n0202:         filled.add(cell)\n0203:         frontier.discard(cell)\n0204:       