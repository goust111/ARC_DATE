{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\npath = Path('/home/lixinyu/snap/new/ARC_code/train/da6e95e5.py')\nlines = path.read_text().splitlines()\nfor start,end in [(1,170),(170,330)]:\n    print(f'===== lines {start}-{end} =====')\n    for i in range(start,end+1):\n        if i<=len(lines):\n            print(f'{i:04d}: {lines[i-1]}')\nPY\"","aggregated_output":"===== lines 1-170 =====\n0001: from itertools import product\n0002: from collections import defaultdict\n0003: \n0004: import numpy as np\n0005: \n0006: from arc_utils import find_components, get_bg, paste, random_free_location\n0007: import random\n0008: \n0009: \n0010: QUADS = ((0, 0), (0, 1), (1, 0), (1, 1))\n0011: \n0012: \n0013: def _record_components(g: np.ndarray, bg: int) -> list[dict]:\n0014:     comps = []\n0015:     for idx, comp in enumerate(\n0016:         find_components(g, bg=bg, connectivity=8, monochromatic=True)\n0017:     ):\n0018:         r0, c0, r1, c1 = comp[\"bbox\"]\n0019:         comps.append(\n0020:             {\n0021:                 **comp,\n0022:                 \"id\": idx,\n0023:                 \"h\": r1 - r0 + 1,\n0024:                 \"w\": c1 - c0 + 1,\n0025:                 \"cr2\": r0 + r1,\n0026:                 \"cc2\": c0 + c1,\n0027:             }\n0028:         )\n0029:     return comps\n0030: \n0031: \n0032: def _bbox(comp: dict) -> tuple[int, int, int, int]:\n0033:     return comp[\"bbox\"]\n0034: \n0035: \n0036: def _aligned_markers(markers: tuple[dict, dict, dict, dict]) -> bool:\n0037:     bnw, bne, bsw, bse = map(_bbox, markers)\n0038:     return (\n0039:         (bnw[0], bnw[2]) == (bne[0], bne[2])\n0040:         and (bsw[0], bsw[2]) == (bse[0], bse[2])\n0041:         and (bnw[1], bnw[3]) == (bsw[1], bsw[3])\n0042:         and (bne[1], bne[3]) == (bse[1], bse[3])\n0043:         and bnw[2] < bsw[0]\n0044:         and bne[2] < bse[0]\n0045:         and bnw[3] < bne[1]\n0046:         and bsw[3] < bse[1]\n0047:     )\n0048: \n0049: \n0050: def _is_cluster(center: dict, markers: tuple[dict, dict, dict, dict]) -> bool:\n0051:     nw, ne, sw, _ = markers\n0052:     if not _aligned_markers(markers):\n0053:         return False\n0054: \n0055:     r0, c0, r1, c1 = _bbox(center)\n0056:     outer_r0 = min(_bbox(marker)[0] for marker in markers)\n0057:     outer_c0 = min(_bbox(marker)[1] for marker in markers)\n0058:     outer_r1 = max(_bbox(marker)[2] for marker in markers)\n0059:     outer_c1 = max(_bbox(marker)[3] for marker in markers)\n0060: \n0061:     return (\n0062:         outer_r0 <= r0 <= r1 <= outer_r1\n0063:         and outer_c0 <= c0 <= c1 <= outer_c1\n0064:         and nw[\"cr2\"] < center[\"cr2\"] < sw[\"cr2\"]\n0065:         and nw[\"cc2\"] < center[\"cc2\"] < ne[\"cc2\"]\n0066:     )\n0067: \n0068: \n0069: def main(grid: np.ndarray) -> np.ndarray:\n0070:     \"\"\"Extract the central object from the marker cluster whose markers have the same color.\n0071: \n0072:     Input structure\n0073:     The grid has a dominant background and several clusters; each cluster has four\n0074:     same-color corner marker objects around one central monochromatic object.\n0075:     Rule\n0076:     Find every central object enclosed by four aligned corner markers of one color,\n0077:     then choose the unique one whose object color equals the marker color.\n0078:     Key insight\n0079:     The answer is not the largest or most frequent object; it is the center of the\n0080:     self-colored cluster, cropped to that object's bounding box with background kept.\n0081:     \"\"\"\n0082:     g = np.asarray(grid, dtype=int)\n0083:     bg = get_bg(g)\n0084:     comps = _record_components(g, bg)\n0085: \n0086:     targets = {}\n0087:     for center in comps:\n0088:         by_marker_role = defaultdict(lambda: defaultdict(list))\n0089:         for marker in comps:\n0090:             if marker[\"id\"] == center[\"id\"]:\n0091:                 continue\n0092:             if marker[\"cr2\"] == center[\"cr2\"] or marker[\"cc2\"] == center[\"cc2\"]:\n0093:                 continue\n0094:             quad = (\n0095:                 0 if marker[\"cr2\"] < center[\"cr2\"] else 1,\n0096:                 0 if marker[\"cc2\"] < center[\"cc2\"] else 1,\n0097:             )\n0098:             key = (marker[\"color\"], marker[\"area\"], marker[\"h\"], marker[\"w\"])\n0099:             by_marker_role[key][quad].append(marker)\n0100: \n0101:         for key, markers_by_quad in by_marker_role.items():\n0102:             if not all(quad in markers_by_quad for quad in QUADS):\n0103:                 continue\n0104:             for markers in product(*(markers_by_quad[quad] for quad in QUADS)):\n0105:                 if len({marker[\"id\"] for marker in markers}) != 4:\n0106:                     continue\n0107:                 if _is_cluster(center, markers) and center[\"color\"] == key[0]:\n0108:                     targets[center[\"id\"]] = center\n0109: \n0110:     assert len(targets) == 1\n0111:     target = next(iter(targets.values()))\n0112:     r0, c0, r1, c1 = _bbox(target)\n0113:     out = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n0114:     assert np.all((out == bg) | (out == target[\"color\"]))\n0115:     return out\n0116: \n0117: # --------------- generator (att2) ---------------\n0118: \n0119: # Canvas, palette, and placement.\n0120: GRID_SHAPE = (30, 30)\n0121: COLOR_COUNT = 10\n0122: PLACEMENT_BORDER = 1\n0123: \n0124: # Cluster structure and shared center bbox ranges.\n0125: MARKER_SIZES = (2, 3)\n0126: CENTER_BOUNDS_BY_MARKER = {\n0127:     2: ((2, 4), (2, 5)),\n0128:     3: ((3, 4), (3, 5)),\n0129: }\n0130: CLUSTER_COUNT_RANGE = (4, 6)\n0131: CENTER_OFFSET = 2\n0132: \n0133: # Center sprite area and retry bounds.\n0134: MIN_CENTER_AREA = 3\n0135: MAX_CENTER_AREA = 14\n0136: GEN_ATTEMPTS = 300\n0137: \n0138: \n0139: def _gen_l_marker(marker_size: int, color: int, bg: int) -> np.ndarray:\n0140:     marker = np.full((marker_size, marker_size), bg, dtype=int)\n0141:     marker[0, :] = color\n0142:     marker[:, 0] = color\n0143:     return marker\n0144: \n0145: \n0146: def _gen_center_mask(height: int, width: int, area: int) -> np.ndarray:\n0147:     mask = np.zeros((height, width), dtype=bool)\n0148:     if random.randrange(2):\n0149:         r, c, end_r, end_c = 0, 0, height - 1, width - 1\n0150:     else:\n0151:         r, c, end_r, end_c = 0, width - 1, height - 1, 0\n0152: \n0153:     mask[r, c] = True\n0154:     while (r, c) != (end_r, end_c):\n0155:         if r < end_r:\n0156:             r += 1\n0157:         elif r > end_r:\n0158:             r -= 1\n0159:         if c < end_c:\n0160:             c += 1\n0161:         elif c > end_c:\n0162:             c -= 1\n0163:         mask[r, c] = True\n0164: \n0165:     while int(mask.sum()) < area:\n0166:         candidates = set()\n0167:         for rr, cc in np.argwhere(mask):\n0168:             for dr in (-1, 0, 1):\n0169:                 for dc in (-1, 0, 1):\n0170:                     if dr == 0 and dc == 0:\n===== lines 170-330 =====\n0170:                     if dr == 0 and dc == 0:\n0171:                         continue\n0172:                     nr, nc = int(rr) + dr, int(cc) + dc\n0173:                     if 0 <= nr < height and 0 <= nc < width and not mask[nr, nc]:\n0174:                         candidates.add((nr, nc))\n0175:         nr, nc = random.choice(tuple(candidates))\n0176:         mask[nr, nc] = True\n0177:     return mask\n0178: \n0179: \n0180: def _gen_center_patch(height: int, width: int, color: int, bg: int) -> np.ndarray:\n0181:     min_area = max(MIN_CENTER_AREA, height, width)\n0182:     max_area = min(MAX_CENTER_AREA, height * width - 1)\n0183:     area = random.randint(min_area, max_area)\n0184:     patch = np.full((height, width), bg, dtype=int)\n0185:     patch[_gen_center_mask(height, width, area)] = color\n0186:     return patch\n0187: \n0188: \n0189: def _gen_cluster_patch(\n0190:     marker_size: int,\n0191:     center_height: int,\n0192:     center_width: int,\n0193:     marker_color: int,\n0194:     center_color: int,\n0195:     bg: int,\n0196: ) -> tuple[np.ndarray, np.ndarray]:\n0197:     overlap = marker_size - 2\n0198:     center_r0 = CENTER_OFFSET\n0199:     center_c0 = CENTER_OFFSET\n0200:     bottom_r0 = center_r0 + center_height - overlap\n0201:     right_c0 = center_c0 + center_width - overlap\n0202:     patch = np.full((bottom_r0 + marker_size, right_c0 + marker_size), bg, dtype=int)\n0203: \n0204:     marker = _gen_l_marker(marker_size, marker_color, bg)\n0205:     paste(patch, marker, 0, 0, transparent=bg)\n0206:     paste(patch, np.fliplr(marker), 0, right_c0, transparent=bg)\n0207:     paste(patch, np.flipud(marker), bottom_r0, 0, transparent=bg)\n0208:     paste(patch, np.flipud(np.fliplr(marker)), bottom_r0, right_c0, transparent=bg)\n0209: \n0210:     center = _gen_center_patch(center_height, center_width, center_color, bg)\n0211:     paste(patch, center, center_r0, center_c0, transparent=bg)\n0212:     return patch, center\n0213: \n0214: \n0215: def _place_cluster_patches(patches: list[np.ndarray], bg: int) -> np.ndarray | None:\n0216:     grid = np.full(GRID_SHAPE, bg, dtype=int)\n0217:     occupied = np.zeros(GRID_SHAPE, dtype=int)\n0218:     n_clusters = len(patches)\n0219:     order = list(range(n_clusters))\n0220:     random.shuffle(order)\n0221:     try:\n0222:         for idx in order:\n0223:             patch = patches[idx]\n0224:             h, w = patch.shape\n0225:             rect = np.ones((h, w), dtype=int)\n0226:             r0, c0 = random_free_location(\n0227:                 occupied, rect, transparent=0, border=PLACEMENT_BORDER\n0228:             )\n0229:             occupied[r0 : r0 + h, c0 : c0 + w] = 1\n0230:             paste(grid, patch, r0, c0, transparent=bg)\n0231:     except ValueError:\n0232:         return None\n0233:     return grid\n0234: \n0235: \n0236: def _solves_to_expected(grid: np.ndarray, expected: np.ndarray) -> bool:\n0237:     try:\n0238:         solved = main(grid)\n0239:     except AssertionError:\n0240:         return False\n0241:     return np.array_equal(solved, expected)\n0242: \n0243: \n0244: def _gen_attempt() -> np.ndarray | None:\n0245:     bg = random.randrange(COLOR_COUNT)\n0246:     marker_size = random.choice(MARKER_SIZES)\n0247:     height_bounds, width_bounds = CENTER_BOUNDS_BY_MARKER[marker_size]\n0248:     center_height = random.randint(height_bounds[0], height_bounds[1])\n0249:     center_width = random.randint(width_bounds[0], width_bounds[1])\n0250: \n0251:     n_clusters = random.randint(CLUSTER_COUNT_RANGE[0], CLUSTER_COUNT_RANGE[1])\n0252:     palette = [color for color in range(COLOR_COUNT) if color != bg]\n0253:     colors = random.sample(palette, n_clusters + 1)\n0254:     marker_colors = colors[:n_clusters]\n0255:     extra_center_color = colors[-1]\n0256:     target_idx = random.randrange(n_clusters)\n0257:     extra_idx = random.choice([idx for idx in range(n_clusters) if idx != target_idx])\n0258: \n0259:     patches = []\n0260:     expected = None\n0261:     for idx, marker_color in enumerate(marker_colors):\n0262:         if idx == target_idx:\n0263:             center_color = marker_color\n0264:         elif idx == extra_idx:\n0265:             center_color = extra_center_color\n0266:         else:\n0267:             center_color = random.choice(\n0268:                 [extra_center_color]\n0269:                 + [color for color in marker_colors if color != marker_color]\n0270:             )\n0271:         patch, center = _gen_cluster_patch(\n0272:             marker_size,\n0273:             center_height,\n0274:             center_width,\n0275:             marker_color,\n0276:             center_color,\n0277:             bg,\n0278:         )\n0279:         patches.append(patch)\n0280:         if idx == target_idx:\n0281:             expected = center\n0282: \n0283:     grid = _place_cluster_patches(patches, bg)\n0284:     if expected is not None and grid is not None and _solves_to_expected(grid, expected):\n0285:         return grid\n0286:     return None\n0287: \n0288: \n0289: def generate_input() -> np.ndarray:\n0290:     for _ in range(GEN_ATTEMPTS):\n0291:         grid = _gen_attempt()\n0292:         if grid is not None:\n0293:             return grid\n0294:     raise RuntimeError(\"failed to generate a valid da6e95e5 input\")\n","exit_code":0,"status":"completed"}}
