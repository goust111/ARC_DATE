tion density and symmetry.\n0227: TEMPLATE_MIN_DECO_CELLS = 4\n0228: TEMPLATE_DECO_MIN_RATIO, TEMPLATE_DECO_MAX_RATIO = 0.10, 0.30\n0229: \n0230: # Blob motif and growth bounds.\n0231: BLOB_GROWTH_MIN, BLOB_GROWTH_MAX = 1, 4\n0232: BLOB_MAX_INITIAL_CELLS, BLOB_MAX_COMPONENTS = 7, 2\n0233: BLOB_MAX_LINE_COUNT, BLOB_MAX_WIDTH = 3, 3\n0234: BLOB_DIRECTIONS = (-1, 1)\n0235: \n0236: # Dynamic-color schedules.\n0237: SHORT_PRIOR_COUNT, MAX_DYNAMIC_COLORS = 2, 3\n0238: SCHEDULE_ALWAYS_2 = {\"period\": 1, \"times\": [0, 1], \"scheduled\": True}\n0239: SCHEDULE_ALWAYS_4 = {\"period\": 1, \"times\": [0, 1, 2, 3], \"scheduled\": True}\n0240: SCHEDULE_EVEN_4 = {\"period\": 2, \"times\": [0, 2], \"scheduled\": True}\n0241: SCHEDULE_FIRST3_4 = {\"period\": 1, \"times\": [0, 1, 2], \"scheduled\": False}\n0242: SCHEDULE_ODD_4 = {\"period\": 2, \"times\": [1, 3], \"scheduled\": False}\n0243: SCHEDULE_SECOND_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4)\n0244: SCHEDULE_THIRD_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4, SCHEDULE_FIRST3_4, SCHEDULE_ODD_4)\n0245: \n0246: # Placement and retry limits.\n0247: MASK_TRANSPARENT, PLACEMENT_BORDER = 0, 1\n0248: GENERATION_RETRIES = 300\n0249: \n0250: def _sym_orbits(h: int, w: int) -> list[list[tuple[int, int]]]:\n0251:     seen: set[tuple[int, int]] = set()\n0252:     orbits: list[list[tuple[int, int]]] = []\n0253:     for r in range(h):\n0254:         for c in range(w):\n0255:             if r not in (0, h - 1) and c not in (0, w - 1):\n0256:                 continue\n0257:             if (r, c) in seen:\n0258:                 continue\n0259:             orbit = sorted({(r, c), (r, w - 1 - c), (h - 1 - r, c), (h - 1 - r, w - 1 - c)})\n0260:             seen.update(orbit)\n0261:             orbits.append(orbit)\n0262:     return orbits\n0263: \n0264: \n0265: def _make_template(h: int, w: int, bg: int, deco: int) -> np.ndarray:\n0266:     out = np.full((h, w), bg, dtype=int)\n0267:     area = h * w\n0268:     min_deco = max(TEMPLATE_MIN_DE