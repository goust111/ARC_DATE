e the quadrant\n0282:     anch_r0, anch_r1 = q_r0, q_r1 - size + 1\n0283:     anch_c0, anch_c1 = q_c0, q_c1 - size + 1\n0284: \n0285:     # Intersect: prefer full-fit, fall back to anchor-only fit\n0286:     r_lo, r_hi = max(fit_r0, anch_r0), min(fit_r1, anch_r1)\n0287:     c_lo, c_hi = max(fit_c0, anch_c0), min(fit_c1, anch_c1)\n0288:     if r_lo <= r_hi and c_lo <= c_hi:\n0289:         return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)\n0290:     return random.randint(anch_r0, anch_r1), random.randint(anch_c0, anch_c1)\n0291: \n0292: \n0293: def _stamp(out: np.ndarray, patch_s: np.ndarray, anchor_r: int, anchor_c: int) -> None:\n0294:     \"\"\"Stamp non-bg pixels from a scaled patch onto the output grid, aligned by red anchor.\n0295:     Skips divider row/col, out-of-bounds pixels, and existing red pixels.\"\"\"\n0296:     rr_red, cc_red = np.where(patch_s == RED)\n0297:     place_r0 = anchor_r - int(rr_red.min())\n0298:     place_c0 = anchor_c - int(cc_red.min())\n0299: \n0300:     # Source pixel coordinates and their target positions\n0301:     src_rr, src_cc = np.where(patch_s != BG)\n0302:     tgt_rr = src_rr + place_r0\n0303:     tgt_cc = src_cc + place_c0\n0304: \n0305:     # Mask: in-bounds, not on divider, target is not already red\n0306:     valid = ((tgt_rr >= 0) & (tgt_rr < GRID_SIZE) &\n0307:              (tgt_cc >= 0) & (tgt_cc < GRID_SIZE) &\n0308:              (tgt_rr != MID) & (tgt_cc != MID))\n0309:     tgt_rr, tgt_cc, src_rr, src_cc = tgt_rr[valid], tgt_cc[valid], src_rr[valid], src_cc[valid]\n0310:     not_red = out[tgt_rr, tgt_cc] != RED\n0311:     out[tgt_rr[not_red], tgt_cc[not_red]] = patch_s[src_rr[not_red], src_cc[not_red]]\n0312: \n0313: \n0314: def _gen_attempt() -> np.ndarray | None:\n0315:     \"\"\"Single generation attempt: build output, derive input, oracle-check.\"\"\"\n0316:     target_sizes = {\n0317:         (0, 0): SOURCE_ANCHOR_SIZE,\n0318:         (0, 1): random.randint(*TARGET_SIZE_RANGE),\n0319:         (1, 0): random.randint(*TARGET_SIZE_RANGE),\n0320:         (1, 1): random.randint(*TARGET_SIZE_RANGE),\n0321:     }\n0322: \n0323:     needs_block = any(s % SOURCE_ANCHOR_SIZE != 0 for k, s in target_sizes.items() if k != (0, 0))\n0324:     source = _source_patch(needs_block)\n0325:     if source is None:\n0326:         return None\n0327:     patch, anchor_r_in_patch, anchor_c_in_patch = source\n0328: \n0329:     scaled = {\n0330:         key: _scaled_patch(patch, key[0], key[1], size)\n0331:         for key, size in target_sizes.items()\n0332:         if key != (0, 0)\n0333:     }\n0334: \n0335:     # Place anchors\n0336:     anchors: dict[tuple[int, int], tuple[int, int]] = {}\n0337:     tl_r0 = random.randint(0, MID - patch.shape[0])\n0338:     tl_c0 = random.randint(0, MID - patch.shape[1])\n0339:     anchors[(0, 0)] = (tl_r0 + anchor_r_in_patch, tl_c0 + anchor_c_in_patch)\n0340:     for key, patch_s in scaled.items():\n0341:         anchors[key] = _choose_anchor(key[0], key[1], target_sizes[key], patch_s)\n0342: \n0343:     # Build output grid\n0344:     out = np.full((GRID_SIZE, GRID_SIZE), BG, dtype=int)\n0345:     out[MID, :] = DIV\n0346:     out[:, MID] = DIV\n0347:     paste(out, patch, tl_r0, tl_c0)\n0348:     for key, size in target_sizes.items():\n0349:         if key == (0, 0):\n0350:             continue\n0351:         ar, ac = anchors[key]\n0352:         paste(out, np.full((size, size), RED, dtype=int), ar, ac)\n0353:     for key, patch_s in scaled.items():\n0354:         _stamp(out, patch_s, *anchors[key])\n0355: \n0356:     # Build input: clear non-TL quadrants, keep only red anchors\n0357:     inp = out.copy()\n0358:     for key, size in target_sizes.items():\n0359:         if key == (0, 0):\n0360:             continue\n0361:         q_r0, q_r1, q_c0, q_c1 = QUADS[key]\n0362:         inp[q_r0 : q_r1 + 1, q_c0 : q_c1 + 1] = BG\n0363:         ar, ac = anchors[key]\n0364:         paste(inp, np.full((size, size), RED, dtype=int), ar, ac)\n0365: \n0366:     re