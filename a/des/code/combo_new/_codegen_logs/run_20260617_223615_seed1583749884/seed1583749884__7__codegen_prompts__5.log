091:         num_v_lines = CELL4_V_LINES\n0092:         height = int(rng.integers(*CELL4_HEIGHT_RANGES[num_h_lines]))\n0093:     width = int(rng.integers(*WIDTH_RANGE))\n0094:     spacing = cell_size + 1\n0095:     line_rows = [cell_size + i * spacing for i in range(num_h_lines)]\n0096:     line_cols = [cell_size + i * spacing for i in range(num_v_lines)]\n0097:     grid = np.full((height, width), bg, dtype=int)\n0098:     grid[line_rows, :] = lattice_color\n0099:     grid[:, line_cols] = lattice_color\n0100:     r_span = int(rng.integers(1, min(MAX_HOLE_SPAN, num_h_lines - 1) + 1))\n0101:     c_span = int(rng.integers(1, min(MAX_HOLE_SPAN, num_v_lines - 1) + 1))\n0102:     r_i0 = int(rng.integers(0, num_h_lines - r_span))\n0103:     c_i0 = int(rng.integers(0, num_v_lines - c_span))\n0104:     hole_rows = [line_rows[r_i0], line_rows[r_i0 + r_span]]\n0105:     hole_cols = [line_cols[c_i0], line_cols[c_i0 + c_span]]\n0106: \n0107:     for r in hole_rows:\n0108:         for c in hole_cols:\n0109:             grid[r, c] = bg\n0110: \n0111:     interior = np.ones(grid.shape, dtype=bool)\n0112:     interior[line_rows, :] = False\n0113:     interior[:, line_cols] = False\n0114:     interior_positions = np.flatnonzero(interior)\n0115:     num_cell_regions = (num_h_lines + 1) * (num_v_lines + 1)\n0116:     min_markers = max(int(np.ceil(MARKER_DENSITY_RANGE[0] * len(interior_positions))), num_cell_regions)\n0117:     max_markers = min(\n0118:         int(np.floor(MARKER_DENSITY_RANGE[1] * len(interior_positions))),\n0119:         MAX_MARKERS_PER_CELL_REGION * num_cell_regions,\n0120:     )\n0121:     marker_count = int(rng.integers(min_markers, max_markers + 1))\n0122:     marker_positions = rng.choice(interior_positions, size=marker_count, replace=False)\n0123:     grid.ravel()[marker_positions] = marker_color\n0124: \n0125:     expected = grid[hole_rows[0] : hole_rows[1] + 1, hole_cols[0] : hole_cols[1] + 1].copy()\n0126:     try:\n0127:         if np.array_equal(main(grid)