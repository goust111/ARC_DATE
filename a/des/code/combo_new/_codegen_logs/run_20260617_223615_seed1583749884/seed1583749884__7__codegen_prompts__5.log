ight: int, width: int, area: int) -> np.ndarray:\n0147:     mask = np.zeros((height, width), dtype=bool)\n0148:     if random.randrange(2):\n0149:         r, c, end_r, end_c = 0, 0, height - 1, width - 1\n0150:     else:\n0151:         r, c, end_r, end_c = 0, width - 1, height - 1, 0\n0152: \n0153:     mask[r, c] = True\n0154:     while (r, c) != (end_r, end_c):\n0155:         if r < end_r:\n0156:             r += 1\n0157:         elif r > end_r:\n0158:             r -= 1\n0159:         if c < end_c:\n0160:             c += 1\n0161:         elif c > end_c:\n0162:             c -= 1\n0163:         mask[r, c] = True\n0164: \n0165:     while int(mask.sum()) < area:\n0166:         candidates = set()\n0167:         for rr, cc in np.argwhere(mask):\n0168:             for dr in (-1, 0, 1):\n0169:                 for dc in (-1, 0, 1):\n0170:                     if dr == 0 and dc == 0:\n0171:                         continue\n0172:                     nr, nc = int(rr) + dr, int(cc) + dc\n0173:                     if 0 <= nr < height and 0 <= nc < width and not mask[nr, nc]:\n0174:                         candidates.add((nr, nc))\n0175:         nr, nc = random.choice(tuple(candidates))\n0176:         mask[nr, nc] = True\n0177:     return mask\n0178: \n0179: \n0180: def _gen_center_patch(height: int, width: int, color: int, bg: int) -> np.ndarray:\n0181:     min_area = max(MIN_CENTER_AREA, height, width)\n0182:     max_area = min(MAX_CENTER_AREA, height * width - 1)\n0183:     area = random.randint(min_area, max_area)\n0184:     patch = np.full((height, width), bg, dtype=int)\n0185:     patch[_gen_center_mask(height, width, area)] = color\n0186:     return patch\n0187: \n0188: \n0189: def _gen_cluster_patch(\n0190:     marker_size: int,\n0191:     center_height: int,\n0192:     center_width: int,\n0193:     marker_color: int,\n0194:     center_color: int,\n0195:     bg: int,\n0196: ) -> tuple[np.ndarray, np.ndarray]:\n0197:     overlap = marker_size - 2\n0198:     center_r0 = 