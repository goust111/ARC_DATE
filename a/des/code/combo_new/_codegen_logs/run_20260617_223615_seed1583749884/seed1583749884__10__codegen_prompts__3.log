/new/ceshi/code_combo/53fb4810/27/code.py:727:        if not _cells_clear(payload_cells, occ, arrow_guard, payload_guard):\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/27/code.py:730:        for r, c in arrow_cells:\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/27/code.py:732:            out[int(r), int(c)] = int(arrow_color)\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/27/code.py:733:        _mark_guard(arrow_guard, arrow_cells)\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/27/code.py:758:    arrows: list[dict],\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/27/code.py:762:    keep_idx = next(i for i, meta in enumerate(arrows) if bool(meta[\"is_clue\"]))\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/27/code.py:763:    for i, meta in enumerate(arrows):\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/27/code.py:789:    arrow_color = _detect_arrow_color(g, bg=int(bg))\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/27/code.py:790:    if arrow_color is None:\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/27/code.py:793:    arrow_lab, an = label_mask(g == int(arrow_color), connectivity=4)\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/27/code.py:794:    non_mask = (g != int(bg)) & (g != int(arrow_color))\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/27/code.py:800:        arrow_mask = arrow_lab == int(ak)\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/27/code.py:801:        arrow_coords = np.argwhere(arrow_mask)\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/27/code.py:802:        if arrow_coords.size == 0:\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/27/code.py:804:        ar0, ac0, ar1, ac1 = bbox_coords(arrow_coords)\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/27/code.py:805:        local_arrow = g[int(ar0) : int(ar1) + 1, int(ac0) : int(ac1) + 1] == int(arrow_color)\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/27/code.py:806:        matched = _match_arrow_component(local_arrow)\n/home/lixinyu/snap/new/cesh