21/code.py:209:                branch = _arrow_branch_cells(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:216:                tail = _arrow_tail(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:217:                front_cluster = _arrow_front_cluster(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:238:            assert len(matches) <= 1, \"colored arrow center must have a unique orientation\"\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:258:    assert all_one_cells == used_ones, \"all color-1 pixels must belong to an arrow control marker\"\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:305:            assert dest is not None, \"arrow marker must point at a destination region\"\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:307:            tail_counts = adjacent_component_counts({_arrow_tail(center, stem)})\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:308:            assert tail_counts, \"arrow tail must touch its source-side region\"\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:340:        assert final_color[dest] in {root_color[dest], replacement}, \"conflicting arrow controls for one region\"\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:404:    Recolor mosaic regions from arrow-shaped boundary controls, erase those controls, and optionally mirror the finished mosaic from a color-9 L marker.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:408:    - Color 1 now forms 5-cell arrows instead of T tetrominoes: a 3-cell shaft plus a 2-cell diagonal arrowhead.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:409:    - Some arrows use a colored middle shaft cell with four surrounding color-1 arrow cells; that middle color is a literal replacement color.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:413:    - For each arrow, the shaft direction points toward the destination region; read that destination from the first base region reached two steps ahead of the arrow's middle cell.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:414:    - The source side is the region the arrow emerges from at its tail; a plain color-1 arrow copies that source region's original color, while a colored-center arrow uses its center color instead.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:415:    - After recoloring, every arrow cell is filled with the final color of the source-side region.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:419:    - The arrow tells you what changes before any global transform happens, while the L only flips the completed answer; if you mentally flip first, the arrow directions become misleading.\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:426:# --------------- generator (arrowflip) ---------------\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:544:                cells = _arrow_cells(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:549:                if _arrow_neighborhood(center, stem) & occupied_cells:\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:553:                tail = _arrow_tail(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:590:    cells = _arrow_cells(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:593:        occupied_neighbors |= (_arrow_neighborhood(center, stem) - cells)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:596:    tail = _arrow_tail(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:597:    front_cluster = _arrow_front_cluster(center, stem)\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:610:        if nb not in _arrow_branch_cells(center, stem):\n/home/lixinyu/snap/new/ceshi/code_combo/21897d95/21/code.py:621:            for rr, cc in _arrow_cells(center, stem):\n/home