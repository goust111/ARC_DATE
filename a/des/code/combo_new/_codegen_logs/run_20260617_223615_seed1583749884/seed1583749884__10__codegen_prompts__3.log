cle.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/10/code.py:192:            decoded = _decode_arrow_component(coords)\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/10/code.py:211:def _assert_arrow_markers_valid(\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/10/code.py:217:    assert 1 <= len(markers) <= 2, f\"expected 1-2 arrow markers, got {len(markers)}\"\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/10/code.py:221:        assert tuple(sorted(_arrow_cells(tip_r, tip_c, direction))) == cells, (\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/10/code.py:295:    - Start markers are 3-cell arrowheads in template colors, embedded inside the path region.\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/10/code.py:300:    - Each arrow launches one particle from its tip in the direction encoded by the arrowhead shape.\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/10/code.py:304:    Key insight: The path dynamics are still the original alternating-turn walk, but the input now hides two independent controls in local geometry: arrow shape chooses the initial heading, and corner-template shape chooses the usable cycle order.\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/10/code.py:333:    markers = _find_arrow_markers(g, pattern, path_color)\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/10/code.py:334:    _assert_arrow_markers_valid(g, markers, path_color)\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/10/code.py:494:def _collect_arrow_candidates(mask: np.ndarray, target_row: int) -> list[dict[str, object]]:\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/10/code.py:508:                    cells = _arrow_cells(int(r), int(c), direction)\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/10/code.py:547:def _place_arrow_markers(\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/10/code.py:553:    cand_lists = [_collect_arrow_candidates(mask, int(row)) for row in target_rows]\n/home/lixinyu/snap/new/ceshi/code_combo/195c6913/10/code.py: