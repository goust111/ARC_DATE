{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/7e2bad24.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, find_components, get_bg, in_bounds\nimport random\n\n\ndef _coord_set(coords: np.ndarray) -> set[tuple[int, int]]:\n    return {tuple(map(int, rc)) for rc in coords}\n\n\ndef _is_contiguous_diagonal(coords: set[tuple[int, int]]) -> bool:\n    if len(coords) < 2:\n        return False\n\n    if len({r - c for r, c in coords}) == 1:\n        rows = sorted(r for r, _c in coords)\n        cols = sorted(c for _r, c in coords)\n    elif len({r + c for r, c in coords}) == 1:\n        rows = sorted(r for r, _c in coords)\n        cols = sorted(c for _r, c in coords)\n    else:\n        return False\n\n    return (\n        rows == list(range(rows[0], rows[-1] + 1))\n        and cols == list(range(cols[0], cols[-1] + 1))\n        and len(coords) == rows[-1] - rows[0] + 1\n    )\n\n\ndef _ray_seed(g: np.ndarray, bg: int) -> tuple[int, set[tuple[int, int]]]:\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    candidates: list[tuple[int, set[tuple[int, int]]]] = []\n    for comp in comps:\n        coords = _coord_set(comp[\"coords\"])\n        if _is_contiguous_diagonal(coords):\n            candidates.append((int(comp[\"color\"]), coords))\n\n    assert len(candidates) == 1, \"expected one diagonal ray seed\"\n    return candidates[0]\n\n\ndef _initial_state(\n    shape: tuple[int, int], coords: set[tuple[int, int]]\n) -> tuple[int, int, int, int]:\n    if len({r - c for r, c in coords}) == 1:\n        first = min(coords)\n        last = max(coords)\n        endpoints = ((first, (-1, -1)), (last, (1, 1)))\n    else:\n        assert len({r + c for r, c in coords}) == 1, \"ray seed must be diagonal\"\n        top = min(coords)\n        bottom = max(coords)\n        endpoints = ((top, (-1, 1)), (bottom, (1, -1)))\n\n    candidates = []\n    for (r, c), (dr, dc) in endpoints:\n        if in_bounds(shape, r + dr, c + dc):\n            candidates.append((r, c, dr, dc))\n\n    assert len(candidates) == 1, \"ray seed must have exactly one in-bounds extension\"\n    return candidates[0]\n\n\ndef _mirror_orientations(g: np.ndarray, bg: int) -> dict[tuple[int, int], str]:\n    orientations: dict[tuple[int, int], str] = {}\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[Color.RED])\n    for comp in comps:\n        coords = _coord_set(comp[\"coords\"])\n        rows = sorted({r for r, _c in coords})\n        cols = sorted({c for _r, c in coords})\n\n        if len(rows) == 1:\n            assert cols == list(range(cols[0], cols[-1] + 1)), \"red mirror must be contiguous\"\n            orientation = \"horizontal\"\n        elif len(cols) == 1:\n            assert rows == list(range(rows[0], rows[-1] + 1)), \"red mirror must be contiguous\"\n            orientation = \"vertical\"\n        else:\n            raise AssertionError(\"red mirror must be a horizontal or vertical segment\")\n\n        for rc in coords:\n            orientations[rc] = orientation\n\n    return orientations\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extend the diagonal blue ray through the grid, reflecting it off red line-segment mirrors.\n\n    Input structure\n    - Black-background grid with one diagonal 8-connected blue ray seed.\n    - Red foreground objects, when present, are straight horizontal or vertical mirror segments.\n    - Other foreground bars are transparent to the ray and may be overwritten where the ray crosses them.\n\n    Rule\n    - Start from the ray seed endpoint whose outward diagonal extension remains inside the grid.\n    - Paint the ray continuously in that diagonal direction until it leaves the grid.\n    - If the next cell is a red mirror, do not paint it; reflect by flipping the row direction on a horizontal mirror or the column direction on a vertical mirror.\n\n    Key insight\n    - The non-red bars are decoys: only red bars reflect the diagonal path, while all other crossed cells become blue.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    ray_color, seed = _ray_seed(g, bg)\n    r, c, dr, dc = _initial_state(g.shape, seed)\n    mirrors = _mirror_orientations(g, bg)\n\n    out = g.copy()\n    seen: set[tuple[int, int, int, int]] = set()\n    while True:\n        state = (r, c, dr, dc)\n        assert state not in seen, \"ray path must not loop\"\n        seen.add(state)\n\n        nr, nc = r + dr, c + dc\n        if not in_bounds(g.shape, nr, nc):\n            break\n\n        if int(g[nr, nc]) == Color.RED:\n            orientation = mirrors.get((nr, nc))\n            assert orientation is not None, \"red cell must belong to a mirror segment\"\n            if orientation == \"horizontal\":\n                dr = -dr\n            else:\n                assert orientation == \"vertical\"\n                dc = -dc\n            continue\n\n        out[nr, nc] = ray_color\n        r, c = nr, nc\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and color layout.\nGRID_HEIGHT = 16\nGRID_WIDTH = 16\nBACKGROUND_COLOR = 0\n\n# Ray and seed sampling ranges.\nREFLECTION_COUNT_RANGE = (0, 4)\nSEED_LENGTH_RANGE = (3, 6)\nTOTAL_PATH_LENGTH_RANGE = (15, 16)\nNEW_CELLS_RANGE = (9, 13)\nDIAGONAL_CHOICES = (-1, 1)\nSTART_EDGES = (\"top\", \"bottom\", \"left\", \"right\")\n\n# Bar structure ranges and orientations.\nBAR_LENGTH_RANGE = (4, 14)\nMIRROR_ORIENTATIONS = [\"horizontal\", \"vertical\"]\nDECOY_COUNT_RANGE = (0, 3)\nDECOY_PLACEMENT_ATTEMPTS = 30\n\n# Rejection sampling budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _inside(r: int, c: int) -> bool:\n    return 0 <= r < GRID_HEIGHT and 0 <= c < GRID_WIDTH\n\n\ndef _random_start_state() -> tuple[int, int, int, int]:\n    \"\"\"Choose a boundary cell with a diagonal direction whose backward extension is OOB.\"\"\"\n    edge = random.choice(START_EDGES)\n    if edge == \"top\":\n        return 0, random.randint(0, GRID_WIDTH - 1), 1, random.choice(DIAGONAL_CHOICES)\n    if edge == \"bottom\":\n        return (\n            GRID_HEIGHT - 1,\n            random.randint(0, GRID_WIDTH - 1),\n            -1,\n            random.choice(DIAGONAL_CHOICES),\n        )\n    if edge == \"left\":\n        return random.randint(0, GRID_HEIGHT - 1), 0, random.choice(DIAGONAL_CHOICES), 1\n    return (\n        random.randint(0, GRID_HEIGHT - 1),\n        GRID_WIDTH - 1,\n        random.choice(DIAGONAL_CHOICES),\n        -1,\n    )\n\n\ndef _build_seed_cells(\n    r0: int,\n    c0: int,\n    dr: int,\n    dc: int,\n    seed_len: int,\n) -> list[tuple[int, int]] | None:\n    cells = []\n    for i in range(seed_len):\n        sr, sc = r0 + i * dr, c0 + i * dc\n        if not _inside(sr, sc):\n            return None\n        cells.append((sr, sc))\n    return cells\n\n\ndef _split_path_segments(new_cells_needed: int, n_reflections: int) -> list[int] | None:\n    \"\"\"Partition painted cells across straight ray segments before each reflection.\"\"\"\n    if n_reflections == 0:\n        return [new_cells_needed]\n    if new_cells_needed < n_reflections + 1:\n        return None\n\n    cuts = sorted(random.sample(range(1, new_cells_needed), n_reflections))\n    segments = []\n    prev = 0\n    for cut in cuts:\n        segments.append(cut - prev)\n        prev = cut\n    segments.append(new_cells_needed - prev)\n    return segments\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, components_mask, get_bg\nimport random\n\n\nAxis = tuple[int, str, int]\n\n\ndef _find_reflection_axis(g: np.ndarray, bg: int) -> Axis:\n    h, w = g.shape\n    candidates: list[Axis] = []\n\n    for color in colors_present(g, exclude={bg}):\n        mask = g == color\n        count = int(mask.sum())\n\n        if count == w:\n            for r in np.flatnonzero(mask.all(axis=1)):\n                candidates.append((int(color), \"row\", int(r)))\n\n        if count == h:\n            for c in np.flatnonzero(mask.all(axis=0)):\n                candidates.append((int(color), \"col\", int(c)))\n\n        if h == w and count == h:\n            main_diag = np.eye(h, dtype=bool)\n            anti_diag = np.fliplr(main_diag)\n            if np.all(mask[main_diag]):\n                candidates.append((int(color), \"main_diag\", 0))\n            if np.all(mask[anti_diag]):\n                candidates.append((int(color), \"anti_diag\", 0))\n\n    assert len(candidates) == 1, \"expected exactly one full straight reflection axis\"\n    return candidates[0]\n\n\ndef _reflect(axis: Axis, shape: tuple[int, int], r: int, c: int) -> tuple[int, int]:\n    _axis_color, kind, index = axis\n    h, w = shape\n\n    if kind == \"row\":\n        return 2 * index - r, c\n    if kind == \"col\":\n        return r, 2 * index - c\n    if kind == \"main_diag\":\n        assert h == w, \"diagonal reflection axis requires a square grid\"\n        return c, r\n    if kind == \"anti_diag\":\n        assert h == w, \"diagonal reflection axis requires a square grid\"\n        return h - 1 - c, w - 1 - r\n\n    raise AssertionError(f\"unknown axis kind: {kind}\")\n\n\ndef _smallest_non_axis_color(g: np.ndarray, bg: int, axis_color: int) -> int:\n    areas = {\n        int(color): int(np.count_nonzero(g == color))\n        for color in colors_present(g, exclude={bg, axis_color})\n    }\n    assert len(areas) >= 2, \"expected at least two non-axis foreground colors\"\n\n    min_area = min(areas.values())\n    colors = [color for color, area in areas.items() if area == min_area]\n    assert len(colors) == 1, \"smallest non-axis foreground color must be unique\"\n    return colors[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Mirror the smallest non-axis foreground color across the full straight axis.\n\n    Input structure\n    - The background is the dominant color.\n    - One foreground color forms exactly one full row, column, main diagonal, or anti-diagonal reflection axis.\n    - The remaining foreground colors include a unique least-populated color to copy.\n\n    Rule\n    - Preserve the input grid.\n    - Select every pixel of the unique smallest non-axis foreground color.\n    - Reflect those pixels across the full straight axis and paint the reflected positions with the same color.\n\n    Key insight\n    - The axis color marks the mirror line, while the color population chooses which set of objects is duplicated.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.size > 0, \"expected a non-empty 2D grid\"\n\n    bg = get_bg(g)\n    axis = _find_reflection_axis(g, bg)\n    axis_color = axis[0]\n    mirror_color = _smallest_non_axis_color(g, bg, axis_color)\n\n    out = g.copy()\n    h, w = g.shape\n    for r_raw, c_raw in np.argwhere(g == mirror_color):\n        r = int(r_raw)\n        c = int(c_raw)\n        rr, cc = _reflect(axis, g.shape, r, c)\n        assert 0 <= rr < h and 0 <= cc < w, \"reflected pixel must stay inside the grid\"\n        assert int(out[rr, cc]) in {bg, mirror_color}, \"reflection cannot overwrite another foreground object\"\n        out[rr, cc] = mirror_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n# Canvas and axis options.\n_GEN_GRID_SIZE_RANGE = (9, 17)\n_GEN_ODD_GRID_SIZES = [9, 11, 13, 15, 17]\n_GEN_AXIS_KINDS = [\"row\", \"col\", \"main_diag\", \"anti_diag\"]\n_GEN_CENTER_AXIS_KINDS = {\"row\", \"col\"}\n_GEN_SIDE_COUNT = 2\n# Foreground component size and count bounds.\n_GEN_COMPONENT_COUNT_RANGE = range(1, 4)\n_GEN_MIRROR_TOTAL_RANGE = (4, 12)\n_GEN_MIRROR_COMPONENT_SIZE_RANGE = (2, 7)\n_GEN_NONMIRROR_TOTAL_RANGE = (5, 17)\n_GEN_NONMIRROR_COMPONENT_SIZE_RANGE = (3, 9)\n_GEN_MIN_NONMIRROR_RATIO = (5, 4)\n_GEN_MAX_NONMIRROR_MULTIPLIER = 2\n# Search and geometry primitives.\n_GEN_RETRY_LIMIT = 300\n_GEN_COLORS = list(range(10))\n_GEN_DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\ndef _gen_draw_axis(grid: np.ndarray, axis_kind: str, color: int) -> None:\n    n = grid.shape[0]\n    if axis_kind == \"row\":\n        grid[n // 2, :] = color\n    elif axis_kind == \"col\":\n        grid[:, n // 2] = color\n    elif axis_kind == \"main_diag\":\n        np.fill_diagonal(grid, color)\n    else:\n        np.fill_diagonal(np.fliplr(grid), color)\n\n\ndef _gen_side_mask(n: int, axis_kind: str, side: int) -> np.ndarray:\n    rr, cc = np.indices((n, n))\n    if axis_kind == \"row\":\n        return rr < n // 2 if side == 0 else rr > n // 2\n    if axis_kind == \"col\":\n        return cc < n // 2 if side == 0 else cc > n // 2\n    if axis_kind == \"main_diag\":\n        return cc > rr if side == 0 else cc < rr\n    return rr + cc < n - 1 if side == 0 else rr + cc > n - 1\n\n\ndef _gen_reflect(axis_kind: str, n: int, r: int, c: int) -> tuple[int, int]:\n    if axis_kind == \"row\":\n        return n - 1 - r, c\n    if axis_kind == \"col\":\n        return r, n - 1 - c\n    if axis_kind == \"main_diag\":\n        return c, r\n    return n - 1 - c, n - 1 - r\n\n\ndef _gen_feasible_counts(total: int, lo: int, hi: int) -> list[int]:\n    return [count for count in _GEN_COMPONENT_COUNT_RANGE if count * lo <= total <= count * hi]\n\n\ndef _gen_partition(total: int, count: int, lo: int, hi: int) -> list[int]:\n    sizes = []\n    remaining = total\n    for idx in range(count):\n        left = count - idx - 1\n        cur_lo = max(lo, remaining - left * hi)\n        cur_hi = min(hi, remaining - left * lo)\n        size = random.randint(cur_lo, cur_hi)\n        sizes.append(size)\n        remaining -= size\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _gen_pick_component_sizes() -> tuple[list[int], list[int]]:\n    mirror_total = random.randint(*_GEN_MIRROR_TOTAL_RANGE)\n    ratio_num, ratio_den = _GEN_MIN_NONMIRROR_RATIO\n    nonmirror_lo = max(\n        _GEN_NONMIRROR_TOTAL_RANGE[0],\n        (ratio_num * mirror_total + ratio_den - 1) // ratio_den,\n    )\n    nonmirror_hi = min(_GEN_NONMIRROR_TOTAL_RANGE[1], _GEN_MAX_NONMIRROR_MULTIPLIER * mirror_total)\n    nonmirror_total = random.randint(nonmirror_lo, nonmirror_hi)\n\n    mirror_count = random.choice(_gen_feasible_counts(mirror_total, *_GEN_MIRROR_COMPONENT_SIZE_RANGE))\n    nonmirror_count = random.choice(_gen_feasible_counts(nonmirror_total, *_GEN_NONMIRROR_COMPONENT_SIZE_RANGE))\n    mirror_sizes = _gen_partition(mirror_total, mirror_count, *_GEN_MIRROR_COMPONENT_SIZE_RANGE)\n    nonmirror_sizes = _gen_partition(nonmirror_total, nonmirror_count, *_GEN_NONMIRROR_COMPONENT_SIZE_RANGE)\n    return mirror_sizes, nonmirror_sizes\n\n\ndef _gen_mark_neighbors(blocked: np.ndarray, coords: np.ndarray) -> None:\n    n = blocked.shape[0]\n    for r_raw, c_raw in coords:\n        r = int(r_raw)\n        c = int(c_raw)\n        blocked[r, c] = True\n        for dr, dc in _GEN_DIRS4:\n            rr = r + dr\n            cc = c + dc\n            if 0 <= rr < n and 0 <= cc < n:\n                blocked[rr, cc] = True\n\n\ndef _gen_grow_component(\n    side_mask: np.ndarray, occupied: np.ndarray, same_color_blocked: np.ndarray, size: int\n) -> np.ndarray | None:\n    available = side_mask & ~occupied & ~same_color_blocked\n    choices = [coords for coords in components_mask(available, connectivity=4) if len(coords) >= size]\n    if not choices:\n        return None\n\n    region = random.choice(choices)\n    seed = tuple(int(x) for x in region[random.randrange(len(region))])\n    selected = {seed}\n    frontier: set[tuple[int, int]] = set()\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"参考题里有几个模式值得沿用：`main()` 里先把隐式结构断言清楚，生成器用重试和最终 `main(inp)==out` 回验来避免退化样例。接着把剩余 4 个参考文件也快速过一遍，然后实现当前题的轴推断与样例生成。"}}
