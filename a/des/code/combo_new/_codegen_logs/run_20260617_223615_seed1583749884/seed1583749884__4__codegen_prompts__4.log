{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nimport numpy as np\n\nBLACK=0\nYELLOW=4\nDIRS4=((1,0),(-1,0),(0,1),(0,-1))\n\n\ndef grow_connected(shape, target, seed=None, required_col=None):\n    h,w=shape\n    if seed is None:\n        if required_col is None:\n            seed=(random.randrange(h), random.randrange(w))\n        else:\n            seed=(random.randrange(h), required_col)\n    cells={seed}\n    frontier=set()\n    def add_neighbors(cell):\n        r,c=cell\n        for dr,dc in DIRS4:\n            rr,cc=r+dr,c+dc\n            if 0<=rr<h and 0<=cc<w and (rr,cc) not in cells:\n                frontier.add((rr,cc))\n    add_neighbors(seed)\n    while len(cells)<target:\n        if not frontier:\n            return None\n        cell=random.choice(tuple(frontier))\n        frontier.remove(cell)\n        cells.add(cell)\n        add_neighbors(cell)\n    return cells\n\n\ndef add_extras(base, shape, extra_count):\n    h,w=shape\n    cells=set(base)\n    frontier=set()\n    def refresh_frontier():\n        frontier.clear()\n        for r,c in cells:\n            for dr,dc in DIRS4:\n                rr,cc=r+dr,c+dc\n                if 0<=rr<h and 0<=cc<w and (rr,cc) not in cells:\n                    frontier.add((rr,cc))\n    refresh_frontier()\n    while extra_count>0:\n        if not frontier:\n            return None\n        cell=random.choice(tuple(frontier))\n        cells.add(cell)\n        extra_count-=1\n        refresh_frontier()\n    return cells\n\n\ndef render_vertical(core, src, axis_mode='gap', source_side='left'):\n    h=max(r for r,_ in src)+1 if src else 0\n    h=max(h, max(r for r,_ in core)+1 if core else 0)\n    half_w=max(c for _,c in src)+1 if src else 0\n    half_w=max(half_w, max(c for _,c in core)+1 if core else 0)\n    w=2*half_w + (1 if axis_mode=='cell' else 0)\n    g=np.zeros((h,w),dtype=int)\n    if source_side=='left':\n        def src_map(r,c): return r,c\n        def tgt_map(r,c): return r, w-1-c\n        adj_col=half_w-1\n        axis_col=half_w if axis_mode=='cell' else None\n    else:\n        def src_map(r,c): return r, w-half_w+c\n        def tgt_map(r,c): return r, half_w-1-c\n        adj_col=0\n        axis_col=half_w-1 if axis_mode=='cell' else None\n    for r,c in src:\n        rr,cc=src_map(r,c); g[rr,cc]=1\n    for r,c in core:\n        rr,cc=tgt_map(r,c); g[rr,cc]=1\n    if axis_mode=='cell':\n        if source_side=='left':\n            axis_rows={r for r,c in core if c==half_w-1}\n        else:\n            axis_rows={r for r,c in core if c==0}\n        for r in axis_rows:\n            g[r,half_w]=1\n    return g\n\n\ndef eval_candidate(pts, shape, kind, t, source_positive):\n    h,w=shape\n    source=[]; target=[]\n    for r,c in pts:\n        coord=c if kind=='vertical' else r\n        if 2*coord<t:\n            side=False\n        elif 2*coord>t:\n            side=True\n        else:\n            continue\n        (source if side==source_positive else target).append((r,c))\n    if not source or not target:\n        return None\n    mirrored=set()\n    for r,c in source:\n        if kind=='vertical':\n            rr,cc=r,t-c\n        else:\n            rr,cc=t-r,c\n        if not (0<=rr<h and 0<=cc<w):\n            return None\n        mirrored.add((rr,cc))\n    target_set=set(target)\n    if not target_set.issubset(mirrored):\n        return None\n    pair=target_set & mirrored\n    fill=mirrored - target_set\n    if not pair or not fill:\n        return None\n    score=(len(pair), -len(fill), -abs(len(source)-len(target)))\n    return score\n\n\ndef detect(g):\n    pts=set(map(tuple,np.argwhere(g)))\n    h,w=g.shape\n    cands=[]\n    for t in range(0,2*w-1):\n        for sp in (False,True):\n            s=eval_candidate(pts,(h,w),'vertical',t,sp)\n            if s: cands.append(('vertical',t,sp,s))\n    for t in range(0,2*h-1):\n        for sp in (False,True):\n            s=eval_candidate(pts,(h,w),'horizontal',t,sp)\n            if s: cands.append(('horizontal',t,sp,s))\n    if not cands:\n        return None\n    cands.sort(key=lambda x:x[3], reverse=True)\n    best=cands[0]\n    if len(cands)>1 and cands[1][3]==best[3]:\n        return ('tie', best, cands[:5])\n    return best\n\n\ndef make_obj():\n    for _ in range(500):\n        h=random.randint(5,9)\n        half_w=random.randint(2,4)\n        core_size=random.randint(max(3,h//2), min(h*half_w-1, h+half_w))\n        core=grow_connected((h,half_w), core_size, required_col=half_w-1)\n        if core is None:\n            continue\n        max_extra=min(half_w*h-len(core), max(1, half_w+2))\n        if max_extra<1:\n            continue\n        extra_count=random.randint(1,max_extra)\n        src=add_extras(core,(h,half_w),extra_count)\n        if src is None:\n            continue\n        axis_mode=random.choice(['gap','cell'])\n        side=random.choice(['left','right'])\n        g=render_vertical(core,src,axis_mode,side)\n        if random.random()<0.5:\n            g=g.T\n        d=detect(g)\n        if d is None or d[0]=='tie':\n            continue\n        return g,d\n    return None,None\n\nok=0\nfor i in range(200):\n    g,d=make_obj()\n    if g is not None:\n        ok+=1\nprint('ok',ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
