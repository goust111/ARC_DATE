 147:     return _render_solution(g.shape, centers, order)\n\n--- generate_input 214-227 ---\n 214: def generate_input() -> np.ndarray:\n 215:     for _ in range(GENERATION_RETRIES):\n 216:         try:\n 217:             grid, expected_centers, expected_order = _generate_case()\n 218:             found_centers, found_order = _solve_instance(grid)\n 219:         except (AssertionError, ValueError):\n 220:             continue\n 221: \n 222:         if found_order != expected_order:\n 223:             continue\n 224:         if any(found_centers[color] != expected_centers[color] for color in expected_order):\n 225:             continue\n 226:         return grid\n 227:     raise RuntimeError(\"failed to generate a valid overlapping-cross instance\")\n\n","exit_code":0,"status":"completed"}}
