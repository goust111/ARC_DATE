{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/21897d95.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter, deque\nimport numpy as np\n\nfrom arc_utils import label_mask\nimport random\n\n\nDIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))\nUP = (-1, 0)\nDOWN = (1, 0)\nRIGHT = (0, 1)\n\n\nclass _DSU:\n    def __init__(self, n: int):\n        self.parent = list(range(int(n)))\n\n    def find(self, x: int) -> int:\n        x = int(x)\n        while self.parent[x] != x:\n            self.parent[x] = self.parent[self.parent[x]]\n            x = self.parent[x]\n        return int(x)\n\n    def union(self, a: int, b: int) -> None:\n        ra = self.find(a)\n        rb = self.find(b)\n        if ra != rb:\n            self.parent[rb] = ra\n\n\ndef _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:\n    return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])\n\n\ndef _opp(d: tuple[int, int]) -> tuple[int, int]:\n    return (-int(d[0]), -int(d[1]))\n\n\ndef _stem_from_branches(branches: list[tuple[int, int]]) -> tuple[int, int]:\n    assert len(branches) == 3\n    branch_set = set(branches)\n    for d in branches:\n        if _opp(d) not in branch_set:\n            return d\n    raise AssertionError(\"T marker has no single stem\")\n\n\ndef _parse_tetromino(cells: set[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int], list[tuple[int, int]]] | None:\n    if len(cells) != 4:\n        return None\n    for r, c in cells:\n        branches = [(dr, dc) for dr, dc in DIRS if (r + dr, c + dc) in cells]\n        if len(branches) != 3:\n            continue\n        stem = _stem_from_branches(branches)\n        expected = {(r, c), (r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)}\n        expected.remove((r - stem[0], c - stem[1]))\n        if cells == expected:\n            bar = [d for d in branches if d != stem]\n            assert len(bar) == 2 and bar[0] == _opp(bar[1])\n            return (int(r), int(c)), stem, bar\n    return None\n\n\ndef _label_base_components(g: np.ndarray, control: np.ndarray) -> tuple[np.ndarray, list[int], list[int]]:\n    comp_id = np.full(g.shape, -1, dtype=int)\n    comp_colors: list[int] = []\n    comp_areas: list[int] = []\n    cid = 0\n    for col in sorted(set(map(int, g.ravel())) - {1}):\n        labels, n_labels = label_mask((g == col) & (~control), connectivity=4)\n        for k in range(1, int(n_labels) + 1):\n            coords = np.argwhere(labels == k)\n            if coords.size == 0:\n                continue\n            for rr, cc in coords:\n                comp_id[int(rr), int(cc)] = cid\n            comp_colors.append(int(col))\n            comp_areas.append(int(len(coords)))\n            cid += 1\n    return comp_id, comp_colors, comp_areas\n\n\ndef _solve_unrotated(g: np.ndarray) -> np.ndarray:\n    labels_1, n_1 = label_mask(g == 1, connectivity=4)\n    one_components = {\n        k: {tuple(map(int, xy)) for xy in np.argwhere(labels_1 == k)}\n        for k in range(1, int(n_1) + 1)\n    }\n    one_sizes = {k: len(cells) for k, cells in one_components.items()}\n\n    markers: list[dict] = []\n    used_ones: set[tuple[int, int]] = set()\n    control = np.zeros(g.shape, dtype=bool)\n\n    for cells in one_components.values():\n        parsed = _parse_tetromino(cells)\n        if parsed is None:\n            continue\n        center, stem, bar = parsed\n        markers.append({\"kind\": \"normal\", \"center\": center, \"stem\": stem, \"bar\": bar, \"cells\": cells})\n        used_ones |= cells\n        for r, c in cells:\n            control[r, c] = True\n\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n            if int(g[r, c]) == 1:\n                continue\n            branches: list[tuple[int, int]] = []\n            cells: list[tuple[int, int]] = []\n            ok = True\n            for d in DIRS:\n                rr, cc = r + d[0], c + d[1]\n                if not _in_bounds(g.shape, rr, cc) or int(g[rr, cc]) != 1:\n                    continue\n                label = int(labels_1[rr, cc])\n                if one_sizes[label] == 1 and (rr, cc) not in used_ones:\n                    branches.append(d)\n                    cells.append((rr, cc))\n                else:\n                    ok = False\n            if ok and len(branches) == 3:\n                stem = _stem_from_branches(branches)\n                bar = [d for d in branches if d != stem]\n                assert len(bar) == 2 and bar[0] == _opp(bar[1])\n                marker_cells = set(cells) | {(int(r), int(c))}\n                markers.append(\n                    {\n                        \"kind\": \"colored\",\n                        \"center\": (int(r), int(c)),\n                        \"stem\": stem,\n                        \"bar\": bar,\n                        \"cells\": marker_cells,\n                        \"target_color\": int(g[r, c]),\n                    }\n                )\n                used_ones |= set(cells)\n                for rr, cc in marker_cells:\n                    control[rr, cc] = True\n\n    all_one_cells = {tuple(map(int, xy)) for xy in np.argwhere(g == 1)}\n    assert all_one_cells == used_ones, \"all color-1 pixels must belong to a T control marker\"\n\n    for col in sorted(set(map(int, g.ravel())) - {1}):\n        labels, n_labels = label_mask((g == col) & (~control), connectivity=4)\n        for k in range(1, int(n_labels) + 1):\n            coords = np.argwhere(labels == k)\n            if len(coords) > 5:\n                continue\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            if len(coords) == (int(r1) - int(r0) + 1) * (int(c1) - int(c0) + 1):\n                continue\n            cells = {tuple(map(int, xy)) for xy in coords}\n            markers.append({\"kind\": \"small\", \"cells\": cells})\n            for rr, cc in cells:\n                control[rr, cc] = True\n\n    comp_id, comp_colors, comp_areas = _label_base_components(g, control)\n    assert comp_colors, \"at least one base region is required\"\n    dsu = _DSU(len(comp_colors))\n\n    def first_component_from(center: tuple[int, int], direction: tuple[int, int], start: int) -> int | None:\n        r, c = center\n        step = int(start)\n        while True:\n            rr = r + direction[0] * step\n            cc = c + direction[1] * step\n            if not _in_bounds(g.shape, rr, cc):\n                return None\n            if comp_id[rr, cc] >= 0:\n                return int(comp_id[rr, cc])\n            step += 1\n\n    def adjacent_component_counts(cells: set[tuple[int, int]]) -> Counter:\n        counts: Counter = Counter()\n        for r, c in cells:\n            for dr, dc in DIRS:\n                rr, cc = r + dr, c + dc\n                if _in_bounds(g.shape, rr, cc) and comp_id[rr, cc] >= 0:\n                    counts[int(comp_id[rr, cc])] += 1\n        return counts\n\n    for marker in markers:\n        if marker[\"kind\"] in {\"normal\", \"colored\"}:\n            center = marker[\"center\"]\n            stem = marker[\"stem\"]\n            dest = first_component_from(center, stem, start=2)\n            assert dest is not None, \"T marker must point at a destination region\"\n\n            source_parts: list[int] = []\n            for bar_dir in marker[\"bar\"]:\n                rr = center[0] + stem[0] + bar_dir[0]\n                cc = center[1] + stem[1] + bar_dir[1]\n                assert _in_bounds(g.shape, rr, cc) and comp_id[rr, cc] >= 0\n                source_parts.append(int(comp_id[rr, cc]))\n            source = source_parts[0]\n            for part in source_parts[1:]:\n                assert comp_colors[part] == comp_colors[source], \"T source diagonals must share a color\"\n                dsu.union(source, part)\n\n            for comp in adjacent_component_counts(marker[\"cells\"]):\n                if comp_colors[comp] == comp_colors[source]:\n                    dsu.union(source, comp)\n            marker[\"dest_comp\"] = dest\n            marker[\"source_comp\"] = source\n        else:\n            counts = adjacent_component_counts(marker[\"cells\"])\n            assert counts, \"small marker must touch its owner region\"\n            owner = max(counts, key=lambda c: (counts[c], comp_areas[c]))\n            for comp in counts:\n                if comp_colors[comp] == comp_colors[owner]:\n                    dsu.union(owner, comp)\n            marker[\"source_comp\"] = owner\n\n    root_color: dict[int, int] = {}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/fc7cae8d.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import crop_bbox, find_components, get_bg, paste, random_free_location\nimport random\nfrom arc_utils import paste, random_free_location\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Align a central rectangle to two colored frame-edge controls via rotation/reflection.\n\n    Input structure:\n    - bg grid with two solid-colored border edges (distinct non-bg colors).\n    - A central filled rectangle with 1px colored guide edges on two sides, colors matching the frame controls.\n\n    Rule:\n    - Rotate/mirror the object so its guide edges face the same sides as the matching frame controls.\n    - Crop off the 1px guide edges from aligned sides.\n\n    Key insight: Guide-edge colors encode target frame sides; the correct dihedral transform matches both simultaneously.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    def detect_controls_frame(arr: np.ndarray) -> list[tuple[str, int]]:\n        H, W = arr.shape\n        sides = {\n            \"top\": arr[0, 1:-1],\n            \"bottom\": arr[-1, 1:-1],\n            \"left\": arr[1:-1, 0],\n            \"right\": arr[1:-1, -1],\n        }\n        cand: list[tuple[str, int, int, int]] = []\n        for side, v in sides.items():\n            v = list(map(int, v))\n            v_nb = [x for x in v if x != int(bg)]\n            if not v_nb:\n                continue\n            col, count = Counter(v_nb).most_common(1)[0]\n            # allow up to 1 mismatch (overlap near corners with the other control color)\n            if int(count) >= len(v) - 1:\n                cand.append((side, int(col), int(count), int(len(v))))\n        cand.sort(key=lambda t: (t[2] / t[3], t[2]), reverse=True)\n        return [(s, c) for s, c, _cnt, _L in cand[:2]]\n\n    def extract_center_object(arr: np.ndarray) -> np.ndarray:\n        H, W = arr.shape\n        comps = find_components(arr, bg=int(bg), connectivity=4, monochromatic=False, return_format=\"dict\")\n        best = None  # (area, bbox)\n        for comp in comps:\n            r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n            if bool(r0 == 0 or c0 == 0 or r1 == H - 1 or c1 == W - 1):\n                continue\n            area = int(comp[\"area\"])\n            if best is None or area > best[0]:\n                best = (area, (r0, c0, r1, c1))\n        if best is None:\n            return arr.copy()\n        _area, b = best\n        return crop_bbox(arr, b)\n\n    def guide_edges(arr: np.ndarray) -> dict[str, int]:\n        fill = int(Counter(map(int, arr.flatten())).most_common(1)[0][0])\n        edges = {\n            \"top\": arr[0, :],\n            \"bottom\": arr[-1, :],\n            \"left\": arr[:, 0],\n            \"right\": arr[:, -1],\n        }\n        out: dict[str, int] = {}\n        for side, v in edges.items():\n            v = list(map(int, v))\n            v_nf = [x for x in v if x != int(fill)]\n            if not v_nf:\n                continue\n            col, count = Counter(v_nf).most_common(1)[0]\n            if int(count) >= len(v) - 1:\n                out[side] = int(col)\n        return out\n\n    ctrls = detect_controls_frame(g)\n    desired = {side: col for side, col in ctrls}\n    obj = extract_center_object(g)\n\n    # Try all dihedral transforms: rotations + optional horizontal flip.\n    for k in range(4):\n        base = np.rot90(obj, int(k))\n        for flip in [False, True]:\n            t = np.fliplr(base) if flip else base\n            gedges = guide_edges(t)\n            if all(side in gedges and int(gedges[side]) == int(col) for side, col in desired.items()):\n                top = 1 if \"top\" in desired else 0\n                bottom = int(t.shape[0]) - (1 if \"bottom\" in desired else 0)\n                left = 1 if \"left\" in desired else 0\n                right = int(t.shape[1]) - (1 if \"right\" in desired else 0)\n                return t[int(top) : int(bottom), int(left) : int(right)]\n\n    # Fallback: should not happen on this puzzle.\n    return obj\n\n# --------------- generator (Codex#2) ---------------\n\ndef _transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:\n    out = np.rot90(arr, int(k))\n    return np.fliplr(out) if flip else out\n\n\ndef _inverse_transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:\n    out = np.fliplr(arr) if flip else arr\n    return np.rot90(out, -int(k))\n\n\ndef _build_core(h: int, w: int, fill: int, pattern_colors: list[int]) -> np.ndarray:\n    core = np.full((h, w), int(fill), dtype=int)\n    area = h * w\n    max_nonfill = max(len(pattern_colors), int(area * 0.35))\n    target_nonfill = random.randint(max(len(pattern_colors), area // 10), max_nonfill)\n    painted = 0\n\n    for color in pattern_colors:\n        r = random.randrange(h)\n        c = random.randrange(w)\n        core[r, c] = int(color)\n        painted += 1\n\n    while painted < target_nonfill:\n        color = random.choice(pattern_colors)\n        shape_kind = random.choice([\"dot\", \"line\", \"rect\"])\n        if shape_kind == \"dot\":\n            cells = [(random.randrange(h), random.randrange(w))]\n        elif shape_kind == \"line\":\n            line_len = random.randint(2, min(5, max(h, w)))\n            if random.random() < 0.5:\n                rr = random.randrange(h)\n                c0 = random.randrange(max(1, w - line_len + 1))\n                cells = [(rr, c0 + dc) for dc in range(line_len)]\n            else:\n                r0 = random.randrange(max(1, h - line_len + 1))\n                cc = random.randrange(w)\n                cells = [(r0 + dr, cc) for dr in range(line_len)]\n        else:\n            mh = random.randint(1, min(3, h))\n            mw = random.randint(1, min(3, w))\n            r0 = random.randrange(h - mh + 1)\n            c0 = random.randrange(w - mw + 1)\n            cells = [(r0 + dr, c0 + dc) for dr in range(mh) for dc in range(mw)]\n\n        remaining = target_nonfill - painted\n        if remaining <= 0:\n            break\n        fill_cells = [(r, c) for r, c in cells if core[r, c] == fill]\n        if len(fill_cells) > remaining:\n            fill_cells = random.sample(fill_cells, remaining)\n        for r, c in fill_cells:\n            core[r, c] = int(color)\n        painted += len(fill_cells)\n        for r, c in cells:\n            if core[r, c] != fill:\n                continue\n            if painted >= target_nonfill:\n                break\n            core[r, c] = int(color)\n            painted += 1\n\n    return core\n\n\ndef _attach_guides(core: np.ndarray, guide_sides: tuple[str, str], guide_colors: dict[str, int]) -> np.ndarray:\n    h, w = core.shape\n    has_top = \"top\" in guide_sides\n    has_bottom = \"bottom\" in guide_sides\n    has_left = \"left\" in guide_sides\n    has_right = \"right\" in guide_sides\n    out = np.zeros((h + has_top + has_bottom, w + has_left + has_right), dtype=int)\n    r0 = 1 if has_top else 0\n    c0 = 1 if has_left else 0\n    paste(out, core, r0, c0)\n\n    if has_top:\n        out[0, c0 : c0 + w] = int(guide_colors[\"top\"])\n    if has_bottom:\n        out[-1, c0 : c0 + w] = int(guide_colors[\"bottom\"])\n    if has_left:\n        out[r0 : r0 + h, 0] = int(guide_colors[\"left\"])\n    if has_right:\n        out[r0 : r0 + h, -1] = int(guide_colors[\"right\"])\n\n    if has_top and has_left:\n        out[0, 0] = 0\n    if has_top and has_right:\n        out[0, -1] = 0\n    if has_bottom and has_left:\n        out[-1, 0] = 0\n    if has_bottom and has_right:\n        out[-1, -1] = 0\n    return out\n\n\ndef _paint_frame(grid: np.ndarray, horiz_side: str, vert_side: str, ctrl_h: int, ctrl_v: int) -> None:\n    n = grid.shape[0]\n    if horiz_side == \"top\":\n        grid[0, :] = int(ctrl_h)\n    else:\n        grid[-1, :] = int(ctrl_h)\n    if vert_side == \"left\":\n        grid[:, 0] = int(ctrl_v)\n    else:\n        grid[:, -1] = int(ctrl_v)\n\n    for side in (\"top\", \"bottom\", \"left\", \"right\"):\n        if side in (horiz_side, vert_side):\n            continue\n        if side in (\"top\", \"bottom\"):\n            r = 0 if side == \"top\" else n - 1\n            coords = [(r, c) for c in range(1, n - 1)]\n        else:\n            c = 0 if side == \"left\" else n - 1\n            coords = [(r, c) for r in range(1, n - 1)]\n        min_count = int(np.ceil(0.35 * len(coords)))\n        max_count = int(np.floor(0.60 * len(coords)))\n","exit_code":0,"status":"completed"}}
