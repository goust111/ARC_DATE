{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\n\ndef path(h,w):\n    pts=[]\n    for r in range(h):\n        if r%2==0:\n            pts += [(r,c) for c in range(w)]\n        else:\n            pts += [(r,c) for c in range(w-1,-1,-1)]\n    return pts\n\ndef full(seg,h,w):\n    rs=[r for r,c in seg]; cs=[c for r,c in seg]\n    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1\nfor h,w in [(4,4),(4,5),(5,5),(5,6),(6,6)]:\n    pts=path(h,w); n=len(pts)\n    ok=0\n    lens=[]\n    for k in range(1,n):\n        a=pts[:k]\n        b=pts[k:]\n        if len(a)==len(b):\n            continue\n        if full(a,h,w) and full(b,h,w):\n            ok+=1;lens.append(k)\n    print((h,w), ok, lens[:10])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
