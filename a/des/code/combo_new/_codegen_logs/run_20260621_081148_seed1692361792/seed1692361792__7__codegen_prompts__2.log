{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\n\ndef spiral(h,w):\n    top,left=0,0\n    bottom,right=h-1,w-1\n    pts=[]\n    while top<=bottom and left<=right:\n        for c in range(left,right+1): pts.append((top,c))\n        top+=1\n        for r in range(top,bottom+1): pts.append((r,right))\n        right-=1\n        if top<=bottom:\n            for c in range(right,left-1,-1): pts.append((bottom,c))\n            bottom-=1\n        if left<=right:\n            for r in range(bottom,top-1,-1): pts.append((r,left))\n            left+=1\n    return pts\n\ndef full(seg,h,w):\n    rs=[r for r,c in seg]; cs=[c for r,c in seg]\n    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1\nfor h,w in [(4,4),(4,5),(5,5),(5,6),(6,6),(6,7)]:\n    pts=list(reversed(spiral(h,w)))\n    # verify adjacency\n    okadj=all(abs(pts[i][0]-pts[i+1][0])+abs(pts[i][1]-pts[i+1][1])==1 for i in range(len(pts)-1))\n    valid=[]\n    for k in range(1,len(pts)):\n        a=pts[:k]; b=pts[k:]\n        if len(a)==len(b):\n            continue\n        if full(a,h,w) and full(b,h,w):\n            valid.append(k)\n    print((h,w),'adj',okadj,'count',len(valid),'first',valid[:20])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
