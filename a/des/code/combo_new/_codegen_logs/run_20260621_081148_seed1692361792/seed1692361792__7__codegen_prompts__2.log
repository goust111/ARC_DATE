{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\n\ndef cycle(h,w):\n    pts=[]\n    pts += [(0,c) for c in range(w)]\n    for r in range(1,h):\n        if r == h-1:\n            pts += [(r,c) for c in range(w-1,-1,-1)]\n        elif r % 2 == 1:\n            pts += [(r,c) for c in range(w-1,0,-1)]\n        else:\n            pts += [(r,c) for c in range(1,w)]\n    pts += [(r,0) for r in range(h-2,0,-1)]\n    return pts\n\ndef full(seg,h,w):\n    rs=[r for r,c in seg]; cs=[c for r,c in seg]\n    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1\n\nfor h,w in [(4,4),(4,5),(6,5),(6,6)]:\n    cyc=cycle(h,w); n=len(cyc)\n    ok=0\n    for i in range(n):\n        for k in range(1,n):\n            a=[cyc[(i+t)%n] for t in range(k)]\n            b=[cyc[(i+t)%n] for t in range(k,n)]\n            if len(a)==len(b):\n                continue\n            if full(a,h,w) and full(b,h,w):\n                ok+=1\n    print((h,w), n, ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
