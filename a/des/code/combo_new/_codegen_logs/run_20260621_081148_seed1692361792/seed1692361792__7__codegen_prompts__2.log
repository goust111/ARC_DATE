{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools, math, numpy as np\nDIR8=[(dr,dc) for dr in (-1,0,1) for dc in (-1,0,1) if dr or dc]\n\ndef conn(mask):\n    coords=np.argwhere(mask)\n    if len(coords)==0:return False\n    seen={tuple(coords[0])}; stack=[tuple(coords[0])]; h,w=mask.shape\n    while stack:\n        r,c=stack.pop()\n        for dr,dc in DIR8:\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:\n                seen.add((nr,nc)); stack.append((nr,nc))\n    return len(seen)==len(coords)\nfor h,w in [(4,4),(4,5),(5,5),(5,6),(6,6)]:\n    total=0; ok=0\n    n=(h-1)+(w-1)\n    moves='D'*(h-1)+'R'*(w-1)\n    for downs in itertools.combinations(range(n), h-1):\n        total+=1\n        seq=['R']*n\n        for i in downs: seq[i]='D'\n        r=c=0\n        m=np.zeros((h,w),bool); m[0,0]=1\n        for mv in seq:\n            if mv=='D': r+=1\n            else: c+=1\n            m[r,c]=1\n        if conn(~m):\n            ok+=1\n    print((h,w), ok, '/', total)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
