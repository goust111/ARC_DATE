{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np, time\n\ndef is_conn(mask):\n    coords=np.argwhere(mask)\n    if len(coords)==0: return False\n    seen={tuple(coords[0])}\n    stack=[tuple(coords[0])]\n    h,w=mask.shape\n    while stack:\n        r,c=stack.pop()\n        nr=r+1\n        if nr<h and mask[nr,c] and (nr,c) not in seen: seen.add((nr,c)); stack.append((nr,c))\n        nr=r-1\n        if nr>=0 and mask[nr,c] and (nr,c) not in seen: seen.add((nr,c)); stack.append((nr,c))\n        nc=c+1\n        if nc<w and mask[r,nc] and (r,nc) not in seen: seen.add((r,nc)); stack.append((r,nc))\n        nc=c-1\n        if nc>=0 and mask[r,nc] and (r,nc) not in seen: seen.add((r,nc)); stack.append((r,nc))\n    return len(seen)==len(coords)\n\ndef full(mask):\n    coords=np.argwhere(mask)\n    rs=coords[:,0]; cs=coords[:,1]\n    return rs.min()==0 and rs.max()==mask.shape[0]-1 and cs.min()==0 and cs.max()==mask.shape[1]-1\n\ndef gen(h,w,tries=300):\n    area=h*w\n    cells=[(r,c) for r in range(h) for c in range(w)]\n    side_choices={\n      'top': [(0,c) for c in range(w)],\n      'bottom': [(h-1,c) for c in range(w)],\n      'left': [(r,0) for r in range(h)],\n      'right': [(r,w-1) for r in range(h)],\n    }\n    for _ in range(tries):\n        seeds=[]\n        used=set()\n        for side in ('top','bottom','left','right'):\n            opts=[p for p in side_choices[side] if p not in used]\n            p=random.choice(opts) if opts else random.choice(side_choices[side])\n            seeds.append(p); used.add(p)\n        mask=np.zeros((h,w),dtype=bool)\n        frontier=[]\n        for p in seeds:\n            mask[p]=1\n        # connect seeds to first via shortest paths with random hv/vh order\n        connected={seeds[0]}\n        for p in seeds[1:]:\n            start=random.choice(list(connected))\n            path=[]\n            r,c=start\n            tr,tc=p\n            if random.random()<0.5:\n                while c\"'!=tc:\n                    c += 1 if tc>c else -1; path.append((r,c))\n                while r!=tr:\n                    r += 1 if tr>r else -1; path.append((r,c))\n            else:\n                while r!=tr:\n                    r += 1 if tr>r else -1; path.append((r,c))\n                while c!=tc:\n                    c += 1 if tc>c else -1; path.append((r,c))\n            for q in path:\n                mask[q]=1; connected.add(q)\n            connected.add(p)\n        target=random.randint(max(len(np.argwhere(mask))+1, area//5), min(area-area//5, area-1))\n        while int(mask.sum())<target:\n            boundary=[]\n            pts=np.argwhere(mask)\n            for r,c in pts:\n                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                    nr,nc=r+dr,c+dc\n                    if 0<=nr<h and 0<=nc<w and not mask[nr,nc]:\n                        boundary.append((nr,nc))\n            if not boundary: break\n            nr,nc=random.choice(boundary)\n            mask[nr,nc]=1\n            if random.random()<0.2 and int(mask.sum())>area//3:\n                break\n        comp=~mask\n        if mask.sum()==comp.sum() or mask.sum()==0 or comp.sum()==0: continue\n        if is_conn(mask) and is_conn(comp) and full(mask) and full(comp):\n            return True, mask.sum(), comp.sum()\n    return False,None,None\n\nstart=time.time()\nfor dims in [(4,4),(4,5),(5,5),(5,6),(6,6)]:\n    ok=0\n    for _ in range(200):\n        if gen(*dims)[0]: ok+=1\n    print(dims, ok)\nprint('\"'time', time.time()-start)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
