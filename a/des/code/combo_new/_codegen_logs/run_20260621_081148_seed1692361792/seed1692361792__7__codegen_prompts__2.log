{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np\n\ndef connected(mask):\n    h,w=mask.shape\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r,c]]\n    if not pts:\n        return False\n    seen={pts[0]}\n    stack=[pts[0]]\n    while stack:\n        r,c=stack.pop()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:\n                seen.add((nr,nc)); stack.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef full_bbox(mask):\n    rs,cs=np.where(mask)\n    return rs.min()==0 and rs.max()==mask.shape[0]-1 and cs.min()==0 and cs.max()==mask.shape[1]-1\n\ndef gen(h,w,tries=5000):\n    area=h*w\n    for _ in range(tries):\n        start=(random.randrange(h),random.randrange(w))\n        path=[start]\n        seen={start}\n        touched={('top' if start[0]==0 else None),('bottom' if start[0]==h-1 else None),('left' if start[1]==0 else None),('right' if start[1]==w-1 else None)}-{None}\n        target=random.randint(max(5,(h+w)//2), area-5)\n        dead=0\n        while len(path)<target and dead<40:\n            r,c=path[-1]\n            nbr=[(r+dr,c+dc) for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)) if 0<=r+dr<h and 0<=c+dc<w and (r+dr,c+dc) not in seen]\n            if not nbr:\n                # maybe branch from any existing path point\n                frontier=[]\n                for pr,pc in path:\n                    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                        q=(pr+dr,pc+dc)\n                        if 0<=q[0]<h and 0<=q[1]<w and q not in seen:\n                            frontier.append((q,(pr,pc)))\n                if not frontier:\n                    break\n                q,parent=random.choice(frontier)\n                path.append(q)\n                seen.add(q)\n                r,c=q\n            else:\n                q=random.choice(nbr)\n                path.append(q)\n                seen.add(q)\n                r,c=q\n            if r==0: touched.add('top')\n            if r==h-1: touched.add('bottom')\n            if c==0: touched.add('left')\n            if c==w-1: touched.add('right')\n            if len(touched)==4 and random.random()<0.35:\n                break\n        mask=np.zeros((h,w),bool)\n        for r,c in seen: mask[r,c]=1\n        comp=~mask\n        if mask.sum() in (0,area) or mask.sum()==comp.sum():\n            continue\n        if connected(mask) and connected(comp) and full_bbox(mask) and full_bbox(comp):\n            return mask\n    return None\n\nfor h,w in [(4,4),(4,5),(5,5),(5,6),(6,6)]:\n    ok=0\n    for _ in range(200):\n        if gen(h,w) is not None:\n            ok+=1\n    print((h,w), ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
