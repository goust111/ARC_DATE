{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np, itertools\n\ndef conn(mask):\n    coords=[(r,c) for r in range(mask.shape[0]) for c in range(mask.shape[1]) if mask[r,c]]\n    if not coords: return False\n    seen={coords[0]}; stack=[coords[0]]; h,w=mask.shape\n    while stack:\n        r,c=stack.pop()\n        for nr,nc in ((r+1,c),(r-1,c),(r,c+1),(r,c-1)):\n            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:\n                seen.add((nr,nc)); stack.append((nr,nc))\n    return len(seen)==len(coords)\n\ndef full(mask):\n    coords=[(r,c) for r in range(mask.shape[0]) for c in range(mask.shape[1]) if mask[r,c]]\n    rs=[r for r,c in coords]; cs=[c for r,c in coords]\n    return min(rs)==0 and max(rs)==mask.shape[0]-1 and min(cs)==0 and max(cs)==mask.shape[1]-1\n\ndef show(mask):\n    for r in range(mask.shape[0]):\n        print(''.join('#' if mask[r,c] else '.' for c in range(mask.shape[1])))\n\ndef sample(h,w,trials=500000):\n    n=h*w\n    found=0\n    for _ in range(trials):\n        bits=random.getrandbits(n)\n        if bits==0 or bits==(1<<n)-1: continue\n        m=np.zeros((h,w),dtype=bool)\n        for i in range(n):\n            if bits>>i & 1: m[i//w,i%w]=1\n        c=~m\n        if m.sum()==c.sum() or not conn(m) or not conn(c) or not full(m) or not full(c):\n            continue\n        print('area', int(m.sum()), int(c.sum()))\n        show(m); print(); show(c); return True\n    print('none found')\n    return False\n\nfor dims in [(4,5),(4,6),(5,5),(5,6),(6,6)]:\n    print('dims', dims)\n    sample(*dims, trials=200000)\n    print('---')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np, itertools\n\ndef conn(mask):\n    coords=[(r,c) for r in range(mask.shape[0]) for c in range(mask.shape[1]) if mask[r,c]]\n    if not coords: return False\n    seen={coords[0]}; stack=[coords[0]]; h,w=mask.shape\n    while stack:\n        r,c=stack.pop()\n        for nr,nc in ((r+1,c),(r-1,c),(r,c+1),(r,c-1)):\n            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:\n                seen.add((nr,nc)); stack.append((nr,nc))\n    return len(seen)==len(coords)\n\ndef full(mask):\n    coords=[(r,c) for r in range(mask.shape[0]) for c in range(mask.shape[1]) if mask[r,c]]\n    rs=[r for r,c in coords]; cs=[c for r,c in coords]\n    return min(rs)==0 and max(rs)==mask.shape[0]-1 and min(cs)==0 and max(cs)==mask.shape[1]-1\n\ndef show(mask):\n    for r in range(mask.shape[0]):\n        print(''.join('#' if mask[r,c] else '.' for c in range(mask.shape[1])))\n\ndef sample(h,w,trials=500000):\n    n=h*w\n    found=0\n    for _ in range(trials):\n        bits=random.getrandbits(n)\n        if bits==0 or bits==(1<<n)-1: continue\n        m=np.zeros((h,w),dtype=bool)\n        for i in range(n):\n            if bits>>i & 1: m[i//w,i%w]=1\n        c=~m\n        if m.sum()==c.sum() or not conn(m) or not conn(c) or not full(m) or not full(c):\n            continue\n        print('area', int(m.sum()), int(c.sum()))\n        show(m); print(); show(c); return True\n    print('none found')\n    return False\n\nfor dims in [(4,5),(4,6),(5,5),(5,6),(6,6)]:\n    print('dims', dims)\n    sample(*dims, trials=200000)\n    print('---')\nPY\"","aggregated_output":"dims (4, 5)\nnone found\n---\ndims (4, 6)\nnone found\n---\ndims (5, 5)\nnone found\n---\ndims (5, 6)\nnone found\n---\ndims (6, 6)\nnone found\n---\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np, time\n\ndef conn(mask, dirs):\n    coords=np.argwhere(mask)\n    if len(coords)==0:return False\n    seen={tuple(coords[0])}; stack=[tuple(coords[0])]; h,w=mask.shape\n    while stack:\n        r,c=stack.pop()\n        for dr,dc in dirs:\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:\n                seen.add((nr,nc)); stack.append((nr,nc))\n    return len(seen)==len(coords)\n\ndef full(mask):\n    coords=np.argwhere(mask)\n    rs=coords[:,0]; cs=coords[:,1]\n    return rs.min()==0 and rs.max()==mask.shape[0]-1 and cs.min()==0 and cs.max()==mask.shape[1]-1\nDIR8=[(dr,dc) for dr in (-1,0,1) for dc in (-1,0,1) if dr or dc]\nfor dims in [(4,4),(4,5),(5,5),(5,6),(6,6)]:\n    h,w=dims\n    ok=0\n    for _ in range(5000):\n        m=np.random.rand(h,w)<0.5\n        c=~m\n        if m.sum()==c.sum() or m.sum()==0 or c.sum()==0: continue\n        if conn(m,DIR8) and conn(c,DIR8) and full(m) and full(c):\n            ok+=1\n            if ok==1:\n                print('example', dims)\n                for r in range(h): print(''.join('#' if m[r,c] else '.' for c in range(w)))\n            if ok>10: break\n    print(dims, ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
