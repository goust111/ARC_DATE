{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np, time\n\ndef conn(mask):\n    pts=np.argwhere(mask)\n    if len(pts)==0:return False\n    seen={tuple(pts[0])}; stack=[tuple(pts[0])]; h,w=mask.shape\n    while stack:\n        r,c=stack.pop()\n        for nr,nc in ((r+1,c),(r-1,c),(r,c+1),(r,c-1)):\n            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:\n                seen.add((nr,nc)); stack.append((nr,nc))\n    return len(seen)==len(pts)\n\ndef full(mask):\n    pts=np.argwhere(mask)\n    rs=pts[:,0]; cs=pts[:,1]\n    return rs.min()==0 and rs.max()==mask.shape[0]-1 and cs.min()==0 and cs.max()==mask.shape[1]-1\n\ndef draw_path(mask,a,b,mode):\n    r,c=a; tr,tc=b\n    if mode==0:\n        step=1 if tc>=c else -1\n        for cc in range(c, tc+step, step): mask[r,cc]=1\n        step=1 if tr>=r else -1\n        for rr in range(r, tr+step, step): mask[rr,tc]=1\n    else:\n        step=1 if tr>=r else -1\n        for rr in range(r, tr+step, step): mask[rr,c]=1\n        step=1 if tc>=c else -1\n        for cc in range(c, tc+step, step): mask[tr,cc]=1\n\ndef gen(h,w,tries=500):\n    sides={\n        'top':[(0,c) for c in range(1,w-1)],\n        'bottom':[(h-1,c) for c in range(1,w-1)],\n        'left':[(r,0) for r in range(1,h-1)],\n        'right':[(r,w-1) for r in range(1,h-1)],\n    }\n    orders=[('top','left','right','bottom'),('left','top','bottom','right'),('top','right','left','bottom'),('left','bottom','top','right')]\n    for _ in range(tries):\n        if h<3 or w<3: return None\n        pts={side: random.choice(cands) for side,cands in sides.items()}\n        order=random.choice(orders)\n        mask=np.zeros((h,w),bool)\n        ok=True\n        for s1,s2 in zip(order,order[1:]):\n            mode=random.randint(0,1)\n            draw_path(mask, pts[s1], pts[s2], mode)\n        if not conn(mask):\n            continue\n        comp=~mask\n        if mask.sum()==comp.sum() or mask.sum()==0 or comp.sum()==0: continue\n        if conn(comp) and full(mask) and full(comp):\n            return mask\n    return None\n\nstart=time.time()\nfor dims in [(4,4),(4,5),(5,5),(5,6),(6,6),(7,6)]:\n    ok=0\n    for _ in range(200):\n        if gen(*dims) is not None: ok+=1\n    print(dims, ok)\nprint('time', time.time()-start)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
