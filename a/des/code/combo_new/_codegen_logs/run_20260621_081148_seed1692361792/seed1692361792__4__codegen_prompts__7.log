TE_COLORS, 3)\n\n    height = random.randint(*BBOX_HEIGHT_BOUNDS)\n    width = random.randint(*BBOX_WIDTH_BOUNDS)\n    r0 = random.randint(INTERIOR_ROW_BOUNDS[0], INTERIOR_ROW_BOUNDS[1] - height + 1)\n    c0 = random.randint(INTERIOR_COL_BOUNDS[0], INTERIOR_COL_BOUNDS[1] - width + 1)\n    r1 = r0 + height - 1\n    c1 = c0 + width - 1\n\n    out = _gen_blank_grid(winner_color)\n    _gen_draw_outline(out, r0, c0, r1, c1, winner_color)\n\n    inp = _gen_blank_grid(frame_color)\n\n    if random.choice(DIAGONAL_CHOICES):\n        required = [(r0, c0), (r1, c1)]\n    else:\n        required = [(r0, c1), (r1, c0)]\n\n    bbox_cells = [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]\n    extra_cells = [cell for cell in bbox_cells if cell not in required]\n    winner_count = random.randint(WINNER_COUNT_BOUNDS[0], min(WINNER_COUNT_BOUNDS[1], len(bbox_cells)))\n    winner_cells = required + random.sample(extra_cells, winner_count - len(required))\n\n    used = set(winner_cells)\n    for r, c in winner_cells:\n        inp[r, c] = winner_color\n\n    free_interior = [\n        (r, c)\n        for r in range(INTERIOR_ROW_BOUNDS[0], INTERIOR_ROW_BOUNDS[1] + 1)\n        for c in range(INTERIOR_COL_BOUNDS[0], INTERIOR_COL_BOUNDS[1] + 1)\n        if (r, c) not in used\n    ]\n    loser_count = random.randint(1, min(winner_count - 1, len(free_interior)))\n    for r, c in random.sample(free_interior, loser_count):\n        inp[r, c] = loser_color\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n===== /home/lixinyu/snap/new/ARC_code/train/34cfa167.py =====\n--- _gen_attempt (294-333) ---\ndef _gen_attempt() -> np.ndarray | None:\n    bg = int(np.random.randint(COLOR_COUNT))\n    palette = [color for color in range(COLOR_COUNT) if color != bg]\n    anchor_color, right1, right2, below1 = map(\n        int, np.random.choice(palette, NON_BG_COLOR_COUNT, replace=False)\n    )\n\n    s = int(np.random.randint(ANCHOR_SIZE_RANGE[0], ANCHOR_SIZE_RANGE[1]))\n    nh = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))\n    nv = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))\n    struct_h = 2 * s + FRAME_PERIOD * nv + STRUCTURE_FIXED_PAD\n    struct_w = 2 * s + FRAME_PERIOD * nh + STRUCTURE_FIXED_PAD\n\n    top, bottom = _choose_margins(struct_h)\n    left, right = _choose_margins(struct_w)\n    rows, cols = struct_h + top + bottom, struct_w + left + right\n    sr0, sc0 = top + SOURCE_OUTER_MARGIN, left + SOURCE_OUTER_MARGIN\n\n    out, box = _build_output(\n        rows,\n        cols,\n        bg,\n        anchor_color,\n        right1,\n        right2,\n        below1,\n        sr0,\n        sc0,\n        s,\n        nh,\n        nv,\n    )\n    inp = _derive_input(out, bg, *box)\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\n===== /home/lixinyu/snap/new/ARC_code/eval/581f7754.py =====\n--- _gen_attempt (487-505) ---\ndef _gen_attempt():\n    bg, out, inp = _new_canvas_pair()\n    placed = _place_anchors(out, inp, bg)\n    if placed is None:\n        return None\n    anchor_colors, anchors = placed\n\n    marker_colors = _marker_color_sequence(anchor_colors)\n    sprites = _place_aligned_sprites(out, anchors, marker_colors, bg)\n    if sprites is None:\n        return None\n\n    if not _scatter_sprites(inp, sprites, bg):\n        return None\n\n    _add_distractors(out, inp, anchors, bg)\n    if not _generated_grid_is_valid(inp, out, bg):\n        return None\n    return inp\n\n","exit_code":0,"status":"completed"}}
