terns per frame and represent the tally as dots inside.\n   9: \n  10:     Input structure:\n  11:     - bg = most common color.\n  12:     - Hollow rectangular frames in various colors.\n  13:     - Small monochrome pattern sprites scattered outside frames.\n  14: \n  15:     Rule:\n  16:     - Remove all small patterns from the grid.\n  17:     - For each frame of color C, count how many patterns share color C.\n  18:     - Draw that many dots along the frame's center row, spaced by 2, starting from the right.\n  19: \n  20:     Key insight: Frames act as tally displays — scattered same-color patterns are \"absorbed\" and their count is shown as interior dots.\n  21:     \"\"\"\n  22:     g = np.array(grid, dtype=int)\n  23:     out = g.copy()\n  24:     bg = int(get_bg(g))\n  25: \n  26:     regions = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n  27: \n  28:     frames: list[dict] = []\n  29:     patterns: list[dict] = []\n  30:     for comp in regions:\n  31:         b = comp[\"bbox\"]\n  32:         h = bbox_h(b)\n  33:         w = bbox_w(b)\n  34:         area = int(comp[\"area\"])\n  35:         is_frame = (h >= 5) and (w >= 5) and (area < (h * w * 0.7))\n  36:         if is_frame:\n  37:             frames.append(comp)\n  38:         else:\n  39:             patterns.append(comp)\n  40: \n  41:     # Remove patterns from output.\n  42:     for p in patterns:\n  43:         for r, c in p[\"coords\"]:\n  44:             out[int(r), int(c)] = bg\n  45: \n  46:     # For each frame, count matching patterns and draw dots.\n  47:     for f in frames:\n  48:         col = int(f[\"color\"])\n  49:         num_patterns = sum(1 for p in patterns if int(p[\"color\"]) == col)\n  50:         if num_patterns <= 0:\n  51:             continue\n  52: \n  53:         r0, c0, r1, c1 = map(int, f[\"bbox\"])\n  54:         r_mid = (r0 + r1) // 2\n  55:         for i in range(int(num_patterns)):\n  56:             cc = int(c1 - 2 - 2 * i)\n  57:             if cc > int(c0):\n  58:                 out[int(r_mid), int(cc)] = col\n  59: \n  60:     return out\n  61: \n  62: # --------------- generator (codex-att2) ---------------\n  63: \n  64: # --- layout geometry ---\n  65: FRAME_H = 5                    # frame height (rows)\n  66: FRAME_W = 11                   # frame width (cols)\n  67: FRAME_R0 = 1                   # top-left row of first frame\n  68: FRAME_C0 = 1                   # top-left col of all frames\n  69: FRAME_GAP = 2                  # bg rows between consecutive frames\n  70: GRID_W = 23                    # fixed grid width\n  71: RIGHT_C0 = 13                  # first column of the right (sprite) region\n  72: RIGHT_W = 9                    # width of the right region\n  73: \n  74: # --- structural counts ---\n  75: N_FRAMES_RANGE = (3, 5)        # [lo, hi) for number of frames\n  76: N_DISTRACTORS_RANGE = (1, 3)   # [lo, hi) for distractor sprite count\n  77: TOTAL_PATTERNS_RANGE = (5, 11) # [lo, hi) for total sprite count\n  78: MAX_DOTS_PER_FRAME = 4         # max dot tally inside one frame\n  79: BOTTOM_PAD_RANGE = (0, 7)      # [lo, hi) extra bg rows when n_frames==3\n  80: \n  81: # --- sprite shape ---\n  82: SPRITE_AREA_RANGE = (2, 9)     # [lo, hi) connected-cell count per sprite\n  83: SPRITE_MAX_H = 4               # max bbox height for sprite\n  84: SPRITE_MAX_W = 3               # max bbox width for sprite\n  85: SPRITE_PADDING = 1             # gap between placed sprites\n  86: \n  87: # --- retry budget ---\n  88: MAX_ATTEMPTS = 300\n  89: \n  90: \n  91: def _frame_patch(color: int, bg: int, n_dots: int) -> np.ndarray:\n  92:     \"\"\"Build a FRAME_H x FRAME_W hollow rectangle with n_dots on the center row.\"\"\"\n  93:     patch = np.full((FRAME_H, FRAME_W), bg, dtype=int)\n  94:     patch[0, :] = color\n  95:     patch[-1, :] = color\n  96:     patch[:, 0] = color\n  97:     patch[:, -1] = color\n  98:     mid_r = FRAME_H // 2\n  99:     dot_cols = [FRAME_W - 3 - 2 * i for i in range(n_dots)]\n 100:     patch[mid_r, dot_cols] = color\n 101:     return patch\n 102: \n 103: \n 104: def _sample_counts(rng: np.random.Generator, n_frames: int, total_match: int) -> list[int]:\n 105:     \"\"\"Distribute total_match sprites across n_frames, each capped at MAX_DOTS_PER_FRAME.\"\"\"\n 106:     counts = [0] * n_frames\n 107:     order = rng.permutation(n_frames)\n 108:     remaining = total_match\n 109:     for pos, idx in enumerate(order):\n 110:         frames_left = n_frames - pos - 1\n 111:         lo = max(0, remaining - MAX_DOTS_PER_FRAME * frames_left)\n 112:         hi = min(MAX_DOTS_PER_FRAME, remaining)\n 113:         val = int(rng.integers(lo, hi + 1))\n 114:         counts[int(idx)] = val\n 115:         remaining -= val\n 116:     return counts\n 117: \n 118: \n 119: def _grow_sprite(rng: np.random.Generator, h: int, w: int, area: int) -> list[tuple[int, int]]:\n 120:     \"\"\"Grow a connected polyomino of the given area inside an h x w bounding box.\"\"\"\n 121:     seed = (int(rng.integers(0, h)), int(rng.integers(0, w)))\n 122:     cells = {seed}\n 123:     while len(cells) < area:\n 124:         frontier = []\n 125:         for r, c in cells:\n 126:             for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n 127:                 nb = (r + dr, c + dc)\n 128:                 if 0 <= nb[0] < h and 0 <= nb[1] < w and nb not in cells:\n 129:                     frontier.append(nb)\n 130:         cells.add(frontier[int(rng.integers(0, len(frontier)))])\n 131:     return list(cells)\n 132: \n 133: \n 134: def _make_sprite(rng: np.random.Generator, color: int, bg: int) -> np.ndarray:\n 135:     \"\"\"Generate a small random connected sprite, tight-cropped to its bounding box.\"\"\"\n 136:     area = int(rng.integers(*SPRITE_AREA_RANGE))\n 137:     dims = [(h, w) for h in range(1, SPRITE_MAX_H + 1)\n 138:             for w in range(1, SPRITE_MAX_W + 1) if h * w >= area]\n 139:     h, w = dims[int(rng.integers(0, len(dims)))]\n 140:     cells = _grow_sprite(rng, h, w, area)\n 141:     rs, cs = zip(*cells)\n 142:     r_min, c_min = min(rs), min(cs)\n 143:     patch = np.full((max(rs) - r_min + 1, max(cs) - c_min + 1), bg, dtype=int)\n 144:     for r, c in cells:\n 145:         patch[r - r_min, c - c_min] = color\n 146:     return patch\n 147: \n 148: \n 149: def _gen_attempt() -> np.ndarray | None:\n 150:     rng = np.random.default_rng()\n 151: \n 152:     # --- choose structure ---\n 153:     n_frames = int(rng.integers(*N_FRAMES_RANGE))\n 154:     n_distractors = int(rng.integers(*N_DISTRACTORS_RANGE))\n 155:     total_patterns = int(rng.integers(*TOTAL_PATTERNS_RANGE))\n 156:     total_match = total_patterns - n_distractors\n 157: \n 158:     palette = rng.choice(np.arange(10), size=1 + n_frames + n_distractors, replace=False)\n 159:     bg = int(palette[0])\n 160:     frame_colors = [int(x) for x in palette[1 : 1 + n_frames]]\n 161:     distractor_colors = [int(x) for x in palette[1 + n_frames :]]\n 162: \n 163:     counts = _sample_counts(rng, n_frames, total_match)\n 164:     bottom_pad = int(rng.integers(*BOTTOM_PAD_RANGE)) if n_frames == 3 else 0\n 165:     height = FRAME_R0 + n_frames * FRAME_H + (n_frames - 1) * FRAME_GAP + bottom_pad\n\n 204: def generate_input() -> np.ndarray:\n 205:     for _ in range(MAX_ATTEMPTS):\n 206:         grid = _gen_attempt()\n 207:         if grid is not None:\n 208:             return grid\n 209:     raise RuntimeError(f\"failed to generate a valid input after {MAX_ATTEMPTS} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/3ad05f52.py =====\n 127: def main(grid: np.ndarray) -> np.ndarray:\n 128:     \"\"\"\n 129:     Paint the maze corridor and framed rooms lying on shortest paths between the two colored endpoint components.\n 130: \n 131:     Input structure\n 132:     - The grid has a dominant background, one wall color forming thin orthogonal frames, and one endpoint/fill color.\n 133:     - The endpoint/fill color forms exactly two 4-connected solid rectangular components; their larger side lengths define the framed room sizes.\n 134: \n 135:     Rule\n 136:     - Treat wall pixels as blocked and every other pixel as passable.\n 137:     - Find every passable pixel that lies on a shortest 4-connected path between the two endpoint components.\n 138:     - Also fill any framed square room of an endpoint-derived size that intersects that shortest-path mask.\n 139: \n 140:     Key insight\n 141:     - Shortest paths identify the route through open connector corridors, while the wall-bordered square rooms need to be expanded from the route centerline to their full interior.\n 142:     \"\"\"\n 143:     g = np.asarray(grid, dtype=int)\n 144:     assert g.ndim == 2\n 145: \n 146:     bg = get_bg(g)\n 147:     counts = Counter(map(int, g.flat))\n 148: \n 149:     non_bg = colors_present(g, exclude={bg})\n 150:     assert len(non_bg) == 2\n 151:     assert counts[bg] > max(counts[color] for color in non_bg)\n 152:     non_bg_counts = {color: int(np.count_nonzero(g == color)) for color in non_bg}\n 153:     wall_count = max(non_bg_counts.values())\n 154:     wall_candidates = [color for color, count in non_bg_counts.items() if count == wall_count]\n 155:     assert len(wall_candidates) == 1\n 156:     wall = wall_candidates[0]\n 157:     paint_candidates = [color for color in non_bg if color != wall]\n 158:     assert len(paint_candidates) == 1\n 159:     paint = paint_candidates[0]\n 160:     assert non_bg_counts[wall] > non_bg_counts[paint]\n 161: \n 162:     endpoints = find_components(g, bg=bg, colors=[paint], connectivity=4)\n 163:     assert len(endpoints) == 2\n 164:     endpoint_coords = [component[\"coords\"] for component in endpoints]\n 165: \n 166:     room_sizes: set[int] = set()\n 167:     for coords in endpoint_coords:\n 168:         r0, c0, r1, c1 = bbox_coords(coords)\n 169:         bh = r1 - r0 + 1\n 170:         bw = c1 - c0 + 1\n 171:         assert coords.shape[0] == bh * bw\n 172:         room_sizes.add(max(bh, bw))\n 173: \n 174:     passable = g != wall\n 175:     dist0 = _distances_from(endpoint_coords[0], passable)\n 176:     dist1 = _distances_from(endpoint_coords[1], passable)\n 177:     endpoint_distances = [int(dist0[r, c]) for r, c in endpoint_coords[1]]\n 178:     reachable_distances = [d for d in endpoint_distances if d >= 0]\n 179:     assert len(reachable_distances) == len(endpoint_distances)\n 180:     shortest = min(reachable_distances)\n 181: \n 182:     route = (dist0 >= 0) & (dist1 >= 0) & (dist0 + dist1 == shortest)\n 183:     assert np.any(route)\n 184: \n 185:     fill = route.copy()\n 186:     rooms = _framed_square_rooms(g, wall, room_sizes)\n 187:     assert rooms\n 188:     for r, c, n in rooms:\n 189:         if np.any(route[r : r + n, c : c + n]):\n 190:             fill[r : r + n, c : c + n] = True\n 191: \n 192:     room_mask = np.zeros_like(fill, dtype=bool)\n 193:     for r, c, n in rooms:\n 194:         room_mask[r : r + n, c : c + n] = True\n 195:     open_fill = fill & (g == bg) & ~room_mask\n 196:     for r0, c0, r1, c1, area in _component_bboxes(open_fill):\n 197:         if r1 > r0 and c1 > c0 and area >= 20:\n 198:             assert _middle_fill_bounded_by_side_rooms(\n 199:                 (r0, c0, r1, c1),\n 200:                 rooms,\n 201:             ), \"middle fill must stay within the facing room-frame spans\"\n 202: \n 203:     H, W = g.shape\n 204:     for r, c, n in rooms:\n 205:         has_doorway = False\n 206:         if r > 0:\n 207:             has_doorway = has_doorway or np.any(g[r - 1, c : c + n] != wall)\n 208:         if r + n < H:\n 209:             has_doorway = has_doorway or np.any(g[r + n, c : c + n] != wall)\n 210:         if c > 0:\n 211:             has_doorway = has_doorway or np.any(g[r : r + n, c - 1] != wall)\n 212:         if c + n < W:\n 213:             has_doorway = has_doorway or np.any(g[r : r + n, c + n] != wall)\n 214:         if has_doorway:\n 215:             assert np.any(fill[r : r + n, c : c + n]), \"rooms with doorways must be on the shortest path\"\n 216: \n 217:     out = g.copy()\n 218:     out[fill & (g == bg)] = paint\n 219:     return out\n 220: \n 221: # --------------- generator (attempt 2 refined middle-fill) ---------------\n 222: \n 223: BG = 0\n 224: WALL = 8\n 225: PAINT_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]\n 226: \n 227: # Canvas bounds used by the observed evaluation examples.\n 228: ROW_MIN = 22\n 229: ROW_MAX = 29\n 230: COL_MIN = 24\n 231: COL_MAX = 28\n 232: \n 233: # Room-grid geometry and room-count filters.\n 234: ROOM_SIZE_RANGE = range(3, 6)\n 235: ROOM_GRID_RANGE = range(1, 8)\n 236: BLOCK_ROOM_MIN = 3\n 237: BLOCK_ROOM_MAX = 14\n 238: TOTAL_ROOM_MIN = 7\n 239: TOTAL_ROOM_MAX = 22\n 240: GAP_RANGE = range(3, 8)\n 241: ORIENTATIONS = (\"vertical\", \"horizontal\")\n 242: \n 243: # Coarse layout and final route validation thresholds.\n 244: LAYOUT_DISTANCE_MIN = 36\n 245: LAYOUT_DISTANCE_FLOORS = [36, 42, 48, 54, 60]\n 246: SHORTEST_DISTANCE_MIN = 36\n 247: SHORTEST_DISTANCE_MAX = 72\n 248: TURN_MIN = 8\n 249: TURN_MAX = 21\n 250: ON_ROUTE_ROOM_MIN = 6\n 251: ON_ROUTE_ROOM_MAX = 14\n 252: OFF_ROUTE_ROOM_MIN = 1\n 253: OFF_ROUTE_ROOM_MAX = 8\n 254: \n 255: # Connector sampling: offset connectors create the observed middle fill region.\n 256: OFFSET_CONNECTOR_PROB = 0.60\n 257: CONNECTOR_CHOICE_TRIES = 300\n 258: CONNECTOR_DELTA_MAX = 12\n 259: CONNECTOR_DELTA_MIN_CAP = 5\n 260: \n 261: # Endpoint room selection favors far rooms, with a minority near-exit branch.\n 262: NEAR_EXIT_ENDPOINT_PROB = 0.30\n 263: NEAR_EXIT_STEPS = [-1, 0, 1]\n 264: \n 265: # Full-example rejection retries.\n 266: GENERATE_ATTEMPTS = 300\n 267: \n 268: _NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n 269: _LAYOUTS = None\n 270: _LAST_META = None\n 271: \n 272: \n 273: def _block_shape(rows, cols, size):\n 274:     return rows * (size + 1) + 1, cols * (size + 1) + 1\n 275: \n 276: \n 277: def _room_topleft(room_r, room_c, size):\n 278:     return 1 + room_r * (size + 1), 1 + room_c * (size + 1)\n 279: \n 280: \n 281: def _layout_distance_estimate(r1, c1, s1, r2, c2, s2, gap):\n 282:     return (r1 + c1 - 2) * (s1 + 1) + (r2 + c2 - 2) * (s2 + 1) + s1 + s2 + gap\n 283: \n 284: \n 285: def _layout_fits(orientation, bh1, bw1, bh2, bw2, gap):\n 286:     if orientation == \"vertical\":\n\n 719: def generate_input():\n 720:     for _ in range(GENERATE_ATTEMPTS):\n 721:         grid = _gen_attempt()\n 722:         if grid is not None:\n 723:             return grid\n 724:     raise RuntimeError(\"failed to generate valid 3ad05f52 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/e3721c99.py =====\n  68: def main(grid: np.ndarray) -> np.ndarray:\n  69:     \"\"\"\n  70:     Recolor grey shapes by matching their hole count to a color legend.\n  71: \n  72:     Input structure:\n  73:     - bg = most common color; grey (5) sprites scattered across the grid.\n  74:     - Colored legend shapes (non-bg, non-grey, at least 2×2, not touching the outer border) near grid edge,\n  75:       each with a distinct number of enclosed holes.\n  76: \n  77:     Rule:\n  78:     - Each colored legend shape defines a mapping: hole count → color.\n  79:     - For every grey sprite, count its holes (enclosed bg regions not touching the sprite's bounding-box border).\n  80:     - Recolor the grey sprite to the matching legend color; erase grey distractors with unlisted hole counts.\n  81: \n  82:     Key insight: Shape identity is encoded by topology (number of holes), not geometry or size.\n  83:     \"\"\"\n  84:     g = np.asarray(grid, dtype=int)\n  85:     bg = get_bg(g)\n  86:     grey = 5\n  87: \n  88:     legend = _legend_mapping(g, bg, grey)\n  89:     assert legend, \"legend mapping must be non-empty: grid must contain colored legend shapes\"\n  90: \n  91:     out = g.copy()\n  92:     for pts in components_mask(g == grey, connectivity=4):\n  93:         r0, c0, r1, c1 = bbox_coords(pts)\n  94:         sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n  95:         for r, c in pts:\n  96:             sub[r - r0, c - c0] = True\n  97:         hc = _hole_count(sub)\n  98:         newc = int(legend[hc]) if hc in legend else bg\n  99:         for r, c in pts:\n 100:             out[r, c] = newc\n 101: \n 102:     return out\n 103: \n 104: # --------------- generator (holes-first organic blob) ---------------\n 105: \n 106: from arc_utils import label_mask\n 107: from scipy.ndimage import binary_dilation, generate_binary_structure\n 108: \n 109: # -- palette & grid --\n 110: BG = 0\n 111: DIV = 1\n 112: GREY = 5\n 113: GRID_SIZE = 30\n 114: LEGEND_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\n 115: \n 116: # -- legend panel --\n 117: LEGEND_COUNT_RANGE = (2, 4)         # number of legend entries\n 118: MAX_HOLE_COUNT = 6                  # hole values drawn from range(MAX_HOLE_COUNT)\n 119: PANEL_SIZE_RANGE = (5, 8)           # panel thickness (cross-axis)\n 120: FULL_LAYOUT_MAX_SPAN = 28          # max legend line span for full-row/col layouts\n 121: L_LAYOUT_MAX_SPAN = 24            # max legend line span for L-shaped layouts\n 122: L_LAYOUT_EXTRA_PADDING = 3        # max random padding along the L arm\n 123: \n 124: # -- sprites --\n 125: TOTAL_SPRITES_RANGE = (8, 11)       # total sprites (matches + distractors)\n 126: MAX_DISTRACTORS = 7                 # max distractor sprites\n 127: MAX_EXTRA_PER_LEGEND = 2            # max extra match sprites per legend entry\n 128: SPRITE_RETRIES = 30                 # retries per sprite generation attempt\n 129: SPRITE_AREA_0 = (5, 25)              # (min, max) area for 0-hole sprites\n 130: SPRITE_AREA_LOW_MIN = 8              # min area for 1-2 hole sprites (max = 25+10*h)\n 131: # 3+ hole sprites: min = 10+2*h, max = 20+4*h\n 132: CANVAS_SCALE = 1.2                  # sqrt(area) multiplier for canvas size\n 133: CANVAS_MIN = 5                      # minimum canvas dimension\n 134: CANVAS_PAD = 2                      # padding added to scaled sqrt for canvas\n 135: HOLE_SEED_RADIUS_FACTOR = 0.45      # radius = factor * sqrt(area)\n 136: HOLE_SEED_MIN_RADIUS = 2\n 137: HOLE_SEED_MIN_SEP = 2               # minimum Chebyshev distance between hole seeds\n 138: HOLE_SEED_MARGIN = 2                # margin from canvas edge for hole seeds\n 139: SEAL_ITERS = 5                      # max iterations for sealing forbidden cells\n 140: SPRITE_MAX_H = 12                   # max sprite bbox height\n 141: SPRITE_MAX_W = 18                   # max sprite bbox width\n 142: SPRITE_MAX_ASPECT = 2.5             # max aspect ratio (max_dim / min_dim)\n 143: \n 144: # -- generation --\n 145: GEN_RETRIES = 300                   # outer retries for generate_input()\n 146: \n 147: # 8-connectivity structuring element for dilation\n 148: _STRUCT8 = generate_binary_structure(2, 2)\n 149: \n 150: \n 151: # ---------- legend helpers ----------\n 152: \n 153: def _legend_span(hole_count: int) -> int:\n 154:     \"\"\"Width (or height) of a single legend patch along the arrangement axis.\"\"\"\n 155:     return 3 if hole_count == 0 else 2 * hole_count + 1\n 156: \n 157: \n 158: def _legend_patch(hole_count: int, color: int, arrangement: str) -> np.ndarray:\n 159:     \"\"\"Build a 3xSpan (horizontal) or Spanx3 (vertical) legend patch.\"\"\"\n 160:     span = _legend_span(hole_count)\n 161:     if arrangement == \"horizontal\":\n 162:         patch = np.full((3, span), int(color), dtype=int)\n 163:         if hole_count:\n 164:             patch[1, 1::2] = BG\n 165:     else:\n 166:         patch = np.full((span, 3), int(color), dtype=int)\n 167:         if hole_count:\n 168:             patch[1::2, 1] = BG\n 169:     return patch\n 170: \n 171: \n 172: def _line_span(legends: list[tuple[int, int]]) -> int:\n 173:     \"\"\"Total span of legend patches plus 1-cell gaps between them.\"\"\"\n 174:     return sum(_legend_span(h) for h, _ in legends) + len(legends) - 1\n 175: \n 176: \n 177: def _choose_legends(arrangement: str, max_span: int) -> list[tuple[int, int]]:\n 178:     \"\"\"Pick 2-4 legends with distinct hole counts that fit within max_span.\"\"\"\n 179:     count = random.randint(*LEGEND_COUNT_RANGE)\n 180:     combos = [holes for holes in itertools.combinations(range(MAX_HOLE_COUNT), count)\n 181:               if sum(_legend_span(h) for h in holes) + count - 1 <= max_span]\n 182:     if not combos:\n 183:         return _choose_legends(arrangement, max_span + 2)\n 184:     holes = list(random.choice(combos))\n 185:     random.shuffle(holes)\n 186:     colors = random.sample(LEGEND_COLORS, count)\n 187:     return list(zip(holes, colors))\n 188: \n 189: \n 190: def _place_legend_line(\n 191:     grid: np.ndarray, legends: list[tuple[int, int]], arrangement: str, r: int, c: int\n 192: ) -> None:\n 193:     \"\"\"Paste legend patches sequentially along the arrangement axis.\"\"\"\n 194:     rr, cc = int(r), int(c)\n 195:     for hole_count, color in legends:\n 196:         patch = _legend_patch(hole_count, color, arrangement)\n 197:         paste(grid, patch, rr, cc)\n 198:         if arrangement == \"horizontal\":\n 199:             cc += patch.shape[1] + 1\n 200:         else:\n 201:             rr += patch.shape[0] + 1\n 202: \n 203: \n 204: # ---------- layout helpers ----------\n 205: \n 206: def _layout_full_horizontal(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:\n 207:     \"\"\"Place a full-row horizontal divider with legend panel above or below.\"\"\"\n 208:     legends = _choose_legends(\"horizontal\", FULL_LAYOUT_MAX_SPAN)\n 209:     total = _line_span(legends)\n 210:     panel_h = random.randint(*PANEL_SIZE_RANGE)\n 211:     top = random.choice([True, False])\n 212:     c0 = random.randint(1, GRID_SIZE - 1 - total)\n 213:     if top:\n 214:         div_r = panel_h\n 215:         grid[div_r, :] = DIV\n 216:         blocked[: div_r + 1, :] = 9\n 217:         r0 = random.randint(1, panel_h - 4)\n 218:     else:\n 219:         div_r = GRID_SIZE - 1 - panel_h\n 220:         grid[div_r, :] = DIV\n 221:         blocked[div_r:, :] = 9\n 222:         r0 = random.randint(div_r + 2, GRID_SIZE - 4)\n 223:     _place_legend_line(grid, legends, \"horizontal\", r0, c0)\n 224:     return legends\n 225: \n 226: \n 227: def _layout_full_vertical(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:\n\n 600: def generate_input() -> np.ndarray:\n 601:     for _ in range(GEN_RETRIES):\n 602:         try:\n 603:             grid = _gen_attempt()\n 604:         except Exception:\n 605:             grid = None\n 606:         if grid is not None:\n 607:             return grid\n 608:     raise RuntimeError(\"failed to generate e3721c99 input\")\n\n","exit_code":0,"status":"completed"}}
