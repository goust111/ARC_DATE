{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/985ae207.py',\n'/home/lixinyu/snap/new/ARC_code/train/465b7d93.py',\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n'/home/lixinyu/snap/new/ARC_code/train/470c91de.py',\n]\nfor path in files:\n    print(f'===== {path} =====')\n    text = Path(path).read_text()\n    lines = text.splitlines()\n    for name in ('def main', 'def generate_input'):\n        idx = next(i for i,l in enumerate(lines) if l.startswith(name))\n        start = max(0, idx)\n        end = min(len(lines), idx + 140)\n        for j in range(start, end):\n            print(f'{j+1:4}: {lines[j]}')\n        print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/train/985ae207.py =====\n  81: def main(grid: np.ndarray) -> np.ndarray:\n  82:     \"\"\"\n  83:     Repeat each 3x3 control-center sprite toward the matching solid rectangle until a copy first overlaps that rectangle.\n  84: \n  85:     Input structure\n  86:     - The background is the dominant color.\n  87:     - Each sprite is a 3x3 foreground object whose eight border pixels have one color and whose center has a different control color.\n  88:     - For every control color, there is exactly one separate solid rectangular object of that color.\n  89: \n  90:     Rule\n  91:     - Match each sprite to the unique solid rectangle whose color equals the sprite center.\n  92:     - Copy the whole 3x3 sprite in the cardinal direction of that rectangle, stepping by three cells each time.\n  93:     - Stop after pasting the first copy whose 3x3 bbox overlaps the rectangle; copied pixels overwrite the rectangle there.\n  94: \n  95:     Key insight\n  96:     The center pixel is not the paint color: it is a destination key, while the entire 3x3 sprite is the motif tiled along the straight path.\n  97:     \"\"\"\n  98:     g = np.asarray(grid, dtype=int)\n  99:     assert g.ndim == 2\n 100:     h, w = g.shape\n 101:     assert h >= 3 and w >= 3\n 102: \n 103:     bg = int(get_bg(g))\n 104:     sprites = _find_sprites(g, bg)\n 105:     assert sprites, \"expected at least one 3x3 control-center sprite\"\n 106: \n 107:     out = g.copy()\n 108:     for sprite_bbox, patch, center in sprites:\n 109:         targets = _solid_rectangles(g, bg, center)\n 110:         assert len(targets) == 1, \"each control color must have one solid rectangular target\"\n 111:         target_bbox = targets[0][\"bbox\"]\n 112:         assert not _intersects(sprite_bbox, target_bbox), \"sprite and target must start separate\"\n 113: \n 114:         dr, dc = _direction_to_target(sprite_bbox, target_bbox)\n 115:         r, c = sprite_bbox[0], sprite_bbox[1]\n 116: \n 117:         while True:\n 118:             current_bbox = (r, c, r + 2, c + 2)\n 119:             assert 0 <= r and r + 3 <= h and 0 <= c and c + 3 <= w\n 120:             paste(out, patch, r, c)\n 121: \n 122:             if _intersects(current_bbox, target_bbox):\n 123:                 break\n 124: \n 125:             r += dr * 3\n 126:             c += dc * 3\n 127: \n 128:     return out\n 129: \n 130: # --------------- generator (att1) ---------------\n 131: # Canvas and colors.\n 132: BG_COLOR, COLOR_COUNT = 8, 10\n 133: GRID_MIN_SIZE, GRID_MAX_SIZE = 20, 25\n 134: \n 135: # Rectangles.\n 136: RECT_COUNT_MIN, RECT_COUNT_MAX = 2, 4\n 137: RECT_SIDE_MIN, RECT_SIDE_MAX = 2, 14\n 138: RECT_MARGIN, RECT_SPACING_PAD = 1, 5\n 139: RECT_PLACEMENT_ATTEMPTS = 50\n 140: \n 141: # Sprites and paths.\n 142: SPRITE_SIZE, SPRITE_TOTAL_MAX = 3, 5\n 143: SPRITE_GAPS = [1, 4, 7, 10]\n 144: DIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n 145: \n 146: # Retry limits.\n 147: GENERATION_ATTEMPTS = 300\n 148: \n 149: \n 150: def _intersects_check(a, b):\n 151:     return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])\n 152: \n 153: \n 154: def _has_bg_border(grid, sr, sc, bg):\n 155:     H, W = grid.shape\n 156:     for r in range(sr, sr + SPRITE_SIZE):\n 157:         for c in range(sc, sc + SPRITE_SIZE):\n 158:             for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n 159:                 nr, nc = r + dr, c + dc\n 160:                 if 0 <= nr < H and 0 <= nc < W:\n 161:                     if not (sr <= nr < sr + SPRITE_SIZE and sc <= nc < sc + SPRITE_SIZE):\n 162:                         if grid[nr, nc] != bg:\n 163:                             return False\n 164:     return True\n 165: \n 166: \n 167: def _sample_palette(bg):\n 168:     all_colors = [c for c in range(COLOR_COUNT) if c != bg]\n 169:     random.shuffle(all_colors)\n 170:     num_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)\n 171:     body_color = all_colors[0]\n 172:     target_colors = all_colors[1:1 + num_rects]\n 173:     return body_color, target_colors\n 174: \n 175: \n 176: def _rect_has_spacing(rect, rects, pad):\n 177:     r0, c0, r1, c1 = rect\n 178:     for rr0, rc0, rr1, rc1, _ in rects:\n 179:         if not (r1 + pad < rr0 or rr1 + pad < r0 or c1 + pad < rc0 or rc1 + pad < c0):\n 180:             return False\n 181:     return True\n 182: \n 183: \n 184: def _place_rectangles(grid, target_colors):\n 185:     H, W = grid.shape\n 186:     rects = []\n 187:     for color in target_colors:\n 188:         for _ in range(RECT_PLACEMENT_ATTEMPTS):\n 189:             rh = random.randint(RECT_SIDE_MIN, min(RECT_SIDE_MAX, H - 4))\n 190:             rw = random.randint(RECT_SIDE_MIN, min(RECT_SIDE_MAX, W - 4))\n 191:             r0 = random.randint(RECT_MARGIN, H - rh - RECT_MARGIN)\n 192:             c0 = random.randint(RECT_MARGIN, W - rw - RECT_MARGIN)\n 193:             r1 = r0 + rh - 1\n 194:             c1 = c0 + rw - 1\n 195:             if _rect_has_spacing((r0, c0, r1, c1), rects, RECT_SPACING_PAD):\n 196:                 rects.append((r0, c0, r1, c1, color))\n 197:                 break\n 198:         else:\n 199:             return None\n 200:     for (r0, c0, r1, c1, color) in rects:\n 201:         grid[r0:r1 + 1, c0:c1 + 1] = color\n 202:     return rects\n 203: \n 204: \n 205: def _assign_sprites(rects):\n 206:     num_rects = len(rects)\n 207:     sprite_assignments = []\n 208:     for i, (_, _, _, _, color) in enumerate(rects):\n 209:         sprite_assignments.append((i, color))\n 210:     max_extra = min(SPRITE_TOTAL_MAX - len(sprite_assignments), num_rects)\n 211:     if max_extra > 0:\n 212:         extra = random.randint(0, max_extra)\n 213:         for _ in range(extra):\n 214:             i = random.randint(0, num_rects - 1)\n 215:             sprite_assignments.append((i, rects[i][4]))\n 216:     if len(sprite_assignments) > SPRITE_TOTAL_MAX:\n 217:         sprite_assignments = sprite_assignments[:SPRITE_TOTAL_MAX]\n 218:     return sprite_assignments\n 219: \n 220: \n\n 362: def generate_input() -> np.ndarray:\n 363:     for _ in range(GENERATION_ATTEMPTS):\n 364:         result = _gen_attempt()\n 365:         if result is not None:\n 366:             return result\n 367:     raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/465b7d93.py =====\n  96: def main(grid: np.ndarray) -> np.ndarray:\n  97:     \"\"\"\n  98:     Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.\n  99: \n 100:     Input structure:\n 101:     - The background is the dominant color.\n 102:     - There are exactly two foreground colors: one forms a complete rectangular\n 103:       one-pixel-thick frame, and the other forms one 4-connected sprite outside it.\n 104:     - The frame interior is initially background.\n 105: \n 106:     Rule:\n 107:     - Clear the original sprite from its outside location.\n 108:     - Map the sprite bbox to the frame interior bbox, sending bbox extremes to\n 109:       interior extremes.\n 110:     - Draw straight horizontal or vertical segments between mapped positions of\n 111:       adjacent sprite pixels, then fill any enclosed background region inside\n 112:       those drawn segments.\n 113: \n 114:     Key insight:\n 115:     The outside sprite is a miniature line/fill diagram for the frame interior,\n 116:     not a bitmap to scale by block replication.\n 117:     \"\"\"\n 118:     g = np.asarray(grid, dtype=int)\n 119:     bg = get_bg(g)\n 120:     colors = colors_present(g, exclude={bg})\n 121:     assert len(colors) == 2, \"expected one frame color and one sprite color\"\n 122: \n 123:     frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []\n 124:     for color in colors:\n 125:         frame_bbox = _rect_frame_bbox(g == int(color))\n 126:         if frame_bbox is not None:\n 127:             frame_candidates.append((int(color), frame_bbox))\n 128:     assert len(frame_candidates) == 1, \"expected a unique rectangular frame\"\n 129: \n 130:     frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]\n 131:     sprite_color = next(color for color in colors if color != frame_color)\n 132:     sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)\n 133:     assert len(sprite_components) == 1, \"expected a single 4-connected sprite\"\n 134:     frame_region = np.zeros_like(g, dtype=bool)\n 135:     frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True\n 136:     assert not np.any((g == sprite_color) & frame_region), \"sprite must start outside the frame\"\n 137: \n 138:     sr0, sc0, sr1, sc1 = sprite_components[0][\"bbox\"]\n 139:     sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color\n 140: \n 141:     ir0, ic0 = fr0 + 1, fc0 + 1\n 142:     ir1, ic1 = fr1 - 1, fc1 - 1\n 143:     assert ir0 <= ir1 and ic0 <= ic1, \"frame must have an interior\"\n 144:     interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]\n 145:     assert np.all(interior == bg), \"frame interior must start empty\"\n 146: \n 147:     stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))\n 148:     out = g.copy()\n 149:     out[g == sprite_color] = bg\n 150:     out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color\n 151:     return out\n 152: \n 153: # --------------- generator (att2, o5x) ---------------\n 154: \n 155: # Canvas and observed fixed colors.\n 156: _GRID_SHAPE = (10, 10)\n 157: _COLOR_COUNT = 10\n 158: _BG = 7\n 159: _FRAME_COLOR = 6\n 160: \n 161: # Frame size bounds and retry budget.\n 162: _FRAME_SIZE_MIN = 3\n 163: _FRAME_SIZE_MAX = 8\n 164: _SINGLE_PIXEL_FRAME_SIZE = 3\n 165: _MAX_GENERATION_ATTEMPTS = 300\n 166: \n 167: # Sprite color pool and source masks.\n 168: _SPRITE_COLORS = tuple(c for c in range(_COLOR_COUNT) if c not in {_BG, _FRAME_COLOR})\n 169: _SPRITE_SINGLE = np.ones((1, 1), dtype=bool)\n 170: _SPRITE_PATTERNS_2X2 = [\n 171:     np.array([[1, 1], [1, 0]], dtype=bool),\n 172:     np.array([[1, 1], [0, 1]], dtype=bool),\n 173:     np.array([[1, 0], [1, 1]], dtype=bool),\n 174:     np.array([[0, 1], [1, 1]], dtype=bool),\n 175:     np.array([[1, 1], [1, 1]], dtype=bool),\n 176: ]\n 177: \n 178: def _outside_locations(\n 179:     frame_bbox: tuple[int, int, int, int], patch_shape: tuple[int, int]\n 180: ) -> list[tuple[int, int]]:\n 181:     fr0, fc0, fr1, fc1 = frame_bbox\n 182:     ph, pw = patch_shape\n 183:     locations: list[tuple[int, int]] = []\n 184:     for r in range(_GRID_SHAPE[0] - ph + 1):\n 185:         for c in range(_GRID_SHAPE[1] - pw + 1):\n 186:             pr0, pc0, pr1, pc1 = r, c, r + ph - 1, c + pw - 1\n 187:             separated = pr1 < fr0 or pr0 > fr1 or pc1 < fc0 or pc0 > fc1\n 188:             if separated:\n 189:                 locations.append((r, c))\n 190:     return locations\n 191: \n 192: def _frame_positions(size: int, patch_shape: tuple[int, int]) -> list[tuple[int, int]]:\n 193:     positions: list[tuple[int, int]] = []\n 194:     for r in range(_GRID_SHAPE[0] - size + 1):\n 195:         for c in range(_GRID_SHAPE[1] - size + 1):\n 196:             frame_bbox = (r, c, r + size - 1, c + size - 1)\n 197:             if _outside_locations(frame_bbox, patch_shape):\n 198:                 positions.append((r, c))\n 199:     return positions\n 200: \n 201: def _draw_frame(grid: np.ndarray, r0: int, c0: int, size: int, color: int) -> None:\n 202:     r1, c1 = r0 + size - 1, c0 + size - 1\n 203:     grid[r0 : r1 + 1, c0] = color\n 204:     grid[r0 : r1 + 1, c1] = color\n 205:     grid[r0, c0 : c1 + 1] = color\n 206:     grid[r1, c0 : c1 + 1] = color\n 207: \n 208: def _sample_sprite(size: int) -> np.ndarray:\n 209:     return _SPRITE_SINGLE.copy() if size == _SINGLE_PIXEL_FRAME_SIZE else random.choice(_SPRITE_PATTERNS_2X2).copy()\n 210: \n 211: def _sample_case() -> tuple[int, int, np.ndarray]:\n 212:     sprite_color = random.choice(_SPRITE_COLORS)\n 213:     size = random.randint(_FRAME_SIZE_MIN, _FRAME_SIZE_MAX)\n 214:     return sprite_color, size, _sample_sprite(size)\n 215: \n 216: def _build_candidate_grids(\n 217:     frame_bbox: tuple[int, int, int, int], sprite: np.ndarray, sprite_color: int\n 218: ) -> tuple[np.ndarray, np.ndarray] | None:\n 219:     fr0, fc0, fr1, fc1 = frame_bbox\n 220:     stretched = _stretch_sprite(sprite, (fr1 - fr0 - 1, fc1 - fc0 - 1))\n 221:     if not np.any(stretched):\n 222:         return None\n 223: \n 224:     out = np.full(_GRID_SHAPE, _BG, dtype=int)\n 225:     _draw_frame(out, fr0, fc0, fr1 - fr0 + 1, _FRAME_COLOR)\n 226:     out[fr0 + 1 : fr1, fc0 + 1 : fc1][stretched] = sprite_color\n 227: \n 228:     inp = out.copy()\n 229:     inp[fr0 + 1 : fr1, fc0 + 1 : fc1] = _BG\n 230: \n 231:     locations = _outside_locations(frame_bbox, sprite.shape)\n 232:     if not locations:\n 233:         return None\n 234:     sr, sc = random.choice(locations)\n 235:     patch = np.where(sprite, sprite_color, _BG)\n\n 260: def generate_input() -> np.ndarray:\n 261:     for _ in range(_MAX_GENERATION_ATTEMPTS):\n 262:         grid = _gen_attempt()\n 263:         if grid is not None:\n 264:             return grid\n 265:     raise RuntimeError(\"failed to generate a valid 465b7d93 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py =====\n 274: def main(grid: np.ndarray) -> np.ndarray:\n 275:     \"\"\"\n 276:     Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n 277: \n 278:     Input structure:\n 279:     - bg = most common color. Several hollow sprites with distinct border colors.\n 280:     - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n 281: \n 282:     Rule:\n 283:     - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n 284:     - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n 285:     - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n 286: \n 287:     Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n 288:     \"\"\"\n 289:     g = np.asarray(grid, dtype=int)\n 290:     bg = _bg_boundary(g)\n 291: \n 292:     mapping, pal_mask = _palette_mapping(g, bg)\n 293:     assert mapping, \"main: palette mapping must be non-empty\"\n 294: \n 295:     out = g.copy()\n 296:     _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n 297: \n 298:     return out\n 299: \n 300: # --------------- generator (c) ---------------\n 301: \n 302: # -- Configuration constants --------------------------------------------------\n 303: # Grid dimensions\n 304: _GRID_H_MIN, _GRID_H_MAX = 4, 13\n 305: _GRID_W_MIN, _GRID_W_MAX = 10, 15\n 306: _SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n 307: _SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n 308: _TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n 309: \n 310: # Palette\n 311: _PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n 312: \n 313: # Sprite geometry\n 314: _SPRITE_H_MAX = 7\n 315: _SPRITE_W_MAX = 6\n 316: _SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n 317: _SPRITE_CELL_MAX = 16\n 318: _FILLED_SPRITE_MAX = 3\n 319: \n 320: # Sprite mutation probabilities\n 321: _P_HORIZ_WALL = 0.3           # add horizontal internal wall\n 322: _P_VERT_WALL = 0.3            # add vertical internal wall\n 323: _P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n 324: _P_DIAMOND = 0.2              # use diamond shape for 3x3\n 325: \n 326: # Generation\n 327: _MAX_RETRIES = 300\n 328: # -- End configuration --------------------------------------------------------\n 329: \n 330: \n 331: def _get_enclosed_holes(sprite):\n 332:     \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n 333:     h, w = sprite.shape\n 334:     return [pts for pts in components_mask(~sprite, connectivity=4)\n 335:             if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n 336: \n 337: \n 338: def _make_diamond():\n 339:     \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n 340:     s = np.zeros((3, 3), dtype=bool)\n 341:     s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n 342:     return s\n 343: \n 344: \n 345: def _make_hollow_sprite(h, w, rng):\n 346:     \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n 347:     sprite = np.ones((h, w), dtype=bool)\n 348:     if h >= 3 and w >= 3:\n 349:         sprite[1:-1, 1:-1] = False\n 350:     # Optionally add internal horizontal wall\n 351:     if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n 352:         br = rng.randint(2, h - 2)\n 353:         n = rng.randint(1, w - 2)\n 354:         s = rng.randint(1, w - 1 - n + 1)\n 355:         sprite[br, s:s + n] = True\n 356:     # Optionally add internal vertical wall\n 357:     if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n 358:         bc = rng.randint(2, w - 2)\n 359:         n = rng.randint(1, h - 2)\n 360:         s = rng.randint(1, h - 1 - n + 1)\n 361:         sprite[s:s + n, bc] = True\n 362:     # Optionally remove border cells for irregularity\n 363:     if rng.random() < _P_BORDER_REMOVAL:\n 364:         bcells = [(r, c) for r in range(h) for c in range(w)\n 365:                   if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n 366:         rng.shuffle(bcells)\n 367:         for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n 368:             test = sprite.copy()\n 369:             test[cr, cc] = False\n 370:             if _get_enclosed_holes(test):\n 371:                 sprite = test\n 372:     if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n 373:         return None\n 374:     return sprite\n 375: \n 376: \n 377: def _choose_colors(rng, N, num_filled):\n 378:     \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n 379:     all_c = list(range(1, 10))\n 380:     rng.shuffle(all_c)\n 381:     border_keys = all_c[:N]\n 382:     rng.shuffle(all_c)\n 383:     fill_values = all_c[:N]\n 384:     dist_cands = [c for c in range(1, 10) if c not in border_keys]\n 385:     distractor_color = rng.choice(dist_cands)\n 386:     mapping = dict(zip(border_keys, fill_values))\n 387:     filled_keys = rng.sample(border_keys, num_filled)\n 388:     return border_keys, fill_values, distractor_color, mapping, filled_keys\n 389: \n 390: \n 391: def _build_palette(side, border_keys, fill_values):\n 392:     \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n 393:     N = len(border_keys)\n 394:     if side in ('top', 'bottom'):\n 395:         pal = np.zeros((2, N), dtype=int)\n 396:         outer, inner = (0, 1) if side == 'top' else (1, 0)\n 397:         pal[outer] = border_keys\n 398:         pal[inner] = fill_values\n 399:     else:\n 400:         pal = np.zeros((N, 2), dtype=int)\n 401:         outer, inner = (0, 1) if side == 'left' else (1, 0)\n 402:         pal[:, outer] = border_keys\n 403:         pal[:, inner] = fill_values\n 404:     return pal\n 405: \n 406: \n 407: def _place_palette(grid, occ, pal, side, rng):\n 408:     \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n 409:     H, W = grid.shape\n 410:     pal_h, pal_w = pal.shape\n 411:     if side == 'top':\n 412:         pr0, pc0 = 0, rng.randint(0, W - pal_w)\n 413:     elif side == 'bottom':\n\n 544: def generate_input():\n 545:     for _ in range(_MAX_RETRIES):\n 546:         r = _gen_attempt()\n 547:         if r is not None:\n 548:             return r\n 549:     raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/470c91de.py =====\n  47: def main(grid: np.ndarray) -> np.ndarray:\n  48:     \"\"\"\n  49:     Move each teal-cornered filled rectangle one cell diagonally toward its teal corner.\n  50: \n  51:     Input structure:\n  52:     - Dominant background surrounds several filled rectangular colored objects.\n  53:     - Each object has exactly one teal control pixel replacing one corner cell of\n  54:       its rectangle.\n  55: \n  56:     Rule:\n  57:     - Treat the teal pixel as the missing corner of its colored rectangle.\n  58:     - Erase each original rectangle footprint, including the teal pixel.\n  59:     - Repaint the completed rectangle shifted one cell diagonally in the direction\n  60:       of that teal corner.\n  61: \n  62:     Key insight:\n  63:     - The control pixel's corner position gives both the missing cell to restore\n  64:       and the diagonal motion vector.\n  65:     \"\"\"\n  66:     g = np.asarray(grid, dtype=int)\n  67:     bg = get_bg(g)\n  68:     moves = _rectangle_moves(g, bg)\n  69: \n  70:     out = g.copy()\n  71:     for r0, c0, r1, c1, _color, _dr, _dc in moves:\n  72:         out[r0 : r1 + 1, c0 : c1 + 1] = bg\n  73: \n  74:     occupied = np.zeros_like(g, dtype=bool)\n  75:     for r0, c0, r1, c1, color, dr, dc in moves:\n  76:         tr0, tr1 = r0 + dr, r1 + dr\n  77:         tc0, tc1 = c0 + dc, c1 + dc\n  78:         assert not occupied[tr0 : tr1 + 1, tc0 : tc1 + 1].any(), \"shifted rectangles must not overlap\"\n  79:         assert np.all(out[tr0 : tr1 + 1, tc0 : tc1 + 1] == bg), \"target region must be background\"\n  80:         out[tr0 : tr1 + 1, tc0 : tc1 + 1] = color\n  81:         occupied[tr0 : tr1 + 1, tc0 : tc1 + 1] = True\n  82: \n  83:     return out\n  84: \n  85: # --------------- generator (att2, o5x) ---------------\n  86: \n  87: # Colors and palette.\n  88: _BG = Color.ORANGE\n  89: _TEAL = Color.TEAL\n  90: _RECT_COLORS = [c for c in Color.ALL_COLORS if c not in {_BG, _TEAL}]\n  91: # Canvas/object sampling.\n  92: _GRID_SIZES = [10, 11]\n  93: _RECT_COUNT_RANGE = (2, 4)\n  94: _RECT_SIZE_RANGE = range(2, 6)\n  95: _OCCUPANCY_PCT_RANGE = (30, 36)\n  96: _PCT_DENOMINATOR = 100\n  97: _DIMS = [(h, w, h * w) for h in _RECT_SIZE_RANGE for w in _RECT_SIZE_RANGE]\n  98: # Shift directions encode the teal-corner motion.\n  99: _SHIFT_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\n 100: # Placement and retry limits.\n 101: _OUTPUT_GAP = 1\n 102: _PLACEMENT_NODE_BUDGET = 8000\n 103: _MAX_GENERATION_ATTEMPTS = 300\n 104: \n 105: _BBox = tuple[int, int, int, int]\n 106: \n 107: \n 108: def _bbox_intersects(a: _BBox, b: _BBox) -> bool:\n 109:     return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])\n 110: \n 111: \n 112: def _expand_bbox(b: _BBox, n: int) -> _BBox:\n 113:     gap = _OUTPUT_GAP\n 114:     return (max(0, b[0] - gap), max(0, b[1] - gap), min(n - 1, b[2] + gap), min(n - 1, b[3] + gap))\n 115: \n 116: \n 117: def _choose_sizes(k: int, n: int) -> list[tuple[int, int]] | None:\n 118:     min_pct, max_pct = _OCCUPANCY_PCT_RANGE\n 119:     area = n * n\n 120:     lo = (min_pct * area + _PCT_DENOMINATOR - 1) // _PCT_DENOMINATOR\n 121:     hi = (max_pct * area) // _PCT_DENOMINATOR\n 122:     sums = [{0}]\n 123:     for _ in range(k):\n 124:         sums.append({prev + area for prev in sums[-1] for _, _, area in _DIMS})\n 125: \n 126:     targets = [s for s in sums[k] if lo <= s <= hi]\n 127:     if not targets:\n 128:         return None\n 129: \n 130:     target = random.choice(targets)\n 131:     sizes: list[tuple[int, int]] = []\n 132:     for remaining in range(k, 0, -1):\n 133:         choices = [(h, w, area) for h, w, area in _DIMS if target - area in sums[remaining - 1]]\n 134:         h, w, area = random.choice(choices)\n 135:         sizes.append((h, w))\n 136:         target -= area\n 137: \n 138:     random.shuffle(sizes)\n 139:     return sizes\n 140: \n 141: \n 142: def _candidate_boxes(n: int, h: int, w: int, dr: int, dc: int) -> list[tuple[_BBox, _BBox]]:\n 143:     r0_min = 0 if dr == -1 else 1\n 144:     r0_max = n - h - 1 if dr == -1 else n - h\n 145:     c0_min = 0 if dc == -1 else 1\n 146:     c0_max = n - w - 1 if dc == -1 else n - w\n 147:     boxes = []\n 148:     for r0 in range(r0_min, r0_max + 1):\n 149:         for c0 in range(c0_min, c0_max + 1):\n 150:             out_bbox = (r0, c0, r0 + h - 1, c0 + w - 1)\n 151:             in_bbox = (r0 - dr, c0 - dc, r0 - dr + h - 1, c0 - dc + w - 1)\n 152:             boxes.append((out_bbox, in_bbox))\n 153:     random.shuffle(boxes)\n 154:     return boxes\n 155: \n 156: \n 157: def _overlaps_placed(out_bbox: _BBox, in_bbox: _BBox, placed: list[dict[str, int | _BBox] | None], n: int) -> bool:\n 158:     out_with_gap = _expand_bbox(out_bbox, n)\n 159:     for other in placed:\n 160:         if other is None:\n 161:             continue\n 162:         if _bbox_intersects(out_with_gap, other[\"out_bbox\"]):\n 163:             return True\n 164:         if _bbox_intersects(in_bbox, other[\"in_bbox\"]):\n 165:             return True\n 166:     return False\n 167: \n 168: \n 169: def _place_rectangles(rects: list[dict[str, int]], n: int) -> list[dict[str, int | _BBox]] | None:\n 170:     placed: list[dict[str, int | _BBox] | None] = [None] * len(rects)\n 171:     order = sorted(range(len(rects)), key=lambda i: rects[i][\"h\"] * rects[i][\"w\"], reverse=True)\n 172:     node_budget = _PLACEMENT_NODE_BUDGET\n 173: \n 174:     def rec(pos: int) -> bool:\n 175:         nonlocal node_budget\n 176:         if pos == len(order):\n 177:             return True\n 178:         if node_budget <= 0:\n 179:             return False\n 180:         node_budget -= 1\n 181: \n 182:         i = order[pos]\n 183:         rect = rects[i]\n 184:         for out_bbox, in_bbox in _candidate_boxes(n, rect[\"h\"], rect[\"w\"], rect[\"dr\"], rect[\"dc\"]):\n 185:             if _overlaps_placed(out_bbox, in_bbox, placed, n):\n 186:                 continue\n\n 245: def generate_input() -> np.ndarray:\n 246:     for _ in range(_MAX_GENERATION_ATTEMPTS):\n 247:         grid = _gen_attempt()\n 248:         if grid is not None:\n 249:             return grid\n 250:     raise RuntimeError(\"failed to generate a valid 470c91de input\")\n\n","exit_code":0,"status":"completed"}}
