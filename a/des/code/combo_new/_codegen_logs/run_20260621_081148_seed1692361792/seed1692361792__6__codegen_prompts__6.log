{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/58c02a16.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox, get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Expand the top-left seed mask into a recursive colored pattern and tile it across the full grid.\n\n    Input structure\n    - The background is the dominant color.\n    - All foreground lies in a top-left rectangle whose last row and last column are a solid secondary color.\n    - Removing that secondary-color row and column leaves a seed region containing background plus one primary color.\n\n    Rule\n    - Use the primary-color pixels in the seed as a binary mask.\n    - Replace each primary seed cell with a copy of the seed mask in the primary color, and each background seed cell\n      with a copy of the seed mask in the secondary color.\n    - Repeat and crop that expanded tile to the original grid shape.\n\n    Key insight\n    The solid L-shaped secondary-color border is a legend, not output content; it supplies the color used when the\n    seed's background cells are expanded.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    fg_bbox = bbox(g != bg)\n    assert fg_bbox is not None, \"expected a top-left foreground legend\"\n    r0, c0, r1, c1 = fg_bbox\n    assert r0 == 0 and c0 == 0, \"foreground legend must be anchored at the top-left corner\"\n\n    legend_box = g[: r1 + 1, : c1 + 1]\n    seed_h = legend_box.shape[0] - 1\n    seed_w = legend_box.shape[1] - 1\n    assert seed_h >= 1 and seed_w >= 1, \"legend must contain a non-empty seed plus border\"\n\n    secondary_border = np.concatenate((legend_box[:seed_h, seed_w], legend_box[seed_h, :]))\n    secondary_colors = np.unique(secondary_border)\n    assert secondary_colors.size == 1, \"expected one solid secondary-color border\"\n    secondary = int(secondary_colors[0])\n    assert secondary != bg, \"secondary border must be foreground\"\n\n    seed = legend_box[:seed_h, :seed_w]\n    primary_colors = np.unique(seed[seed != bg])\n    assert primary_colors.size == 1, \"seed must contain exactly one primary foreground color\"\n    primary = int(primary_colors[0])\n    assert primary != secondary, \"primary and secondary colors must be distinct\"\n    assert np.all((seed == bg) | (seed == primary)), \"seed may contain only background and primary colors\"\n    assert np.any(seed == bg), \"seed must include background cells that expand to the secondary color\"\n\n    seed_mask = seed == primary\n    H, W = g.shape\n    rows = np.arange(H)[:, None]\n    cols = np.arange(W)[None, :]\n\n    inner_mask = seed_mask[rows % seed_h, cols % seed_w]\n    meta_mask = seed_mask[(rows // seed_h) % seed_h, (cols // seed_w) % seed_w]\n\n    out = np.full(g.shape, bg, dtype=int)\n    out[inner_mask & meta_mask] = primary\n    out[inner_mask & ~meta_mask] = secondary\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color palette.\nBACKGROUND_COLOR, PALETTE_COLORS = 7, tuple(range(10))\n# Seed geometry.\nSEED_SIZES = (2, 3)\nSEED_DENSITY_MIN, SEED_DENSITY_MAX = 0.33, 0.67\n# Canvas layout.\nTILE_MULTIPLIERS, GRID_MIN, GRID_MAX = range(3, 6), 7, 16\nREMAINDERS_BY_SQUARENESS = {False: (0,), True: (0, 1)}\n# Retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _expected_output(seed_mask: np.ndarray, shape: tuple[int, int], bg: int, primary: int, secondary: int) -> np.ndarray:\n    \"\"\"Render the two-level fractal that main() should produce.\"\"\"\n    seed_h, seed_w = seed_mask.shape\n    H, W = shape\n    rows = np.arange(H)[:, None]\n    cols = np.arange(W)[None, :]\n\n    inner = seed_mask[rows % seed_h, cols % seed_w]\n    meta = seed_mask[(rows // seed_h) % seed_h, (cols // seed_w) % seed_w]\n\n    out = np.full((H, W), bg, dtype=int)\n    out[inner & meta] = primary\n    out[inner & ~meta] = secondary\n    return out\n\ndef _layout_options(seed_h: int, seed_w: int) -> list[tuple[int, int]]:\n    \"\"\"Return valid canvas shapes for a sampled seed size.\"\"\"\n    options = []\n    for k in TILE_MULTIPLIERS:\n        for rem in REMAINDERS_BY_SQUARENESS[seed_h == seed_w]:\n            H = seed_h * k + rem\n            W = seed_w * k + rem\n            if GRID_MIN <= H <= GRID_MAX and GRID_MIN <= W <= GRID_MAX and H >= seed_h * seed_h and W >= seed_w * seed_w:\n                options.append((H, W))\n    return options\n\ndef _random_seed_mask(seed_h: int, seed_w: int) -> np.ndarray:\n    \"\"\"Sample a nonempty, nonfull primary mask within density bounds.\"\"\"\n    area = seed_h * seed_w\n    lo = max(1, int(np.ceil(area * SEED_DENSITY_MIN)))\n    hi = min(area - 1, int(np.floor(area * SEED_DENSITY_MAX)))\n    n_primary = random.randint(lo, hi)\n    chosen = random.sample(range(area), n_primary)\n    mask = np.zeros((seed_h, seed_w), dtype=bool)\n    mask.reshape(-1)[chosen] = True\n    return mask\n\ndef _render_input(seed_mask: np.ndarray, shape: tuple[int, int], bg: int, primary: int, secondary: int) -> np.ndarray:\n    \"\"\"Render the top-left seed legend on a background canvas.\"\"\"\n    seed_h, seed_w = seed_mask.shape\n    inp = np.full(shape, bg, dtype=int)\n    inp[:seed_h, :seed_w][seed_mask] = primary\n    inp[seed_h, : seed_w + 1] = secondary\n    inp[:seed_h, seed_w] = secondary\n    return inp\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Build one oracle-checked input grid, or None if validation fails.\"\"\"\n    bg = BACKGROUND_COLOR\n    primary, secondary = random.sample([c for c in PALETTE_COLORS if c != bg], 2)\n\n    seed_h = random.choice(SEED_SIZES)\n    seed_w = random.choice(SEED_SIZES)\n    H, W = random.choice(_layout_options(seed_h, seed_w))\n\n    seed_mask = _random_seed_mask(seed_h, seed_w)\n    inp = _render_input(seed_mask, (H, W), bg, primary, secondary)\n    expected = _expected_output(seed_mask, (H, W), bg, primary, secondary)\n    try:\n        actual = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return inp\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 58c02a16 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, components_mask, get_bg\nimport random\n\n\nAxis = tuple[int, str, int]\n\n\ndef _find_reflection_axis(g: np.ndarray, bg: int) -> Axis:\n    h, w = g.shape\n    candidates: list[Axis] = []\n\n    for color in colors_present(g, exclude={bg}):\n        mask = g == color\n        count = int(mask.sum())\n\n        if count == w:\n            for r in np.flatnonzero(mask.all(axis=1)):\n                candidates.append((int(color), \"row\", int(r)))\n\n        if count == h:\n            for c in np.flatnonzero(mask.all(axis=0)):\n                candidates.append((int(color), \"col\", int(c)))\n\n        if h == w and count == h:\n            main_diag = np.eye(h, dtype=bool)\n            anti_diag = np.fliplr(main_diag)\n            if np.all(mask[main_diag]):\n                candidates.append((int(color), \"main_diag\", 0))\n            if np.all(mask[anti_diag]):\n                candidates.append((int(color), \"anti_diag\", 0))\n\n    assert len(candidates) == 1, \"expected exactly one full straight reflection axis\"\n    return candidates[0]\n\n\ndef _reflect(axis: Axis, shape: tuple[int, int], r: int, c: int) -> tuple[int, int]:\n    _axis_color, kind, index = axis\n    h, w = shape\n\n    if kind == \"row\":\n        return 2 * index - r, c\n    if kind == \"col\":\n        return r, 2 * index - c\n    if kind == \"main_diag\":\n        assert h == w, \"diagonal reflection axis requires a square grid\"\n        return c, r\n    if kind == \"anti_diag\":\n        assert h == w, \"diagonal reflection axis requires a square grid\"\n        return h - 1 - c, w - 1 - r\n\n    raise AssertionError(f\"unknown axis kind: {kind}\")\n\n\ndef _smallest_non_axis_color(g: np.ndarray, bg: int, axis_color: int) -> int:\n    areas = {\n        int(color): int(np.count_nonzero(g == color))\n        for color in colors_present(g, exclude={bg, axis_color})\n    }\n    assert len(areas) >= 2, \"expected at least two non-axis foreground colors\"\n\n    min_area = min(areas.values())\n    colors = [color for color, area in areas.items() if area == min_area]\n    assert len(colors) == 1, \"smallest non-axis foreground color must be unique\"\n    return colors[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Mirror the smallest non-axis foreground color across the full straight axis.\n\n    Input structure\n    - The background is the dominant color.\n    - One foreground color forms exactly one full row, column, main diagonal, or anti-diagonal reflection axis.\n    - The remaining foreground colors include a unique least-populated color to copy.\n\n    Rule\n    - Preserve the input grid.\n    - Select every pixel of the unique smallest non-axis foreground color.\n    - Reflect those pixels across the full straight axis and paint the reflected positions with the same color.\n\n    Key insight\n    - The axis color marks the mirror line, while the color population chooses which set of objects is duplicated.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.size > 0, \"expected a non-empty 2D grid\"\n\n    bg = get_bg(g)\n    axis = _find_reflection_axis(g, bg)\n    axis_color = axis[0]\n    mirror_color = _smallest_non_axis_color(g, bg, axis_color)\n\n    out = g.copy()\n    h, w = g.shape\n    for r_raw, c_raw in np.argwhere(g == mirror_color):\n        r = int(r_raw)\n        c = int(c_raw)\n        rr, cc = _reflect(axis, g.shape, r, c)\n        assert 0 <= rr < h and 0 <= cc < w, \"reflected pixel must stay inside the grid\"\n        assert int(out[rr, cc]) in {bg, mirror_color}, \"reflection cannot overwrite another foreground object\"\n        out[rr, cc] = mirror_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n# Canvas and axis options.\n_GEN_GRID_SIZE_RANGE = (9, 17)\n_GEN_ODD_GRID_SIZES = [9, 11, 13, 15, 17]\n_GEN_AXIS_KINDS = [\"row\", \"col\", \"main_diag\", \"anti_diag\"]\n_GEN_CENTER_AXIS_KINDS = {\"row\", \"col\"}\n_GEN_SIDE_COUNT = 2\n# Foreground component size and count bounds.\n_GEN_COMPONENT_COUNT_RANGE = range(1, 4)\n_GEN_MIRROR_TOTAL_RANGE = (4, 12)\n_GEN_MIRROR_COMPONENT_SIZE_RANGE = (2, 7)\n_GEN_NONMIRROR_TOTAL_RANGE = (5, 17)\n_GEN_NONMIRROR_COMPONENT_SIZE_RANGE = (3, 9)\n_GEN_MIN_NONMIRROR_RATIO = (5, 4)\n_GEN_MAX_NONMIRROR_MULTIPLIER = 2\n# Search and geometry primitives.\n_GEN_RETRY_LIMIT = 300\n_GEN_COLORS = list(range(10))\n_GEN_DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\ndef _gen_draw_axis(grid: np.ndarray, axis_kind: str, color: int) -> None:\n    n = grid.shape[0]\n    if axis_kind == \"row\":\n        grid[n // 2, :] = color\n    elif axis_kind == \"col\":\n        grid[:, n // 2] = color\n    elif axis_kind == \"main_diag\":\n        np.fill_diagonal(grid, color)\n    else:\n        np.fill_diagonal(np.fliplr(grid), color)\n\n\ndef _gen_side_mask(n: int, axis_kind: str, side: int) -> np.ndarray:\n    rr, cc = np.indices((n, n))\n    if axis_kind == \"row\":\n        return rr < n // 2 if side == 0 else rr > n // 2\n    if axis_kind == \"col\":\n        return cc < n // 2 if side == 0 else cc > n // 2\n    if axis_kind == \"main_diag\":\n        return cc > rr if side == 0 else cc < rr\n    return rr + cc < n - 1 if side == 0 else rr + cc > n - 1\n\n\ndef _gen_reflect(axis_kind: str, n: int, r: int, c: int) -> tuple[int, int]:\n    if axis_kind == \"row\":\n        return n - 1 - r, c\n    if axis_kind == \"col\":\n        return r, n - 1 - c\n    if axis_kind == \"main_diag\":\n        return c, r\n    return n - 1 - c, n - 1 - r\n\n\ndef _gen_feasible_counts(total: int, lo: int, hi: int) -> list[int]:\n    return [count for count in _GEN_COMPONENT_COUNT_RANGE if count * lo <= total <= count * hi]\n\n\ndef _gen_partition(total: int, count: int, lo: int, hi: int) -> list[int]:\n    sizes = []\n    remaining = total\n    for idx in range(count):\n        left = count - idx - 1\n        cur_lo = max(lo, remaining - left * hi)\n        cur_hi = min(hi, remaining - left * lo)\n        size = random.randint(cur_lo, cur_hi)\n        sizes.append(size)\n        remaining -= size\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _gen_pick_component_sizes() -> tuple[list[int], list[int]]:\n    mirror_total = random.randint(*_GEN_MIRROR_TOTAL_RANGE)\n    ratio_num, ratio_den = _GEN_MIN_NONMIRROR_RATIO\n    nonmirror_lo = max(\n        _GEN_NONMIRROR_TOTAL_RANGE[0],\n        (ratio_num * mirror_total + ratio_den - 1) // ratio_den,\n    )\n    nonmirror_hi = min(_GEN_NONMIRROR_TOTAL_RANGE[1], _GEN_MAX_NONMIRROR_MULTIPLIER * mirror_total)\n    nonmirror_total = random.randint(nonmirror_lo, nonmirror_hi)\n\n    mirror_count = random.choice(_gen_feasible_counts(mirror_total, *_GEN_MIRROR_COMPONENT_SIZE_RANGE))\n    nonmirror_count = random.choice(_gen_feasible_counts(nonmirror_total, *_GEN_NONMIRROR_COMPONENT_SIZE_RANGE))\n    mirror_sizes = _gen_partition(mirror_total, mirror_count, *_GEN_MIRROR_COMPONENT_SIZE_RANGE)\n    nonmirror_sizes = _gen_partition(nonmirror_total, nonmirror_count, *_GEN_NONMIRROR_COMPONENT_SIZE_RANGE)\n    return mirror_sizes, nonmirror_sizes\n\n\ndef _gen_mark_neighbors(blocked: np.ndarray, coords: np.ndarray) -> None:\n    n = blocked.shape[0]\n    for r_raw, c_raw in coords:\n        r = int(r_raw)\n        c = int(c_raw)\n        blocked[r, c] = True\n        for dr, dc in _GEN_DIRS4:\n            rr = r + dr\n            cc = c + dc\n            if 0 <= rr < n and 0 <= cc < n:\n                blocked[rr, cc] = True\n\n\ndef _gen_grow_component(\n    side_mask: np.ndarray, occupied: np.ndarray, same_color_blocked: np.ndarray, size: int\n) -> np.ndarray | None:\n    available = side_mask & ~occupied & ~same_color_blocked\n    choices = [coords for coords in components_mask(available, connectivity=4) if len(coords) >= size]\n    if not choices:\n        return None\n\n    region = random.choice(choices)\n    seed = tuple(int(x) for x in region[random.randrange(len(region))])\n    selected = {seed}\n    frontier: set[tuple[int, int]] = set()\n    n = available.shape[0]\n\n    def add_frontier(r: int, c: int) -> None:\n        for dr, dc in _GEN_DIRS4:\n            rr = r + dr\n            cc = c + dc\n            if 0 <= rr < n and 0 <= cc < n and available[rr, cc] and (rr, cc) not in selected:\n                frontier.add((rr, cc))\n\n    add_frontier(*seed)\n    while len(selected) < size:\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        selected.add(cell)\n        add_frontier(*cell)\n\n    return np.array(list(selected), dtype=int)\n\n","exit_code":0,"status":"completed"}}
