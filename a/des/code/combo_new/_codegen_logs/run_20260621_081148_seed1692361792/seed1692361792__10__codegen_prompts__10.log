{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/aa62e3f4.py',\n'/home/lixinyu/snap/new/ARC_code/train/9f669b64.py',\n'/home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py',\n'/home/lixinyu/snap/new/ARC_code/eval/581f7754.py',\n]\nfor path in files:\n    text = Path(path).read_text().splitlines()\n    print(f'===== {path} =====')\n    starts = []\n    for i, line in enumerate(text):\n        if line.startswith('def main(') or line.startswith('def generate_input('):\n            starts.append(i)\n    for idx, start in enumerate(starts):\n        end = starts[idx + 1] if idx + 1 < len(starts) else min(len(text), start + 160)\n        for line in text[start:end]:\n            print(line)\n    print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/aa62e3f4.py',\n'/home/lixinyu/snap/new/ARC_code/train/9f669b64.py',\n'/home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py',\n'/home/lixinyu/snap/new/ARC_code/eval/581f7754.py',\n]\nfor path in files:\n    text = Path(path).read_text().splitlines()\n    print(f'===== {path} =====')\n    starts = []\n    for i, line in enumerate(text):\n        if line.startswith('def main(') or line.startswith('def generate_input('):\n            starts.append(i)\n    for idx, start in enumerate(starts):\n        end = starts[idx + 1] if idx + 1 < len(starts) else min(len(text), start + 160)\n        for line in text[start:end]:\n            print(line)\n    print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/train/aa62e3f4.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace the outlined object with the outside contour of that outline in the marker color.\n\n    Input structure:\n    - A dominant background surrounds one 8-connected foreground outline.\n    - The outline is the unique largest foreground color.\n    - One or more smaller interior colors are inside the outline; the marker color\n      is the unique smallest non-outline color.\n\n    Rule:\n    - Erase all original foreground pixels to background.\n    - Paint every background pixel that is 4-adjacent to the outline with the\n      marker color.\n    - Keep the grid shape unchanged.\n\n    Key insight: The colored interior marker supplies the paint color, while the\n    largest outline supplies only the contour whose outside edge is traced.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    counts = Counter(map(int, g.flatten()))\n    foreground_colors = [color for color in counts if color != bg]\n    assert len(foreground_colors) >= 2, \"expected an outline color and a marker color\"\n\n    frame_count = max(counts[color] for color in foreground_colors)\n    frame_color = _unique_color_with_count(counts, foreground_colors, frame_count)\n    assert len(components_mask(g == frame_color, connectivity=8)) == 1, \"outline must be 8-connected\"\n\n    marker_candidates = [color for color in foreground_colors if color != frame_color]\n    marker_count = min(counts[color] for color in marker_candidates)\n    marker_color = _unique_color_with_count(counts, marker_candidates, marker_count)\n\n    out = np.full_like(g, bg)\n    contour: set[tuple[int, int]] = set()\n    for r, c in np.argwhere(g == frame_color):\n        for nr, nc in neighbors4(int(r), int(c)):\n            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] == bg:\n                contour.add((int(nr), int(nc)))\n    assert contour, \"expected outline to touch background contour cells\"\n\n    for r, c in contour:\n        out[r, c] = marker_color\n    return out\n\n# --------------- generator (att2) ---------------\n\nGRID_MIN, GRID_MAX = 5, 16\nN_COLORS = 10\n\nSHAPE_MIN_HEIGHT, SHAPE_MAX_HEIGHT = 5, 7\nSHAPE_MIN_WIDTH, SHAPE_MAX_WIDTH = 3, 5\nSTART_WIDTH_MIN, START_WIDTH_MAX = 1, 2\nMAX_LOCAL_WIDTH = 5\n\nMARKER_MIN_CELLS, MARKER_MAX_CELLS = 1, 3\n\nGEN_ATTEMPTS = 300\n\nEDGE_TOUCH_TOP_BOTTOM = \"TB\"\nCORNER_EDGE_PAIRS = [\"TL\", \"TR\", \"BL\", \"BR\"]\nZERO_DELTA_SHIFTS = [-1, 0, 0, 0, 1]\n\n\ndef _gen_grow_parts(total, n):\n    n_twos = total - n\n    parts = [2] * n_twos + [1] * (n - n_twos)\n    random.shuffle(parts)\n    return parts\n\ndef _gen_drop_parts(total, n):\n    if n == 0:\n        return []\n    n_twos = random.randint(max(0, total - n), min(total // 2, n))\n    n_ones = total - 2 * n_twos\n    parts = [2] * n_twos + [1] * n_ones + [0] * (n - n_twos - n_ones)\n    random.shuffle(parts)\n    return parts\n\ndef _gen_widths(height, max_width):\n    start = random.randint(START_WIDTH_MIN, START_WIDTH_MAX)\n    diff = max_width - start\n    grow_steps = random.randint((diff + 1) // 2, min(diff, height - 1))\n    widths = [start]\n    for inc in _gen_grow_parts(diff, grow_steps):\n        widths.append(widths[-1] + inc)\n\n    remaining = height - len(widths)\n    min_end = max(1, max_width - 2 * remaining)\n    end_width = random.randint(min_end, max_width)\n    for dec in _gen_drop_parts(max_width - end_width, remaining):\n        widths.append(widths[-1] - dec)\n    return widths\n\ndef _gen_intervals(widths):\n    left, right = 0, widths[0] - 1\n    intervals = [(left, right)]\n    for prev_width, width in zip(widths, widths[1:]):\n        delta = width - prev_width\n        if delta == 2:\n            left -= 1\n            right += 1\n        elif delta == 1:\n            if random.choice([False, True]):\n                left -= 1\n            else:\n                right += 1\n        elif delta == 0:\n            shift = random.choice(ZERO_DELTA_SHIFTS) if width >= 2 else 0\n            left += shift\n            right += shift\n        elif delta == -1:\n            if random.choice([False, True]):\n                left += 1\n            else:\n                right -= 1\n        elif delta == -2:\n            left += 1\n            right -= 1\n        intervals.append((left, right))\n\n    min_left = min(l for l, _ in intervals)\n    intervals = [(l - min_left, r - min_left) for l, r in intervals]\n    if max(r for _, r in intervals) + 1 > MAX_LOCAL_WIDTH:\n        return None\n    return intervals\n\ndef _gen_local_mask(intervals):\n    height = len(intervals)\n    width = max(r for _, r in intervals) + 1\n    mask = np.zeros((height, width), dtype=bool)\n    for r, (c0, c1) in enumerate(intervals):\n        mask[r, c0 : c1 + 1] = True\n    return mask\n\ndef _gen_place_shape(grid_shape, local_mask, edge_pair):\n    rows, cols = grid_shape\n    height, width = local_mask.shape\n    if edge_pair == EDGE_TOUCH_TOP_BOTTOM:\n        if height != rows or width > cols - 2:\n            return None\n        return 0, random.randint(1, cols - width - 1)\n    if height >= rows or width >= cols:\n        return None\n    if edge_pair == \"TL\":\n        return 0, 0\n    if edge_pair == \"TR\":\n        return 0, cols - width\n    if edge_pair == \"BL\":\n        return rows - height, 0\n    return rows - height, cols - width\n\ndef _gen_full_mask(rows, cols, local_mask, r0, c0):\n    mask = np.zeros((rows, cols), dtype=bool)\n    height, width = local_mask.shape\n    mask[r0 : r0 + height, c0 : c0 + width] = local_mask\n    return mask\n\ndef _gen_layers(mask):\n    remaining = mask.copy()\n    layers = []\n    rows, cols = mask.shape\n    while np.any(remaining):\n        layer = np.zeros_like(mask)\n        for r, c in np.argwhere(remaining):\n            for nr, nc in neighbors4(int(r), int(c)):\n                if nr < 0 or nr >= rows or nc < 0 or nc >= cols or not remaining[nr, nc]:\n                    layer[r, c] = True\n                    break\n        layers.append(layer)\n        remaining[layer] = False\n    return layers\n\ndef _gen_contour(outline, shape):\n    rows, cols = shape.shape\n    contour = np.zeros_like(shape)\n    for r, c in np.argwhere(outline):\n        for nr, nc in neighbors4(int(r), int(c)):\n            if 0 <= nr < rows and 0 <= nc < cols and not shape[nr, nc]:\n                contour[nr, nc] = True\n    return contour\n\ndef _choose_canvas_and_shape_profile():\n    rows = random.randint(GRID_MIN, GRID_MAX)\n    cols = random.randint(GRID_MIN, GRID_MAX)\n    bg = random.randrange(N_COLORS)\n\n    edge_options = []\n    if rows <= SHAPE_MAX_HEIGHT:\n        edge_options.append(EDGE_TOUCH_TOP_BOTTOM)\n    if rows >= SHAPE_MIN_HEIGHT + 1:\n        edge_options.extend(CORNER_EDGE_PAIRS)\n    if not edge_options:\n        return None\n\n    edge_pair = random.choice(edge_options)\n    height = rows if edge_pair == EDGE_TOUCH_TOP_BOTTOM else random.randint(\n        SHAPE_MIN_HEIGHT, min(SHAPE_MAX_HEIGHT, rows - 1)\n    )\n    max_width_limit = cols - 2 if edge_pair == EDGE_TOUCH_TOP_BOTTOM else cols - 1\n    if max_width_limit < SHAPE_MIN_WIDTH:\n        return None\n    max_width = random.randint(SHAPE_MIN_WIDTH, min(SHAPE_MAX_WIDTH, max_width_limit))\n\n    intervals = _gen_intervals(_gen_widths(height, max_width))\n    if intervals is None:\n        return None\n    return rows, cols, bg, edge_pair, intervals\n\ndef _build_shape(rows, cols, edge_pair, intervals):\n    local_mask = _gen_local_mask(intervals)\n    placement = _gen_place_shape((rows, cols), local_mask, edge_pair)\n    if placement is None:\n        return None\n\n    shape = _gen_full_mask(rows, cols, local_mask, *placement)\n    shape_area = int(np.sum(shape))\n    if rows * cols - shape_area <= shape_area:\n        return None\n    return shape\n\ndef _split_valid_layers(shape):\n    layers = _gen_layers(shape)\n    if len(layers) < 2:\n        return None\n\n    outline = layers[0]\n    marker = layers[-1]\n    fill = shape & ~outline & ~marker\n\n    outline_count = int(np.sum(outline))\n    marker_count = int(np.sum(marker))\n    fill_count = int(np.sum(fill))\n    if marker_count < MARKER_MIN_CELLS or marker_count > MARKER_MAX_CELLS:\n        return None\n    if len(components_mask(outline, connectivity=8)) != 1:\n        return None\n    if fill_count and not (marker_count < fill_count < outline_count):\n        return None\n    return outline, fill, marker, fill_count\n\ndef _render_input(rows, cols, bg, masks, colors):\n    outline, fill, marker = masks\n    outline_color, fill_color, marker_color = colors\n    inp = np.full((rows, cols), bg, dtype=int)\n    inp[outline] = outline_color\n    if fill_color is not None:\n        inp[fill] = fill_color\n    inp[marker] = marker_color\n    return inp\n\ndef _gen_attempt():\n    profile = _choose_canvas_and_shape_profile()\n    if profile is None:\n        return None\n    rows, cols, bg, edge_pair, intervals = profile\n\n    shape = _build_shape(rows, cols, edge_pair, intervals)\n    if shape is None:\n        return None\n\n    layer_parts = _split_valid_layers(shape)\n    if layer_parts is None:\n        return None\n    outline, fill, marker, fill_count = layer_parts\n\n    contour = _gen_contour(outline, shape)\n    if not np.any(contour):\n        return None\n\n    colors = [c for c in range(N_COLORS) if c != bg]\n    random.shuffle(colors)\n    outline_color, marker_color = colors[:2]\n    fill_color = colors[2] if fill_count else None\n    inp = _render_input(rows, cols, bg, (outline, fill, marker), (outline_color, fill_color, marker_color))\n\n    expected = np.full((rows, cols), bg, dtype=int)\n    expected[contour] = marker_color\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\ndef generate_input():\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid aa62e3f4 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/9f669b64.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Push the central solid rectangle to the grid edge, splitting the perpendicular target rectangle around its path.\n\n    Input structure\n    - The background is the dominant color.\n    - There are exactly three monochrome foreground objects arranged on one\n      horizontal or vertical axis.\n    - The middle object on that axis is a solid rectangular moving object.\n    - One end object is a solid rectangle or bar whose long side is perpendicular\n      to the movement axis; this is the target to split.\n\n    Rule\n    - Move the middle rectangle along the axis toward the target until it is\n      flush with the grid edge in that direction.\n    - Clear the original middle rectangle and the original target.\n    - Split the target through the moving rectangle's two-cell-wide path and\n      shift the two halves one cell outward perpendicular to the movement.\n    - Keep the other end object unchanged.\n\n    Key insight\n    - The non-target end object acts as a pusher; the central rectangle travels\n      away from it through the perpendicular target, opening a matching gap.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(objects) == 3, \"expected exactly three foreground objects\"\n\n    row_centers = [_center(obj, 0) for obj in objects]\n    col_centers = [_center(obj, 1) for obj in objects]\n    row_spread = max(row_centers) - min(row_centers)\n    col_spread = max(col_centers) - min(col_centers)\n    assert min(row_spread, col_spread) <= 0.5, \"objects must share a row or column axis\"\n    axis = 0 if col_spread <= 0.5 else 1\n    perp = 1 - axis\n\n    ordered = sorted(objects, key=lambda obj: _center(obj, axis))\n    axis_centers = [_center(obj, axis) for obj in ordered]\n    assert axis_centers[0] < axis_centers[1] < axis_centers[2], \"expected a unique middle object\"\n\n    source = ordered[1]\n    end_objects = [ordered[0], ordered[2]]\n    assert _is_solid_rectangle(g, source), \"moving object must be a solid rectangle\"\n\n    target_candidates = [\n        obj\n        for obj in end_objects\n        if _is_solid_rectangle(g, obj) and _span(obj, perp) > _span(obj, axis)\n    ]\n    assert len(target_candidates) == 1, \"expected one perpendicular solid target\"\n    target = target_candidates[0]\n\n    direction = -1 if _center(target, axis) < _center(source, axis) else 1\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    tr0, tc0, tr1, tc1 = target[\"bbox\"]\n    source_lo = [sr0, sc0]\n    source_hi = [sr1, sc1]\n    target_lo = [tr0, tc0]\n    target_hi = [tr1, tc1]\n\n    source_perp_len = source_hi[perp] - source_lo[perp] + 1\n    assert source_perp_len == 2, \"moving object path must be two cells wide\"\n    assert target_lo[perp] <= source_lo[perp] <= source_hi[perp] <= target_hi[perp]\n    assert (\n        source_lo[perp] - target_lo[perp] == target_hi[perp] - source_hi[perp]\n    ), \"moving object must be centered across the target\"\n\n    out = g.copy()\n    for r, c in source[\"coords\"]:\n        out[int(r), int(c)] = bg\n    for r, c in target[\"coords\"]:\n        out[int(r), int(c)] = bg\n\n    shift = source_perp_len // 2\n    for r, c in target[\"coords\"]:\n        new_rc = [int(r), int(c)]\n        if new_rc[perp] <= source_lo[perp]:\n            new_rc[perp] -= shift\n        else:\n            assert new_rc[perp] >= source_hi[perp]\n            new_rc[perp] += shift\n        assert 0 <= new_rc[0] < H and 0 <= new_rc[1] < W, \"shifted target must stay in bounds\"\n        out[new_rc[0], new_rc[1]] = int(target[\"color\"])\n\n    source_patch = crop_bbox(g, source[\"bbox\"])\n    if axis == 0:\n        new_r = 0 if direction < 0 else H - source_patch.shape[0]\n        new_c = source_lo[1]\n    else:\n        new_r = source_lo[0]\n        new_c = 0 if direction < 0 else W - source_patch.shape[1]\n    dest = out[new_r : new_r + source_patch.shape[0], new_c : new_c + source_patch.shape[1]]\n    assert np.all(dest == bg), \"moving object destination must be clear\"\n    paste(out, source_patch, new_r, new_c)\n    return out\n\n# --------------- generator (att2) ---------------\n\nGEN_GRID_SIZE = 10\nGEN_BG = 7\nGEN_FG_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nGEN_SOURCE_PERP = 2\nGEN_SOURCE_ALONG_CHOICES = [2, 3]\nGEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX = 1, 4\nGEN_TARGET_OVERHANG_CHOICES = (1, 2)\nGEN_SOURCE_TARGET_GAP_RANGE = range(5)\nGEN_OTHER_WIDTH_CHOICES = (2, 4, 6)\nGEN_OTHER_MIN_STAIR_WIDTH = 4\nGEN_OTHER_MIN_STAIR_HEIGHT = 2\nGEN_ORIENTATION_COUNT, GEN_RETRY_LIMIT = 4, 300\n\n\ndef _gen_transform(grid: np.ndarray, orientation: int) -> np.ndarray:\n    if orientation == 0:\n        return grid.copy()\n    if orientation == 1:\n        return np.flipud(grid).copy()\n    if orientation == 2:\n        return np.rot90(grid, 1).copy()\n    return np.rot90(grid, -1).copy()\n\n\ndef _gen_even_centered_start(center_left: int, width: int) -> int:\n    return center_left - (width // 2 - 1)\n\n\ndef _gen_stair_patch(h: int, w: int, color: int, bg: int) -> np.ndarray:\n    patch = np.full((h, w), bg, dtype=int)\n    max_extra = w // 2 - 1\n    thresholds = sorted(random.randint(1, h - 1) for _ in range(max_extra))\n    for r in range(h):\n        extra = sum(r >= threshold for threshold in thresholds)\n        c0 = w // 2 - 1 - extra\n        c1 = w // 2 + extra\n        patch[r, c0 : c1 + 1] = color\n    return patch\n\n\ndef _gen_place_other(grid: np.ndarray, r0: int, center_left: int, color: int, bg: int) -> None:\n    h = grid.shape[0] - r0\n    in_bounds_widths = [\n        w\n        for w in GEN_OTHER_WIDTH_CHOICES\n        if 0 <= _gen_even_centered_start(center_left, w)\n        and _gen_even_centered_start(center_left, w) + w <= grid.shape[1]\n    ]\n    solid_widths = [w for w in in_bounds_widths if w <= h]\n    stair_widths = [w for w in in_bounds_widths if w >= GEN_OTHER_MIN_STAIR_WIDTH and h >= GEN_OTHER_MIN_STAIR_HEIGHT]\n\n    kinds = []\n    if solid_widths:\n        kinds.append(\"solid\")\n    if stair_widths:\n        kinds.append(\"stair\")\n    kind = random.choice(kinds)\n\n    if kind == \"solid\":\n        w = random.choice(solid_widths)\n        patch = np.full((h, w), color, dtype=int)\n    else:\n        w = random.choice(stair_widths)\n        patch = _gen_stair_patch(h, w, color, bg)\n    paste(grid, patch, r0, _gen_even_centered_start(center_left, w), transparent=bg)\n\n\ndef _gen_choose_layout() -> tuple[int, int, int, int, int, int] | None:\n    s_h = random.choice(GEN_SOURCE_ALONG_CHOICES)\n    t_h = random.randint(GEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX)\n    overhangs = [k for k in GEN_TARGET_OVERHANG_CHOICES if 2 * k + GEN_SOURCE_PERP > t_h]\n    k = random.choice(overhangs)\n    gap_options = [g for g in GEN_SOURCE_TARGET_GAP_RANGE if t_h + g + s_h <= GEN_GRID_SIZE - GEN_SOURCE_PERP]\n    if not gap_options:\n        return None\n    gap = random.choice(gap_options)\n    t0_max = GEN_GRID_SIZE - GEN_SOURCE_PERP - t_h - gap - s_h\n    t0 = random.randint(0, t0_max)\n    center_left = random.randint(k + 1, GEN_GRID_SIZE - k - 3)\n    return s_h, t_h, k, gap, t0, center_left\n\n\ndef _gen_canonical_pair(s_h: int, t_h: int, k: int, gap: int, t0: int, center_left: int, colors: list[int]) -> tuple[np.ndarray, np.ndarray]:\n    source_color, target_color, other_color = colors\n    source_patch = np.full((s_h, GEN_SOURCE_PERP), source_color, dtype=int)\n    target_patch = np.full((t_h, 2 * k + GEN_SOURCE_PERP), target_color, dtype=int)\n    split_half = np.full((t_h, k + 1), target_color, dtype=int)\n\n    out = np.full((GEN_GRID_SIZE, GEN_GRID_SIZE), GEN_BG, dtype=int)\n    paste(out, source_patch, 0, center_left)\n    paste(out, split_half, t0, center_left - k - 1)\n    paste(out, split_half, t0, center_left + GEN_SOURCE_PERP)\n\n    source_in_r = t0 + t_h + gap\n    other_r = source_in_r + s_h\n    _gen_place_other(out, other_r, center_left, other_color, GEN_BG)\n\n    inp = out.copy()\n    inp[0:s_h, center_left : center_left + GEN_SOURCE_PERP] = GEN_BG\n    inp[t0 : t0 + t_h, center_left - k - 1 : center_left] = GEN_BG\n    inp[t0 : t0 + t_h, center_left + GEN_SOURCE_PERP : center_left + k + 3] = GEN_BG\n    paste(inp, target_patch, t0, center_left - k)\n    paste(inp, source_patch, source_in_r, center_left)\n    return inp, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    colors = random.sample(GEN_FG_COLORS, 3)\n    layout = _gen_choose_layout()\n    if layout is None:\n        return None\n    inp, out = _gen_canonical_pair(*layout, colors)\n\n    orientation = random.randrange(GEN_ORIENTATION_COUNT)\n    inp = _gen_transform(inp, orientation)\n    out = _gen_transform(out, orientation)\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except AssertionError:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 9f669b64 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the region enclosed by a wall sprite and radiate color outward through its opening.\n\n    Input structure:\n    - bg = most common color. Wall = most frequent non-bg color, forming a partial enclosure (e.g. U-shape).\n    - A fill-color pixel sits inside the enclosed area. Other non-bg pixels may act as obstacles.\n    Rule:\n    - Flood-fill the enclosed area with the fill color, radiating outward through the wall's open end.\n    - Obstacles cast \"shadows\" along the radiate direction, blocking fill behind them.\n\n    Key insight: The wall endpoints define the opening direction; fill radiates outward through it, and obstacles block propagation along that same axis.\n    \"\"\"\n    g = np.array(grid, copy=True)\n    h, w = g.shape\n\n    vals = np.unique(g)\n    bg = get_bg(g)\n\n    non_bg = [int(v) for v in vals if int(v) != bg]\n    assert non_bg, \"expected at least one non-background color\"\n\n    # Wall: most frequent non-background color.\n    wall = max(non_bg, key=lambda c: int((g == c).sum()))\n\n    wall_mask = g == wall\n\n    # Wall connected components (8-neigh).\n    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]\n    assert comps, \"expected at least one wall connected component\"\n\n    def sgn(x: int) -> int:\n        return (x > 0) - (x < 0)\n\n    other_colors = [c for c in non_bg if c != wall]\n    assert other_colors, \"expected at least one non-wall color (fill color)\"\n\n    # Pick fill color as the non-wall color closest (Manhattan distance) to the wall pixels.\n    wall_points = [p for comp in comps for p in comp]\n\n    def min_dist_to_wall(color: int) -> tuple[int, int]:\n        pts = list(zip(*np.where(g == color)))\n        pts = [(int(r), int(c)) for r, c in pts]\n        best_d = 10**9\n        for r, c in pts:\n            for wr, wc in wall_points:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0, len(pts)\n        return best_d, len(pts)\n\n    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))\n\n    fill_pos = list(zip(*np.where(g == fill)))\n    fill_pos = [(int(r), int(c)) for r, c in fill_pos]\n    if not fill_pos:\n        return g\n\n    # Choose the closest wall component to the fill seed (ties: larger component).\n    def comp_min_dist(comp: set[tuple[int, int]]) -> int:\n        best_d = 10**9\n        for r, c in fill_pos:\n            for wr, wc in comp:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0\n        return best_d\n\n    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))\n\n    comp_mask = np.zeros_like(wall_mask, dtype=bool)\n    for r, c in wall_comp:\n        comp_mask[r, c] = True\n\n    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:\n        out = []\n        for rr, cc in neighbors8(r, c):\n            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:\n                out.append((rr, cc))\n        return out\n\n    endpoints: list[tuple[int, int]] = []\n    for r, c in wall_comp:\n        if len(comp_neighbors(r, c)) == 1:\n            endpoints.append((r, c))\n\n    assert endpoints, \"expected wall component to have endpoints (degree-1 pixels)\"\n\n    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:\n        n1 = comp_neighbors(*ep)[0]\n        d1 = (sgn(n1[0] - ep[0]), sgn(n1[1] - ep[1]))  # inward\n        d_use = d1\n        is_12 = False\n        n2s = [p for p in comp_neighbors(*n1) if p != ep]\n        if n2s:\n            n2 = n2s[0]\n            d2 = (sgn(n2[0] - n1[0]), sgn(n2[1] - n1[1]))\n            if (d1[0] == 0) ^ (d1[1] == 0):\n                if d2[0] != 0 and d2[1] != 0:\n                    d_use = d2\n                    is_12 = True\n        return (-d_use[0], -d_use[1]), is_12\n\n    out_info = [outward_dir(ep) for ep in endpoints]\n    out_dirs = [d for d, _ in out_info]\n    tip_12 = [f for _, f in out_info]\n\n    dr_sum = sum(d[0] for d in out_dirs)\n    dc_sum = sum(d[1] for d in out_dirs)\n    rad = (sgn(dr_sum), sgn(dc_sum))\n\n    barrier = comp_mask.copy()\n\n    def add_ray(start: tuple[int, int], d: tuple[int, int], skip: int = 0) -> None:\n        rr, cc = start\n        for _ in range(skip):\n            rr += d[0]\n            cc += d[1]\n        while True:\n            rr += d[0]\n            cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:\n        rr, cc = start\n        step = 0\n        while True:\n            step += 1\n            if step % 2 == 1:\n                rr += d[0]; cc += d[1]\n            else:\n                if rad[0] != 0:\n                    rr += d[0]\n                else:\n                    cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):\n        if is_12:\n            add_ray_12(ep, d)\n        else:\n            add_ray(ep, d, skip=0)\n\n    passable = (~barrier) & ((g == bg) | (g == fill))\n    q = fill_pos[:]\n    seen = np.zeros_like(passable, dtype=bool)\n    for r, c in q:\n        if passable[r, c]:\n            seen[r, c] = True\n    while q:\n        r, c = q.pop()\n        for rr, cc in neighbors4(r, c):\n            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:\n                seen[rr, cc] = True\n                q.append((rr, cc))\n\n    filled_mask = (seen & (g == bg))\n\n    out = g.copy()\n    out[filled_mask] = fill\n\n    # Shadow behind obstacles (non-bg, non-fill, non-wall) along radiate direction.\n    obstacles = (g != bg) & (g != fill) & (g != wall)\n\n    def shadow_process(coords: list[tuple[int, int]]) -> None:\n        started = False\n        blocked = False\n        for r, c in coords:\n            if filled_mask[r, c]:\n                started = True\n            if started and obstacles[r, c]:\n                blocked = True\n                continue\n            if blocked and filled_mask[r, c]:\n                out[r, c] = bg\n                filled_mask[r, c] = False\n\n    if rad != (0, 0):\n        dr, dc = rad\n        if dr != 0 and dc == 0:\n            for c in range(w):\n                rows = range(h) if dr > 0 else range(h - 1, -1, -1)\n                shadow_process([(r, c) for r in rows])\n        elif dc != 0 and dr == 0:\n            for r in range(h):\n                cols = range(w) if dc > 0 else range(w - 1, -1, -1)\n                shadow_process([(r, c) for c in cols])\n        else:\n            # Diagonal scanlines\n            if dr == dc:\n                # r - c = const\n                for k in range(-(w - 1), h):\n                    coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]\n                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n                    shadow_process(coords)\n            else:\n                # r + c = const\n                for k in range(h + w - 1):\n                    coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]\n                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n                    shadow_process(coords)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom scipy.ndimage import distance_transform_cdt\n\n# -- Configuration constants --------------------------------------------------\n# Canvas size bounds\nGRID_H_VERT = (11, 18)       # height range when radiate_dir is vertical\nGRID_H_HORIZ = (8, 18)       # height range when radiate_dir is horizontal\nGRID_W = (15, 19)             # width range (all directions)\n\n# Wall geometry\nWALL_PIXELS_MIN = 17          # minimum wall pixel count\nWALL_PIXELS_MAX = 25          # maximum wall pixel count\nDEPTH_VERT = (5, 10)          # arm depth range for vertical radiate\nDEPTH_HORIZ = (6, 8)          # arm depth range for horizontal radiate\nGAP_VERT = (6, 7)             # endpoint gap for vertical radiate\nGAP_HORIZ = (5, 7)            # endpoint gap for horizontal radiate\nTIP_12_PROB = 0.5             # probability of 1:2 arm-angle mode (when eligible)\n\n# Placement margins\nOPEN_END_MARGIN = 3           # min cells from open end to radiate grid edge\n\n# Fill seed\nSEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]  # weighted choices for blob size\nSEED_DEPTH_LOOKBACK = 3       # seed must be within this many rows of closed end\n\n# Obstacles\nMAX_OBSTACLES = 5             # maximum obstacle pixel count\nOBSTACLE_IN_FILL_PROB = 0.65  # probability of forcing at least one obstacle in fill zone\nOBSTACLE_MIN_SEP = 2          # Chebyshev distance between obstacles (> this value)\n\n# Validation\nMIN_NEW_FILL = 20             # minimum newly-filled pixels for a valid output\nPALETTE_SIZE = (3, 5)         # number of distinct colors (bg + wall + fill + obstacle(s))\nGEN_RETRIES = 300             # max attempts in generate_input\n\n\ndef _degree1_pixels(points):\n    \"\"\"Return degree-1 pixels (exactly one 8-neighbor in the set).\"\"\"\n    pts = set(points)\n    return [(r, c) for r, c in pts\n            if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1]\n\n\ndef _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):\n    \"\"\"Build one zigzag arm from (0, start_v) toward (depth, target_v).\"\"\"\n    sign = 1 if target_v > start_v else -1\n    n_side_steps = abs(target_v - start_v)\n    chosen_rows = []\n    if n_side_steps:\n        if tip_12:\n            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]\n            extra_steps = 0\n        else:\n            chosen_rows = [1]\n            if n_side_steps > 1:\n                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)\n            chosen_rows.sort()\n\n    first_row = chosen_rows[0] if chosen_rows else 1\n    extra_rows = [r for r in chosen_rows if r != first_row]\n    random.shuffle(extra_rows)\n    orthogonal_rows = set(extra_rows[:extra_steps])\n\n    pts = [(0, start_v)]\n    u, v = 0, start_v\n    for row in range(1, depth + 1):\n        u += 1\n        if row in orthogonal_rows:\n            pts.append((u, v))\n            v += sign\n        elif row in chosen_rows:\n            v += sign\n        pts.append((u, v))\n    return pts\n\n\ndef _build_local_wall(rad, h, w):\n    \"\"\"Construct wall shape in local (u, v) coordinates. Returns (pts, depth, gap) or None.\"\"\"\n    if rad[0]:\n        max_depth = min(DEPTH_VERT[1], h - 6)\n        if max_depth < DEPTH_VERT[0]:\n            return None\n        depth = random.randint(DEPTH_VERT[0], max_depth)\n        gap = random.randint(*GAP_VERT)\n    else:\n        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))\n        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))\n\n    if gap == 5:\n        left_bottom, right_bottom = 2, 3\n    elif gap == 6:\n        left_bottom, right_bottom = 2, 4\n    else:\n        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])\n\n    bridge_extra = max(0, right_bottom - left_bottom - 1)\n    base_count = 2 * (depth + 1) + bridge_extra\n    max_extra_l = max(0, left_bottom - 1)\n    max_extra_r = max(0, gap - right_bottom - 1)\n    min_extra = max(0, WALL_PIXELS_MIN - base_count)\n    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)\n    if min_extra > max_extra:\n        return None\n\n    extra = random.randint(min_extra, max_extra)\n    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))\n    extra_r = extra - extra_l\n\n    max_n_side = max(left_bottom, gap - right_bottom)\n    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB\n    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)\n    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)\n    pts = set(left) | set(right)\n    for v in range(left_bottom, right_bottom + 1):\n        pts.add((depth, v))\n\n    # Pad wall to minimum size by adding 8-connected pixels that preserve 2 endpoints\n    while len(pts) < WALL_PIXELS_MIN:\n        candidates = [\n            (u, v) for u in range(max(0, depth - 3), depth + 1)\n            for v in range(gap + 1) if (u, v) not in pts\n            and sum((uu, vv) in pts\n                    for uu in range(u - 1, u + 2)\n                    for vv in range(v - 1, v + 2)\n                    if (uu, vv) != (u, v)) >= 2\n        ]\n        random.shuffle(candidates)\n        added = False\n        for p in candidates:\n            trial = pts | {p}\n            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:\n                pts = trial\n                added = True\n                break\n        if not added:\n            return None\n\n    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:\n        return None\n    return pts, depth, gap\n\n\ndef _map_local(u, v, rad, anchor):\n    \"\"\"Map local (u, v) to grid (r, c) given radiate direction and anchor.\"\"\"\n    r0, c0 = anchor\n    if rad == (-1, 0):\n        return r0 + u, c0 + v\n    if rad == (1, 0):\n        return r0 - u, c0 + v\n    if rad == (0, -1):\n        return r0 + v, c0 + u\n    return r0 + v, c0 - u\n\n\ndef _place_anchor(rad, h, w, depth, gap):\n    \"\"\"Choose anchor so the wall fits within margins.\"\"\"\n    if rad == (-1, 0):\n        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)\n    if rad == (1, 0):\n        return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)\n    if rad == (0, -1):\n        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)\n    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)\n\n\ndef _local_interior(wall, depth, gap):\n    \"\"\"Return bg cells strictly between the two wall arms in local coords.\"\"\"\n    by_row = {}\n    for u, v in wall:\n        by_row.setdefault(u, []).append(v)\n    interior = []\n    for u in range(1, depth):\n        if u not in by_row or len(by_row[u]) < 2:\n            continue\n        lo, hi = min(by_row[u]), max(by_row[u])\n        for v in range(lo + 1, hi):\n            if (u, v) not in wall:\n                interior.append((u, v))\n    return interior\n\n\ndef _grow_seed_blob(seed, interior_set):\n    \"\"\"Grow a small 4-connected blob from seed within interior cells.\"\"\"\n    blob = {seed}\n    target_size = random.choice(SEED_SIZE_WEIGHTS)\n    frontier = [seed]\n    while len(blob) < target_size and frontier:\n        p = frontier.pop(random.randrange(len(frontier)))\n        u, v = p\n        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):\n            if q in interior_set and q not in blob:\n                blob.add(q)\n                frontier.append(q)\n                if len(blob) >= target_size:\n                    break\n    return blob\n\n\ndef _obstacle_fits(pos, placed):\n    \"\"\"Check that pos is at least Chebyshev OBSTACLE_MIN_SEP from all placed obstacles.\"\"\"\n    r, c = pos\n    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)\n\n\ndef _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone):\n    \"\"\"Find bg cells far enough from wall for obstacle placement, using distance transform.\"\"\"\n    wall_mask = grid == wall_color\n    # distance_transform_cdt with chessboard metric gives Chebyshev distance to wall\n    dist = distance_transform_cdt(~wall_mask, metric='taxicab')\n    far_from_wall = dist > 1\n    eligible = (grid == bg) & far_from_wall\n    all_coords = list(zip(*np.where(eligible)))\n    fill_coords = [p for p in all_coords if nominal_fill_zone[p[0], p[1]]]\n    random.shuffle(all_coords)\n    random.shuffle(fill_coords)\n    return [(int(r), int(c)) for r, c in all_coords], [(int(r), int(c)) for r, c in fill_coords]\n\n\ndef _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid):\n    \"\"\"Place up to n_obstacles on the grid, preferring some in the fill zone.\"\"\"\n    placed = []\n    n_fill = random.randint(0, min(n_obstacles, len(fill_candidates)))\n    if fill_candidates and random.random() < OBSTACLE_IN_FILL_PROB:\n        n_fill = max(1, n_fill)\n    for p in fill_candidates:\n        if len(placed) >= n_fill:\n            break\n        if _obstacle_fits(p, placed):\n            placed.append(p)\n    placed_set = set(placed)\n    for p in candidates:\n        if len(placed) >= n_obstacles:\n            break\n        if p not in placed_set and _obstacle_fits(p, placed):\n            placed.append(p)\n            placed_set.add(p)\n    for i, (r, c) in enumerate(placed):\n        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]\n\n\ndef _touches_border(mask):\n    \"\"\"Check if any True cell in mask lies on the grid border.\"\"\"\n    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())\n\n\ndef _gen_attempt():\n    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])\n    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)\n    w = random.randint(*GRID_W)\n\n    built = _build_local_wall(rad, h, w)\n    if built is None:\n        return None\n    local_wall, depth, gap = built\n    anchor = _place_anchor(rad, h, w, depth, gap)\n\n    # Choose palette\n    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))\n    bg, wall_color, fill_color = palette[:3]\n    obstacle_colors = palette[3:]\n\n    # Render wall onto grid\n    grid = np.full((h, w), bg, dtype=int)\n    for u, v in local_wall:\n        r, c = _map_local(u, v, rad, anchor)\n        grid[r, c] = wall_color\n\n    # Place fill seed near the closed end\n    interior = _local_interior(local_wall, depth, gap)\n    wall_set = set(local_wall)\n    adjacent = [\n        p for p in interior\n        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])\n    ]\n    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]\n    if not seed_pool:\n        return None\n\n    blob = _grow_seed_blob(random.choice(seed_pool), set(interior))\n    for u, v in blob:\n        r, c = _map_local(u, v, rad, anchor)\n        if grid[r, c] != bg:\n            return None\n        grid[r, c] = fill_color\n\n    # Run solver to find nominal fill zone (used for obstacle placement)\n    try:\n        nominal_out = main(grid)\n    except Exception:\n        return None\n    nominal_fill_zone = (nominal_out == fill_color) & (grid == bg)\n\n    # Place obstacles\n    n_obstacles = random.randint(0, MAX_OBSTACLES)\n    if n_obstacles and not obstacle_colors:\n        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]\n        obstacle_colors = random.sample(available, random.randint(1, 2))\n    if n_obstacles:\n        candidates, fill_candidates = _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone)\n        _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid)\n\n    # Validate: solver must produce enough fill that reaches a border\n    try:\n        out = main(grid)\n    except Exception:\n        return None\n    new_fill = (out == fill_color) & (grid == bg)\n    if int(new_fill.sum()) < MIN_NEW_FILL or not _touches_border(new_fill):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid b9e38dc0 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/581f7754.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n                frontier.append((rr, cc))\n    return frontier\n\n\ndef _grow_body(area):\n    choices = [\n        (h, w)\n        for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n        for w in _inclusive_range(_BODY_WIDTH_RANGE)\n        if h * w >= area\n    ]\n    h, w = random.choice(choices)\n    cells = set(random.choice(_GROW_BODY_SEEDS))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, h, w)\n        if not frontier:\n            return _grow_body(area)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n\n\ndef _symmetric_body(area):\n    choices = []\n    for height in _inclusive_range(_BODY_HEIGHT_RANGE):\n        extra = area - height\n        if extra >= 2 and extra % 2 == 0 and extra // 2 <= height:\n            choices.append((height, extra // 2))\n    if not choices:\n        return _grow_body(area)\n\n    height, pair_count = random.choice(choices)\n    cells = {(r, 1) for r in range(height)}\n    rows = list(range(height))\n    random.shuffle(rows)\n    for r in rows[:pair_count]:\n        cells.add((r, 0))\n        cells.add((r, 2))\n\n    if height >= _SYMMETRIC_TRANSPOSE_MIN_HEIGHT and random.random() < _SYMMETRIC_TRANSPOSE_PROB:\n        cells = {(c, r) for r, c in cells}\n    return _flip(cells)\n\n\ndef _wide_body(area):\n    width = random.randint(_BODY_WIDTH_RANGE[0], min(_BODY_WIDTH_RANGE[1], area - 1))\n    height = random.choice([h for h in _inclusive_range(_BODY_HEIGHT_RANGE) if h * width >= area])\n    cells = {(0, c) for c in range(width)}\n    cells.add((1, random.randrange(width)))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, height, width)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n\n\ndef _frame_body(area):\n    choices = []\n    for h in _inclusive_range(_FRAME_HEIGHT_RANGE):\n        for w in _inclusive_range(_FRAME_WIDTH_RANGE):\n            perim = 2 * h + 2 * w - 4\n            removable = 2 * max(0, h - 2) + 2 * max(0, w - 2)\n            if perim >= area and perim - area <= min(_FRAME_MAX_GAP, removable):\n                choices.append((h, w))\n    if not choices:\n        return _grow_body(area)\n\n    h, w = random.choice(choices)\n    cells = {\n        (r, c)\n        for r in range(h)\n        for c in range(w)\n        if r in (0, h - 1) or c in (0, w - 1)\n    }\n    gap = len(cells) - area\n    if gap:\n        removable = [\n            (r, c)\n            for r, c in cells\n            if not (r in (0, h - 1) and c in (0, w - 1))\n        ]\n        for cell in random.sample(removable, gap):\n            cells.remove(cell)\n    return _flip(cells)\n\n\ndef _make_body(area):\n    x = random.random()\n    if area >= _FRAME_MIN_AREA and x < _FRAME_BODY_THRESHOLD:\n        return _frame_body(area)\n    if x < _WIDE_BODY_THRESHOLD:\n        return _wide_body(area)\n    if x < _SYMMETRIC_BODY_THRESHOLD:\n        return _symmetric_body(area)\n    return _grow_body(area)\n\n\ndef _marker_cell(body):\n    r0, c0, r1, c1 = _bbox(body)\n    interior, exterior = set(), set()\n    for r, c in body:\n        for dr, dc in _NEIGHBORS4:\n            p = (r + dr, c + dc)\n            if p in body:\n                continue\n            if r0 <= p[0] <= r1 and c0 <= p[1] <= c1:\n                interior.add(p)\n            else:\n                exterior.add(p)\n    pool = list(interior if interior and random.random() < _MARKER_INTERIOR_PROB else (exterior | interior))\n    return random.choice(pool)\n\n\ndef _make_sprite(area, body_color, marker_color, bg):\n    body = _make_body(area)\n    marker = _marker_cell(body)\n    all_cells = set(body) | {marker}\n    r0, c0, r1, c1 = _bbox(all_cells)\n    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)\n    for r, c in body:\n        patch[r - r0, c - c0] = int(body_color)\n    patch[marker[0] - r0, marker[1] - c0] = int(marker_color)\n    return {\"patch\": patch, \"offset\": (marker[0] - r0, marker[1] - c0)}\n\n\ndef _top_left(sprite, marker_r, marker_c):\n    off_r, off_c = sprite[\"offset\"]\n    return int(marker_r) - int(off_r), int(marker_c) - int(off_c)\n\n\ndef _can_place(canvas, sprite, marker_r, marker_c, bg):\n    patch = sprite[\"patch\"]\n    top, left = _top_left(sprite, marker_r, marker_c)\n    h, w = patch.shape\n    H, W = canvas.shape\n    if top < _INNER_BORDER_GAP or left < _INNER_BORDER_GAP:\n        return False\n    if top + h > H - _INNER_BORDER_GAP or left + w > W - _INNER_BORDER_GAP:\n        return False\n    mask = patch != int(bg)\n    view = canvas[top : top + h, left : left + w]\n    if bool((view[mask] != int(bg)).any()):\n        return False\n    return not _touches_foreground(canvas, mask, top, left, bg)\n\n\ndef _touches_foreground(canvas, mask, top, left, bg):\n    \"\"\"Return True if any patch cell has a non-bg 8-neighbor on canvas.\"\"\"\n    h, w = mask.shape\n    radius = _ISOLATION_RADIUS\n    occupied = canvas[top - radius : top + h + radius, left - radius : left + w + radius] != int(bg)\n    touch_zone = np.zeros((h + 2 * radius, w + 2 * radius), dtype=bool)\n    span = 2 * radius + 1\n    for dr in range(span):\n        for dc in range(span):\n            touch_zone[dr : dr + h, dc : dc + w] |= mask\n    return bool((occupied & touch_zone).any())\n\n\ndef _place(canvas, sprite, marker_r, marker_c, bg):\n    top, left = _top_left(sprite, marker_r, marker_c)\n    paste(canvas, sprite[\"patch\"], top, left, transparent=int(bg))\n\n\ndef _anchor_ok(canvas, r, c, bg):\n    H, W = canvas.shape\n    if not (r in (0, H - 1) or c in (0, W - 1)):\n        return False\n    if r in (0, H - 1) and c in (0, W - 1):\n        return False\n    return _isolated_bg_cell(canvas, r, c, bg)\n\n\ndef _isolated_bg_cell(canvas, r, c, bg):\n    \"\"\"Return True when a cell and its in-bounds 8-neighborhood are bg.\"\"\"\n    H, W = canvas.shape\n    radius = _ISOLATION_RADIUS\n    r0, r1 = max(0, r - radius), min(H, r + radius + 1)\n    c0, c1 = max(0, c - radius), min(W, c + radius + 1)\n    return not bool((canvas[r0:r1, c0:c1] != int(bg)).any())\n\n\ndef _anchor_candidates(canvas, bg):\n    H, W = canvas.shape\n    rows = list(range(_ANCHOR_EDGE_MARGIN, H - _ANCHOR_EDGE_MARGIN))\n    rows = rows or list(range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP))\n    cols = list(range(_ANCHOR_EDGE_MARGIN, W - _ANCHOR_EDGE_MARGIN))\n    cols = cols or list(range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP))\n    out = []\n    for c in cols:\n        out.append((\"h\", 0, c))\n        out.append((\"h\", H - 1, c))\n    for r in rows:\n        out.append((\"v\", r, 0))\n        out.append((\"v\", r, W - 1))\n    random.shuffle(out)\n    return [(axis, r, c) for axis, r, c in out if _anchor_ok(canvas, r, c, bg)]\n\n\ndef _put_anchor(canvas, r, c, color):\n    paste(canvas, np.array([[int(color)]], dtype=int), int(r), int(c))\n\n\ndef _aligned_positions(canvas, sprite, anchor, bg):\n    H, W = canvas.shape\n    if anchor[\"axis\"] == \"h\":\n        return [\n            (r, anchor[\"c\"])\n            for r in range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP)\n            if _can_place(canvas, sprite, r, anchor[\"c\"], bg)\n        ]\n    return [\n        (anchor[\"r\"], c)\n        for c in range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP)\n        if _can_place(canvas, sprite, anchor[\"r\"], c, bg)\n    ]\n\n\ndef _scatter_positions(canvas, sprite, anchor, marker, bg):\n    H, W = canvas.shape\n    mr, mc = marker\n    if anchor[\"axis\"] == \"h\":\n        return [\n            (mr, c)\n            for c in range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP)\n            if c != mc and _can_place(canvas, sprite, mr, c, bg)\n        ]\n    return [\n        (r, mc)\n        for r in range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP)\n        if r != mr and _can_place(canvas, sprite, r, mc, bg)\n    ]\n\n\ndef _body_color(bg, marker, used):\n    pool = [c for c in _COLORS if c not in {int(bg), int(marker)} and c not in used]\n    if not pool:\n        pool = [c for c in _COLORS if c not in {int(bg), int(marker)}]\n    return random.choice(pool)\n\n\ndef _bg_is_mode(grid, bg):\n    counts = Counter(map(int, grid.ravel()))\n    return counts[int(bg)] > max((n for c, n in counts.items() if c != int(bg)), default=0)\n\n\ndef _add_distractors(out, inp, anchors, bg):\n    vertical = [a for a in anchors if a[\"axis\"] == \"v\"]\n    if not vertical or random.random() >= _DISTRACTOR_PROB:\n        return\n    anchor = random.choice(vertical)\n    sprite = {\"patch\": np.array([[anchor[\"color\"]]], dtype=int), \"offset\": (0, 0)}\n    for _ in range(random.randint(*_DISTRACTOR_COUNT_RANGE)):\n        pairs = []\n        for c in range(_INNER_BORDER_GAP, out.shape[1] - _INNER_BORDER_GAP):\n            if not _can_place(out, sprite, anchor[\"r\"], c, bg):\n                continue\n            for r in range(_INNER_BORDER_GAP, out.shape[0] - _INNER_BORDER_GAP):\n                if r != anchor[\"r\"] and _can_place(inp, sprite, r, c, bg):\n                    pairs.append((r, c))\n        if not pairs:\n            return\n        in_r, col = random.choice(pairs)\n        _place(out, sprite, anchor[\"r\"], col, bg)\n        _place(inp, sprite, in_r, col, bg)\n\n\ndef _gen_attempt():\n    bg, out, inp = _new_canvas_pair()\n    placed = _place_anchors(out, inp, bg)\n    if placed is None:\n        return None\n    anchor_colors, anchors = placed\n\n    marker_colors = _marker_color_sequence(anchor_colors)\n    sprites = _place_aligned_sprites(out, anchors, marker_colors, bg)\n    if sprites is None:\n        return None\n\n    if not _scatter_sprites(inp, sprites, bg):\n        return None\n\n    _add_distractors(out, inp, anchors, bg)\n    if not _generated_grid_is_valid(inp, out, bg):\n        return None\n    return inp\n\n\ndef _new_canvas_pair():\n    \"\"\"Choose grid size/background and return matching output/input canvases.\"\"\"\n    H = random.randint(*_GRID_HEIGHT_RANGE)\n    W = random.randint(*_GRID_WIDTH_RANGE)\n    bg = random.randint(*_BG_COLOR_RANGE)\n    out = np.full((H, W), int(bg), dtype=int)\n    inp = np.full((H, W), int(bg), dtype=int)\n    return bg, out, inp\n\n\ndef _place_anchors(out, inp, bg):\n    \"\"\"Place distinct isolated border anchors into both canvases.\"\"\"\n    anchor_colors = random.sample([c for c in _COLORS if c != bg], random.randint(*_ANCHOR_COUNT_RANGE))\n    anchors = []\n    for color in anchor_colors:\n        candidates = _anchor_candidates(out, bg)\n        if not candidates:\n            return None\n        axis, r, c = random.choice(candidates)\n        anchor = {\"color\": int(color), \"r\": int(r), \"c\": int(c), \"axis\": axis}\n        anchors.append(anchor)\n        _put_anchor(out, r, c, color)\n        _put_anchor(inp, r, c, color)\n    return anchor_colors, anchors\n\n\ndef _marker_color_sequence(anchor_colors):\n    \"\"\"Expand anchor colors to the sprite count, allowing repeated markers.\"\"\"\n    n_sprites = random.randint(*_SPRITE_COUNT_RANGE)\n    marker_colors = anchor_colors[:]\n    while len(marker_colors) < n_sprites:\n        marker_colors.append(random.choice(anchor_colors))\n    random.shuffle(marker_colors)\n    return marker_colors\n\n\ndef _place_aligned_sprites(out, anchors, marker_colors, bg):\n    \"\"\"Build sprites in their solved locations and return their align metadata.\"\"\"\n    by_color = {a[\"color\"]: a for a in anchors}\n    used_body = set()\n    sprites = []\n    for marker in marker_colors:\n        anchor = by_color[int(marker)]\n        body = _body_color(bg, marker, used_body)\n        used_body.add(body)\n        sprite = _make_sprite(random.randint(*_BODY_AREA_RANGE), body, marker, bg)\n        positions = _aligned_positions(out, sprite, anchor, bg)\n        if not positions:\n            return None\n        marker_pos = random.choice(positions)\n        _place(out, sprite, marker_pos[0], marker_pos[1], bg)\n        sprites.append((sprite, anchor, marker_pos))\n    return sprites\n\n\ndef _scatter_sprites(inp, sprites, bg):\n    \"\"\"Move solved sprites onto the input canvas along the inverse axis.\"\"\"\n    random.shuffle(sprites)\n    for sprite, anchor, marker_pos in sprites:\n        positions = _scatter_positions(inp, sprite, anchor, marker_pos, bg)\n        if not positions:\n            return False\n        in_pos = random.choice(positions)\n        _place(inp, sprite, in_pos[0], in_pos[1], bg)\n    return True\n\n\ndef _generated_grid_is_valid(inp, out, bg):\n    \"\"\"Apply generator invariants and the solver oracle check.\"\"\"\n    if not _bg_is_mode(inp, bg):\n        return False\n    return bool(np.array_equal(main(inp), out))\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 581f7754 input\")\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/6165ea8f.py',\n'/home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py',\n'/home/lixinyu/snap/new/ARC_code/eval/6e453dd6.py',\n]\nfor path in files:\n    text = Path(path).read_text().splitlines()\n    print(f'===== {path} =====')\n    starts = []\n    for i, line in enumerate(text):\n        if line.startswith('def main(') or line.startswith('def generate_input('):\n            starts.append(i)\n    for idx, start in enumerate(starts):\n        end = starts[idx + 1] if idx + 1 < len(starts) else min(len(text), start + 180)\n        for line in text[start:end]:\n            print(line)\n    print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/6165ea8f.py',\n'/home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py',\n'/home/lixinyu/snap/new/ARC_code/eval/6e453dd6.py',\n]\nfor path in files:\n    text = Path(path).read_text().splitlines()\n    print(f'===== {path} =====')\n    starts = []\n    for i, line in enumerate(text):\n        if line.startswith('def main(') or line.startswith('def generate_input('):\n            starts.append(i)\n    for idx, start in enumerate(starts):\n        end = starts[idx + 1] if idx + 1 < len(starts) else min(len(text), start + 180)\n        for line in text[start:end]:\n            print(line)\n    print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/train/6165ea8f.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Build a color-labeled shape-equivalence table from the objects listed on the right edge.\n\n    Input structure:\n    - The background contains one main 4-connected object for each foreground color.\n    - The rightmost column has one singleton pixel of each foreground color, listed top-to-bottom.\n    - Those singleton pixels define the row and column order of the output table.\n\n    Rule:\n    - Normalize each main object to its tight mask and compare masks up to rotation or reflection.\n    - Draw 2x2 color labels across the top and down the left, separated by one background row/column.\n    - For each off-diagonal table cell, paint a 2x2 red block when the two labeled objects have the same shape under rotation/reflection, otherwise paint a 2x2 grey block.\n    - Leave diagonal cells and all separators as background.\n\n    Key insight:\n    - Object positions and original orientations are distractors; the relation is dihedral shape equivalence, while the right-edge legend fixes the table order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    order = _legend_order(g, bg)\n    signatures = {color: _shape_signature(_main_object_mask(g, bg, color)) for color in order}\n\n    n = len(order)\n    out = np.full((3 * n + 2, 3 * n + 2), int(bg), dtype=int)\n\n    for i, color in enumerate(order):\n        band = 3 + 3 * i\n        out[0:2, band : band + 2] = int(color)\n        out[band : band + 2, 0:2] = int(color)\n\n    for i, row_color in enumerate(order):\n        for j, col_color in enumerate(order):\n            if i == j:\n                continue\n            cell_color = Color.RED if signatures[row_color] == signatures[col_color] else Color.GREY\n            r = 3 + 3 * i\n            c = 3 + 3 * j\n            out[r : r + 2, c : c + 2] = int(cell_color)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and object bounds.\nGEN_OBJECT_COUNT_RANGE, GEN_GRID_ROW_RANGE, GEN_GRID_COL_RANGE = (4, 7), (20, 25), (20, 23)\nGEN_OBJECT_AREA_RANGE, GEN_OBJECT_BBOX_RANGE, GEN_OBJECT_MAX_EXTRA_CELLS = (5, 13), (2, 7), 4\n# Shape-class sampling.\nGEN_CLASS_OPTIONS, GEN_MAX_CLASS_SIZE, GEN_UNIQUE_MASK_RETRIES = (2, 3), 3, 80\nGEN_DIHEDRAL_FLIP_PROB = 0.5\n# Output table layout and colors.\nGEN_OBJECT_COLORS, GEN_TABLE_BLOCK, GEN_TABLE_STEP = [1, 3, 4, 6, 7, 8, 9], 2, 3\nGEN_SAME_SHAPE_COLOR, GEN_DIFFERENT_SHAPE_COLOR = int(Color.RED), int(Color.GREY)\n# Input placement and retry limits.\nGEN_RESERVED_RIGHT_COLS, GEN_ATTEMPTS = 2, 300\nGEN_PLACEMENT_BORDER, GEN_PLACEMENT_PADDING, GEN_PLACEMENT_CONNECTIVITY = 1, 2, 4\nGEN_NEIGHBORS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _gen_tight_mask(mask: np.ndarray) -> np.ndarray:\n    coords = np.argwhere(mask)\n    r0, c0, r1, c1 = bbox_coords(coords)\n    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)\n\n\ndef _gen_mask_key(mask: np.ndarray) -> tuple[str, ...]:\n    return tuple(\"\".join(\"1\" if cell else \"0\" for cell in row) for row in mask)\n\n\ndef _gen_shape_signature(mask: np.ndarray) -> tuple[str, ...]:\n    base = _gen_tight_mask(mask)\n    variants = []\n    for k in range(4):\n        rotated = np.rot90(base, k)\n        variants.append(_gen_mask_key(_gen_tight_mask(rotated)))\n        variants.append(_gen_mask_key(_gen_tight_mask(np.fliplr(rotated))))\n    return min(variants)\n\n\ndef _has_hole(mask: np.ndarray) -> bool:\n    bg = ~mask.astype(bool)\n    if not bool(bg.any()):\n        return False\n\n    H, W = bg.shape\n    seen = np.zeros_like(bg, dtype=bool)\n    stack: list[tuple[int, int]] = []\n    for r in range(H):\n        for c in (0, W - 1):\n            if bg[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                stack.append((r, c))\n    for c in range(W):\n        for r in (0, H - 1):\n            if bg[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                stack.append((r, c))\n\n    while stack:\n        r, c = stack.pop()\n        for dr, dc in GEN_NEIGHBORS_4:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and bg[nr, nc] and not seen[nr, nc]:\n                seen[nr, nc] = True\n                stack.append((nr, nc))\n    return bool((bg & ~seen).any())\n\n\ndef _random_corner_path(h: int, w: int) -> np.ndarray:\n    starts = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]\n    sr, sc = random.choice(starts)\n    er, ec = h - 1 - sr, w - 1 - sc\n    moves = [(1 if er > sr else -1, 0)] * (h - 1)\n    moves += [(0, 1 if ec > sc else -1)] * (w - 1)\n    random.shuffle(moves)\n\n    mask = np.zeros((h, w), dtype=bool)\n    r, c = sr, sc\n    mask[r, c] = True\n    for dr, dc in moves:\n        r += dr\n        c += dc\n        mask[r, c] = True\n    return mask\n\n\ndef _growth_candidates(mask: np.ndarray) -> list[tuple[int, int]]:\n    h, w = mask.shape\n    choices = []\n    for r in range(h):\n        for c in range(w):\n            if mask[r, c]:\n                continue\n            touches = sum(\n                0 <= r + dr < h and 0 <= c + dc < w and mask[r + dr, c + dc]\n                for dr, dc in GEN_NEIGHBORS_4\n            )\n            if touches != 1:\n                continue\n            trial = mask.copy()\n            trial[r, c] = True\n            if not _has_hole(trial):\n                choices.append((r, c))\n    return choices\n\n\ndef _random_mask() -> np.ndarray | None:\n    area = random.randint(*GEN_OBJECT_AREA_RANGE)\n    pairs = [\n        (h, w)\n        for h in range(GEN_OBJECT_BBOX_RANGE[0], GEN_OBJECT_BBOX_RANGE[1] + 1)\n        for w in range(GEN_OBJECT_BBOX_RANGE[0], GEN_OBJECT_BBOX_RANGE[1] + 1)\n        if h + w - 1 <= area <= h * w\n        and area - (h + w - 1) <= GEN_OBJECT_MAX_EXTRA_CELLS\n    ]\n    h, w = random.choice(pairs)\n    mask = _random_corner_path(h, w)\n\n    while int(mask.sum()) < area:\n        choices = _growth_candidates(mask)\n        if not choices:\n            return None\n        r, c = random.choice(choices)\n        mask[r, c] = True\n    return mask\n\n\ndef _class_sizes(n: int) -> list[int]:\n    k = random.choice([k for k in GEN_CLASS_OPTIONS if k <= n <= GEN_MAX_CLASS_SIZE * k])\n    sizes = [1] * k\n    for _ in range(n - k):\n        open_slots = [i for i, size in enumerate(sizes) if size < GEN_MAX_CLASS_SIZE]\n        sizes[random.choice(open_slots)] += 1\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _unique_canonical_masks(class_count: int) -> list[np.ndarray] | None:\n    canonical_masks: list[np.ndarray] = []\n    signatures: set[tuple[str, ...]] = set()\n    for _ in range(class_count):\n        for _ in range(GEN_UNIQUE_MASK_RETRIES):\n            mask = _random_mask()\n            if mask is None:\n                continue\n            sig = _gen_shape_signature(mask)\n            if sig in signatures:\n                continue\n            signatures.add(sig)\n            canonical_masks.append(mask)\n            break\n        else:\n            return None\n    return canonical_masks\n\n\ndef _dihedral(mask: np.ndarray) -> np.ndarray:\n    out = np.rot90(mask, random.randrange(4))\n    if random.random() < GEN_DIHEDRAL_FLIP_PROB:\n        out = np.fliplr(out)\n    return out.astype(bool).copy()\n\n\ndef _build_output(colors: list[int], class_ids: list[int]) -> np.ndarray:\n    n = len(colors)\n    out_size = GEN_TABLE_STEP * n + GEN_TABLE_BLOCK\n    out = np.zeros((out_size, out_size), dtype=int)\n    for i, color in enumerate(colors):\n        band = GEN_TABLE_STEP + GEN_TABLE_STEP * i\n        out[0:GEN_TABLE_BLOCK, band : band + GEN_TABLE_BLOCK] = color\n        out[band : band + GEN_TABLE_BLOCK, 0:GEN_TABLE_BLOCK] = color\n\n    for i in range(n):\n        for j in range(n):\n            if i == j:\n                continue\n            r = GEN_TABLE_STEP + GEN_TABLE_STEP * i\n            c = GEN_TABLE_STEP + GEN_TABLE_STEP * j\n            cell_color = GEN_SAME_SHAPE_COLOR if class_ids[i] == class_ids[j] else GEN_DIFFERENT_SHAPE_COLOR\n            out[r : r + GEN_TABLE_BLOCK, c : c + GEN_TABLE_BLOCK] = cell_color\n    return out\n\n\ndef _sample_design() -> tuple[list[int], list[np.ndarray], np.ndarray] | None:\n    n = random.randint(*GEN_OBJECT_COUNT_RANGE)\n    colors = random.sample(GEN_OBJECT_COLORS, n)\n    sizes = _class_sizes(n)\n    class_ids = [class_i for class_i, size in enumerate(sizes) for _ in range(size)]\n    random.shuffle(class_ids)\n    canonical_masks = _unique_canonical_masks(len(sizes))\n    if canonical_masks is None:\n        return None\n    oriented_masks = [_dihedral(canonical_masks[class_i]) for class_i in class_ids]\n    expected = _build_output(colors, class_ids)\n    return colors, oriented_masks, expected\n\ndef _build_input_grid(colors: list[int], oriented_masks: list[np.ndarray]) -> np.ndarray | None:\n    n = len(colors)\n    H = random.randint(*GEN_GRID_ROW_RANGE)\n    W = random.randint(*GEN_GRID_COL_RANGE)\n    grid = np.zeros((H, W), dtype=int)\n    place_canvas = grid[:, : W - GEN_RESERVED_RIGHT_COLS]\n\n    place_order = list(range(n))\n    random.shuffle(place_order)\n    for i in place_order:\n        patch = np.zeros(oriented_masks[i].shape, dtype=int)\n        patch[oriented_masks[i]] = colors[i]\n        try:\n            r, c = random_free_location(\n                place_canvas,\n                patch,\n                transparent=0,\n                border=GEN_PLACEMENT_BORDER,\n                padding=GEN_PLACEMENT_PADDING,\n                padding_connectivity=GEN_PLACEMENT_CONNECTIVITY,\n            )\n        except ValueError:\n            return None\n        paste(place_canvas, patch, r, c, transparent=0)\n\n    for r, color in enumerate(colors):\n        grid[r, -1] = color\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    design = _sample_design()\n    if design is None:\n        return None\n    colors, oriented_masks, expected = design\n    grid = _build_input_grid(colors, oriented_masks)\n    if grid is None:\n        return None\n    try:\n        actual = main(grid)\n    except AssertionError:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 6165ea8f input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Shear the rectangular input down-left onto a black canvas.\n\n    Input structure\n    A rectangular grid of colored pixels with no internal empty region to infer.\n\n    Rule\n    Create a black output with the same height and width W + H - 1, then copy\n    each input row r unchanged starting at column H - 1 - r.\n\n    Key insight\n    The colors and row contents are preserved; only the row offsets change so\n    the left edge forms a descending diagonal.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    out = np.zeros((h, w + h - 1), dtype=int)\n    for r in range(h):\n        start = h - 1 - r\n        out[r, start : start + w] = g[r]\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and palette bounds.\nMIN_HEIGHT, MAX_HEIGHT = 2, 10\nMIN_WIDTH, MAX_WIDTH = 1, 9\nMIN_COLOR_COUNT, MAX_COLOR_COUNT = 4, 5\nMAX_CELLS, MAX_OUTPUT_WIDTH = 36, 30\nPALETTE_VALUES = range(1, 10)\n\n# Fill pattern controls.\nFILL_MODES = (\"noise\", \"row_runs\", \"column_bands\", \"diagonal_bands\")\nMAX_ROW_RUN_CUTS = 3\nCOLUMN_NOISE_PROB = 0.5\nMIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND = 1, 3\nDIAGONAL_FLIP_PROB = 0.5\n\n# Generation safety.\nGENERATION_RETRIES = 300\n\n\ndef _ensure_palette_coverage(arr, palette):\n    positions = random.sample(range(arr.size), len(palette))\n    rows, cols = np.divmod(positions, arr.shape[1])\n    arr[rows, cols] = palette\n\n\ndef _fill_grid(h, w, palette):\n    k = len(palette)\n    mode = random.choice(FILL_MODES)\n    arr = np.zeros((h, w), dtype=int)\n\n    if mode == \"noise\":\n        arr[:] = np.random.choice(palette, size=(h, w))\n    elif mode == \"row_runs\":\n        for r in range(h):\n            cuts = sorted(random.sample(range(1, w), random.randint(0, min(w - 1, MAX_ROW_RUN_CUTS)))) if w > 1 else []\n            starts = [0] + cuts\n            ends = cuts + [w]\n            last = None\n            for c0, c1 in zip(starts, ends):\n                choices = [c for c in palette if c != last] or list(palette)\n                last = random.choice(choices)\n                arr[r, c0:c1] = last\n    elif mode == \"column_bands\":\n        for c in range(w):\n            arr[:, c] = random.choice(palette)\n        if random.random() < COLUMN_NOISE_PROB:\n            for r in range(h):\n                arr[r, random.randrange(w)] = random.choice(palette)\n    else:\n        band = random.randint(MIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND)\n        phase = random.randrange(k)\n        rows, cols = np.indices((h, w))\n        arr[:] = np.asarray(palette)[((rows + cols) // band + phase) % k]\n        if random.random() < DIAGONAL_FLIP_PROB:\n            arr = np.fliplr(arr)\n\n    _ensure_palette_coverage(arr, palette)\n    return arr\n\n\ndef _gen_attempt():\n    k = random.randint(MIN_COLOR_COUNT, MAX_COLOR_COUNT)\n    h = random.randint(MIN_HEIGHT, MAX_HEIGHT)\n    widths = [\n        w\n        for w in range(MIN_WIDTH, MAX_WIDTH + 1)\n        if h * w >= k and h * w <= MAX_CELLS and w + h - 1 <= MAX_OUTPUT_WIDTH\n    ]\n    if not widths:\n        return None\n    w = random.choice(widths)\n    palette = random.sample(PALETTE_VALUES, k)\n    return _fill_grid(h, w, palette)\n\n\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/6e453dd6.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide black shapes rightward to a grey separator, then shoot red rays from enclosed holes.\n\n    Input structure:\n    - A vertical grey (5) separator column divides the grid into left and right halves.\n    - Black shapes sit on the left side against a background color (bg).\n\n    Rule:\n    - Translate each black connected component rightward until its right edge is flush with the separator.\n    - After sliding, find enclosed bg regions (holes) within the black shapes that touch the column just left of the separator.\n    - For each row spanned by such a hole, emit a red ray across the entire right half of the grid.\n\n    Key insight: Only holes adjacent to the separator trigger rays — the sliding creates enclosures that act as \"nozzles\" projecting rightward.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    sep_color = 5\n    black = 0\n    red = 2\n\n    sep = _find_separator_col(g, sep_color=sep_color)\n    bg = _background_color(g, sep_col=sep, sep_color=sep_color)\n\n    out = g.copy()\n\n    # Step 1: move black components on the left so that their right edge touches the separator.\n    left = out[:, :sep].copy()\n    left_mask = left == black\n    comps = _components4(left_mask)\n\n    # Clear old black pixels (leave other colors intact).\n    left[left == black] = bg\n\n    target_right = sep - 1  # last column in left side, adjacent to separator\n    for comp in comps:\n        max_c = max(c for _, c in comp)\n        delta = target_right - max_c\n        assert delta >= 0, \"left-side components must stay left of the separator\"\n        for r, c in comp:\n            nc = c + delta\n            assert 0 <= nc < sep, f\"shifted pixel {(r, c)} left the pane\"\n            left[r, nc] = black\n\n    out[:, :sep] = left\n\n    # Step 2: find enclosed background regions (holes) on the left.\n    # A hole is a bg component not touching the left subgrid boundary.\n    holes = []\n    for pts in _components4(left == bg):\n        if any(r == 0 or r == h - 1 or c == 0 or c == sep - 1 for r, c in pts):\n            continue\n        holes.append(pts)\n\n    # Step 3: if a hole touches column sep-2 (one cell left of the black border that touches separator),\n    # emit a red ray on the right side for each row containing hole pixels.\n    trigger_col = sep - 2\n    trigger_rows = []\n    for pts in holes:\n        if not any(c == trigger_col for _, c in pts):\n            continue\n        trigger_rows.extend(sorted(set(r for r, _ in pts)))\n    assert len(trigger_rows) == len(set(trigger_rows)), f\"trigger rows must be unique, got {trigger_rows}\"\n    for r in trigger_rows:\n        assert np.all(out[r, sep + 1 :] == bg), f\"right half of row {r} must be background before ray emission\"\n        out[r, sep + 1 :] = red\n\n    return out\n\n# --------------- generator (att4) ---------------\n\n# ── Colors ──\nBG = 6       # magenta background\nBLACK = 0    # sprite color\nRED = 2      # ray color\nSEP_COLOR = 5  # grey separator\n\n# ── Grid dimensions ──\nH_MIN, H_MAX = 16, 25\nW_MIN, W_MAX = 10, 16\nSEP_MIN, SEP_MAX = 5, 11       # separator column range\nRIGHT_W_MIN, RIGHT_W_MAX = 2, 4  # right-side width range\n\n# ── Sprite constraints ──\nN_SPRITES_MIN, N_SPRITES_MAX = 2, 5\nSPRITE_H_MAX = 8               # max sprite bbox height\nSPRITE_W_MAX = 6               # max sprite bbox width\nMIN_BAND_GAP = 1               # min bg rows between sprite bands\n\n# ── Probabilities ──\nSPLIT_PROB = 0.4                # emitter: probability of split (mini+main) layout\nEXTRA_EMITTERS_PROB = 0.25      # chance to add more emitters beyond the minimum\nFLUSH_PROB = 0.35               # chance one input sprite stays flush with separator\n\n# ── Retry budget ──\nMAX_RETRIES = 300\n\n\ndef _scatter(total, slots):\n    \"\"\"Distribute *total* units randomly into *slots* bins.\"\"\"\n    vals = [0] * slots\n    for _ in range(total):\n        vals[random.randrange(slots)] += 1\n    return vals\n\n\ndef _min_emitters_for(n):\n    \"\"\"Minimum emitter count to satisfy >=60% emitter fraction for *n* sprites.\"\"\"\n    return (3 * n + 4) // 5\n\n\ndef _min_rows_needed(n_emitters, n_total):\n    \"\"\"Minimum grid rows to fit *n_total* sprites with *n_emitters* emitters.\"\"\"\n    return n_emitters * 3 + (n_total - n_emitters) * 2 + (n_total - 1) + 2\n\n\ndef _sprite_bands(h, is_emitter):\n    \"\"\"Partition grid rows into disjoint vertical bands for each sprite.\n\n    Returns list of (row_start, height) or None if they don't fit.\n    \"\"\"\n    n = len(is_emitter)\n    min_heights = [3 if e else 2 for e in is_emitter]\n    base_gaps = [MIN_BAND_GAP] * (n + 1)\n    height_cap = h - sum(base_gaps)\n    if sum(min_heights) > height_cap:\n        return None\n\n    heights = min_heights[:]\n    extra_cap = sum(SPRITE_H_MAX - x for x in heights)\n    extra = random.randint(0, min(extra_cap, height_cap - sum(heights)))\n    for _ in range(extra):\n        choices = [i for i, x in enumerate(heights) if x < SPRITE_H_MAX]\n        i = random.choice(choices)\n        heights[i] += 1\n\n    gaps = [a + b for a, b in zip(base_gaps, _scatter(h - sum(heights) - sum(base_gaps), n + 1))]\n    bands = []\n    r = gaps[0]\n    for i, sh in enumerate(heights):\n        bands.append((r, sh))\n        r += sh + gaps[i + 1]\n    return bands\n\n\ndef _emitter_patch(sh, max_sw):\n    \"\"\"Build an emitter sprite patch: a closed shell with an interior hole at the right edge.\"\"\"\n    hole_w = random.choice([1, 2]) if max_sw >= 4 else 1\n    sw = random.randint(hole_w + 2, max_sw)\n    patch = np.full((sh, sw), BG, dtype=int)\n\n    right_wall = sw - 1\n    left_wall = sw - hole_w - 2\n\n    # Optionally split into a narrower mini section + main section,\n    # creating a non-triggering hole in the mini part.\n    right_shift = random.randint(1, max(1, sw - 3))\n    mini_w = sw - right_shift\n    can_split = sh >= 5 and mini_w >= 3 and right_shift >= 1\n    if can_split and random.random() < SPLIT_PROB:\n        _build_split_emitter(patch, sh, sw, left_wall, right_wall, mini_w)\n    else:\n        patch[0, :] = BLACK\n        patch[-1, :] = BLACK\n        patch[1:-1, left_wall] = BLACK\n        patch[1:-1, right_wall] = BLACK\n    return patch\n\n\ndef _build_split_emitter(patch, sh, sw, left_wall, right_wall, mini_w):\n    \"\"\"Fill *patch* in-place with a split emitter (mini section + main section).\"\"\"\n    place_top = random.random() < 0.5\n    mini_h = random.randint(3, min(4, sh - 2))\n    main_h = sh - mini_h + 1  # +1 for shared connection row\n    if place_top:\n        # Top = mini (narrower), bottom = main (full width)\n        patch[0, :mini_w] = BLACK\n        for r in range(mini_h):\n            patch[r, 0] = BLACK\n            patch[r, mini_w - 1] = BLACK\n        patch[mini_h - 1, :] = BLACK  # connection row\n        patch[-1, :] = BLACK\n        for r in range(mini_h, sh):\n            patch[r, left_wall] = BLACK\n            patch[r, right_wall] = BLACK\n    else:\n        # Top = main (full width), bottom = mini (narrower)\n        patch[0, :] = BLACK\n        for r in range(main_h - 1):\n            patch[r, left_wall] = BLACK\n            patch[r, right_wall] = BLACK\n        patch[main_h - 1, :] = BLACK  # connection row\n        patch[-1, :mini_w] = BLACK\n        for r in range(main_h, sh):\n            patch[r, 0] = BLACK\n            patch[r, mini_w - 1] = BLACK\n\n\ndef _distractor_patch(sh, max_sw):\n    \"\"\"Build a non-emitter distractor sprite (C-shape, L-shape, or solid block).\"\"\"\n    choices = [\"l_shape\"]\n    if sh >= 3 and max_sw >= 3:\n        choices.extend([\"c_left\", \"c_right\"])\n    if sh <= 3:\n        choices.append(\"solid\")\n    kind = random.choice(choices)\n\n    if kind == \"solid\":\n        sw = random.randint(2, min(3, max_sw))\n        return np.full((sh, sw), BLACK, dtype=int)\n\n    min_sw = 3 if kind.startswith(\"c_\") or sh == 2 else 2\n    sw = random.randint(min_sw, max_sw)\n    patch = np.full((sh, sw), BG, dtype=int)\n    if kind == \"c_left\":\n        patch[0, :] = BLACK\n        patch[-1, :] = BLACK\n        patch[:, -1] = BLACK\n    elif kind == \"c_right\":\n        patch[0, :] = BLACK\n        patch[-1, :] = BLACK\n        patch[:, 0] = BLACK\n    else:\n        patch[:, -1] = BLACK\n        if random.random() < 0.5:\n            patch[0, :] = BLACK\n        else:\n            patch[-1, :] = BLACK\n    return patch\n\n\ndef _choose_grid_dims():\n    \"\"\"Pick grid height, width, and separator column satisfying all constraints.\"\"\"\n    h = random.randint(H_MIN, H_MAX)\n    right_w = random.randint(RIGHT_W_MIN, RIGHT_W_MAX)\n    valid_seps = [s for s in range(SEP_MIN, SEP_MAX + 1) if W_MIN <= s + 1 + right_w <= W_MAX]\n    sep = random.choice(valid_seps)\n    w = sep + 1 + right_w\n    return h, w, sep\n\n\ndef _choose_emitter_flags(h):\n    \"\"\"Decide sprite count and which sprites are emitters. Returns flags list or None.\"\"\"\n    valid_counts = [n for n in range(N_SPRITES_MIN, N_SPRITES_MAX + 1)\n                    if _min_rows_needed(_min_emitters_for(n), n) <= h]\n    n = random.choice(valid_counts)\n\n    min_em = _min_emitters_for(n)\n    max_em = min_em\n    for k in range(min_em + 1, n + 1):\n        if _min_rows_needed(k, n) <= h:\n            max_em = k\n    if max_em > min_em and random.random() < EXTRA_EMITTERS_PROB:\n        n_emitters = random.randint(min_em + 1, max_em)\n    else:\n        n_emitters = min_em\n\n    flags = [True] * n_emitters + [False] * (n - n_emitters)\n    random.shuffle(flags)\n    return flags\n\n\ndef _render_output(h, w, sep, bands, flags):\n    \"\"\"Stamp sprites flush against the separator and paint red rays for emitters.\n\n    Returns (output_grid, sprite_list) where sprite_list is [(patch, r0, c0), ...].\n    \"\"\"\n    out = np.full((h, w), BG, dtype=int)\n    out[:, sep] = SEP_COLOR\n\n    sprites = []\n    max_sw = min(SPRITE_W_MAX, sep - 1)\n    for (r0, sh), is_emitter in zip(bands, flags):\n        patch = _emitter_patch(sh, max_sw) if is_emitter else _distractor_patch(sh, max_sw)\n        sw = patch.shape[1]\n        c0 = sep - sw\n        paste(out, patch, r0, c0, transparent=BG)\n        if is_emitter:\n            for lr in range(sh):\n                if patch[lr, -1] == BLACK and patch[lr, -2] == BG:\n                    out[r0 + lr, sep + 1:] = RED\n        sprites.append((patch, r0, c0))\n    return out, sprites\n\n\ndef _unslide_sprites(h, w, sep, sprites):\n    \"\"\"Shift each sprite leftward by a random amount to produce the input grid.\n\n    Returns the input grid or None if any sprite can't be shifted.\n    \"\"\"\n    n = len(sprites)\n    inp = np.full((h, w), BG, dtype=int)\n    inp[:, sep] = SEP_COLOR\n\n    flush_i = random.randrange(n) if random.random() < FLUSH_PROB else -1\n    for i, (patch, r0, c0) in enumerate(sprites):\n        if c0 < 1:\n            return None\n        delta = 0 if i == flush_i else random.randint(1, c0)\n        paste(inp, patch, r0, c0 - delta, transparent=BG)\n    return inp\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single generation attempt: build output, derive input, verify with oracle.\"\"\"\n    h, w, sep = _choose_grid_dims()\n    flags = _choose_emitter_flags(h)\n    bands = _sprite_bands(h, flags)\n    if bands is None:\n        return None\n\n    out, sprites = _render_output(h, w, sep, bands, flags)\n    inp = _unslide_sprites(h, w, sep, sprites)\n    if inp is None:\n        return None\n\n    try:\n        if not np.array_equal(main(inp), out):\n            return None\n    except Exception:\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 6e453dd6 input\")\n\n","exit_code":0,"status":"completed"}}
