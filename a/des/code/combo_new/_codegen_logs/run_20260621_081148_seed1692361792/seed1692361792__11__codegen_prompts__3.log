{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\npaths = [\n    '/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py',\n    '/home/lixinyu/snap/new/ARC_code/train/bd283c4a.py',\n    '/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py',\n    '/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n    '/home/lixinyu/snap/new/ARC_code/train/e3fe1151.py',\n    '/home/lixinyu/snap/new/ARC_code/eval/89565ca0.py',\n    '/home/lixinyu/snap/new/ARC_code/train/34cfa167.py',\n    '/home/lixinyu/snap/new/ARC_code/train/2601afb7.py',\n]\nfor p in paths:\n    text = Path(p).read_text()\n    print(f'===== {p}')\n    for name in ('def main', 'def generate_input'):\n        idx = text.find(name)\n        if idx == -1:\n            continue\n        end = text.find('\\\\ndef ', idx + 1)\n        if end == -1:\n            end = len(text)\n        print(text[idx:end].rstrip())\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\npaths = [\n    '/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py',\n    '/home/lixinyu/snap/new/ARC_code/train/bd283c4a.py',\n    '/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py',\n    '/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n    '/home/lixinyu/snap/new/ARC_code/train/e3fe1151.py',\n    '/home/lixinyu/snap/new/ARC_code/eval/89565ca0.py',\n    '/home/lixinyu/snap/new/ARC_code/train/34cfa167.py',\n    '/home/lixinyu/snap/new/ARC_code/train/2601afb7.py',\n]\nfor p in paths:\n    text = Path(p).read_text()\n    print(f'===== {p}')\n    for name in ('def main', 'def generate_input'):\n        idx = text.find(name)\n        if idx == -1:\n            continue\n        end = text.find('\\\\ndef ', idx + 1)\n        if end == -1:\n            end = len(text)\n        print(text[idx:end].rstrip())\n        print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exhausted attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/bd283c4a.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Pack all pixels into color-frequency runs along bottom-up columns.\n\n    Input structure\n    The input is a rectangular grid whose colors are all foreground material;\n    only the number of pixels of each color matters. In the observed task\n    instances, every present color has a distinct pixel count.\n\n    Rule\n    Count the pixels of each color and order the colors from most frequent to\n    least frequent. Rewrite a same-size grid by placing each color's full count\n    as one contiguous run while scanning columns from left to right and, within\n    each column, from bottom to top.\n\n    Key insight\n    The output preserves the multiset of colors but discards all original\n    positions, turning the grid into a frequency-sorted column packing.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    counts = Counter(map(int, g.ravel()))\n    assert len(set(counts.values())) == len(counts), \"color counts must have a unique rank\"\n\n    colors = sorted(counts, key=lambda color: -counts[color])\n    out = np.empty_like(g)\n    height, width = g.shape\n\n    scan = ((r, c) for c in range(width) for r in range(height - 1, -1, -1))\n    for color in colors:\n        for _ in range(counts[color]):\n            r, c = next(scan)\n            out[r, c] = color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGRID_SHAPE = (10, 10)\nGRID_AREA = GRID_SHAPE[0] * GRID_SHAPE[1]\n\n# Palette: four distinct foreground colors, no background.\nCOLOR_POOL = np.arange(1, 10)\nN_COLORS = 4\n\n# Counts: largest, second, third are sampled; smallest is residual.\nCOUNT_RANGES = ((40, 55), (25, 35), (10, 20))\nRESIDUAL_COUNT_RANGE = (2, 10)\nCOUNT_SAMPLE_RETRIES = 100\nGENERATION_RETRIES = 300\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            try:\n                out = main(result)\n            except Exception:\n                continue\n            if out is not None:\n                return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, table, frame, and slot dimensions.\nCANVAS_MIN, CANVAS_MAX = 13, 19\nTABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\nROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\nAXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n\n# Object and palette sampling limits.\nN_COLORS, MAX_OBJECT_COLORS = 10, 6\nMAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\nOBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n\n# Rejection sampling cap.\nGEN_RETRY_LIMIT = 300\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid ac6f9922 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the one blank in each corner region so all four regions have the same color multiset.\n\n    Input structure:\n    - The dominant background color forms one solid separator row and one solid\n      separator column.\n    - The separator cross splits the grid into four equal rectangular corner regions.\n    - Each corner region contains exactly one background-colored blank pixel.\n\n    Rule:\n    - Count the non-background colors in each corner region.\n    - The completed region multiset is defined by the maximum observed count of\n      each color across the four regions.\n    - Replace each region's blank pixel with the single color needed to match that\n      completed multiset.\n\n    Key insight:\n    - The separator color inside a corner region is a missing value marker; comparing\n      the four regions reveals the shared multiset without using numeric color order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    color_counts = Counter(map(int, g.reshape(-1)))\n    assert all(\n        color == bg or count < color_counts[bg] for color, count in color_counts.items()\n    ), \"background color must be uniquely dominant\"\n\n    cross_row, cross_col = _solid_separator_cross(g, bg)\n    regions = _quadrants(cross_row, cross_col, height, width)\n    region_shape = g[regions[0]].shape\n    region_area = int(np.prod(region_shape))\n\n    counts_by_region: list[Counter[int]] = []\n    blank_positions: list[tuple[int, int]] = []\n    for row_slice, col_slice in regions:\n        region = g[row_slice, col_slice]\n        assert region.shape == region_shape, \"all corner regions must have the same shape\"\n        blanks = np.argwhere(region == bg)\n        assert len(blanks) == 1, \"each corner region must have exactly one blank\"\n\n        counts_by_region.append(Counter(map(int, region[region != bg].reshape(-1))))\n        local_r, local_c = map(int, blanks[0])\n        blank_positions.append((row_slice.start + local_r, col_slice.start + local_c))\n\n    target_counts: Counter[int] = Counter()\n    for counts in counts_by_region:\n        for color, count in counts.items():\n            target_counts[color] = max(target_counts[color], count)\n    assert sum(target_counts.values()) == region_area, \"completed region multiset must be unique\"\n\n    out = g.copy()\n    for counts, (row, col) in zip(counts_by_region, blank_positions):\n        missing = target_counts - counts\n        assert len(missing) == 1, \"each blank must have exactly one matching fill color\"\n        fill_color, fill_count = next(iter(missing.items()))\n        assert fill_count == 1, \"each corner region must need one pixel of the fill color\"\n        out[row, col] = fill_color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n# Canvas/palette bounds.\nGRID_HALF_MIN = 2\nGRID_HALF_MAX = 6\nCOLOR_COUNT = 10\nMIN_TARGET_COLORS = 3\nMAX_NON_BG_COLORS = COLOR_COUNT - 1\n# Layout probabilities and constraints.\nPREFERRED_GRID_HALF = (2, 2)\nPREFERRED_GRID_PROB = 0.65\nQUADRANT_COUNT = 4\nSEPARATOR_WIDTH = 1\nBG_DOMINANCE_MARGIN = 1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid e3fe1151 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n\n    Input structure:\n    - Black background with several axis-aligned colored line drawings.\n    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n\n    Rule:\n    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n    - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n    - The color with no enclosed region is the noise/pad color.\n    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n\n    Key insight:\n    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg == 0\n\n    counts: list[tuple[int, int, np.ndarray]] = []\n    for color in colors_present(g, exclude={bg}):\n        rooms = _room_count_for_color(g, int(color))\n        walls = _walls_for_color(g, int(color))\n        counts.append((int(color), int(rooms), walls))\n\n    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n    assert drawings\n    assert len(pad_colors) == 1\n\n    pad = int(pad_colors[0])\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n        group = [item for item in drawings if item[1] == rooms]\n        ordered.extend(_cover_order(g, group))\n\n    width = max(rooms for _color, rooms, _walls in ordered)\n\n    out = np.full((len(ordered), width), pad, dtype=int)\n    for r, (color, rooms, _walls) in enumerate(ordered):\n        out[r, :rooms] = int(color)\n    return out\n\n# --------------- generator (claude-opus-4-6) ---------------\n\n# ---- CFG: Tunable generation parameters ----\n_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n    5: (25, 30, 25, 30, 16, 18),\n    4: (22, 30, 22, 30, 18, 22),\n    3: (20, 30, 20, 30, 22, 25),\n}\n_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n_OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n_GEN_RETRIES = 300                   # outer retry limit\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {_GEN_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/34cfa167.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.\n\n    Input structure:\n    - The background is the dominant color.\n    - Two same-color solid rectangular anchors of the same size sit on opposite\n      diagonal corners, with the first anchor above-left of the second.\n    - The upper-left anchor has two one-cell-thick vertical control bars to its\n      right and two one-cell-thick horizontal control bars below it.\n\n    Rule:\n    - Copy the anchor rectangle into the two missing corners of the implied\n      larger rectangle.\n    - Repeat the right-side control bars horizontally between the left and right\n      anchors, using their spacing as the period, and draw the outer top and\n      bottom borders in the first right-control color.\n    - Repeat the below-side control bars vertically between the top and bottom\n      anchors, using the same period, and draw the outer left and right borders\n      in the first below-control color.\n\n    Key insight: The small control bars are the first two ticks of two periodic\n    frame patterns; the diagonal anchor supplies the opposite corner and the\n    missing two anchor copies.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    source, dest, right_controls, below_controls = _find_structure(g, bg)\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    dr0, dc0, dr1, dc1 = dest[\"bbox\"]\n    anchor_color = int(source[\"color\"])\n    assert int(dest[\"color\"]) == anchor_color, \"anchor colors must match\"\n    assert bbox_h(source[\"bbox\"]) == bbox_h(dest[\"bbox\"]), \"anchor heights must match\"\n    assert bbox_w(source[\"bbox\"]) == bbox_w(dest[\"bbox\"]), \"anchor widths must match\"\n    assert sr0 > 0 and sc0 > 0, \"upper-left anchor must have space for outer frame\"\n    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \"lower-right anchor must have space for outer frame\"\n\n    right_offsets = [int(comp[\"bbox\"][1] - sc1) for comp in right_controls]\n    below_offsets = [int(comp[\"bbox\"][0] - sr1) for comp in below_controls]\n    assert right_offsets == below_offsets and right_offsets[0] == 1, \"control offsets must match from the anchor edge\"\n    step = int(right_offsets[1] - right_offsets[0])\n    assert step > 0, \"control bars must be separated\"\n    period = 2 * step\n    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, \"right frame must close next to the destination anchor\"\n    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, \"below frame must close next to the destination anchor\"\n\n    right_colors = [int(comp[\"color\"]) for comp in right_controls]\n    below_colors = [int(comp[\"color\"]) for comp in below_controls]\n    out = g.copy()\n\n    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)\n    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)\n\n    first_c = int(sc1 + right_offsets[0])\n    last_c = int(dc0 - 1)\n    for c in range(first_c, last_c + 1):\n        offset = int(c - sc1)\n        if (offset - right_offsets[0]) % period == 0:\n            color = right_colors[0]\n        elif (offset - right_offsets[1]) % period == 0:\n            color = right_colors[1]\n        else:\n            continue\n        _paint_rect(out, bg, sr0, c, sr1, c, color)\n        _paint_rect(out, bg, dr0, c, dr1, c, color)\n\n    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])\n    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])\n\n    first_r = int(sr1 + below_offsets[0])\n    last_r = int(dr0 - 1)\n    left_c = int(sc0 - 1)\n    right_c = int(dc1 + 1)\n    for r in range(first_r, last_r + 1):\n        _paint(out, bg, r, left_c, below_colors[0])\n        _paint(out, bg, r, right_c, below_colors[0])\n\n        offset = int(r - sr1)\n        if (offset - below_offsets[0]) % period == 0:\n            _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])\n            _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])\n        elif (offset - below_offsets[1]) % period == 0:\n            _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])\n            _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color sampling.\nCOLOR_COUNT, NON_BG_COLOR_COUNT = 10, 4\n\n# Anchor/repetition geometry.\nANCHOR_SIZE_RANGE = (1, 5)\nREPEAT_COUNT_RANGE = (2, 5)\nCONTROL_OFFSETS = (1, 3)\nFRAME_PERIOD, DEST_ANCHOR_GAP, STRUCTURE_FIXED_PAD = 4, 2, 3\n\n# Canvas/margins.\nCANVAS_MIN_SIZE, CANVAS_MAX_SIZE = 16, 30\nMARGIN_CHOICES = range(4)\nMIN_TOTAL_MARGIN, SOURCE_OUTER_MARGIN = 1, 1\n\n# Retry.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/2601afb7.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate each vertical bar's color one slot right and its height one slot left.\n\n    Input structure\n    - A dominant background surrounds several monochrome one-cell-wide vertical bars.\n    - Every bar is bottom-aligned and occupies a distinct column.\n    - The ordered bar slots are read from left to right.\n\n    Rule\n    - Keep the grid shape and the bar columns unchanged.\n    - At slot i, use the color from the previous slot cyclically.\n    - At slot i, use the height from the next slot cyclically.\n\n    Key insight\n    - Color and height are independent cyclic attributes of the ordered bar slots:\n      colors rotate right while heights rotate left.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height = g.shape[0]\n    bg = get_bg(g)\n    bars = _extract_bars(g, bg)\n\n    out = np.full_like(g, bg)\n    count = len(bars)\n    for i, bar in enumerate(bars):\n        color = bars[(i - 1) % count][\"color\"]\n        bar_height = bars[(i + 1) % count][\"height\"]\n        assert 1 <= bar_height <= height\n        out[height - bar_height : height, bar[\"col\"]] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n_RNG = np.random.default_rng()\n\n# Canvas/bar bounds.\nBAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE = 3, 6\nBACKGROUND_COLOR, MIN_BAR_HEIGHT = 7, 1\nBAR_COL_OFFSET, BAR_COL_STRIDE = 1, 2\n# Color and transform sampling.\nCOLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nOUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n","exit_code":0,"status":"completed"}}
