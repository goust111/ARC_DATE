 if d \"'!= (-ddir[0], -ddir[1]) and d != ddir]\n        rng.shuffle(alt_dirs)\n        for edir in alt_dirs[:1]:\n            if rng.random()<0.5:\n                q=step(endpoint_d,edir)\n                if inside(q,h,w):\n                    diag.append(q)\n        if len(set(orth)) != len(orth) or len(set(diag)) != len(diag):\n            continue\n        if set(orth) & set(diag):\n            continue\n        bad=False\n        for a in orth:\n            for b in diag:\n                if cheb(a,b) <= 1:\n                    bad=True\n                    break\n            if bad:\n                break\n        if bad:\n            continue\n        blacks={seed,*orth,*diag}\n        if any(not inside(p,h,w) for p in blacks):\n            continue\n        return h,w,seed,orth,diag\n    return None\n\nrng=random.Random(0)\nfor i in range(20):\n    rec=make_patch(rng)\n    print('\"'ok', bool(rec), rec[:3] if rec else None)\n    if not rec: break\n    h,w,seed,orth,diag=rec\n    g=[['#']*w for _ in range(h)]\n    for r in range(1,h-1):\n        for c in range(1,w-1):\n            g[r][c]='.'\n    # rest as wall later but visualize black as space? use X maybe\n    for r in range(1,h-1):\n        for c in range(1,w-1):\n            g[r][c]='#'\n    for r,c in orth: g[r][c]='o'\n    for r,c in diag: g[r][c]='d'\n    r,c=seed; g[r][c]='S'\n    print('\\\\n'.join(''.join(row) for row in g))\n    print()\nPY\"","aggregated_output":"ok True (7, 10, (3, 3))\n##########\n#####d####\n#o##d#d###\n#ooS######\n##########\n##########\n##########\n\nok True (7, 7, (3, 3))\n#######\n#######\n#######\n#ooS###\n####d##\n#####d#\n#######\n\nok True (8, 8, (4, 4))\n########\n########\n########\n######o#\n####Soo#\n###d####\n##d#####\n########\n\nok True (10, 7, (4, 3))\n#######\n#######\n#d#####\n##d####\n###S###\n###o###\n###o###\n#######\n#######\n#######\n\nok True (8, 8, (5, 4))\n########\n########\n#d######\n##d#####\n###d####\n####Soo#\n######o#\n########\n\nok True (9, 8