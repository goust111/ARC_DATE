{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '9,340p' /home/lixinyu/snap/new/ARC_code/train/b71a7747.py\nsed -n '83,540p' /home/lixinyu/snap/new/ARC_code/train/c6141b15.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Extract the hidden two-color image by compacting the rows and columns of its complete mask.\n\n    Input structure\n    The grid contains one pair of colors whose pixels occupy every cell in the\n    cross product of their active rows and active columns; all other colors form\n    the surrounding filler or separators.\n    Rule\n    Find that unique color pair, keep exactly the rows and columns touched by\n    the pair, and return the induced subgrid.\n    Key insight\n    The target image is not chosen by color id; it is the only two-color mask\n    whose occupied pixels form a full rectangular row/column product after\n    deleting unused rows and columns.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    candidates = []\n    for pair in itertools.combinations(colors_present(g), 2):\n        mask = np.isin(g, pair)\n        rows = mask.any(axis=1)\n        cols = mask.any(axis=0)\n        rh = int(rows.sum())\n        cw = int(cols.sum())\n        if 0 < rh < h and 0 < cw < w and int(mask.sum()) == rh * cw:\n            out = g[np.ix_(rows, cols)]\n            if set(map(int, out.ravel())) == set(pair):\n                candidates.append(out)\n\n    assert len(candidates) == 1\n    return candidates[0].copy()\n\n# --------------- generator (att2) ---------------\n# Canvas and block layout bounds.\nN_BLOCK_OPTIONS = (3, 4)\nBLOCK_SIZE_RANGE = range(3, 6)\nSEPARATOR_WIDTH_RANGE = range(1, 4)\nPADDING_MIN = 2\nPADDING_MAX_EXCLUSIVE = 6\nINPUT_SIDE_MIN = 19\nINPUT_SIDE_MAX = 28\n\n# Hidden foreground shape density and pattern mix.\nFG_DENSITY_MIN = 0.14\nFG_DENSITY_MAX = 0.22\nRECT_LOOP_PROB = 0.25\nBRANCH_TRANSPOSE_PROB = 0.5\nMIN_BRANCH_ROW_GAP = 1\n\n# Color and retry settings.\nCOLOR_COUNT_OPTIONS = (4, 5)\nCOLOR_POOL = range(10)\nGENERATION_RETRIES = 300\n\nLAYOUT_CHOICES = [\n    (n_blocks, block_size, sep, pad0, pad1, side)\n    for n_blocks in N_BLOCK_OPTIONS\n    for block_size in BLOCK_SIZE_RANGE\n    for sep in SEPARATOR_WIDTH_RANGE\n    for pad0 in range(max(PADDING_MIN, sep), PADDING_MAX_EXCLUSIVE)\n    for pad1 in range(max(PADDING_MIN, sep), PADDING_MAX_EXCLUSIVE)\n    for side in [n_blocks * block_size + (n_blocks - 1) * sep + pad0 + pad1]\n    if INPUT_SIDE_MIN <= side <= INPUT_SIDE_MAX\n]\n\ndef _gen_density_bounds(size):\n    return int(np.ceil(FG_DENSITY_MIN * size * size)), int(np.floor(FG_DENSITY_MAX * size * size))\n\n\ndef _gen_between(a, b):\n    lo, hi = sorted((a, b))\n    return range(lo, hi + 1)\n\n\ndef _gen_rect_loop_mask(size, block_size):\n    lo, hi = _gen_density_bounds(size)\n    choices = []\n    for r0 in range(block_size):\n        for r1 in range(size - block_size, size):\n            for c0 in range(block_size):\n                for c1 in range(size - block_size, size):\n                    if r1 <= r0 or c1 <= c0:\n                        continue\n                    count = 2 * ((r1 - r0 + 1) + (c1 - c0 + 1)) - 4\n                    if lo <= count <= hi:\n                        choices.append((r0, r1, c0, c1))\n    if not choices:\n        return None\n\n    r0, r1, c0, c1 = random.choice(choices)\n    mask = np.zeros((size, size), dtype=bool)\n    mask[r0, c0 : c1 + 1] = True\n    mask[r1, c0 : c1 + 1] = True\n    mask[r0 : r1 + 1, c0] = True\n    mask[r0 : r1 + 1, c1] = True\n    return mask\n\n\ndef _gen_spaced_branch_rows(r0, r1, main_r):\n    rows = [r for r in range(r0, r1 + 1) if abs(r - main_r) > MIN_BRANCH_ROW_GAP]\n    random.shuffle(rows)\n    picked = []\n    for r in rows:\n        if all(abs(r - old) > MIN_BRANCH_ROW_GAP for old in picked):\n            picked.append(r)\n    return picked\n\n\ndef _gen_branch_mask(size, block_size):\n    left = random.randrange(block_size)\n    right = random.randrange(size - block_size, size)\n    r0 = random.randrange(block_size)\n    r1 = random.randrange(size - block_size, size)\n    trunk_c = random.randrange(left, right + 1)\n    main_r = random.randrange(r0, r1 + 1)\n\n    base = (r1 - r0 + 1) + (right - left)\n    density_min, max_count = _gen_density_bounds(size)\n    min_count = max(density_min, base)\n\n    picked = _gen_spaced_branch_rows(r0, r1, main_r)\n    caps = [max(trunk_c, size - 1 - trunk_c) for _ in picked]\n    capacity = base + sum(caps)\n    if min_count > min(max_count, capacity):\n        return None\n    target = random.randint(min_count, min(max_count, capacity))\n\n    mask = np.zeros((size, size), dtype=bool)\n    mask[r0 : r1 + 1, trunk_c] = True\n    mask[main_r, left : right + 1] = True\n\n    remaining = target - base\n    for i, (r, cap) in enumerate(zip(picked, caps)):\n        if remaining <= 0:\n            break\n        future = sum(caps[i + 1 :])\n        lo = max(0, remaining - future)\n        hi = min(cap, remaining)\n        take = random.randint(lo, hi)\n        if take == 0:\n            continue\n        dirs = []\n        if trunk_c >= take:\n            dirs.append(-1)\n        if size - 1 - trunk_c >= take:\n            dirs.append(1)\n        step = random.choice(dirs)\n        end = trunk_c + step * take\n        mask[r, _gen_between(trunk_c, end)] = True\n        remaining -= take\n\n    if remaining != 0:\n        return None\n    if random.random() < BRANCH_TRANSPOSE_PROB:\n        mask = mask.T\n    return mask\n\n\ndef _gen_output(size, block_size, bg, fg):\n    mask = None\n    if random.random() < RECT_LOOP_PROB:\n        mask = _gen_rect_loop_mask(size, block_size)\n    if mask is None:\n        mask = _gen_branch_mask(size, block_size)\n    if mask is None:\n        return None\n\n    out = np.full((size, size), bg, dtype=int)\n    out[mask] = fg\n    return out\n\n\ndef _gen_internal_separator_mask(active_rows, active_cols):\n    filler = ~(active_rows[:, None] & active_cols[None, :])\n    row_ids = np.flatnonzero(active_rows)\n    col_ids = np.flatnonzero(active_cols)\n    internal_rows = (~active_rows).copy()\n    internal_cols = (~active_cols).copy()\n    internal_rows[: row_ids[0]] = False\n    internal_rows[row_ids[-1] + 1 :] = False\n    internal_cols[: col_ids[0]] = False\n    internal_cols[col_ids[-1] + 1 :] = False\n\n    gridline = (internal_rows[:, None] | internal_cols[None, :]) & filler\n    return filler, gridline\n\n\ndef _gen_fill_filler(inp, active_rows, active_cols, filler_colors):\n    filler, gridline = _gen_internal_separator_mask(active_rows, active_cols)\n    inp[filler] = filler_colors[0]\n    inp[gridline] = filler_colors[1]\n\n    for color in filler_colors[2:]:\n        for r in range(inp.shape[0]):\n            cols = np.flatnonzero(filler[r])\n            inp[r, random.choice(cols)] = color\n        for c in range(inp.shape[1]):\n            rows = np.flatnonzero(filler[:, c])\n            inp[random.choice(rows), c] = color\n\n\ndef _gen_active_indexes(n_blocks, block_size, sep, pad0, side):\n    active = np.zeros(side, dtype=bool)\n    indexes = []\n    for i in range(n_blocks):\n        start = pad0 + i * (block_size + sep)\n        indexes.extend(range(start, start + block_size))\n    active[indexes] = True\n    return active, indexes\n\n\ndef _gen_palette():\n    color_count = random.choice(COLOR_COUNT_OPTIONS)\n    colors = random.sample(COLOR_POOL, color_count)\n    return colors[:2], colors[2:]\n\n\ndef _gen_attempt():\n    n_blocks, block_size, sep, pad0, _pad1, side = random.choice(LAYOUT_CHOICES)\n    out_size = n_blocks * block_size\n\n    (bg, fg), filler_colors = _gen_palette()\n\n    out = _gen_output(out_size, block_size, bg, fg)\n    if out is None:\n        return None\n\n    inp = np.empty((side, side), dtype=int)\n    active_rows, row_map = _gen_active_indexes(n_blocks, block_size, sep, pad0, side)\n    active_cols, col_map = _gen_active_indexes(n_blocks, block_size, sep, pad0, side)\n\n    _gen_fill_filler(inp, active_rows, active_cols, filler_colors)\n    inp[np.ix_(row_map, col_map)] = out\n\n    try:\n        solved = main(inp)\n    except AssertionError:\n        return None\n    if np.array_equal(solved, out):\n        return inp\n    return None\n\n\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swap a connector segment with repeated marker sprites by connecting the marker anchors and stamping the sprite at the segment endpoints.\n\n    Input structure\n    The grid has one background color and exactly two foreground colors. One foreground color forms a single straight 8-connected segment. The other foreground color forms two or more identical centered sprites.\n\n    Rule\n    Build a background canvas of the same size. Draw straight connector-color segments between every pair of original sprite anchors. Then stamp the marker sprite, using its centered anchor, onto the two endpoints of the original connector segment.\n\n    Key insight\n    The original segment endpoints are the destinations for the repeated sprite, while the original sprite centers become the vertices of the new connector-color complete graph.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2\n\n    components_by_color = {\n        color: [\n            component[\"coords\"]\n            for component in find_components(g, bg=bg, colors=[color], connectivity=8)\n        ]\n        for color in colors\n    }\n\n    connector_colors = [\n        color\n        for color, components in components_by_color.items()\n        if len(components) == 1 and _segment_endpoints(components[0]) is not None\n    ]\n    sprite_colors = [\n        color\n        for color, components in components_by_color.items()\n        if _are_repeated_centered_sprites(components)\n    ]\n    assert len(connector_colors) == 1\n    assert len(sprite_colors) == 1\n\n    connector_color = connector_colors[0]\n    sprite_color = sprite_colors[0]\n    assert connector_color != sprite_color\n\n    endpoint_pair = _segment_endpoints(components_by_color[connector_color][0])\n    assert endpoint_pair is not None\n\n    sprite_components = components_by_color[sprite_color]\n    anchors: list[Coord] = []\n    for coords in sprite_components:\n        anchor = _center_anchor(coords)\n        assert anchor is not None\n        anchors.append(anchor)\n    assert _non_collinear_three(anchors), \"three repeated sprites must form a non-collinear triangle\"\n\n    reference_anchor = _center_anchor(sprite_components[0])\n    assert reference_anchor is not None\n    sprite_offsets = [\n        (int(r - reference_anchor[0]), int(c - reference_anchor[1]))\n        for r, c in sprite_components[0]\n    ]\n\n    out = np.full_like(g, bg)\n    for a, b in combinations(anchors, 2):\n        assert _straight_line_cells(a, b) is not None\n        draw_line(out, a[0], a[1], end_r=b[0], end_c=b[1], color=connector_color)\n\n    height, width = out.shape\n    for endpoint_r, endpoint_c in endpoint_pair:\n        for dr, dc in sprite_offsets:\n            r = endpoint_r + dr\n            c = endpoint_c + dc\n            assert 0 <= r < height and 0 <= c < width\n            out[r, c] = sprite_color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and colors.\nGRID_SIZE_MIN = 11\nGRID_SIZE_MAX = 16\nBACKGROUND_COLOR = 7\nFOREGROUND_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n\n# Symmetric sprite shape.\nSPRITE_HEIGHT_CHOICES = [1, 3, 3, 5, 5]\nSPRITE_WIDTH_CHOICES = [1, 3, 3, 5]\nSPRITE_DIM_SWAP_PROB = 0.5\nSPRITE_QUADRANT_FILL_PROB = 0.5\nSPRITE_BUILD_RETRIES = 50\n\n# Anchor layout.\nTHREE_SPRITE_PROB = 0.85\nANCHOR_LAYOUT_RETRIES = 100\nANCHOR_DIRECTIONS = ['h', 'v', 'd1', 'd2']\nTWO_ANCHOR_DIST_MIN = 3\nTWO_ANCHOR_DIST_MAX = 8\nTRIANGLE_DELTA_MIN = 3\nTRIANGLE_DELTA_MAX = 7\nTRIANGLE_ROTATIONS = [0, 1, 2, 3]\n\n# Connector segment.\nSEGMENT_RETRIES = 100\nSEGMENT_LENGTH_MIN = 6\nSEGMENT_LENGTH_MAX = 10\n\n# Overall retry budget.\nGENERATE_RETRIES = 300\n\n\ndef _gen2_symmetric_sprite(color):\n    \"\"\"Generate one connected LR+UD symmetric sprite with a filled center.\"\"\"\n    h = random.choice(SPRITE_HEIGHT_CHOICES)\n    w = random.choice(SPRITE_WIDTH_CHOICES)\n    if random.random() < SPRITE_DIM_SWAP_PROB:\n        h, w = w, h\n\n    if h == 1 and w == 1:\n        return np.array([[color]])\n\n    half_h = h // 2 + 1\n    half_w = w // 2 + 1\n    sprite = np.zeros((h, w), dtype=int)\n    cr, cc = h // 2, w // 2\n    sprite[cr, cc] = color\n\n    for r in range(half_h):\n        for c in range(half_w):\n            if random.random() < SPRITE_QUADRANT_FILL_PROB:\n                sprite[r, c] = color\n                sprite[r, w - 1 - c] = color\n                sprite[h - 1 - r, c] = color\n                sprite[h - 1 - r, w - 1 - c] = color\n\n    sprite[cr, cc] = color\n\n    from arc_utils import is_contiguous\n    mask = (sprite != 0)\n    if not mask.any():\n        sprite[cr, cc] = color\n        mask = (sprite != 0)\n    if not is_contiguous(mask, background=0, connectivity=8):\n        return None\n\n    if not np.any(sprite[0, :]) or not np.any(sprite[-1, :]):\n        return None\n    if not np.any(sprite[:, 0]) or not np.any(sprite[:, -1]):\n        return None\n\n    return sprite\n\n\ndef _gen_sprite_offsets(sprite):\n    h, w = sprite.shape\n    cr, cc = h // 2, w // 2\n    offsets = []\n    for r in range(h):\n        for c in range(w):\n            if sprite[r, c] != 0:\n                offsets.append((r - cr, c - cc))\n    return offsets\n\n\ndef _gen_sprite_cells_at(offsets, anchor_r, anchor_c):\n    return {(anchor_r + dr, anchor_c + dc) for dr, dc in offsets}\n\n\ndef _fits_in_grid(offsets, anchor_r, anchor_c, h, w):\n    for dr, dc in offsets:\n        r, c = anchor_r + dr, anchor_c + dc\n        if not (0 <= r < h and 0 <= c < w):\n            return False\n    return True\n\n\ndef _choose_sprite(sprite_color):\n    for _ in range(SPRITE_BUILD_RETRIES):\n        sprite = _gen2_symmetric_sprite(sprite_color)\n        if sprite is not None:\n            return sprite\n    return None\n\n\ndef _step_from_direction(direction, dist):\n    if direction == 'h':\n        return 0, dist\n    if direction == 'v':\n        return dist, 0\n    if direction == 'd1':\n        return dist, dist\n    return dist, -dist\n\n\ndef _sample_two_anchor_layout(size, radius_r, radius_c):\n    direction = random.choice(ANCHOR_DIRECTIONS)\n    a1_r = random.randint(radius_r + 1, size - 1 - radius_r - 1)\n    a1_c = random.randint(radius_c + 1, size - 1 - radius_c - 1)\n    dist = random.randint(TWO_ANCHOR_DIST_MIN, TWO_ANCHOR_DIST_MAX)\n    dr, dc = _step_from_direction(direction, dist)\n    return [(a1_r, a1_c), (a1_r + dr, a1_c + dc)]\n\n\ndef _sample_three_anchor_layout(size, radius_r, radius_c):\n    dx = random.randint(TRIANGLE_DELTA_MIN, TRIANGLE_DELTA_MAX)\n    dy = dx * random.choice([-1, 1])\n    rot = random.choice(TRIANGLE_ROTATIONS)\n    a_r = random.randint(radius_r + 1, size - 1 - radius_r - 1)\n    a_c = random.randint(radius_c + 1, size - 1 - radius_c - 1)\n\n    if rot == 0:\n        return [(a_r, a_c), (a_r, a_c + dx), (a_r + dy, a_c)]\n    if rot == 1:\n        return [(a_r, a_c), (a_r + dx, a_c), (a_r, a_c + dy)]\n    if rot == 2:\n        return [(a_r, a_c), (a_r, a_c - dx), (a_r + dy, a_c)]\n    return [(a_r, a_c), (a_r - dx, a_c), (a_r, a_c + dy)]\n\n\ndef _anchors_are_valid(anchors, offsets, size):\n    if len(set(anchors)) != len(anchors):\n        return False\n    if not _non_collinear_three(anchors):\n        return False\n    if not all(_fits_in_grid(offsets, ar, ac, size, size) for ar, ac in anchors):\n        return False\n    return all(_straight_line_cells(a, b) is not None for a, b in combinations(anchors, 2))\n\n\ndef _choose_anchors(offsets, size, radius_r, radius_c):\n    num_sprites = 3 if random.random() < THREE_SPRITE_PROB else 2\n    for _ in range(ANCHOR_LAYOUT_RETRIES):\n        if num_sprites == 2:\n            anchors = _sample_two_anchor_layout(size, radius_r, radius_c)\n        else:\n            anchors = _sample_three_anchor_layout(size, radius_r, radius_c)\n        if _anchors_are_valid(anchors, offsets, size):\n            return anchors\n    return None\n\n\ndef _line_cells_between_pairs(anchors):\n    cells = set()\n    for a, b in combinations(anchors, 2):\n        cells.update(_straight_line_cells(a, b))\n    return cells\n\n\ndef _sprite_cells_for_anchors(offsets, anchors):\n    cells = set()\n    for ar, ac in anchors:\n        cells.update(_gen_sprite_cells_at(offsets, ar, ac))\n    return cells\n\n\ndef _has_pairwise_sprite_overlap(offsets, anchors):\n    sprite_cells = [_gen_sprite_cells_at(offsets, ar, ac) for ar, ac in anchors]\n    for i in range(len(sprite_cells)):\n        for j in range(i + 1, len(sprite_cells)):\n            if sprite_cells[i] & sprite_cells[j]:\n                return True\n    return False\n\n\ndef _sample_segment(size, radius_r, radius_c):\n    seg_dir = random.choice(ANCHOR_DIRECTIONS)\n    seg_len = random.randint(SEGMENT_LENGTH_MIN, SEGMENT_LENGTH_MAX)\n    e1_r = random.randint(radius_r, size - 1 - radius_r)\n    e1_c = random.randint(radius_c, size - 1 - radius_c)\n    dr, dc = _step_from_direction(seg_dir, seg_len - 1)\n    e2 = (e1_r + dr, e1_c + dc)\n    return (e1_r, e1_c), e2\n\n\ndef _choose_verified_input(size, bg, connector_color, sprite_color, offsets, anchors, radius_r, radius_c):\n    input_sprite_cells = _sprite_cells_for_anchors(offsets, anchors)\n    output_connector_cells = _line_cells_between_pairs(anchors)\n\n    for _ in range(SEGMENT_RETRIES):\n        e1, e2 = _sample_segment(size, radius_r, radius_c)\n        if not _fits_in_grid(offsets, e1[0], e1[1], size, size):\n            continue\n        if not _fits_in_grid(offsets, e2[0], e2[1], size, size):\n            continue\n\n        seg_cells = _straight_line_cells(e1, e2)\n        if seg_cells is None:\n            continue\n        if any(not (0 <= r < size and 0 <= c < size) for r, c in seg_cells):\n            continue\n\n        endpoint_sprite_cells = _sprite_cells_for_anchors(offsets, [e1, e2])\n        if output_connector_cells & endpoint_sprite_cells:\n            continue\n        if input_sprite_cells & seg_cells:\n            continue\n        if _has_pairwise_sprite_overlap(offsets, anchors):\n            continue\n        if _gen_sprite_cells_at(offsets, e1[0], e1[1]) & _gen_sprite_cells_at(offsets, e2[0], e2[1]):\n            continue\n\n        inp = _render_input(size, bg, connector_color, sprite_color, offsets, anchors, seg_cells)\n        try:\n            out = main(inp)\n        except Exception:\n            continue\n\n        expected_out = _render_expected_output(\n            size, bg, connector_color, sprite_color, offsets, [e1, e2], output_connector_cells\n        )\n        if np.array_equal(out, expected_out):\n            return inp\n    return None\n\n\ndef _render_input(size, bg, connector_color, sprite_color, offsets, anchors, seg_cells):\n    grid = np.full((size, size), bg, dtype=int)\n    for ar, ac in anchors:\n        for dr, dc in offsets:\n            grid[ar + dr, ac + dc] = sprite_color\n    for r, c in seg_cells:\n        grid[r, c] = connector_color\n    return grid\n\n\ndef _render_expected_output(size, bg, connector_color, sprite_color, offsets, endpoints, output_connector_cells):\n    grid = np.full((size, size), bg, dtype=int)\n    for r, c in output_connector_cells:\n        grid[r, c] = connector_color\n    for er, ec in endpoints:\n        for dr, dc in offsets:\n            grid[er + dr, ec + dc] = sprite_color\n    return grid\n\n\ndef _gen_attempt():\n    size = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    bg = BACKGROUND_COLOR\n    connector_color, sprite_color = random.sample(FOREGROUND_POOL, 2)\n\n    sprite = _choose_sprite(sprite_color)\n    if sprite is None:\n        return None\n\n    offsets = _gen_sprite_offsets(sprite)\n    radius_r = sprite.shape[0] // 2\n    radius_c = sprite.shape[1] // 2\n\n    anchors = _choose_anchors(offsets, size, radius_r, radius_c)\n    if anchors is None:\n        return None\n\n    return _choose_verified_input(\n        size, bg, connector_color, sprite_color, offsets, anchors, radius_r, radius_c\n    )\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATE_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATE_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
