{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/2b83f449.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom arc_utils import get_bg, label_mask\nimport itertools\nfrom arc_utils import paste\nfrom collections import defaultdict\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Simulate tokens falling through a pipe network after gates rotate open.\n\n    Input structure:\n    - Wall (0), bg (pipe fill), gate (horizontal 1×3 bars), token (small edge pixels).\n\n    Rule:\n    - Rotate each gate into a vertical blocker; gate cells become bg.\n    - Tokens drop downward through bg, choosing the extreme column for their side (left→min, right→max).\n    - Tokens settle at true pipe ends (adjacent to wall/boundary), packing inward.\n\n    Key insight: Tokens select drop columns by entry side and land at wall-bounded endpoints, ignoring blocker-bounded ones.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    colors = set(map(int, g.flatten()))\n\n    # --- infer gate color: any color forming 4-ccs of size 3 with bbox 1x3 (horizontal) ---\n    gate = None\n    for col in sorted(colors):\n        if int(col) == 0:\n            continue\n        lab, n = label_mask(g == int(col), connectivity=4)\n        found = False\n        for k in range(1, int(n) + 1):\n            pts = np.argwhere(lab == int(k))\n            if int(pts.shape[0]) != 3:\n                continue\n            r0, c0 = pts.min(axis=0)\n            r1, c1 = pts.max(axis=0)\n            if int(r1 - r0 + 1) == 1 and int(c1 - c0 + 1) == 3:\n                found = True\n                break\n        if found:\n            gate = int(col)\n            break\n    assert not (gate is None)\n\n    # --- token/bg inference ---\n    cnt_all = Counter(map(int, g.flatten()))\n    cand_token = [c for c in colors if int(c) not in (0, int(gate))]\n    assert not (not cand_token)\n    token = int(min(cand_token, key=lambda c: (int(cnt_all[int(c)]), int(c))))\n    cand_bg = [c for c in colors if int(c) not in (0, int(gate), int(token))]\n    assert cand_bg\n    bg = int(max(cand_bg, key=lambda c: (int(cnt_all[int(c)]), -int(c))))\n\n    # --- opened gate color (vertical post) ---\n    open_col = 6 if int(gate) == 7 and 6 not in colors else int(gate - 1) if int(gate) > 0 else 6\n\n    # --- rotate gates (gates open into bg, center becomes vertical open_col) ---\n    out = g.copy()\n    lab, n = label_mask(out == int(gate), connectivity=4)\n    for k in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(k))\n        if int(pts.shape[0]) != 3:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        if int(r1 - r0 + 1) != 1 or int(c1 - c0 + 1) != 3:\n            continue\n        r = int(r0)\n        c0 = int(c0)\n        center_c = int(c0 + 1)\n        out[int(r), int(c0) : int(c0) + 3] = int(bg)\n        for rr in (int(r - 1), int(r), int(r + 1)):\n            if 0 <= int(rr) < H:\n                out[int(rr), int(center_c)] = int(open_col)\n\n    # helpers\n    def segments_in_row(r: int) -> list[tuple[int, int]]:\n        segs: list[tuple[int, int]] = []\n        c = 0\n        while c < W:\n            if int(out[r, c]) != int(bg):\n                c += 1; continue\n            c0 = c\n            while c + 1 < W and int(out[r, c + 1]) == int(bg):\n                c += 1\n            segs.append((c0, c)); c += 1\n        return segs\n\n    def find_seg(segs: list[tuple[int, int]], c: int) -> tuple[int, int] | None:\n        for a, b in segs:\n            if a <= c <= b: return (a, b)\n        return None\n\n    def seg_exit(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single exit column, or None. Assert if >1 exit.\"\"\"\n        a, b = seg\n        if r + 2 >= H: return None\n        drops = [c for c in range(a, b + 1)\n                 if int(out[r + 1, c]) == int(bg) and int(out[r + 2, c]) == int(bg)]\n        assert len(drops) <= 1, f\"segment ({a},{b}) at row {r} has {len(drops)} exits: {drops}\"\n        return drops[0] if drops else None\n\n    def entry_from_above(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single entry column from the wall above, or None. Assert if >1.\"\"\"\n        a, b = seg\n        if r < 2: return None\n        entries = [c for c in range(a, b + 1)\n                   if int(out[r - 1, c]) == int(bg) and int(out[r - 2, c]) == int(bg)]\n        assert len(entries) <= 1, f\"segment ({a},{b}) at row {r} has {len(entries)} entries from above: {entries}\"\n        return entries[0] if entries else None\n\n    # Remove tokens; simulate; re-place.\n    token_pts = [(int(r), int(c)) for r, c in np.argwhere(out == int(token))]\n    out[out == int(token)] = int(bg)\n\n    # Phase 1: each token drops through single exits until stuck.\n    finals: list[tuple[int, int]] = []  # (row, col) of final position\n    for r, c in token_pts:\n        cur_r, cur_c = r, c\n        if int(out[cur_r, cur_c]) != int(bg):\n            finals.append((cur_r, cur_c)); continue\n        while True:\n            seg = find_seg(segments_in_row(cur_r), cur_c)\n            if seg is None: break\n            ex = seg_exit(cur_r, seg)\n            if ex is None: break\n            cur_r += 2; cur_c = ex\n            if cur_r >= H: break\n        finals.append((cur_r, cur_c))\n\n    # Phase 2: pack tokens at opposite end from entry.\n    buckets: dict[tuple[int, tuple[int, int], int], int] = defaultdict(int)\n    for r, c in finals:\n        segs = segments_in_row(r)\n        seg = find_seg(segs, c)\n        if seg is None: continue\n        a, b = seg\n        entry = entry_from_above(r, seg)\n        if entry is not None:\n            # Pack to opposite end from entry\n            pack_end = b if (entry - a) <= (b - entry) else a\n        else:\n            # No entry from above: token at starting position (grid edge), stay put\n            pack_end = a if c <= a else b\n        buckets[(r, seg, pack_end)] += 1\n\n    for (r, (a, b), pack_end), k in buckets.items():\n        if pack_end == a:\n            for i in range(k):\n                if a + i <= b: out[r, a + i] = int(token)\n        else:\n            for i in range(k):\n                if b - i >= a: out[r, b - i] = int(token)\n\n    return out\n\n# --------------- generator (Codex, output-first with spine) ---------------\n\nWALL = 0\nTOKEN = 3\nOPEN = 6\nGATE = 7\nBG = 8\n\n\ndef _build_opened_grid(gates: list[list[int]], holes: list[list[int]], width: int) -> np.ndarray:\n    n_walls = len(gates)\n    height = 2 * n_walls + 1\n    grid = np.full((height, width), WALL, dtype=int)\n\n    for pipe_idx in range(n_walls + 1):\n        r = 2 * pipe_idx\n        grid[r, :] = BG\n        for c in holes[pipe_idx]:\n            grid[r, c] = WALL\n\n    for wall_idx, centers in enumerate(gates):\n        r = 2 * wall_idx + 1\n        for c in centers:\n            grid[r, c - 1] = BG\n            grid[r, c] = OPEN\n            grid[r, c + 1] = BG\n            grid[r - 1, c] = OPEN\n            grid[r + 1, c] = OPEN\n\n    return grid\n\n\ndef _build_input(gates: list[list[int]], holes: list[list[int]], width: int) -> np.ndarray:\n    n_walls = len(gates)\n    height = 2 * n_walls + 1\n    grid = np.full((height, width), WALL, dtype=int)\n    gate_patch = np.full((1, 3), GATE, dtype=int)\n\n    for pipe_idx in range(n_walls + 1):\n        r = 2 * pipe_idx\n        grid[r, :] = BG\n        for c in holes[pipe_idx]:\n            grid[r, c] = WALL\n\n    for wall_idx, centers in enumerate(gates):\n        r = 2 * wall_idx + 1\n        for c in centers:\n            paste(grid, gate_patch, r, c - 1)\n\n    for pipe_idx in range(n_walls):\n        r = 2 * pipe_idx\n        grid[r, 0] = TOKEN\n        grid[r, width - 1] = TOKEN\n\n    return grid\n\n\ndef _segments_in_row(grid: np.ndarray, r: int) -> list[tuple[int, int]]:\n    width = grid.shape[1]\n    segments: list[tuple[int, int]] = []\n    c = 0\n    while c < width:\n        if grid[r, c] != BG:\n            c += 1\n            continue\n        start = c\n        while c + 1 < width and grid[r, c + 1] == BG:\n            c += 1\n        segments.append((start, c))\n        c += 1\n    return segments\n\n\ndef _find_segment(grid: np.ndarray, r: int, c: int) -> tuple[int, int] | None:\n    for seg in _segments_in_row(grid, r):\n        if seg[0] <= c <= seg[1]:\n            return seg\n    return None\n\n\ndef _exits_below(grid: np.ndarray, r: int, seg: tuple[int, int]) -> list[int]:\n    height = grid.shape[0]\n    if r + 2 >= height:\n        return []\n    a, b = seg\n    return [c for c in range(a, b + 1) if grid[r + 1, c] == BG and grid[r + 2, c] == BG]\n\n\ndef _entries_above(grid: np.ndarray, r: int, seg: tuple[int, int]) -> list[int]:\n    if r < 2:\n        return []\n    a, b = seg\n    return [c for c in range(a, b + 1) if grid[r - 1, c] == BG and grid[r - 2, c] == BG]\n\n\ndef _find_issues(grid: np.ndarray) -> list[tuple[int, tuple[int, int], list[int], list[int]]]:\n    height = grid.shape[0]\n    issues: list[tuple[int, tuple[int, int], list[int], list[int]]] = []\n    for r in range(0, height, 2):\n        for seg in _segments_in_row(grid, r):\n            above = _entries_above(grid, r, seg)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/84ba50d3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/84ba50d3.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _divider_row(g: np.ndarray, bg: int) -> tuple[int, int]:\n    rows: list[tuple[int, int]] = []\n    for r in range(g.shape[0]):\n        row_colors = set(map(int, g[r]))\n        if len(row_colors) == 1:\n            color = next(iter(row_colors))\n            if int(color) != int(bg):\n                rows.append((int(r), int(color)))\n    assert len(rows) == 1, \"expected exactly one solid non-background divider row\"\n    return rows[0]\n\n\ndef _unique_widest_row(coords: np.ndarray) -> int:\n    row_counts: list[tuple[int, int]] = []\n    for r in sorted(set(map(int, coords[:, 0]))):\n        row_cols = np.sort(coords[coords[:, 0] == r, 1])\n        assert np.array_equal(row_cols, np.arange(int(row_cols[0]), int(row_cols[-1]) + 1))\n        row_counts.append((int(row_cols.size), int(r)))\n\n    max_count = max(count for count, _r in row_counts)\n    widest = [r for count, r in row_counts if count == max_count]\n    assert max_count > 1, \"multi-column sprites must have a horizontal span\"\n    assert len(widest) == 1, \"expected a unique widest horizontal row\"\n    return int(widest[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the blue sprites downward relative to the red divider, with vertical sprites passing through to the bottom.\n\n    Input structure:\n    - The background is the dominant color.\n    - One non-background color forms a single full-width horizontal divider row.\n    - The other non-background color forms 4-connected sprites above the divider.\n\n    Rule:\n    - Clear the original sprite pixels.\n    - A one-column sprite falls to the bottom of its column and deletes the divider\n      pixel it crossed.\n    - Any wider sprite falls until its unique widest horizontal row is immediately\n      above the divider row; if the moved sprite overlaps the divider, it covers it.\n\n    Key insight:\n    The red row is not a generic floor: only one-column sprites pass through to the\n    bottom, while wider sprites are registered by their widest horizontal segment.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n    line_r, line_color = _divider_row(g, bg)\n\n    non_bg_colors = set(map(int, g.ravel())) - {bg}\n    sprite_colors = non_bg_colors - {line_color}\n    assert len(sprite_colors) == 1, \"expected exactly one sprite color\"\n    sprite_color = next(iter(sprite_colors))\n\n    sprites = find_components(\n        g,\n        bg=bg,\n        colors=[sprite_color],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert sprites, \"expected at least one sprite\"\n\n    out = g.copy()\n    out[g == sprite_color] = bg\n    occupied = np.zeros((H, W), dtype=bool)\n\n    for sprite in sprites:\n        coords = sprite[\"coords\"]\n        _r0, c0, r1, c1 = map(int, sprite[\"bbox\"])\n        assert r1 < line_r, \"all sprites must begin above the divider\"\n\n        if c0 == c1:\n            shift = H - 1 - r1\n            assert shift >= 0\n            assert int(out[line_r, c0]) == line_color\n            out[line_r, c0] = bg\n        else:\n            widest_r = _unique_widest_row(coords)\n            shift = line_r - 1 - widest_r\n            assert shift >= 0\n\n        moved = coords.copy()\n        moved[:, 0] += shift\n        assert np.all((0 <= moved[:, 0]) & (moved[:, 0] < H))\n        assert np.all((0 <= moved[:, 1]) & (moved[:, 1] < W))\n\n        for rr, cc in moved:\n            r = int(rr)\n            c = int(cc)\n            assert not occupied[r, c], \"moved sprites must not overlap\"\n            occupied[r, c] = True\n            out[r, c] = sprite_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, palette, and divider bounds.\nMIN_GRID_SIZE, LARGE_GRID_MIN, MAX_GRID_SIZE = 7, 14, 18\nLARGE_GRID_PROB, PALETTE_SIZE, DIVIDER_MARGIN = 0.35, 10, 3\nADJACENT_ROW_OFFSET = 1\n\n# Sprite counts, spacing, and retry limits.\nMIN_SPRITE_COUNT, MAX_SPRITE_COUNT = 1, 5\nMAX_SINGLE_SPRITES, MAX_MULTI_SPRITES = 2, 3\nGAP_COLUMNS, INPUT_GAP_TO_DIVIDER = 1, 1\nGENERATION_RETRIES = 300\n\n# Sprite geometry.\nMIN_SPRITE_HEIGHT, MAX_SINGLE_HEIGHT, MAX_MULTI_HEIGHT = 1, 7, 5\nSINGLE_WIDTH, MIN_MULTI_WIDTH, MAX_MULTI_WIDTH = 1, 2, 3\nWIDE_MULTI_PROB = 0.5\n\n\ndef _composition(total: int, parts: int) -> list[int]:\n    shares = [0] * parts\n    for _ in range(total):\n        shares[random.randrange(parts)] += 1\n    return shares\n\n\ndef _min_layout_width(n_single: int, n_multi: int) -> int:\n    n = n_single + n_multi\n    return n_single * SINGLE_WIDTH + MIN_MULTI_WIDTH * n_multi + GAP_COLUMNS * max(0, n - 1)\n\n\ndef _count_pairs(width: int) -> list[tuple[int, int]]:\n    pairs: list[tuple[int, int]] = []\n    for n_single in range(MAX_SINGLE_SPRITES + 1):\n        for n_multi in range(MAX_MULTI_SPRITES + 1):\n            n = n_single + n_multi\n            if MIN_SPRITE_COUNT <= n <= MAX_SPRITE_COUNT and _min_layout_width(n_single, n_multi) <= width:\n                pairs.append((n_single, n_multi))\n    return pairs\n\n\ndef _place_intervals(widths: list[int], grid_width: int) -> list[int]:\n    n = len(widths)\n    base = sum(widths) + GAP_COLUMNS * max(0, n - 1)\n    extra = grid_width - base\n    assert extra >= 0\n    gaps = _composition(extra, n + 1)\n\n    starts: list[int] = []\n    c = gaps[0]\n    for i, width in enumerate(widths):\n        starts.append(c)\n        c += width\n        if i < n - 1:\n            c += GAP_COLUMNS + gaps[i + 1]\n    return starts\n\n\ndef _multi_coords(top: int, left: int, height: int, width: int, bar_row: int, spine_col: int) -> np.ndarray:\n    coords = {(top + r, left + spine_col) for r in range(height)}\n    coords.update((top + bar_row, left + c) for c in range(width))\n    return np.array(sorted(coords), dtype=int)\n\n\ndef _build_descriptors(n_single: int, n_multi: int, max_single_h: int, max_multi_h: int, grid_width: int) -> list[dict[str, int | str]]:\n    descriptors: list[dict[str, int | str]] = []\n    for _ in range(n_single):\n        descriptors.append(\n            {\"kind\": \"single\", \"width\": SINGLE_WIDTH, \"height\": random.randint(MIN_SPRITE_HEIGHT, max_single_h)}\n        )\n\n    extra_width = grid_width - _min_layout_width(n_single, n_multi)\n    for _ in range(n_multi):\n        width = MIN_MULTI_WIDTH\n        if extra_width > 0 and random.random() < WIDE_MULTI_PROB:\n            width = MAX_MULTI_WIDTH\n            extra_width -= MAX_MULTI_WIDTH - MIN_MULTI_WIDTH\n        height = random.randint(MIN_SPRITE_HEIGHT, max_multi_h)\n        descriptors.append(\n            {\n                \"kind\": \"multi\",\n                \"width\": width,\n                \"height\": height,\n                \"bar_row\": random.randint(0, height - ADJACENT_ROW_OFFSET),\n                \"spine_col\": random.randrange(width),\n            }\n        )\n\n    random.shuffle(descriptors)\n    return descriptors\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(LARGE_GRID_MIN, MAX_GRID_SIZE) if random.random() < LARGE_GRID_PROB else random.randint(MIN_GRID_SIZE, MAX_GRID_SIZE)\n    W = H\n    bg, divider_color, sprite_color = random.sample(range(PALETTE_SIZE), 3)\n    divider_choices = list(range(DIVIDER_MARGIN, H - DIVIDER_MARGIN))\n    divider_weights = [min(r - ADJACENT_ROW_OFFSET, H - r - ADJACENT_ROW_OFFSET) for r in divider_choices]\n    divider_r = random.choices(divider_choices, weights=divider_weights, k=1)[0]\n\n    pairs = _count_pairs(W)\n    if not pairs:\n        return None\n    n_single, n_multi = random.choice(pairs)\n\n    max_single_h = min(MAX_SINGLE_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER, H - divider_r - ADJACENT_ROW_OFFSET)\n    max_multi_h = min(MAX_MULTI_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER)\n    if (n_single and max_single_h < MIN_SPRITE_HEIGHT) or (n_multi and max_multi_h < MIN_SPRITE_HEIGHT):\n        return None\n\n    descriptors = _build_descriptors(n_single, n_multi, max_single_h, max_multi_h, W)\n    starts = _place_intervals([int(d[\"width\"]) for d in descriptors], W)\n\n    inp = np.full((H, W), bg, dtype=int)\n    out = np.full((H, W), bg, dtype=int)\n    inp[divider_r, :] = divider_color\n    out[divider_r, :] = divider_color\n\n    input_max_bottom = divider_r - INPUT_GAP_TO_DIVIDER - ADJACENT_ROW_OFFSET\n    for desc, left in zip(descriptors, starts):\n        height = int(desc[\"height\"])\n        width = int(desc[\"width\"])\n        if desc[\"kind\"] == \"single\":\n            col = left\n            out[divider_r, col] = bg\n            out[H - height : H, col] = sprite_color\n\n            input_bottom = random.randint(height - ADJACENT_ROW_OFFSET, input_max_bottom)\n            inp[input_bottom - height + ADJACENT_ROW_OFFSET : input_bottom + ADJACENT_ROW_OFFSET, col] = sprite_color\n            continue\n\n        bar_row = int(desc[\"bar_row\"])\n        spine_col = int(desc[\"spine_col\"])\n        landed_top = divider_r - ADJACENT_ROW_OFFSET - bar_row\n        landed = _multi_coords(landed_top, left, height, width, bar_row, spine_col)\n        if np.any((landed[:, 0] < 0) | (landed[:, 0] >= H)):\n            return None\n        out[landed[:, 0], landed[:, 1]] = sprite_color\n\n        landed_bottom = int(landed[:, 0].max())\n        min_shift = landed_bottom - input_max_bottom\n        max_shift = landed_top\n        if min_shift > max_shift:\n            return None\n        shift = random.randint(min_shift, max_shift)\n        original = landed.copy()\n        original[:, 0] -= shift\n        if np.any((original[:, 0] < 0) | (original[:, 0] > input_max_bottom)):\n            return None\n        inp[original[:, 0], original[:, 1]] = sprite_color\n\n    bg_count = int(np.count_nonzero(inp == bg))\n    if bg_count <= int(np.count_nonzero(inp == divider_color)):\n        return None\n","exit_code":0,"status":"completed"}}
