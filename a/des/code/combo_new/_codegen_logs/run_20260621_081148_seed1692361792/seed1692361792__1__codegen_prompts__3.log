{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"file='/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py'; rg -n '\"'^def (main|generate_input)'\"' \\\"\"'$file\"; nl -ba \"$file\" | sed -n '\"'1,280p'\"","aggregated_output":"7:def main(grid: np.ndarray) -> np.ndarray:\n260:def generate_input() -> np.ndarray:\n     1\timport numpy as np\n     2\t\n     3\tfrom arc_utils import find_components, get_bg, is_contiguous, object_interior\n     4\timport random\n     5\t\n     6\t\n     7\tdef main(grid: np.ndarray) -> np.ndarray:\n     8\t    \"\"\"\n     9\t    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n    10\t\n    11\t    Input structure:\n    12\t    - The grid has a dominant background color.\n    13\t    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    14\t    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n    15\t\n    16\t    Rule:\n    17\t    - Keep the input pixels unchanged.\n    18\t    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    19\t    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n    20\t\n    21\t    Key insight:\n    22\t    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    23\t    \"\"\"\n    24\t    g = np.asarray(grid, dtype=int)\n    25\t    bg = int(get_bg(g))\n    26\t    out = g.copy()\n    27\t    h, w = g.shape\n    28\t\n    29\t    markers: dict[int, int] = {}\n    30\t    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    31\t    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n    32\t        r0, c0, r1, c1 = comp[\"bbox\"]\n    33\t        height = int(r1 - r0 + 1)\n    34\t        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n    35\t            continue\n    36\t\n    37\t        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n    38\t        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n    39\t        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n    40\t        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n    41\t        source = int(sub[0, 0])\n    42\t        halo = int(sub[0, 1])\n    43\t        assert source != halo, \"legend source and halo colors must differ\"\n    44\t        assert source not in markers, \"each source color must have exactly one legend marker\"\n    45\t\n    46\t        markers[source] = halo\n    47\t        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n    48\t\n    49\t    assert markers, \"expected at least one left-edge legend marker\"\n    50\t\n    51\t    for source, halo in markers.items():\n    52\t        objects = []\n    53\t        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n    54\t            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n    55\t            if cells <= marker_source_cells[source]:\n    56\t                continue\n    57\t            objects.append(comp)\n    58\t        assert objects, \"each legend source color must label at least one non-marker object\"\n    59\t\n    60\t        for obj in objects:\n    61\t            r0, c0, r1, c1 = obj[\"bbox\"]\n    62\t            pr0 = max(0, int(r0) - 1)\n    63\t            pc0 = max(0, int(c0) - 1)\n    64\t            pr1 = min(h - 1, int(r1) + 1)\n    65\t            pc1 = min(w - 1, int(c1) + 1)\n    66\t\n    67\t            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n    68\t            coords = obj[\"coords\"]\n    69\t            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n    70\t            enclosed = object_interior(patch, background=bg)\n    71\t            fill_mask = (patch == bg) & ~enclosed\n    72\t\n    73\t            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n    74\t            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n    75\t            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n    76\t            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n    77\t            target[fill_mask] = halo\n    78\t\n    79\t    return out\n    80\t\n    81\t# --------------- generator (att1, Claude) ---------------\n    82\t\n    83\t# Canvas and color palette.\n    84\tBACKGROUND = 0\n    85\tGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\n    86\tAVAILABLE_COLORS = tuple(range(1, 10))\n    87\t\n    88\t# Legend layout.\n    89\tLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\n    90\tLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n    91\t\n    92\t# Sprite geometry and acceptance.\n    93\tSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\n    94\tSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\n    95\tSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\n    96\tSPRITE_RETRIES = 300\n    97\t\n    98\t# Object counts and placement.\n    99\tINSTANCE_MIN, INSTANCE_MAX = 1, 3\n   100\tOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\n   101\tEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\n   102\tPLACEMENT_RETRIES = 200\n   103\t\n   104\t# Whole-sample retry budget.\n   105\tGENERATION_RETRIES = 300\n   106\t\n   107\t\n   108\tdef _make_sprite(color):\n   109\t    \"\"\"Construct one LR-symmetric 4-connected sprite matching the configured area/hole bounds.\"\"\"\n   110\t    target_area = random.randint(SPRITE_AREA_MIN, SPRITE_AREA_MAX)\n   111\t    for _ in range(SPRITE_RETRIES):\n   112\t        fill_p = target_area / (SPRITE_SIZE * SPRITE_SIZE) + random.uniform(-SPRITE_FILL_JITTER, SPRITE_FILL_JITTER)\n   113\t        sprite = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=int)\n   114\t        for r in range(SPRITE_SIZE):\n   115\t            for c in range(SPRITE_MIRROR_COLS):\n   116\t                if random.random() < fill_p:\n   117\t                    sprite[r, c] = color\n   118\t                    sprite[r, SPRITE_SIZE - 1 - c] = color\n   119\t        area = int(np.count_nonzero(sprite))\n   120\t        if area != target_area:\n   121\t            continue\n   122\t        if not is_contiguous(sprite, background=BACKGROUND, connectivity=4):\n   123\t            continue\n   124\t        if not (np.any(sprite[0] != BACKGROUND) and np.any(sprite[-1] != BACKGROUND) and\n   125\t                np.any(sprite[:, 0] != BACKGROUND) and np.any(sprite[:, -1] != BACKGROUND)):\n   126\t            continue\n   127\t        padded = np.zeros((SPRITE_SIZE + 2, SPRITE_SIZE + 2), dtype=int)\n   128\t        padded[1:-1, 1:-1] = sprite\n   129\t        interior = object_interior(padded, background=BACKGROUND)\n   130\t        holes = int(np.sum(interior & (padded == BACKGROUND)))\n   131\t        if holes > MAX_INTERIOR_HOLES:\n   132\t            continue\n   133\t        return sprite\n   134\t    return None\n   135\t\n   136\t\n   137\tdef _boxes_overlap(a, b):\n   138\t    return a[0] <= b[2] and a[2] >= b[0] and a[1] <= b[3] and a[3] >= b[1]\n   139\t\n   140\t\n   141\tdef _draw_legend(grid, src1, halo1, src2, halo2):\n   142\t    lower_top = grid.shape[0] - LEGEND_MARKER_SIZE\n   143\t    upper_top = lower_top - LEGEND_VERTICAL_GAP - LEGEND_MARKER_SIZE\n   144\t    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src1\n   145\t    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo1\n   146\t    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src2\n   147\t    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo2\n   148\t    return (upper_top, LEGEND_SOURCE_COL, grid.shape[0] - 1, LEGEND_HALO_COL)\n   149\t\n   150\t\n   151\tdef _visible_window(sprite, size, r0, c0):\n   152\t    \"\"\"Return the visible grid bbox and matching sprite slice for a possibly clipped sprite.\"\"\"\n   153\t    vr0, vc0 = max(0, r0), max(0, c0)\n   154\t    vr1 = min(size - 1, r0 + SPRITE_SIZE - 1)\n   155\t    vc1 = min(size - 1, c0 + SPRITE_SIZE - 1)\n   156\t    visible = sprite[vr0 - r0:vr1 - r0 + 1, vc0 - c0:vc1 - c0 + 1]\n   157\t    return (vr0, vc0, vr1, vc1), visible\n   158\t\n   159\t\n   160\tdef _padded_bbox(visible_box, size):\n   161\t    vr0, vc0, vr1, vc1 = visible_box\n   162\t    return (max(0, vr0 - HALO_PADDING), max(0, vc0 - HALO_PADDING),\n   163\t            min(size - 1, vr1 + HALO_PADDING), min(size - 1, vc1 + HALO_PADDING))\n   164\t\n   165\t\n   166\tdef _place_objects(size, tasks, legend_box):\n   167\t    \"\"\"Choose non-overlapping object origins; returns placement tuples or None on retry exhaustion.\"\"\"\n   168\t    placed = []\n   169\t    placements = []\n   170\t    for sprite, sc, hc in tasks:\n   171\t        for _ in range(PLACEMENT_RETRIES):\n   172\t            if random.random() < EDGE_CLIP_PROB:\n   173\t                r0 = random.randint(-EDGE_CLIP_MARGIN, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n   174\t                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n   175\t            else:\n   176\t                r0 = random.randint(0, size - SPRITE_SIZE)\n   177\t                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE)\n   178\t            visible_box, visible = _visible_window(sprite, size, r0, c0)\n   179\t            if np.count_nonzero(visible) == 0:\n   180\t                continue\n   181\t\n   182\t            pbox = _padded_bbox(visible_box, size)\n   183\t            if (pbox[1] < OBJECT_MIN_COL or _boxes_overlap(pbox, legend_box) or\n   184\t                    any(_boxes_overlap(pbox, eb) for eb in placed)):\n   185\t                continue\n   186\t\n   187\t            placed.append(pbox)\n   188\t            placements.append((sprite, sc, hc, r0, c0))\n   189\t            break\n   190\t        else:\n   191\t            return None\n   192\t    return placements\n   193\t\n   194\t\n   195\tdef _render_output(grid, placements):\n   196\t    \"\"\"Render the paired output and return the generated input with halo-fill cells removed.\"\"\"\n   197\t    size = grid.shape[0]\n   198\t    output = grid.copy()\n   199\t    halo_mask = np.zeros((size, size), dtype=bool)\n   200\t\n   201\t    for sprite, sc, hc, r0, c0 in placements:\n   202\t        visible_box, visible = _visible_window(sprite, size, r0, c0)\n   203\t        vr0, vc0, vr1, vc1 = visible_box\n   204\t        output_region = output[vr0:vr1 + 1, vc0:vc1 + 1]\n   205\t        output_region[visible != BACKGROUND] = sc\n   206\t\n   207\t        pr0, pc0, pr1, pc1 = _padded_bbox(visible_box, size)\n   208\t        patch = np.zeros((pr1 - pr0 + 1, pc1 - pc0 + 1), dtype=int)\n   209\t        patch_region = patch[vr0 - pr0:vr1 - pr0 + 1, vc0 - pc0:vc1 - pc0 + 1]\n   210\t        patch_region[visible != BACKGROUND] = sc\n   211\t\n   212\t        enclosed = object_interior(patch, background=BACKGROUND)\n   213\t        fill = (patch == BACKGROUND) & ~enclosed\n   214\t        output_region = output[pr0:pr1 + 1, pc0:pc1 + 1]\n   215\t        output_region[fill] = hc\n   216\t        halo_region = halo_mask[pr0:pr1 + 1, pc0:pc1 + 1]\n   217\t        halo_region[fill] = True\n   218\t\n   219\t    inp = output.copy()\n   220\t    inp[halo_mask] = BACKGROUND\n   221\t    return inp, output\n   222\t\n   223\t\n   224\tdef _matches_oracle(inp, output):\n   225\t    try:\n   226\t        return np.array_equal(main(inp), output)\n   227\t    except Exception:\n   228\t        return False\n   229\t\n   230\t\n   231\tdef _gen_attempt():\n   232\t    sz = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n   233\t    colors = list(AVAILABLE_COLORS)\n   234\t    random.shuffle(colors)\n   235\t    src1, halo1, src2, halo2 = colors[:4]\n   236\t\n   237\t    sprite1 = _make_sprite(src1)\n   238\t    sprite2 = _make_sprite(src2)\n   239\t    if sprite1 is None or sprite2 is None:\n   240\t        return None\n   241\t\n   242\t    n1 = random.randint(INSTANCE_MIN, INSTANCE_MAX)\n   243\t    n2 = random.randint(INSTANCE_MIN, INSTANCE_MAX)\n   244\t    tasks = [(sprite1, src1, halo1)] * n1 + [(sprite2, src2, halo2)] * n2\n   245\t    random.shuffle(tasks)\n   246\t\n   247\t    grid = np.zeros((sz, sz), dtype=int)\n   248\t    legend_box = _draw_legend(grid, src1, halo1, src2, halo2)\n   249\t\n   250\t    placements = _place_objects(sz, tasks, legend_box)\n   251\t    if placements is None:\n   252\t        return None\n   253\t\n   254\t    inp, output = _render_output(grid, placements)\n   255\t    if _matches_oracle(inp, output):\n   256\t        return inp\n   257\t    return None\n   258\t\n   259\t\n   260\tdef generate_input() -> np.ndarray:\n   261\t    for _ in range(GENERATION_RETRIES):\n   262\t        result = _gen_attempt()\n   263\t        if result is not None:\n   264\t            return result\n   265\t    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
