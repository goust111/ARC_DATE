{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"file='/home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py'; rg -n '\"'^def (main|generate_input)'\"' \\\"\"'$file\"; nl -ba \"$file\" | sed -n '\"'1,280p'\"","aggregated_output":"6:def main(grid: np.ndarray) -> np.ndarray:\n532:def generate_input() -> np.ndarray:\n     1\timport numpy as np\n     2\t\n     3\tfrom arc_utils import neighbors4, neighbors8, components_mask, get_bg\n     4\timport random\n     5\t\n     6\tdef main(grid: np.ndarray) -> np.ndarray:\n     7\t    \"\"\"\n     8\t    Fill the region enclosed by a wall sprite and radiate color outward through its opening.\n     9\t\n    10\t    Input structure:\n    11\t    - bg = most common color. Wall = most frequent non-bg color, forming a partial enclosure (e.g. U-shape).\n    12\t    - A fill-color pixel sits inside the enclosed area. Other non-bg pixels may act as obstacles.\n    13\t    Rule:\n    14\t    - Flood-fill the enclosed area with the fill color, radiating outward through the wall's open end.\n    15\t    - Obstacles cast \"shadows\" along the radiate direction, blocking fill behind them.\n    16\t\n    17\t    Key insight: The wall endpoints define the opening direction; fill radiates outward through it, and obstacles block propagation along that same axis.\n    18\t    \"\"\"\n    19\t    g = np.array(grid, copy=True)\n    20\t    h, w = g.shape\n    21\t\n    22\t    vals = np.unique(g)\n    23\t    bg = get_bg(g)\n    24\t\n    25\t    non_bg = [int(v) for v in vals if int(v) != bg]\n    26\t    assert non_bg, \"expected at least one non-background color\"\n    27\t\n    28\t    # Wall: most frequent non-background color.\n    29\t    wall = max(non_bg, key=lambda c: int((g == c).sum()))\n    30\t\n    31\t    wall_mask = g == wall\n    32\t\n    33\t    # Wall connected components (8-neigh).\n    34\t    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]\n    35\t    assert comps, \"expected at least one wall connected component\"\n    36\t\n    37\t    def sgn(x: int) -> int:\n    38\t        return (x > 0) - (x < 0)\n    39\t\n    40\t    other_colors = [c for c in non_bg if c != wall]\n    41\t    assert other_colors, \"expected at least one non-wall color (fill color)\"\n    42\t\n    43\t    # Pick fill color as the non-wall color closest (Manhattan distance) to the wall pixels.\n    44\t    wall_points = [p for comp in comps for p in comp]\n    45\t\n    46\t    def min_dist_to_wall(color: int) -> tuple[int, int]:\n    47\t        pts = list(zip(*np.where(g == color)))\n    48\t        pts = [(int(r), int(c)) for r, c in pts]\n    49\t        best_d = 10**9\n    50\t        for r, c in pts:\n    51\t            for wr, wc in wall_points:\n    52\t                d = abs(r - wr) + abs(c - wc)\n    53\t                if d < best_d:\n    54\t                    best_d = d\n    55\t                    if best_d == 0:\n    56\t                        return 0, len(pts)\n    57\t        return best_d, len(pts)\n    58\t\n    59\t    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))\n    60\t\n    61\t    fill_pos = list(zip(*np.where(g == fill)))\n    62\t    fill_pos = [(int(r), int(c)) for r, c in fill_pos]\n    63\t    if not fill_pos:\n    64\t        return g\n    65\t\n    66\t    # Choose the closest wall component to the fill seed (ties: larger component).\n    67\t    def comp_min_dist(comp: set[tuple[int, int]]) -> int:\n    68\t        best_d = 10**9\n    69\t        for r, c in fill_pos:\n    70\t            for wr, wc in comp:\n    71\t                d = abs(r - wr) + abs(c - wc)\n    72\t                if d < best_d:\n    73\t                    best_d = d\n    74\t                    if best_d == 0:\n    75\t                        return 0\n    76\t        return best_d\n    77\t\n    78\t    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))\n    79\t\n    80\t    comp_mask = np.zeros_like(wall_mask, dtype=bool)\n    81\t    for r, c in wall_comp:\n    82\t        comp_mask[r, c] = True\n    83\t\n    84\t    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:\n    85\t        out = []\n    86\t        for rr, cc in neighbors8(r, c):\n    87\t            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:\n    88\t                out.append((rr, cc))\n    89\t        return out\n    90\t\n    91\t    endpoints: list[tuple[int, int]] = []\n    92\t    for r, c in wall_comp:\n    93\t        if len(comp_neighbors(r, c)) == 1:\n    94\t            endpoints.append((r, c))\n    95\t\n    96\t    assert endpoints, \"expected wall component to have endpoints (degree-1 pixels)\"\n    97\t\n    98\t    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:\n    99\t        n1 = comp_neighbors(*ep)[0]\n   100\t        d1 = (sgn(n1[0] - ep[0]), sgn(n1[1] - ep[1]))  # inward\n   101\t        d_use = d1\n   102\t        is_12 = False\n   103\t        n2s = [p for p in comp_neighbors(*n1) if p != ep]\n   104\t        if n2s:\n   105\t            n2 = n2s[0]\n   106\t            d2 = (sgn(n2[0] - n1[0]), sgn(n2[1] - n1[1]))\n   107\t            if (d1[0] == 0) ^ (d1[1] == 0):\n   108\t                if d2[0] != 0 and d2[1] != 0:\n   109\t                    d_use = d2\n   110\t                    is_12 = True\n   111\t        return (-d_use[0], -d_use[1]), is_12\n   112\t\n   113\t    out_info = [outward_dir(ep) for ep in endpoints]\n   114\t    out_dirs = [d for d, _ in out_info]\n   115\t    tip_12 = [f for _, f in out_info]\n   116\t\n   117\t    dr_sum = sum(d[0] for d in out_dirs)\n   118\t    dc_sum = sum(d[1] for d in out_dirs)\n   119\t    rad = (sgn(dr_sum), sgn(dc_sum))\n   120\t\n   121\t    barrier = comp_mask.copy()\n   122\t\n   123\t    def add_ray(start: tuple[int, int], d: tuple[int, int], skip: int = 0) -> None:\n   124\t        rr, cc = start\n   125\t        for _ in range(skip):\n   126\t            rr += d[0]\n   127\t            cc += d[1]\n   128\t        while True:\n   129\t            rr += d[0]\n   130\t            cc += d[1]\n   131\t            if not (0 <= rr < h and 0 <= cc < w):\n   132\t                break\n   133\t            barrier[rr, cc] = True\n   134\t\n   135\t    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:\n   136\t        rr, cc = start\n   137\t        step = 0\n   138\t        while True:\n   139\t            step += 1\n   140\t            if step % 2 == 1:\n   141\t                rr += d[0]; cc += d[1]\n   142\t            else:\n   143\t                if rad[0] != 0:\n   144\t                    rr += d[0]\n   145\t                else:\n   146\t                    cc += d[1]\n   147\t            if not (0 <= rr < h and 0 <= cc < w):\n   148\t                break\n   149\t            barrier[rr, cc] = True\n   150\t\n   151\t    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):\n   152\t        if is_12:\n   153\t            add_ray_12(ep, d)\n   154\t        else:\n   155\t            add_ray(ep, d, skip=0)\n   156\t\n   157\t    passable = (~barrier) & ((g == bg) | (g == fill))\n   158\t    q = fill_pos[:]\n   159\t    seen = np.zeros_like(passable, dtype=bool)\n   160\t    for r, c in q:\n   161\t        if passable[r, c]:\n   162\t            seen[r, c] = True\n   163\t    while q:\n   164\t        r, c = q.pop()\n   165\t        for rr, cc in neighbors4(r, c):\n   166\t            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:\n   167\t                seen[rr, cc] = True\n   168\t                q.append((rr, cc))\n   169\t\n   170\t    filled_mask = (seen & (g == bg))\n   171\t\n   172\t    out = g.copy()\n   173\t    out[filled_mask] = fill\n   174\t\n   175\t    # Shadow behind obstacles (non-bg, non-fill, non-wall) along radiate direction.\n   176\t    obstacles = (g != bg) & (g != fill) & (g != wall)\n   177\t\n   178\t    def shadow_process(coords: list[tuple[int, int]]) -> None:\n   179\t        started = False\n   180\t        blocked = False\n   181\t        for r, c in coords:\n   182\t            if filled_mask[r, c]:\n   183\t                started = True\n   184\t            if started and obstacles[r, c]:\n   185\t                blocked = True\n   186\t                continue\n   187\t            if blocked and filled_mask[r, c]:\n   188\t                out[r, c] = bg\n   189\t                filled_mask[r, c] = False\n   190\t\n   191\t    if rad != (0, 0):\n   192\t        dr, dc = rad\n   193\t        if dr != 0 and dc == 0:\n   194\t            for c in range(w):\n   195\t                rows = range(h) if dr > 0 else range(h - 1, -1, -1)\n   196\t                shadow_process([(r, c) for r in rows])\n   197\t        elif dc != 0 and dr == 0:\n   198\t            for r in range(h):\n   199\t                cols = range(w) if dc > 0 else range(w - 1, -1, -1)\n   200\t                shadow_process([(r, c) for c in cols])\n   201\t        else:\n   202\t            # Diagonal scanlines\n   203\t            if dr == dc:\n   204\t                # r - c = const\n   205\t                for k in range(-(w - 1), h):\n   206\t                    coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]\n   207\t                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n   208\t                    shadow_process(coords)\n   209\t            else:\n   210\t                # r + c = const\n   211\t                for k in range(h + w - 1):\n   212\t                    coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]\n   213\t                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n   214\t                    shadow_process(coords)\n   215\t\n   216\t    return out\n   217\t\n   218\t# --------------- generator (o5x) ---------------\n   219\t\n   220\tfrom scipy.ndimage import distance_transform_cdt\n   221\t\n   222\t# -- Configuration constants --------------------------------------------------\n   223\t# Canvas size bounds\n   224\tGRID_H_VERT = (11, 18)       # height range when radiate_dir is vertical\n   225\tGRID_H_HORIZ = (8, 18)       # height range when radiate_dir is horizontal\n   226\tGRID_W = (15, 19)             # width range (all directions)\n   227\t\n   228\t# Wall geometry\n   229\tWALL_PIXELS_MIN = 17          # minimum wall pixel count\n   230\tWALL_PIXELS_MAX = 25          # maximum wall pixel count\n   231\tDEPTH_VERT = (5, 10)          # arm depth range for vertical radiate\n   232\tDEPTH_HORIZ = (6, 8)          # arm depth range for horizontal radiate\n   233\tGAP_VERT = (6, 7)             # endpoint gap for vertical radiate\n   234\tGAP_HORIZ = (5, 7)            # endpoint gap for horizontal radiate\n   235\tTIP_12_PROB = 0.5             # probability of 1:2 arm-angle mode (when eligible)\n   236\t\n   237\t# Placement margins\n   238\tOPEN_END_MARGIN = 3           # min cells from open end to radiate grid edge\n   239\t\n   240\t# Fill seed\n   241\tSEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]  # weighted choices for blob size\n   242\tSEED_DEPTH_LOOKBACK = 3       # seed must be within this many rows of closed end\n   243\t\n   244\t# Obstacles\n   245\tMAX_OBSTACLES = 5             # maximum obstacle pixel count\n   246\tOBSTACLE_IN_FILL_PROB = 0.65  # probability of forcing at least one obstacle in fill zone\n   247\tOBSTACLE_MIN_SEP = 2          # Chebyshev distance between obstacles (> this value)\n   248\t\n   249\t# Validation\n   250\tMIN_NEW_FILL = 20             # minimum newly-filled pixels for a valid output\n   251\tPALETTE_SIZE = (3, 5)         # number of distinct colors (bg + wall + fill + obstacle(s))\n   252\tGEN_RETRIES = 300             # max attempts in generate_input\n   253\t\n   254\t\n   255\tdef _degree1_pixels(points):\n   256\t    \"\"\"Return degree-1 pixels (exactly one 8-neighbor in the set).\"\"\"\n   257\t    pts = set(points)\n   258\t    return [(r, c) for r, c in pts\n   259\t            if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1]\n   260\t\n   261\t\n   262\tdef _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):\n   263\t    \"\"\"Build one zigzag arm from (0, start_v) toward (depth, target_v).\"\"\"\n   264\t    sign = 1 if target_v > start_v else -1\n   265\t    n_side_steps = abs(target_v - start_v)\n   266\t    chosen_rows = []\n   267\t    if n_side_steps:\n   268\t        if tip_12:\n   269\t            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]\n   270\t            extra_steps = 0\n   271\t        else:\n   272\t            chosen_rows = [1]\n   273\t            if n_side_steps > 1:\n   274\t                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)\n   275\t            chosen_rows.sort()\n   276\t\n   277\t    first_row = chosen_rows[0] if chosen_rows else 1\n   278\t    extra_rows = [r for r in chosen_rows if r != first_row]\n   279\t    random.shuffle(extra_rows)\n   280\t    orthogonal_rows = set(extra_rows[:extra_steps])\n","exit_code":0,"status":"completed"}}
