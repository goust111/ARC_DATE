{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"file='/home/lixinyu/snap/new/ARC_code/train/d968ffd4.py'; rg -n '\"'^def (main|generate_input)'\"' \\\"\"'$file\"; nl -ba \"$file\" | sed -n '\"'1,280p'\"","aggregated_output":"14:def main(grid: np.ndarray) -> np.ndarray:\n134:def generate_input() -> np.ndarray:\n     1\timport numpy as np\n     2\t\n     3\tfrom arc_utils import find_components, get_bg\n     4\timport random\n     5\t\n     6\t\n     7\tdef _is_solid_rect(g: np.ndarray, comp: dict) -> bool:\n     8\t    r0, c0, r1, c1 = comp[\"bbox\"]\n     9\t    h = r1 - r0 + 1\n    10\t    w = c1 - c0 + 1\n    11\t    return comp[\"area\"] == h * w and np.all(g[r0 : r1 + 1, c0 : c1 + 1] == comp[\"color\"])\n    12\t\n    13\t\n    14\tdef main(grid: np.ndarray) -> np.ndarray:\n    15\t    \"\"\"Extend each of two aligned rectangular marker objects toward the other, filling half of the gap across the full perpendicular span.\n    16\t\n    17\t    Input structure\n    18\t    - A dominant background contains exactly two solid, same-sized monochromatic rectangles.\n    19\t    - The rectangles share either the same row span or the same column span, with a background gap between their facing edges.\n    20\t\n    21\t    Rule\n    22\t    - If the rectangles are side-by-side, color the left half of the inter-object gap across every row with the left object's color, and the right half with the right object's color.\n    23\t    - If one rectangle is above the other, color the upper half of the gap across every column with the upper object's color, and the lower half with the lower object's color.\n    24\t    - When the gap length is odd, leave the center row/column as background.\n    25\t\n    26\t    Key insight\n    27\t    - The marker objects are endpoints of an axial corridor; their own size identifies the facing edge, while the filled corridor spans the whole grid perpendicular to that axis.\n    28\t    \"\"\"\n    29\t    g = np.asarray(grid, dtype=int)\n    30\t    bg = int(get_bg(g))\n    31\t    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    32\t    assert len(comps) == 2\n    33\t    assert all(_is_solid_rect(g, comp) for comp in comps)\n    34\t\n    35\t    a, b = comps\n    36\t    ar0, ac0, ar1, ac1 = a[\"bbox\"]\n    37\t    br0, bc0, br1, bc1 = b[\"bbox\"]\n    38\t    assert (ar1 - ar0, ac1 - ac0) == (br1 - br0, bc1 - bc0)\n    39\t\n    40\t    same_rows = (ar0, ar1) == (br0, br1)\n    41\t    same_cols = (ac0, ac1) == (bc0, bc1)\n    42\t    assert same_rows != same_cols\n    43\t\n    44\t    out = g.copy()\n    45\t    if same_rows:\n    46\t        left, right = sorted(comps, key=lambda comp: comp[\"bbox\"][1])\n    47\t        _lr0, _lc0, _lr1, lc1 = left[\"bbox\"]\n    48\t        _rr0, rc0, _rr1, _rc1 = right[\"bbox\"]\n    49\t        gap = rc0 - lc1 - 1\n    50\t        assert gap >= 1\n    51\t        span = gap // 2\n    52\t        out[:, lc1 + 1 : lc1 + 1 + span] = left[\"color\"]\n    53\t        out[:, rc0 - span : rc0] = right[\"color\"]\n    54\t    else:\n    55\t        top, bottom = sorted(comps, key=lambda comp: comp[\"bbox\"][0])\n    56\t        _tr0, _tc0, tr1, _tc1 = top[\"bbox\"]\n    57\t        br0, _bc0, _br1, _bc1 = bottom[\"bbox\"]\n    58\t        gap = br0 - tr1 - 1\n    59\t        assert gap >= 1\n    60\t        span = gap // 2\n    61\t        out[tr1 + 1 : tr1 + 1 + span, :] = top[\"color\"]\n    62\t        out[br0 - span : br0, :] = bottom[\"color\"]\n    63\t    return out\n    64\t\n    65\t# --------------- generator (att2) ---------------\n    66\t\n    67\t# Layout ranges and bounds.\n    68\tALIGNMENTS = (\"H\", \"V\")\n    69\tRECT_PERP_BOUNDS = (1, 4)\n    70\tRECT_AXIAL_VALUES = range(1, 3)\n    71\tGAP_VALUES = range(6, 17)\n    72\tAXIAL_BOUNDS = (14, 22)\n    73\tMARGIN = 1\n    74\tPALETTE = tuple(range(10))\n    75\tMAX_GENERATION_ATTEMPTS = 300\n    76\tVALID_AXIAL_GAP_PAIRS = tuple(\n    77\t    (rect_axial, gap)\n    78\t    for rect_axial in RECT_AXIAL_VALUES\n    79\t    for gap in GAP_VALUES\n    80\t    if AXIAL_BOUNDS[0] <= 2 * rect_axial + gap + 2 * MARGIN <= AXIAL_BOUNDS[1]\n    81\t)\n    82\t\n    83\t\n    84\tdef _choose_layout() -> tuple[str, int, int, int]:\n    85\t    alignment = random.choice(ALIGNMENTS)\n    86\t    rect_perp = random.randint(*RECT_PERP_BOUNDS)\n    87\t    rect_axial, gap = random.choice(VALID_AXIAL_GAP_PAIRS)\n    88\t    return alignment, rect_perp, rect_axial, gap\n    89\t\n    90\t\n    91\tdef _choose_colors() -> tuple[int, int, int]:\n    92\t    bg = random.choice(PALETTE)\n    93\t    color_a, color_b = random.sample([color for color in PALETTE if color != bg], 2)\n    94\t    return bg, color_a, color_b\n    95\t\n    96\t\n    97\tdef _render_horizontal(rect_perp: int, rect_axial: int, gap: int, bg: int, color_a: int, color_b: int) -> tuple[np.ndarray, np.ndarray]:\n    98\t    \"\"\"Build the horizontal input/output pair; vertical cases are its transpose.\"\"\"\n    99\t    perp = rect_perp + 2 * MARGIN\n   100\t    axial = 2 * rect_axial + gap + 2 * MARGIN\n   101\t    left_c0 = MARGIN\n   102\t    left_c1 = left_c0 + rect_axial - 1\n   103\t    right_c1 = axial - MARGIN - 1\n   104\t    right_c0 = right_c1 - rect_axial + 1\n   105\t    row0 = MARGIN\n   106\t    row1 = row0 + rect_perp - 1\n   107\t\n   108\t    out = np.full((perp, axial), bg, dtype=int)\n   109\t    out[row0 : row1 + 1, left_c0 : left_c1 + 1] = color_a\n   110\t    out[row0 : row1 + 1, right_c0 : right_c1 + 1] = color_b\n   111\t\n   112\t    span = gap // 2\n   113\t    out[:, left_c1 + 1 : left_c1 + 1 + span] = color_a\n   114\t    out[:, right_c0 - span : right_c0] = color_b\n   115\t\n   116\t    inp = out.copy()\n   117\t    inp[:, left_c1 + 1 : right_c0] = bg\n   118\t    return inp, out\n   119\t\n   120\t\n   121\tdef _gen_attempt() -> np.ndarray | None:\n   122\t    alignment, rect_perp, rect_axial, gap = _choose_layout()\n   123\t    bg, color_a, color_b = _choose_colors()\n   124\t    inp, out = _render_horizontal(rect_perp, rect_axial, gap, bg, color_a, color_b)\n   125\t    if alignment == \"V\":\n   126\t        inp = inp.T.copy()\n   127\t        out = out.T.copy()\n   128\t\n   129\t    if np.array_equal(main(inp), out):\n   130\t        return inp\n   131\t    return None\n   132\t\n   133\t\n   134\tdef generate_input() -> np.ndarray:\n   135\t    for _ in range(MAX_GENERATION_ATTEMPTS):\n   136\t        grid = _gen_attempt()\n   137\t        if grid is not None:\n   138\t            return grid\n   139\t    raise RuntimeError(\"failed to generate valid d968ffd4 input\")\n","exit_code":0,"status":"completed"}}
