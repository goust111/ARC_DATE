f kind==6: return (c,r)\n    if kind==7: return (n-1-c,n-1-r)\n\ntemplates={\n 'unique': {(0,0),(0,1),(0,3),(1,2)},\n 'away': {(0,0),(0,1),(3,0),(4,1)},\n 'visited': {(1,3),(1,4),(2,2),(2,5),(3,6),(4,4),(4,6),(5,4)},\n}\nfor name,obs in templates.items():\n  print(name)\n  for off in [(0,0),(0,1),(1,0),(1,1),(2,2)]:\n    ok=True\n    for k in range(8):\n      o={(r+off[0], c+off[1]) for r,c in {transform(p,k) for p in obs}}\n      s=(3+off[0],3+off[1])\n      st=sim(s,o,9,9)\n      if name=='unique': cond=st=={'unique':1,'visited':0,'away':0,'amb':False}\n      elif name=='away': cond=st=={'unique':1,'visited':0,'away':1,'amb':False}\n      else: cond=st=={'unique':3,'visited':1,'away':0,'amb':False}\n      ok=ok and cond\n    print(off, ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
