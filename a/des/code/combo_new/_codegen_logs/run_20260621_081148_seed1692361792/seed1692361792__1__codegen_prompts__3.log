{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"file='/home/lixinyu/snap/new/ARC_code/eval/6e453dd6.py'; rg -n '\"'^def (main|generate_input)'\"' \\\"\"'$file\"; nl -ba \"$file\" | sed -n '\"'1,280p'\"","aggregated_output":"38:def main(grid: np.ndarray) -> np.ndarray:\n362:def generate_input() -> np.ndarray:\n     1\timport numpy as np\n     2\t\n     3\tfrom arc_utils import components_mask, paste\n     4\timport random\n     5\t\n     6\t\n     7\tdef _components4(mask):\n     8\t    return components_mask(mask, connectivity=4)\n     9\t\n    10\t\n    11\tdef _find_separator_col(g: np.ndarray, sep_color: int = 5) -> int:\n    12\t    _, w = g.shape\n    13\t    cols = [c for c in range(w) if np.all(g[:, c] == sep_color)]\n    14\t    assert len(cols) == 1, f\"expected a unique full separator column, got {cols}\"\n    15\t    return int(cols[0])\n    16\t\n    17\t\n    18\tdef _background_color(g: np.ndarray, sep_col: int, sep_color: int = 5) -> int:\n    19\t    h, w = g.shape\n    20\t    border = []\n    21\t    for c in range(w):\n    22\t        if c != sep_col and g[0, c] != sep_color:\n    23\t            border.append(int(g[0, c]))\n    24\t        if c != sep_col and g[h - 1, c] != sep_color:\n    25\t            border.append(int(g[h - 1, c]))\n    26\t    for r in range(h):\n    27\t        if g[r, 0] != sep_color:\n    28\t            border.append(int(g[r, 0]))\n    29\t        if g[r, w - 1] != sep_color:\n    30\t            border.append(int(g[r, w - 1]))\n    31\t    assert border, \"expected non-separator border pixels to infer the background\"\n    32\t    vals, counts = np.unique(np.array(border, dtype=int), return_counts=True)\n    33\t    winners = vals[counts == counts.max()]\n    34\t    assert len(winners) == 1, f\"background color must be unique on the border, got {winners.tolist()}\"\n    35\t    return int(winners[0])\n    36\t\n    37\t\n    38\tdef main(grid: np.ndarray) -> np.ndarray:\n    39\t    \"\"\"\n    40\t    Slide black shapes rightward to a grey separator, then shoot red rays from enclosed holes.\n    41\t\n    42\t    Input structure:\n    43\t    - A vertical grey (5) separator column divides the grid into left and right halves.\n    44\t    - Black shapes sit on the left side against a background color (bg).\n    45\t\n    46\t    Rule:\n    47\t    - Translate each black connected component rightward until its right edge is flush with the separator.\n    48\t    - After sliding, find enclosed bg regions (holes) within the black shapes that touch the column just left of the separator.\n    49\t    - For each row spanned by such a hole, emit a red ray across the entire right half of the grid.\n    50\t\n    51\t    Key insight: Only holes adjacent to the separator trigger rays — the sliding creates enclosures that act as \"nozzles\" projecting rightward.\n    52\t    \"\"\"\n    53\t    g = np.asarray(grid, dtype=int)\n    54\t    h, w = g.shape\n    55\t    sep_color = 5\n    56\t    black = 0\n    57\t    red = 2\n    58\t\n    59\t    sep = _find_separator_col(g, sep_color=sep_color)\n    60\t    bg = _background_color(g, sep_col=sep, sep_color=sep_color)\n    61\t\n    62\t    out = g.copy()\n    63\t\n    64\t    # Step 1: move black components on the left so that their right edge touches the separator.\n    65\t    left = out[:, :sep].copy()\n    66\t    left_mask = left == black\n    67\t    comps = _components4(left_mask)\n    68\t\n    69\t    # Clear old black pixels (leave other colors intact).\n    70\t    left[left == black] = bg\n    71\t\n    72\t    target_right = sep - 1  # last column in left side, adjacent to separator\n    73\t    for comp in comps:\n    74\t        max_c = max(c for _, c in comp)\n    75\t        delta = target_right - max_c\n    76\t        assert delta >= 0, \"left-side components must stay left of the separator\"\n    77\t        for r, c in comp:\n    78\t            nc = c + delta\n    79\t            assert 0 <= nc < sep, f\"shifted pixel {(r, c)} left the pane\"\n    80\t            left[r, nc] = black\n    81\t\n    82\t    out[:, :sep] = left\n    83\t\n    84\t    # Step 2: find enclosed background regions (holes) on the left.\n    85\t    # A hole is a bg component not touching the left subgrid boundary.\n    86\t    holes = []\n    87\t    for pts in _components4(left == bg):\n    88\t        if any(r == 0 or r == h - 1 or c == 0 or c == sep - 1 for r, c in pts):\n    89\t            continue\n    90\t        holes.append(pts)\n    91\t\n    92\t    # Step 3: if a hole touches column sep-2 (one cell left of the black border that touches separator),\n    93\t    # emit a red ray on the right side for each row containing hole pixels.\n    94\t    trigger_col = sep - 2\n    95\t    trigger_rows = []\n    96\t    for pts in holes:\n    97\t        if not any(c == trigger_col for _, c in pts):\n    98\t            continue\n    99\t        trigger_rows.extend(sorted(set(r for r, _ in pts)))\n   100\t    assert len(trigger_rows) == len(set(trigger_rows)), f\"trigger rows must be unique, got {trigger_rows}\"\n   101\t    for r in trigger_rows:\n   102\t        assert np.all(out[r, sep + 1 :] == bg), f\"right half of row {r} must be background before ray emission\"\n   103\t        out[r, sep + 1 :] = red\n   104\t\n   105\t    return out\n   106\t\n   107\t# --------------- generator (att4) ---------------\n   108\t\n   109\t# ── Colors ──\n   110\tBG = 6       # magenta background\n   111\tBLACK = 0    # sprite color\n   112\tRED = 2      # ray color\n   113\tSEP_COLOR = 5  # grey separator\n   114\t\n   115\t# ── Grid dimensions ──\n   116\tH_MIN, H_MAX = 16, 25\n   117\tW_MIN, W_MAX = 10, 16\n   118\tSEP_MIN, SEP_MAX = 5, 11       # separator column range\n   119\tRIGHT_W_MIN, RIGHT_W_MAX = 2, 4  # right-side width range\n   120\t\n   121\t# ── Sprite constraints ──\n   122\tN_SPRITES_MIN, N_SPRITES_MAX = 2, 5\n   123\tSPRITE_H_MAX = 8               # max sprite bbox height\n   124\tSPRITE_W_MAX = 6               # max sprite bbox width\n   125\tMIN_BAND_GAP = 1               # min bg rows between sprite bands\n   126\t\n   127\t# ── Probabilities ──\n   128\tSPLIT_PROB = 0.4                # emitter: probability of split (mini+main) layout\n   129\tEXTRA_EMITTERS_PROB = 0.25      # chance to add more emitters beyond the minimum\n   130\tFLUSH_PROB = 0.35               # chance one input sprite stays flush with separator\n   131\t\n   132\t# ── Retry budget ──\n   133\tMAX_RETRIES = 300\n   134\t\n   135\t\n   136\tdef _scatter(total, slots):\n   137\t    \"\"\"Distribute *total* units randomly into *slots* bins.\"\"\"\n   138\t    vals = [0] * slots\n   139\t    for _ in range(total):\n   140\t        vals[random.randrange(slots)] += 1\n   141\t    return vals\n   142\t\n   143\t\n   144\tdef _min_emitters_for(n):\n   145\t    \"\"\"Minimum emitter count to satisfy >=60% emitter fraction for *n* sprites.\"\"\"\n   146\t    return (3 * n + 4) // 5\n   147\t\n   148\t\n   149\tdef _min_rows_needed(n_emitters, n_total):\n   150\t    \"\"\"Minimum grid rows to fit *n_total* sprites with *n_emitters* emitters.\"\"\"\n   151\t    return n_emitters * 3 + (n_total - n_emitters) * 2 + (n_total - 1) + 2\n   152\t\n   153\t\n   154\tdef _sprite_bands(h, is_emitter):\n   155\t    \"\"\"Partition grid rows into disjoint vertical bands for each sprite.\n   156\t\n   157\t    Returns list of (row_start, height) or None if they don't fit.\n   158\t    \"\"\"\n   159\t    n = len(is_emitter)\n   160\t    min_heights = [3 if e else 2 for e in is_emitter]\n   161\t    base_gaps = [MIN_BAND_GAP] * (n + 1)\n   162\t    height_cap = h - sum(base_gaps)\n   163\t    if sum(min_heights) > height_cap:\n   164\t        return None\n   165\t\n   166\t    heights = min_heights[:]\n   167\t    extra_cap = sum(SPRITE_H_MAX - x for x in heights)\n   168\t    extra = random.randint(0, min(extra_cap, height_cap - sum(heights)))\n   169\t    for _ in range(extra):\n   170\t        choices = [i for i, x in enumerate(heights) if x < SPRITE_H_MAX]\n   171\t        i = random.choice(choices)\n   172\t        heights[i] += 1\n   173\t\n   174\t    gaps = [a + b for a, b in zip(base_gaps, _scatter(h - sum(heights) - sum(base_gaps), n + 1))]\n   175\t    bands = []\n   176\t    r = gaps[0]\n   177\t    for i, sh in enumerate(heights):\n   178\t        bands.append((r, sh))\n   179\t        r += sh + gaps[i + 1]\n   180\t    return bands\n   181\t\n   182\t\n   183\tdef _emitter_patch(sh, max_sw):\n   184\t    \"\"\"Build an emitter sprite patch: a closed shell with an interior hole at the right edge.\"\"\"\n   185\t    hole_w = random.choice([1, 2]) if max_sw >= 4 else 1\n   186\t    sw = random.randint(hole_w + 2, max_sw)\n   187\t    patch = np.full((sh, sw), BG, dtype=int)\n   188\t\n   189\t    right_wall = sw - 1\n   190\t    left_wall = sw - hole_w - 2\n   191\t\n   192\t    # Optionally split into a narrower mini section + main section,\n   193\t    # creating a non-triggering hole in the mini part.\n   194\t    right_shift = random.randint(1, max(1, sw - 3))\n   195\t    mini_w = sw - right_shift\n   196\t    can_split = sh >= 5 and mini_w >= 3 and right_shift >= 1\n   197\t    if can_split and random.random() < SPLIT_PROB:\n   198\t        _build_split_emitter(patch, sh, sw, left_wall, right_wall, mini_w)\n   199\t    else:\n   200\t        patch[0, :] = BLACK\n   201\t        patch[-1, :] = BLACK\n   202\t        patch[1:-1, left_wall] = BLACK\n   203\t        patch[1:-1, right_wall] = BLACK\n   204\t    return patch\n   205\t\n   206\t\n   207\tdef _build_split_emitter(patch, sh, sw, left_wall, right_wall, mini_w):\n   208\t    \"\"\"Fill *patch* in-place with a split emitter (mini section + main section).\"\"\"\n   209\t    place_top = random.random() < 0.5\n   210\t    mini_h = random.randint(3, min(4, sh - 2))\n   211\t    main_h = sh - mini_h + 1  # +1 for shared connection row\n   212\t    if place_top:\n   213\t        # Top = mini (narrower), bottom = main (full width)\n   214\t        patch[0, :mini_w] = BLACK\n   215\t        for r in range(mini_h):\n   216\t            patch[r, 0] = BLACK\n   217\t            patch[r, mini_w - 1] = BLACK\n   218\t        patch[mini_h - 1, :] = BLACK  # connection row\n   219\t        patch[-1, :] = BLACK\n   220\t        for r in range(mini_h, sh):\n   221\t            patch[r, left_wall] = BLACK\n   222\t            patch[r, right_wall] = BLACK\n   223\t    else:\n   224\t        # Top = main (full width), bottom = mini (narrower)\n   225\t        patch[0, :] = BLACK\n   226\t        for r in range(main_h - 1):\n   227\t            patch[r, left_wall] = BLACK\n   228\t            patch[r, right_wall] = BLACK\n   229\t        patch[main_h - 1, :] = BLACK  # connection row\n   230\t        patch[-1, :mini_w] = BLACK\n   231\t        for r in range(main_h, sh):\n   232\t            patch[r, 0] = BLACK\n   233\t            patch[r, mini_w - 1] = BLACK\n   234\t\n   235\t\n   236\tdef _distractor_patch(sh, max_sw):\n   237\t    \"\"\"Build a non-emitter distractor sprite (C-shape, L-shape, or solid block).\"\"\"\n   238\t    choices = [\"l_shape\"]\n   239\t    if sh >= 3 and max_sw >= 3:\n   240\t        choices.extend([\"c_left\", \"c_right\"])\n   241\t    if sh <= 3:\n   242\t        choices.append(\"solid\")\n   243\t    kind = random.choice(choices)\n   244\t\n   245\t    if kind == \"solid\":\n   246\t        sw = random.randint(2, min(3, max_sw))\n   247\t        return np.full((sh, sw), BLACK, dtype=int)\n   248\t\n   249\t    min_sw = 3 if kind.startswith(\"c_\") or sh == 2 else 2\n   250\t    sw = random.randint(min_sw, max_sw)\n   251\t    patch = np.full((sh, sw), BG, dtype=int)\n   252\t    if kind == \"c_left\":\n   253\t        patch[0, :] = BLACK\n   254\t        patch[-1, :] = BLACK\n   255\t        patch[:, -1] = BLACK\n   256\t    elif kind == \"c_right\":\n   257\t        patch[0, :] = BLACK\n   258\t        patch[-1, :] = BLACK\n   259\t        patch[:, 0] = BLACK\n   260\t    else:\n   261\t        patch[:, -1] = BLACK\n   262\t        if random.random() < 0.5:\n   263\t            patch[0, :] = BLACK\n   264\t        else:\n   265\t            patch[-1, :] = BLACK\n   266\t    return patch\n   267\t\n   268\t\n   269\tdef _choose_grid_dims():\n   270\t    \"\"\"Pick grid height, width, and separator column satisfying all constraints.\"\"\"\n   271\t    h = random.randint(H_MIN, H_MAX)\n   272\t    right_w = random.randint(RIGHT_W_MIN, RIGHT_W_MAX)\n   273\t    valid_seps = [s for s in range(SEP_MIN, SEP_MAX + 1) if W_MIN <= s + 1 + right_w <= W_MAX]\n   274\t    sep = random.choice(valid_seps)\n   275\t    w = sep + 1 + right_w\n   276\t    return h, w, sep\n   277\t\n   278\t\n   279\tdef _choose_emitter_flags(h):\n   280\t    \"\"\"Decide sprite count and which sprites are emitters. Returns flags list or None.\"\"\"\n","exit_code":0,"status":"completed"}}
