 if kind==6: return (c,r)\n    if kind==7: return (n-1-c,n-1-r)\n\ntemplates={\n 'unique': {(0,0),(0,1),(0,3),(1,2)},\n 'away': {(0,0),(0,1),(3,0),(4,1)},\n 'visited': {(1,3),(1,4),(2,2),(2,5),(3,6),(4,4),(4,6),(5,4)},\n}\nfor shape in [(7,8),(8,7),(7,9),(9,7),(8,9),(9,8)]:\n  print('shape',shape)\n  for name,obs in templates.items():\n    ok=True\n    for k in range(8):\n      o={transform(p,k) for p in obs}\n      s=sim((3,3), o, *shape)\n      if name=='unique': cond=s=={'unique':1,'visited':0,'away':0,'amb':False}\n      elif name=='away': cond=s=={'unique':1,'visited':0,'away':1,'amb':False}\n      else: cond=s=={'unique':3,'visited':1,'away':0,'amb':False}\n      ok=ok and cond\n    print(name, ok)\nPY\"","aggregated_output":"shape (7, 8)\nunique True\naway True\nvisited True\nshape (8, 7)\nunique True\naway True\nvisited True\nshape (7, 9)\nunique True\naway True\nvisited True\nshape (9, 7)\nunique True\naway True\nvisited True\nshape (8, 9)\nunique True\naway True\nvisited True\nshape (9, 8)\nunique True\naway True\nvisited True\n","exit_code":0,"status":"completed"}}
