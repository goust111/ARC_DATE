{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"file='/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py'; rg -n '\"'^def (main|generate_input)'\"' \\\"\"'$file\"; nl -ba \"$file\" | sed -n '\"'1,260p'\"","aggregated_output":"17:def main(grid: np.ndarray) -> np.ndarray:\n259:def generate_input() -> np.ndarray:\n     1\tfrom __future__ import annotations\n     2\t\n     3\timport numpy as np\n     4\t\n     5\tfrom arc_utils import bbox_coords, components_mask, get_bg\n     6\timport random\n     7\t\n     8\t\n     9\tdef _touches_edge(coords: np.ndarray, height: int, width: int) -> bool:\n    10\t    rows = coords[:, 0]\n    11\t    cols = coords[:, 1]\n    12\t    return bool(\n    13\t        np.any((rows == 0) | (rows == height - 1) | (cols == 0) | (cols == width - 1))\n    14\t    )\n    15\t\n    16\t\n    17\tdef main(grid: np.ndarray) -> np.ndarray:\n    18\t    \"\"\"\n    19\t    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n    20\t\n    21\t    Input structure\n    22\t    - The most common color forms the outer background and all enclosed slot\n    23\t      backgrounds.\n    24\t    - The enclosed background components form a complete rectangular array of\n    25\t      slots, ordered by their positions.\n    26\t    - Each slot contains either no other color or exactly one object color.\n    27\t\n    28\t    Rule\n    29\t    - Find all 4-connected components of the most common color that do not touch\n    30\t      the input edge.\n    31\t    - Sort their bounding boxes into row and column order to define the output\n    32\t      table.\n    33\t    - For each slot, output its unique non-background color if present; otherwise\n    34\t      output the background color.\n    35\t\n    36\t    Key insight\n    37\t    - The large grid is an expanded table: the enclosed background components are\n    38\t      the cells, and any colored object drawn inside a cell is that cell's summary\n    39\t      value.\n    40\t    \"\"\"\n    41\t    g = np.asarray(grid, dtype=int)\n    42\t    assert g.ndim == 2, \"expected a 2D grid\"\n    43\t    height, width = map(int, g.shape)\n    44\t\n    45\t    bg = get_bg(g)\n    46\t    slot_bboxes: list[tuple[int, int, int, int]] = []\n    47\t    for coords in components_mask(g == bg, connectivity=4):\n    48\t        if _touches_edge(coords, height, width):\n    49\t            continue\n    50\t        slot_bboxes.append(bbox_coords(coords))\n    51\t\n    52\t    assert slot_bboxes, \"expected enclosed background slots\"\n    53\t    row_starts = sorted({b[0] for b in slot_bboxes})\n    54\t    col_starts = sorted({b[1] for b in slot_bboxes})\n    55\t    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n    56\t        \"expected a complete rectangular array of slots\"\n    57\t    )\n    58\t\n    59\t    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    60\t    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n    61\t\n    62\t    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    63\t    for out_r, r0 in enumerate(row_starts):\n    64\t        for out_c, c0 in enumerate(col_starts):\n    65\t            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n    66\t            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n    67\t            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    68\t            object_colors = np.unique(window[window != bg])\n    69\t            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n    70\t            if object_colors.size == 1:\n    71\t                out[out_r, out_c] = int(object_colors[0])\n    72\t\n    73\t    return out\n    74\t\n    75\t# --------------- generator (att2) ---------------\n    76\t\n    77\t# Canvas, table, frame, and slot dimensions.\n    78\tCANVAS_MIN, CANVAS_MAX = 13, 19\n    79\tTABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\n    80\tROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\n    81\tAXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n    82\t\n    83\t# Object and palette sampling limits.\n    84\tN_COLORS, MAX_OBJECT_COLORS = 10, 6\n    85\tMAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\n    86\tOBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n    87\t\n    88\t# Rejection sampling cap.\n    89\tGEN_RETRY_LIMIT = 300\n    90\t\n    91\t\n    92\tdef _gen_axis_options(n_slots, slot_min, slot_max):\n    93\t    options = []\n    94\t\n    95\t    def rec_slots(i, cur):\n    96\t        if i == n_slots:\n    97\t            rec_seps(0, [], cur)\n    98\t            return\n    99\t        for size in range(slot_min, slot_max + 1):\n   100\t            rec_slots(i + 1, cur + [size])\n   101\t\n   102\t    def rec_seps(i, cur, slots):\n   103\t        if i == n_slots - 1:\n   104\t            for before in AXIS_OUTER_OPTIONS:\n   105\t                for after in AXIS_OUTER_OPTIONS:\n   106\t                    for pad_before in AXIS_PADDING_OPTIONS:\n   107\t                        for pad_after in AXIS_PADDING_OPTIONS:\n   108\t                            total = (\n   109\t                                before\n   110\t                                + after\n   111\t                                + pad_before\n   112\t                                + pad_after\n   113\t                                + sum(slots)\n   114\t                                + sum(cur)\n   115\t                            )\n   116\t                            if 13 <= total <= 19:\n   117\t                                options.append(\n   118\t                                    (\n   119\t                                        tuple(slots),\n   120\t                                        tuple(cur),\n   121\t                                        before,\n   122\t                                        after,\n   123\t                                        pad_before,\n   124\t                                        pad_after,\n   125\t                                        total,\n   126\t                                )\n   127\t                            )\n   128\t            return\n   129\t        for sep in AXIS_SEPARATOR_OPTIONS:\n   130\t            rec_seps(i + 1, cur + [sep], slots)\n   131\t\n   132\t    rec_slots(0, [])\n   133\t    return options\n   134\t\n   135\t\n   136\tdef _gen_positions(axis):\n   137\t    sizes, seps, outer_before, _outer_after, pad_before, _pad_after, _total = axis\n   138\t    starts = []\n   139\t    pos = outer_before + pad_before\n   140\t    for i, size in enumerate(sizes):\n   141\t        starts.append(pos)\n   142\t        pos += size\n   143\t        if i < len(seps):\n   144\t            pos += seps[i]\n   145\t    return starts\n   146\t\n   147\t\n   148\tdef _gen_choose_axis(n_slots, slot_min, slot_max, other_axis=None, max_object_loss=0):\n   149\t    options = _gen_axis_options(n_slots, slot_min, slot_max)\n   150\t    if other_axis is None:\n   151\t        return random.choice(options)\n   152\t\n   153\t    good = []\n   154\t    for axis in options:\n   155\t        row_axis = axis if slot_max == ROW_SLOT_SIZE_RANGE[1] else other_axis\n   156\t        col_axis = axis if slot_max == COL_SLOT_SIZE_RANGE[1] else other_axis\n   157\t        height = row_axis[-1]\n   158\t        width = col_axis[-1]\n   159\t        frame_height = height - row_axis[2] - row_axis[3]\n   160\t        frame_width = width - col_axis[2] - col_axis[3]\n   161\t        slot_area = sum(row_axis[0]) * sum(col_axis[0])\n   162\t        outer_bg = height * width - frame_height * frame_width\n   163\t        bg_room = outer_bg + slot_area - max_object_loss\n   164\t        frame_area = frame_height * frame_width - slot_area\n   165\t        if bg_room > frame_area:\n   166\t            good.append(axis)\n   167\t    return random.choice(good or options)\n   168\t\n   169\t\n   170\tdef _gen_assign_colors(shape, bg, frame):\n   171\t    n_slots = shape[0] * shape[1]\n   172\t    filled_count = random.randint(1, n_slots - 1)\n   173\t    filled = random.sample(range(n_slots), filled_count)\n   174\t    colors = [c for c in range(N_COLORS) if c not in (bg, frame)]\n   175\t    n_colors = random.randint(1, min(MAX_OBJECT_COLORS, filled_count, len(colors)))\n   176\t    palette = random.sample(colors, n_colors)\n   177\t    assignments = palette[:]\n   178\t    assignments.extend(random.choice(palette) for _ in range(filled_count - n_colors))\n   179\t    random.shuffle(assignments)\n   180\t\n   181\t    out = np.full(shape, bg, dtype=int)\n   182\t    for idx, color in zip(filled, assignments):\n   183\t        out[idx // shape[1], idx % shape[1]] = color\n   184\t    return out, filled_count\n   185\t\n   186\t\n   187\tdef _gen_object_shape(slot_h, slot_w):\n   188\t    by_area = {}\n   189\t    for obj_h in range(1, min(MAX_OBJECT_HEIGHT, slot_h - 2 * OBJECT_MARGIN) + 1):\n   190\t        for obj_w in range(1, min(MAX_OBJECT_WIDTH, slot_w - 2 * OBJECT_MARGIN) + 1):\n   191\t            by_area.setdefault(obj_h * obj_w, []).append((obj_h, obj_w))\n   192\t    area = random.choice(list(by_area))\n   193\t    return random.choice(by_area[area])\n   194\t\n   195\t\n   196\tdef _gen_choose_layout(rows, cols, filled_count):\n   197\t    row_axis = _gen_choose_axis(rows, *ROW_SLOT_SIZE_RANGE)\n   198\t    loss = MAX_OBJECT_AREA * filled_count\n   199\t    col_axis = _gen_choose_axis(cols, *COL_SLOT_SIZE_RANGE, row_axis, max_object_loss=loss)\n   200\t    return row_axis, col_axis, _gen_positions(row_axis), _gen_positions(col_axis)\n   201\t\n   202\t\n   203\tdef _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts):\n   204\t    height = row_axis[-1]\n   205\t    width = col_axis[-1]\n   206\t    grid = np.full((height, width), bg, dtype=int)\n   207\t    rt, rb = row_axis[2], row_axis[3]\n   208\t    cl, cr = col_axis[2], col_axis[3]\n   209\t    grid[rt : height - rb, cl : width - cr] = frame\n   210\t\n   211\t    for r, slot_h in zip(row_starts, row_axis[0]):\n   212\t        for c, slot_w in zip(col_starts, col_axis[0]):\n   213\t            grid[r : r + slot_h, c : c + slot_w] = bg\n   214\t    return grid\n   215\t\n   216\t\n   217\tdef _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts):\n   218\t    for out_r, slot_r in enumerate(row_starts):\n   219\t        slot_h = row_axis[0][out_r]\n   220\t        for out_c, slot_c in enumerate(col_starts):\n   221\t            color = int(out[out_r, out_c])\n   222\t            if color == bg:\n   223\t                continue\n   224\t            slot_w = col_axis[0][out_c]\n   225\t            obj_h, obj_w = _gen_object_shape(slot_h, slot_w)\n   226\t            obj_r = random.randint(slot_r + OBJECT_MARGIN, slot_r + slot_h - obj_h - OBJECT_MARGIN)\n   227\t            obj_c = random.randint(slot_c + OBJECT_MARGIN, slot_c + slot_w - obj_w - OBJECT_MARGIN)\n   228\t            grid[obj_r : obj_r + obj_h, obj_c : obj_c + obj_w] = color\n   229\t\n   230\t\n   231\tdef _gen_is_valid(grid, out, bg, frame):\n   232\t    counts = np.bincount(grid.ravel(), minlength=N_COLORS)\n   233\t    if int(np.argmax(counts)) != bg:\n   234\t        return False\n   235\t    if counts[frame] <= max(counts[c] for c in range(N_COLORS) if c not in (bg, frame)):\n   236\t        return False\n   237\t    try:\n   238\t        actual = main(grid)\n   239\t    except Exception:\n   240\t        return False\n   241\t    return bool(np.array_equal(actual, out))\n   242\t\n   243\t\n   244\tdef _gen_attempt() -> np.ndarray | None:\n   245\t    rows = random.randint(*TABLE_ROWS_RANGE)\n   246\t    cols = random.randint(*TABLE_COLS_RANGE)\n   247\t    bg, frame = random.sample(range(N_COLORS), 2)\n   248\t\n   249\t    out, filled_count = _gen_assign_colors((rows, cols), bg, frame)\n   250\t    row_axis, col_axis, row_starts, col_starts = _gen_choose_layout(rows, cols, filled_count)\n   251\t    grid = _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts)\n   252\t    _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts)\n   253\t\n   254\t    if _gen_is_valid(grid, out, bg, frame):\n   255\t        return grid\n   256\t    return None\n   257\t\n   258\t\n   259\tdef generate_input() -> np.ndarray:\n   260\t    for _ in range(GEN_RETRY_LIMIT):\n","exit_code":0,"status":"completed"}}
