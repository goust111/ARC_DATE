: return (n-1-r,c)\n    if kind==6: return (c,r)\n    if kind==7: return (n-1-c,n-1-r)\n\ntemplates={\n 'unique': {(0,0),(0,1),(0,3),(1,2)},\n 'away': {(0,0),(0,1),(3,0),(4,1)},\n 'visited': {(1,3),(1,4),(2,2),(2,5),(3,6),(4,4),(4,6),(5,4)},\n}\nseed=(3,3)\nfor name,obs in templates.items():\n    print('template',name)\n    for k in range(8):\n        o={transform(p,k) for p in obs}\n        s=transform(seed,k)\n        print(k, s, sorted(o), sim(s,o))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
