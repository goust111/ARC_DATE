           visited.add(cur)\n            painted.add(cur)\n    # fill black comps bounded by painted or boundary and not obstacles\n    black={(r,c) for r in range(h) for c in range(w) if (r,c) not in painted and (r,c) not in obstacles}\n    seen=set()\n    fill=0\n    for cell in list(black):\n        if cell in seen: continue\n        comp=[]\n        q=[cell]; seen.add(cell)\n        ok=True\n        while q:\n            r,c=q.pop(); comp.append((r,c))\n            for dr,dc in CARD4:\n                nr,nc=r+dr,c+dc\n                if not (0<=nr<h and 0<=nc<w):\n                    continue\n                if (nr,nc) in obstacles:\n                    ok=False\n                    continue\n                if (nr,nc) in painted:\n                    continue\n                if (nr,nc) not in seen:\n                    seen.add((nr,nc)); q.append((nr,nc))\n        if ok:\n            fill+=len(comp)\n    stats['fill']=fill\n    return stats\n\nh=w=7\nseed=(3,3)\nall_cells=[(r,c) for r in range(h) for c in range(w) if (r,c)\"'!=seed]\n# bias to row/col cells first by searching combos size 5-7 from subset near seed\nsubset=[p for p in all_cells if abs(p[0]-seed[0])<=3 and abs(p[1]-seed[1])<=3]\nfound={k:None for k in ['\"'unique','away','visited']}\nfor k in range(4,8):\n    count=0\n    for obs in itertools.combinations(subset,k):\n        s=sim(h,w,seed,set(obs))\n        if s['amb']:\n            continue\n        if found['unique'] is None and s['unique']>=1 and s['away']==0 and s['visited']==0 and s['fill']>0:\n            found['unique']=(obs,s)\n            print('FOUND unique',obs,s)\n        if found['away'] is None and s['away']>=1 and s['fill']>0:\n            found['away']=(obs,s)\n            print('FOUND away',obs,s)\n        if found['visited'] is None and s['visited']>=1 and s['fill']>0:\n            found['visited']=(obs,s)\n            print('FOUND visited',obs,s)\n        if all(found.values()):\n            raise SystemExit\n        count+=1