{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"file='/home/lixinyu/snap/new/ARC_code/train/230f2e48.py'; rg -n '\"'^def (main|generate_input)'\"' \\\"\"'$file\"; nl -ba \"$file\" | sed -n '\"'1,260p'\"","aggregated_output":"18:def main(grid: np.ndarray) -> np.ndarray:\n327:def generate_input() -> np.ndarray:\n     1\tfrom __future__ import annotations\n     2\t\n     3\timport numpy as np\n     4\t\n     5\tfrom arc_utils import find_components, get_bg, in_bounds, neighbors4\n     6\timport random\n     7\t\n     8\t\n     9\tdef _line_color(g: np.ndarray, bg: int) -> int:\n    10\t    vals, counts = np.unique(g[g != int(bg)], return_counts=True)\n    11\t    assert vals.size == 3, \"expected one line color and two marker colors\"\n    12\t    max_count = int(counts.max())\n    13\t    winners = vals[counts == max_count]\n    14\t    assert winners.size == 1, \"line color must be uniquely most common\"\n    15\t    return int(winners[0])\n    16\t\n    17\t\n    18\tdef main(grid: np.ndarray) -> np.ndarray:\n    19\t    \"\"\"\n    20\t    Fold each straight red rod at its black marker, leaving the gray-anchored side fixed.\n    21\t\n    22\t    Input structure:\n    23\t    - The background is the dominant color.\n    24\t    - Each foreground object is a straight horizontal or vertical 4-connected rod.\n    25\t    - Each rod contains many pixels of one line color, one endpoint marker, and one\n    26\t      interior control marker.\n    27\t\n    28\t    Rule:\n    29\t    - For every rod, keep the segment from the endpoint marker through the control\n    30\t      marker unchanged.\n    31\t    - Move the line-color tail on the far side of the control marker to a\n    32\t      perpendicular ray starting next to that marker.\n    33\t    - Choose the perpendicular direction with more space to the grid edge.\n    34\t\n    35\t    Key insight:\n    36\t    - The endpoint marker identifies the fixed side of the rod, while the control\n    37\t      marker is the hinge; the tail folds into the larger open half-plane.\n    38\t    \"\"\"\n    39\t    g = np.asarray(grid, dtype=int)\n    40\t    H, W = g.shape\n    41\t    bg = get_bg(g)\n    42\t    line_color = _line_color(g, bg)\n    43\t\n    44\t    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    45\t    assert components, \"expected at least one marked rod\"\n    46\t\n    47\t    clear: list[tuple[int, int]] = []\n    48\t    paint: list[tuple[int, int]] = []\n    49\t\n    50\t    for comp in components:\n    51\t        coords = [tuple(map(int, coord)) for coord in comp[\"coords\"]]\n    52\t        coord_set = set(coords)\n    53\t        marker_coords = [p for p in coords if int(g[p]) != line_color]\n    54\t        assert len(marker_coords) == 2, \"each rod must have exactly two markers\"\n    55\t\n    56\t        degrees = {\n    57\t            p: sum((nr, nc) in coord_set for nr, nc in neighbors4(*p))\n    58\t            for p in marker_coords\n    59\t        }\n    60\t        endpoints = [p for p, degree in degrees.items() if int(degree) == 1]\n    61\t        hinges = [p for p, degree in degrees.items() if int(degree) == 2]\n    62\t        assert len(endpoints) == 1 and len(hinges) == 1, \"markers must be endpoint and hinge\"\n    63\t        endpoint = endpoints[0]\n    64\t        hinge = hinges[0]\n    65\t\n    66\t        rows = {r for r, _c in coords}\n    67\t        cols = {c for _r, c in coords}\n    68\t        assert len(rows) == 1 or len(cols) == 1, \"each object must be a straight rod\"\n    69\t\n    70\t        if len(rows) == 1:\n    71\t            assert endpoint[0] == hinge[0], \"horizontal rod markers must share a row\"\n    72\t            fixed_sign = int(np.sign(endpoint[1] - hinge[1]))\n    73\t            assert fixed_sign != 0, \"endpoint and hinge must be distinct\"\n    74\t            tail_step = (0, -fixed_sign)\n    75\t            up_space = int(hinge[0])\n    76\t            down_space = int(H - 1 - hinge[0])\n    77\t            assert up_space != down_space, \"perpendicular direction must be unique\"\n    78\t            fold_step = (-1, 0) if up_space > down_space else (1, 0)\n    79\t        else:\n    80\t            assert endpoint[1] == hinge[1], \"vertical rod markers must share a column\"\n    81\t            fixed_sign = int(np.sign(endpoint[0] - hinge[0]))\n    82\t            assert fixed_sign != 0, \"endpoint and hinge must be distinct\"\n    83\t            tail_step = (-fixed_sign, 0)\n    84\t            left_space = int(hinge[1])\n    85\t            right_space = int(W - 1 - hinge[1])\n    86\t            assert left_space != right_space, \"perpendicular direction must be unique\"\n    87\t            fold_step = (0, -1) if left_space > right_space else (0, 1)\n    88\t\n    89\t        tail: list[tuple[int, int]] = []\n    90\t        step = 1\n    91\t        while True:\n    92\t            p = (\n    93\t                int(hinge[0]) + int(tail_step[0]) * step,\n    94\t                int(hinge[1]) + int(tail_step[1]) * step,\n    95\t            )\n    96\t            if p not in coord_set:\n    97\t                break\n    98\t            assert int(g[p]) == line_color, \"tail must contain only line-color pixels\"\n    99\t            tail.append(p)\n   100\t            step += 1\n   101\t        assert tail, \"each hinge must have a moving tail\"\n   102\t\n   103\t        for step in range(1, len(tail) + 1):\n   104\t            p = (\n   105\t                int(hinge[0]) + int(fold_step[0]) * step,\n   106\t                int(hinge[1]) + int(fold_step[1]) * step,\n   107\t            )\n   108\t            assert in_bounds(g.shape, *p), \"folded tail must remain in bounds\"\n   109\t            paint.append(p)\n   110\t        clear.extend(tail)\n   111\t\n   112\t    assert len(set(clear)) == len(clear), \"moving tails must not overlap\"\n   113\t    assert len(set(paint)) == len(paint), \"folded tails must not collide\"\n   114\t    clear_set = set(clear)\n   115\t    for p in paint:\n   116\t        assert int(g[p]) == int(bg) or p in clear_set, \"fold target must be empty\"\n   117\t\n   118\t    out = g.copy()\n   119\t    for p in clear:\n   120\t        out[p] = bg\n   121\t    for p in paint:\n   122\t        out[p] = line_color\n   123\t    return out\n   124\t\n   125\t# --------------- generator (o5x) ---------------\n   126\t\n   127\t# ARC colors.\n   128\tBG, RED, HINGE, END = 7, 2, 0, 5\n   129\t\n   130\t# Canvas and rod-count sampling.\n   131\tGRID_SIZE_MIN, GRID_SIZE_MAX = 8, 16\n   132\tROD_COUNT_MIN, ROD_COUNT_MAX = 1, 7\n   133\tROD_DENSITY_DIVISOR = 28\n   134\t\n   135\t# Rod geometry sampling.\n   136\tHORIZONTAL, VERTICAL = \"h\", \"v\"\n   137\tORIENTATIONS = (HORIZONTAL, VERTICAL)\n   138\tFIXED_SIGNS = (-1, 1)\n   139\tROD_LEN_MIN, ROD_LEN_MAX = 3, 12\n   140\tFIXED_LEN_MIN, FIXED_LEN_MAX = 2, 9\n   141\tTAIL_LEN_MAX = 5\n   142\t\n   143\t# Placement and retry controls.\n   144\tGAP_DIRECTIONS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n   145\tMAX_GENERATE_ATTEMPTS = 300\n   146\t\n   147\tRecord = dict[str, object]\n   148\tRecordKey = tuple[int, int, int, str]\n   149\t\n   150\t_RECORD_CACHE: dict[int, list[tuple[RecordKey, Record]]] = {}\n   151\t\n   152\t\n   153\tdef _expanded(cells: set[tuple[int, int]], n: int) -> set[tuple[int, int]]:\n   154\t    out = set(cells)\n   155\t    shape = (n, n)\n   156\t    for r, c in cells:\n   157\t        for dr, dc in GAP_DIRECTIONS:\n   158\t            nr, nc = r + dr, c + dc\n   159\t            if in_bounds(shape, nr, nc):\n   160\t                out.add((nr, nc))\n   161\t    return out\n   162\t\n   163\t\n   164\tdef _fold_steps(n: int, orient: str, hinge: tuple[int, int], fixed_sign: int):\n   165\t    \"\"\"Return fixed-arm and fold steps, or None for a centered hinge.\"\"\"\n   166\t    r, c = hinge\n   167\t    if orient == HORIZONTAL:\n   168\t        up, down = r, n - 1 - r\n   169\t        if up == down:\n   170\t            return None\n   171\t        return (0, fixed_sign), ((-1, 0) if up > down else (1, 0))\n   172\t\n   173\t    left, right = c, n - 1 - c\n   174\t    if left == right:\n   175\t        return None\n   176\t    return (fixed_sign, 0), ((0, -1) if left > right else (0, 1))\n   177\t\n   178\t\n   179\tdef _ray_cells(origin: tuple[int, int], step: tuple[int, int], count: int) -> list[tuple[int, int]]:\n   180\t    r, c = origin\n   181\t    dr, dc = step\n   182\t    return [(r + dr * k, c + dc * k) for k in range(1, count + 1)]\n   183\t\n   184\t\n   185\tdef _record(n: int, orient: str, fixed_len: int, tail_len: int, hinge: tuple[int, int], fixed_sign: int):\n   186\t    steps = _fold_steps(n, orient, hinge, fixed_sign)\n   187\t    if steps is None:\n   188\t        return None\n   189\t\n   190\t    fixed_step, fold_step = steps\n   191\t    tail_step = (-fixed_step[0], -fixed_step[1])\n   192\t    fixed = _ray_cells(hinge, fixed_step, fixed_len - 1)\n   193\t    tail = _ray_cells(hinge, tail_step, tail_len)\n   194\t    folded = _ray_cells(hinge, fold_step, tail_len)\n   195\t\n   196\t    all_cells = fixed + tail + folded + [hinge]\n   197\t    shape = (n, n)\n   198\t    if any(not in_bounds(shape, rr, cc) for rr, cc in all_cells):\n   199\t        return None\n   200\t\n   201\t    endpoint = fixed[-1]\n   202\t    fixed_red = fixed[:-1]\n   203\t    input_cells = {hinge, endpoint, *fixed_red, *tail}\n   204\t    envelope = input_cells | set(folded)\n   205\t    if len(envelope) != len(input_cells) + len(folded):\n   206\t        return None\n   207\t\n   208\t    return {\n   209\t        \"hinge\": hinge,\n   210\t        \"endpoint\": endpoint,\n   211\t        \"fixed_red\": fixed_red,\n   212\t        \"tail\": tail,\n   213\t        \"folded\": folded,\n   214\t        \"envelope\": envelope,\n   215\t        \"red_count\": fixed_len + tail_len - 2,\n   216\t    }\n   217\t\n   218\t\n   219\tdef _all_records(n: int) -> list[tuple[RecordKey, Record]]:\n   220\t    if n in _RECORD_CACHE:\n   221\t        return _RECORD_CACHE[n]\n   222\t\n   223\t    records: list[tuple[RecordKey, Record]] = []\n   224\t    for orient in ORIENTATIONS:\n   225\t        for total_len in range(ROD_LEN_MIN, ROD_LEN_MAX + 1):\n   226\t            fixed_min = max(FIXED_LEN_MIN, total_len - TAIL_LEN_MAX)\n   227\t            fixed_max = min(FIXED_LEN_MAX, total_len - 1)\n   228\t            for fixed_len in range(fixed_min, fixed_max + 1):\n   229\t                tail_len = total_len - fixed_len\n   230\t                key = (total_len, fixed_len, tail_len, orient)\n   231\t                for r in range(n):\n   232\t                    for c in range(n):\n   233\t                        for fixed_sign in FIXED_SIGNS:\n   234\t                            rec = _record(n, orient, fixed_len, tail_len, (r, c), fixed_sign)\n   235\t                            if rec is not None:\n   236\t                                records.append((key, rec))\n   237\t    _RECORD_CACHE[n] = records\n   238\t    return records\n   239\t\n   240\t\n   241\tdef _choose_record(n: int, blocked: set[tuple[int, int]], rod_count: int, current_red: int, is_last: bool):\n   242\t    by_key: dict[RecordKey, list[Record]] = {}\n   243\t    for key, rec in _all_records(n):\n   244\t        total_len = key[0]\n   245\t        red_count = total_len - 2\n   246\t        if is_last and current_red + red_count <= rod_count:\n   247\t            continue\n   248\t        if rec[\"envelope\"] & blocked:\n   249\t            continue\n   250\t        by_key.setdefault(key, []).append(rec)\n   251\t\n   252\t    if not by_key:\n   253\t        return None\n   254\t\n   255\t    totals = sorted({key[0] for key in by_key})\n   256\t    total_len = random.choice(totals)\n   257\t    fixed_lengths = sorted({key[1] for key in by_key if key[0] == total_len})\n   258\t    fixed_len = random.choice(fixed_lengths)\n   259\t    orientations = sorted({key[3] for key in by_key if key[:2] == (total_len, fixed_len)})\n   260\t    orient = random.choice(orientations)\n","exit_code":0,"status":"completed"}}
