{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"file='/home/lixinyu/snap/new/ARC_code/train/689c358e.py'; rg -n '\"'^def (main|generate_input)'\"' \\\"\"'$file\"; nl -ba \"$file\" | sed -n '\"'1,280p'\"","aggregated_output":"71:def main(grid: np.ndarray) -> np.ndarray:\n208:def generate_input() -> np.ndarray:\n     1\tfrom __future__ import annotations\n     2\t\n     3\timport numpy as np\n     4\t\n     5\tfrom arc_utils import Color, colors_present, find_components, get_bg, paste\n     6\timport random\n     7\t\n     8\t\n     9\tdef _solid_frame_color(g: np.ndarray) -> int:\n    10\t    H, W = g.shape\n    11\t    assert H >= 3 and W >= 3, \"expected room for a frame and an interior\"\n    12\t\n    13\t    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    14\t    colors = set(map(int, border))\n    15\t    assert len(colors) == 1, \"expected a one-color rectangular frame\"\n    16\t    return int(colors.pop())\n    17\t\n    18\t\n    19\tdef _sprite_endpoints(g: np.ndarray, coords: np.ndarray) -> tuple[tuple[int, int], tuple[int, int]]:\n    20\t    H, W = g.shape\n    21\t    pts = [tuple(map(int, p)) for p in coords]\n    22\t\n    23\t    row_counts = {r: sum(1 for rr, _cc in pts if rr == r) for r in sorted({r for r, _c in pts})}\n    24\t    col_counts = {c: sum(1 for _rr, cc in pts if cc == c) for c in sorted({c for _r, c in pts})}\n    25\t\n    26\t    long_rows = [r for r, n in row_counts.items() if n == 4]\n    27\t    long_cols = [c for c, n in col_counts.items() if n == 4]\n    28\t    cross_rows = [r for r, n in row_counts.items() if n == 3]\n    29\t    cross_cols = [c for c, n in col_counts.items() if n == 3]\n    30\t\n    31\t    is_horizontal = len(long_rows) == 1 and len(cross_cols) == 1 and not long_cols and not cross_rows\n    32\t    is_vertical = len(long_cols) == 1 and len(cross_rows) == 1 and not long_rows and not cross_cols\n    33\t    assert is_horizontal ^ is_vertical, \"expected a six-pixel asymmetric T sprite\"\n    34\t\n    35\t    if is_horizontal:\n    36\t        r = int(long_rows[0])\n    37\t        cross_c = int(cross_cols[0])\n    38\t        line_cols = sorted(c for rr, c in pts if rr == r)\n    39\t        cross_rs = sorted(rr for rr, c in pts if c == cross_c)\n    40\t\n    41\t        assert line_cols == list(range(line_cols[0], line_cols[0] + 4)), \"expected a length-4 horizontal bar\"\n    42\t        assert cross_rs == [r - 1, r, r + 1], \"expected a centered length-3 crossbar\"\n    43\t        assert cross_c in line_cols, \"crossbar must intersect the long bar\"\n    44\t        assert 0 < r < H - 1, \"sprite axis must point to frame rows\"\n    45\t\n    46\t        left_dist = cross_c - line_cols[0]\n    47\t        right_dist = line_cols[-1] - cross_c\n    48\t        assert {left_dist, right_dist} == {1, 2}, \"crossbar must be one cell closer to one end\"\n    49\t        if left_dist < right_dist:\n    50\t            return (r, 0), (r, W - 1)\n    51\t        return (r, W - 1), (r, 0)\n    52\t\n    53\t    c = int(long_cols[0])\n    54\t    cross_r = int(cross_rows[0])\n    55\t    line_rows = sorted(r for r, cc in pts if cc == c)\n    56\t    cross_cs = sorted(cc for r, cc in pts if r == cross_r)\n    57\t\n    58\t    assert line_rows == list(range(line_rows[0], line_rows[0] + 4)), \"expected a length-4 vertical bar\"\n    59\t    assert cross_cs == [c - 1, c, c + 1], \"expected a centered length-3 crossbar\"\n    60\t    assert cross_r in line_rows, \"crossbar must intersect the long bar\"\n    61\t    assert 0 < c < W - 1, \"sprite axis must point to frame columns\"\n    62\t\n    63\t    up_dist = cross_r - line_rows[0]\n    64\t    down_dist = line_rows[-1] - cross_r\n    65\t    assert {up_dist, down_dist} == {1, 2}, \"crossbar must be one cell closer to one end\"\n    66\t    if up_dist < down_dist:\n    67\t        return (0, c), (H - 1, c)\n    68\t    return (H - 1, c), (0, c)\n    69\t\n    70\t\n    71\tdef main(grid: np.ndarray) -> np.ndarray:\n    72\t    \"\"\"\n    73\t    Mark each arrow-like sprite's pointed frame endpoint with its color and the opposite endpoint black.\n    74\t\n    75\t    Input structure:\n    76\t    - The grid has a one-pixel solid rectangular frame around a dominant interior background.\n    77\t    - Inside the frame are monochrome six-pixel sprites shaped as asymmetric T arrows.\n    78\t    - Each sprite has a length-4 bar and a length-3 crossbar one cell closer to the pointed end.\n    79\t\n    80\t    Rule:\n    81\t    - For each sprite, follow its bar axis from the shorter end to the frame.\n    82\t    - Paint that frame endpoint with the sprite color.\n    83\t    - Paint the opposite endpoint on the same row or column black.\n    84\t    - Leave the interior background, sprites, and all other frame pixels unchanged.\n    85\t\n    86\t    Key insight:\n    87\t    - The direction is encoded by the crossbar's off-center position: the nearer end is the pointing end.\n    88\t    \"\"\"\n    89\t    g = np.asarray(grid, dtype=int)\n    90\t    frame = _solid_frame_color(g)\n    91\t    bg = int(get_bg(g[1:-1, 1:-1]))\n    92\t    assert bg != frame, \"interior background must differ from the frame\"\n    93\t\n    94\t    sprite_colors = colors_present(g, exclude={bg, frame})\n    95\t    assert sprite_colors, \"expected at least one sprite\"\n    96\t    assert Color.BLACK not in set(sprite_colors) | {bg, frame}, \"black is reserved for opposite endpoints\"\n    97\t\n    98\t    components = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=sprite_colors)\n    99\t    assert len(components) == len(sprite_colors), \"expected one 4-connected object per sprite color\"\n   100\t\n   101\t    assignments: dict[tuple[int, int], int] = {}\n   102\t    for component in components:\n   103\t        assert int(component[\"area\"]) == 6, \"each sprite must have six pixels\"\n   104\t        color = int(component[\"color\"])\n   105\t        pointed, opposite = _sprite_endpoints(g, component[\"coords\"])\n   106\t\n   107\t        for coord, value in ((pointed, color), (opposite, Color.BLACK)):\n   108\t            assert int(g[coord]) == frame, \"sprite endpoints must land on frame pixels\"\n   109\t            assert coord not in assignments, \"frame endpoint assignments must not overlap\"\n   110\t            assignments[coord] = int(value)\n   111\t\n   112\t    out = g.copy()\n   113\t    for (r, c), value in assignments.items():\n   114\t        out[r, c] = value\n   115\t    return out\n   116\t\n   117\t# --------------- generator (att2) ---------------\n   118\t\n   119\t# Canvas and fixed colors.\n   120\tGRID_SIZE, FRAME_COLOR, BACKGROUND_COLOR = 11, 6, 7\n   121\tLAST = GRID_SIZE - 1\n   122\t\n   123\t# Sprite sampling and shape.\n   124\tSPRITE_COUNT, SPRITE_COLORS = 4, [1, 2, 3, 4, 5, 8, 9]\n   125\tORIENTATIONS, DIRECTIONS = (\"H\", \"V\"), {\"H\": (\"left\", \"right\"), \"V\": (\"up\", \"down\")}\n   126\tBAR_LENGTH, CROSSBAR_LENGTH = 4, 3\n   127\tCROSSBAR_MID, NEAR_END_OFFSET, FAR_END_OFFSET = 1, 1, 2\n   128\tTRANSPARENT = -1\n   129\t\n   130\t# Interior placement and retry bounds.\n   131\tAXIS_LINES, MAX_GENERATION_ATTEMPTS = range(2, 9), 300\n   132\tBAR_START_MIN, BAR_START_MAX = 1, 6\n   133\t\n   134\tdef _make_sprite(color: int, orientation: str, direction: str) -> np.ndarray:\n   135\t    \"\"\"Return one transparent-backed asymmetric T sprite patch.\"\"\"\n   136\t    patch = np.full((CROSSBAR_LENGTH, BAR_LENGTH) if orientation == \"H\" else (BAR_LENGTH, CROSSBAR_LENGTH), TRANSPARENT, dtype=int)\n   137\t    if orientation == \"H\":\n   138\t        offset = NEAR_END_OFFSET if direction == DIRECTIONS[\"H\"][0] else FAR_END_OFFSET\n   139\t        patch[CROSSBAR_MID, :] = color\n   140\t        patch[:, offset] = color\n   141\t    else:\n   142\t        offset = NEAR_END_OFFSET if direction == DIRECTIONS[\"V\"][0] else FAR_END_OFFSET\n   143\t        patch[:, CROSSBAR_MID] = color\n   144\t        patch[offset, :] = color\n   145\t    return patch\n   146\t\n   147\tdef _sample_plan():\n   148\t    \"\"\"Sample layout-independent choices in the original random order.\"\"\"\n   149\t    colors = random.sample(SPRITE_COLORS, SPRITE_COUNT)\n   150\t    orientations = [random.choice(ORIENTATIONS) for _ in range(SPRITE_COUNT)]\n   151\t    axes_by_orientation = {\n   152\t        orient: random.sample(AXIS_LINES, orientations.count(orient))\n   153\t        for orient in ORIENTATIONS\n   154\t    }\n   155\t    order = list(range(SPRITE_COUNT))\n   156\t    random.shuffle(order)\n   157\t    return colors, orientations, axes_by_orientation, order\n   158\t\n   159\tdef _try_place_sprite(grid, color, orientation, axis, placed_endpoints) -> bool:\n   160\t    \"\"\"Sample one sprite's direction/start and paste it if pixels/endpoints are free.\"\"\"\n   161\t    direction = random.choice(DIRECTIONS[orientation])\n   162\t    bar_start = random.randint(BAR_START_MIN, BAR_START_MAX)\n   163\t    if orientation == \"H\":\n   164\t        top, left = axis - CROSSBAR_MID, bar_start\n   165\t        near_frame, far_frame = (axis, 0), (axis, LAST)\n   166\t    else:\n   167\t        top, left = bar_start, axis - CROSSBAR_MID\n   168\t        near_frame, far_frame = (0, axis), (LAST, axis)\n   169\t    pointed_frame, opposite_frame = (near_frame, far_frame) if direction == DIRECTIONS[orientation][0] else (far_frame, near_frame)\n   170\t    if pointed_frame in placed_endpoints or opposite_frame in placed_endpoints:\n   171\t        return False\n   172\t\n   173\t    patch = _make_sprite(color, orientation, direction)\n   174\t    view = grid[top : top + patch.shape[0], left : left + patch.shape[1]]\n   175\t    mask = patch != TRANSPARENT\n   176\t    if view.shape != patch.shape or np.any(view[mask] != BACKGROUND_COLOR):\n   177\t        return False\n   178\t\n   179\t    paste(grid, patch, top, left, transparent=TRANSPARENT)\n   180\t    placed_endpoints[pointed_frame] = color\n   181\t    placed_endpoints[opposite_frame] = Color.BLACK\n   182\t    return True\n   183\t\n   184\tdef _matches_solver_oracle(grid, placed_endpoints) -> bool:\n   185\t    \"\"\"Check that the solver agrees with the recorded frame endpoint edits.\"\"\"\n   186\t    expected = grid.copy()\n   187\t    for coord, color in placed_endpoints.items():\n   188\t        expected[coord] = color\n   189\t    try:\n   190\t        return np.array_equal(main(grid), expected)\n   191\t    except Exception:\n   192\t        return False\n   193\t\n   194\tdef _gen_attempt() -> np.ndarray | None:\n   195\t    grid = np.full((GRID_SIZE, GRID_SIZE), BACKGROUND_COLOR, dtype=int)\n   196\t    grid[0, :] = grid[-1, :] = grid[:, 0] = grid[:, -1] = FRAME_COLOR\n   197\t    colors, orientations, axes_by_orientation, order = _sample_plan()\n   198\t    placed_endpoints: dict[tuple[int, int], int] = {}\n   199\t\n   200\t    for i in order:\n   201\t        orientation = orientations[i]\n   202\t        axis = axes_by_orientation[orientation].pop()\n   203\t        if not _try_place_sprite(grid, colors[i], orientation, axis, placed_endpoints):\n   204\t            return None\n   205\t\n   206\t    return grid if _matches_solver_oracle(grid, placed_endpoints) else None\n   207\t\n   208\tdef generate_input() -> np.ndarray:\n   209\t    for _ in range(MAX_GENERATION_ATTEMPTS):\n   210\t        grid = _gen_attempt()\n   211\t        if grid is not None:\n   212\t            return grid\n   213\t    raise RuntimeError(\"failed to generate a valid 689c358e input\")\n","exit_code":0,"status":"completed"}}
