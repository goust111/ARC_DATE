{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '21,120p;348,430p' /home/lixinyu/snap/new/ARC_code/train/305b1341.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Expand each sparse color object into a filled rectangular region using its legend-paired fill color.\n\n    Input structure\n    A background-color grid has a two-column legend in columns 0 and 1, starting at row 0: each row gives\n    a source color in the left column and that source color's fill color in the right column.  Outside the\n    legend, the foreground pixels are sparse dot objects whose colors are exactly the legend source colors.\n\n    Rule\n    Clear the legend.  For each source color, take the bbox of all of its non-legend dots, expand that bbox\n    by one pixel in every direction, and fill background cells inside the expanded rectangle with the paired\n    legend fill color while preserving every original non-legend dot.\n\n    Key insight\n    The legend order is also the layer order: earlier legend rows are in front, so fill rectangles are painted\n    from the last legend row back to the first and higher-priority fills overwrite lower-priority fills.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n    assert W >= 2, \"expected room for a two-column legend\"\n\n    pairs = _legend_pairs(g, bg)\n    source_colors = {source for source, _fill in pairs}\n    assert len(source_colors) == len(pairs), \"legend source colors must be unique\"\n\n    legend_mask = np.zeros(g.shape, dtype=bool)\n    legend_mask[: len(pairs), :2] = True\n    dot_mask = (g != bg) & ~legend_mask\n    assert dot_mask.any(), \"expected source dots outside the legend\"\n    assert set(map(int, g[dot_mask])).issubset(source_colors), \"outside dots must use legend source colors\"\n\n    dots_by_color: dict[int, np.ndarray] = {}\n    all_dots = np.zeros(g.shape, dtype=bool)\n    for source, _fill in pairs:\n        coords = np.argwhere(dot_mask & (g == source))\n        assert coords.size, \"each legend source color must appear outside the legend\"\n        dots_by_color[source] = coords\n        all_dots[coords[:, 0], coords[:, 1]] = True\n\n    out = np.full_like(g, bg)\n    for source, fill in reversed(pairs):\n        r0, c0, r1, c1 = bbox_coords(dots_by_color[source])\n        r0 = max(0, r0 - 1)\n        c0 = max(0, c0 - 1)\n        r1 = min(H - 1, r1 + 1)\n        c1 = min(W - 1, c1 + 1)\n\n        region = out[r0 : r1 + 1, c0 : c1 + 1]\n        background_inside_region = ~all_dots[r0 : r1 + 1, c0 : c1 + 1]\n        region[background_inside_region] = fill\n\n    out[all_dots] = g[all_dots]\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and legend geometry.\nGRID_HEIGHT, GRID_WIDTH = 20, 20\nBACKGROUND_COLOR = 0\nLEGEND_COLS = 2\nDOT_STRIDE, BBOX_PAD, NON_OVERLAP_GAP = 2, 1, 1\n\n# Legend palette sampling.\nCOLORS = tuple(range(1, 10))\nPAIR_COUNT_CHOICES = (2, 3)\nROTATED_SOURCE_FILL_PROB = 0.45\n\n# Dot-grid shape sampling.\nDOT_ROWS_MIN, DOT_ROWS_MAX = 2, 8\nDOT_COLS_MIN, DOT_COLS_MAX = 2, 5\n\n# Layout search.\nTHREE_PAIR_FORCED_OVERLAP_STEPS = (1, 2)\nMODE_OVERLAP, MODE_OVERLAP_ANY, MODE_SEPARATE, MODE_ANY = \"overlap\", \"overlap_any\", \"separate\", \"any\"\nPOST_FORCED_LAYOUT_MODES = (MODE_SEPARATE, MODE_OVERLAP_ANY, MODE_ANY)\nPOST_FORCED_LAYOUT_WEIGHTS = (3, 3, 1)\n\n# Generation retry budget.\nGENERATION_RETRIES = 300\n\n\ndef _origin_bbox(origin: tuple[int, int], dot_rows: int, dot_cols: int) -> tuple[int, int, int, int]:\n    r, c = origin\n    return (\n        r - BBOX_PAD,\n        c - BBOX_PAD,\n        r + DOT_STRIDE * (dot_rows - 1) + BBOX_PAD,\n        c + DOT_STRIDE * (dot_cols - 1) + BBOX_PAD,\n    )\n\n\ndef _hits_legend(box: tuple[int, int, int, int], n_pairs: int) -> bool:\n    r0, c0, r1, c1 = box\n    return r0 <= n_pairs - 1 and r1 >= 0 and c0 <= LEGEND_COLS - 1 and c1 >= 0\n\n\ndef _legal_origins(n_pairs: int, dot_rows: int, dot_cols: int) -> list[tuple[int, int]]:\n    origins: list[tuple[int, int]] = []\n    max_r = GRID_HEIGHT - 1 - BBOX_PAD - DOT_STRIDE * (dot_rows - 1)\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 305b1341 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '19,100p;184,250p' /home/lixinyu/snap/new/ARC_code/train/a834deea.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill each black 5x5 region's missing interior positions with a fixed 3x3 positional color legend.\n\n    Input structure\n    - The grid uses teal as the dominant background and black for one or more\n      5x5 regions.\n    - Each black region has a black one-pixel border and a 3x3 interior that\n      may already contain teal pixels.\n\n    Rule\n    - Overlay the legend 1 7 6 / 4 8 5 / 2 9 3 on the 3x3 interior of every\n      5x5 black region.\n    - Wherever an interior non-center legend position is still black, recolor it\n      to the corresponding legend color; leave existing teal pixels, the center,\n      and the black border unchanged.\n\n    Key insight\n    - The colored output pixels are not derived from the teal motif shape; they\n      are the fixed position labels for the missing cells of each 3x3 interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    assert bg == Color.TEAL\n    fg_colors = colors_present(g, exclude={bg})\n    assert fg_colors == [Color.BLACK]\n\n    out = g.copy()\n    components = find_components(\n        g,\n        bg=bg,\n        connectivity=8,\n        monochromatic=True,\n        colors=[Color.BLACK],\n    )\n    assert components\n\n    for component in components:\n        b = component[\"bbox\"]\n        assert bbox_h(b) == 5 and bbox_w(b) == 5\n        r0, c0, _r1, _c1 = b\n        patch = crop_bbox(g, b)\n        assert np.all((patch == Color.BLACK) | (patch == bg))\n        assert np.all(patch[[0, -1], :] == Color.BLACK)\n        assert np.all(patch[:, [0, -1]] == Color.BLACK)\n        assert np.any(patch[1:4, 1:4] == bg)\n\n        for rr in range(3):\n            for cc in range(3):\n                color = int(LEGEND[rr, cc])\n                if color == bg:\n                    continue\n                grid_r = int(r0) + rr + 1\n                grid_c = int(c0) + cc + 1\n                if g[grid_r, grid_c] == Color.BLACK:\n                    out[grid_r, grid_c] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and region geometry.\nMIN_GRID_SIZE, MAX_GRID_SIZE = 9, 16\nREGION_SIZE, INTERIOR_SIZE, REGION_GAP = 5, 3, 1\n\n# Region count and interior-hole sampling.\nMIN_REGIONS, MAX_REGIONS = 1, 4\nMIN_TEAL_INTERIOR, MAX_TEAL_INTERIOR = 1, 6\nMAX_AREA_PER_REGION = 48\n\n# Generation retry limit and colors.\nMAX_GENERATION_ATTEMPTS = 300\nGEN_BG, GEN_FG = Color.TEAL, Color.BLACK\nGEN_PATCH = np.full((REGION_SIZE, REGION_SIZE), GEN_FG, dtype=int)\nGEN_INTERIOR = [\n    (rr, cc) for rr in range(INTERIOR_SIZE) for cc in range(INTERIOR_SIZE)\n]\n\n\ndef _gen_dim_slots(length):\ndef generate_input():\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid a834deea input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '172,280p;502,590p' /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Predict the next panel in a framed sequence by continuing each scheduled colored interval.\n\n    Input structure\n    - The grid is made from three or more equal panels in one row or one column.\n    - The final input panel is the static target template; every earlier panel differs from it only by dynamic colors absent from the template.\n    - Each dynamic color appears in a regular temporal schedule across the earlier panels.\n\n    Rule\n    - Keep the final template panel as the output canvas.\n    - For every dynamic color whose schedule reaches the next panel, compare its last two appearances.\n    - Extrapolate each one-dimensional interval along the color's changing row or column axis and paint that predicted mask.\n\n    Key insight\n    - The task is not asking for the last visible panel, but for the next frame after the blank/template slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    panels, diff_colors = _split_panels(g)\n    template = panels[-1]\n    prior = panels[:-1]\n    next_time = len(prior)\n\n    predictions: list[tuple[int, np.ndarray]] = []\n    for color in diff_colors:\n        times = [i for i, panel in enumerate(prior) if np.any(panel == color)]\n        assert len(times) >= 2\n        gaps = [b - a for a, b in zip(times, times[1:])]\n        assert len(set(gaps)) == 1\n        period = gaps[0]\n        if next_time - times[-1] != period:\n            continue\n\n        previous = prior[times[-2]] == color\n        current = prior[times[-1]] == color\n        predictions.append((color, _extrapolate_mask(previous, current)))\n\n    assert predictions\n    occupied = np.zeros_like(template, dtype=bool)\n    for _color, mask in predictions:\n        assert not np.any(occupied & mask)\n        occupied |= mask\n\n    out = template.copy()\n    for color, mask in predictions:\n        out[mask] = color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, orientation, and color sampling.\nPANEL_SIZE_MIN, PANEL_SIZE_MAX = 5, 11\nPANEL_COUNT_CHOICES, ORIENTATION_CHOICES = (3, 5), (False, True)\nCOLOR_POOL, TOTAL_COLOR_CHOICES, MOTION_AXIS_CHOICES = range(10), (4, 5), (0, 1)\n\n# Template decoration density and symmetry.\nTEMPLATE_MIN_DECO_CELLS = 4\nTEMPLATE_DECO_MIN_RATIO, TEMPLATE_DECO_MAX_RATIO = 0.10, 0.30\n\n# Blob motif and growth bounds.\nBLOB_GROWTH_MIN, BLOB_GROWTH_MAX = 1, 4\nBLOB_MAX_INITIAL_CELLS, BLOB_MAX_COMPONENTS = 7, 2\nBLOB_MAX_LINE_COUNT, BLOB_MAX_WIDTH = 3, 3\nBLOB_DIRECTIONS = (-1, 1)\n\n# Dynamic-color schedules.\nSHORT_PRIOR_COUNT, MAX_DYNAMIC_COLORS = 2, 3\nSCHEDULE_ALWAYS_2 = {\"period\": 1, \"times\": [0, 1], \"scheduled\": True}\nSCHEDULE_ALWAYS_4 = {\"period\": 1, \"times\": [0, 1, 2, 3], \"scheduled\": True}\nSCHEDULE_EVEN_4 = {\"period\": 2, \"times\": [0, 2], \"scheduled\": True}\nSCHEDULE_FIRST3_4 = {\"period\": 1, \"times\": [0, 1, 2], \"scheduled\": False}\nSCHEDULE_ODD_4 = {\"period\": 2, \"times\": [1, 3], \"scheduled\": False}\nSCHEDULE_SECOND_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4)\nSCHEDULE_THIRD_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4, SCHEDULE_FIRST3_4, SCHEDULE_ODD_4)\n\n# Placement and retry limits.\nMASK_TRANSPARENT, PLACEMENT_BORDER = 0, 1\nGENERATION_RETRIES = 300\n\ndef _sym_orbits(h: int, w: int) -> list[list[tuple[int, int]]]:\n    seen: set[tuple[int, int]] = set()\n    orbits: list[list[tuple[int, int]]] = []\n    for r in range(h):\n        for c in range(w):\n            if r not in (0, h - 1) and c not in (0, w - 1):\n                continue\n            if (r, c) in seen:\n                continue\n            orbit = sorted({(r, c), (r, w - 1 - c), (h - 1 - r, c), (h - 1 - r, w - 1 - c)})\n            seen.update(orbit)\n            orbits.append(orbit)\n    return orbits\n\n\ndef _make_template(h: int, w: int, bg: int, deco: int) -> np.ndarray:\n    out = np.full((h, w), bg, dtype=int)\n    area = h * w\n    min_deco = max(TEMPLATE_MIN_DECO_CELLS, int(np.ceil(area * TEMPLATE_DECO_MIN_RATIO)))\n    max_deco = max(min_deco, int(np.floor(area * TEMPLATE_DECO_MAX_RATIO)))\n    target = random.randint(min_deco, max_deco)\n    orbits = _sym_orbits(h, w)\n    random.shuffle(orbits)\n    count = 0\n    for orbit in orbits:\n        if count >= target:\n            break\n        if count + len(orbit) > max_deco and count >= min_deco:\n            continue\n        for r, c in orbit:\n            out[r, c] = deco\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '32,120p;199,260p' /home/lixinyu/snap/new/ARC_code/train/18447a8d.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each right-side colored shape into the left slot whose template color is its exact complement.\n\n    Input structure:\n    - The grid has two equal-width slots separated by one background column.\n    - Non-background rows form horizontal bands separated by all-background rows.\n    - Each band has a shared template color in the left slot and one colored source shape in the right slot.\n\n    Rule:\n    - For each band, define its destination shape as the cells in the left slot not occupied by the template color.\n    - Normalize every right-side source shape to right-slot coordinates and match it to the unique equal destination shape.\n    - Clear the original right-side source pixels and paint the matched left-slot complement with the source color.\n\n    Key insight:\n    The right-side objects are not placed by row order; each one completes the unique left template whose missing cells have the same shape.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = int(get_bg(g))\n    assert w % 2 == 1, \"canvas must contain two equal slots plus one separator column\"\n    slot_w = w // 2\n    sep_c = slot_w\n\n    bands = _active_row_spans(g, bg)\n    assert bands, \"grid must contain at least one active band\"\n\n    band_color_sets: list[set[int]] = []\n    for r0, r1 in bands:\n        colors = set(map(int, g[r0 : r1 + 1].ravel())) - {bg}\n        assert colors, \"each active band must contain foreground colors\"\n        band_color_sets.append(colors)\n\n    shared_colors = set.intersection(*band_color_sets)\n    assert len(shared_colors) == 1, \"template color must be the only color shared by all bands\"\n    template_color = next(iter(shared_colors))\n\n    dest_shapes: list[CoordSet] = []\n    sources: list[tuple[int, CoordSet]] = []\n    for band_i, (r0, r1) in enumerate(bands):\n        block = g[r0 : r1 + 1]\n        assert np.all(block[:, sep_c] == bg), \"slot separator column must be background\"\n\n        left = block[:, :slot_w]\n        right = block[:, sep_c + 1 :]\n        assert np.all((left == bg) | (left == template_color)), \"left slot must contain only template and background\"\n\n        template_mask = left == template_color\n        for row in template_mask:\n            cols = np.flatnonzero(row)\n            assert cols.size > 0, \"each template row must contain at least one pixel\"\n            expected = np.arange(int(cols[-1]) + 1)\n            assert np.array_equal(cols, expected), \"template pixels must be a left-anchored row prefix\"\n\n        dest_shapes.append(_coords(~template_mask))\n\n        source_mask = right != bg\n        assert np.any(source_mask), f\"band {band_i} source shape must be non-empty\"\n        source_colors = set(map(int, right[source_mask].ravel()))\n        assert len(source_colors) == 1, \"each right slot must contain exactly one source color\"\n        source_color = next(iter(source_colors))\n        assert source_color != template_color, \"source color must differ from template color\"\n        source_shape = _coords(source_mask)\n        sources.append((source_color, source_shape))\n\n    out = g.copy()\n    for r0, r1 in bands:\n        right = out[r0 : r1 + 1, sep_c + 1 :]\n        right[right != bg] = bg\n\n    used_destinations: set[int] = set()\n    for source_color, source_shape in sources:\n        matches = [i for i, dest_shape in enumerate(dest_shapes) if dest_shape == source_shape]\n        assert len(matches) == 1, \"each source shape must match exactly one left-slot complement\"\n        dest_i = matches[0]\n        assert dest_i not in used_destinations, \"each destination complement must be filled once\"\n        used_destinations.add(dest_i)\n\n        dest_r0, _ = bands[dest_i]\n        for dr, dc in source_shape:\n            rr = dest_r0 + dr\n            assert out[rr, dc] == bg, \"matched complement cells must be empty before painting\"\n            out[rr, dc] = source_color\n\n    assert len(used_destinations) == len(bands), \"all destination complements must be filled\"\n    assert out.shape == (h, w)\n    return out\n\n# --------------- generator (o5x) ---------------\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '73,170p;356,430p' /home/lixinyu/snap/new/ARC_code/train/6165ea8f.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Build a color-labeled shape-equivalence table from the objects listed on the right edge.\n\n    Input structure:\n    - The background contains one main 4-connected object for each foreground color.\n    - The rightmost column has one singleton pixel of each foreground color, listed top-to-bottom.\n    - Those singleton pixels define the row and column order of the output table.\n\n    Rule:\n    - Normalize each main object to its tight mask and compare masks up to rotation or reflection.\n    - Draw 2x2 color labels across the top and down the left, separated by one background row/column.\n    - For each off-diagonal table cell, paint a 2x2 red block when the two labeled objects have the same shape under rotation/reflection, otherwise paint a 2x2 grey block.\n    - Leave diagonal cells and all separators as background.\n\n    Key insight:\n    - Object positions and original orientations are distractors; the relation is dihedral shape equivalence, while the right-edge legend fixes the table order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    order = _legend_order(g, bg)\n    signatures = {color: _shape_signature(_main_object_mask(g, bg, color)) for color in order}\n\n    n = len(order)\n    out = np.full((3 * n + 2, 3 * n + 2), int(bg), dtype=int)\n\n    for i, color in enumerate(order):\n        band = 3 + 3 * i\n        out[0:2, band : band + 2] = int(color)\n        out[band : band + 2, 0:2] = int(color)\n\n    for i, row_color in enumerate(order):\n        for j, col_color in enumerate(order):\n            if i == j:\n                continue\n            cell_color = Color.RED if signatures[row_color] == signatures[col_color] else Color.GREY\n            r = 3 + 3 * i\n            c = 3 + 3 * j\n            out[r : r + 2, c : c + 2] = int(cell_color)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and object bounds.\nGEN_OBJECT_COUNT_RANGE, GEN_GRID_ROW_RANGE, GEN_GRID_COL_RANGE = (4, 7), (20, 25), (20, 23)\nGEN_OBJECT_AREA_RANGE, GEN_OBJECT_BBOX_RANGE, GEN_OBJECT_MAX_EXTRA_CELLS = (5, 13), (2, 7), 4\n# Shape-class sampling.\nGEN_CLASS_OPTIONS, GEN_MAX_CLASS_SIZE, GEN_UNIQUE_MASK_RETRIES = (2, 3), 3, 80\nGEN_DIHEDRAL_FLIP_PROB = 0.5\n# Output table layout and colors.\nGEN_OBJECT_COLORS, GEN_TABLE_BLOCK, GEN_TABLE_STEP = [1, 3, 4, 6, 7, 8, 9], 2, 3\nGEN_SAME_SHAPE_COLOR, GEN_DIFFERENT_SHAPE_COLOR = int(Color.RED), int(Color.GREY)\n# Input placement and retry limits.\nGEN_RESERVED_RIGHT_COLS, GEN_ATTEMPTS = 2, 300\nGEN_PLACEMENT_BORDER, GEN_PLACEMENT_PADDING, GEN_PLACEMENT_CONNECTIVITY = 1, 2, 4\nGEN_NEIGHBORS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _gen_tight_mask(mask: np.ndarray) -> np.ndarray:\n    coords = np.argwhere(mask)\n    r0, c0, r1, c1 = bbox_coords(coords)\n    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)\n\n\ndef _gen_mask_key(mask: np.ndarray) -> tuple[str, ...]:\n    return tuple(\"\".join(\"1\" if cell else \"0\" for cell in row) for row in mask)\n\n\ndef _gen_shape_signature(mask: np.ndarray) -> tuple[str, ...]:\n    base = _gen_tight_mask(mask)\n    variants = []\n    for k in range(4):\n        rotated = np.rot90(base, k)\n        variants.append(_gen_mask_key(_gen_tight_mask(rotated)))\n        variants.append(_gen_mask_key(_gen_tight_mask(np.fliplr(rotated))))\n    return min(variants)\n\n\ndef _has_hole(mask: np.ndarray) -> bool:\n    bg = ~mask.astype(bool)\n    if not bool(bg.any()):\n        return False\n\n    H, W = bg.shape\n    seen = np.zeros_like(bg, dtype=bool)\n    stack: list[tuple[int, int]] = []\n    for r in range(H):\n        for c in (0, W - 1):\n            if bg[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                stack.append((r, c))\n    for c in range(W):\n        for r in (0, H - 1):\n            if bg[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                stack.append((r, c))\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 6165ea8f input\")\n","exit_code":0,"status":"completed"}}
