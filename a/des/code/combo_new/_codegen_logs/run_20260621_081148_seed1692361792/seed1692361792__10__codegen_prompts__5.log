{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '93,180p;336,430p' /home/lixinyu/snap/new/ARC_code/train/34cfa167.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.\n\n    Input structure:\n    - The background is the dominant color.\n    - Two same-color solid rectangular anchors of the same size sit on opposite\n      diagonal corners, with the first anchor above-left of the second.\n    - The upper-left anchor has two one-cell-thick vertical control bars to its\n      right and two one-cell-thick horizontal control bars below it.\n\n    Rule:\n    - Copy the anchor rectangle into the two missing corners of the implied\n      larger rectangle.\n    - Repeat the right-side control bars horizontally between the left and right\n      anchors, using their spacing as the period, and draw the outer top and\n      bottom borders in the first right-control color.\n    - Repeat the below-side control bars vertically between the top and bottom\n      anchors, using the same period, and draw the outer left and right borders\n      in the first below-control color.\n\n    Key insight: The small control bars are the first two ticks of two periodic\n    frame patterns; the diagonal anchor supplies the opposite corner and the\n    missing two anchor copies.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    source, dest, right_controls, below_controls = _find_structure(g, bg)\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    dr0, dc0, dr1, dc1 = dest[\"bbox\"]\n    anchor_color = int(source[\"color\"])\n    assert int(dest[\"color\"]) == anchor_color, \"anchor colors must match\"\n    assert bbox_h(source[\"bbox\"]) == bbox_h(dest[\"bbox\"]), \"anchor heights must match\"\n    assert bbox_w(source[\"bbox\"]) == bbox_w(dest[\"bbox\"]), \"anchor widths must match\"\n    assert sr0 > 0 and sc0 > 0, \"upper-left anchor must have space for outer frame\"\n    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \"lower-right anchor must have space for outer frame\"\n\n    right_offsets = [int(comp[\"bbox\"][1] - sc1) for comp in right_controls]\n    below_offsets = [int(comp[\"bbox\"][0] - sr1) for comp in below_controls]\n    assert right_offsets == below_offsets and right_offsets[0] == 1, \"control offsets must match from the anchor edge\"\n    step = int(right_offsets[1] - right_offsets[0])\n    assert step > 0, \"control bars must be separated\"\n    period = 2 * step\n    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, \"right frame must close next to the destination anchor\"\n    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, \"below frame must close next to the destination anchor\"\n\n    right_colors = [int(comp[\"color\"]) for comp in right_controls]\n    below_colors = [int(comp[\"color\"]) for comp in below_controls]\n    out = g.copy()\n\n    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)\n    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)\n\n    first_c = int(sc1 + right_offsets[0])\n    last_c = int(dc0 - 1)\n    for c in range(first_c, last_c + 1):\n        offset = int(c - sc1)\n        if (offset - right_offsets[0]) % period == 0:\n            color = right_colors[0]\n        elif (offset - right_offsets[1]) % period == 0:\n            color = right_colors[1]\n        else:\n            continue\n        _paint_rect(out, bg, sr0, c, sr1, c, color)\n        _paint_rect(out, bg, dr0, c, dr1, c, color)\n\n    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])\n    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])\n\n    first_r = int(sr1 + below_offsets[0])\n    last_r = int(dr0 - 1)\n    left_c = int(sc0 - 1)\n    right_c = int(dc1 + 1)\n    for r in range(first_r, last_r + 1):\n        _paint(out, bg, r, left_c, below_colors[0])\n        _paint(out, bg, r, right_c, below_colors[0])\n\n        offset = int(r - sr1)\n        if (offset - below_offsets[0]) % period == 0:\n            _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])\n            _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])\n        elif (offset - below_offsets[1]) % period == 0:\n            _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])\n            _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])\n\n    return out\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '13,110p;205,290p' /home/lixinyu/snap/new/ARC_code/train/48634b99.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Advance the marker from one half of a vertical bar to the same half of the next longer bar.\n\n    Input structure\n    - The grid has one dominant background color and exactly two foreground colors.\n    - One foreground color forms many vertical one-cell-wide bars; the other appears as a single vertical marker segment.\n    - The marker segment occupies exactly the top or bottom half of its containing vertical bar.\n    Rule\n    - Recolor the current marker segment back to the bar color.\n    - Find the unique all-bar-color vertical bar whose height is two pixels greater than the marked source bar.\n    - Recolor the same half of that next longer bar to the marker color.\n    Key insight\n    - Each bar's total height encodes an ordered size, and the marker advances from a 2k bar to the corresponding 2(k+1) bar while preserving whether it marks the top or bottom half.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = int(get_bg(g))\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, f\"expected exactly two foreground colors, got {colors}\"\n\n    mono_component_counts = {\n        int(color): len(\n            find_components(\n                g,\n                bg=bg,\n                colors=[int(color)],\n                connectivity=4,\n                monochromatic=True,\n            )\n        )\n        for color in colors\n    }\n    marker_colors = [color for color, count in mono_component_counts.items() if count == 1]\n    assert len(marker_colors) == 1, f\"expected one single-component marker color, got {mono_component_counts}\"\n    marker_color = int(marker_colors[0])\n\n    bar_colors = [int(color) for color in colors if int(color) != marker_color]\n    assert len(bar_colors) == 1\n    bar_color = int(bar_colors[0])\n\n    marker_components = find_components(\n        g,\n        bg=bg,\n        colors=[marker_color],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert len(marker_components) == 1\n    marker = marker_components[0]\n    marker_area = int(marker[\"area\"])\n    mr0, mc0, mr1, _mc1 = marker[\"bbox\"]\n    assert _is_solid_vertical_bar(marker)\n\n    bars = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    source_bars = [\n        bar\n        for bar in bars\n        if np.any(g[bar[\"coords\"][:, 0], bar[\"coords\"][:, 1]] == marker_color)\n    ]\n    assert len(source_bars) == 1, f\"expected one bar containing the marker, got {len(source_bars)}\"\n    source = source_bars[0]\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    source_h = bbox_h(source[\"bbox\"])\n    assert _is_solid_vertical_bar(source)\n    assert source_h == 2 * marker_area\n    assert mc0 == sc0 == sc1\n\n    if mr0 == sr0 and mr1 == sr0 + marker_area - 1:\n        marked_end = \"top\"\n    elif mr1 == sr1 and mr0 == sr1 - marker_area + 1:\n        marked_end = \"bottom\"\n    else:\n        raise AssertionError(f\"marker is not exactly one end-half: marker={marker['bbox']} source={source['bbox']}\")\n\n    target_h = source_h + 2\n    target_bars = []\n    for bar in bars:\n        values = g[bar[\"coords\"][:, 0], bar[\"coords\"][:, 1]]\n        if set(map(int, values)) != {bar_color}:\n            continue\n        if not _is_solid_vertical_bar(bar):\n            continue\n        if bbox_h(bar[\"bbox\"]) == target_h:\n            target_bars.append(bar)\n\n    assert len(target_bars) == 1, f\"expected one next-longer target bar, got {[bar['bbox'] for bar in target_bars]}\"\n    target = target_bars[0]\n    tr0, tc0, tr1, _tc1 = target[\"bbox\"]\n    target_half = target_h // 2\n\n    out = g.copy()\n    out[g == marker_color] = bar_color\n    if marked_end == \"top\":\n        out[tr0 : tr0 + target_half, tc0] = marker_color\n    else:\n        out[tr1 - target_half + 1 : tr1 + 1, tc0] = marker_color\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 48634b99 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '158,245p;299,390p' /home/lixinyu/snap/new/ARC_code/train/7e576d6e.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Draw the marker-colored route through the centers of all doors in the parallel wall maze.\n\n    Input structure:\n    - The grid has a background, parallel full-span walls, one three-pixel door\n      segment in each wall, and two marker pixels sharing a color.\n    - Walls are either all vertical or all horizontal, and the markers are on\n      opposite outer sides of the wall set.\n\n    Rule:\n    - Keep the scene unchanged except for the route.\n    - Visit the door centers in wall order from the upper/left marker side to\n      the lower/right marker side.\n    - In each corridor, draw an orthogonal path to the cell just before the next\n      wall, move along that wall to the door center, cross the center, and\n      continue to the next corridor; after the last door, connect to the other\n      marker.\n\n    Key insight:\n    - The three-pixel door segments mark the only crossing points through a set\n      of parallel walls, so the output is the corridor path threaded through\n      those centers.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg, path_color, door_color, wall_color = _roles(g)\n    orientation, centers = _door_centers(g, door_color)\n    markers = _markers(g, path_color)\n\n    if orientation == \"vertical\":\n        return _solve_vertical_walls(g, centers, markers, bg, path_color, door_color, wall_color)\n    assert orientation == \"horizontal\"\n    return _solve_horizontal_walls(g, centers, markers, bg, path_color, door_color, wall_color)\n\n# --------------- generator (att1) ---------------\n\n# Canvas and color role sampling.\nGRID_H = 30\nGRID_W = 30\nCOLOR_POOL = range(10)\nN_ROLE_COLORS = 4\n\n# Parallel wall and door geometry.\nORIENTATIONS = (\"vertical\", \"horizo