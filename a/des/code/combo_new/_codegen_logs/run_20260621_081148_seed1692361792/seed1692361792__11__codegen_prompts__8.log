{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/eval/247ef758.py | sed -n '1,380p'\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\tfrom collections import defaultdict\n     3\timport numpy as np\n     4\tfrom arc_utils import get_bg, label_mask\n     5\t\n     6\t\n     7\tdef largest_enclosed_component_bbox(mask: np.ndarray, *, connectivity: int = 4) -> tuple[int, int, int, int] | None:\n     8\t    \"\"\"\n     9\t    Local helper (only used by this solver): bbox of largest connected component in `mask`\n    10\t    that does NOT touch the grid border.\n    11\t    \"\"\"\n    12\t    H, W = mask.shape\n    13\t    best_area = -1\n    14\t    best_bbox: tuple[int, int, int, int] | None = None\n    15\t\n    16\t    lab, n = label_mask(mask.astype(bool), connectivity=int(connectivity))\n    17\t    for k in range(1, int(n) + 1):\n    18\t        coords = np.argwhere(lab == int(k))\n    19\t        if coords.size == 0:\n    20\t            continue\n    21\t        rs = coords[:, 0]\n    22\t        cs = coords[:, 1]\n    23\t        if bool((rs == 0).any() or (rs == int(H - 1)).any() or (cs == 0).any() or (cs == int(W - 1)).any()):\n    24\t            continue\n    25\t        area = int(coords.shape[0])\n    26\t        if area > best_area:\n    27\t            best_area = area\n    28\t            r0, c0 = coords.min(axis=0)\n    29\t            r1, c1 = coords.max(axis=0)\n    30\t            best_bbox = (int(r0), int(c0), int(r1), int(c1))\n    31\t\n    32\t    return best_bbox\n    33\t\n    34\tdef main(grid: np.ndarray) -> np.ndarray:\n    35\t    \"\"\"\n    36\t    Move colored sprites from the left strip into a framed area at marker-defined targets.\n    37\t\n    38\t    Input structure:\n    39\t    - bg background; rectangular frame on right with colored markers on its edges; sprites in a narrow left strip separated by a constant-color divider column.\n    40\t\n    41\t    Rule:\n    42\t    - For each color, target rows/cols are where both opposite frame edges share that color. Targets are the Cartesian product.\n    43\t    - Erase each sprite from the left and stamp it centered at every target. Higher sprites cover lower ones.\n    44\t\n    45\t    Key insight: One sprite replicates to a grid of row × column marker intersections.\n    46\t    \"\"\"\n    47\t    g = np.array(grid, dtype=int)\n    48\t    H, W = g.shape\n    49\t    bg = int(get_bg(g))\n    50\t\n    51\t    # --- frame interior: largest bg component not touching boundary ---\n    52\t    inner_bbox = largest_enclosed_component_bbox(g == int(bg), connectivity=4)\n    53\t    assert not (inner_bbox is None)\n    54\t    ir0, ic0, ir1, ic1 = map(int, inner_bbox)\n    55\t    fr0, fc0, fr1, fc1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)\n    56\t\n    57\t    # --- divider columns (fixed) on the left side ---\n    58\t    divider_mask = np.zeros((H, W), dtype=bool)\n    59\t    for c in range(0, max(0, int(fc0))):\n    60\t        colv = g[:, int(c)]\n    61\t        non = colv[colv != int(bg)]\n    62\t        if int(len(non)) >= int(H - 1) and len(set(map(int, non))) == 1:\n    63\t            divider_mask[:, int(c)] = True\n    64\t\n    65\t    left_cols = (np.arange(W)[None, :] < int(fc0))\n    66\t\n    67\t    # --- sprites: per-color 8-connected components in left area (excluding divider) ---\n    68\t    sprites = []\n    69\t    for col in sorted(set(map(int, g.flatten())) - {int(bg)}):\n    70\t        mask = (g == int(col)) & left_cols & (~divider_mask)\n    71\t        if not bool(mask.any()):\n    72\t            continue\n    73\t        slab, sn = label_mask(mask, connectivity=8)\n    74\t        for sid in range(1, int(sn) + 1):\n    75\t            pts = np.argwhere(slab == int(sid))\n    76\t            r0, c0 = pts.min(axis=0)\n    77\t            r1, c1 = pts.max(axis=0)\n    78\t            r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n    79\t            m = slab[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(sid)\n    80\t            sprites.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"r1\": int(r1), \"c1\": int(c1), \"mask\": m})\n    81\t\n    82\t    move_colors = {int(s[\"color\"]) for s in sprites}\n    83\t\n    84\t    # --- marker-derived targets (restricted to colors that actually appear as sprites) ---\n    85\t    row_marks: dict[int, list[int]] = defaultdict(list)\n    86\t    col_marks: dict[int, list[int]] = defaultdict(list)\n    87\t    for r in range(int(ir0), int(ir1) + 1):\n    88\t        cl = int(g[int(r), int(fc0)])\n    89\t        cr = int(g[int(r), int(fc1)])\n    90\t        if cl == cr and cl != int(bg) and cl in move_colors:\n    91\t            row_marks[int(cl)].append(int(r))\n    92\t    for c in range(int(ic0), int(ic1) + 1):\n    93\t        ct = int(g[int(fr0), int(c)])\n    94\t        cb = int(g[int(fr1), int(c)])\n    95\t        if ct == cb and ct != int(bg) and ct in move_colors:\n    96\t            col_marks[int(ct)].append(int(c))\n    97\t\n    98\t    targets: dict[int, list[tuple[int, int]]] = {}\n    99\t    for col in set(row_marks.keys()) & set(col_marks.keys()):\n   100\t        pts = {(int(r), int(c)) for r in row_marks[int(col)] for c in col_marks[int(col)]}\n   101\t        targets[int(col)] = sorted(pts)\n   102\t\n   103\t    out = g.copy()\n   104\t    movers = [s for s in sprites if int(s[\"color\"]) in targets]\n   105\t\n   106\t    # Erase originals of moved sprites.\n   107\t    for s in movers:\n   108\t        r0, c0 = int(s[\"r0\"]), int(s[\"c0\"])\n   109\t        for rr, cc in np.argwhere(s[\"mask\"]):\n   110\t            out[int(r0) + int(rr), int(c0) + int(cc)] = int(bg)\n   111\t\n   112\t    # Bottom-to-top ordering: lower sprites first, upper sprites last (covering).\n   113\t    movers.sort(key=lambda s: (-((int(s[\"r0\"]) + int(s[\"r1\"])) / 2.0), int(s[\"c0\"])))\n   114\t\n   115\t    for s in movers:\n   116\t        col = int(s[\"color\"])\n   117\t        cr = (int(s[\"r0\"]) + int(s[\"r1\"])) // 2\n   118\t        cc = (int(s[\"c0\"]) + int(s[\"c1\"])) // 2\n   119\t        pix = [(int(s[\"r0\"]) + int(rr), int(s[\"c0\"]) + int(cc2)) for rr, cc2 in np.argwhere(s[\"mask\"])]\n   120\t\n   121\t        for tr, tc in targets[int(col)]:\n   122\t            dr = int(tr - cr)\n   123\t            dc = int(tc - cc)\n   124\t            for r, c in pix:\n   125\t                rr = int(r + dr)\n   126\t                cc3 = int(c + dc)\n   127\t                if int(ir0) <= rr <= int(ir1) and int(ic0) <= cc3 <= int(ic1):\n   128\t                    out[rr, cc3] = int(col)\n   129\t\n   130\t    return out\n   131\t\n   132\t\n   133\t# ---------------------------------------------------------------------------\n   134\t# generate_input\n   135\t# ---------------------------------------------------------------------------\n   136\timport random\n   137\t\n   138\t\n   139\tdef _pick_spaced(candidates: list[int], n: int, min_spacing: int) -> list[int] | None:\n   140\t    \"\"\"Pick up to n values from candidates with at least min_spacing between any two.\"\"\"\n   141\t    if not candidates:\n   142\t        return None\n   143\t    if n == 1:\n   144\t        return [random.choice(candidates)]\n   145\t    random.shuffle(candidates)\n   146\t    picked: list[int] = []\n   147\t    for v in candidates:\n   148\t        if all(abs(v - p) >= min_spacing for p in picked):\n   149\t            picked.append(v)\n   150\t            if len(picked) == n:\n   151\t                return picked\n   152\t    return picked if picked else None\n   153\t\n   154\t\n   155\tdef _make_sprite(color: int, max_h: int, max_w: int) -> np.ndarray | None:\n   156\t    \"\"\"Generate a single-color 8-connected sprite cropped to its bounding box.\"\"\"\n   157\t    sh = min(random.choice([3, 3, 3, 4, 5]), max_h)\n   158\t    sw = min(random.choice([3, 3, 3, 4, 5]), max_w)\n   159\t    if sh < 1 or sw < 1:\n   160\t        return None\n   161\t    n_pixels = random.randint(3, min(9, sh * sw))\n   162\t    pixels = {(sh // 2, sw // 2)}\n   163\t    r, c = sh // 2, sw // 2\n   164\t    for _ in range(n_pixels * 30):\n   165\t        if len(pixels) >= n_pixels:\n   166\t            break\n   167\t        dr, dc = random.choice([(0, 1), (0, -1), (1, 0), (-1, 0),\n   168\t                                 (1, 1), (1, -1), (-1, 1), (-1, -1)])\n   169\t        nr, nc = r + dr, c + dc\n   170\t        if 0 <= nr < sh and 0 <= nc < sw:\n   171\t            pixels.add((nr, nc))\n   172\t            r, c = nr, nc\n   173\t    rows = [p[0] for p in pixels]\n   174\t    cols = [p[1] for p in pixels]\n   175\t    min_r, max_r = min(rows), max(rows)\n   176\t    min_c, max_c = min(cols), max(cols)\n   177\t    sprite = np.zeros((max_r - min_r + 1, max_c - min_c + 1), dtype=int)\n   178\t    for pr, pc in pixels:\n   179\t        sprite[pr - min_r, pc - min_c] = color\n   180\t    return sprite\n   181\t\n   182\t\n   183\tdef _gen_attempt() -> np.ndarray | None:\n   184\t    bg = 0\n   185\t\n   186\t    # Dimensions — frame spans full grid height\n   187\t    interior_h = random.randint(8, 13)\n   188\t    interior_w = random.randint(8, 13)\n   189\t    H = interior_h + 2\n   190\t    if not 10 <= H <= 15:\n   191\t        return None\n   192\t    sprite_area_w = random.randint(3, 5)\n   193\t    frame_w = interior_w + 2\n   194\t    W = sprite_area_w + 1 + frame_w\n   195\t    if not 14 <= W <= 20:\n   196\t        return None\n   197\t\n   198\t    # Key positions\n   199\t    div_col = sprite_area_w\n   200\t    fc0, fc1 = sprite_area_w + 1, W - 1\n   201\t    ir0, ic0 = 1, fc0 + 1\n   202\t    ir1, ic1 = H - 2, fc1 - 1\n   203\t\n   204\t    # Assign distinct colors\n   205\t    all_colors = list(range(1, 10))\n   206\t    random.shuffle(all_colors)\n   207\t    n_movers = random.randint(2, 3)\n   208\t    n_distractors = random.choice([0, 0, 1])\n   209\t    idx = 0\n   210\t    divider_color = all_colors[idx]; idx += 1\n   211\t    frame_base = all_colors[idx]; idx += 1\n   212\t    mover_colors = all_colors[idx:idx + n_movers]; idx += n_movers\n   213\t    distractor_colors = all_colors[idx:idx + n_distractors]; idx += n_distractors\n   214\t\n   215\t    # Generate mover sprites\n   216\t    sprites: list[np.ndarray] = []\n   217\t    for mc in mover_colors:\n   218\t        s = _make_sprite(mc, 5, sprite_area_w)\n   219\t        if s is None:\n   220\t            return None\n   221\t        sprites.append(s)\n   222\t\n   223\t    # Pick marker positions per mover (no two movers share a row or col marker)\n   224\t    mover_targets: dict[int, tuple[list[int], list[int]]] = {}\n   225\t    occupied_rows: set[int] = set()\n   226\t    occupied_cols: set[int] = set()\n   227\t    for mc, sp in zip(mover_colors, sprites):\n   228\t        sh, sw = sp.shape\n   229\t        min_row = ir0 + sh // 2\n   230\t        max_row = ir1 - (sh - 1 - sh // 2)\n   231\t        min_col = ic0 + sw // 2\n   232\t        max_col = ic1 - (sw - 1 - sw // 2)\n   233\t        if min_row > max_row or min_col > max_col:\n   234\t            return None\n   235\t        avail_rows = [r for r in range(min_row, max_row + 1) if r not in occupied_rows]\n   236\t        row_marks = _pick_spaced(avail_rows, random.randint(1, 2), sh)\n   237\t        if not row_marks:\n   238\t            return None\n   239\t        avail_cols = [c for c in range(min_col, max_col + 1) if c not in occupied_cols]\n   240\t        col_marks = _pick_spaced(avail_cols, random.randint(1, 2), sw)\n   241\t        if not col_marks:\n   242\t            return None\n   243\t        mover_targets[mc] = (sorted(row_marks), sorted(col_marks))\n   244\t        occupied_rows.update(row_marks)\n   245\t        occupied_cols.update(col_marks)\n   246\t\n   247\t    # Build input grid: bg fill, then divider, frame, sprites\n   248\t    inp = np.full((H, W), bg, dtype=int)\n   249\t    inp[:, div_col] = divider_color\n   250\t\n   251\t    # Frame top/bottom edges (mirrored)\n   252\t    top_edge = np.full(frame_w, frame_base, dtype=int)\n   253\t    for mc, (_, cmarks) in mover_targets.items():\n   254\t        for cc in cmarks:\n   255\t            top_edge[cc - fc0] = mc\n   256\t    inp[0, fc0:fc0 + frame_w] = top_edge\n   257\t    inp[H - 1, fc0:fc0 + frame_w] = top_edge\n   258\t\n   259\t    # Frame left/right edges (mirrored)\n   260\t    for r in range(1, H - 1):\n   261\t        val = frame_base\n   262\t        for mc, (rmarks, _) in mover_targets.items():\n   263\t            if r in rmarks:\n   264\t                val = mc\n   265\t                break\n   266\t        inp[r, fc0] = val\n   267\t        inp[r, fc1] = val\n   268\t\n   269\t    # Stack sprites in left strip: movers top-to-bottom, then distractors\n   270\t    cur_row = 0\n   271\t    all_items: list[tuple[int, np.ndarray, bool]] = [\n   272\t        (mc, sp, False) for mc, sp in zip(mover_colors, sprites)\n   273\t    ]\n   274\t    for dc_color in distractor_colors:\n   275\t        ds = _make_sprite(dc_color, min(5, H - cur_row), sprite_area_w)\n   276\t        if ds is None:\n   277\t            return None\n   278\t        all_items.append((dc_color, ds, True))\n   279\t\n   280\t    for mc, sp, _ in all_items:\n   281\t        sh, sw = sp.shape\n   282\t        if sw > sprite_area_w or cur_row + sh > H:\n   283\t            return None\n   284\t        c_off = random.randint(0, sprite_area_w - sw)\n   285\t        for dr in range(sh):\n   286\t            for dc in range(sw):\n   287\t                if sp[dr, dc] != bg:\n   288\t                    inp[cur_row + dr, c_off + dc] = sp[dr, dc]\n   289\t        cur_row += sh\n   290\t\n   291\t    # Validate: bg must be most common color so solver detects it correctly\n   292\t    vals, counts = np.unique(inp, return_counts=True)\n   293\t    if int(vals[np.argmax(counts)]) != bg:\n   294\t        return None\n   295\t\n   296\t    # Run solver and verify output differs from input (movers actually moved)\n   297\t    try:\n   298\t        output = main(inp)\n   299\t    except Exception:\n   300\t        return None\n   301\t    if np.array_equal(inp, output):\n   302\t        return None\n   303\t    return inp\n   304\t\n   305\t\n   306\tdef generate_input() -> np.ndarray:\n   307\t    for _ in range(300):\n   308\t        result = _gen_attempt()\n   309\t        if result is not None:\n   310\t            return result\n   311\t    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n","exit_code":0,"status":"completed"}}
