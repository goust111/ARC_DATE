{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/eval/b5ca7ac4.py | sed -n '1,360p'\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\timport numpy as np\n     3\tfrom arc_utils import crop_bbox, get_bg, paste\n     4\timport random\n     5\t\n     6\tdef main(grid: np.ndarray) -> np.ndarray:\n     7\t    \"\"\"\n     8\t    Move bordered 5×5 squares to their designated grid edges by border color.\n     9\t\n    10\t    Input structure:\n    11\t    - bg = most common color.\n    12\t    - Azure (8) and red (2) bordered 5×5 squares with colored interiors, scattered across the grid.\n    13\t\n    14\t    Rule:\n    15\t    - Azure squares → left edge (col 0); red squares → right edge (col W−5).\n    16\t    - Each square keeps its original row.\n    17\t    - Process azure left-to-right, red right-to-left (nearest-to-edge first).\n    18\t    - If a square's rows overlap an already-placed edge square, place it one square-width inward instead.\n    19\t\n    20\t    Key insight: Near-edge-first ordering plus row-overlap determines which square sits at the edge vs. the second column.\n    21\t    \"\"\"\n    22\t    g = np.array(grid, dtype=int)\n    23\t    H, W = g.shape\n    24\t    bg = int(get_bg(g))\n    25\t\n    26\t    out = np.full_like(g, bg)\n    27\t\n    28\t    SQUARE_SIZE = 5\n    29\t    def overlaps(a0: int, a1: int, b0: int, b1: int) -> bool:\n    30\t        return not (int(a1) < int(b0) or int(b1) < int(a0))\n    31\t\n    32\t    # Detect bordered squares by scanning 5x5 windows. This is robust even if frame-color pixels\n    33\t    # are connected between squares in the input.\n    34\t    squares = []\n    35\t    for r0 in range(H - SQUARE_SIZE + 1):\n    36\t        for c0 in range(W - SQUARE_SIZE + 1):\n    37\t            patch = crop_bbox(g, (int(r0), int(c0), int(r0 + SQUARE_SIZE - 1), int(c0 + SQUARE_SIZE - 1)))\n    38\t\n    39\t            border = np.concatenate([patch[0, :], patch[-1, :], patch[1:-1, 0], patch[1:-1, -1]])\n    40\t            if int(border.min()) != int(border.max()):\n    41\t                continue\n    42\t            frame_col = int(border[0])\n    43\t            if frame_col not in {2, 8}:\n    44\t                continue\n    45\t\n    46\t            inner = patch[1:-1, 1:-1]\n    47\t            if not bool((inner != int(frame_col)).any()):\n    48\t                continue\n    49\t\n    50\t            squares.append({\"frame\": int(frame_col), \"r0\": int(r0), \"c0\": int(c0), \"patch\": patch})\n    51\t\n    52\t    # Azure squares: sort by original column ascending (leftmost first).\n    53\t    azure_squares = sorted([s for s in squares if int(s[\"frame\"]) == 8], key=lambda s: int(s[\"c0\"]))\n    54\t    placed_at_default: list[tuple[int, int]] = []\n    55\t    for s in azure_squares:\n    56\t        r0 = int(s[\"r0\"])\n    57\t        r1 = int(r0 + SQUARE_SIZE - 1)\n    58\t        has_overlap = any(overlaps(r0, r1, pr0, pr1) for pr0, pr1 in placed_at_default)\n    59\t        dest_c = int(SQUARE_SIZE) if has_overlap else 0\n    60\t        paste(out, s[\"patch\"], r0, dest_c, transparent=bg)\n    61\t        if dest_c == 0:\n    62\t            placed_at_default.append((r0, r1))\n    63\t\n    64\t    # Red squares: sort by original column descending (rightmost first).\n    65\t    red_squares = sorted([s for s in squares if int(s[\"frame\"]) == 2], key=lambda s: -int(s[\"c0\"]))\n    66\t    placed_at_default = []\n    67\t    for s in red_squares:\n    68\t        r0 = int(s[\"r0\"])\n    69\t        r1 = int(r0 + SQUARE_SIZE - 1)\n    70\t        has_overlap = any(overlaps(r0, r1, pr0, pr1) for pr0, pr1 in placed_at_default)\n    71\t        dest_c = int(W - 2 * SQUARE_SIZE) if has_overlap else int(W - SQUARE_SIZE)\n    72\t        paste(out, s[\"patch\"], r0, dest_c, transparent=bg)\n    73\t        if dest_c == int(W - SQUARE_SIZE):\n    74\t            placed_at_default.append((r0, r1))\n    75\t\n    76\t    return out\n    77\t\n    78\t# --------------- generator (c) ---------------\n    79\t\n    80\t# --- Configuration ---\n    81\tGRID_H, GRID_W = 22, 22          # canvas dimensions\n    82\tSQ = 5                            # square side length (frame + 3x3 interior)\n    83\tAZURE, RED = 8, 2                 # frame colors\n    84\tN_AZURE_RANGE = (3, 4)            # azure square count range\n    85\tN_RED_RANGE = (3, 5)              # red square count range\n    86\tMAX_INWARD = 2                    # max inward squares per side\n    87\tINPUT_COL_RETRIES = 50            # retries for input column assignment per side\n    88\tGEN_RETRIES = 500                 # outer generate_input retry limit\n    89\t\n    90\t\n    91\tdef _make_patch(frame_color: int, inner_color: int) -> np.ndarray:\n    92\t    \"\"\"Create a SQxSQ bordered patch with uniform interior.\"\"\"\n    93\t    p = np.full((SQ, SQ), frame_color, dtype=int)\n    94\t    p[1:-1, 1:-1] = inner_color\n    95\t    return p\n    96\t\n    97\t\n    98\tdef _rows_overlap(r_a: int, r_b: int) -> bool:\n    99\t    \"\"\"Check whether two SQ-tall row spans overlap.\"\"\"\n   100\t    return abs(r_a - r_b) < SQ\n   101\t\n   102\t\n   103\tdef _rects_overlap(r1, c1, r2, c2) -> bool:\n   104\t    \"\"\"Check whether two SQxSQ rectangles overlap.\"\"\"\n   105\t    return abs(r1 - r2) < SQ and abs(c1 - c2) < SQ\n   106\t\n   107\t\n   108\tdef _any_pairwise_overlap(positions: list[tuple]) -> bool:\n   109\t    \"\"\"Return True if any two (r, c, ...) entries overlap as SQxSQ rects.\"\"\"\n   110\t    for i in range(len(positions)):\n   111\t        for j in range(i + 1, len(positions)):\n   112\t            if _rects_overlap(positions[i][0], positions[i][1],\n   113\t                              positions[j][0], positions[j][1]):\n   114\t                return True\n   115\t    return False\n   116\t\n   117\t\n   118\tdef _assign_output_rows(n: int) -> tuple[list[int], list[int]] | None:\n   119\t    \"\"\"Pick edge and inward row positions for *n* squares on one side.\n   120\t\n   121\t    Returns (edge_rows, inward_rows) or None on failure.\n   122\t    Edge squares have non-overlapping row spans. Each inward square must\n   123\t    row-overlap at least one edge square.\n   124\t    \"\"\"\n   125\t    max_inward = min(MAX_INWARD, n - 1)\n   126\t    n_inward = random.randint(1, max_inward)\n   127\t    n_edge = n - n_inward\n   128\t\n   129\t    all_rows = list(range(GRID_H - SQ + 1))\n   130\t    random.shuffle(all_rows)\n   131\t    edge_rows: list[int] = []\n   132\t    for r in all_rows:\n   133\t        if all(not _rows_overlap(r, er) for er in edge_rows):\n   134\t            edge_rows.append(r)\n   135\t            if len(edge_rows) == n_edge:\n   136\t                break\n   137\t    if len(edge_rows) < n_edge:\n   138\t        return None\n   139\t\n   140\t    random.shuffle(all_rows)\n   141\t    inward_rows: list[int] = []\n   142\t    for r in all_rows:\n   143\t        if not any(_rows_overlap(r, er) for er in edge_rows):\n   144\t            continue\n   145\t        if any(_rows_overlap(r, ir) for ir in inward_rows):\n   146\t            continue\n   147\t        inward_rows.append(r)\n   148\t        if len(inward_rows) == n_inward:\n   149\t            break\n   150\t    if len(inward_rows) < n_inward:\n   151\t        return None\n   152\t    return edge_rows, inward_rows\n   153\t\n   154\t\n   155\tdef _place_side_squares(\n   156\t    output: np.ndarray, edge_rows: list[int], inward_rows: list[int],\n   157\t    colors: list[int], frame_color: int, edge_col: int, inward_col: int,\n   158\t) -> list[tuple[int, int, bool, np.ndarray]]:\n   159\t    \"\"\"Render edge and inward squares onto *output*, return metadata list.\n   160\t\n   161\t    Each entry is (row, out_col, is_edge, patch).\n   162\t    \"\"\"\n   163\t    placed: list[tuple[int, int, bool, np.ndarray]] = []\n   164\t    for i, r in enumerate(edge_rows):\n   165\t        p = _make_patch(frame_color, colors[i])\n   166\t        paste(output, p, r, edge_col)\n   167\t        placed.append((r, edge_col, True, p))\n   168\t    for i, r in enumerate(inward_rows):\n   169\t        p = _make_patch(frame_color, colors[len(edge_rows) + i])\n   170\t        paste(output, p, r, inward_col)\n   171\t        placed.append((r, inward_col, False, p))\n   172\t    return placed\n   173\t\n   174\t\n   175\tdef _derive_input_positions(\n   176\t    sq_list: list[tuple[int, int, bool, np.ndarray]], ascending: bool,\n   177\t) -> list[tuple[int, int, np.ndarray]] | None:\n   178\t    \"\"\"Assign random input columns that reproduce the solver's edge/inward placement.\n   179\t\n   180\t    For ascending (azure), the solver processes squares by input col ascending;\n   181\t    for descending (red), by input col descending. An inward square must appear\n   182\t    after at least one of its row-overlapping edge squares in processing order.\n   183\t\n   184\t    Returns list of (row, input_col, patch) or None on failure.\n   185\t    \"\"\"\n   186\t    edges = [(r, oc, p) for (r, oc, is_edge, p) in sq_list if is_edge]\n   187\t    inwards = [(r, oc, p) for (r, oc, is_edge, p) in sq_list if not is_edge]\n   188\t\n   189\t    # For each inward square, find which edge squares it row-overlaps\n   190\t    inward_deps = [[i for i, (er, _, _) in enumerate(edges) if _rows_overlap(ir, er)]\n   191\t                   for (ir, _, _) in inwards]\n   192\t\n   193\t    n = len(sq_list)\n   194\t    col_range = list(range(0, GRID_W - SQ + 1))\n   195\t    if len(col_range) < n:\n   196\t        return None\n   197\t\n   198\t    for _ in range(INPUT_COL_RETRIES):\n   199\t        # Build processing order: edges first (shuffled), inwards inserted after deps\n   200\t        edge_indices = list(range(len(edges)))\n   201\t        random.shuffle(edge_indices)\n   202\t        order: list[tuple[str, int]] = [('edge', i) for i in edge_indices]\n   203\t\n   204\t        inward_order = list(range(len(inwards)))\n   205\t        random.shuffle(inward_order)\n   206\t        for iw_idx in inward_order:\n   207\t            # Find the latest position of any dependency edge in the order\n   208\t            latest_pos = max(\n   209\t                (pos for d in inward_deps[iw_idx]\n   210\t                 for pos, (typ, idx) in enumerate(order)\n   211\t                 if typ == 'edge' and idx == d),\n   212\t                default=-1,\n   213\t            )\n   214\t            insert_pos = random.randint(latest_pos + 1, len(order))\n   215\t            order.insert(insert_pos, ('inward', iw_idx))\n   216\t\n   217\t        # Resolve each entry to (row, out_col, patch) in processing order\n   218\t        ordered_squares = [\n   219\t            (edges[idx] if typ == 'edge' else inwards[idx]) for typ, idx in order\n   220\t        ]\n   221\t\n   222\t        # Pick n distinct sorted input cols; reverse for descending side\n   223\t        chosen_cols = sorted(random.sample(col_range, n))\n   224\t        if not ascending:\n   225\t            chosen_cols = chosen_cols[::-1]\n   226\t\n   227\t        # Map cols to squares; reject if any input col == output col\n   228\t        result = []\n   229\t        ok = True\n   230\t        for i, (r, oc, p) in enumerate(ordered_squares):\n   231\t            ic = chosen_cols[i]\n   232\t            if ic == oc:\n   233\t                ok = False\n   234\t                break\n   235\t            result.append((r, ic, p))\n   236\t        if not ok:\n   237\t            continue\n   238\t\n   239\t        if not _any_pairwise_overlap(result):\n   240\t            return result\n   241\t\n   242\t    return None\n   243\t\n   244\t\n   245\tdef _gen_attempt() -> np.ndarray | None:\n   246\t    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n   247\t    bg = random.choice([c for c in range(10) if c not in {AZURE, RED}])\n   248\t    n_azure = random.randint(*N_AZURE_RANGE)\n   249\t    n_red = random.randint(*N_RED_RANGE)\n   250\t\n   251\t    # Assign output row positions for each side\n   252\t    azure_assign = _assign_output_rows(n_azure)\n   253\t    if azure_assign is None:\n   254\t        return None\n   255\t    red_assign = _assign_output_rows(n_red)\n   256\t    if red_assign is None:\n   257\t        return None\n   258\t    azure_edge_rows, azure_inward_rows = azure_assign\n   259\t    red_edge_rows, red_inward_rows = red_assign\n   260\t\n   261\t    # Assign unique inner colors per frame type\n   262\t    avail_azure = [c for c in range(10) if c not in {bg, AZURE}]\n   263\t    avail_red = [c for c in range(10) if c not in {bg, RED}]\n   264\t    if len(avail_azure) < n_azure or len(avail_red) < n_red:\n   265\t        return None\n   266\t    azure_colors = random.sample(avail_azure, n_azure)\n   267\t    red_colors = random.sample(avail_red, n_red)\n   268\t\n   269\t    # Build output grid\n   270\t    output = np.full((GRID_H, GRID_W), bg, dtype=int)\n   271\t    azure_out = _place_side_squares(\n   272\t        output, azure_edge_rows, azure_inward_rows, azure_colors,\n   273\t        AZURE, edge_col=0, inward_col=SQ)\n   274\t    red_out = _place_side_squares(\n   275\t        output, red_edge_rows, red_inward_rows, red_colors,\n   276\t        RED, edge_col=GRID_W - SQ, inward_col=GRID_W - 2 * SQ)\n   277\t\n   278\t    # Derive input column assignments\n   279\t    azure_input = _derive_input_positions(azure_out, ascending=True)\n   280\t    if azure_input is None:\n   281\t        return None\n   282\t    red_input = _derive_input_positions(red_out, ascending=False)\n   283\t    if red_input is None:\n   284\t        return None\n   285\t\n   286\t    # Cross-side overlap check\n   287\t    all_positions = azure_input + red_input\n   288\t    if _any_pairwise_overlap(all_positions):\n   289\t        return None\n   290\t\n   291\t    # Build and validate input grid\n   292\t    inp = np.full((GRID_H, GRID_W), bg, dtype=int)\n   293\t    for r, c, p in all_positions:\n   294\t        paste(inp, p, r, c)\n   295\t    try:\n   296\t        if np.array_equal(main(inp), output):\n   297\t            return inp\n   298\t    except Exception:\n   299\t        pass\n   300\t    return None\n   301\t\n   302\t\n   303\tdef generate_input() -> np.ndarray:\n   304\t    for _ in range(GEN_RETRIES):\n   305\t        result = _gen_attempt()\n   306\t        if result is not None:\n   307\t            return result\n   308\t    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
