{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/eval/581f7754.py | sed -n '1,240p'\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\tfrom collections import Counter\n     3\timport numpy as np\n     4\tfrom arc_utils import find_components, get_bg, neighbors4, paste\n     5\timport random\n     6\t\n     7\tdef main(grid: np.ndarray) -> np.ndarray:\n     8\t    \"\"\"\n     9\t    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n    10\t\n    11\t    Input structure:\n    12\t    - bg = most common color.\n    13\t    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    14\t    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n    15\t\n    16\t    Rule:\n    17\t    - Match each sprite to the border anchor sharing its marker color.\n    18\t    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    19\t    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n    20\t\n    21\t    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    22\t    \"\"\"\n    23\t    g = np.array(grid, dtype=int)\n    24\t    H, W = g.shape\n    25\t    bg = int(get_bg(g))\n    26\t\n    27\t    def is_border(r: int, c: int) -> bool:\n    28\t        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n    29\t\n    30\t    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    31\t    anchors_by_color: dict[int, tuple[int, int]] = {}\n    32\t    for r in range(H):\n    33\t        for c in range(W):\n    34\t            if not is_border(r, c):\n    35\t                continue\n    36\t            v = int(g[r, c])\n    37\t            if v == int(bg):\n    38\t                continue\n    39\t            ok = True\n    40\t            for rr, cc in neighbors4(int(r), int(c)):\n    41\t                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n    42\t                    ok = False\n    43\t                    break\n    44\t            if ok and v not in anchors_by_color:\n    45\t                anchors_by_color[int(v)] = (int(r), int(c))\n    46\t\n    47\t    assert not (not anchors_by_color)\n    48\t\n    49\t    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n    50\t\n    51\t    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    52\t    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n    53\t\n    54\t    def component_marker_color(coords: np.ndarray) -> int | None:\n    55\t        # For multi-color sprites, the marker color is the least frequent color inside the component.\n    56\t        vals = [int(g[int(r), int(c)]) for r, c in coords]\n    57\t        cnt = Counter(vals)\n    58\t        if len(cnt) <= 1:\n    59\t            return None\n    60\t        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n    61\t\n    62\t    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n    63\t        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n    64\t        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n    65\t        if not pts:\n    66\t            return None\n    67\t        if len(pts) == 1:\n    68\t            return pts[0]\n    69\t        S = {(int(r), int(c)) for r, c in coords}\n    70\t        for r, c in pts:\n    71\t            for rr, cc in neighbors4(int(r), int(c)):\n    72\t                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n    73\t                    return (int(r), int(c))\n    74\t        return pts[0]\n    75\t\n    76\t    moves: list[tuple[np.ndarray, int, int]] = []\n    77\t\n    78\t    for comp in comps:\n    79\t        coords = comp[\"coords\"]\n    80\t        if coords.size == 0:\n    81\t            continue\n    82\t\n    83\t        # --- STEP 3) Decide marker color for this component. ---\n    84\t        marker_col = component_marker_color(coords)\n    85\t        if marker_col is None:\n    86\t            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n    87\t            if int(coords.shape[0]) != 1:\n    88\t                continue\n    89\t            r, c = map(int, coords[0])\n    90\t            v = int(g[r, c])\n    91\t            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n    92\t                continue\n    93\t            marker_col = int(v)\n    94\t\n    95\t        if int(marker_col) not in anchors_by_color:\n    96\t            continue\n    97\t\n    98\t        mp = marker_pixel(coords, int(marker_col))\n    99\t        if mp is None:\n   100\t            continue\n   101\t\n   102\t        ar, ac = anchors_by_color[int(marker_col)]\n   103\t\n   104\t        # --- STEP 4) Compute translation (dr,dc). ---\n   105\t        on_top_bottom = int(ar) in (0, int(H - 1))\n   106\t        on_left_right = int(ac) in (0, int(W - 1))\n   107\t        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n   108\t\n   109\t        dr = 0\n   110\t        dc = 0\n   111\t        if horizontal:\n   112\t            dc = int(ac - mp[1])\n   113\t        else:\n   114\t            dr = int(ar - mp[0])\n   115\t\n   116\t        moves.append((coords, int(dr), int(dc)))\n   117\t\n   118\t    out = g.copy()\n   119\t\n   120\t    # --- STEP 5) Apply all moves. ---\n   121\t    # Clear moved components first (prevents collisions with their original locations).\n   122\t    for coords, _dr, _dc in moves:\n   123\t        out[coords[:, 0], coords[:, 1]] = int(bg)\n   124\t\n   125\t    # Paste moved components:\n   126\t    # - clip out-of-bounds pixels\n   127\t    # - do not overwrite existing non-bg pixels\n   128\t    for coords, dr, dc in moves:\n   129\t        for r, c in coords:\n   130\t            rr = int(r) + int(dr)\n   131\t            cc = int(c) + int(dc)\n   132\t            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n   133\t                out[rr, cc] = int(g[int(r), int(c)])\n   134\t\n   135\t    return out\n   136\t\n   137\t# --------------- generator (o5x) ---------------\n   138\t\n   139\t# CFG: palette and canvas bounds.\n   140\t_COLORS = tuple(range(10))\n   141\t_BG_COLOR_RANGE = (1, 8)\n   142\t_GRID_HEIGHT_RANGE = (10, 22)\n   143\t_GRID_WIDTH_RANGE = (8, 22)\n   144\t\n   145\t# CFG: placement isolation and anchor location.\n   146\t_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n   147\t_INNER_BORDER_GAP = 1\n   148\t_ANCHOR_EDGE_MARGIN = 2\n   149\t_ISOLATION_RADIUS = 1\n   150\t\n   151\t# CFG: anchor, sprite, and retry counts.\n   152\t_ANCHOR_COUNT_RANGE = (1, 3)\n   153\t_SPRITE_COUNT_RANGE = (3, 5)\n   154\t_BODY_AREA_RANGE = (4, 13)\n   155\t_GEN_RETRY_LIMIT = 300\n   156\t\n   157\t# CFG: body geometry and shape mix.\n   158\t_BODY_HEIGHT_RANGE = (2, 5)\n   159\t_BODY_WIDTH_RANGE = (3, 7)\n   160\t_FRAME_HEIGHT_RANGE = (3, 5)\n   161\t_FRAME_WIDTH_RANGE = (3, 7)\n   162\t_FRAME_MIN_AREA = 8\n   163\t_FRAME_MAX_GAP = 3\n   164\t_FRAME_BODY_THRESHOLD = 0.28\n   165\t_WIDE_BODY_THRESHOLD = 0.55\n   166\t_SYMMETRIC_BODY_THRESHOLD = 0.82\n   167\t_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n   168\t_SYMMETRIC_TRANSPOSE_PROB = 0.45\n   169\t_MARKER_INTERIOR_PROB = 0.65\n   170\t_FLIP_PROB = 0.5\n   171\t\n   172\t# CFG: optional singleton distractors.\n   173\t_DISTRACTOR_PROB = 0.15\n   174\t_DISTRACTOR_COUNT_RANGE = (1, 4)\n   175\t\n   176\t_GROW_BODY_SEEDS = [\n   177\t    {(0, 0), (0, 1), (0, 2), (1, 0)},\n   178\t    {(0, 0), (0, 1), (0, 2), (1, 2)},\n   179\t    {(0, 0), (1, 0), (1, 1), (1, 2)},\n   180\t    {(0, 2), (1, 0), (1, 1), (1, 2)},\n   181\t    {(0, 1), (1, 0), (1, 1), (1, 2)},\n   182\t]\n   183\t\n   184\t\n   185\tdef _norm(cells):\n   186\t    r0 = min(r for r, _c in cells)\n   187\t    c0 = min(c for _r, c in cells)\n   188\t    return {(r - r0, c - c0) for r, c in cells}\n   189\t\n   190\t\n   191\tdef _bbox(cells):\n   192\t    return (\n   193\t        min(r for r, _c in cells),\n   194\t        min(c for _r, c in cells),\n   195\t        max(r for r, _c in cells),\n   196\t        max(c for _r, c in cells),\n   197\t    )\n   198\t\n   199\t\n   200\tdef _flip(cells):\n   201\t    cells = set(cells)\n   202\t    if random.random() < _FLIP_PROB:\n   203\t        mc = max(c for _r, c in cells)\n   204\t        cells = {(r, mc - c) for r, c in cells}\n   205\t    if random.random() < _FLIP_PROB:\n   206\t        mr = max(r for r, _c in cells)\n   207\t        cells = {(mr - r, c) for r, c in cells}\n   208\t    return _norm(cells)\n   209\t\n   210\t\n   211\tdef _inclusive_range(bounds):\n   212\t    return range(int(bounds[0]), int(bounds[1]) + 1)\n   213\t\n   214\t\n   215\tdef _frontier_cells(cells, height, width):\n   216\t    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n   217\t    frontier = []\n   218\t    for r, c in cells:\n   219\t        for dr, dc in _NEIGHBORS4:\n   220\t            rr, cc = r + dr, c + dc\n   221\t            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n   222\t                frontier.append((rr, cc))\n   223\t    return frontier\n   224\t\n   225\t\n   226\tdef _grow_body(area):\n   227\t    choices = [\n   228\t        (h, w)\n   229\t        for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n   230\t        for w in _inclusive_range(_BODY_WIDTH_RANGE)\n   231\t        if h * w >= area\n   232\t    ]\n   233\t    h, w = random.choice(choices)\n   234\t    cells = set(random.choice(_GROW_BODY_SEEDS))\n   235\t    while len(cells) < area:\n   236\t        frontier = _frontier_cells(cells, h, w)\n   237\t        if not frontier:\n   238\t            return _grow_body(area)\n   239\t        cells.add(random.choice(frontier))\n   240\t    return _flip(cells)\n","exit_code":0,"status":"completed"}}
