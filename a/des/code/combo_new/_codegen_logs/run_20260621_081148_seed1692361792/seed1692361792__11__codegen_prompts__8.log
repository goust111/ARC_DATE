: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:102:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:105:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:109:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:114:    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:115:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:169:\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:205:    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:214:    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:228:    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:240:    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:265:    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:275:    \"\"\"Return blob with interior holes absorbed.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:279:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:330:    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:346:    \"\"\"Place 1-2 legend patches at grid corners.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:349:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:380:    \"\"\"Grow irregular closed regions, one per assigned wall color.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:383:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:440:    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:468:    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:485:    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:489:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:533:    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:556:    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:604:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:8:    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:15:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:22:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:27:        \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:31:        \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:195:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:197:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:232:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:235:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:274:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:275:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:278:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:282:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:287:    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:288:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:332:    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:339:    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:346:    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:378:    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:392:    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:408:    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:425:    \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:441:    \"\"\"Render a sprite onto the grid: border cells in color, hole cells in fill (if given).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:544:def generate_input():\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:7:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:8:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:11:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:16:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:21:    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:22:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:216:    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:367:    \"\"\"Return True if any patch