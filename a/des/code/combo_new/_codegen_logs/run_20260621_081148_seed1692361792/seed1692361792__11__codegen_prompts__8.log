{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/a/des/code/combo_new/seed1692361792/11/8.py | sed -n '1,260p'\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\t\n     3\timport random\n     4\t\n     5\timport numpy as np\n     6\t\n     7\t\n     8\tdef _components4(mask: np.ndarray) -> list[np.ndarray]:\n     9\t    height, width = mask.shape\n    10\t    seen = np.zeros((height, width), dtype=bool)\n    11\t    comps: list[np.ndarray] = []\n    12\t\n    13\t    for start_r in range(height):\n    14\t        for start_c in range(width):\n    15\t            if not mask[start_r, start_c] or seen[start_r, start_c]:\n    16\t                continue\n    17\t\n    18\t            stack = [(start_r, start_c)]\n    19\t            seen[start_r, start_c] = True\n    20\t            cells: list[tuple[int, int]] = []\n    21\t\n    22\t            while stack:\n    23\t                r, c = stack.pop()\n    24\t                cells.append((int(r), int(c)))\n    25\t                for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):\n    26\t                    if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and not seen[nr, nc]:\n    27\t                        seen[nr, nc] = True\n    28\t                        stack.append((nr, nc))\n    29\t\n    30\t            comps.append(np.array(cells, dtype=int))\n    31\t\n    32\t    return comps\n    33\t\n    34\t\n    35\tdef _most_common(values: np.ndarray) -> int:\n    36\t    uniq, counts = np.unique(values, return_counts=True)\n    37\t    return int(uniq[np.argmax(counts)])\n    38\t\n    39\t\n    40\tdef _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:\n    41\t    rows = coords[:, 0]\n    42\t    cols = coords[:, 1]\n    43\t    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())\n    44\t\n    45\t\n    46\tdef _find_frames(grid: np.ndarray) -> tuple[int, int, list[dict[str, object]]]:\n    47\t    g = np.asarray(grid, dtype=int)\n    48\t    height, width = g.shape\n    49\t    bg = _most_common(g.reshape(-1))\n    50\t\n    51\t    non_bg = g[g != bg]\n    52\t    assert non_bg.size > 0, \"expected at least one frame\"\n    53\t    frame_color = _most_common(non_bg)\n    54\t\n    55\t    frames: list[dict[str, object]] = []\n    56\t    for comp in _components4(g == bg):\n    57\t        ir0, ic0, ir1, ic1 = _bbox(comp)\n    58\t        if ir0 < 1 or ic0 < 1 or ir1 > height - 2 or ic1 > width - 2:\n    59\t            continue\n    60\t        if comp.shape[0] != (ir1 - ir0 + 1) * (ic1 - ic0 + 1):\n    61\t            continue\n    62\t\n    63\t        fr0, fc0, fr1, fc1 = ir0 - 1, ic0 - 1, ir1 + 1, ic1 + 1\n    64\t        top = g[fr0, fc0 : fc1 + 1]\n    65\t        bottom = g[fr1, fc0 : fc1 + 1]\n    66\t        left = g[fr0 : fr1 + 1, fc0]\n    67\t        right = g[fr0 : fr1 + 1, fc1]\n    68\t\n    69\t        if not (\n    70\t            int(g[fr0, fc0]) == frame_color\n    71\t            and int(g[fr0, fc1]) == frame_color\n    72\t            and int(g[fr1, fc0]) == frame_color\n    73\t            and int(g[fr1, fc1]) == frame_color\n    74\t        ):\n    75\t            continue\n    76\t        if not np.all(bottom == frame_color) or not np.all(right == frame_color):\n    77\t            continue\n    78\t        if top[1:-1].size == 0 or left[1:-1].size == 0:\n    79\t            continue\n    80\t        if np.any(top[1:-1] == bg) or np.any(left[1:-1] == bg):\n    81\t            continue\n    82\t\n    83\t        top_markers = [\n    84\t            (int(fc0 + 1 + offset), int(color))\n    85\t            for offset, color in enumerate(top[1:-1])\n    86\t            if int(color) != frame_color\n    87\t        ]\n    88\t        left_markers = [\n    89\t            (int(fr0 + 1 + offset), int(color))\n    90\t            for offset, color in enumerate(left[1:-1])\n    91\t            if int(color) != frame_color\n    92\t        ]\n    93\t\n    94\t        frames.append(\n    95\t            {\n    96\t                \"outer\": (int(fr0), int(fc0), int(fr1), int(fc1)),\n    97\t                \"inner\": (int(ir0), int(ic0), int(ir1), int(ic1)),\n    98\t                \"top_markers\": top_markers,\n    99\t                \"left_markers\": left_markers,\n   100\t            }\n   101\t        )\n   102\t\n   103\t    frames.sort(key=lambda frame: tuple(frame[\"outer\"]))  # type: ignore[arg-type]\n   104\t    assert frames, \"expected at least one valid frame\"\n   105\t    return bg, frame_color, frames\n   106\t\n   107\t\n   108\tdef _apply_projection(grid: np.ndarray, frames: list[dict[str, object]]) -> np.ndarray:\n   109\t    out = np.array(grid, dtype=int, copy=True)\n   110\t\n   111\t    for frame in frames:\n   112\t        ir0, ic0, ir1, ic1 = frame[\"inner\"]  # type: ignore[misc]\n   113\t        for col, color in frame[\"top_markers\"]:  # type: ignore[misc]\n   114\t            out[ir0 : ir1 + 1, col] = color\n   115\t        for row, color in frame[\"left_markers\"]:  # type: ignore[misc]\n   116\t            out[row, ic0 : ic1 + 1] = color\n   117\t\n   118\t    return out\n   119\t\n   120\t\n   121\tdef main(grid: np.ndarray) -> np.ndarray:\n   122\t    \"\"\"\n   123\t    Project top-edge and left-edge frame markers into the enclosed interior to make a crossed fill pattern.\n   124\t\n   125\t    Input structure:\n   126\t    - The background is a single dominant color, and several non-overlapping rectangular frames sit on it.\n   127\t    - Each frame has a one-pixel border in one common frame color, except that some cells on the top edge and left edge are replaced by non-background marker colors.\n   128\t    - The inside of every frame is a solid rectangle of background color before the transformation.\n   129\t\n   130\t    Rule:\n   131\t    - Keep every frame border cell exactly as it is, including the colored markers on the top and left edges.\n   132\t    - For each frame, every colored marker on the top edge fills its whole interior column with that marker's color.\n   133\t    - After all column fills, every colored marker on the left edge fills its whole interior row with that marker's color, overwriting any earlier column color at crossings.\n   134\t\n   135\t    Key insight:\n   136\t    - The enclosed background rectangle identifies each frame's interior, while the top and left border markers are two independent projection instruction sets whose execution order is visible at their intersections.\n   137\t    \"\"\"\n   138\t    g = np.asarray(grid, dtype=int)\n   139\t    assert g.ndim == 2, \"expected a 2D grid\"\n   140\t    _bg, _frame_color, frames = _find_frames(g)\n   141\t    return _apply_projection(g, frames)\n   142\t\n   143\t\n   144\t# --------------- generator ---------------\n   145\t\n   146\tBG = 0\n   147\tFRAME = 5\n   148\tMARKER_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\n   149\t\n   150\tGRID_SIZE_RANGE = (12, 30)\n   151\tFRAME_COUNT_CHOICES = [1, 2, 3, 4]\n   152\tFRAME_COUNT_WEIGHTS = [2, 4, 3, 1]\n   153\tINNER_HEIGHT_RANGE = (2, 8)\n   154\tINNER_WIDTH_RANGE = (2, 9)\n   155\tPLACEMENT_PAD = 1\n   156\tFRAME_PLACEMENT_RETRIES = 150\n   157\tGEN_RETRIES = 400\n   158\t\n   159\tCOVERAGE_MODES = (\"sparse\", \"top_full\", \"left_full\", \"both_full\")\n   160\t\n   161\t\n   162\tdef _pick_marker_offsets(length: int, axis: str, mode: str) -> list[int]:\n   163\t    assert length >= 1\n   164\t    make_full = mode == \"both_full\" or (mode == \"top_full\" and axis == \"top\") or (mode == \"left_full\" and axis == \"left\")\n   165\t    if make_full:\n   166\t        return list(range(length))\n   167\t    max_k = max(1, length - 1)\n   168\t    k = random.randint(1, max_k)\n   169\t    return sorted(random.sample(range(length), k))\n   170\t\n   171\t\n   172\tdef _pick_marker_colors(top_count: int, left_count: int) -> tuple[list[int], list[int]]:\n   173\t    top_colors = [random.choice(MARKER_COLORS) for _ in range(top_count)]\n   174\t    left_colors = [random.choice(MARKER_COLORS) for _ in range(left_count)]\n   175\t    if len(set(top_colors + left_colors)) == 1:\n   176\t        choices = [c for c in MARKER_COLORS if c != top_colors[0]]\n   177\t        left_colors[-1] = random.choice(choices)\n   178\t    return top_colors, left_colors\n   179\t\n   180\t\n   181\tdef _bbox_clear(reserved: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int) -> bool:\n   182\t    rr0 = max(0, r0 - pad)\n   183\t    cc0 = max(0, c0 - pad)\n   184\t    rr1 = min(reserved.shape[0] - 1, r1 + pad)\n   185\t    cc1 = min(reserved.shape[1] - 1, c1 + pad)\n   186\t    return not bool(reserved[rr0 : rr1 + 1, cc0 : cc1 + 1].any())\n   187\t\n   188\t\n   189\tdef _mark_reserved(reserved: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int) -> None:\n   190\t    rr0 = max(0, r0 - pad)\n   191\t    cc0 = max(0, c0 - pad)\n   192\t    rr1 = min(reserved.shape[0] - 1, r1 + pad)\n   193\t    cc1 = min(reserved.shape[1] - 1, c1 + pad)\n   194\t    reserved[rr0 : rr1 + 1, cc0 : cc1 + 1] = True\n   195\t\n   196\t\n   197\tdef _add_frame(\n   198\t    grid: np.ndarray,\n   199\t    reserved: np.ndarray,\n   200\t    outer_r0: int,\n   201\t    outer_c0: int,\n   202\t    inner_h: int,\n   203\t    inner_w: int,\n   204\t    mode: str,\n   205\t) -> dict[str, object]:\n   206\t    outer_r1 = outer_r0 + inner_h + 1\n   207\t    outer_c1 = outer_c0 + inner_w + 1\n   208\t    inner_r0 = outer_r0 + 1\n   209\t    inner_c0 = outer_c0 + 1\n   210\t    inner_r1 = outer_r1 - 1\n   211\t    inner_c1 = outer_c1 - 1\n   212\t\n   213\t    grid[outer_r0, outer_c0 : outer_c1 + 1] = FRAME\n   214\t    grid[outer_r1, outer_c0 : outer_c1 + 1] = FRAME\n   215\t    grid[outer_r0 : outer_r1 + 1, outer_c0] = FRAME\n   216\t    grid[outer_r0 : outer_r1 + 1, outer_c1] = FRAME\n   217\t\n   218\t    top_offsets = _pick_marker_offsets(inner_w, \"top\", mode)\n   219\t    left_offsets = _pick_marker_offsets(inner_h, \"left\", mode)\n   220\t    top_colors, left_colors = _pick_marker_colors(len(top_offsets), len(left_offsets))\n   221\t\n   222\t    top_markers: list[tuple[int, int]] = []\n   223\t    for offset, color in zip(top_offsets, top_colors, strict=False):\n   224\t        col = inner_c0 + offset\n   225\t        grid[outer_r0, col] = color\n   226\t        top_markers.append((int(col), int(color)))\n   227\t\n   228\t    left_markers: list[tuple[int, int]] = []\n   229\t    for offset, color in zip(left_offsets, left_colors, strict=False):\n   230\t        row = inner_r0 + offset\n   231\t        grid[row, outer_c0] = color\n   232\t        left_markers.append((int(row), int(color)))\n   233\t\n   234\t    _mark_reserved(reserved, outer_r0, outer_c0, outer_r1, outer_c1, PLACEMENT_PAD)\n   235\t    return {\n   236\t        \"outer\": (int(outer_r0), int(outer_c0), int(outer_r1), int(outer_c1)),\n   237\t        \"inner\": (int(inner_r0), int(inner_c0), int(inner_r1), int(inner_c1)),\n   238\t        \"top_markers\": top_markers,\n   239\t        \"left_markers\": left_markers,\n   240\t    }\n   241\t\n   242\t\n   243\tdef _generate_attempt() -> np.ndarray | None:\n   244\t    height = random.randint(*GRID_SIZE_RANGE)\n   245\t    width = random.randint(*GRID_SIZE_RANGE)\n   246\t    grid = np.full((height, width), BG, dtype=int)\n   247\t    reserved = np.zeros((height, width), dtype=bool)\n   248\t\n   249\t    target_frames = random.choices(FRAME_COUNT_CHOICES, weights=FRAME_COUNT_WEIGHTS, k=1)[0]\n   250\t    frames: list[dict[str, object]] = []\n   251\t\n   252\t    for _ in range(target_frames):\n   253\t        placed = False\n   254\t        for _attempt in range(FRAME_PLACEMENT_RETRIES):\n   255\t            inner_h = random.randint(*INNER_HEIGHT_RANGE)\n   256\t            inner_w = random.randint(*INNER_WIDTH_RANGE)\n   257\t            outer_h = inner_h + 2\n   258\t            outer_w = inner_w + 2\n  