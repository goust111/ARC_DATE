p_c0+out_w-1\n    min_h=crop_r1+rect_count+2; min_w=crop_c1+2\n    if min_h>30 or min_w>30: return 'size1'\n    h=random.randint(min_h,min(30,min_h+4)); w=random.randint(min_w,min(30,min_w+4))\n    colors=random.sample(range(1,10),rect_count+2)\n    rect_colors=colors[2:]\n    rectangles=_gen_nested(h,w,crop_r0,crop_r1,crop_c0,crop_c1,rect_colors)\n    if rectangles is None: return 'rects'\n    input_order=rect_colors[:]\n    depth_order=rect_colors[:]\n    for _ in range(80):\n        random.shuffle(depth_order)\n        if depth_order \"'!= input_order and depth_order[-1] != rect_colors[0]:\n            break\n    else: return '\"'order'\n    scene=_render_rectangles((h,w),rectangles,input_order)\n    if not _valid_visible_bboxes(scene,rectangles): return 'bbox'\n    expected=_compose_crop(rectangles,depth_order,crop_r0,crop_r1,crop_c0,crop_c1)\n    crop_scene=scene[crop_r0:crop_r1+1,crop_c0:crop_c1+1]\n    if np.array_equal(crop_scene,expected): return 'samecrop'\n    visible=set(map(int,np.unique(expected)))-{BG}\n    if len(visible)<2: return 'fewcolors'\n    if not np.any(expected==BG): return 'nobg'\n    return 'ok'\n\nctr=Counter(_gen_attempt() for _ in range(5000))\nprint(ctr)\nPY\"","aggregated_output":"Counter({'rects': 3471, 'ok': 1529})\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport hashlib\nimport random\nimport numpy as np\n\nBG = 0\nRECT_COUNT_RANGE = (3, 5)\nCROP_START_RANGE = (2, 6)\nOUTPUT_H_RANGE = (6, 11)\nOUTPUT_W_RANGE = (6, 11)\nEDGE_TICK_LENGTHS = (1, 2)\nMAX_GENERATION_ATTEMPTS = 400\n\n\ndef _find_crop_window(g: np.ndarray) -> tuple[int, int, int, int]:\n    top_colors = [int(c) for c in np.unique(g[0, :]) if int(c) \"'!= BG]\n    assert len(top_colors) == 1, '\"'expected one top-marker color'\n    top_color = top_colors[0]\n    cols = np.flatnonzero(g[0, :] == top_color)\n    assert len(cols) == 2, 'expected two top-edge tick columns'\n\n    left_colors = [int(c) for c in np.unique(g[:, 0]) if int(c) \"'!= BG]\n    assert len(left_colors) == 1, '\"'expected one left-marker color'\n    left_color = left_colors[0]\n    rows = np.flatnonzero(g[:, 0] == left_color)\n    assert len(rows) == 2, 'expected two left-edge tick rows'\n    return int(rows[0]), int(rows[1]), int(cols[0]), int(cols[1])\n\n\ndef _find_legend(g: np.ndarray) -> tuple[int, list[int], list[int]]:\n    h, w = g.shape\n    for c in range(w - 1, max(-1, w - 4), -1):\n        rows = np.flatnonzero(g[:, c] \"'!= BG)\n        if len(rows) < 2:\n            continue\n        if rows[-1] != h - 1:\n            continue\n        if rows[0] < h // 2:\n            continue\n        if not np.all(np.diff(rows) == 1):\n            continue\n        if c < w - 1 and np.any(g[:, c + 1 :] != BG):\n            continue\n        colors = [int(g[r, c]) for r in rows]\n        if len(colors) != len(set(colors)):\n            continue\n        return int(c), [int(r) for r in rows], colors\n    raise AssertionError('\"'legend not found')\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, 'expected a 2D grid'\n    crop_r0, crop_r1, crop_c0, crop_c1 = _find_crop_window(g)\n    legend_c, legend_rows, depth_order = _find_legend(g)\n\n    scene = g.copy()\n    scene[legend_rows, legend_c] = BG\n    out = np.full((crop_r1 - crop_r0 + 1, crop_c1 - crop_c0 + 1), BG, dtype=int)\n    for color in depth_order:\n        pts = np.argwhere(scene == color)\n        assert len(pts) > 0, 'every legend color must have a visible rectangle fragment'\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        rr0 = max(int(r0), crop_r0)\n        rr1 = min(int(r1), crop_r1)\n        cc0 = max(int(c0), crop_c0)\n        cc1 = min(int(c1), crop_c1)\n        if rr0 <= rr1 and cc0 <= cc1:\n            out[rr0 - crop_r0 : rr1 - crop_r0 + 1, cc0 - crop_c0 : cc1 - crop_c0 + 1] = color\n    return out\n\n\ndef _render_rectangles(shape: tuple[int, int], rectangles: dict[int, tuple[int, int, int, int]], order: list[int]) -> np.ndarray:\n    g = np.full(shape, BG, dtype=int)\n    for color in order:\n        r0, c0, r1, c1 = rectangles[color]\n        g[r0 : r1 + 1, c0 : c1 + 1] = color\n    return g\n\n\ndef _compose_crop(rectangles: dict[int, tuple[int, int, int, int]], order: list[int], crop_r0: int, crop_r1: int, crop_c0: int, crop_c1: int) -> np.ndarray:\n    out = np.full((crop_r1 - crop_r0 + 1, crop_c1 - crop_c0 + 1), BG, dtype=int)\n    for color in order:\n        r0, c0, r1, c1 = rectangles[color]\n        rr0 = max(r0, crop_r0)\n        rr1 = min(r1, crop_r1)\n        cc0 = max(c0, crop_c0)\n        cc1 = min(c1, crop_c1)\n        if rr0 <= rr1 and cc0 <= cc1:\n            out[rr0 - crop_r0 : rr1 - crop_r0 + 1, cc0 - crop_c0 : cc1 - crop_c0 + 1] = color\n    return out\n\n\ndef _valid_visible_bboxes(scene: np.ndarray, rectangles: dict[int, tuple[int, int, int, int]]) -> bool:\n    for color, bbox in rectangles.items():\n        pts = np.argwhere(scene == color)\n        if len(pts) == 0:\n            return False\n        mins = tuple(map(int, pts.min(axis=0)))\n        maxs = tuple(map(int, pts.max(axis=0)))\n        if mins \"'!= bbox[:2] or maxs != bbox[2:]:\n            return False\n    return True\n\n\ndef _gen_nested_rectangles(h: int, w: int, crop_r0: int, crop_r1: int, crop_c0: int, crop_c1: int, rect_colors: list[int]) -> dict[int, tuple[int, int, int, int]] | None:\n    rect_count = len(rect_colors)\n    margin = rect_count - 1\n\n    top_candidates = list(range(max(2, crop_r0 - 2), min(crop_r0 + 2, crop_r1 - 2 * margin) + 1))\n    left_candidates = list(range(max(2, crop_c0 - 2), min(crop_c0 + 2, crop_c1 - 2 * margin) + 1))\n    if not top_candidates or not left_candidates:\n        return None\n\n    top = random.choice(top_candidates)\n    left = random.choice(left_candidates)\n    bottom_min = max(crop_r1 - 1, top + 2 * margin + 1)\n    bottom_max = min(h - 2, crop_r1 + 2)\n    right_min = max(crop_c1 - 1, left + 2 * margin + 1)\n    right_max = min(w - 2, crop_c1 + 2)\n    if bottom_min > bottom_max or right_min > right_max:\n        return None\n\n    bottom = random.randint(bottom_min, bottom_max)\n    right = random.randint(right_min, right_max)\n    if top <= crop_r0 and left <= crop_c0 and bottom >= crop_r1 and right >= crop_c1:\n        adjustments = []\n        if crop_r0 + 1 < bottom - 2 * margin:\n            adjustments.append((crop_r0 + 1, left, bottom, right))\n        if crop_c0 + 1 < right - 2 * margin:\n            adjustments.append((top, crop_c0 + 1, bottom, right))\n        if top + 2 * margin < crop_r1 - 1:\n            adjustments.append((top, left, crop_r1 - 1, right))\n        if left + 2 * margin < crop_c1 - 1:\n            adjustments.append((top, left, bottom, crop_c1 - 1))\n        if not adjustments:\n            return None\n        top, left, bottom, right = random.choice(adjustments)\n\n    boxes = [(top, left, bottom, right)]\n    for _ in range(1, rect_count):\n        prev_top, prev_left, prev_bottom, prev_right = boxes[-1]\n        choices = []\n        for dt in (1, 2):\n            for dl in (1, 2):\n                for db in (1, 2):\n                    for dr in (1, 2):\n                        nxt = (prev_top + dt, prev_left + dl, prev_bottom - db, prev_right - dr)\n                        nt, nl, nb, nr = nxt\n                        if nb - nt + 1 < 2 or nr - nl + 1 < 2:\n                            continue\n                        choices.append(nxt)\n        if not choices:\n            return None\n        boxes.append(random.choice(choices))\n\n    return {color: box for color, box in zip(rect_colors, boxes)}\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rect_count = random.randint(*RECT_COUNT_RANGE)\n    crop_r0 = random.randint(*CROP_START_RANGE)\n    crop_c0 = random.randint(*CROP_START_RANGE)\n\n    min_out_h = max(OUTPUT_H_RANGE[0], 2 * rect_count)\n    min_out_w = max(OUTPUT_W_RANGE[0], 2 * rect_count)\n    max_out_h = min(OUTPUT_H_RANGE[1], 30 - crop_r0 - rect_count - 2)\n    max_out_w = min(OUTPUT_W_RANGE[1], 30 - crop_c0 - 2)\n    if max_out_h < min_out_h or max_out_w < min_out_w:\n        return None\n\n    out_h = random.randint(min_out_h, max_out_h)\n    out_w = random.randint(min_out_w, max_out_w)\n    crop_r1 = crop_r0 + out_h - 1\n    crop_c1 = crop_c0 + out_w - 1\n\n    min_h = crop_r1 + rect_count + 2\n    min_w = crop_c1 + 2\n    if min_h > 30 or min_w > 30:\n        return None\n    h = random.randint(min_h, min(30, min_h + 4))\n    w = random.randint(min_w, min(30, min_w + 4))\n\n    palette = random.sample(range(1, 10), rect_count + 2)\n    top_marker_color = palette[0]\n    left_marker_color = palette[1]\n    rect_colors = palette[2:]\n\n    rectangles = _gen_nested_rectangles(h, w, crop_r0, crop_r1, crop_c0, crop_c1, rect_colors)\n    if rectangles is None:\n        return None\n\n    input_order = rect_colors[:]\n    depth_order = rect_colors[:]\n    for _ in range(80):\n        random.shuffle(depth_order)\n        if depth_order != input_order and depth_order[-1] != rect_colors[0]:\n            break\n    else:\n        return None\n\n    scene = _render_rectangles((h, w), rectangles, input_order)\n    if not _valid_visible_bboxes(scene, rectangles):\n        return None\n\n    expected = _compose_crop(rectangles, depth_order, crop_r0, crop_r1, crop_c0, crop_c1)\n    crop_scene = scene[crop_r0 : crop_r1 + 1, crop_c0 : crop_c1 + 1]\n    if np.array_equal(crop_scene, expected):\n        return None\n    if len(set(map(int, np.unique(expected))) - {BG}) < 2:\n        return None\n    if not np.any(expected == BG):\n        return None\n\n    grid = scene.copy()\n    grid[: random.choice(EDGE_TICK_LENGTHS), crop_c0] = top_marker_color\n    grid[: random.choice(EDGE_TICK_LENGTHS), crop_c1] = top_marker_color\n    grid[crop_r0, : random.choice(EDGE_TICK_LENGTHS)] = left_marker_color\n    grid[crop_r1, : random.choice(EDGE_TICK_LENGTHS)] = left_marker_color\n\n    legend_rows = list(range(h - rect_count, h))\n    for row, color in zip(legend_rows, depth_order):\n        grid[row, w - 1] = color\n\n    if list(map(int, np.flatnonzero(grid[:, w - 1] != BG))) != legend_rows:\n        return None\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError('\"'failed to generate a valid input')\n\nsigs=set()\nfor i in range(100):\n    inp=generate_input()\n    out=main(inp)\n    assert isinstance(inp,np.ndarray)\n    assert isinstance(out,np.ndarray)\n    assert inp.ndim == 2 and max(inp.shape) <= 30, inp.shape\n    assert out.ndim == 2 and max(out.shape) <= 30, out.shape\n    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())\nprint('variants', len(sigs))\nassert len(sigs) >= 20\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport hashlib\nimport random\nimport numpy as np\n\nBG = 0\nRECT_COUNT_RANGE = (3, 5)\nCROP_START_RANGE = (2, 6)\nOUTPUT_H_RANGE = (6, 11)\nOUTPUT_W_RANGE = (6, 11)\nEDGE_TICK_LENGTHS = (1, 2)\nMAX_GENERATION_ATTEMPTS = 400\n\n\ndef _find_crop_window(g: np.ndarray) -> tuple[int, int, int, int]:\n    top_colors = [int(c) for c in np.unique(g[0, :]) if int(c) \"'!= BG]\n    assert len(top_colors) == 1, '\"'expected one top-marker color'\n    top_color = top_colors[0]\n    cols = np.flatnonzero(g[0, :] == top_color)\n    assert len(cols) == 2, 'expected two top-edge tick columns'\n\n    left_colors = [int(c) for c in np.unique(g[:, 0]) if int(c) \"'!= BG]\n    assert len(left_colors) == 1, '\"'expected one left-marker color'\n    left_color = left_colors[0]\n    rows = np.flatnonzero(g[:, 0] == left_color)\n    assert len(rows) == 2, 'expected two left-edge tick rows'\n    return int(rows[0]), int(rows[1]), int(cols[0]), int(cols[1])\n\n\ndef _find_legend(g: np.ndarray) -> tuple[int, list[int], list[int]]:\n    h, w = g.shape\n    for c in range(w - 1, max(-1, w - 4), -1):\n        rows = np.flatnonzero(g[:, c] \"'!= BG)\n        if len(rows) < 2:\n            continue\n        if rows[-1] != h - 1:\n            continue\n        if rows[0] < h // 2:\n            continue\n        if not np.all(np.diff(rows) == 1):\n            continue\n        if c < w - 1 and np.any(g[:, c + 1 :] != BG):\n            continue\n        colors = [int(g[r, c]) for r in rows]\n        if len(colors) != len(set(colors)):\n            continue\n        return int(c), [int(r) for r in rows], colors\n    raise AssertionError('\"'legend not found')\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, 'expected a 2D grid'\n    crop_r0, crop_r1, crop_c0, crop_c1 = _find_crop_window(g)\n    legend_c, legend_rows, depth_order = _find_legend(g)\n\n    scene = g.copy()\n    scene[legend_rows, legend_c] = BG\n    out = np.full((crop_r1 - crop_r0 + 1, crop_c1 - crop_c0 + 1), BG, dtype=int)\n    for color in depth_order:\n        pts = np.argwhere(scene == color)\n        assert len(pts) > 0, 'every legend color must have a visible rectangle fragment'\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        rr0 = max(int(r0), crop_r0)\n        rr1 = min(int(r1), crop_r1)\n        cc0 = max(int(c0), crop_c0)\n        cc1 = min(int(c1), crop_c1)\n        if rr0 <= rr1 and cc0 <= cc1:\n            out[rr0 - crop_r0 : rr1 - crop_r0 + 1, cc0 - crop_c0 : cc1 - crop_c0 + 1] = color\n    return out\n\n\ndef _render_rectangles(shape: tuple[int, int], rectangles: dict[int, tuple[int, int, int, int]], order: list[int]) -> np.ndarray:\n    g = np.full(shape, BG, dtype=int)\n    for color in order:\n        r0, c0, r1, c1 = rectangles[color]\n        g[r0 : r1 + 1, c0 : c1 + 1] = color\n    return g\n\n\ndef _compose_crop(rectangles: dict[int, tuple[int, int, int, int]], order: list[int], crop_r0: int, crop_r1: int, crop_c0: int, crop_c1: int) -> np.ndarray:\n    out = np.full((crop_r1 - crop_r0 + 1, crop_c1 - crop_c0 + 1), BG, dtype=int)\n    for color in order:\n        r0, c0, r1, c1 = rectangles[color]\n        rr0 = max(r0, crop_r0)\n        rr1 = min(r1, crop_r1)\n        cc0 = max(c0, crop_c0)\n        cc1 = min(c1, crop_c1)\n        if rr0 <= rr1 and cc0 <= cc1:\n            out[rr0 - crop_r0 : rr1 - crop_r0 + 1, cc0 - crop_c0 : cc1 - crop_c0 + 1] = color\n    return out\n\n\ndef _valid_visible_bboxes(scene: np.ndarray, rectangles: dict[int, tuple[int, int, int, int]]) -> bool:\n    for color, bbox in rectangles.items():\n        pts = np.argwhere(scene == color)\n        if len(pts) == 0:\n            return False\n        mins = tuple(map(int, pts.min(axis=0)))\n        maxs = tuple(map(int, pts.max(axis=0)))\n        if mins \"'!= bbox[:2] or maxs != bbox[2:]:\n            return False\n    return True\n\n\ndef _gen_nested_rectangles(h: int, w: int, crop_r0: int, crop_r1: int, crop_c0: int, crop_c1: int, rect_colors: list[int]) -> dict[int, tuple[int, int, int, int]] | None:\n    rect_count = len(rect_colors)\n    margin = rect_count - 1\n\n    top_candidates = list(range(max(2, crop_r0 - 2), min(crop_r0 + 2, crop_r1 - 2 * margin) + 1))\n    left_candidates = list(range(max(2, crop_c0 - 2), min(crop_c0 + 2, crop_c1 - 2 * margin) + 1))\n    if not top_candidates or not left_candidates:\n        return None\n\n    top = random.choice(top_candidates)\n    left = random.choice(left_candidates)\n    bottom_min = max(crop_r1 - 1, top + 2 * margin + 1)\n    bottom_max = min(h - 2, crop_r1 + 2)\n    right_min = max(crop_c1 - 1, left + 2 * margin + 1)\n    right_max = min(w - 2, crop_c1 + 2)\n    if bottom_min > bottom_max or right_min > right_max:\n        return None\n\n    bottom = random.randint(bottom_min, bottom_max)\n    right = random.randint(right_min, right_max)\n    if top <= crop_r0 and left <= crop_c0 and bottom >= crop_r1 and right >= crop_c1:\n        adjustments = []\n        if crop_r0 + 1 < bottom - 2 * margin:\n            adjustments.append((crop_r0 + 1, left, bottom, right))\n        if crop_c0 + 1 < right - 2 * margin:\n            adjustments.append((top, crop_c0 + 1, bottom, right))\n        if top + 2 * margin < crop_r1 - 1:\n            adjustments.append((top, left, crop_r1 - 1, right))\n        if left + 2 * margin < crop_c1 - 1:\n            adjustments.append((top, left, bottom, crop_c1 - 1))\n        if not adjustments:\n            return None\n        top, left, bottom, right = random.choice(adjustments)\n\n    boxes = [(top, left, bottom, right)]\n    for _ in range(1, rect_count):\n        prev_top, prev_left, prev_bottom, prev_right = boxes[-1]\n        choices = []\n        for dt in (1, 2):\n            for dl in (1, 2):\n                for db in (1, 2):\n                    for dr in (1, 2):\n                        nxt = (prev_top + dt, prev_left + dl, prev_bottom - db, prev_right - dr)\n                        nt, nl, nb, nr = nxt\n                        if nb - nt + 1 < 2 or nr - nl + 1 < 2:\n                            continue\n                        choices.append(nxt)\n        if not choices:\n            return None\n        boxes.append(random.choice(choices))\n\n    return {color: box for color, box in zip(rect_colors, boxes)}\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rect_count = random.randint(*RECT_COUNT_RANGE)\n    crop_r0 = random.randint(*CROP_START_RANGE)\n    crop_c0 = random.randint(*CROP_START_RANGE)\n\n    min_out_h = max(OUTPUT_H_RANGE[0], 2 * rect_count)\n    min_out_w = max(OUTPUT_W_RANGE[0], 2 * rect_count)\n    max_out_h = min(OUTPUT_H_RANGE[1], 30 - crop_r0 - rect_count - 2)\n    max_out_w = min(OUTPUT_W_RANGE[1], 30 - crop_c0 - 2)\n    if max_out_h < min_out_h or max_out_w < min_out_w:\n        return None\n\n    out_h = random.randint(min_out_h, max_out_h)\n    out_w = random.randint(min_out_w, max_out_w)\n    crop_r1 = crop_r0 + out_h - 1\n    crop_c1 = crop_c0 + out_w - 1\n\n    min_h = crop_r1 + rect_count + 2\n    min_w = crop_c1 + 2\n    if min_h > 30 or min_w > 30:\n        return None\n    h = random.randint(min_h, min(30, min_h + 4))\n    w = random.randint(min_w, min(30, min_w + 4))\n\n    palette = random.sample(range(1, 10), rect_count + 2)\n    top_marker_color = palette[0]\n    left_marker_color = palette[1]\n    rect_colors = palette[2:]\n\n    rectangles = _gen_nested_rectangles(h, w, crop_r0, crop_r1, crop_c0, crop_c1, rect_colors)\n    if rectangles is None:\n        return None\n\n    input_order = rect_colors[:]\n    depth_order = rect_colors[:]\n    for _ in range(80):\n        random.shuffle(depth_order)\n        if depth_order != input_order and depth_order[-1] != rect_colors[0]:\n            break\n    else:\n        return None\n\n    scene = _render_rectangles((h, w), rectangles, input_order)\n    if not _valid_visible_bboxes(scene, rectangles):\n        return None\n\n    expected = _compose_crop(rectangles, depth_order, crop_r0, crop_r1, crop_c0, crop_c1)\n    crop_scene = scene[crop_r0 : crop_r1 + 1, crop_c0 : crop_c1 + 1]\n    if np.array_equal(crop_scene, expected):\n        return None\n    if len(set(map(int, np.unique(expected))) - {BG}) < 2:\n        return None\n    if not np.any(expected == BG):\n        return None\n\n    grid = scene.copy()\n    grid[: random.choice(EDGE_TICK_LENGTHS), crop_c0] = top_marker_color\n    grid[: random.choice(EDGE_TICK_LENGTHS), crop_c1] = top_marker_color\n    grid[crop_r0, : random.choice(EDGE_TICK_LENGTHS)] = left_marker_color\n    grid[crop_r1, : random.choice(EDGE_TICK_LENGTHS)] = left_marker_color\n\n    legend_rows = list(range(h - rect_count, h))\n    for row, color in zip(legend_rows, depth_order):\n        grid[row, w - 1] = color\n\n    if list(map(int, np.flatnonzero(grid[:, w - 1] != BG))) != legend_rows:\n        return None\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError('\"'failed to generate a valid input')\n\nsigs=set()\nfor i in range(100):\n    inp=generate_input()\n    out=main(inp)\n    assert isinstance(inp,np.ndarray)\n    assert isinstance(out,np.ndarray)\n    assert inp.ndim == 2 and max(inp.shape) <= 30, inp.shape\n    assert out.ndim == 2 and max(out.shape) <= 30, out.shape\n    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())\nprint('variants', len(sigs))\nassert len(sigs) >= 20\nPY\"","aggregated_output":"variants 100\n","exit_code":0,"status":"completed"}}
