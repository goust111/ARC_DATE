{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nimport numpy as np\n\nBG = 0\nRECT_COUNT_RANGE = (3, 5)\nCROP_START_RANGE = (2, 6)\nOUTPUT_H_RANGE = (6, 11)\nOUTPUT_W_RANGE = (6, 11)\nRECT_EXT_RANGE = (0, 3)\nMAX_GENERATION_ATTEMPTS = 800\n\n\ndef _find_crop_window(g: np.ndarray):\n    top_colors = [int(c) for c in np.unique(g[0, :]) if int(c) \"'!= BG]\n    assert len(top_colors) == 1\n    top_color = top_colors[0]\n    cols = np.flatnonzero(g[0, :] == top_color)\n    assert len(cols) == 2\n\n    left_colors = [int(c) for c in np.unique(g[:, 0]) if int(c) != BG]\n    assert len(left_colors) == 1\n    left_color = left_colors[0]\n    rows = np.flatnonzero(g[:, 0] == left_color)\n    assert len(rows) == 2\n    return int(rows[0]), int(rows[1]), int(cols[0]), int(cols[1])\n\n\ndef _find_legend(g: np.ndarray):\n    h, w = g.shape\n    for c in range(w - 1, max(-1, w - 4), -1):\n        rows = np.flatnonzero(g[:, c] != BG)\n        if len(rows) < 2:\n            continue\n        if rows[-1] != h - 1:\n            continue\n        if not np.all(np.diff(rows) == 1):\n            continue\n        if rows[0] < h // 2:\n            continue\n        if c < w - 1 and np.any(g[:, c + 1 :] != BG):\n            continue\n        colors = [int(g[r, c]) for r in rows]\n        if len(colors) != len(set(colors)):\n            continue\n        return c, [int(r) for r in rows], colors\n    raise AssertionError('\"'legend not found')\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    g = np.asarray(grid, dtype=int)\n    crop_r0, crop_r1, crop_c0, crop_c1 = _find_crop_window(g)\n    legend_c, legend_rows, depth_order = _find_legend(g)\n    scene = g.copy()\n    scene[legend_rows, legend_c] = BG\n    out = np.full((crop_r1 - crop_r0 + 1, crop_c1 - crop_c0 + 1), BG, dtype=int)\n    for color in depth_order:\n        pts = np.argwhere(scene == color)\n        assert len(pts) > 0\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        rr0 = max(int(r0), crop_r0)\n        rr1 = min(int(r1), crop_r1)\n        cc0 = max(int(c0), crop_c0)\n        cc1 = min(int(c1), crop_c1)\n        if rr0 <= rr1 and cc0 <= cc1:\n            out[rr0 - crop_r0 : rr1 - crop_r0 + 1, cc0 - crop_c0 : cc1 - crop_c0 + 1] = color\n    return out\n\n\ndef _render_rectangles(shape, rectangles, order):\n    g = np.full(shape, BG, dtype=int)\n    for color in order:\n        r0, c0, r1, c1 = rectangles[color]\n        g[r0 : r1 + 1, c0 : c1 + 1] = color\n    return g\n\n\ndef _compose_crop(rectangles, order, crop_r0, crop_r1, crop_c0, crop_c1):\n    out = np.full((crop_r1 - crop_r0 + 1, crop_c1 - crop_c0 + 1), BG, dtype=int)\n    for color in order:\n        r0, c0, r1, c1 = rectangles[color]\n        rr0 = max(r0, crop_r0)\n        rr1 = min(r1, crop_r1)\n        cc0 = max(c0, crop_c0)\n        cc1 = min(c1, crop_c1)\n        if rr0 <= rr1 and cc0 <= cc1:\n            out[rr0 - crop_r0 : rr1 - crop_r0 + 1, cc0 - crop_c0 : cc1 - crop_c0 + 1] = color\n    return out\n\n\ndef _valid_visible_bboxes(scene, rectangles):\n    for color, bbox in rectangles.items():\n        pts = np.argwhere(scene == color)\n        if len(pts) == 0:\n            return False\n        mins = tuple(map(int, pts.min(axis=0)))\n        maxs = tuple(map(int, pts.max(axis=0)))\n        if mins \"'!= bbox[:2] or maxs != bbox[2:]:\n            return False\n    return True\n\n\ndef _gen_attempt():\n    rect_count = random.randint(*RECT_COUNT_RANGE)\n    crop_r0 = random.randint(*CROP_START_RANGE)\n    crop_c0 = random.randint(*CROP_START_RANGE)\n\n    max_out_h = min(OUTPUT_H_RANGE[1], 30 - crop_r0 - rect_count - 1)\n    max_out_w = min(OUTPUT_W_RANGE[1], 30 - crop_c0 - 2)\n    if max_out_h < OUTPUT_H_RANGE[0] or max_out_w < OUTPUT_W_RANGE[0]:\n        return None\n    out_h = random.randint(OUTPUT_H_RANGE[0], max_out_h)\n    out_w = random.randint(OUTPUT_W_RANGE[0], max_out_w)\n    crop_r1 = crop_r0 + out_h - 1\n    crop_c1 = crop_c0 + out_w - 1\n\n    min_h = crop_r1 + rect_count + 1\n    min_w = crop_c1 + 2\n    if min_h > 30 or min_w > 30:\n        return None\n    h = random.randint(min_h, min(30, min_h + 4))\n    w = random.randint(min_w, min(30, min_w + 4))\n\n    legend_rows = list(range(h - rect_count, h))\n    if crop_r1 >= legend_rows[0] - 1:\n        return None\n\n    colors = random.sample(range(1, 10), rect_count + 2)\n    top_marker, left_marker = colors[:2]\n    rect_colors = colors[2:]\n    depth_order = rect_colors[:]\n    random.shuffle(depth_order)\n\n    anchor_r = random.randint(crop_r0 + 1, crop_r1 - 1)\n    anchor_c = random.randint(crop_c0 + 1, crop_c1 - 1)\n    top_floor = max(2, crop_r0 - RECT_EXT_RANGE[1])\n    left_floor = max(2, crop_c0 - RECT_EXT_RANGE[1])\n    bottom_ceil = min(h - 2, crop_r1 + RECT_EXT_RANGE[1])\n    right_ceil = min(w - 2, crop_c1 + RECT_EXT_RANGE[1])\n\n    rectangles = {}\n    seen_boxes = set()\n    for color in rect_colors:\n        for _ in range(50):\n            top = random.randint(top_floor, min(anchor_r, crop_r1 - 1))\n            left = random.randint(left_floor, min(anchor_c, crop_c1 - 1))\n            bottom = random.randint(max(anchor_r, top + 1), bottom_ceil)\n            right = random.randint(max(anchor_c, left + 1), right_ceil)\n            box = (top, left, bottom, right)\n            if box not in seen_boxes:\n                rectangles[color] = box\n                seen_boxes.add(box)\n                break\n        else:\n            return None\n\n    input_order = rect_colors[:]\n    for _ in range(20):\n        random.shuffle(input_order)\n        if input_order != depth_order:\n            break\n    else:\n        return None\n\n    scene = _render_rectangles((h, w), rectangles, input_order)\n    if not _valid_visible_bboxes(scene, rectangles):\n        return None\n\n    expected = _compose_crop(rectangles, depth_order, crop_r0, crop_r1, crop_c0, crop_c1)\n    crop_scene = scene[crop_r0 : crop_r1 + 1, crop_c0 : crop_c1 + 1]\n    if np.array_equal(crop_scene, expected):\n        return None\n    visible_out_colors = set(map(int, np.unique(expected))) - {BG}\n    if len(visible_out_colors) < 2:\n        return None\n    if not np.any(expected == BG):\n        return None\n\n    grid = scene.copy()\n    grid[: random.choice((1, 2)), crop_c0] = top_marker\n    grid[: random.choice((1, 2)), crop_c1] = top_marker\n    grid[crop_r0, : random.choice((1, 2))] = left_marker\n    grid[crop_r1, : random.choice((1, 2))] = left_marker\n    for row, color in zip(legend_rows, depth_order):\n        grid[row, w - 1] = color\n\n    if np.any(grid[:, w - 1] != 0) and list(np.flatnonzero(grid[:, w - 1] != 0)) != legend_rows:\n        return None\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid, expected\n\ncount=0\nfor i in range(1000):\n    x = _gen_attempt()\n    if x is not None:\n        count += 1\nprint('\"'generated', count)\nfor i in range(20):\n    inp,out = _gen_attempt()\n    assert inp.shape[0] <= 30 and inp.shape[1] <= 30\n    assert out.shape[0] <= 30 and out.shape[1] <= 30\nprint('ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
