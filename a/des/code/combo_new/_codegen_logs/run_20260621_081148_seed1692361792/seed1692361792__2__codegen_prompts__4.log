{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nimport numpy as np\nfrom collections import Counter\n\nBG = 0\nRECT_COUNT_RANGE = (3, 5)\nCROP_START_RANGE = (2, 6)\nOUTPUT_H_RANGE = (6, 11)\nOUTPUT_W_RANGE = (6, 11)\nMAX_ATTEMPTS = 1000\n\n\ndef _render_rectangles(shape, rectangles, order):\n    g = np.full(shape, BG, dtype=int)\n    for color in order:\n        r0, c0, r1, c1 = rectangles[color]\n        g[r0 : r1 + 1, c0 : c1 + 1] = color\n    return g\n\n\ndef _compose_crop(rectangles, order, crop_r0, crop_r1, crop_c0, crop_c1):\n    out = np.full((crop_r1 - crop_r0 + 1, crop_c1 - crop_c0 + 1), BG, dtype=int)\n    for color in order:\n        r0, c0, r1, c1 = rectangles[color]\n        rr0 = max(r0, crop_r0)\n        rr1 = min(r1, crop_r1)\n        cc0 = max(c0, crop_c0)\n        cc1 = min(c1, crop_c1)\n        if rr0 <= rr1 and cc0 <= cc1:\n            out[rr0 - crop_r0 : rr1 - crop_r0 + 1, cc0 - crop_c0 : cc1 - crop_c0 + 1] = color\n    return out\n\n\ndef _valid_visible_bboxes(scene, rectangles):\n    for color, bbox in rectangles.items():\n        pts = np.argwhere(scene == color)\n        if len(pts) == 0:\n            return False\n        mins = tuple(map(int, pts.min(axis=0)))\n        maxs = tuple(map(int, pts.max(axis=0)))\n        if mins \"'!= bbox[:2] or maxs != bbox[2:]:\n            return False\n    return True\n\n\ndef _gen_nested_rectangles(h, w, crop_r0, crop_r1, crop_c0, crop_c1, rect_colors):\n    rect_count = len(rect_colors)\n    anchor_r = random.randint(crop_r0 + 1, crop_r1 - 1)\n    anchor_c = random.randint(crop_c0 + 1, crop_c1 - 1)\n\n    top = random.randint(max(2, crop_r0 - 2), min(anchor_r - 1, crop_r0 + 1))\n    left = random.randint(max(2, crop_c0 - 2), min(anchor_c - 1, crop_c0 + 1))\n    bottom = random.randint(max(anchor_r + 1, crop_r1 - 1), min(h - 2, crop_r1 + 2))\n    right = random.randint(max(anchor_c + 1, crop_c1 - 1), min(w - 2, crop_c1 + 2))\n\n    boxes = [(top, left, bottom, right)]\n    for _ in range(1, rect_count):\n        prev_top, prev_left, prev_bottom, prev_right = boxes[-1]\n        max_dt = min(2, anchor_r - prev_top)\n        max_dl = min(2, anchor_c - prev_left)\n        max_db = min(2, prev_bottom - anchor_r)\n        max_dr = min(2, prev_right - anchor_c)\n        deltas = []\n        for dt in range(max_dt + 1):\n            for dl in range(max_dl + 1):\n                for db in range(max_db + 1):\n                    for dr in range(max_dr + 1):\n                        if dt == dl == db == dr == 0:\n                            continue\n                        nt = prev_top + dt\n                        nl = prev_left + dl\n                        nb = prev_bottom - db\n                        nr = prev_right - dr\n                        if nb - nt + 1 < 2 or nr - nl + 1 < 2:\n                            continue\n                        if not (nt <= anchor_r <= nb and nl <= anchor_c <= nr):\n                            continue\n                        deltas.append((nt, nl, nb, nr))\n        if not deltas:\n            return None\n        boxes.append(random.choice(deltas))\n\n    # reject if duplicates or if innermost too close maybe\n    if len(set(boxes)) != len(boxes):\n        return None\n    return {color: box for color, box in zip(rect_colors, boxes)}\n\n\ndef _gen_attempt():\n    rect_count = random.randint(*RECT_COUNT_RANGE)\n    crop_r0 = random.randint(*CROP_START_RANGE)\n    crop_c0 = random.randint(*CROP_START_RANGE)\n    max_out_h = min(OUTPUT_H_RANGE[1], 30 - crop_r0 - rect_count - 2)\n    max_out_w = min(OUTPUT_W_RANGE[1], 30 - crop_c0 - 2)\n    if max_out_h < OUTPUT_H_RANGE[0] or max_out_w < OUTPUT_W_RANGE[0]:\n        return '\"'size0'\n    out_h = random.randint(OUTPUT_H_RANGE[0], max_out_h)\n    out_w = random.randint(OUTPUT_W_RANGE[0], max_out_w)\n    crop_r1 = crop_r0 + out_h - 1\n    crop_c1 = crop_c0 + out_w - 1\n    min_h = crop_r1 + rect_count + 2