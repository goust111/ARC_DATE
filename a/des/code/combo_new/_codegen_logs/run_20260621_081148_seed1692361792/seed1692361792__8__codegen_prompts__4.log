{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom __future__ import annotations\nimport random\nimport numpy as np\n\nBLACK = 0\nGREY = 5\nPORTAL_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\nTRIANGLE_MASKS = {\n    \\\"ul\\\": np.array([[1, 1, 1], [1, 1, 0], [1, 0, 0]], dtype=bool),\n    \\\"ur\\\": np.array([[1, 1, 1], [0, 1, 1], [0, 0, 1]], dtype=bool),\n    \\\"dl\\\": np.array([[1, 0, 0], [1, 1, 0], [1, 1, 1]], dtype=bool),\n    \\\"dr\\\": np.array([[0, 0, 1], [0, 1, 1], [1, 1, 1]], dtype=bool),\n}\nDIR4 = [(-1,0),(1,0),(0,-1),(0,1)]\n\n\ndef neighbors4(r,c,h,w):\n    for dr,dc in DIR4:\n        rr,cc = r+dr,c+dc\n        if 0 <= rr < h and 0 <= cc < w:\n            yield rr,cc\n\n\ndef components4(mask):\n    h,w = mask.shape\n    seen = np.zeros((h,w), dtype=bool)\n    comps = []\n    for r in range(h):\n        for c in range(w):\n            if not mask[r,c] or seen[r,c]:\n                continue\n            stack = [(r,c)]\n            seen[r,c] = True\n            comp = []\n            while stack:\n                cr,cc = stack.pop()\n                comp.append((cr,cc))\n                for nr,nc in neighbors4(cr,cc,h,w):\n                    if mask[nr,nc] and not seen[nr,nc]:\n                        seen[nr,nc] = True\n                        stack.append((nr,nc))\n            comps.append(comp)\n    return comps\n\n\ndef triangle_info(coords):\n    if len(coords) \"'!= 6:\n        return None\n    rows = [r for r,_ in coords]\n    cols = [c for _,c in coords]\n    r0,r1 = min(rows), max(rows)\n    c0,c1 = min(cols), max(cols)\n    if r1-r0 != 2 or c1-c0 != 2:\n        return None\n    patch = np.zeros((3,3), dtype=bool)\n    for r,c in coords:\n        patch[r-r0,c-c0] = True\n    for name,mask in TRIANGLE_MASKS.items():\n        if np.array_equal(patch, mask):\n            return {\"cells\": tuple(sorted(coords)), \"top_left\": (r0,c0), \"name\": name}\n    return None\n\n\ndef portal_pairs(g):\n    pairs = {}\n    for color in np.unique(g):\n        color = int(color)\n        if color in (BLACK, GREY):\n            continue\n        coords = [tuple(map(int, rc)) for rc in np.argwhere(g == color)]\n        if len(coords) == 2:\n            pairs[color] = tuple(coords)\n    return pairs\n\n\ndef main(grid):\n    g = np.asarray(grid, dtype=int)\n    h,w = g.shape\n    pairs = portal_pairs(g)\n    lookup = {}\n    for color,(a,b) in pairs.items():\n        lookup[a] = (color,b)\n        lookup[b] = (color,a)\n    out = g.copy()\n    moved = []\n    for comp in components4(g == GREY):\n        info = triangle_info(comp)\n        if info is None:\n            continue\n        adjacent = set()\n        for r,c in info[\"cells\"]:\n            for rr,cc in neighbors4(r,c,h,w):\n                if (rr,cc) in lookup:\n                    adjacent.add((rr,cc))\n        if len(adjacent) != 1:\n            continue\n        a = next(iter(adjacent))\n        b = lookup[a][1]\n        dr = b[0] - a[0]\n        dc = b[1] - a[1]\n        for r,c in info[\"cells\"]:\n            out[r,c] = BLACK\n        moved.append([(r+dr,c+dc) for r,c in info[\"cells\"]])\n    for cells in moved:\n        for r,c in cells:\n            out[r,c] = GREY\n    return out\n\n\ndef mask_cells(mask, top_left):\n    r0,c0 = top_left\n    return {(r0+r, c0+c) for r in range(3) for c in range(3) if mask[r,c]}\n\n\ndef portal_offsets(mask, side):\n    if side == '\"'up':\n        return [(-1, c) for c in range(3) if mask[0,c]]\n    if side == 'down':\n        return [(3, c) for c in range(3) if mask[2,c]]\n    if side == 'left':\n        return [(r, -1) for r in range(3) if mask[r,0]]\n    return [(r, 3) for r in range(3) if mask[r,2]]\n\n\ndef valid_tops(h,w,side):\n    if side == 'up':\n        rows = range(1, h-2)\n        cols = range(0, w-2)\n    elif side == 'down':\n        rows = range(0, h-3)\n        cols = range(0, w-2)\n    elif side == 'left':\n        rows = range(0, h-2)\n        cols = range(1, w-2)\n    else:\n        rows = range(0, h-2)\n        cols = range(0, w-3)\n    return [(r,c) for r in rows for c in cols]\n\n\ndef expand(cells,h,w):\n    out = set()\n    for r,c in cells:\n        for dr in (-1,0,1):\n            for dc in (-1,0,1):\n                rr,cc = r+dr,c+dc\n                if 0 <= rr < h and 0 <= cc < w:\n                    out.add((rr,cc))\n    return out\n\n\ndef separated(cells_a, cells_b):\n    for r,c in cells_a:\n        for rr,cc in cells_b:\n            if max(abs(r-rr), abs(c-cc)) <= 1:\n                return False\n    return True\n\n\ndef gen_attempt():\n    h = random.randint(16,24)\n    w = random.randint(16,24)\n    n_arrows = random.randint(2,4)\n    colors = random.sample(PORTAL_COLORS, n_arrows)\n    grid = np.zeros((h,w), dtype=int)\n    blocked = set()\n    groups = []\n    sides = ['up','down','left','right']\n    orientations = list(TRIANGLE_MASKS)\n    for idx in range(n_arrows):\n        color = colors[idx]\n        side = random.choice(sides)\n        name = random.choice(orientations)\n        mask = TRIANGLE_MASKS[name]\n        top_lefts = valid_tops(h,w,side)\n        random.shuffle(top_lefts)\n        placed = False\n        for src_top in top_lefts[:160]:\n            src_cells = mask_cells(mask, src_top)\n            offs = portal_offsets(mask, side)\n            random.shuffle(offs)\n            for off in offs:\n                a = (src_top[0] + off[0], src_top[1] + off[1])\n                src_zone = set(src_cells)\n                src_actual = src_zone | {a}\n                if src_actual & blocked:\n                    continue\n                dst_tops = valid_tops(h,w,side)\n                random.shuffle(dst_tops)\n                for dst_top in dst_tops[:220]:\n                    if dst_top == src_top:\n                        continue\n                    dst_cells = mask_cells(mask, dst_top)\n                    b = (dst_top[0] + off[0], dst_top[1] + off[1])\n                    dst_zone = set(dst_cells) | {b}\n                    reserved = src_actual | dst_zone | dst_cells\n                    if len(reserved) \"'!= len(src_actual) + len(dst_zone | dst_cells):\n                        continue\n                    if reserved & blocked:\n                        continue\n                    if not separated(src_actual, dst_zone):\n                        continue\n                    ok = True\n                    for r,c in src_cells:\n                        for rr,cc in neighbors4(r,c,h,w):\n                            if (rr,cc) == b:\n                                ok = False\n                    if not ok:\n                        continue\n                    for rr,cc in neighbors4(*a,h,w):\n                        if (rr,cc) == b:\n                            ok = False\n                    if not ok:\n                        continue\n                    groups.append((color, src_cells, a, b, dst_cells))\n                    for r,c in src_cells:\n                        grid[r,c] = GREY\n                    grid[a] = color\n                    grid[b] = color\n                    blocked |= expand(src_cells | dst_cells | {a,b}, h, w)\n                    placed = True\n                    break\n                if placed:\n                    break\n            if placed:\n                break\n        if not placed:\n            return None\n    expected = grid.copy()\n    for _color, src_cells, _a, _b, dst_cells in groups:\n        for cell in src_cells:\n            expected[cell] = BLACK\n    for _color, _src_cells, _a, _b, dst_cells in groups:\n        for cell in dst_cells:\n            expected[cell] = GREY\n    out = main(grid)\n    if not np.array_equal(out, expected):\n        print('\"'mismatch')\n        print(grid)\n        print(out)\n        print(expected)\n        return None\n    comps = [triangle_info(c) for c in components4(grid==GREY)]\n    if len([c for c in comps if c]) \"'!= n_arrows:\n        return None\n    return grid\n\nsuccess = 0\nfor i in range(100):\n    g = None\n    for _ in range(400):\n        g = gen_attempt()\n        if g is not None:\n            break\n    if g is None:\n        print('\"'failed at', i)\n        break\n    success += 1\nprint('success', success)\nif success == 100:\n    print('shapes ok', max(g.shape))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
