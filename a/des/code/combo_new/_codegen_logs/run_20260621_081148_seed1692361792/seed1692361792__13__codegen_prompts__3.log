ique matching column interval in the reference band.\n    45\t    - Take the color from the next reference-band column immediately to the right of that matched interval.\n    46\t    - Sort the bars by their spatial order from left to right, then top to bottom, and output those extracted colors as a single row.\n    47\t\n    48\t    Key insight:\n    49\t    - Each scattered bar is only a lookup key into the top band; the answer is the one-column offset color that follows the matched segment.\n    50\t    \"\"\"\n    51\t    g = np.asarray(grid, dtype=int)\n    52\t    sep_row = next(r for r in range(g.shape[0]) if np.all(g[r] == SEP))\n    53\t    band = g[:sep_row]\n    54\t    ref = band[0]\n    55\t    assert np.all(band == ref)\n    56\t\n    57\t    pieces = []\n    58\t    for comp in _components(g[sep_row + 1 :] != BG):\n    59\t        comp = [(r + sep_row + 1, c) for r, c in comp]\n    60\t        rows = {r for r, _ in comp}\n    61\t        assert len(rows) == 1\n    62\t        r = next(iter(rows))\n    63\t        cols = sorted(c for _, c in comp)\n    64\t        c0, c1 = cols[0], cols[-1]\n    65\t        segment = tuple(map(int, g[r, c0 : c1 + 1]))\n    66\t        hits = []\n    67\t        for start in range(len(ref) - len(segment)):\n    68\t            if tuple(map(int, ref[start : start + len(segment)])) == segment:\n    69\t                hits.append(start)\n    70\t        assert len(hits) == 1\n    71\t        pieces.append((c0, r, int(ref[hits[0] + len(segment)])))\n    72\t    pieces.sort()\n    73\t    return np.array([[color for _, _, color in pieces]], dtype=int)\n    74\t\n    75\t\n    76\tdef generate_input() -> np.ndarray:\n    77\t    for _ in range(400):\n    78\t        width = random.randint(12, 24)\n    79\t        band_h = random.randint(3, 4)\n    80\t        piece_count = random.randint(3, 6)\n    81\t        total_h = band_h + 1 + random.randint(6, 12)\n    82\t        grid = np.zeros((total_h, width), dtype=int)\n    83\t\n    84\t        colors = [1, 2, 3, 4, 6, 7, 8, 9]\n    85\t        ref = []\n    86\t        while len(ref) < width:\n    87\t            choices = [c for c in colors if not ref or c != ref[-1]]\n    88\t            ref.append(random.choice(choices))\n    89\t        # make windows unique\n    90\t        ok = True\n    91\t        for L in range(3, 6):\n    92\t            seen = {}\n    93\t            for s in range(width - L):\n    94\t                key = tuple(ref[s : s + L])\n    95\t                if key in seen:\n    96\t                    ok = False\n    97\t                    break\n    98\t                seen[key] = s\n    99\t            if not ok:\n   100\t                break\n   101\t        if not ok:\n   102\t            continue\n   103\t\n   104\t        for r in range(band_h):\n   105\t            grid[r] = ref\n   106\t        grid[band_h, :] = SEP\n   107\t\n   108\t        starts = random.sample(range(width - 5), piece_count)\n   109\t        starts.sort()\n   110\t        used = set()\n   111\t        placements = []\n   112\t        for s in starts:\n   113\t            L = random.randint(3, 5)\n   114\t            if s + L >= width:\n   115\t                continue\n   116\t            placed = False\n   117\t            for _attempt in range(80):\n   118\t                r = random.randint(band_h + 1, total_h - 1)\n   119\t                c = random.randint(0, width - L)\n   120\t                cells = {(r, cc) for cc in range(c, c + L)}\n   121\t                if cells & used:\n   122\t                    continue\n   123\t                placements.append((r, c, s, L))\n   124\t                used |= cells\n   125\t                placed = True\n   126\t                break\n   127\t            if not placed:\n   128\t                ok = False\n   129\t                break\n   130\t        if not ok or len(placements) != piece_count:\n   131\t            continue\n   132\t\n   133\t        for r, c, s, L in placements:\n 