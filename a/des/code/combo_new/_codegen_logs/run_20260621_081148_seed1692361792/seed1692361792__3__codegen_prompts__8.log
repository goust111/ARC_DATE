{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n    '/home/lixinyu/snap/new/ARC_code/train/278e5215.py',\n    '/home/lixinyu/snap/new/ARC_code/train/5623160b.py',\n    '/home/lixinyu/snap/new/ARC_code/train/652646ff.py',\n    '/home/lixinyu/snap/new/ARC_code/eval/16b78196.py',\n]\nfor path in files:\n    print(f'===== {path} =====')\n    lines = Path(path).read_text().splitlines()\n    starts = []\n    for i, line in enumerate(lines):\n        if line.startswith('def main(') or line.startswith('def generate_input('):\n            starts.append(i)\n    for idx, start in enumerate(starts):\n        end = starts[idx + 1] if idx + 1 < len(starts) else min(len(lines), start + 180)\n        for j in range(start, min(end, start + 160)):\n            print(f'{j + 1}: {lines[j]}')\n        print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/train/278e5215.py =====\n50: def main(grid: np.ndarray) -> np.ndarray:\n51:     \"\"\"\n52:     Recolor the large mask crop column-by-column using the separate three-row palette strip.\n53: \n54:     Input structure:\n55:     - The background is the most common color.\n56:     - One large monochrome foreground object is the mask; its bbox is the output region and may contain background holes.\n57:     - The remaining foreground is a 3-row palette rectangle with the same width as the mask bbox: two identical color rows and one uniform row.\n58: \n59:     Rule:\n60:     - Crop to the mask object's bbox.\n61:     - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n62:     - Replace background holes inside the crop with the palette's uniform third-row color.\n63: \n64:     Key insight:\n65:     The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n66:     \"\"\"\n67:     g = np.asarray(grid, dtype=int)\n68:     bg = get_bg(g)\n69:     mask_color = _unique_largest_non_bg_color(g, bg)\n70: \n71:     b = _mask_bbox(g, mask_color)\n72:     mask_crop = crop_bbox(g == int(mask_color), b)\n73:     height, width = map(int, mask_crop.shape)\n74: \n75:     column_colors, hole_color = _palette(g, bg, mask_color, width)\n76:     out = np.tile(column_colors, (height, 1))\n77:     out[~mask_crop] = hole_color\n78:     return out\n79: \n80: # --------------- generator (o5x) ---------------\n81: \n82: # Canvas, colors, and object bounds.\n83: BACKGROUND_COLOR, MASK_COLOR = 0, 5\n84: COLOR_MIN, COLOR_MAX = 1, 9\n85: GRID_SIDE_MIN, GRID_SIDE_MAX = 10, 18\n86: MASK_SIDE_MIN, MASK_SIDE_MAX = 5, 10\n87: PALETTE_HEIGHT = 3\n88: GAP_MIN, GAP_MAX = 1, 3\n89: \n90: # Palette run construction.\n91: RUN_COUNT_OPTIONS = (4, 5)\n92: RUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3\n93: COLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5\n94: UNUSED_COLOR_BIAS = 0.7\n95: \n96: # Mask density and retry budget.\n97: MASK_DENSITY_MIN, MASK_DENSITY_MAX = 0.60, 0.71\n98: GENERATION_ATTEMPTS = 300\n99: \n100: \n101: def _valid_run_lengths(width: int, n_runs: int) -> list[tuple[int, ...]]:\n102:     length_range = range(RUN_LENGTH_MIN, RUN_LENGTH_MAX + 1)\n103:     return [\n104:         tuple(int(x) for x in lengths)\n105:         for lengths in product(length_range, repeat=int(n_runs))\n106:         if sum(lengths) == int(width)\n107:     ]\n108: \n109: \n110: def _run_colors(colors: list[int], n_runs: int) -> list[int]:\n111:     seq: list[int] = []\n112:     unused = set(colors)\n113:     for i in range(int(n_runs)):\n114:         slots_left = int(n_runs) - i\n115:         choices = [c for c in colors if not seq or c != seq[-1]]\n116:         if len(unused) >= slots_left:\n117:             choices = [c for c in choices if c in unused]\n118:         elif unused and random.random() < UNUSED_COLOR_BIAS:\n119:             preferred = [c for c in choices if c in unused]\n120:             if preferred:\n121:                 choices = preferred\n122:         color = random.choice(choices)\n123:         seq.append(int(color))\n124:         unused.discard(int(color))\n125:     return seq\n126: \n127: \n128: def _palette_row(width: int, colors: list[int]) -> np.ndarray:\n129:     valid_counts = [\n130:         n_runs for n_runs in RUN_COUNT_OPTIONS if _valid_run_lengths(int(width), n_runs)\n131:     ]\n132:     n_runs = random.choice(valid_counts)\n133:     valid_lengths = _valid_run_lengths(int(width), n_runs)\n134:     lengths = random.choice(valid_lengths)\n135:     n_distinct = random.randint(\n136:         COLUMN_COLOR_DISTINCT_MIN, min(COLUMN_COLOR_DISTINCT_MAX, n_runs)\n137:     )\n138:     chosen = random.sample(colors, n_distinct)\n139:     seq = _run_colors(chosen, n_runs)\n140:     return np.repeat(seq, lengths).astype(int)\n141: \n142: \n143: def _neighbors4(r: int, c: int, h: int, w: int):\n144:     if r > 0:\n145:         yield r - 1, c\n146:     if r + 1 < h:\n147:         yield r + 1, c\n148:     if c > 0:\n149:         yield r, c - 1\n150:     if c + 1 < w:\n151:         yield r, c + 1\n152: \n153: \n154: def _connected_mask(height: int, width: int, target_area: int) -> np.ndarray | None:\n155:     \"\"\"Grow a connected mask with full row/column span to the target area.\"\"\"\n156:     mask = np.zeros((int(height), int(width)), dtype=bool)\n157:     steps = [\"D\"] * (int(height) - 1) + [\"R\"] * (int(width) - 1)\n158:     random.shuffle(steps)\n159: \n160:     r = c = 0\n161:     mask[r, c] = True\n162:     for step in steps:\n163:         if step == \"D\":\n164:             r += 1\n165:         else:\n166:             c += 1\n167:         mask[r, c] = True\n168: \n169:     if int(mask.sum()) > int(target_area):\n170:         return None\n171: \n172:     frontier: set[tuple[int, int]] = set()\n173: \n174:     def add_frontier(rr: int, cc: int) -> None:\n175:         for nr, nc in _neighbors4(rr, cc, int(height), int(width)):\n176:             if not mask[nr, nc]:\n177:                 frontier.add((int(nr), int(nc)))\n178: \n179:     for rr, cc in np.argwhere(mask):\n180:         add_frontier(int(rr), int(cc))\n181: \n182:     while int(mask.sum()) < int(target_area):\n183:         if not frontier:\n184:             return None\n185:         cell = random.choice(tuple(frontier))\n186:         frontier.remove(cell)\n187:         rr, cc = cell\n188:         mask[rr, cc] = True\n189:         add_frontier(rr, cc)\n190: \n191:     return mask\n192: \n193: \n194: def _grid_choices(mask_h: int, mask_w: int, gap: int) -> list[tuple[int, int]]:\n195:     \"\"\"Grid sizes where the mask remains the unique largest non-bg object.\"\"\"\n196:     max_mask = int(np.floor(MASK_DENSITY_MAX * int(mask_h) * int(mask_w)))\n197:     min_h = max(GRID_SIDE_MIN, int(mask_h) + PALETTE_HEIGHT + int(gap))\n198:     min_w = max(GRID_SIDE_MIN, int(mask_w))\n199:     choices: list[tuple[int, int]] = []\n200:     for h in range(min_h, GRID_SIDE_MAX + 1):\n201:         for w in range(min_w, GRID_SIDE_MAX + 1):\n202:             if h * w - max_mask - PALETTE_HEIGHT * int(mask_w) > max_mask:\n203:                 choices.append((h, w))\n204:     return choices\n205: \n206: \n207: def _sample_dimensions() -> tuple[int, int, int, int, int] | None:\n208:     \"\"\"Sample mask size, layout gap, and compatible grid size.\"\"\"\n209:     mask_h = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)\n\n275: def generate_input() -> np.ndarray:\n276:     for _ in range(GENERATION_ATTEMPTS):\n277:         grid = _gen_attempt()\n278:         if grid is not None:\n279:             return grid\n280:     raise RuntimeError(\"failed to generate valid input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/5623160b.py =====\n43: def main(grid: np.ndarray) -> np.ndarray:\n44:     \"\"\"\n45:     Push every colored object touching maroon markers straight outward until it reaches the grid edge.\n46: \n47:     Input structure:\n48:     - The background is the dominant color.\n49:     - Maroon pixels are fixed markers.\n50:     - Every other foreground 4-connected object touches the marker pixels on exactly one cardinal side.\n51: \n52:     Rule:\n53:     - Clear each non-background, non-maroon object from its original position.\n54:     - Translate it in the direction away from its maroon contact until the object reaches the grid boundary.\n55:     - Keep the maroon marker pixels unchanged.\n56: \n57:     Key insight:\n58:     - The maroon contact side is a launcher: it determines a unique outward ray for the whole object, and the edge of the grid determines the translation distance.\n59:     \"\"\"\n60:     g = np.asarray(grid, dtype=int)\n61:     bg = int(get_bg(g))\n62:     assert bg != MARKER_COLOR\n63:     assert bool(np.any(g == MARKER_COLOR))\n64: \n65:     marker_components = find_components(\n66:         g,\n67:         bg=bg,\n68:         connectivity=4,\n69:         monochromatic=True,\n70:         colors=[MARKER_COLOR],\n71:         return_format=\"dict\",\n72:     )\n73:     assert 1 <= len(marker_components) <= 3, \"maroon markers must form 1-3 moderate components\"\n74:     assert sum(int(comp[\"area\"]) for comp in marker_components) <= 17, \"maroon marker area must be moderate\"\n75:     assert all(int(comp[\"area\"]) <= 9 for comp in marker_components), \"each maroon component must be moderate\"\n76: \n77:     out = g.copy()\n78:     placements: list[tuple[int, np.ndarray]] = []\n79:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n80:         color = int(comp[\"color\"])\n81:         if color == MARKER_COLOR:\n82:             continue\n83: \n84:         coords = comp[\"coords\"].astype(int, copy=False)\n85:         direction = _outward_direction(g, coords)\n86:         steps = _steps_to_edge(g.shape, coords, direction)\n87:         assert steps <= 8, \"push distance must stay within the observed moderate range\"\n88:         offset = np.array(direction, dtype=int) * steps\n89:         shifted = coords + offset\n90:         assert bool(\n91:             np.all(\n92:                 (0 <= shifted[:, 0])\n93:                 & (shifted[:, 0] < g.shape[0])\n94:                 & (0 <= shifted[:, 1])\n95:                 & (shifted[:, 1] < g.shape[1])\n96:             )\n97:         )\n98:         own = {tuple(coord) for coord in coords.tolist()}\n99:         for step in range(1, steps + 1):\n100:             swept = coords + np.array(direction, dtype=int) * step\n101:             for rr, cc in swept:\n102:                 loc = (int(rr), int(cc))\n103:                 assert loc in own or int(g[loc]) == bg, \"object movement path must be unobstructed\"\n104: \n105:         out[coords[:, 0], coords[:, 1]] = bg\n106:         placements.append((color, shifted))\n107: \n108:     assert placements\n109:     for color, coords in placements:\n110:         assert bool(np.all(out[coords[:, 0], coords[:, 1]] == bg)), \"moved objects must not collide\"\n111:         out[coords[:, 0], coords[:, 1]] = color\n112: \n113:     return out\n114: \n115: # --------------- generator (attempt 1 refined) ---------------\n116: \n117: # Generated grid colors.\n118: BG = 7\n119: MAROON = 9\n120: ALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8]\n121: DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n122: \n123: # Canvas and maroon marker bounds.\n124: GRID_SIZE_MIN = 9\n125: GRID_SIZE_MAX = 16\n126: MAROON_COMPONENT_MIN = 1\n127: MAROON_COMPONENT_MAX = 3\n128: MAROON_TOTAL_AREA_MAX = 17\n129: MAROON_COMPONENT_AREA_MAX = 9\n130: INTERIOR_PADDING = 1\n131: MAROON_PLACEMENT_TRIES = 80\n132: \n133: # Moving object bounds and push constraints.\n134: OBJECT_COUNT_MIN = 3\n135: OBJECT_COUNT_MAX = 7\n136: OBJECT_SIZE_MIN = 1\n137: OBJECT_SIZE_MAX = 5\n138: PUSH_DISTANCE_MAX = 8\n139: ZERO_STEP_PROBABILITY = 0.25\n140: ZERO_STEP_ALLOWANCE = 1\n141: \n142: # Retry limits for object placement and whole-grid generation.\n143: OBJECT_SHAPE_TRIES = 20\n144: CONTACT_CANDIDATE_LIMIT = 5\n145: GENERATE_RETRIES = 300\n146: \n147: \n148: def _grow_polyomino(size, rng):\n149:     \"\"\"Grow a 4-connected polyomino of given size, normalized to (0, 0).\"\"\"\n150:     cells = {(0, 0)}\n151:     frontier = [(0, 0)]\n152:     while len(cells) < size:\n153:         r, c = rng.choice(frontier)\n154:         nbrs = [(r-1, c), (r+1, c), (r, c-1), (r, c+1)]\n155:         rng.shuffle(nbrs)\n156:         grown = False\n157:         for nr, nc in nbrs:\n158:             if (nr, nc) not in cells:\n159:                 cells.add((nr, nc))\n160:                 frontier.append((nr, nc))\n161:                 grown = True\n162:                 break\n163:         if not grown:\n164:             frontier.remove((r, c))\n165:             if not frontier:\n166:                 break\n167: \n168:     min_r = min(r for r, c in cells)\n169:     min_c = min(c for r, c in cells)\n170:     return [(r - min_r, c - min_c) for r, c in cells]\n171: \n172: \n173: def _gen_steps_to_edge(N, coords, direction):\n174:     arr = np.array(coords, dtype=int)\n175:     dr, dc = direction\n176:     if dr == -1:\n177:         return int(arr[:, 0].min())\n178:     if dr == 1:\n179:         return int(N - 1 - arr[:, 0].max())\n180:     if dc == -1:\n181:         return int(arr[:, 1].min())\n182:     return int(N - 1 - arr[:, 1].max())\n183: \n184: \n185: def _swept_cells(N, coords, direction):\n186:     dr, dc = direction\n187:     steps = _gen_steps_to_edge(N, coords, direction)\n188:     own = set(coords)\n189:     swept = set()\n190:     for step in range(1, steps + 1):\n191:         for r, c in coords:\n192:             loc = (r + dr * step, c + dc * step)\n193:             if loc not in own:\n194:                 swept.add(loc)\n195:     return swept\n196: \n197: \n198: def _paths_are_clear(inp, objects):\n199:     N = inp.shape[0]\n200:     for _, inp_coords, _, direction in objects:\n201:         for r, c in _swept_cells(N, inp_coords, direction):\n202:             if inp[r, c] != BG:\n\n457: def generate_input():\n458:     for _ in range(GENERATE_RETRIES):\n459:         result = _gen_attempt()\n460:         if result is not None:\n461:             return result\n462:     raise RuntimeError(f\"Failed to generate input after {GENERATE_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/652646ff.py =====\n83: def main(grid: np.ndarray) -> np.ndarray:\n84:     \"\"\"\n85:     Recover each partially hidden 6x6 ring sprite and stack complete copies from top layer to bottom layer.\n86: \n87:     Input structure:\n88:     - The dominant color is the background.\n89:     - Several non-background colors are visible fragments of the same 12-pixel\n90:       outline ring in a 6x6 box; small off-template marker pixels are noise.\n91:     - Ring fragments overlap, so upper rings replace some expected pixels of\n92:       lower rings, and a ring may also be clipped by the input boundary.\n93: \n94:     Rule:\n95:     - Identify every substantial color whose pixels all lie on one translated\n96:       copy of the ring template.\n97:     - For each missing in-bounds template pixel, the color currently occupying\n98:       that pixel is above the hidden ring.\n99:     - Topologically sort these occlusion relations from top to bottom, then draw\n100:       one complete 6x6 ring for each color in that order on a background canvas.\n101: \n102:     Key insight:\n103:     - The output is not a crop of the scene; it is the layer stack of complete\n104:       ring sprites reconstructed from their visible fragments.\n105:     \"\"\"\n106:     g = np.asarray(grid, dtype=int)\n107:     bg = get_bg(g)\n108:     fragments = _find_ring_fragments(g, bg)\n109:     order = _layer_order(g, fragments)\n110: \n111:     out = np.full((_RING_SIZE * len(order), _RING_SIZE), bg, dtype=int)\n112:     for i, color in enumerate(order):\n113:         base_r = i * _RING_SIZE\n114:         for dr, dc in _RING:\n115:             out[base_r + dr, dc] = color\n116:     return out\n117: \n118: # --------------- generator (att2) ---------------\n119: \n120: # Ring template shared by rendering, validation, and output stacking.\n121: _GEN_RING: tuple[tuple[int, int], ...] = (\n122:     (0, 2),\n123:     (0, 3),\n124:     (1, 1),\n125:     (1, 4),\n126:     (2, 0),\n127:     (2, 5),\n128:     (3, 0),\n129:     (3, 5),\n130:     (4, 1),\n131:     (4, 4),\n132:     (5, 2),\n133:     (5, 3),\n134: )\n135: _GEN_RING_SIZE = 6\n136: \n137: # Scene size and structural counts.\n138: _GEN_GRID_SIZE_RANGE = (10, 20)\n139: _GEN_RING_COUNT_RANGE = (2, 4)\n140: _GEN_VISIBLE_PIXELS_RANGE = (8, 11)\n141: _GEN_COLORS = tuple(range(10))\n142: \n143: # Noise colors are isolated marker pixels on background cells.\n144: _GEN_NOISE_COLOR_COUNT_RANGE = (1, 2)\n145: _GEN_NOISE_PIXELS_PER_COLOR_RANGE = (2, 5)\n146: _GEN_NOISE_CLEARANCE = 1\n147: \n148: # Retry budget for rejection sampling a solver-consistent input.\n149: _GEN_MAX_ATTEMPTS = 300\n150: \n151: \n152: def _ring_cells(offset: tuple[int, int], n: int) -> set[tuple[int, int]]:\n153:     r0, c0 = offset\n154:     return {\n155:         (r0 + dr, c0 + dc)\n156:         for dr, dc in _GEN_RING\n157:         if 0 <= r0 + dr < n and 0 <= c0 + dc < n\n158:     }\n159: \n160: \n161: def _gen_matching_ring_offsets(coords: set[tuple[int, int]]) -> list[tuple[int, int]]:\n162:     offset_counts: dict[tuple[int, int], int] = {}\n163:     for r, c in coords:\n164:         for dr, dc in _GEN_RING:\n165:             offset = (r - dr, c - dc)\n166:             offset_counts[offset] = offset_counts.get(offset, 0) + 1\n167:     return [offset for offset, count in offset_counts.items() if count == len(coords)]\n168: \n169: \n170: def _has_unique_offset(coords: set[tuple[int, int]], offset: tuple[int, int]) -> bool:\n171:     return _gen_matching_ring_offsets(coords) == [offset]\n172: \n173: \n174: def _stack_output(bg: int, colors: list[int]) -> np.ndarray:\n175:     out = np.full((_GEN_RING_SIZE * len(colors), _GEN_RING_SIZE), bg, dtype=int)\n176:     for i, color in enumerate(colors):\n177:         for dr, dc in _GEN_RING:\n178:             out[i * _GEN_RING_SIZE + dr, dc] = color\n179:     return out\n180: \n181: \n182: def _render_scene(n: int, bg: int, colors: list[int], offsets: list[tuple[int, int]]) -> np.ndarray:\n183:     grid = np.full((n, n), bg, dtype=int)\n184:     for color, offset in reversed(list(zip(colors, offsets))):\n185:         for r, c in _ring_cells(offset, n):\n186:             grid[r, c] = color\n187:     return grid\n188: \n189: \n190: def _choose_noise_cells(candidates: list[tuple[int, int]], count: int) -> list[tuple[int, int]] | None:\n191:     random.shuffle(candidates)\n192:     picked: list[tuple[int, int]] = []\n193:     for cell in candidates:\n194:         r, c = cell\n195:         if all(max(abs(r - pr), abs(c - pc)) > _GEN_NOISE_CLEARANCE for pr, pc in picked):\n196:             picked.append(cell)\n197:             if len(picked) == count:\n198:                 return picked\n199:     return None\n200: \n201: \n202: def _add_noise(grid: np.ndarray, bg: int, ring_colors: list[int], offsets: list[tuple[int, int]]) -> bool:\n203:     n = grid.shape[0]\n204:     occupied_ring_cells: set[tuple[int, int]] = set()\n205:     for offset in offsets:\n206:         occupied_ring_cells |= _ring_cells(offset, n)\n207: \n208:     available = [\n209:         (r, c)\n210:         for r in range(n)\n211:         for c in range(n)\n212:         if grid[r, c] == bg and (r, c) not in occupied_ring_cells\n213:     ]\n214:     noise_colors = random.sample(\n215:         [color for color in _GEN_COLORS if color != bg and color not in ring_colors],\n216:         random.randint(*_GEN_NOISE_COLOR_COUNT_RANGE),\n217:     )\n218: \n219:     for color in noise_colors:\n220:         count = random.randint(*_GEN_NOISE_PIXELS_PER_COLOR_RANGE)\n221:         cells = _choose_noise_cells(available[:], count)\n222:         if cells is None:\n223:             return False\n224:         for r, c in cells:\n225:             grid[r, c] = color\n226:         chosen = set(cells)\n227:         available = [\n228:             (r, c)\n229:             for r, c in available\n230:             if (r, c) not in chosen\n231:             and all(max(abs(r - pr), abs(c - pc)) > _GEN_NOISE_CLEARANCE for pr, pc in chosen)\n232:         ]\n233:     return True\n234: \n235: \n236: def _candidate_offsets(\n237:     n: int,\n238:     max_offset: int,\n239:     offsets: list[tuple[int, int]],\n240:     higher_cells: list[set[tuple[int, int]]],\n241: ) -> list[tuple[int, int]]:\n242:     \"\"\"Return valid next-ring offsets against the already placed higher layers.\"\"\"\n\n304: def generate_input() -> np.ndarray:\n305:     for _ in range(_GEN_MAX_ATTEMPTS):\n306:         grid = _gen_attempt()\n307:         if grid is not None:\n308:             return grid\n309:     raise RuntimeError(\"failed to generate valid 652646ff input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/16b78196.py =====\n5: def main(grid: np.ndarray) -> np.ndarray:\n6:     \"\"\"\n7:     Assemble colored sprites into a central bar's notches, chaining successive pieces along fixed-width strips.\n8: \n9:     Input structure:\n10:     - bg = most common color. Largest monochrome component is a solid \"bar\" with boundary notches (bg holes opening to its bbox edge).\n11:     - Several smaller colored sprites scattered around the bar.\n12: \n13:     Rule:\n14:     - Each bar notch is filled by a root piece whose shape exactly covers the hole.\n15:     - The root defines a strip (column-span or row-span) for its chain.\n16:     - Successive pieces fill the bg cells inside the previous piece's bbox, locked to the same strip width.\n17:     - Multiple chains grow independently from different bar notches.\n18: \n19:     Key insight: The root piece's extent perpendicular to the chain direction locks the strip width for all subsequent pieces in that chain.\n20:     \"\"\"\n21:     g = np.array(grid, dtype=int)\n22:     H, W = g.shape\n23:     DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n24: \n25:     bg = get_bg(g)\n26: \n27:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n28:     comps.sort(key=lambda d: -d[\"area\"])\n29:     assert comps\n30: \n31:     bar = comps[0]\n32:     pieces_raw = comps[1:]\n33: \n34:     out = np.full((H, W), int(bg), dtype=int)\n35:     bar_r0, bar_c0, bar_r1, bar_c1 = map(int, bar[\"bbox\"])\n36:     bar_h, bar_w = bar_r1 - bar_r0 + 1, bar_c1 - bar_c0 + 1\n37:     bar_color = int(bar[\"color\"])\n38:     bar_occ = set((int(r), int(c)) for r, c in bar[\"coords\"])\n39:     bar_mask = np.zeros((bar_h, bar_w), dtype=bool)\n40:     for r, c in bar_occ:\n41:         bar_mask[r - bar_r0, c - bar_c0] = True\n42:     for r, c in bar_occ:\n43:         out[r, c] = bar_color\n44: \n45:     def shape_from_coords(coords: np.ndarray, bbox):\n46:         r0, c0, r1, c1 = map(int, bbox)\n47:         h, w = r1 - r0 + 1, c1 - c0 + 1\n48:         rel = [(int(r - r0), int(c - c0)) for r, c in coords]\n49:         rel_set = set(rel)\n50:         return {\"rel\": rel, \"rel_set\": rel_set, \"h\": h, \"w\": w}\n51: \n52:     pieces = []\n53:     for p in pieces_raw:\n54:         # For this puzzle, pieces are used in their original orientation (no rotation / flip).\n55:         r0, c0 = map(int, p[\"bbox\"][:2])\n56:         pieces.append({\"color\": int(p[\"color\"]), \"shape\": shape_from_coords(p[\"coords\"], p[\"bbox\"]), \"orig\": (r0, c0)})\n57: \n58:     def bar_notches(bar_mask, bar_r0, bar_c0):\n59:         empty = ~bar_mask\n60:         h, w = map(int, empty.shape)\n61:         notches = []\n62:         for pts in components_mask(empty, connectivity=4):\n63:             r = pts[:, 0]\n64:             c = pts[:, 1]\n65:             top = int((r == 0).sum())\n66:             bottom = int((r == h - 1).sum())\n67:             left = int((c == 0).sum())\n68:             right = int((c == w - 1).sum())\n69: \n70:             # Keep only holes that open to the bar bbox boundary.\n71:             if top + bottom + left + right == 0:\n72:                 continue\n73: \n74:             hole_gl = set((bar_r0 + int(rr), bar_c0 + int(cc)) for rr, cc in pts)\n75: \n76:             # Axis is determined by which bbox side has the widest mouth.\n77:             side, mouth_n = max(\n78:                 [(name, cnt) for name, cnt in [(\"top\", top), (\"bottom\", bottom), (\"left\", left), (\"right\", right)] if cnt > 0],\n79:                 key=lambda x: x[1],\n80:             )\n81:             axis = \"cols\" if side in (\"top\", \"bottom\") else \"rows\"\n82:             notches.append({\"axis\": axis, \"hole\": hole_gl, \"mouth_n\": mouth_n})\n83:         return notches\n84: \n85:     notches = bar_notches(bar_mask, bar_r0, bar_c0)\n86: \n87:     def pixels(v, top, left):\n88:         return set((top + lr, left + lc) for lr, lc in v[\"rel\"])\n89: \n90:     def placement_pts(v, top, left, occ, must_cover=None, strip=None):\n91:         if top < 0 or left < 0 or top + v[\"h\"] > H or left + v[\"w\"] > W:\n92:             return None\n93:         if strip is not None:\n94:             axis, A, B = strip\n95:             if axis == \"cols\":\n96:                 if left != A or v[\"w\"] != B - A + 1:\n97:                     return None\n98:             else:\n99:                 if top != A or v[\"h\"] != B - A + 1:\n100:                     return None\n101:         pts = pixels(v, top, left)\n102:         if pts & occ:\n103:             return None\n104:         if must_cover is not None and not (must_cover <= pts):\n105:             return None\n106:         return pts\n107: \n108:     def aligned_positions(axis, A, cover, v):\n109:         if axis == \"cols\":\n110:             left = A\n111:             tops = set()\n112:             for rN, cN in cover:\n113:                 for lr, lc in v[\"rel\"]:\n114:                     if cN == left + lc:\n115:                         tops.add(rN - lr)\n116:             for top in tops:\n117:                 yield top, left\n118:         else:\n119:             top = A\n120:             lefts = set()\n121:             for rN, cN in cover:\n122:                 for lr, lc in v[\"rel\"]:\n123:                     if rN == top + lr:\n124:                         lefts.add(cN - lc)\n125:             for left in lefts:\n126:                 yield top, left\n127: \n128:     def touches(pts, other):\n129:         for r, c in pts:\n130:             for dr, dc in DIR4:\n131:                 if (r + dr, c + dc) in other:\n132:                     return True\n133:         return False\n134: \n135:     def hole_positions(hole, v):\n136:         pos = set()\n137:         for rH, cH in hole:\n138:             for lr, lc in v[\"rel\"]:\n139:                 pos.add((rH - lr, cH - lc))\n140:         return pos\n141: \n142:     # Root candidates: fill the bar hole (no strip constraint yet).\n143:     root_cands = []\n144:     for ni, n in enumerate(notches):\n145:         axis = n[\"axis\"]\n146: \n147:         for pi, p in enumerate(pieces):\n148:             v = p[\"shape\"]\n149:             for top, left in hole_positions(n[\"hole\"], v):\n150:                 pts = placement_pts(v, top, left, bar_occ, must_cover=n[\"hole\"])\n151:                 if pts is None:\n152:                     continue\n153:                 if axis == \"cols\":\n154:                     A, B = int(left), int(left + v[\"w\"] - 1)\n155:                 else:\n156:                     A, B = int(top), int(top + v[\"h\"] - 1)\n157:                 mv = abs(int(top) - int(p[\"orig\"][0])) + abs(int(left) - int(p[\"orig\"][1]))\n158:                 root_cands.append(\n159:                     (\n160:                         (int(mv), -int(n[\"mouth_n\"])),\n161:                         {\"ni\": ni, \"pi\": pi, \"top\": int(top), \"left\": int(left), \"axis\": axis, \"A\": A, \"B\": B, \"shape\": v},\n162:          