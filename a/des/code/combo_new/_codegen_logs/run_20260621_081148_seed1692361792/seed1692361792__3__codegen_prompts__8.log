)\n105:     assert g.ndim == 2, \"expected a 2D grid\"\n106:     bg = _boundary_bg(g)\n107: \n108:     objects = []\n109:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False):\n110:         bbox = tuple(map(int, comp[\"bbox\"]))\n111:         sub = crop_bbox(g, bbox)\n112:         assert np.all(sub != bg), \"foreground rectangles must be dense\"\n113: \n114:         base_color = _unique_most_common(sub)\n115:         marker_colors = set(map(int, sub.reshape(-1))) - {int(base_color)}\n116:         objects.append(\n117:             {\n118:                 \"bbox\": bbox,\n119:                 \"sub\": sub,\n120:                 \"base_color\": int(base_color),\n121:                 \"marker_colors\": marker_colors,\n122:             }\n123:         )\n124: \n125:     plain = [obj for obj in objects if not obj[\"marker_colors\"]]\n126:     assert len(plain) == 1, \"expected exactly one plain rectangle\"\n127:     target = plain[0]\n128:     tr0, tc0, tr1, tc1 = target[\"bbox\"]\n129:     target_shape = (int(tr1 - tr0 + 1), int(tc1 - tc0 + 1))\n130: \n131:     sources = [\n132:         obj\n133:         for obj in objects\n134:         if obj[\"marker_colors\"] and _row_overlap(obj[\"bbox\"], target[\"bbox\"])\n135:     ]\n136:     assert sources, \"expected at least one marked rectangle aligned with the plain rectangle\"\n137: \n138:     marker_colors = set()\n139:     for source in sources:\n140:         marker_colors.update(source[\"marker_colors\"])\n141:     assert len(marker_colors) == 1, \"aligned marked rectangles must share one marker color\"\n142:     marker_color = int(next(iter(marker_colors)))\n143: \n144:     masks = []\n145:     for source in sources:\n146:         assert source[\"marker_colors\"] == {marker_color}, \"source must contain only the shared marker color\"\n147:         masks.append(_adapt_marker_mask(source[\"sub\"], marker_color, target_shape))\n148: \n149:     pattern = masks[0]\n150:     for mask in masks[1:]:\n151:         assert np.array_equal(mask, pattern), \"aligned marked rectangles must encode the same pattern\"\n152: \n153:     out = np.full(target_shape, int(target[\"base_color\"]), dtype=int)\n154:     out[pattern] = marker_color\n155:     return out\n156: \n157: # --------------- generator (att1, Claude) ---------------\n158: \n159: # Canvas and separator colors.\n160: BG = 4\n161: NON_BG = [c for c in range(10) if c != BG]\n162: GRID_H_RANGE = (20, 28)\n163: GRID_W_RANGE = (20, 28)\n164: BORDER_GAP = 1\n165: BAND_GAP = 1\n166: # Rectangle counts and dimensions.\n167: RECT_COUNT_RANGE = (3, 6)\n168: OVERLAP_MARKED_COUNT = 2\n169: RECT_H_RANGE = (5, 20)\n170: RECT_W_RANGE = (5, 12)\n171: PLAIN_EXTRA_ROW_ROOM = 2\n172: # Marker pattern sampling.\n173: MARKER_PAIR_COUNT_RANGE = (1, 3)\n174: MARKER_EDGE_PAIRS = [(1, 1), (1, 2), (2, 1), (2, 2)]\n175: # Retry budget.\n176: GENERATION_ATTEMPTS = 300\n177: \n178: \n179: def _stamp_pattern(rect: np.ndarray, marker: int, pairs: list[tuple[int, int]]):\n180:     h, w = rect.shape\n181:     for nr, nc in pairs:\n182:         for r in (nr, h - 1 - nr):\n183:             for c in (nc, w - 1 - nc):\n184:                 rect[r, c] = marker\n185: \n186: \n187: def _pick_dim(near_vals: list[int], lo: int, hi: int) -> int:\n188:     min_dim = max(lo, max(2 * nv + 2 for nv in near_vals))\n189:     cands = [d for d in range(min_dim, hi + 1) if all(d >= 2 * nv + 2 and d != 2 * nv + 1 for nv in near_vals)]\n190:     return random.choice(cands) if cands else -1\n191: \n192: \n193: def _choose_marker_pattern():\n194:     n_pairs = random.randint(*MARKER_PAIR_COUNT_RANGE)\n195:     pairs = sorted(random.sample(MARKER_EDGE_PAIRS, min(n_pairs, len(MARKER_EDGE_PAIRS))))\n196:     near_rows = [p[0] for p in pairs]\n197:     near_cols = [p[1] for p in pairs]\n198:     return pairs, near_rows, near_cols\n199: \n200: \n201: def _choose_palette(n_rects: int):\n202:     needed = n_rects + 1  # base colors + marker\n203:     if needed > len(NON_BG):\n204:         return None\n205:     chosen = random.sample(NON_BG, needed)\n206:     plain_base, marker_color = chosen[0], chosen[-1]\n207:     marked_bases = chosen[1:-1]\n208:     return plain_base, marker_color, marked_bases\n209: \n210: \n211: def _make_marked_rect(h: int, w: int, base: int, marker: int, pairs: list[tuple[int, int]]) -> np.ndarray:\n212:     rect = np.full((h, w), base, dtype=int)\n213:     _stamp_pattern(rect, marker, pairs)\n214:     return rect\n215: \n216: \n217: def _choose_plain_shape(near_rows: list[int], near_cols: list[int], avail_h: int, avail_w: int):\n218:     hp = _pick_dim(near_rows, RECT_H_RANGE[0], min(RECT_H_RANGE[1], avail_h - PLAIN_EXTRA_ROW_ROOM))\n219:     wp = _pick_dim(near_cols, RECT_W_RANGE[0], min(RECT_W_RANGE[1], avail_w))\n220:     if hp < 0 or wp < 0:\n221:         return None\n222:     return hp, wp\n223: \n224: \n225: def _has_overlap_width_budget(avail_w: int, plain_w: int) -> bool:\n226:     remaining_w = avail_w - plain_w - OVERLAP_MARKED_COUNT * BAND_GAP\n227:     max_overlap_w = remaining_w // OVERLAP_MARKED_COUNT\n228:     if max_overlap_w >= RECT_W_RANGE[0]:\n229:         return True\n230:     return remaining_w >= RECT_W_RANGE[0]\n231: \n232: \n233: def _build_overlap_rects(avail_h, avail_w, plain_w, near_rows, near_cols, marked_bases, marker_color, pairs):\n234:     if not _has_overlap_width_budget(avail_w, plain_w):\n235:         return None\n236: \n237:     min_w, max_w = RECT_W_RANGE\n238:     min_h, max_h = RECT_H_RANGE\n239:     overlap_rects = []\n240:     remaining_w = avail_w - plain_w - OVERLAP_MARKED_COUNT * BAND_GAP\n241:     for i in range(OVERLAP_MARKED_COUNT):\n242:         if i == 0:\n243:             max_w_i = min(remaining_w - min_w, max_w)\n244:         else:\n245:             max_w_i = min(remaining_w, max_w)\n246:         wm = _pick_dim(near_cols, min_w, max(min_w, max_w_i))\n\n450: def generate_input() -> np.ndarray:\n451:     for _ in range(GENERATION_ATTEMPTS):\n452:         result = _gen_attempt()\n453:         if result is not None:\n454:             return result\n455:     raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/a6f40cea.py =====\n73: def main(grid: np.ndarray) -> np.ndarray:\n74:     \"\"\"\n75:     Complete partial paths inside a framed rectangle by projecting external color traces inward.\n76: \n77:     Input structure:\n78:     - bg, a 1px rectangular frame (border color) with uniform interior fill.\n79:     - Colored components outside the frame touching its edges.\n80: \n81:     Rule:\n82:     - Output = the frame's interior, filled with the fill color.\n83:     - Map each outside component's frame-touch points into interior coordinates.\n84:     - Monochrome components become solid Manhattan stripes between mapped endpoints.\n85:     - Two-color components become alternating-color Manhattan paths.\n86: \n87:     Key insight: Endpoint colors of two-color traces anchor the alternating phase deterministically.\n88:     \"\"\"\n89:     g = np.array(grid, dtype=int)\n90:     H, W = g.shape\n91:     bg = int(get_bg(g))\n92: \n93:     found = _find_framed_rect_uniform_fill(g, bg=int(bg))\n94:     assert not (found is None)\n95:     r0, c0, r1, c1, bc, fill = found\n96:     outH = int(r1 - r0 - 1)\n97:     outW = int(c1 - c0 - 1)\n98:     out = np.full((outH, outW), int(fill), dtype=int)\n99:     r_int0 = int(r0 + 1)\n100:     c_int0 = int(c0 + 1)\n101: \n102:     def map_to_out(rr: int, cc: int) -> tuple[int, int]:\n103:         r = max(0, min(outH - 1, int(rr - r_int0)))\n104:         c = max(0, min(outW - 1, int(cc - c_int0)))\n105:         return int(r), int(c)\n106: \n107:     def build_manhattan(p1: tuple[int, int], p2: tuple[int, int], cornerA: bool) -> list[tuple[int, int]]:\n108:         (ra, ca), (rb, cb) = p1, p2\n109:         if ra == rb:\n110:             step = 1 if cb >= ca else -1\n111:             return [(int(ra), int(c)) for c in range(int(ca), int(cb) + step, step)]\n112:         if ca == cb:\n113:             step = 1 if rb >= ra else -1\n114:             return [(int(r), int(ca)) for r in range(int(ra), int(rb) + step, step)]\n115:         if cornerA:\n116:             step = 1 if rb >= ra else -1\n117:             path = [(int(r), int(ca)) for r in range(int(ra), int(rb) + step, step)]\n118:             step = 1 if cb >= ca else -1\n119:             path += [(int(rb), int(c)) for c in range(int(ca) + step, int(cb) + step, step)]\n120:             return path\n121:         step = 1 if cb >= ca else -1\n122:         path = [(int(ra), int(c)) for c in range(int(ca), int(cb) + step, step)]\n123:         step = 1 if rb >= ra else -1\n124:         path += [(int(r), int(cb)) for r in range(int(ra) + step, int(rb) + step, step)]\n125:         return path\n126: \n127:     def inside_corner(p1: tuple[int, int], p2: tuple[int, int], cornerA: bool) -> bool:\n128:         (ra, ca), (rb, cb) = p1, p2\n129:         if ra == rb or ca == cb:\n130:             return True\n131:         corner = (rb, ca) if cornerA else (ra, cb)\n132:         rr, cc = corner\n133:         return (0 < rr < outH - 1) and (0 < cc < outW - 1)\n134: \n135:     # --- ring components (outside the frame) ---\n136:     comp_mask = (g != int(bg)) & (g != int(fill)) & (g != int(bc))\n137:     clab, cn = label(comp_mask, structure=STRUCT4)\n138: \n139:     ring = set()\n140:     for cc in range(c0, c1 + 1):\n141:         for rr in (r0 - 1, r1 + 1):\n142:             if 0 <= rr < H:\n143:                 ring.add((int(rr), int(cc)))\n144:     for rr in range(r0, r1 + 1):\n145:         for cc in (c0 - 1, c1 + 1):\n146:             if 0 <= cc < W:\n147:                 ring.add((int(rr), int(cc)))\n148: \n149:     # cid -> list of (mapped_r, mapped_c, color)\n150:     comp_pts: dict[int, list[tuple[int, int, int]]] = defaultdict(list)\n151:     for rr, cc in ring:\n152:         cid = int(clab[rr, cc])\n153:         if cid == 0:\n154:             continue\n155:         col = int(g[rr, cc])\n156:         mr, mc = map_to_out(rr, cc)\n157:         comp_pts[cid].append((mr, mc, col))\n158: \n159:     # per-component color sets\n160:     comp_cols: dict[int, list[int]] = {}\n161:     for cid in range(1, int(cn) + 1):\n162:         comp_cols[cid] = sorted(set(map(int, g[clab == int(cid)].flatten())))\n163: \n164:     deferred: dict[int, set[tuple[int, int]]] = defaultdict(set)\n165: \n166:     for cid, pts in comp_pts.items():\n167:         if len(pts) < 2:\n168:             continue\n169:         cols = comp_cols.get(cid, [])\n170:         if not cols:\n171:             continue\n172: \n173:         # build per-coordinate color histogram (clamp can merge multiple ring pixels)\n174:         hist: dict[tuple[int, int], Counter] = defaultdict(Counter)\n175:         for r, c, col in pts:\n176:             hist[(int(r), int(c))][int(col)] += 1\n177: \n178:         coords = list(hist.keys())\n179: \n180:         if len(cols) == 1:\n181:             colv = int(cols[0])\n182:             uniq = coords\n183:             rows = {r for r, _c in uniq}\n184:             cols2 = {c for _r, c in uniq}\n185:             if len(rows) == 1 or len(cols2) == 1:\n186:                 for p in uniq:\n187:                     deferred[colv].add((int(p[0]), int(p[1])))\n188:                 continue\n189: \n190:             # Connect farthest pair by a Manhattan path.\n191:             best = None\n192:             for i in range(len(uniq)):\n193:                 for j in range(i + 1, len(uniq)):\n194:                     d = abs(uniq[i][0] - uniq[j][0]) + abs(uniq[i][1] - uniq[j][1])\n195:                     if best is None or d > best[0]:\n196:                         best = (d, uniq[i], uniq[j])\n197:             if best is None:\n198:                 continue\n199:             _d, p1, p2 = best\n200:             pathA = build_manhattan(p1, p2, True)\n201:             pathB = build_manhattan(p1, p2, False)\n202:             chosen = pathB if (inside_corner(p1, p2, False) and not inside_corner(p1, p2, True)) else pathA\n203:             for rr, cc in chosen:\n204:                 out[int(rr), int(cc)] = int(colv)\n205:             continue\n206: \n207:         if len(cols) == 2:\n208:             # Choose farthest pair in mapped space.\n209:             best = None\n210:             for i in range(len(coords)):\n211:                 for j in range(i + 1, len(coords)):\n212:                     d = abs(coords[i][0] - coords[j][0]) + abs(coords[i][1] - coords[j][1])\n213:                     if best is None or d > best[0]:\n214:                         best = (d, coords[i], coords[j])\n215:             if best is None:\n216:                 continue\n217:             _d, a, b = best\n218:             # Component's two colors (alternation palette).\n219:             ca, cb = map(int, cols)\n220:             # Endpoint color hints from ring-touch pixels (can be same on both ends).\n221:             ha = int(hist[a].most_common(1)[0][0])\n222:             hb = int(hist[b].most_common(1)[0][0])\n223: \n224:             # Pick a Manhattan path (prefer elbow inside the interior).\n225:             pathA = build_manhattan(a, b, True)\n226:             pathB = build_manhattan(a, b, False)\n227:             path = pathB if (inside_corner(a, b, False) and not inside_corner(a, b, True)) else pathA\n228: \n229:             def paint_alt(path_pts: list[tuple[int, int]], start_color: int):\n230:                 cur = int(start_color)\n231:                 for rr, cc in path_pts:\n232:                     out[int(rr), int(cc)] = int(cur)\n\n582: def generate_input() -> np.ndarray:\n583:     for _ in range(_GEN_RETRIES):\n584:         grid = _gen_attempt()\n585:         if grid is not None:\n586:             return grid\n587:     raise RuntimeError(\"failed to generate a valid a6f40cea input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/e87109e9.py =====\n67: def main(grid: np.ndarray) -> np.ndarray:\n68:     \"\"\"\n69:     Emit four teal beams from a square, turning at colored obstacles per a legend.\n70: \n71:     Input structure:\n72:     - Top band: grey (5) legend with colored vertical bars in cells; bar position (left or right) encodes turn direction.\n73:     - Below: main grid with bg, a solid teal (8) square, and colored obstacle blocks.\n74: \n75:     Rule:\n76:     - Remove the legend from the output.\n77:     - From the teal square, shoot a beam in each cardinal direction (as a sliding copy of the square).\n78:     - Each beam paints teal over bg cells as it moves.\n79:     - On hitting an obstacle of color C, consult the legend: bar on left → turn counterclockwise, bar on right → turn clockwise. Continue in the new direction.\n80:     - Beams stop at grid edges.\n81: \n82:     Key insight: The legend's bar position (left vs right within its cell) is the encoding for turn direction at each obstacle color.\n83:     \"\"\"\n84:     g = np.asarray(grid, dtype=int)\n85: \n86:     # Legend height: crop everything above and including the last row containing legend bg (usually 5).\n87:     # In this dataset, the legend uses a dedicated color (5) that doesn't appear below.\n88:     legend_bg = 5\n89:     rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]\n90:     assert rows_with_legend.size, \"legend rows must be present\"\n91:     legend_h = int(rows_with_legend.max() + 1)\n92:     assert np.array_equal(rows_with_legend, np.arange(legend_h)), \"legend color must be confined to the top band\"\n93: \n94:     legend_turn = _parse_legend(g, legend_h)\n95: \n96:     base = g[legend_h:, :].copy()\n97:     assert base.size, \"main grid must remain after legend crop\"\n98: \n99:     _vals, _cnts = np.unique(base, return_counts=True); bg = int(_vals[_cnts.argmax()])\n100:     teal = 8\n101:     src = _find_teal_square(base, teal=teal)\n102:     sr, sc, sz = src\n103: \n104:     out = base.copy()\n105: \n106:     def in_bounds(r: int, c: int) -> bool:\n107:         return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]\n108: \n109:     def paint_block(r: int, c: int) -> None:\n110:         blk = out[r : r + sz, c : c + sz]\n111:         blk[blk == bg] = teal\n112:         out[r : r + sz, c : c + sz] = blk\n113: \n114:     def obstacle_color_at_next(nr: int, nc: int) -> int | None:\n115:         blk = out[nr : nr + sz, nc : nc + sz]\n116:         cols = set(map(int, np.unique(blk)))\n117:         cols.discard(bg)\n118:         cols.discard(teal)\n119:         if not cols:\n120:             return None\n121:         assert len(cols) == 1, \"beam footprint must not hit mixed obstacle colors\"\n122:         return int(next(iter(cols)))\n123: \n124:     # Four beams, each is a moving copy of the teal square.\n125:     for d0 in range(4):\n126:         r, c, d = sr, sc, d0\n127:         seen: set[tuple[int, int, int]] = set()\n128:         while True:\n129:             state = (r, c, d)\n130:             assert state not in seen, \"beam path must not cycle\"\n131:             seen.add(state)\n132: \n133:             dr, dc = _DIRS[d]\n134:             nr, nc = r + dr, c + dc\n135:             if not in_bounds(nr, nc):\n136:                 break\n137: \n138:             oc = obstacle_color_at_next(nr, nc)\n139:             if oc is None:\n140:                 r, c = nr, nc\n141:                 paint_block(r, c)\n142:                 continue\n143: \n144:             assert oc in legend_turn, \"obstacle color must be encoded by legend\"\n145:             turn = legend_turn[oc]\n146:             d = _rot_ccw(d) if turn == \"L\" else _rot_cw(d)\n147: \n148:     return out\n149: \n150: # --------------- generator (o5x) ---------------\n151: \n152: # ── Configuration ──────────────────────────────────────────────────────\n153: _DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n154: _N, _E, _S, _W = range(4)\n155: \n156: # Color palettes\n157: LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]          # colors eligible for obstacles / legend\n158: BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]        # colors eligible for main-grid background\n159: LEGEND_BG = 5                                  # legend background color\n160: TEAL = 8                                       # beam / square color\n161: \n162: # Canvas dimensions\n163: GRID_H_RANGE = (19, 24)                        # main-grid height (rows)\n164: GRID_W = 24                                    # main-grid width (fixed)\n165: LEGEND_H = 6                                   # legend height (rows)\n166: LEGEND_CELL_STARTS = [1, 7, 13, 19]           # col offsets for legend cells\n167: \n168: # Teal square\n169: TEAL_SZ2_PROB = 0.75                           # P(size=2); else size=3\n170: SQUARE_EDGE_GAP = 5                            # min gap from square to grid edges\n171: \n172: # Obstacles\n173: OBS_COUNT_4_PROB = 0.65                        # P(4 obstacles); else 3\n174: OBS_THICKNESS_RANGE = (2, 4)                   # obstacle shorter-dimension bounds\n175: OBS_SINGLE_MARGIN = 6                          # margin subtracted when only one side present\n176: OBS_BOTH_GAP = 2                               # gap subtracted when both sides present\n177: \n178: # Span selection\n179: SPAN_MIN_MULT = 3                              # min obstacle length = SPAN_MIN_MULT * sz\n180: SPAN_MAX_MULT = 14                             # max obstacle length = SPAN_MAX_MULT * sz\n181: SPAN_COMPACT_PROB = 0.4                        # P(bias toward compact spans)\n182: \n183: # Retry budget\n184: MAX_RETRIES = 300\n185: \n186: \n187: def _rot(d: int, turn: str) -> int:\n188:     \"\"\"Rotate direction d by turn ('L' = CCW, 'R' = CW).\"\"\"\n189:     return (d - 1) % 4 if turn == \"L\" else (d + 1) % 4\n190: \n191: \n192: # ── Obstacle span selection ───────────────────────────────────────────\n193: \n194: def _choose_span(\n195:     axis_len: int,\n196:     required: list[tuple[int, int]],\n197:     excluded: list[tuple[int, int]],\n198:     min_len: int,\n199:     max_len: int,\n200: ) -> tuple[int, int] | None:\n201:     \"\"\"Pick a (start, end) span covering all *required* intervals, avoiding all *excluded*.\"\"\"\n202:     req0 = min(a for a, _ in required)\n203:     req1 = max(b for _, b in required)\n204:     lo = max(min_len, req1 - req0 + 1)\n205:     hi = min(max_len, axis_len)\n206:     choices: list[tuple[int, int, int]] = []\n207:     for length in range(lo, hi + 1):\n208:         start0 = max(0, req1 - length + 1)\n209:         start1 = min(req0, axis_len - length)\n210:         for start in range(start0, start1 + 1):\n211:             end = start + length - 1\n212:             if all(end < a or start > b for a, b in excluded):\n213:                 choices.append((length, start, end))\n214:     if not choices:\n215:         return None\n216: \n217:     # Bias mildly toward compact side bars while still covering long-span cases.\n218:     lengths = sorted({length for length, _, _ in choices})\n219:     if random.random() < SPAN_COMPACT_PROB:\n220:         cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]\n221:         pool = [(start, end) for length, start, end in choices if length <= cutoff]\n222:     else:\n223:         pool = [(start, end) for _, start, end in choices]\n224:     return random.choice(pool)\n225: \n226: \n\n535: def generate_input() -> np.ndarray:\n536:     for _ in range(MAX_RETRIES):\n537:         grid = _gen_attempt()\n538:         if grid is not None:\n539:             return grid\n540:     raise RuntimeError(\"failed to generate e87109e9 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/8a6d367c.py =====\n51: def main(grid: np.ndarray) -> np.ndarray:\n52:     \"\"\"\n53:     Complete the framed area by expanding the unique upper template that contains the existing seed pixels.\n54: \n55:     Input structure:\n56:     - A teal background contains small colored template masks above a larger rectangular frame.\n57:     - The frame encloses one fill color arranged as a partial block-scaled copy of one template.\n58:     - The frame interior dimensions are an integer square scale of the matching template bbox.\n59: \n60:     Rule:\n61:     - Crop to the rectangular frame.\n62:     - Identify the unique upper template whose block-scaled mask covers every existing fill pixel inside the frame.\n63:     - Reset the frame interior to background and paint the whole scaled mask with the fill color.\n64: \n65:     Key insight:\n66:     The lower colored pixels are seed cells that reveal which upper template should be completed inside the frame.\n67:     \"\"\"\n68:     g = np.asarray(grid, dtype=int)\n69:     bg = int(get_bg(g))\n70:     frame_color, (r0, c0, r1, c1) = _find_frame(g, bg)\n71: \n72:     out = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n73:     interior = out[1:-1, 1:-1]\n74:     fill_colors = set(map(int, np.unique(interior))) - {bg, frame_color}\n75:     assert len(fill_colors) == 1, \"frame interior must contain exactly one fill color\"\n76:     fill_color = fill_colors.pop()\n77: \n78:     seed = interior == fill_color\n79:     assert np.any(seed), \"frame must contain seed pixels\"\n80:     ih, iw = seed.shape\n81: \n82:     matches: list[np.ndarray] = []\n83:     for template in _templates_above_frame(g, bg, r0):\n84:         th, tw = template.shape\n85:         if ih % th != 0 or iw % tw != 0:\n86:             continue\n87:         scale_h = ih // th\n88:         scale_w = iw // tw\n89:         if scale_h != scale_w:\n90:             continue\n91: \n92:         scaled = np.kron(template, np.ones((scale_h, scale_w), dtype=bool))\n93:         if np.all(~seed | scaled):\n94:             matches.append(scaled)\n95: \n96:     assert len(matches) == 1, \"seed pixels must select exactly one scaled template\"\n97:     completed = matches[0]\n98:     assert completed.shape == interior.shape\n99: \n100:     interior[:, :] = bg\n101:     interior[completed] = fill_color\n102:     return out\n103: \n104: # --------------- generator (att2) ---------------\n105: \n106: GEN_BG = 8\n107: GEN_GRID_SHAPE = (27, 21)\n108: GEN_TEMPLATE_SHAPES = [(3, 3), (3, 4), (4, 3)]\n109: GEN_TEMPLATE_COUNT_RANGE = (2, 6)\n110: GEN_TEMPLATE_ROW = 1\n111: GEN_TEMPLATE_LEFT_MIN = 1\n112: GEN_TEMPLATE_GAP = 1\n113: GEN_MAX_TEMPLATE_SPAN = 19\n114: GEN_DENSITY_MIN_NUM = 1\n115: GEN_DENSITY_MIN_DEN = 2\n116: GEN_DENSITY_MAX_NUM = 5\n117: GEN_DENSITY_MAX_DEN = 6\n118: GEN_SCALE_RANGE = (2, 5)\n119: GEN_SEED_COUNTS = (2, 3)\n120: GEN_SEED_FRACTION_RANGE = (0.20, 0.60)\n121: GEN_FRAME_ROW_GAP = 2\n122: GEN_FRAME_LEFT_MIN = 1\n123: GEN_ATTEMPTS = 300\n124: GEN_PALETTE = [0, 1, 2, 3, 4, 5, 6, 7, 9]\n125: \n126: def _gen_has_full_bbox(mask: np.ndarray) -> bool:\n127:     return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())\n128: \n129: \n130: def _gen_valid_masks(th: int, tw: int) -> list[np.ndarray]:\n131:     n = int(th * tw)\n132:     lo = (GEN_DENSITY_MIN_NUM * n + GEN_DENSITY_MIN_DEN - 1) // GEN_DENSITY_MIN_DEN\n133:     hi = (GEN_DENSITY_MAX_NUM * n) // GEN_DENSITY_MAX_DEN\n134:     masks: list[np.ndarray] = []\n135:     for bits in range(1 << n):\n136:         count = int(bits.bit_count())\n137:         if count < lo or count > hi:\n138:             continue\n139:         flat = np.array([(bits >> k) & 1 for k in range(n)], dtype=bool)\n140:         mask = flat.reshape(th, tw)\n141:         if _gen_has_full_bbox(mask):\n142:             masks.append(mask)\n143:     return masks\n144: \n145: \n146: def _gen_colored_patch(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\n147:     patch = np.full(mask.shape, bg, dtype=int)\n148:     patch[mask] = int(color)\n149:     return patch\n150: \n151: \n152: def _gen_draw_frame(shape: tuple[int, int], bg: int, frame_color: int) -> np.ndarray:\n153:     patch = np.full(shape, bg, dtype=int)\n154:     patch[0, :] = frame_color\n155:     patch[-1, :] = frame_color\n156:     patch[:, 0] = frame_color\n157:     patch[:, -1] = frame_color\n158:     return patch\n159: \n160: \n161: def _gen_frame_patch(\n162:     target_mask: np.ndarray,\n163:     seed_cells: np.ndarray,\n164:     scale: int,\n165:     bg: int,\n166:     frame_color: int,\n167:     fill_color: int,\n168: ) -> tuple[np.ndarray, np.ndarray]:\n169:     th, tw = map(int, target_mask.shape)\n170:     scaled = np.kron(target_mask, np.ones((scale, scale), dtype=bool))\n171:     out = _gen_draw_frame((th * scale + 2, tw * scale + 2), bg, frame_color)\n172:     out[1:-1, 1:-1][scaled] = fill_color\n173: \n174:     frame = _gen_draw_frame(out.shape, bg, frame_color)\n175:     for r, c in seed_cells:\n176:         rr = int(r) * scale\n177:         cc = int(c) * scale\n178:         frame[1 + rr : 1 + rr + scale, 1 + cc : 1 + cc + scale] = fill_color\n179:     return frame, out\n180: \n181: \n182: def _gen_attempt() -> np.ndarray | None:\n183:     rng = np.random.default_rng()\n184:     bg = GEN_BG\n185:     count = int(rng.integers(*GEN_TEMPLATE_COUNT_RANGE))\n186:     shape_choices = [\n187:         shape for shape in GEN_TEMPLATE_SHAPES if count * shape[1] + count - 1 <= GEN_MAX_TEMPLATE_SPAN\n188:     ]\n189:     th, tw = shape_choices[int(rng.integers(0, len(shape_choices)))]\n190:     scale = int(rng.integers(*GEN_SCALE_RANGE))\n191: \n192:     valid_masks = _gen_valid_masks(th, tw)\n193:     if len(valid_masks) < count:\n194:         return None\n195: \n196:     target = valid_masks[int(rng.integers(0, len(valid_masks)))]\n197:     true_cells = np.argwhere(target)\n198:     target_area = int(len(true_cells))\n199:     min_seed_frac, max_seed_frac = GEN_SEED_FRACTION_RANGE\n200:     seed_counts = [k for k in GEN_SEED_COUNTS if min_seed_frac <= k / target_area <= max_seed_frac]\n201:     if not seed_counts:\n202:         return None\n203:     seed_count = int(seed_counts[int(rng.integers(0, len(seed_counts)))])\n204:     seed_idx = rng.choice(target_area, size=seed_count, replace=False)\n205:     seed_cells = true_cells[seed_idx]\n206: \n207:     covers_seed = np.array([bool(mask[seed_cells[:, 0], seed_cells[:, 1]].all()) for mask in valid_masks])\n208:     distractor_pool = [mask for mask, covers in zip(valid_masks, covers_seed) if not covers]\n209:     if len(distractor_pool) < count - 1:\n210:         return None\n\n251: def generate_input() -> np.ndarray:\n252:     for _ in range(GEN_ATTEMPTS):\n253:         grid = _gen_attempt()\n254:         if grid is not None:\n255:             return grid\n256:     raise RuntimeError(\"failed to generate valid 8a6d367c input\")\n\n","exit_code":0,"status":"completed"}}
