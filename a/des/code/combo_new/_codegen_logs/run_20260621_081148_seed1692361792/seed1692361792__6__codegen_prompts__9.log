{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/2e65ae53.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste, random_free_location\nimport random\n\n\ndef _dominant_foreground_color(g: np.ndarray, bg: int) -> int:\n    vals, counts = np.unique(g[g != int(bg)], return_counts=True)\n    assert vals.size > 0, \"expected foreground pixels\"\n    max_count = int(counts.max())\n    winners = vals[counts == max_count]\n    assert winners.size == 1, \"expected one largest foreground color for lattice frames\"\n    return int(winners[0])\n\n\ndef _parse_frames(g: np.ndarray, bg: int, frame_color: int) -> list[tuple[list[int], list[int]]]:\n    frames: list[tuple[list[int], list[int]]] = []\n    components = find_components(\n        g,\n        bg=int(bg),\n        colors=[int(frame_color)],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert components, \"expected at least one lattice frame\"\n\n    for comp in components:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        sub = g[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(frame_color)\n\n        row_idx = [r for r in range(sub.shape[0]) if bool(sub[r, :].all())]\n        col_idx = [c for c in range(sub.shape[1]) if bool(sub[:, c].all())]\n        assert len(row_idx) >= 2 and len(col_idx) >= 2, \"frame must divide slots\"\n        assert row_idx[0] == 0 and row_idx[-1] == sub.shape[0] - 1\n        assert col_idx[0] == 0 and col_idx[-1] == sub.shape[1] - 1\n        assert all(a + 1 < b for a, b in zip(row_idx, row_idx[1:]))\n        assert all(a + 1 < b for a, b in zip(col_idx, col_idx[1:]))\n\n        expected = np.zeros_like(sub, dtype=bool)\n        expected[row_idx, :] = True\n        expected[:, col_idx] = True\n        assert np.array_equal(sub, expected), \"frame must be a complete rectangular lattice\"\n\n        rows = [int(r0) + r for r in row_idx]\n        cols = [int(c0) + c for c in col_idx]\n        frames.append((rows, cols))\n\n    slot_rows = len(frames[0][0]) - 1\n    slot_cols = len(frames[0][1]) - 1\n    for rows, cols in frames:\n        assert len(rows) - 1 == slot_rows\n        assert len(cols) - 1 == slot_cols\n    return frames\n\n\ndef _infer_slot_colors(\n    g: np.ndarray,\n    bg: int,\n    frame_color: int,\n    frames: list[tuple[list[int], list[int]]],\n) -> dict[tuple[int, int], int]:\n    slot_rows = len(frames[0][0]) - 1\n    slot_cols = len(frames[0][1]) - 1\n    colors: dict[tuple[int, int], int] = {}\n\n    for rows, cols in frames:\n        for sr in range(slot_rows):\n            for sc in range(slot_cols):\n                region = g[rows[sr] + 1 : rows[sr + 1], cols[sc] + 1 : cols[sc + 1]]\n                marker = region[(region != int(bg)) & (region != int(frame_color))]\n                if marker.size == 0:\n                    continue\n                vals = np.unique(marker)\n                assert vals.size == 1, \"each colored slot must contain one color\"\n                color = int(vals[0])\n                key = (sr, sc)\n                assert key not in colors or colors[key] == color\n                colors[key] = color\n\n    expected = {(sr, sc) for sr in range(slot_rows) for sc in range(slot_cols)}\n    assert set(colors) == expected, \"colored slots must identify every logical slot\"\n    return colors\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill every lattice slot from the color assigned to that slot position by the other lattices.\n\n    Input structure:\n    - The background is the dominant color.\n    - The largest foreground color forms several one-pixel-thick rectangular lattice frames.\n    - The frame lines divide each lattice into the same row-by-column set of rectangular slots; some slots already contain one non-frame color.\n\n    Rule:\n    - Infer a color for each logical slot position from the colored slots across all lattice frames.\n    - Repaint every slot interior in every lattice with the inferred color for its row/column position.\n    - Keep the frame lines and all background outside frames unchanged.\n\n    Key insight:\n    - Slot sizes vary by frame, but the complete color pattern is indexed by lattice slot position rather than by absolute pixel size or location.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    frame_color = _dominant_foreground_color(g, bg)\n    frames = _parse_frames(g, bg, frame_color)\n    slot_colors = _infer_slot_colors(g, bg, frame_color, frames)\n\n    out = g.copy()\n    for rows, cols in frames:\n        for sr in range(len(rows) - 1):\n            for sc in range(len(cols) - 1):\n                out[rows[sr] + 1 : rows[sr + 1], cols[sc] + 1 : cols[sc + 1]] = slot_colors[\n                    (sr, sc)\n                ]\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Grid and palette choices.\nBG = 0\nGRID_SIZE_RANGE = (22, 28)\nNEAR_SQUARE_PROB = 0.65\nNEAR_SQUARE_DELTAS = [-2, -1, 0, 1, 2]\nFOREGROUND_COLORS = range(1, 10)\nPALETTE_SIZE = 5\n\n# Lattice geometry.\nSLOT_SIZE_RANGE = (1, 8)\nFRAME_HEIGHT_RANGE = (5, 18)\nFRAME_WIDTH_RANGE = (5, 14)\nLATTICE_LINE_COUNT = 3\nSLOT_POSITIONS = [(0, 0), (0, 1), (1, 0), (1, 1)]\n\n# Frame count and area allocation.\nFRAME_COUNT_RANGE = (4, 6)\nMIN_FRAME_AREA = 25\nAREA_BUDGET_RANGE = (0.55, 0.88)\nAREA_WEIGHT_SCALE = 35.0\n\n# Placement and retry limits.\nEDGE_BORDER = 1\nPLACEMENT_PADDING = 1\nPLACEMENT_CONNECTIVITY = 8\nMAX_GENERATION_ATTEMPTS = 300\n\nFrameSpec = tuple[tuple[int, int], tuple[int, int]]\nPlacedFrame = tuple[int, int, tuple[int, int], tuple[int, int]]\nSlotColors = dict[tuple[int, int], int]\n\n\ndef _line_indices(lengths: tuple[int, int]) -> list[int]:\n    return [0, int(lengths[0]) + 1, int(lengths[0]) + int(lengths[1]) + 2]\n\n\ndef _slot_options() -> dict[tuple[int, int], list[FrameSpec]]:\n    options: dict[tuple[int, int], list[FrameSpec]] = {}\n    slot_min, slot_max = SLOT_SIZE_RANGE\n    height_min, height_max = FRAME_HEIGHT_RANGE\n    width_min, width_max = FRAME_WIDTH_RANGE\n    for h0 in range(slot_min, slot_max + 1):\n        for h1 in range(slot_min, slot_max + 1):\n            height = h0 + h1 + LATTICE_LINE_COUNT\n            if not height_min <= height <= height_max:\n                continue\n            for w0 in range(slot_min, slot_max + 1):\n                for w1 in range(slot_min, slot_max + 1):\n                    width = w0 + w1 + LATTICE_LINE_COUNT\n                    if not width_min <= width <= width_max:\n                        continue\n                    options.setdefault((height, width), []).append(((h0, h1), (w0, w1)))\n    return options\n\n\n_SIZE_OPTIONS = _slot_options()\n\n\ndef _choose_frame_specs(n_frames: int, rows: int, cols: int) -> list[FrameSpec] | None:\n    keys = [size for size in _SIZE_OPTIONS if size[0] <= rows - 2 * EDGE_BORDER and size[1] <= cols - 2 * EDGE_BORDER]\n    random.shuffle(keys)\n\n    usable = (rows - 2 * EDGE_BORDER) * (cols - 2 * EDGE_BORDER)\n    budget = int(usable * random.uniform(*AREA_BUDGET_RANGE))\n    chosen_sizes: list[tuple[int, int]] = []\n    remaining = budget\n\n    for i in range(n_frames):\n        slots_left = n_frames - i - 1\n        candidates = [\n            size\n            for size in keys\n            if size not in chosen_sizes\n            and size[0] * size[1] <= remaining - slots_left * MIN_FRAME_AREA\n        ]\n        if not candidates:\n            return None\n        weights = []\n        target = max(MIN_FRAME_AREA, remaining / (slots_left + 1))\n        for height, width in candidates:\n            area = height * width\n            weights.append(1.0 / (1.0 + abs(area - target) / AREA_WEIGHT_SCALE))\n        size = random.choices(candidates, weights=weights, k=1)[0]\n        chosen_sizes.append(size)\n        remaining -= size[0] * size[1]\n\n    specs = [random.choice(_SIZE_OPTIONS[size]) for size in chosen_sizes]\n    specs.sort(key=lambda spec: (sum(spec[0]) + LATTICE_LINE_COUNT) * (sum(spec[1]) + LATTICE_LINE_COUNT), reverse=True)\n    return specs\n\n\ndef _choose_canvas_shape() -> tuple[int, int]:\n    grid_min, grid_max = GRID_SIZE_RANGE\n    rows = random.randint(grid_min, grid_max)\n    cols = random.randint(grid_min, grid_max)\n    if random.random() < NEAR_SQUARE_PROB:\n        delta = random.choice(NEAR_SQUARE_DELTAS)\n        cols = min(grid_max, max(grid_min, rows + delta))\n    return rows, cols\n\n\ndef _choose_palette() -> tuple[int, SlotColors]:\n    colors = random.sample(FOREGROUND_COLORS, PALETTE_SIZE)\n    frame_color = colors[0]\n    color_values = colors[1:]\n    random.shuffle(color_values)\n    slot_colors = {pos: color_values[i] for i, pos in enumerate(SLOT_POSITIONS)}\n    return frame_color, slot_colors\n\n\ndef _make_output_patch(heights: tuple[int, int], widths: tuple[int, int], frame_color: int, slot_colors: SlotColors) -> tuple[np.ndarray, list[int], list[int]]:\n    row_lines = _line_indices(heights)\n    col_lines = _line_indices(widths)\n    patch = np.zeros((row_lines[-1] + 1, col_lines[-1] + 1), dtype=int)\n    patch[row_lines, :] = int(frame_color)\n    patch[:, col_lines] = int(frame_color)\n\n    for sr, sc in SLOT_POSITIONS:\n        patch[row_lines[sr] + 1 : row_lines[sr + 1], col_lines[sc] + 1 : col_lines[sc + 1]] = slot_colors[(sr, sc)]\n    return patch, row_lines, col_lines\n\n\ndef _hint_providers(n_frames: int) -> dict[tuple[int, int], int]:\n    providers = [random.randrange(n_frames) for _ in SLOT_POSITIONS]\n    if len(set(providers)) == 1:\n        providers[random.randrange(len(providers))] = random.choice(\n            [idx for idx in range(n_frames) if idx != providers[0]]\n        )\n    return {pos: providers[i] for i, pos in enumerate(SLOT_POSITIONS)}\n\n\ndef _place_frames(rows: int, cols: int, specs: list[FrameSpec]) -> list[PlacedFrame] | None:\n    occ = np.zeros((rows, cols), dtype=int)\n    placed: list[PlacedFrame] = []\n    for heights, widths in specs:\n        height = sum(heights) + LATTICE_LINE_COUNT\n        width = sum(widths) + LATTICE_LINE_COUNT\n        block = np.ones((height, width), dtype=int)\n        try:\n            r0, c0 = random_free_location(occ, block, transparent=BG, border=EDGE_BORDER, padding=PLACEMENT_PADDING, padding_connectivity=PLACEMENT_CONNECTIVITY)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/c7f57c3e.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/c7f57c3e.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location\nimport random\n\n\ndef _pick_anchor_bbox(arr: np.ndarray, bg: int) -> tuple[int, int, int, int]:\n    \"\"\"Pick a stable anchor bbox inside the sprite array (color-1 pixels; always present).\"\"\"\n    if np.any(arr == 1):\n        ys, xs = np.where(arr == 1)\n        return int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())\n    assert False, \"sprite array has no color-1 pixels and should always have them\"\n\n\ndef _scale_nn(arr: np.ndarray, scale: int) -> np.ndarray:\n    if scale <= 1:\n        return arr.copy()\n    return np.repeat(np.repeat(arr, scale, axis=0), scale, axis=1)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swap every sprite to the opposite prototype while preserving scale and position.\n\n    Input structure:\n    - bg = most common color. Two distinct small sprite patterns (prototypes) appear at various scales.\n    - Each sprite instance is a scaled copy of one of the two prototypes, placed on the grid.\n\n    Rule:\n    - Identify the two prototype patterns from the smallest-area sprites.\n    - For each sprite, determine which prototype it matches and its integer scale factor.\n    - Replace it with the other prototype at the same scale, aligned by an internal anchor region (color-1 pixels).\n\n    Key insight: Every sprite toggles to the alternate prototype; the anchor sub-region inside each sprite pins the alignment so swapped sprites land in the correct position regardless of scale.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    comps = components_mask(g != bg, connectivity=8)\n    assert len(comps) >= 2, \"grid must contain at least 2 sprite components\"\n\n    # Extract sprite records.\n    sprites = []\n    for pts in comps:\n        r0, c0, r1, c1 = bbox_coords(pts)\n        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        sprites.append({\"pts\": pts, \"bbox\": (r0, c0, r1, c1), \"arr\": arr})\n\n    # Determine two base prototypes from the smallest bbox area sprites.\n    areas = [int((s[\"bbox\"][2] - s[\"bbox\"][0] + 1) * (s[\"bbox\"][3] - s[\"bbox\"][1] + 1)) for s in sprites]\n    min_area = min(areas)\n    base = [s for s, a in zip(sprites, areas, strict=False) if a == min_area]\n    uniq: dict[tuple[int, ...], np.ndarray] = {}\n    for s in base:\n        key = tuple(s[\"arr\"].ravel().tolist())\n        if key not in uniq:\n            uniq[key] = s[\"arr\"]\n    assert len(uniq) == 2, \"smallest-area sprites must yield exactly 2 distinct prototype patterns\"\n\n    proto_keys = list(uniq.keys())[:2]\n    protos = [uniq[proto_keys[0]], uniq[proto_keys[1]]]\n\n    anc0 = _pick_anchor_bbox(protos[0], bg)\n    anc1 = _pick_anchor_bbox(protos[1], bg)\n    a0r0, a0c0, a0r1, a0c1 = anc0\n    base_anc_h = a0r1 - a0r0 + 1\n    base_anc_w = a0c1 - a0c0 + 1\n\n    out = g.copy()\n\n    for s in sprites:\n        r0, c0, r1, c1 = s[\"bbox\"]\n        arr = s[\"arr\"]\n        anc = _pick_anchor_bbox(arr, bg)\n        ar0, ac0, ar1, ac1 = anc\n        inst_anc_h = ar1 - ar0 + 1\n        inst_anc_w = ac1 - ac0 + 1\n        # infer integer scale\n        scale_h = max(1, inst_anc_h // max(1, base_anc_h))\n        scale_w = max(1, inst_anc_w // max(1, base_anc_w))\n        scale = int(max(scale_h, scale_w))\n\n        # score which prototype matches this sprite when aligned by core bbox\n        best_idx = 0\n        best_score = -1\n        for idx, p in enumerate(protos):\n            sp = _scale_nn(p, scale)\n            panc = _pick_anchor_bbox(p, bg)\n            pr0, pc0, pr1, pc1 = panc\n            pr0 *= scale\n            pc0 *= scale\n            # align anchor top-left to instance anchor top-left (global coords)\n            top = (r0 + ar0) - pr0\n            left = (c0 + ac0) - pc0\n\n            # overlap score: count matching non-bg pixels where prototype expects non-bg\n            score = 0\n            ph, pw = sp.shape\n            rr0 = max(0, top)\n            cc0 = max(0, left)\n            rr1 = min(h, top + ph)\n            cc1 = min(w, left + pw)\n            if rr0 >= rr1 or cc0 >= cc1:\n                continue\n            sub_g = g[rr0:rr1, cc0:cc1]\n            sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]\n            m = sub_p != bg\n            if np.any(m):\n                score = int(np.sum(sub_g[m] == sub_p[m]))\n            if score > best_score:\n                best_score = score\n                best_idx = idx\n\n        repl_idx = 1 - best_idx\n\n        # Clear current sprite pixels.\n        for rr, cc in s[\"pts\"]:\n            out[rr, cc] = bg\n\n        # Place replacement.\n        p = protos[repl_idx]\n        sp = _scale_nn(p, scale)\n        panc = _pick_anchor_bbox(p, bg)\n        pr0, pc0, pr1, pc1 = panc\n        pr0 *= scale\n        pc0 *= scale\n        top = (r0 + ar0) - pr0\n        left = (c0 + ac0) - pc0\n\n        ph, pw = sp.shape\n        rr0 = max(0, top)\n        cc0 = max(0, left)\n        rr1 = min(h, top + ph)\n        cc1 = min(w, left + pw)\n        sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]\n        m = sub_p != bg\n        out_slice = out[rr0:rr1, cc0:cc1]\n        out_slice[m] = sub_p[m]\n        out[rr0:rr1, cc0:cc1] = out_slice\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- CFG: canvas ---\nGRID_SIZE_MIN = 18                  # square grid lower bound\nGRID_SIZE_MAX = 28                  # square grid upper bound\nGRID_MARGIN_FOR_SPRITES = 6         # min_n = max_sprite_dim + this\n\n# --- CFG: prototypes ---\nPROTO_SHAPES = [(4, 3), (3, 4), (4, 4)]  # (h, w) choices for label grid\nBG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9] # bg color pool (excludes 1)\nCOLOR_SHARE_PROB = 0.65             # prob that proto_B shares a color with proto_A\n\n# --- CFG: row-mask weights (anchor role vs variable role) ---\n#   each entry: (mask_type, weight)  where mask_type in {\"center\", \"outer\", \"full\"}\nANCHOR_ROW_WEIGHTS = [(\"center\", 0.45), (\"outer\", 0.35), (\"full\", 0.20)]\nVARIABLE_ROW_WEIGHTS = [(\"center\", 0.68), (\"full\", 0.32)]\nOUTER_FIXUP_PROB = 0.7             # when fixing no-edge row, prob of using outer vs full\n\n# --- CFG: sprite instances ---\nSPRITE_COUNTS = [3, 4]             # number of sprite instances per grid\nBIG_SCALES = [2, 3]                # scale factor for the one large sprite\n\n# --- CFG: placement ---\nPLACEMENT_BORDER = 1               # min distance from grid edge\nPLACEMENT_PADDING = 2              # min gap between sprite bboxes\nPLACEMENT_CONNECTIVITY = 8         # connectivity for padding check\n\n# --- CFG: generation retries ---\nMAX_RETRIES = 300\n\n# --- Row-mask patterns indexed by width ---\n_ROW_MASKS = {\n    \"center\": {3: [0, 1, 0], 4: [0, 1, 1, 0]},\n    \"outer\":  {3: [1, 0, 1], 4: [1, 0, 0, 1]},\n    \"full\":   {3: [1, 1, 1], 4: [1, 1, 1, 1]},\n}\n\n\ndef _row_mask(kind: str, w: int) -> list[int]:\n    \"\"\"Return a row occupancy mask of the given kind and width.\"\"\"\n    return list(_ROW_MASKS[kind][w])\n\n\ndef _anchor_bbox(arr: np.ndarray) -> tuple[int, int, int, int]:\n    \"\"\"Bounding box of color-1 (anchor) pixels: (r0, c0, r1, c1).\"\"\"\n    rs, cs = np.where(arr == 1)\n    return int(rs.min()), int(cs.min()), int(rs.max()), int(cs.max())\n\n\ndef _scale(arr: np.ndarray, k: int) -> np.ndarray:\n    \"\"\"Nearest-neighbor upscale by integer factor k.\"\"\"\n    if k == 1:\n        return arr.copy()\n    return np.repeat(np.repeat(arr, k, axis=0), k, axis=1)\n\n\ndef _make_labels() -> np.ndarray:\n    \"\"\"Build an (h, w) label grid with roles 1 (anchor), 2, 3 and bg holes (0).\"\"\"\n    h, w = random.choice(PROTO_SHAPES)\n\n    # Assign row counts per role (each role gets at least 1 row)\n    counts = {1: 1, 2: 1, 3: 1}\n    if h > 3:\n        counts[random.choice([1, 2, 3])] += h - 3\n    roles = []\n    for role in random.sample([1, 2, 3], 3):\n        roles.extend([role] * counts[role])\n\n    # Pick row masks via weighted sampling\n    weights_by_role = {\n        1: ANCHOR_ROW_WEIGHTS,\n        2: VARIABLE_ROW_WEIGHTS,\n        3: VARIABLE_ROW_WEIGHTS,\n    }\n    masks = []\n    for role in roles:\n        entries = weights_by_role[role]\n        kinds, wts = zip(*entries)\n        chosen_kind = random.choices(kinds, weights=wts)[0]\n        masks.append(_row_mask(chosen_kind, w))\n\n    # Fix-up: ensure at least one row touches the left/right edge\n    if not any(mask[0] or mask[-1] for mask in masks):\n        i = random.randrange(h)\n        if roles[i] == 1 and random.random() < OUTER_FIXUP_PROB:\n            masks[i] = _row_mask(\"outer\", w)\n        else:\n            masks[i] = _row_mask(\"full\", w)\n\n    # Fix-up: ensure at least one row has bg holes\n    if all(all(mask) for mask in masks):\n        masks[random.randrange(h)] = _row_mask(\"center\", w)\n\n    # Assemble label grid\n    labels = np.zeros((h, w), dtype=int)\n    for r, (role, mask) in enumerate(zip(roles, masks)):\n        for c, bit in enumerate(mask):\n            if bit:\n                labels[r, c] = role\n    return labels\n\n\ndef _make_prototypes(bg: int) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Create proto_A and proto_B (flipud + recolored) from a shared label grid.\"\"\"\n    labels = _make_labels()\n    pool = [c for c in range(10) if c not in (bg, 1)]\n    a_cols = random.sample(pool, 2)\n    remaining = [c for c in pool if c not in a_cols]\n    if random.random() < COLOR_SHARE_PROB:\n        b_cols = [random.choice(a_cols), random.choice(remaining)]\n        random.shuffle(b_cols)\n    else:\n        b_cols = random.sample(remaining, 2)\n\n    def _colorize(lab: np.ndarray, cols: list[int]) -> np.ndarray:\n        proto = np.full(lab.shape, bg, dtype=int)\n        proto[lab == 1] = 1\n","exit_code":0,"status":"completed"}}
