e input shows one small arrow near the upper-left plus many detached\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:88:# - To preserve arrow detectability, wall colors are assigned greedily so orthogonally\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:96:# - Assumption: there is exactly one arrow in combo samples. Guaranteed by generating\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:98:#   accidental second arrow component.\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:105:def _is_arrow_pts(pts: list[tuple[int, int]]) -> bool:\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:113:def _arrow_dir_and_start(pts: list[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int]] | None:\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:136:def _find_arrows_and_walls(\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:139:    arrow_cells: set[tuple[int, int]] = set()\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:140:    arrows: list[tuple[int, list[tuple[int, int]]]] = []\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:144:            if _is_arrow_pts(pts):\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:145:                arrows.append((int(col), pts))\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:146:                arrow_cells |= set(pts)\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:151:        if (int(r), int(c)) not in arrow_cells\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:153:    return arrows, arrow_cells, wall_cells\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:160:    arrows, arrow_cells, wall_cells = _find_arrows_and_walls(g, bg)\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:165:    for start_col, pts in arrows:\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/17/code.py:166:        info = _arrow_dir_and_start(pts)\\n/home/lixinyu/snap/