_combo/142ca369/27/code.py:453:        rich_arrow = ai == 0\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/27/code.py:458:            n_bounces = 2 if rich_arrow else _rng.choices([0, 1, 2], weights=[1, 4, 4])[0]\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/27/code.py:459:            min_total = sum(_min_segment_lengths(int(n_bounces), rich_arrow))\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/27/code.py:460:            max_total = 8 if rich_arrow else 7\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/27/code.py:464:            segment_lengths = _sample_segment_lengths(int(steps), int(n_bounces), rich_arrow)\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/27/code.py:477:            arrow_pts, _missing = _arrow_points(start_r, start_c, dr, dc)\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/27/code.py:479:            reserved = set(arrow_pts) | set(tail_pts)\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/27/code.py:514:            for r, c in arrow_pts:\\n/home/lixinyu/snap/new/ceshi/code_combo/221dfab4/5/code.py:257:    - A human sees three repeating colors inside the same narrow span: yellow stripe, red separator,\\n/home/lixinyu/snap/new/ceshi/code_combo/9385bd28/7/code.py:248:    - Neither color alone nor shape frequency alone is sufficient here. Color narrows the search, shape identifies which\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:20:     3-pixel L-arrows, and 1-pixel / 3-pixel monochrome wall segments.\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:37:   - Arrow colors are chosen from the remaining palette, so arrows and walls stay\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:41:   - Original assumption: every non-bg non-arrow pixel belongs to the playfield.\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:43:     before arrow/wall detection.\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:57:     then place arrows and walls, and finally verify with `main(input) == output`.\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:58:   - Rays, arrows, and walls do not overlap. Same-color wall cells from different\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:59:     segments are kept 4-disconnected so they cannot accidentally form L-arrows.\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:72:     of arrows, walls, and diagonal traces.\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:148:def _is_arrow_pts(pts: list[tuple[int, int]]) -> bool:\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:156:def _arrow_dir_and_start(pts: list[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int]] | None:\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:189:    Trace diagonal rays from L-arrows using a top-edge legend for wall-color turns.\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:205:    arrow_cells: set[tuple[int, int]] = set()\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:206:    arrows: list[tuple[int, list[tuple[int, int]]]] = []\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:210:            if _is_arrow_pts(pts):\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:211:                arrows.append((int(col), pts))\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:212:                arrow_cells |= set(pts)\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:217:        if (int(r), int(c)) not in arrow_cells\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:222:    for start_col, pts in arrows:\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:223:        info = _arrow_dir_and_start(pts)\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:252:            if (nr, nc) in arrow_cells:\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:392:def _plan_arrow(\\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/8/code.py:395:    arrow_color: int,\\n/h