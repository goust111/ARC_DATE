{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/0934a4d8.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import deque\n\nimport numpy as np\n\nfrom arc_utils import bbox\n\n\ndef _solid_rectangle_marker(g: np.ndarray) -> tuple[int, tuple[int, int, int, int]]:\n    candidates: list[tuple[int, int, tuple[int, int, int, int]]] = []\n    for color in np.unique(g):\n        mask = g == int(color)\n        b = bbox(mask)\n        assert b is not None\n        r0, c0, r1, c1 = b\n        area = int((r1 - r0 + 1) * (c1 - c0 + 1))\n        if area > 1 and int(mask.sum()) == area and bool(np.all(mask[r0 : r1 + 1, c0 : c1 + 1])):\n            candidates.append((area, int(color), b))\n\n    assert len(candidates) == 1\n    _area, color, b = candidates[0]\n    return color, b\n\n\ndef _find_reflected_strip_start(g: np.ndarray, marker: int) -> int:\n    n, m = map(int, g.shape)\n    assert n == m\n    hi = n - 1\n\n    for lo in range(n // 2 + 1):\n        strip = g[:, lo : hi + 1]\n        strip_reflected = strip[:, ::-1]\n        known = (strip != marker) & (strip_reflected != marker)\n        if bool(np.any((strip != strip_reflected) & known)):\n            continue\n\n        strip = g[lo : hi + 1, :]\n        strip_reflected = strip[::-1, :]\n        known = (strip != marker) & (strip_reflected != marker)\n        if bool(np.any((strip != strip_reflected) & known)):\n            continue\n\n        return lo\n\n    raise AssertionError(\"no reflected strip found\")\n\n\ndef _reflection_orbit_values(g: np.ndarray, r: int, c: int, lo: int, marker: int) -> set[int]:\n    n = int(g.shape[0])\n    hi = n - 1\n    seen: set[tuple[int, int]] = set()\n    values: set[int] = set()\n    q: deque[tuple[int, int]] = deque([(int(r), int(c))])\n\n    while q:\n        rr, cc = q.popleft()\n        if (rr, cc) in seen:\n            continue\n        seen.add((rr, cc))\n\n        value = int(g[rr, cc])\n        if value != marker:\n            values.add(value)\n\n        if lo <= cc <= hi:\n            q.append((rr, lo + hi - cc))\n        if lo <= rr <= hi:\n            q.append((lo + hi - rr, cc))\n\n    return values\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reveal the rectangular patch hidden by the solid marker using the grid's reflection symmetries.\n\n    Input structure:\n    - A square colored pattern with one solid rectangular marker color occluding a patch.\n    - The visible pattern has horizontal and vertical reflection symmetry on a large lower/right strip.\n    - The top and left outer strips also expose transpose counterparts for cells not recoverable by those reflections.\n\n    Rule:\n    - Find the unique color whose full extent is a solid rectangle; this rectangle is the output region.\n    - Infer the reflected strip start as the smallest row/column offset whose lower/right strips are mirror-consistent, ignoring marker pixels.\n    - For each marker pixel, copy the unique non-marker value in its horizontal/vertical reflection orbit; if that orbit is entirely hidden in the outer strip, use the transposed top/left-strip counterpart.\n\n    Key insight:\n    The marker is not part of the pattern; it covers a missing rectangle whose cells are still determined by the visible mirror or transpose copies elsewhere in the grid.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    marker, (r0, c0, r1, c1) = _solid_rectangle_marker(g)\n    lo = _find_reflected_strip_start(g, marker)\n\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    out = np.empty((h, w), dtype=int)\n\n    for rr in range(h):\n        for cc in range(w):\n            r = int(r0 + rr)\n            c = int(c0 + cc)\n            values = _reflection_orbit_values(g, r, c, lo, marker)\n            if values:\n                assert len(values) == 1\n                out[rr, cc] = values.pop()\n            else:\n                assert r < lo or c < lo\n                assert 0 <= c < g.shape[0] and 0 <= r < g.shape[1]\n                value = int(g[c, r])\n                assert value != marker\n                out[rr, cc] = value\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- CFG: canvas & structure ---\n_N = 30                  # grid side length (always square)\n_LO = 2                  # outer border width (rows/cols 0..lo-1 are \"free\" border)\n_HI = _N - 1             # max row/col index\n\n# --- CFG: colors ---\n_PALETTE = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)  # 8 non-marker colors\n_MARKER = 8              # marker fill color\n\n# --- CFG: marker rectangle size ---\n_MARKER_DIM_LO = 3       # min marker side length\n_MARKER_DIM_HI = 9       # max marker side length (inclusive)\n_MARKER_AREA_LO = 16     # min marker area\n_MARKER_AREA_HI = 36     # max marker area\n\n# --- CFG: generation retries ---\n_MAX_RETRIES = 300\n\n_RNG = np.random.default_rng()\n_SIZE_PAIRS = [\n    (h, w)\n    for h in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)\n    for w in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)\n    if _MARKER_AREA_LO <= h * w <= _MARKER_AREA_HI\n]\n_PLACEMENT_CACHE: dict[tuple[int, int], list[tuple[int, int, list[tuple[int, int]]]]] = {}\n\n\ndef _orbit(r: int, c: int) -> set[tuple[int, int]]:\n    \"\"\"Return the LR+UD reflection orbit of (r, c) within the [_LO.._HI] axes.\"\"\"\n    rows = {r}\n    cols = {c}\n    if _LO <= r <= _HI:\n        rows.add(_LO + _HI - r)\n    if _LO <= c <= _HI:\n        cols.add(_LO + _HI - c)\n    return {(rr, cc) for rr in rows for cc in cols}\n\n\ndef _fallback_cells(r0: int, c0: int, h: int, w: int) -> list[tuple[int, int]] | None:\n    \"\"\"Identify marker cells whose entire orbit is inside the marker (need transpose fallback).\n\n    Returns None if the placement is invalid (a fully-covered orbit cell lies\n    inside the inner block, or its transpose is also inside the marker).\n    \"\"\"\n    r1, c1 = r0 + h, c0 + w\n    cells: list[tuple[int, int]] = []\n    for r in range(r0, r1):\n        for c in range(c0, c1):\n            if all(r0 <= rr < r1 and c0 <= cc < c1 for rr, cc in _orbit(r, c)):\n                if r >= _LO and c >= _LO:\n                    return None  # orbit fully hidden but no transpose fallback available\n                if r0 <= c < r1 and c0 <= r < c1:\n                    return None  # transpose cell also hidden by marker\n                cells.append((r, c))\n    return cells\n\n\ndef _valid_placements(h: int, w: int) -> list[tuple[int, int, list[tuple[int, int]]]]:\n    \"\"\"Return all valid (r0, c0, fallback_cells) placements for a h x w marker, cached.\"\"\"\n    key = (h, w)\n    if key not in _PLACEMENT_CACHE:\n        placements: list[tuple[int, int, list[tuple[int, int]]]] = []\n        for r0 in range(_N - h + 1):\n            for c0 in range(_N - w + 1):\n                fallback = _fallback_cells(r0, c0, h, w)\n                if fallback is not None:\n                    placements.append((r0, c0, fallback))\n        _PLACEMENT_CACHE[key] = placements\n    return _PLACEMENT_CACHE[key]\n\n\ndef _unify_groups(clean: np.ndarray, groups: list[set[tuple[int, int]]]) -> None:\n    \"\"\"Merge coordinate groups with union-find so all members share a random color.\"\"\"\n    parent: dict[tuple[int, int], tuple[int, int]] = {}\n\n    def find(x: tuple[int, int]) -> tuple[int, int]:\n        parent.setdefault(x, x)\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(a: tuple[int, int], b: tuple[int, int]) -> None:\n        ra, rb = find(a), find(b)\n        if ra != rb:\n            parent[rb] = ra\n\n    for group in groups:\n        coords = list(group)\n        if not coords:\n            continue\n        for coord in coords[1:]:\n            union(coords[0], coord)\n\n    merged: dict[tuple[int, int], list[tuple[int, int]]] = {}\n    for coord in parent:\n        merged.setdefault(find(coord), []).append(coord)\n\n    for coords in merged.values():\n        color = int(_RNG.choice(_PALETTE))\n        for r, c in coords:\n            clean[r, c] = color\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, neighbors4\n\n\ndef _legend_directions(g: np.ndarray, bg: int) -> dict[int, tuple[int, int]]:\n    \"\"\"\n    Detect legend blocks on the border.\n\n    A legend is a border-touching non-background component whose most common color is the legend\n    background `C` (and also the region border color it controls). The legend contains at least\n    two additional colors: a \"center\" color (more frequent) and an \"indicator\" color (less frequent).\n\n    The movement direction for regions with border color `C` is:\n      sign(centroid(indicator) - centroid(center))\n    \"\"\"\n    h, w = g.shape\n    non_bg = g != bg\n    best: dict[int, tuple[int, tuple[int, int]]] = {}\n    for pts in components_mask(non_bg, connectivity=4):\n        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue\n        # Legends are filled rectangles on the border.\n        r0, c0, r1, c1 = bbox_coords(pts)\n        area = (r1 - r0 + 1) * (c1 - c0 + 1)\n        if area != len(pts):\n            continue\n\n        counts: dict[int, int] = {}\n        for r, c in pts:\n            v = int(g[r, c])\n            counts[v] = counts.get(v, 0) + 1\n        if len(counts) != 3:\n            continue\n\n        bg_col = max(counts, key=counts.get)\n        others = [(cnt, col) for col, cnt in counts.items() if col != bg_col]\n        if len(others) < 2:\n            continue\n        others.sort()  # ascending by count\n        if others[0][0] == others[1][0]:\n            # Tie: choose center as the color closer to the rectangle center.\n            rc = np.array([(r0 + r1) / 2.0, (c0 + c1) / 2.0])\n            cols = [others[0][1], others[1][1]]\n            cents = []\n            for col in cols:\n                pts_col = np.array([(r, c) for r, c in pts if int(g[r, c]) == col], dtype=float)\n                cents.append((np.sum((pts_col.mean(axis=0) - rc) ** 2), col))\n            cents.sort()\n            center_col = cents[0][1]\n            indicator_col = cents[1][1]\n        else:\n            indicator_col = others[0][1]\n            center_col = others[-1][1]\n\n        center = [(r, c) for r, c in pts if int(g[r, c]) == center_col]\n        indic = [(r, c) for r, c in pts if int(g[r, c]) == indicator_col]\n        if not center or not indic:\n            continue\n\n        cc = np.mean(np.array(center, dtype=float), axis=0)\n        ci = np.mean(np.array(indic, dtype=float), axis=0)\n        vr, vc = (ci - cc).tolist()\n        dr = 0 if abs(vr) < 1e-6 else (1 if vr > 0 else -1)\n        dc = 0 if abs(vc) < 1e-6 else (1 if vc > 0 else -1)\n        if dr == 0 and dc == 0:\n            continue\n\n        prev = best.get(bg_col)\n        if prev is None or len(pts) > prev[0]:\n            best[bg_col] = (len(pts), (dr, dc))\n\n    return {k: v for k, (_, v) in best.items()}\n\n\ndef _slide_points(region_set: set[tuple[int, int]], points: list[tuple[int, int]], dr: int, dc: int) -> list[tuple[int, int]]:\n    if not points:\n        return []\n    # Process from the far end (closest to destination boundary) inward.\n    points_sorted = sorted(points, key=lambda p: (dr * p[0] + dc * p[1], p[0], p[1]), reverse=True)\n    occupied = set()\n    out_pts = []\n    for r0, c0 in points_sorted:\n        r, c = r0, c0\n        while True:\n            nr, nc = r + dr, c + dc\n            if (nr, nc) not in region_set:\n                break\n            # For diagonal steps, disallow \"corner cutting\": both orthogonal intermediates must be inside the region.\n            if dr != 0 and dc != 0:\n                if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n                    break\n            if (nr, nc) in occupied:\n                break\n            r, c = nr, nc\n        occupied.add((r, c))\n        out_pts.append((r, c))\n    return out_pts\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/af726779.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/af726779.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, colors_present, get_bg\nimport random\nfrom functools import lru_cache\n\n\ndef _children_between_gapped_pairs(mask: np.ndarray) -> np.ndarray:\n    children = np.zeros(mask.shape, dtype=bool)\n    children[1:-1] = mask[:-2] & ~mask[1:-1] & mask[2:]\n    return children\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Grow an alternating pink/orange triangular trace downward from the horizontal orange seed row.\n\n    Input structure:\n    - The grid has a green background and one horizontal row containing all orange foreground pixels.\n    - The seed row may contain isolated orange pixels and adjacent orange runs.\n    - Pink is absent from the input and is used for the first generated row.\n\n    Rule:\n    - Copy the input grid.\n    - Two rows below the current active row, place a child pixel between each active pair\n      whose middle cell in the current row is background.\n    - Alternate generated row colors between pink and orange, stopping when no children\n      can be generated or the next row would leave the grid.\n\n    Key insight:\n    - Only an active-background-active triplet in the current row reproduces; contiguous\n      active runs do not produce children through occupied middle cells.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    assert bg == Color.GREEN, \"expected green background\"\n    assert Color.PINK not in colors_present(g), \"pink must be absent from the input\"\n\n    foreground_colors = colors_present(g, exclude={bg})\n    assert foreground_colors == [Color.ORANGE], \"expected orange as the only foreground color\"\n\n    seed_coords = np.argwhere(g == Color.ORANGE)\n    assert seed_coords.size > 0, \"expected at least one orange seed pixel\"\n    seed_rows = set(map(int, seed_coords[:, 0]))\n    assert len(seed_rows) == 1, \"expected all orange seed pixels on one row\"\n    seed_row = seed_rows.pop()\n\n    out = g.copy()\n    active = g[seed_row, :] == Color.ORANGE\n    paint_color = Color.PINK\n    row = seed_row + 2\n    while row < g.shape[0]:\n        children = _children_between_gapped_pairs(active)\n        if not np.any(children):\n            break\n        assert np.all(out[row, children] == bg), \"generated children must land on background\"\n        out[row, children] = paint_color\n        active = children\n        paint_color = Color.ORANGE if paint_color == Color.PINK else Color.PINK\n        row += 2\n\n    return out\n\n# --------------- generator (att2) ---------------\n\nROW_BOUNDS = (9, 21)\nCOL_BOUNDS = (15, 24)\nSEED_ROW_BOUNDS = (1, 4)\nEXTRA_ROWS_BELOW_LAST_GEN_BOUNDS = (1, 8)\nLEFT_MARGIN_MAX = 3\nRIGHT_MARGIN_MAX = 3\nRUN_COUNT_BOUNDS = (3, 9)\nORANGE_TOTAL_BOUNDS = (9, 12)\nRUN_LENGTH_BOUNDS = (1, 7)\nGAP_WIDTH = 1\nLEVEL_CHOICES = tuple(range(1, 9))\nLEVEL_WEIGHTS = (5, 4, 3, 2, 1, 0.5, 0.3, 0.2)\nLONG_RUN_WEIGHT_BASE = 1\nLONG_RUN_WEIGHT_EXP = 8\nLENGTH_ENERGY_EXP = 8\nRUN_COUNT_WEIGHT_EXP = 10\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_children_between_gapped_pairs(mask: np.ndarray) -> np.ndarray:\n    children = np.zeros(mask.shape, dtype=bool)\n    children[1:-1] = mask[:-2] & ~mask[1:-1] & mask[2:]\n    return children\n\n\n@lru_cache(maxsize=None)\ndef _gen_run_compositions(parts: int, total: int) -> tuple[tuple[int, ...], ...]:\n    if parts == 0:\n        return ((),) if total == 0 else ()\n\n    choices = []\n    min_run, max_run = RUN_LENGTH_BOUNDS\n    min_value = max(min_run, total - max_run * (parts - 1))\n    max_value = min(max_run, total - min_run * (parts - 1))\n    for value in range(min_value, max_value + 1):\n        for rest in _gen_run_compositions(parts - 1, total - value):\n            choices.append((value,) + rest)\n    return tuple(choices)\n\n\n@lru_cache(maxsize=None)\ndef _gen_level_count_from_runs(run_lengths: tuple[int, ...]) -> int:\n    span = sum(run_lengths) + GAP_WIDTH * (len(run_lengths) - 1)\n    active = np.zeros(span, dtype=bool)\n    col = 0\n    for length in run_lengths:\n        active[col : col + length] = True\n        col += length + GAP_WIDTH\n\n    levels = 0\n    while True:\n        children = _gen_children_between_gapped_pairs(active)\n        if not np.any(children):\n            return levels\n        levels += 1\n        active = children\n\n\n@lru_cache(maxsize=None)\ndef _gen_seed_options(cols: int, target_levels: int) -> tuple[tuple[tuple[int, ...], int], ...]:\n    options = []\n    for run_count in range(RUN_COUNT_BOUNDS[0], RUN_COUNT_BOUNDS[1] + 1):\n        for orange_total in range(ORANGE_TOTAL_BOUNDS[0], ORANGE_TOTAL_BOUNDS[1] + 1):\n            if orange_total < run_count:\n                continue\n            span = orange_total + GAP_WIDTH * (run_count - 1)\n            margin_total = cols - span\n            if margin_total < 0 or margin_total > LEFT_MARGIN_MAX + RIGHT_MARGIN_MAX:\n                continue\n            left_min = max(0, margin_total - RIGHT_MARGIN_MAX)\n            left_max = min(LEFT_MARGIN_MAX, margin_total)\n            left_margins = tuple(range(left_min, left_max + 1))\n            if not left_margins:\n                continue\n\n            for run_lengths in _gen_run_compositions(run_count, orange_total):\n                if _gen_level_count_from_runs(run_lengths) == target_levels:\n                    for left_margin in left_margins:\n                        options.append((run_lengths, left_margin))\n    return tuple(options)\n\n\ndef _gen_row_seed_pairs(target_levels: int) -> list[tuple[int, int]]:\n    pairs = []\n    for rows in range(ROW_BOUNDS[0], ROW_BOUNDS[1] + 1):\n        for seed_row in range(SEED_ROW_BOUNDS[0], SEED_ROW_BOUNDS[1] + 1):\n            last_gen_row = seed_row + 2 * target_levels\n            extra_rows = rows - 1 - last_gen_row\n            if EXTRA_ROWS_BELOW_LAST_GEN_BOUNDS[0] <= extra_rows <= EXTRA_ROWS_BELOW_LAST_GEN_BOUNDS[1]:\n                pairs.append((rows, seed_row))\n    return pairs\n\n\ndef _gen_place_seed(rows: int, cols: int, seed_row: int, run_lengths: tuple[int, ...], left_margin: int) -> np.ndarray:\n    grid = np.full((rows, cols), Color.GREEN, dtype=int)\n    col = left_margin\n    for length in run_lengths:\n        grid[seed_row, col : col + length] = Color.ORANGE\n        col += length + GAP_WIDTH\n    return grid\n\n\ndef _gen_seed_option_weight(run_lengths: tuple[int, ...]) -> float:\n    long_runs = sum(length > 1 for length in run_lengths)\n    length_energy = sum(length * length for length in run_lengths)\n    return (\n        (LONG_RUN_WEIGHT_BASE + long_runs) ** LONG_RUN_WEIGHT_EXP\n        * length_energy**LENGTH_ENERGY_EXP\n        / len(run_lengths) ** RUN_COUNT_WEIGHT_EXP\n    )\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    target_levels = random.choices(LEVEL_CHOICES, weights=LEVEL_WEIGHTS, k=1)[0]\n\n    row_seed_pairs = _gen_row_seed_pairs(target_levels)\n    if not row_seed_pairs:\n        return None\n    rows, seed_row = random.choice(row_seed_pairs)\n\n    col_choices = [cols for cols in range(COL_BOUNDS[0], COL_BOUNDS[1] + 1) if _gen_seed_options(cols, target_levels)]\n    if not col_choices:\n        return None\n    cols = random.choice(col_choices)\n\n    grouped_options = {}\n    for run_lengths, left_margin in _gen_seed_options(cols, target_levels):\n        grouped_options.setdefault(sum(run_lengths), []).append((run_lengths, left_margin))\n    run_group = random.choice(list(grouped_options.values()))\n    run_weights = [_gen_seed_option_weight(run_lengths) for run_lengths, _ in run_group]\n    run_lengths, left_margin = random.choices(run_group, weights=run_weights, k=1)[0]\n\n    grid = _gen_place_seed(rows, cols, seed_row, run_lengths, left_margin)\n    out = main(grid)\n    generated_rows = np.any(out != grid, axis=1)\n    if int(np.count_nonzero(generated_rows)) != target_levels:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate af726779 input\")\n","exit_code":0,"status":"completed"}}
