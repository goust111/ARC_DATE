{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/e729b7be.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the scene by adding the point-reflected copy of the colored object across the central marker.\n\n    Input structure\n    - The grid has odd dimensions, a dominant background, and a center-row marker color appearing only at the left edge, center, and right edge.\n    - A single divider color fills the center column except for the center marker.\n    - All remaining foreground pixels form the object to copy, entirely on the left side of the divider.\n    Rule\n    - Keep the input unchanged.\n    - For every object pixel, paint the pixel rotated 180 degrees around the center marker with the same color.\n    Key insight\n    - The center marker is the rotation center; the yellow-looking divider is not mirrored, it only separates the source from the empty target side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h % 2 == 1 and w % 2 == 1\n\n    cr, cc = h // 2, w // 2\n    bg = int(get_bg(g))\n\n    marker_color = int(g[cr, cc])\n    assert marker_color != bg\n    marker_mask = g == marker_color\n    expected_markers = np.zeros(g.shape, dtype=bool)\n    expected_markers[cr, 0] = True\n    expected_markers[cr, cc] = True\n    expected_markers[cr, w - 1] = True\n    assert np.array_equal(marker_mask, expected_markers)\n\n    center_col = g[:, cc]\n    divider_colors = {int(color) for color in np.unique(center_col) if int(color) != marker_color}\n    assert len(divider_colors) == 1\n    divider_color = next(iter(divider_colors))\n    assert divider_color != bg\n    expected_divider = np.zeros(g.shape, dtype=bool)\n    expected_divider[:, cc] = True\n    expected_divider[cr, cc] = False\n    assert np.array_equal(g == divider_color, expected_divider)\n\n    source_mask = (g != bg) & (g != marker_color) & (g != divider_color)\n    source_coords = np.argwhere(source_mask)\n    assert source_coords.size > 0\n    assert np.all(source_coords[:, 1] < cc)\n\n    out = g.copy()\n    for r, c in source_coords:\n        rr = 2 * cr - int(r)\n        rc = 2 * cc - int(c)\n        assert 0 <= rr < h and 0 <= rc < w\n        assert out[rr, rc] == bg\n        out[rr, rc] = g[r, c]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Colors and canvas bounds.\nBG_COLOR, DIVIDER_COLOR, MARKER_COLOR = 7, 4, 8\nGRID_SIZES, MIN_EMPTY_BORDER_ROWS = (15, 17, 19), 1\n\n# Convex source shape bounds.\nSOURCE_SPAN_RANGE = (10, 15)\nSOURCE_MAX_WIDTH_RANGE = (5, 7)\nSOURCE_EDGE_WIDTH_RANGE = (1, 3)\nWIDTH_STEP_CAP, SOURCE_PIXEL_RANGE = 2, (35, 83)\n\n# Color palette, band orders, and retry budget.\nSOURCE_COLORS = (0, 1, 2, 3, 5, 6, 9)\nSOURCE_COLOR_COUNT_RANGE, GEN_ATTEMPTS = (3, 7), 300\nCOLORING_KEYS = (\n    lambda item: (item[2], item[3], item[1]),\n    lambda item: (item[3], item[2], item[1]),\n    lambda item: (item[2] + item[3], item[2], item[1]),\n    lambda item: (item[2] - item[3], item[2], item[1]),\n)\n\n\ndef _gen_bounded_steps(total, slots, cap):\n    steps = []\n    remaining = total\n    for i in range(slots):\n        left = slots - i - 1\n        lo = max(0, remaining - cap * left)\n        hi = min(cap, remaining)\n        step = random.randint(lo, hi)\n        steps.append(step)\n        remaining -= step\n    return steps\n\n\ndef _gen_width_profile(span, max_width):\n    edge_width_hi = min(SOURCE_EDGE_WIDTH_RANGE[1], max_width)\n    start_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n    end_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n    min_up = (max_width - start_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n    min_down = (max_width - end_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n    if min_up + min_down + 1 > span:\n        return None\n\n    peak_start = random.randint(min_up, span - 1 - min_down)\n    peak_end = random.randint(peak_start, span - 1 - min_down)\n\n    widths = [start_width]\n    for step in _gen_bounded_steps(max_width - start_width, peak_start, WIDTH_STEP_CAP):\n        widths.append(widths[-1] + step)\n\n    widths.extend([max_width] * (peak_end - peak_start))\n\n    current = max_width\n    for step in _gen_bounded_steps(max_width - end_width, span - 1 - peak_end, WIDTH_STEP_CAP):\n        current -= step\n        widths.append(current)\n\n    area = sum(widths)\n    if not SOURCE_PIXEL_RANGE[0] <= area <= SOURCE_PIXEL_RANGE[1]:\n        return None\n    return widths\n\n\ndef _choose_source_extent(n, cr):\n    valid_spans = [s for s in range(SOURCE_SPAN_RANGE[0], SOURCE_SPAN_RANGE[1] + 1) if s <= n - 2 * MIN_EMPTY_BORDER_ROWS]\n    span = random.choice(valid_spans)\n    r0_min = max(MIN_EMPTY_BORDER_ROWS, cr - span + 1)\n    r0_max = min(cr, n - MIN_EMPTY_BORDER_ROWS - span)\n    r0 = random.randint(r0_min, r0_max)\n    return span, r0, cr - r0\n\n\ndef _paint_source_cells(out, r0, widths, outer, cc):\n    interior = []\n    source = []\n    for i, width in enumerate(widths):\n        r = r0 + i\n        c0 = cc - width\n        for j in range(width):\n            c = c0 + j\n            source.append((r, c))\n            if j == 0:\n                out[r, c] = outer\n            else:\n                interior.append((r, c, i, j))\n    return source, interior\n\n\ndef _gen_color_source(out, r0, widths, colors, cc):\n    outer = colors[0]\n    inner = colors[1:]\n    source, interior = _paint_source_cells(out, r0, widths, outer, cc)\n    if len(interior) < len(inner):\n        return None\n\n    key = COLORING_KEYS[random.randrange(len(COLORING_KEYS))]\n    interior.sort(key=key)\n    band_count = len(inner)\n    for rank, (r, c, _, _) in enumerate(interior):\n        out[r, c] = inner[min(band_count - 1, rank * band_count // len(interior))]\n\n    return source\n\n\ndef _reflect_source(out, source, cr, cc):\n    reflected = []\n    for r, c in source:\n        rr = 2 * cr - r\n        rc = 2 * cc - c\n        if out[rr, rc] != BG_COLOR:\n            return None\n        out[rr, rc] = out[r, c]\n        reflected.append((rr, rc))\n    return reflected\n\n\ndef _gen_attempt():\n    n = random.choice(GRID_SIZES)\n    cr = cc = n // 2\n    out = np.full((n, n), BG_COLOR, dtype=int)\n    out[:, cc] = DIVIDER_COLOR\n    out[cr, [0, cc, n - 1]] = MARKER_COLOR\n\n    span, r0, center_i = _choose_source_extent(n, cr)\n    max_width = random.randint(*SOURCE_MAX_WIDTH_RANGE)\n    widths = _gen_width_profile(span, max_width)\n    if widths is None:\n        return None\n    if widths[center_i] >= cc:\n        return None\n\n    color_count = random.randint(*SOURCE_COLOR_COUNT_RANGE)\n    colors = random.sample(SOURCE_COLORS, color_count)\n    source = _gen_color_source(out, r0, widths, colors, cc)\n    if source is None:\n        return None\n\n    reflected = _reflect_source(out, source, cr, cc)\n    if reflected is None:\n        return None\n\n    inp = out.copy()\n    for r, c in reflected:\n        inp[r, c] = BG_COLOR\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input():\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid e729b7be input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/902510d5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/902510d5.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _corner_distances(shape: tuple[int, int], corner: str, r: int, c: int) -> tuple[int, int]:\n    H, W = shape\n    if corner == \"TL\":\n        return int(r), int(c)\n    if corner == \"TR\":\n        return int(r), int(W - 1 - c)\n    if corner == \"BL\":\n        return int(H - 1 - r), int(c)\n    assert corner == \"BR\"\n    return int(H - 1 - r), int(W - 1 - c)\n\n\ndef _paint_corner_triangle(out: np.ndarray, corner: str, side: int, color: int) -> None:\n    H, W = out.shape\n    assert side > 0, \"triangle side length must be positive\"\n    for r in range(H):\n        for c in range(W):\n            a, b = _corner_distances((H, W), corner, r, c)\n            if a + b < side:\n                out[r, c] = int(color)\n\n\ndef _diagonal_direction(coords: set[tuple[int, int]]) -> str | None:\n    r0 = min(r for r, _ in coords)\n    r1 = max(r for r, _ in coords)\n    c0 = min(c for _, c in coords)\n    c1 = max(c for _, c in coords)\n    height = r1 - r0 + 1\n    width = c1 - c0 + 1\n    if height != width:\n        return None\n    n = height\n    local = {(r - r0, c - c0) for r, c in coords}\n    main_ok = all((c, r) in local for r, c in local)\n    anti_ok = all((n - 1 - c, n - 1 - r) in local for r, c in local)\n    if main_ok:\n        if (0, 0) in local and (n - 1, n - 1) not in local:\n            return \"TL\"\n        if (n - 1, n - 1) in local and (0, 0) not in local:\n            return \"BR\"\n    if anti_ok:\n        if (0, n - 1) in local and (n - 1, 0) not in local:\n            return \"TR\"\n        if (n - 1, 0) in local and (0, n - 1) not in local:\n            return \"BL\"\n    return None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Keep the largest 8-connected motif and replace the corner/control pixels with a solid corner triangle.\n\n    Input structure\n    - The background is the dominant color.\n    - Exactly one grid corner contains a foreground control pixel; it gives the\n      corner from which the triangle is painted.\n    - There is one unique largest 8-connected monochrome foreground object, the\n      motif that remains in the output; all other foreground pixels are controls.\n    - Every foreground component outside that motif is a singleton control pixel.\n    - The fill color is the unique control color that appears in at least two\n      non-corner control pixels.\n\n    Rule\n    - Start from a blank background canvas and redraw only the largest motif.\n    - Count the non-corner control pixels; that count is the triangle side.\n    - Paint the fill color on the right-triangle region where those two distances\n      from the marked corner's edges sum to less than the side length.\n\n    Key insight\n    - The scattered singleton controls are counted into a compact triangular\n      stack at the marked corner; only the largest motif is not part of the count.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    corners = {\n        \"TL\": (0, 0),\n        \"TR\": (0, W - 1),\n        \"BL\": (H - 1, 0),\n        \"BR\": (H - 1, W - 1),\n    }\n    marked_corners = [\n        (name, rc) for name, rc in corners.items() if int(g[rc]) != int(bg)\n    ]\n    assert len(marked_corners) == 1, \"expected exactly one foreground corner marker\"\n    corner, (corner_r, corner_c) = marked_corners[0]\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert comps, \"expected at least one foreground component\"\n    max_area = max(int(comp[\"area\"]) for comp in comps)\n    motif_candidates = [comp for comp in comps if int(comp[\"area\"]) == max_area]\n    assert len(motif_candidates) == 1, \"expected a unique largest motif\"\n    motif = motif_candidates[0]\n    motif_color = int(motif[\"color\"])\n    motif_coords = {tuple(map(int, coord)) for coord in motif[\"coords\"]}\n    motif_direction = _diagonal_direction(motif_coords)\n    assert motif_direction is not None, \"motif must be square and diagonal-symmetric\"\n    assert motif_direction == corner, \"corner marker must match motif diagonal direction\"\n\n    control_coords = [\n        (int(r), int(c))\n        for r, c in np.argwhere(g != bg)\n        if (int(r), int(c)) not in motif_coords\n    ]\n    assert (corner_r, corner_c) in control_coords, \"corner marker must be a control pixel\"\n    assert len(control_coords) > 1, \"expected non-corner control pixels\"\n\n    control_components = [comp for comp in comps if comp is not motif]\n    assert all(int(comp[\"area\"]) == 1 for comp in control_components), \"controls must be singleton components\"\n\n    control_counts = Counter(\n        int(g[r, c])\n        for r, c in control_coords\n        if (int(r), int(c)) != (corner_r, corner_c)\n    )\n    fill_candidates = [\n        int(color) for color, count in control_counts.items() if int(count) >= 2\n    ]\n    assert len(fill_candidates) == 1, \"expected one repeated non-corner fill color\"\n    fill_color = fill_candidates[0]\n    side = len(control_coords) - 1\n\n    out = np.full_like(g, bg)\n    for r, c in motif_coords:\n        out[r, c] = motif_color\n    _paint_corner_triangle(out, corner, int(side), fill_color)\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_ATTEMPTS = 300\n\n# Canvas and triangle bounds.\n_GEN_ROW_BOUNDS = (6, 15)\n_GEN_COL_BOUNDS = (9, 14)\n_GEN_TRIANGLE_SIDE_BOUNDS = (2, 5)\n\n# Color and control-pixel sampling.\n_GEN_COLORS = tuple(range(1, 10))\n_GEN_MARKER_AVOID_FILL_PROB = 0.8\n_GEN_FILL_COUNT_BOUNDS = (2, 3)\n\n# Sparse square motifs observed in the task examples.\n_GEN_MOTIF_TEMPLATES = [\n    (\"..#.\", \".#..\", \"#.#.\", \"...#\"),\n    (\".#...\", \"..#..\", \"..##.\", \".#..#\", \"#....\"),\n    (\n        \"...###...\",\n        \"..#......\",\n        \".##......\",\n        \"#..#.....\",\n        \"#...#....\",\n        \"#....#...\",\n        \"......#..\",\n        \".......#.\",\n        \"........#\",\n    ),\n    (\"#...\", \".#.#\", \"..#.\", \".#..\"),\n    (\"...#\", \"#.#.\", \"##..\", \".##.\"),\n]\n\n\ndef _gen_triangle_mask(shape, corner, side):\n    H, W = shape\n    rr, cc = np.indices((H, W))\n    if corner == \"TL\":\n        return rr + cc < side\n    if corner == \"TR\":\n        return rr + (W - 1 - cc) < side\n    if corner == \"BL\":\n        return (H - 1 - rr) + cc < side\n    return (H - 1 - rr) + (W - 1 - cc) < side\n\n\ndef _gen_dilate8(mask):\n    out = mask.copy()\n    out[1:, :] |= mask[:-1, :]\n    out[:-1, :] |= mask[1:, :]\n    out[:, 1:] |= mask[:, :-1]\n    out[:, :-1] |= mask[:, 1:]\n    out[1:, 1:] |= mask[:-1, :-1]\n    out[1:, :-1] |= mask[:-1, 1:]\n    out[:-1, 1:] |= mask[1:, :-1]\n    out[:-1, :-1] |= mask[1:, 1:]\n    return out\n\n\ndef _gen_patch_from_lines(lines):\n    return np.array([[ch == \"#\" for ch in row] for row in lines], dtype=bool)\n\n\ndef _gen_patch_variants(patch):\n    variants = []\n    seen = set()\n    for k in range(4):\n        rotated = np.rot90(patch, k)\n        for variant in (rotated, np.fliplr(rotated)):\n            key = tuple(map(tuple, variant.astype(int)))\n            if key not in seen:\n                seen.add(key)\n                variants.append(variant.copy())\n    return variants\n\n\ndef _gen_reflect_anti_diagonal(patch):\n    return np.flipud(np.fliplr(patch.T))\n\n\ndef _gen_is_diagonal_symmetric_patch(patch):\n    if patch.shape[0] != patch.shape[1]:\n        return False\n    main_ok = np.array_equal(patch, patch.T)\n    return main_ok or np.array_equal(patch, _gen_reflect_anti_diagonal(patch))\n\n\ndef _gen_patch_direction(patch):\n    if patch.shape[0] != patch.shape[1]:\n        return None\n    n = patch.shape[0]\n    main_ok = np.array_equal(patch, patch.T)\n    anti_ok = np.array_equal(patch, _gen_reflect_anti_diagonal(patch))\n    if main_ok:\n        if patch[0, 0] and not patch[n - 1, n - 1]:\n            return \"TL\"\n        if patch[n - 1, n - 1] and not patch[0, 0]:\n            return \"BR\"\n    if anti_ok:\n        if patch[0, n - 1] and not patch[n - 1, 0]:\n            return \"TR\"\n        if patch[n - 1, 0] and not patch[0, n - 1]:\n            return \"BL\"\n","exit_code":0,"status":"completed"}}
