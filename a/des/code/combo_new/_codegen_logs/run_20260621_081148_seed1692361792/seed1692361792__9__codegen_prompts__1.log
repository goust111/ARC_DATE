hich reconstructed frame covers the other.\n 133: \n 134:     Key insight:\n 135:     - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n 136:     \"\"\"\n 137:     g = np.asarray(grid, dtype=int)\n 138:     bg = int(get_bg(g))\n 139:     assert bg == 0\n 140: \n 141:     counts: list[tuple[int, int, np.ndarray]] = []\n 142:     for color in colors_present(g, exclude={bg}):\n 143:         rooms = _room_count_for_color(g, int(color))\n 144:         walls = _walls_for_color(g, int(color))\n 145:         counts.append((int(color), int(rooms), walls))\n 146: \n 147:     drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n 148:     pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n 149:     assert drawings\n 150:     assert len(pad_colors) == 1\n 151: \n 152:     pad = int(pad_colors[0])\n 153:     ordered: list[tuple[int, int, np.ndarray]] = []\n 154:     for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n 155:         group = [item for item in drawings if item[1] == rooms]\n 156:         ordered.extend(_cover_order(g, group))\n 157: \n 158:     width = max(rooms for _color, rooms, _walls in ordered)\n 159: \n 160:     out = np.full((len(ordered), width), pad, dtype=int)\n 161:     for r, (color, rooms, _walls) in enumerate(ordered):\n 162:         out[r, :rooms] = int(color)\n 163:     return out\n 164: \n 165: # --------------- generator (claude-opus-4-6) ---------------\n 166: \n 167: # ---- CFG: Tunable generation parameters ----\n 168: _FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n 169: _ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n 170: _TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n 171: _GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n 172:     5: (25, 30, 25, 30, 16, 18),\n 173:     4: (22, 30, 22, 30, 18, 22),\n 174:     3: (20, 30, 20, 30, 22, 25),\n 175: }\n 176: _CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n 177: _NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n 178: _WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n 179: _EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n 180: _OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n 181: _GEN_RETRIES = 300                   # outer retry limit\n 182: \n 183: \n 184: def _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n 185:     \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n 186:     if n * min_gap > max_total:\n 187:         return None\n 188:     gaps = [min_gap] * n\n 189:     remaining = max_total - sum(gaps)\n 190:     for i in range(n):\n 191:         extra = min(max_gap - gaps[i], remaining)\n 192:         if extra > 0:\n 193:             add = random.randint(0, extra)\n 194:             gaps[i] += add\n 195:             remaining -= add\n 196:     random.shuffle(gaps)\n 197:     return gaps\n 198: \n 199: \n 200: def _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n 201:     \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n 202:     if target_rooms == 1:\n 203:         gap_h = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_h - 2))\n 204:         gap_w = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_w - 2))\n 205:         h, w = gap_h + 2, gap_w + 2\n 206:         walls = np.zeros((h, w), dtype=bool)\n 207:         walls[0, :] = True\n 208:         walls[h - 1, :] = True\n 209:         walls[:, 0] = True\n 210:         walls[:, w - 1] = True\n 211:         return walls\n 212: \n 213:     # For target_rooms >= 2: grid of cells, then selectively merge\n 214:     possible_configs = []\n 215:     for nv in range(2, 6):\n 216:         for nh in range(2, 5):\n 217:             cells = (nv - 1) * (nh - 1)\n 218:             if target_rooms <= cells <= target_rooms + 4:\n 219:                 possible_configs.append((nv, nh, cells))\n 220:     if not possible_configs:\n 221:         for nv in range(2, 7):\n 222:             for nh in range(2, 6):\n 223:                 cells = (nv - 1) * (nh - 1)\n 224:                 if cells >= target_rooms:\n 225:                     possible_configs.append((nv, nh, cells))\n 226:     if not possible_configs:\n 227:         return None\n 228: \n 229:     n_vcols, n_hrows, total_cells = random.choice(possible_configs)\n 230:     n_row_gaps = n_hrows - 1\n 231:     n_col_gaps = n_vcols - 1\n 232:     min_gap, max_gap = _CELL_GAP_RANGE\n 233: \n 234:     if min_gap * n_row_gaps > max_h - 1 or min_gap * n_col_gaps > max_w - 1:\n 235:         return None\n 236: \n 237:     row_gaps = _random_gaps(n_row_gaps, min_gap, max_gap, max_h - 1)\n 238:     col_gaps = _random_gaps(n_col_gaps, min_gap, max_gap, max_w - 1)\n 239:     if row_gaps is None or col_gaps is None:\n--- end snippet ---\n--- snippet 475 ---\n 472:     return grid if np.array_equal(output, expected) else None\n 473: \n 474: \n 475: def generate_input() -> np.ndarray:\n 476:     for _ in range(_GEN_RETRIES):\n 477:         result = _gen_attempt()\n 478:         if result is not None:\n 479:             return result\n 480:     raise RuntimeError(f\"Failed to generate valid input after {_GEN_RETRIES} attempts\")\n--- end snippet ---\n===\nFILE: /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\n--- snippet 7 ---\n   4: from arc_utils import find_components, get_bg, neighbors4, paste\n   5: import random\n   6: \n   7: def main(grid: np.ndarray) -> np.ndarray:\n   8:     \"\"\"\n   9:     Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n  10: \n  11:     Input structure:\n  12:     - bg = most common color.\n  13:     - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n  14:     - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n  15: \n  16:     Rule:\n  17:     - Match each sprite to the border anchor sharing its marker color.\n  18:     - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n  19:     - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n  20: \n  21:     Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n  22:     \"\"\"\n  23:     g = np.array(grid, dtype=int)\n  24:     H, W = g.shape\n  25:     bg = int(get_bg(g))\n  26: \n  27:     def is_border(r: int, c: int) -> bool:\n  28:         return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n  29: \n  30:     # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n  31:     anchors_by_color: dict[int, tuple[int, int]] = {}\n  32:     for r in range(H):\n  33:         for c in range(W):\n  34:             if not is_border(r, c):\n  35:                 continue\n  36:             v = int(g[r, c])\n  37:             if v == int(bg):\n  38:                 continue\n  39:             ok = True\n  40:             for rr, cc in neighbors4(int(r), int(c)):\n  41:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n  42:                     ok = False\n  43:                     break\n  44:             if ok and v not in anchors_by_color:\n  45:                 anchors_by_color[int(v)] = (int(r), int(c))\n  46: \n  47:     assert not (not anchors_by_color)\n  48: \n  49:     anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n  50: \n  51:     # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n  52:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n  53: \n  54:     def component_marker_color(coords: np.ndarray) -> int | None:\n  55:         # For multi-color sprites, the marker color is the least frequent color inside the component.\n  56:         vals = [int(g[int(r), int(c)]) for r, c in coords]\n  57:         cnt = Counter(vals)\n  58:         if len(cnt) <= 1:\n  59:             return None\n  60:         return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n  61: \n  62:     def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n  63:         # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n  64:         pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n  65:         if not pts:\n  66:             return None\n  67:         if len(pts) == 1:\n  68:             return pts[0]\n  69:         S = {(int(r), int(c)) for r, c in coords}\n  70:         for r, c in pts:\n  71:             for rr, cc in neighbors4(int(r), int(c)):\n  72:                 if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n  73:                     return (int(r), int(c))\n  74:         return pts[0]\n  75: \n  76:     moves: list[tuple[np.ndarray, int, int]] = []\n  77: \n  78:     for comp in comps:\n  79:         coords = comp[\"coords\"]\n  80:         if coords.size == 0:\n  81:             continue\n  82: \n  83:         # --- STEP 3) Decide marker color for this component. ---\n  84:         marker_col = component_marker_color(coords)\n  85:         if marker_col is None:\n  86:             # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n  87:             if int(coords.shape[0]) != 1:\n  88:                 continue\n  89:             r, c = map(int, coords[0])\n  90:             v = int(g[r, c])\n  91:             if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n  92:         