de in that direction, stacking against the far wall.\n 113: \n 114:     Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n 115:     \"\"\"\n 116:     g = np.asarray(grid, dtype=int)\n 117:     h, w = g.shape\n 118:     bg = get_bg(g)\n 119: \n 120:     mover = 4  # yellow in ARC\n 121:     dirs = _legend_directions(g, bg)\n 122:     assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n 123: \n 124:     passable = (g == bg) | (g == mover)\n 125:     out = g.copy()\n 126: \n 127:     # Find enclosed passable regions (not connected to the outer border).\n 128:     for pts in components_mask(passable, connectivity=4):\n 129:         if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n 130:             continue  # outside background\n 131: \n 132:         movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n 133:         if not movers:\n 134:             continue\n 135: \n 136:         # Determine this region's border color by counting adjacent wall colors.\n 137:         border_counts: dict[int, int] = {}\n 138:         pset = {(int(r), int(c)) for r, c in pts}\n 139:         for r, c in pts:\n 140:             for nr, nc in neighbors4(r, c):\n 141:                 if not (0 <= nr < h and 0 <= nc < w):\n 142:                     continue\n 143:                 if (nr, nc) in pset:\n 144:                     continue\n 145:                 v = int(g[nr, nc])\n 146:                 if v == bg or v == mover:\n 147:                     continue\n 148:                 border_counts[v] = border_counts.get(v, 0) + 1\n 149:         if not border_counts:\n 150:             continue\n 151:         border_col = max(border_counts, key=border_counts.get)\n 152:         if border_col not in dirs:\n 153:             continue\n 154:         dr, dc = dirs[border_col]\n 155: \n 156:         # Clear old movers.\n 157:         for r, c in movers:\n 158:             out[r, c] = bg\n 159: \n 160:         # Slide and repaint.\n 161:         new_pts = _slide_points(pset, movers, dr, dc)\n 162:         for r, c in new_pts:\n 163:             out[r, c] = mover\n 164: \n 165:     return out\n 166: \n 167: # --------------- generator (claude-att1) ---------------\n 168: \n 169: \"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\n 170: import random\n 171: import numpy as np\n 172: \n 173: from arc_utils import label_mask, neighbors4, paste\n 174: \n 175: # ── Configuration ─────────────────────────────────────────────────\n 176: GRID_H, GRID_W = 20, 20\n 177: \n 178: # Legend\n 179: CARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n 180: DIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\n 181: CORNERS = ['TL', 'TR', 'BL', 'BR']\n 182: WALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\n 183: CARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\n 184: LEGEND_BUFFER = 1                          # cells of padding around legend patches\n 185: \n 186: # Regions\n 187: REGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\n 188: MAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\n 189: REGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n 190:     1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n 191: }\n 192: BLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n 193: \n 194: # Yellows\n 195: YELLOWS_PER_REGION = [1, 2]                # choices per region\n 196: MAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n 197: \n 198: # Outer loop\n 199: GEN_RETRIES = 300                          # max attempts in generate_input()\n 200: \n 201: \n 202: # ── Legend patches ────────────────────────────────────────────────\n 203: \n 204: def _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n 205:     \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n 206:     g = np.full((5, 5), fill, dtype=int)\n 207:     g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n 208:     g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n 209:     rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n 210:     return np.rot90(g, rot[(dr, dc)])\n 211: \n 212: \n 213: def _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n 214:     \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n 215:     g = np.full((6, 7), fill, dtype=int)\n 216:     g[1, 3] = 1\n 217:     g[2, 1] = 1; g[2, 4] = 1\n 218:     g[3, 2] = 1; g[3, 5] = 2\n 219:     g[4, 3] = 2\n 220:     if (dr, dc) == (1, 1): return g\n 221:     if (dr, dc) == (-1, 1): return np.flipud(g)\n--- end snippet ---\n--- snippet 604 ---\n 601:     return input_grid\n 602: \n 603: \n 604: def generate_input() -> np.ndarray:\n 605:     rng = random.Random()\n 606:     for _ in range(GEN_RETRIES):\n 607:         try:\n 608:             g = _gen_attempt(rng)\n 609:         except Exception:\n 610:             continue\n 611:         if g is not None:\n 612:             return g\n 613:     raise RuntimeError(\"generate_input: exceeded retries\")\n--- end snippet ---\n===\nFILE: /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py\n--- snippet 35 ---\n  32:     ]\n  33: \n  34: \n  35: def main(grid: np.ndarray) -> np.ndarray:\n  36:     \"\"\"\n  37:     Fill the one blank in each corner region so all four regions have the same color multiset.\n  38: \n  39:     Input structure:\n  40:     - The dominant background color forms one solid separator row and one solid\n  41:       separator column.\n  42:     - The separator cross splits the grid into four equal rectangular corner regions.\n  43:     - Each corner region contains exactly one background-colored blank pixel.\n  44: \n  45:     Rule:\n  46:     - Count the non-background colors in each corner region.\n  47:     - The completed region multiset is defined by the maximum observed count of\n  48:       each color across the four regions.\n  49:     - Replace each region's blank pixel with the single color needed to match that\n  50:       completed multiset.\n  51: \n  52:     Key insight:\n  53:     - The separator color inside a corner region is a missing value marker; comparing\n  54:       the four regions reveals the shared multiset without using numeric color order.\n  55:     \"\"\"\n  56:     g = np.asarray(grid, dtype=int)\n  57:     assert g.ndim == 2, \"expected a 2D grid\"\n  58:     height, width = map(int, g.shape)\n  59: \n  60:     bg = get_bg(g)\n  61:     color_counts = Counter(map(int, g.reshape(-1)))\n  62:     assert all(\n  63:         color == bg or count < color_counts[bg] for color, count in color_counts.items()\n  64:     ), \"background color must be uniquely dominant\"\n  65: \n  66:     cross_row, cross_col = _solid_separator_cross(g, bg)\n  67:     regions = _quadrants(cross_row, cross_col, height, width)\n  68:     region_shape = g[regions[0]].shape\n  69:     region_area = int(np.prod(region_shape))\n  70: \n  71:     counts_by_region: list[Counter[int]] = []\n  72:     blank_positions: list[tuple[int, int]] = []\n  73:     for row_slice, col_slice in regions:\n  74:         region = g[row_slice, col_slice]\n  75:         assert region.shape == region_shape, \"all corner regions must have the same shape\"\n  76:         blanks = np.argwhere(region == bg)\n  77:         assert len(blanks) == 1, \"each corner region must have exactly one blank\"\n  78: \n  79:         counts_by_region.append(Counter(map(int, region[region != bg].reshape(-1))))\n  80:         local_r, local_c = map(int, blanks[0])\n  81:         blank_positions.append((row_slice.start + local_r, col_slice.start + local_c))\n  82: \n  83:     target_counts: Counter[int] = Counter()\n  84:     for counts in counts_by_region:\n  85:         for color, count in counts.items():\n  86:             target_counts[color] = max(target_counts[color], count)\n  87:     assert sum(target_counts.values()) == region_area, \"completed region multiset must be unique\"\n  88: \n  89:     out = g.copy()\n  90:     for counts, (row, col) in zip(counts_by_region, blank_positions):\n  91:         missing = target_counts - counts\n  92:         assert len(missing) == 1, \"each blank must have exactly one matching fill color\"\n  93:         fill_color, fill_count = next(iter(missing.items()))\n  94:         assert fill_count == 1, \"each corner region must need one pixel of the fill color\"\n  95:         out[row, col] = fill_color\n  96: \n  97:     return out\n  98: \n  99: # --------------- generator (o5x) ---------------\n 100: # Canvas/palette bounds.\n 101: GRID_HALF_MIN = 2\n 102: GRID_HALF_MAX = 6\n 103: COLOR_COUNT = 10\n 104: MIN_TARGET_COLORS = 3\n 105: MAX_NON_BG_COLORS = COLOR_COUNT - 1\n 106: # Layout probabilities and constraints.\n 107: PREFERRED_GRID_HALF = (2, 2)\n 108: PREFERRED_GRID_PROB = 0.65\n 109: QUADRANT_COUNT = 4\n 110: SEPARATOR_WIDTH = 1\n 111: BG_DOMINANCE_MARGIN = 1\n 112: # Retry limit.\n 113: MAX_GENERATION_ATTEMPTS = 300\n 114: \n 115: def _gen_bounded_composition(total: int, parts: int, max_each: int) -> list[int] | None:\n 116:     if parts <= 0 or total < parts or total > parts * max_each:\n 117:         return None\n 118: \n 119:     counts = []\n 120:     remaining = total\n 121:     for i in range(parts):\n 122:         slots_left = parts - i - 1\n 123:         lo = max(1, remaining - slots_left * max_each)\n 124:         hi = min(max_each, remaining - slots_left)\n 125:         counts.append(random.randint(lo, hi))\n 126:         remaining -= counts[-1]\n 127: \n 128:     random.shuffle(counts)\n 129:     return counts\n 130: \n 131: \n 132: def _gen_grid_options() -> list[tuple[int, int, list[int], int]]:\n 133:     options = []\n 134:     for k in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n 135:         for m in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n 136:             area = k * m\n 137:             bg_count = 2 * k + 2 * m + SEPARATOR_WIDTH + QUADRANT_COUNT\n 138:             max_target_count = (bg_count - BG_DOMINANCE_MARGIN) // QUADRANT_COUNT\n 139:             max_colors = min(MAX_NON_BG_COLORS, area)\n 140:             valid_counts = [\n 141:                 c\n 142:                 for c in range(MIN_TARGET_COLORS, max_colors + 1)\n 143:                 if area <= c * max_target_count\n 144:             ]\n 145:             if valid_counts:\n 146:                 options.append((k, m, valid_counts, max_target_count))\n 147:     return options\n 148: \n 149: \n 150: def _gen_pick_grid_option() -> tuple[int, int, list[int], int]:\n 151:     options = _gen_grid_options()\n 152:     if random.random() < PREFERRED_GRID_PROB:\n 153:         preferred_k, preferred_m = PREFERRED_GRID_HALF\n 154:         for option in options:\n 155:             if option[0] == preferred_k and option[1] == preferred_m:\n--- end snippet ---\n--- snippet 213 ---\n 210:     return None\n 211: \n 212: \n 213: def generate_input() -> np.ndarray:\n 214:     for _ in range(MAX_GENERATION_ATTEMPTS):\n 215:         grid = _gen_attempt()\n 216:         if grid is not None:\n 217:             return grid\n 218:     raise RuntimeError(\"failed to generate a valid e3fe1151 input\")\n--- end snippet ---\n===\nFILE: /home/lixinyu/snap/new/ARC_code/train/538b439f.py\n--- snippet 121 ---\n 118:     out[mirrored[:, 0], mirrored[:, 1]] = int(source_color)\n 119: \n 120: \n 121: def main(grid: np.ndarray) -> np.ndarray:\n 122:     \"\"\"\n 123:     Reflect the solid rectangular source objects across the full separator line and color the gap with the separator color.\n 124: \n 125:     Input structure:\n 126:     - A dominant background contains one full-width or full-height one-pixel\n 127:       separator line in a non-background color.\n 128:     - One other foreground color forms solid rectangular objects, all strictly on the same side of that separator.\n 129:     - Remaining non-background pixels are scattered distractors.\n 130: \n 131:     Rule:\n 132:     - Keep the input grid shape and unchanged pixels outside each affected corridor.\n 133:     - Mirror each source object across the separator line.\n 134:     - For every source object, recolor the rectangular strip between the\n 135:       original object and its reflection to the separator color, then paint the\n 136:       reflected object in the source color.\n 137: \n 138:     Key insight:\n 139:     - The full straight line is a mirror axis; the real objects are identified\n 140:       structurally as the only solid rectangles confined to one side, while\n 141:       scattered pixels are noise that may be overwritten inside the corridor.\n 142:     \"\"\"\n 143:     g = np.asarray(grid, dtype=int)\n 144:     bg = get_bg(g)\n 145:     orient, axis, axis_color = _find_separator(g, bg)\n 146:     source_color, components = _find_source(g, bg, orient, axis, axis_color)\n 147: \n 148:     out = g.copy()\n 149:     for component in components:\n 150:         _mirror_and_connect(out, component, orient, axis, axis_color, source_color)\n 151:     return out\n 152: \n 153: # --------------- generator (att2, o5x) ---------------\n 154: \n 155: # Canvas and palette.\n 156: GRID_SIZE_RANGE = (18, 23)\n 157: COLOR_COUNT = 10\n 158: PALETTE_SIZE = 4\n 159: ORIENTATIONS = (\"vertical\", \"horizontal\")\n 160: AXIS_RATIO_RANGE = (0.35, 0.50)\n 161: SIDES = (-1, 1)\n 162: \n 163: # Source rectangles and reflected corridors.\n 164: SOURCE_RECT_COUNT_RANGE = (2, 3)\n 165: RECT_HEIGHT_RANGE = (2, 5)\n 166: RECT_WIDTH_RANGE = (2, 4)\n 167: SOURCE_GAP_TO_AXIS_RANGE = (2, 5)\n 168: MIN_RECT_INTERVAL_GAP = 1\n 169: \n 170: # Distractor scatter.\n 171: DISTRACTOR_DENSITY_RANGE = (0.03, 0.10)\n 172: MAX_DISTRACTOR_CLUSTERS = 4\n 173: DISTRACTOR_CLUSTER_TARGET_DIVISOR = 12\n 174: FORCE_CLUSTER_PROB = 0.70\n 175: DISTRACTOR_CLUSTER_SHAPES = (\n 176: 