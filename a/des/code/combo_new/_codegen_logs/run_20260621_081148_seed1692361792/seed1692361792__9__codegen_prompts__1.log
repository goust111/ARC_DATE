0: \n 171: \n 172: def main(grid: np.ndarray) -> np.ndarray:\n 173:     \"\"\"Predict the next panel in a framed sequence by continuing each scheduled colored interval.\n 174: \n 175:     Input structure\n 176:     - The grid is made from three or more equal panels in one row or one column.\n 177:     - The final input panel is the static target template; every earlier panel differs from it only by dynamic colors absent from the template.\n 178:     - Each dynamic color appears in a regular temporal schedule across the earlier panels.\n 179: \n 180:     Rule\n 181:     - Keep the final template panel as the output canvas.\n 182:     - For every dynamic color whose schedule reaches the next panel, compare its last two appearances.\n 183:     - Extrapolate each one-dimensional interval along the color's changing row or column axis and paint that predicted mask.\n 184: \n 185:     Key insight\n 186:     - The task is not asking for the last visible panel, but for the next frame after the blank/template slot.\n 187:     \"\"\"\n 188:     g = np.asarray(grid, dtype=int)\n 189:     panels, diff_colors = _split_panels(g)\n 190:     template = panels[-1]\n 191:     prior = panels[:-1]\n 192:     next_time = len(prior)\n 193: \n 194:     predictions: list[tuple[int, np.ndarray]] = []\n 195:     for color in diff_colors:\n 196:         times = [i for i, panel in enumerate(prior) if np.any(panel == color)]\n 197:         assert len(times) >= 2\n 198:         gaps = [b - a for a, b in zip(times, times[1:])]\n 199:         assert len(set(gaps)) == 1\n 200:         period = gaps[0]\n 201:         if next_time - times[-1] != period:\n 202:             continue\n 203: \n 204:         previous = prior[times[-2]] == color\n 205:         current = prior[times[-1]] == color\n 206:         predictions.append((color, _extrapolate_mask(previous, current)))\n 207: \n 208:     assert predictions\n 209:     occupied = np.zeros_like(template, dtype=bool)\n 210:     for _color, mask in predictions:\n 211:         assert not np.any(occupied & mask)\n 212:         occupied |= mask\n 213: \n 214:     out = template.copy()\n 215:     for color, mask in predictions:\n 216:         out[mask] = color\n 217:     return out\n 218: \n 219: # --------------- generator (o5x) ---------------\n 220: \n 221: # Canvas, orientation, and color sampling.\n 222: PANEL_SIZE_MIN, PANEL_SIZE_MAX = 5, 11\n 223: PANEL_COUNT_CHOICES, ORIENTATION_CHOICES = (3, 5), (False, True)\n 224: COLOR_POOL, TOTAL_COLOR_CHOICES, MOTION_AXIS_CHOICES = range(10), (4, 5), (0, 1)\n 225: \n 226: # Template decoration density and symmetry.\n 227: TEMPLATE_MIN_DECO_CELLS = 4\n 228: TEMPLATE_DECO_MIN_RATIO, TEMPLATE_DECO_MAX_RATIO = 0.10, 0.30\n 229: \n 230: # Blob motif and growth bounds.\n 231: BLOB_GROWTH_MIN, BLOB_GROWTH_MAX = 1, 4\n 232: BLOB_MAX_INITIAL_CELLS, BLOB_MAX_COMPONENTS = 7, 2\n 233: BLOB_MAX_LINE_COUNT, BLOB_MAX_WIDTH = 3, 3\n 234: BLOB_DIRECTIONS = (-1, 1)\n 235: \n 236: # Dynamic-color schedules.\n 237: SHORT_PRIOR_COUNT, MAX_DYNAMIC_COLORS = 2, 3\n 238: SCHEDULE_ALWAYS_2 = {\"period\": 1, \"times\": [0, 1], \"scheduled\": True}\n 239: SCHEDULE_ALWAYS_4 = {\"period\": 1, \"times\": [0, 1, 2, 3], \"scheduled\": True}\n 240: SCHEDULE_EVEN_4 = {\"period\": 2, \"times\": [0, 2], \"scheduled\": True}\n 241: SCHEDULE_FIRST3_4 = {\"period\": 1, \"times\": [0, 1, 2], \"scheduled\": False}\n 242: SCHEDULE_ODD_4 = {\"period\": 2, \"times\": [1, 3], \"scheduled\": False}\n 243: SCHEDULE_SECOND_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4)\n 244: SCHEDULE_THIRD_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4, SCHEDULE_FIRST3_4, SCHEDULE_ODD_4)\n 245: \n 246: # Placement and retry limits.\n 247: MASK_TRANSPARENT, PLACEMENT_BORDER = 0, 1\n 248: GENERATION_RETRIES = 300\n 249: \n 250: def _sym_orbits(h: int, w: int) -> list[list[tuple[int, int]]]:\n 251:     seen: set[tuple[int, int]] = set()\n 252:     orbits: list[list[tuple[int, int]]] = []\n 253:     for r in range(h):\n 254:         for c in range(w):\n 255:             if r not in (0, h - 1) and c not in (0, w - 1):\n 256:                 continue\n 257:             if (r, c) in seen:\n 258:                 continue\n 259:             orbit = sorted({(r, c), (r, w - 1 - c), (h - 1 - r, c), (h - 1 - r, w - 1 - c)})\n 260:             seen.update(orbit)\n 261:             orbits.append(orbit)\n 262:     return orbits\n 263: \n 264: \n 265: def _make_template(h: int, w: int, bg: int, deco: int) -> np.ndarray:\n 266:     out = np.full((h, w), bg, dtype=int)\n 267:     area = h * w\n 268:     min_deco = max(TEMPLATE_MIN_DECO_CELLS, int(np.ceil(area * TEMPLATE_DECO_MIN_RATIO)))\n 269:     max_deco = max(min_deco, int(np.floor(area * TEMPLATE_DECO_MAX_RATIO)))\n 270:     target = random.randint(min_deco, max_deco)\n 271:     orbits = _sym_orbits(h, w)\n 272:     random.shuffle(orbits)\n 273:     count = 0\n 274:     for orbit in orbits:\n 275:         if count >= target:\n 276:             break\n 277:         if count + len(orbit) > max_deco and count >= min_deco:\n 278:             continue\n 279:         for r, c in orbit:\n 280:             out[r, c] = deco\n 281:         count += len(orbit)\n 282:     return out\n 283: \n 284: \n 285: def _base_patterns(axis_len: int, line_len: int, max_back: int) -> list[tuple[int, list[list[tuple[int, int]]]]]:\n 286:     patterns: list[tuple[int, list[list[tuple[int, int]]]]] = []\n 287:     for growth in range(BLOB_GROWTH_MIN, BLOB_GROWTH_MAX + 1):\n 288:         extra = max_back * growth\n 289:         max_initial_width = axis_len - extra\n 290:         if max_initial_width < 1:\n 291:             continue\n 292: \n--- end snippet ---\n--- snippet 502 ---\n 499:     return _assemble_valid_input(panels, template, output, horizontal)\n 500: \n 501: \n 502: def generate_input() -> np.ndarray:\n 503:     for _ in range(GENERATION_RETRIES):\n 504:         grid = _gen_attempt()\n 505:         if grid is not None:\n 506:             return grid\n 507:     raise RuntimeErro