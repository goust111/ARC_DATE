] | None:\n 230:     if side < 0:\n 231:         end = int(axis) - int(gap) - 1\n 232:         start = end - int(size) + 1\n 233:     else:\n 234:         start = int(axis) + int(gap) + 1\n 235:         end = start + int(size) - 1\n 236:     if 0 <= start <= end < int(length):\n 237:         return start, end\n 238:     return None\n 239: \n 240: \n 241: def _mirror_span(axis: int, start: int, end: int) -> tuple[int, int]:\n--- end snippet ---\n--- snippet 473 ---\n 470:     return None\n 471: \n 472: \n 473: def generate_input() -> np.ndarray:\n 474:     for _ in range(GENERATION_ATTEMPTS):\n 475:         grid = _gen_attempt()\n 476:         if grid is not None:\n 477:             return grid\n 478:     raise RuntimeError(\"failed to generate valid input for 538b439f\")\n--- end snippet ---\n===\nFILE: /home/lixinyu/snap/new/ARC_code/train/e734a0e8.py\n--- snippet 43 ---\n  40:     return spans\n  41: \n  42: \n  43: def main(grid: np.ndarray) -> np.ndarray:\n  44:     \"\"\"\n  45:     Copy the unique colored sprite tile into every tiled cell marked by an internal separator-colored pixel.\n  46: \n  47:     Input structure\n  48:     - Full same-color separator rows and columns partition the grid into equal rectangular tiles.\n  49:     - One tile contains the only non-background, non-separator colored sprite.\n  50:     - Target tiles are otherwise background-colored but contain at least one internal pixel of the separator color.\n  51: \n  52:     Rule\n  53:     - Keep the separator lines and the source sprite tile unchanged.\n  54:     - Replace each marked target tile with an exact copy of the source tile.\n  55:     - Unmarked background-only tiles remain unchanged.\n  56: \n  57:     Key insight\n  58:     - The internal separator-colored pixels are placement markers; the single colored tile is the template to stamp into those marked cells.\n  59:     \"\"\"\n  60:     g = np.asarray(grid, dtype=int)\n  61:     assert g.ndim == 2 and g.size > 0, \"expected a nonempty 2D grid\"\n  62: \n  63:     separator, sep_rows, sep_cols = _separator_lines(g)\n  64:     row_spans = _spans(g.shape[0], sep_rows)\n  65:     col_spans = _spans(g.shape[1], sep_cols)\n  66: \n  67:     tile_heights = {r1 - r0 + 1 for r0, r1 in row_spans}\n  68:     tile_widths = {c1 - c0 + 1 for c0, c1 in col_spans}\n  69:     assert len(tile_heights) == 1 and len(tile_widths) == 1, \"expected equal-sized tile rows and columns\"\n  70:     tile_h = tile_heights.pop()\n  71:     tile_w = tile_widths.pop()\n  72: \n  73:     bg = _unique_mode(g[g != separator])\n  74:     assert bg != separator, \"background and separator colors must differ\"\n  75:     sprite_colors = [int(color) for color in np.unique(g) if int(color) not in {bg, separator}]\n  76:     assert len(sprite_colors) == 1, \"expected one sprite color\"\n  77:     sprite_color = sprite_colors[0]\n  78: \n  79:     source_tiles = []\n  80:     marked_origins = []\n  81:     for r0, r1 in row_spans:\n  82:         for c0, c1 in col_spans:\n  83:             tile = g[r0 : r1 + 1, c0 : c1 + 1]\n  84:             assert tile.shape == (tile_h, tile_w)\n  85:             has_sprite = np.any(tile == sprite_color)\n  86:             has_marker = np.any(tile == separator)\n  87:             if has_sprite:\n  88:                 assert not has_marker, \"source tile should contain only sprite and background\"\n  89:                 assert set(map(int, np.unique(tile))).issubset({bg, sprite_color})\n  90:                 source_tiles.append(tile.copy())\n  91:             elif has_marker:\n  92:                 assert set(map(int, np.unique(tile))).issubset({bg, separator})\n  93:                 marked_origins.append((r0, c0))\n  94:             else:\n  95:                 assert np.all(tile == bg), \"unmarked non-source tiles should be plain background\"\n  96: \n  97:     assert len(source_tiles) == 1, \"expected exactly one source sprite tile\"\n  98:     source_tile = source_tiles[0]\n  99: \n 100:     out = g.copy()\n 101:     for r0, c0 in marked_origins:\n 102:         out[r0 : r0 + tile_h, c0 : c0 + tile_w] = source_tile\n 103:     return out\n 104: \n 105: # --------------- generator (o5x) ---------------\n 106: \n 107: # Palette: separator, background, and sprite are distinct.\n 108: COLOR_POOL = range(10)\n 109: PALETTE_SIZE = 3\n 110: # Tile grid dimensions and odd square tile sizes.\n 111: TILE_ROWS_RANGE = (3, 4)\n 112: TILE_COLS_RANGE = (3, 4)\n 113: TILE_SIZE_CHOICES = [3, 5]\n 114: SEPARATOR_WIDTH = 1\n 115: # Sprite density and 4-connected component count by tile size.\n 116: SPRITE_PIXEL_RANGES = {3: (3, 4), 5: (8, 11)}\n 117: SPRITE_COMPONENT_CAPS = {3: 3, 5: 5}\n 118: NEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n 119: ORIENTATION_COUNT = 4\n 120: FLIP_PROBABILITY = 0.5\n 121: # Marker tiles and retry budget.\n 122: MARKER_COUNT_RANGE = (3, 5)\n 123: MAX_GENERATION_ATTEMPTS = 300\n 124: \n 125: \n 126: def _gen_neighbors4(r: int, c: int, size: int):\n 127:     for dr, dc in NEIGHBOR_OFFSETS_4:\n 128:         rr, cc = r + dr, c + dc\n 129:         if 0 <= rr < size and 0 <= cc < size:\n 130:             yield rr, cc\n 131: \n 132: \n 133: def _gen_partition(total: int, parts: int) -> list[int]:\n 134:     sizes = [1] * parts\n 135:     for _ in range(total - parts):\n 136:         sizes[random.randrange(parts)] += 1\n 137:     random.shuffle(sizes)\n 138:     return sizes\n 139: \n 140: \n 141: def _gen_separate_from_other(labels: np.ndarray, r: int, c: int, label: int) -> bool:\n 142:     size = int(labels.shape[0])\n 143:     for rr, cc in _gen_neighbors4(r, c, size):\n 144:         if labels[rr, cc] not in (0, label):\n 145:             return False\n 146:     return True\n 147: \n 148: \n 149: def _gen_sprite_tile(size: int, bg: int, sprite_color: int) -> np.ndarray | None:\n 150:     pixel_count = random.randint(*SPRITE_PIXEL_RANGES[size])\n 151:     component_count = random.randint(1, min(SPRITE_COMPONENT_CAPS[size], pixel_count