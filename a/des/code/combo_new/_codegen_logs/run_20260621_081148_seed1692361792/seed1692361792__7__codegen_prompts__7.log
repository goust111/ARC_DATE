{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"先检查参考实现和目标目录结构，再据此实现 `main()`/`generate_input()` 并跑你给的自检命令。"}}
{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py\nsed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/db7260a4.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py\nsed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/db7260a4.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg\nimport random\n\n\ndef _touches_edge(coords: np.ndarray, height: int, width: int) -> bool:\n    rows = coords[:, 0]\n    cols = coords[:, 1]\n    return bool(\n        np.any((rows == 0) | (rows == height - 1) | (cols == 0) | (cols == width - 1))\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, table, frame, and slot dimensions.\nCANVAS_MIN, CANVAS_MAX = 13, 19\nTABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\nROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\nAXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n\n# Object and palette sampling limits.\nN_COLORS, MAX_OBJECT_COLORS = 10, 6\nMAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\nOBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n\n# Rejection sampling cap.\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_axis_options(n_slots, slot_min, slot_max):\n    options = []\n\n    def rec_slots(i, cur):\n        if i == n_slots:\n            rec_seps(0, [], cur)\n            return\n        for size in range(slot_min, slot_max + 1):\n            rec_slots(i + 1, cur + [size])\n\n    def rec_seps(i, cur, slots):\n        if i == n_slots - 1:\n            for before in AXIS_OUTER_OPTIONS:\n                for after in AXIS_OUTER_OPTIONS:\n                    for pad_before in AXIS_PADDING_OPTIONS:\n                        for pad_after in AXIS_PADDING_OPTIONS:\n                            total = (\n                                before\n                                + after\n                                + pad_before\n                                + pad_after\n                                + sum(slots)\n                                + sum(cur)\n                            )\n                            if 13 <= total <= 19:\n                                options.append(\n                                    (\n                                        tuple(slots),\n                                        tuple(cur),\n                                        before,\n                                        after,\n                                        pad_before,\n                                        pad_after,\n                                        total,\n                                )\n                            )\n            return\n        for sep in AXIS_SEPARATOR_OPTIONS:\n            rec_seps(i + 1, cur + [sep], slots)\n\n    rec_slots(0, [])\n    return options\n\n\ndef _gen_positions(axis):\n    sizes, seps, outer_before, _outer_after, pad_before, _pad_after, _total = axis\n    starts = []\n    pos = outer_before + pad_before\n    for i, size in enumerate(sizes):\n        starts.append(pos)\n        pos += size\n        if i < len(seps):\n            pos += seps[i]\n    return starts\n\n\ndef _gen_choose_axis(n_slots, slot_min, slot_max, other_axis=None, max_object_loss=0):\n    options = _gen_axis_options(n_slots, slot_min, slot_max)\n    if other_axis is None:\n        return random.choice(options)\n\n    good = []\n    for axis in options:\n        row_axis = axis if slot_max == ROW_SLOT_SIZE_RANGE[1] else other_axis\n        col_axis = axis if slot_max == COL_SLOT_SIZE_RANGE[1] else other_axis\n        height = row_axis[-1]\n        width = col_axis[-1]\n        frame_height = height - row_axis[2] - row_axis[3]\n        frame_width = width - col_axis[2] - col_axis[3]\n        slot_area = sum(row_axis[0]) * sum(col_axis[0])\n        outer_bg = height * width - frame_height * frame_width\n        bg_room = outer_bg + slot_area - max_object_loss\n        frame_area = frame_height * frame_width - slot_area\n        if bg_room > frame_area:\n            good.append(axis)\n    return random.choice(good or options)\n\n\ndef _gen_assign_colors(shape, bg, frame):\n    n_slots = shape[0] * shape[1]\n    filled_count = random.randint(1, n_slots - 1)\n    filled = random.sample(range(n_slots), filled_count)\n    colors = [c for c in range(N_COLORS) if c not in (bg, frame)]\n    n_colors = random.randint(1, min(MAX_OBJECT_COLORS, filled_count, len(colors)))\n    palette = random.sample(colors, n_colors)\n    assignments = palette[:]\n    assignments.extend(random.choice(palette) for _ in range(filled_count - n_colors))\n    random.shuffle(assignments)\n\n    out = np.full(shape, bg, dtype=int)\n    for idx, color in zip(filled, assignments):\n        out[idx // shape[1], idx % shape[1]] = color\n    return out, filled_count\n\n\ndef _gen_object_shape(slot_h, slot_w):\n    by_area = {}\n    for obj_h in range(1, min(MAX_OBJECT_HEIGHT, slot_h - 2 * OBJECT_MARGIN) + 1):\n        for obj_w in range(1, min(MAX_OBJECT_WIDTH, slot_w - 2 * OBJECT_MARGIN) + 1):\n            by_area.setdefault(obj_h * obj_w, []).append((obj_h, obj_w))\n    area = random.choice(list(by_area))\n    return random.choice(by_area[area])\n\n\ndef _gen_choose_layout(rows, cols, filled_count):\n    row_axis = _gen_choose_axis(rows, *ROW_SLOT_SIZE_RANGE)\n    loss = MAX_OBJECT_AREA * filled_count\n    col_axis = _gen_choose_axis(cols, *COL_SLOT_SIZE_RANGE, row_axis, max_object_loss=loss)\n    return row_axis, col_axis, _gen_positions(row_axis), _gen_positions(col_axis)\n\n\ndef _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts):\n    height = row_axis[-1]\n    width = col_axis[-1]\n    grid = np.full((height, width), bg, dtype=int)\n    rt, rb = row_axis[2], row_axis[3]\n    cl, cr = col_axis[2], col_axis[3]\n    grid[rt : height - rb, cl : width - cr] = frame\n\n    for r, slot_h in zip(row_starts, row_axis[0]):\n        for c, slot_w in zip(col_starts, col_axis[0]):\n            grid[r : r + slot_h, c : c + slot_w] = bg\n    return grid\n\n\ndef _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts):\n    for out_r, slot_r in enumerate(row_starts):\n        slot_h = row_axis[0][out_r]\n        for out_c, slot_c in enumerate(col_starts):\nfrom __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg, paste\n\n\ndef _closed_u_containers(g: np.ndarray, wall_color: int, bg: int) -> list[tuple[int, int, int, int]]:\n    h, w = g.shape\n    containers = []\n\n    for bottom in range(1, h):\n        for left in range(w - 2):\n            if int(g[bottom, left]) != wall_color:\n                continue\n            for right in range(left + 2, w):\n                if int(g[bottom, right]) != wall_color:\n                    continue\n                if not np.all(g[bottom, left : right + 1] == wall_color):\n                    continue\n\n                top = bottom\n                while top > 0 and int(g[top - 1, left]) == wall_color and int(g[top - 1, right]) == wall_color:\n                    top -= 1\n                if top == bottom:\n                    continue\n\n                interior = g[top:bottom, left + 1 : right]\n                if interior.size == 0 or not np.all(interior == bg):\n                    continue\n                containers.append((top, bottom, left, right))\n\n    return containers\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the singleton marker into the matching red U-shaped container, or make a bottom-row puddle if no closed container is hit.\n\n    Input structure\n    - The grid has a dominant background, one singleton marker pixel on the top row,\n      and one other foreground color forming vertical bars and bottom segments.\n    - A closed container is a U shape: two vertical side bars with a continuous\n      bottom segment between them and an empty rectangular interior above the bottom.\n\n    Rule\n    - Remove the top marker from its original cell.\n    - If exactly one closed U-shaped container has the marker column within its\n      horizontal footprint, fill that container's empty interior with the marker color.\n    - If no closed container is under the marker column, fill the whole bottom row\n      with the marker color.\n\n    Key insight\n    - The marker does not identify a color by value; it identifies a vertical drop\n      column, and only a structurally closed U shape can catch and contain the fill.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    foreground_colors = colors_present(g, exclude={bg})\n    assert len(foreground_colors) == 2, \"expected marker and wall colors\"\n\n    singleton_colors = [color for color in foreground_colors if int(np.count_nonzero(g == color)) == 1]\n    assert len(singleton_colors) == 1, \"expected exactly one singleton marker color\"\n    marker_color = singleton_colors[0]\n\n    wall_colors = [color for color in foreground_colors if color != marker_color]\n    assert len(wall_colors) == 1\n    wall_color = wall_colors[0]\n\n    marker_coords = np.argwhere(g == marker_color)\n    assert marker_coords.shape == (1, 2)\n    marker_r, marker_c = map(int, marker_coords[0])\n    assert marker_r == 0, \"marker must sit on the top row\"\n\n    containers = [\n        container\n        for container in _closed_u_containers(g, wall_color, bg)\n        if container[0] > marker_r and container[2] <= marker_c <= container[3]\n    ]\n    assert len(containers) <= 1, \"marker column must select at most one closed container\"\n\n    out = g.copy()\n    out[marker_r, marker_c] = bg\n    if containers:\n        top, bottom, left, right = containers[0]\n        out[top:bottom, left + 1 : right] = marker_color\n    else:\n        assert np.all(out[-1, :] == bg), \"missed marker should fall to an empty bottom row\"\n        out[-1, :] = marker_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed ARC colors and canvas.\n_GEN_BG = 0\n_GEN_MARKER = 1\n_GEN_WALL = 2\n_GEN_H = 10\n_GEN_W = 10\n\n# Vertical layout bounds; row 9 stays empty in generated inputs.\n_GEN_MARKER_ROW = 0\n_GEN_MIN_WALL_ROW = 2\n_GEN_LAST_WALL_ROW = 8\n\n# Closed container interior size ranges, with exclusive upper bounds.\n_GEN_INTERIOR_H_RANGE = (2, 4)\n_GEN_INTERIOR_W_RANGE = (1, 6)\n\n# Broken distractor patch size ranges, with exclusive upper bounds.\n_GEN_DISTRACTOR_H_RANGE = (2, 4)\n_GEN_DISTRACTOR_W_RANGE = (4, 7)\n\n# Scenario mix and distractor count ranges, with exclusive upper bounds.\n_GEN_FILL_CONTAINER_PROB = 0.67\n_GEN_MISSED_HAS_U_PROB = 0.55\n_GEN_DISTRACTORS_WITH_U_RANGE = (0, 2)\n_GEN_DISTRACTORS_WITHOUT_U_RANGE = (1, 4)\n\n# Rejection-sampling retry budget.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_u_patch(interior_h: int, interior_w: int) -> np.ndarray:\n    patch = np.full((interior_h + 1, interior_w + 2), _GEN_BG, dtype=int)\n    patch[:, 0] = _GEN_WALL\n    patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    return patch\n\n\ndef _gen_sample_u() -> tuple[int, int, int, int, int, int]:\n    interior_h = int(np.random.randint(*_GEN_INTERIOR_H_RANGE))\n    interior_w = int(np.random.randint(*_GEN_INTERIOR_W_RANGE))\n    top = int(np.random.randint(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - interior_h + 1))\n    bottom = top + interior_h\n    left = int(np.random.randint(0, _GEN_W - interior_w - 1))\n    right = left + interior_w + 1\n    return top, bottom, left, right, interior_h, interior_w\n\n\ndef _gen_broken_u_patch(height: int, width: int, *, gap: int | None = None, missing_side: str | None = None) -> np.ndarray:\n    patch = np.full((height, width), _GEN_BG, dtype=int)\n    if missing_side != \"left\":\n        patch[:, 0] = _GEN_WALL\n    if missing_side != \"right\":\n        patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    if gap is not None:\n        patch[-1, gap] = _GEN_BG\n    return patch\n\n\ndef _gen_distractor_patches() -> list[np.ndarray]:\n    patches: list[np.ndarray] = []\n\n    for h in range(*_GEN_DISTRACTOR_H_RANGE):\n        for w in range(*_GEN_DISTRACTOR_W_RANGE):\n            gap = int(np.random.randint(1, w - 1))\n            patches.append(_gen_broken_u_patch(h, w, gap=gap))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"left\"))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"right\"))\n\n    return patches\n\n\ndef _gen_valid_positions(grid: np.ndarray, patch: np.ndarray) -> list[tuple[int, int]]:\n    ph, pw = patch.shape\n    local = np.argwhere(patch == _GEN_WALL)\n    local_set = {(int(r), int(c)) for r, c in local}\n    touch_local = {\n        (r + dr, c + dc)\n        for r, c in local_set\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1))\n        if (r + dr, c + dc) not in local_set\n    }\n    positions: list[tuple[int, int]] = []\n\n    for r0 in range(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - ph + 2):\n        for c0 in range(0, _GEN_W - pw + 1):\n            if np.any(grid[r0 + local[:, 0], c0 + local[:, 1]] != _GEN_BG):\n                continue\n            touches = any(\n                0 <= r0 + r < _GEN_H\n                and 0 <= c0 + c < _GEN_W\n                and grid[r0 + r, c0 + c] == _GEN_WALL\n                for r, c in touch_local\n            )\n            if not touches:\n                positions.append((r0, c0))\n\n    return positions\n\n\ndef _gen_place_distractors(grid: np.ndarray, count: int) -> bool:\n    patches = _gen_distractor_patches()\n    for _ in range(count):\n        placed = False\n        for idx in np.random.permutation(len(patches)):\n            patch = patches[int(idx)]\n            positions = _gen_valid_positions(grid, patch)\n            if not positions:\n                continue\n            r0, c0 = positions[int(np.random.randint(0, len(positions)))]\n            paste(grid, patch, r0, c0, transparent=_GEN_BG)\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n\n\n_GenUBox = tuple[int, int, int, int]\n\n\ndef _gen_design_expected() -> tuple[np.ndarray, bool, _GenUBox | None, int, int]:\n    \"\"\"Build the expected output and return metadata needed to derive the input.\"\"\"\n    expected = np.full((_GEN_H, _GEN_W), _GEN_BG, dtype=int)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\nsed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/78e78cff.py\nsed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\nsed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/78e78cff.py\nsed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py\"","aggregated_output":"import numpy as np\nfrom collections import Counter, deque\n\nfrom arc_utils import components_mask, get_bg, neighbors4, neighbors8\nimport random\ndef _components_mask(mask: np.ndarray, conn8: bool) -> list[list[tuple[int, int]]]:\n    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(mask, connectivity=8 if conn8 else 4)]\n\n\ndef _touches_border(pts: list[tuple[int, int]], h: int, w: int) -> bool:\n    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n\n\ndef _seed_pixels(g: np.ndarray, bg: int) -> list[tuple[int, int]]:\n    h, w = g.shape\n    vals, cnts = np.unique(g, return_counts=True)\n    seeds: list[tuple[int, int]] = []\n    for v, cnt in zip(vals, cnts):\n        v = int(v)\n        if v == bg or int(cnt) != 1:\n            continue\n        r, c = map(int, np.argwhere(g == v)[0])\n        if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n            seeds.append((r, c))\n    return seeds\n\n\ndef _nonbg_component8_from(g: np.ndarray, start: tuple[int, int], bg: int) -> set[tuple[int, int]]:\n    h, w = g.shape\n    st = [start]\n    vis = {start}\n    while st:\n        r, c = st.pop()\n        for nr, nc in neighbors8(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in vis and int(g[nr, nc]) != bg:\n                vis.add((nr, nc))\n                st.append((nr, nc))\n    return vis\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\ndef _in_bounds(h, w, r, c):\n    return 0 <= r < h and 0 <= c < w\n\n\n# ---------------------------------------------------------------------------\n# Frame geometry\n# ---------------------------------------------------------------------------\n\ndef _frame_ring_coords(r0, c0, ch, cw):\n    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n\n    Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).\n    Ring = bbox boundary minus 4 corners.\n    \"\"\"\n    H, W = ch + 2, cw + 2\n    ring = []\n    for dr in range(H):\n        for dc in range(W):\n            on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)\n            corner = (dr in (0, H - 1)) and (dc in (0, W - 1))\n            if on_bdr and not corner:\n                ring.append((r0 + dr, c0 + dc))\n    cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]\n    return ring, cavity\n\n\ndef _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n\n    Returns True if: ring and cavity cells are empty, no cavity cell is\n    8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and\n    at least one ring cell is 8-adjacent to a line_col pixel.\n    \"\"\"\n    # Ring and cavity cells must all be empty\n    for rr, cc in ring:\n        if canvas[rr, cc] != -1:\n            return False\n    for rr, cc in cavity:\n        if canvas[rr, cc] != -1:\n            return False\n\n    # No cavity cell may be 8-adjacent to any line_col pixel\n    for cr, cc in cavity:\n        for nr, nc in neighbors8(cr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return False\n\n    # Ring must not be 8-adjacent to any non-bg, non-line_col pixel\n    ring_set = set(ring)\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:\n                continue\n            v = canvas[nr, nc]\n            if v != -1 and v != line_col:\n                return False\n\n    # At least one ring cell must be 8-adjacent to a line_col pixel\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return True\n    return False\n\n\n# ---------------------------------------------------------------------------\nfrom __future__ import annotations\n\nimport random\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg\n\n\ndef _wall_row_interval(wall_cols: np.ndarray, marker_col: int, width: int) -> tuple[int, int]:\n    left = wall_cols[wall_cols < marker_col]\n    right = wall_cols[wall_cols >= marker_col]\n    assert left.size or right.size, \"wall row must constrain the marker column\"\n\n    if left.size and right.size:\n        start = int(left.max()) + 1\n        stop = int(right.min()) - 1\n    elif left.size:\n        start = int(left.max()) + 1\n        stop = int(width) - 1\n    else:\n        start = 0\n        stop = int(right.min()) - 1\n\n    assert 0 <= start <= stop < int(width), \"wall row must leave a nonempty passage\"\n    return start, stop\n\n\ndef _assert_wall_connectivity(g: np.ndarray, wall_color: int, marker_col: int) -> None:\n    wall_coords = {tuple(map(int, coord)) for coord in np.argwhere(g == wall_color)}\n    remaining = set(wall_coords)\n    component_count = 0\n    while remaining:\n        component_count += 1\n        stack = [remaining.pop()]\n        while stack:\n            r, c = stack.pop()\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    if dr == 0 and dc == 0:\n                        continue\n                    neighbor = (r + dr, c + dc)\n                    if neighbor in remaining:\n                        remaining.remove(neighbor)\n                        stack.append(neighbor)\n    assert component_count == 4, \"wall must form four 8-connected arcs around the four openings\"\n\n    rows: dict[int, tuple[list[int], list[int]]] = {}\n    for r in range(g.shape[0]):\n        wall_cols = [int(c) for c in np.flatnonzero(g[r] == wall_color)]\n        if not wall_cols:\n            continue\n        left = [c for c in wall_cols if c < marker_col]\n        right = [c for c in wall_cols if c > marker_col]\n        for side_cols in (left, right):\n            if side_cols:\n                assert side_cols == list(range(min(side_cols), max(side_cols) + 1)), \"wall side blocks must be contiguous\"\n        rows[r] = (left, right)\n\n    for r in sorted(rows):\n        if r - 1 not in rows:\n            continue\n        prev_left, prev_right = rows[r - 1]\n        left, right = rows[r]\n        for prev_side, side in ((prev_left, left), (prev_right, right)):\n            if prev_side and side:\n                assert min(abs(a - b) for a in prev_side for b in side) <= 1, \"adjacent wall rows must remain 8-connected\"\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the row-wise passage indicated by wall pixels with the singleton marker color.\n\n    Input structure:\n    - A dominant background contains one singleton marker pixel and one wall color.\n    - Wall pixels lie on several rows and form left/right limits around the marker column.\n    - Empty rows between the top and bottom wall rows are open horizontal passages.\n\n    Rule:\n    - On a wall row, paint background pixels between the nearest wall strictly\n      left of the marker column and the nearest wall at or right of it; if only\n      one side is present, paint from that wall to the opposite grid edge.\n    - On empty rows between the top and bottom wall rows, paint the whole row.\n    - On empty rows outside the wall-row band, reuse the nearest end wall-row interval.\n    - Preserve wall pixels and the original marker pixel.\n\n    Key insight:\n    - The wall color defines scanline limits relative to the marker column; the\n      marker color fills those implied horizontal spans rather than flood-filling\n      through connected background.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = g.shape\n\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 2, \"expected exactly a marker color and a wall color\"\n\n    marker_colors = [color for color in fg_colors if int(np.count_nonzero(g == color)) == 1]\n    assert len(marker_colors) == 1, \"expected a unique singleton marker color\"\n    marker_color = int(marker_colors[0])\n    wall_colors = [color for color in fg_colors if int(color) != marker_color]\n    assert len(wall_colors) == 1, \"expected one wall color\"\n    wall_color = int(wall_colors[0])\n\n    marker_coords = np.argwhere(g == marker_color)\n    assert marker_coords.shape == (1, 2), \"expected exactly one marker pixel\"\n    marker_row, marker_col = map(int, marker_coords[0])\n    _assert_wall_connectivity(g, wall_color, marker_col)\n\n    row_intervals: dict[int, tuple[int, int]] = {}\n    for r in range(height):\n        wall_cols = np.flatnonzero(g[r] == wall_color)\n        if wall_cols.size:\n            row_intervals[int(r)] = _wall_row_interval(wall_cols, marker_col, width)\n\n    assert row_intervals, \"expected at least one wall row\"\n    top_wall_row = min(row_intervals)\n    bottom_wall_row = max(row_intervals)\n    assert top_wall_row <= marker_row <= bottom_wall_row, \"marker must lie within the wall-row band\"\n\n    out = g.copy()\n    for r in range(height):\n        if r in row_intervals:\n            start, stop = row_intervals[r]\n        elif top_wall_row < r < bottom_wall_row:\n            start, stop = 0, int(width) - 1\n        elif r < top_wall_row:\n            start, stop = row_intervals[top_wall_row]\n        else:\n            start, stop = row_intervals[bottom_wall_row]\n\n        span = out[r, start : stop + 1]\n        span[span == bg] = marker_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\nfrom arc_utils import components_mask\n\n# Canvas and band choices.\nHEIGHT_BAND_EMPTY_OPTIONS = ((11, 5, 1), (11, 6, 1), (11, 6, 2), (12, 6, 1), (12, 6, 2), (12, 7, 1), (12, 7, 2))\nGRID_WIDTH_RANGE = (11, 12)\nBAND_TOP_ROW = 2\n\n# Palette and marker placement.\nCOLOR_IDS = range(10)\nCOLOR_COUNT = 3\nMARKER_COL_RANGE = (3, 8)\n\n# Wall shape and pixel-count controls.\nWALL_PIXEL_RANGE = (8, 14)\nBASE_WALL_OFFSET = 1\nPEAK_WALL_OFFSET_MIN = 2\nSIDE_BLOCK_MAX_LEN = 2\nEXPECTED_WALL_COMPONENTS = 4\nONE_SIDED_ROW_PROB = 0.25\nONE_SIDED_OPTIONS = (\"left\", \"right\")\n\nGENERATION_RETRIES = 300\n\n\ndef _wall_interval(wall_cols: list[int], marker_col: int, width: int) -> tuple[int, int]:\n    left = [c for c in wall_cols if c < marker_col]\n    right = [c for c in wall_cols if c > marker_col]\n    if left and right:\n        return max(left) + 1, min(right) - 1\n    if left:\n        return max(left) + 1, width - 1\n    return 0, min(right) - 1\n\n\ndef _expected_output(grid, bg, marker, intervals, top, bottom):\n    \"\"\"Return the solver output implied by the generated wall intervals.\"\"\"\n    height, width = grid.shape\n    out = grid.copy()\n    for r in range(height):\n        if r in intervals:\n            start, stop = intervals[r]\n        elif top < r < bottom:\n            start, stop = 0, width - 1\n        elif r < top:\n            start, stop = intervals[top]\n        else:\n            start, stop = intervals[bottom]\n        span = out[r, start : stop + 1]\n        span[span == bg] = marker\n    return out\n\n\ndef _center_empty_rows(top: int, band_len: int, empty_count: int) -> set[int]:\n    bottom = top + band_len - 1\n    if empty_count == 1:\n        if band_len % 2:\n            return {(top + bottom) // 2}\n        return {random.choice([(top + bottom) // 2, (top + bottom) // 2 + 1])}\n    if band_len % 2:\n        mid = (top + bottom) // 2\n        return set(random.choice([(mid - 1, mid), (mid, mid + 1)]))\n    mid = (top + bottom) // 2\n    return {mid, mid + 1}\n\n\ndef _peak_offsets(wall_rows: list[int], top: int, bottom: int, maximum: int) -> dict[int, int]:\n    max_depth = max(min(r - top, bottom - r) for r in wall_rows)\n    if max_depth == 0:\n        return {r: BASE_WALL_OFFSET for r in wall_rows}\n    peak = random.randint(PEAK_WALL_OFFSET_MIN, min(maximum, BASE_WALL_OFFSET + max_depth))\n    offsets = {}\n    for r in wall_rows:\n        depth = min(r - top, bottom - r)\n        offsets[r] = BASE_WALL_OFFSET + round((peak - BASE_WALL_OFFSET) * depth / max_depth)\n    return offsets\n\n\ndef _wall_component_count(wall_cols_by_row: dict[int, list[int]]) -> int:\n    max_row = max(wall_cols_by_row)\n    max_col = max(c for cols in wall_cols_by_row.values() for c in cols)\nfrom __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, label_mask, paste\nimport random\n\n\nclass _Node:\n    def __init__(self, coords: np.ndarray, bbox: tuple[int, int, int, int], center: np.ndarray):\n        self.coords = coords\n        self.bbox = bbox\n        self.center = center\n        self.is_frame = False\n        self.parent: _Node | None = None\n        self.children: list[_Node] = []\n        self.mask: np.ndarray | None = None\n        self.anchor: tuple[int, int] | None = None\n        self.axis_map: dict[str, list[tuple[float, int]]] = {\"row\": [], \"col\": []}\n\n\ndef _component_holes(shape: tuple[int, int], coords: np.ndarray) -> list[np.ndarray]:\n    mask = np.zeros(shape, dtype=bool)\n    mask[tuple(coords.T)] = True\n    lab, n = label_mask(~mask, connectivity=4)\n    boundary = set(lab[0, :]) | set(lab[-1, :]) | set(lab[:, 0]) | set(lab[:, -1])\n    return [(lab == k) for k in range(1, n + 1) if k not in boundary]\n\n\ndef _intervals_overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:\n    return max(a[0], b[0]) <= min(a[1], b[1])\n\n\ndef _build_layout(node: _Node) -> None:\n    if node.mask is not None:\n        return\n\n    if not node.is_frame:\n        node.mask = np.ones((1, 1), dtype=bool)\n        node.anchor = (0, 0)\n        node.axis_map = {\n            \"row\": [(float(node.center[0]), 0)],\n            \"col\": [(float(node.center[1]), 0)],\n        }\n        return\n\n    assert node.children\n    child_mask, _placements, axis_map = _layout_group(node.children)\n    h, w = child_mask.shape\n    out = np.zeros((h + 4, w + 4), dtype=bool)\n    out[0, :] = True\n    out[-1, :] = True\n    out[:, 0] = True\n    out[:, -1] = True\n    out[2 : 2 + h, 2 : 2 + w] |= child_mask\n\n    node.mask = out\n    node.anchor = (out.shape[0] // 2, out.shape[1] // 2)\n    node.axis_map = {\n        \"row\": [(orig, pos + 2) for orig, pos in axis_map[\"row\"]],\n        \"col\": [(orig, pos + 2) for orig, pos in axis_map[\"col\"]],\n    }\n\n\ndef _axis_coordinates(nodes: list[_Node], axis: int) -> dict[_Node, int]:\n    items = []\n    for node in nodes:\n        assert node.mask is not None and node.anchor is not None\n        r0, c0, r1, c1 = node.bbox\n        interval = (r0, r1) if axis == 0 else (c0, c1)\n        mid = (interval[0] + interval[1]) / 2\n        items.append((node, interval, mid, node.anchor[axis], node.mask.shape[axis]))\n\n    bands: list[dict] = []\n    for item in sorted(items, key=lambda x: x[2]):\n        interval = item[1]\n        for band in bands:\n            if any(_intervals_overlap(interval, other[1]) for other in band[\"items\"]):\n                band[\"items\"].append(item)\n                band[\"interval\"] = (\n                    min(band[\"interval\"][0], interval[0]),\n                    max(band[\"interval\"][1], interval[1]),\n                )\n                break\n        else:\n            bands.append({\"items\": [item], \"interval\": interval})\n\n    coord_by_node: dict[_Node, int] = {}\n    coord = 0\n    for i, band in enumerate(bands):\n        if i:\n            prev = bands[i - 1]\n            prev_down = max(item[4] - 1 - item[3] for item in prev[\"items\"])\n            curr_up = max(item[3] for item in band[\"items\"])\n            coord += prev_down + 2 + curr_up\n        for item in band[\"items\"]:\n            coord_by_node[item[0]] = int(coord)\n\n    return coord_by_node\n\n\ndef _layout_group(nodes: list[_Node]) -> tuple[np.ndarray, dict[_Node, tuple[int, int]], dict[str, list[tuple[float, int]]]]:\n    assert nodes\n    for node in nodes:\n        _build_layout(node)\n\n    row_coord = _axis_coordinates(nodes, axis=0)\n    col_coord = _axis_coordinates(nodes, axis=1)\n\n    min_r = min(row_coord[n] - n.anchor[0] for n in nodes if n.anchor is not None)\n    min_c = min(col_coord[n] - n.anchor[1] for n in nodes if n.anchor is not None)\n    max_r = max(\n        row_coord[n] - n.anchor[0] - min_r + n.mask.shape[0]\n        for n in nodes\n        if n.anchor is not None and n.mask is not None\n    )\n    max_c = max(\n        col_coord[n] - n.anchor[1] - min_c + n.mask.shape[1]\n        for n in nodes\n        if n.anchor is not None and n.mask is not None\n    )\n\n    out = np.zeros((max_r, max_c), dtype=bool)\n    placements: dict[_Node, tuple[int, int]] = {}\n    axis_map = {\"row\": [], \"col\": []}\n    for node in nodes:\n        assert node.mask is not None and node.anchor is not None\n        r = row_coord[node] - node.anchor[0] - min_r\n        c = col_coord[node] - node.anchor[1] - min_c\n        placements[node] = (int(r), int(c))\n        out[r : r + node.mask.shape[0], c : c + node.mask.shape[1]] |= node.mask\n        axis_map[\"row\"].append((float(node.center[0]), int(r + node.anchor[0])))\n        axis_map[\"col\"].append((float(node.center[1]), int(c + node.anchor[1])))\n\n    return out, placements, axis_map\n\n\ndef _outside_side(dot: _Node, frame: _Node) -> str:\n    r0, c0, r1, c1 = dot.bbox\n    fr0, fc0, fr1, fc1 = frame.bbox\n    if c0 > fc1:\n        return \"right\"\n    if c1 < fc0:\n        return \"left\"\n    if r0 > fr1:\n        return \"bottom\"\n    if r1 < fr0:\n        return \"top\"\n\n    dr = float(dot.center[0] - (fr0 + fr1) / 2)\n    dc = float(dot.center[1] - (fc0 + fc1) / 2)\n    if abs(dc) >= abs(dr):\n        return \"right\" if dc > 0 else \"left\"\n    return \"bottom\" if dr > 0 else \"top\"\n\n\ndef _map_frame_axis(frame: _Node, axis: int, value: float) -> int:\n    assert frame.anchor is not None\n    key = \"row\" if axis == 0 else \"col\"\n    candidates = frame.axis_map[key]\n    if not candidates:\n        return int(frame.anchor[axis])\n    return int(min(candidates, key=lambda item: abs(item[0] - value))[1])\n\n\ndef _layout_root(nodes: list[_Node]) -> np.ndarray:\n    assert nodes\n    for node in nodes:\n        _build_layout(node)\n\n    frames = [node for node in nodes if node.is_frame]\n    dots = [node for node in nodes if not node.is_frame]\n    if len(frames) == 1 and dots:\n        frame = frames[0]\n        assert frame.mask is not None\n        placements: dict[_Node, tuple[int, int]] = {frame: (0, 0)}\n        extents = [(0, 0, frame.mask.shape[0], frame.mask.shape[1])]\n\n        for dot in dots:\n            side = _outside_side(dot, frame)\n            if side in {\"right\", \"left\"}:\n                r = _map_frame_axis(frame, 0, float(dot.center[0]))\n                c = frame.mask.shape[1] + 1 if side == \"right\" else -2\n            else:\n                r = frame.mask.shape[0] + 1 if side == \"bottom\" else -2\n                c = _map_frame_axis(frame, 1, float(dot.center[1]))\n            placements[dot] = (int(r), int(c))\n            extents.append((r - 1, c - 1, r + 2, c + 2))\n\n        min_r = min(e[0] for e in extents)\n        min_c = min(e[1] for e in extents)\n        max_r = max(e[2] for e in extents)\n        max_c = max(e[3] for e in extents)\n        out = np.zeros((max_r - min_r, max_c - min_c), dtype=bool)\n        for node, (r, c) in placements.items():\n            rr = r - min_r\n            cc = c - min_c\n            if node is frame:\n                out[rr : rr + frame.mask.shape[0], cc : cc + frame.mask.shape[1]] |= frame.mask\n            else:\n                out[rr, cc] = True\n        return out\n\n    mask, _placements, _axis_map = _layout_group(nodes)\n    return mask\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert a rough nested line drawing into a clean canonical frame-and-dot diagram.\n\n    Input structure:\n    - The grid has one background color and one foreground color.\n    - Foreground 4-connected objects are rough closed frames or small filled blobs.\n    - Frames may contain other frames/blobs; blobs outside a frame remain outside it.\n\n    Rule:\n    - Detect the containment tree of foreground objects using holes of each frame object.\n    - Replace every blob with one foreground pixel.\n    - Replace every frame with a rectangular border padded two cells around its direct children.\n    - Place siblings by their original row/column overlap and order, with one empty cell between canonical objects.\n\n    Key insight: The exact wobbly geometry is irrelevant; only enclosure plus relative sibling positions define the output.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    fg_colors = sorted(set(map(int, g.flatten())) - {bg})\n    assert len(fg_colors) == 1\n    fg = int(fg_colors[0])\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg], return_format=\"dict\")\n    assert comps\n\n    nodes: list[_Node] = []\n    holes: list[list[np.ndarray]] = []\n    for comp in comps:\n        coords = np.asarray(comp[\"coords\"], dtype=int)\n        node = _Node(\n            coords=coords,\n            bbox=tuple(map(int, comp[\"bbox\"])),\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/d968ffd4.py\nsed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\nsed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/d968ffd4.py\nsed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\nsed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _is_solid_rect(g: np.ndarray, comp: dict) -> bool:\n    r0, c0, r1, c1 = comp[\"bbox\"]\n    h = r1 - r0 + 1\n    w = c1 - c0 + 1\n    return comp[\"area\"] == h * w and np.all(g[r0 : r1 + 1, c0 : c1 + 1] == comp[\"color\"])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Extend each of two aligned rectangular marker objects toward the other, filling half of the gap across the full perpendicular span.\n\n    Input structure\n    - A dominant background contains exactly two solid, same-sized monochromatic rectangles.\n    - The rectangles share either the same row span or the same column span, with a background gap between their facing edges.\n\n    Rule\n    - If the rectangles are side-by-side, color the left half of the inter-object gap across every row with the left object's color, and the right half with the right object's color.\n    - If one rectangle is above the other, color the upper half of the gap across every column with the upper object's color, and the lower half with the lower object's color.\n    - When the gap length is odd, leave the center row/column as background.\n\n    Key insight\n    - The marker objects are endpoints of an axial corridor; their own size identifies the facing edge, while the filled corridor spans the whole grid perpendicular to that axis.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(comps) == 2\n    assert all(_is_solid_rect(g, comp) for comp in comps)\n\n    a, b = comps\n    ar0, ac0, ar1, ac1 = a[\"bbox\"]\n    br0, bc0, br1, bc1 = b[\"bbox\"]\n    assert (ar1 - ar0, ac1 - ac0) == (br1 - br0, bc1 - bc0)\n\n    same_rows = (ar0, ar1) == (br0, br1)\n    same_cols = (ac0, ac1) == (bc0, bc1)\n    assert same_rows != same_cols\n\n    out = g.copy()\n    if same_rows:\n        left, right = sorted(comps, key=lambda comp: comp[\"bbox\"][1])\n        _lr0, _lc0, _lr1, lc1 = left[\"bbox\"]\n        _rr0, rc0, _rr1, _rc1 = right[\"bbox\"]\n        gap = rc0 - lc1 - 1\n        assert gap >= 1\n        span = gap // 2\n        out[:, lc1 + 1 : lc1 + 1 + span] = left[\"color\"]\n        out[:, rc0 - span : rc0] = right[\"color\"]\n    else:\n        top, bottom = sorted(comps, key=lambda comp: comp[\"bbox\"][0])\n        _tr0, _tc0, tr1, _tc1 = top[\"bbox\"]\n        br0, _bc0, _br1, _bc1 = bottom[\"bbox\"]\n        gap = br0 - tr1 - 1\n        assert gap >= 1\n        span = gap // 2\n        out[tr1 + 1 : tr1 + 1 + span, :] = top[\"color\"]\n        out[br0 - span : br0, :] = bottom[\"color\"]\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Layout ranges and bounds.\nALIGNMENTS = (\"H\", \"V\")\nRECT_PERP_BOUNDS = (1, 4)\nRECT_AXIAL_VALUES = range(1, 3)\nGAP_VALUES = range(6, 17)\nAXIAL_BOUNDS = (14, 22)\nMARGIN = 1\nPALETTE = tuple(range(10))\nMAX_GENERATION_ATTEMPTS = 300\nVALID_AXIAL_GAP_PAIRS = tuple(\n    (rect_axial, gap)\n    for rect_axial in RECT_AXIAL_VALUES\n    for gap in GAP_VALUES\n    if AXIAL_BOUNDS[0] <= 2 * rect_axial + gap + 2 * MARGIN <= AXIAL_BOUNDS[1]\n)\n\n\ndef _choose_layout() -> tuple[str, int, int, int]:\n    alignment = random.choice(ALIGNMENTS)\n    rect_perp = random.randint(*RECT_PERP_BOUNDS)\n    rect_axial, gap = random.choice(VALID_AXIAL_GAP_PAIRS)\n    return alignment, rect_perp, rect_axial, gap\n\n\ndef _choose_colors() -> tuple[int, int, int]:\n    bg = random.choice(PALETTE)\n    color_a, color_b = random.sample([color for color in PALETTE if color != bg], 2)\n    return bg, color_a, color_b\n\n\ndef _render_horizontal(rect_perp: int, rect_axial: int, gap: int, bg: int, color_a: int, color_b: int) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Build the horizontal input/output pair; vertical cases are its transpose.\"\"\"\n    perp = rect_perp + 2 * MARGIN\n    axial = 2 * rect_axial + gap + 2 * MARGIN\n    left_c0 = MARGIN\n    left_c1 = left_c0 + rect_axial - 1\n    right_c1 = axial - MARGIN - 1\n    right_c0 = right_c1 - rect_axial + 1\n    row0 = MARGIN\n    row1 = row0 + rect_perp - 1\n\n    out = np.full((perp, axial), bg, dtype=int)\n    out[row0 : row1 + 1, left_c0 : left_c1 + 1] = color_a\n    out[row0 : row1 + 1, right_c0 : right_c1 + 1] = color_b\n\n    span = gap // 2\n    out[:, left_c1 + 1 : left_c1 + 1 + span] = color_a\n    out[:, right_c0 - span : right_c0] = color_b\n\n    inp = out.copy()\n    inp[:, left_c1 + 1 : right_c0] = bg\n    return inp, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    alignment, rect_perp, rect_axial, gap = _choose_layout()\n    bg, color_a, color_b = _choose_colors()\n    inp, out = _render_horizontal(rect_perp, rect_axial, gap, bg, color_a, color_b)\n    if alignment == \"V\":\n        inp = inp.T.copy()\n        out = out.T.copy()\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid d968ffd4 input\")\nimport numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):\n        b = int(b)\n        f = int(f)\n        if b == bg:\n            continue\n        mapping[b] = f\n\n    return mapping, pal_mask\n\n\ndef _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:\n    \"\"\"\n    Find background regions (excluding the palette area) that do NOT touch the grid boundary,\n    and fill each region based on the most common adjacent border color (mapped via palette).\n    \"\"\"\n    h, w = out.shape\n    bg_mask = (out == bg) & (~pal_mask)\n    comps = components_mask(bg_mask, connectivity=4)\n    for pts in comps:\n        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n        if touches_boundary:\n            continue\n\n        adj_counts: dict[int, int] = {}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < h and 0 <= cc < w:\n                    if pal_mask[rr, cc]:\n                        continue\n                    v = int(out[rr, cc])\n                    if v == bg:\n                        continue\n                    adj_counts[v] = adj_counts.get(v, 0) + 1\n        if not adj_counts:\n            continue\n\n        # Prefer an adjacent color that exists in the mapping; pick the most frequent border.\n        border = None\n        best = -1\n        for col, cnt in adj_counts.items():\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, is_contiguous, object_interior\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n\n    Input structure:\n    - The grid has a dominant background color.\n    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n\n    Rule:\n    - Keep the input pixels unchanged.\n    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n\n    Key insight:\n    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    out = g.copy()\n    h, w = g.shape\n\n    markers: dict[int, int] = {}\n    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n            continue\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n        source = int(sub[0, 0])\n        halo = int(sub[0, 1])\n        assert source != halo, \"legend source and halo colors must differ\"\n        assert source not in markers, \"each source color must have exactly one legend marker\"\n\n        markers[source] = halo\n        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n\n    assert markers, \"expected at least one left-edge legend marker\"\n\n    for source, halo in markers.items():\n        objects = []\n        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n            if cells <= marker_source_cells[source]:\n                continue\n            objects.append(comp)\n        assert objects, \"each legend source color must label at least one non-marker object\"\n\n        for obj in objects:\n            r0, c0, r1, c1 = obj[\"bbox\"]\n            pr0 = max(0, int(r0) - 1)\n            pc0 = max(0, int(c0) - 1)\n            pr1 = min(h - 1, int(r1) + 1)\n            pc1 = min(w - 1, int(c1) + 1)\n\n            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n            coords = obj[\"coords\"]\n            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n            enclosed = object_interior(patch, background=bg)\n            fill_mask = (patch == bg) & ~enclosed\n\n            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n            target[fill_mask] = halo\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and color palette.\nBACKGROUND = 0\nGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\nAVAILABLE_COLORS = tuple(range(1, 10))\n\n# Legend layout.\nLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\nLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n\n# Sprite geometry and acceptance.\nSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\nSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\nSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\nSPRITE_RETRIES = 300\n\n# Object counts and placement.\nINSTANCE_MIN, INSTANCE_MAX = 1, 3\nOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\nEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\nPLACEMENT_RETRIES = 200\n\n# Whole-sample retry budget.\nGENERATION_RETRIES = 300\n\n\ndef _make_sprite(color):\n    \"\"\"Construct one LR-symmetric 4-connected sprite matching the configured area/hole bounds.\"\"\"\n    target_area = random.randint(SPRITE_AREA_MIN, SPRITE_AREA_MAX)\n    for _ in range(SPRITE_RETRIES):\n        fill_p = target_area / (SPRITE_SIZE * SPRITE_SIZE) + random.uniform(-SPRITE_FILL_JITTER, SPRITE_FILL_JITTER)\n        sprite = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=int)\n        for r in range(SPRITE_SIZE):\n            for c in range(SPRITE_MIRROR_COLS):\n                if random.random() < fill_p:\n                    sprite[r, c] = color\n                    sprite[r, SPRITE_SIZE - 1 - c] = color\n        area = int(np.count_nonzero(sprite))\n        if area != target_area:\n            continue\n        if not is_contiguous(sprite, background=BACKGROUND, connectivity=4):\n            continue\n        if not (np.any(sprite[0] != BACKGROUND) and np.any(sprite[-1] != BACKGROUND) and\n                np.any(sprite[:, 0] != BACKGROUND) and np.any(sprite[:, -1] != BACKGROUND)):\n            continue\n        padded = np.zeros((SPRITE_SIZE + 2, SPRITE_SIZE + 2), dtype=int)\n        padded[1:-1, 1:-1] = sprite\n        interior = object_interior(padded, background=BACKGROUND)\n        holes = int(np.sum(interior & (padded == BACKGROUND)))\n        if holes > MAX_INTERIOR_HOLES:\n            continue\n        return sprite\n    return None\n\n\ndef _boxes_overlap(a, b):\n    return a[0] <= b[2] and a[2] >= b[0] and a[1] <= b[3] and a[3] >= b[1]\n\n\ndef _draw_legend(grid, src1, halo1, src2, halo2):\n    lower_top = grid.shape[0] - LEGEND_MARKER_SIZE\n    upper_top = lower_top - LEGEND_VERTICAL_GAP - LEGEND_MARKER_SIZE\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src1\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo1\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src2\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo2\n    return (upper_top, LEGEND_SOURCE_COL, grid.shape[0] - 1, LEGEND_HALO_COL)\n\n\ndef _visible_window(sprite, size, r0, c0):\n    \"\"\"Return the visible grid bbox and matching sprite slice for a possibly clipped sprite.\"\"\"\n    vr0, vc0 = max(0, r0), max(0, c0)\n    vr1 = min(size - 1, r0 + SPRITE_SIZE - 1)\n    vc1 = min(size - 1, c0 + SPRITE_SIZE - 1)\n    visible = sprite[vr0 - r0:vr1 - r0 + 1, vc0 - c0:vc1 - c0 + 1]\n    return (vr0, vc0, vr1, vc1), visible\n\n\ndef _padded_bbox(visible_box, size):\n    vr0, vc0, vr1, vc1 = visible_box\n    return (max(0, vr0 - HALO_PADDING), max(0, vc0 - HALO_PADDING),\n            min(size - 1, vr1 + HALO_PADDING), min(size - 1, vc1 + HALO_PADDING))\n\n\ndef _place_objects(size, tasks, legend_box):\n    \"\"\"Choose non-overlapping object origins; returns placement tuples or None on retry exhaustion.\"\"\"\n    placed = []\n    placements = []\n    for sprite, sc, hc in tasks:\n        for _ in range(PLACEMENT_RETRIES):\n            if random.random() < EDGE_CLIP_PROB:\n                r0 = random.randint(-EDGE_CLIP_MARGIN, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n            else:\n                r0 = random.randint(0, size - SPRITE_SIZE)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE)\n            visible_box, visible = _visible_window(sprite, size, r0, c0)\n            if np.count_nonzero(visible) == 0:\n                continue\n\n            pbox = _padded_bbox(visible_box, size)\n            if (pbox[1] < OBJECT_MIN_COL or _boxes_overlap(pbox, legend_box) or\n                    any(_boxes_overlap(pbox, eb) for eb in placed)):\n                continue\n\n            placed.append(pbox)\n            placements.append((sprite, sc, hc, r0, c0))\n            break\n        else:\n            return None\n    return placements\n\n\ndef _render_output(grid, placements):\n    \"\"\"Render the paired output and return the generated input with halo-fill cells removed.\"\"\"\n    size = grid.shape[0]\n    output = grid.copy()\n    halo_mask = np.zeros((size, size), dtype=bool)\n\n    for sprite, sc, hc, r0, c0 in placements:\n        visible_box, visible = _visible_window(sprite, size, r0, c0)\n        vr0, vc0, vr1, vc1 = visible_box\n        output_region = output[vr0:vr1 + 1, vc0:vc1 + 1]\n        output_region[visible != BACKGROUND] = sc\n\n        pr0, pc0, pr1, pc1 = _padded_bbox(visible_box, size)\n        patch = np.zeros((pr1 - pr0 + 1, pc1 - pc0 + 1), dtype=int)\n        patch_region = patch[vr0 - pr0:vr1 - pr0 + 1, vc0 - pc0:vc1 - pc0 + 1]\n        patch_region[visible != BACKGROUND] = sc\n\n        enclosed = object_interior(patch, background=BACKGROUND)\n        fill = (patch == BACKGROUND) & ~enclosed\n        output_region = output[pr0:pr1 + 1, pc0:pc1 + 1]\n        output_region[fill] = hc\n        halo_region = halo_mask[pr0:pr1 + 1, pc0:pc1 + 1]\n        halo_region[fill] = True\n\n    inp = output.copy()\n    inp[halo_mask] = BACKGROUND\n    return inp, output\n\n\ndef _matches_oracle(inp, output):\n    try:\n        return np.array_equal(main(inp), output)\n    except Exception:\n        return False\n\n\ndef _gen_attempt():\n    sz = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    colors = list(AVAILABLE_COLORS)\n    random.shuffle(colors)\n    src1, halo1, src2, halo2 = colors[:4]\n\n    sprite1 = _make_sprite(src1)\n    sprite2 = _make_sprite(src2)\n    if sprite1 is None or sprite2 is None:\n        return None\n","exit_code":0,"status":"completed"}}
