nvariants and the solver oracle.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/db7260a4.py:301:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py:17:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py:18:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py:40:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py:259:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:208:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:209:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:224:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:324:    \"\"\"Check that mask is a single 4-connected simple closed curve with exactly one hole.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:342:    \"\"\"Interleave n_a copies of step_a with n_b copies of step_b, biased toward alternation.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:366:    \"\"\"Extend path with a straight line from its last point to end.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:378:    \"\"\"Extend path by applying a sequence of (dr, dc) deltas.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:387:    \"\"\"Fraction of direction changes along a cyclic path.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:397:    \"\"\"Generate a wobbly simple closed curve mask of size (h, w).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:445:    \"\"\"Generate a small filled blob mask (size 4-11, bbox 2x2 to 4x4).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:472:    \"\"\"Arrange children in a random layout (vertical, horizontal, or diagonal).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:514:    \"\"\"Recursively build masks and place children within frames.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:544:    \"\"\"Flatten tree into list, computing absolute positions.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:555:    \"\"\"Position an outside blob adjacent to the root frame.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:572:    \"\"\"Convert a generator _Obj (with absolute pos) to a solver _Node.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:588:    \"\"\"Compute expected solver output for the generated tree.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:607:    \"\"\"Build a random containment tree (1-2 frames, 1-4 blobs, optional outside blob).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:627:    \"\"\"Render all objects onto a padded grid. Returns None if size constraints fail.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:665:    \"\"\"Single generation attempt: build tree, render input, verify against solver.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:693:def generate_input():\n/home/lixinyu/snap/new/ARC_code/train/78e78cff.py:70:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/78e78cff.py:71:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/78e78cff.py:91:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/78e78cff.py:176:    \"\"\"Return the solver output implied by the generated wall intervals.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/78e78cff.py:266:    \"\"\"Choose side presence and wall boundaries for each non-empty band row.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/78e78cff.py:298:    \"\"\"Assign one or two wall pixels to each selected side boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/78e78cff.py:315:    \"\"\"Paint wall pixels and return row intervals used by the oracle check.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/78e78cff.py:348:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:41:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:42:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:56:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:184:    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:188:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:202:    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:207:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:245:    \"\"\"Grow a meandering 8-connected 1px-wide path of line_col from start.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:296:    \"\"\"Compute offsets around a frame bbox that lie outside it (the halo).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:302:    \"\"\"Try to place a frame loop 8-adjacent to some line pixel.\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:305:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:330:    \"\"\"Place a loop in empty space, not touching any non-bg pixel.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:357:    \"\"\"Place a disconnected line+frame distractor (no seed).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:388:    \"\"\"Return (seed_rc, first_line_rc) for corner_kind in {TL,TR,BL,BR}.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:407:    \"\"\"Distribute attached-loop budget across seeds, guaranteeing >= 1 each.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:508:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:8:    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:15:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:22:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:27:        \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:31:        \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:195:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:197:    \"\"\"\n/home/lixi