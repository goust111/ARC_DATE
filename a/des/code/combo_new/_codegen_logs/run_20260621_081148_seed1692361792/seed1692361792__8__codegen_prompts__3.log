{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nfrom collections import deque\nDIR4=[(1,0),(-1,0),(0,1),(0,-1)]\n\ndef cc(mask):\n    h,w=mask.shape; seen=np.zeros_like(mask,bool); n=0\n    for r in range(h):\n        for c in range(w):\n            if not mask[r,c] or seen[r,c]: continue\n            n+=1; q=deque([(r,c)]); seen[r,c]=1\n            while q:\n                x,y=q.popleft()\n                for dr,dc in DIR4:\n                    xx,yy=x+dr,y+dc\n                    if 0<=xx<h and 0<=yy<w and mask[xx,yy] and not seen[xx,yy]:\n                        seen[xx,yy]=1; q.append((xx,yy))\n    return n\n\ndef fill_from_edges(blocked):\n    h,w=blocked.shape\n    seen=np.zeros_like(blocked,bool)\n    q=deque()\n    for r in range(h):\n        for c in (0,w-1):\n            if not blocked[r,c] and not seen[r,c]: seen[r,c]=1; q.append((r,c))\n    for c in range(w):\n        for r in (0,h-1):\n            if not blocked[r,c] and not seen[r,c]: seen[r,c]=1; q.append((r,c))\n    while q:\n        r,c=q.popleft()\n        for dr,dc in DIR4:\n            rr,cc=r+dr,c+dc\n            if 0<=rr<h and 0<=cc<w and not blocked[rr,cc] and not seen[rr,cc]:\n                seen[rr,cc]=1; q.append((rr,cc))\n    return seen\n\ndef build(h=6,w=7,side='top',depth=2,start=2,width=2):\n    if side in ('top','bottom'):\n        H=h+depth; W=w\n        base_top = depth if side=='top' else 0\n        top=base_top; bottom=base_top+h-1\n        left=0; right=w-1\n    else:\n        H=h; W=w+depth\n        base_left = depth if side=='left' else 0\n        left=base_left; right=base_left+w-1\n        top=0; bottom=h-1\n    m=np.zeros((H,W),bool)\n    def draw_line(r0,c0,r1,c1):\n        dr=0 if r0==r1 else (1 if r1>r0 else -1)\n        dc=0 if c0==c1 else (1 if c1>c0 else -1)\n        r,c=r0,c0\n        while True:\n            m[r,c]=1\n            if (r,c)==(r1,c1): break\n            r+=dr; c+=dc\n    if side=='top':\n        s=left+start; e=s+width\n        draw_line(bottom,left,top,left)\n        draw_line(top,left,top,s)\n        draw_line(top,s,0,s)\n        draw_line(0,s,0,e)\n        draw_line(0,e,top,e)\n        draw_line(top,e,top,right)\n        draw_line(top,right,bottom,right)\n        draw_line(bottom,right,bottom,left)\n    elif side=='bottom':\n        s=left+start; e=s+width\n        draw_line(top,left,bottom,left)\n        draw_line(bottom,left,bottom,s)\n        draw_line(bottom,s,H-1,s)\n        draw_line(H-1,s,H-1,e)\n        draw_line(H-1,e,bottom,e)\n        draw_line(bottom,e,bottom,right)\n        draw_line(bottom,right,top,right)\n        draw_line(top,right,top,left)\n    elif side=='left':\n        s=top+start; e=s+width\n        draw_line(top,right,top,left)\n        draw_line(top,left,s,left)\n        draw_line(s,left,s,0)\n        draw_line(s,0,e,0)\n        draw_line(e,0,e,left)\n        draw_line(e,left,bottom,left)\n        draw_line(bottom,left,bottom,right)\n        draw_line(bottom,right,top,right)\n    else:\n        s=top+start; e=s+width\n        draw_line(top,left,top,right)\n        draw_line(top,right,s,right)\n        draw_line(s,right,s,W-1)\n        draw_line(s,W-1,e,W-1)\n        draw_line(e,W-1,e,right)\n        draw_line(e,right,bottom,right)\n        draw_line(bottom,right,bottom,left)\n        draw_line(bottom,left,top,left)\n    return m\n\nfor side in ['top','bottom','left','right']:\n    m=build(side=side)\n    ext=fill_from_edges(m)\n    interior=(~ext)&(~m)\n    print(side, m.shape, cc(m), interior.sum())\n    assert cc(m)==1\n    assert interior.sum()>0\nprint('ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
