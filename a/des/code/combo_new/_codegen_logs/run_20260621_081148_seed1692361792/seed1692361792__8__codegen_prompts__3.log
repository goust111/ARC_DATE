{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nfrom collections import deque\n\nDIR4=[(1,0),(-1,0),(0,1),(0,-1)]\n\ndef boundary(mask):\n    h,w=mask.shape\n    out=np.zeros_like(mask)\n    for r in range(h):\n        for c in range(w):\n            if not mask[r,c]:\n                continue\n            if r==0 or c==0 or r==h-1 or c==w-1:\n                out[r,c]=1; continue\n            for dr,dc in DIR4:\n                rr,cc=r+dr,c+dc\n                if not mask[rr,cc]:\n                    out[r,c]=1; break\n    return out\n\ndef cc(mask):\n    h,w=mask.shape\n    seen=np.zeros_like(mask,bool)\n    n=0\n    for r in range(h):\n        for c in range(w):\n            if not mask[r,c] or seen[r,c]: continue\n            n+=1\n            q=deque([(r,c)]); seen[r,c]=1\n            while q:\n                x,y=q.popleft()\n                for dr,dc in DIR4:\n                    xx,yy=x+dr,y+dc\n                    if 0<=xx<h and 0<=yy<w and mask[xx,yy] and not seen[xx,yy]:\n                        seen[xx,yy]=1; q.append((xx,yy))\n    return n\n\ndef make(base_h=7,base_w=8,side='top',depth=3,length=4,start=2):\n    extra=depth-1\n    if side in ('top','bottom'):\n        mask=np.zeros((base_h+extra, base_w), bool)\n        br=extra if side=='top' else 0\n        mask[br:br+base_h,:]=1\n        if side=='top':\n            mask[:depth,start:start+length]=1\n        else:\n            mask[-depth:,start:start+length]=1\n    else:\n        mask=np.zeros((base_h, base_w+extra), bool)\n        bc=extra if side=='left' else 0\n        mask[:,bc:bc+base_w]=1\n        if side=='left':\n            mask[start:start+length,:depth]=1\n        else:\n            mask[start:start+length,-depth:]=1\n    b=boundary(mask)\n    interior=mask & ~b\n    return mask,b,interior\n\nfor side in ['top','bottom','left','right']:\n    m,b,i=make(side=side)\n    print(side,m.shape,cc(b),i.sum())\n    assert cc(b)==1\n    assert i.sum()>0\nprint('ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
