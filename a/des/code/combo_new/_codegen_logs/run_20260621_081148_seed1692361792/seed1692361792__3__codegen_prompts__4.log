{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg\nimport random\n\n\ndef _assert_output_footprints_disjoint(dims: list[tuple[int, int]]) -> None:\n    occupied: set[tuple[int, int]] = set()\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, cc) for r in range(short) for cc in range(c, c + long)}\n        assert not (occupied & cells), \"normalized output rectangles must not overlap\"\n        occupied |= cells\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, cc)\n            for r in range(10 - long, 10)\n            for cc in range(c, c + short)\n        }\n        assert not (occupied & cells), \"normalized output rectangles must not overlap\"\n        occupied |= cells\n        c += short + 1\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.\n\n    Input structure\n    The grid has one background color and one foreground color; the foreground forms\n    separate solid rectangles, ordered from left to right.\n\n    Rule\n    Build a 10-row background canvas whose width is the packed width of the wide\n    versions of the rectangles. For each source rectangle, paint a top-aligned\n    rectangle of shape min(h,w) by max(h,w), with one background column between\n    consecutive rectangles. Then, starting again from the left edge, paint a\n    bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,\n    again separated by one background column.\n\n    Key insight\n    The input rectangles are not copied in their original orientations; each object\n    contributes one horizontal-facing and one vertical-facing normalized rectangle,\n    preserving left-to-right object order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n    fg = fg_colors[0]\n\n    components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n    assert components\n    components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n\n    dims: list[tuple[int, int]] = []\n    for obj in components:\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert obj[\"area\"] == h * w\n        dims.append((h, w))\n\n    out_h = 10\n    out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n    _assert_output_footprints_disjoint(dims)\n    out = np.full((out_h, out_w), bg, dtype=int)\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[:short, c : c + long] = fg\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[out_h - long : out_h, c : c + short] = fg\n        c += short + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\n# Rectangle counts and dimensions.\nRECT_COUNT_MIN = 4\nRECT_COUNT_MAX = 6\nSHORT_SIDE_MIN = 1\nSHORT_SIDE_MAX = 3\nSIDE_SUM_MAX = 10\nLONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN\n\n# Canvas and packing constraints.\nARC_GRID_MAX = 30\nOUTPUT_HEIGHT = 10\nGAP_WIDTH = 1\n\n# Retry policy.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_d749d46f_output_footprints_disjoint(dims):\n    occupied = set()\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, c) for r in range(short) for c in range(col, col + long)}\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += long + GAP_WIDTH\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, c)\n            for r in range(OUTPUT_HEIGHT - long, OUTPUT_HEIGHT)\n            for c in range(col, col + short)\n        }\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += short + GAP_WIDTH\n\n    return True\n\n\ndef _sample_dimensions(n_rects):\n    \"\"\"Sample source rectangle dimensions under the output-width budget.\"\"\"\n    dims = []\n    remaining_budget = ARC_GRID_MAX - GAP_WIDTH * (n_rects - 1)\n\n    for i in range(n_rects):\n        rects_left = n_rects - i\n        min_needed = rects_left - 1\n        max_for_this = min(remaining_budget - min_needed, LONG_SIDE_MAX)\n        if max_for_this < SHORT_SIDE_MIN:\n            return None\n\n        short = random.randint(SHORT_SIDE_MIN, SHORT_SIDE_MAX)\n        max_long = min(SIDE_SUM_MAX - short, max_for_this)\n        if max_long < short:\n            short = SHORT_SIDE_MIN\n            max_long = min(LONG_SIDE_MAX, max_for_this)\n            if max_long < SHORT_SIDE_MIN:\n                return None\n\n        long = random.randint(short, max_long)\n        remaining_budget -= long\n\n        if random.random() < 0.5:\n            h, w = long, short\n        else:\n            h, w = short, long\n        dims.append((h, w))\n\n    return dims\n\n\ndef _input_shape(dims):\n    return max(h for h, _ in dims), sum(w for _, w in dims) + GAP_WIDTH * (len(dims) - 1)\n\n\ndef _background_is_dominant(dims, inp_h, inp_w):\n    fg_pixels = sum(h * w for h, w in dims)\n    total_pixels = inp_h * inp_w\n    bg_pixels = total_pixels - fg_pixels\n    return bg_pixels > fg_pixels\n\n\ndef _build_input_grid(dims, bg, fg, inp_h, inp_w):\n    grid = np.full((inp_h, inp_w), bg, dtype=int)\n    col = 0\n    for h, w in dims:\n        grid[:h, col:col + w] = fg\n        col += w + GAP_WIDTH\n    return grid\n\n\ndef _passes_solver_oracle(grid):\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return out.shape[0] == OUTPUT_HEIGHT\n\n\ndef _gen_attempt():\n    \"\"\"Generate one valid input grid, or None when sampled dimensions fail constraints.\"\"\"\n    bg, fg = random.sample(COLOR_VALUES, 2)\n    n_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)\n    dims = _sample_dimensions(n_rects)\n    if dims is None:\n        return None\n\n    inp_h, inp_w = _input_shape(dims)\n    if inp_w > ARC_GRID_MAX:\n        return None\n    if not _gen_d749d46f_output_footprints_disjoint(dims):\n        return None\n    if inp_h > ARC_GRID_MAX or inp_h < 1:\n        return None\n    if not _background_is_dominant(dims, inp_h, inp_w):\n        return None\n\n    grid = _build_input_grid(dims, bg, fg, inp_h, inp_w)\n    if not _passes_solver_oracle(grid):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/b0039139.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/b0039139.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox, components_mask, crop_bbox, random_sprite\nimport random\n\n\ndef _split_sections(grid: np.ndarray) -> tuple[str, list[np.ndarray]]:\n    h, w = grid.shape\n    sep = 1\n\n    sep_rows = [r for r in range(h) if bool(np.all(grid[r, :] == sep))]\n    if sep_rows:\n        cuts = [-1] + sep_rows + [h]\n        return \"vertical\", [grid[a + 1 : b, :] for a, b in zip(cuts, cuts[1:]) if b > a + 1]\n\n    sep_cols = [c for c in range(w) if bool(np.all(grid[:, c] == sep))]\n    cuts = [-1] + sep_cols + [w]\n    return \"horizontal\", [grid[:, a + 1 : b] for a, b in zip(cuts, cuts[1:]) if b > a + 1]\n\n\ndef _solid_color(block: np.ndarray) -> int:\n    vals, counts = np.unique(block, return_counts=True)\n    return int(vals[int(np.argmax(counts))])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor a cropped template and repeat it according to a component-count stencil.\n\n    Input structure:\n    - Solid blue (1) separator rows or columns split the grid into four sections.\n    - Section 1 is a black-background shape template; section 2 is a component-count stencil.\n    - Sections 3 and 4 are solid color swatches for output foreground and background.\n\n    Rule:\n    - Crop section 1 to the bbox of its non-black pixels and recolor it with the two swatches.\n    - Count 4-connected non-black components in section 2.\n    - Repeat the recolored crop that many times, inserting one background-colored row/column between copies.\n\n    Key insight: The second section encodes only the repeat count; the output orientation\n    is inherited from whether the input separators are columns or rows.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    orientation, sections = _split_sections(g)\n    template, repetition_pattern, foreground_block, background_block = sections[:4]\n\n    template_mask = template != 0\n    template_bbox = bbox(template_mask)\n    if template_bbox is None:\n        return np.empty((0, 0), dtype=int)\n\n    foreground = _solid_color(foreground_block)\n    background = _solid_color(background_block)\n    tile_mask = crop_bbox(template_mask, template_bbox)\n    tile = np.where(tile_mask, foreground, background).astype(int)\n\n    n_repeats = len(components_mask(repetition_pattern != 0, connectivity=4))\n    if n_repeats <= 1:\n        return tile\n\n    if orientation == \"horizontal\":\n        sep = np.full((tile.shape[0], 1), background, dtype=int)\n        pieces = [tile] + [x for _ in range(n_repeats - 1) for x in (sep, tile)]\n        return np.hstack(pieces)\n\n    sep = np.full((1, tile.shape[1]), background, dtype=int)\n    pieces = [tile] + [x for _ in range(n_repeats - 1) for x in (sep, tile)]\n    return np.vstack(pieces)\n\n# --------------- generator (c) ---------------\n\n# --- CFG: tunable generation parameters ---\nREPEAT_COUNT_RANGE = (2, 6)          # blob count N (= tile repetitions)\nCROP_SIZE_RANGE = (2, 5)             # crop height/width bounds\nDENSITY_RANGE = (0.55, 0.85)         # fill ratio of shape bounding box\nCOLOR_POOL = list(range(2, 10))      # fg/bg color choices (2-9 inclusive)\nTEMPLATE_COLOR = 4                   # shape drawn in yellow inside template\nSTENCIL_COLOR = 3                    # blob color in stencil section\nSEPARATOR_COLOR = 1                  # blue separator rows/cols\nSWATCH_DIM_RANGE = (3, 8)           # varying-axis size for color swatches\nSTENCIL_VARYING_EXTRA = 4            # max extra cells beyond minimum stencil size\nBLOB_PLACE_RETRIES = 200             # per-blob placement attempts in stencil\nGEN_RETRIES = 300                    # outer generate_input retry limit\n\n\ndef _tile_repeat(tile: np.ndarray, n: int, bg_color: int, horizontal: bool) -> np.ndarray:\n    \"\"\"Repeat `tile` n times along the given axis with 1-pixel bg_color separator.\"\"\"\n    if horizontal:\n        sep = np.full((tile.shape[0], 1), bg_color, dtype=int)\n        pieces = [tile] + [x for _ in range(n - 1) for x in (sep, tile)]\n        return np.hstack(pieces)\n    sep = np.full((1, tile.shape[1]), bg_color, dtype=int)\n    pieces = [tile] + [x for _ in range(n - 1) for x in (sep, tile)]\n    return np.vstack(pieces)\n\n\ndef _make_swatch(shared_dim: int, color: int, horizontal: bool) -> np.ndarray:\n    \"\"\"Create a solid color swatch. shared_dim is the fixed axis; varying axis is random.\"\"\"\n    varying = random.randint(*SWATCH_DIM_RANGE)\n    if horizontal:\n        return np.full((shared_dim, varying), color, dtype=int)\n    return np.full((varying, shared_dim), color, dtype=int)\n\n\ndef _join_sections(sections: list[np.ndarray], shared_dim: int, horizontal: bool) -> np.ndarray:\n    \"\"\"Join sections with single-pixel separator lines of SEPARATOR_COLOR.\"\"\"\n    if horizontal:\n        sep = np.full((shared_dim, 1), SEPARATOR_COLOR, dtype=int)\n        parts = [sections[0]]\n        for s in sections[1:]:\n            parts.extend([sep, s])\n        return np.hstack(parts)\n    sep = np.full((1, shared_dim), SEPARATOR_COLOR, dtype=int)\n    parts = [sections[0]]\n    for s in sections[1:]:\n        parts.extend([sep, s])\n    return np.vstack(parts)\n\n\ndef _build_stencil(n_blobs: int, shared_dim: int, horizontal: bool) -> np.ndarray | None:\n    \"\"\"Place n_blobs 2-cell blobs (1x2 or 2x1) of STENCIL_COLOR on a black grid.\n    Blobs are separated by >=1 cell of black in all directions.\"\"\"\n    min_varying = max(4, n_blobs * 2 + 2)\n    varying_dim = random.randint(min_varying, min_varying + STENCIL_VARYING_EXTRA)\n\n    h, w = (shared_dim, varying_dim) if horizontal else (varying_dim, shared_dim)\n    grid = np.zeros((h, w), dtype=int)\n\n    placed = 0\n    for _ in range(BLOB_PLACE_RETRIES):\n        if placed >= n_blobs:\n            break\n        br, bc = (1, 2) if random.choice([True, False]) else (2, 1)\n\n        if h - 1 - br < 1 or w - 1 - bc < 1:\n            continue\n        r = random.randint(1, h - 1 - br)\n        c = random.randint(1, w - 1 - bc)\n\n        # Check blob cells + 1-cell neighborhood are all black\n        r0, c0 = max(0, r - 1), max(0, c - 1)\n        r1, c1 = min(h, r + br + 1), min(w, c + bc + 1)\n        if np.any(grid[r0:r1, c0:c1] != 0):\n            continue\n\n        grid[r:r + br, c:c + bc] = STENCIL_COLOR\n        placed += 1\n\n    return grid if placed == n_blobs else None\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    horizontal = random.choice([True, False])\n    N = random.randint(*REPEAT_COUNT_RANGE)\n\n    # Generate connected tile shape\n    crop_h = random.randint(*CROP_SIZE_RANGE)\n    crop_w = random.randint(*CROP_SIZE_RANGE)\n    density = random.uniform(*DENSITY_RANGE)\n    shape = random_sprite(crop_h, crop_w, density=density, color_palette=[TEMPLATE_COLOR],\n                          connectivity=4, symmetry=\"not_symmetric\")\n\n    # Pick distinct fg/bg colors\n    fg_color, bg_color = random.sample(COLOR_POOL, 2)\n\n    # Build output\n    tile = np.where(shape != 0, fg_color, bg_color).astype(int)\n    output = _tile_repeat(tile, N, bg_color, horizontal)\n\n    # Build template: shape in (crop_h+2) x (crop_w+2) black border\n    template = np.zeros((crop_h + 2, crop_w + 2), dtype=int)\n    template[1:crop_h + 1, 1:crop_w + 1] = shape\n\n    # Build stencil\n    shared_dim = (crop_h + 2) if horizontal else (crop_w + 2)\n    stencil = _build_stencil(N, shared_dim, horizontal)\n    if stencil is None:\n        return None\n\n    # Assemble: template | stencil | fg_swatch | bg_swatch\n    fg_swatch = _make_swatch(shared_dim, fg_color, horizontal)\n    bg_swatch = _make_swatch(shared_dim, bg_color, horizontal)\n    inp = _join_sections([template, stencil, fg_swatch, bg_swatch], shared_dim, horizontal)\n\n    # Oracle check\n    try:\n        if np.array_equal(main(inp), output):\n            return inp\n    except Exception:\n        pass\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after %d attempts\" % GEN_RETRIES)\n","exit_code":0,"status":"completed"}}
