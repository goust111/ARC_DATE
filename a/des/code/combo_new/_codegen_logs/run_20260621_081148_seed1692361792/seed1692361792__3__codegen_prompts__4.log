{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/e87109e9.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask\nimport random\n\n_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n\n\ndef _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:\n    \"\"\"\n    Legend is a top region with a background color (typically 5) and 4 vertical bars.\n    Each bar's horizontal position inside its cell encodes turn direction:\n      - bar on left  -> 'L' (turn counterclockwise)\n      - bar on right -> 'R' (turn clockwise)\n    \"\"\"\n    legend = grid[:legend_h, :]\n    assert legend.size, \"legend must be non-empty\"\n    _vals, _cnts = np.unique(legend, return_counts=True); bg = int(_vals[_cnts.argmax()])\n\n    # Separator columns are solid bg throughout the legend.\n    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]\n    assert len(sep_cols) >= 2, \"legend separator columns must exist\"\n\n    turn: dict[int, str] = {}\n    for a, b in zip(sep_cols, sep_cols[1:], strict=False):\n        if b - a <= 2:\n            continue\n        interior = legend[1 : legend_h - 1, a + 1 : b]\n        colors = set(map(int, np.unique(interior)))\n        colors.discard(bg)\n        colors.discard(0)\n        assert len(colors) == 1, \"each legend cell must encode exactly one color\"\n        col = int(next(iter(colors)))\n        xs = np.where(interior == col)[1]\n        x = int(xs[0])  # relative to interior\n        # Decide left/right by proximity to borders (interior is typically 4 cells wide).\n        turn[col] = \"L\" if x <= (interior.shape[1] - 1) // 2 else \"R\"\n    assert len(turn) == 4, \"legend must encode four turn colors\"\n    return turn\n\n\ndef _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:\n    \"\"\"Return (r0,c0,size) for a solid square teal component.\"\"\"\n    candidates: list[tuple[int, int, int]] = []\n    for cells in components_mask(g == teal, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(cells)\n        hh = r1 - r0 + 1\n        ww = c1 - c0 + 1\n        if hh != ww:\n            continue\n        size = hh\n        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:\n            continue\n        candidates.append((int(r0), int(c0), int(size)))\n    assert len(candidates) == 1, \"main grid must contain exactly one solid teal square\"\n    return candidates[0]\n\n\ndef _rot_ccw(d: int) -> int:\n    return (d - 1) % 4\n\n\ndef _rot_cw(d: int) -> int:\n    return (d + 1) % 4\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Emit four teal beams from a square, turning at colored obstacles per a legend.\n\n    Input structure:\n    - Top band: grey (5) legend with colored vertical bars in cells; bar position (left or right) encodes turn direction.\n    - Below: main grid with bg, a solid teal (8) square, and colored obstacle blocks.\n\n    Rule:\n    - Remove the legend from the output.\n    - From the teal square, shoot a beam in each cardinal direction (as a sliding copy of the square).\n    - Each beam paints teal over bg cells as it moves.\n    - On hitting an obstacle of color C, consult the legend: bar on left → turn counterclockwise, bar on right → turn clockwise. Continue in the new direction.\n    - Beams stop at grid edges.\n\n    Key insight: The legend's bar position (left vs right within its cell) is the encoding for turn direction at each obstacle color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n\n    # Legend height: crop everything above and including the last row containing legend bg (usually 5).\n    # In this dataset, the legend uses a dedicated color (5) that doesn't appear below.\n    legend_bg = 5\n    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]\n    assert rows_with_legend.size, \"legend rows must be present\"\n    legend_h = int(rows_with_legend.max() + 1)\n    assert np.array_equal(rows_with_legend, np.arange(legend_h)), \"legend color must be confined to the top band\"\n\n    legend_turn = _parse_legend(g, legend_h)\n\n    base = g[legend_h:, :].copy()\n    assert base.size, \"main grid must remain after legend crop\"\n\n    _vals, _cnts = np.unique(base, return_counts=True); bg = int(_vals[_cnts.argmax()])\n    teal = 8\n    src = _find_teal_square(base, teal=teal)\n    sr, sc, sz = src\n\n    out = base.copy()\n\n    def in_bounds(r: int, c: int) -> bool:\n        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]\n\n    def paint_block(r: int, c: int) -> None:\n        blk = out[r : r + sz, c : c + sz]\n        blk[blk == bg] = teal\n        out[r : r + sz, c : c + sz] = blk\n\n    def obstacle_color_at_next(nr: int, nc: int) -> int | None:\n        blk = out[nr : nr + sz, nc : nc + sz]\n        cols = set(map(int, np.unique(blk)))\n        cols.discard(bg)\n        cols.discard(teal)\n        if not cols:\n            return None\n        assert len(cols) == 1, \"beam footprint must not hit mixed obstacle colors\"\n        return int(next(iter(cols)))\n\n    # Four beams, each is a moving copy of the teal square.\n    for d0 in range(4):\n        r, c, d = sr, sc, d0\n        seen: set[tuple[int, int, int]] = set()\n        while True:\n            state = (r, c, d)\n            assert state not in seen, \"beam path must not cycle\"\n            seen.add(state)\n\n            dr, dc = _DIRS[d]\n            nr, nc = r + dr, c + dc\n            if not in_bounds(nr, nc):\n                break\n\n            oc = obstacle_color_at_next(nr, nc)\n            if oc is None:\n                r, c = nr, nc\n                paint_block(r, c)\n                continue\n\n            assert oc in legend_turn, \"obstacle color must be encoded by legend\"\n            turn = legend_turn[oc]\n            d = _rot_ccw(d) if turn == \"L\" else _rot_cw(d)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# ── Configuration ──────────────────────────────────────────────────────\n_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n_N, _E, _S, _W = range(4)\n\n# Color palettes\nLEGEND_COLOR_POOL = [1, 2, 3, 4, 6]          # colors eligible for obstacles / legend\nBG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]        # colors eligible for main-grid background\nLEGEND_BG = 5                                  # legend background color\nTEAL = 8                                       # beam / square color\n\n# Canvas dimensions\nGRID_H_RANGE = (19, 24)                        # main-grid height (rows)\nGRID_W = 24                                    # main-grid width (fixed)\nLEGEND_H = 6                                   # legend height (rows)\nLEGEND_CELL_STARTS = [1, 7, 13, 19]           # col offsets for legend cells\n\n# Teal square\nTEAL_SZ2_PROB = 0.75                           # P(size=2); else size=3\nSQUARE_EDGE_GAP = 5                            # min gap from square to grid edges\n\n# Obstacles\nOBS_COUNT_4_PROB = 0.65                        # P(4 obstacles); else 3\nOBS_THICKNESS_RANGE = (2, 4)                   # obstacle shorter-dimension bounds\nOBS_SINGLE_MARGIN = 6                          # margin subtracted when only one side present\nOBS_BOTH_GAP = 2                               # gap subtracted when both sides present\n\n# Span selection\nSPAN_MIN_MULT = 3                              # min obstacle length = SPAN_MIN_MULT * sz\nSPAN_MAX_MULT = 14                             # max obstacle length = SPAN_MAX_MULT * sz\nSPAN_COMPACT_PROB = 0.4                        # P(bias toward compact spans)\n\n# Retry budget\nMAX_RETRIES = 300\n\n\ndef _rot(d: int, turn: str) -> int:\n    \"\"\"Rotate direction d by turn ('L' = CCW, 'R' = CW).\"\"\"\n    return (d - 1) % 4 if turn == \"L\" else (d + 1) % 4\n\n\n# ── Obstacle span selection ───────────────────────────────────────────\n\ndef _choose_span(\n    axis_len: int,\n    required: list[tuple[int, int]],\n    excluded: list[tuple[int, int]],\n    min_len: int,\n    max_len: int,\n) -> tuple[int, int] | None:\n    \"\"\"Pick a (start, end) span covering all *required* intervals, avoiding all *excluded*.\"\"\"\n    req0 = min(a for a, _ in required)\n    req1 = max(b for _, b in required)\n    lo = max(min_len, req1 - req0 + 1)\n    hi = min(max_len, axis_len)\n    choices: list[tuple[int, int, int]] = []\n    for length in range(lo, hi + 1):\n        start0 = max(0, req1 - length + 1)\n        start1 = min(req0, axis_len - length)\n        for start in range(start0, start1 + 1):\n            end = start + length - 1\n            if all(end < a or start > b for a, b in excluded):\n                choices.append((length, start, end))\n    if not choices:\n        return None\n\n    # Bias mildly toward compact side bars while still covering long-span cases.\n    lengths = sorted({length for length, _, _ in choices})\n    if random.random() < SPAN_COMPACT_PROB:\n        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]\n        pool = [(start, end) for length, start, end in choices if length <= cutoff]\n    else:\n        pool = [(start, end) for _, start, end in choices]\n    return random.choice(pool)\n\n\n# ── Beam simulation (oracle) ──────────────────────────────────────────\n\ndef _simulate_paths(\n    base: np.ndarray, turns: dict[int, str], bg: int\n) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]]]:\n    \"\"\"Simulate 4 beams from the teal square, returning painted grid and per-beam hit lists.\"\"\"\n    vals, counts = np.unique(base, return_counts=True)\n    assert int(vals[counts.argmax()]) == bg\n\n    teal_locs = np.argwhere(base == TEAL)\n    assert teal_locs.size\n    sr, sc = teal_locs.min(axis=0)\n    r1, c1 = teal_locs.max(axis=0)\n    sz = int(r1 - sr + 1)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/9f669b64.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/9f669b64.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, crop_bbox, find_components, get_bg, paste\nimport random\n\n\ndef _center(obj: dict, axis: int) -> float:\n    r0, c0, r1, c1 = obj[\"bbox\"]\n    return ((r0 + r1) / 2, (c0 + c1) / 2)[axis]\n\n\ndef _span(obj: dict, axis: int) -> int:\n    return bbox_h(obj[\"bbox\"]) if axis == 0 else bbox_w(obj[\"bbox\"])\n\n\ndef _is_solid_rectangle(g: np.ndarray, obj: dict) -> bool:\n    r0, c0, r1, c1 = obj[\"bbox\"]\n    color = int(obj[\"color\"])\n    return (\n        int(obj[\"area\"]) == (r1 - r0 + 1) * (c1 - c0 + 1)\n        and np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color)\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Push the central solid rectangle to the grid edge, splitting the perpendicular target rectangle around its path.\n\n    Input structure\n    - The background is the dominant color.\n    - There are exactly three monochrome foreground objects arranged on one\n      horizontal or vertical axis.\n    - The middle object on that axis is a solid rectangular moving object.\n    - One end object is a solid rectangle or bar whose long side is perpendicular\n      to the movement axis; this is the target to split.\n\n    Rule\n    - Move the middle rectangle along the axis toward the target until it is\n      flush with the grid edge in that direction.\n    - Clear the original middle rectangle and the original target.\n    - Split the target through the moving rectangle's two-cell-wide path and\n      shift the two halves one cell outward perpendicular to the movement.\n    - Keep the other end object unchanged.\n\n    Key insight\n    - The non-target end object acts as a pusher; the central rectangle travels\n      away from it through the perpendicular target, opening a matching gap.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(objects) == 3, \"expected exactly three foreground objects\"\n\n    row_centers = [_center(obj, 0) for obj in objects]\n    col_centers = [_center(obj, 1) for obj in objects]\n    row_spread = max(row_centers) - min(row_centers)\n    col_spread = max(col_centers) - min(col_centers)\n    assert min(row_spread, col_spread) <= 0.5, \"objects must share a row or column axis\"\n    axis = 0 if col_spread <= 0.5 else 1\n    perp = 1 - axis\n\n    ordered = sorted(objects, key=lambda obj: _center(obj, axis))\n    axis_centers = [_center(obj, axis) for obj in ordered]\n    assert axis_centers[0] < axis_centers[1] < axis_centers[2], \"expected a unique middle object\"\n\n    source = ordered[1]\n    end_objects = [ordered[0], ordered[2]]\n    assert _is_solid_rectangle(g, source), \"moving object must be a solid rectangle\"\n\n    target_candidates = [\n        obj\n        for obj in end_objects\n        if _is_solid_rectangle(g, obj) and _span(obj, perp) > _span(obj, axis)\n    ]\n    assert len(target_candidates) == 1, \"expected one perpendicular solid target\"\n    target = target_candidates[0]\n\n    direction = -1 if _center(target, axis) < _center(source, axis) else 1\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    tr0, tc0, tr1, tc1 = target[\"bbox\"]\n    source_lo = [sr0, sc0]\n    source_hi = [sr1, sc1]\n    target_lo = [tr0, tc0]\n    target_hi = [tr1, tc1]\n\n    source_perp_len = source_hi[perp] - source_lo[perp] + 1\n    assert source_perp_len == 2, \"moving object path must be two cells wide\"\n    assert target_lo[perp] <= source_lo[perp] <= source_hi[perp] <= target_hi[perp]\n    assert (\n        source_lo[perp] - target_lo[perp] == target_hi[perp] - source_hi[perp]\n    ), \"moving object must be centered across the target\"\n\n    out = g.copy()\n    for r, c in source[\"coords\"]:\n        out[int(r), int(c)] = bg\n    for r, c in target[\"coords\"]:\n        out[int(r), int(c)] = bg\n\n    shift = source_perp_len // 2\n    for r, c in target[\"coords\"]:\n        new_rc = [int(r), int(c)]\n        if new_rc[perp] <= source_lo[perp]:\n            new_rc[perp] -= shift\n        else:\n            assert new_rc[perp] >= source_hi[perp]\n            new_rc[perp] += shift\n        assert 0 <= new_rc[0] < H and 0 <= new_rc[1] < W, \"shifted target must stay in bounds\"\n        out[new_rc[0], new_rc[1]] = int(target[\"color\"])\n\n    source_patch = crop_bbox(g, source[\"bbox\"])\n    if axis == 0:\n        new_r = 0 if direction < 0 else H - source_patch.shape[0]\n        new_c = source_lo[1]\n    else:\n        new_r = source_lo[0]\n        new_c = 0 if direction < 0 else W - source_patch.shape[1]\n    dest = out[new_r : new_r + source_patch.shape[0], new_c : new_c + source_patch.shape[1]]\n    assert np.all(dest == bg), \"moving object destination must be clear\"\n    paste(out, source_patch, new_r, new_c)\n    return out\n\n# --------------- generator (att2) ---------------\n\nGEN_GRID_SIZE = 10\nGEN_BG = 7\nGEN_FG_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nGEN_SOURCE_PERP = 2\nGEN_SOURCE_ALONG_CHOICES = [2, 3]\nGEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX = 1, 4\nGEN_TARGET_OVERHANG_CHOICES = (1, 2)\nGEN_SOURCE_TARGET_GAP_RANGE = range(5)\nGEN_OTHER_WIDTH_CHOICES = (2, 4, 6)\nGEN_OTHER_MIN_STAIR_WIDTH = 4\nGEN_OTHER_MIN_STAIR_HEIGHT = 2\nGEN_ORIENTATION_COUNT, GEN_RETRY_LIMIT = 4, 300\n\n\ndef _gen_transform(grid: np.ndarray, orientation: int) -> np.ndarray:\n    if orientation == 0:\n        return grid.copy()\n    if orientation == 1:\n        return np.flipud(grid).copy()\n    if orientation == 2:\n        return np.rot90(grid, 1).copy()\n    return np.rot90(grid, -1).copy()\n\n\ndef _gen_even_centered_start(center_left: int, width: int) -> int:\n    return center_left - (width // 2 - 1)\n\n\ndef _gen_stair_patch(h: int, w: int, color: int, bg: int) -> np.ndarray:\n    patch = np.full((h, w), bg, dtype=int)\n    max_extra = w // 2 - 1\n    thresholds = sorted(random.randint(1, h - 1) for _ in range(max_extra))\n    for r in range(h):\n        extra = sum(r >= threshold for threshold in thresholds)\n        c0 = w // 2 - 1 - extra\n        c1 = w // 2 + extra\n        patch[r, c0 : c1 + 1] = color\n    return patch\n\n\ndef _gen_place_other(grid: np.ndarray, r0: int, center_left: int, color: int, bg: int) -> None:\n    h = grid.shape[0] - r0\n    in_bounds_widths = [\n        w\n        for w in GEN_OTHER_WIDTH_CHOICES\n        if 0 <= _gen_even_centered_start(center_left, w)\n        and _gen_even_centered_start(center_left, w) + w <= grid.shape[1]\n    ]\n    solid_widths = [w for w in in_bounds_widths if w <= h]\n    stair_widths = [w for w in in_bounds_widths if w >= GEN_OTHER_MIN_STAIR_WIDTH and h >= GEN_OTHER_MIN_STAIR_HEIGHT]\n\n    kinds = []\n    if solid_widths:\n        kinds.append(\"solid\")\n    if stair_widths:\n        kinds.append(\"stair\")\n    kind = random.choice(kinds)\n\n    if kind == \"solid\":\n        w = random.choice(solid_widths)\n        patch = np.full((h, w), color, dtype=int)\n    else:\n        w = random.choice(stair_widths)\n        patch = _gen_stair_patch(h, w, color, bg)\n    paste(grid, patch, r0, _gen_even_centered_start(center_left, w), transparent=bg)\n\n\ndef _gen_choose_layout() -> tuple[int, int, int, int, int, int] | None:\n    s_h = random.choice(GEN_SOURCE_ALONG_CHOICES)\n    t_h = random.randint(GEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX)\n    overhangs = [k for k in GEN_TARGET_OVERHANG_CHOICES if 2 * k + GEN_SOURCE_PERP > t_h]\n    k = random.choice(overhangs)\n    gap_options = [g for g in GEN_SOURCE_TARGET_GAP_RANGE if t_h + g + s_h <= GEN_GRID_SIZE - GEN_SOURCE_PERP]\n    if not gap_options:\n        return None\n    gap = random.choice(gap_options)\n    t0_max = GEN_GRID_SIZE - GEN_SOURCE_PERP - t_h - gap - s_h\n    t0 = random.randint(0, t0_max)\n    center_left = random.randint(k + 1, GEN_GRID_SIZE - k - 3)\n    return s_h, t_h, k, gap, t0, center_left\n\n\ndef _gen_canonical_pair(s_h: int, t_h: int, k: int, gap: int, t0: int, center_left: int, colors: list[int]) -> tuple[np.ndarray, np.ndarray]:\n    source_color, target_color, other_color = colors\n    source_patch = np.full((s_h, GEN_SOURCE_PERP), source_color, dtype=int)\n    target_patch = np.full((t_h, 2 * k + GEN_SOURCE_PERP), target_color, dtype=int)\n    split_half = np.full((t_h, k + 1), target_color, dtype=int)\n\n    out = np.full((GEN_GRID_SIZE, GEN_GRID_SIZE), GEN_BG, dtype=int)\n    paste(out, source_patch, 0, center_left)\n    paste(out, split_half, t0, center_left - k - 1)\n    paste(out, split_half, t0, center_left + GEN_SOURCE_PERP)\n\n    source_in_r = t0 + t_h + gap\n    other_r = source_in_r + s_h\n    _gen_place_other(out, other_r, center_left, other_color, GEN_BG)\n\n    inp = out.copy()\n    inp[0:s_h, center_left : center_left + GEN_SOURCE_PERP] = GEN_BG\n    inp[t0 : t0 + t_h, center_left - k - 1 : center_left] = GEN_BG\n    inp[t0 : t0 + t_h, center_left + GEN_SOURCE_PERP : center_left + k + 3] = GEN_BG\n    paste(inp, target_patch, t0, center_left - k)\n    paste(inp, source_patch, source_in_r, center_left)\n    return inp, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    colors = random.sample(GEN_FG_COLORS, 3)\n    layout = _gen_choose_layout()\n    if layout is None:\n        return None\n    inp, out = _gen_canonical_pair(*layout, colors)\n\n    orientation = random.randrange(GEN_ORIENTATION_COUNT)\n","exit_code":0,"status":"completed"}}
