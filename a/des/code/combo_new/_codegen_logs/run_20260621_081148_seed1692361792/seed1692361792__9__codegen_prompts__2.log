{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed1692361792/9/2.py')\nmod = SourceFileLoader('new_arc_task_stats', str(p)).load_module()\ncounts = {2: 0, 3: 0, 4: 0}\noverlap = 0\nfor _ in range(200):\n    g = mod.generate_input()\n    colors = [int(c) for c in np.unique(g) if int(c) \"'!= 0]\n    pair_count = sum(np.count_nonzero(g == c) == 2 for c in colors)\n    counts[pair_count] += 1\n    rects = []\n    for c in colors:\n        pts = np.argwhere(g == c)\n        if len(pts) == 2:\n            (r0, c0), (r1, c1) = pts\n            rects.append((min(r0, r1), min(c0, c1), max(r0, r1), max(c0, c1)))\n    has_overlap = False\n    for i in range(len(rects)):\n        for j in range(i + 1, len(rects)):\n            rr = max(0, min(rects[i][2], rects[j][2]) - max(rects[i][0], rects[j][0]) + 1)\n            cc = max(0, min(rects[i][3], rects[j][3]) - max(rects[i][1], rects[j][1]) + 1)\n            if rr * cc > 0:\n                has_overlap = True\n                break\n        if has_overlap:\n            break\n    overlap += int(has_overlap)\nprint('\"'pair_counts', counts)\nprint('overlap_cases', overlap)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
