{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,120p' /home/lixinyu/snap/new/ARC_code/train/b1986d4b.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _square_objects(g: np.ndarray, bg: int) -> list[dict]:\n    objects = []\n    for obj in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        if h == w and h >= 2 and int(obj[\"area\"]) == h * w:\n            objects.append({\"side\": int(h), \"color\": int(obj[\"color\"]), \"bbox\": obj[\"bbox\"]})\n    return objects\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Render the filled-square object counts as compact nested stacks ordered by count rank.\n\n    Input structure\n    A large noisy grid has a dominant background, scattered non-square noise, and\n    filled monochrome square objects. Each square side length has exactly one\n    object color, and side lengths form consecutive sizes.\n\n    Rule\n    Ignore non-square components. If the lowest square in the scene is of the\n    smallest side length, treat that one smallest square as a distractor and do\n    not count it. For count rank k from left to right, create one block from all\n    square sizes with at least k remaining objects; draw larger squares first and\n    smaller squares over their upper-left corner, then append one background\n    separator column.\n\n    Key insight\n    The output is a count histogram of square side lengths, but each histogram\n    slot is rendered as nested upper-left square masks using the side colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    objects = _square_objects(g, bg)\n    assert objects, \"expected filled square objects\"\n\n    sides = sorted({obj[\"side\"] for obj in objects})\n    assert sides == list(range(sides[0], sides[-1] + 1)), \"expected consecutive square side lengths\"\n\n    by_side = {side: [obj for obj in objects if obj[\"side\"] == side] for side in sides}\n    colors = {}\n    for side, side_objects in by_side.items():\n        side_colors = {obj[\"color\"] for obj in side_objects}\n        assert len(side_colors) == 1, \"each side length should have one color\"\n        colors[side] = side_colors.pop()\n\n    smallest = sides[0]\n    lowest_row = max(obj[\"bbox\"][2] for obj in objects)\n    lowest_smallest = [obj for obj in by_side[smallest] if obj[\"bbox\"][2] == lowest_row]\n    if lowest_smallest:\n        assert len(lowest_smallest) == 1, \"expected at most one lowest smallest distractor\"\n        drop_bbox = lowest_smallest[0][\"bbox\"]\n        by_side[smallest] = [obj for obj in by_side[smallest] if obj[\"bbox\"] != drop_bbox]\n\n    counts = {side: len(side_objects) for side, side_objects in by_side.items()}\n    assert all(count > 0 for count in counts.values()), \"each square size should remain represented\"\n\n    out_h = sides[-1] + 1\n    groups = []\n    for rank in range(max(counts.values())):\n        present_sides = [side for side in sides if counts[side] > rank]\n        assert present_sides, \"rank should contain at least one square size\"\n\n        group_w = max(present_sides)\n        group = np.full((out_h, group_w), bg, dtype=int)\n        for side in sorted(present_sides, reverse=True):\n            group[:side, :side] = colors[side]\n        groups.append(group)\n\n    out_w = sum(group.shape[1] + 1 for group in groups)\n    out = np.full((out_h, out_w), bg, dtype=int)\n    c = 0\n    for group in groups:\n        w = group.shape[1]\n        out[:, c : c + w] = group\n        c += w + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nSIDES = [2, 3, 4]\nALL_COLORS = list(range(10))\n\n# Canvas and object bounds.\nGRID_SIZE_RANGE = (25, 28)\nCOUNT_RANGE = (2, 6)\nSQUARE_GAP = 1\n\n# Noise and distractor controls.\nDISTRACTOR_PROB = 0.5\nNOISE_COUNT_RANGE = (40, 70)\n\n# Retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _choose_palette() -> tuple[int, dict[int, int], int]:\n    \"\"\"Choose one background, three square colors, and one noise color.\"\"\"\n    bg = random.choice(ALL_COLORS)\n    non_bg = [c for c in ALL_COLORS if c != bg]\n    random.shuffle(non_bg)\n    square_colors = {side: non_bg[i] for i, side in enumerate(SIDES)}\n    return bg, square_colors, non_bg[len(SIDES)]\n\n\ndef _make_square_queue(\n    counts: dict[int, int], square_colors: dict[int, int], has_distractor: bool\n) -> tuple[list[tuple[int, int]], tuple[int, int] | None]:\n    \"\"\"Return regular squares plus the separately placed distractor candidate.\"\"\"\n    squares = [(side, square_colors[side]) for side in SIDES for _ in range(counts[side])]\n    if has_distractor:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,120p' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport random\nimport numpy as np\nfrom scipy.ndimage import label as scipy_label\nfrom arc_utils import bbox_h, bbox_w, find_components, in_bounds, neighbors4, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n","exit_code":0,"status":"completed"}}
