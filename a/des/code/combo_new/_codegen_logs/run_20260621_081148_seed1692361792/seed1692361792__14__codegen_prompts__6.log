ons under the output-width budget.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:202:    \"\"\"Generate one valid input grid, or None when sampled dimensions fail constraints.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:226:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:41:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:42:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:56:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:184:    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:188:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:202:    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:207:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:245:    \"\"\"Grow a meandering 8-connected 1px-wide path of line_col from start.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:296:    \"\"\"Compute offsets around a frame bbox that lie outside it (the halo).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:302:    \"\"\"Try to place a frame loop 8-adjacent to some line pixel.\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:305:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:330:    \"\"\"Place a loop in empty space, not touching any non-bg pixel.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:357:    \"\"\"Place a disconnected line+frame distractor (no seed).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:388:    \"\"\"Return (seed_rc, first_line_rc) for corner_kind in {TL,TR,BL,BR}.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:407:    \"\"\"Distribute attached-loop budget across seeds, guaranteeing >= 1 each.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:508:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/f18ec8cc.py:70:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/f18ec8cc.py:71:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/f18ec8cc.py:86:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/f18ec8cc.py:250:def generate_input():\n/home/lixinyu/snap/new/ARC_code/train/b1986d4b.py:18:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/b1986d4b.py:19:    \"\"\"Render the filled-square object counts as compact nested stacks ordered by count rank.\n/home/lixinyu/snap/new/ARC_code/train/b1986d4b.py:37:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/b1986d4b.py:107:    \"\"\"Choose one background, three square colors, and one noise color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/b1986d4b.py:118:    \"\"\"Return regular squares plus the separately placed distractor candidate.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/b1986d4b.py:130:    \"\"\"List top-left positions whose padded square footprint is unoccupied.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/b1986d4b.py:161:    \"\"\"Place one square at a random valid position and update grid state.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/b1986d4b.py:178:    \"\"\"Place all squares, requiring any distractor to sit below the others.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/b1986d4b.py:203:    \"\"\"Scatter noise onto background cells only.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/b1986d4b.py:215:    \"\"\"Detect no-distractor samples where the solver would drop a small square.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/b1986d4b.py:223:    \"\"\"Render the count-derived oracle output used to validate samples.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/b1986d4b.py:274:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:7:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:8:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:22:    \"\"\"\n/home/l