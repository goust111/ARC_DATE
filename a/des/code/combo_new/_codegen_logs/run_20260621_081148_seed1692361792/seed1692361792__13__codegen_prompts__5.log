{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nbase=np.array([[0,0,1,1],[0,1,1,0],[1,1,0,0],[1,0,0,0]],dtype=int)\n\nops=[]\na=base\nfor k in range(4):\n    arr=np.rot90(base,k)\n    ops.append((f'rot{k*90}',arr))\n\ndef coords(arr):\n    return {(r,c) for r in range(arr.shape[0]) for c in range(arr.shape[1]) if arr[r,c]}\n\ndef edge_support(arr,edge):\n    h,w=arr.shape\n    if edge=='top':\n        return arr[0,w//2]==1\n    if edge=='bottom':\n        return arr[h-1,w//2]==1\n    if edge=='left':\n        return arr[h//2,0]==1\n    if edge=='right':\n        return arr[h//2,w-1]==1\n\ndef miss(arr,edge):\n    S=coords(arr)\n    h,w=arr.shape\n    if edge in ('top','bottom'):\n        shift=2\n        templ={(r+shift,c) for r,c in S}\n        for k in range(-3,6):\n            shifted={(r+h*k,c) for r,c in S}\n            if shifted & templ:\n                return False\n        return True\n    else:\n        shift=2\n        templ={(r,c+shift) for r,c in S}\n        for k in range(-3,6):\n            shifted={(r,c+w*k) for r,c in S}\n            if shifted & templ:\n                return False\n        return True\n\nfor name,arr in ops:\n    print(name)\n    for r in arr:\n        print(''.join('#' if x else '.' for x in r))\n    for edge in ['top','bottom','left','right']:\n        print(edge,'support',edge_support(arr,edge),'miss',miss(arr,edge))\n    print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
