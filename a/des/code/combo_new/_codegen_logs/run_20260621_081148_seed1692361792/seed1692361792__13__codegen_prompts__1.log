{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/a/des/code/combo_new/seed1692361792/13/1.py\"","aggregated_output":"import random\nfrom collections import deque\n\nimport numpy as np\n\n\nBG = 0\nFRAME = 5\nPALETTE = [1, 2, 3, 4, 6, 7, 8, 9]\nFRAME_SIZES = [6, 8]\nMAX_CANVAS = 30\nGENERATION_ATTEMPTS = 400\nNEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\ndef _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:\n    return (\n        int(coords[:, 0].min()),\n        int(coords[:, 1].min()),\n        int(coords[:, 0].max()),\n        int(coords[:, 1].max()),\n    )\n\n\ndef _components(mask: np.ndarray) -> list[np.ndarray]:\n    h, w = mask.shape\n    seen = np.zeros((h, w), dtype=bool)\n    comps: list[np.ndarray] = []\n    for r in range(h):\n        for c in range(w):\n            if not bool(mask[r, c]) or bool(seen[r, c]):\n                continue\n            seen[r, c] = True\n            queue = deque([(r, c)])\n            cells = []\n            while queue:\n                rr, cc = queue.popleft()\n                cells.append((rr, cc))\n                for dr, dc in NEIGHBORS4:\n                    nr, nc = rr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):\n                        seen[nr, nc] = True\n                        queue.append((nr, nc))\n            comps.append(np.asarray(cells, dtype=int))\n    return comps\n\n\ndef _crop_mask(mask: np.ndarray) -> np.ndarray:\n    coords = np.argwhere(mask)\n    assert coords.size > 0\n    r0, c0, r1, c1 = _bbox(coords)\n    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()\n\n\ndef _coords_to_mask(coords: np.ndarray) -> np.ndarray:\n    r0, c0, r1, c1 = _bbox(coords)\n    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True\n    return mask\n\n\ndef _reflect(mask: np.ndarray, gap_side: str) -> np.ndarray:\n    if gap_side in (\"left\", \"right\"):\n        return np.fliplr(mask)\n    return np.flipud(mask)\n\n\ndef _gap_half(shape: tuple[int, int], gap_side: str) -> np.ndarray:\n    h, w = shape\n    half = np.zeros((h, w), dtype=bool)\n    if gap_side == \"left\":\n        half[:, : w // 2] = True\n    elif gap_side == \"right\":\n        half[:, w - (w // 2) :] = True\n    elif gap_side == \"top\":\n        half[: h // 2, :] = True\n    elif gap_side == \"bottom\":\n        half[h - (h // 2) :, :] = True\n    else:\n        raise AssertionError(f\"bad side: {gap_side}\")\n    return half\n\n\ndef _frame_infos(grid: np.ndarray) -> list[dict]:\n    infos = []\n    for comp in _components(grid == FRAME):\n        r0, c0, r1, c1 = _bbox(comp)\n        n = r1 - r0 + 1\n        if n != c1 - c0 + 1 or n < 6:\n            continue\n        local = np.zeros((n, n), dtype=bool)\n        local[comp[:, 0] - r0, comp[:, 1] - c0] = True\n        border = np.zeros((n, n), dtype=bool)\n        border[0, :] = True\n        border[-1, :] = True\n        border[:, 0] = True\n        border[:, -1] = True\n        if bool((local & ~border).any()):\n            continue\n        missing = np.argwhere(border & ~local)\n        if len(missing) != 1:\n            continue\n        mr, mc = map(int, missing[0])\n        if (mr in (0, n - 1)) and (mc in (0, n - 1)):\n            continue\n        if int(local.sum()) != 4 * n - 5:\n            continue\n        if mr == 0:\n            gap_side = \"top\"\n        elif mr == n - 1:\n            gap_side = \"bottom\"\n        elif mc == 0:\n            gap_side = \"left\"\n        elif mc == n - 1:\n            gap_side = \"right\"\n        else:\n            continue\n        infos.append({\"bbox\": (r0, c0, r1, c1), \"gap_side\": gap_side})\n    infos.sort(key=lambda info: info[\"bbox\"])\n    return infos\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete each gapped frame by flipping the matching outside fragment into the missing side of the inner motif.\n\n    Input structure:\n    - The background is black.\n    - One or more grey square frames appear on the grid; each border is one cell thick and has exactly one one-cell gap on one side.\n    - Inside each frame, a single non-grey color draws a motif that is nearly symmetric, except some cells are missing on the side pointed to by the gap.\n    - Outside the frames, a small monochrome fragment of that same color lies on the background.\n\n    Rule:\n    - Detect every grey frame and identify which side contains its border gap.\n    - For the interior motif, reflect the visible pattern across the axis perpendicular to the gap direction; the reflected cells absent on the gap side are the missing patch.\n    - Find the outside fragment of the same color whose mirrored shape matches that missing patch, erase the fragment from its original location, and place the mirrored version into the frame.\n    - Leave the grey border unchanged, including the gap itself.\n\n    Key insight:\n    - The gap is both a side marker and a reflection hint: it tells you where the motif is incomplete and which mirror flip turns the outside piece into the exact repair.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    frames = _frame_infos(g)\n    assert frames, \"expected at least one grey frame\"\n\n    frame_bbox_mask = np.zeros_like(g, dtype=bool)\n    for info in frames:\n        r0, c0, r1, c1 = info[\"bbox\"]\n        frame_bbox_mask[r0 : r1 + 1, c0 : c1 + 1] = True\n\n    out = g.copy()\n    for info in frames:\n        r0, c0, r1, c1 = info[\"bbox\"]\n        gap_side = info[\"gap_side\"]\n        interior = g[r0 + 1 : r1, c0 + 1 : c1]\n        colors = sorted(set(map(int, interior.flat)) - {BG})\n        assert len(colors) == 1, \"each frame must contain exactly one motif color\"\n        color = int(colors[0])\n\n        motif = interior == color\n        reflected = _reflect(motif, gap_side)\n        missing = reflected & ~motif & _gap_half(motif.shape, gap_side)\n        assert bool(missing.any()), \"gap side must miss some reflected cells\"\n        target = _crop_mask(missing)\n\n        matches = []\n        outside = (out == color) & ~frame_bbox_mask\n        for comp in _components(outside):\n            frag = _coords_to_mask(comp)\n            if np.array_equal(_reflect(frag, gap_side), target):\n                matches.append(comp)\n        assert len(matches) == 1, \"expected a unique matching fragment\"\n\n        frag_coords = matches[0]\n        out[frag_coords[:, 0], frag_coords[:, 1]] = BG\n        inner_out = out[r0 + 1 : r1, c0 + 1 : c1]\n        inner_out[missing] = color\n\n    return out\n\n\ndef _random_connected_mask(h: int, w: int, size: int, rng: random.Random) -> np.ndarray:\n    mask = np.zeros((h, w), dtype=bool)\n    start = (rng.randrange(h), rng.randrange(w))\n    mask[start] = True\n    while int(mask.sum()) < size:\n        frontier = []\n        for rr, cc in np.argwhere(mask):\n            for dr, dc in NEIGHBORS4:\n                nr, nc = int(rr + dr), int(cc + dc)\n                if 0 <= nr < h and 0 <= nc < w and not bool(mask[nr, nc]):\n                    frontier.append((nr, nc))\n        if not frontier:\n            break\n        nr, nc = rng.choice(frontier)\n        mask[nr, nc] = True\n    return mask\n\n\ndef _grow_half_masks(h: int, w: int, gap_side: str, rng: random.Random) -> tuple[np.ndarray, np.ndarray]:\n    max_cells = h * w\n    for _ in range(200):\n        frag_size = rng.randint(2, min(5, max_cells - 1))\n        frag = _random_connected_mask(h, w, frag_size, rng)\n        if int(frag.sum()) != frag_size:\n            continue\n        frag_norm = _crop_mask(frag)\n        if gap_side in (\"left\", \"right\"):\n            if frag_norm.shape[1] < 2 or np.array_equal(frag_norm, np.fliplr(frag_norm)):\n                continue\n        else:\n            if frag_norm.shape[0] < 2 or np.array_equal(frag_norm, np.flipud(frag_norm)):\n                continue\n\n        base = frag.copy()\n        extra_target = rng.randint(1, min(3, max_cells - frag_size))\n        while int(base.sum()) < frag_size + extra_target:\n            frontier = []\n            for rr, cc in np.argwhere(base):\n                for dr, dc in NEIGHBORS4:\n                    nr, nc = int(rr + dr), int(cc + dc)\n                    if 0 <= nr < h and 0 <= nc < w and not bool(base[nr, nc]):\n                        frontier.append((nr, nc))\n            if not frontier:\n                break\n            nr, nc = rng.choice(frontier)\n            base[nr, nc] = True\n        if int(base.sum()) > frag_size:\n            return frag, base\n    raise RuntimeError(\"failed to construct a valid fragment\")\n\n\ndef _build_case(size: int, gap_side: str, color: int, rng: random.Random) -> tuple[np.ndarray, np.ndarray, np.ndarray]:\n    interior_n = size - 2\n    if gap_side in (\"left\", \"right\"):\n        frag_half, base_half = _grow_half_masks(interior_n, interior_n // 2, gap_side, rng)\n        if gap_side == \"left\":\n            left = np.fliplr(base_half)\n            left[np.fliplr(frag_half)] = False\n            right = base_half.copy()\n            solved_left = np.fliplr(base_half)\n            solved_right = base_half.copy()\n        else:\n            left = base_half.copy()\n            right = np.fliplr(base_half)\n            right[np.fliplr(frag_half)] = False\n            solved_left = base_half.copy()\n            solved_right = np.fliplr(base_half)\n        current = np.concatenate([left, right], axis=1)\n        solved = np.concatenate([solved_left, solved_right], axis=1)\n        fragment_mask = frag_half\n    else:\n        frag_half, base_half = _grow_half_masks(interior_n // 2, interior_n, gap_side, rng)\n        if gap_side == \"top\":\n            top = np.flipud(base_half)\n            top[np.flipud(frag_half)] = False\n            bottom = base_half.copy()\n            solved_top = np.flipud(base_half)\n","exit_code":0,"status":"completed"}}
