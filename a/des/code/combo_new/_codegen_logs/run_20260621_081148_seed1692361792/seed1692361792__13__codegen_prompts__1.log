lls = [(r, c) for r in range(size - 2) for c in range(size - 2)]\n            for _attempt in range(200):\n                cell = random.choice(all_cells)\n                mate = flip(cell)\n                if cell in miss or mate in miss:\n                    continue\n                pattern.add(cell)\n                pattern.add(mate)\n                if len(pattern) >= len(miss) + extras:\n                    break\n\n            for rr, cc in pattern:\n                grid[r0 + 1 + rr, c0 + 1 + cc] = color\n\n            fragment = _normalize([flip(cell) for cell in miss])\n            _place_blob(grid, fragment, color, forbidden)\n\n        if not ok:\n            continue\n        if np.array_equal(main(grid), main(grid.copy())):\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
