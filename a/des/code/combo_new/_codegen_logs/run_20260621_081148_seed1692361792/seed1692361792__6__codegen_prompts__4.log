hose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n 108: \n 109:     Rule:\n 110:     - For each enclosed region, identify its border color C and look up the legend with fill color C.\n 111:     - The direction from the legend's center dot to its indicator dot gives the slide direction.\n 112:     - All yellow pixels in that region slide in that direction, stacking against the far wall.\n 113: \n 114:     Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n 115:     \"\"\"\n 116:     g = np.asarray(grid, dtype=int)\n 117:     h, w = g.shape\n 118:     bg = get_bg(g)\n 119: \n 120:     mover = 4  # yellow in ARC\n 121:     dirs = _legend_directions(g, bg)\n 122:     assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n 123: \n 124:     passable = (g == bg) | (g == mover)\n 125:     out = g.copy()\n 126: \n 127:     # Find enclosed passable regions (not connected to the outer border).\n 128:     for pts in components_mask(passable, connectivity=4):\n 129:         if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n 130:             continue  # outside background\n 131: \n 132:         movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n 133:         if not movers:\n 134:             continue\n 135: \n 136:         # Determine this region's border color by counting adjacent wall colors.\n 137:         border_counts: dict[int, int] = {}\n 138:         pset = {(int(r), int(c)) for r, c in pts}\n 139:         for r, c in pts:\n 140:             for nr, nc in neighbors4(r, c):\n 141:                 if not (0 <= nr < h and 0 <= nc < w):\n 142:                     continue\n 143:                 if (nr, nc) in pset:\n 144:                     continue\n 145:                 v = int(g[nr, nc])\n 146:                 if v == bg or v == mover:\n 147:                     continue\n 148:                 border_counts[v] = border_counts.get(v, 0) + 1\n 149:         if not border_counts:\n 150:             continue\n 151:         border_col = max(border_counts, key=border_counts.get)\n 152:         if border_col not in dirs:\n 153:             continue\n 154:         dr, dc = dirs[border_col]\n 155: \n 156:         # Clear old movers.\n 157:         for r, c in movers:\n 158:             out[r, c] = bg\n 159: \n 160:         # Slide and repaint.\n 161:         new_pts = _slide_points(pset, movers, dr, dc)\n 162:         for r, c in new_pts:\n 163:             out[r, c] = mover\n 164: \n 165:     return out\n 166: \n 167: # --------------- generator (claude-att1) ---------------\n 168: \n 169: \"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\n 170: import random\n 171: import numpy as np\n 172: \n 173: from arc_utils import label_mask, neighbors4, paste\n 174: \n 175: # ── Configuration ─────────────────────────────────────────────────\n 176: GRID_H, GRID_W = 20, 20\n 177: \n 178: # Legend\n 179: CARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n 180: DIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\n 181: CORNERS = ['TL', 'TR', 'BL', 'BR']\n 182: WALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\n 183: CARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\n 184: LEGEND_BUFFER = 1                          # cells of padding around legend patches\n 185: \n 186: # Regions\n 187: REGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\n 188: MAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\n 189: REGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n 190:     1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n 191: }\n 192: BLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n 193: \n 194: # Yellows\n 195: YELLOWS_PER_REGION = [1, 2]                # choices per region\n 196: MAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n 197: \n 198: # Outer loop\n 199: GEN_RETRIES = 300                          # max attempts in generate_input()\n 200: \n 201: \n 202: # ── Legend patches ────────────────────────────────────────────────\n 203: \n-- generate_input @ line 604\n 604: def generate_input() -> np.ndarray:\n 605:     rng = random.Random()\n 606:     for _ in range(GEN_RETRIES):\n 607:         try:\n 608:             g = _gen_attempt(rng)\n 609:         except Exception:\n 610:             continue\n 611:         if g is not None:\n 612:             return g\n 613:     raise RuntimeError(\"generate_input: exceeded retries\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/e39e9282.py =====\n-- main @ line 72\n  72: def main(grid: np.ndarray) -> np.ndarray:\n  73:     \"\"\"Project maroon markers into adjacent grey or pink 3x3 squares, erasing grey squares afterward.\n  74: \n  75:     Input structure\n  76:     The grid has a dominant background, solid 3x3 grey and/or pink squares, and maroon marker pixels or segments directly touching one side of exactly one square.\n  77:     Rule\n  78:     Grey squares are erased; their adjacent maroon markers stay in place and stamp the nearest edge cell inside the grey square. Pink squares stay pink; their adjacent maroon markers disappear and stamp the corresponding cell on the square's middle row or middle column.\n  79:     Key insight\n  80:     The side touched by a marker determines the projection: grey uses the near edge, while pink uses the centerline, preserving the marker's coordinate along that side.\n  81:     \"\"\"\n  82:     g = np.asarray(grid, dtype=int)\n  83:     bg = get_bg(g)\n  84:     colors = set(map(int, np.unique(g)))\n  85:     assert colors <= {bg, Color.GREY, Color.PINK, Color.MAROON}\n  86:     assert Color.MAROON in colors\n  87: \n  88:     squares =