rection):\n  90:             placements.append((color, coords))\n  91: \n  92:     occupied = (out != bg)\n  93:     for color, coords in placements:\n  94:         assert not np.any(occupied[coords[:, 0], coords[:, 1]]), \"different colors must not settle on the same pixel\"\n  95:         out[coords[:, 0], coords[:, 1]] = color\n  96:         occupied[coords[:, 0], coords[:, 1]] = True\n  97: \n  98:     assert int(np.sum(out == left_color)) == int(np.sum(g == left_color)), \"left color count must be preserved\"\n  99:     assert int(np.sum(out == right_color)) == int(np.sum(g == right_color)), \"right color count must be preserved\"\n 100:     return out\n 101: \n 102: # --------------- generator (o5x) ---------------\n 103: \n 104: # Canvas and palette bounds.\n 105: GRID_HEIGHT_BOUNDS = (9, 10)\n 106: GRID_WIDTH_BOUNDS = (9, 10)\n 107: BACKGROUND_COLOR = 7\n 108: WALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n 109: # Object counts and pixel budgets.\n 110: COMPONENT_COUNT_BOUNDS = (2, 3)\n 111: INNER_FOREGROUND_BOUNDS = (15, 23)\n 112: SPRITE_PIXEL_BOUNDS = (1, 7)\n 113: # Sprite geometry limits.\n 114: SPRITE_HEIGHT_BOUNDS = (1, 5)\n 115: SPRITE_WIDTH_BOUNDS = (1, 3)\n 116: MIN_SPRITE_DENSITY = 0.56\n 117: # Input scatter and retry limits.\n 118: SCATTER_OFFSET_BOUNDS = (1, 5)\n 119: GENERATION_ATTEMPTS = 300\n 120: \n 121: Placement = tuple[int, np.ndarray, int, int, bool]\n 122: \n 123: \n-- generate_input @ line 297\n 297: def generate_input() -> np.ndarray:\n 298:     for _ in range(GENERATION_ATTEMPTS):\n 299:         grid = _gen_attempt()\n 300:         if grid is not None:\n 301:             return grid\n 302:     raise RuntimeError(\"failed to generate a valid f0100645 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py =====\n-- main @ line 119\n 119: def main(grid: np.ndarray) -> np.ndarray:\n 120:     \"\"\"\n 121:     Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n 122: \n 123:     Input structure:\n 124:     - Black background with several axis-aligned colored line drawings.\n 125:     - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n 126:     - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n 127: \n 128:     Rule:\n 129:     - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n 130:     - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n 131:     - The color with no enclosed region is the noise/pad color.\n 132:     - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n 133: \n 134:     Key insight:\n 135:     - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n 136:     \"\"\"\n 137:     g = np.asarray(grid, dtype=int)\n 138:     bg = int(get_bg(g))\n 139:     assert bg == 0\n 140: \n 141:     counts: list[tuple[int, int, np.ndarray]] = []\n 142:     for color in colors_present(g, exclude={bg}):\n 143:         rooms = _room_count_for_color(g, int(color))\n 144:         walls = _walls_for_color(g, int(color))\n 145:         counts.append((int(color), int(rooms), walls))\n 146: \n 147:     drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n 148:     pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n 149:     assert drawings\n 150:     assert len(pad_colors) == 1\n 151: \n 152:     pad = int(pad_colors[0])\n 153:     ordered: list[tuple[int, int, np.ndarray]] = []\n 154:     for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n 155:         group = [item for item in drawings if item[1] == rooms]\n 156:         ordered.extend(_cover_order(g, group))\n 157: \n 158:     width = max(rooms for _color, rooms, _walls in ordered)\n 159: \n 160:     out = np.full((len(ordered), width), pad, dtype=int)\n 161:     for r, (color, rooms, _walls) in enumerate(ordered):\n 162:         out[r, :rooms] = int(color)\n 163:     return out\n 164: \n 165: # --------------- generator (claude-opus-4-6) ---------------\n 166: \n 167: # ---- CFG: Tunable generation parameters ----\n 168: _FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n 169: _ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n 170: _TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n 171: _GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n 172:     5: (25, 30, 25, 30, 16, 18),\n 173:     4: (22, 30, 22, 30, 18, 22),\n 174:     3: (20, 30, 20, 30, 22, 25),\n 175: }\n 176: _CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n 177: _NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n 178: _WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n 179: _EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n 180: _OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n 181: _GEN_RETRIES = 300                   # outer retry limit\n 182: \n 183: \n-- generate_input @ line 475\n 475: def generate_input() -> np.ndarray:\n 476:     for _ in range(_GEN_RETRIES):\n 477:         result = _gen_attempt()\n 478:         if result is not None:\n 479:             return result\n 480:     raise RuntimeError(f\"Failed to generate valid input after {_GEN_RETRIES} attempts\")\n\n","exit_code":0,"status":"completed"}}
