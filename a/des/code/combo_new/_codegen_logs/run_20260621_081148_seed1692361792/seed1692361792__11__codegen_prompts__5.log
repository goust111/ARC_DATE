{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '208,300p;693,780p' /home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert a rough nested line drawing into a clean canonical frame-and-dot diagram.\n\n    Input structure:\n    - The grid has one background color and one foreground color.\n    - Foreground 4-connected objects are rough closed frames or small filled blobs.\n    - Frames may contain other frames/blobs; blobs outside a frame remain outside it.\n\n    Rule:\n    - Detect the containment tree of foreground objects using holes of each frame object.\n    - Replace every blob with one foreground pixel.\n    - Replace every frame with a rectangular border padded two cells around its direct children.\n    - Place siblings by their original row/column overlap and order, with one empty cell between canonical objects.\n\n    Key insight: The exact wobbly geometry is irrelevant; only enclosure plus relative sibling positions define the output.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    fg_colors = sorted(set(map(int, g.flatten())) - {bg})\n    assert len(fg_colors) == 1\n    fg = int(fg_colors[0])\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg], return_format=\"dict\")\n    assert comps\n\n    nodes: list[_Node] = []\n    holes: list[list[np.ndarray]] = []\n    for comp in comps:\n        coords = np.asarray(comp[\"coords\"], dtype=int)\n        node = _Node(\n            coords=coords,\n            bbox=tuple(map(int, comp[\"bbox\"])),\n            center=coords.mean(axis=0),\n        )\n        node_holes = _component_holes(g.shape, coords)\n        node.is_frame = bool(node_holes)\n        nodes.append(node)\n        holes.append(node_holes)\n\n    assert any(node.is_frame for node in nodes)\n    for node_i, node in enumerate(nodes):\n        containers = []\n        for frame_i, frame in enumerate(nodes):\n            if node_i == frame_i or not frame.is_frame:\n                continue\n            if any(np.all(hole[tuple(node.coords.T)]) for hole in holes[frame_i]):\n                containers.append(frame)\n        if containers:\n            node.parent = min(containers, key=lambda item: int(item.coords.shape[0]))\n            node.parent.children.append(node)\n\n    roots = [node for node in nodes if node.parent is None]\n    mask = _layout_root(roots)\n    out = np.full(mask.shape, bg, dtype=int)\n    out[mask] = fg\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# ── CFG: tunable generation parameters ──────────────────────────────────────\n# Grid / canvas bounds\nGRID_MIN = 16              # minimum grid dimension (rows or cols)\nGRID_MAX = 25              # maximum grid dimension\nMAX_EXTRA_PAD = 12         # max total padding beyond drawing extent\nMAX_PAD_PER_SIDE = 6       # max padding on one side\n\n# Frame geometry\nFRAME_H_RANGE = (7, 20)    # allowed frame bbox height\nFRAME_W_RANGE = (7, 24)    # allowed frame bbox width\nFRAME_CORNER_MAX = 5       # max corner wobble displacement\nFRAME_MIN_EDGE = 2         # min straight-edge length between corners\nFRAME_TURN_RATIO = (0.34, 0.43)  # acceptable turn-ratio range for wobbly loops\nFRAME_RETRIES = 60         # retries per frame-mask generation\n\n# Blob geometry\nBLOB_SIZE_RANGE = (4, 11)  # blob pixel count range\nBLOB_BBOX_RANGE = (2, 5)   # blob bbox dimension range (exclusive upper)\n\n# Layout / arrangement\nARRANGE_GAP_COMPACT = (2, 3)   # inter-sibling gap range (compact mode)\nARRANGE_GAP_NORMAL = (2, 5)    # inter-sibling gap range (normal mode)\nARRANGE_EXTRA_SPAN = (0, 4)    # extra span added to cross-axis in arrangement\nFRAME_MARGIN_RANGE = (3, 5)    # margin around children inside a frame\nCOMPACT_MARGIN = 3             # fixed margin in compact mode\n\n# Outside blob placement\nOUTSIDE_GAP_RANGE = (2, 5)    # gap between frame and outside blob\n\n# Tree structure probabilities\nDEPTH1_PROB = 0.35             # probability of depth-1 (blobs-only) tree\nOUTSIDE_BLOB_PROB = 0.35       # probability of having an outside blob\nDEPTH1_INSIDE_RANGE = (1, 3)   # blobs inside single frame (depth-1)\ndef generate_input():\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 2d0172a1 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '6,120p;535,650p' /home/lixinyu/snap/new/ARC_code/eval/2c181942.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Attach monochrome sprites to the matching sides of a central hollow square.\n\n    Input structure:\n    - bg = background. A hollow NxN square (hub) with bg corners/interior and four differently-colored edges (top, bottom, left, right).\n    - 2-4 monochrome sprites scattered on the grid, each matching one hub edge color.\n\n    Rule:\n    - For each hub edge color, find the matching sprite outside the hub.\n    - Rotate the sprite (0/90/180/270°) so its contact edge has exactly N-2 contiguous cells aligned with the hub side, and the rotated sprite is mirror-symmetric along the contact-edge axis (UD for left/right, LR for top/bottom).\n    - Translate it to adjoin that hub side. \n    - Clear everything else to bg; output is hub + attached sprites only.\n\n    Key insight: Each edge color uniquely pairs a sprite to a side; symmetry along the contact-edge axis disambiguates the correct rotation.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def _find_hub():\n        best = None  # (score, (r,c,n), (top,bot,left,right))\n        for n in range(3, 7):\n            for r in range(0, int(H - n + 1)):\n                for c in range(0, int(W - n + 1)):\n                    # corners must be bg\n                    if (\n                        int(g[int(r), int(c)]) != int(bg)\n                        or int(g[int(r), int(c + n - 1)]) != int(bg)\n                        or int(g[int(r + n - 1), int(c)]) != int(bg)\n                        or int(g[int(r + n - 1), int(c + n - 1)]) != int(bg)\n                    ):\n                        continue\n                    inner = g[int(r + 1) : int(r + n - 1), int(c + 1) : int(c + n - 1)]\n                    if not bool((inner == int(bg)).all()):\n                        continue\n\n                    top = g[int(r), int(c + 1) : int(c + n - 1)]\n                    bot = g[int(r + n - 1), int(c + 1) : int(c + n - 1)]\n                    left = g[int(r + 1) : int(r + n - 1), int(c)]\n                    right = g[int(r + 1) : int(r + n - 1), int(c + n - 1)]\n\n                    if bool((top == int(bg)).any()) or bool((bot == int(bg)).any()) or bool((left == int(bg)).any()) or bool((right == int(bg)).any()):\n                        continue\n                    if (\n                        len(set(map(int, top))) != 1\n                        or len(set(map(int, bot))) != 1\n                        or len(set(map(int, left))) != 1\n                        or len(set(map(int, right))) != 1\n                    ):\n                        continue\n\n                    cr = float(r + (n - 1) / 2)\n                    cc = float(c + (n - 1) / 2)\n                    score = abs(float(cr - (H - 1) / 2)) + abs(float(cc - (W - 1) / 2))\n                    cand = (\n                        float(score),\n                        (int(r), int(c), int(n)),\n                        (int(top[0]), int(bot[0]), int(left[0]), int(right[0])),\n                    )\n                    if best is None or float(cand[0]) < float(best[0]):\n                        best = cand\n        return best\n\n    hub = _find_hub()\n    assert not (hub is None)\n\n    _score, (r, c, n), (top_col, bot_col, left_col, right_col) = hub\n    hub_mask = np.zeros((H, W), dtype=bool)\n    hub_mask[int(r) : int(r + n), int(c) : int(c + n)] = True\n\n    out = np.full_like(g, int(bg))\n    out[int(r) : int(r + n), int(c) : int(c + n)] = g[int(r) : int(r + n), int(c) : int(c + n)]\n\n    target = int(n - 2)  # length of the hub edge segment (excluding corners)\n\n    def _crop_to_mask(arr: np.ndarray, mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:\n        pts = np.argwhere(mask)\n        r0, c0, r1, c1 = bbox_coords(pts)\n        return arr[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1], mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]\n\n    def _edge_segment(mask: np.ndarray, side: str):\n        pts = np.argwhere(mask)\n        if pts.size == 0:\n            return None\n        if side == \"top\":\n            rr = int(pts[:, 0].min())\n            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n            return (\"h\", int(rr), cols)\n        if side == \"bot\":\n            rr = int(pts[:, 0].max())\n            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n            return (\"h\", int(rr), cols)\n        if side == \"left\":\n            cc = int(pts[:, 1].min())\n            rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n            return (\"v\", int(cc), rows)\n        if side == \"right\":\n            cc = int(pts[:, 1].max())\n            rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n            return (\"v\", int(cc), rows)\n        return None\n\n    def _is_contig(seq: list[int]) -> bool:\n        return bool(seq) and all(int(seq[i]) + 1 == int(seq[i + 1]) for i in range(len(seq) - 1))\n\n    # desired attachment geometry: adjacent (touching) the hub side segment\n    segs = {\n        \"top\": (int(top_col), (\"bot\", int(r - 1), list(range(int(c + 1), int(c + n - 1))))),\n        \"bot\": (int(bot_col), (\"top\", int(r + n), list(range(int(c + 1), int(c + n - 1))))),\n        \"left\": (int(left_col), (\"right\", int(c - 1), list(range(int(r + 1), int(r + n - 1))))),\n        \"right\": (int(right_col), (\"left\", int(c + n), list(range(int(r + 1), int(r + n - 1))))),\n    }\n\n    for _side, (col, (need_edge, fixed, span)) in segs.items():\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n","exit_code":0,"status":"completed"}}
