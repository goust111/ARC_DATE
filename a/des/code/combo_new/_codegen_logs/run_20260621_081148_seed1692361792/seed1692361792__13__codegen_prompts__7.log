{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n\n    Input structure:\n    - The grid has a dominant background color.\n    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n\n    Rule:\n    - Keep the input pixels unchanged.\n    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n\n    Key insight:\n    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    out = g.copy()\n    h, w = g.shape\n\n    markers: dict[int, int] = {}\n    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n            continue\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n        source = int(sub[0, 0])\n        halo = int(sub[0, 1])\n        assert source != halo, \"legend source and halo colors must differ\"\n        assert source not in markers, \"each source color must have exactly one legend marker\"\n\n        markers[source] = halo\n        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n\n    assert markers, \"expected at least one left-edge legend marker\"\n\n    for source, halo in markers.items():\n        objects = []\n        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n            if cells <= marker_source_cells[source]:\n                continue\n            objects.append(comp)\n        assert objects, \"each legend source color must label at least one non-marker object\"\n\n        for obj in objects:\n            r0, c0, r1, c1 = obj[\"bbox\"]\n            pr0 = max(0, int(r0) - 1)\n            pc0 = max(0, int(c0) - 1)\n            pr1 = min(h - 1, int(r1) + 1)\n            pc1 = min(w - 1, int(c1) + 1)\n\n            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n            coords = obj[\"coords\"]\n            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n            enclosed = object_interior(patch, background=bg)\n            fill_mask = (patch == bg) & ~enclosed\n\n            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n            target[fill_mask] = halo\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and color palette.\nBACKGROUND = 0\nGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\nAVAILABLE_COLORS = tuple(range(1, 10))\n\n# Legend layout.\nLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\nLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n\n# Sprite geometry and acceptance.\nSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\nSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\nSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\nSPRITE_RETRIES = 300\n\n# Object counts and placement.\nINSTANCE_MIN, INSTANCE_MAX = 1, 3\nOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\nEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\nPLACEMENT_RETRIES = 200\n\n# Whole-sample retry budget.\nGENERATION_RETRIES = 300\n\n\ndef _make_sprite(color):\n    \"\"\"Construct one LR-symmetric 4-connected sprite matching the configured area/hole bounds.\"\"\"\n    target_area = random.randint(SPRITE_AREA_MIN, SPRITE_AREA_MAX)\n    for _ in range(SPRITE_RETRIES):\n        fill_p = target_area / (SPRITE_SIZE * SPRITE_SIZE) + random.uniform(-SPRITE_FILL_JITTER, SPRITE_FILL_JITTER)\n        sprite = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=int)\n        for r in range(SPRITE_SIZE):\n            for c in range(SPRITE_MIRROR_COLS):\n                if random.random() < fill_p:\n                    sprite[r, c] = color\n                    sprite[r, SPRITE_SIZE - 1 - c] = color\n        area = int(np.count_nonzero(sprite))\n        if area != target_area:\n            continue\n        if not is_contiguous(sprite, background=BACKGROUND, connectivity=4):\n            continue\n        if not (np.any(sprite[0] != BACKGROUND) and np.any(sprite[-1] != BACKGROUND) and\n                np.any(sprite[:, 0] != BACKGROUND) and np.any(sprite[:, -1] != BACKGROUND)):\n            continue\n        padded = np.zeros((SPRITE_SIZE + 2, SPRITE_SIZE + 2), dtype=int)\n        padded[1:-1, 1:-1] = sprite\n        interior = object_interior(padded, background=BACKGROUND)\n        holes = int(np.sum(interior & (padded == BACKGROUND)))\n        if holes > MAX_INTERIOR_HOLES:\n            continue\n        return sprite\n    return None\n\n\ndef _boxes_overlap(a, b):\n    return a[0] <= b[2] and a[2] >= b[0] and a[1] <= b[3] and a[3] >= b[1]\n\n\ndef _draw_legend(grid, src1, halo1, src2, halo2):\n    lower_top = grid.shape[0] - LEGEND_MARKER_SIZE\n    upper_top = lower_top - LEGEND_VERTICAL_GAP - LEGEND_MARKER_SIZE\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src1\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo1\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src2\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo2\n    return (upper_top, LEGEND_SOURCE_COL, grid.shape[0] - 1, LEGEND_HALO_COL)\n\n\ndef _visible_window(sprite, size, r0, c0):\n    \"\"\"Return the visible grid bbox and matching sprite slice for a possibly clipped sprite.\"\"\"\n    vr0, vc0 = max(0, r0), max(0, c0)\n    vr1 = min(size - 1, r0 + SPRITE_SIZE - 1)\n    vc1 = min(size - 1, c0 + SPRITE_SIZE - 1)\n    visible = sprite[vr0 - r0:vr1 - r0 + 1, vc0 - c0:vc1 - c0 + 1]\n    return (vr0, vc0, vr1, vc1), visible\n\n\ndef _padded_bbox(visible_box, size):\n    vr0, vc0, vr1, vc1 = visible_box\n    return (max(0, vr0 - HALO_PADDING), max(0, vc0 - HALO_PADDING),\n            min(size - 1, vr1 + HALO_PADDING), min(size - 1, vc1 + HALO_PADDING))\n\n\ndef _place_objects(size, tasks, legend_box):\n    \"\"\"Choose non-overlapping object origins; returns placement tuples or None on retry exhaustion.\"\"\"\n    placed = []\n    placements = []\n    for sprite, sc, hc in tasks:\n        for _ in range(PLACEMENT_RETRIES):\n            if random.random() < EDGE_CLIP_PROB:\n                r0 = random.randint(-EDGE_CLIP_MARGIN, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n            else:\n                r0 = random.randint(0, size - SPRITE_SIZE)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE)\n            visible_box, visible = _visible_window(sprite, size, r0, c0)\n            if np.count_nonzero(visible) == 0:\n                continue\n\n            pbox = _padded_bbox(visible_box, size)\n            if (pbox[1] < OBJECT_MIN_COL or _boxes_overlap(pbox, legend_box) or\n                    any(_boxes_overlap(pbox, eb) for eb in placed)):\n                continue\n\n            placed.append(pbox)\n            placements.append((sprite, sc, hc, r0, c0))\n            break\n        else:\n            return None\n    return placements\n\n\ndef _render_output(grid, placements):\n    \"\"\"Render the paired output and return the generated input with halo-fill cells removed.\"\"\"\n    size = grid.shape[0]\n    output = grid.copy()\n    halo_mask = np.zeros((size, size), dtype=bool)\n\n    for sprite, sc, hc, r0, c0 in placements:\n        visible_box, visible = _visible_window(sprite, size, r0, c0)\n        vr0, vc0, vr1, vc1 = visible_box\n        output_region = output[vr0:vr1 + 1, vc0:vc1 + 1]\n        output_region[visible != BACKGROUND] = sc\n\n        pr0, pc0, pr1, pc1 = _padded_bbox(visible_box, size)\n        patch = np.zeros((pr1 - pr0 + 1, pc1 - pc0 + 1), dtype=int)\n        patch_region = patch[vr0 - pr0:vr1 - pr0 + 1, vc0 - pc0:vc1 - pc0 + 1]\n        patch_region[visible != BACKGROUND] = sc\n\n        enclosed = object_interior(patch, background=BACKGROUND)\n        fill = (patch == BACKGROUND) & ~enclosed\n        output_region = output[pr0:pr1 + 1, pc0:pc1 + 1]\n        output_region[fill] = hc\n        halo_region = halo_mask[pr0:pr1 + 1, pc0:pc1 + 1]\n        halo_region[fill] = True\n\n    inp = output.copy()\n    inp[halo_mask] = BACKGROUND\n    return inp, output\n\n\ndef _matches_oracle(inp, output):\n    try:\n        return np.array_equal(main(inp), output)\n    except Exception:\n        return False\n\n\ndef _gen_attempt():\n    sz = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    colors = list(AVAILABLE_COLORS)\n    random.shuffle(colors)\n    src1, halo1, src2, halo2 = colors[:4]\n\n    sprite1 = _make_sprite(src1)\n    sprite2 = _make_sprite(src2)\n    if sprite1 is None or sprite2 is None:\n        return None\n\n    n1 = random.randint(INSTANCE_MIN, INSTANCE_MAX)\n    n2 = random.randint(INSTANCE_MIN, INSTANCE_MAX)\n    tasks = [(sprite1, src1, halo1)] * n1 + [(sprite2, src2, halo2)] * n2\n    random.shuffle(tasks)\n\n    grid = np.zeros((sz, sz), dtype=int)\n    legend_box = _draw_legend(grid, src1, halo1, src2, halo2)\n\n    placements = _place_objects(sz, tasks, legend_box)\n    if placements is None:\n        return None\n\n    inp, output = _render_output(grid, placements)\n    if _matches_oracle(inp, output):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/9b5080bb.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/9b5080bb.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor the small defect bars on each shared-color object with the opposite panel color.\n\n    Input structure\n    - The grid contains two large panel colors and one shared object color.\n    - Each shared-color object is a mostly solid rectangle inside exactly one panel.\n    Rule\n    - Find the near-solid rectangular core of each object.\n    - Missing core pixels and one-cell protrusions define two-pixel bars perpendicular to the nearest core edge.\n    - Recolor those bars with the other panel color; leave all other pixels unchanged.\n    Key insight\n    - The colors to add are not tied to numeric ids: each object's surrounding panel identifies the opposite panel color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = g.copy()\n\n    object_color, components, panel_colors = _object_components(g)\n    for coords in components:\n        neighbors = _neighbor_colors(g, coords, object_color)\n        assert len(neighbors) == 1\n        panel_color = next(iter(neighbors))\n        target_colors = panel_colors - {panel_color}\n        assert len(target_colors) == 1\n        target_color = next(iter(target_colors))\n\n        rect = _core_rect(coords)\n        for r, c in _defect_bar_cells(coords, rect):\n            assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1]\n            assert int(g[r, c]) in {object_color, panel_color}\n            out[r, c] = target_color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Palette and canvas bounds.\nCOLOR_IDS = list(range(10))\nGRID_SIZE_MIN = 20\nGRID_SIZE_MAX = 27\n\n# Panel layout bounds and options.\nMIN_PANEL_DIM = 9\nMIN_VISIBLE_BORDERS = 2\nBORDER_CHOICES = (0, 1)\nOFFSET_MIN = 2\nOFFSET_MAX = 6\nHORIZONTAL_LAYOUT = 0\nVERTICAL_LAYOUT = 1\nHORIZONTAL_OFFSETS = (\"left\", \"right\", \"none\")\nVERTICAL_OFFSETS = (\"top\", \"bottom\", \"none\")\n\n# Object geometry and placement constraints.\nOBJECTS_PER_PANEL = (1, 2)\nCORE_H_MIN = 3\nCORE_H_MAX = 7\nCORE_W_MIN = 3\nCORE_W_MAX = 9\nDEFECT_COUNT_MIN = 1\nDEFECT_COUNT_MAX = 3\nDEFECT_SIDES = (\"top\", \"bottom\", \"left\", \"right\")\nDEFECT_TYPES = (\"missing\", \"protrusion\")\nPANEL_MARGIN = 1\nOBJECT_GAP = 2\nMAX_PLACE_TRIES = 30\n\n# Generation retry budget.\nMAX_GENERATE_ATTEMPTS = 300\n\n\ndef _choose_palette() -> tuple[int, int, int, int]:\n    colors = COLOR_IDS[:]\n    random.shuffle(colors)\n    return tuple(colors[:4])\n\n\ndef _choose_borders() -> tuple[int, int, int, int]:\n    borders = [random.choice(BORDER_CHOICES) for _ in range(4)]\n    while sum(borders) < MIN_VISIBLE_BORDERS:\n        borders[random.randint(0, 3)] = 1\n    return tuple(borders)\n\n\ndef _build_horizontal_panels(\n    grid: np.ndarray,\n    panel_a_color: int,\n    panel_b_color: int,\n) -> list[tuple[int, int, int, int, int]] | None:\n    \"\"\"Create two panels sharing a horizontal border; returns panel records.\"\"\"\n    H, W = grid.shape\n    split_r = random.randint(MIN_PANEL_DIM, H - MIN_PANEL_DIM - 1)\n    border_top, border_bot, border_left, border_right = _choose_borders()\n\n    pa_height = split_r - border_top\n    pb_height = H - border_bot - split_r\n    if pa_height < MIN_PANEL_DIM or pb_height < MIN_PANEL_DIM:\n        return None\n\n    offset_side = random.choice(HORIZONTAL_OFFSETS)\n    if offset_side == \"none\":\n        pa_c0, pa_c1 = border_left, W - 1 - border_right\n        pb_c0, pb_c1 = border_left, W - 1 - border_right\n    elif offset_side == \"left\":\n        offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_c0 = border_left\n            pa_c1 = W - 1 - border_right\n            pb_c0 = border_left + offset_cols\n            pb_c1 = W - 1 - border_right\n        else:\n            pa_c0 = border_left + offset_cols\n            pa_c1 = W - 1 - border_right\n            pb_c0 = border_left\n            pb_c1 = W - 1 - border_right\n    else:\n        offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_c0 = border_left\n            pa_c1 = W - 1 - border_right - offset_cols\n            pb_c0 = border_left\n            pb_c1 = W - 1 - border_right\n        else:\n            pa_c0 = border_left\n            pa_c1 = W - 1 - border_right\n            pb_c0 = border_left\n            pb_c1 = W - 1 - border_right - offset_cols\n\n    if pa_c1 - pa_c0 + 1 < MIN_PANEL_DIM or pb_c1 - pb_c0 + 1 < MIN_PANEL_DIM:\n        return None\n    if min(pa_c1, pb_c1) < max(pa_c0, pb_c0):\n        return None\n\n    pa_r0, pa_r1 = border_top, split_r - 1\n    pb_r0, pb_r1 = split_r, H - 1 - border_bot\n    grid[pa_r0:pa_r1 + 1, pa_c0:pa_c1 + 1] = panel_a_color\n    grid[pb_r0:pb_r1 + 1, pb_c0:pb_c1 + 1] = panel_b_color\n    return [\n        (panel_a_color, pa_r0, pa_r1, pa_c0, pa_c1),\n        (panel_b_color, pb_r0, pb_r1, pb_c0, pb_c1),\n    ]\n\n\ndef _build_vertical_panels(\n    grid: np.ndarray,\n    panel_a_color: int,\n    panel_b_color: int,\n) -> list[tuple[int, int, int, int, int]] | None:\n    \"\"\"Create two panels sharing a vertical border; returns panel records.\"\"\"\n    H, W = grid.shape\n    split_c = random.randint(MIN_PANEL_DIM, W - MIN_PANEL_DIM - 1)\n    border_top, border_bot, border_left, border_right = _choose_borders()\n\n    pa_width = split_c - border_left\n    pb_width = W - border_right - split_c\n    if pa_width < MIN_PANEL_DIM or pb_width < MIN_PANEL_DIM:\n        return None\n\n    offset_side = random.choice(VERTICAL_OFFSETS)\n    if offset_side == \"none\":\n        pa_r0, pa_r1 = border_top, H - 1 - border_bot\n        pb_r0, pb_r1 = border_top, H - 1 - border_bot\n    elif offset_side == \"top\":\n        offset_rows = random.randint(OFFSET_MIN, min(OFFSET_MAX, H - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_r0, pa_r1 = border_top, H - 1 - border_bot\n            pb_r0, pb_r1 = border_top + offset_rows, H - 1 - border_bot\n        else:\n            pa_r0, pa_r1 = border_top + offset_rows, H - 1 - border_bot\n            pb_r0, pb_r1 = border_top, H - 1 - border_bot\n    else:\n        offset_rows = random.randint(OFFSET_MIN, min(OFFSET_MAX, H - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_r0, pa_r1 = border_top, H - 1 - border_bot - offset_rows\n            pb_r0, pb_r1 = border_top, H - 1 - border_bot\n        else:\n            pa_r0, pa_r1 = border_top, H - 1 - border_bot\n            pb_r0, pb_r1 = border_top, H - 1 - border_bot - offset_rows\n\n    pa_c0, pa_c1 = border_left, split_c - 1\n    pb_c0, pb_c1 = split_c, W - 1 - border_right\n    if pa_r1 - pa_r0 + 1 < MIN_PANEL_DIM or pb_r1 - pb_r0 + 1 < MIN_PANEL_DIM:\n        return None\n    if min(pa_r1, pb_r1) < max(pa_r0, pb_r0):\n        return None\n\n    grid[pa_r0:pa_r1 + 1, pa_c0:pa_c1 + 1] = panel_a_color\n    grid[pb_r0:pb_r1 + 1, pb_c0:pb_c1 + 1] = panel_b_color\n    return [\n        (panel_a_color, pa_r0, pa_r1, pa_c0, pa_c1),\n        (panel_b_color, pb_r0, pb_r1, pb_c0, pb_c1),\n    ]\n\n\ndef _make_panel_grid(\n    panel_a_color: int,\n    panel_b_color: int,\n    bg_color: int,\n) -> tuple[np.ndarray, list[tuple[int, int, int, int, int]]] | None:\n    \"\"\"Sample the canvas and panel layout.\"\"\"\n    H = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    W = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    grid = np.full((H, W), bg_color, dtype=int)\n\n    orientation = random.randint(HORIZONTAL_LAYOUT, VERTICAL_LAYOUT)\n    if orientation == HORIZONTAL_LAYOUT:\n        panels = _build_horizontal_panels(grid, panel_a_color, panel_b_color)\n    else:\n        panels = _build_vertical_panels(grid, panel_a_color, panel_b_color)\n    if panels is None:\n        return None\n    return grid, panels\n\n\ndef _object_overlaps(full_bbox: tuple[int, int, int, int], placed_bboxes: list[tuple[int, int, int, int]]) -> bool:\n    full_r0, full_r1, full_c0, full_c1 = full_bbox\n    for br0, br1, bc0, bc1 in placed_bboxes:\n        if (\n            full_r0 - OBJECT_GAP <= br1\n            and full_r1 + OBJECT_GAP >= br0\n            and full_c0 - OBJECT_GAP <= bc1\n            and full_c1 + OBJECT_GAP >= bc0\n        ):\n            return True\n    return False\n\n\ndef _place_core(\n    panel_bbox: tuple[int, int, int, int],\n    core_h: int,\n    core_w: int,\n    sides: list[str],\n    placed_bboxes: list[tuple[int, int, int, int]],\n) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int]] | None:\n    \"\"\"Find a non-overlapping core bbox and its full bbox including bars.\"\"\"\n    pr0, pr1, pc0, pc1 = panel_bbox\n    extra_top = 1 if \"top\" in sides else 0\n    extra_bot = 1 if \"bottom\" in sides else 0\n    extra_left = 1 if \"left\" in sides else 0\n    extra_right = 1 if \"right\" in sides else 0\n\n    place_r0 = pr0 + PANEL_MARGIN + extra_top\n    place_r1 = pr1 - PANEL_MARGIN - extra_bot - core_h + 1\n    place_c0 = pc0 + PANEL_MARGIN + extra_left\n    place_c1 = pc1 - PANEL_MARGIN - extra_right - core_w + 1\n    if place_r1 < place_r0 or place_c1 < place_c0:\n        return None\n\n    for _ in range(MAX_PLACE_TRIES):\n        cr0 = random.randint(place_r0, place_r1)\n        cc0 = random.randint(place_c0, place_c1)\n        cr1 = cr0 + core_h - 1\n        cc1 = cc0 + core_w - 1\n        full_bbox = (cr0 - extra_top, cr1 + extra_bot, cc0 - extra_left, cc1 + extra_right)\n        if not _object_overlaps(full_bbox, placed_bboxes):\n            return (cr0, cr1, cc0, cc1), full_bbox\n    return None\n\n\ndef _apply_defect(\n    input_grid: np.ndarray,\n    output_grid: np.ndarray,\n    core_bbox: tuple[int, int, int, int],\n    side: str,\n    defect_type: str,\n    panel_color: int,\n    obj_color: int,\n    other_panel_color: int,\n) -> bool:\n    \"\"\"Apply one sampled input defect and its two-cell output bar.\"\"\"\n    cr0, cr1, cc0, cc1 = core_bbox\n    if side == \"top\":\n        if defect_type == \"missing\":\n            valid_cols = list(range(cc0 + 1, cc1))\n            if not valid_cols:\n                return False\n            dc = random.choice(valid_cols)\n            dr = cr0\n            input_grid[dr, dc] = panel_color\n            output_grid[dr - 1, dc] = other_panel_color\n            output_grid[dr, dc] = other_panel_color\n        else:\n            dc = random.randint(cc0, cc1)\n            dr = cr0 - 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr + 1, dc] = other_panel_color\n    elif side == \"bottom\":\n        if defect_type == \"missing\":\n            valid_cols = list(range(cc0 + 1, cc1))\n            if not valid_cols:\n                return False\n            dc = random.choice(valid_cols)\n            dr = cr1\n            input_grid[dr, dc] = panel_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr + 1, dc] = other_panel_color\n        else:\n            dc = random.randint(cc0, cc1)\n            dr = cr1 + 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr - 1, dc] = other_panel_color\n    elif side == \"left\":\n        if defect_type == \"missing\":\n            valid_rows = list(range(cr0 + 1, cr1))\n            if not valid_rows:\n                return False\n            dr = random.choice(valid_rows)\n            dc = cc0\n            input_grid[dr, dc] = panel_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc - 1] = other_panel_color\n        else:\n            dr = random.randint(cr0, cr1)\n            dc = cc0 - 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc + 1] = other_panel_color\n    else:\n        if defect_type == \"missing\":\n            valid_rows = list(range(cr0 + 1, cr1))\n            if not valid_rows:\n                return False\n            dr = random.choice(valid_rows)\n            dc = cc1\n            input_grid[dr, dc] = panel_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc + 1] = other_panel_color\n        else:\n            dr = random.randint(cr0, cr1)\n            dc = cc1 + 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc - 1] = other_panel_color\n    return True\n\n\ndef _place_panel_objects(\n    input_grid: np.ndarray,\n    output_grid: np.ndarray,\n    panel: tuple[int, int, int, int, int],\n    n_objs: int,\n    obj_color: int,\n    other_panel_color: int,\n) -> bool:\n    \"\"\"Place all objects for one panel into input and output grids.\"\"\"\n    panel_color, pr0, pr1, pc0, pc1 = panel\n    avail_r0 = pr0 + PANEL_MARGIN\n    avail_r1 = pr1 - PANEL_MARGIN\n    avail_c0 = pc0 + PANEL_MARGIN\n    avail_c1 = pc1 - PANEL_MARGIN\n    placed_bboxes = []\n\n    for _ in range(n_objs):\n        core_h = random.randint(CORE_H_MIN, min(CORE_H_MAX, avail_r1 - avail_r0 - 2))\n        core_w = random.randint(CORE_W_MIN, min(CORE_W_MAX, avail_c1 - avail_c0 - 2))\n        if core_h < CORE_H_MIN or core_w < CORE_W_MIN:\n            return False\n\n        n_defects = random.randint(DEFECT_COUNT_MIN, DEFECT_COUNT_MAX)\n        sides = random.sample(DEFECT_SIDES, n_defects)\n        defect_types = [random.choice(DEFECT_TYPES) for _ in range(n_defects)]\n\n        placed = _place_core((pr0, pr1, pc0, pc1), core_h, core_w, sides, placed_bboxes)\n        if placed is None:\n            return False\n        core_bbox, full_bbox = placed\n        placed_bboxes.append(full_bbox)\n\n        cr0, cr1, cc0, cc1 = core_bbox\n        output_grid[cr0:cr1 + 1, cc0:cc1 + 1] = obj_color\n        input_grid[cr0:cr1 + 1, cc0:cc1 + 1] = obj_color\n\n        for side, defect_type in zip(sides, defect_types):\n            if not _apply_defect(\n                input_grid,\n                output_grid,\n                core_bbox,\n                side,\n                defect_type,\n                panel_color,\n                obj_color,\n                other_panel_color,\n            ):\n                return False\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    obj_color, panel_a_color, panel_b_color, bg_color = _choose_palette()\n    layout = _make_panel_grid(panel_a_color, panel_b_color, bg_color)\n    if layout is None:\n        return None\n    grid, panels = layout\n\n    n_obj_a = random.choice(OBJECTS_PER_PANEL)\n    n_obj_b = random.choice(OBJECTS_PER_PANEL)\n    if not 2 <= n_obj_a + n_obj_b <= 4:\n        return None\n\n    output_grid = grid.copy()\n    input_grid = grid.copy()\n    object_counts = (n_obj_a, n_obj_b)\n    other_colors = (panel_b_color, panel_a_color)\n\n    for panel, n_objs, other_panel_color in zip(panels, object_counts, other_colors):\n        if not _place_panel_objects(\n            input_grid,\n            output_grid,\n            panel,\n            n_objs,\n            obj_color,\n            other_panel_color,\n        ):\n            return None\n\n    # Verify: run solver on input and check it produces the output\n    try:\n        result = main(input_grid)\n        if np.array_equal(result, output_grid):\n            return input_grid\n    except (AssertionError, IndexError, ValueError):\n        pass\n\n    return None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
