\n    48\t    h, w = g.shape\n    49\t\n    50\t    raw_rows = [r for r in range(h) if not np.any(g[r] == BG)]\n    51\t    raw_cols = [c for c in range(w) if not np.any(g[:, c] == BG)]\n    52\t    assert len(raw_rows) >= 2 and len(raw_cols) >= 2\n    53\t\n    54\t    border_values: list[int] = []\n    55\t    for r in raw_rows:\n    56\t        border_values.extend(int(v) for v in g[r] if int(v) != BG)\n    57\t    for c in raw_cols:\n    58\t        border_values.extend(int(v) for v in g[:, c] if int(v) != BG)\n    59\t    separator = Counter(border_values).most_common(1)[0][0]\n    60\t\n    61\t    rows = [r for r in raw_rows if int(np.count_nonzero(g[r] == separator)) > w // 2]\n    62\t    cols = [c for c in raw_cols if int(np.count_nonzero(g[:, c] == separator)) > h // 2]\n    63\t\n    64\t    assert rows[0] == 0 and rows[-1] == h - 1\n    65\t    assert cols[0] == 0 and cols[-1] == w - 1\n    66\t    assert all(b - a >= 2 for a, b in zip(rows, rows[1:]))\n    67\t    assert all(b - a >= 2 for a, b in zip(cols, cols[1:]))\n    68\t    return int(separator), rows, cols\n    69\t\n    70\t\n    71\tdef _collect_labels(\n    72\t    grid: np.ndarray,\n    73\t    coords: list[tuple[int, int]],\n    74\t    separator: int,\n    75\t) -> list[tuple[int, int, int]]:\n    76\t    labels: list[tuple[int, int, int]] = []\n    77\t    for r, c in coords:\n    78\t        value = int(grid[r, c])\n    79\t        if value not in (BG, separator):\n    80\t            labels.append((r, c, value))\n    81\t    return labels\n    82\t\n    83\t\n    84\tdef _regions(grid: np.ndarray) -> tuple[int, list[int], list[int], list[dict[str, object]]]:\n    85\t    g = np.asarray(grid, dtype=int)\n    86\t    separator, sep_rows, sep_cols = _separator_structure(g)\n    87\t    regions: list[dict[str, object]] = []\n    88\t\n    89\t    for ri, (top, bottom) in enumerate(zip(sep_rows, sep_rows[1:])):\n    90\t        for ci, (left, right) in enumerate(zip(sep_cols, sep_cols[1:])):\n    91\t            top_side = [(top, c) for c in range(left + 1, right)]\n    92\t            bottom_side = [(bottom, c) for c in range(left + 1, right)]\n    93\t            left_side = [(r, left) for r in range(top + 1, bottom)]\n    94\t            right_side = [(r, right) for r in range(top + 1, bottom)]\n    95\t\n    96\t            senders = _collect_labels(g, top_side + left_side, separator)\n    97\t            receivers = _collect_labels(g, bottom_side + right_side, separator)\n    98\t            assert len(senders) == 1\n    99\t            assert len(receivers) == 1\n   100\t\n   101\t            patch = g[top + 1 : bottom, left + 1 : right].copy()\n   102\t            assert not np.any(patch == separator)\n   103\t\n   104\t            regions.append(\n   105\t                {\n   106\t                    \"row\": int(ri),\n   107\t                    \"col\": int(ci),\n   108\t                    \"inner_top\": int(top + 1),\n   109\t                    \"inner_left\": int(left + 1),\n   110\t                    \"inner_h\": int(bottom - top - 1),\n   111\t                    \"inner_w\": int(right - left - 1),\n   112\t                    \"send\": int(senders[0][2]),\n   113\t                    \"receive\": int(receivers[0][2]),\n   114\t                    \"patch\": patch,\n   115\t                }\n   116\t            )\n   117\t\n   118\t    assert regions\n   119\t    return separator, sep_rows, sep_cols, regions\n   120\t\n   121\t\n   122\tdef _solve(grid: np.ndarray) -> np.ndarray:\n   123\t    g = np.asarray(grid, dtype=int)\n   124\t    separator, sep_rows, sep_cols, regions = _regions(g)\n   125\t\n   126\t    send_to_region: dict[int, int] = {}\n   127\t    receive_to_region: dict[int, int] = {}\n   128\t    for idx, region in enumerate(regions):\n   129\t        send_color = int(region[\"send\"])\n   130\t        receive_color = int(region[\"receive\"])\n   131\t        assert send_color != receive_color\n   132\t        assert send_color not in send_to_region\n   133\t        assert receive_color not in receive_to_region\n   134\t        send_to_region[send_color] = int(idx)\n   135\t        receive_to_region[receive_color] = int(idx)\n   136\t\n   137\t    assert set(send_to_region) == set(receive_to_region)\n   138\t\n   139\t    out = np.full_like(g, BG)\n   140\t    out[sep_rows, :] = separator\n   141\t    out[:, sep_cols] = separator\n   142\t\n   143\t    for region in regions:\n   144\t        target = regions[receive_to_region[int(region[\"send\"])]]\n   145\t        patch = np.asarray(region[\"patch\"], dtype=int)\n   146\t        target_h = int(target[\"inner_h\"])\n   147\t        target_w = int(target[\"inner_w\"])\n   148\t        for dr, dc in np.argwhere(patch != BG):\n   149\t            dr = int(dr)\n   150\t            dc = int(dc)\n   151\t            assert dr < target_h and dc < target_w\n   152\t            out[int(target[\"inner_top\"]) + dr, int(target[\"inner_left\"]) + dc] = int(patch[dr, dc])\n   153\t\n   154\t    return out\n   155\t\n   156\t\n   157\tdef main(grid: np.ndarray) -> np.ndarray:\n   158\t    \"\"\"\n   159\t    Reroute each subregion's interior pattern to the region whose receive label matches its send label.\n   160\t\n   161\t    Input structure:\n   162\t    - Black background with a full grey outer frame and full grey separator rows and columns that partition the canvas into a rectangular grid of subregions.\n   163\t    - Each subregion contains one non-black, non-grey foreground pattern inside its interior.\n   164\t    - Each subregion border has exactly two single-pixel colored labels placed on grey border cells.\n   165\t    - A label on the top or left border is that region's send label, while a label on the bottom or right border is its receive label.\n   166\t\n   167\t    Rule:\n   168\t    - Detect the grey separator lattice and split the grid into rectangular subregions.\n   169\t    - Read each region's send-label color from its top/left border and its receive-label color from its bottom/right border.\n   170\t    - For every region A, find the unique region B whose receive-label color equals A's send-label color.\n   171\t    - Copy A's interior pattern into B while preserving the pattern's exact color, shape, and offset relative to the subregion's top-left corner.\n   172\t    - Restore all label pixels to grey and keep the grey separator lattice unchanged.\n   173\t\n   174\t    Key insight:\n   175\t    - The colored border pixels are routing markers rather than part of the shapes: border position determines send versus receive, and matching label colors determines where each pattern must move.\n   176\t    \"\"\"\n   177\t    return _solve(np.asarray(grid, dtype=int))\n   178\t\n   179\t\n   180\tdef _balanced_sides(count: int, first: str, second: str) -> list[str]:\n   181\t    extra_first = random.choice([True, False])\n   182\t    n_first = count // 2 + int(extra_first and count % 2 == 1)\n   183\t    n_second = count - n_first\n   184\t    sides = [first] * n_first + [second] * n_second\n   185\t    random.shuffle(sides)\n   186\t    return sides\n   187\t\n   188\t\n   189\tdef _random_permutation(n: int) -> list[int]:\n   190\t    indices = list(range(n))\n   191\t    random.shuffle(indices)\n   192\t\n   193\t    if random.random() < 0.5:\n   194\t        groups = [indices]\n   195\t    else:\n   196\t        cycle_count = random.randint(2, n // 2)\n   197\t        sizes = [2] * cycle_count\n   198\t        for _ in range(n - 2 * cycle_count):\n   199\t            sizes[random.randrange(cycle_count)] += 1\n   200\t        random.shuffle(sizes)\n   201\t        groups = []\n   202\t        cursor = 0\n   203\t        for size in sizes:\n   204\t            groups.append(indices[cursor : cursor + size])\n   205\t            cursor += size\n   206\t\n   207\t    perm = [0] * n\n   208\t    for group in groups:\n   209\t        for src, dst in zip(group, group[1:] + group[:1]):\n   210\t            perm[src] = dst\n   211\t    assert all(i != perm[i] for i in range(n))\n   212\t    return perm\n   213\t\n   214\t\n   215\tdef _random_payload(cell_h: int, cell_w: int, forbidden: set[int]) -> np.ndarray:\n   216\t    valid_shapes = [shape for shape in SHAPES if shape.shape[0] < cell_h and shape.shape[1] < cell_w]\n   217\t    assert valid_shapes\n   218\t    mask = random.choice(valid_shapes)\n   219\t    color_choices = [color for color in PALETTE if color not in forbidden]\n   220\t    color = random.choice(color_choices)\n   221\t\n   222\t    top = random.randint(0, cell_h - mask.shape[0])\n   223\t    left = random.randint(0, cell_w - mask.shape[1])\n   224\t\n   225\t    patch = np.full((cell_h, cell_w), BG, dtype=int)\n   226\t    window = patch[top : top + mask.shape[0], left : left + mask.shape[1]]\n   227\t    window[mask] = int(color)\n   228\t    return patch\n   229\t\n   230\t\n   231\tdef _label_position(\n   232\t    side: str,\n   233\t    top: int,\n   234\t    left: int,\n   235\t    cell_h: int,\n   236\t    cell_w: int,\n   237\t) -> tuple[int, int]:\n   238\t    if side == \"top\":\n   239\t        return top, left + 1 + random.randrange(cell_w)\n   240\t    if side == \"left\":\n   241\t        return top + 1 + random.randrange(cell_h), left\n   242\t    if side == \"bottom\":\n   243\t        return top + cell_h + 1, left + 1 + random.randrange(cell_w)\n   244\t    assert side == \"right\"\n   245\t    return top + 1 + random.randrange(cell_h), left + cell_w + 1\n   246\t\n   247\t\n   248\tdef _render_lattice(rows: int, cols: int, cell_h: int, cell_w: int) -> tuple[np.ndarray, list[tuple[int, int]]]:\n   249\t    height = rows * cell_h + rows + 1\n   250\t    width = cols * cell_w + cols + 1\n   251\t    grid = np.full((height, width), BG, dtype=int)\n   252\t\n   253\t    row_lines = [idx * (cell_h + 1) for idx in range(rows + 1)]\n   254\t    col_lines = [idx * (cell_w + 1) for idx in range(cols + 1)]\n   255\t    grid[row_lines, :] = SEPARATOR\n   256\t    grid[:, col_lines] = SEPARATOR\n   257\t\n   258\t    region_origins: list[tuple[int, int]] = []\n   259\t    for r in range(rows):\n   260\t        for c in range(cols):\n","exit_code":0,"status":"completed"}}
