{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '7,155p;630,700p' /home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble scattered rectangular pieces into a rectangle at an L-marker corner.\n\n    Input structure:\n    - bg = most common color. Non-bg rectangular pieces scattered on the grid.\n    - 3-pixel L-marker (2x2 minus one cell) tags the corner; the gap is the corner cell.\n\n    Rule:\n    - rect_col = most common color across all piece pixels; all outer rectangle edges must be rect_col.\n    - Translate pieces (no rotation) to tile the rectangle; touching edges must match, with rect_col as wildcard.\n\n    Key insight: rect_col acts as wildcard during edge matching — only non-rect_col pixels at shared boundaries must agree.\n    \"\"\"\n    inp = grid\n    g = np.array(inp, dtype=int)\n    GH, GW = g.shape\n\n    bg = int(Counter(map(int, g.flatten())).most_common(1)[0][0])\n\n    # Find marker: a color appearing exactly 3 times forming an L in a 2x2 bbox.\n    cnt = Counter(map(int, g.flatten()))\n    mark = None\n    missing = None\n    mb = None  # marker bbox\n    for col in sorted([c for c, n in cnt.items() if int(c) != int(bg) and int(n) == 3]):\n        pts = [(int(r), int(c)) for r, c in np.argwhere(g == int(col))]\n        rs = [r for r, _ in pts]\n        cs = [c for _, c in pts]\n        r0, r1 = min(rs), max(rs)\n        c0, c1 = min(cs), max(cs)\n        if (r1 - r0) == 1 and (c1 - c0) == 1:\n            all4 = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}\n            miss = list(all4 - set(pts))\n            if len(miss) == 1:\n                mark = int(col)\n                missing = miss[0]\n                mb = (r0, c0, r1, c1)\n                break\n\n    assert not (mark is None or missing is None or mb is None)\n\n    r0, c0, r1, c1 = mb\n    # Rectangle corner is opposite the marker bulk.\n    if missing == (r0, c0):\n        corner = \"BR\"\n    elif missing == (r0, c1):\n        corner = \"BL\"\n    elif missing == (r1, c0):\n        corner = \"TR\"\n    else:\n        corner = \"TL\"\n\n    # Decompose occupied mask (non-bg and non-marker) into rectangles.\n    occ = (g != int(bg)) & (g != int(mark))\n    used = np.zeros_like(occ, dtype=bool)\n    rects = []  # (r, c, h, w, arr)\n    while True:\n        idx = np.argwhere(occ & (~used))\n        if idx.size == 0:\n            break\n        rr, cc = map(int, idx[0])\n        w = 0\n        while cc + w < GW and bool(occ[rr, cc + w]) and (not bool(used[rr, cc + w])):\n            w += 1\n        h = 0\n        while rr + h < GH and bool((occ[rr + h, cc : cc + w] & (~used[rr + h, cc : cc + w])).all()):\n            h += 1\n        used[rr : rr + h, cc : cc + w] = True\n        rects.append((rr, cc, h, w, g[rr : rr + h, cc : cc + w].copy()))\n\n    total_area = int(sum(int(h) * int(w) for _r, _c, h, w, _a in rects))\n\n    # The final rectangle's border/background color.\n    allpix = []\n    for _r, _c, _h, _w, a in rects:\n        allpix.extend(map(int, a.flatten()))\n    rect_col = int(Counter(allpix).most_common(1)[0][0])\n\n    mr, mc = map(int, missing)\n\n    # Anchor piece: the rectangle containing the corner cell.\n    anchor_idx = None\n    for i, (rr, cc, h, w, _a) in enumerate(rects):\n        if rr <= mr < rr + h and cc <= mc < cc + w:\n            anchor_idx = i\n            break\n\n    pieces = [a for _r, _c, _h, _w, a in rects]\n    ph = [int(p.shape[0]) for p in pieces]\n    pw = [int(p.shape[1]) for p in pieces]\n\n    # Candidate rectangle dimensions are factor pairs of total_area that fit in the grid\n    # when anchored at (mr, mc) as the specified corner.\n    dims = []\n    for hh in range(1, int(total_area**0.5) + 1):\n        if total_area % hh == 0:\n            dims.append((hh, total_area // hh))\n            if hh * hh != total_area:\n                dims.append((total_area // hh, hh))\n\n    def fits(H, W):\n        if corner == \"TL\":\n            tr, tc = mr, mc\n        elif corner == \"TR\":\n            tr, tc = mr, mc - W + 1\n        elif corner == \"BL\":\n            tr, tc = mr - H + 1, mc\n        else:  # \"BR\"\n            tr, tc = mr - H + 1, mc - W + 1\n        return 0 <= tr and 0 <= tc and (tr + H) <= GH and (tc + W) <= GW\n\n    dims = [(int(H), int(W)) for H, W in dims if fits(int(H), int(W))]\n    dims = sorted(dims, key=lambda t: (-t[0] * t[1], -t[0], -t[1]))\n\n    def compat(v1, v2):\n        v1 = np.array(v1, dtype=int)\n        v2 = np.array(v2, dtype=int)\n        m = (v1 != int(rect_col)) & (v2 != int(rect_col))\n        return bool((v1[m] == v2[m]).all())\n\n    def assemble(H, W):\n        occ2 = np.full((H, W), -1, dtype=int)\n        usedp = [False] * len(pieces)\n\n        def boundary_ok(a, r, c):\n            h, w = a.shape\n            if r == 0 and not np.all(a[0, :] == int(rect_col)):\n                return False\n            if (r + h) == H and not np.all(a[-1, :] == int(rect_col)):\n                return False\n            if c == 0 and not np.all(a[:, 0] == int(rect_col)):\n                return False\n            if (c + w) == W and not np.all(a[:, -1] == int(rect_col)):\n                return False\n            return True\n\n        def neighbor_ok(a, r, c):\n            h, w = a.shape\n            if c > 0:\n                left = occ2[r : r + h, c - 1]\n                m = left != -1\n                if m.any() and (not compat(left[m], a[:, 0][m])):\n                    return False\n            if (c + w) < W:\n                right = occ2[r : r + h, c + w]\n                m = right != -1\n                if m.any() and (not compat(right[m], a[:, -1][m])):\n                    return False\n\n    # --- place marker ---\n    # Compute marker L cells (3 cells of 2x2 around missing cell)\n    if corner == \"TL\":\n        # missing = (mr, mc), marker bbox = (mr-1, mc-1)-(mr, mc)\n        marker_cells = [(mr - 1, mc - 1), (mr - 1, mc), (mr, mc - 1)]\n    elif corner == \"TR\":\n        marker_cells = [(mr - 1, mc), (mr - 1, mc + 1), (mr, mc + 1)]\n    elif corner == \"BL\":\n        marker_cells = [(mr, mc - 1), (mr + 1, mc - 1), (mr + 1, mc)]\n    else:  # BR\n        marker_cells = [(mr, mc + 1), (mr + 1, mc), (mr + 1, mc + 1)]\n\n    # Check marker cells are in bounds\n    for cr, cc in marker_cells:\n        if cr < 0 or cr >= GH or cc < 0 or cc >= GW:\n            return None\n\n    # --- scatter pieces on grid ---\n    canvas = np.full((GH, GW), bg, dtype=int)\n\n    # Place marker first\n    for cr, cc in marker_cells:\n        canvas[cr, cc] = marker_col\n\n    # Extract piece arrays\n    piece_arrays = []\n    for pr, pc, ph, pw in pieces:\n        piece_arrays.append(rect[pr:pr + ph, pc:pc + pw].copy())\n\n    # Scatter in random order\n    order = list(range(len(piece_arrays)))\n    _r.shuffle(order)\n    for idx in order:\n        pa = piece_arrays[idx]\n        try:\n            r0, c0 = random_free_location(canvas, pa, transparent=bg, padding=1)\n            paste(canvas, pa, r0, c0)\n        except ValueError:\n            return None\n\n    # --- build expected output ---\n    if corner == \"TL\":\n        tr, tc = mr, mc\n    elif corner == \"TR\":\n        tr, tc = mr, mc - RW + 1\n    elif corner == \"BL\":\n        tr, tc = mr - RH + 1, mc\n    else:\n        tr, tc = mr - RH + 1, mc - RW + 1\n\n    expected_out = np.full((GH, GW), bg, dtype=int)\n    expected_out[tr:tr + RH, tc:tc + RW] = rect\n\n    # --- validate with solver ---\n    try:\n        actual_out = main(canvas)\n    except Exception:\n        return None\n    if not np.array_equal(actual_out, expected_out):\n        return None\n\n    return canvas\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '7,145p;540,587p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n    random.shuffle(marker_colors)\n    return marker_colors\n\n\ndef _place_aligned_sprites(out, anchors, marker_colors, bg):\n    \"\"\"Build sprites in their solved locations and return their align metadata.\"\"\"\n    by_color = {a[\"color\"]: a for a in anchors}\n    used_body = set()\n    sprites = []\n    for marker in marker_colors:\n        anchor = by_color[int(marker)]\n        body = _body_color(bg, marker, used_body)\n        used_body.add(body)\n        sprite = _make_sprite(random.randint(*_BODY_AREA_RANGE), body, marker, bg)\n        positions = _aligned_positions(out, sprite, anchor, bg)\n        if not positions:\n            return None\n        marker_pos = random.choice(positions)\n        _place(out, sprite, marker_pos[0], marker_pos[1], bg)\n        sprites.append((sprite, anchor, marker_pos))\n    return sprites\n\n\ndef _scatter_sprites(inp, sprites, bg):\n    \"\"\"Move solved sprites onto the input canvas along the inverse axis.\"\"\"\n    random.shuffle(sprites)\n    for sprite, anchor, marker_pos in sprites:\n        positions = _scatter_positions(inp, sprite, anchor, marker_pos, bg)\n        if not positions:\n            return False\n        in_pos = random.choice(positions)\n        _place(inp, sprite, in_pos[0], in_pos[1], bg)\n    return True\n\n\ndef _generated_grid_is_valid(inp, out, bg):\n    \"\"\"Apply generator invariants and the solver oracle check.\"\"\"\n    if not _bg_is_mode(inp, bg):\n        return False\n    return bool(np.array_equal(main(inp), out))\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 581f7754 input\")\n","exit_code":0,"status":"completed"}}
