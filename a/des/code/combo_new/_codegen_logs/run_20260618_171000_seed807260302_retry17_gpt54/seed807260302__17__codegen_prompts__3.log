{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/e4941b18.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Move red into teal's top marker position, then move teal to the bottom outside corner of the grey rectangle.\n\n    Input structure\n    - The dominant background surrounds one filled rectangular non-background block.\n    - There is exactly one red marker and one teal marker, both in the row immediately above the rectangle.\n    - Both markers are horizontally aligned over columns inside the rectangle.\n\n    Rule\n    - Clear the original red marker.\n    - Recolor the original teal marker cell red.\n    - Place the teal marker beside the rectangle's bottom row, on the side indicated by the horizontal direction from red to teal.\n\n    Key insight\n    - The red-to-teal horizontal order chooses the rectangle side where teal exits at the bottom.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    H, W = g.shape\n    bg = get_bg(g)\n\n    red_coords = np.argwhere(g == Color.RED)\n    teal_coords = np.argwhere(g == Color.TEAL)\n    assert len(red_coords) == 1, \"expected exactly one red marker\"\n    assert len(teal_coords) == 1, \"expected exactly one teal marker\"\n    red_r, red_c = map(int, red_coords[0])\n    teal_r, teal_c = map(int, teal_coords[0])\n\n    rect_mask = (g != bg) & (g != Color.RED) & (g != Color.TEAL)\n    rect_colors = set(map(int, g[rect_mask]))\n    assert len(rect_colors) == 1, \"expected one rectangle color besides the markers\"\n\n    rect_bbox = bbox(rect_mask)\n    assert rect_bbox is not None, \"expected a filled rectangle\"\n    r0, c0, r1, c1 = rect_bbox\n    rect_h = r1 - r0 + 1\n    rect_w = c1 - c0 + 1\n    assert int(rect_mask.sum()) == rect_h * rect_w, \"rectangle must fill its bbox\"\n    assert np.all(rect_mask[r0 : r1 + 1, c0 : c1 + 1]), \"rectangle bbox must be solid\"\n\n    assert red_r == teal_r == r0 - 1, \"markers must sit directly above the rectangle\"\n    assert c0 <= red_c <= c1 and c0 <= teal_c <= c1, \"markers must align over rectangle columns\"\n    assert red_c != teal_c, \"red and teal markers must be horizontally separated\"\n\n    side = 1 if teal_c > red_c else -1\n    exit_r = r1\n    exit_c = c1 + 1 if side > 0 else c0 - 1\n    assert 0 <= exit_r < H and 0 <= exit_c < W, \"teal exit cell must be inside the grid\"\n    assert g[exit_r, exit_c] == bg, \"teal exit cell must be background\"\n\n    out = g.copy()\n    out[red_r, red_c] = bg\n    out[teal_r, teal_c] = Color.RED\n    out[exit_r, exit_c] = Color.TEAL\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas/object sampling bounds.\nGRID_SIZE_RANGE = (7, 19)\nRECT_WIDTH_RANGE = (3, 17)\nRECT_HEIGHT_RANGE = (4, 9)\nRECT_AREA_RESERVED_CELLS = 3\nRECT_AREA_DIVISOR = 2\n\n# Marker/layout placement settings.\nMARKER_SEPARATION_RANGE = (2, 5)\nRECT_MAX_WIDTH_MARGIN = 2\nRECT_MAX_HEIGHT_MARGIN = 3\nADJACENT_CELL_OFFSET = 1\nEXIT_SIDES = [-1, 1]\nMAX_GENERATION_ATTEMPTS = 300\n\n# Fixed task colors.\nBACKGROUND_COLOR = Color.ORANGE\nRECTANGLE_COLOR = Color.GREY\n\ndef _gen_rect_dims(n: int) -> tuple[int, int]:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/5623160b.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Push every colored object touching maroon markers straight outward until it reaches the grid edge.\n\n    Input structure:\n    - The background is the dominant color.\n    - Maroon pixels are fixed markers.\n    - Every other foreground 4-connected object touches the marker pixels on exactly one cardinal side.\n\n    Rule:\n    - Clear each non-background, non-maroon object from its original position.\n    - Translate it in the direction away from its maroon contact until the object reaches the grid boundary.\n    - Keep the maroon marker pixels unchanged.\n\n    Key insight:\n    - The maroon contact side is a launcher: it determines a unique outward ray for the whole object, and the edge of the grid determines the translation distance.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg != MARKER_COLOR\n    assert bool(np.any(g == MARKER_COLOR))\n\n    marker_components = find_components(\n        g,\n        bg=bg,\n        connectivity=4,\n        monochromatic=True,\n        colors=[MARKER_COLOR],\n        return_format=\"dict\",\n    )\n    assert 1 <= len(marker_components) <= 3, \"maroon markers must form 1-3 moderate components\"\n    assert sum(int(comp[\"area\"]) for comp in marker_components) <= 17, \"maroon marker area must be moderate\"\n    assert all(int(comp[\"area\"]) <= 9 for comp in marker_components), \"each maroon component must be moderate\"\n\n    out = g.copy()\n    placements: list[tuple[int, np.ndarray]] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        color = int(comp[\"color\"])\n        if color == MARKER_COLOR:\n            continue\n\n        coords = comp[\"coords\"].astype(int, copy=False)\n        direction = _outward_direction(g, coords)\n        steps = _steps_to_edge(g.shape, coords, direction)\n        assert steps <= 8, \"push distance must stay within the observed moderate range\"\n        offset = np.array(direction, dtype=int) * steps\n        shifted = coords + offset\n        assert bool(\n            np.all(\n                (0 <= shifted[:, 0])\n                & (shifted[:, 0] < g.shape[0])\n                & (0 <= shifted[:, 1])\n                & (shifted[:, 1] < g.shape[1])\n            )\n        )\n        own = {tuple(coord) for coord in coords.tolist()}\n        for step in range(1, steps + 1):\n            swept = coords + np.array(direction, dtype=int) * step\n            for rr, cc in swept:\n                loc = (int(rr), int(cc))\n                assert loc in own or int(g[loc]) == bg, \"object movement path must be unobstructed\"\n\n        out[coords[:, 0], coords[:, 1]] = bg\n        placements.append((color, shifted))\n\n    assert placements\n    for color, coords in placements:\n        assert bool(np.all(out[coords[:, 0], coords[:, 1]] == bg)), \"moved objects must not collide\"\n        out[coords[:, 0], coords[:, 1]] = color\n\n    return out\n\n# --------------- generator (attempt 1 refined) ---------------\n\n# Generated grid colors.\nBG = 7\nMAROON = 9\nALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8]\nDIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n# Canvas and maroon marker bounds.\nGRID_SIZE_MIN = 9\nGRID_SIZE_MAX = 16\nMAROON_COMPONENT_MIN = 1\nMAROON_COMPONENT_MAX = 3\nMAROON_TOTAL_AREA_MAX = 17\nMAROON_COMPONENT_AREA_MAX = 9\nINTERIOR_PADDING = 1\nMAROON_PLACEMENT_TRIES = 80\n\n# Moving object bounds and push constraints.\nOBJECT_COUNT_MIN = 3\nOBJECT_COUNT_MAX = 7\nOBJECT_SIZE_MIN = 1\nOBJECT_SIZE_MAX = 5\nPUSH_DISTANCE_MAX = 8\nZERO_STEP_PROBABILITY = 0.25\nZERO_STEP_ALLOWANCE = 1\n\n# Retry limits for object placement and whole-grid generation.\nOBJECT_SHAPE_TRIES = 20\nCONTACT_CANDIDATE_LIMIT = 5\nGENERATE_RETRIES = 300\n\n\ndef _grow_polyomino(size, rng):\n","exit_code":0,"status":"completed"}}
