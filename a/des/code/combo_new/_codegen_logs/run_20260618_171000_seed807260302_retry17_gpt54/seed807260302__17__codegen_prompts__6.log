low > col_high:\n 227:         return None\n 228: \n 229:     if direction == \"up\":\n 230:         if want_truncated:\n 231:             row_high = min(row_high, area - 2)\n 232:         else:\n 233:             row_low = max(row_low, area - 1)\n 234:     elif direction == \"down\":\n 235:         limit = grid_h - frame_h - area + 1\n 236:         if want_truncated:\n 237:             row_low = max(row_low, limit + 1)\n 238:         else:\n 239:             row_high = min(row_high, limit)\n 240:     elif direction == \"left\":\n 241:         if want_truncated:\n 242:             col_high = min(col_high, area - 2)\n 243:         else:\n 244:             col_low = max(col_low, area - 1)\n 245:     else:\n 246:         limit = grid_w - frame_w - area + 1\n 247:         if want_truncated:\n 248:             col_low = max(col_low, limit + 1)\n 249:         else:\n 250:             col_high = min(col_high, limit)\n 251: \n 252:     if row_low > row_high or col_low > col_high:\n 253:         return None\n 254:     return (row_low, row_high), (col_low, col_high)\n 255: \n 256: \n 257: def _gap_abs(spec: dict) -> tuple[int, int]:\n 258:     r0, c0 = spec[\"top_left\"]\n 259:     gr, gc = spec[\"gap_local\"]\n 260:     return r0 + gr, c0 + gc\n 261: \n 262: \n 263: def _seed_abs(spec: dict) -> tuple[int, int]:\n 264:     r0, c0 = spec[\"top_left\"]\n 265:     sr, sc = spec[\"seed_local\"]\n 266:     return r0 + sr, c0 + sc\n 267: \n 268: \n 269: def _ray_cells(spec: dict, grid_h: int, grid_w: int) -> set[tuple[int, int]]:\n 270:     gap_r, gap_c = _gap_abs(spec)\n 271:     dr, dc = DIRS[spec[\"gap_dir\"]]\n 272:     cells: set[tuple[int, int]] = set()\n 273:     for step in range(spec[\"area\"]):\n 274:         rr = gap_r + dr * step\n 275:         cc = gap_c + dc * step\n 276:         if not (0 <= rr < grid_h and 0 <= cc < grid_w):\n 277:             break\n 278:         cells.add((rr, cc))\n 279:     return cells\n 280: \n 281: \n 282: def _bbox_cells(spec: dict) -> set[t