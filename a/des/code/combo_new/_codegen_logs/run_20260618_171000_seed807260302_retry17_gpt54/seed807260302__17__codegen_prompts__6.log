cted_mask(height: int, width: int, target_area: int) -> np.ndarray:\n 262:     mask = np.zeros((height, width), dtype=bool)\n 263:     start = (random.randrange(height), random.randrange(width))\n 264:     cells = {start}\n 265:     mask[start] = True\n 266:     frontier = set()\n 267:     for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n 268:         nr, nc = start[0] + dr, start[1] + dc\n 269:         if 0 <= nr < height and 0 <= nc < width:\n 270:             frontier.add((nr, nc))\n 271:     while len(cells) < target_area:\n 272:         assert frontier\n 273:         chosen = random.choice(tuple(frontier))\n 274:         frontier.remove(chosen)\n 275:         cells.add(chosen)\n 276:         mask[chosen] = True\n 277:         cr, cc = chosen\n 278:         for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n 279:             nr, nc = cr + dr, cc + dc\n 280:             if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in cells:\n 281:                 frontier.add((nr, nc))\n 282:     return mask\n 283: \n 284: \n 285: def _sample_rect_dims(branch: str) -> tuple[int, int]:\n 286:     if branch == \"vert\":\n 287:         rect_w = random.randint(3, 5)\n 288:         rect_h = random.randint(rect_w + 1, 8)\n 289:         return rect_h, rect_w\n 290:     if random.random() < 0.3:\n 291:         side = random.randint(4, 6)\n 292:         return side, side\n 293:     rect_h = random.randint(3, 5)\n 294:     rect_w = random.randint(max(4, rect_h), 8)\n 295:     return rect_h, rect_w\n 296: \n 297: \n 298: def _make_pair_patches(color: int, rect_h: int, rect_w: int) -> tuple[np.ndarray, np.ndarray]:\n 299:     inner_h, inner_w = rect_h - 2, rect_w - 2\n 300:     assert inner_h >= 1 and inner_w >= 1\n 301:     inner_area = inner_h * inner_w\n 302:     min_hole = 2 if inner_area >= 2 else 1\n 303:     max_hole = inner_area\n 304:     hole_area = random.randint(min_hole, max_hole)\n 305:     hole_mask = _grow_connected_mask(inner_h, inner_w, hole_area)\n 306: \n 30