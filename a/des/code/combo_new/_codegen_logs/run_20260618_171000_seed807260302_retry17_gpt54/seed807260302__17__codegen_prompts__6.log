or.RED, Color.TEAL, Color.MAROON, Color.PINK)\n   7: \n   8: \n   9: def main(grid: np.ndarray) -> np.ndarray:\n  10:     \"\"\"Convert scattered foreground objects into bottom-aligned count bars in a fixed five-color order.\n  11: \n  12:     Input structure\n  13:     The grid has a dominant background color and foreground objects in the task\n  14:     palette: grey, red, teal, maroon, and pink. Objects are monochromatic\n  15:     8-connected components; some palette colors may be absent.\n  16: \n  17:     Rule\n  18:     For each palette color in order grey, red, teal, maroon, pink, count its\n  19:     8-connected objects. Create a background grid with five columns and height\n  20:     equal to the largest count, then fill each column upward from the bottom\n  21:     with its palette color for that count.\n  22: \n  23:     Key insight\n  24:     The output does not preserve object shapes or positions; it is a histogram\n  25:     of per-color 8-connected object counts, using the learned palette order.\n  26:     \"\"\"\n  27:     g = np.asarray(grid, dtype=int)\n  28:     assert g.ndim == 2\n  29: \n  30:     bg = get_bg(g)\n  31:     palette_set = set(PALETTE_ORDER)\n  32:     assert bg not in palette_set, \"background must not be a histogram color\"\n  33:     assert set(map(int, g.ravel())) <= palette_set | {bg}\n  34: \n  35:     object_counts = [len(components_mask(g == color, connectivity=8)) for color in PALETTE_ORDER]\n  36:     max_count = max(object_counts)\n  37:     assert max_count > 0, \"expected at least one foreground object\"\n  38: \n  39:     out = np.full((max_count, len(PALETTE_ORDER)), bg, dtype=int)\n  40:     for c, (color, count) in enumerate(zip(PALETTE_ORDER, object_counts)):\n  41:         if count:\n  42:             out[-count:, c] = color\n  43:     return out\n  44: \n  45: # --------------- generator (att1) ---------------\n  46: \n  47: # Canvas and palette.\n  48: GRID_SHAPE = (10, 10)\n  49: BACKGROUND_COLOR = Color.ORANGE\n  50: N_COLORS = len(PALETTE_ORDER)\n  51: \n  52: # Histogram count sampling.\n  53: NONZERO_COLOR_RANGE = (3, 6)\n  54: MAX_COUNT_RANGE = (2, 7)\n  55: TOTAL_OBJECT_RANGE = (4, 12)\n  56: \n  57: # Blob shape sampling.\n  58: N_BLOB_SHAPES = 6\n  59: LINE_LENGTH_RANGE = (2, 5)\n  60: SMALL_DIM_RANGE = (2, 4)\n  61: GROWN_BLOB_MIN_SIZE = 3\n  62: PLUS_SHAPE_SIZE = 3\n  63: \n  64: # Placement and retry limits.\n  65: SAME_COLOR_MIN_CHEBYSHEV = 2\n  66: BLOB_PLACE_TRIES = 100\n  67: GENERATION_TRIES = 300\n  68: \n  69: \n  70: def _gen_attempt() -> np.ndarray | None:\n  71:     \"\"\"Generate one candidate grid, returning None when placement or validation fails.\"\"\"\n  72:     rng = np.random.default_rng()\n  73:     counts = _sample_counts(rng)\n  74:     if counts is None:\n  75:         return None\n  76: \n  77:     grid = np.full(GRID_SHAPE, BACKGROUND_COLOR, dtype=int)\n  78:     if not _place_all_blobs(grid, counts, rng):\n  79:         return None\n  80:     if not _counts_match_grid(grid, counts):\n  81:         return None\n  82:     if not _solver_matches_expected(grid, counts):\n  83:         return None\n  84:     return grid\n  85: \n  86: \n  87: def _sample_counts(rng) -> list[int] | None:\n  88:     \"\"\"Sample per-color component counts matching the output histogram contract.\"\"\"\n  89:     n_nonzero = int(rng.integers(*NONZERO_COLOR_RANGE))\n  90:     max_count = int(rng.integers(*MAX_COUNT_RANGE))\n  91: \n  92:     counts = [0] * N_COLORS\n  93:     nonzero_indices = list(rng.choice(N_COLORS, size=n_nonzero, replace=False))\n  94:     max_idx = rng.choice(nonzero_indices)\n  95:     counts[max_idx] = max_count\n  96: \n  97:     remaining_budget = TOTAL_OBJECT_RANGE[1] - max_count\n  98:     for idx in [i for i in nonzero_indices if i != max_idx]:\n  99:         upper = min(max_count, remaining_budget)\n 100:         if upper < 1:\n 101:             counts[idx] = 1\n 102:             remaining_budget -= 1\n 103:         else:\n 104:             counts[idx] = int(rng.integers(1, upper + 1))\n 105:             remaining_budget -= counts[idx]\n 106: \n 107:     total = sum(counts)\n 108:     if total < TOTAL_OBJECT_RANGE[0] or total > TOTAL_OBJECT_RANGE[1]:\n 109:         return None\n 110:     return counts\n 111: \n 112: \n 113: def _place_all_blobs(grid: np.ndarray, counts: list[int], rng) -> bool:\n 114:     \"\"\"Place each color's requested number of same-color-separated blobs.\"\"\"\n 115:     for color_idx, count in enumerate(counts):\n 116:         if count == 0:\n 117:             continue\n 118:         if not _place_color_blobs(grid, PALETTE_ORDER[color_idx], count, rng):\n 119:             return False\n 120:     return True\n 121: \n 122: \n 123: def _place_color_blobs(grid: np.ndarray, color: int, count: int, rng) -> bool:\n 124:     placed_blobs = []\n 125:     for _ in range(count):\n 126:         coords = _choose_placeable_blob(grid, placed_blobs, rng)\n 127:         if coords is None:\n 128:             return False\n 129:         _paint_coords(grid, coords, color)\n 130:         placed_blobs.append(coords)\n 131:     return True\n 132: \n 133: \n 134: def _choose_placeable_blob(grid: np.ndarray, placed_blobs: list[set], rng) -> set | None:\n 135:     for _ in range(BLOB_PLACE_TRIES):\n 136:         blob = _random_blob(rng)\n 137:         bh, bw = blob.shape\n 138:         r0 = int(rng.integers(0, GRID_SHAPE[0] - bh + 1))\n 139:         c0 = int(rng.integers(0, GRID_SHAPE[1] - bw + 1))\n 140:         coords = _offset_blob_coords(blob, r0, c0)\n 141:         if _coords_are_free(grid, coords) and _chebyshev_ok(coords, placed_blobs):\n 142:             return coords\n 143:     return None\n 144: \n 145: \n 146: def _offset_blob_coords(blob: np.ndarray, r0: int, c0: int) -> set:\n 147:     offsets = np.argwhere(blob)\n 148:     return set(map(tuple, offsets + np.array([r0, c0])))\n 149: \n 150: \n 151: def _coords_are_free(grid: np.ndarray, coords: set) -> bool:\n 152:     return all(