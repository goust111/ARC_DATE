{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\npaths = [\n'/home/lixinyu/snap/new/ARC_code/eval/136b0064.py',\n'/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py',\n'/home/lixinyu/snap/new/ARC_code/eval/cbebaa4b.py',\n'/home/lixinyu/snap/new/ARC_code/eval/5961cc34.py',\n'/home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py',\n'/home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py',\n'/home/lixinyu/snap/new/ARC_code/train/902510d5.py',\n'/home/lixinyu/snap/new/ARC_code/train/84ba50d3.py',\n]\nfor p in paths:\n    print(f'===== {p} =====')\n    text = Path(p).read_text()\n    lines = text.splitlines()\n    keep = []\n    capture = False\n    indent = None\n    for i, line in enumerate(lines, 1):\n        if line.startswith('def main(') or line.startswith('def generate_input('):\n            capture = True\n            indent = len(line) - len(line.lstrip())\n        if capture:\n            keep.append(f'{i:4}: {line}')\n            if i < len(lines):\n                nxt = lines[i]\n                if nxt.startswith('def ') and (len(nxt) - len(nxt.lstrip())) == indent:\n                    capture = False\n    print('\\\\n'.join(keep[:220]))\n    print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/136b0064.py =====\n  24: def main(grid: np.ndarray) -> np.ndarray:\n  25:     \"\"\"\n  26:     Draw a polyline by decoding 3x3 glyph instructions read across a divided grid.\n  27: \n  28:     Input structure:\n  29:     - Left of a full-height vertical divider: 3x3 colored glyphs on bg.\n  30:     - Right of divider: a single gray (5) start pixel.\n  31: \n  32:     Rule:\n  33:     - Remove the divider; shift the gray start into the left canvas.\n  34:     - Read glyphs in column-major order (left→right, top→bottom).\n  35:     - Each glyph's shape (pixel area) encodes a segment: area 4 → down 2, area 5 → right 3, area 6 → left 4, area 7 → left 2.\n  36:     - Append segments sequentially, stepping down one cell between each.\n  37: \n  38:     Key insight: Glyph pixel count (area) uniquely determines both segment length and direction — the shape itself is the instruction.\n  39:     \"\"\"\n  40:     g = np.array(grid, dtype=int)\n  41:     H, W = g.shape\n  42:     bg = int(get_bg(g))\n  43: \n  44:     # Divider is a full-height constant non-bg column.\n  45:     div_c, div_color = find_full_height_constant_col(g, bg=bg)\n  46:     assert div_c is not None\n  47: \n  48:     out = np.zeros((H, int(div_c)), dtype=int)\n  49: \n  50:     # Move gray start from right side into left canvas (remove divider col too).\n  51:     gray = np.argwhere(g == 5)\n  52:     if gray.size == 0:\n  53:         return out\n  54:     r_cur, c_cur = map(int, gray[0])\n  55:     c_cur = int(c_cur - (int(div_c) + 1))\n  56:     if not (0 <= c_cur < int(div_c)):\n  57:         return out\n  58:     out[int(r_cur), int(c_cur)] = 5\n  59: \n  60:     # Collect 3x3 glyph components on the left.\n  61:     left = g[:, : int(div_c)]\n  62:     ignore = {int(bg), 5}\n  63:     if div_color is not None:\n  64:         ignore.add(int(div_color))\n  65: \n  66:     glyphs: list[dict[str, int]] = []\n  67:     for comp in find_components(left, bg=bg, connectivity=8, monochromatic=True, return_format=\"dict\"):\n  68:         col = int(comp[\"color\"])\n  69:         if col in ignore:\n  70:             continue\n  71:         b = comp[\"bbox\"]\n  72:         if bbox_h(b) == 3 and bbox_w(b) == 3:\n  73:             r0, c0, _r1, _c1 = map(int, b)\n  74:             glyphs.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"area\": int(comp[\"area\"])})\n  75: \n  76:     glyphs.sort(key=lambda d: (int(d[\"c0\"]), int(d[\"r0\"])))\n  77: \n  78:     area_to_len = {4: 2, 5: 3, 6: 4, 7: 2}\n  79:     area_to_dir = {5: 1, 6: -1, 7: -1}  # diamond right; cross/U left\n  80: \n  81:     for glyph in glyphs:\n  82:         color = int(glyph[\"color\"])\n  83:         area = int(glyph[\"area\"])\n  84:         seg_len = int(area_to_len.get(area, 2))\n  85: \n  86:         r_cur = int(r_cur + 1)\n  87:         assert r_cur < H, f\"segment exits bottom: r_cur={r_cur}, H={H}\"\n  88:         out[r_cur, int(c_cur)] = color\n  89: \n  90:         if area == 4:  # vertical (down)\n  91:             end_r = r_cur + (seg_len - 1)\n  92:             assert end_r < H, f\"vertical segment exits bottom: end_r={end_r}, H={H}\"\n  93:             for _ in range(seg_len - 1):\n  94:                 r_cur = int(r_cur + 1)\n  95:                 out[r_cur, int(c_cur)] = color\n  96:         else:  # horizontal\n  97:             dir_h = int(area_to_dir.get(area, 1))\n  98:             end_c = int(c_cur) + dir_h * (seg_len - 1)\n  99:             assert 0 <= end_c < int(div_c), (\n 100:                 f\"horizontal segment exits canvas: c_cur={c_cur}, dir={dir_h}, \"\n 101:                 f\"seg_len={seg_len}, div_c={div_c}\"\n 102:             )\n 103:             for _ in range(seg_len - 1):\n 104:                 c_cur = int(c_cur + dir_h)\n 105:                 out[r_cur, c_cur] = color\n 106: \n 107:     return out\n 108: \n 109: # --------------- generator (attempt 1 (Claude)) ---------------\n 110: \n 111: # --- canvas geometry ---\n 112: N_MIN, N_MAX = 2, 5            # number of tile rows; H = 4*N - 1, num_glyphs = 2*N\n 113: GRID_W = 15                    # full input width\n 114: DIVIDER_COL = 7                # divider position (col), full-height\n 115: DIVIDER_COLOR = 4              # divider fill color\n 116: LEFT_W = 7                     # left canvas width (cols 0..6)\n 117: TILE_COLS = (0, 4)             # 3x3 tile c0 positions on the left\n 118: TILE_ROW_STRIDE = 4            # row spacing between successive tile slots\n 119: GRAY = 5                       # start-pixel color\n 120: GRAY_START_ROW = 0             # gray start always sits at row 0 [observed]\n 121: \n 122: # --- shape grammar (area -> 3x3 template, color, and (dr, dc) walk delta) ---\n 123: # Walk delta = total (row, col) displacement caused by one glyph instruction:\n 124: #   step down 1 then segment of (len, dir). E.g. area 4 (vertical len 2) => (+2, 0).\n 125: _TEMPLATES = {\n 126:     4: np.array([[1, 0, 1], [0, 1, 0], [0, 1, 0]], dtype=int),  # plus    -> down 2,  color 6\n 127:     5: np.array([[1, 1, 0], [1, 0, 1], [0, 1, 0]], dtype=int),  # diamond -> right 3, color 1\n 128:     6: np.array([[1, 1, 1], [0, 1, 0], [1, 0, 1]], dtype=int),  # cross   -> left 4,  color 3\n 129:     7: np.array([[1, 0, 1], [1, 0, 1], [1, 1, 1]], dtype=int),  # U       -> left 2,  color 2\n 130: }\n 131: _AREA_TO_COLOR = {4: 6, 5: 1, 6: 3, 7: 2}\n 132: _AREA_DELTA = {4: (2, 0), 5: (1, 2), 6: (1, -3), 7: (1, -1)}\n 133: _AREAS = (4, 5, 6, 7)\n 134: \n 135: # --- generation constraints ---\n 136: MIN_DIRECTION_CHANGES = 2      # min vertical<->horizontal flips across the walk\n 137: MAX_ATTEMPTS = 300             # outer retry budget\n 138: \n 139: \n 190: def generate_input() -> np.ndarray:\n 191:     for _ in range(MAX_ATTEMPTS):\n 192:         try:\n 193:             inp = _gen_attempt()\n 194:             if inp is None:\n 195:                 continue\n 196:             out = main(inp)  # oracle check\n 197:             if out.shape != (inp.shape[0], LEFT_W):\n 198:                 continue\n 199:             return inp\n 200:         except Exception:\n 201:             continue\n 202:     raise RuntimeError(f\"generate_input: failed after {MAX_ATTEMPTS} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py =====\n  17: def main(grid: np.ndarray) -> np.ndarray:\n  18:     \"\"\"\n  19:     Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n  20: \n  21:     Input structure\n  22:     - The most common color forms the outer background and all enclosed slot\n  23:       backgrounds.\n  24:     - The enclosed background components form a complete rectangular array of\n  25:       slots, ordered by their positions.\n  26:     - Each slot contains either no other color or exactly one object color.\n  27: \n  28:     Rule\n  29:     - Find all 4-connected components of the most common color that do not touch\n  30:       the input edge.\n  31:     - Sort their bounding boxes into row and column order to define the output\n  32:       table.\n  33:     - For each slot, output its unique non-background color if present; otherwise\n  34:       output the background color.\n  35: \n  36:     Key insight\n  37:     - The large grid is an expanded table: the enclosed background components are\n  38:       the cells, and any colored object drawn inside a cell is that cell's summary\n  39:       value.\n  40:     \"\"\"\n  41:     g = np.asarray(grid, dtype=int)\n  42:     assert g.ndim == 2, \"expected a 2D grid\"\n  43:     height, width = map(int, g.shape)\n  44: \n  45:     bg = get_bg(g)\n  46:     slot_bboxes: list[tuple[int, int, int, int]] = []\n  47:     for coords in components_mask(g == bg, connectivity=4):\n  48:         if _touches_edge(coords, height, width):\n  49:             continue\n  50:         slot_bboxes.append(bbox_coords(coords))\n  51: \n  52:     assert slot_bboxes, \"expected enclosed background slots\"\n  53:     row_starts = sorted({b[0] for b in slot_bboxes})\n  54:     col_starts = sorted({b[1] for b in slot_bboxes})\n  55:     assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n  56:         \"expected a complete rectangular array of slots\"\n  57:     )\n  58: \n  59:     slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n  60:     assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n  61: \n  62:     out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n  63:     for out_r, r0 in enumerate(row_starts):\n  64:         for out_c, c0 in enumerate(col_starts):\n  65:             assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n  66:             sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n  67:             window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n  68:             object_colors = np.unique(window[window != bg])\n  69:             assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n  70:             if object_colors.size == 1:\n  71:                 out[out_r, out_c] = int(object_colors[0])\n  72: \n  73:     return out\n  74: \n  75: # --------------- generator (att2) ---------------\n  76: \n  77: # Canvas, table, frame, and slot dimensions.\n  78: CANVAS_MIN, CANVAS_MAX = 13, 19\n  79: TABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\n  80: ROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\n  81: AXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n  82: \n  83: # Object and palette sampling limits.\n  84: N_COLORS, MAX_OBJECT_COLORS = 10, 6\n  85: MAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\n  86: OBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n  87: \n  88: # Rejection sampling cap.\n  89: GEN_RETRY_LIMIT = 300\n  90: \n  91: \n 259: def generate_input() -> np.ndarray:\n 260:     for _ in range(GEN_RETRY_LIMIT):\n 261:         grid = _gen_attempt()\n 262:         if grid is not None:\n 263:             return grid\n 264:     raise RuntimeError(\"failed to generate valid ac6f9922 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/cbebaa4b.py =====\n  50: def main(grid: np.ndarray) -> np.ndarray:\n  51:     \"\"\"\n  52:     Assemble scattered jigsaw sprites around a central yellow anchor by pairing red connector pixels.\n  53: \n  54:     Input structure:\n  55:     - bg = black (0). Several colored sprites scattered on the grid.\n  56:     - One anchor sprite contains a 3×3 yellow (4) block.\n  57:     - Each sprite has red (2) connector pixels along its edges.\n  58: \n  59:     Rule:\n  60:     - The anchor stays in place; remaining sprites attach one at a time.\n  61:     - Each sprite is translated so that one of its red pixels overlaps an unpaired red pixel on the growing assembly.\n  62:     - Every red connector must pair with exactly one other, forming a complete joined structure.\n  63: \n  64:     Key insight: Red pixels act as jigsaw pegs — each must match exactly one counterpart, and the assembly order is determined by which unpaired connectors remain.\n  65:     \"\"\"\n  66:     g = np.asarray(grid, dtype=int)\n  67:     h, w = g.shape\n  68:     bg = 0\n  69: \n  70:     pieces = _extract_pieces(g, bg)\n  71:     assert pieces, \"input must have at least one colored piece\"\n  72: \n  73:     # Anchor is the unique piece containing the 3x3 yellow (color 4) block.\n  74:     anchors = [p for p in pieces if np.any(p[\"arr\"] == 4)]\n  75:     assert len(anchors) == 1, \"input must have exactly one yellow (4) anchor piece\"\n  76:     anchor = anchors[0]\n  77:     rest = [p for p in pieces if p is not anchor]\n  78: \n  79:     canvas = np.full((h, w), bg, dtype=int)\n  80:     ar0, ac0, _, _ = anchor[\"bbox\"]\n  81:     placed = _try_place(canvas, anchor[\"arr\"], ar0, ac0, bg)\n  82:     assert placed is not None, \"anchor piece must fit on canvas at its original position\"\n  83: \n  84:     total_ports = int(sum(len(p[\"reds\"]) for p in pieces))\n  85:     assert total_ports % 2 == 0, \"total red connector ports must be even for complete pairing\"\n  86:     target_unique_red = total_ports // 2\n  87: \n  88:     # Track how many original red pixels map to each assembled red coordinate.\n  89:     red_counts: dict[tuple[int, int], int] = {}\n  90:     for rr, cc in anchor[\"reds\"]:\n  91:         red_counts[(ar0 + rr, ac0 + cc)] = red_counts.get((ar0 + rr, ac0 + cc), 0) + 1\n  92: \n  93:     # Backtracking assembly by pairing up red connector pixels.\n  94:     solutions: list[np.ndarray] = []\n  95: \n  96:     def dfs(cur: np.ndarray, remaining: list[dict], rc: dict[tuple[int, int], int]) -> None:\n  97:         if len(solutions) >= 2:\n  98:             return\n  99: \n 100:         if not remaining:\n 101:             if len(rc) == target_unique_red and all(v == 2 for v in rc.values()):\n 102:                 solutions.append(cur)\n 103:             return\n 104: \n 105:         if len(rc) > target_unique_red:\n 106:             return\n 107: \n 108:         # Unpaired reds are exactly those with count==1; always pair one of them next.\n 109:         unpaired = [k for k, v in rc.items() if v == 1]\n 110:         if not unpaired:\n 111:             return\n 112: \n 113:         rc1 = {k for k, v in rc.items() if v == 1}\n 114: \n 115:         # Pick the most constrained unpaired red coordinate: fewest ways to cover it.\n 116:         best_moves = None\n 117:         for t in unpaired:\n 118:             moves = []\n 119:             tr, tc = t\n 120:             for idx, p in enumerate(remaining):\n 121:                 ph, pw = p[\"shape\"]\n 122:                 for pr, pc in p[\"reds\"]:\n 123:                     top = tr - pr\n 124:                     left = tc - pc\n 125:                     if top < 0 or left < 0 or top + ph > h or left + pw > w:\n 126:                         continue\n 127:                     # quick red-count feasibility\n 128:                     bad = False\n 129:                     overlap = 0\n 130:                     for rr, cc in p[\"reds\"]:\n 131:                         gr, gc = top + rr, left + cc\n 132:                         prev = rc.get((gr, gc), 0)\n 133:                         if prev >= 2:\n 134:                             bad = True\n 135:                             break\n 136:                         if (gr, gc) in rc1:\n 137:                             overlap += 1\n 138:                     if bad:\n 139:                         continue\n 140:                     # must overlap at least the target (guaranteed), but keep for scoring\n 141:                     moves.append((idx, top, left, overlap))\n 142:             if not moves:\n 143:                 return\n 144:             if best_moves is None or len(moves) < len(best_moves):\n 145:                 best_moves = moves\n 146:                 if len(best_moves) == 1:\n 147:                     break\n 148: \n 149:         assert best_moves is not None, \"there must be at least one feasible connector move\"\n 150: \n 151:         # Deduplicate moves by (piece, top, left) keeping max overlap score.\n 152:         dedup: dict[tuple[int, int, int], int] = {}\n 153:         for idx, top, left, ov in best_moves:\n 154:             k = (idx, top, left)\n 155:             dedup[k] = max(dedup.get(k, 0), ov)\n 156:         moves2 = [(idx, top, left, ov) for (idx, top, left), ov in dedup.items()]\n 157:         moves2.sort(key=lambda x: (-x[3], -remaining[x[0]][\"area\"], x[1], x[2], x[0]))\n 158: \n 159:         for idx, top, left, _ov in moves2:\n 160:             p = remaining[idx]\n 161:             next_remaining = remaining[:idx] + remaining[idx + 1 :]\n 162: \n 163:             next_rc = dict(rc)\n 164:             for rr, cc in p[\"reds\"]:\n 165:                 gr, gc = top + rr, left + cc\n 166:                 next_rc[(gr, gc)] = next_rc.get((gr, gc), 0) + 1\n 167: \n 168:             nxt = _try_place(cur, p[\"arr\"], top, left, bg)\n 169:             if nxt is None:\n 170:                 continue\n 171:             dfs(nxt, next_remaining, next_rc)\n 172:             if len(solutions) >= 2:\n 173:                 return\n 174: \n 175:     dfs(placed, rest, red_counts)\n 176:     assert len(solutions) == 1, \"jigsaw assembly must have exactly one valid solution\"\n 177:     return solutions[0]\n 178: \n 179: # --------------- generator (o5x) ---------------\n 180: \n 181: # ── Tunable configuration ──────────────────────────────────────────────\n 182: # Canvas\n 183: GRID_H_RANGE = (22, 26)               # output grid height bounds\n 184: GRID_W_RANGE = (22, 26)               # output grid width bounds\n 185: MAX_ASSEMBLY_DIM = 24                  # assembled jigsaw must fit inside this\n 186: \n 187: # Pieces\n 188: PIECE_COUNT_RANGE = (4, 6)            # non-anchor sprite count\n 189: PIECE_H_RANGE = (4, 7)               # piece bbox height bounds\n 190: PIECE_W_RANGE = (4, 8)               # piece bbox width bounds\n 191: PIECE_DIM_CANDIDATES = 12            # random (h,w) trials per piece placement\n 192: PIECE_COLORS = [1, 3, 5, 6, 7, 8, 9] # available non-red, non-yellow colors\n 193: PIECE_CAP = 2                         # max connections per piece node\n 194: BAR_SKIP_PROB = 0.35                  # probability of dropping one decorative bar\n 195: \n 196: # Anchor\n 197: ANCHOR_BLOCK_CHOICES = [(3, 3), (4, 5)]  # yellow block (h, w) options\n 198: ANCHOR_CAP_CHOICES = [1, 2]              # max connections for anchor node\n 199: \n 200: # Scatter\n 201: SCATTER_PADDING = 2                   # Chebyshev gap between scattered sprites\n 202: \n 203: # Generation\n 204: GEN_RETRY_LIMIT = 300                 # max attempts before raising RuntimeError\n 205: \n 206: # ── Side geometry lookups ──────────────────────────────────────────────\n 207: SIDES = (\"top\", \"right\", \"bottom\", \"left\")\n 208: OPPOSITE = {\"top\": \"bottom\", \"bottom\": \"top\", \"left\": \"right\", \"right\": \"left\"}\n 209: INWARD = {\"top\": (1, 0), \"bottom\": (-1, 0), \"left\": (0, 1), \"right\": (0, -1)}\n 210: \n 211: \n 515: def generate_input() -> np.ndarray:\n 516:     for _ in range(GEN_RETRY_LIMIT):\n 517:         grid = _gen_attempt()\n 518:         if grid is not None:\n 519:             return grid\n 520:     raise RuntimeError(\"failed to generate a valid cbebaa4b input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/5961cc34.py =====\n   7: def main(grid: np.ndarray) -> np.ndarray:\n   8:     \"\"\"\n   9:     Build a red ray network by activating blue blobs via directional green ports.\n  10: \n  11:     Input structure:\n  12:     - bg = most common color. Large blue blobs with adjacent green pixels marking port directions.\n  13:     - Start marker: yellow pixel atop a short red segment at grid bottom.\n  14: \n  15:     Rule:\n  16:     - Extend a ray upward from start; on hitting a blue blob, recolor it red.\n  17:     - Activated blobs emit thick rays through green ports until boundary or another blob.\n  18:     - Cascade until no new blobs are reached.\n  19: \n  20:     Key insight: Green pixels encode ray direction and width; the network activates as a chain reaction from one start point.\n  21:     \"\"\"\n  22:     g = np.array(grid, dtype=int)\n  23:     H, W = g.shape\n  24:     bg = int(get_bg(g))\n  25: \n  26:     # --- STEP 1) Detect the start \"port\" (red vertical segment with a non-red cap above) ---\n  27:     start_candidates: list[tuple[int, int, int, list[tuple[int, int]]]] = []\n  28: \n  29:     for col in colors_present(g, exclude={bg}):\n  30:         for coords in components_mask(g == int(col), connectivity=8):\n  31:             if coords.size == 0:\n  32:                 continue\n  33:             r0, c0 = coords.min(axis=0)\n  34:             r1, c1 = coords.max(axis=0)\n  35:             r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n  36: \n  37:             # thin vertical segment, height>=2, touches bottom\n  38:             if c0 != c1 or (r1 - r0 + 1) < 2:\n  39:                 continue\n  40:             if r1 != int(H - 1):\n  41:                 continue\n  42:             # solid vertical segment\n  43:             if any(int(g[rr, c0]) != int(col) for rr in range(int(r0), int(r1) + 1)):\n  44:                 continue\n  45:             if int(r0) - 1 < 0:\n  46:                 continue\n  47:             cap = int(g[int(r0) - 1, int(c0)])\n  48:             if cap == int(bg) or cap == int(col):\n  49:                 continue\n  50: \n  51:             start_candidates.append(\n  52:                 (\n  53:                     int(col),\n  54:                     int(cap),\n  55:                     int(c0),\n  56:                     [(int(rr), int(c0)) for rr in range(int(r0), int(r1) + 1)],\n  57:                 )\n  58:             )\n  59: \n  60:     assert len(start_candidates) == 1\n  61:     red_col, yellow_col, start_col, start_seg = start_candidates[0]\n  62: \n  63:     # --- STEP 2) Identify blob colors ---\n  64:     # Blue = dominant remaining color by pixel count (excluding bg/start colors).\n  65:     counts = Counter(map(int, g.flatten()))\n  66:     other_cols = [(int(cnt), int(col)) for col, cnt in counts.items() if int(col) not in (bg, red_col, yellow_col)]\n  67:     assert other_cols\n  68:     max_count = max(cnt for cnt, _col in other_cols)\n  69:     blue_candidates = [int(col) for cnt, col in other_cols if cnt == max_count]\n  70:     assert len(blue_candidates) == 1\n  71:     blue_col = int(blue_candidates[0])\n  72: \n  73:     # Green = the unique other color that is 4-adjacent to blue.\n  74:     green_candidates: list[int] = []\n  75:     for col in colors_present(g, exclude={bg, red_col, yellow_col, blue_col}):\n  76:         pts = np.argwhere(g == int(col))\n  77:         if pts.size == 0:\n  78:             continue\n  79:         ok = False\n  80:         for r, c in pts:\n  81:             r = int(r)\n  82:             c = int(c)\n  83:             for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n  84:                 rr = int(r + dr)\n  85:                 cc = int(c + dc)\n  86:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(blue_col):\n  87:                     ok = True\n  88:                     break\n  89:             if ok:\n  90:                 break\n  91:         if ok:\n  92:             green_candidates.append(int(col))\n  93: \n  94:     assert len(green_candidates) == 1\n  95:     green_col = int(green_candidates[0])\n  96: \n  97:     out = np.full_like(g, int(bg))\n  98: \n  99:     # --- STEP 3) Extract blue blobs as connected components, and build a pixel->blob map ---\n 100:     blob_id = np.full((H, W), -1, dtype=int)\n 101:     blobs: list[dict] = []\n 102: \n 103:     for coords in components_mask(g == int(blue_col), connectivity=8):\n 104:         pts = [(int(r), int(c)) for r, c in coords]\n 105:         bi = int(len(blobs))\n 106:         for r, c in pts:\n 107:             blob_id[int(r), int(c)] = bi\n 108:         blobs.append({\"pts\": pts, \"ports\": []})\n 109: \n 110:     # --- STEP 4) For each blob, find its ports from adjacent green markers ---\n 111:     for blob in blobs:\n 112:         pts = blob[\"pts\"]\n 113:         seen_dirs: set[tuple[int, int]] = set()\n 114:         for r, c in pts:\n 115:             for ddr, ddc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n 116:                 rr = int(r + ddr)\n 117:                 cc = int(c + ddc)\n 118:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(green_col):\n 119:                     seen_dirs.add((int(ddr), int(ddc)))\n 120:         for ddr, ddc in seen_dirs:\n 121:             port_pixels = [\n 122:                 (int(r), int(c))\n 123:                 for (r, c) in pts\n 124:                 if 0 <= int(r + ddr) < H and 0 <= int(c + ddc) < W and int(g[int(r + ddr), int(c + ddc)]) == int(green_col)\n 125:             ]\n 126:             assert port_pixels\n 127:             blob[\"ports\"].append({\"dir\": (int(ddr), int(ddc)), \"pixels\": port_pixels})\n 128: \n 129:     activated: set[int] = set()\n 130:     queue: list[int] = []\n 131: \n 132:     def activate_blob_at(r: int, c: int) -> None:\n 133:         \"\"\"Recolor a blob to red when first hit by a ray; enqueue it to emit its ports.\"\"\"\n 134:         bi = int(blob_id[int(r), int(c)])\n 135:         assert bi >= 0\n 136:         if bi in activated:\n 137:             return\n 138:         activated.add(int(bi))\n 139:         queue.append(int(bi))\n 140:         for pr, pc in blobs[bi][\"pts\"]:\n 141:             out[int(pr), int(pc)] = int(red_col)\n 142: \n 143:     # --- STEP 5) Draw the start ray upward (thin) and stop at the first blob hit ---\n 144:     for r, c in start_seg:\n 145:         out[int(r), int(c)] = int(red_col)\n 146:     top_r = min(int(r) for r, _c in start_seg)\n 147:     assert int(top_r) > 0 and int(g[int(top_r) - 1, int(start_col)]) == int(yellow_col)\n 148:     out[int(top_r) - 1, int(start_col)] = int(red_col)\n 149:     for r in range(int(top_r) - 1, -1, -1):\n 150:         out[int(r), int(start_col)] = int(red_col)\n 151:         if int(g[int(r), int(start_col)]) == int(blue_col):\n 152:             activate_blob_at(int(r), int(start_col))\n 153:             break\n 154: \n 155:     def extend_thick(port_pixels: list[tuple[int, int]], d: tuple[int, int]) -> None:\n 156:         \"\"\"Extend a ray from each port pixel until boundary or blob hit.\"\"\"\n 157:         ddr, ddc = map(int, d)\n 158:         for pr, pc in port_pixels:\n 159:             r, c = int(pr), int(pc)\n 160:             while True:\n 161:                 r += int(ddr)\n 162:                 c += int(ddc)\n 163:                 if not (0 <= r < H and 0 <= c < W):\n 164:                     break\n 165:                 out[int(r), int(c)] = int(red_col)\n 166:                 if int(g[int(r), int(c)]) == int(blue_col):\n 167:                     activate_blob_at(int(r), int(c))\n 168:                     break\n 169: \n 170:     # --- STEP 6) Propagate (BFS): activated blob -> emit rays -> activate more blobs ---\n 171:     while queue:\n 172:         bi = int(queue.pop(0))\n 173:         for port in blobs[bi][\"ports\"]:\n 174:             extend_thick(port[\"pixels\"], port[\"dir\"])\n 175: \n 176:     assert len(blobs) - len(activated) <= 1, \"at most 1 distractor blob\"\n 177: \n 178:     return out\n 179: \n 180: # --------------- generator (a2_cascade) ---------------\n 181: \n 182: from arc_utils import paint_coords\n 183: \n 184: # --- Colors ---\n 185: BG = 8\n 186: BLUE = 1\n 187: RED = 2\n 188: GREEN = 3\n 189: YELLOW = 4\n 190: \n 191: # --- Directions ---\n 192: UP = (-1, 0)\n 193: DOWN = (1, 0)\n 194: LEFT = (0, -1)\n 195: RIGHT = (0, 1)\n 196: DIRS = (UP, DOWN, LEFT, RIGHT)\n 197: OPP = {UP: DOWN, DOWN: UP, LEFT: RIGHT, RIGHT: LEFT}\n 198: \n 199: # --- Diamond/octagon shapes (h, w) ---\n 200: SHAPES = ((3, 4), (4, 4), (5, 4), (5, 6), (6, 6), (8, 8))\n 201: _SHAPE_WIDTHS = {\n 202:     (3, 4): (2, 4, 2),\n 203:     (4, 4): (2, 4, 4, 2),\n 204:     (5, 4): (2, 4, 4, 4, 2),\n 205:     (5, 6): (2, 4, 6, 4, 2),\n 206:     (6, 6): (2, 4, 6, 6, 4, 2),\n 207:     (8, 8): (2, 4, 6, 8, 8, 6, 4, 2),\n 208: }\n 209: \n 210: # --- Canvas bounds ---\n 211: H_MIN, H_MAX = 13, 27\n 212: W_MIN, W_MAX = 15, 27\n 213: START_COL_PAD = 2        # min distance from start column to grid edge\n 214: \n 215: # --- Start segment ---\n 216: START_H_MIN, START_H_MAX = 2, 3  # red segment height (below yellow cap)\n 217: \n 218: # --- Chain / distractor ---\n 219: CHAIN_LEN_WEIGHTS = [1, 3, 3, 3]  # weights for chain_len in [0, 1, 2, 3]\n 220: MAX_BLOB_COUNT = 4                 # chain + distractors combined\n 221: MAX_DISTRACTORS = 1\n 222: \n 223: # --- Placement ---\n 224: MIN_GAP_FIRST = 4   # along-axis gap between start and first blob\n 225: MIN_GAP_CHAIN = 3   # along-axis gap between successive chain blobs\n 226: \n\n===== /home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py =====\n   9: def main(grid: np.ndarray) -> np.ndarray:\n  10:     \"\"\"Convert scattered foreground objects into bottom-aligned count bars in a fixed five-color order.\n  11: \n  12:     Input structure\n  13:     The grid has a dominant background color and foreground objects in the task\n  14:     palette: grey, red, teal, maroon, and pink. Objects are monochromatic\n  15:     8-connected components; some palette colors may be absent.\n  16: \n  17:     Rule\n  18:     For each palette color in order grey, red, teal, maroon, pink, count its\n  19:     8-connected objects. Create a background grid with five columns and height\n  20:     equal to the largest count, then fill each column upward from the bottom\n  21:     with its palette color for that count.\n  22: \n  23:     Key insight\n  24:     The output does not preserve object shapes or positions; it is a histogram\n  25:     of per-color 8-connected object counts, using the learned palette order.\n  26:     \"\"\"\n  27:     g = np.asarray(grid, dtype=int)\n  28:     assert g.ndim == 2\n  29: \n  30:     bg = get_bg(g)\n  31:     palette_set = set(PALETTE_ORDER)\n  32:     assert bg not in palette_set, \"background must not be a histogram color\"\n  33:     assert set(map(int, g.ravel())) <= palette_set | {bg}\n  34: \n  35:     object_counts = [len(components_mask(g == color, connectivity=8)) for color in PALETTE_ORDER]\n  36:     max_count = max(object_counts)\n  37:     assert max_count > 0, \"expected at least one foreground object\"\n  38: \n  39:     out = np.full((max_count, len(PALETTE_ORDER)), bg, dtype=int)\n  40:     for c, (color, count) in enumerate(zip(PALETTE_ORDER, object_counts)):\n  41:         if count:\n  42:             out[-count:, c] = color\n  43:     return out\n  44: \n  45: # --------------- generator (att1) ---------------\n  46: \n  47: # Canvas and palette.\n  48: GRID_SHAPE = (10, 10)\n  49: BACKGROUND_COLOR = Color.ORANGE\n  50: N_COLORS = len(PALETTE_ORDER)\n  51: \n  52: # Histogram count sampling.\n  53: NONZERO_COLOR_RANGE = (3, 6)\n  54: MAX_COUNT_RANGE = (2, 7)\n  55: TOTAL_OBJECT_RANGE = (4, 12)\n  56: \n  57: # Blob shape sampling.\n  58: N_BLOB_SHAPES = 6\n  59: LINE_LENGTH_RANGE = (2, 5)\n  60: SMALL_DIM_RANGE = (2, 4)\n  61: GROWN_BLOB_MIN_SIZE = 3\n  62: PLUS_SHAPE_SIZE = 3\n  63: \n  64: # Placement and retry limits.\n  65: SAME_COLOR_MIN_CHEBYSHEV = 2\n  66: BLOB_PLACE_TRIES = 100\n  67: GENERATION_TRIES = 300\n  68: \n  69: \n 259: def generate_input() -> np.ndarray:\n 260:     for _ in range(GENERATION_TRIES):\n 261:         result = _gen_attempt()\n 262:         if result is not None:\n 263:             return result\n 264:     raise RuntimeError(f\"Failed to generate valid input after {GENERATION_TRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py =====\n   6: def main(grid: np.ndarray) -> np.ndarray:\n   7:     \"\"\"\n   8:     Connect framed squares via colored bridges following a control-pixel sequence.\n   9: \n  10:     Input structure:\n  11:     - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.\n  12:     - Control row below squares: colored pixels read left-to-right encode visitation order.\n  13: \n  14:     Rule:\n  15:     - Start at the square matching first control color c0.\n  16:     - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.\n  17:     - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.\n  18: \n  19:     Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n  20:     \"\"\"\n  21:     g = np.array(grid, dtype=int)\n  22:     H, W = g.shape\n  23:     bg = int(get_bg(g))\n  24: \n  25:     # border color = most common non-bg color\n  26:     cnt = Counter(map(int, g.flatten()))\n  27:     border = None\n  28:     for col, _k in cnt.most_common():\n  29:         if int(col) != int(bg):\n  30:             border = int(col)\n  31:             break\n  32:     assert not (border is None)\n  33: \n  34:     # detect framed squares as connected components of the border color\n  35:     lab, n = label_mask(g == int(border), connectivity=4)\n  36:     frames: list[dict] = []\n  37:     for cid in range(1, int(n) + 1):\n  38:         pts = np.argwhere(lab == int(cid))\n  39:         if int(pts.shape[0]) < 8:\n  40:             continue\n  41:         r0, c0 = pts.min(axis=0)\n  42:         r1, c1 = pts.max(axis=0)\n  43:         r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n  44:         h = int(r1 - r0 + 1)\n  45:         w = int(c1 - c0 + 1)\n  46:         if h < 3 or w < 3:\n  47:             continue\n  48: \n  49:         t = None\n  50:         inner_col = None\n  51:         for tt in range(1, int(min(h, w) // 2) + 1):\n  52:             inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]\n  53:             if inner.size == 0:\n  54:                 continue\n  55:             if bool((inner == int(border)).any()):\n  56:                 continue\n  57:             u = set(map(int, inner.flatten()))\n  58:             if len(u) != 1:\n  59:                 continue\n  60: \n  61:             ok = True\n  62:             if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):\n  63:                 ok = False\n  64:             if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):\n  65:                 ok = False\n  66:             if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):\n  67:                 ok = False\n  68:             if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n  69:                 ok = False\n  70:             if not ok:\n  71:                 continue\n  72: \n  73:             t = int(tt)\n  74:             inner_col = int(next(iter(u)))\n  75:             break\n  76: \n  77:         if t is None or inner_col is None:\n  78:             continue\n  79: \n  80:         frames.append(\n  81:             {\n  82:                 \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n  83:                 \"t\": int(t),\n  84:                 \"inner\": int(inner_col),\n  85:                 \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n  86:             }\n  87:         )\n  88: \n  89:     assert not (not frames)\n  90: \n  91:     by: dict[int, list[dict]] = defaultdict(list)\n  92:     for f in frames:\n  93:         by[int(f[\"inner\"])].append(f)\n  94: \n  95:     max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n  96: \n  97:     # control row = bottom-most row below the squares with >=2 non-bg pixels\n  98:     ctrl_r = None\n  99:     for r in range(int(H - 1), int(max_frame_r), -1):\n 100:         if int((g[int(r)] != int(bg)).sum()) >= 2:\n 101:             ctrl_r = int(r)\n 102:             break\n 103:     assert not (ctrl_r is None)\n 104: \n 105:     ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n 106:     assert not (len(ctrl) < 2)\n 107: \n 108:     def center(f: dict) -> tuple[int, int]:\n 109:         r0, c0, r1, c1 = map(int, f[\"bbox\"])\n 110:         return int((r0 + r1) // 2), int((c0 + c1) // 2)\n 111: \n 112:     def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n 113:         a = f1[\"inner_bbox\"]\n 114:         b = f2[\"inner_bbox\"]\n 115:         same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n 116:         same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))\n 117:         return same_row, same_col\n 118: \n 119:     # choose start frame\n 120:     start_color = int(ctrl[0])\n 121:     assert not (start_color not in by)\n 122:     start_cands = by[start_color]\n 123:     if len(start_cands) == 1:\n 124:         cur = start_cands[0]\n 125:     else:\n 126:         nxt_color = int(ctrl[1])\n 127:         nxt_cands = by.get(nxt_color, [])\n 128:         best = None\n 129:         bestf = None\n 130:         for f in start_cands:\n 131:             for g2 in (nxt_cands if nxt_cands else [f]):\n 132:                 sr, sc = aligned(f, g2)\n 133:                 al = 1 if (sr or sc) else 0\n 134:                 (r1_, c1_) = center(f)\n 135:                 (r2_, c2_) = center(g2)\n 136:                 d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n 137:                 cand = (int(al), -int(d))\n 138:                 if best is None or cand > best:\n 139:                     best = cand\n 140:                     bestf = f\n 141:         cur = bestf\n 142: \n 143:     out = g.copy()\n 144: \n 145:     def draw_bridge(fa: dict, fb: dict, color: int) -> None:\n 146:         (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n 147:         (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n 148:         ia = fa[\"inner_bbox\"]\n 149:         sr, sc = aligned(fa, fb)\n 150:         if sr:\n 151:             rr0, rr1 = int(ia[0]), int(ia[2])\n 152:             if int(c1a) < int(c0b):\n 153:                 cc0, cc1 = int(c1a + 1), int(c0b - 1)\n 154:             else:\n 155:                 cc0, cc1 = int(c1b + 1), int(c0a - 1)\n 156:             for r in range(int(rr0), int(rr1) + 1):\n 157:                 for c in range(int(cc0), int(cc1) + 1):\n 158:                     if 0 <= r < H and 0 <= c < W:\n 159:                         out[int(r), int(c)] = int(color)\n 160:             return\n 161:         if sc:\n 162:             cc0, cc1 = int(ia[1]), int(ia[3])\n 163:             if int(r1a) < int(r0b):\n 164:                 rr0, rr1 = int(r1a + 1), int(r0b - 1)\n 165:             else:\n 166:                 rr0, rr1 = int(r1b + 1), int(r0a - 1)\n 167:             for r in range(int(rr0), int(rr1) + 1):\n 168:                 for c in range(int(cc0), int(cc1) + 1):\n 169:                     if 0 <= r < H and 0 <= c < W:\n 170:                         out[int(r), int(c)] = int(color)\n 171: \n 172:     for i in range(int(len(ctrl)) - 1):\n 173:         a = int(ctrl[i])\n 174:         b = int(ctrl[i + 1])\n 175:         assert int(cur[\"inner\"]) == int(a)\n 176:         assert b in by, f\"control color {b} has no matching frame\"\n 177:         cands = by[b]\n 178:         best = None\n 179:         bestf = None\n 180:         for f in cands:\n 181:             sr, sc = aligned(cur, f)\n 182:             al = 1 if (sr or sc) else 0\n 183:             (r1_, c1_) = center(cur)\n 184:             (r2_, c2_) = center(f)\n 185:             d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n 186:             cand = (int(al), -int(d))\n 187:             if best is None or cand > best:\n 188:                 best = cand\n 189:                 bestf = f\n 190:         nxt = bestf\n 191:         draw_bridge(cur, nxt, int(a))\n 192:         cur = nxt\n 193: \n 194:     return out\n 195: \n 196: \n 427: def generate_input() -> np.ndarray:\n 428:     for _ in range(500):\n 429:         result = _gen_attempt()\n 430:         if result is not None:\n 431:             return result\n 432:     raise RuntimeError(\"Failed to generate valid input after 500 attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/902510d5.py =====\n  57: def main(grid: np.ndarray) -> np.ndarray:\n  58:     \"\"\"\n  59:     Keep the largest 8-connected motif and replace the corner/control pixels with a solid corner triangle.\n  60: \n  61:     Input structure\n  62:     - The background is the dominant color.\n  63:     - Exactly one grid corner contains a foreground control pixel; it gives the\n  64:       corner from which the triangle is painted.\n  65:     - There is one unique largest 8-connected monochrome foreground object, the\n  66:       motif that remains in the output; all other foreground pixels are controls.\n  67:     - Every foreground component outside that motif is a singleton control pixel.\n  68:     - The fill color is the unique control color that appears in at least two\n  69:       non-corner control pixels.\n  70: \n  71:     Rule\n  72:     - Start from a blank background canvas and redraw only the largest motif.\n  73:     - Count the non-corner control pixels; that count is the triangle side.\n  74:     - Paint the fill color on the right-triangle region where those two distances\n  75:       from the marked corner's edges sum to less than the side length.\n  76: \n  77:     Key insight\n  78:     - The scattered singleton controls are counted into a compact triangular\n  79:       stack at the marked corner; only the largest motif is not part of the count.\n  80:     \"\"\"\n  81:     g = np.asarray(grid, dtype=int)\n  82:     bg = get_bg(g)\n  83:     H, W = g.shape\n  84: \n  85:     corners = {\n  86:         \"TL\": (0, 0),\n  87:         \"TR\": (0, W - 1),\n  88:         \"BL\": (H - 1, 0),\n  89:         \"BR\": (H - 1, W - 1),\n  90:     }\n  91:     marked_corners = [\n  92:         (name, rc) for name, rc in corners.items() if int(g[rc]) != int(bg)\n  93:     ]\n  94:     assert len(marked_corners) == 1, \"expected exactly one foreground corner marker\"\n  95:     corner, (corner_r, corner_c) = marked_corners[0]\n  96: \n  97:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n  98:     assert comps, \"expected at least one foreground component\"\n  99:     max_area = max(int(comp[\"area\"]) for comp in comps)\n 100:     motif_candidates = [comp for comp in comps if int(comp[\"area\"]) == max_area]\n 101:     assert len(motif_candidates) == 1, \"expected a unique largest motif\"\n 102:     motif = motif_candidates[0]\n 103:     motif_color = int(motif[\"color\"])\n 104:     motif_coords = {tuple(map(int, coord)) for coord in motif[\"coords\"]}\n 105:     motif_direction = _diagonal_direction(motif_coords)\n 106:     assert motif_direction is not None, \"motif must be square and diagonal-symmetric\"\n 107:     assert motif_direction == corner, \"corner marker must match motif diagonal direction\"\n 108: \n 109:     control_coords = [\n 110:         (int(r), int(c))\n 111:         for r, c in np.argwhere(g != bg)\n 112:         if (int(r), int(c)) not in motif_coords\n 113:     ]\n 114:     assert (corner_r, corner_c) in control_coords, \"corner marker must be a control pixel\"\n 115:     assert len(control_coords) > 1, \"expected non-corner control pixels\"\n 116: \n 117:     control_components = [comp for comp in comps if comp is not motif]\n 118:     assert all(int(comp[\"area\"]) == 1 for comp in control_components), \"controls must be singleton components\"\n 119: \n 120:     control_counts = Counter(\n 121:         int(g[r, c])\n 122:         for r, c in control_coords\n 123:         if (int(r), int(c)) != (corner_r, corner_c)\n 124:     )\n 125:     fill_candidates = [\n 126:         int(color) for color, count in control_counts.items() if int(count) >= 2\n 127:     ]\n 128:     assert len(fill_candidates) == 1, \"expected one repeated non-corner fill color\"\n 129:     fill_color = fill_candidates[0]\n 130:     side = len(control_coords) - 1\n 131: \n 132:     out = np.full_like(g, bg)\n 133:     for r, c in motif_coords:\n 134:         out[r, c] = motif_color\n 135:     _paint_corner_triangle(out, corner, int(side), fill_color)\n 136:     return out\n 137: \n 138: # --------------- generator (att2) ---------------\n 139: \n 140: _GEN_ATTEMPTS = 300\n 141: \n 142: # Canvas and triangle bounds.\n 143: _GEN_ROW_BOUNDS = (6, 15)\n 144: _GEN_COL_BOUNDS = (9, 14)\n 145: _GEN_TRIANGLE_SIDE_BOUNDS = (2, 5)\n 146: \n 147: # Color and control-pixel sampling.\n 148: _GEN_COLORS = tuple(range(1, 10))\n 149: _GEN_MARKER_AVOID_FILL_PROB = 0.8\n 150: _GEN_FILL_COUNT_BOUNDS = (2, 3)\n 151: \n 152: # Sparse square motifs observed in the task examples.\n 153: _GEN_MOTIF_TEMPLATES = [\n 154:     (\"..#.\", \".#..\", \"#.#.\", \"...#\"),\n 155:     (\".#...\", \"..#..\", \"..##.\", \".#..#\", \"#....\"),\n 156:     (\n 157:         \"...###...\",\n 158:         \"..#......\",\n 159:         \".##......\",\n 160:         \"#..#.....\",\n 161:         \"#...#....\",\n 162:         \"#....#...\",\n 163:         \"......#..\",\n 164:         \".......#.\",\n 165:         \"........#\",\n 166:     ),\n 167:     (\"#...\", \".#.#\", \"..#.\", \".#..\"),\n 168:     (\"...#\", \"#.#.\", \"##..\", \".##.\"),\n 169: ]\n 170: \n 171: \n 397: def generate_input():\n 398:     for _ in range(_GEN_ATTEMPTS):\n 399:         grid = _gen_attempt()\n 400:         if grid is not None:\n 401:             return grid\n 402:     raise RuntimeError(\"failed to generate valid 902510d5 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/84ba50d3.py =====\n  35: def main(grid: np.ndarray) -> np.ndarray:\n  36:     \"\"\"\n  37:     Drop the blue sprites downward relative to the red divider, with vertical sprites passing through to the bottom.\n  38: \n  39:     Input structure:\n  40:     - The background is the dominant color.\n  41:     - One non-background color forms a single full-width horizontal divider row.\n  42:     - The other non-background color forms 4-connected sprites above the divider.\n  43: \n  44:     Rule:\n  45:     - Clear the original sprite pixels.\n  46:     - A one-column sprite falls to the bottom of its column and deletes the divider\n  47:       pixel it crossed.\n  48:     - Any wider sprite falls until its unique widest horizontal row is immediately\n  49:       above the divider row; if the moved sprite overlaps the divider, it covers it.\n  50: \n  51:     Key insight:\n  52:     The red row is not a generic floor: only one-column sprites pass through to the\n  53:     bottom, while wider sprites are registered by their widest horizontal segment.\n  54:     \"\"\"\n  55:     g = np.asarray(grid, dtype=int)\n  56:     H, W = g.shape\n  57:     bg = int(get_bg(g))\n  58:     line_r, line_color = _divider_row(g, bg)\n  59: \n  60:     non_bg_colors = set(map(int, g.ravel())) - {bg}\n  61:     sprite_colors = non_bg_colors - {line_color}\n  62:     assert len(sprite_colors) == 1, \"expected exactly one sprite color\"\n  63:     sprite_color = next(iter(sprite_colors))\n  64: \n  65:     sprites = find_components(\n  66:         g,\n  67:         bg=bg,\n  68:         colors=[sprite_color],\n  69:         connectivity=4,\n  70:         monochromatic=True,\n  71:     )\n  72:     assert sprites, \"expected at least one sprite\"\n  73: \n  74:     out = g.copy()\n  75:     out[g == sprite_color] = bg\n  76:     occupied = np.zeros((H, W), dtype=bool)\n  77: \n  78:     for sprite in sprites:\n  79:         coords = sprite[\"coords\"]\n  80:         _r0, c0, r1, c1 = map(int, sprite[\"bbox\"])\n  81:         assert r1 < line_r, \"all sprites must begin above the divider\"\n  82: \n  83:         if c0 == c1:\n  84:             shift = H - 1 - r1\n  85:             assert shift >= 0\n  86:             assert int(out[line_r, c0]) == line_color\n  87:             out[line_r, c0] = bg\n  88:         else:\n  89:             widest_r = _unique_widest_row(coords)\n  90:             shift = line_r - 1 - widest_r\n  91:             assert shift >= 0\n  92: \n  93:         moved = coords.copy()\n  94:         moved[:, 0] += shift\n  95:         assert np.all((0 <= moved[:, 0]) & (moved[:, 0] < H))\n  96:         assert np.all((0 <= moved[:, 1]) & (moved[:, 1] < W))\n  97: \n  98:         for rr, cc in moved:\n  99:             r = int(rr)\n 100:             c = int(cc)\n 101:             assert not occupied[r, c], \"moved sprites must not overlap\"\n 102:             occupied[r, c] = True\n 103:             out[r, c] = sprite_color\n 104: \n 105:     return out\n 106: \n 107: # --------------- generator (att2) ---------------\n 108: \n 109: # Canvas, palette, and divider bounds.\n 110: MIN_GRID_SIZE, LARGE_GRID_MIN, MAX_GRID_SIZE = 7, 14, 18\n 111: LARGE_GRID_PROB, PALETTE_SIZE, DIVIDER_MARGIN = 0.35, 10, 3\n 112: ADJACENT_ROW_OFFSET = 1\n 113: \n 114: # Sprite counts, spacing, and retry limits.\n 115: MIN_SPRITE_COUNT, MAX_SPRITE_COUNT = 1, 5\n 116: MAX_SINGLE_SPRITES, MAX_MULTI_SPRITES = 2, 3\n 117: GAP_COLUMNS, INPUT_GAP_TO_DIVIDER = 1, 1\n 118: GENERATION_RETRIES = 300\n 119: \n 120: # Sprite geometry.\n 121: MIN_SPRITE_HEIGHT, MAX_SINGLE_HEIGHT, MAX_MULTI_HEIGHT = 1, 7, 5\n 122: SINGLE_WIDTH, MIN_MULTI_WIDTH, MAX_MULTI_WIDTH = 1, 2, 3\n 123: WIDE_MULTI_PROB = 0.5\n 124: \n 125: \n 273: def generate_input() -> np.ndarray:\n 274:     for _ in range(GENERATION_RETRIES):\n 275:         grid = _gen_attempt()\n 276:         if grid is not None:\n 277:             return grid\n 278:     raise RuntimeError(\"failed to generate a valid 84ba50d3 input\")\n\n","exit_code":0,"status":"completed"}}
