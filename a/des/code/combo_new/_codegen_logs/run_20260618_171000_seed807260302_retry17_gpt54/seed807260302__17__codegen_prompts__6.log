ction and width; the network activates as a chain reaction from one start point.\n  21:     \"\"\"\n  22:     g = np.array(grid, dtype=int)\n  23:     H, W = g.shape\n  24:     bg = int(get_bg(g))\n  25: \n  26:     # --- STEP 1) Detect the start \"port\" (red vertical segment with a non-red cap above) ---\n  27:     start_candidates: list[tuple[int, int, int, list[tuple[int, int]]]] = []\n  28: \n  29:     for col in colors_present(g, exclude={bg}):\n  30:         for coords in components_mask(g == int(col), connectivity=8):\n  31:             if coords.size == 0:\n  32:                 continue\n  33:             r0, c0 = coords.min(axis=0)\n  34:             r1, c1 = coords.max(axis=0)\n  35:             r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n  36: \n  37:             # thin vertical segment, height>=2, touches bottom\n  38:             if c0 != c1 or (r1 - r0 + 1) < 2:\n  39:                 continue\n  40:             if r1 != int(H - 1):\n  41:                 continue\n  42:             # solid vertical segment\n  43:             if any(int(g[rr, c0]) != int(col) for rr in range(int(r0), int(r1) + 1)):\n  44:                 continue\n  45:             if int(r0) - 1 < 0:\n  46:                 continue\n  47:             cap = int(g[int(r0) - 1, int(c0)])\n  48:             if cap == int(bg) or cap == int(col):\n  49:                 continue\n  50: \n  51:             start_candidates.append(\n  52:                 (\n  53:                     int(col),\n  54:                     int(cap),\n  55:                     int(c0),\n  56:                     [(int(rr), int(c0)) for rr in range(int(r0), int(r1) + 1)],\n  57:                 )\n  58:             )\n  59: \n  60:     assert len(start_candidates) == 1\n  61:     red_col, yellow_col, start_col, start_seg = start_candidates[0]\n  62: \n  63:     # --- STEP 2) Identify blob colors ---\n  64:     # Blue = dominant remaining color by pixel count (excluding bg/start colors).\n  65:     counts = Counte