{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/2f767503.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Erase each target-color object crossed by the ray pointed by the bar-and-control marker.\n\n    Input structure:\n    - The background is the dominant color.\n    - There is one three-pixel straight marker bar and one singleton control pixel adjacent to the bar center.\n    - The remaining non-background color forms multiple 4-connected target objects.\n\n    Rule:\n    - Cast a straight ray from the marker bar center in the direction away from the adjacent control pixel.\n    - Find every 4-connected target-color object that intersects that ray.\n    - Recolor all pixels of those hit target objects to the background; all other pixels stay unchanged.\n\n    Key insight:\n    - The whole object is erased when the center ray touches any of its pixels; the full marker bar width is not swept.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg, target_color, center, step = _roles(g)\n    height, width = g.shape\n\n    ray: set[tuple[int, int]] = set()\n    r = center[0] + step[0]\n    c = center[1] + step[1]\n    while 0 <= r < height and 0 <= c < width:\n        ray.add((int(r), int(c)))\n        r += step[0]\n        c += step[1]\n\n    target_objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[target_color])\n    hit_objects = [\n        obj\n        for obj in target_objects\n        if any(tuple(map(int, coord)) in ray for coord in obj[\"coords\"])\n    ]\n    assert hit_objects, \"expected at least one target object intersecting the marker ray\"\n\n    out = g.copy()\n    for obj in hit_objects:\n        coords = obj[\"coords\"]\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette.\nBG = 7\nTARGET = 4\nBAR = 5\nCONTROL = 9\n\n# Canvas size bounds.\nHEIGHT_MIN, HEIGHT_MAX = 9, 14\nWIDTH_MIN, WIDTH_MAX = 10, 13\n\n# Marker and ray geometry.\nBAR_CENTER_MARGIN = 2\nRAY_LEN_MIN, RAY_LEN_MAX = 6, 8\nNEIGHBOR_STEPS_4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\nAXIS_HORIZONTAL, AXIS_VERTICAL = \"horizontal\", \"vertical\"\n\n# Target component counts, density, and size caps.\nDENSITY_MIN, DENSITY_MAX = 0.17, 0.21\nOBJECT_COUNT_MIN, OBJECT_COUNT_MAX = 10, 18\nEXPECTED_HIT_OBJECTS, CONNECTIVITY = 2, 4\nHIT_EXTRA_CAP, NON_HIT_EXTRA_CAP = 6, 4\n\n# Retry budget for rejection sampling.\nGENERATION_ATTEMPTS = 300\n\n\ndef _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:\n    out: list[tuple[int, int]] = []\n    for dr, dc in NEIGHBOR_STEPS_4:\n        rr, cc = r + dr, c + dc\n        if 0 <= rr < h and 0 <= cc < w:\n            out.append((rr, cc))\n    return out\n\n\ndef _ray_cells(center: tuple[int, int], step: tuple[int, int], h: int, w: int) -> list[tuple[int, int]]:\n    r, c = center[0] + step[0], center[1] + step[1]\n    cells: list[tuple[int, int]] = []\n    while 0 <= r < h and 0 <= c < w:\n        cells.append((r, c))\n        r += step[0]\n        c += step[1]\n    return cells\n\n\ndef _marker_candidates(\n    h: int,\n    w: int,\n) -> list[tuple[str, tuple[int, int], tuple[int, int], tuple[int, int]]]:\n    candidates: list[tuple[str, tuple[int, int], tuple[int, int], tuple[int, int]]] = []\n\n    for length in range(RAY_LEN_MIN, RAY_LEN_MAX + 1):\n        for c in range(BAR_CENTER_MARGIN, w - BAR_CENTER_MARGIN):\n            if 1 <= length <= h - 2:\n                candidates.append((AXIS_HORIZONTAL, (length, c), (-1, 0), (length + 1, c)))\n            r = h - 1 - length\n            if 1 <= r <= h - 2:\n                candidates.append((AXIS_HORIZONTAL, (r, c), (1, 0), (r - 1, c)))\n\n        for r in range(BAR_CENTER_MARGIN, h - BAR_CENTER_MARGIN):\n            if 1 <= length <= w - 2:\n                candidates.append((AXIS_VERTICAL, (r, length), (0, -1), (r, length + 1)))\n            c = w - 1 - length\n            if 1 <= c <= w - 2:\n                candidates.append((AXIS_VERTICAL, (r, c), (0, 1), (r, c - 1)))\n\n    return candidates\n\n\ndef _bar_cells(axis: str, center: tuple[int, int]) -> list[tuple[int, int]]:\n    r, c = center\n    if axis == AXIS_HORIZONTAL:\n        return [(r, c - 1), (r, c), (r, c + 1)]\n    return [(r - 1, c), (r, c), (r + 1, c)]\n\n\ndef _place_marker(g: np.ndarray) -> tuple[tuple[int, int], tuple[int, int], set[tuple[int, int]], list[tuple[int, int]]] | None:\n    \"\"\"Draw one marker and return center, ray step, occupied marker cells, and ray cells.\"\"\"\n    h, w = g.shape\n    candidates = _marker_candidates(h, w)\n    if not candidates:\n        return None\n\n    axis, center, step, control = random.choice(candidates)\n    marker: set[tuple[int, int]] = {control}\n    bar_cells = _bar_cells(axis, center)\n    marker.update(bar_cells)\n\n    for rr, cc in bar_cells:\n        g[rr, cc] = BAR\n    g[control] = CONTROL\n    return center, step, marker, _ray_cells(center, step, h, w)\n\n\ndef _feasible_size_choices(area: int) -> list[tuple[int, int, int]]:\n    lo = math.ceil(area * DENSITY_MIN)\n    hi = math.floor(area * DENSITY_MAX)\n    choices: list[tuple[int, int, int]] = []\n    for total_pixels in range(lo, hi + 1):\n        for count in range(OBJECT_COUNT_MIN, OBJECT_COUNT_MAX + 1):\n            if count > total_pixels:\n                continue\n            extras = total_pixels - count\n            caps = [HIT_EXTRA_CAP] * EXPECTED_HIT_OBJECTS + [NON_HIT_EXTRA_CAP] * (count - EXPECTED_HIT_OBJECTS)\n            max_clustered = (count - 1) // EXPECTED_HIT_OBJECTS\n            for clustered in range(max_clustered + 1):\n                if clustered > extras:\n                    continue\n                if extras <= sum(sorted(caps, reverse=True)[:clustered]):\n                    choices.append((total_pixels, count, clustered))\n    return choices\n\n\ndef _choose_sizes(area: int) -> tuple[list[int], list[int]] | None:\n    choices = _feasible_size_choices(area)\n    if not choices:\n        return None\n\n    total_pixels, count, clustered = random.choice(choices)\n    extras = total_pixels - count\n    caps = [HIT_EXTRA_CAP] * EXPECTED_HIT_OBJECTS + [NON_HIT_EXTRA_CAP] * (count - EXPECTED_HIT_OBJECTS)\n\n    if clustered == 0:\n        if extras != 0:\n            return None\n        return [1] * EXPECTED_HIT_OBJECTS, [1] * (count - EXPECTED_HIT_OBJECTS)\n\n    combos = [\n        combo\n        for combo in itertools.combinations(range(count), clustered)\n        if extras <= sum(caps[i] for i in combo)\n    ]\n    if not combos:\n        return None\n\n    chosen = random.choice(combos)\n    sizes = [1] * count\n    for idx in chosen:\n        sizes[idx] += 1\n    remaining = extras - clustered\n\n    while remaining > 0:\n        available = [idx for idx in chosen if sizes[idx] < caps[idx] + 1]\n        if not available:\n            return None\n        idx = random.choice(available)\n        sizes[idx] += 1\n        remaining -= 1\n\n    return sizes[:EXPECTED_HIT_OBJECTS], sizes[EXPECTED_HIT_OBJECTS:]\n\n\ndef _touches_existing_target(\n    r: int,\n    c: int,\n    existing: np.ndarray,\n    current: set[tuple[int, int]],\n) -> bool:\n    h, w = existing.shape\n    for rr, cc in _neighbors4(r, c, h, w):\n        if existing[rr, cc] and (rr, cc) not in current:\n            return True\n    return False\n\n\ndef _place_object(\n    g: np.ndarray,\n    size: int,\n    forbidden: set[tuple[int, int]],\n    seed_pool: list[tuple[int, int]] | None = None,\n) -> set[tuple[int, int]] | None:\n    \"\"\"Grow one 4-connected target object without 4-touching prior target objects.\"\"\"\n    h, w = g.shape\n    existing = g == TARGET\n\n    if seed_pool is None:\n        seed_pool = [(r, c) for r in range(h) for c in range(w)]\n\n    seeds = [\n        (r, c)\n        for r, c in seed_pool\n        if (r, c) not in forbidden\n        and g[r, c] == BG\n        and not _touches_existing_target(r, c, existing, set())\n    ]\n    if not seeds:\n        return None\n\n    current = {random.choice(seeds)}\n    while len(current) < size:\n        frontier: set[tuple[int, int]] = set()\n        for r, c in current:\n            frontier.update(_neighbors4(r, c, h, w))\n\n        options = [\n            (r, c)\n            for r, c in frontier\n            if (r, c) not in current\n            and (r, c) not in forbidden\n            and g[r, c] == BG\n            and not _touches_existing_target(r, c, existing, current)\n        ]\n        if not options:\n            return None\n        current.add(random.choice(options))\n\n    for r, c in current:\n        g[r, c] = TARGET\n    return current\n\n\ndef _hit_count(g: np.ndarray, ray: set[tuple[int, int]]) -> int:\n    objects = find_components(g, bg=BG, connectivity=CONNECTIVITY, monochromatic=True, colors=[TARGET])\n    return sum(any((int(r), int(c)) in ray for r, c in obj[\"coords\"]) for obj in objects)\n\n\ndef _place_objects(\n    g: np.ndarray,\n    sizes: list[int],\n    forbidden: set[tuple[int, int]],\n    seed_pool: list[tuple[int, int]] | None = None,\n) -> bool:\n    for size in sorted(sizes, reverse=True):\n        if _place_object(g, size, forbidden, seed_pool) is None:\n            return False\n    return True\n\n\ndef _valid_generated_pair(inp: np.ndarray, out: np.ndarray, ray: set[tuple[int, int]]) -> bool:\n    objects = find_components(inp, bg=BG, connectivity=CONNECTIVITY, monochromatic=True, colors=[TARGET])\n    density = float(np.count_nonzero(inp == TARGET)) / inp.size\n    if len(objects) < OBJECT_COUNT_MIN or len(objects) > OBJECT_COUNT_MAX:\n        return False\n    if not (DENSITY_MIN <= density <= DENSITY_MAX):\n        return False\n    if _hit_count(inp, ray) != EXPECTED_HIT_OBJECTS:\n        return False\n\n    try:\n        actual = main(inp)\n    except Exception:\n        return False\n    return np.array_equal(actual, out)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    h = random.randint(HEIGHT_MIN, HEIGHT_MAX)\n    w = random.randint(WIDTH_MIN, WIDTH_MAX)\n    out = np.full((h, w), BG, dtype=int)\n\n    marker = _place_marker(out)\n    if marker is None:\n        return None\n    _, _, marker_cells, ray_cells = marker\n    ray = set(ray_cells)\n\n    sizes = _choose_sizes(out.size)\n    if sizes is None:\n        return None\n    hit_sizes, non_hit_sizes = sizes\n\n    blocked_for_output = marker_cells | ray\n    if not _place_objects(out, non_hit_sizes, blocked_for_output):\n        return None\n\n    inp = out.copy()\n    if not _place_objects(inp, hit_sizes, marker_cells, ray_cells):\n        return None\n\n    if not _valid_generated_pair(inp, out, ray):\n        return None\n\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/c3fa4749.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/c3fa4749.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor each side-marked multicolor object embedded in a monochrome panel to its marker color.\n\n    Input structure:\n    - Same-color 4-connected components form monochrome panel regions.\n    - The bounding box of a panel may contain 4-connected non-panel-color objects.\n    - A target object touches exactly one side of its panel bbox, and all of its\n      pixels on that side have one marker color.\n\n    Rule:\n    - For every target object, fill any panel-colored holes enclosed by the object.\n    - Recolor the object and filled holes to the side marker color.\n    - Leave all other pixels unchanged.\n\n    Key insight:\n    - A multicolor object's single contact side identifies both which object should\n      be normalized and which color should replace it.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    _assert_each_panel_has_multicolor_object(g)\n\n    planned: dict[tuple[int, int], int] = {}\n    selected_objects = 0\n\n    for panel_color in colors_present(g):\n        for panel_coords in components_mask(g == panel_color, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(panel_coords)\n            region = g[r0 : r1 + 1, c0 : c1 + 1]\n\n            for obj_coords in components_mask(region != panel_color, connectivity=4):\n                obj_mask = _mask_from_coords(region.shape, obj_coords)\n                marker = _single_side_marker(region, obj_mask)\n                if marker is None:\n                    continue\n\n                selected_objects += 1\n                paint_mask = binary_fill_holes(obj_mask).astype(bool)\n                for rr, cc in np.argwhere(paint_mask):\n                    coord = (int(r0 + rr), int(c0 + cc))\n                    previous = planned.get(coord)\n                    assert previous is None or previous == marker, \"conflicting side-marker recolors\"\n                    planned[coord] = int(marker)\n\n    assert selected_objects > 0, \"expected at least one side-marked object\"\n    assert any(int(g[r, c]) != color for (r, c), color in planned.items()), \"expected at least one visible recolor\"\n\n    out = g.copy()\n    for (r, c), color in planned.items():\n        out[r, c] = color\n    return out\n\n# --------------- generator (att1) ---------------\nCOLOR_COUNT = 10\nGRID_HEIGHT_RANGE = (20, 30)\nGRID_WIDTH_RANGE = (20, 30)\nPANEL_COUNT_RANGE = (2, 4)\nPANEL_HEIGHT_RANGE = (5, 12)\nPANEL_WIDTH_RANGE = (5, 10)\nPANEL_PLACEMENT_TRIES = 50\nTARGET_COUNT_CHOICES = [1, 2, 3, 4]\nTARGET_COUNT_WEIGHTS = [2, 3, 3, 2]\nMAX_TARGETS_PER_PANEL = 2\nDOUBLE_TARGET_PROB = 0.25\nTARGET_SIZE_RANGE = (3, 13)\nGENERATION_ATTEMPTS = 300\nNEIGHBORS_4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\nSIDE_TOP, SIDE_BOTTOM, SIDE_LEFT, SIDE_RIGHT = range(4)\n\n\ndef _on_side(r, c, ph, pw, side):\n    if side == SIDE_TOP:\n        return r == 0\n    if side == SIDE_BOTTOM:\n        return r == ph - 1\n    if side == SIDE_LEFT:\n        return c == 0\n    return c == pw - 1\n\n\ndef _on_other_side(r, c, ph, pw, side):\n    return (\n        (side != SIDE_TOP and r == 0)\n        or (side != SIDE_BOTTOM and r == ph - 1)\n        or (side != SIDE_LEFT and c == 0)\n        or (side != SIDE_RIGHT and c == pw - 1)\n    )\n\n\ndef _can_grow_into(r, c, ph, pw, side, blob, available_mask):\n    return (\n        0 <= r < ph\n        and 0 <= c < pw\n        and (r, c) not in blob\n        and not _on_other_side(r, c, ph, pw, side)\n        and not _on_side(r, c, ph, pw, side)\n        and available_mask[r, c]\n    )\n\n\ndef _extend_frontier(frontier, r, c, ph, pw, side, blob, available_mask):\n    for dr, dc in NEIGHBORS_4:\n        nr, nc = r + dr, c + dc\n        if _can_grow_into(nr, nc, ph, pw, side, blob, available_mask):\n            frontier.append((nr, nc))\n\n\ndef _grow_blob_constrained(ph, pw, contact_cells, target_size, side, available_mask):\n    \"\"\"Grow a 4-connected blob from contact_cells avoiding other sides.\"\"\"\n    blob = set(tuple(x) for x in contact_cells)\n    frontier = []\n    for r, c in blob:\n        _extend_frontier(frontier, r, c, ph, pw, side, blob, available_mask)\n\n    while len(blob) < target_size and frontier:\n        idx = random.randint(0, len(frontier) - 1)\n        cell = frontier[idx]\n        frontier[idx] = frontier[-1]\n        frontier.pop()\n        if cell in blob:\n            continue\n        blob.add(cell)\n        r, c = cell\n        _extend_frontier(frontier, r, c, ph, pw, side, blob, available_mask)\n\n    if len(blob) < 2:\n        return None\n    return blob\n\n\ndef _make_noise_grid(H, W, avoid_colors_at=None):\n    \"\"\"Create random noise where no two 4-adjacent cells share a color.\"\"\"\n    grid = np.zeros((H, W), dtype=int)\n    if avoid_colors_at is None:\n        avoid_colors_at = {}\n    for r in range(H):\n        for c in range(W):\n            neighbors = set()\n            if r > 0: neighbors.add(int(grid[r-1, c]))\n            if c > 0: neighbors.add(int(grid[r, c-1]))\n            extra = avoid_colors_at.get((r, c), set())\n            forbidden = neighbors | extra\n            available = [x for x in range(COLOR_COUNT) if x not in forbidden]\n            if not available:\n                available = [x for x in range(COLOR_COUNT) if x not in neighbors]\n            grid[r, c] = random.choice(available)\n    return grid\n\n\ndef _panel_has_multicolor_object(grid, panel_color, r0, c0, ph, pw):\n    region = grid[r0:r0+ph, c0:c0+pw]\n    for obj_coords in components_mask(region != panel_color, connectivity=4):\n        obj_colors = {int(region[r, c]) for r, c in obj_coords}\n        if len(obj_colors) >= 2:\n            return True\n    return False\n\n\ndef _place_multicolor_corner_distractor(grid, output_grid, panel_color, r0, c0, ph, pw, available):\n    color_choices = [c for c in range(COLOR_COUNT) if c != panel_color]\n    if len(color_choices) < 2:\n        return False\n\n    corner_shapes = [\n        [(0, 0), (0, 1), (1, 0), (1, 1)],\n        [(0, pw - 2), (0, pw - 1), (1, pw - 2), (1, pw - 1)],\n        [(ph - 2, 0), (ph - 2, 1), (ph - 1, 0), (ph - 1, 1)],\n        [(ph - 2, pw - 2), (ph - 2, pw - 1), (ph - 1, pw - 2), (ph - 1, pw - 1)],\n    ]\n    random.shuffle(corner_shapes)\n\n    for cells in corner_shapes:\n        if not all(0 <= r < ph and 0 <= c < pw and available[r, c] for r, c in cells):\n            continue\n\n        cell_set = set(cells)\n        isolated = True\n        for r, c in cells:\n            for dr, dc in NEIGHBORS_4:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < ph and 0 <= nc < pw and (nr, nc) not in cell_set:\n                    if int(grid[r0 + nr, c0 + nc]) != panel_color:\n                        isolated = False\n                        break\n            if not isolated:\n                break\n        if not isolated:\n            continue\n\n        colors = random.sample(color_choices, 2)\n        for idx, (r, c) in enumerate(cells):\n            value = colors[idx % 2]\n            grid[r0 + r, c0 + c] = value\n            output_grid[r0 + r, c0 + c] = value\n            available[r, c] = False\n        return True\n\n    return False\n\n\ndef _place_panels(H, W, panel_colors):\n    panels_info = []\n    occupied = np.zeros((H, W), dtype=bool)\n\n    for pc in panel_colors:\n        ph = random.randint(*PANEL_HEIGHT_RANGE)\n        pw = random.randint(*PANEL_WIDTH_RANGE)\n        placed = False\n        for _ in range(PANEL_PLACEMENT_TRIES):\n            r0 = random.randint(0, H - ph)\n            c0 = random.randint(0, W - pw)\n            if not occupied[r0:r0+ph, c0:c0+pw].any():\n                placed = True\n                break\n        if not placed:\n            return None\n        occupied[r0:r0+ph, c0:c0+pw] = True\n        panels_info.append((pc, r0, c0, ph, pw))\n    return panels_info, occupied\n\n\ndef _build_panel_avoidance(H, W, panels_info, occupied):\n    avoid_at = {}\n    for pc, r0, c0, ph, pw in panels_info:\n        for r in range(r0, r0+ph):\n            for c in [c0-1, c0+pw]:\n                if 0 <= r < H and 0 <= c < W and not occupied[r, c]:\n                    avoid_at.setdefault((r, c), set()).add(pc)\n        for c in range(c0, c0+pw):\n            for r in [r0-1, r0+ph]:\n                if 0 <= r < H and 0 <= c < W and not occupied[r, c]:\n                    avoid_at.setdefault((r, c), set()).add(pc)\n    return avoid_at\n\n\ndef _assign_target_counts(num_panels):\n    total_desired = random.choices(TARGET_COUNT_CHOICES, weights=TARGET_COUNT_WEIGHTS, k=1)[0]\n    total_desired = min(total_desired, num_panels * MAX_TARGETS_PER_PANEL)\n    panel_target_count = [0] * num_panels\n    shuffled = list(range(num_panels))\n    random.shuffle(shuffled)\n    remaining = total_desired\n    for pi in shuffled:\n        if remaining <= 0:\n            break\n        assign = min(\n            remaining,\n            MAX_TARGETS_PER_PANEL if random.random() < DOUBLE_TARGET_PROB and remaining >= 2 else 1,\n        )\n        panel_target_count[pi] = assign\n        remaining -= assign\n    return panel_target_count\n\n\ndef _available_side_cells(available, ph, pw, side):\n    if side == SIDE_TOP:\n        return [(0, c) for c in range(1, pw - 1) if available[0, c]]\n    if side == SIDE_BOTTOM:\n        return [(ph - 1, c) for c in range(1, pw - 1) if available[ph - 1, c]]\n    if side == SIDE_LEFT:\n        return [(r, 0) for r in range(1, ph - 1) if available[r, 0]]\n    return [(r, pw - 1) for r in range(1, ph - 1) if available[r, pw - 1]]\n\n\ndef _paint_target(grid, output_grid, available, panel, side):\n    pc, r0, c0, ph, pw = panel\n    marker = random.choice([c for c in range(COLOR_COUNT) if c != pc])\n    side_cells = _available_side_cells(available, ph, pw, side)\n    if not side_cells:\n        return False\n\n    contact_cells = [random.choice(side_cells)]\n    target_size = random.randint(*TARGET_SIZE_RANGE)\n    blob = _grow_blob_constrained(ph, pw, contact_cells, target_size, side, available)\n    if blob is None:\n        return False\n\n    contact_on_side = {(r, c) for r, c in blob if _on_side(r, c, ph, pw, side)}\n    interior = blob - contact_on_side\n    if not interior:\n        return False\n\n    blob_mask = np.zeros((ph, pw), dtype=bool)\n    for r, c in blob:\n        blob_mask[r, c] = True\n    filled_mask = binary_fill_holes(blob_mask)\n    hole_cells = set(zip(*np.where(filled_mask & ~blob_mask)))\n\n    for r, c in blob:\n        available[r, c] = False\n    for r, c in hole_cells:\n        available[r, c] = False\n\n    for lr, lc in blob:\n        output_grid[r0+lr, c0+lc] = marker\n    for lr, lc in hole_cells:\n        output_grid[r0+lr, c0+lc] = marker\n\n    for lr, lc in contact_on_side:\n        grid[r0+lr, c0+lc] = marker\n    non_panel_non_marker = [c for c in range(COLOR_COUNT) if c != pc and c != marker]\n    if not non_panel_non_marker:\n        non_panel_non_marker = [c for c in range(COLOR_COUNT) if c != pc]\n    for lr, lc in interior:\n        grid[r0+lr, c0+lc] = random.choice(non_panel_non_marker)\n    return True\n\n\ndef _paint_targets(grid, output_grid, panels_info, panel_target_count, panel_available):\n    total_targets_placed = 0\n    for pi in range(len(panels_info)):\n        if panel_target_count[pi] == 0:\n            continue\n        panel = panels_info[pi]\n        _, _, _, ph, pw = panel\n        available = panel_available[pi]\n        used_sides = set()\n\n        for _ in range(panel_target_count[pi]):\n            available_sides = [s for s in range(4) if s not in used_sides]\n            if not available_sides:\n                break\n            side = random.choice(available_sides)\n            used_sides.add(side)\n\n            if _paint_target(grid, output_grid, available, panel, side):\n                total_targets_placed += 1\n    return total_targets_placed\n\n\ndef _ensure_multicolor_objects(grid, output_grid, panels_info, panel_available):\n    for pi, (pc, r0, c0, ph, pw) in enumerate(panels_info):\n        if _panel_has_multicolor_object(grid, pc, r0, c0, ph, pw):\n            continue\n        if not _place_multicolor_corner_distractor(\n            grid, output_grid, pc, r0, c0, ph, pw, panel_available[pi]\n        ):\n            return False\n    return True\n\n\ndef _verified_input(grid, output_grid):\n    try:\n        result = main(grid)\n        if np.array_equal(result, output_grid):\n            return grid\n    except (AssertionError, Exception):\n        pass\n    return None\n\n\ndef _gen_attempt():\n    H = random.randint(*GRID_HEIGHT_RANGE)\n    W = random.randint(*GRID_WIDTH_RANGE)\n\n    num_panels = random.randint(*PANEL_COUNT_RANGE)\n    panel_colors = random.sample(range(COLOR_COUNT), num_panels)\n\n    placed = _place_panels(H, W, panel_colors)\n    if placed is None:\n        return None\n    panels_info, occupied = placed\n\n    grid = _make_noise_grid(H, W, _build_panel_avoidance(H, W, panels_info, occupied))\n    for pc, r0, c0, ph, pw in panels_info:\n        grid[r0:r0+ph, c0:c0+pw] = pc\n\n    output_grid = grid.copy()\n    panel_available = [np.ones((ph, pw), dtype=bool) for _, _, _, ph, pw in panels_info]\n    panel_target_count = _assign_target_counts(num_panels)\n\n    if _paint_targets(grid, output_grid, panels_info, panel_target_count, panel_available) == 0:\n        return None\n    if not _ensure_multicolor_objects(grid, output_grid, panels_info, panel_available):\n        return None\n    return _verified_input(grid, output_grid)\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
