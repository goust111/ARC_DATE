{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/753ea09b.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg, label_mask, neighbors4, paste\nimport itertools\nimport random\n\n\ndef _unique_largest_color(g: np.ndarray, colors: list[int]) -> int:\n    counts = Counter(int(v) for v in g.ravel())\n    ranked = sorted(colors, key=lambda color: counts[int(color)], reverse=True)\n    assert len(ranked) >= 2, \"expected at least two candidate colors\"\n    assert counts[ranked[0]] > counts[ranked[1]], \"foreground majority must be unique\"\n    return int(ranked[0])\n\n\ndef _long_component_ids(lab: np.ndarray, n: int) -> set[int]:\n    h = int(lab.shape[0])\n    min_row_span = max(1, h // 3)\n    ids: set[int] = set()\n    for comp_id in range(1, n + 1):\n        coords = np.argwhere(lab == comp_id)\n        assert coords.size > 0, \"component labels must be nonempty\"\n        r0 = int(coords[:, 0].min())\n        r1 = int(coords[:, 0].max())\n        if r1 - r0 + 1 >= min_row_span:\n            ids.add(int(comp_id))\n    assert len(ids) >= 2, \"expected at least two long contour components\"\n    return ids\n\n\ndef _two_exterior_bg_ids(bg_lab: np.ndarray, n_bg: int) -> set[int]:\n    assert n_bg >= 3, \"expected interior and exterior background regions\"\n    sizes = {comp_id: int((bg_lab == comp_id).sum()) for comp_id in range(1, n_bg + 1)}\n    size_values = sorted(sizes.values(), reverse=True)\n    assert size_values[1] > size_values[2], \"two exterior regions must be separated by size\"\n    cutoff = size_values[1]\n    exterior = {comp_id for comp_id, size in sizes.items() if size >= cutoff}\n    assert len(exterior) == 2, \"expected exactly two exterior background regions\"\n    return exterior\n\n\ndef _touches_long_contour(\n    coords: np.ndarray,\n    fill_lab: np.ndarray,\n    long_ids: set[int],\n) -> bool:\n    for r, c in coords:\n        for rr, cc in neighbors4(int(r), int(c)):\n            if 0 <= rr < fill_lab.shape[0] and 0 <= cc < fill_lab.shape[1]:\n                if int(fill_lab[rr, cc]) in long_ids:\n                    return True\n    return False\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the small background compartments bounded by the long contour color.\n\n    Input structure:\n    - The grid has one dominant background color and two foreground colors.\n    - The more frequent foreground color forms long 8-connected contour fragments.\n    - The other foreground color is a fixed distractor/obstacle color that partitions\n      the background but is never recolored.\n\n    Rule:\n    - Split the background into 4-connected regions using all foreground pixels as\n      barriers.\n    - Keep the two largest background regions as the outside of the contour drawing.\n    - Recolor every other background region that touches a long contour component\n      to the contour color; leave all foreground pixels unchanged.\n\n    Key insight:\n    The apparent area fill is exactly a component-level fill of bounded background\n    compartments, not a row-wise interpolation between individual contour pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    foreground = colors_present(g, exclude={bg})\n    assert len(foreground) == 2, \"expected exactly two foreground colors\"\n\n    fill_color = _unique_largest_color(g, foreground)\n    fill_lab, _n_fill = label_mask(g == fill_color, connectivity=8)\n    long_ids = _long_component_ids(fill_lab, _n_fill)\n\n    bg_lab, n_bg = label_mask(g == bg, connectivity=4)\n    exterior_ids = _two_exterior_bg_ids(bg_lab, n_bg)\n\n    out = g.copy()\n    for comp_id in range(1, n_bg + 1):\n        if comp_id in exterior_ids:\n            continue\n        coords = np.argwhere(bg_lab == comp_id)\n        if _touches_long_contour(coords, fill_lab, long_ids):\n            out[bg_lab == comp_id] = fill_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\nH, W = 30, 30\nGRID_SHAPE = (H, W)\nARC_COLOR_COUNT = 10\n\n# Long contour path layout.\nPATH_COUNT_OPTIONS = (2, 3)\nPATH_STEP_OPTIONS = (-1, 0, 1)\nPATH_GAP_MIN, PATH_GAP_MAX = 2, 5\nPATH_LEFT_MIN_COL, PATH_RIGHT_MARGIN = 2, 3\nPATH_START_MIN_COL = 3\nPATH_START_RIGHT_MARGIN = 4\nPATH_FAR_END_MIN_CHOICES, PATH_FAR_END_PROB, PATH_FAR_END_DELTA = 8, 0.7, 5\nPATH_SCORING_CANDIDATES = 5\nPATH_MIN_MOVES = 12\n\n# Contour distractors and extra contour pixels.\nOUTSIDE_MARGIN = 2\nOUTSIDE_SIDE_OPTIONS = (-1, 1)\nSHORT_FRAGMENT_COUNT_MIN, SHORT_FRAGMENT_COUNT_MAX = 3, 5\nSHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX = 1, 4\nSHORT_FRAGMENT_ATTEMPTS = 200\nSHORT_FRAGMENT_PATH_PADDING = 3\nCONTOUR_PIXELS_MIN, CONTOUR_PIXELS_MAX = 81, 108\n\n# Obstacle bars and scattered clusters.\nBAR_SEGMENT_MAX = 11\nSINGLE_CHANNEL_BARS_MIN, SINGLE_CHANNEL_BARS_MAX = 5, 11\nMULTI_CHANNEL_TOTAL_BARS_MIN, MULTI_CHANNEL_TOTAL_BARS_MAX = 4, 10\nMULTI_CHANNEL_INITIAL_BARS = 2\nMULTI_CHANNEL_MAX_BARS = 5\nBAR_WIDTH_MIN, BAR_WIDTH_MAX = 1, 5\nOBSTACLE_PIXELS_MIN, OBSTACLE_PIXELS_MAX = 36, 63\nOBSTACLE_EXTRA_PIXELS_MIN = 8\nOBSTACLE_OUTSIDE_QUOTA_MIN, OBSTACLE_OUTSIDE_QUOTA_MAX = 8, 16\nOBSTACLE_CLUSTER_SIZE_MIN, OBSTACLE_CLUSTER_SIZE_MAX = 1, 5\nOBSTACLE_ATTEMPTS = 300\nOBSTACLE_ZONE_OPTIONS = (\"outside\", \"inside\", \"any\")\n\n# Component validation.\nBG_REGIONS_MIN, BG_REGIONS_MAX = 8, 14\nEXTERIOR_REGION_COUNT = 2\nINTERIOR_REGIONS_MIN, INTERIOR_REGIONS_MAX = 6, 12\nINTERIOR_REGION_AREA_MAX = 57\nLONG_COMPONENT_MIN_SPAN = H // 3\nLONG_COMPONENT_COUNT_OPTIONS = (2, 3)\n\n# Retry limits and local neighborhoods.\nGENERATION_ATTEMPTS = 300\nNEIGHBOR_DELTAS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nNEIGHBOR_DELTAS_8 = NEIGHBOR_DELTAS_4 + ((-1, -1), (-1, 1), (1, -1), (1, 1))\n\n\ndef _color_choices() -> tuple[int, int, int]:\n    colors = list(range(ARC_COLOR_COUNT))\n    random.shuffle(colors)\n    return int(colors[0]), int(colors[1]), int(colors[2])\n\n\ndef _path_columns(path_count: int) -> list[list[int]] | None:\n    gaps = [random.randint(PATH_GAP_MIN, PATH_GAP_MAX) for _ in range(path_count - 1)]\n    total_width = sum(gap + 1 for gap in gaps)\n    start_hi = W - PATH_START_RIGHT_MARGIN - total_width\n    if start_hi < PATH_START_MIN_COL:\n        return None\n\n    start = random.randint(PATH_START_MIN_COL, start_hi)\n    end_choices = list(range(PATH_START_MIN_COL, start_hi + 1))\n    if len(end_choices) > PATH_FAR_END_MIN_CHOICES and random.random() < PATH_FAR_END_PROB:\n        far = [c for c in end_choices if abs(c - start) >= PATH_FAR_END_DELTA]\n        if far:\n            end_choices = far\n    end = random.choice(end_choices)\n\n    cols = [start]\n    for gap in gaps:\n        cols.append(cols[-1] + gap + 1)\n    targets = [c + (end - start) for c in cols]\n\n    paths = [[int(c)] for c in cols]\n    for r in range(1, H):\n        valid: list[list[int]] = []\n        for steps in itertools.product(PATH_STEP_OPTIONS, repeat=path_count):\n            nxt = [cols[i] + steps[i] for i in range(path_count)]\n            if nxt[0] < PATH_LEFT_MIN_COL or nxt[-1] > W - PATH_RIGHT_MARGIN:\n                continue\n            if all(PATH_GAP_MIN <= nxt[i + 1] - nxt[i] - 1 <= PATH_GAP_MAX for i in range(path_count - 1)):\n                valid.append(nxt)\n        if not valid:\n            return None\n        ideal = [paths[i][0] + (targets[i] - paths[i][0]) * r / (H - 1) for i in range(path_count)]\n        scored = sorted(\n            valid,\n            key=lambda nxt: sum(abs(nxt[i] - ideal[i]) for i in range(path_count)) + random.random(),\n        )\n        cols = random.choice(scored[: max(1, min(PATH_SCORING_CANDIDATES, len(scored)))])\n        for i, c in enumerate(cols):\n            paths[i].append(int(c))\n\n    moves = sum(paths[i][r] != paths[i][r - 1] for i in range(path_count) for r in range(1, H))\n    if moves < PATH_MIN_MOVES:\n        return None\n    return paths\n\n\ndef _outside_enclosure(paths: list[list[int]], r: int, c: int, margin: int = OUTSIDE_MARGIN) -> bool:\n    return c <= paths[0][r] - margin or c >= paths[-1][r] + margin\n\n\ndef _inside_channel(paths: list[list[int]], r: int, c: int) -> bool:\n    return any(paths[i][r] < c < paths[i + 1][r] for i in range(len(paths) - 1))\n\n\ndef _touches_mask(mask: np.ndarray, coords: list[tuple[int, int]], connectivity: int) -> bool:\n    seen = set(coords)\n    deltas = NEIGHBOR_DELTAS_8 if connectivity == 8 else NEIGHBOR_DELTAS_4\n    for r, c in coords:\n        for dr, dc in deltas:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in seen and mask[rr, cc]:\n                return True\n    return False\n\n\ndef _place_short_fragments(\n    grid: np.ndarray, contour_mask: np.ndarray, paths: list[list[int]], contour: int, count: int\n) -> bool:\n    for _ in range(count):\n        size = random.randint(SHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX)\n        placed = False\n        for _attempt in range(SHORT_FRAGMENT_ATTEMPTS):\n            r = random.randrange(H)\n            side = random.choice(OUTSIDE_SIDE_OPTIONS)\n            if side < 0:\n                hi = paths[0][r] - SHORT_FRAGMENT_PATH_PADDING - size + 1\n                if hi < 0:\n                    continue\n                c0 = random.randint(0, hi)\n            else:\n                lo = paths[-1][r] + SHORT_FRAGMENT_PATH_PADDING\n                if lo + size > W:\n                    continue\n                c0 = random.randint(lo, W - size)\n            coords = [(r, c0 + i) for i in range(size)]\n            if any(grid[rr, cc] != grid[0, 0] for rr, cc in coords):\n                continue\n            if _touches_mask(contour_mask, coords, 8):\n                continue\n            patch = np.full((1, size), contour, dtype=int)\n            paste(grid, patch, r, c0)\n            for rr, cc in coords:\n                contour_mask[rr, cc] = True\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/2601afb7.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\n\n\ndef _extract_bars(g: np.ndarray, bg: int) -> list[dict[str, int]]:\n    height = g.shape[0]\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(components) >= 2\n\n    bars: list[dict[str, int]] = []\n    for comp in components:\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        color = int(comp[\"color\"])\n        area = int(comp[\"area\"])\n\n        assert c0 == c1\n        assert r1 == height - 1\n        assert area == r1 - r0 + 1\n        assert bool(np.all(g[r0 : r1 + 1, c0] == color))\n\n        bars.append({\"color\": color, \"col\": c0, \"height\": area})\n\n    bars.sort(key=lambda bar: bar[\"col\"])\n    assert len({bar[\"col\"] for bar in bars}) == len(bars)\n    return bars\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate each vertical bar's color one slot right and its height one slot left.\n\n    Input structure\n    - A dominant background surrounds several monochrome one-cell-wide vertical bars.\n    - Every bar is bottom-aligned and occupies a distinct column.\n    - The ordered bar slots are read from left to right.\n\n    Rule\n    - Keep the grid shape and the bar columns unchanged.\n    - At slot i, use the color from the previous slot cyclically.\n    - At slot i, use the height from the next slot cyclically.\n\n    Key insight\n    - Color and height are independent cyclic attributes of the ordered bar slots:\n      colors rotate right while heights rotate left.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height = g.shape[0]\n    bg = get_bg(g)\n    bars = _extract_bars(g, bg)\n\n    out = np.full_like(g, bg)\n    count = len(bars)\n    for i, bar in enumerate(bars):\n        color = bars[(i - 1) % count][\"color\"]\n        bar_height = bars[(i + 1) % count][\"height\"]\n        assert 1 <= bar_height <= height\n        out[height - bar_height : height, bar[\"col\"]] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n_RNG = np.random.default_rng()\n\n# Canvas/bar bounds.\nBAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE = 3, 6\nBACKGROUND_COLOR, MIN_BAR_HEIGHT = 7, 1\nBAR_COL_OFFSET, BAR_COL_STRIDE = 1, 2\n# Color and transform sampling.\nCOLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nOUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _render_bars(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n    grid = np.full((side, side), BACKGROUND_COLOR, dtype=int)\n    for i, (color, bar_height) in enumerate(zip(colors, heights)):\n        col = BAR_COL_STRIDE * i + BAR_COL_OFFSET\n        grid[side - int(bar_height) : side, col] = int(color)\n    return grid\n\n\ndef _expected_output(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n    out_colors = np.roll(colors, OUTPUT_COLOR_SHIFT)\n    out_heights = np.roll(heights, OUTPUT_HEIGHT_SHIFT)\n    return _render_bars(n, out_colors, out_heights)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = int(_RNG.integers(BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE))\n    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n    colors = _RNG.choice(COLOR_POOL, size=n, replace=False)\n    heights = _RNG.integers(MIN_BAR_HEIGHT, side, size=n)\n    if len(set(map(int, heights))) == 1:\n        idx = int(_RNG.integers(n))\n        choices = [h for h in range(MIN_BAR_HEIGHT, side) if h != int(heights[idx])]\n        heights[idx] = int(_RNG.choice(choices))\n\n    grid = _render_bars(n, colors, heights)\n    if np.array_equal(main(grid), _expected_output(n, colors, heights)):\n        return grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/c61be7dc.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import colors_present, components_mask, get_bg\nimport random\n\n\ndef _role_colors(g: np.ndarray, bg: int) -> tuple[int, int]:\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected exactly two non-background colors\"\n\n    boundary = set(map(int, np.concatenate((g[0, :], g[-1, :], g[:, 0], g[:, -1]))))\n    guide_colors = [color for color in colors if color in boundary]\n    object_colors = [color for color in colors if color not in boundary]\n    assert len(guide_colors) == 1, \"expected one non-background guide color touching the boundary\"\n    assert len(object_colors) == 1, \"expected one interior object color\"\n    return int(guide_colors[0]), int(object_colors[0])\n\n\ndef _midpoint(pair: list[int], axis_name: str) -> int:\n    assert len(pair) == 2, f\"expected exactly two full {axis_name} guide bars\"\n    a, b = pair\n    assert (a + b) % 2 == 0, f\"expected full {axis_name} guide bars to have a middle cell\"\n    return (a + b) // 2\n\n\ndef _unique_max_index(counts: np.ndarray, axis_name: str) -> int:\n    max_count = int(counts.max())\n    indices = np.flatnonzero(counts == max_count)\n    assert len(indices) == 1, f\"expected a unique perpendicular {axis_name} guide bar\"\n    return int(indices[0])\n\n\ndef _centered_span(center: int, length: int, limit: int) -> tuple[int, int]:\n    assert length % 2 == 1, \"expected the interior object area to be odd\"\n    start = center - length // 2\n    stop = center + length // 2\n    assert 0 <= start <= stop < limit, \"flattened object line must fit inside the grid\"\n    return start, stop\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Flatten the interior object into a centered line and move the guide bars inward to bracket it.\n\n    Input structure:\n    - The dominant color is the background.\n    - One non-background guide color touches the boundary and forms exactly two full parallel bars plus a split perpendicular center bar.\n    - The other non-background color is a single 8-connected interior object whose area determines the flattened line length.\n\n    Rule:\n    - If the guide pair is vertical, make a vertical object-colored line centered between those bars; otherwise use the analogous horizontal line.\n    - The line length equals the number of interior object pixels and is centered on the split perpendicular guide bar.\n    - Rebuild the guide color as the perpendicular center bar plus two full bars immediately beside the flattened object line.\n\n    Key insight:\n    - The guide bars supply only the orientation and center; the interior object's pixel count supplies the length of the final one-cell-thick line.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    guide_color, object_color = _role_colors(g, bg)\n    object_mask = g == object_color\n    object_components = components_mask(object_mask, connectivity=8)\n    assert len(object_components) == 1, \"expected one 8-connected interior object\"\n    object_area = int(object_components[0].shape[0])\n    assert object_area > 0, \"expected a nonempty interior object\"\n\n    guide_mask = g == guide_color\n    row_counts = np.count_nonzero(guide_mask, axis=1)\n    col_counts = np.count_nonzero(guide_mask, axis=0)\n    full_rows = np.flatnonzero(row_counts == width).tolist()\n    full_cols = np.flatnonzero(col_counts == height).tolist()\n    has_horizontal_pair = len(full_rows) == 2\n    has_vertical_pair = len(full_cols) == 2\n    assert has_horizontal_pair ^ has_vertical_pair, \"expected exactly one pair of full parallel guide bars\"\n\n    out = np.full_like(g, int(bg))\n    if has_vertical_pair:\n        center_col = _midpoint(full_cols, \"vertical\")\n        center_row = _unique_max_index(row_counts, \"row\")\n        start_row, stop_row = _centered_span(center_row, object_area, height)\n        assert 0 < center_col < width - 1, \"vertical flattened line must have guide bars on both sides\"\n\n        out[:, center_col - 1] = guide_color\n        out[:, center_col + 1] = guide_color\n        out[center_row, :] = guide_color\n        out[start_row : stop_row + 1, center_col] = object_color\n    else:\n        center_row = _midpoint(full_rows, \"horizontal\")\n        center_col = _unique_max_index(col_counts, \"column\")\n        start_col, stop_col = _centered_span(center_col, object_area, width)\n        assert 0 < center_row < height - 1, \"horizontal flattened line must have guide bars above and below\"\n\n        out[center_row - 1, :] = guide_color\n        out[center_row + 1, :] = guide_color\n        out[:, center_col] = guide_color\n        out[center_row, start_col : stop_col + 1] = object_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\nGEN_BG = 7\nGEN_GUIDE = 0\nGEN_OBJECT = 5\n\n# Canvas, object, guide gap, and retry sampling bounds.\nGEN_GRID_SIZES = [11, 13, 15, 17, 19]\nGEN_ORIENTATIONS = [\"V\", \"H\"]\nGEN_AREA_MIN = 5\nGEN_AREA_MAX = 13\nGEN_AREA_STEP = 2\nGEN_GAPS = (4, 6, 8)\nGEN_MIN_GAP_EXTRA = 2\nGEN_BOUNDARY_MARGIN = 1\nGEN_MAX_ATTEMPTS = 300\n\nGEN_NEIGHBOR_STEPS = [\n    (dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if dr or dc\n]\n\n\ndef _gen_expected_output(n: int, orientation: str, area: int) -> np.ndarray:\n    center = n // 2\n    out = np.full((n, n), GEN_BG, dtype=int)\n    start, stop = center - area // 2, center + area // 2\n\n    if orientation == \"V\":\n        out[:, center - 1] = GEN_GUIDE\n        out[:, center + 1] = GEN_GUIDE\n        out[center, :] = GEN_GUIDE\n        out[start : stop + 1, center] = GEN_OBJECT\n    else:\n        out[center - 1, :] = GEN_GUIDE\n        out[center + 1, :] = GEN_GUIDE\n        out[:, center] = GEN_GUIDE\n        out[center, start : stop + 1] = GEN_OBJECT\n\n    return out\n\n\ndef _gen_sample_layout() -> tuple[int, int, str, int]:\n    n = random.choice(GEN_GRID_SIZES)\n    center = n // 2\n    orientation = random.choice(GEN_ORIENTATIONS)\n    area = random.choice(range(GEN_AREA_MIN, min(GEN_AREA_MAX, n) + 1, GEN_AREA_STEP))\n    return n, center, orientation, area\n\n\ndef _gen_gap_options(n: int, area: int) -> list[int]:\n    min_gap = int(np.ceil(np.sqrt(area))) + GEN_MIN_GAP_EXTRA\n    return [g for g in GEN_GAPS if g <= n - 4 and g >= min_gap]\n\n\ndef _gen_draw_input_guides(\n    grid: np.ndarray, orientation: str, center: int, lo: int, hi: int\n) -> tuple[int, int, int, int]:\n    if orientation == \"V\":\n        grid[:, lo] = GEN_GUIDE\n        grid[:, hi] = GEN_GUIDE\n        grid[center, : lo + 1] = GEN_GUIDE\n        grid[center, hi:] = GEN_GUIDE\n        return GEN_BOUNDARY_MARGIN, grid.shape[0] - 1 - GEN_BOUNDARY_MARGIN, lo + 1, hi - 1\n    else:\n        grid[lo, :] = GEN_GUIDE\n        grid[hi, :] = GEN_GUIDE\n        grid[: lo + 1, center] = GEN_GUIDE\n        grid[hi:, center] = GEN_GUIDE\n        return lo + 1, hi - 1, GEN_BOUNDARY_MARGIN, grid.shape[1] - 1 - GEN_BOUNDARY_MARGIN\n\n\ndef _gen_blob_coords(\n    area: int,\n    row_min: int,\n    row_max: int,\n    col_min: int,\n    col_max: int,\n    seed_r: int,\n    seed_c: int,\n) -> set[tuple[int, int]]:\n    start = (\n        min(max(seed_r, row_min), row_max),\n        min(max(seed_c, col_min), col_max),\n    )\n    coords = {start}\n    frontier = {\n        (start[0] + dr, start[1] + dc)\n        for dr, dc in GEN_NEIGHBOR_STEPS\n        if row_min <= start[0] + dr <= row_max\n        and col_min <= start[1] + dc <= col_max\n    }\n\n    while len(coords) < area:\n        options = tuple(frontier)\n        weights = []\n        for r, c in options:\n            neighbors = sum(\n                (r + dr, c + dc) in coords\n                for dr, dc in GEN_NEIGHBOR_STEPS\n            )\n            dist = abs(r - seed_r) + abs(c - seed_c)\n            weights.append((neighbors + 1) ** 2 / (dist + 1))\n        cell = random.choices(options, weights=weights, k=1)[0]\n        frontier.remove(cell)\n        coords.add(cell)\n        r, c = cell\n        for dr, dc in GEN_NEIGHBOR_STEPS:\n            nxt = (r + dr, c + dc)\n            if (\n                row_min <= nxt[0] <= row_max\n                and col_min <= nxt[1] <= col_max\n                and nxt not in coords\n            ):\n                frontier.add(nxt)\n\n    return coords\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n, center, orientation, area = _gen_sample_layout()\n    expected = _gen_expected_output(n, orientation, area)\n\n    gaps = _gen_gap_options(n, area)\n    if not gaps:\n        return None\n    gap = random.choice(gaps)\n    lo = center - gap // 2\n    hi = center + gap // 2\n\n    grid = np.full((n, n), GEN_BG, dtype=int)\n    row_min, row_max, col_min, col_max = _gen_draw_input_guides(\n        grid, orientation, center, lo, hi\n    )\n    coords = _gen_blob_coords(area, row_min, row_max, col_min, col_max, center, center)\n    rows, cols = zip(*coords)\n    grid[rows, cols] = GEN_OBJECT\n\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid c61be7dc input\")\n","exit_code":0,"status":"completed"}}
