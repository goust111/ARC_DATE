{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nfrom collections import Counter\nimport random\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed218530468/1/4.py')\nmod = SourceFileLoader('arc4_search', str(p)).load_module()\n\n\ndef enumerate_all(base, containers):\n    idx = mod._build_container_index(base.shape, containers)\n    forbidden = mod._seed_forbidden_mask(base.shape, containers)\n    out = []\n    for r in range(base.shape[0]):\n        for c in range(base.shape[1]):\n            if forbidden[r, c] or int(base[r, c]) \"'!= int(mod.BACKGROUND):\n                continue\n            hits, paint, path = mod._trace_seed(base, (r, c), idx, mod.BACKGROUND)\n            out.append({'\"'pos': (r, c), 'hits': frozenset(hits), 'paint': frozenset(paint), 'path': frozenset(path)})\n    return out\n\nstats = Counter()\nfor _ in range(100):\n    h = random.randint(mod.GRID_MIN, mod.GRID_MAX)\n    w = random.randint(mod.GRID_MIN, mod.GRID_MAX)\n    n = 3\n    containers = mod._place_containers(h, w, n)\n    if containers is None:\n        stats['place_fail'] += 1\n        continue\n    base = mod.np.full((h, w), mod.BACKGROUND, dtype=int)\n    for container in containers:\n        coords = container['coords']\n        base[coords[:,0], coords[:,1]] = mod.CONTAINER\n    cands = enumerate_all(base, containers)\n    found = False\n    for i in range(len(cands)):\n        a = cands[i]\n        if len(a['hits']) == 0:\n            continue\n        for j in range(i+1, len(cands)):\n            b = cands[j]\n            if not mod._compatible(a, b):\n                continue\n            hit_colors = [set() for _ in containers]\n            for k in a['hits']:\n                hit_colors[k].add(1)\n            for k in b['hits']:\n                hit_colors[k].add(2)\n            counts = mod._status_counts_from_effects(hit_colors)\n            if counts['single'] >= 1 and counts['multi'] >= 1 and counts['none'] >= 1:\n                found = True\n                break\n        if found:\n            break\n    stats['found' if found else 'not_found'] += 1\nprint(stats)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
