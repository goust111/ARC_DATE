{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom collections import Counter\nfrom pathlib import Path\nimport random\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed218530468/1/4.py')\nmod = SourceFileLoader('arc4_debug', str(p)).load_module()\n\nstats = Counter()\nfor _ in range(200):\n    h = random.randint(mod.GRID_MIN, mod.GRID_MAX)\n    w = random.randint(mod.GRID_MIN, mod.GRID_MAX)\n    n = random.randint(mod.CONTAINER_COUNT_MIN, mod.CONTAINER_COUNT_MAX)\n    containers = mod._place_containers(h, w, n)\n    if containers is None:\n        stats['place_fail'] += 1\n        continue\n    base = mod.np.full((h, w), mod.BACKGROUND, dtype=int)\n    for container in containers:\n        coords = container['coords']\n        base[coords[:, 0], coords[:, 1]] = mod.CONTAINER\n    pools, nohit = mod._enumerate_candidates(base, containers)\n    if min(len(pool) for pool in pools.values()) == 0:\n        stats['empty_pool'] += 1\n        continue\n    selected = mod._select_seed_candidates(containers, pools, nohit)\n    if selected is None:\n        stats['select_fail'] += 1\n        continue\n    stats['selected'] += 1\n    colors = random.sample(mod.SEED_COLORS, len(selected))\n    random.shuffle(selected)\n    grid = base.copy()\n    for cand, color in zip(selected, colors):\n        r, c = cand['pos']\n        grid[r, c] = int(color)\n    try:\n        effects = mod._scene_effects(grid)\n    except AssertionError:\n        stats['scene_effects_fail'] += 1\n        continue\n    counts = mod._status_counts_from_effects(effects['hit_colors'])\n    if counts['single'] < 1 or counts['multi'] < 1 or counts['none'] < 1:\n        stats['branch_fail'] += 1\n        continue\n    transformed = mod._random_transform(grid)\n    try:\n        te = mod._scene_effects(transformed)\n    except AssertionError:\n        stats['transform_fail'] += 1\n        continue\n    if mod._status_counts_from_effects(te['hit_colors']) \"'!= counts:\n        stats['\"'count_mismatch'] += 1\n        continue\n    stats['success'] += 1\nprint(stats)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
