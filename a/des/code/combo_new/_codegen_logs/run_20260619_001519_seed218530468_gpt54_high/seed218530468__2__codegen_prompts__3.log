{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,340p' /home/lixinyu/snap/new/ARC_code/train/aa62e3f4.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import components_mask, get_bg, neighbors4\nimport random\n\n\ndef _unique_color_with_count(counts: Counter[int], colors: list[int], target_count: int) -> int:\n    matches = [color for color in colors if counts[color] == target_count]\n    assert len(matches) == 1, \"expected a unique structural color by area\"\n    return int(matches[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace the outlined object with the outside contour of that outline in the marker color.\n\n    Input structure:\n    - A dominant background surrounds one 8-connected foreground outline.\n    - The outline is the unique largest foreground color.\n    - One or more smaller interior colors are inside the outline; the marker color\n      is the unique smallest non-outline color.\n\n    Rule:\n    - Erase all original foreground pixels to background.\n    - Paint every background pixel that is 4-adjacent to the outline with the\n      marker color.\n    - Keep the grid shape unchanged.\n\n    Key insight: The colored interior marker supplies the paint color, while the\n    largest outline supplies only the contour whose outside edge is traced.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    counts = Counter(map(int, g.flatten()))\n    foreground_colors = [color for color in counts if color != bg]\n    assert len(foreground_colors) >= 2, \"expected an outline color and a marker color\"\n\n    frame_count = max(counts[color] for color in foreground_colors)\n    frame_color = _unique_color_with_count(counts, foreground_colors, frame_count)\n    assert len(components_mask(g == frame_color, connectivity=8)) == 1, \"outline must be 8-connected\"\n\n    marker_candidates = [color for color in foreground_colors if color != frame_color]\n    marker_count = min(counts[color] for color in marker_candidates)\n    marker_color = _unique_color_with_count(counts, marker_candidates, marker_count)\n\n    out = np.full_like(g, bg)\n    contour: set[tuple[int, int]] = set()\n    for r, c in np.argwhere(g == frame_color):\n        for nr, nc in neighbors4(int(r), int(c)):\n            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] == bg:\n                contour.add((int(nr), int(nc)))\n    assert contour, \"expected outline to touch background contour cells\"\n\n    for r, c in contour:\n        out[r, c] = marker_color\n    return out\n\n# --------------- generator (att2) ---------------\n\nGRID_MIN, GRID_MAX = 5, 16\nN_COLORS = 10\n\nSHAPE_MIN_HEIGHT, SHAPE_MAX_HEIGHT = 5, 7\nSHAPE_MIN_WIDTH, SHAPE_MAX_WIDTH = 3, 5\nSTART_WIDTH_MIN, START_WIDTH_MAX = 1, 2\nMAX_LOCAL_WIDTH = 5\n\nMARKER_MIN_CELLS, MARKER_MAX_CELLS = 1, 3\n\nGEN_ATTEMPTS = 300\n\nEDGE_TOUCH_TOP_BOTTOM = \"TB\"\nCORNER_EDGE_PAIRS = [\"TL\", \"TR\", \"BL\", \"BR\"]\nZERO_DELTA_SHIFTS = [-1, 0, 0, 0, 1]\n\n\ndef _gen_grow_parts(total, n):\n    n_twos = total - n\n    parts = [2] * n_twos + [1] * (n - n_twos)\n    random.shuffle(parts)\n    return parts\n\ndef _gen_drop_parts(total, n):\n    if n == 0:\n        return []\n    n_twos = random.randint(max(0, total - n), min(total // 2, n))\n    n_ones = total - 2 * n_twos\n    parts = [2] * n_twos + [1] * n_ones + [0] * (n - n_twos - n_ones)\n    random.shuffle(parts)\n    return parts\n\ndef _gen_widths(height, max_width):\n    start = random.randint(START_WIDTH_MIN, START_WIDTH_MAX)\n    diff = max_width - start\n    grow_steps = random.randint((diff + 1) // 2, min(diff, height - 1))\n    widths = [start]\n    for inc in _gen_grow_parts(diff, grow_steps):\n        widths.append(widths[-1] + inc)\n\n    remaining = height - len(widths)\n    min_end = max(1, max_width - 2 * remaining)\n    end_width = random.randint(min_end, max_width)\n    for dec in _gen_drop_parts(max_width - end_width, remaining):\n        widths.append(widths[-1] - dec)\n    return widths\n\ndef _gen_intervals(widths):\n    left, right = 0, widths[0] - 1\n    intervals = [(left, right)]\n    for prev_width, width in zip(widths, widths[1:]):\n        delta = width - prev_width\n        if delta == 2:\n            left -= 1\n            right += 1\n        elif delta == 1:\n            if random.choice([False, True]):\n                left -= 1\n            else:\n                right += 1\n        elif delta == 0:\n            shift = random.choice(ZERO_DELTA_SHIFTS) if width >= 2 else 0\n            left += shift\n            right += shift\n        elif delta == -1:\n            if random.choice([False, True]):\n                left += 1\n            else:\n                right -= 1\n        elif delta == -2:\n            left += 1\n            right -= 1\n        intervals.append((left, right))\n\n    min_left = min(l for l, _ in intervals)\n    intervals = [(l - min_left, r - min_left) for l, r in intervals]\n    if max(r for _, r in intervals) + 1 > MAX_LOCAL_WIDTH:\n        return None\n    return intervals\n\ndef _gen_local_mask(intervals):\n    height = len(intervals)\n    width = max(r for _, r in intervals) + 1\n    mask = np.zeros((height, width), dtype=bool)\n    for r, (c0, c1) in enumerate(intervals):\n        mask[r, c0 : c1 + 1] = True\n    return mask\n\ndef _gen_place_shape(grid_shape, local_mask, edge_pair):\n    rows, cols = grid_shape\n    height, width = local_mask.shape\n    if edge_pair == EDGE_TOUCH_TOP_BOTTOM:\n        if height != rows or width > cols - 2:\n            return None\n        return 0, random.randint(1, cols - width - 1)\n    if height >= rows or width >= cols:\n        return None\n    if edge_pair == \"TL\":\n        return 0, 0\n    if edge_pair == \"TR\":\n        return 0, cols - width\n    if edge_pair == \"BL\":\n        return rows - height, 0\n    return rows - height, cols - width\n\ndef _gen_full_mask(rows, cols, local_mask, r0, c0):\n    mask = np.zeros((rows, cols), dtype=bool)\n    height, width = local_mask.shape\n    mask[r0 : r0 + height, c0 : c0 + width] = local_mask\n    return mask\n\ndef _gen_layers(mask):\n    remaining = mask.copy()\n    layers = []\n    rows, cols = mask.shape\n    while np.any(remaining):\n        layer = np.zeros_like(mask)\n        for r, c in np.argwhere(remaining):\n            for nr, nc in neighbors4(int(r), int(c)):\n                if nr < 0 or nr >= rows or nc < 0 or nc >= cols or not remaining[nr, nc]:\n                    layer[r, c] = True\n                    break\n        layers.append(layer)\n        remaining[layer] = False\n    return layers\n\ndef _gen_contour(outline, shape):\n    rows, cols = shape.shape\n    contour = np.zeros_like(shape)\n    for r, c in np.argwhere(outline):\n        for nr, nc in neighbors4(int(r), int(c)):\n            if 0 <= nr < rows and 0 <= nc < cols and not shape[nr, nc]:\n                contour[nr, nc] = True\n    return contour\n\ndef _choose_canvas_and_shape_profile():\n    rows = random.randint(GRID_MIN, GRID_MAX)\n    cols = random.randint(GRID_MIN, GRID_MAX)\n    bg = random.randrange(N_COLORS)\n\n    edge_options = []\n    if rows <= SHAPE_MAX_HEIGHT:\n        edge_options.append(EDGE_TOUCH_TOP_BOTTOM)\n    if rows >= SHAPE_MIN_HEIGHT + 1:\n        edge_options.extend(CORNER_EDGE_PAIRS)\n    if not edge_options:\n        return None\n\n    edge_pair = random.choice(edge_options)\n    height = rows if edge_pair == EDGE_TOUCH_TOP_BOTTOM else random.randint(\n        SHAPE_MIN_HEIGHT, min(SHAPE_MAX_HEIGHT, rows - 1)\n    )\n    max_width_limit = cols - 2 if edge_pair == EDGE_TOUCH_TOP_BOTTOM else cols - 1\n    if max_width_limit < SHAPE_MIN_WIDTH:\n        return None\n    max_width = random.randint(SHAPE_MIN_WIDTH, min(SHAPE_MAX_WIDTH, max_width_limit))\n\n    intervals = _gen_intervals(_gen_widths(height, max_width))\n    if intervals is None:\n        return None\n    return rows, cols, bg, edge_pair, intervals\n\ndef _build_shape(rows, cols, edge_pair, intervals):\n    local_mask = _gen_local_mask(intervals)\n    placement = _gen_place_shape((rows, cols), local_mask, edge_pair)\n    if placement is None:\n        return None\n\n    shape = _gen_full_mask(rows, cols, local_mask, *placement)\n    shape_area = int(np.sum(shape))\n    if rows * cols - shape_area <= shape_area:\n        return None\n    return shape\n\ndef _split_valid_layers(shape):\n    layers = _gen_layers(shape)\n    if len(layers) < 2:\n        return None\n\n    outline = layers[0]\n    marker = layers[-1]\n    fill = shape & ~outline & ~marker\n\n    outline_count = int(np.sum(outline))\n    marker_count = int(np.sum(marker))\n    fill_count = int(np.sum(fill))\n    if marker_count < MARKER_MIN_CELLS or marker_count > MARKER_MAX_CELLS:\n        return None\n    if len(components_mask(outline, connectivity=8)) != 1:\n        return None\n    if fill_count and not (marker_count < fill_count < outline_count):\n        return None\n    return outline, fill, marker, fill_count\n\ndef _render_input(rows, cols, bg, masks, colors):\n    outline, fill, marker = masks\n    outline_color, fill_color, marker_color = colors\n    inp = np.full((rows, cols), bg, dtype=int)\n    inp[outline] = outline_color\n    if fill_color is not None:\n        inp[fill] = fill_color\n    inp[marker] = marker_color\n    return inp\n\ndef _gen_attempt():\n    profile = _choose_canvas_and_shape_profile()\n    if profile is None:\n        return None\n    rows, cols, bg, edge_pair, intervals = profile\n\n    shape = _build_shape(rows, cols, edge_pair, intervals)\n    if shape is None:\n        return None\n\n    layer_parts = _split_valid_layers(shape)\n    if layer_parts is None:\n        return None\n    outline, fill, marker, fill_count = layer_parts\n\n    contour = _gen_contour(outline, shape)\n    if not np.any(contour):\n        return None\n\n    colors = [c for c in range(N_COLORS) if c != bg]\n    random.shuffle(colors)\n    outline_color, marker_color = colors[:2]\n    fill_color = colors[2] if fill_count else None\n    inp = _render_input(rows, cols, bg, (outline, fill, marker), (outline_color, fill_color, marker_color))\n\n    expected = np.full((rows, cols), bg, dtype=int)\n    expected[contour] = marker_color\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\ndef generate_input():\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid aa62e3f4 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, neighbors4\n\n\ndef _legend_directions(g: np.ndarray, bg: int) -> dict[int, tuple[int, int]]:\n    \"\"\"\n    Detect legend blocks on the border.\n\n    A legend is a border-touching non-background component whose most common color is the legend\n    background `C` (and also the region border color it controls). The legend contains at least\n    two additional colors: a \"center\" color (more frequent) and an \"indicator\" color (less frequent).\n\n    The movement direction for regions with border color `C` is:\n      sign(centroid(indicator) - centroid(center))\n    \"\"\"\n    h, w = g.shape\n    non_bg = g != bg\n    best: dict[int, tuple[int, tuple[int, int]]] = {}\n    for pts in components_mask(non_bg, connectivity=4):\n        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue\n        # Legends are filled rectangles on the border.\n        r0, c0, r1, c1 = bbox_coords(pts)\n        area = (r1 - r0 + 1) * (c1 - c0 + 1)\n        if area != len(pts):\n            continue\n\n        counts: dict[int, int] = {}\n        for r, c in pts:\n            v = int(g[r, c])\n            counts[v] = counts.get(v, 0) + 1\n        if len(counts) != 3:\n            continue\n\n        bg_col = max(counts, key=counts.get)\n        others = [(cnt, col) for col, cnt in counts.items() if col != bg_col]\n        if len(others) < 2:\n            continue\n        others.sort()  # ascending by count\n        if others[0][0] == others[1][0]:\n            # Tie: choose center as the color closer to the rectangle center.\n            rc = np.array([(r0 + r1) / 2.0, (c0 + c1) / 2.0])\n            cols = [others[0][1], others[1][1]]\n            cents = []\n            for col in cols:\n                pts_col = np.array([(r, c) for r, c in pts if int(g[r, c]) == col], dtype=float)\n                cents.append((np.sum((pts_col.mean(axis=0) - rc) ** 2), col))\n            cents.sort()\n            center_col = cents[0][1]\n            indicator_col = cents[1][1]\n        else:\n            indicator_col = others[0][1]\n            center_col = others[-1][1]\n\n        center = [(r, c) for r, c in pts if int(g[r, c]) == center_col]\n        indic = [(r, c) for r, c in pts if int(g[r, c]) == indicator_col]\n        if not center or not indic:\n            continue\n\n        cc = np.mean(np.array(center, dtype=float), axis=0)\n        ci = np.mean(np.array(indic, dtype=float), axis=0)\n        vr, vc = (ci - cc).tolist()\n        dr = 0 if abs(vr) < 1e-6 else (1 if vr > 0 else -1)\n        dc = 0 if abs(vc) < 1e-6 else (1 if vc > 0 else -1)\n        if dr == 0 and dc == 0:\n            continue\n\n        prev = best.get(bg_col)\n        if prev is None or len(pts) > prev[0]:\n            best[bg_col] = (len(pts), (dr, dc))\n\n    return {k: v for k, (_, v) in best.items()}\n\n\ndef _slide_points(region_set: set[tuple[int, int]], points: list[tuple[int, int]], dr: int, dc: int) -> list[tuple[int, int]]:\n    if not points:\n        return []\n    # Process from the far end (closest to destination boundary) inward.\n    points_sorted = sorted(points, key=lambda p: (dr * p[0] + dc * p[1], p[0], p[1]), reverse=True)\n    occupied = set()\n    out_pts = []\n    for r0, c0 in points_sorted:\n        r, c = r0, c0\n        while True:\n            nr, nc = r + dr, c + dc\n            if (nr, nc) not in region_set:\n                break\n            # For diagonal steps, disallow \"corner cutting\": both orthogonal intermediates must be inside the region.\n            if dr != 0 and dc != 0:\n                if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n                    break\n            if (nr, nc) in occupied:\n                break\n            r, c = nr, nc\n        occupied.add((r, c))\n        out_pts.append((r, c))\n    return out_pts\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/eval/0934a4d8.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import deque\n\nimport numpy as np\n\nfrom arc_utils import bbox\n\n\ndef _solid_rectangle_marker(g: np.ndarray) -> tuple[int, tuple[int, int, int, int]]:\n    candidates: list[tuple[int, int, tuple[int, int, int, int]]] = []\n    for color in np.unique(g):\n        mask = g == int(color)\n        b = bbox(mask)\n        assert b is not None\n        r0, c0, r1, c1 = b\n        area = int((r1 - r0 + 1) * (c1 - c0 + 1))\n        if area > 1 and int(mask.sum()) == area and bool(np.all(mask[r0 : r1 + 1, c0 : c1 + 1])):\n            candidates.append((area, int(color), b))\n\n    assert len(candidates) == 1\n    _area, color, b = candidates[0]\n    return color, b\n\n\ndef _find_reflected_strip_start(g: np.ndarray, marker: int) -> int:\n    n, m = map(int, g.shape)\n    assert n == m\n    hi = n - 1\n\n    for lo in range(n // 2 + 1):\n        strip = g[:, lo : hi + 1]\n        strip_reflected = strip[:, ::-1]\n        known = (strip != marker) & (strip_reflected != marker)\n        if bool(np.any((strip != strip_reflected) & known)):\n            continue\n\n        strip = g[lo : hi + 1, :]\n        strip_reflected = strip[::-1, :]\n        known = (strip != marker) & (strip_reflected != marker)\n        if bool(np.any((strip != strip_reflected) & known)):\n            continue\n\n        return lo\n\n    raise AssertionError(\"no reflected strip found\")\n\n\ndef _reflection_orbit_values(g: np.ndarray, r: int, c: int, lo: int, marker: int) -> set[int]:\n    n = int(g.shape[0])\n    hi = n - 1\n    seen: set[tuple[int, int]] = set()\n    values: set[int] = set()\n    q: deque[tuple[int, int]] = deque([(int(r), int(c))])\n\n    while q:\n        rr, cc = q.popleft()\n        if (rr, cc) in seen:\n            continue\n        seen.add((rr, cc))\n\n        value = int(g[rr, cc])\n        if value != marker:\n            values.add(value)\n\n        if lo <= cc <= hi:\n            q.append((rr, lo + hi - cc))\n        if lo <= rr <= hi:\n            q.append((lo + hi - rr, cc))\n\n    return values\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reveal the rectangular patch hidden by the solid marker using the grid's reflection symmetries.\n\n    Input structure:\n    - A square colored pattern with one solid rectangular marker color occluding a patch.\n    - The visible pattern has horizontal and vertical reflection symmetry on a large lower/right strip.\n    - The top and left outer strips also expose transpose counterparts for cells not recoverable by those reflections.\n\n    Rule:\n    - Find the unique color whose full extent is a solid rectangle; this rectangle is the output region.\n    - Infer the reflected strip start as the smallest row/column offset whose lower/right strips are mirror-consistent, ignoring marker pixels.\n    - For each marker pixel, copy the unique non-marker value in its horizontal/vertical reflection orbit; if that orbit is entirely hidden in the outer strip, use the transposed top/left-strip counterpart.\n\n    Key insight:\n    The marker is not part of the pattern; it covers a missing rectangle whose cells are still determined by the visible mirror or transpose copies elsewhere in the grid.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    marker, (r0, c0, r1, c1) = _solid_rectangle_marker(g)\n    lo = _find_reflected_strip_start(g, marker)\n\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    out = np.empty((h, w), dtype=int)\n\n    for rr in range(h):\n        for cc in range(w):\n            r = int(r0 + rr)\n            c = int(c0 + cc)\n            values = _reflection_orbit_values(g, r, c, lo, marker)\n            if values:\n                assert len(values) == 1\n                out[rr, cc] = values.pop()\n            else:\n                assert r < lo or c < lo\n                assert 0 <= c < g.shape[0] and 0 <= r < g.shape[1]\n                value = int(g[c, r])\n                assert value != marker\n                out[rr, cc] = value\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- CFG: canvas & structure ---\n_N = 30                  # grid side length (always square)\n_LO = 2                  # outer border width (rows/cols 0..lo-1 are \"free\" border)\n_HI = _N - 1             # max row/col index\n\n# --- CFG: colors ---\n_PALETTE = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)  # 8 non-marker colors\n_MARKER = 8              # marker fill color\n\n# --- CFG: marker rectangle size ---\n_MARKER_DIM_LO = 3       # min marker side length\n_MARKER_DIM_HI = 9       # max marker side length (inclusive)\n_MARKER_AREA_LO = 16     # min marker area\n_MARKER_AREA_HI = 36     # max marker area\n\n# --- CFG: generation retries ---\n_MAX_RETRIES = 300\n\n_RNG = np.random.default_rng()\n_SIZE_PAIRS = [\n    (h, w)\n    for h in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)\n    for w in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)\n    if _MARKER_AREA_LO <= h * w <= _MARKER_AREA_HI\n]\n_PLACEMENT_CACHE: dict[tuple[int, int], list[tuple[int, int, list[tuple[int, int]]]]] = {}\n\n\ndef _orbit(r: int, c: int) -> set[tuple[int, int]]:\n    \"\"\"Return the LR+UD reflection orbit of (r, c) within the [_LO.._HI] axes.\"\"\"\n    rows = {r}\n    cols = {c}\n    if _LO <= r <= _HI:\n        rows.add(_LO + _HI - r)\n    if _LO <= c <= _HI:\n        cols.add(_LO + _HI - c)\n    return {(rr, cc) for rr in rows for cc in cols}\n\n\ndef _fallback_cells(r0: int, c0: int, h: int, w: int) -> list[tuple[int, int]] | None:\n    \"\"\"Identify marker cells whose entire orbit is inside the marker (need transpose fallback).\n\n    Returns None if the placement is invalid (a fully-covered orbit cell lies\n    inside the inner block, or its transpose is also inside the marker).\n    \"\"\"\n    r1, c1 = r0 + h, c0 + w\n    cells: list[tuple[int, int]] = []\n    for r in range(r0, r1):\n        for c in range(c0, c1):\n            if all(r0 <= rr < r1 and c0 <= cc < c1 for rr, cc in _orbit(r, c)):\n                if r >= _LO and c >= _LO:\n                    return None  # orbit fully hidden but no transpose fallback available\n                if r0 <= c < r1 and c0 <= r < c1:\n                    return None  # transpose cell also hidden by marker\n                cells.append((r, c))\n    return cells\n\n\ndef _valid_placements(h: int, w: int) -> list[tuple[int, int, list[tuple[int, int]]]]:\n    \"\"\"Return all valid (r0, c0, fallback_cells) placements for a h x w marker, cached.\"\"\"\n    key = (h, w)\n    if key not in _PLACEMENT_CACHE:\n        placements: list[tuple[int, int, list[tuple[int, int]]]] = []\n        for r0 in range(_N - h + 1):\n            for c0 in range(_N - w + 1):\n                fallback = _fallback_cells(r0, c0, h, w)\n                if fallback is not None:\n                    placements.append((r0, c0, fallback))\n        _PLACEMENT_CACHE[key] = placements\n    return _PLACEMENT_CACHE[key]\n\n\ndef _unify_groups(clean: np.ndarray, groups: list[set[tuple[int, int]]]) -> None:\n    \"\"\"Merge coordinate groups with union-find so all members share a random color.\"\"\"\n    parent: dict[tuple[int, int], tuple[int, int]] = {}\n\n    def find(x: tuple[int, int]) -> tuple[int, int]:\n        parent.setdefault(x, x)\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(a: tuple[int, int], b: tuple[int, int]) -> None:\n        ra, rb = find(a), find(b)\n        if ra != rb:\n            parent[rb] = ra\n\n    for group in groups:\n        coords = list(group)\n        if not coords:\n            continue\n        for coord in coords[1:]:\n            union(coords[0], coord)\n\n    merged: dict[tuple[int, int], list[tuple[int, int]]] = {}\n    for coord in parent:\n        merged.setdefault(find(coord), []).append(coord)\n\n    for coords in merged.values():\n        color = int(_RNG.choice(_PALETTE))\n        for r, c in coords:\n            clean[r, c] = color\n\n\ndef _build_clean() -> np.ndarray:\n    \"\"\"Build a clean NxN grid with bilateral LR+UD symmetry on the [lo..N-1] axes.\"\"\"\n    half = (_N - _LO) // 2\n    clean = np.empty((_N, _N), dtype=int)\n\n    # Inner block: quarter tile mirrored LR then UD\n    q = _RNG.choice(_PALETTE, size=(half, half))\n    top = np.concatenate([q, q[:, ::-1]], axis=1)\n    clean[_LO:_N, _LO:_N] = np.concatenate([top, top[::-1, :]], axis=0)\n\n    # Top border rows: LR-symmetric on [lo..N-1]\n    for r in range(_LO):\n        vals = _RNG.choice(_PALETTE, size=half)\n        clean[r, _LO : _LO + half] = vals\n        clean[r, _LO + half : _N] = vals[::-1]\n\n    # Left border cols: UD-symmetric on [lo..N-1]\n    for c in range(_LO):\n        vals = _RNG.choice(_PALETTE, size=half)\n        clean[_LO : _LO + half, c] = vals\n        clean[_LO + half : _N, c] = vals[::-1]\n\n    # Top-left corner: free (no symmetry constraint)\n    clean[:_LO, :_LO] = _RNG.choice(_PALETTE, size=(_LO, _LO))\n    return clean\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Try once to generate a valid input grid. Returns None on failure.\"\"\"\n    clean = _build_clean()\n    h, w = _SIZE_PAIRS[int(_RNG.integers(len(_SIZE_PAIRS)))]\n    placements = _valid_placements(h, w)\n    if not placements:\n        return None\n    r0, c0, fallback = placements[int(_RNG.integers(len(placements)))]\n\n    # Ensure transpose-fallback cells share consistent colors across orbits\n    groups = [_orbit(r, c) | _orbit(c, r) for r, c in fallback]\n    _unify_groups(clean, groups)\n\n    expected = clean[r0 : r0 + h, c0 : c0 + w].copy()\n    inp = clean.copy()\n    inp[r0 : r0 + h, c0 : c0 + w] = _MARKER\n\n    try:\n        if np.array_equal(main(inp), expected):\n            return inp\n    except Exception:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 0934a4d8 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '220,640p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n    h, w = canvas_mask.shape\n    sr, sc = seed\n    if not canvas_mask[sr, sc]:\n        return None\n    blob = {(sr, sc)}\n    frontier = []\n    def push_neighbors(r, c):\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:\n                frontier.append((nr, nc))\n    push_neighbors(sr, sc)\n    while len(blob) < target_size and frontier:\n        idx = rng.randrange(len(frontier))\n        r, c = frontier.pop(idx)\n        if (r, c) in blob or not canvas_mask[r, c]:\n            continue\n        blob.add((r, c))\n        push_neighbors(r, c)\n    if len(blob) < target_size:\n        return None\n    return blob\n\n\ndef _blob_wall_cells(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n    wall = set()\n    for r, c in blob:\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in blob:\n                wall.add((nr, nc))\n    return wall\n\n\ndef _fill_holes(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Return blob with interior holes absorbed.\n\n    Barrier = blob union its wall ring. Any non-barrier cell unreachable from the grid\n    border through non-barrier cells is trapped and gets absorbed into the blob.\n    \"\"\"\n    walls = _blob_wall_cells(blob, h, w)\n    barrier = np.zeros((h, w), dtype=bool)\n    for r, c in blob:\n        barrier[r, c] = True\n    for r, c in walls:\n        barrier[r, c] = True\n\n    # Flood-fill from border through non-barrier cells.\n    reachable = np.zeros((h, w), dtype=bool)\n    stack = []\n    for r in range(h):\n        for c in (0, w - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    for c in range(w):\n        for r in (0, h - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    while stack:\n        r, c = stack.pop()\n        if reachable[r, c] or barrier[r, c]:\n            continue\n        reachable[r, c] = True\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and not reachable[nr, nc] and not barrier[nr, nc]:\n                stack.append((nr, nc))\n\n    trapped = (~reachable) & (~barrier)\n    if not trapped.any():\n        return blob\n    filled = set(blob)\n    for r, c in np.argwhere(trapped):\n        filled.add((int(r), int(c)))\n    return filled\n\n\n# ── Slide helpers ─────────────────────────────────────────────────\n\ndef _slide_step_valid(region_set: set, r: int, c: int, dr: int, dc: int) -> bool:\n    nr, nc = r + dr, c + dc\n    if (nr, nc) not in region_set:\n        return False\n    if dr != 0 and dc != 0:\n        if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n            return False\n    return True\n\n\ndef _forward_slide(region_set: set, start: tuple[int, int], dr: int, dc: int,\n                   blocked: set) -> tuple[int, int]:\n    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n    r, c = start\n    while True:\n        if not _slide_step_valid(region_set, r, c, dr, dc):\n            break\n        nr, nc = r + dr, c + dc\n        if (nr, nc) in blocked:\n            break\n        r, c = nr, nc\n    return (r, c)\n\n\n# ── Generator phases ─────────────────────────────────────────────\n\ndef _place_legends(rng: random.Random, grid: np.ndarray,\n                   ) -> tuple[np.ndarray, list[tuple[int, tuple[int,int]]]]:\n    \"\"\"Place 1-2 legend patches at grid corners.\n\n    Returns (legend_occupied mask, list of (wall_color, direction) pairs).\n    \"\"\"\n    h, w = grid.shape\n    n_legends = rng.choice([1, 2])\n    corners = rng.sample(CORNERS, n_legends)\n    wall_colors = rng.sample(WALL_COLOR_CHOICES, n_legends)\n\n    legend_occupied = np.zeros((h, w), dtype=bool)\n    legends = []\n\n    for corner, wc in zip(corners, wall_colors):\n        if rng.random() < CARDINAL_PROB:\n            dr, dc = rng.choice(CARDINAL_DIRS)\n            patch = _legend_5x5(wc, dr, dc)\n        else:\n            dr, dc = rng.choice(DIAGONAL_DIRS)\n            patch = _legend_6x7(wc, dr, dc)\n        ph, pw = patch.shape\n        r0, c0 = _corner_origin(corner, h, w, ph, pw)\n        paste(grid, patch, r0, c0)\n        # Reserve legend cells + buffer.\n        r_lo, r_hi = max(0, r0 - LEGEND_BUFFER), min(h, r0 + ph + LEGEND_BUFFER)\n        c_lo, c_hi = max(0, c0 - LEGEND_BUFFER), min(w, c0 + pw + LEGEND_BUFFER)\n        legend_occupied[r_lo:r_hi, c_lo:c_hi] = True\n        legends.append((wc, (dr, dc)))\n\n    return legend_occupied, legends\n\n\ndef _grow_regions(rng: random.Random, legends: list[tuple[int, tuple[int,int]]],\n                  legend_occupied: np.ndarray,\n                  ) -> list[dict] | None:\n    \"\"\"Grow irregular closed regions, one per assigned wall color.\n\n    Returns list of region dicts or None on failure.\n    \"\"\"\n    h, w = legend_occupied.shape\n    color_dir = {wc: d for wc, d in legends}\n    all_colors = [wc for wc, _ in legends]\n\n    # Assign 1-3 regions per wall color, cap total.\n    region_colors = []\n    for c in all_colors:\n        region_colors.extend([c] * rng.randint(*REGIONS_PER_COLOR))\n    if len(region_colors) > MAX_TOTAL_REGIONS:\n        region_colors = rng.sample(region_colors, MAX_TOTAL_REGIONS)\n    rng.shuffle(region_colors)\n\n    size_min, size_max = REGION_SIZE_BOUNDS[len(region_colors)]\n    occupied = legend_occupied.copy()\n    regions = []\n\n    for rc in region_colors:\n        dr, dc = color_dir[rc]\n        target_size = rng.randint(size_min, size_max)\n\n        # Build canvas: interior cells (not border) that are unoccupied.\n        canvas = np.ones((h, w), dtype=bool)\n        canvas[0, :] = False; canvas[-1, :] = False\n        canvas[:, 0] = False; canvas[:, -1] = False\n        canvas &= ~occupied\n        if not canvas.any():\n            continue\n\n        blob = _try_grow_valid_blob(rng, canvas, occupied, target_size, h, w)\n        if blob is None:\n            continue\n\n        walls = _blob_wall_cells(blob, h, w)\n        regions.append({'color': rc, 'dir': (dr, dc), 'interior': blob, 'walls': walls})\n\n        # Reserve blob + walls + 1-cell buffer around walls.\n        reserve = blob | walls\n        extra = set()\n        for r, c in walls:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in reserve:\n                    extra.add((nr, nc))\n        for r, c in reserve | extra:\n            occupied[r, c] = True\n\n    if not regions:\n        return None\n    # Every legend color must have at least one region.\n    if {reg['color'] for reg in regions} != set(all_colors):\n        return None\n    return regions\n\n\ndef _try_grow_valid_blob(rng: random.Random, canvas: np.ndarray,\n                         occupied: np.ndarray, target_size: int,\n                         h: int, w: int) -> set[tuple[int,int]] | None:\n    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n    for _ in range(BLOB_GROW_RETRIES):\n        free = np.argwhere(canvas)\n        if len(free) == 0:\n            break\n        sr, sc = free[rng.randrange(len(free))]\n        cand = _grow_blob(canvas, (int(sr), int(sc)), target_size, rng)\n        if cand is None:\n            continue\n        # Fill interior holes until stable.\n        while True:\n            filled = _fill_holes(cand, h, w)\n            if filled == cand:\n                break\n            cand = filled\n        # Absorbed cells must stay within canvas.\n        if any(not canvas[r, c] for r, c in cand):\n            continue\n        walls = _blob_wall_cells(cand, h, w)\n        # Walls must not overlap occupied cells or the grid border.\n        if any(occupied[wr, wc] or wr in (0, h - 1) or wc in (0, w - 1)\n               for wr, wc in walls):\n            continue\n        return cand\n    return None\n\n\ndef _validate_topology(grid: np.ndarray, regions: list[dict]) -> bool:\n    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n    h, w = grid.shape\n    labeled, n_comp = label_mask(grid == 0, connectivity=4)\n    bounded = []\n    for comp_id in range(1, n_comp + 1):\n        coords = np.argwhere(labeled == comp_id)\n        if any(r in (0, h - 1) or c in (0, w - 1) for r, c in coords):\n            continue\n        bounded.append({(int(r), int(c)) for r, c in coords})\n    region_sets = [reg['interior'] for reg in regions]\n    if len(bounded) != len(region_sets):\n        return False\n    return all(comp in region_sets for comp in bounded)\n\n\ndef _place_yellows(rng: random.Random, regions: list[dict],\n                   grid: np.ndarray) -> bool:\n    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n\n    Modifies grid in-place by painting yellow(4) at input positions.\n    Returns True on success.\n    \"\"\"\n    for reg in regions:\n        blob = reg['interior']\n        dr, dc = reg['dir']\n        n_yellows = rng.choice(YELLOWS_PER_REGION)\n\n        # Cells sorted by projection onto slide direction (farthest first).\n        cells_sorted = sorted(blob, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n        far_key = dr * cells_sorted[0][0] + dc * cells_sorted[0][1]\n        tier1 = [p for p in cells_sorted if dr * p[0] + dc * p[1] == far_key]\n\n        # Pick output positions: first at the farthest tier, second one step behind or at tier1.\n        first = tier1[rng.randrange(len(tier1))]\n        output_positions = [first]\n\n        if n_yellows == 2:\n            pr, pc = first[0] - dr, first[1] - dc\n            cands = ([(pr, pc)] if (pr, pc) in blob else []) + [p for p in tier1 if p != first]\n            if cands:\n                second = cands[rng.randrange(len(cands))]\n                if second != first:\n                    output_positions.append(second)\n\n        # Reverse-slide: process in solver order (far-to-near).\n        out_sorted = sorted(output_positions, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n        already_stopped = set()\n        yellows_input = []\n\n        for out_pos in out_sorted:\n            candidate = _find_reverse_slide(blob, out_pos, dr, dc, already_stopped,\n                                            yellows_input, rng)\n            if candidate is None:\n                return False\n            yellows_input.append(candidate)\n            already_stopped.add(out_pos)\n\n        for r, c in yellows_input:\n            grid[r, c] = 4\n    return True\n\n\ndef _find_reverse_slide(blob: set, out_pos: tuple[int,int], dr: int, dc: int,\n                        already_stopped: set, existing_inputs: list,\n                        rng: random.Random) -> tuple[int,int] | None:\n    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n    target_steps = rng.randint(1, MAX_SLIDE_STEPS)\n    for steps in range(target_steps, 0, -1):\n        r, c = out_pos\n        path_ok = True\n        for _ in range(steps):\n            pr, pc = r - dr, c - dc\n            if (pr, pc) not in blob or (pr, pc) in already_stopped or (pr, pc) in existing_inputs:\n                path_ok = False\n                break\n            if dr != 0 and dc != 0:\n                if (pr + dr, pc) not in blob or (pr, pc + dc) not in blob:\n                    path_ok = False\n                    break\n            r, c = pr, pc\n        if not path_ok:\n            continue\n        if _forward_slide(blob, (r, c), dr, dc, already_stopped) == out_pos:\n            return (r, c)\n    return None\n\n\ndef _oracle_check(input_grid: np.ndarray, regions: list[dict]) -> bool:\n    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n    h, w = input_grid.shape\n    try:\n        solver_out = main(input_grid)\n    except Exception:\n        return False\n    # Non-yellow, non-bg cells must be identical.\n    struct_mask = (input_grid != 4) & (input_grid != 0)\n    if not np.array_equal(solver_out[struct_mask], input_grid[struct_mask]):\n        return False\n    # Yellow count must be preserved.\n    if (solver_out == 4).sum() != (input_grid == 4).sum():\n        return False\n    # All output yellows must lie inside known region interiors.\n    regions_mask = np.zeros((h, w), dtype=bool)\n    for reg in regions:\n        for r, c in reg['interior']:\n            regions_mask[r, c] = True\n    return bool(np.all(regions_mask[solver_out == 4]))\n\n\n# ── Main generator ────────────────────────────────────────────────\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    h, w = GRID_H, GRID_W\n    grid = np.zeros((h, w), dtype=int)\n\n    legend_occupied, legends = _place_legends(rng, grid)\n    regions = _grow_regions(rng, legends, legend_occupied)\n    if regions is None:\n        return None\n\n    # Paint walls.\n    for reg in regions:\n        for r, c in reg['walls']:\n            grid[r, c] = reg['color']\n\n    if not _validate_topology(grid, regions):\n        return None\n\n    input_grid = grid.copy()\n    if not _place_yellows(rng, regions, input_grid):\n        return None\n    if not _oracle_check(input_grid, regions):\n        return None\n    return input_grid\n\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\n","exit_code":0,"status":"completed"}}
