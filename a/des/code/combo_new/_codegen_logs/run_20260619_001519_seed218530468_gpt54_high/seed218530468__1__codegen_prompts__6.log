{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/9385bd28.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/\"'^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/9385bd28.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill rectangles between diagonal marker pairs using a color legend.\n\n    Input structure:\n    - bg grid with a vertical legend at the bottom-left: each row is a (marker_color, fill_color) pair.\n    - Scattered L-shaped corner markers of each marker color define opposite corners of axis-aligned rectangles.\n    - Some markers are solid 2×2 blocks instead of corner pairs.\n\n    Rule:\n    - Read legend bottom-to-top; for each entry find all pixels of that marker color.\n    - Determine which two bbox corners carry L-shaped anchors — the *other* diagonal defines the fill region.\n    - Fill the diamond (all shortest-path cells between those two corners) with the legend's fill color.\n    - Solid 2×2 marker blocks are simply recolored to the fill color.\n    - Later legend entries are protected from earlier fills.\n\n    Key insight: The L-shaped anchors sit on the marker diagonal; the fill goes on the opposite diagonal of the bounding box.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    bg = get_bg(g)\n    legend_c, entries = _find_legend(g, bg)\n    assert entries, \"legend must contain at least one (marker, fill) entry\"\n\n    legend_mask = np.zeros_like(g, dtype=bool)\n    for r, _, _ in entries:\n        if 0 <= r < h and 0 <= legend_c < w:\n            legend_mask[r, legend_c] = True\n        if 0 <= r < h and 0 <= legend_c + 1 < w:\n            legend_mask[r, legend_c + 1] = True\n\n    out = g.copy()\n\n    marker_order = [m for _, m, _ in entries]\n    marker_set = set(marker_order)\n\n    # Process legend entries bottom -> top; earlier entries must not destroy later marker pixels.\n    for i, (_, marker, fill) in enumerate(entries):\n        eff_fill = int(fill)\n        marker_pts = set(map(tuple, np.argwhere((g == marker) & (~legend_mask))))\n        if len(marker_pts) < 2:\n            continue\n\n        rs = [r for r, _ in marker_pts]\n        cs = [c for _, c in marker_pts]\n        rmin, rmax = min(rs), max(rs)\n        cmin, cmax = min(cs), max(cs)\n\n        # Protect legend cells and all marker pixels for entries that appear later (higher) in the legend.\n        future_markers = set(marker_order[i + 1 :])\n        protect = legend_mask.copy()\n        for fm in future_markers:\n            protect |= (g == fm) & (~legend_mask)\n\n        # Also protect current marker pixels in the common case (so markers remain visible),\n        # except when they form a solid 2x2 block (treated as a filled marker that gets recolored).\n        if rmax - rmin == 1 and cmax - cmin == 1 and len(marker_pts) == 4:\n            # Solid 2x2 marker: recolor these pixels directly.\n            block = np.zeros_like(g, dtype=bool)\n            for r, c in marker_pts:\n                block[r, c] = True\n            out[block & (~protect)] = eff_fill\n            continue\n        else:\n            protect |= (g == marker) & (~legend_mask)\n\n        if rmin == rmax or cmin == cmax:\n            continue\n\n        tl = (rmin, cmin)\n        tr = (rmin, cmax)\n        bl = (rmax, cmin)\n        br = (rmax, cmax)\n\n        tl_anchor = _l_anchor_present(marker_pts, tl[0], tl[1], (0, 1), (1, 0))\n        tr_anchor = _l_anchor_present(marker_pts, tr[0], tr[1], (0, -1), (1, 0))\n        bl_anchor = _l_anchor_present(marker_pts, bl[0], bl[1], (0, 1), (-1, 0))\n        br_anchor = _l_anchor_present(marker_pts, br[0], br[1], (0, -1), (-1, 0))\n\n        score_tlbr = int(tl_anchor) + int(br_anchor)\n        score_trbl = int(tr_anchor) + int(bl_anchor)\n        assert score_tlbr != 0 or score_trbl != 0, \"at least one diagonal must have an L-anchor\"\n        assert score_tlbr != score_trbl, \"diagonal scores must not tie (tie-break path is unreachable)\"\n        if score_tlbr > score_trbl:\n            a, b = tr, bl\n        else:\n            a, b = tl, br\n\n        diamond = _diamond_mask(h, w, rmin, rmax, cmin, cmax, a, b)\n        out[diamond & (~protect)] = eff_fill\n\n    return out\n\n# --------------- generator (C1) ---------------\n\n# ── CFG: canvas & grid ──────────────────────────────────────────────\nGRID_H_RANGE = (10, 19)          # grid height bounds\nGRID_W_RANGE = (10, 19)          # grid width bounds\n\n# ── CFG: legend ─────────────────────────────────────────────────────\nLEGEND_COL_RANGE = (0, 2)        # legend left column (marker at c, fill at c+1)\nLEGEND_ENTRY_RANGE = (2, 5)      # number of legend entries\n\n# ── CFG: marker types ──────────────────────────────────────────────\nNOOP_PROB = 0.3                  # prob of one noop entry (marker with no pixels)\nBLOCK_PROB = 0.25                # prob of one 2x2 block entry\n\n# ── CFG: L-pair bbox shape ──────────────────────────────────────────\nBBOX_H_MAX = 19                  # max bbox height\nBBOX_W_MAX = 12                  # max bbox width\nBBOX_SHAPE_WEIGHTS = [0.75, 0.15, 0.10]  # [both>=3, h=2/w>=4, h>=4/w=2]\nTLBR_PROB = 0.8                  # prob of TL-BR diagonal (vs TR-BL)\n\n# ── CFG: distractor ────────────────────────────────────────────────\nDISTRACTOR_PROB = 0.25           # prob of adding a non-legend L-pair\n\n# ── CFG: retry budgets ─────────────────────────────────────────────\nBLOCK_RETRIES = 100              # placement attempts for a 2x2 block\nLPAIR_RETRIES = 150              # placement attempts for an L-pair\nDISTRACTOR_RETRIES = 60          # placement attempts for distractor\nGEN_RETRIES = 300                # outer generate_input retry budget\n\n_L_OFFSETS = {\n    \"TL\": [(0, 0), (0, 1), (1, 0)],\n    \"TR\": [(0, 0), (0, -1), (1, 0)],\n    \"BL\": [(0, 0), (0, 1), (-1, 0)],\n    \"BR\": [(0, 0), (0, -1), (-1, 0)],\n}\n\n\n\n---GEN---\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt()\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: failed to generate a valid input after %d attempts\" % GEN_RETRIES)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/\"'^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\n\n---GEN---\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 581f7754 input\")\n","exit_code":0,"status":"completed"}}
