            group.append(next_bar)
            current = next_bar

        for item in group:
            rows = item["coords"][:, 0]
            cols = item["coords"][:, 1]
            out[rows, cols] = bg

        for item in group:
            col = item["col"]
            height = item["height"]
            assert col + height <= g.shape[1]
            out[baseline, col : col + height] = item["color"]

    return out

