+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+AZURE = 8
+GREY = 5
+RED = 2
+
+DIRECTIONS = {
+    (-1, 0): 0,   # up: no rotation
+    (0, 1): -1,   # right: clockwise 90 degrees
