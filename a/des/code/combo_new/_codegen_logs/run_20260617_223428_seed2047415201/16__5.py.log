            notch = random.choice(("tl", "tr", "bl", "br"))
            if notch == "tl":
                patch[0, 0] = bg
                patch[0, 1] = bg
            elif notch == "tr":
                patch[0, -1] = bg
                patch[1, -1] = bg
            elif notch == "bl":
                patch[-1, 0] = bg
                patch[-2, 0] = bg
            else:
                patch[-1, -1] = bg
                patch[-1, -2] = bg
        else:
            h = random.randint(4, 7)
            w = random.randint(4, 7)

