+def _place_random(grid: np.ndarray, patch: np.ndarray, occupied: np.ndarray) -> bool:
+    height, width = map(int, grid.shape)
+    ph, pw = map(int, patch.shape)
+    if ph + 2 > height or pw + 2 > width:
+        return False
