+            coords: list[tuple[int, int]] = []
+            while q:
+                r, c = q.popleft()
+                coords.append((r, c))
+                for dr, dc in deltas:
+                    rr, cc = r + dr, c + dc
+                    if not (0 <= rr < height and 0 <= cc < width):
+                        continue
+                    if seen[rr, cc] or int(grid[rr, cc]) != color:
+                        continue
+                    seen[rr, cc] = True
+                    q.append((rr, cc))
