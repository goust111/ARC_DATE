+
+    comps = _components_by_color(grid, AZURE)
+    if len(comps) != total:
+        return None
+    branch_counts = [0, 0]
+    for obj in comps:
+        area = int(obj["area"])
+        boundary = _boundary_count(obj["coords"])
+        branch_counts[0 if boundary == area else 1] += 1
+    if min(branch_counts) == 0:
+        return None
+
+    return grid
