+    coords = np.argwhere(patch != int(bg))
+    if coords.size == 0:
+        return False
+    cells = {(int(r), int(c)) for r, c in coords}
+    start = next(iter(cells))
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nb = (r + dr, c + dc)
+            if nb in cells and nb not in seen:
+                seen.add(nb)
+                q.append(nb)
+    return len(seen) == len(cells)
+
+
+def _hollow_patch(color: int, bg: int) -> np.ndarray:
+    mode = random.choice(("line", "corner", "zigzag", "ring"))
+    if mode == "line":
+        length = random.randint(3, 8)
+        patch = np.full((1, length), bg, dtype=int)
+        patch[0, :] = int(color)
+    elif mode == "corner":
+        h = random.randint(2, 6)
+        w = random.randint(2, 6)
+        patch = np.full((h, w), bg, dtype=int)
+        patch[:, 0] = int(color)
+        patch[-1, :] = int(color)
+    elif mode == "zigzag":
+        w = random.randint(3, 7)
+        patch = np.full((3, w), bg, dtype=int)
+        for c in range(w):
+            if c % 2 == 0:
+                patch[0, c] = int(color)
+                patch[1, c] = int(color)
+            else:
+                patch[1, c] = int(color)
+                patch[2, c] = int(color)
+    else:
