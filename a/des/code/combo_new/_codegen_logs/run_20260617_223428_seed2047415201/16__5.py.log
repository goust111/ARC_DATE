+
+def _solid_patch(color: int, bg: int) -> np.ndarray:
+    for _ in range(100):
+        mode = random.choice(("rectangle", "notched", "fat_l"))
+        if mode == "rectangle":
+            h = random.randint(3, 6)
+            w = random.randint(3, 6)
+            patch = np.full((h, w), int(color), dtype=int)
+        elif mode == "notched":
