+
+@dataclass(frozen=True)
+class Rect:
+    color: int
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+
+    @property
+    def area(self) -> int:
+        return (self.r1 - self.r0 + 1) * (self.c1 - self.c0 + 1)
