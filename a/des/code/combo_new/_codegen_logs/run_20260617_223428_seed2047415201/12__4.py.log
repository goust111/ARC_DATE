+
+
+# --------------- generator ---------------
+
+ARC_COLORS = tuple(range(10))
+PERIOD_CHOICES = (
+    (1, 1),
+    (1, 2),
+    (2, 1),
+    (2, 2),
+    (2, 3),
+    (3, 2),
+    (3, 3),
+    (2, 4),
+    (4, 2),
+    (3, 4),
+    (4, 3),
