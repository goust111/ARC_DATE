+    largest = max(rect.area for rect in rects)
+    if sum(1 for rect in rects if rect.area == largest) != 1:
+        return None
+    return rects
+
+
+def _infer_background(g: np.ndarray) -> tuple[np.ndarray, list[Rect]]:
+    h, w = map(int, g.shape)
