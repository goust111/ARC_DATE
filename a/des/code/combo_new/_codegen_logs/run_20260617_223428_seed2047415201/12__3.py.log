    for comp, c0 in zip(top, top_cols):
        comp["c0"], comp["out_r0"] = c0, 0
    for comp, c0 in zip(bottom, bottom_cols):
        comp["c0"], comp["out_r0"] = c0, H - comp["h"]

    comps = top + bottom
    expected = _build_output(comps, H, W, bg)
    inp = _derive_input(comps, H, W, bg)
    if inp is None:
