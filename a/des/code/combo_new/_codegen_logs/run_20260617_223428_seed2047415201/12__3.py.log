+def _frame_cells(r0: int, c0: int, fh: int, fw: int) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    r1, c1 = r0 + fh - 1, c0 + fw - 1
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
