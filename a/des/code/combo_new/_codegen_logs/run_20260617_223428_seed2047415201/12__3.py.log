+def _candidate_bases() -> list[tuple[str, np.ndarray]]:
+    bases: list[tuple[str, np.ndarray]] = []
+    for h in (3, 4):
+        for w in (2, 3):
+            bases.append(("L", _l_base(h, w)))
+    for h in (3, 4):
+        for w in (3, 5):
+            bases.append(("T", _t_base(h, w)))
+    return bases
