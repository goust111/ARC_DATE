+    colors = [c for c in range(10) if c not in (BG, GREY)]
+    rng.shuffle(colors)
+    colors = colors[:n_locks]
+
+    bases_by_kind = {"L": [], "T": []}
+    for kind, base in _candidate_bases():
+        bases_by_kind[kind].append(base)
