+def _touches_reserved(reserved: np.ndarray, cells: list[tuple[int, int]], pad: int) -> bool:
+    h, w = reserved.shape
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return True
+        r0, r1 = max(0, r - pad), min(h, r + pad + 1)
+        c0, c1 = max(0, c - pad), min(w, c + pad + 1)
