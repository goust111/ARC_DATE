+            return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+    if out.shape != grid.shape or np.array_equal(out, grid):
+        return None
+    if max(grid.shape) > 30 or max(out.shape) > 30:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(300):
+        grid = _gen_attempt(rng)
+        if grid is not None:
