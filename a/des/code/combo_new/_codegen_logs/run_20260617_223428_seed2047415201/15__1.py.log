+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+AZURE = 8
+LABEL_COLORS = [1, 2, 3, 4, 6, 7, 9]
+N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for sr, sc in np.argwhere(mask):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        seen[sr, sc] = True
+        q = deque([(sr, sc)])
+        pts: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            pts.append((r, c))
+            for dr, dc in N4:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(pts)
+    return comps
+
+
+def _bbox(pts: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in pts]
+    cs = [c for _, c in pts]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _crop_bool(mask: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return np.zeros((0, 0), dtype=bool)
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)
+
+
+def _dihedral_variants(mask: np.ndarray) -> list[np.ndarray]:
+    base = _crop_bool(mask)
+    variants: list[np.ndarray] = []
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    for k in range(4):
+        rot = np.rot90(base, k)
+        for flip in (False, True):
+            cur = np.fliplr(rot) if flip else rot
+            cur = _crop_bool(cur)
+            key = (tuple(cur.shape), cur.tobytes())
+            if key not in seen:
+                seen.add(key)
+                variants.append(cur)
+    return variants
+
+
+def _shape_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    return min((tuple(v.shape), v.tobytes()) for v in _dihedral_variants(mask))
+
+
+def _component_mask(pts: list[tuple[int, int]]) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(pts)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in pts:
+        mask[r - r0, c - c0] = True
+    return mask
