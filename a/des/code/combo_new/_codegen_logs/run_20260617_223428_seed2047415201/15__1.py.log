+        mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        for r, c in pts:
+            mask[r - r0, c - c0] = True
+        mapping[_shape_key(mask)] = int(label_cells[0][2])
+        library_h = max(library_h, int(label_cells[0][0]) + 1)
