+    keys: set[tuple[tuple[int, int], bytes]] = set()
+    for _ in range(1000):
+        mask = _random_connected_mask(rng)
+        key = _shape_key(mask)
+        if key in keys:
+            continue
+        keys.add(key)
+        shapes.append(mask)
+        if len(shapes) == count:
+            return shapes
+    raise RuntimeError("failed to create distinct template shapes")
