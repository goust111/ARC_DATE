+    h, w = obj.shape
+    candidates = []
+    for c in range(w):
+        candidates.append((0, c))
+        candidates.append((h - 1, c))
+    for r in range(1, h - 1):
+        candidates.append((r, 0))
+        candidates.append((r, w - 1))
