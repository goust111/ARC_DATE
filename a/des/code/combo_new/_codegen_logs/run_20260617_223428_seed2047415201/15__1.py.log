+def _can_place_bbox(occupied: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = 1) -> bool:
+    H, W = occupied.shape
+    rr0, cc0 = max(0, r0 - pad), max(0, c0 - pad)
+    rr1, cc1 = min(H, r0 + h + pad), min(W, c0 + w + pad)
+    return not bool(occupied[rr0:rr1, cc0:cc1].any())
