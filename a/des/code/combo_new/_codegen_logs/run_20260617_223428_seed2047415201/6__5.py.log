    cur_row = 0
    all_items: list[tuple[int, np.ndarray, bool]] = [
        (mc, sp, False) for mc, sp in zip(mover_colors, sprites)
    ]
    for dc_color in distractor_colors:
        ds = _make_sprite(dc_color, min(5, H - cur_row), sprite_area_w)
