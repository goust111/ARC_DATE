    inp[H - 1, fc0:fc0 + frame_w] = top_edge

    # Frame left/right edges (mirrored)
    for r in range(1, H - 1):
        val = frame_base
        for mc, (rmarks, _) in mover_targets.items():
            if r in rmarks:
