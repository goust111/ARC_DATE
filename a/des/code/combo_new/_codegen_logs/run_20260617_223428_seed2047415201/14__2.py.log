+    min_rows = max(GRID_SIDE_RANGE[0], red_mask.shape[0], blue_mask.shape[0]) + 4
+    min_cols = max(GRID_SIDE_RANGE[0], red_mask.shape[1], blue_mask.shape[1]) + 4
+    if min_rows > GRID_SIDE_RANGE[1] or min_cols > GRID_SIDE_RANGE[1]:
