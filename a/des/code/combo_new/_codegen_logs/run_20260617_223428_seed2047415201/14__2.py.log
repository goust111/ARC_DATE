+    H, W = g.shape
+
+    red_global = g == RED
+    blue_global = g == BLUE
+    assert red_global.any(), "expected a red object"
+    assert blue_global.any(), "expected a blue object"
+
+    rr0, rc0, rr1, rc1 = _bbox(red_global)
+    br0, bc0, _br1, _bc1 = _bbox(blue_global)
