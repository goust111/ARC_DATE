+    comps: list[list[int]] = []
+    for i in range(len(segments)):
+        if i in seen:
+            continue
+        q = deque([i])
+        seen.add(i)
+        comp: list[int] = []
+        while q:
+            cur = q.popleft()
+            comp.append(cur)
+            for nxt in edges[cur]:
