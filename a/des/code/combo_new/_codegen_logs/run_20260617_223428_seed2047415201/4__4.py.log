+def _center_dist2(shape: tuple[int, int], cell: tuple[int, int]) -> int:
+    h, w = shape
+    r, c = cell
+    dr = 2 * r - (h - 1)
+    dc = 2 * c - (w - 1)
+    return dr * dr + dc * dc
+
