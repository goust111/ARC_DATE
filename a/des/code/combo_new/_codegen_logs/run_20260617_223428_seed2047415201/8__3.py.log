+        c += int(patch.shape[1]) + GAP
+    return out
+
+
+def _pack_patches(patches: list[np.ndarray]) -> np.ndarray:
+    if len(patches) == 1:
+        return patches[0]
+
+    height = max(int(p.shape[0]) for p in patches)
+    width = sum(int(p.shape[1]) for p in patches) + GAP * (len(patches) - 1)
+    if height <= 30 and width <= 30:
