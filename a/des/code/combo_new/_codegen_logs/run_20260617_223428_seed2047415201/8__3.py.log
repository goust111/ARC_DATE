+    height = sum(int(p.shape[0]) for p in patches) + GAP * (len(patches) - 1)
+    width = max(int(p.shape[1]) for p in patches)
+    out = np.zeros((height, width), dtype=int)
+    r = 0
+    for patch in patches:
