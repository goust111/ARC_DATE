+            q: deque[tuple[int, int]] = deque([(sr, sc)])
+            seen[sr, sc] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                r, c = q.popleft()
+                coords.append((r, c))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    rr, cc = r + dr, c + dc
+                    if not (0 <= rr < height and 0 <= cc < width):
+                        continue
+                    if seen[rr, cc] or int(g[rr, cc]) != color:
+                        continue
+                    seen[rr, cc] = True
