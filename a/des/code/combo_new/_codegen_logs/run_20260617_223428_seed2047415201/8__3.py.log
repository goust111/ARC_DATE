+
+    roots = [obj for i, obj in enumerate(objects) if i not in parent]
+    roots.sort(key=_bbox_key)
+
+    def depth(obj: dict) -> int:
+        if not obj["children"]:
+            return 1
+        return 1 + max(depth(child) for child in obj["children"])
