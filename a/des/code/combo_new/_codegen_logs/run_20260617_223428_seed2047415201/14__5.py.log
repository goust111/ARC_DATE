+            return None
+        r0, c0 = random.choice(candidates)
+        cells = _abs_l_cells(r0, c0, direction)
+        for r, c in cells:
+            grid[r, c] = int(color)
+        _reserve(blocked, r0, c0)
+        markers.append({"corner": direction, "coords": cells})
+
+    if not _conflicts_are_unambiguous(markers, (h, w)):
+        return None
+
