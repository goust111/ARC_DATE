            out[int(r0) + int(rr), int(c0) + int(cc)] = int(bg)

    # Bottom-to-top ordering: lower sprites first, upper sprites last (covering).
    movers.sort(key=lambda s: (-((int(s["r0"]) + int(s["r1"])) / 2.0), int(s["c0"])))

    for s in movers:
