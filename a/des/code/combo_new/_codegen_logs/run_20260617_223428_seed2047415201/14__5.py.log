+        cur = best_by_corner.get(corner)
+        key = (
+            int(marker["area"]),
+            -int(marker["distance"]),
+            -int(marker["bbox"][0]),
+            -int(marker["bbox"][1]),
+        )
+        if cur is None:
+            best_by_corner[corner] = marker
