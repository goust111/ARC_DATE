+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+            color = int(g[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = int(rr + dr), int(cc + dc)
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            comps.append({"color": color, "coords": coords})
+    return comps
+
+
+def _marker_from_component(comp: dict) -> dict | None:
+    coords = set(comp["coords"])
+    if len(coords) != 3:
+        return None
+
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    r0, r1 = min(rs), max(rs)
+    c0, c1 = min(cs), max(cs)
+    if r1 - r0 != 1 or c1 - c0 != 1:
+        return None
+
+    full = {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
+    missing = list(full - coords)
+    if len(missing) != 1:
+        return None
+
+    mr, mc = missing[0]
+    if (mr, mc) == (r0, c0):
+        corner = "TL"
+    elif (mr, mc) == (r0, c1):
+        corner = "TR"
+    elif (mr, mc) == (r1, c0):
+        corner = "BL"
+    else:
+        corner = "BR"
+
+    return {
+        "color": int(comp["color"]),
+        "coords": coords,
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "corner": corner,
+        "area": len(coords),
+    }
+
+
+def _corner_point(shape: tuple[int, int], corner: str) -> tuple[int, int]:
+    h, w = shape
+    if corner == "TL":
+        return 0, 0
+    if corner == "TR":
+        return 0, int(w - 1)
+    if corner == "BL":
+        return int(h - 1), 0
+    return int(h - 1), int(w - 1)
