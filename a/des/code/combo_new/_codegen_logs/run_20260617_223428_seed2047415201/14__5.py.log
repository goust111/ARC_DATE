+            int(cur["area"]),
+            -int(cur["distance"]),
+            -int(cur["bbox"][0]),
+            -int(cur["bbox"][1]),
+        )
+        if key > cur_key:
+            best_by_corner[corner] = marker
+
+    out = np.full(g.shape, int(bg), dtype=int)
+    for corner, marker in best_by_corner.items():
+        _paint_corner_triangle(out, corner, int(marker["color"]))
