  "type": "transform_in_place",
  "src": "four grey marker pixels whose bbox is a square with exactly one missing corner",
  "transform": "paint teal on the outline of the right triangle inside the square: the missing bbox corner is the right-angle vertex, the two adjacent marker corners are the other vertices; keep grey markers unchanged"
}
</annotation>
