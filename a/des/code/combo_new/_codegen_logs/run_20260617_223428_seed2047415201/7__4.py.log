+GEN_COLORS = list(range(1, 10))
+GEN_SIZE_RANGE = (16, 30)
+GEN_OBJECT_RANGE = (2, 4)
+GEN_SHAPES = ((3, 3), (3, 5), (5, 3), (5, 5))
