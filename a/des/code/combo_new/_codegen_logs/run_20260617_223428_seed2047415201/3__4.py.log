        mask = _corner_composite_mask(group, top_corner=(r == 0))
        rows = slice(0, 5) if r == 0 else slice(h - 5, h)
        cols = slice(0, 5) if c == 0 else slice(w - 5, w)
        patch = out[rows, cols]
        patch[mask] = label

    return out

