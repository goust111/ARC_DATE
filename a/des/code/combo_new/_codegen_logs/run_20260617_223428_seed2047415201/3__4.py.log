+    for r, c in cells:
+        r0 = max(0, r - PADDING)
+        r1 = min(h, r + PADDING + 1)
+        c0 = max(0, c - PADDING)
+        c1 = min(w, c + PADDING + 1)
+        if bool(np.any(reserved[r0:r1, c0:c1])):
+            return False
+    return True
