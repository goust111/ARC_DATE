+def _sample_frame_size(h: int, w: int, layers: int) -> tuple[int, int] | None:
+    max_h = min(9, h)
+    max_w = min(9, w)
+    choices = []
+    for frame_h in range(3, max_h + 1):
+        for frame_w in range(3, max_w + 1):
+            interior_area = (frame_h - 2) * (frame_w - 2)
+            if interior_area >= layers:
