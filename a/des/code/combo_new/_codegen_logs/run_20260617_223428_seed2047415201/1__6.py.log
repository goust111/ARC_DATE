+import random
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+MAGENTA = 6
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+
+    for sr in range(h):
+        for sc in range(w):
+            if not bool(mask[sr, sc]) or bool(seen[sr, sc]):
+                continue
+            stack = [(sr, sc)]
+            seen[sr, sc] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                pts.append((r, c))
+                for dr, dc in DIR4:
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _rect_perimeter_coords(r0: int, c0: int, r1: int, c1: int):
+    for c in range(c0, c1 + 1):
+        yield (r0, c)
+        yield (r1, c)
+    for r in range(r0 + 1, r1):
+        yield (r, c0)
+        yield (r, c1)
+
+
+def _find_magenta_frames(g: np.ndarray) -> list[tuple[int, int, int, int]]:
+    frames: list[tuple[int, int, int, int]] = []
+    for comp in _components(g == MAGENTA):
+        rows = [r for r, _c in comp]
+        cols = [c for _r, c in comp]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        if r1 - r0 + 1 < 3 or c1 - c0 + 1 < 3:
+            continue
+        pts = set(comp)
+        perimeter = set(_rect_perimeter_coords(r0, c0, r1, c1))
+        if pts == perimeter:
+            frames.append((r0, c0, r1, c1))
