def _colors_by_first_seen(grid: np.ndarray, bg: int) -> list[int]:
    colors: list[int] = []
    seen = {int(bg)}
    height, width = grid.shape
    for r in range(height):
        for c in range(width):
            color = int(grid[r, c])
            if color not in seen:
