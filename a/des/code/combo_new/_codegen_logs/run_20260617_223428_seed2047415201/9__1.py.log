+
+GRID_H_RANGE = (9, 24)
+GRID_W_RANGE = (9, 24)
+COLOR_COUNT_RANGE = (2, 4)
+GEN_RETRIES = 500
+PLACE_RETRIES = 250
+
+
+def _seed_count_pattern(n_colors: int, rng: random.Random) -> list[int]:
