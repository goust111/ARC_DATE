+    colors = rng.sample(COLOR_POOL, 2 * n)
+    piece_colors = colors[:n]
+    output_colors = colors[n:]
+    rng.shuffle(output_colors)
+
+    grid = np.zeros((h, w), dtype=int)
+    grid[fr0 : fr0 + fh, fc0 : fc0 + fw][frame] = GREY
+
+    occupied = grid != BG
+    occupied[legend_top:, :] = True
+
+    piece_points = []
+    order = list(range(n))
+    rng.shuffle(order)
