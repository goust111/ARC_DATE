+
+    expected = grid.copy()
+    expected[legend_mask] = BG
+    for pts in piece_points:
+        for r, c in pts:
+            expected[r, c] = BG
+    for gap, color in zip(gaps, output_colors):
+        for rr, cc in gap["pts"]:
