+    rng.shuffle(sides)
+    base_choices = [m for m in BASE_GAPS if m.shape[0] <= thickness and _connected(m)]
+    rng.shuffle(base_choices)
+
+    gaps = []
+    gap_keys = set()
+    local_keys = set()
+    for side in sides:
+        placed = None
+        rng.shuffle(base_choices)
+        for base in base_choices:
