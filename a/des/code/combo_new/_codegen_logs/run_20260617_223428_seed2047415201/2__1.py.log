+    return [(r0 + r, c0 + c) for r, c in zip(*np.nonzero(mask))]
+
+
+def _connected(mask):
+    return len(_components(mask)) == 1
+
+
+def _build_attempt(rng):
+    n = rng.randint(2, 4)
+    thickness = rng.choice([2, 3])
