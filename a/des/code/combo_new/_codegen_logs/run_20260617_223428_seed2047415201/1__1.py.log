+        obj_h = random.randint(5 if n == 1 else 7, 10 if n == 1 else 12)
+        obj_w = random.randint(5 if n == 1 else 8, 11 if n == 1 else 15)
+
+        holes = np.zeros((obj_h, obj_w), dtype=bool)
+        blocked = np.zeros((obj_h, obj_w), dtype=bool)
