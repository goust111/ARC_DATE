def _build_sparse_grid(lattice):
    grid = np.zeros((2 * lattice.shape[0] + 1, 2 * lattice.shape[1] + 1), dtype=int)
    grid[1::2, 1::2] = lattice
    return grid


def _gen_attempt():
    r_count = _pick(LATTICE_COUNT_CHOICES)
