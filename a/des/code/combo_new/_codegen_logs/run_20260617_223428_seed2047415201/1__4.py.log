+
+def _make_doors(
+    n_rows: int, n_cols: int, row_lines: list[int], col_lines: list[int]
+) -> dict[tuple[str, int, int], list[tuple[int, int]]] | None:
+    internal: list[tuple[str, int, int]] = []
+    for wall_r in range(1, n_rows):
