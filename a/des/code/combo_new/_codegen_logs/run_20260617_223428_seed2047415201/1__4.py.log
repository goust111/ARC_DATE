+def _wall_lines(g: np.ndarray) -> tuple[list[int], list[int]]:
+    wall = g == GREY
+    h, w = g.shape
+    if w > 1:
+        row_pairs = np.sum(wall[:, :-1] & wall[:, 1:], axis=1)
+    else:
