+def _segment_length(key: tuple[str, int, int], row_lines: list[int], col_lines: list[int]) -> int:
+    kind, a, b = key
+    if kind == "h":
+        return int(col_lines[b + 1] - col_lines[b] - 1)
+    return int(row_lines[a + 1] - row_lines[a] - 1)
+
