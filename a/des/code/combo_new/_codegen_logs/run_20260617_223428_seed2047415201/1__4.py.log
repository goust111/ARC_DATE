+
+
+def _draw_legend(grid: np.ndarray, colors: list[int], square: int, gap: int) -> None:
+    h, w = grid.shape
+    total_h = len(colors) * square + (len(colors) - 1) * gap
+    r0 = h - total_h
+    c0 = w - square
+    for i, color in enumerate(colors):
+        rr = r0 + i * (square + gap)
+        grid[rr : rr + square, c0 : c0 + square] = int(color)
