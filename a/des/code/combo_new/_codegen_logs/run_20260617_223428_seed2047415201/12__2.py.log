+                assert upper_candidate not in above[lower_candidate], "conflicting overlap order"
+                if lower_candidate not in above[upper_candidate]:
+                    above[upper_candidate].add(lower_candidate)
+                    indegree[lower_candidate] += 1
+
+            if upper_seen:
