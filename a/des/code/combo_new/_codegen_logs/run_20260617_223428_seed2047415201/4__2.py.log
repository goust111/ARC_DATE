+    h, w = block.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(block[r, c]) == background:
+                continue
+
+            color = int(block[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
