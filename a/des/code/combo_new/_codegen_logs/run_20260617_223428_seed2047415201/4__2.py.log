+    comps.sort(key=lambda comp: (comp["bbox"][0], comp["bbox"][1]))
+    d_color = int(comps[0]["color"])
+    e_color = int(comps[1]["color"])
+    assert d_color != e_color, "palette swatches must have distinct colors"
+    return d_color, e_color
