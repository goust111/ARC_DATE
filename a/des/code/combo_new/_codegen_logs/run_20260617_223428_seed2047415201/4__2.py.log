            assert not (has_row_axis and has_col_axis), "panel cannot have both mirror axes"

            if has_col_axis:
                out[panel_r0 : panel_r0 + 9, panel_c0 : panel_c0 + 9] = np.fliplr(panel)
            elif has_row_axis:
                out[panel_r0 : panel_r0 + 9, panel_c0 : panel_c0 + 9] = np.flipud(panel)
