+    min_pw = 9 if cols == 3 else 11
+    ph = int(_RNG.integers(min_ph, min(16, max_ph) + 1))
+    pw = int(_RNG.integers(min_pw, min(16, max_pw) + 1))
+    return rows, cols, ph, pw
