+
+def _components(mask: np.ndarray, connectivity: int = 8) -> list[np.ndarray]:
+    height, width = map(int, mask.shape)
+    seen = np.zeros((height, width), dtype=bool)
+    if connectivity == 4:
+        deltas = ((1, 0), (-1, 0), (0, 1), (0, -1))
+    else:
