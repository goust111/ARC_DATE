    patches = []
    expected = None
    for idx, marker_color in enumerate(marker_colors):
        if idx == target_idx:
            center_color = marker_color
        elif idx == extra_idx:
            center_color = extra_center_color
        else:
            center_color = random.choice(
                [extra_center_color]
                + [color for color in marker_colors if color != marker_color]
