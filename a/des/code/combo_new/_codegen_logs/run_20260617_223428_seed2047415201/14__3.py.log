+    mh, mw = mask.shape
+    if mh > h or mw > w:
+        return False
+
+    top_rows = _valid_top_rows(mask, target_rows, keep, h)
+    if not top_rows:
+        return False
+
+    blocked = _dilate(occupied)
+    candidates: list[tuple[int, int]] = []
+    for r0 in top_rows:
+        for c0 in range(0, w - mw + 1):
