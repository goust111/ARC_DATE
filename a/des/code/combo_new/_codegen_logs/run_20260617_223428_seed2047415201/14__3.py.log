+    mh = int(mask.shape[0])
+    rows: list[int] = []
+    for r0 in range(0, height - mh + 1):
+        bbox_hits = any(r0 <= row < r0 + mh for row in target_rows)
+        if bbox_hits == keep:
+            rows.append(r0)
+    return rows
