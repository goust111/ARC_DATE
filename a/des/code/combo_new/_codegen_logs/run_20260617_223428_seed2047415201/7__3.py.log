+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return None
+    lo = pts.min(axis=0)
+    hi = pts.max(axis=0)
+    return int(lo[0]), int(lo[1]), int(hi[0]), int(hi[1])
