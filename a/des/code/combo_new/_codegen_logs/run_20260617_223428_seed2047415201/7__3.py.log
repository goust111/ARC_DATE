+def _concentric(order: list[int]) -> np.ndarray:
+    size = 2 * len(order) - 1
+    out = np.full((size, size), BLACK, dtype=int)
+    for i, color in enumerate(order):
+        r0 = c0 = i
+        r1 = c1 = size - 1 - i
+        out[r0, c0 : c1 + 1] = color
+        out[r1, c0 : c1 + 1] = color
