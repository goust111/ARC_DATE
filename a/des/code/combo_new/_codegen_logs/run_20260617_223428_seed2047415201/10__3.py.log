    mh, mw = mask.shape
    rr0 = max(0, r0 - 1)
    cc0 = max(0, c0 - 1)
    rr1 = min(occupied.shape[0], r0 + mh + 1)
    cc1 = min(occupied.shape[1], c0 + mw + 1)
    occupied[rr0:rr1, cc0:cc1] = True


