+
+import numpy as np
+
+
+AZURE = 8
+FOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 7, 9]
+GRID_H_RANGE = (10, 24)
+GRID_W_RANGE = (10, 24)
+PAIR_COUNT_RANGE = (3, 7)
