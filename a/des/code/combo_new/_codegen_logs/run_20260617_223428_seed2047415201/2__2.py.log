+            col0 = rng.randint(MARGIN, width - MARGIN - 1 - gap)
+            a, b = (row, col0), (row, col0 + gap)
+        else:
+            max_gap = min(MAX_UNBLOCKED_SPAN, height - 2 * MARGIN - 1)
+            if max_gap < MIN_ENDPOINT_GAP:
+                continue
+            gap = rng.randint(MIN_ENDPOINT_GAP, max_gap)
