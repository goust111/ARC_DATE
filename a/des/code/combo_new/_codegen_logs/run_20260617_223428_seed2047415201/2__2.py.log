GRID_SIZE_MAX = 16
BACKGROUND_COLOR = 7
FOREGROUND_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]

# Symmetric sprite shape.
SPRITE_HEIGHT_CHOICES = [1, 3, 3, 5, 5]
SPRITE_WIDTH_CHOICES = [1, 3, 3, 5]
SPRITE_DIM_SWAP_PROB = 0.5
SPRITE_QUADRANT_FILL_PROB = 0.5
SPRITE_BUILD_RETRIES = 50

