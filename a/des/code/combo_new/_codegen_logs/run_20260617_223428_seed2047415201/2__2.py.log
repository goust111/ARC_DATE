+    width = rng.randint(*GRID_W_RANGE)
+    n_pairs = rng.randint(*PAIR_COUNT_RANGE)
+    blocked_count = n_pairs // 2
+    unblocked_count = n_pairs - blocked_count
+    colors = rng.sample(FOREGROUND_COLORS, n_pairs)
