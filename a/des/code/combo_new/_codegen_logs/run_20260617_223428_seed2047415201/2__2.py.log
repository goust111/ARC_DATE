+            grid,
+            color,
+            unblocked_endpoints,
+            obstacle_use,
+            occupied,
+            protected,
+            rng,
+        )
+        if pair is None:
+            return None
+
+    if not _has_balanced_branches(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATE_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate valid input after {GENERATE_RETRIES} attempts")

