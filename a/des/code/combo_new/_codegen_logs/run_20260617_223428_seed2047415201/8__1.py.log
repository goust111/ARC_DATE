+    mh, mw = map(int, mask.shape)
+    if mh + 2 > height or mw + 2 > width:
+        return False
+
+    candidates = []
+    for r0 in range(1, height - mh):
+        for c0 in range(1, width - mw):
+            window = occupied[r0 : r0 + mh, c0 : c0 + mw]
+            if not np.any(window[mask]):
