+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        seen[sr, sc] = True
+        q = deque([(sr, sc)])
+        pts = []
+        while q:
+            r, c = q.popleft()
+            pts.append((r, c))
+            for dr, dc in dirs:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
