+def _is_full_2x2(coords: np.ndarray) -> bool:
+    if int(coords.shape[0]) != 4:
+        return False
+    r0, c0, r1, c1 = _bbox(coords)
+    return r1 - r0 == 1 and c1 - c0 == 1
