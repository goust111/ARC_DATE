{
  "type": "move_to_match",
  "src": "non-background marker pixel s",
  "dst": "centered square ring region d",
  "match_cond": "s.chebyshev_distance_to_grid_center == d.ring_radius",
  "transform": "fill every pixel in d with s.color"
}
</annotation>
</reference_puzzle>

