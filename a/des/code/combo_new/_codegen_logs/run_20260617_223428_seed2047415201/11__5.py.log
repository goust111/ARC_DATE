        color = colors[min(edge_count, 3)]
        for r, c in comp:
            out[r, c] = color
    return out


def _dilate_cells(coords: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
    dilated: set[tuple[int, int]] = set()
    for r, c in coords:
