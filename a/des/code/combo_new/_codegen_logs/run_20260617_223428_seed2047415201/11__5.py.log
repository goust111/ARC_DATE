        coords = _add_bumps(coords, edges, blocked)
        if _touch_edges(coords, h, w) != edges:
            continue
        if _can_place(coords, blocked):
            return coords
    return None


def _random_blob_mask() -> set[tuple[int, int]]:
    height = random.randint(2, 5)
    width = random.randint(2, 5)
