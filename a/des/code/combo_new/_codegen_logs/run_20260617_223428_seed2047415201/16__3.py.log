+def _neighbors(connectivity: int) -> tuple[tuple[int, int], ...]:
+    if connectivity == 4:
+        return ((1, 0), (-1, 0), (0, 1), (0, -1))
+    return tuple(
+        (dr, dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if not (dr == 0 and dc == 0)
