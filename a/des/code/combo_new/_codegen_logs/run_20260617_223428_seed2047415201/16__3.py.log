+        w = rng.randint(4, 8)
+        max_depth = min(4, h - 1)
+    else:
+        h = rng.randint(4, 8)
+        w = rng.randint(4, 7)
+        max_depth = min(4, w - 1)
+
+    depth = rng.randint(1, max_depth)
+    colors = _stripe_colors(depth, rng)
+    patch = np.zeros((h, w), dtype=int)
