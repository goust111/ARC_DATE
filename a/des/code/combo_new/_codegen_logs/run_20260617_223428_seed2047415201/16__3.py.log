+
+def _stripe_colors(depth: int, rng: random.Random) -> list[int]:
+    if depth <= 0:
+        return []
+    if depth == 1 or rng.random() < 0.3:
+        palette = [rng.choice(FILL_COLORS)]
+    else:
+        palette = rng.sample(FILL_COLORS, rng.randint(2, min(4, depth, len(FILL_COLORS))))
