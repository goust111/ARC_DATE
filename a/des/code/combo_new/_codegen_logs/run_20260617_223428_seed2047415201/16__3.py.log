+    if direction == "up":
+        patch[:, 0] = GREY
+        patch[:, -1] = GREY
+        patch[-1, :] = GREY
+        for i, r in enumerate(range(h - 1 - depth, h - 1)):
+            patch[r, 1:-1] = colors[i]
+    elif direction == "down":
+        patch[:, 0] = GREY
+        patch[:, -1] = GREY
+        patch[0, :] = GREY
