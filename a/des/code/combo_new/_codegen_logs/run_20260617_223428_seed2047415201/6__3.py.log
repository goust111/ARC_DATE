+def _is_solid_rectangle(grid: np.ndarray, comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    if comp["height"] * comp["width"] != comp["area"]:
+        return False
+    return bool(np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == comp["color"]))
+
