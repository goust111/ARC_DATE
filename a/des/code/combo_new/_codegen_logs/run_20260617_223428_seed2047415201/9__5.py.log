+def _components_by_color(g: np.ndarray, bg: int) -> list[dict]:
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for sr, sc in np.argwhere(g != int(bg)):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        color = int(g[sr, sc])
+        stack = [(sr, sc)]
+        seen[sr, sc] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            r, c = stack.pop()
+            coords.append((r, c))
+            for dr, dc in DIR4.values():
