+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+COLOR_POOL = tuple(range(1, 10))
+GRID_SIZE_RANGE = (10, 30)
+OBJECT_COUNT_RANGE = (2, 5)
+BBOX_HEIGHT_RANGE = (3, 8)
+BBOX_WIDTH_RANGE = (3, 8)
+OBJECT_DENSITY_RANGE = (0.45, 0.78)
+PLACEMENT_PADDING = 1
+PLACE_ATTEMPTS = 200
