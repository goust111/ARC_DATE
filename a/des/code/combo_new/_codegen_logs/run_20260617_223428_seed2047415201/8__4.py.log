def _gen_hollow_patch(color, bg):
    patch = np.full((GEN_SYMBOL_PATCH_SIZE, GEN_SYMBOL_PATCH_SIZE), color, dtype=int)
    patch[GEN_SYMBOL_PATCH_SIZE // 2, GEN_SYMBOL_PATCH_SIZE // 2] = bg
