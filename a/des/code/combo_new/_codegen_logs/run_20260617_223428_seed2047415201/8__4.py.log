def _gen_lattice_positions(side):
    if side == "top":
        return GEN_SEVEN_FROM_MARKER, GEN_GAP_SIX_POSITIONS
    if side == "bottom":
        return GEN_SEVEN_FROM_OTHER, GEN_GAP_SIX_POSITIONS
    if side == "left":
