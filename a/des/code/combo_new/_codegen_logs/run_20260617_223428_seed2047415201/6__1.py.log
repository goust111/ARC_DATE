+def _foreground_colors_in_scan_order(g: np.ndarray) -> list[int]:
+    seen: set[int] = set()
+    colors: list[int] = []
+    for value in g.reshape(-1):
+        color = int(value)
+        if color != BLACK and color not in seen:
+            seen.add(color)
+            colors.append(color)
+    return colors
+
