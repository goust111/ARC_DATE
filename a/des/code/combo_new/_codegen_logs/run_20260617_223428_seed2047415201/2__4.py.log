+        ax0, ay0, ax1, ay1 = a
+        for j, b in enumerate(rects[i + 1 :], start=i + 1):
+            bx0, by0, bx1, by1 = b
+            adjacent = False
+            if (ax1 == bx0 or bx1 == ax0) and max(ay0, by0) < min(ay1, by1):
+                adjacent = True
+            if (ay1 == by0 or by1 == ay0) and max(ax0, bx0) < min(ax1, bx1):
+                adjacent = True
+            if adjacent:
+                degrees[i] += 1
+                degrees[j] += 1
+    return degrees
