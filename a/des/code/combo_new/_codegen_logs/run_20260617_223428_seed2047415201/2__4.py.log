+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+LEGEND_COLORS = (RED, BLUE, GREEN, YELLOW, ORANGE)
+MAX_ATTEMPTS = 500
