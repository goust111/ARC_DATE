+def _transform_partition(
+    width: int, height: int, rects: list[tuple[int, int, int, int]]
+) -> tuple[int, int, list[tuple[int, int, int, int]]]:
+    op = random.choice(("id", "flip_x", "flip_y", "rot90", "rot180", "rot270"))
