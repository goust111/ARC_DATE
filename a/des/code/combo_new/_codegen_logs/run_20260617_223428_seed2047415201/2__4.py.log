+            ny0, ny1 = height - y1, height - y0
+            nw, nh = width, height
+        else:
+            nx0, nx1 = y0, y1
+            ny0, ny1 = width - x1, width - x0
+            nw, nh = height, width
+        out.append((nx0, ny0, nx1, ny1))
+    return nw, nh, out
+
+
+def _sample_partition() -> tuple[int, int, list[tuple[int, int, int, int]]]:
+    for _ in range(200):
