+            ny0, ny1 = height - y1, height - y0
+            nw, nh = width, height
+        elif op == "rot90":
+            nx0, nx1 = height - y1, height - y0
+            ny0, ny1 = x0, x1
+            nw, nh = height, width
+        elif op == "rot180":
