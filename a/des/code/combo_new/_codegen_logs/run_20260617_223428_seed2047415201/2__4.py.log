+    seen = np.zeros(mask.shape, dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for sr, sc in np.argwhere(mask):
+        sr = int(sr)
+        sc = int(sc)
+        if seen[sr, sc]:
+            continue
+        q = deque([(sr, sc)])
+        seen[sr, sc] = True
+        coords: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            coords.append((r, c))
