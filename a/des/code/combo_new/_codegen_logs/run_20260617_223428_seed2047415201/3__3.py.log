+def _gen_attempt() -> np.ndarray | None:
+    n_depths = random.randint(3, 5)
+    max_depth = n_depths
+    legend_block = 2
+    min_maze_dim = 2 * (max_depth + 1) + 6
+    min_grid_dim = min_maze_dim + legend_block + 3
+    if min_grid_dim > 30:
+        return None
+
+    h = random.randint(min_grid_dim, 30)
