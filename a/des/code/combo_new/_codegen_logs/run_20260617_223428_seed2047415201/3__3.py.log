+def _fill_dead_ends(out: np.ndarray, comp: list[tuple[int, int]], palette: list[int]) -> None:
+    comp_set = set(comp)
+    degree: dict[tuple[int, int], int] = {}
+    for r, c in comp:
+        degree[(r, c)] = sum((nr, nc) in comp_set for nr, nc in _neighbors4(r, c))
