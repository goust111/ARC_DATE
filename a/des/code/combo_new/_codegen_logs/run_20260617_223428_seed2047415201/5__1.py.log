+        ("100", "110", "011"),
+        ("001", "111", "010"),
+        ("010", "011", "110"),
+        ("010", "110", "010"),
+        ("101", "010", "101"),
+        ("110", "011", "010"),
+        ("010", "111", "100"),
+        ("001", "011", "110"),
+        ("010", "010", "111"),
+        ("111", "010", "010"),
+        ("011", "110", "010"),
+        ("010", "111", "001"),
+        ("101", "111", "010"),
+        ("010", "111", "101"),
+        ("011", "010", "110"),
+        ("110", "010", "011"),
+    ]
+    masks = []
+    seen: set[tuple[int, ...]] = set()
+    for rows in raw:
+        mask = np.array([[ch == "1" for ch in row] for row in rows], dtype=bool)
+        for variant in (mask, np.fliplr(mask), np.flipud(mask), np.rot90(mask, 1)):
+            key = tuple(int(x) for x in variant.reshape(-1))
