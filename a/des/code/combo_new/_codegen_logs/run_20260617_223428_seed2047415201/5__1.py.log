+def _extract_templates(g: np.ndarray, n: int, cell_size: int, seps: list[int]) -> list[list[np.ndarray]]:
+    templates: list[list[np.ndarray]] = []
+    for rr in range(n):
+        row: list[np.ndarray] = []
+        r0, r1 = seps[rr] + 1, seps[rr + 1]
+        for cc in range(n):
