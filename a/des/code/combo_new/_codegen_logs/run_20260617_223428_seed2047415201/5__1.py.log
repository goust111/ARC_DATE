+    assert h % 2 == 1 and w % 2 == 1, "templates must have an unambiguous center"
+    top = center_r - h // 2
+    left = center_c - w // 2
+    if top < 0 or left < min_col or top + h > out.shape[0] or left + w > out.shape[1]:
+        return False
