+                for cc in range(n):
+                    c0, c1 = seps[cc] + 1, seps[cc + 1]
+                    cell = legend[r0:r1, c0:c1]
+                    if cell.shape != (cell_size, cell_size):
+                        ok = False
+                        break
+                    vals = set(map(int, np.unique(cell)))
+                    if not vals.issubset({BLACK, GREY}) or GREY not in vals:
+                        ok = False
+                        break
