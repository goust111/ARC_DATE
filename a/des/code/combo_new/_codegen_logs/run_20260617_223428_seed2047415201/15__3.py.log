+    pts = [(int(r), int(c)) for r, c in coords]
+    cr = sum(r for r, _c in pts) / len(pts)
+    cc = sum(c for _r, c in pts) / len(pts)
+    return sorted(pts, key=lambda p: math.atan2(p[0] - cr, p[1] - cc))
