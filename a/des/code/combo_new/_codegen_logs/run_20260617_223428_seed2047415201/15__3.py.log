+    ordered = sorted(
+        items,
+        key=lambda d: (
+            -int(d["area"]),
+            float(d["centroid"][1]),
+            float(d["centroid"][0]),
+            tuple(d["coords"]),
+        ),
+    )
+    out_h = max(int(d["area"]) for d in ordered)
+    out_w = sum(int(d["area"]) for d in ordered) + len(ordered) - 1
+    out = np.full((out_h, out_w), BG, dtype=int)
+
+    c0 = 0
+    for d in ordered:
+        side = int(d["area"])
+        out[:side, c0 : c0 + side] = int(d["color"])
+        c0 += side + 1
+    return out
