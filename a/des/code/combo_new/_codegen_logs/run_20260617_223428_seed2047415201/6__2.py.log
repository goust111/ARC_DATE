+    matches: list[tuple[int, int]] = []
+    h, w = grid.shape
+    for r in range(h - 2):
+        for c in range(w - 2):
+            block = grid[r : r + 3, c : c + 3]
+            center = int(block[1, 1])
+            if center in (AZURE, MAROON) and np.all(block[_PERIMETER] == GREY):
