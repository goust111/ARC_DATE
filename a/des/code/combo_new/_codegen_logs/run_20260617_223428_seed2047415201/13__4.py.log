+            if r + 1 < h:
+                b = int(labels[r + 1, c])
+                if b >= 0 and b != a and comps[a]["color"] != comps[b]["color"]:
+                    seams[tuple(sorted((a, b)))] += 1
+            if c + 1 < w:
+                b = int(labels[r, c + 1])
