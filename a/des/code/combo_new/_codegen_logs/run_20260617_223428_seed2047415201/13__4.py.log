+def _bresenham(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0 = start
+    r1, c1 = end
+    dr = abs(r1 - r0)
+    dc = abs(c1 - c0)
+    sr = 1 if r0 < r1 else -1
+    sc = 1 if c0 < c1 else -1
+    err = dc - dr
