+    out = g.copy()
+    start = comps[pair[0]]["center"]
+    end = comps[pair[1]]["center"]
+    for r, c in _bresenham(start, end):
+        if int(out[r, c]) == BLACK:
+            out[r, c] = MAROON
+    return out
