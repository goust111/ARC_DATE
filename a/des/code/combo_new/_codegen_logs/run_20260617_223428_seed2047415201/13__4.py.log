+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8]
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def _components(grid: np.ndarray) -> tuple[list[dict], np.ndarray]:
+    h, w = grid.shape
+    labels = np.full((h, w), -1, dtype=int)
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for sr, sc in np.argwhere(grid != BLACK):
+        sr = int(sr)
+        sc = int(sc)
+        if seen[sr, sc]:
+            continue
+
+        color = int(grid[sr, sc])
+        comp_id = len(comps)
+        cells: list[tuple[int, int]] = []
+        q: deque[tuple[int, int]] = deque([(sr, sc)])
+        seen[sr, sc] = True
+        labels[sr, sc] = comp_id
+
+        while q:
+            r, c = q.popleft()
+            cells.append((r, c))
+            for dr, dc in DIRS4:
+                rr = r + dr
+                cc = c + dc
+                if (
+                    0 <= rr < h
+                    and 0 <= cc < w
+                    and not seen[rr, cc]
+                    and int(grid[rr, cc]) == color
+                ):
+                    seen[rr, cc] = True
+                    labels[rr, cc] = comp_id
+                    q.append((rr, cc))
+
+        coords = np.array(cells, dtype=int)
+        r0 = int(coords[:, 0].min())
+        c0 = int(coords[:, 1].min())
+        r1 = int(coords[:, 0].max())
+        c1 = int(coords[:, 1].max())
+        comps.append(
+            {
+                "color": color,
+                "coords": coords,
+                "bbox": (r0, c0, r1, c1),
+                "center": ((r0 + r1) // 2, (c0 + c1) // 2),
+            }
+        )
+
+    return comps, labels
+
+
+def _seam_counts(grid: np.ndarray, comps: list[dict], labels: np.ndarray) -> dict[tuple[int, int], int]:
+    h, w = grid.shape
+    seams: dict[tuple[int, int], int] = defaultdict(int)
+
+    for r in range(h):
+        for c in range(w):
+            a = int(labels[r, c])
+            if a < 0:
+                continue
+            if r + 1 < h:
+                b = int(labels[r + 1, c])
+                if b >= 0 and b != a and comps[a]["color"] != comps[b]["color"]:
+                    seams[tuple(sorted((a, b)))] += 1
+            if c + 1 < w:
+                b = int(labels[r, c + 1])
+                if b >= 0 and b != a and comps[a]["color"] != comps[b]["color"]:
+                    seams[tuple(sorted((a, b)))] += 1
+
+    return dict(seams)
