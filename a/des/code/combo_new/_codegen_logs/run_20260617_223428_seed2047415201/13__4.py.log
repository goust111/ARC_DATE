+            offset = random.randint(0, bw - width)
+            candidates.append(((br - height, bc + offset, height, width), base[:2]))
+
+            width = random.randint(5, max_w)
+            height = random.randint(5, 8)
+            offset = random.randint(0, bw - width)
+            candidates.append(((br + bh, bc + offset, height, width), base[:2]))
