def _grey_components(g: np.ndarray) -> list[np.ndarray]:
    h, w = g.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[np.ndarray] = []

    for sr, sc in np.argwhere(g == GREY):
        sr = int(sr)
        sc = int(sc)
