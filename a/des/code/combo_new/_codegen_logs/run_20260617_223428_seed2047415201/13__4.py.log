+        comp_id = len(comps)
+        cells: list[tuple[int, int]] = []
+        q: deque[tuple[int, int]] = deque([(sr, sc)])
+        seen[sr, sc] = True
+        labels[sr, sc] = comp_id
+
+        while q:
+            r, c = q.popleft()
+            cells.append((r, c))
+            for dr, dc in DIRS4:
+                rr = r + dr
+                cc = c + dc
