+    assert crops, "expected at least one outlier crop"
+    out_h = max(int(crop.shape[0]) for crop in crops)
+    out_w = sum(int(crop.shape[1]) for crop in crops) + len(crops) - 1
+    out = np.full((out_h, out_w), BLACK, dtype=int)
