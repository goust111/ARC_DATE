        a[r, c] = ca
        b[r, c] = cb

    if len(set(map(int, a[a != BLACK]))) < 2 or len(set(map(int, b[b != BLACK]))) < 2:
        return None
    if not bool(np.any((a != BLACK) & (b == BLACK))):
