+def _runs(indices: np.ndarray) -> list[tuple[int, int]]:
+    vals = [int(v) for v in indices]
+    if not vals:
+        return []
+    out: list[tuple[int, int]] = []
+    start = prev = vals[0]
+    for value in vals[1:]:
+        if value == prev + 1:
+            prev = value
+            continue
+        out.append((start, prev))
+        start = prev = value
+    out.append((start, prev))
+    return out
+
