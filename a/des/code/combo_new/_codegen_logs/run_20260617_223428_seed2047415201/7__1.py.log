+    assert h % CELL == 0 and w % CELL == 0
+
+    out = []
+    for r in range(h // CELL):
+        for c in range(w // CELL):
+            tile = band[r * CELL : (r + 1) * CELL, c * CELL : (c + 1) * CELL]
+            sig = _glyph_signature(tile, bg)
