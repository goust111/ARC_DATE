+        zr, zc = map(int, zeros[0])
+        gap_offset = (zr - 1, zc - 1)
+        assert gap_offset in GAP_BY_OFFSET, "missing pixel must be the middle of one side"
+        assert int(block[1, 1]) == color, "sprite center must be present"
