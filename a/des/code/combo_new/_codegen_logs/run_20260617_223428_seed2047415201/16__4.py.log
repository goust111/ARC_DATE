+    full = [(r, c) for r in (r0, r0 + 1) for c in (c0, c0 + 1)]
+    return [(r, c) for r, c in full if (r, c) != missing]
+
+
+def _reserved_ok(cells: list[tuple[int, int]], reserved: set[tuple[int, int]], height: int, width: int) -> bool:
+    for r, c in cells:
