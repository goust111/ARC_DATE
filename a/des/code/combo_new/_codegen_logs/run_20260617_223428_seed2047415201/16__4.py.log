+    ordered = sorted(points, key=lambda p: (dr * p[0] + dc * p[1], p[0], p[1]), reverse=True)
+    stopped: set[tuple[int, int]] = set()
+    result: list[tuple[int, int]] = []
+    for r0, c0 in ordered:
