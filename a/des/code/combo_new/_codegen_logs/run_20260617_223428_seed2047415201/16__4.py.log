+            out[r, c] = AZURE
+
+    for idx, region in enumerate(regions):
+        if idx not in directions:
+            continue
+        dr, dc = directions[idx]
+        movers = [(r, c) for r, c in region["cells"] if int(g[r, c]) == YELLOW]
+        if not movers:
+            continue
+        for r, c in movers:
+            out[r, c] = AZURE
+        for r, c in _slide_points(region["cells"], movers, dr, dc):
+            out[r, c] = YELLOW
+
+    return out
