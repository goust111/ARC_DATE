+    row_center = (r0 + r1) // 2
+    col_center = (c0 + c1) // 2
+    candidates: list[list[tuple[int, int]]] = []
+
+    if direction[0] != 0:
+        edges = ["top", "bottom"]
+        base = col_center - 1
+        anchors = [base + delta for delta in range(-4, 5)]
+        random.shuffle(edges)
+        random.shuffle(anchors)
+        for edge in edges:
