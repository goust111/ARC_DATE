+    if ph + 2 > h or pw + 2 > w:
+        return None
+
+    candidates = [(r, c) for r in range(1, h - ph) for c in range(1, w - pw)]
+    rng.shuffle(candidates)
+    for r, c in candidates:
+        if np.any(reserved[r - 1 : r + ph + 1, c - 1 : c + pw + 1]):
+            continue
+        mask = patch != BLACK
+        grid[r : r + ph, c : c + pw][mask] = patch[mask]
