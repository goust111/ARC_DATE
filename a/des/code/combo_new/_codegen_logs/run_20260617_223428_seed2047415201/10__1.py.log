+    for _ in range(distractor_count):
+        patch = _random_sprite(colors.pop(), rng)
+        if _place_patch(grid, reserved, patch, rng) is None:
+            return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    if not np.any(out == GREY):
+        return None
+
+    return grid
