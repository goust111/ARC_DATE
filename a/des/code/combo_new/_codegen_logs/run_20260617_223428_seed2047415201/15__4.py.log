+    c0, c1 = int(cols.min()), int(cols.max())
+    area = int(len(coords))
+
+    touched = []
+    if np.any(rows == 0):
+        touched.append("top")
+    if np.any(rows == height - 1):
+        touched.append("bottom")
+    if np.any(cols == 0):
+        touched.append("left")
+    if np.any(cols == width - 1):
+        touched.append("right")
+
+    if not touched:
+        return []
