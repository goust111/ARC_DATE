+
+def _place_interior_object(
+    grid: np.ndarray,
+    color: int,
+    blocked: set[tuple[int, int]],
+    claimed: set[tuple[int, int]],
+) -> bool:
+    height, width = map(int, grid.shape)
+    for _ in range(PLACE_ATTEMPTS):
+        mask = random.choice(INTERIOR_MASKS)
+        if random.choice([False, True]):
+            mask = np.fliplr(mask)
+        if random.choice([False, True]):
