+def _component(g: np.ndarray, start_r: int, start_c: int, seen: np.ndarray) -> set[tuple[int, int]]:
+    color = int(g[start_r, start_c])
+    stack = [(start_r, start_c)]
+    seen[start_r, start_c] = True
