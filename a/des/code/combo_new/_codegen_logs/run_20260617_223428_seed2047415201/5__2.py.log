   220	def _make_staircase(n: int) -> set[tuple[int, int]]:
   221	    """Diagonal staircase path in NxN bbox spanning opposite corners."""
   222	    if random.random() < STAIRCASE_NW_SE_PROB:
   223	        path, r, c = [(0, 0)], 0, 0
   224	        while r < n - 1 or c < n - 1:
   225	            if r == n - 1: c += 1
   226	            elif c == n - 1: r += 1
   227	            elif random.random() < 0.5: r += 1
   228	            else: c += 1
   229	            path.append((r, c))
   230	    else:
   231	        path, r, c = [(0, n - 1)], 0, n - 1
   232	        while r < n - 1 or c > 0:
   233	            if r == n - 1: c -= 1
   234	            elif c == 0: r += 1
   235	            elif random.random() < 0.5: r += 1
   236	            else: c -= 1
   237	            path.append((r, c))
   238	    return set(path)
