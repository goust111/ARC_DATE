+def _can_place(blocked: np.ndarray, cells: set[tuple[int, int]], r0: int, c0: int) -> bool:
+    return all(not blocked[r0 + r, c0 + c] for r, c in cells)
+
+
+def _place_legend(grid: np.ndarray, blocked: np.ndarray, colors: list[int]) -> None:
+    h, w = grid.shape
+    block = 2
