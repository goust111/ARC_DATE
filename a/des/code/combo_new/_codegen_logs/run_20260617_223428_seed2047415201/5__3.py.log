+        if panel is None:
+            return None
+        panels.append(panel)
+
+    height = rows * cell_h + (rows - 1)
+    width = cols * cell_w + (cols - 1)
+    if height > 30 or width > 30:
+        return None
+
+    grid = np.full((height, width), BLACK, dtype=int)
+    if rows > 1:
+        for r in range(cell_h, height, cell_h + 1):
+            grid[r, :] = GREY
+    if cols > 1:
+        for c in range(cell_w, width, cell_w + 1):
+            grid[:, c] = GREY
+
+    idx = 0
+    for rr in range(rows):
+        for cc in range(cols):
+            r0 = rr * (cell_h + 1)
+            c0 = cc * (cell_w + 1)
+            grid[r0 : r0 + cell_h, c0 : c0 + cell_w] = panels[idx]
+            idx += 1
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+    if out.ndim != 2 or max(out.shape) > 30:
+        return None
+    if not np.any(out == YELLOW):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(800):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid shape-difference panel input")

