+
+def _sample_near_center_span(length: int, size: int, side: int) -> tuple[int, int] | None:
+    center = (length - 1) / 2.0
+    if side < 0:
+        ends = [hi for hi in range(size - 1, length) if hi < center and length - 1 - hi > hi]
+        if not ends:
