+
+def _expanded_clear(reserved: np.ndarray, bbox: tuple[int, int, int, int], pad: int) -> bool:
+    H, W = reserved.shape
+    r0, c0, r1, c1 = bbox
+    er0, ec0 = max(0, r0 - pad), max(0, c0 - pad)
+    er1, ec1 = min(H - 1, r1 + pad), min(W - 1, c1 + pad)
