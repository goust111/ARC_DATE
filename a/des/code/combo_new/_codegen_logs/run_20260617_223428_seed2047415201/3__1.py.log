+
+    return None
+
+
+def _solid_3x3_candidates(grid: np.ndarray, mask: np.ndarray, color: int) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    candidates: list[tuple[int, int]] = []
+    for r, c in zip(*np.where(mask), strict=False):
+        rr, cc = int(r), int(c)
+        if rr <= 0 or cc <= 0 or rr >= h - 1 or cc >= w - 1:
