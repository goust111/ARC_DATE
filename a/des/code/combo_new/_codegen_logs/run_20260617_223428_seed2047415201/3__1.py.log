+        grid[int(r0 + rr), int(c0 + cc)] = int(color)
+
+
+def _layout_regions(rng: random.Random, color_a: int, color_b: int) -> tuple[np.ndarray, np.ndarray, np.ndarray] | None:
+    for _ in range(100):
