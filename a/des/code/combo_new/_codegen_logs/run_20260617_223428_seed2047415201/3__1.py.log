+    out = clean.copy()
+    for r, c, host in centers:
+        other = colors[1] if int(host) == int(colors[0]) else colors[0]
+        for dr, dc in CROSS:
+            rr, cc = r + dr, c + dc
+            if _in_bounds(out.shape, rr, cc):
+                out[rr, cc] = int(other)
