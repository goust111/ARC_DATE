+            shape = _make_blob(reg_h, reg_w, rng)
+            if shape is None:
+                continue
+            left_shape = shape
+            right_shape = np.fliplr(shape) if rng.random() < 0.75 else shape.copy()
+
+            r0 = rng.randint(1, h - reg_h - 1)
+            r1 = min(max(1, r0 + rng.choice([-1, 0, 0, 1])), h - reg_h - 1)
