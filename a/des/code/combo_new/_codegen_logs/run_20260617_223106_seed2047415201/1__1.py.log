+            for rr, cc in hole["pts"]:
+                expected[r0 + rr, c0 + cc] = fill
+
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
