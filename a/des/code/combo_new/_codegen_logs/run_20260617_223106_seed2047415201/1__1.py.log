+        r0, c0 = loc
+        placements.append({"r0": r0, "c0": c0, "patch": patch, "holes": hole_records})
+
+    expected[:, :] = grid
+    for r0, c0, r1, c1 in legend_boxes:
+        expected[r0 : r1 + 1, c0 : c1 + 1] = BG
+
+    for placed in placements:
+        r0 = int(placed["r0"])
+        c0 = int(placed["c0"])
+        patch = placed["patch"]
+        holes = placed["holes"]
+        winning = max(holes, key=lambda item: item["area"])
+        obj_color = int(colors[int(winning["template_id"])])
+
+        for rr, cc in zip(*np.where(patch == GREY), strict=False):
+            expected[r0 + int(rr), c0 + int(cc)] = obj_color
+        for hole in holes:
+            fill = int(colors[int(hole["template_id"])])
+            for rr, cc in hole["pts"]:
+                expected[r0 + rr, c0 + cc] = fill
+
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
