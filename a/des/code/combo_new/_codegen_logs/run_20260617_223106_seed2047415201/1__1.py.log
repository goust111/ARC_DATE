+def _extract_legends(g: np.ndarray) -> tuple[dict[tuple[tuple[int, int], bytes], int], list[tuple[int, int, int, int]]]:
+    h, w = g.shape
+    templates: dict[tuple[tuple[int, int], bytes], int] = {}
+    boxes: list[tuple[int, int, int, int]] = []
+    if h < LEGEND_SIZE or w < LEGEND_SIZE:
+        return templates, boxes
+
+    r = 0
+    while r <= h - LEGEND_SIZE:
+        block = g[r : r + LEGEND_SIZE, 0:LEGEND_SIZE]
+        border = np.concatenate(
+            [
+                block[0, :],
+                block[-1, :],
+                block[1:-1, 0],
+                block[1:-1, -1],
+            ]
+        )
+        vals = np.unique(border)
+        if len(vals) == 1:
