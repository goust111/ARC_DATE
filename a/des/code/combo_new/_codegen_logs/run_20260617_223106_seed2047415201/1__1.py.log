+def _hole_regions_for_object(g: np.ndarray, obj: list[tuple[int, int]]) -> list[dict]:
+    r0, c0, r1, c1 = _bbox(obj)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    obj_mask = np.zeros((h, w), dtype=bool)
+    for r, c in obj:
