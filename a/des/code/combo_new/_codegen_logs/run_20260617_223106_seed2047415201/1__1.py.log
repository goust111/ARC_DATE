+            if color not in (BG, GREY):
+                inner = block[1:-1, 1:-1] != BG
+                if inner.any():
+                    templates[_shape_key(inner)] = color
+                    boxes.append((r, 0, r + LEGEND_SIZE - 1, LEGEND_SIZE - 1))
+                    r += LEGEND_SIZE
+                    continue
+        r += 1
