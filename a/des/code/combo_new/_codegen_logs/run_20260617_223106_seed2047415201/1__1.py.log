+    holes = [_random_orientation(templates[i]) for i in template_ids]
+    gap = random.randint(1, 2)
+    left_margin = random.randint(1, 2)
+    right_margin = random.randint(1, 2)
+    top_margin = random.randint(1, 2)
+    bottom_margin = random.randint(1, 2)
+    height = max(int(h.shape[0]) for h in holes) + top_margin + bottom_margin
+    width = left_margin + right_margin + sum(int(h.shape[1]) for h in holes) + gap * (len(holes) - 1)
+
+    patch = np.full((height, width), GREY, dtype=int)
+    c = left_margin
+    records: list[dict] = []
+    order = list(range(len(holes)))
+    random.shuffle(order)
+    for idx in order:
+        mask = holes[idx]
+        mh, mw = mask.shape
+        r = random.randint(1, height - mh - 1)
+        pts: list[tuple[int, int]] = []
+        for rr in range(mh):
