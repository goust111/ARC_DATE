+def _choose_multi_ids(n_templates: int, areas: list[int]) -> list[int] | None:
+    for _ in range(40):
+        count = random.choice([2, 3]) if n_templates >= 3 else 2
+        ids = random.sample(range(n_templates), count)
+        vals = [areas[i] for i in ids]
+        if len(set(vals)) > 1 and vals.count(max(vals)) == 1:
+            return ids
+    return None
+
