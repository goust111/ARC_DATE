+        legend_boxes.append((r0, 0, r0 + LEGEND_SIZE - 1, LEGEND_SIZE - 1))
+
+    main_c0 = 7
+    n_objects = random.randint(2, 5)
+    n_multi = random.randint(1, min(2, n_objects))
+    object_specs: list[list[int]] = []
+    for _ in range(n_multi):
+        ids = _choose_multi_ids(n_templates, template_areas)
+        if ids is None:
+            return None
+        object_specs.append(ids)
+    for _ in range(n_objects - n_multi):
+        object_specs.append([random.randrange(n_templates)])
+    random.shuffle(object_specs)
+
+    placements: list[dict] = []
+    for ids in object_specs:
+        patch, hole_records = _make_object_patch(ids, chosen)
+        loc = _place_patch(grid, occupied, patch, main_c0)
+        if loc is None:
