+    grid[r0 : r0 + ph, c0 : c0 + pw] = patch
+    occupied[max(0, r0 - 1) : min(h, r0 + ph + 1), max(0, c0 - 1) : min(w, c0 + pw + 1)] = True
+    return r0, c0
