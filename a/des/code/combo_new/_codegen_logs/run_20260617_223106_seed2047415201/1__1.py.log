+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not bool(mask[r, c]):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and bool(mask[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(pts: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [p[0] for p in pts]
+    cs = [p[1] for p in pts]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _trim(mask: np.ndarray) -> np.ndarray:
+    mask = np.asarray(mask, dtype=bool)
+    if not mask.any():
+        return mask[:0, :0].copy()
+    pts = np.argwhere(mask)
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].copy()
+
+
+def _orientations(mask: np.ndarray) -> list[np.ndarray]:
+    base = _trim(mask)
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    out: list[np.ndarray] = []
+    for flip in (False, True):
+        m = np.fliplr(base) if flip else base
+        for k in range(4):
+            o = _trim(np.rot90(m, k))
+            key = (o.shape, o.tobytes())
+            if key not in seen:
+                seen.add(key)
+                out.append(o)
+    return out
+
+
+def _shape_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    keys = []
+    for o in _orientations(mask):
+        keys.append((tuple(map(int, o.shape)), o.tobytes()))
+    return min(keys)
