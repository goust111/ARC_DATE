+    h, w = occupied.shape
+    ph, pw = patch.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h, r0 + ph + pad)
+    cc1 = min(w, c0 + pw + pad)
+    return not bool(occupied[rr0:rr1, cc0:cc1].any())
+
+
+def _place_patch(grid: np.ndarray, occupied: np.ndarray, patch: np.ndarray, main_c0: int) -> tuple[int, int] | None:
+    h, w = grid.shape
+    ph, pw = patch.shape
+    candidates: list[tuple[int, int]] = []
+    for r0 in range(0, h - ph + 1):
+        for c0 in range(main_c0, w - pw + 1):
+            if _can_place(occupied, patch, r0, c0):
+                candidates.append((r0, c0))
