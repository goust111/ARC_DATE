g, connectivity=8, monochromatic=False, return_format=\"dict\")\n  52:     assert not (not comps)\n  53: \n  54:     extracted = []\n  55:     for comp in comps:\n  56:         r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n  57:         patch = crop_bbox(g, (r0, c0, r1, c1))\n  58: \n  59:         # Isolate this component exactly (bbox rectangle may include background).\n  60:         rel_coords = [(int(r) - r0, int(c) - c0) for r, c in comp[\"coords\"]]\n  61:         m = mask_from_coords(rel_coords, patch.shape)\n  62:         pat = np.full_like(patch, bg)\n  63:         pat[m] = patch[m]\n  64: \n  65:         extracted.append(\n  66:             {\n  67:                 \"c0\": int(c0),\n  68:                 \"pat\": pat,\n  69:                 \"shape_key\": canonical_shape_key(m),\n  70:             }\n  71:         )\n  72: \n  73:     freq = Counter(d[\"shape_key\"] for d in extracted)\n  74:     out = np.full((H, W), int(bg), dtype=int)\n  75: \n  76:     for d in extracted:\n  77:         pat = d[\"pat\"]\n  78:         h, w = map(int, pat.shape)\n  79:         dest_r0 = 0 if int(freq[d[\"shape_key\"]]) >= 2 else int(H - h)\n  80:         dest_c0 = int(d[\"c0\"])\n  81:         paste(out, pat, dest_r0, dest_c0, transparent=int(bg))\n  82: \n  83:     return out\n  84: \n  85: # --------------- generator (att2) ---------------\n  86: \n  87: _RNG = np.random.default_rng()\n  88: \n  89: # ── CFG: canvas ──────────────────────────────────────────────────────\n  90: GRID_H_RANGE = (19, 31)          # H uniform in [19, 30]\n  91: GRID_W_RANGE = (19, 31)          # W uniform in [19, 30]\n  92: NUM_COLORS = 10                   # palette 0-9\n  93: \n  94: # ── CFG: component shapes ───────────────────────────────────────────\n  95: BBOX_MAX = 5                      # max h or w of a component bbox\n  96: AREA_RANGE = (3, 13)              # component area in [3, 12]\n  97: MIN_FILL_RATIO_X10 = 4            # area * 10 >= 4 * h * w\n  98: IRREGULAR_PROB = 0.85             # prefer non-rectangular bboxes\n  99: \n 100: # ── CFG: layout ─────────────────────────────────────────────────────\n 101: DUP_LAYOUTS = [(2,), (3,), (2, 2)]  # possible duplicate-group structures\n 102: MIN_COL_GAP = 1                   # minimum column gap between components\n 103: MIN_VERTICAL_GAP = 5              # min gap between top-group bottom and bottom-group top\n 104: \n 105: # ── CFG: generation ─────────────────────────────────────────────────\n 106: MAX_RETRIES = 300                 # outer generate_input retry budget\n 107: \n 108: _NEIGHBORS8 = [(-1, -1), (-1, 0), (-1, 1), (0, -1),\n 109:                (0, 1), (1, -1), (1, 0), (1, 1)]\n 110: \n 111: \n 112: def _feasible_dims(area: int) -> list[tuple[int, int]]:\n 113:     \"\"\"Return all (h, w) bboxes where area fits with fill_ratio >= MIN_FILL_RATIO_X10/10.\"\"\"\n 114:     dims = []\n 115:     for h in range(1, BBOX_MAX + 1):\n 116:         for w in range(1, BBOX_MAX + 1):\n 117:             if area > h * w:\n 118:                 continue\n 119:             if area * 10 < MIN_FILL_RATIO_X10 * h * w:\n 120:                 continue\n 121:             if h == 1 and area != w:\n 122:                 continue\n 123:             if w == 1 and area != h:\n 124:                 continue\n 125:             if h > 1 and w > 1 and area < max(h, w):\n 126:                 continue\n 127:             dims.append((h, w))\n 128:     return dims\n 129: \n 130: \n 131: def _line_mask(h: int, w: int) -> np.ndarray:\n 132:     \"\"\"Create a seed mask along a diagonal line spanning the bbox, randomly flipped.\"\"\"\n 133:     mask = np.zeros((h, w), dtype=bool)\n 134:     if h == 1:\n 135:         mask[0, :] = True\n 136:         return mask\n 137:     if w == 1:\n 138:         mask[:, 0] = True\n 139:         return mask\n 140:     steps = max(h, w)\n 141:     for i in range(steps):\n 142:         r = int(round(i * (h - 1) / (steps - 1)))\n 143:         c = int(round(i * (w - 1) / (steps - 1)))\n 144:         mask[r, c] = True\n 145:     if bool(_RNG.integers(0, 2)):\n 146:         mask = np.flipud(mask)\n 147:     if bool(_RNG.integers(0, 2)):\n 148:         mask = np.fliplr(mask)\n 149:     return mask\n 150: \n 151: \n 152: def _make_mask(h: int, w: int, area: int) -> np.ndarray:\n 153:     \"\"\"Grow an 8-connected mask from a line seed to the target area.\"\"\"\n 154:     mask = _line_mask(h, w)\n 155:     while int(mask.sum()) < area:\n 156:         frontier = set()\n 157:         for r, c in np.argwhere(mask):\n 158:             for dr, dc in _NEIGHBORS8:\n 159:                 nr, nc = int(r) + dr, int(c) + dc\n 160:                 if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:\n 161:                     frontier.add((nr, nc))\n 162:         pick = list(frontier)\n 163:         nr, nc = pick[int(_RNG.integers(0, len(pick)))]\n 164:         mask[nr, nc] = True\n 165:     return mask\n 166: \n 167: \n 168: def _mask_to_pat(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\n 169:     \"\"\"Paint a boolean mask into a colored patch on a bg-filled array.\"\"\"\n 170:     pat = np.full(mask.shape, bg, dtype=int)\n 171:     pat[mask] = color\n 172:     return pat\n 173: \n 174: \n 175: def _make_component(area: int, color: int, bg: int) -> dict:\n 176:     \"\"\"Generate a random 8-connected component with the given area and color.\"\"\"\n 177:     dims = _feasible_dims(area)\n 178:     irregular_dims = [d for d in dims if d[0] * d[1] > area]\n 179:     if irregular_dims and _RNG.random() < IRREGULAR_PROB:\n 180:         dims = irregular_dims\n 181:     h, w = dims[int(_RNG.integers(0, len(dims)))]\n 182:     mask = _make_mask(h, w, area)\n 183:     return {\"area\": area, \"color\": color, \"h\": h, \"w\": w,\n 184:             \"mask\": mask, \"pat\": _mask_to_pat(mask, color, bg),\n 185:             \"shape_key\": canonical_shape_key(mask)}\n 186: \n 187: \n 188: def _random_transform(mask: np.ndarray) -> np.ndarray:\n 189:     \"\"\"Apply a random rotation (0-3) and optional horizontal flip to a mask.\"\"\"\n 190:     mask = np.rot90(mask, int(_RNG.integers(0, 4)))\n 191:     if bool(_RNG.integers(0, 2)):\n 192:         mask = np.fliplr(mask)\n 193:     return mask\n 194: \n 195: \n 196: def _clone_component(template: dict, color: int, bg: int) -> dict:\n 197:     \"\"\"Create a duplicate of template's shape with a new color and random transform.\"\"\"\n 198:     mask = _random_transform(template[\"mask\"].copy())\n 199:     h, w = mask.shape\n 200:     return {\"area\": template[\"area\"], \"color\": color, \"h\": h, \"w\": w,\n 201:             \"mask\": mask, \"pat\": _mask_to_pat(mask, color, bg),\n 202:             \"shape_key\": canonical_shape_key(mask)}\n 203: \n 204: \n 205: def _assign_columns(widths: list[int], W: int) -> list[int] | None:\n 206:     \"\"\"Distribute components horizontally with random spacing (min gap = MIN_COL_GAP).\"\"\"\n 207:     n = len(widths)\n 208:     total = sum(widths) + MIN_COL_GAP * (n - 1)\n 209:     if total > W:\n 210:         return None\n 211:     slack = W - total\n 212:     extras = _RNG.multinomial(slack, np.ones(n + 1) / (n + 1))\n 213:     cols = []\n 214:     c = int(extras[0])\n 215:     for i, w in enumerate(widths):\n 216:         cols.append(c)\n 217:         c += w\n 218:         if i < n - 1:\n 219:             c += MIN_COL_GAP + int(extras[i + 1])\n 220:     return cols\n 221: \n 222: \n 223: def _dilate_occupied(occupied: np.ndarray) -> np.ndarray:\n 224:     \"\"\"Return a mask that is True wherever occupied or any 8-neighbor is occupied.\"\"\"\n 225:     dilated = occupied.copy()\n 226:     dilated[1:, :] |= occupied[:-1, :]\n 227:     dilated[:-1, :] |= occupied[1:, :]\n 228:     dilated[:, 1:] |= occupied[:, :-1]\n 229:     dilated[:, :-1] |= occupied[:, 1:]\n 230:     dilated[1:, 1:] |= occupied[:-1, :-1]\n 231:     dilated[1:, :-1] |= occupied[:-1, 1:]\n 232:     dilated[:-1, 1:] |= occupied[1:, :-1]\n 233:     dilated[:-1, :-1] |= occupied[1:, 1:]\n 234:     return dilated\n 235: \n 236: \n 237: def _can_place(dilated: np.ndarray, mask: np.ndarray, r0: int, c0: int) -> bool:\n 238:     \"\"\"Check if mask placed at (r0, c0) overlaps any dilated-occupied cell.\"\"\"\n 239:     h, w = mask.shape\n 240:     return not bool((dilated[r0:r0 + h, c0:c0 + w] & mask).any())\n 241: \n 242: \n 243: def _build_output(comps: list[dict], H: int, W: int, bg: int) -> np.ndarray:\n 244:     \"\"\"Paint all components at their output positions.\"\"\"\n 245:     out = np.full((H, W), bg, dtype=int)\n 246:     for comp in comps:\n 247:         paste(out, comp[\"pat\"], comp[\"out_r0\"], comp[\"c0\"], transparent=bg)\n 248:     return out\n 249: \n 250: \n 251: def _derive_input(comps: list[dict], H: int, W: int, bg: int) -> np.ndarray | None:\n 252:     \"\"\"Place components at random non-output rows without 8-neighbor overlap.\"\"\"\n 253:     inp = np.full((H, W), bg, dtype=int)\n 254:     occupied = np.zeros((H, W), dtype=bool)\n 255:     order = list(range(len(comps)))\n 256:     _RNG.shuffle(order)\n 257:     order.sort(key=lambda i: comps[i][\"h\"] * comps[i][\"w\"], reverse=True)\n 258: \n 259:     for i in order:\n 260:         comp = comps[i]\n 261:         h, c0 = comp[\"h\"], comp[\"c0\"]\n 262:         rows = [r for r in range(H - h + 1) if r != comp[\"out_r0\"]]\n 263:         if not rows:\n 264:             rows = list(range(H - h + 1))\n 265:         _RNG.shuffle(rows)\n 266: \n 267:         dilated = _dilate_occupied(occupied)\n 268:         valid = [r for r in rows if _can_place(dilated, comp[\"mask\"], r, c0)]\n 269:         if not valid:\n 270:             valid = [r for r in range(H - h + 1)\n 271:                      if _can_place(dilated, comp[\"mask\"], r, c0)]\n 272:         if not valid:\n 273:             return None\n 274: \n 275:         r0 = valid[int(_RNG.integers(0, len(valid)))]\n 276:         comp[\"in_r0\"] = r0\n 277:         paste(inp, comp[\"pat\"], r0, c0, transparent=bg)\n 278:         mh, mw = comp[\"mask\"].shape\n 279:         occupied[r0:r0 + mh, c0:c0 + mw] |= comp[\"mask\"]\n 280:     return inp\n 281: \n 282: \n 283: def _build_groups(bg: int) -> tuple[list[dict], list[dict]]:\n 284:     \"\"\"Create duplicate-shape (top) and unique-shape (bottom) component groups.\"\"\"\n 285:     dup_layout = DUP_LAYOUTS[int(_RNG.integers(0, len(DUP_LAYOUTS)))]\n 286:     n_singletons = 2 if sum(dup_layout) == 4 else int(_RNG.integers(2, 4))\n 287: \n 288:     colors = [c for c in range(NUM_COLORS) if c != bg]\n 289:     _RNG.shuffle(colors)\n 290: \n 291:     used_shape_keys: set[tuple[bytes, tuple[int, int]]] = set()\n 292:     top, ci = [], 0\n 293:     for count in dup_layout:\n 294:         for _ in range(200):\n 295:             area = int(_RNG.integers(*AREA_RANGE))\n 296:             template = _make_component(area, colors[ci], bg)\n 297:             if template[\"shape_key\"] not in used_shape_keys:\n 298:                 used_shape_keys.add(template[\"shape_key\"])\n 299:                 break\n 300:         else:\n 301:             raise RuntimeError(\"failed to create a new duplicate template shape\")\n 302:         top.append(template)\n 303:         ci += 1\n 304:         for _ in range(count - 1):\n 305:             top.append(_clone_component(template, colors[ci], bg))\n 306:             ci += 1\n 307: \n 308:     bottom = []\n 309:     while len(bottom) < n_singletons:\n 310:         area = int(_RNG.integers(*AREA_RANGE))\n 311:         comp = _make_component(area, colors[ci], bg)\n 312:         if comp[\"shape_key\"] in used_shape_keys:\n 313:             continue\n 314:         used_shape_keys.add(comp[\"shape_key\"])\n 315:         bottom.append(comp)\n 316:         ci += 1\n 317:     return top, bottom\n 318: \n 319: \n 320: def _gen_attempt() -> np.ndarray | None:\n 321:     \"\"\"Single attempt: build output-first, derive input, validate with oracle.\"\"\"\n 322:     H = int(_RNG.integers(*GRID_H_RANGE))\n 323:     W = int(_RN