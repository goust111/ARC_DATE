89:     g = np.array(grid, dtype=int)\n  90:     H, W = g.shape\n  91:     bg = int(get_bg(g))\n  92: \n  93:     found = _find_framed_rect_uniform_fill(g, bg=int(bg))\n  94:     assert not (found is None)\n  95:     r0, c0, r1, c1, bc, fill = found\n  96:     outH = int(r1 - r0 - 1)\n  97:     outW = int(c1 - c0 - 1)\n  98:     out = np.full((outH, outW), int(fill), dtype=int)\n  99:     r_int0 = int(r0 + 1)\n 100:     c_int0 = int(c0 + 1)\n 101: \n 102:     def map_to_out(rr: int, cc: int) -> tuple[int, int]:\n 103:         r = max(0, min(outH - 1, int(rr - r_int0)))\n 104:         c = max(0, min(outW - 1, int(cc - c_int0)))\n 105:         return int(r), int(c)\n 106: \n 107:     def build_manhattan(p1: tuple[int, int], p2: tuple[int, int], cornerA: bool) -> list[tuple[int, int]]:\n 108:         (ra, ca), (rb, cb) = p1, p2\n 109:         if ra == rb:\n 110:             step = 1 if cb >= ca else -1\n 111:             return [(int(ra), int(c)) for c in range(int(ca), int(cb) + step, step)]\n 112:         if ca == cb:\n 113:             step = 1 if rb >= ra else -1\n 114:             return [(int(r), int(ca)) for r in range(int(ra), int(rb) + step, step)]\n 115:         if cornerA:\n 116:             step = 1 if rb >= ra else -1\n 117:             path = [(int(r), int(ca)) for r in range(int(ra), int(rb) + step, step)]\n 118:             step = 1 if cb >= ca else -1\n 119:             path += [(int(rb), int(c)) for c in range(int(ca) + step, int(cb) + step, step)]\n 120:             return path\n 121:         step = 1 if cb >= ca else -1\n 122:         path = [(int(ra), int(c)) for c in range(int(ca), int(cb) + step, step)]\n 123:         step = 1 if rb >= ra else -1\n 124:         path += [(int(r), int(cb)) for r in range(int(ra) + step, int(rb) + step, step)]\n 125:         return path\n 126: \n 127:     def inside_corner(p1: tuple[int, int], p2: tuple[int, int], cornerA: bool) -> bool:\n 128:         (ra, ca), (rb, cb) = p1, p2\n 129:         if ra == rb or ca == cb:\n 130:             return True\n 131:         corner = (rb, ca) if cornerA else (ra, cb)\n 132:         rr, cc = corner\n 133:         return (0 < rr < outH - 1) and (0 < cc < outW - 1)\n 134: \n 135:     # --- ring components (outside the frame) ---\n 136:     comp_mask = (g != int(bg)) & (g != int(fill)) & (g != int(bc))\n 137:     clab, cn = label(comp_mask, structure=STRUCT4)\n 138: \n 139:     ring = set()\n 140:     for cc in range(c0, c1 + 1):\n 141:         for rr in (r0 - 1, r1 + 1):\n 142:             if 0 <= rr < H:\n 143:                 ring.add((int(rr), int(cc)))\n 144:     for rr in range(r0, r1 + 1):\n 145:         for cc in (c0 - 1, c1 + 1):\n 146:             if 0 <= cc < W:\n 147:                 ring.add((int(rr), int(cc)))\n 148: \n 149:     # cid -> list of (mapped_r, mapped_c, color)\n 150:     comp_pts: dict[int, list[tuple[int, int, int]]] = defaultdict(list)\n 151:     for rr, cc in ring:\n 152:         cid = int(clab[rr, cc])\n 153:         if cid == 0:\n 154:             continue\n 155:         col = int(g[rr, cc])\n 156:         mr, mc = map_to_out(rr, cc)\n 157:         comp_pts[cid].append((mr, mc, col))\n 158: \n 159:     # per-component color sets\n 160:     comp_cols: dict[int, list[int]] = {}\n 161:     for cid in range(1, int(cn) + 1):\n 162:         comp_cols[cid] = sorted(set(map(int, g[clab == int(cid)].flatten())))\n 163: \n 164:     deferred: dict[int, set[tuple[int, int]]] = defaultdict(set)\n 165: \n 166:     for cid, pts in comp_pts.items():\n 167:         if len(pts) < 2:\n 168:             continue\n 169:         cols = comp_cols.get(cid, [])\n 170:         if not cols:\n 171:             continue\n 172: \n 173:         # build per-coordinate color histogram (clamp can merge multiple ring pixels)\n 174:         hist: dict[tuple[int, int], Counter] = defaultdict(Counter)\n 175:         for r, c, col in pts:\n 176:             hist[(int(r), int(c))][int(col)] += 1\n 177: \n 178:         coords = list(hist.keys())\n 179: \n 180:         if len(cols) == 1:\n 181:             colv = int(cols[0])\n 182:             uniq = coords\n 183:             rows = {r for r, _c in uniq}\n 184:             cols2 = {c for _r, c in uniq}\n 185:             if len(rows) == 1 or len(cols2) == 1:\n 186:                 for p in uniq:\n 187:                     deferred[colv].add((int(p[0]), int(p[1])))\n 188:                 continue\n 189: \n 190:             # Connect farthest pair by a Manhattan path.\n 191:             best = None\n 192:             for i in range(len(uniq)):\n 193:                 for j in range(i + 1, len(uniq)):\n 194:                     d = abs(uniq[i][0] - uniq[j][0]) + abs(uniq[i][1] - uniq[j][1])\n 195:                     if best is None or d > best[0]:\n 196:                         best = (d, uniq[i], uniq[j])\n 197:             if best is None:\n 198:                 continue\n 199:             _d, p1, p2 = best\n 200:             pathA = build_manhattan(p1, p2, True)\n 201:             pathB = build_manhattan(p1, p2, False)\n 202:             chosen = pathB if (inside_corner(p1, p2, False) and not inside_corner(p1, p2, True)) else pathA\n 203:             for rr, cc in chosen:\n 204:                 out[int(rr), int(cc)] = int(colv)\n 205:             continue\n 206: \n 207:         if len(cols) == 2:\n 208:             # Choose farthest pair in mapped space.\n 209:             best = None\n 210:             for i in range(len(coords)):\n 211:                 for j in range(i + 1, len(coords)):\n 212:                     d = abs(coords[i][0] - coords[j][0]) + abs(coords[i][1] - coords[j][1])\n 213:                     if best is None or d > best[0]:\n 214:                         best = (d, coords[i], coords[j])\n 215:             if best is None:\n 216:                 continue\n 217:             _d, a, b = best\n 218:             # Component's two colors (alternation palette).\n 219:             ca, cb = map(int, cols)\n 220:             # Endpoint color hints from ring-touch pixels (can be same on both ends).\n 221:             ha = int(hist[a].most_common(1)[0][0])\n 222:             hb = int(hist[b].most_common(1)[0][0])\n 223: \n 224:             # Pick a Manhattan path (prefer elbow inside the interior).\n 225:             pathA = build_manhattan(a, b, True)\n 226:             pathB = build_manhattan(a, b, False)\n 227:             path = pathB if (inside_corner(a, b, False) and not inside_corner(a, b, True)) else pathA\n 228: \n 229:             def paint_alt(path_pts: list[tuple[int, int]], start_color: int):\n 230:                 cur = int(start_color)\n 231:                 for rr, cc in path_pts:\n 232:                     out[int(rr), int(cc)] = int(cur)\n 233:                     cur = int(cb) if cur == int(ca) else int(ca)\n 234: \n 235:             # Determine phase by constraining endpoint colors (from ring-touch hints).\n 236:             chosen = None  # (path_pts, start_color)\n 237:             for path_pts in (path, list(reversed(path))):\n 238:                 for start_color in (ca, cb):\n 239:                     end_color = start_color if ((len(path_pts) - 1) % 2 == 0) else (cb if start_color == ca else ca)\n 240:                     if int(start_color) != int(ha):\n 241:                         continue\n 242:                     if int(end_color) != int(hb):\n 243:                         continue\n 244:                     chosen = (path_pts, int(start_color))\n 245:                     break\n 246:                 if chosen is not None:\n 247:                     break\n 248: \n 249:             assert chosen is not None\n 250: \n 251:             path_pts, start_color = chosen\n 252:             paint_alt(path_pts, start_color)\n 253:             continue\n 254: \n 255:     # Aggregate deferred monochrome points by color into stripes/segments.\n 256:     for col, pts in deferred.items():\n 257:         pts = list(pts)\n 258:         if not pts:\n 259:             continue\n 260:         tops = [