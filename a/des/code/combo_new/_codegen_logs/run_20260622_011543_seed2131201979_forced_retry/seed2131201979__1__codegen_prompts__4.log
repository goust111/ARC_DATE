ructure\n  76:     - The background is the most common color, and the foreground has one largest destination object plus smaller source sprites.\n  77:     - Each source sprite shares exactly one marker color with the destination object.\n  78: \n  79:     Rule\n  80:     - Output the tight bbox crop of the largest object.\n  81:     - Translate each source sprite so every connected marker component of the shared color exactly matches destination marker components.\n  82:     - Paste source sprites in decreasing area order, so smaller sprites can sit on top of larger ones when they overlap.\n  83: \n  84:     Key insight\n  85:     - The shared-color marker components are alignment keys; matching whole marker components distinguishes singleton slots from larger same-color marker blocks.\n  86:     \"\"\"\n  87:     g = np.asarray(grid, dtype=int)\n  88:     bg = int(get_bg(g))\n  89: \n  90:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n  91:     assert len(comps) >= 2, \"must have a destination object and at least one source sprite\"\n  92: \n  93:     areas = [int(comp[\"area\"]) for comp in comps]\n  94:     max_area = max(areas)\n  95:     assert areas.count(max_area) == 1, \"largest destination object must be unique\"\n  96:     dst_index = areas.index(max_area)\n  97:     dst_comp = comps[dst_index]\n  98:     dst_patch, dst_mask, dst_colors = _component_data(g, dst_comp)\n  99: \n 100:     sources = [comp for idx, comp in enumerate(comps) if idx != dst_index]\n 101:     source_areas = [int(comp[\"area\"]) for comp in sources]\n 102:     assert len(set(source_areas)) == len(source_areas), \"source sprites must have distinct areas for layering\"\n 103:     sources.sort(key=lambda comp: -int(comp[\"area\"]))\n 104: \n 105:     out = dst_patch.copy()\n 106:     out_h, out_w = out.shape\n 107: \n 108:     for src_comp in sources:\n 109:         src_patch, src_mask, src_colors = _component_data(g, src_comp)\n 110:         common_colors = src_colors & dst_colors\n 111:         assert len(common_colors) == 1, \"each source must share exactly one marker color with the destination\"\n 112:         marker_color = next(iter(common_colors))\n 113: \n 114:         src_marker = (src_patch == marker_color) & src_mask\n 115:         dst_marker = (dst_patch == marker_color) & dst_mask\n 116:         assert bool(src_marker.any()) and bool(dst_marker.any()), \"marker pixels must exist in source and destination\"\n 117: \n 118:         top, left = _unique_marker_offset(src_marker, dst_marker)\n 119:         src_h, src_w = src_patch.shape\n 120:         assert 0 <= top and 0 <= left, \"translated sprite must fit inside destination crop\"\n 121:         assert top + src_h <= out_h and left + src_w <= out_w, \"translated sprite must fit inside destination crop\"\n 122:         paste(out, src_patch, top, left, mask=src_mask, overwrite=True)\n 123: \n 124:     return out\n 125: \n 126: # --------------- generator (att2) ---------------\n 127: \n 128: from arc_utils import bbox_coords\n 129: \n 130: \n 131: # Canvas, destination, and source bounds.\n 132: INPUT_SHAPE = (30, 30)\n 133: DST_HEIGHT_RANGE, DST_WIDTH_RANGE, DST_MAX_AREA = (9, 13), (5, 16), 195\n 134: SOURCE_COUNT_RANGE, SRC_HEIGHT_RANGE, SRC_WIDTH_RANGE = (1, 2), (3, 8), (3, 9)\n 135: SRC_DST_MARGIN = 1\n 136: DST_SIZE_OPTIONS = tuple(\n 137:     (h, w) for h in range(DST_HEIGHT_RANGE[0], DST_HEIGHT_RANGE[1] + 1)\n 138:     for w in range(DST_WIDTH_RANGE[0], DST_WIDTH_RANGE[1] + 1) if h * w <= DST_MAX_AREA\n 139: )\n 140: \n 141: # Marker component counts, shape library, and spacing.\n 142: MARKER_COUNT_RANGE, MARKER_AREA_RANGE = (2, 4), (1, 8)\n 143: MARKER_SHAPE_BOX, MARKER_BORDER, MARKER_CLEARANCE = 3, 1, 1\n 144: MIN_GROUPS_SINGLE_SOURCE, MIN_GROUPS_TWO_SOURCES = 1, 2\n 145: \n 146: # Palette layout: background, destination fill, marker, then source-own colors.\n 147: COLOR_COUNT, FIXED_COLOR_COUNT = 10, 3\n 148: \n 149: # Input placement spacing and generation retry budget.\n 150: PIECE_BORDER, PIECE_PADDING, PIECE_PADDING_CONNECTIVITY = 1, 4, 8\n 151: MAX_GENERATION_ATTEMPTS = 300\n 152: \n 153: Shape = tuple[tuple[int, int], ...]\n 154: \n 155: \n 156: def _norm_shape(cells) -> Shape:\n 157:     r0 = min(r for r, _c in cells)\n 158:     c0 = min(c for _r, c in cells)\n 159:     return tuple(sorted((int(r - r0), int(c - c0)) for r, c in cells))\n 160: \n 161: \n 162: def _connected(shape: Shape) -> bool:\n 163:     cells = set(shape)\n 164:     seen = {next(iter(cells))}\n 165:     stack = list(seen)\n 166:     while stack:\n 167:         r, c = stack.pop()\n 168:         for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):\n 169:             if (nr, nc) in cells and (nr, nc) not in seen:\n 170:                 seen.add((nr, nc))\n 171:                 stack.append((nr, nc))\n 172:     return len(seen) == len(cells)\n 173: \n 174: \n 175: def _shape_library() -> dict[int, list[Shape]]:\n 176:     base = [(r, c) for r in range(MARKER_SHAPE_BOX) for c in range(MARKER_SHAPE_BOX)]\n 177:     by_area: dict[int, list[Shape]] = {\n 178:         area: [] for area in range(MARKER_AREA_RANGE[0], MARKER_AREA_RANGE[1] + 1)\n 179:     }\n 180:     seen: set[Shape] = set()\n 181:     for area in range(MARKER_AREA_RANGE[0], MARKER_AREA_RANGE[1] + 1):\n 182:         for combo in itertools.combinations(base, area):\n 183:             shape = _norm_shape(combo)\n 184:             if shape not in seen and _connected(shape):\n 185:                 seen.add(shape)\n 186:                 by_area[area].append(shape)\n 187:     return by_area\n 188: \n 189: \n 190: _SHAPES_BY_AREA = _shape_library()\n 191: \n 192: \n 193: def _partition_count(total: int, groups: int) -> list[int]:\n 194:     parts = [1] * groups\n 195:     for _ in range(total - groups):\n 196:         parts[random.randrange(groups)] += 1\n 197:     random.shuffle(parts)\n 198:     return parts\n 199: \n 200: \n 201: def _choose_group_shapes(n_groups: int) -> list[Shape]:\n 202:     used: set[Shape] = set()\n 203:     shapes: list[Shape] = []\n 204:     for _ in range(n_groups):\n 205:         target_area = random.randint(*MARKER_AREA_RANGE)\n 206:         options = [s for s in _SHAPES_BY_AREA[target_area] if s not in used]\n 207:         if not options:\n 208:             options = [s for group in _SHAPES_BY_AREA.values() for s in group if s not in used]\n 209:         shape = random.choice(options)\n 210:         used.add(shape)\n 211:         shapes.append(shape)\n 212:     return shapes\n 213: \n 214: \n 215: def _place_marker_components(\n 216:     dst: np.ndarray, group_sizes: list[int], group_shapes: list[Shape], marker: int\n 217: ) -> list[dict] | None:\n 218:     h, w = dst.shape\n 219:     blocked = np.zeros(dst.shape, dtype=bool)\n 220:     comps: list[dict] = []\n 221: \n 222:     for group, (count, shape) in enumerate(zip(group_sizes, group_shapes)):\n 223:         sh = max(r for r, _c in shape) + 1\n 224:         sw = max(c for _r, c in shape) + 1\n 225:         for _ in range(count):\n 226:             candidates: list[tuple[int, int]] = []\n 227:             for r0 in range(MARKER_BORDER, h - sh):\n 228:                 for c0 in range(MARKER_BORDER, w - sw):\n 229:                     coords = [(r0 + r, c0 + c) for r, c in shape]\n 230:                     if not any(blocked[r, c] for r, c in coords):\n 231:                         candidates.append((r0, c0))\n 232:             if not candidates:\n 233:                 return None\n 234: \n 235:             r0, c0 = random.choice(candidates)\n 236:             coords = tuple((r0 + r, c0 + c) for r, c in shape)\n 237:             rows, cols = zip(*coords)\n 238:             dst[rows, cols] = int(marker)\n 239:             for r, c in coords:\n 240:                 blocked[\n 241:                     max(0, r - MARKER_CLEARANCE) : min(h, r + MARKER_CLEARANCE + 1),\n 242:                     max(0, c - MARKER_CLEARANCE) : min(w, c + MARKER_CLEARANCE + 1),\n 243:                 ] = True\n 244:             comps.append({\"group\": group, \"shape\": shape, \"coords\": coords})\n 245:     return comps\n 246: \n 247: \n 248: def _axis_starts(lo: int, hi: int, size: int, limit: int) -> range:\n 249:     start_min = max(SRC_DST_MARGIN, hi - size + 1)\n 250:     start_max = min(lo, limit - size - SRC_DST_MARGIN)\n 251:     if start_min > start_max:\n 252:         return range(0)\n 253:     return range(start_min, start_max + 1)\n 254: \n 255: \n 256: def _candidate_rects(comp_indices: list[int], comps: list[dict], dst_h: int, dst_w: int) -> list[tuple[int, int, int, int]]:\n 257:     coords = np.array([pt for idx in comp_indices for pt in comps[idx][\"coords\"]], dtype=int)\n 258:     r0, c0, r1, c1 = bbox_coords(coords)\n 259:     min_h = max(SRC_HEIGHT_RANGE[0], r1 - r0 + 1)\n 260:     min_w = max(SRC_WIDTH_RANGE[0], c1 - c0 + 1)\n 261:     max_h = min(SRC_HEIGHT_RANGE[1], dst_h - 2 * SRC_DST_MARGIN)\n 262:     max_w = min(SRC_WIDTH_RANGE[1], dst_w - 2 * SRC_DST_MARGIN)\n 263:     dst_area = dst_h * dst_w\n 264: \n 265:     candidates: list[tuple[int, int, int, int]] = []\n 266:     for src_h in range(min_h, max_h + 1):\n 267:         top_starts = _axis_starts(r0, r1, src_h, dst_h)\n 268:         if not top_starts:\n 269:             continue\n 270:         for src_w in range(min_w, max_w + 1):\n 271:             if src_h * src_w >= dst_area:\n 272:                 continue\n 273:             left_starts = _axis_starts(c0, c1, src_w, dst_w)\n 274:             if not left_starts:\n 275:                 continue\n 276:             for top in top_starts:\n 277:                 for left in left_starts:\n 278:                     candidates.append((top, left, src_h, src_w))\n 279:     return candidates\n 280: \n 281: \n 282: def _make_source(\n 283:     rect: tuple[int, int, int, int], comp_indices: list[int], comps: list[dict], marker: int, own: int\n 284: ) -> dict:\n 285:     top, left, src_h, src_w = rect\n 286:     patch = np.full((src_h, src_w), int(own), dtype=int)\n 287:     for idx in comp_indices:\n 288:         coords = comps[idx][\"coords\"]\n 289:         rows = [r - top for r, _c in coords]\n 290:         cols = [c - left for _r, c in coords]\n 291:         patch[rows, cols] = int(marker)\n 292:     return {\"top\": top, \"left\": left, \"patch\": patch}\n 293: \n 294: \n 295: def _source_specs(comps: list[dict], n_groups: int, dst_h: int, dst_w: int, n_src: int):\n 296:     by_subset = {}\n 297:     for mask in range(1, 1 << n_groups):\n 298:         groups = tuple(i for i in range(n_groups) if mask & (1 << i))\n 299:         comp_indices = [idx for idx, comp in enumerate(comps) if comp[\"group\"] in groups]\n 300:         rects = _candidate_rects(comp_indices, comps, dst_h, dst_w)\n 301:         if rects:\n 302:             by_subset[groups] = (comp_indices, rects)\n 303:     if n_src == 1:\n 304:         if not by_subset:\n 305:             return None\n 306:         groups = random.choice(list(by_subset))\n 307:         comp_indices, rects = by_subset[groups]\n 308:         return [(comp_indices, random.choice(rects))]\n 309: \n 310:     plans = []\n 311:     subsets = list(by_subset)\n 312:     for a, b in itertools.combinations(subsets, 2):\n 313:         if set(a) & set(b):\n 314:             continue\n 315:         a_indices, a_rects = by_subset[a]\n 316:         b_indices, b_rects = by_subset[b]\n 317:         rect_pairs = [\n 318:             (ra, rb) for ra in a_rects for rb in b_rects if ra[2] * ra[3] != rb[2] * rb[3]\n 319:         ]\n 320:         if rect_pairs:\n 321:             plans.append((a_indices, b_indices, rect_pairs))\n 322:     if not plans:\n 323:         return None\n 324:     a_indices, b_indices, rect_pairs = random.choice(plans)\n 325:     ra, rb = random.choice(rect_pairs)\n 326:     return [(a_indices, ra), (b_indices, rb)]\n 327: \n 328: \n 329: def _compose_input(bg: int, dst: np.ndarray, sources: list[dict]) -> np.ndarray | None:\n 330:     inp = np.full(INPUT_SHAPE, int(bg), dtype=int)\n 331:     pieces = [dst] + [src[\"patch\"] for src in sources]\n 332:     try:\n 333:         for patch in sorted(pieces, key=lambda p: -p.size):\n 334:             r0, c0 = random_free_location(\n 335:                 inp, patch, transparent=bg, border=PIECE_BORDER, padding=PIECE_PADDING,\n 336:                 padding_connectivity=PIECE_PADDING_CONNECTIVITY,\n 337:             )\n 338:             paste(inp, patch, r0, c0)\n 339:     except ValueError:\n 340:         return None\n 341:     return inp\n 342: \n 343: \n 344: def _gen_attempt() -> np.ndarray | None:\n 345:     n_src = random.randint(*SOURCE_COUNT_RANGE)\n 346:     dst_h, dst_w = random.choice(DST_SIZE_OPTIONS)\n 347:     n_marker = random.randint(*MARKER_COUNT_RANGE)\n 348:     min_groups = MIN_GROUPS_TWO_SOURCES if n_src == 2 else MIN_GROUPS_SINGLE_SOURCE\n 349:     n_groups = random.randint(min_groups, n_marker)\n 350: \n 351:     colors = random.sample(range(COLOR_COUNT), FIXED_COLOR_COUNT + n_src)\n 352:     bg, dst_primary, marker = colors[:FIXED_COLOR_COUNT]\n 353:     own_colors = colors[FIXED_COLOR_COUNT:]\n 354: \n 355:     dst = np.full((dst_h, dst_w), int(dst_primary), dtype=int)\n 356:     group_sizes = _partition_count(n_marker, n_groups)\n 357:     group_shapes = _choose_group_shapes(n_groups)\n 358:     comps = _place_marker_components(dst, group_sizes, group_shapes, marker)\n 359:     if comps is None:\n 360:         return None\n 361: \n 362:     specs = _source_specs(comps, n_groups, dst_h, dst_w, n_src)\n 363:     if specs is None:\n 364:         return None\n 365: \n 366:     sources = [\n 367:         _make_source(rect, comp_indices, comps, marker, own)\n 368:         for own, (comp_indices, rect) in zip(own_colors, specs)\n 369:     ]\n 370:     out = dst.copy()\n 371:     for src in sorted(sources, key=lambda s: -s[\"patch\"].size):\n 372:         paste(out, src[\"patch\"], src[\"top\"], src[\"left\"])\n 373:     inp = _compose_input(bg, dst, sources)\n 374:     if inp is None:\n 375:         return None\n 376: \n 377:     try:\n 378:         got = main(inp)\n 379:     except Exception:\n 380:         return None\n 381:     if not np.array_equal(got, out):\n 382:         return None\n 383:     return inp\n 384: \n 385: \n--- lines 386-391 ---\n 386: def generate_input() -> np.ndarray:\n 387:     for _ in range(MAX_GENERATION_ATTEMPTS):\n 388:         grid = _gen_attempt()\n 389:         if grid is not None:\n 390:             return grid\n 391:     raise RuntimeError(\"failed to generate valid 83eb0a57 input\")\n===== 88e364bc =====\n--- lines 101-603 ---\n 101: def main(grid: np.ndarray) -> np.ndarray:\n 102:     \"\"\"\n 103:     Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n 104: \n 105:     Input structure:\n 106:     - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n 107:     - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n 108: \n 109:     Rule:\n 110:     - For each enclosed region, identify its border color C and look up the legend with fill color C.\n 111:     - The direction from the legend's center dot to its indicator dot gives the slide direction.\n 112:     - All yellow pixels in that region slide in that direction, stacking against the far wall.\n 113: \n 114:     Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n 115:     \"\"\"\n 116:     g = np.asarray(grid, dtype=int)\n 117:     h, w = g.shape\n 118:     bg = get_bg(g)\n 119: \n 120:     mover = 4  # yellow in ARC\n 121:     dirs = _legend_directions(g, bg)\n 122:     assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n 123: \n 124:     passable = (g == bg) | (g == mover)\n 125:     out = g.copy()\n 126: \n 127:     # Find enclosed passable regions (not connected to the outer border).\n 128:     for pts in components_mask(passable, connectivity=4):\n 129:         if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n 130:             continue  # outside background\n 131: \n 132:         movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n 133:         if not movers:\n 134:             continue\n 135: \n 136:         # Determine this region's border color by counting adjacent wall colors.\n 137:         border_counts: dict[int, int] = {}\n 138:         pset = {(int(r), int(c)) for r, c in pts}\n 139:         for r, c in pts:\n 140:             for nr, nc in neighbors4(r, c):\n 141:                 if not (0 <= nr < h and 0 <= nc < w):\n 142:                     continue\n 143:                 if (nr, nc) in pset:\n 144:                     continue\n 145:                 v = int(g[nr, nc])\n 146:                 if v == bg or v == mover:\n 147:                     continue\n 148:                 border_counts[v] = border_counts.get(v, 0) + 1\n 149:         if not border_counts:\n 150:             continue\n 151:         border_col = max(border_counts, key=border_counts.get)\n 152:         if border_col not in dirs:\n 153:             continue\n 154:         dr, dc = dirs[border_col]\n 155: \n 156:         # Clear old movers.\n 157:         for r, c in movers:\n 158:             out[r, c] = bg\n 159: \n 160:         # Slide and repaint.\n 161:         new_pts = _slide_points(pset, movers, dr, dc)\n 162:         for r, c in new_pts:\n 163:             out[r, c] = mover\n 164: \n 165:     return out\n 166: \n 167: # --------------- generator (claude-att1) ---------------\n 168: \n 169: \"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\n 170: import random\n 171: import numpy as np\n 172: \n 173: from arc_utils import label_mask, neighbors4, paste\n 174: \n 175: # ── Configuration ─────────────────────────────────────────────────\n 176: GRID_H, GRID_W = 20, 20\n 177: \n 178: # Legend\n 179: CARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n 180: DIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\n 181: CORNERS = ['TL', 'TR', 'BL', 'BR']\n 182: WALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\n 183: CARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\n 184: LEGEND_BUFFER = 1                          # cells of padding around legend patches\n 185: \n 186: # Regions\n 187: REGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\n 188: MAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\n 189: REGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n 190:     1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n 191: }\n 192: BLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n 193: \n 194: # Yellows\n 195: YELLOWS_PER_REGION = [1, 2]                # choices per region\n 196: MAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n 197: \n 198: # Outer loop\n 199: GEN_RETRIES = 300                          # max attempts in generate_input()\n 200: \n 201: \n 202: # ── Legend patches ────────────────────────────────────────────────\n 203: \n 204: def _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n 205:     \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n 206:     g = np.full((5, 5), fill, dtype=int)\n 207:     g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n 208:     g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n 209:     rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n 210:     return np.rot90(g, rot[(dr, dc)])\n 211: \n 212: \n 213: def _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n 214:     \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n 215:     g = np.full((6, 7), fill, dtype=int)\n 216:     g[1, 3] = 1\n 217:     g[2, 1] = 1; g[2, 4] = 1\n 218:     g[3, 2] = 1; g[3, 5] = 2\n 219:     g[4, 3] = 2\n 220:     if (dr, dc) == (1, 1): return g\n 221:     if (dr, dc) == (-1, 1): return np.flipud(g)\n 222:     if (dr, dc) == (1, -1): return np.fliplr(g)\n 223:     if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n 224:     raise ValueError((dr, dc))\n 225: \n 226: \n 227: def _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n 228:     \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n 229:     if corner == 'TL': return 0, 0\n 230:     if corner == 'TR': return 0, w - pw\n 231:     if corner == 'BL': return h - ph, 0\n 232:     if corner == 'BR': return h - ph, w - pw\n 233:     raise ValueError(corner)\n 234: \n 235: \n 236: # ── Blob growing / topology ──────────────────────────────────────\n 237: \n 238: def _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n 239:                rng: random.Random) -> set[tuple[int, int]] | None:\n 240:     \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n 241:     h, w = canvas_mask.shape\n 242:     sr, sc = seed\n 243:     if not canvas_mask[sr, sc]:\n 244:         return None\n 245:     blob = {(sr, sc)}\n 246:     frontier = []\n 247:     def push_neighbors(r, c):\n 248:         for nr, nc in neighbors4(r, c):\n 249:             if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:\n 250:                 frontier.append((nr, nc))\n 251:     push_neighbors(sr, sc)\n 252:     while len(blob) < target_size and frontier:\n 253:         idx = rng.randrange(len(frontier))\n 254:         r, c = frontier.pop(idx)\n 255:         if (r, c) in blob or not canvas_mask[r, c]:\n 256:             continue\n 257:         blob.add((r, c))\n 258:         push_neighbors(r, c)\n 259:     if len(blob) < target_size:\n 260:         return None\n 261:     return blob\n 262: \n 263: \n 264: def _blob_wall_cells(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n 265:     \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n 266:     wall = set()\n 267:     for r, c in blob:\n 268:         for nr, nc in neighbors4(r, c):\n 269:             if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in blob:\n 270:                 wall.add((nr, nc))\n 271:     return wall\n 272: \n 273: \n 274: def _fill_holes(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n 275:     \"\"\"Return blob with interior holes absorbed.\n 276: \n 277:     Barrier = blob union its wall ring. Any non-barrier cell unreachable from the grid\n 278:     border through non-barrier cells is trapped and gets absorbed into the blob.\n 279:     \"\"\"\n 280:     walls = _blob_wall_cells(blob, h, w)\n 281:     barrier = np.zeros((h, w), dtype=bool)\n 282:     for r, c in blob:\n 283:         barrier[r, c] = True\n 284:     for r, c in walls:\n 285:         barrier[r, c] = True\n 286: \n 287:     # Flood-fill from border through non-barrier cells.\n 288:     reachable = np.zeros((h, w), dtype=bool)\n 289:     stack = []\n 290:     for r in range(h):\n 291:         for c in (0, w - 1):\n 292:             if not barrier[r, c]:\n 293:                 stack.append((r, c))\n 294:     for c in range(w):\n 295:         for r in (0, h - 1):\n 296:             if not barrier[r, c]:\n 297:                 stack.append((r, c))\n 298:     while stack:\n 299:         r, c = stack.pop()\n 300:         if reachable[r, c] or barrier[r, c]:\n 301:             continue\n 302:         reachable[r, c] = True\n 303:         for nr, nc in neighbors4(r, c):\n 304:             if 0 <= nr < h and 0 <= nc < w and not reachable[nr, nc] and not barrier[nr, nc]:\n 305:                 stack.append((nr, nc))\n 306: \n 307:     trapped = (~reachable) & (~barrier)\n 308:     if not trapped.any():\n 309:         return blob\n 310:     filled = set(blob)\n 311:     for r, c in np.argwhere(trapped):\n 312:         filled.add((int(r), int(c)))\n 313:     return filled\n 314: \n 315: \n 316: # ── Slide helpers ─────────────────────────────────────────────────\n 317: \n 318: def _slide_step_valid(region_set: set, r: int, c: int, dr: int, dc: int) -> bool:\n 319:     nr, nc = r + dr, c + dc\n 320:     if (nr, nc) not in region_set:\n 321:         return False\n 322:     if dr != 0 and dc != 0:\n 323:         if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n 324:             return False\n 325:     return True\n 326: \n 327: \n 328: def _forward_slide(region_set: set, start: tuple[int, int], dr: int, dc: int,\n 329:                    blocked: set) -> tuple[int, int]:\n 330:     \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n 331:     r, c = start\n 332:     while True:\n 333:         if not _slide_step_valid(region_set, r, c, dr, dc):\n 334:             break\n 335:         nr, nc = r + dr, c + dc\n 336:         if (nr, nc) in blocked:\n 337:             break\n 338:         r, c = nr, nc\n 339:     return (r, c)\n 340: \n 341: \n 342: # ── Generator phases ─────────────────────────────────────────────\n 343: \n 344: def _place_legends(rng: random.Random, grid: np.ndarray,\n 345:                    ) -> tuple[np.ndarray, list[tuple[int, tuple[int,int]]]]:\n 346:     \"\"\"Place 1-2 legend patches at grid corners.\n 347: \n 348:     Returns (legend_occupied mask, list of (wall_color, direction) pairs).\n 349:     \"\"\"\n 350:     h, w = grid.shape\n 351:     n_legends = rng.choice([1, 2])\n 352:     corners = rng.sample(CORNERS, n_legends)\n 353:     wall_colors = rng.sample(WALL_COLOR_CHOICES, n_legends)\n 354: \n 355:     legend_occupied = np.zeros((h, w), dtype=bool)\n 356:     legends = []\n 357: \n 358:     for corner, wc in zip(corners, wall_colors):\n 359:         if rng.random() < CARDINAL_PROB:\n 360:             dr, dc = rng.choice(CARDINAL_DIRS)\n 361:             patch = _legend_5x5(wc, dr, dc)\n 362:         else:\n 363:             dr, dc = rng.choice(DIAGONAL_DIRS)\n 364:             patch = _legend_6x7(wc, dr, dc)\n 365:         ph, pw = patch.shape\n 366:         r0, c0 = _corner_origin(corner, h, w, ph, pw)\n 367:         paste(grid, patch, r0, c0)\n 368:         # Reserve legend cells + buffer.\n 369:         r_lo, r_hi = max(0, r0 - LEGEND_BUFFER), min(h, r0 + ph + LEGEND_BUFFER)\n 370:         c_lo, c_hi = max(0, c0 - LEGEND_BUFFER), min(w, c0 + pw + LEGEND_BUFFER)\n 371:         legend_occupied[r_lo:r_hi, c_lo:c_hi] = True\n 372:         legends.append((wc, (dr, dc)))\n 373: \n 374:     return legend_occupied, legends\n 375: \n 376: \n 377: def _grow_regions(rng: random.Random, legends: list[tuple[int, tuple[int,int]]],\n 378:                   legend_occupied: np.ndarray,\n 379:                   ) -> list[dict] | None:\n 380:     \"\"\"Grow irregular closed regions, one per assigned wall color.\n 381: \n 382:     Returns list of region dicts or None on failure.\n 383:     \"\"\"\n 384:     h, w = legend_occupied.shape\n 385:     color_dir = {wc: d for wc, d in legends}\n 386:     all_colors = [wc for wc, _ in legends]\n 387: \n 388:     # Assign 1-3 regions per wall color, cap total.\n 389:     region_colors = []\n 390:     for c in all_colors:\n 391:         region_colors.extend([c] * rng.randint(*REGIONS_PER_COLOR))\n 392:     if len(region_colors) > MAX_TOTAL_REGIONS:\n 393:         region_colors = rng.sample(region_colors, MAX_TOTAL_REGIONS)\n 394:     rng.shuffle(region_colors)\n 395: \n 396:     size_min, size_max = REGION_SIZE_BOUNDS[len(region_colors)]\n 397:     occupied = legend_occupied.copy()\n 398:     regions = []\n 399: \n 400:     for rc in region_colors:\n 401:         dr, dc = color_dir[rc]\n 402:         target_size = rng.randint(size_min, size_max)\n 403: \n 404:         # Build canvas: interior cells (not border) that are unoccupied.\n 405:         canvas = np.ones((h, w), dtype=bool)\n 406:         canvas[0, :] = False; canvas[-1, :] = False\n 407:         canvas[:, 0] = False; canvas[:, -1] = False\n 408:         canvas &= ~occupied\n 409:         if not canvas.any():\n 410:             continue\n 411: \n 412:         blob = _try_grow_valid_blob(rng, canvas, occupied, target_size, h, w)\n 413:         if blob is None:\n 414:             continue\n 415: \n 416:         walls = _blob_wall_cells(blob, h, w)\n 417:         regions.append({'color': rc, 'dir': (dr, dc), 'interior': blob, 'walls': walls})\n 418: \n 419:         # Reserve blob + walls + 1-cell buffer around walls.\n 420:         reserve = blob | walls\n 421:         extra = set()\n 422:         for r, c in walls:\n 423:             for nr, nc in neighbors4(r, c):\n 424:                 if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in reserve:\n 425:                     extra.add((nr, nc))\n 426:         for r, c in reserve | extra:\n 427:             occupied[r, c] = True\n 428: \n 429:     if not regions:\n 430:         return None\n 431:     # Every legend color must have at least one region.\n 432:     if {reg['color'] for reg in regions} != set(all_colors):\n 433:         return None\n 434:     return regions\n 435: \n 436: \n 437: def _try_grow_valid_blob(rng: random.Random, canvas: np.ndarray,\n 438:                          occupied: np.ndarray, target_size: int,\n 439:                          h: int, w: int) -> set[tuple[int,int]] | None:\n 440:     \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n 441:     for _ in range(BLOB_GROW_RETRIES):\n 442:         free = np.argwhere(canvas)\n 443:         if len(free) == 0:\n 444:             break\n 445:         sr, sc = free[rng.randrange(len(free))]\n 446:         cand = _grow_blob(canvas, (int(sr), int(sc)), target_size, rng)\n 447:         if cand is None:\n 448:             continue\n 449:         # Fill interior holes until stable.\n 450:         while True:\n 451:             filled = _fill_holes(cand, h, w)\n 452:             if filled == cand:\n 453:                 break\n 454:             cand = filled\n 455:         # Absorbed cells must stay within canvas.\n 456:         if any(not canvas[r, c] for r, c in cand):\n 457:             continue\n 458:         walls = _blob_wall_cells(cand, h, w)\n 459:         # Walls must not overlap occupied cells or the grid border.\n 460:         if any(occupied[wr, wc] or wr in (0, h - 1) or wc in (0, w - 1)\n 461:                for wr, wc in walls):\n 462:             continue\n 463:         return cand\n 464:     return None\n 465: \n 466: \n 467: def _validate_topology(grid: np.ndarray, regions: list[dict]) -> bool:\n 468:     \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n 469:     h, w = grid.shape\n 470:     labeled, n_comp = label_mask(grid == 0, connectivity=4)\n 471:     bounded = []\n 472:     for comp_id in range(1, n_comp + 1):\n 473:         coords = np.argwhere(labeled == comp_id)\n 474:         if any(r in (0, h - 1) or c in (0, w - 1) for r, c in coords):\n 475:             continue\n 476:         bounded.append({(int(r), int(c)) for r, c in coords})\n 477:     region_sets = [reg['interior'] for reg in regions]\n 478:     if len(bounded) != len(region_sets):\n 479:         return False\n 480:     return all(comp in region_sets for comp in bounded)\n 481: \n 482: \n 483: def _place_yellows(rng: random.Random, regions: list[dict],\n 484:                    grid: np.ndarray) -> bool:\n 485:     \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n 486: \n 487:     Modifies grid in-place by painting yellow(4) at input positions.\n 488:     Returns True on success.\n 489:     \"\"\"\n 490:     for reg in regions:\n 491:         blob = reg['interior']\n 492:         dr, dc = reg['dir']\n 493:         n_yellows = rng.choice(YELLOWS_PER_REGION)\n 494: \n 495:         # Cells sorted by projection onto slide direction (farthest first).\n 496:         cells_sorted = sorted(blob, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n 497:         far_key = dr * cells_sorted[0][0] + dc * cells_sorted[0][1]\n 498:         tier1 = [p for p in cells_sorted if dr * p[0] + dc * p[1] == far_key]\n 499: \n 500:         # Pick output positions: first at the farthest tier, second one step behind or at tier1.\n 501:         first = tier1[rng.randrange(len(tier1))]\n 502:         output_positions = [first]\n 503: \n 504:         if n_yellows == 2:\n 505:             pr, pc = first[0] - dr, first[1] - dc\n 506:             cands = ([(pr, pc)] if (pr, pc) in blob else []) + [p for p in tier1 if p != first]\n 507:             if cands:\n 508:                 second = cands[rng.randrange(len(cands))]\n 509:                 if second != first:\n 510:                     output_positions.append(second)\n 511: \n 512:         # Reverse-slide: process in solver order (far-to-near).\n 513:         out_sorted = sorted(output_positions, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n 514:         already_stopped = set()\n 515:         yellows_input = []\n 516: \n 517:         for out_pos in out_sorted:\n 518:             candidate = _find_reverse_slide(blob, out_pos, dr, dc, already_stopped,\n 519:                                             yellows_input, rng)\n 520:             if candidate is None:\n 521:                 return False\n 522:             yellows_input.append(candidate)\n 523:             already_stopped.add(out_pos)\n 524: \n 525:         for r, c in yellows_input:\n 526:             grid[r, c] = 4\n 527:     return True\n 528: \n 529: \n 530: def _find_reverse_slide(blob: set, out_pos: tuple[int,int], dr: int, dc: int,\n 531:                         already_stopped: set, existing_inputs: list,\n 532:                         rng: random.Random) -> tuple[int,int] | None:\n 533:     \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n 534:     target_steps = rng.randint(1, MAX_SLIDE_STEPS)\n 535:     for steps in range(target_steps, 0, -1):\n 536:         r, c = out_pos\n 537:         path_ok = True\n 538:         for _ in range(steps):\n 539:             pr, pc = r - dr, c - dc\n 540:             if (pr, pc) not in blob or (pr, pc) in already_stopped or (pr, pc) in existing_inputs:\n 541:                 path_ok = False\n 542:                 break\n 543:             if dr != 0 and dc != 0:\n 544:                 if (pr + dr, pc) not in blob or (pr, pc + dc) not in blob:\n 545:                     path_ok = False\n 546:                     break\n 547:             r, c = pr, pc\n 548:         if not path_ok:\n 549:             continue\n 550:         if _forward_slide(blob, (r, c), dr, dc, already_stopped) == out_pos:\n 551:             return (r, c)\n 552:     return None\n 553: \n 554: \n 555: def _oracle_check(input_grid: np.ndarray, regions: list[dict]) -> bool:\n 556:     \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n 557:     h, w = input_grid.shape\n 558:     try:\n 559:         solver_out = main(input_grid)\n 560:     except Exception:\n 561:         return False\n 562:     # Non-yellow, non-bg cells must be identical.\n 563:     struct_mask = (input_grid != 4) & (input_grid != 0)\n 564:     if not np.array_equal(solver_out[struct_mask], input_grid[struct_mask]):\n 565:         return False\n 566:     # Yellow count must be preserved.\n 567:     if (solver_out == 4).sum() != (input_grid == 4).sum():\n 568:         return False\n 569:     # All output yellows must lie inside known region interiors.\n 570:     regions_mask = np.zeros((h, w), dtype=bool)\n 571:     for reg in regions:\n 572:         for r, c in reg['interior']:\n 573:             regions_mask[r, c] = True\n 574:     return bool(np.all(regions_mask[solver_out == 4]))\n 575: \n 576: \n 577: # ── Main generator ────────────────────────────────────────────────\n 578: \n 579: def _gen_attempt(rng: random.Random) -> np.ndarray | None:\n 580:     h, w = GRID_H, GRID_W\n 581:     grid = np.zeros((h, w), dtype=int)\n 582: \n 583:     legend_occupied, legends = _place_legends(rng, grid)\n 584:     regions = _grow_regions(rng, legends, legend_occupied)\n 585:     if regions is None:\n 586:         return None\n 587: \n 588:     # Paint walls.\n 589:     for reg in regions:\n 590:         for r, c in reg['walls']:\n 591:             grid[r, c] = reg['color']\n 592: \n 593:     if not _validate_topology(grid, regions):\n 594:         return None\n 595: \n 596:     input_grid = grid.copy()\n 597:     if not _place_yellows(rng, regions, input_grid):\n 598:         return None\n 599:     if not _oracle_check(input_grid, regions):\n 600:         return None\n 601:     return input_grid\n 602: \n 603: \n--- lines 604-613 ---\n 604: def generate_input() -> np.ndarray:\n 605:     rng = random.Random()\n 606:     for _ in range(GEN_RETRIES):\n 607:         try:\n 608:             g = _gen_attempt(rng)\n 609:         except Exception:\n 610:             continue\n 611:         if g is not None:\n 612:             return g\n 613:     raise RuntimeError(\"generate_input: exceeded retries\")\n===== 6cbe9eb8 =====\n--- lines 78-437 ---\n  78: def main(grid: np.ndarray) -> np.ndarray:\n  79:     \"\"\"\n  80:     Rebuild the foreground rectangles as a largest-to-smallest lower-left nesting.\n  81: \n  82:     Input structure\n  83:     - A periodic wallpaper background is overlaid by foreground colors that each form a rectangular frame or solid rectangle.\n  84:     - The largest foreground rectangle is the output frame; smaller foreground rectangles are the objects to nest inside it.\n  85:     - A frame may be partially hidden by a smaller rectangle, but its visible pixels still determine its bbox.\n  86: \n  87:     Rule\n  88:     - Ignore the wallpaper and crop the result to the largest foreground rectangle's bbox size.\n  89:     - Sort foreground rectangles by bbox area from largest to smallest.\n  90:     - Reconstruct each frame or solid rectangle, placing every next smaller rectangle in the lower-left of the current rectangle's usable region.\n  91: \n  92:     Key insight\n  93:     - The scattered background colors are not objects; the meaningful order is the unique descending rectangle size chain, and each step nests into the previous rectangle's lower-left interior.\n  94:     \"\"\"\n  95:     g = np.asarray(grid, dtype=int)\n  96:     assert g.ndim == 2, \"expected a 2D grid\"\n  97: \n  98:     items = _foreground_rectangles(g)\n  99:     outer = items[0]\n 100:     out = np.zeros((int(outer[\"height\"]), int(outer[\"width\"])), dtype=int)\n 101: \n 102:     region = _paint_item(out, outer, 0, 0)\n 103:     for item in items[1:]:\n 104:         rr, cc, rh, rw = region\n 105:         h = int(item[\"height\"])\n 106:         w = int(item[\"width\"])\n 107:         assert h <= rh and w <= rw, \"nested rectangle must fit in parent usable region\"\n 108:         r = rr + rh - h\n 109:         c = cc\n 110:         region = _paint_item(out, item, r, c)\n 111: \n 112:     return out\n 113: \n 114: # --------------- generator (att2) ---------------\n 115: \n 116: _RNG = np.random.default_rng()\n 117: \n 118: # Colors and sentinels.\n 119: COLOR_VALUES, FOREGROUND_COLORS = tuple(range(10)), tuple(range(1, 10))\n 120: TRANSPARENT = -1\n 121: # Rectangle chain counts.\n 122: ITEM_COUNT_RANGE, THREE_ITEM_FRAME_OPTIONS = (3, 4), (1, 2)\n 123: FOUR_ITEM_FRAME_COUNT = 2\n 124: # Solid rectangle dimensions.\n 125: INNER_SOLID_HEIGHT_RANGE, INNER_SOLID_WIDTH_RANGE = (2, 3), (2, 3)\n 126: SECOND_SOLID_MAX_HEIGHT, SECOND_SOLID_MAX_WIDTH = 9, 9\n 127: # Frame growth and bounds.\n 128: FRAME_MIN_GROWTH, INNER_FRAME_MAX_GROWTH = 2, 5\n 129: INNER_FRAME_MAX_HEIGHT, INNER_FRAME_MAX_WIDTH = 13, 11\n 130: OUTER_FRAME_MIN_HEIGHT, OUTER_FRAME_MIN_WIDTH = 8, 8\n 131: OUTER_FRAME_MAX_HEIGHT, OUTER_FRAME_MAX_WIDTH = 15, 13\n 132: # Wallpaper canvas bounds and margin around the outer rectangle.\n 133: CANVAS_HEIGHT_RANGE, CANVAS_WIDTH_RANGE = (13, 19), (22, 27)\n 134: CANVAS_BORDER_MARGIN = 1\n 135: # Wallpaper tile/color sampling.\n 136: WALLPAPER_COLOR_COUNT_RANGE = (2, 4)\n 137: ZERO_WALLPAPER_ROLL_RANGE = (0, 4)\n 138: ZERO_WALLPAPER_THRESHOLD = 3\n 139: TILE_SIZE_2 = 2\n 140: TILE_SIZE_OPTIONS, TILE3_SIGN_OPTIONS = (2, 3), (1, 2)\n 141: # Visibility/oracle retry limits.\n 142: VISIBLE_OUTER_MIN_COMPONENT, MAX_VISIBLE_OUTER_COMPONENTS = 3, 4\n 143: GENERATION_RETRY_LIMIT = 300\n 144: \n 145: \n 146: def _randint(lo: int, hi: int) -> int:\n 147:     return int(_RNG.integers(int(lo), int(hi) + 1))\n 148: \n 149: \n 150: def _choice(seq):\n 151:     return seq[_randint(0, len(seq) - 1)]\n 152: \n 153: \n 154: def _sample(seq, k: int) -> list[int]:\n 155:     idx = _RNG.choice(len(seq), size=int(k), replace=False)\n 156:     return [int(seq[int(i)]) for i in idx]\n 157: \n 158: \n 159: def _shuffled(seq) -> list[int]:\n 160:     vals = list(seq)\n 161:     _RNG.shuffle(vals)\n 162:     return [int(v) for v in vals]\n 163: \n 164: \n 165: def _choose_dims(\n 166:     h_min: int,\n 167:     h_max: int,\n 168:     w_min: int,\n 169:     w_max: int,\n 170:     used_areas: set[int],\n 171:     *,\n 172:     min_area: int = 0,\n 173: ) -> tuple[int, int] | None:\n 174:     pairs = [\n 175:         (h, w)\n 176:         for h in range(int(h_min), int(h_max) + 1)\n 177:         for w in range(int(w_min), int(w_max) + 1)\n 178:         if h * w > int(min_area) and h * w not in used_areas\n 179:     ]\n 180:     return _choice(pairs) if pairs else None\n 181: \n 182: \n 183: def _build_items() -> list[dict]:\n 184:     \"\"\"Build a largest-to-smallest rectangle chain with unique bbox areas.\"\"\"\n 185:     n_items = _randint(*ITEM_COUNT_RANGE)\n 186:     if n_items == ITEM_COUNT_RANGE[1]:\n 187:         n_frames = FOUR_ITEM_FRAME_COUNT\n 188:     else:\n 189:         n_frames = _choice(THREE_ITEM_FRAME_OPTIONS)\n 190:     n_solids = n_items - n_frames\n 191: \n 192:     colors = _sample(FOREGROUND_COLORS, n_items)\n 193:     chain = []\n 194:     used_areas: set[int] = set()\n 195: \n 196:     h = _randint(*INNER_SOLID_HEIGHT_RANGE)\n 197:     w = _randint(*INNER_SOLID_WIDTH_RANGE)\n 198:     chain.append({\"kind\": \"solid\", \"height\": h, \"width\": w})\n 199:     used_areas.add(h * w)\n 200: \n 201:     if n_solids == 2:\n 202:         dims = _choose_dims(h, SECOND_SOLID_MAX_HEIGHT, w, SECOND_SOLID_MAX_WIDTH, used_areas, min_area=h * w)\n 203:         if dims is None:\n 204:             return []\n 205:         h, w = dims\n 206:         chain.append({\"kind\": \"solid\", \"height\": h, \"width\": w})\n 207:         used_areas.add(h * w)\n 208: \n 209:     if n_frames == 2:\n 210:         dims = _choose_dims(\n 211:             h + FRAME_MIN_GROWTH,\n 212:             min(INNER_FRAME_MAX_HEIGHT, h + INNER_FRAME_MAX_GROWTH),\n 213:             w + FRAME_MIN_GROWTH,\n 214:             min(INNER_FRAME_MAX_WIDTH, w + INNER_FRAME_MAX_GROWTH),\n 215:             used_areas,\n 216:         )\n 217:         if dims is None:\n 218:             return []\n 219:         h, w = dims\n 220:         chain.append({\"kind\": \"frame\", \"height\": h, \"width\": w})\n 221:         used_areas.add(h * w)\n 222: \n 223:     dims = _choose_dims(\n 224:         max(OUTER_FRAME_MIN_HEIGHT, h + FRAME_MIN_GROWTH),\n 225:         OUTER_FRAME_MAX_HEIGHT,\n 226:         max(OUTER_FRAME_MIN_WIDTH, w + FRAME_MIN_GROWTH),\n 227:         OUTER_FRAME_MAX_WIDTH,\n 228:         used_areas,\n 229:     )\n 230:     if dims is None:\n 231:         return []\n 232:     h, w = dims\n 233:     chain.append({\"kind\": \"frame\", \"height\": h, \"width\": w})\n 234: \n 235:     items = list(reversed(chain))\n 236:     for item, color in zip(items, colors):\n 237:         item[\"color\"] = int(color)\n 238:         item[\"area\"] = int(item[\"height\"] * item[\"width\"])\n 239:     return items\n 240: \n 241: \n 242: def _item_size(item: dict) -> tuple[int, int]:\n 243:     return int(item[\"height\"]), int(item[\"width\"])\n 244: \n 245: \n 246: def _paint_item_view(view: np.ndarray, item: dict) -> None:\n 247:     color = int(item[\"color\"])\n 248:     if item[\"kind\"] == \"solid\":\n 249:         view[:, :] = color\n 250:     else:\n 251:         view[0, :] = color\n 252:         view[-1, :] = color\n 253:         view[:, 0] = color\n 254:         view[:, -1] = color\n 255: \n 256: \n 257: def _gen_paint_item(out: np.ndarray, item: dict, r: int, c: int) -> tuple[int, int, int, int]:\n 258:     h, w = _item_size(item)\n 259:     _paint_item_view(out[r : r + h, c : c + w], item)\n 260:     if item[\"kind\"] == \"solid\":\n 261:         return r, c, h, w\n 262: \n 263:     return r + 1, c + 1, h - 2, w - 2\n 264: \n 265: \n 266: def _render_output(items: list[dict]) -> np.ndarray:\n 267:     outer = items[0]\n 268:     out = np.zeros((int(outer[\"height\"]), int(outer[\"width\"])), dtype=int)\n 269:     region = _gen_paint_item(out, outer, 0, 0)\n 270:     for item in items[1:]:\n 271:         rr, cc, rh, rw = region\n 272:         h = int(item[\"height\"])\n 273:         w = int(item[\"width\"])\n 274:         region = _gen_paint_item(out, item, rr + rh - h, cc)\n 275:     return out\n 276: \n 277: \n 278: def _rect_patch(item: dict) -> np.ndarray:\n 279:     h, w = _item_size(item)\n 280:     patch = np.full((h, w), TRANSPARENT, dtype=int)\n 281:     _paint_item_view(patch, item)\n 282:     return patch\n 283: \n 284: \n 285: def _tile2(colors: list[int]) -> np.ndarray:\n 286:     colors = _shuffled(colors)\n 287:     if len(colors) == 2:\n 288:         a, b = colors\n 289:         return np.array([[a, b], [b, a]], dtype=int)\n 290:     if len(colors) == 3:\n 291:         a, b, c = colors\n 292:         if _randint(0, 1):\n 293:             return np.array([[a, b], [c, a]], dtype=int)\n 294:         return np.array([[b, a], [a, c]], dtype=int)\n 295:     return np.array(colors, dtype=int).reshape(2, 2)\n 296: \n 297: \n 298: def _tile3(colors: list[int]) -> np.ndarray:\n 299:     colors = _shuffled(colors)\n 300:     sign = _choice(TILE3_SIGN_OPTIONS)\n 301:     tile = np.array(\n 302:         [[colors[(r + sign * c) % 3] for c in range(3)] for r in range(3)],\n 303:         dtype=int,\n 304:     )\n 305:     if len(colors) == 4:\n 306:         tile[_randint(0, TILE_SIZE_2), _randint(0, TILE_SIZE_2)] = colors[3]\n 307:     return tile\n 308: \n 309: \n 310: def _wallpaper(rows: int, cols: int, fg_colors: set[int]) -> np.ndarray:\n 311:     available = [c for c in COLOR_VALUES if c not in fg_colors]\n 312:     k = _randint(*WALLPAPER_COLOR_COUNT_RANGE)\n 313:     if 0 in available and _randint(*ZERO_WALLPAPER_ROLL_RANGE) < ZERO_WALLPAPER_THRESHOLD:\n 314:         colors = [0] + _sample([c for c in available if c != 0], k - 1)\n 315:     else:\n 316:         colors = _sample(available, k)\n 317: \n 318:     tile_size = TILE_SIZE_2 if k == WALLPAPER_COLOR_COUNT_RANGE[0] else _choice(TILE_SIZE_OPTIONS)\n 319:     tile = _tile2(colors) if tile_size == TILE_SIZE_2 else _tile3(colors)\n 320:     reps = (rows // tile.shape[0] + 1, cols // tile.shape[1] + 1)\n 321:     return np.tile(tile, reps)[:rows, :cols].copy()\n 322: \n 323: \n 324: def _placed_mask(mask: np.ndarray, rows: int, cols: int, r: int, c: int) -> np.ndarray:\n 325:     out = np.zeros((rows, cols), dtype=bool)\n 326:     h, w = mask.shape\n 327:     out[r : r + h, c : c + w] = mask\n 328:     return out\n 329: \n 330: \n 331: def _outer_survives(outer_mask: np.ndarray, item_mask: np.ndarray, r: int, c: int, box: tuple[int, int, int, int]) -> bool:\n 332:     visible = outer_mask.copy()\n 333:     h, w = item_mask.shape\n 334:     visible[r : r + h, c : c + w] &= ~item_mask\n 335:     r0, c0, rh, rw = box\n 336:     if not visible[r0, c0 : c0 + rw].any():\n 337:         return False\n 338:     if not visible[r0 + rh - 1, c0 : c0 + rw].any():\n 339:         return False\n 340:     if not visible[r0 : r0 + rh, c0].any():\n 341:         return False\n 342:     if not visible[r0 : r0 + rh, c0 + rw - 1].any():\n 343:         return False\n 344:     sizes = [int(comp.shape[0]) for comp in components_mask(visible, connectivity=4)]\n 345:     return bool(sizes) and max(sizes) > VISIBLE_OUTER_MIN_COMPONENT and len(sizes) <= MAX_VISIBLE_OUTER_COMPONENTS\n 346: \n 347: \n 348: def _overlap_positions(mask: np.ndarray, outer_mask: np.ndarray, box: tuple[int, int, int, int]) -> list[tuple[int, int]]:\n 349:     rows, cols = outer_mask.shape\n 350:     h, w = mask.shape\n 351:     positions = []\n 352:     for r in range(rows - h + 1):\n 353:         for c in range(cols - w + 1):\n 354:             if not np.any(outer_mask[r : r + h, c : c + w] & mask):\n 355:                 continue\n 356:             if _outer_survives(outer_mask, mask, r, c, box):\n 357:                 positions.append((r, c))\n 358:     return positions\n 359: \n 360: \n 361: def _free_positions(mask: np.ndarray, occupied: np.ndarray) -> list[tuple[int, int]]:\n 362:     rows, cols = occupied.shape\n 363:     h, w = mask.shape\n 364:     positions = []\n 365:     for r in range(rows - h + 1):\n 366:         for c in range(cols - w + 1):\n 367:             if not np.any(occupied[r : r + h, c : c + w] & mask):\n 368:                 positions.append((r, c))\n 369:     return positions\n 370: \n 371: \n 372: def _build_canvas(items: list[dict]) -> np.ndarray:\n 373:     \"\"\"Create a wallpaper canvas large enough to leave a border around the outer frame.\"\"\"\n 374:     outer_h, outer_w = _item_size(items[0])\n 375:     rows = _randint(max(CANVAS_HEIGHT_RANGE[0], outer_h + 2 * CANVAS_BORDER_MARGIN), CANVAS_HEIGHT_RANGE[1])\n 376:     cols = _randint(max(CANVAS_WIDTH_RANGE[0], outer_w + 2 * CANVAS_BORDER_MARGIN), CANVAS_WIDTH_RANGE[1])\n 377:     fg_colors = {int(item[\"color\"]) for item in items}\n 378:     return _wallpaper(rows, cols, fg_colors)\n 379: \n 380: \n 381: def _choose_placements(items: list[dict], masks: list[np.ndarray], rows: int, cols: int) -> list[tuple[int, int, int]] | None:\n 382:     \"\"\"Scatter rectangles, forcing one valid overlap with the outer frame and keeping the rest disjoint.\"\"\"\n 383:     outer_h, outer_w = _item_size(items[0])\n 384:     outer_r = _randint(CANVAS_BORDER_MARGIN, rows - outer_h - CANVAS_BORDER_MARGIN)\n 385:     outer_c = _randint(CANVAS_BORDER_MARGIN, cols - outer_w - CANVAS_BORDER_MARGIN)\n 386:     outer_mask = _placed_mask(masks[0], rows, cols, outer_r, outer_c)\n 387:     occupied = outer_mask.copy()\n 388:     placements = [(0, outer_r, outer_c)]\n 389: \n 390:     overlap_i = _choice(list(range(1, len(items))))\n 391:     choices = _overlap_positions(masks[overlap_i], outer_mask, (outer_r, outer_c, outer_h, outer_w))\n 392:     if not choices:\n 393:         return None\n 394:     r, c = _choice(choices)\n 395:     placements.append((overlap_i, r, c))\n 396:     occupied |= _placed_mask(masks[overlap_i], rows, cols, r, c)\n 397: \n 398:     remaining = [i for i in range(1, len(items)) if i != overlap_i]\n 399:     remaining.sort(key=lambda i: int(items[i][\"area\"]), reverse=True)\n 400:     for i in remaining:\n 401:         choices = _free_positions(masks[i], occupied)\n 402:         if not choices:\n 403:             return None\n 404:         r, c = _choice(choices)\n 405:         placements.append((i, r, c))\n 406:         occupied |= _placed_mask(masks[i], rows, cols, r, c)\n 407: \n 408:     return placements\n 409: \n 410: \n 411: def _passes_oracle(grid: np.ndarray, expected: np.ndarray) -> bool:\n 412:     try:\n 413:         actual = main(grid)\n 414:     except Exception:\n 415:         return False\n 416:     return bool(np.array_equal(actual, expected))\n 417: \n 418: \n 419: def _gen_attempt() -> np.ndarray | None:\n 420:     items = _build_items()\n 421:     if not items:\n 422:         return None\n 423: \n 424:     expected = _render_output(items)\n 425:     grid = _build_canvas(items)\n 426:     patches = [_rect_patch(item) for item in items]\n 427:     masks = [patch != TRANSPARENT for patch in patches]\n 428:     placements = _choose_placements(items, masks, *grid.shape)\n 429:     if placements is None:\n 430:         return None\n 431:     for i, r, c in placements:\n 432:         paste(grid, patches[i], r, c, transparent=TRANSPARENT)\n 433:     if not _passes_oracle(grid, expected):\n 434:         return None\n 435:     return grid\n 436: \n 437: \n--- lines 438-443 ---\n 438: def generate_input() -> np.ndarray:\n 439:     for _ in range(GENERATION_RETRY_LIMIT):\n 440:         grid = _gen_attempt()\n 441:         if grid is not None:\n 442:             return grid\n 443:     raise RuntimeError(\"failed to generate a valid input\")\n","exit_code":0,"status":"completed"}}
