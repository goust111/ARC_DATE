{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/58c02a16.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox, get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Expand the top-left seed mask into a recursive colored pattern and tile it across the full grid.\n\n    Input structure\n    - The background is the dominant color.\n    - All foreground lies in a top-left rectangle whose last row and last column are a solid secondary color.\n    - Removing that secondary-color row and column leaves a seed region containing background plus one primary color.\n\n    Rule\n    - Use the primary-color pixels in the seed as a binary mask.\n    - Replace each primary seed cell with a copy of the seed mask in the primary color, and each background seed cell\n      with a copy of the seed mask in the secondary color.\n    - Repeat and crop that expanded tile to the original grid shape.\n\n    Key insight\n    The solid L-shaped secondary-color border is a legend, not output content; it supplies the color used when the\n    seed's background cells are expanded.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    fg_bbox = bbox(g != bg)\n    assert fg_bbox is not None, \"expected a top-left foreground legend\"\n    r0, c0, r1, c1 = fg_bbox\n    assert r0 == 0 and c0 == 0, \"foreground legend must be anchored at the top-left corner\"\n\n    legend_box = g[: r1 + 1, : c1 + 1]\n    seed_h = legend_box.shape[0] - 1\n    seed_w = legend_box.shape[1] - 1\n    assert seed_h >= 1 and seed_w >= 1, \"legend must contain a non-empty seed plus border\"\n\n    secondary_border = np.concatenate((legend_box[:seed_h, seed_w], legend_box[seed_h, :]))\n    secondary_colors = np.unique(secondary_border)\n    assert secondary_colors.size == 1, \"expected one solid secondary-color border\"\n    secondary = int(secondary_colors[0])\n    assert secondary != bg, \"secondary border must be foreground\"\n\n    seed = legend_box[:seed_h, :seed_w]\n    primary_colors = np.unique(seed[seed != bg])\n    assert primary_colors.size == 1, \"seed must contain exactly one primary foreground color\"\n    primary = int(primary_colors[0])\n    assert primary != secondary, \"primary and secondary colors must be distinct\"\n    assert np.all((seed == bg) | (seed == primary)), \"seed may contain only background and primary colors\"\n    assert np.any(seed == bg), \"seed must include background cells that expand to the secondary color\"\n\n    seed_mask = seed == primary\n    H, W = g.shape\n    rows = np.arange(H)[:, None]\n    cols = np.arange(W)[None, :]\n\n    inner_mask = seed_mask[rows % seed_h, cols % seed_w]\n    meta_mask = seed_mask[(rows // seed_h) % seed_h, (cols // seed_w) % seed_w]\n\n    out = np.full(g.shape, bg, dtype=int)\n    out[inner_mask & meta_mask] = primary\n    out[inner_mask & ~meta_mask] = secondary\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color palette.\nBACKGROUND_COLOR, PALETTE_COLORS = 7, tuple(range(10))\n# Seed geometry.\nSEED_SIZES = (2, 3)\nSEED_DENSITY_MIN, SEED_DENSITY_MAX = 0.33, 0.67\n# Canvas layout.\nTILE_MULTIPLIERS, GRID_MIN, GRID_MAX = range(3, 6), 7, 16\nREMAINDERS_BY_SQUARENESS = {False: (0,), True: (0, 1)}\n# Retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _expected_output(seed_mask: np.ndarray, shape: tuple[int, int], bg: int, primary: int, secondary: int) -> np.ndarray:\n    \"\"\"Render the two-level fractal that main() should produce.\"\"\"\n    seed_h, seed_w = seed_mask.shape\n    H, W = shape\n    rows = np.arange(H)[:, None]\n    cols = np.arange(W)[None, :]\n\n    inner = seed_mask[rows % seed_h, cols % seed_w]\n    meta = seed_mask[(rows // seed_h) % seed_h, (cols // seed_w) % seed_w]\n\n    out = np.full((H, W), bg, dtype=int)\n    out[inner & meta] = primary\n    out[inner & ~meta] = secondary\n    return out\n\ndef _layout_options(seed_h: int, seed_w: int) -> list[tuple[int, int]]:\n    \"\"\"Return valid canvas shapes for a sampled seed size.\"\"\"\n    options = []\n    for k in TILE_MULTIPLIERS:\n        for rem in REMAINDERS_BY_SQUARENESS[seed_h == seed_w]:\n            H = seed_h * k + rem\n            W = seed_w * k + rem\n            if GRID_MIN <= H <= GRID_MAX and GRID_MIN <= W <= GRID_MAX and H >= seed_h * seed_h and W >= seed_w * seed_w:\n                options.append((H, W))\n    return options\n\ndef _random_seed_mask(seed_h: int, seed_w: int) -> np.ndarray:\n    \"\"\"Sample a nonempty, nonfull primary mask within density bounds.\"\"\"\n    area = seed_h * seed_w\n    lo = max(1, int(np.ceil(area * SEED_DENSITY_MIN)))\n    hi = min(area - 1, int(np.floor(area * SEED_DENSITY_MAX)))\n    n_primary = random.randint(lo, hi)\n    chosen = random.sample(range(area), n_primary)\n    mask = np.zeros((seed_h, seed_w), dtype=bool)\n    mask.reshape(-1)[chosen] = True\n    return mask\n\ndef _render_input(seed_mask: np.ndarray, shape: tuple[int, int], bg: int, primary: int, secondary: int) -> np.ndarray:\n    \"\"\"Render the top-left seed legend on a background canvas.\"\"\"\n    seed_h, seed_w = seed_mask.shape\n    inp = np.full(shape, bg, dtype=int)\n    inp[:seed_h, :seed_w][seed_mask] = primary\n    inp[seed_h, : seed_w + 1] = secondary\n    inp[:seed_h, seed_w] = secondary\n    return inp\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Build one oracle-checked input grid, or None if validation fails.\"\"\"\n    bg = BACKGROUND_COLOR\n    primary, secondary = random.sample([c for c in PALETTE_COLORS if c != bg], 2)\n\n    seed_h = random.choice(SEED_SIZES)\n    seed_w = random.choice(SEED_SIZES)\n    H, W = random.choice(_layout_options(seed_h, seed_w))\n\n    seed_mask = _random_seed_mask(seed_h, seed_w)\n    inp = _render_input(seed_mask, (H, W), bg, primary, secondary)\n    expected = _expected_output(seed_mask, (H, W), bg, primary, secondary)\n    try:\n        actual = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return inp\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 58c02a16 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import get_bg\nimport random\n\n\ndef _solid_separator_cross(g: np.ndarray, bg: int) -> tuple[int, int]:\n    height, width = g.shape\n    solid_rows = [r for r in range(height) if np.all(g[r, :] == bg)]\n    solid_cols = [c for c in range(width) if np.all(g[:, c] == bg)]\n    assert len(solid_rows) == 1, \"expected exactly one solid background separator row\"\n    assert len(solid_cols) == 1, \"expected exactly one solid background separator column\"\n    return solid_rows[0], solid_cols[0]\n\n\ndef _quadrants(cross_row: int, cross_col: int, height: int, width: int) -> list[tuple[slice, slice]]:\n    top_h = cross_row\n    bottom_h = height - cross_row - 1\n    left_w = cross_col\n    right_w = width - cross_col - 1\n    assert top_h > 0 and left_w > 0, \"separator must leave nonempty corner regions\"\n    assert top_h == bottom_h, \"separator row must split equal-height regions\"\n    assert left_w == right_w, \"separator column must split equal-width regions\"\n\n    return [\n        (slice(0, cross_row), slice(0, cross_col)),\n        (slice(0, cross_row), slice(cross_col + 1, width)),\n        (slice(cross_row + 1, height), slice(0, cross_col)),\n        (slice(cross_row + 1, height), slice(cross_col + 1, width)),\n    ]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the one blank in each corner region so all four regions have the same color multiset.\n\n    Input structure:\n    - The dominant background color forms one solid separator row and one solid\n      separator column.\n    - The separator cross splits the grid into four equal rectangular corner regions.\n    - Each corner region contains exactly one background-colored blank pixel.\n\n    Rule:\n    - Count the non-background colors in each corner region.\n    - The completed region multiset is defined by the maximum observed count of\n      each color across the four regions.\n    - Replace each region's blank pixel with the single color needed to match that\n      completed multiset.\n\n    Key insight:\n    - The separator color inside a corner region is a missing value marker; comparing\n      the four regions reveals the shared multiset without using numeric color order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    color_counts = Counter(map(int, g.reshape(-1)))\n    assert all(\n        color == bg or count < color_counts[bg] for color, count in color_counts.items()\n    ), \"background color must be uniquely dominant\"\n\n    cross_row, cross_col = _solid_separator_cross(g, bg)\n    regions = _quadrants(cross_row, cross_col, height, width)\n    region_shape = g[regions[0]].shape\n    region_area = int(np.prod(region_shape))\n\n    counts_by_region: list[Counter[int]] = []\n    blank_positions: list[tuple[int, int]] = []\n    for row_slice, col_slice in regions:\n        region = g[row_slice, col_slice]\n        assert region.shape == region_shape, \"all corner regions must have the same shape\"\n        blanks = np.argwhere(region == bg)\n        assert len(blanks) == 1, \"each corner region must have exactly one blank\"\n\n        counts_by_region.append(Counter(map(int, region[region != bg].reshape(-1))))\n        local_r, local_c = map(int, blanks[0])\n        blank_positions.append((row_slice.start + local_r, col_slice.start + local_c))\n\n    target_counts: Counter[int] = Counter()\n    for counts in counts_by_region:\n        for color, count in counts.items():\n            target_counts[color] = max(target_counts[color], count)\n    assert sum(target_counts.values()) == region_area, \"completed region multiset must be unique\"\n\n    out = g.copy()\n    for counts, (row, col) in zip(counts_by_region, blank_positions):\n        missing = target_counts - counts\n        assert len(missing) == 1, \"each blank must have exactly one matching fill color\"\n        fill_color, fill_count = next(iter(missing.items()))\n        assert fill_count == 1, \"each corner region must need one pixel of the fill color\"\n        out[row, col] = fill_color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n# Canvas/palette bounds.\nGRID_HALF_MIN = 2\nGRID_HALF_MAX = 6\nCOLOR_COUNT = 10\nMIN_TARGET_COLORS = 3\nMAX_NON_BG_COLORS = COLOR_COUNT - 1\n# Layout probabilities and constraints.\nPREFERRED_GRID_HALF = (2, 2)\nPREFERRED_GRID_PROB = 0.65\nQUADRANT_COUNT = 4\nSEPARATOR_WIDTH = 1\nBG_DOMINANCE_MARGIN = 1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _gen_bounded_composition(total: int, parts: int, max_each: int) -> list[int] | None:\n    if parts <= 0 or total < parts or total > parts * max_each:\n        return None\n\n    counts = []\n    remaining = total\n    for i in range(parts):\n        slots_left = parts - i - 1\n        lo = max(1, remaining - slots_left * max_each)\n        hi = min(max_each, remaining - slots_left)\n        counts.append(random.randint(lo, hi))\n        remaining -= counts[-1]\n\n    random.shuffle(counts)\n    return counts\n\n\ndef _gen_grid_options() -> list[tuple[int, int, list[int], int]]:\n    options = []\n    for k in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n        for m in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n            area = k * m\n            bg_count = 2 * k + 2 * m + SEPARATOR_WIDTH + QUADRANT_COUNT\n            max_target_count = (bg_count - BG_DOMINANCE_MARGIN) // QUADRANT_COUNT\n            max_colors = min(MAX_NON_BG_COLORS, area)\n            valid_counts = [\n                c\n                for c in range(MIN_TARGET_COLORS, max_colors + 1)\n                if area <= c * max_target_count\n            ]\n            if valid_counts:\n                options.append((k, m, valid_counts, max_target_count))\n    return options\n\n\ndef _gen_pick_grid_option() -> tuple[int, int, list[int], int]:\n    options = _gen_grid_options()\n    if random.random() < PREFERRED_GRID_PROB:\n        preferred_k, preferred_m = PREFERRED_GRID_HALF\n        for option in options:\n            if option[0] == preferred_k and option[1] == preferred_m:\n                return option\n    return random.choice(options)\n\n\ndef _gen_quadrant_offsets(k: int, m: int) -> list[tuple[int, int]]:\n    sep = SEPARATOR_WIDTH\n    return [(0, 0), (0, m + sep), (k + sep, 0), (k + sep, m + sep)]\n\n\ndef _gen_missing_colors(non_bg_colors: list[int]) -> list[int]:\n    missing_colors = [random.choice(non_bg_colors) for _ in range(QUADRANT_COUNT)]\n    if len(set(missing_colors)) == 1:\n        alternatives = [c for c in non_bg_colors if c != missing_colors[0]]\n        missing_colors[-1] = random.choice(alternatives)\n    return missing_colors\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = random.randrange(COLOR_COUNT)\n    k, m, valid_color_counts, max_target_count = _gen_pick_grid_option()\n    area = k * m\n\n    color_count = random.choice(valid_color_counts)\n    non_bg_colors = random.sample([c for c in range(COLOR_COUNT) if c != bg], color_count)\n    target_counts = _gen_bounded_composition(area, color_count, max_target_count)\n    if target_counts is None:\n        return None\n\n    target_values = []\n    for color, count in zip(non_bg_colors, target_counts):\n        target_values.extend([color] * count)\n\n    missing_colors = _gen_missing_colors(non_bg_colors)\n    out = np.full((2 * k + SEPARATOR_WIDTH, 2 * m + SEPARATOR_WIDTH), bg, dtype=int)\n    inp = out.copy()\n\n    for (r0, c0), missing_color in zip(_gen_quadrant_offsets(k, m), missing_colors):\n        values = target_values[:]\n        random.shuffle(values)\n        quadrant_out = np.array(values, dtype=int).reshape(k, m)\n\n        candidates = np.argwhere(quadrant_out == missing_color)\n        blank_r, blank_c = map(int, candidates[random.randrange(len(candidates))])\n        quadrant_in = quadrant_out.copy()\n        quadrant_in[blank_r, blank_c] = bg\n\n        out[r0 : r0 + k, c0 : c0 + m] = quadrant_out\n        inp[r0 : r0 + k, c0 : c0 + m] = quadrant_in\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid e3fe1151 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/412b6263.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, find_components, paste\n\n\ndef _infer_background_and_objects(g: np.ndarray) -> tuple[int, list[dict]]:\n    colors, counts = np.unique(g, return_counts=True)\n    min_count = int(counts.min())\n    marker_colors = [int(c) for c, n in zip(colors, counts) if int(n) == min_count]\n    assert len(marker_colors) == 1\n    marker = marker_colors[0]\n    assert int(np.sum(g == marker)) == 2\n\n    candidates: list[tuple[int, list[dict]]] = []\n    for bg in map(int, colors):\n        if bg == marker:\n            continue\n        objects = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n        if len(objects) != 2:\n            continue\n        ok = True\n        for obj in objects:\n            coords = obj[\"coords\"]\n            vals = g[coords[:, 0], coords[:, 1]]\n            if int(np.sum(vals == marker)) != 1:\n                ok = False\n            if len(set(map(int, vals)) - {marker}) != 1:\n                ok = False\n        if ok:\n            candidates.append((bg, objects))\n\n    assert len(candidates) == 1\n    return candidates[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Infer the background, rotate the whole input 90 degrees counterclockwise, and stack two framed copies vertically.\n\n    Input structure:\n    - Blue is absent from the input.\n    - One rare marker color appears in exactly two pixels.\n    - The background is the unique non-marker color whose removal leaves exactly two 4-connected foreground objects, each with one marker pixel and one body color.\n    - The whole grid, including background and foreground objects, is the sprite to transform.\n\n    Rule:\n    - Rotate the entire input grid 90 degrees counterclockwise.\n    - Create a blue one-pixel frame around two vertical copies of the rotated grid.\n    - Use the input background color for the two endpoints of every horizontal frame/separator row.\n\n    Key insight: The output is not a crop of the foreground objects; it is two copies of the complete rotated input, separated and enclosed by a newly added blue border.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg, objects = _infer_background_and_objects(g)\n    assert bg != Color.BLUE\n    assert Color.BLUE not in set(map(int, g.ravel()))\n\n    copies = len(objects)\n\n    tile = np.rot90(g, 1)\n    tile_h, tile_w = map(int, tile.shape)\n\n    out_h = copies * tile_h + copies + 1\n    out_w = tile_w + 2\n    out = np.full((out_h, out_w), Color.BLUE, dtype=int)\n\n    for i in range(copies):\n        row = i * (tile_h + 1)\n        out[row, 0] = bg\n        out[row, -1] = bg\n        paste(out, tile, row + 1, 1)\n\n    out[-1, 0] = bg\n    out[-1, -1] = bg\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n# CFG: ranges use numpy's high-exclusive convention where applicable.\nCANVAS_SHAPE_RANGES = ((5, 10), (5, 11))\nOBJECT_SHAPE_RANGES = ((2, 5), (2, 5))\nMIN_SEPARATION_GAP = 1\nMAX_OUTPUT_SIZE = 30\nINPUT_COLORS = [0, 2, 3, 4, 5, 6, 7, 8, 9]\nPALETTE_SIZE = 3\nFRAME_COLOR = Color.BLUE\nOUTPUT_TILE_COPIES = 2\nFRAME_THICKNESS = 1\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _edge_cells(h: int, w: int) -> list[tuple[int, int]]:\n    return [\n        (r, c)\n        for r in range(h)\n        for c in range(w)\n        if r in (0, h - 1) or c in (0, w - 1)\n    ]\n\ndef _expected_output(inp: np.ndarray, bg: int) -> np.ndarray:\n    tile = np.rot90(inp, 1)\n    tile_h, tile_w = tile.shape\n    out_h = OUTPUT_TILE_COPIES * tile_h + (OUTPUT_TILE_COPIES + 1) * FRAME_THICKNESS\n    out_w = tile_w + 2 * FRAME_THICKNESS\n    out = np.full((out_h, out_w), FRAME_COLOR, dtype=int)\n    out[0, 0] = out[0, -1] = bg\n    out[tile_h + FRAME_THICKNESS, 0] = out[tile_h + FRAME_THICKNESS, -1] = bg\n    out[-1, 0] = out[-1, -1] = bg\n    out[FRAME_THICKNESS : FRAME_THICKNESS + tile_h, FRAME_THICKNESS : FRAME_THICKNESS + tile_w] = tile\n    second_top = tile_h + 2 * FRAME_THICKNESS\n    out[second_top : second_top + tile_h, FRAME_THICKNESS : FRAME_THICKNESS + tile_w] = tile\n    return out\n\ndef _sample_object_dims(canvas_h: int, canvas_w: int) -> tuple[int, int] | None:\n    feasible_dims = [\n        (oh, ow)\n        for oh in range(*OBJECT_SHAPE_RANGES[0])\n        for ow in range(*OBJECT_SHAPE_RANGES[1])\n        if oh <= canvas_h and ow <= canvas_w and (\n            canvas_h - 2 * oh >= MIN_SEPARATION_GAP\n            or canvas_w - 2 * ow >= MIN_SEPARATION_GAP\n        )\n    ]\n    if not feasible_dims:\n        return None\n    return feasible_dims[int(np.random.randint(len(feasible_dims)))]\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = int(np.random.randint(*CANVAS_SHAPE_RANGES[0]))\n    W = int(np.random.randint(*CANVAS_SHAPE_RANGES[1]))\n\n    dims = _sample_object_dims(H, W)\n    if dims is None:\n        return None\n    oh, ow = dims\n\n    bg, body, marker = map(int, np.random.choice(INPUT_COLORS, size=PALETTE_SIZE, replace=False))\n    inp = np.full((H, W), bg, dtype=int)\n    inp[:oh, :ow] = body\n    inp[H - oh : H, W - ow : W] = body\n    mr, mc = _edge_cells(oh, ow)[int(np.random.randint(2 * oh + 2 * ow - 4))]\n    inp[mr, mc] = marker\n    inp[H - oh + mr, W - ow + mc] = marker\n\n    expected = _expected_output(inp, bg)\n    if expected.shape[0] > MAX_OUTPUT_SIZE or expected.shape[1] > MAX_OUTPUT_SIZE:\n        return None\n\n    try:\n        actual = main(inp)\n    except AssertionError:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
