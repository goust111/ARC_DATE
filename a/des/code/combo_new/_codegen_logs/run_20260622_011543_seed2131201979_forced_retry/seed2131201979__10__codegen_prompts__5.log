{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nimport numpy as np\nfrom collections import deque\n\n\ndef neighbors4(r,c):\n    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n        yield r+dr,c+dc\n\ndef boundary(solid):\n    h,w=solid.shape\n    out=np.zeros_like(solid)\n    for r in range(h):\n        for c in range(w):\n            if not solid[r,c]:\n                continue\n            for rr,cc in neighbors4(r,c):\n                if not (0<=rr<h and 0<=cc<w and solid[rr,cc]):\n                    out[r,c]=1\n                    break\n    return out\n\ndef comps(mask):\n    h,w=mask.shape\n    seen=np.zeros_like(mask,dtype=bool)\n    res=[]\n    for r in range(h):\n      for c in range(w):\n        if mask[r,c] and not seen[r,c]:\n          q=[(r,c)]; seen[r,c]=1; pts=[]\n          for rr,cc in q:\n            pts.append((rr,cc))\n            for nr,nc in neighbors4(rr,cc):\n              if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:\n                seen[nr,nc]=1; q.append((nr,nc))\n          res.append(pts)\n    return res\n\ndef degrees(mask):\n    h,w=mask.shape\n    ds=[]\n    for r,c in zip(*np.nonzero(mask)):\n        d=0\n        for rr,cc in neighbors4(r,c):\n            if 0<=rr<h and 0<=cc<w and mask[rr,cc]: d+=1\n        ds.append(d)\n    return ds\n\ndef classify(mask, center=None):\n    h,w=mask.shape\n    if center is None:\n      center=(h//2,w//2)\n    pts={(r-center[0], c-center[1]) for r,c in zip(*np.nonzero(mask))}\n    def rot90(p):\n      r,c=p\n      return (-c,r)\n    def rot180(p):\n      r,c=p\n      return (-r,-c)\n    if {rot90(p) for p in pts}==pts:\n      return 4\n    if {rot180(p) for p in pts}==pts:\n      return 2\n    return 1\n\ndef make_solid(h,w):\n    cy,cx=h//2,w//2\n    solid=np.zeros((h,w),dtype=bool)\n    # random contiguous rows around center\n    for r in range(h):\n      if random.random()<0.2 and r not in {cy-1,cy,cy+1}: continue\n      left=random.randint(0,cx)\n      right=random.randint(cx,w-1)\n      if r in {cy-1,cy,cy+1}:\n        left=min(left,cx-1)\n        right=max(right,cx+1)\n      solid[r,left:right+1]=1\n    # ensure connected to center via fill gap heuristics\n    solid[cy,cx]=1\n    return solid\n\nok={1:0,2:0,4:0}\nfor _ in range(20000):\n    h=random.choice([5,7,9])\n    w=random.choice([5,7,9])\n    solid=make_solid(h,w)\n    ring=boundary(solid)\n    if len(comps(ring))\"'!=1: continue\n    ds=degrees(ring)\n    if not ds or any(d!=2 for d in ds): continue\n    if ring[h//2,w//2]: continue\n    if not solid[h//2,w//2]: continue\n    # center should be interior under 4-neigh\n    for rr,cc in neighbors4(h//2,w//2):\n      if not (0<=rr<h and 0<=cc<w and solid[rr,cc]):\n        break\n    else:\n      k=classify(ring)\n      ok[k]+=1\nprint(ok)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nimport numpy as np\nfrom collections import deque\n\n\ndef neighbors4(r,c):\n    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n        yield r+dr,c+dc\n\ndef boundary(solid):\n    h,w=solid.shape\n    out=np.zeros_like(solid)\n    for r in range(h):\n        for c in range(w):\n            if not solid[r,c]:\n                continue\n            for rr,cc in neighbors4(r,c):\n                if not (0<=rr<h and 0<=cc<w and solid[rr,cc]):\n                    out[r,c]=1\n                    break\n    return out\n\ndef comps(mask):\n    h,w=mask.shape\n    seen=np.zeros_like(mask,dtype=bool)\n    res=[]\n    for r in range(h):\n      for c in range(w):\n        if mask[r,c] and not seen[r,c]:\n          q=[(r,c)]; seen[r,c]=1; pts=[]\n          for rr,cc in q:\n            pts.append((rr,cc))\n            for nr,nc in neighbors4(rr,cc):\n              if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:\n                seen[nr,nc]=1; q.append((nr,nc))\n          res.append(pts)\n    return res\n\ndef degrees(mask):\n    h,w=mask.shape\n    ds=[]\n    for r,c in zip(*np.nonzero(mask)):\n        d=0\n        for rr,cc in neighbors4(r,c):\n            if 0<=rr<h and 0<=cc<w and mask[rr,cc]: d+=1\n        ds.append(d)\n    return ds\n\ndef classify(mask, center=None):\n    h,w=mask.shape\n    if center is None:\n      center=(h//2,w//2)\n    pts={(r-center[0], c-center[1]) for r,c in zip(*np.nonzero(mask))}\n    def rot90(p):\n      r,c=p\n      return (-c,r)\n    def rot180(p):\n      r,c=p\n      return (-r,-c)\n    if {rot90(p) for p in pts}==pts:\n      return 4\n    if {rot180(p) for p in pts}==pts:\n      return 2\n    return 1\n\ndef make_solid(h,w):\n    cy,cx=h//2,w//2\n    solid=np.zeros((h,w),dtype=bool)\n    # random contiguous rows around center\n    for r in range(h):\n      if random.random()<0.2 and r not in {cy-1,cy,cy+1}: continue\n      left=random.randint(0,cx)\n      right=random.randint(cx,w-1)\n      if r in {cy-1,cy,cy+1}:\n        left=min(left,cx-1)\n        right=max(right,cx+1)\n      solid[r,left:right+1]=1\n    # ensure connected to center via fill gap heuristics\n    solid[cy,cx]=1\n    return solid\n\nok={1:0,2:0,4:0}\nfor _ in range(20000):\n    h=random.choice([5,7,9])\n    w=random.choice([5,7,9])\n    solid=make_solid(h,w)\n    ring=boundary(solid)\n    if len(comps(ring))\"'!=1: continue\n    ds=degrees(ring)\n    if not ds or any(d!=2 for d in ds): continue\n    if ring[h//2,w//2]: continue\n    if not solid[h//2,w//2]: continue\n    # center should be interior under 4-neigh\n    for rr,cc in neighbors4(h//2,w//2):\n      if not (0<=rr<h and 0<=cc<w and solid[rr,cc]):\n        break\n    else:\n      k=classify(ring)\n      ok[k]+=1\nprint(ok)\nPY'","aggregated_output":"{1: 11, 2: 1, 4: 10}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np\n\ndef neighbors4(r,c):\n    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n        yield r+dr,c+dc\n\ndef boundary(solid):\n    h,w=solid.shape\n    out=np.zeros_like(solid)\n    for r in range(h):\n        for c in range(w):\n            if solid[r,c] and any(not (0<=rr<h and 0<=cc<w and solid[rr,cc]) for rr,cc in neighbors4(r,c)):\n                out[r,c]=1\n    return out\n\ndef comps(mask):\n    h,w=mask.shape\n    seen=np.zeros_like(mask,dtype=bool)\n    count=0\n    for r in range(h):\n      for c in range(w):\n        if mask[r,c] and not seen[r,c]:\n          count+=1\n          q=[(r,c)]; seen[r,c]=1\n          for rr,cc in q:\n            for nr,nc in neighbors4(rr,cc):\n              if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:\n                seen[nr,nc]=1; q.append((nr,nc))\n    return count\n\ndef classify(mask):\n    h,w=mask.shape\n    cr,cc=h//2,w//2\n    pts={(r-cr,c-cc) for r,c in zip(*np.nonzero(mask))}\n    rot90={(-c,r) for r,c in pts}\n    rot180={(-r,-c) for r,c in pts}\n    if rot90==pts: return 4\n    if rot180==pts: return 2\n    return 1\n\ndef valid(ring):\n    h,w=ring.shape\n    cr,cc=h//2,w//2\n    if ring[cr,cc]: return False\n    ds=[]\n    for r,c in zip(*np.nonzero(ring)):\n      d=sum(0<=rr<h and 0<=cc2<w and ring[rr,cc2] for rr,cc2 in neighbors4(r,c))\n      ds.append(d)\n    return ds and all(d==2 for d in ds) and comps(ring)==1\n\ndef gen(k):\n  for _ in range(10000):\n    h=random.choice([5,7,9,11])\n    w=random.choice([5,7,9,11])\n    cr,cc=h//2,w//2\n    rows=[None]*h\n    if k==2:\n      for r in range(cr+1):\n        L=random.randint(0,cc-1)\n        R=random.randint(cc+1,w-1)\n        rows[r]=(L,R)\n        rows[h-1-r]=(w-1-R,w-1-L)\n    elif k==1:\n      for r in range(h):\n        L=random.randint(0,cc-1)\n        R=random.randint(cc+1,w-1)\n        rows[r]=(L,R)\n    else:\n      if h\"'!=w: continue\n      # choose upper half, mirror both axes, test\n      for r in range(h):\n        L=random.randint(0,cc-1)\n        R=random.randint(cc+1,w-1)\n        rows[r]=(L,R)\n      # enforce x and y reflections to increase chance\n      tmp=rows[:]\n      for r in range(h):\n        L,R=tmp[r]\n        L2,R2=tmp[h-1-r]\n        # average by intersection of mirrored intervals around center? simplistic\n        a=min(L,w-1-R2)\n        b=max(R,w-1-L2)\n        rows[r]=(a,b)\n        rows[h-1-r]=(w-1-b,w-1-a)\n    solid=np.zeros((h,w),dtype=bool)\n    for r,(L,R) in enumerate(rows):\n      solid[r,L:R+1]=1\n    # ensure center interior\n    if not all(solid[rr,cc2] for rr,cc2 in [(cr,cc),(cr-1,cc),(cr+1,cc),(cr,cc-1),(cr,cc+1)]):\n      continue\n    ring=boundary(solid)\n    if not valid(ring): continue\n    if classify(ring)!=k: continue\n    return ring.astype(int)\n  return None\n\nfor k in [1,2,4]:\n  cnt=0\n  for _ in range(30):\n    if gen(k) is not None:\n      cnt+=1\n  print(k,cnt)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
