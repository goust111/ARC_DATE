{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\n\ndef neighbors4(r,c):\n    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n        yield r+dr,c+dc\n\ndef from_widths(widths):\n    h=len(widths); w=max(widths)\n    arr=np.zeros((h,w),dtype=int)\n    for r,wid in enumerate(widths):\n        L=(w-wid)//2\n        arr[r,L:L+wid]=1\n    return arr\n\ndef boundary(solid):\n    h,w=solid.shape\n    out=np.zeros_like(solid)\n    for r in range(h):\n      for c in range(w):\n        if solid[r,c] and any(not (0<=rr<h and 0<=cc<w and solid[rr,cc]) for rr,cc in neighbors4(r,c)):\n          out[r,c]=1\n    return out\n\ndef valid(ring):\n    h,w=ring.shape\n    for r,c in zip(*np.nonzero(ring)):\n      d=sum(0<=rr<h and 0<=cc2<w and ring[rr,cc2] for rr,cc2 in neighbors4(r,c))\n      if d\"'!=2: return False\n    return True\n\ndef show(a):\n    for row in a: print('\"''.join('#' if x else '.' for x in row)); print()\nfor widths in ([5,7,7,7,5],[5,7,9,7,5],[3,5,7,5,3],[5,5,7,5,5],[5,7,7,5,5]):\n    solid=from_widths(widths)\n    ring=boundary(solid)\n    print(widths, valid(ring), solid.shape)\n    for row in ring: print(''.join('#' if x else '.' for x in row))\n    print('---')\nPY\"","aggregated_output":"[5, 7, 7, 7, 5] False (5, 7)\n.#####.\n#.....#\n#.....#\n#.....#\n.#####.\n---\n[5, 7, 9, 7, 5] False (5, 9)\n..#####..\n.#.....#.\n#.......#\n.#.....#.\n..#####..\n---\n[3, 5, 7, 5, 3] False (5, 7)\n..###..\n.#...#.\n#.....#\n.#...#.\n..###..\n---\n[5, 5, 7, 5, 5] False (5, 7)\n.#####.\n.#...#.\n#.....#\n.#...#.\n.#####.\n---\n[5, 7, 7, 5, 5] False (5, 7)\n.#####.\n#.....#\n#.....#\n.#...#.\n.#####.\n---\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np\n\ndef neighbors(r,c,conn):\n    dirs=((1,0),(-1,0),(0,1),(0,-1))\n    if conn==8: dirs=dirs+((1,1),(1,-1),(-1,1),(-1,-1))\n    for dr,dc in dirs:\n        yield r+dr,c+dc\n\ndef boundary(solid):\n    h,w=solid.shape\n    out=np.zeros_like(solid)\n    for r in range(h):\n        for c in range(w):\n            if solid[r,c] and any(not (0<=rr<h and 0<=cc<w and solid[rr,cc]) for rr,cc in neighbors(r,c,4)):\n                out[r,c]=1\n    return out\n\ndef compcount(mask,conn=8):\n    h,w=mask.shape\n    seen=np.zeros_like(mask,dtype=bool)\n    count=0\n    for r in range(h):\n        for c in range(w):\n            if mask[r,c] and not seen[r,c]:\n                count+=1\n                q=[(r,c)]; seen[r,c]=1\n                for rr,cc in q:\n                    for nr,nc in neighbors(rr,cc,conn):\n                        if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:\n                            seen[nr,nc]=1; q.append((nr,nc))\n    return count\n\ndef classify(mask):\n    h,w=mask.shape; cr,cc=h//2,w//2\n    pts={(r-cr,c-cc) for r,c in zip(*np.nonzero(mask))}\n    if {(-c,r) for r,c in pts}==pts: return 4\n    if {(-r,-c) for r,c in pts}==pts: return 2\n    return 1\n\ndef gen(k):\n  for _ in range(5000):\n    h=random.choice([5,7,9])\n    w=random.choice([5,7,9])\n    cr,cc=h//2,w//2\n    rows=[None]*h\n    if k==2:\n      for r in range(cr+1):\n        L=random.randint(0,max(0,cc-1))\n        R=random.randint(min(w-1,cc+1),w-1)\n        rows[r]=(L,R)\n        rows[h-1-r]=(w-1-R,w-1-L)\n    elif k==1:\n      for r in range(h):\n        L=random.randint(0,max(0,cc-1))\n        R=random.randint(min(w-1,cc+1),w-1)\n        rows[r]=(L,R)\n    else:\n      if h\"'!=w: continue\n      # symmetric row widths for initial candidate\n      half=[]\n      for d in range(cr+1):\n        wid=random.choice(range(3,w+1,2))\n        half.append(wid)\n      widths=half[:cr+1]+half[cr-1::-1]\n      rows=[((w-wid)//2, (w+wid)//2-1) for wid in widths]\n    solid=np.zeros((h,w),dtype=bool)\n    for r,(L,R) in enumerate(rows): solid[r,L:R+1]=1\n    # center and cross interior\n    if not all(0<=rr<h and 0<=cc2<w and solid[rr,cc2] for rr,cc2 in [(cr,cc),(cr-1,cc),(cr+1,cc),(cr,cc-1),(cr,cc+1)]):\n      continue\n    ring=boundary(solid)\n    if compcount(ring,8)!=1: continue\n    if ring[cr,cc]: continue\n    if classify(ring)!=k: continue\n    return ring\n  return None\n\nfor k in [1,2,4]:\n  cnt=0\n  for _ in range(50):\n    if gen(k) is not None:\n      cnt+=1\n  print(k,cnt)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
