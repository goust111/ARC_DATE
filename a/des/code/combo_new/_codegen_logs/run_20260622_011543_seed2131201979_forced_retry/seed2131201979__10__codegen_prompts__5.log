{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np\n\ndef neighbors(r,c,conn=4):\n    dirs=((1,0),(-1,0),(0,1),(0,-1))\n    if conn==8: dirs=dirs+((1,1),(1,-1),(-1,1),(-1,-1))\n    for dr,dc in dirs: yield r+dr,c+dc\n\ndef boundary(solid):\n    h,w=solid.shape\n    out=np.zeros_like(solid)\n    for r in range(h):\n        for c in range(w):\n            if solid[r,c] and any(not (0<=rr<h and 0<=cc<w and solid[rr,cc]) for rr,cc in neighbors(r,c,4)):\n                out[r,c]=1\n    return out\n\ndef compcount(mask,conn=8):\n    h,w=mask.shape; seen=np.zeros_like(mask,dtype=bool); count=0\n    for r in range(h):\n      for c in range(w):\n        if mask[r,c] and not seen[r,c]:\n          count+=1; q=[(r,c)]; seen[r,c]=1\n          for rr,cc in q:\n            for nr,nc in neighbors(rr,cc,conn):\n              if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]: seen[nr,nc]=1; q.append((nr,nc))\n    return count\n\ndef classify(mask):\n    h,w=mask.shape; cr,cc=h//2,w//2\n    pts={(r-cr,c-cc) for r,c in zip(*np.nonzero(mask))}\n    if {(-c,r) for r,c in pts}==pts: return 4\n    if {(-r,-c) for r,c in pts}==pts: return 2\n    return 1\n\ndef gen_rows(h,w,k):\n    cr,cc=h//2,w//2\n    rows=[None]*h\n    def step_pair(prev):\n      L,R=prev\n      L=random.randint(max(0,L-1), min(cc-1,L+1))\n      R=random.randint(max(cc+1,R-1), min(w-1,R+1))\n      if L>=cc or R<=cc: return None\n      return (L,R)\n    center=(random.randint(0,cc-1), random.randint(cc+1,w-1))\n    rows[cr]=center\n    # ensure cross interior maybe later\n    prev=center\n    for r in range(cr+1,h):\n      nxt=step_pair(prev)\n      if nxt is None: return None\n      rows[r]=nxt; prev=nxt\n    prev=center\n    for r in range(cr-1,-1,-1):\n      nxt=step_pair(prev)\n      if nxt is None: return None\n      rows[r]=nxt; prev=nxt\n    if k==2:\n      rows2=[None]*h\n      for r in range(cr+1):\n        L,R=rows[r]\n        rows2[r]=(L,R)\n        rows2[h-1-r]=(w-1-R,w-1-L)\n      rows=rows2\n    solid=np.zeros((h,w),dtype=bool)\n    for r,(L,R) in enumerate(rows): solid[r,L:R+1]=1\n    return solid\nfor k in [1,2]:\n  ok=0\n  for _ in range(200):\n    h=random.choice([5,7,9])\n    w=random.choice([5,7,9])\n    solid=gen_rows(h,w,k)\n    if solid is None: continue\n    cr,cc=h//2,w//2\n    if not all(solid[rr,cc2] for rr,cc2 in [(cr,cc),(cr-1,cc),(cr+1,cc),(cr,cc-1),(cr,cc+1)]):\n      continue\n    ring=boundary(solid)\n    if compcount(ring,8)\"'!=1 or classify(ring)!=k or ring[cr,cc]:\n      continue\n    ok+=1\n  print(k,ok)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
