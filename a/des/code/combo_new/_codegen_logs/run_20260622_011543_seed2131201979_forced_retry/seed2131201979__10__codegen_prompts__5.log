{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\n\ndef neighbors4(r,c):\n    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n        yield r+dr,c+dc\n\ndef from_widths(widths, lefts=None):\n    h=len(widths); w=max(widths if lefts is None else [l+wid for l,wid in zip(lefts,widths)])\n    if lefts is None:\n        lefts=[(w-wid)//2 for wid in widths]\n    arr=np.zeros((h,w),dtype=int)\n    for r,(L,W) in enumerate(zip(lefts,widths)):\n        arr[r,L:L+W]=1\n    return arr\n\ndef boundary(solid):\n    h,w=solid.shape\n    out=np.zeros_like(solid)\n    for r in range(h):\n        for c in range(w):\n            if solid[r,c] and any(not (0<=rr<h and 0<=cc<w and solid[rr,cc]) for rr,cc in neighbors4(r,c)):\n                out[r,c]=1\n    return out\n\ndef show(arr):\n    for row in arr:\n        print(''.join('#' if x else '.' for x in row))\n\ndef classify(mask):\n    h,w=mask.shape; cr,cc=h//2,w//2\n    pts={(r-cr,c-cc) for r,c in zip(*np.nonzero(mask))}\n    if {(-c,r) for r,c in pts}==pts: return 4\n    if {(-r,-c) for r,c in pts}==pts: return 2\n    return 1\n\ndef valid(ring):\n    h,w=ring.shape\n    ds=[]\n    for r,c in zip(*np.nonzero(ring)):\n        d=sum(0<=rr<h and 0<=cc2<w and ring[rr,cc2] for rr,cc2 in neighbors4(r,c))\n        ds.append(d)\n    return ds and all(d==2 for d in ds)\n\ncases=[\n    ('square5',[5,5,5,5,5],None),\n    ('octa5',[3,5,5,5,3],None),\n    ('octa7',[3,5,7,7,7,5,3],None),\n    ('asym1',[3,5,5,7,5],None),\n    ('asym2',[3,5,7,5,3],None),\n    ('rect57',[5]*7,None),\n]\nfor name,widths,lefts in cases:\n    solid=from_widths(widths,lefts)\n    ring=boundary(solid)\n    print(name, solid.shape, classify(ring), valid(ring), ring[solid.shape[0]//2, solid.shape[1]//2])\n    show(ring)\n    print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
