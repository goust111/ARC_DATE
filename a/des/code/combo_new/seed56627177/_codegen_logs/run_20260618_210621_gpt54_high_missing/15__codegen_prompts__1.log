r <= sr1 and sc0 <= c <= sc1:\n  76:             dst_cols_set.add(c)\n  77:     dst_cols = sorted(dst_cols_set)\n  78: \n  79:     # Compute a robust horizontal shift aligning projection columns to colored columns.\n  80:     dx = None\n  81:     if src_proj_cols and len(src_proj_cols) == len(dst_cols):\n  82:         deltas = [d - s for s, d in zip(src_proj_cols, dst_cols)]\n  83:         if len(set(deltas)) == 1:\n  84:             dx = deltas[0]\n  85:     if dx is None:\n  86:         # Brute pick dx that maximizes overlap of shifted projection cols with dst cols.\n  87:         best = (-1, 0)\n  88:         dst_set = set(dst_cols)\n  89:         for cand_dx in range(-w, w + 1):\n  90:             score = sum((c + cand_dx) in dst_set for c in src_proj_cols)\n  91:             if score > best[0]:\n  92:                 best = (score, cand_dx)\n  93:         dx = best[1]\n  94: \n  95:     # Paste bar into the slot (overwrite with grey).\n  96:     placed = []\n  97:     for r, c in bar_pts:\n  98:         rr = r + dy\n  99:         cc = c + dx\n 100:         if sr0 <= rr <= sr1 and sc0 <= cc <= sc1:\n 101:             out[rr, cc] = grey\n 102:             placed.append((rr, cc))\n 103: \n 104:     # Move colored pixels: for each affected column, stack them immediately above the top of the bar in that column.\n 105:     # Use colors from the original grid (inside slot bbox), ordered top->bottom.\n 106:     placed_by_col = {}\n 107:     for rr, cc in placed:\n 108:         placed_by_col.setdefault(cc, []).append(rr)\n 109: \n 110:     interior_top = sr0 + 1\n 111:     interior_bottom = sr1 - 1\n 112: \n 113:     for col in dst_cols:\n 114:         if col not in placed_by_col:\n 115:             continue\n 116:         bar_top = min(placed_by_col[col])\n 117:         desired_bottom = bar_top - 1\n 118:         if desired_bottom < interior_top:\n 119:             continue\n 120: \n 121:         # Extract original colored pixels in this column (ignore bg/grey).\n 122: