x3 bbox overlaps the rectangle; copied pixels overwrite the rectangle there.\n  94: \n  95:     Key insight\n  96:     The center pixel is not the paint color: it is a destination key, while the entire 3x3 sprite is the motif tiled along the straight path.\n  97:     \"\"\"\n  98:     g = np.asarray(grid, dtype=int)\n  99:     assert g.ndim == 2\n 100:     h, w = g.shape\n 101:     assert h >= 3 and w >= 3\n 102: \n 103:     bg = int(get_bg(g))\n 104:     sprites = _find_sprites(g, bg)\n 105:     assert sprites, \"expected at least one 3x3 control-center sprite\"\n 106: \n 107:     out = g.copy()\n 108:     for sprite_bbox, patch, center in sprites:\n 109:         targets = _solid_rectangles(g, bg, center)\n 110:         assert len(targets) == 1, \"each control color must have one solid rectangular target\"\n 111:         target_bbox = targets[0][\"bbox\"]\n 112:         assert not _intersects(sprite_bbox, target_bbox), \"sprite and target must start separate\"\n 113: \n 114:         dr, dc = _direction_to_target(sprite_bbox, target_bbox)\n 115:         r, c = sprite_bbox[0], sprite_bbox[1]\n 116: \n 117:         while True:\n 118:             current_bbox = (r, c, r + 2, c + 2)\n 119:             assert 0 <= r and r + 3 <= h and 0 <= c and c + 3 <= w\n 120:             paste(out, patch, r, c)\n 121: \n 122:             if _intersects(current_bbox, target_bbox):\n 123:                 break\n 124: \n 125:             r += dr * 3\n 126:             c += dc * 3\n 127: \n 128:     return out\n 129: \n 130: # --------------- generator (att1) ---------------\n 131: # Canvas and colors.\n 132: BG_COLOR, COLOR_COUNT = 8, 10\n 133: GRID_MIN_SIZE, GRID_MAX_SIZE = 20, 25\n 134: \n 135: # Rectangles.\n 136: RECT_COUNT_MIN, RECT_COUNT_MAX = 2, 4\n 137: RECT_SIDE_MIN, RECT_SIDE_MAX = 2, 14\n 138: RECT_MARGIN, RECT_SPACING_PAD = 1, 5\n 139: RECT_PLACEMENT_ATTEMPTS = 50\n 140: \n 141: # Sprites and paths.\n 142: SPRITE_SIZE, SPRITE_TOTAL_MAX = 3, 5\n 143: SPRITE_GAPS = [1, 4, 7, 10]\n 144: DIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n 145: \n 146: # Retry limits.\n 147: GENERATION_ATTEMPTS = 300\n 148: \n 149: \n\n 362: def generate_input() -> np.ndarray:\n 363:     for _ in range(GENERATION_ATTEMPTS):\n 364:         result = _gen_attempt()\n 365:         if result is not None:\n 366:             return result\n 367:     raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/278e5215.py\n  50: def main(grid: np.ndarray) -> np.ndarray:\n  51:     \"\"\"\n  52:     Recolor the large mask crop column-by-column using the separate three-row palette strip.\n  53: \n  54:     Input structure:\n  55:     - The background is the most common color.\n  56:     - One large monochrome foreground object is the mask; its bbox is the output region and may contain background holes.\n  57:     - The remaining foreground is a 3-row palette rectangle with the same width as the mask bbox: two identical color rows and one uniform row.\n  58: \n  59:     Rule:\n  60:     - Crop to the mask object's bbox.\n  61:     - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n  62:     - Replace background holes inside the crop with the palette's uniform third-row color.\n  63: \n  64:     Key insight:\n  65:     The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n  66:     \"\"\"\n  67:     g = np.asarray(grid, dtype=int)\n  68:     bg = get_bg(g)\n  69:     mask_color = _unique_largest_non_bg_color(g, bg)\n  70: \n  71:     b = _mask_bbox(g, mask_color)\n  72:     mask_crop = crop_bbox(g == int(mask_color), b)\n  73:     height, width = map(int, mask_crop.shape)\n  74: \n  75:     column_colors, hole_color = _palette(g, bg, mask_color, width)\n  76:     out = np.tile(column_colors, (height, 1))\n  77:     out[~mask_crop] = hole_color\n  78:     return out\n  79: \n  80: # --------------- generator (o5x) ---------------\n  81: \n  82: # Canvas, colors, and object bounds.\n  83: BACKGROUND_COLOR, MASK_COLOR = 0, 5\n  84: COLOR_MIN, COLOR_MAX = 1, 9\n  85: GRID_SIDE_MIN, GRID_SIDE_MAX = 10, 18\n  86: MASK_SIDE_MIN, MASK_SIDE_MAX = 5, 10\n  87: PALETTE_HEIGHT = 3\n  88: GAP_MIN, GAP_MAX = 1, 3\n  89: \n  90: # Palette run construction.\n  91: RUN_COUNT_OPTIONS = (4, 5)\n  92: RUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3\n  93: COLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5\n  94: UNUSED_COLOR_BIAS = 0.7\n  95: \n  96: # Mask density and retry budget.\n  97: MASK_DENSITY_MIN, MASK_DENSITY_MAX = 0.60, 0.71\n  98: GENERATION_ATTEMPTS = 300\n  99: \n 100: \n\n 275: def generate_input() -> np.ndarray:\n 276:     for _ in range(GENERATION_ATTEMPTS):\n 277:         grid = _gen_attempt()\n 278:         if grid is not None:\n 279:             return grid\n 280:     raise RuntimeError(\"failed to generate valid input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/e3721c99.py\n  68: def main(grid: np.ndarray) -> np.ndarray:\n  69:     \"\"\"\n  70:     Recolor grey shapes by matching their hole count to a color legend.\n  71: \n  72:     Input structure:\n  73:     - bg = most common color; grey (5) sprites scattered across the grid.\n  74:     - Colored legend shapes (non-bg, non-grey, at least 2×2, not touching the outer border) near grid edge,\n  75:       each with a distinct number of enclosed holes.\n  76: \n  77:     Rule:\n  78:     - Each colored legend shape defines a mapping: hole count → color.\n  79:     - For every grey sprite, count its holes (enclosed bg regions not touching the sprite's bounding-box border).\n  80:     - Recolor the grey sprite to the matching legend color; erase grey distractors with unlisted hole counts.\n  81: \n  82:     Key insight: Shape identity is encoded by topology (number of holes), not geometry or size.\n  83:     \"\"\"\n  84:     g = np.asarray(grid, dtype=int)\n  85:     bg = get_bg(g)\n  86:     grey = 5\n  87: \n  88:     legend = _legend_mapping(g, bg, grey)\n  89:     assert legend, \"legend mapping must be non-empty: grid must contain colored legend shapes\"\n  90: \n  91:     out = g.copy()\n  92:     for pts in components_mask(g == grey, connectivity=4):\n  93:         r0, c0, r1, c1 = bbox_coords(pts)\n  94:         sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n  95:         for r, c in pts:\n  96:             sub[r - r0, c - c0] = True\n  97:         hc = _hole_count(sub)\n  98:         newc = int(legend[hc]) if hc in legend else bg\n  99:         for r, c in pts:\n 100:             out[r, c] = newc\n 101: \n 102:     return out\n 103: \n 104: # --------------- generator (holes-first organic blob) ---------------\n 105: \n 106: from arc_utils import label_mask\n 107: from scipy.ndimage import binary_dilation, generate_binary_structure\n 108: \n 109: # -- palette & grid --\n 110: BG = 0\n 111: DIV = 1\n 112: GREY = 5\n 113: GRID_SIZE = 30\n 114: LEGEND_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\n 115: \n 116: # -- legend panel --\n 117: LEGEND_COUNT_RANGE = (2, 4)         # number of legend entries\n 118: MAX_HOLE_COUNT = 6                  # hole values drawn from range(MAX_HOLE_COUNT)\n 119: PANEL_SIZE_RANGE = (5, 8)           # panel thickness (cross-axis)\n 120: FULL_LAYOUT_MAX_SPAN = 28          # max legend line span for full-row/col layouts\n 121: L_LAYOUT_MAX_SPAN = 24            # max legend line span for L-shaped layouts\n 122: L_LAYOUT_EXTRA_PADDING = 3        # max random padding along the L arm\n 123: \n 124: # -- sprites --\n 125: TOTAL_SPRITES_RANGE = (8, 11)       # total sprites (matches + distractors)\n 126: MAX_DISTRACTORS = 7                 # max distractor sprites\n 127: MAX_EXTRA_PER_LEGEND = 2            # max extra match sprites per legend entry\n 128: SPRITE_RETRIES = 30                 # retries per sprite generation attempt\n 129: SPRITE_AREA_0 = (5, 25)              # (min, max) area for 0-hole sprites\n 130: SPRITE_AREA_LOW_MIN = 8              # min area for 1-2 hole sprites (max = 25+10*h)\n 131: # 3+ hole sprites: min = 10+2*h, max = 20+4*h\n 132: CANVAS_SCALE = 1.2                  # sqrt(area) multiplier for canvas size\n 133: CANVAS_MIN = 5                      # minimum canvas dimension\n 134: CANVAS_PAD = 2                      # padding added to scaled sqrt for canvas\n 135: HOLE_SEED_RADIUS_FACTOR = 0.45      # radius = factor * sqrt(area)\n 136: HOLE_SEED_MIN_RADIUS = 2\n 137: HOLE_SEED_MIN_SEP = 2               # minimum Chebyshev distance between hole seeds\n 138: HOLE_SEED_MARGIN = 2                # margin from canvas edge for hole seeds\n 139: SEAL_ITERS = 5                      # max iterations for sealing forbidden cells\n 140: SPRITE_MAX_H = 12                   # max sprite bbox height\n 141: SPRITE_MAX_W = 18                   # max sprite bbox width\n 142: SPRITE_MAX_ASPECT = 2.5             # max aspect ratio (max_dim / min_dim)\n 143: \n 144: # -- generation --\n 145: GEN_RETRIES = 300                   # outer retries for generate_input()\n 146: \n 147: # 8-connectivity structuring element for dilation\n 148: _STRUCT8 = generate_binary_structure(2, 2)\n 149: \n 150: \n 151: # ---------- legend helpers ----------\n 152: \n\n 600: def generate_input() -> np.ndarray:\n 601:     for _ in range(GEN_RETRIES):\n 602:         try:\n 603:             grid = _gen_attempt()\n 604:         except Exception:\n 605:             grid = None\n 606:         if grid is not None:\n 607:             return grid\n 608:     raise RuntimeError(\"failed to generate e3721c99 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/99caaf76.py\n  55: def main(grid: np.ndarray) -> np.ndarray:\n  56:     \"\"\"\n  57:     Move each marked cross object away from its marker to the grid edge while rotating the colored cross 180 degrees.\n  58: \n  59:     Input structure:\n  60:     - The background is the dominant color.\n  61:     - Each 8-connected foreground object has nine pixels: a 4-pixel marker-color\n  62:       sprite attached to a 5-pixel non-marker colored cross.\n  63:     - Each object bbox is either 3x6 or 6x3, so the marker sprite is on exactly\n  64:       one side of the cross.\n  65: \n  66:     Rule:\n  67:     - Move the whole object straight away from its marker side until the object\n  68:       bbox touches the corresponding grid edge.\n  69:     - Keep the marker sprite unchanged within the object.\n  70:     - Rotate the 3x3 colored cross block by 180 degrees before placing it.\n  71: \n  72:     Key insight:\n  73:     The marker sprite is a directional tail; the cross is the leading payload,\n  74:     and only that payload turns around during the slide to the edge.\n  75:     \"\"\"\n  76:     g = np.asarray(grid, dtype=int)\n  77:     H, W = g.shape\n  78:     bg = get_bg(g)\n  79:     marker = _marker_color(g, bg)\n  80: \n  81:     out = np.full_like(g, int(bg))\n  82:     objects = find_components(g, bg=bg, connectivity=8, monochromatic=False)\n  83:     assert objects, \"expected at least one composite object\"\n  84: \n  85:     for obj in objects:\n  86:         assert int(obj[\"area\"]) == 9, \"each composite should contain 9 foreground pixels\"\n  87:         r0, c0, _r1, _c1 = obj[\"bbox\"]\n  88:         patch = crop_bbox(g, obj[\"bbox\"])\n  89:         h, w = patch.shape\n  90:         moved = patch.copy()\n  91: \n  92:         if (h, w) == (3, 6):\n  93:             left = patch[:, :3]\n  94:             right = patch[:, 3:]\n  95:             left_kind = _block_kind(left, bg, marker)\n  96:             right_kind = _block_kind(right, bg, marker)\n  97:             assert {left_kind, right_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n  98: \n  99:             if left_kind == \"marker\":\n 100:                 moved[:, 3:] = np.rot90(right, 2)\n 101:                 target_r, target_c = int(r0), W - w\n 102:             else:\n 103:                 moved[:, :3] = np.rot90(left, 2)\n 104:                 target_r, target_c = int(r0), 0\n 105: \n 106:         elif (h, w) == (6, 3):\n 107:             top = patch[:3, :]\n 108:             bottom = patch[3:, :]\n 109:             top_kind = _block_kind(top, bg, marker)\n 110:             bottom_kind = _block_kind(bottom, bg, marker)\n 111:             assert {top_kind, bottom_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n 112: \n 113:             if top_kind == \"marker\":\n 114:                 moved[3:, :] = np.rot90(bottom, 2)\n 115:                 target_r, target_c = H - h, int(c0)\n 116:             else:\n 117:                 moved[:3, :] = np.rot90(top, 2)\n 118:                 target_r, target_c = 0, int(c0)\n 119: \n 120:         else:\n 121:             raise AssertionError(\"each composite bbox should be 3x6 or 6x3\")\n 122: \n 123:         _paste_checked(out, moved, target_r, target_c, bg)\n 124: \n 125:     return out\n 126: \n 127: # --------------- generator (att2) ---------------\n 128: \n 129: # Colors.\n 130: _GEN_BG = 8\n 131: _GEN_MARKER = 1\n 132: _GEN_CENTER = 4\n 133: _GEN_ARM_COLORS = [0, 2, 3, 5, 6, 7, 9]\n 134: \n 135: # Object layout.\n 136: _GEN_SIDES = [\"left\", \"right\", \"top\", \"bottom\"]\n 137: _GEN_MARKER_COORDS = {\n 138:     \"left\": [(0, 0), (1, 1), (1, 2), (2, 0)],\n 139:     \"right\": [(0, 2), (1, 0), (1, 1), (2, 2)],\n 140:     \"top\": [(0, 0), (0, 2), (1, 1), (2, 1)],\n 141:     \"bottom\": [(0, 1), (1, 1), (2, 0), (2, 2)],\n 142: }\n 143: _GEN_ARM_POSITIONS = [(0, 1), (1, 0), (1, 2), (2, 1)]\n 144: \n 145: # Canvas and placement bounds.\n 146: _GEN_OBJECT_COUNT_RANGE = (1, 4)\n 147: _GEN_MAX_SIDE = 18\n 148: _GEN_MIN_SIDE_BY_OBJECT_COUNT = {1: 8, 2: 8, 3: 10, 4: 12}\n 149: _GEN_PADDING = 1\n 150: _GEN_EDGE_GAP = 2\n 151: _GEN_HORIZONTAL_SIZE = (3, 6)\n 152: _GEN_VERTICAL_SIZE = (6, 3)\n 153: \n 154: # Retry limits.\n 155: _GEN_MAX_ATTEMPTS = 300\n 156: \n 157: \n\n 305: def generate_input() -> np.ndarray:\n 306:     for _ in range(_GEN_MAX_ATTEMPTS):\n 307:         grid = _gen_attempt()\n 308:         if grid is not None:\n 309:             return grid\n 310:     raise RuntimeError(\"failed to generate a valid 99caaf76 input\")\n\n","exit_code":0,"status":"completed"}}
