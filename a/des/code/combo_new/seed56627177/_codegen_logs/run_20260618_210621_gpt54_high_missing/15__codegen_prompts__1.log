 get_bg(g)\n  51: \n  52:     components_by_color = {}\n  53:     bracket_candidates = []\n  54:     for color in colors_present(g, exclude={bg}):\n  55:         components = find_components(\n  56:             g,\n  57:             bg=bg,\n  58:             colors=[color],\n  59:             connectivity=4,\n  60:             monochromatic=True,\n  61:         )\n  62:         components_by_color[color] = components\n  63:         top = [component for component in components if _is_top_bracket(component)]\n  64:         bottom = [\n  65:             component for component in components\n  66:             if _is_bottom_bracket(component, height)\n  67:         ]\n  68:         if len(components) == 2 and len(top) == 1 and len(bottom) == 1:\n  69:             bracket_candidates.append((color, top[0], bottom[0]))\n  70: \n  71:     assert len(bracket_candidates) == 1\n  72:     frame_color, top_bracket, bottom_bracket = bracket_candidates[0]\n  73: \n  74:     movers = [\n  75:         component\n  76:         for color, components in components_by_color.items()\n  77:         if color != frame_color\n  78:         for component in components\n  79:     ]\n  80:     assert len(movers) == 1\n  81:     mover = movers[0]\n  82: \n  83:     _, mc0, _, mc1 = mover[\"bbox\"]\n  84:     _br0, bc0, _br1, bc1 = bottom_bracket[\"bbox\"]\n  85:     _tr0, tc0, _tr1, tc1 = top_bracket[\"bbox\"]\n  86:     assert (mc0, mc1) == (bc0 + 1, bc1 - 1)\n  87:     assert bbox_w(mover[\"bbox\"]) == tc1 - tc0 - 1\n  88: \n  89:     patch = crop_bbox(g, mover[\"bbox\"])\n  90:     dest_r = height - patch.shape[0]\n  91:     dest_c = tc0 + 1\n  92:     assert dest_r >= 0\n  93:     assert dest_c >= 0 and dest_c + patch.shape[1] <= width\n  94: \n  95:     out = g.copy()\n  96:     mover_coords = mover[\"coords\"]\n  97:     out[mover_coords[:, 0], mover_coords[:, 1]] = bg\n  98: \n  99:     colored_patch = patch != bg\n 100:     target = out[dest_r:dest_r + patch.shape[0], dest_c:dest_c + patch.shape[1]]\n 101:     assert np.all(target[colored_patch] == bg)\n 102: \n 103:     paste(out, patch, dest_r, dest_c, transparent=bg)\n 104:     return out\n 105: \n 106: # --------------- generator (o5x) ---------------\n 107: \n 108: # Fixed task colors.\n 109: BG_COLOR, BRACKET_COLOR = 7, 4\n 110: MOVER_COLORS = [0, 1, 2, 3, 5, 6, 8, 9]\n 111: # Canvas, bracket, and mover-size bounds.\n 112: GRID_SIZE_RANGE = (8, 9)\n 113: BRACKET_WIDTH_RANGE = (3, 4)\n 114: MOVER_HEIGHT_RANGE = (1, 3)\n 115: MOVER_MAX_CELLS = 4\n 116: MOVER_MIN_DENSITY_NUM = 2\n 117: MOVER_MIN_DENSITY_DEN = 3\n 118: # Layout choices and retry budget.\n 119: TOP_LEFT_OPTIONS = [True, False]\n 120: MAX_GENERATION_ATTEMPTS = 300\n 121: \n\n 217: def generate_input():\n 218:     for _ in range(MAX_GENERATION_ATTEMPTS):\n 219:         grid = _gen_attempt()\n 220:         if grid is not None:\n 221:             return grid\n 222:     raise RuntimeError(\"failed to generate df9fd884 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\n  41: def main(grid: np.ndarray) -> np.ndarray:\n  42:     \"\"\"\n  43:     Fill enclosed regions along a line seeded by unique border pixels.\n  44: \n  45:     Input structure:\n  46:     - bg = most common color.\n  47:     - Colored lines/drawings on the grid.\n  48:     - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n  49: \n  50:     Rule:\n  51:     - Each border seed pixel connects (8-connected) to a line drawing.\n  52:     - Find closed bg cavities whose boundary touches that line.\n  53:     - Flood-fill each such cavity with the seed pixel's color.\n  54: \n  55:     Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n  56:     \"\"\"\n  57:     g = np.asarray(grid, dtype=int)\n  58:     h, w = g.shape\n  59:     bg = get_bg(g)\n  60: \n  61:     out = g.copy()\n  62: \n  63:     # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n  64:     bg_comps = _components_mask(g == bg, conn8=False)\n  65:     regions = []  # list of (set_pts, boundary_set, touches_border, size)\n  66:     for pts in bg_comps:\n  67:         region = set(pts)\n  68:         touches = _touches_border(pts, h, w)\n  69:         boundary = set()\n  70:         for r, c in region:\n  71:             for nr, nc in neighbors4(r, c):\n  72:                 if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n  73:                     boundary.add((nr, nc))\n  74:         regions.append((region, boundary, touches, len(region)))\n  75: \n  76:     corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n  77:     outside_idxs = set()\n  78:     for i, (reg, _, _, _) in enumerate(regions):\n  79:         if any(p in reg for p in corners if int(g[p]) == bg):\n  80:             outside_idxs.add(i)\n  81: \n  82:     cavities = []\n  83:     for i, (reg, bnd, _, _) in enumerate(regions):\n  84:         if i in outside_idxs or not bnd:\n  85:             continue\n  86:         bcols = {int(g[p]) for p in bnd}\n  87:         cavities.append((reg, bnd, bcols))\n  88: \n  89:     for sr, sc in _seed_pixels(g, bg):\n  90:         seed_col = int(g[sr, sc])\n  91: \n  92:         neigh_cols = []\n  93:         for nr, nc in neighbors4(sr, sc):\n  94:             if 0 <= nr < h and 0 <= nc < w:\n  95:                 v = int(g[nr, nc])\n  96:                 if v != bg:\n  97:                     neigh_cols.append(v)\n  98:         assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n  99:         line_col = Counter(neigh_cols).most_common(1)[0][0]\n 100: \n 101:         # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n 102:         traced = _nonbg_component8_from(g, (sr, sc), bg)\n 103: \n 104:         for cav, boundary, bcols in cavities:\n 105:             if len(bcols) != 1:\n 106:                 continue\n 107:             boundary_in_traced = boundary & traced\n 108:             if not boundary_in_traced:\n 109:                 continue\n 110: \n 111:             # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n 112:             # This prevents filling regions that are only connected through other structures, not the line itself.\n 113:             ok = False\n 114:             for r, c in boundary_in_traced:\n 115:                 for nr, nc in neighbors8(r, c):\n 116:                     if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n 117:                         ok = True\n 118:                         break\n 119:                 if ok:\n 120:                     break\n 121:             if not ok:\n 122:                 continue\n 123: \n 124:             for r, c in cav:\n 125:                 if int(out[r, c]) == bg:\n 126:                     out[r, c] = seed_col\n 127: \n 128:     return out\n 129: \n 130: # --------------- generator (attempt_1_distractor_network) ---------------\n 131: \n 132: # ========================== CFG ==========================\n 133: # Canvas / grid\n 134: GRID_H_RANGE = (8, 30)             # grid height bounds\n 135: GRID_W_RANGE = (8, 30)             # grid width bounds\n 136: BG_COLORS = [0, 5]                 # background color choices\n 137: \n 138: # Seeds\n 139: SEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\n 140: MIN_LINE_LEN = 4                   # discard attempt if line shorter than this\n 141: LINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n 142: \n 143: # Frame loops\n 144: FRAME_COLORS_MAX = 4               # max distinct frame colors\n 145: TOTAL_LOOPS_MAX = 9                # max total loops per grid\n 146: CAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\n 147: DISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices