{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py | sed -n '240,520p'\"","aggregated_output":"   240\t    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n   241\t    h, w = canvas_mask.shape\n   242\t    sr, sc = seed\n   243\t    if not canvas_mask[sr, sc]:\n   244\t        return None\n   245\t    blob = {(sr, sc)}\n   246\t    frontier = []\n   247\t    def push_neighbors(r, c):\n   248\t        for nr, nc in neighbors4(r, c):\n   249\t            if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:\n   250\t                frontier.append((nr, nc))\n   251\t    push_neighbors(sr, sc)\n   252\t    while len(blob) < target_size and frontier:\n   253\t        idx = rng.randrange(len(frontier))\n   254\t        r, c = frontier.pop(idx)\n   255\t        if (r, c) in blob or not canvas_mask[r, c]:\n   256\t            continue\n   257\t        blob.add((r, c))\n   258\t        push_neighbors(r, c)\n   259\t    if len(blob) < target_size:\n   260\t        return None\n   261\t    return blob\n   262\t\n   263\t\n   264\tdef _blob_wall_cells(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n   265\t    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n   266\t    wall = set()\n   267\t    for r, c in blob:\n   268\t        for nr, nc in neighbors4(r, c):\n   269\t            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in blob:\n   270\t                wall.add((nr, nc))\n   271\t    return wall\n   272\t\n   273\t\n   274\tdef _fill_holes(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n   275\t    \"\"\"Return blob with interior holes absorbed.\n   276\t\n   277\t    Barrier = blob union its wall ring. Any non-barrier cell unreachable from the grid\n   278\t    border through non-barrier cells is trapped and gets absorbed into the blob.\n   279\t    \"\"\"\n   280\t    walls = _blob_wall_cells(blob, h, w)\n   281\t    barrier = np.zeros((h, w), dtype=bool)\n   282\t    for r, c in blob:\n   283\t        barrier[r, c] = True\n   284\t    for r, c in walls:\n   285\t        barrier[r, c] = True\n   286\t\n   287\t    # Flood-fill from border through non-barrier cells.\n   288\t    reachable = np.zeros((h, w), dtype=bool)\n   289\t    stack = []\n   290\t    for r in range(h):\n   291\t        for c in (0, w - 1):\n   292\t            if not barrier[r, c]:\n   293\t                stack.append((r, c))\n   294\t    for c in range(w):\n   295\t        for r in (0, h - 1):\n   296\t            if not barrier[r, c]:\n   297\t                stack.append((r, c))\n   298\t    while stack:\n   299\t        r, c = stack.pop()\n   300\t        if reachable[r, c] or barrier[r, c]:\n   301\t            continue\n   302\t        reachable[r, c] = True\n   303\t        for nr, nc in neighbors4(r, c):\n   304\t            if 0 <= nr < h and 0 <= nc < w and not reachable[nr, nc] and not barrier[nr, nc]:\n   305\t                stack.append((nr, nc))\n   306\t\n   307\t    trapped = (~reachable) & (~barrier)\n   308\t    if not trapped.any():\n   309\t        return blob\n   310\t    filled = set(blob)\n   311\t    for r, c in np.argwhere(trapped):\n   312\t        filled.add((int(r), int(c)))\n   313\t    return filled\n   314\t\n   315\t\n   316\t# ── Slide helpers ─────────────────────────────────────────────────\n   317\t\n   318\tdef _slide_step_valid(region_set: set, r: int, c: int, dr: int, dc: int) -> bool:\n   319\t    nr, nc = r + dr, c + dc\n   320\t    if (nr, nc) not in region_set:\n   321\t        return False\n   322\t    if dr != 0 and dc != 0:\n   323\t        if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n   324\t            return False\n   325\t    return True\n   326\t\n   327\t\n   328\tdef _forward_slide(region_set: set, start: tuple[int, int], dr: int, dc: int,\n   329\t                   blocked: set) -> tuple[int, int]:\n   330\t    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n   331\t    r, c = start\n   332\t    while True:\n   333\t        if not _slide_step_valid(region_set, r, c, dr, dc):\n   334\t            break\n   335\t        nr, nc = r + dr, c + dc\n   336\t        if (nr, nc) in blocked:\n   337\t            break\n   338\t        r, c = nr, nc\n   339\t    return (r, c)\n   340\t\n   341\t\n   342\t# ── Generator phases ─────────────────────────────────────────────\n   343\t\n   344\tdef _place_legends(rng: random.Random, grid: np.ndarray,\n   345\t                   ) -> tuple[np.ndarray, list[tuple[int, tuple[int,int]]]]:\n   346\t    \"\"\"Place 1-2 legend patches at grid corners.\n   347\t\n   348\t    Returns (legend_occupied mask, list of (wall_color, direction) pairs).\n   349\t    \"\"\"\n   350\t    h, w = grid.shape\n   351\t    n_legends = rng.choice([1, 2])\n   352\t    corners = rng.sample(CORNERS, n_legends)\n   353\t    wall_colors = rng.sample(WALL_COLOR_CHOICES, n_legends)\n   354\t\n   355\t    legend_occupied = np.zeros((h, w), dtype=bool)\n   356\t    legends = []\n   357\t\n   358\t    for corner, wc in zip(corners, wall_colors):\n   359\t        if rng.random() < CARDINAL_PROB:\n   360\t            dr, dc = rng.choice(CARDINAL_DIRS)\n   361\t            patch = _legend_5x5(wc, dr, dc)\n   362\t        else:\n   363\t            dr, dc = rng.choice(DIAGONAL_DIRS)\n   364\t            patch = _legend_6x7(wc, dr, dc)\n   365\t        ph, pw = patch.shape\n   366\t        r0, c0 = _corner_origin(corner, h, w, ph, pw)\n   367\t        paste(grid, patch, r0, c0)\n   368\t        # Reserve legend cells + buffer.\n   369\t        r_lo, r_hi = max(0, r0 - LEGEND_BUFFER), min(h, r0 + ph + LEGEND_BUFFER)\n   370\t        c_lo, c_hi = max(0, c0 - LEGEND_BUFFER), min(w, c0 + pw + LEGEND_BUFFER)\n   371\t        legend_occupied[r_lo:r_hi, c_lo:c_hi] = True\n   372\t        legends.append((wc, (dr, dc)))\n   373\t\n   374\t    return legend_occupied, legends\n   375\t\n   376\t\n   377\tdef _grow_regions(rng: random.Random, legends: list[tuple[int, tuple[int,int]]],\n   378\t                  legend_occupied: np.ndarray,\n   379\t                  ) -> list[dict] | None:\n   380\t    \"\"\"Grow irregular closed regions, one per assigned wall color.\n   381\t\n   382\t    Returns list of region dicts or None on failure.\n   383\t    \"\"\"\n   384\t    h, w = legend_occupied.shape\n   385\t    color_dir = {wc: d for wc, d in legends}\n   386\t    all_colors = [wc for wc, _ in legends]\n   387\t\n   388\t    # Assign 1-3 regions per wall color, cap total.\n   389\t    region_colors = []\n   390\t    for c in all_colors:\n   391\t        region_colors.extend([c] * rng.randint(*REGIONS_PER_COLOR))\n   392\t    if len(region_colors) > MAX_TOTAL_REGIONS:\n   393\t        region_colors = rng.sample(region_colors, MAX_TOTAL_REGIONS)\n   394\t    rng.shuffle(region_colors)\n   395\t\n   396\t    size_min, size_max = REGION_SIZE_BOUNDS[len(region_colors)]\n   397\t    occupied = legend_occupied.copy()\n   398\t    regions = []\n   399\t\n   400\t    for rc in region_colors:\n   401\t        dr, dc = color_dir[rc]\n   402\t        target_size = rng.randint(size_min, size_max)\n   403\t\n   404\t        # Build canvas: interior cells (not border) that are unoccupied.\n   405\t        canvas = np.ones((h, w), dtype=bool)\n   406\t        canvas[0, :] = False; canvas[-1, :] = False\n   407\t        canvas[:, 0] = False; canvas[:, -1] = False\n   408\t        canvas &= ~occupied\n   409\t        if not canvas.any():\n   410\t            continue\n   411\t\n   412\t        blob = _try_grow_valid_blob(rng, canvas, occupied, target_size, h, w)\n   413\t        if blob is None:\n   414\t            continue\n   415\t\n   416\t        walls = _blob_wall_cells(blob, h, w)\n   417\t        regions.append({'color': rc, 'dir': (dr, dc), 'interior': blob, 'walls': walls})\n   418\t\n   419\t        # Reserve blob + walls + 1-cell buffer around walls.\n   420\t        reserve = blob | walls\n   421\t        extra = set()\n   422\t        for r, c in walls:\n   423\t            for nr, nc in neighbors4(r, c):\n   424\t                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in reserve:\n   425\t                    extra.add((nr, nc))\n   426\t        for r, c in reserve | extra:\n   427\t            occupied[r, c] = True\n   428\t\n   429\t    if not regions:\n   430\t        return None\n   431\t    # Every legend color must have at least one region.\n   432\t    if {reg['color'] for reg in regions} != set(all_colors):\n   433\t        return None\n   434\t    return regions\n   435\t\n   436\t\n   437\tdef _try_grow_valid_blob(rng: random.Random, canvas: np.ndarray,\n   438\t                         occupied: np.ndarray, target_size: int,\n   439\t                         h: int, w: int) -> set[tuple[int,int]] | None:\n   440\t    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n   441\t    for _ in range(BLOB_GROW_RETRIES):\n   442\t        free = np.argwhere(canvas)\n   443\t        if len(free) == 0:\n   444\t            break\n   445\t        sr, sc = free[rng.randrange(len(free))]\n   446\t        cand = _grow_blob(canvas, (int(sr), int(sc)), target_size, rng)\n   447\t        if cand is None:\n   448\t            continue\n   449\t        # Fill interior holes until stable.\n   450\t        while True:\n   451\t            filled = _fill_holes(cand, h, w)\n   452\t            if filled == cand:\n   453\t                break\n   454\t            cand = filled\n   455\t        # Absorbed cells must stay within canvas.\n   456\t        if any(not canvas[r, c] for r, c in cand):\n   457\t            continue\n   458\t        walls = _blob_wall_cells(cand, h, w)\n   459\t        # Walls must not overlap occupied cells or the grid border.\n   460\t        if any(occupied[wr, wc] or wr in (0, h - 1) or wc in (0, w - 1)\n   461\t               for wr, wc in walls):\n   462\t            continue\n   463\t        return cand\n   464\t    return None\n   465\t\n   466\t\n   467\tdef _validate_topology(grid: np.ndarray, regions: list[dict]) -> bool:\n   468\t    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n   469\t    h, w = grid.shape\n   470\t    labeled, n_comp = label_mask(grid == 0, connectivity=4)\n   471\t    bounded = []\n   472\t    for comp_id in range(1, n_comp + 1):\n   473\t        coords = np.argwhere(labeled == comp_id)\n   474\t        if any(r in (0, h - 1) or c in (0, w - 1) for r, c in coords):\n   475\t            continue\n   476\t        bounded.append({(int(r), int(c)) for r, c in coords})\n   477\t    region_sets = [reg['interior'] for reg in regions]\n   478\t    if len(bounded) != len(region_sets):\n   479\t        return False\n   480\t    return all(comp in region_sets for comp in bounded)\n   481\t\n   482\t\n   483\tdef _place_yellows(rng: random.Random, regions: list[dict],\n   484\t                   grid: np.ndarray) -> bool:\n   485\t    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n   486\t\n   487\t    Modifies grid in-place by painting yellow(4) at input positions.\n   488\t    Returns True on success.\n   489\t    \"\"\"\n   490\t    for reg in regions:\n   491\t        blob = reg['interior']\n   492\t        dr, dc = reg['dir']\n   493\t        n_yellows = rng.choice(YELLOWS_PER_REGION)\n   494\t\n   495\t        # Cells sorted by projection onto slide direction (farthest first).\n   496\t        cells_sorted = sorted(blob, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n   497\t        far_key = dr * cells_sorted[0][0] + dc * cells_sorted[0][1]\n   498\t        tier1 = [p for p in cells_sorted if dr * p[0] + dc * p[1] == far_key]\n   499\t\n   500\t        # Pick output positions: first at the farthest tier, second one step behind or at tier1.\n   501\t        first = tier1[rng.randrange(len(tier1))]\n   502\t        output_positions = [first]\n   503\t\n   504\t        if n_yellows == 2:\n   505\t            pr, pc = first[0] - dr, first[1] - dc\n   506\t            cands = ([(pr, pc)] if (pr, pc) in blob else []) + [p for p in tier1 if p != first]\n   507\t            if cands:\n   508\t                second = cands[rng.randrange(len(cands))]\n   509\t                if second != first:\n   510\t                    output_positions.append(second)\n   511\t\n   512\t        # Reverse-slide: process in solver order (far-to-near).\n   513\t        out_sorted = sorted(output_positions, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n   514\t        already_stopped = set()\n   515\t        yellows_input = []\n   516\t\n   517\t        for out_pos in out_sorted:\n   518\t            candidate = _find_reverse_slide(blob, out_pos, dr, dc, already_stopped,\n   519\t                                            yellows_input, rng)\n   520\t            if candidate is None:\n","exit_code":0,"status":"completed"}}
