{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py | sed -n '1,240p'\"","aggregated_output":"     1\timport numpy as np\n     2\tfrom collections import Counter, deque\n     3\t\n     4\tfrom arc_utils import components_mask, get_bg, neighbors4, neighbors8\n     5\timport random\n     6\tdef _components_mask(mask: np.ndarray, conn8: bool) -> list[list[tuple[int, int]]]:\n     7\t    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(mask, connectivity=8 if conn8 else 4)]\n     8\t\n     9\t\n    10\tdef _touches_border(pts: list[tuple[int, int]], h: int, w: int) -> bool:\n    11\t    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n    12\t\n    13\t\n    14\tdef _seed_pixels(g: np.ndarray, bg: int) -> list[tuple[int, int]]:\n    15\t    h, w = g.shape\n    16\t    vals, cnts = np.unique(g, return_counts=True)\n    17\t    seeds: list[tuple[int, int]] = []\n    18\t    for v, cnt in zip(vals, cnts):\n    19\t        v = int(v)\n    20\t        if v == bg or int(cnt) != 1:\n    21\t            continue\n    22\t        r, c = map(int, np.argwhere(g == v)[0])\n    23\t        if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n    24\t            seeds.append((r, c))\n    25\t    return seeds\n    26\t\n    27\t\n    28\tdef _nonbg_component8_from(g: np.ndarray, start: tuple[int, int], bg: int) -> set[tuple[int, int]]:\n    29\t    h, w = g.shape\n    30\t    st = [start]\n    31\t    vis = {start}\n    32\t    while st:\n    33\t        r, c = st.pop()\n    34\t        for nr, nc in neighbors8(r, c):\n    35\t            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in vis and int(g[nr, nc]) != bg:\n    36\t                vis.add((nr, nc))\n    37\t                st.append((nr, nc))\n    38\t    return vis\n    39\t\n    40\t\n    41\tdef main(grid: np.ndarray) -> np.ndarray:\n    42\t    \"\"\"\n    43\t    Fill enclosed regions along a line seeded by unique border pixels.\n    44\t\n    45\t    Input structure:\n    46\t    - bg = most common color.\n    47\t    - Colored lines/drawings on the grid.\n    48\t    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n    49\t\n    50\t    Rule:\n    51\t    - Each border seed pixel connects (8-connected) to a line drawing.\n    52\t    - Find closed bg cavities whose boundary touches that line.\n    53\t    - Flood-fill each such cavity with the seed pixel's color.\n    54\t\n    55\t    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    56\t    \"\"\"\n    57\t    g = np.asarray(grid, dtype=int)\n    58\t    h, w = g.shape\n    59\t    bg = get_bg(g)\n    60\t\n    61\t    out = g.copy()\n    62\t\n    63\t    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    64\t    bg_comps = _components_mask(g == bg, conn8=False)\n    65\t    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    66\t    for pts in bg_comps:\n    67\t        region = set(pts)\n    68\t        touches = _touches_border(pts, h, w)\n    69\t        boundary = set()\n    70\t        for r, c in region:\n    71\t            for nr, nc in neighbors4(r, c):\n    72\t                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n    73\t                    boundary.add((nr, nc))\n    74\t        regions.append((region, boundary, touches, len(region)))\n    75\t\n    76\t    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    77\t    outside_idxs = set()\n    78\t    for i, (reg, _, _, _) in enumerate(regions):\n    79\t        if any(p in reg for p in corners if int(g[p]) == bg):\n    80\t            outside_idxs.add(i)\n    81\t\n    82\t    cavities = []\n    83\t    for i, (reg, bnd, _, _) in enumerate(regions):\n    84\t        if i in outside_idxs or not bnd:\n    85\t            continue\n    86\t        bcols = {int(g[p]) for p in bnd}\n    87\t        cavities.append((reg, bnd, bcols))\n    88\t\n    89\t    for sr, sc in _seed_pixels(g, bg):\n    90\t        seed_col = int(g[sr, sc])\n    91\t\n    92\t        neigh_cols = []\n    93\t        for nr, nc in neighbors4(sr, sc):\n    94\t            if 0 <= nr < h and 0 <= nc < w:\n    95\t                v = int(g[nr, nc])\n    96\t                if v != bg:\n    97\t                    neigh_cols.append(v)\n    98\t        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n    99\t        line_col = Counter(neigh_cols).most_common(1)[0][0]\n   100\t\n   101\t        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n   102\t        traced = _nonbg_component8_from(g, (sr, sc), bg)\n   103\t\n   104\t        for cav, boundary, bcols in cavities:\n   105\t            if len(bcols) != 1:\n   106\t                continue\n   107\t            boundary_in_traced = boundary & traced\n   108\t            if not boundary_in_traced:\n   109\t                continue\n   110\t\n   111\t            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n   112\t            # This prevents filling regions that are only connected through other structures, not the line itself.\n   113\t            ok = False\n   114\t            for r, c in boundary_in_traced:\n   115\t                for nr, nc in neighbors8(r, c):\n   116\t                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n   117\t                        ok = True\n   118\t                        break\n   119\t                if ok:\n   120\t                    break\n   121\t            if not ok:\n   122\t                continue\n   123\t\n   124\t            for r, c in cav:\n   125\t                if int(out[r, c]) == bg:\n   126\t                    out[r, c] = seed_col\n   127\t\n   128\t    return out\n   129\t\n   130\t# --------------- generator (attempt_1_distractor_network) ---------------\n   131\t\n   132\t# ========================== CFG ==========================\n   133\t# Canvas / grid\n   134\tGRID_H_RANGE = (8, 30)             # grid height bounds\n   135\tGRID_W_RANGE = (8, 30)             # grid width bounds\n   136\tBG_COLORS = [0, 5]                 # background color choices\n   137\t\n   138\t# Seeds\n   139\tSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\n   140\tMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\n   141\tLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n   142\t\n   143\t# Frame loops\n   144\tFRAME_COLORS_MAX = 4               # max distinct frame colors\n   145\tTOTAL_LOOPS_MAX = 9                # max total loops per grid\n   146\tCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\n   147\tDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\n   148\tFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\n   149\tFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\n   150\tDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n   151\t\n   152\t# Line growth\n   153\tDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\n   154\tDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\n   155\tORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\n   156\tORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\n   157\tBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\n   158\tBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n   159\t\n   160\t# Distractor network\n   161\tDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\n   162\tDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\n   163\tDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\n   164\tDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\n   165\tDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n   166\t\n   167\t# Generation\n   168\tGEN_RETRIES = 300                  # outer retry budget in generate_input()\n   169\t# =========================================================\n   170\t\n   171\tDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\n   172\tORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n   173\t\n   174\t\n   175\tdef _in_bounds(h, w, r, c):\n   176\t    return 0 <= r < h and 0 <= c < w\n   177\t\n   178\t\n   179\t# ---------------------------------------------------------------------------\n   180\t# Frame geometry\n   181\t# ---------------------------------------------------------------------------\n   182\t\n   183\tdef _frame_ring_coords(r0, c0, ch, cw):\n   184\t    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n   185\t\n   186\t    Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).\n   187\t    Ring = bbox boundary minus 4 corners.\n   188\t    \"\"\"\n   189\t    H, W = ch + 2, cw + 2\n   190\t    ring = []\n   191\t    for dr in range(H):\n   192\t        for dc in range(W):\n   193\t            on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)\n   194\t            corner = (dr in (0, H - 1)) and (dc in (0, W - 1))\n   195\t            if on_bdr and not corner:\n   196\t                ring.append((r0 + dr, c0 + dc))\n   197\t    cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]\n   198\t    return ring, cavity\n   199\t\n   200\t\n   201\tdef _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n   202\t    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n   203\t\n   204\t    Returns True if: ring and cavity cells are empty, no cavity cell is\n   205\t    8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and\n   206\t    at least one ring cell is 8-adjacent to a line_col pixel.\n   207\t    \"\"\"\n   208\t    # Ring and cavity cells must all be empty\n   209\t    for rr, cc in ring:\n   210\t        if canvas[rr, cc] != -1:\n   211\t            return False\n   212\t    for rr, cc in cavity:\n   213\t        if canvas[rr, cc] != -1:\n   214\t            return False\n   215\t\n   216\t    # No cavity cell may be 8-adjacent to any line_col pixel\n   217\t    for cr, cc in cavity:\n   218\t        for nr, nc in neighbors8(cr, cc):\n   219\t            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n   220\t                return False\n   221\t\n   222\t    # Ring must not be 8-adjacent to any non-bg, non-line_col pixel\n   223\t    ring_set = set(ring)\n   224\t    for rr, cc in ring:\n   225\t        for nr, nc in neighbors8(rr, cc):\n   226\t            if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:\n   227\t                continue\n   228\t            v = canvas[nr, nc]\n   229\t            if v != -1 and v != line_col:\n   230\t                return False\n   231\t\n   232\t    # At least one ring cell must be 8-adjacent to a line_col pixel\n   233\t    for rr, cc in ring:\n   234\t        for nr, nc in neighbors8(rr, cc):\n   235\t            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n   236\t                return True\n   237\t    return False\n   238\t\n   239\t\n   240\t# ---------------------------------------------------------------------------\n","exit_code":0,"status":"completed"}}
