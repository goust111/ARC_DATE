{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/eval/e3721c99.py | sed -n '1,260p'\"","aggregated_output":"     1\timport numpy as np\n     2\t\n     3\tfrom arc_utils import bbox_coords, components_mask, get_bg, is_contiguous, neighbors4, paste\n     4\timport itertools\n     5\timport random\n     6\t\n     7\t\n     8\tdef _hole_count(mask: np.ndarray) -> int:\n     9\t    \"\"\"\n    10\t    Count holes in a binary mask using 4-connectivity.\n    11\t    A hole is a background component that does not touch the mask's bounding box border.\n    12\t    \"\"\"\n    13\t    h, w = mask.shape\n    14\t    bg = ~mask\n    15\t    vis = np.zeros((h, w), dtype=bool)\n    16\t    holes = 0\n    17\t    for r0 in range(h):\n    18\t        for c0 in range(w):\n    19\t            if not bg[r0, c0] or vis[r0, c0]:\n    20\t                continue\n    21\t            st = [(r0, c0)]\n    22\t            vis[r0, c0] = True\n    23\t            touches = False\n    24\t            while st:\n    25\t                r, c = st.pop()\n    26\t                if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n    27\t                    touches = True\n    28\t                for rr, cc in neighbors4(r, c):\n    29\t                    if 0 <= rr < h and 0 <= cc < w and bg[rr, cc] and not vis[rr, cc]:\n    30\t                        vis[rr, cc] = True\n    31\t                        st.append((rr, cc))\n    32\t            if not touches:\n    33\t                holes += 1\n    34\t    return holes\n    35\t\n    36\t\n    37\tdef _legend_mapping(g: np.ndarray, bg: int, grey: int) -> dict[int, int]:\n    38\t    \"\"\"\n    39\t    Pick one 'legend' component per non-(bg,grey) color:\n    40\t      - component is at least 2x2,\n    41\t      - component does not touch the outer grid border (filters dividers).\n    42\t    Map hole_count -> legend_color.\n    43\t    \"\"\"\n    44\t    h, w = g.shape\n    45\t    mapping: dict[int, int] = {}\n    46\t    colors = [c for c in sorted(set(map(int, np.unique(g)))) if c not in (bg, grey)]\n    47\t    for c in colors:\n    48\t        comps = components_mask(g == c, connectivity=4)\n    49\t        candidates = []\n    50\t        for pts in comps:\n    51\t            r0, c0, r1, c1 = bbox_coords(pts)\n    52\t            if r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1:\n    53\t                continue\n    54\t            if (r1 - r0 + 1) < 2 or (c1 - c0 + 1) < 2:\n    55\t                continue\n    56\t            candidates.append((r0, c0, r1, c1))\n    57\t        if not candidates:\n    58\t            continue\n    59\t        assert len(candidates) == 1, f\"color {c} must have exactly one legend component\"\n    60\t        r0, c0, r1, c1 = candidates[0]\n    61\t        sub = (g[r0 : r1 + 1, c0 : c1 + 1] == c)\n    62\t        hc = _hole_count(sub)\n    63\t        assert hc not in mapping, f\"legend hole count {hc} must map to exactly one color\"\n    64\t        mapping[hc] = c\n    65\t    return mapping\n    66\t\n    67\t\n    68\tdef main(grid: np.ndarray) -> np.ndarray:\n    69\t    \"\"\"\n    70\t    Recolor grey shapes by matching their hole count to a color legend.\n    71\t\n    72\t    Input structure:\n    73\t    - bg = most common color; grey (5) sprites scattered across the grid.\n    74\t    - Colored legend shapes (non-bg, non-grey, at least 2×2, not touching the outer border) near grid edge,\n    75\t      each with a distinct number of enclosed holes.\n    76\t\n    77\t    Rule:\n    78\t    - Each colored legend shape defines a mapping: hole count → color.\n    79\t    - For every grey sprite, count its holes (enclosed bg regions not touching the sprite's bounding-box border).\n    80\t    - Recolor the grey sprite to the matching legend color; erase grey distractors with unlisted hole counts.\n    81\t\n    82\t    Key insight: Shape identity is encoded by topology (number of holes), not geometry or size.\n    83\t    \"\"\"\n    84\t    g = np.asarray(grid, dtype=int)\n    85\t    bg = get_bg(g)\n    86\t    grey = 5\n    87\t\n    88\t    legend = _legend_mapping(g, bg, grey)\n    89\t    assert legend, \"legend mapping must be non-empty: grid must contain colored legend shapes\"\n    90\t\n    91\t    out = g.copy()\n    92\t    for pts in components_mask(g == grey, connectivity=4):\n    93\t        r0, c0, r1, c1 = bbox_coords(pts)\n    94\t        sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n    95\t        for r, c in pts:\n    96\t            sub[r - r0, c - c0] = True\n    97\t        hc = _hole_count(sub)\n    98\t        newc = int(legend[hc]) if hc in legend else bg\n    99\t        for r, c in pts:\n   100\t            out[r, c] = newc\n   101\t\n   102\t    return out\n   103\t\n   104\t# --------------- generator (holes-first organic blob) ---------------\n   105\t\n   106\tfrom arc_utils import label_mask\n   107\tfrom scipy.ndimage import binary_dilation, generate_binary_structure\n   108\t\n   109\t# -- palette & grid --\n   110\tBG = 0\n   111\tDIV = 1\n   112\tGREY = 5\n   113\tGRID_SIZE = 30\n   114\tLEGEND_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\n   115\t\n   116\t# -- legend panel --\n   117\tLEGEND_COUNT_RANGE = (2, 4)         # number of legend entries\n   118\tMAX_HOLE_COUNT = 6                  # hole values drawn from range(MAX_HOLE_COUNT)\n   119\tPANEL_SIZE_RANGE = (5, 8)           # panel thickness (cross-axis)\n   120\tFULL_LAYOUT_MAX_SPAN = 28          # max legend line span for full-row/col layouts\n   121\tL_LAYOUT_MAX_SPAN = 24            # max legend line span for L-shaped layouts\n   122\tL_LAYOUT_EXTRA_PADDING = 3        # max random padding along the L arm\n   123\t\n   124\t# -- sprites --\n   125\tTOTAL_SPRITES_RANGE = (8, 11)       # total sprites (matches + distractors)\n   126\tMAX_DISTRACTORS = 7                 # max distractor sprites\n   127\tMAX_EXTRA_PER_LEGEND = 2            # max extra match sprites per legend entry\n   128\tSPRITE_RETRIES = 30                 # retries per sprite generation attempt\n   129\tSPRITE_AREA_0 = (5, 25)              # (min, max) area for 0-hole sprites\n   130\tSPRITE_AREA_LOW_MIN = 8              # min area for 1-2 hole sprites (max = 25+10*h)\n   131\t# 3+ hole sprites: min = 10+2*h, max = 20+4*h\n   132\tCANVAS_SCALE = 1.2                  # sqrt(area) multiplier for canvas size\n   133\tCANVAS_MIN = 5                      # minimum canvas dimension\n   134\tCANVAS_PAD = 2                      # padding added to scaled sqrt for canvas\n   135\tHOLE_SEED_RADIUS_FACTOR = 0.45      # radius = factor * sqrt(area)\n   136\tHOLE_SEED_MIN_RADIUS = 2\n   137\tHOLE_SEED_MIN_SEP = 2               # minimum Chebyshev distance between hole seeds\n   138\tHOLE_SEED_MARGIN = 2                # margin from canvas edge for hole seeds\n   139\tSEAL_ITERS = 5                      # max iterations for sealing forbidden cells\n   140\tSPRITE_MAX_H = 12                   # max sprite bbox height\n   141\tSPRITE_MAX_W = 18                   # max sprite bbox width\n   142\tSPRITE_MAX_ASPECT = 2.5             # max aspect ratio (max_dim / min_dim)\n   143\t\n   144\t# -- generation --\n   145\tGEN_RETRIES = 300                   # outer retries for generate_input()\n   146\t\n   147\t# 8-connectivity structuring element for dilation\n   148\t_STRUCT8 = generate_binary_structure(2, 2)\n   149\t\n   150\t\n   151\t# ---------- legend helpers ----------\n   152\t\n   153\tdef _legend_span(hole_count: int) -> int:\n   154\t    \"\"\"Width (or height) of a single legend patch along the arrangement axis.\"\"\"\n   155\t    return 3 if hole_count == 0 else 2 * hole_count + 1\n   156\t\n   157\t\n   158\tdef _legend_patch(hole_count: int, color: int, arrangement: str) -> np.ndarray:\n   159\t    \"\"\"Build a 3xSpan (horizontal) or Spanx3 (vertical) legend patch.\"\"\"\n   160\t    span = _legend_span(hole_count)\n   161\t    if arrangement == \"horizontal\":\n   162\t        patch = np.full((3, span), int(color), dtype=int)\n   163\t        if hole_count:\n   164\t            patch[1, 1::2] = BG\n   165\t    else:\n   166\t        patch = np.full((span, 3), int(color), dtype=int)\n   167\t        if hole_count:\n   168\t            patch[1::2, 1] = BG\n   169\t    return patch\n   170\t\n   171\t\n   172\tdef _line_span(legends: list[tuple[int, int]]) -> int:\n   173\t    \"\"\"Total span of legend patches plus 1-cell gaps between them.\"\"\"\n   174\t    return sum(_legend_span(h) for h, _ in legends) + len(legends) - 1\n   175\t\n   176\t\n   177\tdef _choose_legends(arrangement: str, max_span: int) -> list[tuple[int, int]]:\n   178\t    \"\"\"Pick 2-4 legends with distinct hole counts that fit within max_span.\"\"\"\n   179\t    count = random.randint(*LEGEND_COUNT_RANGE)\n   180\t    combos = [holes for holes in itertools.combinations(range(MAX_HOLE_COUNT), count)\n   181\t              if sum(_legend_span(h) for h in holes) + count - 1 <= max_span]\n   182\t    if not combos:\n   183\t        return _choose_legends(arrangement, max_span + 2)\n   184\t    holes = list(random.choice(combos))\n   185\t    random.shuffle(holes)\n   186\t    colors = random.sample(LEGEND_COLORS, count)\n   187\t    return list(zip(holes, colors))\n   188\t\n   189\t\n   190\tdef _place_legend_line(\n   191\t    grid: np.ndarray, legends: list[tuple[int, int]], arrangement: str, r: int, c: int\n   192\t) -> None:\n   193\t    \"\"\"Paste legend patches sequentially along the arrangement axis.\"\"\"\n   194\t    rr, cc = int(r), int(c)\n   195\t    for hole_count, color in legends:\n   196\t        patch = _legend_patch(hole_count, color, arrangement)\n   197\t        paste(grid, patch, rr, cc)\n   198\t        if arrangement == \"horizontal\":\n   199\t            cc += patch.shape[1] + 1\n   200\t        else:\n   201\t            rr += patch.shape[0] + 1\n   202\t\n   203\t\n   204\t# ---------- layout helpers ----------\n   205\t\n   206\tdef _layout_full_horizontal(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:\n   207\t    \"\"\"Place a full-row horizontal divider with legend panel above or below.\"\"\"\n   208\t    legends = _choose_legends(\"horizontal\", FULL_LAYOUT_MAX_SPAN)\n   209\t    total = _line_span(legends)\n   210\t    panel_h = random.randint(*PANEL_SIZE_RANGE)\n   211\t    top = random.choice([True, False])\n   212\t    c0 = random.randint(1, GRID_SIZE - 1 - total)\n   213\t    if top:\n   214\t        div_r = panel_h\n   215\t        grid[div_r, :] = DIV\n   216\t        blocked[: div_r + 1, :] = 9\n   217\t        r0 = random.randint(1, panel_h - 4)\n   218\t    else:\n   219\t        div_r = GRID_SIZE - 1 - panel_h\n   220\t        grid[div_r, :] = DIV\n   221\t        blocked[div_r:, :] = 9\n   222\t        r0 = random.randint(div_r + 2, GRID_SIZE - 4)\n   223\t    _place_legend_line(grid, legends, \"horizontal\", r0, c0)\n   224\t    return legends\n   225\t\n   226\t\n   227\tdef _layout_full_vertical(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:\n   228\t    \"\"\"Place a full-column vertical divider with legend panel left or right.\"\"\"\n   229\t    legends = _choose_legends(\"vertical\", FULL_LAYOUT_MAX_SPAN)\n   230\t    total = _line_span(legends)\n   231\t    panel_w = random.randint(*PANEL_SIZE_RANGE)\n   232\t    left = random.choice([True, False])\n   233\t    r0 = random.randint(1, GRID_SIZE - 1 - total)\n   234\t    if left:\n   235\t        div_c = panel_w\n   236\t        grid[:, div_c] = DIV\n   237\t        blocked[:, : div_c + 1] = 9\n   238\t        c0 = random.randint(1, panel_w - 4)\n   239\t    else:\n   240\t        div_c = GRID_SIZE - 1 - panel_w\n   241\t        grid[:, div_c] = DIV\n   242\t        blocked[:, div_c:] = 9\n   243\t        c0 = random.randint(div_c + 2, GRID_SIZE - 4)\n   244\t    _place_legend_line(grid, legends, \"vertical\", r0, c0)\n   245\t    return legends\n   246\t\n   247\t\n   248\tdef _l_corner_geometry(corner: str, panel_h: int, panel_w: int,\n   249\t                       arrangement: str, total: int) -> tuple:\n   250\t    \"\"\"Compute divider pivot and legend placement bounds for an L-corner.\n   251\t\n   252\t    Returns (dr, dc, r_min, r_max, c_min, c_max) where (dr, dc) is the corner\n   253\t    pivot of the L-divider and the remaining values bound the legend origin.\n   254\t    \"\"\"\n   255\t    N = GRID_SIZE\n   256\t    cross_dim = 3 if arrangement == \"horizontal\" else total\n   257\t    along_dim = total if arrangement == \"horizontal\" else 3\n   258\t\n   259\t    if corner == \"tl\":\n   260\t        dr, dc = panel_h, panel_w\n","exit_code":0,"status":"completed"}}
