d regions per corner\n   296\t    N = GRID_SIZE\n   297\t    if corner == \"tl\":\n   298\t        grid[dr, : dc + 1] = DIV\n   299\t        grid[: dr + 1, dc] = DIV\n   300\t        blocked[:dr, :dc] = 9\n   301\t        blocked[dr, : dc + 1] = 9\n   302\t        blocked[: dr + 1, dc] = 9\n   303\t    elif corner == \"tr\":\n   304\t        grid[dr, dc:] = DIV\n   305\t        grid[: dr + 1, dc] = DIV\n   306\t        blocked[:dr, dc + 1:] = 9\n   307\t        blocked[dr, dc:] = 9\n   308\t        blocked[: dr + 1, dc] = 9\n   309\t    elif corner == \"bl\":\n   310\t        grid[dr, : dc + 1] = DIV\n   311\t        grid[dr:, dc] = DIV\n   312\t        blocked[dr + 1:, :dc] = 9\n   313\t        blocked[dr, : dc + 1] = 9\n   314\t        blocked[dr:, dc] = 9\n   315\t    else:  # br\n   316\t        grid[dr, dc:] = DIV\n   317\t        grid[dr:, dc] = DIV\n   318\t        blocked[dr + 1:, dc + 1:] = 9\n   319\t        blocked[dr, dc:] = 9\n   320\t        blocked[dr:, dc] = 9\n   321\t\n   322\t    r0 = random.randint(r_min, r_max)\n   323\t    c0 = random.randint(c_min, c_max)\n   324\t    _place_legend_line(grid, legends, arrangement, r0, c0)\n   325\t    return legends\n   326\t\n   327\t\n   328\tdef _add_layout(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:\n   329\t    \"\"\"Randomly choose and apply a divider layout (horizontal/vertical/L).\"\"\"\n   330\t    kind = random.choice([\"horizontal\", \"vertical\", \"l\"])\n   331\t    if kind == \"horizontal\":\n   332\t        return _layout_full_horizontal(grid, blocked)\n   333\t    if kind == \"vertical\":\n   334\t        return _layout_full_vertical(grid, blocked)\n   335\t    return _layout_l(grid, blocked)\n   336\t\n   337\t\n   338\t# ---------- sprite generation ----------\n   339\t\n   340\tdef _sprite_area(hole_count: int) -> int:\n   341\t    \"\"\"Sample a random sprite area based on hole count.\"\"\"\n   342\t    if hole_count == 0:\n   343\t        return random.randint(*SPRITE_AREA_0)\n   344\t    elif hole_count <= 2:\n   345\t        return random.randint(SPRITE_AREA_LOW_MIN, 25 + 10 * hole_count)\n   346\t    else:\n   347\t        return random.randint(10 + 2 * hole_count, 20 + 4 * hole_count)\n   348\t\n   349\t\n   350\tdef _place_hole_seeds(hole_count: int, center: int, csz: int, area: int) -> list[tuple[int, int]] | None:\n   351\t    \"\"\"Find well-separated seed positions for holes inside the canvas.\n   352\t\n   353\t    Returns a list of seed coordinates, or None if insufficient seeds found.\n   354\t    \"\"\"\n   355\t    margin = HOLE_SEED_MARGIN\n   356\t    radius = max(HOLE_SEED_MIN_RADIUS, int(HOLE_SEED_RADIUS_FACTOR * area ** 0.5))\n   357\t    positions = [(r, c) for r in range(center - radius, center + radius + 1)\n   358\t                 for c in range(center - radius, center + radius + 1)\n   359\t                 if margin <= r < csz - margin and margin <= c < csz - margin]\n   360\t    random.shuffle(positions)\n   361\t    seeds = []\n   362\t    for r, c in positions:\n   363\t        if all(max(abs(r - sr), abs(c - sc)) >= HOLE_SEED_MIN_SEP for sr, sc in seeds):\n   364\t            seeds.append((r, c))\n   365\t            if len(seeds) == hole_count:\n   366\t                return seeds\n   367\t    return None\n   368\t\n   369\t\n   370\tdef _grow_hole_blobs(seeds: list[tuple[int, int]], hole_count: int,\n   371\t                     area: int, csz: int) -> set[tuple[int, int]]:\n   372\t    \"\"\"Grow irregular blob regions around each hole seed. Returns the full forbidden set.\"\"\"\n   373\t    margin = HOLE_SEED_MARGIN\n   374\t    max_hole = (max(2, area // (hole_count + 2)) if hole_count <= 2\n   375\t                else max(1, area // (hole_count * 2 + 1)))\n   376\t    forbidden = set()\n   377\t    for sr, sc in seeds:\n   378\t        forbidden.add((sr, sc))\n   379\t        blob = {(sr, sc)}\n   380\t        target = random.randint(1, max(1, max_hole))\n   381\t        while len(blob) < target:\n   382\t            cands = []\n   383\t            for r, c in blob:\n   384\t                for nr, nc in neighbors4(r, c):\n   385\t                    if not (margin <= nr < csz - margin and margin <= nc < csz - margin):\n   386\t                        continue\n   387\t                    if (nr, nc) in forbidden:\n   388\t                        continue\n   389\t                    if any((nnr, nnc) in forbidden and (nnr, nnc) not in blob\n   390\t                           for nnr, nnc in neighbors4(nr, nc)):\n   391\t                        continue\n   392\t                    cands.append((nr, nc))\n   393\t            if not cands:\n   394\t                break\n   395\t            p = random.choice(cands)\n   396\t            forbidden.add(p)\n   397\t            blob.add(p)\n   398\t    return forbidden\n   399\t\n   400\t\n   401\tdef _find_start(center: int, csz: int, forbidden: set[tuple[int, int]]) -> tuple[int, int]:\n   402\t    \"\"\"Find the nearest non-forbidden cell to the canvas center.\"\"\"\n   403\t    if (center, center) not in forbidden:\n   404\t        return center, center\n   405\t    for d in range(1, csz):\n   406\t        for dr in range(-d, d + 1):\n   407\t            for dc in range(-d, d + 1):\n   408\t                nr, nc = center + dr, center + dc\n   409\t                if 0 <= nr < csz and 0 <= nc < csz and (nr, nc) not in forbidden:\n   410\t                    return nr, nc\n   411\t    return center, center  # fallback (shouldn't happen)\n   412\t\n   413\t\n   414\tdef _grow_mask(csz: int, area: int, start: tuple[int, int],\n   415\t               forbidden: set[tuple[int, int]]) -> np.ndarray:\n   416\t    \"\"\"Grow a random connected blob of target area, avoiding forbidden cells.\"\"\"\n   417\t    mask = np.zeros((csz, csz), dtype=bool)\n   418\t    sr, sc = start\n   419\t    mask[sr, sc] = True\n   420\t    frontier = list(neighbors4(sr, sc))\n   421\t    filled = 1\n   422\t    while filled < area and frontier:\n   423\t        idx = random.randrange(len(frontier))\n   424\t        frontier[idx], frontier[-1] = frontier[-1], frontier[idx]\n   425\t        r, c = frontier.pop()\n   426\t        if not (0 <= r < csz and 0 <= c < csz) or mask[r, c] or (r, c) in forbidden:\n   427\t            continue\n   428\t        mask[r, c] = True\n   429\t        filled += 1\n   430\t        for nr, nc in neighbors4(r, c):\n   431\t            if 0 <= nr < csz and 0 <= nc < csz and not mask[nr, nc]:\n   432\t                frontier.append((nr, nc))\n   433\t    return mask\n   434\t\n   435\t\n   436\tdef _seal_and_connect(mask: np.ndarray, forbidden: set[tuple[int, int]]) -> np.ndarray:\n   437\t    \"\"\"Seal gaps around forbidden cells and keep only the largest connected component.\"\"\"\n   438\t    csz = mask.shape[0]\n   439\t    for _ in range(SEAL_ITERS):\n   440\t        sealed = False\n   441\t        for r, c in sorted(forbidden):\n   442\t            for nr, nc in neighbors4(r, c):\n   443\t                if 0 <= nr < csz and 0 <= nc < csz and not mask[nr, nc] and (nr, nc) not in forbidden:\n   444\t                    mask[nr, nc] = True\n   445\t                    sealed = True\n   446\t        if not sealed:\n   447\t            break\n   448\t    if np.any(mask):\n   449\t        labeled, n_comp = label_mask(mask)\n   450\t        if n_comp > 1:\n   451\t            best = max(range(1, n_comp + 1), key=lambda l: int(np.sum(labeled == l)))\n   452\t            mask = labeled == best\n   453\t    return mask\n   454\t\n   455\t\n   456\tdef _crop_and_validate(mask: np.ndarray, forbidden: set[tuple[int, int]],\n   457\t                       hole_count: int) -> np.ndarray | None:\n   458\t    \"\"\"Crop mask to tight bbox (including forbidden cells), validate shape and holes.\"\"\"\n   459\t    pts = np.argwhere(mask)\n   460\t    if len(pts) == 0:\n   461\t        return None\n   462\t    rmin, cmin = pts.min(axis=0)\n   463\t    rmax, cmax = pts.max(axis=0)\n   464\t    for r, c in forbidden:\n   465\t        rmin, cmin = min(rmin, r), min(cmin, c)\n   466\t        rmax, cmax = max(rmax, r), max(cmax, c)\n   467\t    h, w = rmax - rmin + 1, cmax - cmin + 1\n   468\t    if h > SPRITE_MAX_H or w > SPRITE_MAX_W or max(h, w) > SPRITE_MAX_ASPECT * min(h, w):\n   469\t        return None\n   470\t    cropped = mask[rmin:rmax + 1, cmin:cmax + 1].copy()\n   471\t    if _hole_count(cropped) != hole_count:\n   472\t        return None\n   473\t    return np.where(cropped, GREY, BG).astype(int)\n   474\t\n   475\t\n   476\tdef _make_sprite(hole_count: int) -> np.ndarray | None:\n   477\t    \"\"\"Generate a random amorphous grey sprite with the specified number of holes.\"\"\"\n   478\t    for _ in range(SPRITE_RETRIES):\n   479\t        area = _sprite_area(hole_count)\n   480\t        csz = max(CANVAS_MIN, int(area ** 0.5 * CANVAS_SCALE) + CANVAS_PAD)\n   481\t        center = csz // 2\n   482\t\n   483\t        forbidden = set()\n   484\t        if hole_count > 0:\n   485\t            seeds = _place_hole_seeds(hole_count, center, csz, area)\n   486\t            if seeds is None:\n   487\t                continue\n   488\t            forbidden = _grow_hole_blobs(seeds, hole_count, area, csz)\n   489\t\n   490\t        start = _find_start(center, csz, forbidden)\n   491\t        mask = _grow_mask(csz, area, start, forbidden)\n   492\t        mask = _seal_and_connect(mask, forbidden)\n   493\t\n   494\t        result = _crop_and_validate(mask, forbidden, hole_count)\n   495\t        if result is not None:\n   496\t            return result\n   497\t    return None\n   498\t\n   499\t\n   500\t# ---------- sprite planning & placement ----------\n   501\t\n   502\tdef _sprite_plan(legends: list[tuple[int, int]]) -> list[tuple[int, int | None]]:\n   503\t    \"\"\"Build a shuffled list of (hole_count, color_or_None) for all sprites to generate.\"\"\"\n   504\t    total = random.randint(*TOTAL_SPRITES_RANGE)\n   505\t    remaining = total - len(legends)\n   506\t    max_d = min(MAX_DISTRACTORS, remaining)\n   507\t    valid_d = [d for d in range(1, max_d + 1)\n   508\t               if remaining - d <= MAX_EXTRA_PER_LEGEND * len(legends)]\n   509\t    n_distractors = random.choice(valid_d)\n   510\t    extra_matches = remaining - n_distractors\n   511\t    extras = [0] * len(legends)\n   512\t    for _ in range(extra_matches):\n   513\t        choices = [i for i, x in enumerate(extras) if x < MAX_EXTRA_PER_LEGEND]\n   514\t        extras[random.choice(choices)] += 1\n   515\t\n   516\t    plan = []\n   517\t    for i, (hole_count, color) in enumerate(legends):\n   518\t        for _ in range(1 + extras[i]):\n   519\t            plan.append((hole_count, color))\n   520\t    legend_holes = {h for h, _ in legends}\n","exit_code":0,"status":"completed"}}
