{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py | sed -n '1,240p'\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\tfrom collections import Counter, defaultdict\n     3\timport numpy as np\n     4\tfrom arc_utils import get_bg, in_bounds, neighbors4, label_mask\n     5\t\n     6\tdef main(grid: np.ndarray) -> np.ndarray:\n     7\t    \"\"\"\n     8\t    Connect framed squares via colored bridges following a control-pixel sequence.\n     9\t\n    10\t    Input structure:\n    11\t    - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.\n    12\t    - Control row below squares: colored pixels read left-to-right encode visitation order.\n    13\t\n    14\t    Rule:\n    15\t    - Start at the square matching first control color c0.\n    16\t    - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.\n    17\t    - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.\n    18\t\n    19\t    Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n    20\t    \"\"\"\n    21\t    g = np.array(grid, dtype=int)\n    22\t    H, W = g.shape\n    23\t    bg = int(get_bg(g))\n    24\t\n    25\t    # border color = most common non-bg color\n    26\t    cnt = Counter(map(int, g.flatten()))\n    27\t    border = None\n    28\t    for col, _k in cnt.most_common():\n    29\t        if int(col) != int(bg):\n    30\t            border = int(col)\n    31\t            break\n    32\t    assert not (border is None)\n    33\t\n    34\t    # detect framed squares as connected components of the border color\n    35\t    lab, n = label_mask(g == int(border), connectivity=4)\n    36\t    frames: list[dict] = []\n    37\t    for cid in range(1, int(n) + 1):\n    38\t        pts = np.argwhere(lab == int(cid))\n    39\t        if int(pts.shape[0]) < 8:\n    40\t            continue\n    41\t        r0, c0 = pts.min(axis=0)\n    42\t        r1, c1 = pts.max(axis=0)\n    43\t        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n    44\t        h = int(r1 - r0 + 1)\n    45\t        w = int(c1 - c0 + 1)\n    46\t        if h < 3 or w < 3:\n    47\t            continue\n    48\t\n    49\t        t = None\n    50\t        inner_col = None\n    51\t        for tt in range(1, int(min(h, w) // 2) + 1):\n    52\t            inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]\n    53\t            if inner.size == 0:\n    54\t                continue\n    55\t            if bool((inner == int(border)).any()):\n    56\t                continue\n    57\t            u = set(map(int, inner.flatten()))\n    58\t            if len(u) != 1:\n    59\t                continue\n    60\t\n    61\t            ok = True\n    62\t            if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):\n    63\t                ok = False\n    64\t            if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):\n    65\t                ok = False\n    66\t            if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):\n    67\t                ok = False\n    68\t            if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n    69\t                ok = False\n    70\t            if not ok:\n    71\t                continue\n    72\t\n    73\t            t = int(tt)\n    74\t            inner_col = int(next(iter(u)))\n    75\t            break\n    76\t\n    77\t        if t is None or inner_col is None:\n    78\t            continue\n    79\t\n    80\t        frames.append(\n    81\t            {\n    82\t                \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n    83\t                \"t\": int(t),\n    84\t                \"inner\": int(inner_col),\n    85\t                \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n    86\t            }\n    87\t        )\n    88\t\n    89\t    assert not (not frames)\n    90\t\n    91\t    by: dict[int, list[dict]] = defaultdict(list)\n    92\t    for f in frames:\n    93\t        by[int(f[\"inner\"])].append(f)\n    94\t\n    95\t    max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n    96\t\n    97\t    # control row = bottom-most row below the squares with >=2 non-bg pixels\n    98\t    ctrl_r = None\n    99\t    for r in range(int(H - 1), int(max_frame_r), -1):\n   100\t        if int((g[int(r)] != int(bg)).sum()) >= 2:\n   101\t            ctrl_r = int(r)\n   102\t            break\n   103\t    assert not (ctrl_r is None)\n   104\t\n   105\t    ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n   106\t    assert not (len(ctrl) < 2)\n   107\t\n   108\t    def center(f: dict) -> tuple[int, int]:\n   109\t        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n   110\t        return int((r0 + r1) // 2), int((c0 + c1) // 2)\n   111\t\n   112\t    def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n   113\t        a = f1[\"inner_bbox\"]\n   114\t        b = f2[\"inner_bbox\"]\n   115\t        same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n   116\t        same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))\n   117\t        return same_row, same_col\n   118\t\n   119\t    # choose start frame\n   120\t    start_color = int(ctrl[0])\n   121\t    assert not (start_color not in by)\n   122\t    start_cands = by[start_color]\n   123\t    if len(start_cands) == 1:\n   124\t        cur = start_cands[0]\n   125\t    else:\n   126\t        nxt_color = int(ctrl[1])\n   127\t        nxt_cands = by.get(nxt_color, [])\n   128\t        best = None\n   129\t        bestf = None\n   130\t        for f in start_cands:\n   131\t            for g2 in (nxt_cands if nxt_cands else [f]):\n   132\t                sr, sc = aligned(f, g2)\n   133\t                al = 1 if (sr or sc) else 0\n   134\t                (r1_, c1_) = center(f)\n   135\t                (r2_, c2_) = center(g2)\n   136\t                d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n   137\t                cand = (int(al), -int(d))\n   138\t                if best is None or cand > best:\n   139\t                    best = cand\n   140\t                    bestf = f\n   141\t        cur = bestf\n   142\t\n   143\t    out = g.copy()\n   144\t\n   145\t    def draw_bridge(fa: dict, fb: dict, color: int) -> None:\n   146\t        (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n   147\t        (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n   148\t        ia = fa[\"inner_bbox\"]\n   149\t        sr, sc = aligned(fa, fb)\n   150\t        if sr:\n   151\t            rr0, rr1 = int(ia[0]), int(ia[2])\n   152\t            if int(c1a) < int(c0b):\n   153\t                cc0, cc1 = int(c1a + 1), int(c0b - 1)\n   154\t            else:\n   155\t                cc0, cc1 = int(c1b + 1), int(c0a - 1)\n   156\t            for r in range(int(rr0), int(rr1) + 1):\n   157\t                for c in range(int(cc0), int(cc1) + 1):\n   158\t                    if 0 <= r < H and 0 <= c < W:\n   159\t                        out[int(r), int(c)] = int(color)\n   160\t            return\n   161\t        if sc:\n   162\t            cc0, cc1 = int(ia[1]), int(ia[3])\n   163\t            if int(r1a) < int(r0b):\n   164\t                rr0, rr1 = int(r1a + 1), int(r0b - 1)\n   165\t            else:\n   166\t                rr0, rr1 = int(r1b + 1), int(r0a - 1)\n   167\t            for r in range(int(rr0), int(rr1) + 1):\n   168\t                for c in range(int(cc0), int(cc1) + 1):\n   169\t                    if 0 <= r < H and 0 <= c < W:\n   170\t                        out[int(r), int(c)] = int(color)\n   171\t\n   172\t    for i in range(int(len(ctrl)) - 1):\n   173\t        a = int(ctrl[i])\n   174\t        b = int(ctrl[i + 1])\n   175\t        assert int(cur[\"inner\"]) == int(a)\n   176\t        assert b in by, f\"control color {b} has no matching frame\"\n   177\t        cands = by[b]\n   178\t        best = None\n   179\t        bestf = None\n   180\t        for f in cands:\n   181\t            sr, sc = aligned(cur, f)\n   182\t            al = 1 if (sr or sc) else 0\n   183\t            (r1_, c1_) = center(cur)\n   184\t            (r2_, c2_) = center(f)\n   185\t            d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n   186\t            cand = (int(al), -int(d))\n   187\t            if best is None or cand > best:\n   188\t                best = cand\n   189\t                bestf = f\n   190\t        nxt = bestf\n   191\t        draw_bridge(cur, nxt, int(a))\n   192\t        cur = nxt\n   193\t\n   194\t    return out\n   195\t\n   196\t\n   197\tdef _most_common_nonbg(g: np.ndarray, bg: int) -> int | None:\n   198\t    cnt = Counter(map(int, g.flatten()))\n   199\t    for col, _k in cnt.most_common():\n   200\t        if int(col) != int(bg):\n   201\t            return int(col)\n   202\t    return None\n   203\t\n   204\tdef _draw_frame(g: np.ndarray, *, r0: int, c0: int, outer: int, t: int, border: int, inner_col: int) -> None:\n   205\t    g[int(r0) : int(r0 + outer), int(c0) : int(c0 + outer)] = int(border)\n   206\t    g[int(r0 + t) : int(r0 + outer - t), int(c0 + t) : int(c0 + outer - t)] = int(inner_col)\n   207\t\n   208\tdef _bridge_cells(fa: dict, fb: dict) -> set[tuple[int, int]]:\n   209\t    (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n   210\t    (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n   211\t    ia = fa[\"inner_bbox\"]\n   212\t    ib = fb[\"inner_bbox\"]\n   213\t    # same-row band\n   214\t    if int(ia[0]) == int(ib[0]) and int(ia[2]) == int(ib[2]):\n   215\t        rr0, rr1 = int(ia[0]), int(ia[2])\n   216\t        if int(c1a) < int(c0b):\n   217\t            cc0, cc1 = int(c1a + 1), int(c0b - 1)\n   218\t        else:\n   219\t            cc0, cc1 = int(c1b + 1), int(c0a - 1)\n   220\t        assert int(cc0) <= int(cc1), \"horizontal bridge gap must be non-empty\"\n   221\t        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n   222\t    # same-col band\n   223\t    if int(ia[1]) == int(ib[1]) and int(ia[3]) == int(ib[3]):\n   224\t        cc0, cc1 = int(ia[1]), int(ia[3])\n   225\t        if int(r1a) < int(r0b):\n   226\t            rr0, rr1 = int(r1a + 1), int(r0b - 1)\n   227\t        else:\n   228\t            rr0, rr1 = int(r1b + 1), int(r0a - 1)\n   229\t        assert int(rr0) <= int(rr1), \"vertical bridge gap must be non-empty\"\n   230\t        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n   231\t    return set()\n   232\t\n   233\t_DIGITS = [int(i) for i in range(10)]\n   234\t\n   235\tdef _gen_attempt() -> np.ndarray | None:\n   236\t    # --- colors ---\n   237\t    bg = int(np.random.choice(np.array(_DIGITS, dtype=int)))\n   238\t    border = int(np.random.choice(np.array([d for d in _DIGITS if int(d) != int(bg)], dtype=int)))\n   239\t    inner_palette = [int(d) for d in _DIGITS if int(d) not in (int(bg), int(border))]\n   240\t    if len(inner_palette) < 3:\n","exit_code":0,"status":"completed"}}
