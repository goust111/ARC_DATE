{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py | sed -n '240,520p'\"","aggregated_output":"   240\t# ---------------------------------------------------------------------------\n   241\t# Line growth\n   242\t# ---------------------------------------------------------------------------\n   243\t\n   244\tdef _grow_line(grid, start, line_col, target_len, rng):\n   245\t    \"\"\"Grow a meandering 8-connected 1px-wide path of line_col from start.\"\"\"\n   246\t    h, w = grid.shape\n   247\t    path = [start]\n   248\t    dr_bias = 1 if start[0] < h // 2 else -1\n   249\t    dc_bias = 1 if start[1] < w // 2 else -1\n   250\t    cur = start\n   251\t    path_set = {start}\n   252\t    while len(path) < target_len:\n   253\t        # Build weighted direction list: diagonals preferred, bias-aligned boosted\n   254\t        dirs = []\n   255\t        for ddr, ddc in DIAG_DIRS:\n   256\t            aligned = (ddr == dr_bias or ddc == dc_bias)\n   257\t            w_d = DIAG_WEIGHT_ALIGNED if aligned else DIAG_WEIGHT_OTHER\n   258\t            dirs.extend([(ddr, ddc)] * w_d)\n   259\t        for ddr, ddc in ORTHO_DIRS:\n   260\t            aligned = (ddr == dr_bias and ddc == 0) or (ddc == dc_bias and ddr == 0)\n   261\t            w_d = ORTHO_WEIGHT_ALIGNED if aligned else ORTHO_WEIGHT_OTHER\n   262\t            dirs.extend([(ddr, ddc)] * w_d)\n   263\t        rng.shuffle(dirs)\n   264\t        placed = False\n   265\t        for ddr, ddc in dirs:\n   266\t            nr, nc = cur[0] + ddr, cur[1] + ddc\n   267\t            if not _in_bounds(h, w, nr, nc) or grid[nr, nc] != -1:\n   268\t                continue\n   269\t            # Keep path thin: reject if 8-adjacent to existing path (except cur)\n   270\t            if any((nnr, nnc) != cur and (nnr, nnc) in path_set\n   271\t                   for nnr, nnc in neighbors8(nr, nc)):\n   272\t                continue\n   273\t            # Strongly avoid grid border\n   274\t            if (nr == 0 or nc == 0 or nr == h - 1 or nc == w - 1) and rng.random() < BORDER_AVOIDANCE_PROB:\n   275\t                continue\n   276\t            cur = (nr, nc)\n   277\t            path.append(cur)\n   278\t            path_set.add(cur)\n   279\t            grid[nr, nc] = line_col\n   280\t            placed = True\n   281\t            break\n   282\t        if not placed:\n   283\t            if rng.random() < BIAS_FLIP_PROB:\n   284\t                dr_bias *= -1\n   285\t            if rng.random() < BIAS_FLIP_PROB:\n   286\t                dc_bias *= -1\n   287\t            break\n   288\t    return path\n   289\t\n   290\t\n   291\t# ---------------------------------------------------------------------------\n   292\t# Frame attachment\n   293\t# ---------------------------------------------------------------------------\n   294\t\n   295\tdef _halo_offsets(fh, fw):\n   296\t    \"\"\"Compute offsets around a frame bbox that lie outside it (the halo).\"\"\"\n   297\t    return [(dr, dc) for dr in range(-1, fh + 1) for dc in range(-1, fw + 1)\n   298\t            if not (0 <= dr < fh and 0 <= dc < fw)]\n   299\t\n   300\t\n   301\tdef _try_attach_frame(canvas, line_path, line_col, frame_col, rng, max_tries=FRAME_ATTACH_TRIES):\n   302\t    \"\"\"Try to place a frame loop 8-adjacent to some line pixel.\n   303\t\n   304\t    canvas is modified in place; returns (ring, cavity) or None on failure.\n   305\t    \"\"\"\n   306\t    h, w = canvas.shape\n   307\t    pad = FRAME_PLACEMENT_PAD\n   308\t    for _ in range(max_tries):\n   309\t        ch = rng.choice(CAVITY_SIZE_WEIGHTS)\n   310\t        cw = rng.choice(CAVITY_SIZE_WEIGHTS)\n   311\t        lp = rng.choice(line_path)\n   312\t        fh, fw = ch + 2, cw + 2\n   313\t        offsets = _halo_offsets(fh, fw)\n   314\t        rng.shuffle(offsets)\n   315\t        for dr, dc in offsets:\n   316\t            r0 = lp[0] - dr\n   317\t            c0 = lp[1] - dc\n   318\t            if r0 < pad or c0 < pad or r0 + fh > h - pad or c0 + fw > w - pad:\n   319\t                continue\n   320\t            ring, cavity = _frame_ring_coords(r0, c0, ch, cw)\n   321\t            if not _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n   322\t                continue\n   323\t            for rr, cc in ring:\n   324\t                canvas[rr, cc] = frame_col\n   325\t            return ring, cavity\n   326\t    return None\n   327\t\n   328\t\n   329\tdef _try_attach_distractor_frame(canvas, frame_col, rng, max_tries=DISTRACTOR_FRAME_TRIES):\n   330\t    \"\"\"Place a loop in empty space, not touching any non-bg pixel.\"\"\"\n   331\t    h, w = canvas.shape\n   332\t    for _ in range(max_tries):\n   333\t        ch = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\n   334\t        cw = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\n   335\t        fh, fw = ch + 2, cw + 2\n   336\t        r0 = rng.randint(1, h - fh - 1)\n   337\t        c0 = rng.randint(1, w - fw - 1)\n   338\t        # Check the full bbox + 1-cell margin is empty\n   339\t        ok = True\n   340\t        for rr in range(r0 - 1, r0 + fh + 1):\n   341\t            for cc in range(c0 - 1, c0 + fw + 1):\n   342\t                if _in_bounds(h, w, rr, cc) and canvas[rr, cc] != -1:\n   343\t                    ok = False\n   344\t                    break\n   345\t            if not ok:\n   346\t                break\n   347\t        if not ok:\n   348\t            continue\n   349\t        ring, _ = _frame_ring_coords(r0, c0, ch, cw)\n   350\t        for rr, cc in ring:\n   351\t            canvas[rr, cc] = frame_col\n   352\t        return True\n   353\t    return None\n   354\t\n   355\t\n   356\tdef _try_place_distractor_network(canvas, line_col, frame_colors_pool, rng):\n   357\t    \"\"\"Place a disconnected line+frame distractor (no seed).\"\"\"\n   358\t    h, w = canvas.shape\n   359\t    for _ in range(DISTRACTOR_NETWORK_TRIES):\n   360\t        r = rng.randint(2, h - 3)\n   361\t        c = rng.randint(2, w - 3)\n   362\t        if any(canvas[r + dr, c + dc] != -1 for dr in range(-1, 2) for dc in range(-1, 2)):\n   363\t            continue\n   364\t        canvas[r, c] = line_col\n   365\t        target_len = rng.randint(*DISTRACTOR_LINE_LEN)\n   366\t        path = _grow_line(canvas, (r, c), line_col, target_len, rng)\n   367\t        if len(path) < 3:\n   368\t            for pr, pc in path:\n   369\t                canvas[pr, pc] = -1\n   370\t            continue\n   371\t        attached = 0\n   372\t        for _ in range(rng.randint(*DISTRACTOR_NETWORK_FRAMES)):\n   373\t            fc = rng.choice(frame_colors_pool)\n   374\t            if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\n   375\t                attached += 1\n   376\t        if attached > 0:\n   377\t            return True\n   378\t        for pr, pc in path:\n   379\t            canvas[pr, pc] = -1\n   380\t    return False\n   381\t\n   382\t\n   383\t# ---------------------------------------------------------------------------\n   384\t# Main generator\n   385\t# ---------------------------------------------------------------------------\n   386\t\n   387\tdef _corner_config(corner_kind, h, w, rng):\n   388\t    \"\"\"Return (seed_rc, first_line_rc) for corner_kind in {TL,TR,BL,BR}.\"\"\"\n   389\t    if corner_kind == 'TL':\n   390\t        seed = (0, 0)\n   391\t        first = rng.choice([(0, 1), (1, 0)])\n   392\t    elif corner_kind == 'TR':\n   393\t        seed = (0, w - 1)\n   394\t        first = rng.choice([(0, w - 2), (1, w - 1)])\n   395\t    elif corner_kind == 'BL':\n   396\t        seed = (h - 1, 0)\n   397\t        first = rng.choice([(h - 1, 1), (h - 2, 0)])\n   398\t    elif corner_kind == 'BR':\n   399\t        seed = (h - 1, w - 1)\n   400\t        first = rng.choice([(h - 1, w - 2), (h - 2, w - 1)])\n   401\t    else:\n   402\t        raise ValueError(corner_kind)\n   403\t    return seed, first\n   404\t\n   405\t\n   406\tdef _distribute_loop_budget(num_seeds, num_attached_target, rng):\n   407\t    \"\"\"Distribute attached-loop budget across seeds, guaranteeing >= 1 each.\"\"\"\n   408\t    seed_order = list(range(num_seeds))\n   409\t    rng.shuffle(seed_order)\n   410\t    per_seed = [0] * num_seeds\n   411\t    remaining = num_attached_target\n   412\t    # Guarantee at least 1 per seed\n   413\t    while remaining > 0 and any(per_seed[i] == 0 for i in range(num_seeds)):\n   414\t        for i in seed_order:\n   415\t            if per_seed[i] == 0 and remaining > 0:\n   416\t                per_seed[i] += 1\n   417\t                remaining -= 1\n   418\t    # Distribute remainder randomly\n   419\t    while remaining > 0:\n   420\t        per_seed[rng.choice(seed_order)] += 1\n   421\t        remaining -= 1\n   422\t    return per_seed\n   423\t\n   424\t\n   425\tdef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n   426\t    h = rng.randint(*GRID_H_RANGE)\n   427\t    w = rng.randint(*GRID_W_RANGE)\n   428\t    bg = rng.choice(BG_COLORS)\n   429\t    palette = [c for c in range(10) if c != bg]\n   430\t    rng.shuffle(palette)\n   431\t\n   432\t    num_seeds = rng.choice(SEED_COUNT_WEIGHTS)\n   433\t    if num_seeds * 2 > len(palette):\n   434\t        return None\n   435\t\n   436\t    canvas = -np.ones((h, w), dtype=int)\n   437\t\n   438\t    seed_colors = [palette.pop() for _ in range(num_seeds)]\n   439\t    line_colors = [palette.pop() for _ in range(num_seeds)]\n   440\t\n   441\t    all_corners = ['TL', 'TR', 'BL', 'BR']\n   442\t    rng.shuffle(all_corners)\n   443\t    corners_used = all_corners[:num_seeds]\n   444\t\n   445\t    num_frame_cols = rng.randint(1, min(FRAME_COLORS_MAX, len(palette)))\n   446\t    frame_colors_pool = [palette.pop() for _ in range(num_frame_cols)]\n   447\t\n   448\t    # Grow seed lines\n   449\t    lines_info = []\n   450\t    for i in range(num_seeds):\n   451\t        seed_rc, first_rc = _corner_config(corners_used[i], h, w, rng)\n   452\t        if canvas[seed_rc] != -1 or canvas[first_rc] != -1:\n   453\t            return None\n   454\t        canvas[seed_rc] = seed_colors[i]\n   455\t        canvas[first_rc] = line_colors[i]\n   456\t        target_len = rng.randint(LINE_LEN_RANGE[0], min(LINE_LEN_RANGE[1], h + w))\n   457\t        path = _grow_line(canvas, first_rc, line_colors[i], target_len, rng)\n   458\t        if len(path) < MIN_LINE_LEN:\n   459\t            return None\n   460\t        lines_info.append((seed_colors[i], seed_rc, line_colors[i], path))\n   461\t\n   462\t    # Decide loop counts and distribute across seeds\n   463\t    total_loops_target = rng.randint(num_seeds, TOTAL_LOOPS_MAX)\n   464\t    num_distractors_target = rng.randint(0, max(0, total_loops_target - num_seeds))\n   465\t    num_attached_target = total_loops_target - num_distractors_target\n   466\t    per_seed = _distribute_loop_budget(num_seeds, num_attached_target, rng)\n   467\t\n   468\t    # Attach frames to each seed's line\n   469\t    for i, (_, _, line_col, path) in enumerate(lines_info):\n   470\t        attached = 0\n   471\t        for _ in range(per_seed[i]):\n   472\t            fc = rng.choice(frame_colors_pool)\n   473\t            if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\n   474\t                attached += 1\n   475\t        if attached == 0:\n   476\t            return None\n   477\t\n   478\t    # Place distractors\n   479\t    if rng.random() < DISTRACTOR_NETWORK_PROB:\n   480\t        _try_place_distractor_network(canvas, rng.choice(line_colors), frame_colors_pool, rng)\n   481\t    else:\n   482\t        for _ in range(rng.randint(0, DISTRACTOR_SOLO_MAX)):\n   483\t            _try_attach_distractor_frame(canvas, rng.choice(frame_colors_pool), rng)\n   484\t\n   485\t    # Finalize grid\n   486\t    grid = np.where(canvas == -1, bg, canvas).astype(int)\n   487\t\n   488\t    # Validate bg is most common color\n   489\t    vals, cnts = np.unique(grid, return_counts=True)\n   490\t    if int(vals[np.argmax(cnts)]) != bg:\n   491\t        return None\n   492\t\n   493\t    # Validate each seed color appears exactly once\n   494\t    for seed_col, _, _, _ in lines_info:\n   495\t        if int((grid == seed_col).sum()) != 1:\n   496\t            return None\n   497\t\n   498\t    # Oracle check: solver must change at least one cell\n   499\t    try:\n   500\t        out = main(grid)\n   501\t    except Exception:\n   502\t        return None\n   503\t    if np.array_equal(out, grid):\n   504\t        return None\n   505\t    return grid\n   506\t\n   507\t\n   508\tdef generate_input() -> np.ndarray:\n   509\t    rng = random.Random()\n   510\t    for _ in range(GEN_RETRIES):\n   511\t        g = _gen_attempt(rng)\n   512\t        if g is not None:\n   513\t            return g\n   514\t    raise RuntimeError(\"generate_input: exhausted attempts\")\n","exit_code":0,"status":"completed"}}
