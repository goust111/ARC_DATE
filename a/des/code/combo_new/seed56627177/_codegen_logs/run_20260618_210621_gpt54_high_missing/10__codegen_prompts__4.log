1 + 1, sc0 : sc1 + 1] = True\n   283\t    keep[dr0 : dr1 + 1, dc0 : dc1 + 1] = True\n   284\t    keep[sr0 : sr1 + 1, sc1 + CONTROL_OFFSETS[0]] = True\n   285\t    keep[sr0 : sr1 + 1, sc1 + CONTROL_OFFSETS[1]] = True\n   286\t    keep[sr1 + CONTROL_OFFSETS[0], sc0 : sc1 + 1] = True\n   287\t    keep[sr1 + CONTROL_OFFSETS[1], sc0 : sc1 + 1] = True\n   288\t\n   289\t    inp = np.full_like(out, int(bg))\n   290\t    inp[keep] = out[keep]\n   291\t    return inp\n   292\t\n   293\t\n   294\tdef _gen_attempt() -> np.ndarray | None:\n   295\t    bg = int(np.random.randint(COLOR_COUNT))\n   296\t    palette = [color for color in range(COLOR_COUNT) if color != bg]\n   297\t    anchor_color, right1, right2, below1 = map(\n   298\t        int, np.random.choice(palette, NON_BG_COLOR_COUNT, replace=False)\n   299\t    )\n   300\t\n   301\t    s = int(np.random.randint(ANCHOR_SIZE_RANGE[0], ANCHOR_SIZE_RANGE[1]))\n   302\t    nh = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))\n   303\t    nv = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))\n   304\t    struct_h = 2 * s + FRAME_PERIOD * nv + STRUCTURE_FIXED_PAD\n   305\t    struct_w = 2 * s + FRAME_PERIOD * nh + STRUCTURE_FIXED_PAD\n   306\t\n   307\t    top, bottom = _choose_margins(struct_h)\n   308\t    left, right = _choose_margins(struct_w)\n   309\t    rows, cols = struct_h + top + bottom, struct_w + left + right\n   310\t    sr0, sc0 = top + SOURCE_OUTER_MARGIN, left + SOURCE_OUTER_MARGIN\n   311\t\n   312\t    out, box = _build_output(\n   313\t        rows,\n   314\t        cols,\n   315\t        bg,\n   316\t        anchor_color,\n   317\t        right1,\n   318\t        right2,\n   319\t        below1,\n   320\t        sr0,\n   321\t        sc0,\n   322\t        s,\n   323\t        nh,\n   324\t        nv,\n   325\t    )\n   326\t    inp = _derive_input(out, bg, *box)\n   327\t\n   328\t    try:\n   329\t        if np.array_equal(main(inp), out):\n   330\t            return inp\n   331\t    except Exception:\n   332\t        return None\n   333\t    return None\n   334\t\n   335\t\n   336\tdef generate_input() -> np.ndarray:\n   337\t    for _ in range(MAX_GENERATION_ATTEMPTS):\n   338\t        grid = _gen_attempt()\n   339\t        if grid is not None:\n   340\t            return grid\n   341\t    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
