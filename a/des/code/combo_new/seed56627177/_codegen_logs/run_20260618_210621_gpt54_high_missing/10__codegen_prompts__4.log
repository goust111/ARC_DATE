    return [1]\n   283\t    first = 1\n   284\t    last = G - n - 1\n   285\t    if last < first:\n   286\t        return None\n   287\t    step = (last - first) / (num_coarse - 1)\n   288\t    return [int(round(first + i * step)) for i in range(num_coarse)]\n   289\t\n   290\t\n   291\tdef _gen_attempt():\n   292\t    reached = random.random() < 0.5\n   293\t    n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])\n   294\t\n   295\t    min_size = max(10, 5 * n)\n   296\t    if min_size > 20:\n   297\t        return None\n   298\t    G = random.randint(min_size, 20)\n   299\t    H = W = G\n   300\t\n   301\t    min_spacing = n + 1\n   302\t    max_coarse = max(3, (G - 2) // min_spacing)\n   303\t    coarse_dim = random.randint(3, min(6, max_coarse))\n   304\t    coarse_rows = coarse_cols = coarse_dim\n   305\t\n   306\t    offsets_r = _compute_offsets(G, n, coarse_rows)\n   307\t    offsets_c = _compute_offsets(G, n, coarse_cols)\n   308\t    if offsets_r is None or offsets_c is None:\n   309\t        return None\n   310\t    for i in range(len(offsets_r) - 1):\n   311\t        if offsets_r[i + 1] - offsets_r[i] < n:\n   312\t            return None\n   313\t    for i in range(len(offsets_c) - 1):\n   314\t        if offsets_c[i + 1] - offsets_c[i] < n:\n   315\t            return None\n   316\t\n   317\t    edge_cells = set()\n   318\t    for c in range(coarse_cols):\n   319\t        edge_cells.add((0, c))\n   320\t        edge_cells.add((coarse_rows - 1, c))\n   321\t    for r in range(1, coarse_rows - 1):\n   322\t        edge_cells.add((r, 0))\n   323\t        edge_cells.add((r, coarse_cols - 1))\n   324\t    edge_cells = list(edge_cells)\n   325\t    random.shuffle(edge_cells)\n   326\t    start_coarse = edge_cells[0]\n   327\t    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))\n   328\t    end_coarse = far[0] if far[0] != start_coarse else far[1]\n   329\t\n   330\t    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)\n   331\t    if walk is None or len(walk) < 4:\n   332\t        return None\n   333\t    if len(set(cr for cr, _ in walk)) < coarse_rows or len(set(cc for _, cc in walk)) < coarse_cols:\n   334\t        return None\n   335\t\n   336\t    grid = np.full((H, W), _BG, dtype=int)\n   337\t    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)\n   338\t\n   339\t    mask = (grid != _BG)\n   340\t    if np.any(mask, axis=1).sum() / H < 0.70 or np.any(mask, axis=0).sum() / W < 0.70:\n   341\t        return None\n   342\t\n   343\t    mover_r, mover_c = pixel_pos[0]\n   344\t    dest_r, dest_c = pixel_pos[-1]\n   345\t\n   346\t    # Extend dest to touch grid edge\n   347\t    def _extend_to_edge(pr, pc):\n   348\t        candidates = []\n   349\t        for direction in ['top', 'bottom', 'left', 'right']:\n   350\t            if direction == 'top':\n   351\t                dist = pr\n   352\t                if dist == 0:\n   353\t                    candidates.append((0, pc, 0))\n   354\t                    continue\n   355\t                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n) if c < W):\n   356\t                    candidates.append((0, pc, dist))\n   357\t            elif direction == 'bottom':\n   358\t                dist = H - (pr + n)\n   359\t                if dist == 0:\n   360\t                    candidates.append((pr, pc, 0))\n   361\t                    continue\n   362\t                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n) if c < W):\n   363\t                    candidates.append((H - n, pc, dist))\n   364\t            elif direction == 'left':\n   365\t                dist = pc\n   366\t                if dist == 0:\n   367\t                    candidates.append((pr, 0, 0))\n   368\t                    continue\n   369\t                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc) if r < H):\n   370\t                    candidates.append((pr, 0, dist))\n   371\t            elif direction == 'right':\n   372\t                dist = W - (pc + n)\n   373\t                if dist == 0:\n   374\t                    candidates.append((pr, pc, 0))\n   375\t                    continue\n   376\t                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W) if r < H):\n   377\t                    candidates.append((pr, W - n, dist))\n   378\t        if not candidates:\n   379\t            return None\n   380\t        candidates.sort(key=lambda x: x[2])\n   381\t        return candidates[0][:2]\n   382\t\n   383\t    result = _extend_to_edge(dest_r, dest_c)\n   384\t    if result is None:\n   385\t        return None\n   386\t    new_dest_r, new_dest_c = result\n   387\t    if new_dest_r != dest_r:\n   388\t        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n\n   389\t        grid[r_lo:r_hi, dest_c:dest_c + n] = _RIVER\n   390\t    if new_dest_c != dest_c:\n   391\t        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n\n   392\t        grid[dest_r:dest_r + n, c_lo:c_hi] = _RIVER\n   393\t    dest_r, dest_c = new_dest_r, new_dest_c\n   394\t    if not (dest_r == 0 or dest_r + n == H or dest_c == 0 or dest_c + n == W):\n   395\t        return None\n   396\t\n   397\t    # Mover: near edge but not touching\n   398\t    touching = (mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W)\n   399\t    if touching:\n   400\t        if mover_r == 0:\n   401\t            grid[0, mover_c:mover_c + n] = _RIVER; mover_r = 1\n   402\t        elif mover_r + n == H:\n   403\t            grid[H - 1, mover_c:mover_c + n] = _RIVER; mover_r = H - n - 1\n   404\t        elif mover_c == 0:\n   405\t            grid[mover_r:mover_r + n, 0] = _RIVER; mover_c = 1\n   406\t        elif mover_c + n == W:\n   407\t            grid[mover_r:mover_r + n, W - 1] = _RIVER; mover_c = W - n - 1\n   408\t    if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:\n   409\t        return None\n   410\t    if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:\n   411\t        return None\n   412\t\n   413\t    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\n   414\t    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _RIVER\n   415\t\n   416\t    # Chokepoints for stuck case\n   417\t    if not reached and n >= 2:\n   418\t        num_choke = random.randint(1, min(3, len(walk) - 2))\n   419\t        min_seg = max(1, len(walk) // 4)\n   420\t        available = list(range(min_seg, len(walk) - 1))\n   421\t        random.shuffle(available)\n   422\t        for seg_idx in available[:num_choke]:\n   423\t            pr1, pc1 = pixel_pos[seg_idx]\n   424\t            pr2, pc2 = pixel_pos[min(seg_idx + 1, len(pixel_pos) - 1)]\n   425\t            direction = 'h' if pr1 == pr2 else 'v'\n   426\t            _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)\n   427\t        if not _river_connected(grid):\n   428\t            return None\n   429\t\n   430\t    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _MOVER\n   431\t    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _DEST\n   432\t\n   433\t    trav = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)\n   434\t    h2, w2 = H - n + 1, W - n + 1\n   435\t    feasible = np.zeros((h2, w2), dtype=bool)\n   436\t    for r in range(h2):\n   437\t        for c in range(w2):\n   438\t            if trav[r:r + n, c:c + n].all():\n   439\t                feasible[r, c] = True\n   440\t    if not feasible[mover_r, mover_c]:\n   441\t        return None\n   442\t\n   443\t    dist = _bfs_placement(feasible, mover_r, mover_c)\n   444\t    dest_ok = (0 <= dest_r < h2 and 0 <= dest_c < w2 and\n   445\t               feasible[dest_r, dest_c] and dist[dest_r, dest_c] >= 0)\n   446\t    if reached and not dest_ok:\n   447\t        return None\n   448\t    if not reached and dest_ok:\n   449\t        return None\n   450\t\n   451\t    if dest_ok:\n   452\t        tr, tc = dest_r, dest_c\n   453\t    else:\n   454\t        best_d = -1\n   455\t        tr, tc = mover_r, mover_c\n   456\t        for r in range(h2):\n   457\t            for c in range(w2):\n   458\t                if dist[r, c] > best_d:\n   459\t                    best_d = dist[r, c]\n   460\t                    tr, tc = r, c\n   461\t\n   462\t    output = grid.copy()\n   463\t    output[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\n   464\t    output[tr:tr + n, tc:tc + n] = _MOVER\n   465\t\n   466\t    if not np.array_equal(main(grid), output):\n   467\t        return None\n   468\t    return grid\n   469\t\n   470\t\n   471\tdef generate_input():\n   472\t    for _ in range(300):\n   473\t        result = _gen_attempt()\n   474\t        if result is not None:\n   475\t            return result\n   476\t    raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n   477\t\n   478\t\n","exit_code":0,"status":"completed"}}
