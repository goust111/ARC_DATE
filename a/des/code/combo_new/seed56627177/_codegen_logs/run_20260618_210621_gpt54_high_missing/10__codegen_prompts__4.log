{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py | sed -n '1,240p'\"","aggregated_output":"     1\timport numpy as np\n     2\t\n     3\tfrom arc_utils import bbox_coords, components_mask, get_bg, neighbors4\n     4\t\n     5\t\n     6\tdef _legend_directions(g: np.ndarray, bg: int) -> dict[int, tuple[int, int]]:\n     7\t    \"\"\"\n     8\t    Detect legend blocks on the border.\n     9\t\n    10\t    A legend is a border-touching non-background component whose most common color is the legend\n    11\t    background `C` (and also the region border color it controls). The legend contains at least\n    12\t    two additional colors: a \"center\" color (more frequent) and an \"indicator\" color (less frequent).\n    13\t\n    14\t    The movement direction for regions with border color `C` is:\n    15\t      sign(centroid(indicator) - centroid(center))\n    16\t    \"\"\"\n    17\t    h, w = g.shape\n    18\t    non_bg = g != bg\n    19\t    best: dict[int, tuple[int, tuple[int, int]]] = {}\n    20\t    for pts in components_mask(non_bg, connectivity=4):\n    21\t        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n    22\t            continue\n    23\t        # Legends are filled rectangles on the border.\n    24\t        r0, c0, r1, c1 = bbox_coords(pts)\n    25\t        area = (r1 - r0 + 1) * (c1 - c0 + 1)\n    26\t        if area != len(pts):\n    27\t            continue\n    28\t\n    29\t        counts: dict[int, int] = {}\n    30\t        for r, c in pts:\n    31\t            v = int(g[r, c])\n    32\t            counts[v] = counts.get(v, 0) + 1\n    33\t        if len(counts) != 3:\n    34\t            continue\n    35\t\n    36\t        bg_col = max(counts, key=counts.get)\n    37\t        others = [(cnt, col) for col, cnt in counts.items() if col != bg_col]\n    38\t        if len(others) < 2:\n    39\t            continue\n    40\t        others.sort()  # ascending by count\n    41\t        if others[0][0] == others[1][0]:\n    42\t            # Tie: choose center as the color closer to the rectangle center.\n    43\t            rc = np.array([(r0 + r1) / 2.0, (c0 + c1) / 2.0])\n    44\t            cols = [others[0][1], others[1][1]]\n    45\t            cents = []\n    46\t            for col in cols:\n    47\t                pts_col = np.array([(r, c) for r, c in pts if int(g[r, c]) == col], dtype=float)\n    48\t                cents.append((np.sum((pts_col.mean(axis=0) - rc) ** 2), col))\n    49\t            cents.sort()\n    50\t            center_col = cents[0][1]\n    51\t            indicator_col = cents[1][1]\n    52\t        else:\n    53\t            indicator_col = others[0][1]\n    54\t            center_col = others[-1][1]\n    55\t\n    56\t        center = [(r, c) for r, c in pts if int(g[r, c]) == center_col]\n    57\t        indic = [(r, c) for r, c in pts if int(g[r, c]) == indicator_col]\n    58\t        if not center or not indic:\n    59\t            continue\n    60\t\n    61\t        cc = np.mean(np.array(center, dtype=float), axis=0)\n    62\t        ci = np.mean(np.array(indic, dtype=float), axis=0)\n    63\t        vr, vc = (ci - cc).tolist()\n    64\t        dr = 0 if abs(vr) < 1e-6 else (1 if vr > 0 else -1)\n    65\t        dc = 0 if abs(vc) < 1e-6 else (1 if vc > 0 else -1)\n    66\t        if dr == 0 and dc == 0:\n    67\t            continue\n    68\t\n    69\t        prev = best.get(bg_col)\n    70\t        if prev is None or len(pts) > prev[0]:\n    71\t            best[bg_col] = (len(pts), (dr, dc))\n    72\t\n    73\t    return {k: v for k, (_, v) in best.items()}\n    74\t\n    75\t\n    76\tdef _slide_points(region_set: set[tuple[int, int]], points: list[tuple[int, int]], dr: int, dc: int) -> list[tuple[int, int]]:\n    77\t    if not points:\n    78\t        return []\n    79\t    # Process from the far end (closest to destination boundary) inward.\n    80\t    points_sorted = sorted(points, key=lambda p: (dr * p[0] + dc * p[1], p[0], p[1]), reverse=True)\n    81\t    occupied = set()\n    82\t    out_pts = []\n    83\t    for r0, c0 in points_sorted:\n    84\t        r, c = r0, c0\n    85\t        while True:\n    86\t            nr, nc = r + dr, c + dc\n    87\t            if (nr, nc) not in region_set:\n    88\t                break\n    89\t            # For diagonal steps, disallow \"corner cutting\": both orthogonal intermediates must be inside the region.\n    90\t            if dr != 0 and dc != 0:\n    91\t                if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n    92\t                    break\n    93\t            if (nr, nc) in occupied:\n    94\t                break\n    95\t            r, c = nr, nc\n    96\t        occupied.add((r, c))\n    97\t        out_pts.append((r, c))\n    98\t    return out_pts\n    99\t\n   100\t\n   101\tdef main(grid: np.ndarray) -> np.ndarray:\n   102\t    \"\"\"\n   103\t    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n   104\t\n   105\t    Input structure:\n   106\t    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n   107\t    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n   108\t\n   109\t    Rule:\n   110\t    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n   111\t    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n   112\t    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n   113\t\n   114\t    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n   115\t    \"\"\"\n   116\t    g = np.asarray(grid, dtype=int)\n   117\t    h, w = g.shape\n   118\t    bg = get_bg(g)\n   119\t\n   120\t    mover = 4  # yellow in ARC\n   121\t    dirs = _legend_directions(g, bg)\n   122\t    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n   123\t\n   124\t    passable = (g == bg) | (g == mover)\n   125\t    out = g.copy()\n   126\t\n   127\t    # Find enclosed passable regions (not connected to the outer border).\n   128\t    for pts in components_mask(passable, connectivity=4):\n   129\t        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n   130\t            continue  # outside background\n   131\t\n   132\t        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n   133\t        if not movers:\n   134\t            continue\n   135\t\n   136\t        # Determine this region's border color by counting adjacent wall colors.\n   137\t        border_counts: dict[int, int] = {}\n   138\t        pset = {(int(r), int(c)) for r, c in pts}\n   139\t        for r, c in pts:\n   140\t            for nr, nc in neighbors4(r, c):\n   141\t                if not (0 <= nr < h and 0 <= nc < w):\n   142\t                    continue\n   143\t                if (nr, nc) in pset:\n   144\t                    continue\n   145\t                v = int(g[nr, nc])\n   146\t                if v == bg or v == mover:\n   147\t                    continue\n   148\t                border_counts[v] = border_counts.get(v, 0) + 1\n   149\t        if not border_counts:\n   150\t            continue\n   151\t        border_col = max(border_counts, key=border_counts.get)\n   152\t        if border_col not in dirs:\n   153\t            continue\n   154\t        dr, dc = dirs[border_col]\n   155\t\n   156\t        # Clear old movers.\n   157\t        for r, c in movers:\n   158\t            out[r, c] = bg\n   159\t\n   160\t        # Slide and repaint.\n   161\t        new_pts = _slide_points(pset, movers, dr, dc)\n   162\t        for r, c in new_pts:\n   163\t            out[r, c] = mover\n   164\t\n   165\t    return out\n   166\t\n   167\t# --------------- generator (claude-att1) ---------------\n   168\t\n   169\t\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\n   170\timport random\n   171\timport numpy as np\n   172\t\n   173\tfrom arc_utils import label_mask, neighbors4, paste\n   174\t\n   175\t# ── Configuration ─────────────────────────────────────────────────\n   176\tGRID_H, GRID_W = 20, 20\n   177\t\n   178\t# Legend\n   179\tCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n   180\tDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\n   181\tCORNERS = ['TL', 'TR', 'BL', 'BR']\n   182\tWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\n   183\tCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\n   184\tLEGEND_BUFFER = 1                          # cells of padding around legend patches\n   185\t\n   186\t# Regions\n   187\tREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\n   188\tMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\n   189\tREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n   190\t    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n   191\t}\n   192\tBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n   193\t\n   194\t# Yellows\n   195\tYELLOWS_PER_REGION = [1, 2]                # choices per region\n   196\tMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n   197\t\n   198\t# Outer loop\n   199\tGEN_RETRIES = 300                          # max attempts in generate_input()\n   200\t\n   201\t\n   202\t# ── Legend patches ────────────────────────────────────────────────\n   203\t\n   204\tdef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n   205\t    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n   206\t    g = np.full((5, 5), fill, dtype=int)\n   207\t    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n   208\t    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n   209\t    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n   210\t    return np.rot90(g, rot[(dr, dc)])\n   211\t\n   212\t\n   213\tdef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n   214\t    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n   215\t    g = np.full((6, 7), fill, dtype=int)\n   216\t    g[1, 3] = 1\n   217\t    g[2, 1] = 1; g[2, 4] = 1\n   218\t    g[3, 2] = 1; g[3, 5] = 2\n   219\t    g[4, 3] = 2\n   220\t    if (dr, dc) == (1, 1): return g\n   221\t    if (dr, dc) == (-1, 1): return np.flipud(g)\n   222\t    if (dr, dc) == (1, -1): return np.fliplr(g)\n   223\t    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n   224\t    raise ValueError((dr, dc))\n   225\t\n   226\t\n   227\tdef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n   228\t    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n   229\t    if corner == 'TL': return 0, 0\n   230\t    if corner == 'TR': return 0, w - pw\n   231\t    if corner == 'BL': return h - ph, 0\n   232\t    if corner == 'BR': return h - ph, w - pw\n   233\t    raise ValueError(corner)\n   234\t\n   235\t\n   236\t# ── Blob growing / topology ──────────────────────────────────────\n   237\t\n   238\tdef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n   239\t               rng: random.Random) -> set[tuple[int, int]] | None:\n   240\t    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n","exit_code":0,"status":"completed"}}
