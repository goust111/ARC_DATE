{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/train/22208ba4.py | sed -n '1,240p'\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\t\n     3\tfrom collections import defaultdict\n     4\t\n     5\timport numpy as np\n     6\t\n     7\tfrom arc_utils import find_components, get_bg, paste\n     8\timport random\n     9\t\n    10\t\n    11\tdef main(grid: np.ndarray) -> np.ndarray:\n    12\t    \"\"\"\n    13\t    Move the repeated boundary color's rectangles one block inward while leaving singleton boundary rectangles in place.\n    14\t\n    15\t    Input structure:\n    16\t    - The background is the most common color.\n    17\t    - Foreground objects are solid monochrome rectangles touching a grid corner.\n    18\t    - Exactly one foreground color appears as multiple separate 4-connected objects; other colors appear once.\n    19\t\n    20\t    Rule:\n    21\t    - Clear the multiple objects of the repeated color from their original positions.\n    22\t    - For each cleared rectangle, translate it away from the row and column border it touches by exactly its height and width.\n    23\t    - Keep singleton-color objects unchanged; overlapping translated rectangles of the same color merge.\n    24\t\n    25\t    Key insight:\n    26\t    - Multiplicity selects the moving color, and each boundary rectangle's touched edges determine its inward diagonal translation.\n    27\t    \"\"\"\n    28\t    g = np.asarray(grid, dtype=int)\n    29\t    H, W = g.shape\n    30\t    bg = int(get_bg(g))\n    31\t\n    32\t    by_color: dict[int, list[dict]] = defaultdict(list)\n    33\t    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n    34\t        by_color[int(comp[\"color\"])].append(comp)\n    35\t\n    36\t    moving_colors = [color for color, comps in by_color.items() if len(comps) > 1]\n    37\t    assert len(moving_colors) == 1\n    38\t    moving_color = int(moving_colors[0])\n    39\t    moving_objects = by_color[moving_color]\n    40\t\n    41\t    out = g.copy()\n    42\t    for comp in moving_objects:\n    43\t        coords = comp[\"coords\"]\n    44\t        out[coords[:, 0], coords[:, 1]] = bg\n    45\t\n    46\t    for comp in moving_objects:\n    47\t        coords = comp[\"coords\"]\n    48\t        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n    49\t        height = int(r1 - r0 + 1)\n    50\t        width = int(c1 - c0 + 1)\n    51\t        assert int(comp[\"area\"]) == height * width\n    52\t\n    53\t        touches_top = r0 == 0\n    54\t        touches_bottom = r1 == H - 1\n    55\t        touches_left = c0 == 0\n    56\t        touches_right = c1 == W - 1\n    57\t        assert touches_top != touches_bottom\n    58\t        assert touches_left != touches_right\n    59\t\n    60\t        dr = height if touches_top else -height\n    61\t        dc = width if touches_left else -width\n    62\t        shifted = coords + np.array([dr, dc], dtype=int)\n    63\t        assert bool(\n    64\t            np.all(\n    65\t                (0 <= shifted[:, 0])\n    66\t                & (shifted[:, 0] < H)\n    67\t                & (0 <= shifted[:, 1])\n    68\t                & (shifted[:, 1] < W)\n    69\t            )\n    70\t        )\n    71\t\n    72\t        target = out[shifted[:, 0], shifted[:, 1]]\n    73\t        assert bool(np.all((target == bg) | (target == moving_color)))\n    74\t        out[shifted[:, 0], shifted[:, 1]] = moving_color\n    75\t\n    76\t    return out\n    77\t\n    78\t# --------------- generator (o5x) ---------------\n    79\t\n    80\t# Corner and movement model.\n    81\tCORNERS = (\"TL\", \"TR\", \"BL\", \"BR\")\n    82\tDIAGONAL_PAIRS = ({\"TL\", \"BR\"}, {\"TR\", \"BL\"})\n    83\tINWARD_STEP_FACTOR = 2\n    84\tCOMPACT_CANVAS_FACTOR = 3\n    85\t\n    86\t# Canvas, object count, and retry bounds.\n    87\tGRID_ROW_BOUNDS = (7, 22)\n    88\tGRID_COL_BOUNDS = (7, 30)\n    89\tSQUARE_SIZE_BOUNDS = (1, 4)\n    90\tMOVING_COUNT_BOUNDS = (2, 4)\n    91\tGENERATION_RETRIES = 300\n    92\t\n    93\t# Color palette.\n    94\tCOLOR_VALUES = tuple(range(10))\n    95\t\n    96\tdef _corner_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:\n    97\t    row = 0 if corner[0] == \"T\" else H - s\n    98\t    col = 0 if corner[1] == \"L\" else W - s\n    99\t    return row, col\n   100\t\n   101\t\n   102\tdef _shifted_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:\n   103\t    row = s if corner[0] == \"T\" else H - INWARD_STEP_FACTOR * s\n   104\t    col = s if corner[1] == \"L\" else W - INWARD_STEP_FACTOR * s\n   105\t    return row, col\n   106\t\n   107\t\n   108\tdef _valid_sizes(s: int, moving_count: int) -> list[tuple[int, int]]:\n   109\t    sizes = []\n   110\t    min_h = max(GRID_ROW_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)\n   111\t    min_w = max(GRID_COL_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)\n   112\t    for H in range(min_h, GRID_ROW_BOUNDS[1] + 1):\n   113\t        for W in range(min_w, GRID_COL_BOUNDS[1] + 1):\n   114\t            bg_area = H * W - len(CORNERS) * s * s\n   115\t            if bg_area <= moving_count * s * s:\n   116\t                continue\n   117\t            compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s\n   118\t            if moving_count == MOVING_COUNT_BOUNDS[1] - 1 and compact:\n   119\t                continue\n   120\t            sizes.append((H, W))\n   121\t    return sizes\n   122\t\n   123\t\n   124\tdef _pick_moving_corners(H: int, W: int, s: int, moving_count: int) -> set[str]:\n   125\t    if moving_count == len(CORNERS):\n   126\t        return set(CORNERS)\n   127\t    compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s\n   128\t    if moving_count == MOVING_COUNT_BOUNDS[0] and compact:\n   129\t        return set(random.choice(DIAGONAL_PAIRS))\n   130\t    return set(random.sample(CORNERS, moving_count))\n   131\t\n   132\t\n   133\tdef _overlaps(a: tuple[int, int], b: tuple[int, int], s: int) -> bool:\n   134\t    ar, ac = a\n   135\t    br, bc = b\n   136\t    return ar < br + s and br < ar + s and ac < bc + s and bc < ac + s\n   137\t\n   138\t\n   139\tdef _sample_layout():\n   140\t    \"\"\"Return a collision-free layout tuple, or None when the sampled size cannot work.\"\"\"\n   141\t    s = random.randint(*SQUARE_SIZE_BOUNDS)\n   142\t    moving_count = random.randint(*MOVING_COUNT_BOUNDS)\n   143\t    sizes = _valid_sizes(s, moving_count)\n   144\t    if not sizes:\n   145\t        return None\n   146\t    H, W = random.choice(sizes)\n   147\t\n   148\t    moving = _pick_moving_corners(H, W, s, moving_count)\n   149\t    singletons = [corner for corner in CORNERS if corner not in moving]\n   150\t\n   151\t    shifted = {corner: _shifted_pos(corner, H, W, s) for corner in moving}\n   152\t    singleton_pos = {corner: _corner_pos(corner, H, W, s) for corner in singletons}\n   153\t    for moved_pos in shifted.values():\n   154\t        for kept_pos in singleton_pos.values():\n   155\t            if _overlaps(moved_pos, kept_pos, s):\n   156\t                return None\n   157\t    return H, W, s, moving, singletons, shifted, singleton_pos\n   158\t\n   159\t\n   160\tdef _sample_colors(singleton_count: int) -> tuple[int, int, list[int]]:\n   161\t    colors = list(COLOR_VALUES)\n   162\t    bg = random.choice(colors)\n   163\t    colors.remove(bg)\n   164\t    moving_color = random.choice(colors)\n   165\t    colors.remove(moving_color)\n   166\t    singleton_colors = random.sample(colors, singleton_count)\n   167\t    return bg, moving_color, singleton_colors\n   168\t\n   169\t\n   170\tdef _render_pair(H, W, s, bg, moving_color, moving, singletons, shifted, singleton_pos, singleton_colors):\n   171\t    \"\"\"Render the matching input/output grids for an accepted layout and palette.\"\"\"\n   172\t    rect = np.full((s, s), moving_color, dtype=int)\n   173\t    out = np.full((H, W), bg, dtype=int)\n   174\t    for corner in moving:\n   175\t        paste(out, rect, *shifted[corner])\n   176\t    for corner, color in zip(singletons, singleton_colors):\n   177\t        patch = np.full((s, s), color, dtype=int)\n   178\t        paste(out, patch, *singleton_pos[corner])\n   179\t\n   180\t    inp = out.copy()\n   181\t    for corner in moving:\n   182\t        r, c = shifted[corner]\n   183\t        inp[r : r + s, c : c + s] = bg\n   184\t    for corner in moving:\n   185\t        paste(inp, rect, *_corner_pos(corner, H, W, s))\n   186\t    return inp, out\n   187\t\n   188\t\n   189\tdef _gen_attempt() -> np.ndarray | None:\n   190\t    layout = _sample_layout()\n   191\t    if layout is None:\n   192\t        return None\n   193\t    H, W, s, moving, singletons, shifted, singleton_pos = layout\n   194\t    bg, moving_color, singleton_colors = _sample_colors(len(singletons))\n   195\t    inp, out = _render_pair(H, W, s, bg, moving_color, moving, singletons, shifted, singleton_pos, singleton_colors)\n   196\t    try:\n   197\t        return inp if np.array_equal(main(inp), out) else None\n   198\t    except AssertionError:\n   199\t        return None\n   200\t\n   201\t\n   202\tdef generate_input() -> np.ndarray:\n   203\t    for _ in range(GENERATION_RETRIES):\n   204\t        grid = _gen_attempt()\n   205\t        if grid is not None:\n   206\t            return grid\n   207\t    raise RuntimeError(\"failed to generate valid 22208ba4 input\")\n","exit_code":0,"status":"completed"}}
