{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom functools import lru_cache\n\ndef connected(bits,h,w,val):\n    # find first cell with value\n    n=h*w\n    first=-1; total=0\n    for i in range(n):\n        b=(bits>>i)&1\n        if b==val:\n            total+=1\n            if first<0: first=i\n    if total==0:\n        return False\n    stack=[first]; seen={first}\n    while stack:\n        i=stack.pop(); r=i//w; c=i%w\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w:\n                j=nr*w+nc\n                if ((bits>>j)&1)==val and j not in seen:\n                    seen.add(j); stack.append(j)\n    return len(seen)==total\n\ndef bboxfull(bits,h,w,val):\n    rs=[]; cs=[]\n    for i in range(h*w):\n        if ((bits>>i)&1)==val:\n            rs.append(i//w); cs.append(i%w)\n    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1\n\nfor h,w in [(3,6),(4,5),(2,8),(3,5),(2,10)]:\n    n=h*w\n    found=None\n    for bits in range(1,(1<<n)-1):\n        if not bboxfull(bits,h,w,1):\n            continue\n        if not bboxfull(bits,h,w,0):\n            continue\n        if not connected(bits,h,w,1):\n            continue\n        if not connected(bits,h,w,0):\n            continue\n        found=bits\n        break\n    print((h,w), bool(found))\n    if found:\n        for r in range(h):\n            print(''.join('#' if (found>>(r*w+c))&1 else '.' for c in range(w)))\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
