{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom itertools import product\n\ndef conn(bits,h,w,val):\n    cells=[]\n    for i in range(h*w):\n        b=(bits>>i)&1\n        if b==val:\n            cells.append((i//w,i%w))\n    if not cells:\n        return False\n    seen={cells[0]}\n    st=[cells[0]]\n    while st:\n        r,c=st.pop()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w:\n                j=nr*w+nc\n                if ((bits>>j)&1)==val and (nr,nc) not in seen:\n                    seen.add((nr,nc)); st.append((nr,nc))\n    return len(seen)==len(cells)\n\ndef full_bbox(bits,h,w,val):\n    rs=[]; cs=[]\n    for i in range(h*w):\n        b=(bits>>i)&1\n        if b==val:\n            rs.append(i//w); cs.append(i%w)\n    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1\n\nfor h in range(2,6):\n  for w in range(2,6):\n    n=h*w\n    if n>16: continue\n    count=0; example=None\n    for bits in range(1,(1<<n)-1):\n      if not conn(bits,h,w,1): continue\n      if not conn(bits,h,w,0): continue\n      if not full_bbox(bits,h,w,1): continue\n      if not full_bbox(bits,h,w,0): continue\n      count+=1\n      if example is None: example=bits\n    if count:\n      print((h,w),count)\n      bits=example\n      for r in range(h):\n        print(''.join('#' if (bits>>(r*w+c))&1 else '.' for c in range(w)))\n      print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
