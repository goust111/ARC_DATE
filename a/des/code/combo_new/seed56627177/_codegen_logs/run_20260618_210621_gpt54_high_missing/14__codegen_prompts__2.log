{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom z3 import *\n\n\ndef solve(h,w):\n    x=[[Bool(f'x_{r}_{c}') for c in range(w)] for r in range(h)]\n    s=Solver()\n    # Fix roots and some boundary ownership to break symmetry.\n    s.add(x[0][0])\n    s.add(Not(x[0][w-1]))\n\n    # Each color touches all four sides.\n    s.add(Or([x[0][c] for c in range(w)]))\n    s.add(Or([Not(x[0][c]) for c in range(w)]))\n    s.add(Or([x[h-1][c] for c in range(w)]))\n    s.add(Or([Not(x[h-1][c]) for c in range(w)]))\n    s.add(Or([x[r][0] for r in range(h)]))\n    s.add(Or([Not(x[r][0]) for r in range(h)]))\n    s.add(Or([x[r][w-1] for r in range(h)]))\n    s.add(Or([Not(x[r][w-1]) for r in range(h)]))\n\n    N=h*w\n    ra=[[Int(f'ra_{r}_{c}') for c in range(w)] for r in range(h)]\n    rb=[[Int(f'rb_{r}_{c}') for c in range(w)] for r in range(h)]\n    rootA=(0,0)\n    rootB=(0,w-1)\n    for r in range(h):\n        for c in range(w):\n            s.add(And(ra[r][c] >= -1, ra[r][c] < N))\n            s.add(And(rb[r][c] >= -1, rb[r][c] < N))\n            s.add(Implies(x[r][c], ra[r][c] >= 0))\n            s.add(Implies(Not(x[r][c]), ra[r][c] == -1))\n            s.add(Implies(Not(x[r][c]), rb[r][c] >= 0))\n            s.add(Implies(x[r][c], rb[r][c] == -1))\n    s.add(ra[rootA[0]][rootA[1]] == 0)\n    s.add(rb[rootB[0]][rootB[1]] == 0)\n    # connectivity via decreasing rank neighbor\n    dirs=[(1,0),(-1,0),(0,1),(0,-1)]\n    for r in range(h):\n        for c in range(w):\n            neighA=[]; neighB=[]\n            for dr,dc in dirs:\n                nr,nc=r+dr,c+dc\n                if 0<=nr<h and 0<=nc<w:\n                    neighA.append(And(x[nr][nc], ra[nr][nc] >= 0, ra[nr][nc] < ra[r][c]))\n                    neighB.append(And(Not(x[nr][nc]), rb[nr][nc] >= 0, rb[nr][nc] < rb[r][c]))\n            if (r,c)\"'!=rootA:\n                s.add(Implies(x[r][c], Or(neighA)))\n            if (r,c)!=rootB:\n                s.add(Implies(Not(x[r][c]), Or(neighB)))\n    # avoid degenerate single-row/col monotone splits by ensuring both colors appear in middle rows/cols too\n    if h >= 5:\n        mid = h//2\n        s.add(Or([x[mid][c] for c in range(w)]))\n        s.add(Or([Not(x[mid][c]) for c in range(w)]))\n    if w >= 5:\n        mid = w//2\n        s.add(Or([x[r][mid] for r in range(h)]))\n        s.add(Or([Not(x[r][mid]) for r in range(h)]))\n\n    if s.check() != sat:\n        return None\n    m=s.model()\n    grid=[[1 if is_true(m.evaluate(x[r][c], model_completion=True)) else 0 for c in range(w)] for r in range(h)]\n    return grid\n\nfor dims in [(5,5),(5,6),(6,5),(6,6),(5,7),(7,5),(4,6),(6,4),(5,8),(8,5)]:\n    g=solve(*dims)\n    print(dims, bool(g))\n    if g:\n        for row in g:\n            print('\"''.join('#' if v else '.' for v in row))\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
