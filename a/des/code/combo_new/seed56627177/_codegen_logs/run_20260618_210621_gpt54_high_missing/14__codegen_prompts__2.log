{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nrandom.seed(0)\n\ndef connected(cells):\n    if not cells: return False\n    st=[next(iter(cells))]; seen={st[0]}\n    while st:\n        r,c=st.pop()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            p=(r+dr,c+dc)\n            if p in cells and p not in seen:\n                seen.add(p); st.append(p)\n    return len(seen)==len(cells)\n\ndef bboxfull(cells,h,w):\n    rs=[r for r,c in cells]; cs=[c for r,c in cells]\n    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1\n\ndef find(h,w,tries=200000,maxlen=None):\n    if maxlen is None: maxlen=h*w-2\n    allcells={(r,c) for r in range(h) for c in range(w)}\n    starts=[(r,c) for r in range(h) for c in range(w)]\n    for _ in range(tries):\n        start=random.choice(starts)\n        path=[start]; seen={start}\n        L=random.randint(max(h+w-1,6), maxlen)\n        for _step in range(L-1):\n            r,c=path[-1]\n            nbrs=[]\n            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                nr,nc=r+dr,c+dc\n                if 0<=nr<h and 0<=nc<w and (nr,nc) not in seen:\n                    nbrs.append((nr,nc))\n            if not nbrs:\n                break\n            # bias toward boundary cells not yet touched\n            def wt(p):\n                rr,cc=p\n                s=1\n                if rr in (0,h-1): s+=2\n                if cc in (0,w-1): s+=2\n                return s\n            choices=[]\n            for p in nbrs:\n                choices += [p]*wt(p)\n            nxt=random.choice(choices)\n            path.append(nxt); seen.add(nxt)\n        A=set(path)\n        B=allcells-A\n        if bboxfull(A,h,w) and connected(B) and bboxfull(B,h,w):\n            return A\n    return None\n\nfor dims in [(5,5),(5,6),(6,5),(6,6),(7,7),(7,8),(8,7),(8,8),(6,9),(9,6)]:\n    A=find(*dims,tries=50000,maxlen=(dims[0]*dims[1])//2+8)\n    print(dims, bool(A))\n    if A:\n        h,w=dims\n        for r in range(h):\n            print(''.join('#' if (r,c) in A else '.' for c in range(w)))\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
