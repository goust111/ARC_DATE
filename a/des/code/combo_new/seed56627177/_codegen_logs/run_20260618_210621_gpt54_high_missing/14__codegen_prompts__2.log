{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom itertools import product\nfrom collections import defaultdict\n\ndef conn(mask,h,w,val):\n    cells=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    if not cells:\n        return False\n    seen={cells[0]}\n    st=[cells[0]]\n    while st:\n        r,c=st.pop()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:\n                seen.add((nr,nc)); st.append((nr,nc))\n    return len(seen)==len(cells)\n\ndef full_bbox(mask,h,w,val):\n    cells=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    rs=[r for r,c in cells]; cs=[c for r,c in cells]\n    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1\n\nfor h in range(2,7):\n  for w in range(2,7):\n    n=h*w\n    count=0\n    examples=[]\n    for bits in range(1,1<<n):\n      if bits==(1<<n)-1: continue\n      mask=[[0]*w for _ in range(h)]\n      for i in range(n):\n        if bits>>i & 1:\n          mask[i//w][i%w]=1\n      if not conn(mask,h,w,1): continue\n      if not conn(mask,h,w,0): continue\n      if not full_bbox(mask,h,w,1): continue\n      if not full_bbox(mask,h,w,0): continue\n      count+=1\n      if len(examples)<3:\n        examples.append(mask)\n    if count:\n      print((h,w),count)\n      for ex in examples[:1]:\n        for row in ex:\n          print(''.join('#' if x else '.' for x in row))\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
