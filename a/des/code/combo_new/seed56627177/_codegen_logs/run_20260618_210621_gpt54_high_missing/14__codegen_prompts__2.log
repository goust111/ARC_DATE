{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\n\ndef connected(cells,h,w):\n    if not cells: return False\n    st=[next(iter(cells))]\n    seen={st[0]}\n    while st:\n        r,c=st.pop()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if (nr,nc) in cells and (nr,nc) not in seen:\n                seen.add((nr,nc)); st.append((nr,nc))\n    return len(seen)==len(cells)\n\ndef bboxfull(cells,h,w):\n    rs=[r for r,c in cells]; cs=[c for r,c in cells]\n    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1\n\nfor h,w in [(5,5),(5,6),(6,6),(4,5),(3,5),(3,6),(4,6)]:\n    found=None\n    for _ in range(200000):\n        # grow random connected set from random seed to random size\n        target=random.randint(max(4,(h+w)//2), h*w-4)\n        a={(random.randrange(h), random.randrange(w))}\n        while len(a)<target:\n            frontier=[]\n            for r,c in list(a):\n                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                    nr,nc=r+dr,c+dc\n                    if 0<=nr<h and 0<=nc<w and (nr,nc) not in a:\n                        frontier.append((nr,nc))\n            if not frontier: break\n            a.add(random.choice(frontier))\n        b={(r,c) for r in range(h) for c in range(w)}-a\n        if connected(a,h,w) and connected(b,h,w) and bboxfull(a,h,w) and bboxfull(b,h,w):\n            found=a; break\n    print((h,w), bool(found))\n    if found:\n        for r in range(h):\n            print(''.join('#' if (r,c) in found else '.' for c in range(w)))\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
