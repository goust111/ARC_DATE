{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, math\nrandom.seed(1)\n\ndef connected(cells):\n    if not cells: return False\n    st=[next(iter(cells))]; seen={st[0]}\n    while st:\n        r,c=st.pop()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            p=(r+dr,c+dc)\n            if p in cells and p not in seen:\n                seen.add(p); st.append(p)\n    return len(seen)==len(cells)\n\ndef bboxfull(cells,h,w):\n    rs=[r for r,c in cells]; cs=[c for r,c in cells]\n    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1\n\ndef score(a,h,w):\n    allc={(r,c) for r in range(h) for c in range(w)}\n    b=allc-a\n    s=0\n    if connected(a): s+=20\n    if connected(b): s+=20\n    for cells in (a,b):\n        if cells:\n            rs=[r for r,c in cells]; cs=[c for r,c in cells]\n            s += 5*(min(rs)==0)+5*(max(rs)==h-1)+5*(min(cs)==0)+5*(max(cs)==w-1)\n    return s\n\ndef rand_connected(h,w,target):\n    start=(random.randrange(h),random.randrange(w))\n    a={start}\n    while len(a)<target:\n        frontier=[]\n        for r,c in a:\n            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                nr,nc=r+dr,c+dc\n                if 0<=nr<h and 0<=nc<w and (nr,nc) not in a:\n                    frontier.append((nr,nc))\n        a.add(random.choice(frontier))\n    return a\n\ndef mutate(a,h,w):\n    a=set(a)\n    if random.random()<0.6 and len(a)<h*w-1:\n        frontier=[]\n        for r,c in a:\n            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                nr,nc=r+dr,c+dc\n                if 0<=nr<h and 0<=nc<w and (nr,nc) not in a:\n                    frontier.append((nr,nc))\n        if frontier:\n            a.add(random.choice(frontier))\n            return a\n    cells=list(a); random.shuffle(cells)\n    for cell in cells:\n        aa=a-{cell}\n        if connected(aa):\n            return aa\n    return a\n\nh,w=5,5\nfound=None\nbest=None;bests=-1\nfor restart in range(300):\n    a=rand_connected(h,w,random.randint(6,18))\n    t=5.0\n    for step in range(4000):\n        allc={(r,c) for r in range(h) for c in range(w)}\n        b=allc-a\n        if connected(a) and bboxfull(a,h,w) and connected(b) and bboxfull(b,h,w):\n            found=a; break\n        na=mutate(a,h,w)\n        s=score(a,h,w); ns=score(na,h,w)\n        if ns>=s or random.random()<math.exp((ns-s)/max(t,1e-9)):\n            a=na\n        t*=0.999\n        if s>bests:\n            bests=s; best=set(a)\n    if found: break\nprint('found',bool(found),'best',bests)\nshow=found or best\nfor r in range(h):\n    print(''.join('#' if (r,c) in show else '.' for c in range(w)))\nif found:\n    print('comp')\n    b={(r,c) for r in range(h) for c in range(w)}-show\n    for r in range(h):\n        print(''.join('#' if (r,c) in b else '.' for c in range(w)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
