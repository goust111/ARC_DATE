{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, math\nrandom.seed(0)\n\ndef connected(cells):\n    if not cells: return False\n    st=[next(iter(cells))]; seen={st[0]}\n    while st:\n        r,c=st.pop()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            p=(r+dr,c+dc)\n            if p in cells and p not in seen:\n                seen.add(p); st.append(p)\n    return len(seen)==len(cells)\n\ndef bboxfull(cells,h,w):\n    rs=[r for r,c in cells]; cs=[c for r,c in cells]\n    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1\n\ndef score(a,h,w):\n    allc={(r,c) for r in range(h) for c in range(w)}\n    b=allc-a\n    s=0\n    if connected(a): s+=5\n    if connected(b): s+=5\n    for cells,val in ((a,1),(b,0)):\n        if cells:\n            rs=[r for r,c in cells]; cs=[c for r,c in cells]\n            s += (min(rs)==0)+(max(rs)==h-1)+(min(cs)==0)+(max(cs)==w-1)\n    return s\n\ndef rand_connected(h,w,target):\n    start=(random.randrange(h),random.randrange(w))\n    a={start}\n    while len(a)<target:\n        frontier=[]\n        for r,c in a:\n            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                nr,nc=r+dr,c+dc\n                if 0<=nr<h and 0<=nc<w and (nr,nc) not in a:\n                    frontier.append((nr,nc))\n        if not frontier: break\n        a.add(random.choice(frontier))\n    return a\n\ndef mutate(a,h,w):\n    allc=[(r,c) for r in range(h) for c in range(w)]\n    a=set(a)\n    if random.random()<0.5 and len(a)>1:\n        # remove leaf-like cell if keeps connected\n        cells=list(a); random.shuffle(cells)\n        for cell in cells:\n            aa=a-{cell}\n            if connected(aa):\n                return aa\n    # add adjacent cell if not full\n    frontier=[]\n    for r,c in a:\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w and (nr,nc) not in a:\n                frontier.append((nr,nc))\n    if frontier and len(a)<h*w-1:\n        a.add(random.choice(frontier))\n        return a\n    # swap remove/add\n    cells=list(a); random.shuffle(cells)\n    for cell in cells:\n        aa=a-{cell}\n        if not connected(aa):\n            continue\n        frontier=[]\n        for r,c in aa:\n            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                nr,nc=r+dr,c+dc\n                if 0<=nr<h and 0<=nc<w and (nr,nc) not in aa:\n                    frontier.append((nr,nc))\n        random.shuffle(frontier)\n        for add in frontier:\n            return aa|{add}\n    return a\n\nfor h,w in [(5,5),(5,6),(6,6),(4,5),(5,4),(4,6),(6,4),(6,5),(5,7)]:\n    found=None\n    best=None; bests=-1\n    for restart in range(100):\n        a=rand_connected(h,w,random.randint(max(3,(h+w)//2), h*w-2))\n        t=1.0\n        for step in range(20000):\n            if connected(a) and bboxfull(a,h,w):\n                b={(r,c) for r in range(h) for c in range(w)}-a\n                if connected(b) and bboxfull(b,h,w):\n                    found=a; break\n            na=mutate(a,h,w)\n            s=score(a,h,w); ns=score(na,h,w)\n            if ns>=s or random.random()<math.exp((ns-s)/max(t,1e-6)):\n                a=na\n            t*=0.9998\n            s=score(a,h,w)\n            if s>bests:\n                bests=s; best=set(a)\n        if found: break\n    print((h,w),'found',bool(found),'best',bests)\n    show=found if found else best\n    if show:\n        for r in range(h):\n            print(''.join('#' if (r,c) in show else '.' for c in range(w)))\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
