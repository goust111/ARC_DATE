ct] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n--- generate_input 471-476 ---\ndef generate_input():\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n\n================================================================================\nFILE: /home/lixinyu/snap/new/ARC_code/train/99caaf76.py\n--- main 55-125 ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each marked cross object away from its marker to the grid edge while rotating the colored cross 180 degrees.\n\n    Input structure:\n    - The background is the dominant color.\n    - Each 8-connected foreground object has nine pixels: a 4-pixel marker-color\n      sprite attached to a 5-pixel non-marker colored cross.\n    - Each object bbox is either 3x6 or 6x3, so the marker sprite is on exactly\n      one side of the cross.\n\n    Rule:\n    - Move the whole object straight away from its marker side until the object\n      bbox touches the corresponding grid edge.\n    - Keep the marker sprite unchanged within the object.\n    - Rotate the 3x3 colored cross block by 180 degrees before placing it.\n\n    Key insight:\n    The marker sprite is a directional tail; the cross is the leading payload,\n    and only that payload turns around during the slide to the edge.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = get_bg(g)\n    marker = _marker_color(g, bg)\n\n    out = np.full_like(g, int(bg))\n    objects = find_components(g, bg=bg, connectivity=8, monochromatic=False)\n    assert objects, \"expected at least one composite object\"\n\n    for obj in objects:\n        assert int(obj[\"area\"]) == 9, \"each composite should contain 9 foreground pixels\"\n        r0, c0, _r1, _c1 = obj[\"bbox\"]\n        patch = crop_bbox(g, obj[\"bbox\"])\n        h, w = patch.shape\n        moved = patch.copy()\n\n        if (h, w) == (3, 6):\n            left = patch[:, :3]\n            right = patch[:, 3:]\n            left_kind = _block_kind(left, bg, marker)\n            right_kind = _block_kind(right, bg, marker)\n            assert {left_kind, right_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n\n            if left_kind == \"marker\":\n                moved[:, 3:] = np.rot90(right, 2)\n                target_r, target_c = int(r0), W - w\n            else:\n                moved[:, :3] = np.rot90(left, 2)\n                target_r, target_c = int(r0), 0\n\n        elif (h, w) == (6, 3):\n            top = patch[:3, :]\n            bottom = patch[3:, :]\n            top_kind = _block_kind(top, bg, marker)\n            bottom_kind = _block_kind(bottom, bg, marker)\n            assert {top_kind, bottom_kind} =