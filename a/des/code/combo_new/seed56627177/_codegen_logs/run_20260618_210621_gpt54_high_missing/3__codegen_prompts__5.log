{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/17829a00.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste\nimport random\n\n\ndef _is_full_width_border(comp: dict, h: int, w: int) -> bool:\n    r0, c0, r1, c1 = comp[\"bbox\"]\n    return (\n        int(comp[\"area\"]) == int(w)\n        and int(r0) == int(r1)\n        and int(c0) == 0\n        and int(c1) == int(w - 1)\n        and int(r0) in {0, int(h - 1)}\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each colored object vertically until it touches the matching top or bottom border bar.\n\n    Input structure:\n    - The background is the dominant color.\n    - The top row is a full-width bar in one foreground color and the bottom row is a full-width bar in another.\n    - All other foreground pixels are 8-connected monochrome objects whose color matches one of those bars.\n\n    Rule:\n    - Top-bar-colored objects move upward so their bbox top is row 1.\n    - Bottom-bar-colored objects move downward so their bbox bottom is the row above the bottom bar.\n    - A downward-moving one-column segment whose landing overlaps its source becomes the continuous vertical segment swept between them.\n\n    Key insight:\n    The horizontal bars are destination anchors: color determines which border an object slides toward, while columns and object shape are otherwise preserved.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h >= 3 and w >= 1\n\n    bg = int(get_bg(g))\n    top_color = int(g[0, 0])\n    bottom_color = int(g[h - 1, 0])\n\n    assert top_color != bg\n    assert bottom_color != bg\n    assert top_color != bottom_color\n    assert bool(np.all(g[0, :] == top_color))\n    assert bool(np.all(g[h - 1, :] == bottom_color))\n    assert set(map(int, np.unique(g))) == {bg, top_color, bottom_color}\n\n    for c in range(w):\n        top_rows = [r for r in range(1, h - 1) if int(g[r, c]) == top_color]\n        bot_rows = [r for r in range(1, h - 1) if int(g[r, c]) == bottom_color]\n        if top_rows and bot_rows:\n            assert max(top_rows) < min(bot_rows), \"top-color objects must be above bottom-color objects in every column\"\n\n    out = np.full_like(g, bg)\n    out[0, :] = top_color\n    out[h - 1, :] = bottom_color\n\n    for color, target_side in ((top_color, \"top\"), (bottom_color, \"bottom\")):\n        components = find_components(\n            g,\n            bg=bg,\n            connectivity=8,\n            monochromatic=True,\n            colors=[color],\n            return_format=\"dict\",\n        )\n        for comp in components:\n            if _is_full_width_border(comp, h, w):\n                continue\n\n            coords = np.asarray(comp[\"coords\"], dtype=int)\n            r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n            assert 0 < r0 <= r1 < h - 1\n\n            if target_side == \"top\":\n                dr = 1 - r0\n                assert dr <= 0\n                paint = coords + np.array([dr, 0], dtype=int)\n            else:\n                dr = (h - 2) - r1\n                assert dr >= 0\n                paint = coords + np.array([dr, 0], dtype=int)\n                if dr > 0 and r0 + dr <= r1:\n                    assert c0 == c1\n                    rows = np.arange(r0, r1 + dr + 1, dtype=int)\n                    paint = np.column_stack([rows, np.full(rows.shape, c0, dtype=int)])\n\n            assert bool(np.all((0 <= paint[:, 0]) & (paint[:, 0] < h)))\n            assert bool(np.all((0 <= paint[:, 1]) & (paint[:, 1] < w)))\n            assert bool(np.all(out[paint[:, 0], paint[:, 1]] == bg))\n            out[paint[:, 0], paint[:, 1]] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom scipy.ndimage import binary_dilation\n\n# -- Grid constants --\nBG = 7\nH = 16\nW = 16\n\n# -- Sprite geometry --\nSPRITE_AREA_MIN = 1\nSPRITE_AREA_MAX = 6\nSPRITE_H_MAX = 4       # bbox height upper bound (exclusive in range)\nSPRITE_W_MAX = 5       # bbox width upper bound (exclusive in range)\nSPRITE_DENSITY_MIN = 0.33  # min fill ratio inside bbox\n\n# -- Object counts per side --\nOBJ_COUNT_MIN = 3      # per color\nOBJ_COUNT_MAX = 5      # per color (inclusive)\nOBJ_TOTAL_MAX = 9      # top_count + bottom_count\n\n# -- Swept segment (single-column overlap case) --\nSWEPT_PROB = 0.15       # probability of including one swept-segment object\nSWEPT_H_MIN = 2        # min input height for swept column\nSWEPT_H_MAX = 4        # max input height (inclusive)\nSWEPT_TOTAL_MAX = 5    # input_h + offset ceiling\n\n# -- Input derivation --\nSLIDE_OFFSET_MAX = 10  # exclusive upper bound for slide offsets (range(1, N))\n\n# -- Retry budgets --\nPLACE_RETRIES = 60     # sprite placement attempts per object\nGEN_RETRIES = 300      # outer generation attempts\n\n\ndef _corner_path(h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Generate a diagonal path from one corner of an (h,w) bbox to the opposite.\"\"\"\n    if h == 1 and w == 1:\n        return {(0, 0)}\n    r0 = random.choice([0, h - 1])\n    c0 = random.choice([0, w - 1])\n    r1 = h - 1 - r0\n    c1 = w - 1 - c0\n    steps = max(h, w)\n    cells: set[tuple[int, int]] = set()\n    for k in range(steps):\n        t = 0.0 if steps == 1 else k / (steps - 1)\n        cells.add((int(round(r0 + (r1 - r0) * t)),\n                    int(round(c0 + (c1 - c0) * t))))\n    return cells\n\n\ndef _random_sprite(color: int) -> np.ndarray:\n    \"\"\"Create a small random 8-connected sprite with the given color on BG.\"\"\"\n    area = random.randint(SPRITE_AREA_MIN, SPRITE_AREA_MAX)\n    choices = [\n        (sh, sw)\n        for sh in range(1, SPRITE_H_MAX + 1)\n        for sw in range(1, SPRITE_W_MAX + 1)\n        if max(sh, sw) <= area <= sh * sw\n        and area / (sh * sw) >= SPRITE_DENSITY_MIN\n    ]\n    sh, sw = random.choice(choices)\n    cells = _corner_path(sh, sw)\n    while len(cells) < area:\n        frontier = []\n        for r, c in cells:\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    if dr == 0 and dc == 0:\n                        continue\n                    rr, cc = r + dr, c + dc\n                    if 0 <= rr < sh and 0 <= cc < sw and (rr, cc) not in cells:\n                        frontier.append((rr, cc))\n        cells.add(random.choice(frontier))\n\n    sprite = np.full((sh, sw), BG, dtype=int)\n    rs, cs = zip(*cells)\n    sprite[rs, cs] = color\n    return sprite\n\n\ndef _coords_from_patch(patch: np.ndarray, r0: int, c0: int) -> np.ndarray:\n    \"\"\"Return (N,2) absolute coords of non-BG pixels in patch placed at (r0,c0).\"\"\"\n    return np.argwhere(patch != BG) + np.array([r0, c0], dtype=int)\n\n\ndef _is_bar(comp: dict) -> bool:\n    \"\"\"True if a component dict represents a full-width border bar.\"\"\"\n    r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n    return (\n        int(comp[\"area\"]) == W\n        and r0 == r1\n        and c0 == 0\n        and c1 == W - 1\n        and r0 in {0, H - 1}\n    )\n\n\ndef _object_count(grid: np.ndarray, color: int) -> int:\n    \"\"\"Count non-bar objects of the given color.\"\"\"\n    comps = find_components(\n        grid, bg=BG, connectivity=8, monochromatic=True,\n        colors=[color], return_format=\"dict\",\n    )\n    return sum(1 for comp in comps if not _is_bar(comp))\n\n\n_STRUCT8 = np.ones((3, 3), dtype=bool)\n\n\ndef _touches_same(mask: np.ndarray, coords: np.ndarray) -> bool:\n    \"\"\"Check if any coord is 8-adjacent to an existing same-color pixel.\"\"\"\n    probe = np.zeros((H, W), dtype=bool)\n    probe[coords[:, 0], coords[:, 1]] = True\n    dilated = binary_dilation(probe, structure=_STRUCT8)\n    dilated[coords[:, 0], coords[:, 1]] = False  # exclude the coords themselves\n    return bool((dilated & mask).any())\n\n\ndef _place_output_object(out: np.ndarray, color: int, side: str) -> dict | None:\n    \"\"\"Try to place a random sprite on the output grid touching the bar on `side`.\"\"\"\n    for _ in range(PLACE_RETRIES):\n        patch = _random_sprite(color)\n        ph, pw = map(int, patch.shape)\n        r0 = 1 if side == \"top\" else H - 1 - ph\n        cols = list(range(0, W - pw + 1))\n        random.shuffle(cols)\n        for c0 in cols:\n            coords = _coords_from_patch(patch, r0, c0)\n            if bool(np.all(out[coords[:, 0], coords[:, 1]] == BG)):\n                paste(out, patch, r0, c0, transparent=BG)\n                return {\n                    \"color\": color, \"side\": side, \"coords\": coords,\n                    \"height\": ph, \"width\": pw, \"special\": False,\n                }\n    return None\n\n\ndef _place_swept_output_object(out: np.ndarray, color: int) -> dict | None:\n    \"\"\"Try to place a single-column swept-segment bottom object.\"\"\"\n    choices = [\n        (input_h, offset)\n        for input_h in range(SWEPT_H_MIN, SWEPT_H_MAX + 1)\n        for offset in range(1, input_h)\n        if input_h + offset <= SWEPT_TOTAL_MAX\n    ]\n    random.shuffle(choices)\n    cols = list(range(W))\n    random.shuffle(cols)\n    for input_h, offset in choices:\n        out_h = input_h + offset\n        patch = np.full((out_h, 1), color, dtype=int)\n        r0 = H - 1 - out_h\n        for c0 in cols:\n            coords = _coords_from_patch(patch, r0, c0)\n            if bool(np.all(out[coords[:, 0], coords[:, 1]] == BG)):\n                paste(out, patch, r0, c0, transparent=BG)\n                input_rows = np.arange(r0, r0 + input_h, dtype=int)\n                input_coords = np.column_stack(\n                    [input_rows, np.full(input_rows.shape, c0, dtype=int)]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' /home/lixinyu/snap/new/ARC_code/eval/271d71e2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' /home/lixinyu/snap/new/ARC_code/eval/271d71e2.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom scipy.ndimage import label\nfrom arc_utils import STRUCT4, bbox_coords, colors_present, components_mask, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move bordered containers toward same-colored destination markers, charging gray cells to orange.\n\n    Input structure:\n    - bg = 6 (magenta). Black-bordered (0) rectangles with gray (5) / orange (7) interiors.\n    - A head sprite (9) sits adjacent to one container edge; a matching destination sprite lies along the movement axis.\n\n    Rule:\n    - Each container translates toward its destination along the head-to-dest axis.\n    - Steps = min(head-to-dest distance, number of gray interior cells).\n    - Gray cells become orange from the head-facing side inward, one per step.\n\n    Key insight: Gray cell count caps movement — a container stops short if it runs out of gray cells to charge.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    BORDER = 0\n    GREY = 5\n    FILL = 7\n    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    # True background is dominant non-border color (border can dominate in some cases).\n    cnt = Counter(map(int, g.flatten()))\n    bg = int(max((c for c in cnt.keys() if int(c) != int(BORDER)), key=lambda c: int(cnt[int(c)])))\n\n    def rect_border_coords(r0: int, c0: int, r1: int, c1: int):\n        for c in range(c0, c1 + 1):\n            yield (r0, c)\n            yield (r1, c)\n        for r in range(r0 + 1, r1):\n            yield (r, c0)\n            yield (r, c1)\n\n    # --- detect containers as rectangles enclosing GREY/FILL with BORDER frame ---\n    containers = []\n    for pts in components_mask((g == GREY) | (g == FILL), connectivity=4):\n        if pts.size == 0:\n            continue\n        ir0, ic0, ir1, ic1 = bbox_coords(pts)\n        r0, c0, r1, c1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)\n        if r0 < 0 or c0 < 0 or r1 >= H or c1 >= W:\n            continue\n        if any(int(g[r, c]) != BORDER for r, c in rect_border_coords(r0, c0, r1, c1)):\n            continue\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        if inner.size == 0 or not bool(np.isin(inner, [GREY, FILL]).all()):\n            continue\n        containers.append({\"box\": (r0, c0, r1, c1)})\n\n    assert not (not containers)\n\n    # head + destination are in some non-bg, non-border color (not GREY/FILL)\n    out = g.copy()\n\n    all_head_colors = [c for c in colors_present(g, exclude={bg, BORDER, GREY, FILL})]\n\n    # Precompute components for each head color.\n    comp_by_color: dict[int, list[dict]] = defaultdict(list)\n    for col in all_head_colors:\n        labc, nc = label(g == int(col), structure=STRUCT4)\n        for k in range(1, int(nc) + 1):\n            coords = np.argwhere(labc == int(k))\n            if coords.size == 0:\n                continue\n            r0, c0, r1, c1 = bbox_coords(coords)\n            pts = {(int(r), int(c)) for r, c in coords}\n            shape = {(int(r - r0), int(c - c0)) for r, c in pts}\n            comp_by_color[int(col)].append({\"pts\": pts, \"shape\": shape, \"tl\": (int(r0), int(c0))})\n\n    def pick_head_for_container(box_):\n        r0, c0, r1, c1 = box_\n        head_seeds = []\n        for r, c in rect_border_coords(r0, c0, r1, c1):\n            for dr, dc in DIR4:\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < H and 0 <= cc < W:\n                    val = int(g[rr, cc])\n                    if val not in (int(bg), int(BORDER), int(GREY), int(FILL)):\n                        head_seeds.append((rr, cc, val))\n        if not head_seeds:\n            return None\n\n        hc = int(Counter(val for _r, _c, val in head_seeds).most_common(1)[0][0])\n        seed_pts = {(r, c) for r, c, val in head_seeds if int(val) == int(hc)}\n        cands = comp_by_color.get(hc, [])\n        comp0 = None\n        for comp in cands:\n            if comp[\"pts\"] & seed_pts:\n                comp0 = comp\n                break\n        if comp0 is None:\n            return None\n\n        # Split head vs destination even if same-color pixels touch:\n        # head pixels are those with minimal manhattan distance to this container border.\n        border_pts = list(rect_border_coords(r0, c0, r1, c1))\n        best_d = None\n        dist = {}\n        for pr, pc in comp0[\"pts\"]:\n            d = min(abs(int(pr - br)) + abs(int(pc - bc)) for br, bc in border_pts)\n            dist[(int(pr), int(pc))] = int(d)\n            if best_d is None or d < best_d:\n                best_d = int(d)\n        if best_d is None:\n            return None\n        head_pts = {p for p, d in dist.items() if int(d) == int(best_d)}\n\n        # direction from head bbox relative to container box\n        coords = np.array(list(head_pts), dtype=int)\n        hr0, hc0, hr1, hc1 = bbox_coords(coords)\n        if hc1 < c0:\n            direction = (0, -1)\n        elif hc0 > c1:\n            direction = (0, 1)\n        elif hr1 < r0:\n            direction = (-1, 0)\n        elif hr0 > r1:\n            direction = (1, 0)\n        else:\n            direction = (0, 0)\n\n        # normalized head shape + top-left\n        r00, c00 = int(hr0), int(hc0)\n        head_shape = {(int(r - r00), int(c - c00)) for r, c in head_pts}\n        return {\n            \"color\": hc,\n            \"head_pts\": head_pts,\n            \"head_shape\": head_shape,\n            \"head_tl\": (r00, c00),\n            \"comp_pts\": set(comp0[\"pts\"]),\n            \"dir\": direction,\n        }\n\n    for cont in containers:\n        box_ = cont[\"box\"]\n        r0, c0, r1, c1 = box_\n\n        head_info = pick_head_for_container(box_)\n        if head_info is None:\n            continue\n        hc = int(head_info[\"color\"])\n        head_pts = set(head_info[\"head_pts\"])\n        head_shape = head_info[\"head_shape\"]\n        head_tl = head_info[\"head_tl\"]\n        comp_pts = set(head_info[\"comp_pts\"])\n        direction = head_info[\"dir\"]\n        if direction == (0, 0):\n            continue\n\n        # destination candidates\n        dests = []\n        for d in comp_by_color.get(hc, []):\n            if d[\"shape\"] != head_shape:\n                continue\n            if d[\"pts\"] == comp_pts:\n                continue\n            dests.append(d)\n\n        # add split-from-same-component destinations (when dest touches head by color)\n        rem = comp_pts - head_pts\n        if rem:\n            mask_rem = np.zeros((H, W), dtype=bool)\n            for rr, cc in rem:\n                mask_rem[int(rr), int(cc)] = True\n            labr, nr = label(mask_rem, structure=STRUCT4)\n            for k in range(1, int(nr) + 1):\n                pts = {(int(r), int(c)) for r, c in np.argwhere(labr == int(k))}\n                if not pts:\n                    continue\n                # reject if adjacent to BORDER\n                adj = False\n                for r, c in pts:\n                    for dr, dc in DIR4:\n                        rr, cc = int(r + dr), int(c + dc)\n                        if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(BORDER):\n                            adj = True\n                            break\n                    if adj:\n                        break\n                if adj:\n                    continue\n                rs = [r for r, _c in pts]\n                cs = [c for _r, c in pts]\n                r00, c00 = int(min(rs)), int(min(cs))\n                shp = {(int(r - r00), int(c - c00)) for r, c in pts}\n                if shp != head_shape:\n                    continue\n                dests.append({\"pts\": pts, \"shape\": shp, \"tl\": (r00, c00)})\n\n        if not dests:\n            continue\n\n        best = None\n        best_dest = None\n        for d in dests:\n            tr0 = int(d[\"tl\"][0] - head_tl[0])\n            tc0 = int(d[\"tl\"][1] - head_tl[1])\n            if direction[0] != 0 and tc0 != 0:\n                continue\n            if direction[1] != 0 and tr0 != 0:\n                continue\n            if direction[0] == 1 and tr0 <= 0:\n                continue\n            if direction[0] == -1 and tr0 >= 0:\n                continue\n            if direction[1] == 1 and tc0 <= 0:\n                continue\n            if direction[1] == -1 and tc0 >= 0:\n                continue\n            dist = abs(tr0) + abs(tc0)\n            if best is None or dist < best:\n                best = dist\n                best_dest = d\n        if best_dest is None:\n            continue\n\n        # translation to overlap head onto destination, capped by number of GREY cells\n        tr0 = int(best_dest[\"tl\"][0] - head_tl[0])\n        tc0 = int(best_dest[\"tl\"][1] - head_tl[1])\n        steps = abs(tr0) + abs(tc0)\n\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        grey_coords = [\n            (int(r0 + 1 + rr), int(c0 + 1 + cc))\n            for rr in range(inner.shape[0])\n            for cc in range(inner.shape[1])\n            if int(inner[rr, cc]) == GREY\n        ]\n        steps = min(int(steps), int(len(grey_coords)))\n\n        dr, dc = direction\n        tr = int(dr * steps)\n        tc = int(dc * steps)\n\n        # choose which greys to fill in order from head side inward\n        if direction == (0, 1):\n            order = sorted(grey_coords, key=lambda p: (-p[1], p[0]))\n        elif direction == (0, -1):\n            order = sorted(grey_coords, key=lambda p: (p[1], -p[0]))\n        elif direction == (1, 0):\n            order = sorted(grey_coords, key=lambda p: (-p[0], -p[1]))\n        else:  # (-1,0)\n            order = sorted(grey_coords, key=lambda p: (p[0], p[1]))\n        to_fill = set(order[:steps])\n\n        # erase original container rect and original head pixels (destination stays)\n        out[r0 : r1 + 1, c0 : c1 + 1] = int(bg)\n        for r, c in head_pts:\n            if int(out[int(r), int(c)]) == int(hc):\n                out[int(r), int(c)] = int(bg)\n\n        # stamp moved container rectangle (using paste for the bulk placement)\n        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        if to_fill:\n            for rr, cc in to_fill:\n                pr = int(rr - r0)\n                pc = int(cc - c0)\n                if 0 <= pr < patch.shape[0] and 0 <= pc < patch.shape[1] and int(patch[pr, pc]) == GREY:\n                    patch[pr, pc] = int(FILL)\n        paste(out, patch, int(r0 + tr), int(c0 + tc), clip=True)\n\n        # stamp moved head pixels\n        for r, c in head_pts:\n            rrr = int(r + tr)\n            ccc = int(c + tc)\n            if 0 <= rrr < H and 0 <= ccc < W:\n                out[rrr, ccc] = int(hc)\n\n    return out\n\n# --------------- generator (attempt 2, Claude) ---------------\n","exit_code":0,"status":"completed"}}
