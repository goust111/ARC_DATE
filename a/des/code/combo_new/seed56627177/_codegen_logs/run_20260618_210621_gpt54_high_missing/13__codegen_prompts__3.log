darray:\\n    \\\"\\\"\\\"\\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\\n\\n    Input structure:\\n    - bg = most common color. Several hollow sprites with distinct border colors.\\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\\n\\n    Rule:\\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\\n\\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\\n    \\\"\\\"\\\"\\n    g = np.asarray(grid, dtype=int)\\n    bg = _bg_boundary(g)\\n\\n    mapping, pal_mask = _palette_mapping(g, bg)\\n    assert mapping, \\\"main: palette mapping must be non-empty\\\"\\n\\n    out = g.copy()\\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\\n\\n    return out\\n\\n# --------------- generator (c) ---------------\\n\\n# -- Configuration constants --------------------------------------------------\\n# Grid dimensions\\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\\n\\n# Palette\\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\\n\\n# Sprite geometry\\n_SPRITE_H_MAX = 7\\n_SPRITE_W_MAX = 6\\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\\n_SPRITE_CELL_MAX = 16\\n_FILLED_SPRITE_MAX = 3\\n\\n# Sprite mutation probabilities\\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\\n_P_VERT_WALL = 0.3            # add vertical internal wall\\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\\n\\n# Generation\\n_MAX_RETRIES = 300\\n# -- End configuration --------------------------------------------------------\\n\\n\\ndef _get_enclosed_holes(sprite):\\n--- def generate_input ...\\ndef generate_input():\\n    for _ in range(_MAX_RETRIES):\\n        r = _gen_attempt()\\n        if r is not None:\\n            return r\\n    raise RuntimeError(f\\\"Failed to generate input after {_MAX_RETRIES} attempts\\\")\\n\\n\\n=====  /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py  =====\\n--- def main ...\\ndef main(grid: np.ndarray) -> np.ndarray:\\n    \\\"\\\"\\\"\\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\\n\\n    Input structure:\\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\\n\\n    Rule:\\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\\n\\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\\n    \\\"\\\"\\\"\\n    g = np.asarray(grid, dtype=int)\\n    h, w = g.shape\\n    bg = get_bg(g)\\n\\n    mover = 4  # yellow in ARC\\n    dirs = _legend_directions(g, bg)\\n    assert dirs, \\\"legend_directions must find at least one legend; grid should always have border legends\\\"\\n\\n    passable = (g == bg) | (g == mover)\\n    out = g.copy()\\n\\n    # Find enclosed passable regions (not connected to the outer border).\\n    for pts in components_mask(passable, connectivity=4):\\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\\n            continue  # outside background\\n\\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\\n        if not movers:\\n            continue\\n\\n        # Determine this region's border color by counting adjacent wall colors.\\n        border_counts: dict[int, int] = {}\\n        pset = {(int(r), int(c)) for r, c in pts}\\n        for r, c in pts:\\n            for nr, nc in neighbors4(r, c):\\n                if not (0 <= nr < h and 0 <= nc < w):\\n                    continue\\n                if (nr, nc) in pset:\\n                    continue\\n                v = int(g[nr, nc])\\n                if v == bg or v == mover:\\n                    continue\\n                border_counts[v] = border_counts.get(v, 0) + 1\\n        if not border_counts:\\n            continue\\n        border_col = max(border_counts, key=border_counts.get)\\n        if border_col not in dirs:\\n            continue\\n        dr, dc = dirs[border_col]\\n\\n        # Clear old movers.\\n        for r, c in movers:\\n            out[r, c] = bg\\n\\n        # Slide and repaint.\\n        new_pts = _slide_points(pset, movers, dr, dc)\\n        for r, c in new_pts:\\n            out[r, c] = mover\\n\\n    return out\\n\\n# --------------\\n--- def generate_input ...\\ndef generate_input() -> np.ndarray:\\n    rng = random.Random()\\n    for _ in range(GEN_RETRIES):\\n        try:\\n            g = _gen_attempt(rng)\\n        except Exception:\\n            continue\\n        if g is not None:\\n            return g\\n    raise RuntimeError(\\\"generate_input: exceeded retries\\\")\\n\\n\\n=====  /home/lixinyu/snap/new/ARC_code/train/34cfa167.py  =====\\n--- def main ...\\ndef main(grid: np.ndarray) -> np.ndarray:\\n    \\\"\\\"\\\"\\n    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.\\n\\n    Input structure:\\n    - The background is the dominant color.\\n    - Two same-color solid rectangular anchors of the same size sit on opposite\\n      diagonal corners, with the first anchor above-left of the second.\\n    - The upper-left anchor has two one-cell-thick vertical control bars to its\\n      right and two one-cell-thick horizontal control bars below it.\\n\\n    Rule:\\n    - Copy the anchor rectangle into the two missing corners of the implied\\n      larger rectangle.\\n    - Repeat the right-side control bars horizontally between the left and right\\n      anchors, using their spacing as the period, and draw the outer top and\\n      bottom borders in the first right-control color.\\n    - Repeat the below-side control bars vertically between the top and bottom\\n      anchors, using the same period, and draw the outer left and right borders\\n      in the first below-control color.\\n\\n    Key insight: The small control bars are the first two ticks of two periodic\\n    frame patterns; the diagonal anchor supplies the opposite corner and the\\n    missing two anchor copies.\\n    \\\"\\\"\\\"\\n    g = np.asarray(grid, dtype=int)\\n    bg = get_bg(g)\\n    source, dest, right_controls, below_controls = _find_structure(g, bg)\\n\\n    sr0, sc0, sr1, sc1 = source[\\\"bbox\\\"]\\n    dr0, dc0, dr1, dc1 = dest[\\\"bbox\\\"]\\n    anchor_color = int(source[\\\"color\\\"])\\n    assert int(dest[\\\"color\\\"]) == anchor_color, \\\"anchor colors must match\\\"\\n    assert bbox_h(source[\\\"bbox\\\"]) == bbox_h(dest[\\\"bbox\\\"]), \\\"anchor heights must match\\\"\\n    assert bbox_w(source[\\\"bbox\\\"]) == bbox_w(dest[\\\"bbox\\\"]), \\\"anchor widths must match\\\"\\n    assert sr0 > 0 and sc0 > 0, \\\"upper-left anchor must have space for outer frame\\\"\\n    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \\\"lower-right anchor must have space for outer frame\\\"\\n\\n    right_offsets = [int(comp[\\\"bbox\\\"][1] - sc1) for comp in right_controls]\\n    below_offsets = [int(comp[\\\"bbox\\\"][0] - sr1) for comp in below_controls]\\n    assert right_offsets == below_offsets and right_offsets[0] == 1, \\\"control offsets must match from the anchor edge\\\"\\n    step = int(right_offsets[1] - right_offsets[0])\\n    assert step > 0, \\\"control bars must be separated\\\"\\n    period = 2 * step\\n    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, \\\"right frame must close next to the destination anchor\\\"\\n    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, \\\"below frame must close next to the destination anchor\\\"\\n\\n    right_colors = [int(comp[\\\"color\\n--- def generate_input ...\\ndef generate_input() -> np.ndarray:\\n    for _ in range(MAX_GENERATION_ATTEMPTS):\\n        grid = _gen_attempt()\\n        if grid is not None:\\n            return grid\\n    raise RuntimeError(\\\"failed to generate valid input\\\")\\n\\n\\n=====  /home/lixinyu/snap/new/ARC_code/train/b25e450b.py  =====\\n--- def main ...\\ndef main(grid: np.ndarray) -> np.ndarray:\\n    \\\"\\\"\\\"\\n    Slide each black border rectangle to the opposite border, recoloring its swept stripe orange and leaving the rectangle black at the far edge.\\n\\n    Input structure\\n    - The grid contains black rectangular 4-connected masks, each touching exactly one outer border.\\n    - Grey cells form incidental pattern content; orange is the trail color used when a black mask slides.\\n\\n    Rule\\n    - Treat all black rectangles as moving simultaneously.\\n    - A rectangle touching the top or bottom edge moves vertically to the opposite edge in the same columns.\\n    - A rectangle touching the left or right edge moves horizontally to the opposite edge in the same rows.\\n    - Recolor the complete swept row or column stripe to orange, then stamp every destination rectangle in black.\\n\\n    Key insight\\n    - Edge contact gives the slide direction; the output is the set of opposite-edge black rectangles plus their orange trails.\\n    \\\"\\\"\\\"\\n    g = np.asarray(grid, dtype=int)\\n    assert g.ndim == 2\\n    h, w = g.shape\\n    assert h > 0 and w > 0\\n\\n    moving = Color.BLACK\\n    trail = Color.ORANGE\\n    assert np.any(g == moving), \\\"expected at least one black rectangle\\\"\\n    assert np.any(g == trail), \\\"expected orange trail color to be present\\\"\\n\\n    out = g.copy()\\n    targets: list[BBox] = []\\n    for coords in components_mask(g == moving, connectivity=4):\\n        r0, c0, r1, c1 = bbox_coords(coords)\\n        rect_h = r1 - r0 + 1\\n        rect_w = c1 - c0 + 1\\n        assert int(coords.shape[0]) == rect_h * rect_w, \\\"black mask must be a solid rectangle\\\"\\n\\n        side = _edge_side((r0, c0, r1, c1), g.shape)\\n        if side == \\\"top\\\":\\n            out[:, c0 : c1 + 1] = trail\\n            targets.append((h - rect_h, c0, h - 1, c1))\\n        elif side == \\\"bottom\\\":\\n            out[:, c0 : c1 + 1] = trail\\n            targets.append((0, c0, rect_h - 1, c1))\\n        elif side == \\\"left\\\":\\n            out[r0 : r1 + 1, :] = trail\\n            targets.append((r0, w - rect_w, r1, w - 1))\\n        else:\\n            assert side == \\\"right\\\"\\n            out[r0 : r1 + 1, :] = trail\\n            targets.append((r0, 0, r1, rect_w - 1))\\n\\n    for r0, c0, r1, c1 in targets:\\n        out[r0 : r1 + 1, c0 : c1 + 1] = moving\\n\\n    return out\\n\\n# --------------- generator (att1) ---------------\\n\\n# Canvas and palette.\\nMIN_H, MAX_H = 6, 18\\nMIN_W, MAX_W = 8, 14\\nBG_GREY, BG_ORANGE = 5, 7\\nGREY_FRAC_MIN, GREY_FRAC_MAX = 0.2, 0.6\\n\\n# Rectangle and band constraints.\\nMIN_RECTS, MAX_RECTS = 1, 8\\nMIN_BAND_SIZE, MAX_BAND_SIZE = 1, 6\\nBAND_GAP = 1\\nMIN_RECT_AREA, MAX_RECT_AREA = 2, 18\\nMAX_RECT_SID\\n--- def generate_input ...\\ndef generate_input() -> np.ndarray:\\n    target_count = random.randint(MIN_RECTS, MAX_RECTS)\\n    for _ in r