{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/aa62e3f4.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import components_mask, get_bg, neighbors4\nimport random\n\n\ndef _unique_color_with_count(counts: Counter[int], colors: list[int], target_count: int) -> int:\n    matches = [color for color in colors if counts[color] == target_count]\n    assert len(matches) == 1, \"expected a unique structural color by area\"\n    return int(matches[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace the outlined object with the outside contour of that outline in the marker color.\n\n    Input structure:\n    - A dominant background surrounds one 8-connected foreground outline.\n    - The outline is the unique largest foreground color.\n    - One or more smaller interior colors are inside the outline; the marker color\n      is the unique smallest non-outline color.\n\n    Rule:\n    - Erase all original foreground pixels to background.\n    - Paint every background pixel that is 4-adjacent to the outline with the\n      marker color.\n    - Keep the grid shape unchanged.\n\n    Key insight: The colored interior marker supplies the paint color, while the\n    largest outline supplies only the contour whose outside edge is traced.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    counts = Counter(map(int, g.flatten()))\n    foreground_colors = [color for color in counts if color != bg]\n    assert len(foreground_colors) >= 2, \"expected an outline color and a marker color\"\n\n    frame_count = max(counts[color] for color in foreground_colors)\n    frame_color = _unique_color_with_count(counts, foreground_colors, frame_count)\n    assert len(components_mask(g == frame_color, connectivity=8)) == 1, \"outline must be 8-connected\"\n\n    marker_candidates = [color for color in foreground_colors if color != frame_color]\n    marker_count = min(counts[color] for color in marker_candidates)\n    marker_color = _unique_color_with_count(counts, marker_candidates, marker_count)\n\n    out = np.full_like(g, bg)\n    contour: set[tuple[int, int]] = set()\n    for r, c in np.argwhere(g == frame_color):\n        for nr, nc in neighbors4(int(r), int(c)):\n            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] == bg:\n                contour.add((int(nr), int(nc)))\n    assert contour, \"expected outline to touch background contour cells\"\n\n    for r, c in contour:\n        out[r, c] = marker_color\n    return out\n\n# --------------- generator (att2) ---------------\n\nGRID_MIN, GRID_MAX = 5, 16\nN_COLORS = 10\n\nSHAPE_MIN_HEIGHT, SHAPE_MAX_HEIGHT = 5, 7\nSHAPE_MIN_WIDTH, SHAPE_MAX_WIDTH = 3, 5\nSTART_WIDTH_MIN, START_WIDTH_MAX = 1, 2\nMAX_LOCAL_WIDTH = 5\n\nMARKER_MIN_CELLS, MARKER_MAX_CELLS = 1, 3\n\nGEN_ATTEMPTS = 300\n\nEDGE_TOUCH_TOP_BOTTOM = \"TB\"\nCORNER_EDGE_PAIRS = [\"TL\", \"TR\", \"BL\", \"BR\"]\nZERO_DELTA_SHIFTS = [-1, 0, 0, 0, 1]\n\n\ndef _gen_grow_parts(total, n):\n    n_twos = total - n\n    parts = [2] * n_twos + [1] * (n - n_twos)\n    random.shuffle(parts)\n    return parts\n\ndef _gen_drop_parts(total, n):\n    if n == 0:\n        return []\n    n_twos = random.randint(max(0, total - n), min(total // 2, n))\n    n_ones = total - 2 * n_twos\n    parts = [2] * n_twos + [1] * n_ones + [0] * (n - n_twos - n_ones)\n    random.shuffle(parts)\n    return parts\n\ndef _gen_widths(height, max_width):\n    start = random.randint(START_WIDTH_MIN, START_WIDTH_MAX)\n    diff = max_width - start\n    grow_steps = random.randint((diff + 1) // 2, min(diff, height - 1))\n    widths = [start]\n    for inc in _gen_grow_parts(diff, grow_steps):\n        widths.append(widths[-1] + inc)\n\n    remaining = height - len(widths)\n    min_end = max(1, max_width - 2 * remaining)\n    end_width = random.randint(min_end, max_width)\n    for dec in _gen_drop_parts(max_width - end_width, remaining):\n        widths.append(widths[-1] - dec)\n    return widths\n\ndef _gen_intervals(widths):\n    left, right = 0, widths[0] - 1\n    intervals = [(left, right)]\n    for prev_width, width in zip(widths, widths[1:]):\n        delta = width - prev_width\n        if delta == 2:\n            left -= 1\n            right += 1\n        elif delta == 1:\n            if random.choice([False, True]):\n                left -= 1\n            else:\n                right += 1\n        elif delta == 0:\n            shift = random.choice(ZERO_DELTA_SHIFTS) if width >= 2 else 0\n            left += shift\n            right += shift\n        elif delta == -1:\n            if random.choice([False, True]):\n                left += 1\n            else:\n                right -= 1\n        elif delta == -2:\n            left += 1\n            right -= 1\n        intervals.append((left, right))\n\n    min_left = min(l for l, _ in intervals)\n    intervals = [(l - min_left, r - min_left) for l, r in intervals]\n    if max(r for _, r in intervals) + 1 > MAX_LOCAL_WIDTH:\n        return None\n    return intervals\n\ndef _gen_local_mask(intervals):\n    height = len(intervals)\n    width = max(r for _, r in intervals) + 1\n    mask = np.zeros((height, width), dtype=bool)\n    for r, (c0, c1) in enumerate(intervals):\n        mask[r, c0 : c1 + 1] = True\n    return mask\n\ndef _gen_place_shape(grid_shape, local_mask, edge_pair):\n    rows, cols = grid_shape\n    height, width = local_mask.shape\n    if edge_pair == EDGE_TOUCH_TOP_BOTTOM:\n        if height != rows or width > cols - 2:\n            return None\n        return 0, random.randint(1, cols - width - 1)\n    if height >= rows or width >= cols:\n        return None\n    if edge_pair == \"TL\":\n        return 0, 0\n    if edge_pair == \"TR\":\n        return 0, cols - width\n    if edge_pair == \"BL\":\n        return rows - height, 0\n    return rows - height, cols - width\n\ndef _gen_full_mask(rows, cols, local_mask, r0, c0):\n    mask = np.zeros((rows, cols), dtype=bool)\n    height, width = local_mask.shape\n    mask[r0 : r0 + height, c0 : c0 + width] = local_mask\n    return mask\n\ndef _gen_layers(mask):\n    remaining = mask.copy()\n    layers = []\n    rows, cols = mask.shape\n    while np.any(remaining):\n        layer = np.zeros_like(mask)\n        for r, c in np.argwhere(remaining):\n            for nr, nc in neighbors4(int(r), int(c)):\n                if nr < 0 or nr >= rows or nc < 0 or nc >= cols or not remaining[nr, nc]:\n                    layer[r, c] = True\n                    break\n        layers.append(layer)\n        remaining[layer] = False\n    return layers\n\ndef _gen_contour(outline, shape):\n    rows, cols = shape.shape\n    contour = np.zeros_like(shape)\n    for r, c in np.argwhere(outline):\n        for nr, nc in neighbors4(int(r), int(c)):\n            if 0 <= nr < rows and 0 <= nc < cols and not shape[nr, nc]:\n                contour[nr, nc] = True\n    return contour\n\ndef _choose_canvas_and_shape_profile():\n    rows = random.randint(GRID_MIN, GRID_MAX)\n    cols = random.randint(GRID_MIN, GRID_MAX)\n    bg = random.randrange(N_COLORS)\n\n    edge_options = []\n    if rows <= SHAPE_MAX_HEIGHT:\n        edge_options.append(EDGE_TOUCH_TOP_BOTTOM)\n    if rows >= SHAPE_MIN_HEIGHT + 1:\n        edge_options.extend(CORNER_EDGE_PAIRS)\n    if not edge_options:\n        return None\n\n    edge_pair = random.choice(edge_options)\n    height = rows if edge_pair == EDGE_TOUCH_TOP_BOTTOM else random.randint(\n        SHAPE_MIN_HEIGHT, min(SHAPE_MAX_HEIGHT, rows - 1)\n    )\n    max_width_limit = cols - 2 if edge_pair == EDGE_TOUCH_TOP_BOTTOM else cols - 1\n    if max_width_limit < SHAPE_MIN_WIDTH:\n        return None\n    max_width = random.randint(SHAPE_MIN_WIDTH, min(SHAPE_MAX_WIDTH, max_width_limit))\n\n    intervals = _gen_intervals(_gen_widths(height, max_width))\n    if intervals is None:\n        return None\n    return rows, cols, bg, edge_pair, intervals\n\ndef _build_shape(rows, cols, edge_pair, intervals):\n    local_mask = _gen_local_mask(intervals)\n    placement = _gen_place_shape((rows, cols), local_mask, edge_pair)\n    if placement is None:\n        return None\n\n    shape = _gen_full_mask(rows, cols, local_mask, *placement)\n    shape_area = int(np.sum(shape))\n    if rows * cols - shape_area <= shape_area:\n        return None\n    return shape\n\ndef _split_valid_layers(shape):\n    layers = _gen_layers(shape)\n    if len(layers) < 2:\n        return None\n\n    outline = layers[0]\n    marker = layers[-1]\n    fill = shape & ~outline & ~marker\n\n    outline_count = int(np.sum(outline))\n    marker_count = int(np.sum(marker))\n    fill_count = int(np.sum(fill))\n    if marker_count < MARKER_MIN_CELLS or marker_count > MARKER_MAX_CELLS:\n        return None\n    if len(components_mask(outline, connectivity=8)) != 1:\n        return None\n    if fill_count and not (marker_count < fill_count < outline_count):\n        return None\n    return outline, fill, marker, fill_count\n\ndef _render_input(rows, cols, bg, masks, colors):\n    outline, fill, marker = masks\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import find_components, get_bg, neighbors4, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n                frontier.append((rr, cc))\n    return frontier\n\n\ndef _grow_body(area):\n    choices = [\n        (h, w)\n        for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n        for w in _inclusive_range(_BODY_WIDTH_RANGE)\n        if h * w >= area\n    ]\n    h, w = random.choice(choices)\n    cells = set(random.choice(_GROW_BODY_SEEDS))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, h, w)\n        if not frontier:\n            return _grow_body(area)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n\n\ndef _symmetric_body(area):\n    choices = []\n    for height in _inclusive_range(_BODY_HEIGHT_RANGE):\n        extra = area - height\n        if extra >= 2 and extra % 2 == 0 and extra // 2 <= height:\n            choices.append((height, extra // 2))\n    if not choices:\n        return _grow_body(area)\n\n    height, pair_count = random.choice(choices)\n    cells = {(r, 1) for r in range(height)}\n    rows = list(range(height))\n    random.shuffle(rows)\n    for r in rows[:pair_count]:\n        cells.add((r, 0))\n        cells.add((r, 2))\n\n    if height >= _SYMMETRIC_TRANSPOSE_MIN_HEIGHT and random.random() < _SYMMETRIC_TRANSPOSE_PROB:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/e729b7be.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the scene by adding the point-reflected copy of the colored object across the central marker.\n\n    Input structure\n    - The grid has odd dimensions, a dominant background, and a center-row marker color appearing only at the left edge, center, and right edge.\n    - A single divider color fills the center column except for the center marker.\n    - All remaining foreground pixels form the object to copy, entirely on the left side of the divider.\n    Rule\n    - Keep the input unchanged.\n    - For every object pixel, paint the pixel rotated 180 degrees around the center marker with the same color.\n    Key insight\n    - The center marker is the rotation center; the yellow-looking divider is not mirrored, it only separates the source from the empty target side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h % 2 == 1 and w % 2 == 1\n\n    cr, cc = h // 2, w // 2\n    bg = int(get_bg(g))\n\n    marker_color = int(g[cr, cc])\n    assert marker_color != bg\n    marker_mask = g == marker_color\n    expected_markers = np.zeros(g.shape, dtype=bool)\n    expected_markers[cr, 0] = True\n    expected_markers[cr, cc] = True\n    expected_markers[cr, w - 1] = True\n    assert np.array_equal(marker_mask, expected_markers)\n\n    center_col = g[:, cc]\n    divider_colors = {int(color) for color in np.unique(center_col) if int(color) != marker_color}\n    assert len(divider_colors) == 1\n    divider_color = next(iter(divider_colors))\n    assert divider_color != bg\n    expected_divider = np.zeros(g.shape, dtype=bool)\n    expected_divider[:, cc] = True\n    expected_divider[cr, cc] = False\n    assert np.array_equal(g == divider_color, expected_divider)\n\n    source_mask = (g != bg) & (g != marker_color) & (g != divider_color)\n    source_coords = np.argwhere(source_mask)\n    assert source_coords.size > 0\n    assert np.all(source_coords[:, 1] < cc)\n\n    out = g.copy()\n    for r, c in source_coords:\n        rr = 2 * cr - int(r)\n        rc = 2 * cc - int(c)\n        assert 0 <= rr < h and 0 <= rc < w\n        assert out[rr, rc] == bg\n        out[rr, rc] = g[r, c]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Colors and canvas bounds.\nBG_COLOR, DIVIDER_COLOR, MARKER_COLOR = 7, 4, 8\nGRID_SIZES, MIN_EMPTY_BORDER_ROWS = (15, 17, 19), 1\n\n# Convex source shape bounds.\nSOURCE_SPAN_RANGE = (10, 15)\nSOURCE_MAX_WIDTH_RANGE = (5, 7)\nSOURCE_EDGE_WIDTH_RANGE = (1, 3)\nWIDTH_STEP_CAP, SOURCE_PIXEL_RANGE = 2, (35, 83)\n\n# Color palette, band orders, and retry budget.\nSOURCE_COLORS = (0, 1, 2, 3, 5, 6, 9)\nSOURCE_COLOR_COUNT_RANGE, GEN_ATTEMPTS = (3, 7), 300\nCOLORING_KEYS = (\n    lambda item: (item[2], item[3], item[1]),\n    lambda item: (item[3], item[2], item[1]),\n    lambda item: (item[2] + item[3], item[2], item[1]),\n    lambda item: (item[2] - item[3], item[2], item[1]),\n)\n\n\ndef _gen_bounded_steps(total, slots, cap):\n    steps = []\n    remaining = total\n    for i in range(slots):\n        left = slots - i - 1\n        lo = max(0, remaining - cap * left)\n        hi = min(cap, remaining)\n        step = random.randint(lo, hi)\n        steps.append(step)\n        remaining -= step\n    return steps\n\n\ndef _gen_width_profile(span, max_width):\n    edge_width_hi = min(SOURCE_EDGE_WIDTH_RANGE[1], max_width)\n    start_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n    end_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n    min_up = (max_width - start_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n    min_down = (max_width - end_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n    if min_up + min_down + 1 > span:\n        return None\n\n    peak_start = random.randint(min_up, span - 1 - min_down)\n    peak_end = random.randint(peak_start, span - 1 - min_down)\n\n    widths = [start_width]\n    for step in _gen_bounded_steps(max_width - start_width, peak_start, WIDTH_STEP_CAP):\n        widths.append(widths[-1] + step)\n\n    widths.extend([max_width] * (peak_end - peak_start))\n\n    current = max_width\n    for step in _gen_bounded_steps(max_width - end_width, span - 1 - peak_end, WIDTH_STEP_CAP):\n        current -= step\n        widths.append(current)\n\n    area = sum(widths)\n    if not SOURCE_PIXEL_RANGE[0] <= area <= SOURCE_PIXEL_RANGE[1]:\n        return None\n    return widths\n\n\ndef _choose_source_extent(n, cr):\n    valid_spans = [s for s in range(SOURCE_SPAN_RANGE[0], SOURCE_SPAN_RANGE[1] + 1) if s <= n - 2 * MIN_EMPTY_BORDER_ROWS]\n    span = random.choice(valid_spans)\n    r0_min = max(MIN_EMPTY_BORDER_ROWS, cr - span + 1)\n    r0_max = min(cr, n - MIN_EMPTY_BORDER_ROWS - span)\n    r0 = random.randint(r0_min, r0_max)\n    return span, r0, cr - r0\n\n\ndef _paint_source_cells(out, r0, widths, outer, cc):\n    interior = []\n    source = []\n    for i, width in enumerate(widths):\n        r = r0 + i\n        c0 = cc - width\n        for j in range(width):\n            c = c0 + j\n            source.append((r, c))\n            if j == 0:\n                out[r, c] = outer\n            else:\n                interior.append((r, c, i, j))\n    return source, interior\n\n\ndef _gen_color_source(out, r0, widths, colors, cc):\n    outer = colors[0]\n    inner = colors[1:]\n    source, interior = _paint_source_cells(out, r0, widths, outer, cc)\n    if len(interior) < len(inner):\n        return None\n\n    key = COLORING_KEYS[random.randrange(len(COLORING_KEYS))]\n    interior.sort(key=key)\n    band_count = len(inner)\n    for rank, (r, c, _, _) in enumerate(interior):\n        out[r, c] = inner[min(band_count - 1, rank * band_count // len(interior))]\n\n    return source\n\n\ndef _reflect_source(out, source, cr, cc):\n    reflected = []\n    for r, c in source:\n        rr = 2 * cr - r\n        rc = 2 * cc - c\n        if out[rr, rc] != BG_COLOR:\n            return None\n        out[rr, rc] = out[r, c]\n        reflected.append((rr, rc))\n    return reflected\n\n\ndef _gen_attempt():\n    n = random.choice(GRID_SIZES)\n    cr = cc = n // 2\n    out = np.full((n, n), BG_COLOR, dtype=int)\n    out[:, cc] = DIVIDER_COLOR\n    out[cr, [0, cc, n - 1]] = MARKER_COLOR\n\n    span, r0, center_i = _choose_source_extent(n, cr)\n    max_width = random.randint(*SOURCE_MAX_WIDTH_RANGE)\n    widths = _gen_width_profile(span, max_width)\n    if widths is None:\n        return None\n    if widths[center_i] >= cc:\n        return None\n\n    color_count = random.randint(*SOURCE_COLOR_COUNT_RANGE)\n    colors = random.sample(SOURCE_COLORS, color_count)\n    source = _gen_color_source(out, r0, widths, colors, cc)\n    if source is None:\n        return None\n\n    reflected = _reflect_source(out, source, cr, cc)\n    if reflected is None:\n        return None\n\n    inp = out.copy()\n    for r, c in reflected:\n        inp[r, c] = BG_COLOR\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input():\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid e729b7be input\")\n","exit_code":0,"status":"completed"}}
