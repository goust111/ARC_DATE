{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/3bd292e8.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import defaultdict, deque\n\nimport numpy as np\n\nfrom arc_utils import Color, get_bg, label_mask, neighbors4\nimport itertools\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor wall-separated background regions alternately, starting with grey in the lower-left region.\n\n    Input structure\n    - The grid has one dominant background color and one foreground wall color.\n    - The wall pixels form one or more 4-connected one-cell-thick segments.\n    - Each wall segment separates exactly two 4-connected background regions.\n    Rule\n    - Keep all wall pixels unchanged.\n    - Label the 4-connected background regions and connect two labels when they\n      touch opposite sides of the same wall segment.\n    - Color the region containing the lower-left corner grey, then flip between\n      grey and green across every wall adjacency.\n    Key insight\n    - The red walls define a bipartite map of regions; the lower-left background\n      region fixes which side of the alternating coloring is grey.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    H, W = g.shape\n\n    colors = set(map(int, g.flat))\n    assert len(colors) == 2, \"expected exactly one background color and one wall color\"\n    bg = get_bg(g)\n    wall_colors = colors - {int(bg)}\n    assert len(wall_colors) == 1\n    wall = int(next(iter(wall_colors)))\n\n    bg_lab, n_regions = label_mask(g == int(bg), connectivity=4)\n    assert n_regions >= 2, \"walls must split the background into multiple regions\"\n    start_region = int(bg_lab[H - 1, 0])\n    assert start_region > 0, \"lower-left corner must belong to a background region\"\n\n    wall_lab, n_walls = label_mask(g == wall, connectivity=4)\n    assert n_walls >= 1\n\n    graph: dict[int, set[int]] = defaultdict(set)\n    for wall_id in range(1, n_walls + 1):\n        adjacent_regions: set[int] = set()\n        for r, c in np.argwhere(wall_lab == wall_id):\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W:\n                    region_id = int(bg_lab[rr, cc])\n                    if region_id > 0:\n                        adjacent_regions.add(region_id)\n\n        assert len(adjacent_regions) == 2, \"each wall segment must separate exactly two regions\"\n        a, b = tuple(adjacent_regions)\n        graph[a].add(b)\n        graph[b].add(a)\n\n    parity = {start_region: 0}\n    queue = deque([start_region])\n    while queue:\n        region = queue.popleft()\n        for neighbor in graph[region]:\n            neighbor_parity = 1 - parity[region]\n            if neighbor in parity:\n                assert parity[neighbor] == neighbor_parity, \"region graph must be bipartite\"\n            else:\n                parity[neighbor] = neighbor_parity\n                queue.append(neighbor)\n\n    assert set(parity) == set(range(1, n_regions + 1)), \"all background regions must be wall-connected\"\n\n    out = g.copy()\n    for region_id, region_parity in parity.items():\n        out[bg_lab == region_id] = Color.GREY if region_parity == 0 else Color.GREEN\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Grid, colors, and retry policy.\nGRID_SIZES = (7, 8, 9)\nGRID_SIZES_FOR_THREE_WALLS = (8, 9)\nWALL_COUNT_RANGE = (1, 3)\nMAX_GENERATION_ATTEMPTS = 300\nBACKGROUND_COLOR = Color.ORANGE\nWALL_COLOR = Color.RED\n\n# Wall geometry constraints.\nWALL_LENGTH_RANGE = (4, 13)\nWALL_TURN_RANGE = (1, 5)\nENDPOINT_SPACING = 2\nMAX_STAIR_PARTS = 3\nMIN_FIRST_STAIR_COL = 1\n\n# Left-right corridor layout.\nLR_LAYOUT_MAX_WALLS = 2\nLR_LAYOUT_PROBABILITY = 0.55\nLR_TURN_OPTIONS = (2, 4)\nLR_CORRIDOR_MAX_SPAN = 3\nLR_CORRIDOR_GAP = 2\n\n# Canonical grids are randomly mapped through one of eight dihedral transforms.\nTRANSFORM_OPS = 8\n\n\ndef _contains(bounds: tuple[int, int], value: int) -> bool:\n    lo, hi = bounds\n    return lo <= int(value) <= hi\n\n\ndef _paint_wall_path(grid: np.ndarray, cells: list[tuple[int, int]]) -> bool:\n    for r, c in cells:\n        if grid[r, c] != BACKGROUND_COLOR:\n            return False\n        grid[r, c] = WALL_COLOR\n    return True\n\n\ndef _split_positive(total: int, parts: int) -> list[int]:\n    if parts == 1:\n        return [int(total)]\n    cuts = sorted(random.sample(range(1, int(total)), int(parts) - 1))\n    return [b - a for a, b in zip([0] + cuts, cuts + [int(total)])]\n\n\ndef _spaced_combos(values: list[int], n: int) -> list[tuple[int, ...]]:\n    return [\n        combo\n        for combo in itertools.combinations(values, n)\n        if all(combo[i + 1] - combo[i] >= ENDPOINT_SPACING for i in range(len(combo) - 1))\n    ]\n\n\ndef _choose_endpoints(H: int, W: int, n_walls: int) -> tuple[tuple[int, ...], tuple[int, ...]] | None:\n    rows = _spaced_combos(list(range(1, H - 1)), n_walls)\n    cols = _spaced_combos(list(range(1, W - 1)), n_walls)\n    valid: list[tuple[tuple[int, ...], tuple[int, ...]]] = []\n    for start_rows in rows:\n        for cols_asc in cols:\n            end_cols = tuple(reversed(cols_asc))\n            lengths = [c + (H - 1 - r) + 1 for r, c in zip(start_rows, end_cols)]\n            if all(_contains(WALL_LENGTH_RANGE, length) for length in lengths):\n                valid.append((start_rows, end_cols))\n    return random.choice(valid) if valid else None\n\n\ndef _stair_path_lb(H: int, W: int, start_r: int, end_c: int, min_first_col: int) -> list[tuple[int, int]] | None:\n    down = H - 1 - int(start_r)\n    right = int(end_c)\n    max_parts = min(MAX_STAIR_PARTS, down, right)\n    feasible = [k for k in range(1, max_parts + 1) if right >= int(min_first_col) + k - 1]\n    if not feasible:\n        return None\n    weights = [k * k for k in feasible]\n    k = random.choices(feasible, weights=weights, k=1)[0]\n\n    if k == 1:\n        horiz = [right]\n    else:\n        first = random.randint(int(min_first_col), right - (k - 1))\n        horiz = [first] + _split_positive(right - first, k - 1)\n    vert = _split_positive(down, k)\n\n    r, c = int(start_r), 0\n    cells = [(r, c)]\n    for h_run, v_run in zip(horiz, vert):\n        for _ in range(h_run):\n            c += 1\n            cells.append((r, c))\n        for _ in range(v_run):\n            r += 1\n            cells.append((r, c))\n\n    if (r, c) != (H - 1, int(end_c)):\n        return None\n    return cells\n\n\ndef _build_lower_left_grid(H: int, W: int, n_walls: int) -> np.ndarray | None:\n    endpoints = _choose_endpoints(H, W, n_walls)\n    if endpoints is None:\n        return None\n    start_rows, end_cols = endpoints\n\n    grid = np.full((H, W), BACKGROUND_COLOR, dtype=int)\n    for i, (start_r, end_c) in enumerate(zip(start_rows, end_cols)):\n        min_first_col = end_cols[i + 1] + ENDPOINT_SPACING if i + 1 < n_walls else MIN_FIRST_STAIR_COL\n        cells = _stair_path_lb(H, W, start_r, end_c, min_first_col)\n        if cells is None or not _paint_wall_path(grid, cells):\n            return None\n    return grid\n\n\ndef _choose_lr_corridors(H: int, n_walls: int) -> tuple[tuple[int, int], ...] | None:\n    intervals = []\n    for lo in range(1, H - 2):\n        for hi in range(lo + 1, min(H - 2, lo + LR_CORRIDOR_MAX_SPAN) + 1):\n            intervals.append((lo, hi))\n    valid: list[tuple[tuple[int, int], ...]] = []\n    for combo in itertools.combinations(intervals, n_walls):\n        if all(combo[i][1] + LR_CORRIDOR_GAP <= combo[i + 1][0] for i in range(n_walls - 1)):\n            valid.append(combo)\n    return random.choice(valid) if valid else None\n\n\ndef _lr_path(W: int, lo: int, hi: int) -> list[tuple[int, int]] | None:\n    short_turn, long_turn = LR_TURN_OPTIONS\n    turn_goal = random.choice(LR_TURN_OPTIONS)\n    if turn_goal == long_turn and W - 1 < long_turn:\n        turn_goal = short_turn\n\n    if turn_goal == short_turn:\n        h1 = random.randint(1, W - 2)\n        horiz = [h1, W - 1 - h1]\n        r0, r1 = random.sample(range(lo, hi + 1), 2)\n        rows = [r0, r1]\n    else:\n        if hi - lo >= 2:\n            if random.random() < 0.5:\n                rows = [lo, random.randint(lo + 1, hi - 1), hi]\n            else:\n                rows = [hi, random.randint(lo + 1, hi - 1), lo]\n            middle_min = 1\n        else:\n            rows = [lo, hi, lo] if random.random() < 0.5 else [hi, lo, hi]\n            middle_min = 2\n        if W - 1 < middle_min + 2:\n            return None\n        h2 = random.randint(middle_min, W - 3)\n        h1 = random.randint(1, W - 1 - h2 - 1)\n        horiz = [h1, h2, W - 1 - h1 - h2]\n\n    r, c = int(rows[0]), 0\n    cells = [(r, c)]\n    for i, h_run in enumerate(horiz):\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/7e2bad24.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/7e2bad24.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, find_components, get_bg, in_bounds\nimport random\n\n\ndef _coord_set(coords: np.ndarray) -> set[tuple[int, int]]:\n    return {tuple(map(int, rc)) for rc in coords}\n\n\ndef _is_contiguous_diagonal(coords: set[tuple[int, int]]) -> bool:\n    if len(coords) < 2:\n        return False\n\n    if len({r - c for r, c in coords}) == 1:\n        rows = sorted(r for r, _c in coords)\n        cols = sorted(c for _r, c in coords)\n    elif len({r + c for r, c in coords}) == 1:\n        rows = sorted(r for r, _c in coords)\n        cols = sorted(c for _r, c in coords)\n    else:\n        return False\n\n    return (\n        rows == list(range(rows[0], rows[-1] + 1))\n        and cols == list(range(cols[0], cols[-1] + 1))\n        and len(coords) == rows[-1] - rows[0] + 1\n    )\n\n\ndef _ray_seed(g: np.ndarray, bg: int) -> tuple[int, set[tuple[int, int]]]:\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    candidates: list[tuple[int, set[tuple[int, int]]]] = []\n    for comp in comps:\n        coords = _coord_set(comp[\"coords\"])\n        if _is_contiguous_diagonal(coords):\n            candidates.append((int(comp[\"color\"]), coords))\n\n    assert len(candidates) == 1, \"expected one diagonal ray seed\"\n    return candidates[0]\n\n\ndef _initial_state(\n    shape: tuple[int, int], coords: set[tuple[int, int]]\n) -> tuple[int, int, int, int]:\n    if len({r - c for r, c in coords}) == 1:\n        first = min(coords)\n        last = max(coords)\n        endpoints = ((first, (-1, -1)), (last, (1, 1)))\n    else:\n        assert len({r + c for r, c in coords}) == 1, \"ray seed must be diagonal\"\n        top = min(coords)\n        bottom = max(coords)\n        endpoints = ((top, (-1, 1)), (bottom, (1, -1)))\n\n    candidates = []\n    for (r, c), (dr, dc) in endpoints:\n        if in_bounds(shape, r + dr, c + dc):\n            candidates.append((r, c, dr, dc))\n\n    assert len(candidates) == 1, \"ray seed must have exactly one in-bounds extension\"\n    return candidates[0]\n\n\ndef _mirror_orientations(g: np.ndarray, bg: int) -> dict[tuple[int, int], str]:\n    orientations: dict[tuple[int, int], str] = {}\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[Color.RED])\n    for comp in comps:\n        coords = _coord_set(comp[\"coords\"])\n        rows = sorted({r for r, _c in coords})\n        cols = sorted({c for _r, c in coords})\n\n        if len(rows) == 1:\n            assert cols == list(range(cols[0], cols[-1] + 1)), \"red mirror must be contiguous\"\n            orientation = \"horizontal\"\n        elif len(cols) == 1:\n            assert rows == list(range(rows[0], rows[-1] + 1)), \"red mirror must be contiguous\"\n            orientation = \"vertical\"\n        else:\n            raise AssertionError(\"red mirror must be a horizontal or vertical segment\")\n\n        for rc in coords:\n            orientations[rc] = orientation\n\n    return orientations\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extend the diagonal blue ray through the grid, reflecting it off red line-segment mirrors.\n\n    Input structure\n    - Black-background grid with one diagonal 8-connected blue ray seed.\n    - Red foreground objects, when present, are straight horizontal or vertical mirror segments.\n    - Other foreground bars are transparent to the ray and may be overwritten where the ray crosses them.\n\n    Rule\n    - Start from the ray seed endpoint whose outward diagonal extension remains inside the grid.\n    - Paint the ray continuously in that diagonal direction until it leaves the grid.\n    - If the next cell is a red mirror, do not paint it; reflect by flipping the row direction on a horizontal mirror or the column direction on a vertical mirror.\n\n    Key insight\n    - The non-red bars are decoys: only red bars reflect the diagonal path, while all other crossed cells become blue.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    ray_color, seed = _ray_seed(g, bg)\n    r, c, dr, dc = _initial_state(g.shape, seed)\n    mirrors = _mirror_orientations(g, bg)\n\n    out = g.copy()\n    seen: set[tuple[int, int, int, int]] = set()\n    while True:\n        state = (r, c, dr, dc)\n        assert state not in seen, \"ray path must not loop\"\n        seen.add(state)\n\n        nr, nc = r + dr, c + dc\n        if not in_bounds(g.shape, nr, nc):\n            break\n\n        if int(g[nr, nc]) == Color.RED:\n            orientation = mirrors.get((nr, nc))\n            assert orientation is not None, \"red cell must belong to a mirror segment\"\n            if orientation == \"horizontal\":\n                dr = -dr\n            else:\n                assert orientation == \"vertical\"\n                dc = -dc\n            continue\n\n        out[nr, nc] = ray_color\n        r, c = nr, nc\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and color layout.\nGRID_HEIGHT = 16\nGRID_WIDTH = 16\nBACKGROUND_COLOR = 0\n\n# Ray and seed sampling ranges.\nREFLECTION_COUNT_RANGE = (0, 4)\nSEED_LENGTH_RANGE = (3, 6)\nTOTAL_PATH_LENGTH_RANGE = (15, 16)\nNEW_CELLS_RANGE = (9, 13)\nDIAGONAL_CHOICES = (-1, 1)\nSTART_EDGES = (\"top\", \"bottom\", \"left\", \"right\")\n\n# Bar structure ranges and orientations.\nBAR_LENGTH_RANGE = (4, 14)\nMIRROR_ORIENTATIONS = [\"horizontal\", \"vertical\"]\nDECOY_COUNT_RANGE = (0, 3)\nDECOY_PLACEMENT_ATTEMPTS = 30\n\n# Rejection sampling budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _inside(r: int, c: int) -> bool:\n    return 0 <= r < GRID_HEIGHT and 0 <= c < GRID_WIDTH\n\n\ndef _random_start_state() -> tuple[int, int, int, int]:\n    \"\"\"Choose a boundary cell with a diagonal direction whose backward extension is OOB.\"\"\"\n    edge = random.choice(START_EDGES)\n    if edge == \"top\":\n        return 0, random.randint(0, GRID_WIDTH - 1), 1, random.choice(DIAGONAL_CHOICES)\n    if edge == \"bottom\":\n        return (\n            GRID_HEIGHT - 1,\n            random.randint(0, GRID_WIDTH - 1),\n            -1,\n            random.choice(DIAGONAL_CHOICES),\n        )\n    if edge == \"left\":\n        return random.randint(0, GRID_HEIGHT - 1), 0, random.choice(DIAGONAL_CHOICES), 1\n    return (\n        random.randint(0, GRID_HEIGHT - 1),\n        GRID_WIDTH - 1,\n        random.choice(DIAGONAL_CHOICES),\n        -1,\n    )\n\n\ndef _build_seed_cells(\n    r0: int,\n    c0: int,\n    dr: int,\n    dc: int,\n    seed_len: int,\n) -> list[tuple[int, int]] | None:\n    cells = []\n    for i in range(seed_len):\n        sr, sc = r0 + i * dr, c0 + i * dc\n        if not _inside(sr, sc):\n            return None\n        cells.append((sr, sc))\n    return cells\n\n\ndef _split_path_segments(new_cells_needed: int, n_reflections: int) -> list[int] | None:\n    \"\"\"Partition painted cells across straight ray segments before each reflection.\"\"\"\n    if n_reflections == 0:\n        return [new_cells_needed]\n    if new_cells_needed < n_reflections + 1:\n        return None\n\n    cuts = sorted(random.sample(range(1, new_cells_needed), n_reflections))\n    segments = []\n    prev = 0\n    for cut in cuts:\n        segments.append(cut - prev)\n        prev = cut\n    segments.append(new_cells_needed - prev)\n    return segments\n\n\ndef _walk_segment(\n    r: int,\n    c: int,\n    dr: int,\n    dc: int,\n    seg_len: int,\n    occupied: set[tuple[int, int]],\n    path_cells: list[tuple[int, int]],\n) -> tuple[int, int] | None:\n    \"\"\"Append seg_len new ray cells and return the segment endpoint.\"\"\"\n    for _ in range(seg_len):\n        nr, nc = r + dr, c + dc\n        if not _inside(nr, nc) or (nr, nc) in occupied:\n            return None\n        path_cells.append((nr, nc))\n        occupied.add((nr, nc))\n        r, c = nr, nc\n    return r, c\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/c6141b15.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/c6141b15.py\"","aggregated_output":"from itertools import combinations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, draw_line, find_components, get_bg, random_sprite\nimport random\n\n\nCoord = tuple[int, int]\n\n\ndef _sgn(x: int) -> int:\n    return (x > 0) - (x < 0)\n\n\ndef _straight_line_cells(a: Coord, b: Coord) -> set[Coord] | None:\n    r0, c0 = a\n    r1, c1 = b\n    dr = r1 - r0\n    dc = c1 - c0\n    if not (dr == 0 or dc == 0 or abs(dr) == abs(dc)):\n        return None\n    sr = _sgn(dr)\n    sc = _sgn(dc)\n    return {(r0 + i * sr, c0 + i * sc) for i in range(max(abs(dr), abs(dc)) + 1)}\n\n\ndef _segment_endpoints(coords: np.ndarray) -> tuple[Coord, Coord] | None:\n    cells = {tuple(map(int, rc)) for rc in coords}\n    if len(cells) < 2:\n        return None\n\n    endpoints: list[Coord] = []\n    for r, c in cells:\n        degree = sum(\n            (r + dr, c + dc) in cells\n            for dr in (-1, 0, 1)\n            for dc in (-1, 0, 1)\n            if (dr, dc) != (0, 0)\n        )\n        if degree == 1:\n            endpoints.append((r, c))\n        elif degree != 2:\n            return None\n\n    if len(endpoints) != 2:\n        return None\n    line = _straight_line_cells(endpoints[0], endpoints[1])\n    if line != cells:\n        return None\n    return endpoints[0], endpoints[1]\n\n\ndef _normalized_shape(coords: np.ndarray) -> frozenset[Coord]:\n    r0, c0, _r1, _c1 = bbox_coords(coords)\n    return frozenset((int(r - r0), int(c - c0)) for r, c in coords)\n\n\ndef _center_anchor(coords: np.ndarray) -> Coord | None:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    if (r0 + r1) % 2 or (c0 + c1) % 2:\n        return None\n    anchor = ((r0 + r1) // 2, (c0 + c1) // 2)\n    if anchor not in {tuple(map(int, rc)) for rc in coords}:\n        return None\n    return anchor\n\n\ndef _are_repeated_centered_sprites(components: list[np.ndarray]) -> bool:\n    if len(components) < 2:\n        return False\n    shapes = {_normalized_shape(coords) for coords in components}\n    return len(shapes) == 1 and all(_center_anchor(coords) is not None for coords in components)\n\n\ndef _non_collinear_three(points: list[Coord]) -> bool:\n    if len(points) != 3:\n        return True\n    (r0, c0), (r1, c1), (r2, c2) = points\n    return (r1 - r0) * (c2 - c0) != (r2 - r0) * (c1 - c0)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swap a connector segment with repeated marker sprites by connecting the marker anchors and stamping the sprite at the segment endpoints.\n\n    Input structure\n    The grid has one background color and exactly two foreground colors. One foreground color forms a single straight 8-connected segment. The other foreground color forms two or more identical centered sprites.\n\n    Rule\n    Build a background canvas of the same size. Draw straight connector-color segments between every pair of original sprite anchors. Then stamp the marker sprite, using its centered anchor, onto the two endpoints of the original connector segment.\n\n    Key insight\n    The original segment endpoints are the destinations for the repeated sprite, while the original sprite centers become the vertices of the new connector-color complete graph.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2\n\n    components_by_color = {\n        color: [\n            component[\"coords\"]\n            for component in find_components(g, bg=bg, colors=[color], connectivity=8)\n        ]\n        for color in colors\n    }\n\n    connector_colors = [\n        color\n        for color, components in components_by_color.items()\n        if len(components) == 1 and _segment_endpoints(components[0]) is not None\n    ]\n    sprite_colors = [\n        color\n        for color, components in components_by_color.items()\n        if _are_repeated_centered_sprites(components)\n    ]\n    assert len(connector_colors) == 1\n    assert len(sprite_colors) == 1\n\n    connector_color = connector_colors[0]\n    sprite_color = sprite_colors[0]\n    assert connector_color != sprite_color\n\n    endpoint_pair = _segment_endpoints(components_by_color[connector_color][0])\n    assert endpoint_pair is not None\n\n    sprite_components = components_by_color[sprite_color]\n    anchors: list[Coord] = []\n    for coords in sprite_components:\n        anchor = _center_anchor(coords)\n        assert anchor is not None\n        anchors.append(anchor)\n    assert _non_collinear_three(anchors), \"three repeated sprites must form a non-collinear triangle\"\n\n    reference_anchor = _center_anchor(sprite_components[0])\n    assert reference_anchor is not None\n    sprite_offsets = [\n        (int(r - reference_anchor[0]), int(c - reference_anchor[1]))\n        for r, c in sprite_components[0]\n    ]\n\n    out = np.full_like(g, bg)\n    for a, b in combinations(anchors, 2):\n        assert _straight_line_cells(a, b) is not None\n        draw_line(out, a[0], a[1], end_r=b[0], end_c=b[1], color=connector_color)\n\n    height, width = out.shape\n    for endpoint_r, endpoint_c in endpoint_pair:\n        for dr, dc in sprite_offsets:\n            r = endpoint_r + dr\n            c = endpoint_c + dc\n            assert 0 <= r < height and 0 <= c < width\n            out[r, c] = sprite_color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and colors.\nGRID_SIZE_MIN = 11\nGRID_SIZE_MAX = 16\nBACKGROUND_COLOR = 7\nFOREGROUND_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n\n# Symmetric sprite shape.\nSPRITE_HEIGHT_CHOICES = [1, 3, 3, 5, 5]\nSPRITE_WIDTH_CHOICES = [1, 3, 3, 5]\nSPRITE_DIM_SWAP_PROB = 0.5\nSPRITE_QUADRANT_FILL_PROB = 0.5\nSPRITE_BUILD_RETRIES = 50\n\n# Anchor layout.\nTHREE_SPRITE_PROB = 0.85\nANCHOR_LAYOUT_RETRIES = 100\nANCHOR_DIRECTIONS = ['h', 'v', 'd1', 'd2']\nTWO_ANCHOR_DIST_MIN = 3\nTWO_ANCHOR_DIST_MAX = 8\nTRIANGLE_DELTA_MIN = 3\nTRIANGLE_DELTA_MAX = 7\nTRIANGLE_ROTATIONS = [0, 1, 2, 3]\n\n# Connector segment.\nSEGMENT_RETRIES = 100\nSEGMENT_LENGTH_MIN = 6\nSEGMENT_LENGTH_MAX = 10\n\n# Overall retry budget.\nGENERATE_RETRIES = 300\n\n\ndef _gen2_symmetric_sprite(color):\n    \"\"\"Generate one connected LR+UD symmetric sprite with a filled center.\"\"\"\n    h = random.choice(SPRITE_HEIGHT_CHOICES)\n    w = random.choice(SPRITE_WIDTH_CHOICES)\n    if random.random() < SPRITE_DIM_SWAP_PROB:\n        h, w = w, h\n\n    if h == 1 and w == 1:\n        return np.array([[color]])\n\n    half_h = h // 2 + 1\n    half_w = w // 2 + 1\n    sprite = np.zeros((h, w), dtype=int)\n    cr, cc = h // 2, w // 2\n    sprite[cr, cc] = color\n\n    for r in range(half_h):\n        for c in range(half_w):\n            if random.random() < SPRITE_QUADRANT_FILL_PROB:\n                sprite[r, c] = color\n                sprite[r, w - 1 - c] = color\n                sprite[h - 1 - r, c] = color\n                sprite[h - 1 - r, w - 1 - c] = color\n\n    sprite[cr, cc] = color\n\n    from arc_utils import is_contiguous\n    mask = (sprite != 0)\n    if not mask.any():\n        sprite[cr, cc] = color\n        mask = (sprite != 0)\n    if not is_contiguous(mask, background=0, connectivity=8):\n        return None\n\n    if not np.any(sprite[0, :]) or not np.any(sprite[-1, :]):\n        return None\n    if not np.any(sprite[:, 0]) or not np.any(sprite[:, -1]):\n        return None\n\n    return sprite\n\n\ndef _gen_sprite_offsets(sprite):\n    h, w = sprite.shape\n    cr, cc = h // 2, w // 2\n    offsets = []\n    for r in range(h):\n        for c in range(w):\n            if sprite[r, c] != 0:\n                offsets.append((r - cr, c - cc))\n    return offsets\n\n\ndef _gen_sprite_cells_at(offsets, anchor_r, anchor_c):\n    return {(anchor_r + dr, anchor_c + dc) for dr, dc in offsets}\n\n\ndef _fits_in_grid(offsets, anchor_r, anchor_c, h, w):\n    for dr, dc in offsets:\n        r, c = anchor_r + dr, anchor_c + dc\n        if not (0 <= r < h and 0 <= c < w):\n            return False\n    return True\n\n\ndef _choose_sprite(sprite_color):\n    for _ in range(SPRITE_BUILD_RETRIES):\n        sprite = _gen2_symmetric_sprite(sprite_color)\n","exit_code":0,"status":"completed"}}
