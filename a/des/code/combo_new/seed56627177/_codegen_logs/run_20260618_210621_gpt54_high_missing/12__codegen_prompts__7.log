{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/35ab12c3.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete outlined shapes and carry attached shadow pixels along their edges.\n\n    Input structure:\n    - bg = background. Each active color marks vertices of an 8-direction aligned outline.\n    - A start vertex can have adjacent non-bg, different-colored shadow pixels.\n    - Other colored pixels may be distractors unless they lie on valid drawable edges.\n\n    Rule:\n    - For each color, order its pixels by polar angle around their centroid to form a cycle.\n    - Draw only horizontal, vertical, or 45-degree edges whose interiors are clear.\n    - From the chosen start vertex, copy adjacent shadow offsets along each drawable edge\n      when the parallel path is in bounds and clear.\n\n    Key insight: The main outline is reconstructed first, then the start vertex's neighbor offsets define parallel shadow strokes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = _bg_color(g)\n\n    out = g.copy()\n\n    colors = sorted(set(int(v) for v in np.unique(g)) - {bg})\n    for col in colors:\n        pts_rc = [tuple(map(int, p)) for p in np.argwhere(g == col)]\n        if len(pts_rc) < 2:\n            continue\n\n        cycle = _angle_cycle(pts_rc)\n        if len(cycle) < 2:\n            continue\n\n        # Choose a start vertex that has a non-bg, different-color neighbor in the original input.\n        seed_idxs = []\n        for i, (r, c) in enumerate(cycle):\n            for drn, dcn in DIR8:\n                rr = r + drn\n                cc = c + dcn\n                if 0 <= rr < h and 0 <= cc < w:\n                    v = int(g[rr, cc])\n                    if v != bg and v != col:\n                        seed_idxs.append(i)\n                        break\n\n        if seed_idxs:\n            # Stable: pick the seed vertex with smallest (r,c).\n            start = min(seed_idxs, key=lambda i: (cycle[i][0], cycle[i][1]))\n        else:\n            start = min(range(len(cycle)), key=lambda i: (cycle[i][0], cycle[i][1]))\n\n        cycle = cycle[start:] + cycle[:start]\n\n        # Carry neighbor offsets/colors from the chosen start vertex.\n        carried: list[tuple[int, int, int]] = []\n        sr0, sc0 = cycle[0]\n        for drn, dcn in DIR8:\n            rr = sr0 + drn\n            cc = sc0 + dcn\n            if 0 <= rr < h and 0 <= cc < w:\n                v = int(g[rr, cc])\n                if v != bg and v != col:\n                    carried.append((drn, dcn, v))\n\n        if len(cycle) == 2:\n            edges = [(cycle[0], cycle[1])]\n        else:\n            edges = [(cycle[i], cycle[(i + 1) % len(cycle)]) for i in range(len(cycle))]\n\n        drawable_edges: list[tuple[tuple[int, int], tuple[int, int]]] = []\n        for (r0, c0), (r1, c1) in edges:\n            if not _aligned_8(r0, c0, r1, c1):\n                continue\n            if not _clear_in_original(g, r0, c0, r1, c1, bg, allow={col}):\n                continue\n            drawable_edges.append(((r0, c0), (r1, c1)))\n\n        # Phase 1: draw all main hull edges (avoids parallel lines blocking main lines).\n        for (r0, c0), (r1, c1) in drawable_edges:\n            _draw_line_bg_only(out, r0, c0, r1, c1, col, bg)\n\n        # Phase 2: draw parallel edges for the carried neighbors.\n        for (r0, c0), (r1, c1) in drawable_edges:\n            drs, dcs = _step_dir(r0, c0, r1, c1)\n            for drn, dcn, ncol in carried:\n                # Skip collinear offsets (along the edge direction or directly opposite).\n                if drs * dcn - dcs * drn == 0:\n                    continue\n                rr0 = r0 + drn\n                cc0 = c0 + dcn\n                rr1 = r1 + drn\n                cc1 = c1 + dcn\n                if not (0 <= rr0 < h and 0 <= cc0 < w and 0 <= rr1 < h and 0 <= cc1 < w):\n                    continue\n                if not _aligned_8(rr0, cc0, rr1, cc1):\n                    continue\n                if not _clear_in_original(g, rr0, cc0, rr1, cc1, bg, allow=set()):\n                    continue\n                _draw_line_bg_only(out, rr0, cc0, rr1, cc1, ncol, bg)\n\n    return out\n\n# --------------- generator (attempt 2 (Codex)) ---------------\n\n# ---- CFG: canvas and palette ----\nBG = 0\nCOLORS = [1, 2, 3, 4, 6, 7, 8]\nCANVAS_H_RANGE = (15, 23)          # randint hi exclusive: H in [15, 22]\nCANVAS_W_JITTER = (-3, 4)          # W = clip(H + randint(lo, hi), 15, 22); hi exclusive\nCANVAS_W_CLIP = (15, 22)\n\n# ---- CFG: structural counts ----\nSHAPE_COUNT_RANGE = (2, 5)         # randint hi exclusive: shape_count in [2, 4]\nMAX_SHADOWS_CAP = 3                # cap on number of shadows attached\nDISTRACTOR_PROB = 0.5\nPLACEMENT_PADDING = 1\nPLACEMENT_PAD_CONNECTIVITY = 8\n\n# ---- CFG: shape geometry ----\nLINE_VERTICES_RANGE = (2, 8)       # n_vertices in [2, 7]\nLINE_TOTAL_LENGTH = 13             # total span of a polyline\nLINE_MIN_GAP = 2                   # min gap between consecutive polyline vertices\nTRIANGLE_SIDE_RANGE = (2, 8)\nRECT_H_RANGE = (2, 9)\nRECT_W_RANGE = (2, 9)\nDIAMOND_ARM_RANGE = (2, 6)\nPENTAGON_ROOF_RANGE = (2, 5)\nPENTAGON_WALL_RANGE = (2, 7)\nHEXAGON_SLANT_RANGE = (2, 5)\nHEXAGON_WALL_RANGE = (2, 6)\n\n# ---- CFG: shape mixture ----\n# builders list is aligned with SHAPE_WEIGHTS below\nSHAPE_WEIGHTS = np.array([0.28, 0.18, 0.18, 0.14, 0.12, 0.10], dtype=float)\n\n# ---- CFG: distractor geometry ----\nDISTRACTOR_COUNT_RANGE = (1, 4)    # 1-3 pixels\nDISTRACTOR_BBOX_RANGE = (2, 5)     # 2-4 rows/cols for multi-pixel distractors\nDISTRACTOR_RETRIES = 50\n\n# ---- CFG: retry budgets ----\nSHAPE_PLACEMENT_RETRIES = 40\nGENERATE_RETRIES = 300\n\n\ndef _aligned(dr: int, dc: int) -> bool:\n","exit_code":0,"status":"completed"}}
