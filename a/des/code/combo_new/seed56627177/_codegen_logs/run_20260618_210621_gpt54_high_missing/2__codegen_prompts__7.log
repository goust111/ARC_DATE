{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\n\nDIR4=[(-1,0),(0,1),(1,0),(0,-1)]\n\ndef rect(h,w):\n    pts=[]\n    pts += [(0,c) for c in range(w)]\n    pts += [(r,w-1) for r in range(1,h)]\n    pts += [(h-1,c) for c in range(w-2,-1,-1)]\n    pts += [(r,0) for r in range(h-2,0,-1)]\n    return pts,h,w\n\ndef top_bump(base_h,base_w,a,b,d):\n    pts=[]\n    pts += [(0,c) for c in range(a,b+1)]\n    pts += [(r,b) for r in range(1,d+1)]\n    pts += [(d,c) for c in range(b+1,base_w)]\n    pts += [(r,base_w-1) for r in range(d+1,d+base_h)]\n    pts += [(d+base_h-1,c) for c in range(base_w-2,-1,-1)]\n    pts += [(r,0) for r in range(d+base_h-2,d-1,-1)]\n    pts += [(d,c) for c in range(1,a+1)]\n    pts += [(r,a) for r in range(d-1,0,-1)]\n    return pts,d+base_h,base_w\n\ndef rot(pts,H,W,k):\n    for _ in range(k%4):\n        pts=[(c,H-1-r) for r,c in pts]\n        H,W=W,H\n    return pts,H,W\n\ndef check(pts):\n    s=set(pts)\n    if len(s)\"'!=len(pts):\n        return '\"'dup'\n    for r,c in pts:\n        deg=sum((r+dr,c+dc) in s for dr,dc in DIR4)\n        if deg\"'!=2:\n            return ('\"'deg', (r,c), deg)\n    start=min(s)\n    if (start[0],start[1]+1) not in s:\n        return ('start',start)\n    prev=start\n    cur=(start[0],start[1]+1)\n    order=[start]\n    while cur\"'!=start:\n        order.append(cur)\n        cand=[(cur[0]+dr,cur[1]+dc) for dr,dc in DIR4 if (cur[0]+dr,cur[1]+dc) in s and (cur[0]+dr,cur[1]+dc)!=prev]\n        if len(cand)!=1:\n            return ('\"'trace',cur,cand)\n        prev,cur=cur,cand[0]\n        if len(order)>len(pts)+1:\n            return 'loop'\n    if len(order)\"'!=len(pts):\n        return ('\"'len',len(order),len(pts))\n    return 'ok'\n\nfor h in range(4,9):\n    for w in range(4,9):\n        assert check(rect(h,w)[0])=='ok'\nfor base_h in range(4,8):\n    for base_w in range(5,10):\n        for d in range(1,4):\n            for a in range(1,base_w-2):\n                for b in range(a+1,base_w-1):\n                    pts,H,W=top_bump(base_h,base_w,a,b,d)\n                    assert check(pts)=='ok', (base_h,base_w,a,b,d,check(pts))\n                    for k in range(4):\n                        p2,h2,w2=rot(list(pts),H,W,k)\n                        assert check(p2)=='ok', (base_h,base_w,a,b,d,k,check(p2))\nprint('all good')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
