{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed56627177/2/7.py')\nmod = SourceFileLoader('new_arc_task_chk', str(p)).load_module()\n\ndef valid(order):\n    pts=set(order)\n    if len(pts)\"'!=len(order):\n        return False, '\"'dup'\n    degs=[]\n    for r,c in pts:\n        deg=sum((int(r+dr), int(c+dc)) in pts for dr,dc in mod.DIR4)\n        degs.append(deg)\n        if deg\"'!=2:\n            return False, (r,c,degs[-1])\n    return True, None\n\nfor h in range(3,6):\n  for w in range(4,7):\n    for a in range(1,w-1):\n      for b in range(a+1,w):\n        vertices=[(1,0),(1,a),(0,a),(0,b),(1,b),(1,w),(h,w),(h,0)]\n        order,H,W=mod._rasterize_loop(vertices)\n        ok, why=valid(order)\n        if not ok:\n          print('\"'bad canonical', h,w,a,b,H,W,why)\n          raise SystemExit\n        for k in range(4):\n          o2,h2,w2=mod._rotate_order(order,H,W,k)\n          ok, why=valid(o2)\n          if not ok:\n            print('bad rotated', h,w,a,b,k,h2,w2,why)\n            raise SystemExit\nprint('all bump shapes valid')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
