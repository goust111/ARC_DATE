{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/f18ec8cc.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reorder the vertical color-major blocks while preserving every block's internal pixels.\n\n    Input structure\n    The grid is divided into vertical blocks, each with a unique dominant color.\n    Small marker pixels from other block colors may appear inside the blocks.\n\n    Rule\n    If adjacent shared-color marker rows read exactly as the current block order\n    from right to left, reverse the blocks. Otherwise move the leftmost block to\n    the far right and shift the remaining blocks left.\n\n    Key insight\n    The transformation acts on whole vertical blocks, so marker pixels move with\n    their source block instead of being recolored or independently rearranged.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    blocks = _vertical_blocks(g)\n    order = _block_order(g, blocks)\n    assert sorted(order) == list(range(len(blocks))), \"block order must be a permutation\"\n\n    return np.concatenate([g[:, blocks[i][0] : blocks[i][1]] for i in order], axis=1)\n\n# --------------- generator (o5x) ---------------\n# Canvas, block, and color bounds.\nGEN_HEIGHT_RANGE = (7, 9)\nGEN_TOTAL_WIDTH_RANGE = (10, 15)\nGEN_BLOCK_COUNT_CHOICES = [3, 4]\nGEN_BLOCK_WIDTH_RANGE = (3, 7)\nGEN_COLOR_POOL = range(1, 10)\n\n# Marker-layout probabilities and row-sharing limits.\nGEN_REVERSE_PROB = 0.35\nGEN_ALIGNED_LEFT_SHIFT_PROB = 0.7\nGEN_NONCONSECUTIVE_LEFT_SHIFT_PROB = 0.5\nGEN_COMMON_COLOR_COUNT_RANGE = (0, 1)\n\n# Rejection-sampling retry limit.\nGEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_bounds(widths):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/6ffbe589.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Crop a board cluster and rotate its color layers based on outside cue sprites.\n\n    Input structure:\n    - bg = most common color.\n    - A main multi-color board cluster (largest foreground region).\n    - Small monochrome cue sprites outside the board for the colors that rotate.\n\n    Rule:\n    - Tight-crop around the board cluster.\n    - For each color layer inside the crop, find its same-color cue outside.\n    - Rotate that layer clockwise by (cue pixel count mod 4) × 90°.\n    - No outside cue → no rotation.\n\n    Key insight: Cue sprite size mod 4 encodes rotation amount for its matching color layer.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    # --- STEP 1) Crop the \"board\" cluster (drop distant sample sprites) ---\n    crop, (r0, c0, r1, c1), bg = crop_components_near_largest(g, bg=bg, margin=3, connectivity=8)\n\n    # --- STEP 2) For each layer, rotate according to its unique outside cue size ---\n    colors = colors_present(crop, exclude={int(bg)})\n    assert colors, \"expected the cropped board to contain foreground colors\"\n    out = crop.copy()\n\n    outside_grid = g.copy()\n    outside_grid[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = int(bg)\n\n    for col in colors:\n        outside_comps = find_components(\n            outside_grid,\n            bg=int(bg),\n            connectivity=8,\n            monochromatic=True,\n            colors=[int(col)],\n            return_format=\"dict\",\n        )\n        assert len(outside_comps) <= 1, f\"expected at most one outside cue for color {col}\"\n        cue_size = int(outside_comps[0][\"area\"]) if outside_comps else 0\n        rot_k = (-cue_size) % 4\n        if rot_k:\n            out = rotate_color_layer(out, int(col), int(rot_k), bg=int(bg))\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# ---- Configuration constants ----\nCANVAS_SIZE = 20                  # overall grid dimensions\nBOARD_N_MIN, BOARD_N_MAX = 10, 13  # board side length range (inclusive)\nNUM_COLORS = 3                    # number of distinct non-bg colors (frame, mid, inner)\n\nOUTER_DENSITY_LO = 0.17          # outer layer min density fraction\nOUTER_DENSITY_HI = 0.32          # outer layer max density fraction\nMID_DENSITY_LO = 0.30            # middle layer min density fraction\nMID_DENSITY_HI = 0.50            # middle layer max density fraction\nMID_OUTER_CAP = 0.32             # middle layer upper cap as fraction of n^2\n\nLAYER_BAND_WIDTH = 2             # how many border rows/cols to fill from\nMIDDLE_INSET = 2                 # offset of middle layer within board\nASYM_MARKER = (1, 2)             # cell used to break rotational symmetry\nINNER_SPAN_MARGIN = 8            # inner span = n - this value (max)\n\nCUE_GRID = 3                     # cue blob growth grid size\nCUE_BOARD_DIST = 4               # min Chebyshev distance from cue bbox to board bbox\nCUE_INTER_DIST = 4               # min Chebyshev distance between cue bboxes\nOUTER_AREA_PAD = 4               # outer min_area = mid_area + this\n\nGEN_RETRIES = 300                 # max attempts in generate_input()\n\n\ndef _rot_orbit(r: int, c: int, n: int) -> set[tuple[int, int]]:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\ndef _in_bounds(h, w, r, c):\n","exit_code":0,"status":"completed"}}
