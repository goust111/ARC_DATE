{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nDIR4=[(-1,0),(0,1),(1,0),(0,-1)]\n\ndef draw_poly(vertices, scale=2):\n    pts=[]\n    n=len(vertices)\n    for i in range(n):\n        r0,c0=vertices[i]\n        r1,c1=vertices[(i+1)%n]\n        r0*=scale; c0*=scale; r1*=scale; c1*=scale\n        if r0==r1:\n            step=1 if c1>c0 else -1\n            seg=[(r0,c) for c in range(c0,c1+step,step)]\n        else:\n            step=1 if r1>r0 else -1\n            seg=[(r,c0) for r in range(r0,r1+step,step)]\n        if pts:\n            seg=seg[1:]\n        pts.extend(seg)\n    return pts\n\ndef check(pts):\n    s=set(pts)\n    if len(s)\"'!=len(pts):\n        return '\"'dup'\n    for r,c in pts:\n        deg=sum((r+dr,c+dc) in s for dr,dc in DIR4)\n        if deg\"'!=2:\n            return ('\"'deg', (r,c), deg)\n    start=min(s)\n    if (start[0],start[1]+1) not in s:\n        return ('start', start)\n    prev=start\n    cur=(start[0],start[1]+1)\n    order=[start]\n    while cur\"'!=start:\n        order.append(cur)\n        cand=[(cur[0]+dr,cur[1]+dc) for dr,dc in DIR4 if (cur[0]+dr,cur[1]+dc) in s and (cur[0]+dr,cur[1]+dc)!=prev]\n        if len(cand)!=1:\n            return ('\"'trace', cur, cand)\n        prev,cur=cur,cand[0]\n        if len(order)>len(pts)+1:\n            return 'loop'\n    if len(order)\"'!=len(pts):\n        return ('\"'len',len(order),len(pts))\n    return 'ok'\n\nrect=[(0,0),(0,4),(3,4),(3,0)]\nbump=[(1,0),(1,1),(0,1),(0,2),(1,2),(1,4),(4,4),(4,0)]\nfor verts in [rect,bump]:\n    pts=draw_poly(verts)\n    print(check(pts), len(pts), (max(r for r,c in pts)+1, max(c for r,c in pts)+1))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
