{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/21897d95.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter, deque\nimport numpy as np\n\nfrom arc_utils import label_mask\nimport random\n\n\nDIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))\nUP = (-1, 0)\nDOWN = (1, 0)\nRIGHT = (0, 1)\n\n\nclass _DSU:\n    def __init__(self, n: int):\n        self.parent = list(range(int(n)))\n\n    def find(self, x: int) -> int:\n        x = int(x)\n        while self.parent[x] != x:\n            self.parent[x] = self.parent[self.parent[x]]\n            x = self.parent[x]\n        return int(x)\n\n    def union(self, a: int, b: int) -> None:\n        ra = self.find(a)\n        rb = self.find(b)\n        if ra != rb:\n            self.parent[rb] = ra\n\n\ndef _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:\n    return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])\n\n\ndef _opp(d: tuple[int, int]) -> tuple[int, int]:\n    return (-int(d[0]), -int(d[1]))\n\n\ndef _stem_from_branches(branches: list[tuple[int, int]]) -> tuple[int, int]:\n    assert len(branches) == 3\n    branch_set = set(branches)\n    for d in branches:\n        if _opp(d) not in branch_set:\n            return d\n    raise AssertionError(\"T marker has no single stem\")\n\n\ndef _parse_tetromino(cells: set[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int], list[tuple[int, int]]] | None:\n    if len(cells) != 4:\n        return None\n    for r, c in cells:\n        branches = [(dr, dc) for dr, dc in DIRS if (r + dr, c + dc) in cells]\n        if len(branches) != 3:\n            continue\n        stem = _stem_from_branches(branches)\n        expected = {(r, c), (r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)}\n        expected.remove((r - stem[0], c - stem[1]))\n        if cells == expected:\n            bar = [d for d in branches if d != stem]\n            assert len(bar) == 2 and bar[0] == _opp(bar[1])\n            return (int(r), int(c)), stem, bar\n    return None\n\n\ndef _label_base_components(g: np.ndarray, control: np.ndarray) -> tuple[np.ndarray, list[int], list[int]]:\n    comp_id = np.full(g.shape, -1, dtype=int)\n    comp_colors: list[int] = []\n    comp_areas: list[int] = []\n    cid = 0\n    for col in sorted(set(map(int, g.ravel())) - {1}):\n        labels, n_labels = label_mask((g == col) & (~control), connectivity=4)\n        for k in range(1, int(n_labels) + 1):\n            coords = np.argwhere(labels == k)\n            if coords.size == 0:\n                continue\n            for rr, cc in coords:\n                comp_id[int(rr), int(cc)] = cid\n            comp_colors.append(int(col))\n            comp_areas.append(int(len(coords)))\n            cid += 1\n    return comp_id, comp_colors, comp_areas\n\n\ndef _solve_unrotated(g: np.ndarray) -> np.ndarray:\n    labels_1, n_1 = label_mask(g == 1, connectivity=4)\n    one_components = {\n        k: {tuple(map(int, xy)) for xy in np.argwhere(labels_1 == k)}\n        for k in range(1, int(n_1) + 1)\n    }\n    one_sizes = {k: len(cells) for k, cells in one_components.items()}\n\n    markers: list[dict] = []\n    used_ones: set[tuple[int, int]] = set()\n    control = np.zeros(g.shape, dtype=bool)\n\n    for cells in one_components.values():\n        parsed = _parse_tetromino(cells)\n        if parsed is None:\n            continue\n        center, stem, bar = parsed\n        markers.append({\"kind\": \"normal\", \"center\": center, \"stem\": stem, \"bar\": bar, \"cells\": cells})\n        used_ones |= cells\n        for r, c in cells:\n            control[r, c] = True\n\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n            if int(g[r, c]) == 1:\n                continue\n            branches: list[tuple[int, int]] = []\n            cells: list[tuple[int, int]] = []\n            ok = True\n            for d in DIRS:\n                rr, cc = r + d[0], c + d[1]\n                if not _in_bounds(g.shape, rr, cc) or int(g[rr, cc]) != 1:\n                    continue\n                label = int(labels_1[rr, cc])\n                if one_sizes[label] == 1 and (rr, cc) not in used_ones:\n                    branches.append(d)\n                    cells.append((rr, cc))\n                else:\n                    ok = False\n            if ok and len(branches) == 3:\n                stem = _stem_from_branches(branches)\n                bar = [d for d in branches if d != stem]\n                assert len(bar) == 2 and bar[0] == _opp(bar[1])\n                marker_cells = set(cells) | {(int(r), int(c))}\n                markers.append(\n                    {\n                        \"kind\": \"colored\",\n                        \"center\": (int(r), int(c)),\n                        \"stem\": stem,\n                        \"bar\": bar,\n                        \"cells\": marker_cells,\n                        \"target_color\": int(g[r, c]),\n                    }\n                )\n                used_ones |= set(cells)\n                for rr, cc in marker_cells:\n                    control[rr, cc] = True\n\n    all_one_cells = {tuple(map(int, xy)) for xy in np.argwhere(g == 1)}\n    assert all_one_cells == used_ones, \"all color-1 pixels must belong to a T control marker\"\n\n    for col in sorted(set(map(int, g.ravel())) - {1}):\n        labels, n_labels = label_mask((g == col) & (~control), connectivity=4)\n        for k in range(1, int(n_labels) + 1):\n            coords = np.argwhere(labels == k)\n            if len(coords) > 5:\n                continue\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            if len(coords) == (int(r1) - int(r0) + 1) * (int(c1) - int(c0) + 1):\n                continue\n            cells = {tuple(map(int, xy)) for xy in coords}\n            markers.append({\"kind\": \"small\", \"cells\": cells})\n            for rr, cc in cells:\n                control[rr, cc] = True\n\n    comp_id, comp_colors, comp_areas = _label_base_components(g, control)\n    assert comp_colors, \"at least one base region is required\"\n    dsu = _DSU(len(comp_colors))\n\n    def first_component_from(center: tuple[int, int], direction: tuple[int, int], start: int) -> int | None:\n        r, c = center\n        step = int(start)\n        while True:\n            rr = r + direction[0] * step\n            cc = c + direction[1] * step\n            if not _in_bounds(g.shape, rr, cc):\n                return None\n            if comp_id[rr, cc] >= 0:\n                return int(comp_id[rr, cc])\n            step += 1\n\n    def adjacent_component_counts(cells: set[tuple[int, int]]) -> Counter:\n        counts: Counter = Counter()\n        for r, c in cells:\n            for dr, dc in DIRS:\n                rr, cc = r + dr, c + dc\n                if _in_bounds(g.shape, rr, cc) and comp_id[rr, cc] >= 0:\n                    counts[int(comp_id[rr, cc])] += 1\n        return counts\n\n    for marker in markers:\n        if marker[\"kind\"] in {\"normal\", \"colored\"}:\n            center = marker[\"center\"]\n            stem = marker[\"stem\"]\n            dest = first_component_from(center, stem, start=2)\n            assert dest is not None, \"T marker must point at a destination region\"\n\n            source_parts: list[int] = []\n            for bar_dir in marker[\"bar\"]:\n                rr = center[0] + stem[0] + bar_dir[0]\n                cc = center[1] + stem[1] + bar_dir[1]\n                assert _in_bounds(g.shape, rr, cc) and comp_id[rr, cc] >= 0\n                source_parts.append(int(comp_id[rr, cc]))\n            source = source_parts[0]\n            for part in source_parts[1:]:\n                assert comp_colors[part] == comp_colors[source], \"T source diagonals must share a color\"\n                dsu.union(source, part)\n\n            for comp in adjacent_component_counts(marker[\"cells\"]):\n                if comp_colors[comp] == comp_colors[source]:\n                    dsu.union(source, comp)\n            marker[\"dest_comp\"] = dest\n            marker[\"source_comp\"] = source\n        else:\n            counts = adjacent_component_counts(marker[\"cells\"])\n            assert counts, \"small marker must touch its owner region\"\n            owner = max(counts, key=lambda c: (counts[c], comp_areas[c]))\n            for comp in counts:\n                if comp_colors[comp] == comp_colors[owner]:\n                    dsu.union(owner, comp)\n            marker[\"source_comp\"] = owner\n\n    root_color: dict[int, int] = {}\n    for i, col in enumerate(comp_colors):\n        root = dsu.find(i)\n        root_color.setdefault(root, int(col))\n        assert root_color[root] == int(col), \"merged region colors must match\"\n\n    final_color = dict(root_color)\n    for marker in markers:\n        if marker[\"kind\"] not in {\"normal\", \"colored\"}:\n            marker[\"source\"] = dsu.find(marker[\"source_comp\"])\n            continue\n        dest = dsu.find(marker[\"dest_comp\"])\n        source = dsu.find(marker[\"source_comp\"])\n        marker[\"source\"] = source\n        replacement = int(marker[\"target_color\"]) if marker[\"kind\"] == \"colored\" else int(root_color[source])\n        assert final_color[dest] in {root_color[dest], replacement}, \"conflicting T controls for one region\"\n        final_color[dest] = replacement\n\n    out = np.full(g.shape, -1, dtype=int)\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n            cid = int(comp_id[r, c])\n            if cid >= 0:\n                out[r, c] = int(final_color[dsu.find(cid)])\n\n    for marker in markers:\n        color = int(final_color[marker[\"source\"]])\n        for r, c in marker[\"cells\"]:\n            out[r, c] = color\n\n    assert bool(np.all(out >= 0)), \"all cells must be assigned\"\n    return out\n\n\ndef _find_l9_orientation(g: np.ndarray) -> str | None:\n    \"\"\"Find a 5-cell L-shaped color-9 marker and return its corner position.\"\"\"\n    mask9 = g == 9\n    if not mask9.any():\n        return None\n    labels, n = label_mask(mask9, connectivity=4)\n    for k in range(1, int(n) + 1):\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg\nimport random\n\n\ndef _assert_output_footprints_disjoint(dims: list[tuple[int, int]]) -> None:\n    occupied: set[tuple[int, int]] = set()\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, cc) for r in range(short) for cc in range(c, c + long)}\n        assert not (occupied & cells), \"normalized output rectangles must not overlap\"\n        occupied |= cells\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, cc)\n            for r in range(10 - long, 10)\n            for cc in range(c, c + short)\n        }\n        assert not (occupied & cells), \"normalized output rectangles must not overlap\"\n        occupied |= cells\n        c += short + 1\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.\n\n    Input structure\n    The grid has one background color and one foreground color; the foreground forms\n    separate solid rectangles, ordered from left to right.\n\n    Rule\n    Build a 10-row background canvas whose width is the packed width of the wide\n    versions of the rectangles. For each source rectangle, paint a top-aligned\n    rectangle of shape min(h,w) by max(h,w), with one background column between\n    consecutive rectangles. Then, starting again from the left edge, paint a\n    bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,\n    again separated by one background column.\n\n    Key insight\n    The input rectangles are not copied in their original orientations; each object\n    contributes one horizontal-facing and one vertical-facing normalized rectangle,\n    preserving left-to-right object order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n    fg = fg_colors[0]\n\n    components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n    assert components\n    components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n\n    dims: list[tuple[int, int]] = []\n    for obj in components:\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert obj[\"area\"] == h * w\n        dims.append((h, w))\n\n    out_h = 10\n    out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n    _assert_output_footprints_disjoint(dims)\n    out = np.full((out_h, out_w), bg, dtype=int)\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[:short, c : c + long] = fg\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[out_h - long : out_h, c : c + short] = fg\n        c += short + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\n# Rectangle counts and dimensions.\nRECT_COUNT_MIN = 4\nRECT_COUNT_MAX = 6\nSHORT_SIDE_MIN = 1\nSHORT_SIDE_MAX = 3\nSIDE_SUM_MAX = 10\nLONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN\n\n# Canvas and packing constraints.\nARC_GRID_MAX = 30\nOUTPUT_HEIGHT = 10\nGAP_WIDTH = 1\n\n# Retry policy.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_d749d46f_output_footprints_disjoint(dims):\n    occupied = set()\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, c) for r in range(short) for c in range(col, col + long)}\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += long + GAP_WIDTH\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, c)\n            for r in range(OUTPUT_HEIGHT - long, OUTPUT_HEIGHT)\n            for c in range(col, col + short)\n        }\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += short + GAP_WIDTH\n\n    return True\n\n\ndef _sample_dimensions(n_rects):\n    \"\"\"Sample source rectangle dimensions under the output-width budget.\"\"\"\n    dims = []\n    remaining_budget = ARC_GRID_MAX - GAP_WIDTH * (n_rects - 1)\n\n    for i in range(n_rects):\n        rects_left = n_rects - i\n        min_needed = rects_left - 1\n        max_for_this = min(remaining_budget - min_needed, LONG_SIDE_MAX)\n        if max_for_this < SHORT_SIDE_MIN:\n            return None\n\n        short = random.randint(SHORT_SIDE_MIN, SHORT_SIDE_MAX)\n        max_long = min(SIDE_SUM_MAX - short, max_for_this)\n        if max_long < short:\n            short = SHORT_SIDE_MIN\n            max_long = min(LONG_SIDE_MAX, max_for_this)\n            if max_long < SHORT_SIDE_MIN:\n                return None\n\n        long = random.randint(short, max_long)\n        remaining_budget -= long\n\n        if random.random() < 0.5:\n            h, w = long, short\n        else:\n            h, w = short, long\n        dims.append((h, w))\n\n    return dims\n\n\ndef _input_shape(dims):\n    return max(h for h, _ in dims), sum(w for _, w in dims) + GAP_WIDTH * (len(dims) - 1)\n\n\ndef _background_is_dominant(dims, inp_h, inp_w):\n    fg_pixels = sum(h * w for h, w in dims)\n    total_pixels = inp_h * inp_w\n    bg_pixels = total_pixels - fg_pixels\n    return bg_pixels > fg_pixels\n\n\ndef _build_input_grid(dims, bg, fg, inp_h, inp_w):\n    grid = np.full((inp_h, inp_w), bg, dtype=int)\n    col = 0\n    for h, w in dims:\n        grid[:h, col:col + w] = fg\n        col += w + GAP_WIDTH\n    return grid\n\n\ndef _passes_solver_oracle(grid):\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return out.shape[0] == OUTPUT_HEIGHT\n\n\ndef _gen_attempt():\n    \"\"\"Generate one valid input grid, or None when sampled dimensions fail constraints.\"\"\"\n    bg, fg = random.sample(COLOR_VALUES, 2)\n    n_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)\n    dims = _sample_dimensions(n_rects)\n    if dims is None:\n        return None\n\n    inp_h, inp_w = _input_shape(dims)\n    if inp_w > ARC_GRID_MAX:\n        return None\n    if not _gen_d749d46f_output_footprints_disjoint(dims):\n        return None\n    if inp_h > ARC_GRID_MAX or inp_h < 1:\n        return None\n    if not _background_is_dominant(dims, inp_h, inp_w):\n        return None\n\n    grid = _build_input_grid(dims, bg, fg, inp_h, inp_w)\n    if not _passes_solver_oracle(grid):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
