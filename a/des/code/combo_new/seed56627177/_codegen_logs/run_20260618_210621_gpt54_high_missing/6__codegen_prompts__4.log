{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/4df5b0ae.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/4df5b0ae.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg, is_contiguous, paste, random_free_location, random_sprite\nimport random\n\n\ndef _is_full_grid_frame(component: dict, shape: tuple[int, int]) -> bool:\n    H, W = shape\n    r0, c0, r1, c1 = component[\"bbox\"]\n    if (r0, c0, r1, c1) != (0, 0, H - 1, W - 1):\n        return False\n    perimeter_area = 2 * H + 2 * W - 4\n    return int(component[\"area\"]) == perimeter_area and all(\n        r in (0, H - 1) or c in (0, W - 1) for r, c in component[\"coords\"]\n    )\n\n\ndef _component_sprite(component: dict, bg: int) -> np.ndarray:\n    r0, c0, r1, c1 = component[\"bbox\"]\n    sprite = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)\n    for r, c in component[\"coords\"]:\n        sprite[r - r0, c - c0] = int(component[\"color\"])\n    return sprite\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Pack the colored sprites along the bottom edge from smallest to largest.\n\n    Input structure\n    The grid has a dominant background color and several monochrome 4-connected\n    foreground sprites; a full-grid one-cell frame may surround the scene.\n\n    Rule\n    Remove any full-grid rectangular frame, sort the remaining sprites by pixel\n    area from smallest to largest, and paste their bounding-box sprites left to\n    right with each sprite bottom-aligned.\n\n    Key insight\n    The original locations do not determine the final slots; each sprite's area\n    gives the packing order, while its shape and color are preserved.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = get_bg(g)\n\n    sprites: list[tuple[int, np.ndarray]] = []\n    for component in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        if _is_full_grid_frame(component, g.shape):\n            continue\n        sprites.append((int(component[\"area\"]), _component_sprite(component, bg)))\n\n    assert sprites\n    areas = [area for area, _sprite in sprites]\n    assert len(areas) == len(set(areas))\n\n    out = np.full_like(g, bg)\n    c = 0\n    for _area, sprite in sorted(sprites, key=lambda item: item[0]):\n        h, w = sprite.shape\n        assert h <= H and c + w <= W\n        paste(out, sprite, H - h, c, transparent=bg)\n        c += w\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\nBG = 7\nALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n\n# Canvas and sprite bounds.\nGRID_HEIGHT, GRID_WIDTH = 10, 10\nSPRITE_MIN_AREA, SPRITE_MAX_AREA = 1, 12\nSPRITE_MAX_HEIGHT, SPRITE_MAX_WIDTH = 6, 4\nMIN_SPRITE_DENSITY = 0.5\n\n# Sprite sampling and validation.\nSPRITE_COUNT_CHOICES = [3, 4]\nSPRITE_CONNECTIVITY = 4\nSPRITE_SYMMETRY = 'not_symmetric'\nSPRITE_RETRY_LIMIT = 20\n\n# Frame, placement, and generation retries.\nFRAME_PROBABILITY = 0.3\nFRAME_BORDER, NO_FRAME_BORDER = 1, 0\nGENERATION_RETRY_LIMIT = 300\n\nVALID_SPRITE_SHAPES = {\n    area: [(h, w) for h in range(1, SPRITE_MAX_HEIGHT + 1)\n           for w in range(1, SPRITE_MAX_WIDTH + 1)\n           if h * w >= area and area / (h * w) >= MIN_SPRITE_DENSITY]\n    for area in range(SPRITE_MIN_AREA, SPRITE_MAX_AREA + 1)\n}\n\n\ndef _make_sprite(area, color):\n    valid_shapes = list(VALID_SPRITE_SHAPES.get(area, []))\n    if not valid_shapes:\n        return None\n\n    random.shuffle(valid_shapes)\n    for h, w in valid_shapes:\n        bbox_area = h * w\n        if bbox_area == area:\n            return np.full((h, w), color, dtype=int)\n        try:\n            sprite = random_sprite(h, w, density=area / bbox_area,\n                                   color_palette=[color], connectivity=SPRITE_CONNECTIVITY,\n                                   background=BG, symmetry=SPRITE_SYMMETRY)\n            actual_area = int(np.sum(sprite != BG))\n            if actual_area == area and is_contiguous(sprite, background=BG,\n                                                     connectivity=SPRITE_CONNECTIVITY):\n                return sprite\n        except Exception:\n            continue\n    return None\n\n\ndef _sample_sprite_specs():\n    n_sprites = random.choice(SPRITE_COUNT_CHOICES)\n    possible_areas = list(range(SPRITE_MIN_AREA, SPRITE_MAX_AREA + 1))\n    random.shuffle(possible_areas)\n    areas = sorted(possible_areas[:n_sprites])\n    colors = [random.choice(ALL_COLORS) for _ in range(n_sprites)]\n    return areas, colors\n\n\ndef _make_sprites(areas, colors):\n    \"\"\"Build all sprites, preserving area order; return None if any shape fails.\"\"\"\n    sprites = []\n    for area, color in zip(areas, colors):\n        sprite = None\n        for _ in range(SPRITE_RETRY_LIMIT):\n            sprite = _make_sprite(area, color)\n            if sprite is not None:\n                break\n        if sprite is None:\n            return None\n        sprites.append(sprite)\n    return sprites\n\n\ndef _fits_packed_output(sprites):\n    total_width = sum(sprite.shape[1] for sprite in sprites)\n    max_height = max(sprite.shape[0] for sprite in sprites)\n    return total_width <= GRID_WIDTH and max_height <= GRID_HEIGHT\n\n\ndef _pack_output(sprites):\n    output = np.full((GRID_HEIGHT, GRID_WIDTH), BG, dtype=int)\n    col = 0\n    for sprite in sprites:\n        sprite_height, sprite_width = sprite.shape\n        paste(output, sprite, GRID_HEIGHT - sprite_height, col, transparent=BG)\n        col += sprite_width\n    return output\n\n\ndef _maybe_add_frame(grid, sprites):\n    \"\"\"Mutate grid with an optional perimeter frame; return the active border.\"\"\"\n    use_frame = random.random() < FRAME_PROBABILITY\n    if not use_frame:\n        return NO_FRAME_BORDER\n\n    sprite_colors = set(int(sprite[sprite != BG].flat[0]) for sprite in sprites)\n    frame_candidates = [color for color in ALL_COLORS if color not in sprite_colors]\n    if not frame_candidates:\n        return NO_FRAME_BORDER\n\n    frame_color = random.choice(frame_candidates)\n    grid[0, :] = frame_color\n    grid[-1, :] = frame_color\n    grid[:, 0] = frame_color\n    grid[:, -1] = frame_color\n    return FRAME_BORDER\n\n\ndef _place_sprites(grid, sprites, border):\n    \"\"\"Place sprites in-place; return False if no legal location is found.\"\"\"\n    for sprite in sprites:\n        try:\n            row, col = random_free_location(grid, sprite, transparent=BG, border=border)\n            paste(grid, sprite, row, col, transparent=BG)\n        except ValueError:\n            return False\n    return True\n\n\ndef _passes_oracle(inp, output):\n    try:\n        return np.array_equal(main(inp), output)\n    except Exception:\n        return False\n\n\ndef _gen_attempt():\n    areas, colors = _sample_sprite_specs()\n    sprites = _make_sprites(areas, colors)\n    if sprites is None or not _fits_packed_output(sprites):\n        return None\n\n    output = _pack_output(sprites)\n    inp = np.full((GRID_HEIGHT, GRID_WIDTH), BG, dtype=int)\n    border = _maybe_add_frame(inp, sprites)\n    if not _place_sprites(inp, sprites, border):\n        return None\n    if _passes_oracle(inp, output):\n        return inp\n    return None\n\n\ndef generate_input():\n    for _ in range(GENERATION_RETRY_LIMIT):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRY_LIMIT} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\"","aggregated_output":"import numpy as np\nfrom collections import Counter, deque\n\nfrom arc_utils import components_mask, get_bg, neighbors4, neighbors8\nimport random\ndef _components_mask(mask: np.ndarray, conn8: bool) -> list[list[tuple[int, int]]]:\n    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(mask, connectivity=8 if conn8 else 4)]\n\n\ndef _touches_border(pts: list[tuple[int, int]], h: int, w: int) -> bool:\n    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n\n\ndef _seed_pixels(g: np.ndarray, bg: int) -> list[tuple[int, int]]:\n    h, w = g.shape\n    vals, cnts = np.unique(g, return_counts=True)\n    seeds: list[tuple[int, int]] = []\n    for v, cnt in zip(vals, cnts):\n        v = int(v)\n        if v == bg or int(cnt) != 1:\n            continue\n        r, c = map(int, np.argwhere(g == v)[0])\n        if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n            seeds.append((r, c))\n    return seeds\n\n\ndef _nonbg_component8_from(g: np.ndarray, start: tuple[int, int], bg: int) -> set[tuple[int, int]]:\n    h, w = g.shape\n    st = [start]\n    vis = {start}\n    while st:\n        r, c = st.pop()\n        for nr, nc in neighbors8(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in vis and int(g[nr, nc]) != bg:\n                vis.add((nr, nc))\n                st.append((nr, nc))\n    return vis\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\ndef _in_bounds(h, w, r, c):\n    return 0 <= r < h and 0 <= c < w\n\n\n# ---------------------------------------------------------------------------\n# Frame geometry\n# ---------------------------------------------------------------------------\n\ndef _frame_ring_coords(r0, c0, ch, cw):\n    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n\n    Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).\n    Ring = bbox boundary minus 4 corners.\n    \"\"\"\n    H, W = ch + 2, cw + 2\n    ring = []\n    for dr in range(H):\n        for dc in range(W):\n            on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)\n            corner = (dr in (0, H - 1)) and (dc in (0, W - 1))\n            if on_bdr and not corner:\n                ring.append((r0 + dr, c0 + dc))\n    cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]\n    return ring, cavity\n\n\ndef _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n\n    Returns True if: ring and cavity cells are empty, no cavity cell is\n    8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and\n    at least one ring cell is 8-adjacent to a line_col pixel.\n    \"\"\"\n    # Ring and cavity cells must all be empty\n    for rr, cc in ring:\n        if canvas[rr, cc] != -1:\n            return False\n    for rr, cc in cavity:\n        if canvas[rr, cc] != -1:\n            return False\n\n    # No cavity cell may be 8-adjacent to any line_col pixel\n    for cr, cc in cavity:\n        for nr, nc in neighbors8(cr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return False\n","exit_code":0,"status":"completed"}}
