[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(sid)\n  80:             sprites.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"r1\": int(r1), \"c1\": int(c1), \"mask\": m})\n  81: \n  82:     move_colors = {int(s[\"color\"]) for s in sprites}\n  83: \n  84:     # --- marker-derived targets (restricted to colors that actually appear as sprites) ---\n  85:     row_marks: dict[int, list[int]] = defaultdict(list)\n  86:     col_marks: dict[int, list[int]] = defaultdict(list)\n  87:     for r in range(int(ir0), int(ir1) + 1):\n  88:         cl = int(g[int(r), int(fc0)])\n  89:         cr = int(g[int(r), int(fc1)])\n  90:         if cl == cr and cl != int(bg) and cl in move_colors:\n  91:             row_marks[int(cl)].append(int(r))\n  92:     for c in range(int(ic0), int(ic1) + 1):\n  93:         ct = int(g[int(fr0), int(c)])\n  94:         cb = int(g[int(fr1), int(c)])\n  95:         if ct == cb and ct != int(bg) and ct in move_colors:\n  96:             col_marks[int(ct)].append(int(c))\n  97: \n  98:     targets: dict[int, list[tuple[int, int]]] = {}\n  99:     for col in set(row_marks.keys()) & set(col_marks.keys()):\n 100:         pts = {(int(r), int(c)) for r in row_marks[int(col)] for c in col_marks[int(col)]}\n 101:         targets[int(col)] = sorted(pts)\n 102: \n 103:     out = g.copy()\n 104:     movers = [s for s in sprites if int(s[\"color\"]) in targets]\n 105: \n 106:     # Erase originals of moved sprites.\n 107:     for s in movers:\n 108:         r0, c0 = int(s[\"r0\"]), int(s[\"c0\"])\n 109:         for rr, cc in np.argwhere(s[\"mask\"]):\n 110:             out[int(r0) + int(rr), int(c0) + int(cc)] = int(bg)\n 111: \n 112:     # Bottom-to-top ordering: lower sprites first, upper sprites last (covering).\n 113:     movers.sort(key=lambda s: (-((int(s[\"r0\"]) + int(s[\"r1\"])) / 2.0), int(s[\"c0\"])))\n 114: \n 115:     for s in movers:\n 116:         col = int(s[\"color\"])\n 117:         cr = (int(s[\"r0\"]) + int(s[\"r1\"])) // 2\n 118:         cc = (int(s[\"c0\"]) + int(s[\"c1\"])) // 2\n 119:         pix = [(int(s[\"r0\"]) + int(rr), int(s[\"c0\"]) + int(cc2)) for rr, cc2 in np.argwhere(s[\"mask\"])]\n 120: \n 121:         for tr, tc in targets[int(col)]:\n 122:             dr = int(tr - cr)\n 123:             dc = int(tc - cc)\n 124:             for r, c in pix:\n 125:                 rr = int(r + dr)\n 126:                 cc3 = int(c + dc)\n 127:                 if int(ir0) <= rr <= int(ir1) and int(ic0) <= cc3 <= int(ic1):\n 128:                     out[rr, cc3] = int(col)\n 129: \n 130:     return out\n 131: \n 132: \n 133: # ---------------------------------------------------------------------------\n 134: # generate_input\n 135: # ---------------------------------------------------------------------------\n 136: import random\n 137: \n 138: \n 139: def _pick_spaced(candidates: list[int], n: int, min_spacing: int) -> list[int] | None:\n 140:     \"\"\"Pick up to n values from candidates with at least min_spacing between any two.\"\"\"\n 141:     if not candidates:\n 142:         return None\n 143:     if n == 1:\n 144:         return [random.choice(candidates)]\n 145:     random.shuffle(candidates)\n 146:     picked: list[int] = []\n 147:     for v in candidates:\n 148:         if all(abs(v - p) >= min_spacing for p in picked):\n 149:             picked.append(v)\n 150:             if len(picked) == n:\n 151:                 return picked\n 152:     return picked if picked else None\n 153: \n 154: \n 155: def _make_sprite(color: int, max_h: int, max_w: int) -> np.ndarray | None:\n 156:     \"\"\"Generate a single-color 8-connected sprite cropped to its bounding box.\"\"\"\n 157:     sh = min(random.choice([3, 3, 3, 4, 5]), max_h)\n 158:     sw = min(random.choice([3, 3, 3, 4, 5]), max_w)\n 159:     if sh < 1 or sw < 1:\n 160:         return None\n 161:     n_pixels = random.randint(3, min(9, sh * sw))\n 162:     pixels = {(sh // 2, sw // 2)}\n 163:     r, c = sh // 2, sw // 2\n 164:     for _ in range(n_pixels * 30):\n 165:         if len(pixels) >= n_pixels:\n 166:             break\n 167:         dr, dc = random.choice([(0, 1), (0, -1), (1, 0), (-1, 0),\n 168:                                  (1, 1), (1, -1), (-1, 1), (-1, -1)])\n 169:         nr, nc = r + dr, c + dc\n 170:         if 0 <= nr < sh and 0 <= nc < sw:\n 171:             pixels.add((nr, nc))\n 172:             r, c = nr, nc\n 173:     rows = [p[0] for p in pixels]\n 174:     cols = [p[1] for p in pixels]\n 175:     min_r, max_r = min(rows), max(rows)\n 176:     min_c, max_c = min(cols), max(cols)\n 177:     sprite = np.zeros((max_r - min_r + 1, max_c - min_c + 1), dtype=int)\n 178:     for pr, pc in pixels:\n 179:         sprite[pr - min_r, pc - min_c] = color\n 180:     return sprite\n 181: \n 182: \n 183: def _gen_attempt() -> np.ndarray | None:\n 184:     bg = 0\n 185: \n 186:     # Dimensions — frame spans full grid height\n 187:     interior_h = random.randint(8, 13)\n 188:     interior_w = random.randint(8, 13)\n 189:     H = interior_h + 2\n 190:     if not 10 <= H <= 15:\n 191:         return None\n 192:     sprite_area_w = random.randint(3, 5)\n 193:     frame_w = interior_w + 2\n 194:     W = sprite_area_w + 1 + frame_w\n 195:     if not 14 <= W <= 20:\n 196:         return None\n 197: \n 198:     # Key positions\n 199:     div_col = sprite_area_w\n 200:     fc0, fc1 = sprite_area_w + 1, W - 1\n 201:     ir0, ic0 = 1, fc0 + 1\n 202:     ir1, ic1 = H - 2, fc1 - 1\n 203: \n 204:     # Assign distinct colors\n 205:     all_colors = list(range(1, 10))\n 206:     random.shuffle(all_colors)\n 207:     n_movers = random.randint(2, 3)\n 208:     n_distractors = random.choice([0, 0, 1])\n 209:     idx = 0\n 210:     divider_color = all_colors[idx]; idx += 1\n 211:     frame_base = all_colors[idx]; idx += 1\n 212:     mover_colors = all_colors[idx:idx + n_movers]; idx += n_movers\n 213:     distractor_colors = all_colors[idx:idx + n_distractors]; idx += n_distractors\n 214: \n 215:     # Generate mover sprites\n 216:     sprites: list[np.ndarray] = []\n 217:     for mc in mover_colors:\n 218:         s = _make_sprite(mc, 5, sprite_area_w)\n 219:         if s is None:\n 220:             return None\n 221:         sprites.append(s)\n 222: \n 223:     # Pick marker positions per mover (no two movers share a row or col marker)\n 224:     mover_targets: dict[int, tuple[list[int], list[int]]] = {}\n 225:     occupied_rows: set[int] = set()\n 226:     occupied_cols: set[int] = set()\n 227:     for mc, sp in zip(mover_colors, sprites):\n 228:         sh, sw = sp.shape\n 229:         min_row = ir0 + sh // 2\n 230:         max_row = ir1 - (sh - 1 - sh // 2)\n 231:         min_col = ic0 + sw // 2\n 232:         max_col = ic1 - (sw - 1 - sw // 2)\n 233:         if min_row > max_row or min_col > max_col:\n 234:             return None\n 235:         avail_rows = [r for r in range(min_row, max_row + 1) if r not in occupied_rows]\n 236:         row_marks = _pick_spaced(avail_rows, random.randint(1, 2), sh)\n 237:         if not row_marks:\n 238:             return None\n 239:         avail_cols = [c for c in range(min_col, max_col + 1) if c not in occupied_cols]\n 240:         col_marks = _pick_spaced(avail_cols, random.randint(1, 2), sw)\n 241:         if not col_marks:\n 242:             return None\n 243:         mover_targets[mc] = (sorted(row_marks), sorted(col_marks))\n 244:         occupied_rows.update(row_marks)\n 245:         occupied_cols.update(col_marks)\n 246: \n 247:     # Build input grid: bg fill, then divider, frame, sprites\n 248:     inp = np.full((H, W), bg, dtype=int)\n 249:     inp[:, div_col] = divider_color\n 250: \n 251:     # Frame top/bottom edges (mirrored)\n 252:     top_edge = np.full(frame_w, frame_base, dtype=int)\n 253:     for mc, (_, cmarks) in mover_targets.items():\n 254:         for cc in cmarks:\n 255:             top_edge[cc - fc0] = mc\n 256:     inp[0, fc0:fc0 + frame_w] = top_edge\n 257:     inp[H - 1, fc0:fc0 + frame_w] = top_edge\n 258: \n 259:     # Frame left/right edges (mirrored)\n 260:     for r in range(1, H - 1):\n 261:         val = frame_base\n 262:         for mc, (rmarks, _) in mover_targets.items():\n 263:             if r in rmarks:\n 264:                 val = mc\n 265:                 break\n 266:         inp[r, fc0] = val\n 267:         inp[r, fc1] = val\n 268: \n 269:     # Stack sprites in left strip: movers top-to-bottom, then distractors\n 270:     cur_row = 0\n 271:     all_items: list[tuple[int, np.ndarray, bool]] = [\n 272:         (mc, sp, False) for mc, sp in zip(mover_colors, sprites)\n 273:     ]\n 274:     for dc_color in distractor_colors:\n 275:         ds = _make_sprite(dc_color, min(5, H - cur_row), sprite_area_w)\n 276:         if ds is None:\n 277:             return None\n 278:         all_items.append((dc_color, ds, True))\n 279: \n 280:     for mc, sp, _ in all_items:\n 281:         sh, sw = sp.shape\n 282:         if sw > sprite_area_w or cur_row + sh > H:\n 283:             return None\n 284:         c_off = random.randint(0, sprite_area_w - sw)\n 285:         for dr in range(sh):\n 286:             for dc in range(sw):\n 287:                 if sp[dr, dc] != bg:\n 288:                     inp[cur_row + dr, c_off + dc] = sp[dr, dc]\n 289:         cur_row += sh\n 290: \n 291:     # Validate: bg must be most common color so solver detects it correctly\n 292:     vals, counts = np.unique(inp, return_counts=True)\n 293:     if int(vals[np.argmax(counts)]) != bg:\n 294:         return None\n 295: \n 296:     # Run solver and verify output differs from input (movers actually moved)\n 297:     try:\n 298:         output = main(inp)\n 299:     except Exception:\n 300:         return None\n 301:     if np.array_equal(inp, output):\n 302:         return None\n 303:     return inp\n 304: \n 305: \n 306: def generate_input() -> np.ndarray:\n 307:     for _ in range(300):\n 308:         result = _gen_attempt()\n 309:         if result is not None:\n 310:             return result\n 311:     raise RuntimeError(\"generate_input: failed after 300 attempts\")\nEND_FILE\nFILE: /home/lixinyu/snap/new/ARC_code/eval/62593bfd.py\n  31: def main(grid: np.ndarray) -> np.ndarray:\n  32:     \"\"\"\n  33:     Sort objects to top or bottom edge by whether their shape (up to rotation/flip) is shared.\n  34: \n  35:     Input structure:\n  36:     - bg = most common color.\n  37:     - Several multicolor connected components (8-connected) scattered across the grid.\n  38: \n  39:     Rule:\n  40:     - Compute each object's canonical shape (binary mask, invariant to rotation and flip).\n  41:     - Objects whose shape appears in two or more components → translate to TOP edge (row 0).\n  42:     - Objects whose shape is unique → translate to BOTTOM edge (row H−h).\n  43:     - Horizontal position (left column) is preserved; only vertical translation changes.\n  44: \n  45:     Key insight: The sorting criterion is shape frequency (rotation-invariant), not area — duplicated shapes go up, unique shapes go down.\n  46:     \"\"\"\n  47:     g = np.array(grid, dtype=int)\n  48:     H, W = g.shape\n  49:     bg = int(get_bg(g))\n  50: \n  51:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n  52:     assert not (not comps)\n  53: \n  54:     extracted = []\n  55:     for comp in comps:\n  56:         r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n  57:         patch = crop_bbox(g, (r0, c0, r1, c1))\n  58: \n  59:         # Isolate this component exactly (bbox rectangle may include background).\n  60:         rel_coords = [(int(r) - r0, int(c) - c0) for r, c in comp[\"coords\"]]\n  61:         m = mask_from_coords(rel_coords, patch.shape)\n  62:         pat = np.full_like(patch, bg)\n  63:         pat[m] = patch[m]\n  64: \n  65:         extracted.append(\n  66:             {\n  67:                 \"c0\": int(c0),\n  68:                 \"pat\": pat,\n  69:                 \"shape_key\": canonical_shape_key(m),\n  70:             }\n  71:         )\n  72: \n  73:     freq = Counter(d[\"shape_key\"] for d in extracted)\n  74:     out = np.full((H, W), int(bg), dtype=int)\n  75: \n  76:     for d in extracted:\n  77:         pat = d[\"pat\"]\n  78:         h, w = map(int, pat.shape)\n  79:         dest_r0 = 0 if int(freq[d[\"shape_key\"]]) >= 2 else int(H - h)\n  80:         dest_c0 = int(d[\"c0\"])\n  81:         paste(out, pat, dest_r0, dest_c0, transparent=int(bg))\n  82: \n  83:     return out\n  84: \n  85: # --------------- generator (att2) ---------------\n  86: \n  87: _RNG = np.random.default_rng()\n  88: \n  89: # ── CFG: canvas ──────────────────────────────────────────────────────\n  90: GRID_H_RANGE = (19, 31)          # H uniform in [19, 30]\n  91: GRID_W_RANGE = (19, 31)          # W uniform in [19, 30]\n  92: NUM_COLORS = 10                   # palette 0-9\n  93: \n  94: # ── CFG: component shapes ───────────────────────────────────────────\n  95: BBOX_MAX = 5                      # max h or w of a component bbox\n  96: AREA_RANGE = (3, 13)              # component area in [3, 12]\n  97: MIN_FILL_RATIO_X10 = 4            # area * 10 >= 4 * h * w\n  98: IRREGULAR_PROB = 0.85             # prefer non-rectangular bboxes\n  99: \n 100: # ── CFG: layout ─────────────────────────────────────────────────────\n 101: DUP_LAYOUTS = [(2,), (3,), (2, 2)]  # possible duplicate-group structures\n 102: MIN_COL_GAP = 1                   # minimum column gap between components\n 103: MIN_VERTICAL_GAP = 5              # min gap between top-group bottom and bottom-group top\n 104: \n 105: # ── CFG: generation ─────────────────────────────────────────────────\n 106: MAX_RETRIES = 300                 # outer generate_input retry budget\n 107: \n 108: _NEIGHBORS8 = [(-1, -1), (-1, 0), (-1, 1), (0, -1),\n 109:                (0, 1), (1, -1), (1, 0), (1, 1)]\n 110: \n 111: \n 112: def _feasible_dims(area: int) -> list[tuple[int, int]]:\n 113:     \"\"\"Return all (h, w) bboxes where area fits with fill_ratio >= MIN_FILL_RATIO_X10/10.\"\"\"\n 114:     dims = []\n 115:     for h in range(1, BBOX_MAX + 1):\n 116:         for w in range(1, BBOX_MAX + 1):\n 117:             if area > h * w:\n 118:                 continue\n 119:             if area * 10 < MIN_FILL_RATIO_X10 * h * w:\n 120:                 continue\n 121:             if h == 1 and area != w:\n 122:                 continue\n 123:             if w == 1 and area != h:\n 124:                 continue\n 125:             if h > 1 and w > 1 and area < max(h, w):\n 126:                 continue\n 127:             dims.append((h, w))\n 128:     return dims\n 129: \n 130: \n 131: def _line_mask(h: int, w: int) -> np.ndarray:\n 132:     \"\"\"Create a seed mask along a diagonal line spanning the bbox, randomly flipped.\"\"\"\n 133:     mask = np.zeros((h, w), dtype=bool)\n 134:     if h == 1:\n 135:         mask[0, :] = True\n 136:         return mask\n 137:     if w == 1:\n 138:         mask[:, 0] = True\n 139:         return mask\n 140:     steps = max(h, w)\n 141:     for i in range(steps):\n 142:         r = int(round(i * (h - 1) / (steps - 1)))\n 143:         c = int(round(i * (w - 1) / (steps - 1)))\n 144:         mask[r, c] = True\n 145:     if bool(_RNG.integers(0, 2)):\n 146:         mask = np.flipud(mask)\n 147:     if bool(_RNG.integers(0, 2)):\n 148:         mask = np.fliplr(mask)\n 149:     return mask\n 150: \n 151: \n 152: def _make_mask(h: int, w: int, area: int) -> np.ndarray:\n 153:     \"\"\"Grow an 8-connected mask from a line seed to the target area.\"\"\"\n 154:     mask = _line_mask(h, w)\n 155:     while int(mask.sum()) < area:\n 156:         frontier = set()\n 157:         for r, c in np.argwhere(mask):\n 158:             for dr, dc in _NEIGHBORS8:\n 159:                 nr, nc = int(r) + dr, int(c) + dc\n 160:                 if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:\n 161:                     frontier.add((nr, nc))\n 162:         pick = list(frontier)\n 163:         nr, nc = pick[int(_RNG.integers(0, len(pick)))]\n 164:         mask[nr, nc] = True\n 165:     return mask\n 166: \n 167: \n 168: def _mask_to_pat(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\n 169:     \"\"\"Paint a boolean mask into a colored patch on a bg-filled array.\"\"\"\n 170:     pat = np.full(mask.shape, bg, dtype=int)\n 171:     pat[mask] = color\n 172:     return pat\n 173: \n 174: \n 175: def _make_component(area: int, color: int, bg: int) -> dict:\n 176:     \"\"\"Generate a random 8-connected component with the given area and color.\"\"\"\n 177:     dims = _feasible_dims(area)\n 178:     irregular_dims = [d for d in dims if d[0] * d[1] > area]\n 179:     if irregular_dims and _RNG.random() < IRREGULAR_PROB:\n 180:         dims = irregular_dims\n 181:     h, w = dims[int(_RNG.integers(0, len(dims)))]\n 182:     mask = _make_mask(h, w, area)\n 183:     return {\"area\": area, \"color\": color, \"h\": h, \"w\": w,\n 184:             \"mask\": mask, \"pat\": _mask_to_pat(mask, color, bg),\n 185:             \"shape_key\": canonical_shape_key(mask)}\n 186: \n 187: \n 188: def _random_transform(mask: np.ndarray) -> np.ndarray:\n 189:     \"\"\"Apply a random rotation (0-3) and optional horizontal flip to a mask.\"\"\"\n 190:     mask = np.rot90(mask, int(_RNG.integers(0, 4)))\n 191:     if bool(_RNG.integers(0, 2)):\n 192:         mask = np.fliplr(mask)\n 193:     return mask\n 194: \n 195: \n 196: def _clone_component(template: dict, color: int, bg: int) -> dict:\n 197:     \"\"\"Create a duplicate of template's shape with a new color and random transform.\"\"\"\n 198:     mask = _random_transform(template[\"mask\"].copy())\n 199:     h, w = mask.shape\n 200:     return {\"area\": template[\"area\"], \"color\": color, \"h\": h, \"w\": w,\n 201:             \"mask\": mask, \"pat\": _mask_to_pat(mask, color, bg),\n 202:             \"shape_key\": canonical_shape_key(mask)}\n 203: \n 204: \n 205: def _assign_columns(widths: list[int], W: int) -> list[int] | None:\n 206:     \"\"\"Distribute components horizontally with random spacing (min gap = MIN_COL_GAP).\"\"\"\n 207:     n = len(widths)\n 208:     total = sum(widths) + MIN_COL_GAP * (n - 1)\n 209:     if total > W:\n 210:         return None\n 211:     slack = W - total\n 212:     extras = _RNG.multinomial(slack, np.ones(n + 1) / (n + 1))\n 213:     cols = []\n 214:     c = int(extras[0])\n 215:     for i, w in enumerate(widths):\n 216:         cols.append(c)\n 217:         c += w\n 218:         if i < n - 1:\n 219:             c += MIN_COL_GAP + int(extras[i + 1])\n 220:     return cols\n 221: \n 222: \n 223: def _dilate_occupied(occupied: np.ndarray) -> np.ndarray:\n 224:     \"\"\"Return a mask that is True wherever occupied or any 8-neighbor is occupied.\"\"\"\n 225:     dilated = occupied.copy()\n 226:     dilated[1:, :] |= occupied[:-1, :]\n 227:     dilated[:-1, :] |= occupied[1:, :]\n 228:     dilated[:, 1:] |= occupied[:, :-1]\n 229:     dilated[:, :-1] |= occupied[:, 1:]\n 230:     dilated[1:, 1:] |= occupied[:-1, :-1]\n 231:     dilated[1:, :-1] |= occupied[:-1, 1:]\n 232:     dilated[:-1, 1:] |= occupied[1:, :-1]\n 233:     dilated[:-1, :-1] |= occupied[1:, 1:]\n 234:     return dilated\n 235: \n 236: \n 237: def _can_place(dilated: np.ndarray, mask: np.ndarray, r0: int, c0: int) -> bool:\n 238:     \"\"\"Check if mask placed at (r0, c0) overlaps any dilated-occupied cell.\"\"\"\n 239:     h, w = mask.shape\n 240:     return not bool((dilated[r0:r0 + h, c0:c0 + w] & mask).any())\n 241: \n 242: \n 243: def _build_output(comps: list[dict], H: int, W: int, bg: int) -> np.ndarray:\n 244:     \"\"\"Paint all components at their output positions.\"\"\"\n 245:     out = np.full((H, W), bg, dtype=int)\n 246:     for comp in comps:\n 247:         paste(out, comp[\"pat\"], comp[\"out_r0\"], comp[\"c0\"], transparent=bg)\n 248:     return out\n 249: \n 250: \n 251: def _derive_input(comps: list[dict], H: int, W: int, bg: int) -> np.ndarray | None:\n 252:     \"\"\"Place components at random non-output rows without 8-neighbor overlap.\"\"\"\n 253:     inp = np.full((H, W), bg, dtype=int)\n 254:     occupied = np.zeros((H, W), dtype=bool)\n 255:     order = list(range(len(comps)))\n 256:     _RNG.shuffle(order)\n 257:     order.sort(key=lambda i: comps[i][\"h\"] * comps[i][\"w\"], reverse=True)\n 258: \n 259:     for i in order:\n 260:         comp = comps[i]\n 261:         h, c0 = comp[\"h\"], comp[\"c0\"]\n 262:         rows = [r for r in range(H - h + 1) if r != comp[\"out_r0\"]]\n 263:         if not rows:\n 264:             rows = list(range(H - h + 1))\n 265:         _RNG.shuffle(rows)\n 266: \n 267:         dilated = _dilate_occupied(occupied)\n 268:         valid = [r for r in rows if _can_place(dilated, comp[\"mask\"], r, c0)]\n 269:         if not valid:\n 270:             valid = [r for r in range(H - h + 1)\n 271:                      if _can_place(dilated, comp[\"mask\"], r, c0)]\n 272:         if not valid:\n 273:             return None\n 274: \n 275:         r0 = valid[int(_RNG.integers(0, len(valid)))]\n 276:         comp[\"in_r0\"] = r0\n 277:         paste(inp, comp[\"pat\"], r0, c0, transparent=bg)\n 278:         mh, mw = comp[\"mask\"].shape\n 279:         occupied[r0:r0 + mh, c0:c0 + mw] |= comp[\"mask\"]\n 280:     return inp\n 281: \n 282: \n 283: def _build_groups(bg: int) -> tuple[list[dict], list[dict]]:\n 284:     \"\"\"Create duplicate-shape (top) and unique-shape (bottom) component groups.\"\"\"\n 285:     dup_layout = DUP_LAYOUTS[int(_RNG.integers(0, len(DUP_LAYOUTS)))]\n 286:     n_singletons = 2 if sum(dup_layout) == 4 else int(_RNG.integers(2, 4))\n 287: \n 288:     colors = [c for c in range(NUM_COLORS) if c != bg]\n 289:     _RNG.shuffle(colors)\n 290: \n 291:     used_shape_keys: set[tuple[bytes, tuple[int, int]]] = set()\n 292:     top, ci = [], 0\n 293:     for count in dup_layout:\n 294:         for _ in range(200):\n 295:             area = int(_RNG.integers(*AREA_RANGE))\n 296:             template = _make_component(area, colors[ci], bg)\n 297:             if template[\"shape_key\"] not in used_shape_keys:\n 298:                 used_shape_keys.add(template[\"shape_key\"])\n 299:                 break\n 300:         else:\n 301:             raise RuntimeError(\"failed to create a new duplicate template shape\")\n 302:         top.append(template)\n 303:         ci += 1\n 304:         for _ in range(count - 1):\n 305:             top.append(_clone_component(template, colors[ci], bg))\n 306:             ci += 1\n 307: \n 308:     bottom = []\n 309:     while len(bottom) < n_singletons:\n 310:         area = int(_RNG.integers(*AREA_RANGE))\n 311:         comp = _make_component(area, colors[ci], bg)\n 312:         if comp[\"shape_key\"] in used_shape_keys:\n 313:             continue\n 314:         used_shape_keys.add(comp[\"shape_key\"])\n 315:         bottom.append(comp)\n 316:         ci += 1\n 317:     return top, bottom\n 318: \n 319: \n 320: def _gen_attempt() -> np.ndarray | None:\n 321:     \"\"\"Single attempt: build output-first, derive input, validate with oracle.\"\"\"\n 322:     H = int(_RNG.integers(*GRID_H_RANGE))\n 323:     W = int(_RNG.integers(*GRID_W_RANGE))\n 324:     bg = int(_RNG.integers(0, NUM_COLORS))\n 325: \n 326:     top, bottom = _build_groups(bg)\n 327:     _RNG.shuffle(top)\n 328:     _RNG.shuffle(bottom)\n 329: \n 330:     if H - max(c[\"h\"] for c in top) - max(c[\"h\"] for c in bottom) < MIN_VERTICAL_GAP:\n 331:         return None\n 332: \n 333:     top_cols = _assign_columns([c[\"w\"] for c in top], W)\n 334:     bottom_cols = _assign_columns([c[\"w\"] for c in bottom], W)\n 335:     if top_cols is None or bottom_cols is None:\n 336:         return None\n 337: \n 338:     for comp, c0 in zip(top, top_cols):\n 339:         comp[\"c0\"], comp[\"out_r0\"] = c0, 0\n 340:     for comp, c0 in zip(bottom, bottom_cols):\n 341:         comp[\"c0\"], comp[\"out_r0\"] = c0, H - comp[\"h\"]\n 342: \n 343:     comps = top + bottom\n 344:     expected = _build_output(comps, H, W, bg)\n 345:     inp = _derive_input(comps, H, W, bg)\n 346:     if inp is None:\n 347:         return None\n 348:     if int(get_bg(inp)) != bg:\n 349:         return None\n 350: \n 351:     found = find_components(inp, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n 352:     if len(found) != len(comps):\n 353:         return None\n 354:     if Counter(len(c[\"coords\"]) for c in found) != Counter(c[\"area\"] for c in comps):\n 355:         return None\n 356:     if not np.array_equal(main(inp), expected):\n 357:         return None\n 358:     return inp\n 359: \n 360: \n 361: def generate_input() -> np.ndarray:\n 362:     for _ in range(MAX_RETRIES):\n 363:         grid = _gen_attempt()\n 364:         if grid is not None:\n 365:             return grid\n 366:     raise RuntimeError(\"failed to generate a valid 62593bfd sample\")\nEND_FILE\n","exit_code":0,"status":"completed"}}
