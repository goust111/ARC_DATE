ce(colors)\n 165:     colors.remove(moving_color)\n 166:     singleton_colors = random.sample(colors, singleton_count)\n 167:     return bg, moving_color, singleton_colors\n 168: \n 169: \n 170: def _render_pair(H, W, s, bg, moving_color, moving, singletons, shifted, singleton_pos, singleton_colors):\n 171:     \"\"\"Render the matching input/output grids for an accepted layout and palette.\"\"\"\n 172:     rect = np.full((s, s), moving_color, dtype=int)\n 173:     out = np.full((H, W), bg, dtype=int)\n 174:     for corner in moving:\n 175:         paste(out, rect, *shifted[corner])\n 176:     for corner, color in zip(singletons, singleton_colors):\n 177:         patch = np.full((s, s), color, dtype=int)\n 178:         paste(out, patch, *singleton_pos[corner])\n 179: \n 180:     inp = out.copy()\n 181:     for corner in moving:\n 182:         r, c = shifted[corner]\n 183:         inp[r : r + s, c : c + s] = bg\n 184:     for corner in moving:\n 185:         paste(inp, rect, *_corner_pos(corner, H, W, s))\n 186:     return inp, out\n 187: \n 188: \n 189: def _gen_attempt() -> np.ndarray | None:\n 190:     layout = _sample_layout()\n 191:     if layout is None:\n 192:         return None\n 193:     H, W, s, moving, singletons, shifted, singleton_pos = layout\n 194:     bg, moving_color, singleton_colors = _sample_colors(len(singletons))\n 195:     inp, out = _render_pair(H, W, s, bg, moving_color, moving, singletons, shifted, singleton_pos, singleton_colors)\n 196:     try:\n 197:         return inp if np.array_equal(main(inp), out) else None\n 198:     except AssertionError:\n 199:         return None\n 200: \n 201: \n 202: def generate_input() -> np.ndarray:\n 203:     for _ in range(GENERATION_RETRIES):\n 204:         grid = _gen_attempt()\n 205:         if grid is not None:\n 206:             return grid\n 207:     raise RuntimeError(\"failed to generate valid 22208ba4 input\")\nEND_FILE\nFILE: /home/lixinyu/snap/new/ARC_code/train/f18ec8cc.py\n  70: def main(grid: np.ndarray) -> np.ndarray:\n  71:     \"\"\"\n  72:     Reorder the vertical color-major blocks while preserving every block's internal pixels.\n  73: \n  74:     Input structure\n  75:     The grid is divided into vertical blocks, each with a unique dominant color.\n  76:     Small marker pixels from other block colors may appear inside the blocks.\n  77: \n  78:     Rule\n  79:     If adjacent shared-color marker rows read exactly as the current block order\n  80:     from right to left, reverse the blocks. Otherwise move the leftmost block to\n  81:     the far right and shift the remaining blocks left.\n  82: \n  83:     Key insight\n  84:     The transformation acts on whole vertical blocks, so marker pixels move with\n  85:     their source block instead of being recolored or independently rearranged.\n  86:     \"\"\"\n  87:     g = np.asarray(grid, dtype=int)\n  88:     assert g.ndim == 2, \"expected a 2D grid\"\n  89: \n  90:     blocks = _vertical_blocks(g)\n  91:     order = _block_order(g, blocks)\n  92:     assert sorted(order) == list(range(len(blocks))), \"block order must be a permutation\"\n  93: \n  94:     return np.concatenate([g[:, blocks[i][0] : blocks[i][1]] for i in order], axis=1)\n  95: \n  96: # --------------- generator (o5x) ---------------\n  97: # Canvas, block, and color bounds.\n  98: GEN_HEIGHT_RANGE = (7, 9)\n  99: GEN_TOTAL_WIDTH_RANGE = (10, 15)\n 100: GEN_BLOCK_COUNT_CHOICES = [3, 4]\n 101: GEN_BLOCK_WIDTH_RANGE = (3, 7)\n 102: GEN_COLOR_POOL = range(1, 10)\n 103: \n 104: # Marker-layout probabilities and row-sharing limits.\n 105: GEN_REVERSE_PROB = 0.35\n 106: GEN_ALIGNED_LEFT_SHIFT_PROB = 0.7\n 107: GEN_NONCONSECUTIVE_LEFT_SHIFT_PROB = 0.5\n 108: GEN_COMMON_COLOR_COUNT_RANGE = (0, 1)\n 109: \n 110: # Rejection-sampling retry limit.\n 111: GEN_MAX_ATTEMPTS = 300\n 112: \n 113: \n 114: def _gen_bounds(widths):\n 115:     starts = [0, *itertools.accumulate(widths[:-1])]\n 116:     return [(c0, c0 + width) for c0, width in zip(starts, widths)]\n 117: \n 118: \n 119: def _gen_expected(grid, widths, order):\n 120:     bounds = _gen_bounds(widths)\n 121:     return np.concatenate([grid[:, bounds[i][0] : bounds[i][1]] for i in order], axis=1)\n 122: \n 123: \n 124: def _gen_pick_widths(block_count):\n 125:     min_width, max_width = GEN_BLOCK_WIDTH_RANGE\n 126:     total = random.randint(\n 127:         max(GEN_TOTAL_WIDTH_RANGE[0], min_width * block_count),\n 128:         min(GEN_TOTAL_WIDTH_RANGE[1], max_width * block_count),\n 129:     )\n 130:     options = [\n 131:         widths\n 132:         for widths in itertools.product(range(min_width, max_width + 1), repeat=block_count)\n 133:         if sum(widths) == total\n 134:     ]\n 135:     return list(random.choice(options))\n 136: \n 137: \n 138: def _gen_marker_col(c0, c1):\n 139:     return random.randint(c0 + 1, c1 - 2)\n 140: \n 141: \n 142: def _gen_place_aligned(grid, widths, colors, color_rows):\n 143:     bounds = _gen_bounds(widths)\n 144:     for block_i, (c0, c1) in enumerate(bounds):\n 145:         base = colors[block_i]\n 146:         for color in colors:\n 147:             if color != base:\n 148:                 grid[color_rows[color], _gen_marker_col(c0, c1)] = color\n 149: \n 150: \n 151: def _gen_nonconsecutive_rows(height, block_count):\n 152:     options = [\n 153:         rows\n 154:         for rows in itertools.combinations(range(height), block_count)\n 155:         if rows[-1] - rows[0] + 1 != block_count\n 156:     ]\n 157:     return list(random.choice(options))\n 158: \n 159: \n 160: def _gen_place_unaligned_left_shift(grid, widths, colors):\n 161:     height = grid.shape[0]\n 162:     bounds = _gen_bounds(widths)\n 163:     common_colors = random.sample(colors, random.randint(*GEN_COMMON_COLOR_COUNT_RANGE))\n 164:     row_by_common = {color: random.randrange(height) for color in common_colors}\n 165: \n 166:     assignments = []\n 167:     for block_i, _ in enumerate(bounds):\n 168:         base = colors[bloc