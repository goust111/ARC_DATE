   ok = True\n  40:             for rr, cc in neighbors4(int(r), int(c)):\n  41:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n  42:                     ok = False\n  43:                     break\n  44:             if ok and v not in anchors_by_color:\n  45:                 anchors_by_color[int(v)] = (int(r), int(c))\n  46: \n  47:     assert not (not anchors_by_color)\n  48: \n  49:     anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n  50: \n  51:     # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n  52:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n  53: \n  54:     def component_marker_color(coords: np.ndarray) -> int | None:\n  55:         # For multi-color sprites, the marker color is the least frequent color inside the component.\n  56:         vals = [int(g[int(r), int(c)]) for r, c in coords]\n  57:         cnt = Counter(vals)\n  58:         if len(cnt) <= 1:\n  59:             return None\n  60:         return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n  61: \n  62:     def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n  63:         # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n  64:         pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n  65:         if not pts:\n  66:             return None\n  67:         if len(pts) == 1:\n  68:             return pts[0]\n  69:         S = {(int(r), int(c)) for r, c in coords}\n  70:         for r, c in pts:\n  71:             for rr, cc in neighbors4(int(r), int(c)):\n  72:                 if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n  73:                     return (int(r), int(c))\n  74:         return pts[0]\n  75: \n  76:     moves: list[tuple[np.ndarray, int, int]] = []\n  77: \n  78:     for comp in comps:\n  79:         coords = comp[\"coords\"]\n  80:         if coords.size == 0:\n  81:             continue\n  82: \n  83:         # --- STEP 3) Decide marker color for this component. ---\n  84:         marker_col = component_marker_color(coords)\n  85:         if marker_col is None:\n  86:             # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n  87:             if int(coords.shape[0]) != 1:\n  88:                 continue\n  89:             r, c = map(int, coords[0])\n  90:             v = int(g[r, c])\n  91:             if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n  92:                 continue\n  93:             marker_col = int(v)\n  94: \n  95:         if int(marker_col) not in anchors_by_color:\n  96:             continue\n  97: \n  98:         mp = marker_pixel(coords, int(marker_col))\n  99:         if mp is None:\n 100:             continue\n 101: \n 102:         ar, ac = anchors_by_color[int(marker_col)]\n 103: \n 104:         # --- STEP 4) Compute translation (dr,dc). ---\n 105:         on_top_bottom = int(ar) in (0, int(H - 1))\n 106:         on_left_right = int(ac) in (0, int(W - 1))\n 107:         horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n 108: \n 109:         dr = 0\n 110:         dc = 0\n 111:         if horizontal:\n 112:             dc = int(ac - mp[1])\n 113:         else:\n 114:             dr = int(ar - mp[0])\n 115: \n 116:         moves.append((coords, int(dr), int(dc)))\n 117: \n 118:     out = g.copy()\n 119: \n 120:     # --- STEP 5) Apply all moves. ---\n 121:     # Clear moved components first (prevents collisions with their original locations).\n 122:     for coords, _dr, _dc in moves:\n 123:         out[coords[:, 0], coords[:, 1]] = int(bg)\n 124: \n 125:     # Paste moved components:\n 126:     # - clip out-of-bounds pixels\n 127:     # - do not overwrite existing non-bg pixels\n 128:     for co