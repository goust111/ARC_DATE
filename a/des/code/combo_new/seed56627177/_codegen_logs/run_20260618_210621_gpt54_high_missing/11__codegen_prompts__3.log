{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/db7260a4.py',\n'/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py',\n'/home/lixinyu/snap/new/ARC_code/eval/581f7754.py',\n'/home/lixinyu/snap/new/ARC_code/train/22208ba4.py',\n'/home/lixinyu/snap/new/ARC_code/train/f18ec8cc.py',\n'/home/lixinyu/snap/new/ARC_code/train/d749d46f.py',\n'/home/lixinyu/snap/new/ARC_code/eval/247ef758.py',\n'/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py',\n]\nfor p in files:\n    print(f'FILE: {p}')\n    text = Path(p).read_text().splitlines()\n    keep = False\n    for i,line in enumerate(text,1):\n        if line.startswith('def main(') or line.startswith('def generate_input('):\n            keep = True\n        if keep:\n            print(f'{i:4}: {line}')\n            if keep and line.startswith('def ') and not (line.startswith('def main(') or line.startswith('def generate_input(')):\n                pass\n    print('END_FILE')\nPY\"","aggregated_output":"FILE: /home/lixinyu/snap/new/ARC_code/train/db7260a4.py\n  36: def main(grid: np.ndarray) -> np.ndarray:\n  37:     \"\"\"\n  38:     Drop the singleton marker into the matching red U-shaped container, or make a bottom-row puddle if no closed container is hit.\n  39: \n  40:     Input structure\n  41:     - The grid has a dominant background, one singleton marker pixel on the top row,\n  42:       and one other foreground color forming vertical bars and bottom segments.\n  43:     - A closed container is a U shape: two vertical side bars with a continuous\n  44:       bottom segment between them and an empty rectangular interior above the bottom.\n  45: \n  46:     Rule\n  47:     - Remove the top marker from its original cell.\n  48:     - If exactly one closed U-shaped container has the marker column within its\n  49:       horizontal footprint, fill that container's empty interior with the marker color.\n  50:     - If no closed container is under the marker column, fill the whole bottom row\n  51:       with the marker color.\n  52: \n  53:     Key insight\n  54:     - The marker does not identify a color by value; it identifies a vertical drop\n  55:       column, and only a structurally closed U shape can catch and contain the fill.\n  56:     \"\"\"\n  57:     g = np.asarray(grid, dtype=int)\n  58:     assert g.ndim == 2\n  59: \n  60:     bg = get_bg(g)\n  61:     foreground_colors = colors_present(g, exclude={bg})\n  62:     assert len(foreground_colors) == 2, \"expected marker and wall colors\"\n  63: \n  64:     singleton_colors = [color for color in foreground_colors if int(np.count_nonzero(g == color)) == 1]\n  65:     assert len(singleton_colors) == 1, \"expected exactly one singleton marker color\"\n  66:     marker_color = singleton_colors[0]\n  67: \n  68:     wall_colors = [color for color in foreground_colors if color != marker_color]\n  69:     assert len(wall_colors) == 1\n  70:     wall_color = wall_colors[0]\n  71: \n  72:     marker_coords = np.argwhere(g == marker_color)\n  73:     assert marker_coords.shape == (1, 2)\n  74:     marker_r, marker_c = map(int, marker_coords[0])\n  75:     assert marker_r == 0, \"marker must sit on the top row\"\n  76: \n  77:     containers = [\n  78:         container\n  79:         for container in _closed_u_containers(g, wall_color, bg)\n  80:         if container[0] > marker_r and container[2] <= marker_c <= container[3]\n  81:     ]\n  82:     assert len(containers) <= 1, \"marker column must select at most one closed container\"\n  83: \n  84:     out = g.copy()\n  85:     out[marker_r, marker_c] = bg\n  86:     if containers:\n  87:         top, bottom, left, right = containers[0]\n  88:         out[top:bottom, left + 1 : right] = marker_color\n  89:     else:\n  90:         assert np.all(out[-1, :] == bg), \"missed marker should fall to an empty bottom row\"\n  91:         out[-1, :] = marker_color\n  92:     return out\n  93: \n  94: # --------------- generator (o5x) ---------------\n  95: \n  96: # Fixed ARC colors and canvas.\n  97: _GEN_BG = 0\n  98: _GEN_MARKER = 1\n  99: _GEN_WALL = 2\n 100: _GEN_H = 10\n 101: _GEN_W = 10\n 102: \n 103: # Vertical layout bounds; row 9 stays empty in generated inputs.\n 104: _GEN_MARKER_ROW = 0\n 105: _GEN_MIN_WALL_ROW = 2\n 106: _GEN_LAST_WALL_ROW = 8\n 107: \n 108: # Closed container interior size ranges, with exclusive upper bounds.\n 109: _GEN_INTERIOR_H_RANGE = (2, 4)\n 110: _GEN_INTERIOR_W_RANGE = (1, 6)\n 111: \n 112: # Broken distractor patch size ranges, with exclusive upper bounds.\n 113: _GEN_DISTRACTOR_H_RANGE = (2, 4)\n 114: _GEN_DISTRACTOR_W_RANGE = (4, 7)\n 115: \n 116: # Scenario mix and distractor count ranges, with exclusive upper bounds.\n 117: _GEN_FILL_CONTAINER_PROB = 0.67\n 118: _GEN_MISSED_HAS_U_PROB = 0.55\n 119: _GEN_DISTRACTORS_WITH_U_RANGE = (0, 2)\n 120: _GEN_DISTRACTORS_WITHOUT_U_RANGE = (1, 4)\n 121: \n 122: # Rejection-sampling retry budget.\n 123: _GEN_MAX_ATTEMPTS = 300\n 124: \n 125: \n 126: def _gen_u_patch(interior_h: int, interior_w: int) -> np.ndarray:\n 127:     patch = np.full((interior_h + 1, interior_w + 2), _GEN_BG, dtype=int)\n 128:     patch[:, 0] = _GEN_WALL\n 129:     patch[:, -1] = _GEN_WALL\n 130:     patch[-1, :] = _GEN_WALL\n 131:     return patch\n 132: \n 133: \n 134: def _gen_sample_u() -> tuple[int, int, int, int, int, int]:\n 135:     interior_h = int(np.random.randint(*_GEN_INTERIOR_H_RANGE))\n 136:     interior_w = int(np.random.randint(*_GEN_INTERIOR_W_RANGE))\n 137:     top = int(np.random.randint(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - interior_h + 1))\n 138:     bottom = top + interior_h\n 139:     left = int(np.random.randint(0, _GEN_W - interior_w - 1))\n 140:     right = left + interior_w + 1\n 141:     return top, bottom, left, right, interior_h, interior_w\n 142: \n 143: \n 144: def _gen_broken_u_patch(height: int, width: int, *, gap: int | None = None, missing_side: str | None = None) -> np.ndarray:\n 145:     patch = np.full((height, width), _GEN_BG, dtype=int)\n 146:     if missing_side != \"left\":\n 147:         patch[:, 0] = _GEN_WALL\n 148:     if missing_side != \"right\":\n 149:         patch[:, -1] = _GEN_WALL\n 150:     patch[-1, :] = _GEN_WALL\n 151:     if gap is not None:\n 152:         patch[-1, gap] = _GEN_BG\n 153:     return patch\n 154: \n 155: \n 156: def _gen_distractor_patches() -> list[np.ndarray]:\n 157:     patches: list[np.ndarray] = []\n 158: \n 159:     for h in range(*_GEN_DISTRACTOR_H_RANGE):\n 160:         for w in range(*_GEN_DISTRACTOR_W_RANGE):\n 161:             gap = int(np.random.randint(1, w - 1))\n 162:             patches.append(_gen_broken_u_patch(h, w, gap=gap))\n 163:             patches.append(_gen_broken_u_patch(h, w, missing_side=\"left\"))\n 164:             patches.append(_gen_broken_u_patch(h, w, missing_side=\"right\"))\n 165: \n 166:     return patches\n 167: \n 168: \n 169: def _gen_valid_positions(grid: np.ndarray, patch: np.ndarray) -> list[tuple[int, int]]:\n 170:     ph, pw = patch.shape\n 171:     local = np.argwhere(patch == _GEN_WALL)\n 172:     local_set = {(int(r), int(c)) for r, c in local}\n 173:     touch_local = {\n 174:         (r + dr, c + dc)\n 175:         for r, c in local_set\n 176:         for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1))\n 177:         if (r + dr, c + dc) not in local_set\n 178:     }\n 179:     positions: list[tuple[int, int]] = []\n 180: \n 181:     for r0 in range(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - ph + 2):\n 182:         for c0 in range(0, _GEN_W - pw + 1):\n 183:             if np.any(grid[r0 + local[:, 0], c0 + local[:, 1]] != _GEN_BG):\n 184:                 continue\n 185:             touches = any(\n 186:                 0 <= r0 + r < _GEN_H\n 187:                 and 0 <= c0 + c < _GEN_W\n 188:                 and grid[r0 + r, c0 + c] == _GEN_WALL\n 189:                 for r, c in touch_local\n 190:             )\n 191:             if not touches:\n 192:                 positions.append((r0, c0))\n 193: \n 194:     return positions\n 195: \n 196: \n 197: def _gen_place_distractors(grid: np.ndarray, count: int) -> bool:\n 198:     patches = _gen_distractor_patches()\n 199:     for _ in range(count):\n 200:         placed = False\n 201:         for idx in np.random.permutation(len(patches)):\n 202:             patch = patches[int(idx)]\n 203:             positions = _gen_valid_positions(grid, patch)\n 204:             if not positions:\n 205:                 continue\n 206:             r0, c0 = positions[int(np.random.randint(0, len(positions)))]\n 207:             paste(grid, patch, r0, c0, transparent=_GEN_BG)\n 208:             placed = True\n 209:             break\n 210:         if not placed:\n 211:             return False\n 212:     return True\n 213: \n 214: \n 215: _GenUBox = tuple[int, int, int, int]\n 216: \n 217: \n 218: def _gen_design_expected() -> tuple[np.ndarray, bool, _GenUBox | None, int, int]:\n 219:     \"\"\"Build the expected output and return metadata needed to derive the input.\"\"\"\n 220:     expected = np.full((_GEN_H, _GEN_W), _GEN_BG, dtype=int)\n 221:     fill_container = bool(np.random.random() < _GEN_FILL_CONTAINER_PROB)\n 222:     has_u = fill_container or bool(np.random.random() < _GEN_MISSED_HAS_U_PROB)\n 223:     u_box = None\n 224: \n 225:     if has_u:\n 226:         top, bottom, left, right, interior_h, interior_w = _gen_sample_u()\n 227:         paste(expected, _gen_u_patch(interior_h, interior_w), top, left, transparent=_GEN_BG)\n 228:         u_box = (top, bottom, left, right)\n 229:         if fill_container:\n 230:             marker_c = int(np.random.randint(left + 1, right))\n 231:             expected[top:bottom, left + 1 : right] = _GEN_MARKER\n 232:         else:\n 233:             outside = [c for c in range(_GEN_W) if not (left <= c <= right)]\n 234:             marker_c = int(outside[int(np.random.randint(0, len(outside)))])\n 235:             expected[-1, :] = _GEN_MARKER\n 236:         distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITH_U_RANGE))\n 237:     else:\n 238:         marker_c = int(np.random.randint(0, _GEN_W))\n 239:         expected[-1, :] = _GEN_MARKER\n 240:         distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITHOUT_U_RANGE))\n 241: \n 242:     return expected, fill_container, u_box, marker_c, distractor_count\n 243: \n 244: \n 245: def _gen_input_from_expected(expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> np.ndarray:\n 246:     inp = expected.copy()\n 247:     if fill_container:\n 248:         assert u_box is not None\n 249:         top, bottom, left, right = u_box\n 250:         inp[top:bottom, left + 1 : right] = _GEN_BG\n 251:     else:\n 252:         inp[-1, :] = _GEN_BG\n 253:     inp[_GEN_MARKER_ROW, marker_c] = _GEN_MARKER\n 254:     return inp\n 255: \n 256: \n 257: def _gen_valid_pair(inp: np.ndarray, expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> bool:\n 258:     \"\"\"Check structural invariants and the solver oracle.\"\"\"\n 259:     if np.count_nonzero(inp == _GEN_MARKER) != 1 or inp[_GEN_MARKER_ROW, marker_c] != _GEN_MARKER:\n 260:         return False\n 261:     if not np.all(inp[-1, :] == _GEN_BG):\n 262:         return False\n 263: \n 264:     wall_coords = np.argwhere(inp == _GEN_WALL)\n 265:     if wall_coords.size == 0 or int(wall_coords[:, 0].min()) < _GEN_MIN_WALL_ROW or int(wall_coords[:, 0].max()) > _GEN_LAST_WALL_ROW:\n 266:         return False\n 267: \n 268:     component_count = len(find_components(inp, bg=_GEN_BG, colors=[_GEN_WALL], connectivity=4))\n 269:     if not (1 <= component_count <= 3):\n 270:         return False\n 271: \n 272:     containers = _closed_u_containers(inp, _GEN_WALL, _GEN_BG)\n 273:     if len(containers) > 1:\n 274:         return False\n 275:     if any(marker_c in (left, right) for _top, _bottom, left, right in containers):\n 276:         return False\n 277:     if fill_container:\n 278:         if len(containers) != 1 or containers[0] != u_box:\n 279:             return False\n 280:     elif containers and containers[0][2] <= marker_c <= containers[0][3]:\n 281:         return False\n 282: \n 283:     try:\n 284:         actual = main(inp)\n 285:     except Exception:\n 286:         return False\n 287:     return np.array_equal(actual, expected)\n 288: \n 289: \n 290: def _gen_attempt() -> np.ndarray | None:\n 291:     expected, fill_container, u_box, marker_c, distractor_count = _gen_design_expected()\n 292:     if not _gen_place_distractors(expected, distractor_count):\n 293:         return None\n 294: \n 295:     inp = _gen_input_from_expected(expected, fill_container, u_box, marker_c)\n 296:     if not _gen_valid_pair(inp, expected, fill_container, u_box, marker_c):\n 297:         return None\n 298:     return inp\n 299: \n 300: \n 301: def generate_input() -> np.ndarray:\n 302:     for _ in range(_GEN_MAX_ATTEMPTS):\n 303:         grid = _gen_attempt()\n 304:         if grid is not None:\n 305:             return grid\n 306:     raise RuntimeError(\"failed to generate valid db7260a4 input\")\nEND_FILE\nFILE: /home/lixinyu/snap/new/ARC_code/eval/a25697e4.py\n   8: def main(grid: np.ndarray) -> np.ndarray:\n   9:     \"\"\"\n  10:     Dock movable tools into border-anchored frames by filling cavities.\n  11: \n  12:     Input structure:\n  13:     - bg = most common color.\n  14:     - Border-touching components cluster into anchor frames with interior bg cavities.\n  15:     - Non-border 2-color components are movable tools.\n  16: \n  17:     Rule:\n  18:     - Match each tool to a frame whose cavity size equals one of its color-region counts.\n  19:     - Rotate/flip the tool so one color fills the cavity exactly; the other stays outside.\n  20:     - If the docking orientation uses a reflection, swap the tool's two colors.\n  21: \n  22:     Key insight: Cavity size determines tool–frame pairing; reflection triggers color swap.\n  23:     \"\"\"\n  24:     inp = grid\n  25:     g = inp.copy()\n  26:     bg = get_bg(g)\n  27:     H, W = g.shape\n  28: \n  29:     def bbox_gap(a, b) -> int:\n  30:         (ar0, ac0, ar1, ac1) = a\n  31:         (br0, bc0, br1, bc1) = b\n  32:         def gap1(x0, x1, y0, y1):\n  33:             if y1 < x0:\n  34:                 return int(x0 - y1)\n  35:             if x1 < y0:\n  36:                 return int(y0 - x1)\n  37:             return 0\n  38:         return gap1(ar0, ar1, br0, br1) + gap1(ac0, ac1, bc0, bc1)\n  39: \n  40:     fg = g != int(bg)\n  41:     lab, n = label(fg, structure=STRUCT4)\n  42:     fixed_mask = np.zeros((H, W), dtype=bool)\n  43:     fixed_components = []\n  44:     for cid in range(1, n + 1):\n  45:         pts = np.argwhere(lab == cid)\n  46:         pts_list = [(int(r), int(c)) for r, c in pts]\n  47:         touches = any(r == 0 or r == H - 1 or c == 0 or c == W - 1 for r, c in pts_list)\n  48:         if not touches:\n  49:             continue\n  50:         fixed_components.append({\"pts\": pts_list, \"bbox\": (int(pts[:,0].min()), int(pts[:,1].min()), int(pts[:,0].max()), int(pts[:,1].max()))})\n  51:         for r, c in pts_list:\n  52:             fixed_mask[r, c] = True\n  53: \n  54:     assert not (not fixed_components)\n  55: \n  56:     # Cluster fixed components into anchor frames.\n  57:     parent = list(range(len(fixed_components)))\n  58: \n  59:     def find(x):\n  60:         while parent[x] != x:\n  61:             parent[x] = parent[parent[x]]\n  62:             x = parent[x]\n  63:         return x\n  64: \n  65:     def union(a, b):\n  66:         ra, rb = find(a), find(b)\n  67:         if ra != rb:\n  68:             parent[rb] = ra\n  69: \n  70:     for i in range(len(fixed_components)):\n  71:         for j in range(i + 1, len(fixed_components)):\n  72:             if bbox_gap(fixed_components[i][\"bbox\"], fixed_components[j][\"bbox\"]) <= 2:\n  73:                 union(i, j)\n  74: \n  75:     groups: dict[int, list[int]] = {}\n  76:     for i in range(len(fixed_components)):\n  77:         groups.setdefault(find(i), []).append(i)\n  78: \n  79:     anchor_groups = []\n  80:     for idxs in groups.values():\n  81:         pts = [p for i in idxs for p in fixed_components[i][\"pts\"]]\n  82:         rs = [r for r, _c in pts]\n  83:         cs = [c for _r, c in pts]\n  84:         bbox = (min(rs), min(cs), max(rs), max(cs))\n  85:         mask = np.zeros((H, W), dtype=bool)\n  86:         for r, c in pts:\n  87:             mask[r, c] = True\n  88:         sock = np.zeros((H, W), dtype=bool)\n  89:         for r in range(bbox[0], bbox[2] + 1):\n  90:             for c in range(bbox[1], bbox[3] + 1):\n  91:                 if int(g[r, c]) != int(bg):\n  92:                     continue\n  93:                 for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n  94:                     rr, cc = r + dr, c + dc\n  95:                     if 0 <= rr < H and 0 <= cc < W and mask[rr, cc]:\n  96:                         sock[r, c] = True\n  97:                         break\n  98: \n  99:         # Cavity = largest bg component inside bbox that is adjacent to the anchor pixels.\n 100:         cavity = np.zeros((H, W), dtype=bool)\n 101:         sub_bg = (g[bbox[0] : bbox[2] + 1, bbox[1] : bbox[3] + 1] == int(bg))\n 102:         sub_lab, sub_n = label(sub_bg, structure=STRUCT4)\n 103:         best_c = None  # (area, cid)\n 104:         for cid in range(1, sub_n + 1):\n 105:             ptsc = np.argwhere(sub_lab == cid)\n 106:             area = int(len(ptsc))\n 107:             # check adjacency to anchor within bbox\n 108:             adj = False\n 109:             for rr, cc in ptsc:\n 110:                 r = int(bbox[0] + rr)\n 111:                 c = int(bbox[1] + cc)\n 112:                 for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n 113:                     r2, c2 = r + dr, c + dc\n 114:                     if bbox[0] <= r2 <= bbox[2] and bbox[1] <= c2 <= bbox[3] and mask[r2, c2]:\n 115:                         adj = True\n 116:                         break\n 117:                 if adj:\n 118:                     break\n 119:             if not adj:\n 120:                 continue\n 121:             cand = (area, -cid)\n 122:             if best_c is None or cand > best_c:\n 123:                 best_c = cand\n 124:                 best_id = cid\n 125:         if best_c is not None:\n 126:             ptsc = np.argwhere(sub_lab == best_id)\n 127:             for rr, cc in ptsc:\n 128:                 cavity[int(bbox[0] + rr), int(bbox[1] + cc)] = True\n 129:         cav_bbox = None\n 130:         if cavity.any():\n 131:             ptsc2 = np.argwhere(cavity)\n 132:             r0c, c0c = ptsc2.min(axis=0)\n 133:             r1c, c1c = ptsc2.max(axis=0)\n 134:             cav_bbox = (int(r0c), int(c0c), int(r1c), int(c1c))\n 135: \n 136:         # swap rule for this anchor group: look for a color that appears in >=2 fixed sub-components\n 137:         # (within the group) with different sizes and larger-above-smaller.\n 138:         swap_needed = False\n 139:         for col in sorted({int(x) for x in np.unique(g[mask])} - {int(bg)}):\n 140:             sub = (g == int(col)) & mask\n 141:             labc, nc = label(sub, structure=STRUCT4)\n 142:             if nc < 2:\n 143:                 continue\n 144:             comps = []\n 145:             for cid in range(1, nc + 1):\n 146:                 ptsc = np.argwhere(labc == cid)\n 147:                 comps.append((int(len(ptsc)), float(ptsc[:, 0].mean()), float(ptsc[:, 1].mean())))\n 148:             comps.sort(reverse=True)\n 149:             (s0, r0, _c0), (s1, r1, _c1) = comps[0], comps[1]\n 150:             # Swap only when the larger component is vertically above the smaller one.\n 151:             if s0 != s1 and r0 < r1:\n 152:                 swap_needed = True\n 153:                 break\n 154: \n 155:         # Dominant open direction: which side has the most bg neighbors.\n 156:         dir_list = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # U,D,L,R\n 157:         dir_counts = [0, 0, 0, 0]\n 158:         for r, c in pts:\n 159:             for di, (dr, dc) in enumerate(dir_list):\n 160:                 rr, cc = r + dr, c + dc\n 161:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(bg):\n 162:                     dir_counts[di] += 1\n 163:         open_dir = dir_list[int(np.argmax(dir_counts))]\n 164:         _labg, _ng = label(mask, structure=STRUCT4)\n 165:         single_piece = int(_ng) == 1\n 166:         cavity_size = int(cavity.sum())\n 167: \n 168:         anchor_groups.append(\n 169:             {\n 170:                 \"mask\": mask,\n 171:                 \"bbox\": bbox,\n 172:                 \"socket_mask\": sock,\n 173:                 \"cavity_mask\": cavity,\n 174:                 \"cavity_bbox\": cav_bbox,\n 175:                 \"open_dir\": open_dir,\n 176:                 \"swap_needed\": swap_needed,\n 177:                 \"single_piece\": single_piece,\n 178:                 \"cavity_size\": cavity_size,\n 179:                 \"size\": int(mask.sum()),\n 180:             }\n 181:         )\n 182:     anchor_groups.sort(key=lambda d: -d[\"size\"])\n 183: \n 184:     # Movable multi-color components are the remaining foreground pixels.\n 185:     mov_mask = fg & (~fixed_mask)\n 186:     mov_lab, mov_n = label(mov_mask, structure=STRUCT4)\n 187:     mov_comps = []\n 188:     for cid in range(1, mov_n + 1):\n 189:         pts = np.argwhere(mov_lab == cid)\n 190:         r0, c0 = pts.min(axis=0)\n 191:         r1, c1 = pts.max(axis=0)\n 192:         m = mov_lab[r0 : r1 + 1, c0 : c1 + 1] == cid\n 193:         patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n 194:         patch[~m] = 0\n 195:         mov_comps.append({\"bbox\": (int(r0), int(c0), int(r1), int(c1)), \"mask\": m, \"patch\": patch, \"size\": int(len(pts))})\n 196:     mov_comps.sort(key=lambda d: -d[\"size\"])\n 197: \n 198:     def choose_group(bbox) -> int:\n 199:         best_i = 0\n 200:         best_d = None\n 201:         for i, grp in enumerate(anchor_groups):\n 202:             d = bbox_gap(bbox, grp[\"bbox\"])\n 203:             if best_d is None or d < best_d:\n 204:                 best_d = d\n 205:                 best_i = i\n 206:         return int(best_i)\n 207: \n 208:     def gen_variants(patch: np.ndarray, mask: np.ndarray):\n 209:         \"\"\"All unique dihedral variants, with a reflection flag.\"\"\"\n 210:         base: list[tuple[np.ndarray, np.ndarray, bool]] = []\n 211:         for k in range(4):\n 212:             p = np.rot90(patch, k)\n 213:             m = np.rot90(mask, k)\n 214:             base.append((p, m, False))\n 215:             base.append((np.fliplr(p), np.fliplr(m), True))\n 216:         uniq: list[tuple[np.ndarray, np.ndarray, bool]] = []\n 217:         seen = set()\n 218:         for p, m, is_flip in base:\n 219:             key = (m.tobytes(), p[m].tobytes())\n 220:             if key in seen:\n 221:                 continue\n 222:             seen.add(key)\n 223:             uniq.append((p, m, is_flip))\n 224:         return uniq\n 225: \n 226:     out = np.full_like(g, int(bg))\n 227:     out[fixed_mask] = g[fixed_mask]\n 228:     placed_global = fixed_mask.copy()\n 229:     placed_groups = [grp[\"mask\"].copy() for grp in anchor_groups]\n 230: \n 231:     group_for_comp: list[int]\n 232:     # Match condition (key): a tool can dock into a frame only if one of its two color-regions has\n 233:     # pixel-count equal to the frame's cavity size. Use this to assign tools to frames (one-to-one\n 234:     # when counts match), falling back to distance only if no such match exists.\n 235:     comp_color_counts: list[dict[int, int]] = []\n 236:     for comp in mov_comps:\n 237:         vals = [int(x) for x in comp[\"patch\"][comp[\"mask\"]].flatten() if int(x) != 0]\n 238:         comp_color_counts.append(dict(Counter(vals)))\n 239: \n 240:     def compatible(ci: int, gi: int) -> bool:\n 241:         cav_sz = int(anchor_groups[gi][\"cavity_size\"])\n 242:         return any(int(v) == cav_sz for v in comp_color_counts[ci].values())\n 243: \n 244:     if len(mov_comps) == len(anchor_groups) and len(anchor_groups) > 1:\n 245:         import itertools\n 246: \n 247:         best_perm = None\n 248:         best_score = None\n 249:         for perm in itertools.permutations(range(len(anchor_groups))):\n 250:             ok = True\n 251:             hits = 0\n 252:             dist_sum = 0\n 253:             for ci, gi in enumerate(perm):\n 254:                 if not compatible(ci, gi):\n 255:                     ok = False\n 256:                     break\n 257:                 hits += 1\n 258:                 dist_sum += bbox_gap(mov_comps[ci][\"bbox\"], anchor_groups[gi][\"bbox\"])\n 259:             if not ok:\n 260:                 continue\n 261:             score = (int(hits), -int(dist_sum))\n 262:             if best_score is None or score > best_score:\n 263:                 best_score = score\n 264:                 best_perm = perm\n 265:         assert best_perm is not None, 'must find a compatible tool-to-frame permutation'\n 266:         group_for_comp = [int(x) for x in best_perm]\n 267:     else:\n 268:         group_for_comp = []\n 269:         for ci, comp in enumerate(mov_comps):\n 270:             best_g = None\n 271:             best_d = None\n 272:             for gi, grp in enumerate(anchor_groups):\n 273:                 if not compatible(ci, gi):\n 274:                     continue\n 275:                 d = bbox_gap(comp[\"bbox\"], grp[\"bbox\"])\n 276:                 if best_d is None or d < best_d:\n 277:                     best_d = d\n 278:                     best_g = gi\n 279:             group_for_comp.append(int(best_g) if best_g is not None else int(choose_group(comp[\"bbox\"])))\n 280: \n 281:     for comp, gi in zip(mov_comps, group_for_comp):\n 282:         grp = anchor_groups[gi]\n 283:         placed_grp = placed_groups[gi]\n 284:         sock = grp[\"socket_mask\"]\n 285:         cav = grp[\"cavity_mask\"]\n 286:         cav_bbox = grp[\"cavity_bbox\"]\n 287:         odr, odc = grp[\"open_dir\"]\n 288:         # Swap rule (more principled): swap the two tool colors iff the *docking transform* uses a\n 289:         # reflection (flip). We'll detect this from the winning variant. (Ignore equal-area 2-color\n 290:         # tools: swapping is ambiguous and not needed.)\n 291:         comp_vals = [int(x) for x in comp[\"patch\"][comp[\"mask\"]].flatten() if int(x) != 0]\n 292:         comp_counts = Counter(comp_vals)\n 293: \n 294:         best_state = None\n 295:         # Score prioritizes *filling the cavity* with exactly one tool color region.\n 296:         # (plug_full, plug_hits, -nonplug_in_cavity, -plug_outside, cavity_hits, adj, outside, socket_hits, -dist, -r0, -c0)\n 297:         best_score = None\n 298:         cav_sz = int(grp[\"cavity_size\"])\n 299:         for p, m, is_flip in gen_variants(comp[\"patch\"], comp[\"mask\"]):\n 300:             h, w = m.shape\n 301:             coords = np.argwhere(m)\n 302:             cols_here = sorted({int(x) for x in p[m].flatten() if int(x) != 0})\n 303:             plug_colors = [int(col) for col in cols_here if int(((p == int(col)) & m).sum()) == cav_sz]\n 304:             assert plug_colors\n 305:             for r0 in range(0, H - h + 1):\n 306:                 for c0 in range(0, W - w + 1):\n 307:                     ok = True\n 308:                     for rr, cc in coords:\n 309:                         r = int(r0 + rr)\n 310:                         c = int(c0 + cc)\n 311:                         if placed_global[r, c]:\n 312:                             ok = False\n 313:                             break\n 314:                     if not ok:\n 315:                         continue\n 316:                     adj = 0\n 317:                     for rr, cc in coords:\n 318:                         r = int(r0 + rr)\n 319:                         c = int(c0 + cc)\n 320:                         for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n 321:                             r2, c2 = r + dr, c + dc\n 322:                             if 0 <= r2 < H and 0 <= c2 < W and placed_grp[r2, c2]:\n 323:                                 adj += 1\n 324:                     if adj == 0:\n 325:                         continue\n 326:                     socket_hits = 0\n 327:                     cavity_hits = 0\n 328:                     outside = 0\n 329:                     # Best plug-match for this placement among candidate plug colors.\n 330:                     plug_best = None  # (plug_full, plug_hits, -nonplug_in_cavity, -plug_outside)\n 331:                     for rr, cc in coords:\n 332:                         r = int(r0 + rr)\n 333:                         c = int(c0 + cc)\n 334:                         if sock[r, c]:\n 335:                             socket_hits += 1\n 336:                         if cav[r, c]:\n 337:                             cavity_hits += 1\n 338:                         # Count pixels placed outside the anchor bbox in the dominant open direction.\n 339:                         br0, bc0, br1, bc1 = grp[\"bbox\"]\n 340:                         if odc == -1 and c < bc0:\n 341:                             outside += 1\n 342:                         elif odc == 1 and c > bc1:\n 343:                             outside += 1\n 344:                         elif odr == -1 and r < br0:\n 345:                             outside += 1\n 346:                         elif odr == 1 and r > br1:\n 347:                             outside += 1\n 348: \n 349:                     for plug_col in plug_colors:\n 350:                         if plug_col is None:\n 351:                             plug_score = (0, 0, 0, 0)\n 352:                         else:\n 353:                             plug_hits = 0\n 354:                             plug_outside = 0\n 355:                             nonplug_in_cav = 0\n 356:                             for rr, cc in coords:\n 357:                                 r = int(r0 + rr)\n 358:                                 c = int(c0 + cc)\n 359:                                 in_cav = bool(cav[r, c])\n 360:                                 col = int(p[rr, cc])\n 361:                                 if col == int(plug_col):\n 362:                                     if in_cav:\n 363:                                         plug_hits += 1\n 364:                                     else:\n 365:                                         plug_outside += 1\n 366:                                 else:\n 367:                                     if in_cav:\n 368:                                         nonplug_in_cav += 1\n 369:                             plug_full = int(plug_hits == cav_sz and plug_outside == 0 and nonplug_in_cav == 0)\n 370:                             plug_score = (int(plug_full), int(plug_hits), -int(nonplug_in_cav), -int(plug_outside))\n 371:                         if plug_best is None or plug_score > plug_best:\n 372:                             plug_best = plug_score\n 373:                     dist = bbox_gap(grp[\"bbox\"], (int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1)))\n 374:                     score = tuple(plug_best) + (\n 375:                         int(cavity_hits),\n 376:                         int(adj),\n 377:                         int(outside),\n 378:                         int(socket_hits),\n 379:                         -int(dist),\n 380:                         -int(r0),\n 381:                         -int(c0),\n 382:                     )\n 383:                     if best_score is None or score > best_score:\n 384:                         best_score = score\n 385:                         best_state = (p, m, int(r0), int(c0), bool(is_flip))\n 386: \n 387:         assert best_state is not None, 'must find a valid placement for every movable tool'\n 388:         p, m, r0, c0, is_flip = best_state\n 389:         if is_flip and len(comp_counts) == 2 and len(set(comp_counts.values())) == 2:\n 390:             a, b = sorted(comp_counts.keys())\n 391:             q = p.copy()\n 392:             q[(p == a) & m] = b\n 393:             q[(p == b) & m] = a\n 394:             p = q\n 395:         for rr, cc in np.argwhere(m):\n 396:             r = int(r0 + rr)\n 397:             c = int(c0 + cc)\n 398:             out[r, c] = int(p[rr, cc])\n 399:             placed_global[r, c] = True\n 400:             placed_grp[r, c] = True\n 401: \n 402:     return out\n 403: \n 404: # --------------- generator (O4) ---------------\n 405: \n 406: from arc_utils import bbox as _bbox\n 407: \n 408: # ── CFG: canvas ──\n 409: GRID_H_RANGE = (18, 30)          # output grid height\n 410: GRID_W_RANGE = (25, 30)          # output grid width\n 411: NUM_PAIRS_CHOICES = [1, 2]       # how many frame-tool pairs\n 412: \n 413: # ── CFG: frame geometry ──\n 414: FRAME_W_RANGE = (4, 8)           # frame width (exclusive upper)\n 415: NOTCH_N_RANGE = (1, 4)           # notch cell count (exclusive upper)\n 416: TOP_H_RANGE = (1, 4)             # top bar height (exclusive upper)\n 417: BOT_H_RANGE = (2, 4)             # bottom bar height (exclusive upper)\n 418: PLUG_AREA_BOUNDS = (5, 8)        # valid plug area = fw + notch_n\n 419: \n 420: # ── CFG: tool sizing ──\n 421: HANDLE_AREA_RANGE = (4, 10)      # handle pixel count (exclusive upper)\n 422: TOOL_TOTAL_BOUNDS = (10, 15)     # plug + handle total pixels\n 423: HANDLE_SPRITE_DIM = (2, 5)      # handle sprite bbox side (exclusive upper)\n 424: \n 425: # ── CFG: placement ──\n 426: UNION_BBOX_GAP_MIN = 2           # min gap between pair union bboxes\n 427: FRAME_BBOX_GAP_MIN = 3           # min gap between frame bboxes\n 428: TOOL_BORDER = 1                  # border margin for free tool placement\n 429: TOOL_PADDING = 3                 # padding around existing content\n 430: TOOL_PADDING_CONN = 4            # connectivity for padding check\n 431: \n 432: # ── CFG: retry limits ──\n 433: PAIR_SPEC_RETRIES = 300          # retries for picking compatible pair specs\n 434: HANDLE_SPRITE_RETRIES = 30       # retries for generating a valid handle sprite\n 435: GEN_ATTEMPT_RETRIES = 300        # outer retries in generate_input()\n 436: \n 437: \n 438: def _bbox_gap(a, b) -> int:\n 439:     \"\"\"Manhattan gap between two axis-aligned bboxes (r0,c0,r1,c1).\"\"\"\n 440:     (ar0, ac0, ar1, ac1) = a\n 441:     (br0, bc0, br1, bc1) = b\n 442: \n 443:     def _gap1(x0, x1, y0, y1):\n 444:         if y1 < x0:\n 445:             return x0 - y1\n 446:         if x1 < y0:\n 447:             return y0 - x1\n 448:         return 0\n 449: \n 450:     return _gap1(ar0, ar1, br0, br1) + _gap1(ac0, ac1, bc0, bc1)\n 451: \n 452: \n 453: def _transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:\n 454:     \"\"\"Apply rot90(k) then optional horizontal flip.\"\"\"\n 455:     out = np.rot90(arr, k)\n 456:     if flip:\n 457:         out = np.fliplr(out)\n 458:     return out\n 459: \n 460: \n 461: def _orient_left_to_side(arr: np.ndarray, side: str) -> np.ndarray:\n 462:     \"\"\"Rotate/flip an array built for the left border to target the given side.\"\"\"\n 463:     if side == \"left\":\n 464:         return arr.copy()\n 465:     if side == \"right\":\n 466:         return np.fliplr(arr)\n 467:     if side == \"top\":\n 468:         return np.rot90(arr, 3)\n 469:     if side == \"bottom\":\n 470:         return np.rot90(arr, 1)\n 471:     raise ValueError(side)\n 472: \n 473: \n 474: def _swap_colors(patch: np.ndarray, a: int, b: int) -> np.ndarray:\n 475:     \"\"\"Swap two colors in a patch, returning a new array.\"\"\"\n 476:     out = patch.copy()\n 477:     ma, mb = out == a, out == b\n 478:     out[ma] = b\n 479:     out[mb] = a\n 480:     return out\n 481: \n 482: \n 483: def _notch_offsets(notch_n: int, fw: int, bot_h: int) -> list[tuple[int, int]]:\n 484:     \"\"\"Return (row, col) offsets within the bottom bar to carve out a staircase notch.\"\"\"\n 485:     if notch_n == 1:\n 486:         return [(0, fw - 1)]\n 487:     if notch_n == 2:\n 488:         return [(0, fw - 2), (0, fw - 1)]\n 489:     if notch_n == 3:\n 490:         if bot_h >= 2:\n 491:             return [(0, fw - 2), (0, fw - 1), (1, fw - 1)]\n 492:         return [(0, fw - 3), (0, fw - 2), (0, fw - 1)]\n 493:     raise ValueError(notch_n)\n 494: \n 495: \n 496: def _make_handle_sprite(handle_area: int, bg: int, handle_color: int) -> np.ndarray | None:\n 497:     \"\"\"Generate a random 4-connected handle sprite with exactly handle_area pixels.\"\"\"\n 498:     lo, hi = HANDLE_SPRITE_DIM\n 499:     dims = [(h, w) for h in range(lo, hi) for w in range(lo, hi)\n 500:             if handle_area <= h * w <= handle_area * 2]\n 501:     if not dims:\n 502:         return None\n 503:     for _ in range(HANDLE_SPRITE_RETRIES):\n 504:         h, w = random.choice(dims)\n 505:         sprite = random_sprite(\n 506:             h, w, density=handle_area / (h * w),\n 507:             color_palette=[handle_color], connectivity=4, background=bg,\n 508:         )\n 509:         if int(np.sum(sprite != bg)) == handle_area:\n 510:             return sprite\n 511:     return None\n 512: \n 513: \n 514: def _build_left_pair(\n 515:     *, bg: int, frame_color: int, plug_color: int, handle_color: int,\n 516:     fw: int, top_h: int, bot_h: int, notch_n: int, handle_area: int,\n 517: ) -> tuple[np.ndarray, np.ndarray] | None:\n 518:     \"\"\"Build a frame + docked tool pair oriented for the left border.\n 519: \n 520:     Returns (frame_array, tool_array) on the same canvas, or None on failure.\n 521:     \"\"\"\n 522:     fh = top_h + 1 + bot_h\n 523:     frame = np.full((fh, fw), bg, dtype=int)\n 524:     frame[:top_h, :] = frame_color\n 525:     frame[top_h + 1:, :] = frame_color\n 526:     for dr, dc in _notch_offsets(notch_n, fw, bot_h):\n 527:         frame[top_h + 1 + dr, dc] = bg\n 528: \n 529:     cavity = frame == bg\n 530:     attach_rows = {r for r in range(fh) if cavity[r, fw - 1]}\n 531: \n 532:     handle_sprite = _make_handle_sprite(handle_area, bg, handle_color)\n 533:     if handle_sprite is None:\n 534:         return None\n 535: \n 536:     hs_h, hs_w = handle_sprite.shape\n 537:     sprite_left_rows = {r for r in range(hs_h) if handle_sprite[r, 0] != bg}\n 538: \n 539:     valid_offsets = [\n 540:         voff for voff in range(fh)\n 541:         if any((voff + sr) in attach_rows for sr in sprite_left_rows)\n 542:     ]\n 543:     if not valid_offsets:\n 544:         return None\n 545: \n 546:     voff = random.choice(valid_offsets)\n 547:     total_h = max(fh, voff + hs_h)\n 548:     total_w = fw + hs_w\n 549: \n 550:     frame_full = np.full((total_h, total_w), bg, dtype=int)\n 551:     frame_full[:fh, :fw] = frame\n 552: \n 553:     tool = np.full((total_h, total_w), bg, dtype=int)\n 554:     tool[:fh, :fw][cavity] = plug_color\n 555:     handle_mask = handle_sprite != bg\n 556:     tool[voff:voff + hs_h, fw:fw + hs_w][handle_mask] = handle_color\n 557: \n 558:     return frame_full, tool\n 559: \n 560: \n 561: def _build_param_options() -> list[tuple[int, int, int, int]]:\n 562:     \"\"\"Enumerate all valid (fw, top_h, bot_h, notch_n) combinations.\"\"\"\n 563:     fw_lo, fw_hi = FRAME_W_RANGE\n 564:     nn_lo, nn_hi = NOTCH_N_RANGE\n 565:     th_lo, th_hi = TOP_H_RANGE\n 566:     bh_lo, bh_hi = BOT_H_RANGE\n 567:     pa_lo, pa_hi = PLUG_AREA_BOUNDS\n 568:     return [\n 569:         (fw, top_h, bot_h, notch_n)\n 570:         for fw in range(fw_lo, fw_hi)\n 571:         for notch_n in range(nn_lo, nn_hi)\n 572:         if pa_lo <= fw + notch_n <= pa_hi\n 573:         for top_h in range(th_lo, th_hi)\n 574:         for bot_h in range(bh_lo, bh_hi)\n 575:     ]\n 576: \n 577: \n 578: PARAM_OPTIONS = _build_param_options()\n 579: \n 580: \n 581: def _pick_pair_specs(num_pairs: int) -> list[dict]:\n 582:     \"\"\"Pick frame geometry specs for each pair, ensuring distinct plug areas.\"\"\"\n 583:     ha_lo, ha_hi = HANDLE_AREA_RANGE\n 584:     tt_lo, tt_hi = TOOL_TOTAL_BOUNDS\n 585:     specs: list[dict] = []\n 586:     for _ in range(PAIR_SPEC_RETRIES):\n 587:         specs.clear()\n 588:         used_plug_areas: set[int] = set()\n 589:         for _ in range(num_pairs):\n 590:             candidates = [x for x in PARAM_OPTIONS if x[0] + x[3] not in used_plug_areas]\n 591:             if not candidates:\n 592:                 specs = []\n 593:                 break\n 594:             fw, top_h, bot_h, notch_n = random.choice(candidates)\n 595:             plug_area = fw + notch_n\n 596:             specs.append({\"fw\": fw, \"top_h\": top_h, \"bot_h\": bot_h,\n 597:                           \"notch_n\": notch_n, \"plug_area\": plug_area})\n 598:             used_plug_areas.add(plug_area)\n 599:         if len(specs) != num_pairs:\n 600:             continue\n 601:         all_plug_areas = {s[\"plug_area\"] for s in specs}\n 602:         ok = True\n 603:         for spec in specs:\n 604:             pa = spec[\"plug_area\"]\n 605:             handle_choices = [\n 606:                 h for h in range(ha_lo, ha_hi)\n 607:                 if tt_lo <= pa + h <= tt_hi and h != pa and h not in all_plug_areas\n 608:             ]\n 609:             if not handle_choices:\n 610:                 ok = False\n 611:                 break\n 612:             spec[\"handle_area\"] = random.choice(handle_choices)\n 613:         if ok:\n 614:             return [dict(s) for s in specs]\n 615:     return []\n 616: \n 617: \n 618: def _candidate_origins(side: str, ph: int, pw: int, H: int, W: int) -> list[tuple[int, int]]:\n 619:     \"\"\"Return shuffled candidate (r0, c0) origins for placing a patch on the given border side.\"\"\"\n 620:     if side == \"left\":\n 621:         origins = [(r0, 0) for r0 in range(H - ph + 1)]\n 622:     elif side == \"right\":\n 623:         origins = [(r0, W - pw) for r0 in range(H - ph + 1)]\n 624:     elif side == \"top\":\n 625:         origins = [(0, c0) for c0 in range(W - pw + 1)]\n 626:     elif side == \"bottom\":\n 627:         origins = [(H - ph, c0) for c0 in range(W - pw + 1)]\n 628:     else:\n 629:         raise ValueError(side)\n 630:     random.shuffle(origins)\n 631:     return origins\n 632: \n 633: \n 634: def _variant_choices(patch: np.ndarray) -> list[tuple[np.ndarray, bool]]:\n 635:     \"\"\"Return shuffled list of unique D4 variants of patch, each with its flip flag.\"\"\"\n 636:     seen = set()\n 637:     out: list[tuple[np.ndarray, bool]] = []\n 638:     mask = patch != 0\n 639:     for k in range(4):\n 640:         for flip in (False, True):\n 641:             q = _transform(patch, k, flip)\n 642:             m = _transform(mask.astype(np.uint8), k, flip).astype(bool)\n 643:             key = (m.tobytes(), q[m].tobytes())\n 644:             if key in seen:\n 645:                 continue\n 646:             seen.add(key)\n 647:             out.append((q, flip))\n 648:     random.shuffle(out)\n 649:     return out\n 650: \n 651: \n 652: def _place_docked_pair(\n 653:     i: int, spec: dict, colors: list[int], side: str, bg: int,\n 654:     H: int, W: int, output: np.ndarray, input_grid: np.ndarray,\n 655:     union_bboxes: list, frame_bboxes: list,\n 656: ) -> dict | None:\n 657:     \"\"\"Build one frame-tool pair, dock it onto the output, and record frame on input_grid.\n 658: \n 659:     Returns tool info dict for later undocking, or None on failure.\n 660:     \"\"\"\n 661:     frame_color = colors[3 * i]\n 662:     plug_color = colors[3 * i + 1]\n 663:     handle_color = colors[3 * i + 2]\n 664: \n 665:     result = _build_left_pair(\n 666:         bg=bg, frame_color=frame_color, plug_color=plug_color,\n 667:         handle_color=handle_color, fw=spec[\"fw\"], top_h=spec[\"top_h\"],\n 668:         bot_h=spec[\"bot_h\"], notch_n=spec[\"notch_n\"],\n 669:         handle_area=spec[\"handle_area\"],\n 670:     )\n 671:     if result is None:\n 672:         return None\n 673:     frame_left, tool_left = result\n 674: \n 675:     # Combine frame + tool into a single docked scene\n 676:     scene_left = np.where(tool_left != bg, tool_left, frame_left)\n 677: \n 678:     frame_scene = _orient_left_to_side(frame_left, side)\n 679:     tool = _orient_left_to_side(tool_left, side)\n 680:     scene = _orient_left_to_side(scene_left, side)\n 681:     ph, pw = scene.shape\n 682:     fr0, fc0, fr1, fc1 = _bbox(frame_scene != bg)\n 683: \n 684:     origin = None\n 685:     for r0, c0 in _candidate_origins(side, ph, pw, H, W):\n 686:         union_bbox = (r0, c0, r0 + ph - 1, c0 + pw - 1)\n 687:         frame_bbox = (r0 + fr0, c0 + fc0, r0 + fr1, c0 + fc1)\n 688:         if side in (\"left\", \"right\") and (frame_bbox[0] == 0 or frame_bbox[2] == H - 1):\n 689:             continue\n 690:         if side in (\"top\", \"bottom\") and (frame_bbox[1] == 0 or frame_bbox[3] == W - 1):\n 691:             continue\n 692:         if any(_bbox_gap(union_bbox, prev) <= UNION_BBOX_GAP_MIN - 1 for prev in union_bboxes):\n 693:             continue\n 694:         if any(_bbox_gap(frame_bbox, prev) <= FRAME_BBOX_GAP_MIN - 1 for prev in frame_bboxes):\n 695:             continue\n 696:         if np.any((output[r0:r0 + ph, c0:c0 + pw] != bg) & (scene != bg)):\n 697:             continue\n 698:         origin = (r0, c0)\n 699:         break\n 700:     if origin is None:\n 701:         return None\n 702: \n 703:     r0, c0 = origin\n 704:     paste(output, scene, r0, c0, transparent=bg)\n 705:     paste(input_grid, frame_scene, r0, c0, transparent=bg)\n 706: \n 707:     union_bboxes.append((r0, c0, r0 + ph - 1, c0 + pw - 1))\n 708:     frame_bboxes.append((r0 + fr0, c0 + fc0, r0 + fr1, c0 + fc1))\n 709:     return {\n 710:         \"tool\": tool, \"plug_color\": plug_color, \"handle_color\": handle_color,\n 711:         \"plug_area\": spec[\"plug_area\"], \"handle_area\": spec[\"handle_area\"],\n 712:     }\n 713: \n 714: \n 715: def _undock_tool(info: dict, bg: int, input_grid: np.ndarray,\n 716:                  placement_canvas: np.ndarray) -> bool:\n 717:     \"\"\"Pick a random D4 variant of the tool and place it at a free location on the grid.\n 718: \n 719:     Returns True on success, False if no placement found.\n 720:     \"\"\"\n 721:     for patch, is_flip in _variant_choices(info[\"tool\"]):\n 722:         if is_flip and info[\"plug_area\"] != info[\"handle_area\"]:\n 723:             patch = _swap_colors(patch, info[\"plug_color\"], info[\"handle_color\"])\n 724:         try:\n 725:             r0, c0 = random_free_location(\n 726:                 placement_canvas, patch, transparent=bg,\n 727:                 border=TOOL_BORDER, padding=TOOL_PADDING,\n 728:                 padding_connectivity=TOOL_PADDING_CONN,\n 729:             )\n 730:         except ValueError:\n 731:             continue\n 732:         paste(input_grid, patch, r0, c0, transparent=bg)\n 733:         paste(placement_canvas, patch, r0, c0, transparent=bg)\n 734:         return True\n 735:     return False\n 736: \n 737: \n 738: def _gen_attempt() -> np.ndarray | None:\n 739:     \"\"\"Single attempt to generate a valid input grid.\"\"\"\n 740:     H = random.randint(*GRID_H_RANGE)\n 741:     W = random.randint(*GRID_W_RANGE)\n 742:     bg = random.choice(list(range(10)))\n 743:     num_pairs = random.choice(NUM_PAIRS_CHOICES)\n 744: \n 745:     pair_specs = _pick_pair_specs(num_pairs)\n 746:     if len(pair_specs) != num_pairs:\n 747:         return None\n 748: \n 749:     colors = [c for c in range(1, 10) if c != bg]\n 750:     random.shuffle(colors)\n 751:     need = 1 + (3 * num_pairs)\n 752:     if len(colors) < need:\n 753:         return None\n 754: \n 755:     sides = random.sample([\"left\", \"right\", \"top\", \"bottom\"], k=num_pairs)\n 756:     output = np.full((H, W), bg, dtype=int)\n 757:     input_grid = np.full((H, W), bg, dtype=int)\n 758:     union_bboxes: list[tuple[int, int, int, int]] = []\n 759:     frame_bboxes: list[tuple[int, int, int, int]] = []\n 760:     placed_tools: list[dict] = []\n 761: \n 762:     for i, spec in enumerate(pair_specs):\n 763:         info = _place_docked_pair(\n 764:             i, spec, colors, sides[i], bg, H, W,\n 765:             output, input_grid, union_bboxes, frame_bboxes,\n 766:         )\n 767:         if info is None:\n 768:             return None\n 769:         placed_tools.append(info)\n 770: \n 771:     placement_canvas = output.copy()\n 772:     for info in placed_tools:\n 773:         if not _undock_tool(info, bg, input_grid, placement_canvas):\n 774:             return None\n 775: \n 776:     if np.array_equal(main(input_grid), output):\n 777:         return input_grid\n 778:     return None\n 779: \n 780: \n 781: def generate_input() -> np.ndarray:\n 782:     for _ in range(GEN_ATTEMPT_RETRIES):\n 783:         grid = _gen_attempt()\n 784:         if grid is not None:\n 785:             return grid\n 786:     raise RuntimeError(\"failed to generate valid input after %d attempts\" % GEN_ATTEMPT_RETRIES)\nEND_FILE\nFILE: /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\n   7: def main(grid: np.ndarray) -> np.ndarray:\n   8:     \"\"\"\n   9:     Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n  10: \n  11:     Input structure:\n  12:     - bg = most common color.\n  13:     - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n  14:     - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n  15: \n  16:     Rule:\n  17:     - Match each sprite to the border anchor sharing its marker color.\n  18:     - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n  19:     - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n  20: \n  21:     Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n  22:     \"\"\"\n  23:     g = np.array(grid, dtype=int)\n  24:     H, W = g.shape\n  25:     bg = int(get_bg(g))\n  26: \n  27:     def is_border(r: int, c: int) -> bool:\n  28:         return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n  29: \n  30:     # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n  31:     anchors_by_color: dict[int, tuple[int, int]] = {}\n  32:     for r in range(H):\n  33:         for c in range(W):\n  34:             if not is_border(r, c):\n  35:                 continue\n  36:             v = int(g[r, c])\n  37:             if v == int(bg):\n  38:                 continue\n  39:             ok = True\n  40:             for rr, cc in neighbors4(int(r), int(c)):\n  41:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n  42:                     ok = False\n  43:                     break\n  44:             if ok and v not in anchors_by_color:\n  45:                 anchors_by_color[int(v)] = (int(r), int(c))\n  46: \n  47:     assert not (not anchors_by_color)\n  48: \n  49:     anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n  50: \n  51:     # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n  52:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n  53: \n  54:     def component_marker_color(coords: np.ndarray) -> int | None:\n  55:         # For multi-color sprites, the marker color is the least frequent color inside the component.\n  56:         vals = [int(g[int(r), int(c)]) for r, c in coords]\n  57:         cnt = Counter(vals)\n  58:         if len(cnt) <= 1:\n  59:             return None\n  60:         return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n  61: \n  62:     def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n  63:         # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n  64:         pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n  65:         if not pts:\n  66:             return None\n  67:         if len(pts) == 1:\n  68:             return pts[0]\n  69:         S = {(int(r), int(c)) for r, c in coords}\n  70:         for r, c in pts:\n  71:             for rr, cc in neighbors4(int(r), int(c)):\n  72:                 if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n  73:                     return (int(r), int(c))\n  74:         return pts[0]\n  75: \n  76:     moves: list[tuple[np.ndarray, int, int]] = []\n  77: \n  78:     for comp in comps:\n  79:         coords = comp[\"coords\"]\n  80:         if coords.size == 0:\n  81:             continue\n  82: \n  83:         # --- STEP 3) Decide marker color for this component. ---\n  84:         marker_col = component_marker_color(coords)\n  85:         if marker_col is None:\n  86:             # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n  87:             if int(coords.shape[0]) != 1:\n  88:                 continue\n  89:             r, c = map(int, coords[0])\n  90:             v = int(g[r, c])\n  91:             if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n  92:                 continue\n  93:             marker_col = int(v)\n  94: \n  95:         if int(marker_col) not in anchors_by_color:\n  96:             continue\n  97: \n  98:         mp = marker_pixel(coords, int(marker_col))\n  99:         if mp is None:\n 100:             continue\n 101: \n 102:         ar, ac = anchors_by_color[int(marker_col)]\n 103: \n 104:         # --- STEP 4) Compute translation (dr,dc). ---\n 105:         on_top_bottom = int(ar) in (0, int(H - 1))\n 106:         on_left_right = int(ac) in (0, int(W - 1))\n 107:         horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n 108: \n 109:         dr = 0\n 110:         dc = 0\n 111:         if horizontal:\n 112:             dc = int(ac - mp[1])\n 113:         else:\n 114:             dr = int(ar - mp[0])\n 115: \n 116:         moves.append((coords, int(dr), int(dc)))\n 117: \n 118:     out = g.copy()\n 119: \n 120:     # --- STEP 5) Apply all moves. ---\n 121:     # Clear moved components first (prevents collisions with their original locations).\n 122:     for coords, _dr, _dc in moves:\n 123:         out[coords[:, 0], coords[:, 1]] = int(bg)\n 124: \n 125:     # Paste moved components:\n 126:     # - clip out-of-bounds pixels\n 127:     # - do not overwrite existing non-bg pixels\n 128:     for coords, dr, dc in moves:\n 129:         for r, c in coords:\n 130:             rr = int(r) + int(dr)\n 131:             cc = int(c) + int(dc)\n 132:             if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n 133:                 out[rr, cc] = int(g[int(r), int(c)])\n 134: \n 135:     return out\n 136: \n 137: # --------------- generator (o5x) ---------------\n 138: \n 139: # CFG: palette and canvas bounds.\n 140: _COLORS = tuple(range(10))\n 141: _BG_COLOR_RANGE = (1, 8)\n 142: _GRID_HEIGHT_RANGE = (10, 22)\n 143: _GRID_WIDTH_RANGE = (8, 22)\n 144: \n 145: # CFG: placement isolation and anchor location.\n 146: _NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n 147: _INNER_BORDER_GAP = 1\n 148: _ANCHOR_EDGE_MARGIN = 2\n 149: _ISOLATION_RADIUS = 1\n 150: \n 151: # CFG: anchor, sprite, and retry counts.\n 152: _ANCHOR_COUNT_RANGE = (1, 3)\n 153: _SPRITE_COUNT_RANGE = (3, 5)\n 154: _BODY_AREA_RANGE = (4, 13)\n 155: _GEN_RETRY_LIMIT = 300\n 156: \n 157: # CFG: body geometry and shape mix.\n 158: _BODY_HEIGHT_RANGE = (2, 5)\n 159: _BODY_WIDTH_RANGE = (3, 7)\n 160: _FRAME_HEIGHT_RANGE = (3, 5)\n 161: _FRAME_WIDTH_RANGE = (3, 7)\n 162: _FRAME_MIN_AREA = 8\n 163: _FRAME_MAX_GAP = 3\n 164: _FRAME_BODY_THRESHOLD = 0.28\n 165: _WIDE_BODY_THRESHOLD = 0.55\n 166: _SYMMETRIC_BODY_THRESHOLD = 0.82\n 167: _SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n 168: _SYMMETRIC_TRANSPOSE_PROB = 0.45\n 169: _MARKER_INTERIOR_PROB = 0.65\n 170: _FLIP_PROB = 0.5\n 171: \n 172: # CFG: optional singleton distractors.\n 173: _DISTRACTOR_PROB = 0.15\n 174: _DISTRACTOR_COUNT_RANGE = (1, 4)\n 175: \n 176: _GROW_BODY_SEEDS = [\n 177:     {(0, 0), (0, 1), (0, 2), (1, 0)},\n 178:     {(0, 0), (0, 1), (0, 2), (1, 2)},\n 179:     {(0, 0), (1, 0), (1, 1), (1, 2)},\n 180:     {(0, 2), (1, 0), (1, 1), (1, 2)},\n 181:     {(0, 1), (1, 0), (1, 1), (1, 2)},\n 182: ]\n 183: \n 184: \n 185: def _norm(cells):\n 186:     r0 = min(r for r, _c in cells)\n 187:     c0 = min(c for _r, c in cells)\n 188:     return {(r - r0, c - c0) for r, c in cells}\n 189: \n 190: \n 191: def _bbox(cells):\n 192:     return (\n 193:         min(r for r, _c in cells),\n 194:         min(c for _r, c in cells),\n 195:         max(r for r, _c in cells),\n 196:         max(c for _r, c in cells),\n 197:     )\n 198: \n 199: \n 200: def _flip(cells):\n 201:     cells = set(cells)\n 202:     if random.random() < _FLIP_PROB:\n 203:         mc = max(c for _r, c in cells)\n 204:         cells = {(r, mc - c) for r, c in cells}\n 205:     if random.random() < _FLIP_PROB:\n 206:         mr = max(r for r, _c in cells)\n 207:         cells = {(mr - r, c) for r, c in cells}\n 208:     return _norm(cells)\n 209: \n 210: \n 211: def _inclusive_range(bounds):\n 212:     return range(int(bounds[0]), int(bounds[1]) + 1)\n 213: \n 214: \n 215: def _frontier_cells(cells, height, width):\n 216:     \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n 217:     frontier = []\n 218:     for r, c in cells:\n 219:         for dr, dc in _NEIGHBORS4:\n 220:             rr, cc = r + dr, c + dc\n 221:             if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n 222:                 frontier.append((rr, cc))\n 223:     return frontier\n 224: \n 225: \n 226: def _grow_body(area):\n 227:     choices = [\n 228:         (h, w)\n 229:         for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n 230:         for w in _inclusive_range(_BODY_WIDTH_RANGE)\n 231:         if h * w >= area\n 232:     ]\n 233:     h, w = random.choice(choices)\n 234:     cells = set(random.choice(_GROW_BODY_SEEDS))\n 235:     while len(cells) < area:\n 236:         frontier = _frontier_cells(cells, h, w)\n 237:         if not frontier:\n 238:             return _grow_body(area)\n 239:         cells.add(random.choice(frontier))\n 240:     return _flip(cells)\n 241: \n 242: \n 243: def _symmetric_body(area):\n 244:     choices = []\n 245:     for height in _inclusive_range(_BODY_HEIGHT_RANGE):\n 246:         extra = area - height\n 247:         if extra >= 2 and extra % 2 == 0 and extra // 2 <= height:\n 248:             choices.append((height, extra // 2))\n 249:     if not choices:\n 250:         return _grow_body(area)\n 251: \n 252:     height, pair_count = random.choice(choices)\n 253:     cells = {(r, 1) for r in range(height)}\n 254:     rows = list(range(height))\n 255:     random.shuffle(rows)\n 256:     for r in rows[:pair_count]:\n 257:         cells.add((r, 0))\n 258:         cells.add((r, 2))\n 259: \n 260:     if height >= _SYMMETRIC_TRANSPOSE_MIN_HEIGHT and random.random() < _SYMMETRIC_TRANSPOSE_PROB:\n 261:         cells = {(c, r) for r, c in cells}\n 262:     return _flip(cells)\n 263: \n 264: \n 265: def _wide_body(area):\n 266:     width = random.randint(_BODY_WIDTH_RANGE[0], min(_BODY_WIDTH_RANGE[1], area - 1))\n 267:     height = random.choice([h for h in _inclusive_range(_BODY_HEIGHT_RANGE) if h * width >= area])\n 268:     cells = {(0, c) for c in range(width)}\n 269:     cells.add((1, random.randrange(width)))\n 270:     while len(cells) < area:\n 271:         frontier = _frontier_cells(cells, height, width)\n 272:         cells.add(random.choice(frontier))\n 273:     return _flip(cells)\n 274: \n 275: \n 276: def _frame_body(area):\n 277:     choices = []\n 278:     for h in _inclusive_range(_FRAME_HEIGHT_RANGE):\n 279:         for w in _inclusive_range(_FRAME_WIDTH_RANGE):\n 280:             perim = 2 * h + 2 * w - 4\n 281:             removable = 2 * max(0, h - 2) + 2 * max(0, w - 2)\n 282:             if perim >= area and perim - area <= min(_FRAME_MAX_GAP, removable):\n 283:                 choices.append((h, w))\n 284:     if not choices:\n 285:         return _grow_body(area)\n 286: \n 287:     h, w = random.choice(choices)\n 288:     cells = {\n 289:         (r, c)\n 290:         for r in range(h)\n 291:         for c in range(w)\n 292:         if r in (0, h - 1) or c in (0, w - 1)\n 293:     }\n 294:     gap = len(cells) - area\n 295:     if gap:\n 296:         removable = [\n 297:             (r, c)\n 298:             for r, c in cells\n 299:             if not (r in (0, h - 1) and c in (0, w - 1))\n 300:         ]\n 301:         for cell in random.sample(removable, gap):\n 302:             cells.remove(cell)\n 303:     return _flip(cells)\n 304: \n 305: \n 306: def _make_body(area):\n 307:     x = random.random()\n 308:     if area >= _FRAME_MIN_AREA and x < _FRAME_BODY_THRESHOLD:\n 309:         return _frame_body(area)\n 310:     if x < _WIDE_BODY_THRESHOLD:\n 311:         return _wide_body(area)\n 312:     if x < _SYMMETRIC_BODY_THRESHOLD:\n 313:         return _symmetric_body(area)\n 314:     return _grow_body(area)\n 315: \n 316: \n 317: def _marker_cell(body):\n 318:     r0, c0, r1, c1 = _bbox(body)\n 319:     interior, exterior = set(), set()\n 320:     for r, c in body:\n 321:         for dr, dc in _NEIGHBORS4:\n 322:             p = (r + dr, c + dc)\n 323:             if p in body:\n 324:                 continue\n 325:             if r0 <= p[0] <= r1 and c0 <= p[1] <= c1:\n 326:                 interior.add(p)\n 327:             else:\n 328:                 exterior.add(p)\n 329:     pool = list(interior if interior and random.random() < _MARKER_INTERIOR_PROB else (exterior | interior))\n 330:     return random.choice(pool)\n 331: \n 332: \n 333: def _make_sprite(area, body_color, marker_color, bg):\n 334:     body = _make_body(area)\n 335:     marker = _marker_cell(body)\n 336:     all_cells = set(body) | {marker}\n 337:     r0, c0, r1, c1 = _bbox(all_cells)\n 338:     patch = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)\n 339:     for r, c in body:\n 340:         patch[r - r0, c - c0] = int(body_color)\n 341:     patch[marker[0] - r0, marker[1] - c0] = int(marker_color)\n 342:     return {\"patch\": patch, \"offset\": (marker[0] - r0, marker[1] - c0)}\n 343: \n 344: \n 345: def _top_left(sprite, marker_r, marker_c):\n 346:     off_r, off_c = sprite[\"offset\"]\n 347:     return int(marker_r) - int(off_r), int(marker_c) - int(off_c)\n 348: \n 349: \n 350: def _can_place(canvas, sprite, marker_r, marker_c, bg):\n 351:     patch = sprite[\"patch\"]\n 352:     top, left = _top_left(sprite, marker_r, marker_c)\n 353:     h, w = patch.shape\n 354:     H, W = canvas.shape\n 355:     if top < _INNER_BORDER_GAP or left < _INNER_BORDER_GAP:\n 356:         return False\n 357:     if top + h > H - _INNER_BORDER_GAP or left + w > W - _INNER_BORDER_GAP:\n 358:         return False\n 359:     mask = patch != int(bg)\n 360:     view = canvas[top : top + h, left : left + w]\n 361:     if bool((view[mask] != int(bg)).any()):\n 362:         return False\n 363:     return not _touches_foreground(canvas, mask, top, left, bg)\n 364: \n 365: \n 366: def _touches_foreground(canvas, mask, top, left, bg):\n 367:     \"\"\"Return True if any patch cell has a non-bg 8-neighbor on canvas.\"\"\"\n 368:     h, w = mask.shape\n 369:     radius = _ISOLATION_RADIUS\n 370:     occupied = canvas[top - radius : top + h + radius, left - radius : left + w + radius] != int(bg)\n 371:     touch_zone = np.zeros((h + 2 * radius, w + 2 * radius), dtype=bool)\n 372:     span = 2 * radius + 1\n 373:     for dr in range(span):\n 374:         for dc in range(span):\n 375:             touch_zone[dr : dr + h, dc : dc + w] |= mask\n 376:     return bool((occupied & touch_zone).any())\n 377: \n 378: \n 379: def _place(canvas, sprite, marker_r, marker_c, bg):\n 380:     top, left = _top_left(sprite, marker_r, marker_c)\n 381:     paste(canvas, sprite[\"patch\"], top, left, transparent=int(bg))\n 382: \n 383: \n 384: def _anchor_ok(canvas, r, c, bg):\n 385:     H, W = canvas.shape\n 386:     if not (r in (0, H - 1) or c in (0, W - 1)):\n 387:         return False\n 388:     if r in (0, H - 1) and c in (0, W - 1):\n 389:         return False\n 390:     return _isolated_bg_cell(canvas, r, c, bg)\n 391: \n 392: \n 393: def _isolated_bg_cell(canvas, r, c, bg):\n 394:     \"\"\"Return True when a cell and its in-bounds 8-neighborhood are bg.\"\"\"\n 395:     H, W = canvas.shape\n 396:     radius = _ISOLATION_RADIUS\n 397:     r0, r1 = max(0, r - radius), min(H, r + radius + 1)\n 398:     c0, c1 = max(0, c - radius), min(W, c + radius + 1)\n 399:     return not bool((canvas[r0:r1, c0:c1] != int(bg)).any())\n 400: \n 401: \n 402: def _anchor_candidates(canvas, bg):\n 403:     H, W = canvas.shape\n 404:     rows = list(range(_ANCHOR_EDGE_MARGIN, H - _ANCHOR_EDGE_MARGIN))\n 405:     rows = rows or list(range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP))\n 406:     cols = list(range(_ANCHOR_EDGE_MARGIN, W - _ANCHOR_EDGE_MARGIN))\n 407:     cols = cols or list(range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP))\n 408:     out = []\n 409:     for c in cols:\n 410:         out.append((\"h\", 0, c))\n 411:         out.append((\"h\", H - 1, c))\n 412:     for r in rows:\n 413:         out.append((\"v\", r, 0))\n 414:         out.append((\"v\", r, W - 1))\n 415:     random.shuffle(out)\n 416:     return [(axis, r, c) for axis, r, c in out if _anchor_ok(canvas, r, c, bg)]\n 417: \n 418: \n 419: def _put_anchor(canvas, r, c, color):\n 420:     paste(canvas, np.array([[int(color)]], dtype=int), int(r), int(c))\n 421: \n 422: \n 423: def _aligned_positions(canvas, sprite, anchor, bg):\n 424:     H, W = canvas.shape\n 425:     if anchor[\"axis\"] == \"h\":\n 426:         return [\n 427:             (r, anchor[\"c\"])\n 428:             for r in range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP)\n 429:             if _can_place(canvas, sprite, r, anchor[\"c\"], bg)\n 430:         ]\n 431:     return [\n 432:         (anchor[\"r\"], c)\n 433:         for c in range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP)\n 434:         if _can_place(canvas, sprite, anchor[\"r\"], c, bg)\n 435:     ]\n 436: \n 437: \n 438: def _scatter_positions(canvas, sprite, anchor, marker, bg):\n 439:     H, W = canvas.shape\n 440:     mr, mc = marker\n 441:     if anchor[\"axis\"] == \"h\":\n 442:         return [\n 443:             (mr, c)\n 444:             for c in range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP)\n 445:             if c != mc and _can_place(canvas, sprite, mr, c, bg)\n 446:         ]\n 447:     return [\n 448:         (r, mc)\n 449:         for r in range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP)\n 450:         if r != mr and _can_place(canvas, sprite, r, mc, bg)\n 451:     ]\n 452: \n 453: \n 454: def _body_color(bg, marker, used):\n 455:     pool = [c for c in _COLORS if c not in {int(bg), int(marker)} and c not in used]\n 456:     if not pool:\n 457:         pool = [c for c in _COLORS if c not in {int(bg), int(marker)}]\n 458:     return random.choice(pool)\n 459: \n 460: \n 461: def _bg_is_mode(grid, bg):\n 462:     counts = Counter(map(int, grid.ravel()))\n 463:     return counts[int(bg)] > max((n for c, n in counts.items() if c != int(bg)), default=0)\n 464: \n 465: \n 466: def _add_distractors(out, inp, anchors, bg):\n 467:     vertical = [a for a in anchors if a[\"axis\"] == \"v\"]\n 468:     if not vertical or random.random() >= _DISTRACTOR_PROB:\n 469:         return\n 470:     anchor = random.choice(vertical)\n 471:     sprite = {\"patch\": np.array([[anchor[\"color\"]]], dtype=int), \"offset\": (0, 0)}\n 472:     for _ in range(random.randint(*_DISTRACTOR_COUNT_RANGE)):\n 473:         pairs = []\n 474:         for c in range(_INNER_BORDER_GAP, out.shape[1] - _INNER_BORDER_GAP):\n 475:             if not _can_place(out, sprite, anchor[\"r\"], c, bg):\n 476:                 continue\n 477:             for r in range(_INNER_BORDER_GAP, out.shape[0] - _INNER_BORDER_GAP):\n 478:                 if r != anchor[\"r\"] and _can_place(inp, sprite, r, c, bg):\n 479:                     pairs.append((r, c))\n 480:         if not pairs:\n 481:             return\n 482:         in_r, col = random.choice(pairs)\n 483:         _place(out, sprite, anchor[\"r\"], col, bg)\n 484:         _place(inp, sprite, in_r, col, bg)\n 485: \n 486: \n 487: def _gen_attempt():\n 488:     bg, out, inp = _new_canvas_pair()\n 489:     placed = _place_anchors(out, inp, bg)\n 490:     if placed is None:\n 491:         return None\n 492:     anchor_colors, anchors = placed\n 493: \n 494:     marker_colors = _marker_color_sequence(anchor_colors)\n 495:     sprites = _place_aligned_sprites(out, anchors, marker_colors, bg)\n 496:     if sprites is None:\n 497:         return None\n 498: \n 499:     if not _scatter_sprites(inp, sprites, bg):\n 500:         return None\n 501: \n 502:     _add_distractors(out, inp, anchors, bg)\n 503:     if not _generated_grid_is_valid(inp, out, bg):\n 504:         return None\n 505:     return inp\n 506: \n 507: \n 508: def _new_canvas_pair():\n 509:     \"\"\"Choose grid size/background and return matching output/input canvases.\"\"\"\n 510:     H = random.randint(*_GRID_HEIGHT_RANGE)\n 511:     W = random.randint(*_GRID_WIDTH_RANGE)\n 512:     bg = random.randint(*_BG_COLOR_RANGE)\n 513:     out = np.full((H, W), int(bg), dtype=int)\n 514:     inp = np.full((H, W), int(bg), dtype=int)\n 515:     return bg, out, inp\n 516: \n 517: \n 518: def _place_anchors(out, inp, bg):\n 519:     \"\"\"Place distinct isolated border anchors into both canvases.\"\"\"\n 520:     anchor_colors = random.sample([c for c in _COLORS if c != bg], random.randint(*_ANCHOR_COUNT_RANGE))\n 521:     anchors = []\n 522:     for color in anchor_colors:\n 523:         candidates = _anchor_candidates(out, bg)\n 524:         if not candidates:\n 525:             return None\n 526:         axis, r, c = random.choice(candidates)\n 527:         anchor = {\"color\": int(color), \"r\": int(r), \"c\": int(c), \"axis\": axis}\n 528:         anchors.append(anchor)\n 529:         _put_anchor(out, r, c, color)\n 530:         _put_anchor(inp, r, c, color)\n 531:     return anchor_colors, anchors\n 532: \n 533: \n 534: def _marker_color_sequence(anchor_colors):\n 535:     \"\"\"Expand anchor colors to the sprite count, allowing repeated markers.\"\"\"\n 536:     n_sprites = random.randint(*_SPRITE_COUNT_RANGE)\n 537:     marker_colors = anchor_colors[:]\n 538:     while len(marker_colors) < n_sprites:\n 539:         marker_colors.append(random.choice(anchor_colors))\n 540:     random.shuffle(marker_colors)\n 541:     return marker_colors\n 542: \n 543: \n 544: def _place_aligned_sprites(out, anchors, marker_colors, bg):\n 545:     \"\"\"Build sprites in their solved locations and return their align metadata.\"\"\"\n 546:     by_color = {a[\"color\"]: a for a in anchors}\n 547:     used_body = set()\n 548:     sprites = []\n 549:     for marker in marker_colors:\n 550:         anchor = by_color[int(marker)]\n 551:         body = _body_color(bg, marker, used_body)\n 552:         used_body.add(body)\n 553:         sprite = _make_sprite(random.randint(*_BODY_AREA_RANGE), body, marker, bg)\n 554:         positions = _aligned_positions(out, sprite, anchor, bg)\n 555:         if not positions:\n 556:             return None\n 557:         marker_pos = random.choice(positions)\n 558:         _place(out, sprite, marker_pos[0], marker_pos[1], bg)\n 559:         sprites.append((