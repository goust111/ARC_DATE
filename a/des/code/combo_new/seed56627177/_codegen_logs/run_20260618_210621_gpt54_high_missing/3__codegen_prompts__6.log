{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/9b5080bb.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _touches_boundary(coords: np.ndarray, shape: tuple[int, int]) -> bool:\n    h, w = shape\n    return bool(\n        (coords[:, 0] == 0).any()\n        or (coords[:, 0] == h - 1).any()\n        or (coords[:, 1] == 0).any()\n        or (coords[:, 1] == w - 1).any()\n    )\n\n\ndef _neighbor_colors(g: np.ndarray, coords: np.ndarray, color: int) -> set[int]:\n    coord_set = {tuple(map(int, p)) for p in coords}\n    colors = set()\n    for r, c in coord_set:\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and (nr, nc) not in coord_set:\n                if int(g[nr, nc]) != color:\n                    colors.add(int(g[nr, nc]))\n    return colors\n\n\ndef _object_components(g: np.ndarray) -> tuple[int, list[np.ndarray], set[int]]:\n    candidates = []\n    for color in set(map(int, g.ravel())):\n        inner_components = [\n            coords\n            for coords in components_mask(g == color, connectivity=4)\n            if len(coords) >= 5 and not _touches_boundary(coords, g.shape)\n        ]\n        if len(inner_components) < 2:\n            continue\n\n        panel_colors = set()\n        for coords in inner_components:\n            neighbors = _neighbor_colors(g, coords, color)\n            if len(neighbors) != 1:\n                break\n            panel_colors.update(neighbors)\n        else:\n            if len(panel_colors) == 2:\n                candidates.append((color, inner_components, panel_colors))\n\n    assert len(candidates) == 1\n    return candidates[0]\n\n\ndef _valid_core_rect(\n    object_cells: set[tuple[int, int]],\n    missing: set[tuple[int, int]],\n    outside: set[tuple[int, int]],\n    rect: tuple[int, int, int, int],\n) -> bool:\n    r0, c0, r1, c1 = rect\n\n    for r, c in missing:\n        distances = [r - r0, r1 - r, c - c0, c1 - c]\n        if distances.count(min(distances)) != 1:\n            return False\n\n    for r, c in outside:\n        side_count = int(r < r0) + int(r > r1) + int(c < c0) + int(c > c1)\n        if side_count != 1:\n            return False\n        if r < r0:\n            inner = (r + 1, c)\n        elif r > r1:\n            inner = (r - 1, c)\n        elif c < c0:\n            inner = (r, c + 1)\n        else:\n            inner = (r, c - 1)\n        if inner not in object_cells:\n            return False\n\n    return True\n\n\ndef _core_rect(coords: np.ndarray) -> tuple[int, int, int, int]:\n    object_cells = {tuple(map(int, p)) for p in coords}\n    r0, c0 = map(int, coords.min(axis=0))\n    r1, c1 = map(int, coords.max(axis=0))\n\n    candidates = []\n    for rr0 in (r0, r0 + 1):\n        for rr1 in (r1, r1 - 1):\n            for cc0 in (c0, c0 + 1):\n                for cc1 in (c1, c1 - 1):\n                    if rr0 > rr1 or cc0 > cc1:\n                        continue\n                    rect_cells = {\n                        (r, c)\n                        for r in range(rr0, rr1 + 1)\n                        for c in range(cc0, cc1 + 1)\n                    }\n                    missing = rect_cells - object_cells\n                    outside = object_cells - rect_cells\n                    rect = (rr0, cc0, rr1, cc1)\n                    if not _valid_core_rect(object_cells, missing, outside, rect):\n                        continue\n                    score = (len(missing) + len(outside), -len(rect_cells))\n                    candidates.append((score, rect))\n\n    assert candidates\n    best_score = min(score for score, _ in candidates)\n    best_rects = [rect for score, rect in candidates if score == best_score]\n    assert len(best_rects) == 1\n    return best_rects[0]\n\n\ndef _nearest_rect_side(r: int, c: int, rect: tuple[int, int, int, int]) -> str:\n    r0, c0, r1, c1 = rect\n    distances = {\n        \"top\": r - r0,\n        \"bottom\": r1 - r,\n        \"left\": c - c0,\n        \"right\": c1 - c,\n    }\n    nearest = [side for side, dist in distances.items() if dist == min(distances.values())]\n    assert len(nearest) == 1\n    return nearest[0]\n\n\ndef _defect_bar_cells(coords: np.ndarray, rect: tuple[int, int, int, int]) -> set[tuple[int, int]]:\n    object_cells = {tuple(map(int, p)) for p in coords}\n    r0, c0, r1, c1 = rect\n    rect_cells = {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}\n    bars = set()\n\n    for r, c in rect_cells - object_cells:\n        side = _nearest_rect_side(r, c, rect)\n        if side == \"top\":\n            bars.update({(r - 1, c), (r, c)})\n        elif side == \"bottom\":\n            bars.update({(r, c), (r + 1, c)})\n        elif side == \"left\":\n            bars.update({(r, c - 1), (r, c)})\n        else:\n            bars.update({(r, c), (r, c + 1)})\n\n    for r, c in object_cells - rect_cells:\n        if r < r0:\n            bars.update({(r, c), (r + 1, c)})\n        elif r > r1:\n            bars.update({(r - 1, c), (r, c)})\n        elif c < c0:\n            bars.update({(r, c), (r, c + 1)})\n        else:\n            assert c > c1\n            bars.update({(r, c - 1), (r, c)})\n\n    return bars\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor the small defect bars on each shared-color object with the opposite panel color.\n\n    Input structure\n    - The grid contains two large panel colors and one shared object color.\n    - Each shared-color object is a mostly solid rectangle inside exactly one panel.\n    Rule\n    - Find the near-solid rectangular core of each object.\n    - Missing core pixels and one-cell protrusions define two-pixel bars perpendicular to the nearest core edge.\n    - Recolor those bars with the other panel color; leave all other pixels unchanged.\n    Key insight\n    - The colors to add are not tied to numeric ids: each object's surrounding panel identifies the opposite panel color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = g.copy()\n\n    object_color, components, panel_colors = _object_components(g)\n    for coords in components:\n        neighbors = _neighbor_colors(g, coords, object_color)\n        assert len(neighbors) == 1\n        panel_color = next(iter(neighbors))\n        target_colors = panel_colors - {panel_color}\n        assert len(target_colors) == 1\n        target_color = next(iter(target_colors))\n\n        rect = _core_rect(coords)\n        for r, c in _defect_bar_cells(coords, rect):\n            assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1]\n            assert int(g[r, c]) in {object_color, panel_color}\n            out[r, c] = target_color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Palette and canvas bounds.\nCOLOR_IDS = list(range(10))\nGRID_SIZE_MIN = 20\nGRID_SIZE_MAX = 27\n\n# Panel layout bounds and options.\nMIN_PANEL_DIM = 9\nMIN_VISIBLE_BORDERS = 2\nBORDER_CHOICES = (0, 1)\nOFFSET_MIN = 2\nOFFSET_MAX = 6\nHORIZONTAL_LAYOUT = 0\nVERTICAL_LAYOUT = 1\nHORIZONTAL_OFFSETS = (\"left\", \"right\", \"none\")\nVERTICAL_OFFSETS = (\"top\", \"bottom\", \"none\")\n\n# Object geometry and placement constraints.\nOBJECTS_PER_PANEL = (1, 2)\nCORE_H_MIN = 3\nCORE_H_MAX = 7\nCORE_W_MIN = 3\nCORE_W_MAX = 9\nDEFECT_COUNT_MIN = 1\nDEFECT_COUNT_MAX = 3\nDEFECT_SIDES = (\"top\", \"bottom\", \"left\", \"right\")\nDEFECT_TYPES = (\"missing\", \"protrusion\")\nPANEL_MARGIN = 1\nOBJECT_GAP = 2\nMAX_PLACE_TRIES = 30\n\n# Generation retry budget.\nMAX_GENERATE_ATTEMPTS = 300\n\n\ndef _choose_palette() -> tuple[int, int, int, int]:\n    colors = COLOR_IDS[:]\n    random.shuffle(colors)\n    return tuple(colors[:4])\n\n\ndef _choose_borders() -> tuple[int, int, int, int]:\n    borders = [random.choice(BORDER_CHOICES) for _ in range(4)]\n    while sum(borders) < MIN_VISIBLE_BORDERS:\n        borders[random.randint(0, 3)] = 1\n    return tuple(borders)\n\n\ndef _build_horizontal_panels(\n    grid: np.ndarray,\n    panel_a_color: int,\n    panel_b_color: int,\n) -> list[tuple[int, int, int, int, int]] | None:\n    \"\"\"Create two panels sharing a horizontal border; returns panel records.\"\"\"\n    H, W = grid.shape\n    split_r = random.randint(MIN_PANEL_DIM, H - MIN_PANEL_DIM - 1)\n    border_top, border_bot, border_left, border_right = _choose_borders()\n\n    pa_height = split_r - border_top\n    pb_height = H - border_bot - split_r\n    if pa_height < MIN_PANEL_DIM or pb_height < MIN_PANEL_DIM:\n        return None\n\n    offset_side = random.choice(HORIZONTAL_OFFSETS)\n    if offset_side == \"none\":\n        pa_c0, pa_c1 = border_left, W - 1 - border_right\n        pb_c0, pb_c1 = border_left, W - 1 - border_right\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):\n        b = int(b)\n        f = int(f)\n        if b == bg:\n            continue\n        mapping[b] = f\n\n    return mapping, pal_mask\n\n\ndef _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:\n    \"\"\"\n    Find background regions (excluding the palette area) that do NOT touch the grid boundary,\n    and fill each region based on the most common adjacent border color (mapped via palette).\n    \"\"\"\n    h, w = out.shape\n    bg_mask = (out == bg) & (~pal_mask)\n    comps = components_mask(bg_mask, connectivity=4)\n    for pts in comps:\n        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n        if touches_boundary:\n            continue\n\n        adj_counts: dict[int, int] = {}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < h and 0 <= cc < w:\n                    if pal_mask[rr, cc]:\n                        continue\n                    v = int(out[rr, cc])\n                    if v == bg:\n                        continue\n                    adj_counts[v] = adj_counts.get(v, 0) + 1\n        if not adj_counts:\n            continue\n\n        # Prefer an adjacent color that exists in the mapping; pick the most frequent border.\n        border = None\n        best = -1\n        for col, cnt in adj_counts.items():\n","exit_code":0,"status":"completed"}}
