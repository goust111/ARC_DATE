A source run connecting the endpoint slots is stretched across the entire\n  33:       right active span.\n  34: \n  35:     Key insight:\n  36:     The left panel is a compressed legend for the right panel: endpoint markers\n  37:     stay two pixels wide, while connectors between endpoints expand to fill the\n  38:     distance between them.\n  39:     \"\"\"\n  40:     g = np.asarray(grid, dtype=int)\n  41:     assert g.ndim == 2, \"expected a 2D grid\"\n  42:     H, W = g.shape\n  43:     assert H >= 3 and W >= 7, \"grid too small for framed two-panel structure\"\n  44: \n  45:     frame = int(g[0, 0])\n  46:     assert np.all(g[0, :] == frame) and np.all(g[-1, :] == frame), \"bad horizontal frame\"\n  47:     assert np.all(g[:, 0] == frame) and np.all(g[:, -1] == frame), \"bad vertical frame\"\n  48: \n  49:     divider = _single_divider_column(g, frame)\n  50:     assert divider >= 5 and W - divider >= 6, \"panels must contain margins and active slots\"\n  51: \n  52:     left_panel = g[1 : H - 1, 1:divider]\n  53:     left_bg = get_bg(left_panel)\n  54:     assert np.all(left_panel[:, 0] == left_bg), \"left panel must have a left margin\"\n  55:     assert np.all(left_panel[:, -1] == left_bg), \"left panel must have a right margin\"\n  56: \n  57:     mini_start = 2\n  58:     mini_end = divider - 2\n  59:     assert mini_end - mini_start + 1 >= 4, \"left active region must contain two endpoint slots\"\n  60:     left_slot = (mini_start, mini_start + 1)\n  61:     right_slot = (mini_end - 1, mini_end)\n  62: \n  63:     target_start = divider + 2\n  64:     target_end = W - 3\n  65:     assert target_end - target_start + 1 >= 4, \"right active region must contain endpoint slots\"\n  66:     right_bg = int(g[1, divider + 1])\n  67:     right_panel = g[1 : H - 1, divider + 1 : W - 1]\n  68:     assert np.all(right_panel == right_bg), \"right panel must be blank before expansion\"\n  69: \n  70:     out = g.copy()\n  71:     painted_any = False\n  72:     for r in range(1, H - 1):\n  73:         c = mini_start\n  74:         while c <= mini_end:\n  75:             color = int(g[r, c])\n  76:             if color == left_bg:\n  77:                 c += 1\n  78:                 continue\n  79: \n  80:             c0 = c\n  81:             while c <= mini_end and int(g[r, c]) == color:\n  82:                 c += 1\n  83:             c1 = c - 1\n  84: \n  85:             in_left_slot = (c0, c1) == left_slot\n  86:             in_right_slot = (c0, c1) == right_slot\n  87:             if in_left_slot:\n  88:                 d0, d1 = target_start, target_start + 1\n  89:             elif in_right_slot:\n  90:                 d0, d1 = target_end - 1, target_end\n  91:             else:\n  92:                 assert c0 == left_slot[0] and c1 >= right_slot[0], \"run must connect endpoint slots\"\n  93:                 d0, d1 = target_start, target_end\n  94: \n---\n 281:         return None\n 282:     return inp\n 283: \n 284: \n 285: def generate_input() -> np.ndarray:\n 286:     for _ in range(GENERATION_RETRIES):\n 287:         grid = _gen_attempt()\n 288:         if grid is not None:\n 289:             return grid\n 290:     raise RuntimeError(\"failed to generate a valid 9841fdad input\")\n---\nFILE /home/lixinyu/snap/new/ARC_code/train/afe3afe9.py\n 101: \n 102:     return out\n 103: \n 104: \n 105: def main(grid: np.ndarray) -> np.ndarray:\n 106:     \"\"\"Convert each hollow 3x3 symbol to one pixel and slide the pixels clockwise from the marked edge.\n 107: \n 108:     Input structure\n 109:     - The grid has a background, one full-edge marker line, and monochrome hollow 3x3 foreground symbols.\n 110:     - The symbols lie on a coarse row/column lattice; fully empty lattice rows or columns are absent from the output.\n 111: \n 112:     Rule\n 113:     - Replace each hollow 3x3 symbol with one pixel of its color in the corresponding coarse-grid cell.\n 114:     - The marker edge gives the compaction direction by clockwise border travel: top -> right, right -> down, bottom -> left, left -> up.\n 115:     - Preserve the order of non-background pixels while sliding them as far as possible in that direction.\n 116: \n 117:     Key insight\n 118:     - The large picture is a scaled symbolic grid, and the blue edge marker acts as a gravity direction rather than as output content.\n 119:     \"\"\"\n 120:     g = np.asarray(grid, dtype=int)\n 121:     symbolic, side, bg = _symbolic_grid(g)\n 122:     return _compact(symbolic, side, bg)\n 123: \n 124: # --------------- generator (att2) ---------------\n 125: \n 126: # Canvas and colors.\n 127: GEN_BG = 0\n 128: GEN_GRID_SHAPE = (30, 30)\n 129: GEN_MARKER_COLOR = 1\n 130: GEN_DOMINANT_COLOR = 8\n 131: GEN_ACCENT_COLORS = [2, 3, 4, 5, 6, 7, 9]\n 132: \n 133: # Symbolic lattice layout.\n 134: GEN_SIDES = [\"top\", \"right\", \"bottom\", \"left\"]\n 135: GEN_SYMBOLIC_HW = (7, 6)\n 136: GEN_SYMBOLIC_VW = (6, 7)\n 137: GEN_DOMINANT_COUNT_RANGE = (13, 17)\n 138: GEN_ACCENT_COUNT_RANGE = (6, 8)\n 139: GEN_SPLIT_INDEX = 3\n 140: \n 141: # Physical lattice coordinates.\n 142: GEN_GAP_SIX_POSITIONS = [1, 5, 9, 17, 21, 25]\n 143: GEN_SEVEN_FROM_MARKER = [2, 6, 10, 14, 18, 22, 26]\n 144: GEN_SEVEN_FROM_OTHER = [1, 5, 9, 13, 17, 21, 25]\n 145: GEN_SYMBOL_PATCH_SIZE = 3\n 146: \n 147: # Generation retries.\n 148: GEN_MAX_ATTEMPTS = 300\n 149: \n 150: def _gen_compact(symbolic, side, bg):\n 151:     out = np.full_like(symbolic, bg)\n 152: \n 153:     if side == \"top\":\n 154:         for r, row in enumerate(symbolic):\n 155:             values = [int(v) for v in row if int(v) != bg]\n 156:             out[r, symbolic.shape[1] - len(values) :] = values\n 157:     elif side == \"right\":\n 158:         for c in range(symbolic.shape[1]):\n 159:             values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n 160:             out[symbolic.shape[0] - len(values) :, c] = values\n 161:     elif side == \"bottom\":\n 162:         for r, row in enumerate(symbolic):\n 163:             values = [int(v) for v in row if int(v) != bg]\n 164:             out[r, : len(values)] = values\n 165:     elif side == \"left\":\n 166:         for c in range(symbolic.shape[1]):\n 167:             values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n 168:             out[: len(values), c] = values\n 169:     else:\n 170:         raise AssertionError(side)\n 171: \n 172:     return out\n 173: \n 174: \n 175: def _gen_covering_cells(rows, cols, count):\n 176:     rows = list(rows)\n 177:     cols = list(cols)\n 178:     cells = set()\n 179: \n 180:     shuffled_rows = rows[:]\n 181:     random.shuffle(shuffled_rows)\n 182:     for r in shuffled_rows:\n 183:         cells.add((r, random.choice(cols)))\n 184: \n 185:     for c in cols:\n---\n 271:         return None\n 272:     return inp\n 273: \n 274: \n 275: def generate_input():\n 276:     for _ in range(GEN_MAX_ATTEMPTS):\n 277:         result = _gen_attempt()\n 278:         if result is not None:\n 279:             return result\n 280:     raise RuntimeError(\"failed to generate afe3afe9 input\")\n---\n","exit_code":0,"status":"completed"}}
