{"type":"item.completed","item":{"id":"item_13","type":"agent_message","text":"规则和生成器已经定型：`main()` 走“底部条读取 -> 主体矩形识别 -> 黑孔像素计数 -> 查表填色”，生成器则用分层排版保证矩形不接触、不越界、孔洞清晰且数量唯一。现在先在临时解释器里压一轮 100 次随机测试，再落盘。"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom __future__ import annotations\nimport random\nimport hashlib\nimport numpy as np\n\nBG = 0\nRECT_COLOR = 5\nMAX_RETRIES = 300\nPALETTE_LEN_RANGE = (3, 7)\nRECT_COUNT_RANGE = (2, 5)\nRECT_H_RANGE = (3, 8)\nRECT_W_RANGE = (3, 8)\nTOP_MARGIN_RANGE = (1, 4)\nBOTTOM_GAP_RANGE = (1, 4)\nROW_GAP_RANGE = (1, 3)\nCOL_GAP_RANGE = (1, 3)\nMAX_LAYOUT_ROWS = 3\n\n\ndef _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:\n    h, w = mask.shape\n    seen = np.zeros((h, w), dtype=bool)\n    comps = []\n    for r in range(h):\n        for c in range(w):\n            if not mask[r, c] or seen[r, c]:\n                continue\n            stack = [(r, c)]\n            seen[r, c] = True\n            comp = []\n            while stack:\n                cr, cc = stack.pop()\n                comp.append((cr, cc))\n                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n                        seen[nr, nc] = True\n                        stack.append((nr, nc))\n            comps.append(comp)\n    return comps\n\n\ndef _bbox(coords):\n    rows = [r for r, _ in coords]\n    cols = [c for _, c in coords]\n    return min(rows), min(cols), max(rows), max(cols)\n\n\ndef _palette_from_bottom(row: np.ndarray):\n    cols = np.flatnonzero(row \"'!= BG)\n    assert cols.size > 0\n    c0, c1 = int(cols[0]), int(cols[-1])\n    assert np.all(row[c0 : c1 + 1] != BG)\n    assert np.all(row[:c0] == BG)\n    assert np.all(row[c1 + 1 :] == BG)\n    palette = [int(v) for v in row[c0 : c1 + 1]]\n    assert len(palette) == len(set(palette))\n    return c0, palette\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.shape[0] >= 2\n    out = g.copy()\n    _bar_start, palette = _palette_from_bottom(g[-1])\n    body = g[:-1]\n    nz = body[body != BG]\n    assert nz.size > 0\n    vals, cnts = np.unique(nz, return_counts=True)\n    rect_color = int(vals[cnts.argmax()])\n    assert set(np.unique(body)) <= {BG, rect_color}\n    found = 0\n    for comp in _components(body == rect_color):\n        r0, c0, r1, c1 = _bbox(comp)\n        window = body[r0 : r1 + 1, c0 : c1 + 1]\n        if not np.all((window == rect_color) | (window == BG)):\n            continue\n        if not np.all(window[0, :] == rect_color):\n            continue\n        if not np.all(window[-1, :] == rect_color):\n            continue\n        if not np.all(window[:, 0] == rect_color):\n            continue\n        if not np.all(window[:, -1] == rect_color):\n            continue\n        holes = np.argwhere(window == BG)\n        if holes.size == 0:\n            continue\n        assert np.all((holes[:, 0] > 0) & (holes[:, 0] < window.shape[0] - 1))\n        assert np.all((holes[:, 1] > 0) & (holes[:, 1] < window.shape[1] - 1))\n        hole_count = int(len(holes))\n        assert 1 <= hole_count <= len(palette)\n        fill = int(palette[hole_count - 1])\n        for dr, dc in holes:\n            out[r0 + int(dr), c0 + int(dc)] = fill\n        found += 1\n    assert found > 0\n    return out\n\n\ndef _sample_holes(height: int, width: int, count: int):\n    groups = []\n    for row_parity in (0, 1):\n        for col_parity in (0, 1):\n            cells = [\n                (r, c)\n                for r in range(1, height - 1)\n                for c in range(1, width - 1)\n                if (r - 1) % 2 == row_parity and (c - 1) % 2 == col_parity\n            ]\n            if len(cells) >= count:\n                groups.append(cells)\n    if not groups:\n        return None\n    cells = random.choice(groups)\n    return random.sample(cells, count)\n\n\ndef _sample_rect_spec(hole_count: int):\n    candidates = []\n    for h in range(RECT_H_RANGE[0], RECT_H_RANGE[1] + 1):\n        for w in range(RECT_W_RANGE[0], RECT_W_RANGE[1] + 1):\n            inner_h = h - 2\n            inner_w = w - 2\n            capacity = ((inner_h + 1) // 2) * ((inner_w + 1) // 2)\n            if capacity >= hole_count:\n                candidates.append((h, w))\n    if not candidates:\n        return None\n    for _ in range(50):\n        h, w = random.choice(candidates)\n        holes = _sample_holes(h, w, hole_count)\n        if holes is not None:\n            return {\"h\": h, \"w\": w, \"hole_count\": hole_count, \"holes\": holes}\n    return None\n\n\ndef _partition_sizes(n: int, parts: int) -> list[int]:\n    if parts == 1:\n        return [n]\n    cuts = sorted(random.sample(range(1, n), parts - 1))\n    sizes = []\n    prev = 0\n    for cut in cuts + [n]:\n        sizes.append(cut - prev)\n        prev = cut\n    return sizes\n\n\ndef _render_case(width, body_h, palette, rects, placements):\n    inp = np.full((body_h + 1, width), BG, dtype=int)\n    out = inp.copy()\n    for spec, (r0, c0) in zip(rects, placements, strict=True):\n        h, w = spec[\"h\"], spec[\"w\"]\n        inp[r0 : r0 + h, c0 : c0 + w] = RECT_COLOR\n        out[r0 : r0 + h, c0 : c0 + w] = RECT_COLOR\n        fill = int(palette[spec[\"hole_count\"] - 1])\n        for dr, dc in spec[\"holes\"]:\n            inp[r0 + dr, c0 + dc] = BG\n            out[r0 + dr, c0 + dc] = fill\n    bar_start = random.randint(0, width - len(palette))\n    inp[-1, bar_start : bar_start + len(palette)] = palette\n    out[-1, bar_start : bar_start + len(palette)] = palette\n    return inp, out\n\n\ndef _gen_attempt():\n    palette_len = random.randint(*PALETTE_LEN_RANGE)\n    rect_count = random.randint(RECT_COUNT_RANGE[0], min(RECT_COUNT_RANGE[1], palette_len))\n    hole_counts = random.sample(range(1, palette_len + 1), rect_count)\n    rects = []\n    for hole_count in hole_counts:\n        spec = _sample_rect_spec(hole_count)\n        if spec is None:\n            return None\n        rects.append(spec)\n    random.shuffle(rects)\n    max_rows = min(MAX_LAYOUT_ROWS, rect_count)\n    row_count = random.randint(1, max_rows)\n    group_sizes = _partition_sizes(rect_count, row_count)\n    groups = []\n    idx = 0\n    for size in group_sizes:\n        groups.append(rects[idx : idx + size])\n        idx += size\n    top_margin = random.randint(*TOP_MARGIN_RANGE)\n    bottom_gap = random.randint(*BOTTOM_GAP_RANGE)\n    row_gaps = [random.randint(*ROW_GAP_RANGE) for _ in range(row_count - 1)]\n    row_heights = [max(spec[\"h\"] for spec in group) for group in groups]\n    body_h = top_margin + sum(row_heights) + sum(row_gaps) + bottom_gap\n    if body_h + 1 > 30:\n        return None\n    row_widths = []\n    col_gaps_by_row = []\n    for group in groups:\n        gaps = [random.randint(*COL_GAP_RANGE) for _ in range(len(group) - 1)]\n        col_gaps_by_row.append(gaps)\n        row_widths.append(sum(spec[\"w\"] for spec in group) + sum(gaps))\n    min_width = max(max(row_widths), palette_len)\n    if min_width > 30:\n        return None\n    width = random.randint(min_width, min(30, min_width + 8))\n    placements = []\n    y = top_margin\n    for group, row_height, gaps in zip(groups, row_heights, col_gaps_by_row, strict=True):\n        row_width = sum(spec[\"w\"] for spec in group) + sum(gaps)\n        x = random.randint(0, width - row_width)\n        for i, spec in enumerate(group):\n            r0 = y + random.randint(0, row_height - spec[\"h\"])\n            placements.append((r0, x))\n            x += spec[\"w\"]\n            if i < len(gaps):\n                x += gaps[i]\n        y += row_height\n        if gaps is not col_gaps_by_row[-1]:\n            y += row_gaps[len(placements) and len([*filter(lambda t: True, [])])]\n    # fix y increment above by recomputing placements sequentially\n    placements = []\n    y = top_margin\n    for row_idx, (group, row_height, gaps) in enumerate(zip(groups, row_heights, col_gaps_by_row, strict=True)):\n        row_width = sum(spec[\"w\"] for spec in group) + sum(gaps)\n        x = random.randint(0, width - row_width)\n        for i, spec in enumerate(group):\n            r0 = y + random.randint(0, row_height - spec[\"h\"])\n            placements.append((r0, x))\n            x += spec[\"w\"]\n            if i < len(gaps):\n                x += gaps[i]\n        y += row_height\n        if row_idx < len(row_gaps):\n            y += row_gaps[row_idx]\n    palette = random.sample([c for c in range(1, 10) if c != RECT_COLOR], palette_len)\n    inp, expected = _render_case(width, body_h, palette, rects, placements)\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\n\ndef generate_input():\n    for _ in range(MAX_RETRIES):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError('\"'failed')\n\nsigs = set()\nfor i in range(100):\n    inp = generate_input()\n    out = main(inp)\n    assert inp.ndim == 2 and out.ndim == 2 and max(inp.shape) <= 30 and max(out.shape) <= 30\n    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())\nprint('variants', len(sigs))\nprint('sample shapes', {generate_input().shape for _ in range(10)})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
