{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import neighbors4, neighbors8, components_mask, get_bg\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the region enclosed by a wall sprite and radiate color outward through its opening.\n\n    Input structure:\n    - bg = most common color. Wall = most frequent non-bg color, forming a partial enclosure (e.g. U-shape).\n    - A fill-color pixel sits inside the enclosed area. Other non-bg pixels may act as obstacles.\n    Rule:\n    - Flood-fill the enclosed area with the fill color, radiating outward through the wall's open end.\n    - Obstacles cast \"shadows\" along the radiate direction, blocking fill behind them.\n\n    Key insight: The wall endpoints define the opening direction; fill radiates outward through it, and obstacles block propagation along that same axis.\n    \"\"\"\n    g = np.array(grid, copy=True)\n    h, w = g.shape\n\n    vals = np.unique(g)\n    bg = get_bg(g)\n\n    non_bg = [int(v) for v in vals if int(v) != bg]\n    assert non_bg, \"expected at least one non-background color\"\n\n    # Wall: most frequent non-background color.\n    wall = max(non_bg, key=lambda c: int((g == c).sum()))\n\n    wall_mask = g == wall\n\n    # Wall connected components (8-neigh).\n    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]\n    assert comps, \"expected at least one wall connected component\"\n\n    def sgn(x: int) -> int:\n        return (x > 0) - (x < 0)\n\n    other_colors = [c for c in non_bg if c != wall]\n    assert other_colors, \"expected at least one non-wall color (fill color)\"\n\n    # Pick fill color as the non-wall color closest (Manhattan distance) to the wall pixels.\n    wall_points = [p for comp in comps for p in comp]\n\n    def min_dist_to_wall(color: int) -> tuple[int, int]:\n        pts = list(zip(*np.where(g == color)))\n        pts = [(int(r), int(c)) for r, c in pts]\n        best_d = 10**9\n        for r, c in pts:\n            for wr, wc in wall_points:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0, len(pts)\n        return best_d, len(pts)\n\n    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))\n\n    fill_pos = list(zip(*np.where(g == fill)))\n    fill_pos = [(int(r), int(c)) for r, c in fill_pos]\n    if not fill_pos:\n        return g\n\n    # Choose the closest wall component to the fill seed (ties: larger component).\n    def comp_min_dist(comp: set[tuple[int, int]]) -> int:\n        best_d = 10**9\n        for r, c in fill_pos:\n            for wr, wc in comp:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0\n        return best_d\n\n    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))\n\n    comp_mask = np.zeros_like(wall_mask, dtype=bool)\n    for r, c in wall_comp:\n        comp_mask[r, c] = True\n\n    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:\n        out = []\n        for rr, cc in neighbors8(r, c):\n            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:\n                out.append((rr, cc))\n        return out\n\n    endpoints: list[tuple[int, int]] = []\n    for r, c in wall_comp:\n        if len(comp_neighbors(r, c)) == 1:\n            endpoints.append((r, c))\n\n    assert endpoints, \"expected wall component to have endpoints (degree-1 pixels)\"\n\n    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:\n        n1 = comp_neighbors(*ep)[0]\n        d1 = (sgn(n1[0] - ep[0]), sgn(n1[1] - ep[1]))  # inward\n        d_use = d1\n        is_12 = False\n        n2s = [p for p in comp_neighbors(*n1) if p != ep]\n        if n2s:\n            n2 = n2s[0]\n            d2 = (sgn(n2[0] - n1[0]), sgn(n2[1] - n1[1]))\n            if (d1[0] == 0) ^ (d1[1] == 0):\n                if d2[0] != 0 and d2[1] != 0:\n                    d_use = d2\n                    is_12 = True\n        return (-d_use[0], -d_use[1]), is_12\n\n    out_info = [outward_dir(ep) for ep in endpoints]\n    out_dirs = [d for d, _ in out_info]\n    tip_12 = [f for _, f in out_info]\n\n    dr_sum = sum(d[0] for d in out_dirs)\n    dc_sum = sum(d[1] for d in out_dirs)\n    rad = (sgn(dr_sum), sgn(dc_sum))\n\n    barrier = comp_mask.copy()\n\n    def add_ray(start: tuple[int, int], d: tuple[int, int], skip: int = 0) -> None:\n        rr, cc = start\n        for _ in range(skip):\n            rr += d[0]\n            cc += d[1]\n        while True:\n            rr += d[0]\n            cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:\n        rr, cc = start\n        step = 0\n        while True:\n            step += 1\n            if step % 2 == 1:\n                rr += d[0]; cc += d[1]\n            else:\n                if rad[0] != 0:\n                    rr += d[0]\n                else:\n                    cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):\n        if is_12:\n            add_ray_12(ep, d)\n        else:\n            add_ray(ep, d, skip=0)\n\n    passable = (~barrier) & ((g == bg) | (g == fill))\n    q = fill_pos[:]\n    seen = np.zeros_like(passable, dtype=bool)\n    for r, c in q:\n        if passable[r, c]:\n            seen[r, c] = True\n    while q:\n        r, c = q.pop()\n        for rr, cc in neighbors4(r, c):\n            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:\n                seen[rr, cc] = True\n                q.append((rr, cc))\n\n    filled_mask = (seen & (g == bg))\n\n    out = g.copy()\n    out[filled_mask] = fill\n\n    # Shadow behind obstacles (non-bg, non-fill, non-wall) along radiate direction.\n    obstacles = (g != bg) & (g != fill) & (g != wall)\n\n    def shadow_process(coords: list[tuple[int, int]]) -> None:\n        started = False\n        blocked = False\n        for r, c in coords:\n            if filled_mask[r, c]:\n                started = True\n            if started and obstacles[r, c]:\n                blocked = True\n                continue\n            if blocked and filled_mask[r, c]:\n                out[r, c] = bg\n                filled_mask[r, c] = False\n\n    if rad != (0, 0):\n        dr, dc = rad\n        if dr != 0 and dc == 0:\n            for c in range(w):\n                rows = range(h) if dr > 0 else range(h - 1, -1, -1)\n                shadow_process([(r, c) for r in rows])\n        elif dc != 0 and dr == 0:\n            for r in range(h):\n                cols = range(w) if dc > 0 else range(w - 1, -1, -1)\n                shadow_process([(r, c) for c in cols])\n        else:\n            # Diagonal scanlines\n            if dr == dc:\n                # r - c = const\n                for k in range(-(w - 1), h):\n                    coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]\n                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n                    shadow_process(coords)\n            else:\n                # r + c = const\n                for k in range(h + w - 1):\n                    coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]\n                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n                    shadow_process(coords)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom scipy.ndimage import distance_transform_cdt\n\n# -- Configuration constants --------------------------------------------------\n# Canvas size bounds\nGRID_H_VERT = (11, 18)       # height range when radiate_dir is vertical\nGRID_H_HORIZ = (8, 18)       # height range when radiate_dir is horizontal\nGRID_W = (15, 19)             # width range (all directions)\n\n# Wall geometry\nWALL_PIXELS_MIN = 17          # minimum wall pixel count\nWALL_PIXELS_MAX = 25          # maximum wall pixel count\nDEPTH_VERT = (5, 10)          # arm depth range for vertical radiate\nDEPTH_HORIZ = (6, 8)          # arm depth range for horizontal radiate\nGAP_VERT = (6, 7)             # endpoint gap for vertical radiate\nGAP_HORIZ = (5, 7)            # endpoint gap for horizontal radiate\nTIP_12_PROB = 0.5             # probability of 1:2 arm-angle mode (when eligible)\n\n# Placement margins\nOPEN_END_MARGIN = 3           # min cells from open end to radiate grid edge\n\n# Fill seed\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/78e78cff.py\"","aggregated_output":"from __future__ import annotations\n\nimport random\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg\n\n\ndef _wall_row_interval(wall_cols: np.ndarray, marker_col: int, width: int) -> tuple[int, int]:\n    left = wall_cols[wall_cols < marker_col]\n    right = wall_cols[wall_cols >= marker_col]\n    assert left.size or right.size, \"wall row must constrain the marker column\"\n\n    if left.size and right.size:\n        start = int(left.max()) + 1\n        stop = int(right.min()) - 1\n    elif left.size:\n        start = int(left.max()) + 1\n        stop = int(width) - 1\n    else:\n        start = 0\n        stop = int(right.min()) - 1\n\n    assert 0 <= start <= stop < int(width), \"wall row must leave a nonempty passage\"\n    return start, stop\n\n\ndef _assert_wall_connectivity(g: np.ndarray, wall_color: int, marker_col: int) -> None:\n    wall_coords = {tuple(map(int, coord)) for coord in np.argwhere(g == wall_color)}\n    remaining = set(wall_coords)\n    component_count = 0\n    while remaining:\n        component_count += 1\n        stack = [remaining.pop()]\n        while stack:\n            r, c = stack.pop()\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    if dr == 0 and dc == 0:\n                        continue\n                    neighbor = (r + dr, c + dc)\n                    if neighbor in remaining:\n                        remaining.remove(neighbor)\n                        stack.append(neighbor)\n    assert component_count == 4, \"wall must form four 8-connected arcs around the four openings\"\n\n    rows: dict[int, tuple[list[int], list[int]]] = {}\n    for r in range(g.shape[0]):\n        wall_cols = [int(c) for c in np.flatnonzero(g[r] == wall_color)]\n        if not wall_cols:\n            continue\n        left = [c for c in wall_cols if c < marker_col]\n        right = [c for c in wall_cols if c > marker_col]\n        for side_cols in (left, right):\n            if side_cols:\n                assert side_cols == list(range(min(side_cols), max(side_cols) + 1)), \"wall side blocks must be contiguous\"\n        rows[r] = (left, right)\n\n    for r in sorted(rows):\n        if r - 1 not in rows:\n            continue\n        prev_left, prev_right = rows[r - 1]\n        left, right = rows[r]\n        for prev_side, side in ((prev_left, left), (prev_right, right)):\n            if prev_side and side:\n                assert min(abs(a - b) for a in prev_side for b in side) <= 1, \"adjacent wall rows must remain 8-connected\"\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the row-wise passage indicated by wall pixels with the singleton marker color.\n\n    Input structure:\n    - A dominant background contains one singleton marker pixel and one wall color.\n    - Wall pixels lie on several rows and form left/right limits around the marker column.\n    - Empty rows between the top and bottom wall rows are open horizontal passages.\n\n    Rule:\n    - On a wall row, paint background pixels between the nearest wall strictly\n      left of the marker column and the nearest wall at or right of it; if only\n      one side is present, paint from that wall to the opposite grid edge.\n    - On empty rows between the top and bottom wall rows, paint the whole row.\n    - On empty rows outside the wall-row band, reuse the nearest end wall-row interval.\n    - Preserve wall pixels and the original marker pixel.\n\n    Key insight:\n    - The wall color defines scanline limits relative to the marker column; the\n      marker color fills those implied horizontal spans rather than flood-filling\n      through connected background.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = g.shape\n\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 2, \"expected exactly a marker color and a wall color\"\n\n    marker_colors = [color for color in fg_colors if int(np.count_nonzero(g == color)) == 1]\n    assert len(marker_colors) == 1, \"expected a unique singleton marker color\"\n    marker_color = int(marker_colors[0])\n    wall_colors = [color for color in fg_colors if int(color) != marker_color]\n    assert len(wall_colors) == 1, \"expected one wall color\"\n    wall_color = int(wall_colors[0])\n\n    marker_coords = np.argwhere(g == marker_color)\n    assert marker_coords.shape == (1, 2), \"expected exactly one marker pixel\"\n    marker_row, marker_col = map(int, marker_coords[0])\n    _assert_wall_connectivity(g, wall_color, marker_col)\n\n    row_intervals: dict[int, tuple[int, int]] = {}\n    for r in range(height):\n        wall_cols = np.flatnonzero(g[r] == wall_color)\n        if wall_cols.size:\n            row_intervals[int(r)] = _wall_row_interval(wall_cols, marker_col, width)\n\n    assert row_intervals, \"expected at least one wall row\"\n    top_wall_row = min(row_intervals)\n    bottom_wall_row = max(row_intervals)\n    assert top_wall_row <= marker_row <= bottom_wall_row, \"marker must lie within the wall-row band\"\n\n    out = g.copy()\n    for r in range(height):\n        if r in row_intervals:\n            start, stop = row_intervals[r]\n        elif top_wall_row < r < bottom_wall_row:\n            start, stop = 0, int(width) - 1\n        elif r < top_wall_row:\n            start, stop = row_intervals[top_wall_row]\n        else:\n            start, stop = row_intervals[bottom_wall_row]\n\n        span = out[r, start : stop + 1]\n        span[span == bg] = marker_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\nfrom arc_utils import components_mask\n\n# Canvas and band choices.\nHEIGHT_BAND_EMPTY_OPTIONS = ((11, 5, 1), (11, 6, 1), (11, 6, 2), (12, 6, 1), (12, 6, 2), (12, 7, 1), (12, 7, 2))\nGRID_WIDTH_RANGE = (11, 12)\nBAND_TOP_ROW = 2\n\n# Palette and marker placement.\nCOLOR_IDS = range(10)\nCOLOR_COUNT = 3\nMARKER_COL_RANGE = (3, 8)\n\n# Wall shape and pixel-count controls.\nWALL_PIXEL_RANGE = (8, 14)\nBASE_WALL_OFFSET = 1\nPEAK_WALL_OFFSET_MIN = 2\nSIDE_BLOCK_MAX_LEN = 2\nEXPECTED_WALL_COMPONENTS = 4\nONE_SIDED_ROW_PROB = 0.25\nONE_SIDED_OPTIONS = (\"left\", \"right\")\n\nGENERATION_RETRIES = 300\n\n\ndef _wall_interval(wall_cols: list[int], marker_col: int, width: int) -> tuple[int, int]:\n    left = [c for c in wall_cols if c < marker_col]\n    right = [c for c in wall_cols if c > marker_col]\n    if left and right:\n        return max(left) + 1, min(right) - 1\n    if left:\n        return max(left) + 1, width - 1\n    return 0, min(right) - 1\n\n\ndef _expected_output(grid, bg, marker, intervals, top, bottom):\n    \"\"\"Return the solver output implied by the generated wall intervals.\"\"\"\n    height, width = grid.shape\n    out = grid.copy()\n    for r in range(height):\n        if r in intervals:\n            start, stop = intervals[r]\n        elif top < r < bottom:\n            start, stop = 0, width - 1\n        elif r < top:\n            start, stop = intervals[top]\n        else:\n            start, stop = intervals[bottom]\n        span = out[r, start : stop + 1]\n        span[span == bg] = marker\n    return out\n\n\ndef _center_empty_rows(top: int, band_len: int, empty_count: int) -> set[int]:\n    bottom = top + band_len - 1\n    if empty_count == 1:\n        if band_len % 2:\n            return {(top + bottom) // 2}\n        return {random.choice([(top + bottom) // 2, (top + bottom) // 2 + 1])}\n    if band_len % 2:\n        mid = (top + bottom) // 2\n        return set(random.choice([(mid - 1, mid), (mid, mid + 1)]))\n    mid = (top + bottom) // 2\n    return {mid, mid + 1}\n\n\ndef _peak_offsets(wall_rows: list[int], top: int, bottom: int, maximum: int) -> dict[int, int]:\n    max_depth = max(min(r - top, bottom - r) for r in wall_rows)\n    if max_depth == 0:\n        return {r: BASE_WALL_OFFSET for r in wall_rows}\n    peak = random.randint(PEAK_WALL_OFFSET_MIN, min(maximum, BASE_WALL_OFFSET + max_depth))\n    offsets = {}\n    for r in wall_rows:\n        depth = min(r - top, bottom - r)\n        offsets[r] = BASE_WALL_OFFSET + round((peak - BASE_WALL_OFFSET) * depth / max_depth)\n    return offsets\n\n\ndef _wall_component_count(wall_cols_by_row: dict[int, list[int]]) -> int:\n    max_row = max(wall_cols_by_row)\n    max_col = max(c for cols in wall_cols_by_row.values() for c in cols)\n    mask = np.zeros((max_row + 1, max_col + 1), dtype=bool)\n    for r, cols in wall_cols_by_row.items():\n        mask[r, cols] = True\n    return len(components_mask(mask, connectivity=8))\n\n\ndef _cols_on_side(cols: list[int], marker_col: int, side: str) -> list[int]:\n    if side == \"left\":\n        return [c for c in cols if c < marker_col]\n    return [c for c in cols if c > marker_col]\n\n\ndef _wall_has_intended_connectivity(wall_cols_by_row: dict[int, list[int]], marker_col: int) -> bool:\n    if _wall_component_count(wall_cols_by_row) != EXPECTED_WALL_COMPONENTS:\n        return False\n\n    for r in sorted(wall_cols_by_row):\n        if r - 1 not in wall_cols_by_row:\n            continue\n        prev_cols = wall_cols_by_row[r - 1]\n","exit_code":0,"status":"completed"}}
