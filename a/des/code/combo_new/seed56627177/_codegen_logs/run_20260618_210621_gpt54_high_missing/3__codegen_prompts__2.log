{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n\n    Input structure:\n    - Black background with several axis-aligned colored line drawings.\n    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n\n    Rule:\n    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n    - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n    - The color with no enclosed region is the noise/pad color.\n    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n\n    Key insight:\n    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg == 0\n\n    counts: list[tuple[int, int, np.ndarray]] = []\n    for color in colors_present(g, exclude={bg}):\n        rooms = _room_count_for_color(g, int(color))\n        walls = _walls_for_color(g, int(color))\n        counts.append((int(color), int(rooms), walls))\n\n    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n    assert drawings\n    assert len(pad_colors) == 1\n\n    pad = int(pad_colors[0])\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n        group = [item for item in drawings if item[1] == rooms]\n        ordered.extend(_cover_order(g, group))\n\n    width = max(rooms for _color, rooms, _walls in ordered)\n\n    out = np.full((len(ordered), width), pad, dtype=int)\n    for r, (color, rooms, _walls) in enumerate(ordered):\n        out[r, :rooms] = int(color)\n    return out\n\n# --------------- generator (claude-opus-4-6) ---------------\n\n# ---- CFG: Tunable generation parameters ----\n_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n    5: (25, 30, 25, 30, 16, 18),\n    4: (22, 30, 22, 30, 18, 22),\n    3: (20, 30, 20, 30, 22, 25),\n}\n_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n_OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n_GEN_RETRIES = 300                   # outer retry limit\n\n\ndef _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n    \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n    if n * min_gap > max_total:\n        return None\n    gaps = [min_gap] * n\n    remaining = max_total - sum(gaps)\n    for i in range(n):\n        extra = min(max_gap - gaps[i], remaining)\n        if extra > 0:\n            add = random.randint(0, extra)\n            gaps[i] += add\n            remaining -= add\n    random.shuffle(gaps)\n    return gaps\n\n\ndef _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n    \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n    if target_rooms == 1:\n        gap_h = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_h - 2))\n        gap_w = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_w - 2))\n        h, w = gap_h + 2, gap_w + 2\n        walls = np.zeros((h, w), dtype=bool)\n        walls[0, :] = True\n        walls[h - 1, :] = True\n        walls[:, 0] = True\n        walls[:, w - 1] = True\n        return walls\n\n    # For target_rooms >= 2: grid of cells, then selectively merge\n    possible_configs = []\n    for nv in range(2, 6):\n        for nh in range(2, 5):\n            cells = (nv - 1) * (nh - 1)\n            if target_rooms <= cells <= target_rooms + 4:\n                possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        for nv in range(2, 7):\n            for nh in range(2, 6):\n                cells = (nv - 1) * (nh - 1)\n                if cells >= target_rooms:\n                    possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        return None\n\n    n_vcols, n_hrows, total_cells = random.choice(possible_configs)\n    n_row_gaps = n_hrows - 1\n    n_col_gaps = n_vcols - 1\n    min_gap, max_gap = _CELL_GAP_RANGE\n\n    if min_gap * n_row_gaps > max_h - 1 or min_gap * n_col_gaps > max_w - 1:\n        return None\n\n    row_gaps = _random_gaps(n_row_gaps, min_gap, max_gap, max_h - 1)\n    col_gaps = _random_gaps(n_col_gaps, min_gap, max_gap, max_w - 1)\n    if row_gaps is None or col_gaps is None:\n        return None\n\n    # Compute line positions from cumulative gaps\n    vcol_positions = [0]\n    for gap in col_gaps:\n        vcol_positions.append(vcol_positions[-1] + gap)\n    hrow_positions = [0]\n    for gap in row_gaps:\n        hrow_positions.append(hrow_positions[-1] + gap)\n\n    frame_h = hrow_positions[-1] + 1\n    frame_w = vcol_positions[-1] + 1\n    walls = np.zeros((frame_h, frame_w), dtype=bool)\n    for r in hrow_positions:\n        walls[r, :] = True\n    for c in vcol_positions:\n        walls[:, c] = True\n\n    cells_to_merge = total_cells - target_rooms\n    if cells_to_merge == 0:\n        return walls\n\n    # Union-find to merge adjacent cells by removing internal wall segments\n    parent = list(range(total_cells))\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(x, y):\n        px, py = find(x), find(y)\n        if px == py:\n            return False\n        parent[px] = py\n        return True\n\n    def cell_id(cr, cc):\n        return cr * (n_vcols - 1) + cc\n\n    # Enumerate internal wall segments (between adjacent cells)\n    internal_segments = []\n    for hi in range(1, n_hrows - 1):\n        r = hrow_positions[hi]\n        for ci in range(n_vcols - 1):\n            c0, c1 = vcol_positions[ci], vcol_positions[ci + 1]\n            internal_segments.append(('h', r, c0, c1, cell_id(hi - 1, ci), cell_id(hi, ci)))\n    for ci in range(1, n_vcols - 1):\n        c = vcol_positions[ci]\n        for hi in range(n_hrows - 1):\n            r0, r1 = hrow_positions[hi], hrow_positions[hi + 1]\n            internal_segments.append(('v', c, r0, r1, cell_id(hi, ci - 1), cell_id(hi, ci)))\n\n    random.shuffle(internal_segments)\n    merged = 0\n    for seg in internal_segments:\n        if merged >= cells_to_merge:\n            break\n        if seg[0] == 'h':\n            _, r, c0, c1, ca, cb = seg\n            if find(ca) != find(cb):\n                union(ca, cb)\n                walls[r, c0 + 1:c1] = False\n                merged += 1\n        else:\n            _, c, r0, r1, ca, cb = seg\n            if find(ca) != find(cb):\n                union(ca, cb)\n                walls[r0 + 1:r1, c] = False\n                merged += 1\n\n    if merged < cells_to_merge:\n        return None\n    if _count_enclosed_regions(walls) != target_rooms:\n        return None\n    return walls\n\n\ndef _force_overlap(positions, i, j, frames, grid_h, grid_w):\n    \"\"\"Try to reposition frame j so it overlaps frame i. Modifies positions in place.\"\"\"\n    fi_h, fi_w = frames[i][2].shape\n    fj_h, fj_w = frames[j][2].shape\n    ri, ci = positions[i]\n    r0_min = max(0, ri - fj_h + 2)\n    r0_max = min(grid_h - fj_h, ri + fi_h - 2)\n    c0_min = max(0, ci - fj_w + 2)\n    c0_max = min(grid_w - fj_w, ci + fi_w - 2)\n    if r0_min > r0_max or c0_min > c0_max:\n        return\n    for _ in range(_OVERLAP_RETRY):\n        rj = random.randint(r0_min, r0_max)\n        cj = random.randint(c0_min, c0_max)\n        # Verify bbox overlap\n        if (max(ri, rj) <= min(ri + fi_h - 1, rj + fj_h - 1) and\n                max(ci, cj) <= min(ci + fi_w - 1, cj + fj_w - 1)):\n            positions[j] = (rj, cj)\n            return\n\n\ndef _render_frames(frames, positions, render_order, grid_h, grid_w):\n    \"\"\"Render frame walls onto grid; return grid and set of visible frame pixel coords.\"\"\"\n    grid = np.zeros((grid_h, grid_w), dtype=int)\n    # Paint walls in render order (later overwrites earlier at overlaps)\n    for idx in render_order:\n        r0, c0 = positions[idx]\n        wall_arr = frames[idx][2]\n        color = frames[idx][0]\n        # Vectorized: find wall pixel offsets and stamp color\n        rs, cs = np.where(wall_arr)\n        grid[rs + r0, cs + c0] = color\n\n    # Compute visible frame pixels (where grid still shows that frame's color)\n    frame_mask = np.zeros((grid_h, grid_w), dtype=bool)\n    for idx in render_order:\n        r0, c0 = positions[idx]\n        wall_arr = frames[idx][2]\n        color = frames[idx][0]\n        rs, cs = np.where(wall_arr)\n        abs_rs, abs_cs = rs + r0, cs + c0\n        visible = grid[abs_rs, abs_cs] == color\n        frame_mask[abs_rs[visible], abs_cs[visible]] = True\n\n    return grid, frame_mask\n\n\ndef _scatter_noise(grid, frame_mask, noise_color, grid_h, grid_w):\n    \"\"\"Place noise pixels on non-wall cells and damage some wall cells.\"\"\"\n    total_cells = grid_h * grid_w\n    noise_fraction = random.uniform(*_NOISE_FRACTION_RANGE)\n    noise_count = int(total_cells * noise_fraction)\n\n    # Non-wall positions\n    nonwall_rs, nonwall_cs = np.where(~frame_mask)\n    perm = np.random.permutation(len(nonwall_rs))\n    n_nonwall = min(noise_count, len(perm))\n    sel = perm[:n_nonwall]\n    grid[nonwall_rs[sel], nonwall_cs[sel]] = noise_color\n    placed = n_nonwall\n\n    # Wall damage (up to _WALL_DAMAGE_FRACTION of wall pixels)\n    wall_rs, wall_cs = np.where(frame_mask)\n    n_wall = len(wall_rs)\n    max_damage = min(noise_count - placed, int(_WALL_DAMAGE_FRACTION * n_wall))\n    if max_damage > 0:\n        damage_perm = np.random.permutation(n_wall)[:max_damage]\n        grid[wall_rs[damage_perm], wall_cs[damage_perm]] = noise_color\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid puzzle grid.\"\"\"\n    frame_count = random.randint(*_FRAME_COUNT_RANGE)\n\n    # --- Room count assignment ---\n    available = list(range(_ROOM_COUNT_RANGE[0], _ROOM_COUNT_RANGE[1] + 1))\n    allow_tie = random.random() < _TIE_PROBABILITY and frame_count >= 3\n    if allow_tie:\n        distinct_needed = frame_count - 1\n        chosen = random.sample(available, min(distinct_needed, len(available)))\n        if len(chosen) < distinct_needed:\n            return None\n        room_counts = chosen + [random.choice(chosen)]\n    else:\n        if frame_count > len(available):\n            return None\n        room_counts = random.sample(available, frame_count)\n    random.shuffle(room_counts)\n\n    # --- Color assignment ---\n    chosen_colors = random.sample(list(range(1, 10)), frame_count + 1)\n    frame_colors = chosen_colors[:frame_count]\n    noise_color = chosen_colors[frame_count]\n\n    # --- Grid/frame size selection ---\n    cfg = _GRID_SIZE_BY_FRAMES.get(frame_count, _GRID_SIZE_BY_FRAMES[3])\n    h_min, h_max, w_min, w_max, f_max_h, f_max_w = cfg\n    grid_h = random.randint(h_min, h_max)\n    grid_w = random.randint(w_min, w_max)\n\n    # --- Build frames ---\n    frames = []\n    for color, target_rooms in zip(frame_colors, room_counts):\n        frame_data = _build_frame(target_rooms, max_h=f_max_h, max_w=f_max_w)\n        if frame_data is None:\n            return None\n        fh, fw = frame_data.shape\n        if fh > grid_h - 2 or fw > grid_w - 2:\n            return None\n        frames.append((color, target_rooms, frame_data))\n\n    # --- Place frames (largest first, random position) ---\n    positions = [None] * frame_count\n    for idx in sorted(range(frame_count), key=lambda i: -frames[i][2].size):\n        fh, fw = frames[idx][2].shape\n        positions[idx] = (random.randint(0, grid_h - fh), random.randint(0, grid_w - fw))\n\n    # --- Force overlaps for tied pairs ---\n    tied_pairs = [(i, j) for i in range(frame_count) for j in range(i + 1, frame_count)\n                  if room_counts[i] == room_counts[j]]\n    for i, j in tied_pairs:\n        _force_overlap(positions, i, j, frames, grid_h, grid_w)\n\n    # --- Force some non-tied overlaps ---\n    non_tied = [(i, j) for i in range(frame_count) for j in range(i + 1, frame_count)\n                if room_counts[i] != room_counts[j]]\n    n_extra = random.randint(*_EXTRA_OVERLAP_RANGE)\n    if n_extra > 0 and non_tied:\n        random.shuffle(non_tied)\n        for i, j in non_tied[:min(n_extra, len(non_tied))]:\n            _force_overlap(positions, i, j, frames, grid_h, grid_w)\n\n    # --- Render and add noise ---\n    render_order = list(range(frame_count))\n    random.shuffle(render_order)\n\n    grid, frame_mask = _render_frames(frames, positions, render_order, grid_h, grid_w)\n    _scatter_noise(grid, frame_mask, noise_color, grid_h, grid_w)\n\n    # --- Validate via solver oracle ---\n    try:\n        output = main(grid)\n    except Exception:\n        return None\n\n    # Build expected output: rows sorted by (room_count, render_order position)\n    frame_info = sorted(\n        [(room_counts[i], render_order.index(i), frame_colors[i]) for i in range(frame_count)])\n    max_rooms = max(rc for rc, _, _ in frame_info)\n    expected = np.full((frame_count, max_rooms), noise_color, dtype=int)\n    for r, (rc, _, color) in enumerate(frame_info):\n        expected[r, :rc] = color\n\n    return grid if np.array_equal(output, expected) else None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, table, frame, and slot dimensions.\nCANVAS_MIN, CANVAS_MAX = 13, 19\nTABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\nROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\nAXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n\n# Object and palette sampling limits.\nN_COLORS, MAX_OBJECT_COLORS = 10, 6\nMAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\nOBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n\n# Rejection sampling cap.\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_axis_options(n_slots, slot_min, slot_max):\n    options = []\n\n    def rec_slots(i, cur):\n        if i == n_slots:\n            rec_seps(0, [], cur)\n            return\n        for size in range(slot_min, slot_max + 1):\n            rec_slots(i + 1, cur + [size])\n\n    def rec_seps(i, cur, slots):\n        if i == n_slots - 1:\n            for before in AXIS_OUTER_OPTIONS:\n                for after in AXIS_OUTER_OPTIONS:\n                    for pad_before in AXIS_PADDING_OPTIONS:\n                        for pad_after in AXIS_PADDING_OPTIONS:\n                            total = (\n                                before\n                                + after\n                                + pad_before\n                                + pad_after\n                                + sum(slots)\n                                + sum(cur)\n                            )\n                            if 13 <= total <= 19:\n                                options.append(\n                                    (\n                                        tuple(slots),\n                                        tuple(cur),\n                                        before,\n                                        after,\n                                        pad_before,\n                                        pad_after,\n                                        total,\n                                )\n                            )\n            return\n        for sep in AXIS_SEPARATOR_OPTIONS:\n            rec_seps(i + 1, cur + [sep], slots)\n\n    rec_slots(0, [])\n    return options\n\n\ndef _gen_positions(axis):\n    sizes, seps, outer_before, _outer_after, pad_before, _pad_after, _total = axis\n    starts = []\n    pos = outer_before + pad_before\n    for i, size in enumerate(sizes):\n        starts.append(pos)\n        pos += size\n        if i < len(seps):\n            pos += seps[i]\n    return starts\n\n\ndef _gen_choose_axis(n_slots, slot_min, slot_max, other_axis=None, max_object_loss=0):\n    options = _gen_axis_options(n_slots, slot_min, slot_max)\n    if other_axis is None:\n        return random.choice(options)\n\n    good = []\n    for axis in options:\n        row_axis = axis if slot_max == ROW_SLOT_SIZE_RANGE[1] else other_axis\n        col_axis = axis if slot_max == COL_SLOT_SIZE_RANGE[1] else other_axis\n        height = row_axis[-1]\n        width = col_axis[-1]\n        frame_height = height - row_axis[2] - row_axis[3]\n        frame_width = width - col_axis[2] - col_axis[3]\n        slot_area = sum(row_axis[0]) * sum(col_axis[0])\n        outer_bg = height * width - frame_height * frame_width\n        bg_room = outer_bg + slot_area - max_object_loss\n        frame_area = frame_height * frame_width - slot_area\n        if bg_room > frame_area:\n            good.append(axis)\n    return random.choice(good or options)\n\n\ndef _gen_assign_colors(shape, bg, frame):\n    n_slots = shape[0] * shape[1]\n    filled_count = random.randint(1, n_slots - 1)\n    filled = random.sample(range(n_slots), filled_count)\n    colors = [c for c in range(N_COLORS) if c not in (bg, frame)]\n    n_colors = random.randint(1, min(MAX_OBJECT_COLORS, filled_count, len(colors)))\n    palette = random.sample(colors, n_colors)\n    assignments = palette[:]\n    assignments.extend(random.choice(palette) for _ in range(filled_count - n_colors))\n    random.shuffle(assignments)\n\n    out = np.full(shape, bg, dtype=int)\n    for idx, color in zip(filled, assignments):\n        out[idx // shape[1], idx % shape[1]] = color\n    return out, filled_count\n\n\ndef _gen_object_shape(slot_h, slot_w):\n    by_area = {}\n    for obj_h in range(1, min(MAX_OBJECT_HEIGHT, slot_h - 2 * OBJECT_MARGIN) + 1):\n        for obj_w in range(1, min(MAX_OBJECT_WIDTH, slot_w - 2 * OBJECT_MARGIN) + 1):\n            by_area.setdefault(obj_h * obj_w, []).append((obj_h, obj_w))\n    area = random.choice(list(by_area))\n    return random.choice(by_area[area])\n\n\ndef _gen_choose_layout(rows, cols, filled_count):\n    row_axis = _gen_choose_axis(rows, *ROW_SLOT_SIZE_RANGE)\n    loss = MAX_OBJECT_AREA * filled_count\n    col_axis = _gen_choose_axis(cols, *COL_SLOT_SIZE_RANGE, row_axis, max_object_loss=loss)\n    return row_axis, col_axis, _gen_positions(row_axis), _gen_positions(col_axis)\n\n\ndef _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts):\n    height = row_axis[-1]\n    width = col_axis[-1]\n    grid = np.full((height, width), bg, dtype=int)\n    rt, rb = row_axis[2], row_axis[3]\n    cl, cr = col_axis[2], col_axis[3]\n    grid[rt : height - rb, cl : width - cr] = frame\n\n    for r, slot_h in zip(row_starts, row_axis[0]):\n        for c, slot_w in zip(col_starts, col_axis[0]):\n            grid[r : r + slot_h, c : c + slot_w] = bg\n    return grid\n\n\ndef _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts):\n    for out_r, slot_r in enumerate(row_starts):\n        slot_h = row_axis[0][out_r]\n        for out_c, slot_c in enumerate(col_starts):\n            color = int(out[out_r, out_c])\n            if color == bg:\n                continue\n            slot_w = col_axis[0][out_c]\n            obj_h, obj_w = _gen_object_shape(slot_h, slot_w)\n            obj_r = random.randint(slot_r + OBJECT_MARGIN, slot_r + slot_h - obj_h - OBJECT_MARGIN)\n            obj_c = random.randint(slot_c + OBJECT_MARGIN, slot_c + slot_w - obj_w - OBJECT_MARGIN)\n            grid[obj_r : obj_r + obj_h, obj_c : obj_c + obj_w] = color\n\n\ndef _gen_is_valid(grid, out, bg, frame):\n    counts = np.bincount(grid.ravel(), minlength=N_COLORS)\n    if int(np.argmax(counts)) != bg:\n        return False\n    if counts[frame] <= max(counts[c] for c in range(N_COLORS) if c not in (bg, frame)):\n        return False\n    try:\n        actual = main(grid)\n    except Exception:\n        return False\n    return bool(np.array_equal(actual, out))\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rows = random.randint(*TABLE_ROWS_RANGE)\n    cols = random.randint(*TABLE_COLS_RANGE)\n    bg, frame = random.sample(range(N_COLORS), 2)\n\n    out, filled_count = _gen_assign_colors((rows, cols), bg, frame)\n    row_axis, col_axis, row_starts, col_starts = _gen_choose_layout(rows, cols, filled_count)\n    grid = _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts)\n    _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts)\n\n    if _gen_is_valid(grid, out, bg, frame):\n        return grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/ba1aa698.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/ba1aa698.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Extrapolate the moving sprite from a horizontal sequence of shared-border frames into the next standalone frame.\n\n    Input structure\n    - The grid is a row of equal-width framed panels sharing their vertical border columns.\n    - Each panel has the same fill color and one identical interior sprite at the same local columns.\n    - The sprite's top row changes by a constant amount from panel to panel.\n\n    Rule\n    - Build one output panel with the same height, frame color, fill color, and sprite.\n    - Continue the sprite's diagonal motion one more panel to the right.\n    - Because the output is a standalone panel, advance by the full panel width, not the shared-border spacing.\n\n    Key insight\n    - The panels are consecutive frames of motion; the output is the next frame after the sequence.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    frame = int(g[0, 0])\n    assert h >= 3 and w >= 3\n    assert np.all(g[0, :] == frame)\n    assert np.all(g[-1, :] == frame)\n\n    separators = [c for c in range(w) if np.all(g[:, c] == frame)]\n    assert len(separators) >= 3\n    assert separators[0] == 0 and separators[-1] == w - 1\n    strides = [b - a for a, b in zip(separators, separators[1:])]\n    assert len(set(strides)) == 1\n    stride = strides[0]\n    panel_w = stride + 1\n\n    interior_values = []\n    for c0, c1 in zip(separators, separators[1:]):\n        interior_values.extend(g[1:-1, c0 + 1 : c1].ravel())\n    fill = _unique_most_common(interior_values)\n\n    panels = []\n    for c0, c1 in zip(separators, separators[1:]):\n        panel = g[:, c0 : c1 + 1]\n        assert panel.shape == (h, panel_w)\n        assert np.all(panel[0, :] == frame)\n        assert np.all(panel[-1, :] == frame)\n        assert np.all(panel[:, 0] == frame)\n        assert np.all(panel[:, -1] == frame)\n        panels.append(panel)\n\n    template_sprite, template_mask, first_top, template_left = _extract_sprite(panels[0], fill)\n    top_rows = [first_top]\n    for panel in panels[1:]:\n        sprite, sprite_mask, top, local_c0 = _extract_sprite(panel, fill)\n        assert local_c0 == template_left\n        assert sprite_mask.shape == template_mask.shape\n        assert np.array_equal(sprite_mask, template_mask)\n        assert np.array_equal(sprite[sprite_mask], template_sprite[template_mask])\n        top_rows.append(top)\n\n    deltas = [b - a for a, b in zip(top_rows, top_rows[1:])]\n    assert len(deltas) >= 1 and len(set(deltas)) == 1\n    next_top = _round_half_up(\n        Fraction(top_rows[-1], 1) + Fraction(deltas[0] * panel_w, stride)\n    )\n\n    sprite_h, sprite_w = template_sprite.shape\n    assert 1 <= next_top and next_top + sprite_h <= h - 1\n    assert 1 <= template_left and template_left + sprite_w <= panel_w - 1\n\n    out = np.full((h, panel_w), fill, dtype=int)\n    out[0, :] = frame\n    out[-1, :] = frame\n    out[:, 0] = frame\n    out[:, -1] = frame\n\n    target = out[next_top : next_top + sprite_h, template_left : template_left + sprite_w]\n    target[template_mask] = template_sprite[template_mask]\n    return out\n\n# --------------- generator (att2) ---------------\n_GEN_HEIGHT, _GEN_LOCAL_LEFT = 16, 2\n_GEN_INTERIOR_WIDTHS, _GEN_PANEL_COUNTS = (4, 5), (3, 4)\n_GEN_COLORS = tuple(range(10))\n_GEN_SPRITE_USES_FRAME_PROB = 0.3\n_GEN_SPRITE_HEIGHTS, _GEN_SPRITE_WIDTHS = (1, 2), (2, 3)\n_GEN_MIN_SPRITE_PIXELS, _GEN_MAX_SPRITE_PIXELS = 2, 5\n_GEN_DELTAS = (-3, -2, -1, 1, 2, 3)\n_GEN_MAX_ATTEMPTS = 300\n_GEN_MASK_CACHE = {}\n\ndef _gen_round_half_up(value):\n    return _gen_math.floor(value + _gen_Fraction(1, 2))\n\ndef _gen_contiguous_masks(sprite_h, sprite_w):\n    key = (sprite_h, sprite_w)\n    if key in _GEN_MASK_CACHE:\n        return _GEN_MASK_CACHE[key]\n    cells = [(r, c) for r in range(sprite_h) for c in range(sprite_w)]\n    masks_by_count = {}\n    max_pixels = min(_GEN_MAX_SPRITE_PIXELS, sprite_h * sprite_w)\n    for pixel_count in range(_GEN_MIN_SPRITE_PIXELS, max_pixels + 1):\n        masks = []\n        for combo in _gen_itertools.combinations(cells, pixel_count):\n            rows = {r for r, _ in combo}\n            cols = {c for _, c in combo}\n            if len(rows) != sprite_h or len(cols) != sprite_w:\n                continue\n            mask = np.zeros((sprite_h, sprite_w), dtype=bool)\n            for r, c in combo:\n                mask[r, c] = True\n            if is_contiguous(mask.astype(int), background=0, connectivity=4):\n                masks.append(mask)\n        if masks:\n            masks_by_count[pixel_count] = masks\n    _GEN_MASK_CACHE[key] = masks_by_count\n    return masks_by_count\n\ndef _gen_sprite(fill, sprite_color):\n    sprite_h = _gen_random.choice(_GEN_SPRITE_HEIGHTS)\n    sprite_w = _gen_random.choice(_GEN_SPRITE_WIDTHS)\n    masks_by_count = _gen_contiguous_masks(sprite_h, sprite_w)\n\n    pixel_count = _gen_random.choice(sorted(masks_by_count))\n    mask = _gen_random.choice(masks_by_count[pixel_count])\n    sprite = np.full((sprite_h, sprite_w), fill, dtype=int)\n    sprite[mask] = sprite_color\n    return sprite, mask\n\ndef _gen_make_panel(height, panel_w, frame, fill, sprite, top_row, local_left):\n    panel = np.full((height, panel_w), fill, dtype=int)\n    panel[0, :] = frame\n    panel[-1, :] = frame\n    panel[:, 0] = frame\n    panel[:, -1] = frame\n    paste(panel, sprite, top_row, local_left, transparent=fill)\n    return panel\n\ndef _gen_choose_palette():\n    frame, fill = _gen_random.sample(_GEN_COLORS, 2)\n    if _gen_random.random() < _GEN_SPRITE_USES_FRAME_PROB:\n        sprite_color = frame\n    else:\n        sprite_color = _gen_random.choice(\n            [color for color in _GEN_COLORS if color not in (frame, fill)]\n        )\n    return frame, fill, sprite_color\n\ndef _gen_motion_choices(sprite_h, panel_w, num_panels):\n    max_top = _GEN_HEIGHT - 1 - sprite_h\n    stride = panel_w - 1\n    choices = []\n    for delta in _GEN_DELTAS:\n        for start in range(1, max_top + 1):\n            top_rows = [start + i * delta for i in range(num_panels)]\n            if not all(1 <= top <= max_top for top in top_rows):\n                continue\n            next_top = _gen_round_half_up(\n                _gen_Fraction(top_rows[-1], 1)\n                + _gen_Fraction(delta * panel_w, stride)\n            )\n            if 1 <= next_top <= max_top:\n                choices.append((delta, start, next_top))\n    return choices\n\ndef _gen_make_input(num_panels, stride, frame, fill, sprite, start_top, delta):\n    width = num_panels * stride + 1\n    inp = np.full((_GEN_HEIGHT, width), fill, dtype=int)\n    inp[0, :] = frame\n    inp[-1, :] = frame\n    for panel_i in range(num_panels + 1):\n        inp[:, panel_i * stride] = frame\n    for panel_i in range(num_panels):\n        top = start_top + panel_i * delta\n        paste(inp, sprite, top, panel_i * stride + _GEN_LOCAL_LEFT, transparent=fill)\n    return inp\n\ndef _gen_attempt():\n    interior_w = _gen_random.choice(_GEN_INTERIOR_WIDTHS)\n    num_panels = _gen_random.choice(_GEN_PANEL_COUNTS)\n    panel_w = interior_w + 2\n    stride = panel_w - 1\n    frame, fill, sprite_color = _gen_choose_palette()\n\n    sprite, _ = _gen_sprite(fill, sprite_color)\n    sprite_h, sprite_w = sprite.shape\n    if _GEN_LOCAL_LEFT + sprite_w > panel_w - 1:\n        return None\n\n    choices = _gen_motion_choices(sprite_h, panel_w, num_panels)\n    if not choices:\n        return None\n    delta, start_top, next_top = _gen_random.choice(choices)\n\n    expected = _gen_make_panel(\n        _GEN_HEIGHT, panel_w, frame, fill, sprite, next_top, _GEN_LOCAL_LEFT\n    )\n    inp = _gen_make_input(num_panels, stride, frame, fill, sprite, start_top, delta)\n    if np.array_equal(main(inp), expected):\n        return inp\n    return None\n\ndef generate_input():\n","exit_code":0,"status":"completed"}}
