{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/e87109e9.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Emit four teal beams from a square, turning at colored obstacles per a legend.\n\n    Input structure:\n    - Top band: grey (5) legend with colored vertical bars in cells; bar position (left or right) encodes turn direction.\n    - Below: main grid with bg, a solid teal (8) square, and colored obstacle blocks.\n\n    Rule:\n    - Remove the legend from the output.\n    - From the teal square, shoot a beam in each cardinal direction (as a sliding copy of the square).\n    - Each beam paints teal over bg cells as it moves.\n    - On hitting an obstacle of color C, consult the legend: bar on left → turn counterclockwise, bar on right → turn clockwise. Continue in the new direction.\n    - Beams stop at grid edges.\n\n    Key insight: The legend's bar position (left vs right within its cell) is the encoding for turn direction at each obstacle color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n\n    # Legend height: crop everything above and including the last row containing legend bg (usually 5).\n    # In this dataset, the legend uses a dedicated color (5) that doesn't appear below.\n    legend_bg = 5\n    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]\n    assert rows_with_legend.size, \"legend rows must be present\"\n    legend_h = int(rows_with_legend.max() + 1)\n    assert np.array_equal(rows_with_legend, np.arange(legend_h)), \"legend color must be confined to the top band\"\n\n    legend_turn = _parse_legend(g, legend_h)\n\n    base = g[legend_h:, :].copy()\n    assert base.size, \"main grid must remain after legend crop\"\n\n    _vals, _cnts = np.unique(base, return_counts=True); bg = int(_vals[_cnts.argmax()])\n    teal = 8\n    src = _find_teal_square(base, teal=teal)\n    sr, sc, sz = src\n\n    out = base.copy()\n\n    def in_bounds(r: int, c: int) -> bool:\n        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]\n\n    def paint_block(r: int, c: int) -> None:\n        blk = out[r : r + sz, c : c + sz]\n        blk[blk == bg] = teal\n        out[r : r + sz, c : c + sz] = blk\n\n    def obstacle_color_at_next(nr: int, nc: int) -> int | None:\n        blk = out[nr : nr + sz, nc : nc + sz]\n        cols = set(map(int, np.unique(blk)))\n        cols.discard(bg)\n        cols.discard(teal)\n        if not cols:\n            return None\n        assert len(cols) == 1, \"beam footprint must not hit mixed obstacle colors\"\n        return int(next(iter(cols)))\n\n    # Four beams, each is a moving copy of the teal square.\n    for d0 in range(4):\n        r, c, d = sr, sc, d0\n        seen: set[tuple[int, int, int]] = set()\n        while True:\n            state = (r, c, d)\n            assert state not in seen, \"beam path must not cycle\"\n            seen.add(state)\n\n            dr, dc = _DIRS[d]\n            nr, nc = r + dr, c + dc\n            if not in_bounds(nr, nc):\n                break\n\n            oc = obstacle_color_at_next(nr, nc)\n            if oc is None:\n                r, c = nr, nc\n                paint_block(r, c)\n                continue\n\n            assert oc in legend_turn, \"obstacle color must be encoded by legend\"\n            turn = legend_turn[oc]\n            d = _rot_ccw(d) if turn == \"L\" else _rot_cw(d)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# ── Configuration ──────────────────────────────────────────────────────\n_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n_N, _E, _S, _W = range(4)\n\n# Color palettes\nLEGEND_COLOR_POOL = [1, 2, 3, 4, 6]          # colors eligible for obstacles / legend\nBG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]        # colors eligible for main-grid background\nLEGEND_BG = 5                                  # legend background color\nTEAL = 8                                       # beam / square color\n\n# Canvas dimensions\nGRID_H_RANGE = (19, 24)                        # main-grid height (rows)\nGRID_W = 24                                    # main-grid width (fixed)\nLEGEND_H = 6                                   # legend height (rows)\nLEGEND_CELL_STARTS = [1, 7, 13, 19]           # col offsets for legend cells\n\n# Teal square\nTEAL_SZ2_PROB = 0.75                           # P(size=2); else size=3\nSQUARE_EDGE_GAP = 5                            # min gap from square to grid edges\n\n# Obstacles\nOBS_COUNT_4_PROB = 0.65                        # P(4 obstacles); else 3\nOBS_THICKNESS_RANGE = (2, 4)                   # obstacle shorter-dimension bounds\nOBS_SINGLE_MARGIN = 6                          # margin subtracted when only one side present\nOBS_BOTH_GAP = 2                               # gap subtracted when both sides present\n\n# Span selection\nSPAN_MIN_MULT = 3                              # min obstacle length = SPAN_MIN_MULT * sz\nSPAN_MAX_MULT = 14                             # max obstacle length = SPAN_MAX_MULT * sz\nSPAN_COMPACT_PROB = 0.4                        # P(bias toward compact spans)\n\n# Retry budget\nMAX_RETRIES = 300\n\n\ndef _rot(d: int, turn: str) -> int:\n","exit_code":0,"status":"completed"}}
