{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np, random\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed56627177/13/4.py')\nmod = SourceFileLoader('arc_new_4', str(p)).load_module()\nrandom.seed(0)\nnp.random.seed(0)\nfor attempt in range(200):\n    rows, cols = random.choice(((2, 2), (2, 3), (3, 2), (3, 3)))\n    region_count = rows * cols\n    legend_count = 4 if random.random() < 0.5 else 3\n    legend_categories = random.sample(list(mod.ALL_CATEGORIES), legend_count)\n    legend_colors = random.sample(mod.LEGEND_COLORS, legend_count)\n    entries = list(zip(legend_categories, legend_colors))\n    patterns = mod._choose_patterns([category for category, _color in entries], region_count)\n    if patterns is None:\n        continue\n    orientation = random.choice(('h', 'v'))\n    corner = random.choice(('TL', 'TR', 'BL', 'BR'))\n    board_origin, legend_starts, (height, width) = mod._layout_positions(rows, cols, legend_count, orientation, corner)\n    canvas = np.zeros((height, width), dtype=int)\n    mod._place_board(canvas, board_origin, rows, cols, patterns)\n    mod._place_legend(canvas, legend_starts, entries)\n    try:\n        mapping = mod._legend_mapping(canvas)\n    except Exception as e:\n        print('fail', attempt, rows, cols, legend_count, orientation, corner, entries, canvas.shape, e)\n        print(canvas)\n        break\nelse:\n    print('no failures')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
