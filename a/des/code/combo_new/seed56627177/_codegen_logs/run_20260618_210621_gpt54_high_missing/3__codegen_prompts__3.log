s):\n        paste(out, sub, int(i * 4), 0)\n    for i, (_r0, _c0, sub) in enumerate(solids):\n        paste(out, sub, int(i * 4), 4)\n\n    return out\n\n\ndef _make_frame(col: int, bg: int = 0) -> np.ndarray:\n","exit_code":0,"status":"completed"}}
