ents[j][\"bbox\"]) <= 2:\n  73:                 union(i, j)\n  74: \n  75:     groups: dict[int, list[int]] = {}\n  76:     for i in range(len(fixed_components)):\n  77:         groups.setdefault(find(i), []).append(i)\n  78: \n  79:     anchor_groups = []\n  80:     for idxs in groups.values():\n  81:         pts = [p for i in idxs for p in fixed_components[i][\"pts\"]]\n  82:         rs = [r for r, _c in pts]\n  83:         cs = [c for _r, c in pts]\n  84:         bbox = (min(rs), min(cs), max(rs), max(cs))\n  85:         mask = np.zeros((H, W), dtype=bool)\n  86:         for r, c in pts:\n  87:             mask[r, c] = True\n  88:         sock = np.zeros((H, W), dtype=bool)\n  89:         for r in range(bbox[0], bbox[2] + 1):\n  90:             for c in range(bbox[1], bbox[3] + 1):\n  91:                 if int(g[r, c]) != int(bg):\n  92:                     continue\n  93:                 for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n  94:                     rr, cc = r + dr, c + dc\n  95:                     if 0 <= rr < H and 0 <= cc < W and mask[rr, cc]:\n  96:                         sock[r, c] = True\n  97:                         break\n  98: \n  99:         # Cavity = largest bg component inside bbox that is adjacent to the anchor pixels.\n 100:         cavity = np.zeros((H, W), dtype=bool)\n 101:         sub_bg = (g[bbox[0] : bbox[2] + 1, bbox[1] : bbox[3] + 1] == int(bg))\n 102:         sub_lab, sub_n = label(sub_bg, structure=STRUCT4)\n 103:         best_c = None  # (area, cid)\n 104:         for cid in range(1, sub_n + 1):\n 105:             ptsc = np.argwhere(sub_lab == cid)\n 106:             area = int(len(ptsc))\n 107:             # check adjacency to anchor within bbox\n 108:             adj = False\n 109:             for rr, cc in ptsc:\n 110:                 r = int(bbox[0] + rr)\n 111:                 c = int(bbox[1] + cc)\n 112:                 for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n 113:                     r2, c2 = r + dr, 