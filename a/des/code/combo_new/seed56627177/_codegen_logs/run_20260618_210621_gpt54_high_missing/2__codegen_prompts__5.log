{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\n    Input structure\n    - The background is the dominant color.\n    - The most numerous non-background color forms stationary grey obstacle pixels.\n    - The other two colors form a single 3x3 top-edge marker whose top two rows\n      are maroon and whose bottom row contains maroon or blue control pixels.\n\n    Rule\n    - Erase the top marker.\n    - Treat each marker column as a vertical drop retaining its three colors.\n    - A column whose bottom control pixel is blue stops immediately above the\n      first grey pixel below that column, or bottom-aligns if none exists.\n    - Contiguous maroon-ended columns pass through obstacles and bottom-align;\n      if such a run has a clear down-right slide from a grey ledge, shift the\n      run one column right before bottom-aligning.\n    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n      the rest of the marker-width gap in that bottom bar.\n\n    Key insight\n    - The bottom row of the top marker is a control strip: blue cells mean\n      \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H = g.shape[0]\n    bg = int(get_bg(g))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 3, \"expected obstacle color plus two marker colors\"\n    obstacle = _unique_largest_count_color(g, non_bg)\n    marker_colors = [color for color in non_bg if color != obstacle]\n    assert len(marker_colors) == 2, \"expected exactly two marker colors\"\n\n    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)\n    marker = g[r0 : r1 + 1, c0 : c1 + 1]\n    marker_h, marker_w = marker.shape\n    assert (marker_h, marker_w) == (3, 3), \"expected a 3x3 marker\"\n    assert np.all(np.isin(marker, marker_colors)), \"marker bbox must contain only marker colors\"\n\n    pass_color = int(marker[0, 0])\n    assert np.all(marker[:2, :] == pass_color), \"top two marker rows must be the pass-through color\"\n    stop_colors = [color for color in marker_colors if color != pass_color]\n    assert len(stop_colors) == 1, \"expected one stop color\"\n    stop_color = stop_colors[0]\n\n    out = g.copy()\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    base = out.copy()\n\n    pass_columns: list[int] = []\n    for j in range(marker_w):\n        c = c0 + j\n        stack = marker[:, j]\n        bottom_control = int(stack[-1])\n\n        if bottom_control == stop_color:\n            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n            if len(obstacles_below):\n                floor_r = int(r1 + 1 + obstacles_below[0])\n                top_r = floor_r - marker_h\n            else:\n                top_r = H - marker_h\n            assert top_r >= 0, \"stopped column must fit above its obstacle\"\n            out[top_r : top_r + marker_h, c] = stack\n        else:\n            assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n            pass_columns.append(j)\n\n    for start_j, end_j in _runs(pass_columns):\n        source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n        top_r = H - marker_h\n\n        for j in range(start_j, end_j + 1):\n            c = c0 + j + shift\n            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n            out[top_r : top_r + marker_h, c] = marker[:, j]\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\nGRID_SIZE_RANGE = (14, 16)\nMARKER_SIZE = 3\nSTOP_COUNT_RANGE = (1, 3)\nOBSTACLE_COMPONENT_RANGE = (7, 9)\nOBSTACLE_PIXEL_RANGE = (20, 31)\nCOMPONENT_SIZE_RANGE = (1, 11)\nMIN_STOP_OBSTACLE_ROW = 6\nDROP_ZONE_HEIGHT = 3\nCOMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300\n\n\ndef _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/17829a00.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each colored object vertically until it touches the matching top or bottom border bar.\n\n    Input structure:\n    - The background is the dominant color.\n    - The top row is a full-width bar in one foreground color and the bottom row is a full-width bar in another.\n    - All other foreground pixels are 8-connected monochrome objects whose color matches one of those bars.\n\n    Rule:\n    - Top-bar-colored objects move upward so their bbox top is row 1.\n    - Bottom-bar-colored objects move downward so their bbox bottom is the row above the bottom bar.\n    - A downward-moving one-column segment whose landing overlaps its source becomes the continuous vertical segment swept between them.\n\n    Key insight:\n    The horizontal bars are destination anchors: color determines which border an object slides toward, while columns and object shape are otherwise preserved.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h >= 3 and w >= 1\n\n    bg = int(get_bg(g))\n    top_color = int(g[0, 0])\n    bottom_color = int(g[h - 1, 0])\n\n    assert top_color != bg\n    assert bottom_color != bg\n    assert top_color != bottom_color\n    assert bool(np.all(g[0, :] == top_color))\n    assert bool(np.all(g[h - 1, :] == bottom_color))\n    assert set(map(int, np.unique(g))) == {bg, top_color, bottom_color}\n\n    for c in range(w):\n        top_rows = [r for r in range(1, h - 1) if int(g[r, c]) == top_color]\n        bot_rows = [r for r in range(1, h - 1) if int(g[r, c]) == bottom_color]\n        if top_rows and bot_rows:\n            assert max(top_rows) < min(bot_rows), \"top-color objects must be above bottom-color objects in every column\"\n\n    out = np.full_like(g, bg)\n    out[0, :] = top_color\n    out[h - 1, :] = bottom_color\n\n    for color, target_side in ((top_color, \"top\"), (bottom_color, \"bottom\")):\n        components = find_components(\n            g,\n            bg=bg,\n            connectivity=8,\n            monochromatic=True,\n            colors=[color],\n            return_format=\"dict\",\n        )\n        for comp in components:\n            if _is_full_width_border(comp, h, w):\n                continue\n\n            coords = np.asarray(comp[\"coords\"], dtype=int)\n            r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n            assert 0 < r0 <= r1 < h - 1\n\n            if target_side == \"top\":\n                dr = 1 - r0\n                assert dr <= 0\n                paint = coords + np.array([dr, 0], dtype=int)\n            else:\n                dr = (h - 2) - r1\n                assert dr >= 0\n                paint = coords + np.array([dr, 0], dtype=int)\n                if dr > 0 and r0 + dr <= r1:\n                    assert c0 == c1\n                    rows = np.arange(r0, r1 + dr + 1, dtype=int)\n                    paint = np.column_stack([rows, np.full(rows.shape, c0, dtype=int)])\n\n            assert bool(np.all((0 <= paint[:, 0]) & (paint[:, 0] < h)))\n            assert bool(np.all((0 <= paint[:, 1]) & (paint[:, 1] < w)))\n            assert bool(np.all(out[paint[:, 0], paint[:, 1]] == bg))\n            out[paint[:, 0], paint[:, 1]] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom scipy.ndimage import binary_dilation\n\n# -- Grid constants --\nBG = 7\nH = 16\nW = 16\n\n# -- Sprite geometry --\nSPRITE_AREA_MIN = 1\nSPRITE_AREA_MAX = 6\nSPRITE_H_MAX = 4       # bbox height upper bound (exclusive in range)\nSPRITE_W_MAX = 5       # bbox width upper bound (exclusive in range)\nSPRITE_DENSITY_MIN = 0.33  # min fill ratio inside bbox\n\n# -- Object counts per side --\nOBJ_COUNT_MIN = 3      # per color\nOBJ_COUNT_MAX = 5      # per color (inclusive)\nOBJ_TOTAL_MAX = 9      # top_count + bottom_count\n\n# -- Swept segment (single-column overlap case) --\nSWEPT_PROB = 0.15       # probability of including one swept-segment object\nSWEPT_H_MIN = 2        # min input height for swept column\nSWEPT_H_MAX = 4        # max input height (inclusive)\nSWEPT_TOTAL_MAX = 5    # input_h + offset ceiling\n\n# -- Input derivation --\nSLIDE_OFFSET_MAX = 10  # exclusive upper bound for slide offsets (range(1, N))\n\n# -- Retry budgets --\nPLACE_RETRIES = 60     # sprite placement attempts per object\nGEN_RETRIES = 300      # outer generation attempts\n\n\ndef _corner_path(h: int, w: int) -> set[tuple[int, int]]:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/48634b99.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Advance the marker from one half of a vertical bar to the same half of the next longer bar.\n\n    Input structure\n    - The grid has one dominant background color and exactly two foreground colors.\n    - One foreground color forms many vertical one-cell-wide bars; the other appears as a single vertical marker segment.\n    - The marker segment occupies exactly the top or bottom half of its containing vertical bar.\n    Rule\n    - Recolor the current marker segment back to the bar color.\n    - Find the unique all-bar-color vertical bar whose height is two pixels greater than the marked source bar.\n    - Recolor the same half of that next longer bar to the marker color.\n    Key insight\n    - Each bar's total height encodes an ordered size, and the marker advances from a 2k bar to the corresponding 2(k+1) bar while preserving whether it marks the top or bottom half.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = int(get_bg(g))\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, f\"expected exactly two foreground colors, got {colors}\"\n\n    mono_component_counts = {\n        int(color): len(\n            find_components(\n                g,\n                bg=bg,\n                colors=[int(color)],\n                connectivity=4,\n                monochromatic=True,\n            )\n        )\n        for color in colors\n    }\n    marker_colors = [color for color, count in mono_component_counts.items() if count == 1]\n    assert len(marker_colors) == 1, f\"expected one single-component marker color, got {mono_component_counts}\"\n    marker_color = int(marker_colors[0])\n\n    bar_colors = [int(color) for color in colors if int(color) != marker_color]\n    assert len(bar_colors) == 1\n    bar_color = int(bar_colors[0])\n\n    marker_components = find_components(\n        g,\n        bg=bg,\n        colors=[marker_color],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert len(marker_components) == 1\n    marker = marker_components[0]\n    marker_area = int(marker[\"area\"])\n    mr0, mc0, mr1, _mc1 = marker[\"bbox\"]\n    assert _is_solid_vertical_bar(marker)\n\n    bars = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    source_bars = [\n        bar\n        for bar in bars\n        if np.any(g[bar[\"coords\"][:, 0], bar[\"coords\"][:, 1]] == marker_color)\n    ]\n    assert len(source_bars) == 1, f\"expected one bar containing the marker, got {len(source_bars)}\"\n    source = source_bars[0]\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    source_h = bbox_h(source[\"bbox\"])\n    assert _is_solid_vertical_bar(source)\n    assert source_h == 2 * marker_area\n    assert mc0 == sc0 == sc1\n\n    if mr0 == sr0 and mr1 == sr0 + marker_area - 1:\n        marked_end = \"top\"\n    elif mr1 == sr1 and mr0 == sr1 - marker_area + 1:\n        marked_end = \"bottom\"\n    else:\n        raise AssertionError(f\"marker is not exactly one end-half: marker={marker['bbox']} source={source['bbox']}\")\n\n    target_h = source_h + 2\n    target_bars = []\n    for bar in bars:\n        values = g[bar[\"coords\"][:, 0], bar[\"coords\"][:, 1]]\n        if set(map(int, values)) != {bar_color}:\n            continue\n        if not _is_solid_vertical_bar(bar):\n            continue\n        if bbox_h(bar[\"bbox\"]) == target_h:\n            target_bars.append(bar)\n\n    assert len(target_bars) == 1, f\"expected one next-longer target bar, got {[bar['bbox'] for bar in target_bars]}\"\n    target = target_bars[0]\n    tr0, tc0, tr1, _tc1 = target[\"bbox\"]\n    target_half = target_h // 2\n\n    out = g.copy()\n    out[g == marker_color] = bar_color\n    if marked_end == \"top\":\n        out[tr0 : tr0 + target_half, tc0] = marker_color\n    else:\n        out[tr1 - target_half + 1 : tr1 + 1, tc0] = marker_color\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Fixed palette observed in all examples.\nBG = 7\nBAR_COLOR = 8\nMARKER_COLOR = 9\n# Grid geometry and vertical bar vocabulary.\nGRID_SHAPE = (16, 16)\nPROGRESSION_HEIGHTS = (2, 4, 6, 8, 10)\nSOURCE_HEIGHTS = PROGRESSION_HEIGHTS[:-1]\nDISTRACTOR_HEIGHT = 2\nHEIGHT_STEP = 2\n# Placement constraints and structural sampling.\nPLACEMENT_PADDING = 1\nPLACEMENT_CONNECTIVITY = 4\nDISTRACTOR_COUNT_RANGE = (5, 11)\nMARKED_HALVES = (\"top\", \"bottom\")\n# Rejection-sampling retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _paint_bar_half(grid: np.ndarray, row: int, col: int, height: int, marked_half: str, color: int) -> None:\n","exit_code":0,"status":"completed"}}
