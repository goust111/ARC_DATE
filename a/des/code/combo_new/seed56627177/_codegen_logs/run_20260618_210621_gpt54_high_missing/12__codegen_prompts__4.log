{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, components_mask, find_components, get_bg\nimport random\n\n\ndef _unique_largest_count_color(g: np.ndarray, colors: list[int]) -> int:\n    counts = [(int(np.sum(g == color)), int(color)) for color in colors]\n    max_count = max(count for count, _color in counts)\n    winners = [color for count, color in counts if count == max_count]\n    assert len(winners) == 1, \"expected one most numerous non-background obstacle color\"\n    return winners[0]\n\n\ndef _marker_bbox(g: np.ndarray, marker_colors: list[int]) -> tuple[int, int, int, int]:\n    mask = np.isin(g, marker_colors)\n    candidates: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(mask, connectivity=8):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        if r0 == 0:\n            candidates.append((r0, c0, r1, c1))\n\n    assert len(candidates) == 1, \"expected one top-edge marker component\"\n    return candidates[0]\n\n\ndef _runs(values: list[int]) -> list[tuple[int, int]]:\n    if not values:\n        return []\n\n    runs: list[tuple[int, int]] = []\n    start = prev = values[0]\n    for value in values[1:]:\n        if value == prev + 1:\n            prev = value\n            continue\n        runs.append((start, prev))\n        start = prev = value\n    runs.append((start, prev))\n    return runs\n\n\ndef _can_slide_right(base: np.ndarray, obstacle: int, bg: int, cols: list[int], marker_bottom_r: int, height: int) -> bool:\n    H, W = base.shape\n    assert cols\n    if cols[-1] + 1 >= W:\n        return False\n\n    for floor_r in range(marker_bottom_r + 1, H):\n        target_rows = np.arange(floor_r - height + 1, floor_r + 1)\n        if int(target_rows[0]) < 0:\n            continue\n\n        shifted_cols = [c + 1 for c in cols]\n        target_is_clear = all(np.all(base[target_rows, c] == bg) for c in shifted_cols)\n        if not target_is_clear:\n            continue\n\n        for c in cols:\n            if int(base[floor_r, c]) != obstacle:\n                continue\n            has_horizontal_neighbor = (\n                (c > 0 and int(base[floor_r, c - 1]) == obstacle)\n                or (c + 1 < W and int(base[floor_r, c + 1]) == obstacle)\n            )\n            if has_horizontal_neighbor:\n                return True\n\n    return False\n\n\ndef _clear_bottom_edge_gap(base: np.ndarray, out: np.ndarray, obstacle: int, bg: int, c: int, width: int) -> None:\n    H, W = base.shape\n    if int(base[H - 1, c]) != obstacle:\n        return\n\n    c1 = c\n    while c1 < W and int(base[H - 1, c1]) == obstacle:\n        c1 += 1\n\n    if c1 - c >= width:\n        out[H - 1, c + 1 : c + width] = bg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\n    Input structure\n    - The background is the dominant color.\n    - The most numerous non-background color forms stationary grey obstacle pixels.\n    - The other two colors form a single 3x3 top-edge marker whose top two rows\n      are maroon and whose bottom row contains maroon or blue control pixels.\n\n    Rule\n    - Erase the top marker.\n    - Treat each marker column as a vertical drop retaining its three colors.\n    - A column whose bottom control pixel is blue stops immediately above the\n      first grey pixel below that column, or bottom-aligns if none exists.\n    - Contiguous maroon-ended columns pass through obstacles and bottom-align;\n      if such a run has a clear down-right slide from a grey ledge, shift the\n      run one column right before bottom-aligning.\n    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n      the rest of the marker-width gap in that bottom bar.\n\n    Key insight\n    - The bottom row of the top marker is a control strip: blue cells mean\n      \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H = g.shape[0]\n    bg = int(get_bg(g))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 3, \"expected obstacle color plus two marker colors\"\n    obstacle = _unique_largest_count_color(g, non_bg)\n    marker_colors = [color for color in non_bg if color != obstacle]\n    assert len(marker_colors) == 2, \"expected exactly two marker colors\"\n\n    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)\n    marker = g[r0 : r1 + 1, c0 : c1 + 1]\n    marker_h, marker_w = marker.shape\n    assert (marker_h, marker_w) == (3, 3), \"expected a 3x3 marker\"\n    assert np.all(np.isin(marker, marker_colors)), \"marker bbox must contain only marker colors\"\n\n    pass_color = int(marker[0, 0])\n    assert np.all(marker[:2, :] == pass_color), \"top two marker rows must be the pass-through color\"\n    stop_colors = [color for color in marker_colors if color != pass_color]\n    assert len(stop_colors) == 1, \"expected one stop color\"\n    stop_color = stop_colors[0]\n\n    out = g.copy()\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    base = out.copy()\n\n    pass_columns: list[int] = []\n    for j in range(marker_w):\n        c = c0 + j\n        stack = marker[:, j]\n        bottom_control = int(stack[-1])\n\n        if bottom_control == stop_color:\n            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n            if len(obstacles_below):\n                floor_r = int(r1 + 1 + obstacles_below[0])\n                top_r = floor_r - marker_h\n            else:\n                top_r = H - marker_h\n            assert top_r >= 0, \"stopped column must fit above its obstacle\"\n            out[top_r : top_r + marker_h, c] = stack\n        else:\n            assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n            pass_columns.append(j)\n\n    for start_j, end_j in _runs(pass_columns):\n        source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n        top_r = H - marker_h\n\n        for j in range(start_j, end_j + 1):\n            c = c0 + j + shift\n            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n            out[top_r : top_r + marker_h, c] = marker[:, j]\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\nGRID_SIZE_RANGE = (14, 16)\nMARKER_SIZE = 3\nSTOP_COUNT_RANGE = (1, 3)\nOBSTACLE_COMPONENT_RANGE = (7, 9)\nOBSTACLE_PIXEL_RANGE = (20, 31)\nCOMPONENT_SIZE_RANGE = (1, 11)\nMIN_STOP_OBSTACLE_ROW = 6\nDROP_ZONE_HEIGHT = 3\nCOMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300\n\n\ndef _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:\n    grid = np.full((H, W), GEN_BG, dtype=int)\n    c0 = random.randint(0, W - MARKER_SIZE)\n    num_stops = random.randint(*STOP_COUNT_RANGE)\n    positions = list(range(MARKER_SIZE))\n    random.shuffle(positions)\n    stop_positions = sorted(positions[:num_stops])\n    marker = np.full((MARKER_SIZE, MARKER_SIZE), GEN_PASS, dtype=int)\n    for j in stop_positions:\n        marker[MARKER_SIZE - 1, j] = GEN_STOP\n    grid[0:MARKER_SIZE, c0:c0 + MARKER_SIZE] = marker\n    obstacle_pixels: set[tuple[int, int]] = set()\n    for j in stop_positions:\n        col = c0 + j\n        first_obs_row = random.randint(MIN_STOP_OBSTACLE_ROW, H - 1)\n        grid[first_obs_row, col] = GEN_OBSTACLE\n        obstacle_pixels.add((first_obs_row, col))\n    return grid, c0, stop_positions, obstacle_pixels\n\n\ndef _forbidden_cells(H: int, c0: int, stop_positions: list[int], obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]]:\n    forbidden = {(r, c) for r in range(MARKER_SIZE) for c in range(c0, c0 + MARKER_SIZE)}\n    for j in stop_positions:\n        col = c0 + j\n        for r in range(MARKER_SIZE, H):\n            if (r, col) not in obstacle_pixels:\n                continue\n            for dr in range(1, DROP_ZONE_HEIGHT + 1):\n                if r - dr >= 0:\n                    forbidden.add((r - dr, col))\n            break\n    return forbidden\n\n\ndef _sample_component_sizes(total_pixels: int, component_count: int) -> list[int] | None:\n    component_sizes = []\n    left = total_pixels\n    min_size, max_size = COMPONENT_SIZE_RANGE\n    for i in range(component_count):\n        remaining = component_count - i - 1\n        if remaining == 0:\n            size = left\n        else:\n            lo = max(min_size, left - max_size * remaining)\n            hi = min(max_size, left - min_size * remaining)\n            if lo > hi:\n                return None\n            size = random.randint(lo, hi)\n        left -= size\n        if size < min_size or size > max_size:\n            return None\n        component_sizes.append(size)\n    random.shuffle(component_sizes)\n    return component_sizes\n\n\ndef _grow_component(grid: np.ndarray, comp_size: int, forbidden: set[tuple[int, int]],\n                    obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]] | None:\n    H, W = grid.shape\n    sr, sc = random.randint(0, H - 1), random.randint(0, W - 1)\n    if (sr, sc) in forbidden or (sr, sc) in obstacle_pixels or grid[sr, sc] != GEN_BG:\n        return None\n\n    comp = {(sr, sc)}\n    frontier = [(sr, sc)]\n    while len(comp) < comp_size and frontier:\n        random.shuffle(frontier)\n        expanded = False\n        for fr, fc in frontier:\n            nbrs = [(fr - 1, fc), (fr + 1, fc), (fr, fc - 1), (fr, fc + 1)]\n            random.shuffle(nbrs)\n            for nr, nc in nbrs:\n                if (0 <= nr < H and 0 <= nc < W\n                        and (nr, nc) not in forbidden\n                        and (nr, nc) not in obstacle_pixels\n                        and (nr, nc) not in comp\n                        and grid[nr, nc] == GEN_BG):\n                    comp.add((nr, nc))\n                    frontier.append((nr, nc))\n                    expanded = True\n                    break\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/fc4aaf52.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/fc4aaf52.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg\nimport random\n\n\ndef _swapped_values(values: np.ndarray, color_a: int, color_b: int) -> np.ndarray:\n    out = values.copy()\n    out[values == int(color_a)] = int(color_b)\n    out[values == int(color_b)] = int(color_a)\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Split the two-color object horizontally, swap its colors, and slide the upper half to the right.\n\n    Input structure:\n    - The grid has one background color and exactly two foreground colors.\n    - All foreground pixels form one 4-connected object with an even-height bbox.\n    - The object has foreground pixels on both rows adjacent to its horizontal midpoint.\n\n    Rule:\n    - Split the object into upper and lower halves at the midpoint of its bbox.\n    - Swap the two foreground colors in both halves.\n    - Keep the lower half in place and shift the upper half right until its lower-left\n      boundary pixel is diagonally adjacent to the lower half's upper-right boundary pixel.\n\n    Key insight:\n    - The object is not copied or reflected; it is broken at the horizontal waist,\n      recolored by exchanging the two visible object colors, then rejoined diagonally.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected exactly two foreground colors\"\n    color_a, color_b = colors\n\n    objects = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert len(objects) == 1, \"expected one connected foreground object\"\n    r0, _c0, r1, _c1 = objects[0][\"bbox\"]\n    height = int(r1 - r0 + 1)\n    assert height % 2 == 0, \"object bbox height must split evenly\"\n\n    split_row = int(r0 + height // 2)\n    row_ids = np.arange(g.shape[0])[:, None]\n    fg = g != int(bg)\n    upper = fg & (row_ids < split_row)\n    lower = fg & (row_ids >= split_row)\n    assert np.any(upper), \"expected a nonempty upper half\"\n    assert np.any(lower), \"expected a nonempty lower half\"\n    assert int(upper.sum()) == int(lower.sum()), \"expected equal upper and lower areas\"\n\n    upper_boundary_cols = np.flatnonzero(upper[split_row - 1])\n    lower_boundary_cols = np.flatnonzero(lower[split_row])\n    assert upper_boundary_cols.size > 0, \"upper half must touch the split boundary\"\n    assert lower_boundary_cols.size > 0, \"lower half must touch the split boundary\"\n\n    shift = int(lower_boundary_cols.max() + 1 - upper_boundary_cols.min())\n    assert shift > 0, \"upper half must shift right\"\n\n    upper_rows, upper_cols = np.where(upper)\n    lower_rows, lower_cols = np.where(lower)\n    shifted_upper_cols = upper_cols + shift\n    assert int(shifted_upper_cols.max()) < g.shape[1], \"shifted upper half must fit in the grid\"\n\n    out = np.full_like(g, int(bg))\n    out[lower_rows, lower_cols] = _swapped_values(g[lower_rows, lower_cols], color_a, color_b)\n    out[upper_rows, shifted_upper_cols] = _swapped_values(g[upper_rows, upper_cols], color_a, color_b)\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import paste as _gen_paste\n# Canvas and palette.\nGEN_BG, GEN_GRID_SIZE = 8, 16\nGEN_COLOR_POOL = [c for c in range(10) if c != GEN_BG]\n\n# Symmetric object shape.\nGEN_HALF_HEIGHTS, GEN_MAX_WIDTHS = [3, 4], [5, 7]\nGEN_MIN_ROW_WIDTH, GEN_WIDTH_STEP = 1, 2\nGEN_ROW_SWAP_PROB, GEN_ROW_SWAP_HEIGHT = 0.25, 4\nGEN_ROW_SWAP_INDICES = (1, 2)\n\n# Placement and validation.\nGEN_MARGIN, GEN_RETRIES = 1, 300\n\n\ndef _gen_fc4aaf52_swap(arr: np.ndarray, color_a: int, color_b: int) -> np.ndarray:\n    out = arr.copy()\n    out[arr == color_a] = color_b\n    out[arr == color_b] = color_a\n    return out\n\n\ndef _gen_fc4aaf52_upper(half_h: int, border_color: int, fill_color: int) -> np.ndarray:\n    max_w = random.choice(GEN_MAX_WIDTHS)\n    widths = [max_w]\n    for _ in range(half_h - 1):\n        prev_w = widths[-1]\n        widths.append(random.choice([max(GEN_MIN_ROW_WIDTH, prev_w - GEN_WIDTH_STEP), prev_w]))\n    widths = list(reversed(widths))\n    if random.random() < GEN_ROW_SWAP_PROB and half_h == GEN_ROW_SWAP_HEIGHT:\n        i, j = GEN_ROW_SWAP_INDICES\n        widths[i], widths[j] = widths[j], widths[i]\n\n    bottom_lefts = [0]\n    bottom_widths = list(reversed(widths))\n    for i, width in enumerate(bottom_widths[1:], start=1):\n        prev_l = bottom_lefts[-1]\n        prev_r = prev_l + bottom_widths[i - 1] - 1\n        choices = [left for left in range(max_w - width + 1) if max(left, prev_l) <= min(left + width - 1, prev_r)]\n        bottom_lefts.append(random.choice(choices))\n    lefts = list(reversed(bottom_lefts))\n\n    upper = np.full((half_h, max_w), GEN_BG, dtype=int)\n    for r, (left, width) in enumerate(zip(lefts, widths)):\n        right = left + width\n        upper[r, left:right] = fill_color\n        upper[r, left] = border_color\n        upper[r, right - 1] = border_color\n    return upper\n\n\ndef _gen_fc4aaf52_placement(obj_h: int, obj_w: int, shift: int) -> tuple[int, int] | None:\n    max_row = GEN_GRID_SIZE - GEN_MARGIN - obj_h\n    max_col = GEN_GRID_SIZE - GEN_MARGIN - obj_w - shift\n    return None if max_col < 0 else (random.randint(GEN_MARGIN, max_row), random.randint(GEN_MARGIN, max_col))\n\n\ndef _gen_fc4aaf52_render(upper, lower, row, col, shift, border_color, fill_color, *, swapped):\n    out = np.full((GEN_GRID_SIZE, GEN_GRID_SIZE), GEN_BG, dtype=int)\n    upper_col = col\n    if swapped:\n        upper = _gen_fc4aaf52_swap(upper, border_color, fill_color)\n        lower = _gen_fc4aaf52_swap(lower, border_color, fill_color)\n        upper_col += shift\n    _gen_paste(out, upper, row, upper_col, transparent=GEN_BG)\n    _gen_paste(out, lower, row + upper.shape[0], col, transparent=GEN_BG)\n    return out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    border_color, fill_color = random.sample(GEN_COLOR_POOL, 2)\n    half_h = random.choice(GEN_HALF_HEIGHTS)\n    upper_in = _gen_fc4aaf52_upper(half_h, border_color, fill_color)\n    lower_in = np.flipud(upper_in)\n\n    obj_h, obj_w = half_h * 2, upper_in.shape[1]\n    shift = int(np.count_nonzero(upper_in[-1] != GEN_BG))\n    placement = _gen_fc4aaf52_placement(obj_h, obj_w, shift)\n    if placement is None:\n        return None\n    obj_row, obj_col = placement\n\n    expected = _gen_fc4aaf52_render(upper_in, lower_in, obj_row, obj_col, shift, border_color, fill_color, swapped=True)\n    inp = _gen_fc4aaf52_render(upper_in, lower_in, obj_row, obj_col, shift, border_color, fill_color, swapped=False)\n\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid fc4aaf52 input\")\n","exit_code":0,"status":"completed"}}
