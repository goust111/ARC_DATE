{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nfrom collections import defaultdict\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed56627177/4/3.py')\nmod = SourceFileLoader('new_arc_task_sem', str(p)).load_module()\nfor i in range(30):\n    g = mod.generate_input()\n    colors = set(np.unique(g))\n    assert {mod.RED, mod.BLUE, mod.GREEN, mod.GREY}.issubset(colors)\n    grey = mod._components(g == mod.GREY, connectivity=8)\n    cell_to_obj = {}\n    for idx, comp in enumerate(grey):\n        for cell in comp:\n            cell_to_obj[cell] = idx\n    arrows_by_object = defaultdict(int)\n    for color in [mod.RED, mod.BLUE, mod.GREEN]:\n        for comp in mod._components(g == color, connectivity=8):\n            tip, dir_name = mod._decode_arrow(comp)\n            dr, dc = mod.DIR_VECS[dir_name]\n            r, c = tip\n            while True:\n                r += dr\n                c += dc\n                if g[r, c] == mod.BLACK:\n                    continue\n                arrows_by_object[cell_to_obj[(r, c)]] += 1\n                break\n    assert max(arrows_by_object.values()) >= 2\nprint('semantic checks passed')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
