{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport ast\nfrom pathlib import Path\nfiles = [\n    Path('/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py'),\n    Path('/home/lixinyu/snap/new/ARC_code/train/ba1aa698.py'),\n]\nfor path in files:\n    print(f'===== {path} =====')\n    src = path.read_text()\n    mod = ast.parse(src)\n    lines = src.splitlines()\n    for node in mod.body:\n        if isinstance(node, ast.FunctionDef) and node.name in {'main', 'generate_input'}:\n            print(f'--- {node.name} ---')\n            start = node.lineno\n            end = node.end_lineno\n            for i in range(start, end + 1):\n                print(lines[i-1])\n            print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport ast\nfrom pathlib import Path\nfiles = [\n    Path('/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py'),\n    Path('/home/lixinyu/snap/new/ARC_code/train/ba1aa698.py'),\n]\nfor path in files:\n    print(f'===== {path} =====')\n    src = path.read_text()\n    mod = ast.parse(src)\n    lines = src.splitlines()\n    for node in mod.body:\n        if isinstance(node, ast.FunctionDef) and node.name in {'main', 'generate_input'}:\n            print(f'--- {node.name} ---')\n            start = node.lineno\n            end = node.end_lineno\n            for i in range(start, end + 1):\n                print(lines[i-1])\n            print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py =====\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exhausted attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/ba1aa698.py =====\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Extrapolate the moving sprite from a horizontal sequence of shared-border frames into the next standalone frame.\n\n    Input structure\n    - The grid is a row of equal-width framed panels sharing their vertical border columns.\n    - Each panel has the same fill color and one identical interior sprite at the same local columns.\n    - The sprite's top row changes by a constant amount from panel to panel.\n\n    Rule\n    - Build one output panel with the same height, frame color, fill color, and sprite.\n    - Continue the sprite's diagonal motion one more panel to the right.\n    - Because the output is a standalone panel, advance by the full panel width, not the shared-border spacing.\n\n    Key insight\n    - The panels are consecutive frames of motion; the output is the next frame after the sequence.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    frame = int(g[0, 0])\n    assert h >= 3 and w >= 3\n    assert np.all(g[0, :] == frame)\n    assert np.all(g[-1, :] == frame)\n\n    separators = [c for c in range(w) if np.all(g[:, c] == frame)]\n    assert len(separators) >= 3\n    assert separators[0] == 0 and separators[-1] == w - 1\n    strides = [b - a for a, b in zip(separators, separators[1:])]\n    assert len(set(strides)) == 1\n    stride = strides[0]\n    panel_w = stride + 1\n\n    interior_values = []\n    for c0, c1 in zip(separators, separators[1:]):\n        interior_values.extend(g[1:-1, c0 + 1 : c1].ravel())\n    fill = _unique_most_common(interior_values)\n\n    panels = []\n    for c0, c1 in zip(separators, separators[1:]):\n        panel = g[:, c0 : c1 + 1]\n        assert panel.shape == (h, panel_w)\n        assert np.all(panel[0, :] == frame)\n        assert np.all(panel[-1, :] == frame)\n        assert np.all(panel[:, 0] == frame)\n        assert np.all(panel[:, -1] == frame)\n        panels.append(panel)\n\n    template_sprite, template_mask, first_top, template_left = _extract_sprite(panels[0], fill)\n    top_rows = [first_top]\n    for panel in panels[1:]:\n        sprite, sprite_mask, top, local_c0 = _extract_sprite(panel, fill)\n        assert local_c0 == template_left\n        assert sprite_mask.shape == template_mask.shape\n        assert np.array_equal(sprite_mask, template_mask)\n        assert np.array_equal(sprite[sprite_mask], template_sprite[template_mask])\n        top_rows.append(top)\n\n    deltas = [b - a for a, b in zip(top_rows, top_rows[1:])]\n    assert len(deltas) >= 1 and len(set(deltas)) == 1\n    next_top = _round_half_up(\n        Fraction(top_rows[-1], 1) + Fraction(deltas[0] * panel_w, stride)\n    )\n\n    sprite_h, sprite_w = template_sprite.shape\n    assert 1 <= next_top and next_top + sprite_h <= h - 1\n    assert 1 <= template_left and template_left + sprite_w <= panel_w - 1\n\n    out = np.full((h, panel_w), fill, dtype=int)\n    out[0, :] = frame\n    out[-1, :] = frame\n    out[:, 0] = frame\n    out[:, -1] = frame\n\n    target = out[next_top : next_top + sprite_h, template_left : template_left + sprite_w]\n    target[template_mask] = template_sprite[template_mask]\n    return out\n\n--- generate_input ---\ndef generate_input():\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid ba1aa698 input\")\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport ast\nfrom pathlib import Path\nfiles = [\n    Path('/home/lixinyu/snap/new/ARC_code/train/bd283c4a.py'),\n    Path('/home/lixinyu/snap/new/ARC_code/eval/7491f3cf.py'),\n]\nfor path in files:\n    print(f'===== {path} =====')\n    src = path.read_text()\n    mod = ast.parse(src)\n    lines = src.splitlines()\n    for node in mod.body:\n        if isinstance(node, ast.FunctionDef) and node.name in {'main', 'generate_input'}:\n            print(f'--- {node.name} ---')\n            start = node.lineno\n            end = node.end_lineno\n            for i in range(start, end + 1):\n                print(lines[i-1])\n            print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport ast\nfrom pathlib import Path\nfiles = [\n    Path('/home/lixinyu/snap/new/ARC_code/train/bd283c4a.py'),\n    Path('/home/lixinyu/snap/new/ARC_code/eval/7491f3cf.py'),\n]\nfor path in files:\n    print(f'===== {path} =====')\n    src = path.read_text()\n    mod = ast.parse(src)\n    lines = src.splitlines()\n    for node in mod.body:\n        if isinstance(node, ast.FunctionDef) and node.name in {'main', 'generate_input'}:\n            print(f'--- {node.name} ---')\n            start = node.lineno\n            end = node.end_lineno\n            for i in range(start, end + 1):\n                print(lines[i-1])\n            print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/train/bd283c4a.py =====\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Pack all pixels into color-frequency runs along bottom-up columns.\n\n    Input structure\n    The input is a rectangular grid whose colors are all foreground material;\n    only the number of pixels of each color matters. In the observed task\n    instances, every present color has a distinct pixel count.\n\n    Rule\n    Count the pixels of each color and order the colors from most frequent to\n    least frequent. Rewrite a same-size grid by placing each color's full count\n    as one contiguous run while scanning columns from left to right and, within\n    each column, from bottom to top.\n\n    Key insight\n    The output preserves the multiset of colors but discards all original\n    positions, turning the grid into a frequency-sorted column packing.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    counts = Counter(map(int, g.ravel()))\n    assert len(set(counts.values())) == len(counts), \"color counts must have a unique rank\"\n\n    colors = sorted(counts, key=lambda color: -counts[color])\n    out = np.empty_like(g)\n    height, width = g.shape\n\n    scan = ((r, c) for c in range(width) for r in range(height - 1, -1, -1))\n    for color in colors:\n        for _ in range(counts[color]):\n            r, c = next(scan)\n            out[r, c] = color\n\n    return out\n\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            try:\n                out = main(result)\n            except Exception:\n                continue\n            if out is not None:\n                return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/7491f3cf.py =====\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Composite two pattern tiles into a fourth panel using flood-fill from an indicator pixel.\n\n    Input structure:\n    - Four 5×5 panels in one row, border-separated.\n    - Panel 0: cue pixels = wall boundary (8-connected, edge-to-edge, through center)\n               + one 8-isolated indicator pixel.\n    - Panels 1–2: source patterns. Panel 3: blank (to fill).\n\n    Rule:\n    - Flood-fill (4-conn) from indicator, blocked by wall → inside region.\n    - Inside → non-bg from panel 1; outside → non-bg from panel 2.\n    - Wall → panel 1 if non-bg; panel 2 fallback when wall is 4-connected.\n\n    Key insight: The cue panel's isolated indicator and wall partition the tile into inside/outside masks that select between the two source panels.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n\n    border = int(g[0, 0])\n    tiles = [g[1:6, 1 + 6 * j : 1 + 6 * j + 5].copy() for j in range(4)]\n    t0, t1, t2, _t3 = tiles\n    b = int(Counter(t1.flatten()).most_common(1)[0][0])\n    assert border != b, \"border color must differ from tile background\"\n\n    t0_bg = int(Counter(t0.flatten()).most_common(1)[0][0])\n    cue_set = {(int(r), int(c)) for r in range(5) for c in range(5) if int(t0[r, c]) != t0_bg}\n    assert cue_set, \"no cue pixels found\"\n\n    # --- Indicator = the unique 8-isolated cue pixel ---\n    indicator = None\n    for r, c in cue_set:\n        if not any((nr, nc) in cue_set for nr, nc in neighbors8(r, c)):\n            assert indicator is None, \"multiple 8-isolated cue pixels\"\n            indicator = (r, c)\n    assert indicator is not None, \"no 8-isolated cue pixel found\"\n\n    # Indicator must sit at a tile corner or edge midpoint\n    valid_pos = {(0,0),(0,4),(4,0),(4,4),(0,2),(2,0),(2,4),(4,2)}\n    assert indicator in valid_pos, f\"indicator {indicator} not at corner/edge-midpoint\"\n\n    wall = cue_set - {indicator}\n\n    # --- Structural assertions (feedback for generate_input agents) ---\n    assert (2, 2) in wall, \"wall must pass through the grid center (2,2)\"\n\n    # Wall must be symmetric about the line from indicator to center (2,2)\n    ir, ic = indicator\n    dr, dc = 2 - ir, 2 - ic\n    if dr == 0:\n        _refl = lambda r, c: (4 - r, c)\n    elif dc == 0:\n        _refl = lambda r, c: (r, 4 - c)\n    elif dr * dc > 0:\n        _refl = lambda r, c: (c, r)\n    else:\n        _refl = lambda r, c: (4 - c, 4 - r)\n    assert wall == {_refl(r, c) for r, c in wall}, \"wall must be symmetric about indicator→center axis\"\n\n    sides_touched = set()\n    for r, c in wall:\n        if r == 0: sides_touched.add(\"top\")\n        if r == 4: sides_touched.add(\"bottom\")\n        if c == 0: sides_touched.add(\"left\")\n        if c == 4: sides_touched.add(\"right\")\n    assert len(sides_touched) >= 2, f\"wall must span edge-to-edge, only touches {sides_touched}\"\n\n    # --- Flood fill inside region ---\n    EMPTY, WALL, INSIDE = 0, 1, 2\n    tmp = np.zeros((5, 5), dtype=int)\n    for r, c in wall:\n        tmp[r, c] = WALL\n    flood_fill(tmp, indicator[0], indicator[1], INSIDE, connectivity=4)\n    inside = {(int(r), int(c)) for r, c in np.argwhere(tmp == INSIDE)}\n\n    outside = {(r, c) for r in range(5) for c in range(5)} - inside - wall\n    assert outside, \"wall must partition the grid — outside region is empty\"\n\n    # Wall 4-connectivity determines boundary blending behavior:\n    # axis-aligned walls (4-connected) allow t2 fallback; diagonal walls don't.\n    wall_mask = np.zeros((5, 5), dtype=bool)\n    for r, c in wall:\n        wall_mask[r, c] = True\n    _, n_comp = label_mask(wall_mask, connectivity=4)\n    wall_4conn = (n_comp == 1)\n\n    # --- Build output tile ---\n    out3 = np.full((5, 5), b, dtype=int)\n    for r in range(5):\n        for c in range(5):\n            v1, v2 = int(t1[r, c]), int(t2[r, c])\n            if (r, c) in inside:\n                if v1 != b:\n                    out3[r, c] = v1\n            elif (r, c) in wall:\n                if v1 != b:\n                    out3[r, c] = v1\n                elif wall_4conn and v2 != b:\n                    out3[r, c] = v2\n            else:\n                if v2 != b:\n                    out3[r, c] = v2\n\n    out = g.copy()\n    out[1:6, 1 + 6 * 3 : 1 + 6 * 3 + 5] = out3\n    return out\n\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(f\"generate_input failed after {GEN_RETRIES} attempts\")\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport ast\nfrom pathlib import Path\nfiles = [\n    Path('/home/lixinyu/snap/new/ARC_code/train/34cfa167.py'),\n    Path('/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py'),\n]\nfor path in files:\n    print(f'===== {path} =====')\n    src = path.read_text()\n    mod = ast.parse(src)\n    lines = src.splitlines()\n    for node in mod.body:\n        if isinstance(node, ast.FunctionDef) and node.name in {'main', 'generate_input'}:\n            print(f'--- {node.name} ---')\n            start = node.lineno\n            end = node.end_lineno\n            for i in range(start, end + 1):\n                print(lines[i-1])\n            print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport ast\nfrom pathlib import Path\nfiles = [\n    Path('/home/lixinyu/snap/new/ARC_code/train/34cfa167.py'),\n    Path('/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py'),\n]\nfor path in files:\n    print(f'===== {path} =====')\n    src = path.read_text()\n    mod = ast.parse(src)\n    lines = src.splitlines()\n    for node in mod.body:\n        if isinstance(node, ast.FunctionDef) and node.name in {'main', 'generate_input'}:\n            print(f'--- {node.name} ---')\n            start = node.lineno\n            end = node.end_lineno\n            for i in range(start, end + 1):\n                print(lines[i-1])\n            print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/train/34cfa167.py =====\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.\n\n    Input structure:\n    - The background is the dominant color.\n    - Two same-color solid rectangular anchors of the same size sit on opposite\n      diagonal corners, with the first anchor above-left of the second.\n    - The upper-left anchor has two one-cell-thick vertical control bars to its\n      right and two one-cell-thick horizontal control bars below it.\n\n    Rule:\n    - Copy the anchor rectangle into the two missing corners of the implied\n      larger rectangle.\n    - Repeat the right-side control bars horizontally between the left and right\n      anchors, using their spacing as the period, and draw the outer top and\n      bottom borders in the first right-control color.\n    - Repeat the below-side control bars vertically between the top and bottom\n      anchors, using the same period, and draw the outer left and right borders\n      in the first below-control color.\n\n    Key insight: The small control bars are the first two ticks of two periodic\n    frame patterns; the diagonal anchor supplies the opposite corner and the\n    missing two anchor copies.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    source, dest, right_controls, below_controls = _find_structure(g, bg)\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    dr0, dc0, dr1, dc1 = dest[\"bbox\"]\n    anchor_color = int(source[\"color\"])\n    assert int(dest[\"color\"]) == anchor_color, \"anchor colors must match\"\n    assert bbox_h(source[\"bbox\"]) == bbox_h(dest[\"bbox\"]), \"anchor heights must match\"\n    assert bbox_w(source[\"bbox\"]) == bbox_w(dest[\"bbox\"]), \"anchor widths must match\"\n    assert sr0 > 0 and sc0 > 0, \"upper-left anchor must have space for outer frame\"\n    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \"lower-right anchor must have space for outer frame\"\n\n    right_offsets = [int(comp[\"bbox\"][1] - sc1) for comp in right_controls]\n    below_offsets = [int(comp[\"bbox\"][0] - sr1) for comp in below_controls]\n    assert right_offsets == below_offsets and right_offsets[0] == 1, \"control offsets must match from the anchor edge\"\n    step = int(right_offsets[1] - right_offsets[0])\n    assert step > 0, \"control bars must be separated\"\n    period = 2 * step\n    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, \"right frame must close next to the destination anchor\"\n    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, \"below frame must close next to the destination anchor\"\n\n    right_colors = [int(comp[\"color\"]) for comp in right_controls]\n    below_colors = [int(comp[\"color\"]) for comp in below_controls]\n    out = g.copy()\n\n    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)\n    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)\n\n    first_c = int(sc1 + right_offsets[0])\n    last_c = int(dc0 - 1)\n    for c in range(first_c, last_c + 1):\n        offset = int(c - sc1)\n        if (offset - right_offsets[0]) % period == 0:\n            color = right_colors[0]\n        elif (offset - right_offsets[1]) % period == 0:\n            color = right_colors[1]\n        else:\n            continue\n        _paint_rect(out, bg, sr0, c, sr1, c, color)\n        _paint_rect(out, bg, dr0, c, dr1, c, color)\n\n    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])\n    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])\n\n    first_r = int(sr1 + below_offsets[0])\n    last_r = int(dr0 - 1)\n    left_c = int(sc0 - 1)\n    right_c = int(dc1 + 1)\n    for r in range(first_r, last_r + 1):\n        _paint(out, bg, r, left_c, below_colors[0])\n        _paint(out, bg, r, right_c, below_colors[0])\n\n        offset = int(r - sr1)\n        if (offset - below_offsets[0]) % period == 0:\n            _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])\n            _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])\n        elif (offset - below_offsets[1]) % period == 0:\n            _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])\n            _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])\n\n    return out\n\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/58490d8a.py =====\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count colored objects and record tallies inside a legend box.\n\n    Input structure:\n    - A black rectangular legend box with key-color pixels in its leftmost non-black column.\n    - Outside the box, distinct objects of each key color are scattered across the grid.\n\n    Rule:\n    - For each key color, count separate same-colored objects outside the legend box.\n    - Output the legend box repainted: each key row gets one dot per object, spaced every other cell rightward from the key pixel.\n\n    Key insight: The legend is both the color index and the output canvas — object counts become dot sequences on the matching row.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    _bg = int(get_bg(g))\n\n    black = 0\n\n    # STEP 1) Find the legend bbox: largest black CC whose bbox contains some non-black pixels.\n    best = None  # (area, bbox)\n    for coords in components_mask(g == int(black), connectivity=8):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if (sub != int(black)).any():\n            area = int(coords.shape[0])\n            cand = (area, tuple(map(int, b)))\n            if best is None or cand[0] > best[0]:\n                best = cand\n\n    assert not (best is None)\n\n    r0, c0, r1, c1 = map(int, best[1])\n    box = crop_bbox(g, (r0, c0, r1, c1))\n    bh, bw = map(int, box.shape)\n\n    # STEP 2) Inside the legend bbox, find the key column:\n    # leftmost column with any non-black pixels (the \"key pixels\").\n    key_col = None\n    for cc in range(bw):\n        if (box[:, int(cc)] != int(black)).any():\n            key_col = int(cc)\n            break\n    if key_col is None:\n        return np.zeros_like(box)\n\n    keys = [(int(rr), int(box[int(rr), int(key_col)])) for rr in range(bh) if int(box[int(rr), int(key_col)]) != int(black)]\n    keys.sort(key=lambda t: int(t[0]))\n\n    outside = np.ones((H, W), dtype=bool)\n    outside[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = False\n    out = np.zeros((bh, bw), dtype=int)\n\n    # STEP 3/4) Count CCs of each key color outside the legend, then draw 1 dot per CC.\n    for rr, col in keys:\n        mask = (g == int(col)) & outside\n        _labc, nc = label_mask(mask, connectivity=8)\n        for i in range(int(nc)):\n            cc = int(key_col + 2 * i)\n            if 0 <= cc < bw:\n                out[int(rr), int(cc)] = int(col)\n\n    return out\n\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 58490d8a input\")\n\n","exit_code":0,"status":"completed"}}
