{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/3dc255db.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import bbox_coords, colors_present, components_mask, get_bg\nfrom scipy import ndimage\n\n\ndef _flood_from_bbox_side(border_set: set, bbox: tuple, side: str) -> set:\n    \"\"\"4-conn flood within bbox, seeded from non-border cells on the given bbox edge,\n    stopping at border cells. Returns the set of reached cells (includes seeds).\"\"\"\n    r0, c0, r1, c1 = bbox\n    if side == \"U\":\n        seeds = [(r0, c) for c in range(c0, c1 + 1) if (r0, c) not in border_set]\n    elif side == \"D\":\n        seeds = [(r1, c) for c in range(c0, c1 + 1) if (r1, c) not in border_set]\n    elif side == \"L\":\n        seeds = [(r, c0) for r in range(r0, r1 + 1) if (r, c0) not in border_set]\n    else:  # \"R\"\n        seeds = [(r, c1) for r in range(r0, r1 + 1) if (r, c1) not in border_set]\n\n    visited = set(seeds)\n    stack = list(seeds)\n    while stack:\n        r, c = stack.pop()\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nr, nc = r + dr, c + dc\n            if not (r0 <= nr <= r1 and c0 <= nc <= c1):\n                continue\n            if (nr, nc) in visited or (nr, nc) in border_set:\n                continue\n            visited.add((nr, nc))\n            stack.append((nr, nc))\n    return visited\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Eject content pixels from cup-shaped frames outward along each cup's tail direction.\n\n    Input structure:\n    - bg = background. Hollow cup/Y/funnel frames, each a unique border color.\n    - Each cup has a convergent tail spike on one side and an open mouth on the opposite side.\n    - Content pixels (a single non-border color per cup) sit inside the cup's mouth interior.\n\n    Rule:\n    - For each cup, identify its tail spike and tail direction.\n    - Erase all content pixels from the mouth interior.\n    - Draw a straight line of content-colored pixels from the spike outward in the tail direction,\n      one pixel per erased content pixel; cells beyond the grid edge are dropped.\n\n    Key insight: The tail spike is the unique convergent point whose outward direction is opposite\n    the mouth opening where the content lives.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n    out = g.copy()\n\n    DIR4 = {\"U\": (-1, 0), \"D\": (1, 0), \"L\": (0, -1), \"R\": (0, 1)}\n    OPPOSITE = {\"U\": \"D\", \"D\": \"U\", \"L\": \"R\", \"R\": \"L\"}\n\n    for border_col in colors_present(g, exclude={bg}):\n        for border_coords in components_mask(g == int(border_col), connectivity=8):\n            if border_coords.size == 0 or int(border_coords.shape[0]) < 5:\n                continue\n\n            r0, c0, r1, c1 = (int(v) for v in bbox_coords(border_coords))\n            bbox = (r0, c0, r1, c1)\n            border_set = {(int(r), int(c)) for r, c in border_coords}\n            corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}\n\n            # Candidate tail spikes: single border cell on a bbox edge, not at a corner.\n            edges = (\n                (\"U\", [p for p in border_set if p[0] == r0]),\n                (\"D\", [p for p in border_set if p[0] == r1]),\n                (\"L\", [p for p in border_set if p[1] == c0]),\n                (\"R\", [p for p in border_set if p[1] == c1]),\n            )\n            candidates = [\n                (d, cells[0]) for d, cells in edges\n                if len(cells) == 1 and cells[0] not in corners\n            ]\n            if not candidates:\n                continue\n\n            # Each candidate: flood from opposite bbox side; keep candidates whose flood\n            # reaches content (non-bg, non-border) cells.\n            passing = []\n            for d, spike in candidates:\n                mouth = _flood_from_bbox_side(border_set, bbox, OPPOSITE[d])\n                cnt = Counter()\n                for r, c in mouth:\n                    v = int(g[r, c])\n                    if v != bg and v != int(border_col):\n                        cnt[v] += 1\n                if not cnt:\n                    continue\n                content_col = int(cnt.most_common(1)[0][0])\n                content_cells = [p for p in mouth if int(g[p[0], p[1]]) == content_col]\n                passing.append((d, spike, content_col, content_cells))\n\n            # Only act on cups with an unambiguous tail.\n            if len(passing) != 1:\n                continue\n            tail_dir, spike, content_col, content_cells = passing[0]\n\n            # Erase content, then eject outward.\n            for r, c in content_cells:\n                out[r, c] = bg\n\n            dr, dc = DIR4[tail_dir]\n            sr, sc = spike\n            for t in range(1, len(content_cells) + 1):\n                rr = sr + dr * t\n                cc = sc + dc * t\n                if not (0 <= rr < H and 0 <= cc < W):\n                    break\n                out[rr, cc] = content_col\n\n    return out\n\n# --------------- generator (claude opus) ---------------\n\n# ==== Generator configuration ====\n# Canvas size bounds (inclusive)\nGRID_H_RANGE = (10, 13)\nGRID_W_RANGE = (10, 13)\n\n# Number of cups per grid (choices sampled uniformly)\nNUM_CUPS_CHOICES = (1, 2, 3)\n\n# Cup bbox bounds for the canonical (tail=U) patch.\n# After rotation to L/R the axes swap, so both orientations must fit spec bbox 3..8 rows x 3..7 cols.\nCUP_BBOX_MAX_UD = (8, 7)  # (max_h, max_w) when tail is U or D\nCUP_BBOX_MAX_LR = (7, 8)  # (max_h, max_w) when tail is L or R\n\n# Arm-length ranges for the canonical Y/funnel (inclusive)\nARM_LEN_RANGE = (1, 3)        # L and R diagonal arm length\nWALL_EXT_RANGE = (0, 4)       # hL / hR (extra vertical wall cells after arm touches side)\n\n# Content pixel count cap (per cup)\nCONTENT_COUNT_MAX = 7\n\n# Stray-pixel probability and color choice probability (border vs content)\nSTRAY_PROB = 0.4\nSTRAY_USE_BORDER_PROB = 0.5\n\n# Retry budgets\nGEN_RETRIES_PRIMARY = 300     # retries that honor a pre-chosen num_cups\nGEN_RETRIES_FALLBACK = 300    # fallback retries with random num_cups\n# ==================================\n\nDIR4 = {\"U\": (-1, 0), \"D\": (1, 0), \"L\": (0, -1), \"R\": (0, 1)}\n_STRUCT8 = np.ones((3, 3), dtype=bool)\n\n\ndef _build_canonical_cup(L: int, R: int, hL: int, hR: int, color: int) -> tuple[np.ndarray, tuple[int, int]]:\n    \"\"\"Build a Y/funnel cup with tail pointing UP (spike at top, row 0).\n\n    Left arm is a diagonal of length L going down-left; right arm length R down-right.\n    After the left arm reaches col 0 (at row L), the left wall continues for hL more rows.\n    Likewise the right wall continues for hR rows after its arm reaches col L+R.\n    Requires hL + hR >= 1 so the bbox has enough vertical extent for a mouth.\n    Returns (patch, spike_rc); bg in patch is 0.\"\"\"\n    assert L >= 1 and R >= 1 and hL >= 0 and hR >= 0 and (hL + hR) >= 1\n    w = L + R + 1\n    h = max(L + hL, R + hR) + 1\n    g = np.zeros((h, w), dtype=int)\n    g[0, L] = color                                   # spike\n    g[np.arange(1, L + 1), L - np.arange(1, L + 1)] = color   # left arm\n    g[np.arange(1, R + 1), L + np.arange(1, R + 1)] = color   # right arm\n    if hL:\n        g[L + 1:L + hL + 1, 0] = color                # left wall\n    if hR:\n        g[R + 1:R + hR + 1, w - 1] = color            # right wall\n    return g, (0, L)\n\n\ndef _mouth_interior_coords(patch: np.ndarray, border_color: int, opposite_side: str) -> list[tuple[int, int]]:\n    \"\"\"Flood-fill the interior of the cup patch from cells on the given bbox edge, stopping at\n    the border. Returns the sorted list of interior coordinates (seeds included).\"\"\"\n    h, w = patch.shape\n    border_mask = (patch == border_color)\n    if opposite_side == \"U\":\n        seeds = [(0, c) for c in range(w) if not border_mask[0, c]]\n    elif opposite_side == \"D\":\n        seeds = [(h - 1, c) for c in range(w) if not border_mask[h - 1, c]]\n    elif opposite_side == \"L\":\n        seeds = [(r, 0) for r in range(h) if not border_mask[r, 0]]\n    else:  # \"R\"\n        seeds = [(r, w - 1) for r in range(h) if not border_mask[r, w - 1]]\n    visited = set(seeds)\n    stack = list(seeds)\n    while stack:\n        r, c = stack.pop()\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited and not border_mask[nr, nc]:\n                visited.add((nr, nc))\n                stack.append((nr, nc))\n    return sorted(visited)\n\n\ndef _rotate_to_direction(\n    patch: np.ndarray, spike: tuple[int, int], mouth: list[tuple[int, int]], direction: str,\n) -> tuple[np.ndarray, tuple[int, int], list[tuple[int, int]]]:\n    \"\"\"Rotate a canonical (tail=U) patch, its spike and mouth coords to the target tail direction.\"\"\"\n    h, w = patch.shape\n    sr, sc = spike\n    if direction == \"U\":\n        return patch.copy(), (sr, sc), list(mouth)\n    if direction == \"D\":\n        return np.flipud(patch).copy(), (h - 1 - sr, sc), [(h - 1 - r, c) for (r, c) in mouth]\n    if direction == \"L\":\n        # rot90 k=1 (CCW): old (r, c) -> new (w-1-c, r)\n        return np.rot90(patch, k=1).copy(), (w - 1 - sc, sr), [(w - 1 - c, r) for (r, c) in mouth]\n    if direction == \"R\":\n        # rot90 k=-1 (CW): old (r, c) -> new (c, h-1-r)\n        return np.rot90(patch, k=-1).copy(), (sc, h - 1 - sr), [(c, h - 1 - r) for (r, c) in mouth]\n    raise ValueError(direction)\n\n\ndef _sample_cup_shape(rng: np.random.Generator, direction: str) -> tuple[int, int, int, int] | None:\n    \"\"\"Pick (L, R, hL, hR) parameters for a canonical cup, clamped so the patch fits the\n    task's bbox spec after rotation. Returns None if no feasible shape could be derived.\"\"\"\n    if direction in (\"U\", \"D\"):\n        max_h_canon, max_w_canon = CUP_BBOX_MAX_UD\n    else:\n        max_h_canon, max_w_canon = CUP_BBOX_MAX_LR\n\n    lo, hi = ARM_LEN_RANGE\n    L_arm = int(rng.integers(lo, hi + 1))\n    R_arm = int(rng.integers(lo, hi + 1))\n    while L_arm + R_arm + 1 > max_w_canon:\n        if L_arm >= R_arm:\n            L_arm -= 1\n        else:\n            R_arm -= 1\n\n    wlo, whi = WALL_EXT_RANGE\n    hL = int(rng.integers(wlo, whi + 1))\n    hR = int(rng.integers(wlo, whi + 1))\n    if hL + hR == 0:\n        hL = 1\n    while max(L_arm + hL, R_arm + hR) + 1 > max_h_canon:\n        if L_arm + hL >= R_arm + hR and hL > 0:\n            hL -= 1\n        elif hR > 0:\n            hR -= 1\n        else:\n            break\n    if hL + hR == 0:\n        return None\n    return L_arm, R_arm, hL, hR\n\n\ndef _try_place_cup(\n    rng: np.random.Generator, H: int, W: int, patch: np.ndarray, spike: tuple[int, int],\n    direction: str, content_count: int, occ_cup: np.ndarray, occ_path: np.ndarray,\n) -> tuple[int, int, list[tuple[int, int]], list[tuple[int, int]]] | None:\n","exit_code":0,"status":"completed"}}
