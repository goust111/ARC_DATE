{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/902510d5.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _corner_distances(shape: tuple[int, int], corner: str, r: int, c: int) -> tuple[int, int]:\n    H, W = shape\n    if corner == \"TL\":\n        return int(r), int(c)\n    if corner == \"TR\":\n        return int(r), int(W - 1 - c)\n    if corner == \"BL\":\n        return int(H - 1 - r), int(c)\n    assert corner == \"BR\"\n    return int(H - 1 - r), int(W - 1 - c)\n\n\ndef _paint_corner_triangle(out: np.ndarray, corner: str, side: int, color: int) -> None:\n    H, W = out.shape\n    assert side > 0, \"triangle side length must be positive\"\n    for r in range(H):\n        for c in range(W):\n            a, b = _corner_distances((H, W), corner, r, c)\n            if a + b < side:\n                out[r, c] = int(color)\n\n\ndef _diagonal_direction(coords: set[tuple[int, int]]) -> str | None:\n    r0 = min(r for r, _ in coords)\n    r1 = max(r for r, _ in coords)\n    c0 = min(c for _, c in coords)\n    c1 = max(c for _, c in coords)\n    height = r1 - r0 + 1\n    width = c1 - c0 + 1\n    if height != width:\n        return None\n    n = height\n    local = {(r - r0, c - c0) for r, c in coords}\n    main_ok = all((c, r) in local for r, c in local)\n    anti_ok = all((n - 1 - c, n - 1 - r) in local for r, c in local)\n    if main_ok:\n        if (0, 0) in local and (n - 1, n - 1) not in local:\n            return \"TL\"\n        if (n - 1, n - 1) in local and (0, 0) not in local:\n            return \"BR\"\n    if anti_ok:\n        if (0, n - 1) in local and (n - 1, 0) not in local:\n            return \"TR\"\n        if (n - 1, 0) in local and (0, n - 1) not in local:\n            return \"BL\"\n    return None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Keep the largest 8-connected motif and replace the corner/control pixels with a solid corner triangle.\n\n    Input structure\n    - The background is the dominant color.\n    - Exactly one grid corner contains a foreground control pixel; it gives the\n      corner from which the triangle is painted.\n    - There is one unique largest 8-connected monochrome foreground object, the\n      motif that remains in the output; all other foreground pixels are controls.\n    - Every foreground component outside that motif is a singleton control pixel.\n    - The fill color is the unique control color that appears in at least two\n      non-corner control pixels.\n\n    Rule\n    - Start from a blank background canvas and redraw only the largest motif.\n    - Count the non-corner control pixels; that count is the triangle side.\n    - Paint the fill color on the right-triangle region where those two distances\n      from the marked corner's edges sum to less than the side length.\n\n    Key insight\n    - The scattered singleton controls are counted into a compact triangular\n      stack at the marked corner; only the largest motif is not part of the count.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    corners = {\n        \"TL\": (0, 0),\n        \"TR\": (0, W - 1),\n        \"BL\": (H - 1, 0),\n        \"BR\": (H - 1, W - 1),\n    }\n    marked_corners = [\n        (name, rc) for name, rc in corners.items() if int(g[rc]) != int(bg)\n    ]\n    assert len(marked_corners) == 1, \"expected exactly one foreground corner marker\"\n    corner, (corner_r, corner_c) = marked_corners[0]\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert comps, \"expected at least one foreground component\"\n    max_area = max(int(comp[\"area\"]) for comp in comps)\n    motif_candidates = [comp for comp in comps if int(comp[\"area\"]) == max_area]\n    assert len(motif_candidates) == 1, \"expected a unique largest motif\"\n    motif = motif_candidates[0]\n    motif_color = int(motif[\"color\"])\n    motif_coords = {tuple(map(int, coord)) for coord in motif[\"coords\"]}\n    motif_direction = _diagonal_direction(motif_coords)\n    assert motif_direction is not None, \"motif must be square and diagonal-symmetric\"\n    assert motif_direction == corner, \"corner marker must match motif diagonal direction\"\n\n    control_coords = [\n        (int(r), int(c))\n        for r, c in np.argwhere(g != bg)\n        if (int(r), int(c)) not in motif_coords\n    ]\n    assert (corner_r, corner_c) in control_coords, \"corner marker must be a control pixel\"\n    assert len(control_coords) > 1, \"expected non-corner control pixels\"\n\n    control_components = [comp for comp in comps if comp is not motif]\n    assert all(int(comp[\"area\"]) == 1 for comp in control_components), \"controls must be singleton components\"\n\n    control_counts = Counter(\n        int(g[r, c])\n        for r, c in control_coords\n        if (int(r), int(c)) != (corner_r, corner_c)\n    )\n    fill_candidates = [\n        int(color) for color, count in control_counts.items() if int(count) >= 2\n    ]\n    assert len(fill_candidates) == 1, \"expected one repeated non-corner fill color\"\n    fill_color = fill_candidates[0]\n    side = len(control_coords) - 1\n\n    out = np.full_like(g, bg)\n    for r, c in motif_coords:\n        out[r, c] = motif_color\n    _paint_corner_triangle(out, corner, int(side), fill_color)\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_ATTEMPTS = 300\n\n# Canvas and triangle bounds.\n_GEN_ROW_BOUNDS = (6, 15)\n_GEN_COL_BOUNDS = (9, 14)\n_GEN_TRIANGLE_SIDE_BOUNDS = (2, 5)\n\n# Color and control-pixel sampling.\n_GEN_COLORS = tuple(range(1, 10))\n_GEN_MARKER_AVOID_FILL_PROB = 0.8\n_GEN_FILL_COUNT_BOUNDS = (2, 3)\n\n# Sparse square motifs observed in the task examples.\n_GEN_MOTIF_TEMPLATES = [\n    (\"..#.\", \".#..\", \"#.#.\", \"...#\"),\n    (\".#...\", \"..#..\", \"..##.\", \".#..#\", \"#....\"),\n    (\n        \"...###...\",\n        \"..#......\",\n        \".##......\",\n        \"#..#.....\",\n        \"#...#....\",\n        \"#....#...\",\n        \"......#..\",\n        \".......#.\",\n        \"........#\",\n    ),\n    (\"#...\", \".#.#\", \"..#.\", \".#..\"),\n    (\"...#\", \"#.#.\", \"##..\", \".##.\"),\n]\n\n\ndef _gen_triangle_mask(shape, corner, side):\n    H, W = shape\n    rr, cc = np.indices((H, W))\n    if corner == \"TL\":\n        return rr + cc < side\n    if corner == \"TR\":\n        return rr + (W - 1 - cc) < side\n    if corner == \"BL\":\n        return (H - 1 - rr) + cc < side\n    return (H - 1 - rr) + (W - 1 - cc) < side\n\n\ndef _gen_dilate8(mask):\n    out = mask.copy()\n    out[1:, :] |= mask[:-1, :]\n    out[:-1, :] |= mask[1:, :]\n    out[:, 1:] |= mask[:, :-1]\n    out[:, :-1] |= mask[:, 1:]\n    out[1:, 1:] |= mask[:-1, :-1]\n    out[1:, :-1] |= mask[:-1, 1:]\n    out[:-1, 1:] |= mask[1:, :-1]\n    out[:-1, :-1] |= mask[1:, 1:]\n    return out\n\n\ndef _gen_patch_from_lines(lines):\n    return np.array([[ch == \"#\" for ch in row] for row in lines], dtype=bool)\n\n\ndef _gen_patch_variants(patch):\n    variants = []\n    seen = set()\n    for k in range(4):\n        rotated = np.rot90(patch, k)\n        for variant in (rotated, np.fliplr(rotated)):\n            key = tuple(map(tuple, variant.astype(int)))\n            if key not in seen:\n                seen.add(key)\n                variants.append(variant.copy())\n    return variants\n\n\ndef _gen_reflect_anti_diagonal(patch):\n    return np.flipud(np.fliplr(patch.T))\n\n\ndef _gen_is_diagonal_symmetric_patch(patch):\n    if patch.shape[0] != patch.shape[1]:\n        return False\n    main_ok = np.array_equal(patch, patch.T)\n    return main_ok or np.array_equal(patch, _gen_reflect_anti_diagonal(patch))\n\n\ndef _gen_patch_direction(patch):\n    if patch.shape[0] != patch.shape[1]:\n        return None\n    n = patch.shape[0]\n    main_ok = np.array_equal(patch, patch.T)\n    anti_ok = np.array_equal(patch, _gen_reflect_anti_diagonal(patch))\n    if main_ok:\n        if patch[0, 0] and not patch[n - 1, n - 1]:\n            return \"TL\"\n        if patch[n - 1, n - 1] and not patch[0, 0]:\n            return \"BR\"\n    if anti_ok:\n        if patch[0, n - 1] and not patch[n - 1, 0]:\n            return \"TR\"\n        if patch[n - 1, 0] and not patch[0, n - 1]:\n            return \"BL\"\n    return None\n\n\ndef _gen_symmetric_motif_patch(max_h, max_w):\n    candidates = []\n    for lines in _GEN_MOTIF_TEMPLATES:\n        patch = _gen_patch_from_lines(lines)\n        for variant in _gen_patch_variants(patch):\n            h, w = variant.shape\n            direction = _gen_patch_direction(variant)\n            if (\n                h <= max_h\n                and w <= max_w\n                and _gen_is_diagonal_symmetric_patch(variant)\n                and direction is not None\n            ):\n                candidates.append((variant, direction))\n    if not candidates:\n        return None\n    patch, direction = random.choice(candidates)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/c7f57c3e.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location\nimport random\n\n\ndef _pick_anchor_bbox(arr: np.ndarray, bg: int) -> tuple[int, int, int, int]:\n    \"\"\"Pick a stable anchor bbox inside the sprite array (color-1 pixels; always present).\"\"\"\n    if np.any(arr == 1):\n        ys, xs = np.where(arr == 1)\n        return int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())\n    assert False, \"sprite array has no color-1 pixels and should always have them\"\n\n\ndef _scale_nn(arr: np.ndarray, scale: int) -> np.ndarray:\n    if scale <= 1:\n        return arr.copy()\n    return np.repeat(np.repeat(arr, scale, axis=0), scale, axis=1)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swap every sprite to the opposite prototype while preserving scale and position.\n\n    Input structure:\n    - bg = most common color. Two distinct small sprite patterns (prototypes) appear at various scales.\n    - Each sprite instance is a scaled copy of one of the two prototypes, placed on the grid.\n\n    Rule:\n    - Identify the two prototype patterns from the smallest-area sprites.\n    - For each sprite, determine which prototype it matches and its integer scale factor.\n    - Replace it with the other prototype at the same scale, aligned by an internal anchor region (color-1 pixels).\n\n    Key insight: Every sprite toggles to the alternate prototype; the anchor sub-region inside each sprite pins the alignment so swapped sprites land in the correct position regardless of scale.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    comps = components_mask(g != bg, connectivity=8)\n    assert len(comps) >= 2, \"grid must contain at least 2 sprite components\"\n\n    # Extract sprite records.\n    sprites = []\n    for pts in comps:\n        r0, c0, r1, c1 = bbox_coords(pts)\n        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        sprites.append({\"pts\": pts, \"bbox\": (r0, c0, r1, c1), \"arr\": arr})\n\n    # Determine two base prototypes from the smallest bbox area sprites.\n    areas = [int((s[\"bbox\"][2] - s[\"bbox\"][0] + 1) * (s[\"bbox\"][3] - s[\"bbox\"][1] + 1)) for s in sprites]\n    min_area = min(areas)\n    base = [s for s, a in zip(sprites, areas, strict=False) if a == min_area]\n    uniq: dict[tuple[int, ...], np.ndarray] = {}\n    for s in base:\n        key = tuple(s[\"arr\"].ravel().tolist())\n        if key not in uniq:\n            uniq[key] = s[\"arr\"]\n    assert len(uniq) == 2, \"smallest-area sprites must yield exactly 2 distinct prototype patterns\"\n\n    proto_keys = list(uniq.keys())[:2]\n    protos = [uniq[proto_keys[0]], uniq[proto_keys[1]]]\n\n    anc0 = _pick_anchor_bbox(protos[0], bg)\n    anc1 = _pick_anchor_bbox(protos[1], bg)\n    a0r0, a0c0, a0r1, a0c1 = anc0\n    base_anc_h = a0r1 - a0r0 + 1\n    base_anc_w = a0c1 - a0c0 + 1\n\n    out = g.copy()\n\n    for s in sprites:\n        r0, c0, r1, c1 = s[\"bbox\"]\n        arr = s[\"arr\"]\n        anc = _pick_anchor_bbox(arr, bg)\n        ar0, ac0, ar1, ac1 = anc\n        inst_anc_h = ar1 - ar0 + 1\n        inst_anc_w = ac1 - ac0 + 1\n        # infer integer scale\n        scale_h = max(1, inst_anc_h // max(1, base_anc_h))\n        scale_w = max(1, inst_anc_w // max(1, base_anc_w))\n        scale = int(max(scale_h, scale_w))\n\n        # score which prototype matches this sprite when aligned by core bbox\n        best_idx = 0\n        best_score = -1\n        for idx, p in enumerate(protos):\n            sp = _scale_nn(p, scale)\n            panc = _pick_anchor_bbox(p, bg)\n            pr0, pc0, pr1, pc1 = panc\n            pr0 *= scale\n            pc0 *= scale\n            # align anchor top-left to instance anchor top-left (global coords)\n            top = (r0 + ar0) - pr0\n            left = (c0 + ac0) - pc0\n\n            # overlap score: count matching non-bg pixels where prototype expects non-bg\n            score = 0\n            ph, pw = sp.shape\n            rr0 = max(0, top)\n            cc0 = max(0, left)\n            rr1 = min(h, top + ph)\n            cc1 = min(w, left + pw)\n            if rr0 >= rr1 or cc0 >= cc1:\n                continue\n            sub_g = g[rr0:rr1, cc0:cc1]\n            sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]\n            m = sub_p != bg\n            if np.any(m):\n                score = int(np.sum(sub_g[m] == sub_p[m]))\n            if score > best_score:\n                best_score = score\n                best_idx = idx\n\n        repl_idx = 1 - best_idx\n\n        # Clear current sprite pixels.\n        for rr, cc in s[\"pts\"]:\n            out[rr, cc] = bg\n\n        # Place replacement.\n        p = protos[repl_idx]\n        sp = _scale_nn(p, scale)\n        panc = _pick_anchor_bbox(p, bg)\n        pr0, pc0, pr1, pc1 = panc\n        pr0 *= scale\n        pc0 *= scale\n        top = (r0 + ar0) - pr0\n        left = (c0 + ac0) - pc0\n\n        ph, pw = sp.shape\n        rr0 = max(0, top)\n        cc0 = max(0, left)\n        rr1 = min(h, top + ph)\n        cc1 = min(w, left + pw)\n        sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]\n        m = sub_p != bg\n        out_slice = out[rr0:rr1, cc0:cc1]\n        out_slice[m] = sub_p[m]\n        out[rr0:rr1, cc0:cc1] = out_slice\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- CFG: canvas ---\nGRID_SIZE_MIN = 18                  # square grid lower bound\nGRID_SIZE_MAX = 28                  # square grid upper bound\nGRID_MARGIN_FOR_SPRITES = 6         # min_n = max_sprite_dim + this\n\n# --- CFG: prototypes ---\nPROTO_SHAPES = [(4, 3), (3, 4), (4, 4)]  # (h, w) choices for label grid\nBG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9] # bg color pool (excludes 1)\nCOLOR_SHARE_PROB = 0.65             # prob that proto_B shares a color with proto_A\n\n# --- CFG: row-mask weights (anchor role vs variable role) ---\n#   each entry: (mask_type, weight)  where mask_type in {\"center\", \"outer\", \"full\"}\nANCHOR_ROW_WEIGHTS = [(\"center\", 0.45), (\"outer\", 0.35), (\"full\", 0.20)]\nVARIABLE_ROW_WEIGHTS = [(\"center\", 0.68), (\"full\", 0.32)]\nOUTER_FIXUP_PROB = 0.7             # when fixing no-edge row, prob of using outer vs full\n\n# --- CFG: sprite instances ---\nSPRITE_COUNTS = [3, 4]             # number of sprite instances per grid\nBIG_SCALES = [2, 3]                # scale factor for the one large sprite\n\n# --- CFG: placement ---\nPLACEMENT_BORDER = 1               # min distance from grid edge\nPLACEMENT_PADDING = 2              # min gap between sprite bboxes\nPLACEMENT_CONNECTIVITY = 8         # connectivity for padding check\n\n# --- CFG: generation retries ---\nMAX_RETRIES = 300\n\n# --- Row-mask patterns indexed by width ---\n_ROW_MASKS = {\n    \"center\": {3: [0, 1, 0], 4: [0, 1, 1, 0]},\n    \"outer\":  {3: [1, 0, 1], 4: [1, 0, 0, 1]},\n    \"full\":   {3: [1, 1, 1], 4: [1, 1, 1, 1]},\n}\n\n\ndef _row_mask(kind: str, w: int) -> list[int]:\n    \"\"\"Return a row occupancy mask of the given kind and width.\"\"\"\n    return list(_ROW_MASKS[kind][w])\n\n\ndef _anchor_bbox(arr: np.ndarray) -> tuple[int, int, int, int]:\n    \"\"\"Bounding box of color-1 (anchor) pixels: (r0, c0, r1, c1).\"\"\"\n    rs, cs = np.where(arr == 1)\n    return int(rs.min()), int(cs.min()), int(rs.max()), int(cs.max())\n\n\ndef _scale(arr: np.ndarray, k: int) -> np.ndarray:\n    \"\"\"Nearest-neighbor upscale by integer factor k.\"\"\"\n    if k == 1:\n        return arr.copy()\n    return np.repeat(np.repeat(arr, k, axis=0), k, axis=1)\n\n\ndef _make_labels() -> np.ndarray:\n    \"\"\"Build an (h, w) label grid with roles 1 (anchor), 2, 3 and bg holes (0).\"\"\"\n    h, w = random.choice(PROTO_SHAPES)\n\n    # Assign row counts per role (each role gets at least 1 row)\n    counts = {1: 1, 2: 1, 3: 1}\n    if h > 3:\n        counts[random.choice([1, 2, 3])] += h - 3\n    roles = []\n    for role in random.sample([1, 2, 3], 3):\n        roles.extend([role] * counts[role])\n\n    # Pick row masks via weighted sampling\n    weights_by_role = {\n        1: ANCHOR_ROW_WEIGHTS,\n        2: VARIABLE_ROW_WEIGHTS,\n        3: VARIABLE_ROW_WEIGHTS,\n    }\n    masks = []\n    for role in roles:\n        entries = weights_by_role[role]\n        kinds, wts = zip(*entries)\n        chosen_kind = random.choices(kinds, weights=wts)[0]\n        masks.append(_row_mask(chosen_kind, w))\n\n    # Fix-up: ensure at least one row touches the left/right edge\n    if not any(mask[0] or mask[-1] for mask in masks):\n        i = random.randrange(h)\n        if roles[i] == 1 and random.random() < OUTER_FIXUP_PROB:\n            masks[i] = _row_mask(\"outer\", w)\n        else:\n            masks[i] = _row_mask(\"full\", w)\n\n    # Fix-up: ensure at least one row has bg holes\n    if all(all(mask) for mask in masks):\n        masks[random.randrange(h)] = _row_mask(\"center\", w)\n\n    # Assemble label grid\n    labels = np.zeros((h, w), dtype=int)\n    for r, (role, mask) in enumerate(zip(roles, masks)):\n        for c, bit in enumerate(mask):\n            if bit:\n                labels[r, c] = role\n    return labels\n\n\ndef _make_prototypes(bg: int) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Create proto_A and proto_B (flipud + recolored) from a shared label grid.\"\"\"\n    labels = _make_labels()\n    pool = [c for c in range(10) if c not in (bg, 1)]\n    a_cols = random.sample(pool, 2)\n    remaining = [c for c in pool if c not in a_cols]\n    if random.random() < COLOR_SHARE_PROB:\n        b_cols = [random.choice(a_cols), random.choice(remaining)]\n        random.shuffle(b_cols)\n    else:\n        b_cols = random.sample(remaining, 2)\n\n    def _colorize(lab: np.ndarray, cols: list[int]) -> np.ndarray:\n        proto = np.full(lab.shape, bg, dtype=int)\n        proto[lab == 1] = 1\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/99caaf76.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import crop_bbox, find_components, get_bg, paste\nimport random\n\n\n_CROSS_MASK = np.array(\n    [\n        [False, True, False],\n        [True, True, True],\n        [False, True, False],\n    ],\n    dtype=bool,\n)\n\n\ndef _marker_color(g: np.ndarray, bg: int) -> int:\n    counts = Counter(int(v) for v in g[g != int(bg)])\n    assert counts, \"expected foreground pixels\"\n    max_count = max(counts.values())\n    candidates = [color for color, count in counts.items() if count == max_count]\n    assert len(candidates) == 1, \"expected a unique repeated marker color\"\n    marker = int(candidates[0])\n    assert counts[marker] % 4 == 0, \"marker pixels should form 4-pixel sprites\"\n    return marker\n\n\ndef _block_kind(block: np.ndarray, bg: int, marker: int) -> str:\n    assert block.shape == (3, 3), \"expected 3x3 half-block\"\n    marker_mask = block == int(marker)\n    other_mask = (block != int(bg)) & ~marker_mask\n\n    if int(marker_mask.sum()) == 4 and not bool(other_mask.any()):\n        return \"marker\"\n\n    if not bool(marker_mask.any()) and int(other_mask.sum()) == 5:\n        assert np.array_equal(other_mask, _CROSS_MASK), \"expected a 5-pixel cross\"\n        return \"cross\"\n\n    raise AssertionError(\"expected either a marker block or a colored cross block\")\n\n\ndef _paste_checked(out: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:\n    h, w = patch.shape\n    target = out[int(r0) : int(r0) + h, int(c0) : int(c0) + w]\n    assert target.shape == patch.shape, \"target patch must fit in the grid\"\n    assert not bool(np.any((target != int(bg)) & (patch != int(bg)))), \"moved objects must not overlap\"\n    paste(out, patch, int(r0), int(c0), transparent=int(bg))\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each marked cross object away from its marker to the grid edge while rotating the colored cross 180 degrees.\n\n    Input structure:\n    - The background is the dominant color.\n    - Each 8-connected foreground object has nine pixels: a 4-pixel marker-color\n      sprite attached to a 5-pixel non-marker colored cross.\n    - Each object bbox is either 3x6 or 6x3, so the marker sprite is on exactly\n      one side of the cross.\n\n    Rule:\n    - Move the whole object straight away from its marker side until the object\n      bbox touches the corresponding grid edge.\n    - Keep the marker sprite unchanged within the object.\n    - Rotate the 3x3 colored cross block by 180 degrees before placing it.\n\n    Key insight:\n    The marker sprite is a directional tail; the cross is the leading payload,\n    and only that payload turns around during the slide to the edge.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = get_bg(g)\n    marker = _marker_color(g, bg)\n\n    out = np.full_like(g, int(bg))\n    objects = find_components(g, bg=bg, connectivity=8, monochromatic=False)\n    assert objects, \"expected at least one composite object\"\n\n    for obj in objects:\n        assert int(obj[\"area\"]) == 9, \"each composite should contain 9 foreground pixels\"\n        r0, c0, _r1, _c1 = obj[\"bbox\"]\n        patch = crop_bbox(g, obj[\"bbox\"])\n        h, w = patch.shape\n        moved = patch.copy()\n\n        if (h, w) == (3, 6):\n            left = patch[:, :3]\n            right = patch[:, 3:]\n            left_kind = _block_kind(left, bg, marker)\n            right_kind = _block_kind(right, bg, marker)\n            assert {left_kind, right_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n\n            if left_kind == \"marker\":\n                moved[:, 3:] = np.rot90(right, 2)\n                target_r, target_c = int(r0), W - w\n            else:\n                moved[:, :3] = np.rot90(left, 2)\n                target_r, target_c = int(r0), 0\n\n        elif (h, w) == (6, 3):\n            top = patch[:3, :]\n            bottom = patch[3:, :]\n            top_kind = _block_kind(top, bg, marker)\n            bottom_kind = _block_kind(bottom, bg, marker)\n            assert {top_kind, bottom_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n\n            if top_kind == \"marker\":\n                moved[3:, :] = np.rot90(bottom, 2)\n                target_r, target_c = H - h, int(c0)\n            else:\n                moved[:3, :] = np.rot90(top, 2)\n                target_r, target_c = 0, int(c0)\n\n        else:\n            raise AssertionError(\"each composite bbox should be 3x6 or 6x3\")\n\n        _paste_checked(out, moved, target_r, target_c, bg)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Colors.\n_GEN_BG = 8\n_GEN_MARKER = 1\n_GEN_CENTER = 4\n_GEN_ARM_COLORS = [0, 2, 3, 5, 6, 7, 9]\n\n# Object layout.\n_GEN_SIDES = [\"left\", \"right\", \"top\", \"bottom\"]\n_GEN_MARKER_COORDS = {\n    \"left\": [(0, 0), (1, 1), (1, 2), (2, 0)],\n    \"right\": [(0, 2), (1, 0), (1, 1), (2, 2)],\n    \"top\": [(0, 0), (0, 2), (1, 1), (2, 1)],\n    \"bottom\": [(0, 1), (1, 1), (2, 0), (2, 2)],\n}\n_GEN_ARM_POSITIONS = [(0, 1), (1, 0), (1, 2), (2, 1)]\n\n# Canvas and placement bounds.\n_GEN_OBJECT_COUNT_RANGE = (1, 4)\n_GEN_MAX_SIDE = 18\n_GEN_MIN_SIDE_BY_OBJECT_COUNT = {1: 8, 2: 8, 3: 10, 4: 12}\n_GEN_PADDING = 1\n_GEN_EDGE_GAP = 2\n_GEN_HORIZONTAL_SIZE = (3, 6)\n_GEN_VERTICAL_SIZE = (6, 3)\n\n# Retry limits.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_marker_block(side: str) -> np.ndarray:\n    block = np.full((3, 3), _GEN_BG, dtype=int)\n    for r, c in _GEN_MARKER_COORDS[side]:\n        block[r, c] = _GEN_MARKER\n    return block\n\n\ndef _gen_cross_block() -> np.ndarray:\n    block = np.full((3, 3), _GEN_BG, dtype=int)\n    block[1, 1] = _GEN_CENTER\n    for (r, c), color in zip(_GEN_ARM_POSITIONS, random.sample(_GEN_ARM_COLORS, 4)):\n        block[r, c] = color\n    return block\n\n\ndef _gen_composite(side: str, cross: np.ndarray) -> np.ndarray:\n    marker = _gen_marker_block(side)\n    if side == \"left\":\n        return np.concatenate([marker, cross], axis=1)\n    if side == \"right\":\n        return np.concatenate([cross, marker], axis=1)\n    if side == \"top\":\n        return np.concatenate([marker, cross], axis=0)\n    return np.concatenate([cross, marker], axis=0)\n\n\ndef _gen_input_from_output(side: str, patch: np.ndarray) -> np.ndarray:\n    out = patch.copy()\n    if side == \"left\":\n        out[:, 3:] = np.rot90(out[:, 3:], 2)\n    elif side == \"right\":\n        out[:, :3] = np.rot90(out[:, :3], 2)\n    elif side == \"top\":\n        out[3:, :] = np.rot90(out[3:, :], 2)\n    else:\n        out[:3, :] = np.rot90(out[:3, :], 2)\n    return out\n\n\ndef _gen_can_place(canvas: np.ndarray, patch: np.ndarray, r0: int, c0: int, padding: int) -> bool:\n    h, w = patch.shape\n    H, W = canvas.shape\n    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:\n        return False\n    for dr, dc in np.argwhere(patch != _GEN_BG):\n        r = int(r0 + dr)\n        c = int(c0 + dc)\n        r1 = max(0, r - padding)\n        r2 = min(H, r + padding + 1)\n        c1 = max(0, c - padding)\n        c2 = min(W, c + padding + 1)\n        if np.any(canvas[r1:r2, c1:c2] != _GEN_BG):\n            return False\n    return True\n\n\ndef _gen_output_positions(side: str, H: int, W: int) -> list[tuple[int, int]]:\n    if side == \"left\":\n        return [(r, W - _GEN_HORIZONTAL_SIZE[1]) for r in range(H - _GEN_EDGE_GAP)]\n    if side == \"right\":\n        return [(r, 0) for r in range(H - _GEN_EDGE_GAP)]\n    if side == \"top\":\n        return [(H - _GEN_VERTICAL_SIZE[0], c) for c in range(W - _GEN_EDGE_GAP)]\n    return [(0, c) for c in range(W - _GEN_EDGE_GAP)]\n\n\ndef _gen_input_positions(side: str, H: int, W: int, target_r: int, target_c: int) -> list[tuple[int, int]]:\n    if side == \"left\":\n        return [(target_r, c) for c in range(0, W - _GEN_HORIZONTAL_SIZE[1] - _GEN_PADDING)]\n    if side == \"right\":\n        return [(target_r, c) for c in range(_GEN_EDGE_GAP, W - _GEN_HORIZONTAL_SIZE[1] + _GEN_PADDING)]\n    if side == \"top\":\n        return [(r, target_c) for r in range(0, H - _GEN_VERTICAL_SIZE[0] - _GEN_PADDING)]\n    return [(r, target_c) for r in range(_GEN_EDGE_GAP, H - _GEN_VERTICAL_SIZE[0] + _GEN_PADDING)]\n\n\ndef _gen_canvas_shape(n_obj: int) -> tuple[int, int]:\n    min_side = _GEN_MIN_SIDE_BY_OBJECT_COUNT[int(n_obj)]\n    return random.randint(min_side, _GEN_MAX_SIDE), random.randint(min_side, _GEN_MAX_SIDE)\n\n\ndef _gen_place_output_objects(expected: np.ndarray, n_obj: int) -> list[tuple[str, np.ndarray, int, int]] | None:\n    H, W = expected.shape\n    objects = []\n\n    for _ in range(n_obj):\n        sides = _GEN_SIDES[:]\n        random.shuffle(sides)\n        placed = False\n        for side in sides:\n            cross = _gen_cross_block()\n            patch = _gen_composite(side, cross)\n            positions = _gen_output_positions(side, H, W)\n            random.shuffle(positions)\n            for r0, c0 in positions:\n                if _gen_can_place(expected, patch, r0, c0, padding=_GEN_PADDING):\n                    paste(expected, patch, int(r0), int(c0), transparent=_GEN_BG)\n                    objects.append((side, patch, r0, c0))\n                    placed = True\n                    break\n            if placed:\n                break\n        if not placed:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/800d221b.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import Color, components_mask, get_bg, label_mask\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor a path-network by adjacent seed regions.\n\n    Input structure:\n    - bg = most common color.\n    - Path color P forms a thin orthogonal network with a solid square hub (NxN).\n    - Seed colors appear in colored regions (non-bg, non-P) adjacent to path branches.\n\n    Rule:\n    - Infer P as the non-bg color whose largest component is most network-like.\n    - Find the largest solid k×k all-P square (the hub); exclude it from recoloring.\n    - Recolor each path branch to the seed-region color it touches most.\n    - Recolor the hub center pixel to the seed whose branches touch the hub most.\n\n    Key insight: The hub stays uncolored; branches inherit color from adjacent seed regions by adjacency count.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    colors = sorted({int(x) for x in np.unique(g)} - {int(bg)})\n    assert not (not colors)\n\n    def comp_deg_score(mask: np.ndarray) -> float:\n        comps = components_mask(mask, connectivity=4)\n        if not comps:\n            return -1e9\n        best_pts = max(comps, key=lambda coords: int(coords.shape[0]))\n        best_sz = int(best_pts.shape[0])\n\n        m = np.zeros(mask.shape, dtype=bool)\n        m[best_pts[:, 0], best_pts[:, 1]] = True\n\n        deg2 = 0\n        deg4 = 0\n        for r, c in best_pts:\n            r = int(r)\n            c = int(c)\n            d = 0\n            if r > 0 and bool(m[r - 1, c]):\n                d += 1\n            if r + 1 < H and bool(m[r + 1, c]):\n                d += 1\n            if c > 0 and bool(m[r, c - 1]):\n                d += 1\n            if c + 1 < W and bool(m[r, c + 1]):\n                d += 1\n            if d == 2:\n                deg2 += 1\n            elif d == 4:\n                deg4 += 1\n        frac2 = deg2 / max(1, best_sz)\n        frac4 = deg4 / max(1, best_sz)\n        return float((frac2 - frac4) * best_sz)\n\n    P = int(max(colors, key=lambda c: comp_deg_score(g == int(c))))\n\n    # --- hub: largest solid k×k all-P square anywhere ---\n    mP = g == int(P)\n    ps = mP.astype(int).cumsum(axis=0).cumsum(axis=1)\n\n    def rect_sum(r0: int, c0: int, r1: int, c1: int) -> int:\n        s = int(ps[int(r1), int(c1)])\n        if r0 > 0:\n            s -= int(ps[int(r0 - 1), int(c1)])\n        if c0 > 0:\n            s -= int(ps[int(r1), int(c0 - 1)])\n        if r0 > 0 and c0 > 0:\n            s += int(ps[int(r0 - 1), int(c0 - 1)])\n        return int(s)\n\n    best = None  # (k, r0, c0)\n    max_k = int(min(H, W))\n    for k in range(2, max_k + 1):\n        found = None\n        for r0 in range(0, int(H - k + 1)):\n            r1 = int(r0 + k - 1)\n            for c0 in range(0, int(W - k + 1)):\n                c1 = int(c0 + k - 1)\n                if rect_sum(int(r0), int(c0), int(r1), int(c1)) == int(k * k):\n                    found = (int(k), int(r0), int(c0))\n        if found is not None:\n            best = found\n\n    assert not (best is None)\n\n    k, r0, c0 = map(int, best)\n    r1, c1 = int(r0 + k - 1), int(c0 + k - 1)\n    hub = np.zeros((H, W), dtype=bool)\n    hub[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = True\n\n    # --- seed regions (non-bg, non-P) ---\n    seed_mask = (g != int(bg)) & (g != int(P))\n    seed_lab, seed_n = label_mask(seed_mask, connectivity=4)\n    seed_major: dict[int, int] = {}\n    all_seed_vals: list[int] = []\n    for sid in range(1, int(seed_n) + 1):\n        pts = np.argwhere(seed_lab == int(sid))\n        rn, rx = int(pts[:, 0].min()), int(pts[:, 0].max())\n        cn, cx = int(pts[:, 1].min()), int(pts[:, 1].max())\n        if rn > 0:\n            assert all(int(g[rn - 1, c]) == int(P) for c in range(cn, cx + 1)), \"seed missing top P border\"\n        if rx < H - 1:\n            assert all(int(g[rx + 1, c]) == int(P) for c in range(cn, cx + 1)), \"seed missing bot P border\"\n        if cn > 0:\n            assert all(int(g[r, cn - 1]) == int(P) for r in range(rn, rx + 1)), \"seed missing left P border\"\n        if cx < W - 1:\n            assert all(int(g[r, cx + 1]) == int(P) for r in range(rn, rx + 1)), \"seed missing right P border\"\n        vals = [int(g[int(r), int(c)]) for r, c in pts]\n        maj = int(Counter(vals).most_common(1)[0][0])\n        seed_major[int(sid)] = int(maj)\n        all_seed_vals.extend(vals)\n\n    out = g.copy()\n\n    # --- recolor each path branch by the seed region it touches most ---\n    branch_mask = (g == int(P)) & (~hub)\n    branch_lab, branch_n = label_mask(branch_mask, connectivity=4)\n\n    pmask = g == int(P)\n    ppad = np.pad(pmask, 1)\n    p_deg = ppad[2:, 1:-1].astype(int) + ppad[:-2, 1:-1] + ppad[1:-1, 2:] + ppad[1:-1, :-2]\n    spad = np.pad(seed_lab > 0, 1)\n    adj_seed = spad[2:, 1:-1] | spad[:-2, 1:-1] | spad[1:-1, 2:] | spad[1:-1, :-2]\n    assert not np.any((p_deg > 2) & pmask & ~hub & ~adj_seed), \"path has T-junction\"\n\n    for bid in range(1, int(branch_n) + 1):\n        pts = np.argwhere(branch_lab == int(bid))\n        touches = Counter()\n        for r, c in pts:\n            r = int(r)\n            c = int(c)\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr, cc = int(r + dr), int(c + dc)\n                if 0 <= rr < H and 0 <= cc < W:\n                    sid = int(seed_lab[rr, cc])\n                    if sid != 0:\n                        touches[int(sid)] += 1\n        if not touches:\n            continue\n        sid = int(touches.most_common(1)[0][0])\n        col = int(seed_major[int(sid)])\n        for r, c in pts:\n            out[int(r), int(c)] = int(col)\n\n    # --- hub center pixel recolor ---\n    touch_cols = Counter()\n    if int(branch_n) > 0:\n        for r in range(H):\n            for c in range(W):\n                if not bool(hub[int(r), int(c)]):\n                    continue\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    rr, cc = int(r + dr), int(c + dc)\n                    if 0 <= rr < H and 0 <= cc < W:\n                        if int(branch_lab[rr, cc]) != 0:\n                            touch_cols[int(out[rr, cc])] += 1\n\n    cr = int(r0 + k // 2)\n    cc = int(c0 + k // 2)\n\n    assert touch_cols, 'hub must be touched by at least one recolored branch'\n    assert all_seed_vals, 'grid must contain seed regions'\n    center_col = int(touch_cols.most_common(1)[0][0])\n    out[int(cr), int(cc)] = int(center_col)\n\n    return out\n\n# --------------- generator (attempt_1) ---------------\n\nimport random\n\n# ── Tunable generation parameters ──────────────────────────────────────────\n# Canvas / grid\nGRID_SIZE_BASE = 10          # base grid dimension before seed-count scaling\nGRID_SIZE_PER_SEED = 3       # extra min-dimension per seed beyond 3\nGRID_SIZE_MIN = 12           # absolute minimum grid dimension\nGRID_SIZE_MAX = 30           # maximum grid dimension\n\n# Hub\nHUB_SIZE = 3                 # hub is HUB_SIZE x HUB_SIZE solid square\n\n# Seed regions\nSEED_COUNT_CHOICES = [3, 4, 5]\nSEED_INTERIOR_MIN = 2        # min interior width/height\nSEED_INTERIOR_MAX = 4        # max interior width/height\nMINORITY_FRAC_LO = 0.06      # min minority color fraction in seed interior\nMINORITY_FRAC_HI = 0.40      # max minority color fraction in seed interior\nSEED_PLACEMENT_RETRIES = 400 # max attempts to place all seeds\nSEED_ZONE_GAP = 1            # min separation between seed border zones\n\n# Path carving\nMAX_BENDS = 6                # max L-bends per path\nSEGMENT_LEN_MIN = 1          # min segment length before a bend\nSEGMENT_LEN_MAX = 6          # max segment length before a bend\nMAX_PATHS_PER_SEED = 3       # cap on paths connecting one seed to hub\nPATH_FIRST_ROUND_RETRIES = 60   # retries for first mandatory path per seed\nPATH_EXTRA_ROUND_RETRIES = 30   # retries per extra path attempt\nPATH_DIR_RETRIES = 3         # attempts per initial direction in carve\n\n# Top-level generation\nGEN_OUTER_RETRIES = 300      # max _gen_attempt calls in generate_input\n\n_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n# ── Path carving ───────────────────────────────────────────────────────────\n\ndef _try_carve_path(canvas, P, start, dest_border_cells, max_bends=MAX_BENDS):\n    \"\"\"Carve a single 1-pixel-wide orthogonal path from hub `start` toward `dest_border_cells`.\n\n    Works on a \"work canvas\" where 0 = free, P = path/hub, other = seed.\n    Returns list of placed (r, c) cells, or None on failure.\n    Mutates `canvas` in-place (cleans up on failure).\n    \"\"\"\n    H, W = canvas.shape\n    dest_set = set(dest_border_cells)\n\n    def _check_neighbors(r, c, prev, allow_dest):\n        \"\"\"Check all 4-neighbors for T-junction violations.\n\n        Returns True if placing a path cell at (r,c) is safe.\n        Cell must be in-bounds and free (canvas == 0).\n        \"\"\"\n        if not (0 <= r < H and 0 <= c < W) or canvas[r, c] != 0:\n            return False\n        for dr, dc in _DIRS:\n            nr, nc = r + dr, c + dc\n            if not (0 <= nr < H and 0 <= nc < W):\n                continue\n            if (nr, nc) == prev or (nr, nc) == start:\n                continue\n            v = canvas[nr, nc]\n            if v == P:\n                if allow_dest and (nr, nc) in dest_set:\n                    continue\n                return False\n            if v != 0:\n                return False\n        return True\n\n    # Initial directions: those leading from hub perimeter into a free cell\n    sr, sc = start\n    init_dirs = []\n    for dr, dc in _DIRS:\n        nr, nc = sr + dr, sc + dc\n        if 0 <= nr < H and 0 <= nc < W and canvas[nr, nc] == 0:\n            init_dirs.append((dr, dc))\n    if not init_dirs:\n        return None\n    random.shuffle(init_dirs)\n\n    n_bends = random.randint(0, max_bends)\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/fc4aaf52.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg\nimport random\n\n\ndef _swapped_values(values: np.ndarray, color_a: int, color_b: int) -> np.ndarray:\n    out = values.copy()\n    out[values == int(color_a)] = int(color_b)\n    out[values == int(color_b)] = int(color_a)\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Split the two-color object horizontally, swap its colors, and slide the upper half to the right.\n\n    Input structure:\n    - The grid has one background color and exactly two foreground colors.\n    - All foreground pixels form one 4-connected object with an even-height bbox.\n    - The object has foreground pixels on both rows adjacent to its horizontal midpoint.\n\n    Rule:\n    - Split the object into upper and lower halves at the midpoint of its bbox.\n    - Swap the two foreground colors in both halves.\n    - Keep the lower half in place and shift the upper half right until its lower-left\n      boundary pixel is diagonally adjacent to the lower half's upper-right boundary pixel.\n\n    Key insight:\n    - The object is not copied or reflected; it is broken at the horizontal waist,\n      recolored by exchanging the two visible object colors, then rejoined diagonally.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected exactly two foreground colors\"\n    color_a, color_b = colors\n\n    objects = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert len(objects) == 1, \"expected one connected foreground object\"\n    r0, _c0, r1, _c1 = objects[0][\"bbox\"]\n    height = int(r1 - r0 + 1)\n    assert height % 2 == 0, \"object bbox height must split evenly\"\n\n    split_row = int(r0 + height // 2)\n    row_ids = np.arange(g.shape[0])[:, None]\n    fg = g != int(bg)\n    upper = fg & (row_ids < split_row)\n    lower = fg & (row_ids >= split_row)\n    assert np.any(upper), \"expected a nonempty upper half\"\n    assert np.any(lower), \"expected a nonempty lower half\"\n    assert int(upper.sum()) == int(lower.sum()), \"expected equal upper and lower areas\"\n\n    upper_boundary_cols = np.flatnonzero(upper[split_row - 1])\n    lower_boundary_cols = np.flatnonzero(lower[split_row])\n    assert upper_boundary_cols.size > 0, \"upper half must touch the split boundary\"\n    assert lower_boundary_cols.size > 0, \"lower half must touch the split boundary\"\n\n    shift = int(lower_boundary_cols.max() + 1 - upper_boundary_cols.min())\n    assert shift > 0, \"upper half must shift right\"\n\n    upper_rows, upper_cols = np.where(upper)\n    lower_rows, lower_cols = np.where(lower)\n    shifted_upper_cols = upper_cols + shift\n    assert int(shifted_upper_cols.max()) < g.shape[1], \"shifted upper half must fit in the grid\"\n\n    out = np.full_like(g, int(bg))\n    out[lower_rows, lower_cols] = _swapped_values(g[lower_rows, lower_cols], color_a, color_b)\n    out[upper_rows, shifted_upper_cols] = _swapped_values(g[upper_rows, upper_cols], color_a, color_b)\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import paste as _gen_paste\n# Canvas and palette.\nGEN_BG, GEN_GRID_SIZE = 8, 16\nGEN_COLOR_POOL = [c for c in range(10) if c != GEN_BG]\n\n# Symmetric object shape.\nGEN_HALF_HEIGHTS, GEN_MAX_WIDTHS = [3, 4], [5, 7]\nGEN_MIN_ROW_WIDTH, GEN_WIDTH_STEP = 1, 2\nGEN_ROW_SWAP_PROB, GEN_ROW_SWAP_HEIGHT = 0.25, 4\nGEN_ROW_SWAP_INDICES = (1, 2)\n\n# Placement and validation.\nGEN_MARGIN, GEN_RETRIES = 1, 300\n\n\ndef _gen_fc4aaf52_swap(arr: np.ndarray, color_a: int, color_b: int) -> np.ndarray:\n    out = arr.copy()\n    out[arr == color_a] = color_b\n    out[arr == color_b] = color_a\n    return out\n\n\ndef _gen_fc4aaf52_upper(half_h: int, border_color: int, fill_color: int) -> np.ndarray:\n    max_w = random.choice(GEN_MAX_WIDTHS)\n    widths = [max_w]\n    for _ in range(half_h - 1):\n        prev_w = widths[-1]\n        widths.append(random.choice([max(GEN_MIN_ROW_WIDTH, prev_w - GEN_WIDTH_STEP), prev_w]))\n    widths = list(reversed(widths))\n    if random.random() < GEN_ROW_SWAP_PROB and half_h == GEN_ROW_SWAP_HEIGHT:\n        i, j = GEN_ROW_SWAP_INDICES\n        widths[i], widths[j] = widths[j], widths[i]\n\n    bottom_lefts = [0]\n    bottom_widths = list(reversed(widths))\n    for i, width in enumerate(bottom_widths[1:], start=1):\n        prev_l = bottom_lefts[-1]\n        prev_r = prev_l + bottom_widths[i - 1] - 1\n        choices = [left for left in range(max_w - width + 1) if max(left, prev_l) <= min(left + width - 1, prev_r)]\n        bottom_lefts.append(random.choice(choices))\n    lefts = list(reversed(bottom_lefts))\n\n    upper = np.full((half_h, max_w), GEN_BG, dtype=int)\n    for r, (left, width) in enumerate(zip(lefts, widths)):\n        right = left + width\n        upper[r, left:right] = fill_color\n        upper[r, left] = border_color\n        upper[r, right - 1] = border_color\n    return upper\n\n\ndef _gen_fc4aaf52_placement(obj_h: int, obj_w: int, shift: int) -> tuple[int, int] | None:\n    max_row = GEN_GRID_SIZE - GEN_MARGIN - obj_h\n    max_col = GEN_GRID_SIZE - GEN_MARGIN - obj_w - shift\n    return None if max_col < 0 else (random.randint(GEN_MARGIN, max_row), random.randint(GEN_MARGIN, max_col))\n\n\ndef _gen_fc4aaf52_render(upper, lower, row, col, shift, border_color, fill_color, *, swapped):\n    out = np.full((GEN_GRID_SIZE, GEN_GRID_SIZE), GEN_BG, dtype=int)\n    upper_col = col\n    if swapped:\n        upper = _gen_fc4aaf52_swap(upper, border_color, fill_color)\n        lower = _gen_fc4aaf52_swap(lower, border_color, fill_color)\n        upper_col += shift\n    _gen_paste(out, upper, row, upper_col, transparent=GEN_BG)\n    _gen_paste(out, lower, row + upper.shape[0], col, transparent=GEN_BG)\n    return out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    border_color, fill_color = random.sample(GEN_COLOR_POOL, 2)\n    half_h = random.choice(GEN_HALF_HEIGHTS)\n    upper_in = _gen_fc4aaf52_upper(half_h, border_color, fill_color)\n    lower_in = np.flipud(upper_in)\n\n    obj_h, obj_w = half_h * 2, upper_in.shape[1]\n    shift = int(np.count_nonzero(upper_in[-1] != GEN_BG))\n    placement = _gen_fc4aaf52_placement(obj_h, obj_w, shift)\n    if placement is None:\n        return None\n    obj_row, obj_col = placement\n\n    expected = _gen_fc4aaf52_render(upper_in, lower_in, obj_row, obj_col, shift, border_color, fill_color, swapped=True)\n    inp = _gen_fc4aaf52_render(upper_in, lower_in, obj_row, obj_col, shift, border_color, fill_color, swapped=False)\n\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid fc4aaf52 input\")\n","exit_code":0,"status":"completed"}}
