*_best_pattern(grid, box))\n        outside = _outside_box_mask(grid.shape, box)\n        gap_noise = int(np.count_nonzero((grid != BLACK) & (grid != RED) & outside & ~stripe_mask))\n        stripe_noise = int(np.count_nonzero((grid != BLACK) & (grid != RED) & outside & stripe_mask & (grid != stripe_mask.astype(int))))\n        if gap_noise < 2 or stripe_noise < 2:\n            continue\n        if not np.array_equal(main(grid), expected):\n            continue\n        return grid\n\n    raise RuntimeError(\"generate_input failed to create a valid sample\")\n","exit_code":0,"status":"completed"}}
