{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/c803e39c.py\"","aggregated_output":"import numpy as np\n\n\ndef _unique_dominant_color(g: np.ndarray) -> int:\n    vals, counts = np.unique(g, return_counts=True)\n    max_count = counts.max()\n    candidates = vals[counts == max_count]\n    assert len(candidates) == 1\n    return int(candidates[0])\n\n\ndef _extract_panel_mask(panel: np.ndarray, bg: int) -> tuple[np.ndarray, int]:\n    content = panel != bg\n    coords = np.argwhere(content)\n    assert len(coords) > 0\n\n    r0, c0 = coords.min(axis=0)\n    r1, c1 = coords.max(axis=0)\n    crop = panel[r0 : r1 + 1, c0 : c1 + 1]\n    crop_content = content[r0 : r1 + 1, c0 : c1 + 1]\n\n    colors = np.unique(crop[crop_content])\n    assert len(colors) == 1\n    color = int(colors[0])\n    mask = crop == color\n    assert np.array_equal(mask, crop_content)\n    return mask, color\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Expand the second mask into a block grid by stamping the first mask with the two payload colors.\n\n    Input structure\n    - A background grid has four panels separated by three full-height separator columns.\n    - The first two panels contain same-size binary masks; the last two contain solid same-size color squares.\n    Rule\n    - Use the second mask as an outer layout. For each foreground cell in that outer mask, place a tile equal to the first mask, coloring its foreground with the first solid-square color and its background with the second solid-square color; outer background cells become all second solid-square color.\n    Key insight\n    - The output is the Kronecker product of the two binary masks, with the two right-hand panel colors providing the palette.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = _unique_dominant_color(g)\n\n    sep_cols = [\n        c\n        for c in range(w)\n        if np.all(g[:, c] == g[0, c]) and int(g[0, c]) != bg\n    ]\n    assert len(sep_cols) == 3\n    sep_colors = {int(g[0, c]) for c in sep_cols}\n    assert len(sep_colors) == 1\n\n    cuts = [-1, *sep_cols, w]\n    spans = [(cuts[i] + 1, cuts[i + 1]) for i in range(4)]\n    assert all(c0 < c1 for c0, c1 in spans)\n\n    masks: list[np.ndarray] = []\n    colors: list[int] = []\n    for c0, c1 in spans:\n        mask, color = _extract_panel_mask(g[:, c0:c1], bg)\n        masks.append(mask)\n        colors.append(color)\n\n    n = masks[0].shape[0]\n    assert n > 0\n    assert h == n + 2\n    assert all(mask.shape == (n, n) for mask in masks)\n    assert masks[2].all()\n    assert masks[3].all()\n    assert colors[2] != colors[3]\n\n    painted = np.kron(masks[1], masks[0])\n    out = np.full((n * n, n * n), colors[3], dtype=int)\n    out[painted] = colors[2]\n    assert out.shape == (n * n, n * n)\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and panel geometry.\nMIN_MASK_SIDE = 3\nMAX_MASK_SIDE = 5\nBORDER = 1\nPANEL_COUNT = 4\nSEPARATOR_COLOR = 5\nBACKGROUND_COLOR = 0\nCLIP_LAST_COL_PROB = 0.2\n\n# Binary mask sampling.\nMASK_FILL_MIN = 0.4\nMASK_FILL_MAX = 0.8\nMIN_ACTUAL_FILL = 0.3\nMAX_ACTUAL_FILL = 1.0\n\n# Palette and retry limits.\nAVAILABLE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\nGENERATION_ATTEMPTS = 300\n\n\ndef _sample_mask(rng: np.random.Generator, n: int) -> np.ndarray:\n    \"\"\"Return an n x n random mask whose actual fill passes the solver-facing bounds.\"\"\"\n    while True:\n        fill = rng.uniform(MASK_FILL_MIN, MASK_FILL_MAX)\n        mask = rng.random((n, n)) < fill\n        actual_fill = mask.sum() / (n * n)\n        if MIN_ACTUAL_FILL < actual_fill < MAX_ACTUAL_FILL:\n            return mask\n\n\ndef _grid_width(n: int, rng: np.random.Generator) -> int:\n    panel_width = n + 2 * BORDER\n    width = PANEL_COUNT * panel_width + (PANEL_COUNT - 1)\n    if rng.random() < CLIP_LAST_COL_PROB:\n        width -= 1\n    return width\n\n\ndef _separator_columns(n: int) -> tuple[int, int, int]:\n    panel_width = n + 2 * BORDER\n    return panel_width, 2 * panel_width + 1, 3 * panel_width + 2\n\n\ndef _paint_mask_panel(grid: np.ndarray, mask: np.ndarray, color: int, c_start: int) -> None:\n    panel = grid[BORDER : BORDER + mask.shape[0], c_start : c_start + mask.shape[1]]\n    panel[mask] = color\n\n\ndef _paint_solid_panel(grid: np.ndarray, n: int, color: int, c_start: int) -> None:\n    grid[BORDER : BORDER + n, c_start : c_start + n] = color\n\n\ndef _build_input_grid(\n    n: int,\n    mask0: np.ndarray,\n    mask1: np.ndarray,\n    color0: int,\n    color1: int,\n    color_fg: int,\n    color_bg: int,\n    rng: np.random.Generator,\n) -> np.ndarray:\n    \"\"\"Build the four-panel input with optional right-border clipping.\"\"\"\n    h = n + 2 * BORDER\n    w = _grid_width(n, rng)\n    grid = np.full((h, w), BACKGROUND_COLOR, dtype=int)\n\n    sep1, sep2, sep3 = _separator_columns(n)\n    grid[:, sep1] = SEPARATOR_COLOR\n    grid[:, sep2] = SEPARATOR_COLOR\n    grid[:, sep3] = SEPARATOR_COLOR\n\n    _paint_mask_panel(grid, mask0, color0, BORDER)\n    _paint_mask_panel(grid, mask1, color1, sep1 + 1 + BORDER)\n    _paint_solid_panel(grid, n, color_fg, sep2 + 1 + BORDER)\n    _paint_solid_panel(grid, n, color_bg, sep3 + 1 + BORDER)\n    return grid\n\n\ndef _expected_output(n: int, mask0: np.ndarray, mask1: np.ndarray, color_fg: int, color_bg: int) -> np.ndarray:\n    painted = np.kron(mask1, mask0)\n    expected = np.full((n * n, n * n), color_bg, dtype=int)\n    expected[painted] = color_fg\n    return expected\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    n = rng.integers(MIN_MASK_SIDE, MAX_MASK_SIDE + 1)\n    mask0 = _sample_mask(rng, n)\n    mask1 = _sample_mask(rng, n)\n\n    chosen = rng.choice(AVAILABLE_COLORS, size=4, replace=False)\n    color0, color1, color_fg, color_bg = int(chosen[0]), int(chosen[1]), int(chosen[2]), int(chosen[3])\n    grid = _build_input_grid(n, mask0, mask1, color0, color1, color_fg, color_bg, rng)\n\n    # Verify with solver\n    try:\n        out = main(grid)\n        expected = _expected_output(n, mask0, mask1, color_fg, color_bg)\n        if np.array_equal(out, expected):\n            return grid\n    except Exception:\n        pass\n\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/db118e2a.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox, paste\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Normalize the framed input motif into a 5x5 icon and stamp two copies on a 15x15 canvas.\n\n    Input structure\n    The input is a rounded rectangular frame: the four corners are the background\n    color, and every other outer-border pixel has one frame color. Non-background\n    pixels inside that frame are the motif to preserve.\n\n    Rule\n    Make a 5x5 version of the rounded frame with a 3x3 interior. Crop the input\n    interior motif to its bounding box, center that crop in the 3x3 interior, and\n    paste the resulting 5x5 icon at upper-left positions (2, 2) and (8, 8) in a\n    15x15 background canvas.\n\n    Key insight\n    The variable-size frame is only a carrier; the meaningful object is the\n    compact interior motif, which is normalized to the fixed 3x3 icon interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    assert h >= 3 and w >= 3\n\n    corners = (g[0, 0], g[0, w - 1], g[h - 1, 0], g[h - 1, w - 1])\n    assert len(set(map(int, corners))) == 1\n    bg = int(corners[0])\n\n    border = np.concatenate((g[0, :], g[h - 1, :], g[:, 0], g[:, w - 1]))\n    frame_colors = set(map(int, border)) - {bg}\n    assert len(frame_colors) == 1\n    (frame_color,) = tuple(frame_colors)\n\n    assert np.all(g[0, 1 : w - 1] == frame_color)\n    assert np.all(g[h - 1, 1 : w - 1] == frame_color)\n    assert np.all(g[1 : h - 1, 0] == frame_color)\n    assert np.all(g[1 : h - 1, w - 1] == frame_color)\n\n    icon = np.full((5, 5), bg, dtype=int)\n    icon[0, 1:4] = frame_color\n    icon[4, 1:4] = frame_color\n    icon[1:4, 0] = frame_color\n    icon[1:4, 4] = frame_color\n\n    interior = g[1 : h - 1, 1 : w - 1]\n    motif_box = bbox(interior != bg)\n    assert motif_box is not None\n    r0, c0, r1, c1 = motif_box\n    motif = interior[r0 : r1 + 1, c0 : c1 + 1]\n    mh, mw = motif.shape\n    assert mh <= 3 and mw <= 3\n\n    icon_r = 1 + (3 - mh) // 2\n    icon_c = 1 + (3 - mw) // 2\n    icon[icon_r : icon_r + mh, icon_c : icon_c + mw] = motif\n\n    out = np.full((15, 15), bg, dtype=int)\n    out[2:7, 2:7] = icon\n    out[8:13, 8:13] = icon\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and color constants.\n_GEN_BG = 7\n_GEN_FRAME_COLORS = [1, 2, 3, 4, 5, 6, 8, 9]\n_GEN_PALETTE = [c for c in range(10) if c != _GEN_BG]\n\n# Input/output geometry.\n_GEN_INPUT_H_RANGE = (6, 10)\n_GEN_INPUT_W_RANGE = (5, 10)\n_GEN_ICON_SIZE = 5\n_GEN_ICON_INTERIOR = 3\n_GEN_OUTPUT_SIZE = 15\n_GEN_OUTPUT_POSITIONS = ((2, 2), (8, 8))\n\n# Motif sampling.\n_GEN_MOTIF_DIM_RANGE = (1, 4)\n_GEN_NON_BG_COUNT_RANGE = (1, 8)\n_GEN_COLOR_COUNT_RANGE = (1, 3)\n_GEN_FRAME_COLOR_INJECTION_RATE = 0.35\n\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_min_pixels_for_bbox(mh, mw):\n    return 1 if mh == 1 and mw == 1 else 2\n\n\ndef _gen_choose_motif_shape(rng, non_bg_count):\n    choices = []\n    for mh in range(*_GEN_MOTIF_DIM_RANGE):\n        for mw in range(*_GEN_MOTIF_DIM_RANGE):\n            if _gen_min_pixels_for_bbox(mh, mw) <= non_bg_count <= mh * mw:\n                choices.append((mh, mw))\n    return choices[int(rng.integers(len(choices)))]\n\n\ndef _gen_full_bbox_coords(rng, mh, mw, non_bg_count):\n    if mh == 1 and mw == 1:\n        return [(0, 0)]\n\n    if mh == 1:\n        required = [(0, 0), (0, mw - 1)]\n    elif mw == 1:\n        required = [(0, 0), (mh - 1, 0)]\n    elif int(rng.integers(2)) == 0:\n        required = [(0, 0), (mh - 1, mw - 1)]\n    else:\n        required = [(0, mw - 1), (mh - 1, 0)]\n\n    coords = list(required)\n    pool = [(r, c) for r in range(mh) for c in range(mw) if (r, c) not in coords]\n    need = non_bg_count - len(coords)\n    if need:\n        picked = rng.choice(len(pool), size=need, replace=False)\n        coords.extend(pool[int(i)] for i in np.atleast_1d(picked))\n    return coords\n\n\ndef _gen_make_motif(rng, bg, frame_color):\n    non_bg_count = int(rng.integers(*_GEN_NON_BG_COUNT_RANGE))\n    mh, mw = _gen_choose_motif_shape(rng, non_bg_count)\n    coords = _gen_full_bbox_coords(rng, mh, mw, non_bg_count)\n\n    color_count = 1 if non_bg_count == 1 else int(rng.integers(*_GEN_COLOR_COUNT_RANGE))\n    colors = list(rng.choice(_GEN_PALETTE, size=color_count, replace=False))\n    if color_count == 2 and frame_color not in colors and rng.random() < _GEN_FRAME_COLOR_INJECTION_RATE:\n        colors[int(rng.integers(2))] = frame_color\n\n    motif = np.full((mh, mw), bg, dtype=int)\n    rng.shuffle(coords)\n    if color_count == 1:\n        for r, c in coords:\n            motif[r, c] = int(colors[0])\n    else:\n        motif[coords[0]] = int(colors[0])\n        motif[coords[1]] = int(colors[1])\n        for r, c in coords[2:]:\n            motif[r, c] = int(colors[int(rng.integers(2))])\n    return motif\n\n\ndef _gen_draw_rounded_frame(grid, frame_color):\n    \"\"\"Paint the non-corner border cells in-place.\"\"\"\n    h, w = grid.shape\n    grid[0, 1 : w - 1] = frame_color\n    grid[h - 1, 1 : w - 1] = frame_color\n    grid[1 : h - 1, 0] = frame_color\n    grid[1 : h - 1, w - 1] = frame_color\n\n\ndef _gen_build_icon(bg, frame_color, motif):\n    icon = np.full((_GEN_ICON_SIZE, _GEN_ICON_SIZE), bg, dtype=int)\n    _gen_draw_rounded_frame(icon, frame_color)\n\n    mh, mw = motif.shape\n    icon_r = 1 + (_GEN_ICON_INTERIOR - mh) // 2\n    icon_c = 1 + (_GEN_ICON_INTERIOR - mw) // 2\n    paste(icon, motif, icon_r, icon_c)\n    return icon\n\n\ndef _gen_build_input(rng, bg, frame_color, motif):\n    h = int(rng.integers(*_GEN_INPUT_H_RANGE))\n    w = int(rng.integers(*_GEN_INPUT_W_RANGE))\n    inp = np.full((h, w), bg, dtype=int)\n    _gen_draw_rounded_frame(inp, frame_color)\n\n    mh, mw = motif.shape\n    interior_h, interior_w = h - 2, w - 2\n    r = int(rng.integers(0, interior_h - mh + 1))\n    c = int(rng.integers(0, interior_w - mw + 1))\n    paste(inp, motif, 1 + r, 1 + c)\n    return inp\n\n\ndef _gen_attempt(rng):\n    bg = _GEN_BG\n    frame_color = int(rng.choice(_GEN_FRAME_COLORS))\n    motif = _gen_make_motif(rng, bg, frame_color)\n\n    icon = _gen_build_icon(bg, frame_color, motif)\n    out = np.full((_GEN_OUTPUT_SIZE, _GEN_OUTPUT_SIZE), bg, dtype=int)\n    for r, c in _GEN_OUTPUT_POSITIONS:\n        paste(out, icon, r, c)\n\n    inp = _gen_build_input(rng, bg, frame_color, motif)\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input():\n    rng = np.random.default_rng()\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        inp = _gen_attempt(rng)\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid db118e2a input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/7b5033c1.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import get_bg\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Straighten a colored snake path into a single-column strip preserving pixel order.\n\n    Input structure:\n    - bg = most common color.\n    - Non-bg pixels form a single 4-connected path (snake) with exactly two endpoints.\n    - Each path pixel may be a different non-bg color.\n\n    Rule:\n    - Find the two endpoints (cells with only one path neighbor) of the snake.\n    - Begin at the top-left-most endpoint and trace the path cell by cell.\n    - Output an (N×1) column listing each cell's color in traversal order.\n\n    Key insight: The path is a simple chain with no branches; choosing the top-left-most endpoint fixes a unique reading direction.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    mask = g != bg\n    pts = [(int(r), int(c)) for r, c in np.argwhere(mask)]\n    if not pts:\n        return np.zeros((0, 1), dtype=int)\n\n    pset = set(pts)\n    deg: dict[tuple[int, int], int] = {}\n    for r, c in pts:\n        d = 0\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            if (r + dr, c + dc) in pset:\n                d += 1\n        deg[(r, c)] = int(d)\n\n    ends = [p for p in pts if int(deg[p]) == 1]\n    assert ends\n    start = min(ends)\n\n    order: list[tuple[int, int]] = []\n    prev = None\n    cur = start\n    for _ in range(len(pts)):\n        order.append(cur)\n\n        r, c = cur\n        nbrs = []\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            q = (r + dr, c + dc)\n            if q in pset and q != prev:\n                nbrs.append(q)\n        if not nbrs:\n            break\n\n        nxt = min(nbrs)\n        prev, cur = cur, nxt\n\n    cols = [int(g[r, c]) for r, c in order]\n    return np.array(cols, dtype=int).reshape((-1, 1))\n\n# --------------- generator (Claude#1) ---------------\n\ndef _try_extend(path_set: set, last: tuple, dr: int, dc: int, count: int, H: int, W: int) -> list:\n    \"\"\"Try to extend the path by `count` steps in direction (dr,dc).\n    Returns the segment of new cells added, may be shorter than count.\"\"\"\n    segment = []\n    r, c = last\n    for i in range(1, count + 1):\n        nr, nc = r + dr * i, c + dc * i\n        if nr < 1 or nr >= H - 1 or nc < 1 or nc >= W - 1:\n            break\n        if (nr, nc) in path_set:\n            break\n        # The predecessor of this new cell is the previous cell in the segment,\n        # or `last` if it's the first cell in the segment.\n        pred = (r + dr * (i - 1), c + dc * (i - 1))\n        # Check no 4-neighbor in path_set except pred\n        bad = False\n        for ddr, ddc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nb = (nr + ddr, nc + ddc)\n            if nb != pred and nb in path_set:\n                bad = True\n                break\n        if bad:\n            break\n        segment.append((nr, nc))\n        path_set.add((nr, nc))\n    return segment\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H, W = 16, 16\n    bg = random.randint(0, 9)\n    non_bg_count = random.randint(3, 5)\n    palette = random.sample([c for c in range(10) if c != bg], non_bg_count)\n\n    target_len = random.randint(20, 30)\n\n    start_r = random.randint(1, 4)\n    start_c = random.randint(1, W - 2)\n\n    path = [(start_r, start_c)]\n    path_set = {(start_r, start_c)}\n    turns = 0\n    is_vertical = True\n    h_dir = random.choice([-1, 1])\n\n    while len(path) < target_len:\n        run_len = random.randint(1, 5)\n        run_len = min(run_len, target_len - len(path))\n        if run_len <= 0:\n            break\n\n        last = path[-1]\n        segment = []\n\n        if is_vertical:\n            v_dir = 1 if random.random() < 0.85 else -1\n            segment = _try_extend(path_set, last, v_dir, 0, run_len, H, W)\n            if not segment:\n                # Undo nothing (nothing was added), try other direction\n                segment = _try_extend(path_set, last, -v_dir, 0, run_len, H, W)\n        else:\n            segment = _try_extend(path_set, last, 0, h_dir, run_len, H, W)\n            if not segment:\n                segment = _try_extend(path_set, last, 0, -h_dir, run_len, H, W)\n                if segment:\n                    h_dir = -h_dir\n            # Flip h_dir for next horizontal segment\n            h_dir = -h_dir\n\n        if not segment:\n            break\n\n        path.extend(segment)\n        turns += 1\n        is_vertical = not is_vertical\n\n    total = len(path)\n    if total < 20 or total > 30:\n        return None\n    if turns < 7 or turns > 11:\n        return None\n\n    # Assign colors in contiguous segments, ensuring all palette colors appear\n    num_segments = random.randint(max(3, non_bg_count), 6)\n    seg_lengths = _random_partition(total, num_segments, min_len=2, max_len=9)\n    if seg_lengths is None:\n        return None\n\n    # Build color list: first use each palette color once (shuffled), then random\n    shuffled_palette = list(palette)\n    random.shuffle(shuffled_palette)\n    seg_colors = list(shuffled_palette[:num_segments])\n    while len(seg_colors) < num_segments:\n        choices = [c for c in palette if c != seg_colors[-1]]\n        seg_colors.append(random.choice(choices))\n    # Ensure no two adjacent segments have same color\n    for i in range(1, len(seg_colors)):\n        if seg_colors[i] == seg_colors[i - 1]:\n            choices = [c for c in palette if c != seg_colors[i - 1]]\n            seg_colors[i] = random.choice(choices)\n\n    colors = []\n    for seg_len, col in zip(seg_lengths, seg_colors):\n        colors.extend([col] * seg_len)\n\n    # Build grid\n    grid = np.full((H, W), bg, dtype=int)\n    for (r, c), col in zip(path, colors):\n        grid[r, c] = col\n\n    # Verify with solver\n    expected_out = np.array(colors, dtype=int).reshape(-1, 1)\n    actual_out = main(grid)\n    if not np.array_equal(actual_out, expected_out):\n        return None\n\n    return grid\n\n\ndef _random_partition(total: int, num_parts: int, min_len: int, max_len: int) -> list[int] | None:\n    \"\"\"Partition total into num_parts values each in [min_len, max_len].\"\"\"\n    if num_parts * min_len > total or num_parts * max_len < total:\n        return None\n    parts = [min_len] * num_parts\n    remaining = total - sum(parts)\n    for _ in range(remaining):\n        eligible = [i for i in range(num_parts) if parts[i] < max_len]\n        if not eligible:\n            return None\n        parts[random.choice(eligible)] += 1\n    random.shuffle(parts)\n    return parts\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate input after 300 attempts\")\n","exit_code":0,"status":"completed"}}
