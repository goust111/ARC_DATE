{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/2de01db2.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import Color\nimport math\nimport random\n\n\ndef _row_color(row: np.ndarray, bg: int) -> int:\n    counts = Counter(int(v) for v in row if int(v) != bg)\n    assert counts, \"each row must contain a non-bg color\"\n\n    max_count = max(counts.values())\n    candidates = [color for color, count in counts.items() if count == max_count]\n    if len(candidates) > 1:\n        first_col = {color: int(np.flatnonzero(row == color)[0]) for color in candidates}\n        leftmost = min(first_col.values())\n        candidates = [color for color in candidates if first_col[color] == leftmost]\n\n    assert len(candidates) == 1, \"row color must be structurally unique\"\n    return candidates[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Invert each row's native foreground color against the black background.\n\n    Input structure\n    - A black-background grid whose rows each have one native foreground color plus optional distractor colors.\n    - The native row color is the most frequent non-bg color in that row; if tied, its run starts leftmost among tied colors.\n\n    Rule\n    - For each row independently, turn pixels of the native row color into bg.\n    - Turn every other pixel in that row, including bg and distractor colors, into the native row color.\n\n    Key insight\n    - Distractor colors are not preserved objects; they mark cells that participate in the binary complement of the row's native color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = Color.BLACK\n    assert bool(np.any(g == bg)), \"black background must be present\"\n\n    out = np.empty_like(g)\n    for r in range(g.shape[0]):\n        color = _row_color(g[r], bg)\n        out[r] = np.where(g[r] == color, bg, color)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and retry bounds.\nGRID_HEIGHT, WIDTH_MIN, WIDTH_MAX = 3, 8, 14\nGENERATION_RETRIES = 300\n\n# Row native-color density.\nNATIVE_FRACTION_MIN, NATIVE_FRACTION_MAX = 0.30, 0.70\n\n# Distractor palette and per-row count limits.\nDISTRACTOR_PALETTE_MIN, DISTRACTOR_PALETTE_MAX = 0, 2\nROW_DISTRACTOR_PIXEL_MAX, ROW_DISTRACTOR_COLOR_MAX = 3, 2\n\n\ndef _infer_native_color(row: np.ndarray) -> int:\n    counts = Counter(int(v) for v in row if int(v) != Color.BLACK)\n    if not counts:\n        raise ValueError(\"row has no foreground color\")\n\n    max_count = max(counts.values())\n    candidates = [color for color, count in counts.items() if count == max_count]\n    if len(candidates) > 1:\n        first_col = {color: int(np.flatnonzero(row == color)[0]) for color in candidates}\n        leftmost = min(first_col.values())\n        candidates = [color for color in candidates if first_col[color] == leftmost]\n\n    if len(candidates) != 1:\n        raise ValueError(\"row native color is ambiguous\")\n    return candidates[0]\n\n\ndef _expected_output(grid: np.ndarray) -> np.ndarray:\n    out = np.empty_like(grid)\n    for r, row in enumerate(grid):\n        native = _infer_native_color(row)\n        out[r] = np.where(row == native, Color.BLACK, native)\n    return out\n\n\ndef _bounded_positive_split(total: int, parts: int, max_each: int) -> list[int]:\n    \"\"\"Return shuffled positive part sizes, capped by max_each.\"\"\"\n    counts = [1] * parts\n    remaining = total - parts\n    while remaining:\n        choices = [i for i, count in enumerate(counts) if count < max_each]\n        i = random.choice(choices)\n        counts[i] += 1\n        remaining -= 1\n    random.shuffle(counts)\n    return counts\n\n\ndef _sample_palette() -> tuple[list[int], list[int]]:\n    \"\"\"Return one native color per row plus the shared distractor palette.\"\"\"\n    native_colors = random.sample(Color.NOT_BLACK, GRID_HEIGHT)\n    distractor_pool = [color for color in Color.NOT_BLACK if color not in native_colors]\n    distractor_color_count = random.randint(DISTRACTOR_PALETTE_MIN, DISTRACTOR_PALETTE_MAX)\n    return native_colors, random.sample(distractor_pool, distractor_color_count)\n\n\ndef _fill_row(row: np.ndarray, native: int, distractor_colors: list[int]) -> None:\n    \"\"\"Place one row's native pixels first, then optional distractor pixels.\"\"\"\n    width = row.size\n    min_native = math.ceil(NATIVE_FRACTION_MIN * width)\n    max_native = math.floor(NATIVE_FRACTION_MAX * width)\n    native_count = random.randint(min_native, max_native)\n\n    max_distractor_pixels = min(ROW_DISTRACTOR_PIXEL_MAX, width - native_count - 1)\n    if distractor_colors:\n        max_distractor_pixels = min(max_distractor_pixels, len(distractor_colors) * (native_count - 1))\n    else:\n        max_distractor_pixels = 0\n    distractor_count = random.randint(0, max_distractor_pixels)\n\n    native_cols = random.sample(range(width), native_count)\n    row[native_cols] = native\n    if not distractor_count:\n        return\n\n    min_distractor_colors = math.ceil(distractor_count / (native_count - 1))\n    max_distractor_colors = min(len(distractor_colors), ROW_DISTRACTOR_COLOR_MAX, distractor_count)\n    row_distractor_count = random.randint(min_distractor_colors, max_distractor_colors)\n    row_distractors = random.sample(distractor_colors, row_distractor_count)\n    per_color_counts = _bounded_positive_split(\n        distractor_count,\n        row_distractor_count,\n        native_count - 1,\n    )\n\n    free_cols = [c for c in range(width) if c not in native_cols]\n    distractor_cols = random.sample(free_cols, distractor_count)\n    start = 0\n    for color, count in zip(row_distractors, per_color_counts):\n        cols = distractor_cols[start : start + count]\n        row[cols] = color\n        start += count\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    width = random.randint(WIDTH_MIN, WIDTH_MAX)\n    grid = np.full((GRID_HEIGHT, width), Color.BLACK, dtype=int)\n    native_colors, distractor_colors = _sample_palette()\n    for row, native in zip(grid, native_colors):\n        _fill_row(row, native, distractor_colors)\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        inp = _gen_attempt()\n        if inp is None:\n            continue\n        expected = _expected_output(inp)\n        try:\n            actual = main(inp)\n        except Exception:\n            continue\n        if np.array_equal(actual, expected):\n            return inp\n    raise RuntimeError(\"failed to generate a valid 2de01db2 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/2a28add5.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import Color, get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Paint each pink control pixel as a teal horizontal bar whose reach equals the foreground counts on that row.\n\n    Input structure\n    - The grid has a dominant background color and one or more pink control pixels.\n    - Each marker row has exactly one pink pixel; all other non-background pixels\n      in that row are counters.\n    Rule\n    - Start from an all-background output grid.\n    - For each pink pixel, count non-background pixels strictly to its left and\n      strictly to its right in the same row.\n    - Paint teal from c - left_count through c + right_count on that row.\n    Key insight\n    - The foreground pixels are not copied; only their counts on each side of\n      each pink marker encode the teal bar length.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    assert bg not in (Color.PINK, Color.TEAL)\n\n    markers = np.argwhere(g == Color.PINK)\n    assert len(markers) > 0\n\n    out = np.full_like(g, bg)\n    for r, c in markers:\n        assert np.count_nonzero(g[r] == Color.PINK) == 1\n        left_count = int(np.count_nonzero(g[r, :c] != bg))\n        right_count = int(np.count_nonzero(g[r, c + 1 :] != bg))\n\n        start = int(c) - left_count\n        end = int(c) + right_count\n        assert 0 <= start <= c <= end < g.shape[1]\n        out[int(r), start : end + 1] = Color.TEAL\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and color palette.\nGRID_HEIGHT, GRID_WIDTH, BACKGROUND_COLOR = 10, 10, 7\nCOUNTER_COLORS = [0, 1, 2, 3, 4, 5, Color.TEAL, 9]\n\n# Marker-row counts and encoded teal bar lengths.\nMARKER_COUNT_RANGE, SIDE_COUNT_RANGE, BAR_LENGTH_RANGE = (4, 5), range(6), (3, 7)\nVALID_SIDE_COUNTS = [\n    (left, right)\n    for left in SIDE_COUNT_RANGE\n    for right in SIDE_COUNT_RANGE\n    if BAR_LENGTH_RANGE[0] <= left + right + 1 <= BAR_LENGTH_RANGE[1]\n]\n\n# Distractor density and retry budget.\nDISTRACTOR_COUNT_RANGE, GENERATION_RETRY_LIMIT = (0, 7), 300\n\ndef _balanced_counter_color():\n    \"\"\"Yield counter colors from shuffled complete bags.\"\"\"\n    bag = []\n    while True:\n        if not bag:\n            bag = COUNTER_COLORS[:]\n            random.shuffle(bag)\n        yield bag.pop()\n\ndef _choose_row_spec(row):\n    left_count, right_count = random.choice(VALID_SIDE_COUNTS)\n    col = random.randint(left_count, GRID_WIDTH - right_count - 1)\n    return row, col, left_count, right_count\n\ndef _choose_row_specs():\n    \"\"\"Return marker rows and specs as (row, pink_col, left_count, right_count).\"\"\"\n    marker_count = random.randint(*MARKER_COUNT_RANGE)\n    marker_rows = sorted(random.sample(range(GRID_HEIGHT), marker_count))\n    return marker_rows, [_choose_row_spec(row) for row in marker_rows]\n\ndef _scatter_marker_rows(inp, row_specs, colors):\n    for row, col, left_count, right_count in row_specs:\n        inp[row, col] = Color.PINK\n        left_cols = random.sample(range(col), left_count)\n        right_cols = random.sample(range(col + 1, GRID_WIDTH), right_count)\n        counter_cols = left_cols + right_cols\n        random.shuffle(counter_cols)\n        for cc in counter_cols:\n            inp[row, cc] = next(colors)\n\ndef _scatter_distractor_rows(inp, marker_rows, colors):\n    marker_row_set = set(marker_rows)\n    for row in range(GRID_HEIGHT):\n        if row in marker_row_set:\n            continue\n        count = random.randint(*DISTRACTOR_COUNT_RANGE)\n        for col in random.sample(range(GRID_WIDTH), count):\n            inp[row, col] = next(colors)\n\ndef _gen_attempt() -> np.ndarray | None:\n    marker_rows, row_specs = _choose_row_specs()\n    out = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)\n    for row, col, left_count, right_count in row_specs:\n        out[row, col - left_count : col + right_count + 1] = Color.TEAL\n\n    inp = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)\n    colors = _balanced_counter_color()\n\n    _scatter_marker_rows(inp, row_specs, colors)\n    _scatter_distractor_rows(inp, marker_rows, colors)\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input for 2a28add5\")\n","exit_code":0,"status":"completed"}}
