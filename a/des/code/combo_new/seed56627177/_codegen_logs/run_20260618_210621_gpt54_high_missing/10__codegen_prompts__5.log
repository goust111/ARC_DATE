{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/753ea09b.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg, label_mask, neighbors4, paste\nimport itertools\nimport random\n\n\ndef _unique_largest_color(g: np.ndarray, colors: list[int]) -> int:\n    counts = Counter(int(v) for v in g.ravel())\n    ranked = sorted(colors, key=lambda color: counts[int(color)], reverse=True)\n    assert len(ranked) >= 2, \"expected at least two candidate colors\"\n    assert counts[ranked[0]] > counts[ranked[1]], \"foreground majority must be unique\"\n    return int(ranked[0])\n\n\ndef _long_component_ids(lab: np.ndarray, n: int) -> set[int]:\n    h = int(lab.shape[0])\n    min_row_span = max(1, h // 3)\n    ids: set[int] = set()\n    for comp_id in range(1, n + 1):\n        coords = np.argwhere(lab == comp_id)\n        assert coords.size > 0, \"component labels must be nonempty\"\n        r0 = int(coords[:, 0].min())\n        r1 = int(coords[:, 0].max())\n        if r1 - r0 + 1 >= min_row_span:\n            ids.add(int(comp_id))\n    assert len(ids) >= 2, \"expected at least two long contour components\"\n    return ids\n\n\ndef _two_exterior_bg_ids(bg_lab: np.ndarray, n_bg: int) -> set[int]:\n    assert n_bg >= 3, \"expected interior and exterior background regions\"\n    sizes = {comp_id: int((bg_lab == comp_id).sum()) for comp_id in range(1, n_bg + 1)}\n    size_values = sorted(sizes.values(), reverse=True)\n    assert size_values[1] > size_values[2], \"two exterior regions must be separated by size\"\n    cutoff = size_values[1]\n    exterior = {comp_id for comp_id, size in sizes.items() if size >= cutoff}\n    assert len(exterior) == 2, \"expected exactly two exterior background regions\"\n    return exterior\n\n\ndef _touches_long_contour(\n    coords: np.ndarray,\n    fill_lab: np.ndarray,\n    long_ids: set[int],\n) -> bool:\n    for r, c in coords:\n        for rr, cc in neighbors4(int(r), int(c)):\n            if 0 <= rr < fill_lab.shape[0] and 0 <= cc < fill_lab.shape[1]:\n                if int(fill_lab[rr, cc]) in long_ids:\n                    return True\n    return False\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the small background compartments bounded by the long contour color.\n\n    Input structure:\n    - The grid has one dominant background color and two foreground colors.\n    - The more frequent foreground color forms long 8-connected contour fragments.\n    - The other foreground color is a fixed distractor/obstacle color that partitions\n      the background but is never recolored.\n\n    Rule:\n    - Split the background into 4-connected regions using all foreground pixels as\n      barriers.\n    - Keep the two largest background regions as the outside of the contour drawing.\n    - Recolor every other background region that touches a long contour component\n      to the contour color; leave all foreground pixels unchanged.\n\n    Key insight:\n    The apparent area fill is exactly a component-level fill of bounded background\n    compartments, not a row-wise interpolation between individual contour pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    foreground = colors_present(g, exclude={bg})\n    assert len(foreground) == 2, \"expected exactly two foreground colors\"\n\n    fill_color = _unique_largest_color(g, foreground)\n    fill_lab, _n_fill = label_mask(g == fill_color, connectivity=8)\n    long_ids = _long_component_ids(fill_lab, _n_fill)\n\n    bg_lab, n_bg = label_mask(g == bg, connectivity=4)\n    exterior_ids = _two_exterior_bg_ids(bg_lab, n_bg)\n\n    out = g.copy()\n    for comp_id in range(1, n_bg + 1):\n        if comp_id in exterior_ids:\n            continue\n        coords = np.argwhere(bg_lab == comp_id)\n        if _touches_long_contour(coords, fill_lab, long_ids):\n            out[bg_lab == comp_id] = fill_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\nH, W = 30, 30\nGRID_SHAPE = (H, W)\nARC_COLOR_COUNT = 10\n\n# Long contour path layout.\nPATH_COUNT_OPTIONS = (2, 3)\nPATH_STEP_OPTIONS = (-1, 0, 1)\nPATH_GAP_MIN, PATH_GAP_MAX = 2, 5\nPATH_LEFT_MIN_COL, PATH_RIGHT_MARGIN = 2, 3\nPATH_START_MIN_COL = 3\nPATH_START_RIGHT_MARGIN = 4\nPATH_FAR_END_MIN_CHOICES, PATH_FAR_END_PROB, PATH_FAR_END_DELTA = 8, 0.7, 5\nPATH_SCORING_CANDIDATES = 5\nPATH_MIN_MOVES = 12\n\n# Contour distractors and extra contour pixels.\nOUTSIDE_MARGIN = 2\nOUTSIDE_SIDE_OPTIONS = (-1, 1)\nSHORT_FRAGMENT_COUNT_MIN, SHORT_FRAGMENT_COUNT_MAX = 3, 5\nSHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX = 1, 4\nSHORT_FRAGMENT_ATTEMPTS = 200\nSHORT_FRAGMENT_PATH_PADDING = 3\nCONTOUR_PIXELS_MIN, CONTOUR_PIXELS_MAX = 81, 108\n\n# Obstacle bars and scattered clusters.\nBAR_SEGMENT_MAX = 11\nSINGLE_CHANNEL_BARS_MIN, SINGLE_CHANNEL_BARS_MAX = 5, 11\nMULTI_CHANNEL_TOTAL_BARS_MIN, MULTI_CHANNEL_TOTAL_BARS_MAX = 4, 10\nMULTI_CHANNEL_INITIAL_BARS = 2\nMULTI_CHANNEL_MAX_BARS = 5\nBAR_WIDTH_MIN, BAR_WIDTH_MAX = 1, 5\nOBSTACLE_PIXELS_MIN, OBSTACLE_PIXELS_MAX = 36, 63\nOBSTACLE_EXTRA_PIXELS_MIN = 8\nOBSTACLE_OUTSIDE_QUOTA_MIN, OBSTACLE_OUTSIDE_QUOTA_MAX = 8, 16\nOBSTACLE_CLUSTER_SIZE_MIN, OBSTACLE_CLUSTER_SIZE_MAX = 1, 5\nOBSTACLE_ATTEMPTS = 300\nOBSTACLE_ZONE_OPTIONS = (\"outside\", \"inside\", \"any\")\n\n# Component validation.\nBG_REGIONS_MIN, BG_REGIONS_MAX = 8, 14\nEXTERIOR_REGION_COUNT = 2\nINTERIOR_REGIONS_MIN, INTERIOR_REGIONS_MAX = 6, 12\nINTERIOR_REGION_AREA_MAX = 57\nLONG_COMPONENT_MIN_SPAN = H // 3\nLONG_COMPONENT_COUNT_OPTIONS = (2, 3)\n\n# Retry limits and local neighborhoods.\nGENERATION_ATTEMPTS = 300\nNEIGHBOR_DELTAS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nNEIGHBOR_DELTAS_8 = NEIGHBOR_DELTAS_4 + ((-1, -1), (-1, 1), (1, -1), (1, 1))\n\n\ndef _color_choices() -> tuple[int, int, int]:\n    colors = list(range(ARC_COLOR_COUNT))\n    random.shuffle(colors)\n    return int(colors[0]), int(colors[1]), int(colors[2])\n\n\ndef _path_columns(path_count: int) -> list[list[int]] | None:\n    gaps = [random.randint(PATH_GAP_MIN, PATH_GAP_MAX) for _ in range(path_count - 1)]\n    total_width = sum(gap + 1 for gap in gaps)\n    start_hi = W - PATH_START_RIGHT_MARGIN - total_width\n    if start_hi < PATH_START_MIN_COL:\n        return None\n\n    start = random.randint(PATH_START_MIN_COL, start_hi)\n    end_choices = list(range(PATH_START_MIN_COL, start_hi + 1))\n    if len(end_choices) > PATH_FAR_END_MIN_CHOICES and random.random() < PATH_FAR_END_PROB:\n        far = [c for c in end_choices if abs(c - start) >= PATH_FAR_END_DELTA]\n        if far:\n            end_choices = far\n    end = random.choice(end_choices)\n\n    cols = [start]\n    for gap in gaps:\n        cols.append(cols[-1] + gap + 1)\n    targets = [c + (end - start) for c in cols]\n\n    paths = [[int(c)] for c in cols]\n    for r in range(1, H):\n        valid: list[list[int]] = []\n        for steps in itertools.product(PATH_STEP_OPTIONS, repeat=path_count):\n            nxt = [cols[i] + steps[i] for i in range(path_count)]\n            if nxt[0] < PATH_LEFT_MIN_COL or nxt[-1] > W - PATH_RIGHT_MARGIN:\n                continue\n            if all(PATH_GAP_MIN <= nxt[i + 1] - nxt[i] - 1 <= PATH_GAP_MAX for i in range(path_count - 1)):\n                valid.append(nxt)\n        if not valid:\n            return None\n        ideal = [paths[i][0] + (targets[i] - paths[i][0]) * r / (H - 1) for i in range(path_count)]\n        scored = sorted(\n            valid,\n            key=lambda nxt: sum(abs(nxt[i] - ideal[i]) for i in range(path_count)) + random.random(),\n        )\n        cols = random.choice(scored[: max(1, min(PATH_SCORING_CANDIDATES, len(scored)))])\n        for i, c in enumerate(cols):\n            paths[i].append(int(c))\n\n    moves = sum(paths[i][r] != paths[i][r - 1] for i in range(path_count) for r in range(1, H))\n    if moves < PATH_MIN_MOVES:\n        return None\n    return paths\n\n\ndef _outside_enclosure(paths: list[list[int]], r: int, c: int, margin: int = OUTSIDE_MARGIN) -> bool:\n    return c <= paths[0][r] - margin or c >= paths[-1][r] + margin\n\n\ndef _inside_channel(paths: list[list[int]], r: int, c: int) -> bool:\n    return any(paths[i][r] < c < paths[i + 1][r] for i in range(len(paths) - 1))\n\n\ndef _touches_mask(mask: np.ndarray, coords: list[tuple[int, int]], connectivity: int) -> bool:\n    seen = set(coords)\n    deltas = NEIGHBOR_DELTAS_8 if connectivity == 8 else NEIGHBOR_DELTAS_4\n    for r, c in coords:\n        for dr, dc in deltas:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in seen and mask[rr, cc]:\n                return True\n    return False\n\n\ndef _place_short_fragments(\n    grid: np.ndarray, contour_mask: np.ndarray, paths: list[list[int]], contour: int, count: int\n) -> bool:\n    for _ in range(count):\n        size = random.randint(SHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX)\n        placed = False\n        for _attempt in range(SHORT_FRAGMENT_ATTEMPTS):\n            r = random.randrange(H)\n            side = random.choice(OUTSIDE_SIDE_OPTIONS)\n            if side < 0:\n                hi = paths[0][r] - SHORT_FRAGMENT_PATH_PADDING - size + 1\n                if hi < 0:\n                    continue\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/abbfd121.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, paste, random_free_location\nimport random\n\n\nRect = tuple[int, int, int, int, int, int]  # (area, color, r0, c0, r1, c1)\n\n\ndef _solid_rectangles(g: np.ndarray) -> list[Rect]:\n    rects: list[Rect] = []\n    for color in np.unique(g):\n        for coords in components_mask(g == int(color), connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(coords)\n            h = r1 - r0 + 1\n            w = c1 - c0 + 1\n            area = int(coords.shape[0])\n            if h > 1 and w > 1 and area == h * w:\n                rects.append((area, int(color), r0, c0, r1, c1))\n    return rects\n\n\ndef _period_values(\n    g: np.ndarray, blocked: np.ndarray, row_period: int, col_period: int\n) -> dict[tuple[int, int], int] | None:\n    values: dict[tuple[int, int], int] = {}\n    h, w = g.shape\n    for r in range(h):\n        for c in range(w):\n            if blocked[r, c]:\n                continue\n            key = (r % row_period, c % col_period)\n            value = int(g[r, c])\n            if key in values and values[key] != value:\n                return None\n            values[key] = value\n    return values\n\n\ndef _reconstruct_rect(\n    values: dict[tuple[int, int], int], row_period: int, col_period: int, rect: Rect\n) -> np.ndarray:\n    _, _, r0, c0, r1, c1 = rect\n    out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)\n    for rr, r in enumerate(range(r0, r1 + 1)):\n        for cc, c in enumerate(range(c0, c1 + 1)):\n            key = (r % row_period, c % col_period)\n            assert key in values, \"period residue must be visible outside the rectangles\"\n            out[rr, cc] = values[key]\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recover the repeating background pattern hidden under the largest solid rectangle.\n\n    Input structure:\n    - The grid is covered by a small row/column periodic pattern.\n    - Several non-pattern colors form solid rectangular foreground objects that\n      overwrite the pattern.\n    - The requested output region is the largest of those solid rectangles.\n\n    Rule:\n    - Find every 4-connected monochromatic object whose bounding box is a filled\n      rectangle with both dimensions greater than one.\n    - Treat those rectangles as masks, infer the smallest repeating tile that is\n      consistent with all remaining visible pixels, and repaint the largest\n      rectangle's coordinates with that tile.\n\n    Key insight: The rectangle colors are occluders; the visible pixels outside\n    them are enough to reconstruct the original periodic background underneath.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    rects = _solid_rectangles(g)\n    assert rects, \"expected at least one solid rectangular occluder\"\n\n    max_area = max(area for area, *_ in rects)\n    targets = [rect for rect in rects if rect[0] == max_area]\n    assert len(targets) == 1, \"largest rectangle must be unique\"\n    target = targets[0]\n\n    blocked = np.zeros(g.shape, dtype=bool)\n    for _, _, r0, c0, r1, c1 in rects:\n        blocked[r0 : r1 + 1, c0 : c1 + 1] = True\n\n    h, w = g.shape\n    period_candidates: list[tuple[int, int, dict[tuple[int, int], int]]] = []\n    for row_period in range(1, h + 1):\n        for col_period in range(1, w + 1):\n            values = _period_values(g, blocked, row_period, col_period)\n            if values is not None:\n                period_candidates.append((row_period, col_period, values))\n    assert period_candidates, \"visible pixels must define a periodic pattern\"\n\n    min_period_area = min(rp * cp for rp, cp, _ in period_candidates)\n    outputs = [\n        _reconstruct_rect(values, row_period, col_period, target)\n        for row_period, col_period, values in period_candidates\n        if row_period * col_period == min_period_area\n    ]\n    assert outputs, \"expected at least one minimal period\"\n    first = outputs[0]\n    assert all(np.array_equal(first, out) for out in outputs), \"minimal periods must agree\"\n    return first\n\n# --------------- generator (att2) ---------------\n\n# Tile palette and period choices.\n_GEN_COLOR_RANGE = range(10)\n_GEN_TILE_SIZES = [3, 4]\n_GEN_TILE_COLOR_COUNTS = [3, 4]\n_GEN_STEP_CHOICES = {3: [1, 2], 4: [1, 3]}\n# Canvas dimensions from the observed task family.\n_GEN_HEIGHT_RANGE = (19, 23)\n_GEN_WIDTH_RANGE = (19, 22)\n# Occluder rectangle count, size, and coverage constraints.\n_GEN_RECT_COUNTS = [2, 3]\n_GEN_RECT_SIDE_RANGE = range(3, 13)\n_GEN_AREA_RANGE = (9, 100)\n_GEN_TARGET_AREA_RANGE = (36, 100)\n_GEN_COVERAGE_RANGE = (0.18, 0.33)\n# Rejection sampling budget.\n_GEN_ATTEMPT_LIMIT = 300\n\n_GEN_DIMS_BY_AREA = {\n    h * w: [(hh, ww) for hh in _GEN_RECT_SIDE_RANGE for ww in _GEN_RECT_SIDE_RANGE if hh * ww == h * w]\n    for h in _GEN_RECT_SIDE_RANGE\n    for w in _GEN_RECT_SIDE_RANGE\n}\n\n\ndef _gen_tile() -> np.ndarray:\n    size = random.choice(_GEN_TILE_SIZES)\n    n_colors = random.choice(_GEN_TILE_COLOR_COUNTS) if size == 3 else 4\n    colors = random.sample(_GEN_COLOR_RANGE, n_colors)\n    step_choices = _GEN_STEP_CHOICES[n_colors]\n    row_step = random.choice(step_choices)\n    col_step = random.choice(step_choices)\n    offset = random.randrange(n_colors)\n    tile = np.empty((size, size), dtype=int)\n    for r in range(size):\n        for c in range(size):\n            tile[r, c] = colors[(offset + row_step * r + col_step * c) % n_colors]\n    return tile\n\n\ndef _gen_periodic_grid(tile: np.ndarray, height: int, width: int) -> np.ndarray:\n    rows = np.arange(height)[:, None] % tile.shape[0]\n    cols = np.arange(width)[None, :] % tile.shape[1]\n    return tile[rows, cols].astype(int, copy=True)\n\n\ndef _gen_choose_areas(height: int, width: int, count: int) -> tuple[int, ...] | None:\n    min_total = int(np.ceil(_GEN_COVERAGE_RANGE[0] * height * width))\n    max_total = int(np.floor(_GEN_COVERAGE_RANGE[1] * height * width))\n    area_min, area_max = _GEN_AREA_RANGE\n    target_min, target_max = _GEN_TARGET_AREA_RANGE\n    small_areas = sorted(a for a in _GEN_DIMS_BY_AREA if area_min <= a <= area_max)\n    target_areas = [a for a in small_areas if target_min <= a <= target_max]\n    possible: dict[int, list[tuple[int, ...]]] = {}\n    for total in range(min_total, max_total + 1):\n        tuples: list[tuple[int, ...]] = []\n        for target in target_areas:\n            if count == 2:\n                small = total - target\n                if small in _GEN_DIMS_BY_AREA and area_min <= small < target:\n                    tuples.append((target, small))\n            else:\n                rem = total - target\n                for small1 in small_areas:\n                    small2 = rem - small1\n                    if (\n                        area_min <= small1 < target\n                        and area_min <= small2 < target\n                        and small2 in _GEN_DIMS_BY_AREA\n                    ):\n                        tuples.append((target, small1, small2))\n        if tuples:\n            possible[total] = tuples\n    if not possible:\n        return None\n    total = random.choice(list(possible))\n    return random.choice(possible[total])\n\n\ndef _gen_place_rectangles(shape: tuple[int, int], dims: list[tuple[int, int]]) -> list[tuple[int, int, int, int]] | None:\n    occupied = np.zeros(shape, dtype=int)\n    placed: list[tuple[int, int, int, int]] = []\n    for rect_h, rect_w in dims:\n        patch = np.ones((rect_h, rect_w), dtype=int)\n        try:\n            row, col = random_free_location(occupied, patch, transparent=0)\n        except ValueError:\n            return None\n        paste(occupied, patch, row, col)\n        placed.append((row, col, rect_h, rect_w))\n    return placed\n\n\ndef _gen_all_residues_visible(occupied: np.ndarray, row_period: int, col_period: int) -> bool:\n    seen = np.zeros((row_period, col_period), dtype=bool)\n    for residue_r in range(row_period):\n        for residue_c in range(col_period):\n            seen[residue_r, residue_c] = np.any(\n                occupied[residue_r::row_period, residue_c::col_period] == 0\n            )\n    return bool(seen.all())\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    tile = _gen_tile()\n    height = random.randint(*_GEN_HEIGHT_RANGE)\n    width = random.randint(*_GEN_WIDTH_RANGE)\n    base = _gen_periodic_grid(tile, height, width)\n\n    count = random.choice(_GEN_RECT_COUNTS)\n    areas = _gen_choose_areas(height, width, count)\n    if areas is None:\n        return None\n\n    dims = [random.choice(_GEN_DIMS_BY_AREA[area]) for area in areas]\n    placed = _gen_place_rectangles((height, width), dims)\n    if placed is None:\n        return None\n\n    occupied = np.zeros((height, width), dtype=int)\n    for row, col, rect_h, rect_w in placed:\n        occupied[row : row + rect_h, col : col + rect_w] = 1\n    if not _gen_all_residues_visible(occupied, tile.shape[0], tile.shape[1]):\n        return None\n\n    target_row, target_col, target_h, target_w = placed[0]\n    expected = base[target_row : target_row + target_h, target_col : target_col + target_w].copy()\n    tile_colors = set(map(int, tile.ravel()))\n    occluder_colors = random.sample([c for c in _GEN_COLOR_RANGE if c not in tile_colors], count)\n\n    grid = base.copy()\n    for color, (row, col, rect_h, rect_w) in zip(occluder_colors, placed):\n        patch = np.full((rect_h, rect_w), color, dtype=int)\n        paste(grid, patch, row, col)\n\n    try:\n        actual = main(grid)\n    except Exception:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_ATTEMPT_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"generate_input: failed after {_GEN_ATTEMPT_LIMIT} attempts\")\n","exit_code":0,"status":"completed"}}
