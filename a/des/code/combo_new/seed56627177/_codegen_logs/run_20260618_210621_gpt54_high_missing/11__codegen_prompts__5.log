{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,520p' /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom arc_utils import get_bg, in_bounds, neighbors4, label_mask\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect framed squares via colored bridges following a control-pixel sequence.\n\n    Input structure:\n    - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.\n    - Control row below squares: colored pixels read left-to-right encode visitation order.\n\n    Rule:\n    - Start at the square matching first control color c0.\n    - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.\n    - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.\n\n    Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # border color = most common non-bg color\n    cnt = Counter(map(int, g.flatten()))\n    border = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            border = int(col)\n            break\n    assert not (border is None)\n\n    # detect framed squares as connected components of the border color\n    lab, n = label_mask(g == int(border), connectivity=4)\n    frames: list[dict] = []\n    for cid in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(cid))\n        if int(pts.shape[0]) < 8:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        if h < 3 or w < 3:\n            continue\n\n        t = None\n        inner_col = None\n        for tt in range(1, int(min(h, w) // 2) + 1):\n            inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]\n            if inner.size == 0:\n                continue\n            if bool((inner == int(border)).any()):\n                continue\n            u = set(map(int, inner.flatten()))\n            if len(u) != 1:\n                continue\n\n            ok = True\n            if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not ok:\n                continue\n\n            t = int(tt)\n            inner_col = int(next(iter(u)))\n            break\n\n        if t is None or inner_col is None:\n            continue\n\n        frames.append(\n            {\n                \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n                \"t\": int(t),\n                \"inner\": int(inner_col),\n                \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            }\n        )\n\n    assert not (not frames)\n\n    by: dict[int, list[dict]] = defaultdict(list)\n    for f in frames:\n        by[int(f[\"inner\"])].append(f)\n\n    max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n\n    # control row = bottom-most row below the squares with >=2 non-bg pixels\n    ctrl_r = None\n    for r in range(int(H - 1), int(max_frame_r), -1):\n        if int((g[int(r)] != int(bg)).sum()) >= 2:\n            ctrl_r = int(r)\n            break\n    assert not (ctrl_r is None)\n\n    ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n    assert not (len(ctrl) < 2)\n\n    def center(f: dict) -> tuple[int, int]:\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        return int((r0 + r1) // 2), int((c0 + c1) // 2)\n\n    def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n        a = f1[\"inner_bbox\"]\n        b = f2[\"inner_bbox\"]\n        same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n        same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))\n        return same_row, same_col\n\n    # choose start frame\n    start_color = int(ctrl[0])\n    assert not (start_color not in by)\n    start_cands = by[start_color]\n    if len(start_cands) == 1:\n        cur = start_cands[0]\n    else:\n        nxt_color = int(ctrl[1])\n        nxt_cands = by.get(nxt_color, [])\n        best = None\n        bestf = None\n        for f in start_cands:\n            for g2 in (nxt_cands if nxt_cands else [f]):\n                sr, sc = aligned(f, g2)\n                al = 1 if (sr or sc) else 0\n                (r1_, c1_) = center(f)\n                (r2_, c2_) = center(g2)\n                d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n                cand = (int(al), -int(d))\n                if best is None or cand > best:\n                    best = cand\n                    bestf = f\n        cur = bestf\n\n    out = g.copy()\n\n    def draw_bridge(fa: dict, fb: dict, color: int) -> None:\n        (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n        (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n        ia = fa[\"inner_bbox\"]\n        sr, sc = aligned(fa, fb)\n        if sr:\n            rr0, rr1 = int(ia[0]), int(ia[2])\n            if int(c1a) < int(c0b):\n                cc0, cc1 = int(c1a + 1), int(c0b - 1)\n            else:\n                cc0, cc1 = int(c1b + 1), int(c0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n            return\n        if sc:\n            cc0, cc1 = int(ia[1]), int(ia[3])\n            if int(r1a) < int(r0b):\n                rr0, rr1 = int(r1a + 1), int(r0b - 1)\n            else:\n                rr0, rr1 = int(r1b + 1), int(r0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n\n    for i in range(int(len(ctrl)) - 1):\n        a = int(ctrl[i])\n        b = int(ctrl[i + 1])\n        assert int(cur[\"inner\"]) == int(a)\n        assert b in by, f\"control color {b} has no matching frame\"\n        cands = by[b]\n        best = None\n        bestf = None\n        for f in cands:\n            sr, sc = aligned(cur, f)\n            al = 1 if (sr or sc) else 0\n            (r1_, c1_) = center(cur)\n            (r2_, c2_) = center(f)\n            d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n            cand = (int(al), -int(d))\n            if best is None or cand > best:\n                best = cand\n                bestf = f\n        nxt = bestf\n        draw_bridge(cur, nxt, int(a))\n        cur = nxt\n\n    return out\n\n\ndef _most_common_nonbg(g: np.ndarray, bg: int) -> int | None:\n    cnt = Counter(map(int, g.flatten()))\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            return int(col)\n    return None\n\ndef _draw_frame(g: np.ndarray, *, r0: int, c0: int, outer: int, t: int, border: int, inner_col: int) -> None:\n    g[int(r0) : int(r0 + outer), int(c0) : int(c0 + outer)] = int(border)\n    g[int(r0 + t) : int(r0 + outer - t), int(c0 + t) : int(c0 + outer - t)] = int(inner_col)\n\ndef _bridge_cells(fa: dict, fb: dict) -> set[tuple[int, int]]:\n    (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n    (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n    ia = fa[\"inner_bbox\"]\n    ib = fb[\"inner_bbox\"]\n    # same-row band\n    if int(ia[0]) == int(ib[0]) and int(ia[2]) == int(ib[2]):\n        rr0, rr1 = int(ia[0]), int(ia[2])\n        if int(c1a) < int(c0b):\n            cc0, cc1 = int(c1a + 1), int(c0b - 1)\n        else:\n            cc0, cc1 = int(c1b + 1), int(c0a - 1)\n        assert int(cc0) <= int(cc1), \"horizontal bridge gap must be non-empty\"\n        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n    # same-col band\n    if int(ia[1]) == int(ib[1]) and int(ia[3]) == int(ib[3]):\n        cc0, cc1 = int(ia[1]), int(ia[3])\n        if int(r1a) < int(r0b):\n            rr0, rr1 = int(r1a + 1), int(r0b - 1)\n        else:\n            rr0, rr1 = int(r1b + 1), int(r0a - 1)\n        assert int(rr0) <= int(rr1), \"vertical bridge gap must be non-empty\"\n        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n    return set()\n\n_DIGITS = [int(i) for i in range(10)]\n\ndef _gen_attempt() -> np.ndarray | None:\n    # --- colors ---\n    bg = int(np.random.choice(np.array(_DIGITS, dtype=int)))\n    border = int(np.random.choice(np.array([d for d in _DIGITS if int(d) != int(bg)], dtype=int)))\n    inner_palette = [int(d) for d in _DIGITS if int(d) not in (int(bg), int(border))]\n    if len(inner_palette) < 3:\n        return None\n\n    # --- geometry ---\n    t = int(np.random.choice(np.array([1, 1, 2], dtype=int)))\n    inner = int(np.random.randint(1, 4))  # 1..3\n    outer = int(inner + 2 * t)\n    if not (3 <= int(outer) <= 7):\n        return None\n\n    # lattice dims and number of squares (all on the path)\n    R = int(np.random.randint(2, 6))\n    C = int(np.random.randint(2, 6))\n    max_frames = int(R * C)\n    if max_frames < 4:\n        return None\n    n_frames = int(np.random.randint(4, int(min(12, max_frames)) + 1))\n\n    # sample a self-avoiding path of length n_frames starting at (0,0)\n    path: list[tuple[int, int]] | None = None\n    for _path_try in range(400):\n        p = [(0, 0)]\n        vis = {(0, 0)}\n        ok = True\n        for _ in range(int(n_frames) - 1):\n            cur = p[-1]\n            r, c = map(int, cur)\n            opts = [\n                (int(rr), int(cc))\n                for rr, cc in neighbors4(int(r), int(c))\n                if in_bounds((int(R), int(C)), int(rr), int(cc)) and (int(rr), int(cc)) not in vis\n            ]\n            if not opts:\n                ok = False\n                break\n            nxt = opts[int(np.random.randint(0, len(opts)))]\n            p.append((int(nxt[0]), int(nxt[1])))\n            vis.add((int(nxt[0]), int(nxt[1])))\n        if not ok:\n            continue\n        # Prefer scenes that span multiple rows/cols (matches eval's \"lattice\" feel).\n        if len({r for r, _c in p}) < 2 or len({c for _r, c in p}) < 2:\n            continue\n        path = p\n        break\n    if path is None:\n        return None\n\n    # sample uneven row/col gaps (eval-like) but keep at least 1 bg cell separation\n    row_gap = [int(np.random.randint(1, 6)) for _ in range(int(R) - 1)]\n    col_gap = [int(np.random.randint(1, 6)) for _ in range(int(C) - 1)]\n    top_margin = int(np.random.randint(1, 4))\n    left_margin = int(np.random.randint(1, 4))\n\n    r0s = [int(top_margin)]\n    for k in range(int(R) - 1):\n        r0s.append(int(r0s[-1] + outer + row_gap[int(k)]))\n    c0s = [int(left_margin)]\n    for k in range(int(C) - 1):\n        c0s.append(int(c0s[-1] + outer + col_gap[int(k)]))\n\n    # frame dicts (only for visited path cells)\n    slot_to_frame: dict[tuple[int, int], dict] = {}\n    frames: list[dict] = []\n    for rr, cc in path:\n        r0 = int(r0s[int(rr)])\n        c0 = int(c0s[int(cc)])\n        r1 = int(r0 + outer - 1)\n        c1 = int(c0 + outer - 1)\n        f = {\n            \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n            \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            \"slot\": (int(rr), int(cc)),\n        }\n        frames.append(f)\n        slot_to_frame[(int(rr), int(cc))] = f\n\n    max_r1 = max(int(f[\"bbox\"][2]) for f in frames)\n    max_c1 = max(int(f[\"bbox\"][3]) for f in frames)\n\n    ctrl_gap = int(np.random.randint(2, 6))\n    ctrl_r = int(max_r1 + ctrl_gap)\n    bottom_margin = 1  # eval-like: exactly one bg row below control row\n    right_margin = int(np.random.randint(1, 5))\n    H = int(ctrl_r + 1 + bottom_margin)\n    W = int(max_c1 + 1 + right_margin)\n\n    if not (7 <= int(H) <= 30 and 7 <= int(W) <= 30):\n        return None\n\n    # Assign inner colors with row/col uniqueness (in lattice coords).\n    # Force the start (top-left) inner color to be unique globally so main() starts correctly.\n    used_in_row: dict[int, set[int]] = defaultdict(set)\n    used_in_col: dict[int, set[int]] = defaultdict(set)\n\n    start_color = int(np.random.choice(np.array(inner_palette, dtype=int)))\n    colors_by_slot: dict[tuple[int, int], int] = {(0, 0): int(start_color)}\n    used_in_row[0].add(int(start_color))\n    used_in_col[0].add(int(start_color))\n\n    for rr, cc in path[1:]:\n        rr = int(rr)\n        cc = int(cc)\n        forbid = set(used_in_row[int(rr)]) | set(used_in_col[int(cc)]) | {int(start_color)}\n        choices = [int(x) for x in inner_palette if int(x) not in forbid]\n        if not choices:\n            return None\n        col = int(np.random.choice(np.array(choices, dtype=int)))\n        colors_by_slot[(int(rr), int(cc))] = int(col)\n        used_in_row[int(rr)].add(int(col))\n        used_in_col[int(cc)].add(int(col))\n\n    if len(colors_by_slot) != len(path):\n        return None\n\n    # Build virtual output: frames + bridges + control row.\n    out = np.full((int(H), int(W)), int(bg), dtype=int)\n    for f in frames:\n        rr, cc = map(int, f[\"slot\"])\n        r0, c0, _r1, _c1 = map(int, f[\"bbox\"])\n        _draw_frame(out, r0=int(r0), c0=int(c0), outer=int(outer), t=int(t), border=int(border), inner_col=int(colors_by_slot[(rr, cc)]))\n\n    # Bridges follow the 1-touch path.\n    bridge_cells_all: set[tuple[int, int]] = set()\n    ok = True\n    for a_slot, b_slot in zip(path, path[1:]):\n        fa = slot_to_frame[(int(a_slot[0]), int(a_slot[1]))]\n        fb = slot_to_frame[(int(b_slot[0]), int(b_slot[1]))]\n        cells = _bridge_cells(fa, fb)\n        if not cells:\n            ok = False\n            break\n        if cells & bridge_cells_all:\n            ok = False\n            break\n        for r, c in cells:\n            if not (0 <= int(r) < int(H) and 0 <= int(c) < int(W)):\n                ok = False\n                break\n            if int(out[int(r), int(c)]) != int(bg):\n                ok = False\n                break\n        if not ok:\n            break\n        paint = int(colors_by_slot[(int(a_slot[0]), int(a_slot[1]))])\n        for r, c in cells:\n            out[int(r), int(c)] = int(paint)\n        bridge_cells_all |= set(cells)\n\n    if not ok:\n        return None\n\n    # Control row encodes full visitation order. In eval, control pixels are at fixed columns:\n    # 1,3,5,... (gap=2), with bg everywhere else.\n    ctrl_colors = [int(colors_by_slot[(int(r), int(c))]) for r, c in path]\n    if len(ctrl_colors) < 2:\n        return None\n    ctrl_cols = [int(1 + 2 * i) for i in range(int(len(ctrl_colors)))]\n    if int(ctrl_cols[-1]) >= int(W):\n        return None\n    for col, cc in zip(ctrl_colors, ctrl_cols):\n        out[int(ctrl_r), int(cc)] = int(col)\n\n    # Invert to input by erasing bridges.\n    inp = out.copy()\n    for r, c in bridge_cells_all:\n        inp[int(r), int(c)] = int(bg)\n\n    # Ensure bg/border are inferred the way main() expects.\n    if int(get_bg(inp)) != int(bg):\n        return None\n    if int(_most_common_nonbg(inp, int(bg)) or -1) != int(border):\n        return None\n\n    # Validate: running main() on input recreates the virtual output exactly.\n    try:\n        pred = main(inp)\n    except Exception:\n        return None\n    if pred.shape != out.shape:\n        return None\n    if not bool(np.array_equal(pred, out)):\n        return None\n\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(500):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after 500 attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,520p' /home/lixinyu/snap/new/ARC_code/train/902510d5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,520p' /home/lixinyu/snap/new/ARC_code/train/902510d5.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _corner_distances(shape: tuple[int, int], corner: str, r: int, c: int) -> tuple[int, int]:\n    H, W = shape\n    if corner == \"TL\":\n        return int(r), int(c)\n    if corner == \"TR\":\n        return int(r), int(W - 1 - c)\n    if corner == \"BL\":\n        return int(H - 1 - r), int(c)\n    assert corner == \"BR\"\n    return int(H - 1 - r), int(W - 1 - c)\n\n\ndef _paint_corner_triangle(out: np.ndarray, corner: str, side: int, color: int) -> None:\n    H, W = out.shape\n    assert side > 0, \"triangle side length must be positive\"\n    for r in range(H):\n        for c in range(W):\n            a, b = _corner_distances((H, W), corner, r, c)\n            if a + b < side:\n                out[r, c] = int(color)\n\n\ndef _diagonal_direction(coords: set[tuple[int, int]]) -> str | None:\n    r0 = min(r for r, _ in coords)\n    r1 = max(r for r, _ in coords)\n    c0 = min(c for _, c in coords)\n    c1 = max(c for _, c in coords)\n    height = r1 - r0 + 1\n    width = c1 - c0 + 1\n    if height != width:\n        return None\n    n = height\n    local = {(r - r0, c - c0) for r, c in coords}\n    main_ok = all((c, r) in local for r, c in local)\n    anti_ok = all((n - 1 - c, n - 1 - r) in local for r, c in local)\n    if main_ok:\n        if (0, 0) in local and (n - 1, n - 1) not in local:\n            return \"TL\"\n        if (n - 1, n - 1) in local and (0, 0) not in local:\n            return \"BR\"\n    if anti_ok:\n        if (0, n - 1) in local and (n - 1, 0) not in local:\n            return \"TR\"\n        if (n - 1, 0) in local and (0, n - 1) not in local:\n            return \"BL\"\n    return None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Keep the largest 8-connected motif and replace the corner/control pixels with a solid corner triangle.\n\n    Input structure\n    - The background is the dominant color.\n    - Exactly one grid corner contains a foreground control pixel; it gives the\n      corner from which the triangle is painted.\n    - There is one unique largest 8-connected monochrome foreground object, the\n      motif that remains in the output; all other foreground pixels are controls.\n    - Every foreground component outside that motif is a singleton control pixel.\n    - The fill color is the unique control color that appears in at least two\n      non-corner control pixels.\n\n    Rule\n    - Start from a blank background canvas and redraw only the largest motif.\n    - Count the non-corner control pixels; that count is the triangle side.\n    - Paint the fill color on the right-triangle region where those two distances\n      from the marked corner's edges sum to less than the side length.\n\n    Key insight\n    - The scattered singleton controls are counted into a compact triangular\n      stack at the marked corner; only the largest motif is not part of the count.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    corners = {\n        \"TL\": (0, 0),\n        \"TR\": (0, W - 1),\n        \"BL\": (H - 1, 0),\n        \"BR\": (H - 1, W - 1),\n    }\n    marked_corners = [\n        (name, rc) for name, rc in corners.items() if int(g[rc]) != int(bg)\n    ]\n    assert len(marked_corners) == 1, \"expected exactly one foreground corner marker\"\n    corner, (corner_r, corner_c) = marked_corners[0]\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert comps, \"expected at least one foreground component\"\n    max_area = max(int(comp[\"area\"]) for comp in comps)\n    motif_candidates = [comp for comp in comps if int(comp[\"area\"]) == max_area]\n    assert len(motif_candidates) == 1, \"expected a unique largest motif\"\n    motif = motif_candidates[0]\n    motif_color = int(motif[\"color\"])\n    motif_coords = {tuple(map(int, coord)) for coord in motif[\"coords\"]}\n    motif_direction = _diagonal_direction(motif_coords)\n    assert motif_direction is not None, \"motif must be square and diagonal-symmetric\"\n    assert motif_direction == corner, \"corner marker must match motif diagonal direction\"\n\n    control_coords = [\n        (int(r), int(c))\n        for r, c in np.argwhere(g != bg)\n        if (int(r), int(c)) not in motif_coords\n    ]\n    assert (corner_r, corner_c) in control_coords, \"corner marker must be a control pixel\"\n    assert len(control_coords) > 1, \"expected non-corner control pixels\"\n\n    control_components = [comp for comp in comps if comp is not motif]\n    assert all(int(comp[\"area\"]) == 1 for comp in control_components), \"controls must be singleton components\"\n\n    control_counts = Counter(\n        int(g[r, c])\n        for r, c in control_coords\n        if (int(r), int(c)) != (corner_r, corner_c)\n    )\n    fill_candidates = [\n        int(color) for color, count in control_counts.items() if int(count) >= 2\n    ]\n    assert len(fill_candidates) == 1, \"expected one repeated non-corner fill color\"\n    fill_color = fill_candidates[0]\n    side = len(control_coords) - 1\n\n    out = np.full_like(g, bg)\n    for r, c in motif_coords:\n        out[r, c] = motif_color\n    _paint_corner_triangle(out, corner, int(side), fill_color)\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_ATTEMPTS = 300\n\n# Canvas and triangle bounds.\n_GEN_ROW_BOUNDS = (6, 15)\n_GEN_COL_BOUNDS = (9, 14)\n_GEN_TRIANGLE_SIDE_BOUNDS = (2, 5)\n\n# Color and control-pixel sampling.\n_GEN_COLORS = tuple(range(1, 10))\n_GEN_MARKER_AVOID_FILL_PROB = 0.8\n_GEN_FILL_COUNT_BOUNDS = (2, 3)\n\n# Sparse square motifs observed in the task examples.\n_GEN_MOTIF_TEMPLATES = [\n    (\"..#.\", \".#..\", \"#.#.\", \"...#\"),\n    (\".#...\", \"..#..\", \"..##.\", \".#..#\", \"#....\"),\n    (\n        \"...###...\",\n        \"..#......\",\n        \".##......\",\n        \"#..#.....\",\n        \"#...#....\",\n        \"#....#...\",\n        \"......#..\",\n        \".......#.\",\n        \"........#\",\n    ),\n    (\"#...\", \".#.#\", \"..#.\", \".#..\"),\n    (\"...#\", \"#.#.\", \"##..\", \".##.\"),\n]\n\n\ndef _gen_triangle_mask(shape, corner, side):\n    H, W = shape\n    rr, cc = np.indices((H, W))\n    if corner == \"TL\":\n        return rr + cc < side\n    if corner == \"TR\":\n        return rr + (W - 1 - cc) < side\n    if corner == \"BL\":\n        return (H - 1 - rr) + cc < side\n    return (H - 1 - rr) + (W - 1 - cc) < side\n\n\ndef _gen_dilate8(mask):\n    out = mask.copy()\n    out[1:, :] |= mask[:-1, :]\n    out[:-1, :] |= mask[1:, :]\n    out[:, 1:] |= mask[:, :-1]\n    out[:, :-1] |= mask[:, 1:]\n    out[1:, 1:] |= mask[:-1, :-1]\n    out[1:, :-1] |= mask[:-1, 1:]\n    out[:-1, 1:] |= mask[1:, :-1]\n    out[:-1, :-1] |= mask[1:, 1:]\n    return out\n\n\ndef _gen_patch_from_lines(lines):\n    return np.array([[ch == \"#\" for ch in row] for row in lines], dtype=bool)\n\n\ndef _gen_patch_variants(patch):\n    variants = []\n    seen = set()\n    for k in range(4):\n        rotated = np.rot90(patch, k)\n        for variant in (rotated, np.fliplr(rotated)):\n            key = tuple(map(tuple, variant.astype(int)))\n            if key not in seen:\n                seen.add(key)\n                variants.append(variant.copy())\n    return variants\n\n\ndef _gen_reflect_anti_diagonal(patch):\n    return np.flipud(np.fliplr(patch.T))\n\n\ndef _gen_is_diagonal_symmetric_patch(patch):\n    if patch.shape[0] != patch.shape[1]:\n        return False\n    main_ok = np.array_equal(patch, patch.T)\n    return main_ok or np.array_equal(patch, _gen_reflect_anti_diagonal(patch))\n\n\ndef _gen_patch_direction(patch):\n    if patch.shape[0] != patch.shape[1]:\n        return None\n    n = patch.shape[0]\n    main_ok = np.array_equal(patch, patch.T)\n    anti_ok = np.array_equal(patch, _gen_reflect_anti_diagonal(patch))\n    if main_ok:\n        if patch[0, 0] and not patch[n - 1, n - 1]:\n            return \"TL\"\n        if patch[n - 1, n - 1] and not patch[0, 0]:\n            return \"BR\"\n    if anti_ok:\n        if patch[0, n - 1] and not patch[n - 1, 0]:\n            return \"TR\"\n        if patch[n - 1, 0] and not patch[0, n - 1]:\n            return \"BL\"\n    return None\n\n\ndef _gen_symmetric_motif_patch(max_h, max_w):\n    candidates = []\n    for lines in _GEN_MOTIF_TEMPLATES:\n        patch = _gen_patch_from_lines(lines)\n        for variant in _gen_patch_variants(patch):\n            h, w = variant.shape\n            direction = _gen_patch_direction(variant)\n            if (\n                h <= max_h\n                and w <= max_w\n                and _gen_is_diagonal_symmetric_patch(variant)\n                and direction is not None\n            ):\n                candidates.append((variant, direction))\n    if not candidates:\n        return None\n    patch, direction = random.choice(candidates)\n    return patch.copy(), direction\n\n\ndef _gen_place_patch(forbidden, patch):\n    H, W = forbidden.shape\n    m, n = patch.shape\n    cells = np.argwhere(patch)\n    placements = []\n    for r0 in range(H - m + 1):\n        for c0 in range(W - n + 1):\n            if all(not forbidden[r0 + r, c0 + c] for r, c in cells):\n                placements.append((r0, c0))\n    if not placements:\n        return None\n    r0, c0 = random.choice(placements)\n    return {(int(r0 + r), int(c0 + c)) for r, c in cells}\n\n\ndef _gen_corner_cells(shape):\n    H, W = shape\n    return {\n        \"TL\": (0, 0),\n        \"TR\": (0, W - 1),\n        \"BL\": (H - 1, 0),\n        \"BR\": (H - 1, W - 1),\n    }\n\n\ndef _gen_control_pool(grid, motif_mask, blocked_mask):\n    H, W = grid.shape\n    near_motif = _gen_dilate8(motif_mask)\n    pool = []\n    corners = set(_gen_corner_cells((H, W)).values())\n    for r in range(H):\n        for c in range(W):\n            if (r, c) in corners:\n                continue\n            if grid[r, c] != 0 or near_motif[r, c] or blocked_mask[r, c]:\n                continue\n            pool.append((r, c))\n    return pool\n\n\ndef _gen_choose_scene():\n    H = random.randint(*_GEN_ROW_BOUNDS)\n    W = random.randint(*_GEN_COL_BOUNDS)\n    side = random.randint(*_GEN_TRIANGLE_SIDE_BOUNDS)\n    colors = list(_GEN_COLORS)\n    fill_color = random.choice(colors)\n    motif_color = random.choice([c for c in colors if c != fill_color])\n    return H, W, side, colors, fill_color, motif_color\n\n\ndef _gen_place_motif(H, W, side, fill_color, motif_color, motif_patch, corner):\n    triangle_mask = _gen_triangle_mask((H, W), corner, side)\n    output = np.zeros((H, W), dtype=int)\n    output[triangle_mask] = fill_color\n\n    forbidden = _gen_dilate8(triangle_mask)\n    for rc in _gen_corner_cells((H, W)).values():\n        forbidden[rc] = True\n    motif_coords = _gen_place_patch(forbidden, motif_patch)\n    if motif_coords is None:\n        return None\n\n    motif_mask = np.zeros((H, W), dtype=bool)\n    for r, c in motif_coords:\n        motif_mask[r, c] = True\n        output[r, c] = motif_color\n    return output, triangle_mask, motif_mask\n\n\ndef _gen_marker_choices(colors, motif_color, fill_color):\n    marker_choices = [c for c in colors if c != motif_color]\n    if random.random() < _GEN_MARKER_AVOID_FILL_PROB and len(marker_choices) > 1:\n        marker_choices = [c for c in marker_choices if c != fill_color]\n    return marker_choices\n\n\ndef _gen_control_colors(colors, side, fill_color):\n    fill_count = random.randint(_GEN_FILL_COUNT_BOUNDS[0], min(_GEN_FILL_COUNT_BOUNDS[1], side))\n    distractor_count = side - fill_count\n    distractor_choices = [c for c in colors if c != fill_color]\n    random.shuffle(distractor_choices)\n    control_colors = [fill_color] * fill_count + distractor_choices[:distractor_count]\n    random.shuffle(control_colors)\n    return control_colors\n\n\ndef _gen_add_controls(inp, triangle_mask, motif_mask, corner, side, colors, fill_color, motif_color):\n    H, W = inp.shape\n    corner_rc = _gen_corner_cells((H, W))[corner]\n    inp[corner_rc] = random.choice(_gen_marker_choices(colors, motif_color, fill_color))\n    control_colors = _gen_control_colors(colors, side, fill_color)\n\n    occupied_controls = np.zeros((H, W), dtype=bool)\n    occupied_controls[corner_rc] = True\n    blocked_controls = triangle_mask.copy()\n    for color in control_colors:\n        blocked = blocked_controls | _gen_dilate8(occupied_controls)\n        pool = _gen_control_pool(inp, motif_mask, blocked)\n        if not pool:\n            return False\n        r, c = random.choice(pool)\n        inp[r, c] = color\n        occupied_controls[r, c] = True\n    return True\n\n\ndef _gen_attempt():\n    H, W, side, colors, fill_color, motif_color = _gen_choose_scene()\n    motif_result = _gen_symmetric_motif_patch(H, W)\n    if motif_result is None:\n        return None\n    motif_patch, corner = motif_result\n\n    placed = _gen_place_motif(H, W, side, fill_color, motif_color, motif_patch, corner)\n    if placed is None:\n        return None\n    output, triangle_mask, motif_mask = placed\n\n    inp = output.copy()\n    inp[triangle_mask] = 0\n\n    if not _gen_add_controls(inp, triangle_mask, motif_mask, corner, side, colors, fill_color, motif_color):\n        return None\n\n    try:\n        solved = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(solved, output):\n        return None\n    return inp\n\n\ndef generate_input():\n    for _ in range(_GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 902510d5 input\")\n","exit_code":0,"status":"completed"}}
