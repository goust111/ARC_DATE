{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '25,120p;251,360p' /home/lixinyu/snap/new/ARC_code/train/9f669b64.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Push the central solid rectangle to the grid edge, splitting the perpendicular target rectangle around its path.\n\n    Input structure\n    - The background is the dominant color.\n    - There are exactly three monochrome foreground objects arranged on one\n      horizontal or vertical axis.\n    - The middle object on that axis is a solid rectangular moving object.\n    - One end object is a solid rectangle or bar whose long side is perpendicular\n      to the movement axis; this is the target to split.\n\n    Rule\n    - Move the middle rectangle along the axis toward the target until it is\n      flush with the grid edge in that direction.\n    - Clear the original middle rectangle and the original target.\n    - Split the target through the moving rectangle's two-cell-wide path and\n      shift the two halves one cell outward perpendicular to the movement.\n    - Keep the other end object unchanged.\n\n    Key insight\n    - The non-target end object acts as a pusher; the central rectangle travels\n      away from it through the perpendicular target, opening a matching gap.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(objects) == 3, \"expected exactly three foreground objects\"\n\n    row_centers = [_center(obj, 0) for obj in objects]\n    col_centers = [_center(obj, 1) for obj in objects]\n    row_spread = max(row_centers) - min(row_centers)\n    col_spread = max(col_centers) - min(col_centers)\n    assert min(row_spread, col_spread) <= 0.5, \"objects must share a row or column axis\"\n    axis = 0 if col_spread <= 0.5 else 1\n    perp = 1 - axis\n\n    ordered = sorted(objects, key=lambda obj: _center(obj, axis))\n    axis_centers = [_center(obj, axis) for obj in ordered]\n    assert axis_centers[0] < axis_centers[1] < axis_centers[2], \"expected a unique middle object\"\n\n    source = ordered[1]\n    end_objects = [ordered[0], ordered[2]]\n    assert _is_solid_rectangle(g, source), \"moving object must be a solid rectangle\"\n\n    target_candidates = [\n        obj\n        for obj in end_objects\n        if _is_solid_rectangle(g, obj) and _span(obj, perp) > _span(obj, axis)\n    ]\n    assert len(target_candidates) == 1, \"expected one perpendicular solid target\"\n    target = target_candidates[0]\n\n    direction = -1 if _center(target, axis) < _center(source, axis) else 1\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    tr0, tc0, tr1, tc1 = target[\"bbox\"]\n    source_lo = [sr0, sc0]\n    source_hi = [sr1, sc1]\n    target_lo = [tr0, tc0]\n    target_hi = [tr1, tc1]\n\n    source_perp_len = source_hi[perp] - source_lo[perp] + 1\n    assert source_perp_len == 2, \"moving object path must be two cells wide\"\n    assert target_lo[perp] <= source_lo[perp] <= source_hi[perp] <= target_hi[perp]\n    assert (\n        source_lo[perp] - target_lo[perp] == target_hi[perp] - source_hi[perp]\n    ), \"moving object must be centered across the target\"\n\n    out = g.copy()\n    for r, c in source[\"coords\"]:\n        out[int(r), int(c)] = bg\n    for r, c in target[\"coords\"]:\n        out[int(r), int(c)] = bg\n\n    shift = source_perp_len // 2\n    for r, c in target[\"coords\"]:\n        new_rc = [int(r), int(c)]\n        if new_rc[perp] <= source_lo[perp]:\n            new_rc[perp] -= shift\n        else:\n            assert new_rc[perp] >= source_hi[perp]\n            new_rc[perp] += shift\n        assert 0 <= new_rc[0] < H and 0 <= new_rc[1] < W, \"shifted target must stay in bounds\"\n        out[new_rc[0], new_rc[1]] = int(target[\"color\"])\n\n    source_patch = crop_bbox(g, source[\"bbox\"])\n    if axis == 0:\n        new_r = 0 if direction < 0 else H - source_patch.shape[0]\n        new_c = source_lo[1]\n    else:\n        new_r = source_lo[0]\n        new_c = 0 if direction < 0 else W - source_patch.shape[1]\n    dest = out[new_r : new_r + source_patch.shape[0], new_c : new_c + source_patch.shape[1]]\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 9f669b64 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '258,330p;545,620p' /home/lixinyu/snap/new/ARC_code/eval/f560132c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble scattered jigsaw pieces into a rectangle, recoloring each by a legend sprite's color map.\n\n    Input structure:\n    - bg = most common color.\n    - Several monochrome non-bg sprites (the \"pieces\"), scattered across the grid.\n    - One sprite is the legend: it contains a multi-color k×k patch (typically 2×2) encoding output colors.\n\n    Rule:\n    - Tile all pieces (rotations/reflections allowed) into a tight rectangle with no gaps.\n    - The legend's k×k color patch defines a spatial color map over the rectangle.\n    - Each piece is recolored to the legend-map color corresponding to its position in the assembled rectangle.\n\n    Key insight: The legend piece doubles as both a jigsaw piece and a color key — its internal k×k palette assigns colors by spatial quadrant.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    comps = components_mask(g != bg, connectivity=4)\n    assert comps, 'grid must contain at least one non-background component'\n\n    # Identify legend component (most distinct colors) and infer k from number of pieces.\n    k = int(round(len(comps) ** 0.5))\n    assert k * k == len(comps), 'piece count must be a perfect square to determine k'\n\n    comp_colors = []\n    for pts in comps:\n        cols = set(int(g[r, c]) for r, c in pts if int(g[r, c]) != bg)\n        comp_colors.append(cols)\n\n    max_distinct = max(len(cols) for cols in comp_colors)\n    legend_candidates = [i for i, cols in enumerate(comp_colors) if len(cols) == max_distinct]\n    assert len(legend_candidates) == 1, 'legend component must be uniquely identified by distinct colors'\n    legend_idx = legend_candidates[0]\n    legend_map = _extract_legend_map(g, comps[legend_idx], k)\n\n    # Build piece masks (coords in bbox space), including filled holes.\n    pieces: list[dict] = []\n    for pts in comps:\n        filled_abs, _ = _fill_holes_in_component(g, pts, bg)\n        r0, c0, _, _ = bbox_coords(np.asarray(list(filled_abs)))\n        rel = tuple((r - r0, c - c0) for r, c in filled_abs)\n        rel_norm, _, _ = _normalize_coords(rel)\n        oris = _dihedral_orientations(rel_norm)\n        pieces.append({\"oris\": oris, \"area\": len(filled_abs)})\n\n    return _assemble_exact_cover(pieces, legend_idx, legend_map, k)\n\n# --------------- generator (o5x) ---------------\n\n# === CFG ===\nSIDE_CHOICES = [8, 10, 12]                     # output square side lengths\nK = 2                                          # k*k quadrant grid (2*2 = 4 pieces)\nNUM_PIECES = K * K                             # total jigsaw pieces\nNUM_COLORS = 8                                 # 4 body + 4 palette, all distinct non-bg\nAREA_FRAC_LO = 0.08                           # min piece area as fraction of total\nAREA_FRAC_HI = 0.43                           # max piece area as fraction of total\nAREA_ABS_LO = 11                              # absolute min piece area (cells)\nAREA_ABS_HI = 62                              # absolute max piece area (cells)\nLEGEND_THRESHOLD = {8: 4, 10: 5, 12: 9}       # min extent threshold per side for legend L-shape\nLEGEND_CORE_SIZE = 4                           # legend always has a 4x4 filled corner block\nLEGEND_ARM_RANGE = range(1, 4)                 # arm width/height options for L-shape construction\nPARTITION_GROWTH_EXP = 1.45                    # exponent penalizing large regions during partition\nPARTITION_FRONTIER_EXP = 0.2                   # exponent boosting regions with wide frontiers\nPARTITION_SEED_JITTER = 0.2                    # random jitter when selecting seed cells\nINPUT_SIZE_LO = 20                             # min input grid side\nINPUT_SIZE_HI = 26                             # max input grid side\nDENSITY_LO = 0.15                              # min non-bg density target\nDENSITY_HI = 0.25                              # max non-bg density target\nSCATTER_BORDER = 1                             # border margin when placing pieces\nSCATTER_PADDING = 1                            # gap between piece bounding boxes\nGEN_RETRIES = 300                              # max attempts in generate_input()\ndef generate_input():\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError('failed to generate f560132c input')\n","exit_code":0,"status":"completed"}}
