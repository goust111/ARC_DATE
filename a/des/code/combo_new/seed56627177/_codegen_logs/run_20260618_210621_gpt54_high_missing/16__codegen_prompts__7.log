t(bg), dtype=int)\n\n    ctrl_col = int(ctrl_cols[0])\n    mask = (ctrl == int(ctrl_col))\n\n    out = np.full((ch * bh, cw * bw), int(bg), dtype=int)\n    for r in range(ch):\n        for c in range(cw):\n            if bool(mask[r, c]):\n                paste(out, block, r * bh, c * bw)\n    return out\n\n# --------------- generator (Codex#3) ---------------\n\ndef _dihedral_orbits(size: int) -> list[tuple[list[tuple[int, int]], bool]]:\n    seen: set[tuple[int, int]] = set()\n    out: list[tuple[list[tuple[int, int]], bool]] = []\n    s = int(size)\n    for r in range(s):\n        for c in range(s):\n            if (r, c) in seen:\n                continue\n            orbit = {\n                (r, c),\n                (c, s - 1 - r),\n                (s - 1 - r, s - 1 - c),\n                (s - 1 - c, r),\n                (r, s - 1 - c),\n                (s - 1 - r, c),\n                (c, r),\n                (s - 1 - c, s - 1 - r),\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
