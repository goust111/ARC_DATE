{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '274,380p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py && sed -n '544,680p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py && sed -n '31,320p' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\ndef _get_enclosed_holes(sprite):\n    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n    h, w = sprite.shape\n    return [pts for pts in components_mask(~sprite, connectivity=4)\n            if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n\n\ndef _make_diamond():\n    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n    s = np.zeros((3, 3), dtype=bool)\n    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n    return s\n\n\ndef _make_hollow_sprite(h, w, rng):\n    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n    sprite = np.ones((h, w), dtype=bool)\n    if h >= 3 and w >= 3:\n        sprite[1:-1, 1:-1] = False\n    # Optionally add internal horizontal wall\n    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n        br = rng.randint(2, h - 2)\n        n = rng.randint(1, w - 2)\n        s = rng.randint(1, w - 1 - n + 1)\n        sprite[br, s:s + n] = True\n    # Optionally add internal vertical wall\n    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n        bc = rng.randint(2, w - 2)\n        n = rng.randint(1, h - 2)\n        s = rng.randint(1, h - 1 - n + 1)\n        sprite[s:s + n, bc] = True\n    # Optionally remove border cells for irregularity\n    if rng.random() < _P_BORDER_REMOVAL:\n        bcells = [(r, c) for r in range(h) for c in range(w)\n                  if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n        rng.shuffle(bcells)\n        for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n            test = sprite.copy()\n            test[cr, cc] = False\n            if _get_enclosed_holes(test):\n                sprite = test\n    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n        return None\n    return sprite\n\n\ndef _choose_colors(rng, N, num_filled):\n    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n    all_c = list(range(1, 10))\n    rng.shuffle(all_c)\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.\n\n    Input structure\n    The grid has one background color and one foreground color; the foreground forms\n    separate solid rectangles, ordered from left to right.\n\n    Rule\n    Build a 10-row background canvas whose width is the packed width of the wide\n    versions of the rectangles. For each source rectangle, paint a top-aligned\n    rectangle of shape min(h,w) by max(h,w), with one background column between\n    consecutive rectangles. Then, starting again from the left edge, paint a\n    bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,\n    again separated by one background column.\n\n    Key insight\n    The input rectangles are not copied in their original orientations; each object\n    contributes one horizontal-facing and one vertical-facing normalized rectangle,\n    preserving left-to-right object order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n    fg = fg_colors[0]\n\n    components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n    assert components\n    components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n\n    dims: list[tuple[int, int]] = []\n    for obj in components:\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert obj[\"area\"] == h * w\n        dims.append((h, w))\n\n    out_h = 10\n    out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n    _assert_output_footprints_disjoint(dims)\n    out = np.full((out_h, out_w), bg, dtype=int)\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[:short, c : c + long] = fg\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[out_h - long : out_h, c : c + short] = fg\n        c += short + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\n# Rectangle counts and dimensions.\nRECT_COUNT_MIN = 4\nRECT_COUNT_MAX = 6\nSHORT_SIDE_MIN = 1\nSHORT_SIDE_MAX = 3\nSIDE_SUM_MAX = 10\nLONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN\n\n# Canvas and packing constraints.\nARC_GRID_MAX = 30\nOUTPUT_HEIGHT = 10\nGAP_WIDTH = 1\n\n# Retry policy.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_d749d46f_output_footprints_disjoint(dims):\n    occupied = set()\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, c) for r in range(short) for c in range(col, col + long)}\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += long + GAP_WIDTH\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, c)\n            for r in range(OUTPUT_HEIGHT - long, OUTPUT_HEIGHT)\n            for c in range(col, col + short)\n        }\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += short + GAP_WIDTH\n\n    return True\n\n\ndef _sample_dimensions(n_rects):\n    \"\"\"Sample source rectangle dimensions under the output-width budget.\"\"\"\n    dims = []\n    remaining_budget = ARC_GRID_MAX - GAP_WIDTH * (n_rects - 1)\n\n    for i in range(n_rects):\n        rects_left = n_rects - i\n        min_needed = rects_left - 1\n        max_for_this = min(remaining_budget - min_needed, LONG_SIDE_MAX)\n        if max_for_this < SHORT_SIDE_MIN:\n            return None\n\n        short = random.randint(SHORT_SIDE_MIN, SHORT_SIDE_MAX)\n        max_long = min(SIDE_SUM_MAX - short, max_for_this)\n        if max_long < short:\n            short = SHORT_SIDE_MIN\n            max_long = min(LONG_SIDE_MAX, max_for_this)\n            if max_long < SHORT_SIDE_MIN:\n                return None\n\n        long = random.randint(short, max_long)\n        remaining_budget -= long\n\n        if random.random() < 0.5:\n            h, w = long, short\n        else:\n            h, w = short, long\n        dims.append((h, w))\n\n    return dims\n\n\ndef _input_shape(dims):\n    return max(h for h, _ in dims), sum(w for _, w in dims) + GAP_WIDTH * (len(dims) - 1)\n\n\ndef _background_is_dominant(dims, inp_h, inp_w):\n    fg_pixels = sum(h * w for h, w in dims)\n    total_pixels = inp_h * inp_w\n    bg_pixels = total_pixels - fg_pixels\n    return bg_pixels > fg_pixels\n\n\ndef _build_input_grid(dims, bg, fg, inp_h, inp_w):\n    grid = np.full((inp_h, inp_w), bg, dtype=int)\n    col = 0\n    for h, w in dims:\n        grid[:h, col:col + w] = fg\n        col += w + GAP_WIDTH\n    return grid\n\n\ndef _passes_solver_oracle(grid):\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return out.shape[0] == OUTPUT_HEIGHT\n\n\ndef _gen_attempt():\n    \"\"\"Generate one valid input grid, or None when sampled dimensions fail constraints.\"\"\"\n    bg, fg = random.sample(COLOR_VALUES, 2)\n    n_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)\n    dims = _sample_dimensions(n_rects)\n    if dims is None:\n        return None\n\n    inp_h, inp_w = _input_shape(dims)\n    if inp_w > ARC_GRID_MAX:\n        return None\n    if not _gen_d749d46f_output_footprints_disjoint(dims):\n        return None\n    if inp_h > ARC_GRID_MAX or inp_h < 1:\n        return None\n    if not _background_is_dominant(dims, inp_h, inp_w):\n        return None\n\n    grid = _build_input_grid(dims, bg, fg, inp_h, inp_w)\n    if not _passes_solver_oracle(grid):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
