{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '208,780p' /home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert a rough nested line drawing into a clean canonical frame-and-dot diagram.\n\n    Input structure:\n    - The grid has one background color and one foreground color.\n    - Foreground 4-connected objects are rough closed frames or small filled blobs.\n    - Frames may contain other frames/blobs; blobs outside a frame remain outside it.\n\n    Rule:\n    - Detect the containment tree of foreground objects using holes of each frame object.\n    - Replace every blob with one foreground pixel.\n    - Replace every frame with a rectangular border padded two cells around its direct children.\n    - Place siblings by their original row/column overlap and order, with one empty cell between canonical objects.\n\n    Key insight: The exact wobbly geometry is irrelevant; only enclosure plus relative sibling positions define the output.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    fg_colors = sorted(set(map(int, g.flatten())) - {bg})\n    assert len(fg_colors) == 1\n    fg = int(fg_colors[0])\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg], return_format=\"dict\")\n    assert comps\n\n    nodes: list[_Node] = []\n    holes: list[list[np.ndarray]] = []\n    for comp in comps:\n        coords = np.asarray(comp[\"coords\"], dtype=int)\n        node = _Node(\n            coords=coords,\n            bbox=tuple(map(int, comp[\"bbox\"])),\n            center=coords.mean(axis=0),\n        )\n        node_holes = _component_holes(g.shape, coords)\n        node.is_frame = bool(node_holes)\n        nodes.append(node)\n        holes.append(node_holes)\n\n    assert any(node.is_frame for node in nodes)\n    for node_i, node in enumerate(nodes):\n        containers = []\n        for frame_i, frame in enumerate(nodes):\n            if node_i == frame_i or not frame.is_frame:\n                continue\n            if any(np.all(hole[tuple(node.coords.T)]) for hole in holes[frame_i]):\n                containers.append(frame)\n        if containers:\n            node.parent = min(containers, key=lambda item: int(item.coords.shape[0]))\n            node.parent.children.append(node)\n\n    roots = [node for node in nodes if node.parent is None]\n    mask = _layout_root(roots)\n    out = np.full(mask.shape, bg, dtype=int)\n    out[mask] = fg\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# ── CFG: tunable generation parameters ──────────────────────────────────────\n# Grid / canvas bounds\nGRID_MIN = 16              # minimum grid dimension (rows or cols)\nGRID_MAX = 25              # maximum grid dimension\nMAX_EXTRA_PAD = 12         # max total padding beyond drawing extent\nMAX_PAD_PER_SIDE = 6       # max padding on one side\n\n# Frame geometry\nFRAME_H_RANGE = (7, 20)    # allowed frame bbox height\nFRAME_W_RANGE = (7, 24)    # allowed frame bbox width\nFRAME_CORNER_MAX = 5       # max corner wobble displacement\nFRAME_MIN_EDGE = 2         # min straight-edge length between corners\nFRAME_TURN_RATIO = (0.34, 0.43)  # acceptable turn-ratio range for wobbly loops\nFRAME_RETRIES = 60         # retries per frame-mask generation\n\n# Blob geometry\nBLOB_SIZE_RANGE = (4, 11)  # blob pixel count range\nBLOB_BBOX_RANGE = (2, 5)   # blob bbox dimension range (exclusive upper)\n\n# Layout / arrangement\nARRANGE_GAP_COMPACT = (2, 3)   # inter-sibling gap range (compact mode)\nARRANGE_GAP_NORMAL = (2, 5)    # inter-sibling gap range (normal mode)\nARRANGE_EXTRA_SPAN = (0, 4)    # extra span added to cross-axis in arrangement\nFRAME_MARGIN_RANGE = (3, 5)    # margin around children inside a frame\nCOMPACT_MARGIN = 3             # fixed margin in compact mode\n\n# Outside blob placement\nOUTSIDE_GAP_RANGE = (2, 5)    # gap between frame and outside blob\n\n# Tree structure probabilities\nDEPTH1_PROB = 0.35             # probability of depth-1 (blobs-only) tree\nOUTSIDE_BLOB_PROB = 0.35       # probability of having an outside blob\nDEPTH1_INSIDE_RANGE = (1, 3)   # blobs inside single frame (depth-1)\nDEPTH2_INNER_BLOBS = (1, 2)    # blobs inside inner frame (depth-2)\nDEPTH2_OUTER_BLOBS = (0, 2)    # sibling blobs beside inner frame (depth-2)\nMAX_TOTAL_CHILDREN = 4         # max children before suppressing outside blob\n\n# Step-mix alternation bias\nSTEP_MIX_ALT_PROB = 0.7       # probability of alternating direction in corner wobble\n\n# Generation retry budget\nGEN_RETRIES = 300              # max attempts in generate_input()\n# ────────────────────────────────────────────────────────────────────────────\n\n\nclass _Obj:\n    def __init__(self, kind, children=None, outside_side=None):\n        self.kind = kind\n        self.children = list(children or [])\n        self.mask = None\n        self.rel = (0, 0)\n        self.pos = (0, 0)\n        self.outside_side = outside_side\n\n\ndef _loop_ok(mask):\n    \"\"\"Check that mask is a single 4-connected simple closed curve with exactly one hole.\"\"\"\n    _, n = label_mask(mask, connectivity=4)\n    if n != 1:\n        return False\n    # Vectorized degree check: each True pixel must have exactly 2 True 4-neighbors\n    deg = np.zeros_like(mask, dtype=int)\n    deg[1:, :] += mask[:-1, :]\n    deg[:-1, :] += mask[1:, :]\n    deg[:, 1:] += mask[:, :-1]\n    deg[:, :-1] += mask[:, 1:]\n    if not np.all(deg[mask] == 2):\n        return False\n    inv_lab, inv_n = label_mask(~mask, connectivity=4)\n    boundary = set(inv_lab[0, :]) | set(inv_lab[-1, :]) | set(inv_lab[:, 0]) | set(inv_lab[:, -1])\n    return sum(1 for k in range(1, inv_n + 1) if k not in boundary) == 1\n\n\ndef _step_mix(n_a, step_a, n_b, step_b):\n    \"\"\"Interleave n_a copies of step_a with n_b copies of step_b, biased toward alternation.\"\"\"\n    out = []\n    last = None\n    while n_a or n_b:\n        if n_a and n_b:\n            if last is not None and random.random() < STEP_MIX_ALT_PROB:\n                pick = \"b\" if last == \"a\" else \"a\"\n            else:\n                pick = \"a\" if random.random() < n_a / (n_a + n_b) else \"b\"\n        elif n_a:\n            pick = \"a\"\n        else:\n            pick = \"b\"\n        if pick == \"a\":\n            out.append(step_a)\n            n_a -= 1\n        else:\n            out.append(step_b)\n            n_b -= 1\n        last = pick\n    return out\n\n\ndef _add_line(path, end):\n    \"\"\"Extend path with a straight line from its last point to end.\"\"\"\n    r, c = path[-1]\n    er, ec = end\n    dr = 0 if er == r else (1 if er > r else -1)\n    dc = 0 if ec == c else (1 if ec > c else -1)\n    while (r, c) != (er, ec):\n        r += dr\n        c += dc\n        path.append((r, c))\n\n\ndef _add_steps(path, steps):\n    \"\"\"Extend path by applying a sequence of (dr, dc) deltas.\"\"\"\n    r, c = path[-1]\n    for dr, dc in steps:\n        r += dr\n        c += dc\n        path.append((r, c))\n\n\ndef _turn_ratio(path):\n    \"\"\"Fraction of direction changes along a cyclic path.\"\"\"\n    dirs = []\n    cyc = path + [path[0]]\n    for (r0, c0), (r1, c1) in zip(cyc, cyc[1:]):\n        dirs.append((r1 - r0, c1 - c0))\n    turns = sum(1 for a, b in zip(dirs, dirs[1:] + [dirs[0]]) if a != b)\n    return turns / len(path)\n\n\ndef _frame_mask(h, w):\n    \"\"\"Generate a wobbly simple closed curve mask of size (h, w).\"\"\"\n    max_dx = min(FRAME_CORNER_MAX, max(1, (w - 5) // 2))\n    max_dy = min(FRAME_CORNER_MAX, max(1, (h - 5) // 2))\n    lo, hi = FRAME_TURN_RATIO\n    for _ in range(FRAME_RETRIES):\n        tl_dx = random.randint(1, max_dx)\n        tr_dx = random.randint(1, max_dx)\n        br_dx = random.randint(1, max_dx)\n        bl_dx = random.randint(1, max_dx)\n        tl_dy = random.randint(1, max_dy)\n        tr_dy = random.randint(1, max_dy)\n        br_dy = random.randint(1, max_dy)\n        bl_dy = random.randint(1, max_dy)\n\n        p0 = (0, tl_dx)\n        p1 = (0, w - 1 - tr_dx)\n        p2 = (tr_dy, w - 1)\n        p3 = (h - 1 - br_dy, w - 1)\n        p4 = (h - 1, w - 1 - br_dx)\n        p5 = (h - 1, bl_dx)\n        p6 = (h - 1 - bl_dy, 0)\n        p7 = (tl_dy, 0)\n        if not (p1[1] - p0[1] >= FRAME_MIN_EDGE and p3[0] - p2[0] >= FRAME_MIN_EDGE\n                and p4[1] - p5[1] >= FRAME_MIN_EDGE and p6[0] - p7[0] >= FRAME_MIN_EDGE):\n            continue\n\n        path = [p0]\n        _add_line(path, p1)\n        _add_steps(path, _step_mix(tr_dy, (1, 0), tr_dx, (0, 1)))\n        _add_line(path, p3)\n        _add_steps(path, _step_mix(br_dy, (1, 0), br_dx, (0, -1)))\n        _add_line(path, p5)\n        _add_steps(path, _step_mix(bl_dy, (-1, 0), bl_dx, (0, -1)))\n        _add_line(path, p7)\n        _add_steps(path, _step_mix(tl_dy, (-1, 0), tl_dx, (0, 1)))\n        if path[-1] == path[0]:\n            path.pop()\n\n        coords = np.array(path, dtype=int)\n        mask = np.zeros((h, w), dtype=bool)\n        mask[coords[:, 0], coords[:, 1]] = True\n        ratio = _turn_ratio(path)\n        if lo <= ratio <= hi and _loop_ok(mask):\n            return mask\n    return None\n\n\ndef _blob_mask():\n    \"\"\"Generate a small filled blob mask (size 4-11, bbox 2x2 to 4x4).\"\"\"\n    size = random.randint(*BLOB_SIZE_RANGE)\n    feasible = [\n        (h, w)\n        for h in range(*BLOB_BBOX_RANGE)\n        for w in range(*BLOB_BBOX_RANGE)\n        if h * w >= size and h + w - 1 <= size\n    ]\n    h, w = random.choice(feasible)\n    rr = random.randrange(h)\n    cc = random.randrange(w)\n    cells = {(r, cc) for r in range(h)} | {(rr, c) for c in range(w)}\n    while len(cells) < size:\n        frontier = []\n        for r, c in cells:\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                p = (r + dr, c + dc)\n                if 0 <= p[0] < h and 0 <= p[1] < w and p not in cells:\n                    frontier.append(p)\n        cells.add(random.choice(frontier))\n    mask = np.zeros((h, w), dtype=bool)\n    pts = np.array(list(cells), dtype=int)\n    mask[pts[:, 0], pts[:, 1]] = True\n    return mask\n\n\ndef _arrange(children, compact=False):\n    \"\"\"Arrange children in a random layout (vertical, horizontal, or diagonal).\"\"\"\n    random.shuffle(children)\n    dims = [child.mask.shape for child in children]\n    k = len(children)\n    if k == 1:\n        return {children[0]: (0, 0)}, dims[0][0], dims[0][1]\n\n    mode = random.choice((\"vertical\", \"horizontal\", \"diagonal\"))\n    gap_lo, gap_hi = ARRANGE_GAP_COMPACT if compact else ARRANGE_GAP_NORMAL\n    gaps = [random.randint(gap_lo, gap_hi) for _ in range(k - 1)]\n    placements = {}\n\n    if mode == \"vertical\":\n        group_h = sum(h for h, _ in dims) + sum(gaps)\n        group_w = max(w for _, w in dims) + random.randint(*ARRANGE_EXTRA_SPAN)\n        r = 0\n        for child, (h, w), gap in zip(children, dims, gaps + [0]):\n            placements[child] = (r, random.randint(0, group_w - w))\n            r += h + gap\n        return placements, group_h, group_w\n\n    if mode == \"horizontal\":\n        group_h = max(h for h, _ in dims) + random.randint(*ARRANGE_EXTRA_SPAN)\n        group_w = sum(w for _, w in dims) + sum(gaps)\n        c = 0\n        for child, (h, w), gap in zip(children, dims, gaps + [0]):\n            placements[child] = (random.randint(0, group_h - h), c)\n            c += w + gap\n        return placements, group_h, group_w\n\n    # diagonal\n    group_h = sum(h for h, _ in dims) + sum(gaps)\n    group_w = sum(w for _, w in dims) + sum(gaps)\n    r = c = 0\n    for child, (h, w), gap in zip(children, dims, gaps + [0]):\n        placements[child] = (r, c)\n        r += h + gap\n        c += w + gap\n    return placements, group_h, group_w\n\n\ndef _prepare(node, compact=False):\n    \"\"\"Recursively build masks and place children within frames.\"\"\"\n    if node.kind == \"blob\":\n        node.mask = _blob_mask()\n        return True\n\n    for child in node.children:\n        if not _prepare(child, compact=child.kind == \"frame\"):\n            return False\n\n    has_frame_child = any(child.kind == \"frame\" for child in node.children)\n    tight = compact or has_frame_child\n    placements, group_h, group_w = _arrange(node.children, compact=tight)\n    margin = COMPACT_MARGIN if tight else random.randint(*FRAME_MARGIN_RANGE)\n    min_h = max(FRAME_H_RANGE[0], group_h + 2 * margin)\n    min_w = max(FRAME_W_RANGE[0], group_w + 2 * margin)\n    if min_h > FRAME_H_RANGE[1] or min_w > FRAME_W_RANGE[1]:\n        return False\n    h_hi = min(FRAME_H_RANGE[1], min_h + 2) if compact else FRAME_H_RANGE[1]\n    w_hi = min(FRAME_W_RANGE[1], min_w + 3) if compact else FRAME_W_RANGE[1]\n    h = random.randint(min_h, h_hi)\n    w = random.randint(min_w, w_hi)\n    top = margin + random.randint(0, h - 2 * margin - group_h)\n    left = margin + random.randint(0, w - 2 * margin - group_w)\n    for child, (r, c) in placements.items():\n        child.rel = (top + r, left + c)\n    node.mask = _frame_mask(h, w)\n    return node.mask is not None\n\n\ndef _walk(node, base=(0, 0)):\n    \"\"\"Flatten tree into list, computing absolute positions.\"\"\"\n    br, bc = base\n    rr, cc = node.rel\n    node.pos = (br + rr, bc + cc)\n    out = [node]\n    for child in node.children:\n        out.extend(_walk(child, node.pos))\n    return out\n\n\ndef _place_outside(root, outside):\n    \"\"\"Position an outside blob adjacent to the root frame.\"\"\"\n    assert root.mask is not None and outside.mask is not None\n    h, w = root.mask.shape\n    bh, bw = outside.mask.shape\n    gap = random.randint(*OUTSIDE_GAP_RANGE)\n    side = outside.outside_side\n    if side == \"right\":\n        outside.rel = (random.randint(1, h - bh - 1), w + gap)\n    elif side == \"left\":\n        outside.rel = (random.randint(1, h - bh - 1), -gap - bw)\n    elif side == \"bottom\":\n        outside.rel = (h + gap, random.randint(1, w - bw - 1))\n    else:\n        outside.rel = (-gap - bh, random.randint(1, w - bw - 1))\n\n\ndef _node_from_obj(obj):\n    \"\"\"Convert a generator _Obj (with absolute pos) to a solver _Node.\"\"\"\n    assert obj.mask is not None\n    r0, c0 = obj.pos\n    coords = np.argwhere(obj.mask) + np.array([r0, c0])\n    lo = coords.min(axis=0)\n    hi = coords.max(axis=0)\n    node = _Node(\n        coords=coords.astype(int),\n        bbox=(int(lo[0]), int(lo[1]), int(hi[0]), int(hi[1])),\n        center=coords.mean(axis=0),\n    )\n    node.is_frame = obj.kind == \"frame\"\n    return node\n\n\ndef _expected_output(root, outside, bg, fg):\n    \"\"\"Compute expected solver output for the generated tree.\"\"\"\n    def add(obj):\n        node = _node_from_obj(obj)\n        for child in obj.children:\n            child_node = add(child)\n            child_node.parent = node\n            node.children.append(child_node)\n        return node\n\n    roots = [add(root)]\n    if outside is not None:\n        roots.append(add(outside))\n    mask = _layout_root(roots)\n    out = np.full(mask.shape, bg, dtype=int)\n    out[mask] = fg\n    return out\n\n\ndef _make_tree():\n    \"\"\"Build a random containment tree (1-2 frames, 1-4 blobs, optional outside blob).\"\"\"\n    root = _Obj(\"frame\")\n    outside = None\n    sides = (\"left\", \"right\", \"top\", \"bottom\")\n    if random.random() < DEPTH1_PROB:\n        n_inside = random.randint(*DEPTH1_INSIDE_RANGE)\n        root.children = [_Obj(\"blob\") for _ in range(n_inside)]\n        if n_inside < MAX_TOTAL_CHILDREN and random.random() < OUTSIDE_BLOB_PROB:\n            outside = _Obj(\"blob\", outside_side=random.choice(sides))\n    else:\n        inner = _Obj(\"frame\")\n        inner.children = [_Obj(\"blob\") for _ in range(random.randint(*DEPTH2_INNER_BLOBS))]\n        outer_blobs = [_Obj(\"blob\") for _ in range(random.randint(*DEPTH2_OUTER_BLOBS))]\n        root.children = [inner] + outer_blobs\n        if len(inner.children) + len(outer_blobs) < MAX_TOTAL_CHILDREN and random.random() < OUTSIDE_BLOB_PROB:\n            outside = _Obj(\"blob\", outside_side=random.choice(sides))\n    return root, outside\n\n\ndef _draw(objects, bg, fg):\n    \"\"\"Render all objects onto a padded grid. Returns None if size constraints fail.\"\"\"\n    min_r = min(obj.pos[0] for obj in objects)\n    min_c = min(obj.pos[1] for obj in objects)\n    max_r = max(obj.pos[0] + obj.mask.shape[0] for obj in objects)\n    max_c = max(obj.pos[1] + obj.mask.shape[1] for obj in objects)\n    draw_h = max_r - min_r\n    draw_w = max_c - min_c\n    if draw_h > GRID_MAX or draw_w > GRID_MAX:\n        return None\n\n    extra_h_min = max(0, GRID_MIN - draw_h)\n    extra_w_min = max(0, GRID_MIN - draw_w)\n    extra_h_max = min(MAX_EXTRA_PAD, GRID_MAX - draw_h)\n    extra_w_max = min(MAX_EXTRA_PAD, GRID_MAX - draw_w)\n    if extra_h_min > extra_h_max or extra_w_min > extra_w_max:\n        return None\n    extra_h = random.randint(extra_h_min, extra_h_max)\n    extra_w = random.randint(extra_w_min, extra_w_max)\n    top_pad = random.randint(max(0, extra_h - MAX_PAD_PER_SIDE), min(MAX_PAD_PER_SIDE, extra_h))\n    left_pad = random.randint(max(0, extra_w - MAX_PAD_PER_SIDE), min(MAX_PAD_PER_SIDE, extra_w))\n    shift_r = top_pad - min_r\n    shift_c = left_pad - min_c\n\n    grid = np.full((draw_h + extra_h, draw_w + extra_w), bg, dtype=int)\n    for obj in objects:\n        assert obj.mask is not None\n        r = obj.pos[0] + shift_r\n        c = obj.pos[1] + shift_c\n        obj.pos = (r, c)\n        patch = np.full(obj.mask.shape, bg, dtype=int)\n        patch[obj.mask] = fg\n        paste(grid, patch, r, c, transparent=bg)\n    if np.count_nonzero(grid == bg) <= np.count_nonzero(grid == fg):\n        return None\n    return grid\n\n\ndef _gen_attempt():\n    \"\"\"Single generation attempt: build tree, render input, verify against solver.\"\"\"\n    bg, fg = random.sample(range(10), 2)\n    root, outside = _make_tree()\n    if not _prepare(root):\n        return None\n    if outside is not None:\n        if not _prepare(outside):\n            return None\n        _place_outside(root, outside)\n\n    objects = _walk(root)\n    if outside is not None:\n        outside.pos = outside.rel\n        objects.append(outside)\n\n    grid = _draw(objects, bg, fg)\n    if grid is None:\n        return None\n    expected = _expected_output(root, outside, bg, fg)\n    try:\n        got = main(grid)\n    except Exception:\n        return None\n    if not np.array_equal(got, expected):\n        return None\n    return grid\n\n\ndef generate_input():\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 2d0172a1 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,340p' /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py && sed -n '1,360p' /home/lixinyu/snap/new/ARC_code/eval/7491f3cf.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,340p' /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py && sed -n '1,360p' /home/lixinyu/snap/new/ARC_code/eval/7491f3cf.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg\nimport random\n\n\ndef _touches_edge(coords: np.ndarray, height: int, width: int) -> bool:\n    rows = coords[:, 0]\n    cols = coords[:, 1]\n    return bool(\n        np.any((rows == 0) | (rows == height - 1) | (cols == 0) | (cols == width - 1))\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, table, frame, and slot dimensions.\nCANVAS_MIN, CANVAS_MAX = 13, 19\nTABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\nROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\nAXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n\n# Object and palette sampling limits.\nN_COLORS, MAX_OBJECT_COLORS = 10, 6\nMAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\nOBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n\n# Rejection sampling cap.\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_axis_options(n_slots, slot_min, slot_max):\n    options = []\n\n    def rec_slots(i, cur):\n        if i == n_slots:\n            rec_seps(0, [], cur)\n            return\n        for size in range(slot_min, slot_max + 1):\n            rec_slots(i + 1, cur + [size])\n\n    def rec_seps(i, cur, slots):\n        if i == n_slots - 1:\n            for before in AXIS_OUTER_OPTIONS:\n                for after in AXIS_OUTER_OPTIONS:\n                    for pad_before in AXIS_PADDING_OPTIONS:\n                        for pad_after in AXIS_PADDING_OPTIONS:\n                            total = (\n                                before\n                                + after\n                                + pad_before\n                                + pad_after\n                                + sum(slots)\n                                + sum(cur)\n                            )\n                            if 13 <= total <= 19:\n                                options.append(\n                                    (\n                                        tuple(slots),\n                                        tuple(cur),\n                                        before,\n                                        after,\n                                        pad_before,\n                                        pad_after,\n                                        total,\n                                )\n                            )\n            return\n        for sep in AXIS_SEPARATOR_OPTIONS:\n            rec_seps(i + 1, cur + [sep], slots)\n\n    rec_slots(0, [])\n    return options\n\n\ndef _gen_positions(axis):\n    sizes, seps, outer_before, _outer_after, pad_before, _pad_after, _total = axis\n    starts = []\n    pos = outer_before + pad_before\n    for i, size in enumerate(sizes):\n        starts.append(pos)\n        pos += size\n        if i < len(seps):\n            pos += seps[i]\n    return starts\n\n\ndef _gen_choose_axis(n_slots, slot_min, slot_max, other_axis=None, max_object_loss=0):\n    options = _gen_axis_options(n_slots, slot_min, slot_max)\n    if other_axis is None:\n        return random.choice(options)\n\n    good = []\n    for axis in options:\n        row_axis = axis if slot_max == ROW_SLOT_SIZE_RANGE[1] else other_axis\n        col_axis = axis if slot_max == COL_SLOT_SIZE_RANGE[1] else other_axis\n        height = row_axis[-1]\n        width = col_axis[-1]\n        frame_height = height - row_axis[2] - row_axis[3]\n        frame_width = width - col_axis[2] - col_axis[3]\n        slot_area = sum(row_axis[0]) * sum(col_axis[0])\n        outer_bg = height * width - frame_height * frame_width\n        bg_room = outer_bg + slot_area - max_object_loss\n        frame_area = frame_height * frame_width - slot_area\n        if bg_room > frame_area:\n            good.append(axis)\n    return random.choice(good or options)\n\n\ndef _gen_assign_colors(shape, bg, frame):\n    n_slots = shape[0] * shape[1]\n    filled_count = random.randint(1, n_slots - 1)\n    filled = random.sample(range(n_slots), filled_count)\n    colors = [c for c in range(N_COLORS) if c not in (bg, frame)]\n    n_colors = random.randint(1, min(MAX_OBJECT_COLORS, filled_count, len(colors)))\n    palette = random.sample(colors, n_colors)\n    assignments = palette[:]\n    assignments.extend(random.choice(palette) for _ in range(filled_count - n_colors))\n    random.shuffle(assignments)\n\n    out = np.full(shape, bg, dtype=int)\n    for idx, color in zip(filled, assignments):\n        out[idx // shape[1], idx % shape[1]] = color\n    return out, filled_count\n\n\ndef _gen_object_shape(slot_h, slot_w):\n    by_area = {}\n    for obj_h in range(1, min(MAX_OBJECT_HEIGHT, slot_h - 2 * OBJECT_MARGIN) + 1):\n        for obj_w in range(1, min(MAX_OBJECT_WIDTH, slot_w - 2 * OBJECT_MARGIN) + 1):\n            by_area.setdefault(obj_h * obj_w, []).append((obj_h, obj_w))\n    area = random.choice(list(by_area))\n    return random.choice(by_area[area])\n\n\ndef _gen_choose_layout(rows, cols, filled_count):\n    row_axis = _gen_choose_axis(rows, *ROW_SLOT_SIZE_RANGE)\n    loss = MAX_OBJECT_AREA * filled_count\n    col_axis = _gen_choose_axis(cols, *COL_SLOT_SIZE_RANGE, row_axis, max_object_loss=loss)\n    return row_axis, col_axis, _gen_positions(row_axis), _gen_positions(col_axis)\n\n\ndef _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts):\n    height = row_axis[-1]\n    width = col_axis[-1]\n    grid = np.full((height, width), bg, dtype=int)\n    rt, rb = row_axis[2], row_axis[3]\n    cl, cr = col_axis[2], col_axis[3]\n    grid[rt : height - rb, cl : width - cr] = frame\n\n    for r, slot_h in zip(row_starts, row_axis[0]):\n        for c, slot_w in zip(col_starts, col_axis[0]):\n            grid[r : r + slot_h, c : c + slot_w] = bg\n    return grid\n\n\ndef _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts):\n    for out_r, slot_r in enumerate(row_starts):\n        slot_h = row_axis[0][out_r]\n        for out_c, slot_c in enumerate(col_starts):\n            color = int(out[out_r, out_c])\n            if color == bg:\n                continue\n            slot_w = col_axis[0][out_c]\n            obj_h, obj_w = _gen_object_shape(slot_h, slot_w)\n            obj_r = random.randint(slot_r + OBJECT_MARGIN, slot_r + slot_h - obj_h - OBJECT_MARGIN)\n            obj_c = random.randint(slot_c + OBJECT_MARGIN, slot_c + slot_w - obj_w - OBJECT_MARGIN)\n            grid[obj_r : obj_r + obj_h, obj_c : obj_c + obj_w] = color\n\n\ndef _gen_is_valid(grid, out, bg, frame):\n    counts = np.bincount(grid.ravel(), minlength=N_COLORS)\n    if int(np.argmax(counts)) != bg:\n        return False\n    if counts[frame] <= max(counts[c] for c in range(N_COLORS) if c not in (bg, frame)):\n        return False\n    try:\n        actual = main(grid)\n    except Exception:\n        return False\n    return bool(np.array_equal(actual, out))\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rows = random.randint(*TABLE_ROWS_RANGE)\n    cols = random.randint(*TABLE_COLS_RANGE)\n    bg, frame = random.sample(range(N_COLORS), 2)\n\n    out, filled_count = _gen_assign_colors((rows, cols), bg, frame)\n    row_axis, col_axis, row_starts, col_starts = _gen_choose_layout(rows, cols, filled_count)\n    grid = _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts)\n    _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts)\n\n    if _gen_is_valid(grid, out, bg, frame):\n        return grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid ac6f9922 input\")\nfrom __future__ import annotations\nimport random\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import get_bg, flood_fill, neighbors8, in_bounds, label_mask\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Composite two pattern tiles into a fourth panel using flood-fill from an indicator pixel.\n\n    Input structure:\n    - Four 5×5 panels in one row, border-separated.\n    - Panel 0: cue pixels = wall boundary (8-connected, edge-to-edge, through center)\n               + one 8-isolated indicator pixel.\n    - Panels 1–2: source patterns. Panel 3: blank (to fill).\n\n    Rule:\n    - Flood-fill (4-conn) from indicator, blocked by wall → inside region.\n    - Inside → non-bg from panel 1; outside → non-bg from panel 2.\n    - Wall → panel 1 if non-bg; panel 2 fallback when wall is 4-connected.\n\n    Key insight: The cue panel's isolated indicator and wall partition the tile into inside/outside masks that select between the two source panels.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n\n    border = int(g[0, 0])\n    tiles = [g[1:6, 1 + 6 * j : 1 + 6 * j + 5].copy() for j in range(4)]\n    t0, t1, t2, _t3 = tiles\n    b = int(Counter(t1.flatten()).most_common(1)[0][0])\n    assert border != b, \"border color must differ from tile background\"\n\n    t0_bg = int(Counter(t0.flatten()).most_common(1)[0][0])\n    cue_set = {(int(r), int(c)) for r in range(5) for c in range(5) if int(t0[r, c]) != t0_bg}\n    assert cue_set, \"no cue pixels found\"\n\n    # --- Indicator = the unique 8-isolated cue pixel ---\n    indicator = None\n    for r, c in cue_set:\n        if not any((nr, nc) in cue_set for nr, nc in neighbors8(r, c)):\n            assert indicator is None, \"multiple 8-isolated cue pixels\"\n            indicator = (r, c)\n    assert indicator is not None, \"no 8-isolated cue pixel found\"\n\n    # Indicator must sit at a tile corner or edge midpoint\n    valid_pos = {(0,0),(0,4),(4,0),(4,4),(0,2),(2,0),(2,4),(4,2)}\n    assert indicator in valid_pos, f\"indicator {indicator} not at corner/edge-midpoint\"\n\n    wall = cue_set - {indicator}\n\n    # --- Structural assertions (feedback for generate_input agents) ---\n    assert (2, 2) in wall, \"wall must pass through the grid center (2,2)\"\n\n    # Wall must be symmetric about the line from indicator to center (2,2)\n    ir, ic = indicator\n    dr, dc = 2 - ir, 2 - ic\n    if dr == 0:\n        _refl = lambda r, c: (4 - r, c)\n    elif dc == 0:\n        _refl = lambda r, c: (r, 4 - c)\n    elif dr * dc > 0:\n        _refl = lambda r, c: (c, r)\n    else:\n        _refl = lambda r, c: (4 - c, 4 - r)\n    assert wall == {_refl(r, c) for r, c in wall}, \"wall must be symmetric about indicator→center axis\"\n\n    sides_touched = set()\n    for r, c in wall:\n        if r == 0: sides_touched.add(\"top\")\n        if r == 4: sides_touched.add(\"bottom\")\n        if c == 0: sides_touched.add(\"left\")\n        if c == 4: sides_touched.add(\"right\")\n    assert len(sides_touched) >= 2, f\"wall must span edge-to-edge, only touches {sides_touched}\"\n\n    # --- Flood fill inside region ---\n    EMPTY, WALL, INSIDE = 0, 1, 2\n    tmp = np.zeros((5, 5), dtype=int)\n    for r, c in wall:\n        tmp[r, c] = WALL\n    flood_fill(tmp, indicator[0], indicator[1], INSIDE, connectivity=4)\n    inside = {(int(r), int(c)) for r, c in np.argwhere(tmp == INSIDE)}\n\n    outside = {(r, c) for r in range(5) for c in range(5)} - inside - wall\n    assert outside, \"wall must partition the grid — outside region is empty\"\n\n    # Wall 4-connectivity determines boundary blending behavior:\n    # axis-aligned walls (4-connected) allow t2 fallback; diagonal walls don't.\n    wall_mask = np.zeros((5, 5), dtype=bool)\n    for r, c in wall:\n        wall_mask[r, c] = True\n    _, n_comp = label_mask(wall_mask, connectivity=4)\n    wall_4conn = (n_comp == 1)\n\n    # --- Build output tile ---\n    out3 = np.full((5, 5), b, dtype=int)\n    for r in range(5):\n        for c in range(5):\n            v1, v2 = int(t1[r, c]), int(t2[r, c])\n            if (r, c) in inside:\n                if v1 != b:\n                    out3[r, c] = v1\n            elif (r, c) in wall:\n                if v1 != b:\n                    out3[r, c] = v1\n                elif wall_4conn and v2 != b:\n                    out3[r, c] = v2\n            else:\n                if v2 != b:\n                    out3[r, c] = v2\n\n    out = g.copy()\n    out[1:6, 1 + 6 * 3 : 1 + 6 * 3 + 5] = out3\n    return out\n\n# --------------- generator (subagent) ---------------\n\n# ── Tunables ──────────────────────────────────────────────────────────────────\nTILE_SZ = 5                    # each panel is 5x5\nGRID_ROWS, GRID_COLS = 7, 25  # fixed output grid shape\nNUM_COLORS = 10                # ARC color palette size\n\nT1_MIN_PX, T1_MAX_PX = 8, 12  # tile-1 non-bg pixel range\nT2_MIN_PX, T2_MAX_PX = 9, 12  # tile-2 non-bg pixel range\nORBIT_INCLUDE_PROB = 0.55      # per-orbit inclusion probability for pattern sampling\nPATTERN_RETRIES = 200          # max retries per _sample_symmetric_pattern call\nGEN_RETRIES = 300              # max retries in generate_input outer loop\nLBEND_PROB = 0.2               # L-bend wall probability (eval ratio ~4:1 straight:L-bend)\n\n# ── Symmetric pattern orbits (D1+D2 symmetry on 5x5) ─────────────────────────\n_ORBITS = [\n    [(0, 0), (4, 4)],\n    [(0, 4), (4, 0)],\n    [(2, 2)],\n    [(1, 1), (3, 3)],\n    [(1, 3), (3, 1)],\n    [(0, 1), (1, 0), (3, 4), (4, 3)],\n    [(0, 2), (2, 0), (2, 4), (4, 2)],\n    [(0, 3), (3, 0), (1, 4), (4, 1)],\n    [(1, 2), (2, 1), (2, 3), (3, 2)],\n]\n\n\ndef _sample_symmetric_pattern(bg: int, fg: int, rng: random.Random, *,\n                              min_px: int, max_px: int) -> np.ndarray | None:\n    \"\"\"Sample a 5x5 grid symmetric under both diagonals, with fg pixel count in\n    [min_px, max_px].  Randomizes orbit order, includes each greedily within\n    the max budget, retries until min is met.\"\"\"\n    for _ in range(PATTERN_RETRIES):\n        order = list(range(len(_ORBITS)))\n        rng.shuffle(order)\n        p = np.full((TILE_SZ, TILE_SZ), bg, dtype=int)\n        count = 0\n        for i in order:\n            orbit = _ORBITS[i]\n            if count + len(orbit) > max_px:\n                continue\n            if rng.random() < ORBIT_INCLUDE_PROB:\n                for r, c in orbit:\n                    p[r, c] = fg\n                count += len(orbit)\n        if min_px <= count <= max_px:\n            return p\n    return None\n\n\n# ── Precomputed (indicator, wall) configurations ─────────────────────────────\n# 8 straight + 12 L-bend combos, all verified to partition the 5x5 grid.\n_STRAIGHT_CONFIGS = [\n    ((0, 2), frozenset({(2,0),(2,1),(2,2),(2,3),(2,4)})),          # row\n    ((4, 2), frozenset({(2,0),(2,1),(2,2),(2,3),(2,4)})),          # row\n    ((2, 0), frozenset({(0,2),(1,2),(2,2),(3,2),(4,2)})),          # col\n    ((2, 4), frozenset({(0,2),(1,2),(2,2),(3,2),(4,2)})),          # col\n    ((0, 0), frozenset({(0,4),(1,3),(2,2),(3,1),(4,0)})),          # anti-diag\n    ((4, 4), frozenset({(0,4),(1,3),(2,2),(3,1),(4,0)})),          # anti-diag\n    ((0, 4), frozenset({(0,0),(1,1),(2,2),(3,3),(4,4)})),          # diag\n    ((4, 0), frozenset({(0,0),(1,1),(2,2),(3,3),(4,4)})),          # diag\n]\n_LBEND_CONFIGS = [\n    ((0, 0), frozenset({(2,2),(1,2),(0,2),(2,1),(2,0)})),          # U+L\n    ((0, 0), frozenset({(2,2),(3,2),(4,2),(2,3),(2,4)})),          # D+R\n    ((4, 4), frozenset({(2,2),(1,2),(0,2),(2,1),(2,0)})),          # U+L\n    ((4, 4), frozenset({(2,2),(3,2),(4,2),(2,3),(2,4)})),          # D+R\n    ((0, 4), frozenset({(2,2),(1,2),(0,2),(2,3),(2,4)})),          # U+R\n    ((0, 4), frozenset({(2,2),(3,2),(4,2),(2,1),(2,0)})),          # D+L\n    ((4, 0), frozenset({(2,2),(1,2),(0,2),(2,3),(2,4)})),          # U+R\n    ((4, 0), frozenset({(2,2),(3,2),(4,2),(2,1),(2,0)})),          # D+L\n    ((4, 2), frozenset({(2,2),(1,1),(0,0),(1,3),(0,4)})),          # NW+NE\n    ((0, 2), frozenset({(2,2),(3,1),(4,0),(3,3),(4,4)})),          # SW+SE\n    ((2, 4), frozenset({(2,2),(1,1),(0,0),(3,1),(4,0)})),          # NW+SW\n    ((2, 0), frozenset({(2,2),(1,3),(0,4),(3,3),(4,4)})),          # NE+SE\n]\n\n\ndef _flood_inside(wall: frozenset, indicator: tuple[int, int]) -> set[tuple[int, int]]:\n    tmp = np.zeros((TILE_SZ, TILE_SZ), dtype=int)\n    for r, c in wall:\n        tmp[r, c] = 1\n    flood_fill(tmp, indicator[0], indicator[1], 2, connectivity=4)\n    return {(int(r), int(c)) for r, c in np.argwhere(tmp == 2)}\n\n\n# ── Main generation loop ─────────────────────────────────────────────────────\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    # 1. Colors: border != tile_bg; cue/t1/t2 mutually distinct and != tile_bg.\n    palette = list(range(NUM_COLORS))\n    tile_bg = rng.choice(palette)\n    other = [c for c in palette if c != tile_bg]\n    cue_color, t1_color, t2_color = rng.sample(other, 3)\n    border = rng.choice(other)\n\n    # 2. Wall + indicator (4:1 straight:L-bend ratio).\n    pool = _LBEND_CONFIGS if rng.random() < LBEND_PROB else _STRAIGHT_CONFIGS\n    indicator, wall = rng.choice(pool)\n    inside = _flood_inside(wall, indicator)\n\n    # 3. Tile-1 / Tile-2 symmetric patterns.\n    t1 = _sample_symmetric_pattern(tile_bg, t1_color, rng,\n                                   min_px=T1_MIN_PX, max_px=T1_MAX_PX)\n    t2 = _sample_symmetric_pattern(tile_bg, t2_color, rng,\n                                   min_px=T2_MIN_PX, max_px=T2_MAX_PX)\n    if t1 is None or t2 is None:\n        return None\n\n    # 4. Tile-0 (cue tile): bg + wall + indicator drawn in cue_color.\n    t0 = np.full((TILE_SZ, TILE_SZ), tile_bg, dtype=int)\n    for r, c in wall:\n        t0[r, c] = cue_color\n    t0[indicator[0], indicator[1]] = cue_color\n\n    # 5. Composite output tile-3.\n    wall_mask = np.zeros((TILE_SZ, TILE_SZ), dtype=bool)\n    for r, c in wall:\n        wall_mask[r, c] = True\n    _, n_comp = label_mask(wall_mask, connectivity=4)\n    wall_4conn = (n_comp == 1)\n    outside = set((r, c) for r in range(TILE_SZ) for c in range(TILE_SZ)) - inside - wall\n    out3 = np.full((TILE_SZ, TILE_SZ), tile_bg, dtype=int)\n    for r in range(TILE_SZ):\n        for c in range(TILE_SZ):\n            v1, v2 = int(t1[r, c]), int(t2[r, c])\n            if (r, c) in inside:\n                if v1 != tile_bg: out3[r, c] = v1\n            elif (r, c) in wall:\n                if v1 != tile_bg: out3[r, c] = v1\n                elif wall_4conn and v2 != tile_bg: out3[r, c] = v2\n            else:\n                if v2 != tile_bg: out3[r, c] = v2\n\n    # 6. Assemble 7x25 input grid (tile-3 input is blank).\n    t3_in = np.full((TILE_SZ, TILE_SZ), tile_bg, dtype=int)\n    g = np.full((GRID_ROWS, GRID_COLS), border, dtype=int)\n    for j, tile in enumerate([t0, t1, t2, t3_in]):\n        g[1:6, 1 + 6 * j: 1 + 6 * j + 5] = tile\n\n    # 7. Oracle: solver output must match hand-built composite.\n    expected = g.copy()\n    expected[1:6, 1 + 6 * 3: 1 + 6 * 3 + 5] = out3\n    got = main(g)\n    if not np.array_equal(got, expected):\n        return None\n    return g\n\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(f\"generate_input failed after {GEN_RETRIES} attempts\")\n\n","exit_code":0,"status":"completed"}}
