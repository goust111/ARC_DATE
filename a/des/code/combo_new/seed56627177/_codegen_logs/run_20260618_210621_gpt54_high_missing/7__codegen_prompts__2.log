{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed56627177/7/2.py')\nmod = SourceFileLoader('new_arc_task_stats', str(p)).load_module()\nclip = 0\noverwrite = 0\nfor _ in range(200):\n    inp = mod.generate_input()\n    out = mod.main(inp)\n    grey = inp == mod.GREY\n    if np.any(grey & (out \"'!= mod.GREY)):\n        overwrite += 1\n    seeds, nodes, node_to_seed, _ = mod._parse_scene(inp)\n    h, w = inp.shape\n    clipped_here = False\n    for node_id, node in enumerate(nodes):\n        shape = seeds[node_to_seed[node_id]]['\"'shape']\n        r0, c0 = node['pos']\n        for dr, dc in shape:\n            if not (0 <= r0 + dr < h and 0 <= c0 + dc < w):\n                clipped_here = True\n                break\n        if clipped_here:\n            break\n    clip += int(clipped_here)\nprint('clip_samples', clip)\nprint('overwrite_samples', overwrite)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
