once to generate a valid input grid. Returns None on failure.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/0934a4d8.py:275:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/278e5215.py:50:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/278e5215.py:51:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/278e5215.py:66:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/278e5215.py:155:    \"\"\"Grow a connected mask with full row/column span to the target area.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/278e5215.py:195:    \"\"\"Grid sizes where the mask remains the unique largest non-bg object.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/278e5215.py:208:    \"\"\"Sample mask size, layout gap, and compatible grid size.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/278e5215.py:220:    \"\"\"Choose hole color and the same-width column palette row.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/278e5215.py:229:    \"\"\"Paste mask and palette into disjoint row bands of a blank grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/278e5215.py:275:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:7:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:16:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:101:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:102:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:115:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:169:\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:205:    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:214:    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:228:    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:240:    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:265:    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:275:    \"\"\"Return blob with interior holes absorbed.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:279:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:330:    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:346:    \"\"\"Place 1-2 legend patches at grid corners.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:349:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:380:    \"\"\"Grow irregular closed regions, one per assigned wall color.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:383:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:440:    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:468:    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:485:    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:489:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:533:    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:556:    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:604:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/412b6263.py:38:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/412b6263.py:39:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/412b6263.py:54:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/412b6263.py:161:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/bae5c565.py:9:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/bae5c565.py:10:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/bae5c565.py:28:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/bae5c565.py:120:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:27:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:36:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:171:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:172:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:185:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:234:        \"\"\"Check if the union of frame parts forms an LR-symmetric bitmap.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:309:    \"\"\"Precompute valid (H, W) pairs: unique closest-to-square portrait factorization with W=5.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:327:    \"\"\"Generate frame bitmap (Hx2 left-half) via zigzag path from top to bottom.\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:328:    Returns (cells, start_c, end_c) where start_c/end_c are the column at top/bottom.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:348:    \"\"\"Fill non-frame cells by assigning colors to 4-conn hole regions.\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:349:    Large holes are split into chunks of <= _MAX_CHUNK_SIZE cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:372:    \"\"\"Build an abstract LR-symmetric output grid with zigzag frame and filled holes.\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:373:    Returns (grid, frame_colors_set) or (None, set()) on failure.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:418:    \"\"\"Select dims, build abstract output, then remap to real ARC colors.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:435:    \"\"\"Extract non-frame piece patches from the output grid, sorted largest-first.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:452:    \"\"\"Place pieces onto a canvas: frame as a group, non-frame scattered with padding.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:489:    \"\"\"Single generation attempt: build output, validate constraints, scatter, oracle check.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e8686506.py:513:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/458e3a53.py:18:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/458e3a53.py:19:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/458e3a53.py:32:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/458e3a53.py:88:    \"\"\"Build one structured tile per lattice diagonal, or {} if validation fails.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/458e3a53.py:117:    \"\"\"Return ((row, col, height, width), output colors) for the solid block.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/458e3a53.py:130:    \"\"\"Assemble the separator lattice from solid cells and pattern tiles.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/458e3a53.py:147:    \"\"\"Check separator lines and non-solid cells before the solver oracle.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/458e3a53.py:182:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
