{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/e8686506.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location\nimport random\n\n\ndef _piece_sig(pts: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:\n    r0, c0, r1, c1 = bbox_coords(pts)\n    coords = tuple(sorted((int(r) - r0, int(c) - c0) for r, c in pts))\n    return (r1 - r0 + 1), (c1 - c0 + 1), coords\n\n\ndef _factors(n: int) -> list[tuple[int, int]]:\n    out = []\n    for w in range(1, n + 1):\n        if n % w == 0:\n            h = n // w\n            out.append((h, w))\n    return out\n\n\ndef _build_requirements(\n    H: int,\n    W: int,\n    comps_by_color: dict[int, list[list[tuple[int, int]]]],\n) -> np.ndarray:\n    \"\"\"\n    Build per-cell required color constraints (req[r,c] == -1 means unconstrained).\n\n    Heuristics supported by training examples:\n      - If there is a color with exactly 4 singleton components, those are the four corners.\n      - If there are full horizontal bars of length W-2 in the input, use them as the top/bottom edges\n        between the corners (ordered by their vertical position in the input).\n      - If there is a color with exactly two full vertical line components (width=1) in the input,\n        place them on the left/right edges centered vertically.\n    \"\"\"\n    req = np.full((H, W), -1, dtype=int)\n\n    # 4 singleton components -> corners\n    corner_colors = [\n        col\n        for col, comps in comps_by_color.items()\n        if len(comps) == 4 and all(len(p) == 1 for p in comps)\n    ]\n    assert len(corner_colors) <= 1, \"corner singleton color must be unique when present\"\n    corner_color = corner_colors[0] if corner_colors else None\n    if corner_color is not None:\n        req[0, 0] = corner_color\n        req[0, W - 1] = corner_color\n        req[H - 1, 0] = corner_color\n        req[H - 1, W - 1] = corner_color\n\n    # Horizontal bar(s) of length W-2 (filled, height 1)\n    bar_colors: list[tuple[int, int]] = []  # (min_input_row, color)\n    if W >= 3 and corner_color is not None:\n        for col, comps in comps_by_color.items():\n            for pts in comps:\n                r0, c0, r1, c1 = bbox_coords(pts)\n                hh, ww = r1 - r0 + 1, c1 - c0 + 1\n                if hh == 1 and ww == (W - 2) and len(pts) == ww:\n                    bar_colors.append((r0, col))\n                    break\n        if bar_colors:\n            assert len(bar_colors) <= 2, \"horizontal edge bar colors must be top/bottom only\"\n            bar_colors.sort()\n            top_col = bar_colors[0][1]\n            bot_col = bar_colors[-1][1]\n            req[0, 1 : W - 1] = top_col\n            req[H - 1, 1 : W - 1] = bot_col\n\n    # Two full vertical line components -> left/right edges, centered vertically\n    vertical_line_candidates = []\n    for col, comps in comps_by_color.items():\n        if len(comps) != 2:\n            continue\n        sigs = [_piece_sig(pts) for pts in comps]\n        (h0, w0, coords0), (h1, w1, coords1) = sigs[0], sigs[1]\n        if w0 == 1 and w1 == 1 and h0 == h1 and coords0 == coords1 and h0 > 1:\n            vertical_line_candidates.append((col, h0))\n    assert len(vertical_line_candidates) <= 1, \"paired vertical edge-line color must be unique when present\"\n    if vertical_line_candidates:\n        col, L = vertical_line_candidates[0]\n        top = (H - L) // 2\n        assert 0 <= top and top + L <= H, \"paired vertical edge lines must fit in the output height\"\n        req[top : top + L, 0] = col\n        req[top : top + L, W - 1] = col\n\n    return req\n\n\ndef _assemble(\n    types: list[dict],\n    H: int,\n    W: int,\n    req: np.ndarray,\n    disallow_touch: set[int] | None = None,\n) -> np.ndarray:\n    board = np.full((H, W), -1, dtype=int)\n    counts = [int(t[\"cnt\"]) for t in types]\n\n    def mirror_ok(r: int, c: int, col: int) -> bool:\n        mc = W - 1 - c\n        v = board[r, mc]\n        return (v == -1) or (v == col)\n\n    def can_place(ti: int, r0: int, c0: int) -> bool:\n        t = types[ti]\n        col = int(t[\"col\"])\n        is_singleton = len(t[\"coords\"]) == 1\n        for dr, dc in t[\"coords\"]:\n            r, c = r0 + dr, c0 + dc\n            if board[r, c] != -1:\n                return False\n            if req[r, c] != -1 and int(req[r, c]) != col:\n                return False\n            if not mirror_ok(r, c, col):\n                return False\n            if is_singleton and not (r == 0 or r == H - 1 or c == 0 or c == W - 1):\n                return False\n            if disallow_touch and col in disallow_touch:\n                for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):\n                    if 0 <= rr < H and 0 <= cc < W and board[rr, cc] == col:\n                        return False\n        return True\n\n    def place(ti: int, r0: int, c0: int) -> list[tuple[int, int]]:\n        t = types[ti]\n        col = int(t[\"col\"])\n        changed = []\n        for dr, dc in t[\"coords\"]:\n            r, c = r0 + dr, c0 + dc\n            board[r, c] = col\n            changed.append((r, c))\n        return changed\n\n    def unplace(changed: list[tuple[int, int]]) -> None:\n        for r, c in changed:\n            board[r, c] = -1\n\n    def placements_for(ti: int) -> list[tuple[int, int]]:\n        t = types[ti]\n        return [(r0, c0)\n                for r0 in range(H - int(t[\"h\"]) + 1)\n                for c0 in range(W - int(t[\"w\"]) + 1)\n                if can_place(ti, r0, c0)]\n\n    # Pure constraint propagation: each step, every type must be forced (1 position)\n    # or batch-forced (positions == cnt). No backtracking. Asserts if stuck.\n    changed = True\n    while changed:\n        changed = False\n        for ti in range(len(types)):\n            if counts[ti] <= 0:\n                continue\n            places = placements_for(ti)\n            assert len(places) > 0, \"assembly dead end: a piece has no valid placement\"\n            if len(places) == 1:\n                counts[ti] -= 1\n                place(ti, places[0][0], places[0][1])\n                changed = True\n            elif len(places) == counts[ti]:\n                for r0, c0 in places:\n                    counts[ti] -= 1\n                    place(ti, r0, c0)\n                changed = True\n    assert all(c == 0 for c in counts), \"assembly not purely propagation-solvable\"\n    assert np.array_equal(board, board[:, ::-1]), \"assembled board must be LR-symmetric\"\n    return board\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble scattered colored fragments into a left-right symmetric rectangle, jigsaw-style.\n\n    Input structure:\n    - bg = most common color; remaining colors form small sprite fragments.\n    - Optional roles: 4 singleton pixels of one color mark corners; horizontal bars mark top/bottom edges; paired vertical lines mark left/right edges.\n\n    Rule:\n    - Collect all non-bg connected components as jigsaw pieces.\n    - Determine output rectangle dimensions from total piece area.\n    - Pack pieces into the rectangle so it is exactly mirror-symmetric (left-right) and same-color pieces never 4-touch.\n\n    Key insight: Left-right symmetry plus the no-same-color-touching constraint make the assembly unique; corner/edge markers anchor it when present.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    # Extract pieces (connected components per color)\n    comps_by_color: dict[int, list[list[tuple[int, int]]]] = {}\n    pieces = []\n    color_piece_count: dict[int, int] = {}\n\n    for col in sorted(set(map(int, np.unique(g)))):\n        if col == bg:\n            continue\n        comps = components_mask(g == col, connectivity=4)\n        comps_by_color[col] = comps\n        color_piece_count[col] = len(comps)\n        for pts in comps:\n            _, _, coords = _piece_sig(pts)\n            pieces.append((col, coords))\n\n    # Group identical pieces into types\n    from collections import Counter\n\n    ctr = Counter(pieces)\n    types = []\n    for (col, coords), cnt in sorted(ctr.items(), key=lambda kv: (-len(kv[0][1]), kv[0][0], kv[0][1])):\n        arr = np.array(coords, dtype=int)\n        h = int(arr[:, 0].max() + 1)\n        w = int(arr[:, 1].max() + 1)\n        types.append({\"col\": int(col), \"coords\": coords, \"h\": h, \"w\": w, \"cnt\": int(cnt)})\n\n    total_area = sum(int(t[\"cnt\"]) * len(t[\"coords\"]) for t in types)\n    assert total_area > 0, \"total_area must be positive: grid must contain non-background pieces\"\n\n    # Disallow 4-neigh touching between different pieces of same color (preserve component counts)\n    # Eval inputs use the unique closest-to-square portrait factor pair as the output shape.\n    dims = [(h, w) for (h, w) in _factors(total_area) if h >= w]\n    assert dims, \"at least one portrait factor pair must exist for the total piece area\"\n    best_gap = min(abs(h - w) for h, w in dims)\n    best_dims = [(h, w) for h, w in dims if abs(h - w) == best_gap]\n    assert len(best_dims) == 1, \"closest-to-square portrait output shape must be unique\"\n    H, W = best_dims[0]\n\n    # Frame constraint: under 8-connectivity, 1-2 pieces must exist whose union bbox\n    # equals the output rectangle (H x W). Their relative positions are fixed in output.\n    comps8_all = []\n    for col in sorted(set(map(int, np.unique(g))) - {bg}):\n        for pts in components_mask(g == col, connectivity=8):\n            comps8_all.append((int(col), pts))\n    def _is_lr_symmetric(parts, h, w):\n        \"\"\"Check if the union of frame parts forms an LR-symmetric bitmap.\"\"\"\n        all_pts = np.concatenate([p for _, p in parts])\n        r0, c0 = int(all_pts[:, 0].min()), int(all_pts[:, 1].min())\n        bmp = np.zeros((h, w), dtype=bool)\n        for _, pts in parts:\n            for r, c in pts:\n                bmp[int(r) - r0, int(c) - c0] = True\n        return np.array_equal(bmp, bmp[:, ::-1])\n\n    frame_parts: list[tuple[int, np.ndarray]] = []\n    for i, (c1, p1) in enumerate(comps8_all):\n        r0, c0, r1, c1b = bbox_coords(p1)\n        if r1 - r0 + 1 == H and c1b - c0 + 1 == W:\n            if _is_lr_symmetric([(c1, p1)], H, W):\n                frame_parts = [(c1, p1)]\n                break\n        for j in range(i + 1, len(comps8_all)):\n            c2, p2 = comps8_all[j]\n            union = np.concatenate([p1, p2])\n            ur0, uc0, ur1, uc1 = bbox_coords(union)\n            if ur1 - ur0 + 1 == H and uc1 - uc0 + 1 == W:\n                if _is_lr_symmetric([(c1, p1), (c2, p2)], H, W):\n                    frame_parts = [(c1, p1), (c2, p2)]\n                    break\n        if frame_parts:\n            break\n    assert frame_parts, \"input must contain 1-2 LR-symmetric pieces (8-conn) whose union bbox equals output dims\"\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/458e3a53.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/458e3a53.py\"","aggregated_output":"import numpy as np\nimport random\nfrom arc_utils import paste\n\n\ndef _bands(size: int, separators: list[int]) -> list[tuple[int, int]]:\n    bands = []\n    start = 0\n    for cut in separators:\n        if start < cut:\n            bands.append((start, cut - 1))\n        start = cut + 1\n    if start < size:\n        bands.append((start, size - 1))\n    return bands\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extract the compact table of solid cells hidden inside a separator lattice.\n\n    Input structure\n    - The grid has full-width and full-height bars of one separator color, dividing it into rectangular cells.\n    - Most cells contain a repeating multicolor pattern, while a contiguous rectangle of cells is solid monochrome.\n\n    Rule\n    - Split the input into lattice cells using the full separator rows and columns.\n    - Keep the cells whose full interior is one color, crop to their occupied rectangle, and output those colors.\n\n    Key insight\n    - The periodic pattern is noise; only completely solid lattice cells encode the reduced output grid.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    row_colors = {int(g[r, 0]) for r in range(h) if np.all(g[r, :] == g[r, 0])}\n    col_colors = {int(g[0, c]) for c in range(w) if np.all(g[:, c] == g[0, c])}\n    sep_colors = row_colors & col_colors\n    assert len(sep_colors) == 1, \"there must be exactly one row/column separator color\"\n    sep = next(iter(sep_colors))\n    assert row_colors == {sep}, \"all full rows must be separator rows\"\n    assert col_colors == {sep}, \"all full columns must be separator columns\"\n\n    sep_rows = [r for r in range(h) if np.all(g[r, :] == sep)]\n    sep_cols = [c for c in range(w) if np.all(g[:, c] == sep)]\n    assert sep_rows and sep_cols, \"separator lattice must have rows and columns\"\n\n    row_bands = _bands(h, sep_rows)\n    col_bands = _bands(w, sep_cols)\n\n    solid_cells = {}\n    for ri, (r0, r1) in enumerate(row_bands):\n        for ci, (c0, c1) in enumerate(col_bands):\n            cell = g[r0 : r1 + 1, c0 : c1 + 1]\n            if np.all(cell == cell[0, 0]):\n                solid_cells[(ri, ci)] = int(cell[0, 0])\n    assert solid_cells, \"must contain at least one solid lattice cell\"\n\n    solid_rows = [ri for ri, _ in solid_cells]\n    solid_cols = [ci for _, ci in solid_cells]\n    r0, r1 = min(solid_rows), max(solid_rows)\n    c0, c1 = min(solid_cols), max(solid_cols)\n\n    out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)\n    for ri in range(r0, r1 + 1):\n        for ci in range(c0, c1 + 1):\n            assert (ri, ci) in solid_cells, \"solid lattice cells must form a rectangle\"\n            out[ri - r0, ci - c0] = solid_cells[(ri, ci)]\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Lattice dimensions: valid (L, cell_size) pairs produce 27-30 square grids.\nVALID_LC = [(4, 6), (5, 5), (6, 4)]\nCOLOR_COUNT = 10\nSEPARATOR_WIDTH = 1\n# Solid rectangle: output block size in lattice coordinates.\nSOLID_SIZE_RANGE = (2, 3)\n# Pattern cells: diagonal variants are multicolor and solver-visible as non-solid.\nPATTERN_TILE_MIN_COLORS = 5\nPATTERN_CELL_MIN_COLORS = 2\nDIAGONAL_ID_BITS = 4\n# Retry budget: regenerate on rare validation failures.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _pattern_tiles(csize: int, lattice: int, sep: int) -> dict[int, np.ndarray]:\n    \"\"\"Build one structured tile per lattice diagonal, or {} if validation fails.\"\"\"\n    colors = [c for c in range(COLOR_COUNT) if c != sep]\n    random.shuffle(colors)\n    palette = colors[: random.randint(PATTERN_TILE_MIN_COLORS, len(colors))]\n    palette_arr = np.asarray(palette, dtype=int)\n    k = len(palette)\n\n    rr, cc = np.indices((csize, csize))\n    base = (rr + cc + random.randrange(k)) % k\n    if random.choice([False, True]):\n        base = base.T\n    if random.choice([False, True]):\n        base = np.fliplr(base)\n    if random.choice([False, True]):\n        base = np.flipud(base)\n    tiles = {}\n    for diag in range(2 * lattice - 1):\n        tile_idx = (base + random.randrange(k)) % k\n        tile = palette_arr[tile_idx]\n        # Encode the diagonal id in four cells so variants are guaranteed distinct.\n        for bit in range(DIAGONAL_ID_BITS):\n            tile.flat[bit] = palette[(diag >> bit) & 1]\n        if len(np.unique(tile)) < PATTERN_TILE_MIN_COLORS:\n            return {}\n        tiles[diag] = tile\n    return tiles\n\n\ndef _sample_solid_block(lattice, colors):\n    \"\"\"Return ((row, col, height, width), output colors) for the solid block.\"\"\"\n    solid_h = random.randint(*SOLID_SIZE_RANGE)\n    solid_w = random.randint(*SOLID_SIZE_RANGE)\n    solid_r0 = random.randint(0, lattice - solid_h)\n    solid_c0 = random.randint(0, lattice - solid_w)\n    flat = np.random.choice(colors, size=solid_h * solid_w).astype(int)\n    if len(set(map(int, flat))) == 1:\n        change_at = random.randrange(len(flat))\n        flat[change_at] = random.choice([c for c in colors if c != int(flat[change_at])])\n    return (solid_r0, solid_c0, solid_h, solid_w), flat.reshape((solid_h, solid_w))\n\n\ndef _render_grid(lattice, csize, sep, block, out, tiles):\n    \"\"\"Assemble the separator lattice from solid cells and pattern tiles.\"\"\"\n    n = lattice * csize + (lattice - 1)\n    grid = np.full((n, n), sep, dtype=int)\n    solid_r0, solid_c0, solid_h, solid_w = block\n    stride = csize + SEPARATOR_WIDTH\n    for ri in range(lattice):\n        for ci in range(lattice):\n            r0, c0 = ri * stride, ci * stride\n            if solid_r0 <= ri < solid_r0 + solid_h and solid_c0 <= ci < solid_c0 + solid_w:\n                cell = np.full((csize, csize), int(out[ri - solid_r0, ci - solid_c0]), dtype=int)\n            else:\n                cell = tiles[(ri - ci) % (2 * lattice - 1)]\n            paste(grid, cell, r0, c0)\n    return grid\n\n\ndef _valid_generated_grid(grid, lattice, csize, sep, block):\n    \"\"\"Check separator lines and non-solid cells before the solver oracle.\"\"\"\n    stride = csize + SEPARATOR_WIDTH\n    sep_lines = [csize + i * stride for i in range(lattice - 1)]\n    if not all(np.all(grid[r, :] == sep) and np.all(grid[:, r] == sep) for r in sep_lines):\n        return False\n    solid_r0, solid_c0, solid_h, solid_w = block\n    for ri in range(lattice):\n        for ci in range(lattice):\n            if solid_r0 <= ri < solid_r0 + solid_h and solid_c0 <= ci < solid_c0 + solid_w:\n                continue\n            r0, c0 = ri * stride, ci * stride\n            if len(np.unique(grid[r0 : r0 + csize, c0 : c0 + csize])) < PATTERN_CELL_MIN_COLORS:\n                return False\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    lattice, csize = random.choice(VALID_LC)\n    sep = random.randrange(COLOR_COUNT)\n    colors = [c for c in range(COLOR_COUNT) if c != sep]\n    block, out = _sample_solid_block(lattice, colors)\n    tiles = _pattern_tiles(csize, lattice, sep)\n    if not tiles:\n        return None\n    grid = _render_grid(lattice, csize, sep, block, out, tiles)\n    if not _valid_generated_grid(grid, lattice, csize, sep, block):\n        return None\n    try:\n        if not np.array_equal(main(grid), out):\n            return None\n    except AssertionError:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 458e3a53 input\")\n","exit_code":0,"status":"completed"}}
