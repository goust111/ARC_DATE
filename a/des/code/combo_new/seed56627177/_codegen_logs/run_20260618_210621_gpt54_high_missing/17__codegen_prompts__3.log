orizontal gray bars repaint that many cells as complete orange rows starting from the contacted top or bottom row.\n0096:     - Vertical gray bars repaint that many cells as complete orange columns starting from the contacted left or right column.\n0097:     - Orange rectangles with no touching gray bar remain unchanged.\n0098: \n0099:     Key insight\n0100:     - The gray pixels are not copied by shape; their count is transferred into the neighboring orange rectangle as edge-aligned row or column stripes.\n0101:     \"\"\"\n0102:     g = np.asarray(grid, dtype=int)\n0103:     assert g.ndim == 2, \"expected a 2D grid\"\n0104:     assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.YELLOW, Color.GRAY, Color.ORANGE}\n0105: \n0106:     orange = find_components(g, bg=Color.YELLOW, colors=[Color.ORANGE], connectivity=4)\n0107:     gray = find_components(g, bg=Color.YELLOW, colors=[Color.GRAY], connectivity=4)\n0108:     assert orange and gray, \"expected orange rectangles and gray source bars\"\n0109: \n0110:     orange_index: dict[tuple[int, int], int] = {}\n0111:     orange_bboxes: list[tuple[int, int, int, int]] = []\n0112:     for i, obj in enumerate(orange):\n0113:         r0, c0, r1, c1 = obj[\"bbox\"]\n0114:         assert obj[\"area\"] == bbox_h(obj[\"bbox\"]) * bbox_w(obj[\"bbox\"])\n0115:         assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == Color.ORANGE)\n0116:         orange_bboxes.append((int(r0), int(c0), int(r1), int(c1)))\n0117:         for r, c in obj[\"coords\"]:\n0118:             orange_index[(int(r), int(c))] = i\n0119: \n0120:     source_by_target: dict[int, list[tuple[dict, list[tuple[int, int, int, int]]]]] = {}\n0121:     for src in gray:\n0122:         touched: dict[int, list[tuple[int, int, int, int]]] = {}\n0123:         for sr_raw, sc_raw in src[\"coords\"]:\n0124:             sr = int(sr_raw)\n0125:             sc = int(sc_raw)\n0126:             for tr, tc in neighbors4(sr, sc):\n0127:                 target_i = orange_index.get((int(t