p.ndarray) -> np.ndarray:\n0025:     \"\"\"\n0026:     Draw a polyline by decoding 3x3 glyph instructions read across a divided grid.\n0027: \n0028:     Input structure:\n0029:     - Left of a full-height vertical divider: 3x3 colored glyphs on bg.\n0030:     - Right of divider: a single gray (5) start pixel.\n0031: \n0032:     Rule:\n0033:     - Remove the divider; shift the gray start into the left canvas.\n0034:     - Read glyphs in column-major order (left→right, top→bottom).\n0035:     - Each glyph's shape (pixel area) encodes a segment: area 4 → down 2, area 5 → right 3, area 6 → left 4, area 7 → left 2.\n0036:     - Append segments sequentially, stepping down one cell between each.\n0037: \n0038:     Key insight: Glyph pixel count (area) uniquely determines both segment length and direction — the shape itself is the instruction.\n0039:     \"\"\"\n0040:     g = np.array(grid, dtype=int)\n0041:     H, W = g.shape\n0042:     bg = int(get_bg(g))\n0043: \n0044:     # Divider is a full-height constant non-bg column.\n0045:     div_c, div_color = find_full_height_constant_col(g, bg=bg)\n0046:     assert div_c is not None\n0047: \n0048:     out = np.zeros((H, int(div_c)), dtype=int)\n0049: \n0050:     # Move gray start from right side into left canvas (remove divider col too).\n0051:     gray = np.argwhere(g == 5)\n0052:     if gray.size == 0:\n0053:         return out\n0054:     r_cur, c_cur = map(int, gray[0])\n0055:     c_cur = int(c_cur - (int(div_c) + 1))\n0056:     if not (0 <= c_cur < int(div_c)):\n0057:         return out\n0058:     out[int(r_cur), int(c_cur)] = 5\n0059: \n0060:     # Collect 3x3 glyph components on the left.\n0061:     left = g[:, : int(div_c)]\n0062:     ignore = {int(bg), 5}\n0063:     if div_color is not None:\n0064:         ignore.add(int(div_color))\n0065: \n0066:     glyphs: list[dict[str, int]] = []\n0067:     for comp in find_components(left, bg=bg, connectivity=8, monochromatic=True, return_format=\"dict\"):\n0068:         col = int(comp[\"color\"])\n0069:         if col in ignore:\n0070:             continue\n0071:         b = comp[\"bbox\"]\n0072:         if bbox_h(b) == 3 and bbox_w(b) == 3:\n0073:             r0, c0, _r1, _c1 = map(int, b)\n0074:             glyphs.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"area\": int(comp[\"area\"])})\n0075: \n0076:     glyphs.sort(key=lambda d: (int(d[\"c0\"]), int(d[\"r0\"])))\n0077: \n0078:     area_to_len = {4: 2, 5: 3, 6: 4, 7: 2}\n0079:     area_to_dir = {5: 1, 6: -1, 7: -1}  # diamond right; cross/U left\n0080: \n0081:     for glyph in glyphs:\n0082:         color = int(glyph[\"color\"])\n0083:         area = int(glyph[\"area\"])\n0084:         seg_len = int(area_to_len.get(area, 2))\n0085: \n0086:         r_cur = int(r_cur + 1)\n0087:         assert r_cur < H, f\"segment exits bottom: r_cur={r_cur}, H={H}\"\n0088:         out[r_cur, int(c_cur)] = color\n0089: \n0090:         if area == 4:  # vertical (down)\n0091:             end_r = r_cur + (seg_len - 1)\n0092:             assert end_r < H, f\"vertical segment exits bottom: end_r={end_r}, H={H}\"\n0093:             for _ in range(seg_len - 1):\n0094:                 r_cur = int(r_cur + 1)\n0095:                 out[r_cur, int(c_cur)] = color\n0096:         else:  # horizontal\n0097:             dir_h = int(area_to_dir.get(area, 1))\n0098:             end_c = int(c_cur) + dir_h * (seg_len - 1)\n0099:             assert 0 <= end_c < int(div_c), (\n0100:                 f\"horizontal segment exits canvas: c_cur={c_cur}, dir={dir_h}, \"\n0101:                 f\"seg_len={seg_len}, div_c={div_c}\"\n0102:             )\n0103:             for _ in range(seg_len - 1):\n0104:                 c_cur = int(c_cur + dir_h)\n0105:                 out[r_cur, c_cur] = color\n0106: \n0107:     return out\n0108: \n0109: # --------------- generator (attempt 1 (Claude)) ---------------\n0110: \n0111: # --- canvas geometry ---\n0112: N_MIN, N_MAX = 2, 5            # number of tile rows; H = 4*N - 1, num_glyphs = 2*N\n0113: GRID_W = 15                    # full input width\n0114: DIVIDER_COL = 7                # divider position (col), full-height\n0115: DIVIDER_COLOR = 4              # divider fill color\n0116: LEFT_W = 7                     # left canvas width (cols 0..6)\n0117: TILE_COLS = (0, 4)             # 3x3 tile c0 positions on the left\n0118: TILE_ROW_STRIDE = 4            # row spacing between successive tile slots\n0119: GRAY = 5                       # start-pixel color\n0120: GRAY_START_ROW = 0             # gray start always sits at row 0 [observed]\n0121: \n0122: # --- shape grammar (area -> 3x3 template, color, and (dr, dc) walk delta) ---\n0123: # Walk delta = total (row, col) displacement caused by one glyph instruction:\n0124: #   step down 1 then segment of (len, dir). E.g. area 4 (vertical len 2) => (+2, 0).\n0125: _TEMPLATES = {\n0126:     4: np.array([[1, 0, 1], [0, 1, 0], [0, 1, 0]], dtype=int),  # plus    -> down 2,  color 6\n0127:     5: np.array([[1, 1, 0], [1, 0, 1], [0, 1, 0]], dtype=int),  # diamond -> right 3, color 1\n0128:     6: np.array([[1, 1, 1], [0, 1, 0], [1, 0, 1]], dtype=int),  # cross   -> left 4,  color 3\n0129:     7: np.array([[1, 0, 1], [1, 0, 1], [1, 1, 1]], dtype=int),  # U       -> left 2,  color 2\n0130: }\n0131: _AREA_TO_COLOR = {4: 6, 5: 1, 6: 3, 7: 2}\n0132: _AREA_DELTA = {4: (2, 0), 5: (1, 2), 6: (1, -3), 7: (1, -1)}\n0133: _AREAS = (4, 5, 6, 7)\n0134: \n0135: # --- generation constraints ---\n0136: MIN_DIRECTION_CHANGES = 2      # min vertical<->horizontal flips across the walk\n0137: MAX_ATTEMPTS = 300             # outer retry budget\n0138: \n0139: \n0140: def _sample_path(N: int, start_col: int) -> list[int] | None:\n0141:     \"\"\"Random-walk a sequence of 2*N area instructions that stays in the left canvas.\n0142: \n0143:     Returns None if the walk dead-ends or fails the direction-change constraint.\n---\n0190: def generate_input() -> np.ndarray:\n0191:     for _ in range(MAX_ATTEMPTS):\n0192:         try:\n0193:             inp = _gen_attempt()\n0194:             if inp is None:\n0195:                 continue\n0196:             out = main(inp)  # oracle check\n0197:             if out.shape != (inp.shape[0], LEFT_W):\n0198:                 continue\n0199:             return inp\n0200:         except Exception:\n0201:             continue\n0202:     raise RuntimeError(f\"generate_input: failed after {MAX_ATTEMPTS} attempts\")\n---\nFILE: /home/lixinyu/snap/new/ARC_code/train/5b37cb25.py\n0058: def main(grid: np.ndarray) -> np.ndarray:\n0059:     \"\"\"Fill each plus-shaped background notch with the color of the frame side it opens toward.\n0060: \n0061:     Input structure\n0062:     - A one-cell-thick rectangular frame has four solid-colored sides and neutral corner pixels.\n0063:     - The frame interior contains a dominant background color and one foreground object color.\n0064:     - Some object boundaries contain five-pixel plus-shaped background notches.\n0065: \n0066:     Rule\n0067:     - Find every background plus whose opposite side is supported by foreground object pixels and whose open side faces one frame side.\n0068:     - Recolor the five pixels of that plus with the color of the facing frame side.\n0069:     - Leave all other pixels unchanged.\n0070: \n0071:     Key insight\n0072:     The frame side colors are direction labels for the open notches in the foreground object.\n0073:     \"\"\"\n0074:     g = np.asarray(grid, dtype=int)\n0075:     assert g.ndim == 2, \"expected a 2D grid\"\n0076:     h, w = g.shape\n0077:     assert h >= 5 and w >= 5, \"expected room for a frame and plus notches\"\n0078: \n0079:     side_color = {\n0080:         \"top\": _uniform_side(g[0, 1:-1]),\n0081:         \"bottom\": _uniform_side(g[-1, 1:-1]),\n0082:         \"left\": _uniform_side(g[1:-1, 0]),\n0083:         \"right\": _uniform_side(g[1:-1, -1]),\n0084:     }\n0085:     bg, obj = _interior_colors(g[1:-1, 1:-1])\n0086: \n0087:     out = g.copy()\n0088:     painted: set[tuple[int, int]] = set()\n0089:     notch_count = 0\n0090:     for r in range(1, h - 1):\n0091:         for c in range(1, w - 1):\n0092:             cross = tuple((r + dr, c + dc) for dr, dc in _CROSS)\n0093:             if not all(int(g[rr, cc]) == bg for rr, cc in cross):\n0094:                 continue\n0095: \n0096:             dirs = _direction_for_notch(g, r, c, obj)\n0097:             assert len(dirs) <= 1, \"expected each plus notch to open in at most one direction\"\n0098:             if not dirs:\n0099:                 continue\n0100: \n0101:             notch_count += 1\n0102:             color = side_color[dirs[0]]\n0103:             for cell in cross:\n0104:                 assert cell not in painted, \"expected non-overlapping plus notches\"\n0105:                 painted.add(cell)\n0106:                 out[cell] = color\n0107: \n0108:     assert notch_count > 0, \"expected at least one plus notch\"\n0109:     return out\n0110: \n0111: # --------------- generator (att2) ---------------\n0112: \n0113: # Canvas and palette.\n0114: _GEN_GRID_SIZE, _GEN_CORNER_COLOR = 30, 0\n0115: _GEN_COLOR_POOL, _GEN_PALETTE_SIZE = range(1, 10), 6\n0116: \n0117: # Object size and total filled-area budget.\n0118: _OBJECT_COUNT_MIN, _OBJECT_COUNT_MAX = 3, 4\n0119: _OBJECT_DIM_MIN, _OBJECT_DIM_MAX = 5, 20\n0120: _OBJECT_AREA_MIN, _OBJECT_AREA_MAX = 30, 180\n0121: _TOTAL_OBJECT_AREA_MAX, _MIN_REMAINING_OBJECT_AREA = 360, 30\n0122: \n0123: # Placement gap against frame and other objects.\n0124: _PLACEMENT_BORDER, _PLACEMENT_PADDING, _PLACEMENT_PADDING_CONNECTIVITY = 2, 2, 8\n0125: \n0126: # Notch geometry and counts.\n0127: _GEN_CROSS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))\n0128: _GEN_DIRECTIONS = {\n0129:     \"top\": (-1, 0),\n0130:     \"bottom\": (1, 0),\n0131:     \"left\": (0, -1),\n0132:     \"right\": (0, 1),\n0133: }\n0134: _EDGES = tuple(_GEN_DIRECTIONS)\n0135: _NOTCH_EDGE_MARGIN, _MAX_TOTAL_NOTCHES = 2, 8\n0136: _NOTCHES_PER_OBJECT = (1, 2, 3)\n0137: \n0138: # Rejection-sampling retry cap.\n0139: _GEN_RETRY_LIMIT = 300\n0140: _DIM_PAIRS = [(h, w) for h in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1)\n0141:               for w in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1) if _OBJECT_AREA_MIN <= h * w <= _OBJECT_AREA_MAX]\n0142: \n0143: \n0144: def _notch_cells(r, c, direction):\n0145:     dr, dc = _GEN_DIRECTIONS[direction]\n0146:     pr, pc = -dc, dr\n0147:     cross = tuple((r + rr, c + cc) for rr, cc in _GEN_CROSS)\n0148:     support = (\n0149:         (r - 2 * dr, c - 2 * dc),\n0150:         (r - dr + pr, c - dc + pc),\n0151:         (r - dr - pr, c - dc - pc),\n0152:         (r + 2 * pr, c + 2 * pc),\n0153:         (r - 2 * pr, c - 2 * pc),\n0154:     )\n0155:     open_side = (\n0156:         (r + 2 * dr, c + 2 * dc),\n0157:         (r + dr + pr, c + dc + pc),\n0158:         (r + dr - pr, c + dc - pc),\n0159:     )\n0160:     return {\"direction\": direction, \"cross\": cross, \"support\": support, \"open_side\": open_side}\n0161: \n0162: \n0163: def _candidate_notches(r0, c0, h, w, edge):\n0164:     if edge in (\"top\", \"bottom\"):\n0165:         row = r0 if edge == \"top\" else r0 + h - 1\n0166:         centers = [(row, c) for c in range(c0 + _NOTCH_EDGE_MARGIN, c0 + w - _NOTCH_EDGE_MARGIN)]\n0167:     else:\n0168:         col = c0 if edge == \"left\" else c0 + w - 1\n0169:         centers = [(r, col) for r in range(r0 + _NOTCH_EDGE_MARGIN, r0 + h - _NOTCH_EDGE_MARGIN)]\n0170:     return [_notch_cells(r, c, edge) for r, c in centers]\n0171: \n0172: \n0173: def _choose_notches(r0, c0, h, w, count):\n0174:     edges = random.sample(_EDGES, count)\n0175:     random.shuffle(edges)\n0176:     choices = {edge: _candidate_notches(r0, c0, h, w, edge) for edge in edges}\n0177: \n---\n0286: def generate_input():\n0287:     for _ in range(_GEN_RETRY_LIMIT):\n0288:         grid = _gen_attempt()\n0289:         if grid is not None:\n0290:             return grid\n0291:     raise RuntimeError(\"failed to generate a valid 5b37cb25 input\")\n---\nFILE: /home/lixinyu/snap/new/ARC_code/train/98c475bf.py\n0061: def main(grid: np.ndarray) -> np.ndarray:\n0062:     \"\"\"Erase the complete interior glyph and expand each endpoint marker pair into its color's full glyph.\n0063: \n0064:     Input structure\n0065:     - The grid is 20x20 with background inside two same-color full-height vertical frame bars.\n0066:     - Inside the frame there is one complete color glyph and one or more other colors appearing only as two endpoint markers in the same row.\n0067:     - Marker endpoints are always in the first and last interior columns.\n0068: \n0069:     Rule\n0070:     - Keep the vertical frame unchanged.\n0071:     - Erase any complete interior glyph.\n0072:     - For each endpoint marker pair, use that marker color's learned glyph template and anchor its horizontal bar on the marker row.\n0073: \n0074:     Key insight\n0075:     - Color identifies which glyph shape to draw; the two endpoint pixels are not copied objects, they are anchors for reconstructing that color's full symbol.\n0076:     \"\"\"\n0077:     g = np.asarray(grid, dtype=int)\n0078:     assert g.ndim == 2\n0079:     height, width = g.shape\n0080:     assert (height, width) == (20, 20)\n0081: \n0082:     bg = get_bg(g)\n0083:     assert bg == 0\n0084:     frame_color = int(g[0, 0])\n0085:     assert frame_color != bg\n0086:     assert np.all(g[:, 0] == frame_color)\n0087:     assert np.all(g[:, -1] == frame_color)\n0088:     assert np.count_nonzero(g == frame_color) == 2 * height\n0089: \n0090:     out = g.copy()\n0091:     marker_jobs: list[tuple[int, int]] = []\n0092:     erased_any = False\n0093: \n0094:     for color0 in np.unique(g):\n0095:         color = int(color0)\n0096:         if color in (bg, frame_color):\n0097:             continue\n0098: \n0099:         coords = np.argwhere(g == color)\n0100:         rows = _marker_rows(coords, width)\n0101:         if rows is not None:\n0102:             for row in rows:\n0103:                 marker_jobs.append((color, row))\n0104:         else:\n0105:             assert len(coords) > 2\n0106:             out[g == color] = bg\n0107:             erased_any = True\n0108: \n0109:     assert erased_any\n0110:     assert marker_jobs\n0111: \n0112:     claimed: dict[tuple[int, int], int] = {}\n0113:     for color, anchor_row in marker_jobs:\n0114:         for dr, c in _glyph_cells(color, width):\n0115:             r = anchor_row + dr\n0116:             assert 0 <= r < height\n0117:             assert LEFT_MARKER_COL <= c <= width - 2\n0118:             assert (r, c) not in claimed or claimed[(r, c)] == color\n0119:             assert out[r, c] in (bg, color)\n0120:             claimed[(r, c)] = color\n0121: \n0122:     for (r, c), color in claimed.items():\n0123:         out[r, c] = color\n0124: \n0125:     return out\n0126: \n0127: # --------------- generator (att2) ---------------\n0128: \n0129: # Canvas and palette.\n0130: _GEN_SIZE = 20\n0131: _GEN_GLYPH_COLORS = [1, 2, 3, 6, 7]\n0132: _GEN_FRAME_COLORS = (1, 2, 5, 7, 9)\n0133: # Object counts and retry budget.\n0134: _GEN_MARKER_COUNT_RANGE = (1, 3)\n0135: _GEN_RETRIES = 300\n0136: \n0137: \n0138: def _gen_abs_cells(color: int, anchor_row: int) -> set[tuple[int, int]]:\n0139:     return {(anchor_row + dr, c) for dr, c in _glyph_cells(color, _GEN_SIZE)}\n0140: \n0141: \n0142: def _gen_valid_rows(color: int) -> list[int]:\n0143:     drs = [dr for dr, _ in _glyph_cells(color, _GEN_SIZE)]\n0144:     return list(range(-min(drs), _GEN_SIZE - max(drs)))\n0145: \n0146: \n0147: def _gen_framed_grid(frame_color: int) -> np.ndarray:\n0148:     grid = np.zeros((_GEN_SIZE, _GEN_SIZE), dtype=int)\n0149:     grid[:, 0] = frame_color\n0150:     grid[:, -1] = frame_color\n0151:     return grid\n0152: \n0153: \n0154: def _gen_render_glyph(grid: np.ndarray, color: int, anchor_row: int) -> None:\n0155:     for r, c in _gen_abs_cells(color, anchor_row):\n0156:         grid[r, c] = color\n0157: \n0158: \n0159: def _gen_marker_jobs(colors: list[int], rng: np.random.Generator) -> list[tuple[int, int]] | None:\n0160:     row_options = [_gen_valid_rows(color) for color in colors]\n0161:     choices: list[tuple[tuple[int, ...], list[tuple[int, int]]]] = []\n0162: \n0163:     if len(colors) == 1:\n0164:         for row in row_options[0]:\n0165:             choices.append(((row,), [(colors[0], row)]))\n0166:     else:\n0167:         for row0 in row_options[0]:\n0168:             cells0 = _gen_abs_cells(colors[0], row0)\n0169:             for row1 in row_options[1]:\n0170:                 if cells0.isdisjoint(_gen_abs_cells(colors[1], row1)):\n0171:                     choices.append(((row0, row1), [(colors[0], row0), (colors[1], row1)]))\n0172: \n0173:     if not choices:\n0174:         return None\n0175:     return choices[int(rng.integers(len(choices)))][1]\n0176: \n0177: \n0178: def _gen_example_rows(example_color: int, marker_jobs: list[tuple[int, int]]) -> list[int]:\n0179:     marker_points = {(row, 1) for _, row in marker_jobs} | {\n0180:         (row, _GEN_SIZE - 2) for _, row in marker_jobs\n---\n0223: def generate_input() -> np.ndarray:\n0224:     for _ in range(_GEN_RETRIES):\n0225:         grid = _gen_attempt()\n0226:         if grid is not None:\n0227:             return grid\n0228:     raise RuntimeError(\"failed to generate valid input\")\n---\n","exit_code":0,"status":"completed"}}
