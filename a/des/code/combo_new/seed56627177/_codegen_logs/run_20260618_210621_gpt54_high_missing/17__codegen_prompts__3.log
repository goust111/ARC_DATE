87:     - The direction is encoded by the crossbar's off-center position: the nearer end is the pointing end.\n0088:     \"\"\"\n0089:     g = np.asarray(grid, dtype=int)\n0090:     frame = _solid_frame_color(g)\n0091:     bg = int(get_bg(g[1:-1, 1:-1]))\n0092:     assert bg != frame, \"interior background must differ from the frame\"\n0093: \n0094:     sprite_colors = colors_present(g, exclude={bg, frame})\n0095:     assert sprite_colors, \"expected at least one sprite\"\n0096:     assert Color.BLACK not in set(sprite_colors) | {bg, frame}, \"black is reserved for opposite endpoints\"\n0097: \n0098:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=sprite_colors)\n0099:     assert len(components) == len(sprite_colors), \"expected one 4-connected object per sprite color\"\n0100: \n0101:     assignments: dict[tuple[int, int], int] = {}\n0102:     for component in components:\n0103:         assert int(component[\"area\"]) == 6, \"each sprite must have six pixels\"\n0104:         color = int(component[\"color\"])\n0105:         pointed, opposite = _sprite_endpoints(g, component[\"coords\"])\n0106: \n0107:         for coord, value in ((pointed, color), (opposite, Color.BLACK)):\n0108:             assert int(g[coord]) == frame, \"sprite endpoints must land on frame pixels\"\n0109:             assert coord not in assignments, \"frame endpoint assignments must not overlap\"\n0110:             assignments[coord] = int(value)\n0111: \n0112:     out = g.copy()\n0113:     for (r, c), value in assignments.items():\n0114:         out[r, c] = value\n0115:     return out\n0116: \n0117: # --------------- generator (att2) ---------------\n0118: \n0119: # Canvas and fixed colors.\n0120: GRID_SIZE, FRAME_COLOR, BACKGROUND_COLOR = 11, 6, 7\n0121: LAST = GRID_SIZE - 1\n0122: \n0123: # Sprite sampling and shape.\n0124: SPRITE_COUNT, SPRITE_COLORS = 4, [1, 2, 3, 4, 5, 8, 9]\n0125: ORIENTATIONS, DIRECTIONS = (\"H\", \"V\"), {\"H\": (\"left\", \"right\"), \"V\": (\"up\", \"down\")}\n0126: BAR_LENGTH, CROSSBAR_LENGTH = 4, 3\n0127: CROSSBAR_MID, NEAR_END_OFFSET, FAR_END_OFFSET = 1, 1, 2\n0128: TRANSPARENT = -1\n0129: \n0130: # Interior placement and retry bounds.\n0131: AXIS_LINES, MAX_GENERATION_ATTEMPTS = range(2, 9), 300\n0132: BAR_START_MIN, BAR_START_MAX = 1, 6\n0133: \n0134: def _make_sprite(color: int, orientation: str, direction: str) -> np.ndarray:\n0135:     \"\"\"Return one transparent-backed asymmetric T sprite patch.\"\"\"\n0136:     patch = np.full((CROSSBAR_LENGTH, BAR_LENGTH) if orientation == \"H\" else (BAR_LENGTH, CROSSBAR_LENGTH), TRANSPARENT, dtype=int)\n0137:     if orientation == \"H\":\n0138:         offset = NEAR_END_OFFSET if direction == DIRECTIONS[\"H\"][0] else FAR_END_OFFSET\n0139:         patch[CROSSBAR_MID, :] = color\n0140:         patch[:, offset] = color\n0141:     else:\n0142:         offset = NEAR_END_OFFSET if direction == DIRECTIONS[\"V\"][0] else FAR_END_OFFSET\n0143:         patch[:, CROSSBAR_MID] = color\n0144:         patch[offset, :] = color\n0145:     return patch\n0146: \n0147: def _sample_plan():\n0148:     \"\"\"Sample layout-independent choices in the original random order.\"\"\"\n0149:     colors = random.sample(SPRITE_COLORS, SPRITE_COUNT)\n0150:     orientations = [random.choice(ORIENTATIONS) for _ in range(SPRITE_COUNT)]\n0151:     axes_by_orientation = {\n0152:         orient: random.sample(AXIS_LINES, orientations.count(orient))\n0153:         for orient in ORIENTATIONS\n0154:     }\n0155:     order = list(range(SPRITE_COUNT))\n0156:     random.shuffle(order)\n0157:     return colors, orientations, axes_by_orientation, order\n0158: \n0159: def _try_place_sprite(grid, color, orientation, axis, placed_endpoints) -> bool:\n0160:     \"\"\"Sample one sprite's direction/start and paste it if pixels/endpoints are free.\"\"\"\n0161:     direction = random.choice(DIRECTIONS[orientation])\n0162:     bar_start = random.randint(BAR_START_MIN, BAR_START_MAX)\n0163:     if orientation == \"H\":\n0164:         top, left = axis - CROSSBAR_MID, bar_start\n0165:         near_frame, far_frame = (axis, 0), (axis, LAST)\n0166:     else:\n0167:         top, left = bar_start, axis - CROSSBAR_MID\n0168:         near_frame, far_frame = (0, axis), (LAST, axis)\n0169:     pointed_frame, opposite_frame = (near_frame, far_frame) if direction == DIRECTIONS[orientation][0] else (far_frame, near_frame)\n0170:     if pointed_frame in placed_endpoints or opposite_frame in placed_endpoints:\n0171:         return False\n0172: \n0173:     patch = _make_sprite(color, orientation, direction)\n0174:     view = grid[top : top + patch.shape[0], left : left + patch.shape[1]]\n0175:     mask = patch != TRANSPARENT\n0176:     if view.shape != patch.shape or np.any(view[mask] != BACKGROUND_COLOR):\n0177:         return False\n0178: \n0179:     paste(grid, patch, top, left, transparent=TRANSPARENT)\n0180:     placed_endpoints[pointed_frame] = color\n0181:     placed_endpoints[opposite_frame] = Color.BLACK\n0182:     return True\n0183: \n0184: def _matches_solver_oracle(grid, placed_endpoints) -> bool:\n0185:     \"\"\"Check that the solver agrees with the recorded frame endpoint edits.\"\"\"\n0186:     expected = grid.copy()\n0187:     for coord, color in placed_endpoints.items():\n0188:         expected[coord] = color\n0189:     try:\n0190:         return np.array_equal(main(grid), expected)\n---\n0208: def generate_input() -> np.ndarray:\n0209:     for _ in range(MAX_GENERATION_ATTEMPTS):\n0210:         grid = _gen_attempt()\n0211:         if grid is not None:\n0212:             return grid\n0213:     raise RuntimeError(\"failed to generate a valid 689c358e input\")\n---\nFILE: /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py\n0017: def main(grid: np.ndarray) -> np.ndarray:\n0018:     \"\"\"\n0019:     Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n0020: \n0021:     Input structure\n0022:     - The most common color forms the outer background and all enclosed slot\n0023:       backgrounds.\n0024:     - The enclosed background components form a complete rectangular array of\n0025:       slots, ordered by their positions.\n0026:     - Each slot contains either no other color or exactly one object color.\n0027: \n0028:     Rule\n0029:     - Find all 4-connected components of the most common color that do not touch\n0030:       the input edge.\n0031:     - Sort their bounding boxes into row and column order to define the output\n0032:       table.\n0033:     - For each slot, output its unique non-background color if present; otherwise\n0034:       output the background color.\n0035: \n0036:     Key insight\n0037:     - The large grid is an expanded table: the enclosed background components are\n0038:       the cells, and any colored object drawn inside a cell is that cell's summary\n0039:       value.\n0040:     \"\"\"\n0041:     g = np.asarray(grid, dtype=int)\n0042:     assert g.ndim == 2, \"expected a 2D grid\"\n0043:     height, width = map(int, g.shape)\n0044: \n0045:     bg = get_bg(g)\n0046:     slot_bboxes: list[tuple[int, int, int, int]] = []\n0047:     for coords in components_mask(g == bg, connectivity=4):\n0048:         if _touches_edge(coords, height, width):\n0049:             continue\n0050:         slot_bboxes.append(bbox_coords(coords))\n0051: \n0052:     assert slot_bboxes, \"expected enclosed background slots\"\n0053:     row_starts = sorted({b[0] for b in slot_bboxes})\n0054:     col_starts = sorted({b[1] for b in slot_bboxes})\n0055:     assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n0056:         \"expected a complete rectangular array of slots\"\n0057:     )\n0058: \n0059:     slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n0060:     assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n0061: \n0062:     out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n0063:     for out_r, r0 in enumerate(row_starts):\n0064:         for out_c, c0 in enumerate(col_starts):\n0065:             assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n0066:             sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n0067:             window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n0068:             object_colors = np.unique(window[window != bg])\n0069:             assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n0070:             if object_colors.size == 1:\n0071:                 out[out_r, out_c] = int(object_colors[0])\n0072: \n0073:     return out\n0074: \n0075: # --------------- generator (att2) ---------------\n0076: \n0077: # Canvas, table, frame, and slot dimensions.\n0078: CANVAS_MIN, CANVAS_MAX = 13, 19\n0079: TABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\n0080: ROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\n0081: AXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n0082: \n0083: # Object and palette sampling limits.\n0084: N_COLORS, MAX_OBJECT_COLORS = 10, 6\n0085: MAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\n0086: OBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n0087: \n0088: # Rejection sampling cap.\n0089: GEN_RETRY_LIMIT = 300\n0090: \n0091: \n0092: def _gen_axis_options(n_slots, slot_min, slot_max):\n0093:     options = []\n0094: \n0095:     def rec_slots(i, cur):\n0096:         if i == n_slots:\n0097:             rec_seps(0, [], cur)\n0098:             return\n0099:         for size in range(slot_min, slot_max + 1):\n0100:             rec_slots(i + 1, cur + [size])\n0101: \n0102:     def rec_seps(i, cur, slots):\n0103:         if i == n_slots - 1:\n0104:             for before in AXIS_OUTER_OPTIONS:\n0105:                 for after in AXIS_OUTER_OPTIONS:\n0106:                     for pad_before in AXIS_PADDING_OPTIONS:\n0107:                         for pad_after in AXIS_PADDING_OPTIONS:\n0108:                             total = (\n0109:                                 before\n0110:                                 + after\n0111:                                 + pad_before\n0112:                                 + pad_after\n0113:                                 + sum(slots)\n0114:                                 + sum(cur)\n0115:                             )\n0116:                             if 13 <= total <= 19:\n0117:                                 options.append(\n0118:                                     (\n0119:                                         tuple(slots),\n0120:                                         tuple(cur),\n0121:                                         before,\n0122:                                         after,\n0123:                                         pad_before,\n0124:                                         pad_after,\n0125:                                         total,\n0126:                                 )\n0127:                             )\n0128:             return\n0129:         for sep in AXIS_SEPARATOR_OPTIONS:\n0130:             rec_seps(i + 1, cur + [sep], slots)\n0131: \n0132:     rec_slots(0, [])\n0133:     return options\n0134: \n0135: \n0136: def _gen_positions(axis):\n---\n0259: def generate_input() -> np.ndarray:\n0260:     for _ in range(GEN_RETRY_LIMIT):\n0261:         grid = _gen_attempt()\n0262:         if grid is not None:\n0263:             return grid\n0264:     raise RuntimeError(\"failed to generate valid ac6f9922 input\")\n---\nFILE: /home/lixinyu/snap/new/ARC_code/train/6ca952ad.py\n0014: def main(grid: np.ndarray) -> np.ndarray:\n0015:     \"\"\"\n0016:     Drop every large foreground object straight down to the bottom while leaving small marker objects fixed.\n0017: \n0018:     Input structure:\n0019:     - The grid has a dominant background color and exactly one foreground color.\n0020:     - The foreground is split into separated 4-connected objects.\n0021:     - Objects of area at most three are stationary markers; larger objects are moving sprites.\n0022: \n0023:     Rule:\n0024:     - Clear each moving sprite from its original position.\n0025:     - Translate each moving sprite vertically downward until its bbox bottom reaches the grid bottom.\n0026:     - Repaint each translated sprite in its original color; small markers stay unchanged.\n0027: \n0028:     Key insight:\n0029:     - Object area separates the active falling sprites from the small fixed markers, and all active sprites follow the same vertical path.\n0030:     \"\"\"\n0031:     g = np.asarray(grid, dtype=int)\n0032:     H, W = g.shape\n0033:     bg = int(get_bg(g))\n0034: \n0035:     fg_colors = colors_present(g, exclude={bg})\n0036:     assert len(fg_colors) == 1, \"expected exactly one foreground color\"\n0037:     fg = int(fg_colors[0])\n0038: \n0039:     components = find_components(\n0040:         g,\n0041:         bg=bg,\n0042:         connectivity=4,\n0043:         monochromatic=True,\n0044:         colors=[fg],\n0045:         return_format=\"dict\",\n0046:     )\n0047:     assert components, \"expected foreground objects\"\n0048: \n0049:     moving = [comp for comp in components if int(comp[\"area\"]) > SMALL_MARKER_MAX_AREA]\n0050:     stationary = [comp for comp in components if int(comp[\"area\"]) <= SMALL_MARKER_MAX_AREA]\n0051:     assert moving, \"expected at least one moving sprite\"\n0052:     assert stationary, \"expected at least one fixed marker\"\n0053: \n0054:     out = g.copy()\n0055:     for comp in moving:\n0056:         coords = comp[\"coords\"]\n0057:         out[coords[:, 0], coords[:, 1]] = bg\n0058: \n0059:     occupied = np.zeros((H, W), dtype=bool)\n0060:     for comp in moving:\n0061:         coords = comp[\"coords\"]\n0062:         _r0, _c0, r1, _c1 = map(int, comp[\"bbox\"])\n0063:         dr = H - 1 - r1\n0064:         assert dr >= 0, \"moving sprite bbox must already be inside the grid\"\n0065: \n0066:         shifted = coords + np.array([dr, 0], dtype=int)\n0067:         assert bool(np.all((0 <= sh