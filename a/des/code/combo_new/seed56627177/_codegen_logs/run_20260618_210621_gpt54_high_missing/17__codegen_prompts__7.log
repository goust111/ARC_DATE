{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/eval/62593bfd.py /home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py /home/lixinyu/snap/new/ARC_code/train/470c91de.py /home/lixinyu/snap/new/ARC_code/train/11dc524f.py /home/lixinyu/snap/new/ARC_code/eval/247ef758.py /home/lixinyu/snap/new/ARC_code/train/825aa9e9.py; do echo \"FILE:$f\"; sed -n '\"'/\"'^def main(/,/''^# ---------------/p'\"' \\\"\"'$f\"; sed -n '\"'/\"'^def generate_input(/,$p'\"' \\\"\"'$f\"; done'","aggregated_output":"FILE:/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Sort objects to top or bottom edge by whether their shape (up to rotation/flip) is shared.\n\n    Input structure:\n    - bg = most common color.\n    - Several multicolor connected components (8-connected) scattered across the grid.\n\n    Rule:\n    - Compute each object's canonical shape (binary mask, invariant to rotation and flip).\n    - Objects whose shape appears in two or more components → translate to TOP edge (row 0).\n    - Objects whose shape is unique → translate to BOTTOM edge (row H−h).\n    - Horizontal position (left column) is preserved; only vertical translation changes.\n\n    Key insight: The sorting criterion is shape frequency (rotation-invariant), not area — duplicated shapes go up, unique shapes go down.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n\n    extracted = []\n    for comp in comps:\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        patch = crop_bbox(g, (r0, c0, r1, c1))\n\n        # Isolate this component exactly (bbox rectangle may include background).\n        rel_coords = [(int(r) - r0, int(c) - c0) for r, c in comp[\"coords\"]]\n        m = mask_from_coords(rel_coords, patch.shape)\n        pat = np.full_like(patch, bg)\n        pat[m] = patch[m]\n\n        extracted.append(\n            {\n                \"c0\": int(c0),\n                \"pat\": pat,\n                \"shape_key\": canonical_shape_key(m),\n            }\n        )\n\n    freq = Counter(d[\"shape_key\"] for d in extracted)\n    out = np.full((H, W), int(bg), dtype=int)\n\n    for d in extracted:\n        pat = d[\"pat\"]\n        h, w = map(int, pat.shape)\n        dest_r0 = 0 if int(freq[d[\"shape_key\"]]) >= 2 else int(H - h)\n        dest_c0 = int(d[\"c0\"])\n        paste(out, pat, dest_r0, dest_c0, transparent=int(bg))\n\n    return out\n\n# --------------- generator (att2) ---------------\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 62593bfd sample\")\nFILE:/home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Shear the rectangular input down-left onto a black canvas.\n\n    Input structure\n    A rectangular grid of colored pixels with no internal empty region to infer.\n\n    Rule\n    Create a black output with the same height and width W + H - 1, then copy\n    each input row r unchanged starting at column H - 1 - r.\n\n    Key insight\n    The colors and row contents are preserved; only the row offsets change so\n    the left edge forms a descending diagonal.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    out = np.zeros((h, w + h - 1), dtype=int)\n    for r in range(h):\n        start = h - 1 - r\n        out[r, start : start + w] = g[r]\n    return out\n\n# --------------- generator (att2, o5x) ---------------\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\nFILE:/home/lixinyu/snap/new/ARC_code/train/470c91de.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each teal-cornered filled rectangle one cell diagonally toward its teal corner.\n\n    Input structure:\n    - Dominant background surrounds several filled rectangular colored objects.\n    - Each object has exactly one teal control pixel replacing one corner cell of\n      its rectangle.\n\n    Rule:\n    - Treat the teal pixel as the missing corner of its colored rectangle.\n    - Erase each original rectangle footprint, including the teal pixel.\n    - Repaint the completed rectangle shifted one cell diagonally in the direction\n      of that teal corner.\n\n    Key insight:\n    - The control pixel's corner position gives both the missing cell to restore\n      and the diagonal motion vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    moves = _rectangle_moves(g, bg)\n\n    out = g.copy()\n    for r0, c0, r1, c1, _color, _dr, _dc in moves:\n        out[r0 : r1 + 1, c0 : c1 + 1] = bg\n\n    occupied = np.zeros_like(g, dtype=bool)\n    for r0, c0, r1, c1, color, dr, dc in moves:\n        tr0, tr1 = r0 + dr, r1 + dr\n        tc0, tc1 = c0 + dc, c1 + dc\n        assert not occupied[tr0 : tr1 + 1, tc0 : tc1 + 1].any(), \"shifted rectangles must not overlap\"\n        assert np.all(out[tr0 : tr1 + 1, tc0 : tc1 + 1] == bg), \"target region must be background\"\n        out[tr0 : tr1 + 1, tc0 : tc1 + 1] = color\n        occupied[tr0 : tr1 + 1, tc0 : tc1 + 1] = True\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\ndef generate_input() -> np.ndarray:\n    for _ in range(_MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 470c91de input\")\nFILE:/home/lixinyu/snap/new/ARC_code/train/11dc524f.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide the non-square sprite to the square anchor and replace the anchor with the sprite's mirror image.\n\n    Input structure:\n    - The background is the most common color.\n    - There is one 8-connected non-background sprite that is not a solid 2x2 square.\n    - There is one solid 2x2 square anchor in another non-background color.\n\n    Rule:\n    - Move the sprite straight toward the anchor along their unique cardinal separation until it touches the anchor's near edge.\n    - Reflect the moved sprite across that near edge and draw the reflected copy in the anchor color.\n    - Clear the original locations; the output keeps only the moved sprite and reflected anchor-color copy.\n\n    Key insight:\n    - The 2x2 square marks the mirror line: its side facing the sprite becomes the contact edge for a two-color reflected pair.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = map(int, g.shape)\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert len(comps) == 2\n\n    anchors = [comp for comp in comps if _is_solid_2x2(comp, g)]\n    assert len(anchors) == 1\n    anchor = anchors[0]\n\n    sprites = [comp for comp in comps if comp is not anchor]\n    assert len(sprites) == 1\n    sprite = sprites[0]\n    assert int(sprite[\"color\"]) != int(anchor[\"color\"])\n\n    sr0, sc0, sr1, sc1 = map(int, sprite[\"bbox\"])\n    ar0, ac0, ar1, ac1 = map(int, anchor[\"bbox\"])\n\n    candidates: list[tuple[str, int, int]] = []\n    if sc1 < ac0 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"left\", 0, ac0 - sc1 - 1))\n    if sc0 > ac1 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"right\", 0, ac1 + 1 - sc0))\n    if sr1 < ar0 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"above\", ar0 - sr1 - 1, 0))\n    if sr0 > ar1 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"below\", ar1 + 1 - sr0, 0))\n    assert len(candidates) == 1\n\n    side, dr, dc = candidates[0]\n    moved: list[tuple[int, int]] = []\n    mirrored: list[tuple[int, int]] = []\n    for r, c in sprite[\"coords\"]:\n        rr = int(r) + int(dr)\n        cc = int(c) + int(dc)\n        moved.append((rr, cc))\n        if side == \"left\":\n            mirrored.append((rr, 2 * ac0 - 1 - cc))\n        elif side == \"right\":\n            mirrored.append((rr, 2 * ac1 + 1 - cc))\n        elif side == \"above\":\n            mirrored.append((2 * ar0 - 1 - rr, cc))\n        else:\n            mirrored.append((2 * ar1 + 1 - rr, cc))\n\n    assert all(0 <= r < H and 0 <= c < W for r, c in moved)\n    assert all(0 <= r < H and 0 <= c < W for r, c in mirrored)\n    assert not (set(moved) & set(mirrored))\n\n    out = np.full_like(g, bg)\n    for r, c in moved:\n        out[r, c] = int(sprite[\"color\"])\n    for r, c in mirrored:\n        out[r, c] = int(anchor[\"color\"])\n    return out\n\n# --------------- generator (o5x) ---------------\ndef generate_input() -> np.ndarray:\n    for _ in range(RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 11dc524f input\")\nFILE:/home/lixinyu/snap/new/ARC_code/eval/247ef758.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move colored sprites from the left strip into a framed area at marker-defined targets.\n\n    Input structure:\n    - bg background; rectangular frame on right with colored markers on its edges; sprites in a narrow left strip separated by a constant-color divider column.\n\n    Rule:\n    - For each color, target rows/cols are where both opposite frame edges share that color. Targets are the Cartesian product.\n    - Erase each sprite from the left and stamp it centered at every target. Higher sprites cover lower ones.\n\n    Key insight: One sprite replicates to a grid of row × column marker intersections.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # --- frame interior: largest bg component not touching boundary ---\n    inner_bbox = largest_enclosed_component_bbox(g == int(bg), connectivity=4)\n    assert not (inner_bbox is None)\n    ir0, ic0, ir1, ic1 = map(int, inner_bbox)\n    fr0, fc0, fr1, fc1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)\n\n    # --- divider columns (fixed) on the left side ---\n    divider_mask = np.zeros((H, W), dtype=bool)\n    for c in range(0, max(0, int(fc0))):\n        colv = g[:, int(c)]\n        non = colv[colv != int(bg)]\n        if int(len(non)) >= int(H - 1) and len(set(map(int, non))) == 1:\n            divider_mask[:, int(c)] = True\n\n    left_cols = (np.arange(W)[None, :] < int(fc0))\n\n    # --- sprites: per-color 8-connected components in left area (excluding divider) ---\n    sprites = []\n    for col in sorted(set(map(int, g.flatten())) - {int(bg)}):\n        mask = (g == int(col)) & left_cols & (~divider_mask)\n        if not bool(mask.any()):\n            continue\n        slab, sn = label_mask(mask, connectivity=8)\n        for sid in range(1, int(sn) + 1):\n            pts = np.argwhere(slab == int(sid))\n            r0, c0 = pts.min(axis=0)\n            r1, c1 = pts.max(axis=0)\n            r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n            m = slab[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(sid)\n            sprites.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"r1\": int(r1), \"c1\": int(c1), \"mask\": m})\n\n    move_colors = {int(s[\"color\"]) for s in sprites}\n\n    # --- marker-derived targets (restricted to colors that actually appear as sprites) ---\n    row_marks: dict[int, list[int]] = defaultdict(list)\n    col_marks: dict[int, list[int]] = defaultdict(list)\n    for r in range(int(ir0), int(ir1) + 1):\n        cl = int(g[int(r), int(fc0)])\n        cr = int(g[int(r), int(fc1)])\n        if cl == cr and cl != int(bg) and cl in move_colors:\n            row_marks[int(cl)].append(int(r))\n    for c in range(int(ic0), int(ic1) + 1):\n        ct = int(g[int(fr0), int(c)])\n        cb = int(g[int(fr1), int(c)])\n        if ct == cb and ct != int(bg) and ct in move_colors:\n            col_marks[int(ct)].append(int(c))\n\n    targets: dict[int, list[tuple[int, int]]] = {}\n    for col in set(row_marks.keys()) & set(col_marks.keys()):\n        pts = {(int(r), int(c)) for r in row_marks[int(col)] for c in col_marks[int(col)]}\n        targets[int(col)] = sorted(pts)\n\n    out = g.copy()\n    movers = [s for s in sprites if int(s[\"color\"]) in targets]\n\n    # Erase originals of moved sprites.\n    for s in movers:\n        r0, c0 = int(s[\"r0\"]), int(s[\"c0\"])\n        for rr, cc in np.argwhere(s[\"mask\"]):\n            out[int(r0) + int(rr), int(c0) + int(cc)] = int(bg)\n\n    # Bottom-to-top ordering: lower sprites first, upper sprites last (covering).\n    movers.sort(key=lambda s: (-((int(s[\"r0\"]) + int(s[\"r1\"])) / 2.0), int(s[\"c0\"])))\n\n    for s in movers:\n        col = int(s[\"color\"])\n        cr = (int(s[\"r0\"]) + int(s[\"r1\"])) // 2\n        cc = (int(s[\"c0\"]) + int(s[\"c1\"])) // 2\n        pix = [(int(s[\"r0\"]) + int(rr), int(s[\"c0\"]) + int(cc2)) for rr, cc2 in np.argwhere(s[\"mask\"])]\n\n        for tr, tc in targets[int(col)]:\n            dr = int(tr - cr)\n            dc = int(tc - cc)\n            for r, c in pix:\n                rr = int(r + dr)\n                cc3 = int(c + dc)\n                if int(ir0) <= rr <= int(ir1) and int(ic0) <= cc3 <= int(ic1):\n                    out[rr, cc3] = int(col)\n\n    return out\n\n\n# ---------------------------------------------------------------------------\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\nFILE:/home/lixinyu/snap/new/ARC_code/train/825aa9e9.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the moving-color objects downward until they rest above a one-row cushion before the obstacle or bottom edge.\n\n    Input structure:\n    - The grid has exactly three colors: empty background, a stationary obstacle/floor color, and a moving object color.\n    - The obstacle color is the unique non-background role that touches the bottom edge.\n    - Moving pixels start outside the obstacle cells, outside the row directly above each obstacle pixel, and outside the bottom row.\n\n    Rule:\n    - Keep the background and obstacle pixels fixed.\n    - Treat obstacle pixels, cells directly above obstacle pixels, and the bottom row as blocked.\n    - Repeatedly move every 4-connected moving-color object one row down when its translated shape does not hit blocked cells or another moving object.\n\n    Key insight: The visible floor has an invisible one-row cushion above it, so the objects fall under gravity but stop with one empty row before the floor or the grid bottom.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg, obstacle, moving = _infer_roles(g)\n    _assert_obstacle_profile(g, obstacle)\n    blocked = _blocked_mask(g, obstacle)\n    assert not np.any(blocked & (g == moving)), \"moving pixels must start in free cells\"\n\n    out = g.copy()\n    while True:\n        moves = _movable_components(out, bg, moving, blocked)\n        if not moves:\n            break\n        for coords, _ in moves:\n            out[coords[:, 0], coords[:, 1]] = bg\n        for _, shifted in moves:\n            out[shifted[:, 0], shifted[:, 1]] = moving\n\n    _assert_output_separated(out, obstacle, moving)\n    return out\n\n# --------------- generator (att2) ---------------\ndef generate_input():\n    for _ in range(GENERATE_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 825aa9e9 input\")\n","exit_code":0,"status":"completed"}}
