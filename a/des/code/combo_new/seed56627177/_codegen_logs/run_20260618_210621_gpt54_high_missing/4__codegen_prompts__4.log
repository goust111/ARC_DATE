{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/afe3afe9.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg, paste\nimport random\n\n\ndef _marker_side(g: np.ndarray, bg: int) -> tuple[str, int]:\n    sides: list[tuple[str, int]] = []\n    for color in set(map(int, g.ravel())) - {bg}:\n        if np.all(g[0, :] == color):\n            sides.append((\"top\", color))\n        if np.all(g[:, -1] == color):\n            sides.append((\"right\", color))\n        if np.all(g[-1, :] == color):\n            sides.append((\"bottom\", color))\n        if np.all(g[:, 0] == color):\n            sides.append((\"left\", color))\n\n    assert len(sides) == 1, sides\n    return sides[0]\n\n\ndef _symbolic_grid(g: np.ndarray) -> tuple[np.ndarray, str, int]:\n    bg = get_bg(g)\n    side, marker = _marker_side(g, bg)\n    assert marker == 1, marker\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n\n    objects: list[tuple[int, int, int]] = []\n    for component in components:\n        color = component[\"color\"]\n        if color == marker:\n            continue\n\n        b = component[\"bbox\"]\n        assert component[\"area\"] == 8, component\n        assert bbox_h(b) == 3 and bbox_w(b) == 3, component\n\n        r0, c0, r1, c1 = b\n        patch = g[r0 : r1 + 1, c0 : c1 + 1]\n        expected = np.full((3, 3), color, dtype=int)\n        expected[1, 1] = bg\n        assert np.array_equal(patch, expected), patch\n        objects.append((r0, c0, color))\n\n    assert objects\n    rows = sorted({r for r, _c, _color in objects})\n    cols = sorted({c for _r, c, _color in objects})\n    symbolic = np.full((len(rows), len(cols)), bg, dtype=int)\n    row_index = {r: i for i, r in enumerate(rows)}\n    col_index = {c: i for i, c in enumerate(cols)}\n\n    for r, c, color in objects:\n        rr = row_index[r]\n        cc = col_index[c]\n        assert symbolic[rr, cc] == bg\n        symbolic[rr, cc] = color\n\n    if side in (\"top\", \"bottom\"):\n        dominant_cols = range(3, 6) if side == \"top\" else range(0, 3)\n        dominant_values = [\n            int(symbolic[r, c])\n            for r in range(symbolic.shape[0])\n            for c in dominant_cols\n            if int(symbolic[r, c]) != bg\n        ]\n    else:\n        dominant_rows = range(0, 3) if side == \"left\" else range(3, 6)\n        dominant_values = [\n            int(symbolic[r, c])\n            for r in dominant_rows\n            for c in range(symbolic.shape[1])\n            if int(symbolic[r, c]) != bg\n        ]\n    assert dominant_values and set(dominant_values) == {8}, dominant_values\n\n    return symbolic, side, bg\n\n\ndef _compact(symbolic: np.ndarray, side: str, bg: int) -> np.ndarray:\n    out = np.full_like(symbolic, bg)\n\n    if side == \"top\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, symbolic.shape[1] - len(values) :] = values\n    elif side == \"right\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[symbolic.shape[0] - len(values) :, c] = values\n    elif side == \"bottom\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, : len(values)] = values\n    elif side == \"left\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[: len(values), c] = values\n    else:\n        raise AssertionError(side)\n\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Convert each hollow 3x3 symbol to one pixel and slide the pixels clockwise from the marked edge.\n\n    Input structure\n    - The grid has a background, one full-edge marker line, and monochrome hollow 3x3 foreground symbols.\n    - The symbols lie on a coarse row/column lattice; fully empty lattice rows or columns are absent from the output.\n\n    Rule\n    - Replace each hollow 3x3 symbol with one pixel of its color in the corresponding coarse-grid cell.\n    - The marker edge gives the compaction direction by clockwise border travel: top -> right, right -> down, bottom -> left, left -> up.\n    - Preserve the order of non-background pixels while sliding them as far as possible in that direction.\n\n    Key insight\n    - The large picture is a scaled symbolic grid, and the blue edge marker acts as a gravity direction rather than as output content.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    symbolic, side, bg = _symbolic_grid(g)\n    return _compact(symbolic, side, bg)\n\n# --------------- generator (att2) ---------------\n\n# Canvas and colors.\nGEN_BG = 0\nGEN_GRID_SHAPE = (30, 30)\nGEN_MARKER_COLOR = 1\nGEN_DOMINANT_COLOR = 8\nGEN_ACCENT_COLORS = [2, 3, 4, 5, 6, 7, 9]\n\n# Symbolic lattice layout.\nGEN_SIDES = [\"top\", \"right\", \"bottom\", \"left\"]\nGEN_SYMBOLIC_HW = (7, 6)\nGEN_SYMBOLIC_VW = (6, 7)\nGEN_DOMINANT_COUNT_RANGE = (13, 17)\nGEN_ACCENT_COUNT_RANGE = (6, 8)\nGEN_SPLIT_INDEX = 3\n\n# Physical lattice coordinates.\nGEN_GAP_SIX_POSITIONS = [1, 5, 9, 17, 21, 25]\nGEN_SEVEN_FROM_MARKER = [2, 6, 10, 14, 18, 22, 26]\nGEN_SEVEN_FROM_OTHER = [1, 5, 9, 13, 17, 21, 25]\nGEN_SYMBOL_PATCH_SIZE = 3\n\n# Generation retries.\nGEN_MAX_ATTEMPTS = 300\n\ndef _gen_compact(symbolic, side, bg):\n    out = np.full_like(symbolic, bg)\n\n    if side == \"top\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, symbolic.shape[1] - len(values) :] = values\n    elif side == \"right\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[symbolic.shape[0] - len(values) :, c] = values\n    elif side == \"bottom\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, : len(values)] = values\n    elif side == \"left\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[: len(values), c] = values\n    else:\n        raise AssertionError(side)\n\n    return out\n\n\ndef _gen_covering_cells(rows, cols, count):\n    rows = list(rows)\n    cols = list(cols)\n    cells = set()\n\n    shuffled_rows = rows[:]\n    random.shuffle(shuffled_rows)\n    for r in shuffled_rows:\n        cells.add((r, random.choice(cols)))\n\n    for c in cols:\n        if all(cc != c for _rr, cc in cells):\n            cells.add((random.choice(rows), c))\n\n    remaining = [(r, c) for r in rows for c in cols if (r, c) not in cells]\n    random.shuffle(remaining)\n    cells.update(remaining[: count - len(cells)])\n    return cells\n\n\ndef _gen_fill(symbolic, rows, cols, count, color):\n    for r, c in _gen_covering_cells(rows, cols, count):\n        symbolic[r, c] = color\n\n\ndef _gen_symbolic(side, bg):\n    color_a, color_b = random.sample(GEN_ACCENT_COLORS, 2)\n\n    if side in (\"top\", \"bottom\"):\n        symbolic = np.full(GEN_SYMBOLIC_HW, bg, dtype=int)\n        dominant_cols = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1]) if side == \"top\" else range(0, GEN_SPLIT_INDEX)\n        accent_cols = range(0, GEN_SPLIT_INDEX) if side == \"top\" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1])\n        _gen_fill(symbolic, range(GEN_SYMBOLIC_HW[0]), dominant_cols, random.randint(*GEN_DOMINANT_COUNT_RANGE), GEN_DOMINANT_COLOR)\n        _gen_fill(symbolic, range(0, GEN_SPLIT_INDEX), accent_cols, random.randint(*GEN_ACCENT_COUNT_RANGE), color_a)\n        _gen_fill(symbolic, range(GEN_SPLIT_INDEX + 1, GEN_SYMBOLIC_HW[0]), accent_cols, random.randint(*GEN_ACCENT_COUNT_RANGE), color_b)\n    else:\n        symbolic = np.full(GEN_SYMBOLIC_VW, bg, dtype=int)\n        dominant_rows = range(0, GEN_SPLIT_INDEX) if side == \"left\" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0])\n        accent_rows = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0]) if side == \"left\" else range(0, GEN_SPLIT_INDEX)\n        _gen_fill(symbolic, dominant_rows, range(GEN_SYMBOLIC_VW[1]), random.randint(*GEN_DOMINANT_COUNT_RANGE), GEN_DOMINANT_COLOR)\n        _gen_fill(symbolic, accent_rows, range(0, GEN_SPLIT_INDEX), random.randint(*GEN_ACCENT_COUNT_RANGE), color_a)\n        _gen_fill(symbolic, accent_rows, range(GEN_SPLIT_INDEX + 1, GEN_SYMBOLIC_VW[1]), random.randint(*GEN_ACCENT_COUNT_RANGE), color_b)\n\n    return symbolic\n\n\ndef _gen_lattice_positions(side):\n    if side == \"top\":\n        return GEN_SEVEN_FROM_MARKER, GEN_GAP_SIX_POSITIONS\n    if side == \"bottom\":\n        return GEN_SEVEN_FROM_OTHER, GEN_GAP_SIX_POSITIONS\n    if side == \"left\":\n        return GEN_GAP_SIX_POSITIONS, GEN_SEVEN_FROM_MARKER\n    return GEN_GAP_SIX_POSITIONS, GEN_SEVEN_FROM_OTHER\n\n\ndef _gen_place_marker(grid, side):\n    if side == \"top\":\n        grid[0, :] = GEN_MARKER_COLOR\n    elif side == \"right\":\n        grid[:, -1] = GEN_MARKER_COLOR\n    elif side == \"bottom\":\n        grid[-1, :] = GEN_MARKER_COLOR\n    else:\n        grid[:, 0] = GEN_MARKER_COLOR\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/ad173014.py\"","aggregated_output":"import math\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, is_contiguous\nimport random\n\n\nRED = 2\nBLUE = 1\n\n\ndef _extract_frames(g: np.ndarray, bg: int) -> tuple[list[dict], list[np.ndarray]]:\n    red_components = components_mask(g == RED, connectivity=4)\n    assert len(red_components) >= 3\n\n    frames = []\n    for coords in red_components:\n        r0, c0, r1, c1 = bbox_coords(coords)\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert h == w and h >= 3\n\n        patch = g[r0 : r1 + 1, c0 : c1 + 1]\n        border = np.zeros((h, w), dtype=bool)\n        border[0, :] = True\n        border[-1, :] = True\n        border[:, 0] = True\n        border[:, -1] = True\n\n        assert int(border.sum()) == int(coords.shape[0])\n        assert np.all(patch[border] == RED)\n        assert np.all(patch[~border] != RED)\n\n        interior = patch[1:-1, 1:-1]\n        interior_colors = set(map(int, np.unique(interior))) - {int(bg)}\n        assert len(interior_colors) == 1\n        color = interior_colors.pop()\n        mask = interior == color\n        assert mask.any()\n\n        frames.append(\n            {\n                \"bbox\": (r0, c0, r1, c1),\n                \"center\": ((r0 + r1) / 2, (c0 + c1) / 2),\n                \"color\": color,\n                \"mask\": mask,\n            }\n        )\n\n    return frames, red_components\n\n\ndef _blue_cycle_edges(g: np.ndarray, red_components: list[np.ndarray]) -> set[tuple[int, int]]:\n    red_id = {}\n    for i, coords in enumerate(red_components):\n        for r, c in coords:\n            red_id[(int(r), int(c))] = i\n\n    edges = set()\n    for coords in components_mask(g == BLUE, connectivity=4):\n        touched = set()\n        for r, c in coords:\n            rr = int(r)\n            cc = int(c)\n            for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):\n                frame_id = red_id.get((nr, nc))\n                if frame_id is not None:\n                    touched.add(frame_id)\n        assert len(touched) == 2\n        a, b = touched\n        edges.add(tuple(sorted((a, b))))\n\n    n = len(red_components)\n    assert len(edges) == n\n    for i in range(n):\n        assert sum(i in edge for edge in edges) == 2\n    return edges\n\n\ndef _clockwise_order(frames: list[dict], edges: set[tuple[int, int]]) -> list[int]:\n    mean_r = sum(frame[\"center\"][0] for frame in frames) / len(frames)\n    mean_c = sum(frame[\"center\"][1] for frame in frames) / len(frames)\n    angles = [\n        math.atan2(frame[\"center\"][0] - mean_r, frame[\"center\"][1] - mean_c)\n        for frame in frames\n    ]\n    assert len({round(angle, 12) for angle in angles}) == len(angles)\n\n    order = sorted(range(len(frames)), key=lambda i: angles[i])\n    for a, b in zip(order, order[1:] + order[:1]):\n        assert tuple(sorted((a, b))) in edges\n    return order\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor each framed interior mask with the color from the next red frame clockwise around the blue connector cycle.\n\n    Input structure\n    - The grid contains hollow red square frames connected pairwise by blue line components.\n    - The blue components connect the frames into one cycle, with every frame touching exactly two blue components.\n    - Each frame interior contains background plus exactly one non-background color mask.\n\n    Rule\n    - Sort the red frames clockwise by their centers around the cycle.\n    - Keep each frame's interior mask shape in place, but recolor it with the interior color from the next clockwise frame.\n    - Leave the red frames, blue connectors, background, and interior background holes unchanged.\n\n    Key insight\n    - The colored masks do not move; the blue cycle gives the order in which their colors rotate.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    frames, red_components = _extract_frames(g, bg)\n    edges = _blue_cycle_edges(g, red_components)\n    order = _clockwise_order(frames, edges)\n\n    out = g.copy()\n    for k, frame_id in enumerate(order):\n        next_id = order[(k + 1) % len(order)]\n        r0, c0, r1, c1 = frames[frame_id][\"bbox\"]\n        interior = out[r0 + 1 : r1, c0 + 1 : c1]\n        interior[frames[frame_id][\"mask\"]] = frames[next_id][\"color\"]\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Palette constants.\nBG = 0\nCONNECTOR_BLUE = 1\nFRAME_RED = 2\nINTERIOR_COLORS = [3, 4, 5, 6, 7, 8, 9]\n\n# Canvas and frame bounds.\nFRAME_COUNT_RANGE = (3, 5)\nFRAME_SIZE_CHOICES = [5, 7]\nSMALL_FRAME_GRID_H_RANGE = (20, 27)\nSMALL_FRAME_GRID_W_RANGE = (21, 27)\nLARGE_FRAME_GRID_H_RANGE = (22, 27)\nLARGE_FRAME_GRID_W_RANGE = (23, 27)\nFRAME_GAP = 1\n\n# Interior mask density.\nMIN_INTERIOR_FILL = 0.30\nMAX_INTERIOR_FILL = 0.56\nMIN_INTERIOR_CELLS = 3\n\n# Angular placement.\nANGLE_PERTURB_RANGE = (-0.3, 0.3)\nMIN_RADIUS_PAD = 1\nMAX_RADIUS_PAD = 1\nANGLE_EPS = 1e-6\n\n# Connector constraints and retry budgets.\nMAX_TWO_TURN_TRIES = 20\nCONNECTOR_LENGTH_RANGE = (2, 24)\nGENERATION_ATTEMPTS = 300\n\nNEIGHBORS_8 = [\n    (dr, dc)\n    for dr in range(-1, 2)\n    for dc in range(-1, 2)\n    if not (dr == 0 and dc == 0)\n]\n\n\ndef _gen_mask(interior_size, color):\n    \"\"\"Generate an 8-connected mask for frame interior with fill 30-56%.\"\"\"\n    n = interior_size\n    total = n * n\n    min_fill = max(MIN_INTERIOR_CELLS, int(math.ceil(MIN_INTERIOR_FILL * total)))\n    max_fill = int(math.floor(MAX_INTERIOR_FILL * total))\n    target = random.randint(min_fill, max_fill)\n\n    mask = np.zeros((n, n), dtype=int)\n    start = (n // 2, n // 2)\n    mask[start] = color\n    filled = [start]\n    frontier = set()\n    _add_mask_frontier(frontier, mask, start)\n\n    while len(filled) < target and frontier:\n        cell = random.choice(list(frontier))\n        frontier.discard(cell)\n        mask[cell] = color\n        filled.append(cell)\n        _add_mask_frontier(frontier, mask, cell)\n\n    if len(filled) < min_fill:\n        return None\n    return mask\n\n\ndef _add_mask_frontier(frontier, mask, cell):\n    n = mask.shape[0]\n    for dr, dc in NEIGHBORS_8:\n        nr, nc = cell[0] + dr, cell[1] + dc\n        if 0 <= nr < n and 0 <= nc < n and mask[nr, nc] == 0:\n            frontier.add((nr, nc))\n\n\ndef _axis_path(start, end):\n    \"\"\"Return an inclusive straight segment between row- or column-aligned cells.\"\"\"\n    sr, sc = start\n    er, ec = end\n    if sr == er:\n        step = 1 if ec > sc else -1\n        return [(sr, c) for c in range(sc, ec + step, step)]\n    step = 1 if er > sr else -1\n    return [(r, sc) for r in range(sr, er + step, step)]\n\n\ndef _one_turn_path(start, corner, end):\n    return _axis_path(start, corner) + _axis_path(corner, end)[1:]\n\n\ndef _two_turn_vhv_path(start, mid_r, end):\n    _, sc = start\n    _, ec = end\n    corner1 = (mid_r, sc)\n    corner2 = (mid_r, ec)\n    return (\n        _axis_path(start, corner1)\n        + _axis_path(corner1, corner2)[1:]\n        + _axis_path(corner2, end)[1:]\n    )\n\n\ndef _two_turn_hvh_path(start, mid_c, end):\n    sr, _ = start\n    er, _ = end\n    corner1 = (sr, mid_c)\n    corner2 = (er, mid_c)\n    return (\n        _axis_path(start, corner1)\n        + _axis_path(corner1, corner2)[1:]\n        + _axis_path(corner2, end)[1:]\n    )\n\n\n","exit_code":0,"status":"completed"}}
