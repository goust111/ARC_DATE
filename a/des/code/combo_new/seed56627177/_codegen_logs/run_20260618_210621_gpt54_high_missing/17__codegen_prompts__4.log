{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/fc10701f.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox, get_bg\nimport random\n\n\ndef _solid_rect_bbox(g: np.ndarray, color: int) -> tuple[int, int, int, int]:\n    box = bbox(g == color)\n    assert box is not None, \"expected color to appear\"\n    r0, c0, r1, c1 = box\n    area = (r1 - r0 + 1) * (c1 - c0 + 1)\n    assert int(np.count_nonzero(g == color)) == area, \"colored object must be a solid rectangle\"\n    assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color), \"colored object bbox must be solid\"\n    return box\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the orange rectangle onto the maroon rectangle and mark gated corridor crossings in red.\n\n    Input structure\n    - The dominant background contains black obstacle segments.\n    - There is one solid orange rectangle and one solid maroon rectangle of the same size.\n    - The two rectangles share either their row span or their column span, so the move is straight and axis-aligned.\n\n    Rule\n    - Erase the original orange rectangle to the background.\n    - Replace the maroon rectangle with the orange rectangle.\n    - Between the two rectangles, paint red across the moving rectangle's width or height only at corridor cells flanked by black obstacle segments perpendicular to the movement.\n\n    Key insight\n    - The black segments define gates in the straight corridor; only those gated openings, not every swept background cell, become red.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    source = _solid_rect_bbox(g, Color.ORANGE)\n    target = _solid_rect_bbox(g, Color.MAROON)\n    sr0, sc0, sr1, sc1 = source\n    tr0, tc0, tr1, tc1 = target\n\n    assert (sr1 - sr0, sc1 - sc0) == (tr1 - tr0, tc1 - tc0), \"rectangles must have the same size\"\n    same_cols = (sc0, sc1) == (tc0, tc1)\n    same_rows = (sr0, sr1) == (tr0, tr1)\n    assert same_cols != same_rows, \"rectangles must align on exactly one axis\"\n\n    out = g.copy()\n    out[g == Color.ORANGE] = bg\n    out[tr0 : tr1 + 1, tc0 : tc1 + 1] = Color.ORANGE\n\n    H, W = g.shape\n    if same_cols:\n        c0, c1 = sc0, sc1\n        rows = range(tr1 + 1, sr0) if sr0 > tr0 else range(sr1 + 1, tr0)\n        for r in rows:\n            gated = (\n                c0 > 0\n                and c1 + 1 < W\n                and g[r, c0 - 1] == Color.BLACK\n                and g[r, c1 + 1] == Color.BLACK\n            )\n            if gated:\n                assert np.all(g[r, c0 : c1 + 1] == bg), \"gated opening must be background before painting\"\n                out[r, c0 : c1 + 1] = Color.RED\n    else:\n        r0, r1 = sr0, sr1\n        cols = range(tc1 + 1, sc0) if sc0 > tc0 else range(sc1 + 1, tc0)\n        for c in cols:\n            gated = (\n                r0 > 0\n                and r1 + 1 < H\n                and g[r0 - 1, c] == Color.BLACK\n                and g[r1 + 1, c] == Color.BLACK\n            )\n            if gated:\n                assert np.all(g[r0 : r1 + 1, c] == bg), \"gated opening must be background before painting\"\n                out[r0 : r1 + 1, c] = Color.RED\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and object geometry.\nGRID_SIZE_MIN, GRID_SIZE_MAX = 8, 26\nRECT_SIDE_MIN, RECT_SIDE_MAX = 1, 4\nRECT_CANVAS_MARGIN = 4\nGAP_MIN, GAP_MAX = 5, 7\nCROSS_AXIS_PADDING = 2\n\n# Gate count, spacing, and wall thickness.\nBETWEEN_GATE_COUNTS = (2, 3)\nGATE_TOTAL_MIN, GATE_TOTAL_MAX = 2, 8\nGATE_SPACING_MIN, GATE_SPACING_MAX = 2, 4\nGATE_SEGMENT_LEN = 2\n\n# Palette and retry controls.\nBACKGROUND_COLOR = Color.PINK\nGATE_COLOR = Color.BLACK\nRED_COLOR = Color.RED\nSOURCE_COLOR = Color.ORANGE\nTARGET_COLOR = Color.MAROON\nBINARY_CHOICES = [False, True]\nGENERATION_ATTEMPTS = 300\n\n\ndef _gen_extensions(anchor: int, limit: int, count: int, sign: int) -> list[list[int]]:\n    if count == 0:\n        return [[]]\n    out: list[list[int]] = []\n    for step in range(GATE_SPACING_MIN, GATE_SPACING_MAX + 1):\n        pos = anchor + sign * step\n        if not (0 <= pos <= limit):\n            continue\n        for tail in _gen_extensions(pos, limit, count - 1, sign):\n            out.append(([pos] + tail) if sign > 0 else (tail + [pos]))\n    return out\n\n\ndef _gen_between_positions(gap_cells: list[int], count: int) -> list[tuple[int, ...]]:\n    \"\"\"Enumerate in-gap gate positions with valid spacing, preserving nested-loop order.\"\"\"\n    out: list[tuple[int, ...]] = []\n    if count == 2:\n        for a in gap_cells:\n            for b in gap_cells:\n                if GATE_SPACING_MIN <= b - a <= GATE_SPACING_MAX:\n                    out.append((a, b))\n    else:\n        for a in gap_cells:\n            for b in gap_cells:\n                for c in gap_cells:\n                    if (\n                        GATE_SPACING_MIN <= b - a <= GATE_SPACING_MAX\n                        and GATE_SPACING_MIN <= c - b <= GATE_SPACING_MAX\n                    ):\n                        out.append((a, b, c))\n    return out\n\n\ndef _gen_gate_positions(size: int, gap_cells: list[int]) -> tuple[list[int], list[int]] | None:\n    choices: list[tuple[list[int], list[int]]] = []\n    for between_count in BETWEEN_GATE_COUNTS:\n        for between in _gen_between_positions(gap_cells, between_count):\n            remaining = GATE_TOTAL_MAX - between_count\n            max_left = min(remaining, (between[0] + 1) // GATE_SPACING_MIN)\n            max_right = min(remaining, (size - between[-1]) // GATE_SPACING_MIN)\n            for left_count in range(max_left + 1):\n                for right_count in range(max_right + 1):\n                    total = between_count + left_count + right_count\n                    if not (GATE_TOTAL_MIN <= total <= GATE_TOTAL_MAX):\n                        continue\n                    for left in _gen_extensions(between[0], size - 1, left_count, -1):\n                        for right in _gen_extensions(between[-1], size - 1, right_count, 1):\n                            choices.append((left + list(between) + right, list(between)))\n    if not choices:\n        return None\n    return random.choice(choices)\n\n\ndef _sample_axis_layout(size: int, rect_side: int, gap: int) -> tuple[int, int, int, int, list[int]]:\n    \"\"\"Sample aligned source/target spans and return the corridor cells between them.\"\"\"\n    source_first = random.choice(BINARY_CHOICES)\n    span0 = random.randint(0, size - (2 * rect_side + gap))\n    first0, second0 = span0, span0 + rect_side + gap\n    src_axis0, dst_axis0 = (first0, second0) if source_first else (second0, first0)\n    gap_cells = list(range(span0 + rect_side, span0 + rect_side + gap))\n    return src_axis0, src_axis0 + rect_side - 1, dst_axis0, dst_axis0 + rect_side - 1, gap_cells\n\n\ndef _paint_rect(grid: np.ndarray, horizontal: bool, axis0: int, axis1: int, cross0: int, cross1: int, color: int) -> None:\n    if horizontal:\n        grid[cross0 : cross1 + 1, axis0 : axis1 + 1] = color\n    else:\n        grid[axis0 : axis1 + 1, cross0 : cross1 + 1] = color\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    size = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    rect_side = random.randint(RECT_SIDE_MIN, min(RECT_SIDE_MAX, size - RECT_CANVAS_MARGIN))\n    gap = random.randint(GAP_MIN, GAP_MAX)\n    if 2 * rect_side + gap > size:\n        return None\n\n    horizontal = random.choice(BINARY_CHOICES)\n    src_axis0, src_axis1, dst_axis0, dst_axis1, gap_cells = _sample_axis_layout(size, rect_side, gap)\n    gate_choice = _gen_gate_positions(size, gap_cells)\n    if gate_choice is None:\n        return None\n    gate_positions, red_positions = gate_choice\n\n    cross0 = random.randint(CROSS_AXIS_PADDING, size - rect_side - CROSS_AXIS_PADDING)\n    cross1 = cross0 + rect_side - 1\n    output = np.full((size, size), BACKGROUND_COLOR, dtype=int)\n\n    for pos in gate_positions:\n        if horizontal:\n            output[cross0 - GATE_SEGMENT_LEN : cross0, pos] = GATE_COLOR\n            output[cross1 + 1 : cross1 + 1 + GATE_SEGMENT_LEN, pos] = GATE_COLOR\n        else:\n            output[pos, cross0 - GATE_SEGMENT_LEN : cross0] = GATE_COLOR\n            output[pos, cross1 + 1 : cross1 + 1 + GATE_SEGMENT_LEN] = GATE_COLOR\n    _paint_rect(output, horizontal, dst_axis0, dst_axis1, cross0, cross1, SOURCE_COLOR)\n    for pos in red_positions:\n        if horizontal:\n            output[cross0 : cross1 + 1, pos] = RED_COLOR\n        else:\n            output[pos, cross0 : cross1 + 1] = RED_COLOR\n\n    inp = output.copy()\n    inp[inp == RED_COLOR] = BACKGROUND_COLOR\n    _paint_rect(inp, horizontal, dst_axis0, dst_axis1, cross0, cross1, TARGET_COLOR)\n    _paint_rect(inp, horizontal, src_axis0, src_axis1, cross0, cross1, SOURCE_COLOR)\n\n    if np.array_equal(main(inp), output):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid fc10701f input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/7666fa5d.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/7666fa5d.py\"","aggregated_output":"import numpy as np\nimport random\n\nfrom arc_utils import components_mask, get_bg as _bg_color\n\n\ndef _cc8(mask: np.ndarray) -> list[list[tuple[int, int]]]:\n    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(mask, connectivity=8)]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the parallelogram-shaped region between parallel anti-diagonal line segments with red.\n\n    Input structure:\n    - bg = most common color.\n    - One non-bg color forms short diagonal segments, each lying on a single anti-diagonal (r+c = const).\n    - Segments come in parallel pairs bounding a region to be filled.\n\n    Rule:\n    - For each main-diagonal axis (r−c = const), collect anti-diagonal segments whose span covers that axis.\n    - Sort those segments by their anti-diagonal index (r+c).\n    - Fill all bg cells lying strictly between consecutive segment pairs along that axis with red (color 2).\n\n    Key insight: The two diagonal directions decouple — segments sit on anti-diagonals, and filling sweeps along main diagonals between them, forming parallelogram regions.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    bg = _bg_color(g)\n    non_bg = [c for c in sorted(set(map(int, g.ravel()))) if c != bg]\n    assert non_bg, \"grid must contain at least one non-background color\"\n\n    # This task uses one diagonal-line color and fills with 2.\n    line = max(non_bg, key=lambda c: int(np.sum(g == c)))\n    fill = 2\n\n    comps = _cc8(g == line)\n\n    # Each diagonal segment is on a constant anti-diagonal sum k=r+c,\n    # and spans a continuous range of main-diagonal indices b=r-c.\n    segs: list[tuple[int, int, int]] = []\n    for pts in comps:\n        ks = {r + c for r, c in pts}\n        if len(ks) != 1:\n            continue\n        k = int(next(iter(ks)))\n        bs = [r - c for r, c in pts]\n        segs.append((k, int(min(bs)), int(max(bs))))\n\n    out = g.copy()\n\n    # Scan each main diagonal b=r-c. For every b, find the active diagonal segments\n    # (those whose b-range covers b), sort them by k=r+c, then fill between adjacent\n    # segments for cells on this b with k strictly between.\n    for b in range(-(w - 1), h):\n        active = [s for s in segs if s[1] <= b <= s[2]]\n        if len(active) < 2:\n            continue\n        active.sort(key=lambda t: t[0])\n        ks = [t[0] for t in active]\n\n        r_min = max(0, b)\n        r_max = min(h - 1, (w - 1) + b)\n        for k_left, k_right in zip(ks, ks[1:]):\n            for r in range(r_min, r_max + 1):\n                c = r - b\n                k = r + c\n                if k_left < k < k_right and out[r, c] == bg:\n                    out[r, c] = fill\n\n    return out\n\n# --------------- generator (Claude attempt 1) ---------------\n\n\"\"\"Generator for ARC-AGI-2 task 7666fa5d (parallelogram fill between anti-diagonal segments).\"\"\"\n\n# -- Grid & color constants --\nH = W = 16\nBG = 8\nFILL = 2\nLINE_COLORS = [1, 3, 4, 5, 6, 7, 9]  # not 2 (fill), not 8 (bg)\n\n# -- Anti-diagonal (k = r+c) layout --\nK_LO, K_HI = 4, 26                    # allowed k range\nGAP_VALUES = (4, 6, 8)                 # even gaps between consecutive k-values\nGAP_TARGET_SPANS = (14, 16)            # valid total k-span for 4-k layouts\nNUM_KS_CHOICES = [4, 5]                # number of anti-diagonals to use\nNUM_KS_WEIGHTS = [1, 1]                # sampling weights for num_ks\n\n# -- Segment geometry --\nSEG_LEN_MIN, SEG_LEN_MAX = 2, 9       # segment length in cells\nOVERLAP_MIN_B = 2                      # min b-overlap between consecutive segments\n\n# -- Segment splitting --\nSPLIT_PROB = 0.4                       # probability of splitting one segment\nSPLIT_MIN_LEN = 4                      # min segment length (cells) to be splittable\nSPLIT_B_GAP = 4                        # min b-gap to break 8-connectivity\nSPLIT_PIECE2_LEN_MIN = 2              # second piece length range\nSPLIT_PIECE2_LEN_MAX = 6\n\n# -- Retry budgets --\nSEG_RETRY = 40                         # retries per segment placement\nSPLIT_RETRY = 10                       # retries for segment splitting\nGEN_RETRY = 300                        # outer generate_input retries\n\n# -- Validation --\nMIN_FILL_CELLS = 3                     # min fill cells in output\n\n\ndef _b_bounds_for_k(k: int) -> tuple[int, int]:\n    \"\"\"Inclusive b-range such that (r,c)=((k+b)/2,(k-b)/2) lies within the grid.\"\"\"\n    # r = (k+b)/2 in [0, H-1]  =>  b in [-k, 2(H-1)-k]\n    # c = (k-b)/2 in [0, W-1]  =>  b in [k-2(W-1), k]\n    b_lo = max(-k, k - 2 * (W - 1))\n    b_hi = min(2 * (H - 1) - k, k)\n    return b_lo, b_hi\n\n\ndef _seg_cells(k: int, b_min: int, b_max: int) -> list[tuple[int, int]]:\n    \"\"\"Return (r,c) cells for a segment on anti-diagonal k spanning b_min..b_max (step 2).\"\"\"\n    cells = []\n    for b in range(b_min, b_max + 1, 2):\n        cells.append(((k + b) // 2, (k - b) // 2))\n    return cells\n\n\ndef _apply_fill(grid: np.ndarray, segs: list[tuple[int, int, int]]) -> np.ndarray:\n    \"\"\"Apply the solver's fill logic: fill bg cells between consecutive active segments per b-line.\"\"\"\n    out = grid.copy()\n    for b in range(-(W - 1), H):\n        active = sorted([s for s in segs if s[1] <= b <= s[2]], key=lambda t: t[0])\n        if len(active) < 2:\n            continue\n        ks = [t[0] for t in active]\n        r_min, r_max = max(0, b), min(H - 1, (W - 1) + b)\n        for k_left, k_right in zip(ks, ks[1:]):\n            for r in range(r_min, r_max + 1):\n                c = r - b\n                k = r + c\n                if k_left < k < k_right and out[r, c] == BG:\n                    out[r, c] = FILL\n    return out\n\n\ndef _choose_k_values(parity: int) -> list[int] | None:\n    \"\"\"Pick 4-5 evenly-spaced anti-diagonal indices with the given parity.\"\"\"\n    num_ks = random.choices(NUM_KS_CHOICES, weights=NUM_KS_WEIGHTS)[0]\n    if num_ks == 4:\n        # 3 gaps from GAP_VALUES with total span in GAP_TARGET_SPANS\n        valid_combos = [(a, b, c) for a in GAP_VALUES for b in GAP_VALUES for c in GAP_VALUES\n                        if a + b + c in GAP_TARGET_SPANS]\n        gaps = list(random.choice(valid_combos))\n    else:\n        # 5 ks: 4 gaps summing to 16 => only 4+4+4+4=16\n        gaps = [4, 4, 4, 4]\n\n    total_span = sum(gaps)\n    k0_candidates = [k for k in range(K_LO, K_HI - total_span + 1) if k % 2 == parity]\n    if not k0_candidates:\n        return None\n    k0 = random.choice(k0_candidates)\n    ks = [k0]\n    for g in gaps:\n        ks.append(ks[-1] + g)\n    if ks[-1] > K_HI or len(set(ks)) != len(ks):\n        return None\n    return ks\n\n\ndef _random_seg(k: int, constrain_lo: int | None = None,\n                constrain_hi: int | None = None) -> tuple[int, int] | None:\n    \"\"\"Pick a random segment b-range on anti-diagonal k.\n\n    If constrain_lo/hi are given, the new segment must overlap\n    [constrain_lo, constrain_hi] by at least OVERLAP_MIN_B in b-space.\n    \"\"\"\n    b_lo, b_hi = _b_bounds_for_k(k)\n    # Align bounds to k-parity (b must have same parity as k)\n    if b_lo % 2 != k % 2:\n        b_lo += 1\n    if b_hi % 2 != k % 2:\n        b_hi -= 1\n    if b_lo > b_hi:\n        return None\n\n    for _ in range(SEG_RETRY):\n        length = random.randint(SEG_LEN_MIN, SEG_LEN_MAX)\n        step = 2 * (length - 1)\n        if b_lo + step > b_hi:\n            continue\n        candidates = list(range(b_lo, b_hi - step + 1, 2))\n        if constrain_lo is not None and constrain_hi is not None:\n            # b_max >= constrain_lo + OVERLAP_MIN_B AND b_min <= constrain_hi - OVERLAP_MIN_B\n            candidates = [bm for bm in candidates\n                          if bm + step >= constrain_lo + OVERLAP_MIN_B\n                          and bm <= constrain_hi - OVERLAP_MIN_B]\n            if not candidates:\n                continue\n        b_min = random.choice(candidates)\n        return b_min, b_min + step\n    return None\n\n\ndef _try_split_segment(segs: list[tuple[int, int, int]], idx: int) -> None:\n    \"\"\"Try to split segs[idx] into two 8-disconnected pieces on the same k (in-place).\"\"\"\n    k, bmin, bmax = segs[idx]\n    length = (bmax - bmin) // 2 + 1\n    if length < SPLIT_MIN_LEN:\n        return\n\n    _, b_hi = _b_bounds_for_k(k)\n    for _ in range(SPLIT_RETRY):\n        L1 = random.randint(2, length - 2)\n        piece1_max = bmin + 2 * (L1 - 1)\n        # Second piece starts beyond the 8-connectivity gap\n        p2_candidates = [b for b in range(piece1_max + SPLIT_B_GAP, b_hi - 1, 2)\n                         if b % 2 == k % 2]\n        if not p2_candidates:\n            continue\n        p2_min = random.choice(p2_candidates)\n        L2 = random.randint(SPLIT_PIECE2_LEN_MIN, SPLIT_PIECE2_LEN_MAX)\n        p2_max = p2_min + 2 * (L2 - 1)\n        if p2_max > b_hi:\n            continue\n        segs[idx] = (k, bmin, piece1_max)\n        segs.append((k, p2_min, p2_max))\n        return\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n    line = random.choice(LINE_COLORS)\n    parity = random.randint(0, 1)\n\n    ks = _choose_k_values(parity)\n    if ks is None:\n        return None\n\n    # Build segments with consecutive-overlap constraint\n    segs: list[tuple[int, int, int]] = []\n    first = _random_seg(ks[0])\n    if first is None:\n        return None\n    segs.append((ks[0], first[0], first[1]))\n\n    for k in ks[1:]:\n        prev_bmin, prev_bmax = segs[-1][1], segs[-1][2]\n        res = _random_seg(k, prev_bmin, prev_bmax)\n        if res is None:\n            return None\n        segs.append((k, res[0], res[1]))\n\n    # Optionally split one segment into two non-overlapping pieces on the same k\n    if len(segs) <= 5 and random.random() < SPLIT_PROB:\n        _try_split_segment(segs, random.randrange(len(segs)))\n\n    # Place line cells on grid\n    grid = np.full((H, W), BG, dtype=int)\n    for k, bmin, bmax in segs:\n","exit_code":0,"status":"completed"}}
