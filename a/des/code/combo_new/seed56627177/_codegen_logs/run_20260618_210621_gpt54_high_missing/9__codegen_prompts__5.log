{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nfrom collections import Counter\n\nrng = np.random.default_rng(0)\n\ndef make_horizontal(rng):\n    for _ in range(1000):\n        w = int(rng.integers(3, 8))\n        depths = rng.integers(0, 4, size=w)\n        if depths.max() == 0:\n            continue\n        if np.array_equal(depths, depths[::-1]):\n            continue\n        m = int(depths.max())\n        mask = np.zeros((2*m+1, w), dtype=bool)\n        center = m\n        for c, d in enumerate(depths):\n            mask[center-d:center+d+1, c] = True\n        if np.array_equal(mask, mask[:, ::-1]):\n            continue\n        if not np.array_equal(mask, mask[::-1, :]):\n            continue\n        return mask, depths.tolist()\n    raise RuntimeError\n\nfor _ in range(5):\n    mask, depths = make_horizontal(rng)\n    print(depths, mask.shape)\n    print(mask.astype(int))\n    print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
