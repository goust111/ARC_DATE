{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nfrom collections import Counter, deque\n\nrng = np.random.default_rng(1)\n\nDIRS4 = [(-1,0),(1,0),(0,-1),(0,1)]\n\ndef dilate4(shape, cells):\n    H,W=shape\n    m=np.zeros(shape,dtype=bool)\n    for r,c in cells:\n        if 0<=r<H and 0<=c<W:\n            m[r,c]=True\n        for dr,dc in DIRS4:\n            rr,cc=r+dr,c+dc\n            if 0<=rr<H and 0<=cc<W:\n                m[rr,cc]=True\n    return m\n\ndef make_horizontal(rng):\n    for _ in range(200):\n        w = int(rng.integers(3, 8))\n        depths = rng.integers(0, 4, size=w)\n        if depths.max() == 0:\n            continue\n        if np.array_equal(depths, depths[::-1]):\n            continue\n        m = int(depths.max())\n        mask = np.zeros((2*m+1, w), dtype=bool)\n        center = m\n        for c, d in enumerate(depths):\n            mask[center-d:center+d+1, c] = True\n        if np.array_equal(mask, mask[:, ::-1]):\n            continue\n        return mask\n    raise RuntimeError\n\ndef make_vertical(rng):\n    for _ in range(200):\n        h = int(rng.integers(3, 8))\n        widths = rng.integers(0, 4, size=h)\n        if widths.max() == 0:\n            continue\n        if np.array_equal(widths, widths[::-1]):\n            continue\n        m = int(widths.max())\n        mask = np.zeros((h, 2*m+1), dtype=bool)\n        center = m\n        for r, d in enumerate(widths):\n            mask[r, center-d:center+d+1] = True\n        if np.array_equal(mask, mask[::-1, :]):\n            continue\n        return mask\n    raise RuntimeError\n\ndef ray_cells(orientation, mask_shape, r0,c0,H,W,direction):\n    h,w=mask_shape\n    r1,c1=r0+h-1,c0+w-1\n    if orientation=='horizontal':\n        rr=(r0+r1)//2\n        if direction=='left':\n            return [(rr,c0-k) for k in range(w)]\n        return [(rr,c1+k) for k in range(w)]\n    cc=(c0+c1)//2\n    if direction=='up':\n        return [(r0-k,cc) for k in range(h)]\n    return [(r1+k,cc) for k in range(h)]\n\ndef choose_orientation_list(n):\n    n_h=n//2\n    if n%2:\n        n_h += int(rng.integers(0,2))\n    arr=['horizontal']*n_h+['vertical']*(n-n_h)\n    rng.shuffle(arr)\n    return arr\n\n\ndef gen():\n    H=int(rng.integers(15,27)); W=int(rng.integers(15,27))\n    bg=int(rng.integers(0,10))\n    grid=np.full((H,W),bg,dtype=int)\n    n=int(rng.choice([2,3,4], p=[0.35,0.4,0.25]))\n    colors=[c for c in range(10) if c\"'!=bg]\n    rng.shuffle(colors)\n    orientations=choose_orientation_list(n)\n    reserved=[]\n    blocked=np.zeros((H,W),dtype=bool)\n    placements=[]\n    for i,ori in enumerate(orientations):\n        ok=False\n        for _ in range(500):\n            mask = make_horizontal(rng) if ori=='\"'horizontal' else make_vertical(rng)\n            h,w=mask.shape\n            if ori=='horizontal':\n                max_margin=(W-w-1)//2\n                if max_margin < w-1 or H-h < 2:\n                    continue\n                direction='left' if int(rng.integers(0,2))==0 else 'right'\n                m=int(rng.integers(w-1, max_margin+1))\n                c0 = m if direction=='left' else W-w-m\n                r0 = int(rng.integers(1, H-h))\n            else:\n                max_margin=(H-h-1)//2\n                if max_margin < h-1 or W-w < 2:\n                    continue\n                direction='up' if int(rng.integers(0,2))==0 else 'down'\n                m=int(rng.integers(h-1, max_margin+1))\n                r0 = m if direction=='up' else H-h-m\n                c0 = int(rng.integers(1, W-w))\n            obj=[(r0+r,c0+c) for r,c in zip(*np.where(mask))]\n            ray=ray_cells(ori,mask.shape,r0,c0,H,W,direction)\n            allcells=set(obj)|set(ray)\n            if any(blocked[r,c] for r,c in allcells):\n                continue\n            # ensure ray inside\n            if any(not (0<=r<H and 0<=c<W) for r,c in ray):\n                continue\n            ok=True\n            placements.append((colors[i],obj,ray))\n            for r,c in obj:\n                grid[r,c]=colors[i]\n            new_block=np.zeros((H,W),dtype=bool)\n            for r,c in allcells:\n                new_block[r,c]=True\n                for dr,dc in DIRS4:\n                    rr,cc=r+dr,c+dc\n                    if 0<=rr<H and 0<=cc<W:\n                        new_block[rr,cc]=True\n            blocked |= new_block\n            break\n        if not ok:\n            return None\n    return grid,placements\n\ncount=0\nfor i in range(200):\n    x=gen()\n    if x is not None:\n        count+=1\nprint('success',count)\n\nsample=gen()\nprint(sample[0].shape if sample else None)\nprint(sample[0] if sample else None)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
