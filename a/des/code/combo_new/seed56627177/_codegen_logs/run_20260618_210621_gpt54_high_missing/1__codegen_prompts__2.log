{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np\n\nDIRS=[(1,1),(1,-1),(-1,1),(-1,-1)]\n\ndef inter(a,b):\n    r0=max(a[0],b[0]); c0=max(a[1],b[1]); r1=min(a[2],b[2]); c1=min(a[3],b[3])\n    return None if r0>r1 or c0>c1 else (r0,c0,r1,c1)\n\ndef bbox(mask):\n    pts=np.argwhere(mask)\n    if len(pts)==0: return None\n    r0,c0=pts.min(axis=0); r1,c1=pts.max(axis=0)\n    return int(r0),int(c0),int(r1),int(c1)\n\ndef order_from(g):\n    colors=[int(c) for c in np.unique(g) if int(c)\"'!=0]\n    boxes={c:bbox(g==c) for c in colors}\n    above={c:set() for c in colors}\n    indeg={c:0 for c in colors}\n    for i,a in enumerate(colors):\n        for b in colors[i+1:]:\n            ov=inter(boxes[a],boxes[b])\n            if ov is None: continue\n            r0,c0,r1,c1=ov\n            sub=g[r0:r1+1,c0:c1+1]\n            av=bool((sub==a).any())\n            bv=bool((sub==b).any())\n            if av and bv:\n                return None, '\"'both', (a,b,ov)\n            if av:\n                lo,hi=b,a\n            elif bv:\n                lo,hi=a,b\n            else:\n                continue\n            if hi not in above[lo]:\n                above[lo].add(hi); indeg[hi]+=1\n    out=[]; rem=set(colors)\n    while rem:\n        ready=[c for c in rem if indeg[c]==0]\n        if len(ready)\"'!=1:\n            return None, '\"'amb', ready\n        c=ready[0]; rem.remove(c); out.append(c)\n        for d in above[c]: indeg[d]-=1\n    return out, '', None\n\ndef gen():\n    n=random.randint(2,7)\n    colors=random.sample(range(1,10), n)\n    sr,sc=random.choice(DIRS)\n    rects=[]\n    h=random.randint(4,8); w=random.randint(4,8)\n    rects.append((0,0,h-1,w-1))\n    for _ in range(1,n):\n        ph=rects[-1][2]-rects[-1][0]+1\n        pw=rects[-1][3]-rects[-1][1]+1\n        h=random.randint(4,8); w=random.randint(4,8)\n        max_sr=min(3, min(ph,h)-2)\n        max_sc=min(3, min(pw,w)-2)\n        if max_sr<1 or max_sc<1:\n            return None\n        dr=random.randint(1,max_sr); dc=random.randint(1,max_sc)\n        nr0=rects[-1][0]+sr*dr; nc0=rects[-1][1]+sc*dc\n        rects.append((nr0,nc0,nr0+h-1,nc0+w-1))\n    minr=min(r0 for r0,_,_,_ in rects); maxr=max(r1 for _,_,r1,_ in rects)\n    minc=min(c0 for _,c0,_,_ in rects); maxc=max(c1 for _,_,_,c1 in rects)\n    spanh=maxr-minr+1; spanw=maxc-minc+1\n    if spanh>28 or spanw>28:\n        return None\n    top=random.randint(1, 30-spanh-1) if 30-spanh>=2 else 0\n    bottom=random.randint(1, 30-spanh-top) if 30-spanh-top>=1 else 0\n    left=random.randint(1, 30-spanw-1) if 30-spanw>=2 else 0\n    right=random.randint(1, 30-spanw-left) if 30-spanw-left>=1 else 0\n    H=spanh+top+bottom; W=spanw+left+right\n    g=np.zeros((H,W),dtype=int)\n    shift_r=top-minr; shift_c=left-minc\n    for col,(r0,c0,r1,c1) in zip(colors, rects):\n        g[r0+shift_r:r1+shift_r+1, c0+shift_c:c1+shift_c+1]=col\n    return g, colors, rects, (shift_r,shift_c)\n\nfor t in range(1000):\n    x=gen()\n    if x is None:\n        continue\n    g, colors, rects, sh=x\n    ord_, why, extra=order_from(g)\n    if ord_\"'!=colors:\n        print('\"'mismatch', t, colors, ord_, why, extra)\n        # show bboxes\n        boxes={c:bbox(g==c) for c in colors}\n        print(boxes)\n        break\n    # bbox check\n    for col, rect in zip(colors, rects):\n        rr=(rect[0]+sh[0], rect[1]+sh[1], rect[2]+sh[0], rect[3]+sh[1])\n        if bbox(g==col)\"'!=rr:\n            print('\"'bbox mismatch', colors, col, rr, bbox(g==col), rects, sh)\n            raise SystemExit\nelse:\n    print('ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
