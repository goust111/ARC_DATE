+def _touches_mask(coords: np.ndarray, occupied: np.ndarray) -> bool:
+    h, w = occupied.shape
+    for r, c in coords:
+        r = int(r)
+        c = int(c)
+        if occupied[r, c]:
+            return True
+        for dr, dc in DIR4:
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w and occupied[rr, cc]:
+                return True
+    return False
