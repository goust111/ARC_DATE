+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+MAROON = 9
+
+FRAGMENT_COLORS = (GREEN, YELLOW, MAGENTA, CYAN, MAROON)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+GRID_MIN = 17
+GRID_MAX = 29
+GEN_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 300
+MARKER_ATTEMPTS = 160
