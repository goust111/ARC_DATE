+        frontier: set[tuple[int, int]] = set()
+        for r, c in cells:
+            for dr, dc in DIR4:
+                nxt = (r + dr, c + dc)
+                if nxt not in cells:
+                    frontier.add(nxt)
+        cells.add(random.choice(tuple(frontier)))
