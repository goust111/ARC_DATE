+    seen = np.zeros((h, w), dtype=bool)
+    fragments: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color in (BLACK, GREY, ORANGE) or seen[r, c]:
+                continue
+
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(g[nr, nc]) != color:
