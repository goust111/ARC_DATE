+    out = g.copy()
+    inner_out = out[r0 + 1 : r1, c0 + 1 : c1]
+    inner_out[pattern_mask] = bg
+    out[r0 + 1 + marker[0], c0 + 1 + marker[1]] = bg
+    out[r0 + 1 + mirrored[:, 0], c0 + 1 + mirrored[:, 1]] = marker_color
