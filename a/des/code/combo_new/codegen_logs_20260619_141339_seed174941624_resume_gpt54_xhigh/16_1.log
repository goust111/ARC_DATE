+    if int(vals[0]) != color or int(vals[-1]) != color:
+        return None
+
+    interior = vals[1:-1]
+    miss = interior != color
+    if not miss.any():
+        return None
+    miss_idx = np.flatnonzero(miss)
+    if miss_idx.size < 2:
+        return None
+    if int(miss_idx[-1]) - int(miss_idx[0]) + 1 != int(miss_idx.size):
+        return None
+    if not np.all(interior[miss] == bg):
