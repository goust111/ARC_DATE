+    while len(cells) < area:
+        if not frontier:
+            return None
+        cell = random.choice(tuple(frontier))
+        frontier.remove(cell)
+        cells.add(cell)
+        for nbr in _neighbors4(cell[0], cell[1], height, width):
+            if nbr not in cells:
+                frontier.add(nbr)
