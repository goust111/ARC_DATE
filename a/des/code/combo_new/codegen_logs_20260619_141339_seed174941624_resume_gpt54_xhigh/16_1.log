+    inp[r1, c0 : c1 + 1] = frame_color
+    inp[r0 : r1 + 1, c0] = frame_color
+    inp[r0 : r1 + 1, c1] = frame_color
+
+    if gap_side in {"top", "bottom"}:
+        gap_len = random.randint(2, inner_w)
+        start = random.randint(0, inner_w - gap_len)
