+    candidates: list[tuple[int, int]] = []
+    for r in range(1, inner_h - 1):
+        for c in range(1, inner_w - 1):
+            if (r, c) in occupied:
+                continue
+            if any((nr, nc) in pattern for nr, nc in _neighbors4(r, c, inner_h, inner_w)):
