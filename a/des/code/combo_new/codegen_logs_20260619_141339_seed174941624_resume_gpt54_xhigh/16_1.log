+    for r, c in mirrored:
+        out[frame_top + 1 + r, frame_left + 1 + c] = marker_color
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    inner_h = random.randint(6, 14)
+    inner_w = random.randint(6, 14)
