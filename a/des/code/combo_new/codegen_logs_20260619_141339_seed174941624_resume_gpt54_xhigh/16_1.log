+    cols = [c for _, c in cells]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    shape = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in cells:
+        shape[r - r0, c - c0] = True
+    return shape
+
+
+def _axis_asymmetric(shape: np.ndarray, gap_side: str) -> bool:
