+def _mirrored_coords(coords: np.ndarray, shape: tuple[int, int], gap_side: str) -> np.ndarray:
+    mirrored = coords.copy()
+    if gap_side in {"top", "bottom"}:
+        mirrored[:, 0] = int(shape[0]) - 1 - mirrored[:, 0]
+    else:
+        mirrored[:, 1] = int(shape[1]) - 1 - mirrored[:, 1]
+    return mirrored
