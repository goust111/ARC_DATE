+def _place_pattern(inner_h: int, inner_w: int, gap_side: str) -> tuple[set[tuple[int, int]], set[tuple[int, int]]] | None:
+    max_ph = min(4, inner_h)
+    max_pw = min(4, inner_w)
+    dims = [
+        (ph, pw)
+        for ph in range(2, max_ph + 1)
+        for pw in range(2, max_pw + 1)
+        if ph * pw >= 3
+    ]
+    random.shuffle(dims)
