+
+    Key insight:
+    - The maroon bar encodes direction only; the real transformation is that interior background cavities disappear and reappear outside as solid copies in the shape's own color.
+    """
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bg = _border_bg(g)
