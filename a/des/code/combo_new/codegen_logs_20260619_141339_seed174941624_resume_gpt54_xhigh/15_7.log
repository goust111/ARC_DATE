+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+MARKER = 9
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+DIR_VECTORS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+SHAPE_COLORS = (1, 2, 3, 4, 5, 6, 7, 8)
+
+GEN_RETRIES = 400
+PLACE_RETRIES = 120
