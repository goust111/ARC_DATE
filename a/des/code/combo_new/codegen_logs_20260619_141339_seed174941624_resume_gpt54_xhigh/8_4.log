+    return int(cropped.shape[0]), int(cropped.shape[1]), cropped.tobytes()
+
+
+def _find_divider(grid: np.ndarray, bg: int) -> int:
+    h, w = grid.shape
+    candidates = []
+    for c in range(1, w - 1):
+        color = int(grid[0, c])
+        if color == bg:
