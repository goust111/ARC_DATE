                cmin, cmax = int(cs.min()), int(cs.max())
                patch = cell[rmin : rmax + 1, cmin : cmax + 1]
                mask = (patch == BLACK) | (patch == ORANGE)
                out_cell[rmin : rmax + 1, cmin : cmax + 1][mask] = BLUE
            else:
