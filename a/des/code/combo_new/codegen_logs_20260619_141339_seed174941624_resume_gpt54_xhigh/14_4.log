+    except Exception:
+        return None
+
+    if out.shape != grid.shape:
+        return None
+    if not np.any(out == RED):
+        return None
+    if not np.any(out == BLUE):
+        return None
+    if not np.any(out == GREEN):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
