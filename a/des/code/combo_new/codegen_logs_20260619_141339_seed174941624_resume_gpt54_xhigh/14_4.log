+def _make_region(h: int, w: int, branch: int) -> np.ndarray | None:
+    for _ in range(120):
+        cell = np.full((h, w), BLACK, dtype=int)
+        if not _place_obstacles(cell, branch):
+            continue
+        towers = _choose_towers(cell, branch)
+        if towers is None:
+            continue
