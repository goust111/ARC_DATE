+def _branch_sequence(n_regions: int) -> list[int]:
+    sequence: list[int] = []
+    base = [0, 1, 2, 3]
+    while len(sequence) < n_regions:
+        batch = base[:]
+        random.shuffle(batch)
+        sequence.extend(batch)
+    return sequence[:n_regions]
