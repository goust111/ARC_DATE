+    ordered = sorted(components, key=lambda pts: (_bbox(pts)[0], _bbox(pts)[1], int(g[pts[0][0], pts[0][1]])))
+
+    for pts in ordered:
+        assert _is_solid_rectangle(pts)
+        r0, c0, r1, c1 = _bbox(pts)
+        color = int(g[r0, c0])
+        quadrant = _quadrant_for_bbox((r0, c0, r1, c1), h, w)
+
