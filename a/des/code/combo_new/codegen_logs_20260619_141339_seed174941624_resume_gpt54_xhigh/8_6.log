+    mid_c = out_w // 2
+
+    if quadrant == "TL":
+        return 0, 0, mid_r - 1, mid_c - 1
+    if quadrant == "TR":
+        return 0, mid_c + 1, mid_r - 1, out_w - 1
+    if quadrant == "BL":
