+    assert out_h >= 3 and out_w >= 3
+
+    out = np.full((out_h, out_w), BLACK, dtype=int)
+    mid_r = out_h // 2
+    mid_c = out_w // 2
+    out[mid_r, :] = GREY
+    out[:, mid_c] = GREY
