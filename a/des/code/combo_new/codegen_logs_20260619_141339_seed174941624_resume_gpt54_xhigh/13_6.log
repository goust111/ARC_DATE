+        dir_idx = rng.randrange(4)
+
+        used_nodes = {start}
+        used_edges: set[frozenset[tuple[int, int]]] = set()
+        degrees: dict[tuple[int, int], int] = {start: 0}
+        cur = start
+        heading = dir_idx
+        ok = True
+
+        for event in events:
+            straight_len = rng.randint(1, 3)
+            for _ in range(straight_len):
