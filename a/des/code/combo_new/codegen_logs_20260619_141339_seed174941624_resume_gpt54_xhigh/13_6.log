+    rules[colors.index(start_color)] = start_rule
+    if len(set(rules)) == 1 and entry_count >= 2:
+        flip_idx = 1 if colors[0] == start_color else 0
+        rules[flip_idx] = _other_side(start_rule)
+    entries = list(zip(colors, rules))
