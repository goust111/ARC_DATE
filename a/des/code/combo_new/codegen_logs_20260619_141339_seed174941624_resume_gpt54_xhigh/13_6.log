+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+LEFT_TURN = {0: 3, 1: 0, 2: 1, 3: 2}
+RIGHT_TURN = {0: 1, 1: 2, 2: 3, 3: 0}
+
+LEFT_L_MASK = np.array(
+    [
+        [1, 0, 0],
+        [1, 0, 0],
+        [1, 1, 1],
+    ],
+    dtype=bool,
+)
+RIGHT_L_MASK = np.array(
