        if keep.sum()+rot.sum()"'!=H*W:
            continue
        for a in placeable(keep,H,W):
            for b in placeable(rot,H,W):
                if np.any(a & b):
                    continue
                if np.all(a | b):
                    cnt+=1
                    if cnt>=limit:
