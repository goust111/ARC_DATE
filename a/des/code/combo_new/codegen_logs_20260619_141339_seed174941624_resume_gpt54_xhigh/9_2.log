+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+_BG = 0
+_COLORS = tuple(range(1, 10))
+_MIN_GRID = 18
+_MAX_GRID = 30
+_MIN_INTERIOR = 3
+_MAX_INTERIOR = 7
