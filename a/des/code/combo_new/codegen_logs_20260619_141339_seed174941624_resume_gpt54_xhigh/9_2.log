+    patch = np.full((interior_h + 2, interior_w + 2), _BG, dtype=int)
+    patch[0, :] = color
+    patch[-1, :] = color
+    patch[:, 0] = color
+    patch[:, -1] = color
+    return patch
+
+
+def _piece_patch(mask: np.ndarray, color: int) -> np.ndarray:
+    patch = np.full(mask.shape, _BG, dtype=int)
+    patch[mask] = color
+    return patch
