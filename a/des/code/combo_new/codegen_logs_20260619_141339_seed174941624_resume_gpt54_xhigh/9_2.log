+
+    if not np.array_equal(main(inp), out):
+        return None
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_ATTEMPTS):
+        case = _generate_case()
+        if case is not None:
+            return case[0]
+    raise RuntimeError("failed to generate a valid fragment-to-frame ARC instance")

