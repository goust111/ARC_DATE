+def _boundary_mask(filled: np.ndarray) -> np.ndarray:
+    h, w = filled.shape
+    boundary = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not filled[r, c]:
+                continue
+            if r == 0 or c == 0 or r == h - 1 or c == w - 1:
+                boundary[r, c] = True
+                continue
+            for nr, nc in _neighbors4(r, c, h, w):
+                if not filled[nr, nc]:
+                    boundary[r, c] = True
+                    break
