+            if signature is None:
+                continue
+            record = dict(record)
+            record["signature"] = signature
+            record["key_id"] = int(next_key_id)
+            next_key_id += 1
+            key_records.append(record)
+
+    for key in key_records:
+        for r, c in key["coords"]:
+            out[r, c] = bg
