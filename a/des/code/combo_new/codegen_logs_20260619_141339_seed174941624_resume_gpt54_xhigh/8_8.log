+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "mask": rel,
+                "coords": comp,
+                "color": int(color),
+            }
+        )
+    return records
+
+
+def _row_spans(mask: np.ndarray) -> tuple[np.ndarray, np.ndarray] | None:
