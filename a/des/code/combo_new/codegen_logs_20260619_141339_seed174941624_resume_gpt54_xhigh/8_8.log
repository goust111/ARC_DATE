+def _fill_lock_shape(lock_mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    h, w = lock_mask.shape
+    outside = np.zeros((h, w), dtype=bool)
+    queue: deque[tuple[int, int]] = deque()
+
