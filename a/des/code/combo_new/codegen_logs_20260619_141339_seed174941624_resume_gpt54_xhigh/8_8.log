+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG_COLOR = 0
+LOCK_COLOR = 5
+KEY_COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+GRID_SIDE_MIN = 20
+GRID_SIDE_MAX = 30
+LOCK_COUNT_OPTIONS = (1, 2, 2, 3)
+EXTRA_KEY_OPTIONS = (0, 1, 1, 2)
