+        lefts, rights = row_spans
+        if np.all(lefts == 0):
+            base_right = int(rights.min())
+            if base_right < w - 1:
+                band = _positive_band(rights - base_right)
+                if band is not None:
+                    _start, profile = band
+                    candidates.append(("right", profile))
+        if np.all(rights == w - 1):
+            base_left = int(lefts.max())
+            if base_left > 0:
