import numpy as np

from arc_utils import bbox_h, bbox_w, find_components, get_bg, paste
import random


def _rotate_ring(out: np.ndarray, g: np.ndarray, r0: int, c0: int) -> None:
    patch = g[r0 : r0 + 3, c0 : c0 + 3]

