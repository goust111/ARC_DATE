+def _expected_output(
+    grid: np.ndarray,
+    frame_specs: list[dict],
+    patch_specs: list[dict],
+) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    for patch in patch_specs:
+        r0, c0 = patch["pos"]
+        q = int(patch["patch"].shape[0])
+        out[r0 : r0 + q, c0 : c0 + q] = int(BG)
+    for frame in frame_specs:
