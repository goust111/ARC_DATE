+        fill = np.rot90(patches[matches[0]]["patch"], 2)
+        used.add(int(matches[0]))
+        r0, c0, r1, c1 = _quadrant_bounds(frame, str(frame["missing"]))
+        out[r0:r1, c0:c1] = fill
+        gap_r, gap_c = frame["gap"]
+        out[int(gap_r), int(gap_c)] = int(frame["color"])
