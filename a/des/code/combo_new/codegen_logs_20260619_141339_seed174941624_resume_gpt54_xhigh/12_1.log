+def _find_frames(grid: np.ndarray, bg: int) -> list[dict]:
+    frames: list[dict] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != int(bg)):
+        for comp in _components(grid == int(color)):
+            r0, c0, r1, c1 = _bbox(comp)
+            h = int(r1 - r0 + 1)
+            w = int(c1 - c0 + 1)
