+
+def _can_place(occ: np.ndarray, r: int, c: int, h: int, w: int, pad: int = 1) -> bool:
+    H, W = occ.shape
+    if r < 0 or c < 0 or r + h > H or c + w > W:
+        return False
+    r0 = max(0, r - pad)
+    c0 = max(0, c - pad)
+    r1 = min(H, r + h + pad)
+    c1 = min(W, c + w + pad)
+    return not bool(occ[r0:r1, c0:c1].any())
