+            gap_r, gap_c = missing[0]
+            if gap_c in (c0, c1) or gap_r not in (r0, r1):
+                continue
+            if gap_r == r0:
+                missing_quadrant = "tl" if gap_c <= c0 + q else "tr"
+            else:
+                missing_quadrant = "bl" if gap_c <= c0 + q else "br"
+            frames.append(
+                {
+                    "color": int(color),
+                    "r0": int(r0),
+                    "c0": int(c0),
+                    "r1": int(r1),
+                    "c1": int(c1),
+                    "q": int(q),
+                    "gap": (int(gap_r), int(gap_c)),
+                    "missing": missing_quadrant,
