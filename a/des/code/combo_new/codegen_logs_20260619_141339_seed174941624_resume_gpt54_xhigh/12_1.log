+
+    for name, patch in quadrants.items():
+        if name == missing:
+            continue
+        if name == "tl":
+            frame[1 : 1 + q, 1 : 1 + q] = patch
+        elif name == "tr":
+            frame[1 : 1 + q, 1 + q : 1 + 2 * q] = patch
+        elif name == "bl":
+            frame[1 + q : 1 + 2 * q, 1 : 1 + q] = patch
+        else:
+            frame[1 + q : 1 + 2 * q, 1 + q : 1 + 2 * q] = patch
