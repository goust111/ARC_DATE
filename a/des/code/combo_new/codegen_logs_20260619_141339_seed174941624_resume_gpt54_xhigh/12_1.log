+
+def _quadrant_bounds(frame: dict, name: str) -> tuple[int, int, int, int]:
+    q = int(frame["q"])
+    r0 = int(frame["r0"]) + 1
+    c0 = int(frame["c0"]) + 1
+    if name == "tl":
+        return r0, c0, r0 + q, c0 + q
+    if name == "tr":
+        return r0, c0 + q, r0 + q, c0 + 2 * q
+    if name == "bl":
+        return r0 + q, c0, r0 + 2 * q, c0 + q
+    return r0 + q, c0 + q, r0 + 2 * q, c0 + 2 * q
+
