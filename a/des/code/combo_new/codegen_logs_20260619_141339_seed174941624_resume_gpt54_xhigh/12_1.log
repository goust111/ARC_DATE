+                continue
+            q = (h - 2) // 2
+            if q < 2:
+                continue
+            comp_set = {tuple(map(int, pt)) for pt in comp.tolist()}
+            if any(r not in (r0, r1) and c not in (c0, c1) for r, c in comp_set):
+                continue
+            border: list[tuple[int, int]] = []
+            for cc in range(c0, c1 + 1):
+                border.append((r0, cc))
+                border.append((r1, cc))
