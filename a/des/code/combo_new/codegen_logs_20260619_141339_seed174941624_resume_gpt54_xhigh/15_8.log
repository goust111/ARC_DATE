+def _paint_container(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    h: int,
+    w: int,
+    side: str,
+    start: int,
+    pattern: tuple[int, ...],
+) -> None:
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    grid[r0, c0 : c1 + 1] = FRAME
+    grid[r1, c0 : c1 + 1] = FRAME
+    grid[r0 : r1 + 1, c0] = FRAME
+    grid[r0 : r1 + 1, c1] = FRAME
