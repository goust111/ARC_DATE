+
+def _find_free_box(
+    occ: np.ndarray,
+    h: int,
+    w: int,
+    rng: random.Random,
+    *,
+    pad: int,
+    margin: int,
+) -> tuple[int, int] | None:
+    height, width = occ.shape
+    if height < h + 2 * margin or width < w + 2 * margin:
+        return None
+
+    positions = [
+        (r, c)
+        for r in range(margin, height - h - margin + 1)
+        for c in range(margin, width - w - margin + 1)
+    ]
+    rng.shuffle(positions)
+    for r, c in positions[:PLACE_RETRIES]:
