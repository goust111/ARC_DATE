+def _reserve_box(occ: np.ndarray, r: int, c: int, h: int, w: int, pad: int) -> None:
+    rr0 = max(0, r - pad)
+    cc0 = max(0, c - pad)
+    rr1 = min(occ.shape[0], r + h + pad)
+    cc1 = min(occ.shape[1], c + w + pad)
+    occ[rr0:rr1, cc0:cc1] = True
