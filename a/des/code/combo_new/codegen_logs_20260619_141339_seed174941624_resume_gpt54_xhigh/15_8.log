+        "bottom": np.array([(r1, c) in coord_set for c in range(c0, c1 + 1)], dtype=bool),
+        "left": np.array([(r, c0) in coord_set for r in range(r0, r1 + 1)], dtype=bool),
+        "right": np.array([(r, c1) in coord_set for r in range(r0, r1 + 1)], dtype=bool),
