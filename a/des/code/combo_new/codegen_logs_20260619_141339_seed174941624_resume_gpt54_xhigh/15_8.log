+        return
+
+    col = c0 if side == "left" else c1
+    for i, bit in enumerate(pattern):
+        if bit:
+            grid[r0 + start + i, col] = BG
+
+
+def _key_patch(side: str, pattern: tuple[int, ...], color: int) -> np.ndarray:
