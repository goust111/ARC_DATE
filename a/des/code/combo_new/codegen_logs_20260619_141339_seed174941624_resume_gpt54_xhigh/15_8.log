+    rows = [r0 + start + i for i in range(length)]
+    out[rows, c1 + 1] = color
+    for bit, row in zip(pattern, rows):
+        if not bit:
+            continue
+        out[row, c1] = color
+        out[row, c0 + 1 : c1] = color
