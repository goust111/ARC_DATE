+    if side == "bottom":
+        patch = np.full((2, length), BG, dtype=int)
+        patch[1, :] = color
+        for i, bit in enumerate(pattern):
+            if bit:
+                patch[0, i] = color
+        return patch
+    if side == "left":
+        patch = np.full((length, 2), BG, dtype=int)
+        patch[:, 0] = color
+        for i, bit in enumerate(pattern):
+            if bit:
+                patch[i, 1] = color
