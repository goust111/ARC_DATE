+from __future__ import annotations
+
+from collections import Counter, defaultdict, deque
+import random
+
+import numpy as np
+
+
+BG = 8
+FRAME = 5
+KEY_COLORS = (1, 2, 3, 4, 6, 7, 9)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+GEN_RETRIES = 400
+PLACE_RETRIES = 160
