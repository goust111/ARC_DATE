+    grid[r0 : r1 + 1, c1] = colors["right"]
+    return (r0, c0, r1, c1), count
+
+
+def _expected_output(inp: np.ndarray, mapping: dict[int, int], regions: list[tuple[tuple[int, int, int, int], int]]) -> np.ndarray:
+    out = inp.copy()
