    for dr, dc in offsets:
        r, c = anchor_r + dr, anchor_c + dc
        if not (0 <= r < h and 0 <= c < w):
            return False
    return True


def _choose_sprite(sprite_color):
    for _ in range(SPRITE_BUILD_RETRIES):
        sprite = _gen2_symmetric_sprite(sprite_color)

