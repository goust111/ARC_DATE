        return tight
    raise RuntimeError("failed to generate a valid shape")


def _pick_marker_cell(template: np.ndarray, side: str, rng: np.random.Generator) -> tuple[int, int]:
    h, w = template.shape
    if side == "left":
        candidates = [(r, 0) for r in range(1, h - 1)]
    elif side == "right":
