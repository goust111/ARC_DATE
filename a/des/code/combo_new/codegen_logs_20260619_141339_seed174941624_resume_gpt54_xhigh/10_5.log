+
+    sr, sc = positions[start_node]
+    er, ec = positions[end_node]
+    grid[sr, sc] = START
+    grid[er, ec] = END
+    return grid
+
+
+def _tree_quality_ok(nodes: list[Node], tree_edges: set[Edge], all_edges: list[Edge]) -> bool:
+    deg = Counter()
+    for a, b in tree_edges:
+        deg[a] += 1
