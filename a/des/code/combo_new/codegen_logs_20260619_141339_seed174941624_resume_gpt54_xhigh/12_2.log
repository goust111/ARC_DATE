+        for i in range(nseg):
+            a = vertices[i]
+            b = vertices[i + 1]
+            dist = abs(a[0] - b[0]) + abs(a[1] - b[1])
+            spans = _fragment_spans(dist, start_is_bend=i > 0, end_is_bend=i < nseg - 1)
+            assert spans
