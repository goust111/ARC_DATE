+        vertices = path["vertices"]
+        for i in range(len(vertices) - 1):
+            for r, c in _line_cells(vertices[i], vertices[i + 1]):
+                out[r, c] = color
+
+        for r, c in vertices[1:-1]:
+            inp[r, c] = color
+
