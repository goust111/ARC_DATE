+        return {"orientation": "H", "row": int(rows[0]), "c0": c0, "c1": c1}
+    assert bool(np.all(cols == cols[0]))
+    r0 = int(rows.min())
+    r1 = int(rows.max())
+    assert int(coords.shape[0]) == r1 - r0 + 1
