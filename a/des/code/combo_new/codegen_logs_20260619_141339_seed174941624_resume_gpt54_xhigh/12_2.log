+    colors = random.sample(PALETTE, num_colors)
+    occupied: set[tuple[int, int]] = set()
+    paths: list[dict] = []
+
+    for idx, color in enumerate(colors):
+        max_bends = 4 if num_colors == 1 else 3
+        bends = random.randint(1, max_bends)
+        vertices = None
