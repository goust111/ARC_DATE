+    dr = 0 if a[0] == b[0] else (1 if b[0] > a[0] else -1)
+    dc = 0 if a[1] == b[1] else (1 if b[1] > a[1] else -1)
+    return (a[0] + dr * offset, a[1] + dc * offset)
