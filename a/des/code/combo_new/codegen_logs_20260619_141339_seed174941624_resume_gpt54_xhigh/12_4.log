+        boundary = {(r, c) for r, c in comp}
+        interior: set[tuple[int, int]] = set()
+        seeds: list[tuple[int, int]] = []
+        bg_cells: set[tuple[int, int]] = set()
+        seed_colors: set[int] = set()
