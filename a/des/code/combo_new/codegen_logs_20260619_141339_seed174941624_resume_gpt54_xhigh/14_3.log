+    return cells, reserved
+
+
+def _try_place_groups(h: int, w: int, specs: list[GroupSpec], reserved: np.ndarray) -> list[PlacedGroup] | None:
+    occupied = reserved.copy()
+    placed: list[PlacedGroup] = []
