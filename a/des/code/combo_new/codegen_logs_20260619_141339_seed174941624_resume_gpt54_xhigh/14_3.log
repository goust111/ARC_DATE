+    if r1 - r0 + 1 < 3 or c1 - c0 + 1 < 3:
+        return None
+
+    border = _border_cells((r0, c0, r1, c1))
+    coord_set = set(coords)
+    if not coord_set <= border:
+        return None
+
+    missing = sorted(border - coord_set)
+    if len(missing) > 1:
+        return None
+    if len(coord_set) != len(border) - len(missing):
+        return None
