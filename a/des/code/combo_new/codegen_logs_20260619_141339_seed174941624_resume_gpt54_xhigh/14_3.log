+def _component(g: np.ndarray, start: tuple[int, int], seen: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:
+    h, w = g.shape
+    sr, sc = start
+    color = int(g[sr, sc])
+    stack = [(sr, sc)]
+    seen[sr, sc] = True
+    coords: list[tuple[int, int]] = []
