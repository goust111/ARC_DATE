+def _find_groups(g: np.ndarray, bg: int, legend_mask: np.ndarray) -> list[list[Frame]]:
+    h, w = g.shape
+    blocked = legend_mask | (g == bg)
+    seen = np.zeros((h, w), dtype=bool)
