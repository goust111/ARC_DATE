+def _paint_group(out: np.ndarray, group: list[Frame], fill_color: int, bg: int) -> None:
+    r0, c0, r1, c1 = group[0].bbox
+    region = out[r0 : r1 + 1, c0 : c1 + 1]
+    region[region == bg] = fill_color
