+    while stack:
+        r, c = stack.pop()
+        coords.append((r, c))
+        for rr, cc in _neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and not seen[rr, cc] and not blocked[rr, cc] and int(g[rr, cc]) == color:
