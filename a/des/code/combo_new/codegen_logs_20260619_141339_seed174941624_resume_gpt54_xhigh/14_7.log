+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAROON = 9
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8]
+PATTERN_INDEX_SETS = [
+    (0, 1),
+    (0, 2),
+    (0, 3),
+    (1, 2),
+    (1, 3),
+    (2, 3),
+]
+MAX_GENERATION_ATTEMPTS = 400
