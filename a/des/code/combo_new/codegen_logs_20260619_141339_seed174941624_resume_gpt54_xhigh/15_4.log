+        return [int(rng.integers(1, 5))]
+
+    for _ in range(50):
+        values = [int(rng.integers(1, 5)) for _ in range(count)]
+        if len(set(values)) >= 2:
+            return values
+
+    return [1, 2] + [int(rng.integers(1, 5)) for _ in range(count - 2)]
+
