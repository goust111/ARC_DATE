+        for r, c in border:
+            out[r, c] = track_color
+        for marker_index in markers:
+            r, c = border[(marker_index + step) % len(border)]
+            out[r, c] = YELLOW
+
+    return out
+
+
+def _rectangles_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
+
