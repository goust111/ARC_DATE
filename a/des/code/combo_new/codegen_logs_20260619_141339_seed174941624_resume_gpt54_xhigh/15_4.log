+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        sample = _gen_attempt(_RNG)
+        if sample is not None:
+            return sample
+    raise RuntimeError("failed to generate a valid ring-shift sample")

