+    track_colors = {int(grid[r, c]) for r, c in border if int(grid[r, c]) != YELLOW}
+    assert len(track_colors) == 1
+    track_color = int(next(iter(track_colors)))
+    assert track_color not in (BACKGROUND, YELLOW)
+
