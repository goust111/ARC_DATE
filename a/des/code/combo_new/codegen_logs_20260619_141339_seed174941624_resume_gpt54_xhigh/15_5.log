+        upper = (top, left, top + upper_h - 1, left + upper_w - 1)
+    elif corner == "tr":
+        lower = (top + extra_h, left, top + extra_h + lower_h - 1, left + lower_w - 1)
+        upper = (top, left + lower_w - overlap_w, top + upper_h - 1, left + lower_w - overlap_w + upper_w - 1)
+    elif corner == "bl":
