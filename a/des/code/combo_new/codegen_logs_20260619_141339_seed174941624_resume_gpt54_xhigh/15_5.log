+    h, w = shape
+    if not _place_specs(specs, h, w):
+        return None
+
+    palette = list(OBJECT_COLORS)
+    random.shuffle(palette)
+    while len(palette) < 2 * pair_count:
+        palette.extend(random.sample(OBJECT_COLORS, len(OBJECT_COLORS)))
