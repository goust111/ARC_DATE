+import itertools
+import random
+
+import numpy as np
+
+
+Rect = tuple[int, int, int, int]
+
+_BG = 0
+_PALETTE = tuple(range(1, 10))
+_LAYER_OPTIONS = (2, 3, 4)
+_BLOCK_H_MAX = {2: 10, 3: 8, 4: 7}
