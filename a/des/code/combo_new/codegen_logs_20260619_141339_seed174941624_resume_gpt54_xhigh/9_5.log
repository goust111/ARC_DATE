+def _gen_attempt() -> np.ndarray | None:
+    n_layers = random.choice(_LAYER_OPTIONS)
+    block_h = random.randint(_BLOCK_H_MIN, _BLOCK_H_MAX[n_layers])
+    block_w = random.randint(*_BLOCK_W_RANGE)
