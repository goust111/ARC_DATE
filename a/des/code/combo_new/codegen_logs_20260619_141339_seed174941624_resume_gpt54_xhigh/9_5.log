+    h, w = map(int, shape)
+    out = np.zeros((h * len(order), w), dtype=int)
+    for layer_idx, color in enumerate(order):
+        r0, c0, r1, c1 = rect_by_color[int(color)]
+        base = layer_idx * h
+        out[base + r0 : base + r1 + 1, c0 : c1 + 1] = int(color)
+    return out
+
