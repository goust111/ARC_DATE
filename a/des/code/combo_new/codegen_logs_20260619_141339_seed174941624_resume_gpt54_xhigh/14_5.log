+                assert all(fr0 < r < fr1 and fc0 < c < fc1 for r, c in candidate)
+                assert yellow not in candidate
+                moved = candidate
+            out[yellow] = YELLOW
+            for r, c in moved:
+                out[r, c] = GREY
+
+    return out
+
+
+def _red_lr_shape() -> np.ndarray:
+    return _sample_shape(
+        lambda m: m.shape[1] > 1 and not np.array_equal(m, np.fliplr(m)),
