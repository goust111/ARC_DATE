+def _find_containers(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    containers = []
+    for r in range(h):
+        for c in range(w):
