+def _rotate_cw_about_center(mask: np.ndarray, top: int, left: int) -> tuple[np.ndarray, int, int]:
+    rotated = np.rot90(mask, -1)
+    h, w = mask.shape
+    new_h, new_w = rotated.shape
+    dr = h - new_h
+    dc = w - new_w
+    assert dr % 2 == 0 and dc % 2 == 0
+    return rotated, top + dr // 2, left + dc // 2
