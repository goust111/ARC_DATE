+    for r, c in cells:
+        raw[r, c] = True
+    return _crop_mask(raw)
+
+
+def _sample_shape(predicate, canvas_choices: list[tuple[int, int]]) -> np.ndarray:
+    for _ in range(400):
+        h, w = random.choice(canvas_choices)
+        area = random.randint(3, min(6, h * w))
