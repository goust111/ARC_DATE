+
+
+def _red_ud_shape() -> np.ndarray:
+    return _sample_shape(
+        lambda m: m.shape[0] > 1 and not np.array_equal(m, np.flipud(m)),
+        [(2, 2), (2, 3), (3, 2), (3, 3)],
+    )
+
+
+def _blue_shape() -> np.ndarray:
