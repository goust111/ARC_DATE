+
+def _empty_container(interior_h: int, interior_w: int, border_color: int) -> np.ndarray:
+    patch = np.full((interior_h + 2, interior_w + 2), BG, dtype=int)
+    patch[0, :] = border_color
+    patch[-1, :] = border_color
+    patch[:, 0] = border_color
+    patch[:, -1] = border_color
