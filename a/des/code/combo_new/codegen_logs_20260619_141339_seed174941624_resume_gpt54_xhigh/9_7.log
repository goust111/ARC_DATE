+
+    ordered = sorted(comps, key=lambda comp: (comp["bbox"][0], comp["bbox"][1]))
+    before = ordered[0]["bbox"]
+    after = ordered[1]["bbox"]
+    assert before[2] < after[0], "example objects must be stacked vertically"
