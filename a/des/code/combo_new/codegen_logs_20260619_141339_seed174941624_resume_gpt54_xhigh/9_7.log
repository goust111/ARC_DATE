+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+DIVIDER_COLOR = 5
+GEN_RETRIES = 300
+COLOR_POOL = [0, 1, 2, 3, 4, 6, 7, 8, 9]
