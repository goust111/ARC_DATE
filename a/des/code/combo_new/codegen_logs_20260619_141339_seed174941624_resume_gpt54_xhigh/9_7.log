+            cc0 = max(0, c0 - 1)
+            rr1 = min(h, r1 + 1)
+            cc1 = min(w, c1 + 1)
+            if not blocked[rr0:rr1, cc0:cc1].any():
+                positions.append((r0, c0))
+    return positions
+
+
+def _place_patch(panel: np.ndarray, patch: np.ndarray, blocked: np.ndarray, bg: int) -> bool:
+    positions = _find_positions(panel, patch.shape, blocked)
