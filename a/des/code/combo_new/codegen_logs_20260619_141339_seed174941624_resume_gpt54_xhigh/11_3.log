+        rows = [patches]
+    elif random.random() < 0.5:
+        split = random.randint(1, len(patches) - 1)
+        rows = [patches[:split], patches[split:]]
+    else:
+        rows = [patches]
+
+    row_gap = random.randint(2, 4)
