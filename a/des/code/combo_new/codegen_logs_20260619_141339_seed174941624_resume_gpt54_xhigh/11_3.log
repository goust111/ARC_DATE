+    return out
+
+
+def _line_component_info(coords: list[tuple[int, int]], color: int) -> dict:
+    rows = sorted({r for r, _c in coords})
+    cols = sorted({c for _r, c in coords})
+    if len(rows) == 1:
+        orientation = "h"
+        axis = rows[0]
