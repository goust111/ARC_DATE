+    patches: list[dict] = []
+
+    if overlap_mode:
+        overlap_patch = _build_patch(
+            orientation=random.choice(("v", "h")),
+            require_object=True,
+            overlap_pair=True,
+        )
+        if overlap_patch is None:
+            return None
+        patches.append(overlap_patch)
+        normal = _build_patch(
+            orientation=random.choice(("v", "h")),
+            require_object=True,
+            overlap_pair=False,
+        )
+        if normal is None:
+            return None
+        patches.append(normal)
+
+    while len(patches) < total:
+        patch = _build_patch(
+            orientation=random.choice(("v", "h")),
+            require_object=(len(patches) == 0),
+            overlap_pair=False,
