+    return {
+        "coords": coords,
+        "coord_set": set(coords),
+        "color": int(color),
+        "orientation": orientation,
+        "axis": int(axis),
+    }
+
+
+def _reflect_coords(
+    coords: list[tuple[int, int]], orientation: str, axis: int
+) -> list[tuple[int, int]]:
+    if orientation == "v":
+        return [(r, 2 * axis - c) for r, c in coords]
+    return [(2 * axis - r, c) for r, c in coords]
