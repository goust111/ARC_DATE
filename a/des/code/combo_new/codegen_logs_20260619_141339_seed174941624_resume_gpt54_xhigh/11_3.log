    feasible = [k for k in range(1, max_parts + 1) if right >= int(min_first_col) + k - 1]
    if not feasible:
        return None
    weights = [k * k for k in feasible]
    k = random.choices(feasible, weights=weights, k=1)[0]

    if k == 1:
