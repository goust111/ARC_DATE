+            x += patch["width"] + gap
+        y += row_height + row_gap
+    return grid
+
+
+def _gen_attempt() -> np.ndarray | None:
+    patches = _make_patches()
+    if patches is None:
+        return None
+    grid = _pack_rows(patches)
+    if grid is None:
+        return None
+    out = main(grid)
+    if not np.any(out != grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
