+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            out.append(coords)
+    return out
+
+
+def _line_component_info(coords: list[tuple[int, int]], color: int) -> dict:
+    rows = sorted({r for r, _c in coords})
+    cols = sorted({c for _r, c in coords})
+    if len(rows) == 1:
+        orientation = "h"
+        axis = rows[0]
+        span = cols
+    else:
+        assert len(cols) == 1, "mirror axis must be horizontal or vertical"
+        orientation = "v"
+        axis = cols[0]
+        span = rows
+    assert span == list(range(span[0], span[-1] + 1)), "mirror axis must be contiguous"
+    return {
+        "coords": coords,
+        "coord_set": set(coords),
+        "color": int(color),
+        "orientation": orientation,
+        "axis": int(axis),
+    }
+
+
+def _reflect_coords(
+    coords: list[tuple[int, int]], orientation: str, axis: int
+) -> list[tuple[int, int]]:
+    if orientation == "v":
+        return [(r, 2 * axis - c) for r, c in coords]
+    return [(2 * axis - r, c) for r, c in coords]
