+    for patch in sorted(patches, key=lambda arr: arr.shape[0] * arr.shape[1], reverse=True):
+        ph, pw = patch.shape
+        ok = _paste_patch(
+            grid,
+            blocked,
+            patch,
+            (1, grid_h - ph - 2),
