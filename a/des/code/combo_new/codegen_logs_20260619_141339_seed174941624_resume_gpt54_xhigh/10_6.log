+def _expanded_overlap(blocked: np.ndarray, r0: int, c0: int, h: int, w: int) -> bool:
+    rs = max(0, r0 - 1)
+    re = min(blocked.shape[0], r0 + h + 1)
+    cs = max(0, c0 - 1)
+    ce = min(blocked.shape[1], c0 + w + 1)
+    return bool(blocked[rs:re, cs:ce].any())
