 109: def main(grid: np.ndarray) -> np.ndarray:
 110:     """
 111:     Remove the green-marked wall segments from the gray lattice and highlight the unique route between the two colored intersections.
 112: 
 113:     Input structure:
 114:     - The background is black.
 115:     - Gray pixels form a one-cell-wide orthogonal lattice whose straight segments connect neighboring intersections.
 116:     - Two non-gray, non-green colored pixels sit on intersection cells and mark the start and end.
 117:     - Green pixels sit at the midpoints of some straight lattice segments and mark those segments for deletion.
 118: 
 119:     Rule:
 120:     - Treat every green midpoint as selecting its whole straight segment between the two adjacent intersections.
 121:     - Erase that segment to black, including the green midpoint itself, while keeping the endpoint intersections.
 122:     - In the remaining lattice, find the unique 4-connected path from the start pixel to the end pixel.
 123:     - Recolor every gray pixel on that path to yellow, but keep the start and end pixels in their original colors.
 124: 
 125:     Key insight:
 126:     - The green pixels do not mark the desired route; they remove corridors first, so the yellow route must be found only after interpreting each green midpoint as a deleted edge of the lattice graph.
 127:     """
 128:     g = np.asarray(grid, dtype=int)
 129:     assert g.ndim == 2, "expected a 2D grid"
 130: 
 131:     bg = _most_common_color(g)
 132:     non_bg = [int(color) for color in np.unique(g) if int(color) != bg]
 133:     assert non_bg, "expected a foreground lattice"
 134:     skeleton = max(non_bg, key=lambda color: int(np.count_nonzero(g == color)))
 135: 
 136:     occupied = g != bg
 137:     node_mask = _node_mask(occupied)
 138: 
 139:     wall_markers: list[Coord] = []
 140:     endpoints: list[Coord] = []
 141:     for r, c in np.argwhere((g != bg) & (g != skeleton)):
 142:         coord = (int(r), int(c))
 143:         if _is_straight_pixel(occupied, coord[0], coord[1]):
 144:             wall_markers.append(coord)
 145:         else:
 146:             endpoints.append(coord)
 147: 
 148:     assert len(endpoints) == 2, "expected exactly two colored intersection endpoints"
 149: 
 150:     out = g.copy()
 151:     for marker in wall_markers:
 152:         for rr, cc in _trace_wall_segment(occupied, node_mask, marker):
 153:             out[rr, cc] = bg
 154: 
 155:     maze_mask = out != bg
 156:     start, end = endpoints
 157:     path = _bfs_path(maze_mask, start, end)
 158: 
 159:     for r, c in path:
 160:         if int(out[r, c]) == int(skeleton):
 161:             out[r, c] = PATH
 162: 
 163:     return out
