  84: def _bfs_path(mask: np.ndarray, start: Coord, end: Coord) -> list[Coord]:
  85:     queue: deque[Coord] = deque([start])
  86:     parent: dict[Coord, Coord | None] = {start: None}
  87: 
  88:     while queue:
  89:         cur = queue.popleft()
  90:         if cur == end:
  91:             break
  92:         for nxt in _orth_neighbors(mask, cur[0], cur[1]):
  93:             if nxt in parent:
  94:                 continue
  95:             parent[nxt] = cur
  96:             queue.append(nxt)
  97: 
  98:     assert end in parent, "start and end must remain connected after removing walls"
  99: 
 100:     path: list[Coord] = []
 101:     cur: Coord | None = end
 102:     while cur is not None:
 103:         path.append(cur)
 104:         cur = parent[cur]
 105:     path.reverse()
 106:     return path
