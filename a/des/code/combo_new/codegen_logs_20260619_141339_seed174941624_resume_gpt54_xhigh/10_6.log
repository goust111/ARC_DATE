  28: def _infer_bg_and_pipe(g: np.ndarray) -> tuple[int, int]:
  29:     bg = _most_common_color(g)
  30:     counts = Counter(int(x) for x in g.flat if int(x) != bg)
  31:     assert counts, "expected at least one foreground color"
  32:     pipe = int(counts.most_common(1)[0][0])
