+    mapping, dot_color = _legend_mapping(grid[:, legend_left : legend_left + legend.shape[1]], BG)
+    canvas = grid[:, legend_left + legend.shape[1] :]
+    filled = _fill_canvas(canvas, mapping, dot_color)
+    if np.array_equal(filled, canvas):
