  36: def _orth_degree(mask: np.ndarray) -> np.ndarray:
  37:     deg = np.zeros(mask.shape, dtype=int)
  38:     deg[1:, :] += mask[:-1, :]
  39:     deg[:-1, :] += mask[1:, :]
  40:     deg[:, 1:] += mask[:, :-1]
  41:     deg[:, :-1] += mask[:, 1:]
  42:     return deg
  43: 
