  41: def _is_straight_pixel(mask: np.ndarray, r: int, c: int) -> bool:
  42:     neighbors = _orth_neighbors(mask, r, c)
  43:     if len(neighbors) != 2:
  44:         return False
  45:     dr0 = neighbors[0][0] - r
  46:     dc0 = neighbors[0][1] - c
  47:     dr1 = neighbors[1][0] - r
  48:     dc1 = neighbors[1][1] - c
  49:     return dr0 + dr1 == 0 and dc0 + dc1 == 0
  50: 
  51: 
  52: def _node_mask(mask: np.ndarray) -> np.ndarray:
  53:     out = np.zeros_like(mask, dtype=bool)
  54:     for r, c in np.argwhere(mask):
  55:         out[int(r), int(c)] = not _is_straight_pixel(mask, int(r), int(c))
  56:     return out
