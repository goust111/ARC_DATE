  30: def _orth_neighbors(mask: np.ndarray, r: int, c: int) -> list[Coord]:
  31:     h, w = mask.shape
  32:     out: list[Coord] = []
  33:     for dr, dc in DIR4:
  34:         rr = r + dr
  35:         cc = c + dc
  36:         if 0 <= rr < h and 0 <= cc < w and bool(mask[rr, cc]):
