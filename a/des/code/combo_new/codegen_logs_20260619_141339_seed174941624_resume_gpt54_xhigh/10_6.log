  45: def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
  46:     h, w = mask.shape
  47:     seen = np.zeros((h, w), dtype=bool)
  48:     comps: list[list[tuple[int, int]]] = []
  49:     for r in range(h):
  50:         for c in range(w):
  51:             if not bool(mask[r, c]) or bool(seen[r, c]):
  52:                 continue
  53:             stack = [(r, c)]
  54:             seen[r, c] = True
  55:             comp: list[tuple[int, int]] = []
  56:             while stack:
  57:                 cr, cc = stack.pop()
  58:                 comp.append((int(cr), int(cc)))
  59:                 for nr, nc in _neighbors4(int(cr), int(cc), h, w):
  60:                     if bool(mask[nr, nc]) and not bool(seen[nr, nc]):
  61:                         seen[nr, nc] = True
  62:                         stack.append((int(nr), int(nc)))
  63:             comps.append(comp)
  64:     return comps
