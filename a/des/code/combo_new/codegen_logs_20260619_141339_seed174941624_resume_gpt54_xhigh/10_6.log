  59: def _trace_wall_segment(mask: np.ndarray, node_mask: np.ndarray, marker: Coord) -> set[Coord]:
  60:     r, c = marker
  61:     neighbors = _orth_neighbors(mask, r, c)
  62:     assert len(neighbors) == 2 and _is_straight_pixel(mask, r, c), "wall marker must sit on a straight segment"
  63: 
  64:     dr = neighbors[0][0] - r
  65:     dc = neighbors[0][1] - c
  66:     cells = {(int(r), int(c))}
  67: 
  68:     for sign in (-1, 1):
  69:         rr = r + sign * dr
  70:         cc = c + sign * dc
  71:         while 0 <= rr < mask.shape[0] and 0 <= cc < mask.shape[1] and bool(mask[rr, cc]):
  72:             if bool(node_mask[rr, cc]):
  73:                 break
  74:             cells.add((int(rr), int(cc)))
  75:             rr += sign * dr
  76:             cc += sign * dc
  77:         else:
  78:             raise AssertionError("wall segment must terminate at an intersection")
  79:         assert bool(node_mask[rr, cc]), "wall segment must end next to an intersection"
  80: 
  81:     return cells
