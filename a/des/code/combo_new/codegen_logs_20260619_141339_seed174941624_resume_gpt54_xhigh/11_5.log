+    return seen_count == int(mask.sum())
+
+
+def _external_region(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    if h == 0 or w == 0:
+        return seen
+    for r in range(h):
+        for c in (0, w - 1):
+            if mask[r, c] and not seen[r, c]:
