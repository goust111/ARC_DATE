+
+    if np.array_equal(out, grid):
+        return None
+    if np.any(out[:, :main_w] == GREY):
+        return None
+    if not np.array_equal(out[:, main_w:], grid[:, main_w:]):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
