+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    r0, c0 = map(int, pts[0])
+    seen[r0, c0] = True
+    q = deque([(r0, c0)])
+    seen_count = 1
+    while q:
