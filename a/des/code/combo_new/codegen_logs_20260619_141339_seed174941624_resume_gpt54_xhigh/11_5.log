+    for _ in range(rng.randint(*MUTATION_STEPS)):
+        if rng.random() < 0.62:
+            candidates = _boundary_add_candidates(canvas)
+            if not candidates:
+                continue
+            proposal = canvas.copy()
+            r, c = rng.choice(candidates)
+            proposal[r, c] = True
+            if rng.random() < 0.35:
+                dirs = list(DIR4)
+                rng.shuffle(dirs)
