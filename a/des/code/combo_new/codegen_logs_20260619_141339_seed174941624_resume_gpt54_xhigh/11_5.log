+
+def _count_holes(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    padded = np.zeros((h + 2, w + 2), dtype=bool)
+    padded[1:-1, 1:-1] = mask
+    outside = np.zeros_like(padded, dtype=bool)
+    outside[0, 0] = True
+    q = deque([(0, 0)])
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h + 2 and 0 <= nc < w + 2 and not padded[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+
+    holes = 0
+    for r in range(1, h + 1):
+        for c in range(1, w + 1):
+            if padded[r, c] or outside[r, c]:
+                continue
+            holes += 1
+            outside[r, c] = True
+            q = deque([(r, c)])
+            while q:
+                rr, cc = q.popleft()
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h + 2 and 0 <= nc < w + 2 and not padded[nr, nc] and not outside[nr, nc]:
