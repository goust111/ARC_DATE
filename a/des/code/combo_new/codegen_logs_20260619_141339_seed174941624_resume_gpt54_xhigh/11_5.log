+            if not candidates:
+                continue
+            proposal = canvas.copy()
+            r, c = rng.choice(candidates)
+            proposal[r, c] = False
+            if rng.random() < 0.28:
+                dirs = list(DIR4)
+                rng.shuffle(dirs)
+                for dr, dc in dirs:
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < proposal.shape[0] and 0 <= nc < proposal.shape[1] and proposal[nr, nc]:
