+        candidates = []
+        for r0 in range(h - piece["h"] + 1):
+            for c0 in range(w - piece["w"] + 1):
+                cells = [(r0 + r, c0 + c) for r, c in piece["cells"]]
+                if any(blocked[r, c] for r, c in cells):
