+    pairings = _solve_pairing(objects)
+    rectangles = []
+    for order_idx, (i, j, layout) in enumerate(pairings):
+        rect = _render_pair(objects[i], objects[j], layout)
+        rectangles.append(
+            {
+                "grid": rect,
+                "h": layout["h"],
+                "w": layout["w"],
+                "order": order_idx,
+            }
+        )
