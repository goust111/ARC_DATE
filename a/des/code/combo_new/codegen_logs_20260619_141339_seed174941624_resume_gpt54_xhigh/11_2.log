+    visited = np.zeros((h, w), dtype=bool)
+    objects: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BACKGROUND or visited[r, c]:
+                continue
+
+            queue = deque([(r, c)])
