+def _seed_positions(grid: np.ndarray) -> dict[int, list[tuple[int, int]]]:
+    seeds: dict[int, list[tuple[int, int]]] = {}
+    for r, c in np.argwhere(grid != BG):
+        color = int(grid[r, c])
+        seeds.setdefault(color, []).append((int(r), int(c)))
+    for coords in seeds.values():
+        coords.sort()
+    return seeds
+
