  71: def main(grid: np.ndarray) -> np.ndarray:
  72:     """
  73:     Mirror the smallest non-axis foreground color across the full straight axis.
  74: 
  75:     Input structure
  76:     - The background is the dominant color.
  77:     - One foreground color forms exactly one full row, column, main diagonal, or anti-diagonal reflection axis.
  78:     - The remaining foreground colors include a unique least-populated color to copy.
  79: 
  80:     Rule
  81:     - Preserve the input grid.
  82:     - Select every pixel of the unique smallest non-axis foreground color.
  83:     - Reflect those pixels across the full straight axis and paint the reflected positions with the same color.
  84: 
  85:     Key insight
  86:     - The axis color marks the mirror line, while the color population chooses which set of objects is duplicated.
  87:     """
  88:     g = np.asarray(grid, dtype=int)
  89:     assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
  90: 
  91:     bg = get_bg(g)
  92:     axis = _find_reflection_axis(g, bg)
  93:     axis_color = axis[0]
  94:     mirror_color = _smallest_non_axis_color(g, bg, axis_color)
  95: 
  96:     out = g.copy()
  97:     h, w = g.shape
  98:     for r_raw, c_raw in np.argwhere(g == mirror_color):
  99:         r = int(r_raw)
 100:         c = int(c_raw)
 101:         rr, cc = _reflect(axis, g.shape, r, c)
 102:         assert 0 <= rr < h and 0 <= cc < w, "reflected pixel must stay inside the grid"
 103:         assert int(out[rr, cc]) in {bg, mirror_color}, "reflection cannot overwrite another foreground object"
 104:         out[rr, cc] = mirror_color
 105: 
