+
+def _placement_block(cells: frozenset[tuple[int, int]]) -> set[tuple[int, int]]:
+    blocked = set(cells)
+    for r, c in cells:
+        blocked.update(_neighbors4(r, c))
+    return blocked
+
+
+def _choose_islands(region: list[tuple[int, int]], count: int) -> list[tuple[int, int]] | None:
