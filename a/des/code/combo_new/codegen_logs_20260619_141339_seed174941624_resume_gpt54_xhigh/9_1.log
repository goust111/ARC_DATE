 140: def _gen_side_mask(n: int, axis_kind: str, side: int) -> np.ndarray:
 141:     rr, cc = np.indices((n, n))
 142:     if axis_kind == "row":
 143:         return rr < n // 2 if side == 0 else rr > n // 2
 144:     if axis_kind == "col":
 145:         return cc < n // 2 if side == 0 else cc > n // 2
 146:     if axis_kind == "main_diag":
 147:         return cc > rr if side == 0 else cc < rr
 148:     return rr + cc < n - 1 if side == 0 else rr + cc > n - 1
