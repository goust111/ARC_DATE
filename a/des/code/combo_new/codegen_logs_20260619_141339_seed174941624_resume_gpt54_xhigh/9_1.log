+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            seen[r, c] = True
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _parse_palette(grid: np.ndarray) -> tuple[list[int], np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+
+    def parse_bottom() -> tuple[list[int], np.ndarray] | None:
+        row = g[-1]
+        colors: list[int] = []
+        mask = np.zeros_like(g, dtype=bool)
+        c = 0
+        while c < w:
+            if int(row[c]) == BG:
+                c += 1
+                continue
+            color = int(row[c])
+            if color in {BG, RED, WALL}:
+                return None
+            if c + 1 >= w or int(row[c + 1]) != color:
+                return None
+            if c + 2 < w and int(row[c + 2]) == color:
+                return None
+            colors.append(color)
+            mask[-1, c : c + 2] = True
+            c += 2
+        if len(colors) >= 2 and len(colors) == len(set(colors)):
+            return colors, mask
+        return None
+
+    def parse_right() -> tuple[list[int], np.ndarray] | None:
+        col = g[:, -1]
+        colors: list[int] = []
+        mask = np.zeros_like(g, dtype=bool)
+        r = 0
+        while r < h:
+            if int(col[r]) == BG:
+                r += 1
+                continue
+            color = int(col[r])
+            if color in {BG, RED, WALL}:
+                return None
+            if r + 1 >= h or int(col[r + 1]) != color:
+                return None
+            if r + 2 < h and int(col[r + 2]) == color:
+                return None
+            colors.append(color)
+            mask[r : r + 2, -1] = True
+            r += 2
+        if len(colors) >= 2 and len(colors) == len(set(colors)):
+            return colors, mask
+        return None
+
+    candidates = []
+    bottom = parse_bottom()
+    if bottom is not None:
+        candidates.append(bottom)
+    right = parse_right()
+    if right is not None:
+        candidates.append(right)
