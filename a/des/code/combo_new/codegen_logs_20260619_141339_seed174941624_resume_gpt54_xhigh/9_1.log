 151: def _gen_reflect(axis_kind: str, n: int, r: int, c: int) -> tuple[int, int]:
 152:     if axis_kind == "row":
 153:         return n - 1 - r, c
 154:     if axis_kind == "col":
 155:         return r, n - 1 - c
 156:     if axis_kind == "main_diag":
 157:         return c, r
 158:     return n - 1 - c, n - 1 - r
