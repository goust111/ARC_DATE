+def _place_palette(grid: np.ndarray, colors: list[int], orient: str) -> bool:
+    if orient == "bottom":
+        gaps = [random.randint(1, 2) for _ in range(len(colors) - 1)]
+        total = 2 * len(colors) + sum(gaps)
+        if total > grid.shape[1]:
+            return False
+        start = random.randint(0, grid.shape[1] - total)
+        c = start
+        for idx, color in enumerate(colors):
+            grid[-1, c : c + 2] = color
+            c += 2
+            if idx + 1 < len(colors):
+                c += gaps[idx]
+        return True
+
+    gaps = [random.randint(1, 2) for _ in range(len(colors) - 1)]
+    total = 2 * len(colors) + sum(gaps)
+    if total > grid.shape[0]:
+        return False
+    start = random.randint(0, grid.shape[0] - total)
+    r = start
+    for idx, color in enumerate(colors):
+        grid[r : r + 2, -1] = color
+        r += 2
+        if idx + 1 < len(colors):
+            r += gaps[idx]
+    return True
+
