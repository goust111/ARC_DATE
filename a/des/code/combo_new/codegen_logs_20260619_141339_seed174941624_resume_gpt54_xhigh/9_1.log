+    return top, bottom, wall
+
+
+def _draw_wall(chamber: np.ndarray, wall: tuple[str, int, int, int]) -> None:
+    orient, fixed, start, end = wall
+    if orient == "v":
+        chamber[start : end + 1, fixed] = WALL
+    else:
