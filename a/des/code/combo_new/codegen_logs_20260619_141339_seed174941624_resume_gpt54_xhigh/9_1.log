 128: def _gen_draw_axis(grid: np.ndarray, axis_kind: str, color: int) -> None:
 129:     n = grid.shape[0]
 130:     if axis_kind == "row":
 131:         grid[n // 2, :] = color
 132:     elif axis_kind == "col":
 133:         grid[:, n // 2] = color
 134:     elif axis_kind == "main_diag":
 135:         np.fill_diagonal(grid, color)
 136:     else:
 137:         np.fill_diagonal(np.fliplr(grid), color)
