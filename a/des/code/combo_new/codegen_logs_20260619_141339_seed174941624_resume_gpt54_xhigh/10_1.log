+    return cell_colors
+
+
+def _relative_polyline() -> list[tuple[int, int]] | None:
+    n_seg = random.choices([1, 2, 3], weights=[3, 4, 3], k=1)[0]
+    dirs: list[tuple[int, int]] = [random.choice(DIR4)]
+    for _ in range(1, n_seg):
