+def _build_l_pair() -> tuple[np.ndarray, np.ndarray, tuple[int, int]] | None:
+    rect_h = random.randint(RECT_SIDE_MIN, RECT_SIDE_MAX)
+    if rect_h < 2:
+        return None
+
+    for _ in range(80):
