+            continue
+
+        width = sub.shape[1]
+        count_zone_w = width - LEGEND_SEP - STYLE_W
+        if count_zone_w < COUNT_BLOCK_W or (count_zone_w + 1) % COUNT_STEP != 0:
+            continue
+        count = (count_zone_w + 1) // COUNT_STEP
+        if count < 1:
