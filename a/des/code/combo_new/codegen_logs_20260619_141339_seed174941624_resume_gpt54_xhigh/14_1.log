+
+def _style_mask(style: str) -> np.ndarray:
+    mask = np.zeros((STYLE_H, STYLE_W), dtype=bool)
+    if style == STYLE_SOLID:
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, 0] = True
+        mask[:, -1] = True
+        return mask
+
+    if style == STYLE_DASHED:
+        mask[0, ::2] = True
+        mask[-1, ::2] = True
+        mask[2, 0] = True
+        mask[2, -1] = True
+        return mask
+
+    if style == STYLE_DOUBLE:
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[1, 1:-1] = True
+        mask[-2, 1:-1] = True
+        mask[1:-1, 1] = True
+        mask[1:-1, -2] = True
+        return mask
+
+    raise ValueError(style)
+
+
+STYLE_MASKS = {style: _style_mask(style) for style in STYLES}
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _dominant_color(values: list[int]) -> int:
+    counts: dict[int, int] = {}
+    for value in values:
+        counts[value] = counts.get(value, 0) + 1
+    return max(counts.items(), key=lambda item: item[1])[0]
+
+
+def _find_legend_mapping(g: np.ndarray) -> dict[int, str]:
