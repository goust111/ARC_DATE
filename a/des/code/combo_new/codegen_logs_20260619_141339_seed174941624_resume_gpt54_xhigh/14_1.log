+BG = 0
+GREY = 5
+NON_BG_NON_GREY = [1, 2, 3, 4, 6, 7, 8, 9]
+
+ROW_H = 5
+ROW_GAP = 1
+COUNT_BLOCK_W = 2
+COUNT_STEP = 3
+LEGEND_SEP = 2
+STYLE_H = 5
+STYLE_W = 7
+
+STYLE_SOLID = "solid"
+STYLE_DASHED = "dashed"
+STYLE_DOUBLE = "double"
+STYLES = (STYLE_SOLID, STYLE_DASHED, STYLE_DOUBLE)
