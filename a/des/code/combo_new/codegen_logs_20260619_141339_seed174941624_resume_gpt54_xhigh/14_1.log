+        if not np.array_equal(sub, expected):
+            continue
+
+        mapping[count] = style
+
+    return mapping
+
+
+def _find_rectangles(g: np.ndarray) -> list[tuple[int, int, int, int]]:
+    rectangles: list[tuple[int, int, int, int]] = []
+    for comp in _components(g == GREY):
