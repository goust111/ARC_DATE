+    cells = [(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)]
+    chosen = random.sample(cells, count)
+    colors = _seed_colors_for_count(count, palette)
+    for (r, c), color in zip(chosen, colors):
