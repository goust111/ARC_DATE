+        assert coords.size > 0, "each rectangle color must remain visible"
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        h = int(r1 - r0 + 1)
+        w = int(c1 - c0 + 1)
+        rects.append((h * w, int(r0), int(c0), h, w, color))
