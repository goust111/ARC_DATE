def bbox_from_mask(mask):
    pts = np.argwhere(mask)
    r0,c0 = pts.min(axis=0)
    r1,c1 = pts.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def overlap(b1,b2):
    r0 = max(b1[0], b2[0])
    c0 = max(b1[1], b2[1])
    r1 = min(b1[2], b2[2])
    c1 = min(b1[3], b2[3])
    if r0 <= r1 and c0 <= c1:
        return (r0,c0,r1,c1)
    return None


def valid_protected(h,w):
    opts=[]
    for opt in PROTECTED_OPTIONS:
        if opt == (\"top\",\"bottom\") and h < 3:
            continue
        if opt == (\"left\",\"right\") and w < 3:
            continue
        opts.append(opt)
    return opts


def respects(lower, upper_bbox):
    inter = overlap(lower['bbox'], upper_bbox)
    if inter is None:
        return True
    r0,c0,r1,c1 = inter
    lr0,lc0,lr1,lc1 = lower['bbox']
    prot = set(lower['protect'])
    if 'top' in prot and r0 <= lr0:
        return False
    if 'bottom' in prot and r1 >= lr1:
        return False
    if 'left' in prot and c0 <= lc0:
        return False
    if 'right' in prot and c1 >= lc1:
        return False
    return True


