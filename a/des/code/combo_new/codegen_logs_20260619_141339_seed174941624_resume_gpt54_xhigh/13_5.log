        r0, c0 = coords.min(axis=0)
        r1, c1 = coords.max(axis=0)
        h = int(r1 - r0 + 1)
        w = int(c1 - c0 + 1)
        rects.append((h * w, int(r0), int(c0), h, w, color))
    rects.sort(key=lambda item: (item[0], item[1], item[2]))
    out_h = max(item[3] for item in rects)
    out_w = sum(item[4] for item in rects) + len(rects) - 1
    out = np.full((out_h, out_w), bg, dtype=int)
    c = 0
    for _area, _r0, _c0, h, w, color in rects:
        out[:h, c:c+w] = color
        c += w + 1
    return out


def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int, int, int]:
    coords = np.argwhere(mask)
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def _overlap(box_a, box_b):
    r0 = max(box_a[0], box_b[0])
    c0 = max(box_a[1], box_b[1])
    r1 = min(box_a[2], box_b[2])
    c1 = min(box_a[3], box_b[3])
    if r0 <= r1 and c0 <= c1:
        return (r0, c0, r1, c1)
    return None


def _valid_protected_options(h, w):
    out = []
    for option in PROTECTED_EDGE_OPTIONS:
        if option == (\"top\", \"bottom\") and h < 3:
            continue
        if option == (\"left\", \"right\") and w < 3:
            continue
        out.append(option)
    return out


def _respects_protected_edges(lower, upper_bbox):
    inter = _overlap(lower['bbox'], upper_bbox)
    if inter is None:
        return True
    ir0, ic0, ir1, ic1 = inter
    r0, c0, r1, c1 = lower['bbox']
    protected = set(lower['protect'])
    if 'top' in protected and ir0 <= r0:
        return False
    if 'bottom' in protected and ir1 >= r1:
        return False
    if 'left' in protected and ic0 <= c0:
        return False
    if 'right' in protected and ic1 >= c1:
