+
+def _find_legend(
+    grid: np.ndarray, frames: list[tuple[int, int, int, int]]
+) -> tuple[tuple[int, int, int, int], list[tuple[int, int, int]]]:
+    outside = np.ones_like(grid, dtype=bool)
+    for r0, c0, r1, c1 in frames:
+        outside[r0 : r1 + 1, c0 : c1 + 1] = False
