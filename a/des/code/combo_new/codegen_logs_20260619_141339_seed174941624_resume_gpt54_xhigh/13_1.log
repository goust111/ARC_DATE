+    candidates = []
+    for cells in _components((grid != BLACK) & outside):
+        rs = [r for r, _ in cells]
+        cs = [c for _, c in cells]
+        r0, r1 = min(rs), max(rs)
+        c0, c1 = min(cs), max(cs)
+        if c1 - c0 + 1 != 3:
