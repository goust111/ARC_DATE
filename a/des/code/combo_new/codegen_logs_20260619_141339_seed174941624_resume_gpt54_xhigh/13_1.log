+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+BROWN = 9
+
+SEED_COLORS = (BLUE, RED, GREEN, YELLOW, MAGENTA, ORANGE)
+RESULT_COLORS = (BLUE, RED, GREEN, YELLOW, MAGENTA, ORANGE, CYAN, BROWN)
+ALL_SEED_PAIRS = list(combinations(SEED_COLORS, 2))
