+        arrow_count = rect_count
+
+    assignments = [set() for _ in range(rect_count)]
+    direction_cycle = list(DIRECTIONS)
+    random.shuffle(direction_cycle)
+    cycle_idx = 0
+
+    rect_order = list(range(rect_count))
+    random.shuffle(rect_order)
