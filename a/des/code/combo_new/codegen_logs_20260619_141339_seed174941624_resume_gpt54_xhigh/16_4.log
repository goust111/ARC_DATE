+    targets: list[int] = []
+    for arrow in arrows:
+        tip_r, tip_c = arrow["tip"]
+        dr, dc = DIR_VECS[str(arrow["direction"])]
+        rr, cc = int(tip_r + dr), int(tip_c + dc)
+        target = None
+        while 0 <= rr < h and 0 <= cc < w:
