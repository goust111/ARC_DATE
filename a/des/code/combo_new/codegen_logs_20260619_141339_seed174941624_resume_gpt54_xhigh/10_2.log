+        marker_cells.add((r0 + mr, c0 + mc))
+        if mc == 0 or mr == 0:
+            flip_required = False
+        elif mc == patch.shape[1] - 1 or mr == patch.shape[0] - 1:
+            flip_required = True
+        else:
+            raise ValueError("marker must sit on the template boundary")
