+    fragments = []
+    seen = np.zeros_like(colored, dtype=bool)
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            if not colored[r, c] or seen[r, c]:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if (
+                        0 <= nr < h
+                        and 0 <= nc < w
+                        and colored[nr, nc]
+                        and not seen[nr, nc]
+                        and int(grid[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
