+        out[frag_coords[:, 0], frag_coords[:, 1]] = BG
+        hole_cells = item["hole_global"]
+        out[hole_cells[:, 0], hole_cells[:, 1]] = int(item["fragment_color"])
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = np.random.default_rng(int(RNG.integers(0, 1 << 32)))
