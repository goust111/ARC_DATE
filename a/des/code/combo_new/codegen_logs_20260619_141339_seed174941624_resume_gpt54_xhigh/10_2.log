+    templates = []
+    marker_cells: set[tuple[int, int]] = set()
+    for comp in _components(grid == template_color):
+        r0 = int(comp[:, 0].min())
+        c0 = int(comp[:, 1].min())
+        r1 = int(comp[:, 0].max())
+        c1 = int(comp[:, 1].max())
