+        tr, tc = template_pos
+        fr, fc = fragment_pos
+        hole_local = np.argwhere(hole_full)
+        frag_local = np.argwhere(fragment_mask)
+        placements.append(
+            {
+                "hole_global": hole_local + np.array([tr, tc]),
+                "fragment_coords": frag_local + np.array([fr, fc]),
+                "fragment_color": int(fragment_colors[i]),
+            }
+        )
