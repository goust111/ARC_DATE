+    fragments = []
+    seen = np.zeros_like(colored, dtype=bool)
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            if not colored[r, c] or seen[r, c]:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
