+        tight, _ = _tight_mask(coords)
+        if tight.shape[1] < 2:
+            continue
+        if int(tight.sum()) < 4 or int(tight.sum()) == tight.size:
+            continue
+        if np.array_equal(tight, np.fliplr(tight)):
+            continue
+        if _has_enclosed_bg(tight):
+            continue
+        return tight
