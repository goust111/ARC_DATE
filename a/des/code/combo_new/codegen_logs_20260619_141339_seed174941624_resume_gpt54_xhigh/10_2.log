+
+def _has_enclosed_bg(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    zeros = ~mask
+    seen = np.zeros_like(mask, dtype=bool)
+    stack = []
+    for r in range(h):
+        for c in (0, w - 1):
+            if zeros[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if zeros[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    while stack:
+        rr, cc = stack.pop()
+        for dr, dc in DIR4:
+            nr, nc = rr + dr, cc + dc
+            if 0 <= nr < h and 0 <= nc < w and zeros[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                stack.append((nr, nc))
+    return bool(np.any(zeros & ~seen))
