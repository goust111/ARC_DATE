+    out = np.full_like(g, bg)
+    out[start_pos] = start_color
+
+    r, c = start_pos
+    for color, length in sequence:
+        dr, dc = dir_by_color[color]
+        for _ in range(length):
+            r += dr
+            c += dc
+            assert 0 <= r < h and 0 <= c < w, "decoded path must stay within the grid"
+            out[r, c] = color
+
+    out[start_pos] = start_color
+    return out
