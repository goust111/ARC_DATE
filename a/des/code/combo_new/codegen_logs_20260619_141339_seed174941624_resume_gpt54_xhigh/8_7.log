+def _build_posts(
+    rng: np.random.Generator,
+    colors: list[int],
+    dirs: list[tuple[int, int]],
+    path_cells: set[tuple[int, int]],
+) -> dict[int, tuple[int, int]]:
+    posts: dict[int, tuple[int, int]] = {}
