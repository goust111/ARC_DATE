+    grid[bottom, left : right + 1] = color
+    grid[top : bottom + 1, left] = color
+    grid[top : bottom + 1, right] = color
+
+
+def _expected_output(
+    shape: tuple[int, int],
+    start_pos: tuple[int, int],
+    colors: list[int],
+    sizes: list[int],
+    dirs: list[tuple[int, int]],
+) -> np.ndarray:
