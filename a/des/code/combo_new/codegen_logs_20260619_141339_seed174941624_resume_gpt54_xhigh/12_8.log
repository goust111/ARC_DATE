+    row_hi = r1 - fh - PLACEMENT_MARGIN + 1
+    col_lo = c0 + PLACEMENT_MARGIN
+    col_hi = c1 - fw - PLACEMENT_MARGIN + 1
+    if row_lo > row_hi or col_lo > col_hi:
+        return None
+
+    rows = list(range(row_lo, row_hi + 1))
+    cols = list(range(col_lo, col_hi + 1))
+    rng.shuffle(rows)
+    rng.shuffle(cols)
+    for row in rows:
+        for col in cols:
