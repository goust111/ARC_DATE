+import random
+from typing import Dict, List, Optional, Tuple
+
+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+
+RECTANGLE_COLORS = (1, 2, 3, 8, 9)
+SIDE_NAMES = ("top", "bottom", "left", "right")
+
+GEN_RETRIES = 400
+PAIR_COUNT = 2
+PAIR_GAP = 2
+PLACEMENT_MARGIN = 1
+BACK_SIZE_RANGE = (5, 8)
+PROTRUSION_RANGE = (2, 4)
+MAX_OVERLAP_THICKNESS = 3
+EXTRA_RECT_PROBABILITY = 0.55
+EXTRA_RECT_SIZE_RANGE = (3, 6)
