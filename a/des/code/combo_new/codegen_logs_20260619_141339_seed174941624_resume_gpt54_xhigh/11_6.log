+    return {
+        "direction": spec["direction"],
+        "color": spec["color"],
+        "distance": spec["distance"],
+        "marker_sides": spec["marker_sides"],
+        "arrow_cells": coords,
+        "marker_cells": markers,
+        "final_cells": final_cells,
