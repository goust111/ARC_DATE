+
+def _gen_attempt() -> np.ndarray | None:
+    rng = np.random.default_rng()
+    h = int(rng.integers(MIN_GRID, MAX_GRID + 1))
+    w = int(rng.integers(MIN_GRID, MAX_GRID + 1))
+
