+def _local_output_list(seq: list[int], color: int, orientation: str) -> list[tuple[int, int]]:
+    length = len(seq)
+    positions = _bridge_line(color, orientation, length)
+    if all(int(v) == int(color) for v in seq):
+        return list(positions)
