+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate valid input after {MAX_GEN_ATTEMPTS} attempts")

