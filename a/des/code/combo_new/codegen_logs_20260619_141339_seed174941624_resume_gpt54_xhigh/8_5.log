+        orientation = "h"
+    elif len(cols) == 1:
+        c = int(cols[0])
+        r0 = int(rows.min())
+        r1 = int(rows.max())
+        positions = [(r, c) for r in range(r0, r1 + 1)]
+        seq = [int(grid[r, c]) for r in range(r0, r1 + 1)]
