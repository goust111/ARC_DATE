+    return {(r + dr, c + dc) for r, c in points}
+
+
+def _shift_colored(points: dict[tuple[int, int], int], dr: int, dc: int) -> dict[tuple[int, int], int]:
+    return {(r + dr, c + dc): int(v) for (r, c), v in points.items()}
