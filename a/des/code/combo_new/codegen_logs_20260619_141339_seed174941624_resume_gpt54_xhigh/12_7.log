    available_static_colors = [c for c in ALL_COLORS if c != bg and c not in side_colors]
    num_static_colors = rng.randint(0, min(STATIC_COLOR_MAX, len(available_static_colors)))

    if num_static > 0 and num_static_colors == 0:
        num_static = 0
