+def _ray_end(g: np.ndarray, r: int, c: int, dr: int, dc: int, color: int) -> tuple[int, int]:
+    h, w = g.shape
+    rr, cc = int(r), int(c)
+    while 0 <= rr + dr < h and 0 <= cc + dc < w and int(g[rr + dr, cc + dc]) == int(color):
