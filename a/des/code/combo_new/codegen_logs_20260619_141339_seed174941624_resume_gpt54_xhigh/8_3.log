+
+def _max_gap_for_direction(box: tuple[int, int, int, int], h: int, w: int, direction: str) -> int:
+    r0, c0, r1, c1 = box
+    if direction == "down":
+        margin = r0
+    elif direction == "up":
+        margin = h - 1 - r1
+    elif direction == "right":
+        margin = c0
+    else:
+        margin = w - 1 - c1
+    return int(margin - 2)
