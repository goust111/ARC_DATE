+        wall = (int(axis), int(c0))
+    else:
+        cells = [(int(axis), int(c)) for c in range(c1 + 1, c1 + gap + 1)]
+        wall = (int(axis), int(c1))
+    return all(int(grid[r, c]) == BG for r, c in cells) and int(grid[wall]) == FRAME
