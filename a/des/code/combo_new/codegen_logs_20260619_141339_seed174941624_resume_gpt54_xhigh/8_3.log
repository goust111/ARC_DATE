+    for c in range(c0, c1 + 1):
+        pts.add((int(r0), int(c)))
+        pts.add((int(r1), int(c)))
+    for r in range(r0 + 1, r1):
+        pts.add((int(r), int(c0)))
+        pts.add((int(r), int(c1)))
+    return pts
