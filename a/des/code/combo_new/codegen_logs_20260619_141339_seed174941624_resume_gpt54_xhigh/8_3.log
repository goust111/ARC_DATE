+        front = (int(end_r + 1), int(axis))
+    elif direction == "up":
+        start_r = r1 + gap + 1
+        end_r = start_r + length - 1
+        shaft = [(int(r), int(axis)) for r in range(start_r, end_r + 1)]
+        head = [(int(start_r - 1), int(axis - 1)), (int(start_r - 1), int(axis + 1))]
+        front = (int(start_r - 1), int(axis))
