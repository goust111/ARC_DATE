+def _safe_directions(quadrant: str) -> list[str]:
+    if quadrant == "TL":
+        return ["down", "right"]
+    if quadrant == "TR":
+        return ["down", "left"]
+    if quadrant == "BL":
+        return ["up", "right"]
+    return ["up", "left"]
