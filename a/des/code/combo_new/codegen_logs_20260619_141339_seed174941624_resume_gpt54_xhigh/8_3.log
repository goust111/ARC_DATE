+    direction: str,
+    axis: int,
+    gap: int,
+) -> bool:
+    r0, c0, r1, c1 = box
+    if direction == "down":
+        cells = [(int(r), int(axis)) for r in range(r0 - gap, r0)]
+        wall = (int(r0), int(axis))
+    elif direction == "up":
+        cells = [(int(r), int(axis)) for r in range(r1 + 1, r1 + gap + 1)]
+        wall = (int(r1), int(axis))
+    elif direction == "right":
