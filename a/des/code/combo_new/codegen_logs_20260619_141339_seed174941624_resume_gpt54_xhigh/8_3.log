+        for comp in _components(grid == int(color), connectivity=4):
+            rows = [r for r, _ in comp]
+            cols = [c for _, c in comp]
+            r0, c0, r1, c1 = min(rows), min(cols), max(rows), max(cols)
+            if r1 - r0 < 2 or c1 - c0 < 2:
+                continue
+            border = _rect_border((r0, c0, r1, c1))
+            pts = set(comp)
+            if pts != border:
