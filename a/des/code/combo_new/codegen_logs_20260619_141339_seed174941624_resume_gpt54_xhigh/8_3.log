+    layers_by_frame: dict[int, list[tuple[int, int, int]]] = defaultdict(list)
+    for arrow in arrows:
+        layers_by_frame[int(arrow["frame_idx"])].append((int(arrow["gap"]), int(arrow["color"]), int(arrow["length"])))
