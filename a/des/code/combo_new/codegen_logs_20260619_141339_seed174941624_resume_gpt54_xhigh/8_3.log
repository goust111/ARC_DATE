+    for r, c in arrow_cells:
+        for dr, dc in DIR8:
+            nr, nc = int(r + dr), int(c + dc)
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if (nr, nc) in arrow_occupied:
