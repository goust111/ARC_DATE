+def _trace_target(
+    grid: np.ndarray,
+    bg: int,
+    border_to_frame: dict[tuple[int, int], int],
+    front: tuple[int, int],
+    direction: tuple[int, int],
+) -> tuple[int, int] | None:
+    h, w = grid.shape
+    dr, dc = direction
+    r, c = front
+    gap = 0
+    while 0 <= r < h and 0 <= c < w:
+        if (int(r), int(c)) in border_to_frame:
+            return border_to_frame[(int(r), int(c))], int(gap)
+        if int(grid[r, c]) != int(bg):
+            return None
+        gap += 1
+        r += dr
+        c += dc
+    return None
+
