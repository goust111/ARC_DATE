+                    "cells": pts,
+                }
+            )
+        left = shaft | {(int(row - 1), int(cols[0] - 1)), (int(row + 1), int(cols[0] - 1))}
+        if left == pts:
+            matches.append(
+                {
+                    "direction": (0, -1),
+                    "length": len(shaft),
