+def _room_boundary(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    for c in range(c0 - 1, c1 + 2):
+        cells.append((r0 - 1, c))
+        cells.append((r1 + 1, c))
+    for r in range(r0, r1 + 1):
+        cells.append((r, c0 - 1))
+        cells.append((r, c1 + 1))
+    return cells
