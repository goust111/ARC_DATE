+def _paint_signal(
+    out: np.ndarray,
+    g: np.ndarray,
+    source: tuple[int, int, int, tuple[int, int]],
+    mapping: dict[int, int],
+    row_lenses: dict[int, int],
+    col_lenses: dict[int, int],
+) -> None:
+    h, w = g.shape
