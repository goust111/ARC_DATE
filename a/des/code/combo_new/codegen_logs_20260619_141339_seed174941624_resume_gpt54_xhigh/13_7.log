+            assert len(maroons) == 1, f"every source must touch exactly one maroon indicator, got {len(maroons)} at {(r, c)}"
+            ir, ic = maroons[0]
+            direction = (r - ir, c - ic)
+            assert direction in DIRS
+            sources.append((r, c, color, direction))
