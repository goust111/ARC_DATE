+    color_c0 = obj["c0"]
+    color_r1 = obj["r1"]
+    color_c1 = obj["c1"]
+    hr0 = color_r0 + obj["hr0"]
+    hr1 = color_r0 + obj["hr1"]
+    hc0 = color_c0 + obj["hc0"]
+    hc1 = color_c0 + obj["hc1"]
+    hole_h = obj["hole_h"]
+    hole_w = obj["hole_w"]
