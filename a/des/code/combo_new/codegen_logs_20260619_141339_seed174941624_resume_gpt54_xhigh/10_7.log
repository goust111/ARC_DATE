+OBJECT_COUNT_RANGE = (1, 4)
+HOLE_SIZE_RANGE = (1, 4)
+OPPOSITE_GAP_RANGE = (2, 4)
+ORTHOGONAL_GAP_RANGE = (2, 4)
+SCENE_ATTEMPTS = 300
+OBJECT_ATTEMPTS = 80
