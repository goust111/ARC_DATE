+                "down": bottom_gap,
+                "left": left_gap,
+                "right": right_gap,
+            }
+            min_gap = min(gap_map.values())
+            directions = [name for name, gap in gap_map.items() if gap == min_gap]
+            if len(directions) != 1:
+                raise ValueError("hole direction must be unique")
