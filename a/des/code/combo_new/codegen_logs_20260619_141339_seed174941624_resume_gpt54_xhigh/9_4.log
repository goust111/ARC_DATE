CORE_H_MIN = 3
CORE_H_MAX = 7
CORE_W_MIN = 3
CORE_W_MAX = 9
DEFECT_COUNT_MIN = 1
DEFECT_COUNT_MAX = 3
DEFECT_SIDES = ("top", "bottom", "left", "right")
DEFECT_TYPES = ("missing", "protrusion")
PANEL_MARGIN = 1
OBJECT_GAP = 2
MAX_PLACE_TRIES = 30

# Generation retry budget.
