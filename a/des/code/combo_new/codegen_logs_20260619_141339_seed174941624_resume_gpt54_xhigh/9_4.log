+    assert len(missing) == 1, "frame border must contain exactly one gap"
+
+    gap_r, gap_c = next(iter(missing))
+    assert (gap_r, gap_c) not in {
+        (0, 0),
+        (0, width - 1),
+        (height - 1, 0),
+        (height - 1, width - 1),
