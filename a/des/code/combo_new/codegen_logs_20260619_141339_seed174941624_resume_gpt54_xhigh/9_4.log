+        assert rows == [mid - 1, mid, mid + 1]
+        assert (mid, w - 2) in pts
+
+
+def _analyze_frame(
+    grid: np.ndarray,
+    coords: list[tuple[int, int]],
+    bg: int,
+) -> tuple[int, int, int, int, str, tuple[int, int]]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
