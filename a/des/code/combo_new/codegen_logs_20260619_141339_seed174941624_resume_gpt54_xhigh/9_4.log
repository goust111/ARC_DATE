+            r0 = random.randint(INNER_MARGIN, h - INNER_MARGIN - fh)
+            c0 = random.randint(INNER_MARGIN, w - INNER_MARGIN - fw)
+            box = (r0, c0, r0 + fh - 1, c0 + fw - 1)
