+        rs = slice(row_lines[r] + 1, row_lines[r + 1])
+        for c in range(patterns.shape[1]):
+            cs = slice(col_lines[c] + 1, col_lines[c + 1])
+            block = grid[rs, cs]
+            block[patterns[r, c]] = pattern_color
