+def _render_patterns(
+    shape: tuple[int, int],
+    row_lines: list[int],
+    col_lines: list[int],
+    bg_color: int,
+    line_color: int,
+    pattern_color: int,
+    patterns: np.ndarray,
+) -> np.ndarray:
