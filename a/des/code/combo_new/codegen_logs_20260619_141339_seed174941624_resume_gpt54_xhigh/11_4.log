+def _line_indices_1d(arr: np.ndarray, color: int, axis: int) -> list[int]:
+    if axis == 0:
+        return [idx for idx in range(arr.shape[0]) if np.all(arr[idx, :] == color)]
+    return [idx for idx in range(arr.shape[1]) if np.all(arr[:, idx] == color)]
