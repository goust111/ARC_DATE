+
+def _regular_step(indices: list[int]) -> int | None:
+    if len(indices) < 2:
+        return None
+    step = indices[1] - indices[0]
+    if step <= 1:
+        return None
+    for i in range(2, len(indices)):
+        if indices[i] - indices[i - 1] != step:
+            return None
+    return step
