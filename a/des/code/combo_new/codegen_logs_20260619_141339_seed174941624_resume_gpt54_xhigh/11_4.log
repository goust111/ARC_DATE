+import random
+from typing import Iterable
+
+import numpy as np
+
+
+_NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+_BG_COLOR = 0
+_LINE_COLOR = 9
+_PATTERN_COLOR = 4
+
+_CELL_SIZE_CHOICES = (3, 4)
+_MODE_CHOICES = ("simple", "chain", "future", "both")
+_GEN_RETRIES = 400
