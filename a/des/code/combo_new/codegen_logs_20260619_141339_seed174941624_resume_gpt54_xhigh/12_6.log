+        return mask
+    raise RuntimeError("failed to sample a valid object mask")
+
+
+def _arrow_relative_cells(mask: np.ndarray, axis: str, side: str) -> list[tuple[int, int]] | None:
+    h, w = mask.shape
+    occupied = np.argwhere(mask)
+    rows = occupied[:, 0]
+    cols = occupied[:, 1]
+
