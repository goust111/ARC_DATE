+        anchors = [r for r in range(1, h - 1) if mask[r, edge_col]]
+        if not anchors:
+            return None
+        anchor = random.choice(anchors)
+        if side == "left":
+            return [(anchor, w + 1), (anchor - 1, w), (anchor + 1, w)]
+        return [(anchor, -2), (anchor - 1, -1), (anchor + 1, -1)]
