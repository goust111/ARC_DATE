   292	def main(grid: np.ndarray) -> np.ndarray:
   293	    """
   294	    Settle each quadrant's colored objects toward a local gravity edge encoded by a small maroon bar.
   295	
   296	    Input structure:
   297	    - The background is black.
   298	    - One full grey row and one full grey column divide the canvas into four rectangular quadrants.
   299	    - Each quadrant contains exactly one maroon 2-cell bar on one of its sides; the touched side encodes that quadrant's gravity direction.
   300	    - Each quadrant also contains several monochrome 4-connected colored objects, and those objects never use black, grey, or maroon.
   301	
   302	    Rule:
   303	    - Detect the separator row and column, then process the four quadrants independently.
   304	    - Read each maroon bar: a horizontal bar on the top or bottom means gravity up or down, while a vertical bar on the left or right means gravity left or right.
   305	    - Erase the maroon marker and slide every colored object rigidly along that direction.
   306	    - Move the frontmost object first; each object stops when one more step would leave the quadrant or collide with an already settled object.
   307	    - Keep the grey separator lines unchanged.
   308	
   309	    Key insight:
   310	    - The puzzle is four separate gravity chambers, and the small maroon corner bars are direction codes rather than movable content.
   311	    """
   312	    g = np.asarray(grid, dtype=int)
   313	    height, width = g.shape
   314	
   315	    grey_rows = [r for r in range(height) if np.all(g[r, :] == GREY)]
   316	    grey_cols = [c for c in range(width) if np.all(g[:, c] == GREY)]
   317	    assert len(grey_rows) == 1 and len(grey_cols) == 1
   318	    h_sep = grey_rows[0]
   319	    v_sep = grey_cols[0]
   320	
   321	    out = g.copy()
   322	    seen_directions: set[str] = set()
   323	    for _name, row_slice, col_slice in _quadrants(h_sep, v_sep, height, width):
   324	        region = g[row_slice, col_slice]
   325	        direction = _marker_direction(region)
   326	        seen_directions.add(direction)
   327	        settled, _infos = _settle_region(region, direction)
   328	        out[row_slice, col_slice] = settled
   329	
   330	    assert len(seen_directions) == 4
   331	    return out
