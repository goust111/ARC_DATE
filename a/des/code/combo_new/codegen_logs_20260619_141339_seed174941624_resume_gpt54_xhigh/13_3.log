   105	def _inflate(cells: tuple[tuple[int, int], ...], height: int, width: int) -> np.ndarray:
   106	    mask = np.zeros((height, width), dtype=bool)
   107	    for r, c in cells:
   108	        for dr in (-1, 0, 1):
   109	            for dc in (-1, 0, 1):
   110	                rr = r + dr
   111	                cc = c + dc
   112	                if 0 <= rr < height and 0 <= cc < width:
   113	                    mask[rr, cc] = True
