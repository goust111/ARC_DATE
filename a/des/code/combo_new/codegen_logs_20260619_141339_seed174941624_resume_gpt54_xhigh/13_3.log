   146	            c0 = int(arr[:, 1].min())
   147	            r1 = int(arr[:, 0].max())
   148	            c1 = int(arr[:, 1].max())
   149	            components.append(
   150	                {
   151	                    "color": color,
   152	                    "coords": arr,
   153	                    "bbox": (r0, c0, r1, c1),
