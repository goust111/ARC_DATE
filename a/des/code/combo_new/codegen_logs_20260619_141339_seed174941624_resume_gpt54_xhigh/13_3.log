   133	                coords.append((cr, cc))
   134	                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
   135	                    nr = cr + dr
   136	                    nc = cc + dc
   137	                    if not (0 <= nr < height and 0 <= nc < width):
   138	                        continue
