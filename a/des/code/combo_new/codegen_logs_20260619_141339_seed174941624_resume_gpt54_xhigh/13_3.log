+
+def _inflate(cells: tuple[tuple[int, int], ...], height: int, width: int) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    for r, c in cells:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
