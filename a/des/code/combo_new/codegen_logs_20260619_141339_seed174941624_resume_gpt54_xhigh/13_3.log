+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAROON = 9
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7, 8)
+DIRECTIONS = ("up", "down", "left", "right")
+DIR_STEPS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
