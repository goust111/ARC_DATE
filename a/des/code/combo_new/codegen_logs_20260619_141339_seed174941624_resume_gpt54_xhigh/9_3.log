+    col_axes = [c for c in range(g.shape[1]) if np.all(g[:, c] == RED)]
+    assert len(row_axes) + len(col_axes) == 1, "expected exactly one full red mirror axis"
+    if row_axes:
+        return ("row", int(row_axes[0]))
+    return ("col", int(col_axes[0]))
