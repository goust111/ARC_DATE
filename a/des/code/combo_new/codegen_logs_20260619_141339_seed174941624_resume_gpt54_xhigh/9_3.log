+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+WALL = 5
+COLOR_POOL = (1, 3, 4, 6, 7, 8, 9)
+
+GEN_RETRIES = 400
+SYSTEM_RETRIES = 160
