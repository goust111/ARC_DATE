+def _walk_to_terminal(grid: np.ndarray, start: tuple[int, int], step: tuple[int, int]) -> tuple[int, int]:
+    r, c = start
+    dr, dc = step
+    while _is_passable(grid, r + dr, c + dc):
+        r += dr
+        c += dc
+    return (int(r), int(c))
