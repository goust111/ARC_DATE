+    min_width = 2 + sum(widths) + sum(mold_gaps) + 2
+    if min_width > 30:
+        return None
+    width = rng.randint(max(16, min_width), 30)
+
+    bar_gaps = [rng.randint(1, 2) for _ in range(count - 1)]
+    upper_needed = max(heights) + 2
+    lower_needed = count + sum(bar_gaps) + 2
+    feasible_heights = [
