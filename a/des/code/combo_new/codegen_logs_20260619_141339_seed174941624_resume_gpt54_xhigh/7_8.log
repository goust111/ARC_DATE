+            q = deque([(r, c)])
+            labels[r, c] = cid
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in neigh(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and labels[nr, nc] == -1:
