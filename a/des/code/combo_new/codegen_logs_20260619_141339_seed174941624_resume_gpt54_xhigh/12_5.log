+            cols = [p[1] for p in pts]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for pr, pc in pts:
+                mask[pr - r0, pc - c0] = True
+            comps.append(
+                {
+                    "color": color,
+                    "coords": pts,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                }
