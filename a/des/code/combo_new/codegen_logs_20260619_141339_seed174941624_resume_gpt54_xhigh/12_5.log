+def _shape_to_mask(shape: tuple[tuple[int, int], ...]) -> np.ndarray:
+    h, w = _shape_dims(shape)
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in shape:
+        mask[r, c] = True
+    return mask
