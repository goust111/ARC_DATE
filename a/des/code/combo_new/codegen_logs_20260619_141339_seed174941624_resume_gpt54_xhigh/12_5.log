+
+    objects = []
+    templates = []
+    for comp in comps:
+        holes = _hole_components(comp["mask"])
+        if len(holes) == 1:
+            objects.append(
+                {
+                    "color": comp["color"],
+                    "hole_coords": [(comp["bbox"][0] + r, comp["bbox"][1] + c) for r, c in holes[0]],
+                    "hole_shape": _normalize_shape(holes[0]),
