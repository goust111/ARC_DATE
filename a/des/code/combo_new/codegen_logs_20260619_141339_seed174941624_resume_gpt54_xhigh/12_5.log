+
+def _normalize_shape(coords) -> tuple[tuple[int, int], ...]:
+    pts = [(int(r), int(c)) for r, c in coords]
+    min_r = min(r for r, _ in pts)
+    min_c = min(c for _, c in pts)
+    return tuple(sorted((r - min_r, c - min_c) for r, c in pts))
