+        _paint_patch(output, patch, r0, c0, BG)
+        _mark_bbox(occ, r0, c0, ph, pw, PLACEMENT_PAD)
+        placements.append(
+            {
+                "index": idx,
+                "r0": r0,
+                "c0": c0,
+            }
+        )
+    return placements
+
+
+def _place_templates(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    template_specs: list[dict],
+    rng: random.Random,
