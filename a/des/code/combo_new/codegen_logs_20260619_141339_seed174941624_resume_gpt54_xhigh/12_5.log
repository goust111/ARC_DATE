+BG = 0
+GRID_H_RANGE = (22, 30)
+GRID_W_RANGE = (22, 30)
+OBJECT_COUNT_RANGE = (2, 4)
+EDGE_SIDES = ("top", "bottom", "left", "right")
+OBJECT_EDGE_MARGIN = 3
+PLACEMENT_PAD = 1
+MAX_SHAPE_ATTEMPTS = 80
+MAX_GEN_ATTEMPTS = 400
