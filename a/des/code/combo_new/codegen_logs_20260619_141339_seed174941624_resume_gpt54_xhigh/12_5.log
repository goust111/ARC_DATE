+    for obj in objects:
+        key = _canonical_rotation_key(obj["hole_shape"])
+        assert key in template_by_shape, "every hole must match a template"
+        fill_color = int(template_by_shape[key]["color"])
+        for r, c in obj["hole_coords"]:
+            out[r, c] = fill_color
