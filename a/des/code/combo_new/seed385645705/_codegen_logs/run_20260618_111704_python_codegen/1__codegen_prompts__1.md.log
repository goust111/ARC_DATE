    for dr, dc in offsets:
        dst_r0 = max(0, -dr)
        dst_r1 = min(H, H - dr)
        dst_c0 = max(0, -dc)
        dst_c1 = min(W, W - dc)
        out[dst_r0:dst_r1, dst_c0:dst_c1] |= mask[
            dst_r0 + dr:dst_r1 + dr,
            dst_c0 + dc:dst_c1 + dc,
        ]
    return out


