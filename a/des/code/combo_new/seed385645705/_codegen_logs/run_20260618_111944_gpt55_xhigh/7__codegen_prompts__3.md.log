+def _bbox(cells: set[tuple[int, int]] | list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _c in cells]
+    cs = [c for _r, c in cells]
+    return min(rs), min(cs), max(rs), max(cs)
