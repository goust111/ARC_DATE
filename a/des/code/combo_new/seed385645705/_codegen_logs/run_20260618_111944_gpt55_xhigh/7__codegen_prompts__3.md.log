+    for _ in range(random.randrange(4)):
+        cells = {(c, h - 1 - r) for r, c in cells}
+        ar, ac = ac, h - 1 - ar
+        h, w = w, h
+    if random.random() < 0.5:
+        cells = {(r, w - 1 - c) for r, c in cells}
+        ac = w - 1 - ac
+    if random.random() < 0.5:
+        cells = {(h - 1 - r, c) for r, c in cells}
+        ar = h - 1 - ar
+    return _normalize(cells, (ar, ac))
