+    except (AssertionError, ValueError):
+        return None
+    if built is None:
+        return None
+    inp, expected = built
+    if max(inp.shape) > 30 or max(expected.shape) > 30:
+        return None
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
