+def _add_ring(mask: np.ndarray, r: int, c: int) -> None:
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            mask[int(r + dr), int(c + dc)] = True
+
+
+def _connected(mask: np.ndarray) -> bool:
+    comps = _components_mask(mask)
+    return len(comps) == 1
+
+
+def _base_zero_hole_shape() -> np.ndarray:
+    for _ in range(100):
