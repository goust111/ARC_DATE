+    except AssertionError:
+        return None
+    if out.ndim != 2 or max(out.shape) > ARC_MAX:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
