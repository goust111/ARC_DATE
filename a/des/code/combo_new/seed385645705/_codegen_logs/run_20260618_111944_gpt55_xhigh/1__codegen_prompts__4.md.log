+def _gen_attempt() -> np.ndarray | None:
+    bg = random.choice([0, 1, 2, 3, 7])
+    count = random.choice([3, 4, 5])
+    hole_counts = [0] + random.sample([1, 2, 3, 4], count - 1)
+    items = [{"holes": int(k), "mask": _shape_for_holes(int(k))} for k in hole_counts]
