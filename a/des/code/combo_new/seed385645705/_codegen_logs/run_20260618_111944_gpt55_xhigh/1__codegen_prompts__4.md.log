+    items = [{"holes": int(k), "mask": _shape_for_holes(int(k))} for k in hole_counts]
+
+    colors = [c for c in range(10) if c not in {int(bg), GREY, MAROON}]
+    if len(colors) < count:
+        return None
+    for item, color in zip(items, random.sample(colors, count)):
