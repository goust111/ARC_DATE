+            c0 = random.randint(0, width - mw)
+            if not _can_place(mask, occupied, r0, c0):
+                continue
+            pts = np.argwhere(mask)
+            for rr, cc in pts:
+                r, c = int(r0 + rr), int(c0 + cc)
+                grid[r, c] = int(item["color"])
+                occupied[r, c] = True
+            placed = True
+            break
+        if not placed:
+            return False
+    return True
+
