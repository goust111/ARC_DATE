+def _anchors_below(g: np.ndarray, sep_r: int, bg: int, n: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    colors: set[int] = set()
+    for r in range(int(sep_r) + 1, int(g.shape[0])):
+        for c in range(int(g.shape[1])):
+            v = int(g[r, c])
+            if v != int(bg):
+                coords.append((int(r), int(c)))
+                colors.add(v)
