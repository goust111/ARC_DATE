+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+ARC_MAX = 30
+GREY = 5
+MAROON = 9
+GEN_RETRIES = 400
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _most_common_color(g: np.ndarray) -> int:
+    return int(Counter(map(int, g.ravel())).most_common(1)[0][0])
+
