+def _paint_mask(grid: np.ndarray, mask: np.ndarray, color: int, r0: int, c0: int) -> None:
+    h, w = mask.shape
+    patch = grid[r0 : r0 + h, c0 : c0 + w]
+    assert not np.any(patch[mask] != BG)
+    patch[mask] = color
