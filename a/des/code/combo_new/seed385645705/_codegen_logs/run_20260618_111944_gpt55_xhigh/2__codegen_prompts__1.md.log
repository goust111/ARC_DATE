+GEN_ATTEMPTS = 500
+TEMPLATE_COUNTS = [3, 4, 5]
+TEMPLATE_SIZES = [3, 4, 5]
+SCALES = [2, 3, 4]
+BAND_SIDES = ["top", "right", "bottom", "left"]
+MIN_GAP = 1
+_RNG = np.random.default_rng()
