+def _draw_frame(grid: np.ndarray, r0: int, c0: int, size: int) -> None:
+    grid[r0, c0 : c0 + size] = FRAME
+    grid[r0 + size - 1, c0 : c0 + size] = FRAME
+    grid[r0 : r0 + size, c0] = FRAME
+    grid[r0 : r0 + size, c0 + size - 1] = FRAME
