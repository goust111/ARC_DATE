+        nr, nc = choices[_rng_int(0, len(choices) - 1)]
+        out[nr, nc] = True
+    return out
+
+
+def _fallback_mask(size: int, area: int) -> np.ndarray:
+    mask = np.zeros((size, size), dtype=bool)
+    r = _rng_int(0, size - 1)
+    c = _rng_int(0, size - 1)
