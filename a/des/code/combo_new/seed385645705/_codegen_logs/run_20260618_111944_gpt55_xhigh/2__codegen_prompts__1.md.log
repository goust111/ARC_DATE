+    rot_k = _rotation_from_seeds(seed_coords, interior.shape)
+    rotated = np.rot90(template, rot_k)
+    scaled = _scaled_mask(rotated, interior.shape)
+
+    out = g.copy()
+    target = out[r0 + 1 : r1, c0 + 1 : c1]
+    target[:, :] = BG
+    target[scaled] = color
+    return out
