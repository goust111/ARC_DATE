+        h, w = mask.shape
+        candidates = [
+            (r, c)
+            for r in range(1, rect_h - h)
+            for c in range(1, rect_w - w)
+            if _can_place_with_padding(occ, r, c, h, w)
+        ]
+        if not candidates:
+            return None
+        r0, c0 = random.choice(candidates)
