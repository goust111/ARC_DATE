+            if seen[sr, sc] or int(grid[sr, sc]) == BG:
+                continue
+            q = deque([(sr, sc)])
+            seen[sr, sc] = True
+            pts = []
+            while q:
+                r, c = q.popleft()
+                pts.append((r, c))
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) != BG:
