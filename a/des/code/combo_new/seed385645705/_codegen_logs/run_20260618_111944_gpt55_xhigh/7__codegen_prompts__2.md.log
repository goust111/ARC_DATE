+    min_r = min(r for r, _c in coords)
+    min_c = min(c for _r, c in coords)
+    norm = [(r - min_r, c - min_c) for r, c in coords]
+    height = max(r for r, _c in norm) + 1
+    width = max(c for _r, c in norm) + 1
+    pattern = np.full((height, width), -1, dtype=int)
+    for r, c in norm:
+        pattern[r, c] = color
+    return pattern
