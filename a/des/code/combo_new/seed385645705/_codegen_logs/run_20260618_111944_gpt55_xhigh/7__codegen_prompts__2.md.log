+
+def _nonempty_coords(pattern: np.ndarray) -> np.ndarray:
+    return np.argwhere(pattern >= 0)
+
+
+def _can_place(grid: np.ndarray, pattern: np.ndarray, row: int, col: int, bg: int) -> bool:
+    h, w = grid.shape
+    ph, pw = pattern.shape
