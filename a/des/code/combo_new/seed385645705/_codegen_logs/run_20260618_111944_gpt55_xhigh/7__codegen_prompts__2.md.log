+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": len(coords),
+                }
+            )
+    return by_color
+
+
+def _row_to_cols(coords: list[tuple[int, int]]) -> dict[int, list[int]]:
+    out: dict[int, list[int]] = {}
+    for r, c in coords:
+        out.setdefault(r, []).append(c)
+    for cols in out.values():
+        cols.sort()
+    return out
+
