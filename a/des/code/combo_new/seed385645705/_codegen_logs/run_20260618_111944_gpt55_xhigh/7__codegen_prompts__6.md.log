+            continue
+        center_r = random.randint(row_span[0], row_span[1])
+        center_c = random.randint(col_span[0], col_span[1])
+        r0 = center_r - (rh - 1) // 2
+        c0 = center_c - (rw - 1) // 2
+        r1 = r0 + rh - 1
+        c1 = c0 + rw - 1
