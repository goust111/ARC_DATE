+        assert 1 <= width <= 4, f"horizontal stripe width out of range: {width}"
+        stripes.append((start, prev, width, color))
+        start = prev = row
+        color = row_color
+
+    width = prev - start + 1
+    assert 1 <= width <= 4, f"horizontal stripe width out of range: {width}"
+    stripes.append((start, prev, width, color))
+    return stripes
