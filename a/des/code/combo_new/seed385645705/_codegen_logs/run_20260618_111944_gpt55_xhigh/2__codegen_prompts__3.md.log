+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+STRIPE_WIDTHS = (1, 2, 3, 4)
+MIN_GAP = 1
+MAX_ATTEMPTS = 300
+
