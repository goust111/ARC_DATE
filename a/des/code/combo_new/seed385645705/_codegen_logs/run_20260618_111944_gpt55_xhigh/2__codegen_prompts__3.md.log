+    for col in map(int, cols[1:]):
+        col_color = int(col_colors[col])
+        if col == prev + 1 and col_color == color:
+            prev = col
+            continue
+        width = prev - start + 1
+        assert 1 <= width <= 4, f"vertical stripe width out of range: {width}"
+        stripes.append((start, prev, width, color))
+        start = prev = col
+        color = col_color
+
+    width = prev - start + 1
+    assert 1 <= width <= 4, f"vertical stripe width out of range: {width}"
+    stripes.append((start, prev, width, color))
+    return stripes
