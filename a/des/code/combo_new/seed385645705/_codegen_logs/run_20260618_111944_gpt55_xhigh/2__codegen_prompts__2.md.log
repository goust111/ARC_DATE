import random, numpy as np
from collections import deque
DIR4=[(1,0),(-1,0),(0,1),(0,-1)]

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0: return False
    h,w=mask.shape
    s=tuple(map(int,pts[0])); q=deque([s]); seen={s}
    while q:
        r,c=q.popleft()
        for dr,dc in DIR4:
            rr,cc=r+dr,c+dc
            if 0<=rr<h and 0<=cc<w and mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); q.append((rr,cc))
    return len(seen)==int(mask.sum())

def full(mask): return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def grow(h,w,target):
    mask=np.zeros((h,w),bool)
    r=random.randrange(h); c=random.randrange(w); mask[r,c]=1
    frontier={(rr,cc) for dr,dc in DIR4 for rr,cc in [(r+dr,c+dc)] if 0<=rr<h and 0<=cc<w}
    while mask.sum()<target and frontier:
        # weight toward boundary sometimes
        lst=list(frontier)
        if random.random()<0.5:
            weights=[1+ (rr in (0,h-1))*2 + (cc in (0,w-1))*2 for rr,cc in lst]
            cell=random.choices(lst,weights=weights,k=1)[0]
        else:
            cell=random.choice(lst)
        frontier.remove(cell)
        rr,cc=cell
        if mask[rr,cc]: continue
        mask[rr,cc]=1
        for dr,dc in DIR4:
            nr,nc=rr+dr,cc+dc
            if 0<=nr<h and 0<=nc<w and not mask[nr,nc]: frontier.add((nr,nc))
    return mask

for h,w in [(4,4),(4,5),(5,5),(6,6),(7,6),(8,7)]:
  ok=0; tries=5000
  for _ in range(tries):
    n=h*w
    target=random.randint(max(4,n//3), min(n-4,2*n//3))
    if target*2==n: target+=1 if target<n-4 else -1
    m=grow(h,w,target)
    if full(m) and full(~m) and conn(m) and conn(~m): ok+=1
  print((h,w), ok, 'rate', ok/tries)
