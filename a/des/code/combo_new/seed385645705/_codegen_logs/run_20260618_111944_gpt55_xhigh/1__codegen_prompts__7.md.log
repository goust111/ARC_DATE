+def _find_arrows(g: np.ndarray, bg: int) -> dict[tuple[int, int], str]:
+    arrows: dict[tuple[int, int], str] = {}
+    for r, c in np.argwhere(g != bg):
+        direction = _candidate_direction(g, int(r), int(c), bg)
+        if direction is not None:
