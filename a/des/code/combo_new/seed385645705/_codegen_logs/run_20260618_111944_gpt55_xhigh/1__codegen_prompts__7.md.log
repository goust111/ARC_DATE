+
+# --------------- generator ---------------
+
+GRID_MIN, GRID_MAX = 16, 30
+LATTICE_GAP = 4
+CHAIN_COUNT_RANGE = (2, 4)
+CHAIN_LENGTH_RANGE = (2, 5)
+GENERATION_RETRIES = 300
