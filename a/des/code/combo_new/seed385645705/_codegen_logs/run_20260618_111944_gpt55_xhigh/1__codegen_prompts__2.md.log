+_GEN_RETRIES = 400
+_GRID_MIN = 16
+_GRID_MAX = 30
+_FRAME_H_RANGE = (4, 8)
+_FRAME_W_RANGE = (4, 9)
+_OBJECT_COUNT_RANGE = (2, 5)
+
