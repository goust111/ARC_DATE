            pb_c0 = border_left
            pb_c1 = W - 1 - border_right
        else:
            pa_c0 = border_left
            pa_c1 = W - 1 - border_right
            pb_c0 = border_left
            pb_c1 = W - 1 - border_right - offset_cols

