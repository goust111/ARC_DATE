+        ray_dirs = ((0, -1), (0, 1))
+    else:
+        ray_dirs = ((-1, 0), (1, 0))
+
+    cells = {(int(r), int(c))}
+    for dr, dc in ray_dirs:
+        for step in range(1, k + 1):
+            cells.add((int(r + dr * step), int(c + dc * step)))
+    return cells
