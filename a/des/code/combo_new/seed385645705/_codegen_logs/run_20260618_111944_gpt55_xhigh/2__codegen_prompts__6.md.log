                            best_distance = distance
                            best_values = {value}
                        elif support == best_support and distance == best_distance:
                            best_values.add(value)

                    if len(best_values) == 1:
                        value = next(iter(best_values))
                        if axis == 0:
                            out[i, pos] = value
                        else:
                            out[pos, i] = value
                        changed = True

    return out


