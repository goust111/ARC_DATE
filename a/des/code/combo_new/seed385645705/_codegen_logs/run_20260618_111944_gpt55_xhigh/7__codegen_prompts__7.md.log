+        q: deque[tuple[int, int]] = deque([(sr, sc)])
+        seen[sr, sc] = True
+        pts: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            pts.append((r, c))
+            for nr, nc in _neighbors(r, c, connectivity):
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(np.array(pts, dtype=int))
+    return comps
