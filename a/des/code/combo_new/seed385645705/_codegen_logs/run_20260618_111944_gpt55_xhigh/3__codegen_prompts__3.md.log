+
+
+def _sample_unique_shapes(n: int) -> list[np.ndarray] | None:
+    shapes: list[np.ndarray] = []
+    keys: set[tuple[tuple[int, int], ...]] = set()
+    for _ in range(SHAPE_ATTEMPTS):
+        if len(shapes) == n:
+            return shapes
+        mask = _random_connected_mask()
+        if mask is None:
+            continue
+        key = _canonical_key(mask)
