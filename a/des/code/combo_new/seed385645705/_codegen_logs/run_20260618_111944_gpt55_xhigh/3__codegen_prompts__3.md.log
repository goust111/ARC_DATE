+def _rect_is_clear(reserved: np.ndarray, r0: int, c0: int, h: int, w: int, padding: int) -> bool:
+    H, W = reserved.shape
+    rr0 = max(0, r0 - padding)
+    cc0 = max(0, c0 - padding)
