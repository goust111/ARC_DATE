+            key = hole["key"]
+            assert key in piece_by_key, "every hole must have a matching fragment"
+            pi = piece_by_key[key]
+            assert pi not in used_pieces, "matching must be one-to-one"
+            used_pieces.add(pi)
+            match[(fi, hi)] = pieces[pi]
