+def _border_path(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    path: list[tuple[int, int]] = []
+    path.extend((r0, c) for c in range(c0, c1 + 1))
