+    for fi, frame in enumerate(frames):
+        colors = [int(match[(fi, hi)]["color"]) for hi in range(len(frame["holes"]))]
+        path = _border_path(frame["bbox"])
+        n = len(colors)
+        for i, color in enumerate(colors):
+            start = i * len(path) // n
+            end = (i + 1) * len(path) // n
+            for r, c in path[start:end]:
+                out[r, c] = color
