+
+def _cells_clear_for_mask(
+    grid: np.ndarray,
+    reserved: np.ndarray,
+    mask: np.ndarray,
+    r0: int,
+    c0: int,
+) -> bool:
+    H, W = grid.shape
+    for rr, cc in np.argwhere(mask):
+        r = r0 + int(rr)
+        c = c0 + int(cc)
+        if not (0 <= r < H and 0 <= c < W):
