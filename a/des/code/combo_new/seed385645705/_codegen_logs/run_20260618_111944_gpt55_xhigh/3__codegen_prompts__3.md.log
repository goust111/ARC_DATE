+        assert np.all(g[r1, c0 : c1 + 1] == GREY), "frame bottom edge must be grey"
+        assert np.all(g[r0 : r1 + 1, c0] == GREY), "frame left edge must be grey"
+        assert np.all(g[r0 : r1 + 1, c1] == GREY), "frame right edge must be grey"
