+# --------------- generator ---------------
+
+GRID_SIDE_RANGE = (18, 30)
+TOTAL_HOLE_RANGE = (2, 6)
+FRAME_COUNT_MAX = 3
+HOLES_PER_FRAME_MAX = 3
+FRAME_SIDE_RANGE = (5, 11)
+SHAPE_SIDE_RANGE = (2, 4)
+SHAPE_AREA_RANGE = (3, 8)
+GENERATION_ATTEMPTS = 600
+SHAPE_ATTEMPTS = 300
+FRAME_ATTEMPTS = 200
+PLACEMENT_ATTEMPTS = 200
+OBJECT_PADDING = 1
