+        seen[r0, c0] = True
+        q = deque([(r0, c0)])
+        comp: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            comp.append((r, c))
+            for rr, cc in _neighbors4(r, c, h, w):
