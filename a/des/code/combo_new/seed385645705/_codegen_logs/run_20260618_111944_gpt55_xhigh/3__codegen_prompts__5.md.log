+    for rr, cc in np.argwhere(mask):
+        r = r0 + int(rr)
+        c = c0 + int(cc)
+        g[r, c] = color
+        coords.add((r, c))
+    return coords
+
+
+def _place_objects(
+    g: np.ndarray,
+    axis_kind: str,
