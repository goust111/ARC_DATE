+                ref = int(g[rr, cc])
+                cur = int(g[r, c])
+                if ref == BLACK:
+                    if cur != BLACK:
+                        out[r, c] = MAROON
+                elif cur == BLACK:
+                    out[r, c] = ref
+                elif cur != ref:
+                    out[r, c] = MAROON
+    else:
+        cols = range(axis_index) if deficient_before else range(axis_index + 1, w)
+        for r in range(h):
+            for c in cols:
+                rr, cc = _mirror_cell(axis_kind, axis_index, r, c)
+                ref = int(g[rr, cc])
+                cur = int(g[r, c])
+                if ref == BLACK:
+                    if cur != BLACK:
