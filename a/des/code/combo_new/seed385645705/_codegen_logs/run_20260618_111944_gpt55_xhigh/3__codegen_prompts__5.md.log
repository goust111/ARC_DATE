+        after = int(np.count_nonzero(g[axis_index + 1 :, :] != BLACK))
+    else:
+        before = int(np.count_nonzero(g[:, :axis_index] != BLACK))
+        after = int(np.count_nonzero(g[:, axis_index + 1 :] != BLACK))
+    return before, after
