+        seen[sr, sc] = True
+        q: deque[tuple[int, int]] = deque([(sr, sc)])
+        comp: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            comp.append((r, c))
+            for dr, dc in ORTHO:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(comp)
