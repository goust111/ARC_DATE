+    room_dirs = list(DIRS) + [random.choice(DIRS) for _ in range(n_rooms - 4)]
+    random.shuffle(room_dirs)
+
+    rooms: list[tuple[int, int, int, int, str]] = []
+    max_room_col = w - 6
+    for direction in room_dirs:
