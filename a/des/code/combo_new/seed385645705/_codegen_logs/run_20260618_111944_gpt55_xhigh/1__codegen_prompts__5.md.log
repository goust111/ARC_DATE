from __future__ import annotations

from collections import deque
import random

import numpy as np


_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
_CORNERS = ("TL", "TR", "BL", "BR")
_EMPTY_OFFSET = {
    "TL": (0, 0),
    "TR": (0, 1),
    "BL": (1, 0),
    "BR": (1, 1),
}


def _background(g: np.ndarray) -> int:
    values, counts = np.unique(g, return_counts=True)
    return int(values[int(np.argmax(counts))])


def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    h, w = mask.shape
    seen = np.zeros(mask.shape, dtype=bool)
    comps: list[list[tuple[int, int]]] = []
    for sr, sc in np.argwhere(mask):
        sr, sc = int(sr), int(sc)
        if seen[sr, sc]:
            continue
        seen[sr, sc] = True
        q: deque[tuple[int, int]] = deque([(sr, sc)])
        comp: list[tuple[int, int]] = []
        while q:
            r, c = q.popleft()
            comp.append((r, c))
            for dr, dc in _NEIGHBORS4:
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                    seen[nr, nc] = True
                    q.append((nr, nc))
        comps.append(comp)
    return comps


def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
    rows = [r for r, _ in cells]
    cols = [c for _, c in cells]
    return min(rows), min(cols), max(rows), max(cols)


def _l_empty_corner(cells: list[tuple[int, int]]) -> str | None:
    if len(cells) != 3:
        return None
    r0, c0, r1, c1 = _bbox(cells)
    if r1 - r0 + 1 != 2 or c1 - c0 + 1 != 2:
        return None
    present = {(r - r0, c - c0) for r, c in cells}
    missing = {(0, 0), (0, 1), (1, 0), (1, 1)} - present
    if len(missing) != 1:
        return None
    empty = next(iter(missing))
    for corner, offset in _EMPTY_OFFSET.items():
        if empty == offset:
            return corner
    return None


def _frame_info(cells: list[tuple[int, int]]) -> tuple[int, int, int, int, str] | None:
    r0, c0, r1, c1 = _bbox(cells)
    if r1 - r0 + 1 < 3 or c1 - c0 + 1 < 3:
        return None

    expected = set()
    for r in range(r0, r1 + 1):
        expected.add((r, c0))
        expected.add((r, c1))
    for c in range(c0, c1 + 1):
        expected.add((r0, c))
        expected.add((r1, c))

    actual = set(cells)
    missing = expected - actual
    if actual - expected or len(missing) != 1:
        return None

    missing_cell = next(iter(missing))
    corner_by_cell = {
        (r0, c0): "TL",
        (r0, c1): "TR",
        (r1, c0): "BL",
        (r1, c1): "BR",
    }
    corner = corner_by_cell.get(missing_cell)
    if corner is None:
        return None
    return int(r0), int(c0), int(r1), int(c1), corner


