+            elif ar == r1:
+                direction = "down"
+        elif ac == bc and abs(ar - br) == 1:
+            if ac == c0:
+                direction = "left"
+            elif ac == c1:
+                direction = "right"
+        if direction is None:
+            continue
+
+        assert len(actual) == len(border) - 2, "room border must be a rectangle with exactly one two-cell gap"
+        rooms.append((int(r0), int(c0), int(r1), int(c1), direction))
