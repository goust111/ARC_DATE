        "TL": (r0, c0),
        "TR": (r0, c1 - 1),
        "BL": (r1 - 1, c0),
        "BR": (r1 - 1, c1 - 1),
    }
    or0, oc0 = origins[corner]
    empty = _EMPTY_OFFSET[corner]
    cells = []
    for dr in (0, 1):
