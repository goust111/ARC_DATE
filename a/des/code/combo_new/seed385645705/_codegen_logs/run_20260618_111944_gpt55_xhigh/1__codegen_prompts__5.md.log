+    top = random.randint(1, h - total_h - 1)
+    left = w - 4
+    r = top
+    for _, patch in patches:
+        ph, pw = patch.shape
+        grid[r : r + ph, left : left + pw] = patch
+        r += ph + 1
+    return int(top), int(left), int(top + total_h - 1), int(w - 1)
+
