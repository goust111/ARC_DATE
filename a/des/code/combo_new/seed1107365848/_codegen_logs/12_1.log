+    r1 = min(h, top + height + PLACEMENT_PADDING)
+    c0 = max(0, left - PLACEMENT_PADDING)
+    c1 = min(w, left + width + PLACEMENT_PADDING)
+    return not bool(occupied[r0:r1, c0:c1].any())
