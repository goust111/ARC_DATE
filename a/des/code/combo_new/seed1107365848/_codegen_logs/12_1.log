+    while stack:
+        rr, cc = stack.pop()
+        for nr, nc in _neighbors4(rr, cc):
+            if 0 <= nr < hh and 0 <= nc < ww and open_mask[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                stack.append((nr, nc))
