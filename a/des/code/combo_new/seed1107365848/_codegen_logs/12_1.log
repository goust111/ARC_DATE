+    hh, ww = open_mask.shape
+    outside = np.zeros((hh, ww), dtype=bool)
+    stack: list[tuple[int, int]] = []
+
+    for rr in range(hh):
+        for cc in (0, ww - 1):
+            if open_mask[rr, cc] and not outside[rr, cc]:
+                outside[rr, cc] = True
+                stack.append((rr, cc))
+    for cc in range(ww):
+        for rr in (0, hh - 1):
+            if open_mask[rr, cc] and not outside[rr, cc]:
+                outside[rr, cc] = True
+                stack.append((rr, cc))
