+        entry = {
+            "top_left": (int(r0), int(c0)),
+            "cells": set(comp),
+        }
+        if len(vals) == 1:
+            entry["is_source"] = False
+            entry["base_color"] = int(vals[0])
+            entry["pattern_color"] = None
+            entry["pattern_mask"] = np.zeros((3, 3), dtype=bool)
+        else:
