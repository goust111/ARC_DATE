0125:             orientation = mirrors.get((nr, nc))
0126:             assert orientation is not None, "red cell must belong to a mirror segment"
0127:             if orientation == "horizontal":
0128:                 dr = -dr
0129:             else:
0130:                 assert orientation == "vertical"
0131:                 dc = -dc
0132:             continue
