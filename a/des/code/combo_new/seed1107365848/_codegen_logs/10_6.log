+    used_moat: set[tuple[int, int]] = set()
+    used_rays: set[tuple[int, int]] = set()
+    records: list[dict[str, object]] = []
+
+    for length in lengths:
+        placed = _place_chain(
+            shape=(h, w),
+            length=length,
+            used_bbox=used_bbox,
+            used_moat=used_moat,
+            used_rays=used_rays,
