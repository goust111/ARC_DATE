+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        stack = [(r, c)]
+        seen[r, c] = True
+        comp: list[tuple[int, int]] = []
+        while stack:
+            cr, cc = stack.pop()
+            comp.append((cr, cc))
+            for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
