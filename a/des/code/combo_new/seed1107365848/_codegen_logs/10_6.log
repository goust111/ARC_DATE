+import random
+from typing import Optional
+
+import numpy as np
+
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+ARROW_SHAPES = {
+    "up": {
+        "head": (0, 1),
+        "tail": (2, 1),
+        "grey": {(0, 1), (1, 1), (2, 0), (2, 2)},
+    },
+    "down": {
+        "head": (2, 1),
+        "tail": (0, 1),
+        "grey": {(0, 0), (0, 2), (1, 1), (2, 1)},
+    },
+    "left": {
+        "head": (1, 0),
+        "tail": (1, 2),
+        "grey": {(0, 2), (1, 0), (1, 1), (2, 2)},
+    },
+    "right": {
+        "head": (1, 2),
+        "tail": (1, 0),
+        "grey": {(0, 0), (1, 1), (1, 2), (2, 0)},
