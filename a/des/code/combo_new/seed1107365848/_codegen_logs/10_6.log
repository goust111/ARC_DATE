+import numpy as np
+
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+ARROW_SHAPES = {
+    "up": {
+        "head": (0, 1),
+        "tail": (2, 1),
+        "grey": {(0, 1), (1, 1), (2, 0), (2, 2)},
+    },
+    "down": {
+        "head": (2, 1),
+        "tail": (0, 1),
+        "grey": {(0, 0), (0, 2), (1, 1), (2, 1)},
+    },
+    "left": {
+        "head": (1, 0),
+        "tail": (1, 2),
+        "grey": {(0, 2), (1, 0), (1, 1), (2, 2)},
+    },
+    "right": {
+        "head": (1, 2),
+        "tail": (1, 0),
+        "grey": {(0, 0), (1, 1), (1, 2), (2, 0)},
+    },
+}
+
+
+BACKGROUND = 8
+GREY = 5
+TAIL_PALETTE = (1, 2, 3, 4, 6, 7, 9)
+GRID_MIN = 16
+GRID_MAX = 29
+MAX_ATTEMPTS = 400
+CHAIN_LENGTH_MIN = 1
+CHAIN_LENGTH_MAX = 3
+TOTAL_ARROWS_MIN = 2
+TOTAL_ARROWS_MAX = 6
