+        if ok and tail_color is not None:
+            matches.append({"direction": name, "tail_color": int(tail_color)})
+
+    if len(matches) != 1:
+        return None
+    return matches[0]
+
+
+def _detect_arrows(grid: np.ndarray) -> tuple[int, int, list[dict[str, object]]]:
+    g = np.asarray(grid, dtype=int)
