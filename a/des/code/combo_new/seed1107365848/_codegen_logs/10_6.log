+def _assert_acyclic(targets: list[Optional[int]]) -> None:
+    state = [0] * len(targets)
+    for start in range(len(targets)):
+        cur = start
+        trail: list[int] = []
+        while cur is not None and state[cur] == 0:
+            state[cur] = 1
+            trail.append(cur)
+            cur = targets[cur]
+        assert cur is None or state[cur] == 2, "ray relay graph must reach the boundary"
+        for node in trail:
+            state[node] = 2
