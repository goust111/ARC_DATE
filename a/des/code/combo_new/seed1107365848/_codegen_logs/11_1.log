+        return False
+
+    expected = set()
+    for c in range(c0, c1 + 1):
+        expected.add((r0, c))
+        expected.add((r1, c))
+    for r in range(r0 + 1, r1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+
+    actual = {tuple(map(int, cell)) for cell in coords}
+    if actual != expected:
