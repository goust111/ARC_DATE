            w=sum(widths)+n_bands
            if w<=30:
                break
        else:
            return None
        h=random.randint(6,22)
        pair_count=random.randint(1, min(6, h))
        band_colors=random.sample(PALETTE, n_bands)
        g=np.zeros((h,w),dtype=int)
        exp=g.copy()
        regions=[]
        bands=[]
        c=0
        for i,width in enumerate(widths):
            regions.append((c,c+width-1))
            c+=width
            if i<n_bands:
                bands.append(c)
                g[:,c]=band_colors[i]
                exp[:,c]=band_colors[i]
                c+=1
        rows=random.sample(range(h), pair_count)
        for r in rows:
            b=random.randrange(n_bands)
            c1=random.randint(*regions[b])
            c2=random.randint(*regions[b+1])
            g[r,c1]=GREY
            g[r,c2]=GREY
            exp[r, min(c1,c2):max(c1,c2)+1]=band_colors[b]
        return g,exp
    else:
        for _ in range(100):
            heights=[random.randint(2,7) for _ in range(n_bands+1)]
            h=sum(heights)+n_bands
            if h<=30:
                break
        else:
            return None
        w=random.randint(6,22)
        pair_count=random.randint(1, min(6, w))
        band_colors=random.sample(PALETTE, n_bands)
        g=np.zeros((h,w),dtype=int)
