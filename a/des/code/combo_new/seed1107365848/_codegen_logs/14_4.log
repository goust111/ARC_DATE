from __future__ import annotations
import random
import numpy as np

BG = 0
GREY = 5
PALETTE = (1,2,3,4,6,7,8,9)


def band_rows(g):
    rows=[]
    for r in range(g.shape[0]):
        vals = np.unique(g[r])
        if len(vals)==1 and int(vals[0]) not in (BG, GREY):
            rows.append(r)
    return rows

def band_cols(g):
    cols=[]
    for c in range(g.shape[1]):
        vals = np.unique(g[:,c])
        if len(vals)==1 and int(vals[0]) not in (BG, GREY):
            cols.append(c)
    return cols

def main(grid):
    g=np.asarray(grid, dtype=int)
    out=g.copy()
    hbands=band_rows(g)
    vbands=band_cols(g)
    greys=[tuple(map(int, x)) for x in np.argwhere(g==GREY)]
    if not greys:
        return out
    nearest={}
    for p in greys:
        pr,pc=p
        cands=[]
        for q in greys:
            if q==p:
                continue
            qr,qc=q
            if pr==qr:
                between=[c for c in vbands if min(pc,qc)<c<max(pc,qc)]
                if len(between)==1:
                    cands.append((abs(pc-qc), q))
            elif pc==qc:
                between=[r for r in hbands if min(pr,qr)<r<max(pr,qr)]
                if len(between)==1:
                    cands.append((abs(pr-qr), q))
        assert cands, (p, greys, hbands, vbands)
        cands.sort(key=lambda item: (item[0], item[1][0], item[1][1]))
        bestd=cands[0][0]
        best=[q for d,q in cands if d==bestd]
        assert len(best)==1, (p,best,cands)
        nearest[p]=best[0]
    pairs=[]
    for p,q in nearest.items():
        if nearest.get(q)==p and p<q:
            pairs.append((p,q))
    assert len(pairs)*2 == len(greys), (pairs, greys, nearest)
    for (r1,c1),(r2,c2) in pairs:
        if r1==r2:
            cols=[c for c in vbands if min(c1,c2)<c<max(c1,c2)]
            assert len(cols)==1
            color=int(g[r1, cols[0]])
            out[r1, min(c1,c2):max(c1,c2)+1]=color
        else:
            rows=[r for r in hbands if min(r1,r2)<r<max(r1,r2)]
            assert len(rows)==1
            color=int(g[rows[0], c1])
            out[min(r1,r2):max(r1,r2)+1, c1]=color
    return out

def gen_attempt():
    orientation=random.choice(['v','h'])
    n_bands=random.randint(1,4)
