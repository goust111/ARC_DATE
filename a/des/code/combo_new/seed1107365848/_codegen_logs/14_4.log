+    if region_widths is None:
+        return None
+
+    height = random.randint(*OTHER_AXIS_RANGE)
+    pair_count = random.randint(2, min(PAIR_COUNT_CAP, height))
+    band_colors = random.sample(PALETTE, band_count)
+
