+            for row, _col in cells:
+                if not (0 < col < width - 1):
+                    continue
+                if not (support[row, col - 1] and support[row, col + 1]):
+                    continue
+                cc = col - 1
+                while cc >= 0 and support[row, cc]:
+                    out[row, cc] = color
+                    cc -= 1
+                cc = col + 1
+                while cc < width and support[row, cc]:
+                    out[row, cc] = color
+                    cc += 1
+
+    return out
+
