+    boundary = np.zeros_like(filled, dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not filled[r, c]:
+                continue
+            for nr, nc in _neighbors4(r, c):
+                if not (0 <= nr < h and 0 <= nc < w and filled[nr, nc]):
+                    boundary[r, c] = True
+                    break
