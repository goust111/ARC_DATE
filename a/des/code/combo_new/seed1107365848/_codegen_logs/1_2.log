def boundary(mask):
    h,w=mask.shape
    b=np.zeros_like(mask, dtype=bool)
    for r in range(h):
        for c in range(w):
            if not mask[r,c]:
                continue
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                nr,nc=r+dr,c+dc
                if not (0<=nr<h and 0<=nc<w and mask[nr,nc]):
