+) -> bool:
+    gh, gw = grid.shape
+    max_h = min(12 if shape_kind == "lshape" else 10, gh - 2)
+    max_w = min(12 if shape_kind == "lshape" else 10, gw - 2)
+    for _ in range(REGION_TRIES):
