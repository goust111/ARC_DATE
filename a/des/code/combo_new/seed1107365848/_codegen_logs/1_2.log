+    gh, gw = reserved.shape
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(gh, top + h + pad)
+    c1 = min(gw, left + w + pad)
+    return not reserved[r0:r1, c0:c1].any()
