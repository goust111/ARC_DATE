+        for b in interior_cells[i + 1 :]
+        if max(abs(a[0] - b[0]), abs(a[1] - b[1])) > 1
+    ]
+    if not valid_pairs:
+        return None
+    pair = rng.choice(valid_pairs)
+    return [pair[0], pair[1]]
+
+
+def _shape_kinds(rng: random.Random, count: int) -> list[str]:
