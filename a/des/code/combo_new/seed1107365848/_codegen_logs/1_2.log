+    if seed_counts != {1, 2}:
+        return False
+    if any(not region["core"] for region in regions):
+        return False
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return False
+    for region in regions:
+        black_left = sum(int(out[r, c]) == BLACK for r, c in region["cells"])
+        if int(region["seed_count"]) == 1 and black_left == 0:
