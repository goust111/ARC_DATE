+def _ring_cells(
+    frames: list[tuple[int, int, int, int]],
+    index: int,
+) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = frames[index]
+    cells: list[tuple[int, int]] = []
+    if index + 1 < len(frames):
