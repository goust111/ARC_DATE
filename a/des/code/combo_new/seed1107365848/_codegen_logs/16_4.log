+# --------------- generator ---------------
+
+GEN_BG = 0
+GEN_MAX_ATTEMPTS = 500
+GEN_LAYOUTS = ("both", "rows", "cols")
+GEN_PAIR_COUNTS = (2, 3)
+GEN_TOTAL_LIMIT = 30
+GEN_COLOR_POOL = tuple(range(1, 10))
