+    start = 0
+    for sep in separators:
+        if start >= sep:
+            return []
+        spans.append((int(start), int(sep) - 1))
+        start = int(sep) + 1
+    if start >= length:
+        return []
+    spans.append((int(start), int(length) - 1))
+    return spans
