+
+def _panel_specs(row_spans: list[tuple[int, int]], col_spans: list[tuple[int, int]]) -> list[dict]:
+    panels: list[dict] = []
+    for r0, r1 in row_spans:
+        for c0, c1 in col_spans:
+            panels.append(
+                {
+                    "r0": int(r0),
+                    "c0": int(c0),
+                    "h": int(r1 - r0 + 1),
+                    "w": int(c1 - c0 + 1),
+                }
+            )
+    return panels
