+def _build_canvas(row_spans: list[tuple[int, int]], col_spans: list[tuple[int, int]], sep_color: int) -> np.ndarray:
+    h = int(row_spans[-1][1]) + 1
+    w = int(col_spans[-1][1]) + 1
