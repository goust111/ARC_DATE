+    window_counts: list[int],
+) -> np.ndarray | None:
+    height = n_rows * room_h + (n_rows - 1)
+    width = n_cols * room_w + (n_cols - 1)
+    if height > ARC_LIMIT or width > ARC_LIMIT:
