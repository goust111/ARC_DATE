+    free = [(int(r), int(c)) for r, c in zip(*np.where(room == BLACK), strict=False)]
+    if len(free) < window_count:
+        return None
+    for r, c in random.sample(free, window_count):
+        room[r, c] = YELLOW
+    return room
+
