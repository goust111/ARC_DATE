+    seg_lengths, seg_colors = _segment_colors(len(path), layers)
+    idx = 0
+    for seg_len, color in zip(seg_lengths, seg_colors):
+        for _ in range(seg_len):
+            r, c = path[idx]
+            inp[r, c] = int(color)
+            idx += 1
