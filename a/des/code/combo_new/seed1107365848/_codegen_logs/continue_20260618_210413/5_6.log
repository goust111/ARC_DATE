+    out: set[tuple[tuple[int, int], ...]] = set()
+    cur = _normalize(shape)
+    for _ in range(4):
+        out.add(cur)
+        out.add(_flip(cur))
+        cur = _rotate(cur)
+    return tuple(sorted(out))
