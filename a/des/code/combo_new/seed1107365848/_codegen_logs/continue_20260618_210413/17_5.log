+    for r, c in coords:
+        dr = r - tail_r
+        dc = c - tail_c
+        if direction[0] == 0:
+            mirrored = (dr, -dc)
+        else:
+            mirrored = (-dr, dc)
+        projected.append((new_tail[0] + mirrored[0], new_tail[1] + mirrored[1]))
+    return projected
+
