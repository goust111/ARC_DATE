+    return tail, direction
+
+
+def _project_component(
+    coords: list[tuple[int, int]],
+    tail: tuple[int, int],
+    direction: tuple[int, int],
+    distance: int,
+) -> list[tuple[int, int]]:
+    tail_r, tail_c = tail
+    new_tail = (tail_r + distance * direction[0], tail_c + distance * direction[1])
