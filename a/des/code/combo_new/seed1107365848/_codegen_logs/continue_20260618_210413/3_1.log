+def _submask_from_points(pts: list[tuple[int, int]]) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(pts)
+    sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in pts:
