+def _is_square_frame(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    if h != w or h < 4:
+        return False
+    target = np.ones((h, w), dtype=bool)
+    target[1:-1, 1:-1] = False
+    return np.array_equal(mask, target)
