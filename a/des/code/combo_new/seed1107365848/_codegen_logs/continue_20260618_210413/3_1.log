+        out[r0 : r1 + 1, c0] = color
+        out[r0 : r1 + 1, c1] = color
+        out[r0, c0 : c1 + 1] = color
+        out[r1, c0 : c1 + 1] = color
+        interior = out[r0 + 1 : r1, c0 + 1 : c1]
+        interior[~packed] = color
+
+    return out
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    return bool(mask.any()) and len(_components(mask)) == 1
+
+
+def _random_composition(total: int, parts: int, rng: np.random.Generator) -> list[int]:
+    cuts = sorted(int(x) for x in rng.choice(np.arange(1, total), size=parts - 1, replace=False))
+    vals = [0] + cuts + [total]
+    return [vals[i + 1] - vals[i] for i in range(parts)]
+
+
+def _assemble_stripes(
+    side: int, mode: str, sizes: list[int], fragment_masks: list[np.ndarray]
+) -> np.ndarray:
+    panel = np.zeros((side, side), dtype=bool)
+    if mode == "vertical":
+        col = 0
+        for width, frag in zip(sizes, fragment_masks):
+            panel[:, col : col + width] = frag
+            col += width
+    else:
+        row = 0
+        for height, frag in zip(sizes, fragment_masks):
+            panel[row : row + height, :] = frag
+            row += height
+    return panel
+
+
+def _gen_panel(
+    rng: np.random.Generator, side: int
+) -> tuple[np.ndarray, list[np.ndarray]] | None:
+    mode = str(rng.choice(np.array(["vertical", "horizontal"])))
+    frag_count = int(rng.integers(2, min(4, side - 1) + 1))
+    sizes = _random_composition(side, frag_count, rng)
+    if max(sizes) < 2:
+        return None
+
+    if mode == "vertical":
+        fragment_masks = [np.ones((side, width), dtype=bool) for width in sizes]
+        row_offsets = [0] * frag_count
+        col_offsets = []
+        owner = np.zeros((side, side), dtype=int)
+        col = 0
+        for idx, width in enumerate(sizes):
+            col_offsets.append(col)
+            owner[:, col : col + width] = idx
+            col += width
+    else:
+        fragment_masks = [np.ones((height, side), dtype=bool) for height in sizes]
+        row_offsets = []
+        col_offsets = [0] * frag_count
+        owner = np.zeros((side, side), dtype=int)
+        row = 0
+        for idx, height in enumerate(sizes):
+            row_offsets.append(row)
+            owner[row : row + height, :] = idx
+            row += height
+
+    panel = _assemble_stripes(side, mode, sizes, fragment_masks)
+    hole_ops = int(rng.integers(1, 4))
+    carved = 0
+    for _ in range(40):
+        if carved >= hole_ops:
+            break
+        pat = HOLE_PATTERNS[int(rng.integers(len(HOLE_PATTERNS)))]
+        r0 = int(rng.integers(1, side - 1))
+        c0 = int(rng.integers(1, side - 1))
+        cells = [(r0 + dr, c0 + dc) for dr, dc in pat]
+        if any(not (1 <= r < side - 1 and 1 <= c < side - 1) for r, c in cells):
+            continue
+        idx = int(owner[cells[0]])
+        if any(int(owner[r, c]) != idx for r, c in cells):
+            continue
+        if any(not panel[r, c] for r, c in cells):
