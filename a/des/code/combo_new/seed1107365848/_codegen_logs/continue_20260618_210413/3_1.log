+        if (bits >> idx) & 1:
+            out[idx // side, idx % side] = True
+    return out
+
+
+def _solve_panel_mask(
+    fragment_masks: list[np.ndarray], side: int, max_unions: int = 2
+) -> tuple[np.ndarray | None, int]:
