+        return None
+    return panel, fragment_masks
+
+
+def _rect_is_clear(blocked: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = 1) -> bool:
+    hh, ww = blocked.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(hh, r0 + h + pad)
+    cc1 = min(ww, c0 + w + pad)
+    return not blocked[rr0:rr1, cc0:cc1].any()
+
+
+def _mark_rect(blocked: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = 1) -> None:
+    hh, ww = blocked.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(hh, r0 + h + pad)
+    cc1 = min(ww, c0 + w + pad)
+    blocked[rr0:rr1, cc0:cc1] = True
+
+
+def _frame_patch(color: int, inner_side: int) -> np.ndarray:
+    patch = np.zeros((inner_side + 2, inner_side + 2), dtype=int)
+    patch[0, :] = color
+    patch[-1, :] = color
+    patch[:, 0] = color
+    patch[:, -1] = color
+    return patch
+
+
+def _place_frame(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    color: int,
+    inner_side: int,
+    side_name: str,
