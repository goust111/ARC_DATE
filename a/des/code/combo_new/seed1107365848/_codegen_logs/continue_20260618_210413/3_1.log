+        col_choices = list(range(0, gw - w + 1))
+    elif side_name == "left":
+        row_choices = list(range(0, gh - h + 1))
+        col_choices = [0] if gw == w else [0, 1]
+    else:
+        row_choices = list(range(0, gh - h + 1))
+        col_choices = [gw - w] if gw == w else [gw - w, gw - w - 1]
