+        if panel_pack is None:
+            return None
+        panel_specs.append((color, panel_pack[0], panel_pack[1]))
+
+    frame_info: list[tuple[int, tuple[int, int], np.ndarray]] = []
+    for (color, panel, _), side_name in zip(panel_specs, side_choices):
