+        "inner_w": inner_w,
+        "outer_h": outer_h,
+        "outer_w": outer_w,
+        "side": side,
+        "gap_cells": gap_cells,
+        "gap_anchor": gap_cells[len(gap_cells) // 2],
+        "frame_cells": frame_cells,
+    }
+
+
+def _seed_plan(spec: dict, branch: str) -> tuple[list[tuple[int, int, int]], int] | None:
+    inner_h = int(spec["inner_h"])
