+    dr, dc = DIRECTION_STEPS[str(spec["side"])]
+    ray_length = len(seeds)
+    ray_cells = [
+        (
+            int(spec["gap_anchor"][0] + dr * step),
+            int(spec["gap_anchor"][1] + dc * step),
+        )
+        for step in range(1, ray_length + 1)
