+from __future__ import annotations
+
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+BG_COLOR = 0
+PALETTE_COLORS = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 400
+_RNG = np.random.default_rng()
+
+
+def _choice(seq):
+    return seq[int(_RNG.integers(len(seq)))]
+
+
+def _normalize(cells):
+    min_r = min(r for r, _ in cells)
+    min_c = min(c for _, c in cells)
+    return tuple(sorted((r - min_r, c - min_c) for r, c in cells))
+
+
+def _rotate90(cells):
+    max_r = max(r for r, _ in cells)
+    return tuple((c, max_r - r) for r, c in cells)
+
+
+def _flip_lr(cells):
+    max_c = max(c for _, c in cells)
+    return tuple((r, max_c - c) for r, c in cells)
+
+
+def _variants(cells):
+    cur = tuple(cells)
+    seen = set()
+    out = []
+    for _ in range(4):
+        for candidate in (cur, _flip_lr(cur)):
+            norm = _normalize(candidate)
+            if norm not in seen:
+                seen.add(norm)
+                out.append(norm)
+        cur = _rotate90(cur)
+    return out
+
+
+def _shape_perimeter(cells):
+    cell_set = set(cells)
+    perimeter = 0
+    for r, c in cell_set:
+        for dr, dc in DIRS4:
+            if (r + dr, c + dc) not in cell_set:
+                perimeter += 1
+    return perimeter
+
+
+def _shape_dims(cells):
+    return max(r for r, _ in cells) + 1, max(c for _, c in cells) + 1
+
+
