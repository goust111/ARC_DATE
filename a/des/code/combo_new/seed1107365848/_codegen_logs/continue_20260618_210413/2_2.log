+        pos = _place_random_shape(reserved, shapes[idx], require_edge=False)
+        if pos is None:
+            return None
+        placements[idx] = pos
+
+    original_colors = _RNG.choice(np.array(PALETTE_COLORS, dtype=int), size=count, replace=True)
