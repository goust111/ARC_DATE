+
+def _validate_generated(grid, expected_count, tie_mode, expect_edge):
+    try:
+        bg, palette, _forbidden, components = _extract_scene(grid)
+        if bg != BG_COLOR or len(palette) != expected_count or len(components) != expected_count:
