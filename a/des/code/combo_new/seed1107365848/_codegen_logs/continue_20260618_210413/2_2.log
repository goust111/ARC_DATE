+
+
+def _gen_attempt():
+    count = int(_RNG.integers(3, 6))
+    tie_mode = bool(_RNG.integers(2))
+    same_row_tie = tie_mode and bool(_RNG.integers(2))
+    expect_edge = bool(_RNG.integers(2))
