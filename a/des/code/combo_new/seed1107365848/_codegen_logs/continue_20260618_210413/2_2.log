+    if expect_edge and not edge_used:
+        edge_candidates = []
+        for idx in remaining:
+            h, w = shape_dims[idx]
+            positions = [pos for pos in _candidate_positions(reserved, shapes[idx]) if _touches_edge(pos[0], pos[1], h, w, grid_h, grid_w)]
