+                    "rows": rows,
+                    "cols": cols,
+                    "area": len(cells),
+                    "perimeter": perimeter,
+                    "top": int(rows.min()),
+                    "left": int(cols.min()),
+                    "bottom": int(rows.max()),
+                    "right": int(cols.max()),
+                    "color": color,
+                }
