+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or forbidden[r, c] or int(g[r, c]) == bg:
+                continue
+
+            color = int(g[r, c])
+            queue = deque([(r, c)])
+            visited[r, c] = True
+            cells = []
+
+            while queue:
+                rr, cc = queue.popleft()
+                cells.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
