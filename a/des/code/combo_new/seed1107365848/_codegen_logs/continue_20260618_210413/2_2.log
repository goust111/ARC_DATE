+        ranked = sorted(components, key=lambda comp: (-comp["perimeter"], comp["top"], comp["left"]))
+        recolored = False
+        for assigned_color, comp in zip(palette, ranked):
+            if comp["color"] != assigned_color:
+                recolored = True
+                break
