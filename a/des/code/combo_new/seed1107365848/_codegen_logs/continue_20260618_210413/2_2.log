+    if row is None:
+        row_iter = range(2, grid_h - h + 1)
+    else:
+        if not (2 <= row <= grid_h - h):
+            return []
+        row_iter = (row,)
+
+    positions = []
+    for r in row_iter:
+        for c in range(0, grid_w - w + 1):
+            if _can_place(reserved, r, c, h, w):
