+        positions = _palette_positions(grid.shape[1], rng)
+        grid[row, :] = bg
+        for pos, color in zip(positions, colors):
+            grid[row, pos] = color
+        return
+    col = 0 if side == "left" else grid.shape[1] - 1
+    positions = _palette_positions(grid.shape[0], rng)
+    grid[:, col] = bg
+    for pos, color in zip(positions, colors):
+        grid[pos, col] = color
+
