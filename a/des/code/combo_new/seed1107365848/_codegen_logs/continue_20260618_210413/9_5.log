+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+SEPARATOR = 5
+DAMAGE = 8
+PATTERN_COLORS = (1, 2, 3, 4, 6, 7, 9)
+MAX_ATTEMPTS = 300
+MASK_ATTEMPTS = 200
