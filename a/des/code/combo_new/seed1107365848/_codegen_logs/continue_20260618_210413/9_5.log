+    assert np.all(g[sep_r, :] == sep), "middle row must be a full separator"
+    assert np.all(g[:, sep_c] == sep), "middle column must be a full separator"
+
+    panels = [
+        g[:sep_r, :sep_c],
+        g[:sep_r, sep_c + 1 :],
+        g[sep_r + 1 :, :sep_c],
+        g[sep_r + 1 :, sep_c + 1 :],
+    ]
