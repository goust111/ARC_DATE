+            if side == "left":
+                patch = np.zeros((h, fw + gap_sep + w), dtype=int)
+                ring_r, ring_c = 0, fw + gap_sep
+                frag_r0, frag_c = frag_r, 0
+            else:
+                patch = np.zeros((h, w + gap_sep + fw), dtype=int)
+                ring_r, ring_c = 0, 0
+                frag_r0, frag_c = frag_r, w + gap_sep
