+
+    for _ in range(120):
+        h = random.randint(size_lo, size_hi)
+        w = random.randint(size_lo, size_hi)
+        inner_h = h - 2
+        inner_w = w - 2
+
+        if side in ("top", "bottom"):
+            gap_len = random.randint(2, inner_w)
