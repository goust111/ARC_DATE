+    for coords in black_components:
+        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in coords):
+            continue
+        regions.append({"coords": coords, "bbox": _bbox(coords)})
+
+    parent: list[int | None] = [None] * len(regions)
