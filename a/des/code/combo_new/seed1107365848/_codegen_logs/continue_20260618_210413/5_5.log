+    for pid in sorted(int(x) for x in np.unique(piece_map)):
+        coords = [(int(r), int(c)) for r, c in np.argwhere(piece_map == pid)]
+        r0, c0, r1, c1 = _bbox(coords)
+        patch = np.full((r1 - r0 + 1, c1 - c0 + 1), BLACK, dtype=int)
