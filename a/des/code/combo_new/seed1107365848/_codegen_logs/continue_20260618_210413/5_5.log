+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(cells)
+    return out
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _foreign_neighbors(piece_map: np.ndarray, r: int, c: int) -> set[int]:
+    pid = int(piece_map[r, c])
+    h, w = piece_map.shape
+    foreign: set[int] = set()
+    for dr, dc in DIRS4:
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            other = int(piece_map[nr, nc])
+            if other != pid:
+                foreign.add(other)
+    return foreign
+
+
+def _graph_connected(n_nodes: int, edges: list[tuple[int, int]]) -> bool:
+    if n_nodes == 0:
+        return False
+    graph: dict[int, set[int]] = {i: set() for i in range(n_nodes)}
+    for a, b in edges:
+        graph[a].add(b)
+        graph[b].add(a)
+    seen = {0}
+    stack = [0]
+    while stack:
+        node = stack.pop()
+        for nxt in graph[node]:
+            if nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
+    return len(seen) == n_nodes
