+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+MIN_RECT_SIDE = 6
+MAX_RECT_SIDE = 10
+MIN_CHILD_SIDE = 3
+MIN_PIECES = 2
+MAX_PIECES = 4
+CANVAS_MIN = 18
+CANVAS_MAX = 28
+GEN_ATTEMPTS = 300
+SCATTER_ATTEMPTS = 250
