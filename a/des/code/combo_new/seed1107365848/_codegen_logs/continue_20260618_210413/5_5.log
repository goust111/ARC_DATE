+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    shapes = _solve_rectangle_shapes(g, stop_after=2)
+    assert len(shapes) == 1, "expected a unique assembled rectangle shape"
