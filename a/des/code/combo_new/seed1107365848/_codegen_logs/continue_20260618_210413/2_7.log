+    "multi": {"lengths": (5, 8), "min_turns": 2, "max_turns": 4},
+}
+
+
+def _neighbors(node: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    r, c = node
+    out: list[tuple[int, int]] = []
+    for dr, dc in DIR4:
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            out.append((rr, cc))
