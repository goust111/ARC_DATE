+            direction = (nxt[0] - cur[0], nxt[1] - cur[1])
+            if prev_dir is not None and direction != prev_dir:
+                turns += 1
+            prev_dir = direction
+            path.append(nxt)
+            used.add(nxt)
+
+        if len(path) == length:
+            actual_turns = _turn_count(path)
+            if min_turns <= actual_turns <= max_turns:
+                return path
