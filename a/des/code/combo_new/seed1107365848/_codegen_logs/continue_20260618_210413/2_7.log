+        r, c = cur
+        for dr, dc in DIR4:
+            rr, cc = r + dr, c + dc
+            nxt = (rr, cc)
+            if 0 <= rr < mask.shape[0] and 0 <= cc < mask.shape[1] and mask[rr, cc] and nxt not in parents:
