+    occupied: set[tuple[int, int]] = set()
+    edges: set[tuple[tuple[int, int], tuple[int, int]]] = set()
+    pair_paths: list[list[tuple[int, int]]] = []
+    marker_nodes: set[tuple[int, int]] = set()
