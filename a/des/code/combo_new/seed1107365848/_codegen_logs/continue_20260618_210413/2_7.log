+def _edge_count(mask: np.ndarray) -> int:
+    edges = 0
+    edges += int(np.count_nonzero(mask[:, :-1] & mask[:, 1:]))
+    edges += int(np.count_nonzero(mask[:-1, :] & mask[1:, :]))
+    return edges
