+def _outer_corner(
+    prev: tuple[int, int],
+    cur: tuple[int, int],
+    nxt: tuple[int, int],
+) -> tuple[int, int] | None:
+    dr1 = cur[0] - prev[0]
+    dc1 = cur[1] - prev[1]
+    dr2 = nxt[0] - cur[0]
+    dc2 = nxt[1] - cur[1]
+    if (dr1, dc1) == (dr2, dc2):
+        return None
+    return (cur[0] + dr1 - dr2, cur[1] + dc1 - dc2)
