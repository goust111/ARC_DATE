+
+def _add_path(
+    nodes: set[tuple[int, int]],
+    edges: set[tuple[tuple[int, int], tuple[int, int]]],
+    path: list[tuple[int, int]],
+) -> None:
+    for node in path:
+        nodes.add(node)
+    for a, b in zip(path, path[1:]):
+        edges.add(tuple(sorted((a, b))))
