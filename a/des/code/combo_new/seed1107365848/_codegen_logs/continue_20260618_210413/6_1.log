+from __future__ import annotations
+
+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+BG = 0
+SIDES = ("left", "right", "top", "bottom")
+NON_BG_COLORS = tuple(range(1, 10))
+CANVAS_SIZE = 30
+PAIR_COUNT_CHOICES = (2, 3)
+INNER_SIZE_RANGE = (3, 6)
+PLACE_TRIES = 200
+GEN_RETRIES = 400
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components_by_color(grid: np.ndarray, bg: int) -> dict[int, list[list[tuple[int, int]]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    by_color: dict[int, list[list[tuple[int, int]]]] = defaultdict(list)
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = cr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
