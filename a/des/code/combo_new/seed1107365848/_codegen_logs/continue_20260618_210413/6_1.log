+
+def _components_by_color(grid: np.ndarray, bg: int) -> dict[int, list[list[tuple[int, int]]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    by_color: dict[int, list[list[tuple[int, int]]]] = defaultdict(list)
+
