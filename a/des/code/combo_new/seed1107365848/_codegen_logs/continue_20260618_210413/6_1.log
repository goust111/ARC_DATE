+
+def _analyze_lock(grid: np.ndarray, coords: list[tuple[int, int]], bg: int):
+    bbox, mask = _coords_to_mask(coords)
+    r0, c0, r1, c1 = bbox
+    h, w = mask.shape
+    if h < 4 or w < 4:
+        return None
+
+    rr, cc = np.nonzero(mask)
+    on_boundary = (rr == 0) | (rr == h - 1) | (cc == 0) | (cc == w - 1)
+    if not np.all(on_boundary):
