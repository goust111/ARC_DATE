+def _mark_bbox(occ: np.ndarray, bbox: tuple[int, int, int, int], pad: int = 0) -> None:
+    h, w = occ.shape
+    r0, c0, r1, c1 = bbox
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h - 1, r1 + pad)
+    cc1 = min(w - 1, c1 + pad)
+    occ[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
