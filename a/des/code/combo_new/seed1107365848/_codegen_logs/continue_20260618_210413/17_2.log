+    grid: np.ndarray,
+    blocked: np.ndarray,
+    colors: list[int],
+) -> bool:
+    h, w = grid.shape
+    slots = [(r, c) for r in range(1, h - 2) for c in range(1, w - 2)]
+    random.shuffle(slots)
+
+    for color in colors:
+        placed = False
+        for r, c in slots:
+            if blocked[r - 1 : r + 3, c - 1 : c + 3].any():
