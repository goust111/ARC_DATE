+def _project_rows(mask: np.ndarray) -> np.ndarray:
+    out = np.zeros_like(mask, dtype=bool)
+    for r in range(mask.shape[0]):
+        cols = np.flatnonzero(mask[r])
+        if cols.size:
+            out[r, int(cols[0]) : int(cols[-1]) + 1] = True
+    return out
