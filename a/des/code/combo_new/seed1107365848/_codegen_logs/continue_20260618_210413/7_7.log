+PAIR_COUNT_RANGE = (2, 4)
+PAIR_GAP_RANGE = (1, 3)
+GEN_RETRIES = 400
+LOCAL_SHAPE_RETRIES = 120
+PLACEMENT_RETRIES = 120
+MARGIN = 1
