+        width = max(ends) + 1
+        bridge_count = random.choice((1, 1, 2))
+        bridge_rows = set(random.sample(range(1, height - 1), k=min(bridge_count, height - 2)))
+
+        shadow = np.zeros((height, width), dtype=bool)
+        for r, end in enumerate(ends):
