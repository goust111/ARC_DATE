+            coords = np.array(pts, dtype=int)
+            r0 = int(coords[:, 0].min())
+            c0 = int(coords[:, 1].min())
+            r1 = int(coords[:, 0].max())
+            c1 = int(coords[:, 1].max())
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+            comps.append(
