+                    edges.append((i, j))
+            elif side in ("left", "right"):
+                if col_proj.shape == other["mask"].shape and np.array_equal(col_proj, other["mask"]):
+                    edges.append((i, j))
+    return sorted(set(edges))
+
+
+def _pair_solutions(components: list[dict], limit: int = 2) -> list[list[tuple[int, int]]]:
