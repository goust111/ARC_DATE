+def _patch_cells(patch: np.ndarray, top: int, left: int) -> list[tuple[int, int]]:
+    rows, cols = np.nonzero(patch)
+    return [(int(top + r), int(left + c)) for r, c in zip(rows, cols, strict=False)]
