+
+BLACK = 0
+WALL = 5
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+NEIGHBORS8 = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
