+import random
+from collections import deque
+
+import numpy as np
+
+
+MAX_GEN_RETRIES = 300
+GRID_SIZE_RANGE = (22, 31)
+LEGEND_ENTRY_COUNTS = (2, 3, 4)
+PATTERN_SIZES = (2, 3)
+OBJECT_COUNT_RANGE = (2, 5)
+COLOR_POOL = tuple(range(1, 10))
+CORNERS = ("tl", "tr", "bl", "br")
+ORIENTATIONS = ("horizontal", "vertical")
