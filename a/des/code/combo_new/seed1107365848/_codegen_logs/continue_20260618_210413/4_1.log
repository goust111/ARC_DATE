+
+
+def _make_interior_shape(rng: random.Random) -> np.ndarray:
+    h = rng.randint(3, 7)
+    w = rng.randint(3, 7)
+    mask = np.ones((h, w), dtype=bool)
+    kind = rng.choice(SHAPE_KINDS)
