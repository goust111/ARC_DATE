+        pattern = np.asarray(block[1:, 1:], dtype=int)
+        assert key != 0
+        assert key not in mapping, "legend keys must be unique"
+        mapping[key] = pattern
+    return mapping, mask
+
+
+def _enclosed_regions_for_component(
+    grid: np.ndarray,
+    color: int,
+    comp: list[tuple[int, int]],
+) -> list[tuple[int, list[tuple[int, int]]]]:
