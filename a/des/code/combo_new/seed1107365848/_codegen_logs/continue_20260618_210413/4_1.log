+        sig = arr.tobytes()
+        if sig in used:
+            continue
+        used.add(sig)
+        return arr
+    return None
+
+
+def _legend_entry(key: int, pattern: np.ndarray) -> np.ndarray:
+    size = pattern.shape[0] + 1
+    block = np.empty((size, size), dtype=int)
+    block[1:, 1:] = pattern
+    block[0, 1:] = pattern[0, :]
+    block[1:, 0] = pattern[:, 0]
+    block[0, 0] = key
+    return block
+
+
+def _make_interior_shape(rng: random.Random) -> np.ndarray:
+    h = rng.randint(3, 7)
+    w = rng.randint(3, 7)
