+def _reserve(occ: np.ndarray, r0: int, c0: int, h: int, w: int):
+    occ[max(0, r0 - 1) : min(occ.shape[0], r0 + h + 1), max(0, c0 - 1) : min(occ.shape[1], c0 + w + 1)] = True
