+
+
+def _frame_patch(interior: np.ndarray, frame_color: int, seed_color: int, rng: random.Random) -> tuple[np.ndarray, np.ndarray]:
+    h, w = interior.shape
+    inside = np.zeros((h + 2, w + 2), dtype=bool)
+    inside[1:-1, 1:-1] = interior
+    border = np.zeros_like(inside)
