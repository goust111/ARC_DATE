+    patch = np.zeros_like(border, dtype=int)
+    patch[border] = frame_color
+    interior_cells = list(zip(*np.where(inside)))
+    sr, sc = rng.choice(interior_cells)
+    patch[sr, sc] = seed_color
+    return patch, inside
