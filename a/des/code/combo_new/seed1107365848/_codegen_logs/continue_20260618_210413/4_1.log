+    mapping: dict[int, np.ndarray] = {}
+    for block in blocks:
+        key = int(block[0, 0])
+        pattern = np.asarray(block[1:, 1:], dtype=int)
+        assert key != 0
+        assert key not in mapping, "legend keys must be unique"
+        mapping[key] = pattern
