+                q.append((nr, nc))
+    return mask
+
+
+def _extract_legend(grid: np.ndarray) -> tuple[dict[int, np.ndarray], np.ndarray]:
+    start = _corner_start(grid)
+    mask = _connected_component_from(grid, start)
