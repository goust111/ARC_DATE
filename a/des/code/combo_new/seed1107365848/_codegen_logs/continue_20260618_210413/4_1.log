+            return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+    if out.shape != grid.shape:
+        return None
+    if max(grid.shape) > 30 or max(out.shape) > 30:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
