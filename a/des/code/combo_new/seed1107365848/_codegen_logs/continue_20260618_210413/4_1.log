+        for c in (0, w - 1):
+            if not barrier[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not barrier[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and not barrier[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+    return outside
+
