+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _flood_from_boundary(barrier: np.ndarray) -> np.ndarray:
+    h, w = barrier.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if not barrier[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not barrier[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and not barrier[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+    return outside
+
+
+def _corner_start(grid: np.ndarray) -> tuple[int, int]:
+    h, w = grid.shape
+    corners = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
+    starts = [(r, c) for r, c in corners if int(grid[r, c]) != 0]
+    assert len(starts) == 1, "exactly one corner should contain the legend"
+    return starts[0]
+
+
+def _connected_component_from(grid: np.ndarray, start: tuple[int, int]) -> np.ndarray:
+    h, w = grid.shape
+    mask = np.zeros((h, w), dtype=bool)
+    q = deque([start])
+    mask[start] = True
+    while q:
+        r, c = q.popleft()
