+                mask[:cut_h, :cut_w] = False
+            elif corner == "tr":
+                mask[:cut_h, w - cut_w :] = False
+            elif corner == "bl":
+                mask[h - cut_h :, :cut_w] = False
+            else:
+                mask[h - cut_h :, w - cut_w :] = False
+            if not mask.any():
+                mask[:, :] = True
+    return mask
