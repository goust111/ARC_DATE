    vals = list(range(1, max(1, length - 1)))
    vals = [v for v in vals if 0 < v < length - 1]
    vals.sort(key=lambda v: (abs(v - center), v))
    return vals


def _pick_marker_index(candidates: list[int], rng: np.random.Generator) -> int | None:
