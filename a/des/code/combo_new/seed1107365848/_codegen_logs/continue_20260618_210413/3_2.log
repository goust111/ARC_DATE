+    h = sum(heights) + (nr - 1)
+    w = sum(widths) + (nc - 1)
+    grid = np.full((h, w), BG, dtype=int)
+    expected = np.full((h, w), BG, dtype=int)
+
+    row_edges = []
+    running = 0
+    for i, size in enumerate(heights):
