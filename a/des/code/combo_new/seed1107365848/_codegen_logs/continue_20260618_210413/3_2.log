+    for color in candidates:
+        score = sum(int(np.all(grid[r, :] == color)) for r in range(h))
+        score += sum(int(np.all(grid[:, c] == color)) for c in range(w))
+        if score > best_score:
+            best = int(color)
+            best_score = int(score)
+    assert best is not None
+    return int(best)
+
