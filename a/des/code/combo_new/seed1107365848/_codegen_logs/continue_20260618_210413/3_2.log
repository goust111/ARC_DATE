0146:                 if v == bg or v == mover:
0147:                     continue
0148:                 border_counts[v] = border_counts.get(v, 0) + 1
0149:         if not border_counts:
0150:             continue
0151:         border_col = max(border_counts, key=border_counts.get)
0152:         if border_col not in dirs:
