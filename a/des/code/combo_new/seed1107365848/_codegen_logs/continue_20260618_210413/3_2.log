+    sep_rows = [int(r) for r in range(h) if np.all(g[r, :] == int(sep))]
+    sep_cols = [int(c) for c in range(w) if np.all(g[:, c] == int(sep))]
+    row_parts = _region_intervals(h, sep_rows)
+    col_parts = _region_intervals(w, sep_cols)
