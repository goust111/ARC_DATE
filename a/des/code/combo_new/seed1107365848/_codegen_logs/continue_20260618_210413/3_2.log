    return int(head[int(rng.integers(0, len(head)))])


def _choose_markers(
    rng: np.random.Generator,
    preview: np.ndarray,
    corner: str,
    mode: str,
) -> list[tuple[int, int]] | None:
    h, w = preview.shape
    markers: list[tuple[int, int]] = []

    if mode in ("v", "hv"):
