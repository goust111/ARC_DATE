+        choices = _free_positions(occupied, ph, pw, PLACEMENT_PAD)
+        if not choices:
+            return False
+        top, left = random.choice(choices)
+        spec["top"] = top
+        spec["left"] = left
+        _reserve(occupied, top, left, ph, pw, PLACEMENT_PAD)
+    return True
