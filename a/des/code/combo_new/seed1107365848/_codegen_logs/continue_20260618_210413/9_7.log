+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+ALL_DIMS = [(h, w) for h in range(1, 5) for w in range(1, 5)]
+DIMS_BY_AREA: dict[int, list[tuple[int, int]]] = {}
+for _h, _w in ALL_DIMS:
+    DIMS_BY_AREA.setdefault(_h * _w, []).append((_h, _w))
