+MIN_PAIRS = 2
+MAX_PAIRS = 4
+GRID_H_RANGE = (12, 24)
+GRID_W_MAX = 24
+OBJECT_PADDING = 1
+LEGEND_GAP = 1
+GEN_RETRIES = 400
+PLACEMENT_RETRIES = 120
