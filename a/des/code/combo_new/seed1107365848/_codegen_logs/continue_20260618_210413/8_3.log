+from __future__ import annotations
+
+import random
+import numpy as np
+
+
+SIDE_CHOICES = ("top", "bottom", "left", "right")
+ODD_SIZES = (7, 9, 11, 13, 15, 17, 19)
+MAX_GEN_ATTEMPTS = 300
+
