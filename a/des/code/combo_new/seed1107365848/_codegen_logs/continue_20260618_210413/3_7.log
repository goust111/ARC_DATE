+    c0 = left
+    r1 = r0 + core_h - 1
+    c1 = c0 + core_w - 1
+    mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    w0, w1 = _slot_offsets(core_w)
+    h0, h1 = _slot_offsets(core_h)
+    if signature[0]:
