+import numpy as np
+
+
+_RNG = np.random.default_rng()
+
+BG = 0
+GREY = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+GRID_H_RANGE = (20, 31)
+GRID_W_RANGE = (20, 31)
+LABEL_STRIP = 6
+REGION_GAP = 3
+GLOBAL_MARGIN = 1
+GEN_RETRIES = 300
+PLACEMENT_RETRIES = 200
+SHAPE_CORE_RANGE = (4, 8)
+LABEL_CORE = 2
+LAYOUTS = ("labels_right", "labels_left", "labels_bottom", "labels_top")
+
+
+def _slot_offsets(length: int) -> tuple[int, int]:
+    if length <= 1:
+        raise ValueError("core side length must be at least 2")
+    if length == 2:
+        return 0, 1
+    return 1, length - 2
+
+
+def _signature_catalog() -> list[tuple[int, ...]]:
+    sigs = []
+    for mask in range(1, 1 << 8):
+        bits = tuple((mask >> i) & 1 for i in range(8))
+        pop = sum(bits)
+        if not (2 <= pop <= 5):
+            continue
+        side_counts = (
+            bits[0] + bits[1],
+            bits[2] + bits[3],
+            bits[4] + bits[5],
+            bits[6] + bits[7],
+        )
+        if sum(count > 0 for count in side_counts) < 2:
+            continue
+        sigs.append(bits)
+    return sigs
+
+
+SIGNATURES = _signature_catalog()
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for sr, sc in np.argwhere(grid == color):
+        sr = int(sr)
+        sc = int(sc)
+        if seen[sr, sc]:
+            continue
+        stack = [(sr, sc)]
+        seen[sr, sc] = True
+        coords = []
+        while stack:
+            r, c = stack.pop()
+            coords.append((r, c))
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < h and 0 <= cc < w and not seen[rr, cc] and grid[rr, cc] == color:
+                    seen[rr, cc] = True
+                    stack.append((rr, cc))
+        rs = [r for r, _ in coords]
+        cs = [c for _, c in coords]
+        r0, r1 = min(rs), max(rs)
+        c0, c1 = min(cs), max(cs)
+        mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        for r, c in coords:
+            mask[r - r0, c - c0] = True
+        comps.append(
+            {
+                "color": int(color),
+                "coords": coords,
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "mask": mask,
+            }
+        )
+    return comps
+
+
+def _recover_core_bbox(mask: np.ndarray) -> tuple[int, int, int, int]:
+    h, w = mask.shape
+    best = None
+    best_area = -1
+    for top in (0, 1):
+        for bottom in (0, 1):
+            for left in (0, 1):
+                for right in (0, 1):
+                    r0 = top
+                    c0 = left
+                    r1 = h - 1 - bottom
+                    c1 = w - 1 - right
+                    if r0 > r1 or c0 > c1:
+                        continue
+                    core = mask[r0 : r1 + 1, c0 : c1 + 1]
+                    if not core.all():
+                        continue
+                    ok = True
+                    for r, c in np.argwhere(mask):
+                        r = int(r)
+                        c = int(c)
+                        if r0 <= r <= r1 and c0 <= c <= c1:
+                            continue
+                        inside_neighbors = 0
+                        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                            rr = r + dr
+                            cc = c + dc
+                            if r0 <= rr <= r1 and c0 <= cc <= c1:
+                                inside_neighbors += 1
+                        if inside_neighbors != 1:
+                            ok = False
+                            break
+                    if not ok:
