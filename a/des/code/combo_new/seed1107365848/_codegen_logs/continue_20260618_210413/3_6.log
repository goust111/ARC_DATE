sprite_mask):\\n+            changed_vs_unrotated += 1\\n+        k_leg, flip_leg = legend_transform_by_src[src_col]\\n+        if (k_leg != 0 or flip_leg) and krot != 0:\\n+            combined_nontrivial += 1\\n+\\n+    no_rot_out = _partial_output_without_rotation(info, color_map)\\n+    full_out = main(info[\\\"grid\\\"])\\n+    repeated_cross_quad = 0\\n+    for src_col in info[\\\"placeholder_colors\\\"]:\\n+        seen_rots = {\\n+            _rotation_k_for_bbox(bbox, H, W)\\n+            for col, bbox in info[\\\"placeholders\\\"]\\n+            if col == src_col\\n+        }\\n+        if len(seen_rots) >= 2:\\n+            repeated_cross_quad += 1\\n+\\n+    return {\\n+        \\\"num_shapes\\\": len(info[\\\"sprite_masks\\\"]),\\n+        \\\"vertical_entries\\\": int(info[\\\"legend_counts\\\"][\\\"vertical_entries\\\"]),\\n+        \\\"horizontal_entries\\\": int(info[\\\"legend_counts\\\"][\\\"horizontal_entries\\\"]),\\n+        \\\"legend_non_identity\\\": int(sum((k != 0 or flip) for k, flip in legend_transform_by_src.values())),\\n+        \\\"legend_flip_count\\\": int(sum(flip for _k, flip in legend_transform_by_src.values())),\\n+        \\\"rotation_hist\\\": rotation_hist,\\n+        \\\"changed_vs_unrotated\\\": int(changed_vs_unrotated),\\n+        \\\"combined_nontrivial\\\": int(combined_nontrivial),\\n+        \\\"repeated_cross_quad\\\": int(repeated_cross_quad),\\n+        \\\"output_differs_without_rotation\\\": bool(not np.array_equal(no_rot_out, full_out)),\\n+    }\\n+\\n+\\n def _gen_attempt() -> np.ndarray | None:\\n     struct = _choose_structure()\\n     if struct is None:\\n@@ -716,31 +806,16 @@\\n     empty_pick = _choose_empty_slots(rows, cols, empty_count, slot_rot)\\n     if empty_pick is None:\\n         return None\\n-    _empty_slots, filled_slots = empty_pick\\n+    _, filled_slots = empty_pick\\n \\n     bg = random.choice([c for c in range(10) if c != FRAME_COL])\\n     usable = [c for c in range(10) if c not in (bg, FRAME_COL)]\\n-\\n     k_hi = min(NUM_COLORS_RANGE[1], total - 1)\\n     if k_hi < NUM_COLORS_RANGE[0]:\\n         return None\\n     k = random.randint(NUM_COLORS_RANGE[0], k_hi)\\n     src_cols = random.sample(usable, k)\\n-\\n-    ink_choices = [c for c in usable if c not in src_cols]\\n-    if not ink_choices:\\n-        return None\\n-    legend_ink = random.choice(ink_choices)\\n \\n-    tgt_cols = _choose_target_colors(usable, src_cols, legend_ink)\\n-    if tgt_cols is None:\\n-        return None\\n-    if legend_ink in set(tgt_cols):\\n-        return None\\n-    if len(set(tgt_cols)) == 1:\\n-        return None\\n-    color_to_tgt = dict(zip(src_cols, tgt_cols))\\n-\\n     masks = _choose_masks(src_cols, n)\\n     if masks is None:\\n         return None\\n@@ -749,6 +824,16 @@\\n         return None\\n     legend_masks, legend_tfms = legend_pick\\n \\n+    legend_ink_choices = [c for c in usable if c not in src_cols]\\n+    if not legend_ink_choices:\\n+        return None\\n+    legend_ink = random.choice(legend_ink_choices)\\n+    tgt_pool = [c for c in usable if c != legend_ink]\\n+    if len(set(tgt_pool)) < k:\\n+        return None\\n+    tgt_cols = random.sample(tgt_pool, k)\\n+    color_to_tgt = dict(zip(src_cols, tgt_cols))\\n+\\n     cell_colors = _assign_cell_colors(filled_slots, src_cols, slot_rot)\\n     if cell_colors is None:\\n         return None\\n@@ -s_tuples,\\n                    \\\"bbox\\\": (r0, c0, r1, c1),\\n                    \\\"area\\\": len(pts_tuples),\\n                }\\n            )\\n            cid += 1\\n\\n    def _bbox_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\\n        ar0, ac0, ar1, ac1 = a\\n        br0, bc0, br1, bc1 = b\\n        return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)\\n\\n    # Legend mapping: detect small two-color glyph regions where two components overlap in bbox\\n    # and the union bbox contains only those two colors (no background).\\n    color_map: dict[int, int] = {}\\n    legend_ids: set[int] = set()\\n\\n    for i in range(len(comps)):\\n        for j in range(i + 1, len(comps)):\\n            ci = comps[i]\\n            cj = comps[j]\\n            if ci[\\\"col\\\"] == cj[\\\"col\\\"]:\\n                continue\\n            if not _bbox_overlap(ci[\\\"bbox\\\"], cj[\\\"bbox\\\"]):\\n                continue\\n            r0 = min(ci[\\\"bbox\\\"][0], cj[\\\"bbox\\\"][0])\\n            c0 = min(ci[\\\"bbox\\\"][1], cj[\\\"bbox\\\"][1])\\n            r1 = max(ci[\\\"bbox\\\"][2], cj[\\\"bbox\\\"][2])\\n            c1 = max(ci[\\\"bbox\\\"][3], cj[\\\"bbox\\\"][3])\\n            # restrict to compact legend-like regions\\n            if (r1 - r0 + 1) > 8 or (c1 - c0 + 1) > 8:\\n                continue\\n            sub = g[r0 : r1 + 1, c0 : c1 + 1]\\n            sub_colors = set(map(int, np.unique(sub))) - {frame_col}\\n            if bg in sub_colors:\\n                continue\\n            if len(sub_colors) != 2:\\n                continue\\n            cset = set(sub_colors)\\n            if ci[\\\"col\\\"] not in cset or cj[\\\"col\\\"] not in cset:\\n                continue\\n\\n            # Decide source->target.\\n            # If exactly one color is used as a placeholder inside the frame, that one is source.\\n            if (ci[\\\"col\\\"] in placeholder_colors) ^ (cj[\\\"col\\\"] in placeholder_colors):\\n                src = ci[\\\"col\\\"] if ci[\\\"col\\\"] in placeholder_colors else cj[\\\"col\\\"]\\n                tgt = cj[\\\"col\\\"] if src == ci[\\\"col\\\"] else ci[\\\"col\\\"]\\n            else:\\n                # Otherwise: the larger component in this pair is treated as the source.\\n                assert ci[\\\"area\\\"] != cj[\\\"area\\\"], f\\\"ambiguous equal-area legend pair: {ci['col']} and {cj['col']}\\\"\\n                if ci[\\\"area\\\"] > cj[\\\"area\\\"]:\\n                    src, tgt = ci[\\\"col\\\"], cj[\\\"col\\\"]\\n                else:\\n                    src, tgt = cj[\\\"col\\\"], ci[\\\"col\\\"]\\n\\n            assert src in placeholder_colors, f\\\"legend source color {src} is not a placeholder\\\"\\n            assert src not in color_map, f\\\"duplicate legend mapping for placeholder color {src}\\\"\\n            color_map[src] = int(tgt)\\n            legend_ids.add(ci[\\\"id\\\"])\\n            legend_ids.add(cj[\\\"id\\\"])\\n    assert set(color_map) == placeholder_colors, (\\n        f\\\"legend mappings {sorted(color_map)} do not match placeholders {sorted(placeholder_colors)}\\\"\\n    )\\n\\n    # Sprite shapes: for each placeholder color, pick the non-legend component matching placeholder size.\\n    sprite_coords: dict[int, tuple[tuple[tuple[int, int], ...], int, int]] = {}\\n    for src_col in sorted(placeholder_colors):\\n        all_candidates = [c for c in comps if c[\\\"col\\\"] == src_col and c[\\\"id\\\"] not in legend_ids]\\n        assert all_candidates, f\\\"no non-legend sprite found for color {src_col}\\\"\\n        want_h, want_w = phw[src_col]\\n        sized = [\\n            c\\n            for c in all_candidates\\n            if (c[\\\"bbox\\\"][2] - c[\\\"bbox\\\"][0] + 1) == want_h and (c[\\\"bbox\\\"][3] - c[\\\"bbox\\\"][1] + 1) == want_w\\n        ]\\n        assert len(sized) == 1, f\\\"expected one size-matched sprite for color {src_col}, found {len(sized)}\\\"\\n        base = sized[0]\\n        sr0, sc0, sr1, sc1 = base[\\\"bbox\\\"]\\n\\n        # Some sprites can be split into multiple 4-connected components of the same color.\\n        # Merge any additional (non-legend) components fully contained in the chosen sprite bbox.\\n        pts_set = set(base[\\\"pts\\\"])\\n        for c in all_candidates:\\n            if c[\\\"id\\\"] == base[\\\"id\\\"]:\\n                continue\\n            r0, c0, r1, c1 = c[\\\"bbox\\\"]\\n            assert sr0 <= r0 and sr1 >= r1 and sc0 <= c0 and sc1 >= c1, (\\n                f\\\"extra sprite component for color {src_col} is outside the base bbox\\\"\\n            )\\n            pts_set.update(c[\\\"pts\\\"])\\n\\n        coords = tuple(sorted((r - sr0, c - sc0) for r, c in pts_set))\\n        sprite_coords[src_col] = (coords, sr1 - sr0 + 1, sc1 - sc0 + 1)\\n\\n    # Build output crop: keep frame border, clear interior to bg, then paste recolored sprites.\\n    out = crop.copy()\\n    out[1:-1, 1:-1] = bg\\n\\n    for src_col, (pr0, pc0, pr1, pc1) in placeholders:\\n        assert src_col in sprite_coords and src_col in color_map, f\\\"placeholder color {src_col} missing sprite or color mapping\\\"\\n        tgt_col = int(color_map[src_col])\\n        coords, sh, sw = sprite_coords[src_col]\\n        assert (pr1 - pr0 + 1, pc1 - pc0 + 1) == (sh, sw), (\\n            f\\\"placeholder size does not match sprite for color {src_col}\\\"\\n        )\\n        assert pr0 + sh <= H and pc0 + sw <= W, f\\\"sprite for color {src_col} does not fit at placeholder\\\"\\n        # Align sprite's bbox top-left to placeholder bbox top-left.\\n        off_r = pr0\\n        off_c = pc0\\n        for dr, dc in coords:\\n            rr, cc = off_r + dr, off_c + dc\\n            out[rr, cc] = tgt_col\\n\\n    return out\\n\\n# --------------- generator (o5x) ---------------\\n\\n# === CFG: tunables ===\\nFRAME_COL = 5                       # frame border color (always gray)\\nSPRITE_N_RANGE = (3, 6)             # NxN sprite/placeholder size, exclusive upper\\nGRID_ROWS_RANGE = (2, 4)            # placeholder grid row count, exclusive upper\\nGRID_COLS_RANGE = (3, 5)            # placeholder grid col count, exclusive upper\\nTOTAL_BLOCKS_RANGE = (6, 10)        # total filled slots (inclusive)\\nMAX_EMPTY_SLOTS = 2                 # max empty slots in the grid\\nNUM_COLORS_RANGE = (2, 5)           # K = number of distinct placeholder colors (inclusive)\\nSPRITE_FILL_MIN = 0.5               # min sprite fill ratio\\nSPRITE_FILL_MAX = 0.9               # max sprite fill ratio (clamped to n*n-1)\\nMIN_FRAME_H = 13                    # minimum frame height\\nMIN_FRAME_W = 18                    # minimum frame width\\nMAX_FRAME_DIM = 21                  # maximum frame height or width\\nFRAME_MARGIN_SLACK = 4              # max extra padding inside frame beyond content\\nCANVAS_H_RANGE = (22, 31)           # final grid height range, exclusive upper\\nCANVAS_W_RANGE = (23, 31)           # final grid width range, exclusive upper\\nFRAME_POS_JITTER_PROB = 0.25        # probability of non-edge frame placement per axis\\nPATCH_PADDING = 1                   # min bg gap between placed patches\\nGEN_RETRIES = 300                   # outer retry budget\\n\\n\\ndef _legend(src: int, tgt: int) -> np.ndarray:\\n    \\\"\\\"\\\"Build a 3x4 legend block mapping src color to tgt color.\\\"\\\"\\\"\\n    return np.array(\\n        [[src, src, tgt, tgt],\\n         [src, src, src, tgt],\\n         [src, src, tgt, tgt]], dtype=int)\\n\\n\\ndef _sprite_mask(n: int) -> np.ndarray:\\n    \\\"\\\"\\\"Generate a random NxN binary mask with fill ratio in [SPRITE_FILL_MIN, SPRITE_FILL_MAX].\\\"\\\"\\\"\\n    lo = max((n * n + 1) // 2, int(np.ceil(SPRITE_FILL_MIN * n * n)))\\n    hi = min(int(np.floor(SPRITE_FILL_MAX * n * n)), n * n - 1)\\n    target = random.randint(lo, hi)\\n\\n    # Seed: random walk column + one full row, then random orientation\\n    mask = np.zeros((n, n), dtype=bool)\\n    c = random.randrange(n)\\n    for r in range(n):\\n        c = max(0, min(n - 1, c + random.choice([-1, 0, 1])))\\n        mask[r, c] = True\\n    mask[random.randrange(n), :] = True\\n\\n    if random.random() < 0.5:\\n        mask = mask.T.copy()\\n    if random.random() < 0.5:\\n        mask = np.flipud(mask)\\n    if random.random() < 0.5:\\n        mask = np.fliplr(mask)\\n\\n    # Grow to target fill by adding random frontier cells\\n    while int(mask.sum()) < target:\\n        dilated = np.zeros_like(mask)\\n        dilated[1:, :] |= mask[:-1, :]\\n        dilated[:-1, :] |= mask[1:, :]\\n        dilateRANGE = (23, 31)\\nFRAME_POS_JITTER_PROB = 0.25\\nPATCH_PADDING = 1\\nGEN_RETRIES = 300\\nSPRITE_PLACE_RETRIES = 80\\nMIN_NEAREST_GAP = 4\\n\\n\\ndef _legend(src: int, tgt: int) -> np.ndarray:\\n    return np.array(\\n        [[src, src, tgt, tgt], [src, src, src, tgt], [src, src, tgt, tgt]],\\n        dtype=int,\\n    )\\n\\n\\ndef _sprite_mask(n: int) -> np.ndarray:\\n    lo = max((n * n + 1) // 2, int(np.ceil(SPRITE_FILL_MIN * n * n)))\\n    hi = min(int(np.floor(SPRITE_FILL_MAX * n * n)), n * n - 1)\\n    target = random.randint(lo, hi)\\n\\n    mask = np.zeros((n, n), dtype=bool)\\n    c = random.randrange(n)\\n    for r in range(n):\\n        c = max(0, min(n - 1, c + random.choice([-1, 0, 1])))\\n        mask[r, c] = True\\n    mask[random.randrange(n), :] = True\\n\\n    if random.random() < 0.5:\\n        mask = mask.T.copy()\\n    if random.random() < 0.5:\\n        mask = np.flipud(mask)\\n    if random.random() < 0.5:\\n        mask = np.fliplr(mask)\\n\\n    while int(mask.sum()) < target:\\n        dilated = np.zeros_like(mask)\\n        dilated[1:, :] |= mask[:-1, :]\\n        dilated[:-1, :] |= mask[1:, :]\\n        dilated[:, 1:] |= mask[:, :-1]\\n        dilated[:, :-1] |= mask[:, 1:]\\n        frontier = list(zip(*np.where(dilated & ~mask)))\\n        r, c = random.choice(frontier)\\n        mask[r, c] = True\\n    return mask\\n\\n\\ndef _colored_sprite(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\\n    out = np.full(mask.shape, bg, dtype=int)\\n    out[mask] = int(color)\\n    return out\\n\\n\\ndef _content_extent(n: int, grid_rows: int, grid_cols: int) -> tuple[int, int]:\\n    return grid_rows * n + grid_rows - 1, grid_cols * n + grid_cols - 1\\n\\n\\ndef _choose_structure() -> tuple[int, int, int, int, int] | None:\\n    total = random.randint(*TOTAL_BLOCKS_RANGE)\\n    options = []\\n    for n in range(*SPRITE_N_RANGE):\\n        for rows in range(*GRID_ROWS_RANGE):\\n            for cols in range(*GRID_COLS_RANGE):\\n                ch, cw = _content_extent(n, rows, cols)\\n                base_fh = ch + 4\\n                base_fw = cw + 4\\n                slots = rows * cols\\n                empty = slots - total\\n                if base_fh <= MAX_FRAME_DIM and base_fw <= MAX_FRAME_DIM and 0 <= empty <= MAX_EMPTY_SLOTS:\\n                    options.append((n, rows, cols, empty, total))\\n    return random.choice(options) if options else None\\n\\n\\ndef _choose_empty_slots(\\n    rows: int, cols: int, empty_count: int\\n) -> tuple[set[tuple[int, int]], list[tuple[int, int]]]:\\n    slots = [(r, c) for r in range(rows) for c in range(cols)]\\n    valid = []\\n    for combo in itertools.combinations(slots, empty_count):\\n        empty = set(combo)\\n        filled = [s for s in slots if s not in empty]\\n        if len({r for r, _ in filled}) == rows and len({c for _, c in filled}) == cols:\\n            valid.append(empty)\\n    empty_slots = random.choice(valid)\\n    filled_slots = [s for s in slots if s not in empty_slots]\\n    random.shuffle(filled_slots)\\n    return empty_slots, filled_slots\\n\\n\\ndef _repeat_counts(total: int, k: int) -> list[int]:\\n    counts = [2] * k\\n    for _ in range(total - 2 * k):\\n        counts[random.randrange(k)] += 1\\n    random.shuffle(counts)\\n    return counts\\n\\n\\ndef _make_bordered_frame(h: int, w: int, bg: int) -> np.ndarray:\\n    frame = np.full((h, w), bg, dtype=int)\\n    frame[0, :] = frame[-1, :] = FRAME_COL\\n    frame[:, 0] = frame[:, -1] = FRAME_COL\\n    return frame\\n\\n\\ndef _place_patch(\\n    grid: np.ndarray, reserve: np.ndarray, patch: np.ndarray, bg: int, *, transparent: bool\\n) -> bool:\\n    blocker = np.full(patch.shape, FRAME_COL, dtype=int)\\n    try:\\n        r, c = random_free_location(reserve, blocker, transparent=bg, padding=PATCH_PADDING)\\n    except ValueError:\\n        return False\\n    paste(reserve, blocker, r, c)\\n    paste(grid, patch, r, c, transparent=bg if transparent else None)\\n    return True\\n\\n\\ndef _distance_profile(\\n    sprite_bbox: tuple[int, int, int, int], candidates: list[tuple[int, int, int, int]]\\n) -> list[tuple[int, int, int, int, int, int]]:\\n    scored = []\\n    for box in candidates:\\n        dist = _center_manhattan2(sprite_bbox, box)\\n        scored.append((dist, box[0], box[1], box[2], box[3], len(scored)))\\n    scored.sort()\\n    return scored\\n\\n\\ndef _place_sprite_for_color(\\n    grid: np.ndarray,\\n    reserve: np.ndarray,\\n    sprite_patch: np.ndarray,\\n    bg: int,\\n    candidate_boxes: list[tuple[int, int, int, int]],\\n) -> tuple[int, int, int, int] | None:\\n    blocker = np.full(sprite_patch.shape, FRAME_COL, dtype=int)\\n    h, w = sprite_patch.shape\\n    for _ in range(SPRITE_PLACE_RETRIES):\\n        try:\\n            r, c = random_free_location(reserve, blocker, transparent=bg, padding=PATCH_PADDING)\\n        except ValueError:\\n            return None\\n        bbox = (r, c, r + h - 1, c + w - 1)\\n        profile = _distance_profile(bbox, candidate_boxes)\\n        assert len(profile) >= 2, \\\"variant generator expects repeated placeholders per color\\\"\\n        if profile[1][0] - profile[0][0] < MIN_NEAREST_GAP:\\n            continue\\n        paste(reserve, blocker, r, c)\\n        paste(grid, sprite_patch, r, c, transparent=bg)\\n        return bbox\\n    return None\\n\\n\\ndef _gen_attempt() -> np.ndarray | None:\\n    struct = _choose_structure()\\n    if struct is None:\\n        return None\\n    n, rows, cols, empty_count, total = struct\\n\\n    max_k = min(NUM_COLORS_RANGE[1], total // 2)\\n    if max_k < NUM_COLORS_RANGE[0]:\\n        return None\\n\\n    bg = random.choice([c for c in range(10) if c != FRAME_COL])\\n    usable = [c for c in range(10) if c not in (bg, FRAME_COL)]\\n\\n    k = random.randint(NUM_COLORS_RANGE[0], max_k)\\n    src_cols = random.sample(usable, k)\\n    tgt_cols = [random.choice([c for c in usable if c != src]) for src in src_c