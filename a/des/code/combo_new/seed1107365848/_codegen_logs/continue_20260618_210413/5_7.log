+def _grow_coarse_tree(rows: int, cols: int, node_count: int) -> dict[tuple[int, int], set[tuple[int, int]]] | None:
+    start = (random.randrange(rows), random.randrange(cols))
+    adj: dict[tuple[int, int], set[tuple[int, int]]] = {start: set()}
+    used = {start}
