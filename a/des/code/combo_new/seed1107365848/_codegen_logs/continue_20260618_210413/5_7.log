+    adj: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    degrees: dict[tuple[int, int], int] = {}
+    root_candidates: list[tuple[int, int]] = []
+    for r, c in path_pts:
+        nbs = []
+        touches_root = False
