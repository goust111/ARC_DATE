+    degrees: dict[tuple[int, int], int] = {}
+    root_candidates: list[tuple[int, int]] = []
+    for r, c in path_pts:
+        nbs = []
+        touches_root = False
+        for rr, cc in _neighbors4(r, c, h, w):
