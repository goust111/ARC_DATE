+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+WHITE = 8
+
+PATH_COLORS = (GREY, RED, BLUE)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GEN_ATTEMPTS = 400
+STEP_OPTIONS = (3, 4)
