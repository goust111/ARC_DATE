+        return None
+
+    try:
+        main(inp)
+    except Exception:
+        return None
+
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid branch-filter tree input")

