+    rows: int,
+    cols: int,
+    step: int,
+    root_cell: tuple[int, int],
+) -> np.ndarray | None:
+    h = GRID_OFFSET + step * (rows - 1) + 3
+    w = GRID_OFFSET + step * (cols - 1) + 3
+    grid = np.full((h, w), BLACK, dtype=int)
+
+    coords = {
+        cell: (GRID_OFFSET + step * cell[0], GRID_OFFSET + step * cell[1])
+        for cell in adj
+    }
+
+    for cell, nbs in adj.items():
+        r0, c0 = coords[cell]
+        for nb in nbs:
