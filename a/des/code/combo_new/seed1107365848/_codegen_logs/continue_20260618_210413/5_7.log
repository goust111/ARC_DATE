+        return [(r, c - 1), (r, c), (r + 1, c - 1), (r + 1, c)]
+    if (dr, dc) == (1, 0):
+        return [(r, c), (r, c + 1), (r + 1, c), (r + 1, c + 1)]
+    if (dr, dc) == (-1, 0):
+        return [(r - 1, c), (r - 1, c + 1), (r, c), (r, c + 1)]
+    raise AssertionError("leaf and parent must be 4-neighbors")
