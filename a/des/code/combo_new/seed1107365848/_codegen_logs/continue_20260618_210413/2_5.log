+TURN_COUNT_CHOICES = (0, 1, 2, 3)
+GEN_RETRIES = 300
+PATH_BUILD_RETRIES = 120
+PATH_PLACE_RETRIES = 120
+USABLE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
