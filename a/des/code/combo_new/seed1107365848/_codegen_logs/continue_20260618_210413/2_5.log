+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in DIRS4:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
+
+
+def _turn_left(direction):
+    dr, dc = direction
+    return -dc, dr
+
+
+def _turn_right(direction):
+    dr, dc = direction
+    return dc, -dr
+
+
+def _parse_legend(grid: np.ndarray):
