+        for turn_idx in range(turns):
+            if forced_signs is not None and turn_idx < len(forced_signs) and forced_signs[turn_idx] is not None:
+                sign = forced_signs[turn_idx]
+            else:
+                sign = rng.choice(("L", "R"))
+            signs.append(sign)
+            nxt = _turn_left(directions[-1]) if sign == "L" else _turn_right(directions[-1])
+            directions.append(nxt)
