+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or visited[r, c]:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            visited[r, c] = True
+            coords = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((int(cr), int(cc)))
