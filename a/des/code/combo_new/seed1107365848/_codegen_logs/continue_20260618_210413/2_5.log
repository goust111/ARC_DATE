+        lengths = []
+        for seg_idx in range(turns + 1):
+            lo = 1
+            hi = max_units
+            if turns == 0 and seg_idx == 0:
+                lo = min(2, hi)
+            lengths.append(rng.randint(lo, hi))
+
+        pts = [(0, 0)]
+        seen = {(0, 0)}
+        ok = True
+        for direction, units in zip(directions, lengths):
+            for _ in range(units * side):
+                nr = pts[-1][0] + direction[0]
+                nc = pts[-1][1] + direction[1]
+                if nr < 0 or nc < 0 or (nr, nc) in seen:
+                    ok = False
