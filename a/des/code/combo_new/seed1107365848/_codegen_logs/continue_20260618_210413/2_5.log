+        forced_signs[turning[1]] = ["R"] + [None] * (turn_counts[turning[1]] - 1)
+    elif len(turning) == 1 and turn_counts[turning[0]] >= 2:
+        forced_signs[turning[0]] = ["L", "R"] + [None] * (turn_counts[turning[0]] - 2)
