+    for item in placed:
+        for r, c in item["points"]:
+            grid[r, c] = item["color"]
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
