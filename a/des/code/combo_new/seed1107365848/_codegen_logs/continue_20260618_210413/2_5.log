+
+
+def _gen_attempt(rng: random.Random):
+    side = rng.choice(SIDE_CHOICES)
+    num_templates = rng.choice(TEMPLATE_COUNT_BY_SIDE[side])
+    colors = rng.sample(USABLE_COLORS, num_templates)
+    templates = _build_templates(side, colors, rng)
+
+    legend_rows, legend_cols = _legend_layout(num_templates, side, rng)
+    legend_h = legend_rows * side + legend_rows + 1
+    legend_w = legend_cols * side + legend_cols + 1
+
+    min_h = max(legend_h + 1, 16 if side == 3 else 18)
+    min_w = max(legend_w + side + 7, 20 if side == 3 else 22)
+    if min_h > 30 or min_w > 30:
+        return None
+
+    h = rng.randint(min_h, 30)
+    w = rng.randint(min_w, 30)
+    legend_r0 = rng.randint(0, h - legend_h)
+    legend_c0 = rng.choice([0, 1]) if w - legend_w >= 2 else 0
+    main_c0 = legend_c0 + legend_w + 2
+    if main_c0 + side >= w:
+        return None
+
+    num_paths = min(5, num_templates + rng.randint(0, 1))
+    turn_counts = [rng.choice(TURN_COUNT_CHOICES) for _ in range(num_paths)]
+    if all(t == 0 for t in turn_counts):
+        turn_counts[rng.randrange(num_paths)] = 1
+
+    initial_dirs = [rng.choice((RIGHT, DOWN)) for _ in range(num_paths)]
+    if num_paths >= 2 and len(set(initial_dirs)) == 1:
+        initial_dirs[0] = RIGHT
+        initial_dirs[1] = DOWN
+
+    if sum(turn_counts) >= 2:
+        sign_probe = [rng.choice(("L", "R")) for _ in range(sum(turn_counts))]
+        if len(set(sign_probe)) < 2:
+            sign_probe[0] = "L"
+            sign_probe[-1] = "R"
+
+    path_colors = colors[:]
+    while len(path_colors) < num_paths:
+        path_colors.append(rng.choice(colors))
+    rng.shuffle(path_colors)
+
+    occupied = set()
+    for rr in range(max(0, legend_r0 - 1), min(h, legend_r0 + legend_h + 1)):
+        for cc in range(max(0, legend_c0 - 1), min(w, legend_c0 + legend_w + 1)):
+            occupied.add((rr, cc))
+
+    placed = []
+    all_signs = []
+    clipped_count = 0
+    for color, turns, initial_dir in zip(path_colors, turn_counts, initial_dirs):
+        placed_path = None
+        for _ in range(PATH_BUILD_RETRIES):
+            rel = _build_relative_path(side, turns, initial_dir, rng)
+            if rel is None:
+                continue
+            cand = _place_path(rel, side, h, w, main_c0, occupied, rng)
+            if cand is None:
+                continue
+            cand["color"] = int(color)
+            placed_path = cand
+            break
+        if placed_path is None:
+            return None
+        placed.append(placed_path)
+        occupied |= placed_path["reserved"]
+        all_signs.extend(placed_path["signs"])
+        clipped_count += int(placed_path["clipped"])
+
+    if sum(turn_counts) >= 2 and len(set(all_signs)) < 2:
+        return None
+    if rng.random() < 0.4 and clipped_count == 0:
+        return None
+
+    grid = np.zeros((h, w), dtype=int)
+    legend_order = colors[:]
+    rng.shuffle(legend_order)
+    _draw_legend(grid, templates, legend_r0, legend_c0, legend_rows, legend_cols, legend_order)
+    for item in placed:
+        for r, c in item["points"]:
+            grid[r, c] = item["color"]
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid puzzle instance")

