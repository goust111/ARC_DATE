+    for color in colors:
+        for _ in range(200):
+            mask = _make_template_mask(side, rng)
+            if any(_same_up_to_rotation(mask, other) for other in masks):
+                continue
+            cell = np.zeros((side, side), dtype=int)
+            cell[mask] = int(color)
