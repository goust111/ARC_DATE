+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+RIGHT = (0, 1)
+DOWN = (1, 0)
+LEFT = (0, -1)
+UP = (-1, 0)
+DIRS4 = (UP, DOWN, LEFT, RIGHT)
+DIR_TO_ROT = {
+    RIGHT: 0,
+    DOWN: 3,  # clockwise 90
+    LEFT: 2,
+    UP: 1,    # clockwise 270
