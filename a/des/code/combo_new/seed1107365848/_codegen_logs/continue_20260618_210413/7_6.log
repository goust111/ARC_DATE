+        rng.shuffle(candidate_rooms)
+        for room_id in candidate_rooms:
+            cells = _room_free_cells(rooms[room_id]["bbox"], occupied)
+            if not cells:
+                continue
+            cell = rng.choice(cells)
+            grid[cell] = duplicate_color
+            occupied.add(cell)
+            break
