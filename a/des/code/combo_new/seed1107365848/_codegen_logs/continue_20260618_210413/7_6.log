+                if int(out[r, c]) != fill_color:
+                    return False
+                visible_fill += 1
+            elif int(grid[r, c]) in SOURCE_COLORS and int(out[r, c]) != int(grid[r, c]):
+                return False
+        if visible_fill == 0:
+            return False
+
+    return True
