+    col_bounds = [-1] + vertical_walls + [width]
+    rooms: list[dict[str, object]] = []
+    room_lookup: dict[tuple[int, int], int] = {}
+
+    room_id = 0
+    for band_r in range(len(row_bounds) - 1):
