+
+                for nr, nc in _neighbors4(cr, cc, height, width):
+                    if seen[nr, nc] or int(grid[nr, nc]) == Color.GREY:
+                        continue
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
