+def _neighbors4(r: int, c: int, height: int, width: int):
+    for dr, dc in NEIGHBORS4:
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < height and 0 <= cc < width:
+            yield rr, cc
+
