+    shuffled_rooms = room_ids[:]
+    rng.shuffle(shuffled_rooms)
+    colors = list(source_set)
+    rng.shuffle(colors)
+    used_rooms: set[int] = set()
+
+    for color in colors:
+        candidate_rooms = [room_id for room_id in shuffled_rooms if room_id not in used_rooms]
+        if not candidate_rooms:
