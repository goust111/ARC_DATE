+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
+
+    dict_bbox = _dictionary_bbox(g)
+    templates = _templates_from_dictionary(g, dict_bbox)
+    rooms = _room_bboxes(g, dict_bbox)
