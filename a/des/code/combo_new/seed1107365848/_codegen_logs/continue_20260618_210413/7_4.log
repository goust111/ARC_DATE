+            r1 = row_edges[ri + 1] - 1
+            c0 = col_edges[ci] + 1
+            c1 = col_edges[ci + 1] - 1
+            coords = [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]
+            count = seed_counts[room_index]
+            picks = rng.choice(len(coords), size=count, replace=False)
+            for idx in np.atleast_1d(picks):
+                rr, cc = coords[int(idx)]
+                grid[rr, cc] = SEED
