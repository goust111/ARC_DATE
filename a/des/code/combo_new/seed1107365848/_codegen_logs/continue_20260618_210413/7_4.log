+
+def _draw_main_rooms(
+    grid: np.ndarray,
+    row_heights: np.ndarray,
+    col_widths: np.ndarray,
+    seed_counts: list[int],
+    rng: np.random.Generator,
+) -> None:
+    row_edges = _row_col_edges(row_heights)
+    col_edges = _row_col_edges(col_widths)
