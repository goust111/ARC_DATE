+def _find_strip(grid: np.ndarray, bg: int) -> list[int]:
+    h, w = grid.shape
+    best: tuple[int, int, int] | None = None
+    for r in range(1, h - 1):
+        c = 0
+        while c < w:
+            top = int(grid[r - 1, c])
+            bot = int(grid[r + 1, c])
