+    r0, c0 = coords.min(axis=0)
+    norm = coords - np.array([int(r0), int(c0)], dtype=int)
+    h = int(norm[:, 0].max()) + 1
+    w = int(norm[:, 1].max()) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    mask[norm[:, 0], norm[:, 1]] = True
+    return mask
