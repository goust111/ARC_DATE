+def _connected_components(mask: np.ndarray) -> list[dict]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(int(r), int(c))])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((int(rr), int(cc)))
+                for dr, dc in NEIGHBORS4:
+                    nr = int(rr + dr)
+                    nc = int(cc + dc)
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            r0, c0 = coords.min(axis=0)
+            r1, c1 = coords.max(axis=0)
+            components.append(
+                {
+                    "coords": coords,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return components
+
+
+def _coords_to_mask(coords: np.ndarray) -> np.ndarray:
+    coords = np.asarray(coords, dtype=int)
+    r0, c0 = coords.min(axis=0)
+    norm = coords - np.array([int(r0), int(c0)], dtype=int)
+    h = int(norm[:, 0].max()) + 1
+    w = int(norm[:, 1].max()) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    mask[norm[:, 0], norm[:, 1]] = True
+    return mask
+
+
+def _cells_to_mask(cells: set[tuple[int, int]]) -> np.ndarray:
+    coords = np.array(sorted(cells), dtype=int)
+    return _coords_to_mask(coords)
+
+
+def _is_rect_frame_mask(mask: np.ndarray) -> bool:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    if h < 3 or w < 3:
+        return False
+    expected = np.zeros((h, w), dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    return bool(np.array_equal(mask, expected))
+
