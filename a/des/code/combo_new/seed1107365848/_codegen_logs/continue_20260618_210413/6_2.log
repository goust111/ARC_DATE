+    colors = [int(color) for color in np.unique(g) if int(color) != BG]
+    for color in colors:
+        components = _connected_components(g == int(color))
+        if not components:
+            continue
+        frames = [component for component in components if _is_rect_frame_component(component)]
+        if len(frames) != 1:
