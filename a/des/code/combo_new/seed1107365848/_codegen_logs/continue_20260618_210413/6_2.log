+
+def _random_connected_shape(area: int) -> np.ndarray:
+    for _ in range(SHAPE_ATTEMPTS):
+        cells: set[tuple[int, int]] = {(0, 0)}
+        while len(cells) < area:
+            frontier: list[tuple[int, int]] = []
