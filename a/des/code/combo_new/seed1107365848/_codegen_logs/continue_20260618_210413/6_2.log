+
+def _choose_layout(shapes: list[np.ndarray], want_wrap: bool) -> dict | None:
+    max_w = max(int(shape.shape[1]) for shape in shapes)
+    total_w = sum(int(shape.shape[1]) for shape in shapes) + len(shapes) - 1
