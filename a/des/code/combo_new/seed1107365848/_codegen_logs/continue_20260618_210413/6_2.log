+
+def _random_transform(mask: np.ndarray) -> np.ndarray:
+    out = np.array(mask, dtype=bool)
+    out = np.rot90(out, int(RNG.integers(0, 4)))
+    if RNG.random() < 0.5:
+        out = np.fliplr(out)
+    if RNG.random() < 0.5:
+        out = np.flipud(out)
+    return np.array(out, dtype=bool)
