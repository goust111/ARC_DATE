+            arrow = (r0 - 1, col)
+            tail = (r0 - 2, col)
+            wall = {(wall_row, c) for c in range(wall_left, wall_left + wall_len)}
+            shift = gap + 2
+            moved = {(r - shift, col) for r in range(r0, r0 + path_len)}
