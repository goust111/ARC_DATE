+    candidates = []
+    for main_idx in (0, 1):
+        main_info = infos[main_idx]
+        wall_info = infos[1 - main_idx]
+        assert main_info is not None and wall_info is not None
+        arrow = _arrow_from_main(grid, color, main_info)
+        if arrow is None:
