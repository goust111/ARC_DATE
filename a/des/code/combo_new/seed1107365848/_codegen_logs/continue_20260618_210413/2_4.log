+            (area_a, int(shape_a["r0"]), int(shape_a["c0"]), int(shape_a["color"])),
+            (area_b, int(shape_b["r0"]), int(shape_b["c0"]), int(shape_b["color"])),
+        ),
+        key=lambda item: (-item[0], item[1], item[2]),
+    )
