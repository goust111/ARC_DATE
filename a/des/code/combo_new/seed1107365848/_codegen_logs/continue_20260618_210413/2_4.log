+        "orientation": "V",
+        "group_h": 2 * h + gap,
+        "group_w": w,
+        "shapes": [
+            {"mask": top_mask, "color": int(colors[0]), "offset_r": 0, "offset_c": 0},
+            {"mask": bottom_mask, "color": int(colors[1]), "offset_r": h + gap, "offset_c": 0},
