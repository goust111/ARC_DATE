+        for option in candidates:
+            a, b = option["members"]
+            used.add(int(a))
+            used.add(int(b))
+            chosen.append(option)
+            result = search(chosen)
+            if result is not None:
+                return result
+            chosen.pop()
+            used.remove(int(a))
+            used.remove(int(b))
+        return None
