+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == 0 or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
