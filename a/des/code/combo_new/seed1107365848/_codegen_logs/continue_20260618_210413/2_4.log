+            arr = np.array(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            mask[arr[:, 0] - r0, arr[:, 1] - c0] = True
+
+            components.append(
+                {
+                    "index": len(components),
+                    "color": color,
+                    "coords": arr,
+                    "area": int(arr.shape[0]),
+                    "r0": r0,
+                    "c0": c0,
+                    "r1": r1,
+                    "c1": c1,
+                    "mask": mask,
