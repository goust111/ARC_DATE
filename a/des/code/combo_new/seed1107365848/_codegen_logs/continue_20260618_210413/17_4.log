+    total_area = sum(int(mask.sum()) for _color, mask in objects)
+    min_inner_cols = max(6, math.ceil(total_area / max(1.0, 0.28 * height)))
+    min_width = 1 + SPACER_COLS + min_inner_cols
+    if min_width > ARC_GRID_LIMIT:
