+    fill = g[ir0 + 1 : ir1, ic0 + 1 : ic1]
+    vals = np.unique(fill)
+    if vals.size != 1:
+        return None
+    fill_color = int(vals[0])
+    if fill_color in {bg, int(outer["color"]), int(inner["color"])}:
+        return None
