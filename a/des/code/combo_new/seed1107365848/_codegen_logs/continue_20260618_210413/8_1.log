+        "outer_id": id(outer),
+        "inner_id": id(inner),
+        "outer_color": int(outer["color"]),
+        "inner_color": int(inner["color"]),
+        "fill_color": fill_color,
+        "fill_bbox": (ir0 + 1, ic0 + 1, ir1 - 1, ic1 - 1),
