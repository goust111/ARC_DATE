+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _get_bg(g: np.ndarray) -> int:
+    vals, counts = np.unique(g, return_counts=True)
+    return int(vals[int(np.argmax(counts))])
+
+
+def _components(g: np.ndarray, bg: int) -> list[dict]:
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+            color = int(g[r, c])
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            r0, c0 = map(int, arr.min(axis=0))
+            r1, c1 = map(int, arr.max(axis=0))
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _frame_bbox(component: dict) -> tuple[int, int, int, int] | None:
+    r0, c0, r1, c1 = component["bbox"]
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return None
+    expected = {
+        (r, c0) for r in range(r0, r1 + 1)
+    } | {
+        (r, c1) for r in range(r0, r1 + 1)
+    } | {
+        (r0, c) for c in range(c0, c1 + 1)
+    } | {
+        (r1, c) for c in range(c0, c1 + 1)
+    }
+    actual = {tuple(map(int, p)) for p in component["coords"]}
+    if actual != expected:
+        return None
+    return int(r0), int(c0), int(r1), int(c1)
