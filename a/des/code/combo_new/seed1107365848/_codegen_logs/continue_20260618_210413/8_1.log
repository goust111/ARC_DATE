+    outer_inner = g[or0 + 1 : or1, oc0 + 1 : oc1]
+    mask = np.zeros_like(outer_inner, dtype=bool)
+    mask[ir0 - or0 - 1 : ir1 - or0, ic0 - oc0 - 1 : ic1 - oc0] = True
+    if not np.all(outer_inner[~mask] == bg):
+        return None
