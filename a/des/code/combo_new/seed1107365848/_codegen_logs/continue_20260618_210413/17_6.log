+    max_cells = max(min_cells, h * w - 1)
+
+    for _ in range(120):
+        target = rng.randint(min_cells, max_cells)
+        support = _grown_mask(h, w, target, rng)
+        rows, cols = np.where(support)
+        if len(rows) < 3 or np.all(support):
+            continue
+        if h > 1 and len(set(map(int, rows))) == 1:
+            continue
