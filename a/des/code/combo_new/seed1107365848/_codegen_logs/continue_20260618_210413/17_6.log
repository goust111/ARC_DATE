+    while int(mask.sum()) < target and attempts < h * w * 20:
+        attempts += 1
+        cells = list(zip(*np.where(mask)))
+        r, c = cells[rng.randrange(len(cells))]
+        dr, dc = NEIGHBORS_4[rng.randrange(len(NEIGHBORS_4))]
+        nr = int(r + dr)
+        nc = int(c + dc)
+        if 0 <= nr < h and 0 <= nc < w:
+            mask[nr, nc] = True
+
