+    bg = _get_bg(g)
+    by_color: dict[int, list[dict[str, object]]] = defaultdict(list)
+
+    for color in map(int, np.unique(g)):
+        if color == bg:
+            continue
+        for coords in _components_of_color(g, color):
+            sig = _frame_signature(coords)
+            if sig is not None:
+                sig["color"] = color
+                by_color[color].append(sig)
