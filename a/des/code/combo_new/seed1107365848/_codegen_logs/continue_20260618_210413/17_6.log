+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+ARC_LIMIT = 30
+GEN_CANVAS = 30
+GEN_RETRIES = 400
+GEN_PLACEMENT_TRIES = 200
+GEN_PAIR_COUNTS = (2, 3, 4)
+GEN_INTERIOR_MIN = 2
+GEN_INTERIOR_MAX = 5
+GEN_MIN_MARGIN = 1
+GEN_MAX_EXTRA_MARGIN = 4
+NEIGHBORS_4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+ROTATION_K = {"up": 0, "right": 3, "down": 2, "left": 1}
+CARDINALS = ("up", "right", "down", "left")
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    components: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or int(grid[r, c]) != color:
+                continue
+            visited[r, c] = True
+            queue = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((cr, cc))
+                for dr, dc in NEIGHBORS_4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(grid[nr, nc]) == color:
+                        visited[nr, nc] = True
+                        queue.append((nr, nc))
+            components.append(coords)
+
+    return components
+
+
+def _frame_signature(
+    coords: list[tuple[int, int]]
+) -> dict[str, object] | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+
+    perimeter = np.zeros((h, w), dtype=bool)
+    perimeter[0, :] = True
+    perimeter[-1, :] = True
+    perimeter[:, 0] = True
+    perimeter[:, -1] = True
+
+    if np.any(mask & ~perimeter):
+        return None
+
+    missing = np.argwhere(perimeter & ~mask)
+    if len(missing) > 1:
+        return None
+
+    gap_side = None
+    if len(missing) == 1:
+        mr, mc = map(int, missing[0])
+        if (mr in (0, h - 1)) and (mc in (0, w - 1)):
+            return None
+        if mr == 0:
+            gap_side = "up"
+        elif mr == h - 1:
+            gap_side = "down"
+        elif mc == 0:
+            gap_side = "left"
+        elif mc == w - 1:
+            gap_side = "right"
+        else:
+            return None
+
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "gap_side": gap_side,
+        "shape": (h, w),
+    }
+
+
+def _crop_interior(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return np.array(grid[r0 + 1 : r1, c0 + 1 : c1], dtype=int, copy=True)
