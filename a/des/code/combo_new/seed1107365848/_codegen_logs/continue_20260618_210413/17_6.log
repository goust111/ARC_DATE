+def _random_pattern(
+    h: int,
+    w: int,
+    bg: int,
+    palette: list[int],
+    rotation_k: int,
+    rng: random.Random,
+) -> np.ndarray | None:
+    min_cells = max(3, (h * w + 3) // 4)
+    max_cells = max(min_cells, h * w - 1)
+
+    for _ in range(120):
+        target = rng.randint(min_cells, max_cells)
+        support = _grown_mask(h, w, target, rng)
