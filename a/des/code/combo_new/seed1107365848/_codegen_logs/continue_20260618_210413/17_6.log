+        rotated = np.rot90(pattern, ROTATION_K[str(room["gap_side"])])
+        target = _crop_interior(out, room["bbox"])
+        assert rotated.shape == target.shape, f"rotated pattern shape {rotated.shape} does not fit room {target.shape}"
+        target[:, :] = rotated
+        paired += 1
