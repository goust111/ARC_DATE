+        rng.shuffle(directions)
+        return directions
+    if n_pairs == 3:
+        directions = rng.sample(CARDINALS, 3)
+        rng.shuffle(directions)
+        return directions
+    directions = list(CARDINALS)
+    rng.shuffle(directions)
+    return directions
