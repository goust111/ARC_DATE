+GEN_INTERIOR_MIN = 2
+GEN_INTERIOR_MAX = 5
+GEN_MIN_MARGIN = 1
+GEN_MAX_EXTRA_MARGIN = 4
+NEIGHBORS_4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
