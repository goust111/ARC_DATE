+    c0, c1 = min(cols), max(cols)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 3 or width < 3:
+        return None
+    expected = 2 * height + 2 * width - 4
+    if len(coords) != expected:
