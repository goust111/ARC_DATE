+    if horizontal:
+        min_h = max(stamp_side, canvas_side)
+        min_w = stamp_side + canvas_side + gap
+        extra_h = int(_RNG.integers(0, 31 - min_h))
+        extra_w = int(_RNG.integers(0, 31 - min_w))
