+        stamp_c = int(_RNG.integers(0, w - stamp_side + 1))
+        canvas_c = int(_RNG.integers(0, w - canvas_side + 1))
+
+    return (h, w), (stamp_r, stamp_c), (canvas_r, canvas_c)
