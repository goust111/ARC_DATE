    if fill_container:
        if len(containers) != 1 or containers[0] != u_box:
            return False
    elif containers and containers[0][2] <= marker_c <= containers[0][3]:
        return False

    try:
        actual = main(inp)
    except Exception:
        return False
    return np.array_equal(actual, expected)


