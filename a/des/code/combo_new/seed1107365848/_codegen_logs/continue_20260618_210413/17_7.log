+def _separator_rows_and_cols(grid: np.ndarray, bg: int, divider: int) -> tuple[list[int], list[int]]:
+    h, w = grid.shape
+    rows = [
+        r
+        for r in range(h)
+        if np.all((grid[r] == bg) | (grid[r] == divider)) and np.count_nonzero(grid[r] == divider) >= (w + 1) // 2
+    ]
+    cols = [
+        c
