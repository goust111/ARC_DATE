+
+def _find_seeds(grid: np.ndarray, legend_mask: np.ndarray) -> list[tuple[int, int, int]]:
+    seed_mask = (grid != BLACK) & (grid != GREY) & (~legend_mask)
+    seeds: list[tuple[int, int, int]] = []
+    for comp in _components(seed_mask):
