+def _growth_cells(
+    pot: tuple[int, int, int, int], direction: str, gap: int, template: np.ndarray
+) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = pot
+    center_col = (c0 + c1) // 2
+    center_row = (r0 + r1) // 2
+    cells: set[tuple[int, int]] = set()
+    for layer in range(gap):
+        for depth, cross in _template_points(template):
+            if direction == "up":
+                rr = r0 - 1 - layer - depth
+                cc = center_col + cross
+            elif direction == "down":
+                rr = r1 + 1 + layer + depth
+                cc = center_col + cross
+            elif direction == "left":
+                rr = center_row + cross
+                cc = c0 - 1 - layer - depth
+            else:
