+    center_col = (c0 + c1) // 2
+    center_row = (r0 + r1) // 2
+    if direction == "up":
+        return r0 - gap - 1, center_col
+    if direction == "down":
+        return r1 + gap + 1, center_col
+    if direction == "left":
+        return center_row, c0 - gap - 1
+    return center_row, c1 + gap + 1
+
+
+def _render_output(grid: np.ndarray) -> np.ndarray:
