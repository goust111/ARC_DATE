+
+def _pair_seed(
+    grid: np.ndarray, seed: tuple[int, int, int], pots: list[tuple[int, int, int, int]]
+) -> tuple[int, str, int]:
+    sr, sc, _ = seed
+    matches: list[tuple[int, str, int]] = []
+    for idx, (r0, c0, r1, c1) in enumerate(pots):
+        if c0 <= sc <= c1:
