+
+    if not _intended_specs_match(grid, specs):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        rng = random.Random()
+        grid = _gen_attempt(rng)
+        if grid is not None:
