+    sr, sc, _ = seed
+    matches: list[tuple[int, str, int]] = []
+    for idx, (r0, c0, r1, c1) in enumerate(pots):
+        if c0 <= sc <= c1:
+            if sr < r0 and np.all(grid[sr + 1 : r0, sc] == BLACK):
+                matches.append((r0 - sr - 1, "up", idx))
