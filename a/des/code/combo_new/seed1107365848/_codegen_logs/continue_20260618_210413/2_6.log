+def _template_points(template: np.ndarray) -> list[tuple[int, int]]:
+    h, w = template.shape
+    mid = w // 2
+    return [
+        (r, c - mid)
+        for r in range(h)
+        for c in range(w)
+        if bool(template[r, c])
+    ]
