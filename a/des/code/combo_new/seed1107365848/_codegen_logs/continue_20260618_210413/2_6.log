+BLACK = 0
+GREY = 5
+
+# Canonical templates: depth grows from row 0 (near the pot) to row 1 (farther away).
+TEMPLATES = {
+    1: np.array([[1, 0, 1], [0, 1, 0]], dtype=bool),
+    2: np.array([[0, 1, 0], [1, 1, 1]], dtype=bool),
+    3: np.array([[1, 1, 1], [0, 1, 0]], dtype=bool),
