+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+QUADRANTS = (0, 1, 2, 3)  # TL, TR, BL, BR
+MISSING_CORNERS = (
+    ("top", "left"),
+    ("top", "right"),
+    ("bottom", "left"),
+    ("bottom", "right"),
+)
+OBJECT_KINDS = ("wide", "tall")
