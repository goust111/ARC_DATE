+                    "color": color,
+                    "coords": coords_arr,
+                    "area": int(coords_arr.shape[0]),
+                    "bbox": (
+                        int(rows.min()),
+                        int(cols.min()),
+                        int(rows.max()),
+                        int(cols.max()),
+                    ),
+                }
+            )
