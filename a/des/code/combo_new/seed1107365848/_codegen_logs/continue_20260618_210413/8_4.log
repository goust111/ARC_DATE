+import random
+from collections import deque
+
+import numpy as np
+
+
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+FRAME_COLOR = 5
+BG_CHOICES = [0, 1, 2, 3, 4, 6, 7, 8, 9]
+GEN_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 120
+PLACE_ATTEMPTS = 220
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIRS:
+        yield r + dr, c + dc
+
+
+def _find_components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _normalize(coords: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    r0, c0, _, _ = _bbox(coords)
+    return sorted((r - r0, c - c0) for r, c in coords)
+
+
+def _expand8(cells: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
+    out = set()
+    for r, c in cells:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    out.add((nr, nc))
+    return out
+
+
+def _legend_candidates(grid: np.ndarray, bg: int):
+    h, w = grid.shape
+    candidates = []
+
