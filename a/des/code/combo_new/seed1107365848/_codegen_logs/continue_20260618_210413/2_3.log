+        return None
+    path = []
+    current = goal
+    while current is not None:
+        path.append(current)
+        current = prev[current]
+    path.reverse()
+    return path
+
+
+def _choose_path(rng, room_rows, room_cols, starts, goals, blocked, min_len, max_len):
+    starts = list(starts)
+    goals = list(goals)
