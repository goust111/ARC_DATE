+
+def _bfs_path(start, goal, room_rows, room_cols, blocked, rng):
+    queue = deque([start])
+    prev = {start: None}
+    while queue:
+        current = queue.popleft()
+        if current == goal:
+            break
+        nbrs = _neighbors(current, room_rows, room_cols)
+        rng.shuffle(nbrs)
+        for nxt in nbrs:
+            if nxt in prev:
+                continue
+            if nxt in blocked and nxt != goal:
+                continue
+            prev[nxt] = current
+            queue.append(nxt)
