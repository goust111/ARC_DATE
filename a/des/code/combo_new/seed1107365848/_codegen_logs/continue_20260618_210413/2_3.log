            free_starts = [room for room in rooms if room not in used]
            path = _choose_path(
                rng,
                room_rows,
                room_cols,
                free_starts,
                [join],
                blocked=used - {join},
                min_len=2,
                max_len=4,
            )
            if path is None:
                continue
            _assign_path_arrows(path, arrows)
            used.update(path[:-1])
            source_rooms.append(path[0])
            collision_pair = (base_path[0], path[0])
            break
