+
+BLACK = 0
+RED = 2
+GREY = 5
+PAYLOAD_COLORS = (1, 3, 4, 6, 7, 8, 9)
+
+DIR_VECS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+ARROW_PATTERNS = {
+    "up": frozenset({(0, 0), (0, 1), (0, 2), (1, 1), (2, 1)}),
+    "down": frozenset({(0, 1), (1, 1), (2, 0), (2, 1), (2, 2)}),
+    "left": frozenset({(0, 0), (1, 0), (1, 1), (1, 2), (2, 0)}),
+    "right": frozenset({(0, 2), (1, 0), (1, 1), (1, 2), (2, 2)}),
+}
+
+_GEN_RETRIES = 300
+_BASE_SHAPES = [
