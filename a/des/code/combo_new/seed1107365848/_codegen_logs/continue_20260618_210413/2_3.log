    row_spans, col_spans, arrows, payloads = _parse_scene(g)
    room_rows = len(row_spans)
    room_cols = len(col_spans)

    out = g.copy()
    out[out == RED] = BLACK

    source_rooms = []
    for room, payload in payloads.items():
        if room in arrows:
            source_rooms.append(room)
            r0, _ = row_spans[room[0]]
            _, c0 = col_spans[room[1]]
