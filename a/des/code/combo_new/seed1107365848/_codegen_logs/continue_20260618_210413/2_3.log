+def _edge_rooms(room_rows, room_cols):
+    out = []
+    for rr in range(room_rows):
+        for cc in range(room_cols):
+            if rr in (0, room_rows - 1) or cc in (0, room_cols - 1):
+                out.append((rr, cc))
+    return out
+
+
+def _outward_directions(room, room_rows, room_cols):
+    rr, cc = room
+    out = []
+    if rr == 0:
+        out.append("up")
+    if rr == room_rows - 1:
+        out.append("down")
+    if cc == 0:
+        out.append("left")
+    if cc == room_cols - 1:
+        out.append("right")
+    return out
+
