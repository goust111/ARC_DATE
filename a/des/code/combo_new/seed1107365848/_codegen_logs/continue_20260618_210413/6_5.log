+    if (r, c) == (0, 0):
+        return "tl"
+    if (r, c) == (0, w - 1):
+        return "tr"
+    if (r, c) == (h - 1, w - 1):
+        return "br"
+    if (r, c) == (h - 1, 0):
+        return "bl"
+    return None
+
