+    return {
+        "kind": "envelope",
+        "color": color,
+        "corner": corner,
+        "hole_shape": (cut_h, cut_w),
+        "hole_origin_local": hole_origin,
+        "patch_shape": tuple(map(int, patch.shape)),
+    }
