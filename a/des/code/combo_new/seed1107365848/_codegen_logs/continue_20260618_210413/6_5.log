+
+GEN_COLOR_POOL = [1, 3, 4, 5, 6, 7, 8, 9]
+PAIR_COUNT_RANGE = (1, 3)
+GRID_SIDE_RANGE = (18, 30)
+ENVELOPE_SIDE_RANGE = (7, 12)
