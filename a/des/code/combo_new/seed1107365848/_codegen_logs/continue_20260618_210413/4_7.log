+BG = 0
+PALETTE = tuple(range(1, 10))
+DIRECTIONS = ("up", "down", "left", "right")
+ARROW_SPANS = (5, 7)
+TEMPLATE_SIZES = (2, 3)
+GRID_MIN = 22
+GRID_MAX = 30
+MIN_GAP = 1
+GENERATION_ATTEMPTS = 500
+OBJECT_ATTEMPTS = 160
+TEMPLATE_ATTEMPTS = 100
+_RNG = np.random.default_rng()
