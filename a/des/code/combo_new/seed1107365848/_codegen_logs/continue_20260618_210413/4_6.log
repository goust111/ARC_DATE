+
+def _enclosed_holes(mask: np.ndarray) -> list[np.ndarray]:
+    holes = []
+    h, w = mask.shape
+    for comp in _components(~mask):
+        if np.any(comp[:, 0] == 0) or np.any(comp[:, 0] == h - 1):
+            continue
+        if np.any(comp[:, 1] == 0) or np.any(comp[:, 1] == w - 1):
