+
+def _random_transform(mask: np.ndarray, rng: random.Random) -> np.ndarray:
+    out = np.rot90(mask, rng.randrange(4))
+    if rng.random() < 0.5:
+        out = np.fliplr(out)
+    return out.copy()
+
