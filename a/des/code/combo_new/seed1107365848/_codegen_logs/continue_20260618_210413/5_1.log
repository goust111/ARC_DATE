+    inp = out.copy()
+    for entity in entities:
+        patch = entity["ext_patch"]
+        rr = entity["ext_r0"]
+        cc = entity["ext_c0"]
+        mask = patch != _GEN_BG
+        inp[rr : rr + patch.shape[0], cc : cc + patch.shape[1]][mask] = _GEN_BG
