+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _component_patch(component: dict, bg: int) -> np.ndarray:
+    r0, c0, r1, c1 = component["bbox"]
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+    patch[
+        component["coords"][:, 0] - r0,
+        component["coords"][:, 1] - c0,
+    ] = int(component["color"])
+    return patch
+
+
+def _side_gap(present: np.ndarray) -> tuple[int, int] | None:
+    missing = np.flatnonzero(~present)
+    if missing.size == 0:
+        return (-1, -1)
+    if missing.size < 2:
+        return None
+    if int(missing[-1]) - int(missing[0]) + 1 != int(missing.size):
+        return None
+    if int(missing[0]) == 0 or int(missing[-1]) == len(present) - 1:
+        return None
+    return int(missing[0]), int(missing.size)
