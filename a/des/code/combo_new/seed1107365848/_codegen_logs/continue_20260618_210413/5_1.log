                continue
        else:
            if bool(np.array_equal(mask, np.fliplr(mask))):
                continue
        return mask
    return None


def _make_patch(mask: np.ndarray, color: int) -> np.ndarray:
    patch = np.zeros(mask.shape, dtype=int)
    patch[mask] = color
    return patch


