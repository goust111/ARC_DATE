+    frame_h = random.randint(_FRAME_SIZE_MIN, _FRAME_SIZE_MAX)
+    frame_w = random.randint(_FRAME_SIZE_MIN, _FRAME_SIZE_MAX)
+    inner_h = frame_h - 2
+    inner_w = frame_w - 2
+    max_ph = min(_PATTERN_SIZE_MAX, inner_h)
+    max_pw = min(_PATTERN_SIZE_MAX, inner_w)
