+    return out
+
+
+# --------------- generator ---------------
+
+_GEN_BG = 0
+_PALETTE = tuple(range(1, 10))
+_SIDES = ("top", "bottom", "left", "right")
+
+_GRID_MIN = 18
+_GRID_MAX = 30
+_FRAME_COUNT_RANGE = (2, 4)
+_FRAME_SIZE_MIN = 6
+_FRAME_SIZE_MAX = 10
+_PATTERN_SIZE_MIN = 2
+_PATTERN_SIZE_MAX = 4
+
+_OUTER_RETRIES = 400
+_ENTITY_RETRIES = 120
+_SHAPE_RETRIES = 200
