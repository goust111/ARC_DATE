+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _component_patch(component: dict, bg: int) -> np.ndarray:
+    r0, c0, r1, c1 = component["bbox"]
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+    patch[
+        component["coords"][:, 0] - r0,
+        component["coords"][:, 1] - c0,
+    ] = int(component["color"])
+    return patch
+
+
+def _side_gap(present: np.ndarray) -> tuple[int, int] | None:
+    missing = np.flatnonzero(~present)
+    if missing.size == 0:
+        return (-1, -1)
+    if missing.size < 2:
+        return None
+    if int(missing[-1]) - int(missing[0]) + 1 != int(missing.size):
+        return None
+    if int(missing[0]) == 0 or int(missing[-1]) == len(present) - 1:
+        return None
+    return int(missing[0]), int(missing.size)
+
+
+def _detect_frame(component: dict) -> dict | None:
+    r0, c0, r1, c1 = component["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 5 or w < 5:
+        return None
+
+    pts = {tuple(map(int, rc)) for rc in component["coords"]}
+    for r, c in pts:
+        if r not in (r0, r1) and c not in (c0, c1):
+            return None
+
+    top = np.array([(r0, c) in pts for c in range(c0, c1 + 1)], dtype=bool)
+    bottom = np.array([(r1, c) in pts for c in range(c0, c1 + 1)], dtype=bool)
+    left = np.array([(r, c0) in pts for r in range(r0, r1 + 1)], dtype=bool)
+    right = np.array([(r, c1) in pts for r in range(r0, r1 + 1)], dtype=bool)
+
+    gaps: list[tuple[str, int, int]] = []
+    for side, present in (
+        ("top", top),
+        ("bottom", bottom),
+        ("left", left),
+        ("right", right),
+    ):
+        gap = _side_gap(present)
+        if gap is None:
+            return None
+        if gap != (-1, -1):
+            gaps.append((side, gap[0], gap[1]))
+        elif not bool(present.all()):
+            return None
+
+    if len(gaps) != 1:
+        return None
+
+    side, gap_start, gap_width = gaps[0]
+    expected_area = 2 * (h + w) - 4 - gap_width
+    if int(component["area"]) != expected_area:
+        return None
+
+    return {
+        "side": side,
+        "gap_start": gap_start,
+        "gap_width": gap_width,
+    }
