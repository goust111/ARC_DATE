+        if entity is None:
+            return None
+        reserved |= entity["reserve_mask"]
+        entities.append(entity)
+
+    out = np.zeros((h, w), dtype=int)
+    for entity in entities:
+        r0, c0, r1, c1 = entity["frame_bbox"]
+        _draw_frame(
+            out,
+            r0,
+            c0,
+            entity["frame_h"],
+            entity["frame_w"],
+            entity["frame_color"],
+            entity["side"],
+            entity["gap_start"],
+            entity["gap_width"],
