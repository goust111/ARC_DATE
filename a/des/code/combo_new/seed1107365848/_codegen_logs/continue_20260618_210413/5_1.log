+    elif side == "bottom":
+        r0_lo, r0_hi = 0, h_total - frame_h - ph
+        c0_lo, c0_hi = 0, w_total - frame_w
+    elif side == "left":
+        r0_lo, r0_hi = 0, h_total - frame_h
+        c0_lo, c0_hi = pw, w_total - frame_w
+    else:
+        r0_lo, r0_hi = 0, h_total - frame_h
