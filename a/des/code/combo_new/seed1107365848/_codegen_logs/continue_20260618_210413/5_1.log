+        elif side == "bottom":
+            ext_r0, ext_c0 = r0 + frame_h, pc0
+        elif side == "left":
+            ext_r0, ext_c0 = pr0, c0 - pw
+        else:
+            ext_r0, ext_c0 = pr0, c0 + frame_w
