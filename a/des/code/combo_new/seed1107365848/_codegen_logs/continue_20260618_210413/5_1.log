+    entities = []
+
+    for idx in range(n_frames):
+        entity = None
+        for _ in range(_ENTITY_RETRIES):
+            entity = _entity_attempt(
+                (h, w),
+                reserved,
+                sides[idx],
+                colors[2 * idx],
+                colors[2 * idx + 1],
+            )
+            if entity is not None:
