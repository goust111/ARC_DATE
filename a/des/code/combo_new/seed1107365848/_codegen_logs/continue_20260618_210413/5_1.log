+        side = frame_info["side"]
+        if side == "top":
+            flipped = np.flipud(patch)
+            dest_r = r0 - patch.shape[0]
+            dest_c = pc0
+        elif side == "bottom":
+            flipped = np.flipud(patch)
+            dest_r = r1 + 1
+            dest_c = pc0
+        elif side == "left":
+            flipped = np.fliplr(patch)
+            dest_r = pr0
+            dest_c = c0 - patch.shape[1]
+        else:
+            assert side == "right"
+            flipped = np.fliplr(patch)
+            dest_r = pr0
+            dest_c = c1 + 1
