        if covered and len(covered) < (rect["r1"] - rect["r0"] + 1):
            partial_band_exists = True

    if not changed_rect_exists or not partial_band_exists:
        return None
    return active_rows


def _build_input(
    height: int,
    width: int,
    mapping: dict[int, int],
    rects: list[dict[str, int]],
    active_rows: list[int],
    rng: random.Random,
) -> np.ndarray:
    grid = np.full((height, width), BG, dtype=int)

    pairs = list(mapping.items())
    rng.shuffle(pairs)
    start = rng.randint(1, width - _legend_width(len(pairs)))
    c = start
    for idx, (src, dst) in enumerate(pairs):
        grid[0, c] = int(src)
        grid[0, c + 1] = int(dst)
        c += 2
        if idx != len(pairs) - 1:
            c += 1

    for rect in rects:
        grid[rect["r0"] : rect["r1"] + 1, rect["c0"] : rect["c1"] + 1] = rect["color"]

    for row in active_rows:
        grid[row, 0] = ARROW

    return grid


def _expected_output(
    grid: np.ndarray,
    mapping: dict[int, int],
    rects: list[dict[str, int]],
    active_rows: list[int],
) -> np.ndarray:
