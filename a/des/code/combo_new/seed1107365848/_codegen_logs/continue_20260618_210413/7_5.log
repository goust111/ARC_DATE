+                canvas_in[r0 : r0 + bh, c0 : c0 + bw] = inp_block
+                canvas_out[r0 : r0 + bh, c0 : c0 + bw] = out_block
+                placed_boxes.append(box)
+                found = True
+                break
+        if not found:
+            return None
