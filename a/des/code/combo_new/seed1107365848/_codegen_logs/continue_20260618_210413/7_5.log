+            extra_h = base_extra + random.randint(0, 2) + (1 if piece_count == 4 and random.random() < 0.5 else 0)
+            extra_w = base_extra + random.randint(0, 2) + (1 if piece_count == 4 and random.random() < 0.5 else 0)
