+        max_dim = 4 if region_count == 3 else 5
+        for _ in range(120):
+            target_h = random.randint(3, max_dim)
+            target_w = random.randint(3, max_dim)
+            area = target_h * target_w
+            max_pieces = min(4, area // 2)
