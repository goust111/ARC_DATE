+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG_COLOR = 0
+FRAME_COLOR = 1  # blue
+CLUE_COLOR = 2   # red
+PIECE_COLORS = (3, 4, 5, 6, 7, 8, 9)
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MAX_GENERATION_ATTEMPTS = 300
