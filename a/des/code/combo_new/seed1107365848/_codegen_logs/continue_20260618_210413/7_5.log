+                break
+        if len(blocks) != idx + 1:
+            return None
+
+    placed = _place_blocks(blocks)
+    if placed is None:
+        return None
+    return placed
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        generated = _gen_attempt()
+        if generated is None:
+            continue
+        inp, out = generated
+        try:
