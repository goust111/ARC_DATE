+    frontiers = [set() for _ in range(k)]
+    sizes = [1] * k
+
+    def add_frontier(label: int, r: int, c: int) -> None:
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and labels[nr, nc] == -1:
