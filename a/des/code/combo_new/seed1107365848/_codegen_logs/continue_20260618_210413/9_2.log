+from __future__ import annotations
+
+import math
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+COLOR_POOL = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+MAX_GENERATION_ATTEMPTS = 400
+GROUP_BUILD_ATTEMPTS = 200
+PARTITION_ATTEMPTS = 80
+PLACEMENT_ATTEMPTS = 60
