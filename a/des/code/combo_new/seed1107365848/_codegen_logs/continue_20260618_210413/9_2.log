+def _solve_one_color(grid: np.ndarray, color: int, frame: tuple[int, int, int, int]) -> tuple[bool, list[list[tuple[int, int]]]]:
+    r0, c0, r1, c1 = frame
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+    if inner_h <= 0 or inner_w <= 0:
+        return False, []
