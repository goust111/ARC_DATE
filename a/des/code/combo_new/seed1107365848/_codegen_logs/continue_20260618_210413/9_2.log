+    h, w = occ.shape
+    positions = [(r, c) for r in range(h - height + 1) for c in range(w - width + 1)]
+    rng.shuffle(positions)
+    for top, left in positions:
+        if _can_place_rect(occ, top, left, height, width, gap):
+            _occupy_rect(occ, top, left, height, width)
