+    frames: dict[int, tuple[int, int, int, int]] = {}
+    for color in sorted(int(c) for c in np.unique(g) if int(c) != BG):
+        frame = _find_frame_for_color(g, color)
+        if frame is not None:
+            frames[color] = frame
