+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MOVE = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+ALL_COLORS = tuple(range(10))
+MAX_GEN_ATTEMPTS = 500
+MAX_PLACEMENT_ATTEMPTS = 150
+MAX_LOCAL_ATTEMPTS = 150
+MAX_SHIFT = 4
+MAX_OBJECT_SPAN = 4
+RESERVE_EXTRA = MAX_SHIFT + MAX_OBJECT_SPAN
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components_from_mask(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((int(cr), int(cc)))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _analyze_fence(
+    coords: list[tuple[int, int]],
+    color: int,
+) -> dict[str, object] | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 4 or w < 4:
+        return None
+
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in coords:
+        rr = r - r0
+        cc = c - c0
+        mask[rr, cc] = True
+        if 0 < rr < h - 1 and 0 < cc < w - 1:
+            return None
+
+    sides = {
+        "up": mask[0, :],
+        "down": mask[-1, :],
+        "left": mask[:, 0],
+        "right": mask[:, -1],
+    }
+
+    incomplete: list[tuple[str, int, int]] = []
+    for name, side in sides.items():
+        missing = np.flatnonzero(~side)
+        if missing.size == 0:
+            continue
+        if missing[0] == 0 or missing[-1] == len(side) - 1:
+            return None
+        if int(missing[-1] - missing[0] + 1) != int(missing.size):
+            return None
+        incomplete.append((name, int(missing[0]), int(missing[-1])))
+
+    if len(incomplete) != 1:
+        return None
+
+    direction, gap0, gap1 = incomplete[0]
+    return {
+        "color": int(color),
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "coords": [(int(r), int(c)) for r, c in coords],
+        "direction": direction,
+        "gap_span": (int(gap0), int(gap1)),
+    }
+
