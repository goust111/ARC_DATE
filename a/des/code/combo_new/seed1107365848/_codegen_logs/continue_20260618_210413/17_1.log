+def _random_composition(total: int, parts: int, rng: np.random.Generator) -> list[int]:
+    if parts == 1:
+        return [int(total)]
+    cuts = sorted(map(int, rng.integers(0, total + 1, size=parts - 1)))
+    values = []
+    prev = 0
+    for cut in cuts:
+        values.append(int(cut - prev))
+        prev = cut
+    values.append(int(total - prev))
+    return values
