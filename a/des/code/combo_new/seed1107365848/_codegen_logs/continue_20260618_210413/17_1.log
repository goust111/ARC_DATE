+def _random_connected_mask(
+    rng: np.random.Generator,
+    max_h: int,
+    max_w: int,
+    max_cells: int = 6,
+) -> np.ndarray | None:
+    for _ in range(100):
+        h = int(rng.integers(1, max_h + 1))
+        w = int(rng.integers(1, max_w + 1))
+        if h * w < 2:
+            continue
+        target = int(rng.integers(2, min(max_cells, h * w) + 1))
+        start = (int(rng.integers(0, h)), int(rng.integers(0, w)))
