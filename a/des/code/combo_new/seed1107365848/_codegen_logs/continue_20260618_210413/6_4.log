+            return None
+        if frame_seed[1] != c1:
+            return None
+    elif direction == "down":
+        if not all(r < r0 and c0 <= c <= c1 for r, c in arrow_cells):
+            return None
+        if frame_seed[0] != r0:
+            return None
+    else:
