+) -> dict[tuple[int, int], int]:
+    interior_h = r1 - r0 - 1
+    interior_w = c1 - c0 - 1
+    delta = gap_len // 2
+
+    if direction in ("right", "left"):
+        band_top = lane - delta
+        band_bottom = lane + delta
+        box_h = random.randint(1, gap_len)
