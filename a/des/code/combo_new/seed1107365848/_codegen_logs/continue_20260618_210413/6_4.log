+    b_r0, b_c0, b_r1, b_c1 = b_bbox
+
+    spec_a = _frame_spec(
+        a_r0,
+        a_c0,
+        a_r1 - a_r0 + 1,
+        a_c1 - a_c0 + 1,
+        pair_dir,
+        frame_colors[0],
+        content_palette,
+        lane=lane,
