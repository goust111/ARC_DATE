+
+def _component_from(mask: np.ndarray, start: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = mask.shape
+    sr, sc = start
+    if not mask[sr, sc]:
+        return set()
+    q = deque([(sr, sc)])
+    seen = {(sr, sc)}
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIRS.values():
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
