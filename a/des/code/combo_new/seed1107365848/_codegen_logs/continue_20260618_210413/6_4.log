+    reserved = np.zeros(shape, dtype=bool)
+    _reserve_actual(reserved, spec_a)
+    _reserve_actual(reserved, spec_b)
+    _mark_cells(reserved, _blocked_corridor(spec_a, spec_b["bbox"]))
