+    delta = gap_len // 2
+    if direction == "right":
+        return [(r, c1) for r in range(lane - delta, lane + delta + 1)]
+    if direction == "left":
+        return [(r, c0) for r in range(lane - delta, lane + delta + 1)]
+    if direction == "down":
