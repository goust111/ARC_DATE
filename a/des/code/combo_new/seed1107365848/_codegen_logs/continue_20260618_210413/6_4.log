+) -> set[tuple[int, int]]:
+    spec = ARROW_PATTERNS[direction]
+    shape_h, shape_w = spec["shape"]  # type: ignore[index]
+    cells = spec["cells"]  # type: ignore[index]
+    if direction == "right":
