+
+def _grow_shape(height: int, width: int, n_cells: int) -> set[tuple[int, int]]:
+    start = (random.randrange(height), random.randrange(width))
+    cells = {start}
+    while len(cells) < n_cells:
+        frontier = []
+        for r, c in cells:
+            for dr, dc in DIRS.values():
