+_OPS = {
+    "id": _op_identity,
+    "flip_h": _op_flip_h,
+    "flip_v": _op_flip_v,
+    "rot90": _op_rot90,
+    "rot180": _op_rot180,
+    "rot270": _op_rot270,
+}
+_OP_NAMES = list(_OPS)
+
