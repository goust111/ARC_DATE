+        transformed = _apply_op(obj["mask"], mapping[obj["holes"]])
+        r0, c0, r1, c1 = obj["bbox"]
+        hh, ww = transformed.shape
+        nr0 = (r0 + r1 - hh + 1) // 2
+        nc0 = (c0 + c1 - ww + 1) // 2
+        for rr, cc in np.argwhere(transformed):
+            gr = nr0 + int(rr)
+            gc = nc0 + int(cc)
+            if 0 <= gr < out.shape[0] and 0 <= gc < legend_c0:
+                out[gr, gc] = obj["color"]
