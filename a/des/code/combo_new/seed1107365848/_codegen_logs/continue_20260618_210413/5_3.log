+
+def _mask_from_strings(rows: list[str]) -> np.ndarray:
+    return np.array([[ch == "#" for ch in row] for row in rows], dtype=bool)
+
+
+_BASE_MASKS = {
+    0: _mask_from_strings(
+        [
+            "###..",
+            "#....",
+            "####.",
+            "..##.",
+            "...##",
+        ]
+    ),
+    1: _mask_from_strings(
+        [
+            "#####",
+            "###.#",
+            "#...#",
+            "#.#.#",
+            "#####",
+        ]
+    ),
+    2: _mask_from_strings(
+        [
+            "#####",
+            "#...#",
+            "#####",
+            "#..##",
+            "#####",
+        ]
