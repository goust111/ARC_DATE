+import numpy as np
+
+
+_BG = 0
+_GREY = 5
+_LEGEND_FG = 8
+_OBJECT_COLORS = [1, 2, 3, 4, 6, 7, 9]
+
+_CELL = 5
+_ROW_COUNT = 4
+_LEGEND_W = 2 * _CELL + 3
+_LEGEND_H = _ROW_COUNT * _CELL + (_ROW_COUNT + 1)
