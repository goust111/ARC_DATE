+    if any(cell in path_set for cell in marker_cells):
+        return None
+    if any(not _in_bounds((h, w), *cell) for cell in marker_cells):
+        return None
+
+    grid = np.full((h, w), BG, dtype=int)
+    for r, c in path:
+        grid[r, c] = path_color
+    for cell, color in zip(marker_cells, marker_colors):
