+
+    path_color = random.choice(ALL_COLORS[1:])
+    marker_palette = [color for color in ALL_COLORS[1:] if color != path_color]
+    if turns + 1 > len(marker_palette):
+        return None
+    marker_colors = random.sample(marker_palette, turns + 1)
+
