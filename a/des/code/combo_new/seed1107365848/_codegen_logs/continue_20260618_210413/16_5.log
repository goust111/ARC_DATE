+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _is_edge(cell: tuple[int, int], shape: tuple[int, int]) -> bool:
+    r, c = cell
+    return r == 0 or c == 0 or r == shape[0] - 1 or c == shape[1] - 1
+
