+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+ALL_COLORS = list(range(10))
+MIN_SIZE = 12
+MAX_SIZE = 24
+MIN_TURNS = 1
+MAX_TURNS = 6
+MIN_SEG_LEN = 2
+MAX_GEN_ATTEMPTS = 400
