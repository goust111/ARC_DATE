+
+    expected = _paint_expected(grid, path, start_marker, turn_markers)
+    sym_id = random.randrange(8)
+    grid = _apply_symmetry(grid, sym_id)
+    expected = _apply_symmetry(expected, sym_id)
+
+    solved = main(grid)
+    if not np.array_equal(solved, expected):
+        return None
+    return grid
