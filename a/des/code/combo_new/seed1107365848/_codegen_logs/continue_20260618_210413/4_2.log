+    shapes.sort(key=_shape_sort_key)
+    out_h = sum(int(shape["mask"].shape[0]) for shape in shapes)
+    out_w = max(int(shape["mask"].shape[1]) for shape in shapes)
+    out = np.full((out_h, out_w), bg, dtype=int)
