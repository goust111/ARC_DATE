+
+def _rotate_offsets(offsets: list[tuple[int, int]], turns: int) -> list[tuple[int, int]]:
+    turns %= 4
+    result = list(offsets)
+    for _ in range(turns):
+        result = _rotate_cw_offsets(result)
+    return result
