+
+def _compute_bounds(lengths: np.ndarray) -> list[tuple[int, int]]:
+    bounds = []
+    start = 0
+    for idx, length in enumerate(lengths):
+        bounds.append((start, start + int(length) - 1))
+        start += int(length)
+        if idx != len(lengths) - 1:
+            start += 1
+    return bounds
+
