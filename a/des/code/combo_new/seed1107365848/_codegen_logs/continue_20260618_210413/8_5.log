+def _anchor_pixel(coords: list[tuple[int, int]], gap: tuple[int, int]) -> tuple[int, int]:
+    gr, gc = gap
+    return min(
+        coords,
+        key=lambda rc: (
+            abs(rc[0] - gr) + abs(rc[1] - gc),
+            abs(rc[1] - gc),
+            abs(rc[0] - gr),
+            rc[0],
+            rc[1],
+        ),
+    )
