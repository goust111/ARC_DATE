+_RNG = np.random.default_rng()
+_GEN_RETRIES = 300
+_REGION_SIZE_MIN = 4
+_REGION_SIZE_MAX = 8
+_WALL_COUNT_MIN = 1
+_WALL_COUNT_MAX = 3
