+                target_region = edge["b"]
+            else:
+                dest_anchor = (gap_r - 1, gap_c)
+                target_region = edge["a"]
+        else:
+            if edge["a"] == region:
+                dest_anchor = (gap_r, gap_c + 1)
+                target_region = edge["b"]
+            else:
+                dest_anchor = (gap_r, gap_c - 1)
+                target_region = edge["a"]
+
+        dst_coords = [(dest_anchor[0] + dr, dest_anchor[1] + dc) for dr, dc in rotated]
+        tr0, tr1, tc0, tc1 = regions[target_region]
