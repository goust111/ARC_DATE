+def _is_connected(coords: list[tuple[int, int]]) -> bool:
+    if not coords:
+        return False
+    coord_set = set(coords)
+    stack = [coords[0]]
+    seen = {coords[0]}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if (nr, nc) in coord_set and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == len(coords)
+
