+def _region_bounds(separators: list[int], size: int) -> list[tuple[int, int]]:
+    bounds: list[tuple[int, int]] = []
+    start = 0
+    for sep in separators:
+        bounds.append((start, sep - 1))
+        start = sep + 1
+    bounds.append((start, size - 1))
+    return bounds
