+    horizontal_gaps: dict[int, int] = {}
+    vertical_gaps: dict[int, int] = {}
+    occupied_regions = {item["region"] for item in chosen_sources}
+    occupied_dests = {item["dest"] for item in chosen_sources}
+    if occupied_regions & occupied_dests:
