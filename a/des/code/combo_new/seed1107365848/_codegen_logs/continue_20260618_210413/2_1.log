+        coords.append((r1, c))
+    for r in range(r0 + 1, r1):
+        coords.append((r, c0))
+        coords.append((r, c1))
+    return coords
+
+
+def _expand_cells(cells: set[tuple[int, int]], shape: tuple[int, int]) -> set[tuple[int, int]]:
