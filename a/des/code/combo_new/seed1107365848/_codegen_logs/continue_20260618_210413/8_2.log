+# --------------- generator ---------------
+
+_CANVAS = 30
+_ATTEMPTS = 400
+_BODY_COUNT_CHOICES = [1, 2, 2, 3, 3, 4]
+_RECT_H_RANGE = (5, 10)
+_RECT_W_RANGE = (5, 10)
+_HOLE_COUNT_CHOICES = [1, 1, 2, 2, 3]
+_HOLE_AREA_CHOICES = [1, 2, 2, 3, 3, 4, 4, 5, 6]
+_CROP_MARGIN_RANGE = (1, 6)
