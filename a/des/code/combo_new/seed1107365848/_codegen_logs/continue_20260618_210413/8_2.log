+def _random_shape(area: int, rng: random.Random) -> frozenset[tuple[int, int]]:
+    cells = {(0, 0)}
+    while len(cells) < area:
+        frontier = []
+        for r, c in cells:
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) not in cells:
+                    frontier.append((nr, nc))
+        cells.add(rng.choice(frontier))
