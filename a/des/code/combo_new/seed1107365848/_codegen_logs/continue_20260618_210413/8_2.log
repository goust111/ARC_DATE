+    if rng.random() < 0.5:
+        cells = {(-r, c) for r, c in cells}
+    if rng.random() < 0.5:
+        cells = {(r, -c) for r, c in cells}
+    if rng.random() < 0.5:
+        cells = {(c, r) for r, c in cells}
+    return _norm_shape(cells)
