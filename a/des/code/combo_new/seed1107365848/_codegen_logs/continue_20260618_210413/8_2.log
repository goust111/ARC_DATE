+        for _ in range(80):
+            area = rng.choice(_HOLE_AREA_CHOICES)
+            shape = _random_shape(area, rng)
+            if shape in used_shapes:
+                continue
+            sh, sw = _shape_dims(shape)
+            if sh > rect_h - 2 or sw > rect_w - 2:
