        else:
            chosen = random.sample(shared_cols, n_conn)

        for c in chosen:
            for r in range(top_row, bot_row + 1):
                track.add((r, c))

    if not track:
        return None
    start_cell = next(iter(track))
    visited = _gen_bfs_dist(track, start_cell)
    if len(visited) != len(track):
