+    legend_items = list(mapping.items())
+    rng.shuffle(legend_items)
+    for i, (length, color) in enumerate(legend_items):
+        row = main_h + 1 + 2 * i
+        offset = rng.randint(0, legend_w - length)
+        start = main_w + 1 + offset
+        grid[row, start : start + length] = color
