+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    mapping = _legend_rows(rng)
+    legend_lengths = list(mapping)
+    legend_h = 2 * len(legend_lengths) - 1
+    legend_w = max(legend_lengths) + rng.randint(1, 3)
+
