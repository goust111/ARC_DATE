+    occupied: np.ndarray,
+    patch: np.ndarray,
+    rng: random.Random,
+) -> tuple[int, int] | None:
+    limit_h, limit_w = occupied.shape
+    ph, pw = patch.shape
+    spots: list[tuple[int, int]] = []
+    for r in range(limit_h - ph + 1):
+        for c in range(limit_w - pw + 1):
+            rr0 = max(0, r - 1)
+            rr1 = min(limit_h, r + ph + 1)
+            cc0 = max(0, c - 1)
+            cc1 = min(limit_w, c + pw + 1)
