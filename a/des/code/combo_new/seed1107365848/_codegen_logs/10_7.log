+    optional = [n for n in (3, 5) if rng.random() < 0.6]
+    lengths.extend(optional)
+    lengths = sorted(set(lengths))
+    colors = rng.sample(FILL_COLORS, len(lengths))
+    mapping = dict(zip(lengths, colors))
+    assert 4 in mapping and 6 in mapping
+    return mapping
