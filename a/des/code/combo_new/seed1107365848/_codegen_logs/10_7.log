    return patch


def _place_patch(
    canvas: np.ndarray,
    occupied: np.ndarray,
    patch: np.ndarray,
    rng: random.Random,
) -> tuple[int, int] | None:
    limit_h, limit_w = occupied.shape
    ph, pw = patch.shape
    spots: list[tuple[int, int]] = []
    for r in range(limit_h - ph + 1):
