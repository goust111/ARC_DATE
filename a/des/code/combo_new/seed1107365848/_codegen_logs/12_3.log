+    lock_base = LOCK_BASES[rng.randrange(len(LOCK_BASES))]
+    key_turns = rng.sample(range(4), 2)
+    key_colors = rng.sample(KEY_COLORS, 2)
+    lock_turns = [rng.randrange(4) for _ in range(2)]
+
+    for idx, row_slice in enumerate(row_slices):
