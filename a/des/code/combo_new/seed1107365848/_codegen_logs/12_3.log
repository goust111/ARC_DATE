+    g = np.asarray(grid, dtype=int)
+    row_slices, col_slices = _split_cells(g)
+    out = g.copy()
+
+    for row_slice in row_slices:
+        key_cell = g[row_slice, col_slices[0]]
+        lock_cell = g[row_slice, col_slices[1]]
+        out_cell = out[row_slice, col_slices[2]]
