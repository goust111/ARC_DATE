+    previous = -1
+    for stop in [*sorted(separators), size]:
+        start = previous + 1
+        end = stop - 1
+        if start <= end:
+            bounds.append((start, end))
+        previous = stop
+    assert bounds, "expected at least one non-separator band"
+    return bounds
+
+
+def _step_region(region: tuple[int, int], direction: str) -> tuple[int, int]:
