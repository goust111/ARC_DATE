+def _build_layout(row_heights: list[int], col_widths: list[int]) -> tuple[np.ndarray, list[tuple[int, int]], list[tuple[int, int]]]:
+    height = sum(row_heights) + len(row_heights) - 1
+    width = sum(col_widths) + len(col_widths) - 1
