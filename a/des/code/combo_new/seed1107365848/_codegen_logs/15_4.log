+    out = g.copy()
+    for (region_row, region_col), (_length, color) in winners.items():
+        r0, r1 = row_bands[region_row]
+        c0, c1 = col_bands[region_col]
+        patch = out[r0 : r1 + 1, c0 : c1 + 1]
+        patch[patch == BLACK] = color
