+        for c in range(board.shape[1])
+        if np.all(board[:, c] == board[0, c]) and int(board[0, c]) != int(bg)
+    }
+    common = row_colors & col_colors
+    assert len(common) == 1, f"expected a unique separator color, got {sorted(common)}"
+    return common.pop()
