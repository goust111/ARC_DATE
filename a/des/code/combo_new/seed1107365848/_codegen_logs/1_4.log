+    for rank, idx in enumerate(order):
+        target_idx = order[(rank + 1) % len(order)]
+        target_color = int(records[target_idx]["dominant_color"])
+        row_slice = records[idx]["row_slice"]
+        col_slice = records[idx]["col_slice"]
