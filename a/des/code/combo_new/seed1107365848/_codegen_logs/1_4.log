+def _border_majority_color(grid: np.ndarray) -> int:
+    border = np.concatenate(
+        [
+            grid[0, :],
+            grid[-1, :],
+            grid[1:-1, 0],
+            grid[1:-1, -1],
+        ]
+    )
+    colors, counts = np.unique(border, return_counts=True)
+    return int(colors[int(np.argmax(counts))])
