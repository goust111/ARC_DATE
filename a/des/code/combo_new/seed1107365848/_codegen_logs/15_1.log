+def _corner_bg(grid: np.ndarray) -> int:
+    corners = [
+        int(grid[0, 0]),
+        int(grid[0, -1]),
+        int(grid[-1, 0]),
+        int(grid[-1, -1]),
+    ]
+    return int(Counter(corners).most_common(1)[0][0])
