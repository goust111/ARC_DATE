+def _marker_cell(r0: int, c0: int, r1: int, c1: int, side: str) -> tuple[int, int]:
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+    mid_r = r0 + 1 + (inner_h - 1) // 2
+    mid_c = c0 + 1 + (inner_w - 1) // 2
+    if side == "top":
