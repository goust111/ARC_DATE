+    if quad == "tl":
+        sr, sc = qr0, qc0
+    elif quad == "tr":
+        sr, sc = qr0, qc1 - sw + 1
+    elif quad == "br":
+        sr, sc = qr1 - sh + 1, qc1 - sw + 1
+    else:
