+        clean_inner = inner.copy()
+        clean_inner[0, 0] = bg
+        clean_inner[0, -1] = bg
+        clean_inner[-1, 0] = bg
+        clean_inner[-1, -1] = bg
+        if not np.all(clean_inner == bg):
