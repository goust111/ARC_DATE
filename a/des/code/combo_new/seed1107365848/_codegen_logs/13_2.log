+    q = rng.randint(3, 6)
+    frame_h = 2 * q + 2
+    frame_w = 2 * q + 2
+    min_margin = q + 2
+    h = rng.randint(frame_h + 2 * min_margin, 30)
+    w = rng.randint(frame_w + 2 * min_margin, 30)
+    r0 = rng.randint(min_margin, h - frame_h - min_margin)
+    c0 = rng.randint(min_margin, w - frame_w - min_margin)
