+    view = out[sr : sr + sh, sc : sc + sw]
+    view[mask] = int(color)
+
+
+def _find_frame(grid: np.ndarray, bg: int) -> tuple[tuple[int, int, int, int], int, dict[str, int]]:
+    best = None
+    colors = [int(c) for c in np.unique(grid) if int(c) != int(bg)]
+    for color in colors:
