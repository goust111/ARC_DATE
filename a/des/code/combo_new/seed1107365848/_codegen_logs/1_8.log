+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+ARROW_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PAIR_COUNT_CHOICES = (2, 3, 4)
+GENERATE_RETRIES = 300
+PAIR_RETRIES = 150
+PLACEMENT_RETRIES = 250
