+        sprite = comps[partners[0]]
+        dr, dc = arrow["direction"]
+        dist = int(arrow["length"])
+        arrow_color = int(comp["color"])
+        for r, c in sprite["coords"]:
+            rr = r + dr * dist
+            cc = c + dc * dist
+            if 0 <= rr < h and 0 <= cc < w:
