+    tail = stem[-1]
+    stem_len = len(stem)
+    if len(graph[tail]) != 1 or not (2 <= stem_len <= 5):
+        return None
+    if len(coords) != stem_len + 2:
+        return None
+
+    direction = (-stem_step[0], -stem_step[1])
+    return {
+        "junction": junction,
+        "tail": tail,
+        "direction": direction,
+        "length": stem_len,
+        "coords": set(coords),
