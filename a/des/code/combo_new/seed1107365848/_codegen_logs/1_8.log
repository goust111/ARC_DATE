+                tail = (attach[0] + dr, attach[1] + dc)
+                junction = (attach[0] + dr * length, attach[1] + dc * length)
+                stem = {(attach[0] + dr * step, attach[1] + dc * step) for step in range(1, length + 1)}
+                arrow = set(stem)
+                arrow.add((junction[0] + cap_dir[0], junction[1] + cap_dir[1]))
+                arrow.add((junction[0] - cap_dir[0], junction[1] - cap_dir[1]))
