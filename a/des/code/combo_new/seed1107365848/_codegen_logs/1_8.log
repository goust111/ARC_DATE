+    direction = (-stem_step[0], -stem_step[1])
+    return {
+        "junction": junction,
+        "tail": tail,
+        "direction": direction,
+        "length": stem_len,
+        "coords": set(coords),
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
