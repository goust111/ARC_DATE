+        tail = arrow["tail"]
+        partners = sorted(
+            j
+            for j in adjacent[arrow_idx]
+            if any(nbr in set(comps[j]["coords"]) for nbr in neighbors4(*tail))
+        )
+        if len(partners) != 1:
