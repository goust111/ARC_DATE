  "type": "move_along_path",
  "src": "single marker pixels that have exactly one marker on the opposite side of the same row or column through the largest foreground-color barrier",
  "path": "move along that row or column across the contiguous barrier segment",
  "dst": "the background cell immediately beyond the opposite side of the barrier segment",
  "trajectory": "paint only the final adjacent cell on each side with the opposite marker color",
  "transform": "erase the original paired marker cells; leave the barrier and unpaired markers unchanged"
}
</annotation>
</reference_puzzle>

