+def _path_endpoints(path_mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = path_mask.shape
+    coords = np.argwhere(path_mask)
+    assert len(coords) >= 2, "expected an open path with at least two blue pixels"
