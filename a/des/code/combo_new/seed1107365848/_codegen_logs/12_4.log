+
+def _extend_segment(
+    current: tuple[int, int],
+    direction: tuple[int, int],
+    length: int,
+    occupied: set[tuple[int, int]],
+    reserved_markers: set[tuple[int, int]],
+    h: int,
+    w: int,
+) -> list[tuple[int, int]] | None:
+    prev = current
+    temp_occupied = set(occupied)
+    cells: list[tuple[int, int]] = []
