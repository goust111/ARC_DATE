+def _is_rect_frame(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    if len(coords) != 2 * (h + w) - 4:
+        return False
+    coord_set = {tuple(map(int, xy)) for xy in coords}
+    expected: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        expected.add((r0, c))
+        expected.add((r1, c))
