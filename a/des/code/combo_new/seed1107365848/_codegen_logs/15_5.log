+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _find_color_components(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != int(color):
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == int(color):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _is_rect_frame(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    if len(coords) != 2 * (h + w) - 4:
+        return False
+    coord_set = {tuple(map(int, xy)) for xy in coords}
+    expected: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        expected.add((r0, c))
+        expected.add((r1, c))
+    for r in range(r0, r1 + 1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+    return coord_set == expected
+
+
+def _midpoint_outside(bbox: tuple[int, int, int, int], side: str) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    mid_r = r0 + (h - 1) // 2
+    mid_c = c0 + (w - 1) // 2
+    if side == "top":
+        return r0 - 1, mid_c
+    if side == "right":
+        return mid_r, c1 + 1
+    if side == "bottom":
+        return r1 + 1, mid_c
+    if side == "left":
+        return mid_r, c0 - 1
+    raise ValueError(side)
+
+
+def _frame_marker_side(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> str | None:
+    h, w = grid.shape
+    found = []
+    for side in SIDE_ORDER:
+        rr, cc = _midpoint_outside(bbox, side)
+        if 0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) == MARKER:
+            found.append(side)
+    if len(found) != 1:
+        return None
+    return found[0]
+
+
+def _find_frame_objects(grid: np.ndarray) -> list[dict]:
+    frames: list[dict] = []
