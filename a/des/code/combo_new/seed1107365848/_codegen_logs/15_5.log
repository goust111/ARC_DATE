+                stamp_top,
+                stamp_left,
+                item["outer"],
+                item["color"],
+                item["stamp_side"],
+                item["pattern"],
+            )
+            _mark_blocked(blocked, rr, cc2, reserve, reserve, pad=1)
+        if not ok:
+            continue
+
+        inp, expected = _crop_pair(board_in, board_out)
+        if max(inp.shape) > 30 or max(expected.shape) > 30:
+            continue
+        try:
