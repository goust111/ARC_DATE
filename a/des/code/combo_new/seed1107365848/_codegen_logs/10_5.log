+    random.shuffle(order)
+    order.sort(key=lambda idx: sizes[idx][0] * sizes[idx][1], reverse=True)
+    placed: list[tuple[int, int, int, int] | None] = [None] * len(sizes)
+    existing: list[tuple[int, int, int, int]] = []
+
+    for idx in order:
