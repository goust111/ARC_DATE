+            )
+            fragments.append(
+                {
+                    "rel": entry["small_rel"],
+                    "shape": entry["small_shape"],
+                    "area": entry["small_area"],
+                    "color": None,
+                    "coords": (),
+                    "bbox": (0, 0, 0, 0),
+                }
