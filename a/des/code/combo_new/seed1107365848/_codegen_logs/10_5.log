+    solutions: list[list[tuple[int, int]]] = []
+    unmatched = set(range(n))
+
+    def backtrack(chosen: list[tuple[int, int]]) -> None:
+        if len(solutions) > 1:
+            return
+        if not unmatched:
+            solutions.append(sorted(chosen))
+            return
