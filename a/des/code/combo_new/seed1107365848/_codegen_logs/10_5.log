+            if any(not _boxes_separated(bbox, prev["bbox"], 0) for prev in templates):
+                continue
+
+            templates.append({"r": r0, "c": c0, "band": band, "bbox": bbox})
+            mask[r0 : r0 + TEMPLATE_SIZE, c0 : c0 + TEMPLATE_SIZE] = True
