+            fragments.append(
+                {
+                    "color": color,
+                    "coords": tuple(sorted(pts)),
+                    "rel": rel,
+                    "shape": shape,
+                    "area": len(pts),
+                    "bbox": _bbox(pts),
+                }
+            )
