                placed.append((*rect, n_seeds))
                success = True
                break
        if not success:
            return None
    return placed


def _draw_room(grid: np.ndarray, room: tuple[int, int, int, int, int], color: int) -> None:
    r0, c0, r1, c1, n_seeds = room
    _paint_outline(grid, r0, c0, r1, c1, color)

