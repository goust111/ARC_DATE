+
+def _crop_coords(points: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], tuple[int, int]]:
+    r0, c0, r1, c1 = _bbox(points)
+    rel = tuple(sorted((r - r0, c - c0) for r, c in points))
+    return rel, (r1 - r0 + 1, c1 - c0 + 1)
