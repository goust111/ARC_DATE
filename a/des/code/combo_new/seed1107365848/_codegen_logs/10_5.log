+                fragments[i]["rel"],
+                fragments[i]["shape"],
+                fragments[j]["rel"],
+                fragments[j]["shape"],
+            )
+            if sol is None:
+                continue
+            edge_solution[(i, j)] = sol
+            neighbors[i].append(j)
+            neighbors[j].append(i)
