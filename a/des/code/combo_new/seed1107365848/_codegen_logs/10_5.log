+    result: list[tuple[int, int, tuple[tuple[int, int], ...], tuple[tuple[int, int], ...]]] = []
+    for i, j in solutions[0]:
+        placed_i, placed_j = edge_solution[(i, j)]
+        result.append((i, j, placed_i, placed_j))
