+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+MAROON = 9
+TEMPLATE_SIZE = 5
+INNER_SIZE = 3
+
+BAND_COLOR_POOL = [1, 2, 3, 4, 6, 7, 8]
+FRAGMENT_COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GEN_RETRIES = 500
+SCENE_RETRIES = 300
+PLACE_RETRIES = 250
