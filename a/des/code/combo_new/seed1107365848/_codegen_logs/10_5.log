+    for record in template_records:
+        r0 = int(record["r"])
+        c0 = int(record["c"])
+        out[r0 + 1 : r0 + 1 + INNER_SIZE, c0 + 1 : c0 + 1 + INNER_SIZE] = BG
+        for dr, dc in record["large_cells"]:
