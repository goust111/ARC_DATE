+    tag_pts = np.argwhere(patch == tag_color)
+    if tag_pts.shape[0] != 1:
+        return None
+    tag_r, tag_c = map(int, tag_pts[0])
+    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}
+    if (tag_r, tag_c) not in corners:
+        return None
+    if not all(mask[r, c] for r, c in corners):
+        return None
