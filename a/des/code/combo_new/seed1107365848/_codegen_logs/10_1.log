+
+
+def _classify_frame(grid: np.ndarray, coords: list[tuple[int, int]], bg: int) -> dict | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    h, w = r1 - r0 + 1, c1 - c0 + 1
