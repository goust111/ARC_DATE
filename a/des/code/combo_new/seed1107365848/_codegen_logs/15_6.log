+    cells = _ray_cells(start, direction, grid.shape)
+    if max_step is None:
+        usable = cells[min_step - 1 :]
+    else:
+        usable = cells[min_step - 1 : max_step]
+    usable = [cell for cell in usable if int(grid[cell]) == _BG]
+    if not usable:
+        return False
+    row, col = random.choice(usable)
+    grid[row, col] = _WALL
