+            local_idx = local_ids[0]
+            ray = active[local_idx]
+            out[cell] = int(ray["color"])
+            ray["head"] = cell
+            stats[int(ray["stat_idx"])]["steps"] = int(stats[int(ray["stat_idx"])]["steps"]) + 1
+            next_active.append(ray)
+        active = next_active
+
+    if collect_stats:
+        return out, stats
+    return out, []
