+            inset += steps[i]
+
+    if len(_find_frames(grid)) != n_frames:
+        return None
+
+    if any((r1 - r0) < 2 or (c1 - c0) < 2 for r0, c0, r1, c1 in used_bboxes):
+        return None
+
+    return grid, expected
+
+
