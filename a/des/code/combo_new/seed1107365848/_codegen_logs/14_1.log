+    max_right = min(MARGIN_RANGE[1], 30 - outer_w - left)
+    if max_right < MARGIN_RANGE[0]:
+        return None
+    right = random.randint(MARGIN_RANGE[0], max_right)
+
+    h = 1 + top_gap + outer_h + bottom_gap
+    w = left + outer_w + right
+    if h > 30 or w > 30:
+        return None
+
+    frame_color = random.choice(PALETTE)
