+
+    if len(_components(grid != BLACK)) != hole_count + 1:
+        return None
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid, expected
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        built = _build_case(rng)
