+        while int(mask.sum()) < target and frontier:
+            cell = rng.choice(tuple(frontier))
+            frontier.remove(cell)
+            r, c = cell
+            mask[r, c] = True
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < height and 0 <= nc < width and not mask[nr, nc]:
+                    frontier.add((int(nr), int(nc)))
