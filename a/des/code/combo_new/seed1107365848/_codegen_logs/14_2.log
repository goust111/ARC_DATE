+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+HOLE_COUNT_RANGE = (2, 4)
+HOLE_DIM_RANGE = (3, 6)
+TEMPLATE_SIDE_MIN = 10
+TEMPLATE_SIDE_MAX = 20
+GRID_SIDE_MIN = 18
+GRID_SIDE_MAX = 30
