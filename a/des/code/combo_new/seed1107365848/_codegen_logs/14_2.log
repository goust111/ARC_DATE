+                cc0 = max(0, c0 - 1)
+                rr1 = min(template_h, r0 + h + 1)
+                cc1 = min(template_w, c0 + w + 1)
+                if reserved[rr0:rr1, cc0:cc1].any():
+                    continue
+                candidates.append((int(r0), int(c0)))
+        if not candidates:
+            return None
+        r0, c0 = rng.choice(candidates)
+        placements[dim] = (r0, c0)
+        rr0 = max(0, r0 - 1)
+        cc0 = max(0, c0 - 1)
+        rr1 = min(template_h, r0 + h + 1)
+        cc1 = min(template_w, c0 + w + 1)
+        reserved[rr0:rr1, cc0:cc1] = True
+    return placements
