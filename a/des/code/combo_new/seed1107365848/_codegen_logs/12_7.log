+        mirror = set(_mirror_cells(obj, axis_kind, axis_index))
+        blocked_sources |= _expand(source, (height, width))
+        blocked_final |= _expand(source | mirror, (height, width))
+        objects.append(obj)
+        used_body_colors.add(obj["body_color"])
