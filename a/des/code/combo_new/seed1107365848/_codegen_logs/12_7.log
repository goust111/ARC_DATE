+        template = _sample_template(used_body_colors)
+        side = random.choice(_placement_sides(axis_kind))
+        obj = _place_object(
+            (height, width),
+            axis_kind,
+            axis_index,
+            side,
+            template,
+            blocked_sources,
+            blocked_final,
