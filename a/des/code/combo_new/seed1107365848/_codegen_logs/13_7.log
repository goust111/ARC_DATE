+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+AZURE = 8
+PALETTE = (1, 2, 3, 4, 6, 7, 9)
+MAX_GENERATION_TRIES = 400
+
+SHAPE_SPECS = {
+    "L5": (
+        "11100",
+        "11100",
+        "11100",
+        "11111",
+        "11111",
+    ),
+    "T5": (
+        "11111",
+        "11111",
+        "01110",
+        "01110",
+        "01110",
+    ),
+    "F5": (
+        "11111",
+        "11111",
+        "11100",
+        "11110",
+        "11110",
+    ),
+    "P5": (
+        "11110",
+        "11110",
+        "11111",
+        "11100",
+        "11100",
+    ),
+    "J5": (
+        "00111",
+        "00111",
+        "00111",
+        "11111",
+        "11111",
+    ),
+    "Y5": (
+        "11111",
+        "01111",
+        "01110",
+        "01110",
+        "01110",
+    ),
+    "S5": (
+        "01111",
+        "01111",
+        "11110",
+        "11110",
+        "11110",
+    ),
+    "R5": (
+        "11110",
+        "11110",
+        "11111",
