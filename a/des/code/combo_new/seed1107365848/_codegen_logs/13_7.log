+
+BG = 0
+GREY = 5
+AZURE = 8
+PALETTE = (1, 2, 3, 4, 6, 7, 9)
+MAX_GENERATION_TRIES = 400
+
+SHAPE_SPECS = {
+    "L5": (
+        "11100",
+        "11100",
+        "11100",
+        "11111",
+        "11111",
