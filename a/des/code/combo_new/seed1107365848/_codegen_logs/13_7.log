+
+def _extract_patch(grid: np.ndarray, coords: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return np.asarray(grid[r0 : r1 + 1, c0 : c1 + 1]).copy(), (r0, c0, r1, c1)
