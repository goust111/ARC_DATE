+
+
+def _pattern_candidates(interior: np.ndarray) -> list[np.ndarray]:
+    h, w = interior.shape
+    rr, cc = np.indices((h, w))
+    candidates = [
+        interior.copy(),
+        interior & (cc % 2 == 0),
+        interior & (cc % 2 == 1),
+        interior & (rr % 2 == 0),
+        interior & (rr % 2 == 1),
+        interior & ((rr + cc) % 2 == 0),
+        interior & ((rr + cc) % 2 == 1),
+        interior & (rr <= cc),
+        interior & (rr >= cc),
+        interior & (rr + cc <= (h + w - 2) // 2),
+        interior & (rr + cc >= (h + w - 2) // 2),
+        interior & ((rr == h // 2) | (cc == w // 2)),
+        interior & ((rr <= h // 2) | (cc <= w // 2)),
+        interior & ((rr >= h // 2) | (cc >= w // 2)),
