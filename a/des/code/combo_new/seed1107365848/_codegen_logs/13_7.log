+        r0, c0, r1, c1 = slot["bbox"]
+        patch = out[r0 : r1 + 1, c0 : c1 + 1]
+        patch[slot["outline_mask"]] = int(obj["outline_color"])
+        patch[rotated_fill] = int(obj["fill_color"])
+    return out
+
