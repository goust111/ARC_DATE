+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+_BG = 0
+_ALL_COLORS = tuple(range(1, 10))
+_CORNERS = ("tl", "tr", "bl", "br")
+_MISSING_CELL = {
+    "tl": (0, 0),
+    "tr": (0, 2),
+    "bl": (2, 0),
+    "br": (2, 2),
+}
