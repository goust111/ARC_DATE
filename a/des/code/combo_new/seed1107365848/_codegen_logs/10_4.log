+        "cells": pts,
+        "cell_set": set(pts),
+        "body_color": int(body_color),
+        "marker_color": int(marker_color),
+        "marker_pos": marker_pos,
+        "missing_corner": missing_corner,
+        "axis_col": _axis_col_from_bbox(c0, c1, missing_corner),
+    }
