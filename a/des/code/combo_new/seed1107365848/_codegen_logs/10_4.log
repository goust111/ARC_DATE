+def _candidate_positions(
+    blocked: np.ndarray, missing_corner: str, h: int, w: int
+) -> list[tuple[int, int]]:
+    positions: list[tuple[int, int]] = []
+    c_start = 0 if missing_corner in ("tl", "bl") else 2
+    c_stop = (w - 5) if missing_corner in ("tl", "bl") else (w - 3)
