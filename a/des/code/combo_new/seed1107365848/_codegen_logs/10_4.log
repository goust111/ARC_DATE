+def _reserve(blocked: np.ndarray, r0: int, c0: int, missing_corner: str) -> None:
+    h, w = blocked.shape
+    fr0, fc0, fr1, fc1 = _footprint_bbox(r0, c0, missing_corner)
+    er0 = max(0, fr0 - 1)
+    ec0 = max(0, fc0 - 1)
+    er1 = min(h - 1, fr1 + 1)
+    ec1 = min(w - 1, fc1 + 1)
+    blocked[er0 : er1 + 1, ec0 : ec1 + 1] = True
