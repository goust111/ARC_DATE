+    2: ((8, 15), (11, 18)),
+    3: ((9, 17), (13, 21)),
+    4: ((10, 18), (15, 24)),
+}
+_OBJECT_COUNT_RANGE = (1, 4)
+_GEN_ATTEMPTS = 400
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _background_color(grid: np.ndarray) -> int:
+    counts = Counter(int(v) for v in grid.flat)
+    return counts.most_common(1)[0][0]
+
