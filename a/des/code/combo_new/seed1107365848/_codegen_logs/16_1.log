+    frames = _find_frames(grid)
+    if len(frames) != frame_count:
+        return None
+    if {int(frame["seed_color"]) for frame in frames} != set(seed_colors):
+        return None
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if out.shape != grid.shape:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
