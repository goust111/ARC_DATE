+    h, w = occupied.shape
+    if top < 0 or left < 0 or top + height > h or left + width > w:
+        return False
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(h, top + height + pad)
+    c1 = min(w, left + width + pad)
+    return not occupied[r0:r1, c0:c1].any()
