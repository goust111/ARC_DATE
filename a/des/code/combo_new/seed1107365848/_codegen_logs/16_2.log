+def _destination(channel: dict, size: int, shape: tuple[int, int]) -> tuple[int, int]:
+    h, w = shape
+    radius = size // 2
+    side = channel["side"]
+
+    if side == "left":
+        r0 = int(channel["row"]) - radius
+        c0 = 0
+    elif side == "right":
