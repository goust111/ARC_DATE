+    if r0 == r1 and area == c1 - c0 + 1:
+        if c0 == 0 and c1 < w - 1:
+            return {"side": "left", "color": int(comp["color"]), "row": int(r0), "inner": int(c1)}
+        if c1 == w - 1 and c0 > 0:
+            return {"side": "right", "color": int(comp["color"]), "row": int(r0), "inner": int(c0)}
