+    order = sorted(range(len(specs)), key=lambda i: -int(specs[i]["size"]))
+    for idx in order:
+        spec = specs[idx]
+        patch = _ring_patch(int(spec["color"]), int(spec["layers"]), str(spec["side"]))
+        size = int(spec["size"])
+        candidates: list[tuple[int, int]] = []
+        for r0 in row_range:
+            if r0 + size > inp.shape[0] - 1:
