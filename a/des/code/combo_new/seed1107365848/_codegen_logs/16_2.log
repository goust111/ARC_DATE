+            return {"side": "top", "color": int(comp["color"]), "col": int(c0), "inner": int(r1)}
+        if r1 == h - 1 and r0 > 0:
+            return {"side": "bottom", "color": int(comp["color"]), "col": int(c0), "inner": int(r0)}
