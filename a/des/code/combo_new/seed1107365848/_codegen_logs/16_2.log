+def _parse_ring(comp: dict) -> dict | None:
+    if bool(comp["touches_edge"]):
+        return None
+
+    r0, c0, r1, c1 = comp["bbox"]
+    height = int(r1 - r0 + 1)
+    width = int(c1 - c0 + 1)
