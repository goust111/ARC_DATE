+
+def _dominant_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if seen[r, c] or color == bg:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "touches_edge": bool(
+                        (arr[:, 0] == 0).any()
+                        or (arr[:, 0] == h - 1).any()
+                        or (arr[:, 1] == 0).any()
+                        or (arr[:, 1] == w - 1).any()
+                    ),
+                }
+            )
+
+    return comps
+
+
+def _ring_mask(layers: int, side: str) -> np.ndarray:
+    size = 2 * int(layers) + 1
+    mid = size // 2
+    mask = np.zeros((size, size), dtype=bool)
+
+    for offset in range(layers):
+        r0 = offset
+        c0 = offset
+        r1 = size - 1 - offset
+        c1 = size - 1 - offset
+        mask[r0, c0 : c1 + 1] = True
+        mask[r1, c0 : c1 + 1] = True
+        mask[r0 : r1 + 1, c0] = True
+        mask[r0 : r1 + 1, c1] = True
+
+        if side == "left":
+            mask[mid, c0] = False
+        elif side == "right":
+            mask[mid, c1] = False
+        elif side == "top":
+            mask[r0, mid] = False
+        else:
+            mask[r1, mid] = False
+
+    return mask
+
+
+def _ring_patch(color: int, layers: int, side: str) -> np.ndarray:
+    mask = _ring_mask(layers, side)
+    patch = np.full(mask.shape, BG, dtype=int)
+    patch[mask] = int(color)
+    return patch
+
+
+def _component_mask(comp: dict) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    rel = comp["coords"] - np.array([r0, c0], dtype=int)
+    mask[rel[:, 0], rel[:, 1]] = True
+    return mask
