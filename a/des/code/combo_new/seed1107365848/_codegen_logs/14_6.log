+        raise AssertionError("rotated object left the grid")
+
+    region = out[nr0:nr1, nc0:nc1]
+    if bool(np.any(region[rotated] != BG)):
+        raise AssertionError("rotated objects overlap")
+    region[rotated] = int(color)
+
