+def _corner_origin(name: str, h: int, w: int) -> tuple[int, int]:
+    if name == "top_left":
+        return 0, 0
+    if name == "top_right":
+        return 0, w - 2
+    if name == "bottom_right":
+        return h - 2, w - 2
+    if name == "bottom_left":
+        return h - 2, 0
