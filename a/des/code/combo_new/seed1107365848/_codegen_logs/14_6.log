+        target_area = random.randint(max(min_area, len(cells)), max_area)
+        while len(cells) < target_area:
+            frontier = []
+            for r, c in cells:
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                        frontier.append((nr, nc))
