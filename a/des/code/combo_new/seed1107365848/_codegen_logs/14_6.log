+        if not placed:
+            return False
+
+    for obj in objects:
+        r0, c0 = obj["bbox_rc"]
+        h0, w0 = obj["bbox_hw"]
+        region = grid[r0 : r0 + h0, c0 : c0 + w0]
+        region[obj["mask"]] = int(obj["color"])
