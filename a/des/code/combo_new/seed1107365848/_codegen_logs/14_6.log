+    (2,),
+    (3,),
+    (0, 1),
+    (0, 2),
+    (0, 3),
+    (1, 2),
+    (2, 3),
+    (1, 3),
+    (0, 1, 2),
+    (0, 2, 3),
+    (0, 1, 3),
