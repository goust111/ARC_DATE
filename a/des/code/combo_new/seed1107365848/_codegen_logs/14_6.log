+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+# Corner order matches the clockwise rotation turns encoded by the puzzle.
+CORNER_NAMES = ("top_left", "top_right", "bottom_right", "bottom_left")
+CORNER_PATTERNS = (
