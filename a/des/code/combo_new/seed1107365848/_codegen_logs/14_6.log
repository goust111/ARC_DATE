+
+def _extract_components(grid: np.ndarray, ignore: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or ignore[r, c] or int(grid[r, c]) == BG:
+                continue
+
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = cr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or ignore[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+
+            pts = np.array(coords, dtype=int)
+            r0, c0 = pts.min(axis=0)
+            r1, c1 = pts.max(axis=0)
+            mask = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)
+            mask[pts[:, 0] - int(r0), pts[:, 1] - int(c0)] = True
+            components.append(
+                {
+                    "color": color,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "mask": mask,
+                }
+            )
