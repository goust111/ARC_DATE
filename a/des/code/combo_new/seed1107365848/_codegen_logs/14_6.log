+    empty_corners = 0
+
+    for turns, name in enumerate(CORNER_NAMES):
+        r0, c0 = _corner_origin(name, h, w)
+        patch = grid[r0 : r0 + 2, c0 : c0 + 2]
+        color = int(patch[0, 0])
+        if bool(np.all(patch == BG)):
+            empty_corners += 1
