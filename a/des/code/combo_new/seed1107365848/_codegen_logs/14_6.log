+def _random_path(start: tuple[int, int], target: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = start
+    tr, tc = target
+    path = [(r, c)]
+    while (r, c) != (tr, tc):
+        steps = []
+        if r < tr:
+            steps.append((r + 1, c))
+        elif r > tr:
+            steps.append((r - 1, c))
+        if c < tc:
+            steps.append((r, c + 1))
+        elif c > tc:
+            steps.append((r, c - 1))
+        r, c = random.choice(steps)
+        path.append((r, c))
+    return path
