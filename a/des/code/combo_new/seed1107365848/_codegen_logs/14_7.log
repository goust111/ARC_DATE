+def _find_path_color(grid: np.ndarray, bg: int) -> tuple[int, list[list[tuple[int, int]]]]:
+    candidates: list[tuple[int, list[list[tuple[int, int]]]]] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != bg):
