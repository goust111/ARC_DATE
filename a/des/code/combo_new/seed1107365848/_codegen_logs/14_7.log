+        return True
+
+    return False
+
+
+def _validate_generated_input(grid: np.ndarray, n_objects: int) -> bool:
+    bg = _bg_color(grid)
+    path_color, comps = _find_path_color(grid, bg)
+    if len(comps) != n_objects:
+        return False
+    h, w = grid.shape
+    for comp in comps:
