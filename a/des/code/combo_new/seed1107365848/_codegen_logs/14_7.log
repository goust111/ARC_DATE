+    seen = np.zeros((h, w), dtype=bool)
+    q = deque([(0, 0)])
+    seen[0, 0] = True
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if not seen[nr, nc] and not blocked[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
