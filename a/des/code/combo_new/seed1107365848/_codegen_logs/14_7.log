+    min_c = min(c for _, c in points)
+    shifted = [(r - min_r, c - min_c) for r, c in points]
+    height = max(r for r, _ in shifted) + 1
+    width = max(c for _, c in shifted) + 1
+    return shifted, height, width
+
+
