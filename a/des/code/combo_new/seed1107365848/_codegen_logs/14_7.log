+        (0, 0),
+        (0, width - 1),
+        (height - 1, width - 1),
+        (height - 1, 0),
+        (y2, 0),
+        (y2, x),
+        (y1, x),
+        (y1, 0),
+        (0, 0),
+    ]
+
+
+def _normalize_points(points: list[tuple[int, int]]) -> tuple[list[tuple[int, int]], int, int]:
