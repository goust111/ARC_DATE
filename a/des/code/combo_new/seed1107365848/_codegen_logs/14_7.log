+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+BG = 0
+COLORS = tuple(range(1, 10))
+
+GRID_MIN = 14
+GRID_MAX = 30
+GEN_RETRIES = 400
+PLACEMENT_TRIES = 120
+FAMILIES = ("rectangle", "bottom_notch", "left_notch")
