+
+
+def _final_coords(mask: np.ndarray, seg: dict, grid_shape: tuple[int, int]) -> np.ndarray:
+    h, w = grid_shape
+    mh, mw = mask.shape
+    mid_r, mid_c = seg["midpoint"]
