+        return r0 >= 3 and (c0 + c1) != 2 * mid_c
+    if side == "bottom":
+        return r1 <= h - 4 and (c0 + c1) != 2 * mid_c
+    if side == "left":
+        return c0 >= 3 and (r0 + r1) != 2 * mid_r
+    return c1 <= w - 4 and (r0 + r1) != 2 * mid_r
