    return {
        "top": [(0, c) for c in range(w)],
        "right": [(r, w - 1) for r in range(1, h)],
        "bottom": [(h - 1, c) for c in range(w - 2, -1, -1)],
        "left": [(r, 0) for r in range(h - 2, 0, -1)],
