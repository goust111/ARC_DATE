+        dr = dr2 // 2
+    else:
+        assert side == "right"
+        dc = (w - 2) - c1
+        dr2 = 2 * mid_r - (r0 + r1)
+        assert dr2 % 2 == 0, "vertical bbox center must align to an integer row"
+        dr = dr2 // 2
