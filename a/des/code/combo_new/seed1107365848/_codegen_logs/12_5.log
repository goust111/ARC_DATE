+        dc2 = 2 * mid_c - (c0 + c1)
+        assert dc2 % 2 == 0, "horizontal bbox center must align to an integer column"
+        dc = dc2 // 2
+    elif side == "left":
+        dc = 1 - c0
+        dr2 = 2 * mid_r - (r0 + r1)
