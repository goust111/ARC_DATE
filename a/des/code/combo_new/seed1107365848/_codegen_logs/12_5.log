+    if inp is None:
+        return None
+
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(actual, expected):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate a valid input after {MAX_ATTEMPTS} attempts")

