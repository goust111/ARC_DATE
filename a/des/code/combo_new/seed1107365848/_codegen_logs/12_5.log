+    sr0, sc0, sr1, sc1 = _bbox(shifted)
+    if side == "top":
+        assert sr0 == 1
+    elif side == "bottom":
+        assert sr1 == h - 2
+    elif side == "left":
+        assert sc0 == 1
+    else:
+        assert sc1 == w - 2
+    assert 0 <= sr0 <= sr1 < h and 0 <= sc0 <= sc1 < w
