+            return None
+        lens = _bounded_partition(len(seq), counts[side], MIN_SEG_LEN)
+        pos = 0
+        for length in lens:
+            cells = [(r, c, side) for r, c in seq[pos : pos + length]]
+            mid = cells[(length - 1) // 2]
