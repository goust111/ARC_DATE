+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+MAX_ATTEMPTS = 400
+MIN_SEG_LEN = 5
+GRID_H_RANGE = (19, 27)
+GRID_W_RANGE = (19, 27)
+SEGMENT_COUNT_RANGE = (4, 7)
