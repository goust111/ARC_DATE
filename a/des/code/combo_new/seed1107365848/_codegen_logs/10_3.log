+    seed_cells = [
+        (r, c)
+        for r in range(r0 + 2, r1 - 1)
+        for c in range(c0 + 2, c1 - 1)
+    ]
+    assert len(seed_cells) >= n_seeds, "room must have enough seed slots"
+    for r, c in random.sample(seed_cells, n_seeds):
+        grid[r, c] = SEED_COLOR
+
