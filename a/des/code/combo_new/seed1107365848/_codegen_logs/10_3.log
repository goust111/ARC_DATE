+            if seed_cap <= 0:
+                continue
+            max_layers = _max_inset_layers(height, width)
+            max_seeds = min(4, seed_cap)
+            if truncated:
+                low = max_layers + 1
+                high = max_seeds
+            else:
+                low = 1
+                high = min(max_layers, max_seeds)
+            if low > high:
+                continue
+            for n_seeds in range(low, high + 1):
+                specs.append((height, width, n_seeds))
+    return specs
