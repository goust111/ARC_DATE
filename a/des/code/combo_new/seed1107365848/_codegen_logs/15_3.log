GRID_W_RANGE = (19, 31)          # W uniform in [19, 30]
NUM_COLORS = 10                   # palette 0-9

# ── CFG: component shapes ───────────────────────────────────────────
BBOX_MAX = 5                      # max h or w of a component bbox
