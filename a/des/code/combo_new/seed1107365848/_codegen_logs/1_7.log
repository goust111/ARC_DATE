+def _components_by_color(grid: np.ndarray) -> list[dict]:
+    h, w = map(int, grid.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BLACK or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr = cr + dr
+                    nc = cc + dc
