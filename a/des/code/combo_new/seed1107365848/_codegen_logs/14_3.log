+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _neighbors8(r: int, c: int) -> list[tuple[int, int]]:
+    return [
+        (r - 1, c - 1),
+        (r - 1, c),
+        (r - 1, c + 1),
+        (r, c - 1),
+        (r, c + 1),
+        (r + 1, c - 1),
+        (r + 1, c),
+        (r + 1, c + 1),
+    ]
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    mask = grid == int(color)
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((int(cr), int(cc)))
+                for nr, nc in _neighbors8(int(cr), int(cc)):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            comps.append(comp)
+
+    return comps
+
+
+def _arrow_template(direction: str, length: int) -> tuple[np.ndarray, list[tuple[int, int]]]:
+    assert length >= 2
+    if direction == "right":
+        patch = np.zeros((3, length + 2), dtype=bool)
+        patch[1, :length] = True
+        patch[0, length] = True
+        patch[2, length] = True
+        patch[1, length + 1] = True
+        line = [(1, c) for c in range(length)]
+        return patch, line
+    if direction == "left":
+        patch = np.zeros((3, length + 2), dtype=bool)
+        patch[1, 2:] = True
+        patch[0, 1] = True
+        patch[2, 1] = True
+        patch[1, 0] = True
+        line = [(1, c) for c in range(2, length + 2)]
+        return patch, line
+    if direction == "up":
+        patch = np.zeros((length + 2, 3), dtype=bool)
+        patch[0, 1] = True
+        patch[1, 0] = True
+        patch[1, 2] = True
+        patch[2:, 1] = True
+        line = [(r, 1) for r in range(2, length + 2)]
+        return patch, line
+
+    assert direction == "down"
+    patch = np.zeros((length + 2, 3), dtype=bool)
+    patch[:length, 1] = True
+    patch[length, 0] = True
+    patch[length, 2] = True
+    patch[length + 1, 1] = True
+    line = [(r, 1) for r in range(length)]
+    return patch, line
+
+
+def _parse_arrow_component(coords: list[tuple[int, int]]) -> tuple[str, list[tuple[int, int]]]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
