+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+OBSTACLE = 5
+ARROW_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS: dict[str, tuple[int, int]] = {
+    "right": (0, 1),
+    "left": (0, -1),
+    "up": (-1, 0),
+    "down": (1, 0),
+}
