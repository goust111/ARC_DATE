+
+def _pad_cells(cells: set[tuple[int, int]] | list[tuple[int, int]], shape: tuple[int, int], pad: int) -> set[tuple[int, int]]:
+    h, w = shape
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for rr in range(max(0, int(r - pad)), min(h - 1, int(r + pad)) + 1):
