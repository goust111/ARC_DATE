    assert length >= 2
    if direction == "right":
        patch = np.zeros((3, length + 2), dtype=bool)
        patch[1, :length] = True
        patch[0, length] = True
        patch[2, length] = True
        patch[1, length + 1] = True
        line = [(1, c) for c in range(length)]
        return patch, line
    if direction == "left":
        patch = np.zeros((3, length + 2), dtype=bool)
        patch[1, 2:] = True
        patch[0, 1] = True
