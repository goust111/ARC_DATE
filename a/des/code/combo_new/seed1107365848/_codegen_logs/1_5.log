+_RNG = np.random.default_rng()
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+RING_COUNT_OPTIONS = (3, 4, 5)
+OUTER_DIM_CAP = 28
+EXTRA_MARGIN_CAP = 6
+MAX_GENERATION_ATTEMPTS = 300
