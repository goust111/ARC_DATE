+    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
+
+    rings = _rings_by_depth(g)
+    reversed_colors = [int(ring["color"]) for ring in reversed(rings)]
+    return _render_concentric(reversed_colors)
+
