+    if direction == "right":
+        return {(r, c), (r, c - 1), (r + extra_sign, c - 1)}
+    if direction == "left":
+        return {(r, c), (r, c + 1), (r + extra_sign, c + 1)}
+    if direction == "down":
+        return {(r, c), (r - 1, c), (r - 1, c + extra_sign)}
+    if direction == "up":
+        return {(r, c), (r + 1, c), (r + 1, c + extra_sign)}
+    raise AssertionError(direction)
