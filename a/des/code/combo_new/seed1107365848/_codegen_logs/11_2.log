+    out = g.copy()
+
+    for coords in _red_components(g):
+        for r, c in coords:
+            out[r, c] = BLACK
+
+    for r in active_rows:
+        for c in range(w):
+            if int(out[r, c]) != RED:
+                out[r, c] = BLACK
+
+    for c in active_cols:
+        for r in range(h):
+            if int(out[r, c]) != RED:
+                out[r, c] = BLACK
+
+    for direction, line, axis, _tip in arrows:
+        if axis == 0:
