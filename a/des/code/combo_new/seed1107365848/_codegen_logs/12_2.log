+
+def _path_overlap_count(pairs: list[dict[str, object]]) -> int:
+    counts = Counter()
+    for pair in pairs:
+        counts.update(pair["path_cells"])
+    return max(counts.values(), default=0)
+
+
+def _cross_quadrants() -> tuple[str, str]:
+    return random.choice((("NW", "SE"), ("NE", "SW")))
+
+
+def _gen_attempt(
+    shape: tuple[int, int],
