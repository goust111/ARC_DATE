+
+
+def _build_pair(
+    color: int,
+    corner: tuple[int, int],
+    quadrant: str,
+    len_h: int,
+    len_v: int,
+) -> dict[str, object]:
+    dir_h, dir_v = QUADRANTS[quadrant]
+    tip_h = _add(corner, dir_h, -len_h)
+    tip_v = _add(corner, dir_v, -len_v)
