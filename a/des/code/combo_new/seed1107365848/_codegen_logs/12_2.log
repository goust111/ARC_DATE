+    existing_objects: set[tuple[int, int]],
+    existing_paths: set[tuple[int, int]],
+    *,
+    allowed_overlaps: set[tuple[int, int]] | None = None,
+    forced_corner: tuple[int, int] | None = None,
+) -> dict[str, object] | None:
