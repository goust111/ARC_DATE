+
+def generate_input() -> np.ndarray:
+    shape = (
+        random.randint(GRID_MIN, GRID_MAX),
+        random.randint(GRID_MIN, GRID_MAX),
+    )
+    pair_count = random.choice(PAIR_COUNT_OPTIONS)
+    use_crossing = bool(random.random() < USE_CROSSING_PROB)
+    if use_crossing:
