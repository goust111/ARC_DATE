+    frozenset({(0, 0), (0, 1), (0, 2), (1, 1)}): {"tip": (1, 1), "dir": DIRS["D"]},
+    frozenset({(0, 1), (1, 0), (1, 1), (2, 1)}): {"tip": (1, 0), "dir": DIRS["L"]},
