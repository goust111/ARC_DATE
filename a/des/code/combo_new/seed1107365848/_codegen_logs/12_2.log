+    inp = _render_input(shape, pairs)
+    expected = _render_output(inp, pairs)
+
+    if use_crossing and _path_overlap_count(pairs) < 2:
+        return None
+    if not use_crossing and _path_overlap_count(pairs) != 1:
+        return None
