+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+ORANGE = 7
+FRAME_COLORS = (1, 2, 3, 4, 5, 6, 8, 9)
+
+GRID_HEIGHT_RANGE = (12, 30)
+GRID_WIDTH_RANGE = (12, 30)
+FRAME_COUNT_BOUNDS = (1, 4)
+SEED_SIZE_RANGE = (2, 4)
+REPEAT_SIZE_RANGE = (2, 3)
