  57:     parent = list(range(len(fixed_components)))
  58: 
  59:     def find(x):
  60:         while parent[x] != x:
  61:             parent[x] = parent[parent[x]]
  62:             x = parent[x]
  63:         return x
  64: 
  65:     def union(a, b):
