  31:         (br0, bc0, br1, bc1) = b
  32:         def gap1(x0, x1, y0, y1):
  33:             if y1 < x0:
  34:                 return int(x0 - y1)
  35:             if x1 < y0:
  36:                 return int(y0 - x1)
  37:             return 0
  38:         return gap1(ar0, ar1, br0, br1) + gap1(ac0, ac1, bc0, bc1)
  39: 
  40:     fg = g != int(bg)
  41:     lab, n = label(fg, structure=STRUCT4)
  42:     fixed_mask = np.zeros((H, W), dtype=bool)
  43:     fixed_components = []
  44:     for cid in range(1, n + 1):
  45:         pts = np.argwhere(lab == cid)
  46:         pts_list = [(int(r), int(c)) for r, c in pts]
  47:         touches = any(r == 0 or r == H - 1 or c == 0 or c == W - 1 for r, c in pts_list)
  48:         if not touches:
  49:             continue
  50:         fixed_components.append({"pts": pts_list, "bbox": (int(pts[:,0].min()), int(pts[:,1].min()), int(pts[:,0].max()), int(pts[:,1].max()))})
