+GREY = 5
+CELL_COLORS = (1, 2, 3, 4)  # blue, red, green, yellow
+CELL_SIZE = 3
+LINE_SIZE = 1
+GRID_CELL_MIN = 4
+GRID_CELL_MAX = 7
+GEN_RETRIES = 300
