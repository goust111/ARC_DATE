+    out = np.array(g, copy=True)
+    for rr, (r0, _r1) in enumerate(row_blocks):
+        for cc, (c0, _c1) in enumerate(col_blocks):
+            out[r0 : r0 + CELL_SIZE, c0 : c0 + CELL_SIZE] = int(out_cells[rr, cc])
+    return out
+
