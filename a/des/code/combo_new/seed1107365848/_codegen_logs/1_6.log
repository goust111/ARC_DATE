+    if r + 1 < cells.shape[0]:
+        neighbors.append(int(cells[r + 1, c]))
+    if c > 0:
+        neighbors.append(int(cells[r, c - 1]))
+    if c + 1 < cells.shape[1]:
+        neighbors.append(int(cells[r, c + 1]))
