+    cells[neighbors[0]] = palette[1]
+    cells[neighbors[1]] = palette[2]
+    reserved.add(corner)
+    reserved.update(neighbors)
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
