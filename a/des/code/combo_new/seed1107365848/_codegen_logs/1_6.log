+    for r in range(rows):
+        for c in range(cols):
+            r0 = LINE_SIZE + r * (CELL_SIZE + LINE_SIZE)
+            c0 = LINE_SIZE + c * (CELL_SIZE + LINE_SIZE)
+            grid[r0 : r0 + CELL_SIZE, c0 : c0 + CELL_SIZE] = int(cells[r, c])
