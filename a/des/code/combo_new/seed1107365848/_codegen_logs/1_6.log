+        ((rows - 1, cols - 1), [(rows - 2, cols - 1), (rows - 1, cols - 2)]),
+    ]
+    choices = [item for item in corners if item[0] not in reserved and all(nei not in reserved for nei in item[1])]
+    corner, neighbors = rng.choice(choices)
