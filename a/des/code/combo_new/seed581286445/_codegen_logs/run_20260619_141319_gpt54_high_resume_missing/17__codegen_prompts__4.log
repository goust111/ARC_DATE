        k = rng.choice([1, 2, 3])\n 491:         rotated_arr = np.rot90(arr, k)\n 492:         rotated_mask = np.rot90(mask, k)\n 493: \n 494:         # Crop to bounding box of the mask\n 495:         rows_any = rotated_mask.any(axis=1)\n 496:         cols_any = rotated_mask.any(axis=0)\n 497:         r0_idx, r1_idx = np.where(rows_any)[0][[0, -1]]\n 498:         c0_idx, c1_idx = np.where(cols_any)[0][[0, -1]]\n 499:         cropped_arr = rotated_arr[r0_idx:r1_idx+1, c0_idx:c1_idx+1]\n 500:         cropped_mask = rotated_mask[r0_idx:r1_idx+1, c0_idx:c1_idx+1]\n 501:         patch = np.where(cropped_mask, cropped_arr, bg).astype(int)\n 502: \n 503:         try:\n 504:             pr, pc = random_free_location(canvas, patch, transparent=bg, padding=2, padding_connectivity=8)\n 505:         except ValueError:\n 506:             return None\n 507:         paste(canvas, patch, pr, pc, transparent=bg)\n 508:         paste(inp, patch, pr, pc, transparent=bg)\n 509: \n 510:     # Optionally add a distractor (0 or 1)\n 511:     if rng.random() < 0.3:\n 512:         used_colors = set(side_colors.values())\n 513:         distractor_colors = [c for c in range(10) if c != bg and c not in used_colors]\n 514:         if distractor_colors:\n 515:             dcol = rng.choice(distractor_colors)\n 516:             # Make a small distractor sprite\n 517:             dist_mask = _make_sprite_mask(edge_len, rng.choice(sides), rng)\n 518:             if dist_mask is not None:\n 519:                 dist_arr = np.where(dist_mask, dcol, bg).astype(int)\n 520:                 try:\n 521:                     pr, pc = random_free_location(canvas, dist_arr, transparent=bg, padding=2, padding_connectivity=8)\n 522:                     paste(canvas, dist_arr, pr, pc, transparent=bg)\n 523:                     paste(inp, dist_arr, pr, pc, transparent=bg)\n 524:                 except ValueError:\n 525:                     pass  # skip distractor if no room\n 526: \n 527:     # Oracle check\n 528:     result = main(inp)\n 529:     if not np.array_equal(result, out):\n 530:         return None\n 531: \n 532:     return inp\n","exit_code":0,"status":"completed"}}
