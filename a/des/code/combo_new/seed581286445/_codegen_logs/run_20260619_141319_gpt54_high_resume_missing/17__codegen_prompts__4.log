right-side quadrants, vertically for bottom quadrants (both for bottom-right).\n  36:     - Align the scaled/reflected motif so its red region overlaps the target anchor, then stamp non-bg pixels.\n  37: \n  38:     Key insight: Red block size encodes the scale factor; quadrant position encodes the reflection axes.\n  39:     \"\"\"\n  40:     g = np.asarray(grid, dtype=int)\n  41:     h, w = g.shape\n  42:     out = g.copy()\n  43: \n  44:     bg = get_bg(g)\n  45:     mid_r, mid_c = _find_dividers(g, bg)\n  46: \n  47:     # Find red anchor blocks (color 2) in each quadrant.\n  48:     red = components_mask(g == 2, connectivity=4)\n  49:     assert red, \"grid must contain red (color 2) anchor blocks\"\n  50: \n  51:     # Quadrant key: (top/bottom, left/right)\n  52:     anchors: dict[tuple[int, int], tuple[int, int, int]] = {}\n  53:     # value: (r0,c0,size)\n  54:     for pts in red:\n  55:         r0, c0, r1, c1 = bbox_coords(pts)\n  56:         rr = (r0 + r1) // 2\n  57:         cc = (c0 + c1) // 2\n  58:         qb = 0 if rr < mid_r else 1\n  59:         qr = 0 if cc < mid_c else 1\n  60:         size = max(r1 - r0 + 1, c1 - c0 + 1)\n  61:         key = (qb, qr)\n  62:         assert key not in anchors, \"each quadrant must contain exactly one red anchor block\"\n  63:         anchors[key] = (int(r0), int(c0), int(size))\n  64: \n  65:     assert (0, 0) in anchors, \"top-left quadrant must contain a red anchor block\"\n  66:     sr0, sc0, sL = anchors[(0, 0)]\n  67:     assert sL > 0, \"top-left red anchor must have positive size\"\n  68: \n  69:     # Build a source patch around the TL motif: take the non-bg connected component (4-neigh)\n  70:     # in the TL quadrant that contains the TL red anchor.\n  71:     tl = g[0:mid_r, 0:mid_c]\n  72:     comps = components_mask(tl != bg, connectivity=4)\n  73:     patch_bb = None\n  74:     for pts in comps:\n  75:         # component contains any red pixel?\n  76:         if any(tl[r, c] == 2 for r, c in pts):\n  77:             r0, c0, r1, c1 = bbox_coords(pts)\n  78:             patch_bb = (int(r0), int(c0), int(r1), int(c1))\n  79:             break\n  80:     assert patch_bb is not None, \"top-left quadrant must contain a non-bg component with a red pixel\"\n  81: \n  82:     pr0, pc0, pr1, pc1 = patch_bb\n  83:     patch = tl[pr0 : pr1 + 1, pc0 : pc1 + 1].copy()\n  84: \n  85:     def resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:\n  86:         src_h, src_w = img.shape\n  87:         if new_h <= 0 or new_w <= 0:\n  88:             return img.copy()\n  89:         rr = (np.floor(np.arange(new_h) * src_h / new_h)).astype(int)\n  90:         cc = (np.floor(np.arange(new_w) * src_w / new_w)).astype(int)\n  91:         rr = np.clip(rr, 0, src_h - 1)\n  92:         cc = np.clip(cc, 0, src_w - 1)\n  93:         return img[rr[:, None], cc[None, :]]\n  94: \n  95:     # For each quadrant anchor, paste a scaled/reflected version of the patch.\n  96:     for (qb, qr), (tr0, tc0, tL) in anchors.items():\n  97:         if (qb, qr) == (0, 0):\n  98:             continue\n  99:         patch_t = patch\n 100:         if qr == 1:\n 101:             patch_t = np.fliplr(patch_t)\n 102:         if qb == 1:\n 103:             patch_t = np.flipud(patch_t)\n 104: \n 105:         ratio = float(tL) / float(sL)\n 106:         new_h = int(round(patch_t.shape[0] * ratio))\n 107:         new_w = int(round(patch_t.shape[1] * ratio))\n 108:         new_h = max(1, new_h)\n 109:         new_w = max(1, new_w)\n 110:         patch_s = resize_nn(patch_t, new_h, new_w)\n 111:         roundtrip = resize_nn(patch_s, patch_t.shape[0], patch_t.shape[1])\n 112:         assert np.array_equal(roundtrip, patch_t), \"scaling must preserve all motif information\"\n 113: \n 114:         # Align scaled red bbox in patch_s to the target red bbox.\n 115:         rr_red, cc_red = np.where(patch_s == 2)\n 116:         assert rr_red.size > 0, \"scaled source patch must contain red anchor pixels\"\n 117:         ar0, ac0 = int(rr_red.min()), int(cc_red.min())\n 118:         place_r0 = tr0 - ar0\n 119:         place_c0 = tc0 - ac0\n 120: \n 121:         rr_p, cc_p = np.where(patch_s != bg)\n 122:         for rr0, cc0 in zip(rr_p.tolist(), cc_p.tolist(), strict=False):\n 123:             val = int(patch_s[rr0, cc0])\n 124:             rr_t = place_r0 + rr0\n 125:             cc_t = place_c0 + cc0\n 126:             if not (0 <= rr_t < h and 0 <= cc_t < w):\n 127:                 continue\n 128:             if rr_t == mid_r or cc_t == mid_c:\n 129:                 continue\n 130:             if out[rr_t, cc_t] == 2:\n 131:                 continue\n 132:             out[rr_t, cc_t] = val\n 133: \n 134:     return out\n\n--- generate_input (369-374) ---\n 369: def generate_input() -> np.ndarray:\n 370:     for _ in range(MAX_RETRIES):\n 371:         grid = _gen_attempt()\n 372:         if grid is not None:\n 373:             return grid\n 374:     raise RuntimeError(\"failed to generate a valid b10624e5 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/6350f1f4.py =====\n--- main (61-109) ---\n  61: def main(grid: np.ndarray) -> np.ndarray:\n  62:     \"\"\"\n  63:     Decode a block-grid image by swapping each sprite-coded cell with a solid cell and each blank cell with the sprite.\n  64: \n  65:     Input structure\n  66:     The grid is partitioned by black separator rows and columns into equal-size\n  67:     square blocks. Each block is either a copy of one two-color sprite or a\n  68:     uniform blank block of the sprite's minority color; grey pixels are erased\n  69:     cells that act as wildcards.\n  70: \n  71:     Rule\n  72:     Infer the repeated sprite from fully visible mixed-color blocks. Replace a\n  73:     block matching that sprite, ignoring grey erasures, with a solid block of\n  74:     the sprite's majority color. Replace a uniform blank block with the sprite.\n  75:     Separator rows and columns, including grey erasures on them, become