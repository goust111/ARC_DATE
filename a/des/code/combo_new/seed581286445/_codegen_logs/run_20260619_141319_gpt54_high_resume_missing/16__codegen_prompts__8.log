ef add(side, lr, lc, ir, ic):\n        fr,fc=ro+lr, co+lc\n        ir,ic=ro+ir, co+ic\n        elig.append((side,(fr,fc),(ir,ic)))\n    if sign_side\"'!='\"'top':\n        for c in range(1,mw,2): add('top',0,c,1,c)\n    if sign_side\"'!='\"'bottom':\n        for c in range(1,mw,2): add('bottom',mh-1,c,mh-2,c)\n    if sign_side\"'!='\"'left':\n        for r in range(1,mh,2): add('left',r,0,r,1)\n    if sign_side\"'!='\"'right':\n        for r in range(1,mh,2): add('right',r,mw-1,r,mw-2)\n    a,b=random.sample(elig,2)\n    for color, item in [(RED,a),(BLUE,b)]:\n        (_, (fr,fc), (ir,ic)) = item\n        grid[fr,fc]=color\n        # interior should already be white\n    return grid,a,b\n\n\ndef trace(grid, signs):\n    passable=np.isin(grid,[WHITE,RED,BLUE])\n    start=tuple(map(int,np.argwhere(grid==RED)[0]))\n    exitp=tuple(map(int,np.argwhere(grid==BLUE)[0]))\n    ns=neighbors(passable,start)\n    if len(ns)\"'!=1:\n        return None,'\"'badstart'\n    prev=start\n    pos=ns[0]\n    d=(pos[0]-prev[0], pos[1]-prev[1])\n    path=[start,pos]\n    i=0\n    seen=Counter([(pos,d,prev)])\n    for _ in range(grid.size*6):\n        if pos==exitp:\n            return path,'exit'\n        nbrs=neighbors(passable,pos)\n        opts=[nb for nb in nbrs if nb\"'!=prev]\n        if len(opts)>=2:\n            if i>=len(signs):\n                return path,'\"'exhausted'\n            act=signs[i]; i+=1\n            if act=='S': nd=d\n            elif act=='L': nd=LEFT[d]\n            elif act=='R': nd=RIGHT[d]\n            else: nd=REV[d]\n            nxt=(pos[0]+nd[0], pos[1]+nd[1])\n            if not (0<=nxt[0]<grid.shape[0] and 0<=nxt[1]<grid.shape[1] and passable[nxt]):\n                return path,'invalid'\n        elif len(opts)==1:\n            nxt=opts[0]\n            nd=(nxt[0]-pos[0], nxt[1]-pos[1])\n        else:\n            return path, 'dead'\n        prev,pos=pos,nxt\n        d=nd\n        path.append(pos)\n        seen[(pos,d,prev)] += 1\n        if seen[(pos