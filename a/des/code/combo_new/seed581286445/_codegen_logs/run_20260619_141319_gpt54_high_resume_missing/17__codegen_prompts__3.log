{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/a25697e4.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport numpy as np\nfrom scipy.ndimage import label\nfrom arc_utils import STRUCT4, STRUCT8, get_bg, paste, random_free_location, random_sprite\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Dock movable tools into border-anchored frames by filling cavities.\n\n    Input structure:\n    - bg = most common color.\n    - Border-touching components cluster into anchor frames with interior bg cavities.\n    - Non-border 2-color components are movable tools.\n\n    Rule:\n    - Match each tool to a frame whose cavity size equals one of its color-region counts.\n    - Rotate/flip the tool so one color fills the cavity exactly; the other stays outside.\n    - If the docking orientation uses a reflection, swap the tool's two colors.\n\n    Key insight: Cavity size determines tool–frame pairing; reflection triggers color swap.\n    \"\"\"\n    inp = grid\n    g = inp.copy()\n    bg = get_bg(g)\n    H, W = g.shape\n\n    def bbox_gap(a, b) -> int:\n        (ar0, ac0, ar1, ac1) = a\n        (br0, bc0, br1, bc1) = b\n        def gap1(x0, x1, y0, y1):\n            if y1 < x0:\n                return int(x0 - y1)\n            if x1 < y0:\n                return int(y0 - x1)\n            return 0\n        return gap1(ar0, ar1, br0, br1) + gap1(ac0, ac1, bc0, bc1)\n\n    fg = g != int(bg)\n    lab, n = label(fg, structure=STRUCT4)\n    fixed_mask = np.zeros((H, W), dtype=bool)\n    fixed_components = []\n    for cid in range(1, n + 1):\n        pts = np.argwhere(lab == cid)\n        pts_list = [(int(r), int(c)) for r, c in pts]\n        touches = any(r == 0 or r == H - 1 or c == 0 or c == W - 1 for r, c in pts_list)\n        if not touches:\n            continue\n        fixed_components.append({\"pts\": pts_list, \"bbox\": (int(pts[:,0].min()), int(pts[:,1].min()), int(pts[:,0].max()), int(pts[:,1].max()))})\n        for r, c in pts_list:\n            fixed_mask[r, c] = True\n\n    assert not (not fixed_components)\n\n    # Cluster fixed components into anchor frames.\n    parent = list(range(len(fixed_components)))\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(a, b):\n        ra, rb = find(a), find(b)\n        if ra != rb:\n            parent[rb] = ra\n\n    for i in range(len(fixed_components)):\n        for j in range(i + 1, len(fixed_components)):\n            if bbox_gap(fixed_components[i][\"bbox\"], fixed_components[j][\"bbox\"]) <= 2:\n                union(i, j)\n\n    groups: dict[int, list[int]] = {}\n    for i in range(len(fixed_components)):\n        groups.setdefault(find(i), []).append(i)\n\n    anchor_groups = []\n    for idxs in groups.values():\n        pts = [p for i in idxs for p in fixed_components[i][\"pts\"]]\n        rs = [r for r, _c in pts]\n        cs = [c for _r, c in pts]\n        bbox = (min(rs), min(cs), max(rs), max(cs))\n        mask = np.zeros((H, W), dtype=bool)\n        for r, c in pts:\n            mask[r, c] = True\n        sock = np.zeros((H, W), dtype=bool)\n        for r in range(bbox[0], bbox[2] + 1):\n            for c in range(bbox[1], bbox[3] + 1):\n                if int(g[r, c]) != int(bg):\n                    continue\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    rr, cc = r + dr, c + dc\n                    if 0 <= rr < H and 0 <= cc < W and mask[rr, cc]:\n                        sock[r, c] = True\n                        break\n\n        # Cavity = largest bg component inside bbox that is adjacent to the anchor pixels.\n        cavity = np.zeros((H, W), dtype=bool)\n        sub_bg = (g[bbox[0] : bbox[2] + 1, bbox[1] : bbox[3] + 1] == int(bg))\n        sub_lab, sub_n = label(sub_bg, structure=STRUCT4)\n        best_c = None  # (area, cid)\n        for cid in range(1, sub_n + 1):\n            ptsc = np.argwhere(sub_lab == cid)\n            area = int(len(ptsc))\n            # check adjacency to anchor within bbox\n            adj = False\n            for rr, cc in ptsc:\n                r = int(bbox[0] + rr)\n                c = int(bbox[1] + cc)\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    r2, c2 = r + dr, c + dc\n                    if bbox[0] <= r2 <= bbox[2] and bbox[1] <= c2 <= bbox[3] and mask[r2, c2]:\n                        adj = True\n                        break\n                if adj:\n                    break\n            if not adj:\n                continue\n            cand = (area, -cid)\n            if best_c is None or cand > best_c:\n                best_c = cand\n                best_id = cid\n        if best_c is not None:\n            ptsc = np.argwhere(sub_lab == best_id)\n            for rr, cc in ptsc:\n                cavity[int(bbox[0] + rr), int(bbox[1] + cc)] = True\n        cav_bbox = None\n        if cavity.any():\n            ptsc2 = np.argwhere(cavity)\n            r0c, c0c = ptsc2.min(axis=0)\n            r1c, c1c = ptsc2.max(axis=0)\n            cav_bbox = (int(r0c), int(c0c), int(r1c), int(c1c))\n\n        # swap rule for this anchor group: look for a color that appears in >=2 fixed sub-components\n        # (within the group) with different sizes and larger-above-smaller.\n        swap_needed = False\n        for col in sorted({int(x) for x in np.unique(g[mask])} - {int(bg)}):\n            sub = (g == int(col)) & mask\n            labc, nc = label(sub, structure=STRUCT4)\n            if nc < 2:\n                continue\n            comps = []\n            for cid in range(1, nc + 1):\n                ptsc = np.argwhere(labc == cid)\n                comps.append((int(len(ptsc)), float(ptsc[:, 0].mean()), float(ptsc[:, 1].mean())))\n            comps.sort(reverse=True)\n            (s0, r0, _c0), (s1, r1, _c1) = comps[0], comps[1]\n            # Swap only when the larger component is vertically above the smaller one.\n            if s0 != s1 and r0 < r1:\n                swap_needed = True\n                break\n\n        # Dominant open direction: which side has the most bg neighbors.\n        dir_list = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # U,D,L,R\n        dir_counts = [0, 0, 0, 0]\n        for r, c in pts:\n            for di, (dr, dc) in enumerate(dir_list):\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(bg):\n                    dir_counts[di] += 1\n        open_dir = dir_list[int(np.argmax(dir_counts))]\n        _labg, _ng = label(mask, structure=STRUCT4)\n        single_piece = int(_ng) == 1\n        cavity_size = int(cavity.sum())\n\n        anchor_groups.append(\n            {\n                \"mask\": mask,\n                \"bbox\": bbox,\n                \"socket_mask\": sock,\n                \"cavity_mask\": cavity,\n                \"cavity_bbox\": cav_bbox,\n                \"open_dir\": open_dir,\n                \"swap_needed\": swap_needed,\n                \"single_piece\": single_piece,\n                \"cavity_size\": cavity_size,\n                \"size\": int(mask.sum()),\n            }\n        )\n    anchor_groups.sort(key=lambda d: -d[\"size\"])\n\n    # Movable multi-color components are the remaining foreground pixels.\n    mov_mask = fg & (~fixed_mask)\n    mov_lab, mov_n = label(mov_mask, structure=STRUCT4)\n    mov_comps = []\n    for cid in range(1, mov_n + 1):\n        pts = np.argwhere(mov_lab == cid)\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        m = mov_lab[r0 : r1 + 1, c0 : c1 + 1] == cid\n        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        patch[~m] = 0\n        mov_comps.append({\"bbox\": (int(r0), int(c0), int(r1), int(c1)), \"mask\": m, \"patch\": patch, \"size\": int(len(pts))})\n    mov_comps.sort(key=lambda d: -d[\"size\"])\n\n    def choose_group(bbox) -> int:\n        best_i = 0\n        best_d = None\n        for i, grp in enumerate(anchor_groups):\n            d = bbox_gap(bbox, grp[\"bbox\"])\n            if best_d is None or d < best_d:\n                best_d = d\n                best_i = i\n        return int(best_i)\n\n    def gen_variants(patch: np.ndarray, mask: np.ndarray):\n        \"\"\"All unique dihedral variants, with a reflection flag.\"\"\"\n        base: list[tuple[np.ndarray, np.ndarray, bool]] = []\n        for k in range(4):\n            p = np.rot90(patch, k)\n            m = np.rot90(mask, k)\n            base.append((p, m, False))\n            base.append((np.fliplr(p), np.fliplr(m), True))\n        uniq: list[tuple[np.ndarray, np.ndarray, bool]] = []\n        seen = set()\n        for p, m, is_flip in base:\n            key = (m.tobytes(), p[m].tobytes())\n            if key in seen:\n                continue\n            seen.add(key)\n            uniq.append((p, m, is_flip))\n        return uniq\n\n    out = np.full_like(g, int(bg))\n    out[fixed_mask] = g[fixed_mask]\n    placed_global = fixed_mask.copy()\n    placed_groups = [grp[\"mask\"].copy() for grp in anchor_groups]\n\n    group_for_comp: list[int]\n    # Match condition (key): a tool can dock into a frame only if one of its two color-regions has\n    # pixel-count equal to the frame's cavity size. Use this to assign tools to frames (one-to-one\n    # when counts match), falling back to distance only if no such match exists.\n    comp_color_counts: list[dict[int, int]] = []\n    for comp in mov_comps:\n        vals = [int(x) for x in comp[\"patch\"][comp[\"mask\"]].flatten() if int(x) != 0]\n        comp_color_counts.append(dict(Counter(vals)))\n\n    def compatible(ci: int, gi: int) -> bool:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/58490d8a.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_coords, components_mask, crop_bbox, get_bg, label_mask, paste, random_free_location\nimport random\nfrom functools import lru_cache\nfrom itertools import combinations\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count colored objects and record tallies inside a legend box.\n\n    Input structure:\n    - A black rectangular legend box with key-color pixels in its leftmost non-black column.\n    - Outside the box, distinct objects of each key color are scattered across the grid.\n\n    Rule:\n    - For each key color, count separate same-colored objects outside the legend box.\n    - Output the legend box repainted: each key row gets one dot per object, spaced every other cell rightward from the key pixel.\n\n    Key insight: The legend is both the color index and the output canvas — object counts become dot sequences on the matching row.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    _bg = int(get_bg(g))\n\n    black = 0\n\n    # STEP 1) Find the legend bbox: largest black CC whose bbox contains some non-black pixels.\n    best = None  # (area, bbox)\n    for coords in components_mask(g == int(black), connectivity=8):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if (sub != int(black)).any():\n            area = int(coords.shape[0])\n            cand = (area, tuple(map(int, b)))\n            if best is None or cand[0] > best[0]:\n                best = cand\n\n    assert not (best is None)\n\n    r0, c0, r1, c1 = map(int, best[1])\n    box = crop_bbox(g, (r0, c0, r1, c1))\n    bh, bw = map(int, box.shape)\n\n    # STEP 2) Inside the legend bbox, find the key column:\n    # leftmost column with any non-black pixels (the \"key pixels\").\n    key_col = None\n    for cc in range(bw):\n        if (box[:, int(cc)] != int(black)).any():\n            key_col = int(cc)\n            break\n    if key_col is None:\n        return np.zeros_like(box)\n\n    keys = [(int(rr), int(box[int(rr), int(key_col)])) for rr in range(bh) if int(box[int(rr), int(key_col)]) != int(black)]\n    keys.sort(key=lambda t: int(t[0]))\n\n    outside = np.ones((H, W), dtype=bool)\n    outside[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = False\n    out = np.zeros((bh, bw), dtype=int)\n\n    # STEP 3/4) Count CCs of each key color outside the legend, then draw 1 dot per CC.\n    for rr, col in keys:\n        mask = (g == int(col)) & outside\n        _labc, nc = label_mask(mask, connectivity=8)\n        for i in range(int(nc)):\n            cc = int(key_col + 2 * i)\n            if 0 <= cc < bw:\n                out[int(rr), int(cc)] = int(col)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette and legend color choices.\nCOLOR_POOL = tuple(range(1, 10))\nBLACK = 0\nDISTRACTOR_PROB = 0.5\n\n# Key rows and tally dimensions.\nKEY_COUNT_RANGE = (2, 4)\nTARGET_COUNT_RANGE = (1, 5)\nKEY_ROW_FIRST = 1\nKEY_ROW_STEP = 2\nKEY_COLUMN = 1\nTALLY_COL_STEP = 2\nLEGEND_HEIGHT_TAIL = 1\nLEGEND_WIDTH_TAIL = 1\nLEGEND_SLACK_RANGE = (0, 3)\n\n# Canvas size and legend placement bounds.\nGRID_HEIGHT_RANGE = (20, 25)\nGRID_WIDTH_RANGE = (20, 25)\nLEGEND_EDGE_MARGIN = 2\n\n# Sprite shape and placement constraints.\nSPRITE_AREA_RANGE = (4, 7)\nSPRITE_BBOXES = ((2, 2), (2, 3), (3, 2), (3, 3))\nSPRITE_CONNECTIVITY = 8\nSPRITE_PADDING = 1\nSPRITE_PADDING_CONNECTIVITY = 8\n\n# Retry budget for rejection sampling.\nGENERATION_ATTEMPTS = 300\n\n\ndef _randint(bounds: tuple[int, int]) -> int:\n    \"\"\"Return an inclusive randint from a configured (low, high) pair.\"\"\"\n    return random.randint(bounds[0], bounds[1])\n\n\n@lru_cache(maxsize=None)\ndef _valid_masks(h: int, w: int, area: int) -> tuple[np.ndarray, ...]:\n    \"\"\"Return connected masks that span all four sides of the sprite bbox.\"\"\"\n    masks = []\n    for cells in combinations(range(h * w), area):\n        mask = np.zeros((h, w), dtype=bool)\n        for cell in cells:\n            mask[cell // w, cell % w] = True\n        spans_edges = mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()\n        if not spans_edges:\n            continue\n        _, n = label_mask(mask, connectivity=SPRITE_CONNECTIVITY)\n        if n == 1:\n            masks.append(mask)\n    return tuple(masks)\n\n\ndef _make_sprite(color: int, bg: int) -> np.ndarray:\n    \"\"\"Sample one connected same-color sprite drawn on the background color.\"\"\"\n    area = _randint(SPRITE_AREA_RANGE)\n    dims = []\n    for h, w in SPRITE_BBOXES:\n        if h * w >= area and _valid_masks(h, w, area):\n            dims.append((h, w))\n    h, w = random.choice(dims)\n    mask = random.choice(_valid_masks(h, w, area))\n    sprite = np.full((h, w), int(bg), dtype=int)\n    sprite[mask] = int(color)\n    return sprite\n\n\ndef _sample_palette() -> tuple[int, list[int], int | None]:\n    \"\"\"Choose background, key colors, and optional distractor color.\"\"\"\n    colors = list(COLOR_POOL)\n    bg = random.choice(colors)\n\n    k = _randint(KEY_COUNT_RANGE)\n    remaining = [c for c in colors if c != bg]\n    key_colors = random.sample(remaining, k)\n    remaining = [c for c in remaining if c not in key_colors]\n    distractor_color = random.choice(remaining) if remaining and random.random() < DISTRACTOR_PROB else None\n    return bg, key_colors, distractor_color\n\n\ndef _sample_counts(k: int) -> list[int]:\n    \"\"\"Sample the target outside-component count for each key color.\"\"\"\n    return [_randint(TARGET_COUNT_RANGE) for _ in range(k)]\n\n\ndef _legend_shape(k: int, max_count: int) -> tuple[int, int]:\n    \"\"\"Return legend height and width for the key count and largest tally.\"\"\"\n    bh = KEY_ROW_STEP * k + LEGEND_HEIGHT_TAIL\n    bw = TALLY_COL_STEP * max_count + LEGEND_WIDTH_TAIL + _randint(LEGEND_SLACK_RANGE)\n    return bh, bw\n\n\ndef _key_row(i: int) -> int:\n    \"\"\"Map a zero-based key index to its row inside the legend/output box.\"\"\"\n    return KEY_ROW_FIRST + KEY_ROW_STEP * i\n\n\ndef _build_expected(key_colors: list[int], counts: list[int]) -> np.ndarray:\n    \"\"\"Render the black output tally canvas implied by key colors and counts.\"\"\"\n    max_count = max(counts)\n    bh, bw = _legend_shape(len(key_colors), max_count)\n\n    expected = np.full((bh, bw), BLACK, dtype=int)\n    for i, (color, count) in enumerate(zip(key_colors, counts)):\n        rr = _key_row(i)\n        for j in range(count):\n            expected[rr, KEY_COLUMN + TALLY_COL_STEP * j] = int(color)\n    return expected\n\n\ndef _build_legend(shape: tuple[int, int], key_colors: list[int]) -> np.ndarray:\n    \"\"\"Return a black legend patch with only the key-column pixels filled.\"\"\"\n    legend = np.full(shape, BLACK, dtype=int)\n    for i, color in enumerate(key_colors):\n        legend[_key_row(i), KEY_COLUMN] = int(color)\n    return legend\n\n\ndef _new_grid_with_legend(bg: int, legend: np.ndarray) -> np.ndarray | None:\n    \"\"\"Sample a grid and paste the legend away from all canvas edges.\"\"\"\n    bh, bw = map(int, legend.shape)\n    H = _randint(GRID_HEIGHT_RANGE)\n    W = _randint(GRID_WIDTH_RANGE)\n    min_h = bh + 2 * LEGEND_EDGE_MARGIN\n    min_w = bw + 2 * LEGEND_EDGE_MARGIN\n    if H < min_h or W < min_w:\n        return None\n\n    grid = np.full((H, W), int(bg), dtype=int)\n    r0 = random.randint(LEGEND_EDGE_MARGIN, H - bh - LEGEND_EDGE_MARGIN)\n    c0 = random.randint(LEGEND_EDGE_MARGIN, W - bw - LEGEND_EDGE_MARGIN)\n    paste(grid, legend, r0, c0)\n    return grid\n\n\ndef _build_sprite_queue(\n    key_colors: list[int],\n    counts: list[int],\n    distractor_color: int | None,\n    bg: int,\n) -> list[np.ndarray]:\n    \"\"\"Create canonical key sprites, optional distractor sprite, and shuffle them.\"\"\"\n    sprites = []\n    for color, count in zip(key_colors, counts):\n        sprite = _make_sprite(color, bg)\n        for _ in range(count):\n            sprites.append(sprite.copy())\n    if distractor_color is not None:\n        sprites.append(_make_sprite(distractor_color, bg))\n    random.shuffle(sprites)\n    return sprites\n\n\ndef _place_sprites(grid: np.ndarray, sprites: list[np.ndarray], bg: int) -> None:\n    \"\"\"Paste sprites into random non-touching free locations in queue order.\"\"\"\n    for sprite in sprites:\n        sr, sc = random_free_location(\n            grid,\n            sprite,\n            transparent=bg,\n            padding=SPRITE_PADDING,\n            padding_connectivity=SPRITE_PADDING_CONNECTIVITY,\n        )\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/2601afb7.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\n\n\ndef _extract_bars(g: np.ndarray, bg: int) -> list[dict[str, int]]:\n    height = g.shape[0]\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(components) >= 2\n\n    bars: list[dict[str, int]] = []\n    for comp in components:\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        color = int(comp[\"color\"])\n        area = int(comp[\"area\"])\n\n        assert c0 == c1\n        assert r1 == height - 1\n        assert area == r1 - r0 + 1\n        assert bool(np.all(g[r0 : r1 + 1, c0] == color))\n\n        bars.append({\"color\": color, \"col\": c0, \"height\": area})\n\n    bars.sort(key=lambda bar: bar[\"col\"])\n    assert len({bar[\"col\"] for bar in bars}) == len(bars)\n    return bars\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate each vertical bar's color one slot right and its height one slot left.\n\n    Input structure\n    - A dominant background surrounds several monochrome one-cell-wide vertical bars.\n    - Every bar is bottom-aligned and occupies a distinct column.\n    - The ordered bar slots are read from left to right.\n\n    Rule\n    - Keep the grid shape and the bar columns unchanged.\n    - At slot i, use the color from the previous slot cyclically.\n    - At slot i, use the height from the next slot cyclically.\n\n    Key insight\n    - Color and height are independent cyclic attributes of the ordered bar slots:\n      colors rotate right while heights rotate left.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height = g.shape[0]\n    bg = get_bg(g)\n    bars = _extract_bars(g, bg)\n\n    out = np.full_like(g, bg)\n    count = len(bars)\n    for i, bar in enumerate(bars):\n        color = bars[(i - 1) % count][\"color\"]\n        bar_height = bars[(i + 1) % count][\"height\"]\n        assert 1 <= bar_height <= height\n        out[height - bar_height : height, bar[\"col\"]] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n_RNG = np.random.default_rng()\n\n# Canvas/bar bounds.\nBAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE = 3, 6\nBACKGROUND_COLOR, MIN_BAR_HEIGHT = 7, 1\nBAR_COL_OFFSET, BAR_COL_STRIDE = 1, 2\n# Color and transform sampling.\nCOLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nOUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _render_bars(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n    grid = np.full((side, side), BACKGROUND_COLOR, dtype=int)\n    for i, (color, bar_height) in enumerate(zip(colors, heights)):\n        col = BAR_COL_STRIDE * i + BAR_COL_OFFSET\n        grid[side - int(bar_height) : side, col] = int(color)\n    return grid\n\n\ndef _expected_output(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n    out_colors = np.roll(colors, OUTPUT_COLOR_SHIFT)\n    out_heights = np.roll(heights, OUTPUT_HEIGHT_SHIFT)\n    return _render_bars(n, out_colors, out_heights)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = int(_RNG.integers(BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE))\n    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n    colors = _RNG.choice(COLOR_POOL, size=n, replace=False)\n    heights = _RNG.integers(MIN_BAR_HEIGHT, side, size=n)\n    if len(set(map(int, heights))) == 1:\n        idx = int(_RNG.integers(n))\n        choices = [h for h in range(MIN_BAR_HEIGHT, side) if h != int(heights[idx])]\n        heights[idx] = int(_RNG.choice(choices))\n\n    grid = _render_bars(n, colors, heights)\n    if np.array_equal(main(grid), _expected_output(n, colors, heights)):\n        return grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
