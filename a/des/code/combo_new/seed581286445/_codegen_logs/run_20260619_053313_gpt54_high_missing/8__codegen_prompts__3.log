{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/eval/faa9f03d.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import components_mask, get_bg\nimport random\n\n\nDIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _pts(mask: np.ndarray) -> set[tuple[int, int]]:\n    return {tuple(map(int, rc)) for rc in np.argwhere(mask)}\n\n\ndef _axis_support(mask: set[tuple[int, int]], r: int, c: int, axis: int) -> bool:\n    if axis == 0:\n        return (r, c - 1) in mask or (r, c + 1) in mask\n    return (r - 1, c) in mask or (r + 1, c) in mask\n\n\ndef _perp_support(mask: set[tuple[int, int]], r: int, c: int, axis: int) -> bool:\n    if axis == 0:\n        return (r - 1, c) in mask or (r + 1, c) in mask\n    return (r, c - 1) in mask or (r, c + 1) in mask\n\n\ndef _component_count(shape: tuple[int, int], pts: set[tuple[int, int]]) -> int:\n    mask = np.zeros(shape, dtype=bool)\n    for r, c in pts:\n        mask[r, c] = True\n    return len(components_mask(mask, connectivity=4))\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repair a one-cell-thick colored line network by replacing singleton markers, filling short orthogonal gaps, and redirecting yellow-marked arms to the edge.\n\n    Input structure:\n    - A rectangular grid with a dominant background.\n    - Line colors form one-cell-thick horizontal/vertical stroke fragments.\n    - Marker colors are exactly those whose 4-connected components are all singleton pixels.\n    - Red singleton markers are missing line cells; yellow singleton markers are directional controls next to a line endpoint.\n\n    Rule:\n    - Assign every marker to the nearest visible line color in row/column line-of-sight, preferring an endpoint supported along that same axis.\n    - For each line color, fill the gap between consecutive facing endpoints in a row or column.\n    - A yellow control erases the old straight arm on the far side of its endpoint and paints the same color from that endpoint through the control pixel to the grid edge.\n    - At crossings, yellow-control rays win; otherwise an original-vs-filled crossing uses the more fragmented pre-repair line color, while pure filled crossings use the lower color id.\n\n    Key insight: The singleton markers identify which sparse stroke fragments belong together; after they are colored, the intended lines are the axis-aligned gaps between facing endpoints, with yellow controls flipping one arm to the marked side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    colors = set(map(int, g.ravel())) - {bg}\n    assert colors, \"expected foreground line and marker colors\"\n\n    marker_colors: set[int] = set()\n    for color in colors:\n        comps = components_mask(g == color, connectivity=4)\n        assert comps, \"foreground color must have at least one component\"\n        if max(len(comp) for comp in comps) == 1:\n            marker_colors.add(int(color))\n\n    line_colors = colors - marker_colors\n    assert line_colors, \"expected at least one non-marker line color\"\n    assert marker_colors, \"expected singleton marker colors\"\n\n    original = {color: _pts(g == color) for color in line_colors}\n    assignment: dict[tuple[int, int], int] = {}\n    assign_dir: dict[tuple[int, int], tuple[int, int]] = {}\n\n    marker_mask = np.isin(g, list(marker_colors))\n    for r0, c0 in _pts(marker_mask):\n        candidates: list[tuple[int, int, int, int, int]] = []\n        for dr, dc in DIRS4:\n            r, c = r0 + dr, c0 + dc\n            dist = 1\n            while 0 <= r < H and 0 <= c < W:\n                value = int(g[r, c])\n                if value in line_colors:\n                    axis = 0 if dr == 0 else 1\n                    supported = _axis_support(original[value], r, c, axis)\n                    candidates.append((dist, 0 if supported else 1, value, dr, dc))\n                    break\n                if value == bg or value in marker_colors:\n                    r += dr\n                    c += dc\n                    dist += 1\n                    continue\n                break\n\n        assert candidates, f\"marker at {(r0, c0)} cannot see a line color\"\n        candidates.sort()\n        _dist, _unsupported, color, dr, dc = candidates[0]\n        assignment[(r0, c0)] = int(color)\n        assign_dir[(r0, c0)] = (int(dr), int(dc))\n\n    masks = {color: set(pts) for color, pts in original.items()}\n    marker_pts = {color: set() for color in line_colors}\n    for pt, color in assignment.items():\n        masks[color].add(pt)\n        marker_pts[color].add(pt)\n\n    comp_count = {color: _component_count(g.shape, masks[color]) for color in line_colors}\n\n    def has_axis_support(color: int, r: int, c: int, axis: int) -> bool:\n        return (r, c) in marker_pts[color] or _axis_support(masks[color], r, c, axis)\n\n    def should_fill(color: int, a: tuple[int, int], b: tuple[int, int], axis: int) -> bool:\n        r1, c1 = a\n        r2, c2 = b\n        gap = c2 - c1 - 1 if axis == 0 else r2 - r1 - 1\n        if gap <= 0:\n            return False\n\n        a_axis = has_axis_support(color, r1, c1, axis)\n        b_axis = has_axis_support(color, r2, c2, axis)\n        if gap == 1:\n            if a_axis or b_axis:\n                return True\n            a_perp = _perp_support(masks[color], r1, c1, axis)\n            b_perp = _perp_support(masks[color], r2, c2, axis)\n            return not (a_perp and b_perp)\n\n        if (r1, c1) in marker_pts[color] and (r2, c2) in marker_pts[color]:\n            return False\n        return a_axis and b_axis\n\n    for color in sorted(line_colors):\n        additions: set[tuple[int, int]] = set()\n        for r in range(H):\n            cols = sorted(c for rr, c in masks[color] if rr == r)\n            for c1, c2 in zip(cols, cols[1:]):\n                if should_fill(color, (r, c1), (r, c2), axis=0):\n                    additions.update((r, c) for c in range(c1 + 1, c2))\n\n        for c in range(W):\n            rows = sorted(r for r, cc in masks[color] if cc == c)\n            for r1, r2 in zip(rows, rows[1:]):\n                if should_fill(color, (r1, c), (r2, c), axis=1):\n                    additions.update((r, c) for r in range(r1 + 1, r2))\n\n        masks[color].update(additions)\n\n    control_ray = {color: set() for color in line_colors}\n    if 4 in marker_colors:\n        for control in _pts(g == 4):\n            color = assignment[control]\n            dr, dc = assign_dir[control]\n\n            r, c = control[0] + dr, control[1] + dc\n            pivot: tuple[int, int] | None = None\n            while 0 <= r < H and 0 <= c < W:\n                if (r, c) in masks[color]:\n                    pivot = (r, c)\n                    break\n                r += dr\n                c += dc\n            assert pivot is not None, f\"yellow control at {control} has no assigned endpoint\"\n\n            old_start = (pivot[0] + dr, pivot[1] + dc)\n            if old_start in masks[color]:\n                stack = [old_start]\n                old_arm: set[tuple[int, int]] = set()\n                while stack:\n                    q = stack.pop()\n                    if q == pivot or q in old_arm or q not in masks[color]:\n                        continue\n                    old_arm.add(q)\n                    qr, qc = q\n                    for ndr, ndc in DIRS4:\n                        stack.append((qr + ndr, qc + ndc))\n\n                assert old_arm, f\"yellow control at {control} found no old arm to erase\"\n                for q in old_arm:\n                    masks[color].discard(q)\n                    marker_pts[color].discard(q)\n                    control_ray[color].discard(q)\n\n            pr, pc = -dr, -dc\n            r, c = pivot\n            while 0 <= r < H and 0 <= c < W:\n                masks[color].add((r, c))\n                control_ray[color].add((r, c))\n                r += pr\n                c += pc\n\n    claims: dict[tuple[int, int], list[int]] = {}\n    for color, pts in masks.items():\n        for pt in pts:\n            claims.setdefault(pt, []).append(int(color))\n\n    out = np.full_like(g, bg)\n\n    def marker_brackets(color: int, pt: tuple[int, int]) -> bool:\n        r, c = pt\n        same_row = [mc for mr, mc in marker_pts[color] if mr == r]\n        if any(mc < c for mc in same_row) and any(mc > c for mc in same_row):\n            return True\n        same_col = [mr for mr, mc in marker_pts[color] if mc == c]\n        return any(mr < r for mr in same_col) and any(mr > r for mr in same_col)\n\n    for pt, colors_here in claims.items():\n        forced = {color for color in colors_here if pt in control_ray[color]}\n        if forced:\n            assert len(forced) == 1, f\"ambiguous yellow-control rays at {pt}: {forced}\"\n            out[pt] = next(iter(forced))\n            continue\n\n        if len(colors_here) == 1:\n            out[pt] = colors_here[0]\n            continue\n\n        original_crossing = [color for color in colors_here if int(g[pt]) == color]\n        if original_crossing:\n            out[pt] = min(colors_here, key=lambda color: (-comp_count[color], color))\n        else:\n            bracketed = [color for color in colors_here if marker_brackets(color, pt)]\n            if bracketed:\n                out[pt] = min(bracketed, key=lambda color: (-comp_count[color], color))\n            else:\n                out[pt] = min(colors_here)\n\n    # Assert: every visible endpoint is on the boundary (or at a crossing)\n    for color in line_colors:\n        for comp in components_mask(out == color, connectivity=4):\n            pts_set = set(map(tuple, comp))\n            for r, c in pts_set:\n                nbrs = [(nr, nc) for nr, nc in [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]\n                        if (nr, nc) in pts_set]\n                if len(nbrs) != 1:\n                    continue\n                on_boundary = (r == 0 or r == H - 1 or c == 0 or c == W - 1)\n                if on_boundary:\n                    # Perpendicularity check\n                    nr, nc = nbrs[0]\n                    dr, dc = nr - r, nc - c\n                    if not ((r in (0, H-1)) and (c in (0, W-1))):\n                        perp = ((r == 0 and dr == 1) or (r == H-1 and dr == -1)\n                                or (c == 0 and dc == 1) or (c == W-1 and dc == -1))\n                        assert perp, f\"boundary endpoint ({r},{c}) color {color} not perpendicular\"\n                    continue\n                adj_other = any(\n                    0 <= r+dr < H and 0 <= c+dc < W\n                    and int(out[r+dr, c+dc]) not in (bg, color)\n                    for dr, dc in DIRS4)\n                assert adj_other, f\"dangling endpoint ({r},{c}) color {color}: not on boundary or crossing\"\n\n    # Assert: every line color crosses at least one other color\n    color_cells = {c: set() for c in line_colors}\n    for r in range(H):\n        for c in range(W):\n            v = int(out[r, c])\n            if v in line_colors:\n                color_cells[v].add((r, c))\n    crossing_colors = set()\n    for r in range(H):\n        for c in range(W):\n            a = int(out[r, c])\n            if a not in line_colors:\n                continue\n            for b in line_colors - {a}:\n                if (((r, c-1) in color_cells[b] and (r, c+1) in color_cells[b])\n                        or ((r-1, c) in color_cells[b] and (r+1, c) in color_cells[b])):\n                    crossing_colors.add(a)\n                    crossing_colors.add(b)\n    for color in line_colors:\n        assert color in crossing_colors, f\"color {color} has no crossing with any other color\"\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- CFG: grid & palette ---\nH = W = 12\nBG = 0\nDIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nLINE_PALETTE = [1, 3, 5, 6, 7, 8, 9]\n\n# --- CFG: polyline shape ---\nPOLYLINE_PIECE_WEIGHTS = [5, 4, 2, 1]  # weights for 1-4 segments per polyline\nMIN_SPAN_LEN = 4                        # minimum length of a polyline's primary span\nFULL_SPAN_PROB = 0.65                    # probability path_through extends to grid edge\nARM_MIN_OFFSET = 2                       # minimum distance between arm column and main line\n\n# --- CFG: serpentine & crossings ---\nCROSSING_COUNT_WEIGHTS = [2, 3, 3, 2]  # weights for 1-4 crossing rows in serpentine\nSERPENTINE_MINOR_LO = 6                 # max value for minor-axis lower bound\nSERPENTINE_MINOR_HI = 5                 # max value for minor-axis upper offset from 0\nCROSS_MINOR_MARGIN = 2                  # margin from serpentine edges to crossing column\nMAX_COLORS = 4                          # maximum number of line colors\nMAX_CROSSINGS = 12                      # upper bound on crossing cell count\n\n# --- CFG: markers ---\nMARKER_MODE_WEIGHTS = [4, 2, 3]  # weights for red-only / yellow-only / both\nYELLOW_COUNT_RANGE = (1, 2)\nRED_COUNT_RANGE = (2, 6)\nMIN_CELLS_FOR_RED = 2             # color must have > this many cells to place a red marker\n\n# --- CFG: output validation ---\nCOMPONENTS_PER_COLOR = (1, 4)\nTOTAL_COMPONENTS = (4, 6)\nFILL_RANGE = (33, 55)            # non-bg cell count in output\n\n# --- CFG: retry budgets ---\nSPACED_VALUES_RETRIES = 60\nEXTRA_POLYLINE_RETRIES = 80\nGEN_RETRIES = 300\n\n\ndef _neighbors(pt: tuple[int, int]) -> list[tuple[int, int]]:\n    r, c = pt\n    return [(r + dr, c + dc) for dr, dc in DIRS4 if 0 <= r + dr < H and 0 <= c + dc < W]\n\n\ndef _segment(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:\n    r0, c0 = a; r1, c1 = b\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/458e3a53.py\"","aggregated_output":"import numpy as np\nimport random\nfrom arc_utils import paste\n\n\ndef _bands(size: int, separators: list[int]) -> list[tuple[int, int]]:\n    bands = []\n    start = 0\n    for cut in separators:\n        if start < cut:\n            bands.append((start, cut - 1))\n        start = cut + 1\n    if start < size:\n        bands.append((start, size - 1))\n    return bands\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extract the compact table of solid cells hidden inside a separator lattice.\n\n    Input structure\n    - The grid has full-width and full-height bars of one separator color, dividing it into rectangular cells.\n    - Most cells contain a repeating multicolor pattern, while a contiguous rectangle of cells is solid monochrome.\n\n    Rule\n    - Split the input into lattice cells using the full separator rows and columns.\n    - Keep the cells whose full interior is one color, crop to their occupied rectangle, and output those colors.\n\n    Key insight\n    - The periodic pattern is noise; only completely solid lattice cells encode the reduced output grid.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    row_colors = {int(g[r, 0]) for r in range(h) if np.all(g[r, :] == g[r, 0])}\n    col_colors = {int(g[0, c]) for c in range(w) if np.all(g[:, c] == g[0, c])}\n    sep_colors = row_colors & col_colors\n    assert len(sep_colors) == 1, \"there must be exactly one row/column separator color\"\n    sep = next(iter(sep_colors))\n    assert row_colors == {sep}, \"all full rows must be separator rows\"\n    assert col_colors == {sep}, \"all full columns must be separator columns\"\n\n    sep_rows = [r for r in range(h) if np.all(g[r, :] == sep)]\n    sep_cols = [c for c in range(w) if np.all(g[:, c] == sep)]\n    assert sep_rows and sep_cols, \"separator lattice must have rows and columns\"\n\n    row_bands = _bands(h, sep_rows)\n    col_bands = _bands(w, sep_cols)\n\n    solid_cells = {}\n    for ri, (r0, r1) in enumerate(row_bands):\n        for ci, (c0, c1) in enumerate(col_bands):\n            cell = g[r0 : r1 + 1, c0 : c1 + 1]\n            if np.all(cell == cell[0, 0]):\n                solid_cells[(ri, ci)] = int(cell[0, 0])\n    assert solid_cells, \"must contain at least one solid lattice cell\"\n\n    solid_rows = [ri for ri, _ in solid_cells]\n    solid_cols = [ci for _, ci in solid_cells]\n    r0, r1 = min(solid_rows), max(solid_rows)\n    c0, c1 = min(solid_cols), max(solid_cols)\n\n    out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)\n    for ri in range(r0, r1 + 1):\n        for ci in range(c0, c1 + 1):\n            assert (ri, ci) in solid_cells, \"solid lattice cells must form a rectangle\"\n            out[ri - r0, ci - c0] = solid_cells[(ri, ci)]\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Lattice dimensions: valid (L, cell_size) pairs produce 27-30 square grids.\nVALID_LC = [(4, 6), (5, 5), (6, 4)]\nCOLOR_COUNT = 10\nSEPARATOR_WIDTH = 1\n# Solid rectangle: output block size in lattice coordinates.\nSOLID_SIZE_RANGE = (2, 3)\n# Pattern cells: diagonal variants are multicolor and solver-visible as non-solid.\nPATTERN_TILE_MIN_COLORS = 5\nPATTERN_CELL_MIN_COLORS = 2\nDIAGONAL_ID_BITS = 4\n# Retry budget: regenerate on rare validation failures.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _pattern_tiles(csize: int, lattice: int, sep: int) -> dict[int, np.ndarray]:\n    \"\"\"Build one structured tile per lattice diagonal, or {} if validation fails.\"\"\"\n    colors = [c for c in range(COLOR_COUNT) if c != sep]\n    random.shuffle(colors)\n    palette = colors[: random.randint(PATTERN_TILE_MIN_COLORS, len(colors))]\n    palette_arr = np.asarray(palette, dtype=int)\n    k = len(palette)\n\n    rr, cc = np.indices((csize, csize))\n    base = (rr + cc + random.randrange(k)) % k\n    if random.choice([False, True]):\n        base = base.T\n    if random.choice([False, True]):\n        base = np.fliplr(base)\n    if random.choice([False, True]):\n        base = np.flipud(base)\n    tiles = {}\n    for diag in range(2 * lattice - 1):\n        tile_idx = (base + random.randrange(k)) % k\n        tile = palette_arr[tile_idx]\n        # Encode the diagonal id in four cells so variants are guaranteed distinct.\n        for bit in range(DIAGONAL_ID_BITS):\n            tile.flat[bit] = palette[(diag >> bit) & 1]\n        if len(np.unique(tile)) < PATTERN_TILE_MIN_COLORS:\n            return {}\n        tiles[diag] = tile\n    return tiles\n\n\ndef _sample_solid_block(lattice, colors):\n    \"\"\"Return ((row, col, height, width), output colors) for the solid block.\"\"\"\n    solid_h = random.randint(*SOLID_SIZE_RANGE)\n    solid_w = random.randint(*SOLID_SIZE_RANGE)\n    solid_r0 = random.randint(0, lattice - solid_h)\n    solid_c0 = random.randint(0, lattice - solid_w)\n    flat = np.random.choice(colors, size=solid_h * solid_w).astype(int)\n    if len(set(map(int, flat))) == 1:\n        change_at = random.randrange(len(flat))\n        flat[change_at] = random.choice([c for c in colors if c != int(flat[change_at])])\n    return (solid_r0, solid_c0, solid_h, solid_w), flat.reshape((solid_h, solid_w))\n\n\ndef _render_grid(lattice, csize, sep, block, out, tiles):\n    \"\"\"Assemble the separator lattice from solid cells and pattern tiles.\"\"\"\n    n = lattice * csize + (lattice - 1)\n    grid = np.full((n, n), sep, dtype=int)\n    solid_r0, solid_c0, solid_h, solid_w = block\n    stride = csize + SEPARATOR_WIDTH\n    for ri in range(lattice):\n        for ci in range(lattice):\n            r0, c0 = ri * stride, ci * stride\n            if solid_r0 <= ri < solid_r0 + solid_h and solid_c0 <= ci < solid_c0 + solid_w:\n                cell = np.full((csize, csize), int(out[ri - solid_r0, ci - solid_c0]), dtype=int)\n            else:\n                cell = tiles[(ri - ci) % (2 * lattice - 1)]\n            paste(grid, cell, r0, c0)\n    return grid\n\n\ndef _valid_generated_grid(grid, lattice, csize, sep, block):\n    \"\"\"Check separator lines and non-solid cells before the solver oracle.\"\"\"\n    stride = csize + SEPARATOR_WIDTH\n    sep_lines = [csize + i * stride for i in range(lattice - 1)]\n    if not all(np.all(grid[r, :] == sep) and np.all(grid[:, r] == sep) for r in sep_lines):\n        return False\n    solid_r0, solid_c0, solid_h, solid_w = block\n    for ri in range(lattice):\n        for ci in range(lattice):\n            if solid_r0 <= ri < solid_r0 + solid_h and solid_c0 <= ci < solid_c0 + solid_w:\n                continue\n            r0, c0 = ri * stride, ci * stride\n            if len(np.unique(grid[r0 : r0 + csize, c0 : c0 + csize])) < PATTERN_CELL_MIN_COLORS:\n                return False\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    lattice, csize = random.choice(VALID_LC)\n    sep = random.randrange(COLOR_COUNT)\n    colors = [c for c in range(COLOR_COUNT) if c != sep]\n    block, out = _sample_solid_block(lattice, colors)\n    tiles = _pattern_tiles(csize, lattice, sep)\n    if not tiles:\n        return None\n    grid = _render_grid(lattice, csize, sep, block, out, tiles)\n    if not _valid_generated_grid(grid, lattice, csize, sep, block):\n        return None\n    try:\n        if not np.array_equal(main(grid), out):\n            return None\n    except AssertionError:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 458e3a53 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/eval/b10624e5.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, paste\nimport random\n\n\ndef _find_dividers(g: np.ndarray, bg: int) -> tuple[int, int]:\n    \"\"\"\n    Return the unique full-row/full-col quadrant divider: (mid_row, mid_col).\n    \"\"\"\n    h, w = g.shape\n    full_rows = [(r, int(g[r, 0])) for r in range(h) if np.all(g[r, :] == g[r, 0]) and int(g[r, 0]) != bg]\n    full_cols = [(c, int(g[0, c])) for c in range(w) if np.all(g[:, c] == g[0, c]) and int(g[0, c]) != bg]\n    matches = []\n    for r, vr in full_rows:\n        for c, vc in full_cols:\n            if vr == vc:\n                matches.append((int(r), int(c)))\n    assert len(matches) == 1, \"grid must have exactly one matching full-row/full-col divider\"\n    return matches[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replicate a motif across quadrants with scaling and reflection keyed to red anchor blocks.\n\n    Input structure:\n    - Grid divided into four quadrants by a full-row and full-column divider of a single non-bg color.\n    - Each quadrant contains a red (2) square anchor block of varying size.\n    - The top-left quadrant also has a colored motif attached to its red anchor.\n\n    Rule:\n    - Use the top-left quadrant's motif as the source pattern.\n    - For each other quadrant, scale the motif by the ratio of that quadrant's red block size to the source red block size.\n    - Reflect horizontally for right-side quadrants, vertically for bottom quadrants (both for bottom-right).\n    - Align the scaled/reflected motif so its red region overlaps the target anchor, then stamp non-bg pixels.\n\n    Key insight: Red block size encodes the scale factor; quadrant position encodes the reflection axes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    out = g.copy()\n\n    bg = get_bg(g)\n    mid_r, mid_c = _find_dividers(g, bg)\n\n    # Find red anchor blocks (color 2) in each quadrant.\n    red = components_mask(g == 2, connectivity=4)\n    assert red, \"grid must contain red (color 2) anchor blocks\"\n\n    # Quadrant key: (top/bottom, left/right)\n    anchors: dict[tuple[int, int], tuple[int, int, int]] = {}\n    # value: (r0,c0,size)\n    for pts in red:\n        r0, c0, r1, c1 = bbox_coords(pts)\n        rr = (r0 + r1) // 2\n        cc = (c0 + c1) // 2\n        qb = 0 if rr < mid_r else 1\n        qr = 0 if cc < mid_c else 1\n        size = max(r1 - r0 + 1, c1 - c0 + 1)\n        key = (qb, qr)\n        assert key not in anchors, \"each quadrant must contain exactly one red anchor block\"\n        anchors[key] = (int(r0), int(c0), int(size))\n\n    assert (0, 0) in anchors, \"top-left quadrant must contain a red anchor block\"\n    sr0, sc0, sL = anchors[(0, 0)]\n    assert sL > 0, \"top-left red anchor must have positive size\"\n\n    # Build a source patch around the TL motif: take the non-bg connected component (4-neigh)\n    # in the TL quadrant that contains the TL red anchor.\n    tl = g[0:mid_r, 0:mid_c]\n    comps = components_mask(tl != bg, connectivity=4)\n    patch_bb = None\n    for pts in comps:\n        # component contains any red pixel?\n        if any(tl[r, c] == 2 for r, c in pts):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            patch_bb = (int(r0), int(c0), int(r1), int(c1))\n            break\n    assert patch_bb is not None, \"top-left quadrant must contain a non-bg component with a red pixel\"\n\n    pr0, pc0, pr1, pc1 = patch_bb\n    patch = tl[pr0 : pr1 + 1, pc0 : pc1 + 1].copy()\n\n    def resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:\n        src_h, src_w = img.shape\n        if new_h <= 0 or new_w <= 0:\n            return img.copy()\n        rr = (np.floor(np.arange(new_h) * src_h / new_h)).astype(int)\n        cc = (np.floor(np.arange(new_w) * src_w / new_w)).astype(int)\n        rr = np.clip(rr, 0, src_h - 1)\n        cc = np.clip(cc, 0, src_w - 1)\n        return img[rr[:, None], cc[None, :]]\n\n    # For each quadrant anchor, paste a scaled/reflected version of the patch.\n    for (qb, qr), (tr0, tc0, tL) in anchors.items():\n        if (qb, qr) == (0, 0):\n            continue\n        patch_t = patch\n        if qr == 1:\n            patch_t = np.fliplr(patch_t)\n        if qb == 1:\n            patch_t = np.flipud(patch_t)\n\n        ratio = float(tL) / float(sL)\n        new_h = int(round(patch_t.shape[0] * ratio))\n        new_w = int(round(patch_t.shape[1] * ratio))\n        new_h = max(1, new_h)\n        new_w = max(1, new_w)\n        patch_s = resize_nn(patch_t, new_h, new_w)\n        roundtrip = resize_nn(patch_s, patch_t.shape[0], patch_t.shape[1])\n        assert np.array_equal(roundtrip, patch_t), \"scaling must preserve all motif information\"\n\n        # Align scaled red bbox in patch_s to the target red bbox.\n        rr_red, cc_red = np.where(patch_s == 2)\n        assert rr_red.size > 0, \"scaled source patch must contain red anchor pixels\"\n        ar0, ac0 = int(rr_red.min()), int(cc_red.min())\n        place_r0 = tr0 - ar0\n        place_c0 = tc0 - ac0\n\n        rr_p, cc_p = np.where(patch_s != bg)\n        for rr0, cc0 in zip(rr_p.tolist(), cc_p.tolist(), strict=False):\n            val = int(patch_s[rr0, cc0])\n            rr_t = place_r0 + rr0\n            cc_t = place_c0 + cc0\n            if not (0 <= rr_t < h and 0 <= cc_t < w):\n                continue\n            if rr_t == mid_r or cc_t == mid_c:\n                continue\n            if out[rr_t, cc_t] == 2:\n                continue\n            out[rr_t, cc_t] = val\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- Grid constants ---\nBG = 4                  # background color\nDIV = 1                 # divider color\nRED = 2                 # anchor color\nGRID_SIZE = 27          # full grid dimension\nMID = 13                # divider row/col index\nQUADS = {               # (row_lo, row_hi, col_lo, col_hi) inclusive per quadrant\n    (0, 0): (0, 12, 0, 12),\n    (0, 1): (0, 12, 14, 26),\n    (1, 0): (14, 26, 0, 12),\n    (1, 1): (14, 26, 14, 26),\n}\n\n# --- Source motif parameters ---\nSOURCE_ANCHOR_SIZE = 2                  # TL anchor is always 2x2\nBLOCK_DIMS = [(2, 2), (2, 3), (3, 2), (3, 3)]  # logical block sizes for block method\nBLOCK_PROB = 0.5                        # prob of block method when not forced\nFILL_RATIO_MIN = 0.5                    # minimum motif fill ratio\nFILL_RATIO_MAX = 0.8                    # maximum motif fill ratio\nFREEFORM_H_RANGE = (3, 6)              # freeform motif height range\nFREEFORM_W_RANGE = (3, 6)              # freeform motif width range\nMOTIF_COLORS_MIN = 3                    # min distinct non-bg colors (including red)\nMOTIF_COLORS_MAX = 5                    # max distinct non-bg colors\nCOLOR_POOL = [0, 1, 3, 5, 6, 7, 8, 9]  # non-red, non-bg candidate colors\n\n# --- Target anchor parameters ---\nTARGET_SIZE_RANGE = (1, 4)              # anchor size range for non-TL quadrants\n\n# --- Generation retry limit ---\nMAX_RETRIES = 300\n\n\ndef _resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:\n    \"\"\"Nearest-neighbor resize supporting fractional scale ratios.\"\"\"\n    src_h, src_w = img.shape\n    rr = np.clip(np.floor(np.arange(new_h) * src_h / new_h).astype(int), 0, src_h - 1)\n    cc = np.clip(np.floor(np.arange(new_w) * src_w / new_w).astype(int), 0, src_w - 1)\n    return img[rr[:, None], cc[None, :]]\n\n\ndef _scaled_patch(patch: np.ndarray, qb: int, qr: int, target_size: int) -> np.ndarray:\n    \"\"\"Reflect and scale the source patch for a given quadrant and target anchor size.\"\"\"\n    p = patch\n    if qr:\n        p = np.fliplr(p)\n    if qb:\n        p = np.flipud(p)\n    ratio = target_size / SOURCE_ANCHOR_SIZE\n    h = max(1, int(round(p.shape[0] * ratio)))\n    w = max(1, int(round(p.shape[1] * ratio)))\n    return _resize_nn(p, h, w)\n\n\ndef _grow_4conn(h: int, w: int, seeds: set[tuple[int, int]], n_fill: int) -> set[tuple[int, int]]:\n    \"\"\"Grow a 4-connected region from seeds until it has n_fill cells.\"\"\"\n    filled = set(seeds)\n    frontier = set()\n    for r, c in seeds:\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:\n                frontier.add((nr, nc))\n    while len(filled) < n_fill and frontier:\n        cell = random.choice(list(frontier))\n        filled.add(cell)\n        frontier.discard(cell)\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nr, nc = cell[0] + dr, cell[1] + dc\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:\n                frontier.add((nr, nc))\n    return filled\n\n\ndef _assign_colors(filled: set[tuple[int, int]], red_cells: set[tuple[int, int]],\n                   h: int, w: int) -> np.ndarray | None:\n    \"\"\"Assign random colors to filled cells; returns None if coverage is incomplete.\"\"\"\n    rows = {r for r, _ in filled}\n    cols = {c for _, c in filled}\n    if rows != set(range(h)) or cols != set(range(w)):\n        return None\n    non_red = [p for p in filled if p not in red_cells]\n    random.shuffle(non_red)\n    max_colors = min(MOTIF_COLORS_MAX, len(non_red) + 1)\n    if max_colors < MOTIF_COLORS_MIN:\n        return None\n    n_colors = random.randint(MOTIF_COLORS_MIN, max_colors)\n    pool = COLOR_POOL[:]\n    random.shuffle(pool)\n    extras = pool[: n_colors - 1]\n    grid = np.full((h, w), BG, dtype=int)\n    for r, c in red_cells:\n        grid[r, c] = RED\n    for i, (r, c) in enumerate(non_red):\n        grid[r, c] = extras[i] if i < len(extras) else random.choice(extras)\n    return grid\n\n\ndef _source_patch(needs_block: bool) -> tuple[np.ndarray, int, int] | None:\n    \"\"\"Build the TL motif patch. Block method upscales a logical grid by SOURCE_ANCHOR_SIZE;\n    freeform method grows directly at pixel resolution with a 2x2 red anchor.\"\"\"\n    S = SOURCE_ANCHOR_SIZE\n    use_block = needs_block or random.random() < BLOCK_PROB\n    if use_block:\n        lh, lw = random.choice(BLOCK_DIMS)\n        n_cells = lh * lw\n        min_fill = max(3, int(np.ceil(FILL_RATIO_MIN * n_cells)))\n        max_fill = max(min_fill, int(np.floor(FILL_RATIO_MAX * n_cells)))\n        ar, ac = random.randrange(lh), random.randrange(lw)\n        filled = _grow_4conn(lh, lw, {(ar, ac)}, random.randint(min_fill, max_fill))\n        logical = _assign_colors(filled, {(ar, ac)}, lh, lw)\n        if logical is None:\n            return None\n        patch = np.repeat(np.repeat(logical, S, axis=0), S, axis=1)\n        return patch, ar * S, ac * S\n    else:\n        h = random.randint(*FREEFORM_H_RANGE)\n        w = random.randint(*FREEFORM_W_RANGE)\n        ar, ac = random.randint(0, h - S), random.randint(0, w - S)\n        red_cells = {(ar + dr, ac + dc) for dr in range(S) for dc in range(S)}\n        min_fill = max(len(red_cells) + 2, int(np.ceil(FILL_RATIO_MIN * h * w)))\n        max_fill = int(np.floor(FILL_RATIO_MAX * h * w))\n        if max_fill < min_fill:\n            return None\n        filled = _grow_4conn(h, w, red_cells, random.randint(min_fill, max_fill))\n        patch = _assign_colors(filled, red_cells, h, w)\n        if patch is None:\n            return None\n        return patch, ar, ac\n\n\ndef _choose_anchor(qb: int, qr: int, size: int, patch_s: np.ndarray) -> tuple[int, int]:\n    \"\"\"Pick a random anchor position for the red block within the quadrant,\n    preferring positions where the full scaled motif fits inside the quadrant.\"\"\"\n    q_r0, q_r1, q_c0, q_c1 = QUADS[(qb, qr)]\n    rr, cc = np.where(patch_s == RED)\n    red_r0, red_c0 = int(rr.min()), int(cc.min())\n\n    # Range where the full motif fits inside the quadrant\n    fit_r0 = q_r0 + red_r0\n    fit_r1 = q_r1 - patch_s.shape[0] + 1 + red_r0\n    fit_c0 = q_c0 + red_c0\n    fit_c1 = q_c1 - patch_s.shape[1] + 1 + red_c0\n\n    # Range where the anchor block itself fits inside the quadrant\n    anch_r0, anch_r1 = q_r0, q_r1 - size + 1\n    anch_c0, anch_c1 = q_c0, q_c1 - size + 1\n\n    # Intersect: prefer full-fit, fall back to anchor-only fit\n    r_lo, r_hi = max(fit_r0, anch_r0), min(fit_r1, anch_r1)\n    c_lo, c_hi = max(fit_c0, anch_c0), min(fit_c1, anch_c1)\n    if r_lo <= r_hi and c_lo <= c_hi:\n        return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)\n    return random.randint(anch_r0, anch_r1), random.randint(anch_c0, anch_c1)\n\n\ndef _stamp(out: np.ndarray, patch_s: np.ndarray, anchor_r: int, anchor_c: int) -> None:\n    \"\"\"Stamp non-bg pixels from a scaled patch onto the output grid, aligned by red anchor.\n    Skips divider row/col, out-of-bounds pixels, and existing red pixels.\"\"\"\n    rr_red, cc_red = np.where(patch_s == RED)\n    place_r0 = anchor_r - int(rr_red.min())\n    place_c0 = anchor_c - int(cc_red.min())\n\n    # Source pixel coordinates and their target positions\n    src_rr, src_cc = np.where(patch_s != BG)\n    tgt_rr = src_rr + place_r0\n    tgt_cc = src_cc + place_c0\n\n    # Mask: in-bounds, not on divider, target is not already red\n    valid = ((tgt_rr >= 0) & (tgt_rr < GRID_SIZE) &\n             (tgt_cc >= 0) & (tgt_cc < GRID_SIZE) &\n             (tgt_rr != MID) & (tgt_cc != MID))\n    tgt_rr, tgt_cc, src_rr, src_cc = tgt_rr[valid], tgt_cc[valid], src_rr[valid], src_cc[valid]\n    not_red = out[tgt_rr, tgt_cc] != RED\n    out[tgt_rr[not_red], tgt_cc[not_red]] = patch_s[src_rr[not_red], src_cc[not_red]]\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single generation attempt: build output, derive input, oracle-check.\"\"\"\n    target_sizes = {\n        (0, 0): SOURCE_ANCHOR_SIZE,\n        (0, 1): random.randint(*TARGET_SIZE_RANGE),\n        (1, 0): random.randint(*TARGET_SIZE_RANGE),\n        (1, 1): random.randint(*TARGET_SIZE_RANGE),\n","exit_code":0,"status":"completed"}}
