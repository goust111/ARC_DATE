{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/edb79dae.py | sed '\"'$d'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/edb79dae.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp recolored sprites into a framed region using placeholder positions and a color legend.\n\n    Input structure:\n    - bg background, a rectangular single-color frame, colored placeholder cells inside the frame.\n    - Outside the frame: sprite shapes (one per placeholder color) and a small legend mapping each placeholder color to an output color.\n\n    Rule:\n    - Find the frame and its interior placeholders.\n    - For each placeholder color, locate the matching-color sprite outside the frame.\n    - Stamp each sprite at the placeholder's position inside the frame.\n    - Recolor every stamped sprite to the output color defined by the legend.\n\n    Key insight: The legend pairs (overlapping two-color glyphs outside the frame) dictate the final recoloring — placeholder color selects the shape, legend maps it to the output color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    frame_col, (fr0, fc0, fr1, fc1) = _find_frame(g, bg)\n\n    crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1]\n    H, W = crop.shape\n    assert H >= 3 and W >= 3, f\"frame too small for interior: {(H, W)}\"\n\n    # Placeholder components inside the frame interior.\n    inner_mask = np.zeros((H, W), dtype=bool)\n    inner_mask[1:-1, 1:-1] = True\n    placeholder_colors = set(map(int, np.unique(crop[inner_mask]))) - {bg, frame_col}\n    assert placeholder_colors, \"no placeholder colors found inside frame\"\n\n    placeholders: list[tuple[int, tuple[int, int, int, int]]] = []\n    for col in sorted(placeholder_colors):\n        for pts in components_mask((crop == col) & inner_mask, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            placeholders.append((col, (r0, c0, r1, c1)))\n    # Eval inputs use one placement bbox size per placeholder color.\n    phw: dict[int, tuple[int, int]] = {}\n    for col in placeholder_colors:\n        dims = [(b[2] - b[0] + 1, b[3] - b[1] + 1) for c, b in placeholders if c == col]\n        assert dims, f\"no placeholder component found for color {col}\"\n        unique_dims = sorted(set(dims))\n        assert len(unique_dims) == 1, f\"ambiguous placeholder sizes for color {col}: {unique_dims}\"\n        phw[col] = unique_dims[0]\n\n    # Extract outside-frame components for sprite shapes and for legend color mapping.\n    outside = np.ones(g.shape, dtype=bool)\n    outside[fr0 : fr1 + 1, fc0 : fc1 + 1] = False\n\n    # Collect all outside components (with ids) for later pairing.\n    comps = []\n    colors = [int(c) for c in np.unique(g) if int(c) not in (bg, frame_col)]\n    cid = 0\n    for col in colors:\n        for pts in components_mask((g == col) & outside, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            pts_tuples = [(int(r), int(c)) for r, c in pts]\n            comps.append(\n                {\n                    \"id\": cid,\n                    \"col\": int(col),\n                    \"pts\": pts_tuples,\n                    \"bbox\": (r0, c0, r1, c1),\n                    \"area\": len(pts_tuples),\n                }\n            )\n            cid += 1\n\n    def _bbox_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n        ar0, ac0, ar1, ac1 = a\n        br0, bc0, br1, bc1 = b\n        return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)\n\n    # Legend mapping: detect small two-color glyph regions where two components overlap in bbox\n    # and the union bbox contains only those two colors (no background).\n    color_map: dict[int, int] = {}\n    legend_ids: set[int] = set()\n\n    for i in range(len(comps)):\n        for j in range(i + 1, len(comps)):\n            ci = comps[i]\n            cj = comps[j]\n            if ci[\"col\"] == cj[\"col\"]:\n                continue\n            if not _bbox_overlap(ci[\"bbox\"], cj[\"bbox\"]):\n                continue\n            r0 = min(ci[\"bbox\"][0], cj[\"bbox\"][0])\n            c0 = min(ci[\"bbox\"][1], cj[\"bbox\"][1])\n            r1 = max(ci[\"bbox\"][2], cj[\"bbox\"][2])\n            c1 = max(ci[\"bbox\"][3], cj[\"bbox\"][3])\n            # restrict to compact legend-like regions\n            if (r1 - r0 + 1) > 8 or (c1 - c0 + 1) > 8:\n                continue\n            sub = g[r0 : r1 + 1, c0 : c1 + 1]\n            sub_colors = set(map(int, np.unique(sub))) - {frame_col}\n            if bg in sub_colors:\n                continue\n            if len(sub_colors) != 2:\n                continue\n            cset = set(sub_colors)\n            if ci[\"col\"] not in cset or cj[\"col\"] not in cset:\n                continue\n\n            # Decide source->target.\n            # If exactly one color is used as a placeholder inside the frame, that one is source.\n            if (ci[\"col\"] in placeholder_colors) ^ (cj[\"col\"] in placeholder_colors):\n                src = ci[\"col\"] if ci[\"col\"] in placeholder_colors else cj[\"col\"]\n                tgt = cj[\"col\"] if src == ci[\"col\"] else ci[\"col\"]\n            else:\n                # Otherwise: the larger component in this pair is treated as the source.\n                assert ci[\"area\"] != cj[\"area\"], f\"ambiguous equal-area legend pair: {ci['col']} and {cj['col']}\"\n                if ci[\"area\"] > cj[\"area\"]:\n                    src, tgt = ci[\"col\"], cj[\"col\"]\n                else:\n                    src, tgt = cj[\"col\"], ci[\"col\"]\n\n            assert src in placeholder_colors, f\"legend source color {src} is not a placeholder\"\n            assert src not in color_map, f\"duplicate legend mapping for placeholder color {src}\"\n            color_map[src] = int(tgt)\n            legend_ids.add(ci[\"id\"])\n            legend_ids.add(cj[\"id\"])\n    assert set(color_map) == placeholder_colors, (\n        f\"legend mappings {sorted(color_map)} do not match placeholders {sorted(placeholder_colors)}\"\n    )\n\n    # Sprite shapes: for each placeholder color, pick the non-legend component matching placeholder size.\n    sprite_coords: dict[int, tuple[tuple[tuple[int, int], ...], int, int]] = {}\n    for src_col in sorted(placeholder_colors):\n        all_candidates = [c for c in comps if c[\"col\"] == src_col and c[\"id\"] not in legend_ids]\n        assert all_candidates, f\"no non-legend sprite found for color {src_col}\"\n        want_h, want_w = phw[src_col]\n        sized = [\n            c\n            for c in all_candidates\n            if (c[\"bbox\"][2] - c[\"bbox\"][0] + 1) == want_h and (c[\"bbox\"][3] - c[\"bbox\"][1] + 1) == want_w\n        ]\n        assert len(sized) == 1, f\"expected one size-matched sprite for color {src_col}, found {len(sized)}\"\n        base = sized[0]\n        sr0, sc0, sr1, sc1 = base[\"bbox\"]\n\n        # Some sprites can be split into multiple 4-connected components of the same color.\n        # Merge any additional (non-legend) components fully contained in the chosen sprite bbox.\n        pts_set = set(base[\"pts\"])\n        for c in all_candidates:\n            if c[\"id\"] == base[\"id\"]:\n                continue\n            r0, c0, r1, c1 = c[\"bbox\"]\n            assert sr0 <= r0 and sr1 >= r1 and sc0 <= c0 and sc1 >= c1, (\n                f\"extra sprite component for color {src_col} is outside the base bbox\"\n            )\n            pts_set.update(c[\"pts\"])\n\n        coords = tuple(sorted((r - sr0, c - sc0) for r, c in pts_set))\n        sprite_coords[src_col] = (coords, sr1 - sr0 + 1, sc1 - sc0 + 1)\n\n    # Build output crop: keep frame border, clear interior to bg, then paste recolored sprites.\n    out = crop.copy()\n    out[1:-1, 1:-1] = bg\n\n    for src_col, (pr0, pc0, pr1, pc1) in placeholders:\n        assert src_col in sprite_coords and src_col in color_map, f\"placeholder color {src_col} missing sprite or color mapping\"\n        tgt_col = int(color_map[src_col])\n        coords, sh, sw = sprite_coords[src_col]\n        assert (pr1 - pr0 + 1, pc1 - pc0 + 1) == (sh, sw), (\n            f\"placeholder size does not match sprite for color {src_col}\"\n        )\n        assert pr0 + sh <= H and pc0 + sw <= W, f\"sprite for color {src_col} does not fit at placeholder\"\n        # Align sprite's bbox top-left to placeholder bbox top-left.\n        off_r = pr0\n        off_c = pc0\n        for dr, dc in coords:\n            rr, cc = off_r + dr, off_c + dc\n            out[rr, cc] = tgt_col\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# === CFG: tunables ===\nFRAME_COL = 5                       # frame border color (always gray)\nSPRITE_N_RANGE = (3, 6)             # NxN sprite/placeholder size, exclusive upper\nGRID_ROWS_RANGE = (2, 4)            # placeholder grid row count, exclusive upper\nGRID_COLS_RANGE = (3, 5)            # placeholder grid col count, exclusive upper\nTOTAL_BLOCKS_RANGE = (6, 10)        # total filled slots (inclusive)\nMAX_EMPTY_SLOTS = 2                 # max empty slots in the grid\nNUM_COLORS_RANGE = (2, 5)           # K = number of distinct placeholder colors (inclusive)\nSPRITE_FILL_MIN = 0.5               # min sprite fill ratio\nSPRITE_FILL_MAX = 0.9               # max sprite fill ratio (clamped to n*n-1)\nMIN_FRAME_H = 13                    # minimum frame height\nMIN_FRAME_W = 18                    # minimum frame width\nMAX_FRAME_DIM = 21                  # maximum frame height or width\nFRAME_MARGIN_SLACK = 4              # max extra padding inside frame beyond content\nCANVAS_H_RANGE = (22, 31)           # final grid height range, exclusive upper\nCANVAS_W_RANGE = (23, 31)           # final grid width range, exclusive upper\nFRAME_POS_JITTER_PROB = 0.25        # probability of non-edge frame placement per axis\nPATCH_PADDING = 1                   # min bg gap between placed patches\nGEN_RETRIES = 300                   # outer retry budget\n\n\n","exit_code":0,"status":"completed"}}
