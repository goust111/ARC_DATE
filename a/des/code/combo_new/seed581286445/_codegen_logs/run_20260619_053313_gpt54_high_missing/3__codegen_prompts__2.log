{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/99caaf76.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each marked cross object away from its marker to the grid edge while rotating the colored cross 180 degrees.\n\n    Input structure:\n    - The background is the dominant color.\n    - Each 8-connected foreground object has nine pixels: a 4-pixel marker-color\n      sprite attached to a 5-pixel non-marker colored cross.\n    - Each object bbox is either 3x6 or 6x3, so the marker sprite is on exactly\n      one side of the cross.\n\n    Rule:\n    - Move the whole object straight away from its marker side until the object\n      bbox touches the corresponding grid edge.\n    - Keep the marker sprite unchanged within the object.\n    - Rotate the 3x3 colored cross block by 180 degrees before placing it.\n\n    Key insight:\n    The marker sprite is a directional tail; the cross is the leading payload,\n    and only that payload turns around during the slide to the edge.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = get_bg(g)\n    marker = _marker_color(g, bg)\n\n    out = np.full_like(g, int(bg))\n    objects = find_components(g, bg=bg, connectivity=8, monochromatic=False)\n    assert objects, \"expected at least one composite object\"\n\n    for obj in objects:\n        assert int(obj[\"area\"]) == 9, \"each composite should contain 9 foreground pixels\"\n        r0, c0, _r1, _c1 = obj[\"bbox\"]\n        patch = crop_bbox(g, obj[\"bbox\"])\n        h, w = patch.shape\n        moved = patch.copy()\n\n        if (h, w) == (3, 6):\n            left = patch[:, :3]\n            right = patch[:, 3:]\n            left_kind = _block_kind(left, bg, marker)\n            right_kind = _block_kind(right, bg, marker)\n            assert {left_kind, right_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n\n            if left_kind == \"marker\":\n                moved[:, 3:] = np.rot90(right, 2)\n                target_r, target_c = int(r0), W - w\n            else:\n                moved[:, :3] = np.rot90(left, 2)\n                target_r, target_c = int(r0), 0\n\n        elif (h, w) == (6, 3):\n            top = patch[:3, :]\n            bottom = patch[3:, :]\n            top_kind = _block_kind(top, bg, marker)\n            bottom_kind = _block_kind(bottom, bg, marker)\n            assert {top_kind, bottom_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n\n            if top_kind == \"marker\":\n                moved[3:, :] = np.rot90(bottom, 2)\n                target_r, target_c = H - h, int(c0)\n            else:\n                moved[:3, :] = np.rot90(top, 2)\n                target_r, target_c = 0, int(c0)\n\n        else:\n            raise AssertionError(\"each composite bbox should be 3x6 or 6x3\")\n\n        _paste_checked(out, moved, target_r, target_c, bg)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Colors.\n_GEN_BG = 8\n_GEN_MARKER = 1\n_GEN_CENTER = 4\n_GEN_ARM_COLORS = [0, 2, 3, 5, 6, 7, 9]\n\n# Object layout.\n_GEN_SIDES = [\"left\", \"right\", \"top\", \"bottom\"]\n_GEN_MARKER_COORDS = {\n    \"left\": [(0, 0), (1, 1), (1, 2), (2, 0)],\n    \"right\": [(0, 2), (1, 0), (1, 1), (2, 2)],\n    \"top\": [(0, 0), (0, 2), (1, 1), (2, 1)],\n    \"bottom\": [(0, 1), (1, 1), (2, 0), (2, 2)],\n}\n_GEN_ARM_POSITIONS = [(0, 1), (1, 0), (1, 2), (2, 1)]\n\n# Canvas and placement bounds.\n_GEN_OBJECT_COUNT_RANGE = (1, 4)\n_GEN_MAX_SIDE = 18\n_GEN_MIN_SIDE_BY_OBJECT_COUNT = {1: 8, 2: 8, 3: 10, 4: 12}\n_GEN_PADDING = 1\n_GEN_EDGE_GAP = 2\n_GEN_HORIZONTAL_SIZE = (3, 6)\n_GEN_VERTICAL_SIZE = (6, 3)\n\n# Retry limits.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_marker_block(side: str) -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\ndef _in_bounds(h, w, r, c):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/a25697e4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Dock movable tools into border-anchored frames by filling cavities.\n\n    Input structure:\n    - bg = most common color.\n    - Border-touching components cluster into anchor frames with interior bg cavities.\n    - Non-border 2-color components are movable tools.\n\n    Rule:\n    - Match each tool to a frame whose cavity size equals one of its color-region counts.\n    - Rotate/flip the tool so one color fills the cavity exactly; the other stays outside.\n    - If the docking orientation uses a reflection, swap the tool's two colors.\n\n    Key insight: Cavity size determines tool–frame pairing; reflection triggers color swap.\n    \"\"\"\n    inp = grid\n    g = inp.copy()\n    bg = get_bg(g)\n    H, W = g.shape\n\n    def bbox_gap(a, b) -> int:\n        (ar0, ac0, ar1, ac1) = a\n        (br0, bc0, br1, bc1) = b\n        def gap1(x0, x1, y0, y1):\n            if y1 < x0:\n                return int(x0 - y1)\n            if x1 < y0:\n                return int(y0 - x1)\n            return 0\n        return gap1(ar0, ar1, br0, br1) + gap1(ac0, ac1, bc0, bc1)\n\n    fg = g != int(bg)\n    lab, n = label(fg, structure=STRUCT4)\n    fixed_mask = np.zeros((H, W), dtype=bool)\n    fixed_components = []\n    for cid in range(1, n + 1):\n        pts = np.argwhere(lab == cid)\n        pts_list = [(int(r), int(c)) for r, c in pts]\n        touches = any(r == 0 or r == H - 1 or c == 0 or c == W - 1 for r, c in pts_list)\n        if not touches:\n            continue\n        fixed_components.append({\"pts\": pts_list, \"bbox\": (int(pts[:,0].min()), int(pts[:,1].min()), int(pts[:,0].max()), int(pts[:,1].max()))})\n        for r, c in pts_list:\n            fixed_mask[r, c] = True\n\n    assert not (not fixed_components)\n\n    # Cluster fixed components into anchor frames.\n    parent = list(range(len(fixed_components)))\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(a, b):\n        ra, rb = find(a), find(b)\n        if ra != rb:\n            parent[rb] = ra\n\n    for i in range(len(fixed_components)):\n        for j in range(i + 1, len(fixed_components)):\n            if bbox_gap(fixed_components[i][\"bbox\"], fixed_components[j][\"bbox\"]) <= 2:\n                union(i, j)\n\n    groups: dict[int, list[int]] = {}\n    for i in range(len(fixed_components)):\n        groups.setdefault(find(i), []).append(i)\n\n    anchor_groups = []\n    for idxs in groups.values():\n        pts = [p for i in idxs for p in fixed_components[i][\"pts\"]]\n        rs = [r for r, _c in pts]\n        cs = [c for _r, c in pts]\n        bbox = (min(rs), min(cs), max(rs), max(cs))\n        mask = np.zeros((H, W), dtype=bool)\n        for r, c in pts:\n            mask[r, c] = True\n        sock = np.zeros((H, W), dtype=bool)\n        for r in range(bbox[0], bbox[2] + 1):\n            for c in range(bbox[1], bbox[3] + 1):\n                if int(g[r, c]) != int(bg):\n                    continue\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    rr, cc = r + dr, c + dc\n                    if 0 <= rr < H and 0 <= cc < W and mask[rr, cc]:\n                        sock[r, c] = True\n                        break\n\n        # Cavity = largest bg component inside bbox that is adjacent to the anchor pixels.\n        cavity = np.zeros((H, W), dtype=bool)\n        sub_bg = (g[bbox[0] : bbox[2] + 1, bbox[1] : bbox[3] + 1] == int(bg))\n        sub_lab, sub_n = label(sub_bg, structure=STRUCT4)\n        best_c = None  # (area, cid)\n        for cid in range(1, sub_n + 1):\n            ptsc = np.argwhere(sub_lab == cid)\n            area = int(len(ptsc))\n            # check adjacency to anchor within bbox\n            adj = False\n            for rr, cc in ptsc:\n                r = int(bbox[0] + rr)\n                c = int(bbox[1] + cc)\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    r2, c2 = r + dr, c + dc\n                    if bbox[0] <= r2 <= bbox[2] and bbox[1] <= c2 <= bbox[3] and mask[r2, c2]:\n                        adj = True\n                        break\n                if adj:\n                    break\n            if not adj:\n                continue\n            cand = (area, -cid)\n            if best_c is None or cand > best_c:\n                best_c = cand\n                best_id = cid\n        if best_c is not None:\n            ptsc = np.argwhere(sub_lab == best_id)\n            for rr, cc in ptsc:\n                cavity[int(bbox[0] + rr), int(bbox[1] + cc)] = True\n        cav_bbox = None\n        if cavity.any():\n            ptsc2 = np.argwhere(cavity)\n            r0c, c0c = ptsc2.min(axis=0)\n            r1c, c1c = ptsc2.max(axis=0)\n            cav_bbox = (int(r0c), int(c0c), int(r1c), int(c1c))\n\n        # swap rule for this anchor group: look for a color that appears in >=2 fixed sub-components\n        # (within the group) with different sizes and larger-above-smaller.\n        swap_needed = False\n        for col in sorted({int(x) for x in np.unique(g[mask])} - {int(bg)}):\n            sub = (g == int(col)) & mask\n            labc, nc = label(sub, structure=STRUCT4)\n            if nc < 2:\n                continue\n            comps = []\n            for cid in range(1, nc + 1):\n                ptsc = np.argwhere(labc == cid)\n                comps.append((int(len(ptsc)), float(ptsc[:, 0].mean()), float(ptsc[:, 1].mean())))\n            comps.sort(reverse=True)\n            (s0, r0, _c0), (s1, r1, _c1) = comps[0], comps[1]\n            # Swap only when the larger component is vertically above the smaller one.\n            if s0 != s1 and r0 < r1:\n                swap_needed = True\n                break\n\n        # Dominant open direction: which side has the most bg neighbors.\n        dir_list = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # U,D,L,R\n        dir_counts = [0, 0, 0, 0]\n        for r, c in pts:\n            for di, (dr, dc) in enumerate(dir_list):\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(bg):\n                    dir_counts[di] += 1\n        open_dir = dir_list[int(np.argmax(dir_counts))]\n        _labg, _ng = label(mask, structure=STRUCT4)\n        single_piece = int(_ng) == 1\n        cavity_size = int(cavity.sum())\n\n        anchor_groups.append(\n            {\n                \"mask\": mask,\n                \"bbox\": bbox,\n                \"socket_mask\": sock,\n                \"cavity_mask\": cavity,\n                \"cavity_bbox\": cav_bbox,\n                \"open_dir\": open_dir,\n                \"swap_needed\": swap_needed,\n                \"single_piece\": single_piece,\n                \"cavity_size\": cavity_size,\n                \"size\": int(mask.sum()),\n            }\n        )\n    anchor_groups.sort(key=lambda d: -d[\"size\"])\n\n    # Movable multi-color components are the remaining foreground pixels.\n    mov_mask = fg & (~fixed_mask)\n    mov_lab, mov_n = label(mov_mask, structure=STRUCT4)\n    mov_comps = []\n    for cid in range(1, mov_n + 1):\n        pts = np.argwhere(mov_lab == cid)\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        m = mov_lab[r0 : r1 + 1, c0 : c1 + 1] == cid\n        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        patch[~m] = 0\n        mov_comps.append({\"bbox\": (int(r0), int(c0), int(r1), int(c1)), \"mask\": m, \"patch\": patch, \"size\": int(len(pts))})\n    mov_comps.sort(key=lambda d: -d[\"size\"])\n\n    def choose_group(bbox) -> int:\n        best_i = 0\n        best_d = None\n        for i, grp in enumerate(anchor_groups):\n            d = bbox_gap(bbox, grp[\"bbox\"])\n            if best_d is None or d < best_d:\n                best_d = d\n                best_i = i\n        return int(best_i)\n\n    def gen_variants(patch: np.ndarray, mask: np.ndarray):\n        \"\"\"All unique dihedral variants, with a reflection flag.\"\"\"\n        base: list[tuple[np.ndarray, np.ndarray, bool]] = []\n        for k in range(4):\n            p = np.rot90(patch, k)\n            m = np.rot90(mask, k)\n            base.append((p, m, False))\n            base.append((np.fliplr(p), np.fliplr(m), True))\n        uniq: list[tuple[np.ndarray, np.ndarray, bool]] = []\n        seen = set()\n        for p, m, is_flip in base:\n            key = (m.tobytes(), p[m].tobytes())\n            if key in seen:\n                continue\n            seen.add(key)\n            uniq.append((p, m, is_flip))\n        return uniq\n\n    out = np.full_like(g, int(bg))\n    out[fixed_mask] = g[fixed_mask]\n    placed_global = fixed_mask.copy()\n    placed_groups = [grp[\"mask\"].copy() for grp in anchor_groups]\n\n    group_for_comp: list[int]\n    # Match condition (key): a tool can dock into a frame only if one of its two color-regions has\n    # pixel-count equal to the frame's cavity size. Use this to assign tools to frames (one-to-one\n    # when counts match), falling back to distance only if no such match exists.\n    comp_color_counts: list[dict[int, int]] = []\n    for comp in mov_comps:\n        vals = [int(x) for x in comp[\"patch\"][comp[\"mask\"]].flatten() if int(x) != 0]\n        comp_color_counts.append(dict(Counter(vals)))\n\n    def compatible(ci: int, gi: int) -> bool:\n        cav_sz = int(anchor_groups[gi][\"cavity_size\"])\n        return any(int(v) == cav_sz for v in comp_color_counts[ci].values())\n\n    if len(mov_comps) == len(anchor_groups) and len(anchor_groups) > 1:\n        import itertools\n\n        best_perm = None\n        best_score = None\n        for perm in itertools.permutations(range(len(anchor_groups))):\n            ok = True\n            hits = 0\n            dist_sum = 0\n            for ci, gi in enumerate(perm):\n                if not compatible(ci, gi):\n                    ok = False\n                    break\n                hits += 1\n                dist_sum += bbox_gap(mov_comps[ci][\"bbox\"], anchor_groups[gi][\"bbox\"])\n            if not ok:\n                continue\n            score = (int(hits), -int(dist_sum))\n            if best_score is None or score > best_score:\n                best_score = score\n                best_perm = perm\n        assert best_perm is not None, 'must find a compatible tool-to-frame permutation'\n        group_for_comp = [int(x) for x in best_perm]\n    else:\n        group_for_comp = []\n        for ci, comp in enumerate(mov_comps):\n            best_g = None\n            best_d = None\n            for gi, grp in enumerate(anchor_groups):\n                if not compatible(ci, gi):\n                    continue\n                d = bbox_gap(comp[\"bbox\"], grp[\"bbox\"])\n                if best_d is None or d < best_d:\n                    best_d = d\n                    best_g = gi\n            group_for_comp.append(int(best_g) if best_g is not None else int(choose_group(comp[\"bbox\"])))\n\n    for comp, gi in zip(mov_comps, group_for_comp):\n        grp = anchor_groups[gi]\n        placed_grp = placed_groups[gi]\n        sock = grp[\"socket_mask\"]\n        cav = grp[\"cavity_mask\"]\n        cav_bbox = grp[\"cavity_bbox\"]\n        odr, odc = grp[\"open_dir\"]\n        # Swap rule (more principled): swap the two tool colors iff the *docking transform* uses a\n        # reflection (flip). We'll detect this from the winning variant. (Ignore equal-area 2-color\n        # tools: swapping is ambiguous and not needed.)\n        comp_vals = [int(x) for x in comp[\"patch\"][comp[\"mask\"]].flatten() if int(x) != 0]\n        comp_counts = Counter(comp_vals)\n\n        best_state = None\n        # Score prioritizes *filling the cavity* with exactly one tool color region.\n        # (plug_full, plug_hits, -nonplug_in_cavity, -plug_outside, cavity_hits, adj, outside, socket_hits, -dist, -r0, -c0)\n        best_score = None\n        cav_sz = int(grp[\"cavity_size\"])\n        for p, m, is_flip in gen_variants(comp[\"patch\"], comp[\"mask\"]):\n            h, w = m.shape\n            coords = np.argwhere(m)\n            cols_here = sorted({int(x) for x in p[m].flatten() if int(x) != 0})\n            plug_colors = [int(col) for col in cols_here if int(((p == int(col)) & m).sum()) == cav_sz]\n            assert plug_colors\n            for r0 in range(0, H - h + 1):\n                for c0 in range(0, W - w + 1):\n                    ok = True\n                    for rr, cc in coords:\n                        r = int(r0 + rr)\n                        c = int(c0 + cc)\n                        if placed_global[r, c]:\n                            ok = False\n                            break\n                    if not ok:\n                        continue\n                    adj = 0\n                    for rr, cc in coords:\n                        r = int(r0 + rr)\n                        c = int(c0 + cc)\n                        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                            r2, c2 = r + dr, c + dc\n                            if 0 <= r2 < H and 0 <= c2 < W and placed_grp[r2, c2]:\n                                adj += 1\n                    if adj == 0:\n                        continue\n                    socket_hits = 0\n                    cavity_hits = 0\n                    outside = 0\n                    # Best plug-match for this placement among candidate plug colors.\n                    plug_best = None  # (plug_full, plug_hits, -nonplug_in_cavity, -plug_outside)\n                    for rr, cc in coords:\n                        r = int(r0 + rr)\n                        c = int(c0 + cc)\n                        if sock[r, c]:\n                            socket_hits += 1\n                        if cav[r, c]:\n                            cavity_hits += 1\n                        # Count pixels placed outside the anchor bbox in the dominant open direction.\n                        br0, bc0, br1, bc1 = grp[\"bbox\"]\n                        if odc == -1 and c < bc0:\n                            outside += 1\n                        elif odc == 1 and c > bc1:\n                            outside += 1\n                        elif odr == -1 and r < br0:\n                            outside += 1\n                        elif odr == 1 and r > br1:\n                            outside += 1\n\n                    for plug_col in plug_colors:\n                        if plug_col is None:\n                            plug_score = (0, 0, 0, 0)\n                        else:\n                            plug_hits = 0\n                            plug_outside = 0\n                            nonplug_in_cav = 0\n                            for rr, cc in coords:\n                                r = int(r0 + rr)\n                                c = int(c0 + cc)\n                                in_cav = bool(cav[r, c])\n                                col = int(p[rr, cc])\n                                if col == int(plug_col):\n                                    if in_cav:\n                                        plug_hits += 1\n                                    else:\n                                        plug_outside += 1\n                                else:\n                                    if in_cav:\n                                        nonplug_in_cav += 1\n                            plug_full = int(plug_hits == cav_sz and plug_outside == 0 and nonplug_in_cav == 0)\n                            plug_score = (int(plug_full), int(plug_hits), -int(nonplug_in_cav), -int(plug_outside))\n                        if plug_best is None or plug_score > plug_best:\n                            plug_best = plug_score\n                    dist = bbox_gap(grp[\"bbox\"], (int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1)))\n                    score = tuple(plug_best) + (\n                        int(cavity_hits),\n                        int(adj),\n                        int(outside),\n                        int(socket_hits),\n                        -int(dist),\n                        -int(r0),\n                        -int(c0),\n                    )\n                    if best_score is None or score > best_score:\n                        best_score = score\n                        best_state = (p, m, int(r0), int(c0), bool(is_flip))\n\n        assert best_state is not None, 'must find a valid placement for every movable tool'\n        p, m, r0, c0, is_flip = best_state\n        if is_flip and len(comp_counts) == 2 and len(set(comp_counts.values())) == 2:\n            a, b = sorted(comp_counts.keys())\n            q = p.copy()\n            q[(p == a) & m] = b\n            q[(p == b) & m] = a\n            p = q\n        for rr, cc in np.argwhere(m):\n            r = int(r0 + rr)\n            c = int(c0 + cc)\n            out[r, c] = int(p[rr, cc])\n            placed_global[r, c] = True\n            placed_grp[r, c] = True\n\n    return out\n\n# --------------- generator (O4) ---------------\n\nfrom arc_utils import bbox as _bbox\n\n# ── CFG: canvas ──\nGRID_H_RANGE = (18, 30)          # output grid height\nGRID_W_RANGE = (25, 30)          # output grid width\nNUM_PAIRS_CHOICES = [1, 2]       # how many frame-tool pairs\n\n# ── CFG: frame geometry ──\nFRAME_W_RANGE = (4, 8)           # frame width (exclusive upper)\nNOTCH_N_RANGE = (1, 4)           # notch cell count (exclusive upper)\nTOP_H_RANGE = (1, 4)             # top bar height (exclusive upper)\nBOT_H_RANGE = (2, 4)             # bottom bar height (exclusive upper)\nPLUG_AREA_BOUNDS = (5, 8)        # valid plug area = fw + notch_n\n\n# ── CFG: tool sizing ──\nHANDLE_AREA_RANGE = (4, 10)      # handle pixel count (exclusive upper)\nTOOL_TOTAL_BOUNDS = (10, 15)     # plug + handle total pixels\nHANDLE_SPRITE_DIM = (2, 5)      # handle sprite bbox side (exclusive upper)\n\n# ── CFG: placement ──\nUNION_BBOX_GAP_MIN = 2           # min gap between pair union bboxes\nFRAME_BBOX_GAP_MIN = 3           # min gap between frame bboxes\nTOOL_BORDER = 1                  # border margin for free tool placement\nTOOL_PADDING = 3                 # padding around existing content\nTOOL_PADDING_CONN = 4            # connectivity for padding check\n\n# ── CFG: retry limits ──\nPAIR_SPEC_RETRIES = 300          # retries for picking compatible pair specs\nHANDLE_SPRITE_RETRIES = 30       # retries for generating a valid handle sprite\nGEN_ATTEMPT_RETRIES = 300        # outer retries in generate_input()\n\n\ndef _bbox_gap(a, b) -> int:\n","exit_code":0,"status":"completed"}}
