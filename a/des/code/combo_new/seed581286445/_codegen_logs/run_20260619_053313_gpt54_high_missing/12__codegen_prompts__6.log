{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/a/des/code/combo_new/seed581286445/12/6.py | sed -n '1,320p'\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\t\n     3\timport math\n     4\timport random\n     5\t\n     6\timport numpy as np\n     7\t\n     8\t\n     9\tBG = 0\n    10\tSIDES = (\"top\", \"bottom\", \"left\", \"right\")\n    11\tSIDE_STEPS = {\n    12\t    \"top\": (-1, 0),\n    13\t    \"bottom\": (1, 0),\n    14\t    \"left\": (0, -1),\n    15\t    \"right\": (0, 1),\n    16\t}\n    17\tGEN_RETRIES = 400\n    18\tPLACEMENT_RETRIES = 200\n    19\t\n    20\t\n    21\tdef _dominant_color(grid: np.ndarray) -> int:\n    22\t    flat = np.asarray(grid, dtype=int).ravel()\n    23\t    counts = np.bincount(flat)\n    24\t    return int(np.argmax(counts))\n    25\t\n    26\t\n    27\tdef _components_mask(mask: np.ndarray) -> list[list[tuple[int, int]]]:\n    28\t    h, w = mask.shape\n    29\t    seen = np.zeros((h, w), dtype=bool)\n    30\t    comps: list[list[tuple[int, int]]] = []\n    31\t\n    32\t    for r0 in range(h):\n    33\t        for c0 in range(w):\n    34\t            if not mask[r0, c0] or seen[r0, c0]:\n    35\t                continue\n    36\t            stack = [(r0, c0)]\n    37\t            seen[r0, c0] = True\n    38\t            cells: list[tuple[int, int]] = []\n    39\t            while stack:\n    40\t                r, c = stack.pop()\n    41\t                cells.append((int(r), int(c)))\n    42\t                for dr, dc in SIDE_STEPS.values():\n    43\t                    nr = r + dr\n    44\t                    nc = c + dc\n    45\t                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n    46\t                        seen[nr, nc] = True\n    47\t                        stack.append((int(nr), int(nc)))\n    48\t            comps.append(cells)\n    49\t    return comps\n    50\t\n    51\t\n    52\tdef _monochrome_components(grid: np.ndarray, bg: int) -> list[dict]:\n    53\t    g = np.asarray(grid, dtype=int)\n    54\t    h, w = g.shape\n    55\t    seen = np.zeros((h, w), dtype=bool)\n    56\t    comps: list[dict] = []\n    57\t\n    58\t    for r0 in range(h):\n    59\t        for c0 in range(w):\n    60\t            color = int(g[r0, c0])\n    61\t            if color == bg or seen[r0, c0]:\n    62\t                continue\n    63\t\n    64\t            stack = [(r0, c0)]\n    65\t            seen[r0, c0] = True\n    66\t            coords: list[tuple[int, int]] = []\n    67\t            while stack:\n    68\t                r, c = stack.pop()\n    69\t                coords.append((int(r), int(c)))\n    70\t                for dr, dc in SIDE_STEPS.values():\n    71\t                    nr = r + dr\n    72\t                    nc = c + dc\n    73\t                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:\n    74\t                        seen[nr, nc] = True\n    75\t                        stack.append((int(nr), int(nc)))\n    76\t\n    77\t            rows = [r for r, _ in coords]\n    78\t            cols = [c for _, c in coords]\n    79\t            r0b, r1b = min(rows), max(rows)\n    80\t            c0b, c1b = min(cols), max(cols)\n    81\t            mask = np.zeros((r1b - r0b + 1, c1b - c0b + 1), dtype=bool)\n    82\t            for r, c in coords:\n    83\t                mask[r - r0b, c - c0b] = True\n    84\t            comps.append(\n    85\t                {\n    86\t                    \"color\": color,\n    87\t                    \"coords\": coords,\n    88\t                    \"bbox\": (r0b, c0b, r1b, c1b),\n    89\t                    \"mask\": mask,\n    90\t                }\n    91\t            )\n    92\t\n    93\t    return comps\n    94\t\n    95\t\n    96\tdef _open_frame_mask(h: int, w: int, side: str) -> np.ndarray:\n    97\t    mask = np.zeros((h, w), dtype=bool)\n    98\t    if side == \"top\":\n    99\t        mask[-1, :] = True\n   100\t        mask[1:, 0] = True\n   101\t        mask[1:, -1] = True\n   102\t    elif side == \"bottom\":\n   103\t        mask[0, :] = True\n   104\t        mask[:-1, 0] = True\n   105\t        mask[:-1, -1] = True\n   106\t    elif side == \"left\":\n   107\t        mask[0, 1:] = True\n   108\t        mask[-1, 1:] = True\n   109\t        mask[:, -1] = True\n   110\t    elif side == \"right\":\n   111\t        mask[0, :-1] = True\n   112\t        mask[-1, :-1] = True\n   113\t        mask[:, 0] = True\n   114\t    else:\n   115\t        raise ValueError(side)\n   116\t    return mask\n   117\t\n   118\t\n   119\tdef _parse_frames(grid: np.ndarray, bg: int) -> list[dict]:\n   120\t    g = np.asarray(grid, dtype=int)\n   121\t    frames: list[dict] = []\n   122\t\n   123\t    for comp in _monochrome_components(g, bg):\n   124\t        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n   125\t        h = int(r1 - r0 + 1)\n   126\t        w = int(c1 - c0 + 1)\n   127\t        if h < 3 or w < 3:\n   128\t            continue\n   129\t\n   130\t        local = np.asarray(comp[\"mask\"], dtype=bool)\n   131\t        matched_side = None\n   132\t        for side in SIDES:\n   133\t            if np.array_equal(local, _open_frame_mask(h, w, side)):\n   134\t                matched_side = side\n   135\t                break\n   136\t        if matched_side is None:\n   137\t            continue\n   138\t\n   139\t        payload = g[r0 + 1 : r1, c0 + 1 : c1].copy()\n   140\t        if payload.size == 0 or not np.any(payload != bg):\n   141\t            continue\n   142\t        frames.append(\n   143\t            {\n   144\t                \"color\": int(comp[\"color\"]),\n   145\t                \"bbox\": (r0, c0, r1, c1),\n   146\t                \"gap_side\": matched_side,\n   147\t                \"payload\": payload,\n   148\t                \"full_patch\": g[r0 : r1 + 1, c0 : c1 + 1].copy(),\n   149\t            }\n   150\t        )\n   151\t\n   152\t    assert frames, \"expected at least one open frame\"\n   153\t    colors = [frame[\"color\"] for frame in frames]\n   154\t    assert len(colors) == len(set(colors)), \"frame colors must be unique\"\n   155\t    return frames\n   156\t\n   157\t\n   158\tdef _rect_cycle_positions(h: int, w: int) -> list[tuple[int, int]]:\n   159\t    if h < 2 or w < 2:\n   160\t        return []\n   161\t    positions: list[tuple[int, int]] = []\n   162\t    for c in range(w):\n   163\t        positions.append((0, c))\n   164\t    for r in range(1, h):\n   165\t        positions.append((r, w - 1))\n   166\t    for c in range(w - 2, -1, -1):\n   167\t        positions.append((h - 1, c))\n   168\t    for r in range(h - 2, 0, -1):\n   169\t        positions.append((r, 0))\n   170\t    return positions\n   171\t\n   172\t\n   173\tdef _ring_order(grid: np.ndarray, frames: list[dict], bg: int) -> list[int]:\n   174\t    g = np.asarray(grid, dtype=int)\n   175\t    frame_colors = {int(frame[\"color\"]) for frame in frames}\n   176\t    outside = g != bg\n   177\t    for frame in frames:\n   178\t        r0, c0, r1, c1 = map(int, frame[\"bbox\"])\n   179\t        outside[r0 : r1 + 1, c0 : c1 + 1] = False\n   180\t\n   181\t    candidates: list[list[int]] = []\n   182\t    for coords in _components_mask(outside):\n   183\t        colors = [int(g[r, c]) for r, c in coords]\n   184\t        if len(colors) != len(frame_colors):\n   185\t            continue\n   186\t        if len(set(colors)) != len(colors):\n   187\t            continue\n   188\t        if set(colors) != frame_colors:\n   189\t            continue\n   190\t\n   191\t        rows = [r for r, _ in coords]\n   192\t        cols = [c for _, c in coords]\n   193\t        r0, r1 = min(rows), max(rows)\n   194\t        c0, c1 = min(cols), max(cols)\n   195\t        h = r1 - r0 + 1\n   196\t        w = c1 - c0 + 1\n   197\t        positions = _rect_cycle_positions(h, w)\n   198\t        if len(positions) != len(coords):\n   199\t            continue\n   200\t\n   201\t        coord_set = set(coords)\n   202\t        abs_positions = [(r0 + rr, c0 + cc) for rr, cc in positions]\n   203\t        if coord_set != set(abs_positions):\n   204\t            continue\n   205\t\n   206\t        candidates.append([int(g[r, c]) for r, c in abs_positions])\n   207\t\n   208\t    assert len(candidates) == 1, \"expected one rectangular color ring\"\n   209\t    return candidates[0]\n   210\t\n   211\t\n   212\tdef _paint_non_bg(out: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:\n   213\t    h, w = map(int, patch.shape)\n   214\t    view = out[r0 : r0 + h, c0 : c0 + w]\n   215\t    mask = patch != bg\n   216\t    assert not np.any(mask & (view != bg)), \"assembled pieces should not overlap on non-background pixels\"\n   217\t    view[mask] = patch[mask]\n   218\t\n   219\t\n   220\tdef _assemble(frames_in_order: list[dict], bg: int) -> np.ndarray:\n   221\t    first = frames_in_order[0]\n   222\t    first_full = np.asarray(first[\"full_patch\"], dtype=int)\n   223\t    first_payload = np.asarray(first[\"payload\"], dtype=int)\n   224\t    first_ph, first_pw = map(int, first_payload.shape)\n   225\t    fh, fw = map(int, first_full.shape)\n   226\t\n   227\t    pieces: list[tuple[np.ndarray, int, int, bool]] = [(first_full, 0, 0, True)]\n   228\t    min_r = 0\n   229\t    min_c = 0\n   230\t    max_r = fh\n   231\t    max_c = fw\n   232\t\n   233\t    cur_r = 1\n   234\t    cur_c = 1\n   235\t    cur_h = first_ph\n   236\t    cur_w = first_pw\n   237\t\n   238\t    for idx in range(len(frames_in_order) - 1):\n   239\t        side = str(frames_in_order[idx][\"gap_side\"])\n   240\t        next_patch = np.asarray(frames_in_order[idx + 1][\"payload\"], dtype=int)\n   241\t        next_h, next_w = map(int, next_patch.shape)\n   242\t\n   243\t        if side == \"top\":\n   244\t            nr = cur_r - next_h\n   245\t            nc = cur_c\n   246\t        elif side == \"bottom\":\n   247\t            nr = cur_r + cur_h\n   248\t            nc = cur_c\n   249\t        elif side == \"left\":\n   250\t            nr = cur_r\n   251\t            nc = cur_c - next_w\n   252\t        else:\n   253\t            nr = cur_r\n   254\t            nc = cur_c + cur_w\n   255\t\n   256\t        pieces.append((next_patch, nr, nc, False))\n   257\t        min_r = min(min_r, nr)\n   258\t        min_c = min(min_c, nc)\n   259\t        max_r = max(max_r, nr + next_h)\n   260\t        max_c = max(max_c, nc + next_w)\n   261\t        cur_r, cur_c, cur_h, cur_w = nr, nc, next_h, next_w\n   262\t\n   263\t    out = np.full((max_r - min_r, max_c - min_c), bg, dtype=int)\n   264\t    row_off = -min_r\n   265\t    col_off = -min_c\n   266\t    for patch, pr, pc, full_assign in pieces:\n   267\t        h, w = map(int, patch.shape)\n   268\t        rr = pr + row_off\n   269\t        cc = pc + col_off\n   270\t        if full_assign:\n   271\t            out[rr : rr + h, cc : cc + w] = patch\n   272\t        else:\n   273\t            _paint_non_bg(out, patch, rr, cc, bg)\n   274\t    return out\n   275\t\n   276\t\n   277\tdef main(grid: np.ndarray) -> np.ndarray:\n   278\t    \"\"\"\n   279\t    Extract the inner patterns from open frames, order them by a clockwise color ring, and chain them by each frame's opening side.\n   280\t\n   281\t    Input structure:\n   282\t    - The background is black.\n   283\t    - Several disjoint objects each contain a one-pixel-thick monochrome rectangular frame with exactly one whole side missing, plus a multicolor pattern in the frame's interior window.\n   284\t    - Outside those objects there is one separate rectangular color ring made of unique colors, and those colors match the frame colors one-to-one.\n   285\t\n   286\t    Rule:\n   287\t    - Detect every open rectangular frame and record its frame color, missing-side direction, and full interior window.\n   288\t    - Read the external rectangular color ring clockwise starting from its top-left corner to obtain the object order.\n   289\t    - Keep the first ordered object as its original three-sided frame with its interior pattern, then place each next object's interior window flush against the previous interior window on the side indicated by the previous object's opening.\n   290\t    - Drop every later frame and crop the result to the tight bounding box of the assembled figure.\n   291\t\n   292\t    Key insight:\n   293\t    - Two independent signals must be combined: the external ring gives the color order, while each frame's missing side gives the local attachment direction for the next interior pattern.\n   294\t    \"\"\"\n   295\t    g = np.asarray(grid, dtype=int)\n   296\t    assert g.ndim == 2, \"expected a 2D grid\"\n   297\t\n   298\t    bg = _dominant_color(g)\n   299\t    frames = _parse_frames(g, bg)\n   300\t    ring_order = _ring_order(g, frames, bg)\n   301\t    by_color = {int(frame[\"color\"]): frame for frame in frames}\n   302\t    assert set(ring_order) == set(by_color), \"ring colors must match frame colors\"\n   303\t\n   304\t    ordered_frames = [by_color[color] for color in ring_order]\n   305\t    out = _assemble(ordered_frames, bg)\n   306\t    assert max(out.shape) <= 30, \"output must stay within ARC limits\"\n   307\t    return out\n   308\t\n   309\t\n   310\tdef _build_ring(order: list[int], h: int, w: int) -> np.ndarray:\n   311\t    ring = np.zeros((h, w), dtype=int)\n   312\t    positions = _rect_cycle_positions(h, w)\n   313\t    assert len(order) == len(positions)\n   314\t    for color, (r, c) in zip(order, positions, strict=True):\n   315\t        ring[r, c] = int(color)\n   316\t    return ring\n   317\t\n   318\t\n   319\tdef _build_frame_patch(frame_color: int, payload: np.ndarray, side: str) -> np.ndarray:\n   320\t    ph, pw = map(int, payload.shape)\n","exit_code":0,"status":"completed"}}
