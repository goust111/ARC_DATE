e[(2 * r + c + offset) % k]\n   359\t    elif mode == \"split\":\n   360\t        if rng.random() < 0.5:\n   361\t            split = rng.randint(1, h - 1)\n   362\t            pattern[:split, :] = palette[0]\n   363\t            pattern[split:, :] = palette[1 % k]\n   364\t            if k > 2 and w > 1:\n   365\t                pattern[:, -1] = palette[2]\n   366\t        else:\n   367\t            split = rng.randint(1, w - 1)\n   368\t            pattern[:, :split] = palette[0]\n   369\t            pattern[:, split:] = palette[1 % k]\n   370\t            if k > 2 and h > 1:\n   371\t                pattern[-1, :] = palette[2]\n   372\t    else:\n   373\t        for r in range(h):\n   374\t            for c in range(w):\n   375\t                pattern[r, c] = rng.choice(palette)\n   376\t\n   377\t    if rng.random() < 0.5:\n   378\t        pattern = np.rot90(pattern, rng.randrange(4))\n   379\t        if pattern.shape != (h, w):\n   380\t            pattern = np.rot90(pattern)\n   381\t    if rng.random() < 0.5:\n   382\t        pattern = np.fliplr(pattern)\n   383\t    if rng.random() < 0.5:\n   384\t        pattern = np.flipud(pattern)\n   385\t    return _ensure_multicolor(pattern, palette, rng)\n   386\t\n   387\t\n   388\tdef _self_avoiding_walk(length: int, rng: random.Random) -> list[str]:\n   389\t    for _ in range(200):\n   390\t        pos = (0, 0)\n   391\t        visited = {pos}\n   392\t        sides: list[str] = []\n   393\t        ok = True\n   394\t        for _step in range(length):\n   395\t            options: list[tuple[str, tuple[int, int]]] = []\n   396\t            for side in rng.sample(list(SIDES), len(SIDES)):\n   397\t                dr, dc = SIDE_STEPS[side]\n   398\t                nxt = (pos[0] + dr, pos[1] + dc)\n   399\t                if nxt not in visited:\n   400\t                    options.append((side, nxt))\n   401\t            if not options:\n   402\t                ok = False\n   403\t                break\n   404\t   