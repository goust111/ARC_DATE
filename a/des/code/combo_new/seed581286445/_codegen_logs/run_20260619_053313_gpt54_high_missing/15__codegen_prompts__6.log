{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):\n        b = int(b)\n        f = int(f)\n        if b == bg:\n            continue\n        mapping[b] = f\n\n    return mapping, pal_mask\n\n\ndef _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:\n    \"\"\"\n    Find background regions (excluding the palette area) that do NOT touch the grid boundary,\n    and fill each region based on the most common adjacent border color (mapped via palette).\n    \"\"\"\n    h, w = out.shape\n    bg_mask = (out == bg) & (~pal_mask)\n    comps = components_mask(bg_mask, connectivity=4)\n    for pts in comps:\n        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/ad173014.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/ad173014.py\"","aggregated_output":"import math\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, is_contiguous\nimport random\n\n\nRED = 2\nBLUE = 1\n\n\ndef _extract_frames(g: np.ndarray, bg: int) -> tuple[list[dict], list[np.ndarray]]:\n    red_components = components_mask(g == RED, connectivity=4)\n    assert len(red_components) >= 3\n\n    frames = []\n    for coords in red_components:\n        r0, c0, r1, c1 = bbox_coords(coords)\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert h == w and h >= 3\n\n        patch = g[r0 : r1 + 1, c0 : c1 + 1]\n        border = np.zeros((h, w), dtype=bool)\n        border[0, :] = True\n        border[-1, :] = True\n        border[:, 0] = True\n        border[:, -1] = True\n\n        assert int(border.sum()) == int(coords.shape[0])\n        assert np.all(patch[border] == RED)\n        assert np.all(patch[~border] != RED)\n\n        interior = patch[1:-1, 1:-1]\n        interior_colors = set(map(int, np.unique(interior))) - {int(bg)}\n        assert len(interior_colors) == 1\n        color = interior_colors.pop()\n        mask = interior == color\n        assert mask.any()\n\n        frames.append(\n            {\n                \"bbox\": (r0, c0, r1, c1),\n                \"center\": ((r0 + r1) / 2, (c0 + c1) / 2),\n                \"color\": color,\n                \"mask\": mask,\n            }\n        )\n\n    return frames, red_components\n\n\ndef _blue_cycle_edges(g: np.ndarray, red_components: list[np.ndarray]) -> set[tuple[int, int]]:\n    red_id = {}\n    for i, coords in enumerate(red_components):\n        for r, c in coords:\n            red_id[(int(r), int(c))] = i\n\n    edges = set()\n    for coords in components_mask(g == BLUE, connectivity=4):\n        touched = set()\n        for r, c in coords:\n            rr = int(r)\n            cc = int(c)\n            for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):\n                frame_id = red_id.get((nr, nc))\n                if frame_id is not None:\n                    touched.add(frame_id)\n        assert len(touched) == 2\n        a, b = touched\n        edges.add(tuple(sorted((a, b))))\n\n    n = len(red_components)\n    assert len(edges) == n\n    for i in range(n):\n        assert sum(i in edge for edge in edges) == 2\n    return edges\n\n\ndef _clockwise_order(frames: list[dict], edges: set[tuple[int, int]]) -> list[int]:\n    mean_r = sum(frame[\"center\"][0] for frame in frames) / len(frames)\n    mean_c = sum(frame[\"center\"][1] for frame in frames) / len(frames)\n    angles = [\n        math.atan2(frame[\"center\"][0] - mean_r, frame[\"center\"][1] - mean_c)\n        for frame in frames\n    ]\n    assert len({round(angle, 12) for angle in angles}) == len(angles)\n\n    order = sorted(range(len(frames)), key=lambda i: angles[i])\n    for a, b in zip(order, order[1:] + order[:1]):\n        assert tuple(sorted((a, b))) in edges\n    return order\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor each framed interior mask with the color from the next red frame clockwise around the blue connector cycle.\n\n    Input structure\n    - The grid contains hollow red square frames connected pairwise by blue line components.\n    - The blue components connect the frames into one cycle, with every frame touching exactly two blue components.\n    - Each frame interior contains background plus exactly one non-background color mask.\n\n    Rule\n    - Sort the red frames clockwise by their centers around the cycle.\n    - Keep each frame's interior mask shape in place, but recolor it with the interior color from the next clockwise frame.\n    - Leave the red frames, blue connectors, background, and interior background holes unchanged.\n\n    Key insight\n    - The colored masks do not move; the blue cycle gives the order in which their colors rotate.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    frames, red_components = _extract_frames(g, bg)\n    edges = _blue_cycle_edges(g, red_components)\n    order = _clockwise_order(frames, edges)\n\n    out = g.copy()\n    for k, frame_id in enumerate(order):\n        next_id = order[(k + 1) % len(order)]\n        r0, c0, r1, c1 = frames[frame_id][\"bbox\"]\n        interior = out[r0 + 1 : r1, c0 + 1 : c1]\n        interior[frames[frame_id][\"mask\"]] = frames[next_id][\"color\"]\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Palette constants.\nBG = 0\nCONNECTOR_BLUE = 1\nFRAME_RED = 2\nINTERIOR_COLORS = [3, 4, 5, 6, 7, 8, 9]\n\n# Canvas and frame bounds.\nFRAME_COUNT_RANGE = (3, 5)\nFRAME_SIZE_CHOICES = [5, 7]\nSMALL_FRAME_GRID_H_RANGE = (20, 27)\nSMALL_FRAME_GRID_W_RANGE = (21, 27)\nLARGE_FRAME_GRID_H_RANGE = (22, 27)\nLARGE_FRAME_GRID_W_RANGE = (23, 27)\nFRAME_GAP = 1\n\n# Interior mask density.\nMIN_INTERIOR_FILL = 0.30\nMAX_INTERIOR_FILL = 0.56\nMIN_INTERIOR_CELLS = 3\n\n# Angular placement.\nANGLE_PERTURB_RANGE = (-0.3, 0.3)\nMIN_RADIUS_PAD = 1\nMAX_RADIUS_PAD = 1\nANGLE_EPS = 1e-6\n\n# Connector constraints and retry budgets.\nMAX_TWO_TURN_TRIES = 20\nCONNECTOR_LENGTH_RANGE = (2, 24)\nGENERATION_ATTEMPTS = 300\n\nNEIGHBORS_8 = [\n    (dr, dc)\n    for dr in range(-1, 2)\n    for dc in range(-1, 2)\n    if not (dr == 0 and dc == 0)\n]\n\n\ndef _gen_mask(interior_size, color):\n    \"\"\"Generate an 8-connected mask for frame interior with fill 30-56%.\"\"\"\n    n = interior_size\n    total = n * n\n    min_fill = max(MIN_INTERIOR_CELLS, int(math.ceil(MIN_INTERIOR_FILL * total)))\n    max_fill = int(math.floor(MAX_INTERIOR_FILL * total))\n    target = random.randint(min_fill, max_fill)\n\n    mask = np.zeros((n, n), dtype=int)\n    start = (n // 2, n // 2)\n    mask[start] = color\n    filled = [start]\n    frontier = set()\n    _add_mask_frontier(frontier, mask, start)\n\n    while len(filled) < target and frontier:\n        cell = random.choice(list(frontier))\n        frontier.discard(cell)\n        mask[cell] = color\n        filled.append(cell)\n        _add_mask_frontier(frontier, mask, cell)\n\n    if len(filled) < min_fill:\n        return None\n    return mask\n\n\ndef _add_mask_frontier(frontier, mask, cell):\n    n = mask.shape[0]\n    for dr, dc in NEIGHBORS_8:\n        nr, nc = cell[0] + dr, cell[1] + dc\n        if 0 <= nr < n and 0 <= nc < n and mask[nr, nc] == 0:\n            frontier.add((nr, nc))\n\n\ndef _axis_path(start, end):\n    \"\"\"Return an inclusive straight segment between row- or column-aligned cells.\"\"\"\n    sr, sc = start\n    er, ec = end\n    if sr == er:\n        step = 1 if ec > sc else -1\n        return [(sr, c) for c in range(sc, ec + step, step)]\n    step = 1 if er > sr else -1\n    return [(r, sc) for r in range(sr, er + step, step)]\n\n\ndef _one_turn_path(start, corner, end):\n    return _axis_path(start, corner) + _axis_path(corner, end)[1:]\n\n\ndef _two_turn_vhv_path(start, mid_r, end):\n    _, sc = start\n    _, ec = end\n    corner1 = (mid_r, sc)\n    corner2 = (mid_r, ec)\n    return (\n        _axis_path(start, corner1)\n        + _axis_path(corner1, corner2)[1:]\n        + _axis_path(corner2, end)[1:]\n    )\n\n\ndef _two_turn_hvh_path(start, mid_c, end):\n    sr, _ = start\n    er, _ = end\n    corner1 = (sr, mid_c)\n    corner2 = (er, mid_c)\n    return (\n        _axis_path(start, corner1)\n        + _axis_path(corner1, corner2)[1:]\n        + _axis_path(corner2, end)[1:]\n    )\n\n\ndef _path_is_free(path, occupied):\n    return all(p not in occupied for p in path)\n\n\ndef _find_path(start, end, occupied):\n    \"\"\"Find an L-shaped path (0-2 turns) from start to end avoiding occupied cells.\"\"\"\n    sr, sc = start\n    er, ec = end\n\n    if sr == er or sc == ec:\n        path = _axis_path(start, end)\n        if _path_is_free(path, occupied):\n            return path\n\n    corners = [(sr, ec), (er, sc)]\n    random.shuffle(corners)\n    for corner in corners:\n        path = _one_turn_path(start, corner, end)\n        if _path_is_free(path, occupied):\n            return path\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/2c181942.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/2c181942.py\"","aggregated_output":"from __future__ import annotations\nimport random\nimport numpy as np\nfrom arc_utils import STRUCT8, bbox_coords, get_bg, label_mask, paste, random_free_location\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Attach monochrome sprites to the matching sides of a central hollow square.\n\n    Input structure:\n    - bg = background. A hollow NxN square (hub) with bg corners/interior and four differently-colored edges (top, bottom, left, right).\n    - 2-4 monochrome sprites scattered on the grid, each matching one hub edge color.\n\n    Rule:\n    - For each hub edge color, find the matching sprite outside the hub.\n    - Rotate the sprite (0/90/180/270°) so its contact edge has exactly N-2 contiguous cells aligned with the hub side, and the rotated sprite is mirror-symmetric along the contact-edge axis (UD for left/right, LR for top/bottom).\n    - Translate it to adjoin that hub side. \n    - Clear everything else to bg; output is hub + attached sprites only.\n\n    Key insight: Each edge color uniquely pairs a sprite to a side; symmetry along the contact-edge axis disambiguates the correct rotation.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def _find_hub():\n        best = None  # (score, (r,c,n), (top,bot,left,right))\n        for n in range(3, 7):\n            for r in range(0, int(H - n + 1)):\n                for c in range(0, int(W - n + 1)):\n                    # corners must be bg\n                    if (\n                        int(g[int(r), int(c)]) != int(bg)\n                        or int(g[int(r), int(c + n - 1)]) != int(bg)\n                        or int(g[int(r + n - 1), int(c)]) != int(bg)\n                        or int(g[int(r + n - 1), int(c + n - 1)]) != int(bg)\n                    ):\n                        continue\n                    inner = g[int(r + 1) : int(r + n - 1), int(c + 1) : int(c + n - 1)]\n                    if not bool((inner == int(bg)).all()):\n                        continue\n\n                    top = g[int(r), int(c + 1) : int(c + n - 1)]\n                    bot = g[int(r + n - 1), int(c + 1) : int(c + n - 1)]\n                    left = g[int(r + 1) : int(r + n - 1), int(c)]\n                    right = g[int(r + 1) : int(r + n - 1), int(c + n - 1)]\n\n                    if bool((top == int(bg)).any()) or bool((bot == int(bg)).any()) or bool((left == int(bg)).any()) or bool((right == int(bg)).any()):\n                        continue\n                    if (\n                        len(set(map(int, top))) != 1\n                        or len(set(map(int, bot))) != 1\n                        or len(set(map(int, left))) != 1\n                        or len(set(map(int, right))) != 1\n                    ):\n                        continue\n\n                    cr = float(r + (n - 1) / 2)\n                    cc = float(c + (n - 1) / 2)\n                    score = abs(float(cr - (H - 1) / 2)) + abs(float(cc - (W - 1) / 2))\n                    cand = (\n                        float(score),\n                        (int(r), int(c), int(n)),\n                        (int(top[0]), int(bot[0]), int(left[0]), int(right[0])),\n                    )\n                    if best is None or float(cand[0]) < float(best[0]):\n                        best = cand\n        return best\n\n    hub = _find_hub()\n    assert not (hub is None)\n\n    _score, (r, c, n), (top_col, bot_col, left_col, right_col) = hub\n    hub_mask = np.zeros((H, W), dtype=bool)\n    hub_mask[int(r) : int(r + n), int(c) : int(c + n)] = True\n\n    out = np.full_like(g, int(bg))\n    out[int(r) : int(r + n), int(c) : int(c + n)] = g[int(r) : int(r + n), int(c) : int(c + n)]\n\n    target = int(n - 2)  # length of the hub edge segment (excluding corners)\n\n    def _crop_to_mask(arr: np.ndarray, mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:\n        pts = np.argwhere(mask)\n        r0, c0, r1, c1 = bbox_coords(pts)\n        return arr[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1], mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]\n\n    def _edge_segment(mask: np.ndarray, side: str):\n        pts = np.argwhere(mask)\n        if pts.size == 0:\n            return None\n        if side == \"top\":\n            rr = int(pts[:, 0].min())\n            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n            return (\"h\", int(rr), cols)\n        if side == \"bot\":\n            rr = int(pts[:, 0].max())\n            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n            return (\"h\", int(rr), cols)\n        if side == \"left\":\n            cc = int(pts[:, 1].min())\n            rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n            return (\"v\", int(cc), rows)\n        if side == \"right\":\n            cc = int(pts[:, 1].max())\n            rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n            return (\"v\", int(cc), rows)\n        return None\n\n    def _is_contig(seq: list[int]) -> bool:\n        return bool(seq) and all(int(seq[i]) + 1 == int(seq[i + 1]) for i in range(len(seq) - 1))\n\n    # desired attachment geometry: adjacent (touching) the hub side segment\n    segs = {\n        \"top\": (int(top_col), (\"bot\", int(r - 1), list(range(int(c + 1), int(c + n - 1))))),\n        \"bot\": (int(bot_col), (\"top\", int(r + n), list(range(int(c + 1), int(c + n - 1))))),\n        \"left\": (int(left_col), (\"right\", int(c - 1), list(range(int(r + 1), int(r + n - 1))))),\n        \"right\": (int(right_col), (\"left\", int(c + n), list(range(int(r + 1), int(r + n - 1))))),\n    }\n\n    for _side, (col, (need_edge, fixed, span)) in segs.items():\n        col = int(col)\n        m = (g == int(col)) & (~hub_mask)\n        if not bool(m.any()):\n            continue\n\n        # Sprites can be only diagonally connected (e.g. V-shapes), so extract with 8-connectivity.\n        labc, nc = label_mask(m, connectivity=8)\n        best_id = None\n        best_sz = -1\n        for cid in range(1, int(nc) + 1):\n            sz = int((labc == int(cid)).sum())\n            if sz > best_sz:\n                best_sz = sz\n                best_id = int(cid)\n        if best_id is None or best_sz <= 0:\n            continue\n\n        spr_mask = labc == int(best_id)\n        spr_arr = g.copy()\n        spr_arr[~spr_mask] = int(bg)\n        spr_arr, spr_mask = _crop_to_mask(spr_arr, spr_mask)\n\n        found = None  # (a, msk, dr, dc)\n        for krot in range(4):\n            a = np.rot90(spr_arr, int(krot))\n            msk = np.rot90(spr_mask, int(krot))\n            a, msk = _crop_to_mask(a, msk)\n\n            # Attached sprite must be mirror-symmetric along the contact edge axis\n            if need_edge in (\"left\", \"right\"):\n                if not bool(np.array_equal(msk, np.flipud(msk))):\n                    continue\n            else:\n                if not bool(np.array_equal(msk, np.fliplr(msk))):\n                    continue\n\n            seg = _edge_segment(msk, need_edge)\n            if seg is None:\n                continue\n\n            if need_edge in (\"left\", \"right\"):\n                _typ, edge_c, rows = seg\n                if len(rows) != int(target) or not _is_contig(rows):\n                    continue\n                dr = int(span[0] - rows[0])\n                dc = int(fixed - edge_c)\n            else:\n                _typ, edge_r, cols = seg\n                if len(cols) != int(target) or not _is_contig(cols):\n                    continue\n                dr = int(fixed - edge_r)\n                dc = int(span[0] - cols[0])\n\n            placed = {(int(rr + dr), int(cc2 + dc)) for rr, cc2 in np.argwhere(msk)}\n            if any(not (0 <= R < H and 0 <= C < W) for R, C in placed):\n                continue\n\n            # ensure no conflicts with already-drawn hub (or previously placed sprites)\n            ok = True\n            for R, C in placed:\n                val = int(a[int(R - dr), int(C - dc)])\n                if val == int(bg):\n                    continue\n                if int(out[int(R), int(C)]) != int(bg) and int(out[int(R), int(C)]) != val:\n                    ok = False\n                    break\n            if not ok:\n                continue\n\n            found = (a, msk, int(dr), int(dc))\n            break\n\n        if found is None:\n            continue\n\n        a, msk, dr, dc = found\n        paste(out, a, int(dr), int(dc), mask=msk, overwrite=True, clip=True)\n\n    return out\n\n\n# ---------------------------------------------------------------------------\n# Generator\n# ---------------------------------------------------------------------------\n\nfrom scipy.ndimage import label as _label\n\ndef _make_sprite_mask(edge_len: int, side: str, rng: random.Random) -> np.ndarray | None:\n    \"\"\"\n    Constructively build a sprite mask in the attached orientation for `side`.\n    The mask is bool, 8-connected, has the correct symmetry and contact-edge length,\n    and exactly 1 rotation (out of 4) is a valid attachment for any hub side.\n\n    Strategy: build in canonical \"left-attach\" frame (flipud symmetric, contact on right col),\n    then rotate to the target side.\n    \"\"\"\n    # Build in \"left-attach\" frame: h rows, w cols.\n    # Right column = contact edge with exactly `edge_len` contiguous filled cells.\n    # flipud symmetric (rows mirror top-to-bottom).\n    # h > w ensures not square, breaking 90-degree rotation ambiguity.\n    # Also ensure NOT fliplr symmetric to prevent the complementary side matching.\n    e = edge_len  # = 2 for N=4\n    h = rng.choice([3, 4])  # height: 3 or 4 (must be > e to break symmetry)\n    w = rng.randint(2, 4)   # width: 2-4 (cols including the contact column)\n\n    half_h = (h + 1) // 2  # rows to decide (rest mirrored vertically)\n\n    for _attempt in range(100):\n        grid = np.zeros((h, w), dtype=bool)\n\n        # Contact edge: rightmost column, middle `e` rows filled, rest empty.\n        # For flipud symmetry with h=3 or h=4 and e=2:\n        #   h=3: rows 0,2 empty; row 1 filled -> only 1 contiguous. No good.\n        #   Actually for h=4, e=2: rows 1,2 filled (symmetric pair). Contact = [F,T,T,F]\n        #   For h=3, e=2: rows 0,2 mirrored. If row 0=T, row 2=T, row 1=T -> 3 contig.\n        #                  If row 0=F, row 2=F, row 1=T -> 1 contig. Not enough.\n        #                  Need to allow row0=T,row1=T,row2=T -> 3 != e.\n        # So for h=3, e=2 the rightmost col can't have exactly 2 contiguous cells\n        # with flipud symmetry. Let me think differently.\n\n","exit_code":0,"status":"completed"}}
