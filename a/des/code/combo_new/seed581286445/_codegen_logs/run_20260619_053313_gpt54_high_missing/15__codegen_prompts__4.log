      dc = int(ac - mp[1])\n 113:         else:\n 114:             dr = int(ar - mp[0])\n 115: \n 116:         moves.append((coords, int(dr), int(dc)))\n 117: \n 118:     out = g.copy()\n 119: \n 120:     # --- STEP 5) Apply all moves. ---\n 121:     # Clear moved components first (prevents collisions with their original locations).\n 122:     for coords, _dr, _dc in moves:\n 123:         out[coords[:, 0], coords[:, 1]] = int(bg)\n 124: \n 125:     # Paste moved components:\n 126:     # - clip out-of-bounds pixels\n\n-- around line 582 --\n 582: def generate_input() -> np.ndarray:\n 583:     for _ in range(_GEN_RETRY_LIMIT):\n 584:         grid = _gen_attempt()\n 585:         if grid is not None:\n 586:             return grid\n 587:     raise RuntimeError(\"failed to generate a valid 581f7754 input\")\n\n","exit_code":0,"status":"completed"}}
