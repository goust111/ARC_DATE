{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/37ce87bb.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import Color, find_components, get_bg\nimport random\n\n\ndef _operand_bars(g: np.ndarray, bg: int) -> list[dict[str, int]]:\n    height = g.shape[0]\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert components\n\n    bars: list[dict[str, int]] = []\n    for comp in components:\n        color = int(comp[\"color\"])\n        assert color in (Color.TEAL, Color.RED)\n\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        area = int(comp[\"area\"])\n        assert c0 == c1\n        assert r1 == height - 1\n        assert area == r1 - r0 + 1\n        assert bool(np.all(g[r0 : r1 + 1, c0] == color))\n\n        bars.append({\"color\": color, \"col\": c0, \"height\": area})\n\n    bars.sort(key=lambda bar: bar[\"col\"])\n    assert len({bar[\"col\"] for bar in bars}) == len(bars)\n    assert any(bar[\"color\"] == Color.TEAL for bar in bars)\n    return bars\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Compute a grey result bar by adding teal bar heights and subtracting red bar heights.\n\n    Input structure\n    - The grid has a dominant background and several bottom-aligned one-cell-wide vertical bars.\n    - Teal bars are positive operands; red bars are negative operands.\n    - The penultimate column is an empty result slot.\n\n    Rule\n    - Keep every input bar unchanged.\n    - Compute result height = total teal bar height - total red bar height.\n    - Paint that many bottom cells of the penultimate column grey.\n\n    Key insight\n    - The bars encode arithmetic by height, with color providing the sign.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height, width = g.shape\n    bg = get_bg(g)\n    bars = _operand_bars(g, bg)\n\n    result_height = 0\n    for bar in bars:\n        if bar[\"color\"] == Color.TEAL:\n            result_height += bar[\"height\"]\n        else:\n            assert bar[\"color\"] == Color.RED\n            result_height -= bar[\"height\"]\n\n    assert 0 < result_height <= height\n    assert width >= 2\n    result_col = width - 2\n    assert bool(np.all(g[:, result_col] == bg))\n\n    out = g.copy()\n    out[height - result_height : height, result_col] = Color.GREY\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas, object, and result-size bounds.\nBAR_COUNT_RANGE = (2, 6)\nGRID_HEIGHT_RANGE = (6, 12)\nTOP_MARGIN_ROWS, RESULT_HEIGHT_MIN = 1, 1\n# Column layout.\nBAR_COL_START, BAR_COL_STRIDE, WIDTH_EXTRA_COLS, RESULT_COL_FROM_RIGHT = 1, 2, 3, 2\n# Color palette and retry budget.\nBG_COLOR, RESULT_COLOR, POSITIVE_COLOR, NEGATIVE_COLOR = Color.ORANGE, Color.GREY, Color.TEAL, Color.RED\nGEN_RETRY_LIMIT = 300\n\n\ndef _bounded_composition(total: int, parts: int, *, upper: int) -> list[int] | None:\n    \"\"\"Sample positive bounded parts summing to total, or None if impossible.\"\"\"\n    if parts == 0:\n        return [] if total == 0 else None\n    if not (parts <= total <= parts * upper):\n        return None\n    values = []\n    remaining = total\n    for i in range(parts):\n        slots = parts - i - 1\n        lo = max(1, remaining - slots * upper)\n        hi = min(upper, remaining - slots)\n        value = random.randint(lo, hi)\n        values.append(value)\n        remaining -= value\n    random.shuffle(values)\n    return values\n\n\ndef _sample_bar_specs(n: int, max_bar_height: int) -> tuple[list[tuple[int, int]], int] | None:\n    \"\"\"Sample shuffled operand specs and the matching grey result height.\"\"\"\n    result_height = random.randint(RESULT_HEIGHT_MIN, max_bar_height)\n    feasible_teal_counts = []\n    for teal_count in range(1, n + 1):\n        red_count = n - teal_count\n        red_sum_lo = max(red_count, teal_count - result_height)\n        red_sum_hi = min(red_count * max_bar_height, teal_count * max_bar_height - result_height)\n        if red_sum_lo <= red_sum_hi:\n            feasible_teal_counts.append((teal_count, red_sum_lo, red_sum_hi))\n    if not feasible_teal_counts:\n        return None\n\n    teal_count, red_sum_lo, red_sum_hi = random.choice(feasible_teal_counts)\n    red_count = n - teal_count\n    red_sum = random.randint(red_sum_lo, red_sum_hi)\n    teal_sum = red_sum + result_height\n    teal_heights = _bounded_composition(teal_sum, teal_count, upper=max_bar_height)\n    red_heights = _bounded_composition(red_sum, red_count, upper=max_bar_height)\n    if teal_heights is None or red_heights is None:\n        return None\n\n    bar_specs = [(POSITIVE_COLOR, h) for h in teal_heights] + [(NEGATIVE_COLOR, h) for h in red_heights]\n    random.shuffle(bar_specs)\n    return bar_specs, result_height\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = random.randint(*BAR_COUNT_RANGE)\n    height = random.randint(*GRID_HEIGHT_RANGE)\n    max_bar_height = height - TOP_MARGIN_ROWS\n    width = BAR_COL_STRIDE * n + WIDTH_EXTRA_COLS\n    if (sampled := _sample_bar_specs(n, max_bar_height)) is None:\n        return None\n    bar_specs, result_height = sampled\n    out = np.full((height, width), BG_COLOR, dtype=int)\n    for i, (color, bar_height) in enumerate(bar_specs):\n        col = BAR_COL_START + BAR_COL_STRIDE * i\n        out[height - bar_height : height, col] = color\n    out[height - result_height : height, width - RESULT_COL_FROM_RIGHT] = RESULT_COLOR\n\n    inp = out.copy()\n    inp[:, width - RESULT_COL_FROM_RIGHT] = BG_COLOR\n    if not np.array_equal(main(inp), out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/df9fd884.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/df9fd884.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_w, colors_present, crop_bbox, find_components, get_bg, is_contiguous, paste\nimport itertools\nimport random\n\n\ndef _cells(component):\n    return set(map(tuple, component[\"coords\"]))\n\n\ndef _is_top_bracket(component) -> bool:\n    r0, c0, r1, c1 = component[\"bbox\"]\n    width = c1 - c0 + 1\n    if r0 != 0 or r1 - r0 + 1 != 2 or width < 3:\n        return False\n    expected = {(r0, c) for c in range(c0, c1 + 1)}\n    expected |= {(r1, c0), (r1, c1)}\n    return _cells(component) == expected\n\n\ndef _is_bottom_bracket(component, height: int) -> bool:\n    r0, c0, r1, c1 = component[\"bbox\"]\n    width = c1 - c0 + 1\n    if r1 != height - 1 or r1 - r0 + 1 != 2 or width < 3:\n        return False\n    expected = {(r1, c) for c in range(c0, c1 + 1)}\n    expected |= {(r0, c0), (r0, c1)}\n    return _cells(component) == expected\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Move the colored object from the lower bracket lane to the upper bracket lane and drop it to the bottom edge.\n\n    Input structure\n    - The background is the dominant color.\n    - One frame color forms exactly two 4-connected bracket objects: a top-edge bracket open downward and a bottom-edge bracket open upward.\n    - One other 4-connected foreground object sits in the lower bracket's interior column span.\n\n    Rule\n    - Remove the movable object from its original cells.\n    - Keep its shape and color unchanged.\n    - Paste it with its bbox columns aligned to the top bracket's interior columns and with its bbox bottom aligned to the grid bottom.\n\n    Key insight\n    - The lower bracket identifies the object's source lane; the upper bracket provides the target lane, and the final vertical placement is bottom-aligned.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height, width = g.shape\n    bg = get_bg(g)\n\n    components_by_color = {}\n    bracket_candidates = []\n    for color in colors_present(g, exclude={bg}):\n        components = find_components(\n            g,\n            bg=bg,\n            colors=[color],\n            connectivity=4,\n            monochromatic=True,\n        )\n        components_by_color[color] = components\n        top = [component for component in components if _is_top_bracket(component)]\n        bottom = [\n            component for component in components\n            if _is_bottom_bracket(component, height)\n        ]\n        if len(components) == 2 and len(top) == 1 and len(bottom) == 1:\n            bracket_candidates.append((color, top[0], bottom[0]))\n\n    assert len(bracket_candidates) == 1\n    frame_color, top_bracket, bottom_bracket = bracket_candidates[0]\n\n    movers = [\n        component\n        for color, components in components_by_color.items()\n        if color != frame_color\n        for component in components\n    ]\n    assert len(movers) == 1\n    mover = movers[0]\n\n    _, mc0, _, mc1 = mover[\"bbox\"]\n    _br0, bc0, _br1, bc1 = bottom_bracket[\"bbox\"]\n    _tr0, tc0, _tr1, tc1 = top_bracket[\"bbox\"]\n    assert (mc0, mc1) == (bc0 + 1, bc1 - 1)\n    assert bbox_w(mover[\"bbox\"]) == tc1 - tc0 - 1\n\n    patch = crop_bbox(g, mover[\"bbox\"])\n    dest_r = height - patch.shape[0]\n    dest_c = tc0 + 1\n    assert dest_r >= 0\n    assert dest_c >= 0 and dest_c + patch.shape[1] <= width\n\n    out = g.copy()\n    mover_coords = mover[\"coords\"]\n    out[mover_coords[:, 0], mover_coords[:, 1]] = bg\n\n    colored_patch = patch != bg\n    target = out[dest_r:dest_r + patch.shape[0], dest_c:dest_c + patch.shape[1]]\n    assert np.all(target[colored_patch] == bg)\n\n    paste(out, patch, dest_r, dest_c, transparent=bg)\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed task colors.\nBG_COLOR, BRACKET_COLOR = 7, 4\nMOVER_COLORS = [0, 1, 2, 3, 5, 6, 8, 9]\n# Canvas, bracket, and mover-size bounds.\nGRID_SIZE_RANGE = (8, 9)\nBRACKET_WIDTH_RANGE = (3, 4)\nMOVER_HEIGHT_RANGE = (1, 3)\nMOVER_MAX_CELLS = 4\nMOVER_MIN_DENSITY_NUM = 2\nMOVER_MIN_DENSITY_DEN = 3\n# Layout choices and retry budget.\nTOP_LEFT_OPTIONS = [True, False]\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _gen_half_starts(grid_width, bracket_width, left_side):\n    if left_side:\n        return list(range(0, grid_width // 2 - bracket_width + 1))\n    return list(range((grid_width + 1) // 2, grid_width - bracket_width + 1))\n\ndef _gen_bracket_columns(grid_width, bracket_width):\n    \"\"\"Choose non-overlapping top/bottom bracket starts on opposite halves.\"\"\"\n    top_left = random.choice(TOP_LEFT_OPTIONS)\n    top_starts = _gen_half_starts(grid_width, bracket_width, top_left)\n    bottom_starts = _gen_half_starts(grid_width, bracket_width, not top_left)\n    if not top_starts or not bottom_starts:\n        return None\n    return random.choice(top_starts), random.choice(bottom_starts)\n\ndef _gen_add_bracket(grid, c0, width, top_edge):\n    edge_row, arm_row = (0, 1) if top_edge else (-1, -2)\n    grid[edge_row, c0:c0 + width] = BRACKET_COLOR\n    grid[arm_row, c0] = BRACKET_COLOR\n    grid[arm_row, c0 + width - 1] = BRACKET_COLOR\n\ndef _gen_sprite_masks(height, width):\n    area = height * width\n    min_cells = (MOVER_MIN_DENSITY_NUM * area + MOVER_MIN_DENSITY_DEN - 1) // MOVER_MIN_DENSITY_DEN\n    max_cells = min(MOVER_MAX_CELLS, area)\n    masks = []\n    for cell_count in range(min_cells, max_cells + 1):\n        for cells in itertools.combinations(range(area), cell_count):\n            mask = np.zeros((height, width), dtype=bool)\n            mask[np.unravel_index(cells, (height, width))] = True\n            if not mask.any(axis=0).all() or not mask.any(axis=1).all():\n                continue\n            if is_contiguous(mask.astype(int), background=0, connectivity=4):\n                masks.append(mask)\n    return masks\n\ndef _gen_mover_sprite(height, width, color, bg):\n    masks = _gen_sprite_masks(height, width)\n    if not masks:\n        return None\n    mask = random.choice(masks)\n    sprite = np.full((height, width), bg, dtype=int)\n    sprite[mask] = color\n    return sprite\n\ndef _gen_paste_if_clear(grid, sprite, row, col, sprite_mask):\n    \"\"\"Paste sprite only when every colored sprite cell lands on background.\"\"\"\n    target = grid[row:row + sprite.shape[0], col:col + sprite.shape[1]]\n    if not np.all(target[sprite_mask] == BG_COLOR):\n        return False\n    paste(grid, sprite, row, col, transparent=BG_COLOR)\n    return True\n\ndef _gen_attempt():\n    height = random.randint(*GRID_SIZE_RANGE)\n    grid_width = random.randint(*GRID_SIZE_RANGE)\n    bracket_width = random.randint(*BRACKET_WIDTH_RANGE)\n    interior_width = bracket_width - 2\n\n    bracket_columns = _gen_bracket_columns(grid_width, bracket_width)\n    if bracket_columns is None:\n        return None\n    top_c0, bottom_c0 = bracket_columns\n\n    mover_height = random.randint(*MOVER_HEIGHT_RANGE)\n    mover_color = random.choice(MOVER_COLORS)\n    sprite = _gen_mover_sprite(mover_height, interior_width, mover_color, BG_COLOR)\n    if sprite is None:\n        return None\n\n    out = np.full((height, grid_width), BG_COLOR, dtype=int)\n    _gen_add_bracket(out, top_c0, bracket_width, top_edge=True)\n    _gen_add_bracket(out, bottom_c0, bracket_width, top_edge=False)\n\n    dest_r = height - mover_height\n    dest_c = top_c0 + 1\n    sprite_mask = sprite != BG_COLOR\n    if not _gen_paste_if_clear(out, sprite, dest_r, dest_c, sprite_mask):\n        return None\n\n    inp = out.copy()\n    target = inp[dest_r:dest_r + mover_height, dest_c:dest_c + interior_width]\n    target[sprite_mask] = BG_COLOR\n\n    source_c = bottom_c0 + 1\n    max_source_r = height - 2 - mover_height\n    if max_source_r < 1:\n        return None\n    source_r = random.randint(1, max_source_r)\n    if not _gen_paste_if_clear(inp, sprite, source_r, source_c, sprite_mask):\n        return None\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\ndef generate_input():\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate df9fd884 input\")\n","exit_code":0,"status":"completed"}}
