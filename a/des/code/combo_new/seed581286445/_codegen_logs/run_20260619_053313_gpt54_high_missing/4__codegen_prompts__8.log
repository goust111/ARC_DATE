{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/221dfab4.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import get_bg, label_mask\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Propagate a repeating striped pattern from a yellow border segment toward the opposite edge, recoloring foreground objects on certain stripes.\n\n    Input structure:\n    - bg = most common color. Foreground blobs of another color scattered in the interior.\n    - A short yellow (4) segment sits on one border edge.\n\n    Rule:\n    - From the yellow segment, march toward the opposite edge in steps of 2 cells, cycling colors Y, Y, G (4, 4, 3). The 1-cell gap between stripes is forced to bg.\n    - Yellow stripes paint only within the segment's span.\n    - Green stripes additionally recolor all non-bg pixels across the entire row/column to green.\n\n    Key insight: Green stripes act as a \"flood\" that recolors existing objects on the full row/column, while yellow stripes are confined to the segment span.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n    out = g.copy()\n\n    Y = 4\n    G = 3\n\n    border = np.zeros((H, W), dtype=bool)\n    border[0, :] = True\n    border[-1, :] = True\n    border[:, 0] = True\n    border[:, -1] = True\n\n    smask = (g == int(Y)) & border\n    if not bool(smask.any()):\n        return out\n\n    lab, n = label_mask(smask, connectivity=4)\n    if int(n) <= 0:\n        return out\n\n    best_id = max(range(1, int(n) + 1), key=lambda cid: int((lab == int(cid)).sum()))\n    pts = np.argwhere(lab == int(best_id))\n\n    rs = pts[:, 0]\n    cs = pts[:, 1]\n    r0, r1 = int(rs.min()), int(rs.max())\n    c0, c1 = int(cs.min()), int(cs.max())\n\n    if r0 == r1:\n        orient = \"h\"\n        start_pos = int(r0)\n        cols = sorted(int(c) for c in cs)\n        span = list(range(int(cols[0]), int(cols[-1]) + 1))\n        dir1 = 1 if start_pos == 0 else -1\n        limit = H\n    elif c0 == c1:\n        orient = \"v\"\n        start_pos = int(c0)\n        rows = sorted(int(r) for r in rs)\n        span = list(range(int(rows[0]), int(rows[-1]) + 1))\n        dir1 = 1 if start_pos == 0 else -1\n        limit = W\n    else:\n        # Unexpected: not a straight edge segment.\n        return out\n\n    cycle = [int(Y), int(Y), int(G)]\n\n    step = 0\n    while True:\n        pos = int(start_pos) + int(dir1) * (2 * int(step))\n        if not (0 <= pos < int(limit)):\n            break\n\n        col = int(cycle[int(step) % 3])\n\n        if orient == \"h\":\n            if col == int(G):\n                out[pos, :] = np.where(out[pos, :] != int(bg), int(G), out[pos, :])\n            for c in span:\n                out[pos, int(c)] = col\n            # Force the 1-cell gap to background within the segment span.\n            gap = int(start_pos) + int(dir1) * (2 * int(step) + 1)\n            if 0 <= gap < H:\n                for c in span:\n                    out[int(gap), int(c)] = int(bg)\n        else:\n            if col == int(G):\n                out[:, pos] = np.where(out[:, pos] != int(bg), int(G), out[:, pos])\n            for r in span:\n                out[int(r), pos] = col\n            gap = int(start_pos) + int(dir1) * (2 * int(step) + 1)\n            if 0 <= gap < W:\n                for r in span:\n                    out[int(r), int(gap)] = int(bg)\n\n        step += 1\n\n    return out\n\n\n# --------------- generator ---------------\nimport random\nfrom arc_utils import random_sprite, random_free_location\n\n\ndef _gen_attempt():\n    rng = random.Random()\n\n    H = rng.randint(25, 30)\n    W = rng.randint(22, 30)\n\n    # Pick bg and fg colors (not yellow=4 or green=3)\n    available = [c for c in range(10) if c not in (3, 4)]\n    bg, fg = rng.sample(available, 2)\n\n    # Pick edge and yellow segment\n    edge = rng.choice(['top', 'bottom', 'left', 'right'])\n    seg_len = rng.randint(3, 8)\n\n    if edge in ('top', 'bottom'):\n        # horizontal segment: columns span, must not touch corners (col 0 or W-1)\n        max_start = W - 1 - seg_len  # last col of span = start + seg_len - 1 <= W-2\n        if max_start < 1:\n            return None\n        seg_start = rng.randint(1, max_start)\n        span = list(range(seg_start, seg_start + seg_len))\n        orient = 'h'\n        edge_row = 0 if edge == 'top' else H - 1\n    else:\n        # vertical segment: rows span, must not touch corners (row 0 or H-1)\n        max_start = H - 1 - seg_len\n        if max_start < 1:\n            return None\n        seg_start = rng.randint(1, max_start)\n        span = list(range(seg_start, seg_start + seg_len))\n        orient = 'v'\n        edge_col = 0 if edge == 'left' else W - 1\n\n    # Start with bg grid\n    grid = np.full((H, W), bg, dtype=int)\n\n    # Place yellow segment on border\n    if orient == 'h':\n        for c in span:\n            grid[edge_row, c] = 4\n    else:\n        for r in span:\n            grid[r, edge_col] = 4\n\n    # Determine which rows/cols are on the trajectory (both stripe and gap positions)\n    # to avoid placing blobs on the edge row/col itself\n    if orient == 'h':\n        forbidden_rows = {edge_row}\n    else:\n        forbidden_cols = {edge_col}\n\n    # Scatter 5-9 amorphous fg blobs in the interior\n    n_blobs = rng.randint(5, 9)\n    canvas = grid.copy()\n\n    for _ in range(n_blobs):\n        # Random blob size: aim for 5-67 pixels, bbox dims 2-15\n        bh = rng.randint(2, 10)\n        bw = rng.randint(2, 10)\n        density = rng.uniform(0.4, 0.85)\n\n        try:\n            sprite = random_sprite(bh, bw, density=density, symmetry=\"not_symmetric\",\n                                   color_palette=[fg], connectivity=4, background=bg)\n        except (AssertionError, RecursionError):\n            continue\n\n        # Trim bg border rows/cols from sprite\n        mask = (sprite != bg)\n        rows_any = np.any(mask, axis=1)\n        cols_any = np.any(mask, axis=0)\n        if not rows_any.any():\n            continue\n        r0, r1 = np.where(rows_any)[0][[0, -1]]\n        c0, c1 = np.where(cols_any)[0][[0, -1]]\n        sprite = sprite[r0:r1+1, c0:c1+1]\n\n        sh, sw = sprite.shape\n        pix = int(np.sum(sprite != bg))\n        if pix < 5 or pix > 67:\n            continue\n\n        # Find placement: border=1 to keep away from grid edges, padding=1 for separation\n        try:\n            pr, pc = random_free_location(canvas, sprite, transparent=bg, border=1, padding=1)\n        except ValueError:\n            continue\n\n        # Check forbidden row/col constraints\n        sprite_mask = (sprite != bg)\n        blob_rows = set(int(pr + dr) for dr in range(sh) if sprite_mask[dr].any())\n        blob_cols = set(int(pc + dc) for dc in range(sw) if sprite_mask[:, dc].any())\n\n        if orient == 'h' and blob_rows & forbidden_rows:\n            continue\n        if orient == 'v' and blob_cols & forbidden_cols:\n            continue\n\n        # Paste blob\n        for dr in range(sh):\n            for dc in range(sw):\n                if sprite[dr, dc] != bg:\n                    canvas[pr + dr, pc + dc] = sprite[dr, dc]\n\n    # Count blobs placed\n    fg_mask = (canvas != bg) & (canvas != 4)\n    lab, n_placed = label_mask(fg_mask, connectivity=4)\n    if n_placed < 5:\n        return None\n\n    # Now canvas is our INPUT grid. Build the expected output via solver.\n    inp = canvas.copy()\n    out = main(inp)\n\n    # Verify bg is most common in input\n    if get_bg(inp) != bg:\n        return None\n\n    # Round-trip check\n    if not np.array_equal(main(inp), out):\n        return None\n\n    return inp#.tolist()\n\n\ndef generate_input():\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/e3721c99.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, is_contiguous, neighbors4, paste\nimport itertools\nimport random\n\n\ndef _hole_count(mask: np.ndarray) -> int:\n    \"\"\"\n    Count holes in a binary mask using 4-connectivity.\n    A hole is a background component that does not touch the mask's bounding box border.\n    \"\"\"\n    h, w = mask.shape\n    bg = ~mask\n    vis = np.zeros((h, w), dtype=bool)\n    holes = 0\n    for r0 in range(h):\n        for c0 in range(w):\n            if not bg[r0, c0] or vis[r0, c0]:\n                continue\n            st = [(r0, c0)]\n            vis[r0, c0] = True\n            touches = False\n            while st:\n                r, c = st.pop()\n                if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n                    touches = True\n                for rr, cc in neighbors4(r, c):\n                    if 0 <= rr < h and 0 <= cc < w and bg[rr, cc] and not vis[rr, cc]:\n                        vis[rr, cc] = True\n                        st.append((rr, cc))\n            if not touches:\n                holes += 1\n    return holes\n\n\ndef _legend_mapping(g: np.ndarray, bg: int, grey: int) -> dict[int, int]:\n    \"\"\"\n    Pick one 'legend' component per non-(bg,grey) color:\n      - component is at least 2x2,\n      - component does not touch the outer grid border (filters dividers).\n    Map hole_count -> legend_color.\n    \"\"\"\n    h, w = g.shape\n    mapping: dict[int, int] = {}\n    colors = [c for c in sorted(set(map(int, np.unique(g)))) if c not in (bg, grey)]\n    for c in colors:\n        comps = components_mask(g == c, connectivity=4)\n        candidates = []\n        for pts in comps:\n            r0, c0, r1, c1 = bbox_coords(pts)\n            if r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1:\n                continue\n            if (r1 - r0 + 1) < 2 or (c1 - c0 + 1) < 2:\n                continue\n            candidates.append((r0, c0, r1, c1))\n        if not candidates:\n            continue\n        assert len(candidates) == 1, f\"color {c} must have exactly one legend component\"\n        r0, c0, r1, c1 = candidates[0]\n        sub = (g[r0 : r1 + 1, c0 : c1 + 1] == c)\n        hc = _hole_count(sub)\n        assert hc not in mapping, f\"legend hole count {hc} must map to exactly one color\"\n        mapping[hc] = c\n    return mapping\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor grey shapes by matching their hole count to a color legend.\n\n    Input structure:\n    - bg = most common color; grey (5) sprites scattered across the grid.\n    - Colored legend shapes (non-bg, non-grey, at least 2×2, not touching the outer border) near grid edge,\n      each with a distinct number of enclosed holes.\n\n    Rule:\n    - Each colored legend shape defines a mapping: hole count → color.\n    - For every grey sprite, count its holes (enclosed bg regions not touching the sprite's bounding-box border).\n    - Recolor the grey sprite to the matching legend color; erase grey distractors with unlisted hole counts.\n\n    Key insight: Shape identity is encoded by topology (number of holes), not geometry or size.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    grey = 5\n\n    legend = _legend_mapping(g, bg, grey)\n    assert legend, \"legend mapping must be non-empty: grid must contain colored legend shapes\"\n\n    out = g.copy()\n    for pts in components_mask(g == grey, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(pts)\n        sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n        for r, c in pts:\n            sub[r - r0, c - c0] = True\n        hc = _hole_count(sub)\n        newc = int(legend[hc]) if hc in legend else bg\n        for r, c in pts:\n            out[r, c] = newc\n\n    return out\n\n# --------------- generator (holes-first organic blob) ---------------\n\nfrom arc_utils import label_mask\nfrom scipy.ndimage import binary_dilation, generate_binary_structure\n\n# -- palette & grid --\nBG = 0\nDIV = 1\nGREY = 5\nGRID_SIZE = 30\nLEGEND_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\n\n# -- legend panel --\nLEGEND_COUNT_RANGE = (2, 4)         # number of legend entries\nMAX_HOLE_COUNT = 6                  # hole values drawn from range(MAX_HOLE_COUNT)\nPANEL_SIZE_RANGE = (5, 8)           # panel thickness (cross-axis)\nFULL_LAYOUT_MAX_SPAN = 28          # max legend line span for full-row/col layouts\nL_LAYOUT_MAX_SPAN = 24            # max legend line span for L-shaped layouts\nL_LAYOUT_EXTRA_PADDING = 3        # max random padding along the L arm\n\n# -- sprites --\nTOTAL_SPRITES_RANGE = (8, 11)       # total sprites (matches + distractors)\nMAX_DISTRACTORS = 7                 # max distractor sprites\nMAX_EXTRA_PER_LEGEND = 2            # max extra match sprites per legend entry\nSPRITE_RETRIES = 30                 # retries per sprite generation attempt\nSPRITE_AREA_0 = (5, 25)              # (min, max) area for 0-hole sprites\nSPRITE_AREA_LOW_MIN = 8              # min area for 1-2 hole sprites (max = 25+10*h)\n# 3+ hole sprites: min = 10+2*h, max = 20+4*h\nCANVAS_SCALE = 1.2                  # sqrt(area) multiplier for canvas size\nCANVAS_MIN = 5                      # minimum canvas dimension\nCANVAS_PAD = 2                      # padding added to scaled sqrt for canvas\nHOLE_SEED_RADIUS_FACTOR = 0.45      # radius = factor * sqrt(area)\nHOLE_SEED_MIN_RADIUS = 2\nHOLE_SEED_MIN_SEP = 2               # minimum Chebyshev distance between hole seeds\nHOLE_SEED_MARGIN = 2                # margin from canvas edge for hole seeds\nSEAL_ITERS = 5                      # max iterations for sealing forbidden cells\nSPRITE_MAX_H = 12                   # max sprite bbox height\nSPRITE_MAX_W = 18                   # max sprite bbox width\nSPRITE_MAX_ASPECT = 2.5             # max aspect ratio (max_dim / min_dim)\n\n# -- generation --\nGEN_RETRIES = 300                   # outer retries for generate_input()\n\n# 8-connectivity structuring element for dilation\n_STRUCT8 = generate_binary_structure(2, 2)\n\n\n# ---------- legend helpers ----------\n\ndef _legend_span(hole_count: int) -> int:\n    \"\"\"Width (or height) of a single legend patch along the arrangement axis.\"\"\"\n    return 3 if hole_count == 0 else 2 * hole_count + 1\n\n\ndef _legend_patch(hole_count: int, color: int, arrangement: str) -> np.ndarray:\n    \"\"\"Build a 3xSpan (horizontal) or Spanx3 (vertical) legend patch.\"\"\"\n    span = _legend_span(hole_count)\n    if arrangement == \"horizontal\":\n        patch = np.full((3, span), int(color), dtype=int)\n        if hole_count:\n            patch[1, 1::2] = BG\n    else:\n        patch = np.full((span, 3), int(color), dtype=int)\n        if hole_count:\n            patch[1::2, 1] = BG\n    return patch\n\n\ndef _line_span(legends: list[tuple[int, int]]) -> int:\n    \"\"\"Total span of legend patches plus 1-cell gaps between them.\"\"\"\n    return sum(_legend_span(h) for h, _ in legends) + len(legends) - 1\n\n\ndef _choose_legends(arrangement: str, max_span: int) -> list[tuple[int, int]]:\n    \"\"\"Pick 2-4 legends with distinct hole counts that fit within max_span.\"\"\"\n    count = random.randint(*LEGEND_COUNT_RANGE)\n    combos = [holes for holes in itertools.combinations(range(MAX_HOLE_COUNT), count)\n              if sum(_legend_span(h) for h in holes) + count - 1 <= max_span]\n    if not combos:\n        return _choose_legends(arrangement, max_span + 2)\n    holes = list(random.choice(combos))\n    random.shuffle(holes)\n    colors = random.sample(LEGEND_COLORS, count)\n    return list(zip(holes, colors))\n\n\ndef _place_legend_line(\n    grid: np.ndarray, legends: list[tuple[int, int]], arrangement: str, r: int, c: int\n) -> None:\n    \"\"\"Paste legend patches sequentially along the arrangement axis.\"\"\"\n    rr, cc = int(r), int(c)\n    for hole_count, color in legends:\n        patch = _legend_patch(hole_count, color, arrangement)\n        paste(grid, patch, rr, cc)\n        if arrangement == \"horizontal\":\n            cc += patch.shape[1] + 1\n        else:\n            rr += patch.shape[0] + 1\n\n\n# ---------- layout helpers ----------\n\ndef _layout_full_horizontal(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Place a full-row horizontal divider with legend panel above or below.\"\"\"\n    legends = _choose_legends(\"horizontal\", FULL_LAYOUT_MAX_SPAN)\n    total = _line_span(legends)\n    panel_h = random.randint(*PANEL_SIZE_RANGE)\n    top = random.choice([True, False])\n    c0 = random.randint(1, GRID_SIZE - 1 - total)\n    if top:\n        div_r = panel_h\n        grid[div_r, :] = DIV\n        blocked[: div_r + 1, :] = 9\n        r0 = random.randint(1, panel_h - 4)\n    else:\n        div_r = GRID_SIZE - 1 - panel_h\n        grid[div_r, :] = DIV\n        blocked[div_r:, :] = 9\n        r0 = random.randint(div_r + 2, GRID_SIZE - 4)\n    _place_legend_line(grid, legends, \"horizontal\", r0, c0)\n    return legends\n\n\ndef _layout_full_vertical(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Place a full-column vertical divider with legend panel left or right.\"\"\"\n    legends = _choose_legends(\"vertical\", FULL_LAYOUT_MAX_SPAN)\n    total = _line_span(legends)\n    panel_w = random.randint(*PANEL_SIZE_RANGE)\n    left = random.choice([True, False])\n    r0 = random.randint(1, GRID_SIZE - 1 - total)\n    if left:\n        div_c = panel_w\n        grid[:, div_c] = DIV\n        blocked[:, : div_c + 1] = 9\n        c0 = random.randint(1, panel_w - 4)\n    else:\n        div_c = GRID_SIZE - 1 - panel_w\n        grid[:, div_c] = DIV\n        blocked[:, div_c:] = 9\n        c0 = random.randint(div_c + 2, GRID_SIZE - 4)\n    _place_legend_line(grid, legends, \"vertical\", r0, c0)\n    return legends\n\n\ndef _l_corner_geometry(corner: str, panel_h: int, panel_w: int,\n                       arrangement: str, total: int) -> tuple:\n    \"\"\"Compute divider pivot and legend placement bounds for an L-corner.\n\n    Returns (dr, dc, r_min, r_max, c_min, c_max) where (dr, dc) is the corner\n    pivot of the L-divider and the remaining values bound the legend origin.\n    \"\"\"\n    N = GRID_SIZE\n    cross_dim = 3 if arrangement == \"horizontal\" else total\n    along_dim = total if arrangement == \"horizontal\" else 3\n\n    if corner == \"tl\":\n        dr, dc = panel_h, panel_w\n","exit_code":0,"status":"completed"}}
