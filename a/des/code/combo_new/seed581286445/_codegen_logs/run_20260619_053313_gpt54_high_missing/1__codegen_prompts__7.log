{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/25c199f5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/25c199f5.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg\nimport random\n\n\ndef _separator_columns(g: np.ndarray, bg: int) -> list[int]:\n    H, W = g.shape\n    candidates: list[list[int]] = []\n    for color in colors_present(g, exclude={bg}):\n        mask = g == int(color)\n        full_cols = [c for c in range(W) if bool(np.all(mask[:, c]))]\n        if len(full_cols) != 2:\n            continue\n        if int(mask.sum()) != int(H * len(full_cols)):\n            continue\n        s0, s1 = full_cols\n        if s0 > 0 and s1 > s0 + 1 and s1 < W - 1:\n            panel_w = s0\n            if s1 - s0 - 1 == panel_w and W - s1 - 1 == panel_w:\n                candidates.append(full_cols)\n\n    assert len(candidates) == 1\n    return candidates[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack the non-background rows from three separated panels into one panel, scanning panels right-to-left.\n\n    Input structure:\n    - A rectangular grid contains three equal-size panels separated by two full-height divider columns.\n    - The background is the dominant color; divider pixels use a color that appears only in the divider columns.\n\n    Rule:\n    - Read panels from right to left, and within each panel read rows from top to bottom.\n    - Keep each row that contains any non-background pixel, discarding all-background rows.\n    - Place the kept rows at the bottom of a single panel-shaped output, padding above with background rows.\n\n    Key insight:\n    - The task is row packing: the divider columns mark independent panels, and only the occupied rows are moved.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    s0, s1 = _separator_columns(g, bg)\n    panel_w = int(s0)\n    assert H == panel_w\n\n    panels = [\n        g[:, :s0],\n        g[:, s0 + 1 : s1],\n        g[:, s1 + 1 :],\n    ]\n    rows: list[np.ndarray] = []\n    for panel in reversed(panels):\n        assert panel.shape == (H, panel_w)\n        for r in range(H):\n            row = panel[r, :]\n            if bool(np.any(row != bg)):\n                rows.append(row.copy())\n\n    assert 0 < len(rows) <= H\n    for i in range(len(rows) - 1):\n        cols_a = set(int(c) for c in range(panel_w) if int(rows[i][c]) != bg)\n        cols_b = set(int(c) for c in range(panel_w) if int(rows[i + 1][c]) != bg)\n        assert cols_a & cols_b, \"consecutive non-bg rows must share at least one column\"\n    out = np.full((H, panel_w), bg, dtype=int)\n    out[H - len(rows) :, :] = np.asarray(rows, dtype=int)\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and fixed palette observed in the task.\nPANEL_SIZE_RANGE = (4, 6)\nBG_COLOR, SEPARATOR_COLOR = 7, 6\nCONTENT_COLORS = (1, 5)\n# Packed output rows and per-panel block heights.\nPACKED_ROW_RANGE = (3, 5)\nGROUP_ROW_RANGE = (1, 3)\n# Row intervals and hollow 3-row block variants.\nROW_WIDTH_RANGE = (1, 5)\nHOLLOW_HEIGHT = 3\nHOLLOW_WIDTH_RANGE = (3, 5)\nHOLLOW_PROBABILITY = 0.35\n# Rejection-sampling retry limit.\nGENERATION_RETRIES = 300\n\n\ndef _partition_rows(total: int) -> tuple[int, int, int]:\n    min_rows, max_rows = GROUP_ROW_RANGE\n    choices = [\n        (right, middle, left)\n        for right in range(min_rows, max_rows + 1)\n        for middle in range(min_rows, max_rows + 1)\n        for left in range(min_rows, max_rows + 1)\n        if right + middle + left == total\n    ]\n    return random.choice(choices)\n\n\ndef _interval(width: int, must_include: int | None = None) -> tuple[int, int]:\n    min_len, max_config_len = ROW_WIDTH_RANGE\n    max_len = min(max_config_len, width)\n    length = random.randint(min_len, max_len)\n    if must_include is None:\n        start = random.randint(0, width - length)\n    else:\n        lo = max(0, must_include - length + 1)\n        hi = min(must_include, width - length)\n        start = random.randint(lo, hi)\n    return start, start + length - 1\n\n\ndef _solid_block(height: int, width: int, bg: int, color: int) -> np.ndarray:\n    block = np.full((height, width), bg, dtype=int)\n    left, right = _interval(width)\n    block[0, left : right + 1] = color\n    for r in range(1, height):\n        overlap_col = random.randint(left, right)\n        left, right = _interval(width, overlap_col)\n        block[r, left : right + 1] = color\n    return block\n\n\ndef _hollow_block(width: int, bg: int, color: int) -> np.ndarray:\n    block = np.full((HOLLOW_HEIGHT, width), bg, dtype=int)\n    min_width, max_width = HOLLOW_WIDTH_RANGE\n    shape_w = random.randint(min_width, min(max_width, width))\n    left = random.randint(0, width - shape_w)\n    right = left + shape_w - 1\n    block[0, left : right + 1] = color\n    block[1, left] = color\n    block[1, right] = color\n    block[2, left : right + 1] = color\n    return block\n\n\ndef _connected_block(height: int, width: int, bg: int, color: int) -> np.ndarray:\n    if height == HOLLOW_HEIGHT and width >= HOLLOW_WIDTH_RANGE[0] and random.random() < HOLLOW_PROBABILITY:\n        return _hollow_block(width, bg, color)\n    return _solid_block(height, width, bg, color)\n\n\ndef _place_block(block: np.ndarray, panel_size: int, bg: int) -> np.ndarray:\n    panel = np.full((panel_size, panel_size), bg, dtype=int)\n    offset = random.randint(0, panel_size - block.shape[0])\n    panel[offset : offset + block.shape[0], :] = block\n    return panel\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(*PANEL_SIZE_RANGE)\n    bg = BG_COLOR\n    sep = SEPARATOR_COLOR\n    A, B = random.sample(CONTENT_COLORS, 2)\n\n    K = random.randint(PACKED_ROW_RANGE[0], min(PACKED_ROW_RANGE[1], H))\n    right_n, middle_n, left_n = _partition_rows(K)\n\n    right_block = _connected_block(right_n, H, bg, A)\n    middle_block = _connected_block(middle_n, H, bg, B)\n    left_block = _connected_block(left_n, H, bg, A)\n\n    stacked_rows = np.vstack([right_block, middle_block, left_block])\n    out = np.full((H, H), bg, dtype=int)\n    out[H - K :, :] = stacked_rows\n\n    panels = tuple(_place_block(block, H, bg) for block in (left_block, middle_block, right_block))\n    sep_col = np.full((H, 1), sep, dtype=int)\n    inp = np.hstack([panels[0], sep_col, panels[1], sep_col, panels[2]])\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except AssertionError:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 25c199f5 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import find_components, get_bg, neighbors4, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n                frontier.append((rr, cc))\n    return frontier\n\n\ndef _grow_body(area):\n    choices = [\n        (h, w)\n        for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n        for w in _inclusive_range(_BODY_WIDTH_RANGE)\n        if h * w >= area\n    ]\n    h, w = random.choice(choices)\n    cells = set(random.choice(_GROW_BODY_SEEDS))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, h, w)\n        if not frontier:\n            return _grow_body(area)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n\n\ndef _symmetric_body(area):\n    choices = []\n    for height in _inclusive_range(_BODY_HEIGHT_RANGE):\n        extra = area - height\n        if extra >= 2 and extra % 2 == 0 and extra // 2 <= height:\n            choices.append((height, extra // 2))\n    if not choices:\n        return _grow_body(area)\n\n    height, pair_count = random.choice(choices)\n    cells = {(r, 1) for r in range(height)}\n    rows = list(range(height))\n    random.shuffle(rows)\n    for r in rows[:pair_count]:\n        cells.add((r, 0))\n        cells.add((r, 2))\n\n    if height >= _SYMMETRIC_TRANSPOSE_MIN_HEIGHT and random.random() < _SYMMETRIC_TRANSPOSE_PROB:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\"","aggregated_output":"from __future__ import annotations\n\nimport math\n\nimport numpy as np\n\nfrom arc_utils import bbox, colors_present, crop_bbox, get_bg, label_mask\nimport random\n\n\ndef _count_enclosed_regions(walls: np.ndarray) -> int:\n    labels, n_labels = label_mask(~walls, connectivity=4)\n    h, w = walls.shape\n    count = 0\n    for k in range(1, n_labels + 1):\n        coords = np.argwhere(labels == k)\n        assert coords.size > 0\n        touches_edge = (\n            np.any(coords[:, 0] == 0)\n            or np.any(coords[:, 0] == h - 1)\n            or np.any(coords[:, 1] == 0)\n            or np.any(coords[:, 1] == w - 1)\n        )\n        if not touches_edge:\n            count += 1\n    return int(count)\n\n\ndef _reconstruct_walls(mask: np.ndarray) -> np.ndarray:\n    h, _w = mask.shape\n    col_counts = mask.sum(axis=0)\n    v_threshold = max(3, math.ceil(0.45 * h))\n    vcols = [int(c) for c, n in enumerate(col_counts) if int(n) >= v_threshold]\n    if len(vcols) < 2:\n        return mask.copy()\n\n    row_counts = mask.sum(axis=1)\n    h_threshold = max(3, len(vcols) + 1)\n    hrows = [int(r) for r, n in enumerate(row_counts) if int(n) >= h_threshold]\n    assert len(hrows) >= 2\n\n    walls = np.zeros_like(mask, dtype=bool)\n\n    for r in hrows:\n        for c0, c1 in zip(vcols, vcols[1:]):\n            segment = mask[r, c0 : c1 + 1]\n            length = int(c1 - c0 + 1)\n            hits = int(segment.sum())\n            dense = hits >= max(2, math.ceil(0.45 * length))\n            interior_evidence = length > 2 and hits >= 2 and bool(segment[1:-1].any())\n            if dense or interior_evidence:\n                walls[r, c0 : c1 + 1] = True\n\n    for c in vcols:\n        for r0, r1 in zip(hrows, hrows[1:]):\n            segment = mask[r0 : r1 + 1, c]\n            length = int(r1 - r0 + 1)\n            hits = int(segment.sum())\n            if hits >= max(2, math.ceil(0.45 * length)):\n                walls[r0 : r1 + 1, c] = True\n\n    return walls\n\n\ndef _room_count_for_color(g: np.ndarray, color: int) -> int:\n    b = bbox(g == int(color))\n    assert b is not None\n    mask = crop_bbox(g == int(color), b).astype(bool)\n    walls = _reconstruct_walls(mask)\n    return _count_enclosed_regions(walls)\n\n\ndef _walls_for_color(g: np.ndarray, color: int) -> np.ndarray:\n    b = bbox(g == int(color))\n    assert b is not None\n    r0, c0, r1, c1 = b\n    mask = crop_bbox(g == int(color), b).astype(bool)\n    walls = _reconstruct_walls(mask)\n    out = np.zeros_like(g, dtype=bool)\n    out[r0 : r1 + 1, c0 : c1 + 1] = walls\n    return out\n\n\ndef _cover_order(g: np.ndarray, group: list[tuple[int, int, np.ndarray]]) -> list[tuple[int, int, np.ndarray]]:\n    if len(group) == 1:\n        return group\n\n    by_color = {int(item[0]): item for item in group}\n    above: dict[int, set[int]] = {color: set() for color, _rooms, _walls in group}\n    indegree: dict[int, int] = {color: 0 for color, _rooms, _walls in group}\n\n    for i, (ca, _ra, wa) in enumerate(group):\n        for cb, _rb, wb in group[i + 1 :]:\n            overlap = wa & wb\n            if not bool(overlap.any()):\n                continue\n            visible = set(int(v) for v in np.unique(g[overlap]))\n            top_colors = visible & {int(ca), int(cb)}\n            assert len(top_colors) == 1\n            top = top_colors.pop()\n            under = int(cb) if top == int(ca) else int(ca)\n            if top not in above[under]:\n                above[under].add(top)\n                indegree[top] += 1\n\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    remaining = set(by_color)\n    while remaining:\n        ready = [color for color in remaining if indegree[color] == 0]\n        assert len(ready) == 1\n        color = ready[0]\n        remaining.remove(color)\n        ordered.append(by_color[color])\n        for nxt in above[color]:\n            indegree[nxt] -= 1\n    return ordered\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n\n    Input structure:\n    - Black background with several axis-aligned colored line drawings.\n    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n\n    Rule:\n    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n    - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n    - The color with no enclosed region is the noise/pad color.\n    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n\n    Key insight:\n    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg == 0\n\n    counts: list[tuple[int, int, np.ndarray]] = []\n    for color in colors_present(g, exclude={bg}):\n        rooms = _room_count_for_color(g, int(color))\n        walls = _walls_for_color(g, int(color))\n        counts.append((int(color), int(rooms), walls))\n\n    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n    assert drawings\n    assert len(pad_colors) == 1\n\n    pad = int(pad_colors[0])\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n        group = [item for item in drawings if item[1] == rooms]\n        ordered.extend(_cover_order(g, group))\n\n    width = max(rooms for _color, rooms, _walls in ordered)\n\n    out = np.full((len(ordered), width), pad, dtype=int)\n    for r, (color, rooms, _walls) in enumerate(ordered):\n        out[r, :rooms] = int(color)\n    return out\n\n# --------------- generator (claude-opus-4-6) ---------------\n\n# ---- CFG: Tunable generation parameters ----\n_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n    5: (25, 30, 25, 30, 16, 18),\n    4: (22, 30, 22, 30, 18, 22),\n    3: (20, 30, 20, 30, 22, 25),\n}\n_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n_OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n_GEN_RETRIES = 300                   # outer retry limit\n\n\ndef _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n    \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n    if n * min_gap > max_total:\n        return None\n    gaps = [min_gap] * n\n    remaining = max_total - sum(gaps)\n    for i in range(n):\n        extra = min(max_gap - gaps[i], remaining)\n        if extra > 0:\n            add = random.randint(0, extra)\n            gaps[i] += add\n            remaining -= add\n    random.shuffle(gaps)\n    return gaps\n\n\ndef _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n    \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n    if target_rooms == 1:\n        gap_h = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_h - 2))\n        gap_w = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_w - 2))\n        h, w = gap_h + 2, gap_w + 2\n        walls = np.zeros((h, w), dtype=bool)\n        walls[0, :] = True\n        walls[h - 1, :] = True\n        walls[:, 0] = True\n        walls[:, w - 1] = True\n        return walls\n\n    # For target_rooms >= 2: grid of cells, then selectively merge\n    possible_configs = []\n    for nv in range(2, 6):\n        for nh in range(2, 5):\n            cells = (nv - 1) * (nh - 1)\n            if target_rooms <= cells <= target_rooms + 4:\n                possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        for nv in range(2, 7):\n            for nh in range(2, 6):\n                cells = (nv - 1) * (nh - 1)\n                if cells >= target_rooms:\n                    possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        return None\n\n    n_vcols, n_hrows, total_cells = random.choice(possible_configs)\n    n_row_gaps = n_hrows - 1\n    n_col_gaps = n_vcols - 1\n    min_gap, max_gap = _CELL_GAP_RANGE\n\n    if min_gap * n_row_gaps > max_h - 1 or min_gap * n_col_gaps > max_w - 1:\n        return None\n\n    row_gaps = _random_gaps(n_row_gaps, min_gap, max_gap, max_h - 1)\n    col_gaps = _random_gaps(n_col_gaps, min_gap, max_gap, max_w - 1)\n    if row_gaps is None or col_gaps is None:\n        return None\n\n    # Compute line positions from cumulative gaps\n    vcol_positions = [0]\n    for gap in col_gaps:\n        vcol_positions.append(vcol_positions[-1] + gap)\n    hrow_positions = [0]\n    for gap in row_gaps:\n        hrow_positions.append(hrow_positions[-1] + gap)\n\n    frame_h = hrow_positions[-1] + 1\n    frame_w = vcol_positions[-1] + 1\n    walls = np.zeros((frame_h, frame_w), dtype=bool)\n    for r in hrow_positions:\n        walls[r, :] = True\n    for c in vcol_positions:\n        walls[:, c] = True\n\n    cells_to_merge = total_cells - target_rooms\n    if cells_to_merge == 0:\n        return walls\n","exit_code":0,"status":"completed"}}
