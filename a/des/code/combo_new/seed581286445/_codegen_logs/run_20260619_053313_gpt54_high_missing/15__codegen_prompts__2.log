{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/8f215267.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count same-color patterns per frame and represent the tally as dots inside.\n\n    Input structure:\n    - bg = most common color.\n    - Hollow rectangular frames in various colors.\n    - Small monochrome pattern sprites scattered outside frames.\n\n    Rule:\n    - Remove all small patterns from the grid.\n    - For each frame of color C, count how many patterns share color C.\n    - Draw that many dots along the frame's center row, spaced by 2, starting from the right.\n\n    Key insight: Frames act as tally displays — scattered same-color patterns are \"absorbed\" and their count is shown as interior dots.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    out = g.copy()\n    bg = int(get_bg(g))\n\n    regions = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n\n    frames: list[dict] = []\n    patterns: list[dict] = []\n    for comp in regions:\n        b = comp[\"bbox\"]\n        h = bbox_h(b)\n        w = bbox_w(b)\n        area = int(comp[\"area\"])\n        is_frame = (h >= 5) and (w >= 5) and (area < (h * w * 0.7))\n        if is_frame:\n            frames.append(comp)\n        else:\n            patterns.append(comp)\n\n    # Remove patterns from output.\n    for p in patterns:\n        for r, c in p[\"coords\"]:\n            out[int(r), int(c)] = bg\n\n    # For each frame, count matching patterns and draw dots.\n    for f in frames:\n        col = int(f[\"color\"])\n        num_patterns = sum(1 for p in patterns if int(p[\"color\"]) == col)\n        if num_patterns <= 0:\n            continue\n\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        r_mid = (r0 + r1) // 2\n        for i in range(int(num_patterns)):\n            cc = int(c1 - 2 - 2 * i)\n            if cc > int(c0):\n                out[int(r_mid), int(cc)] = col\n\n    return out\n\n# --------------- generator (codex-att2) ---------------\n\n# --- layout geometry ---\nFRAME_H = 5                    # frame height (rows)\nFRAME_W = 11                   # frame width (cols)\nFRAME_R0 = 1                   # top-left row of first frame\nFRAME_C0 = 1                   # top-left col of all frames\nFRAME_GAP = 2                  # bg rows between consecutive frames\nGRID_W = 23                    # fixed grid width\nRIGHT_C0 = 13                  # first column of the right (sprite) region\nRIGHT_W = 9                    # width of the right region\n\n# --- structural counts ---\nN_FRAMES_RANGE = (3, 5)        # [lo, hi) for number of frames\nN_DISTRACTORS_RANGE = (1, 3)   # [lo, hi) for distractor sprite count\nTOTAL_PATTERNS_RANGE = (5, 11) # [lo, hi) for total sprite count\nMAX_DOTS_PER_FRAME = 4         # max dot tally inside one frame\nBOTTOM_PAD_RANGE = (0, 7)      # [lo, hi) extra bg rows when n_frames==3\n\n# --- sprite shape ---\nSPRITE_AREA_RANGE = (2, 9)     # [lo, hi) connected-cell count per sprite\nSPRITE_MAX_H = 4               # max bbox height for sprite\nSPRITE_MAX_W = 3               # max bbox width for sprite\nSPRITE_PADDING = 1             # gap between placed sprites\n\n# --- retry budget ---\nMAX_ATTEMPTS = 300\n\n\ndef _frame_patch(color: int, bg: int, n_dots: int) -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/21897d95.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.\n\n    Input structure:\n    - The grid is a mosaic of monochrome regions.\n    - Color 1 forms T-shaped control markers on region boundaries.\n    - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.\n    - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.\n\n    Rule:\n    - For a color-1 T marker, the single stem points at the destination region to repaint.\n    - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.\n    - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.\n    - All marker cells are filled with the final color of the source-side region.\n    - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.\n\n    Key insight:\n    - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = _solve_unrotated(g)\n    l9 = _find_l9_orientation(g)\n    if l9 == 'top_right':\n        return np.rot90(out, 1)\n    if l9 == 'top_left':\n        return np.rot90(out, 3)\n    return out\n\n# --------------- generator (l9rot) ---------------\n\n# ── Tunable constants ──────────────────────────────────────────────────\n# Canvas / region sizing\nGRID_SIZE_MAX = 30                          # max rows or cols\nMIN_REGION_CELLS = 6                        # per-spec minimum\nREGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)\nREGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts\nREGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS\n\n# Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)\nMARKER_MIN = 4\nMARKER_MAX = 8\nNORMAL_MAX = 6\nCOLORED_MAX = 2\n\n# Color pool (all ARC colors except 1, which is reserved for T-marker cells)\nCOLOR_POOL = [c for c in range(10) if c != 1]\n\n# L9 rotation marker\nL9_PROBABILITY = 0.5                        # chance of placing a rotation marker\nL9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation\n    'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],\n    'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],\n}\n\n# Generation retry budget\nSEED_ATTEMPTS = 200                         # tries to place n distinct region seeds\nGEN_RETRIES = 300                           # outer generate_input retry budget\n\n_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n# ── Small geometry helpers ─────────────────────────────────────────────\n\ndef _get_bar(stem):\n","exit_code":0,"status":"completed"}}
