{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport random\nimport numpy as np\nfrom collections import Counter\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed581286445/4/6.py')\nmod = SourceFileLoader('new_arc_task_dbg', str(p)).load_module()\n\nrng = random.Random(0)\nreasons = Counter()\nfor _ in range(2000):\n    h = rng.randint(*mod.GRID_H_RANGE)\n    w = rng.randint(*mod.GRID_W_RANGE)\n    rect_count = rng.randint(*mod.RECT_COUNT_RANGE)\n    rects = []\n    required_overlap = True\n    fail = None\n    for i in range(rect_count):\n        placed = None\n        for _ in range(mod.PLACEMENT_RETRIES):\n            want_overlap = required_overlap or (i > 0 and rng.random() < mod.OVERLAP_PROB)\n            if i > 0 and want_overlap:\n                anchor = rng.choice(rects)\n                rect = mod._overlap_rect(rng, h, w, anchor)\n                if rect is None:\n                    continue\n            else:\n                rect = mod._random_rect(rng, h, w)\n            if rect in rects:\n                continue\n            overlap_count = mod._compatible(rect, rects)\n            if overlap_count is None:\n                continue\n            if want_overlap and i > 0 and overlap_count == 0:\n                continue\n            placed = rect\n            required_overlap = required_overlap and overlap_count == 0\n            break\n        if placed is None:\n            fail = f'place_{i}'\n            break\n        rects.append(placed)\n    if fail:\n        reasons[fail] += 1\n        continue\n    pair_count, degrees = mod._overlap_stats(rects)\n    if pair_count == 0 or pair_count > rect_count + 1 or max(degrees) > 3:\n        reasons['overlap_stats'] += 1\n        continue\n    colors = rng.sample(mod.PALETTE, rect_count)\n    order = list(range(rect_count))\n    rng.shuffle(order)\n    grid = np.zeros((h, w), dtype=int)\n    for idx in order:\n        r0, c0, r1, c1 = rects[idx]\n        grid[r0:r1+1, c0:c1+1] = colors[idx]\n    visible_areas = {}\n    bad = False\n    for idx, color in enumerate(colors):\n        coords = np.argwhere(grid == color)\n        if len(coords) == 0:\n            reasons['invisible'] += 1\n            bad = True\n            break\n        if mod._bbox_from_coords(coords) \"'!= rects[idx]:\n            reasons['\"'bbox_mismatch'] += 1\n            bad = True\n            break\n        visible_areas[idx] = len(coords)\n    if bad:\n        continue\n    occluded = [idx for idx in range(rect_count) if visible_areas[idx] < mod._rect_area(rects[idx])]\n    exposed = [idx for idx in range(rect_count) if visible_areas[idx] == mod._rect_area(rects[idx])]\n    if not occluded:\n        reasons['no_occluded'] += 1\n        continue\n    if exposed and rng.random() < 0.5:\n        target_idx = rng.choice(exposed)\n    else:\n        target_idx = rng.choice(occluded)\n    marker_c = rng.randrange(w)\n    grid[-1, marker_c] = colors[target_idx]\n    if np.count_nonzero(grid[-1]) \"'!= 1:\n        reasons['\"'marker_count'] += 1\n        continue\n    expected = mod._draw_outline(grid.shape, rects[target_idx], colors[target_idx])\n    if not np.array_equal(mod.main(grid), expected):\n        reasons['main_mismatch'] += 1\n        continue\n    reasons['success'] += 1\nprint(reasons)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
