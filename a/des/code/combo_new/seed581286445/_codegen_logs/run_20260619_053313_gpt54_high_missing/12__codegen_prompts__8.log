{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np\nfrom collections import Counter\n\nDIR4=[(1,0),(-1,0),(0,1),(0,-1)]\n\ndef grow(mh,mw,n,rng):\n    owner=np.full((mh,mw),-1,int)\n    cells=[(r,c) for r in range(mh) for c in range(mw)]\n    seeds=rng.sample(cells,n)\n    frontier=[set() for _ in range(n)]\n    sizes=[1]*n\n    for rid,(r,c) in enumerate(seeds):\n        owner[r,c]=rid\n        frontier[rid].add((r,c))\n    rem=mh*mw-n\n    while rem:\n        choices=[]; weights=[]\n        for rid in range(n):\n            boundary=set()\n            for r,c in frontier[rid]:\n                for dr,dc in DIR4:\n                    nr,nc=r+dr,c+dc\n                    if 0<=nr<mh and 0<=nc<mw and owner[nr,nc]==-1:\n                        boundary.add((nr,nc))\n            if boundary:\n                choices.append((rid,list(boundary)))\n                weights.append(1.0/sizes[rid])\n        if not choices:\n            return None\n        idx=rng.choices(range(len(choices)),weights=weights,k=1)[0]\n        rid,boundary=choices[idx]\n        nr,nc=rng.choice(boundary)\n        owner[nr,nc]=rid\n        frontier[rid].add((nr,nc))\n        sizes[rid]+=1\n        rem-=1\n    return owner\n\ndef graph(owner):\n    n=owner.max()+1\n    g=[set() for _ in range(n)]\n    mh,mw=owner.shape\n    for r in range(mh):\n        for c in range(mw):\n            a=owner[r,c]\n            for dr,dc in ((1,0),(0,1)):\n                nr,nc=r+dr,c+dc\n                if nr<mh and nc<mw:\n                    b=owner[nr,nc]\n                    if a\"'!=b:\n                        g[a].add(b); g[b].add(a)\n    return g\n\nrng=random.Random(0)\nleaf_hist=Counter(); region_hist=Counter(); good=0\nfor _ in range(1000):\n    cell=rng.choice([3,4])\n    mh=rng.randint(3, min(6, (29)//(cell+1)))\n    mw=rng.randint(3, min(6, (29)//(cell+1)))\n    n=rng.randint(max(5,(mh*mw)//3), min(10,mh*mw))\n    owner=grow(mh,mw,n,rng)\n    if owner is None: continue\n    g=graph(owner)\n    leaves=sum(len(x)==1 for x in g)\n    leaf_hist[leaves]+=1\n    region_hist[n]+=1\n    if leaves>=1: good+=1\nprint('\"'leaf_hist_common', leaf_hist.most_common(10))\nprint('regions', region_hist.most_common())\nprint('pct_with_leaf', good/1000)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
