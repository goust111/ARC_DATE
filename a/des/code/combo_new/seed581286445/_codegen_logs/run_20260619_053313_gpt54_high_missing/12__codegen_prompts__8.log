{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/230f2e48.py | sed '\"'$d'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/230f2e48.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fold each straight red rod at its black marker, leaving the gray-anchored side fixed.\n\n    Input structure:\n    - The background is the dominant color.\n    - Each foreground object is a straight horizontal or vertical 4-connected rod.\n    - Each rod contains many pixels of one line color, one endpoint marker, and one\n      interior control marker.\n\n    Rule:\n    - For every rod, keep the segment from the endpoint marker through the control\n      marker unchanged.\n    - Move the line-color tail on the far side of the control marker to a\n      perpendicular ray starting next to that marker.\n    - Choose the perpendicular direction with more space to the grid edge.\n\n    Key insight:\n    - The endpoint marker identifies the fixed side of the rod, while the control\n      marker is the hinge; the tail folds into the larger open half-plane.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = get_bg(g)\n    line_color = _line_color(g, bg)\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert components, \"expected at least one marked rod\"\n\n    clear: list[tuple[int, int]] = []\n    paint: list[tuple[int, int]] = []\n\n    for comp in components:\n        coords = [tuple(map(int, coord)) for coord in comp[\"coords\"]]\n        coord_set = set(coords)\n        marker_coords = [p for p in coords if int(g[p]) != line_color]\n        assert len(marker_coords) == 2, \"each rod must have exactly two markers\"\n\n        degrees = {\n            p: sum((nr, nc) in coord_set for nr, nc in neighbors4(*p))\n            for p in marker_coords\n        }\n        endpoints = [p for p, degree in degrees.items() if int(degree) == 1]\n        hinges = [p for p, degree in degrees.items() if int(degree) == 2]\n        assert len(endpoints) == 1 and len(hinges) == 1, \"markers must be endpoint and hinge\"\n        endpoint = endpoints[0]\n        hinge = hinges[0]\n\n        rows = {r for r, _c in coords}\n        cols = {c for _r, c in coords}\n        assert len(rows) == 1 or len(cols) == 1, \"each object must be a straight rod\"\n\n        if len(rows) == 1:\n            assert endpoint[0] == hinge[0], \"horizontal rod markers must share a row\"\n            fixed_sign = int(np.sign(endpoint[1] - hinge[1]))\n            assert fixed_sign != 0, \"endpoint and hinge must be distinct\"\n            tail_step = (0, -fixed_sign)\n            up_space = int(hinge[0])\n            down_space = int(H - 1 - hinge[0])\n            assert up_space != down_space, \"perpendicular direction must be unique\"\n            fold_step = (-1, 0) if up_space > down_space else (1, 0)\n        else:\n            assert endpoint[1] == hinge[1], \"vertical rod markers must share a column\"\n            fixed_sign = int(np.sign(endpoint[0] - hinge[0]))\n            assert fixed_sign != 0, \"endpoint and hinge must be distinct\"\n            tail_step = (-fixed_sign, 0)\n            left_space = int(hinge[1])\n            right_space = int(W - 1 - hinge[1])\n            assert left_space != right_space, \"perpendicular direction must be unique\"\n            fold_step = (0, -1) if left_space > right_space else (0, 1)\n\n        tail: list[tuple[int, int]] = []\n        step = 1\n        while True:\n            p = (\n                int(hinge[0]) + int(tail_step[0]) * step,\n                int(hinge[1]) + int(tail_step[1]) * step,\n            )\n            if p not in coord_set:\n                break\n            assert int(g[p]) == line_color, \"tail must contain only line-color pixels\"\n            tail.append(p)\n            step += 1\n        assert tail, \"each hinge must have a moving tail\"\n\n        for step in range(1, len(tail) + 1):\n            p = (\n                int(hinge[0]) + int(fold_step[0]) * step,\n                int(hinge[1]) + int(fold_step[1]) * step,\n            )\n            assert in_bounds(g.shape, *p), \"folded tail must remain in bounds\"\n            paint.append(p)\n        clear.extend(tail)\n\n    assert len(set(clear)) == len(clear), \"moving tails must not overlap\"\n    assert len(set(paint)) == len(paint), \"folded tails must not collide\"\n    clear_set = set(clear)\n    for p in paint:\n        assert int(g[p]) == int(bg) or p in clear_set, \"fold target must be empty\"\n\n    out = g.copy()\n    for p in clear:\n        out[p] = bg\n    for p in paint:\n        out[p] = line_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# ARC colors.\nBG, RED, HINGE, END = 7, 2, 0, 5\n\n# Canvas and rod-count sampling.\nGRID_SIZE_MIN, GRID_SIZE_MAX = 8, 16\nROD_COUNT_MIN, ROD_COUNT_MAX = 1, 7\nROD_DENSITY_DIVISOR = 28\n\n# Rod geometry sampling.\nHORIZONTAL, VERTICAL = \"h\", \"v\"\nORIENTATIONS = (HORIZONTAL, VERTICAL)\nFIXED_SIGNS = (-1, 1)\nROD_LEN_MIN, ROD_LEN_MAX = 3, 12\nFIXED_LEN_MIN, FIXED_LEN_MAX = 2, 9\nTAIL_LEN_MAX = 5\n\n# Placement and retry controls.\nGAP_DIRECTIONS = ((-1, 0), (1, 0), (0, -1), (0, 1))\nMAX_GENERATE_ATTEMPTS = 300\n\nRecord = dict[str, object]\nRecordKey = tuple[int, int, int, str]\n\n_RECORD_CACHE: dict[int, list[tuple[RecordKey, Record]]] = {}\n\n\n","exit_code":0,"status":"completed"}}
