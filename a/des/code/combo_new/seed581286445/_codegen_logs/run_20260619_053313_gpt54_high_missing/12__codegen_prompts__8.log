{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np\nDIR4=[(1,0),(-1,0),(0,1),(0,-1)]\n\ndef grow(mh,mw,n,rng):\n    owner=np.full((mh,mw),-1,int)\n    cells=[(r,c) for r in range(mh) for c in range(mw)]\n    seeds=rng.sample(cells,n)\n    frontier=[set() for _ in range(n)]\n    sizes=[1]*n\n    for rid,(r,c) in enumerate(seeds):\n        owner[r,c]=rid\n        frontier[rid].add((r,c))\n    rem=mh*mw-n\n    while rem:\n        choices=[]; weights=[]\n        for rid in range(n):\n            boundary=set()\n            for r,c in frontier[rid]:\n                for dr,dc in DIR4:\n                    nr,nc=r+dr,c+dc\n                    if 0<=nr<mh and 0<=nc<mw and owner[nr,nc]==-1:\n                        boundary.add((nr,nc))\n            if boundary:\n                choices.append((rid,list(boundary)))\n                weights.append(1.0/sizes[rid])\n        if not choices:\n            return None\n        idx=rng.choices(range(len(choices)),weights=weights,k=1)[0]\n        rid,boundary=choices[idx]\n        nr,nc=rng.choice(boundary)\n        owner[nr,nc]=rid\n        frontier[rid].add((nr,nc))\n        sizes[rid]+=1\n        rem-=1\n    return owner\n\ndef graph(owner):\n    n=owner.max()+1\n    g=[set() for _ in range(n)]\n    mh,mw=owner.shape\n    for r in range(mh):\n        for c in range(mw):\n            a=owner[r,c]\n            for dr,dc in ((1,0),(0,1)):\n                nr,nc=r+dr,c+dc\n                if nr<mh and nc<mw:\n                    b=owner[nr,nc]\n                    if a\"'!=b:\n                        g[a].add(b); g[b].add(a)\n    return g\n\ndef cand_paths(g):\n    out=[]\n    n=len(g)\n    for s in range(n):\n        def dfs(path):\n            cur=path[-1]\n            if 3<=len(path)<=5:\n                out.append(tuple(path))\n            if len(path)==5:\n                return\n            for nxt in g[cur]:\n                if nxt in path:\n                    continue\n                path.append(nxt)\n                dfs(path)\n                path.pop()\n        dfs([s])\n    return out\n\ndef feasible_sets(g, paths, want):\n    def bt(i, chosen, used):\n        if len(chosen)==want:\n            ptrs=set()\n            for p in chosen:\n                ptrs.update(p[1:-1])\n            for p in chosen:\n                s=p[0]\n                allowed={p[1]}\n                bad=(g[s] & ptrs) - allowed\n                if bad:\n                    return None\n            return chosen[:]\n        for j in range(i, len(paths)):\n            p=paths[j]\n            if any(x in used for x in p):\n                continue\n            chosen.append(p)\n            res=bt(j+1, chosen, used|set(p))\n            if res is not None:\n                return res\n            chosen.pop()\n        return None\n    return bt(0, [], set())\n\nrng=random.Random(0)\ncount1=count2=0\nfor _ in range(1000):\n    cell=rng.choice([3,4])\n    max_dim=min(6, (29)//(cell+1))\n    mh=rng.randint(3, max_dim)\n    mw=rng.randint(3, max_dim)\n    lo=max(4, min(6, (mh*mw)//3))\n    hi=min(10, mh*mw)\n    if lo>hi: lo=hi\n    n=rng.randint(lo,hi)\n    owner=grow(mh,mw,n,rng)\n    if owner is None: continue\n    g=graph(owner)\n    paths=cand_paths(g)\n    rng.shuffle(paths)\n    if feasible_sets(g, paths, 1): count1+=1\n    if feasible_sets(g, paths, 2): count2+=1\nprint('\"'one', count1/1000, 'two', count2/1000)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
