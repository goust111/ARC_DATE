 horizontal contact after each rotated bar.\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-53-    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-54-    g = np.asarray(grid, dtype=int)\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-55-    bg = get_bg(g)\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-56-    colors = set(map(int, np.unique(g))) - {bg}\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-57-    assert colors <= {MARKER_COLOR, BODY_COLOR}\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-58-    assert MARKER_COLOR in colors\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-59-\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-60-    bars = _vertical_bars(g, bg)\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-61-    by_col = {bar[\"col\"]: bar for bar in bars}\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-62-    assert len(by_col) == len(bars)\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-63-\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-64-    baselines = {bar[\"bottom\"] for bar in bars}\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-65-    assert len(baselines) == 1\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-66-    baseline = baselines.pop()\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-67-    out = g.copy()\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-68-    for bar in bars:\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-69-        if bar[\"color\"] != MARKER_COLOR:\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-70-            continue\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-71-\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-72-        group = [bar]\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-73-        current = bar\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-74-        while True:\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-75-            next_col = current[\"col\"] + current[\"height\"]\n/home/lixinyu/snap/new/ARC_code/train/84551f4c.py-76- 