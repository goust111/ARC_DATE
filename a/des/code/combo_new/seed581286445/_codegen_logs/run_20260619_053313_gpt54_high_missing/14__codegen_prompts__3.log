endent cyclic attributes of the ordered bar slots:\n0044:       colors rotate right while heights rotate left.\n0045:     \"\"\"\n0046:     g = np.asarray(grid, dtype=int)\n0047:     height = g.shape[0]\n0048:     bg = get_bg(g)\n0049:     bars = _extract_bars(g, bg)\n0050: \n0051:     out = np.full_like(g, bg)\n0052:     count = len(bars)\n0053:     for i, bar in enumerate(bars):\n0054:         color = bars[(i - 1) % count][\"color\"]\n0055:         bar_height = bars[(i + 1) % count][\"height\"]\n0056:         assert 1 <= bar_height <= height\n0057:         out[height - bar_height : height, bar[\"col\"]] = color\n0058: \n0059:     return out\n0060: \n0061: # --------------- generator (o5x) ---------------\n0062: \n0063: _RNG = np.random.default_rng()\n0064: \n0065: # Canvas/bar bounds.\n0066: BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE = 3, 6\n0067: BACKGROUND_COLOR, MIN_BAR_HEIGHT = 7, 1\n0068: BAR_COL_OFFSET, BAR_COL_STRIDE = 1, 2\n0069: # Color and transform sampling.\n0070: COLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n0071: OUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1\n0072: # Retry limit.\n0073: MAX_GENERATION_ATTEMPTS = 300\n0074: \n0075: \n0076: def _render_bars(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n0077:     side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n0078:     grid = np.full((side, side), BACKGROUND_COLOR, dtype=int)\n0079:     for i, (color, bar_height) in enumerate(zip(colors, heights)):\n0080:         col = BAR_COL_STRIDE * i + BAR_COL_OFFSET\n0081:         grid[side - int(bar_height) : side, col] = int(color)\n0082:     return grid\n0083: \n0084: \n0085: def _expected_output(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n0086:     out_colors = np.roll(colors, OUTPUT_COLOR_SHIFT)\n0087:     out_heights = np.roll(heights, OUTPUT_HEIGHT_SHIFT)\n0088:     return _render_bars(n, out_colors, out_heights)\n0089: \n0090: \n0091: def _gen_attempt() -> np.ndarray | None:\n0092:     n = int(_RNG.integers(BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE))\n0093:     side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n0094:     colors = _RNG.choice(COLOR_POOL, size=n, replace=False)\n0095:     heights = _RNG.integers(MIN_BAR_HEIGHT, side, size=n)\n0096:     if len(set(map(int, heights))) == 1:\n0097:         idx = int(_RNG.integers(n))\n0098:         choices = [h for h in range(MIN_BAR_HEIGHT, side) if h != int(heights[idx])]\n0099:         heights[idx] = int(_RNG.choice(choices))\n0100: \n0101:     grid = _render_bars(n, colors, heights)\n0102:     if np.array_equal(main(grid), _expected_output(n, colors, heights)):\n0103:         return grid\n0104:     return None\n0105: \n0106: \n\n0107: def generate_input() -> np.ndarray:\n0108:     for _ in range(MAX_GENERATION_ATTEMPTS):\n0109:         grid = _gen_attempt()\n0110:         if grid is not None:\n0111:             return grid\n0112:     raise RuntimeError(\"failed to generate valid input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\n0007: def main(grid: np.ndarray) -> np.ndarray:\n0008:     \"\"\"\n0009:     Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n0010: \n0011:     Input structure:\n0012:     - bg = most common color.\n0013:     - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n0014:     - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n0015: \n0016:     Rule:\n0017:     - Match each sprite to the border anchor sharing its marker color.\n0018:     - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n0019:     - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n0020: \n0021:     Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n0022:     \"\"\"\n0023:     g = np.array(grid, dtype=int)\n0024:     H, W = g.shape\n0025:     bg = int(get_bg(g))\n0026: \n0027:     def is_border(r: int, c: int) -> bool:\n0028:         return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n0029: \n0030:     # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n0031:     anchors_by_color: dict[int, tuple[int, int]] = {}\n0032:     for r in range(H):\n0033:         for c in range(W):\n0034:             if not is_border(r, c):\n0035:                 continue\n0036:             v = int(g[r, c])\n0037:             if v == int(bg):\n0038:                 continue\n0039:             ok = True\n0040:             for rr, cc in neighbors4(int(r), int(c)):\n0041:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n0042:                     ok = False\n0043:                     break\n0044:             if ok and v not in anchors_by_color:\n0045:                 anchors_by_color[int(v)] = (int(r), int(c))\n0046: \n0047:     assert not (not anchors_by_color)\n0048: \n0049:     anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n0050: \n0051:     # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n0052:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n0053: \n0054:     def component_marker_color(coords: np.ndarray) -> int | None:\n0055:         # For multi-color sprites, the marker color is the least frequent color inside the component.\n0056:         vals = [int(g[int(r), int(c)]) for r, c in coords]\n0057:         cnt = Counter(vals)\n0058:         if len(cnt) <= 1:\n0059:             return None\n0060:         return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n0061: \n0062:     def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n0063:         # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n0064:         pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n0065:         if not pts:\n0066:             return None\n0067:         if len(pts) == 1:\n0068:             return pts[0]\n0069:         S = {(int(r), int(c)) for r, c in coords}\n0070:         for r, c in pts:\n0071:             for rr, cc in neighbors4(int(r), int(c)):\n0072:                 if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n0073:                     return (int(r), int(c))\n0074:         return pts[0]\n0075: \n0076:     moves: list[tuple[np.ndarray, int, int]] = []\n0077: \n0078:     for comp in comps:\n0079:         coords = comp[\"coords\"]\n0080:         if coords.size == 0:\n0081:             continue\n0082: \n0083:         # --- STEP 3) Decide marker color for this component. ---\n0084:         marker_col = component_marker_color(coords)\n0085:         if marker_col is None:\n0086:             # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n0087:             if int(coords.shape[0]) != 1:\n0088:                 continue\n0089:             r, c = map(int, coords[0])\n0090:             v = int(g[r, c])\n0091:             if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n0092:                 continue\n0093:             marker_col = int(v)\n0094: \n0095:         if int(marker_col) not in anchors_by_color:\n0096:             continue\n0097: \n0098:         mp = marker_pixel(coords, int(marker_col))\n0099:         if mp is None:\n0100:             continue\n0101: \n0102:         ar, ac = anchors_by_color[int(marker_col)]\n0103: \n0104:         # --- STEP 4) Compute translation (dr,dc). ---\n0105:         on_top_bottom = int(ar) in (0, int(H - 1))\n0106:         on_left_right = int(ac) in (0, int(W - 1))\n0107:         horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n0108: \n0109:         dr = 0\n0110:         dc = 0\n0111:         if horizontal:\n0112:             dc = int(ac - mp[1])\n0113:         else:\n0114:            