ins a foreground control pixel; it gives the\n0064:       corner from which the triangle is painted.\n0065:     - There is one unique largest 8-connected monochrome foreground object, the\n0066:       motif that remains in the output; all other foreground pixels are controls.\n0067:     - Every foreground component outside that motif is a singleton control pixel.\n0068:     - The fill color is the unique control color that appears in at least two\n0069:       non-corner control pixels.\n0070: \n0071:     Rule\n0072:     - Start from a blank background canvas and redraw only the largest motif.\n0073:     - Count the non-corner control pixels; that count is the triangle side.\n0074:     - Paint the fill color on the right-triangle region where those two distances\n0075:       from the marked corner's edges sum to less than the side length.\n0076: \n0077:     Key insight\n0078:     - The scattered singleton controls are counted into a compact triangular\n0079:       stack at the marked corner; only the largest motif is not part of the count.\n0080:     \"\"\"\n0081:     g = np.asarray(grid, dtype=int)\n0082:     bg = get_bg(g)\n0083:     H, W = g.shape\n0084: \n0085:     corners = {\n0086:         \"TL\": (0, 0),\n0087:         \"TR\": (0, W - 1),\n0088:         \"BL\": (H - 1, 0),\n0089:         \"BR\": (H - 1, W - 1),\n0090:     }\n0091:     marked_corners = [\n0092:         (name, rc) for name, rc in corners.items() if int(g[rc]) != int(bg)\n0093:     ]\n0094:     assert len(marked_corners) == 1, \"expected exactly one foreground corner marker\"\n0095:     corner, (corner_r, corner_c) = marked_corners[0]\n0096: \n0097:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n0098:     assert comps, \"expected at least one foreground component\"\n0099:     max_area = max(int(comp[\"area\"]) for comp in comps)\n0100:     motif_candidates = [comp for comp in comps if int(comp[\"area\"]) == max_area]\n0101:     assert len(motif_candidates) == 1, \"expected a unique largest motif\"\n0102:     motif = motif_candidates[0]\n0103:     motif_color = int(motif[\"color\"])\n0104:     motif_coords = {tuple(map(int, coord)) for coord in motif[\"coords\"]}\n0105:     motif_direction = _diagonal_direction(motif_coords)\n0106:     assert motif_direction is not None, \"motif must be square and diagonal-symmetric\"\n0107:     assert motif_direction == corner, \"corner marker must match motif diagonal direction\"\n0108: \n0109:     control_coords = [\n0110:         (int(r), int(c))\n0111:         for r, c in np.argwhere(g != bg)\n0112:         if (int(r), int(c)) not in motif_coords\n0113:     ]\n0114:     assert (corner_r, corner_c) in control_coords, \"corner marker must be a control pixel\"\n0115:     assert len(control_coords) > 1, \"expected non-corner control pixels\"\n0116: \n0117:     control_components = [comp for comp in comps if comp is not motif]\n0118:     assert all(int(comp[\"area\"]) == 1 for comp in control_components), \"controls must be singleton components\"\n0119: \n0120:     control_counts = Counter(\n0121:         int(g[r, c])\n0122:         for r, c in control_coords\n0123:         if (int(r), int(c)) != (corner_r, corner_c)\n0124:     )\n0125:     fill_candidates = [\n0126:         int(color) for color, count in control_counts.items() if int(count) >= 2\n0127:     ]\n0128:     assert len(fill_candidates) == 1, \"expected one repeated non-corner fill color\"\n0129:     fill_color = fill_candidates[0]\n0130:     side = len(control_coords) - 1\n0131: \n0132:     out = np.full_like(g, bg)\n0133:     for r, c in motif_coords:\n0134:         out[r, c] = motif_color\n0135:     _paint_corner_triangle(out, corner, int(side), fill_color)\n0136:     return out\n0137: \n0138: # --------------- generator (att2) ---------------\n0139: \n0140: _GEN_ATTEMPTS = 300\n0141: \n0142: # Canvas and triangle bounds.\n0143: _GEN_ROW_BOUNDS = (6, 15)\n0144: _GEN_COL_BOUNDS = (9, 14)\n0145: _GEN_TRIANGLE_SIDE_BOUNDS = (2, 5)\n0146