\n0009:     \"\"\"\n0010:     Dock movable tools into border-anchored frames by filling cavities.\n0011: \n0012:     Input structure:\n0013:     - bg = most common color.\n0014:     - Border-touching components cluster into anchor frames with interior bg cavities.\n0015:     - Non-border 2-color components are movable tools.\n0016: \n0017:     Rule:\n0018:     - Match each tool to a frame whose cavity size equals one of its color-region counts.\n0019:     - Rotate/flip the tool so one color fills the cavity exactly; the other stays outside.\n0020:     - If the docking orientation uses a reflection, swap the tool's two colors.\n0021: \n0022:     Key insight: Cavity size determines tool–frame pairing; reflection triggers color swap.\n0023:     \"\"\"\n0024:     inp = grid\n0025:     g = inp.copy()\n0026:     bg = get_bg(g)\n0027:     H, W = g.shape\n0028: \n0029:     def bbox_gap(a, b) -> int:\n0030:         (ar0, ac0, ar1, ac1) = a\n0031:         (br0, bc0, br1, bc1) = b\n0032:         def gap1(x0, x1, y0, y1):\n0033:             if y1 < x0:\n0034:                 return int(x0 - y1)\n0035:             if x1 < y0:\n0036:                 return int(y0 - x1)\n0037:             return 0\n0038:         return gap1(ar0, ar1, br0, br1) + gap1(ac0, ac1, bc0, bc1)\n0039: \n0040:     fg = g != int(bg)\n0041:     lab, n = label(fg, structure=STRUCT4)\n0042:     fixed_mask = np.zeros((H, W), dtype=bool)\n0043:     fixed_components = []\n0044:     for cid in range(1, n + 1):\n0045:         pts = np.argwhere(lab == cid)\n0046:         pts_list = [(int(r), int(c)) for r, c in pts]\n0047:         touches = any(r == 0 or r == H - 1 or c == 0 or c == W - 1 for r, c in pts_list)\n0048:         if not touches:\n0049:             continue\n0050:         fixed_components.append({\"pts\": pts_list, \"bbox\": (int(pts[:,0].min()), int(pts[:,1].min()), int(pts[:,0].max()), int(pts[:,1].max()))})\n0051:         for r, c in pts_list:\n0052:             fixed_mask[r, c] = True\n0053: \n0054:     assert not (not fixed_components)\n0055: \n0056:     # Cluster fixed components into anchor frames.\n0057:     parent = list(range(len(fixed_components)))\n0058: \n0059:     def find(x):\n0060:         while parent[x] != x:\n0061:             parent[x] = parent[parent[x]]\n0062:             x = parent[x]\n0063:         return x\n0064: \n0065:     def union(a, b):\n0066:         ra, rb = find(a), find(b)\n0067:         if ra != rb:\n0068:             parent[rb] = ra\n0069: \n0070:     for i in range(len(fixed_components)):\n0071:         for j in range(i + 1, len(fixed_components)):\n0072:             if bbox_gap(fixed_components[i][\"bbox\"], fixed_components[j][\"bbox\"]) <= 2:\n0073:                 union(i, j)\n0074: \n0075:     groups: dict[int, list[int]] = {}\n0076:     for i in range(len(fixed_components)):\n0077:         groups.setdefault(find(i), []).append(i)\n0078: \n0079:     anchor_groups = []\n0080:     for idxs in groups.values():\n0081:         pts = [p for i in idxs for p in fixed_components[i][\"pts\"]]\n0082:         rs = [r for r, _c in pts]\n0083:         cs = [c for _r, c in pts]\n0084:         bbox = (min(rs), min(cs), max(rs), max(cs))\n0085:         mask = np.zeros((H, W), dtype=bool)\n0086:         for r, c in pts:\n0087:             mask[r, c] = True\n0088:         sock = np.zeros((H, W), dtype=bool)\n0089:         for r in range(bbox[0], bbox[2] + 1):\n0090:             for c in range(bbox[1], bbox[3] + 1):\n0091:                 if int(g[r, c]) != int(bg):\n0092:                     continue\n0093:                 for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n0094:                     rr, cc = r + dr, c + dc\n0095:                     if 0 <= rr < H and 0 <= cc < W and mask[rr, cc]:\n0096:                         sock[r, c] = True\n0097:                         break\n0098: \n0099:         # Cavity = largest bg component inside bbox that is adjacent to the anchor pixels.\n0100:         cavity = np.zeros((H, W), dtype=bool)\n0101: