k\n0141:             labc, nc = label(sub, structure=STRUCT4)\n0142:             if nc < 2:\n0143:                 continue\n0144:             comps = []\n0145:             for cid in range(1, nc + 1):\n0146:                 ptsc = np.argwhere(labc == cid)\n0147:                 comps.append((int(len(ptsc)), float(ptsc[:, 0].mean()), float(ptsc[:, 1].mean())))\n\n0781: def generate_input() -> np.ndarray:\n0782:     for _ in range(GEN_ATTEMPT_RETRIES):\n0783:         grid = _gen_attempt()\n0784:         if grid is not None:\n0785:             return grid\n0786:     raise RuntimeError(\"failed to generate valid input after %d attempts\" % GEN_ATTEMPT_RETRIES)\n\n===== /home/lixinyu/snap/new/ARC_code/eval/62593bfd.py\n0031: def main(grid: np.ndarray) -> np.ndarray:\n0032:     \"\"\"\n0033:     Sort objects to top or bottom edge by whether their shape (up to rotation/flip) is shared.\n0034: \n0035:     Input structure:\n0036:     - bg = most common color.\n0037:     - Several multicolor connected components (8-connected) scattered across the grid.\n0038: \n0039:     Rule:\n0040:     - Compute each object's canonical shape (binary mask, invariant to rotation and flip).\n0041:     - Objects whose shape appears in two or more components → translate to TOP edge (row 0).\n0042:     - Objects whose shape is unique → translate to BOTTOM edge (row H−h).\n0043:     - Horizontal position (left column) is preserved; only vertical translation changes.\n0044: \n0045:     Key insight: The sorting criterion is shape frequency (rotation-invariant), not area — duplicated shapes go up, unique shapes go down.\n0046:     \"\"\"\n0047:     g = np.array(grid, dtype=int)\n0048:     H, W = g.shape\n0049:     bg = int(get_bg(g))\n0050: \n0051:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n0052:     assert not (not comps)\n0053: \n0054:     extracted = []\n0055:     for comp in comps:\n0056:         r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n0057:         patch = crop_bbox(g, (r0, c0, r1, c1))\n0058: \n0059:         # Isolate this component exactly (bbox rectangle may include background).\n0060:         rel_coords = [(int(r) - r0, int(c) - c0) for r, c in comp[\"coords\"]]\n0061:         m = mask_from_coords(rel_coords, patch.shape)\n0062:         pat = np.full_like(patch, bg)\n0063:         pat[m] = patch[m]\n0064: \n0065:         extracted.append(\n0066:             {\n0067:                 \"c0\": int(c0),\n0068:                 \"pat\": pat,\n0069:                 \"shape_key\": canonical_shape_key(m),\n0070:             }\n0071:         )\n0072: \n0073:     freq = Counter(d[\"shape_key\"] for d in extracted)\n0074:     out = np.full((H, W), int(bg), dtype=int)\n0075: \n0076:     for d in extracted:\n0077:         pat = d[\"pat\"]\n0078:         h, w = map(int, pat.shape)\n0079:         dest_r0 = 0 if int(freq[d[\"shape_key\"]]) >= 2 else int(H - h)\n0080:         dest_c0 = int(d[\"c0\"])\n0081:         paste(out, pat, dest_r0, dest_c0, transparent=int(bg))\n0082: \n0083:     return out\n0084: \n0085: # --------------- generator (att2) ---------------\n0086: \n0087: _RNG = np.random.default_rng()\n0088: \n0089: # ── CFG: canvas ──────────────────────────────────────────────────────\n0090: GRID_H_RANGE = (19, 31)          # H uniform in [19, 30]\n0091: GRID_W_RANGE = (19, 31)          # W uniform in [19, 30]\n0092: NUM_COLORS = 10                   # palette 0-9\n0093: \n0094: # ── CFG: component shapes ───────────────────────────────────────────\n0095: BBOX_MAX = 5                      # max h or w of a component bbox\n0096: AREA_RANGE = (3, 13)              # component area in [3, 12]\n0097: MIN_FILL_RATIO_X10 = 4            # area * 10 >= 4 * h * w\n0098: IRREGULAR_PROB = 0.85             # prefer non-rectangular bboxes\n0099: \n0100: # ── CFG: layout ─────────────────────────────────────────────────────\n0101: DUP_LAYOUTS = [(2,), (3,), (2, 2)]  # possible duplicate-group structures\n0102: MIN_COL_GAP = 1                   # minimum column gap between components\n0103: MIN_VERTICAL_GAP = 5              # min gap between top-group bottom and bottom-group top\n0104: \n0105: # ── CFG: generation ─────────────────────────────────────────────────\n0106: MAX_RETRIES = 300                 # outer generate_input retry budget\n0107: \n0108: _NEIGHBORS8 = [(-1, -1), (-1, 0), (-1, 1), (0, -1),\n0109:                (0, 1), (1, -1), (1, 0), (1, 1)]\n0110: \n0111: \n0112: def _feasible_dims(area: int) -> list[tuple[int, int]]:\n0113:     \"\"\"Return all (h, w) bboxes where area fits with fill_ratio >= MIN_FILL_RATIO_X10/10.\"\"\"\n0114:     dims = []\n0115:     for h in range(1, BBOX_MAX + 1):\n0116:         for w in range(1, BBOX_MAX + 1):\n0117:             if area > h * w:\n0118:                 continue\n0119:             if area * 10 < MIN_FILL_RATIO_X10 * h * w:\n0120:                 continue\n0121:             if h == 1 and area != w:\n0122:                 continue\n0123:             if w == 1 and area != h:\n0124:                 continue\n0125:             if h > 1 and w > 1 and area < max(h, w):\n0126:                 continue\n0127:             dims.append((h, w))\n0128:     return dims\n0129: \n0130: \n0131: def _line_mask(h: int, w: int) -> np.ndarray:\n0132:     \"\"\"Create a seed mask along a diagonal line spanning the bbox, randomly flipped.\"\"\"\n0133:     mask = np.zeros((h, w), dtype=bool)\n0134:     if h == 1:\n0135:         mask[0, :] = True\n0136:         return mask\n0137:     if w == 1:\n0138:         mask[:, 0] = True\n0139:         return mask\n0140:     steps = max(h, w)\n0141:     for i in range(steps):\n0142:         r = int(round(i * (h - 1) / (steps - 1)))\n0143:         c = int(round(i * (w - 1) / (steps - 1)))\n0144:         mask[r, c] = True\n0145:     if bool(_RNG.integers(0, 2)):\n0146:         mask = np.flipud(mask)\n0147:     if bool(_RNG.integers(0, 2)):\n0148:         mask = np.fliplr(mask)\n0149:     return mask\n0150: \n0151: \n0152: def _make_mask(h: int, w: int, area: int) -> np.ndarray:\n0153:     \"\"\"Grow an 8-connected mask from a line seed to the target area.\"\"\"\n0154:     mask = _line_mask(h, w)\n0155:     while int(mask.sum()) < area:\n0156:         frontier = set()\n0157:         for r, c in np.argwhere(mask):\n0158:             for dr, dc in _NEIGHBORS8:\n0159:                 nr, nc = int(r) + dr, int(c) + dc\n0160:                 if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:\n0161:                     frontier.add((nr, nc))\n0162:         pick = list(frontier)\n0163:         nr, nc = pick[int(_RNG.integers(0, len(pick)))]\n0164:         mask[nr, nc] = True\n0165:     return mask\n0166: \n0167: \n0168: def _mask_to_pat(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\n0169:     \"\"\"Paint a boolean mask into a colored patch on a bg-filled array.\"\"\"\n0170:     pat = np.full(mask.shape, bg, dtype=int)\n\n0361: def generate_input() -> np.ndarray:\n0362:     for _ in range(MAX_RETRIES):\n0363:         grid = _gen_attempt()\n0364:         if grid is not None:\n0365:             return grid\n0366:     raise RuntimeError(\"failed to generate a valid 62593bfd sample\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\n0274: def main(grid: np.ndarray) -> np.ndarray:\n0275:     \"\"\"\n0276:     Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n0277: \n0278:     Input structure:\n0279:     - bg = most common color. Several hollow sprites with distinct border colors.\n0280:     - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n0281: \n0282:     Rule:\n0283:     - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n0284:     - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n0285:     - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n0286: \n0287:     Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n0288:     \"\"\"\n0289:     g = np.asarray(grid, dtype=int)\n0290:     bg = _bg_boundary(g)\n0291: \n0292:     mapping, pal_mask = _palette_mapping(g, bg)\n0293:     assert mapping, \"main: palette mapping must be non-empty\"\n0294: \n0295:     out = g.copy()\n0296:     _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n0297: \n0298:     return out\n0299: \n0300: # --------------- generator (c) ---------------\n0301: \n0302: # -- Configuration constants --------------------------------------------------\n0303: # Grid dimensions\n0304: _GRID_H_MIN, _GRID_H_MAX = 4, 13\n0305: _GRID_W_MIN, _GRID_W_MAX = 10, 15\n0306: _SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n0307: _SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n0308: _TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n0309: \n0310: # Palette\n0311: _PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n0312: \n0313: # Sprite geometry\n0314: _SPRITE_H_MAX = 7\n0315: _SPRITE_W_MAX = 6\n0316: _SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n0317: _SPRITE_CELL_MAX = 16\n0318: _FILLED_SPRITE_MAX = 3\n0319: \n0320: # Sprite mutation probabilities\n0321: _P_HORIZ_WALL = 0.3           # add horizontal internal wall\n0322: _P_VERT_WALL = 0.3            # add vertical internal wall\n0323: _P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n0324: _P_DIAMOND = 0.2              # use diamond shape for 3x3\n0325: \n0326: # Generation\n0327: _MAX_RETRIES = 300\n0328: # -- End configuration --------------------------------------------------------\n0329: \n0330: \n0331: def _get_enclosed_holes(sprite):\n0332:     \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n0333:     h, w = sprite.shape\n0334:     return [pts for pts in components_mask(~sprite, connectivity=4)\n0335:             if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n0336: \n0337: \n0338: def _make_diamond():\n0339:     \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n0340:     s = np.zeros((3, 3), dtype=bool)\n0341:     s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n0342:     return s\n0343: \n0344: \n0345: def _make_hollow_sprite(h, w, rng):\n0346:     \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n0347:     sprite = np.ones((h, w), dtype=bool)\n0348:     if h >= 3 and w >= 3:\n0349:         sprite[1:-1, 1:-1] = False\n0350:     # Optionally add internal horizontal wall\n0351:     if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n0352:         br = rng.randint(2, h - 2)\n0353:         n = rng.randint(1, w - 2)\n0354:         s = rng.randint(1, w - 1 - n + 1)\n0355:         sprite[br, s:s + n] = True\n0356:     # Optionally add internal vertical wall\n0357:     if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n0358:         bc = rng.randint(2, w - 2)\n0359:         n = rng.randint(1, h - 2)\n0360:         s = rng.randint(1, h - 1 - n + 1)\n0361:         sprite[s:s + n, bc] = True\n0362:     # Optionally remove border cells for irregularity\n0363:     if rng.random() < _P_BORDER_REMOVAL:\n0364:         bcells = [(r, c) for r in range(h) for c in range(w)\n0365:                   if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n0366:         rng.shuffle(bcells)\n0367:         for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n0368:             test = sprite.copy()\n0369:             test[cr, cc] = False\n0370:             if _get_enclosed_holes(test):\n0371:                 sprite = test\n0372:     if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n0373:         return None\n0374:     return sprite\n0375: \n0376: \n0377: def _choose_colors(rng, N, num_filled):\n0378:     \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n0379:     all_c = list(range(1, 10))\n0380:     rng.shuffle(all_c)\n0381:     border_keys = all_c[:N]\n0382:     rng.shuffle(all_c)\n0383:     fill_values = all_c[:N]\n0384:     dist_cands = [c for c in range(1, 10) if c not in border_keys]\n0385:     distractor_color = rng.choice(dist_cands)\n0386:     mapping = dict(zip(border_keys, fill_values))\n0387:     filled_keys = rng.sample(border_keys, num_filled)\n0388:     return border_keys, fill_values, distractor_color, mapping, filled_keys\n0389: \n0390: \n0391: def _build_palette(side, border_keys, fill_values):\n0392:     \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n0393:     N = len(border_keys)\n0394:     if side in ('top', 'bottom'):\n0395:         pal = np.zeros((2, N), dtype=int)\n0396:         outer, inner = (0, 1) if side == 'top' else (1, 0)\n0397:         pal[outer] = border_keys\n0398:         pal[inner] = fill_values\n0399:     else:\n0400:         pal = np.zeros((N, 2), dtype=int)\n0401:         outer, inner = (0, 1) if side == 'left' else (1, 0)\n0402:         pal[:, outer] = border_keys\n0403:         pal[:, inner] = fill_values\n0404:     return pal\n0405: \n0406: \n0407: def _place_palette(grid, occ, pal, side, rng):\n0408:     \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n0409:     H, W = grid.shape\n0410:     pal_h, pal_w = pal.shape\n0411:     if side == 'top':\n0412:         pr0, pc0 = 0, rng.randint(0, W - pal_w)\n0413:     elif side == 'bottom':\n\n0544: def generate_input():\n0545:     for _ in range(_MAX_RETRIES):\n0546:         r = _gen_attempt()\n0547:         if r is not None:\n0548:             return r\n0549:     raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/df9fd884.py\n0032: def main(grid: np.ndarray) -> np.ndarray:\n0033:     \"\"\"Move the colored object from the lower bracket lane to the upper bracket lane and drop it to the bottom edge.\n0034: \n0035:     Input structure\n0036:     - The background is the dominant color.\n0037:     - One frame color forms exactly two 4-connected bracket objects: a top-edge bracket open downward and a bottom-edge bracket open upward.\n0038:     - One other 4-connected foreground object sits in the lower bracket's interior column span.\n0039: \n0040:     Rule\n0041:     - Remove the movable object from its original cells.\n0042:     - Keep its shape and color unchanged.\n0043:     - Paste it with its bbox columns aligned to the top bracket's interior columns and with its bbox bottom aligned to the grid bottom.\n0044: \n0045:     Key insight\n0046:     - The lower bracket identifies the object's source lane; the upper bracket provides the target lane, and the final vertical placement is bottom-aligned.\n0047:     \"\"\"\n0048:     g = np.asarray(grid, dtype=int)\n0049:     height, width = g.shape\n0050:     bg = get_bg(g)\n0051: \n0052:     components_by_color = {}\n0053:     bracket_candidates = []\n0054:     for color in colors_present(g, exclude={bg}):\n0055:         components = find_components(\n0056:             g,\n0057:             bg=bg,\n0058:             colors=[color],\n0059:             connectivity=4,\n0060:             monochromatic=True,\n0061:         )\n0062:         components_by_color[color] = components\n0063:         top = [component for component in components if _is_top_bracket(component)]\n0064:         bottom = [\n0065:             component for component in components\n0066:             if _is_bottom_bracket(component, height)\n0067:         ]\n0068:         if len(components) == 2 and len(top) == 1 and len(bottom) == 1:\n0069:             bracket_candidates.append((color, top[0], bottom[0]))\n0070: \n0071:     assert len(bracket_candidates) == 1\n0072:     frame_color, top_bracket, bottom_bracket = bracket_candidates[0]\n0073: \n0074:     movers = [\n0075:         component\n0076:         for color, components in components_by_color.items()\n0077:         if color != frame_color\n0078:         for component in components\n0079:     ]\n0080:     assert len(movers) == 1\n0081:     mover = movers[0]\n0082: \n0083:     _, mc0, _, mc1 = mover[\"bbox\"]\n0084:     _br0, bc0, _br1, bc1 = bottom_bracket[\"bbox\"]\n0085:     _tr0, tc0, _tr1, tc1 = top_bracket[\"bbox\"]\n0086:     assert (mc0, mc1) == (bc0 + 1, bc1 - 1)\n0087:     assert bbox_w(mover[\"bbox\"]) == tc1 - tc0 - 1\n0088: \n0089:     patch = crop_bbox(g, mover[\"bbox\"])\n0090:     dest_r = height - patch.shape[0]\n0091:     dest_c = tc0 + 1\n0092:     assert dest_r >= 0\n0093:     assert dest_c >= 0 and dest_c + patch.shape[1] <= width\n0094: \n0095:     out = g.copy()\n0096:     mover_coords = mover[\"coords\"]\n0097:     out[mover_coords[:, 0], mover_coords[:, 1]] = bg\n0098: \n0099:     colored_patch = patch != bg\n0100:     target = out[dest_r:dest_r + patch.shape[0], dest_c:dest_c + patch.shape[1]]\n0101:     assert np.all(target[colored_patch] == bg)\n0102: \n0103:     paste(out, patch, dest_r, dest_c, transparent=bg)\n0104:     return out\n0105: \n0106: # --------------- generator (o5x) ---------------\n0107: \n0108: # Fixed task colors.\n0109: BG_COLOR, BRACKET_COLOR = 7, 4\n0110: MOVER_COLORS = [0, 1, 2, 3, 5, 6, 8, 9]\n0111: # Canvas, bracket, and mover-size bounds.\n0112: GRID_SIZE_RANGE = (8, 9)\n0113: BRACKET_WIDTH_RANGE = (3, 4)\n0114: MOVER_HEIGHT_RANGE = (1, 3)\n0115: MOVER_MAX_CELLS = 4\n0116: MOVER_MIN_DENSITY_NUM = 2\n0117: MOVER_MIN_DENSITY_DEN = 3\n0118: # Layout choices and retry budget.\n0119: TOP_LEFT_OPTIONS = [True, False]\n0120: MAX_GENERATION_ATTEMPTS = 300\n0121: \n0122: def _gen_half_starts(grid_width, bracket_width, left_side):\n0123:     if left_side:\n0124:         return list(range(0, grid_width // 2 - bracket_width + 1))\n0125:     return list(range((grid_width + 1) // 2, grid_width - bracket_width + 1))\n0126: \n0127: def _gen_bracket_columns(grid_width, bracket_width):\n0128:     \"\"\"Choose non-overlapping top/bottom bracket starts on opposite halves.\"\"\"\n0129:     top_left = random.choice(TOP_LEFT_OPTIONS)\n0130:     top_starts = _gen_half_starts(grid_width, bracket_width, top_left)\n0131:     bottom_starts = _gen_half_starts(grid_width, bracket_width, not top_left)\n0132:     if not top_starts or not bottom_starts:\n0133:         return None\n0134:     return random.choice(top_starts), random.choice(bottom_starts)\n0135: \n0136: def _gen_add_bracket(grid, c0, width, top_edge):\n0137:     edge_row, arm_row = (0, 1) if top_edge else (-1, -2)\n0138:     grid[edge_row, c0:c0 + width] = BRACKET_COLOR\n0139:     grid[arm_row, c0] = BRACKET_COLOR\n0140:     grid[arm_row, c0 + width - 1] = BRACKET_COLOR\n0141: \n0142: def _gen_sprite_masks(height, width):\n0143:     area = height * width\n0144:     min_cells = (MOVER_MIN_DENSITY_NUM * area + MOVER_MIN_DENSITY_DEN - 1) // MOVER_MIN_DENSITY_DEN\n0145:     max_cells = min(MOVER_MAX_CELLS, area)\n0146:     masks = []\n0147:     for cell_count in range(min_cells, max_cells + 1):\n0148:         for cells in itertools.combinations(range(area), cell_count):\n0149:             mask = np.zeros((height, width), dtype=bool)\n0150:             mask[np.unravel_index(cells, (height, width))] = True\n0151:             if not mask.any(axis=0).all() or not mask.any(axis=1).all():\n0152:                 continue\n0153:             if is_contiguous(mask.astype(int), background=0, connectivity=4):\n0154:                 masks.append(mask)\n0155:     return masks\n0156: \n0157: def _gen_mover_sprite(height, width, color, bg):\n0158:     masks = _gen_sprite_masks(height, width)\n0159:     if not masks:\n0160:         return None\n0161:     mask = random.choice(masks)\n0162:     sprite = np.full((height, width), bg, dtype=int)\n0163:     sprite[mask] = color\n0164:     return sprite\n0165: \n0166: def _gen_paste_if_clear(grid, sprite, row, col, sprite_mask):\n0167:     \"\"\"Paste sprite only when every colored sprite cell lands on background.\"\"\"\n0168:     target = grid[row:row + sprite.shape[0], col:col + sprite.shape[1]]\n0169:     if not np.all(target[sprite_mask] == BG_COLOR):\n0170:         return False\n0171:     paste(grid, sprite, row, col, transparent=BG_COLOR)\n\n0217: def generate_input():\n0218:     for _ in range(MAX_GENERATION_ATTEMPTS):\n0219:         grid = _gen_attempt()\n0220:         if grid is not None:\n0221:             return grid\n0222:     raise RuntimeError(\"failed to generate df9fd884 input\")\n\n","exit_code":0,"status":"completed"}}
