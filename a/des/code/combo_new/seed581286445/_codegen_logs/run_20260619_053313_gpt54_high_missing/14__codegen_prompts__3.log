h bar is perpendicular to the edge it touches; its inner (terminal) endpoint has an attached irregular segment.\n0237:     - The segment detaches and re-routes: it travels from the terminal toward the nearest obstacle, hugs the obstacle's boundary, then exits at a 45° diagonal.\n0238:     - Total painted pixels equal the original segment length.\n0239: \n0240:     Key insight: The segment behaves like a rope swung around the obstacle — attach at the nearest point, trace the skin, exit diagonally, conserving length.\n0241:     \"\"\"\n0242:     g = np.asarray(grid, dtype=int)\n0243:     h, w = g.shape\n0244:     bg = get_bg(g)\n0245: \n0246:     colors = sorted(set(int(v) for v in np.unique(g)) - {bg})\n0247: \n0248:     out = g.copy()\n0249: \n0250:     def bar_candidates():\n0251:         # Yield (bar_color, bar_component, terminal_endpoint).\n0252:         for col in colors:\n0253:             for comp in _components(g, col, conn8=False):\n0254:                 if len(comp) < 2 or not _is_straight_line(comp):\n0255:                     continue\n0256:                 e0, e1 = _bar_endpoints(comp)\n0257:                 touch0 = _touches_border(e0, h, w)\n0258:                 touch1 = _touches_border(e1, h, w)\n0259:                 if touch0 == touch1:\n0260:                     continue  # require exactly one endpoint on border\n0261:                 # Orientation must be perpendicular to the edge it touches.\n0262:                 rs = [r for r, _ in comp]\n0263:                 cs = [c for _, c in comp]\n0264:                 vertical = len(set(cs)) == 1\n0265:                 border_ep = e0 if touch0 else e1\n0266:                 if vertical:\n0267:                     if border_ep[0] not in (0, h - 1):\n0268:                         continue\n0269:                 else:\n0270:                     if border_ep[1] not in (0, w - 1):\n0271:                         continue\n0272:                 terminal_ep = e1 if touch0 else e0\n0273:                 # Must have an attached non-bg neighbor at terminal.\n0274:                 tr, tc = terminal_ep\n0275:                 if not any(\n0276:                     0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) != bg and int(g[nr, nc]) != col\n0277:                     for nr, nc in neighbors4(tr, tc)\n0278:                 ):\n0279:                     continue\n0280:                 yield col, comp, terminal_ep\n0281: \n0282:     # Process all valid bars; compute moves based on the original grid.\n0283:     moves = []  # list of (seg_comp_pts, seg_color, new_pts)\n0284:     for bar_col, bar_comp, terminal in sorted(list(bar_candidates()), key=lambda x: (-len(x[1]), x[0], x[2])):\n0285:         # Segment neighbor candidates at terminal.\n0286:         neigh = []\n0287:         for nr, nc in neighbors4(terminal[0], terminal[1]):\n0288:             if 0 <= nr < h and 0 <= nc < w:\n0289:                 v = int(g[nr, nc])\n0290:                 if v != bg and v != bar_col:\n0291:                     neigh.append((v, (nr, nc)))\n0292:         assert neigh, f\"bar terminal {terminal} must have a non-bg/non-bar neighbor\"\n0293: \n0294:         # Choose a segment that behaves like a 1-cell-thick stroke attached at an endpoint.\n0295:         best_seg = None  # (L, comp_size, seg_col, seg_start, seg_comp)\n0296:         for cand_col, cand_start in neigh:\n0297:             for comp in _components(g, cand_col, conn8=True):\n0298:                 if cand_start in comp:\n0299:                     if len(comp) < 2:\n0300:                         break\n0301:                     deg = _segment_degrees(comp)\n0302:                     if deg.get(cand_start, 0) != 1:\n0303:                         break\n0304:                     path = _segment_main_path(comp, cand_start)\n0305:                     L = len(path)\n0306:                     key = (L, len(comp), cand_col, cand_start[0], cand_start[1])\n0307:                     if best_seg is None or key > best_seg[0]:\n0308:                 