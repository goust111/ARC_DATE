"\"\n 395:     H, W = canvas.shape\n 396:     radius = _ISOLATION_RADIUS\n 397:     r0, r1 = max(0, r - radius), min(H, r + radius + 1)\n 398:     c0, c1 = max(0, c - radius), min(W, c + radius + 1)\n 399:     return not bool((canvas[r0:r1, c0:c1] != int(bg)).any())\n 400: \n 401: \n 402: def _anchor_candidates(canvas, bg):\n 403:     H, W = canvas.shape\n 404:     rows = list(range(_ANCHOR_EDGE_MARGIN, H - _ANCHOR_EDGE_MARGIN))\n 405:     rows = rows or list(range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP))\n 406:     cols = list(range(_ANCHOR_EDGE_MARGIN, W - _ANCHOR_EDGE_MARGIN))\n 407:     cols = cols or list(range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP))\n 408:     out = []\n 409:     for c in cols:\n 410:         out.append((\"h\", 0, c))\n 411:         out.append((\"h\", H - 1, c))\n 412:     for r in rows:\n 413:         out.append((\"v\", r, 0))\n 414:         out.append((\"v\", r, W - 1))\n 415:     random.shuffle(out)\n 416:     return [(axis, r, c) for axis, r, c in out if _anchor_ok(canvas, r, c, bg)]\n 417: \n 418: \n 419: def _put_anchor(canvas, r, c, color):\n 420:     paste(canvas, np.array([[int(color)]], dtype=int), int(r), int(c))\n 421: \n 422: \n 423: def _aligned_positions(canvas, sprite, anchor, bg):\n 424:     H, W = canvas.shape\n 425:     if anchor[\"axis\"] == \"h\":\n 426:         return [\n 427:             (r, anchor[\"c\"])\n 428:             for r in range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP)\n 429:             if _can_place(canvas, sprite, r, anchor[\"c\"], bg)\n 430:         ]\n 431:     return [\n 432:         (anchor[\"r\"], c)\n 433:         for c in range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP)\n 434:         if _can_place(canvas, sprite, anchor[\"r\"], c, bg)\n 435:     ]\n 436: \n 437: \n 438: def _scatter_positions(canvas, sprite, anchor, marker, bg):\n 439:     H, W = canvas.shape\n 440:     mr, mc = marker\n 441:     if anchor[\"axis\"] == \"h\":\n 442:         return [\n 443:             (mr, c)\n 444:            