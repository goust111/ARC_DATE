12:         fh, fw = ch + 2, cw + 2\n 313:         offsets = _halo_offsets(fh, fw)\n 314:         rng.shuffle(offsets)\n 315:         for dr, dc in offsets:\n 316:             r0 = lp[0] - dr\n 317:             c0 = lp[1] - dc\n 318:             if r0 < pad or c0 < pad or r0 + fh > h - pad or c0 + fw > w - pad:\n 319:                 continue\n 320:             ring, cavity = _frame_ring_coords(r0, c0, ch, cw)\n 321:             if not _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n 322:                 continue\n 323:             for rr, cc in ring:\n 324:                 canvas[rr, cc] = frame_col\n 325:             return ring, cavity\n 326:     return None\n 327: \n 328: \n 329: def _try_attach_distractor_frame(canvas, frame_col, rng, max_tries=DISTRACTOR_FRAME_TRIES):\n 330:     \"\"\"Place a loop in empty space, not touching any non-bg pixel.\"\"\"\n 331:     h, w = canvas.shape\n 332:     for _ in range(max_tries):\n 333:         ch = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\n 334:         cw = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\n 335:         fh, fw = ch + 2, cw + 2\n 336:         r0 = rng.randint(1, h - fh - 1)\n 337:         c0 = rng.randint(1, w - fw - 1)\n 338:         # Check the full bbox + 1-cell margin is empty\n 339:         ok = True\n 340:         for rr in range(r0 - 1, r0 + fh + 1):\n 341:             for cc in range(c0 - 1, c0 + fw + 1):\n 342:                 if _in_bounds(h, w, rr, cc) and canvas[rr, cc] != -1:\n 343:                     ok = False\n 344:                     break\n 345:             if not ok:\n 346:                 break\n 347:         if not ok:\n 348:             continue\n 349:         ring, _ = _frame_ring_coords(r0, c0, ch, cw)\n 350:         for rr, cc in ring:\n 351:             canvas[rr, cc] = frame_col\n 352:         return True\n 353:     return None\n 354: \n 355: \n 356: def _try_place_distractor_network(canvas, line_col, frame_colors_pool, rng):\n 357:     \"\"\"Place a disconnected line+frame distractor (no seed).\"\"\"\n 358:     h, w = canvas.shape\n 359:     for _ in range(DISTRACTOR_NETWORK_TRIES):\n 360:         r = rng.randint(2, h - 3)\n 361:         c = rng.randint(2, w - 3)\n 362:         if any(canvas[r + dr, c + dc] != -1 for dr in range(-1, 2) for dc in range(-1, 2)):\n 363:             continue\n 364:         canvas[r, c] = line_col\n 365:         target_len = rng.randint(*DISTRACTOR_LINE_LEN)\n 366:         path = _grow_line(canvas, (r, c), line_col, target_len, rng)\n 367:         if len(path) < 3:\n 368:             for pr, pc in path:\n 369:                 canvas[pr, pc] = -1\n 370:             continue\n 371:         attached = 0\n 372:         for _ in range(rng.randint(*DISTRACTOR_NETWORK_FRAMES)):\n 373:             fc = rng.choice(frame_colors_pool)\n 374:             if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\n 375:                 attached += 1\n 376:         if attached > 0:\n 377:             return True\n 378:         for pr, pc in path:\n 379:             canvas[pr, pc] = -1\n 380:     return False\n 381: \n 382: \n 383: # ---------------------------------------------------------------------------\n 384: # Main generator\n 385: # ---------------------------------------------------------------------------\n 386: \n 387: def _corner_config(corner_kind, h, w, rng):\n 388:     \"\"\"Return (seed_rc, first_line_rc) for corner_kind in {TL,TR,BL,BR}.\"\"\"\n 389:     if corner_kind == 'TL':\n 390:         seed = (0, 0)\n 391:         first = rng.choice([(0, 1), (1, 0)])\n 392:     elif corner_kind == 'TR':\n 393:         seed = (0, w - 1)\n 394:         first = rng.choice([(0, w - 2), (1, w - 1)])\n 395:     elif corner_kind == 'BL':\n 396:         seed = (h - 1, 0)\n 397:         first = rng.choice([(h - 1, 1), (h - 2, 0)])\n 398:     elif corner_kind == 'BR':\n 399:         seed = (h - 1, w - 1)\n 400:         first = rng.choice([(h - 1, w - 2), (h - 2, w - 1)])\n 401:     else:\n 402:         raise ValueError(corner_kind)\n 403:     return seed, first\n 404: \n 405: \n 406: def _distribute_loop_budget(num_seeds, num_attached_target, rng):\n 407:     \"\"\"Distribute attached-loop budget across seeds, guaranteeing >= 1 each.\"\"\"\n 408:     seed_order = list(range(num_seeds))\n 409:     rng.shuffle(seed_order)\n 410:     per_seed = [0] * num_seeds\n 411:     remaining = num_attached_target\n 412:     # Guarantee at least 1 per seed\n 413:     while remaining > 0 and any(per_seed[i] == 0 for i in range(num_seeds)):\n 414:         for i in seed_order:\n 415:             if per_seed[i] == 0 and remaining > 0:\n 416:                 per_seed[i] += 1\n 417:                 remaining -= 1\n 418:     # Distribute remainder randomly\n 419:     while remaining > 0:\n 420:         per_seed[rng.choice(seed_order)] += 1\n 421:         remaining -= 1\n 422:     return per_seed\n 423: \n 424: \n 425: def _gen_attempt(rng: random.Random) -> np.ndarray | None:\n 426:     h = rng.randint(*GRID_H_RANGE)\n 427:     w = rng.randint(*GRID_W_RANGE)\n 428:     bg = rng.choice(BG_COLORS)\n 429:     palette = [c for c in range(10) if c != bg]\n 430:     rng.shuffle(palette)\n 431: \n 432:     num_seeds = rng.choice(SEED_COUNT_WEIGHTS)\n 433:     if num_seeds * 2 > len(palette):\n 434:         return None\n 435: \n 436:     canvas = -np.ones((h, w), dtype=int)\n 437: \n 438:     seed_colors = [palette.pop() for _ in range(num_seeds)]\n 439:     line_colors = [palette.pop() for _ in range(num_seeds)]\n 440: \n 441:     all_corners = ['TL', 'TR', 'BL', 'BR']\n 442:     rng.shuffle(all_corners)\n 443:     corners_used = all_corners[:num_seeds]\n 444: \n 445:     num_frame_cols = rng.randint(1, min(FRAME_COLORS_MAX, len(palette)))\n 446:     frame_colors_pool = [palette.pop() for _ in range(num_frame_cols)]\n 447: \n 448:     # Grow seed lines\n 449:     lines_info = []\n 450:     for i in range(num_seeds):\n 451:         seed_rc, first_rc = _corner_config(corners_used[i], h, w, rng)\n 452:         if canvas[seed_rc] != -1 or canvas[first_rc] != -1:\n 453:             return None\n 454:         canvas[seed_rc] = seed_colors[i]\n 455:         canvas[first_rc] = line_colors[i]\n 456:         target_len = rng.randint(LINE_LEN_RANGE[0], min(LINE_LEN_RANGE[1], h + w))\n 457:         path = _grow_line(canvas, first_rc, line_colors[i], target_len, rng)\n 458:         if len(path) < MIN_LINE_LEN:\n 459:             return None\n 460:         lines_info.append((seed_colors[i], seed_rc, line_colors[i], path))\n 461: \n 462:     # Decide loop counts and distribute across seeds\n 463:     total_loops_target = rng.randint(num_seeds, TOTAL_LOOPS_MAX)\n 464:     num_distractors_target = rng.randint(0, max(0, total_loops_target - num_seeds))\n 465:     num_attached_target = total_loops_target - num_distractors_target\n 466:     per_seed = _distribute_loop_budget(num_seeds, num_attached_target, rng)\n 467: \n 468:     # Attach frames to each seed's line\n 469:     for i, (_, _, line_col, path) in enumerate(lines_info):\n 470:         attached = 0\n 471:         for _ in range(per_seed[i]):\n 472:             fc = rng.choice(frame_colors_pool)\n 473:             if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\n 474:                 attached += 1\n 475:         if attached == 0:\n 476:             return None\n 477: \n 478:     # Place distractors\n 479:     if rng.random() < DISTRACTOR_NETWORK_PROB:\n 480:         _try_place_distractor_network(canvas, rng.choice(line_colors), frame_colors_pool, rng)\n 481:     else:\n 482:         for _ in range(rng.randint(0, DISTRACTOR_SOLO_MAX)):\n 483:             _try_attach_distractor_frame(canvas, rng.choice(frame_colors_pool), rng)\n 484: \n 485:     # Finalize grid\n 486:     grid = np.where(canvas == -1, bg, canvas).astype(int)\n 487: \n 488:     # Validate bg is most common color\n 489:     vals, cnts = np.unique(grid, return_counts=True)\n 490:     if int(vals[np.argmax(cnts)]) != bg:\n 491:         return None\n 492: \n 493:     # Validate each seed color appears exactly once\n 494:     for seed_col, _, _, _ in lines_info:\n 495:         if int((grid == seed_col).sum()) != 1:\n 496:             return None\n 497: \n 498:     # Oracle check: solver must change at least one cell\n 499:     try:\n 500:         out = main(grid)\n 501:     except Exception:\n 502:         return None\n 503:     if np.array_equal(out, grid):\n 504:         return None\n 505:     return grid\n 506: \n 507: \n\n===== /home/lixinyu/snap/new/ARC_code/train/8886d717.py =====\n--- 276:329 ---\n 276: def _gen_attempt() -> np.ndarray | None:\n 277:     n = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n 278:     edge = random.choice(EDGES)\n 279:     colors = tuple(random.sample(COLOR_POOL, 4))\n 280:     bg, edge_color, main_color, marker_color = colors\n 281:     dr, dc = _edge_direction(edge)\n 282: \n 283:     size_bounds = _blob_size_bounds(n)\n 284:     if size_bounds is None:\n 285:         return None\n 286: \n 287:     blob = _grow_blob(n, edge, random.randint(*size_bounds))\n 288:     if blob is None:\n 289:         return None\n 290: \n 291:     embedded_sites = _choose_embedded_sites(n, blob)\n 292:     if embedded_sites is None:\n 293:         return None\n 294: \n 295:     out = np.full((n, n), bg, dtype=int)\n 296:     _paint_edge(out, edge, edge_color)\n 297:     for r, c in blob:\n 298:         out[r, c] = main_color\n 299: \n 300:     pairs = _choose_isolated_pairs(out, blob, bg, dr, dc, len(embedded_sites))\n 301:     if pairs is None:\n 302:         return None\n 303: \n 304:     for (r, c), (tr, tc) in pairs:\n 305:         out[r, c] = marker_color\n 306:         out[tr, tc] = marker_color\n 307: \n 308:     inp = out.copy()\n 309:     for r, c in embedded_sites:\n 310:         inp[r, c] = marker_color\n 311:     for _marker, (tr, tc) in pairs:\n 312:         inp[tr, tc] = bg\n 313: \n 314:     if (inp == bg).sum() <= max(\n 315:         (inp == edge_color).sum(),\n 316:         (inp == main_color).sum(),\n 317:         (inp == marker_color).sum(),\n 318:     ):\n 319:         return None\n 320: \n 321:     try:\n 322:         solved = main(inp)\n 323:     except Exception:\n 324:         return None\n 325:     if np.array_equal(solved, out):\n 326:         return inp\n 327:     return None\n 328: \n 329: \n\n===== /home/lixinyu/snap/new/ARC_code/train/9f669b64.py =====\n--- 141:250 ---\n 141: def _gen_transform(grid: np.ndarray, orientation: int) -> np.ndarray:\n 142:     if orientation == 0:\n 143:         return grid.copy()\n 144:     if orientation == 1:\n 145:         return np.flipud(grid).copy()\n 146:     if orientation == 2:\n 147:         return np.rot90(grid, 1).copy()\n 148:     return np.rot90(grid, -1).copy()\n 149: \n 150: \n 151: def _gen_even_centered_start(center_left: int, width: int) -> int:\n 152:     return center_left - (width // 2 - 1)\n 153: \n 154: \n 155: def _gen_stair_patch(h: int, w: int, color: int, bg: int) -> np.ndarray:\n 156:     patch = np.full((h, w), bg, dtype=int)\n 157:     max_extra = w // 2 - 1\n 158:     thresholds = sorted(random.randint(1, h - 1) for _ in range(max_extra))\n 159:     for r in range(h):\n 160:         extra = sum(r >= threshold for threshold in thresholds)\n 161:         c0 = w // 2 - 1 - extra\n 162:         c1 = w // 2 + extra\n 163:         patch[r, c0 : c1 + 1] = color\n 164:     return patch\n 165: \n 166: \n 167: def _gen_place_other(grid: np.ndarray, r0: int, center_left: int, color: int, bg: int) -> None:\n 168:     h = grid.shape[0] - r0\n 169:     in_bounds_widths = [\n 170:         w\n 171:         for w in GEN_OTHER_WIDTH_CHOICES\n 172:         if 0 <= _gen_even_centered_start(center_left, w)\n 173:         and _gen_even_centered_start(center_left, w) + w <= grid.shape[1]\n 174:     ]\n 175:     solid_widths = [w for w in in_bounds_widths if w <= h]\n 176:     stair_widths = [w for w in in_bounds_widths if w >= GEN_OTHER_MIN_STAIR_WIDTH and h >= GEN_OTHER_MIN_STAIR_HEIGHT]\n 177: \n 178:     kinds = []\n 179:     if solid_widths:\n 180:         kinds.append(\"solid\")\n 181:     if stair_widths:\n 182:         kinds.append(\"stair\")\n 183:     kind = random.choice(kinds)\n 184: \n 185:     if kind == \"solid\":\n 186:         w = random.choice(solid_widths)\n 187:         patch = np.full((h, w), color, dtype=int)\n 188:     else:\n 189:         w = random.choice(stair_widths)\n 190:         patch = _gen_stair_patch(h, w, color, bg)\n 191:     paste(grid, patch, r0, _gen_even_centered_start(center_left, w), transparent=bg)\n 192: \n 193: \n 194: def _gen_choose_layout() -> tuple[int, int, int, int, int, int] | None:\n 195:     s_h = random.choice(GEN_SOURCE_ALONG_CHOICES)\n 196:     t_h = random.randint(GEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX)\n 197:     overhangs = [k for k in GEN_TARGET_OVERHANG_CHOICES if 2 * k + GEN_SOURCE_PERP > t_h]\n 198:     k = random.choice(overhangs)\n 199:     gap_options = [g for g in GEN_SOURCE_TARGET_GAP_RANGE if t_h + g + s_h <= GEN_GRID_SIZE - GEN_SOURCE_PERP]\n 200:     if not gap_options:\n 201:         return None\n 202:     gap = random.choice(gap_options)\n 203:     t0_max = GEN_GRID_SIZE - GEN_SOURCE_PERP - t_h - gap - s_h\n 204:     t0 = random.randint(0, t0_max)\n 205:     center_left = random.randint(k + 1, GEN_GRID_SIZE - k - 3)\n 206:     return s_h, t_h, k, gap, t0, center_left\n 207: \n 208: \n 209: def _gen_canonical_pair(s_h: int, t_h: int, k: int, gap: int, t0: int, center_left: int, colors: list[int]) -> tuple[np.ndarray, np.ndarray]:\n 210:     source_color, target_color, other_color = colors\n 211:     source_patch = np.full((s_h, GEN_SOURCE_PERP), source_color, dtype=int)\n 212:     target_patch = np.full((t_h, 2 * k + GEN_SOURCE_PERP), target_color, dtype=int)\n 213:     split_half = np.full((t_h, k + 1), target_color, dtype=int)\n 214: \n 215:     out = np.full((GEN_GRID_SIZE, GEN_GRID_SIZE), GEN_BG, dtype=int)\n 216:     paste(out, source_patch, 0, center_left)\n 217:     paste(out, split_half, t0, center_left - k - 1)\n 218:     paste(out, split_half, t0, center_left + GEN_SOURCE_PERP)\n 219: \n 220:     source_in_r = t0 + t_h + gap\n 221:     other_r = source_in_r + s_h\n 222:     _gen_place_other(out, other_r, center_left, other_color, GEN_BG)\n 223: \n 224:     inp = out.copy()\n 225:     inp[0:s_h, center_left : center_left + GEN_SOURCE_PERP] = GEN_BG\n 226:     inp[t0 : t0 + t_h, center_left - k - 1 : center_left] = GEN_BG\n 227:     inp[t0 : t0 + t_h, center_left + GEN_SOURCE_PERP : center_left + k + 3] = GEN_BG\n 228:     paste(inp, target_patch, t0, center_left - k)\n 229:     paste(inp, source_patch, source_in_r, center_left)\n 230:     return inp, out\n 231: \n 232: \n 233: def _gen_attempt() -> np.ndarray | None:\n 234:     colors = random.sample(GEN_FG_COLORS, 3)\n 235:     layout = _gen_choose_layout()\n 236:     if layout is None:\n 237:         return None\n 238:     inp, out = _gen_canonical_pair(*layout, colors)\n 239: \n 240:     orientation = random.randrange(GEN_ORIENTATION_COUNT)\n 241:     inp = _gen_transform(inp, orientation)\n 242:     out = _gen_transform(out, orientation)\n 243:     try:\n 244:         if np.array_equal(main(inp), out):\n 245:             return inp\n 246:     except AssertionError:\n 247:         return None\n 248:     return None\n 249: \n 250: \n\n===== /home/lixinyu/snap/new/ARC_code/train/d93c6891.py =====\n--- 177:396 ---\n 177: def _place_orange(edge, cr0, cc0, cr1, cc1, occupied):\n 178:     \"\"\"Try to place an orange rect flush against the given edge. Returns (or0,oc0,or1,oc1) or None.\"\"\"\n 179:     for _ in range(ORANGE_PLACE_RETRIES):\n 180:         oh = random.randint(*ORANGE_H_RANGE)\n 181:         ow = random.randint(*ORANGE_W_RANGE)\n 182:         if not (ORANGE_AREA_RANGE[0] <= oh * ow <= ORANGE_AREA_RANGE[1]):\n 183:             continue\n 184:         if edge in HORIZONTAL_EDGES:\n 185:             or0 = cr0 if edge == 'top' else cr1 - oh + 1\n 186:             or1 = or0 + oh - 1\n 187:             lo, hi = cc0 + 1, cc1 - ow  # avoid touching perpendicular edges\n 188:         else:\n 189:             oc0 = cc0 if edge == 'left' else cc1 - ow + 1\n 190:             oc1 = oc0 + ow - 1\n 191:             lo, hi = cr0 + 1, cr1 - oh  # avoid touching perpendicular edges\n 192:         if hi < lo:\n 193:             continue\n 194:         v = random.randint(lo, hi)\n 195:         if edge in HORIZONTAL_EDGES:\n 196:             oc0, oc1 = v, v + ow - 1\n 197:         else:\n 198:             or0, or1 = v, v + oh - 1\n 199:         if or0 < cr0 or or1 > cr1 or oc0 < cc0 or oc1 > cc1:\n 200:             continue\n 201:         if occupied[or0:or1+1, oc0:oc1+1].any():\n 202:             continue\n 203:         return (or0, oc0, or1, oc1)\n 204:     return None\n 205: \n 206: \n 207: def _make_canvas() -> tuple[np.ndarray, tuple[int, int, int, int]] | None:\n 208:     content_h = random.randint(*CONTENT_H_RANGE)\n 209:     content_w = random.randint(*CONTENT_W_RANGE)\n 210:     border_top = random.randint(*BORDER_RANGE)\n 211:     border_bottom = random.randint(*BORDER_RANGE)\n 212:     border_left = random.randint(*BORDER_RANGE)\n 213:     border_right = random.randint(*BORDER_RANGE)\n 214:     grid_h = content_h + border_top + border_bottom\n 215:     grid_w = content_w + border_left + border_right\n 216:     if not (GRID_H_RANGE[0] <= grid_h <= GRID_H_RANGE[1] and GRID_W_RANGE[0] <= grid_w <= GRID_W_RANGE[1]):\n 217:         return None\n 218: \n 219:     grid = np.full((grid_h, grid_w), Color.BLACK, dtype=int)\n 220:     cr0, cc0 = border_top, border_left\n 221:     cr1, cc1 = cr0 + content_h - 1, cc0 + content_w - 1\n 222:     grid[cr0:cr1+1, cc0:cc1+1] = Color.YELLOW\n 223:     return grid, (cr0, cc0, cr1, cc1)\n 224: \n 225: \n 226: def _place_oranges(content_box, occupied) -> list[tuple[str, int, int, int, int]] | None:\n 227:     cr0, cc0, cr1, cc1 = content_box\n 228:     num_orange = random.choices(ORANGE_COUNT_CHOICES, weights=ORANGE_COUNT_WEIGHTS)[0]\n 229:     edges = random.sample(EDGES, num_orange)\n 230:     orange_rects = []\n 231:     for edge in edges:\n 232:         result = _place_orange(edge, cr0, cc0, cr1, cc1, occupied)\n 233:         if result is None:\n 234:             return None\n 235:         or0, oc0, or1, oc1 = result\n 236:         occupied[or0:or1+1, oc0:oc1+1] = True\n 237:         orange_rects.append((edge, or0, oc0, or1, oc1))\n 238:     return orange_rects\n 239: \n 240: \n 241: def _choose_touched_oranges(num_orange):\n 242:     max_untouched = min(MAX_UNTOUCHED_ORANGES, num_orange - 1)\n 243:     num_untouched = random.randint(0, max_untouched) if num_orange > 1 else 0\n 244:     indices = list(range(num_orange))\n 245:     random.shuffle(indices)\n 246:     untouched_set = set(indices[:num_untouched])\n 247:     return [i for i in range(num_orange) if i not in untouched_set]\n 248: \n 249: \n 250: def _choose_bars_per_orange(touched_list):\n 251:     for _ in range(BAR_COUNT_RETRIES):\n 252:         bpo = [random.randint(*BARS_PER_ORANGE_RANGE) for _ in touched_list]\n 253:         if TOTAL_BARS_RANGE[0] <= sum(bpo) <= TOTAL_BARS_RANGE[1]:\n 254:             return bpo\n 255:     return None\n 256: \n 257: \n 258: def _split_bar_lengths(total_gray, n_bars):\n 259:     min_len, max_len = BAR_LENGTH_RANGE\n 260:     if n_bars == 2 and total_gray >= 2:\n 261:         lo_b1 = max(min_len, total_gray - max_len)\n 262:         hi_b1 = min(total_gray - min_len, max_len)\n 263:         if lo_b1 > hi_b1:\n 264:             return None\n 265:         b1 = random.randint(lo_b1, hi_b1)\n 266:         return [b1, total_gray - b1]\n 267:     if total_gray > max_len:\n 268:         return None\n 269:     return [total_gray]\n 270: \n 271: \n 272: def _place_bars(axis, fixed, span0, span1, lo_bound, hi_bound, bar_lengths, occupied):\n 273:     placed_bars = []\n 274:     for bl in bar_lengths:\n 275:         sides = []\n 276:         if span0 - lo_bound >= bl:\n 277:             sides.append(0)\n 278:         if hi_bound - span1 >= bl:\n 279:             sides.append(1)\n 280:         random.shuffle(sides)\n 281:         placed = False\n 282:         for s in sides:\n 283:             b0 = (span0 - bl) if s == 0 else (span1 + 1)\n 284:             b1 = b0 + bl - 1\n 285:             cells = occupied[fixed, b0:b1+1] if axis == 'h' else occupied[b0:b1+1, fixed]\n 286:             if b0 < lo_bound or b1 > hi_bound or cells.any():\n 287:                 continue\n 288:             if axis == 'h':\n 289:                 occupied[fixed, b0:b1+1] = True\n 290:                 placed_bars.append(('h', fixed, b0, b1))\n 291:             else:\n 292:                 occupied[b0:b1+1, fixed] = True\n 293:                 placed_bars.append(('v', b0, b1, fixed))\n 294:             placed = True\n 295:             break\n 296:         if not placed:\n 297:             return None\n 298:     return placed_bars\n 299: \n 300: \n 301: def _plan_bars(orange_rects, touched_list, bpo, content_box, occupied):\n 302:     \"\"\"Sample gray bars and return oracle metadata for expected output.\"\"\"\n 303:     cr0, cc0, cr1, cc1 = content_box\n 304:     bars_info = []\n 305:     for idx, oi in enumerate(touched_list):\n 306:         edge, or0, oc0, or1, oc1 = orange_rects[oi]\n 307:         oh, ow = or1 - or0 + 1, oc1 - oc0 + 1\n 308:         n_bars = bpo[idx]\n 309: \n 310:         if edge in HORIZONTAL_EDGES:\n 311:             max_stripes, divisor = oh, ow\n 312:         else:\n 313:             max_stripes, divisor = ow, oh\n 314: \n 315:         stripe_count = random.randint(1, max_stripes)\n 316:         total_gray = stripe_count * divisor\n 317:         bar_lengths = _split_bar_lengths(total_gray, n_bars)\n 318:         if bar_lengths is None:\n 319:             return None\n 320: \n 321:         if edge == 'top':\n 322:             bar_rc = or0\n 323:         elif edge == 'bottom':\n 324:             bar_rc = or1\n 325:         elif edge == 'left':\n 326:             bar_rc = oc0\n 327:         else:\n 328:             bar_rc = oc1\n 329:         if edge in HORIZONTAL_EDGES:\n 330:             placed_bars = _place_bars('h', bar_rc, oc0, oc1, cc0, cc1, bar_lengths, occupied)\n 331:         else:\n 332:             placed_bars = _place_bars('v', bar_rc, or0, or1, cr0, cr1, bar_lengths, occupied)\n 333:         if placed_bars is None:\n 334:             return None\n 335: \n 336:         bars_info.append((oi, placed_bars, edge, stripe_count))\n 337:     return bars_info\n 338: \n 339: \n 340: def _render_input_grid(grid, orange_rects, bars_info):\n 341:     for _, or0, oc0, or1, oc1 in orange_rects:\n 342:         grid[or0:or1+1, oc0:oc1+1] = Color.ORANGE\n 343:     for _, bars, _, _ in bars_info:\n 344:         for bar in bars:\n 345:             if bar[0] == 'h':\n 346:                 grid[bar[1], bar[2]:bar[3]+1] = Color.GRAY\n 347:             else:\n 348:                 grid[bar[1]:bar[2]+1, bar[3]] = Color.GRAY\n 349: \n 350: \n 351: def _expected_output(grid, orange_rects, bars_info):\n 352:     expected = grid.copy()\n 353:     expected[grid == Color.GRAY] = Color.YELLOW\n 354:     for oi, _, contact_side, stripe_count in bars_info:\n 355:         _, or0, oc0, or1, oc1 = orange_rects[oi]\n 356:         if contact_side == 'top':\n 357:             expected[or0:or0+stripe_count, oc0:oc1+1] = Color.GRAY\n 358:         elif contact_side == 'bottom':\n 359:             expected[or1-stripe_count+1:or1+1, oc0:oc1+1] = Color.GRAY\n 360:         elif contact_side == 'left':\n 361:             expected[or0:or1+1, oc0:oc0+stripe_count] = Color.GRAY\n 362:         else:\n 363:             expected[or0:or1+1, oc1-stripe_count+1:oc1+1] = Color.GRAY\n 364:     return expected\n 365: \n 366: \n 367: def _gen_attempt() -> np.ndarray | None:\n 368:     canvas = _make_canvas()\n 369:     if canvas is None:\n 370:         return None\n 371:     grid, content_box = canvas\n 372:     occupied = np.zeros(grid.shape, dtype=bool)\n 373: \n 374:     orange_rects = _place_oranges(content_box, occupied)\n 375:     if orange_rects is None:\n 376:         return None\n 377: \n 378:     touched_list = _choose_touched_oranges(len(orange_rects))\n 379:     bpo = _choose_bars_per_orange(touched_list)\n 380:     if bpo is None:\n 381:         return None\n 382: \n 383:     bars_info = _plan_bars(orange_rects, touched_list, bpo, content_box, occupied)\n 384:     if bars_info is None:\n 385:         return None\n 386: \n 387:     _render_input_grid(grid, orange_rects, bars_info)\n 388:     try:\n 389:         output = main(grid)\n 390:     except Exception:\n 391:         return None\n 392:     if not np.array_equal(output, _expected_output(grid, orange_rects, bars_info)):\n 393:         return None\n 394:     return grid\n 395: \n 396: \n\n","exit_code":0,"status":"completed"}}
