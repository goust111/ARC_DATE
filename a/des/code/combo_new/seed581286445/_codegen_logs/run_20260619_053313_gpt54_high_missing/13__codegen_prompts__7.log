s = [\n 141:                 c\n 142:                 for c in range(MIN_TARGET_COLORS, max_colors + 1)\n 143:                 if area <= c * max_target_count\n 144:             ]\n 145:             if valid_counts:\n 146:                 options.append((k, m, valid_counts, max_target_count))\n 147:     return options\n 148: \n 149: \n 150: def _gen_pick_grid_option() -> tuple[int, int, list[int], int]:\n 151:     options = _gen_grid_options()\n 152:     if random.random() < PREFERRED_GRID_PROB:\n 153:         preferred_k, preferred_m = PREFERRED_GRID_HALF\n 154:         for option in options:\n 155:             if option[0] == preferred_k and option[1] == preferred_m:\n 156:                 return option\n 157:     return random.choice(options)\n 158: \n 159: \n 160: def _gen_quadrant_offsets(k: int, m: int) -> list[tuple[int, int]]:\n 161:     sep = SEPARATOR_WIDTH\n 162:     return [(0, 0), (0, m + sep), (k + sep, 0), (k + sep, m + sep)]\n 163: \n 164: \n 165: def _gen_missing_colors(non_bg_colors: list[int]) -> list[int]:\n 166:     missing_colors = [random.choice(non_bg_colors) for _ in range(QUADRANT_COUNT)]\n 167:     if len(set(missing_colors)) == 1:\n 168:         alternatives = [c for c in non_bg_colors if c != missing_colors[0]]\n 169:         missing_colors[-1] = random.choice(alternatives)\n 170:     return missing_colors\n 171: \n 172: \n 173: def _gen_attempt() -> np.ndarray | None:\n 174:     bg = random.randrange(COLOR_COUNT)\n 175:     k, m, valid_color_counts, max_target_count = _gen_pick_grid_option()\n 176:     area = k * m\n 177: \n 178:     color_count = random.choice(valid_color_counts)\n 179:     non_bg_colors = random.sample([c for c in range(COLOR_COUNT) if c != bg], color_count)\n 180:     target_counts = _gen_bounded_composition(area, color_count, max_target_count)\n 181:     if target_counts is None:\n 182:         return None\n 183: \n 184:     target_values = []\n 185:     for color, count in zip(non_bg_colors, target_counts):\n 186: 