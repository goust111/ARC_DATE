)\n 489:     placed = _place_anchors(out, inp, bg)\n 490:     if placed is None:\n 491:         return None\n 492:     anchor_colors, anchors = placed\n 493: \n 494:     marker_colors = _marker_color_sequence(anchor_colors)\n 495:     sprites = _place_aligned_sprites(out, anchors, marker_colors, bg)\n 496:     if sprites is None:\n 497:         return None\n 498: \n 499:     if not _scatter_sprites(inp, sprites, bg):\n 500:         return None\n 501: \n 502:     _add_distractors(out, inp, anchors, bg)\n 503:     if not _generated_grid_is_valid(inp, out, bg):\n 504:         return None\n 505:     return inp\n 506: \n 507: \n 508: def _new_canvas_pair():\n 509:     \"\"\"Choose grid size/background and return matching output/input canvases.\"\"\"\n 510:     H = random.randint(*_GRID_HEIGHT_RANGE)\n 511:     W = random.randint(*_GRID_WIDTH_RANGE)\n 512:     bg = random.randint(*_BG_COLOR_RANGE)\n 513:     out = np.full((H, W), int(bg), dtype=int)\n 514:     inp = np.full((H, W), int(bg), dtype=int)\n 515:     return bg, out, inp\n 516: \n 517: \n 518: def _place_anchors(out, inp, bg):\n 519:     \"\"\"Place distinct isolated border anchors into both canvases.\"\"\"\n 520:     anchor_colors = random.sample([c for c in _COLORS if c != bg], random.randint(*_ANCHOR_COUNT_RANGE))\n 521:     anchors = []\n 522:     for color in anchor_colors:\n 523:         candidates = _anchor_candidates(out, bg)\n 524:         if not candidates:\n 525:             return None\n 526:         axis, r, c = random.choice(candidates)\n 527:         anchor = {\"color\": int(color), \"r\": int(r), \"c\": int(c), \"axis\": axis}\n 528:         anchors.append(anchor)\n 529:         _put_anchor(out, r, c, color)\n 530:         _put_anchor(inp, r, c, color)\n 531:     return anchor_colors, anchors\n 532: \n 533: \n 534: def _marker_color_sequence(anchor_colors):\n 535:     \"\"\"Expand anchor colors to the sprite count, allowing repeated markers.\"\"\"\n 536:     n_sprites = random.randint(*_SPRITE_COUNT_RANGE)\n 537:     marker_colors = anchor_colors[:]\n 538:     while len(marker_colors) < n_sprites:\n 539:         marker_colors.append(random.choice(anchor_colors))\n 540:     random.shuffle(marker_colors)\n 541:     return marker_colors\n 542: \n 543: \n 544: def _place_aligned_sprites(out, anchors, marker_colors, bg):\n 545:     \"\"\"Build sprites in their solved locations and return their align metadata.\"\"\"\n 546:     by_color = {a[\"color\"]: a for a in anchors}\n 547:     used_body = set()\n 548:     sprites = []\n 549:     for marker in marker_colors:\n 550:         anchor = by_color[int(marker)]\n 551:         body = _body_color(bg, marker, used_body)\n 552:         used_body.add(body)\n 553:         sprite = _make_sprite(random.randint(*_BODY_AREA_RANGE), body, marker, bg)\n 554:         positions = _aligned_positions(out, sprite, anchor, bg)\n 555:         if not positions:\n 556:             return None\n 557:         marker_pos = random.choice(positions)\n 558:         _place(out, sprite, marker_pos[0], marker_pos[1], bg)\n 559:         sprites.append((sprite, anchor, marker_pos))\n 560:     return sprites\n 561: \n 562: \n 563: def _scatter_sprites(inp, sprites, bg):\n 564:     \"\"\"Move solved sprites onto the input canvas along the inverse axis.\"\"\"\n 565:     random.shuffle(sprites)\n 566:     for sprite, anchor, marker_pos in sprites:\n 567:         positions = _scatter_positions(inp, sprite, anchor, marker_pos, bg)\n 568:         if not positions:\n 569:             return False\n 570:         in_pos = random.choice(positions)\n 571:         _place(inp, sprite, in_pos[0], in_pos[1], bg)\n 572:     return True\n 573: \n 574: \n 575: def _generated_grid_is_valid(inp, out, bg):\n 576:     \"\"\"Apply generator invariants and the solver oracle check.\"\"\"\n 577:     if not _bg_is_mode(inp, bg):\n 578:         return False\n 579:     return bool(np.array_equal(main(inp), out))\n 580: \n 581: \n\n===== /home/lixinyu/snap/new/ARC_code/eval/fa