: \n  57:     colors = set(map(int, g.ravel())) - {bg}\n  58:     assert colors, \"expected foreground line and marker colors\"\n  59: \n  60:     marker_colors: set[int] = set()\n  61:     for color in colors:\n  62:         comps = components_mask(g == color, connectivity=4)\n  63:         assert comps, \"foreground color must have at least one component\"\n  64:         if max(len(comp) for comp in comps) == 1:\n  65:             marker_colors.add(int(color))\n  66: \n  67:     line_colors = colors - marker_colors\n  68:     assert line_colors, \"expected at least one non-marker line color\"\n  69:     assert marker_colors, \"expected singleton marker colors\"\n  70: \n  71:     original = {color: _pts(g == color) for color in line_colors}\n  72:     assignment: dict[tuple[int, int], int] = {}\n  73:     assign_dir: dict[tuple[int, int], tuple[int, int]] = {}\n  74: \n  75:     marker_mask = np.isin(g, list(marker_colors))\n  76:     for r0, c0 in _pts(marker_mask):\n  77:         candidates: list[tuple[int, int, int, int, int]] = []\n  78:         for dr, dc in DIRS4:\n  79:             r, c = r0 + dr, c0 + dc\n  80:             dist = 1\n  81:             while 0 <= r < H and 0 <= c < W:\n  82:                 value = int(g[r, c])\n  83:                 if value in line_colors:\n  84:                     axis = 0 if dr == 0 else 1\n  85:                     supported = _axis_support(original[value], r, c, axis)\n  86:                     candidates.append((dist, 0 if supported else 1, value, dr, dc))\n  87:                     break\n  88:                 if value == bg or value in marker_colors:\n  89:                     r += dr\n  90:                     c += dc\n  91:                     dist += 1\n  92:                     continue\n  93:                 break\n  94: \n  95:         assert candidates, f\"marker at {(r0, c0)} cannot see a line color\"\n  96:         candidates.sort()\n  97:         _dist, _unsupported, color, dr, dc = candidates[0]\n  98:         assignment[(r0, c0)] = int(color)\n  99:         assign_dir[(r0, c0)] = (int(dr), int(dc))\n 100: \n 101:     masks = {color: set(pts) for color, pts in original.items()}\n 102:     marker_pts = {color: set() for color in line_colors}\n 103:     for pt, color in assignment.items():\n 104:         masks[color].add(pt)\n 105:         marker_pts[color].add(pt)\n 106: \n 107:     comp_count = {color: _component_count(g.shape, masks[color]) for color in line_colors}\n 108: \n 109:     def has_axis_support(color: int, r: int, c: int, axis: int) -> bool:\n 110:         return (r, c) in marker_pts[color] or _axis_support(masks[color], r, c, axis)\n 111: \n 112:     def should_fill(color: int, a: tuple[int, int], b: tuple[int, int], axis: int) -> bool:\n 113:         r1, c1 = a\n 114:         r2, c2 = b\n 115:         gap = c2 - c1 - 1 if axis == 0 else r2 - r1 - 1\n 116:         if gap <= 0:\n 117:             return False\n 118: \n 119:         a_axis = has_axis_support(color, r1, c1, axis)\n 120:         b_axis = has_axis_support(color, r2, c2, axis)\n 121:         if gap == 1:\n 122:             if a_axis or b_axis:\n 123:                 return True\n 124:             a_perp = _perp_support(masks[color], r1, c1, axis)\n 125:             b_perp = _perp_support(masks[color], r2, c2, axis)\n 126:             return not (a_perp and b_perp)\n 127: \n 128:         if (r1, c1) in marker_pts[color] and (r2, c2) in marker_pts[color]:\n 129:             return False\n 130:         return a_axis and b_axis\n 131: \n 132:     for color in sorted(line_colors):\n 133:         additions: set[tuple[int, int]] = set()\n 134:         for r in range(H):\n 135:             cols = sorted(c for rr, c in masks[color] if rr == r)\n 136:             for c1, c2 in zip(cols, cols[1:]):\n 137:                 if should_fill(color, (r, c1), (r, c2), axis=0):\n 138:                     additions.update((r, c) for c in range(c1 + 1, c2))\n 139: \n 140:         for c in range(W):\n 141:             rows = sorted(r for r, cc in masks[color] if cc == c)\n 142:             for r1, r2 in zip(rows, rows[1:]):\n 143:                 if should_fill(color, (r1, c), (r2, c), axis=1):\n 144:                     additions.update((r, c) for r in range(r1 + 1, r2))\n 145: \n 146:         masks[color].update(additions)\n 147: \n 148:     control_ray = {color: set() for color in line_colors}\n 149:     if 4 in marker_colors:\n 150:         for control in _pts(g == 4):\n 151:             color = assignment[control]\n 152:             dr, dc = assign_dir[control]\n 153: \n 154:             r, c = control[0] + dr, control[1] + dc\n 155:             pivot: tuple[int, int] | None = None\n 156:             while 0 <= r < H and 0 <= c < W:\n 157:                 if (r, c) in masks[color]:\n 158:                     pivot = (r, c)\n 159:                     break\n 160:                 r += dr\n 161:                 c += dc\n 162:             assert pivot is not None, f\"yellow control at {control} has no assigned endpoint\"\n 163: \n 164:             old_start = (pivot[0] + dr, pivot[1] + dc)\n 165:             if old_start in masks[color]:\n 166:                 stack = [old_start]\n 167:                 old_arm: set[tuple[int, int]] = set()\n 168:                 while stack:\n 169:                     q = stack.pop()\n 170:                     if q == pivot or q in old_arm or q not in masks[color]:\n 171:                         continue\n 172:                     old_arm.add(q)\n 173:                     qr, qc = q\n 174:                     for ndr, ndc in DIRS4:\n 175:                         stack.append((qr + ndr, qc + ndc))\n 176: \n 177:                 assert old_arm, f\"yellow control at {control} found no old arm to erase\"\n 178:                 for q in old_arm:\n 179:                     masks[color].discard(q)\n 180:                     marker_pts[color].discard(q)\n 181:                     control_ray[color].discard(q)\n 182: \n 183:             pr, pc = -dr, -dc\n 184:             r, c = pivot\n 185:             while 0 <= r < H and 0 <= c < W:\n 186:                 masks[color].add((r, c))\n 187:                 control_ray[color].add((r, c))\n 188:                 r += pr\n 189:                 c += pc\n 190: \n 191:     claims: dict[tuple[int, int], list[int]] = {}\n 192:     for color, pts in masks.items():\n 193:         for pt in pts:\n 194:             claims.setdefault(pt, []).append(int(color))\n 195: \n 196:     out = np.full_like(g, bg)\n 197: \n 198:     def marker_brackets(color: int, pt: tuple[int, int]) -> bool:\n 199:         r, c = pt\n 200:         same_row = [mc for mr, mc in marker_pts[color] if mr == r]\n 201:         if any(mc < c for mc in same_row) and any(mc > c for mc in same_row):\n 202:             return True\n 203:         same_col = [mr for mr, mc in marker_pts[color] if mc == c]\n 204:         return any(mr < r for mr in same_col) and any(mr > r for mr in same_col)\n 205: \n 206:     for pt, colors_here in claims.items():\n 207:         forced = {color for color in colors_here if pt in control_ray[color]}\n 208:         if forced:\n 209:             assert len(forced) == 1, f\"ambiguous yellow-control rays at {pt}: {forced}\"\n 210:             out[pt] = next(iter(forced))\n 211:             continue\n 212: \n 213:         if len(colors_here) == 1:\n 214:             out[pt] = colors_here[0]\n 215:             continue\n 216: \n 217:         original_crossing = [color for color in colors_here if int(g[pt]) == color]\n 218:         if original_crossing:\n 219:             out[pt] = min(colors_here, key=lambda color: (-comp_count[color], color))\n 220:         else:\n 221:             bracketed = [color for color in colors_here if marker_brackets(color, pt)]\n 222:             if bracketed:\n 223:                 out[pt] = min(bracketed, key=lambda color: (-comp_count[color], color))\n 224:             else:\n 225:                 out[pt] = min(colors_here)\n 226: \n 227:     # Assert: every visible endpoint is on the boundary (or at a crossing)\n 228:     for color in line_colors:\n 229:         for comp in components_mask(out == color, connectivity=4):\n 230:             pts_set = set(map(tuple, comp))\n 231:             for r, c in pts_set:\n 232:                 nbrs = [(nr, nc) for nr, nc in [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]\n 233:                         if (nr, nc) in pts_set]\n 234:                 if len(nbrs) != 1:\n 235:                     continue\n 236:                 on_boundary = (r == 0 or r == H - 1 or c == 0 or c == W - 1)\n 237:                 if on_boundary:\n 238:                     # Perpendicularity check\n 239:                     nr, nc = nbrs[0]\n 240:                     dr, dc = nr - r, nc - c\n 241:                     if not ((r in (0, H-1)) and (c in (0, W-1))):\n 242:                         perp = ((r == 0 and dr == 1) or (r == H-1 and dr == -1)\n 243:                                 or (c == 0 and dc == 1) or (c == W-1 and dc == -1))\n 244:                         assert perp, f\"boundary endpoint ({r},{c}) color {color} not perpendicular\"\n 245:                     continue\n 246:                 adj_other = any(\n 247:                     0 <= r+dr < H and 0 <= c+dc < W\n 248:                     and int(out[r+dr, c+dc]) not in (bg, color)\n 249:                     for dr, dc in DIRS4)\n 250:                 assert adj_other, f\"dangling endpoint ({r},{c}) color {color}: not on boundary or crossing\"\n 251: \n 252:     # Assert: every line color crosses at least one other color\n 253:     color_cells = {c: set() for c in line_colors}\n 254:     for r in range(H):\n 255:         for c in range(W):\n 256:             v = int(out[r, c])\n 257:             if v in line_colors:\n 258:                 color_cells[v].add((r, c))\n 259:     crossing_colors = set()\n 260:     for r in range(H):\n 261:         for c in range(W):\n 262:             a = int(out[r, c])\n 263:             if a not in line_colors:\n 264: 