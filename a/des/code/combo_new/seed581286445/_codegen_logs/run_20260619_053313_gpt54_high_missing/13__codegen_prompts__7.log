c = int(sc_raw)\n 126:             for tr, tc in neighbors4(sr, sc):\n 127:                 target_i = orange_index.get((int(tr), int(tc)))\n 128:                 if target_i is not None:\n 129:                     touched.setdefault(target_i, []).append((int(tr), int(tc), sr, sc))\n 130: \n 131:         assert len(touched) == 1, \"each gray bar must touch exactly one orange rectangle\"\n 132:         target_i = next(iter(touched))\n 133:         source_by_target.setdefault(target_i, []).append((src, touched[target_i]))\n 134: \n 135:     out = g.copy()\n 136:     out[g == Color.GRAY] = Color.YELLOW\n 137: \n 138:     for target_i, sources in source_by_target.items():\n 139:         r0, c0, r1, c1 = orange_bboxes[target_i]\n 140:         orientations = {_orientation(src[\"coords\"], contacts) for src, contacts in sources}\n 141:         assert len(orientations) == 1, \"all gray bars for one orange rectangle must share orientation\"\n 142:         count = sum(int(src[\"area\"]) for src, _contacts in sources)\n 143:         contacts = [contact for _src, src_contacts in sources for contact in src_contacts]\n 144: \n 145:         if orientations == {\"horizontal\"}:\n 146:             contact_rows = {tr for tr, _tc, _sr, _sc in contacts}\n 147:             assert contact_rows <= {r0, r1}\n 148:             _fill_rows(out, r0, c0, r1, c1, count, contact_rows)\n 149:         else:\n 150:             assert orientations == {\"vertical\"}\n 151:             contact_cols = {tc for _tr, tc, _sr, _sc in contacts}\n 152:             assert contact_cols <= {c0, c1}\n 153:             _fill_cols(out, r0, c0, r1, c1, count, contact_cols)\n 154: \n 155:     return out\n\n--- generate_input 397:402 ---\n 397: def generate_input() -> np.ndarray:\n 398:     for _ in range(GENERATE_RETRIES):\n 399:         result = _gen_attempt()\n 400:         if result is not None:\n 401:             return result\n 402:     raise RuntimeError(f\"Failed to generate valid input after {GENERATE_RETRIES