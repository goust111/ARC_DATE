cc):\n 226:             if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:\n 227:                 continue\n 228:             v = canvas[nr, nc]\n 229:             if v != -1 and v != line_col:\n 230:                 return False\n 231: \n 232:     # At least one ring cell must be 8-adjacent to a line_col pixel\n 233:     for rr, cc in ring:\n 234:         for nr, nc in neighbors8(rr, cc):\n 235:             if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n 236:                 return True\n 237:     return False\n 238: \n 239: \n 240: # ---------------------------------------------------------------------------\n 241: # Line growth\n 242: # ---------------------------------------------------------------------------\n 243: \n 244: def _grow_line(grid, start, line_col, target_len, rng):\n 245:     \"\"\"Grow a meandering 8-connected 1px-wide path of line_col from start.\"\"\"\n 246:     h, w = grid.shape\n 247:     path = [start]\n 248:     dr_bias = 1 if start[0] < h // 2 else -1\n 249:     dc_bias = 1 if start[1] < w // 2 else -1\n 250:     cur = start\n 251:     path_set = {start}\n 252:     while len(path) < target_len:\n 253:         # Build weighted direction list: diagonals preferred, bias-aligned boosted\n 254:         dirs = []\n 255:         for ddr, ddc in DIAG_DIRS:\n 256:             aligned = (ddr == dr_bias or ddc == dc_bias)\n 257:             w_d = DIAG_WEIGHT_ALIGNED if aligned else DIAG_WEIGHT_OTHER\n 258:             dirs.extend([(ddr, ddc)] * w_d)\n 259:         for ddr, ddc in ORTHO_DIRS:\n 260:             aligned = (ddr == dr_bias and ddc == 0) or (ddc == dc_bias and ddr == 0)\n 261:             w_d = ORTHO_WEIGHT_ALIGNED if aligned else ORTHO_WEIGHT_OTHER\n 262:             dirs.extend([(ddr, ddc)] * w_d)\n 263:         rng.shuffle(dirs)\n 264:         placed = False\n 265:         for ddr, ddc in dirs:\n 266:             nr, nc = cur[0] + ddr, cur[1] + ddc\n 267:             if not _in_bounds(h, w, nr, nc) or grid[nr, nc] !