d(set(cells))\n 746: \n 747:     if not _valid_crossings(logical, dominant):\n 748:         return None\n 749:     return logical, paths, dominant\n 750: \n 751: \n 752: def _render_target(\n 753:     logical: dict[int, set[tuple[int, int]]],\n 754:     comp_count: dict[int, int],\n 755:     yellow_rays: dict[int, set[tuple[int, int]]],\n 756: ) -> np.ndarray:\n 757:     out = np.full((H, W), BG, dtype=int)\n 758:     for pt in set().union(*logical.values()):\n 759:         colors_here = [color for color in logical if pt in logical[color]]\n 760:         forced = [color for color in colors_here if pt in yellow_rays.get(color, set())]\n 761:         if forced:\n 762:             out[pt] = forced[0]\n 763:         elif len(colors_here) == 1:\n 764:             out[pt] = colors_here[0]\n 765:         else:\n 766:             out[pt] = min(colors_here, key=lambda color: (-comp_count[color], color))\n 767:     return out\n 768: \n 769: \n 770: def _marker_isolation_ok(grid: np.ndarray) -> bool:\n 771:     for color in (2, 4):\n 772:         for pt in map(tuple, np.argwhere(grid == color)):\n 773:             if any(grid[nb] == color for nb in _neighbors(pt)):\n 774:                 return False\n 775:     return True\n 776: \n 777: \n 778: def _derive_input(\n 779:     logical: dict[int, set[tuple[int, int]]],\n 780:     paths: dict[int, list[set[tuple[int, int]]]],\n 781:     dominant: int,\n 782: ) -> tuple[np.ndarray, np.ndarray] | None:\n 783:     crossings = set(_crossing_cells(logical))\n 784:     mode = random.choices([\"red\", \"yellow\", \"both\"], weights=MARKER_MODE_WEIGHTS)[0]\n 785:     yellow_count = random.randint(*YELLOW_COUNT_RANGE) if mode in (\"yellow\", \"both\") else 0\n 786:     red_count = random.randint(*RED_COUNT_RANGE) if mode in (\"red\", \"both\") else 0\n 787: \n 788:     yellow_infos = []\n 789:     blocked = set(crossings)\n 790:     if yellow_count:\n 791:         for cand in _yellow_candidates(logical, paths, crossings):\n 792:             color, pivot, out_dir, target_ray, old_arm = cand\n 793:             marker = (pivot[0] + out_dir[0], pivot[1] + out_dir[1])\n 794:             if marker in blocked or any(nb in blocked for nb in _neighbors(marker)):\n 795:                 continue\n 796:             if any((old & old_arm) or (ray & old_arm) for _, _, _, ray, old in yellow_infos):\n 797:                 continue\n 798:             yellow_infos.append(cand)\n 799:             blocked.update(target_ray | old_arm | {marker})\n 800:             if len(yellow_infos) == yellow_count:\n 801:                 break\n 802:         if len(yellow_infos) != yellow_count:\n 803:             return None\n 804: \n 805:     red_markers = _choose_red_markers(logical, paths, blocked, red_count) if red_count else []\n 806:     if red_count and not red_markers:\n 807:         return None\n 808: \n 809:     inp = np.full((H, W), BG, dtype=int)\n 810:     comp_count_masks: dict[int, set[tuple[int, int]]] = {c: set() for c in logical}\n 811:     crossing_display: dict[tuple[int, int], int] = {}\n 812:     for pt in crossings:\n 813:         colors = [color for color in logical if pt in logical[color]]\n 814:         if dominant not in colors:\n 815:             return None\n 816:         crossing_display[pt] = colors[0] if colors[1] == dominant else colors[1]\n 817: \n 818:     removed_for_yellow: dict[int, set[tuple[int, int]]] = {c: set() for c in logical}\n 819:     old_arms: dict[int, set[tuple[int, int]]] = {c: set() for c in logical}\n 820:     yellow_rays: dict[int, set[tuple[int, int]]] = {c: set() for c in logical}\n 821:     yellow_markers: list[tuple[int, tuple[int, int]]] = []\n 822:     for color, pivot, out_dir, target_ray, old_arm in yellow_infos:\n 823:         marker = (pivot[0] + out_dir[0], pivot[1] + out_dir[1])\n 824:         removed_for_yellow[color].update(target_ray - {pivot})\n 825:         old_arms[color].update(old_arm)\n 826:         yellow_rays[color].update(target_ray)\n 827:         yellow_markers.append((color, marker))\n 828: \n 829:     red_by_pt = {pt: color for color, pt in red_markers}\n 830:     yellow_by_pt = {pt: color for color, pt in yellow_markers}\n 831: \n 832:     for color, pts in logical.items():\n 833:         for pt in pts:\n 834:             if pt in removed_for_yellow[color]:\n 835:                 continue\n 836:             if pt in crossings and crossing_display[pt] != color:\n 837:                 continue\n 838:             if pt in red_by_pt or pt in yellow_by_pt:\n 839:                 continue\n 840:             inp[pt] = color\n 841:             comp_count_masks[color].add(pt)\n 842:     for color, pts in old_arms.items():\n 843:         for pt in pts:\n 844:             if inp[pt] != BG:\n 845:                 return None\n 846:             inp[pt] = color\n 847:             comp_count_masks[color].add(pt)\n 848: \n 849:     for pt, color in red_by_pt.items():\n 850:         inp[pt] = 2; comp_count_masks[color].add(pt)\n 851:     for pt, color in yellow_by_pt.items():\n 852:         inp[pt] = 4; comp_count_masks[color].add(pt)\n 853: \n 854:     if not _marker_isolation_ok(inp):\n 855:         return None\n 856:     for pt, color in yellow_by_pt.items():\n 857:         if not any(inp[nb] == color for nb in _neighbors(pt)):\n 858:             return None\n 859: \n 860:     comp_count = {color: _gen_component_count(pts) for color, pts in comp_count_masks.items()}\n 861:     target = _render_target(logical, comp_count, yellow_rays)\n 862:     for pt in crossings:\n 863:         if target[pt] == inp[pt]:\n 864:             return None\n 865: \n 866:     colors = sorted(logical)\n 867:     counts = {c: len(components_mask(target == c, connectivity=4)) for c in colors}\n 868:     if not all(COMPONENTS_PER_COLOR[0] <= v <= COMPONENTS_PER_COLOR[1] for v in counts.values()):\n 869:         return None\n 870:     if not TOTAL_COMPONENTS[0] <= sum(counts.values()) <= TOTAL_COMPONENTS[1]:\n 871:         return None\n 872:     if not