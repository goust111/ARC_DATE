{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom itertools import combinations\n\ncoords=[(r,c) for r in range(-2,3) for c in range(-2,3)]\ncoords.remove((0,0))\n\ndef conn(cells):\n    cells=set(cells)\n    stack=[next(iter(cells))]\n    seen={stack[0]}\n    while stack:\n        r,c=stack.pop()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            p=(r+dr,c+dc)\n            if p in cells and p not in seen:\n                seen.add(p); stack.append(p)\n    return len(seen)==len(cells)\n\ndef transforms(cells):\n    out=[]\n    for flip in (1,-1):\n        cur=[(r, c*flip) for r,c in cells]\n        for _ in range(4):\n            out.append(tuple(sorted(cur)))\n            cur=[(-c,r) for r,c in cur]\n    return out\n\ndef canon(cells):\n    reps=[]\n    for t in transforms(cells):\n        rs=[r for r,c in t]; cs=[c for r,c in t]\n        minr=min(rs); minc=min(cs)\n        reps.append(tuple(sorted((r-minr,c-minc) for r,c in t)))\n    return min(reps)\n\nclasses={}\nfor k in (3,4,5):\n    for comb in combinations(coords,k-1):\n        cells=((0,0),)+comb\n        if sum(r for r,c in cells)\"'!=0 or sum(c for r,c in cells)!=0:\n            continue\n        if not conn(cells):\n            continue\n        key=canon(cells)\n        classes.setdefault((k,key), cells)\nprint('\"'count', len(classes))\nfor k in (3,4,5):\n    print('size',k)\n    seen=[]\n    for (kk,key),cells in classes.items():\n        if kk==k:\n            seen.append(tuple(sorted(cells)))\n    for cells in sorted(seen)[:20]:\n        print(cells)\n    print('n=', len(seen))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
