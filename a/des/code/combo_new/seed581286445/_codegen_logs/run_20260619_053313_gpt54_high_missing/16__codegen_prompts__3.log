{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/d749d46f.py',\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n'/home/lixinyu/snap/new/ARC_code/eval/581f7754.py',\n'/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py',\n]\nfor path in files:\n    print(f'=== {path} ===')\n    txt = Path(path).read_text()\n    for name in ['main', 'generate_input']:\n        marker = f'def {name}('\n        i = txt.index(marker)\n        j = txt.find('\\\\ndef ', i + 1)\n        if j == -1:\n            j = len(txt)\n        block = txt[i:j].strip('\\\\n').splitlines()\n        print('\\\\n'.join(block[:80]))\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/d749d46f.py',\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n'/home/lixinyu/snap/new/ARC_code/eval/581f7754.py',\n'/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py',\n]\nfor path in files:\n    print(f'=== {path} ===')\n    txt = Path(path).read_text()\n    for name in ['main', 'generate_input']:\n        marker = f'def {name}('\n        i = txt.index(marker)\n        j = txt.find('\\\\ndef ', i + 1)\n        if j == -1:\n            j = len(txt)\n        block = txt[i:j].strip('\\\\n').splitlines()\n        print('\\\\n'.join(block[:80]))\n        print()\nPY\"","aggregated_output":"=== /home/lixinyu/snap/new/ARC_code/train/d749d46f.py ===\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.\n\n    Input structure\n    The grid has one background color and one foreground color; the foreground forms\n    separate solid rectangles, ordered from left to right.\n\n    Rule\n    Build a 10-row background canvas whose width is the packed width of the wide\n    versions of the rectangles. For each source rectangle, paint a top-aligned\n    rectangle of shape min(h,w) by max(h,w), with one background column between\n    consecutive rectangles. Then, starting again from the left edge, paint a\n    bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,\n    again separated by one background column.\n\n    Key insight\n    The input rectangles are not copied in their original orientations; each object\n    contributes one horizontal-facing and one vertical-facing normalized rectangle,\n    preserving left-to-right object order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n    fg = fg_colors[0]\n\n    components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n    assert components\n    components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n\n    dims: list[tuple[int, int]] = []\n    for obj in components:\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert obj[\"area\"] == h * w\n        dims.append((h, w))\n\n    out_h = 10\n    out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n    _assert_output_footprints_disjoint(dims)\n    out = np.full((out_h, out_w), bg, dtype=int)\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[:short, c : c + long] = fg\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[out_h - long : out_h, c : c + short] = fg\n        c += short + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\n# Rectangle counts and dimensions.\nRECT_COUNT_MIN = 4\nRECT_COUNT_MAX = 6\nSHORT_SIDE_MIN = 1\nSHORT_SIDE_MAX = 3\nSIDE_SUM_MAX = 10\nLONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN\n\n# Canvas and packing constraints.\nARC_GRID_MAX = 30\nOUTPUT_HEIGHT = 10\nGAP_WIDTH = 1\n\n# Retry policy.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n\n=== /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py ===\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\n=== /home/lixinyu/snap/new/ARC_code/eval/581f7754.py ===\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 581f7754 input\")\n\n=== /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py ===\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, table, frame, and slot dimensions.\nCANVAS_MIN, CANVAS_MAX = 13, 19\nTABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\nROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\nAXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n\n# Object and palette sampling limits.\nN_COLORS, MAX_OBJECT_COLORS = 10, 6\nMAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\nOBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n\n# Rejection sampling cap.\nGEN_RETRY_LIMIT = 300\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid ac6f9922 input\")\n\n","exit_code":0,"status":"completed"}}
