{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n\n\ndef _bfs_placement(feasible, sr, sc):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/21897d95.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.\n\n    Input structure:\n    - The grid is a mosaic of monochrome regions.\n    - Color 1 forms T-shaped control markers on region boundaries.\n    - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.\n    - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.\n\n    Rule:\n    - For a color-1 T marker, the single stem points at the destination region to repaint.\n    - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.\n    - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.\n    - All marker cells are filled with the final color of the source-side region.\n    - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.\n\n    Key insight:\n    - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = _solve_unrotated(g)\n    l9 = _find_l9_orientation(g)\n    if l9 == 'top_right':\n        return np.rot90(out, 1)\n    if l9 == 'top_left':\n        return np.rot90(out, 3)\n    return out\n\n# --------------- generator (l9rot) ---------------\n\n# ── Tunable constants ──────────────────────────────────────────────────\n# Canvas / region sizing\nGRID_SIZE_MAX = 30                          # max rows or cols\nMIN_REGION_CELLS = 6                        # per-spec minimum\nREGION_SIZE_FAC