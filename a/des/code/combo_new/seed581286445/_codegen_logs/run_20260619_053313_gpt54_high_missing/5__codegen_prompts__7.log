{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools\n\nL=4\nDIR4=((1,0),(-1,0),(0,1),(0,-1))\n\ndef neighbors(cell):\n    r,c=cell\n    out=[]\n    for dr,dc in DIR4:\n        rr,cc=r+dr,c+dc\n        if 0<=rr<L and 0<=cc<L:\n            out.append((rr,cc))\n    return out\n\ndef first_visible(cell,dr,dc,occupied):\n    rr,cc=cell[0]+dr,cell[1]+dc\n    while 0<=rr<L and 0<=cc<L:\n        if (rr,cc) in occupied:\n            return (rr,cc)\n        rr+=dr; cc+=dc\n    return None\n\ndef valid(chains):\n    occ={x for chain in chains for x in chain}\n    if sum(len(c) for c in chains)\"'!=len(occ):\n        return False\n    edges={frozenset((chain[i],chain[i+1])) for chain in chains for i in range(len(chain)-1)}\n    for cell in occ:\n        deg=sum(frozenset((cell,n)) in edges for n in neighbors(cell))\n        if deg>2:\n            return False\n    vis=set()\n    for cell in occ:\n        for dr,dc in DIR4:\n            hit=first_visible(cell,dr,dc,occ)\n            if hit is not None:\n                vis.add(frozenset((cell,hit)))\n    return vis==edges\n\ncells=[(r,c) for r in range(L) for c in range(L)]\n# generate domino chains\nedges=[]\nfor a in cells:\n    for b in neighbors(a):\n        if a<b:\n            edges.append((a,b))\nfor comb in itertools.combinations(edges,3):\n    used=[x for e in comb for x in e]\n    if len(set(used))<6:\n        continue\n    chains=[list(e) for e in comb]\n    if valid(chains):\n        print(chains)\n        break\nelse:\n    print('\"'none')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
