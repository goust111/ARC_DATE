{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nfrom collections import Counter\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed581286445/6/1.py')\nmod = SourceFileLoader('new_arc_task_rulecheck', str(p)).load_module()\n\nfor _ in range(100):\n    inp = mod.generate_input()\n    out = mod.main(inp)\n    frames = mod._find_frames(inp)\n    touched = np.zeros(inp.shape, dtype=bool)\n    for r0, c0, r1, c1 in frames:\n        interior = inp[r0 + 1:r1, c0 + 1:c1]\n        votes = interior[(interior \"'!= mod.BLACK) & (interior != mod.GREY)]\n        winner = Counter(map(int, votes.tolist())).most_common(1)[0][0]\n        touched[r0:r1 + 1, c0:c1 + 1] = True\n\n        assert np.all(out[r0, c0:c1 + 1] == winner)\n        assert np.all(out[r1, c0:c1 + 1] == winner)\n        assert np.all(out[r0:r1 + 1, c0] == winner)\n        assert np.all(out[r0:r1 + 1, c1] == winner)\n\n        mid_r = (r0 + r1) // 2\n        mid_c = (c0 + c1) // 2\n        expected = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)\n        expected[0, :] = winner\n        expected[-1, :] = winner\n        expected[:, 0] = winner\n        expected[:, -1] = winner\n        expected[mid_r - r0, 1:-1] = winner\n        expected[1:-1, mid_c - c0] = winner\n        assert np.array_equal(out[r0:r1 + 1, c0:c1 + 1], expected)\n\n    assert np.array_equal(out[~touched], inp[~touched])\nprint('\"'rulecheck ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
