{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom __future__ import annotations\nimport random\nfrom collections import defaultdict, Counter, deque\nimport numpy as np\n\nBG = 0\nGREY = 5\nPALETTE = [1, 2, 3, 4, 6, 7, 8, 9]\nDIR4 = [(-1,0),(1,0),(0,-1),(0,1)]\n\n\ndef manhattan(a,b):\n    return abs(a[0]-b[0])+abs(a[1]-b[1])\n\n\ndef segment_cells(a,b):\n    (r0,c0),(r1,c1)=a,b\n    if r0==r1:\n        step = 1 if c1>=c0 else -1\n        return [(r0,c) for c in range(c0,c1+step,step)]\n    if c0==c1:\n        step = 1 if r1>=r0 else -1\n        return [(r,c0) for r in range(r0,r1+step,step)]\n    raise ValueError('non-orth segment')\n\n\ndef polyline_cells(points):\n    out=[]\n    for i in range(len(points)-1):\n        seg = segment_cells(points[i], points[i+1])\n        if i:\n            seg=seg[1:]\n        out.extend(seg)\n    assert len(out)==len(set(out))\n    return out\n\n\ndef path_orientations(seq):\n    ori={}\n    idx={cell:i for i,cell in enumerate(seq)}\n    for i,cur in enumerate(seq):\n        if i==0:\n            nxt=seq[1]\n            ori[cur]='H' if nxt[0]==cur[0] else 'V'\n        elif i==len(seq)-1:\n            prv=seq[-2]\n            ori[cur]='H' if prv[0]==cur[0] else 'V'\n        else:\n            prv,nxt=seq[i-1],seq[i+1]\n            if prv[0]==nxt[0]:\n                ori[cur]='H'\n            elif prv[1]==nxt[1]:\n                ori[cur]='V'\n            else:\n                ori[cur]='C'\n    return ori, idx\n\n\ndef marker_cells(side, attach, offset, h, w):\n    r,c=attach\n    if side=='L':\n        top=r-offset\n        return [(top,0),(top,1),(top+1,0),(top+1,1)]\n    if side=='R':\n        top=r-offset\n        return [(top,w-2),(top,w-1),(top+1,w-2),(top+1,w-1)]\n    if side=='T':\n        left=c-offset\n        return [(0,left),(0,left+1),(1,left),(1,left+1)]\n    if side=='B':\n        left=c-offset\n        return [(h-2,left),(h-2,left+1),(h-1,left),(h-1,left+1)]\n    raise ValueError(side)\n\n\ndef sample_spaced(values, count, gap):\n    picks=[]\n    pool=list(values)\n    random.shuffle(pool)\n    for v in pool:\n        if all(abs(v-u)>=gap for u in picks):\n            picks.append(v)\n            if len(picks)==count:\n                return picks\n    return None\n\n\ndef pick_value(cands, used, gap, require=None):\n    cands=list(cands)\n    random.shuffle(cands)\n    if require is not None:\n        cands = [require] + [x for x in cands if x \"'!= require]\n    for v in cands:\n        if all(abs(v-u)>=gap for u in used):\n            return v\n    return None\n\n\ndef build_paths(h,w):\n    n_lr = random.randint(1,2)\n    n_tb = random.randint(1,2)\n    total = n_lr+n_tb\n    colors = random.sample(PALETTE, total)\n\n    row_cands = list(range(4, h-4))\n    col_cands = list(range(4, w-4))\n\n    left_used=[]\n    right_used=[]\n    top_used=[]\n    bottom_used=[]\n    paths=[]\n    color_iter=iter(colors)\n\n    # LR paths\n    for _ in range(n_lr):\n        rs = pick_value(row_cands, left_used, 3)\n        if rs is None:\n            return None\n        left_used.append(rs)\n        wants_straight = random.random() < 0.4\n        if wants_straight:\n            rt = pick_value([rs], right_used, 3)\n            if rt is None:\n                wants_straight = False\n        if not wants_straight:\n            diff_cands = [r for r in row_cands if abs(r-rs) >= 3]\n            rt = pick_value(diff_cands, right_used, 3)\n            if rt is None:\n                return None\n        right_used.append(rt)\n        start=(rs,2)\n        end=(rt,w-3)\n        off1=random.randint(0,1)\n        off2=random.randint(0,1)\n        if wants_straight:\n            points=[start,end]\n        else:\n            x=random.randint(5,w-6)\n            points=[start,(rs,x),(rt,x),end]\n        seq=polyline_cells(points)\n        paths.append({\n            '\"'color': next(color_iter), 'side_a':'L','side_b':'R', 'attach_a':start,'attach_b':end,\n            'off_a':off1,'off_b':off2,'points':points,'cells':seq,\n        })\n\n    # TB paths\n    for _ in range(n_tb):\n        cs = pick_value(col_cands, top_used, 3)\n        if cs is None:\n            return None\n        top_used.append(cs)\n        wants_straight = random.random() < 0.4\n        if wants_straight:\n            ct = pick_value([cs], bottom_used, 3)\n            if ct is None:\n                wants_straight = False\n        if not wants_straight:\n            diff_cands = [c for c in col_cands if abs(c-cs) >= 3]\n            ct = pick_value(diff_cands, bottom_used, 3)\n            if ct is None:\n                return None\n        bottom_used.append(ct)\n        start=(2,cs)\n        end=(h-3,ct)\n        off1=random.randint(0,1)\n        off2=random.randint(0,1)\n        if wants_straight:\n            points=[start,end]\n        else:\n            y=random.randint(5,h-6)\n            points=[start,(y,cs),(y,ct),end]\n        seq=polyline_cells(points)\n        paths.append({\n            'color': next(color_iter), 'side_a':'T','side_b':'B', 'attach_a':start,'attach_b':end,\n            'off_a':off1,'off_b':off2,'points':points,'cells':seq,\n        })\n\n    return paths\n\n\ndef validate_and_render(h,w,paths):\n    all_markers={}\n    marker_owner={}\n    cover=defaultdict(list)\n    ori_by_color={}\n    idx_by_color={}\n    cell_sets={}\n    attachments_by_color={}\n\n    for p in paths:\n        color=p['color']\n        seq=p['cells']\n        ori, idx = path_orientations(seq)\n        ori_by_color[color]=ori\n        idx_by_color[color]=idx\n        cell_sets[color]=set(seq)\n        attachments_by_color[color]={p['attach_a'], p['attach_b']}\n        markers = set(marker_cells(p['side_a'], p['attach_a'], p['off_a'], h, w) + marker_cells(p['side_b'], p['attach_b'], p['off_b'], h, w))\n        if len(markers)\"'!=8:\n            return None\n        all_markers[color]=markers\n        for cell in markers:\n            if cell in marker_owner:\n                return None\n            marker_owner[cell]=color\n        if len(seq) < 8:\n            return None\n        if any(cell in markers for cell in seq):\n            return None\n        # each attachment should touch its own marker and no other path cell around the marker side except itself\n        for att, side, off in [(p['\"'attach_a'], p['side_a'], p['off_a']), (p['attach_b'], p['side_b'], p['off_b'])]:\n            ms = set(marker_cells(side, att, off, h, w))\n            adj = {nbr for m in ms for nbr in [(m[0]-1,m[1]),(m[0]+1,m[1]),(m[0],m[1]-1),(m[0],m[1]+1)] if 0<=nbr[0]<h and 0<=nbr[1]<w and nbr not in ms}\n            if att not in adj:\n                return None\n            if len(cell_sets[color] & adj) \"'!= 1:\n                return None\n        for cell in seq:\n            cover[cell].append(color)\n\n    # path vs foreign markers adjacency\n    for color, cells in cell_sets.items():\n        my_atts = attachments_by_color[color]\n        for cell in cells:\n            for dr,dc in DIR4:\n                nbr=(cell[0]+dr,cell[1]+dc)\n                if nbr in marker_owner and marker_owner[nbr] != color:\n                    return None\n                if nbr in marker_owner and marker_owner[nbr] == color and cell not in my_atts:\n                    return None\n\n    crossings=[]\n    for cell, cols in cover.items():\n        if len(cols) > 2:\n            return None\n        if len(cols) == 2:\n            a,b=cols\n            oa=ori_by_color[a][cell]\n            ob=ori_by_color[b][cell]\n            ia=idx_by_color[a][cell]\n            ib=idx_by_color[b][cell]\n            if not (0 < ia < len(paths[[p['\"'color'] for p in paths].index(a)]['cells'])-1):\n                return None\n            if not (0 < ib < len(paths[[p['color'] for p in paths].index(b)]['cells'])-1):\n                return None\n            if oa not in 'HV' or ob not in 'HV' or oa == ob:\n                return None\n            # keep crossings away from turns/endpoints by one extra cell.\n            seqa=paths[[p['color'] for p in paths].index(a)]['cells']\n            seqb=paths[[p['color'] for p in paths].index(b)]['cells']\n            if ia <= 1 or ia >= len(seqa)-2 or ib <= 1 or ib >= len(seqb)-2:\n                return None\n            if len(cover[seqa[ia-1]]) \"'!= 1 or len(cover[seqa[ia+1]]) != 1:\n                return None\n            if len(cover[seqb[ib-1]]) != 1 or len(cover[seqb[ib+1]]) != 1:\n                return None\n            crossings.append((cell,a,b))\n\n    if not crossings:\n        return None\n\n    # no non-crossing orth adjacency between different paths\n    color_by_cell={}\n    for cell, cols in cover.items():\n        if len(cols)==1:\n            color_by_cell[cell]=cols[0]\n    cells_list=list(color_by_cell.items())\n    for cell, color in cells_list:\n        for dr,dc in DIR4:\n            nbr=(cell[0]+dr,cell[1]+dc)\n            if nbr in color_by_cell and color_by_cell[nbr] != color:\n                return None\n\n    grid=np.full((h,w), BG, dtype=int)\n    for p in paths:\n        c=p['\"'color']\n        for cell in all_markers[c]:\n            grid[cell]=c\n        for cell in p['cells']:\n            grid[cell]=c\n\n    top_by_cross={}\n    for cell,a,b in crossings:\n        top=random.choice([a,b])\n        top_by_cross[cell]=top\n        grid[cell]=top\n\n    out=grid.copy()\n    seq_lookup={p['color']:p['cells'] for p in paths}\n    for cell,a,b in crossings:\n        top=top_by_cross[cell]\n        under = b if top==a else a\n        seq = seq_lookup[under]\n        idx = idx_by_color[under][cell]\n        prev_, next_ = seq[idx-1], seq[idx+1]\n        out[prev_] = GREY\n        out[cell] = GREY\n        out[next_] = GREY\n    for cell, top in top_by_cross.items():\n        out[cell] = top\n\n    return grid, out, crossings, all_markers, seq_lookup\n\n# --- solver draft ---\n\ndef detect_markers(g):\n    h,w=g.shape\n    by_color=defaultdict(list)\n    used_cells=defaultdict(set)\n    for r in range(h-1):\n        for c in range(w-1):\n            col=int(g[r,c])\n            if col==BG:\n                continue\n            if int(g[r+1,c])==col and int(g[r,c+1])==col and int(g[r+1,c+1])==col:\n                cells={(r,c),(r+1,c),(r,c+1),(r+1,c+1)}\n                # ignore duplicates from exact same top-left only\n                by_color[col].append(cells)\n                used_cells[col] |= cells\n    clean={}\n    for col, windows in by_color.items():\n        # dedupe identical windows\n        uniq=[]\n        seen=set()\n        for win in windows:\n            key=tuple(sorted(win))\n            if key not in seen:\n                uniq.append(win)\n                seen.add(key)\n        if uniq:\n            clean[col]=uniq\n    return clean\n\n\ndef neighbors(cell,h,w):\n    r,c=cell\n    for dr,dc in DIR4:\n        rr,cc=r+dr,c+dc\n        if 0<=rr<h and 0<=cc<w:\n            yield (rr,cc)\n\n\ndef reconstruct_path(g, color, marker_sets):\n    h,w=g.shape\n    marker_cells=set().union(*marker_sets)\n    visible={tuple(x) for x in np.argwhere(g==color)} - marker_cells\n    attachments=[]\n    for marker in marker_sets:\n        adj={nbr for cell in marker for nbr in neighbors(cell,h,w) if nbr not in marker and nbr in visible}\n        if len(adj)\"'!=1:\n            raise AssertionError((color, marker, adj))\n        attachments.append(next(iter(adj)))\n    hidden={}\n    for r in range(h):\n        for c in range(w):\n            cell=(r,c)\n            if cell in marker_cells or int(g[cell]) in (BG, color):\n                continue\n            hor = (c-1>=0 and (r,c-1) in visible and c+1<w and (r,c+1) in visible)\n            ver = (r-1>=0 and (r-1,c) in visible and r+1<h and (r+1,c) in visible)\n            if hor == ver:\n                continue\n            hidden[cell] = '\"'H' if hor else 'V'\n    nodes=visible | set(hidden)\n    adj={cell:set() for cell in nodes}\n    for cell in nodes:\n        r,c=cell\n        for nbr in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):\n            if nbr in nodes:\n                adj[cell].add(nbr)\n    if len(attachments)\"'!=2:\n        raise AssertionError\n    for i, att in enumerate(attachments):\n        if len(adj[att]) != 1:\n            raise AssertionError((color, att, adj[att]))\n    for cell, nbrs in adj.items():\n        if cell in attachments:\n            continue\n        if len(nbrs) != 2:\n            raise AssertionError((color, cell, nbrs, hidden.get(cell)))\n    # hidden straightness\n    for cell, ax in hidden.items():\n        nbrs=sorted(adj[cell])\n        if ax=='\"'H' and not (nbrs[0][0]==cell[0]==nbrs[1][0]):\n            raise AssertionError((color, cell, ax, nbrs))\n        if ax=='V' and not (nbrs[0][1]==cell[1]==nbrs[1][1]):\n            raise AssertionError((color, cell, ax, nbrs))\n    start, end = attachments\n    seq=[start]\n    prev=None\n    cur=start\n    while cur \"'!= end:\n        nxts=[n for n in adj[cur] if n != prev]\n        if len(nxts)!=1:\n            raise AssertionError((color, cur, prev, nxts))\n        nxt=nxts[0]\n        seq.append(nxt)\n        prev, cur = cur, nxt\n        if len(seq) > len(nodes)+1:\n            raise AssertionError('\"'loop')\n    if set(seq) \"'!= nodes:\n        raise AssertionError((color, len(seq), len(nodes), nodes-set(seq)))\n    idx={cell:i for i,cell in enumerate(seq)}\n    return seq, idx, attachments, marker_cells\n\n\ndef main(g):\n    g=np.asarray(g, dtype=int)\n    markers=detect_markers(g)\n    path_colors=[c for c,wins in markers.items() if len(wins)==2]\n    info={}\n    for c in path_colors:\n        seq, idx, atts, marker_cells = reconstruct_path(g, c, markers[c])\n        info[c]={'\"'seq':seq,'idx':idx,'atts':atts,'markers':marker_cells}\n    cover=defaultdict(list)\n    for c, data in info.items():\n        for cell in data['seq']:\n            cover[cell].append(c)\n    out=g.copy()\n    restore=[]\n    for cell, cols in cover.items():\n        if len(cols)==2:\n            top=int(g[cell])\n            if top not in cols:\n                raise AssertionError((cell, cols, top))\n            under = cols[1] if cols[0]==top else cols[0]\n            seq=info[under]['seq']\n            i=info[under]['idx'][cell]\n            if not (0 < i < len(seq)-1):\n                raise AssertionError\n            prev_, next_ = seq[i-1], seq[i+1]\n            if not (prev_[0]==next_[0] or prev_[1]==next_[1]):\n                raise AssertionError\n            out[prev_] = GREY\n            out[cell] = GREY\n            out[next_] = GREY\n            restore.append((cell, top))\n    for cell, top in restore:\n        out[cell] = top\n    return out\n\nfor attempt in range(1000):\n    h=random.randint(18,26)\n    w=random.randint(18,26)\n    paths=build_paths(h,w)\n    if paths is None:\n        continue\n    rendered=validate_and_render(h,w,paths)\n    if rendered is None:\n        continue\n    inp, exp, crossings, markers, seqs = rendered\n    got=main(inp)\n    if not np.array_equal(got, exp):\n        print('mismatch attempt', attempt, inp.shape, len(crossings))\n        print(inp)\n        print(exp)\n        print(got)\n        raise SystemExit\nelse:\n    print('no valid sample?')\n    raise SystemExit\nprint('success')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom __future__ import annotations\nimport random\nfrom collections import defaultdict, Counter, deque\nimport numpy as np\n\nBG = 0\nGREY = 5\nPALETTE = [1, 2, 3, 4, 6, 7, 8, 9]\nDIR4 = [(-1,0),(1,0),(0,-1),(0,1)]\n\n\ndef manhattan(a,b):\n    return abs(a[0]-b[0])+abs(a[1]-b[1])\n\n\ndef segment_cells(a,b):\n    (r0,c0),(r1,c1)=a,b\n    if r0==r1:\n        step = 1 if c1>=c0 else -1\n        return [(r0,c) for c in range(c0,c1+step,step)]\n    if c0==c1:\n        step = 1 if r1>=r0 else -1\n        return [(r,c0) for r in range(r0,r1+step,step)]\n    raise ValueError('non-orth segment')\n\n\ndef polyline_cells(points):\n    out=[]\n    for i in range(len(points)-1):\n        seg = segment_cells(points[i], points[i+1])\n        if i:\n            seg=seg[1:]\n        out.extend(seg)\n    assert len(out)==len(set(out))\n    return out\n\n\ndef path_orientations(seq):\n    ori={}\n    idx={cell:i for i,cell in enumerate(seq)}\n    for i,cur in enumerate(seq):\n        if i==0:\n            nxt=seq[1]\n            ori[cur]='H' if nxt[0]==cur[0] else 'V'\n        elif i==len(seq)-1:\n            prv=seq[-2]\n            ori[cur]='H' if prv[0]==cur[0] else 'V'\n        else:\n            prv,nxt=seq[i-1],seq[i+1]\n            if prv[0]==nxt[0]:\n                ori[cur]='H'\n            elif prv[1]==nxt[1]:\n                ori[cur]='V'\n            else:\n                ori[cur]='C'\n    return ori, idx\n\n\ndef marker_cells(side, attach, offset, h, w):\n    r,c=attach\n    if side=='L':\n        top=r-offset\n        return [(top,0),(top,1),(top+1,0),(top+1,1)]\n    if side=='R':\n        top=r-offset\n        return [(top,w-2),(top,w-1),(top+1,w-2),(top+1,w-1)]\n    if side=='T':\n        left=c-offset\n        return [(0,left),(0,left+1),(1,left),(1,left+1)]\n    if side=='B':\n        left=c-offset\n        return [(h-2,left),(h-2,left+1),(h-1,left),(h-1,left+1)]\n    raise ValueError(side)\n\n\ndef sample_spaced(values, count, gap):\n    picks=[]\n    pool=list(values)\n    random.shuffle(pool)\n    for v in pool:\n        if all(abs(v-u)>=gap for u in picks):\n            picks.append(v)\n            if len(picks)==count:\n                return picks\n    return None\n\n\ndef pick_value(cands, used, gap, require=None):\n    cands=list(cands)\n    random.shuffle(cands)\n    if require is not None:\n        cands = [require] + [x for x in cands if x \"'!= require]\n    for v in cands:\n        if all(abs(v-u)>=gap for u in used):\n            return v\n    return None\n\n\ndef build_paths(h,w):\n    n_lr = random.randint(1,2)\n    n_tb = random.randint(1,2)\n    total = n_lr+n_tb\n    colors = random.sample(PALETTE, total)\n\n    row_cands = list(range(4, h-4))\n    col_cands = list(range(4, w-4))\n\n    left_used=[]\n    right_used=[]\n    top_used=[]\n    bottom_used=[]\n    paths=[]\n    color_iter=iter(colors)\n\n    # LR paths\n    for _ in range(n_lr):\n        rs = pick_value(row_cands, left_used, 3)\n        if rs is None:\n            return None\n        left_used.append(rs)\n        wants_straight = random.random() < 0.4\n        if wants_straight:\n            rt = pick_value([rs], right_used, 3)\n            if rt is None:\n                wants_straight = False\n        if not wants_straight:\n            diff_cands = [r for r in row_cands if abs(r-rs) >= 3]\n            rt = pick_value(diff_cands, right_used, 3)\n            if rt is None:\n                return None\n        right_used.append(rt)\n        start=(rs,2)\n        end=(rt,w-3)\n        off1=random.randint(0,1)\n        off2=random.randint(0,1)\n        if wants_straight:\n            points=[start,end]\n        else:\n            x=random.randint(5,w-6)\n            points=[start,(rs,x),(rt,x),end]\n        seq=polyline_cells(points)\n        paths.append({\n            '\"'color': next(color_iter), 'side_a':'L','side_b':'R', 'attach_a':start,'attach_b':end,\n            'off_a':off1,'off_b':off2,'points':points,'cells':seq,\n        })\n\n    # TB paths\n    for _ in range(n_tb):\n        cs = pick_value(col_cands, top_used, 3)\n        if cs is None:\n            return None\n        top_used.append(cs)\n        wants_straight = random.random() < 0.4\n        if wants_straight:\n            ct = pick_value([cs], bottom_used, 3)\n            if ct is None:\n                wants_straight = False\n        if not wants_straight:\n            diff_cands = [c for c in col_cands if abs(c-cs) >= 3]\n            ct = pick_value(diff_cands, bottom_used, 3)\n            if ct is None:\n                return None\n        bottom_used.append(ct)\n        start=(2,cs)\n        end=(h-3,ct)\n        off1=random.randint(0,1)\n        off2=random.randint(0,1)\n        if wants_straight:\n            points=[start,end]\n        else:\n            y=random.randint(5,h-6)\n            points=[start,(y,cs),(y,ct),end]\n        seq=polyline_cells(points)\n        paths.append({\n            'color': next(color_iter), 'side_a':'T','side_b':'B', 'attach_a':start,'attach_b':end,\n            'off_a':off1,'off_b':off2,'points':points,'cells':seq,\n        })\n\n    return paths\n\n\ndef validate_and_render(h,w,paths):\n    all_markers={}\n    marker_owner={}\n    cover=defaultdict(list)\n    ori_by_color={}\n    idx_by_color={}\n    cell_sets={}\n    attachments_by_color={}\n\n    for p in paths:\n        color=p['color']\n        seq=p['cells']\n        ori, idx = path_orientations(seq)\n        ori_by_color[color]=ori\n        idx_by_color[color]=idx\n        cell_sets[color]=set(seq)\n        attachments_by_color[color]={p['attach_a'], p['attach_b']}\n        markers = set(marker_cells(p['side_a'], p['attach_a'], p['off_a'], h, w) + marker_cells(p['side_b'], p['attach_b'], p['off_b'], h, w))\n        if len(markers)\"'!=8:\n            return None\n        all_markers[color]=markers\n        for cell in markers:\n            if cell in marker_owner:\n                return None\n            marker_owner[cell]=color\n        if len(seq) < 8:\n            return None\n        if any(cell in markers for cell in seq):\n            return None\n        # each attachment should touch its own marker and no other path cell around the marker side except itself\n        for att, side, off in [(p['\"'attach_a'], p['side_a'], p['off_a']), (p['attach_b'], p['side_b'], p['off_b'])]:\n            ms = set(marker_cells(side, att, off, h, w))\n            adj = {nbr for m in ms for nbr in [(m[0]-1,m[1]),(m[0]+1,m[1]),(m[0],m[1]-1),(m[0],m[1]+1)] if 0<=nbr[0]<h and 0<=nbr[1]<w and nbr not in ms}\n            if att not in adj:\n                return None\n            if len(cell_sets[color] & adj) \"'!= 1:\n                return None\n        for cell in seq:\n            cover[cell].append(color)\n\n    # path vs foreign markers adjacency\n    for color, cells in cell_sets.items():\n        my_atts = attachments_by_color[color]\n        for cell in cells:\n            for dr,dc in DIR4:\n                nbr=(cell[0]+dr,cell[1]+dc)\n                if nbr in marker_owner and marker_owner[nbr] != color:\n                    return None\n                if nbr in marker_owner and marker_owner[nbr] == color and cell not in my_atts:\n                    return None\n\n    crossings=[]\n    for cell, cols in cover.items():\n        if len(cols) > 2:\n            return None\n        if len(cols) == 2:\n            a,b=cols\n            oa=ori_by_color[a][cell]\n            ob=ori_by_color[b][cell]\n            ia=idx_by_color[a][cell]\n            ib=idx_by_color[b][cell]\n            if not (0 < ia < len(paths[[p['\"'color'] for p in paths].index(a)]['cells'])-1):\n                return None\n            if not (0 < ib < len(paths[[p['color'] for p in paths].index(b)]['cells'])-1):\n                return None\n            if oa not in 'HV' or ob not in 'HV' or oa == ob:\n                return None\n            # keep crossings away from turns/endpoints by one extra cell.\n            seqa=paths[[p['color'] for p in paths].index(a)]['cells']\n            seqb=paths[[p['color'] for p in paths].index(b)]['cells']\n            if ia <= 1 or ia >= len(seqa)-2 or ib <= 1 or ib >= len(seqb)-2:\n                return None\n            if len(cover[seqa[ia-1]]) \"'!= 1 or len(cover[seqa[ia+1]]) != 1:\n                return None\n            if len(cover[seqb[ib-1]]) != 1 or len(cover[seqb[ib+1]]) != 1:\n                return None\n            crossings.append((cell,a,b))\n\n    if not crossings:\n        return None\n\n    # no non-crossing orth adjacency between different paths\n    color_by_cell={}\n    for cell, cols in cover.items():\n        if len(cols)==1:\n            color_by_cell[cell]=cols[0]\n    cells_list=list(color_by_cell.items())\n    for cell, color in cells_list:\n        for dr,dc in DIR4:\n            nbr=(cell[0]+dr,cell[1]+dc)\n            if nbr in color_by_cell and color_by_cell[nbr] != color:\n                return None\n\n    grid=np.full((h,w), BG, dtype=int)\n    for p in paths:\n        c=p['\"'color']\n        for cell in all_markers[c]:\n            grid[cell]=c\n        for cell in p['cells']:\n            grid[cell]=c\n\n    top_by_cross={}\n    for cell,a,b in crossings:\n        top=random.choice([a,b])\n        top_by_cross[cell]=top\n        grid[cell]=top\n\n    out=grid.copy()\n    seq_lookup={p['color']:p['cells'] for p in paths}\n    for cell,a,b in crossings:\n        top=top_by_cross[cell]\n        under = b if top==a else a\n        seq = seq_lookup[under]\n        idx = idx_by_color[under][cell]\n        prev_, next_ = seq[idx-1], seq[idx+1]\n        out[prev_] = GREY\n        out[cell] = GREY\n        out[next_] = GREY\n    for cell, top in top_by_cross.items():\n        out[cell] = top\n\n    return grid, out, crossings, all_markers, seq_lookup\n\n# --- solver draft ---\n\ndef detect_markers(g):\n    h,w=g.shape\n    by_color=defaultdict(list)\n    used_cells=defaultdict(set)\n    for r in range(h-1):\n        for c in range(w-1):\n            col=int(g[r,c])\n            if col==BG:\n                continue\n            if int(g[r+1,c])==col and int(g[r,c+1])==col and int(g[r+1,c+1])==col:\n                cells={(r,c),(r+1,c),(r,c+1),(r+1,c+1)}\n                # ignore duplicates from exact same top-left only\n                by_color[col].append(cells)\n                used_cells[col] |= cells\n    clean={}\n    for col, windows in by_color.items():\n        # dedupe identical windows\n        uniq=[]\n        seen=set()\n        for win in windows:\n            key=tuple(sorted(win))\n            if key not in seen:\n                uniq.append(win)\n                seen.add(key)\n        if uniq:\n            clean[col]=uniq\n    return clean\n\n\ndef neighbors(cell,h,w):\n    r,c=cell\n    for dr,dc in DIR4:\n        rr,cc=r+dr,c+dc\n        if 0<=rr<h and 0<=cc<w:\n            yield (rr,cc)\n\n\ndef reconstruct_path(g, color, marker_sets):\n    h,w=g.shape\n    marker_cells=set().union(*marker_sets)\n    visible={tuple(x) for x in np.argwhere(g==color)} - marker_cells\n    attachments=[]\n    for marker in marker_sets:\n        adj={nbr for cell in marker for nbr in neighbors(cell,h,w) if nbr not in marker and nbr in visible}\n        if len(adj)\"'!=1:\n            raise AssertionError((color, marker, adj))\n        attachments.append(next(iter(adj)))\n    hidden={}\n    for r in range(h):\n        for c in range(w):\n            cell=(r,c)\n            if cell in marker_cells or int(g[cell]) in (BG, color):\n                continue\n            hor = (c-1>=0 and (r,c-1) in visible and c+1<w and (r,c+1) in visible)\n            ver = (r-1>=0 and (r-1,c) in visible and r+1<h and (r+1,c) in visible)\n            if hor == ver:\n                continue\n            hidden[cell] = '\"'H' if hor else 'V'\n    nodes=visible | set(hidden)\n    adj={cell:set() for cell in nodes}\n    for cell in nodes:\n        r,c=cell\n        for nbr in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):\n            if nbr in nodes:\n                adj[cell].add(nbr)\n    if len(attachments)\"'!=2:\n        raise AssertionError\n    for i, att in enumerate(attachments):\n        if len(adj[att]) != 1:\n            raise AssertionError((color, att, adj[att]))\n    for cell, nbrs in adj.items():\n        if cell in attachments:\n            continue\n        if len(nbrs) != 2:\n            raise AssertionError((color, cell, nbrs, hidden.get(cell)))\n    # hidden straightness\n    for cell, ax in hidden.items():\n        nbrs=sorted(adj[cell])\n        if ax=='\"'H' and not (nbrs[0][0]==cell[0]==nbrs[1][0]):\n            raise AssertionError((color, cell, ax, nbrs))\n        if ax=='V' and not (nbrs[0][1]==cell[1]==nbrs[1][1]):\n            raise AssertionError((color, cell, ax, nbrs))\n    start, end = attachments\n    seq=[start]\n    prev=None\n    cur=start\n    while cur \"'!= end:\n        nxts=[n for n in adj[cur] if n != prev]\n        if len(nxts)!=1:\n            raise AssertionError((color, cur, prev, nxts))\n        nxt=nxts[0]\n        seq.append(nxt)\n        prev, cur = cur, nxt\n        if len(seq) > len(nodes)+1:\n            raise AssertionError('\"'loop')\n    if set(seq) \"'!= nodes:\n        raise AssertionError((color, len(seq), len(nodes), nodes-set(seq)))\n    idx={cell:i for i,cell in enumerate(seq)}\n    return seq, idx, attachments, marker_cells\n\n\ndef main(g):\n    g=np.asarray(g, dtype=int)\n    markers=detect_markers(g)\n    path_colors=[c for c,wins in markers.items() if len(wins)==2]\n    info={}\n    for c in path_colors:\n        seq, idx, atts, marker_cells = reconstruct_path(g, c, markers[c])\n        info[c]={'\"'seq':seq,'idx':idx,'atts':atts,'markers':marker_cells}\n    cover=defaultdict(list)\n    for c, data in info.items():\n        for cell in data['seq']:\n            cover[cell].append(c)\n    out=g.copy()\n    restore=[]\n    for cell, cols in cover.items():\n        if len(cols)==2:\n            top=int(g[cell])\n            if top not in cols:\n                raise AssertionError((cell, cols, top))\n            under = cols[1] if cols[0]==top else cols[0]\n            seq=info[under]['seq']\n            i=info[under]['idx'][cell]\n            if not (0 < i < len(seq)-1):\n                raise AssertionError\n            prev_, next_ = seq[i-1], seq[i+1]\n            if not (prev_[0]==next_[0] or prev_[1]==next_[1]):\n                raise AssertionError\n            out[prev_] = GREY\n            out[cell] = GREY\n            out[next_] = GREY\n            restore.append((cell, top))\n    for cell, top in restore:\n        out[cell] = top\n    return out\n\nfor attempt in range(1000):\n    h=random.randint(18,26)\n    w=random.randint(18,26)\n    paths=build_paths(h,w)\n    if paths is None:\n        continue\n    rendered=validate_and_render(h,w,paths)\n    if rendered is None:\n        continue\n    inp, exp, crossings, markers, seqs = rendered\n    got=main(inp)\n    if not np.array_equal(got, exp):\n        print('mismatch attempt', attempt, inp.shape, len(crossings))\n        print(inp)\n        print(exp)\n        print(got)\n        raise SystemExit\nelse:\n    print('no valid sample?')\n    raise SystemExit\nprint('success')\nPY\"","aggregated_output":"no valid sample?\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom __future__ import annotations\nimport random\nfrom collections import defaultdict, Counter\nimport numpy as np\n\nBG = 0\nGREY = 5\nPALETTE = [1, 2, 3, 4, 6, 7, 8, 9]\nDIR4 = [(-1,0),(1,0),(0,-1),(0,1)]\n\ndef segment_cells(a,b):\n    (r0,c0),(r1,c1)=a,b\n    if r0==r1:\n        step=1 if c1>=c0 else -1\n        return [(r0,c) for c in range(c0,c1+step,step)]\n    if c0==c1:\n        step=1 if r1>=r0 else -1\n        return [(r,c0) for r in range(r0,r1+step,step)]\n    raise ValueError\n\ndef polyline_cells(points):\n    out=[]\n    for i in range(len(points)-1):\n        seg=segment_cells(points[i],points[i+1])\n        if i:\n            seg=seg[1:]\n        out.extend(seg)\n    if len(out)\"'!=len(set(out)):\n        raise AssertionError('\"'self overlap')\n    return out\n\ndef path_orientations(seq):\n    ori={}\n    idx={cell:i for i,cell in enumerate(seq)}\n    for i,cur in enumerate(seq):\n        if i==0:\n            nxt=seq[1]; ori[cur]='H' if nxt[0]==cur[0] else 'V'\n        elif i==len(seq)-1:\n            prv=seq[-2]; ori[cur]='H' if prv[0]==cur[0] else 'V'\n        else:\n            prv,nxt=seq[i-1],seq[i+1]\n            if prv[0]==nxt[0]: ori[cur]='H'\n            elif prv[1]==nxt[1]: ori[cur]='V'\n            else: ori[cur]='C'\n    return ori, idx\n\ndef marker_cells(side, attach, offset, h, w):\n    r,c=attach\n    if side=='L':\n        top=r-offset\n        return [(top,0),(top,1),(top+1,0),(top+1,1)]\n    if side=='R':\n        top=r-offset\n        return [(top,w-2),(top,w-1),(top+1,w-2),(top+1,w-1)]\n    if side=='T':\n        left=c-offset\n        return [(0,left),(0,left+1),(1,left),(1,left+1)]\n    if side=='B':\n        left=c-offset\n        return [(h-2,left),(h-2,left+1),(h-1,left),(h-1,left+1)]\n\ndef pick_value(cands, used, gap):\n    cands=list(cands)\n    random.shuffle(cands)\n    for v in cands:\n        if all(abs(v-u)>=gap for u in used):\n            return v\n    return None\n\ndef build_paths(h,w):\n    n_lr=random.randint(1,2); n_tb=random.randint(1,2)\n    colors=random.sample(PALETTE, n_lr+n_tb)\n    row_cands=list(range(4,h-4)); col_cands=list(range(4,w-4))\n    left_used=[]; right_used=[]; top_used=[]; bottom_used=[]\n    paths=[]; ci=0\n    for _ in range(n_lr):\n        rs=pick_value(row_cands,left_used,3)\n        if rs is None: return None\n        left_used.append(rs)\n        straight=random.random()<0.4\n        rt=None\n        if straight:\n            rt=pick_value([rs], right_used, 3)\n        if rt is None:\n            straight=False\n            rt=pick_value([r for r in row_cands if abs(r-rs)>=3], right_used,3)\n        if rt is None: return None\n        right_used.append(rt)\n        start=(rs,2); end=(rt,w-3)\n        if straight: points=[start,end]\n        else:\n            x=random.randint(5,w-6)\n            points=[start,(rs,x),(rt,x),end]\n        try: seq=polyline_cells(points)\n        except: return None\n        paths.append({'color':colors[ci],'side_a':'L','side_b':'R','attach_a':start,'attach_b':end,'off_a':random.randint(0,1),'off_b':random.randint(0,1),'points':points,'cells':seq})\n        ci+=1\n    for _ in range(n_tb):\n        cs=pick_value(col_cands, top_used,3)\n        if cs is None: return None\n        top_used.append(cs)\n        straight=random.random()<0.4\n        ct=None\n        if straight:\n            ct=pick_value([cs], bottom_used,3)\n        if ct is None:\n            straight=False\n            ct=pick_value([c for c in col_cands if abs(c-cs)>=3], bottom_used,3)\n        if ct is None: return None\n        bottom_used.append(ct)\n        start=(2,cs); end=(h-3,ct)\n        if straight: points=[start,end]\n        else:\n            y=random.randint(5,h-6)\n            points=[start,(y,cs),(y,ct),end]\n        try: seq=polyline_cells(points)\n        except: return None\n        paths.append({'color':colors[ci],'side_a':'T','side_b':'B','attach_a':start,'attach_b':end,'off_a':random.randint(0,1),'off_b':random.randint(0,1),'points':points,'cells':seq})\n        ci+=1\n    return paths\n\ndef validate(h,w,paths):\n    all_markers={}; marker_owner={}; cover=defaultdict(list); ori_by_color={}; idx_by_color={}; cell_sets={}; seq_lookup={}; atts={}\n    color_order={p['color']:p for p in paths}\n    for p in paths:\n        color=p['color']; seq=p['cells']; seq_lookup[color]=seq; cell_sets[color]=set(seq); atts[color]={p['attach_a'],p['attach_b']}\n        ori,idx=path_orientations(seq); ori_by_color[color]=ori; idx_by_color[color]=idx\n        markers=set(marker_cells(p['side_a'],p['attach_a'],p['off_a'],h,w)+marker_cells(p['side_b'],p['attach_b'],p['off_b'],h,w))\n        if len(markers)\"'!=8: return '\"'marker_size'\n        all_markers[color]=markers\n        for m in markers:\n            if m in marker_owner: return 'marker_overlap'\n            marker_owner[m]=color\n        if any(cell in markers for cell in seq): return 'path_into_marker'\n        for att,side,off in [(p['attach_a'],p['side_a'],p['off_a']), (p['attach_b'],p['side_b'],p['off_b'])]:\n            ms=set(marker_cells(side,att,off,h,w))\n            adj={nbr for m in ms for nbr in ((m[0]-1,m[1]),(m[0]+1,m[1]),(m[0],m[1]-1),(m[0],m[1]+1)) if 0<=nbr[0]<h and 0<=nbr[1]<w and nbr not in ms}\n            if att not in adj: return 'att_not_adj'\n            if len(cell_sets[color] & adj) \"'!= 1: return '\"'att_ambig'\n        for cell in seq: cover[cell].append(color)\n    for color,cells in cell_sets.items():\n        for cell in cells:\n            for dr,dc in DIR4:\n                nbr=(cell[0]+dr,cell[1]+dc)\n                if nbr in marker_owner and marker_owner[nbr] \"'!= color:\n                    return '\"'foreign_marker_adj'\n                if nbr in marker_owner and marker_owner[nbr] == color and cell not in atts[color]:\n                    return 'own_marker_extra_adj'\n    cross=0\n    for cell, cols in cover.items():\n        if len(cols)>2: return 'triple_cover'\n        if len(cols)==2:\n            cross+=1\n            a,b=cols; oa=ori_by_color[a][cell]; ob=ori_by_color[b][cell]; ia=idx_by_color[a][cell]; ib=idx_by_color[b][cell]\n            if oa not in 'HV' or ob not in 'HV' or oa==ob: return 'bad_cross_ori'\n            if ia<=1 or ia>=len(seq_lookup[a])-2 or ib<=1 or ib>=len(seq_lookup[b])-2: return 'cross_near_end'\n            if len(cover[seq_lookup[a][ia-1]])\"'!=1 or len(cover[seq_lookup[a][ia+1]])!=1 or len(cover[seq_lookup[b][ib-1]])!=1 or len(cover[seq_lookup[b][ib+1]])!=1:\n                return '\"'cross_adjacent'\n    if cross==0: return 'no_cross'\n    single={cell:cols[0] for cell,cols in cover.items() if len(cols)==1}\n    for cell,color in single.items():\n        for dr,dc in DIR4:\n            nbr=(cell[0]+dr,cell[1]+dc)\n            if nbr in single and single[nbr] \"'!= color:\n                return '\"'diff_adj'\n    return 'ok'\n\ncounts=Counter()\nfor _ in range(5000):\n    h=random.randint(18,26); w=random.randint(18,26)\n    paths=build_paths(h,w)\n    if paths is None:\n        counts['build_none']+=1; continue\n    counts[validate(h,w,paths)] += 1\nprint(counts.most_common())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
