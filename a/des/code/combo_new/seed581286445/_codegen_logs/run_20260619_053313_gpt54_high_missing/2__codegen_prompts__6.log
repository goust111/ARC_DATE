{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/2faf500b.py',\n'/home/lixinyu/snap/new/ARC_code/train/7e576d6e.py',\n'/home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py',\n'/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py',\n'/home/lixinyu/snap/new/ARC_code/eval/800d221b.py',\n'/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py',\n'/home/lixinyu/snap/new/ARC_code/eval/6e453dd6.py',\n'/home/lixinyu/snap/new/ARC_code/train/9344f635.py',\n]\nfor path in files:\n    text = Path(path).read_text()\n    print(f'===== {path} =====')\n    for key in ['def main', 'def generate_input']:\n        idx = text.find(key)\n        if idx == -1:\n            continue\n        end = text.find('\\\\ndef ', idx + 1)\n        if end == -1:\n            end = len(text)\n        print(text[idx:end][:5000])\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/2faf500b.py',\n'/home/lixinyu/snap/new/ARC_code/train/7e576d6e.py',\n'/home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py',\n'/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py',\n'/home/lixinyu/snap/new/ARC_code/eval/800d221b.py',\n'/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py',\n'/home/lixinyu/snap/new/ARC_code/eval/6e453dd6.py',\n'/home/lixinyu/snap/new/ARC_code/train/9344f635.py',\n]\nfor path in files:\n    text = Path(path).read_text()\n    print(f'===== {path} =====')\n    for key in ['def main', 'def generate_input']:\n        idx = text.find(key)\n        if idx == -1:\n            continue\n        end = text.find('\\\\ndef ', idx + 1)\n        if end == -1:\n            end = len(text)\n        print(text[idx:end][:5000])\n        print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/train/2faf500b.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Remove each fracture marker line and push the surrounding object pixels one cell away from it.\n\n    Input structure\n    - A background grid with 8-connected foreground objects made from a body color and a rarer marker color.\n    - Each object has a non-square bbox; the marker pixels form one complete fracture line across the shorter bbox axis.\n\n    Rule\n    - Erase all marker pixels.\n    - For a wide object, each row has one marker; body pixels left of it shift one cell left and body pixels right of it shift one cell right.\n    - For a tall object, each column has one marker; body pixels above it shift one cell up and body pixels below it shift one cell down.\n\n    Key insight\n    - The marker line is a crack through the object, so the two sides separate by one pixel perpendicular to the crack.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    marker, body = _role_colors(g, bg)\n    out = np.full_like(g, bg)\n\n    objects = find_components(\n        g,\n        bg=bg,\n        connectivity=8,\n        monochromatic=False,\n        colors=[marker, body],\n    )\n    assert objects, \"expected at least one fractured object\"\n\n    for obj in objects:\n        coords = obj[\"coords\"]\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        width = int(c1 - c0 + 1)\n        assert height != width, \"fractured object bbox must determine an orientation\"\n\n        vals = g[coords[:, 0], coords[:, 1]]\n        assert bool(np.any(vals == marker)), \"each object must contain marker pixels\"\n        assert bool(np.any(vals == body)), \"each object must contain body pixels\"\n\n        marker_coords = coords[vals == marker]\n        if width > height:\n            marker_by_row: dict[int, list[int]] = {}\n            for r, c in marker_coords:\n                marker_by_row.setdefault(int(r), []).append(int(c))\n            assert set(marker_by_row) == set(range(r0, r1 + 1)), \"wide object needs one marker in each row\"\n            assert all(len(cols) == 1 for cols in marker_by_row.values()), \"wide object marker row must be unique\"\n\n            for r, c in coords[vals == body]:\n                rr = int(r)\n                cc = int(c)\n                marker_c = marker_by_row[rr][0]\n                assert cc != marker_c, \"body pixel cannot occupy the marker column\"\n                shifted_c = cc - 1 if cc < marker_c else cc + 1\n                _set_body(out, rr, shifted_c, body)\n        else:\n            marker_by_col: dict[int, list[int]] = {}\n            for r, c in marker_coords:\n                marker_by_col.setdefault(int(c), []).append(int(r))\n            assert set(marker_by_col) == set(range(c0, c1 + 1)), \"tall object needs one marker in each column\"\n            assert all(len(rows) == 1 for rows in marker_by_col.values()), \"tall object marker column must be unique\"\n\n            for r, c in coords[vals == body]:\n                rr = int(r)\n                cc = int(c)\n                marker_r = marker_by_col[cc][0]\n                assert rr != marker_r, \"body pixel cannot occupy the marker row\"\n                shifted_r = rr - 1 if rr < marker_r else rr + 1\n                _set_body(out, shifted_r, cc, body)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, palette, and retry budget.\nBACKGROUND_COLOR = 0\nFOREGROUND_COLORS = tuple(range(1, 10))\nMAX_GRID_SIZE = 19\nMIN_GRID_SIZE_BY_COUNT = (8, 8, 10, 12, 14, 16, 18, 19)\nGENERATION_RETRIES = 300\n\n# Object counts, dimensions, and orientations.\nMIN_OBJECT_COUNT = 1\nMAX_OBJECT_COUNT = 7\nSHORT_SIDE_SIZES = (2, 3, 4, 5, 6)\nLONG_SIDE_FACTOR = 2\nWIDE = \"wide\"\nTALL = \"tall\"\nORIENTATIONS = [WIDE, TALL]\n\n# Dense layouts try smaller rectangles first while preserving random tie order.\nDENSE_COUNT_THRESHOLD = 6\nDENSE_PREFERRED_MAX_SHORT_SIDE = 3\nPACKED_COUNT_THRESHOLD = 4\nPACKED_PREFERRED_MAX_SHORT_SIDE = 4\n\n# Placement and retry constraints.\nSHIFT_PADDING = 1\nMIN_CHEB_GAP = 2\n\nBBox = tuple[int, int, int, int]\nLocation = tuple[int, int]\nObjectSpec = tuple[int, int, int, str]\n\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n\n===== /home/lixinyu/snap/new/ARC_code/train/7e576d6e.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Draw the marker-colored route through the centers of all doors in the parallel wall maze.\n\n    Input structure:\n    - The grid has a background, parallel full-span walls, one three-pixel door\n      segment in each wall, and two marker pixels sharing a color.\n    - Walls are either all vertical or all horizontal, and the markers are on\n      opposite outer sides of the wall set.\n\n    Rule:\n    - Keep the scene unchanged except for the route.\n    - Visit the door centers in wall order from the upper/left marker side to\n      the lower/right marker side.\n    - In each corridor, draw an orthogonal path to the cell just before the next\n      wall, move along that wall to the door center, cross the center, and\n      continue to the next corridor; after the last door, connect to the other\n      marker.\n\n    Key insight:\n    - The three-pixel door segments mark the only crossing points through a set\n      of parallel walls, so the output is the corridor path threaded through\n      those centers.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg, path_color, door_color, wall_color = _roles(g)\n    orientation, centers = _door_centers(g, door_color)\n    markers = _markers(g, path_color)\n\n    if orientation == \"vertical\":\n        return _solve_vertical_walls(g, centers, markers, bg, path_color, door_color, wall_color)\n    assert orientation == \"horizontal\"\n    return _solve_horizontal_walls(g, centers, markers, bg, path_color, door_color, wall_color)\n\n# --------------- generator (att1) ---------------\n\n# Canvas and color role sampling.\nGRID_H = 30\nGRID_W = 30\nCOLOR_POOL = range(10)\nN_ROLE_COLORS = 4\n\n# Parallel wall and door geometry.\nORIENTATIONS = (\"vertical\", \"horizontal\")\nWALL_COUNT_RANGE = (3, 4)\nWALL_POS_LO = 4\nWALL_POS_HI_MARGIN = 5\nWALL_MIN_GAP = 2\nDOOR_CENTER_LO = 3\nDOOR_CENTER_HI_MARGIN = 4\n\n# Marker placement and retry budget.\nMARKER_EDGE_RANGE = (1, 3)\nMARKER_FREE_LO = 1\nMARKER_FREE_HI_MARGIN = 2\nGEN_RETRIES = 300\n\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n\n\n===== /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect framed squares via colored bridges following a control-pixel sequence.\n\n    Input structure:\n    - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.\n    - Control row below squares: colored pixels read left-to-right encode visitation order.\n\n    Rule:\n    - Start at the square matching first control color c0.\n    - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.\n    - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.\n\n    Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # border color = most common non-bg color\n    cnt = Counter(map(int, g.flatten()))\n    border = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            border = int(col)\n            break\n    assert not (border is None)\n\n    # detect framed squares as connected components of the border color\n    lab, n = label_mask(g == int(border), connectivity=4)\n    frames: list[dict] = []\n    for cid in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(cid))\n        if int(pts.shape[0]) < 8:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        if h < 3 or w < 3:\n            continue\n\n        t = None\n        inner_col = None\n        for tt in range(1, int(min(h, w) // 2) + 1):\n            inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]\n            if inner.size == 0:\n                continue\n            if bool((inner == int(border)).any()):\n                continue\n            u = set(map(int, inner.flatten()))\n            if len(u) != 1:\n                continue\n\n            ok = True\n            if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not ok:\n                continue\n\n            t = int(tt)\n            inner_col = int(next(iter(u)))\n            break\n\n        if t is None or inner_col is None:\n            continue\n\n        frames.append(\n            {\n                \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n                \"t\": int(t),\n                \"inner\": int(inner_col),\n                \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            }\n        )\n\n    assert not (not frames)\n\n    by: dict[int, list[dict]] = defaultdict(list)\n    for f in frames:\n        by[int(f[\"inner\"])].append(f)\n\n    max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n\n    # control row = bottom-most row below the squares with >=2 non-bg pixels\n    ctrl_r = None\n    for r in range(int(H - 1), int(max_frame_r), -1):\n        if int((g[int(r)] != int(bg)).sum()) >= 2:\n            ctrl_r = int(r)\n            break\n    assert not (ctrl_r is None)\n\n    ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n    assert not (len(ctrl) < 2)\n\n    def center(f: dict) -> tuple[int, int]:\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        return int((r0 + r1) // 2), int((c0 + c1) // 2)\n\n    def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n        a = f1[\"inner_bbox\"]\n        b = f2[\"inner_bbox\"]\n        same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n        same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))\n        return same_row, same_col\n\n    # choose start frame\n    start_color = int(ctrl[0])\n    assert not (start_color not in by)\n    start_cands = by[start_color]\n    if len(start_cands) == 1:\n        cur = start_cands[0]\n    else:\n        nxt_color = int(ctrl[1])\n        nxt_cands = by.get(nxt_color, [])\n        best = None\n        bestf = None\n        for f in start_cands:\n            for g2 in (nxt_cands if nxt_cands else [f]):\n                sr, sc = aligned(f, g2)\n                al = 1 if (sr or sc) else 0\n                (r1_, c1_) = center(f)\n                (r2_, c2_) = center(g2)\n                d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n                cand = (int(al), -int(d))\n                if best is None or cand > best:\n                    best = cand\n                    bestf = f\n        cur = bestf\n\n    out = g.copy()\n\n    def draw_bridge(fa: dict, fb: dict, color: int) -> None:\n       \n\ndef generate_input() -> np.ndarray:\n    for _ in range(500):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after 500 attempts\")\n\n\n===== /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n\n\n\ndef generate_input():\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n\n\n\n\n===== /home/lixinyu/snap/new/ARC_code/eval/800d221b.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor a path-network by adjacent seed regions.\n\n    Input structure:\n    - bg = most common color.\n    - Path color P forms a thin orthogonal network with a solid square hub (NxN).\n    - Seed colors appear in colored regions (non-bg, non-P) adjacent to path branches.\n\n    Rule:\n    - Infer P as the non-bg color whose largest component is most network-like.\n    - Find the largest solid k×k all-P square (the hub); exclude it from recoloring.\n    - Recolor each path branch to the seed-region color it touches most.\n    - Recolor the hub center pixel to the seed whose branches touch the hub most.\n\n    Key insight: The hub stays uncolored; branches inherit color from adjacent seed regions by adjacency count.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    colors = sorted({int(x) for x in np.unique(g)} - {int(bg)})\n    assert not (not colors)\n\n    def comp_deg_score(mask: np.ndarray) -> float:\n        comps = components_mask(mask, connectivity=4)\n        if not comps:\n            return -1e9\n        best_pts = max(comps, key=lambda coords: int(coords.shape[0]))\n        best_sz = int(best_pts.shape[0])\n\n        m = np.zeros(mask.shape, dtype=bool)\n        m[best_pts[:, 0], best_pts[:, 1]] = True\n\n        deg2 = 0\n        deg4 = 0\n        for r, c in best_pts:\n            r = int(r)\n            c = int(c)\n            d = 0\n            if r > 0 and bool(m[r - 1, c]):\n                d += 1\n            if r + 1 < H and bool(m[r + 1, c]):\n                d += 1\n            if c > 0 and bool(m[r, c - 1]):\n                d += 1\n            if c + 1 < W and bool(m[r, c + 1]):\n                d += 1\n            if d == 2:\n                deg2 += 1\n            elif d == 4:\n                deg4 += 1\n        frac2 = deg2 / max(1, best_sz)\n        frac4 = deg4 / max(1, best_sz)\n        return float((frac2 - frac4) * best_sz)\n\n    P = int(max(colors, key=lambda c: comp_deg_score(g == int(c))))\n\n    # --- hub: largest solid k×k all-P square anywhere ---\n    mP = g == int(P)\n    ps = mP.astype(int).cumsum(axis=0).cumsum(axis=1)\n\n    def rect_sum(r0: int, c0: int, r1: int, c1: int) -> int:\n        s = int(ps[int(r1), int(c1)])\n        if r0 > 0:\n            s -= int(ps[int(r0 - 1), int(c1)])\n        if c0 > 0:\n            s -= int(ps[int(r1), int(c0 - 1)])\n        if r0 > 0 and c0 > 0:\n            s += int(ps[int(r0 - 1), int(c0 - 1)])\n        return int(s)\n\n    best = None  # (k, r0, c0)\n    max_k = int(min(H, W))\n    for k in range(2, max_k + 1):\n        found = None\n        for r0 in range(0, int(H - k + 1)):\n            r1 = int(r0 + k - 1)\n            for c0 in range(0, int(W - k + 1)):\n                c1 = int(c0 + k - 1)\n                if rect_sum(int(r0), int(c0), int(r1), int(c1)) == int(k * k):\n                    found = (int(k), int(r0), int(c0))\n        if found is not None:\n            best = found\n\n    assert not (best is None)\n\n    k, r0, c0 = map(int, best)\n    r1, c1 = int(r0 + k - 1), int(c0 + k - 1)\n    hub = np.zeros((H, W), dtype=bool)\n    hub[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = True\n\n    # --- seed regions (non-bg, non-P) ---\n    seed_mask = (g != int(bg)) & (g != int(P))\n    seed_lab, seed_n = label_mask(seed_mask, connectivity=4)\n    seed_major: dict[int, int] = {}\n    all_seed_vals: list[int] = []\n    for sid in range(1, int(seed_n) + 1):\n        pts = np.argwhere(seed_lab == int(sid))\n        rn, rx = int(pts[:, 0].min()), int(pts[:, 0].max())\n        cn, cx = int(pts[:, 1].min()), int(pts[:, 1].max())\n        if rn > 0:\n            assert all(int(g[rn - 1, c]) == int(P) for c in range(cn, cx + 1)), \"seed missing top P border\"\n        if rx < H - 1:\n            assert all(int(g[rx + 1, c]) == int(P) for c in range(cn, cx + 1)), \"seed missing bot P border\"\n        if cn > 0:\n            assert all(int(g[r, cn - 1]) == int(P) for r in range(rn, rx + 1)), \"seed missing left P border\"\n        if cx < W - 1:\n            assert all(int(g[r, cx + 1]) == int(P) for r in range(rn, rx + 1)), \"seed missing right P border\"\n        vals = [int(g[int(r), int(c)]) for r, c in pts]\n        maj = int(Counter(vals).most_common(1)[0][0])\n        seed_major[int(sid)] = int(maj)\n        all_seed_vals.extend(vals)\n\n    out = g.copy()\n\n    # --- recolor each path branch by the seed region it touches most ---\n    branch_mask = (g == int(P)) & (~hub)\n    branch_lab, branch_n = label_mask(branch_mask, connectivity=4)\n\n    pmask = g == int(P)\n    ppad = np.pad(pmask, 1)\n    p_deg = ppad[2:, 1:-1].astype(int) + ppad[:-2, 1:-1] + ppad[1:-1, 2:] + ppad[1:-1, :-2]\n    spad = np.pad(seed_lab > 0, 1)\n    adj_seed = spad[2:, 1:-1] | spad[:-2, 1:-1] | spad[1:-1, 2:] | spad[1:-1, :-2]\n    assert not np.any((p_deg > 2) & pmask & ~hub & ~adj_seed), \"path has T-junction\"\n\n    for bid in range(1, int(branch_n) + 1):\n        pts = np.argwhere(branch_lab == int(bid))\n        touches = Counter()\n        for r, c in pts:\n            r = \n\ndef generate_input():\n    for _ in range(GEN_OUTER_RETRIES):\n        try:\n            r = _gen_attempt()\n        except Exception:\n            r = None\n        if r is not None:\n            return r\n    raise RuntimeError(\"generate_input failed after %d attempts\" % GEN_OUTER_RETRIES)\n\n\n===== /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n\n    Input structure:\n    - The grid has a dominant background color.\n    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n\n    Rule:\n    - Keep the input pixels unchanged.\n    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n\n    Key insight:\n    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    out = g.copy()\n    h, w = g.shape\n\n    markers: dict[int, int] = {}\n    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n            continue\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n        source = int(sub[0, 0])\n        halo = int(sub[0, 1])\n        assert source != halo, \"legend source and halo colors must differ\"\n        assert source not in markers, \"each source color must have exactly one legend marker\"\n\n        markers[source] = halo\n        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n\n    assert markers, \"expected at least one left-edge legend marker\"\n\n    for source, halo in markers.items():\n        objects = []\n        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n            if cells <= marker_source_cells[source]:\n                continue\n            objects.append(comp)\n        assert objects, \"each legend source color must label at least one non-marker object\"\n\n        for obj in objects:\n            r0, c0, r1, c1 = obj[\"bbox\"]\n            pr0 = max(0, int(r0) - 1)\n            pc0 = max(0, int(c0) - 1)\n            pr1 = min(h - 1, int(r1) + 1)\n            pc1 = min(w - 1, int(c1) + 1)\n\n            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n            coords = obj[\"coords\"]\n            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n            enclosed = object_interior(patch, background=bg)\n            fill_mask = (patch == bg) & ~enclosed\n\n            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n            target[fill_mask] = halo\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and color palette.\nBACKGROUND = 0\nGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\nAVAILABLE_COLORS = tuple(range(1, 10))\n\n# Legend layout.\nLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\nLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n\n# Sprite geometry and acceptance.\nSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\nSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\nSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\nSPRITE_RETRIES = 300\n\n# Object counts and placement.\nINSTANCE_MIN, INSTANCE_MAX = 1, 3\nOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\nEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\nPLACEMENT_RETRIES = 200\n\n# Whole-sample retry budget.\nGENERATION_RETRIES = 300\n\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRIES} attempts\")\n\n\n===== /home/lixinyu/snap/new/ARC_code/eval/6e453dd6.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide black shapes rightward to a grey separator, then shoot red rays from enclosed holes.\n\n    Input structure:\n    - A vertical grey (5) separator column divides the grid into left and right halves.\n    - Black shapes sit on the left side against a background color (bg).\n\n    Rule:\n    - Translate each black connected component rightward until its right edge is flush with the separator.\n    - After sliding, find enclosed bg regions (holes) within the black shapes that touch the column just left of the separator.\n    - For each row spanned by such a hole, emit a red ray across the entire right half of the grid.\n\n    Key insight: Only holes adjacent to the separator trigger rays — the sliding creates enclosures that act as \"nozzles\" projecting rightward.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    sep_color = 5\n    black = 0\n    red = 2\n\n    sep = _find_separator_col(g, sep_color=sep_color)\n    bg = _background_color(g, sep_col=sep, sep_color=sep_color)\n\n    out = g.copy()\n\n    # Step 1: move black components on the left so that their right edge touches the separator.\n    left = out[:, :sep].copy()\n    left_mask = left == black\n    comps = _components4(left_mask)\n\n    # Clear old black pixels (leave other colors intact).\n    left[left == black] = bg\n\n    target_right = sep - 1  # last column in left side, adjacent to separator\n    for comp in comps:\n        max_c = max(c for _, c in comp)\n        delta = target_right - max_c\n        assert delta >= 0, \"left-side components must stay left of the separator\"\n        for r, c in comp:\n            nc = c + delta\n            assert 0 <= nc < sep, f\"shifted pixel {(r, c)} left the pane\"\n            left[r, nc] = black\n\n    out[:, :sep] = left\n\n    # Step 2: find enclosed background regions (holes) on the left.\n    # A hole is a bg component not touching the left subgrid boundary.\n    holes = []\n    for pts in _components4(left == bg):\n        if any(r == 0 or r == h - 1 or c == 0 or c == sep - 1 for r, c in pts):\n            continue\n        holes.append(pts)\n\n    # Step 3: if a hole touches column sep-2 (one cell left of the black border that touches separator),\n    # emit a red ray on the right side for each row containing hole pixels.\n    trigger_col = sep - 2\n    trigger_rows = []\n    for pts in holes:\n        if not any(c == trigger_col for _, c in pts):\n            continue\n        trigger_rows.extend(sorted(set(r for r, _ in pts)))\n    assert len(trigger_rows) == len(set(trigger_rows)), f\"trigger rows must be unique, got {trigger_rows}\"\n    for r in trigger_rows:\n        assert np.all(out[r, sep + 1 :] == bg), f\"right half of row {r} must be background before ray emission\"\n        out[r, sep + 1 :] = red\n\n    return out\n\n# --------------- generator (att4) ---------------\n\n# ── Colors ──\nBG = 6       # magenta background\nBLACK = 0    # sprite color\nRED = 2      # ray color\nSEP_COLOR = 5  # grey separator\n\n# ── Grid dimensions ──\nH_MIN, H_MAX = 16, 25\nW_MIN, W_MAX = 10, 16\nSEP_MIN, SEP_MAX = 5, 11       # separator column range\nRIGHT_W_MIN, RIGHT_W_MAX = 2, 4  # right-side width range\n\n# ── Sprite constraints ──\nN_SPRITES_MIN, N_SPRITES_MAX = 2, 5\nSPRITE_H_MAX = 8               # max sprite bbox height\nSPRITE_W_MAX = 6               # max sprite bbox width\nMIN_BAND_GAP = 1               # min bg rows between sprite bands\n\n# ── Probabilities ──\nSPLIT_PROB = 0.4                # emitter: probability of split (mini+main) layout\nEXTRA_EMITTERS_PROB = 0.25      # chance to add more emitters beyond the minimum\nFLUSH_PROB = 0.35               # chance one input sprite stays flush with separator\n\n# ── Retry budget ──\nMAX_RETRIES = 300\n\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 6e453dd6 input\")\n\n\n===== /home/lixinyu/snap/new/ARC_code/train/9344f635.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extend each colored domino marker into a full row or column bar, with horizontal bars covering vertical bars at crossings.\n\n    Input structure:\n    - The background is the dominant color.\n    - Every foreground object is a 4-connected same-color domino of exactly two pixels.\n    - A horizontal domino marks a row to paint; a vertical domino marks a column to paint.\n\n    Rule:\n    - Paint each marked column entirely with the color of its vertical domino marker.\n    - Paint each marked row entirely with the color of its horizontal domino marker.\n    - Rows are painted after columns, so row bars overwrite column bars at intersections.\n\n    Key insight:\n    - The two-pixel orientation is the instruction: horizontal markers emit row bars, vertical markers emit column bars, and the only layering cue is row-over-column.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    bg = get_bg(g)\n\n    row_colors: dict[int, int] = {}\n    col_colors: dict[int, int] = {}\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n    assert components, \"expected at least one foreground domino\"\n\n    for comp in components:\n        color = int(comp[\"color\"])\n        coords = comp[\"coords\"]\n        assert len(coords) == 2, \"each foreground object must be a two-pixel domino\"\n        r0, c0, r1, c1 = comp[\"bbox\"]\n\n        if r0 == r1 and c1 == c0 + 1:\n            _add_bar(row_colors, r0, color)\n        elif c0 == c1 and r1 == r0 + 1:\n            _add_bar(col_colors, c0, color)\n        else:\n            raise AssertionError(\"domino marker must be horizontal or vertical\")\n\n    out = np.full_like(g, int(bg))\n    for c, color in col_colors.items():\n        out[:, c] = int(color)\n    for r, color in row_colors.items():\n        out[r, :] = int(color)\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\n_GEN_BG = 7\n_GEN_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n_GEN_SIZE_MIN = 7\n_GEN_SIZE_MAX = 10\n\n# Bar counts and color diversity.\n_GEN_H_COUNT_MIN = 2\n_GEN_H_COUNT_MAX = 3\n_GEN_V_COUNT_MIN = 1\n_GEN_V_COUNT_MAX = 4\n_GEN_TOTAL_COUNT_MIN = 4\n_GEN_TOTAL_COUNT_MAX = 7\n_GEN_UNIQUE_COLOR_MIN = 3\n_GEN_UNIQUE_COLOR_MAX = 5\n\n# Marker placement.\n_GEN_ROW_MARGIN = 1\n_GEN_DOMINO_LEN = 2\n_GEN_DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid 9344f635 input\")\n\n\n","exit_code":0,"status":"completed"}}
