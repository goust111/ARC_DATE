{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom __future__ import annotations\nimport random\nfrom collections import defaultdict\nimport numpy as np\n\nBG = 0\nGREY = 5\nPALETTE = [1, 2, 3, 4, 6, 7, 8, 9]\nDIR4 = [(-1,0),(1,0),(0,-1),(0,1)]\n\n\ndef segment_cells(a,b):\n    (r0,c0),(r1,c1)=a,b\n    if r0==r1:\n        step=1 if c1>=c0 else -1\n        return [(r0,c) for c in range(c0,c1+step,step)]\n    if c0==c1:\n        step=1 if r1>=r0 else -1\n        return [(r,c0) for r in range(r0,r1+step,step)]\n    raise ValueError('non-orth')\n\n\ndef polyline_cells(points):\n    out=[]\n    for i in range(len(points)-1):\n        seg=segment_cells(points[i], points[i+1])\n        if i:\n            seg=seg[1:]\n        out.extend(seg)\n    if len(out) \"'!= len(set(out)):\n        raise AssertionError('\"'self overlap')\n    return out\n\n\ndef path_orientations(seq):\n    ori={}\n    idx={cell:i for i,cell in enumerate(seq)}\n    for i,cur in enumerate(seq):\n        if i==0:\n            nxt=seq[1]\n            ori[cur]='H' if nxt[0]==cur[0] else 'V'\n        elif i==len(seq)-1:\n            prv=seq[-2]\n            ori[cur]='H' if prv[0]==cur[0] else 'V'\n        else:\n            prv,nxt=seq[i-1],seq[i+1]\n            if prv[0]==nxt[0]:\n                ori[cur]='H'\n            elif prv[1]==nxt[1]:\n                ori[cur]='V'\n            else:\n                ori[cur]='C'\n    return ori, idx\n\n\ndef marker_cells(side, attach, offset, h, w):\n    r,c=attach\n    if side=='L':\n        top=r-offset\n        return [(top,0),(top,1),(top+1,0),(top+1,1)]\n    if side=='R':\n        top=r-offset\n        return [(top,w-2),(top,w-1),(top+1,w-2),(top+1,w-1)]\n    if side=='T':\n        left=c-offset\n        return [(0,left),(0,left+1),(1,left),(1,left+1)]\n    if side=='B':\n        left=c-offset\n        return [(h-2,left),(h-2,left+1),(h-1,left),(h-1,left+1)]\n    raise ValueError(side)\n\n\ndef pick_value(cands, used, gap):\n    cands=list(cands)\n    random.shuffle(cands)\n    for v in cands:\n        if all(abs(v-u)>=gap for u in used):\n            return v\n    return None\n\n\ndef build_paths(h,w):\n    n_lr=random.randint(1,2)\n    n_tb=random.randint(1,2)\n    colors=random.sample(PALETTE, n_lr+n_tb)\n    row_cands=list(range(4, h-4))\n    col_cands=list(range(4, w-4))\n    left_used=[]; right_used=[]; top_used=[]; bottom_used=[]\n    paths=[]; ci=0\n    for _ in range(n_lr):\n        rs=pick_value(row_cands, left_used, 3)\n        if rs is None:\n            return None\n        left_used.append(rs)\n        straight = random.random() < 0.4\n        rt = pick_value([rs], right_used, 3) if straight else None\n        if rt is None:\n            straight = False\n            rt = pick_value([r for r in row_cands if abs(r-rs) >= 3], right_used, 3)\n        if rt is None:\n            return None\n        right_used.append(rt)\n        start=(rs,2); end=(rt,w-3)\n        if straight:\n            points=[start,end]\n        else:\n            x=random.randint(5, w-6)\n            points=[start,(rs,x),(rt,x),end]\n        seq=polyline_cells(points)\n        paths.append({'color': colors[ci], 'side_a':'L','side_b':'R','attach_a':start,'attach_b':end,'off_a':random.randint(0,1),'off_b':random.randint(0,1),'cells':seq})\n        ci += 1\n    for _ in range(n_tb):\n        cs=pick_value(col_cands, top_used, 3)\n        if cs is None:\n            return None\n        top_used.append(cs)\n        straight = random.random() < 0.4\n        ct = pick_value([cs], bottom_used, 3) if straight else None\n        if ct is None:\n            straight = False\n            ct = pick_value([c for c in col_cands if abs(c-cs) >= 3], bottom_used, 3)\n        if ct is None:\n            return None\n        bottom_used.append(ct)\n        start=(2,cs); end=(h-3,ct)\n        if straight:\n            points=[start,end]\n        else:\n            y=random.randint(5, h-6)\n            points=[start,(y,cs),(y,ct),end]\n        seq=polyline_cells(points)\n        paths.append({'color': colors[ci], 'side_a':'T','side_b':'B','attach_a':start,'attach_b':end,'off_a':random.randint(0,1),'off_b':random.randint(0,1),'cells':seq})\n        ci += 1\n    return paths\n\n\ndef validate_and_render(h,w,paths):\n    all_markers={}\n    marker_owner={}\n    cover=defaultdict(list)\n    ori_by_color={}\n    idx_by_color={}\n    seq_by_color={}\n    cell_sets={}\n    attachments={}\n    for p in paths:\n        color=p['color']\n        seq=p['cells']\n        seq_by_color[color]=seq\n        cell_sets[color]=set(seq)\n        attachments[color]={p['attach_a'], p['attach_b']}\n        ori, idx = path_orientations(seq)\n        ori_by_color[color]=ori\n        idx_by_color[color]=idx\n        markers=set(marker_cells(p['side_a'],p['attach_a'],p['off_a'],h,w)+marker_cells(p['side_b'],p['attach_b'],p['off_b'],h,w))\n        if len(markers)\"'!=8:\n            return None\n        all_markers[color]=markers\n        for m in markers:\n            if m in marker_owner:\n                return None\n            marker_owner[m]=color\n        if any(cell in markers for cell in seq):\n            return None\n        for att, side, off in ((p['\"'attach_a'],p['side_a'],p['off_a']), (p['attach_b'],p['side_b'],p['off_b'])):\n            ms=set(marker_cells(side, att, off, h, w))\n            adj={nbr for m in ms for nbr in ((m[0]-1,m[1]),(m[0]+1,m[1]),(m[0],m[1]-1),(m[0],m[1]+1)) if 0<=nbr[0]<h and 0<=nbr[1]<w and nbr not in ms}\n            if att not in adj or len(cell_sets[color] & adj) \"'!= 1:\n                return None\n        for cell in seq:\n            cover[cell].append(color)\n    for color, cells in cell_sets.items():\n        for cell in cells:\n            for dr,dc in DIR4:\n                nbr=(cell[0]+dr, cell[1]+dc)\n                if nbr in marker_owner and marker_owner[nbr] != color:\n                    return None\n                if nbr in marker_owner and marker_owner[nbr] == color and cell not in attachments[color]:\n                    return None\n    crossings=[]\n    for cell, cols in cover.items():\n        if len(cols) > 2:\n            return None\n        if len(cols) == 2:\n            a,b=cols\n            ia=idx_by_color[a][cell]\n            ib=idx_by_color[b][cell]\n            oa=ori_by_color[a][cell]\n            ob=ori_by_color[b][cell]\n            if oa not in '\"'HV' or ob not in 'HV' or oa == ob:\n                return None\n            if ia <= 1 or ia >= len(seq_by_color[a]) - 2 or ib <= 1 or ib >= len(seq_by_color[b]) - 2:\n                return None\n            if len(cover[seq_by_color[a][ia-1]]) \"'!= 1 or len(cover[seq_by_color[a][ia+1]]) != 1:\n                return None\n            if len(cover[seq_by_color[b][ib-1]]) != 1 or len(cover[seq_by_color[b][ib+1]]) != 1:\n                return None\n            crossings.append((cell,a,b))\n    if not crossings:\n        return None\n    singles={cell: cols[0] for cell, cols in cover.items() if len(cols) == 1}\n    for cell, color in singles.items():\n        for dr,dc in DIR4:\n            nbr=(cell[0]+dr, cell[1]+dc)\n            if nbr in singles and singles[nbr] != color:\n                return None\n    grid=np.full((h,w), BG, dtype=int)\n    for color, markers in all_markers.items():\n        for m in markers:\n            grid[m]=color\n    for color, seq in seq_by_color.items():\n        for cell in seq:\n            grid[cell]=color\n    top_by_cross={}\n    for cell, a, b in crossings:\n        top=random.choice([a,b])\n        top_by_cross[cell]=top\n        grid[cell]=top\n    out=grid.copy()\n    for cell, a, b in crossings:\n        top=top_by_cross[cell]\n        under=b if top == a else a\n        seq=seq_by_color[under]\n        idx=idx_by_color[under][cell]\n        prev_, next_ = seq[idx-1], seq[idx+1]\n        out[prev_] = GREY\n        out[cell] = GREY\n        out[next_] = GREY\n    for cell, top in top_by_cross.items():\n        out[cell] = top\n    return grid, out\n\n\ndef detect_markers(g):\n    h,w=g.shape\n    by_color=defaultdict(list)\n    seen=set()\n    for r in range(h-1):\n        for c in range(w-1):\n            col=int(g[r,c])\n            if col == BG:\n                continue\n            if int(g[r+1,c]) == col and int(g[r,c+1]) == col and int(g[r+1,c+1]) == col:\n                key=(col,r,c)\n                if key not in seen:\n                    by_color[col].append({(r,c),(r+1,c),(r,c+1),(r+1,c+1)})\n                    seen.add(key)\n    return by_color\n\n\ndef neighbors(cell,h,w):\n    r,c=cell\n    for dr,dc in DIR4:\n        rr,cc=r+dr,c+dc\n        if 0<=rr<h and 0<=cc<w:\n            yield (rr,cc)\n\n\ndef reconstruct_path(g, color, markers):\n    h,w=g.shape\n    marker_cells=set().union(*markers)\n    visible={tuple(x) for x in np.argwhere(g == color)} - marker_cells\n    attachments=[]\n    for marker in markers:\n        adj={nbr for cell in marker for nbr in neighbors(cell,h,w) if nbr in visible and nbr not in marker}\n        assert len(adj) == 1, (color, marker, adj)\n        attachments.append(next(iter(adj)))\n    hidden={}\n    for r in range(h):\n        for c in range(w):\n            cell=(r,c)\n            if cell in marker_cells or int(g[cell]) in (BG, color):\n                continue\n            hor = c-1 >= 0 and c+1 < w and (r,c-1) in visible and (r,c+1) in visible\n            ver = r-1 >= 0 and r+1 < h and (r-1,c) in visible and (r+1,c) in visible\n            if hor ''^ ver:\n                hidden[cell] = '\"'H' if hor else 'V'\n    nodes = visible | set(hidden)\n    adj={cell:set() for cell in nodes}\n    for cell in nodes:\n        r,c=cell\n        for nbr in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):\n            if nbr in nodes:\n                adj[cell].add(nbr)\n    assert len(attachments) == 2\n    for att in attachments:\n        assert len(adj[att]) == 1, (color, att, adj[att])\n    for cell, nbrs in adj.items():\n        if cell in attachments:\n            continue\n        assert len(nbrs) == 2, (color, cell, hidden.get(cell), nbrs)\n    for cell, axis in hidden.items():\n        nbrs=sorted(adj[cell])\n        if axis == 'H':\n            assert nbrs[0][0] == cell[0] == nbrs[1][0], (color, cell, axis, nbrs)\n        else:\n            assert nbrs[0][1] == cell[1] == nbrs[1][1], (color, cell, axis, nbrs)\n    start,end = attachments\n    seq=[start]\n    prev=None\n    cur=start\n    while cur \"'!= end:\n        nxts=[n for n in adj[cur] if n != prev]\n        assert len(nxts) == 1, (color, cur, prev, nxts)\n        nxt=nxts[0]\n        seq.append(nxt)\n        prev,cur = cur,nxt\n        assert len(seq) <= len(nodes) + 1\n    assert set(seq) == nodes, (color, len(seq), len(nodes), nodes - set(seq))\n    idx={cell:i for i,cell in enumerate(seq)}\n    return seq, idx\n\n\ndef solve(g):\n    g=np.asarray(g, dtype=int)\n    markers=detect_markers(g)\n    info={}\n    for color, wins in markers.items():\n        assert len(wins) == 2, (color, len(wins))\n        seq, idx = reconstruct_path(g, color, wins)\n        info[color]={'\"'seq':seq,'idx':idx}\n    cover=defaultdict(list)\n    for color, data in info.items():\n        for cell in data['seq']:\n            cover[cell].append(color)\n    out=g.copy()\n    restore=[]\n    for cell, cols in cover.items():\n        if len(cols) == 2:\n            top=int(g[cell])\n            assert top in cols, (cell, cols, top)\n            under=cols[1] if cols[0] == top else cols[0]\n            seq=info[under]['seq']\n            i=info[under]['idx'][cell]\n            prev_, next_ = seq[i-1], seq[i+1]\n            out[prev_] = GREY\n            out[cell] = GREY\n            out[next_] = GREY\n            restore.append((cell, top))\n    for cell, top in restore:\n        out[cell] = top\n    return out\n\nfor t in range(1000):\n    for _ in range(100):\n        h=random.randint(18,26)\n        w=random.randint(18,26)\n        paths=build_paths(h,w)\n        if paths is None:\n            continue\n        rendered=validate_and_render(h,w,paths)\n        if rendered is None:\n            continue\n        inp, exp = rendered\n        got=solve(inp)\n        if not np.array_equal(got, exp):\n            print('mismatch', t)\n            print(inp)\n            print(exp)\n            print(got)\n            raise SystemExit\n        break\n    else:\n        print('failed to generate valid sample')\n        raise SystemExit\nprint('all good')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom __future__ import annotations\nimport random\nfrom collections import defaultdict\nimport numpy as np\n\nBG = 0\nGREY = 5\nPALETTE = [1, 2, 3, 4, 6, 7, 8, 9]\nDIR4 = [(-1,0),(1,0),(0,-1),(0,1)]\n\n\ndef segment_cells(a,b):\n    (r0,c0),(r1,c1)=a,b\n    if r0==r1:\n        step=1 if c1>=c0 else -1\n        return [(r0,c) for c in range(c0,c1+step,step)]\n    if c0==c1:\n        step=1 if r1>=r0 else -1\n        return [(r,c0) for r in range(r0,r1+step,step)]\n    raise ValueError('non-orth')\n\n\ndef polyline_cells(points):\n    out=[]\n    for i in range(len(points)-1):\n        seg=segment_cells(points[i], points[i+1])\n        if i:\n            seg=seg[1:]\n        out.extend(seg)\n    if len(out) \"'!= len(set(out)):\n        raise AssertionError('\"'self overlap')\n    return out\n\n\ndef path_orientations(seq):\n    ori={}\n    idx={cell:i for i,cell in enumerate(seq)}\n    for i,cur in enumerate(seq):\n        if i==0:\n            nxt=seq[1]\n            ori[cur]='H' if nxt[0]==cur[0] else 'V'\n        elif i==len(seq)-1:\n            prv=seq[-2]\n            ori[cur]='H' if prv[0]==cur[0] else 'V'\n        else:\n            prv,nxt=seq[i-1],seq[i+1]\n            if prv[0]==nxt[0]:\n                ori[cur]='H'\n            elif prv[1]==nxt[1]:\n                ori[cur]='V'\n            else:\n                ori[cur]='C'\n    return ori, idx\n\n\ndef marker_cells(side, attach, offset, h, w):\n    r,c=attach\n    if side=='L':\n        top=r-offset\n        return [(top,0),(top,1),(top+1,0),(top+1,1)]\n    if side=='R':\n        top=r-offset\n        return [(top,w-2),(top,w-1),(top+1,w-2),(top+1,w-1)]\n    if side=='T':\n        left=c-offset\n        return [(0,left),(0,left+1),(1,left),(1,left+1)]\n    if side=='B':\n        left=c-offset\n        return [(h-2,left),(h-2,left+1),(h-1,left),(h-1,left+1)]\n    raise ValueError(side)\n\n\ndef pick_value(cands, used, gap):\n    cands=list(cands)\n    random.shuffle(cands)\n    for v in cands:\n        if all(abs(v-u)>=gap for u in used):\n            return v\n    return None\n\n\ndef build_paths(h,w):\n    n_lr=random.randint(1,2)\n    n_tb=random.randint(1,2)\n    colors=random.sample(PALETTE, n_lr+n_tb)\n    row_cands=list(range(4, h-4))\n    col_cands=list(range(4, w-4))\n    left_used=[]; right_used=[]; top_used=[]; bottom_used=[]\n    paths=[]; ci=0\n    for _ in range(n_lr):\n        rs=pick_value(row_cands, left_used, 3)\n        if rs is None:\n            return None\n        left_used.append(rs)\n        straight = random.random() < 0.4\n        rt = pick_value([rs], right_used, 3) if straight else None\n        if rt is None:\n            straight = False\n            rt = pick_value([r for r in row_cands if abs(r-rs) >= 3], right_used, 3)\n        if rt is None:\n            return None\n        right_used.append(rt)\n        start=(rs,2); end=(rt,w-3)\n        if straight:\n            points=[start,end]\n        else:\n            x=random.randint(5, w-6)\n            points=[start,(rs,x),(rt,x),end]\n        seq=polyline_cells(points)\n        paths.append({'color': colors[ci], 'side_a':'L','side_b':'R','attach_a':start,'attach_b':end,'off_a':random.randint(0,1),'off_b':random.randint(0,1),'cells':seq})\n        ci += 1\n    for _ in range(n_tb):\n        cs=pick_value(col_cands, top_used, 3)\n        if cs is None:\n            return None\n        top_used.append(cs)\n        straight = random.random() < 0.4\n        ct = pick_value([cs], bottom_used, 3) if straight else None\n        if ct is None:\n            straight = False\n            ct = pick_value([c for c in col_cands if abs(c-cs) >= 3], bottom_used, 3)\n        if ct is None:\n            return None\n        bottom_used.append(ct)\n        start=(2,cs); end=(h-3,ct)\n        if straight:\n            points=[start,end]\n        else:\n            y=random.randint(5, h-6)\n            points=[start,(y,cs),(y,ct),end]\n        seq=polyline_cells(points)\n        paths.append({'color': colors[ci], 'side_a':'T','side_b':'B','attach_a':start,'attach_b':end,'off_a':random.randint(0,1),'off_b':random.randint(0,1),'cells':seq})\n        ci += 1\n    return paths\n\n\ndef validate_and_render(h,w,paths):\n    all_markers={}\n    marker_owner={}\n    cover=defaultdict(list)\n    ori_by_color={}\n    idx_by_color={}\n    seq_by_color={}\n    cell_sets={}\n    attachments={}\n    for p in paths:\n        color=p['color']\n        seq=p['cells']\n        seq_by_color[color]=seq\n        cell_sets[color]=set(seq)\n        attachments[color]={p['attach_a'], p['attach_b']}\n        ori, idx = path_orientations(seq)\n        ori_by_color[color]=ori\n        idx_by_color[color]=idx\n        markers=set(marker_cells(p['side_a'],p['attach_a'],p['off_a'],h,w)+marker_cells(p['side_b'],p['attach_b'],p['off_b'],h,w))\n        if len(markers)\"'!=8:\n            return None\n        all_markers[color]=markers\n        for m in markers:\n            if m in marker_owner:\n                return None\n            marker_owner[m]=color\n        if any(cell in markers for cell in seq):\n            return None\n        for att, side, off in ((p['\"'attach_a'],p['side_a'],p['off_a']), (p['attach_b'],p['side_b'],p['off_b'])):\n            ms=set(marker_cells(side, att, off, h, w))\n            adj={nbr for m in ms for nbr in ((m[0]-1,m[1]),(m[0]+1,m[1]),(m[0],m[1]-1),(m[0],m[1]+1)) if 0<=nbr[0]<h and 0<=nbr[1]<w and nbr not in ms}\n            if att not in adj or len(cell_sets[color] & adj) \"'!= 1:\n                return None\n        for cell in seq:\n            cover[cell].append(color)\n    for color, cells in cell_sets.items():\n        for cell in cells:\n            for dr,dc in DIR4:\n                nbr=(cell[0]+dr, cell[1]+dc)\n                if nbr in marker_owner and marker_owner[nbr] != color:\n                    return None\n                if nbr in marker_owner and marker_owner[nbr] == color and cell not in attachments[color]:\n                    return None\n    crossings=[]\n    for cell, cols in cover.items():\n        if len(cols) > 2:\n            return None\n        if len(cols) == 2:\n            a,b=cols\n            ia=idx_by_color[a][cell]\n            ib=idx_by_color[b][cell]\n            oa=ori_by_color[a][cell]\n            ob=ori_by_color[b][cell]\n            if oa not in '\"'HV' or ob not in 'HV' or oa == ob:\n                return None\n            if ia <= 1 or ia >= len(seq_by_color[a]) - 2 or ib <= 1 or ib >= len(seq_by_color[b]) - 2:\n                return None\n            if len(cover[seq_by_color[a][ia-1]]) \"'!= 1 or len(cover[seq_by_color[a][ia+1]]) != 1:\n                return None\n            if len(cover[seq_by_color[b][ib-1]]) != 1 or len(cover[seq_by_color[b][ib+1]]) != 1:\n                return None\n            crossings.append((cell,a,b))\n    if not crossings:\n        return None\n    singles={cell: cols[0] for cell, cols in cover.items() if len(cols) == 1}\n    for cell, color in singles.items():\n        for dr,dc in DIR4:\n            nbr=(cell[0]+dr, cell[1]+dc)\n            if nbr in singles and singles[nbr] != color:\n                return None\n    grid=np.full((h,w), BG, dtype=int)\n    for color, markers in all_markers.items():\n        for m in markers:\n            grid[m]=color\n    for color, seq in seq_by_color.items():\n        for cell in seq:\n            grid[cell]=color\n    top_by_cross={}\n    for cell, a, b in crossings:\n        top=random.choice([a,b])\n        top_by_cross[cell]=top\n        grid[cell]=top\n    out=grid.copy()\n    for cell, a, b in crossings:\n        top=top_by_cross[cell]\n        under=b if top == a else a\n        seq=seq_by_color[under]\n        idx=idx_by_color[under][cell]\n        prev_, next_ = seq[idx-1], seq[idx+1]\n        out[prev_] = GREY\n        out[cell] = GREY\n        out[next_] = GREY\n    for cell, top in top_by_cross.items():\n        out[cell] = top\n    return grid, out\n\n\ndef detect_markers(g):\n    h,w=g.shape\n    by_color=defaultdict(list)\n    seen=set()\n    for r in range(h-1):\n        for c in range(w-1):\n            col=int(g[r,c])\n            if col == BG:\n                continue\n            if int(g[r+1,c]) == col and int(g[r,c+1]) == col and int(g[r+1,c+1]) == col:\n                key=(col,r,c)\n                if key not in seen:\n                    by_color[col].append({(r,c),(r+1,c),(r,c+1),(r+1,c+1)})\n                    seen.add(key)\n    return by_color\n\n\ndef neighbors(cell,h,w):\n    r,c=cell\n    for dr,dc in DIR4:\n        rr,cc=r+dr,c+dc\n        if 0<=rr<h and 0<=cc<w:\n            yield (rr,cc)\n\n\ndef reconstruct_path(g, color, markers):\n    h,w=g.shape\n    marker_cells=set().union(*markers)\n    visible={tuple(x) for x in np.argwhere(g == color)} - marker_cells\n    attachments=[]\n    for marker in markers:\n        adj={nbr for cell in marker for nbr in neighbors(cell,h,w) if nbr in visible and nbr not in marker}\n        assert len(adj) == 1, (color, marker, adj)\n        attachments.append(next(iter(adj)))\n    hidden={}\n    for r in range(h):\n        for c in range(w):\n            cell=(r,c)\n            if cell in marker_cells or int(g[cell]) in (BG, color):\n                continue\n            hor = c-1 >= 0 and c+1 < w and (r,c-1) in visible and (r,c+1) in visible\n            ver = r-1 >= 0 and r+1 < h and (r-1,c) in visible and (r+1,c) in visible\n            if hor ''^ ver:\n                hidden[cell] = '\"'H' if hor else 'V'\n    nodes = visible | set(hidden)\n    adj={cell:set() for cell in nodes}\n    for cell in nodes:\n        r,c=cell\n        for nbr in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):\n            if nbr in nodes:\n                adj[cell].add(nbr)\n    assert len(attachments) == 2\n    for att in attachments:\n        assert len(adj[att]) == 1, (color, att, adj[att])\n    for cell, nbrs in adj.items():\n        if cell in attachments:\n            continue\n        assert len(nbrs) == 2, (color, cell, hidden.get(cell), nbrs)\n    for cell, axis in hidden.items():\n        nbrs=sorted(adj[cell])\n        if axis == 'H':\n            assert nbrs[0][0] == cell[0] == nbrs[1][0], (color, cell, axis, nbrs)\n        else:\n            assert nbrs[0][1] == cell[1] == nbrs[1][1], (color, cell, axis, nbrs)\n    start,end = attachments\n    seq=[start]\n    prev=None\n    cur=start\n    while cur \"'!= end:\n        nxts=[n for n in adj[cur] if n != prev]\n        assert len(nxts) == 1, (color, cur, prev, nxts)\n        nxt=nxts[0]\n        seq.append(nxt)\n        prev,cur = cur,nxt\n        assert len(seq) <= len(nodes) + 1\n    assert set(seq) == nodes, (color, len(seq), len(nodes), nodes - set(seq))\n    idx={cell:i for i,cell in enumerate(seq)}\n    return seq, idx\n\n\ndef solve(g):\n    g=np.asarray(g, dtype=int)\n    markers=detect_markers(g)\n    info={}\n    for color, wins in markers.items():\n        assert len(wins) == 2, (color, len(wins))\n        seq, idx = reconstruct_path(g, color, wins)\n        info[color]={'\"'seq':seq,'idx':idx}\n    cover=defaultdict(list)\n    for color, data in info.items():\n        for cell in data['seq']:\n            cover[cell].append(color)\n    out=g.copy()\n    restore=[]\n    for cell, cols in cover.items():\n        if len(cols) == 2:\n            top=int(g[cell])\n            assert top in cols, (cell, cols, top)\n            under=cols[1] if cols[0] == top else cols[0]\n            seq=info[under]['seq']\n            i=info[under]['idx'][cell]\n            prev_, next_ = seq[i-1], seq[i+1]\n            out[prev_] = GREY\n            out[cell] = GREY\n            out[next_] = GREY\n            restore.append((cell, top))\n    for cell, top in restore:\n        out[cell] = top\n    return out\n\nfor t in range(1000):\n    for _ in range(100):\n        h=random.randint(18,26)\n        w=random.randint(18,26)\n        paths=build_paths(h,w)\n        if paths is None:\n            continue\n        rendered=validate_and_render(h,w,paths)\n        if rendered is None:\n            continue\n        inp, exp = rendered\n        got=solve(inp)\n        if not np.array_equal(got, exp):\n            print('mismatch', t)\n            print(inp)\n            print(exp)\n            print(got)\n            raise SystemExit\n        break\n    else:\n        print('failed to generate valid sample')\n        raise SystemExit\nprint('all good')\nPY\"","aggregated_output":"all good\n","exit_code":0,"status":"completed"}}
