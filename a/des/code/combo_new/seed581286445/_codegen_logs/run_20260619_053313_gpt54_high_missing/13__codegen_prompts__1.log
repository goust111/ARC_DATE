 679\t\n   680\t    grid = _draw(objects, bg, fg)\n   681\t    if grid is None:\n   682\t        return None\n   683\t    expected = _expected_output(root, outside, bg, fg)\n   684\t    try:\n   685\t        got = main(grid)\n   686\t    except Exception:\n   687\t        return None\n   688\t    if not np.array_equal(got, expected):\n   689\t        return None\n   690\t    return grid\n   691\t\n   692\t\n   693\tdef generate_input():\n   694\t    for _ in range(GEN_RETRIES):\n   695\t        grid = _gen_attempt()\n   696\t        if grid is not None:\n   697\t            return grid\n   698\t    raise RuntimeError(\"failed to generate valid 2d0172a1 input\")\n","exit_code":0,"status":"completed"}}
