{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c 'for f in /home/lixinyu/snap/new/ARC_code/train/6cbe9eb8.py /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py /home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py /home/lixinyu/snap/new/ARC_code/eval/a6f40cea.py /home/lixinyu/snap/new/ARC_code/eval/7491f3cf.py /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py /home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py /home/lixinyu/snap/new/ARC_code/train/57edb29d.py; do echo FILE:$f; sed -n '\"'1,260p' \\\"\"'$f\"; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c 'for f in /home/lixinyu/snap/new/ARC_code/train/6cbe9eb8.py /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py /home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py /home/lixinyu/snap/new/ARC_code/eval/a6f40cea.py /home/lixinyu/snap/new/ARC_code/eval/7491f3cf.py /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py /home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py /home/lixinyu/snap/new/ARC_code/train/57edb29d.py; do echo FILE:$f; sed -n '\"'1,260p' \\\"\"'$f\"; done'","aggregated_output":"FILE:/home/lixinyu/snap/new/ARC_code/train/6cbe9eb8.py\nfrom __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, paste\n\n\ndef _rect_item(g: np.ndarray, color: int) -> dict:\n    coords = np.argwhere(g == int(color))\n    assert coords.size, \"expected a present color\"\n    r0, c0, r1, c1 = bbox_coords(coords)\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    area = h * w\n\n    rel = coords - np.array([r0, c0])\n    on_border = (\n        (rel[:, 0] == 0)\n        | (rel[:, 0] == h - 1)\n        | (rel[:, 1] == 0)\n        | (rel[:, 1] == w - 1)\n    )\n    if int(coords.shape[0]) == area:\n        kind = \"solid\"\n    else:\n        assert bool(np.all(on_border)), \"foreground colors must form rectangles or rectangular frames\"\n        kind = \"frame\"\n\n    return {\n        \"color\": int(color),\n        \"kind\": kind,\n        \"height\": h,\n        \"width\": w,\n        \"area\": area,\n    }\n\n\ndef _foreground_rectangles(g: np.ndarray) -> list[dict]:\n    items = []\n    for color in np.unique(g):\n        comps = components_mask(g == int(color), connectivity=4)\n        sizes = [int(comp.shape[0]) for comp in comps]\n        assert sizes, \"unique colors must have at least one component\"\n\n        # Wallpaper colors appear as many tiny disconnected islands; overlaid\n        # rectangle colors have one large component, sometimes split by occlusion.\n        if max(sizes) <= 3:\n            continue\n        assert len(comps) <= 4, \"foreground rectangle colors have only a few visible components\"\n        items.append(_rect_item(g, int(color)))\n\n    assert len(items) >= 2, \"expected at least two nested foreground rectangles\"\n    areas = [item[\"area\"] for item in items]\n    assert len(areas) == len(set(areas)), \"rectangle areas must define a unique nesting order\"\n    items.sort(key=lambda item: int(item[\"area\"]), reverse=True)\n    return items\n\n\ndef _paint_item(out: np.ndarray, item: dict, r: int, c: int) -> tuple[int, int, int, int]:\n    color = int(item[\"color\"])\n    h = int(item[\"height\"])\n    w = int(item[\"width\"])\n    assert 0 <= r and 0 <= c and r + h <= out.shape[0] and c + w <= out.shape[1]\n\n    if item[\"kind\"] == \"solid\":\n        out[r : r + h, c : c + w] = color\n        return r, c, h, w\n\n    assert item[\"kind\"] == \"frame\"\n    assert h >= 3 and w >= 3, \"frames must have an interior\"\n    out[r, c : c + w] = color\n    out[r + h - 1, c : c + w] = color\n    out[r : r + h, c] = color\n    out[r : r + h, c + w - 1] = color\n    return r + 1, c + 1, h - 2, w - 2\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rebuild the foreground rectangles as a largest-to-smallest lower-left nesting.\n\n    Input structure\n    - A periodic wallpaper background is overlaid by foreground colors that each form a rectangular frame or solid rectangle.\n    - The largest foreground rectangle is the output frame; smaller foreground rectangles are the objects to nest inside it.\n    - A frame may be partially hidden by a smaller rectangle, but its visible pixels still determine its bbox.\n\n    Rule\n    - Ignore the wallpaper and crop the result to the largest foreground rectangle's bbox size.\n    - Sort foreground rectangles by bbox area from largest to smallest.\n    - Reconstruct each frame or solid rectangle, placing every next smaller rectangle in the lower-left of the current rectangle's usable region.\n\n    Key insight\n    - The scattered background colors are not objects; the meaningful order is the unique descending rectangle size chain, and each step nests into the previous rectangle's lower-left interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    items = _foreground_rectangles(g)\n    outer = items[0]\n    out = np.zeros((int(outer[\"height\"]), int(outer[\"width\"])), dtype=int)\n\n    region = _paint_item(out, outer, 0, 0)\n    for item in items[1:]:\n        rr, cc, rh, rw = region\n        h = int(item[\"height\"])\n        w = int(item[\"width\"])\n        assert h <= rh and w <= rw, \"nested rectangle must fit in parent usable region\"\n        r = rr + rh - h\n        c = cc\n        region = _paint_item(out, item, r, c)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n_RNG = np.random.default_rng()\n\n# Colors and sentinels.\nCOLOR_VALUES, FOREGROUND_COLORS = tuple(range(10)), tuple(range(1, 10))\nTRANSPARENT = -1\n# Rectangle chain counts.\nITEM_COUNT_RANGE, THREE_ITEM_FRAME_OPTIONS = (3, 4), (1, 2)\nFOUR_ITEM_FRAME_COUNT = 2\n# Solid rectangle dimensions.\nINNER_SOLID_HEIGHT_RANGE, INNER_SOLID_WIDTH_RANGE = (2, 3), (2, 3)\nSECOND_SOLID_MAX_HEIGHT, SECOND_SOLID_MAX_WIDTH = 9, 9\n# Frame growth and bounds.\nFRAME_MIN_GROWTH, INNER_FRAME_MAX_GROWTH = 2, 5\nINNER_FRAME_MAX_HEIGHT, INNER_FRAME_MAX_WIDTH = 13, 11\nOUTER_FRAME_MIN_HEIGHT, OUTER_FRAME_MIN_WIDTH = 8, 8\nOUTER_FRAME_MAX_HEIGHT, OUTER_FRAME_MAX_WIDTH = 15, 13\n# Wallpaper canvas bounds and margin around the outer rectangle.\nCANVAS_HEIGHT_RANGE, CANVAS_WIDTH_RANGE = (13, 19), (22, 27)\nCANVAS_BORDER_MARGIN = 1\n# Wallpaper tile/color sampling.\nWALLPAPER_COLOR_COUNT_RANGE = (2, 4)\nZERO_WALLPAPER_ROLL_RANGE = (0, 4)\nZERO_WALLPAPER_THRESHOLD = 3\nTILE_SIZE_2 = 2\nTILE_SIZE_OPTIONS, TILE3_SIGN_OPTIONS = (2, 3), (1, 2)\n# Visibility/oracle retry limits.\nVISIBLE_OUTER_MIN_COMPONENT, MAX_VISIBLE_OUTER_COMPONENTS = 3, 4\nGENERATION_RETRY_LIMIT = 300\n\n\ndef _randint(lo: int, hi: int) -> int:\n    return int(_RNG.integers(int(lo), int(hi) + 1))\n\n\ndef _choice(seq):\n    return seq[_randint(0, len(seq) - 1)]\n\n\ndef _sample(seq, k: int) -> list[int]:\n    idx = _RNG.choice(len(seq), size=int(k), replace=False)\n    return [int(seq[int(i)]) for i in idx]\n\n\ndef _shuffled(seq) -> list[int]:\n    vals = list(seq)\n    _RNG.shuffle(vals)\n    return [int(v) for v in vals]\n\n\ndef _choose_dims(\n    h_min: int,\n    h_max: int,\n    w_min: int,\n    w_max: int,\n    used_areas: set[int],\n    *,\n    min_area: int = 0,\n) -> tuple[int, int] | None:\n    pairs = [\n        (h, w)\n        for h in range(int(h_min), int(h_max) + 1)\n        for w in range(int(w_min), int(w_max) + 1)\n        if h * w > int(min_area) and h * w not in used_areas\n    ]\n    return _choice(pairs) if pairs else None\n\n\ndef _build_items() -> list[dict]:\n    \"\"\"Build a largest-to-smallest rectangle chain with unique bbox areas.\"\"\"\n    n_items = _randint(*ITEM_COUNT_RANGE)\n    if n_items == ITEM_COUNT_RANGE[1]:\n        n_frames = FOUR_ITEM_FRAME_COUNT\n    else:\n        n_frames = _choice(THREE_ITEM_FRAME_OPTIONS)\n    n_solids = n_items - n_frames\n\n    colors = _sample(FOREGROUND_COLORS, n_items)\n    chain = []\n    used_areas: set[int] = set()\n\n    h = _randint(*INNER_SOLID_HEIGHT_RANGE)\n    w = _randint(*INNER_SOLID_WIDTH_RANGE)\n    chain.append({\"kind\": \"solid\", \"height\": h, \"width\": w})\n    used_areas.add(h * w)\n\n    if n_solids == 2:\n        dims = _choose_dims(h, SECOND_SOLID_MAX_HEIGHT, w, SECOND_SOLID_MAX_WIDTH, used_areas, min_area=h * w)\n        if dims is None:\n            return []\n        h, w = dims\n        chain.append({\"kind\": \"solid\", \"height\": h, \"width\": w})\n        used_areas.add(h * w)\n\n    if n_frames == 2:\n        dims = _choose_dims(\n            h + FRAME_MIN_GROWTH,\n            min(INNER_FRAME_MAX_HEIGHT, h + INNER_FRAME_MAX_GROWTH),\n            w + FRAME_MIN_GROWTH,\n            min(INNER_FRAME_MAX_WIDTH, w + INNER_FRAME_MAX_GROWTH),\n            used_areas,\n        )\n        if dims is None:\n            return []\n        h, w = dims\n        chain.append({\"kind\": \"frame\", \"height\": h, \"width\": w})\n        used_areas.add(h * w)\n\n    dims = _choose_dims(\n        max(OUTER_FRAME_MIN_HEIGHT, h + FRAME_MIN_GROWTH),\n        OUTER_FRAME_MAX_HEIGHT,\n        max(OUTER_FRAME_MIN_WIDTH, w + FRAME_MIN_GROWTH),\n        OUTER_FRAME_MAX_WIDTH,\n        used_areas,\n    )\n    if dims is None:\n        return []\n    h, w = dims\n    chain.append({\"kind\": \"frame\", \"height\": h, \"width\": w})\n\n    items = list(reversed(chain))\n    for item, color in zip(items, colors):\n        item[\"color\"] = int(color)\n        item[\"area\"] = int(item[\"height\"] * item[\"width\"])\n    return items\n\n\ndef _item_size(item: dict) -> tuple[int, int]:\n    return int(item[\"height\"]), int(item[\"width\"])\n\n\ndef _paint_item_view(view: np.ndarray, item: dict) -> None:\n    color = int(item[\"color\"])\n    if item[\"kind\"] == \"solid\":\n        view[:, :] = color\n    else:\n        view[0, :] = color\n        view[-1, :] = color\n        view[:, 0] = color\n        view[:, -1] = color\n\n\ndef _gen_paint_item(out: np.ndarray, item: dict, r: int, c: int) -> tuple[int, int, int, int]:\n    h, w = _item_size(item)\n    _paint_item_view(out[r : r + h, c : c + w], item)\n    if item[\"kind\"] == \"solid\":\nFILE:/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\nimport numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):\n        b = int(b)\n        f = int(f)\n        if b == bg:\n            continue\n        mapping[b] = f\n\n    return mapping, pal_mask\n\n\ndef _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:\n    \"\"\"\n    Find background regions (excluding the palette area) that do NOT touch the grid boundary,\n    and fill each region based on the most common adjacent border color (mapped via palette).\n    \"\"\"\n    h, w = out.shape\n    bg_mask = (out == bg) & (~pal_mask)\n    comps = components_mask(bg_mask, connectivity=4)\n    for pts in comps:\n        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n        if touches_boundary:\n            continue\n\n        adj_counts: dict[int, int] = {}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < h and 0 <= cc < w:\n                    if pal_mask[rr, cc]:\n                        continue\n                    v = int(out[rr, cc])\n                    if v == bg:\n                        continue\n                    adj_counts[v] = adj_counts.get(v, 0) + 1\n        if not adj_counts:\n            continue\n\n        # Prefer an adjacent color that exists in the mapping; pick the most frequent border.\n        border = None\n        best = -1\n        for col, cnt in adj_counts.items():\nFILE:/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py\nfrom __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, label_mask, paste\nimport random\n\n\nclass _Node:\n    def __init__(self, coords: np.ndarray, bbox: tuple[int, int, int, int], center: np.ndarray):\n        self.coords = coords\n        self.bbox = bbox\n        self.center = center\n        self.is_frame = False\n        self.parent: _Node | None = None\n        self.children: list[_Node] = []\n        self.mask: np.ndarray | None = None\n        self.anchor: tuple[int, int] | None = None\n        self.axis_map: dict[str, list[tuple[float, int]]] = {\"row\": [], \"col\": []}\n\n\ndef _component_holes(shape: tuple[int, int], coords: np.ndarray) -> list[np.ndarray]:\n    mask = np.zeros(shape, dtype=bool)\n    mask[tuple(coords.T)] = True\n    lab, n = label_mask(~mask, connectivity=4)\n    boundary = set(lab[0, :]) | set(lab[-1, :]) | set(lab[:, 0]) | set(lab[:, -1])\n    return [(lab == k) for k in range(1, n + 1) if k not in boundary]\n\n\ndef _intervals_overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:\n    return max(a[0], b[0]) <= min(a[1], b[1])\n\n\ndef _build_layout(node: _Node) -> None:\n    if node.mask is not None:\n        return\n\n    if not node.is_frame:\n        node.mask = np.ones((1, 1), dtype=bool)\n        node.anchor = (0, 0)\n        node.axis_map = {\n            \"row\": [(float(node.center[0]), 0)],\n            \"col\": [(float(node.center[1]), 0)],\n        }\n        return\n\n    assert node.children\n    child_mask, _placements, axis_map = _layout_group(node.children)\n    h, w = child_mask.shape\n    out = np.zeros((h + 4, w + 4), dtype=bool)\n    out[0, :] = True\n    out[-1, :] = True\n    out[:, 0] = True\n    out[:, -1] = True\n    out[2 : 2 + h, 2 : 2 + w] |= child_mask\n\n    node.mask = out\n    node.anchor = (out.shape[0] // 2, out.shape[1] // 2)\n    node.axis_map = {\n        \"row\": [(orig, pos + 2) for orig, pos in axis_map[\"row\"]],\n        \"col\": [(orig, pos + 2) for orig, pos in axis_map[\"col\"]],\n    }\n\n\ndef _axis_coordinates(nodes: list[_Node], axis: int) -> dict[_Node, int]:\n    items = []\n    for node in nodes:\n        assert node.mask is not None and node.anchor is not None\n        r0, c0, r1, c1 = node.bbox\n        interval = (r0, r1) if axis == 0 else (c0, c1)\n        mid = (interval[0] + interval[1]) / 2\n        items.append((node, interval, mid, node.anchor[axis], node.mask.shape[axis]))\n\n    bands: list[dict] = []\n    for item in sorted(items, key=lambda x: x[2]):\n        interval = item[1]\n        for band in bands:\n            if any(_intervals_overlap(interval, other[1]) for other in band[\"items\"]):\n                band[\"items\"].append(item)\n                band[\"interval\"] = (\n                    min(band[\"interval\"][0], interval[0]),\n                    max(band[\"interval\"][1], interval[1]),\n                )\n                break\n        else:\n            bands.append({\"items\": [item], \"interval\": interval})\n\n    coord_by_node: dict[_Node, int] = {}\n    coord = 0\n    for i, band in enumerate(bands):\n        if i:\n            prev = bands[i - 1]\n            prev_down = max(item[4] - 1 - item[3] for item in prev[\"items\"])\n            curr_up = max(item[3] for item in band[\"items\"])\n            coord += prev_down + 2 + curr_up\n        for item in band[\"items\"]:\n            coord_by_node[item[0]] = int(coord)\n\n    return coord_by_node\n\n\ndef _layout_group(nodes: list[_Node]) -> tuple[np.ndarray, dict[_Node, tuple[int, int]], dict[str, list[tuple[float, int]]]]:\n    assert nodes\n    for node in nodes:\n        _build_layout(node)\n\n    row_coord = _axis_coordinates(nodes, axis=0)\n    col_coord = _axis_coordinates(nodes, axis=1)\n\n    min_r = min(row_coord[n] - n.anchor[0] for n in nodes if n.anchor is not None)\n    min_c = min(col_coord[n] - n.anchor[1] for n in nodes if n.anchor is not None)\n    max_r = max(\n        row_coord[n] - n.anchor[0] - min_r + n.mask.shape[0]\n        for n in nodes\n        if n.anchor is not None and n.mask is not None\n    )\n    max_c = max(\n        col_coord[n] - n.anchor[1] - min_c + n.mask.shape[1]\n        for n in nodes\n        if n.anchor is not None and n.mask is not None\n    )\n\n    out = np.zeros((max_r, max_c), dtype=bool)\n    placements: dict[_Node, tuple[int, int]] = {}\n    axis_map = {\"row\": [], \"col\": []}\n    for node in nodes:\n        assert node.mask is not None and node.anchor is not None\n        r = row_coord[node] - node.anchor[0] - min_r\n        c = col_coord[node] - node.anchor[1] - min_c\n        placements[node] = (int(r), int(c))\n        out[r : r + node.mask.shape[0], c : c + node.mask.shape[1]] |= node.mask\n        axis_map[\"row\"].append((float(node.center[0]), int(r + node.anchor[0])))\n        axis_map[\"col\"].append((float(node.center[1]), int(c + node.anchor[1])))\n\n    return out, placements, axis_map\n\n\ndef _outside_side(dot: _Node, frame: _Node) -> str:\n    r0, c0, r1, c1 = dot.bbox\n    fr0, fc0, fr1, fc1 = frame.bbox\n    if c0 > fc1:\n        return \"right\"\n    if c1 < fc0:\n        return \"left\"\n    if r0 > fr1:\n        return \"bottom\"\n    if r1 < fr0:\n        return \"top\"\n\n    dr = float(dot.center[0] - (fr0 + fr1) / 2)\n    dc = float(dot.center[1] - (fc0 + fc1) / 2)\n    if abs(dc) >= abs(dr):\n        return \"right\" if dc > 0 else \"left\"\n    return \"bottom\" if dr > 0 else \"top\"\n\n\ndef _map_frame_axis(frame: _Node, axis: int, value: float) -> int:\n    assert frame.anchor is not None\n    key = \"row\" if axis == 0 else \"col\"\n    candidates = frame.axis_map[key]\n    if not candidates:\n        return int(frame.anchor[axis])\n    return int(min(candidates, key=lambda item: abs(item[0] - value))[1])\n\n\ndef _layout_root(nodes: list[_Node]) -> np.ndarray:\n    assert nodes\n    for node in nodes:\n        _build_layout(node)\n\n    frames = [node for node in nodes if node.is_frame]\n    dots = [node for node in nodes if not node.is_frame]\n    if len(frames) == 1 and dots:\n        frame = frames[0]\n        assert frame.mask is not None\n        placements: dict[_Node, tuple[int, int]] = {frame: (0, 0)}\n        extents = [(0, 0, frame.mask.shape[0], frame.mask.shape[1])]\n\n        for dot in dots:\n            side = _outside_side(dot, frame)\n            if side in {\"right\", \"left\"}:\n                r = _map_frame_axis(frame, 0, float(dot.center[0]))\n                c = frame.mask.shape[1] + 1 if side == \"right\" else -2\n            else:\n                r = frame.mask.shape[0] + 1 if side == \"bottom\" else -2\n                c = _map_frame_axis(frame, 1, float(dot.center[1]))\n            placements[dot] = (int(r), int(c))\n            extents.append((r - 1, c - 1, r + 2, c + 2))\n\n        min_r = min(e[0] for e in extents)\n        min_c = min(e[1] for e in extents)\n        max_r = max(e[2] for e in extents)\n        max_c = max(e[3] for e in extents)\n        out = np.zeros((max_r - min_r, max_c - min_c), dtype=bool)\n        for node, (r, c) in placements.items():\n            rr = r - min_r\n            cc = c - min_c\n            if node is frame:\n                out[rr : rr + frame.mask.shape[0], cc : cc + frame.mask.shape[1]] |= frame.mask\n            else:\n                out[rr, cc] = True\n        return out\n\n    mask, _placements, _axis_map = _layout_group(nodes)\n    return mask\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert a rough nested line drawing into a clean canonical frame-and-dot diagram.\n\n    Input structure:\n    - The grid has one background color and one foreground color.\n    - Foreground 4-connected objects are rough closed frames or small filled blobs.\n    - Frames may contain other frames/blobs; blobs outside a frame remain outside it.\n\n    Rule:\n    - Detect the containment tree of foreground objects using holes of each frame object.\n    - Replace every blob with one foreground pixel.\n    - Replace every frame with a rectangular border padded two cells around its direct children.\n    - Place siblings by their original row/column overlap and order, with one empty cell between canonical objects.\n\n    Key insight: The exact wobbly geometry is irrelevant; only enclosure plus relative sibling positions define the output.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    fg_colors = sorted(set(map(int, g.flatten())) - {bg})\n    assert len(fg_colors) == 1\n    fg = int(fg_colors[0])\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg], return_format=\"dict\")\n    assert comps\n\n    nodes: list[_Node] = []\n    holes: list[list[np.ndarray]] = []\n    for comp in comps:\n        coords = np.asarray(comp[\"coords\"], dtype=int)\n        node = _Node(\n            coords=coords,\n            bbox=tuple(map(int, comp[\"bbox\"])),\n            center=coords.mean(axis=0),\n        )\n        node_holes = _component_holes(g.shape, coords)\n        node.is_frame = bool(node_holes)\n        nodes.append(node)\n        holes.append(node_holes)\n\n    assert any(node.is_frame for node in nodes)\n    for node_i, node in enumerate(nodes):\n        containers = []\n        for frame_i, frame in enumerate(nodes):\n            if node_i == frame_i or not frame.is_frame:\n                continue\n            if any(np.all(hole[tuple(node.coords.T)]) for hole in holes[frame_i]):\n                containers.append(frame)\n        if containers:\n            node.parent = min(containers, key=lambda item: int(item.coords.shape[0]))\n            node.parent.children.append(node)\n\n    roots = [node for node in nodes if node.parent is None]\nFILE:/home/lixinyu/snap/new/ARC_code/eval/a6f40cea.py\nfrom __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom scipy.ndimage import label\nfrom arc_utils import STRUCT4, get_bg\nimport random\n\ndef _find_framed_rect_uniform_fill(\n    g: np.ndarray,\n    *,\n    bg: int | None = None,\n    structure=STRUCT4,\n) -> tuple[int, int, int, int, int, int] | None:\n    \"\"\"\n    Detect the main 1px-thick rectangular frame with uniform interior fill.\n\n    Returns (r0, c0, r1, c1, border_color, fill_color) for the largest such rectangle, else None.\n    \"\"\"\n    if bg is None:\n        bg = int(get_bg(g))\n    else:\n        bg = int(bg)\n\n    best = None  # (area, r0,c0,r1,c1, bc, fill)\n    for bc in sorted(set(map(int, g.flatten())) - {int(bg)}):\n        lab, n = label(g == int(bc), structure=structure)\n        for cid in range(1, int(n) + 1):\n            pts = np.argwhere(lab == int(cid))\n            if int(len(pts)) < 8:\n                continue\n\n            r0, c0 = pts.min(axis=0)\n            r1, c1 = pts.max(axis=0)\n            r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n            h = int(r1 - r0 + 1)\n            w = int(c1 - c0 + 1)\n            if h < 3 or w < 3:\n                continue\n\n            # \"Complete rectangle border\" = exactly the perimeter, and all bbox-border cells are bc.\n            per = int(2 * (h + w) - 4)\n            if int(len(pts)) != per:\n                continue\n            if not (g[r0, c0 : c1 + 1] == int(bc)).all():\n                continue\n            if not (g[r1, c0 : c1 + 1] == int(bc)).all():\n                continue\n            if not (g[r0 : r1 + 1, c0] == int(bc)).all():\n                continue\n            if not (g[r0 : r1 + 1, c1] == int(bc)).all():\n                continue\n\n            inner = g[r0 + 1 : r1, c0 + 1 : c1]\n            if inner.size == 0:\n                continue\n            fill = int(Counter(inner.flatten()).most_common(1)[0][0])\n            if fill == int(bc):\n                continue\n            if not (inner == int(fill)).all():\n                continue\n\n            area = int(h * w)\n            cand = (area, r0, c0, r1, c1, int(bc), int(fill))\n            if best is None or cand[0] > best[0]:\n                best = cand\n\n    if best is None:\n        return None\n    _area, r0, c0, r1, c1, bc, fill = best\n    return int(r0), int(c0), int(r1), int(c1), int(bc), int(fill)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete partial paths inside a framed rectangle by projecting external color traces inward.\n\n    Input structure:\n    - bg, a 1px rectangular frame (border color) with uniform interior fill.\n    - Colored components outside the frame touching its edges.\n\n    Rule:\n    - Output = the frame's interior, filled with the fill color.\n    - Map each outside component's frame-touch points into interior coordinates.\n    - Monochrome components become solid Manhattan stripes between mapped endpoints.\n    - Two-color components become alternating-color Manhattan paths.\n\n    Key insight: Endpoint colors of two-color traces anchor the alternating phase deterministically.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    found = _find_framed_rect_uniform_fill(g, bg=int(bg))\n    assert not (found is None)\n    r0, c0, r1, c1, bc, fill = found\n    outH = int(r1 - r0 - 1)\n    outW = int(c1 - c0 - 1)\n    out = np.full((outH, outW), int(fill), dtype=int)\n    r_int0 = int(r0 + 1)\n    c_int0 = int(c0 + 1)\n\n    def map_to_out(rr: int, cc: int) -> tuple[int, int]:\n        r = max(0, min(outH - 1, int(rr - r_int0)))\n        c = max(0, min(outW - 1, int(cc - c_int0)))\n        return int(r), int(c)\n\n    def build_manhattan(p1: tuple[int, int], p2: tuple[int, int], cornerA: bool) -> list[tuple[int, int]]:\n        (ra, ca), (rb, cb) = p1, p2\n        if ra == rb:\n            step = 1 if cb >= ca else -1\n            return [(int(ra), int(c)) for c in range(int(ca), int(cb) + step, step)]\n        if ca == cb:\n            step = 1 if rb >= ra else -1\n            return [(int(r), int(ca)) for r in range(int(ra), int(rb) + step, step)]\n        if cornerA:\n            step = 1 if rb >= ra else -1\n            path = [(int(r), int(ca)) for r in range(int(ra), int(rb) + step, step)]\n            step = 1 if cb >= ca else -1\n            path += [(int(rb), int(c)) for c in range(int(ca) + step, int(cb) + step, step)]\n            return path\n        step = 1 if cb >= ca else -1\n        path = [(int(ra), int(c)) for c in range(int(ca), int(cb) + step, step)]\n        step = 1 if rb >= ra else -1\n        path += [(int(r), int(cb)) for r in range(int(ra) + step, int(rb) + step, step)]\n        return path\n\n    def inside_corner(p1: tuple[int, int], p2: tuple[int, int], cornerA: bool) -> bool:\n        (ra, ca), (rb, cb) = p1, p2\n        if ra == rb or ca == cb:\n            return True\n        corner = (rb, ca) if cornerA else (ra, cb)\n        rr, cc = corner\n        return (0 < rr < outH - 1) and (0 < cc < outW - 1)\n\n    # --- ring components (outside the frame) ---\n    comp_mask = (g != int(bg)) & (g != int(fill)) & (g != int(bc))\n    clab, cn = label(comp_mask, structure=STRUCT4)\n\n    ring = set()\n    for cc in range(c0, c1 + 1):\n        for rr in (r0 - 1, r1 + 1):\n            if 0 <= rr < H:\n                ring.add((int(rr), int(cc)))\n    for rr in range(r0, r1 + 1):\n        for cc in (c0 - 1, c1 + 1):\n            if 0 <= cc < W:\n                ring.add((int(rr), int(cc)))\n\n    # cid -> list of (mapped_r, mapped_c, color)\n    comp_pts: dict[int, list[tuple[int, int, int]]] = defaultdict(list)\n    for rr, cc in ring:\n        cid = int(clab[rr, cc])\n        if cid == 0:\n            continue\n        col = int(g[rr, cc])\n        mr, mc = map_to_out(rr, cc)\n        comp_pts[cid].append((mr, mc, col))\n\n    # per-component color sets\n    comp_cols: dict[int, list[int]] = {}\n    for cid in range(1, int(cn) + 1):\n        comp_cols[cid] = sorted(set(map(int, g[clab == int(cid)].flatten())))\n\n    deferred: dict[int, set[tuple[int, int]]] = defaultdict(set)\n\n    for cid, pts in comp_pts.items():\n        if len(pts) < 2:\n            continue\n        cols = comp_cols.get(cid, [])\n        if not cols:\n            continue\n\n        # build per-coordinate color histogram (clamp can merge multiple ring pixels)\n        hist: dict[tuple[int, int], Counter] = defaultdict(Counter)\n        for r, c, col in pts:\n            hist[(int(r), int(c))][int(col)] += 1\n\n        coords = list(hist.keys())\n\n        if len(cols) == 1:\n            colv = int(cols[0])\n            uniq = coords\n            rows = {r for r, _c in uniq}\n            cols2 = {c for _r, c in uniq}\n            if len(rows) == 1 or len(cols2) == 1:\n                for p in uniq:\n                    deferred[colv].add((int(p[0]), int(p[1])))\n                continue\n\n            # Connect farthest pair by a Manhattan path.\n            best = None\n            for i in range(len(uniq)):\n                for j in range(i + 1, len(uniq)):\n                    d = abs(uniq[i][0] - uniq[j][0]) + abs(uniq[i][1] - uniq[j][1])\n                    if best is None or d > best[0]:\n                        best = (d, uniq[i], uniq[j])\n            if best is None:\n                continue\n            _d, p1, p2 = best\n            pathA = build_manhattan(p1, p2, True)\n            pathB = build_manhattan(p1, p2, False)\n            chosen = pathB if (inside_corner(p1, p2, False) and not inside_corner(p1, p2, True)) else pathA\n            for rr, cc in chosen:\n                out[int(rr), int(cc)] = int(colv)\n            continue\n\n        if len(cols) == 2:\n            # Choose farthest pair in mapped space.\n            best = None\n            for i in range(len(coords)):\n                for j in range(i + 1, len(coords)):\n                    d = abs(coords[i][0] - coords[j][0]) + abs(coords[i][1] - coords[j][1])\n                    if best is None or d > best[0]:\n                        best = (d, coords[i], coords[j])\n            if best is None:\n                continue\n            _d, a, b = best\n            # Component's two colors (alternation palette).\n            ca, cb = map(int, cols)\n            # Endpoint color hints from ring-touch pixels (can be same on both ends).\n            ha = int(hist[a].most_common(1)[0][0])\n            hb = int(hist[b].most_common(1)[0][0])\n\n            # Pick a Manhattan path (prefer elbow inside the interior).\n            pathA = build_manhattan(a, b, True)\n            pathB = build_manhattan(a, b, False)\n            path = pathB if (inside_corner(a, b, False) and not inside_corner(a, b, True)) else pathA\n\n            def paint_alt(path_pts: list[tuple[int, int]], start_color: int):\n                cur = int(start_color)\n                for rr, cc in path_pts:\n                    out[int(rr), int(cc)] = int(cur)\n                    cur = int(cb) if cur == int(ca) else int(ca)\n\n            # Determine phase by constraining endpoint colors (from ring-touch hints).\n            chosen = None  # (path_pts, start_color)\n            for path_pts in (path, list(reversed(path))):\n                for start_color in (ca, cb):\n                    end_color = start_color if ((len(path_pts) - 1) % 2 == 0) else (cb if start_color == ca else ca)\n                    if int(start_color) != int(ha):\n                        continue\n                    if int(end_color) != int(hb):\n                        continue\n                    chosen = (path_pts, int(start_color))\n                    break\n                if chosen is not None:\n                    break\n\n            assert chosen is not None\n\n            path_pts, start_color = chosen\n            paint_alt(path_pts, start_color)\n            continue\n\n    # Aggregate deferred monochrome points by color into stripes/segments.\n    for col, pts in deferred.items():\n        pts = list(pts)\n        if not pts:\n            continue\n        tops = [p for p in pts if p[0] == 0]\nFILE:/home/lixinyu/snap/new/ARC_code/eval/7491f3cf.py\nfrom __future__ import annotations\nimport random\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import get_bg, flood_fill, neighbors8, in_bounds, label_mask\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Composite two pattern tiles into a fourth panel using flood-fill from an indicator pixel.\n\n    Input structure:\n    - Four 5×5 panels in one row, border-separated.\n    - Panel 0: cue pixels = wall boundary (8-connected, edge-to-edge, through center)\n               + one 8-isolated indicator pixel.\n    - Panels 1–2: source patterns. Panel 3: blank (to fill).\n\n    Rule:\n    - Flood-fill (4-conn) from indicator, blocked by wall → inside region.\n    - Inside → non-bg from panel 1; outside → non-bg from panel 2.\n    - Wall → panel 1 if non-bg; panel 2 fallback when wall is 4-connected.\n\n    Key insight: The cue panel's isolated indicator and wall partition the tile into inside/outside masks that select between the two source panels.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n\n    border = int(g[0, 0])\n    tiles = [g[1:6, 1 + 6 * j : 1 + 6 * j + 5].copy() for j in range(4)]\n    t0, t1, t2, _t3 = tiles\n    b = int(Counter(t1.flatten()).most_common(1)[0][0])\n    assert border != b, \"border color must differ from tile background\"\n\n    t0_bg = int(Counter(t0.flatten()).most_common(1)[0][0])\n    cue_set = {(int(r), int(c)) for r in range(5) for c in range(5) if int(t0[r, c]) != t0_bg}\n    assert cue_set, \"no cue pixels found\"\n\n    # --- Indicator = the unique 8-isolated cue pixel ---\n    indicator = None\n    for r, c in cue_set:\n        if not any((nr, nc) in cue_set for nr, nc in neighbors8(r, c)):\n            assert indicator is None, \"multiple 8-isolated cue pixels\"\n            indicator = (r, c)\n    assert indicator is not None, \"no 8-isolated cue pixel found\"\n\n    # Indicator must sit at a tile corner or edge midpoint\n    valid_pos = {(0,0),(0,4),(4,0),(4,4),(0,2),(2,0),(2,4),(4,2)}\n    assert indicator in valid_pos, f\"indicator {indicator} not at corner/edge-midpoint\"\n\n    wall = cue_set - {indicator}\n\n    # --- Structural assertions (feedback for generate_input agents) ---\n    assert (2, 2) in wall, \"wall must pass through the grid center (2,2)\"\n\n    # Wall must be symmetric about the line from indicator to center (2,2)\n    ir, ic = indicator\n    dr, dc = 2 - ir, 2 - ic\n    if dr == 0:\n        _refl = lambda r, c: (4 - r, c)\n    elif dc == 0:\n        _refl = lambda r, c: (r, 4 - c)\n    elif dr * dc > 0:\n        _refl = lambda r, c: (c, r)\n    else:\n        _refl = lambda r, c: (4 - c, 4 - r)\n    assert wall == {_refl(r, c) for r, c in wall}, \"wall must be symmetric about indicator→center axis\"\n\n    sides_touched = set()\n    for r, c in wall:\n        if r == 0: sides_touched.add(\"top\")\n        if r == 4: sides_touched.add(\"bottom\")\n        if c == 0: sides_touched.add(\"left\")\n        if c == 4: sides_touched.add(\"right\")\n    assert len(sides_touched) >= 2, f\"wall must span edge-to-edge, only touches {sides_touched}\"\n\n    # --- Flood fill inside region ---\n    EMPTY, WALL, INSIDE = 0, 1, 2\n    tmp = np.zeros((5, 5), dtype=int)\n    for r, c in wall:\n        tmp[r, c] = WALL\n    flood_fill(tmp, indicator[0], indicator[1], INSIDE, connectivity=4)\n    inside = {(int(r), int(c)) for r, c in np.argwhere(tmp == INSIDE)}\n\n    outside = {(r, c) for r in range(5) for c in range(5)} - inside - wall\n    assert outside, \"wall must partition the grid — outside region is empty\"\n\n    # Wall 4-connectivity determines boundary blending behavior:\n    # axis-aligned walls (4-connected) allow t2 fallback; diagonal walls don't.\n    wall_mask = np.zeros((5, 5), dtype=bool)\n    for r, c in wall:\n        wall_mask[r, c] = True\n    _, n_comp = label_mask(wall_mask, connectivity=4)\n    wall_4conn = (n_comp == 1)\n\n    # --- Build output tile ---\n    out3 = np.full((5, 5), b, dtype=int)\n    for r in range(5):\n        for c in range(5):\n            v1, v2 = int(t1[r, c]), int(t2[r, c])\n            if (r, c) in inside:\n                if v1 != b:\n                    out3[r, c] = v1\n            elif (r, c) in wall:\n                if v1 != b:\n                    out3[r, c] = v1\n                elif wall_4conn and v2 != b:\n                    out3[r, c] = v2\n            else:\n                if v2 != b:\n                    out3[r, c] = v2\n\n    out = g.copy()\n    out[1:6, 1 + 6 * 3 : 1 + 6 * 3 + 5] = out3\n    return out\n\n# --------------- generator (subagent) ---------------\n\n# ── Tunables ──────────────────────────────────────────────────────────────────\nTILE_SZ = 5                    # each panel is 5x5\nGRID_ROWS, GRID_COLS = 7, 25  # fixed output grid shape\nNUM_COLORS = 10                # ARC color palette size\n\nT1_MIN_PX, T1_MAX_PX = 8, 12  # tile-1 non-bg pixel range\nT2_MIN_PX, T2_MAX_PX = 9, 12  # tile-2 non-bg pixel range\nORBIT_INCLUDE_PROB = 0.55      # per-orbit inclusion probability for pattern sampling\nPATTERN_RETRIES = 200          # max retries per _sample_symmetric_pattern call\nGEN_RETRIES = 300              # max retries in generate_input outer loop\nLBEND_PROB = 0.2               # L-bend wall probability (eval ratio ~4:1 straight:L-bend)\n\n# ── Symmetric pattern orbits (D1+D2 symmetry on 5x5) ─────────────────────────\n_ORBITS = [\n    [(0, 0), (4, 4)],\n    [(0, 4), (4, 0)],\n    [(2, 2)],\n    [(1, 1), (3, 3)],\n    [(1, 3), (3, 1)],\n    [(0, 1), (1, 0), (3, 4), (4, 3)],\n    [(0, 2), (2, 0), (2, 4), (4, 2)],\n    [(0, 3), (3, 0), (1, 4), (4, 1)],\n    [(1, 2), (2, 1), (2, 3), (3, 2)],\n]\n\n\ndef _sample_symmetric_pattern(bg: int, fg: int, rng: random.Random, *,\n                              min_px: int, max_px: int) -> np.ndarray | None:\n    \"\"\"Sample a 5x5 grid symmetric under both diagonals, with fg pixel count in\n    [min_px, max_px].  Randomizes orbit order, includes each greedily within\n    the max budget, retries until min is met.\"\"\"\n    for _ in range(PATTERN_RETRIES):\n        order = list(range(len(_ORBITS)))\n        rng.shuffle(order)\n        p = np.full((TILE_SZ, TILE_SZ), bg, dtype=int)\n        count = 0\n        for i in order:\n            orbit = _ORBITS[i]\n            if count + len(orbit) > max_px:\n                continue\n            if rng.random() < ORBIT_INCLUDE_PROB:\n                for r, c in orbit:\n                    p[r, c] = fg\n                count += len(orbit)\n        if min_px <= count <= max_px:\n            return p\n    return None\n\n\n# ── Precomputed (indicator, wall) configurations ─────────────────────────────\n# 8 straight + 12 L-bend combos, all verified to partition the 5x5 grid.\n_STRAIGHT_CONFIGS = [\n    ((0, 2), frozenset({(2,0),(2,1),(2,2),(2,3),(2,4)})),          # row\n    ((4, 2), frozenset({(2,0),(2,1),(2,2),(2,3),(2,4)})),          # row\n    ((2, 0), frozenset({(0,2),(1,2),(2,2),(3,2),(4,2)})),          # col\n    ((2, 4), frozenset({(0,2),(1,2),(2,2),(3,2),(4,2)})),          # col\n    ((0, 0), frozenset({(0,4),(1,3),(2,2),(3,1),(4,0)})),          # anti-diag\n    ((4, 4), frozenset({(0,4),(1,3),(2,2),(3,1),(4,0)})),          # anti-diag\n    ((0, 4), frozenset({(0,0),(1,1),(2,2),(3,3),(4,4)})),          # diag\n    ((4, 0), frozenset({(0,0),(1,1),(2,2),(3,3),(4,4)})),          # diag\n]\n_LBEND_CONFIGS = [\n    ((0, 0), frozenset({(2,2),(1,2),(0,2),(2,1),(2,0)})),          # U+L\n    ((0, 0), frozenset({(2,2),(3,2),(4,2),(2,3),(2,4)})),          # D+R\n    ((4, 4), frozenset({(2,2),(1,2),(0,2),(2,1),(2,0)})),          # U+L\n    ((4, 4), frozenset({(2,2),(3,2),(4,2),(2,3),(2,4)})),          # D+R\n    ((0, 4), frozenset({(2,2),(1,2),(0,2),(2,3),(2,4)})),          # U+R\n    ((0, 4), frozenset({(2,2),(3,2),(4,2),(2,1),(2,0)})),          # D+L\n    ((4, 0), frozenset({(2,2),(1,2),(0,2),(2,3),(2,4)})),          # U+R\n    ((4, 0), frozenset({(2,2),(3,2),(4,2),(2,1),(2,0)})),          # D+L\n    ((4, 2), frozenset({(2,2),(1,1),(0,0),(1,3),(0,4)})),          # NW+NE\n    ((0, 2), frozenset({(2,2),(3,1),(4,0),(3,3),(4,4)})),          # SW+SE\n    ((2, 4), frozenset({(2,2),(1,1),(0,0),(3,1),(4,0)})),          # NW+SW\n    ((2, 0), frozenset({(2,2),(1,3),(0,4),(3,3),(4,4)})),          # NE+SE\n]\n\n\ndef _flood_inside(wall: frozenset, indicator: tuple[int, int]) -> set[tuple[int, int]]:\n    tmp = np.zeros((TILE_SZ, TILE_SZ), dtype=int)\n    for r, c in wall:\n        tmp[r, c] = 1\n    flood_fill(tmp, indicator[0], indicator[1], 2, connectivity=4)\n    return {(int(r), int(c)) for r, c in np.argwhere(tmp == 2)}\n\n\n# ── Main generation loop ─────────────────────────────────────────────────────\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    # 1. Colors: border != tile_bg; cue/t1/t2 mutually distinct and != tile_bg.\n    palette = list(range(NUM_COLORS))\n    tile_bg = rng.choice(palette)\n    other = [c for c in palette if c != tile_bg]\n    cue_color, t1_color, t2_color = rng.sample(other, 3)\n    border = rng.choice(other)\n\n    # 2. Wall + indicator (4:1 straight:L-bend ratio).\n    pool = _LBEND_CONFIGS if rng.random() < LBEND_PROB else _STRAIGHT_CONFIGS\n    indicator, wall = rng.choice(pool)\n    inside = _flood_inside(wall, indicator)\n\n    # 3. Tile-1 / Tile-2 symmetric patterns.\n    t1 = _sample_symmetric_pattern(tile_bg, t1_color, rng,\n                                   min_px=T1_MIN_PX, max_px=T1_MAX_PX)\n    t2 = _sample_symmetric_pattern(tile_bg, t2_color, rng,\n                                   min_px=T2_MIN_PX, max_px=T2_MAX_PX)\n    if t1 is None or t2 is None:\n        return None\n\n    # 4. Tile-0 (cue tile): bg + wall + indicator drawn in cue_color.\n    t0 = np.full((TILE_SZ, TILE_SZ), tile_bg, dtype=int)\n    for r, c in wall:\n        t0[r, c] = cue_color\n    t0[indicator[0], indicator[1]] = cue_color\n\n    # 5. Composite output tile-3.\n    wall_mask = np.zeros((TILE_SZ, TILE_SZ), dtype=bool)\n    for r, c in wall:\n        wall_mask[r, c] = True\n    _, n_comp = label_mask(wall_mask, connectivity=4)\n    wall_4conn = (n_comp == 1)\n    outside = set((r, c) for r in range(TILE_SZ) for c in range(TILE_SZ)) - inside - wall\n    out3 = np.full((TILE_SZ, TILE_SZ), tile_bg, dtype=int)\n    for r in range(TILE_SZ):\n        for c in range(TILE_SZ):\n            v1, v2 = int(t1[r, c]), int(t2[r, c])\n            if (r, c) in inside:\n                if v1 != tile_bg: out3[r, c] = v1\n            elif (r, c) in wall:\n                if v1 != tile_bg: out3[r, c] = v1\n                elif wall_4conn and v2 != tile_bg: out3[r, c] = v2\n            else:\n                if v2 != tile_bg: out3[r, c] = v2\n\n    # 6. Assemble 7x25 input grid (tile-3 input is blank).\n    t3_in = np.full((TILE_SZ, TILE_SZ), tile_bg, dtype=int)\n    g = np.full((GRID_ROWS, GRID_COLS), border, dtype=int)\n    for j, tile in enumerate([t0, t1, t2, t3_in]):\n        g[1:6, 1 + 6 * j: 1 + 6 * j + 5] = tile\n\n    # 7. Oracle: solver output must match hand-built composite.\n    expected = g.copy()\n    expected[1:6, 1 + 6 * 3: 1 + 6 * 3 + 5] = out3\n    got = main(g)\n    if not np.array_equal(got, expected):\nFILE:/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py\nfrom __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg\nimport random\n\n\ndef _touches_edge(coords: np.ndarray, height: int, width: int) -> bool:\n    rows = coords[:, 0]\n    cols = coords[:, 1]\n    return bool(\n        np.any((rows == 0) | (rows == height - 1) | (cols == 0) | (cols == width - 1))\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, table, frame, and slot dimensions.\nCANVAS_MIN, CANVAS_MAX = 13, 19\nTABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\nROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\nAXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n\n# Object and palette sampling limits.\nN_COLORS, MAX_OBJECT_COLORS = 10, 6\nMAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\nOBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n\n# Rejection sampling cap.\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_axis_options(n_slots, slot_min, slot_max):\n    options = []\n\n    def rec_slots(i, cur):\n        if i == n_slots:\n            rec_seps(0, [], cur)\n            return\n        for size in range(slot_min, slot_max + 1):\n            rec_slots(i + 1, cur + [size])\n\n    def rec_seps(i, cur, slots):\n        if i == n_slots - 1:\n            for before in AXIS_OUTER_OPTIONS:\n                for after in AXIS_OUTER_OPTIONS:\n                    for pad_before in AXIS_PADDING_OPTIONS:\n                        for pad_after in AXIS_PADDING_OPTIONS:\n                            total = (\n                                before\n                                + after\n                                + pad_before\n                                + pad_after\n                                + sum(slots)\n                                + sum(cur)\n                            )\n                            if 13 <= total <= 19:\n                                options.append(\n                                    (\n                                        tuple(slots),\n                                        tuple(cur),\n                                        before,\n                                        after,\n                                        pad_before,\n                                        pad_after,\n                                        total,\n                                )\n                            )\n            return\n        for sep in AXIS_SEPARATOR_OPTIONS:\n            rec_seps(i + 1, cur + [sep], slots)\n\n    rec_slots(0, [])\n    return options\n\n\ndef _gen_positions(axis):\n    sizes, seps, outer_before, _outer_after, pad_before, _pad_after, _total = axis\n    starts = []\n    pos = outer_before + pad_before\n    for i, size in enumerate(sizes):\n        starts.append(pos)\n        pos += size\n        if i < len(seps):\n            pos += seps[i]\n    return starts\n\n\ndef _gen_choose_axis(n_slots, slot_min, slot_max, other_axis=None, max_object_loss=0):\n    options = _gen_axis_options(n_slots, slot_min, slot_max)\n    if other_axis is None:\n        return random.choice(options)\n\n    good = []\n    for axis in options:\n        row_axis = axis if slot_max == ROW_SLOT_SIZE_RANGE[1] else other_axis\n        col_axis = axis if slot_max == COL_SLOT_SIZE_RANGE[1] else other_axis\n        height = row_axis[-1]\n        width = col_axis[-1]\n        frame_height = height - row_axis[2] - row_axis[3]\n        frame_width = width - col_axis[2] - col_axis[3]\n        slot_area = sum(row_axis[0]) * sum(col_axis[0])\n        outer_bg = height * width - frame_height * frame_width\n        bg_room = outer_bg + slot_area - max_object_loss\n        frame_area = frame_height * frame_width - slot_area\n        if bg_room > frame_area:\n            good.append(axis)\n    return random.choice(good or options)\n\n\ndef _gen_assign_colors(shape, bg, frame):\n    n_slots = shape[0] * shape[1]\n    filled_count = random.randint(1, n_slots - 1)\n    filled = random.sample(range(n_slots), filled_count)\n    colors = [c for c in range(N_COLORS) if c not in (bg, frame)]\n    n_colors = random.randint(1, min(MAX_OBJECT_COLORS, filled_count, len(colors)))\n    palette = random.sample(colors, n_colors)\n    assignments = palette[:]\n    assignments.extend(random.choice(palette) for _ in range(filled_count - n_colors))\n    random.shuffle(assignments)\n\n    out = np.full(shape, bg, dtype=int)\n    for idx, color in zip(filled, assignments):\n        out[idx // shape[1], idx % shape[1]] = color\n    return out, filled_count\n\n\ndef _gen_object_shape(slot_h, slot_w):\n    by_area = {}\n    for obj_h in range(1, min(MAX_OBJECT_HEIGHT, slot_h - 2 * OBJECT_MARGIN) + 1):\n        for obj_w in range(1, min(MAX_OBJECT_WIDTH, slot_w - 2 * OBJECT_MARGIN) + 1):\n            by_area.setdefault(obj_h * obj_w, []).append((obj_h, obj_w))\n    area = random.choice(list(by_area))\n    return random.choice(by_area[area])\n\n\ndef _gen_choose_layout(rows, cols, filled_count):\n    row_axis = _gen_choose_axis(rows, *ROW_SLOT_SIZE_RANGE)\n    loss = MAX_OBJECT_AREA * filled_count\n    col_axis = _gen_choose_axis(cols, *COL_SLOT_SIZE_RANGE, row_axis, max_object_loss=loss)\n    return row_axis, col_axis, _gen_positions(row_axis), _gen_positions(col_axis)\n\n\ndef _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts):\n    height = row_axis[-1]\n    width = col_axis[-1]\n    grid = np.full((height, width), bg, dtype=int)\n    rt, rb = row_axis[2], row_axis[3]\n    cl, cr = col_axis[2], col_axis[3]\n    grid[rt : height - rb, cl : width - cr] = frame\n\n    for r, slot_h in zip(row_starts, row_axis[0]):\n        for c, slot_w in zip(col_starts, col_axis[0]):\n            grid[r : r + slot_h, c : c + slot_w] = bg\n    return grid\n\n\ndef _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts):\n    for out_r, slot_r in enumerate(row_starts):\n        slot_h = row_axis[0][out_r]\n        for out_c, slot_c in enumerate(col_starts):\n            color = int(out[out_r, out_c])\n            if color == bg:\n                continue\n            slot_w = col_axis[0][out_c]\n            obj_h, obj_w = _gen_object_shape(slot_h, slot_w)\n            obj_r = random.randint(slot_r + OBJECT_MARGIN, slot_r + slot_h - obj_h - OBJECT_MARGIN)\n            obj_c = random.randint(slot_c + OBJECT_MARGIN, slot_c + slot_w - obj_w - OBJECT_MARGIN)\n            grid[obj_r : obj_r + obj_h, obj_c : obj_c + obj_w] = color\n\n\ndef _gen_is_valid(grid, out, bg, frame):\n    counts = np.bincount(grid.ravel(), minlength=N_COLORS)\n    if int(np.argmax(counts)) != bg:\n        return False\n    if counts[frame] <= max(counts[c] for c in range(N_COLORS) if c not in (bg, frame)):\n        return False\n    try:\n        actual = main(grid)\n    except Exception:\n        return False\n    return bool(np.array_equal(actual, out))\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rows = random.randint(*TABLE_ROWS_RANGE)\n    cols = random.randint(*TABLE_COLS_RANGE)\n    bg, frame = random.sample(range(N_COLORS), 2)\n\n    out, filled_count = _gen_assign_colors((rows, cols), bg, frame)\n    row_axis, col_axis, row_starts, col_starts = _gen_choose_layout(rows, cols, filled_count)\n    grid = _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts)\n    _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts)\n\n    if _gen_is_valid(grid, out, bg, frame):\n        return grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\nFILE:/home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py\nimport numpy as np\n\nfrom arc_utils import neighbors4, neighbors8, components_mask, get_bg\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the region enclosed by a wall sprite and radiate color outward through its opening.\n\n    Input structure:\n    - bg = most common color. Wall = most frequent non-bg color, forming a partial enclosure (e.g. U-shape).\n    - A fill-color pixel sits inside the enclosed area. Other non-bg pixels may act as obstacles.\n    Rule:\n    - Flood-fill the enclosed area with the fill color, radiating outward through the wall's open end.\n    - Obstacles cast \"shadows\" along the radiate direction, blocking fill behind them.\n\n    Key insight: The wall endpoints define the opening direction; fill radiates outward through it, and obstacles block propagation along that same axis.\n    \"\"\"\n    g = np.array(grid, copy=True)\n    h, w = g.shape\n\n    vals = np.unique(g)\n    bg = get_bg(g)\n\n    non_bg = [int(v) for v in vals if int(v) != bg]\n    assert non_bg, \"expected at least one non-background color\"\n\n    # Wall: most frequent non-background color.\n    wall = max(non_bg, key=lambda c: int((g == c).sum()))\n\n    wall_mask = g == wall\n\n    # Wall connected components (8-neigh).\n    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]\n    assert comps, \"expected at least one wall connected component\"\n\n    def sgn(x: int) -> int:\n        return (x > 0) - (x < 0)\n\n    other_colors = [c for c in non_bg if c != wall]\n    assert other_colors, \"expected at least one non-wall color (fill color)\"\n\n    # Pick fill color as the non-wall color closest (Manhattan distance) to the wall pixels.\n    wall_points = [p for comp in comps for p in comp]\n\n    def min_dist_to_wall(color: int) -> tuple[int, int]:\n        pts = list(zip(*np.where(g == color)))\n        pts = [(int(r), int(c)) for r, c in pts]\n        best_d = 10**9\n        for r, c in pts:\n            for wr, wc in wall_points:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0, len(pts)\n        return best_d, len(pts)\n\n    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))\n\n    fill_pos = list(zip(*np.where(g == fill)))\n    fill_pos = [(int(r), int(c)) for r, c in fill_pos]\n    if not fill_pos:\n        return g\n\n    # Choose the closest wall component to the fill seed (ties: larger component).\n    def comp_min_dist(comp: set[tuple[int, int]]) -> int:\n        best_d = 10**9\n        for r, c in fill_pos:\n            for wr, wc in comp:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0\n        return best_d\n\n    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))\n\n    comp_mask = np.zeros_like(wall_mask, dtype=bool)\n    for r, c in wall_comp:\n        comp_mask[r, c] = True\n\n    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:\n        out = []\n        for rr, cc in neighbors8(r, c):\n            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:\n                out.append((rr, cc))\n        return out\n\n    endpoints: list[tuple[int, int]] = []\n    for r, c in wall_comp:\n        if len(comp_neighbors(r, c)) == 1:\n            endpoints.append((r, c))\n\n    assert endpoints, \"expected wall component to have endpoints (degree-1 pixels)\"\n\n    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:\n        n1 = comp_neighbors(*ep)[0]\n        d1 = (sgn(n1[0] - ep[0]), sgn(n1[1] - ep[1]))  # inward\n        d_use = d1\n        is_12 = False\n        n2s = [p for p in comp_neighbors(*n1) if p != ep]\n        if n2s:\n            n2 = n2s[0]\n            d2 = (sgn(n2[0] - n1[0]), sgn(n2[1] - n1[1]))\n            if (d1[0] == 0) ^ (d1[1] == 0):\n                if d2[0] != 0 and d2[1] != 0:\n                    d_use = d2\n                    is_12 = True\n        return (-d_use[0], -d_use[1]), is_12\n\n    out_info = [outward_dir(ep) for ep in endpoints]\n    out_dirs = [d for d, _ in out_info]\n    tip_12 = [f for _, f in out_info]\n\n    dr_sum = sum(d[0] for d in out_dirs)\n    dc_sum = sum(d[1] for d in out_dirs)\n    rad = (sgn(dr_sum), sgn(dc_sum))\n\n    barrier = comp_mask.copy()\n\n    def add_ray(start: tuple[int, int], d: tuple[int, int], skip: int = 0) -> None:\n        rr, cc = start\n        for _ in range(skip):\n            rr += d[0]\n            cc += d[1]\n        while True:\n            rr += d[0]\n            cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:\n        rr, cc = start\n        step = 0\n        while True:\n            step += 1\n            if step % 2 == 1:\n                rr += d[0]; cc += d[1]\n            else:\n                if rad[0] != 0:\n                    rr += d[0]\n                else:\n                    cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):\n        if is_12:\n            add_ray_12(ep, d)\n        else:\n            add_ray(ep, d, skip=0)\n\n    passable = (~barrier) & ((g == bg) | (g == fill))\n    q = fill_pos[:]\n    seen = np.zeros_like(passable, dtype=bool)\n    for r, c in q:\n        if passable[r, c]:\n            seen[r, c] = True\n    while q:\n        r, c = q.pop()\n        for rr, cc in neighbors4(r, c):\n            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:\n                seen[rr, cc] = True\n                q.append((rr, cc))\n\n    filled_mask = (seen & (g == bg))\n\n    out = g.copy()\n    out[filled_mask] = fill\n\n    # Shadow behind obstacles (non-bg, non-fill, non-wall) along radiate direction.\n    obstacles = (g != bg) & (g != fill) & (g != wall)\n\n    def shadow_process(coords: list[tuple[int, int]]) -> None:\n        started = False\n        blocked = False\n        for r, c in coords:\n            if filled_mask[r, c]:\n                started = True\n            if started and obstacles[r, c]:\n                blocked = True\n                continue\n            if blocked and filled_mask[r, c]:\n                out[r, c] = bg\n                filled_mask[r, c] = False\n\n    if rad != (0, 0):\n        dr, dc = rad\n        if dr != 0 and dc == 0:\n            for c in range(w):\n                rows = range(h) if dr > 0 else range(h - 1, -1, -1)\n                shadow_process([(r, c) for r in rows])\n        elif dc != 0 and dr == 0:\n            for r in range(h):\n                cols = range(w) if dc > 0 else range(w - 1, -1, -1)\n                shadow_process([(r, c) for c in cols])\n        else:\n            # Diagonal scanlines\n            if dr == dc:\n                # r - c = const\n                for k in range(-(w - 1), h):\n                    coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]\n                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n                    shadow_process(coords)\n            else:\n                # r + c = const\n                for k in range(h + w - 1):\n                    coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]\n                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n                    shadow_process(coords)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom scipy.ndimage import distance_transform_cdt\n\n# -- Configuration constants --------------------------------------------------\n# Canvas size bounds\nGRID_H_VERT = (11, 18)       # height range when radiate_dir is vertical\nGRID_H_HORIZ = (8, 18)       # height range when radiate_dir is horizontal\nGRID_W = (15, 19)             # width range (all directions)\n\n# Wall geometry\nWALL_PIXELS_MIN = 17          # minimum wall pixel count\nWALL_PIXELS_MAX = 25          # maximum wall pixel count\nDEPTH_VERT = (5, 10)          # arm depth range for vertical radiate\nDEPTH_HORIZ = (6, 8)          # arm depth range for horizontal radiate\nGAP_VERT = (6, 7)             # endpoint gap for vertical radiate\nGAP_HORIZ = (5, 7)            # endpoint gap for horizontal radiate\nTIP_12_PROB = 0.5             # probability of 1:2 arm-angle mode (when eligible)\n\n# Placement margins\nOPEN_END_MARGIN = 3           # min cells from open end to radiate grid edge\n\n# Fill seed\nSEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]  # weighted choices for blob size\nSEED_DEPTH_LOOKBACK = 3       # seed must be within this many rows of closed end\n\n# Obstacles\nMAX_OBSTACLES = 5             # maximum obstacle pixel count\nOBSTACLE_IN_FILL_PROB = 0.65  # probability of forcing at least one obstacle in fill zone\nOBSTACLE_MIN_SEP = 2          # Chebyshev distance between obstacles (> this value)\n\n# Validation\nMIN_NEW_FILL = 20             # minimum newly-filled pixels for a valid output\nPALETTE_SIZE = (3, 5)         # number of distinct colors (bg + wall + fill + obstacle(s))\nGEN_RETRIES = 300             # max attempts in generate_input\n\n\ndef _degree1_pixels(points):\n    \"\"\"Return degree-1 pixels (exactly one 8-neighbor in the set).\"\"\"\n    pts = set(points)\n    return [(r, c) for r, c in pts\n            if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1]\n\nFILE:/home/lixinyu/snap/new/ARC_code/train/57edb29d.py\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import crop_bbox, find_components\nimport random\n\n\ndef _unique_most_common(values: np.ndarray) -> int:\n    counts = Counter(map(int, values.reshape(-1)))\n    max_count = max(counts.values())\n    winners = [color for color, count in counts.items() if count == max_count]\n    assert len(winners) == 1, \"expected a unique dominant color\"\n    return int(winners[0])\n\n\ndef _boundary_bg(g: np.ndarray) -> int:\n    boundary = np.concatenate((g[0, :], g[-1, :], g[:, 0], g[:, -1]))\n    return _unique_most_common(boundary)\n\n\ndef _runs(cols: np.ndarray) -> list[tuple[int, int]]:\n    assert cols.size > 0, \"expected a nonempty marker row\"\n    spans = []\n    start = end = int(cols[0])\n    for col in map(int, cols[1:]):\n        if col == end + 1:\n            end = col\n        else:\n            spans.append((start, end))\n            start = end = col\n    spans.append((start, end))\n    return spans\n\n\ndef _map_row(row: int, src_h: int, dst_h: int) -> int:\n    top = int(row)\n    bottom = int(src_h - 1 - row)\n    assert top != bottom, \"marker row must be closer to one horizontal edge\"\n    mapped = top if top < bottom else int(dst_h - 1 - bottom)\n    assert 0 <= mapped < dst_h, \"mapped marker row must fit in target rectangle\"\n    return int(mapped)\n\n\ndef _map_col_run(c0: int, c1: int, src_w: int, dst_w: int) -> tuple[int, int]:\n    mid2 = int(src_w - 1)\n    if c0 == c1:\n        left = int(c0)\n        right = int(src_w - 1 - c0)\n        assert left != right, \"single marker pixel must be closer to one vertical edge\"\n        mapped = left if left < right else int(dst_w - 1 - right)\n        assert 0 <= mapped < dst_w, \"mapped marker column must fit in target rectangle\"\n        return int(mapped), int(mapped)\n\n    if 2 * int(c1) <= mid2:\n        start, end = int(c0), int(c1)\n    elif 2 * int(c0) >= mid2:\n        start = int(dst_w - 1 - (src_w - 1 - c0))\n        end = int(dst_w - 1 - (src_w - 1 - c1))\n    else:\n        start = int(c0)\n        end = int(dst_w - 1 - (src_w - 1 - c1))\n\n    assert 0 <= start <= end < dst_w, \"mapped marker run must fit in target rectangle\"\n    return int(start), int(end)\n\n\ndef _adapt_marker_mask(src: np.ndarray, marker_color: int, dst_shape: tuple[int, int]) -> np.ndarray:\n    src_h, src_w = map(int, src.shape)\n    dst_h, dst_w = map(int, dst_shape)\n    src_mask = src == int(marker_color)\n    assert bool(src_mask.any()), \"source rectangle must contain marker pixels\"\n\n    out = np.zeros((dst_h, dst_w), dtype=bool)\n    for row in map(int, np.flatnonzero(src_mask.any(axis=1))):\n        dst_row = _map_row(row, src_h, dst_h)\n        for c0, c1 in _runs(np.flatnonzero(src_mask[row, :])):\n            dst_c0, dst_c1 = _map_col_run(c0, c1, src_w, dst_w)\n            out[dst_row, dst_c0 : dst_c1 + 1] = True\n    return out\n\n\ndef _row_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n    return max(int(a[0]), int(b[0])) <= min(int(a[2]), int(b[2]))\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extract the single plain rectangle and redraw it with the aligned rectangles' border-relative marker pattern.\n\n    Input structure:\n    - The boundary color is the background/separator.\n    - Foreground objects are dense rectangular regions; exactly one rectangle has only its base color.\n    - Other rectangles contain their base color plus marker pixels.\n\n    Rule:\n    - Crop the only plain rectangle; this crop is the output canvas.\n    - Use marked rectangles whose row span overlaps the plain rectangle's row span.\n    - Transfer their marker pixels by preserving each marker run's distance from the nearest rectangle edges.\n\n    Key insight:\n    - The marked rectangles are examples of an edge-relative pattern, so the missing plain rectangle receives the same pattern resized to its own dimensions.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    bg = _boundary_bg(g)\n\n    objects = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False):\n        bbox = tuple(map(int, comp[\"bbox\"]))\n        sub = crop_bbox(g, bbox)\n        assert np.all(sub != bg), \"foreground rectangles must be dense\"\n\n        base_color = _unique_most_common(sub)\n        marker_colors = set(map(int, sub.reshape(-1))) - {int(base_color)}\n        objects.append(\n            {\n                \"bbox\": bbox,\n                \"sub\": sub,\n                \"base_color\": int(base_color),\n                \"marker_colors\": marker_colors,\n            }\n        )\n\n    plain = [obj for obj in objects if not obj[\"marker_colors\"]]\n    assert len(plain) == 1, \"expected exactly one plain rectangle\"\n    target = plain[0]\n    tr0, tc0, tr1, tc1 = target[\"bbox\"]\n    target_shape = (int(tr1 - tr0 + 1), int(tc1 - tc0 + 1))\n\n    sources = [\n        obj\n        for obj in objects\n        if obj[\"marker_colors\"] and _row_overlap(obj[\"bbox\"], target[\"bbox\"])\n    ]\n    assert sources, \"expected at least one marked rectangle aligned with the plain rectangle\"\n\n    marker_colors = set()\n    for source in sources:\n        marker_colors.update(source[\"marker_colors\"])\n    assert len(marker_colors) == 1, \"aligned marked rectangles must share one marker color\"\n    marker_color = int(next(iter(marker_colors)))\n\n    masks = []\n    for source in sources:\n        assert source[\"marker_colors\"] == {marker_color}, \"source must contain only the shared marker color\"\n        masks.append(_adapt_marker_mask(source[\"sub\"], marker_color, target_shape))\n\n    pattern = masks[0]\n    for mask in masks[1:]:\n        assert np.array_equal(mask, pattern), \"aligned marked rectangles must encode the same pattern\"\n\n    out = np.full(target_shape, int(target[\"base_color\"]), dtype=int)\n    out[pattern] = marker_color\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and separator colors.\nBG = 4\nNON_BG = [c for c in range(10) if c != BG]\nGRID_H_RANGE = (20, 28)\nGRID_W_RANGE = (20, 28)\nBORDER_GAP = 1\nBAND_GAP = 1\n# Rectangle counts and dimensions.\nRECT_COUNT_RANGE = (3, 6)\nOVERLAP_MARKED_COUNT = 2\nRECT_H_RANGE = (5, 20)\nRECT_W_RANGE = (5, 12)\nPLAIN_EXTRA_ROW_ROOM = 2\n# Marker pattern sampling.\nMARKER_PAIR_COUNT_RANGE = (1, 3)\nMARKER_EDGE_PAIRS = [(1, 1), (1, 2), (2, 1), (2, 2)]\n# Retry budget.\nGENERATION_ATTEMPTS = 300\n\n\ndef _stamp_pattern(rect: np.ndarray, marker: int, pairs: list[tuple[int, int]]):\n    h, w = rect.shape\n    for nr, nc in pairs:\n        for r in (nr, h - 1 - nr):\n            for c in (nc, w - 1 - nc):\n                rect[r, c] = marker\n\n\ndef _pick_dim(near_vals: list[int], lo: int, hi: int) -> int:\n    min_dim = max(lo, max(2 * nv + 2 for nv in near_vals))\n    cands = [d for d in range(min_dim, hi + 1) if all(d >= 2 * nv + 2 and d != 2 * nv + 1 for nv in near_vals)]\n    return random.choice(cands) if cands else -1\n\n\ndef _choose_marker_pattern():\n    n_pairs = random.randint(*MARKER_PAIR_COUNT_RANGE)\n    pairs = sorted(random.sample(MARKER_EDGE_PAIRS, min(n_pairs, len(MARKER_EDGE_PAIRS))))\n    near_rows = [p[0] for p in pairs]\n    near_cols = [p[1] for p in pairs]\n    return pairs, near_rows, near_cols\n\n\ndef _choose_palette(n_rects: int):\n    needed = n_rects + 1  # base colors + marker\n    if needed > len(NON_BG):\n        return None\n    chosen = random.sample(NON_BG, needed)\n    plain_base, marker_color = chosen[0], chosen[-1]\n    marked_bases = chosen[1:-1]\n    return plain_base, marker_color, marked_bases\n\n\ndef _make_marked_rect(h: int, w: int, base: int, marker: int, pairs: list[tuple[int, int]]) -> np.ndarray:\n    rect = np.full((h, w), base, dtype=int)\n    _stamp_pattern(rect, marker, pairs)\n    return rect\n\n\ndef _choose_plain_shape(near_rows: list[int], near_cols: list[int], avail_h: int, avail_w: int):\n    hp = _pick_dim(near_rows, RECT_H_RANGE[0], min(RECT_H_RANGE[1], avail_h - PLAIN_EXTRA_ROW_ROOM))\n    wp = _pick_dim(near_cols, RECT_W_RANGE[0], min(RECT_W_RANGE[1], avail_w))\n    if hp < 0 or wp < 0:\n        return None\n    return hp, wp\n\n\ndef _has_overlap_width_budget(avail_w: int, plain_w: int) -> bool:\n    remaining_w = avail_w - plain_w - OVERLAP_MARKED_COUNT * BAND_GAP\n    max_overlap_w = remaining_w // OVERLAP_MARKED_COUNT\n    if max_overlap_w >= RECT_W_RANGE[0]:\n        return True\n    return remaining_w >= RECT_W_RANGE[0]\n\n\ndef _build_overlap_rects(avail_h, avail_w, plain_w, near_rows, near_cols, marked_bases, marker_color, pairs):\n    if not _has_overlap_width_budget(avail_w, plain_w):\n        return None\n\n    min_w, max_w = RECT_W_RANGE\n    min_h, max_h = RECT_H_RANGE\n    overlap_rects = []\n    remaining_w = avail_w - plain_w - OVERLAP_MARKED_COUNT * BAND_GAP\n    for i in range(OVERLAP_MARKED_COUNT):\n        if i == 0:\n            max_w_i = min(remaining_w - min_w, max_w)\n        else:\n            max_w_i = min(remaining_w, max_w)\n        wm = _pick_dim(near_cols, min_w, max(min_w, max_w_i))\n        if wm < 0:\n            return None\n        remaining_w -= wm\n        if remaining_w < 0:\n            return None\n        hm = _pick_dim(near_rows, min_h, min(max_h, avail_h))\n        if hm < 0:\n            return None\n        overlap_rects.append(_make_marked_rect(hm, wm, marked_bases[i], marker_color, pairs))\n    return overlap_rects\n\n\ndef _build_non_overlap_rects(n_marked, overlap_band_h, avail_h, avail_w, near_rows, near_cols, marked_bases, marker_color, pairs):\n    min_h, max_h = RECT_H_RANGE\n","exit_code":0,"status":"completed"}}
