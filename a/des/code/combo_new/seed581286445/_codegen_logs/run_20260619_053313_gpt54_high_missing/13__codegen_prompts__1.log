5\t\n   256\t    # 7. Oracle: solver output must match hand-built composite.\n   257\t    expected = g.copy()\n   258\t    expected[1:6, 1 + 6 * 3: 1 + 6 * 3 + 5] = out3\n   259\t    got = main(g)\n   260\t    if not np.array_equal(got, expected):\n   261\t        return None\n   262\t    return g\n   263\t\n   264\t\n   265\tdef generate_input() -> np.ndarray:\n   266\t    rng = random.Random()\n   267\t    for _ in range(GEN_RETRIES):\n   268\t        g = _gen_attempt(rng)\n   269\t        if g is not None:\n   270\t            return g\n   271\t    raise RuntimeError(f\"generate_input failed after {GEN_RETRIES} attempts\")\n   272\t\n","exit_code":0,"status":"completed"}}
