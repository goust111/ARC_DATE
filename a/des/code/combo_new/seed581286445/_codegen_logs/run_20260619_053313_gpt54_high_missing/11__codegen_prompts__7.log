{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/2601afb7.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\n\n\ndef _extract_bars(g: np.ndarray, bg: int) -> list[dict[str, int]]:\n    height = g.shape[0]\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(components) >= 2\n\n    bars: list[dict[str, int]] = []\n    for comp in components:\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        color = int(comp[\"color\"])\n        area = int(comp[\"area\"])\n\n        assert c0 == c1\n        assert r1 == height - 1\n        assert area == r1 - r0 + 1\n        assert bool(np.all(g[r0 : r1 + 1, c0] == color))\n\n        bars.append({\"color\": color, \"col\": c0, \"height\": area})\n\n    bars.sort(key=lambda bar: bar[\"col\"])\n    assert len({bar[\"col\"] for bar in bars}) == len(bars)\n    return bars\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate each vertical bar's color one slot right and its height one slot left.\n\n    Input structure\n    - A dominant background surrounds several monochrome one-cell-wide vertical bars.\n    - Every bar is bottom-aligned and occupies a distinct column.\n    - The ordered bar slots are read from left to right.\n\n    Rule\n    - Keep the grid shape and the bar columns unchanged.\n    - At slot i, use the color from the previous slot cyclically.\n    - At slot i, use the height from the next slot cyclically.\n\n    Key insight\n    - Color and height are independent cyclic attributes of the ordered bar slots:\n      colors rotate right while heights rotate left.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height = g.shape[0]\n    bg = get_bg(g)\n    bars = _extract_bars(g, bg)\n\n    out = np.full_like(g, bg)\n    count = len(bars)\n    for i, bar in enumerate(bars):\n        color = bars[(i - 1) % count][\"color\"]\n        bar_height = bars[(i + 1) % count][\"height\"]\n        assert 1 <= bar_height <= height\n        out[height - bar_height : height, bar[\"col\"]] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n_RNG = np.random.default_rng()\n\n# Canvas/bar bounds.\nBAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE = 3, 6\nBACKGROUND_COLOR, MIN_BAR_HEIGHT = 7, 1\nBAR_COL_OFFSET, BAR_COL_STRIDE = 1, 2\n# Color and transform sampling.\nCOLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nOUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _render_bars(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n    grid = np.full((side, side), BACKGROUND_COLOR, dtype=int)\n    for i, (color, bar_height) in enumerate(zip(colors, heights)):\n        col = BAR_COL_STRIDE * i + BAR_COL_OFFSET\n        grid[side - int(bar_height) : side, col] = int(color)\n    return grid\n\n\ndef _expected_output(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n    out_colors = np.roll(colors, OUTPUT_COLOR_SHIFT)\n    out_heights = np.roll(heights, OUTPUT_HEIGHT_SHIFT)\n    return _render_bars(n, out_colors, out_heights)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = int(_RNG.integers(BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE))\n    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n    colors = _RNG.choice(COLOR_POOL, size=n, replace=False)\n    heights = _RNG.integers(MIN_BAR_HEIGHT, side, size=n)\n    if len(set(map(int, heights))) == 1:\n        idx = int(_RNG.integers(n))\n        choices = [h for h in range(MIN_BAR_HEIGHT, side) if h != int(heights[idx])]\n        heights[idx] = int(_RNG.choice(choices))\n\n    grid = _render_bars(n, colors, heights)\n    if np.array_equal(main(grid), _expected_output(n, colors, heights)):\n        return grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/494ef9d7.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/494ef9d7.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, get_bg\nimport random\n\n\nMOVING_PAIRS = (\n    frozenset({Color.BLUE, Color.TEAL}),\n    frozenset({Color.YELLOW, Color.ORANGE}),\n)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide each blue/teal or yellow/orange row pair together while preserving its left-to-right order.\n\n    Input structure\n    - The grid has a black background.\n    - Each nonempty row contains exactly two distinct foreground pixels.\n    - Blue/teal and yellow/orange row pairs are the moving pairs; other color pairs are distractors.\n\n    Rule\n    - For each moving pair, keep the left pixel fixed and move the right pixel left until it touches the left pixel.\n    - Clear the moved pixel's original location, and leave non-moving rows unchanged.\n\n    Key insight\n    - Only same-hue-family pixel pairs attract horizontally; separated unrelated colors do not compact.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    assert bg == Color.BLACK, \"expected black to be the background\"\n\n    out = g.copy()\n    for r in range(g.shape[0]):\n        cols = np.flatnonzero(g[r] != bg)\n        assert len(cols) in (0, 2), \"each nonempty row must have exactly two foreground pixels\"\n        if len(cols) == 0:\n            continue\n\n        c0, c1 = map(int, cols)\n        colors = frozenset({int(g[r, c0]), int(g[r, c1])})\n        assert len(colors) == 2, \"row foreground pixels must have distinct colors\"\n\n        if colors in MOVING_PAIRS:\n            dst_c = c0 + 1\n            assert dst_c < g.shape[1], \"moving pair must have room to touch\"\n            if c1 != dst_c:\n                assert g[r, dst_c] == bg, \"movement path must begin with background\"\n                out[r, dst_c] = g[r, c1]\n                out[r, c1] = bg\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\nBLACK = 0\n# Canvas bounds; numpy randint highs are exclusive.\nROW_RANGE, COL_RANGE = (3, 11), (4, 11)\n# Row composition ranges; all highs are exclusive.\nMOVING_COUNT_RANGE = range(1, 5)\nDISTRACTOR_COUNT_RANGE = range(2, 6)\nEMPTY_COUNT_RANGE = range(0, 3)\nROW_MOVING, ROW_DISTRACTOR, ROW_EMPTY = \"moving\", \"distractor\", \"empty\"\n# Pair palettes and allowed empty-cell gaps between the two row pixels.\nGEN_MOVING_PAIRS = ((1, 8), (4, 7))\nMOVING_PAIR_SETS = {frozenset(pair) for pair in GEN_MOVING_PAIRS}\nFOREGROUND_COLORS = range(1, 10)\nDISTRACTOR_PAIRS = tuple(\n    (a, b) for a in FOREGROUND_COLORS for b in FOREGROUND_COLORS\n    if b > a and frozenset((a, b)) not in MOVING_PAIR_SETS\n)\nMOVING_MAX_GAP, DISTRACTOR_MAX_GAP = 7, 6\n# Retry budget for oracle-checked generation.\nMAX_ATTEMPTS = 300\n\n_RNG = np.random.default_rng()\n\n\ndef _ordered_pair(pair: tuple[int, int]) -> tuple[int, int]:\n    if bool(_RNG.integers(0, 2)):\n        return pair[1], pair[0]\n    return pair\n\n\ndef _separated_columns(cols: int, max_gap: int) -> tuple[int, int]:\n    gap = int(_RNG.integers(1, min(max_gap, cols - 2) + 1))\n    c0 = int(_RNG.integers(0, cols - gap - 1))\n    return c0, c0 + gap + 1\n\n\ndef _choose_counts(rows: int) -> tuple[int, int, int]:\n    choices = [\n        (moving, distractor, empty)\n        for moving in MOVING_COUNT_RANGE\n        for distractor in DISTRACTOR_COUNT_RANGE\n        for empty in EMPTY_COUNT_RANGE\n        if moving + distractor + empty == rows\n    ]\n    return choices[int(_RNG.integers(0, len(choices)))]\n\n\ndef _row_types(rows: int) -> list[str]:\n    moving_count, distractor_count, empty_count = _choose_counts(rows)\n    row_types = [ROW_MOVING] * moving_count\n    row_types += [ROW_DISTRACTOR] * distractor_count\n    row_types += [ROW_EMPTY] * empty_count\n    _RNG.shuffle(row_types)\n    return row_types\n\n\ndef _place_row(out: np.ndarray, row: int, row_type: str, cols: int, moving_sources) -> None:\n    if row_type == ROW_EMPTY:\n        return\n    if row_type == ROW_MOVING:\n        pairs, max_gap = GEN_MOVING_PAIRS, MOVING_MAX_GAP\n    else:\n        pairs, max_gap = DISTRACTOR_PAIRS, DISTRACTOR_MAX_GAP\n\n    pair = pairs[int(_RNG.integers(0, len(pairs)))]\n    left_color, right_color = _ordered_pair(pair)\n    c0, c1 = _separated_columns(cols, max_gap)\n    out[row, c0] = left_color\n    if row_type == ROW_MOVING:\n        out[row, c0 + 1] = right_color\n        moving_sources.append((row, c0, c1, right_color))\n    else:\n        out[row, c1] = right_color\n\n\ndef _expand_input(out: np.ndarray, moving_sources) -> np.ndarray:\n    inp = out.copy()\n    for row, c0, c1, right_color in moving_sources:\n        inp[row, c0 + 1] = BLACK\n        inp[row, c1] = right_color\n    return inp\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rows = int(_RNG.integers(*ROW_RANGE))\n    cols = int(_RNG.integers(*COL_RANGE))\n    out = np.full((rows, cols), BLACK, dtype=int)\n    moving_sources = []\n    for row, row_type in enumerate(_row_types(rows)):\n        _place_row(out, row, row_type, cols, moving_sources)\n\n    inp = _expand_input(out, moving_sources)\n    try:\n        actual = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(actual, out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"generate_input: failed after {MAX_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
