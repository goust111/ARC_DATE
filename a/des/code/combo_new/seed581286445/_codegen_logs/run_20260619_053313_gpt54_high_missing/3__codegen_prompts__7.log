{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/5b37cb25.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/5b37cb25.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Fill each plus-shaped background notch with the color of the frame side it opens toward.\n\n    Input structure\n    - A one-cell-thick rectangular frame has four solid-colored sides and neutral corner pixels.\n    - The frame interior contains a dominant background color and one foreground object color.\n    - Some object boundaries contain five-pixel plus-shaped background notches.\n\n    Rule\n    - Find every background plus whose opposite side is supported by foreground object pixels and whose open side faces one frame side.\n    - Recolor the five pixels of that plus with the color of the facing frame side.\n    - Leave all other pixels unchanged.\n\n    Key insight\n    The frame side colors are direction labels for the open notches in the foreground object.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    h, w = g.shape\n    assert h >= 5 and w >= 5, \"expected room for a frame and plus notches\"\n\n    side_color = {\n        \"top\": _uniform_side(g[0, 1:-1]),\n        \"bottom\": _uniform_side(g[-1, 1:-1]),\n        \"left\": _uniform_side(g[1:-1, 0]),\n        \"right\": _uniform_side(g[1:-1, -1]),\n    }\n    bg, obj = _interior_colors(g[1:-1, 1:-1])\n\n    out = g.copy()\n    painted: set[tuple[int, int]] = set()\n    notch_count = 0\n    for r in range(1, h - 1):\n        for c in range(1, w - 1):\n            cross = tuple((r + dr, c + dc) for dr, dc in _CROSS)\n            if not all(int(g[rr, cc]) == bg for rr, cc in cross):\n                continue\n\n            dirs = _direction_for_notch(g, r, c, obj)\n            assert len(dirs) <= 1, \"expected each plus notch to open in at most one direction\"\n            if not dirs:\n                continue\n\n            notch_count += 1\n            color = side_color[dirs[0]]\n            for cell in cross:\n                assert cell not in painted, \"expected non-overlapping plus notches\"\n                painted.add(cell)\n                out[cell] = color\n\n    assert notch_count > 0, \"expected at least one plus notch\"\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\n_GEN_GRID_SIZE, _GEN_CORNER_COLOR = 30, 0\n_GEN_COLOR_POOL, _GEN_PALETTE_SIZE = range(1, 10), 6\n\n# Object size and total filled-area budget.\n_OBJECT_COUNT_MIN, _OBJECT_COUNT_MAX = 3, 4\n_OBJECT_DIM_MIN, _OBJECT_DIM_MAX = 5, 20\n_OBJECT_AREA_MIN, _OBJECT_AREA_MAX = 30, 180\n_TOTAL_OBJECT_AREA_MAX, _MIN_REMAINING_OBJECT_AREA = 360, 30\n\n# Placement gap against frame and other objects.\n_PLACEMENT_BORDER, _PLACEMENT_PADDING, _PLACEMENT_PADDING_CONNECTIVITY = 2, 2, 8\n\n# Notch geometry and counts.\n_GEN_CROSS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))\n_GEN_DIRECTIONS = {\n    \"top\": (-1, 0),\n    \"bottom\": (1, 0),\n    \"left\": (0, -1),\n    \"right\": (0, 1),\n}\n_EDGES = tuple(_GEN_DIRECTIONS)\n_NOTCH_EDGE_MARGIN, _MAX_TOTAL_NOTCHES = 2, 8\n_NOTCHES_PER_OBJECT = (1, 2, 3)\n\n# Rejection-sampling retry cap.\n_GEN_RETRY_LIMIT = 300\n_DIM_PAIRS = [(h, w) for h in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1)\n              for w in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1) if _OBJECT_AREA_MIN <= h * w <= _OBJECT_AREA_MAX]\n\n\n\n---GEN---\ndef generate_input():\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/985ae207.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/985ae207.py | sed '\"'$d'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/985ae207.py | sed '\"'$d'\"'; printf '\\\\n---GEN---\\\\n'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/985ae207.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repeat each 3x3 control-center sprite toward the matching solid rectangle until a copy first overlaps that rectangle.\n\n    Input structure\n    - The background is the dominant color.\n    - Each sprite is a 3x3 foreground object whose eight border pixels have one color and whose center has a different control color.\n    - For every control color, there is exactly one separate solid rectangular object of that color.\n\n    Rule\n    - Match each sprite to the unique solid rectangle whose color equals the sprite center.\n    - Copy the whole 3x3 sprite in the cardinal direction of that rectangle, stepping by three cells each time.\n    - Stop after pasting the first copy whose 3x3 bbox overlaps the rectangle; copied pixels overwrite the rectangle there.\n\n    Key insight\n    The center pixel is not the paint color: it is a destination key, while the entire 3x3 sprite is the motif tiled along the straight path.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h >= 3 and w >= 3\n\n    bg = int(get_bg(g))\n    sprites = _find_sprites(g, bg)\n    assert sprites, \"expected at least one 3x3 control-center sprite\"\n\n    out = g.copy()\n    for sprite_bbox, patch, center in sprites:\n        targets = _solid_rectangles(g, bg, center)\n        assert len(targets) == 1, \"each control color must have one solid rectangular target\"\n        target_bbox = targets[0][\"bbox\"]\n        assert not _intersects(sprite_bbox, target_bbox), \"sprite and target must start separate\"\n\n        dr, dc = _direction_to_target(sprite_bbox, target_bbox)\n        r, c = sprite_bbox[0], sprite_bbox[1]\n\n        while True:\n            current_bbox = (r, c, r + 2, c + 2)\n            assert 0 <= r and r + 3 <= h and 0 <= c and c + 3 <= w\n            paste(out, patch, r, c)\n\n            if _intersects(current_bbox, target_bbox):\n                break\n\n            r += dr * 3\n            c += dc * 3\n\n    return out\n\n# --------------- generator (att1) ---------------\n# Canvas and colors.\nBG_COLOR, COLOR_COUNT = 8, 10\nGRID_MIN_SIZE, GRID_MAX_SIZE = 20, 25\n\n# Rectangles.\nRECT_COUNT_MIN, RECT_COUNT_MAX = 2, 4\nRECT_SIDE_MIN, RECT_SIDE_MAX = 2, 14\nRECT_MARGIN, RECT_SPACING_PAD = 1, 5\nRECT_PLACEMENT_ATTEMPTS = 50\n\n# Sprites and paths.\nSPRITE_SIZE, SPRITE_TOTAL_MAX = 3, 5\nSPRITE_GAPS = [1, 4, 7, 10]\nDIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n\n# Retry limits.\nGENERATION_ATTEMPTS = 300\n\n\n\n---GEN---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n","exit_code":0,"status":"completed"}}
