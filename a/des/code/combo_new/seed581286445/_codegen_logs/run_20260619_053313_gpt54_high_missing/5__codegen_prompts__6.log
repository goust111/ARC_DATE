_cycle(grid, frame_bboxes, centers, cw_order, occupied):\n        return None\n\n    try:\n        main(grid)\n    except (AssertionError, Exception):\n        return None\n\n    return grid\n\n===== /home/lixinyu/snap/new/ARC_code/train/985ae207.py =====\n--- _gen_attempt ---\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Generate a single input grid for task 985ae207.\"\"\"\n    H = random.randint(GRID_MIN_SIZE, GRID_MAX_SIZE)\n    W = random.randint(GRID_MIN_SIZE, GRID_MAX_SIZE)\n    bg = BG_COLOR\n    grid = np.full((H, W), bg, dtype=int)\n\n    body_color, target_colors = _sample_palette(bg)\n    rects = _place_rectangles(grid, target_colors)\n    if rects is None:\n        return None\n\n    sprite_assignments = _assign_sprites(rects)\n    placed_sprites = []\n    for rect_idx, center_color in sprite_assignments:\n        if not _try_place_assigned_sprite(grid, rects[rect_idx], center_color, body_color, placed_sprites, bg):\n            return None\n\n    try:\n        main(grid)\n    except Exception:\n        return None\n\n    return grid\n\n===== /home/lixinyu/snap/new/ARC_code/eval/a25697e4.py =====\n--- _gen_attempt ---\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n    H = random.randint(*GRID_H_RANGE)\n    W = random.randint(*GRID_W_RANGE)\n    bg = random.choice(list(range(10)))\n    num_pairs = random.choice(NUM_PAIRS_CHOICES)\n\n    pair_specs = _pick_pair_specs(num_pairs)\n    if len(pair_specs) != num_pairs:\n        return None\n\n    colors = [c for c in range(1, 10) if c != bg]\n    random.shuffle(colors)\n    need = 1 + (3 * num_pairs)\n    if len(colors) < need:\n        return None\n\n    sides = random.sample([\"left\", \"right\", \"top\", \"bottom\"], k=num_pairs)\n    output = np.full((H, W), bg, dtype=int)\n    input_grid = np.full((H, W), bg, dtype=int)\n    union_bboxes: list[tuple[int, int, int, int]] = []\n    frame_bboxes: list[tuple[int, int, int, int]] = []\n    placed_tools: list[dict] = []\n\n    for i, spec in enumerate(pair_specs):\n        info = _place_docked_pair(\n            i, spec, colors, sides[i], bg, H, W,\n            output, input_grid, union_bboxes, frame_bboxes,\n        )\n        if info is None:\n            return None\n        placed_tools.append(info)\n\n    placement_canvas = output.copy()\n    for info in placed_tools:\n        if not _undock_tool(info, bg, input_grid, placement_canvas):\n            return None\n\n    if np.array_equal(main(input_grid), output):\n        return input_grid\n    return None\n\n===== /home/lixinyu/snap/new/ARC_code/train/2e65ae53.py =====\n--- _gen_attempt ---\ndef _gen_attempt() -> np.ndarray | None:\n    rows, cols = _choose_canvas_shape()\n    n_frames = random.randint(*FRAME_COUNT_RANGE)\n    frame_color, slot_colors = _choose_palette()\n\n    specs = _choose_frame_specs(n_frames, rows, cols)\n    if specs is None:\n        return None\n\n    placed = _place_frames(rows, cols, specs)\n    if placed is None:\n        return None\n\n    out = np.full((rows, cols), BG, dtype=int)\n    line_data: list[tuple[int, int, list[int], list[int]]] = []\n    for r0, c0, heights, widths in placed:\n        patch, row_lines, col_lines = _make_output_patch(heights, widths, frame_color, slot_colors)\n        paste(out, patch, r0, c0)\n        line_data.append((r0, c0, row_lines, col_lines))\n\n    inp = out.copy()\n    providers = _hint_providers(n_frames)\n    for frame_idx, (r0, c0, row_lines, col_lines) in enumerate(line_data):\n        for sr, sc in SLOT_POSITIONS:\n            if providers[(sr, sc)] == frame_idx:\n                continue\n            rr0 = r0 + row_lines[sr] + 1\n            rr1 = r0 + row_lines[sr + 1]\n            cc0 = c0 + col_lines[sc] + 1\n            cc1 = c0 + col_lines[sc + 1]\n            inp[rr0:rr1, cc0:cc1] = BG\n\n    try:\n        if int(get_bg(inp)) != BG:\n            return None\n        solved = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(solved, out):\n        return None\n    return inp\n\n===== /home/lixinyu/snap/new/ARC_code/train/46c35fc7.py =====\n--- _gen_attempt ---\ndef _gen_attempt() -> np.ndarray | None:\n    bg = BG_COLOR\n    count = random.randint(RING_COUNT_MIN, RING_COUNT_MAX)\n    rows, cols = random.choice(_SIZES[count])\n    positions = random.choice(_POSITION_SETS[count][(rows, cols)])\n    grid = _render_grid(rows, cols, positions, bg)\n    return grid if _oracle_accepts(grid, positions) else None\n\n","exit_code":0,"status":"completed"}}
