{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n    h, w = canvas_mask.shape\n    sr, sc = seed\n    if not canvas_mask[sr, sc]:\n        return None\n    blob = {(sr, sc)}\n    frontier = []\n    def push_neighbors(r, c):\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:\n                frontier.append((nr, nc))\n    push_neighbors(sr, sc)\n    while len(blob) < target_size and frontier:\n        idx = rng.randrange(len(frontier))\n        r, c = frontier.pop(idx)\n        if (r, c) in blob or not canvas_mask[r, c]:\n            continue\n        blob.add((r, c))\n        push_neighbors(r, c)\n    if len(blob) < target_size:\n        return None\n    return blob\n\n\ndef _blob_wall_cells(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n    wall = set()\n    for r, c in blob:\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in blob:\n                wall.add((nr, nc))\n    return wall\n\n\ndef _fill_holes(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Return blob with interior holes absorbed.\n\n    Barrier = blob union its wall ring. Any non-barrier cell unreachable from the grid\n    border through non-barrier cells is trapped and gets absorbed into the blob.\n    \"\"\"\n    walls = _blob_wall_cells(blob, h, w)\n    barrier = np.zeros((h, w), dtype=bool)\n    for r, c in blob:\n        barrier[r, c] = True\n    for r, c in walls:\n        barrier[r, c] = True\n\n    # Flood-fill from border through non-barrier cells.\n    reachable = np.zeros((h, w), dtype=bool)\n    stack = []\n    for r in range(h):\n        for c in (0, w - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    for c in range(w):\n        for r in (0, h - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    while stack:\n        r, c = stack.pop()\n        if reachable[r, c] or barrier[r, c]:\n            continue\n        reachable[r, c] = True\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and not reachable[nr, nc] and not barrier[nr, nc]:\n                stack.append((nr, nc))\n\n    trapped = (~reachable) & (~barrier)\n    if not trapped.any():\n        return blob\n    filled = set(blob)\n    for r, c in np.argwhere(trapped):\n        filled.add((int(r), int(c)))\n    return filled\n\n\n# ── Slide helpers ─────────────────────────────────────────────────\n\ndef _slide_step_valid(region_set: set, r: int, c: int, dr: int, dc: int) -> bool:\n    nr, nc = r + dr, c + dc\n    if (nr, nc) not in region_set:\n        return False\n    if dr != 0 and dc != 0:\n        if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n            return False\n    return True\n\n\ndef _forward_slide(region_set: set, start: tuple[int, int], dr: int, dc: int,\n                   blocked: set) -> tuple[int, int]:\n    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n    r, c = start\n    while True:\n        if not _slide_step_valid(region_set, r, c, dr, dc):\n            break\n        nr, nc = r + dr, c + dc\n        if (nr, nc) in blocked:\n            break\n        r, c = nr, nc\n    return (r, c)\n\n\n# ── Generator phases ─────────────────────────────────────────────\n\ndef _place_legends(rng: random.Random, grid: np.ndarray,\n                   ) -> tuple[np.ndarray, list[tuple[int, tuple[int,int]]]]:\n    \"\"\"Place 1-2 legend patches at grid corners.\n\n    Returns (legend_occupied mask, list of (wall_color, direction) pairs).\n    \"\"\"\n    h, w = grid.shape\n    n_legends = rng.choice([1, 2])\n    corners = rng.sample(CORNERS, n_legends)\n    wall_colors = rng.sample(WALL_COLOR_CHOICES, n_legends)\n\n    legend_occupied = np.zeros((h, w), dtype=bool)\n    legends = []\n\n    for corner, wc in zip(corners, wall_colors):\n        if rng.random() < CARDINAL_PROB:\n            dr, dc = rng.choice(CARDINAL_DIRS)\n            patch = _legend_5x5(wc, dr, dc)\n        else:\n            dr, dc = rng.choice(DIAGONAL_DIRS)\n            patch = _legend_6x7(wc, dr, dc)\n        ph, pw = patch.shape\n        r0, c0 = _corner_origin(corner, h, w, ph, pw)\n        paste(grid, patch, r0, c0)\n        # Reserve legend cells + buffer.\n        r_lo, r_hi = max(0, r0 - LEGEND_BUFFER), min(h, r0 + ph + LEGEND_BUFFER)\n        c_lo, c_hi = max(0, c0 - LEGEND_BUFFER), min(w, c0 + pw + LEGEND_BUFFER)\n        legend_occupied[r_lo:r_hi, c_lo:c_hi] = True\n        legends.append((wc, (dr, dc)))\n\n    return legend_occupied, legends\n\n\ndef _grow_regions(rng: random.Random, legends: list[tuple[int, tuple[int,int]]],\n                  legend_occupied: np.ndarray,\n                  ) -> list[dict] | None:\n    \"\"\"Grow irregular closed regions, one per assigned wall color.\n\n    Returns list of region dicts or None on failure.\n    \"\"\"\n    h, w = legend_occupied.shape\n    color_dir = {wc: d for wc, d in legends}\n    all_colors = [wc for wc, _ in legends]\n\n    # Assign 1-3 regions per wall color, cap total.\n    region_colors = []\n    for c in all_colors:\n        region_colors.extend([c] * rng.randint(*REGIONS_PER_COLOR))\n    if len(region_colors) > MAX_TOTAL_REGIONS:\n        region_colors = rng.sample(region_colors, MAX_TOTAL_REGIONS)\n    rng.shuffle(region_colors)\n\n    size_min, size_max = REGION_SIZE_BOUNDS[len(region_colors)]\n    occupied = legend_occupied.copy()\n    regions = []\n\n    for rc in region_colors:\n        dr, dc = color_dir[rc]\n        target_size = rng.randint(size_min, size_max)\n\n        # Build canvas: interior cells (not border) that are unoccupied.\n        canvas = np.ones((h, w), dtype=bool)\n        canvas[0, :] = False; canvas[-1, :] = False\n        canvas[:, 0] = False; canvas[:, -1] = False\n        canvas &= ~occupied\n        if not canvas.any():\n            continue\n\n        blob = _try_grow_valid_blob(rng, canvas, occupied, target_size, h, w)\n        if blob is None:\n            continue\n\n        walls = _blob_wall_cells(blob, h, w)\n        regions.append({'color': rc, 'dir': (dr, dc), 'interior': blob, 'walls': walls})\n\n        # Reserve blob + walls + 1-cell buffer around walls.\n        reserve = blob | walls\n        extra = set()\n        for r, c in walls:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in reserve:\n                    extra.add((nr, nc))\n        for r, c in reserve | extra:\n            occupied[r, c] = True\n\n    if not regions:\n        return None\n    # Every legend color must have at least one region.\n    if {reg['color'] for reg in regions} != set(all_colors):\n        return None\n    return regions\n\n\ndef _try_grow_valid_blob(rng: random.Random, canvas: np.ndarray,\n                         occupied: np.ndarray, target_size: int,\n                         h: int, w: int) -> set[tuple[int,int]] | None:\n    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n    for _ in range(BLOB_GROW_RETRIES):\n        free = np.argwhere(canvas)\n        if len(free) == 0:\n            break\n        sr, sc = free[rng.randrange(len(free))]\n        cand = _grow_blob(canvas, (int(sr), int(sc)), target_size, rng)\n        if cand is None:\n            continue\n        # Fill interior holes until stable.\n        while True:\n            filled = _fill_holes(cand, h, w)\n            if filled == cand:\n                break\n            cand = filled\n        # Absorbed cells must stay within canvas.\n        if any(not canvas[r, c] for r, c in cand):\n            continue\n        walls = _blob_wall_cells(cand, h, w)\n        # Walls must not overlap occupied cells or the grid border.\n        if any(occupied[wr, wc] or wr in (0, h - 1) or wc in (0, w - 1)\n               for wr, wc in walls):\n            continue\n        return cand\n    return None\n\n\ndef _validate_topology(grid: np.ndarray, regions: list[dict]) -> bool:\n    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n    h, w = grid.shape\n    labeled, n_comp = label_mask(grid == 0, connectivity=4)\n    bounded = []\n    for comp_id in range(1, n_comp + 1):\n        coords = np.argwhere(labeled == comp_id)\n        if any(r in (0, h - 1) or c in (0, w - 1) for r, c in coords):\n            continue\n        bounded.append({(int(r), int(c)) for r, c in coords})\n    region_sets = [reg['interior'] for reg in regions]\n    if len(bounded) != len(region_sets):\n        return False\n    return all(comp in region_sets for comp in bounded)\n\n\ndef _place_yellows(rng: random.Random, regions: list[dict],\n                   grid: np.ndarray) -> bool:\n    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n\n    Modifies grid in-place by painting yellow(4) at input positions.\n    Returns True on success.\n    \"\"\"\n    for reg in regions:\n        blob = reg['interior']\n        dr, dc = reg['dir']\n        n_yellows = rng.choice(YELLOWS_PER_REGION)\n\n        # Cells sorted by projection onto slide direction (farthest first).\n        cells_sorted = sorted(blob, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n        far_key = dr * cells_sorted[0][0] + dc * cells_sorted[0][1]\n        tier1 = [p for p in cells_sorted if dr * p[0] + dc * p[1] == far_key]\n\n        # Pick output positions: first at the farthest tier, second one step behind or at tier1.\n        first = tier1[rng.randrange(len(tier1))]\n        output_positions = [first]\n\n        if n_yellows == 2:\n            pr, pc = first[0] - dr, first[1] - dc\n            cands = ([(pr, pc)] if (pr, pc) in blob else []) + [p for p in tier1 if p != first]\n            if cands:\n                second = cands[rng.randrange(len(cands))]\n                if second != first:\n                    output_positions.append(second)\n\n        # Reverse-slide: process in solver order (far-to-near).\n        out_sorted = sorted(output_positions, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n        already_stopped = set()\n        yellows_input = []\n\n        for out_pos in out_sorted:\n            candidate = _find_reverse_slide(blob, out_pos, dr, dc, already_stopped,\n                                            yellows_input, rng)\n            if candidate is None:\n                return False\n            yellows_input.append(candidate)\n            already_stopped.add(out_pos)\n\n        for r, c in yellows_input:\n            grid[r, c] = 4\n    return True\n\n\ndef _find_reverse_slide(blob: set, out_pos: tuple[int,int], dr: int, dc: int,\n                        already_stopped: set, existing_inputs: list,\n                        rng: random.Random) -> tuple[int,int] | None:\n    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n    target_steps = rng.randint(1, MAX_SLIDE_STEPS)\n    for steps in range(target_steps, 0, -1):\n        r, c = out_pos\n        path_ok = True\n        for _ in range(steps):\n            pr, pc = r - dr, c - dc\n            if (pr, pc) not in blob or (pr, pc) in already_stopped or (pr, pc) in existing_inputs:\n                path_ok = False\n                break\n            if dr != 0 and dc != 0:\n                if (pr + dr, pc) not in blob or (pr, pc + dc) not in blob:\n                    path_ok = False\n                    break\n            r, c = pr, pc\n        if not path_ok:\n            continue\n        if _forward_slide(blob, (r, c), dr, dc, already_stopped) == out_pos:\n            return (r, c)\n    return None\n\n\ndef _oracle_check(input_grid: np.ndarray, regions: list[dict]) -> bool:\n    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n    h, w = input_grid.shape\n    try:\n        solver_out = main(input_grid)\n    except Exception:\n        return False\n    # Non-yellow, non-bg cells must be identical.\n    struct_mask = (input_grid != 4) & (input_grid != 0)\n    if not np.array_equal(solver_out[struct_mask], input_grid[struct_mask]):\n        return False\n    # Yellow count must be preserved.\n    if (solver_out == 4).sum() != (input_grid == 4).sum():\n        return False\n    # All output yellows must lie inside known region interiors.\n    regions_mask = np.zeros((h, w), dtype=bool)\n    for reg in regions:\n        for r, c in reg['interior']:\n            regions_mask[r, c] = True\n    return bool(np.all(regions_mask[solver_out == 4]))\n\n\n# ── Main generator ────────────────────────────────────────────────\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    h, w = GRID_H, GRID_W\n    grid = np.zeros((h, w), dtype=int)\n\n    legend_occupied, legends = _place_legends(rng, grid)\n    regions = _grow_regions(rng, legends, legend_occupied)\n    if regions is None:\n        return None\n\n    # Paint walls.\n    for reg in regions:\n        for r, c in reg['walls']:\n            grid[r, c] = reg['color']\n\n    if not _validate_topology(grid, regions):\n        return None\n\n    input_grid = grid.copy()\n    if not _place_yellows(rng, regions, input_grid):\n        return None\n    if not _oracle_check(input_grid, regions):\n        return None\n    return input_grid\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/db7260a4.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/db7260a4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the singleton marker into the matching red U-shaped container, or make a bottom-row puddle if no closed container is hit.\n\n    Input structure\n    - The grid has a dominant background, one singleton marker pixel on the top row,\n      and one other foreground color forming vertical bars and bottom segments.\n    - A closed container is a U shape: two vertical side bars with a continuous\n      bottom segment between them and an empty rectangular interior above the bottom.\n\n    Rule\n    - Remove the top marker from its original cell.\n    - If exactly one closed U-shaped container has the marker column within its\n      horizontal footprint, fill that container's empty interior with the marker color.\n    - If no closed container is under the marker column, fill the whole bottom row\n      with the marker color.\n\n    Key insight\n    - The marker does not identify a color by value; it identifies a vertical drop\n      column, and only a structurally closed U shape can catch and contain the fill.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    foreground_colors = colors_present(g, exclude={bg})\n    assert len(foreground_colors) == 2, \"expected marker and wall colors\"\n\n    singleton_colors = [color for color in foreground_colors if int(np.count_nonzero(g == color)) == 1]\n    assert len(singleton_colors) == 1, \"expected exactly one singleton marker color\"\n    marker_color = singleton_colors[0]\n\n    wall_colors = [color for color in foreground_colors if color != marker_color]\n    assert len(wall_colors) == 1\n    wall_color = wall_colors[0]\n\n    marker_coords = np.argwhere(g == marker_color)\n    assert marker_coords.shape == (1, 2)\n    marker_r, marker_c = map(int, marker_coords[0])\n    assert marker_r == 0, \"marker must sit on the top row\"\n\n    containers = [\n        container\n        for container in _closed_u_containers(g, wall_color, bg)\n        if container[0] > marker_r and container[2] <= marker_c <= container[3]\n    ]\n    assert len(containers) <= 1, \"marker column must select at most one closed container\"\n\n    out = g.copy()\n    out[marker_r, marker_c] = bg\n    if containers:\n        top, bottom, left, right = containers[0]\n        out[top:bottom, left + 1 : right] = marker_color\n    else:\n        assert np.all(out[-1, :] == bg), \"missed marker should fall to an empty bottom row\"\n        out[-1, :] = marker_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed ARC colors and canvas.\n_GEN_BG = 0\n_GEN_MARKER = 1\n_GEN_WALL = 2\n_GEN_H = 10\n_GEN_W = 10\n\n# Vertical layout bounds; row 9 stays empty in generated inputs.\n_GEN_MARKER_ROW = 0\n_GEN_MIN_WALL_ROW = 2\n_GEN_LAST_WALL_ROW = 8\n\n# Closed container interior size ranges, with exclusive upper bounds.\n_GEN_INTERIOR_H_RANGE = (2, 4)\n_GEN_INTERIOR_W_RANGE = (1, 6)\n\n# Broken distractor patch size ranges, with exclusive upper bounds.\n_GEN_DISTRACTOR_H_RANGE = (2, 4)\n_GEN_DISTRACTOR_W_RANGE = (4, 7)\n\n# Scenario mix and distractor count ranges, with exclusive upper bounds.\n_GEN_FILL_CONTAINER_PROB = 0.67\n_GEN_MISSED_HAS_U_PROB = 0.55\n_GEN_DISTRACTORS_WITH_U_RANGE = (0, 2)\n_GEN_DISTRACTORS_WITHOUT_U_RANGE = (1, 4)\n\n# Rejection-sampling retry budget.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_u_patch(interior_h: int, interior_w: int) -> np.ndarray:\n    patch = np.full((interior_h + 1, interior_w + 2), _GEN_BG, dtype=int)\n    patch[:, 0] = _GEN_WALL\n    patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    return patch\n\n\ndef _gen_sample_u() -> tuple[int, int, int, int, int, int]:\n    interior_h = int(np.random.randint(*_GEN_INTERIOR_H_RANGE))\n    interior_w = int(np.random.randint(*_GEN_INTERIOR_W_RANGE))\n    top = int(np.random.randint(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - interior_h + 1))\n    bottom = top + interior_h\n    left = int(np.random.randint(0, _GEN_W - interior_w - 1))\n    right = left + interior_w + 1\n    return top, bottom, left, right, interior_h, interior_w\n\n\ndef _gen_broken_u_patch(height: int, width: int, *, gap: int | None = None, missing_side: str | None = None) -> np.ndarray:\n    patch = np.full((height, width), _GEN_BG, dtype=int)\n    if missing_side != \"left\":\n        patch[:, 0] = _GEN_WALL\n    if missing_side != \"right\":\n        patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    if gap is not None:\n        patch[-1, gap] = _GEN_BG\n    return patch\n\n\ndef _gen_distractor_patches() -> list[np.ndarray]:\n    patches: list[np.ndarray] = []\n\n    for h in range(*_GEN_DISTRACTOR_H_RANGE):\n        for w in range(*_GEN_DISTRACTOR_W_RANGE):\n            gap = int(np.random.randint(1, w - 1))\n            patches.append(_gen_broken_u_patch(h, w, gap=gap))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"left\"))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"right\"))\n\n    return patches\n\n\ndef _gen_valid_positions(grid: np.ndarray, patch: np.ndarray) -> list[tuple[int, int]]:\n    ph, pw = patch.shape\n    local = np.argwhere(patch == _GEN_WALL)\n    local_set = {(int(r), int(c)) for r, c in local}\n    touch_local = {\n        (r + dr, c + dc)\n        for r, c in local_set\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1))\n        if (r + dr, c + dc) not in local_set\n    }\n    positions: list[tuple[int, int]] = []\n\n    for r0 in range(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - ph + 2):\n        for c0 in range(0, _GEN_W - pw + 1):\n            if np.any(grid[r0 + local[:, 0], c0 + local[:, 1]] != _GEN_BG):\n                continue\n            touches = any(\n                0 <= r0 + r < _GEN_H\n                and 0 <= c0 + c < _GEN_W\n                and grid[r0 + r, c0 + c] == _GEN_WALL\n                for r, c in touch_local\n            )\n            if not touches:\n                positions.append((r0, c0))\n\n    return positions\n\n\ndef _gen_place_distractors(grid: np.ndarray, count: int) -> bool:\n    patches = _gen_distractor_patches()\n    for _ in range(count):\n        placed = False\n        for idx in np.random.permutation(len(patches)):\n            patch = patches[int(idx)]\n            positions = _gen_valid_positions(grid, patch)\n            if not positions:\n                continue\n            r0, c0 = positions[int(np.random.randint(0, len(positions)))]\n            paste(grid, patch, r0, c0, transparent=_GEN_BG)\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n\n\n_GenUBox = tuple[int, int, int, int]\n\n\ndef _gen_design_expected() -> tuple[np.ndarray, bool, _GenUBox | None, int, int]:\n    \"\"\"Build the expected output and return metadata needed to derive the input.\"\"\"\n    expected = np.full((_GEN_H, _GEN_W), _GEN_BG, dtype=int)\n    fill_container = bool(np.random.random() < _GEN_FILL_CONTAINER_PROB)\n    has_u = fill_container or bool(np.random.random() < _GEN_MISSED_HAS_U_PROB)\n    u_box = None\n\n    if has_u:\n        top, bottom, left, right, interior_h, interior_w = _gen_sample_u()\n        paste(expected, _gen_u_patch(interior_h, interior_w), top, left, transparent=_GEN_BG)\n        u_box = (top, bottom, left, right)\n        if fill_container:\n            marker_c = int(np.random.randint(left + 1, right))\n            expected[top:bottom, left + 1 : right] = _GEN_MARKER\n        else:\n            outside = [c for c in range(_GEN_W) if not (left <= c <= right)]\n            marker_c = int(outside[int(np.random.randint(0, len(outside)))])\n            expected[-1, :] = _GEN_MARKER\n        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITH_U_RANGE))\n    else:\n        marker_c = int(np.random.randint(0, _GEN_W))\n        expected[-1, :] = _GEN_MARKER\n        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITHOUT_U_RANGE))\n\n    return expected, fill_container, u_box, marker_c, distractor_count\n\n\ndef _gen_input_from_expected(expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> np.ndarray:\n    inp = expected.copy()\n    if fill_container:\n        assert u_box is not None\n        top, bottom, left, right = u_box\n        inp[top:bottom, left + 1 : right] = _GEN_BG\n    else:\n        inp[-1, :] = _GEN_BG\n    inp[_GEN_MARKER_ROW, marker_c] = _GEN_MARKER\n    return inp\n\n\ndef _gen_valid_pair(inp: np.ndarray, expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> bool:\n    \"\"\"Check structural invariants and the solver oracle.\"\"\"\n    if np.count_nonzero(inp == _GEN_MARKER) != 1 or inp[_GEN_MARKER_ROW, marker_c] != _GEN_MARKER:\n        return False\n    if not np.all(inp[-1, :] == _GEN_BG):\n        return False\n\n    wall_coords = np.argwhere(inp == _GEN_WALL)\n    if wall_coords.size == 0 or int(wall_coords[:, 0].min()) < _GEN_MIN_WALL_ROW or int(wall_coords[:, 0].max()) > _GEN_LAST_WALL_ROW:\n        return False\n\n    component_count = len(find_components(inp, bg=_GEN_BG, colors=[_GEN_WALL], connectivity=4))\n    if not (1 <= component_count <= 3):\n        return False\n\n    containers = _closed_u_containers(inp, _GEN_WALL, _GEN_BG)\n    if len(containers) > 1:\n        return False\n    if any(marker_c in (left, right) for _top, _bottom, left, right in containers):\n        return False\n    if fill_container:\n        if len(containers) != 1 or containers[0] != u_box:\n            return False\n    elif containers and containers[0][2] <= marker_c <= containers[0][3]:\n        return False\n\n    try:\n        actual = main(inp)\n    except Exception:\n        return False\n    return np.array_equal(actual, expected)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    expected, fill_container, u_box, marker_c, distractor_count = _gen_design_expected()\n    if not _gen_place_distractors(expected, distractor_count):\n        return None\n\n    inp = _gen_input_from_expected(expected, fill_container, u_box, marker_c)\n    if not _gen_valid_pair(inp, expected, fill_container, u_box, marker_c):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
