same period, and draw the outer left and right borders\n112:      in the first below-control color.\n113:\n114:    Key insight: The small control bars are the first two ticks of two periodic\n115:    frame patterns; the diagonal anchor supplies the opposite corner and the\n116:    missing two anchor copies.\n117:    \"\"\"\n118:    g = np.asarray(grid, dtype=int)\n119:    bg = get_bg(g)\n120:    source, dest, right_controls, below_controls = _find_structure(g, bg)\n121:\n122:    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n123:    dr0, dc0, dr1, dc1 = dest[\"bbox\"]\n124:    anchor_color = int(source[\"color\"])\n125:    assert int(dest[\"color\"]) == anchor_color, \"anchor colors must match\"\n126:    assert bbox_h(source[\"bbox\"]) == bbox_h(dest[\"bbox\"]), \"anchor heights must match\"\n127:    assert bbox_w(source[\"bbox\"]) == bbox_w(dest[\"bbox\"]), \"anchor widths must match\"\n128:    assert sr0 > 0 and sc0 > 0, \"upper-left anchor must have space for outer frame\"\n129:    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \"lower-right anchor must have space for outer frame\"\n130:\n131:    right_offsets = [int(comp[\"bbox\"][1] - sc1) for comp in right_controls]\n132:    below_offsets = [int(comp[\"bbox\"][0] - sr1) for comp in below_controls]\n133:    assert right_offsets == below_offsets and right_offsets[0] == 1, \"control offsets must match from the anchor edge\"\n134:    step = int(right_offsets[1] - right_offsets[0])\n135:    assert step > 0, \"control bars must be separated\"\n136:    period = 2 * step\n137:    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, \"right frame must close next to the destination anchor\"\n138:    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, \"below frame must close next to the destination anchor\"\n139:\n140:    right_colors = [int(comp[\"color\"]) for comp in right_controls]\n141:    below_colors = [int(comp[\"color\"]) for comp in below_controls]\n142:    out = g.copy()\n143:\n144:    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)\n145:    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)\n146:\n147:    first_c = int(sc1 + right_offsets[0])\n148:    last_c = int(dc0 - 1)\n149:    for c in range(first_c, last_c + 1):\n150:        offset = int(c - sc1)\n151:        if (offset - right_offsets[0]) % period == 0:\n152:            color = right_colors[0]\n153:        elif (offset - right_offsets[1]) % period == 0:\n154:            color = right_colors[1]\n155:        else:\n156:            continue\n157:        _paint_rect(out, bg, sr0, c, sr1, c, color)\n158:        _paint_rect(out, bg, dr0, c, dr1, c, color)\n159:\n160:    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])\n161:    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])\n162:\n163:    first_r = int(sr1 + below_offsets[0])\n164:    last_r = int(dr0 - 1)\n165:    left_c = int(sc0 - 1)\n166:    right_c = int(dc1 + 1)\n167:    for r in range(first_r, last_r + 1):\n168:        _paint(out, bg, r, left_c, below_colors[0])\n169:        _paint(out, bg, r, right_c, below_colors[0])\n170:\n171:        offset = int(r - sr1)\n172:        if (offset - below_offsets[0]) % period == 0:\n173:            _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])\n\n334:\n335:\n336:def generate_input() -> np.ndarray:\n337:    for _ in range(MAX_GENERATION_ATTEMPTS):\n338:        grid = _gen_attempt()\n339:        if grid is not None:\n340:            return grid\n341:    raise RuntimeError(\"failed to generate valid input\")\n\n=== /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py\n33:\n34:\n35:def main(grid: np.ndarray) -> np.ndarray:\n36:    \"\"\"\n37:    Fill the one blank in each corner region so all four regions have the same color multiset.\n38:\n39:    Input structure:\n40:    - The dominant background color forms one solid separator row and one solid\n41:      separator column.\n42:    - The separator cross splits the grid into four equal rectangular corner regions.\n43:    - Each corner region contains exactly one background-colored blank pixel.\n44:\n45:    Rule:\n46:    - Count the non-background colors in each corner region.\n47:    - The completed region multiset is defined by the maximum observed count of\n48:      each color across the four regions.\n49:    - Replace each region's blank pixel with the single color needed to match that\n50:      completed multiset.\n51:\n52:    Key insight:\n53:    - The separator color inside a corner region is a missing value marker; comparing\n54:      the four regions reveals the shared multiset without using numeric color order.\n55:    \"\"\"\n56:    g = np.asarray(grid, dtype=int)\n57:    assert g.ndim == 2, \"expected a 2D grid\"\n58:    height, width = map(int, g.shape)\n59:\n60:    bg = get_bg(g)\n61:    color_counts = Counter(map(int, g.reshape(-1)))\n62:    assert all(\n63:        color == bg or count < color_counts[bg] for color, count in color_counts.items()\n64:    ), \"background color must be uniquely dominant\"\n65:\n66:    cross_row, cross_col = _solid_separator_cross(g, bg)\n67:    regions = _quadrants(cross_row, cross_col, height, width)\n68:    region_shape = g[regions[0]].shape\n69:    region_area = int(np.prod(region_shape))\n70:\n71:    counts_by_region: list[Counter[int]] = []\n72:    blank_positions: list[tuple[int, int]] = []\n73:    for row_slice, col_slice in regions:\n74:        region = g[row_slice, col_slice]\n75:        assert region.shape == region_shape, \"all corner regions must have the same shape\"\n76:        blanks = np.argwhere(region == bg)\n77:        assert len(blanks) == 1, \"each corner region must have exactly one blank\"\n78:\n79:        counts_by_region.append(Counter(map(int, region[region != bg].reshape(-1))))\n80:        local_r, local_c = map(int, blanks[0])\n81:        blank_positions.append((row_slice.start + local_r, col_slice.start + local_c))\n82:\n83:    target_counts: Counter[int] = Counter()\n84:    for counts in counts_by_region:\n85:        for color, count in counts.items():\n86:            target_counts[color] = max(target_counts[color], count)\n87:    assert sum(target_counts.values()) == region_area, \"completed region multiset must be unique\"\n88:\n89:    out = g.copy()\n90:    for counts, (row, col) in zip(counts_by_region, blank_positions):\n91:        missing = target_counts - counts\n92:        assert len(missing) == 1, \"each blank must have exactly one matching fill color\"\n93:        fill_color, fill_count = next(iter(missing.items()))\n94:        assert fill_count == 1, \"each corner region must need one pixel of the fill color\"\n95:        out[row, col] = fill_color\n96:\n97:    return out\n98:\n99:# --------------- generator (o5x) ---------------\n100:# Canvas/palette bounds.\n101:GRID_HALF_MIN = 2\n102:GRID_HALF_MAX = 6\n103:COLOR_COUNT = 10\n104:MIN_TARGET_COLORS = 3\n105:MAX_NON_BG_COLORS = COLOR_COUNT - 1\n106:# Layout probabilities and constraints.\n107:PREFERRED_GRID_HALF = (2, 2)\n108:PREFERRED_GRID_PROB = 0.65\n109:QUADRANT_COUNT = 4\n110:SEPARATOR_WIDTH = 1\n111:BG_DOMINANCE_MARGIN = 1\n112:# Retry limit.\n113:MAX_GENERATION_ATTEMPTS = 300\n114:\n115:def _gen_bounded_composition(total: int, parts: int, max_each: int) -> list[int] | None:\n\n211:\n212:\n213:def generate_input() -> np.ndarray:\n214:    for _ in range(MAX_GENERATION_ATTEMPTS):\n215:        grid = _gen_attempt()\n216:        if grid is not None:\n217:            return grid\n218:    raise RuntimeError(\"failed to generate a valid e3fe1151 input\")\n\n=== /home/lixinyu/snap/new/ARC_code/train/9841fdad.py\n12:\n13:\n14:def main(grid: np.ndarray) -> np.ndarray:\n15:    \"\"\"\n16:    Expand the colored runs from the left reference panel into the blank right panel.\n17:\n18:    Input structure:\n19:    - A uniform rectangular frame surrounds the grid.\n20:    - One full-height divider of the frame color splits a left reference panel\n21:      from a blank right panel.\n22:    - Both panels have one background margin column on each side of their active\n23:      columns; the left active columns contain two-column endpoint slots, possibly\n24:      connected by same-color horizontal runs.\n25:\n26:    Rule:\n27:    - Keep the original grid and paint only in the right panel's active columns.\n28:    - A source run exactly matching the left endpoint slot is copied to the left\n29:      two columns of the right active span.\n30:    - A source run exactly matching the right endpoint slot is copied to the right\n31:      two columns of the right active span.\n32:    - A source run connecting the endpoint slots is stretched across the entire\n33:      right active span.\n34:\n35:    Key insight:\n36:    The left panel is a compressed legend for the right panel: endpoint markers\n37:    stay two pixels wide, while connectors between endpoints expand to fill the\n38:    distance between them.\n39:    \"\"\"\n40:    g = np.asarray(grid, dtype=int)\n41:    assert g.ndim == 2, \"expected a 2D grid\"\n42:    H, W = g.shape\n43:    assert H >= 3 and W >= 7, \"grid too small for framed two-panel structure\"\n44:\n45:    frame = int(g[0, 0])\n46:    assert np.all(g[0, :] == frame) and np.all(g[-1, :] == frame), \"bad horizontal frame\"\n47:    assert np.all(g[:, 0] == frame) and np.all(g[:, -1] == frame), \"bad vertical frame\"\n48:\n49:    divider = _single_divider_column(g, frame)\n50:    assert divider >= 5 and W - divider >= 6, \"panels must contain margins and active slots\"\n51:\n52:    left_panel = g[1 : H - 1, 1:divider]\n53:    left_bg = get_bg(left_panel)\n54:    assert np.all(left_panel[:, 0] == left_bg), \"left panel must have a left margin\"\n55:    assert np.all(left_panel[:, -1] == left_bg), \"left panel must have a right margin\"\n56:\n57:    mini_start = 2\n58:    mini_end = divider - 2\n59:    assert mini_end - mini_start + 1 >= 4, \"left active region must contain two endpoint slots\"\n60:    left_slot = (mini_start, mini_start + 1)\n61:    right_slot = (mini_end - 1, mini_end)\n62:\n63:    target_start = divider + 2\n64:    target_end = W - 3\n65:    assert target_end - target_start + 1 >= 4, \"right active region must contain endpoint slots\"\n66:    right_bg = int(g[1, divider + 1])\n67:    right_panel = g[1 : H - 1, divider + 1 : W - 1]\n68:    assert np.all(right_panel == right_bg), \"right panel must be blank before expansion\"\n69:\n70:    out = g.copy()\n71:    painted_any = False\n72:    for r in range(1, H - 1):\n73:        c = mini_start\n74:        while c <= mini_end:\n75:            color = int(g[r, c])\n76:            if color == left_bg:\n77:                c += 1\n78:                continue\n79:\n80:            c0 = c\n81:            while c <= mini_end and int(g[r, c]) == color:\n82:                c += 1\n83:            c1 = c - 1\n84:\n85:            in_left_slot = (c0, c1) == left_slot\n86:            in_right_slot = (c0, c1) == right_slot\n87:            if in_left_slot:\n88:                d0, d1 = target_start, target_start + 1\n89:            elif in_right_slot:\n90:                d0, d1 = target_end - 1, target_end\n91:            else:\n92:                assert c0 == left_slot[0] and c1 >= right_slot[0], \"run must connect endpoint slots\"\n93:                d0, d1 = target_start, target_end\n94:\n\n283:\n284:\n285:def generate_input() -> np.ndarray:\n286:    for _ in range(GENERATION_RETRIES):\n287:        grid = _gen_attempt()\n288:        if grid is not None:\n289:            return grid\n290:    raise RuntimeError(\"failed to generate a valid 9841fdad input\")\n\n","exit_code":0,"status":"completed"}}
