{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/34cfa167.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg\nimport random\n\n\ndef _is_solid_rect(g: np.ndarray, comp: dict) -> bool:\n    r0, c0, r1, c1 = comp[\"bbox\"]\n    area = int((r1 - r0 + 1) * (c1 - c0 + 1))\n    return int(comp[\"area\"]) == area and bool(np.all(g[r0 : r1 + 1, c0 : c1 + 1] == int(comp[\"color\"])))\n\n\ndef _find_structure(g: np.ndarray, bg: int) -> tuple[dict, dict, list[dict], list[dict]]:\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n    rects = [comp for comp in comps if _is_solid_rect(g, comp)]\n\n    candidates: list[tuple[dict, dict, list[dict], list[dict]]] = []\n    for color in {int(comp[\"color\"]) for comp in rects}:\n        same_color = [comp for comp in rects if int(comp[\"color\"]) == color]\n        for i, a in enumerate(same_color):\n            for b in same_color[i + 1 :]:\n                if bbox_h(a[\"bbox\"]) != bbox_h(b[\"bbox\"]) or bbox_w(a[\"bbox\"]) != bbox_w(b[\"bbox\"]):\n                    continue\n\n                ar0, ac0, _ar1, _ac1 = a[\"bbox\"]\n                br0, bc0, _br1, _bc1 = b[\"bbox\"]\n                if ar0 < br0 and ac0 < bc0:\n                    source, dest = a, b\n                elif br0 < ar0 and bc0 < ac0:\n                    source, dest = b, a\n                else:\n                    continue\n\n                sr0, sc0, sr1, sc1 = source[\"bbox\"]\n                dr0, dc0, _dr1, _dc1 = dest[\"bbox\"]\n                right = [\n                    comp\n                    for comp in rects\n                    if int(comp[\"color\"]) != color\n                    and comp[\"bbox\"][0] == sr0\n                    and comp[\"bbox\"][2] == sr1\n                    and comp[\"bbox\"][1] == comp[\"bbox\"][3]\n                    and sc1 < comp[\"bbox\"][1] < dc0\n                ]\n                below = [\n                    comp\n                    for comp in rects\n                    if int(comp[\"color\"]) != color\n                    and comp[\"bbox\"][1] == sc0\n                    and comp[\"bbox\"][3] == sc1\n                    and comp[\"bbox\"][0] == comp[\"bbox\"][2]\n                    and sr1 < comp[\"bbox\"][0] < dr0\n                ]\n\n                right_with_offsets = sorted(\n                    ((int(comp[\"bbox\"][1] - sc1), comp) for comp in right),\n                    key=lambda item: item[0],\n                )\n                below_with_offsets = sorted(\n                    ((int(comp[\"bbox\"][0] - sr1), comp) for comp in below),\n                    key=lambda item: item[0],\n                )\n                if len(right_with_offsets) == 2 and len(below_with_offsets) == 2:\n                    right_offsets = [offset for offset, _comp in right_with_offsets]\n                    below_offsets = [offset for offset, _comp in below_with_offsets]\n                    if right_offsets == below_offsets and right_offsets[0] == 1:\n                        candidates.append(\n                            (\n                                source,\n                                dest,\n                                [comp for _offset, comp in right_with_offsets],\n                                [comp for _offset, comp in below_with_offsets],\n                            )\n                        )\n\n    assert len(candidates) == 1, \"expected one anchor pair with matching right and below controls\"\n    return candidates[0]\n\n\ndef _paint(out: np.ndarray, bg: int, r: int, c: int, color: int) -> None:\n    assert int(out[r, c]) in {int(bg), int(color)}, \"paint target must be empty or already matching\"\n    out[r, c] = int(color)\n\n\ndef _paint_rect(out: np.ndarray, bg: int, r0: int, c0: int, r1: int, c1: int, color: int) -> None:\n    for r in range(int(r0), int(r1) + 1):\n        for c in range(int(c0), int(c1) + 1):\n            _paint(out, bg, r, c, color)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.\n\n    Input structure:\n    - The background is the dominant color.\n    - Two same-color solid rectangular anchors of the same size sit on opposite\n      diagonal corners, with the first anchor above-left of the second.\n    - The upper-left anchor has two one-cell-thick vertical control bars to its\n      right and two one-cell-thick horizontal control bars below it.\n\n    Rule:\n    - Copy the anchor rectangle into the two missing corners of the implied\n      larger rectangle.\n    - Repeat the right-side control bars horizontally between the left and right\n      anchors, using their spacing as the period, and draw the outer top and\n      bottom borders in the first right-control color.\n    - Repeat the below-side control bars vertically between the top and bottom\n      anchors, using the same period, and draw the outer left and right borders\n      in the first below-control color.\n\n    Key insight: The small control bars are the first two ticks of two periodic\n    frame patterns; the diagonal anchor supplies the opposite corner and the\n    missing two anchor copies.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    source, dest, right_controls, below_controls = _find_structure(g, bg)\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    dr0, dc0, dr1, dc1 = dest[\"bbox\"]\n    anchor_color = int(source[\"color\"])\n    assert int(dest[\"color\"]) == anchor_color, \"anchor colors must match\"\n    assert bbox_h(source[\"bbox\"]) == bbox_h(dest[\"bbox\"]), \"anchor heights must match\"\n    assert bbox_w(source[\"bbox\"]) == bbox_w(dest[\"bbox\"]), \"anchor widths must match\"\n    assert sr0 > 0 and sc0 > 0, \"upper-left anchor must have space for outer frame\"\n    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \"lower-right anchor must have space for outer frame\"\n\n    right_offsets = [int(comp[\"bbox\"][1] - sc1) for comp in right_controls]\n    below_offsets = [int(comp[\"bbox\"][0] - sr1) for comp in below_controls]\n    assert right_offsets == below_offsets and right_offsets[0] == 1, \"control offsets must match from the anchor edge\"\n    step = int(right_offsets[1] - right_offsets[0])\n    assert step > 0, \"control bars must be separated\"\n    period = 2 * step\n    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, \"right frame must close next to the destination anchor\"\n    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, \"below frame must close next to the destination anchor\"\n\n    right_colors = [int(comp[\"color\"]) for comp in right_controls]\n    below_colors = [int(comp[\"color\"]) for comp in below_controls]\n    out = g.copy()\n\n    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)\n    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)\n\n    first_c = int(sc1 + right_offsets[0])\n    last_c = int(dc0 - 1)\n    for c in range(first_c, last_c + 1):\n        offset = int(c - sc1)\n        if (offset - right_offsets[0]) % period == 0:\n            color = right_colors[0]\n        elif (offset - right_offsets[1]) % period == 0:\n            color = right_colors[1]\n        else:\n            continue\n        _paint_rect(out, bg, sr0, c, sr1, c, color)\n        _paint_rect(out, bg, dr0, c, dr1, c, color)\n\n    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])\n    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])\n\n    first_r = int(sr1 + below_offsets[0])\n    last_r = int(dr0 - 1)\n    left_c = int(sc0 - 1)\n    right_c = int(dc1 + 1)\n    for r in range(first_r, last_r + 1):\n        _paint(out, bg, r, left_c, below_colors[0])\n        _paint(out, bg, r, right_c, below_colors[0])\n\n        offset = int(r - sr1)\n        if (offset - below_offsets[0]) % period == 0:\n            _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])\n            _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])\n        elif (offset - below_offsets[1]) % period == 0:\n            _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])\n            _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color sampling.\nCOLOR_COUNT, NON_BG_COLOR_COUNT = 10, 4\n\n# Anchor/repetition geometry.\nANCHOR_SIZE_RANGE = (1, 5)\nREPEAT_COUNT_RANGE = (2, 5)\nCONTROL_OFFSETS = (1, 3)\nFRAME_PERIOD, DEST_ANCHOR_GAP, STRUCTURE_FIXED_PAD = 4, 2, 3\n\n# Canvas/margins.\nCANVAS_MIN_SIZE, CANVAS_MAX_SIZE = 16, 30\nMARGIN_CHOICES = range(4)\nMIN_TOTAL_MARGIN, SOURCE_OUTER_MARGIN = 1, 1\n\n# Retry.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_paint_rect(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int) -> None:\n    grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)\n\n\ndef _choose_margins(struct_len: int) -> tuple[int, int]:\n    pairs = [\n        (before, after)\n        for before in MARGIN_CHOICES\n        for after in MARGIN_CHOICES\n        if MIN_TOTAL_MARGIN <= before + after\n        and CANVAS_MIN_SIZE <= struct_len + before + after <= CANVAS_MAX_SIZE\n    ]\n    return pairs[int(np.random.randint(len(pairs)))]\n\n\ndef _build_output(\n    rows: int,\n    cols: int,\n    bg: int,\n    anchor_color: int,\n    right1: int,\n    right2: int,\n    below1: int,\n    sr0: int,\n    sc0: int,\n    s: int,\n    nh: int,\n    nv: int,\n) -> tuple[np.ndarray, tuple[int, int, int, int, int, int, int, int]]:\n    out = np.full((rows, cols), int(bg), dtype=int)\n    sr1, sc1 = sr0 + s - 1, sc0 + s - 1\n    dr0 = sr1 + FRAME_PERIOD * nv + DEST_ANCHOR_GAP\n    dc0 = sc1 + FRAME_PERIOD * nh + DEST_ANCHOR_GAP\n    dr1, dc1 = dr0 + s - 1, dc0 + s - 1\n\n    for r0, c0 in ((sr0, sc0), (sr0, dc0), (dr0, sc0), (dr0, dc0)):\n        _gen_paint_rect(out, r0, c0, r0 + s - 1, c0 + s - 1, anchor_color)\n\n    first_c, last_c = sc1 + CONTROL_OFFSETS[0], dc0 - 1\n    for c in range(first_c, last_c + 1):\n        offset = c - sc1\n        if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:\n            color = right1\n        elif (offset - CONTROL_OFFSETS[1]) % FRAME_PERIOD == 0:\n            color = right2\n        else:\n            continue\n        _gen_paint_rect(out, sr0, c, sr1, c, color)\n        _gen_paint_rect(out, dr0, c, dr1, c, color)\n    _gen_paint_rect(out, sr0 - 1, first_c, sr0 - 1, last_c, right1)\n    _gen_paint_rect(out, dr1 + 1, first_c, dr1 + 1, last_c, right1)\n\n    first_r, last_r = sr1 + CONTROL_OFFSETS[0], dr0 - 1\n    left_c, right_c = sc0 - 1, dc1 + 1\n    for r in range(first_r, last_r + 1):\n        out[r, left_c] = below1\n        out[r, right_c] = below1\n        offset = r - sr1\n        if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:\n            _gen_paint_rect(out, r, left_c, r, sc1, below1)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/bae5c565.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Erase the top palette row and redraw it below as a widening wedge centered on its missing cell.\n\n    Input structure\n    - The top row is a palette row with exactly one background gap.\n    - Below it, the only foreground is one vertical marker bar of a single color.\n    - The marker bar is either in the gap column or immediately beside it.\n\n    Rule\n    - Clear the grid to background.\n    - Starting at the top of the marker bar, each next row copies one more\n      column of the top-row palette on both sides of the gap.\n    - Fill the gap column with the marker color, and keep the vertical marker bar.\n\n    Key insight\n    - The lone background cell in the top row is the center of the expanding\n      copy; the lower vertical bar provides the center color and the row where\n      the expansion begins.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    height, width = g.shape\n\n    bg = get_bg(g)\n    top = g[0, :]\n    gap_cols = np.flatnonzero(top == bg)\n    assert gap_cols.size == 1, \"expected exactly one background gap in the top row\"\n    gap_col = int(gap_cols[0])\n\n    lower_coords = np.argwhere(g[1:, :] != bg)\n    assert lower_coords.size > 0, \"expected a lower marker bar\"\n    lower_coords[:, 0] += 1\n\n    marker_colors = {int(g[r, c]) for r, c in lower_coords}\n    marker_cols = {int(c) for _r, c in lower_coords}\n    assert len(marker_colors) == 1, \"expected one lower marker color\"\n    assert len(marker_cols) == 1, \"expected one lower marker column\"\n    marker = marker_colors.pop()\n    line_col = marker_cols.pop()\n    line_start = int(lower_coords[:, 0].min())\n\n    assert np.all(g[1:line_start, :] == bg), \"rows before the marker bar must be background\"\n    assert np.all(g[line_start:, line_col] == marker), \"marker bar must be solid\"\n    assert lower_coords.shape[0] == height - line_start, \"marker bar must be the only lower foreground\"\n    assert line_col == gap_col or abs(line_col - gap_col) == 1\n    if line_col != gap_col:\n        assert top[line_col] == marker\n    assert np.all(top[np.arange(width) != gap_col] != bg), \"only the gap may be background in the palette row\"\n\n    out = np.full_like(g, bg)\n    out[line_start:, line_col] = marker\n\n    for r in range(line_start, height):\n        radius = r - line_start\n        c0 = max(0, gap_col - radius)\n        c1 = min(width - 1, gap_col + radius)\n        for c in range(c0, c1 + 1):\n            if radius == 0 and c == gap_col and line_col != gap_col:\n                continue\n            out[r, c] = marker if c == gap_col else int(top[c])\n        out[r, line_col] = marker\n\n    return out\n\n# --------------- generator (att2) ---------------\n# Canvas, structure, and retries.\n_CANVAS_SIZES = (9, 11, 13)\n_LINE_START_MIN = 2\n_MAX_ATTEMPTS = 300\n# Color roles.\n_BACKGROUND, _MARKER = 5, 8\n_PALETTE_COLORS = (0, 1, 2, 3, 4, 6, 7, 8, 9)\n\n\ndef _gen_expected_output(inp: np.ndarray, line_start: int) -> np.ndarray:\n    n = inp.shape[0]\n    gap_col = n // 2\n    out = np.full_like(inp, _BACKGROUND)\n    top = inp[0]\n\n    for r in range(line_start, n):\n        radius = r - line_start\n        c0 = max(0, gap_col - radius)\n        c1 = min(n - 1, gap_col + radius)\n        for c in range(c0, c1 + 1):\n            out[r, c] = _MARKER if c == gap_col else int(top[c])\n\n    return out\n\n\ndef _make_input_grid(n: int, line_start: int) -> np.ndarray:\n    gap_col = n // 2\n    inp = np.full((n, n), _BACKGROUND, dtype=int)\n    for c in range(n):\n        if c != gap_col:\n            inp[0, c] = random.choice(_PALETTE_COLORS)\n    inp[line_start:, gap_col] = _MARKER\n    return inp\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = random.choice(_CANVAS_SIZES)\n    line_start = random.randint(_LINE_START_MIN, n // 2 - 1)\n    inp = _make_input_grid(n, line_start)\n    expected = _gen_expected_output(inp, line_start)\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid bae5c565 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg as _bg_color\nfrom arc_utils import colors_present, get_bg, paste\n\ndef _bbox(pts):\n    return bbox_coords(pts if isinstance(pts, np.ndarray) else np.asarray(list(pts), dtype=int))\ndef _cc4(mask):\n    return components_mask(mask, connectivity=4)\ndef _most_common(arr):\n    vals, counts = np.unique(np.asarray(arr), return_counts=True)\n    return int(vals[counts.argmax()])\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fit a grey bar into a grey frame by aligning projections with colored columns, then stack colors above.\n\n    Input structure:\n    - bg, a grey structural color forming two components: a large rectangular frame (slot) and a smaller bar with upward projections.\n    - Colored pixels inside the slot mark target columns.\n\n    Rule:\n    - Move the bar upward into the slot so its bottom edge sits one cell above the slot's interior bottom.\n    - Shift it horizontally so the bar's upward projections align column-wise with the colored pixels in the slot.\n    - Stack the colored pixels immediately above the bar projections in each column.\n\n    Key insight: The bar's projections act as keys that must align with the colored-column \"locks\" in the slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    # Background: most frequent. \"Grey\" structural color: most frequent non-bg.\n    bg = _bg_color(g)\n    other = g[g != bg]\n    if other.size == 0:\n        return g.copy()\n    grey = _most_common(other)\n\n    def comps_of_color(color: int):\n        comps = [(len(pts), _bbox(pts), pts) for pts in _cc4(g == color)]\n        comps.sort(key=lambda t: (-t[0], t[1]))\n        return comps\n\n    grey_comps = comps_of_color(grey)\n    if len(grey_comps) < 2:\n        return g.copy()\n\n    # Slot is the largest grey component (the right-side frame); bar is the next largest.\n    (_, slot_bbox, _), (_, bar_bbox, bar_pts) = grey_comps[0], grey_comps[1]\n    sr0, sc0, sr1, sc1 = slot_bbox\n\n    # Base output: keep only the slot bbox content, clear all colored pixels inside it.\n    out = np.full_like(g, bg)\n    out[sr0 : sr1 + 1, sc0 : sc1 + 1] = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region = out[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region[(slot_region != bg) & (slot_region != grey)] = bg\n\n    # Compute bar translation: bottom of bar sits 1 cell above slot interior bottom.\n    bar_base_row = max(r for r, _ in bar_pts)\n    slot_interior_bottom = sr1 - 1\n    target_base_row = slot_interior_bottom - 1\n    dy = target_base_row - bar_base_row\n\n    # Determine bar projection columns (columns with any bar pixel above the base row).\n    col_min_row = {}\n    for r, c in bar_pts:\n        col_min_row[c] = min(col_min_row.get(c, r), r)\n    src_proj_cols = sorted([c for c, rmin in col_min_row.items() if rmin < bar_base_row])\n\n    # Determine destination columns from colored pixels in the original slot.\n    dst_cols_set = set()\n    for r, c in np.argwhere((g != bg) & (g != grey)):\n        r = int(r)\n        c = int(c)\n        if sr0 <= r <= sr1 and sc0 <= c <= sc1:\n            dst_cols_set.add(c)\n    dst_cols = sorted(dst_cols_set)\n\n    # Compute a robust horizontal shift aligning projection columns to colored columns.\n    dx = None\n    if src_proj_cols and len(src_proj_cols) == len(dst_cols):\n        deltas = [d - s for s, d in zip(src_proj_cols, dst_cols)]\n        if len(set(deltas)) == 1:\n            dx = deltas[0]\n    if dx is None:\n        # Brute pick dx that maximizes overlap of shifted projection cols with dst cols.\n        best = (-1, 0)\n        dst_set = set(dst_cols)\n        for cand_dx in range(-w, w + 1):\n            score = sum((c + cand_dx) in dst_set for c in src_proj_cols)\n            if score > best[0]:\n                best = (score, cand_dx)\n        dx = best[1]\n\n    # Paste bar into the slot (overwrite with grey).\n    placed = []\n    for r, c in bar_pts:\n        rr = r + dy\n        cc = c + dx\n        if sr0 <= rr <= sr1 and sc0 <= cc <= sc1:\n            out[rr, cc] = grey\n            placed.append((rr, cc))\n\n    # Move colored pixels: for each affected column, stack them immediately above the top of the bar in that column.\n    # Use colors from the original grid (inside slot bbox), ordered top->bottom.\n    placed_by_col = {}\n    for rr, cc in placed:\n        placed_by_col.setdefault(cc, []).append(rr)\n\n    interior_top = sr0 + 1\n    interior_bottom = sr1 - 1\n\n    for col in dst_cols:\n        if col not in placed_by_col:\n            continue\n        bar_top = min(placed_by_col[col])\n        desired_bottom = bar_top - 1\n        if desired_bottom < interior_top:\n            continue\n\n        # Extract original colored pixels in this column (ignore bg/grey).\n        rows = [r for r in range(sr0, sr1 + 1) if g[r, col] != bg and g[r, col] != grey]\n        if not rows:\n            continue\n        colors = [int(g[r, col]) for r in rows]  # top->bottom order by construction\n\n        max_len = desired_bottom - interior_top + 1\n        if max_len <= 0:\n            continue\n        if len(colors) > max_len:\n            colors = colors[-max_len:]\n\n        start_row = desired_bottom - len(colors) + 1\n        start_row = max(start_row, interior_top)\n\n        # Paint (overwrite) within the interior only.\n        for i, colv in enumerate(colors):\n            rr = start_row + i\n            if interior_top <= rr <= interior_bottom:\n                out[rr, col] = colv\n\n    return out\n\n# --------------- generator (attempt 3 (Codex)) ---------------\n\n# --- Palette ---\nBG = 0\nGREY = 5\nPALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)  # colors != bg and != grey\n\n# --- Canvas geometry (fixed per spec) ---\nH, W = 8, 20\n\n# --- Frame (right-hand slot) ---\nFRAME_R0, FRAME_C0 = 0, 9            # top-left of frame patch\nFRAME_H, FRAME_W = 8, 11             # frame patch dimensions\nLEFT_WALL_OPEN_ROWS = (4, 5)         # rows where the left wall of the frame is open\n\n# --- Slot columns inside the frame ---\nSLOT_COLS = [11, 13, 15, 17]         # absolute col indices\nSLOT_LENS = [3, 4, 4, 3]             # per-col length counted from row 1\nSLOT_TOP_ROW = 1                     # topmost interior row of slot columns\n\n# --- Bar geometry ---\nBAR_INPUT_C0 = 1                     # left column of bar in the input (pre-translation)\nBAR_OUTPUT_C0 = 11                   # left column of bar in the expected output (post-translation)\nBAR_R0 = 2                           # top row where bar patch is pasted\nBAR_H, BAR_W = 4, 7                  # bar patch dimensions (4 rows tall, base at local row 3)\nBAR_LOCAL_PROJ_COLS = [0, 2, 4, 6]   # bar projection columns within the patch\nBAR_BASE_ABS_ROW = BAR_R0 + BAR_H - 1  # row 5, absolute row of bar base after paste\n\n# --- Sampling parameters ---\nHEIGHT0_RANGE = (2, 5)               # rng.integers(low, high) -> {2,3,4} for first proj\nHEIGHT_REST_RANGE = (1, 5)           # rng.integers(low, high) -> {1,2,3,4} for other projs\nMAX_ATTEMPTS = 300\n\n\ndef _frame_patch() -> np.ndarray:\n    \"\"\"Grey frame with top/bottom/right walls closed and a 2-cell gap in the left wall.\"\"\"\n    patch = np.zeros((FRAME_H, FRAME_W), dtype=int)\n    patch[[0, -1], :] = GREY                       # top and bottom rows\n    patch[:, -1] = GREY                            # right wall\n    patch[:, 0] = GREY                             # left wall (solid...)\n    patch[list(LEFT_WALL_OPEN_ROWS), 0] = BG       # ...with the opening carved out\n    return patch\n\n\ndef _bar_patch(heights: list[int]) -> np.ndarray:\n    \"\"\"Horizontal bar base with 4 upward grey projections at local cols {0,2,4,6}.\"\"\"\n    patch = np.zeros((BAR_H, BAR_W), dtype=int)\n    patch[-1, :] = GREY                            # full base row\n    for local_c, height in zip(BAR_LOCAL_PROJ_COLS, heights):\n        patch[BAR_H - height : BAR_H, local_c] = GREY\n    return patch\n\n\ndef _paint_slot_column(grid: np.ndarray, col: int, length: int, color: int,\n                       count: int, height: int | None) -> None:\n    \"\"\"Paint one slot column.\n\n    Input mode (height=None): top (length-count) cells grey caps, bottom `count` cells the color.\n    Output mode (height given): grey cap then up to (5-height) visible colored cells flush to top.\n    \"\"\"\n    cap = length - count\n    grid[SLOT_TOP_ROW : SLOT_TOP_ROW + cap, col] = GREY\n    if height is None:\n        grid[SLOT_TOP_ROW + cap : SLOT_TOP_ROW + length, col] = color\n        return\n    visible = min(count, BAR_BASE_ABS_ROW - height)  # = min(count, 5 - height)\n    if visible > 0:\n        row_end = BAR_BASE_ABS_ROW - height          # inclusive last colored row\n        grid[row_end - visible + 1 : row_end + 1, col] = color\n\n\ndef _build_grid(heights: list[int], colors: list[int], colored_counts: list[int],\n                bar_c0: int, output_mode: bool) -> np.ndarray:\n    grid = np.zeros((H, W), dtype=int)\n    paste(grid, _frame_patch(), FRAME_R0, FRAME_C0)\n    paste(grid, _bar_patch(heights), BAR_R0, bar_c0)\n    for col, length, color, count, height in zip(SLOT_COLS, SLOT_LENS, colors, colored_counts, heights):\n        _paint_slot_column(grid, col, length, color, count, height if output_mode else None)\n    return grid\n\n\ndef _sample_params(rng: np.random.Generator) -> tuple[list[int], list[int], list[int]]:\n    colors = [int(v) for v in rng.choice(PALETTE, size=len(SLOT_COLS), replace=False)]\n    colored_counts = [int(rng.integers(1, L + 1)) for L in SLOT_LENS]\n    heights = [int(rng.integers(*HEIGHT0_RANGE))]\n    heights.extend(int(rng.integers(*HEIGHT_REST_RANGE)) for _ in range(len(SLOT_COLS) - 1))\n    return heights, colors, colored_counts\n\n\ndef _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:\n    heights, colors, colored_counts = _sample_params(rng)\n    grid = _build_grid(heights, colors, colored_counts, BAR_INPUT_C0, output_mode=False)\n    expected = _build_grid(heights, colors, colored_counts, BAR_OUTPUT_C0, output_mode=True)\n\n    if get_bg(grid) != BG:\n        return None\n    if sorted(colors_present(grid, exclude=[BG, GREY])) != sorted(colors):\n        return None\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt(rng)\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"generate_input failed after {MAX_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
