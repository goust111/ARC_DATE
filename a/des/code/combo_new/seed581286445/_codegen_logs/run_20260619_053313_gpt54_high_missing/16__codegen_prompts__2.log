{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/train/f8f52ecc.py && printf '\\\\n---GEN---\\\\n' && sed -n '/def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/train/f8f52ecc.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/train/f8f52ecc.py && printf '\\\\n---GEN---\\\\n' && sed -n '/def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/train/f8f52ecc.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect same-colored foreground components with one-cell-wide orthogonal paths around teal wall segments.\n\n    Input structure\n    - The dominant color is the background.\n    - Teal cells are fixed wall segments and are never source connectors.\n    - Other foreground colors appear as one or more 4-connected components; colors with a single component stay unchanged.\n\n    Rule\n    - For each non-background, non-teal color, read its 4-connected components in row-major order.\n    - Connect each consecutive pair by the shortest clear L-shaped path between the two components.\n    - Clear paths may pass only through background or the same color, and they preserve the previous travel axis when both bends are possible.\n\n    Key insight\n    - The output is not a global recolor: each color traces a routed chain through its own components while teal cells and other colors act as blockers.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    wall = Color.TEAL\n    assert np.any(g == wall), \"expected teal wall cells\"\n\n    out = g.copy()\n    connected_color_count = 0\n    for color in _source_colors(g, bg, wall):\n        comps = [\n            comp[\"coords\"]\n            for comp in find_components(\n                g,\n                bg=bg,\n                connectivity=4,\n                monochromatic=True,\n                colors=[color],\n            )\n        ]\n        comps.sort(key=lambda coords: tuple(map(int, coords.min(axis=0))))\n        if len(comps) < 2:\n            continue\n        if len(comps) == 2 and len(comps[0]) == 1 and len(comps[1]) == 1:\n            a = tuple(map(int, comps[0][0]))\n            b = tuple(map(int, comps[1][0]))\n            if a[0] != b[0] and a[1] != b[1]:\n                h_clear = _clear(_path_cells(a, b, \"h\"), g, bg, color)\n                v_clear = _clear(_path_cells(a, b, \"v\"), g, bg, color)\n                assert not (h_clear and v_clear), \"two diagonal singleton components need a blocking obstacle\"\n\n        connected_color_count += 1\n        previous_axis: str | None = None\n        for comp_a, comp_b in zip(comps, comps[1:]):\n            path, previous_axis = _connector_path(comp_a, comp_b, out, bg, color, previous_axis)\n            for r, c in path:\n                assert int(out[r, c]) in (bg, color), \"connector collision with another color\"\n                out[r, c] = color\n\n    assert connected_color_count > 0, \"expected at least one color with multiple components\"\n    return out\n\n# --------------- generator (c) ---------------\n\nBG = Color.BLUE\nWALL = Color.TEAL\n\n# Palette.\nN_COLORS = 10\nALL_COLORS = [c for c in range(N_COLORS) if c not in (BG, WALL)]\n\n# Canvas sizing.\nMIN_ROWS = 8\nMAX_ROWS = 12\nMIN_COLS = 10\nMAX_COLS = 12\nLARGE_GRID_CONNECTABLE_THRESHOLD = 3\nLARGE_GRID_MIN_ROWS = 10\nLARGE_GRID_MIN_COLS = 11\n\n# Foreground object counts and component sizes.\nMIN_CONNECTABLE_COLORS = 1\nMAX_CONNECTABLE_COLORS = 4\nMIN_DISTRACTOR_COLORS = 0\nMAX_DISTRACTOR_COLORS = 4\nMIN_CHAIN_COMPONENTS = 2\nMAX_CHAIN_COMPONENTS = 4\nBLOB_SIZE_CHOICES = [1, 2, 3]\nBLOB_SIZE_WEIGHTS = [6, 3, 1]\n\n# Wall geometry.\nMIN_WALL_SEGMENTS = 1\nMAX_WALL_SEGMENTS = 2\nWALL_ROW_BORDER = 1\nWALL_ROW_GAP = 1\nMIN_WALL_LENGTH = 1\nMAX_WALL_LENGTH = 8\n\n# Validation and retry limits.\nBLOB_PLACEMENT_ATTEMPTS = 80\nDISTRACTOR_PLACEMENT_ATTEMPTS = 50\nGENERATION_ATTEMPTS = 300\nMAX_PATH_CELLS = 25\nMIN_BG_PCT = 79\nMAX_BG_PCT = 90\n\nAXES = (\"h\", \"v\")\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nConnectorOption = tuple[str, list[Coord], Coord, Coord]\n\n\ndef _gen_source_colors(g: np.ndarray, bg: int, wall: int) -> list[int]:\n    colors: list[int] = []\n    seen = {int(bg), int(wall)}\n    for raw in g.ravel():\n        color = int(raw)\n        if color not in seen:\n            seen.add(color)\n            colors.append(color)\n    return colors\n\n\ndef _gen_path_has_marker(\n    output: np.ndarray,\n    color: int,\n    path: list[Coord],\n    start: Coord,\n    stop: Coord,\n) -> bool:\n    endpoints = {start, stop}\n    return any((r, c) not in endpoints and int(output[r, c]) == color for r, c in path)\n\n\ndef _gen_path_cells(start: Coord, stop: Coord, first_axis: str) -> list[Coord]:\n    r0, c0 = start\n    r1, c1 = stop\n    pts: list[Coord] = []\n\n    if first_axis == \"h\":\n        c_step = 1 if c1 >= c0 else -1\n        for c in range(c0, c1 + c_step, c_step):\n            pts.append((r0, c))\n        r_step = 1 if r1 >= r0 else -1\n        for r in range(r0 + r_step, r1 + r_step, r_step):\n            pts.append((r, c1))\n        return pts\n\n    r_step = 1 if r1 >= r0 else -1\n    for r in range(r0, r1 + r_step, r_step):\n        pts.append((r, c0))\n    c_step = 1 if c1 >= c0 else -1\n    for c in range(c0 + c_step, c1 + c_step, c_step):\n        pts.append((r1, c))\n    return pts\n\n\ndef _gen_last_axis(start: Coord, stop: Coord, first_axis: str) -> str:\n    dr = abs(start[0] - stop[0])\n    dc = abs(start[1] - stop[1])\n    if first_axis == \"h\":\n        return \"v\" if dr else \"h\"\n    return \"h\" if dc else \"v\"\n\n\ndef _gen_axis_priority(\n    start: Coord, stop: Coord, previous_axis: str | None\n) -> list[str]:\n    dr = abs(start[0] - stop[0])\n    dc = abs(start[1] - stop[1])\n\n    orders: list[str] = []\n    if previous_axis == \"h\" and dc:\n        orders.append(\"h\")\n    if previous_axis == \"v\" and dr:\n        orders.append(\"v\")\n\n    preferred = \"h\" if dc >= dr else \"v\"\n    if preferred not in orders:\n        orders.append(preferred)\n    other = \"v\" if preferred == \"h\" else \"h\"\n    if other not in orders:\n        orders.append(other)\n    return orders\n\n\ndef _gen_path_is_clear(canvas: np.ndarray, bg: int, color: int, path: list[Coord]) -> bool:\n    return all(int(canvas[r, c]) in (bg, color) for r, c in path)\n\n\ndef _gen_sorted_cell_pairs(comp_a, comp_b) -> list[tuple[int, int, int, int, int]]:\n    pairs: list[tuple[int, int, int, int, int]] = []\n    for a_cell in comp_a:\n        ar, ac = int(a_cell[0]), int(a_cell[1])\n        for b_cell in comp_b:\n            br, bc = int(b_cell[0]), int(b_cell[1])\n            pairs.append((abs(ar - br) + abs(ac - bc), ar, ac, br, bc))\n    pairs.sort()\n    return pairs\n\n\ndef _gen_clear_connector_options(\n    canvas: np.ndarray,\n    bg: int,\n    color: int,\n    comp_a,\n    comp_b,\n) -> list[ConnectorOption]:\n    best_dist: int | None = None\n    options: list[ConnectorOption] = []\n    seen_paths: set[tuple[Coord, ...]] = set()\n\n    for a_cell in comp_a:\n        ar, ac = int(a_cell[0]), int(a_cell[1])\n        for b_cell in comp_b:\n            br, bc = int(b_cell[0]), int(b_cell[1])\n            if ar == br and ac == bc:\n                continue\n            dist = abs(ar - br) + abs(ac - bc)\n            for first_axis in AXES:\n                if (first_axis == \"h\" and ac == bc) or (first_axis == \"v\" and ar == br):\n                    continue\n                path = _gen_path_cells((ar, ac), (br, bc), first_axis)\n                if not _gen_path_is_clear(canvas, bg, color, path):\n                    continue\n                if best_dist is None or dist < best_dist:\n                    best_dist = dist\n                    options = []\n                    seen_paths = set()\n                if dist == best_dist:\n                    key = tuple(path)\n                    if key not in seen_paths:\n                        seen_paths.add(key)\n                        options.append((first_axis, path, (ar, ac), (br, bc)))\n    return options\n\n\ndef _gen_ambiguous_component_step(\n    canvas: np.ndarray,\n    bg: int,\n    color: int,\n    comp_a,\n    comp_b,\n    previous_axis: str | None,\n) -> bool:\n    options = _gen_clear_connector_options(canvas, bg, color, comp_a, comp_b)\n    if len(options) <= 1:\n        return False\n\n    if previous_axis is not None:\n        previous_options = [option for option in options if option[0] == previous_axis]\n        if len(previous_options) == 1:\n            return False\n\n    marked_options = [\n        option\n        for option in options\n        if _gen_path_has_marker(canvas, color, option[1], option[2], option[3])\n    ]\n    return len(marked_options) != 1\n\n\ndef _gen_input_has_ambiguous_connector(inp: np.ndarray) -> bool:\n    \"\"\"Replay generator routing and reject inputs where the solver route is not unique.\"\"\"\n    bg = get_bg(inp)\n    canvas = inp.copy()\n    for color in _gen_source_colors(inp, bg, WALL):\n        components = [\n            comp[\"coords\"]\n            for comp in find_components(\n                inp,\n                bg=bg,\n                connectivity=4,\n                monochromatic=True,\n                colors=[color],\n            )\n        ]\n        components.sort(key=lambda coords: tuple(map(int, coords.min(axis=0))))\n        if len(components) < 2:\n            continue\n\n        previous_axis: str | None = None\n        for comp_a, comp_b in zip(components, components[1:]):\n            found = False\n            for _d, ar, ac, br, bc in _gen_sorted_cell_pairs(comp_a, comp_b):\n                if ar == br and ac == bc:\n                    continue\n                start = (ar, ac)\n                stop = (br, bc)\n                if _gen_ambiguous_component_step(canvas, bg, color, comp_a, comp_b, previous_axis):\n                    return True\n                for first_axis in _gen_axis_priority(start, stop, previous_axis):\n                    path = _gen_path_cells(start, stop, first_axis)\n                    if _gen_path_is_clear(canvas, bg, color, path):\n                        for pr, pc in path:\n                            canvas[pr, pc] = color\n                        previous_axis = _gen_last_axis(start, stop, first_axis)\n                        found = True\n                        break\n                if found:\n                    break\n            if not found:\n                break\n    return False\n\n\ndef _try_connect_chain(\n    output: np.ndarray, color: int, components: list[list[Coord]]\n) -> list[Coord] | None:\n    \"\"\"Try to connect sorted components with L-paths. Returns new path cells or None.\"\"\"\n    path_cells: list[Coord] = []\n    previous_axis: str | None = None\n    component_cells = {cell for comp in components for cell in comp}\n    used_route_cells: set[Coord] = set()\n\n    for i in range(len(components) - 1):\n        comp_a = np.array(components[i])\n        comp_b = np.array(components[i + 1])\n\n        found = False\n        for _d, ar, ac, br, bc in _gen_sorted_cell_pairs(comp_a, comp_b):\n            if ar == br and ac == bc:\n                continue\n            if _gen_ambiguous_component_step(output, BG, color, comp_a, comp_b, previous_axis):\n                continue\n            for first_axis in _gen_axis_priority((ar, ac), (br, bc), previous_axis):\n                path = _gen_path_cells((ar, ac), (br, bc), first_axis)\n                if any(cell in used_route_cells for cell in path):\n                    continue\n                if any(int(output[pr, pc]) == color and (pr, pc) not in component_cells for pr, pc in path):\n                    continue\n                if _gen_path_is_clear(output, BG, color, path):\n                    for pr, pc in path:\n                        if output[pr, pc] == BG:\n                            output[pr, pc] = color\n                            path_cells.append((pr, pc))\n                    used_route_cells.update(cell for cell in path if cell not in component_cells)\n                    previous_axis = _gen_last_axis((ar, ac), (br, bc), first_axis)\n                    found = True\n                    break\n            if found:\n                break\n        if not found:\n            for pr, pc in path_cells:\n                output[pr, pc] = BG\n            return None\n    return path_cells\n\n\ndef _place_blob(output: np.ndarray, color: int, size: int) -> list[Coord] | None:\n    \"\"\"Place a connected blob of given size on bg cells, not touching same color.\"\"\"\n    H, W = output.shape\n    for _ in range(BLOB_PLACEMENT_ATTEMPTS):\n        r = random.randint(0, H - 1)\n        c = random.randint(0, W - 1)\n        if output[r, c] != BG:\n            continue\n        blob = [(r, c)]\n        for _ in range(size - 1):\n            base = random.choice(blob)\n            for dr, dc in random.sample(CARDINAL_DIRS, len(CARDINAL_DIRS)):\n                nr, nc = base[0] + dr, base[1] + dc\n                if 0 <= nr < H and 0 <= nc < W and (nr, nc) not in blob and output[nr, nc] == BG:\n                    blob.append((nr, nc))\n                    break\n        if len(blob) != size:\n            continue\n        blob_set = set(blob)\n        touches_same = any(\n            0 <= br + dr < H and 0 <= bc + dc < W\n            and (br + dr, bc + dc) not in blob_set\n            and output[br + dr, bc + dc] == color\n            for br, bc in blob for dr, dc in CARDINAL_DIRS\n        )\n        if not touches_same:\n            for br, bc in blob:\n                output[br, bc] = color\n            return blob\n    return None\n\n\ndef _choose_grid_shape(n_connectable: int) -> tuple[int, int]:\n    if n_connectable >= LARGE_GRID_CONNECTABLE_THRESHOLD:\n        return (\n            random.randint(LARGE_GRID_MIN_ROWS, MAX_ROWS),\n            random.randint(LARGE_GRID_MIN_COLS, MAX_COLS),\n        )\n    return random.randint(MIN_ROWS, MAX_ROWS), random.randint(MIN_COLS, MAX_COLS)\n\n\ndef _place_walls(output: np.ndarray) -> None:\n    \"\"\"Place horizontal teal segments with at least one clear row between chosen rows.\"\"\"\n    H, W = output.shape\n    n_walls = random.randint(MIN_WALL_SEGMENTS, MAX_WALL_SEGMENTS)\n    rows_pool = list(range(WALL_ROW_BORDER, H - WALL_ROW_BORDER))\n    random.shuffle(rows_pool)\n    for _ in range(n_walls):\n        if not rows_pool:\n            break\n        row = rows_pool.pop()\n        rows_pool = [r for r in rows_pool if abs(r - row) > WALL_ROW_GAP]\n        length = random.randint(MIN_WALL_LENGTH, min(MAX_WALL_LENGTH, W - 2))\n        c_start = random.randint(0, W - length)\n        output[row, c_start : c_start + length] = WALL\n\n\ndef _choose_palette(n_connectable: int) -> tuple[list[int], list[int]]:\n    n_distractor = random.randint(\n        MIN_DISTRACTOR_COLORS,\n        min(MAX_DISTRACTOR_COLORS, len(ALL_COLORS) - n_connectable),\n    )\n    palette = random.sample(ALL_COLORS, n_connectable + n_distractor)\n    return palette[:n_connectable], palette[n_connectable:]\n\n\ndef _gen_component_sort_key(cells: list[Coord]) -> tuple[int, int]:\n    return min(r for r, _ in cells), min(c for _, c in cells)\n\n\ndef _place_connectable_chains(output: np.ndarray, colors: list[int]) -> list[Coord] | None:\n    \"\"\"Place source components and draw their hidden output paths.\"\"\"\n    all_path_cells: list[Coord] = []\n    for color in colors:\n        n_comps = random.randint(MIN_CHAIN_COMPONENTS, MAX_CHAIN_COMPONENTS)\n        components: list[list[Coord]] = []\n        for _ in range(n_comps):\n            blob_size = random.choices(BLOB_SIZE_CHOICES, weights=BLOB_SIZE_WEIGHTS)[0]\n            blob = _place_blob(output, color, blob_size)\n            if blob is None:\n                return None\n            components.append(blob)\n\n        components.sort(key=_gen_component_sort_key)\n        path_cells = _try_connect_chain(output, color, components)\n        if path_cells is None:\n            return None\n        all_path_cells.extend(path_cells)\n    return all_path_cells\n\n\ndef _place_distractors(output: np.ndarray, colors: list[int]) -> bool:\n    H, W = output.shape\n    for color in colors:\n        for _ in range(DISTRACTOR_PLACEMENT_ATTEMPTS):\n            r = random.randint(0, H - 1)\n            c = random.randint(0, W - 1)\n            if output[r, c] == BG:\n                output[r, c] = color\n                break\n        else:\n            return False\n    return True\n\n\ndef _erase_paths(output: np.ndarray, path_cells: list[Coord]) -> np.ndarray:\n    inp = output.copy()\n    if path_cells:\n        rows, cols = zip(*path_cells)\n        inp[rows, cols] = BG\n    return inp\n\n\ndef _input_bg_pct(inp: np.ndarray) -> float:\n    return float(np.sum(inp == BG) / inp.size * 100)\n\n\ndef _solver_matches_output(inp: np.ndarray, output: np.ndarray) -> bool:\n    try:\n        return bool(np.array_equal(main(inp), output))\n    except Exception:\n        return False\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n    n_connectable = random.randint(MIN_CONNECTABLE_COLORS, MAX_CONNECTABLE_COLORS)\n    H, W = _choose_grid_shape(n_connectable)\n    output = np.full((H, W), BG, dtype=int)\n\n    _place_walls(output)\n    connectable_colors, distractor_colors = _choose_palette(n_connectable)\n\n    all_path_cells = _place_connectable_chains(output, connectable_colors)\n    if all_path_cells is None or len(all_path_cells) > MAX_PATH_CELLS:\n        return None\n\n    if not _place_distractors(output, distractor_colors):\n        return None\n\n    inp = _erase_paths(output, all_path_cells)\n    if not (MIN_BG_PCT <= _input_bg_pct(inp) <= MAX_BG_PCT):\n        return None\n    if _gen_input_has_ambiguous_connector(inp):\n        return None\n    if _solver_matches_output(inp, output):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n\n---GEN---\ndef generate_input() -> np.ndarray:\n    \"\"\"Generate a valid input grid for task f8f52ecc.\"\"\"\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/train/1d61978c.py && printf '\\\\n---GEN---\\\\n' && sed -n '/def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/train/1d61978c.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/train/1d61978c.py && printf '\\\\n---GEN---\\\\n' && sed -n '/def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/train/1d61978c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor the two diagonal foreground-bar orientations, assigning teal to the larger orientation and red to the smaller one.\n\n    Input structure\n    - The grid has one dominant background color and one foreground color.\n    - Foreground pixels form one-cell-thick diagonal bars.\n    - Every foreground pixel belongs to exactly one diagonal orientation.\n\n    Rule\n    - Keep the background unchanged.\n    - Classify each foreground pixel by whether it has a diagonal neighbor on the NW/SE axis or the NE/SW axis.\n    - Recolor the orientation with more foreground pixels teal and the other orientation red.\n\n    Key insight\n    - The output colors depend on the relative population of the two diagonal orientations, not on a fixed slash direction or position.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = [int(color) for color in np.unique(g) if int(color) != bg]\n    assert len(fg_colors) == 1\n\n    fg = g != bg\n    out = g.copy()\n    height, width = g.shape\n    groups = {\"nw_se\": [], \"ne_sw\": []}\n\n    for r0, c0 in np.argwhere(fg):\n        r, c = int(r0), int(c0)\n        has_nw_se = (\n            (r > 0 and c > 0 and fg[r - 1, c - 1])\n            or (r + 1 < height and c + 1 < width and fg[r + 1, c + 1])\n        )\n        has_ne_sw = (\n            (r > 0 and c + 1 < width and fg[r - 1, c + 1])\n            or (r + 1 < height and c > 0 and fg[r + 1, c - 1])\n        )\n        assert has_nw_se ^ has_ne_sw\n        groups[\"nw_se\" if has_nw_se else \"ne_sw\"].append((r, c))\n\n    nw_se_count = len(groups[\"nw_se\"])\n    ne_sw_count = len(groups[\"ne_sw\"])\n    assert nw_se_count > 0 and ne_sw_count > 0\n    assert nw_se_count != ne_sw_count\n\n    larger = \"nw_se\" if nw_se_count > ne_sw_count else \"ne_sw\"\n    smaller = \"ne_sw\" if larger == \"nw_se\" else \"nw_se\"\n\n    for r, c in groups[larger]:\n        out[r, c] = Color.TEAL\n    for r, c in groups[smaller]:\n        out[r, c] = Color.RED\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Grid and palette.\nGRID_HEIGHT = 16\nGRID_WIDTH = 16\nBACKGROUND_COLOR, FOREGROUND_COLOR = Color.ORANGE, Color.GRAY\nLARGER_COLOR, SMALLER_COLOR = Color.TEAL, Color.RED\n\n# Bar orientation labels and diagonal column deltas.\nNW_SE = \"nw_se\"\nNE_SW = \"ne_sw\"\nORIENTATIONS = (NW_SE, NE_SW)\nORIENTATION_DC = {NW_SE: 1, NE_SW: -1}\n\n# Bar count, length, and foreground density bounds.\nTOTAL_BARS_MIN, TOTAL_BARS_MAX = 2, 6\nBAR_LENGTH_MIN, BAR_LENGTH_MAX = 2, 10\nFG_PIXELS_MIN, FG_PIXELS_MAX = 5, 29\n\n# Placement exclusion and retry controls.\nBLOCK_RADIUS = 1\nBLOCK_DELTAS = tuple(\n    (dr, dc)\n    for dr in range(-BLOCK_RADIUS, BLOCK_RADIUS + 1)\n    for dc in range(-BLOCK_RADIUS, BLOCK_RADIUS + 1)\n)\nGENERATION_ATTEMPTS = 300\n\n\ndef _coords_for_bar(orientation, length, r0, c0):\n    dc = ORIENTATION_DC[orientation]\n    return tuple((r0 + i, c0 + dc * i) for i in range(length))\n\n\ndef _make_bar_catalog():\n    catalog = {}\n    for orientation in ORIENTATIONS:\n        for length in range(BAR_LENGTH_MIN, BAR_LENGTH_MAX + 1):\n            bars = []\n            for r in range(GRID_HEIGHT - length + 1):\n                if orientation == NW_SE:\n                    cols = range(GRID_WIDTH - length + 1)\n                else:\n                    cols = range(length - 1, GRID_WIDTH)\n                for c in cols:\n                    bars.append(_coords_for_bar(orientation, length, r, c))\n            catalog[(orientation, length)] = tuple(bars)\n    return catalog\n\n\n_BAR_CATALOG = _make_bar_catalog()\n\n\ndef _blocked_after(coords):\n    blocked = set()\n    for r, c in coords:\n        for dr, dc in BLOCK_DELTAS:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < GRID_HEIGHT and 0 <= cc < GRID_WIDTH:\n                blocked.add((rr, cc))\n    return blocked\n\n\ndef _adjust_random_length(lengths, predicate, delta, required=True):\n    choices = [i for i, length in enumerate(lengths) if predicate(length)]\n    if not choices and not required:\n        return False\n    lengths[random.choice(choices)] += delta\n    return True\n\n\ndef _random_lengths(n):\n    lengths = [random.randint(BAR_LENGTH_MIN, BAR_LENGTH_MAX) for _ in range(n)]\n    while sum(lengths) > FG_PIXELS_MAX:\n        if not _adjust_random_length(lengths, lambda length: length > BAR_LENGTH_MIN, -1, required=False):\n            break\n    if sum(lengths) < FG_PIXELS_MIN:\n        _adjust_random_length(lengths, lambda length: length < BAR_LENGTH_MAX, 1)\n    random.shuffle(lengths)\n    return lengths\n\n\ndef _break_equal_orientation_lengths(nw_lengths, ne_lengths, total_pixels):\n    groups = [nw_lengths, ne_lengths]\n    group = random.choice(groups)\n    if total_pixels < FG_PIXELS_MAX:\n        if not _adjust_random_length(group, lambda length: length < BAR_LENGTH_MAX, 1, required=False):\n            other = ne_lengths if group is nw_lengths else nw_lengths\n            _adjust_random_length(other, lambda length: length > BAR_LENGTH_MIN, -1)\n    else:\n        if not _adjust_random_length(group, lambda length: length > BAR_LENGTH_MIN, -1, required=False):\n            other = ne_lengths if group is nw_lengths else nw_lengths\n            _adjust_random_length(other, lambda length: length < BAR_LENGTH_MAX, 1)\n\n\ndef _make_bar_specs():\n    total_count = random.randint(TOTAL_BARS_MIN, TOTAL_BARS_MAX)\n    nw_count = random.randint(1, total_count - 1)\n    ne_count = total_count - nw_count\n\n    lengths = _random_lengths(total_count)\n    nw_lengths = lengths[:nw_count]\n    ne_lengths = lengths[nw_count:]\n\n    nw_sum = sum(nw_lengths)\n    ne_sum = sum(ne_lengths)\n    if nw_sum == ne_sum:\n        _break_equal_orientation_lengths(nw_lengths, ne_lengths, sum(lengths))\n\n    specs = [(NW_SE, length) for length in nw_lengths]\n    specs.extend((NE_SW, length) for length in ne_lengths)\n    specs.sort(key=lambda item: (-item[1], random.random()))\n    return specs\n\n\ndef _place_bars(specs):\n    placed = []\n    blocked = set()\n    for orientation, length in specs:\n        candidates = [\n            coords\n            for coords in _BAR_CATALOG[(orientation, length)]\n            if all(coord not in blocked for coord in coords)\n        ]\n        if not candidates:\n            return None\n        coords = random.choice(candidates)\n        placed.append((orientation, coords))\n        blocked.update(_blocked_after(coords))\n    return placed\n\n\ndef _paint_coords(grid, coords, color):\n    rows, cols = zip(*coords)\n    grid[rows, cols] = color\n\n\ndef _render_input_grid(placed):\n    grid = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)\n    for _, coords in placed:\n        _paint_coords(grid, coords, FOREGROUND_COLOR)\n    return grid\n\n\ndef _expected_output(grid, placed):\n    counts = {orientation: 0 for orientation in ORIENTATIONS}\n    for orientation, coords in placed:\n        counts[orientation] += len(coords)\n    if counts[NW_SE] == counts[NE_SW]:\n        return None\n\n    larger = NW_SE if counts[NW_SE] > counts[NE_SW] else NE_SW\n    out = grid.copy()\n    for orientation, coords in placed:\n        color = LARGER_COLOR if orientation == larger else SMALLER_COLOR\n        _paint_coords(out, coords, color)\n    return out\n\n\ndef _gen_attempt():\n    specs = _make_bar_specs()\n    placed = _place_bars(specs)\n    if placed is None:\n        return None\n\n    grid = _render_input_grid(placed)\n    expected = _expected_output(grid, placed)\n    if expected is None:\n        return None\n    try:\n        if not np.array_equal(main(grid), expected):\n            return None\n    except Exception:\n        return None\n    return grid\n\n\ndef generate_input():\n\n---GEN---\ndef generate_input():\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/train/c3fa4749.py && printf '\\\\n---GEN---\\\\n' && sed -n '/def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/train/c3fa4749.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/train/c3fa4749.py && printf '\\\\n---GEN---\\\\n' && sed -n '/def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/train/c3fa4749.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor each side-marked multicolor object embedded in a monochrome panel to its marker color.\n\n    Input structure:\n    - Same-color 4-connected components form monochrome panel regions.\n    - The bounding box of a panel may contain 4-connected non-panel-color objects.\n    - A target object touches exactly one side of its panel bbox, and all of its\n      pixels on that side have one marker color.\n\n    Rule:\n    - For every target object, fill any panel-colored holes enclosed by the object.\n    - Recolor the object and filled holes to the side marker color.\n    - Leave all other pixels unchanged.\n\n    Key insight:\n    - A multicolor object's single contact side identifies both which object should\n      be normalized and which color should replace it.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    _assert_each_panel_has_multicolor_object(g)\n\n    planned: dict[tuple[int, int], int] = {}\n    selected_objects = 0\n\n    for panel_color in colors_present(g):\n        for panel_coords in components_mask(g == panel_color, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(panel_coords)\n            region = g[r0 : r1 + 1, c0 : c1 + 1]\n\n            for obj_coords in components_mask(region != panel_color, connectivity=4):\n                obj_mask = _mask_from_coords(region.shape, obj_coords)\n                marker = _single_side_marker(region, obj_mask)\n                if marker is None:\n                    continue\n\n                selected_objects += 1\n                paint_mask = binary_fill_holes(obj_mask).astype(bool)\n                for rr, cc in np.argwhere(paint_mask):\n                    coord = (int(r0 + rr), int(c0 + cc))\n                    previous = planned.get(coord)\n                    assert previous is None or previous == marker, \"conflicting side-marker recolors\"\n                    planned[coord] = int(marker)\n\n    assert selected_objects > 0, \"expected at least one side-marked object\"\n    assert any(int(g[r, c]) != color for (r, c), color in planned.items()), \"expected at least one visible recolor\"\n\n    out = g.copy()\n    for (r, c), color in planned.items():\n        out[r, c] = color\n    return out\n\n# --------------- generator (att1) ---------------\nCOLOR_COUNT = 10\nGRID_HEIGHT_RANGE = (20, 30)\nGRID_WIDTH_RANGE = (20, 30)\nPANEL_COUNT_RANGE = (2, 4)\nPANEL_HEIGHT_RANGE = (5, 12)\nPANEL_WIDTH_RANGE = (5, 10)\nPANEL_PLACEMENT_TRIES = 50\nTARGET_COUNT_CHOICES = [1, 2, 3, 4]\nTARGET_COUNT_WEIGHTS = [2, 3, 3, 2]\nMAX_TARGETS_PER_PANEL = 2\nDOUBLE_TARGET_PROB = 0.25\nTARGET_SIZE_RANGE = (3, 13)\nGENERATION_ATTEMPTS = 300\nNEIGHBORS_4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\nSIDE_TOP, SIDE_BOTTOM, SIDE_LEFT, SIDE_RIGHT = range(4)\n\n\ndef _on_side(r, c, ph, pw, side):\n    if side == SIDE_TOP:\n        return r == 0\n    if side == SIDE_BOTTOM:\n        return r == ph - 1\n    if side == SIDE_LEFT:\n        return c == 0\n    return c == pw - 1\n\n\ndef _on_other_side(r, c, ph, pw, side):\n    return (\n        (side != SIDE_TOP and r == 0)\n        or (side != SIDE_BOTTOM and r == ph - 1)\n        or (side != SIDE_LEFT and c == 0)\n        or (side != SIDE_RIGHT and c == pw - 1)\n    )\n\n\ndef _can_grow_into(r, c, ph, pw, side, blob, available_mask):\n    return (\n        0 <= r < ph\n        and 0 <= c < pw\n        and (r, c) not in blob\n        and not _on_other_side(r, c, ph, pw, side)\n        and not _on_side(r, c, ph, pw, side)\n        and available_mask[r, c]\n    )\n\n\ndef _extend_frontier(frontier, r, c, ph, pw, side, blob, available_mask):\n    for dr, dc in NEIGHBORS_4:\n        nr, nc = r + dr, c + dc\n        if _can_grow_into(nr, nc, ph, pw, side, blob, available_mask):\n            frontier.append((nr, nc))\n\n\ndef _grow_blob_constrained(ph, pw, contact_cells, target_size, side, available_mask):\n    \"\"\"Grow a 4-connected blob from contact_cells avoiding other sides.\"\"\"\n    blob = set(tuple(x) for x in contact_cells)\n    frontier = []\n    for r, c in blob:\n        _extend_frontier(frontier, r, c, ph, pw, side, blob, available_mask)\n\n    while len(blob) < target_size and frontier:\n        idx = random.randint(0, len(frontier) - 1)\n        cell = frontier[idx]\n        frontier[idx] = frontier[-1]\n        frontier.pop()\n        if cell in blob:\n            continue\n        blob.add(cell)\n        r, c = cell\n        _extend_frontier(frontier, r, c, ph, pw, side, blob, available_mask)\n\n    if len(blob) < 2:\n        return None\n    return blob\n\n\ndef _make_noise_grid(H, W, avoid_colors_at=None):\n    \"\"\"Create random noise where no two 4-adjacent cells share a color.\"\"\"\n    grid = np.zeros((H, W), dtype=int)\n    if avoid_colors_at is None:\n        avoid_colors_at = {}\n    for r in range(H):\n        for c in range(W):\n            neighbors = set()\n            if r > 0: neighbors.add(int(grid[r-1, c]))\n            if c > 0: neighbors.add(int(grid[r, c-1]))\n            extra = avoid_colors_at.get((r, c), set())\n            forbidden = neighbors | extra\n            available = [x for x in range(COLOR_COUNT) if x not in forbidden]\n            if not available:\n                available = [x for x in range(COLOR_COUNT) if x not in neighbors]\n            grid[r, c] = random.choice(available)\n    return grid\n\n\ndef _panel_has_multicolor_object(grid, panel_color, r0, c0, ph, pw):\n    region = grid[r0:r0+ph, c0:c0+pw]\n    for obj_coords in components_mask(region != panel_color, connectivity=4):\n        obj_colors = {int(region[r, c]) for r, c in obj_coords}\n        if len(obj_colors) >= 2:\n            return True\n    return False\n\n\ndef _place_multicolor_corner_distractor(grid, output_grid, panel_color, r0, c0, ph, pw, available):\n    color_choices = [c for c in range(COLOR_COUNT) if c != panel_color]\n    if len(color_choices) < 2:\n        return False\n\n    corner_shapes = [\n        [(0, 0), (0, 1), (1, 0), (1, 1)],\n        [(0, pw - 2), (0, pw - 1), (1, pw - 2), (1, pw - 1)],\n        [(ph - 2, 0), (ph - 2, 1), (ph - 1, 0), (ph - 1, 1)],\n        [(ph - 2, pw - 2), (ph - 2, pw - 1), (ph - 1, pw - 2), (ph - 1, pw - 1)],\n    ]\n    random.shuffle(corner_shapes)\n\n    for cells in corner_shapes:\n        if not all(0 <= r < ph and 0 <= c < pw and available[r, c] for r, c in cells):\n            continue\n\n        cell_set = set(cells)\n        isolated = True\n        for r, c in cells:\n            for dr, dc in NEIGHBORS_4:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < ph and 0 <= nc < pw and (nr, nc) not in cell_set:\n                    if int(grid[r0 + nr, c0 + nc]) != panel_color:\n                        isolated = False\n                        break\n            if not isolated:\n                break\n        if not isolated:\n            continue\n\n        colors = random.sample(color_choices, 2)\n        for idx, (r, c) in enumerate(cells):\n            value = colors[idx % 2]\n            grid[r0 + r, c0 + c] = value\n            output_grid[r0 + r, c0 + c] = value\n            available[r, c] = False\n        return True\n\n    return False\n\n\ndef _place_panels(H, W, panel_colors):\n    panels_info = []\n    occupied = np.zeros((H, W), dtype=bool)\n\n    for pc in panel_colors:\n        ph = random.randint(*PANEL_HEIGHT_RANGE)\n        pw = random.randint(*PANEL_WIDTH_RANGE)\n        placed = False\n        for _ in range(PANEL_PLACEMENT_TRIES):\n            r0 = random.randint(0, H - ph)\n            c0 = random.randint(0, W - pw)\n            if not occupied[r0:r0+ph, c0:c0+pw].any():\n                placed = True\n                break\n        if not placed:\n            return None\n        occupied[r0:r0+ph, c0:c0+pw] = True\n        panels_info.append((pc, r0, c0, ph, pw))\n    return panels_info, occupied\n\n\ndef _build_panel_avoidance(H, W, panels_info, occupied):\n    avoid_at = {}\n    for pc, r0, c0, ph, pw in panels_info:\n        for r in range(r0, r0+ph):\n            for c in [c0-1, c0+pw]:\n                if 0 <= r < H and 0 <= c < W and not occupied[r, c]:\n                    avoid_at.setdefault((r, c), set()).add(pc)\n        for c in range(c0, c0+pw):\n            for r in [r0-1, r0+ph]:\n                if 0 <= r < H and 0 <= c < W and not occupied[r, c]:\n                    avoid_at.setdefault((r, c), set()).add(pc)\n    return avoid_at\n\n\ndef _assign_target_counts(num_panels):\n    total_desired = random.choices(TARGET_COUNT_CHOICES, weights=TARGET_COUNT_WEIGHTS, k=1)[0]\n    total_desired = min(total_desired, num_panels * MAX_TARGETS_PER_PANEL)\n    panel_target_count = [0] * num_panels\n    shuffled = list(range(num_panels))\n    random.shuffle(shuffled)\n    remaining = total_desired\n    for pi in shuffled:\n        if remaining <= 0:\n            break\n        assign = min(\n            remaining,\n            MAX_TARGETS_PER_PANEL if random.random() < DOUBLE_TARGET_PROB and remaining >= 2 else 1,\n        )\n        panel_target_count[pi] = assign\n        remaining -= assign\n    return panel_target_count\n\n\ndef _available_side_cells(available, ph, pw, side):\n    if side == SIDE_TOP:\n        return [(0, c) for c in range(1, pw - 1) if available[0, c]]\n    if side == SIDE_BOTTOM:\n        return [(ph - 1, c) for c in range(1, pw - 1) if available[ph - 1, c]]\n    if side == SIDE_LEFT:\n        return [(r, 0) for r in range(1, ph - 1) if available[r, 0]]\n    return [(r, pw - 1) for r in range(1, ph - 1) if available[r, pw - 1]]\n\n\ndef _paint_target(grid, output_grid, available, panel, side):\n    pc, r0, c0, ph, pw = panel\n    marker = random.choice([c for c in range(COLOR_COUNT) if c != pc])\n    side_cells = _available_side_cells(available, ph, pw, side)\n    if not side_cells:\n        return False\n\n    contact_cells = [random.choice(side_cells)]\n    target_size = random.randint(*TARGET_SIZE_RANGE)\n    blob = _grow_blob_constrained(ph, pw, contact_cells, target_size, side, available)\n    if blob is None:\n        return False\n\n    contact_on_side = {(r, c) for r, c in blob if _on_side(r, c, ph, pw, side)}\n    interior = blob - contact_on_side\n    if not interior:\n        return False\n\n    blob_mask = np.zeros((ph, pw), dtype=bool)\n    for r, c in blob:\n        blob_mask[r, c] = True\n    filled_mask = binary_fill_holes(blob_mask)\n    hole_cells = set(zip(*np.where(filled_mask & ~blob_mask)))\n\n    for r, c in blob:\n        available[r, c] = False\n    for r, c in hole_cells:\n        available[r, c] = False\n\n    for lr, lc in blob:\n        output_grid[r0+lr, c0+lc] = marker\n    for lr, lc in hole_cells:\n        output_grid[r0+lr, c0+lc] = marker\n\n    for lr, lc in contact_on_side:\n        grid[r0+lr, c0+lc] = marker\n    non_panel_non_marker = [c for c in range(COLOR_COUNT) if c != pc and c != marker]\n    if not non_panel_non_marker:\n        non_panel_non_marker = [c for c in range(COLOR_COUNT) if c != pc]\n    for lr, lc in interior:\n        grid[r0+lr, c0+lc] = random.choice(non_panel_non_marker)\n    return True\n\n\ndef _paint_targets(grid, output_grid, panels_info, panel_target_count, panel_available):\n    total_targets_placed = 0\n    for pi in range(len(panels_info)):\n        if panel_target_count[pi] == 0:\n            continue\n        panel = panels_info[pi]\n        _, _, _, ph, pw = panel\n        available = panel_available[pi]\n        used_sides = set()\n\n        for _ in range(panel_target_count[pi]):\n            available_sides = [s for s in range(4) if s not in used_sides]\n            if not available_sides:\n                break\n            side = random.choice(available_sides)\n            used_sides.add(side)\n\n            if _paint_target(grid, output_grid, available, panel, side):\n                total_targets_placed += 1\n    return total_targets_placed\n\n\ndef _ensure_multicolor_objects(grid, output_grid, panels_info, panel_available):\n    for pi, (pc, r0, c0, ph, pw) in enumerate(panels_info):\n        if _panel_has_multicolor_object(grid, pc, r0, c0, ph, pw):\n            continue\n        if not _place_multicolor_corner_distractor(\n            grid, output_grid, pc, r0, c0, ph, pw, panel_available[pi]\n        ):\n            return False\n    return True\n\n\ndef _verified_input(grid, output_grid):\n    try:\n        result = main(grid)\n        if np.array_equal(result, output_grid):\n            return grid\n    except (AssertionError, Exception):\n        pass\n    return None\n\n\ndef _gen_attempt():\n    H = random.randint(*GRID_HEIGHT_RANGE)\n    W = random.randint(*GRID_WIDTH_RANGE)\n\n    num_panels = random.randint(*PANEL_COUNT_RANGE)\n    panel_colors = random.sample(range(COLOR_COUNT), num_panels)\n\n    placed = _place_panels(H, W, panel_colors)\n    if placed is None:\n        return None\n    panels_info, occupied = placed\n\n    grid = _make_noise_grid(H, W, _build_panel_avoidance(H, W, panels_info, occupied))\n    for pc, r0, c0, ph, pw in panels_info:\n        grid[r0:r0+ph, c0:c0+pw] = pc\n\n    output_grid = grid.copy()\n    panel_available = [np.ones((ph, pw), dtype=bool) for _, _, _, ph, pw in panels_info]\n    panel_target_count = _assign_target_counts(num_panels)\n\n    if _paint_targets(grid, output_grid, panels_info, panel_target_count, panel_available) == 0:\n        return None\n    if not _ensure_multicolor_objects(grid, output_grid, panels_info, panel_available):\n        return None\n    return _verified_input(grid, output_grid)\n\n\ndef generate_input() -> np.ndarray:\n\n---GEN---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
