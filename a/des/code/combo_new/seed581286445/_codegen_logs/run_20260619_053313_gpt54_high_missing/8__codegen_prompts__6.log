art[0]==0 else 'B'\n    target_side=random.choice([side])\n    path=[start]; visited={start}\n    success=False\n    target_len=random.randint(18,45)\n    for step in range(target_len):\n        cur=path[-1]\n        opts=neighbors(cur, visited)\n        # encourage interior until late\n        if step < target_len-5:\n            opts=[p for p in opts if p[0] not in (0,h-1) and p[1] not in (0,w-1)] or opts\n        # possible finish\n        finish=[]\n        for p in opts:\n            if p\"'!=start and ((target_side=='\"'L' and p[1]==0) or (target_side=='R' and p[1]==w-1) or (target_side=='T' and p[0]==0) or (target_side=='B' and p[0]==h-1)):\n                if step >= 10:\n                    finish.append(p)\n        if finish and step >= target_len-8 and random.random()<0.5:\n            nxt=random.choice(finish)\n            path.append(nxt); success=True; break\n        if not opts:\n            break\n        # heuristic: prefer cells closer to center then away\n        cx,cy=h/2,w/2\n        opts.sort(key=lambda p: abs(p[0]-cx)+abs(p[1]-cy)+random.random())\n        nxt=opts[0] if random.random()<0.6 else random.choice(opts[:min(4,len(opts))])\n        path.append(nxt); visited.add(nxt)\n    if not success:\n        end=path[-1]\n        if end\"'!=start and ((target_side=='\"'L' and end[1]==0) or (target_side=='R' and end[1]==w-1) or (target_side=='T' and end[0]==0) or (target_side=='B' and end[0]==h-1)) and len(path)>10:\n            success=True\n    if not success:\n        continue\n    rr,g=analyze(base+[set(path)])\n    if rr is None: continue\n    mx=max((len(c) for c,_ in rr), default=0)\n    if mx>=3:\n        print('found attempt',attempt,'len',len(path),'start',start,'end',path[-1],'regions',rr)\n        print(g)\n        break\nelse:\n    print('none')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
