{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nfrom collections import deque\n\ndef comp_regions(g):\n    h,w=g.shape\n    seen=np.zeros((h,w),bool)\n    out=[]\n    for r in range(h):\n        for c in range(w):\n            if g[r,c]\"'!=0 or seen[r,c]:\n                continue\n            q=deque([(r,c)]);seen[r,c]=1;touch=False;cols=set();n=0\n            while q:\n                x,y=q.popleft();n+=1\n                if x in (0,h-1) or y in (0,w-1):touch=True\n                for dx,dy in [(1,0),(-1,0),(0,1),(0,-1)]:\n                    nx,ny=x+dx,y+dy\n                    if 0<=nx<h and 0<=ny<w:\n                        if g[nx,ny]==0 and not seen[nx,ny]:\n                            seen[nx,ny]=1;q.append((nx,ny))\n                        elif g[nx,ny]!=0:\n                            cols.add(int(g[nx,ny]))\n            if not touch:\n                out.append((cols,n))\n    print(out)\n\ndef top_u(g,col,l,r,b):\n    g[0:b+1,l]=col; g[b,l:r+1]=col; g[0:b+1,r]=col\n\ndef bot_u(g,col,l,r,t):\n    h=g.shape[0]; g[t:h,l]=col; g[t,l:r+1]=col; g[t:h,r]=col\n\ndef left_c(g,col,t,b,x):\n    g[t,0:x+1]=col; g[t:b+1,x]=col; g[b,0:x+1]=col\n\ndef right_c(g,col,t,b,x):\n    w=g.shape[1]; g[t,x:w]=col; g[t:b+1,x]=col; g[b,x:w]=col\n\nh=w=24\ng=np.zeros((h,w),int)\ntop_u(g,1,3,20,17)\nbot_u(g,2,6,17,6)\nleft_c(g,3,8,15,9)\nright_c(g,4,8,15,14)\ncomp_regions(g)\nPY'","aggregated_output":"[({1, 2, 3, 4}, 52), ({1, 2, 3}, 12), ({2, 3}, 12), ({2, 4}, 12), ({1, 2, 4}, 12), ({1, 2, 3}, 2), ({1, 2, 4}, 2)]\n","exit_code":0,"status":"completed"}}
