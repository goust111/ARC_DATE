{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, random\nfrom collections import deque\n\nh=w=26\n\ndef top_u(l,r,b):\n    return {(rr,l) for rr in range(0,b+1)} | {(b,cc) for cc in range(l,r+1)} | {(rr,r) for rr in range(0,b+1)}\n\ndef bot_u(l,r,t):\n    return {(rr,l) for rr in range(t,h)} | {(t,cc) for cc in range(l,r+1)} | {(rr,r) for rr in range(t,h)}\n\ndef analyze(paths):\n    g=np.zeros((h,w),int)\n    for i,p in enumerate(paths,1):\n        for r,c in p:\n            if g[r,c]: return None\n            g[r,c]=i\n    seen=np.zeros((h,w),bool)\n    regs=[]\n    for r in range(h):\n        for c in range(w):\n            if g[r,c] or seen[r,c]: continue\n            q=deque([(r,c)]);seen[r,c]=1;touch=False;cols=set();n=0\n            while q:\n                x,y=q.popleft();n+=1\n                if x in (0,h-1) or y in (0,w-1):touch=True\n                for dx,dy in [(1,0),(-1,0),(0,1),(0,-1)]:\n                    nx,ny=x+dx,y+dy\n                    if 0<=nx<h and 0<=ny<w:\n                        if g[nx,ny]==0 and not seen[nx,ny]: seen[nx,ny]=1;q.append((nx,ny))\n                        elif g[nx,ny]\"'!=0: cols.add(int(g[nx,ny]))\n            if not touch: regs.append((cols,n))\n    return regs\n\nfor attempt in range(300000):\n    types=[random.choice(['\"'T','B']) for _ in range(3)]\n    paths=[]\n    boxes=[]\n    ok=True\n    # force nesting by shrinking columns\n    l= random.randint(2,5); r=random.randint(20,23)\n    low= random.randint(4,8); high=random.randint(17,22)\n    for t in types:\n        if t=='T':\n            b=random.randint(low,high)\n            p=top_u(l,r,b)\n            low=b+1\n        else:\n            tt=random.randint(low,high)\n            p=bot_u(l,r,tt)\n            high=tt-1\n        if low>high: ok=False; break\n        if any(p & q for q in paths): ok=False; break\n        paths.append(p)\n        l+=random.randint(1,3); r-=random.randint(1,3)\n        if r-l<4: ok=False; break\n    if not ok: continue\n    regs=analyze(paths)\n    if regs and max((len(c) for c,_ in regs), default=0)>=3:\n        print('found',types,regs)\n        break\nelse:\n    print('none')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
