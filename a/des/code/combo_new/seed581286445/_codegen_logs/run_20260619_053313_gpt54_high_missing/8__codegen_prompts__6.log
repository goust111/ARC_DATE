{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nfrom collections import deque\nfrom itertools import combinations\n\nh=w=18\n\ndef top_u(l,r,b):\n    pts=[]\n    pts += [(rr,l) for rr in range(0,b+1)]\n    pts += [(b,cc) for cc in range(l,r+1)]\n    pts += [(rr,r) for rr in range(0,b+1)]\n    return set(pts)\n\ndef bot_u(l,r,t):\n    pts=[]\n    pts += [(rr,l) for rr in range(t,h)]\n    pts += [(t,cc) for cc in range(l,r+1)]\n    pts += [(rr,r) for rr in range(t,h)]\n    return set(pts)\n\ndef left_c(t,b,x):\n    pts=[]\n    pts += [(t,cc) for cc in range(0,x+1)]\n    pts += [(rr,x) for rr in range(t,b+1)]\n    pts += [(b,cc) for cc in range(0,x+1)]\n    return set(pts)\n\ndef right_c(t,b,x):\n    pts=[]\n    pts += [(t,cc) for cc in range(x,w)]\n    pts += [(rr,x) for rr in range(t,b+1)]\n    pts += [(b,cc) for cc in range(x,w)]\n    return set(pts)\n\ndef regions(paths):\n    g=np.zeros((h,w),int)\n    for i,p in enumerate(paths,1):\n        for r,c in p:\n            if g[r,c]\"'!=0:\n                return None\n            g[r,c]=i\n    seen=np.zeros((h,w),bool)\n    out=[]\n    for r in range(h):\n        for c in range(w):\n            if g[r,c] or seen[r,c]:\n                continue\n            q=deque([(r,c)]);seen[r,c]=1;touch=False;cols=set()\n            while q:\n                x,y=q.popleft()\n                if x in (0,h-1) or y in (0,w-1): touch=True\n                for dx,dy in [(1,0),(-1,0),(0,1),(0,-1)]:\n                    nx,ny=x+dx,y+dy\n                    if 0<=nx<h and 0<=ny<w:\n                        if g[nx,ny]==0 and not seen[nx,ny]:\n                            seen[nx,ny]=1;q.append((nx,ny))\n                        elif g[nx,ny]!=0:\n                            cols.add(int(g[nx,ny]))\n            if not touch:\n                out.append(cols)\n    return out\n\nshapes=[]\nfor l in range(2,6):\n    for r in range(l+4,16):\n        for b in range(5,15):\n            shapes.append(('\"'top', (l,r,b), top_u(l,r,b)))\nfor l in range(2,6):\n    for r in range(l+4,16):\n        for t in range(3,13):\n            shapes.append(('bot', (l,r,t), bot_u(l,r,t)))\nfor t in range(2,10):\n    for b in range(t+4,16):\n        for x in range(4,13):\n            shapes.append(('left', (t,b,x), left_c(t,b,x)))\n            shapes.append(('right',(t,b,x), right_c(t,b,x)))\n\nbest=[]\nfor combo in combinations(range(len(shapes)),3):\n    paths=[shapes[i][2] for i in combo]\n    regs=regions(paths)\n    if regs is None:\n        continue\n    mx=max((len(c) for c in regs), default=0)\n    if mx>=3:\n        print('FOUND')\n        for i in combo:\n            print(shapes[i][0], shapes[i][1], len(shapes[i][2]))\n        print(regs)\n        break\nelse:\n    print('none')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
