{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nfrom collections import deque\n\ndef comp_regions(g):\n    h,w=g.shape\n    seen=np.zeros((h,w),bool)\n    comps=[]\n    for r in range(h):\n        for c in range(w):\n            if g[r,c]\"'!=0 or seen[r,c]:\n                continue\n            q=deque([(r,c)]);seen[r,c]=1;pts=[];touch=False;cols=set()\n            while q:\n                x,y=q.popleft();pts.append((x,y))\n                if x in (0,h-1) or y in (0,w-1):touch=True\n                for dx,dy in [(1,0),(-1,0),(0,1),(0,-1)]:\n                    nx,ny=x+dx,y+dy\n                    if 0<=nx<h and 0<=ny<w:\n                        if g[nx,ny]==0 and not seen[nx,ny]:\n                            seen[nx,ny]=1;q.append((nx,ny))\n                        elif g[nx,ny]!=0:\n                            cols.add(int(g[nx,ny]))\n            comps.append((touch,cols,len(pts),pts))\n    return comps\n\ndef top_u(g,col,l,r,b):\n    g[0:b+1,l]=col\n    g[b,l:r+1]=col\n    g[0:b+1,r]=col\n\ndef bot_u(g,col,l,r,t):\n    h=g.shape[0]\n    g[t:h,l]=col\n    g[t,l:r+1]=col\n    g[t:h,r]=col\n\ndef left_c(g,col,t,b,x):\n    g[t,0:x+1]=col\n    g[t:b+1,x]=col\n    g[b,0:x+1]=col\n\ndef right_c(g,col,t,b,x):\n    w=g.shape[1]\n    g[t,x:w]=col\n    g[t:b+1,x]=col\n    g[b,x:w]=col\n\nh=w=20\ng=np.zeros((h,w),int)\ntop_u(g,1,3,16,14)\nbot_u(g,2,7,12,5)\nleft_c(g,3,7,12,9)\nfor touch,cols,sz,_ in comp_regions(g):\n    if not touch:\n        print(cols,sz)\nprint(g)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
