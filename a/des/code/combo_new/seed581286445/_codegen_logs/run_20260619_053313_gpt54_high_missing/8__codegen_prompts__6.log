{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, random\nfrom collections import deque\n\nh=w=22\n\ndef top_u(l,r,b):\n    return {(rr,l) for rr in range(0,b+1)} | {(b,cc) for cc in range(l,r+1)} | {(rr,r) for rr in range(0,b+1)}\n\ndef bot_u(l,r,t):\n    return {(rr,l) for rr in range(t,h)} | {(t,cc) for cc in range(l,r+1)} | {(rr,r) for rr in range(t,h)}\n\ndef left_c(t,b,x):\n    return {(t,cc) for cc in range(0,x+1)} | {(rr,x) for rr in range(t,b+1)} | {(b,cc) for cc in range(0,x+1)}\n\ndef right_c(t,b,x):\n    return {(t,cc) for cc in range(x,w)} | {(rr,x) for rr in range(t,b+1)} | {(b,cc) for cc in range(x,w)}\n\ndef regs(paths):\n    g=np.zeros((h,w),int)\n    for i,p in enumerate(paths,1):\n        if any(g[r,c] for r,c in p):\n            return None\n        for r,c in p:g[r,c]=i\n    seen=np.zeros((h,w),bool)\n    out=[]\n    for r in range(h):\n        for c in range(w):\n            if g[r,c] or seen[r,c]:continue\n            q=deque([(r,c)]);seen[r,c]=1;touch=False;cols=set();n=0\n            while q:\n                x,y=q.popleft();n+=1\n                if x in (0,h-1) or y in (0,w-1):touch=True\n                for dx,dy in [(1,0),(-1,0),(0,1),(0,-1)]:\n                    nx,ny=x+dx,y+dy\n                    if 0<=nx<h and 0<=ny<w:\n                        if g[nx,ny]==0 and not seen[nx,ny]:seen[nx,ny]=1;q.append((nx,ny))\n                        elif g[nx,ny]\"'!=0: cols.add(int(g[nx,ny]))\n            if not touch: out.append((cols,n))\n    return out,g\n\nfns=[\n('\"'top', lambda: top_u(random.randint(2,5), random.randint(12,19), random.randint(8,18))),\n('bot', lambda: bot_u(random.randint(2,5), random.randint(12,19), random.randint(3,12))),\n('left', lambda: left_c(random.randint(2,8), random.randint(13,19), random.randint(8,18))),\n('right', lambda: right_c(random.randint(2,8), random.randint(13,19), random.randint(3,13))),\n]\nfor attempt in range(200000