0, -1), (0, 1)]\n0342: \n0343: \n0344: # ── Small geometry helpers ─────────────────────────────────────────────\n0345: \n0346: def _get_bar(stem):\n0347:     \"\"\"Return the two bar directions perpendicular to *stem*.\"\"\"\n0348:     if stem[0] == 0:\n0349:         return [(-1, 0), (1, 0)]\n0350:     return [(0, -1), (0, 1)]\n0351: \n0352: \n0353: def _t_cells(center, stem):\n0354:     \"\"\"Return the 4 cells of a T marker: center + stem tip + 2 bar cells.\"\"\"\n0355:     r, c = center\n0356:     bar = _get_bar(stem)\n0357:     return {(r, c), (r + stem[0], c + stem[1]),\n0358:             (r + bar[0][0], c + bar[0][1]), (r + bar[1][0], c + bar[1][1])}\n0359: \n0360: \n0361: def _t_branch_cells(center, stem):\n0362:     \"\"\"Return the 3 branch cells (stem tip + 2 bar), excluding the center.\"\"\"\n0363:     r, c = center\n0364:     bar = _get_bar(stem)\n0365:     return {(r + stem[0], c + stem[1]),\n0366:             (r + bar[0][0], c + bar[0][1]),\n0367:             (r + bar[1][0], c + bar[1][1])}\n0368: \n0369: \n0370: def _t_neighborhood(center, stem):\n0371:     \"\"\"Return cells adjacent to any T cell but not part of the T itself.\"\"\"\n0372:     cells = _t_cells(center, stem)\n0373:     neighborhood = set()\n0374:     for r, c in cells:\n0375:         for dr, dc in _DIRS:\n0376:             nb = (r + dr, c + dc)\n0377:             if nb not in cells:\n0378:                 neighborhood.add(nb)\n0379:     return neighborhood\n0380: \n0381: \n0382: # ── Region partitioning ────────────────────────────────────────────────\n0383: \n0384: def _grow_regions(H: int, W: int, n_regions: int) -> np.ndarray | None:\n0385:     \"\"\"Grow n_regions from random seeds via randomized BFS; returns region-id array or None.\"\"\"\n0386:     region = np.full((H, W), -1, dtype=int)\n0387:     seeds = set()\n0388:     for _ in range(SEED_ATTEMPTS):\n0389:         if len(seeds) >= n_regions:\n0390:             break\n0391:         seeds.add((random.randint(1, H - 2), random