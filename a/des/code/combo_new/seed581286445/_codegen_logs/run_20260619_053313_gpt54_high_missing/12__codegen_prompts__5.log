{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\n\ndef gen_path(rows, cols, length, tries=1000):\n    nbrs = { (r,c): [(nr,nc) for nr,nc in ((r+1,c),(r-1,c),(r,c+1),(r,c-1)) if 0<=nr<rows and 0<=nc<cols] for r in range(rows) for c in range(cols)}\n    for _ in range(tries):\n        start = random.choice(list(nbrs))\n        path=[start]\n        used={start}\n        while len(path)<length:\n            cur=path[-1]\n            opts=[n for n in nbrs[cur] if n not in used]\n            if not opts:\n                break\n            # simple heuristic: prefer nodes with onward options\n            scored=[]\n            for n in opts:\n                onward=sum(1 for m in nbrs[n] if m not in used and m\"'!=cur)\n                scored.extend([n]*(1+onward))\n            nxt=random.choice(scored)\n            path.append(nxt)\n            used.add(nxt)\n        if len(path)==length:\n            return path\n    return None\n\ndef rot_cw(d):\n    dr,dc=d\n    return dc,-dr\n\nfor _ in range(20):\n    path=gen_path(4,4,8)\n    if not path:\n        print('\"'fail')\n        continue\n    right=0; straight=0; left=0\n    for i in range(1,len(path)-1):\n        d1=(path[i][0]-path[i-1][0], path[i][1]-path[i-1][1])\n        d2=(path[i+1][0]-path[i][0], path[i+1][1]-path[i][1])\n        if d2==d1 or d2==(-d1[0],-d1[1]):\n            straight+=1\n        elif d2==rot_cw(d1):\n            right+=1\n        else:\n            left+=1\n    print(path, 's',straight,'r',right,'l',left)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
