 ordered)\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:184:    for r, (color, rooms, _walls, _dist, _cr, _cc) in enumerate(ordered):\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:185:        out[r, :rooms] = int(color)\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:225:def _build_frame(target_rooms: int, max_h: int, max_w: int) -> np.ndarray | None:\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:226:    if target_rooms == 1:\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:241:            if target_rooms <= cells <= target_rooms + 4:\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:247:                if cells >= target_rooms:\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:280:    cells_to_merge = total_cells - target_rooms\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:334:    if _count_enclosed_regions(walls) != target_rooms:\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:409:    for idx, (color, _rooms, wall_arr) in enumerate(frames):\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:455:def _distance_order_has_room_inversion(ordered_rooms: list[int]) -> bool:\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:456:    return any(int(ordered_rooms[i]) > int(ordered_rooms[i + 1]) for i in range(len(ordered_rooms) - 1))\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:469:        room_counts = chosen + [random.choice(chosen)]\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:473:        room_counts = random.sample(available, frame_count)\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:474:    random.shuffle(room_counts)\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:486:    for color, target_rooms in zip(frame_colors, room_counts):\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:487:        frame_data = _build_frame(int(target_rooms), max_h=f_max_h, max_w=f_max_w)\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:493:        frames.append((int(color), int(target_rooms), frame_data))\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:500:    for idx, (color, rooms, wall_arr) in enumerate(frames):\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:502:        frame_info.append((idx, float(distance), float(center_r), float(center_c), int(color), int(rooms)))\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:511:    ordered_rooms = [item[5] for item in ordered_by_distance]\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:512:    if not _distance_order_has_room_inversion(ordered_rooms):\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:523:    max_rooms = max(item[5] for item in ordered_by_distance)\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:524:    expected = np.full((frame_count, max_rooms), int(noise_color), dtype=int)\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:525:    for r, (_idx, _dist, _cr, _cc, color, rooms) in enumerate(ordered_by_distance):\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/2/code.py:526:        expected[r, :rooms] = int(color)\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D11/1/code.py:2:# Dimension: D11 — 通道数量与空间布局 (meta)\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D11/1/code.py:3:# Change: 4-5个通道，均匀列间距4-5，顶部和底部放置token行，管道竖直为主加横向交叉段... → 四边环形布局\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D11/1/code.py:15:#     old: 只有一组上下对置的竖直通道，token 只出现在 top/bottom 两边\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D11/1/code.py:16:#     new: 通道拆成两组叠加在同一网格里\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D11/1/code.py:25:#       不允许 T 形分叉，也不允许在 turn cell 上叠加另一组通道\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D11/1/code.py:37:#     - 总通道数仍为 4-5，避免自由度暴涨\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D11/1/code.py:38:#     - 两组通道数固定为 2+2 或 3+2，保证四边都有 token，同时仍能在 22-26 尺寸内稳定摆放\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D11/1/code.py:49:#     - 因此 turn cells 不会与另一组通道重叠，组间共享的只有 straight-through 交点\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D11/1/code.py:55:#     - 通道数仍小，交会集中在中心区域，边缘只放 token，不把 token 和 9-rect 混在一起\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/3/code.py:22:   - Each true frame still encloses one or more rooms, so the output rows remain horizontal bars whose lengths equal\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/3/code.py:23:     those room counts.\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/3/code.py:24:   - The change is only in row order: instead of sorting bars by room count, sort them by the number of recognizable\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/3/code.py:27:     original logic: frame A has 2 rooms / 7 lines, frame B has 4 rooms / 6 lines -> output order A then B.\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/3/code.py:32:   - If line count and room count are always aligned, the variant visually collapses back to the original task.\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/3/code.py:33:   - The generator therefore samples `(room_count, line_count)` pairs with at least one inversion:\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/3/code.py:34:     some frame must have more rooms but fewer lines than another frame.\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/3/code.py:39:   - Original tie handling depended on equal room counts. In the variant, overlaps only matter for equal line counts.\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/3/code.py:40:   - Noise identification via `rooms == 0` still remains valid because the output bars still encode room counts and\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/3/code.py:51:   - The generator avoids degenerate examples where sorting by lines and sorting by rooms would match exactly.\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/3/code.py:138:    rooms = _count_enclosed_regions(walls)\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/3/code.py:140:    return int(rooms), int(line_count), walls\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D1/3/code.py:161:    above: dict[int, set[int]] = {color: set() f