orridors can coil inward for more than three turns\".\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/11/code.py:108:def _has_corridor(grid: np.ndarray, r: int, c: int, direction: str) -> bool:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/11/code.py:109:    \"\"\"Original-task corridor predicate, kept only for degeneration checks.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/11/code.py:215:            if _has_corridor(grid, tr, tc, turn_dir):\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/11/code.py:225:    \"\"\"Move selected particles through striped corridors with fixed clockwise turns.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/11/code.py:240:    - The true corridors are not defined by same-color corner matching anymore.\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/6/code.py:256:def _corridors_for_center(\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/6/code.py:269:    corridors: list[list[tuple[int, int]]] = []\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/6/code.py:283:            corridors.append(line)\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/6/code.py:284:    return corridors\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/6/code.py:323:    corridors_by_center = {\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/6/code.py:324:        center: _corridors_for_center(center, zones_by_center, grid.shape) for center in centers\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/6/code.py:326:    embeddable = [center for center in centers if corridors_by_center[center]]\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/6/code.py:350:        corridors = corridors_by_center[center]\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/6/code.py:351:        if not corridors:\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/6/code.py:353:        n_dirs = int(rng.integers(1, min(2, len(corridors)) + 1))\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/6/code.py:354:        chosen_ids = np.atleast_1d(rng.choice(len(corridors), size=n_dirs, replace=False))\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/6/code.py:357:            corridor = corridors[int(idx)]\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/6/code.py:358:            max_len = min(3, len(corridor))\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/6/code.py:360:            cells = corridor[:ext_len]\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:18:   - The fusion uses two visible particle/corridor colors only:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:20:     These are not hidden ids; they are the actual corridor colors seen on the grid.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:21:   - Each particle may move only inside corridors whose flanking bars have the same color as the\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:24:     1. move every color-6 source using only color-6 corridors,\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:26:     3. then move every color-8 source using only color-8 corridors on the modified grid.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:37:   - Only two operational colors are used for real corridors. That is enough to create repeated\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:49:   - Original `_has_corridor()` assumed the moving particle color was irrelevant. That breaks:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:50:     the combo must require the corridor wall color to equal the current particle color.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:52:     corridor bars themselves may have the same color as the moving particle. If same-colored wall\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:60:     detect starts by phase color and validate that the first real corridor on the row matches it.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:71:     corridors.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:75:     1. only same-colored left-edge sources enter same-colored corridors,\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:86:     are visually separate from the corridor field.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:91:     1. which corridors that source may use,\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:108:     Generator guarantee: full-width bars start at column 2 or 3 and every real corridor keeps that\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:132:def _has_corridor(\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:133:    grid: np.ndarray, r: int, c: int, direction: str, corridor_color: int\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:135:    \"\"\"True iff (r,c) is a bg path cell flanked by bars of `corridor_color`.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:147:    return a == b == int(corridor_color)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:167:                if _has_corridor(grid, tr, tc, turn_dir, particle_color):\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:236:    - Even rows are bar rows; odd rows are travel rows. Real corridors are same-color bar pairs.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:239:    - A particle may enter and turn only inside corridors whose flanking bars have the same color\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:248:    - The same visible color carries two meanings at once: it selects which corridors are legal for\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:396:def _row_corridor_color(grid: np.ndarray, r: int) -> int | None:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:397:    \"\"\"Return the real corridor color available on row r, ignoring the source color.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:443:        corridor_color = _row_corridor_color(g, r)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/37/code.py:444:        if corridor_color is not None and corridor_color != source_color:\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:9:#      straight ray through the room interior until it hits the far side.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:23:#      east through the room\" in the original task, but here it only fixes the starting tangent on\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:26:#    - The task still contains 1-2 legend colors, irregular non-rectangular closed rooms, and 1-2\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:55:#      glued to the room perimeter while turning corners.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:57:#      arrow is not a free-space motion vector: the yellows do not cut across the room.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:397:    - bg is the most common color, colored walls enclose irregular rooms, and yellow pixels lie on\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:398:      the passable cells inside those rooms.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:405:    - The legend arrow does not mean \"move straight through the room\". Instead it selects which\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/41/code.py:410:    Key insight: The legend color still links the correct room, but the arrow now chooses the\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/25/code.py:455:        room = axis - sz - OBS_BOTH_GAP\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/25/code.py:456:        if room < 2 * lo:\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/25/code.py:458:        a = random.randint(lo, min(hi_cap, room - lo))\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/25/code.py:459:        b = _rand_thickness(lo, min(hi_cap, room - a))\n/home/lixinyu/snap/new/ceshi/code_combo/35ab12c3/29/code.py:350:    - Follow the border marker's empty row/column corridor inward to pick the start vertex, then\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/12/code.py:25:#      cleanest visible form is a 3xL or Lx3 foreground corridor, which contains a\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/12/code.py:31:#    - Concrete trace on a 3x4 corridor:\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/12/code.py:44:#    - Using a small vocabulary of order-sensitive corridor shapes keeps overlap\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/12/code.py:46:#      corridors show both halves of the scan order, while a few isolated distractors\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/12/code.py:62:#    - Every order-sensitive corridor has thickness exactly 3, so every candidate\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/12/code.py:63:#      center lies one cell away from the corridor boundary and therefore has its full\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/12/code.py:67:#    - Mandatory corridors are kept at least one cell away from the outer border for\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/12/code.py:70:#    - A human can compare input/output and notice that connected yellow corridors do\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/12/code.py:73:#    - Because both a horizontal and a vertical corridor are mandatory, examples show\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/12/code.py:78:#      corridor at a time instead of being buried inside a giant foreground mass.\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/12/code.py:85:#    - Overlap is supported by repeated corridor motifs rather than by rare corner\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/12/code.py:98:#      guarantees this with mandatory 3xL and Lx3 corridors containing adjacent\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/12/code.py:185:    - Exactly one other color forms the foreground, including corridor-like blobs where several local '+' centers may share cells.\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/12/code.py:287:    # Mandatory horizontal + vertical corridors already expose both halves of the\n/home/lixinyu/snap/new/ceshi/code_combo/1818057f/12/code.py:288:    # row-major scan. Extra order-sensitive corridors should stay occasional so the\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/6/code.py:21:Generator keeps the original closed-room stage, but now enforces that accepted samples contain:\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/26/code.py:33:#     - 因而同一张输出里同时出现两类证据：中带障碍保持原色并截断光束，侧带障碍内部出现青色通道。\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/26/code.py:53:#     - 阻挡障碍不被覆盖，穿透障碍内部会出现整段青色通道，两类视觉结果非常干净。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:9:#   with particles (6), even rows carry colored bars, real corridors are BG\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:10:#   cells flanked by same-color bar pairs, fake corridors use mismatched colors.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:13:# - Fused behavior: every visited path cell is painted with the active corridor\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:14:#   color, and the endpoint keeps that final corridor color instead of reverting\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:17:#   a particle starts on a horizontal color-4 corridor, moves right leaving\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:18:#   color 4, hits a blocker, turns upward into a color-2 vertical corridor, and\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:29:#   colors are reused for corridor bars, trails, and recolored endpoints.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:33:#   endpoint color depends on the final corridor segment and the trail depends on\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:43:#   forward an `active_color` instead of demanding a fresh local corridor match\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:46:#   task the endpoint is overwritten with the final active corridor color.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:49:# - The generator preserves the original path-first corridor builders for\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:51:# - Vertical-corridor columns are still reserved with a 3-column exclusion\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:59:#   corridor segment. Because at least one accepted path is multicolor, examples\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:60:#   visibly demonstrate that different corridor segments contribute different\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:66:# - Trails reuse existing corridor colors instead of introducing a new overlay\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:69:#   the same color as the final corridor. This avoids a cluttered \"trail plus\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:74:#   currently defines the corridor segment. No ordering by numeric color value,\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:81:# - Every moved particle reaches at least one real corridor cell before any\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:84:#   one perpendicular real-corridor option exists at each blocker.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:105:def _corridor_color(grid: np.ndarray, r: int, c: int, direction: str) -> int | None:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:106:    \"\"\"Return the same-color flank pair for this corridor cell and travel direction.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:125:def _has_corridor(grid: np.ndarray, r: int, c: int, direction: str) -> bool:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:126:    return _corridor_color(grid, r, c, direction) is not None\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:130:    \"\"\"Find the first source-visible real horizontal corridor for row r.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:133:        color = _corridor_color(grid, r, c, \"right\")\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:146:    \"\"\"Resolve the final corridor color, preferring the carried segment color.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:147:    directional = _corridor_color(grid, r, c, direction)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:154:    horiz = _corridor_color(grid, r, c, \"right\")\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:155:    vert = _corridor_color(grid, r, c, \"down\")\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:160:    assert candidates and len(set(candidates)) == 1, \"final position is not on a unique real corridor\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:167:    \"\"\"Trace one particle, recording a corridor-colored trail and final color.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:182:            step_color = _corridor_color(grid, nr, nc, direction)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:194:            turn_color = _corridor_color(grid, tr, tc, turn_dir)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:242:    Paint each particle's route with corridor colors and recolor the endpoint to the final corridor color.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:245:    - bg=7 and particles=6 fill column 0; real horizontal corridors are BG cells between same-color bars.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:246:    - Vertical connections are carved from the same corridor colors, while fake channels use mismatched bar colors.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:250:      turn 90 degrees only into the unique perpendicular real corridor if one exists.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/7/code.py:251:    - E