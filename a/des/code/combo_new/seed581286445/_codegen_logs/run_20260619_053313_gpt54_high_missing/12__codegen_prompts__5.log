 = 0.35               # chance of one tied room-count pair\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D7/1/code.py:251:def _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D7/1/code.py:252:    \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D7/1/code.py:253:    if target_rooms == 1:\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D7/1/code.py:268:            if target_rooms <= cells <= target_rooms + 4:\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D7/1/code.py:274:                if cells >= target_rooms:\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D7/1/code.py:307:    cells_to_merge = total_cells - target_rooms\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D7/1/code.py:361:    if _count_enclosed_regions(walls) != target_rooms:\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D7/1/code.py:433:    max_rooms = max(rc for rc, _cover_rank, _color in frame_info)\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D7/1/code.py:434:    bar_lengths = [_inverse_bar_length(rc, max_rooms) for rc, _cover_rank, _color in frame_info]\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D7/1/code.py:453:        room_counts = chosen + [random.choice(chosen)]\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D7/1/code.py:457:        room_counts = random.sample(available, frame_count)\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D7/1/code.py:458:    random.shuffle(room_counts)\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D7/1/code.py:470:    for color, target_rooms in zip(frame_colors, room_counts):\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D7/1/code.py:471:        frame_data = _build_frame(target_rooms, max_h=f_max_h, max_w=f_max_w)\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D7/1/code.py:477:        frames.append((color, target_rooms, frame_data))\n/home/lixinyu/snap/new/ceshi/code/89565ca0/D7/1/code.py:488:        if room_counts[i] == room_counts[j]\n/hom