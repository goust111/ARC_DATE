        up_ok = _has_corridor(maze, r - 1, c, \"up\")\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:455:            down_ok = _has_corridor(maze, r + 1, c, \"down\")\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:464:    maze = grid[:-LEGEND_H, :]\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:465:    H, W = maze.shape\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:469:            if int(maze[r, c]) != STRAIGHT_SIGNAL:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:471:            forward_ok = c + 1 < W and int(maze[r, c + 1]) in _TRAVERSABLE\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:472:            up_ok = _has_corridor(maze, r - 1, c, \"up\")\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:473:            down_ok = _has_corridor(maze, r + 1, c, \"down\")\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:533:    maze: np.ndarray,\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:547:            _build_straight_signal_plan(maze, top, bot, row, x)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:550:                maze, top, bot, row, x, str(plan[\"direction\"]), kind\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:555:    maze_h = random.choice(_PLAY_HEIGHT_OPTIONS)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:556:    H = maze_h + LEGEND_H\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:561:    maze = g[:-LEGEND_H, :]\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:562:    maze[:, 0] = PARTICLE\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:564:    bar_rows = list(range(0, maze_h, 2))\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:586:        maze[br, bar_start:W] = bar_color[br]\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:592:    _execute_plans(maze, bar_rows, plans)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:604:            if int(maze[r, c_decor]) == BG:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:605:                maze[r, c_decor] = random.choice([bar_color[top], bar_color[bot]])\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:607:    maze[:, 0] = PARTICLE\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:608:    maze[:, 1] = BG\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:609:    _place_legend(g, maze_h, sorted(set(bar_color.values())), turn_pref)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/41/code.py:618:        for r in range(maze_h)\n/home/lixinyu/snap/new/ceshi/code_combo/35ab12c3/9/code.py:34:#    original vocabulary, so the scene stays legible instead of becoming a maze.\n/home/lixinyu/snap/new/ceshi/code_combo/35ab12c3/9/code.py:64:#    a candidate corridor and the resulting output shows both a detour and a truncation.\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/39/code.py:345:        room = axis - sz - OBS_BOTH_GAP\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/39/code.py:346:        if room < 2 * lo:\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/39/code.py:348:        a = random.randint(lo, min(hi_cap, room - lo))\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/39/code.py:349:        b = _rand_thickness(lo, min(hi_cap, room - a))\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:9:#    is immediately ahead and exactly one perpendicular mouth is a same-color corridor. The fused variant changes\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:10:#    two linked facts. First, every corridor bar in the whole grid is built from exactly two colors A/B. Second,\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:16:#    The palette is aggressively simplified but not collapsed. Using exactly two corridor colors makes real A/A and\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:22:#    - `_has_corridor` assumed only same-color mouths mattered. That is false now, so the solver must classify\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:42:#    No extra decorator colors are added. The entire puzzle uses only corridor colors A/B plus BG and the magenta\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:46:#    The color rule is structural, not value-based: same-color pairs are true corridors, different-color pairs are\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:47:#    fake corridors. Because only two corridor colors are present, fake pairs can only be AB or BA, which makes\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:50:#    - Every generated grid uses exactly two non-BG/non-particle corridor colors, and both colors occur multiple\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:52:#    - At any blocker there is at most one perpendicular corridor-like mouth, whether real or fake.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:74:def _other_color(color: int, corridor_colors: tuple[int, int]) -> int:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:75:    return corridor_colors[1] if color == corridor_colors[0] else corridor_colors[0]\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:78:def _corridor_kind(grid: np.ndarray, r: int, c: int, direction: str) -> str | None:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:79:    \"\"\"Classify a corridor mouth as 'real', 'fake', or None.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:116:            kind = _corridor_kind(grid, tr, tc, turn_dir)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:150:            if 0 <= tr < h and 0 <= tc < w and _corridor_kind(grid, tr, tc, turn_dir) == \"real\":\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:171:            if _corridor_kind(g, r, c, \"right\") == \"real\":\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:201:            if _corridor_kind(g, r, c, \"right\") == \"real\":\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:214:    \"\"\"Move magenta particles through two-color corridors with fake-mouth traps.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:219:    - Every corridor in the grid uses exactly two corridor colors; real horizontal channels have equal colors\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:223:    - Launch a particle only from rows whose horizontal entrance is a real same-color corridor.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:230:    - With only two corridor colors, the decisive cue is not which color appears but whether the two flank colors\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:411:    corridor_colors: tuple[int, int],\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:426:    g[j_top, bar_start] = _other_color(color, corridor_colors)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:443:    corridor_colors: tuple[int, int],\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:446:    trap_color = _other_color(source_color, corridor_colors)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:467:    corridor_colors: tuple[int, int],\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:504:                corridor_colors,\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:516:                corridor_colors,\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:524:    corridor_colors = {\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:551:        \"corridor_colors\": len(corridor_colors),\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:563:    corridor_colors = tuple(random.sample([c for c in range(10) if c not in (BG, PARTICLE)], 2))\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:578:    bar_color = {bar_rows[0]: random.choice(corridor_colors)}\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:584:            bar_color[bot] = _other_color(bar_color[top], corridor_colors)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:601:    _execute_plans(g, h, w, plans, bar_rows, bar_color, bar_start, corridor_colors)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/19/code.py:615:    if metrics[\"corridor_colors\"] != 2:\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/20/code.py:53:    - the teal square is placed with a margin from all obstacles and boundaries, preserving clear beam corridors\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/20/code.py:304:    room = axis - sz - OBS_BOTH_GAP\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/20/code.py:305:    if room < 2 * lo:\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/20/code.py:307:    a = random.randint(lo, min(hi_cap, room - lo))\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/20/code.py:308:    b = _rand_thickness(lo, min(hi_cap, room - a))\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:18:#       - 只有上下同色夹住的通道才可进入；上下异色的假走廊仍不可进入。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:24:#       - 某真实通道从 (r,0) 出发，先向右走 4 步，在第 5 步拐进竖走廊。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:37:#       会把这类真实通道误判为假走廊。这里改用“该行上下主导条带色”识别真/假，并要求假走廊的异色支撑\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:41:#     - 每条假走廊至少保留一个未装饰的背景格，保证 solver 能看见“上下异色夹住的通道”。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:67:def _has_corridor(grid: np.ndarray, r: int, c: int, direction: str) -> bool:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:102:    \"\"\"Find the first genuine corridor cell for row r.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:118:def _find_fake_corridor_col(grid: np.ndarray, r: int) -> int | None:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:119:    \"\"\"Find a stable fake-corridor witness cell for row r, if present.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:143:    \"\"\"Decode N as the repeated decoration count across fake corridors.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:147:        if _find_fake_corridor_col(grid, r) is None:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:192:            if 0 <= tr < H and 0 <= tc < W and _has_corridor(grid, tr, tc, turn_dir):\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:216:    \"\"\"Move magenta particles along real corridors, but stop after at most N visible steps.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:224:    - First read N by counting how many decoration pixels appear inside a fake corridor; the same count is repeated across fake corridors.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:225:    - For each particle row that has a genuine same-color corridor entrance, trace the original path rule: move through bg, and when blocked by color, turn into the unique perpendicular same-color corridor if it exists.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:230:    - The fake corridors are no longer ignorable noise: their decoration count is the global step budget that truncates every real trajectory.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:289:    \"\"\"Reserve a 3-column window for a vertical corridor and return the wall column.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:530:    \"\"\"Encode the step limit by planting exactly N decorations in every fake corridor.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:543:    \"\"\"Measure whether the fake-corridor count truly controls the stopping behavior.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/6/code.py:553:        if _find_fake_corridor_col(g, r) is not None:\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/2/code.py:389:        room = axis - sz - OBS_BOTH_GAP\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/2/code.py:390:        if room < 2 * lo:\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/2/code.py:392:        a = random.randint(lo, min(hi_cap, room - lo))\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/2/code.py:393:        b = _rand_thickness(lo, min(hi_cap, room - a))\n/home/lixinyu/snap/new/ceshi/code/cbebaa4b/D3/3/code.py:3:# Change: 中央黄色方块作为初始锚点，已连接的精灵作为后续连接的扩展锚点 → 锚点为十字形或L形\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:15:      - 原题是横向条带布局: 偶数行是彩色横条, 奇数行是背景通道, 品红粒子只在左边界, 初始方向固定向右。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:16:      - 粒子沿 BG 前进, 在彩色阻挡前检查两个垂直方向, 若恰有一个方向存在“同色夹墙通道”就转弯。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:23:      - 原题: `(r,0)` 的粒子直接按 `right` 开始, 穿过水平通道, 被 `(r,c_v)` 彩墙挡住后转入竖通道。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:25:        然后沿竖通道下行, 在封口处被阻挡, 再按原规则检查 `left/right` 转入水平通道。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:35:    - 原 `_has_corridor` 只把 `BG/PARTICLE` 当作可通行; 组合后若不把 `ARROW` 也算 passable, 起步时就会被箭头挡住。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:40:    - 右边起点只放在 `straight` 通道的右端, 逆向进入不会遇到镜像歧义。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:41:    - 顶/底边起点只放在 `l_edge` 计划生成的真实竖通道端点, 对应端点天然是 BG 且可直连内部。\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:77:def _has_corridor(grid: np.ndarray, r: int, c: int, direction: str) -> bool:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:108:            if 0 <= tr < h and 0 <= tc < w and _has_corridor(grid, tr, tc, turn_dir):\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:183:    \"\"\"Move arrow-marked edge particles through same-color corridors.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:194:      direction whose next cell is a same-color-flanked corridor. If no such turn exists,\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:200:      heading, then apply the original same-color corridor-turning rule unchanged.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/4/code.py:249:    \"\"\"Reserve a 3-column window for a vertical corridor and return the wall column.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:9:#   horizontal corridors, turn only when the next cell is colored, and enter a\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:10:#   perpendicular corridor if that turn cell is a BG cell flanked by a same-color pair.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:12:#   1. Each real corridor segment uses a unique color.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:13:#   2. Every visited travel cell is painted with the current corridor color.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:14:#   3. The endpoint is not magenta anymore; it keeps the final corridor color.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:16:#   a row-13 particle moves right inside corridor color A, hits a blocker, turns up\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:17:#   into vertical corridor color B, then turns right again into row-7 corridor color C.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:21:# - The visible difference is not just \"recolor the last cell\": because corridor colors\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:22:#   are unique, the trail color sequence itself reveals the ordered corridor list.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:26:#   reusing corridor colors would make the path-to-corridor mapping ambiguous.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:31:#   draws a unique-color subset from that pool for its real corridor segments.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:37:#   final corridor. That is false under D7/1, so the final write must use the last active\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:38:#   corridor color instead.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:47:# - Active source rows are spaced four rows apart so their primary horizontal corridors do\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:51:# - The two-turn target corridor starts only to the right of both neighboring turn columns,\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:62:# - Because every real corridor color is unique, the multicolor path is interpretable:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:63:#   \"this particle visited these exact corridors in this exact order\".\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:68:# - The output uses only existing corridor colors. No extra marker layer is introduced.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:75:#   flanking corridor pair, and the final cell keeps the last such color.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:76:# - Unique corridor colors reduce ambiguity rather than increasing it: when a trail changes\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:77:#   from A to B to C, a solver can infer that the particle changed corridors in that order.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:80:#   2. At every blocker, at most one perpendicular corridor is valid.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:102:def _corridor_color(grid: np.ndarray, r: int, c: int, direction: str) -> int | None:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:103:    \"\"\"Return the flanking-pair color for a valid corridor cell, else None.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:122:def _has_corridor(grid: np.ndarray, r: int, c: int, direction: str) -> bool:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:123:    return _corridor_color(grid, r, c, direction) is not None\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:127:    \"\"\"Find the first solver-visible real-corridor entrance for row r.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:130:        color = _corridor_color(grid, r, c, \"right\")\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:143:    \"\"\"Trace one particle and record its corridor-colored trail.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:158:            step_color = _corridor_color(grid, nr, nc, direction)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:170:            turn_color = _corridor_color(grid, tr, tc, turn_dir)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:198:            final_color = _corridor_color(g, end_r, end_c, end_dir)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:235:    Move particles through uniquely colored corridors and leave a corridor-colored trail.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:239:    - Real corridors are BG travel cells flanked by same-color bar pairs; each real corridor\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:244:    - When its next cell is colored, it turns 90 degrees into the unique perpendicular corridor\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:246:    - Every visited path cell is recolored to the currently occupied corridor color, and the\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:247:      endpoint remains that final corridor color rather than magenta.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:250:    - The output is a color-coded route log: because corridor colors are unique, the painted\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:251:      trail and same-colored endpoint together identify the exact ordered corridor sequence.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:264:        assert path[\"final_color\"] is not None, \"moved path must end with a corridor color\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:288:def _paint_h_corridor(grid: np.ndarray, row: int, c0: int, c1: int, color: int) -> None:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:295:def _paint_v_corridor(grid: np.ndarray, col: int, r0: int, r1: int, color: int) -> None:\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:303:    \"\"\"Allocate `count` vertical corridor columns with a 3-column exclusion window.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:334:    \"\"\"Construct the fixed combo-supporting set of real corridors.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:352:    _paint_h_corridor(g, l_down_row, bar_start, v_down, c_l_down_h)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:354:    _paint_v_corridor(g, v_down, l_down_row + 1, H - 1, c_l_down_v)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:357:    _paint_h_corridor(g, two_turn_row, bar_start, v_two, c_two_h1)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:359:    _paint_v_corridor(g, v_two, target_row + 1, two_turn_row - 1, c_two_v)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:361:    _paint_h_corridor(g, target_row, v_two + 1, W - 1, c_two_h2)\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/30/code.py:365:    _paint_h_corridor(g, straight_row, bar_start, W - 1, c_straight)\n/home/lixinyu/snap/new/ceshi/code_combo/2b83f449/21/code.py:405:            # Keep some room for future zig-zag steps so depth>=3 remains likely.\n/home/lixinyu/snap/new/ceshi/code_combo/2b83f449/21/code.py:406:            left_room = c - 3\n/home/lixinyu/snap/new/ceshi/code_combo/2b83f449/21/code.py:407:            right_room = (width - 4) - c\n/home/lixinyu/snap/new/ceshi/code_combo/2b83f449/21/code.py:408:            if rem <= 0 or min(left_room, right_room) >= 1:\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/16/code.py:58:#    diagonal teal corridors before snapping back to a cardinal lane. Samples are also\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/16/code.py:376:        room = axis - sz - OBS_BOTH_GAP\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/16/code.py:377:        if room < 2 * lo:\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/16/code.py:379:        a = random.randint(lo, min(hi_cap, room - lo))\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/16/code.py:380:        b = _rand_thickness(lo, min(hi_cap, room - a))\n/home/lixinyu/snap/new/ceshi/code_combo/2b83f449/19/code.py:88:# - Because packing is still end-based, destination segments must have enough room\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/22/code.py:43:# - Frames are reduced to 5x7 so that a 2x2 input layout still leaves a generous corridor region\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/22/code.py:62:#   frame bbox, so they remain in visible corridor background and cannot overlap frames.\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/22/code.py:75:# - Sprites stay in corridor background, so they do not sit inside frame interiors or touch frame\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/22/code.py:179:    - Small monochrome sprites are scattered only in the corridor background between those frames.\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/22/code.py:289:def _corridor_mask(shape: tuple[int, int], frame_bboxes: list[tuple[int, int, int, int]]) -> np.ndarray:\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/22/code.py:336:    allowed = _corridor_mask(inp.shape, frame_bboxes)\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/9/code.py:418:        room = axis - sz - OBS_BOTH_GAP\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/9/code.py:419:        if room < 2 * lo:\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/9/code.py:421:        a = random.randint(lo, min(hi_cap, room - lo))\n/home/lixinyu/snap/new/ceshi/code_combo/e87109e9/9/code.py:422:        b = _rand_thickness(lo, min(hi_cap, room - a))\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/14/code.py:26:#     - a valid row is detected by searching for a horizontal same-color corridor\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/14/code.py:30:#     - each particle is placed on a real corridor cell somewhere along a traced path\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/14/code.py:31:#     - the initial heading is inferred locally by comparing the available corridor\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/14/code.py:33:#       longest corridor arm wins\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/14/code.py:35:#     - the striped bar/corridor language from the original task is preserved\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/14/code.py:37:#     - every particle sits inside a corridor, often not centered on its local\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/14/code.py:47:#          on the vertical part of a real corridor\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/14/code.py:48:#       2. from that cell, the upward straight corridor arm has length 4 while the\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/14/code.py:54:#       chosen direction varies with local corridor geometry instead of being fixed\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/14/code.py:55:#     - the cue is still low-entropy and human-readable: compare a few corridor-arm\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/14/code.py:62:#       embedded in the corridor network\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/14/code.py:66:#     - a new assumption appears: the unique longest adjacent corridor arm determines\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/14/code.py:71:#       have at least two opposite traversable directions on the same corridor axis\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/14/code.py:74:#     - no extra blockers are inserted; the underlying corridor topology remains legal\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/14/code.py:77:#       corridors and move toward whichever side visibly offers the longer hallway\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/14/code.py:81: